CREATE TABLE IF NOT EXISTS "todo" ("id" INTEGER PRIMARY KEY NOT NULL, "project" INTEGER NOT NULL REFERENCES "project" ("id"), "title" TEXT NOT NULL CHECK (("title" <> '') AND (length(CAST("title" AS BLOB)) <= 80)), "priority" INTEGER NOT NULL CHECK ((1 <= "priority") AND ("priority" <= 5)), "due" INTEGER, "done" INTEGER NOT NULL DEFAULT 0)
Project { id: ProjectId(1), name: "home" }
Todo { id: TodoId(1), project: ProjectId(1), title: "write docs", priority: 2, due: None, done: false }
Some(Todo { id: TodoId(2), project: ProjectId(1), title: "buy milk", priority: 1, due: Some(3), done: false })
["buy milk", "write docs", "fix bike"]
Ok(true)
Ok(1)
["write docs", "fix bike"]
Ok(2)
Ok(true)
["write docs", "fix bike"]
Err(Constraint { message: "CHECK constraint failed: (\"title\" <> '') AND (length(CAST(\"title\" AS BLOB)) <= 80)" })
Err(Constraint { message: "CHECK constraint failed: name" })
Err(BadRow { table: "project", message: "name: \"a/b\" does not satisfy `String where it != \"\" && !contains(it, \"/\")`" })
CREATE TABLE IF NOT EXISTS "project" ("id" INTEGER PRIMARY KEY NOT NULL, "name" TEXT NOT NULL CHECK ("name" <> ''))
Ok(1)
["write docs"]
Ok(())
CREATE TABLE IF NOT EXISTS "span" ("id" INTEGER PRIMARY KEY NOT NULL, "start" REAL NOT NULL, "end" REAL NOT NULL, "note" TEXT, CHECK ("start" <= "end"))
CREATE TABLE IF NOT EXISTS "tag" ("id" TEXT PRIMARY KEY NOT NULL CHECK ("id" <> ''), "color" TEXT NOT NULL DEFAULT 'red')
Span { id: 1, start: 1.5, end: 2.0, note: Some("lunch") }
Err(Constraint { message: "CHECK constraint failed: start" })
Ok(Tag { id: "home", color: "red" })
Err(Constraint { message: "UNIQUE constraint failed: tag.id" })
Ok(Some(Tag { id: "home", color: "red" }))
Ok(None)
Ok([Span { id: 1, start: 1.5, end: 2.0, note: Some("lunch") }])
Ok(())

--- exit 0
