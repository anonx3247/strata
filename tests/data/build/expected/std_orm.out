CREATE TABLE IF NOT EXISTS "span" ("id" INTEGER PRIMARY KEY NOT NULL, "start" REAL NOT NULL, "end" REAL NOT NULL, "note" TEXT, CHECK ("start" <= "end"))
CREATE TABLE IF NOT EXISTS "tag" ("id" TEXT PRIMARY KEY NOT NULL CHECK ("id" <> ''), "color" TEXT NOT NULL DEFAULT 'red')
CREATE TABLE IF NOT EXISTS "item" ("code" TEXT PRIMARY KEY NOT NULL CHECK ("code" <> ''), "name" TEXT NOT NULL)
CREATE TABLE IF NOT EXISTS "slot" ("shelf" INTEGER NOT NULL, "slot" INTEGER NOT NULL, "item" TEXT NOT NULL REFERENCES "item" ("code"), "note" TEXT REFERENCES "tag" ("id"), PRIMARY KEY ("shelf", "slot"))
CREATE TABLE IF NOT EXISTS "delivery" ("id" INTEGER PRIMARY KEY NOT NULL, "to" BLOB NOT NULL, "items" BLOB NOT NULL)
