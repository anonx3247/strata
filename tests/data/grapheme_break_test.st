fn main() {
  mut bad := 0
  for (line, cps, sizes) in cases() {
    s := fold(cps, "", (acc, c) -> acc + chr(c))
    got := [len(g.code_points().to_list()) for g in s.graphemes()].to_list()
    if got != sizes {
      bad += 1
      print(f"line {line}: {cps} expected {sizes}, got {got}")
    }
  }
  print(f"{len(cases())} cases, {bad} wrong")
}
