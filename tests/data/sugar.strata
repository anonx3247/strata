fn squares(n: Int) -> List[Int] {
  [x * x for x in 1..=n where x % 2 == 1]
}

fn pairs(xs: List[Int], ys: List[String]) -> List[(Int, String)] {
  [(x, y) for x in xs for y in ys where x > 0]
}

fn swapped(ps: List[(Int, String)]) -> List[(String, Int)] {
  [(b, a) for (a, b) in ps]
}

fn ends(s: String, xs: List[Int]) -> (String, List[Int], String, List[Int]) {
  (s[1..3], xs[2..], trim(s)[..2], xs[..=1])
}

fn total(n: Int) -> Int {
  let mut t = 0
  for i in 0..n {
    t = t + i
  }
  (0..n).map(i -> i * 2).len() + t
}

test "sugar" {
  assert squares(5) == [1, 9, 25]
  assert pairs([1, -1, 2], ["a", "b"]) == [(1, "a"), (1, "b"), (2, "a"), (2, "b")]
  assert swapped([(1, "a")]) == [("a", 1)]
  assert ends(" hello", [1, 2, 3, 4]) == ("he", [3, 4], "he", [1, 2])
  assert total(4) == 10
}
