-- std's list functions: `len`, `+`, `reversed`, `map` and `sorted` are
-- built-ins written in C, so the logic has models of them, written in Strata
-- in core/models.strata and tied to the builtins by `assumed` contracts; the
-- laws below are about those models.

strata {
/// Each element at most the next.
fn is_sorted(xs: List[Int]) -> Bool {
  match xs {
    [] => true,
    [x, ..rest] => match rest {
      [] => true,
      [y, ..more] => x <= y && is_sorted(rest),
    },
  }
}

/// How many times `x` is in `xs`.
fn count(x: Int, xs: List[Int]) -> Int {
  match xs {
    [] => 0,
    [y, ..rest] => if x == y {
      1 + count(x, rest)
    } else {
      count(x, rest)
    },
  }
}

/// A contract: its `ensures` is the goal `twice.ensures`.
fn twice[A](xs: List[A]) -> Int ensures it == 2 * len(xs) {
  len(xs + xs)
}
}

-- helpers proven (models may use them)
@[simp] law append_nil[T](xs: List[T]) holds xs + [] == xs by
  induction xs {
    [] => simp,
    [x, ..rest] => simp [append_nil(rest)],
  }

law append_assoc[T](a: List[T], b: List[T], c: List[T]) holds (a + b) + c == a + (b + c) by
  induction a {
    [] => simp,
    [x, ..rest] => simp [append_assoc(rest, b, c)],
  }

law reversed_append[T](a: List[T], b: List[T]) holds (a + b).reversed() == b.reversed() + a.reversed() by
  induction a {
    [] => simp,
    [x, ..rest] => simp [reversed_append(rest, b), append_assoc],
  }

law reversed_reversed[T](xs: List[T]) holds xs.reversed().reversed() == xs by
  induction xs {
    [] => simp,
    [x, ..rest] => simp [reversed_append, reversed_reversed(rest)],
  }

-- the goals
law len_append[A](xs: List[A], ys: List[A]) holds len(xs + ys) == len(xs) + len(ys) by

law len_reversed[A](xs: List[A]) holds len(xs.reversed()) == len(xs) by

law map_append[A, B](xs: List[A], ys: List[A], f: (A) -> B) holds (xs + ys).map(f) == xs.map(f) + ys.map(f) by

law map_map[A, B, C](xs: List[A], f: (B) -> C, g: (A) -> B) holds xs.map(g).map(f) == xs.map(x -> f(g(x))) by

law map_reversed[A, B](xs: List[A], f: (A) -> B) holds xs.reversed().map(f) == xs.map(f).reversed() by

law len_sorted(xs: List[Int]) holds len(xs.sorted()) == len(xs) by

law sorted_is_sorted(xs: List[Int]) holds is_sorted(xs.sorted()) by

law count_sorted(x: Int, xs: List[Int]) holds count(x, xs.sorted()) == count(x, xs) by

law twice.ensures by

-- refinements: `len` returns a `Natural`, an assumed fact
law len_nonneg[A](xs: List[A]) holds len(xs) >= 0 by

law len_sorted_nonneg(xs: List[Int]) holds len(xs.sorted()) >= 0 by

law natural_add(a: Natural, b: Natural) holds a + b >= a by
