-- The list laws and a mutual tree law in the law syntax
-- (docs/kernel-laws.md): induction is recursion, a law calling itself on
-- the parts its arm names.

strata {
type Tree = | Leaf(Int) | Node(List[Tree])

fn leaves(t: Tree) -> Int {
  match t {
    Leaf(_) => 1,
    Node(ts) => leaves_all(ts),
  }
}

fn leaves_all(ts: List[Tree]) -> Int {
  match ts {
    [] => 0,
    [t, ..rest] => leaves(t) + leaves_all(rest),
  }
}
}

@[simp] law append_nil[T](xs: List[T]) holds xs + [] == xs by
  induction xs {
    [] => simp,
    [x, ..rest] => simp [append_nil(rest)],
  }

law append_assoc[T](a: List[T], b: List[T], c: List[T]) holds (a + b) + c == a + (b + c) by
  induction a {
    [] => simp,
    [x, ..rest] => simp [append_assoc(rest, b, c)],
  }

law reversed_append[T](a: List[T], b: List[T]) holds (a + b).reversed() == b.reversed() + a.reversed() by
  induction a {
    [] => simp,
    [x, ..rest] => simp [reversed_append(rest, b), append_assoc],
  }

law reversed_reversed[T](xs: List[T]) holds xs.reversed().reversed() == xs by
  induction xs {
    [] => simp,
    [x, ..rest] => simp [reversed_append, reversed_reversed(rest)],
  }

law len_append[T](a: List[T], b: List[T]) holds len(a + b) == len(a) + len(b) by
  induction a {
    [] => simp,
    [x, ..rest] => simp [len_append(rest, b)],
  }

-- a law with a named `requires`, `lemma` and `use`
law longer(a: List[Int], b: List[Int]) requires nonempty: len(b) > 0 holds len(a + b) > len(a) by
  lemma split: len(a + b) == len(a) + len(b) by use len_append(a, b)
  simp [split]
  arith

-- with no `by`: the ladder
law len_nonneg[T](xs: List[T]) holds len(xs) >= 0

mutual
law leaves_pos(t: Tree) holds leaves(t) >= 0 by
  induction t {
    Leaf(n) => simp,
    Node(ts) => { simp; use leaves_all_pos(ts) },
  }
law leaves_all_pos(ts: List[Tree]) holds leaves_all(ts) >= 0 by
  induction ts {
    [] => simp,
    [t, ..rest] => { simp; lemma a: leaves(t) >= 0 by use leaves_pos(t); lemma b: leaves_all(rest) >= 0 by use leaves_all_pos(rest); arith },
  }
end
