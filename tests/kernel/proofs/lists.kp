-- The list laws the goal set builds on, proven: `+` has `[]` as its unit
-- and is associative, and `reversed` is an involution.

@[simp] theorem append_nil[A](xs: List[A]): xs + [] == xs := by
  induction xs with
  | nil => simp
  | cons x xs ih => simp [ih]

theorem append_assoc[A](xs: List[A], ys: List[A], zs: List[A]): (xs + ys) + zs == xs + (ys + zs) := by
  induction xs with
  | nil => simp
  | cons x xs ih => simp [ih]

theorem reversed_append[A](xs: List[A], ys: List[A]): (xs + ys).reversed() == ys.reversed() + xs.reversed() := by
  induction xs with
  | nil => simp
  | cons x xs ih => simp [ih, append_assoc]

theorem reversed_reversed[A](xs: List[A]): xs.reversed().reversed() == xs := by
  induction xs with
  | nil => simp
  | cons x xs ih => simp [reversed_append, ih]
