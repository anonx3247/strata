-- std's list functions: `len`, `+`, `reversed`, `map` and `sorted` are
-- built-ins written in C, so the logic has models of them (the prelude,
-- `strata kernel goals` shows it); the laws below are about those models.

strata {
/// Each element at most the next.
fn is_sorted(xs: List[Int]) -> Bool {
  match xs {
    [] => true,
    [x, ..rest] => match rest {
      [] => true,
      [y, ..more] => x <= y && is_sorted(rest),
    },
  }
}

/// How many times `x` is in `xs`.
fn count(x: Int, xs: List[Int]) -> Int {
  match xs {
    [] => 0,
    [y, ..rest] => if x == y {
      1 + count(x, rest)
    } else {
      count(x, rest)
    },
  }
}

/// A contract: its `ensures` is the goal `twice.ensures`.
fn twice[A](xs: List[A]) -> Int ensures it == 2 * len(xs) {
  len(xs + xs)
}
}

-- helpers proven (models may use them)
@[simp] theorem append_nil[A](xs: List[A]): xs + [] == xs := by
  induction xs with
  | nil => simp
  | cons x xs ih => simp [ih]

theorem append_assoc[A](xs: List[A], ys: List[A], zs: List[A]): (xs + ys) + zs == xs + (ys + zs) := by
  induction xs with
  | nil => simp
  | cons x xs ih => simp [ih]

theorem reversed_append[A](xs: List[A], ys: List[A]): (xs + ys).reversed() == ys.reversed() + xs.reversed() := by
  induction xs with
  | nil => simp
  | cons x xs ih => simp [ih, append_assoc]

theorem reversed_reversed[A](xs: List[A]): xs.reversed().reversed() == xs := by
  induction xs with
  | nil => simp
  | cons x xs ih => simp [reversed_append, ih]

-- the goals
theorem len_append[A](xs: List[A], ys: List[A]): len(xs + ys) == len(xs) + len(ys) := by

theorem len_reversed[A](xs: List[A]): len(xs.reversed()) == len(xs) := by

theorem map_append[A, B](xs: List[A], ys: List[A], f: (A) -> B): (xs + ys).map(f) == xs.map(f) + ys.map(f) := by

theorem map_map[A, B, C](xs: List[A], f: (B) -> C, g: (A) -> B): xs.map(g).map(f) == xs.map(x -> f(g(x))) := by

theorem map_reversed[A, B](xs: List[A], f: (A) -> B): xs.reversed().map(f) == xs.map(f).reversed() := by

theorem len_sorted(xs: List[Int]): len(xs.sorted()) == len(xs) := by

theorem sorted_is_sorted(xs: List[Int]): is_sorted(xs.sorted()) := by

theorem count_sorted(x: Int, xs: List[Int]): count(x, xs.sorted()) == count(x, xs) := by

theorem twice.ensures := by
