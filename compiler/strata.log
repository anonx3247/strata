h(mut g, r1)\n  codegen.temp(mut g, y)\n}"},{"name":"codegen.entry_ty","kind":"fn","old":"7a937d47f0af5d19","new":"ae622267247b077a","interface_changed":true,"affected":["codegen.equal","codegen.repr","codegen.collection_builtin","codegen.cmp_helper","codegen.update_in_place","codegen.list_view","codegen.hash_helper","codegen.table_from","codegen.apply","codegen.eq_fields","codegen.matches","codegen.eq_list","codegen.dyn_wrapper","codegen.union_eq","codegen.slot_fn","codegen.drop_value","codegen.check_member","codegen.retype_temp","codegen.tail_drop","codegen.copy_out","codegen.share_value","codegen.tail_share","codegen.builtin","codegen.gen_list","codegen.converted","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.builtin_call","codegen.stmt_node","codegen.helper","codegen.check_type","codegen.for_list","codegen.hash_fields","codegen.binary","codegen.number_builtin","codegen.checked","codegen.eq_body","codegen.destructure","codegen.binds","codegen.for_loop","codegen.matching_v","codegen.match_got","codegen.vtable","codegen.table_fns","codegen.function","codegen.drop_scope","codegen.drop_fields","codegen.debug_list","codegen.drop_list","codegen.closure","codegen.call_fn_want","codegen.set_path","codegen.replace_var","codegen.union_drop","codegen.task_fns","codegen.await_list","codegen.slot_drop_fn","codegen.select_expr","codegen.foreign_call","codegen.tries_end","codegen.drop_stacked","codegen.set_field_in_place","codegen.arena_run","codegen.unwind_all","codegen.swap_in","codegen.take_in_place","codegen.session_entry","codegen.drop_counted","codegen.drop_held","codegen.unbox_fn","codegen.assign_held","codegen.copy_fn","codegen.copy_fields","codegen.spawn_expr","codegen.await_one","codegen.channel_op","codegen.share_fn","codegen.share_held","codegen.share_fields","codegen.call_named","codegen.push_in_place","codegen.produce","codegen.list_builtin","codegen.list_literal_of","codegen.construct_want","codegen.operands_wa