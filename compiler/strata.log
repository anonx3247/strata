s(g.distincts, name)\n      || codegen.is_word(name) {\n      (false, [])\n    } else {\n      cs := codegen.ctors_of(g, t)\n      if cs.any(\n        c -> !contains(g.types.ctors, c) || !contains(g.tags, c),\n      ) {\n        (false, [])\n      } else {\n        (\n          len(cs) > 1,\n          cs.map(c -> (c, codegen.fields_of(g, c, t).map(f -> f.1))),\n        )\n      }\n    },\n    _ => (false, []),\n  }\n}","old_text":"/// A type's constructors with their fields' types, and whether a small\n/// value's words start with the tag (more than one constructor). No\n/// constructors for a type that can't be small.\nfn small_layout(g: codegen.Gen, t: Ty) -> (Bool, List[(String, List[Ty])]) {\n  match t {\n    TNamed { name: \"Tuple\", args } => (false, [(\"Tuple\", args)]),\n    TNamed { name, .. } => if !contains(g.data, name)\n      || contains(g.refines, name)\n      || contains(g.distincts, name)\n      || codegen.is_word(name) {\n      (false, [])\n    } else {\n      cs := codegen.ctors_of(g, t)\n      if cs.any(\n        c -> !contains(g.types.ctors, c) || !contains(g.tags, c),\n      ) {\n        (false, [])\n      } else {\n        (\n          len(cs) > 1,\n          cs.map(c -> (c, codegen.fields_of(g, c, t).map(f -> f.1))),\n        )\n      }\n    },\n    _ => (false, []),\n  }\n}"},{"name":"codegen.by_words","kind":"fn","old":"d9a6ff623130fd9f","new":"a8aebabf1d3f213d","interface_changed":true,"affected":["codegen.function","codegen.call_at","codegen.call_fn_want","codegen.result_ll","codegen.compiled_alone","codegen.call","codegen.entry","codegen.show","codegen.shown","codegen.equal","codegen.mock_call","codegen.session_entry","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.declaration_of","codegen.call_words","codegen.generate","codegen.int_lit","codegen.concat","codegen.apply","codegen.finite","codegen.fault","codegen.sli