codegen.take_value(\n      mut g,\n      codegen.set_copy(mut g, lists, ets, ixs, k + 1, x),\n    )\n  }\n  sl := codegen.to_slot(mut g, inner)\n  codegen.call(\n    mut g,\n    l.ty,\n    \"strata_list_set\",\n    [\n      l,\n      i,\n      codegen.V { ty: TInt, op: sl },\n      codegen.elements_kind(et),\n    ],\n  )\n}"},{"name":"codegen.in_place_path","kind":"fn","old":"cb9f735de310fdaf","new":"399819d78f3d86ec","interface_changed":true,"affected":["codegen.call_fn_want","codegen.assign_at","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.dyn_call","codegen.stmt_node","codegen.expr_node","codegen.expr_want_node","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.builtin_call","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.main_arg","codegen.select_expr","codegen.stmt","codegen.expr","codegen.expr_want","codegen.entry","codegen.interp","codegen.format_spec","codegen.union_text","codegen.destructure","codegen.debug_fields","codegen.for_loop","codegen.debug_list","codegen.checked","codegen.fail_unless","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.fuzz_driver","codegen.trace_enter","codegen.trace_leave","codegen.matching_v","codegen.index_check","codegen.checked_update","codegen.decreases_fault","codegen.push_in_place","codegen.gen_list","codegen.converted","codegen.update_in_place","codegen.except_expr","codegen.matching_want","codegen.vtable","codegen.block_expr","codegen.iterate","codegen.decreases_start","codegen.decreases_pass","codegen.decreases_entry","codegen.decreases_call","codegen.build_fn","codegen.binary","codegen.logic","codegen.loop_body","codegen.matches","codegen.with_it","codegen.for_list","codegen.await_expr","codegen.race_expr","codegen.mock_method","codegen.call_entry","codegen.con