args.map(a -> derive.unwhere(x, a)) }\n    },\n    ast.Refined { base, pred } => ast.Refined { base: derive.unwhere(x, base), pred },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> derive.unwhere(x, a)),\n      ret: derive.unwhere(x, ret),\n    },\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> derive.unwhere(x, a))),\n    ast.UnitType => ast.UnitType,\n  }\n}","old_text":"/// `t` with each alias made for a refinement type argument (`$where_0`)\n/// turned back into that refinement.\nfn unwhere(x: derive.X, t: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => if len(args) == 0 && starts_with(name, desugar.where_prefix()) {\n      match get(x.ix.types, name) {\n        Some(td) => match (td.body, td.refinement) {\n          (ast.Alias(b), Some(r)) => ast.Refined { base: b, pred: r },\n          _ => t,\n        },\n        None => t,\n      }\n    } else {\n      ast.Named { name, args: args.map(a -> derive.unwhere(x, a)) }\n    },\n    ast.Refined { base, pred } => ast.Refined { base: derive.unwhere(x, base), pred },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> derive.unwhere(x, a)),\n      ret: derive.unwhere(x, ret),\n    },\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> derive.unwhere(x, a))),\n    ast.UnitType => ast.UnitType,\n  }\n}"},{"name":"derive.is_variant","kind":"fn","old":"a95e94502f675d1e","new":"092e0a33b7ff77d0","interface_changed":true,"affected":["derive.make","derive.arm_pattern","derive.expr","derive.comprehension","derive.derive","derive.children","derive.field_read","derive.type_method","derive.with_known","derive.block","derive.call_copy","derive.derive_fn","derive.derive_all","derive.match_type","derive.call_fn","derive.derived_in","derive.expand_with","derive.expand_in","std_reached","expanded","check_errors_in","derive.expand","holes_command","check_summary","verified_decls","verify_file","codegen_with","with_base","repl_eval","check_erro