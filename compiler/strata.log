eck_union","codegen.check_member","codegen.to_dyn","codegen.dyn_table_is","codegen.mock_value","codegen.builtin","codegen.gen_list","codegen.gen_fn","codegen_with","core_rt_text","computed_value","repl_eval","codegen.session_capability","codegen.union_call","codegen.dyn_generic_call","codegen.iterate","codegen.decreases_start","codegen.decreases_entry","codegen.show","codegen.shown","codegen.string_builtin","codegen.dyn_wrapper","codegen.host","codegen.spawn_expr","codegen.method_value","codegen.foreign_call","codegen.generated","codegen.can_generate","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.session_entry","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","codegen.generated_args","codegen.makers","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.helper","codegen.debug_body","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.equal","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.read_back","eval_files","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"fn call_named(\n  mut g: codegen.Gen,\n  name: String,\n  args: List[ast.Expr],\n  want: check.Ty,\n) -> codegen.V {\n  // a variable holding a function\n  match codegen.lookup(g, name) {\n    Some(l) => {\n      f := codegen.load(mut g, l)\n      return match codegen.operands(mut g, args) {\n        Some(vs) => codegen.call_closure(mut g, f, vs),\n        None => codegen.never(),\n      }\n    },\n    None => (),\n  }\n  // a program function (in the prelude, the prelude's)\n  k := codegen.fn_key(g, name)\n  if k != \"\" {\n    return codegen.call_fn_want(mut g, k, [], args, want)\n  }\n  if name == \"channel\" && len(args) <= 1 {\n    return codegen.channel_new(mut g, args, want)\n  }\n  if len(args) == 0 {\n    return codegen.builtin(mut g, name, [])\n  }\n  // a built-in, chosen by the first argument's type\n  first := codegen.expr(mut g, get(args, 0) ?? ast.UnitExpr)\n  if first.ty is check.TAny {\n    return first\n  }\n  // A fully qualified name that is no function (`std.fs.remove`, an\n  // imported trait's method): the first argument's method, else the\n  // built-in of that name.\n  m := codegen.short(name)\n  module := byte_slice(name, 0, byte_len(name) - byte_len(m))\n  if m != name\n    && keys(g.traits).any(\n      tr -> starts_with(tr, module)\n        && !contains(\n          byte_slice(tr, byte_len(module), byte_len(tr)),\n          \".\",\n        )\n        && match get(g.traits, tr) {\n          Some(t) => t.methods.any(x -> x.decl.name == m),\n          None => false,\n        },\n    ) {\n    h := match first.ty {\n      check.TUnion(_) => codegen.union_name(g, codegen.key(first.ty)),\n      _ => codegen.head_of(first.ty),\n    }\n    // a `mut self` method applies only with the receiver marked `mut`:\n    // `print(r)` is the built-in, `Console.print` is not\n    marked := get(args, 0) ?? ast.UnitExpr is ast.MutExpr\n    mk := codegen.method_key(mut g, h, m)\n    if mk != \"\" && (marked || !codegen.mut_self(g, mk)) {\n      return codegen.call_fn_want(mut g, mk, [first], drop(args, 1), want)\n    }\n    match first.ty {\n      check.TTrait(tr) => if marked || !codegen.dyn_mut(g, tr, m) {\n        return codegen.dyn_call(mut g, first, tr, m, drop(args, 1))\n      },\n      _ => (),\n    }\n    return codegen.builtin_call(mut g, m, first, drop(args, 1))\n  }\n  // a list built-in written in Strata (the prelude); its type parameters\n  // also come from the wanted result (`fold(ws, Dict {}, f)` for a\n  // `Dict[String, Int]`)\n  match first.ty {\n    check.TList(_) => if m != \"sum\"\n      && codegen.prelude_builtin(m)\n      && codegen.has_fn(g, codegen.prelude_name(m))\n      && codegen.own_builtin(mut g, m, first) == \"\" {\n      return codegen.call_fn_want(\n        mut g,\n        codegen.prelude_name(m),\n        [first],\n        drop(args, 1),\n        want,\n      )\n    },\n    _ => (),\n  }\n  // a built-in under its own name: `get` in a module whose type has a\n  // method `get` is stored as `std.http.get`\n  codegen.builtin_call(mut g, m, first, drop(args, 1))\n}","old_text":"fn call_named(\n  mut g: codegen.Gen,\n  name: String,\n  args: List[ast.Expr],\n  want: Ty,\n) -> codegen.V {\n  // a variable holding a function\n  match codegen.lookup(g, name) {\n    Some(l) => {\n      f := codegen.load(mut g, l)\n      return match codegen.operands(mut g, args) {\n        Some(vs) => codegen.call_closure(mut g, f, vs),\n        None => codegen.never(),\n      }\n    },\n    None => (),\n  }\n  // a program function (in the prelude, the prelude's)\n  k := codegen.fn_key(g, name)\n  if k != \"\" {\n    return codegen.call_fn_want(mut g, k, [], args, want)\n  }\n  if name == \"channel\" && len(args) <= 1 {\n    return codegen.channel_new(mut g, args, want)\n  }\n  if len(args) == 0 {\n    return codegen.builtin(mut g, name, [])\n  }\n  // a built-in, chosen by the first argument's type\n  first := codegen.expr(mut g, get(args, 0) ?? ast.UnitExpr)\n  if first.ty is TAny {\n    return first\n  }\n  // A fully qualified name that is no function (`std.fs.remove`, an\n  // imported trait's method): the first argument's method, else the\n  // built-in of that name.\n  m := codegen.short(name)\n  module := byte_slice(name, 0, byte_len(name) - byte_len(m))\n  if m != name\n    && keys(g.traits).any(\n      tr -> starts_with(tr, module)\n        && !contains(\n          byte_slice(tr, byte_len(module), byte_len(tr)),\n          \".\",\n        )\n        && match get(g.traits, tr) {\n          Some(t) => t.methods.any(x -> x.decl.name == m),\n          None => false,\n        },\n    ) {\n    h := match first.ty {\n      TUnion(_) => codegen.union_name(g, codegen.key(first.ty)),\n      _ => codegen.head_of(first.ty),\n    }\n    // a `mut self` method applies only with the receiver marked `mut`:\n    // `print(r)` is the built-in, `Console.print` is not\n    marked := get(args, 0) ?? ast.UnitExpr is ast.MutExpr\n    mk := codegen.method_key(mut g, h, m)\n    if mk != \"\" && (marked || !codegen.mut_self(g, mk)) {\n      return codegen.call_fn_want(mut g, mk, [first], drop(args, 1), want)\n    }\n    match first.ty {\n      TTrait(tr) => if marked || !codegen.dyn_mut(g, tr, m) {\n        return codegen.dyn_call(mut g, first, tr, m, drop(args, 1))\n      },\n      _ => (),\n    }\n    return codegen.builtin_call(mut g, m, first, drop(args, 1))\n  }\n  // a list built-in written in Strata (the prelude); its type parameters\n  // also come from the wanted result (`fold(ws, Dict {}, f)` for a\n  // `Dict[String, Int]`)\n  match first.ty {\n    TList(_) => if m != \"sum\"\n      && codegen.prelude_builtin(m)\n      && codegen.has_fn(g, codegen.prelude_name(m))\n      && codegen.own_builtin(mut g, m, first) == \"\" {\n      return codegen.call_fn_want(\n        mut g,\n        codegen.prelude_name(m),\n        [first],\n        drop(args, 1),\n        want,\n      )\n    },\n    _ => (),\n  }\n  // a built-in under its own name: `get` in a module whose type has a\n  // method `get` is stored as `std.http.get`\n  codegen.builtin_call(mut g, m, first, drop(args, 1))\n}"},{"name":"codegen.show","kind":"fn","old":"7b57043718e3abc5","new":"05b19d50775f4e0b","interface_changed":false,"affected":[],"module":"codegen","text":"/// A value as `print` and f-strings show it.\nfn show(mut g: codegen.Gen, v: codegen.V) -> codegen.V {\n  match codegen.sized(v.ty) {\n    Some(w) => {\n      n := codegen.word_to_int(mut g, w, v)\n      return codegen.call(mut g, check.TStr, \"strata_show_int\", [n])\n    },\n    None => (),\n  }\n  // the type's own `Display`\n  k := codegen.trait_method_key(\n    mut g,\n    \"Display\",\n    codegen.head_of(v.ty),\n    \"to_string\",\n  )\n  if k != \"\" {\n    return codegen.call_fn(mut g, k, [v], [])\n  }\n  match v.ty {\n    check.TStr => v,\n    check.TTrait(_) => codegen.dyn_entry(mut g, v, 1, check.TStr, []),\n    check.TUnion(_) => {\n      f := codegen.helper(mut g, \"show\", v.ty)\n      codegen.call_at(mut g, check.TStr, f, [v])\n    },\n    check.TInt => codegen.call(mut g, check.TStr, \"strata_show_int\", [v]),\n    check.TFloat => codegen.call(mut g, check.TStr, \"strata_show_float\", [v]),\n    check.TBool => codegen.call(mut g, check.TStr, \"strata_show_bool\", [v]),\n    check.TNamed { .. } | check.TList(_) => codegen.shown(mut g, v),\n    // a closure shows as its block says (`<closure (x) -> …>`)\n    check.TFn { .. } => codegen.field(mut g, v, 1, check.TStr),\n    _ => codegen.V { ty: check.TStr, op: codegen.string(mut g, \"()\") },\n  }\n}","old_text":"/// A value as `print` and f-strings show it.\nfn show(mut g: codegen.Gen, v: codegen.V) -> codegen.V {\n  match codegen.sized(v.ty) {\n    Some(w) => {\n      n := codegen.word_to_int(mut g, w, v)\n      return codegen.call(mut g, TStr, \"strata_show_int\", [n])\n    },\n    None => (),\n  }\n  // the type's own `Display`\n  k := codegen.trait_method_key(\n    mut g,\n    \"Display\",\n    codegen.head_of(v.ty),\n    \"to_string\",\n  )\n  if k != \"\" {\n    return codegen.call_fn(mut g, k, [v], [])\n  }\n  match v.ty {\n    TStr => v,\n    TTrait(_) => codegen.dyn_entry(mut g, v, 1, TStr, []),\n    TUnion(_) => {\n      f := codegen.helper(mut g, \"show\", v.ty)\n      codegen.call_at(mut g, TStr, f, [v])\n    },\n    TInt => codegen.call(mut g, TStr, \"strata_show_int\", [v]),\n    TFloat => codegen.call(mut g, TStr, \"strata_show_float\", [v]),\n    TBool => codegen.call(mut g, TStr, \"strata_show_bool\", [v]),\n    TNamed { .. } | TList(_) => codegen.shown(mut g, v),\n    // a closure shows as its block says (`<closure (x) -> …>`)\n    TFn { .. } => codegen.field(mut g, v, 1, TStr),\n    _ => codegen.V { ty: TStr, op: codegen.string(mut g, \"()\") },\n  }\n}"},{"name":"codegen.shown","kind":"fn","old":"3cdd3ebfa656dcb9","new":"fb49f3d96eee72ea","interface_changed":false,"affected":[],"module":"codegen","text":"/// A value as code writes it (a quoted string, `Point { x: 1 }`): fault\n/// messages, and values nested in what `print` shows.\nfn shown(mut g: codegen.Gen, v: codegen.V) -> codegen.V {\n  if codegen.opaque(v.ty) {\n    return codegen.V {\n      ty: check.TStr,\n      op: codegen.string(mut g, \"<\" + codegen.opaque_name(v.ty) + \">\"),\n    }\n  }\n  match codegen.sized(v.ty) {\n    Some(_) => return codegen.show(mut g, v),\n    None => (),\n  }\n  // the type's own `Debug`\n  k := codegen.trait_method_key(\n    mut g,\n    \"Debug\",\n    codegen.head_of(v.ty),\n    \"debug\",\n  )\n  if k != \"\" {\n    return codegen.call_fn(mut g, k, [v], [])\n  }\n  match v.ty {\n    check.TStr => codegen.call(mut g, check.TStr, \"strata_debug_str\", [v]),\n    check.TTrait(_) => codegen.dyn_entry(mut g, v, 2, check.TStr, []),\n    check.TUnion(_) => {\n      f := codegen.helper(mut g, \"debug\", v.ty)\n      codegen.call_at(mut g, check.TStr, f, [v])\n    },\n    check.TNamed { .. } | check.TList(_) => {\n      f := codegen.helper(mut g, \"debug\", v.ty)\n      codegen.call_at(mut g, check.TStr, f, [v])\n    },\n    _ => codegen.show(mut g, v),\n  }\n}","old_text":"/// A value as code writes it (a quoted string, `Point { x: 1 }`): fault\n/// messages, and values nested in what `print` shows.\nfn shown(mut g: codegen.Gen, v: codegen.V) -> codegen.V {\n  if codegen.opaque(v.ty) {\n    return codegen.V {\n      ty: TStr,\n      op: codegen.string(mut g, \"<\" + codegen.opaque_name(v.ty) + \">\"),\n    }\n  }\n  match codegen.sized(v.ty) {\n    Some(_) => return codegen.show(mut g, v),\n    None => (),\n  }\n  // the type's own `Debug`\n  k := codegen.trait_method_key(\n    mut g,\n    \"Debug\",\n    codegen.head_of(v.ty),\n    \"debug\",\n  )\n  if k != \"\" {\n    return codegen.call_fn(mut g, k, [v], [])\n  }\n  match v.ty {\n    TStr => codegen.call(mut g, TStr, \"strata_debug_str\", [v]),\n    TTrait(_) => codegen.dyn_entry(mut g, v, 2, TStr, []),\n    TUnion(_) => {\n      f := codegen.helper(mut g, \"debug\", v.ty)\n      codegen.call_at(mut g, TStr, f, [v])\n    },\n    TNamed { .. } | TList(_) => {\n      f := codegen.helper(mut g, \"debug\", v.ty)\n      codegen.call_at(mut g, TStr, f, [v])\n    },\n    _ => codegen.show(mut g, v),\n  }\n}"},{"name":"codegen.concat","kind":"fn","old":"e902dbbfd2af107d","new":"223077c98f677c9e","interface_changed":false,"affected":[],"module":"codegen","text":"fn concat(mut g: codegen.Gen, parts: List[codegen.V]) -> codegen.V {\n  mut acc := codegen.V { ty: check.TStr, op: codegen.string(mut g, \"\") }\n  for (k, p) in enumerate(parts) {\n    acc = if k == 0 {\n      p\n    } else {\n      codegen.call(mut g, check.TStr, \"strata_concat\", [acc, p])\n    }\n  }\n  acc\n}","old_text":"fn concat(mut g: codegen.Gen, parts: List[codegen.V]) -> codegen.V {\n  mut acc := codegen.V { ty: TStr, op: codegen.string(mut g, \"\") }\n  for (k, p) in enumerate(parts) {\n    acc = if k == 0 {\n      p\n    } else {\n      codegen.call(mut g, TStr, \"strata_concat\", [acc, p])\n    }\n  }\n  acc\n}"},{"name":"codegen.interp","kind":"fn","old":"b3dea660faf2ce5f","new":"40aa1c9f07ac8325","interface_changed":false,"affected":[],"module":"codegen","text":"fn interp(mut g: codegen.Gen, parts: List[ast.StrPart]) -> codegen.V {\n  mut vs := []\n  for p in parts {\n    match p {\n      ast.TextPart(s) => mut vs.push(\n        codegen.V { ty: check.TStr, op: codegen.string(mut g, s) },\n      ),\n      ast.ValuePart { value, spec } => {\n        v := codegen.expr(mut g, value)\n        if v.ty is check.TAny {\n          return v\n        }\n        mut vs.push(\n          match spec {\n            Some(f) => codegen.format_spec(mut g, v, f),\n            None => codegen.show(mut g, v),\n          },\n        )\n      },\n    }\n  }\n  codegen.concat(mut g, vs)\n}","old_text":"fn interp(mut g: codegen.Gen, parts: List[ast.StrPart]) -> codegen.V {\n  mut vs := []\n  for p in parts {\n    match p {\n      ast.TextPart(s) => mut vs.push(codegen.V { ty: TStr, op: codegen.string(mut g, s) }),\n      ast.ValuePart { value, spec } => {\n        v := codegen.expr(mut g, value)\n        if v.ty is TAny {\n          return v\n        }\n        mut vs.push(\n          match spec {\n            Some(f) => codegen.format_spec(mut g, v, f),\n            None => codegen.show(mut g, v),\n          },\n        )\n      },\n    }\n  }\n  codegen.concat(mut g, vs)\n}"},{"name":"codegen.if_expr","kind":"fn","old":"1ab8d53fd35236f0","new":"5267552e8aa2bc75","interface_changed":false,"affected":[],"module":"codegen","text":"fn if_expr(\n  mut g: codegen.Gen,\n  cond: ast.Expr,\n  then: ast.Expr,\n  otherwise: ast.Expr,\n) -> codegen.V {\n  codegen.if_want(mut g, cond, then, otherwise, check.TAny)\n}","old_text":"fn if_expr(\n  mut g: codegen.Gen,\n  cond: ast.Expr,\n  then: ast.Expr,\n  otherwise: ast.Expr,\n) -> codegen.V {\n  codegen.if_want(mut g, cond, then, otherwise, TAny)\n}"},{"name":"codegen.join_values","kind":"fn","old":"dc9458035559e27e","new":"dd7da351e1d703bc","interface_changed":false,"affected":[],"module":"codegen","text":"/// A `phi` joining a branching expression's values.\n/// A branch that never comes gives `poison` from its unreachable end. A\n/// branch giving `()` where others give a value (a `match` statement with\n/// arms of different types) gives a constant that holds nothing, which\n/// drops skip.\nfn join_values(\n  mut g: codegen.Gen,\n  incoming: List[(codegen.V, String)],\n) -> codegen.V {\n  mut t := check.TAny\n  for x in incoming {\n    t = codegen.better(t, x.0.ty)\n  }\n  if t is check.TAny {\n    codegen.emit(mut g, \"unreachable\")\n    codegen.dead(mut g)\n    return codegen.never()\n  }\n  if !codegen.has_value(t) {\n    return codegen.V { ty: t, op: \"\" }\n  }\n  nothing := match codegen.ll(t) {\n    \"ptr\" => codegen.string(mut g, \"\"),\n    \"double\" => \"0.0\",\n    \"i1\" => \"false\",\n    _ => \"0\",\n  }\n  r := codegen.fresh(mut g, \"phi\")\n  ins := join(incoming.map(\n    x -> \"[ \"\n      + if x.0.op == \"\" {\n        nothing\n      } else {\n        x.0.op\n      }\n      + \", %\"\n      + x.1\n      + \" ]\",\n  ), \", \")\n  codegen.emit(mut g, f\"{r} = phi {codegen.ll(t)} {ins}\")\n  codegen.V { ty: t, op: r }\n}","old_text":"/// A `phi` joining a branching expression's values.\n/// A branch that never comes gives `poison` from its unreachable end. A\n/// branch giving `()` where others give a value (a `match` statement with\n/// arms of different types) gives a constant that holds nothing, which\n/// drops skip.\nfn join_values(\n  mut g: codegen.Gen,\n  incoming: List[(codegen.V, String)],\n) -> codegen.V {\n  mut t := TAny\n  for x in incoming {\n    t = codegen.better(t, x.0.ty)\n  }\n  if t is TAny {\n    codegen.emit(mut g, \"unreachable\")\n    codegen.dead(mut g)\n    return codegen.never()\n  }\n  if !codegen.has_value(t) {\n    return codegen.V { ty: t, op: \"\" }\n  }\n  nothing := match codegen.ll(t) {\n    \"ptr\" => codegen.string(mut g, \"\"),\n    \"double\" => \"0.0\",\n    \"i1\" => \"false\",\n    _ => \"0\",\n  }\n  r := codegen.fresh(mut g, \"phi\")\n  ins := join(incoming.map(\n    x -> \"[ \"\n      + if x.0.op == \"\" {\n        nothing\n      } else {\n        x.0.op\n      }\n      + \", %\"\n      + x.1\n      + \" ]\",\n  ), \", \")\n  codegen.emit(mut g, f\"{r} = phi {codegen.ll(t)} {ins}\")\n  codegen.V { ty: t, op: r }\n}"},{"name":"codegen.binary","kind":"fn","old":"b10391b864eda9e0","new":"50f1bb88f5a39ccc","interface_changed":false,"affected":[],"module":"codegen","text":"fn binary(\n  mut g: codegen.Gen,\n  op: ast.BinOp,\n  l: ast.Expr,\n  r: ast.Expr,\n) -> codegen.V {\n  match op {\n    ast.And | ast.Or | ast.Implies => return codegen.logic(mut g, op, l, r),\n    // a field-less constructor on one side is a tag test on the other, so\n    // the type needs no `==` (`f == None` with `f` a function)\n    ast.Equal | ast.NotEqual => match codegen.bare_ctor(g, r) {\n      Some(c) => return codegen.tag_test(mut g, op, l, c),\n      None => match codegen.bare_ctor(g, l) {\n        Some(c) => return codegen.tag_test(mut g, op, r, c),\n        None => (),\n      },\n    },\n    _ => (),\n  }\n  // `xs + [x]` on a list of trait values: the literal's elements are made\n  // trait values like `xs`'s\n  match (op, r) {\n    (ast.Add, ast.ListExpr(_)) => if !codegen.assigns(r) {\n      a := codegen.expr(mut g, l)\n      if a.ty is check.TAny {\n        return a\n      }\n      b := match a.ty {\n        check.TList(et) => if codegen.holds_trait(et) {\n          codegen.expr_want(mut g, r, a.ty)\n        } else {\n          codegen.expr(mut g, r)\n        },\n        _ => codegen.expr(mut g, r),\n      }\n      return codegen.apply(mut g, op, a, b)\n    },\n    _ => (),\n  }\n  // a method's result next to a literal takes the literal's type\n  // (`Cell { v: None }.get_or_zero() + 1`)\n  vs := match codegen.operands_want(\n    mut g,\n    [l, r],\n    [codegen.beside(l, r), codegen.beside(r, l)],\n  ) {\n    Some(vs) => vs,\n    None => return codegen.never(),\n  }\n  codegen.apply(\n    mut g,\n    op,\n    get(vs, 0) ?? codegen.unit(),\n    get(vs, 1) ?? codegen.unit(),\n  )\n}","old_text":"fn binary(\n  mut g: codegen.Gen,\n  op: ast.BinOp,\n  l: ast.Expr,\n  r: ast.Expr,\n) -> codegen.V {\n  match op {\n    ast.And | ast.Or | ast.Implies => return codegen.logic(mut g, op, l, r),\n    // a field-less constructor on one side is a tag test on the other, so\n    // the type needs no `==` (`f == None` with `f` a function)\n    ast.Equal | ast.NotEqual => match codegen.bare_ctor(g, r) {\n      Some(c) => return codegen.tag_test(mut g, op, l, c),\n      None => match codegen.bare_ctor(g, l) {\n        Some(c) => return codegen.tag_test(mut g, op, r, c),\n        None => (),\n      },\n    },\n    _ => (),\n  }\n  // `xs + [x]` on a list of trait values: the literal's elements are made\n  // trait values like `xs`'s\n  match (op, r) {\n    (ast.Add, ast.ListExpr(_)) => if !codegen.assigns(r) {\n      a := codegen.expr(mut g, l)\n      if a.ty is TAny {\n        return a\n      }\n      b := match a.ty {\n        TList(et) => if codegen.holds_trait(et) {\n          codegen.expr_want(mut g, r, a.ty)\n        } else {\n          codegen.expr(mut g, r)\n        },\n        _ => codegen.expr(mut g, r),\n      }\n      return codegen.apply(mut g, op, a, b)\n    },\n    _ => (),\n  }\n  // a method's result next to a literal takes the literal's type\n  // (`Cell { v: None }.get_or_zero() + 1`)\n  vs := match codegen.operands_want(\n    mut g,\n    [l, r],\n    [codegen.beside(l, r), codegen.beside(r, l)],\n  ) {\n    Some(vs) => vs,\n    None => return codegen.never(),\n  }\n  codegen.apply(\n    mut g,\n    op,\n    get(vs, 0) ?? codegen.unit(),\n    get(vs, 1) ?? codegen.unit(),\n  )\n}"},{"name":"codegen.logic","kind":"fn","old":"491ebfa0829d565f","new":"524fa06a3881ad9a","interface_changed":false,"affected":[],"module":"codegen","text":"/// `&&`, `||`, `==>`: the right side runs only when it decides.\nfn logic(\n  mut g: codegen.Gen,\n  op: ast.BinOp,\n  l: ast.Expr,\n  r: ast.Expr,\n) -> codegen.V {\n  a := codegen.expr(mut g, l)\n  if a.ty is check.TAny {\n    return a\n  }\n  from := codegen.current(g)\n  (rhs, end) := (codegen.label(mut g, \"rhs\"), codegen.label(mut g, \"logic\"))\n  short := match op {\n    ast.Or => {\n      codegen.emit(\n        mut g,\n        f\"br i1 {a.op}, label %{end}, label %{rhs}\",\n      )\n      \"true\"\n    },\n    ast.And => {\n      codegen.emit(\n        mut g,\n        f\"br i1 {a.op}, label %{rhs}, label %{end}\",\n      )\n      \"false\"\n    },\n    _ => {\n      codegen.emit(\n        mut g,\n        f\"br i1 {a.op}, label %{rhs}, label %{end}\",\n      )\n      \"true\"\n    },\n  }\n  codegen.block(mut g, rhs)\n  codegen.push_transparent(mut g)\n  b0 := codegen.expr(mut g, r)\n  b := codegen.leave_branch(mut g, b0)\n  from_b := codegen.current(g)\n  codegen.br(mut g, end)\n  codegen.block(mut g, end)\n  codegen.join_values(\n    mut g,\n    [(codegen.V { ty: check.TBool, op: short }, from), (b, from_b)],\n  )\n}","old_text":"/// `&&`, `||`, `==>`: the right side runs only when it decides.\nfn logic(\n  mut g: codegen.Gen,\n  op: ast.BinOp,\n  l: ast.Expr,\n  r: ast.Expr,\n) -> codegen.V {\n  a := codegen.expr(mut g, l)\n  if a.ty is TAny {\n    return a\n  }\n  from := codegen.current(g)\n  (rhs, end) := (codegen.label(mut g, \"rhs\"), codegen.label(mut g, \"logic\"))\n  short := match op {\n    ast.Or => {\n      codegen.emit(\n        mut g,\n        f\"br i1 {a.op}, label %{end}, label %{rhs}\",\n      )\n      \"true\"\n    },\n    ast.And => {\n      codegen.emit(\n        mut g,\n        f\"br i1 {a.op}, label %{rhs}, label %{end}\",\n      )\n      \"false\"\n    },\n    _ => {\n      codegen.emit(\n        mut g,\n        f\"br i1 {a.op}, label %{rhs}, label %{end}\",\n      )\n      \"true\"\n    },\n  }\n  codegen.block(mut g, rhs)\n  codegen.push_transparent(mut g)\n  b0 := codegen.expr(mut g, r)\n  b := codegen.leave_branch(mut g, b0)\n  from_b := codegen.current(g)\n  codegen.br(mut g, end)\n  codegen.block(mut g, end)\n  codegen.join_values(\n    mut g,\n    [(codegen.V { ty: TBool, op: short }, from), (b, from_b)],\n  )\n}"},{"name":"codegen.apply","kind":"fn","old":"6de4f752ad229517","new":"be16bf17c3e08061","interface_changed":false,"affected":[],"module":"codegen","text":"fn apply(\n  mut g: codegen.Gen,\n  op: ast.BinOp,\n  a0: codegen.V,\n  b0: codegen.V,\n) -> codegen.V {\n  // an integer literal next to a sized integer takes its type\n  a := codegen.as_type(mut g, a0, b0.ty)\n  b := codegen.as_type(mut g, b0, a0.ty)\n  match codegen.sized(a.ty) {\n    Some(w) => match op {\n      ast.Equal | ast.NotEqual => (),\n      _ => return codegen.word_op(mut g, op, w, a, b),\n    },\n    None => (),\n  }\n  match op {\n    ast.Equal => return codegen.equal(mut g, a, b),\n    ast.NotEqual => {\n      e := codegen.equal(mut g, a, b)\n      r := codegen.fresh(mut g, \"ne\")\n      codegen.emit(mut g, f\"{r} = xor i1 {e.op}, true\")\n      return codegen.V { ty: check.TBool, op: r }\n    },\n    _ => (),\n  }\n  match a.ty {\n    check.TInt => match op {\n      ast.Add => codegen.int_op(mut g, \"sadd\", a, b),\n      ast.Sub => codegen.int_op(mut g, \"ssub\", a, b),\n      ast.Mul => codegen.int_op(mut g, \"smul\", a, b),\n      // proven nonzero: the runtime division without its zero check\n      ast.Div | ast.Mod => {\n        nz := if codegen.proven(mut g, \"no division by zero\", \"exact\") {\n          \"_nz\"\n        } else {\n          \"\"\n        }\n        f := if op is ast.Div {\n          \"strata_div\"\n        } else {\n          \"strata_mod\"\n        }\n        codegen.call(mut g, check.TInt, f + nz, [a, b])\n      },\n      ast.BitAnd => codegen.bit_op(mut g, \"and\", a, b),\n      ast.BitOr => codegen.bit_op(mut g, \"or\", a, b),\n      ast.BitXor => codegen.bit_op(mut g, \"xor\", a, b),\n      ast.Shl => codegen.call(mut g, check.TInt, \"strata_shl\", [a, b]),\n      ast.Shr => codegen.call(mut g, check.TInt, \"strata_shr\", [a, b]),\n      ast.Less => codegen.int_compare(mut g, \"slt\", a, b),\n      ast.LessEq => codegen.int_compare(mut g, \"sle\", a, b),\n      ast.Greater => codegen.int_compare(mut g, \"sgt\", a, b),\n      ast.GreaterEq => codegen.int_compare(mut g, \"sge\", a, b),\n      _ => codegen.bad_op(mut g, op),\n    },\n    check.TFloat => match op {\n      ast.Add | ast.Sub | ast.Mul | ast.Div => {\n        ins := match op {\n          ast.Add => \"fadd\",\n          ast.Sub => \"fsub\",\n          ast.Mul => \"fmul\",\n          _ => \"fdiv\",\n        }\n        r := codegen.fresh(mut g, \"f\")\n        codegen.emit(mut g, f\"{r} = {ins} double {a.op}, {b.op}\")\n        codegen.finite(\n          mut g,\n          codegen.V { ty: check.TFloat, op: r },\n          a,\n          b,\n          op,\n        )\n      },\n      ast.Mod => {\n        r := codegen.call(mut g, check.TFloat, \"strata_fmod\", [a, b])\n        codegen.finite(mut g, r, a, b, op)\n      },\n      ast.Less => codegen.compare(mut g, \"fcmp olt\", a, b),\n      ast.LessEq => codegen.compare(mut g, \"fcmp ole\", a, b),\n      ast.Greater => codegen.compare(mut g, \"fcmp ogt\", a, b),\n      ast.GreaterEq => codegen.compare(mut g, \"fcmp oge\", a, b),\n      _ => codegen.bad_op(mut g, op),\n    },\n    check.TStr => match op {\n      ast.Add => codegen.call(mut g, check.TStr, \"strata_concat\", [a, b]),\n      // code point order, which UTF-8 byte order preserves (`strata_str_cmp`)\n      ast.Less | ast.LessEq | ast.Greater | ast.GreaterEq => {\n        codegen.use_rt(mut g, \"strata_str_cmp\")\n        c := codegen.fresh(mut g, \"sc\")\n        codegen.emit(\n          mut g,\n          f\"{c} = call i64 @strata_str_cmp(ptr {a.op}, ptr {b.op})\",\n        )\n        pred := match op {\n          ast.Less => \"slt\",\n          ast.LessEq => \"sle\",\n          ast.Greater => \"sgt\",\n          _ => \"sge\",\n        }\n        codegen.compare(\n          mut g,\n          \"icmp \" + pred,\n          codegen.V { ty: check.TInt, op: c },\n          codegen.V { ty: check.TInt, op: \"0\" },\n        )\n      },\n      _ => codegen.bad_op(mut g, op),\n    },\n    check.TList(et) => match op {\n      ast.Add => {\n        t := codegen.better(a.ty, b.ty)\n        k := codegen.elements_kind(match t {\n          check.TList(x) => x,\n          _ => et,\n        })\n        codegen.call(mut g, t, \"strata_list_concat\", [a, b, k])\n      },\n      _ => codegen.bad_op(mut g, op),\n    },\n    _ => codegen.bad_op(mut g, op),\n  }\n}","old_text":"fn apply(\n  mut g: codegen.Gen,\n  op: ast.BinOp,\n  a0: codegen.V,\n  b0: codegen.V,\n) -> codegen.V {\n  // an integer literal next to a sized integer takes its type\n  a := codegen.as_type(mut g, a0, b0.ty)\n  b := codegen.as_type(mut g, b0, a0.ty)\n  match codegen.sized(a.ty) {\n    Some(w) => match op {\n      ast.Equal | ast.NotEqual => (),\n      _ => return codegen.word_op(mut g, op, w, a, b),\n    },\n    None => (),\n  }\n  match op {\n    ast.Equal => return codegen.equal(mut g, a, b),\n    ast.NotEqual => {\n      e := codegen.equal(mut g, a, b)\n      r := codegen.fresh(mut g, \"ne\")\n      codegen.emit(mut g, f\"{r} = xor i1 {e.op}, true\")\n      return codegen.V { ty: TBool, op: r }\n    },\n    _ => (),\n  }\n  match a.ty {\n    TInt => match op {\n      ast.Add => codegen.int_op(mut g, \"sadd\", a, b),\n      ast.Sub => codegen.int_op(mut g, \"ssub\", a, b),\n      ast.Mul => codegen.int_op(mut g, \"smul\", a, b),\n      // proven nonzero: the runtime division without its zero check\n      ast.Div | ast.Mod => {\n        nz := if codegen.proven(mut g, \"no division by zero\", \"exact\") {\n          \"_nz\"\n        } else {\n          \"\"\n        }\n        f := if op is ast.Div {\n          \"strata_div\"\n        } else {\n          \"strata_mod\"\n        }\n        codegen.call(mut g, TInt, f + nz, [a, b])\n      },\n      ast.BitAnd => codegen.bit_op(mut g, \"and\", a, b),\n      ast.BitOr => codegen.bit_op(mut g, \"or\", a, b),\n      ast.BitXor => codegen.bit_op(mut g, \"xor\", a, b),\n      ast.Shl => codegen.call(mut g, TInt, \"strata_shl\", [a, b]),\n      ast.Shr => codegen.call(mut g, TInt, \"strata_shr\", [a, b]),\n      ast.Less => codegen.int_compare(mut g, \"slt\", a, b),\n      ast.LessEq => codegen.int_compare(mut g, \"sle\", a, b),\n      ast.Greater => codegen.int_compare(mut g, \"sgt\", a, b),\n      ast.GreaterEq => codegen.int_compare(mut g, \"sge\", a, b),\n      _ => codegen.bad_op(mut g, op),\n    },\n    TFloat => match op {\n      ast.Add | ast.Sub | ast.Mul | ast.Div => {\n        ins := match op {\n          ast.Add => \"fadd\",\n          ast.Sub => \"fsub\",\n          ast.Mul => \"fmul\",\n          _ => \"fdiv\",\n        }\n        r := codegen.fresh(mut g, \"f\")\n        codegen.emit(mut g, f\"{r} = {ins} double {a.op}, {b.op}\")\n        codegen.finite(\n          mut g,\n          codegen.V { ty: TFloat, op: r },\n          a,\n          b,\n          op,\n        )\n      },\n      ast.Mod => {\n        r := codegen.call(mut g, TFloat, \"strata_fmod\", [a, b])\n        codegen.finite(mut g, r, a, b, op)\n      },\n      ast.Less => codegen.compare(mut g, \"fcmp olt\", a, b),\n      ast.LessEq => codegen.compare(mut g, \"fcmp ole\", a, b),\n      ast.Greater => codegen.compare(mut g, \"fcmp ogt\", a, b),\n      ast.GreaterEq => codegen.compare(mut g, \"fcmp oge\", a, b),\n      _ => codegen.bad_op(mut g, op),\n    },\n    TStr => match op {\n      ast.Add => codegen.call(mut g, TStr, \"strata_concat\", [a, b]),\n      // code point order, which UTF-8 byte order preserves (`strata_str_cmp`)\n      ast.Less | ast.LessEq | ast.Greater | ast.GreaterEq => {\n        codegen.use_rt(mut g, \"strata_str_cmp\")\n        c := codegen.fresh(mut g, \"sc\")\n        codegen.emit(\n          mut g,\n          f\"{c} = call i64 @strata_str_cmp(ptr {a.op}, ptr {b.op})\",\n        )\n        pred := match op {\n          ast.Less => \"slt\",\n          ast.LessEq => \"sle\",\n          ast.Greater => \"sgt\",\n          _ => \"sge\",\n        }\n        codegen.compare(\n          mut g,\n          \"icmp \" + pred,\n          codegen.V { ty: TInt, op: c },\n          codegen.V { ty: TInt, op: \"0\" },\n        )\n      },\n      _ => codegen.bad_op(mut g, op),\n    },\n    TList(et) => match op {\n      ast.Add => {\n        t := codegen.better(a.ty, b.ty)\n        k := codegen.elements_kind(match t {\n          TList(x) => x,\n          _ => et,\n        })\n        codegen.call(mut g, t, \"strata_list_concat\", [a, b, k])\n      },\n      _ => codegen.bad_op(mut g, op),\n    },\n    _ => codegen.bad_op(mut g, op),\n  }\n}"},{"name":"codegen.finite","kind":"fn","old":"b7b97e42424964fe","new":"137e1622b29eb9c4","interface_changed":false,"affected":[],"module":"codegen","text":"/// A float operation's result. The runtime faults unless it is finite;\n/// `op` names the operation in the message.\nfn finite(\n  mut g: codegen.Gen,\n  r: codegen.V,\n  a: codegen.V,\n  b: codegen.V,\n  op: ast.BinOp,\n) -> codegen.V {\n  sym := codegen.string(mut g, text.op_text(op))\n  codegen.call(\n    mut g,\n    check.TFloat,\n    \"strata_finite\",\n    [r, a, b, codegen.V { ty: check.TStr, op: sym }],\n  )\n}","old_text":"/// A float operation's result. The runtime faults unless it is finite;\n/// `op` names the operation in the message.\nfn finite(\n  mut g: codegen.Gen,\n  r: codegen.V,\n  a: codegen.V,\n  b: codegen.V,\n  op: ast.BinOp,\n) -> codegen.V {\n  sym := codegen.string(mut g, text.op_text(op))\n  codegen.call(\n    mut g,\n    TFloat,\n    \"strata_finite\",\n    [r, a, b, codegen.V { ty: TStr, op: sym }],\n  )\n}"},{"name":"codegen.compare","kind":"fn","old":"ae78f9e487fb9709","new":"da7b29bf2438cca3","interface_changed":false,"affected":[],"module":"codegen","text":"fn compare(\n  mut g: codegen.Gen,\n  ins: String,\n  a: codegen.V,\n  b: codegen.V,\n) -> codegen.V {\n  r := codegen.fresh(mut g, \"cmp\")\n  codegen.emit(\n    mut g,\n    f\"{r} = {ins} {codegen.ll(a.ty)} {a.op}, {b.op}\",\n  )\n  codegen.V { ty: check.TBool, op: r }\n}","old_text":"fn compare(\n  mut g: codegen.Gen,\n  ins: String,\n  a: codegen.V,\n  b: codegen.V,\n) -> codegen.V {\n  r := codegen.fresh(mut g, \"cmp\")\n  codegen.emit(\n    mut g,\n    f\"{r} = {ins} {codegen.ll(a.ty)} {a.op}, {b.op}\",\n  )\n  codegen.V { ty: TBool, op: r }\n}"},{"name":"codegen.equal","kind":"fn","old":"3723ddd9a2fe6cac","new":"aa01e4fc4fc824a2","interface_changed":false,"affected":[],"module":"codegen","text":"fn equal(mut g: codegen.Gen, a0: codegen.V, b0: codegen.V) -> codegen.V {\n  a := codegen.as_type(mut g, a0, b0.ty)\n  b := codegen.as_type(mut g, b0, a0.ty)\n  match codegen.sized(a.ty) {\n    Some(_) => return codegen.compare(mut g, \"icmp eq\", a, b),\n    None => (),\n  }\n  // handles and channel ends: identity\n  if codegen.opaque(a.ty) {\n    return codegen.compare(mut g, \"icmp eq\", a, b)\n  }\n  match a.ty {\n    check.TUnit => codegen.V { ty: check.TBool, op: \"true\" },\n    check.TInt => {\n      // the same 64 bits, or two big integers of the same value\n      same := codegen.fresh(mut g, \"same\")\n      codegen.emit(mut g, f\"{same} = icmp eq i64 {a.op}, {b.op}\")\n      from := codegen.current(g)\n      (deep, end) := (\n        codegen.label(mut g, \"int.deep\"),\n        codegen.label(mut g, \"int.eqd\"),\n      )\n      codegen.emit(\n        mut g,\n        f\"br i1 {same}, label %{end}, label %{deep}\",\n      )\n      codegen.block(mut g, deep)\n      e := codegen.call(mut g, check.TBool, \"strata_int_eq\", [a, b])\n      codegen.br(mut g, end)\n      codegen.block(mut g, end)\n      r := codegen.fresh(mut g, \"eq\")\n      codegen.emit(\n        mut g,\n        f\"{r} = phi i1 [ true, %{from} ], [ {e.op}, %{deep} ]\",\n      )\n      codegen.V { ty: check.TBool, op: r }\n    },\n    check.TBool => codegen.compare(mut g, \"icmp eq\", a, b),\n    check.TFloat => codegen.compare(mut g, \"fcmp oeq\", a, b),\n    check.TStr => codegen.call(mut g, check.TBool, \"strata_str_eq\", [a, b]),\n    check.TTrait(_) => codegen.dyn_equal(mut g, a, b),\n    check.TUnion(_) => {\n      f := codegen.helper(mut g, \"eq\", a.ty)\n      codegen.call_at(mut g, check.TBool, f, [a, b])\n    },\n    // the same keys with equal entries, in any order\n    check.TNamed { name: \"Set\", .. } | check.TNamed { name: \"Dict\", .. } => {\n      fs := codegen.table_fns(mut g, a.ty)\n      eq := codegen.V {\n        ty: check.TStr,\n        op: codegen.slot_fn(mut g, \"eq\", codegen.entry_ty(a.ty)),\n      }\n      codegen.use_rt(mut g, \"strata_tbl_eq\")\n      codegen.call_bare(mut g, check.TBool, \"@strata_tbl_eq\", [\n        a,\n        b,\n        get(fs, 0) ?? codegen.unit(),\n        get(fs, 1) ?? codegen.unit(),\n        eq,\n        get(fs, 2) ?? codegen.unit(),\n      ])\n    },\n    check.TNamed { .. } | check.TList(_) => {\n      f := codegen.helper(mut g, \"eq\", a.ty)\n      codegen.call_at(mut g, check.TBool, f, [a, b])\n    },\n    _ => codegen.bad_op(mut g, ast.Equal),\n  }\n}","old_text":"fn equal(mut g: codegen.Gen, a0: codegen.V, b0: codegen.V) -> codegen.V {\n  a := codegen.as_type(mut g, a0, b0.ty)\n  b := codegen.as_type(mut g, b0, a0.ty)\n  match codegen.sized(a.ty) {\n    Some(_) => return codegen.compare(mut g, \"icmp eq\", a, b),\n    None => (),\n  }\n  // handles and channel ends: identity\n  if codegen.opaque(a.ty) {\n    return codegen.compare(mut g, \"icmp eq\", a, b)\n  }\n  match a.ty {\n    TUnit => codegen.V { ty: TBool, op: \"true\" },\n    TInt => {\n      // the same 64 bits, or two big integers of the same value\n      same := codegen.fresh(mut g, \"same\")\n      codegen.emit(mut g, f\"{same} = icmp eq i64 {a.op}, {b.op}\")\n      from := codegen.current(g)\n      (deep, end) := (\n        codegen.label(mut g, \"int.deep\"),\n        codegen.label(mut g, \"int.eqd\"),\n      )\n      codegen.emit(\n        mut g,\n        f\"br i1 {same}, label %{end}, label %{deep}\",\n      )\n      codegen.block(mut g, deep)\n      e := codegen.call(mut g, TBool, \"strata_int_eq\", [a, b])\n      codegen.br(mut g, end)\n      codegen.block(mut g, end)\n      r := codegen.fresh(mut g, \"eq\")\n      codegen.emit(\n        mut g,\n        f\"{r} = phi i1 [ true, %{from} ], [ {e.op}, %{deep} ]\",\n      )\n      codegen.V { ty: TBool, op: r }\n    },\n    TBool => codegen.compare(mut g, \"icmp eq\", a, b),\n    TFloat => codegen.compare(mut g, \"fcmp oeq\", a, b),\n    TStr => codegen.call(mut g, TBool, \"strata_str_eq\", [a, b]),\n    TTrait(_) => codegen.dyn_equal(mut g, a, b),\n    TUnion(_) => {\n      f := codegen.helper(mut g, \"eq\", a.ty)\n      codegen.call_at(mut g, TBool, f, [a, b])\n    },\n    // the same keys with equal entries, in any order\n    TNamed { name: \"Set\", .. } | TNamed { name: \"Dict\", .. } => {\n      fs := codegen.table_fns(mut g, a.ty)\n      eq := codegen.V {\n        ty: TStr,\n        op: codegen.slot_fn(mut g, \"eq\", codegen.entry_ty(a.ty)),\n      }\n      codegen.use_rt(mut g, \"strata_tbl_eq\")\n      codegen.call_bare(mut g, TBool, \"@strata_tbl_eq\", [\n        a,\n        b,\n        get(fs, 0) ?? codegen.unit(),\n        get(fs, 1) ?? codegen.unit(),\n        eq,\n        get(fs, 2) ?? codegen.unit(),\n      ])\n    },\n    TNamed { .. } | TList(_) => {\n      f := codegen.helper(mut g, \"eq\", a.ty)\n      codegen.call_at(mut g, TBool, f, [a, b])\n    },\n    _ => codegen.bad_op(mut g, ast.Equal),\n  }\n}"},{"name":"codegen.int_op","kind":"fn","old":"30ae3b52fdf54741","new":"6920f57980e56450","interface_changed":false,"affected":[],"module":"codegen","text":"/// `+`, `-`, `*` on `Int`s: inline 64-bit arithmetic when both operands and\n/// the result are small, else a big-integer runtime call. Emitted once as a\n/// module function.\nfn int_op(\n  mut g: codegen.Gen,\n  op: String,\n  a: codegen.V,\n  b: codegen.V,\n) -> codegen.V {\n  f := match op {\n    \"sadd\" => \"add\",\n    \"ssub\" => \"sub\",\n    _ => \"mul\",\n  }\n  codegen.use_rt(mut g, f\"llvm.{op}.with.overflow.i64\")\n  codegen.use_rt(mut g, \"strata_int_\" + f)\n  h := codegen.int_helper(\n    mut g,\n    \"int.\" + f,\n    \"i64\",\n    [\n      f\"  %pair = call {{ i64, i1 }} @llvm.{op}.with.overflow.i64(i64 %a, i64 %b)\",\n      \"  %r = extractvalue { i64, i1 } %pair, 0\",\n      \"  %ov = extractvalue { i64, i1 } %pair, 1\",\n      \"  %sa = shl i64 %a, 1\",\n      \"  %xa = xor i64 %a, %sa\",\n      \"  %sb = shl i64 %b, 1\",\n      \"  %xb = xor i64 %b, %sb\",\n      \"  %sr = shl i64 %r, 1\",\n      \"  %xr = xor i64 %r, %sr\",\n      \"  %o1 = or i64 %xa, %xb\",\n      \"  %o2 = or i64 %o1, %xr\",\n      \"  %small = icmp sge i64 %o2, 0\",\n      \"  %nov = xor i1 %ov, true\",\n      \"  %fast = and i1 %small, %nov\",\n      \"  br i1 %fast, label %done, label %big\",\n      \"done:\",\n      \"  ret i64 %r\",\n      \"big:\",\n      f\"  %slow = call i64 @strata_int_{f}(i64 %a, i64 %b)\",\n      \"  ret i64 %slow\",\n    ],\n  )\n  n := codegen.fresh(mut g, \"n\")\n  codegen.emit(mut g, f\"{n} = call i64 {h}(i64 {a.op}, i64 {b.op})\")\n  codegen.temp(mut g, codegen.V { ty: check.TInt, op: n })\n}","old_text":"/// `+`, `-`, `*` on `Int`s: inline 64-bit arithmetic when both operands and\n/// the result are small, else a big-integer runtime call. Emitted once as a\n/// module function.\nfn int_op(\n  mut g: codegen.Gen,\n  op: String,\n  a: codegen.V,\n  b: codegen.V,\n) -> codegen.V {\n  f := match op {\n    \"sadd\" => \"add\",\n    \"ssub\" => \"sub\",\n    _ => \"mul\",\n  }\n  codegen.use_rt(mut g, f\"llvm.{op}.with.overflow.i64\")\n  codegen.use_rt(mut g, \"strata_int_\" + f)\n  h := codegen.int_helper(\n    mut g,\n    \"int.\" + f,\n    \"i64\",\n    [\n      f\"  %pair = call {{ i64, i1 }} @llvm.{op}.with.overflow.i64(i64 %a, i64 %b)\",\n      \"  %r = extractvalue { i64, i1 } %pair, 0\",\n      \"  %ov = extractvalue { i64, i1 } %pair, 1\",\n      \"  %sa = shl i64 %a, 1\",\n      \"  %xa = xor i64 %a, %sa\",\n      \"  %sb = shl i64 %b, 1\",\n      \"  %xb = xor i64 %b, %sb\",\n      \"  %sr = shl i64 %r, 1\",\n      \"  %xr = xor i64 %r, %sr\",\n      \"  %o1 = or i64 %xa, %xb\",\n      \"  %o2 = or i64 %o1, %xr\",\n      \"  %small = icmp sge i64 %o2, 0\",\n      \"  %nov = xor i1 %ov, true\",\n      \"  %fast = and i1 %small, %nov\",\n      \"  br i1 %fast, label %done, label %big\",\n      \"done:\",\n      \"  ret i64 %r\",\n      \"big:\",\n      f\"  %slow = call i64 @strata_int_{f}(i64 %a, i64 %b)\",\n      \"  ret i64 %slow\",\n    ],\n  )\n  n := codegen.fresh(mut g, \"n\")\n  codegen.emit(mut g, f\"{n} = call i64 {h}(i64 {a.op}, i64 {b.op})\")\n  codegen.temp(mut g, codegen.V { ty: TInt, op: n })\n}"},{"name":"codegen.bit_op","kind":"fn","old":"f8663844324a1ad2","new":"3cc9f53c4e3fd021","interface_changed":false,"affected":[],"module":"codegen","text":"/// `&`, `|`, `^` on `Int`s: inline 64-bit when both are small (then so is\n/// the result), else a runtime call. Emitted once as a module function.\nfn bit_op(\n  mut g: codegen.Gen,\n  ins: String,\n  a: codegen.V,\n  b: codegen.V,\n) -> codegen.V {\n  codegen.use_rt(mut g, \"strata_int_\" + ins)\n  h := codegen.int_helper(mut g, \"int.\" + ins, \"i64\", [\n    f\"  %r = {ins} i64 %a, %b\",\n    \"  %sa = shl i64 %a, 1\",\n    \"  %xa = xor i64 %a, %sa\",\n    \"  %sb = shl i64 %b, 1\",\n    \"  %xb = xor i64 %b, %sb\",\n    \"  %o = or i64 %xa, %xb\",\n    \"  %small = icmp sge i64 %o, 0\",\n    \"  br i1 %small, label %done, label %big\",\n    \"done:\",\n    \"  ret i64 %r\",\n    \"big:\",\n    f\"  %slow = call i64 @strata_int_{ins}(i64 %a, i64 %b)\",\n    \"  ret i64 %slow\",\n  ])\n  n := codegen.fresh(mut g, \"n\")\n  codegen.emit(mut g, f\"{n} = call i64 {h}(i64 {a.op}, i64 {b.op})\")\n  codegen.temp(mut g, codegen.V { ty: check.TInt, op: n })\n}","old_text":"/// `&`, `|`, `^` on `Int`s: inline 64-bit when both are small (then so is\n/// the result), else a runtime call. Emitted once as a module function.\nfn bit_op(\n  mut g: codegen.Gen,\n  ins: String,\n  a: codegen.V,\n  b: codegen.V,\n) -> codegen.V {\n  codegen.use_rt(mut g, \"strata_int_\" + ins)\n  h := codegen.int_helper(mut g, \"int.\" + ins, \"i64\", [\n    f\"  %r = {ins} i64 %a, %b\",\n    \"  %sa = shl i64 %a, 1\",\n    \"  %xa = xor i64 %a, %sa\",\n    \"  %sb = shl i64 %b, 1\",\n    \"  %xb = xor i64 %b, %sb\",\n    \"  %o = or i64 %xa, %xb\",\n    \"  %small = icmp sge i64 %o, 0\",\n    \"  br i1 %small, label %done, label %big\",\n    \"done:\",\n    \"  ret i64 %r\",\n    \"big:\",\n    f\"  %slow = call i64 @strata_int_{ins}(i64 %a, i64 %b)\",\n    \"  ret i64 %slow\",\n  ])\n  n := codegen.fresh(mut g, \"n\")\n  codegen.emit(mut g, f\"{n} = call i64 {h}(i64 {a.op}, i64 {b.op})\")\n  codegen.temp(mut g, codegen.V { ty: TInt, op: n })\n}"},{"name":"codegen.int_compare","kind":"fn","old":"ac86447c16ac4c8b","new":"555f381b23d6707b","interface_changed":false,"affected":[],"module":"codegen","text":"/// `a PRED b` on `Int`s: compared as 64-bit values unless both are big,\n/// which also covers a big one against a small constant. Emitted once as a\n/// module function.\nfn int_compare(\n  mut g: codegen.Gen,\n  pred: String,\n  a: codegen.V,\n  b: codegen.V,\n) -> codegen.V {\n  r := codegen.fresh(mut g, \"cmp\")\n  if codegen.small_constant(a.op) || codegen.small_constant(b.op) {\n    codegen.emit(mut g, f\"{r} = icmp {pred} i64 {a.op}, {b.op}\")\n    return codegen.V { ty: check.TBool, op: r }\n  }\n  codegen.use_rt(mut g, \"strata_int_cmp\")\n  f := codegen.int_helper(mut g, \"int.cmp.\" + pred, \"i1\", [\n    \"  %sa = shl i64 %a, 1\",\n    \"  %xa = xor i64 %a, %sa\",\n    \"  %sb = shl i64 %b, 1\",\n    \"  %xb = xor i64 %b, %sb\",\n    \"  %both = and i64 %xa, %xb\",\n    \"  %bigs = icmp slt i64 %both, 0\",\n    \"  br i1 %bigs, label %big, label %small\",\n    \"small:\",\n    f\"  %r1 = icmp {pred} i64 %a, %b\",\n    \"  ret i1 %r1\",\n    \"big:\",\n    \"  %c = call i64 @strata_int_cmp(i64 %a, i64 %b)\",\n    f\"  %r2 = icmp {pred} i64 %c, 0\",\n    \"  ret i1 %r2\",\n  ])\n  codegen.emit(mut g, f\"{r} = call i1 {f}(i64 {a.op}, i64 {b.op})\")\n  codegen.V { ty: check.TBool, op: r }\n}","old_text":"/// `a PRED b` on `Int`s: compared as 64-bit values unless both are big,\n/// which also covers a big one against a small constant. Emitted once as a\n/// module function.\nfn int_compare(\n  mut g: codegen.Gen,\n  pred: String,\n  a: codegen.V,\n  b: codegen.V,\n) -> codegen.V {\n  r := codegen.fresh(mut g, \"cmp\")\n  if codegen.small_constant(a.op) || codegen.small_constant(b.op) {\n    codegen.emit(mut g, f\"{r} = icmp {pred} i64 {a.op}, {b.op}\")\n    return codegen.V { ty: TBool, op: r }\n  }\n  codegen.use_rt(mut g, \"strata_int_cmp\")\n  f := codegen.int_helper(mut g, \"int.cmp.\" + pred, \"i1\", [\n    \"  %sa = shl i64 %a, 1\",\n    \"  %xa = xor i64 %a, %sa\",\n    \"  %sb = shl i64 %b, 1\",\n    \"  %xb = xor i64 %b, %sb\",\n    \"  %both = and i64 %xa, %xb\",\n    \"  %bigs = icmp slt i64 %both, 0\",\n    \"  br i1 %bigs, label %big, label %small\",\n    \"small:\",\n    f\"  %r1 = icmp {pred} i64 %a, %b\",\n    \"  ret i1 %r1\",\n    \"big:\",\n    \"  %c = call i64 @strata_int_cmp(i64 %a, i64 %b)\",\n    f\"  %r2 = icmp {pred} i64 %c, 0\",\n    \"  ret i1 %r2\",\n  ])\n  codegen.emit(mut g, f\"{r} = call i1 {f}(i64 {a.op}, i64 {b.op})\")\n  codegen.V { ty: TBool, op: r }\n}"},{"name":"codegen.declare","kind":"fn","old":"614b414b4746ce22","new":"f2ce626fcedadcfc","interface_changed":false,"affected":[],"module":"codegen","text":"/// `x := e`, `mut x := e`, `x: T = e`.\n/// The variable takes the declared type (the checker writes inferred ones\n/// in), else the value's. A declared type's refinements are checked. Only\n/// a `mut` variable has a slot; the others are their value.\nfn declare(\n  mut g: codegen.Gen,\n  name: String,\n  ty: Option[ast.TypeExpr],\n  value: ast.Expr,\n  mutable: Bool,\n) {\n  // a trait with type arguments (`let it: Iterator[Int] = xs.iter()`) keeps\n  // the value's own type: a trait value would lose the arguments\n  want := match ty {\n    Some(x) => match x {\n      ast.Named { name: tn, args: [_, ..] } => if contains(g.traits, tn) {\n        check.TAny\n      } else {\n        codegen.lower(mut g, x)\n      },\n      _ => codegen.lower(mut g, x),\n    },\n    None => check.TAny,\n  }\n  v := codegen.expr_want(mut g, value, want)\n  if v.ty is check.TAny {\n    return\n  }\n  match ty {\n    Some(x) => if codegen.needs_check(g, x) {\n      codegen.check_type(mut g, x, v, \"let binding\", [])\n    },\n    None => (),\n  }\n  // a checker-written type the value lacks keeps the value's own type: a\n  // comprehension over an iterator is lazy, so `[f(x) for x in it]` is an\n  // iterator where the checker wrote a list\n  t := match (want, v.ty) {\n    (check.TList(_), check.TNamed { name: vn, .. }) => if vn != \"Tuple\" {\n      v.ty\n    } else {\n      codegen.better(want, v.ty)\n    },\n    _ => codegen.better(want, v.ty),\n  }\n  if mutable {\n    codegen.local_owned(mut g, name, codegen.V { ..v, ty: t })\n  } else {\n    codegen.let_owned(mut g, name, codegen.V { ..v, ty: t })\n  }\n  match (ty, codegen.lookup(g, name)) {\n    (Some(x), Some(l)) => if codegen.needs_check(g, x) {\n      mut g.declared.insert(l.slot, x)\n    },\n    _ => (),\n  }\n}","old_text":"/// `x := e`, `mut x := e`, `x: T = e`.\n/// The variable takes the declared type (the checker writes inferred ones\n/// in), else the value's. A declared type's refinements are checked. Only\n/// a `mut` variable has a slot; the others are their value.\nfn declare(\n  mut g: codegen.Gen,\n  name: String,\n  ty: Option[ast.TypeExpr],\n  value: ast.Expr,\n  mutable: Bool,\n) {\n  // a trait with type arguments (`let it: Iterator[Int] = xs.iter()`) keeps\n  // the value's own type: a trait value would lose the arguments\n  want := match ty {\n    Some(x) => match x {\n      ast.Named { name: tn, args: [_, ..] } => if contains(g.traits, tn) {\n        TAny\n      } else {\n        codegen.lower(mut g, x)\n      },\n      _ => codegen.lower(mut g, x),\n    },\n    None => TAny,\n  }\n  v := codegen.expr_want(mut g, value, want)\n  if v.ty is TAny {\n    return\n  }\n  match ty {\n    Some(x) => if codegen.needs_check(g, x) {\n      codegen.check_type(mut g, x, v, \"let binding\", [])\n    },\n    None => (),\n  }\n  // a checker-written type the value lacks keeps the value's own type: a\n  // comprehension over an iterator is lazy, so `[f(x) for x in it]` is an\n  // iterator where the checker wrote a list\n  t := match (want, v.ty) {\n    (TList(_), TNamed { name: vn, .. }) => if vn != \"Tuple\" {\n      v.ty\n    } else {\n      codegen.better(want, v.ty)\n    },\n    _ => codegen.better(want, v.ty),\n  }\n  if mutable {\n    codegen.local_owned(mut g, name, codegen.V { ..v, ty: t })\n  } else {\n    codegen.let_owned(mut g, name, codegen.V { ..v, ty: t })\n  }\n  match (ty, codegen.lookup(g, name)) {\n    (Some(x), Some(l)) => if codegen.needs_check(g, x) {\n      mut g.declared.insert(l.slot, x)\n    },\n    _ => (),\n  }\n}"},{"name":"codegen.no_shape","kind":"fn","old":"b186b53ae9661114","new":"2064fc4949c79b4e","interface_changed":true,"affected":["codegen.lower","codegen.fields_of","codegen.debug_body","codegen.new_gen","codegen.read_ctor","codegen.whole_sums","codegen.entry","codegen.function","codegen.declare","codegen.destructure","codegen.scheme","codegen.method_call","codegen.vtable","codegen.dyn_call","codegen.add_type","codegen.generic_ty","codegen.main_arg","codegen.foreign_call","codegen.generated","codegen.gen_fn","codegen.gen_list","codegen.gen_data","codegen.mock_method","codegen.fuzz_driver","codegen.check_payload","codegen.check_union",