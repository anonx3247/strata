mut g: codegen.Gen, m: check.Ty) -> Int {\n  k := codegen.key(m)\n  match get(g.box_tags, k) {\n    Some(t) => t,\n    None => {\n      // above every constructor tag, and the same in every program\n      t := 1099511627776 + codegen.hash40(k)\n      if g.owner == \"\" {\n        mut g.box_tags.insert(k, t)\n      }\n      t\n    },\n  }\n}","old_text":"fn box_tag(mut g: codegen.Gen, m: Ty) -> Int {\n  k := codegen.key(m)\n  match get(g.box_tags, k) {\n    Some(t) => t,\n    None => {\n      // above every constructor tag, and the same in every program\n      t := 1099511627776 + codegen.hash40(k)\n      if g.owner == \"\" {\n        mut g.box_tags.insert(k, t)\n      }\n      t\n    },\n  }\n}"},{"name":"codegen.member_tags","kind":"fn","old":"55d88cfa88d796d7","new":"4f30c8658a919296","interface_changed":true,"affected":["codegen.holds_member","codegen.read_slot","codegen.matches","codegen.on_members","codegen.union_eq","codegen.check_union","codegen.expr_node","codegen.read_back","codegen.read_all","codegen.read_ctor","codegen.destructure","codegen.binds","codegen.for_loop","codegen.matching_v","codegen.match_got","codegen.union_text","codegen.union_cmp","codegen.union_drop","codegen.union_call","codegen.union_field","codegen.union_set","codegen.copy_fn","codegen.share_fn","codegen.helper","codegen.check_type","codegen.expr","computed_value","repl_eval","codegen.stmt_node","codegen.matching_want","codegen.cmp_helper","codegen.drop_value","codegen.tail_drop","codegen.method_call","codegen.get_field","codegen.set_path","codegen.copy_out","codegen.share_value","codegen.tail_share","codegen.show","codegen.shown","codegen.equal","codegen.function","codegen.declare","codegen.call_fn_want","codegen.check_payload","codegen.construct_want","codegen.check_field","codegen.assign_at","codegen.lambda_shown","codegen.set_in_place","codegen.checked_update","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.loop_body","codegen.except_expr","codegen.c