{"id":"ea3339e0eaafb915","time":1795635727,"message":"Rename parallel.taken to map_worker","changes":[{"name":"parallel.map","kind":"fn","old":"443ffbf513f76a73","new":"05e9f4174f2c8596","interface_changed":false,"affected":[],"module":"parallel","text":"/// The same list as `xs.map(f)`, computed on `workers()` threads. Each\n/// worker takes the next index from a shared counter, so a slow element\n/// doesn't hold up the ones after it.\n/// \n/// Objects made before the workers start are pinned while they run\n/// (`driver_keep_shared`). Objects the workers make are counted as usual.\n/// `f` may only read shared data: no timings, no files.\npub fn map[T, R](xs: List[T], f: (T) -> R) -> List[R] {\n  n := min(parallel.workers(), len(xs))\n  if n <= 1 {\n    return xs.map(f)\n  }\n  match parallel.driver_keep_shared(1).to_int() {\n    _ => (),\n  }\n  c := parallel.work_counter()\n  parts := scope {\n    mut hs := []\n    for _ in 0..n {\n      mut hs.push(spawn parallel.map_worker(xs, f, c))\n    }\n    await hs\n  }\n  match parallel.driver_keep_shared(0).to_int() {\n    _ => (),\n  }\n  mut at := Dict[Int, R] {}\n  for part in parts {\n    for (i, r) in part {\n      mut at.insert(i, r)\n    }\n  }\n  mut out := []\n  for i in 0..len(xs) {\n    match get(at, i) {\n      Some(r) => mut out.push(r),\n      None => (),\n    }\n  }\n  out\n}","old_text":"/// The same list as `xs.map(f)`, computed on `workers()` threads. Each\n/// worker takes the next index from a shared counter, so a slow element\n/// doesn't hold up the ones after it.\n/// \n/// Objects made before the workers start are pinned while they run\n/// (`driver_keep_shared`). Objects the workers make are counted as usual.\n/// `f` may only read shared data: no timings, no files.\npub fn map[T, R](xs: List[T], f: (T) -> R) -> List[R] {\n  n := min(parallel.workers(), len(xs))\n  if n <= 1 {\n    return xs.map(f)\n  }\n  match parallel.driver_keep_shared(1).to_int() {\n    _ => (),\n  }\n  c := parallel.work_counter()\n  parts := scope {\n    mut hs := []\n    for _ in 0..n {\n      mut hs.push(spawn parallel.taken(xs, f, c))\n    }\n    await hs\n  }\n  match parallel.driver_keep_shared(0).to_int() {\n    _ => (),\n  }\n  mut at := Dict[Int, R] {}\n  for part in parts {\n    for (i, r) in part {\n      mut at.insert(i, r)\n    }\n  }\n  mut out := []\n  for i in 0..len(xs) {\n    match get(at, i) {\n      Some(r) => mut out.push(r),\n      None => (),\n    }\n  }\n  out\n}"},{"name":"parallel.map_worker","kind":"fn","old":null,"new":"63f4ef2130433360","interface_changed":true,"affected":[],"module":"parallel","text":"/// One worker of `map`: takes indices from `c` until past the end, and\n/// returns each result with its index.\nfn map_worker[T, R](xs: List[T], f: (T) -> R, c: I64) -> List[(Int, R)] {\n  mut out := []\n  while true {\n    i := parallel.work_take(c).to_int()\n    match get(xs, i) {\n      Some(x) => mut out.push((i, f(x))),\n      None => return out,\n    }\n  }\n  out\n}"},{"name":"parallel.taken","kind":"fn","old":"0bb92c4b4d19f3ec","new":null,"interface_changed":true,"affected":[],"module":"parallel","old_text":"/// One worker of `map`: takes indices from `c` until past the end, and\n/// returns each result with its index.\nfn taken[T, R](xs: List[T], f: (T) -> R, c: I64) -> List[(Int, R)] {\n  mut out := []\n  while true {\n    i := parallel.work_take(c).to_int()\n    match get(xs, i) {\n      Some(x) => mut out.push((i, f(x))),\n      None => return out,\n    }\n  }\n  out\n}"}],"renames":[{"from":"parallel.taken","to":"parallel.map_worker","kind":"function"}],"references":["parallel.map"]}
