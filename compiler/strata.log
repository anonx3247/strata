 )\n    }\n  }\n  timings.end(\"codegen: functions\")\n  if len(g.errs) > 0 {\n    // std's library leaves out the functions that reach something not\n    // compiled\n    if library != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      out := wanted.filter(k -> contains(left, k))\n      if out != [] {\n        return Err(out.map(k -> \"leave out: \" + k))\n      }\n    }\n    // verify's fuzz drivers: each one reaching something not compiled is\n    // reported as `can't fuzz `KEY`: WHY`, so `verify` drops them all at\n    // once\n    if fuzz != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      callees := codegen.callees_of(g.callers)\n      return Err(g.errs\n        + fuzz\n          .filter(k -> contains(left, \"fuzz:\" + k))\n          .map(k -> \"can't fuzz `\"\n            + k\n            + \"`: \"\n            + join(\n              codegen.failures_of(callees, g.why, \"fuzz:\" + k),\n              \"; \",\n            )))\n    }\n    return Err(g.errs)\n  }\n  mut out := [\n    \"; Strata, compiled by compiler/codegen\",\n    f\"; checks left out {g.left_out}, kept {g.kept}\",\n    \"\",\n  ]\n  // std's library lists the functions it holds: `; precompiled NAME`\n  out += held.map(k -> \"; precompiled \" + k)\n  out += parts.map(p -> codegen.file_line(p.0, p.1))\n  // the symbols a library exports (`; export add`); the rest are hidden\n  out += if fuzz == [] && library == [] && calls == [] && tests is None {\n    codegen.exports_of(given).map(e -> \"; export \" + e.0)\n  } else {\n    []\n  }\n  out += g.globals\n  mut out.push(\"\")\n  // std's library exposes only its functions\n  out += if library != [] {\n    codegen.internal(bodies + g.helper_defs, set(roots))\n  } else {\n    bodies + g.helper_defs\n  }\n  for d in codegen.declarations() {\n    if contains(g.used, d.0) {\n      mut out.push(d.1)\n    }\n  }\n  ir_text := join(out, \"\\n\") + \"\\n\"\n  Ok(if g.memory_sites {\n    codegen.counted_sites(ir_text)\n  } else {\n    ir_text\n  })\n}"}]}
{"id":"ec888429276d4a1e","time":1795830261,"message":"edit","changes":[{"name":"unique.scalar_type","kind":"fn","old":"8c6b3aff02a42609","new":"acee552ad0eb23d5","interface_changed":false,"affected":[],"module":"unique","text":"/// Whether `t` is a number or `Bool` type (refined or not, or one of the\n/// integer types core refines).\nfn scalar_type(t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Named { name, args: [] } => [\n      \"Int\",\n      \"Bool\",\n      \"Float\",\n      \"I8\",\n      \"I16\",\n      \"I32\",\n      \"I64\",\n      \"U8\",\n      \"U16\",\n      \"U32\",\n      \"U64\",\n      \"Natural\",\n      \"Positive\",\n      \"Negative\",\n      \"NonZero\",\n    ].contains(\n      name,\n    ),\n    ast.Refined { base, .. } => unique.scalar_type(base),\n    _ => false,\n  }\n}","old_text":"/// Whether `t` is a number or `Bool` type (refined or not).\nfn scalar_type(t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Named { name, args: [] } => [\n      \"Int\",\n      \"Bool\",\n      \"Float\",\n      \"I8\",\n      \"I16\",\n      \"I32\",\n      \"I64\",\n      \"U8\",\n      \"U16\",\n      \"U32\",\n      \"U64\",\n    ].contains(\n      name,\n    ),\n    ast.Refined { base, .. } => unique.scalar_type(base),\n    _ => false,\n  }\n}"}]}
{"id":"b3c30be28b923d3b","time":1795828966,"message":"edit","changes":[{"name":"new_command","kind":"fn","old":"ab223c4aeb5ab8b8","new":"840b5b21430f8443","interface_changed":false,"affected":[],"module":"","text":"/// `strata new MODULE [-m MSG] [--no-commit]`: the definitions piped in, as\n/// a new module of the package or added to MODULE, through `apply_edit`.\n/// A definition MODULE already has is refused, and so is `--file`.\nfn new_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  args: List[String],\n) -> std.process.ExitCode {\n  if contains(args, \"--help\") || contains(args, \"-h\") {\n    mut console.write(command_usage(\"new\"))\n    return 0\n  }\n  if contains(args, \"--file\") {\n    return fail_with(\n      mut console,\n      \"`new` adds to a module of a package: with `--file`, `strata --file F edit MODULE` makes one\",\n    )\n  }\n  a := new.new_args(args) except e { return fail_with(mut console, e) }\n  m := edit_module(a.module)\n  if m != \"\" && !new.is_module_name(m) {\n    return fail_with(\n      mut console,\n      f\"`{a.module}` is not a module name: lowercase words joined by `.` (`shop.orders`)\",\n    )\n  }\n  o := open_package(disk, process, \"new\") except {\n    return fail_with(\n      mut console,\n      \"no package here (no strata.toml in this folder or above: run `strata init`)\",\n    )\n  }\n  module := package_module(o.name, m)\n  file := new.file_of(o.root, module)\n  stored := o.decls.filter(d -> d.module == module)\n  if stored == [] && disk.exists(file) {\n    match disk.read_bytes(file) {\n      Ok(bytes) => match binary.read(bytes) {\n        Ok(_) => (),\n        Err(_) => return fail_with(\n          mut console,\n          new.unreadable(a.module, codebase.module_path(module)),\n        ),\n      },\n      Err(_) => return fail_with(\n        mut console,\n        new.unreadable(a.module, codebase.module_path(module)),\n      ),\n    }\n  }\n  defs := if console.interactive() || driver_stdin_idle().to_int() == 1 {\n    \"\"\n  } else {\n    mut console.read_all()\n  }\n  if trim(defs) == \"\" {\n    return fail_with(mut console, new.no_definitions(a.module))\n  }\n  edits := parse.parse_module(defs, module) except e {\n    return fail_with(mut console, f\"parse error at {e}\")\n  }\n  named := edits.filter(d -> !(d.kind is ast.UseDef))\n  taken := new.taken(\n    stored.map(d -> store.qname(d)),\n    named.map(d -> store.qname(d)),\n  )\n  if taken != [] {\n    return fail_with(mut console, new.taken_error(a.module, taken))\n  }\n  match apply_edit(\n    mut console,\n    mut disk,\n    mut launcher,\n    process,\n    clock,\n    cache,\n    o,\n    edits,\n    [],\n    a.message,\n    a.commit,\n    \"new\",\n    contains(args, \"--json\"),\n    [],\n    true,\n    false,\n  ) {\n    Ok(_) => 0,\n    Err(_) => 1,\n  }\n}","old_text":"/// `strata new MODULE \"DOC\" [-m MSG] [--no-commit]`: a module of the\n/// package, made from the definitions piped in with DOC as its doc,\n/// through `apply_edit`. A module that has definitions or a file is\n/// refused, and so is `--file`.\nfn new_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  args: List[String],\n) -> std.process.ExitCode {\n  if contains(args, \"--help\") || contains(args, \"-h\") {\n    mut console.write(command_usage(\"new\"))\n    return 0\n  }\n  if contains(args, \"--file\") {\n    return fail_with(\n      mut console,\n      \"`new` makes a module of a package: with `--file`, `strata --file F edit MODULE` makes one\",\n    )\n  }\n  a := new.new_args(args) except e { return fail_with(mut console, e) }\n  m := edit_module(a.module)\n  if m != \"\" && !new.is_module_name(m) {\n    return fail_with(\n      mut console,\n      f\"`{a.module}` is not a module name: lowercase words joined by `.` (`shop.orders`)\",\n    )\n  }\n  o := open_package(disk, process, \"new\") except {\n    return fail_with(\n      mut console,\n      \"no package here (no strata.toml in this folder or above: run `strata init`)\",\n    )\n  }\n  module := package_module(o.name, m)\n  file := new.file_of(o.root, module)\n  match new.refusal(\n    a.module,\n    codebase.module_path(module),\n    o.decls.any(d -> d.module == module),\n    disk.exists(file),\n  ) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  defs := if console.interactive() || driver_stdin_idle().to_int() == 1 {\n    \"\"\n  } else {\n    mut console.read_all()\n  }\n  if trim(defs) == \"\" {\n    return fail_with(mut console, new.no_definitions(a.module))\n  }\n  edits := parse.parse_module(new.module_text(a.doc, defs), module) except e {\n    return fail_with(mut console, f\"parse error at {e}\")\n  }\n  match apply_edit(\n    mut console,\n    mut disk,\n    mut launcher,\n    process,\n    clock,\n    cache,\n    o,\n    edits,\n    [],\n    a.message,\n    a.commit,\n    \"new\",\n    contains(args, \"--json\"),\n    [],\n    true,\n    false,\n  ) {\n    Ok(_) => 0,\n    Err(_) => 1,\n  }\n}"},{"name":"new.use codebase","kind":"use","old":"0a2fbb0b4bcca671","new":"324a47111a61d969","interface_changed":false,"affected":[],"module":"new","text":"// `strata new MODULE`: definitions piped in, made into a new module or\n// added to one, stored as `edit` stores them; a name already defined there\n// is refused.\n\nfrom codebase use module_path","old_text":"// `strata new MODULE \"DOC\"`: a module made with its doc line and the\n// definitions piped in, stored as `edit` stores them.\n\nfrom codebase use module_path"},{"name":"new.NewArgs","kind":"type","old":"b5eb8bf474fa5483","new":"8d49897028ce9286","interface_changed":true,"affected":["new.new_args","new_command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","std_library","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","build_core_command","comptime_value","repl_command","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","literal_errors_of","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","strata_command","comptime_values","graph_command","graph_diff","loaded_check","file_errors","edit_file","edit_errors","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","with_base","package_errors","edit_in_editor","fix_command","rename_command","move_command"],"module":"new","text":"/// `strata new`'s command line: the module as given, the commit message and\n/// whether to commit.\npub type NewArgs = { module: String, message: String, commit: Bool }","old_text":"/// `strata new`'s command line: the module as given, its doc line, the\n/// commit message and whether to commit.\npub type NewArgs = { module: String, doc: String, message: String, commit: Bool }"},{"name":"new.new_args","kind":"fn","old":"dc7dbf6d8522a9fb","new":"f86b94f82352446d","interface_changed":false,"affected":[],"module":"new","text":"/// Reads `MODULE [-m MSG] [--no-commit] [--json]` (`--json` is the\n/// command's to read).\npub fn new_args(args: List[String]) -> Result[new.NewArgs, String] {\n  mut words := []\n  mut message := None\n  mut commit := true\n  mut i := 0\n  while i < len(args) {\n    a := get(args, i) ?? \"\"\n    i += 1\n    if a == \"-m\" {\n      v := get(args, i) or { return Err(\"`-m` needs a value\") }\n      i += 1\n      message = Some(v)\n    } else if a == \"--no-commit\" {\n      commit = false\n    } else if a == \"--json\" {\n      ()\n    } else if starts_with(a, \"-\") {\n      return Err(f\"unknown option `{a}`\")\n    } else {\n      mut words.push(a)\n    }\n  }\n  match words {\n    [] => Err(\"`strata new MODULE < defs.st`: name the module\"),\n    [m] => Ok(new.NewArgs {\n      module: m,\n      message: message ?? f\"new {m}\",\n      commit,\n    }),\n    [_, extra, ..] => Err(\n      f\"unexpected argument `{extra}`: docs are the `///` and `//` lines of the code piped in\",\n    ),\n  }\n}","old_text":"/// Reads `MODULE \"DOC\" [-m MSG] [--no-commit] [--json]` (`--json` is the\n/// command's to read).\npub fn new_args(args: List[String]) -> Result[new.NewArgs, String] {\n  mut words := []\n  mut message := None\n  mut commit := true\n  mut i := 0\n  while i < len(args) {\n    a := get(args, i) ?? \"\"\n    i += 1\n    if a == \"-m\" {\n      v := get(args, i) or { return Err(\"`-m` needs a value\") }\n      i += 1\n      message = Some(v)\n    } else if a == \"--no-commit\" {\n      commit = false\n    } else if a == \"--json\" {\n      ()\n    } else if starts_with(a, \"-\") {\n      return Err(f\"unknown option `{a}`\")\n    } else {\n      mut words.push(a)\n    }\n  }\n  match words {\n    [] => Err(\"`strata new MODULE \\\"DOC\\\"`: name the module to make\"),\n    [m] => Err(new.no_doc(m)),\n    [m, doc] => {\n      d := trim(doc)\n      if d == \"\" {\n        Err(new.no_doc(m))\n      } else if contains(d, \"\\n\") {\n        Err(f\"the doc of `{m}` is one line\")\n      } else {\n        Ok(new.NewArgs {\n          module: m,\n          doc: d,\n          message: message ?? f\"new {m}\",\n          commit,\n        })\n      }\n    },\n    [_, _, extra, ..] => Err(f\"unexpected argument `{extra}`\"),\n  }\n}"},{"name":"new.no_definitions","kind":"fn","old":"c37ca083b2039dc6","new":"be069ab0b20a13cd","interface_changed":false,"affected":[],"module":"new","text":"/// The error for nothing piped in.\npub fn no_definitions(as_given: String) -> String {\n  f\"nothing to put in `{as_given}`: pipe its definitions in (`strata new {as_given} < defs.st`)\"\n}","old_text":"/// The error for nothing piped in.\npub fn no_definitions(as_given: String) -> String {\n  f\"nothing to put in `{as_given}`: pipe its definitions in (`strata new {as_given} \\\"DOC\\\" < defs.st`); a module's doc is kept on its first definition\"\n}"},{"name":"new.taken","kind":"fn","old":null,"new":"68587cbc9ec94ddb","interface_changed":true,"affected":[],"module":"new","text":"/// The names of `given` that `existing` has.\npub fn taken(existing: List[String], given: List[String]) -> List[String]\n  ensures it.all(n -> contains(existing, n) && contains(given, n)) {\n  given.filter(n -> contains(existing, n))\n}"},{"name":"new.taken_error","kind":"fn","old":null,"new":"2c34158ecd03eada","interface_changed":true,"affected":[],"module":"new","text":"/// The error for definitions sent that module `as_given` has.\npub fn taken_error(as_given: String, names: List[String]) -> String {\n  f\"`{as_given}` already has {join(names.map(n -> f\"`{n}`\"), \", \")}: `new` only adds definitions (change one with `strata edit {as_given}`)\"\n}"},{"name":"new.unreadable","kind":"fn","old":null,"new":"1c326deadf56b399","interface_changed":true,"affected":[],"module":"new","text":"/// The error for a file at the module's path that doesn't decode (`file`,\n/// from the package's folder): writing the module would replace it.\npub fn unreadable(as_given: String, file: String) -> String {\n  f\"`{as_given}`'s file {file} can't be read as a module: nothing written\"\n}"},{"name":"new.no_doc","kind":"fn","old":"31ac0ec4cf43e124","new":null,"interface_changed":true,"affected":["new.new_args","new_command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","std_library","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","build_core_command","comptime_value","repl_command","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","literal_errors_of","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","strata_command","comptime_values","graph_command","graph_diff","loaded_check","file_errors","edit_file","edit_errors","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","with_base","package_errors","edit_in_editor","fix_command","rename_command","move_command"],"module":"new","old_text":"fn no_doc(m: String) -> String {\n  f\"a new module needs its doc line, what it is for: `strata new {m} \\\"DOC\\\"`\"\n}"},{"name":"new.module_text","kind":"fn","old":"91393a149ae4e4b2","new":null,"interface_changed":true,"affected":["new_command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","std_library","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","build_core_command","comptime_value","repl_command","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","literal_errors_of","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","strata_command","comptime_values","graph_command","graph_diff","loaded_check","file_errors","edit_file","edit_errors","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","with_base","package_errors","edit_in_editor","fix_command","rename_command","move_command"],"module":"new","old_text":"/// The text the new module is stored from: the doc line as the comment\n/// that opens the module (its doc: docs/tools-reference.md), a blank line,\n/// then the definitions.\npub fn module_text(doc: String, defs: String) -> String\n  ensures starts_with(it, \"// \" + doc + \"\\n\\n\") {\n  \"// \" + doc + \"\\n\\n\" + defs\n}"},{"name":"new.refusal","kind":"fn","old":"9f029d375474a46b","new":null,"interface_changed":true,"affected":["new_command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","std_library","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","build_core_command","comptime_value","repl_command","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","literal_errors_of","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","strata_command","comptime_values","graph_command","graph_diff","loaded_check","file_errors","edit_file","edit_errors","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","with_base","package_errors","edit_in_editor","fix_command","rename_command","move_command"],"module":"new","old_text":"/// Why module `m` (`as_given` on the command line) can't be made, if it\n/// can't: the package has definitions in it, or a file at its path\n/// (`file`, from the package's folder).\npub fn refusal(\n  as_given: String,\n  file: String,\n  has_definitions: Bool,\n  file_exists: Bool,\n) -> Option[String]\n  ensures it is None == (!has_definitions && !file_exists) {\n  if has_definitions || file_exists {\n    Some(\n      f\"module `{as_given}` exists ({file}): change it with `strata edit {as_given}`\",\n    )\n  } else {\n    None\n  }\n}"}]}
{"id":"0a2fef5373262ed5","time":1795828981,"message":"edit","changes":[{"name":"driver.usage_text","kind":"fn","old":"0eb09afc6404a99a","new":"e7e6fb78cf462379","interface_changed":false,"affected":[],"module":"driver","text":"/// `strata help`: the commands and their options.\npub fn usage_text() -> String {\n  join(\n    [\n      \"strata — an experimental language for working with agents\",\n      \"\",\n      \"USAGE: strata [--file F.strata] [--no-pager] <command> [args]\",\n      \"\",\n      \"Code is stored as its syntax tree: a .strata file is a binary module file\",\n      \"(docs/binary-format.md). Text goes in only through an edit (`edit`, `add`), and\",\n      \"comes out through `view`.\",\n      \"\",\n      \"Codebase (the package around the current folder: its files, and strata.log, the log of\",\n      \"every change made through strata, committed with them):\",\n      \"  init                         make the current folder a package (a strata.toml named\",\n      \"                               after the folder)\",\n      \"  add <FILE> [MODULE] [-m MSG] import definitions from a file (checked, atomic): text, or\",\n      \"                               a .strata file or folder\",\n      \"  edit [MODULE] [-m MSG] [--rm NAME]..\",\n      \"                               read definitions from stdin; replace/add them by name (into\",\n      \"                               MODULE, default the root); commit only if the whole codebase\",\n      \"                               still checks; --rm takes a short name that names one\",\n      \"                               definition (in MODULE first; a test by its title)\",\n      \"                               (a rejected edit's text is kept in .strata/rejected/edit-N.st);\",\n      \"                               a changed function's loops whose derived invariants don't\",\n      \"                               prove its checks are searched, what is found written as\",\n      \"                               `invariant` clauses (a warning says so)\",\n      \"  edit [MODULE | SELECTOR]     at a terminal with nothing piped in (or --editor): open the\",\n      \"                               code in $VISUAL / $EDITOR (with no one at the terminal: an\",\n      \"                               error saying what to do) and apply what you save: the whole\",\n      \"                               package (one file per module), a module (`shop`, `main`, or\",\n      \"                               its file `shop/orders.strata`, new or not), or the\",\n      \"                               definitions a selector picks\",\n      \"  new <MODULE> [-m MSG]        the definitions on stdin, with their `///` docs, as a new\",\n      \"                               module at its path (`shop.orders`: shop/orders.strata) or\",\n      \"                               added to MODULE; checked and committed as `edit` is; a name\",\n      \"                               MODULE already has is refused (change it with `edit`)\",\n      \"  rename <old> <new> [<old> <new>]... [-m MSG]\",\n      \"                               rename functions, types, traits, variants, trait methods or\",\n      \"                               fields (`Owner.field`) and every reference, in one step\",\n      \"                               (`old` may be qualified, `new` is the short name)\",\n      \"  fix [NAME]... [-m MSG]       make the changes the warnings of `check` and `edit` suggest\",\n      \"                               (a contract that is a refinement, a refinement that is a\",\n      \"                               contract), to every definition or those named, in one step;\",\n      \"                               then the loops of those functions (NAME: also `module:m`,\",\n      \"                               `prefix*`): invariants searched for where those derived\",\n      \"                               from the code don't prove a check, and written\",\n      \"  move <name> <module>         move a function, type or trait to another module (its file),\",\n      \"                               updating references and imports (`main` is the root module)\",\n      \"  status                       the pending change, if any: its holes, filled or not\",\n      \"  done [--keep-holes] [-m MSG] record the pending change as one log entry\",\n      \"  (in a git repository each recorded change is also a git commit, unless the package says\",\n      \"   `auto_commit = false` or the command `--no-commit`)\",\n      \"  abort                        undo the pending change: every file as it was before it\",\n      \"  (an `edit` that breaks code elsewhere (a changed return type, parameter list or type)\",\n      \"   turns each broken use into a hole, ?pending_N, and opens a pending change; further\",\n      \"   edits, renames and moves join it; an edit that doesn't check in itself is rejected)\",\n      \"  log                          show the patch history\",\n      \"  diff [--from N] [--to N] [--step K] [--json] [--lines] [--nodes]\",\n      \"                               what changed, structurally: renames, new variants, stronger\",\n      \"                               contracts, the nodes changed in a body, each in its context\",\n      \"                               (--lines: the changed lines, the rest folded). In a codebase\",\n      \"                               the range is patches (default: all after the first import);\",\n      \"                               with --file, git: `diff [BASE]` compares BASE (default HEAD)\",\n      \"                               with the working tree, one step per commit\",\n      \"  history NAME [-n N] [--no-patch]\",\n      \"                               each change to the definition NAME, newest first: the\",\n      \"                               uncommitted one, then each commit that changed it (date,\",\n      \"                               author, subject) with its structural diff; --no-patch: a\",\n      \"                               line each. Follows a rename of its module's file\",\n      \"  revert NAME [COMMIT] [--force]\",\n      \"                               put NAME back as it was before COMMIT (default: its last\",\n      \"                               change) changed it, or remove it if COMMIT added it; only\",\n      \"                               NAME changes, in the working tree, not committed. Refused\",\n      \"                               while NAME has uncommitted changes, unless --force\",\n      \"  tour [FILE] [--check] [--lines]\",\n      \"                               a pull request's tour (.tours/BRANCH.md): its pages, each\",\n      \"                               with the diffs of the definitions it names (by nodes; by\",\n      \"                               lines with --lines), routine changes\",\n      \"                               folded, then what no page names; keys at a terminal, every\",\n      \"                               page printed otherwise. --check: exit 1 when a name isn't a\",\n      \"                               changed definition or a changed definition isn't named\",\n      \"  interface <module>           a module's public contract: what other modules can use\",\n      \"  pack <FILE.strata>           the whole program in one file (a bundle, with strata.toml);\",\n      \"                               --file, run and every view read it like a package;\",\n      \"                               --prelude: the prelude's definitions instead (for compiler/eval)\",\n      \"  header <FILE.strata>         a module file's table of contents: each definition's kind,\",\n      \"                               name, hashes, size and dependencies, read without decoding it;\",\n      \"                               --tree: each definition (a bundle's too) as a `compiler/ast` value, one per line\",\n      \"                               --text: the definitions as the printer writes them, as stored\",\n      \"  lex <FILE>                   a text file's tokens, one per line (then its comments), by\",\n      \"                               the lexer written in Strata (`compiler/lex`)\",\n      \"  parse <FILE>                 a text file parsed as a script: each definition as a `compiler/ast`\",\n      \"                               value, one per line, as parsed (not stored), by `compiler/parse`;\",\n      \"                               --stored: as stored (references qualified), by `compiler/resolve`\",\n      \"  (`--file` accepts a folder: each .strata file is a module named after its path.\",\n      \"   `--file F edit [MODULE]` and `--file F add TEXT` change F outside any log: a script,\",\n      \"   or a folder's module, created if new; checked, then written: what doesn't check\",\n      \"   writes nothing, with its errors, exit code 1 (--as-given: written all the same))\",\n      \"\",\n      \"Packages: a folder with a strata.toml (`name = \\\"...\\\"`, optional `exports = [...]`);\",\n      \"its .strata files are modules named after their path, main.strata is the entry point.\",\n      \"A .strata file outside every package is a script.\",\n      \"\",\n      \"Git:\",\n      \"  merge-file O A B [P]         git merge driver: merge each definition separately, then\",\n      \"                               type-check; writes the result to A; a conflict leaves A as\",\n      \"                               text with conflict markers\",\n      \"  resolve <FILE.strata>        a file a merge conflict left as text, fixed by hand: store\",\n      \"                               it as a module file again\",\n      \"  setup-git                    use merge-file for `git merge` / `git pull` in this clone,\",\n      \"                               and show .strata files as text in `git diff` and `git log -p`\",\n      \"  sync [BRANCH]                merge BRANCH (default main; origin's if there is a remote)\",\n      \"                               into this branch with the driver, then check; commits the\",\n      \"                               merge only if every package and script checks\",\n      \"  upgrade                      rewrite every package and script in the repository in the\",\n      \"                               current binary form (after a change to the format)\",\n      \"\",\n      \"Views:\",\n      \"  view MODULE                  a module as its file is stored, as text (what `edit` reads\",\n      \"                               back): `shop`, `main` (the root module), `shop/orders.strata`\",\n      \"  view [SELECTOR] [--level 0-2] [--mocks]\",\n      \"                               the definitions picked: 0 a map, one line each (the\",\n      \"                               default with no SELECTOR: the whole package), 1 their\",\n      \"                               interfaces (the default), 2 their source. SELECTOR: name |\",\n      \"                               prefix* | module:M | slice:Name | a,b (mocks only with\",\n      \"                               --mocks or by name). A name the program doesn't define:\",\n      \"                               core's builtins (`view Dict`, `view insert`: their docs and\",\n      \"                               costs) and std's (`view std.json.parse`), also outside a package\",\n      \"  view --split DIR [--members inline|separate]\",\n      \"                               every module as a text file (`shop/orders.st`, never read\",\n      \"                               back); --members: a union's members inline or on their own\",\n      \"  view LOCATION [--context N | --def]\",\n      \"                               a place in code (DEF@HASH/PATH, as find, refs and check\",\n      \"                               print it) shown as code, marked\",\n      \"  find NAME [--kind K] [--in SELECTOR] [--public] [--doc] [--limit N]\",\n      \"                               where NAME is defined: kind, qualified name, signature;\",\n      \"                               NAME: short, qualified, Type.member, glob (*x*), ~fuzzy;\",\n      \"                               none in the program: core's and std's\",\n      \"  refs NAME [--uses | --used-by] [--kind K] [--depth N] [--in SELECTOR] [--context N|all]\",\n      \"                               where NAME is used (each use's kind, shown as code in its\",\n      \"                               definition) and what it uses; --depth N: a tree (find,\",\n      \"                               refs: --list for locations, --json; exit 1: none found)\",\n      \"  (on a terminal, code is highlighted, and what is printed to read (view, find, refs, diff, log,\",\n      \"   holes, status, interface, help, doc) goes through a pager: $STRATA_PAGER, else $PAGER,\",\n      \"   else `less -FRX`; `--no-pager` or STRATA_PAGER=cat: none)\",\n      \"\",\n      \"Documentation:\",\n      \"  doc [TOPIC]                  documentation in the terminal: alone, the pages; a page of\",\n      \"                               the docs (`doc language`, `doc language#traits` for a\",\n      \"                               section), a module's reference (`doc std.json`) or a\",\n      \"                               definition's signature, contracts and doc (`doc Dict.insert`,\",\n      \"                               `doc parse`): pages first, then modules, then definitions\",\n      \"  docgen [MODULE].. [-o DIR] [--man]\",\n      \"                               the package's reference, from its `///` docs: a Markdown page\",\n      \"                               for each module with public definitions (its doc, then its\",\n      \"                               types, methods, traits and functions: signatures with their\",\n      \"                               contracts, and docs) and an index, DIR/README.md (default DIR:\",\n      \"                               doc); --man: man pages, DIR/man3/MODULE.3 (default DIR: man),\",\n      \"                               for std also this command's, DIR/man1/strata.1 (`man -M DIR\",\n      \"                               std.io`). MODULEs: only those\",\n      \"\",\n      \"Checking:\",\n      \"  check [--json]               types, exhaustiveness, literal refinements; warnings (`fix`)\",\n      \"  lint [--claims]              check's warnings (`fix`), without checking; --claims (off\",\n      \"                               by default): also each comment or doc line stating a fact\",\n      \"                               about the code, which belongs in a contract, invariant or law\",\n      \"  holes [--json]               typed holes with goal type, context and obligations\",\n      \"  verify [SELECTOR] [--cases N] [--checks] [--smt] [--obligations] [--require R,..] [--no-race] [--no-cache] [--json]\",\n      \"                               prove every contract with an SMT solver (z3), confirm\",\n      \"                               its counterexamples by running them, fuzz the rest.\",\n      \"                               A check's verdict is kept (in the git repository, shared\",\n      \"                               by its worktrees, else ~/.cache/strata/verdicts) under\",\n      \"                               a hash of its definition and all it depends on, the\",\n      \"                               flags and solver, across strata builds: only what\",\n      \"                               changed runs, the rest says (cached) (--no-cache:\",\n      \"                               run all again). --checks lists the\",\n      \"                               proven checks, --smt prints the solver queries,\",\n      \"                               --obligations each obligation with the solver's\",\n      \"                               answer (proven, refuted, unknown), nothing run.\",\n      \"                               Each function also says whether it terminates.\",\n      \"                               --require (proven, terminates, no-recursion) fails\",\n      \"                               the run when a checked function falls short (as do\",\n      \"                               strata.toml's [verify] rules). Proven functions that\",\n      \"                               terminate are still run on --cross-check N cases\",\n      \"                               (default 20, 0: off), to catch a wrong proof.\",\n      \"                               Loops get the invariants derived from their code and\",\n      \"                               those written (`invariant`); nothing is searched for: a\",\n      \"                               check failing in or after a loop says which loop and\",\n      \"                               variable, and that `strata fix NAME` searches.\",\n      \"                               The solver and the fuzzer race: the first to find a\",\n      \"                               failure stops the other (--no-race: the solver\",\n      \"                               first, then the fuzzer; every result the same from\",\n      \"                               run to run, and a failure of proven code is shown\",\n      \"                               as a bug in the prover).\",\n      \"                               Everything run is compiled (--jit: say why what\",\n      \"                               can't be compiled yet is skipped)\",\n      \"\",\n      \"Running:\",\n      \"  run [PATH] [-- ARGS..]\",\n      \"                               run the program, compiled by compiler/codegen: `main` gets the capabilities it asks for\",\n      \"                               (Console; Disk, Process from std; its own) and ARGS; it\",\n      \"                               returns (), an ExitCode, or a Result (Err: exit code 1).\",\n      \"                               PATH is a .strata file or a package folder (or --file).\",\n      \"                               It is compiled to machine code in memory (LLVM); what\",\n      \"                               can't be compiled yet is an error saying why.\",\n      \"                               --trace prints each call and return to stderr;\",\n      \"                               --copies reports each copy of a value made to change it\",\n      \"                               (where, how many, how big, why) when the program ends\",\n      \"                               (`test` and `build` take it too); --memory-sites counts\",\n      \"                               each count change, allocation and in-place test by its\",\n      \"                               place in the code and reports them when it ends (`build`\",\n      \"                               too; STRATA_MEMORY_SITES=FILE: every site to FILE);\",\n      \"                               the checks the last `verify` proved are left out\",\n      \"                               (--all-checks keeps them; `build` too); a program changed\",\n      \"                               since it was last verified starts at once with every check\",\n      \"                               while it is verified alongside, and the proven code is\",\n      \"                               swapped in while it runs (by default when stderr is a\",\n      \"                               terminal; --verify-alongside always, --no-verify never;\",\n      \"                               --wait-for-proofs verifies first, as `build` does);\",\n      \"                               --check-assumed checks the assumed contracts too\",\n      \"                               (`assumed requires/ensures/invariant`: proven by `verify`,\",\n      \"                               otherwise never checked when the program runs; `test` too)\",\n      \"  run <fn> [ARGS] [--trace]\",\n      \"                               call one function: ARGS are its arguments written as\",\n      \"                               code (`\\\"abc\\\", 3`, `Circle { radius: 2 }`), checked\",\n      \"                               against the types; the result is printed as code;\",\n      \"                               --trace prints each call and return\",\n      \"                               to stderr\",\n      \"  repl                         an interactive session on the package (or --file):\",\n      \"                               each line an expression, a binding (`x := e`,\",\n      \"                               `mut x := e`, `x = e`) or a definition (the session's,\",\n      \"                               not the package's); the value is printed as code with\",\n      \"                               its type; `console` is the REPL's own (what a line prints\",\n      \"                               is shown with its result), no other capability is given;\",\n      \"                               :type e, :view NAME, :reload, :quit; reads stdin piped\",\n      \"  test [FILTER] [--with-deps]\",\n      \"                               run the project's own test blocks, compiled (a test that\",\n      \"                               can't be compiled yet fails, saying why); --with-deps: also\",\n      \"                               those of what it imports (std, dependencies), which are\",\n      \"                               otherwise tested on their own. Compiled by compiler/codegen\",\n      \"                               (the code generator written in Strata)\",\n      \"  build-core [-o FILE]         compile core.rt (the runtime written in Strata) to LLVM IR for\",\n      \"                               the C runtime (`build` links it in place of the C runtime's versions)\",\n      \"  build [PATH] [-o OUT] [--lib] [--target wasm32] [--emit-llvm] [--all-checks] [--no-verify]\",\n      \"        [--release] [--copies] [--memory-sites]\",\n      \"                               compile the program to a native executable, through LLVM:\",\n      \"                               by compiler/codegen (the code generator written in Strata),\",\n      \"                               the compiler package itself included (needs clang; STRATA_CC\",\n      \"                               chooses another). --emit-llvm writes the LLVM IR instead\",\n      \"                               --lib: a shared library (libNAME.dylib) of what `derive C for f`\",\n      \"                               exports, and its C header (NAME.h)\",\n      \"                               --target wasm32: a WebAssembly module (NAME.wasm) of what\",\n      \"                               `derive TypeScript for f` exports, and its TypeScript loader\",\n      \"                               (NAME.ts); needs Homebrew's llvm, lld and binaryen\",\n      \"  builtins                    list built-in functions and their signatures\",\n      \"\",\n      \"Cache (what is compiled, proved and fetched is kept in $STRATA_CACHE, else ~/.cache/strata;\",\n      \" nothing is ever evicted on its own):\",\n      \"  cache                        where the cache is, and the size of each of its folders\",\n      \"                               (and of a release's shipped cache, read-only)\",\n      \"  cache clean [--obsolete] [--force]\",\n      \"                               delete the cache, saying how much that freed: what it held is\",\n      \"                               made again when needed (a git dependency fetched again). Never\",\n      \"                               a release's shipped cache or std library, nor the verdicts kept\",\n      \"                               in a git repository. Safe while no other strata runs: it\",\n      \"                               refuses when one has scratch in it (--force: clean anyway).\",\n      \"                               --obsolete: only the folders nothing reads any more (an older\",\n      \"                               compiler's) and the scratch of runs that ended\",\n      \"\",\n      \"Agents:\",\n      \"  skill                        print the skill that tells coding agents how to work on\",\n      \"                               Strata code (through these commands, never the files)\",\n      \"  skill install [--dir DIR]    write it as strata/SKILL.md where agents look for skills:\",\n      \"                               ~/.agents/skills (Codex, Pi, OpenCode), ~/.claude/skills,\",\n      \"                               ~/.codex/skills (those whose agent is installed), or DIR\",\n      \"  skill tour                   print the skill that tells agents how to write a tour\",\n      \"\",\n      \"With --file, commands operate on a file or folder instead of a codebase.\",\n    ],\n    \"\\n\",\n  )\n}","old_text":"/// `strata help`: the commands and their options.\npub fn usage_text() -> String {\n  join(\n    [\n      \"strata — an experimental language for working with agents\",\n      \"\",\n      \"USAGE: strata [--file F.strata] [--no-pager] <command> [args]\",\n      \"\",\n      \"Code is stored as its syntax tree: a .strata file is a binary module file\",\n      \"(docs/binary-format.md). Text goes in only through an edit (`edit`, `add`), and\",\n      \"comes out through `view`.\",\n      \"\",\n      \"Codebase (the package around the current folder: its files, and strata.log, the log of\",\n      \"every change made through strata, committed with them):\",\n      \"  init                         make the current folder a package (a strata.toml named\",\n      \"                               after the folder)\",\n      \"  add <FILE> [MODULE] [-m MSG] import definitions from a file (checked, atomic): text, or\",\n      \"                               a .strata file or folder\",\n      \"  edit [MODULE] [-m MSG] [--rm NAME]..\",\n      \"                               read definitions from stdin; replace/add them by name (into\",\n      \"                               MODULE, default the root); commit only if the whole codebase\",\n      \"                               still checks; --rm takes a short name that names one\",\n      \"                               definition (in MODULE first; a test by its title)\",\n      \"                               (a rejected edit's text is kept in .strata/rejected/edit-N.st);\",\n      \"                               a changed function's loops whose derived invariants don't\",\n      \"                               prove its checks are searched, what is found written as\",\n      \"                               `invariant` clauses (a warning says so)\",\n      \"  edit [MODULE | SELECTOR]     at a terminal with nothing piped in (or --editor): open the\",\n      \"                               code in $VISUAL / $EDITOR (with no one at the terminal: an\",\n      \"                               error saying what to do) and apply what you save: the whole\",\n      \"                               package (one file per module), a module (`shop`, `main`, or\",\n      \"                               its file `shop/orders.strata`, new or not), or the\",\n      \"                               definitions a selector picks\",\n      \"  new <MODULE> \\\"DOC\\\" [-m MSG]  a new module of the package from the definitions on stdin,\",\n      \"                               DOC its doc line (the comment that opens it), at its path\",\n      \"                               (`shop.orders`: shop/orders.strata); checked and committed\",\n      \"                               as `edit` is; refused when the module exists\",\n      \"  rename <old> <new> [<old> <new>]... [-m MSG]\",\n      \"                               rename functions, types, traits, variants, trait methods or\",\n      \"                               fields (`Owner.field`) and every reference, in one step\",\n      \"                               (`old` may be qualified, `new` is the short name)\",\n      \"  fix [NAME]... [-m MSG]       make the changes the warnings of `check` and `edit` suggest\",\n      \"                               (a contract that is a refinement, a refinement that is a\",\n      \"                               contract), to every definition or those named, in one step;\",\n      \"                               then the loops of those functions (NAME: also `module:m`,\",\n      \"                               `prefix*`): invariants searched for where those derived\",\n      \"                               from the code don't prove a check, and written\",\n      \"  move <name> <module>         move a function, type or trait to another module (its file),\",\n      \"                               updating references and imports (`main` is the root module)\",\n      \"  status                       the pending change, if any: its holes, filled or not\",\n      \"  done [--keep-holes] [-m MSG] record the pending change as one log entry\",\n      \"  (in a git repository each recorded change is also a git commit, unless the package says\",\n      \"   `auto_commit = false` or the command `--no-commit`)\",\n      \"  abort                        undo the pending change: every file as it was before it\",\n      \"  (an `edit` that breaks code elsewhere (a changed return type, parameter list or type)\",\n      \"   turns each broken use into a hole, ?pending_N, and opens a pending change; further\",\n      \"   edits, renames and moves join it; an edit that doesn't check in itself is rejected)\",\n      \"  log                          show the patch history\",\n      \"  diff [--from N] [--to N] [--step K] [--json] [--lines] [--nodes]\",\n      \"                               what changed, structurally: renames, new variants, stronger\",\n      \"                               contracts, the nodes changed in a body, each in its context\",\n      \"                               (--lines: the changed lines, the rest folded). In a codebase\",\n      \"                               the range is patches (default: all after the first import);\",\n      \"                               with --file, git: `diff [BASE]` compares BASE (default HEAD)\",\n      \"                               with the working tree, one step per commit\",\n      \"  history NAME [-n N] [--no-patch]\",\n      \"                               each change to the definition NAME, newest first: the\",\n      \"                               uncommitted one, then each commit that changed it (date,\",\n      \"                               author, subject) with its structural diff; --no-patch: a\",\n      \"                               line each. Follows a rename of its module's file\",\n      \"  revert NAME [COMMIT] [--force]\",\n      \"                               put NAME back as it was before COMMIT (default: its last\",\n      \"                               change) changed it, or remove it if COMMIT added it; only\",\n      \"                               NAME changes, in the working tree, not committed. Refused\",\n      \"                               while NAME has uncommitted changes, unless --force\",\n      \"  tour [FILE] [--check] [--lines]\",\n      \"                               a pull request's tour (.tours/BRANCH.md): its pages, each\",\n      \"                               with the diffs of the definitions it names (by nodes; by\",\n      \"                               lines with --lines), routine changes\",\n      \"                               folded, then what no page names; keys at a terminal, every\",\n      \"                               page printed otherwise. --check: exit 1 when a name isn't a\",\n      \"                               changed definition or a changed definition isn't named\",\n      \"  interface <module>           a module's public contract: what other modules can use\",\n      \"  pack <FILE.strata>           the whole program in one file (a bundle, with strata.toml);\",\n      \"                               --file, run and every view read it like a package;\",\n      \"                               --prelude: the prelude's definitions instead (for compiler/eval)\",\n      \"  header <FILE.strata>         a module file's table of contents: each definition's kind,\",\n      \"                               name, hashes, size and dependencies, read without decoding it;\",\n      \"                               --tree: each definition (a bundle's too) as a `compiler/ast` value, one per line\",\n      \"                               --text: the definitions as the printer writes them, as stored\",\n      \"  lex <FILE>                   a text file's tokens, one per line (then its comments), by\",\n      \"                               the lexer written in Strata (`compiler/lex`)\",\n      \"  parse <FILE>                 a text file parsed as a script: each definition as a `compiler/ast`\",\n      \"                               value, one per line, as parsed (not stored), by `compiler/parse`;\",\n      \"                               --stored: as stored (references qualified), by `compiler/resolve`\",\n      \"  (`--file` accepts a folder: each .strata file is a module named after its path.\",\n      \"   `--file F edit [MODULE]` and `--file F add TEXT` change F outside any log: a script,\",\n      \"   or a folder's module, created if new; checked, then written: what doesn't check\",\n      \"   writes nothing, with its errors, exit code 1 (--as-given: written all the same))\",\n      \"\",\n      \"Packages: a folder with a strata.toml (`name = \\\"...\\\"`, optional `exports = [...]`);\",\n      \"its .strata files are modules named after their path, main.strata is the entry point.\",\n      \"A .strata file outside every package is a script.\",\n      \"\",\n      \"Git:\",\n      \"  merge-file O A B [P]         git merge driver: merge each definition separately, then\",\n      \"                               type-check; writes the result to A; a conflict leaves A as\",\n      \"                               text with conflict markers\",\n      \"  resolve <FILE.strata>        a file a merge conflict left as text, fixed by hand: store\",\n      \"                               it as a module file again\",\n      \"  setup-git                    use merge-file for `git merge` / `git pull` in this clone,\",\n      \"                               and show .strata files as text in `git diff` and `git log -p`\",\n      \"  sync [BRANCH]                merge BRANCH (default main; origin's if there is a remote)\",\n      \"                               into this branch with the driver, then check; commits the\",\n      \"                               merge only if every package and script checks\",\n      \"  upgrade                      rewrite every package and script in the repository in the\",\n      \"                               current binary form (after a change to the format)\",\n      \"\",\n      \"Views:\",\n      \"  view MODULE                  a module as its file is stored, as text (what `edit` reads\",\n      \"                               back): `shop`, `main` (the root module), `shop/orders.strata`\",\n      \"  view [SELECTOR] [--level 0-2] [--mocks]\",\n      \"                               the definitions picked: 0 a map, one line each (the\",\n      \"                               default with no SELECTOR: the whole package), 1 their\",\n      \"                               interfaces (the default), 2 their source. SELECTOR: name |\",\n      \"                               prefix* | module:M | slice:Name | a,b (mocks only with\",\n      \"                               --mocks or by name). A name the program doesn't define:\",\n      \"                               core's builtins (`view Dict`, `view insert`: their docs and\",\n      \"                               costs) and std's (`view std.json.parse`), also outside a package\",\n      \"  view --split DIR [--members inline|separate]\",\n      \"                               every module as a text file (`shop/orders.st`, never read\",\n      \"                               back); --members: a union's members inline or on their own\",\n      \"  view LOCATION [--context N | --def]\",\n      \"                               a place in code (DEF@HASH/PATH, as find, refs and check\",\n      \"                               print it) shown as code, marked\",\n      \"  find NAME [--kind K] [--in SELECTOR] [--public] [--doc] [--limit N]\",\n      \"                               where NAME is defined: kind, qualified name, signature;\",\n      \"                               NAME: short, qualified, Type.member, glob (*x*), ~fuzzy;\",\n      \"                               none in the program: core's and std's\",\n      \"  refs NAME [--uses | --used-by] [--kind K] [--depth N] [--in SELECTOR] [--context N|all]\",\n      \"                               where NAME is used (each use's kind, shown as code in its\",\n      \"                               definition) and what it uses; --depth N: a tree (find,\",\n      \"                               refs: --list for locations, --json; exit 1: none found)\",\n      \"  (on a terminal, code is highlighted, and what is printed to read (view, find, refs, diff, log,\",\n      \"   holes, status, interface, help, doc) goes through a pager: $STRATA_PAGER, else $PAGER,\",\n      \"   else `less -FRX`; `--no-pager` or STRATA_PAGER=cat: none)\",\n      \"\",\n      \"Documentation:\",\n      \"  doc [TOPIC]                  documentation in the terminal: alone, the pages; a page of\",\n      \"                               the docs (`doc language`, `doc language#traits` for a\",\n      \"                               section), a module's reference (`doc std.json`) or a\",\n      \"                               definition's signature, contracts and doc (`doc Dict.insert`,\",\n      \"                               `doc parse`): pages first, then modules, then definitions\",\n      \"  docgen [MODULE].. [-o DIR] [--man]\",\n      \"                               the package's reference, from its `///` docs: a Markdown page\",\n      \"                               for each module with public definitions (its doc, then its\",\n      \"                               types, methods, traits and functions: signatures with their\",\n      \"                               contracts, and docs) and an index, DIR/README.md (default DIR:\",\n      \"                               doc); --man: man pages, DIR/man3/MODULE.3 (default DIR: man),\",\n      \"                               for std also this command's, DIR/man1/strata.1 (`man -M DIR\",\n      \"                               std.io`). MODULEs: only those\",\n      \"\",\n      \"Checking:\",\n      \"  check [--json]               types, exhaustiveness, literal refinements; warnings (`fix`)\",\n      \"  lint [--claims]              check's warnings (`fix`), without checking; --claims (off\",\n      \"                               by default): also each comment or doc line stating a fact\",\n      \"                               about the code, which belongs in a contract, invariant or law\",\n      \"  holes [--json]               typed holes with goal type, context and obligations\",\n      \"  verify [SELECTOR] [--cases N] [--checks] [--smt] [--obligations] [--require R,..] [--no-race] [--no-cache] [--json]\",\n      \"                               prove every contract with an SMT solver (z3), confirm\",\n      \"                               its counterexamples by running them, fuzz the rest.\",\n      \"                               A check's verdict is kept (in the git repository, shared\",\n      \"                               by its worktrees, else ~/.cache/strata/verdicts) under\",\n      \"                               a hash of its definition and all it depends on, the\",\n      \"                               flags and solver, across strata builds: only what\",\n      \"                               changed runs, the rest says (cached) (--no-cache:\",\n      \"                               run all again). --checks lists the\",\n      \"                               proven checks, --smt prints the solver queries,\",\n      \"                               --obligations each obligation with the solver's\",\n      \"                               answer (proven, refuted, unknown), nothing run.\",\n      \"                               Each function also says whether it terminates.\",\n      \"                               --require (proven, terminates, no-recursion) fails\",\n      \"                               the run when a checked function falls short (as do\",\n      \"                               strata.toml's [verify] rules). Proven functions that\",\n      \"                               terminate are still run on --cross-check N cases\",\n      \"                               (default 20, 0: off), to catch a wrong proof.\",\n      \"                               Loops get the invariants derived from their code and\",\n      \"                               those written (`invariant`); nothing is searched for: a\",\n      \"                               check failing in or after a loop says which loop and\",\n      \"                               variable, and that `strata fix NAME` searches.\",\n      \"                               The solver and the fuzzer race: the first to find a\",\n      \"                               failure stops the other (--no-race: the solver\",\n      \"                               first, then the fuzzer; every result the same from\",\n      \"                               run to run, and a failure of proven code is shown\",\n      \"                               as a bug in the prover).\",\n      \"                               Everything run is compiled (--jit: say why what\",\n      \"                               can't be compiled yet is skipped)\",\n      \"\",\n      \"Running:\",\n      \"  run [PATH] [-- ARGS..]\",\n      \"                               run the program, compiled by compiler/codegen: `main` gets the capabilities it asks for\",\n      \"                               (Console; Disk, Process from std; its own) and ARGS; it\",\n      \"                               returns (), an ExitCode, or a Result (Err: exit code 1).\",\n      \"                               PATH is a .strata file or a package folder (or --file).\",\n      \"                               It is compiled to machine code in memory (LLVM); what\",\n      \"                               can't be compiled yet is an error saying why.\",\n      \"                               --trace prints each call and return to stderr;\",\n      \"                               --copies reports each copy of a value made to change it\",\n      \"                               (where, how many, how big, why) when the program ends\",\n      \"                               (`test` and `build` take it too); --memory-sites counts\",\n      \"                               each count change, allocation and in-place test by its\",\n      \"                               place in the code and reports them when it ends (`build`\",\n      \"                               too; STRATA_MEMORY_SITES=FILE: every site to FILE);\",\n      \"                               the checks the last `verify` proved are left out\",\n      \"                               (--all-checks keeps them; `build` too); a program changed\",\n      \"                               since it was last verified starts at once with every check\",\n      \"                               while it is verified alongside, and the proven code is\",\n      \"                               swapped in while it runs (by default when stderr is a\",\n      \"                               terminal; --verify-alongside always, --no-verify never;\",\n      \"                               --wait-for-proofs verifies first, as `build` does);\",\n      \"                               --check-assumed checks the assumed contracts too\",\n      \"                               (`assumed requires/ensures/invariant`: proven by `verify`,\",\n      \"                               otherwise never checked when the program runs; `test` too)\",\n      \"  run <fn> [ARGS] [--trace]\",\n      \"                               call one function: ARGS are its arguments written as\",\n      \"                               code (`\\\"abc\\\", 3`, `Circle { radius: 2 }`), checked\",\n      \"                               against the types; the result is printed as code;\",\n      \"                               --trace prints each call and return\",\n      \"                               to stderr\",\n      \"  repl                         an interactive session on the package (or --file):\",\n      \"                               each line an expression, a binding (`x := e`,\",\n      \"                               `mut x := e`, `x = e`) or a definition (the session's,\",\n      \"                               not the package's); the value is printed as code with\",\n      \"                               its type; `console` is the REPL's own (what a line prints\",\n      \"                               is shown with its result), no other capability is given;\",\n      \"                               :type e, :view NAME, :reload, :quit; reads stdin piped\",\n      \"  test [FILTER] [--with-deps]\",\n      \"                               run the project's own test blocks, compiled (a test that\",\n      \"                               can't be compiled yet fails, saying why); --with-deps: also\",\n      \"                               those of what it imports (std, dependencies), which are\",\n      \"                               otherwise tested on their own. Compiled by compiler/codegen\",\n      \"                               (the code generator written in Strata)\",\n      \"  build-core [-o FILE]         compile core.rt (the runtime written in Strata) to LLVM IR for\",\n      \"                               the C runtime (`build` links it in place of the C runtime's versions)\",\n      \"  build [PATH] [-o OUT] [--lib] [--target wasm32] [--emit-llvm] [--all-checks] [--no-verify]\",\n      \"        [--release] [--copies] [--memory-sites]\",\n      \"                               compile the program to a native executable, through LLVM:\",\n      \"                               by compiler/codegen (the code generator written in Strata),\",\n      \"                               the compiler package itself included (needs clang; STRATA_CC\",\n      \"                               chooses another). --emit-llvm writes the LLVM IR instead\",\n      \"                               --lib: a shared library (libNAME.dylib) of what `derive C for f`\",\n      \"                               exports, and its C header (NAME.h)\",\n      \"                               --target wasm32: a WebAssembly module (NAME.wasm) of what\",\n      \"                               `derive TypeScript for f` exports, and its TypeScript loader\",\n      \"                               (NAME.ts); needs Homebrew's llvm, lld and binaryen\",\n      \"  builtins                    list built-in functions and their signatures\",\n      \"\",\n      \"Cache (what is compiled, proved and fetched is kept in $STRATA_CACHE, else ~/.cache/strata;\",\n      \" nothing is ever evicted on its own):\",\n      \"  cache                        where the cache is, and the size of each of its folders\",\n      \"                               (and of a release's shipped cache, read-only)\",\n      \"  cache clean [--obsolete] [--force]\",\n      \"                               delete the cache, saying how much that freed: what it held is\",\n      \"                               made again when needed (a git dependency fetched again). Never\",\n      \"                               a release's shipped cache or std library, nor the verdicts kept\",\n      \"                               in a git repository. Safe while no other strata runs: it\",\n      \"                               refuses when one has scratch in it (--force: clean anyway).\",\n      \"                               --obsolete: only the folders nothing reads any more (an older\",\n      \"                               compiler's) and the scratch of runs that ended\",\n      \"\",\n      \"Agents:\",\n      \"  skill                        print the skill that tells coding agents how to work on\",\n      \"                               Strata code (through these commands, never the files)\",\n      \"  skill install [--dir DIR]    write it as strata/SKILL.md where agents look for skills:\",\n      \"                               ~/.agents/skills (Codex, Pi, OpenCode), ~/.claude/skills,\",\n      \"                               ~/.codex/skills (those whose agent is installed), or DIR\",\n      \"  skill tour                   print the skill that tells agents how to write a tour\",\n      \"\",\n      \"With --file, commands operate on a file or folder instead of a codebase.\",\n    ],\n    \"\\n\",\n  )\n}"}]}
{"id":"0a13d10d628c5633","time":1795829096,"message":"edit","changes":[{"name":"new.taken","kind":"fn","old":"68587cbc9ec94ddb","new":"677e1a4ffc0cfa1c","interface_changed":true,"affected":["new_command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","std_library","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","build_core_command","comptime_value","repl_command","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","literal_errors_of","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","strata_command","comptime_values","graph_command","graph_diff","loaded_check","file_errors","edit_file","edit_errors","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","with_base","package_errors","edit_in_editor","fix_command","rename_command","move_command"],"module":"new","text":"/// The names of `given` that `existing` has.\npub fn taken(existing: List[String], given: List[String]) -> List[String]\n  ensures it.all(n -> contains(existing, n)) {\n  mut out := []\n  for n in given {\n    if contains(existing, n) {\n      mut out.push(n)\n    }\n  }\n  out\n}","old_text":"/// The names of `given` that `existing` has.\npub fn taken(existing: List[String], given: List[String]) -> List[String]\n  ensures it.all(n -> contains(existing, n) && contains(given, n)) {\n  given.filter(n -> contains(existing, n))\n}"}]}
{"id":"d43f22c9ef02598a","time":1795826601,"message":"edit","changes":[{"name":"verify_program","kind":"fn","old":"eb69e2eabd67e218","new":"e57180243b7154f6","interface_changed":false,"affected":[],"module":"","text":"/// The `verify` run of the program at `file` (a script, or a package's\n/// folder) with the settings `o`, as `verify_file` describes it: the\n/// program checked, the checks chosen, termination analysed, then each\n/// check's verdict (cached, proven, cross-checked, fuzzed), reported and\n/// cached, the rules applied, and the proofs recorded. With `o.finding`,\n/// only loops' invariants are searched for (exit 3: nothing written).\nfn verify_program(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  caches: cache.Cache,\n  solver: String,\n  cc: String,\n  o: VerifyOptions,\n  file: String,\n) -> std.process.ExitCode {\n  mut loaded := false\n  for lib in o.loads {\n    loaded = jit_load(lib).to_int() == 0\n  }\n  pre := if loaded && o.precompiled != \"\" {\n    [\"--precompiled\", o.precompiled]\n  } else {\n    []\n  }\n  // a script, or a package's folder: each module named by its path\n  sources := source_files(disk, file)\n  if sources == [] {\n    mut console.eprint(\"error: \" + file + \": no module file here\")\n    return 2\n  }\n  // the program must check first, as `strata check` checks it. Its compiles\n  // share the program, read and expanded once.\n  sh := with_base(disk, shared(disk, caches), [file])\n  core := sh.core\n  timings.begin(\"verify: check the program\")\n  errors := if o.finding != \"\" {\n    []\n  } else {\n    warned(mut console, file_errors(\n      mut launcher,\n      mut disk,\n      caches,\n      \"std\",\n      file,\n      false,\n      core,\n      sh,\n      pre,\n    ))\n  }\n  timings.end(\"verify: check the program\")\n  if errors != [] {\n    for e in errors {\n      mut console.eprint(error_text(e))\n    }\n    return 1\n  }\n  // the definitions chosen (every one without a selection), and the program\n  // as the verifier sees it\n  v := verify_inputs(disk, \"std\", file, sources, o.selection) except e {\n    mut console.eprint(\"error: \" + e)\n    return 2\n  }\n  raw := v.raw\n  std_files := deps.module_files(disk, \"std\").map(f -> \"std/\" + f)\n  holders := v.holders\n  wrappers := v.wrappers\n  (own, fns, types, sigs, all_methods) := (v.own, v.fns, v.types, v.sigs, v.all_methods)\n  // (the assumed contracts as verify writes them: each check of one is\n  // noted as such)\n  assumed_clauses := assumed_texts(own)\n  scratch := caches.smt\n  cache.make_dirs(mut disk, scratch)\n  // (a solver that can't be run: none, and everything is fuzzed)\n  // (loops' invariants searched for only when finding them: `verify`\n  // and `build` use those derived from the code and those written)\n  ctx := {\n    c := termination.context(\n      fns,\n      types,\n      sigs,\n      all_methods,\n      scratch,\n      if toolchain.has_solver(mut launcher, solver) {\n        solver\n      } else {\n        \"\"\n      },\n    )\n    termination.Ctx {\n      ..c,\n      methods: smt.Methods { ..c.methods, search: if o.finding != \"\" {\n        2\n      } else {\n        0\n      } },\n    }\n  }\n  impl_names := v.impl_names\n  // each check's definition, by its name as a selection names it\n  def_name := (def: String) -> selected_name(impl_names, def)\n  targets := chosen_checks(ctx, v)\n  // termination is analysed for what the chosen checks reach\n  roots := check_roots(targets)\n  // (each function's loops as earlier runs found them, for its code as the\n  // encoder sees it: `loops_file`)\n  timings.begin(\"verify: cache keys\")\n  own_paths := set(sources.map(s -> s.0))\n  // (the prelude too: it is compiled into every driver)\n  others := std_fingerprint(\n    disk,\n    (core_files() + [\"runtime/prelude.strata\"] + std_files).filter(\n      f -> !contains(own_paths, f),\n    ),\n  )\n  target_defs := set(targets.map(t -> t.def))\n  loop_keys := interface_keys(disk, sources, ctx.methods, target_defs, true)\n  // (the solver by its path and version: a verdict where it gave up is kept\n  // too, since it gives that answer again)\n  solver_id := solver + \" (\" + solver_version(solver) + \")\"\n  loop_settings := \"loops derived solver \"\n    + solver_id\n    + \" std \"\n    + others\n    + \" impls \"\n    + impls_fingerprint(disk, sources)\n    + \" package \"\n    + package_settings(disk, file)\n  // (std's and core's own definitions: keyed by their names and std's code\n  // as a whole, `others`, so what std's loops and recursion take is found\n  // once and shipped with std)\n  library := library_names(\n    disk,\n    (core_files() + std_files).filter(f -> !contains(own_paths, f)),\n  )\n  loop_key := (n: String) -> match get(loop_keys, \"fn:\" + n) {\n    Some(k) => Some(loop_settings + \"\\n\" + n + \"\\n\" + k),\n    None => if contains(library, n) {\n      Some(loop_settings + \"\\n\" + n + \"\\nlibrary\")\n    } else {\n      None\n    },\n  }\n  reuse := !o.no_cache\n    && o.finding == \"\"\n    && cache.caching()\n    && ctx.solver != \"\"\n  known := (n: String) -> if reuse {\n    match loop_key(n) {\n      Some(k) => match cache.read_entry(disk, caches, loops_file(k)) {\n        Some(text) => loops_of_text(text),\n        None => None,\n      },\n      None => None,\n    }\n  } else {\n    None\n  }\n  known_measure := (n: String) -> if reuse {\n    match loop_key(n) {\n      Some(k) => match cache.read_entry(disk, caches, measure_file(k)) {\n        Some(text) => Some(if text == \"none\" {\n          None\n        } else {\n          Some(text)\n        }),\n        None => None,\n      },\n      None => None,\n    }\n  } else {\n    None\n  }\n  timings.end(\"verify: cache keys\")\n  // (one budget for every loop-invariant search of the run: termination's\n  // and verification's)\n  smt.set_search_budget(o.budget)\n  timings.begin(\"verify: termination\")\n  (analysis, learned, measured) := termination.analyze_with(\n    mut launcher,\n    mut disk,\n    ctx,\n    Some(roots),\n    known,\n    known_measure,\n  )\n  timings.end(\"verify: termination\")\n  if !o.no_cache\n    && o.finding == \"\"\n    && ctx.solver != \"\"\n    && cache.caching() {\n    for (n, x) in items(learned) {\n      match loop_key(n) {\n        Some(k) => write_loops(mut disk, caches, k, x),\n        None => (),\n      }\n    }\n    for (n, m) in items(measured) {\n      match loop_key(n) {\n        Some(k) => match cache.write_entry(\n          mut disk,\n          caches,\n          measure_file(k),\n          m ?? \"none\",\n        ) {\n          _ => (),\n        },\n        None => (),\n      }\n    }\n  }\n  methods := smt.Methods {\n    ..termination.seen_through(ctx, analysis),\n    examples: true,\n  }\n  // finding loops' invariants (`strata edit`, `strata fix`): nothing else\n  if o.finding != \"\" {\n    if ctx.solver == \"\" {\n      return 0\n    }\n    wrote := find_invariants(\n      mut console,\n      mut launcher,\n      mut disk,\n      file,\n      raw,\n      sh.core,\n      ctx,\n      methods,\n      analysis,\n      targets,\n      o.finding,\n      o.budget,\n      o.show_searches,\n      o.logged,\n    )\n    // (exit 3: nothing written)\n    return if wrote {\n      0\n    } else {\n      3\n    }\n  }\n  // the verdicts of earlier runs with these settings, for the code as it\n  // is now (each check's definition with all it depends on)\n  timings.begin(\"verify: cache keys\")\n  closures := closure_keys_of(disk, sources, target_defs)\n  // (`--no-cache` checks again; the package's settings, which std's code\n  // reads)\n  settings := \"loops derived externs-not-run seed \"\n    + to_string(o.seed)\n    + \" solver \"\n    + solver_id\n    + \" std \"\n    + std_fingerprint(\n      disk,\n      core_files() + [\"runtime/prelude.strata\"] + std_files,\n    )\n    + \" package \"\n    + package_settings(disk, file)\n  cross_of := (t: Check) -> cross_runs(get(analysis.status, t.label), o.cross)\n  key_of := (t: Check) -> {\n    cc := cross_of(t)\n    settings\n      + \"\\n\"\n      + t.label\n      + \"\\n\"\n      + (get(closures, t.def) ?? \"?\")\n      + \":\"\n      + to_string(o.cases)\n      + \":\"\n      + to_string(cc)\n  }\n  mut kept := Dict[String, Verdict] {}\n  if !o.no_cache && cache.caching() {\n    for t in targets {\n      match read_verdict(disk, caches, verdict_file(key_of(t))) {\n        Some(v) => mut kept.insert(t.label, v),\n        None => (),\n      }\n    }\n  }\n  // the proofs of earlier runs, for the code as the prover sees it\n  // (`interface_keys`: the callees' contracts, and their bodies only when it\n  // sees through them), with these settings. std's code is keyed by its\n  // hash, the program's by these keys (std's when std is the program).\n  interfaces := interface_keys(disk, sources, methods, target_defs, false)\n  proof_settings := \"loops derived seed \"\n    + to_string(o.seed)\n    + \" solver \"\n    + solver_id\n    + \" std \"\n    + others\n    + \" package \"\n    + package_settings(disk, file)\n  proof_key_of := (t: Check) -> match get(interfaces, t.def) {\n    Some(k) => Some(proof_settings + \"\\n\" + t.label + \"\\n\" + k),\n    None => None,\n  }\n  mut proved := Dict[String, Verdict] {}\n  if !o.no_cache && cache.caching() && ctx.solver != \"\" {\n    for t in targets {\n      if !contains(kept, t.label) && t.assumed == \"\" && t.decl is Some {\n        match proof_key_of(t) {\n          Some(k) => match read_verdict(disk, caches, proof_file(k)) {\n            Some(VProven { checks, given }) => mut proved.insert(t.label, VProven { checks, given }),\n            _ => (),\n          },\n          None => (),\n        }\n      }\n    }\n  }\n  timings.end(\"verify: cache keys\")\n  // one driver per function and wrapper still to check\n  reach := timings.timed(\"verify: externs\", () -> extern_reach(ctx, holders))\n  (keys, outside, not_run) := drivers_planned(\n    ctx,\n    holders,\n    reach,\n    targets,\n    kept,\n    proved,\n    analysis.status,\n    o.cross,\n  )\n  if keys != [] && !ends_with(file, \".strata\") {\n    load_own_native(\n      mut console,\n      mut launcher,\n      mut disk,\n      caches,\n      cc,\n      file,\n    )\n  }\n  (h, why_compiled) := if keys == [] {\n    (-1, Dict[String, String] {})\n  } else {\n    timings.timed(\n      \"verify: compile drivers\",\n      () -> compiled_drivers(disk, sh, pre, file, keys, wrappers),\n    )\n  }\n  mut why := why_compiled\n  for (n, w) in items(outside) {\n    mut why.insert(n, w)\n  }\n  mut index := Dict[String, Int] {}\n  mut k := 0\n  for n in keys {\n    if !contains(why, n) {\n      mut index.insert(n, k)\n      k += 1\n    }\n  }\n  // the package's `[verify]` rules: each rule's modules\n  rules := verify_rules(disk, file)\n  mut violations := []\n  // (`--json`: each verdict)\n  mut entries := []\n  mut trusted := []\n  mut proofs := []\n  // each definition's worst verdict, for its status\n  mut worst := Dict[String, Verdict] {}\n  // what was checked in this run (not cached): proven, fuzzed, or with a\n  // counterexample\n  mut fresh := 0\n  mut fresh_proven := 0\n  mut fresh_fuzzed := 0\n  mut failed := []\n  mut ok := true\n  // the functions the solver checks, a chunk at a time: encoded and their\n  // obligations answered together, the solver runs in parallel\n  mut solved := Dict[String, (smt.Vc, List[smt.Answer])] {}\n  mut found: List[(Check, List[smt.LoopFound])] = []\n  for (ti, t) in enumerate(targets) {\n    if solver_asked(t)\n      && !contains(kept, t.label)\n      && !contains(proved, t.label)\n      && !contains(solved, t.label)\n      && ctx.solver != \"\" {\n      chunk := drop(targets, ti).filter(\n        x -> solver_asked(x)\n          && !contains(kept, x.label)\n          && !contains(proved, x.label),\n      )\n      timings.begin(\"verify: encode\")\n      solved = solved_together(\n        mut launcher,\n        mut disk,\n        ctx,\n        methods,\n        chunk[..min(len(chunk), solved_chunk())],\n      )\n      timings.end(\"verify: encode\")\n    }\n    label := t.label\n    // (what its loops' searches found; a verdict made with a search cut short\n    // by the budget isn't cached)\n    search_cut := match get(solved, label) {\n      Some((vc, _)) => {\n        if vc.found_loops != [] {\n          mut found.push((t, vc.found_loops))\n        }\n        vc.search_cut\n      },\n      None => false,\n    }\n    status := get(analysis.status, label)\n    // only code shown to terminate is cross-checked: running anything else\n    // may never end\n    cc := cross_runs(status, o.cross)\n    fz := (n: Int, b: Option[Int]) -> match get(index, t.key) {\n      Some(i) => timings.timed(if b is Some {\n        \"verify: cross-check\"\n      } else {\n        \"verify: fuzz\"\n      }, () -> {\n        t0 := timings.now()\n        r := fuzz_run(h, i, t.key, t.shown, n, o.seed, b)\n        if t0 != 0 {\n          // (by the name the encoder's timings use)\n          timed_name := match t.decl {\n            Some(f) => f.name,\n            None => t.label,\n          }\n          timings.since(timed_name, \"cross\", t0)\n          timings.add(timed_name, \"runs\", n)\n        }\n        r\n      }),\n      None => FuzzSkipped(get(why, t.key) ?? \"not compiled\"),\n    }\n    cached := contains(kept, label)\n    lawful := (x: Verdict) -> match t.law_of {\n      Some((lw, ty)) => law_verdict(x, lw, ty),\n      None => x,\n    }\n    timings.begin(\"verify: check a function\")\n    v := match get(kept, label) {\n      Some(x) => Some(x),\n      None => match get(proved, label) {\n        // proven before, with what it relies on unchanged: only the cross-check\n        // runs again, since callees' bodies may have changed\n        Some(p) => Some(lawful(cross_checked(p, cc, t.once, fz))),\n        None => if t.assumed != \"\" {\n          Some(VAssumed(t.assumed))\n        } else {\n          match t.decl {\n            Some(f) => match check_fn(\n              mut launcher,\n              mut disk,\n              ctx,\n              methods,\n              get(solved, label),\n              sh,\n              pre,\n              file,\n              wrappers,\n              holders,\n              get(not_run, t.key),\n              f,\n              t.key,\n              t.shown,\n              t.once,\n              o.cases,\n              cc,\n              o.seed,\n              fz,\n            ) {\n              Some(x0) => {\n                // a lemma not shown to end proves nothing: its recursion is\n                // its induction\n                x := match (t.decl, status) {\n                  (Some(f), Some(termination.Unknown(why))) => if f.lemma && x0 is VProven {\n                    VIncomplete(\n                      \"a lemma is proven only once it is shown to terminate (a recursive lemma is a proof by induction): \"\n                        + why,\n                    )\n                  } else {\n                    x0\n                  },\n                  _ => x0,\n                }\n                if x is VProven && !o.no_cache && !search_cut {\n                  match proof_key_of(t) {\n                    Some(k) => write_proof(mut disk, caches, k, x),\n                    None => (),\n                  }\n                }\n                Some(lawful(x))\n              },\n              None => None,\n            },\n            // a method only the trait defines: fuzzed\n            None => Some(fuzzed_with(fz(o.cases, None), 0, [])),\n          }\n        },\n      },\n    }\n    timings.end(\"verify: check a function\")\n    match v {\n      Some(found) => {\n        // (as reported: a function whose only unproven checks are of assumed\n        // contracts is assumed, trusted, cached, and listed in the proofs as found)\n        verdict := assumed_verdict(found, label, assumed_clauses)\n        // (a cached proof cross-checked again is reported as cached)\n        shown_cached := cached || contains(proved, label) && verdict is VProven\n        if !cached && !o.no_cache && !search_cut {\n          timings.begin(\"verify: cache keys\")\n          write_verdict(mut disk, caches, key_of(t), found)\n          timings.end(\"verify: cache keys\")\n        }\n        def := def_name(t.def)\n        mut worst.insert(\n          def,\n          match get(worst, def) {\n            Some(w) => if verdict_rank(verdict) > verdict_rank(w) {\n              verdict\n            } else {\n              w\n            },\n            None => verdict,\n          },\n        )\n        proofs += proof_lines(label, found).map(\n          l -> def + \"\\t\" + (get(closures, t.def) ?? \"?\") + \"\\t\" + l,\n        )\n        if verdict is VCounterexample {\n          ok = false\n        }\n        if !shown_cached {\n          fresh += 1\n          match verdict {\n            VProven { .. } => {\n              fresh_proven += 1\n            },\n            VFuzzed { .. } => {\n              fresh_fuzzed += 1\n            },\n            VCounterexample { .. } => mut failed.push(\"`\" + label + \"`\"),\n            _ => (),\n          }\n        }\n        if o.json {\n          mut entries.push(\n            verdict_json(label, verdict, status, shown_cached),\n          )\n        } else if !o.quiet {\n          for line in report(\n            label,\n            verdict,\n            status,\n            o.checks_shown,\n            shown_cached,\n            console.paint(std.term.Output),\n            assumed_clauses,\n          ) {\n            print(line)\n          }\n        }\n        if t.law_of == None {\n          (accepted, broken) := rules_broken(\n            o.require,\n            rules,\n            module_of_check(raw, def),\n            label,\n            found,\n            verdict,\n            status,\n            contains(analysis.recursive, label),\n          )\n          if accepted {\n            mut trusted.push(\"`\" + label + \"`\")\n          }\n          violations += broken\n        }\n      },\n      None => if !o.quiet && !o.json {\n        print(\n          \"? \" + pad(label, 24) + \" not covered by compiler/smt yet\",\n        )\n      },\n    }\n  }\n  // each definition's status (its worst verdict), for the code as it is\n  for (def, w) in items(worst) {\n    write_status(\n      mut disk,\n      caches,\n      def_key(closures, impl_names, def),\n      w,\n    )\n  }\n  // what `build` may leave out: each check proven, for the code as it is\n  record_proofs(\n    mut disk,\n    caches,\n    file,\n    o.proofs_at,\n    set(targets.map(t -> def_name(t.def))),\n    closures,\n    impl_names,\n    proofs,\n  )\n  // (`--show-searches`: what every loop's search took; `verify` searches\n  // none)\n  for l in search_notes(found, o.budget, o.show_searches) {\n    mut console.eprint(l)\n  }\n  // (the whole program verified as it is now: `run` has nothing to verify\n  // alongside it)\n  if o.selection == \"\" {\n    record_verified(mut disk, caches, file)\n  }\n  if o.json {\n    print(driver.pretty_json(driver.JList(entries)))\n  } else if o.quiet {\n    match changed_line(fresh, fresh_proven, fresh_fuzzed, failed) {\n      Some(line) => if !o.silent {\n        mut console.eprint(line)\n      },\n      None => (),\n    }\n  } else {\n    for line in policy_lines(trusted, violations) {\n      print(line)\n    }\n  }\n  if ok && violations == [] {\n    0\n  } else {\n    1\n  }\n}","old_text":"/// The `verify` run of the program at `file` (a script, or a package's\n/// folder) with the settings `o`, as `verify_file` describes it: the\n/// program checked, the checks chosen, termination analysed, then each\n/// check's verdict (cached, proven, cross-checked, fuzzed), reported and\n/// cached, the rules applied, and the proofs recorded. With `o.finding`,\n/// only loops' invariants are searched for (exit 3: nothing written).\nfn verify_program(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  caches: cache.Cache,\n  solver: String,\n  cc: String,\n  o: VerifyOptions,\n  file: String,\n) -> std.process.ExitCode {\n  mut loaded := false\n  for lib in o.loads {\n    loaded = jit_load(lib).to_int() == 0\n  }\n  pre := if loaded && o.precompiled != \"\" {\n    [\"--precompiled\", o.precompiled]\n  } else {\n    []\n  }\n  // a script, or a package's folder: each module named by its path\n  sources := source_files(disk, file)\n  if sources == [] {\n    mut console.eprint(\"error: \" + file + \": no module file here\")\n    return 2\n  }\n  // the program must check first, as `strata check` checks it. Its compiles\n  // share the program, read and expanded once.\n  sh := with_base(disk, shared(disk, caches), [file])\n  core := sh.core\n  timings.begin(\"verify: check the program\")\n  errors := if o.finding != \"\" {\n    []\n  } else {\n    warned(mut console, file_errors(\n      mut launcher,\n      mut disk,\n      caches,\n      \"std\",\n      file,\n      false,\n      core,\n      sh,\n      pre,\n    ))\n  }\n  timings.end(\"verify: check the program\")\n  if errors != [] {\n    for e in errors {\n      mut console.eprint(error_text(e))\n    }\n    return 1\n  }\n  // the traits, capabilities and mocks of the file, std and core\n  raw := own_decls(disk, sources)\n  // the definitions chosen (every one without a selection)\n  chosen := select_names(raw, o.selection) except e {\n    mut console.eprint(\"error: \" + e)\n    return 2\n  }\n  std_files := deps.module_files(disk, \"std\").map(f -> \"std/\" + f)\n  context_decls := module_decls(disk, core_files())\n    + std_reached(disk, \"std\", raw)\n    + raw\n  // (traits and impls with their models as methods, as checked)\n  declared := declared_of(desugar.with_models(context_decls, []))\n  caps := declared.caps\n  // the types holding a capability, each with the one it holds\n  holders := capability_holders(context_decls, caps)\n  wrappers := verify_wrappers(raw, declared.traits, declared.impls, caps)\n  (own, fns, types, sigs, all_methods) := verified_with(disk, [file], wrappers)\n  // (the assumed contracts as verify writes them: each check of one is\n  // noted as such)\n  assumed_clauses := assumed_texts(own)\n  scratch := caches.smt\n  cache.make_dirs(mut disk, scratch)\n  // (a solver that can't be run: none, and everything is fuzzed)\n  // (loops' invariants searched for only when finding them: `verify`\n  // and `build` use those derived from the code and those written)\n  ctx := {\n    c := termination.context(\n      fns,\n      types,\n      sigs,\n      all_methods,\n      scratch,\n      if toolchain.has_solver(mut launcher, solver) {\n        solver\n      } else {\n        \"\"\n      },\n    )\n    termination.Ctx {\n      ..c,\n      methods: smt.Methods { ..c.methods, search: if o.finding != \"\" {\n        2\n      } else {\n        0\n      } },\n    }\n  }\n  (derived, impl_names) := impls_named(raw)\n  // each check's definition, by its name as a selection names it\n  def_name := (def: String) -> selected_name(impl_names, def)\n  targets := checks_of(\n    ctx,\n    own,\n    declared.traits,\n    caps,\n    declared.mocked,\n    declared.trait_modules,\n    derived,\n  ).filter(\n    t -> contains(chosen, def_name(t.def))\n      || match t.decl {\n        Some(f) => contains(\n          chosen,\n          method_key(def_name(t.def), method_of(f.name)),\n        ),\n        None => false,\n      },\n  )\n  // termination is analysed for what the chosen checks reach\n  roots := check_roots(targets)\n  // (each function's loops as earlier runs found them, for its code as the\n  // encoder sees it: `loops_file`)\n  timings.begin(\"verify: cache keys\")\n  own_paths := set(sources.map(s -> s.0))\n  // (the prelude too: it is compiled into every driver)\n  others := std_fingerprint(\n    disk,\n    (core_files() + [\"runtime/prelude.strata\"] + std_files).filter(\n      f -> !contains(own_paths, f),\n    ),\n  )\n  target_defs := set(targets.map(t -> t.def))\n  loop_keys := interface_keys(disk, sources, ctx.methods, target_defs, true)\n  // (the solver by its path and version: a verdict where it gave up is kept\n  // too, since it gives that answer again)\n  solver_id := solver + \" (\" + solver_version(solver) + \")\"\n  loop_settings := \"loops derived solver \"\n    + solver_id\n    + \" std \"\n    + others\n    + \" impls \"\n    + impls_fingerprint(disk, sources)\n    + \" package \"\n    + package_settings(disk, file)\n  // (std's and core's own definitions: keyed by their names and std's code\n  // as a whole, `others`, so what std's loops and recursion take is found\n  // once and shipped with std)\n  library := library_names(\n    disk,\n    (core_files() + std_files).filter(f -> !contains(own_paths, f)),\n  )\n  loop_key := (n: String) -> match get(loop_keys, \"fn:\" + n) {\n    Some(k) => Some(loop_settings + \"\\n\" + n + \"\\n\" + k),\n    None => if contains(library, n) {\n      Some(loop_settings + \"\\n\" + n + \"\\nlibrary\")\n    } else {\n      None\n    },\n  }\n  reuse := !o.no_cache\n    && o.finding == \"\"\n    && cache.caching()\n    && ctx.solver != \"\"\n  known := (n: String) -> if reuse {\n    match loop_key(n) {\n      Some(k) => match cache.read_entry(disk, caches, loops_file(k)) {\n        Some(text) => loops_of_text(text),\n        None => None,\n      },\n      None => None,\n    }\n  } else {\n    None\n  }\n  known_measure := (n: String) -> if reuse {\n    match loop_key(n) {\n      Some(k) => match cache.read_entry(disk, caches, measure_file(k)) {\n        Some(text) => Some(if text == \"none\" {\n          None\n        } else {\n          Some(text)\n        }),\n        None => None,\n      },\n      None => None,\n    }\n  } else {\n    None\n  }\n  timings.end(\"verify: cache keys\")\n  // (one budget for every loop-invariant search of the run: termination's\n  // and verification's)\n  smt.set_search_budget(o.budget)\n  timings.begin(\"verify: termination\")\n  (analysis, learned, measured) := termination.analyze_with(\n    mut launcher,\n    mut disk,\n    ctx,\n    Some(roots),\n    known,\n    known_measure,\n  )\n  timings.end(\"verify: termination\")\n  if !o.no_cache\n    && o.finding == \"\"\n    && ctx.solver != \"\"\n    && cache.caching() {\n    for (n, x) in items(learned) {\n      match loop_key(n) {\n        Some(k) => write_loops(mut disk, caches, k, x),\n        None => (),\n      }\n    }\n    for (n, m) in items(measured) {\n      match loop_key(n) {\n        Some(k) => match cache.write_entry(\n          mut disk,\n          caches,\n          measure_file(k),\n          m ?? \"none\",\n        ) {\n          _ => (),\n        },\n        None => (),\n      }\n    }\n  }\n  methods := smt.Methods {\n    ..termination.seen_through(ctx, analysis),\n    examples: true,\n  }\n  // finding loops' invariants (`strata edit`, `strata fix`): nothing else\n  if o.finding != \"\" {\n    if ctx.solver == \"\" {\n      return 0\n    }\n    wrote := find_invariants(\n      mut console,\n      mut launcher,\n      mut disk,\n      file,\n      raw,\n      sh.core,\n      ctx,\n      methods,\n      analysis,\n      targets,\n      o.finding,\n      o.budget,\n      o.show_searches,\n      o.logged,\n    )\n    // (exit 3: nothing written)\n    return if wrote {\n      0\n    } else {\n      3\n    }\n  }\n  // the verdicts of earlier runs with these settings, for the code as it\n  // is now (each check's definition with all it depends on)\n  timings.begin(\"verify: cache keys\")\n  closures := closure_keys_of(disk, sources, target_defs)\n  // (`--no-cache` checks again; the package's settings, which std's code\n  // reads)\n  settings := \"loops derived externs-not-run seed \"\n    + to_string(o.seed)\n    + \" solver \"\n    + solver_id\n    + \" std \"\n    + std_fingerprint(\n      disk,\n      core_files() + [\"runtime/prelude.strata\"] + std_files,\n    )\n    + \" package \"\n    + package_settings(disk, file)\n  cross_of := (t: Check) -> cross_runs(get(analysis.status, t.label), o.cross)\n  key_of := (t: Check) -> {\n    cc := cross_of(t)\n    settings\n      + \"\\n\"\n      + t.label\n      + \"\\n\"\n      + (get(closures, t.def) ?? \"?\")\n      + \":\"\n      + to_string(o.cases)\n      + \":\"\n      + to_string(cc)\n  }\n  mut kept := Dict[String, Verdict] {}\n  if !o.no_cache && cache.caching() {\n    for t in targets {\n      match read_verdict(disk, caches, verdict_file(key_of(t))) {\n        Some(v) => mut kept.insert(t.label, v),\n        None => (),\n      }\n    }\n  }\n  // the proofs of earlier runs, for the code as the prover sees it\n  // (`interface_keys`: the callees' contracts, and their bodies only when it\n  // sees through them), with these settings. std's code is keyed by its\n  // hash, the program's by these keys (std's when std is the program).\n  interfaces := interface_keys(disk, sources, methods, target_defs, false)\n  proof_settings := \"loops derived seed \"\n    + to_string(o.seed)\n    + \" solver \"\n    + solver_id\n    + \" std \"\n    + others\n    + \" package \"\n    + package_settings(disk, file)\n  proof_key_of := (t: Check) -> match get(interfaces, t.def) {\n    Some(k) => Some(proof_settings + \"\\n\" + t.label + \"\\n\" + k),\n    None => None,\n  }\n  mut proved := Dict[String, Verdict] {}\n  if !o.no_cache && cache.caching() && ctx.solver != \"\" {\n    for t in targets {\n      if !contains(kept, t.label) && t.assumed == \"\" && t.decl is Some {\n        match proof_key_of(t) {\n          Some(k) => match read_verdict(disk, caches, proof_file(k)) {\n            Some(VProven { checks, given }) => mut proved.insert(t.label, VProven { checks, given }),\n            _ => (),\n          },\n          None => (),\n        }\n      }\n    }\n  }\n  timings.end(\"verify: cache keys\")\n  // one driver per function and wrapper still to check\n  reach := timings.timed(\"verify: externs\", () -> extern_reach(ctx, holders))\n  (keys, outside, not_run) := drivers_planned(\n    ctx,\n    holders,\n    reach,\n    targets,\n    kept,\n    proved,\n    analysis.status,\n    o.cross,\n  )\n  if keys != [] && !ends_with(file, \".strata\") {\n    load_own_native(\n      mut console,\n      mut launcher,\n      mut disk,\n      caches,\n      cc,\n      file,\n    )\n  }\n  (h, why_compiled) := if keys == [] {\n    (-1, Dict[String, String] {})\n  } else {\n    timings.timed(\n      \"verify: compile drivers\",\n      () -> compiled_drivers(disk, sh, pre, file, keys, wrappers),\n    )\n  }\n  mut why := why_compiled\n  for (n, w) in items(outside) {\n    mut why.insert(n, w)\n  }\n  mut index := Dict[String, Int] {}\n  mut k := 0\n  for n in keys {\n    if !contains(why, n) {\n      mut index.insert(n, k)\n      k += 1\n    }\n  }\n  // the package's `[verify]` rules: each rule's modules\n  rules := verify_rules(disk, file)\n  mut violations := []\n  // (`--json`: each verdict)\n  mut entries := []\n  mut trusted := []\n  mut proofs := []\n  // each definition's worst verdict, for its status\n  mut worst := Dict[String, Verdict] {}\n  // what was checked in this run (not cached): proven, fuzzed, or with a\n  // counterexample\n  mut fresh := 0\n  mut fresh_proven := 0\n  mut fresh_fuzzed := 0\n  mut failed := []\n  mut ok := true\n  // the functions the solver checks, a chunk at a time: encoded and their\n  // obligations answered together, the solver runs in parallel\n  mut solved := Dict[String, (smt.Vc, List[smt.Answer])] {}\n  mut found: List[(Check, List[smt.LoopFound])] = []\n  for (ti, t) in enumerate(targets) {\n    if t.assumed == \"\"\n      && !contains(kept, t.label)\n      && !contains(proved, t.label)\n      && !contains(solved, t.label)\n      && ctx.solver != \"\"\n      && solver_checks(t) {\n      chunk := drop(targets, ti).filter(\n        x -> x.assumed == \"\"\n          && !contains(kept, x.label)\n          && !contains(proved, x.label)\n          && solver_checks(x),\n      )\n      timings.begin(\"verify: encode\")\n      solved = solved_together(\n        mut launcher,\n        mut disk,\n        ctx,\n        methods,\n        chunk[..min(len(chunk), solved_chunk())],\n      )\n      timings.end(\"verify: encode\")\n    }\n    label := t.label\n    // (what its loops' searches found; a verdict made with a search cut short\n    // by the budget isn't cached)\n    search_cut := match get(solved, label) {\n      Some((vc, _)) => {\n        if vc.found_loops != [] {\n          mut found.push((t, vc.found_loops))\n        }\n        vc.search_cut\n      },\n      None => false,\n    }\n    status := get(analysis.status, label)\n    // only code shown to terminate is cross-checked: running anything else\n    // may never end\n    cc := cross_runs(status, o.cross)\n    fz := (n: Int, b: Option[Int]) -> match get(index, t.key) {\n      Some(i) => timings.timed(if b is Some {\n        \"verify: cross-check\"\n      } else {\n        \"verify: fuzz\"\n      }, () -> {\n        t0 := timings.now()\n        r := fuzz_run(h, i, t.key, t.shown, n, o.seed, b)\n        if t0 != 0 {\n          // (by the name the encoder's timings use)\n          timed_name := match t.decl {\n            Some(f) => f.name,\n            None => t.label,\n          }\n          timings.since(timed_name, \"cross\", t0)\n          timings.add(timed_name, \"runs\", n)\n        }\n        r\n      }),\n      None => FuzzSkipped(get(why, t.key) ?? \"not compiled\"),\n    }\n    cached := contains(kept, label)\n    lawful := (x: Verdict) -> match t.law_of {\n      Some((lw, ty)) => law_verdict(x, lw, ty),\n      None => x,\n    }\n    timings.begin(\"verify: check a function\")\n    v := match get(kept, label) {\n      Some(x) => Some(x),\n      None => match get(proved, label) {\n        // proven before, with what it relies on unchanged: only the cross-check\n        // runs again, since callees' bodies may have changed\n        Some(p) => Some(lawful(cross_checked(p, cc, t.once, fz))),\n        None => if t.assumed != \"\" {\n          Some(VAssumed(t.assumed))\n        } else {\n          match t.decl {\n            Some(f) => match check_fn(\n              mut launcher,\n              mut disk,\n              ctx,\n              methods,\n              get(solved, label),\n              sh,\n              pre,\n              file,\n              wrappers,\n              holders,\n              get(not_run, t.key),\n              f,\n              t.key,\n              t.shown,\n              t.once,\n              o.cases,\n              cc,\n              o.seed,\n              fz,\n            ) {\n              Some(x0) => {\n                // a lemma not shown to end proves nothing: its recursion is\n                // its induction\n                x := match (t.decl, status) {\n                  (Some(f), Some(termination.Unknown(why))) => if f.lemma && x0 is VProven {\n                    VIncomplete(\n                      \"a lemma is proven only once it is shown to terminate (a recursive lemma is a proof by induction): \"\n                        + why,\n                    )\n                  } else {\n                    x0\n                  },\n                  _ => x0,\n                }\n                if x is VProven && !o.no_cache && !search_cut {\n                  match proof_key_of(t) {\n                    Some(k) => write_proof(mut disk, caches, k, x),\n                    None => (),\n                  }\n                }\n                Some(lawful(x))\n              },\n              None => None,\n            },\n            // a method only the trait defines: fuzzed\n            None => Some(fuzzed_with(fz(o.cases, None), 0, [])),\n          }\n        },\n      },\n    }\n    timings.end(\"verify: check a function\")\n    match v {\n      Some(found) => {\n        // (as reported: a function whose only unproven checks are of assumed\n        // contracts is assumed, trusted, cached, and listed in the proofs as found)\n        verdict := assumed_verdict(found, label, assumed_clauses)\n        // (a cached proof cross-checked again is reported as cached)\n        shown_cached := cached || contains(proved, label) && verdict is VProven\n        if !cached && !o.no_cache && !search_cut {\n          timings.begin(\"verify: cache keys\")\n          write_verdict(mut disk, caches, key_of(t), found)\n          timings.end(\"verify: cache keys\")\n        }\n        def := def_name(t.def)\n        mut worst.insert(\n          def,\n          match get(worst, def) {\n            Some(w) => if verdict_rank(verdict) > verdict_rank(w) {\n              verdict\n            } else {\n              w\n            },\n            None => verdict,\n          },\n        )\n        proofs += proof_lines(label, found).map(\n          l -> def + \"\\t\" + (get(closures, t.def) ?? \"?\") + \"\\t\" + l,\n        )\n        if verdict is VCounterexample {\n          ok = false\n        }\n        if !shown_cached {\n          fresh += 1\n          match verdict {\n            VProven { .. } => {\n              fresh_proven += 1\n            },\n            VFuzzed { .. } => {\n              fresh_fuzzed += 1\n            },\n            VCounterexample { .. } => mut failed.push(\"`\" + label + \"`\"),\n            _ => (),\n          }\n        }\n        if o.json {\n          mut entries.push(\n            verdict_json(label, verdict, status, shown_cached),\n          )\n        } else if !o.quiet {\n          for line in report(\n            label,\n            verdict,\n            status,\n            o.checks_shown,\n            shown_cached,\n            console.paint(std.term.Output),\n            assumed_clauses,\n          ) {\n            print(line)\n          }\n        }\n        if t.law_of == None {\n          (accepted, broken) := rules_broken(\n            o.require,\n            rules,\n            module_of_check(raw, def),\n            label,\n            found,\n            verdict,\n            status,\n            contains(analysis.recursive, label),\n          )\n          if accepted {\n            mut trusted.push(\"`\" + label + \"`\")\n          }\n          violations += broken\n        }\n      },\n      None => if !o.quiet && !o.json {\n        print(\n          \"? \" + pad(label, 24) + \" not covered by compiler/smt yet\",\n        )\n      },\n    }\n  }\n  // each definition's status (its worst verdict), for the code as it is\n  for (def, w) in items(worst) {\n    write_status(\n      mut disk,\n      caches,\n      def_key(closures, impl_names, def),\n      w,\n    )\n  }\n  // what `build` may leave out: each check proven, for the code as it is\n  record_proofs(\n    mut disk,\n    caches,\n    file,\n    o.proofs_at,\n    set(targets.map(t -> def_name(t.def))),\n    closures,\n    impl_names,\n    proofs,\n  )\n  // (`--show-searches`: what every loop's search took; `verify` searches\n  // none)\n  for l in search_notes(found, o.budget, o.show_searches) {\n    mut console.eprint(l)\n  }\n  // (the whole program verified as it is now: `run` has nothing to verify\n  // alongside it)\n  if o.selection == \"\" {\n    record_verified(mut disk, caches, file)\n  }\n  if o.json {\n    print(driver.pretty_json(driver.JList(entries)))\n  } else if o.quiet {\n    match changed_line(fresh, fresh_proven, fresh_fuzzed, failed) {\n      Some(line) => if !o.silent {\n        mut console.eprint(line)\n      },\n      None => (),\n    }\n  } else {\n    for line in policy_lines(trusted, violations) {\n      print(line)\n    }\n  }\n  if ok && violations == [] {\n    0\n  } else {\n    1\n  }\n}"},{"name":"smt_file","kind":"fn","old":"1a9344a10d7987f5","new":"39bfd4d438497d80","interface_changed":false,"affected":[],"module":"","text":"/// `smt [--only SELECTION] [--queries] [--std DIR] FILE`: each check\n/// `verify` asks the solver about, of a script or package, for a selection\n/// as `verify --only` takes it (`fn LABEL`), then the solver's answer to\n/// each obligation (`proven`, `refuted` or `unknown`, then what it is), as\n/// `strata verify --obligations` prints them. Or `not covered:` and what it\n/// uses that `compiler/smt` doesn't model. `--queries` prints each\n/// obligation's query instead (`; LABEL — WHAT`, then the SMT-LIB script)\n/// and runs nothing, as `strata verify --smt` does. Termination is analysed\n/// for what the selection reaches.\nfn smt_file(\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  cache: cache.Cache,\n  solver: String,\n  all_args: List[String],\n) {\n  (selection, queries, args) := selection_args(all_args)\n  (dir, file) := match args {\n    [\"--std\", d, f, ..] => (d, f),\n    [f, ..] => (\"std\", f),\n    [] => (\"std\", \"\"),\n  }\n  v := verify_inputs(\n    disk,\n    dir,\n    file,\n    source_files(disk, file),\n    selection,\n  ) except e {\n    print(\"error: \" + e)\n    return\n  }\n  scratch := cache.smt\n  cache.make_dirs(mut disk, scratch)\n  ctx := termination.context(\n    v.fns,\n    v.types,\n    v.sigs,\n    v.all_methods,\n    scratch,\n    solver,\n  )\n  targets := chosen_checks(ctx, v).filter(solver_asked)\n  // what a contract may see through: what finishes and cannot fail\n  // (compiler/termination), for what the chosen checks reach\n  methods := smt.Methods { ..termination.seen_through(ctx, termination.analyze(\n    mut launcher,\n    mut disk,\n    ctx,\n    Some(check_roots(targets)),\n  )), examples: true }\n  for t in targets {\n    match t.decl {\n      Some(f) => {\n        if !queries {\n          print(\"fn \" + t.label)\n        }\n        vc := smt.encode(\n          mut launcher,\n          mut disk,\n          scratch,\n          solver,\n          v.fns,\n          v.types,\n          v.sigs,\n          methods,\n          f,\n          f.name,\n        )\n        match get(vc.gaps, 0) {\n          Some(g) => if queries {\n            print(\"; \" + t.label + \" — not covered: \" + g)\n          } else {\n            print(\"  not covered: \" + g)\n          },\n          None => if queries {\n            for (i, ob) in enumerate(vc.obligations) {\n              print(\"; \"\n                + t.label\n                + \" — \"\n                + ob.what\n                + \"\\n\"\n                + smt.query_text(vc, i))\n            }\n            // (then termination's)\n            for (what, q) in termination.termination_queries(\n              mut launcher,\n              mut disk,\n              ctx,\n              f,\n              t.label,\n            ) {\n              print(\"; \" + t.label + \" — \" + what + \"\\n\" + q)\n            }\n          } else {\n            for line in smt.solve(mut launcher, mut disk, scratch, solver, vc) {\n              print(\"  \" + line)\n            }\n          },\n        }\n      },\n      None => (),\n    }\n  }\n}","old_text":"/// `smt [--only SELECTION] [--queries] [--std DIR] FILE`: each function of\n/// a script or package (`fn NAME`; those a selection names, as `verify\n/// --only`), then the solver's answer to each obligation (`proven`,\n/// `refuted` or `unknown`, then what it is), as `strata verify\n/// --obligations` prints them. Or `not covered:` and what it uses that\n/// `compiler/smt` doesn't model. `--queries` prints each obligation's query\n/// instead (`; NAME — WHAT`, then the SMT-LIB script) and runs nothing, as\n/// `strata verify --smt` does.\nfn smt_file(\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  cache: cache.Cache,\n  solver: String,\n  all_args: List[String],\n) {\n  (selection, queries, args) := selection_args(all_args)\n  chosen := chosen_in(disk, args, selection) except e {\n    print(\"error: \" + e)\n    return\n  }\n  (own, fns, types, sigs, all_methods) := verified_program(disk, args)\n  scratch := cache.smt\n  cache.make_dirs(mut disk, scratch)\n  // what a contract may see through: what finishes and cannot fail\n  // (compiler/termination), for what the file's code reaches\n  ctx := termination.context(\n    fns,\n    types,\n    sigs,\n    all_methods,\n    scratch,\n    solver,\n  )\n  methods := termination.seen_through(ctx, termination.analyze(\n    mut launcher,\n    mut disk,\n    ctx,\n    Some(set(shown_names(ctx, own))),\n  ))\n  for d in own {\n    match d.kind {\n      ast.FnDef(f) => if !f.params.any(p -> p.compile_time)\n        && contains(chosen, store.qualify(d.module, f.name)) {\n        label := if d.module == \"\" {\n          f.name\n        } else {\n          d.module + \".\" + f.name\n        }\n        if !queries {\n          print(\"fn \" + label)\n        }\n        vc := smt.encode(\n          mut launcher,\n          mut disk,\n          scratch,\n          solver,\n          fns,\n          types,\n          sigs,\n          methods,\n          f,\n          label,\n        )\n        match get(vc.gaps, 0) {\n          Some(g) => if queries {\n            print(\"; \" + label + \" — not covered: \" + g)\n          } else {\n            print(\"  not covered: \" + g)\n          },\n          None => if queries {\n            for (i, ob) in enumerate(vc.obligations) {\n              print(\"; \"\n                + label\n                + \" — \"\n                + ob.what\n                + \"\\n\"\n                + smt.query_text(vc, i))\n            }\n            // (then termination's)\n            for (what, q) in termination.termination_queries(\n              mut launcher,\n              mut disk,\n              ctx,\n              f,\n              label,\n            ) {\n              print(\"; \" + label + \" — \" + what + \"\\n\" + q)\n            }\n          } else {\n            for line in smt.solve(mut launcher, mut disk, scratch, solver, vc) {\n              print(\"  \" + line)\n            }\n          },\n        }\n      },\n      _ => (),\n    }\n  }\n}"},{"name":"VerifyInputs","kind":"type","old":null,"new":"04bbe16a187ad1d4","interface_changed":true,"affected":[],"module":"","text":"/// What `verify` looks at in a program: its own definitions (`raw`), those\n/// the selection chose, what the program, std and core declare, the types\n/// holding a capability, the wrappers methods and laws run through, the\n/// program as the verifier sees it with them, and its implementations\n/// (`impls_named`).\ntype VerifyInputs = {\n  raw: List[ast.Decl],\n  chosen: Set[String],\n  declared: Declared,\n  holders: Dict[String, String],\n  wrappers: List[ast.Decl],\n  own: List[ast.Decl],\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  sigs: List[smt.BuiltinSig],\n  all_methods: smt.Methods,\n  derived: Set[Int],\n  impl_names: List[String],\n}"},{"name":"verify_inputs","kind":"fn","old":null,"new":"566e0244179136aa","interface_changed":true,"affected":[],"module":"","text":"/// The inputs of `verify` for the program at `file` (its module files\n/// `sources`), with std at `dir`, for a selection (`select_names`).\nfn verify_inputs(\n  disk: std.fs.Disk,\n  dir: String,\n  file: String,\n  sources: List[(String, String)],\n  selection: String,\n) -> Result[VerifyInputs, String] {\n  // the traits, capabilities and mocks of the file, std and core\n  raw := own_decls(disk, sources)\n  chosen := select_names(raw, selection)!\n  context_decls := module_decls(disk, core_files())\n    + std_reached(disk, dir, raw)\n    + raw\n  // (traits and impls with their models as methods, as checked)\n  declared := declared_of(desugar.with_models(context_decls, []))\n  wrappers := verify_wrappers(\n    raw,\n    declared.traits,\n    declared.impls,\n    declared.caps,\n  )\n  (own, fns, types, sigs, all_methods) := verified_with(disk, if dir == \"std\" {\n    [file]\n  } else {\n    [\"--std\", dir, file]\n  }, wrappers)\n  (derived, impl_names) := impls_named(raw)\n  Ok(VerifyInputs {\n    raw,\n    chosen,\n    declared,\n    holders: capability_holders(context_decls, declared.caps),\n    wrappers,\n    own,\n    fns,\n    types,\n    sigs,\n    all_methods,\n    derived,\n    impl_names,\n  })\n}"},{"name":"chosen_checks","kind":"fn","old":null,"new":"4fd46d3fb9585f25","interface_changed":true,"affected":[],"module":"","text":"/// The checks `verify` makes of the definitions `v` chose, in order\n/// (`checks_of`): a method's alone when the selection names it.\nfn chosen_checks(ctx: termination.Ctx, v: VerifyInputs) -> List[Check] {\n  def_name := (def: String) -> selected_name(v.impl_names, def)\n  checks_of(\n    ctx,\n    v.own,\n    v.declared.traits,\n    v.declared.caps,\n    v.declared.mocked,\n    v.declared.trait_modules,\n    v.derived,\n  ).filter(\n    t -> contains(v.chosen, def_name(t.def))\n      || match t.decl {\n        Some(f) => contains(\n          v.chosen,\n          method_key(def_name(t.def), method_of(f.name)),\n        ),\n        None => false,\n      },\n  )\n}"},{"name":"solver_asked","kind":"fn","old":null,"new":"8eed6514bfc1341c","interface_changed":true,"affected":[],"module":"","text":"/// The checks the solver is asked about: not trusted, and with code\n/// without holes.\nfn solver_asked(t: Check) -> Bool {\n  t.assumed == \"\" && solver_checks(t)\n}"}]}
{"id":"101457e72b05e0f8","time":1795831703,"message":"timings: verify's inputs and the invariant search's solving","changes":[{"name":"verify_program","kind":"fn","old":"c5d5f15eddb0f3ee","new":"c7cdbbaf26b871c3","interface_changed":false,"affected":[],"module":"","text":"/// The `verify` run of the program at `file` (a script, or a package's\n/// folder) with the settings `o`, as `verify_file` describes it: the\n/// program checked, the checks chosen, termination analysed, then each\n/// check's verdict (cached, proven, cross-checked, fuzzed), reported and\n/// cached, the rules applied, and the proofs recorded. With `o.finding`,\n/// only loops' invariants are searched for (exit 3: nothing written).\nfn verify_program(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  caches: cache.Cache,\n  solver: String,\n  cc: String,\n  o: VerifyOptions,\n  file: String,\n) -> std.process.ExitCode {\n  mut loaded := false\n  for lib in o.loads {\n    loaded = jit_load(lib).to_int() == 0\n  }\n  pre := if loaded && o.precompiled != \"\" {\n    [\"--precompiled\", o.precompiled]\n  } else {\n    []\n  }\n  // a script, or a package's folder: each module named by its path\n  sources := source_files(disk, file)\n  if sources == [] {\n    mut console.eprint(\"error: \" + file + \": no module file here\")\n    return 2\n  }\n  // the program must check first, as `strata check` checks it. Its compiles\n  // share the program, read and expanded once.\n  sh := with_base(disk, shared(disk, caches), [file])\n  core := sh.core\n  timings.begin(\"verify: check the program\")\n  errors := if o.finding != \"\" {\n    []\n  } else {\n    warned(mut console, file_errors(\n      mut launcher,\n      mut disk,\n      caches,\n      \"std\",\n      file,\n      false,\n      core,\n      sh,\n      pre,\n    ))\n  }\n  timings.end(\"verify: check the program\")\n  if errors != [] {\n    for e in errors {\n      mut console.eprint(error_text(e))\n    }\n    return 1\n  }\n  // the definitions chosen (every one without a selection), and the program\n  // as the verifier sees it\n  timings.begin(\"verify: inputs\")\n  v := verify_inputs(disk, \"std\", file, sources, o.selection) except e {\n    mut console.eprint(\"error: \" + e)\n    return 2\n  }\n  timings.end(\"verify: inputs\")\n  raw := v.raw\n  std_files := deps.module_files(disk, \"std\").map(f -> \"std/\" + f)\n  holders := v.holders\n  wrappers := v.wrappers\n  (own, fns, types, sigs, all_methods) := (v.own, v.fns, v.types, v.sigs, v.all_methods)\n  // (the assumed contracts as verify writes them: each check of one is\n  // noted as such)\n  assumed_clauses := assumed_texts(own)\n  scratch := caches.smt\n  cache.make_dirs(mut disk, scratch)\n  // (a solver that can't be run: none, and everything is fuzzed)\n  // (loops' invariants searched for only when finding them: `verify`\n  // and `build` use those derived from the code and those written)\n  ctx := {\n    c := termination.context(\n      fns,\n      types,\n      sigs,\n      all_methods,\n      scratch,\n      if toolchain.has_solver(mut launcher, solver) {\n        solver\n      } else {\n        \"\"\n      },\n    )\n    termination.Ctx {\n      ..c,\n      methods: smt.Methods { ..c.methods, search: if o.finding != \"\" {\n        2\n      } else {\n        0\n      } },\n    }\n  }\n  impl_names := v.impl_names\n  // each check's definition, by its name as a selection names it\n  def_name := (def: String) -> selected_name(impl_names, def)\n  targets := chosen_checks(ctx, v)\n  // termination is analysed for what the chosen checks reach\n  roots := check_roots(targets)\n  // (each function's loops as earlier runs found them, for its code as the\n  // encoder sees it: `loops_file`)\n  timings.begin(\"verify: cache keys\")\n  own_paths := set(sources.map(s -> s.0))\n  // (the prelude too: it is compiled into every driver)\n  others := std_fingerprint(\n    disk,\n    (core_files() + [\"runtime/prelude.strata\"] + std_files).filter(\n      f -> !contains(own_paths, f),\n    ),\n  )\n  target_defs := set(targets.map(t -> t.def))\n  loop_keys := interface_keys(disk, sources, ctx.methods, target_defs, true)\n  // (the solver by its path and version: a verdict where it gave up is kept\n  // too, since it gives that answer again)\n  solver_id := solver + \" (\" + solver_version(solver) + \")\"\n  loop_settings := \"loops derived solver \"\n    + solver_id\n    + \" std \"\n    + others\n    + \" impls \"\n    + impls_fingerprint(disk, sources)\n    + \" package \"\n    + package_settings(disk, file)\n  // (std's and core's own definitions: keyed by their names and std's code\n  // as a whole, `others`, so what std's loops and recursion take is found\n  // once and shipped with std)\n  library := library_names(\n    disk,\n    (core_files() + std_files).filter(f -> !contains(own_paths, f)),\n  )\n  loop_key := (n: String) -> match get(loop_keys, \"fn:\" + n) {\n    Some(k) => Some(loop_settings + \"\\n\" + n + \"\\n\" + k),\n    None => if contains(library, n) {\n      Some(loop_settings + \"\\n\" + n + \"\\nlibrary\")\n    } else {\n      None\n    },\n  }\n  reuse := !o.no_cache\n    && o.finding == \"\"\n    && cache.caching()\n    && ctx.solver != \"\"\n  known := (n: String) -> if reuse {\n    match loop_key(n) {\n      Some(k) => match cache.read_entry(disk, caches, loops_file(k)) {\n        Some(text) => loops_of_text(text),\n        None => None,\n      },\n      None => None,\n    }\n  } else {\n    None\n  }\n  known_measure := (n: String) -> if reuse {\n    match loop_key(n) {\n      Some(k) => match cache.read_entry(disk, caches, measure_file(k)) {\n        Some(text) => Some(if text == \"none\" {\n          None\n        } else {\n          Some(text)\n        }),\n        None => None,\n      },\n      None => None,\n    }\n  } else {\n    None\n  }\n  timings.end(\"verify: cache keys\")\n  // (one budget for every loop-invariant search of the run: termination's\n  // and verification's)\n  smt.set_search_budget(o.budget)\n  timings.begin(\"verify: termination\")\n  (analysis, learned, measured) := termination.analyze_with(\n    mut launcher,\n    mut disk,\n    ctx,\n    Some(roots),\n    known,\n    known_measure,\n  )\n  timings.end(\"verify: termination\")\n  if !o.no_cache\n    && o.finding == \"\"\n    && ctx.solver != \"\"\n    && cache.caching() {\n    for (n, x) in items(learned) {\n      match loop_key(n) {\n        Some(k) => write_loops(mut disk, caches, k, x),\n        None => (),\n      }\n    }\n    for (n, m) in items(measured) {\n      match loop_key(n) {\n        Some(k) => match cache.write_entry(\n          mut disk,\n          caches,\n          measure_file(k),\n          m ?? \"none\",\n        ) {\n          _ => (),\n        },\n        None => (),\n      }\n    }\n  }\n  methods := smt.Methods {\n    ..termination.seen_through(ctx, analysis),\n    examples: true,\n  }\n  // finding loops' invariants (`strata edit`, `strata fix`): nothing else\n  if o.finding != \"\" {\n    if ctx.solver == \"\" {\n      return 0\n    }\n    wrote := find_invariants(\n      mut console,\n      mut launcher,\n      mut disk,\n      file,\n      raw,\n      sh.core,\n      ctx,\n      methods,\n      analysis,\n      targets,\n      o.finding,\n      o.budget,\n      o.show_searches,\n      o.logged,\n    )\n    // (exit 3: nothing written)\n    return if wrote {\n      0\n    } else {\n      3\n    }\n  }\n  // the verdicts of earlier runs with these settings, for the code as it\n  // is now (each check's definition with all it depends on)\n  timings.begin(\"verify: cache keys\")\n  closures := closure_keys_of(disk, sources, target_defs)\n  // (`--no-cache` checks again; the package's settings, which std's code\n  // reads)\n  settings := \"loops derived externs-not-run seed \"\n    + to_string(o.seed)\n    + \" solver \"\n    + solver_id\n    + \" std \"\n    + std_fingerprint(\n      disk,\n      core_files() + [\"runtime/prelude.strata\"] + std_files,\n    )\n    + \" package \"\n    + package_settings(disk, file)\n  cross_of := (t: Check) -> cross_runs(get(analysis.status, t.label), o.cross)\n  key_of := (t: Check) -> {\n    cc := cross_of(t)\n    settings\n      + \"\\n\"\n      + t.label\n      + \"\\n\"\n      + (get(closures, t.def) ?? \"?\")\n      + \":\"\n      + to_string(o.cases)\n      + \":\"\n      + to_string(cc)\n  }\n  mut kept := Dict[String, Verdict] {}\n  if !o.no_cache && cache.caching() {\n    for t in targets {\n      match read_verdict(disk, caches, verdict_file(key_of(t))) {\n        Some(v) => mut kept.insert(t.label, v),\n        None => (),\n      }\n    }\n  }\n  // the proofs of earlier runs, for the code as the prover sees it\n  // (`interface_keys`: the callees' contracts, and their bodies only when it\n  // sees through them), with these settings. std's code is keyed by its\n  // hash, the program's by these keys (std's when std is the program).\n  interfaces := interface_keys(disk, sources, methods, target_defs, false)\n  proof_settings := \"loops derived seed \"\n    + to_string(o.seed)\n    + \" solver \"\n    + solver_id\n    + \" std \"\n    + others\n    + \" package \"\n    + package_settings(disk, file)\n  proof_key_of := (t: Check) -> match get(interfaces, t.def) {\n    Some(k) => Some(proof_settings + \"\\n\" + t.label + \"\\n\" + k),\n    None => None,\n  }\n  mut proved := Dict[String, Verdict] {}\n  if !o.no_cache && cache.caching() && ctx.solver != \"\" {\n    for t in targets {\n      if !contains(kept, t.label) && t.assumed == \"\" && t.decl is Some {\n        match proof_key_of(t) {\n          Some(k) => match read_verdict(disk, caches, proof_file(k)) {\n            Some(VProven { checks, given, sites }) => mut proved.insert(t.label, VProven { checks, given, sites }),\n            _ => (),\n          },\n          None => (),\n        }\n      }\n    }\n  }\n  timings.end(\"verify: cache keys\")\n  // one driver per function and wrapper still to check\n  reach := timings.timed(\"verify: externs\", () -> extern_reach(ctx, holders))\n  (keys, outside, not_run) := drivers_planned(\n    ctx,\n    holders,\n    reach,\n    targets,\n    kept,\n    proved,\n    analysis.status,\n    o.cross,\n  )\n  if keys != [] && !ends_with(file, \".strata\") {\n    load_own_native(\n      mut console,\n      mut launcher,\n      mut disk,\n      caches,\n      cc,\n      file,\n    )\n  }\n  (h, why_compiled) := if keys == [] {\n    (-1, Dict[String, String] {})\n  } else {\n    timings.timed(\n      \"verify: compile drivers\",\n      () -> compiled_drivers(disk, sh, pre, file, keys, wrappers),\n    )\n  }\n  mut why := why_compiled\n  for (n, w) in items(outside) {\n    mut why.insert(n, w)\n  }\n  mut index := Dict[String, Int] {}\n  mut k := 0\n  for n in keys {\n    if !contains(why, n) {\n      mut index.insert(n, k)\n      k += 1\n    }\n  }\n  // the package's `[verify]` rules: each rule's modules\n  rules := verify_rules(disk, file)\n  mut violations := []\n  // (`--json`: each verdict)\n  mut entries := []\n  mut trusted := []\n  mut proofs := []\n  // each definition's worst verdict, for its status\n  mut worst := Dict[String, Verdict] {}\n  // what was checked in this run (not cached): proven, fuzzed, or with a\n  // counterexample\n  mut fresh := 0\n  mut fresh_proven := 0\n  mut fresh_fuzzed := 0\n  mut failed := []\n  mut ok := true\n  // the functions the solver checks, a chunk at a time: encoded and their\n  // obligations answered together, the solver runs in parallel\n  mut solved := Dict[String, (smt.Vc, List[smt.Answer])] {}\n  mut found: List[(Check, List[smt.LoopFound])] = []\n  for (ti, t) in enumerate(targets) {\n    if solver_asked(t)\n      && !contains(kept, t.label)\n      && !contains(proved, t.label)\n      && !contains(solved, t.label)\n      && ctx.solver != \"\" {\n      chunk := drop(targets, ti).filter(\n        x -> solver_asked(x)\n          && !contains(kept, x.label)\n          && !contains(proved, x.label),\n      )\n      timings.begin(\"verify: encode\")\n      solved = solved_together(\n        mut launcher,\n        mut disk,\n        ctx,\n        methods,\n        chunk[..min(len(chunk), solved_chunk())],\n      )\n      timings.end(\"verify: encode\")\n    }\n    label := t.label\n    // (what its loops' searches found; a verdict made with a search cut short\n    // by the budget isn't cached)\n    search_cut := match get(solved, label) {\n      Some((vc, _)) => {\n        if vc.found_loops != [] {\n          mut found.push((t, vc.found_loops))\n        }\n        vc.search_cut\n      },\n      None => false,\n    }\n    status := get(analysis.status, label)\n    // only code shown to terminate is cross-checked: running anything else\n    // may never end\n    cc := cross_runs(status, o.cross)\n    fz := (n: Int, b: Option[Int]) -> match get(index, t.key) {\n      Some(i) => timings.timed(if b is Some {\n        \"verify: cross-check\"\n      } else {\n        \"verify: fuzz\"\n      }, () -> {\n        t0 := timings.now()\n        r := fuzz_run(h, i, t.key, t.shown, n, o.seed, b)\n        if t0 != 0 {\n          // (by the name the encoder's timings use)\n          timed_name := match t.decl {\n            Some(f) => f.name,\n            None => t.label,\n          }\n          timings.since(timed_name, \"cross\", t0)\n          timings.add(timed_name, \"runs\", n)\n        }\n        r\n      }),\n      None => FuzzSkipped(get(why, t.key) ?? \"not compiled\"),\n    }\n    cached := contains(kept, label)\n    lawful := (x: Verdict) -> match t.law_of {\n      Some((lw, ty)) => law_verdict(x, lw, ty),\n      None => x,\n    }\n    timings.begin(\"verify: check a function\")\n    v := match get(kept, label) {\n      Some(x) => Some(x),\n      None => match get(proved, label) {\n        // proven before, with what it relies on unchanged: only the cross-check\n        // runs again, since callees' bodies may have changed\n        Some(p) => Some(lawful(cross_checked(p, cc, t.once, fz))),\n        None => if t.assumed != \"\" {\n          Some(VAssumed(t.assumed))\n        } else {\n          match t.decl {\n            Some(f) => match check_fn(\n              mut launcher,\n              mut disk,\n              ctx,\n              methods,\n              get(solved, label),\n              sh,\n              pre,\n              file,\n              wrappers,\n              holders,\n              get(not_run, t.key),\n              f,\n              t.key,\n              t.shown,\n              t.once,\n              o.cases,\n              cc,\n              o.seed,\n              fz,\n            ) {\n              Some(x0) => {\n                // a lemma not shown to end proves nothing: its recursion is\n                // its induction\n                x := match (t.decl, status) {\n                  (Some(f), Some(termination.Unknown(why))) => if f.lemma && x0 is VProven {\n                    VIncomplete(\n                      \"a lemma is proven only once it is shown to terminate (a recursive lemma is a proof by induction): \"\n                        + why,\n                    )\n                  } else {\n                    x0\n                  },\n                  _ => x0,\n                }\n                if x is VProven && !o.no_cache && !search_cut {\n                  match proof_key_of(t) {\n                    Some(k) => write_proof(mut disk, caches, k, x),\n                    None => (),\n                  }\n                }\n                Some(lawful(x))\n              },\n              None => None,\n            },\n            // a method only the trait defines: fuzzed\n            None => Some(fuzzed_with(fz(o.cases, None), 0, [])),\n          }\n        },\n      },\n    }\n    timings.end(\"verify: check a function\")\n    match v {\n      Some(found) => {\n        // (as reported: a function whose only unproven checks are of assumed\n        // contracts is assumed, trusted, cached, and listed in the proofs as found)\n        verdict := assumed_verdict(found, label, assumed_clauses)\n        // (a cached proof cross-checked again is reported as cached)\n        shown_cached := cached || contains(proved, label) && verdict is VProven\n        if !cached && !o.no_cache && !search_cut {\n          timings.begin(\"verify: cache keys\")\n          write_verdict(mut disk, caches, key_of(t), found)\n          timings.end(\"verify: cache keys\")\n        }\n        def := def_name(t.def)\n        mut worst.insert(\n          def,\n          match get(worst, def) {\n            Some(w) => if verdict_rank(verdict) > verdict_rank(w) {\n              verdict\n            } else {\n              w\n            },\n            None => verdict,\n          },\n        )\n        proofs += proof_lines(label, found).map(\n          l -> def + \"\\t\" + (get(closures, t.def) ?? \"?\") + \"\\t\" + l,\n        )\n        if verdict is VCounterexample {\n          ok = false\n        }\n        if !shown_cached {\n          fresh += 1\n          match verdict {\n            VProven { .. } => {\n              fresh_proven += 1\n            },\n            VFuzzed { .. } => {\n              fresh_fuzzed += 1\n            },\n            VCounterexample { .. } => mut failed.push(\"`\" + label + \"`\"),\n            _ => (),\n          }\n        }\n        if o.json {\n          mut entries.push(\n            verdict_json(label, verdict, status, shown_cached),\n          )\n        } else if !o.quiet {\n          for line in report(\n            label,\n            verdict,\n            status,\n            o.checks_shown,\n            shown_cached,\n            console.paint(std.term.Output),\n            assumed_clauses,\n          ) {\n            print(line)\n          }\n        }\n        if t.law_of == None {\n          (accepted, broken) := rules_broken(\n            o.require,\n            rules,\n            module_of_check(raw, def),\n            label,\n            found,\n            verdict,\n            status,\n            contains(analysis.recursive, label),\n          )\n          if accepted {\n            mut trusted.push(\"`\" + label + \"`\")\n          }\n          violations += broken\n        }\n      },\n      None => if !o.quiet && !o.json {\n        print(\n          \"? \" + pad(label, 24) + \" not covered by compiler/smt yet\",\n        )\n      },\n    }\n  }\n  // each definition's status (its worst verdict), for the code as it is\n  for (def, w) in items(worst) {\n    write_status(\n      mut disk,\n      caches,\n      def_key(closures, impl_names, def),\n      w,\n    )\n  }\n  // what `build` may leave out: each check proven, for the code as it is\n  record_proofs(\n    mut disk,\n    caches,\n    file,\n    o.proofs_at,\n    set(targets.map(t -> def_name(t.def))),\n    closures,\n    impl_names,\n    proofs,\n  )\n  // (`--show-searches`: what every loop's search took; `verify` searches\n  // none)\n  for l in search_notes(found, o.budget, o.show_searches) {\n    mut console.eprint(l)\n  }\n  // (the whole program verified as it is now: `run` has nothing to verify\n  // alongside it)\n  if o.selection == \"\" {\n    record_verified(mut disk, caches, file)\n  }\n  if o.json {\n    print(driver.pretty_json(driver.JList(entries)))\n  } else if o.quiet {\n    match changed_line(fresh, fresh_proven, fresh_fuzzed, failed) {\n      Some(line) => if !o.silent {\n        mut console.eprint(line)\n      },\n      None => (),\n    }\n  } else {\n    for line in policy_lines(trusted, violations) {\n      print(line)\n    }\n  }\n  if ok && violations == [] {\n    0\n  } else {\n    1\n  }\n}","old_text":"/// The `verify` run of the program at `file` (a script, or a package's\n/// folder) with the settings `o`, as `verify_file` describes it: the\n/// program checked, the checks chosen, termination analysed, then each\n/// check's verdict (cached, proven, cross-checked, fuzzed), reported and\n/// cached, the rules applied, and the proofs recorded. With `o.finding`,\n/// only loops' invariants are searched for (exit 3: nothing written).\nfn verify_program(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  caches: cache.Cache,\n  solver: String,\n  cc: String,\n  o: VerifyOptions,\n  file: String,\n) -> std.process.ExitCode {\n  mut loaded := false\n  for lib in o.loads {\n    loaded = jit_load(lib).to_int() == 0\n  }\n  pre := if loaded && o.precompiled != \"\" {\n    [\"--precompiled\", o.precompiled]\n  } else {\n    []\n  }\n  // a script, or a package's folder: each module named by its path\n  sources := source_files(disk, file)\n  if sources == [] {\n    mut console.eprint(\"error: \" + file + \": no module file here\")\n    return 2\n  }\n  // the program must check first, as `strata check` checks it. Its compiles\n  // share the program, read and expanded once.\n  sh := with_base(disk, shared(disk, caches), [file])\n  core := sh.core\n  timings.begin(\"verify: check the program\")\n  errors := if o.finding != \"\" {\n    []\n  } else {\n    warned(mut console, file_errors(\n      mut launcher,\n      mut disk,\n      caches,\n      \"std\",\n      file,\n      false,\n      core,\n      sh,\n      pre,\n    ))\n  }\n  timings.end(\"verify: check the program\")\n  if errors != [] {\n    for e in errors {\n      mut console.eprint(error_text(e))\n    }\n    return 1\n  }\n  // the definitions chosen (every one without a selection), and the program\n  // as the verifier sees it\n  v := verify_inputs(disk, \"std\", file, sources, o.selection) except e {\n    mut console.eprint(\"error: \" + e)\n    return 2\n  }\n  raw := v.raw\n  std_files := deps.module_files(disk, \"std\").map(f -> \"std/\" + f)\n  holders := v.holders\n  wrappers := v.wrappers\n  (own, fns, types, sigs, all_methods) := (v.own, v.fns, v.types, v.sigs, v.all_methods)\n  // (the assumed contracts as verify writes them: each check of one is\n  // noted as such)\n  assumed_clauses := assumed_texts(own)\n  scratch := caches.smt\n  cache.make_dirs(mut disk, scratch)\n  // (a solver that can't be run: none, and everything is fuzzed)\n  // (loops' invariants searched for only when finding them: `verify`\n  // and `build` use those derived from the code and those written)\n  ctx := {\n    c := termination.context(\n      fns,\n      types,\n      sigs,\n      all_methods,\n      scratch,\n      if toolchain.has_solver(mut launcher, solver) {\n        solver\n      } else {\n        \"\"\n      },\n    )\n    termination.Ctx {\n      ..c,\n      methods: smt.Methods { ..c.methods, search: if o.finding != \"\" {\n        2\n      } else {\n        0\n      } },\n    }\n  }\n  impl_names := v.impl_names\n  // each check's definition, by its name as a selection names it\n  def_name := (def: String) -> selected_name(impl_names, def)\n  targets := chosen_checks(ctx, v)\n  // termination is analysed for what the chosen checks reach\n  roots := check_roots(targets)\n  // (each function's loops as earlier runs found them, for its code as the\n  // encoder sees it: `loops_file`)\n  timings.begin(\"verify: cache keys\")\n  own_paths := set(sources.map(s -> s.0))\n  // (the prelude too: it is compiled into every driver)\n  others := std_fingerprint(\n    disk,\n    (core_files() + [\"runtime/prelude.strata\"] + std_files).filter(\n      f -> !contains(own_paths, f),\n    ),\n  )\n  target_defs := set(targets.map(t -> t.def))\n  loop_keys := interface_keys(disk, sources, ctx.methods, target_defs, true)\n  // (the solver by its path and version: a verdict where it gave up is kept\n  // too, since it gives that answer again)\n  solver_id := solver + \" (\" + solver_version(solver) + \")\"\n  loop_settings := \"loops derived solver \"\n    + solver_id\n    + \" std \"\n    + others\n    + \" impls \"\n    + impls_fingerprint(disk, sources)\n    + \" package \"\n    + package_settings(disk, file)\n  // (std's and core's own definitions: keyed by their names and std's code\n  // as a whole, `others`, so what std's loops and recursion take is found\n  // once and shipped with std)\n  library := library_names(\n    disk,\n    (core_files() + std_files).filter(f -> !contains(own_paths, f)),\n  )\n  loop_key := (n: String) -> match get(loop_keys, \"fn:\" + n) {\n    Some(k) => Some(loop_settings + \"\\n\" + n + \"\\n\" + k),\n    None => if contains(library, n) {\n      Some(loop_settings + \"\\n\" + n + \"\\nlibrary\")\n    } else {\n      None\n    },\n  }\n  reuse := !o.no_cache\n    && o.finding == \"\"\n    && cache.caching()\n    && ctx.solver != \"\"\n  known := (n: String) -> if reuse {\n    match loop_key(n) {\n      Some(k) => match cache.read_entry(disk, caches, loops_file(k)) {\n        Some(text) => loops_of_text(text),\n        None => None,\n      },\n      None => None,\n    }\n  } else {\n    None\n  }\n  known_measure := (n: String) -> if reuse {\n    match loop_key(n) {\n      Some(k) => match cache.read_entry(disk, caches, measure_file(k)) {\n        Some(text) => Some(if text == \"none\" {\n          None\n        } else {\n          Some(text)\n        }),\n        None => None,\n      },\n      None => None,\n    }\n  } else {\n    None\n  }\n  timings.end(\"verify: cache keys\")\n  // (one budget for every loop-invariant search of the run: termination's\n  // and verification's)\n  smt.set_search_budget(o.budget)\n  timings.begin(\"verify: termination\")\n  (analysis, learned, measured) := termination.analyze_with(\n    mut launcher,\n    mut disk,\n    ctx,\n    Some(roots),\n    known,\n    known_measure,\n  )\n  timings.end(\"verify: termination\")\n  if !o.no_cache\n    && o.finding == \"\"\n    && ctx.solver != \"\"\n    && cache.caching() {\n    for (n, x) in items(learned) {\n      match loop_key(n) {\n        Some(k) => write_loops(mut disk, caches, k, x),\n        None => (),\n      }\n    }\n    for (n, m) in items(measured) {\n      match loop_key(n) {\n        Some(k) => match cache.write_entry(\n          mut disk,\n          caches,\n          measure_file(k),\n          m ?? \"none\",\n        ) {\n          _ => (),\n        },\n        None => (),\n      }\n    }\n  }\n  methods := smt.Methods {\n    ..termination.seen_through(ctx, analysis),\n    examples: true,\n  }\n  // finding loops' invariants (`strata edit`, `strata fix`): nothing else\n  if o.finding != \"\" {\n    if ctx.solver == \"\" {\n      return 0\n    }\n    wrote := find_invariants(\n      mut console,\n      mut launcher,\n      mut disk,\n      file,\n      raw,\n      sh.core,\n      ctx,\n      methods,\n      analysis,\n      targets,\n      o.finding,\n      o.budget,\n      o.show_searches,\n      o.logged,\n    )\n    // (exit 3: nothing written)\n    return if wrote {\n      0\n    } else {\n      3\n    }\n  }\n  // the verdicts of earlier runs with these settings, for the code as it\n  // is now (each check's definition with all it depends on)\n  timings.begin(\"verify: cache keys\")\n  closures := closure_keys_of(disk, sources, target_defs)\n  // (`--no-cache` checks again; the package's settings, which std's code\n  // reads)\n  settings := \"loops derived externs-not-run seed \"\n    + to_string(o.seed)\n    + \" solver \"\n    + solver_id\n    + \" std \"\n    + std_fingerprint(\n      disk,\n      core_files() + [\"runtime/prelude.strata\"] + std_files,\n    )\n    + \" package \"\n    + package_settings(disk, file)\n  cross_of := (t: Check) -> cross_runs(get(analysis.status, t.label), o.cross)\n  key_of := (t: Check) -> {\n    cc := cross_of(t)\n    settings\n      + \"\\n\"\n      + t.label\n      + \"\\n\"\n      + (get(closures, t.def) ?? \"?\")\n      + \":\"\n      + to_string(o.cases)\n      + \":\"\n      + to_string(cc)\n  }\n  mut kept := Dict[String, Verdict] {}\n  if !o.no_cache && cache.caching() {\n    for t in targets {\n      match read_verdict(disk, caches, verdict_file(key_of(t))) {\n        Some(v) => mut kept.insert(t.label, v),\n        None => (),\n      }\n    }\n  }\n  // the proofs of earlier runs, for the code as the prover sees it\n  // (`interface_keys`: the callees' contracts, and their bodies only when it\n  // sees through them), with these settings. std's code is keyed by its\n  // hash, the program's by these keys (std's when std is the program).\n  interfaces := interface_keys(disk, sources, methods, target_defs, false)\n  proof_settings := \"loops derived seed \"\n    + to_string(o.seed)\n    + \" solver \"\n    + solver_id\n    + \" std \"\n    + others\n    + \" package \"\n    + package_settings(disk, file)\n  proof_key_of := (t: Check) -> match get(interfaces, t.def) {\n    Some(k) => Some(proof_settings + \"\\n\" + t.label + \"\\n\" + k),\n    None => None,\n  }\n  mut proved := Dict[String, Verdict] {}\n  if !o.no_cache && cache.caching() && ctx.solver != \"\" {\n    for t in targets {\n      if !contains(kept, t.label) && t.assumed == \"\" && t.decl is Some {\n        match proof_key_of(t) {\n          Some(k) => match read_verdict(disk, caches, proof_file(k)) {\n            Some(VProven { checks, given, sites }) => mut proved.insert(t.label, VProven { checks, given, sites }),\n            _ => (),\n          },\n          None => (),\n        }\n      }\n    }\n  }\n  timings.end(\"verify: cache keys\")\n  // one driver per function and wrapper still to check\n  reach := timings.timed(\"verify: externs\", () -> extern_reach(ctx, holders))\n  (keys, outside, not_run) := drivers_planned(\n    ctx,\n    holders,\n    reach,\n    targets,\n    kept,\n    proved,\n    analysis.status,\n    o.cross,\n  )\n  if keys != [] && !ends_with(file, \".strata\") {\n    load_own_native(\n      mut console,\n      mut launcher,\n      mut disk,\n      caches,\n      cc,\n      file,\n    )\n  }\n  (h, why_compiled) := if keys == [] {\n    (-1, Dict[String, String] {})\n  } else {\n    timings.timed(\n      \"verify: compile drivers\",\n      () -> compiled_drivers(disk, sh, pre, file, keys, wrappers),\n    )\n  }\n  mut why := why_compiled\n  for (n, w) in items(outside) {\n    mut why.insert(n, w)\n  }\n  mut index := Dict[String, Int] {}\n  mut k := 0\n  for n in keys {\n    if !contains(why, n) {\n      mut index.insert(n, k)\n      k += 1\n    }\n  }\n  // the package's `[verify]` rules: each rule's modules\n  rules := verify_rules(disk, file)\n  mut violations := []\n  // (`--json`: each verdict)\n  mut entries := []\n  mut trusted := []\n  mut proofs := []\n  // each definition's worst verdict, for its status\n  mut worst := Dict[String, Verdict] {}\n  // what was checked in this run (not cached): proven, fuzzed, or with a\n  // counterexample\n  mut fresh := 0\n  mut fresh_proven := 0\n  mut fresh_fuzzed := 0\n  mut failed := []\n  mut ok := true\n  // the functions the solver checks, a chunk at a time: encoded and their\n  // obligations answered together, the solver runs in parallel\n  mut solved := Dict[String, (smt.Vc, List[smt.Answer])] {}\n  mut found: List[(Check, List[smt.LoopFound])] = []\n  for (ti, t) in enumerate(targets) {\n    if solver_asked(t)\n      && !contains(kept, t.label)\n      && !contains(proved, t.label)\n      && !contains(solved, t.label)\n      && ctx.solver != \"\" {\n      chunk := drop(targets, ti).filter(\n        x -> solver_asked(x)\n          && !contains(kept, x.label)\n          && !contains(proved, x.label),\n      )\n      timings.begin(\"verify: encode\")\n      solved = solved_together(\n        mut launcher,\n        mut disk,\n        ctx,\n        methods,\n        chunk[..min(len(chunk), solved_chunk())],\n      )\n      timings.end(\"verify: encode\")\n    }\n    label := t.label\n    // (what its loops' searches found; a verdict made with a search cut short\n    // by the budget isn't cached)\n    search_cut := match get(solved, label) {\n      Some((vc, _)) => {\n        if vc.found_loops != [] {\n          mut found.push((t, vc.found_loops))\n        }\n        vc.search_cut\n      },\n      None => false,\n    }\n    status := get(analysis.status, label)\n    // only code shown to terminate is cross-checked: running anything else\n    // may never end\n    cc := cross_runs(status, o.cross)\n    fz := (n: Int, b: Option[Int]) -> match get(index, t.key) {\n      Some(i) => timings.timed(if b is Some {\n        \"verify: cross-check\"\n      } else {\n        \"verify: fuzz\"\n      }, () -> {\n        t0 := timings.now()\n        r := fuzz_run(h, i, t.key, t.shown, n, o.seed, b)\n        if t0 != 0 {\n          // (by the name the encoder's timings use)\n          timed_name := match t.decl {\n            Some(f) => f.name,\n            None => t.label,\n          }\n          timings.since(timed_name, \"cross\", t0)\n          timings.add(timed_name, \"runs\", n)\n        }\n        r\n      }),\n      None => FuzzSkipped(get(why, t.key) ?? \"not compiled\"),\n    }\n    cached := contains(kept, label)\n    lawful := (x: Verdict) -> match t.law_of {\n      Some((lw, ty)) => law_verdict(x, lw, ty),\n      None => x,\n    }\n    timings.begin(\"verify: check a function\")\n    v := match get(kept, label) {\n      Some(x) => Some(x),\n      None => match get(proved, label) {\n        // proven before, with what it relies on unchanged: only the cross-check\n        // runs again, since callees' bodies may have changed\n        Some(p) => Some(lawful(cross_checked(p, cc, t.once, fz))),\n        None => if t.assumed != \"\" {\n          Some(VAssumed(t.assumed))\n        } else {\n          match t.decl {\n            Some(f) => match check_fn(\n              mut launcher,\n              mut disk,\n              ctx,\n              methods,\n              get(solved, label),\n              sh,\n              pre,\n              file,\n              wrappers,\n              holders,\n              get(not_run, t.key),\n              f,\n              t.key,\n              t.shown,\n              t.once,\n              o.cases,\n              cc,\n              o.seed,\n              fz,\n            ) {\n              Some(x0) => {\n                // a lemma not shown to end proves nothing: its recursion is\n                // its induction\n                x := match (t.decl, status) {\n                  (Some(f), Some(termination.Unknown(why))) => if f.lemma && x0 is VProven {\n                    VIncomplete(\n                      \"a lemma is proven only once it is shown to terminate (a recursive lemma is a proof by induction): \"\n                        + why,\n                    )\n                  } else {\n                    x0\n                  },\n                  _ => x0,\n                }\n                if x is VProven && !o.no_cache && !search_cut {\n                  match proof_key_of(t) {\n                    Some(k) => write_proof(mut disk, caches, k, x),\n                    None => (),\n                  }\n                }\n                Some(lawful(x))\n              },\n              None => None,\n            },\n            // a method only the trait defines: fuzzed\n            None => Some(fuzzed_with(fz(o.cases, None), 0, [])),\n          }\n        },\n      },\n    }\n    timings.end(\"verify: check a function\")\n    match v {\n      Some(found) => {\n        // (as reported: a function whose only unproven checks are of assumed\n        // contracts is assumed, trusted, cached, and listed in the proofs as found)\n        verdict := assumed_verdict(found, label, assumed_clauses)\n        // (a cached proof cross-checked again is reported as cached)\n        shown_cached := cached || contains(proved, label) && verdict is VProven\n        if !cached && !o.no_cache && !search_cut {\n          timings.begin(\"verify: cache keys\")\n          write_verdict(mut disk, caches, key_of(t), found)\n          timings.end(\"verify: cache keys\")\n        }\n        def := def_name(t.def)\n        mut worst.insert(\n          def,\n          match get(worst, def) {\n            Some(w) => if verdict_rank(verdict) > verdict_rank(w) {\n              verdict\n            } else {\n              w\n            },\n            None => verdict,\n          },\n        )\n        proofs += proof_lines(label, found).map(\n          l -> def + \"\\t\" + (get(closures, t.def) ?? \"?\") + \"\\t\" + l,\n        )\n        if verdict is VCounterexample {\n          ok = false\n        }\n        if !shown_cached {\n          fresh += 1\n          match verdict {\n            VProven { .. } => {\n              fresh_proven += 1\n            },\n            VFuzzed { .. } => {\n              fresh_fuzzed += 1\n            },\n            VCounterexample { .. } => mut failed.push(\"`\" + label + \"`\"),\n            _ => (),\n          }\n        }\n        if o.json {\n          mut entries.push(\n            verdict_json(label, verdict, status, shown_cached),\n          )\n        } else if !o.quiet {\n          for line in report(\n            label,\n            verdict,\n            status,\n            o.checks_shown,\n            shown_cached,\n            console.paint(std.term.Output),\n            assumed_clauses,\n          ) {\n            print(line)\n          }\n        }\n        if t.law_of == None {\n          (accepted, broken) := rules_broken(\n            o.require,\n            rules,\n            module_of_check(raw, def),\n            label,\n            found,\n            verdict,\n            status,\n            contains(analysis.recursive, label),\n          )\n          if accepted {\n            mut trusted.push(\"`\" + label + \"`\")\n          }\n          violations += broken\n        }\n      },\n      None => if !o.quiet && !o.json {\n        print(\n          \"? \" + pad(label, 24) + \" not covered by compiler/smt yet\",\n        )\n      },\n    }\n  }\n  // each definition's status (its worst verdict), for the code as it is\n  for (def, w) in items(worst) {\n    write_status(\n      mut disk,\n      caches,\n      def_key(closures, impl_names, def),\n      w,\n    )\n  }\n  // what `build` may leave out: each check proven, for the code as it is\n  record_proofs(\n    mut disk,\n    caches,\n    file,\n    o.proofs_at,\n    set(targets.map(t -> def_name(t.def))),\n    closures,\n    impl_names,\n    proofs,\n  )\n  // (`--show-searches`: what every loop's search took; `verify` searches\n  // none)\n  for l in search_notes(found, o.budget, o.show_searches) {\n    mut console.eprint(l)\n  }\n  // (the whole program verified as it is now: `run` has nothing to verify\n  // alongside it)\n  if o.selection == \"\" {\n    record_verified(mut disk, caches, file)\n  }\n  if o.json {\n    print(driver.pretty_json(driver.JList(entries)))\n  } else if o.quiet {\n    match changed_line(fresh, fresh_proven, fresh_fuzzed, failed) {\n      Some(line) => if !o.silent {\n        mut console.eprint(line)\n      },\n      None => (),\n    }\n  } else {\n    for line in policy_lines(trusted, violations) {\n      print(line)\n    }\n  }\n  if ok && violations == [] {\n    0\n  } else {\n    1\n  }\n}"},{"name":"find_invariants","kind":"fn","old":"bf21c8c112a8712d","new":"5b3f9a051d875a1f","interface_changed":false,"affected":[],"module":"","text":"/// `verify --find-invariants BY`: the functions of `targets` with loops,\n/// their checks proven with their loops' derived invariants (and those\n/// written) and, where one fails after a loop, proven again with a search\n/// for more (`solved_together` with `methods.search` 2); also what the\n/// termination analysis's searches found for a loop not shown to end\n/// (`analysis.found_loops`), where they show the loop ends. What is found\n/// is written into the code (`write_found`, by `by`, `logged`) where the\n/// function's written invariants are proven without a search, as `verify`\n/// will prove them (else a note says so), the fewest that prove as much\n/// (`written_score`); the checks still not proven in a\n/// function searched are said, as warnings. Whether anything was written.\nfn find_invariants(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  file: String,\n  raw: List[ast.Decl],\n  core: builtins.Core,\n  ctx: termination.Ctx,\n  methods: smt.Methods,\n  analysis: termination.Analysis,\n  targets: List[Check],\n  by: String,\n  budget: Int,\n  show_searches: Bool,\n  logged: Bool,\n) -> Bool {\n  looping := targets.filter(\n    t -> t.assumed == \"\"\n      && solver_checks(t)\n      && match t.decl {\n        Some(f) => has_loop(f.body),\n        None => false,\n      },\n  )\n  mut found: List[(Check, List[smt.LoopFound])] = []\n  mut still := []\n  mut at := 0\n  while at < len(looping)\n    invariant at >= 0 {\n    chunk := looping[at..min(len(looping), at + solved_chunk())]\n    at += solved_chunk()\n    timings.begin(\"verify: search: solve\")\n    solved := solved_together(mut launcher, mut disk, ctx, methods, chunk)\n    timings.end(\"verify: search: solve\")\n    for t in chunk {\n      match get(solved, t.label) {\n        Some((vc, answers)) => {\n          searched := vc.found_loops.filter(l -> l.searched)\n          // (what termination's searches found for its loops, encoded\n          // apart: only when they show the loops end)\n          ends := match get(analysis.status, t.label) {\n            Some(termination.Proven(_)) => true,\n            _ => false,\n          }\n          ended := if ends {\n            (get(analysis.found_loops, t.label) ?? []).filter(\n              l -> l.searched && !searched.any(x -> x.at == l.at),\n            )\n          } else {\n            []\n          }\n          if searched != [] || ended != [] {\n            mut found.push((t, searched + ended))\n          }\n          if searched != [] {\n            for a in answers {\n              if a.outcome != \"proven\" {\n                mut still.push(\n                  \"warning: in `\"\n                    + t.label\n                    + \"`: not proven: \"\n                    + a.what,\n                )\n              }\n            }\n          }\n        },\n        None => (),\n      }\n    }\n  }\n  for l in search_notes(found, budget, show_searches) {\n    mut console.eprint(l)\n  }\n  // each function's invariants written as they would be, and proven so\n  // without a search, as `verify` will (else not written); the fewest of\n  // them: each left out while the function fares as well without it\n  mut proven_found: List[(Check, List[smt.LoopFound])] = []\n  for (t, loops) in found {\n    picks := loops.filter(l -> found_by_search(l) && l.code != [])\n    match t.decl {\n      Some(vf) => if picks != [] {\n        match written_score(\n          mut launcher,\n          mut disk,\n          ctx,\n          methods,\n          vf,\n          t.label,\n          picks,\n        ) {\n          Some(best) => {\n            mut kept := picks\n            mut tries := 0\n            for l in picks {\n              for c in l.code {\n                if tries < 8 {\n                  tries += 1\n                  fewer := kept\n                    .map(x -> if x.at == l.at {\n                      without_code(x, c)\n                    } else {\n                      x\n                    })\n                    .filter(x -> x.code != [])\n                  if fewer != [] {\n                    match written_score(\n                      mut launcher,\n                      mut disk,\n                      ctx,\n                      methods,\n                      vf,\n                      t.label,\n                      fewer,\n                    ) {\n                      Some(n) => if n <= best {\n                        kept = fewer\n                      },\n                      None => (),\n                    }\n                  }\n                }\n              }\n            }\n            mut proven_found.push((t, kept))\n          },\n          None => mut console.eprint(\n            \"note: in `\"\n              + t.shown\n              + \"`: the invariants found aren't proven once written: not written\",\n          ),\n        }\n      },\n      None => (),\n    }\n  }\n  before := proven_found != []\n  if before {\n    write_found(\n      mut console,\n      mut launcher,\n      mut disk,\n      file,\n      raw,\n      core,\n      proven_found,\n      logged,\n      by,\n    )\n  }\n  for w in still {\n    mut console.eprint(w)\n  }\n  before\n}","old_text":"/// `verify --find-invariants BY`: the functions of `targets` with loops,\n/// their checks proven with their loops' derived invariants (and those\n/// written) and, where one fails after a loop, proven again with a search\n/// for more (`solved_together` with `methods.search` 2); also what the\n/// termination analysis's searches found for a loop not shown to end\n/// (`analysis.found_loops`), where they show the loop ends. What is found\n/// is written into the code (`write_found`, by `by`, `logged`) where the\n/// function's written invariants are proven without a search, as `verify`\n/// will prove them (else a note says so), the fewest that prove as much\n/// (`written_score`); the checks still not proven in a\n/// function searched are said, as warnings. Whether anything was written.\nfn find_invariants(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  file: String,\n  raw: List[ast.Decl],\n  core: builtins.Core,\n  ctx: termination.Ctx,\n  methods: smt.Methods,\n  analysis: termination.Analysis,\n  targets: List[Check],\n  by: String,\n  budget: Int,\n  show_searches: Bool,\n  logged: Bool,\n) -> Bool {\n  looping := targets.filter(\n    t -> t.assumed == \"\"\n      && solver_checks(t)\n      && match t.decl {\n        Some(f) => has_loop(f.body),\n        None => false,\n      },\n  )\n  mut found: List[(Check, List[smt.LoopFound])] = []\n  mut still := []\n  mut at := 0\n  while at < len(looping)\n    invariant at >= 0 {\n    chunk := looping[at..min(len(looping), at + solved_chunk())]\n    at += solved_chunk()\n    solved := solved_together(mut launcher, mut disk, ctx, methods, chunk)\n    for t in chunk {\n      match get(solved, t.label) {\n        Some((vc, answers)) => {\n          searched := vc.found_loops.filter(l -> l.searched)\n          // (what termination's searches found for its loops, encoded\n          // apart: only when they show the loops end)\n          ends := match get(analysis.status, t.label) {\n            Some(termination.Proven(_)) => true,\n            _ => false,\n          }\n          ended := if ends {\n            (get(analysis.found_loops, t.label) ?? []).filter(\n              l -> l.searched && !searched.any(x -> x.at == l.at),\n            )\n          } else {\n            []\n          }\n          if searched != [] || ended != [] {\n            mut found.push((t, searched + ended))\n          }\n          if searched != [] {\n            for a in answers {\n              if a.outcome != \"proven\" {\n                mut still.push(\n                  \"warning: in `\"\n                    + t.label\n                    + \"`: not proven: \"\n                    + a.what,\n                )\n              }\n            }\n          }\n        },\n        None => (),\n      }\n    }\n  }\n  for l in search_notes(found, budget, show_searches) {\n    mut console.eprint(l)\n  }\n  // each function's invariants written as they would be, and proven so\n  // without a search, as `verify` will (else not written); the fewest of\n  // them: each left out while the function fares as well without it\n  mut proven_found: List[(Check, List[smt.LoopFound])] = []\n  for (t, loops) in found {\n    picks := loops.filter(l -> found_by_search(l) && l.code != [])\n    match t.decl {\n      Some(vf) => if picks != [] {\n        match written_score(\n          mut launcher,\n          mut disk,\n          ctx,\n          methods,\n          vf,\n          t.label,\n          picks,\n        ) {\n          Some(best) => {\n            mut kept := picks\n            mut tries := 0\n            for l in picks {\n              for c in l.code {\n                if tries < 8 {\n                  tries += 1\n                  fewer := kept\n                    .map(x -> if x.at == l.at {\n                      without_code(x, c)\n                    } else {\n                      x\n                    })\n                    .filter(x -> x.code != [])\n                  if fewer != [] {\n                    match written_score(\n                      mut launcher,\n                      mut disk,\n                      ctx,\n                      methods,\n                      vf,\n                      t.label,\n                      fewer,\n                    ) {\n                      Some(n) => if n <= best {\n                        kept = fewer\n                      },\n                      None => (),\n                    }\n                  }\n                }\n              }\n            }\n            mut proven_found.push((t, kept))\n          },\n          None => mut console.eprint(\n            \"note: in `\"\n              + t.shown\n              + \"`: the invariants found aren't proven once written: not written\",\n          ),\n        }\n      },\n      None => (),\n    }\n  }\n  before := proven_found != []\n  if before {\n    write_found(\n      mut console,\n      mut launcher,\n      mut disk,\n      file,\n      raw,\n      core,\n      proven_found,\n      logged,\n      by,\n    )\n  }\n  for w in still {\n    mut console.eprint(w)\n  }\n  before\n}"}]}
{"id":"8859baba864e9514","time":1795831984,"message":"edit: a package folder's edit checks what it can affect; an edit's invariant searches get a budget","changes":[{"name":"edit_file","kind":"fn","old":"7583bbf29ebc15d6","new":"4079cea99e8e2184","interface_changed":false,"affected":[],"module":"","text":"/// `strata --file F edit [MODULE]` (or `add`): a script, or a folder's\n/// module, changed outside any log (created if new). The result is checked\n/// (a package's folder in what the edit can affect, `edit_scope`, as\n/// `apply_edit` checks it), then written, each file in one step\n/// (`codebase.write_file`): what\n/// doesn't check is rejected with its errors and exit code 1, and no file\n/// changes (with `--as-given`, for a script written in steps: written all\n/// the same, with its errors and exit code 1). A module file of a package\n/// isn't checked alone. The functions changed that have loops then get the\n/// invariants\n/// a search finds, as `apply_edit` does.\nfn edit_file(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  f: String,\n  args: List[String],\n  cmd: String,\n) -> std.process.ExitCode {\n  a := edit_args(args) except e { return fail_with(mut console, e) }\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  core := read_core_at(disk, home)\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  is_dir := disk.is_dir(f) || ends_with(f, \"/\")\n  path := if ends_with(f, \"/\") {\n    byte_slice(f, 0, byte_len(f) - 1)\n  } else {\n    f\n  }\n  // a module file in a package is the module its path names\n  root := if is_dir {\n    None\n  } else {\n    codebase.find_root(disk, if codebase.parent(path) == \"\" {\n      \".\"\n    } else {\n      codebase.parent(path)\n    })\n  }\n  in_package := match root {\n    Some(r) => {\n      prefix := r + \"/\"\n      rel := if starts_with(path, prefix) {\n        byte_slice(path, byte_len(prefix), byte_len(path))\n      } else {\n        path\n      }\n      Some(deps.module_name(module_prefix(disk, r), rel))\n    },\n    None => None,\n  }\n  // core's folder: its modules by their names (`core.gen`), its files by\n  // theirs (`gen.strata`)\n  in_core := is_dir && disk.exists(path) && package_name(disk, path) == \"core\"\n  old := if !disk.exists(path) {\n    []\n  } else if is_dir {\n    read_package(disk, path, if in_core {\n      \"core\"\n    } else {\n      \"\"\n    }) except e { return fail_with(mut console, e) }\n  } else {\n    read_module(disk, path) except e {\n      return fail_with(mut console, e)\n    }\n  }\n  module := in_package or {\n    if in_core {\n      m := edit_module(a.module ?? \"\")\n      if starts_with(m, \"core.\") || m == \"\" {\n        m\n      } else {\n        \"core.\" + m\n      }\n    } else if is_dir {\n      edit_module(a.module ?? \"\")\n    } else {\n      match old {\n        [d, ..] => d.module,\n        [] => \"\",\n      }\n    }\n  }\n  // (`--rm NAME`: a qualified name, or a short one naming one definition)\n  given_removes := removed_names(old, module, a.removes) except e {\n    return fail_with(mut console, e)\n  }\n  text := if cmd == \"add\" {\n    disk.read(a.module ?? \"\") !! \"\"\n  } else {\n    piped_input(\n      mut console,\n      len(given_removes) > 0,\n      \"strata --file F edit\",\n    ) except e { return fail_with(mut console, e) }\n  }\n  parsed := parse.parse_module(text, module) except e {\n    return fail_with(mut console, f\"parse error at {e}\")\n  }\n  // (text read back from a view: the proof material it hid is put back)\n  edits := if a.proofs || cmd == \"add\" {\n    parsed\n  } else {\n    (kept, notes) := views.proofs_kept(resolve.written(old, std, core), parsed)\n    for n in notes {\n      mut console.eprint(\"warning: \" + n)\n    }\n    kept\n  }\n  match both_given_and_removed(edits, given_removes) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  // (a declaration given drops its stored derives that are no longer on its\n  // `derive A, B for` line)\n  dropped := codebase.dropped_derives(old, edits).filter(\n    q -> !contains(given_removes, q),\n  )\n  removes := given_removes + dropped\n  // (a package's other modules, for its references)\n  others := match root {\n    Some(r) => (read_package(disk, r, \"\") except e {\n      return fail_with(mut console, e)\n    }).filter(\n      d -> d.module != module,\n    ),\n    None => [],\n  }\n  // (core's files keep their names as written: core's names are global)\n  of_core := in_core\n    || match root {\n      Some(r) => package_name(disk, r) == \"core\",\n      None => false,\n    }\n  new := if of_core {\n    codebase.merge_parsed(old, edits, removes)\n  } else {\n    codebase.merge(old, edits, removes, std + others, core)\n  }\n  if new == old && disk.exists(path) {\n    // every definition given is as stored: nothing written or checked\n    mut console.print(\n      f\"{f}: no changes: every definition given is as stored (nothing written or checked)\",\n    )\n    return 0\n  }\n  // checked before anything is written: an edit that doesn't check\n  // leaves every file as it was (core checks only as the runtime's\n  // compilation does, `strata build-core`; a module file of a package\n  // isn't checked alone, its neighbours may not be written yet)\n  alone := !of_core\n    && in_package is None\n    && (is_dir || new.all(d -> d.module == \"\"))\n  // (a package's folder: what the edit can affect, as `strata edit` checks\n  // it, `edit_scope`)\n  package := alone\n    && is_dir\n    && disk.exists(path + \"/\" + codebase.manifest_file())\n  errors := if package {\n    before := package_bytes(disk, path)\n    o := Opened {\n      root: path,\n      name: package_name(disk, path),\n      decls: old,\n      std,\n      std_dir,\n      core,\n      open: None,\n    }\n    reach := timings.timed(\n      \"edit: scope\",\n      () -> edit_scope(old, new, before, false),\n    )\n    edit_errors(\n      mut launcher,\n      mut disk,\n      cache.caches_of(process),\n      o,\n      new,\n      reach,\n      before,\n    )\n  } else if alone {\n    lib := std_imports(disk, std_dir, new)\n    sh := shared_at(disk, cache.caches_of(process), home_of_std(std_dir))\n    // (`comptime e` compiled, as `check` runs it, with its budget of steps: a\n    // runaway one is an error instead of a hang)\n    std_use_check(\n        disk,\n        std_dir,\n        new,\n        use_errors_of(new, lib, Set[String] {}, core),\n      )\n      + warned(mut console, check_errors_with(\n        new,\n        lib,\n        core,\n        is_dir && package_reads_values(disk, path),\n        comptime_runner(disk, sh),\n      ))\n      + literal_errors_of(disk, new, lib, core, path, sh, [])\n  } else {\n    []\n  }\n  n := len(errors)\n  if n > 0 && !a.as_given {\n    mut console.eprint(\n      f\"rejected: {f} doesn't check ({n} error{plural(n, \"\", \"s\")}; nothing was written; `--as-given` writes it all the same):\",\n    )\n    for l in errors {\n      mut console.eprint(\"  \" + error_text(l))\n    }\n    return 1\n  }\n  if is_dir {\n    match codebase.write_modules(mut disk, path, old, new, false) {\n      Err(e) => return fail_with(mut console, e),\n      Ok(_) => (),\n    }\n  } else {\n    if codebase.parent(path) != \"\" {\n      mut disk.make_dir(codebase.parent(path)) !! ()\n    }\n    // (the definitions that didn't change keep their stored bytes)\n    bytes := codebase.module_bytes(\n      disk.read_bytes(path) !! [],\n      module,\n      new,\n      old,\n      others + new,\n      false,\n      Dict[String, ast.Key] {},\n    )\n    match codebase.write_file(mut disk, path, bytes) {\n      Err(e) => return fail_with(mut console, e),\n      Ok(_) => (),\n    }\n  }\n  cs := codebase.changes(old, new, false)\n  mut console.print(\n    f\"{f}: {len(cs)} definition{plural(len(cs), \"\", \"s\")} changed, {len(new)} in all\",\n  )\n  for q in dropped.filter(q -> !new.any(d -> store.qname(d) == q)) {\n    mut console.print(dropped_warning(q))\n  }\n  for w in edit_warnings(new, cs.map(c -> c.name), core) {\n    mut console.print(w)\n  }\n  if !of_core {\n    roots := unused_setting(disk, root ?? path).0\n    for w in edit_unused(\n      old + others,\n      new + others,\n      cs.map(c -> c.name),\n      core,\n      roots,\n    ) {\n      mut console.print(w.2)\n    }\n  }\n  if n > 0 {\n    mut console.eprint(\n      f\"written as given: {f} doesn't check ({n} error{plural(n, \"\", \"s\")}):\",\n    )\n    for l in errors {\n      mut console.eprint(\"  \" + error_text(l))\n    }\n    return 1\n  }\n  // the loops of the functions changed: invariants searched for where\n  // those derived from the code don't prove their checks, and written\n  looped := loop_functions(new, cs.map(c -> c.name))\n  if a.search && looped != [] && !of_core {\n    _ := search_invariants(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      cache.caches_of(process),\n      path,\n      looped,\n      \"edit\",\n      false,\n    )\n  }\n  0\n}","old_text":"/// `strata --file F edit [MODULE]` (or `add`): a script, or a folder's\n/// module, changed outside any log (created if new). The result is checked,\n/// then written, each file in one step (`codebase.write_file`): what\n/// doesn't check is rejected with its errors and exit code 1, and no file\n/// changes (with `--as-given`, for a script written in steps: written all\n/// the same, with its errors and exit code 1). A module file of a package\n/// isn't checked alone. The functions changed that have loops then get the\n/// invariants\n/// a search finds, as `apply_edit` does.\nfn edit_file(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Proces