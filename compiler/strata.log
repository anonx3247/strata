,"call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// What `--copies` calls a value of type `t`.\nfn copied_what(t: check.Ty) -> String {\n  match t {\n    check.TList(_) => \"List\",\n    check.TStr => \"String\",\n    check.TNamed { name, .. } => if name == \"Dict\" || name == \"Set\" {\n      name\n    } else {\n      \"`\" + codegen.short(name) + \"`\"\n    },\n    _ => codegen.key(t),\n  }\n}","old_text":"/// What `--copies` calls a value of type `t`.\nfn copied_what(t: Ty) -> String {\n  match t {\n    TList(_) => \"List\",\n    TStr => \"String\",\n    TNamed { name, .. } => if name == \"Dict\" || name == \"Set\" {\n      name\n    } else {\n      \"`\" + codegen.short(name) + \"`\"\n    },\n    _ => codegen.key(t),\n  }\n}"},{"name":"codegen.block_fields","kind":"fn","old":"5764bd0f2c74edc2","new":"8876ae0d4e65b60e","interface_changed":true,"affected":["codegen.set_field_in_place","codegen.assign_at","codegen.call_fn_want","codegen.method_call","codegen.dyn_call","codegen.stmt_node","codegen.call_named","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.expr_node","codegen.expr_want_node","codegen.stmt","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.builtin_call","codegen.dyn_wrapper","codegen.un