ne","eval.run","codegen.stmt_node","codegen.builtin_call","resolve.named_types","sync_command","check_files","diff.log_range","diff.git_range","history_command","revert_command","with_base","repl_std","merged_checks","fix_loops","std_proofs","check_errors_with","check.type_errors","eval_files","instantiated_files","computed_value","finding.uses_of","unused.members","smt_file","verified_with","core_unused","unused_of","edit_unused","check_fn","linked","codegen.stmt","codegen.call_named","codegen.method_call","codegen.matching_want","codegen.except_expr","tour.side_range","check_errors_of","comptime_value","finding.uses_from","finding.used_by_tree","verified_program","codegen.block_expr","codegen.decreases_start","codegen.decreases_pass","codegen.iterate","codegen.decreases_call","codegen.build_fn","codegen.decreases_entry","codegen.expr_node","codegen.expr_want_node","codegen.matching","comptime_values","finding.uses_tree","termination_file","codegen.for_list","codegen.call_fn_want","codegen.built_or_generated","codegen.function","codegen.expr","codegen.expr_want","comptime_runner","codegen.for_loop","codegen.call_fn","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.clock_now","codegen.options","codegen.fuzz_driver","codegen.main_arg","codegen.construct_want","codegen.operands_want","codegen.with_it","codegen.as_type","codegen.mock_method","codegen.produce","codegen.converted","codegen.destructure","codegen.matches","codegen.set_in_place","codegen.take_in_place","codegen.push_in_place","codegen.grow_in_place","codegen.assigned_call","codegen.checked","codegen.compared","codegen.loop_body","codegen.try_want","codegen.if_want","codegen.branch_value","codegen.expr_on_stack","codegen.binary","codegen.logic","codegen.tag_test","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.interp","codegen.call_entry","codegen.export_entry","codegen.check_requires","codegen.keep_olds","codegen.check_ensures","codegen.lambda_shown","codegen.declare","codegen.checked_update","codegen.appended","codegen.channel_new","codegen.dyn_call","codegen.wanted","codegen.list_literal_of","codegen.builtin_operator","codegen.match_got","codegen.scope_expr","codegen.list_get_or","codegen.or_else","codegen.shown","codegen.show","codegen.dyn_wrapper","codegen.cmp_helper","codegen.collection_builtin","codegen.builtin","codegen.host","codegen.string_builtin","codegen.real_op","codegen.dyn_generic_call","codegen.union_call","codegen.format_spec","codegen.construct","codegen.operands","codegen.check_type","codegen.holds_pred","codegen.tag_is","codegen.satisfies","codegen.equal","codegen.conversion","codegen.channel_op","codegen.compare_values","codegen.apply","codegen.vtable","codegen.mock_table","codegen.mock_call","codegen.gen_fn","codegen.table_find","codegen.list_builtin","codegen.binds","codegen.matching_v","codegen.invariants","codegen.assertion","codegen.try_expr","codegen.if_expr","codegen.get_field","codegen.lambda","codegen.function_value","codegen.list_literal","codegen.fail_unless","codegen.debug_list","codegen.union_text","codegen.debug_fields","codegen.index_check","codegen.grow_size_check","codegen.decreases_fault","codegen.trace_enter","codegen.trace_leave","codegen.slot_fn","codegen.cmp_fields","codegen.union_cmp","codegen.order_closure","codegen.gen_list","codegen.session_capability","codegen.check_payload","codegen.assign_at","codegen.check_field","codegen.check_union","codegen.check_member","codegen.dyn_ctor_is","codegen.has_field_check","codegen.to_c","codegen.gen_data","codegen.eq_list","codegen.union_eq","codegen.eq_fields","codegen.number_builtin","codegen.held_apply","codegen.dyn_table_is","codegen.to_dyn","codegen.mock_value","codegen.generated","codegen.can_generate","codegen.method_value","codegen.spawn_expr","codegen.helper","codegen.debug_body","codegen.table_fns","codegen.hash_helper","codegen.session_entry","codegen.foreign_call","codegen.eq_body","codegen.generated_args","codegen.makers","codegen.table_from","codegen.hash_fields"],"module":"resolve","text":"/// The state of walking one definition. `visible` maps what its module can\n/// name, short to qualified. `locals` and `tparams` are the scopes in force.\ntype Rw = {\n  visible: Dict[String, String],\n  modules: Set[String],\n  methods: Set[String],\n  locals: List[Set[String]],\n  tparams: List[Set[String]],\n  // write names back shortened (the written form) instead of qualifying them\n  shorten: Bool,\n  table: Dict[String, resolve.Item],\n  // the unions types are named after when writing; the definition's module;\n  // its own type, qualified\n  unions: resolve.Unions,\n  module: String,\n  own: String,\n  // the modules this one `use`s, and the errors found (when resolving only)\n  imports: List[String],\n  // `use m` bindings (`time` for `use std.time`) to the module's path, and\n  // each `use`'s path with whether it is the whole module (`use m`)\n  bindings: Dict[String, String],\n  uses: List[(String, Bool)],\n  found: List[String],\n  // the definition may use mocks: a test, a mock, or an impl for one\n  for_tests: Bool,\n  // relocating a dependency's definition (`relocated`): its package's name\n  // and modules as the package names them, and whether to collect the\n  // global names met into `names`\n  relocate: String,\n  own_modules: List[String],\n  collect: Bool,\n  names: List[String],\n  // the parameters of functions and methods, when writing (`spread_params_of`)\n  params: Dict[String, List[String]] = Dict[String, List[String]] {},\n  // core's built-in functions, by name\n  builtins: Set[String] = Set[String] {},\n}","old_text":"/// The state of walking one definition. `visible` maps what its module can\n/// name, short to qualified. `locals` and `tparams` are the scopes in force.\ntype Rw = {\n  visible: Dict[String, String],\n  modules: Set[String],\n  methods: Set[String],\n  locals: List[Set[String]],\n  tparams: List[Set[String]],\n  // write names back shortened (the written form) instead of qualifying them\n  shorten: Bool,\n  table: Dict[String, resolve.Item],\n  // the unions types are named after when writing; the definition's module;\n  // its own type, qualified\n  unions: resolve.Unions,\n  module: String,\n  own: String,\n  // the modules this one `use`s, and the errors found (when resolving only)\n  imports: List[String],\n  // `use m` bindings (`time` for `use std.time`) to the module's path, and\n  // each `use`'s path with whether it is the whole module (`use m`)\n  bindings: Dict[String, String],\n  uses: List[(String, Bool)],\n  found: List[String],\n  // the definition may use mocks: a test, a mock, or an impl for one\n  for_tests: Bool,\n  // relocating a dependency's definition (`relocated`): its package's name\n  // and modules as the package names them, and whether to collect the\n  // global names met into `names`\n  relocate: String,\n  own_modules: List[String],\n  collect: Bool,\n  names: List[String],\n  // the parameters of functions and methods, when writing (`spread_params_of`)\n  params: Dict[String, List[String]] = Dict[String, List[String]] {},\n}"},{"name":"resolve.walk","kind":"fn","old":"6b23cdf799535e2c","new":"fc6f4ea8ad2e231d","interface_changed":false,"affected":[],"module":"resolve","text":"/// The definitions of `decls` at the places `pick` takes, resolved (stored,\n/// or written when\n/// `shorten`) with all of `given` and `std` in scope, and the errors found.\nfn walk(\n  given: List[ast.Decl],\n  pick: (Int) -> Bool,\n  std: List[ast.Decl],\n  core: builtins.Core,\n  shorten: Bool,\n) -> (List[ast.Decl], List[(String, String)]) {\n  decls := resolve.union_members(given, core)\n  all := decls + std\n  unions := if shorten {\n    resolve.unions_of(decls)\n  } else {\n    resolve.no_unions()\n  }\n  params := resolve.spread_params_of(all)\n  n := resolve.names_of(all)\n  builtins := set(builtins.builtin_names(core))\n  mut scopes := Dict[String, Dict[String, String]] {}\n  // each module's imports, worked out once\n  mut imports := Dict[String, List[String]] {}\n  mut bindings := Dict[String, Dict[String, String]] {}\n  mut uses := Dict[String, List[(String, Bool)]] {}\n  mut out := []\n  mut found := []\n  for (k, given_d) in enumerate(decls) {\n    if !pick(k) {\n      continue\n    }\n    // what is stored written out, as written\n    // (a stored `extern python` function is resolved as declared, so its\n    // body's calls of std.python's private functions are not refused)\n    d := if shorten {\n      sugar.results_raised(sugar.python_raised(given_d))\n    } else {\n      sugar.python_raised(given_d)\n    }\n    if !contains(scopes, d.module) {\n      mut scopes.insert(d.module, resolve.scope_of(n, all, d.module))\n      mut imports.insert(d.module, resolve.imports_of(decls, d.module))\n      mut bindings.insert(\n        d.module,\n        resolve.bindings_of(decls, d.module),\n      )\n      mut uses.insert(d.module, resolve.uses_of(decls, d.module))\n    }\n    mut r := resolve.Rw {\n      visible: get(scopes, d.module) or {\n        Dict[String, String] {}\n      },\n      modules: n.modules,\n      methods: n.methods,\n      locals: [],\n      tparams: [],\n      shorten,\n      table: n.table,\n      unions,\n      module: d.module,\n      own: match d.kind {\n        ast.TypeDef(t) => resolve.qual(d, t.name),\n        _ => \"\",\n      },\n      imports: get(imports, d.module) ?? [],\n      bindings: get(bindings, d.module) or {\n        Dict[String, String] {}\n      },\n      uses: get(uses, d.module) ?? [],\n      found: [],\n      relocate: \"\",\n      own_modules: [],\n      collect: false,\n      names: [],\n      params,\n      builtins,\n      for_tests: match d.kind {\n        ast.TestDef(_) => true,\n        ast.TypeDef(t) => t.mocked,\n        ast.ImplDef(i) => {\n          head := resolve.type_head(i.for_type)\n          own_scope := get(scopes, d.module) or {\n            Dict[String, String] {}\n          }\n          q := get(own_scope, head) or {\n            if contains(head, \".\") {\n              head\n            } else {\n              resolve.qualified(d.module, head)\n            }\n          }\n          match get(n.table, q) {\n            Some(it) => it.fake,\n            None => false,\n          }\n        },\n        _ => false,\n      },\n    }\n    mut out.push(\n      ast.Decl { ..d, kind: resolve.decl_kind(mut r, d.kind) },\n    )\n    for e in r.found {\n      mut found.push((resolve.decl_name(d), e))\n    }\n  }\n  if shorten {\n    return (out, found)\n  }\n  // what needs the declarations, lowered once the names are qualified:\n  // key paths, and calls spreading records written out (a call whose\n  // spread is in error is stored as written, for the checker to report)\n  unpicked := [d for (k, d) in enumerate(decls) where !pick(k)]\n  rest := out + unpicked + std\n  rs := desugar.records_of(rest)\n  (out.map(\n    d -> {\n      l := sugar.results_lowered(sugar.python_lowered(walk.decl_parts(\n        d,\n        x -> resolve.lowered(rs, x),\n        t -> resolve.lowered_type(rs, t),\n      )))\n      // (only a definition with a spread: `check.spreads_resolved` also\n      // writes an operator on a type of the program's own as its method's\n      // call, which is not stored)\n      if !resolve.has_spread(l) {\n        l\n      } else {\n        match check.spreads_resolved([l], rest, core) {\n          ([x], []) => resolve.spread_renamed(x),\n          // types not known here (a module stored alone): read back by name;\n          // a spread in error is kept, for `check` to report\n          // (also a spread in a method, which the checker doesn't write out:\n          // read back by name when that leaves no spread)\n          (_, es) => {\n            y := resolve.spreads_by_name(l, params)\n            if es.all(\n              m -> contains(m.1, \"isn't known here\")\n                || contains(m.1, \"can't be used here\")\n                  && !resolve.has_spread(y),\n            ) {\n              y\n            } else {\n              l\n            }\n          },\n        }\n      }\n    },\n  ), found)\n}","old_text":"/// The definitions of `decls` at the places `pick` takes, resolved (stored,\n/// or written when\n/// `shorten`) with all of `given` and `std` in scope, and the errors found.\nfn walk(\n  given: List[ast.Decl],\n  pick: (Int) -> Bool,\n  std: List[ast.Decl],\n  core: builtins.Core,\n  shorten: Bool,\n) -> (List[ast.Decl], List[(String, String)]) {\n  decls := resolve.union_members(given, core)\n  all := decls + std\n  unions := if shorten {\n    resolve.unions_of(decls)\n  } else {\n    resolve.no_unions()\n  }\n  params := resolve.spread_params_of(all)\n  n := resolve.names_of(all)\n  mut scopes := Dict[String, Dict[String, String]] {}\n  // each module's imports, worked out once\n  mut imports := Dict[String, List[String]] {}\n  mut bindings := Dict[String, Dict[String, String]] {}\n  mut uses := Dict[String, List[(String, Bool)]] {}\n  mut out := []\n  mut found := []\n  for (k, given_d) in enumerate(decls) {\n    if !pick(k) {\n      continue\n    }\n    // what is stored written out, as written\n    // (a stored `extern python` function is resolved as declared, so its\n    // body's calls of std.python's private functions are not refused)\n    d := if shorten {\n      sugar.results_raised(sugar.python_raised(given_d))\n    } else {\n      sugar.python_raised(given_d)\n    }\n    if !contains(scopes, d.module) {\n      mut scopes.insert(d.module, resolve.scope_of(n, all, d.module))\n      mut imports.insert(d.module, resolve.imports_of(decls, d.module))\n      mut bindings.insert(\n        d.module,\n        resolve.bindings_of(decls, d.module),\n      )\n      mut uses.insert(d.module, resolve.uses_of(decls, d.module))\n    }\n    mut r := resolve.Rw {\n      visible: get(scopes, d.module) or {\n        Dict[String, String] {}\n      },\n      modules: n.modules,\n      methods: n.methods,\n      locals: [],\n      tparams: [],\n      shorten,\n      table: n.table,\n      unions,\n      module: d.module,\n      own: match d.kind {\n        ast.TypeDef(t) => resolve.qual(d, t.name),\n        _ => \"\",\n      },\n      imports: get(imports, d.module) ?? [],\n      bindings: get(bindings, d.module) or {\n        Dict[String, String] {}\n      },\n      uses: get(uses, d.module) ?? [],\n      found: [],\n      relocate: \"\",\n      own_modules: [],\n      collect: false,\n      names: [],\n      params,\n      for_tests: match d.kind {\n        ast.TestDef(_) => true,\n        ast.TypeDef(t) => t.mocked,\n        ast.ImplDef(i) => {\n          head := resolve.type_head(i.for_type)\n          own_scope := get(scopes, d.module) or {\n            Dict[String, String] {}\n          }\n          q := get(own_scope, head) or {\n            if contains(head, \".\") {\n              head\n            } else {\n              resolve.qualified(d.module, head)\n            }\n          }\n          match get(n.table, q) {\n            Some(it) => it.fake,\n            None => false,\n          }\n        },\n        _ => false,\n      },\n    }\n    mut out.push(\n      ast.Decl { ..d, kind: resolve.decl_kind(mut r, d.kind) },\n    )\n    for e in r.found {\n      mut found.push((resolve.decl_name(d), e))\n    }\n  }\n  if shorten {\n    return (out, found)\n  }\n  // what needs the declarations, lowered once the names are qualified:\n  // key paths, and calls spreading records written out (a call whose\n  // spread is in error is stored as written, for the checker to report)\n  unpicked := [d for (k, d) in enumerate(decls) where !pick(k)]\n  rest := out + unpicked + std\n  rs := desugar.records_of(rest)\n  (out.map(\n    d -> {\n      l := sugar.results_lowered(sugar.python_lowered(walk.decl_parts(\n        d,\n        x -> resolve.lowered(rs, x),\n        t -> resolve.lowered_type(rs, t),\n      )))\n      // (only a definition with a spread: `check.spreads_resolved` also\n      // writes an operator on a type of the program's own as its method's\n      // call, which is not stored)\n      if !resolve.has_spread(l) {\n        l\n      } else {\n        match check.spreads_resolved([l], rest, core) {\n          ([x], []) => resolve.spread_renamed(x),\n          // types not known here (a module stored alone): read back by name;\n          // a spread in error is kept, for `check` to report\n          // (also a spread in a method, which the checker doesn't write out:\n          // read back by name when that leaves no spread)\n          (_, es) => {\n            y := resolve.spreads_by_name(l, params)\n            if es.all(\n              m -> contains(m.1, \"isn't known here\")\n                || contains(m.1, \"can't be used here\")\n                  && !resolve.has_spread(y),\n            ) {\n              y\n            } else {\n              l\n            }\n          },\n        }\n      }\n    },\n  ), found)\n}"},{"name":"resolve.check_name","kind":"fn","old":"1099f011e025d9cd","new":"1706284109989573","interface_changed":false,"affected":[],"module":"resolve","text":"/// The errors of a name the module's scope doesn't give: a private\n/// definition of a module it imports or of any module, or one of std's host\n/// built-ins used outside std.\nfn check_name(mut r: resolve.Rw, n: String) {\n  match get(r.table, n) {\n    Some(it) => if !resolve.covers(r, it.module) {\n      m := it.module\n      short := byte_slice(n, byte_len(m) + 1, byte_len(n))\n      parts := split(m, \".\")\n      mut r.found.push(\n        \"`\"\n          + n\n          + \"` is in module `\"\n          + m\n          + \"`, which this module doesn't use: add `use \"\n          + m\n          + \"` (then write `\"\n          + (get(parts, len(parts) - 1) ?? m)\n          + \".\"\n          + short\n          + \"`) or `from \"\n          + m\n          + \" use \"\n          + short\n          + \"`\",\n      )\n    },\n    None => (),\n  }\n  if !contains(n, \".\") && !contains(r.builtins, n) {\n    for m in r.imports {\n      match get(r.table, resolve.qualified(m, n)) {\n        Some(it) => if !it.public {\n          mut r.found.push(\n            \"`\"\n              + n\n              + \"` is private to module `\"\n              + m\n              + \"` \"\n              + resolve.private_note(),\n          )\n          return\n        },\n        None => (),\n      }\n    }\n  }\n  match get(r.table, n) {\n    Some(it) => {\n      visible := it.public\n        || it.module == r.module\n        || starts_with(r.module, it.module + \".\")\n      if !visible {\n        mut r.found.push(\n          \"`\"\n            + n\n            + \"` is private to module `\"\n            + it.module\n            + \"` \"\n            + resolve.private_note(),\n        )\n      } else if it.fake {\n        resolve.test_only(mut r, n)\n      } else if it.foreign && it.module != r.module {\n        // a foreign function is called only from its own module, which turns\n        // it into a capability for the rest of the program\n        m := if it.module == \"\" {\n          \"main\"\n        } else {\n          it.module\n        }\n        mut r.found.push(\n          \"`\"\n            + n\n            + \"` is a foreign function: only module `\"\n            + m\n            + \"` can call it (give the rest of the program a capability from `\"\n            + m\n            + \"` instead)\",\n        )\n      }\n    },\n    None => (),\n  }\n  if starts_with(n, \"host_\")\n    && !(r.module == \"std\" || starts_with(r.module, \"std.\")) {\n    mut r.found.push(\n      \"`\"\n        + n\n        + \"` is internal to the standard library: take a capability instead (`Console` from `std.io`, `Files` from `std.fs`, `Environment` from `std.process`)\",\n    )\n  }\n}","old_text":"/// The errors of a name the module's scope doesn't give: a private\n/// definition of a module it imports or of any module, or one of std's host\n/// built-ins used outside std.\nfn check_name(mut r: resolve.Rw, n: String) {\n  match get(r.table, n) {\n    Some(it) => if !resolve.covers(r, it.module) {\n      m := it.module\n      short := byte_slice(n, byte_len(m) + 1, byte_len(n))\n      parts := split(m, \".\")\n      mut r.found.push(\n        \"`\"\n          + n\n          + \"` is in module `\"\n          + m\n          + \"`, which this module doesn't use: add `use \"\n          + m\n          + \"` (then write `\"\n          + (get(parts, len(parts) - 1) ?? m)\n          + \".\"\n          + short\n          + \"`) or `from \"\n          + m\n          + \" use \"\n          + short\n          + \"`\",\n      )\n    },\n    None => (),\n  }\n  if !contains(n, \".\") {\n    for m in r.imports {\n      match get(r.table, resolve.qualified(m, n)) {\n        Some(it) => if !it.public {\n          mut r.found.push(\n            \"`\"\n              + n\n              + \"` is private to module `\"\n              + m\n              + \"` \"\n              + resolve.private_note(),\n          )\n          return\n        },\n        None => (),\n      }\n    }\n  }\n  match get(r.table, n) {\n    Some(it) => {\n      visible := it.public\n        || it.module == r.module\n        || starts_with(r.module, it.module + \".\")\n      if !visible {\n        mut r.found.push(\n          \"`\"\n            + n\n            + \"` is private to module `\"\n            + it.module\n            + \"` \"\n            + resolve.private_note(),\n        )\n      } else if it.fake {\n        resolve.test_only(mut r, n)\n      } else if it.foreign && it.module != r.module {\n        // a foreign function is called only from its own module, which turns\n        // it into a capability for the rest of the program\n        m := if it.module == \"\" {\n          \"main\"\n        } else {\n          it.module\n        }\n        mut r.found.push(\n          \"`\"\n            + n\n            + \"` is a foreign function: only module `\"\n            + m\n            + \"` can call it (give the rest of the program a capability from `\"\n            + m\n            + \"` instead)\",\n        )\n      }\n    },\n    None => (),\n  }\n  if starts_with(n, \"host_\")\n    && !(r.module == \"std\" || starts_with(r.module, \"std.\")) {\n    mut r.found.push(\n      \"`\"\n        + n\n        + \"` is internal to the standard library: take a capability instead (`Console` from `std.io`, `Files` from `std.fs`, `Environment` from `std.process`)\",\n    )\n  }\n}"}]}
