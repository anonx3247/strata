ssion_entry","codegen.foreign_call","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.generated_args","codegen.makers","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// Function `f` (key `k`) specialised for its arguments' types `tys`. Each\n/// trait-typed parameter given a value of known type becomes its own type\n/// parameter (`impl.N`). The function is then compiled for that type and\n/// calls its methods directly, keeping their `mut self` changes. Returns\n/// `f` itself when no parameter qualifies.\nfn for_impls(\n  mut g: codegen.Gen,\n  k: String,\n  f: ast.FnDecl,\n  pts: List[check.Ty],\n  tys: List[check.Ty],\n) -> (String, ast.FnDecl) {\n  mut spec := []\n  for (i, t) in enumerate(tys) {\n    if get(pts, i) ?? check.TAny is check.TTrait\n      && !(t is check.TTrait)\n      && !(t is check.TAny) {\n      mut spec.push(i)\n    }\n  }\n  if len(spec) == 0 {\n    return (k, f)\n  }\n  k2 := k + \"$\" + join(spec.map(i -> to_string(i)), \",\")\n  if !codegen.has_fn(g, k2) {\n    mut ps := []\n    for (i, p) in enumerate(f.params) {\n      mut ps.push(\n        if contains(spec, i) {\n          ast.Param { ..p, ty: ast.Named { name: \"impl.\" + to_string(i), args: [] } }\n        } else {\n          p\n        },\n      )\n    }\n    // each new type parameter is bounded by the parameter's trait, so its\n    // methods resolve to the trait's\n    codegen.put_fn(\n      mut g,\n      k2,\n      ast.FnDecl { ..f, type_params: f.type_params + spec.map(i -> \"impl.\" + to_string(i)), bounds: f.bounds\n        + spec.map(\n          i -> ast.Bound {\n            param: \"impl.\" + to_string(i),\n            traits: [(get(f.params, i) or {\n              ast.Param {\n                name: \"\",\n                ty: ast.UnitType,\n                mutable: false,\n                compile_time: false,\n              }\n            }).ty],\n          },\n        ), params: ps },\n    )\n  }\n  (k2, codegen.fn_of(g, k2) ?? f)\n}","old_text":"/// Function `f` (key `k`) specialised for its arguments' types `tys`. Each\n/// trait-typed parameter given a value of known type becomes its own type\n/// parameter (`impl.N`). The function is then compiled for that type and\n/// calls its methods directly, keeping their `mut self` changes. Returns\n/// `f` itself when no parameter qualifies.\nfn for_impls(\n  mut g: codegen.Gen,\n  k: String,\n  f: ast.FnDecl,\n  pts: List[Ty],\n  tys: List[Ty],\n) -> (String, ast.FnDecl) {\n  mut spec := []\n  for (i, t) in enumerate(tys) {\n    if get(pts, i) ?? TAny is TTrait && !(t is TTrait) && !(t is TAny) {\n      mut spec.push(i)\n    }\n  }\n  if len(spec) == 0 {\n    return (k, f)\n  }\n  k2 := k + \"$\" + join(spec.map(i -> to_string(i)), \",\")\n  if !codegen.has_fn(g, k2) {\n    mut ps := []\n    for (i, p) in enumerate(f.params) {\n      mut ps.push(\n        if contains(spec, i) {\n          ast.Param { ..p, ty: ast.Named { name: \"impl.\" + to_string(i), args: [] } }\n        } else {\n          p\n        },\n      )\n    }\n    // each new type parameter is bounded by the parameter's trait, so its\n    // methods resolve to the trait's\n    codegen.put_fn(\n      mut g,\n      k2,\n      ast.FnDecl { ..f, type_params: f.type_params + spec.map(i -> \"impl.\" + to_string(i)), bounds: f.bounds\n        + spec.map(\n          i -> ast.Bound {\n            param: \"impl.\" + to_string(i),\n            traits: [(get(f.params, i) or {\n              ast.Param {\n                name: \"\",\n                ty: ast.UnitType,\n                mutable: false,\n                compile_time: false,\n              }\n            }).ty],\n          },\n        ), params: ps },\n    )\n  }\n  (k2, codegen.fn_of(g, k2) ?? f)\n}"},{"name":"codegen.unwound_exit","kind":"fn","old":"a4ddd058982f0056","new":"5b16ccbb91cb933d","interface_changed":true,"affected":["codegen.function","codegen.lambda_shown","codegen.compiled_alone","codegen.function_value","codegen.lambda","codegen.generate","codegen.expr_want_node","codegen.spawn_expr","codegen.produce","codegen.method_value","codegen.expr_node","codegen_with","core_rt_text","computed_value","repl_eval","codegen.expr_want","codegen.race_expr","codegen.gen_fn","codegen.expr","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.binary","codegen.declare","codegen.destructure","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.method_call","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.try_want","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.compared","codegen.stmt_node","codegen.build_fn","codegen.push_in_place","codegen.generated","codegen.can_generate","codegen.call_named","codegen.interp","codegen.logic","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.except_expr