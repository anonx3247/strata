 V)`.\nfn entry_ty(t: check.Ty) -> check.Ty {\n  match t {\n    check.TNamed { name: \"Set\", args: [a] } => a,\n    check.TNamed { name: \"Dict\", args: [k, v] } => check.TNamed { name: \"Tuple\", args: [k, v] },\n    _ => check.TAny,\n  }\n}","old_text":"/// A table's entry type: a set's element, a dict's `(K, V)`.\nfn entry_ty(t: Ty) -> Ty {\n  match t {\n    TNamed { name: \"Set\", args: [a] } => a,\n    TNamed { name: \"Dict\", args: [k, v] } => TNamed { name: \"Tuple\", args: [k, v] },\n    _ => TAny,\n  }\n}"},{"name":"codegen.list_view","kind":"fn","old":"7b2e5058be27ab38","new":"a48c0e2a22b7e7d8","interface_changed":false,"affected":[],"module":"codegen","text":"/// A set's or dict's entries as a list borrowed from it, in table order.\n/// Any other value is itself.\nfn list_view(mut g: codegen.Gen, v: codegen.V) -> codegen.V {\n  if codegen.is_collection(v.ty) {\n    codegen.field(\n      mut g,\n      codegen.V { ..v, ty: codegen.repr(v.ty) },\n      0,\n      check.TList(codegen.entry_ty(v.ty)),\n    )\n  } else {\n    v\n  }\n}","old_text":"/// A set's or dict's entries as a list borrowed from it, in table order.\n/// Any other value is itself.\nfn list_view(mut g: codegen.Gen, v: codegen.V) -> codegen.V {\n  if codegen.is_collection(v.ty) {\n    codegen.field(\n      mut g,\n      codegen.V { ..v, ty: codegen.repr(v.ty) },\n      0,\n      TList(codegen.entry_ty(v.ty)),\n    )\n  } else {\n    v\n  }\n}"},{"name":"codegen.table_fns","kind":"fn","old":"756b6226d92dfdf9","new":"9fcae0648975cdc5","interface_changed":true,"affected":["codegen.equal","codegen.collection_builtin","codegen.update_in_place","codegen.table_from","codegen.apply","codegen.eq_fields","codegen.matches","codegen.eq_list","codegen.dyn_wrapper","codegen.union_eq","codegen.slot_fn","codegen.builtin","codegen.gen_list","codegen.converted","codegen.builtin_call","codegen.stmt_node","codegen.binary","codegen.number_builtin","codegen.checked","codegen.eq_body","codegen.destructure","codege