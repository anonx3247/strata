mand","graph_diff","linked","expanded","comptime_runner","codegen.equal","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.read_back","eval_files","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// A block's statements, then its last expression with `want`.\nfn block_expr(\n  mut g: codegen.Gen,\n  stmts: List[ast.Stmt],\n  last: ast.Expr,\n  want: check.Ty,\n) -> codegen.V {\n  // (in result position: its last expression is)\n  rp := g.result_pos\n  g.result_pos = false\n  codegen.push_scope(mut g)\n  // (`--memory-sites`: the statement each expression is in, for its root)\n  outer_stmt := g.root_stmt\n  for (i, st) in enumerate(stmts) {\n    // `x := C { … }` or `x := f(…)` with `x` not leaving the block: on the\n    // stack\n    stacked := codegen.stack_let(mut g, stmts, i, last)\n    codegen.push_transparent(mut g)\n    is_call := match st {\n      ast.Let { value, .. } => codegen.call_like(g, value),\n      _ => false,\n    }\n    g.stack_next = stacked != \"\" && !is_call\n    g.stack_call = stacked != \"\" && is_call\n    g.stack_made = []\n    if g.memory_sites {\n      codegen.site_marker(mut g, codegen.stmt_value(st))\n      g.root_stmt = roots.text_key(text.expr_text(codegen.stmt_value(st), 0))\n    }\n    codegen.stmt(mut g, st)\n    g.stack_next = false\n    g.stack_call = false\n    if stacked != \"\" && g.stack_made != [] {\n      match codegen.lookup(g, stacked) {\n        Some(l) => {\n          codegen.mark_stacked(mut g, l.slot, g.stack_made)\n          // (the variable holds the block now: a temporary reading it is\n          // not what holds the block, and drops nothing)\n          mut g.stack_ops.remove(l.op)\n        },\n        None => (),\n      }\n    }\n    g.stack_made = []\n    codegen.pop_scope(mut g)\n  }\n  if g.memory_sites && !(last is ast.UnitExpr) {\n    codegen.site_marker(mut g, last)\n  }\n  if g.memory_sites {\n    g.root_stmt = roots.text_key(text.expr_text(last, 0))\n    codegen.root_stmt_code(mut g, ast.ExprStmt(last))\n  }\n  g.result_pos = rp\n  v := codegen.expr_want(mut g, last, want)\n  g.result_pos = false\n  x := codegen.leave_branch(mut g, v)\n  g.root_stmt = outer_stmt\n  codegen.temp(mut g, x)\n}","old_text":"/// A block's statements, then its last expression with `want`.\nfn block_expr(\n  mut g: codegen.Gen,\n  stmts: List[ast.Stmt],\n  last: ast.Expr,\n  want: Ty,\n) -> codegen.V {\n  // (in result position: its last expression is)\n  rp := g.result_pos\n  g.result_pos = false\n  codegen.push_scope(mut g)\n  // (`--memory-sites`: the statement each expression is in, for its root)\n  outer_stmt := g.root_stmt\n  for (i, st) in enumerate(stmts) {\n    // `x := C { … }` or `x := f(…)` with `x` not leaving the block: on the\n    // stack\n    stacked := codegen.stack_let(mut g, stmts, i, last)\n    codegen.push_transparent(mut g)\n    is_call := match st {\n      ast.Let { value, .. } => codegen.call_like(g, value),\n      _ => false,\n    }\n    g.stack_next = stacked != \"\" && !is_call\n    g.stack_call = stacked != \"\" && is_call\n    g.stack_made = []\n    if g.memory_sites {\n      codegen.site_marker(mut g, codegen.stmt_value(st))\n      g.root_stmt = roots.text_key(text.expr_text(codegen.stmt_value(st), 0))\n    }\n    codegen.stmt(mut g, st)\n    g.stack_next = false\n    g.stack_call = false\n    if stacked != \"\" && g.stack_made != [] {\n      match codegen.lookup(g, stacked) {\n        Some(l) => {\n          codegen.mark_stacked(mut g, l.slot, g.stack_made)\n          // (the variable holds the block now: a temporary reading it is\n          // not what holds the block, and drops nothing)\n          mut g.stack_ops.remove(l.op)\n        },\n        None => (),\n      }\n    }\n    g.stack_made = []\n    codegen.pop_scope(mut g)\n  }\n  if g.memory_sites && !(last is ast.UnitExpr) {\n    codegen.site_marker(mut g, last)\n  }\n  if g.memory_sites {\n    g.root_stmt = roots.text_key(text.expr_text(last, 0))\n    codegen.root_stmt_code(mut g, ast.ExprStmt(last))\n  }\n  g.result_pos = rp\n  v := codegen.expr_want(mut g, last, want)\n  g.result_pos = false\n  x := codegen.leave_branch(mut g, v)\n  g.root_stmt = outer_stmt\n  codegen.temp(mut g, x)\n}"},{"name":"codegen.function_value","kind":"fn","old":"2678b6437d9c2273","new":"b014b7e31959f392","interface_changed":true,"affected":["codegen.expr_want_node","codegen.expr_want","codegen.function","codegen.binary","codegen.declare","codegen.destructure","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.method_call","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.try_want","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.expr_node","codegen.compared","codegen.stmt_node","codegen.build_fn","codegen.push_in_place","codegen.compiled_alone","codegen.call_named","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.except_expr","codegen.matching_want","codegen.list_literal","codegen.generate","codegen.construct","codegen.operands","codegen.branch_value","codegen.mock_call","codegen.try_expr","codegen.lambda","codegen.expr","codegen.checked","codegen.stmt","codegen.built_or_generated","codegen.update_in_place","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builti