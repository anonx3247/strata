"termination.calls_within","termination.call_name","termination.scoped","termination.calls_in","termination.finite_iterator","termination.structural","termination.expand_alias","termination.candidate_measures","termination.cannot_fail","termination.total_builtin","termination.analyze","termination.impl_labels","termination.seen_through","termination.with_trait_contract","termination.trait_method","termination.finite_source","termination.unsat_all","termination.loops_all","termination.measures_all","termination.loop_answered","termination.measure_answered","strata_command","build_command","run_command","main","apply_edit","edit_file","fix_loops","graph_command","graph_diff","verified_decls","termination_file","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","edit_command","edit_in_editor","repl_command","fix_command","diff_command","verified_with","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","verified_program","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","check_command","program_objects","comptime_values","call_command","loaded_errors","file_errors","edit_errors","linked","expanded","comptime_runner","package_errors","check_files","apply_change","with_base","rename_command","move_command"],"module":"smt","text":"/// The state of the symbolic run of one function.\npub type Vc = {\n  // the functions and types of the program, std and core, by the names\n  // code uses, and the builtins' signatures\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  builtins: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  // each sum type's variants, with the type's name\n  parents: Dict[String, String],\n  // each constructor, with its type's name\n  ctors: Dict[String, String],\n  consts: List[smt.Const],\n  next_var: Int,\n  facts: List[String],\n  // facts that hold on every path (what a term's type gives)\n  defs: List[String],\n  // why each unknown was made (something not modelled)\n  reasons: Dict[String, String],\n  reason: Option[String],\n  pc: List[String],\n  scopes: List[Dict[String, smt.Val]],\n  obligations: List[smt.Obligation],\n  // obligations true for all values: proven without a query\n  given: List[String],\n  // inside a contract or refinement: no obligations are made there\n  spec: Int,\n  proving: Int,\n  dead: Bool,\n  depth: Int,\n  returns: List[smt.Exit],\n  memo: Dict[String, smt.Val],\n  bit_terms: Dict[String, String],\n  // the types variables were declared with, which hold after each\n  // assignment\n  declared: Dict[String, List[ast.TypeExpr]],\n  params: List[(String, smt.Val)],\n  // the sorts, in the order met, by name\n  sorts: List[(String, smt.SortDef)],\n  sort_index: Dict[String, Int],\n  // the validity predicates (name, sort), by type and sort\n  valid: List[(String, String)],\n  valid_index: Dict[String, Int],\n  // the validity predicates defined, and the terms unfolded\n  defined: Set[String],\n  unfolded: Dict[String, smt.Val],\n  // strings read from datatype values, named in the queries\n  str_terms: List[String],\n  // the types being checked (a recursive one is checked to a fixed depth)\n  checking: List[String],\n  cutoffs: Dict[String, String],\n  // the lists, by id\n  lists: List[smt.ListInfo],\n  // open scopes (a quantified fact, a template): where the unknowns and\n  // facts made inside them start\n  regions: List[(Int, Int)],\n  // the positions new unknowns are functions of (a list's template)\n  indexing: Option[List[String]],\n  // the quantifier nesting, and the quantified variables made\n  binding: Int,\n  qvars: Int,\n  // the unknowns a quantifier binds\n  bound: Set[String],\n  // nesting depth of lists compared by position\n  eq_depth: Int,\n  // the functions passed to the call being made, by argument\n  fn_args: List[Option[smt.Func]],\n  // the `break`s and `continue`s of the loops being run, innermost last\n  breaks: List[List[smt.Jump]],\n  continues: List[List[smt.Jump]],\n  // inside a trial pass of a loop: inner loops infer nothing\n  trial: Int,\n  // in a trial pass, the values callees wrote back to `mut` arguments of a\n  // type without refinements: any value of the type, nothing known\n  wiped: List[smt.Val],\n  // candidate invariants: the `ensures` of the returned variable, and the\n  // `requires`\n  hints: List[(ast.Expr, String)],\n  requires_hints: List[ast.Expr],\n  // the solver's answers from earlier runs, by query, and the queries\n  // this run still needs\n  answers: Dict[String, String],\n  pending: List[String],\n  // the strings tested against regular expressions: the string, the\n  // pattern, its Bool, and whether it is approximated\n  matched: List[(String, String, String, Bool)],\n  // what this function uses that smt doesn't model\n  gaps: List[String],\n  // for the termination check: the function's own name (a call of it is\n  // recursion), its `while` loops, its recursive calls (path and\n  // arguments), their obligations (kept apart), and the type of each\n  // non-list value a `for` runs over (`\"\"` when not known)\n  self_name: String,\n  loops: List[smt.LoopInfo],\n  rec_sites: List[(List[String], List[smt.Val])],\n  term_obs: List[smt.Obligation],\n  iter_fors: List[String],\n  // for `verify`'s report: the loop invariants inferred, and the functions\n  // seen through whose finishing is only assumed (`terminates`)\n  invariants: List[String],\n  relied_on: Set[String],\n  // `verify`'s counterexamples (`Methods.examples`): each list parameter's\n  // first elements (`input_elems`). Their facts and terms are set aside for\n  // a second query when a model can't be shown without them.\n  examples: Bool,\n  example_facts: List[String],\n  example_leaves: List[String],\n  input_elems: Dict[Int, List[smt.Val]],\n  input_depth: Int,\n  // a running solver (c/solver.c) that `ask` sends each question to as it\n  // comes, waiting for the answer, so the function is run once. With `\"\"`\n  // the questions stay pending and the run is repeated once answered.\n  live: String,\n  // the function's own `while` loops (`while_loops`), to tell them from\n  // those of callees seen through\n  own_whiles: List[(ast.Expr, ast.Expr)],\n  // the cost of the loop-invariant searches (solver resource units and\n  // microseconds, from their answers), and whether one was refused because\n  // the run's search budget was used up\n  search_units: Int,\n  search_micros: Int,\n  search_cut: Bool,\n  // inside a loop with written invariants: inference asks only at a\n  // proof's limit, and gives up at the first unanswered question\n  cheap: Int,\n  // for `verify` to write: each own `while` loop's inferred invariants and\n  // their cost\n  found_loops: List[smt.LoopFound],\n  // the `mut` parameters of the function. Its `ensures` name their values\n  // at each exit; `old x` is the starting value.\n  mut_params: List[String] = [],\n  // in an `ensures`: what `old e` reads (the values at the function's\n  // start, or the arguments before a call)\n  olds: Option[Dict[String, smt.Val]] = None,\n  // after a call seen through its contract: the `mut` parameters' values\n  // it leaves (`write_after` writes them back)\n  after: List[smt.Val] = [],\n  // the dicts and sets among the lists, by id, with their types. An\n  // input's is shown as a dict or set (`literal_of`).\n  keyed: Dict[Int, ast.TypeExpr],\n  // dict and set entries by list id: an SMT array from each key to an\n  // `Option` of its value (dict) or a Bool (set). Its size is a function\n  // of the array (`map_sorts`).\n  arrays: Dict[Int, String],\n  // the type a `let` gives the dict or set literal bound to it, so `set`\n  // and `dict` make an array of that type\n  want: Option[(ast.Expr, ast.TypeExpr)],\n  // in a loop's written invariant: calls are seen through as in a contract\n  see: Int = 0,\n  // inside a fact made of two lists' elements known equal\n  in_same: Int = 0,\n  // the lists whose facts about every element are being given to one of\n  // them (`known_of`): a fact about a list's elements that takes another\n  // element of it (`!contains(xs, x)`) is not given again to that one\n  knowing: List[Int] = [],\n  // comparing two lists the code compares (`binary`)\n  list_eq: Int = 0,\n  // the prefix-sum functions of lists (`prefix_sum`), by list and function\n  sum_fns: Dict[String, String] = Dict[String, String] {},\n  // those of `sum_fns` of a list through a function: the list, the\n  // function and the prefix-sum function (for `for_element`)\n  mapped_sums: List[(Int, smt.Func, String)] = [],\n  // the lengths of the lists whose first elements are in `input_elems`\n  input_lens: Dict[Int, String] = Dict[Int, String] {},\n  // the recursive functions unfolded in contracts, as SMT functions: by\n  // symbol, their argument sorts and result sort (`rec_call`)\n  rec_fns: Dict[String, (List[String], String)] = Dict[String, (List[String], String)] {},\n  // nesting depth of unfolding them\n  unfolding: Int = 0,\n  // making a definition (`define_fn`): no unknown may be made\n  defining: Int = 0,\n  // the orders of values of a sort `compare` uses (the order unknown: a\n  // function of the two values), with their sorts\n  orders: List[(String, String)] = [],\n  // the functions contracts see through, each defined once (`def_call`):\n  // its symbol and its `define-fun` (or `define-fun-rec`), each after those\n  // it uses; by function and argument sorts, its symbol (`\"\"`: it has no\n  // definition, its body not being one term of its parameters)\n  fun_defs: List[(String, String)] = [],\n  def_index: Dict[String, String] = Dict[String, String] {},\n  // the definitions' parameters and recursive calls, by key (`def_call`);\n  // in a definition being made, the recursive calls met; the uses of\n  // recursive functions stated, by levels and application (`rec_use`)\n  def_info: Dict[String, smt.DefInfo] = Dict[String, smt.DefInfo] {},\n  calls: List[(String, List[String])] = [],\n  rec_stated: Set[String] = Set[String] {},\n  // nesting depth of comparing two datatype terms of different sorts\n  data_eq: Int = 0,\n  // uninterpreted functions of a receiver, standing for pure methods seen\n  // only through their contracts (a trait model, `self.total()`): name,\n  // receiver sort, result sort (`receiver_term`)\n  of_receiver: List[(String, String, String)] = [],\n  // the polarity of the Bool being made, read by `eval`:\n  // 1: only ever assumed true (a fact of every position, inside `all`);\n  // -1: only ever proven (inside `every`);\n  // 0: either.\n  // `all` makes only the direction it needs, so a quantifier is never\n  // nested in another (`all_of`).\n  polarity: Int = 0,\n  // the polarity of the call being made (`call`, `builtin` read it)\n  call_pol: Int = 0,\n  // how many seen-through bodies (in a contract) the run is in. There a\n  // refined constructor that may fail is a value only where it doesn't\n  // (`ctor`).\n  through: Int = 0,\n  // what holds of every entry of a dict (`all(d.items(), f)` assumed), the\n  // keys read in dicts' arrays, and whether such a fact is being stated\n  // (`map_instance` does not recurse)\n  map_alls: List[smt.MapAll] = [],\n  map_reads: List[smt.MapRead] = [],\n  map_inst: Int = 0,\n  // each array made by a store, with the array it was stored into\n  map_from: Dict[String, String] = Dict[String, String] {},\n  // the facts in `defs`, to make each once\n  def_set: Set[String] = Set[String] {},\n  // each `for`'s list, by the name its index loop binds it to (`for_loop`)\n  for_lists: Dict[String, ast.Expr] = Dict[String, ast.Expr] {},\n  // the variable the body ends with, and the result's type\n  returned: Option[(String, ast.TypeExpr)] = None,\n  // the obligations made before each loop whose invariant search was left\n  // out (`Methods.search` 0): a check failing after one of them asks for\n  // the search (compiler `verify`)\n  skipped: List[Int] = [],\n  // `unique` of each list asked, by its id: the same list, the same answer\n  uniques: Dict[Int, String] = Dict[Int, String] {},\n  // those loops, with where their checks are (for `verify` to say which\n  // loop a check failing after one of them may need an invariant of)\n  skipped_loops: List[smt.SkippedLoop] = [],\n  // the expression the body ends with, as shown (what its `ensures` are\n  // about, for `verify` to name)\n  result_text: String = \"\",\n  // inside the steps of an `assert … by`: where its facts start (`-1`: in\n  // no proof). A `calc` step sees the facts from there on.\n  proof_from: Int = -1,\n}","old_text":"/// The state of the symbolic run of one function.\npub type Vc = {\n  // the functions and types of the program, std and core, by the names\n  // code uses, and the builtins' signatures\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  builtins: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  // each sum type's variants, with the type's name\n  parents: Dict[String, String],\n  // each constructor, with its type's name\n  ctors: Dict[String, String],\n  consts: List[smt.Const],\n  next_var: Int,\n  facts: List[String],\n  // facts that hold on every path (what a term's type gives)\n  defs: List[String],\n  // why each unknown was made (something not modelled)\n  reasons: Dict[String, String],\n  reason: Option[String],\n  pc: List[String],\n  scopes: List[Dict[String, smt.Val]],\n  obligations: List[smt.Obligation],\n  // obligations true for all values: proven without a query\n  given: List[String],\n  // inside a contract or refinement: no obligations are made there\n  spec: Int,\n  proving: Int,\n  dead: Bool,\n  depth: Int,\n  returns: List[smt.Exit],\n  memo: Dict[String, smt.Val],\n  bit_terms: Dict[String, String],\n  // the types variables were declared with, which hold after each\n  // assignment\n  declared: Dict[String, List[ast.TypeExpr]],\n  params: List[(String, smt.Val)],\n  // the sorts, in the order met, by name\n  sorts: List[(String, smt.SortDef)],\n  sort_index: Dict[String, Int],\n  // the validity predicates (name, sort), by type and sort\n  valid: List[(String, String)],\n  valid_index: Dict[String, Int],\n  // the validity predicates defined, and the terms unfolded\n  defined: Set[String],\n  unfolded: Dict[String, smt.Val],\n  // strings read from datatype values, named in the queries\n  str_terms: List[String],\n  // the types being checked (a recursive one is checked to a fixed depth)\n  checking: List[String],\n  cutoffs: Dict[String, String],\n  // the lists, by id\n  lists: List[smt.ListInfo],\n  // open scopes (a quantified fact, a template): where the unknowns and\n  // facts made inside them start\n  regions: List[(Int, Int)],\n  // the positions new unknowns are functions of (a list's template)\n  indexing: Option[List[String]],\n  // the quantifier nesting, and the quantified variables made\n  binding: Int,\n  qvars: Int,\n  // the unknowns a quantifier binds\n  bound: Set[String],\n  // nesting depth of lists compared by position\n  eq_depth: Int,\n  // the functions passed to the call being made, by argument\n  fn_args: List[Option[smt.Func]],\n  // the `break`s and `continue`s of the loops being run, innermost last\n  breaks: List[List[smt.Jump]],\n  continues: List[List[smt.Jump]],\n  // inside a trial pass of a loop: inner loops infer nothing\n  trial: Int,\n  // in a trial pass, the values callees wrote back to `mut` arguments of a\n  // type without refinements: any value of the type, nothing known\n  wiped: List[smt.Val],\n  // candidate invariants: the `ensures` of the returned variable, and the\n  // `requires`\n  hints: List[(ast.Expr, String)],\n  requires_hints: List[ast.Expr],\n  // the solver's answers from earlier runs, by query, and the queries\n  // this run still needs\n  answers: Dict[String, String],\n  pending: List[String],\n  // the strings tested against regular expressions: the string, the\n  // pattern, its Bool, and whether it is approximated\n  matched: List[(String, String, String, Bool)],\n  // what this function uses that smt doesn't model\n  gaps: List[String],\n  // for the termination check: the function's own name (a call of it is\n  // recursion), its `while` loops, its recursive calls (path and\n  // arguments), their obligations (kept apart), and the type of each\n  // non-list value a `for` runs over (`\"\"` when not known)\n  self_name: String,\n  loops: List[smt.LoopInfo],\n  rec_sites: List[(List[String], List[smt.Val])],\n  term_obs: List[smt.Obligation],\n  iter_fors: List[String],\n  // for `verify`'s report: the loop invariants inferred, and the functions\n  // seen through whose finishing is only assumed (`terminates`)\n  invariants: List[String],\n  relied_on: Set[String],\n  // `verify`'s counterexamples (`Methods.examples`): each list parameter's\n  // first elements (`input_elems`). Their facts and terms are set aside for\n  // a second query when a model can't be shown without them.\n  examples: Bool,\n  example_facts: List[String],\n  example_leaves: List[String],\n  input_elems: Dict[Int, List[smt.Val]],\n  input_depth: Int,\n  // a running solver (c/solver.c) that `ask` sends each question to as it\n  // comes, waiting for the answer, so the function is run once. With `\"\"`\n  // the questions stay pending and the run is repeated once answered.\n  live: String,\n  // the function's own `while` loops (`while_loops`), to tell them from\n  // those of callees seen through\n  own_whiles: List[(ast.Expr, ast.Expr)],\n  // the cost of the loop-invariant searches (solver resource units and\n  // microseconds, from their answers), and whether one was refused because\n  // the run's search budget was used up\n  search_units: Int,\n  search_micros: Int,\n  search_cut: Bool,\n  // inside a loop with written invariants: inference asks only at a\n  // proof's limit, and gives up at the first unanswered question\n  cheap: Int,\n  // for `verify` to write: each own `while` loop's inferred invariants and\n  // their cost\n  found_loops: List[smt.LoopFound],\n  // the `mut` parameters of the function. Its `ensures` name their values\n  // at each exit; `old x` is the starting value.\n  mut_params: List[String] = [],\n  // in an `ensures`: what `old e` reads (the values at the function's\n  // start, or the arguments before a call)\n  olds: Option[Dict[String, smt.Val]] = None,\n  // after a call seen through its contract: the `mut` parameters' values\n  // it leaves (`write_after` writes them back)\n  after: List[smt.Val] = [],\n  // the dicts and sets among the lists, by id, with their types. An\n  // input's is shown as a dict or set (`literal_of`).\n  keyed: Dict[Int, ast.TypeExpr],\n  // dict and set entries by list id: an SMT array from each key to an\n  // `Option` of its value (dict) or a Bool (set). Its size is a function\n  // of the array (`map_sorts`).\n  arrays: Dict[Int, String],\n  // the type a `let` gives the dict or set literal bound to it, so `set`\n  // and `dict` make an array of that type\n  want: Option[(ast.Expr, ast.TypeExpr)],\n  // in a loop's written invariant: calls are seen through as in a contract\n  see: Int = 0,\n  // inside a fact made of two lists' elements known equal\n  in_same: Int = 0,\n  // the lists whose facts about every element are being given to one of\n  // them (`known_of`): a fact about a list's elements that takes another\n  // element of it (`!contains(xs, x)`) is not given again to that one\n  knowing: List[Int] = [],\n  // comparing two lists the code compares (`binary`)\n  list_eq: Int = 0,\n  // the prefix-sum functions of lists (`prefix_sum`), by list and function\n  sum_fns: Dict[String, String] = Dict[String, String] {},\n  // those of `sum_fns` of a list through a function: the list, the\n  // function and the prefix-sum function (for `for_element`)\n  mapped_sums: List[(Int, smt.Func, String)] = [],\n  // the lengths of the lists whose first elements are in `input_elems`\n  input_lens: Dict[Int, String] = Dict[Int, String] {},\n  // the recursive functions unfolded in contracts, as SMT functions: by\n  // symbol, their argument sorts and result sort (`rec_call`)\n  rec_fns: Dict[String, (List[String], String)] = Dict[String, (List[String], String)] {},\n  // nesting depth of unfolding them\n  unfolding: Int = 0,\n  // making a definition (`define_fn`): no unknown may be made\n  defining: Int = 0,\n  // the orders of values of a sort `compare` uses (the order unknown: a\n  // function of the two values), with their sorts\n  orders: List[(String, String)] = [],\n  // the functions contracts see through, each defined once (`def_call`):\n  // its symbol and its `define-fun` (or `define-fun-rec`), each after those\n  // it uses; by function and argument sorts, its symbol (`\"\"`: it has no\n  // definition, its body not being one term of its parameters)\n  fun_defs: List[(String, String)] = [],\n  def_index: Dict[String, String] = Dict[String, String] {},\n  // the definitions' parameters and recursive calls, by key (`def_call`);\n  // in a definition being made, the recursive calls met; the uses of\n  // recursive functions stated, by levels and application (`rec_use`)\n  def_info: Dict[String, smt.DefInfo] = Dict[String, smt.DefInfo] {},\n  calls: List[(String, List[String])] = [],\n  rec_stated: Set[String] = Set[String] {},\n  // nesting depth of comparing two datatype terms of different sorts\n  data_eq: Int = 0,\n  // uninterpreted functions of a receiver, standing for pure methods seen\n  // only through their contracts (a trait model, `self.total()`): name,\n  // receiver sort, result sort (`receiver_term`)\n  of_receiver: List[(String, String, String)] = [],\n  // the polarity of the Bool being made, read by `eval`:\n  // 1: only ever assumed true (a fact of every position, inside `all`);\n  // -1: only ever proven (inside `every`);\n  // 0: either.\n  // `all` makes only the direction it needs, so a quantifier is never\n  // nested in another (`all_of`).\n  polarity: Int = 0,\n  // the polarity of the call being made (`call`, `builtin` read it)\n  call_pol: Int = 0,\n  // how many seen-through bodies (in a contract) the run is in. There a\n  // refined constructor that may fail is a value only where it doesn't\n  // (`ctor`).\n  through: Int = 0,\n  // what holds of every entry of a dict (`all(d.items(), f)` assumed), the\n  // keys read in dicts' arrays, and whether such a fact is being stated\n  // (`map_instance` does not recurse)\n  map_alls: List[smt.MapAll] = [],\n  map_reads: List[smt.MapRead] = [],\n  map_inst: Int = 0,\n  // each array made by a store, with the array it was stored into\n  map_from: Dict[String, String] = Dict[String, String] {},\n  // the facts in `defs`, to make each once\n  def_set: Set[String] = Set[String] {},\n  // each `for`'s list, by the name its index loop binds it to (`for_loop`)\n  for_lists: Dict[String, ast.Expr] = Dict[String, ast.Expr] {},\n  // the variable the body ends with, and the result's type\n  returned: Option[(String, ast.TypeExpr)] = None,\n  // the obligations made before each loop whose invariant search was left\n  // out (`Methods.search` 0): a check failing after one of them asks for\n  // the search (compiler `verify`)\n  skipped: List[Int] = [],\n  // `unique` of each list asked, by its id: the same list, the same answer\n  uniques: Dict[Int, String] = Dict[Int, String] {},\n  // those loops, with where their checks are (for `verify` to say which\n  // loop a check failing after one of them may need an invariant of)\n  skipped_loops: List[smt.SkippedLoop] = [],\n  // the expression the body ends with, as shown (what its `ensures` are\n  // about, for `verify` to name)\n  result_text: String = \"\",\n}"},{"name":"smt.stmt","kind":"fn","old":"a16bf131cf5cb484","new":"0af2751c9235d58d","interface_changed":false,"affected":[],"module":"smt","text":"fn stmt(mut vc: smt.Vc, s: ast.Stmt) {\n  match s {\n    ast.Comment(_) | ast.ComptimeFor { .. } | ast.Invariant(_) | ast.Decreases(_) => (),\n    ast.ExprStmt(e) => {\n      _ := smt.eval(mut vc, e)\n    },\n    ast.Let { pat, ty, value } => {\n      // a dict or set literal: of the type the `let` says\n      saved := vc.want\n      match (ty, value) {\n        (Some(t), ast.Call { args: [x], .. }) => {\n          vc.want = Some((x, t))\n        },\n        _ => (),\n      }\n      v := smt.eval(mut vc, value)\n      vc.want = saved\n      smt.annotated(mut vc, ty, v)\n      match pat {\n        ast.Bind(x) => smt.declare(mut vc, x, ty),\n        _ => (),\n      }\n      mut binds := []\n      c := smt.pattern(mut vc, pat, v, mut binds)\n      mut vc.pc.push(c)\n      for (x, b) in binds {\n        smt.bind(mut vc, x, b)\n      }\n    },\n    ast.VarDecl { name, ty, value } => {\n      v := smt.eval(mut vc, value)\n      smt.annotated(mut vc, ty, v)\n      smt.declare(mut vc, name, ty)\n      smt.bind(mut vc, name, v)\n    },\n    ast.Assign { place, value } => {\n      v := smt.eval(mut vc, value)\n      smt.assign(mut vc, place, v, \"assigning\")\n    },\n    ast.Assert(e) => {\n      v := smt.eval(mut vc, e)\n      b := smt.as_bool(mut vc, v)\n      if smt.start_goal(mut vc) {\n        smt.oblige(mut vc, \"assert \" + text.expr_text(e, 0), b)\n      }\n    },\n    ast.While { cond, body } => smt.while_loop(mut vc, cond, body),\n    ast.For { pat, iter, body } => smt.for_loop(mut vc, pat, iter, body),\n    ast.Loop(body) => smt.plain_loop(mut vc, body),\n    ast.Break => smt.jump(mut vc, true),\n    ast.Continue => smt.jump(mut vc, false),\n    ast.AssertBy { cond, proof } => smt.assert_by(mut vc, cond, proof),\n    ast.Calc(steps) => smt.calc(mut vc, steps),\n  }\n}","old_text":"fn stmt(mut vc: smt.Vc, s: ast.Stmt) {\n  match s {\n    ast.Comment(_) | ast.ComptimeFor { .. } | ast.Invariant(_) => (),\n    ast.ExprStmt(e) => {\n      _ := smt.eval(mut vc, e)\n    },\n    ast.Let { pat, ty, value } => {\n      // a dict or set literal: of the type the `let` says\n      saved := vc.want\n      match (ty, value) {\n        (Some(t), ast.Call { args: [x], .. }) => {\n          vc.want = Some((x, t))\n        },\n        _ => (),\n      }\n      v := smt.eval(mut vc, value)\n      vc.want = saved\n      smt.annotated(mut vc, ty, v)\n      match pat {\n        ast.Bind(x) => smt.declare(mut vc, x, ty),\n        _ => (),\n      }\n      mut binds := []\n      c := smt.pattern(mut vc, pat, v, mut binds)\n      mut vc.pc.push(c)\n      for (x, b) in binds {\n        smt.bind(mut vc, x, b)\n      }\n    },\n    ast.VarDecl { name, ty, value } => {\n      v := smt.eval(mut vc, value)\n      smt.annotated(mut vc, ty, v)\n      smt.declare(mut vc, name, ty)\n      smt.bind(mut vc, name, v)\n    },\n    ast.Assign { place, value } => {\n      v := smt.eval(mut vc, value)\n      smt.assign(mut vc, place, v, \"assigning\")\n    },\n    ast.Assert(e) => {\n      v := smt.eval(mut vc, e)\n      b := smt.as_bool(mut vc, v)\n      if smt.start_goal(mut vc) {\n        smt.oblige(mut vc, \"assert \" + text.expr_text(e, 0), b)\n      }\n    },\n    ast.While { cond, body } => smt.while_loop(mut vc, cond, body),\n    ast.For { pat, iter, body } => smt.for_loop(mut vc, pat, iter, body),\n    ast.Loop(body) => smt.plain_loop(mut vc, body),\n    ast.Break => smt.jump(mut vc, true),\n    ast.Continue => smt.jump(mut vc, false),\n    _ => (),\n  }\n}"},{"name":"smt.cone_with","kind":"fn","old":"ec8c6c90d18fbf65","new":"c9ab139ec780b008","interface_changed":false,"affected":[],"module":"smt","text":"/// `cone`, with `extra` facts.\nfn cone_with(\n  vc: smt.Vc,\n  ob: smt.Obligation,\n  seeds: List[String],\n  extra: List[String],\n) -> (List[String], Set[String]) {\n  facts := vc.defs\n    + drop(take(vc.facts, ob.facts), ob.first_fact)\n    + ob.own\n    + extra\n  mut seen := set(smt.consts_in(ob.goal))\n  for p in ob.pc + seeds {\n    for c in smt.consts_in(p) {\n      mut seen.insert(c)\n    }\n  }\n  fact_consts := facts.map(f -> smt.consts_in(f))\n  mut used := facts.map(_ -> false)\n  mut changed := true\n  while changed {\n    changed = false\n    for (i, fc) in enumerate(fact_consts) {\n      if !(get(used, i) ?? true) && fc.any(c -> contains(seen, c)) {\n        used = take(used, i) + [true] + drop(used, i + 1)\n        changed = true\n        for c in fc {\n          mut seen.insert(c)\n        }\n      }\n    }\n  }\n  mut kept := []\n  for (i, f) in enumerate(facts) {\n    if get(used, i) ?? false {\n      mut kept.push(f)\n    }\n  }\n  (kept, seen)\n}","old_text":"/// `cone`, with `extra` facts.\nfn cone_with(\n  vc: smt.Vc,\n  ob: smt.Obligation,\n  seeds: List[String],\n  extra: List[String],\n) -> (List[String], Set[String]) {\n  facts := vc.defs + take(vc.facts, ob.facts) + extra\n  mut seen := set(smt.consts_in(ob.goal))\n  for p in ob.pc + seeds {\n    for c in smt.consts_in(p) {\n      mut seen.insert(c)\n    }\n  }\n  fact_consts := facts.map(f -> smt.consts_in(f))\n  mut used := facts.map(_ -> false)\n  mut changed := true\n  while changed {\n    changed = false\n    for (i, fc) in enumerate(fact_consts) {\n      if !(get(used, i) ?? true) && fc.any(c -> contains(seen, c)) {\n        used = take(used, i) + [true] + drop(used, i + 1)\n        changed = true\n        for c in fc {\n          mut seen.insert(c)\n        }\n      }\n    }\n  }\n  mut kept := []\n  for (i, f) in enumerate(facts) {\n    if get(used, i) ?? false {\n      mut kept.push(f)\n    }\n  }\n  (kept, seen)\n}"},{"name":"smt.assert_by","kind":"fn","old":null,"new":"c35f5871a7c952ff","interface_changed":true,"affected":[],"module":"smt","text":"/// `assert cond by proof`: `cond` proven in a query of its own, from the\n/// path's conditions and the facts the proof's steps make (a lemma's\n/// `ensures`, a step's `assert`), none of the function's other facts. The\n/// steps' checks (a lemma's `requires`, an `assert` among them) are proven\n/// where they are, as any check. Then `cond` holds from here on, as one\n/// condition; the proof's facts are dropped.\nfn assert_by(mut vc: smt.Vc, cond: ast.Expr, proof: ast.Expr) {\n  if vc.dead || vc.spec > 0 {\n    return\n  }\n  s0 := len(vc.facts)\n  b := smt.as_bool(mut vc, smt.eval(mut vc, cond))\n  s1 := len(vc.facts)\n  n_ob := len(vc.obligations)\n  n_term := len(vc.term_obs)\n  saved_pc := vc.pc\n  saved_from := vc.proof_from\n  vc.proof_from = s0\n  _ := smt.eval(mut vc, proof)\n  vc.proof_from = saved_from\n  vc.dead = false\n  vc.pc = saved_pc\n  if smt.start_goal(mut vc) {\n    smt.small_goal(\n      mut vc,\n      \"assert \" + text.expr_text(cond, 0) + \" by …\",\n      b,\n      s0,\n    )\n  }\n  vc.pc = saved_pc\n  smt.proof_ended(mut vc, s1, n_ob, n_term)\n  if b != \"true\" {\n    mut vc.pc.push(b)\n  }\n}"},{"name":"smt.small_goal","kind":"fn","old":null,"new":"06e950ea3e88f17f","interface_changed":true,"affected":[],"module":"smt","text":"/// Records the obligation `g` (after `start_goal`) given only the facts\n/// from `from` on: they go with it, as its own.\nfn small_goal(mut vc: smt.Vc, what: String, g: String, from: Int) {\n  n := len(vc.obligations)\n  smt.oblige(mut vc, what, g)\n  match get(vc.obligations, n) {\n    Some(ob) => {\n      vc.obligations = take(vc.obligations, n)\n        + [\n          smt.Obligation { ..ob, facts: from, first_fact: from, own: drop(vc.facts, from) },\n        ]\n    },\n    None => (),\n  }\n}"},{"name":"smt.proof_ended","kind":"fn","old":null,"new":"149a5c3d68096d4a","interface_changed":true,"affected":[],"module":"smt","text":"/// A proof's end: its facts (from `from` on) leave `Vc.facts`, so the\n/// function's other checks never see them; the checks made inside it (from\n/// `n_ob`, `n_term` on) keep them as their own.\nfn proof_ended(mut vc: smt.Vc, from: Int, n_ob: Int, n_term: Int) {\n  facts := vc.facts\n  vc.obligations = take(vc.obligations, n_ob)\n    + drop(vc.obligations, n_ob).map(\n      ob -> smt.kept_facts(facts, ob, from),\n    )\n  vc.term_obs = take(vc.term_obs, n_term)\n    + drop(vc.term_obs, n_term).map(\n      ob -> smt.kept_facts(facts, ob, from),\n    )\n  vc.facts = take(vc.facts, from)\n}"},{"name":"smt.kept_facts","kind":"fn","old":null,"new":"4891fb5beb6e7bb5","interface_changed":true,"affected":[],"module":"smt","text":"/// `ob` with the facts it was given from `from` on as its own.\nfn kept_facts(\n  facts: List[String],\n  ob: smt.Obligation,\n  from: Int,\n) -> smt.Obligation {\n  if ob.first_fact > 0 && ob.first_fact == ob.facts {\n    // a proof's step: its own facts are all it has\n    return smt.Obligation { ..ob, facts: min(ob.facts, from), first_fact: min(ob.first_fact, from) }\n  }\n  if ob.facts <= from {\n    return ob\n  }\n  smt.Obligation { ..ob, facts: from, own: drop(take(facts, ob.facts), from) + ob.own }\n}"},{"name":"smt.calc","kind":"fn","old":null,"new":"7ef7b2ccae10cffc","interface_changed":true,"affected":[],"module":"smt","text":"/// `calc { a == b; _ <= c }`: each step proven alone (from the path's\n/// conditions, and inside a proof that proof's facts), then what the chain\n/// proves (`ast.calc_fact`) holds from here on.\nfn calc(mut vc: smt.Vc, steps: List[ast.Expr]) {\n  if vc.dead || vc.spec > 0 {\n    return\n  }\n  saved_pc := vc.pc\n  for s in ast.calc_steps(steps) {\n    from := len(vc.facts)\n    b := smt.as_bool(mut vc, smt.eval(mut vc, s))\n    if smt.start_goal(mut vc) {\n      smt.small_goal(\n        mut vc,\n        \"calc step \" + text.expr_text(s, 0),\n        b,\n        if vc.proof_from >= 0 {\n          vc.proof_from\n        } else {\n          from\n        },\n      )\n    }\n  }\n  match ast.calc_fact(steps) {\n    Some(whole) => {\n      from := len(vc.facts)\n      b := smt.as_bool(mut vc, smt.eval(mut vc, whole))\n      if smt.start_goal(mut vc) {\n        smt.small_goal(\n          mut vc,\n          \"calc \" + text.expr_text(whole, 0),\n          b,\n          from,\n        )\n      }\n      vc.pc = saved_pc\n      if b != \"true\" {\n        mut vc.pc.push(b)\n      }\n    },\n    None => {\n      vc.pc = saved_pc\n    },\n  }\n}"}]}
{"id":"58ee7a54ba57a250","time":1795665326,"message":"edit","changes":[{"name":"verify_file","kind":"fn","old":"30fbcba736dd1fee","new":"acd38452af0682fa","interface_changed":false,"affected":[],"module":"","text":"/// `verify [--cases N] [--seed S] [--cross-check N] [--require R] [--checks]\n/// [--no-cache] [--only SELECTION] [--quiet] [--proofs FILE]\n/// [--show-searches] [--load LIB --precompiled NAMES] FILE`: verifies each\n/// function of the script (or of the package,\n/// a folder), each method of its types and implementations, and each law\n/// they must keep. Reports as `strata verify --no-race` does.\n/// \n/// The program is checked first (errors on stderr, exit 1). Then the solver\n/// (compiler/smt) proves what it can, its counterexamples are run to\n/// confirm them, and the rest is fuzzed (compiled, run by c/jit.c).\n/// \n/// - `--only`: the definitions a selection names (`f,g`, `prefix*`,\n/// `module:m`, `slice:f`, a module's name), as `strata verify NAME`.\n/// - `--quiet` (`strata build`): no report, only one line on stderr on the\n/// checks not verified before.\n/// - Verdicts are cached between runs (`(cached)`, `verdict_file`).\n/// Proofs are cached by what they rely on (`proof_file`): when a callee's\n/// body changes but its contract doesn't, its callers' proofs are kept and\n/// only cross-checked again. Each definition's status is kept too\n/// (`status_file`).\n/// - The checks proven are recorded for `proofs` (`proofs_file`, or FILE).\n/// - The package's `[verify]` rules apply to their modules as `--require`\n/// does.\n/// - Loops get the invariants derived from their code and those written\n/// (`invariant`); nothing is searched for. A check failing in or after a\n/// loop that changes what it names says so (`loop_hint`), as does a loop\n/// whose bound isn't shown to go down.\n/// - `--find-invariants BY [--search-budget N] [--log]` (`strata edit` and\n/// `strata fix`, `BY`): only the chosen functions with loops. Where a check\n/// fails after a loop (or a loop isn't shown to end), invariants are\n/// searched for and written into the code (`find_invariants`), logged and\n/// committed with `--log`. Nothing else is checked or reported. All\n/// searches share one budget of the solver's resource units (default\n/// `search_budget`).\n/// \n/// Exit 1 on a counterexample or a broken rule, 2 on a mistake in the\n/// arguments. A function the encoder doesn't cover says so.\nfn verify_file(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  caches: cache.Cache,\n  solver: String,\n  cc: String,\n  args: List[String],\n) -> std.process.ExitCode {\n  mut rest := args\n  mut cases := 200\n  mut seed := 1\n  mut cross := 20\n  mut require := []\n  mut checks_shown := false\n  mut no_cache := false\n  mut proofs_at := \"\"\n  mut budget := search_budget()\n  mut finding := \"\"\n  mut logged := false\n  mut show_searches := false\n  mut loaded := false\n  mut precompiled := \"\"\n  mut selection := \"\"\n  mut quiet := false\n  mut json := false\n  mut entries := []\n  mut go := true\n  while go {\n    match rest {\n      [\"--cases\", n, ..more] => {\n        cases = parse_int(n) ?? cases\n        rest = more\n      },\n      [\"--seed\", n, ..more] => {\n        seed = parse_int(n) ?? seed\n        rest = more\n      },\n      [\"--cross-check\", n, ..more] => {\n        cross = parse_int(n) ?? cross\n        rest = more\n      },\n      [\"--require\", r, ..more] => {\n        require = split(r, \",\").map(x -> trim(x))\n        rest = more\n      },\n      [\"--checks\", ..more] => {\n        checks_shown = true\n        rest = more\n      },\n      [\"--no-cache\", ..more] => {\n        no_cache = true\n        rest = more\n      },\n      [\"--search-budget\", n, ..more] => {\n        budget = parse_int(n) ?? budget\n        rest = more\n      },\n      [\"--find-invariants\", by, ..more] => {\n        finding = by\n        rest = more\n      },\n      [\"--log\", ..more] => {\n        logged = true\n        rest = more\n      },\n      [\"--show-searches\", ..more] => {\n        show_searches = true\n        rest = more\n      },\n      [\"--proofs\", p, ..more] => {\n        proofs_at = p\n        rest = more\n      },\n      [\"--only\", sel, ..more] => {\n        selection = sel\n        rest = more\n      },\n      [\"--quiet\", ..more] => {\n        quiet = true\n        rest = more\n      },\n      // (each verdict as JSON)\n      [\"--json\", ..more] => {\n        json = true\n        rest = more\n      },\n      // std's precompiled library, loaded into the JIT, and its functions'\n      // names: declared in the drivers instead of compiled again\n      [\"--load\", lib, ..more] => {\n        loaded = jit_load(lib).to_int() == 0\n        rest = more\n      },\n      [\"--precompiled\", names, ..more] => {\n        precompiled = names\n        rest = more\n      },\n      _ => {\n        go = false\n      },\n    }\n  }\n  for r in require {\n    if !contains([\"proven\", \"terminates\", \"no-recursion\"], r) {\n      mut console.eprint(\n        \"error: unknown requirement `\"\n          + r\n          + \"` (use proven, terminates, no-recursion)\",\n      )\n      return 2\n    }\n  }\n  file := get(rest, 0) ?? \"\"\n  pre := if loaded && precompiled != \"\" {\n    [\"--precompiled\", precompiled]\n  } else {\n    []\n  }\n  // a script, or a package's folder: each module named by its path\n  sources := source_files(disk, file)\n  if sources == [] {\n    mut console.eprint(\"error: \" + file + \": no module file here\")\n    return 2\n  }\n  // the program must check first, as `strata check` checks it. Its compiles\n  // share the program, read and expanded once.\n  sh := with_base(disk, shared(disk, caches), [file])\n  core := sh.core\n  timings.begin(\"verify: check the program\")\n  errors := if finding != \"\" {\n    []\n  } else {\n    warned(mut console, file_errors(\n      mut launcher,\n      mut disk,\n      caches,\n      \"std\",\n      file,\n      false,\n      core,\n      sh,\n      pre,\n    ))\n  }\n  timings.end(\"verify: check the program\")\n  if errors != [] {\n    for e in errors {\n      mut console.eprint(error_text(e))\n    }\n    return 1\n  }\n  // the traits, capabilities and mocks of the file, std and core\n  raw := own_decls(disk, sources)\n  // the definitions chosen (every one without a selection)\n  chosen := match select_names(raw, selection) {\n    Ok(names) => names,\n    Err(e) => {\n      mut console.eprint(\"error: \" + e)\n      return 2\n    },\n  }\n  std_files := deps.module_files(disk, \"std\").map(f -> \"std/\" + f)\n  context_decls := module_decls(disk, core_files())\n    + std_reached(disk, \"std\", raw)\n    + raw\n  mut traits := []\n  mut impls := []\n  mut caps := Set[String] {}\n  mut mocked := Set[String] {}\n  mut trait_modules := Dict[String, String] {}\n  // (traits and impls with their models as methods, as checked)\n  for d in desugar.with_models(context_decls, []) {\n    match d.kind {\n      ast.TraitDef(t) => {\n        mut traits.push(t)\n        mut trait_modules.insert(t.name, d.module)\n      },\n      ast.ImplDef(i) => mut impls.push(i),\n      ast.CapabilityDef(c) => {\n        mut caps.insert(c.name)\n        // (by the name code uses too: `clock.SystemClock`)\n        if d.module != \"\" && !contains(c.name, \".\") {\n          mut caps.insert(d.module + \".\" + c.name)\n        }\n      },\n      ast.TypeDef(t) => if t.mocked {\n        mut mocked.insert(t.name)\n      },\n      _ => (),\n    }\n  }\n  // the types holding a capability, each with the one it holds\n  holders := capability_holders(context_decls, caps)\n  wrappers := verify_wrappers(raw, traits, impls, caps)\n  (own, fns, types, sigs, all_methods) := verified_with(disk, [file], wrappers)\n  // (the assumed contracts as verify writes them: each check of one is\n  // noted as such)\n  assumed_clauses := assumed_texts(own)\n  scratch := caches.smt\n  cache.make_dirs(mut disk, scratch)\n  // (a solver that can't be run: none, and everything is fuzzed)\n  // (loops' invariants searched for only when finding them: `verify`\n  // and `build` use those derived from the code and those written)\n  ctx := {\n    c := termination.context(\n      fns,\n      types,\n      sigs,\n      all_methods,\n      scratch,\n      if toolchain.has_solver(mut launcher, solver) {\n        solver\n      } else {\n        \"\"\n      },\n    )\n    termination.Ctx { ..c, methods: smt.Methods { ..c.methods, search: if finding != \"\" {\n      2\n    } else {\n      0\n    } } }\n  }\n  // the implementations written as `derive`s, by position, and each\n  // implementation's name (`impl:K`'s definition)\n  mut derived := Set[Int] {}\n  mut impl_names := []\n  for d in raw {\n    match d.kind {\n      ast.ImplDef(i) => {\n        if i.derived {\n          mut derived.insert(len(impl_names))\n        }\n        mut impl_names.push(store.qname(d))\n      },\n      _ => (),\n    }\n  }\n  // each check's definition, by its name as a selection names it\n  def_name := (def: String) -> if starts_with(def, \"fn:\") {\n    drop_bytes(def, 3)\n  } else {\n    get(impl_names, parse_int(drop_bytes(def, 5)) ?? -1) ?? def\n  }\n  targets := checks_of(ctx, own, traits, caps, mocked, trait_modules, derived).filter(\n    t -> contains(chosen, def_name(t.def)),\n  )\n  // termination is analysed for what the chosen checks reach\n  mut roots := Set[String] {}\n  for t in targets {\n    roots = {\n      mut copy := {\n        mut copy := roots\n        mut copy.insert(t.label)\n        copy\n      }\n      mut copy.insert(t.key)\n      copy\n    }\n  }\n  // (each function's loops as earlier runs found them, for its code as the\n  // encoder sees it: `loops_file`)\n  timings.begin(\"verify: cache keys\")\n  own_paths := set(sources.map(s -> s.0))\n  // (the prelude too: it is compiled into every driver)\n  others := std_fingerprint(\n    disk,\n    (core_files() + [\"runtime/prelude.strata\"] + std_files).filter(\n      f -> !contains(own_paths, f),\n    ),\n  )\n  target_defs := set(targets.map(t -> t.def))\n  loop_keys := interface_keys(disk, sources, ctx.methods, target_defs, true)\n  // (the solver by its path and version: a verdict where it gave up is kept\n  // too, since it gives that answer again)\n  solver_id := solver + \" (\" + solver_version(solver) + \")\"\n  loop_settings := \"loops derived solver \"\n    + solver_id\n    + \" std \"\n    + others\n    + \" impls \"\n    + impls_fingerprint(disk, sources)\n    + \" package \"\n    + join(\n      items(settings_at(disk, file)).map(p -> p.0 + \"=\" + p.1),\n      \",\",\n    )\n  // (std's and core's own definitions: keyed by their names and std's code\n  // as a whole, `others`, so what std's loops and recursion take is found\n  // once and shipped with std)\n  library := library_names(\n    disk,\n    (core_files() + std_files).filter(f -> !contains(own_paths, f)),\n  )\n  loop_key := (n: String) -> match get(loop_keys, \"fn:\" + n) {\n    Some(k) => Some(loop_settings + \"\\n\" + n + \"\\n\" + k),\n    None => if contains(library, n) {\n      Some(loop_settings + \"\\n\" + n + \"\\nlibrary\")\n    } else {\n      None\n    },\n  }\n  reuse := !no_cache && finding == \"\" && cache.caching() && ctx.solver != \"\"\n  known := (n: String) -> if reuse {\n    match loop_key(n) {\n      Some(k) => match cache.read_entry(disk, caches, loops_file(k)) {\n        Some(text) => loops_of_text(text),\n        None => None,\n      },\n      None => None,\n    }\n  } else {\n    None\n  }\n  known_measure := (n: String) -> if reuse {\n    match loop_key(n) {\n      Some(k) => match cache.read_entry(disk, caches, measure_file(k)) {\n        Some(text) => Some(if text == \"none\" {\n          None\n        } else {\n          Some(text)\n        }),\n        None => None,\n      },\n      None => None,\n    }\n  } else {\n    None\n  }\n  timings.end(\"verify: cache keys\")\n  // (one budget for every loop-invariant search of the run: termination's\n  // and verification's)\n  smt.set_search_budget(budget)\n  timings.begin(\"verify: termination\")\n  (analysis, learned, measured) := termination.analyze_with(\n    mut launcher,\n    mut disk,\n    ctx,\n    Some(roots),\n    known,\n    known_measure,\n  )\n  timings.end(\"verify: termination\")\n  if !no_cache && finding == \"\" && ctx.solver != \"\" && cache.caching() {\n    for (n, x) in items(learned) {\n      match loop_key(n) {\n        Some(k) => write_loops(mut disk, caches, k, x),\n        None => (),\n      }\n    }\n    for (n, m) in items(measured) {\n      match loop_key(n) {\n        Some(k) => match cache.write_entry(\n          mut disk,\n          caches,\n          measure_file(k),\n          m ?? \"none\",\n        ) {\n          _ => (),\n        },\n        None => (),\n      }\n    }\n  }\n  methods := smt.Methods { ..termination.seen_through(ctx, analysis), examples: true }\n  // finding loops' invariants (`strata edit`, `strata fix`): nothing else\n  if finding != \"\" {\n    if ctx.solver == \"\" {\n      return 0\n    }\n    wrote := find_invariants(\n      mut console,\n      mut launcher,\n      mut disk,\n      file,\n      raw,\n      sh.core,\n      ctx,\n      methods,\n      analysis,\n      targets,\n      finding,\n      budget,\n      show_searches,\n      logged,\n    )\n    // (exit 3: nothing written)\n    return if wrote {\n      0\n    } else {\n      3\n    }\n  }\n  // the verdicts of earlier runs with these settings, for the code as it\n  // is now (each check's definition with all it depends on)\n  timings.begin(\"verify: cache keys\")\n  closures := closure_keys_of(disk, sources, target_defs)\n  // (`--no-cache` checks again; the package's settings, which std's code\n  // reads)\n  settings := \"loops derived seed \"\n    + to_string(seed)\n    + \" solver \"\n    + solver_id\n    + \" std \"\n    + std_fingerprint(\n      disk,\n      core_files() + [\"runtime/prelude.strata\"] + std_files,\n    )\n    + \" package \"\n    + join(\n      items(settings_at(disk, file)).map(p -> p.0 + \"=\" + p.1),\n      \",\",\n    )\n  cross_of := (t: Check) -> match get(analysis.status, t.label) {\n    Some(termination.Proven(_)) => cross,\n    _ => 0,\n  }\n  key_of := (t: Check) -> {\n    cc := cross_of(t)\n    settings\n      + \"\\n\"\n      + t.label\n      + \"\\n\"\n      + (get(closures, t.def) ?? \"?\")\n      + \":\"\n      + to_string(cases)\n      + \":\"\n      + to_string(cc)\n  }\n  mut kept := Dict[String, Verdict] {}\n  if !no_cache && cache.caching() {\n    for t in targets {\n      match read_verdict(disk, caches, verdict_file(key_of(t))) {\n        Some(v) => mut kept.insert(t.label, v),\n        None => (),\n      }\n    }\n  }\n  // the proofs of earlier runs, for the code as the prover sees it\n  // (`interface_keys`: the callees' contracts, and their bodies only when it\n  // sees through them), with these settings. std's code is keyed by its\n  // hash, the program's by these keys (std's when std is the program).\n  interfaces := interface_keys(disk, sources, methods, target_defs, false)\n  proof_settings := \"loops derived seed \"\n    + to_string(seed)\n    + \" solver \"\n    + solver_id\n    + \" std \"\n    + others\n    + \" package \"\n    + join(\n      items(settings_at(disk, file)).map(p -> p.0 + \"=\" + p.1),\n      \",\",\n    )\n  proof_key_of := (t: Check) -> match get(interfaces, t.def) {\n    Some(k) => Some(proof_settings + \"\\n\" + t.label + \"\\n\" + k),\n    None => None,\n  }\n  mut proved := Dict[String, Verdict] {}\n  if !no_cache && cache.caching() && ctx.solver != \"\" {\n    for t in targets {\n      if !contains(kept, t.label) && t.assumed == \"\" && t.decl is Some {\n        match proof_key_of(t) {\n          Some(k) => match read_verdict(disk, caches, proof_file(k)) {\n            Some(VProven { checks, given }) => mut proved.insert(t.label, VProven { checks, given }),\n            _ => (),\n          },\n          None => (),\n        }\n      }\n    }\n  }\n  timings.end(\"verify: cache keys\")\n  // one driver per function and wrapper still to check. None for one that\n  // is trusted, or that takes a capability (also inside another type:\n  // `Option[Disk]`, a record holding one), which only `strata run` makes.\n  mut keys := []\n  mut outside := Dict[String, String] {}\n  for t in targets {\n    if !contains(kept, t.label)\n      && !(contains(proved, t.label) && cross_of(t) == 0)\n      && !contains(keys, t.key)\n      && !contains(outside, t.key)\n      && t.assumed == \"\" {\n      match t.decl {\n        // (a lemma is only proven, never run)\n        Some(f) => if f.lemma {\n          mut outside.insert(t.key, \"a lemma is never run\")\n        } else {\n          match takes_capability(f, holders) {\n            Some(c) => mut outside.insert(t.key, not_fuzzed(c)),\n            None => mut keys.push(t.key),\n          }\n        },\n        None => mut keys.push(t.key),\n      }\n    }\n  }\n  // a package's own C (`[native]` in strata.toml), built and loaded into\n  // this process for the drivers to call\n  if keys != [] && !ends_with(file, \".strata\") {\n    // (keyed by the package's C and settings, `native_key`; built once)\n    native := cache.own_path(\n      mut disk,\n      caches,\n      \"verify-strata/native/\" + native_key(disk, file) + \".so\",\n    )\n    built := if disk.exists(native) {\n      Ok(true)\n    } else {\n      deps.native_library(mut launcher, mut disk, cc, file, native)\n    }\n    match built {\n      Ok(true) => if jit_load(native).to_int() != 0 {\n        mut console.eprint(\"note: the package's C could not be loaded\")\n      },\n      Ok(false) => (),\n      Err(e) => mut console.eprint(\"note: \" + e),\n    }\n  }\n  (h, why_compiled) := if keys == [] {\n    (-1, Dict[String, String] {})\n  } else {\n    timings.timed(\n      \"verify: compile drivers\",\n      () -> compiled_drivers(disk, sh, pre, file, keys, wrappers),\n    )\n  }\n  mut why := why_compiled\n  for (n, w) in items(outside) {\n    mut why.insert(n, w)\n  }\n  mut index := Dict[String, Int] {}\n  mut k := 0\n  for n in keys {\n    if !contains(why, n) {\n      mut index.insert(n, k)\n      k += 1\n    }\n  }\n  // the package's `[verify]` rules: each rule's modules\n  rules := verify_rules(disk, file)\n  mut violations := []\n  mut trusted := []\n  mut proofs := []\n  // each definition's worst verdict, for its status\n  mut worst := Dict[String, Verdict] {}\n  // what was checked in this run (not cached): proven, fuzzed, or with a\n  // counterexample\n  mut fresh := 0\n  mut fresh_proven := 0\n  mut fresh_fuzzed := 0\n  mut failed := []\n  mut ok := true\n  // the functions the solver checks, a chunk at a time: encoded and their\n  // obligations answered together, the solver runs in parallel\n  mut solved := Dict[String, (smt.Vc, List[smt.Answer])] {}\n  mut found: List[(Check, List[smt.LoopFound])] = []\n  for (ti, t) in enumerate(targets) {\n    if t.assumed == \"\"\n      && !contains(kept, t.label)\n      && !contains(proved, t.label)\n      && !contains(solved, t.label)\n      && ctx.solver != \"\"\n      && solver_checks(t) {\n      chunk := drop(targets, ti).filter(\n        x -> x.assumed == \"\"\n          && !contains(kept, x.label)\n          && !contains(proved, x.label)\n          && solver_checks(x),\n      )\n      timings.begin(\"verify: encode\")\n      solved = solved_together(\n        mut launcher,\n        mut disk,\n        ctx,\n        methods,\n        chunk[..min(len(chunk), solved_chunk())],\n      )\n      timings.end(\"verify: encode\")\n    }\n    label := t.label\n    // (what its loops' searches found; a verdict made with a search cut short\n    // by the budget isn't cached)\n    search_cut := match get(solved, label) {\n      Some((vc, _)) => {\n        if vc.found_loops != [] {\n          mut found.push((t, vc.found_loops))\n        }\n        vc.search_cut\n      },\n      None => false,\n    }\n    status := get(analysis.status, label)\n    // only code shown to terminate is cross-checked: running anything else\n    // may never end\n    cc := match status {\n      Some(termination.Proven(_)) => cross,\n      _ => 0,\n    }\n    fz := (n: Int, b: Option[Int]) -> match get(index, t.key) {\n      Some(i) => timings.timed(if b is Some {\n        \"verify: cross-check\"\n      } else {\n        \"verify: fuzz\"\n      }, () -> fuzz_run(h, i, t.key, t.shown, n, seed, b)),\n      None => FuzzSkipped(get(why, t.key) ?? \"not compiled\"),\n    }\n    cached := contains(kept, label)\n    lawful := (x: Verdict) -> match t.law_of {\n      Some((lw, ty)) => law_verdict(x, lw, ty),\n      None => x,\n    }\n    timings.begin(\"verify: check a function\")\n    v := match get(kept, label) {\n      Some(x) => Some(x),\n      None => match get(proved, label) {\n        // proven before, with what it relies on unchanged: only the cross-check\n        // runs again, since callees' bodies may have changed\n        Some(p) => Some(lawful(cross_checked(p, cc, t.once, fz))),\n        None => if t.assumed != \"\" {\n          Some(VAssumed(t.assumed))\n        } else {\n          match t.decl {\n            Some(f) => match check_fn(\n              mut launcher,\n              mut disk,\n              ctx,\n              methods,\n              get(solved, label),\n              sh,\n              pre,\n              file,\n              wrappers,\n              holders,\n              f,\n              t.key,\n              t.shown,\n              t.once,\n              cases,\n              cc,\n              seed,\n              fz,\n            ) {\n              Some(x) => {\n                if x is VProven && !no_cache && !search_cut {\n                  match proof_key_of(t) {\n                    Some(k) => write_proof(mut disk, caches, k, x),\n                    None => (),\n                  }\n                }\n                Some(lawful(x))\n              },\n              None => None,\n            },\n            // a method only the trait defines: fuzzed\n            None => Some(fuzzed_with(fz(cases, None), 0, [])),\n          }\n        },\n      },\n    }\n    timings.end(\"verify: check a function\")\n    match v {\n      Some(found) => {\n        // (as reported: a function whose only unproven checks are of assumed\n        // contracts is assumed, trusted, cached, and listed in the proofs as found)\n        verdict := assumed_verdict(found, label, assumed_clauses)\n        // (a cached proof cross-checked again is reported as cached)\n        shown_cached := cached || contains(proved, label) && verdict is VProven\n        if !cached && !no_cache && !search_cut {\n          timings.begin(\"verify: cache keys\")\n          write_verdict(mut disk, caches, key_of(t), found)\n          timings.end(\"verify: cache keys\")\n        }\n        def := def_name(t.def)\n        mut worst.insert(\n          def,\n          match get(worst, def) {\n            Some(w) => if verdict_rank(verdict) > verdict_rank(w) {\n              verdict\n            } else {\n              w\n            },\n            None => verdict,\n          },\n        )\n        proofs += proof_lines(label, found).map(\n          l -> def + \"\\t\" + (get(closures, t.def) ?? \"?\") + \"\\t\" + l,\n        )\n        if verdict is VCounterexample {\n          ok = false\n        }\n        if !shown_cached {\n          fresh += 1\n          match verdict {\n            VProven { .. } => {\n              fresh_proven += 1\n            },\n            VFuzzed { .. } => {\n              fresh_fuzzed += 1\n            },\n            VCounterexample { .. } => mut failed.push(\"`\" + label + \"`\"),\n            _ => (),\n          }\n        }\n        if json {\n          mut entries.push(\n            verdict_json(label, verdict, status, shown_cached),\n          )\n        } else if !quiet {\n          for line in report(\n            label,\n            verdict,\n            status,\n            checks_shown,\n            shown_cached,\n            console.paint(std.term.Output),\n            assumed_clauses,\n          ) {\n            print(line)\n          }\n        }\n        if t.law_of == None {\n          // a rule applies from the command line (everywhere) or from strata.toml\n          // (its modules)\n          module := module_of_check(raw, def)\n          from_toml := \" (strata.toml [verify])\"\n          proven_by := if contains(require, \"proven\") {\n            Some(\"\")\n          } else if covers(rules.0, module) {\n            Some(from_toml)\n          } else {\n            None\n          }\n          match proven_by {\n            Some(src) => match verdict {\n              VProven { .. } => (),\n              VAssumed(_) => mut trusted.push(\"`\" + label + \"`\"),\n              _ => mut violations.push(\"`\" + label + \"` is not proven\" + src),\n            },\n            None => (),\n          }\n          terminates_by := if contains(require, \"terminates\") {\n            Some(\"\")\n          } else if covers(rules.1, module) {\n            Some(from_toml)\n          } else {\n            None\n          }\n          match terminates_by {\n            // (an assumed contract left unproven doesn't stop this one)\n            Some(src) => if !(found is VAssumed) && !(found is VSkipped) {\n              match status {\n                Some(termination.Unknown(_)) => mut violations.push(\n                  \"`\" + label + \"` may not terminate\" + src,\n                ),\n                _ => (),\n              }\n            },\n            None => (),\n          }\n          recursion_by := if contains(require, \"no-recursion\") {\n            Some(\"\")\n          } else if covers(rules.2, module) {\n            Some(from_toml)\n          } else {\n            None\n          }\n          match recursion_by {\n            Some(src) => if contains(analysis.recursive, label) {\n              mut violations.push(\"`\" + label + \"` is recursive\" + src)\n            },\n            None => (),\n          }\n        }\n      },\n      None => if !quiet && !json {\n        print(\n          \"? \" + pad(label, 24) + \" not covered by compiler/smt yet\",\n        )\n      },\n    }\n  }\n  // each definition's status (its worst verdict), for the code as it is\n  for (def, w) in items(worst) {\n    write_status(\n      mut disk,\n      caches,\n      def_key(closures, impl_names, def),\n      w,\n    )\n  }\n  // what `build` may leave out: each check proven, for the code as it is. A\n  // definition not checked this time keeps its record while its code is\n  // unchanged.\n  out_proofs := if proofs_at == \"\" {\n    proofs_own(mut disk, caches, file)\n  } else {\n    proofs_at\n  }\n  in_proofs := if proofs_at == \"\" {\n    proofs_read(disk, caches, file)\n  } else {\n    proofs_at\n  }\n  checked := set(targets.map(t -> def_name(t.def)))\n  mut record := []\n  for row in lines(match disk.read(in_proofs) {\n    Ok(text) => text,\n    Err(_) => \"\",\n  }) {\n    fields := split(row, \"\\t\")\n    def := get(fields, 0) ?? \"\"\n    if len(fields) >= 5\n      && !contains(checked, def)\n      && def_key(closures, impl_names, def) == get(fields, 1) ?? \"\" {\n      mut record.push(row + \"\\n\")\n    }\n  }\n  match mut disk.write(out_proofs, join(record + proofs, \"\")) {\n    _ => (),\n  }\n  // (`--show-searches`: what every loop's search took; `verify` searches\n  // none)\n  for l in search_notes(found, budget, show_searches) {\n    mut console.eprint(l)\n  }\n  // (the whole program verified as it is now: `run` has nothing to verify\n  // alongside it)\n  if selection == \"\" {\n    record_verified(mut disk, caches, file)\n  }\n  if json {\n    print(driver.pretty_json(driver.JList(entries)))\n  } else if quiet {\n    if fresh > 0 {\n      mut line := \"verified \"\n        + to_string(fresh)\n        + \" changed: \"\n        + to_string(fresh_proven)\n        + \" proven, \"\n        + to_string(fresh_fuzzed)\n        + \" fuzzed\"\n      if failed != [] {\n        line += \", \"\n          + to_string(len(failed))\n          + \" with a counterexample (\"\n          + join(failed, \", \")\n          + \": see `strata verify`)\"\n      }\n      mut console.eprint(line)\n    }\n  } else {\n    if trusted != [] {\n      print(\"policy: `proven` accepts \"\n        + join(trusted, \", \")\n        + \" as assumed (trusted, not checked)\")\n    }\n    for x in violations {\n      print(\"policy: \" + x)\n    }\n  }\n  if ok && violations == [] {\n    0\n  } else {\n    1\n  }\n}","old_text":"/// `verify [--cases N] [--seed S] [--cross-check N] [--require R] [--checks]\n/// [--no-cache] [--only SELECTION] [--quiet] [--proofs FILE]\n/// [--show-searches] [--load LIB --precompiled NAMES] FILE`: verifies each\n/// function of the script (or of the package,\n/// a folder), each method of its types and implementations, and each law\n/// they must keep. Reports as `strata verify --no-race` does.\n/// \n/// The program is checked first (errors on stderr, exit 1). Then the solver\n/// (compiler/smt) proves what it can, its counterexamples are run to\n/// confirm them, and the rest is fuzzed (compiled, run by c/jit.c).\n/// \n/// - `--only`: the definitions a selection names (`f,g`, `prefix*`,\n/// `module:m`, `slice:f`, a module's name), as `strata verify NAME`.\n/// - `--quiet` (`strata build`): no report, only one line on stderr on the\n/// checks not verified before.\n/// - Verdicts are cached between runs (`(cached)`, `verdict_file`).\n/// Proofs are cached by what they rely on (`proof_file`): when a callee's\n/// body changes but its contract doesn't, its callers' proofs are kept and\n/// only cross-checked again. Each definition's status is kept too\n/// (`status_file`).\n/// - The checks proven are recorded for `proofs` (`proofs_file`, or FILE).\n/// - The package's `[verify]` rules apply to their modules as `--require`\n/// does.\n/// - Loops get the invariants derived from their code and those written\n/// (`invariant`); nothing is searched for. A check failing in or after a\n/// loop that changes what it names says so (`loop_hint`), as does a loop\n/// whose bound isn't shown to go down.\n/// - `--find-invariants BY [--search-budget N] [--log]` (`strata edit` and\n/// `strata fix`, `BY`): only the chosen functions with loops. Where a check\n/// fails after a loop (or a loop isn't shown to end), invariants are\n/// searched for and written into the code (`find_invariants`), logged and\n/// committed with `--log`. Nothing else is checked or reported. All\n/// searches share one budget of the solver's resource units (default\n/// `search_budget`).\n/// \n/// Exit 1 on a counterexample or a broken rule, 2 on a mistake in the\n/// arguments. A function the encoder doesn't cover says so.\nfn verify_file(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  caches: cache.Cache,\n  solver: String,\n  cc: String,\n  args: List[String],\n) -> std.process.ExitCode {\n  mut rest := args\n  mut cases := 200\n  mut seed := 1\n  mut cross := 20\n  mut require := []\n  mut checks_shown := false\n  mut no_cache := false\n  mut proofs_at := \"\"\n  mut budget := search_budget()\n  mut finding := \"\"\n  mut logged := false\n  mut show_searches := false\n  mut loaded := false\n  mut precompiled := \"\"\n  mut selection := \"\"\n  mut quiet := false\n  mut json := false\n  mut entries := []\n  mut go := true\n  while go {\n    match rest {\n      [\"--cases\", n, ..more] => {\n        cases = parse_int(n) ?? cases\n        rest = more\n      },\n      [\"--seed\", n, ..more] => {\n        seed = parse_int(n) ?? seed\n        rest = more\n      },\n      [\"--cross-check\", n, ..more] => {\n        cross = parse_int(n) ?? cross\n        rest = more\n      },\n      [\"--require\", r, ..more] => {\n        require = split(r, \",\").map(x -> trim(x))\n        rest = more\n      },\n      [\"--checks\", ..more] => {\n        checks_shown = true\n        rest = more\n      },\n      [\"--no-cache\", ..more] => {\n        no_cache = true\n        rest = more\n      },\n      [\"--search-budget\", n, ..more] => {\n        budget = parse_int(n) ?? budget\n        rest = more\n      },\n      [\"--find-invariants\", by, ..more] => {\n        finding = by\n        rest = more\n      },\n      [\"--log\", ..more] => {\n        logged = true\n        rest = more\n      },\n      [\"--show-searches\", ..more] => {\n        show_searches = true\n        rest = more\n      },\n      [\"--proofs\", p, ..more] => {\n        proofs_at = p\n        rest = more\n      },\n      [\"--only\", sel, ..more] => {\n        selection = sel\n        rest = more\n      },\n      [\"--quiet\", ..more] => {\n        quiet = true\n        rest = more\n      },\n      // (each verdict as JSON)\n      [\"--json\", ..more] => {\n        json = true\n        rest = more\n      },\n      // std's precompiled library, loaded into the JIT, and its functions'\n      // names: declared in the drivers instead of compiled again\n      [\"--load\", lib, ..more] => {\n        loaded = jit_load(lib).to_int() == 0\n        rest = more\n      },\n      [\"--precompiled\", names, ..more] => {\n        precompiled = names\n        rest = more\n      },\n      _ => {\n        go = false\n      },\n    }\n  }\n  for r in require {\n    if !contains([\"proven\", \"terminates\", \"no-recursion\"], r) {\n      mut console.eprint(\n        \"error: unknown requirement `\"\n          + r\n          + \"` (use proven, terminates, no-recursion)\",\n      )\n      return 2\n    }\n  }\n  file := get(rest, 0) ?? \"\"\n  pre := if loaded && precompiled != \"\" {\n    [\"--precompiled\", precompiled]\n  } else {\n    []\n  }\n  // a script, or a package's folder: each module named by its path\n  sources := source_files(disk, file)\n  if sources == [] {\n    mut console.eprint(\"error: \" + file + \": no module file here\")\n    return 2\n  }\n  // the program must check first, as `strata check` checks it. Its compiles\n  // share the program, read and expanded once.\n  sh := with_base(disk, shared(disk, caches), [file])\n  core := sh.core\n  timings.begin(\"verify: check the program\")\n  errors := if finding != \"\" {\n    []\n  } else {\n    warned(mut console, file_errors(\n      mut launcher,\n      mut disk,\n      caches,\n      \"std\",\n      file,\n      false,\n      core,\n      sh,\n      pre,\n    ))\n  }\n  timings.end(\"verify: check the program\")\n  if errors != [] {\n    for e in errors {\n      mut console.eprint(error_text(e))\n    }\n    return 1\n  }\n  // the traits, capabilities and mocks of the file, std and core\n  raw := own_decls(disk, sources)\n  // the definitions chosen (every one without a selection)\n  chosen := match select_names(raw, selection) {\n    Ok(names) => names,\n    Err(e) => {\n      mut console.eprint(\"error: \" + e)\n      return 2\n    },\n  }\n  std_files := deps.module_files(disk, \"std\").map(f -> \"std/\" + f)\n  context_decls := module_decls(disk, core_files())\n    + std_reached(disk, \"std\", raw)\n    + raw\n  mut traits := []\n  mut impls := []\n  mut caps := Set[String] {}\n  mut mocked := Set[String] {}\n  mut trait_modules := Dict[String, String] {}\n  // (traits and impls with their models as methods, as checked)\n  for d in desugar.with_models(context_decls, []) {\n    match d.kind {\n      ast.TraitDef(t) => {\n        mut traits.push(t)\n        mut trait_modules.insert(t.name, d.module)\n      },\n      ast.ImplDef(i) => mut impls.push(i),\n      ast.CapabilityDef(c) => {\n        mut caps.insert(c.name)\n        // (by the name code uses too: `clock.SystemClock`)\n        if d.module != \"\" && !contains(c.name, \".\") {\n          mut caps.insert(d.module + \".\" + c.name)\n        }\n      },\n      ast.TypeDef(t) => if t.mocked {\n        mut mocked.insert(t.name)\n      },\n      _ => (),\n    }\n  }\n  // the types holding a capability, each with the one it holds\n  holders := capability_holders(context_decls, caps)\n  wrappers := verify_wrappers(raw, traits, impls, caps)\n  (own, fns, types, sigs, all_methods) := verified_with(disk, [file], wrappers)\n  // (the assumed contracts as verify writes them: each check of one is\n  // noted as such)\n  assumed_clauses := assumed_texts(own)\n  scratch := caches.smt\n  cache.make_dirs(mut disk, scratch)\n  // (a solver that can't be run: none, and everything is fuzzed)\n  // (loops' invariants searched for only when finding them: `verify`\n  // and `build` use those derived from the code and those written)\n  ctx := {\n    c := termination.context(\n      fns,\n      types,\n      sigs,\n      all_methods,\n      scratch,\n      if toolchain.has_solver(mut launcher, solver) {\n        solver\n      } else {\n        \"\"\n      },\n    )\n    termination.Ctx { ..c, methods: smt.Methods { ..c.methods, search: if finding != \"\" {\n      2\n    } else {\n      0\n    } } }\n  }\n  // the implementations written as `derive`s, by position, and each\n  // implementation's name (`impl:K`'s definition)\n  mut derived := Set[Int] {}\n  mut impl_names := []\n  for d in raw {\n    match d.kind {\n      ast.ImplDef(i) => {\n        if i.derived {\n          mut derived.insert(len(impl_names))\n        }\n        mut impl_names.push(store.qname(d))\n      },\n      _ => (),\n    }\n  }\n  // each check's definition, by its name as a selection names it\n  def_name := (def: String) -> if starts_with(def, \"fn:\") {\n    drop_bytes(def, 3)\n  } else {\n    get(impl_names, parse_int(drop_bytes(def, 5)) ?? -1) ?? def\n  }\n  targets := checks_of(ctx, own, traits, caps, mocked, trait_modules, derived).filter(\n    t -> contains(chosen, def_name(t.def)),\n  )\n  // termination is analysed for what the chosen checks reach\n  mut roots := Set[String] {}\n  for t in targets {\n    roots = {\n      mut copy := {\n        mut copy := roots\n        mut copy.insert(t.label)\n        copy\n      }\n      mut copy.insert(t.key)\n      copy\n    }\n  }\n  // (each function's loops as earlier runs found them, for its code as the\n  // encoder sees it: `loops_file`)\n  timings.begin(\"verify: cache keys\")\n  own_paths := set(sources.map(s -> s.0))\n  // (the prelude too: it is compiled into every driver)\n  others := std_fingerprint(\n    disk,\n    (core_files() + [\"runtime/prelude.strata\"] + std_files).filter(\n      f -> !contains(own_paths, f),\n    ),\n  )\n  target_defs := set(targets.map(t -> t.def))\n  loop_keys := interface_keys(disk, sources, ctx.methods, target_defs, true)\n  // (the solver by its path and version: a verdict where it gave up is kept\n  // too, since it gives that answer again)\n  solver_id := solver + \" (\" + solver_version(solver) + \")\"\n  loop_settings := \"loops derived solver \"\n    + solver_id\n    + \" std \"\n    + others\n    + \" impls \"\n    + impls_fingerprint(disk, sources)\n    + \" package \"\n    + join(\n      items(settings_at(disk, file)).map(p -> p.0 + \"=\" + p.1),\n      \",\",\n    )\n  // (std's and core's own definitions: keyed by their names and std's code\n  // as a whole, `others`, so what std's loops and recursion take is found\n  // once and shipped with std)\n  library := library_names(\n    disk,\n    (core_files() + std_files).filter(f -> !contains(own_paths, f)),\n  )\n  loop_key := (n: String) -> match get(loop_keys, \"fn:\" + n) {\n    Some(k) => Some(loop_settings + \"\\n\" + n + \"\\n\" + k),\n    None => if contains(library, n) {\n      Some(loop_settings + \"\\n\" + n + \"\\nlibrary\")\n    } else {\n      None\n    },\n  }\n  reuse := !no_cache && finding == \"\" && cache.caching() && ctx.solver != \"\"\n  known := (n: String) -> if reuse {\n    match loop_key(n) {\n      Some(k) => match cache.read_entry(disk, caches, loops_file(k)) {\n        Some(text) => loops_of_text(text),\n        None => None,\n      },\n      None => None,\n    }\n  } else {\n    None\n  }\n  known_measure := (n: String) -> if reuse {\n    match loop_key(n) {\n      Some(k) => match cache.read_entry(disk, caches, measure_file(k)) {\n        Some(text) => Some(if text == \"none\" {\n          None\n        } else {\n          Some(text)\n        }),\n        None => None,\n      },\n      None => None,\n    }\n  } else {\n    None\n  }\n  timings.end(\"verify: cache keys\")\n  // (one budget for every loop-invariant search of the run: termination's\n  // and verification's)\n  smt.set_search_budget(budget)\n  timings.begin(\"verify: termination\")\n  (analysis, learned, measured) := termination.analyze_with(\n    mut launcher,\n    mut disk,\n    ctx,\n    Some(roots),\n    known,\n    known_measure,\n  )\n  timings.end(\"verify: termination\")\n  if !no_cache && finding == \"\" && ctx.solver != \"\" && cache.caching() {\n    for (n, x) in items(learned) {\n      match loop_key(n) {\n        Some(k) => write_loops(mut disk, caches, k, x),\n        None => (),\n      }\n    }\n    for (n, m) in items(measured) {\n      match loop_key(n) {\n        Some(k) => match cache.write_entry(\n          mut disk,\n          caches,\n          measure_file(k),\n          m ?? \"none\",\n        ) {\n          _ => (),\n        },\n        None => (),\n      }\n    }\n  }\n  methods := smt.Methods { ..termination.seen_through(ctx, analysis), examples: true }\n  // finding loops' invariants (`strata edit`, `strata fix`): nothing else\n  if finding != \"\" {\n    if ctx.solver == \"\" {\n      return 0\n    }\n    wrote := find_invariants(\n      mut console,\n      mut launcher,\n      mut disk,\n      file,\n      raw,\n      sh.core,\n      ctx,\n      methods,\n      analysis,\n      targets,\n      finding,\n      budget,\n      show_searches,\n      logged,\n    )\n    // (exit 3: nothing written)\n    return if wrote {\n      0\n    } else {\n      3\n    }\n  }\n  // the verdicts of earlier runs with these settings, for the code as it\n  // is now (each check's definition with all it depends on)\n  timings.begin(\"verify: cache keys\")\n  closures := closure_keys_of(disk, sources, target_defs)\n  // (`--no-cache` checks again; the package's settings, which std's code\n  // reads)\n  settings := \"loops derived seed \"\n    + to_string(seed)\n    + \" solver \"\n    + solver_id\n    + \" std \"\n    + std_fingerprint(\n      disk,\n      core_files() + [\"runtime/prelude.strata\"] + std_files,\n    )\n    + \" package \"\n    + join(\n      items(settings_at(disk, file)).map(p -> p.0 + \"=\" + p.1),\n      \",\",\n    )\n  cross_of := (t: Check) -> match get(analysis.status, t.label) {\n    Some(termination.Proven(_)) => cross,\n    _ => 0,\n  }\n  key_of := (t: Check) -> {\n    cc := cross_of(t)\n    settings\n      + \"\\n\"\n      + t.label\n      + \"\\n\"\n      + (get(closures, t.def) ?? \"?\")\n      + \":\"\n      + to_string(cases)\n      + \":\"\n      + to_string(cc)\n  }\n  mut kept := Dict[String, Verdict] {}\n  if !no_cache && cache.caching() {\n    for t in targets {\n      match read_verdict(disk, caches, verdict_file(key_of(t))) {\n        Some(v) => mut kept.insert(t.label, v),\n        None => (),\n      }\n    }\n  }\n  // the proofs of earlier runs, for the code as the prover sees it\n  // (`interface_keys`: the callees' contracts, and their bodies only when it\n  // sees through them), with these settings. std's code is keyed by its\n  // hash, the program's by these keys (std's when std is the program).\n  interfaces := interface_keys(disk, sources, methods, target_defs, false)\n  proof_settings := \"loops derived seed \"\n    + to_string(seed)\n    + \" solver \"\n    + solver_id\n    + \" std \"\n    + others\n    + \" package \"\n    + join(\n      items(settings_at(disk, file)).map(p -> p.0 + \"=\" + p.1),\n      \",\",\n    )\n  proof_key_of := (t: Check) -> match get(interfaces, t.def) {\n    Some(k) => Some(proof_settings + \"\\n\" + t.label + \"\\n\" + k),\n    None => None,\n  }\n  mut proved := Dict[String, Verdict] {}\n  if !no_cache && cache.caching() && ctx.solver != \"\" {\n    for t in targets {\n      if !contains(kept, t.label) && t.assumed == \"\" && t.decl is Some {\n        match proof_key_of(t) {\n          Some(k) => match read_verdict(disk, caches, proof_file(k)) {\n            Some(VProven { checks, given }) => mut proved.insert(t.label, VProven { checks, given }),\n            _ => (),\n          },\n          None => (),\n        }\n      }\n    }\n  }\n  timings.end(\"verify: cache keys\")\n  // one driver per function and wrapper still to check. None for one that\n  // is trusted, or that takes a capability (also inside another type:\n  // `Option[Disk]`, a record holding one), which only `strata run` makes.\n  mut keys := []\n  mut outside := Dict[String, String] {}\n  for t in targets {\n    if !contains(kept, t.label)\n      && !(contains(proved, t.label) && cross_of(t) == 0)\n      && !contains(keys, t.key)\n      && !contains(outside, t.key)\n      && t.assumed == \"\" {\n      match t.decl {\n        Some(f) => match takes_capability(f, holders) {\n          Some(c) => mut outside.insert(t.key, not_fuzzed(c)),\n          None => mut keys.push(t.key),\n        },\n        None => mut keys.push(t.key),\n      }\n    }\n  }\n  // a package's own C (`[native]` in strata.toml), built and loaded into\n  // this process for the drivers to call\n  if keys != [] && !ends_with(file, \".strata\") {\n    // (keyed by the package's C and settings, `native_key`; built once)\n    native := cache.own_path(\n      mut disk,\n      caches,\n      \"verify-strata/native/\" + native_key(disk, file) + \".so\",\n    )\n    built := if disk.exists(native) {\n      Ok(true)\n    } else {\n      deps.native_library(mut launcher, mut disk, cc, file, native)\n    }\n    match built {\n      Ok(true) => if jit_load(native).to_int() != 0 {\n        mut console.eprint(\"note: the package's C could not be loaded\")\n      },\n      Ok(false) => (),\n      Err(e) => mut console.eprint(\"note: \" + e),\n    }\n  }\n  (h, why_compiled) := if keys == [] {\n    (-1, Dict[String, String] {})\n  } else {\n    timings.timed(\n      \"verify: compile drivers\",\n      () -> compiled_drivers(disk, sh, pre, file, keys, wrappers),\n    )\n  }\n  mut why := why_compiled\n  for (n, w) in items(outside) {\n    mut why.insert(n, w)\n  }\n  mut index := Dict[String, Int] {}\n  mut k := 0\n  for n in keys {\n    if !contains(why, n) {\n      mut index.insert(n, k)\n      k += 1\n    }\n  }\n  // the package's `[verify]` rules: each rule's modules\n  rules := verify_rules(disk, file)\n  mut violations := []\n  mut trusted := []\n  mut proofs := []\n  // each definition's worst verdict, for its status\n  mut worst := Dict[String, Verdict] {}\n  // what was checked in this run (not cached): proven, fuzzed, or with a\n  // counterexample\n  mut fresh := 0\n  mut fresh_proven := 0\n  mut fresh_fuzzed := 0\n  mut failed := []\n  mut ok := true\n  // the functions the solver checks, a chunk at a time: encoded and their\n  // obligations answered together, the solver runs in parallel\n  mut solved := Dict[String, (smt.Vc, List[smt.Answer])] {}\n  mut found: List[(Check, List[smt.LoopFound])] = []\n  for (ti, t) in enumerate(targets) {\n    if t.assumed == \"\"\n      && !contains(kept, t.label)\n      && !contains(proved, t.label)\n      && !contains(solved, t.label)\n      && ctx.solver != \"\"\n      && solver_checks(t) {\n      chunk := drop(targets, ti).filter(\n        x -> x.assumed == \"\"\n          && !contains(kept, x.label)\n          && !contains(proved, x.label)\n          && solver_checks(x),\n      )\n      timings.begin(\"verify: encode\")\n      solved = solved_together(\n        mut launcher,\n        mut disk,\n        ctx,\n        methods,\n        chunk[..min(len(chunk), solved_chunk())],\n      )\n      timings.end(\"verify: encode\")\n    }\n    label := t.label\n    // (what its loops' searches found; a verdict made with a search cut short\n    // by the budget isn't cached)\n    search_cut := match get(solved, label) {\n      Some((vc, _)) => {\n        if vc.found_loops != [] {\n          mut found.push((t, vc.found_loops))\n        }\n        vc.search_cut\n      },\n      None => false,\n    }\n    status := get(analysis.status, label)\n    // only code shown to terminate is cross-checked: running anything else\n    // may never end\n    cc := match status {\n      Some(termination.Proven(_)) => cross,\n      _ => 0,\n    }\n    fz := (n: Int, b: Option[Int]) -> match get(index, t.key) {\n      Some(i) => timings.timed(if b is Some {\n        \"verify: cross-check\"\n      } else {\n        \"verify: fuzz\"\n      }, () -> fuzz_run(h, i, t.key, t.shown, n, seed, b)),\n      None => FuzzSkipped(get(why, t.key) ?? \"not compiled\"),\n    }\n    cached := contains(kept, label)\n    lawful := (x: Verdict) -> match t.law_of {\n      Some((lw, ty)) => law_verdict(x, lw, ty),\n      None => x,\n    }\n    timings.begin(\"verify: check a function\")\n    v := match get(kept, label) {\n      Some(x) => Some(x),\n      None => match get(proved, label) {\n        // proven before, with what it relies on unchanged: only the cross-check\n        // runs again, since callees' bodies may have changed\n        Some(p) => Some(lawful(cross_checked(p, cc, t.once, fz))),\n        None => if t.assumed != \"\" {\n          Some(VAssumed(t.assumed))\n        } else {\n          match t.decl {\n            Some(f) => match check_fn(\n              mut launcher,\n              mut disk,\n              ctx,\n              methods,\n              get(solved, label),\n              sh,\n              pre,\n              file,\n              wrappers,\n              holders,\n              f,\n              t.key,\n              t.shown,\n              t.once,\n              cases,\n              cc,\n              seed,\n              fz,\n            ) {\n              Some(x) => {\n                if x is VProven && !no_cache && !search_cut {\n                  match proof_key_of(t) {\n                    Some(k) => write_proof(mut disk, caches, k, x),\n                    None => (),\n                  }\n                }\n                Some(lawful(x))\n              },\n              None => None,\n            },\n            // a method only the trait defines: fuzzed\n            None => Some(fuzzed_with(fz(cases, None), 0, [])),\n          }\n        },\n      },\n    }\n    timings.end(\"verify: check a function\")\n    match v {\n      Some(found) => {\n        // (as reported: a function whose only unproven checks are of assumed\n        // contracts is assumed, trusted, cached, and listed in the proofs as found)\n        verdict := assumed_verdict(found, label, assumed_clauses)\n        // (a cached proof cross-checked again is reported as cached)\n        shown_cached := cached || contains(proved, label) && verdict is VProven\n        if !cached && !no_cache && !search_cut {\n          timings.begin(\"verify: cache keys\")\n          write_verdict(mut disk, caches, key_of(t), found)\n          timings.end(\"verify: cache keys\")\n        }\n        def := def_name(t.def)\n        mut worst.insert(\n          def,\n          match get(worst, def) {\n            Some(w) => if verdict_rank(verdict) > verdict_rank(w) {\n              verdict\n            } else {\n              w\n            },\n            None => verdict,\n          },\n        )\n        proofs += proof_lines(label, found).map(\n          l -> def + \"\\t\" + (get(closures, t.def) ?? \"?\") + \"\\t\" + l,\n        )\n        if verdict is VCounterexample {\n          ok = false\n        }\n        if !shown_cached {\n          fresh += 1\n          match verdict {\n            VProven { .. } => {\n              fresh_proven += 1\n            },\n            VFuzzed { .. } => {\n              fresh_fuzzed += 1\n            },\n            VCounterexample { .. } => mut failed.push(\"`\" + label + \"`\"),\n            _ => (),\n          }\n        }\n        if json {\n          mut entries.push(\n            verdict_json(label, verdict, status, shown_cached),\n          )\n        } else if !quiet {\n          for line in report(\n            label,\n            verdict,\n            status,\n            checks_shown,\n            shown_cached,\n            console.paint(std.term.Output),\n            assumed_clauses,\n          ) {\n            print(line)\n          }\n        }\n        if t.law_of == None {\n          // a rule applies from the command line (everywhere) or from strata.toml\n          // (its modules)\n          module := module_of_check(raw, def)\n          from_toml := \" (strata.toml [verify])\"\n          proven_by := if contains(require, \"proven\") {\n            Some(\"\")\n          } else if covers(rules.0, module) {\n            Some(from_toml)\n          } else {\n            None\n          }\n          match proven_by {\n            Some(src) => match verdict {\n              VProven { .. } => (),\n              VAssumed(_) => mut trusted.push(\"`\" + label + \"`\"),\n              _ => mut violations.push(\"`\" + label + \"` is not proven\" + src),\n            },\n            None => (),\n          }\n          terminates_by := if contains(require, \"terminates\") {\n            Some(\"\")\n          } else if covers(rules.1, module) {\n            Some(from_toml)\n          } else {\n            None\n          }\n          match terminates_by {\n            // (an assumed contract left unproven doesn't stop this one)\n            Some(src) => if !(found is VAssumed) && !(found is VSkipped) {\n              match status {\n                Some(termination.Unknown(_)) => mut violations.push(\n                  \"`\" + label + \"` may not terminate\" + src,\n                ),\n                _ => (),\n              }\n            },\n            None => (),\n          }\n          recursion_by := if contains(require, \"no-recursion\") {\n            Some(\"\")\n          } else if covers(rules.2, module) {\n            Some(from_toml)\n          } else {\n            None\n          }\n          match recursion_by {\n            Some(src) => if contains(analysis.recursive, label) {\n              mut violations.push(\"`\" + label + \"` is recursive\" + src)\n            },\n            None => (),\n          }\n        }\n      },\n      None => if !quiet && !json {\n        print(\n          \"? \" + pad(label, 24) + \" not covered by compiler/smt yet\",\n        )\n      },\n    }\n  }\n  // each definition's status (its worst verdict), for the code as it is\n  for (def, w) in items(worst) {\n    write_status(\n      mut disk,\n      caches,\n      def_key(closures, impl_names, def),\n      w,\n    )\n  }\n  // what `build` may leave out: each check proven, for the code as it is. A\n  // definition not checked this time keeps its record while its code is\n  // unchanged.\n  out_proofs := if proofs_at == \"\" {\n    proofs_own(mut disk, caches, file)\n  } else {\n    proofs_at\n  }\n  in_proofs := if proofs_at == \"\" {\n    proofs_read(disk, caches, file)\n  } else {\n    proofs_at\n  }\n  checked := set(targets.map(t -> def_name(t.def)))\n  mut record := []\n  for row in lines(match disk.read(in_proofs) {\n    Ok(text) => text,\n    Err(_) => \"\",\n  }) {\n    fields := split(row, \"\\t\")\n    def := get(fields, 0) ?? \"\"\n    if len(fields) >= 5\n      && !contains(checked, def)\n      && def_key(closures, impl_names, def) == get(fields, 1) ?? \"\" {\n      mut record.push(row + \"\\n\")\n    }\n  }\n  match mut disk.write(out_proofs, join(record + proofs, \"\")) {\n    _ => (),\n  }\n  // (`--show-searches`: what every loop's search took; `verify` searches\n  // none)\n  for l in search_notes(found, budget, show_searches) {\n    mut console.eprint(l)\n  }\n  // (the whole program verified as it is now: `run` has nothing to verify\n  // alongside it)\n  if selection == \"\" {\n    record_verified(mut disk, caches, file)\n  }\n  if json {\n    print(driver.pretty_json(driver.JList(entries)))\n  } else if quiet {\n    if fresh > 0 {\n      mut line := \"verified \"\n        + to_string(fresh)\n        + \" changed: \"\n        + to_string(fresh_proven)\n        + \" proven, \"\n        + to_string(fresh_fuzzed)\n        + \" fuzzed\"\n      if failed != [] {\n        line += \", \"\n          + to_string(len(failed))\n          + \" with a counterexample (\"\n          + join(failed, \", \")\n          + \": see `strata verify`)\"\n      }\n      mut console.eprint(line)\n    }\n  } else {\n    if trusted != [] {\n      print(\"policy: `proven` accepts \"\n        + join(trusted, \", \")\n        + \" as assumed (trusted, not checked)\")\n    }\n    for x in violations {\n      print(\"policy: \" + x)\n    }\n  }\n  if ok && violations == [] {\n    0\n  } else {\n    1\n  }\n}"},{"name":"check_fn","kind":"fn","old":"03939dc9e8903112","new":"98a0a16a737a6a3b","interface_changed":false,"affected":[],"module":"","text":"/// The layered check of a function, without the race. The solver proves\n/// what it can, its counterexamples are confirmed by running them (through\n/// `key`, named `shown` in messages), and the rest is fuzzed. Proven code\n/// is still run a little (`cross`). `once` means every run is the same\n/// (no parameters). `None` when the encoder doesn't cover it.\nfn check_fn(\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  ctx: termination.Ctx,\n  methods: smt.Methods,\n  solved: Option[(smt.Vc, List[smt.Answer])],\n  sh: Shared,\n  pre: List[String],\n  file: String,\n  extra: List[ast.Decl],\n  holders: Dict[String, String],\n  f: ast.FnDecl,\n  key: String,\n  shown: String,\n  once: Bool,\n  cases0: Int,\n  cross0: Int,\n  seed: Int,\n  fz: (Int, Option[Int]) -> Fuzzing,\n) -> Option[Verdict] {\n  // a compiled value's address (core.values' `Raw`): only what compiled code\n  // made is read, so it is never run on made-up values, nor on a solver's\n  // counterexample\n  if takes_raw(f) {\n    return Some(\n      VAssumed(\n        \"it reads compiled values (`Raw`), which only compiled code makes: it isn't run on made-up ones\",\n      ),\n    )\n  }\n  // no parameters: every run is the same run, so once is enough\n  (cases, cross) := if once {\n    (min(cases0, 1), min(cross0, 1))\n  } else {\n    (cases0, cross0)\n  }\n  if has_hole(f.body) {\n    return Some(fuzzed_with(fz(cases, None), 0, []))\n  }\n  // no solver to run: everything is fuzzed\n  if ctx.solver == \"\" {\n    return Some(fuzzed_with(\n      fz(cases, None),\n      0,\n      [\"no SMT solver was found (install z3)\"],\n    ))\n  }\n  (vc, given) := match solved {\n    Some((v, answers)) => (v, Some(answers)),\n    None => (smt.encode(\n      mut launcher,\n      mut disk,\n      ctx.scratch,\n      ctx.solver,\n      ctx.fns,\n      ctx.types,\n      ctx.sigs,\n      methods,\n      f,\n      f.name,\n    ), None),\n  }\n  // (what the encoder can't express is said, and counts as not proven for\n  // `--require proven`)\n  match get(vc.gaps, 0) {\n    Some(g) => return Some(VSkipped(\"not covered by compiler/smt yet: \" + g)),\n    None => (),\n  }\n  mut proven := []\n  mut unproven := []\n  mut open := []\n  all_answers := match given {\n    Some(a) => a,\n    None => smt.obligation_answers(\n      mut launcher,\n      mut disk,\n      ctx.scratch,\n      ctx.solver,\n      vc,\n    ),\n  }\n  if f.lemma {\n    return Some(lemma_verdict(vc, all_answers))\n  }\n  for (k, a) in enumerate(all_answers) {\n    // (in or after a loop whose invariants may not say enough: how to go\n    // on)\n    hint := loop_hint(vc, k, a.what, shown)\n    if a.outcome == \"proven\" {\n      mut proven.push(a.what)\n    } else if a.outcome == \"refuted\" {\n      match timings.timed(\"verify: replay\", () -> replay(\n        disk,\n        sh,\n        pre,\n        file,\n        extra,\n        f,\n        key,\n        shown,\n        a.args.map(x -> x.1),\n      )) {\n        Some(VCounterexample { args, kind, message, .. }) => return Some(\n          VCounterexample {\n            args,\n            kind,\n            message,\n            found_by: \"solver\",\n          },\n        ),\n        _ => {\n          mut unproven.push(\n            a.what\n              + \": \"\n              + a.message\n              + \", but running it did not fail\"\n              + hint,\n          )\n          mut open.push(a.what)\n        },\n      }\n    } else {\n      mut unproven.push(a.what + \": \" + a.message + hint)\n      mut open.push(a.what)\n    }\n  }\n  for g in to_list(vc.relied_on) {\n    mut proven.push(\n      \"(seeing through `\"\n        + g\n        + \"`, assuming it terminates as marked)\",\n    )\n  }\n  proven += vc.invariants\n  v := if unproven == [] {\n    // a safety net for the prover: proven code is still run a little\n    mut out := VProven { checks: proven, given: vc.given }\n    if cross > 0 {\n      match fz(cross, Some(200000)) {\n        FuzzFailed { kind, message, args } => {\n          out = VCounterexample {\n            args,\n            kind,\n            message: prover_bug(message),\n            found_by: \"cross-check\",\n          }\n        },\n        _ => (),\n      }\n    }\n    out\n  } else {\n    match or_solver_inputs(\n      mut launcher,\n      mut disk,\n      ctx,\n      methods,\n      sh,\n      pre,\n      file,\n      extra,\n      f,\n      key,\n      shown,\n      cases,\n      seed,\n      fz(cases, None),\n    ) {\n      Err(failed) => failed,\n      Ok(fuzzed) => match fuzzed_with(fuzzed, len(proven), unproven) {\n        VFuzzed { cases: c, discarded, .. } => VFuzzed {\n          cases: c,\n          discarded,\n          proven: len(proven),\n          unproven,\n          checks: proven + vc.given,\n          open,\n        },\n        other => other,\n      },\n    }\n  }\n  // (what the solver leaves of a function taking a capability can't be run)\n  Some(match (v, takes_capability(f, holders)) {\n    (VSkipped(reason), Some(c)) => {\n      parts := split(reason, \"; not proven: \")\n      rest2 := if len(parts) > 1 {\n        \"; not proven: \" + join(drop(parts, 1), \"; not proven: \")\n      } else {\n        \"\"\n      }\n      VSkipped(not_fuzzed(c) + rest2)\n    },\n    (other, _) => other,\n  })\n}","old_text":"/// The layered check of a function, without the race. The solver proves\n/// what it can, its counterexamples are confirmed by running them (through\n/// `key`, named `shown` in messages), and the rest is fuzzed. Proven code\n/// is still run a little (`cross`). `once` means every run is the same\n/// (no parameters). `None` when the encoder doesn't cover it.\nfn check_fn(\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  ctx: termination.Ctx,\n  methods: smt.Methods,\n  solved: Option[(smt.Vc, List[smt.Answer])],\n  sh: Shared,\n  pre: List[String],\n  file: String,\n  extra: List[ast.Decl],\n  holders: Dict[String, String],\n  f: ast.FnDecl,\n  key: String,\n  shown: String,\n  once: Bool,\n  cases0: Int,\n  cross0: Int,\n  seed: Int,\n  fz: (Int, Option[Int]) -> Fuzzing,\n) -> Option[Verdict] {\n  // a compiled value's address (core.values' `Raw`): only what compiled code\n  // made is read, so it is never run on made-up values, nor on a solver's\n  // counterexample\n  if takes_raw(f) {\n    return Some(\n      VAssumed(\n        \"it reads compiled values (`Raw`), which only compiled code makes: it isn't run on made-up ones\",\n      ),\n    )\n  }\n  // no parameters: every run is the same run, so once is enough\n  (cases, cross) := if once {\n    (min(cases0, 1), min(cross0, 1))\n  } else {\n    (cases0, cross0)\n  }\n  if has_hole(f.body) {\n    return Some(fuzzed_with(fz(cases, None), 0, []))\n  }\n  // no solver to run: everything is fuzzed\n  if ctx.solver == \"\" {\n    return Some(fuzzed_with(\n      fz(cases, None),\n      0,\n      [\"no SMT solver was found (install z3)\"],\n    ))\n  }\n  (vc, given) := match solved {\n    Some((v, answers)) => (v, Some(answers)),\n    None => (smt.encode(\n      mut launcher,\n      mut disk,\n      ctx.scratch,\n      ctx.solver,\n      ctx.fns,\n      ctx.types,\n      ctx.sigs,\n      methods,\n      f,\n      f.name,\n    ), None),\n  }\n  // (what the encoder can't express is said, and counts as not proven for\n  // `--require proven`)\n  match get(vc.gaps, 0) {\n    Some(g) => return Some(VSkipped(\"not covered by compiler/smt yet: \" + g)),\n    None => (),\n  }\n  mut proven := []\n  mut unproven := []\n  mut open := []\n  all_answers := match given {\n    Some(a) => a,\n    None => smt.obligation_answers(\n      mut launcher,\n      mut disk,\n      ctx.scratch,\n      ctx.solver,\n      vc,\n    ),\n  }\n  for (k, a) in enumerate(all_answers) {\n    // (in or after a loop whose invariants may not say enough: how to go\n    // on)\n    hint := loop_hint(vc, k, a.what, shown)\n    if a.outcome == \"proven\" {\n      mut proven.push(a.what)\n    } else if a.outcome == \"refuted\" {\n      match timings.timed(\"verify: replay\", () -> replay(\n        disk,\n        sh,\n        pre,\n        file,\n        extra,\n        f,\n        key,\n        shown,\n        a.args.map(x -> x.1),\n      )) {\n        Some(VCounterexample { args, kind, message, .. }) => return Some(\n          VCounterexample {\n            args,\n            kind,\n            message,\n            found_by: \"solver\",\n          },\n        ),\n        _ => {\n          mut unproven.push(\n            a.what\n              + \": \"\n              + a.message\n              + \", but running it did not fail\"\n              + hint,\n          )\n          mut open.push(a.what)\n        },\n      }\n    } else {\n      mut unproven.push(a.what + \": \" + a.message + hint)\n      mut open.push(a.what)\n    }\n  }\n  for g in to_list(vc.relied_on) {\n    mut proven.push(\n      \"(seeing through `\"\n        + g\n        + \"`, assuming it terminates as marked)\",\n    )\n  }\n  proven += vc.invariants\n  v := if unproven == [] {\n    // a safety net for the prover: proven code is still run a little\n    mut out := VProven { checks: proven, given: vc.given }\n    if cross > 0 {\n      match fz(cross, Some(200000)) {\n        FuzzFailed { kind, message, args } => {\n          out = VCounterexample {\n            args,\n            kind,\n            message: prover_bug(message),\n            found_by: \"cross-check\",\n          }\n        },\n        _ => (),\n      }\n    }\n    out\n  } else {\n    match or_solver_inputs(\n      mut launcher,\n      mut disk,\n      ctx,\n      methods,\n      sh,\n      pre,\n      file,\n      extra,\n      f,\n      key,\n      shown,\n      cases,\n      seed,\n      fz(cases, None),\n    ) {\n      Err(failed) => failed,\n      Ok(fuzzed) => match fuzzed_with(fuzzed, len(proven), unproven) {\n        VFuzzed { cases: c, discarded, .. } => VFuzzed {\n          cases: c,\n          discarded,\n          proven: len(proven),\n          unproven,\n          checks: proven + vc.given,\n          open,\n        },\n        other => other,\n      },\n    }\n  }\n  // (what the solver leaves of a function taking a capability can't be run)\n  Some(match (v, takes_capability(f, holders)) {\n    (VSkipped(reason), Some(c)) => {\n      parts := split(reason, \"; not proven: \")\n      rest2 := if len(parts) > 1 {\n        \"; not proven: \" + join(drop(parts, 1), \"; not proven: \")\n      } else {\n        \"\"\n      }\n      VSkipped(not_fuzzed(c) + rest2)\n    },\n    (other, _) => other,\n  })\n}"},{"name":"lemma_verdict","kind":"fn","old":null,"new":"e70299bd345449d3","interface_changed":true,"affected":[],"module":"","text":"/// A lemma's verdict: proven, or not. It is never run (never compiled), so a\n/// solver's counterexample is its verdict as found, and what the solver\n/// leaves open stays open (incomplete), never fuzzed.\nfn lemma_verdict(vc: smt.Vc, answers: List[smt.Answer]) -> Verdict {\n  mut proven := []\n  mut open := []\n  for a in answers {\n    if a.outcome == \"proven\" {\n      mut proven.push(a.what)\n    } else if a.outcome == \"refuted\" {\n      return VCounterexample {\n        args: a.args.map(x -> x.0 + \" = \" + text.expr_text(x.1, 0)),\n        kind: \"Lemma\",\n        message: \"not proven: \" + a.what + \": \" + a.message,\n        found_by: \"solver\",\n      }\n    } else {\n      mut open.push(a.what + \": \" + a.message)\n    }\n  }\n  if open == [] {\n    VProven { checks: proven + vc.invariants, given: vc.given }\n  } else {\n    VIncomplete(\"a lemma is proven or not, never run: not proven: \"\n      + join(open, \"; \"))\n  }\n}"}]}
{"id":"42b874f7c2ba06ee","time":1795665400,"message":"edit","changes":[{"name":"verify_file","kind":"fn","old":"acd38452af0682fa","new":"49739def25d2f83f","interface_changed":false,"affected":[],"module":"","text":"/// `verify [--cases N] [--seed S] [--cross-check N] [--require R] [--checks]\n/// [--no-cache] [--only SELECTION] [--quiet] [--proofs FILE]\n/// [--show-searches] [--load LIB --precompiled NAMES] FILE`: verifies each\n/// function of the script (or of the package,\n/// a folder), each method of its types and implementations, and each law\n/// they must keep. Reports as `strata verify --no-race` does.\n/// \n/// The program is checked first (errors on stderr, exit 1). Then the solver\n/// (compiler/smt) proves what it can, its counterexamples are run to\n/// confirm them, and the rest is fuzzed (compiled, run by c/jit.c).\n/// \n/// - `--only`: the definitions a selection names (`f,g`, `prefix*`,\n/// `module:m`, `slice:f`, a module's name), as `strata verify NAME`.\n/// - `--quiet` (`strata build`): no report, only one line on stderr on the\n/// checks not verified before.\n/// - Verdicts are cached between runs (`(cached)`, `verdict_file`).\n/// Proofs are cached by what they rely on (`proof_file`): when a callee's\n/// body changes but its contract doesn't, its callers' proofs are kept and\n/// only cross-checked again. Each definition's status is kept too\n/// (`status_file`).\n/// - The checks proven are recorded for `proofs` (`proofs_file`, or FILE).\n/// - The package's `[verify]` rules apply to their modules as `--require`\n/// does.\n/// - Loops get the invariants derived from their code and those written\n/// (`invariant`); nothing is searched for. A check failing in or after a\n/// loop that changes what it names says so (`loop_hint`), as does a loop\n/// whose bound isn't shown to go down.\n/// - `--find-invariants BY [--search-budget N] [--log]` (`strata edit` and\n/// `strata fix`, `BY`): only the chosen functions with loops. Where a check\n/// fails after a loop (or a loop isn't shown to end), invariants are\n/// searched for and written into the code (`find_invariants`), logged and\n/// committed with `--log`. Nothing else is checked or reported. All\n/// searches share one budget of the solver's resource units (default\n/// `search_budget`).\n/// \n/// Exit 1 on a counterexample or a broken rule, 2 on a mistake in the\n/// arguments. A function the encoder doesn't cover says so.\nfn verify_file(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  caches: cache.Cache,\n  solver: String,\n  cc: String,\n  args: List[String],\n) -> std.process.ExitCode {\n  mut rest := args\n  mut cases := 200\n  mut seed := 1\n  mut cross := 20\n  mut require := []\n  mut checks_shown := false\n  mut no_cache := false\n  mut proofs_at := \"\"\n  mut budget := search_budget()\n  mut finding := \"\"\n  mut logged := false\n  mut show_searches := false\n  mut loaded := false\n  mut precompiled := \"\"\n  mut selection := \"\"\n  mut quiet := false\n  mut json := false\n  mut entries := []\n  mut go := true\n  while go {\n    match rest {\n      [\"--cases\", n, ..more] => {\n        cases = parse_int(n) ?? cases\n        rest = more\n      },\n      [\"--seed\", n, ..more] => {\n        seed = parse_int(n) ?? seed\n        rest = more\n      },\n      [\"--cross-check\", n, ..more] => {\n        cross = parse_int(n) ?? cross\n        rest = more\n      },\n      [\"--require\", r, ..more] => {\n        require = split(r, \",\").map(x -> trim(x))\n        rest = more\n      },\n      [\"--checks\", ..more] => {\n        checks_shown = true\n        rest = more\n      },\n      [\"--no-cache\", ..more] => {\n        no_cache = true\n        rest = more\n      },\n      [\"--search-budget\", n, ..more] => {\n        budget = parse_int(n) ?? budget\n        rest = more\n      },\n      [\"--find-invariants\", by, ..more] => {\n        finding = by\n        rest = more\n      },\n      [\"--log\", ..more] => {\n        logged = true\n        rest = more\n      },\n      [\"--show-searches\", ..more] => {\n        show_searches = true\n        rest = more\n      },\n      [\"--proofs\", p, ..more] => {\n        proofs_at = p\n        rest = more\n      },\n      [\"--only\", sel, ..more] => {\n        selection = sel\n        rest = more\n      },\n      [\"--quiet\", ..more] => {\n        quiet = true\n        rest = more\n      },\n      // (each verdict as JSON)\n      [\"--json\", ..more] => {\n        json = true\n        rest = more\n      },\n      // std's precompiled library, loaded into the JIT, and its functions'\n      // names: declared in the drivers instead of compiled again\n      [\"--load\", lib, ..more] => {\n        loaded = jit_load(lib).to_int() == 0\n        rest = more\n      },\n      [\"--precompiled\", names, ..more] => {\n        precompiled = names\n        rest = more\n      },\n      _ => {\n        go = false\n      },\n    }\n  }\n  for r in require {\n    if !contains([\"proven\", \"terminates\", \"no-recursion\"], r) {\n      mut console.eprint(\n        \"error: unknown requirement `\"\n          + r\n          + \"` (use proven, terminates, no-recursion)\",\n      )\n      return 2\n    }\n  }\n  file := get(rest, 0) ?? \"\"\n  pre := if loaded && precompiled != \"\" {\n    [\"--precompiled\", precompiled]\n  } else {\n    []\n  }\n  // a script, or a package's folder: each module named by its path\n  sources := source_files(disk, file)\n  if sources == [] {\n    mut console.eprint(\"error: \" + file + \": no module file here\")\n    return 2\n  }\n  // the program must check first, as `strata check` checks it. Its compiles\n  // share the program, read and expanded once.\n  sh := with_base(disk, shared(disk, caches), [file])\n  core := sh.core\n  timings.begin(\"verify: check the program\")\n  errors := if finding != \"\" {\n    []\n  } else {\n    warned(mut console, file_errors(\n      mut launcher,\n      mut disk,\n      caches,\n      \"std\",\n      file,\n      false,\n      core,\n      sh,\n      pre,\n    ))\n  }\n  timings.end(\"verify: check the program\")\n  if errors != [] {\n    for e in errors {\n      mut console.eprint(error_text(e))\n    }\n    return 1\n  }\n  // the traits, capabilities and mocks of the file, std and core\n  raw := own_decls(disk, sources)\n  // the definitions chosen (every one without a selection)\n  chosen := match select_names(raw, selection) {\n    Ok(names) => names,\n    Err(e) => {\n      mut console.eprint(\"error: \" + e)\n      return 2\n    },\n  }\n  std_files := deps.module_files(disk, \"std\").map(f -> \"std/\" + f)\n  context_decls := module_decls(disk, core_files())\n    + std_reached(disk, \"std\", raw)\n    + raw\n  mut traits := []\n  mut impls := []\n  mut caps := Set[String] {}\n  mut mocked := Set[String] {}\n  mut trait_modules := Dict[String, String] {}\n  // (traits and impls with their models as methods, as checked)\n  for d in desugar.with_models(context_decls, []) {\n    match d.kind {\n      ast.TraitDef(t) => {\n        mut traits.push(t)\n        mut trait_modules.insert(t.name, d.module)\n      },\n      ast.ImplDef(i) => mut impls.push(i),\n      ast.CapabilityDef(c) => {\n        mut caps.insert(c.name)\n        // (by the name code uses too: `clock.SystemClock`)\n        if d.module != \"\" && !contains(c.name, \".\") {\n          mut caps.insert(d.module + \".\" + c.name)\n        }\n      },\n      ast.TypeDef(t) => if t.mocked {\n        mut mocked.insert(t.name)\n      },\n      _ => (),\n    }\n  }\n  // the types holding a capability, each with the one it holds\n  holders := capability_holders(context_decls, caps)\n  wrappers := verify_wrappers(raw, traits, impls, caps)\n  (own, fns, types, sigs, all_methods) := verified_with(disk, [file], wrappers)\n  // (the assumed contracts as verify writes them: each check of one is\n  // noted as such)\n  assumed_clauses := assumed_texts(own)\n  scratch := caches.smt\n  cache.make_dirs(mut disk, scratch)\n  // (a solver that can't be run: none, and everything is fuzzed)\n  // (loops' invariants searched for only when finding them: `verify`\n  // and `build` use those derived from the code and those written)\n  ctx := {\n    c := termination.context(\n      fns,\n      types,\n      sigs,\n      all_methods,\n      scratch,\n      if toolchain.has_solver(mut launcher, solver) {\n        solver\n      } else {\n        \"\"\n      },\n    )\n    termination.Ctx { ..c, methods: smt.Methods { ..c.methods, search: if finding != \"\" {\n      2\n    } else {\n      0\n    } } }\n  }\n  // the implementations written as `derive`s, by position, and each\n  // implementation's name (`impl:K`'s definition)\n  mut derived := Set[Int] {}\n  mut impl_names := []\n  for d in raw {\n    match d.kind {\n      ast.ImplDef(i) => {\n        if i.derived {\n          mut derived.insert(len(impl_names))\n        }\n        mut impl_names.push(store.qname(d))\n      },\n      _ => (),\n    }\n  }\n  // each check's definition, by its name as a selection names it\n  def_name := (def: String) -> if starts_with(def, \"fn:\") {\n    drop_bytes(def, 3)\n  } else {\n    get(impl_names, parse_int(drop_bytes(def, 5)) ?? -1) ?? def\n  }\n  targets := checks_of(ctx, own, traits, caps, mocked, trait_modules, derived).filter(\n    t -> contains(chosen, def_name(t.def)),\n  )\n  // termination is analysed for what the chosen checks reach\n  mut roots := Set[String] {}\n  for t in targets {\n    roots = {\n      mut copy := {\n        mut copy := roots\n        mut copy.insert(t.label)\n        copy\n      }\n      mut copy.insert(t.key)\n      copy\n    }\n  }\n  // (each function's loops as earlier runs found them, for its code as the\n  // encoder sees it: `loops_file`)\n  timings.begin(\"verify: cache keys\")\n  own_paths := set(sources.map(s -> s.0))\n  // (the prelude too: it is compiled into every driver)\n  others := std_fingerprint(\n    disk,\n    (core_files() + [\"runtime/prelude.strata\"] + std_files).filter(\n      f -> !contains(own_paths, f),\n    ),\n  )\n  target_defs := set(targets.map(t -> t.def))\n  loop_keys := interface_keys(disk, sources, ctx.methods, target_defs, true)\n  // (the solver by its path and version: a verdict where it gave up is kept\n  // too, since it gives that answer again)\n  solver_id := solver + \" (\" + solver_version(solver) + \")\"\n  loop_settings := \"loops derived solver \"\n    + solver_id\n    + \" std \"\n    + others\n    + \" impls \"\n    + impls_fingerprint(disk, sources)\n    + \" package \"\n    + join(\n      items(settings_at(disk, file)).map(p -> p.0 + \"=\" + p.1),\n      \",\",\n    )\n  // (std's and core's own definitions: keyed by their names and std's code\n  // as a whole, `others`, so what std's loops and recursion take is found\n  // once and shipped with std)\n  library := library_names(\n    disk,\n    (core_files() + std_files).filter(f -> !contains(own_paths, f)),\n  )\n  loop_key := (n: String) -> match get(loop_keys, \"fn:\" + n) {\n    Some(k) => Some(loop_settings + \"\\n\" + n + \"\\n\" + k),\n    None => if contains(library, n) {\n      Some(loop_settings + \"\\n\" + n + \"\\nlibrary\")\n    } else {\n      None\n    },\n  }\n  reuse := !no_cache && finding == \"\" && cache.caching() && ctx.solver != \"\"\n  known := (n: String) -> if reuse {\n    match loop_key(n) {\n      Some(k) => match cache.read_entry(disk, caches, loops_file(k)) {\n        Some(text) => loops_of_text(text),\n        None => None,\n      },\n      None => None,\n    }\n  } else {\n    None\n  }\n  known_measure := (n: String) -> if reuse {\n    match loop_key(n) {\n      Some(k) => match cache.read_entry(disk, caches, measure_file(k)) {\n        Some(text) => Some(if text == \"none\" {\n          None\n        } else {\n          Some(text)\n        }),\n        None => None,\n      },\n      None => None,\n    }\n  } else {\n    None\n  }\n  timings.end(\"verify: cache keys\")\n  // (one budget for every loop-invariant search of the run: termination's\n  // and verification's)\n  smt.set_search_budget(budget)\n  timings.begin(\"verify: termination\")\n  (analysis, learned, measured) := termination.analyze_with(\n    mut launcher,\n    mut disk,\n    ctx,\n    Some(roots),\n    known,\n    known_measure,\n  )\n  timings.end(\"verify: termination\")\n  if !no_cache && finding == \"\" && ctx.solver != \"\" && cache.caching() {\n    for (n, x) in items(learned) {\n      match loop_key(n) {\n        Some(k) => write_loops(mut disk, caches, k, x),\n        None => (),\n      }\n    }\n    for (n, m) in items(measured) {\n      match loop_key(n) {\n        Some(k) => match cache.write_entry(\n          mut disk,\n          caches,\n          measure_file(k),\n          m ?? \"none\",\n        ) {\n          _ => (),\n        },\n        None => (),\n      }\n    }\n  }\n  methods := smt.Methods { ..termination.seen_through(ctx, analysis), examples: true }\n  // finding loops' invariants (`strata edit`, `strata fix`): nothing else\n  if finding != \"\" {\n    if ctx.solver == \"\" {\n      return 0\n    }\n    wrote := find_invariants(\n      mut console,\n      mut launcher,\n      mut disk,\n      file,\n      raw,\n      sh.core,\n      ctx,\n      methods,\n      analysis,\n      targets,\n      finding,\n      budget,\n      show_searches,\n      logged,\n    )\n    // (exit 3: nothing written)\n    return if wrote {\n      0\n    } else {\n      3\n    }\n  }\n  // the verdicts of earlier runs with these settings, for the code as it\n  // is now (each check's definition with all it depends on)\n  timings.begin(\"verify: cache keys\")\n  closures := closure_keys_of(disk, sources, target_defs)\n  // (`--no-cache` checks again; the package's settings, which std's code\n  // reads)\n  settings := \"loops derived seed \"\n    + to_string(seed)\n    + \" solver \"\n    + solver_id\n    + \" std \"\n    + std_fingerprint(\n      disk,\n      core_files() + [\"runtime/prelude.strata\"] + std_files,\n    )\n    + \" package \"\n    + join(\n      items(settings_at(disk, file)).map(p -> p.0 + \"=\" + p.1),\n      \",\",\n    )\n  cross_of := (t: Check) -> match get(analysis.status, t.label) {\n    Some(termination.Proven(_)) => cross,\n    _ => 0,\n  }\n  key_of := (t: Check) -> {\n    cc := cross_of(t)\n    settings\n      + \"\\n\"\n      + t.label\n      + \"\\n\"\n      + (get(closures, t.def) ?? \"?\")\n      + \":\"\n      + to_string(cases)\n      + \":\"\n      + to_string(cc)\n  }\n  mut kept := Dict[String, Verdict] {}\n  if !no_cache && cache.caching() {\n    for t in targets {\n      match read_verdict(disk, caches, verdict_file(key_of(t))) {\n        Some(v) => mut kept.insert(t.label, v),\n        None => (),\n      }\n    }\n  }\n  // the proofs of earlier runs, for the code as the prover sees it\n  // (`interface_keys`: the callees' contracts, and their bodies only when it\n  // sees through them), with these settings. std's code is keyed by its\n  // hash, the program's by these keys (std's when std is the program).\n  interfaces := interface_keys(disk, sources, methods, target_defs, false)\n  proof_settings := \"loops derived seed \"\n    + to_string(seed)\n    + \" solver \"\n    + solver_id\n    + \" std \"\n    + others\n    + \" package \"\n    + join(\n      items(settings_at(disk, file)).map(p -> p.0 + \"=\" + p.1),\n      \",\",\n    )\n  proof_key_of := (t: Check) -> match get(interfaces, t.def) {\n    Some(k) => Some(proof_settings + \"\\n\" + t.label + \"\\n\" + k),\n    None => None,\n  }\n  mut proved := Dict[String, Verdict] {}\n  if !no_cache && cache.caching() && ctx.solver != \"\" {\n    for t in targets {\n      if !contains(kept, t.label) && t.assumed == \"\" && t.decl is Some {\n        match proof_key_of(t) {\n          Some(k) => match read_verdict(disk, caches, proof_file(k)) {\n            Some(VProven { checks, given }) => mut proved.insert(t.label, VProven { checks, given }),\n            _ => (),\n          },\n          None => (),\n        }\n      }\n    }\n  }\n  timings.end(\"verify: cache keys\")\n  // one driver per function and wrapper still to check. None for one that\n  // is trusted, or that takes a capability (also inside another type:\n  // `Option[Disk]`, a record holding one), which only `strata run` makes.\n  mut keys := []\n  mut outside := Dict[String, String] {}\n  for t in targets {\n    if !contains(kept, t.label)\n      && !(contains(proved, t.label) && cross_of(t) == 0)\n      && !contains(keys, t.key)\n      && !contains(outside, t.key)\n      && t.assumed == \"\" {\n      match t.decl {\n        // (a lemma is only proven, never run)\n        Some(f) => if f.lemma {\n          mut outside.insert(t.key, \"a lemma is never run\")\n        } else {\n          match takes_capability(f, holders) {\n            Some(c) => mut outside.insert(t.key, not_fuzzed(c)),\n            None => mut keys.push(t.key),\n          }\n        },\n        None => mut keys.push(t.key),\n      }\n    }\n  }\n  // a package's own C (`[native]` in strata.toml), built and loaded into\n  // this process for the drivers to call\n  if keys != [] && !ends_with(file, \".strata\") {\n    // (keyed by the package's C and settings, `native_key`; built once)\n    native := cache.own_path(\n      mut disk,\n      caches,\n      \"verify-strata/native/\" + native_key(disk, file) + \".so\",\n    )\n    built := if disk.exists(native) {\n      Ok(true)\n    } else {\n      deps.native_library(mut launcher, mut disk, cc, file, native)\n    }\n    match built {\n      Ok(true) => if jit_load(native).to_int() != 0 {\n        mut console.eprint(\"note: the package's C could not be loaded\")\n      },\n      Ok(false) => (),\n      Err(e) => mut console.eprint(\"note: \" + e),\n    }\n  }\n  (h, why_compiled) := if keys == [] {\n    (-1, Dict[String, String] {})\n  } else {\n    timings.timed(\n      \"verify: compile drivers\",\n      () -> compiled_drivers(disk, sh, pre, file, keys, wrappers),\n    )\n  }\n  mut why := why_compiled\n  for (n, w) in items(outside) {\n    mut why.insert(n, w)\n  }\n  mut index := Dict[String, Int] {}\n  mut k := 0\n  for n in keys {\n    if !contains(why, n) {\n      mut index.insert(n, k)\n      k += 1\n    }\n  }\n  // the package's `[verify]` rules: each rule's modules\n  rules := verify_rules(disk, file)\n  mut violations := []\n  mut trusted := []\n  mut proofs := []\n  // each definition's worst verdict, for its status\n  mut worst := Dict[String, Verdict] {}\n  // what was checked in this run (not cached): proven, fuzzed, or with a\n  // counterexample\n  mut fresh := 0\n  mut fresh_proven := 0\n  mut fresh_fuzzed := 0\n  mut failed := []\n  mut ok := true\n  // the functions the solver checks, a chunk at a time: encoded and their\n  // obligations answered together, the solver runs in parallel\n  mut solved := Dict[String, (smt.Vc, List[smt.Answer])] {}\n  mut found: List[(Check, List[smt.LoopFound])] = []\n  for (ti, t) in enumerate(targets) {\n    if t.assumed == \"\"\n      && !contains(kept, t.label)\n      && !contains(proved, t.label)\n      && !contains(solved, t.label)\n      && ctx.solver != \"\"\n      && solver_checks(t) {\n      chunk := drop(targets, ti).filter(\n        x -> x.assumed == \"\"\n          && !contains(kept, x.label)\n          && !contains(proved, x.label)\n          && solver_checks(x),\n      )\n      timings.begin(\"verify: encode\")\n      solved = solved_together(\n        mut launcher,\n        mut disk,\n        ctx,\n        methods,\n        chunk[..min(len(chunk), solved_chunk())],\n      )\n      timings.end(\"verify: encode\")\n    }\n    label := t.label\n    // (what its loops' searches found; a verdict made with a search cut short\n    // by the budget isn't cached)\n    search_cut := match get(solved, label) {\n      Some((vc, _)) => {\n        if vc.found_loops != [] {\n          mut found.push((t, vc.found_loops))\n        }\n        vc.search_cut\n      },\n      None => false,\n    }\n    status := get(analysis.status, label)\n    // only code shown to terminate is cross-checked: running anything else\n    // may never end\n    cc := match status {\n      Some(termination.Proven(_)) => cross,\n      _ => 0,\n    }\n    fz := (n: Int, b: Option[Int]) -> match get(index, t.key) {\n      Some(i) => timings.timed(if b is Some {\n        \"verify: cross-check\"\n      } else {\n        \"verify: fuzz\"\n      }, () -> fuzz_run(h, i, t.key, t.shown, n, seed, b)),\n      None => FuzzSkipped(get(why, t.key) ?? \"not compiled\"),\n    }\n    cached := contains(kept, label)\n    lawful := (x: Verdict) -> match t.law_of {\n      Some((lw, ty)) => law_verdict(x, lw, ty),\n      None => x,\n    }\n    timings.begin(\"verify: check a function\")\n    v := match get(kept, label) {\n      Some(x) => Some(x),\n      None => match get(proved, label) {\n        // proven before, with what it relies on unchanged: only the cross-check\n        // runs again, since callees' bodies may have changed\n        Some(p) => Some(lawful(cross_checked(p, cc, t.once, fz))),\n        None => if t.assumed != \"\" {\n          Some(VAssumed(t.assumed))\n        } else {\n          match t.decl {\n            Some(f) => match check_fn(\n              mut launcher,\n              mut disk,\n              ctx,\n              methods,\n              get(solved, label),\n              sh,\n              pre,\n              file,\n              wrappers,\n              holders,\n              f,\n              t.key,\n              t.shown,\n              t.once,\n              cases,\n              cc,\n              seed,\n              fz,\n            ) {\n              Some(x0) => {\n                // a lemma not shown to end proves nothing: its recursion is\n                // its induction\n                x := match (t.decl, status) {\n                  (Some(f), Some(termination.Unknown(why))) => if f.lemma && x0 is VProven {\n                    VIncomplete(\n                      \"a lemma is proven only once it is shown to terminate (a recursive lemma is a proof by induction): \"\n                        + why,\n                    )\n                  } else {\n                    x0\n                  },\n                  _ => x0,\n                }\n                if x is VProven && !no_cache && !search_cut {\n                  match proof_key_of(t) {\n                    Some(k) => write_proof(mut disk, caches, k, x),\n                    None => (),\n                  }\n                }\n                Some(lawful(x))\n              },\n              None => None,\n            },\n            // a method only the trait defines: fuzzed\n            None => Some(fuzzed_with(fz(cases, None), 0, [])),\n          }\n        },\n      },\n    }\n    timings.end(\"verify: check a function\")\n    match v {\n      Some(found) => {\n        // (as reported: a function whose only unproven checks are of assumed\n        // contracts is assumed, trusted, cached, and listed in the proofs as found)\n        verdict := assumed_verdict(found, label, assumed_clauses)\n        // (a cached proof cross-checked again is reported as cached)\n        shown_cached := cached || contains(proved, label) && verdict is VProven\n        if !cached && !no_cache && !search_cut {\n          timings.begin(\"verify: cache keys\")\n          write_verdict(mut disk, caches, key_of(t), found)\n          timings.end(\"verify: cache keys\")\n        }\n        def := def_name(t.def)\n        mut worst.insert(\n          def,\n          match get(worst, def) {\n            Some(w) => if verdict_rank(verdict) > verdict_rank(w) {\n              verdict\n            } else {\n              w\n            },\n            None => verdict,\n          },\n        )\n        proofs += proof_lines(label, found).map(\n          l -> def + \"\\t\" + (get(closures, t.def) ?? \"?\") + \"\\t\" + l,\n        )\n        if verdict is VCounterexample {\n          ok = false\n        }\n        if !shown_cached {\n          fresh += 1\n          match verdict {\n            VProven { .. } => {\n              fresh_proven += 1\n            },\n            VFuzzed { .. } => {\n              fresh_fuzzed += 1\n            },\n            VCounterexample { .. } => mut failed.push(\"`\" + label + \"`\"),\n            _ => (),\n          }\n        }\n        if json {\n          mut entries.push(\n            verdict_json(label, verdict, status, shown_cached),\n          )\n        } else if !quiet {\n          for line in report(\n            label,\n            verdict,\n            status,\n            checks_shown,\n            shown_cached,\n            console.paint(std.term.Output),\n            assumed_clauses,\n          ) {\n            print(line)\n          }\n        }\n        if t.law_of == None {\n          // a rule applies from the command line (everywhere) or from strata.toml\n          // (its modules)\n          module := module_of_check(raw, def)\n          from_toml := \" (strata.toml [verify])\"\n          proven_by := if contains(require, \"proven\") {\n            Some(\"\")\n          } else if covers(rules.0, module) {\n            Some(from_toml)\n          } else {\n            None\n          }\n          match proven_by {\n            Some(src) => match verdict {\n              VProven { .. } => (),\n              VAssumed(_) => mut trusted.push(\"`\" + label + \"`\"),\n              _ => mut violations.push(\"`\" + label + \"` is not proven\" + src),\n            },\n            None => (),\n          }\n          terminates_by := if contains(require, \"terminates\") {\n            Some(\"\")\n          } else if covers(rules.1, module) {\n            Some(from_toml)\n          } else {\n            None\n          }\n          match terminates_by {\n            // (an assumed contract left unproven doesn't stop this one)\n            Some(src) => if !(found is VAssumed) && !(found is VSkipped) {\n              match status {\n                Some(termination.Unknown(_)) => mut violations.push(\n                  \"`\" + label + \"` may not terminate\" + src,\n                ),\n                _ => (),\n              }\n            },\n            None => (),\n          }\n          recursion_by := if contains(require, \"no-recursion\") {\n            Some(\"\")\n          } else if covers(rules.2, module) {\n            Some(from_toml)\n          } else {\n            None\n          }\n          match recursion_by {\n            Some(src) => if contains(analysis.recursive, label) {\n              mut violations.push(\"`\" + label + \"` is recursive\" + src)\n            },\n            None => (),\n          }\n        }\n      },\n      None => if !quiet && !json {\n        print(\n          \"? \" + pad(label, 24) + \" not covered by compiler/smt yet\",\n        )\n      },\n    }\n  }\n  // each definition's status (its worst verdict), for the code as it is\n  for (def, w) in items(worst) {\n    write_status(\n      mut disk,\n      caches,\n      def_key(closures, impl_names, def),\n      w,\n    )\n  }\n  // what `build` may leave out: each check proven, for the code as it is. A\n  // definition not checked this time keeps its record while its code is\n  // unchanged.\n  out_proofs := if proofs_at == \"\" {\n    proofs_own(mut disk, caches, file)\n  } else {\n    proofs_at\n  }\n  in_proofs := if proofs_at == \"\" {\n    proofs_read(disk, caches, file)\n  } else {\n    proofs_at\n  }\n  checked := set(targets.map(t -> def_name(t.def)))\n  mut record := []\n  for row in lines(match disk.read(in_proofs) {\n    Ok(text) => text,\n    Err(_) => \"\",\n  }) {\n    fields := split(row, \"\\t\")\n    def := get(fields, 0) ?? \"\"\n    if len(fields) >= 5\n      && !contains(checked, def)\n      && def_key(closures, impl_names, def) == get(fields, 1) ?? \"\" {\n      mut record.push(row + \"\\n\")\n    }\n  }\n  match mut disk.write(out_proofs, join(record + proofs, \"\")) {\n    _ => (),\n  }\n  // (`--show-searches`: what every loop's search took; `verify` searches\n  // none)\n  for l in search_notes(found, budget, show_searches) {\n    mut console.eprint(l)\n  }\n  // (the whole program verified as it is now: `run` has nothing to verify\n  // alongside it)\n  if selection == \"\" {\n    record_verified(mut disk, caches, file)\n  }\n  if json {\n    print(driver.pretty_json(driver.JList(entries)))\n  } else if quiet {\n    if fresh > 0 {\n      mut line := \"verified \"\n        + to_string(fresh)\n        + \" changed: \"\n        + to_string(fresh_proven)\n        + \" proven, \"\n        + to_string(fresh_fuzzed)\n        + \" fuzzed\"\n      if failed != [] {\n        line += \", \"\n          + to_string(len(failed))\n          + \" with a counterexample (\"\n          + join(failed, \", \")\n          + \": see `strata verify`)\"\n      }\n      mut console.eprint(line)\n    }\n  } else {\n    if trusted != [] {\n      print(\"policy: `proven` accepts \"\n        + join(trusted, \", \")\n        + \" as assumed (trusted, not checked)\")\n    }\n    for x in violations {\n      print(\"policy: \" + x)\n    }\n  }\n  if ok && violations == [] {\n    0\n  } else {\n    1\n  }\n}","old_text":"/// `verify [--cases N] [--seed S] [--cross-check N] [--require R] [--checks]\n/// [--no-cache] [--only SELECTION] [--quiet] [--proofs FILE]\n/// [--show-searches] [--load LIB --precompiled NAMES] FILE`: verifies each\n/// function of the script (or of the package,\n/// a folder), each method of its types and implementations, and each law\n/// they must keep. Reports as `strata verify --no-race` does.\n/// \n/// The program is checked first (errors on stderr, exit 1). Then the solver\n/// (compiler/smt) proves what it can, its counterexamples are run to\n/// confirm them, and the rest is fuzzed (compiled, run by c/jit.c).\n/// \n/// - `--only`: the definitions a selection names (`f,g`, `prefix*`,\n/// `module:m`, `slice:f`, a module's name), as `strata verify NAME`.\n/// - `--quiet` (`strata build`): no report, only one line on stderr on the\n/// checks not verified before.\n/// - Verdicts are cached between runs (`(cached)`, `verdict_file`).\n/// Proofs are cached by what they rely on (`proof_file`): when a callee's\n/// body changes but its contract doesn't, its callers' proofs are kept and\n/// only cross-checked again. Each definition's status is kept too\n/// (`status_file`).\n/// - The checks proven are recorded for `proofs` (`proofs_file`, or FILE).\n/// - The package's `[verify]` rules apply to their modules as `--require`\n/// does.\n/// - Loops get the invariants derived from their code and those written\n/// (`invariant`); nothing is searched for. A check failing in or after a\n/// loop that changes what it names says so (`loop_hint`), as does a loop\n/// whose bound isn't shown to go down.\n/// - `--find-invariants BY [--search-budget N] [--log]` (`strata edit` and\n/// `strata fix`, `BY`): only the chosen functions with loops. Where a check\n/// fails after a loop (or a loop isn't shown to end), invariants are\n/// searched for and written into the code (`find_invariants`), logged and\n/// committed with `--log`. Nothing else is checked or reported. All\n/// searches share one budget of the solver's resource units (default\n/// `search_budget`).\n/// \n/// Exit 1 on a counterexample or a broken rule, 2 on a mistake in the\n/// arguments. A function the encoder doesn't cover says so.\nfn verify_file(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  caches: cache.Cache,\n  solver: String,\n  cc: String,\n  args: List[String],\n) -> std.process.ExitCode {\n  mut rest := args\n  mut cases := 200\n  mut seed := 1\n  mut cross := 20\n  mut require := []\n  mut checks_shown := false\n  mut no_cache := false\n  mut proofs_at := \"\"\n  mut budget := search_budget()\n  mut finding := \"\"\n  mut logged := false\n  mut show_searches := false\n  mut loaded := false\n  mut precompiled := \"\"\n  mut selection := \"\"\n  mut quiet := false\n  mut json := false\n  mut entries := []\n  mut go := true\n  while go {\n    match rest {\n      [\"--cases\", n, ..more] => {\n        cases = parse_int(n) ?? cases\n        rest = more\n      },\n      [\"--seed\", n, ..more] => {\n        seed = parse_int(n) ?? seed\n        rest = more\n      },\n      [\"--cross-check\", n, ..more] => {\n        cross = parse_int(n) ?? cross\n        rest = more\n      },\n      [\"--require\", r, ..more] => {\n        require = split(r, \",\").map(x -> trim(x))\n        rest = more\n      },\n      [\"--checks\", ..more] => {\n        checks_shown = true\n        rest = more\n      },\n      [\"--no-cache\", ..more] => {\n        no_cache = true\n        rest = more\n      },\n      [\"--search-budget\", n, ..more] => {\n        budget = parse_int(n) ?? budget\n        rest = more\n      },\n      [\"--find-invariants\", by, ..more] => {\n        finding = by\n        rest = more\n      },\n      [\"--log\", ..more] => {\n        logged = true\n        rest = more\n      },\n      [\"--show-searches\", ..more] => {\n        show_searches = true\n        rest = more\n      },\n      [\"--proofs\", p, ..more] => {\n        proofs_at = p\n        rest = more\n      },\n      [\"--only\", sel, ..more] => {\n        selection = sel\n        rest = more\n      },\n      [\"--quiet\", ..more] => {\n        quiet = true\n        rest = more\n      },\n      // (each verdict as JSON)\n      [\"--json\", ..more] => {\n        json = true\n        rest = more\n      },\n      // std's precompiled library, loaded into the JIT, and its functions'\n      // names: declared in the drivers instead of compiled again\n      [\"--load\", lib, ..more] => {\n        loaded = jit_load(lib).to_int() == 0\n        rest = more\n      },\n      [\"--precompiled\", names, ..more] => {\n        precompiled = names\n        rest = more\n      },\n      _ => {\n        go = false\n      },\n    }\n  }\n  for r in require {\n    if !contains([\"proven\", \"terminates\", \"no-recursion\"], r) {\n      mut console.eprint(\n        \"error: unknown requirement `\"\n          + r\n          + \"` (use proven, terminates, no-recursion)\",\n      )\n      return 2\n    }\n  }\n  file := get(rest, 0) ?? \"\"\n  pre := if loaded && precompiled != \"\" {\n    [\"--precompiled\", precompiled]\n  } else {\n    []\n  }\n  // a script, or a package's folder: each module named by its path\n  sources := source_files(disk, file)\n  if sources == [] {\n    mut console.eprint(\"error: \" + file + \": no module file here\")\n    return 2\n  }\n  // the program must check first, as `strata check` checks it. Its compiles\n  // share the program, read and expanded once.\n  sh := with_base(disk, shared(disk, caches), [file])\n  core := sh.core\n  timings.begin(\"verify: check the program\")\n  errors := if finding != \"\" {\n    []\n  } else {\n    warned(mut console, file_errors(\n      mut launcher,\n      mut disk,\n      caches,\n      \"std\",\n      file,\n      false,\n      core,\n      sh,\n      pre,\n    ))\n  }\n  timings.end(\"verify: check the program\")\n  if errors != [] {\n    for e in errors {\n      mut console.eprint(error_text(e))\n    }\n    return 1\n  }\n  // the traits, capabilities and mocks of the file, std and core\n  raw := own_decls(disk, sources)\n  // the definitions chosen (every one without a selection)\n  chosen := match select_names(raw, selection) {\n    Ok(names) => names,\n    Err(e) => {\n      mut console.eprint(\"error: \" + e)\n      return 2\n    },\n  }\n  std_files := deps.module_files(disk, \"std\").map(f -> \"std/\" + f)\n  context_decls := module_decls(disk, core_files())\n    + std_reached(disk, \"std\", raw)\n    + raw\n  mut traits := []\n  mut impls := []\n  mut caps := Set[String] {}\n  mut mocked := Set[String] {}\n  mut trait_modules := Dict[String, String] {}\n  // (traits and impls with their models as methods, as checked)\n  for d in desugar.with_models(context_decls, []) {\n    match d.kind {\n      ast.TraitDef(t) => {\n        mut traits.push(t)\n        mut trait_modules.insert(t.name, d.module)\n      },\n      ast.ImplDef(i) => mut impls.push(i),\n      ast.CapabilityDef(c) => {\n        mut caps.insert(c.name)\n        // (by the name code uses too: `clock.SystemClock`)\n        if d.module != \"\" && !contains(c.name, \".\") {\n          mut caps.insert(d.module + \".\" + c.name)\n        }\n      },\n      ast.TypeDef(t) => if t.mocked {\n        mut mocked.insert(t.name)\n      },\n      _ => (),\n    }\n  }\n  // the types holding a capability, each with the one it holds\n  holders := capability_holders(context_decls, caps)\n  wrappers := verify_wrappers(raw, traits, impls, caps)\n  (own, fns, types, sigs, all_methods) := verified_with(disk, [file], wrappers)\n  // (the assumed contracts as verify writes them: each check of one is\n  // noted as such)\n  assumed_clauses := assumed_texts(own)\n  scratch := caches.smt\n  cache.make_dirs(mut disk, scratch)\n  // (a solver that can't be run: none, and everything is fuzzed)\n  // (loops' invariants searched for only when finding them: `verify`\n  // and `build` use those derived from the code and those written)\n  ctx := {\n    c := termination.context(\n      fns,\n      types,\n      sigs,\n      all_methods,\n      scratch,\n      if toolchain.has_solver(mut launcher, solver) {\n        solver\n      } else {\n        \"\"\n      },\n    )\n    termination.Ctx { ..c, methods: smt.Methods { ..c.methods, search: if finding != \"\" {\n      2\n    } else {\n      0\n    } } }\n  }\n  // the implementations written as `derive`s, by position, and each\n  // implementation's name (`impl:K`'s definition)\n  mut derived := Set[Int] {}\n  mut impl_names := []\n  for d in raw {\n    match d.kind {\n      ast.ImplDef(i) => {\n        if i.derived {\n          mut derived.insert(len(impl_names))\n        }\n        mut impl_names.push(store.qname(d))\n      },\n      _ => (),\n    }\n  }\n  // each check's definition, by its name as a selection names it\n  def_name := (def: String) -> if starts_with(def, \"fn:\") {\n    drop_bytes(def, 3)\n  } else {\n    get(impl_names, parse_int(drop_bytes(def, 5)) ?? -1) ?? def\n  }\n  targets := checks_of(ctx, own, traits, caps, mocked, trait_modules, derived).filter(\n    t -> contains(chosen, def_name(t.def)),\n  )\n  // termination is analysed for what the chosen checks reach\n  mut roots := Set[String] {}\n  for t in targets {\n    roots = {\n      mut copy := {\n        mut copy := roots\n        mut copy.insert(t.label)\n        copy\n      }\n      mut copy.insert(t.key)\n      copy\n    }\n  }\n  // (each function's loops as earlier runs found them, for its code as the\n  // encoder sees it: `loops_file`)\n  timings.begin(\"verify: cache keys\")\n  own_paths := set(sources.map(s -> s.0))\n  // (the prelude too: it is compiled into every driver)\n  others := std_fingerprint(\n    disk,\n    (core_files() + [\"runtime/prelude.strata\"] + std_files).filter(\n      f -> !contains(own_paths, f),\n    ),\n  )\n  target_defs := set(targets.map(t -> t.def))\n  loop_keys := interface_keys(disk, sources, ctx.methods, target_defs, true)\n  // (the solver by its path and version: a verdict where it gave up is kept\n  // too, since it gives that answer again)\n  solver_id := solver + \" (\" + solver_version(solver) + \")\"\n  loop_settings := \"loops derived solver \"\n    + solver_id\n    + \" std \"\n    + others\n    + \" impls \"\n    + impls_fingerprint(disk, sources)\n    + \" package \"\n    + join(\n      items(settings_at(disk, file)).map(p -> p.0 + \"=\" + p.1),\n      \",\",\n    )\n  // (std's and core's own definitions: keyed by their names and std's code\n  // as a whole, `others`, so what std's loops and recursion take is found\n  // once and shipped with std)\n  library := library_names(\n    disk,\n    (core_files() + std_files).filter(f -> !contains(own_paths, f)),\n  )\n  loop_key := (n: String) -> match get(loop_keys, \"fn:\" + n) {\n    Some(k) => Some(loop_settings + \"\\n\" + n + \"\\n\" + k),\n    None => if contains(library, n) {\n      Some(loop_settings + \"\\n\" + n + \"\\nlibrary\")\n    } else {\n      None\n    },\n  }\n  reuse := !no_cache && finding == \"\" && cache.caching() && ctx.solver != \"\"\n  known := (n: String) -> if reuse {\n    match loop_key(n) {\n      Some(k) => match cache.read_entry(disk, caches, loops_file(k)) {\n        Some(text) => loops_of_text(text),\n        None => None,\n      },\n      None => None,\n    }\n  } else {\n    None\n  }\n  known_measure := (n: String) -> if reuse {\n    match loop_key(n) {\n      Some(k) => match cache.read_entry(disk, caches, measure_file(k)) {\n        Some(text) => Some(if text == \"none\" {\n          None\n        } else {\n          Some(text)\n        }),\n        None => None,\n      },\n      None => None,\n    }\n  } else {\n    None\n  }\n  timings.end(\"verify: cache keys\")\n  // (one budget for every loop-invariant search of the run: termination's\n  // and verification's)\n  smt.set_search_budget(budget)\n  timings.begin(\"verify: termination\")\n  (analysis, learned, measured) := termination.analyze_with(\n    mut launcher,\n    mut disk,\n    ctx,\n    Some(roots),\n    known,\n    known_measure,\n  )\n  timings.end(\"verify: termination\")\n  if !no_cache && finding == \"\" && ctx.solver != \"\" && cache.caching() {\n    for (n, x) in items(learned) {\n      match loop_key(n) {\n        Some(k) => write_loops(mut disk, caches, k, x),\n        None => (),\n      }\n    }\n    for (n, m) in items(measured) {\n      match loop_key(n) {\n        Some(k) => match cache.write_entry(\n          mut disk,\n          caches,\n          measure_file(k),\n          m ?? \"none\",\n        ) {\n          _ => (),\n        },\n        None => (),\n      }\n    }\n  }\n  methods := smt.Methods { ..termination.seen_through(ctx, analysis), examples: true }\n  // finding loops' invariants (`strata edit`, `strata fix`): nothing else\n  if finding != \"\" {\n    if ctx.solver == \"\" {\n      return 0\n    }\n    wrote := find_invariants(\n      mut console,\n      mut launcher,\n      mut disk,\n      file,\n      raw,\n      sh.core,\n      ctx,\n      methods,\n      analysis,\n      targets,\n      finding,\n      budget,\n      show_searches,\n      logged,\n    )\n    // (exit 3: nothing written)\n    return if wrote {\n      0\n    } else {\n      3\n    }\n  }\n  // the verdicts of earlier runs with these settings, for the code as it\n  // is now (each check's definition with all it depends on)\n  timings.begin(\"verify: cache keys\")\n  closures := closure_keys_of(disk, sources, target_defs)\n  // (`--no-cache` checks again; the package's settings, which std's code\n  // reads)\n  settings := \"loops derived seed \"\n    + to_string(seed)\n    + \" solver \"\n    + solver_id\n    + \" std \"\n    + std_fingerprint(\n      disk,\n      core_files() + [\"runtime/prelude.strata\"] + std_files,\n    )\n    + \" package \"\n    + join(\n      items(settings_at(disk, file)).map(p -> p.0 + \"=\" + p.1),\n      \",\",\n    )\n  cross_of := (t: Check) -> match get(analysis.status, t.label) {\n    Some(termination.Proven(_)) => cross,\n    _ => 0,\n  }\n  key_of := (t: Check) -> {\n    cc := cross_of(t)\n    settings\n      + \"\\n\"\n      + t.label\n      + \"\\n\"\n      + (get(closures, t.def) ?? \"?\")\n      + \":\"\n      + to_string(cases)\n      + \":\"\n      + to_string(cc)\n  }\n  mut kept := Dict[String, Verdict] {}\n  if !no_cache && cache.caching() {\n    for t in targets {\n      match read_verdict(disk, caches, verdict_file(key_of(t))) {\n        Some(v) => mut kept.insert(t.label, v),\n        None => (),\n      }\n    }\n  }\n  // the proofs of earlier runs, for the code as the prover sees it\n  // (`interface_keys`: the callees' contracts, and their bodies only when it\n  // sees through them), with these settings. std's code is keyed by its\n  // hash, the program's by these keys (std's when std is the program).\n  interfaces := interface_keys(disk, sources, methods, target_defs, false)\n  proof_settings := \"loops derived seed \"\n    + to_string(seed)\n    + \" solver \"\n    + solver_id\n    + \" std \"\n    + others\n    + \" package \"\n    + join(\n      items(settings_at(disk, file)).map(p -> p.0 + \"=\" + p.1),\n      \",\",\n    )\n  proof_key_of := (t: Check) -> match get(interfaces, t.def) {\n    Some(k) => Some(proof_settings + \"\\n\" + t.label + \"\\n\" + k),\n    None => None,\n  }\n  mut proved := Dict[String, Verdict] {}\n  if !no_cache && cache.caching() && ctx.solver != \"\" {\n    for t in targets {\n      if !contains(kept, t.label) && t.assumed == \"\" && t.decl is Some {\n        match proof_key_of(t) {\n          Some(k) => match read_verdict(disk, caches, proof_file(k)) {\n            Some(VProven { checks, given }) => mut proved.insert(t.label, VProven { checks, given }),\n            _ => (),\n          },\n          None => (),\n        }\n      }\n    }\n  }\n  timings.end(\"verify: cache keys\")\n  // one driver per function and wrapper still to check. None for one that\n  // is trusted, or that takes a capability (also inside another type:\n  // `Option[Disk]`, a record holding one), which only `strata run` makes.\n  mut keys := []\n  mut outside := Dict[String, String] {}\n  for t in targets {\n    if !contains(kept, t.label)\n      && !(contains(proved, t.label) && cross_of(t) == 0)\n      && !contains(keys, t.key)\n      && !contains(outside, t.key)\n      && t.assumed == \"\" {\n      match t.decl {\n        // (a lemma is only proven, never run)\n        Some(f) => if f.lemma {\n          mut outside.insert(t.key, \"a lemma is never run\")\n        } else {\n          match takes_capability(f, holders) {\n            Some(c) => mut outside.insert(t.key, not_fuzzed(c)),\n            None => mut keys.push(t.key),\n          }\n        },\n        None => mut keys.push(t.key),\n      }\n    }\n  }\n  // a package's own C (`[native]` in strata.toml), built and loaded into\n  // this process for the drivers to call\n  if keys != [] && !ends_with(file, \".strata\") {\n    // (keyed by the package's C and settings, `native_key`; built once)\n    native := cache.own_path(\n      mut disk,\n      caches,\n      \"verify-strata/native/\" + native_key(disk, file) + \".so\",\n    )\n    built := if disk.exists(native) {\n      Ok(true)\n    } else {\n      deps.native_library(mut launcher, mut disk, cc, file, native)\n    }\n    match built {\n      Ok(true) => if jit_load(native).to_int() != 0 {\n        mut console.eprint(\"note: the package's C could not be loaded\")\n      },\n      Ok(false) => (),\n      Err(e) => mut console.eprint(\"note: \" + e),\n    }\n  }\n  (h, why_compiled) := if keys == [] {\n    (-1, Dict[String, String] {})\n  } else {\n    timings.timed(\n      \"verify: compile drivers\",\n      () -> compiled_drivers(disk, sh, pre, file, keys, wrappers),\n    )\n  }\n  mut why := why_compiled\n  for (n, w) in items(outside) {\n    mut why.insert(n, w)\n  }\n  mut index := Dict[String, Int] {}\n  mut k := 0\n  for n in keys {\n    if !contains(why, n) {\n      mut index.insert(n, k)\n      k += 1\n    }\n  }\n  // the package's `[verify]` rules: each rule's modules\n  rules := verify_rules(disk, file)\n  mut violations := []\n  mut trusted := []\n  mut proofs := []\n  // each definition's worst verdict, for its status\n  mut worst := Dict[String, Verdict] {}\n  // what was checked in this run (not cached): proven, fuzzed, or with a\n  // counterexample\n  mut fresh := 0\n  mut fresh_proven := 0\n  mut fresh_fuzzed := 0\n  mut failed := []\n  mut ok := true\n  // the functions the solver checks, a chunk at a time: encoded and their\n  // obligations answered together, the solver runs in parallel\n  mut solved := Dict[String, (smt.Vc, List[smt.Answer])] {}\n  mut found: List[(Check, List[smt.LoopFound])] = []\n  for (ti, t) in enumerate(targets) {\n    if t.assumed == \"\"\n      && !contains(kept, t.label)\n      && !contains(proved, t.label)\n      && !contains(solved, t.label)\n      && ctx.solver != \"\"\n      && solver_checks(t) {\n      chunk := drop(targets, ti).filter(\n        x -> x.assumed == \"\"\n          && !contains(kept, x.label)\n          && !contains(proved, x.label)\n          && solver_checks(x),\n      )\n      timings.begin(\"verify: encode\")\n      solved = solved_together(\n        mut launcher,\n        mut disk,\n        ctx,\n        methods,\n        chunk[..min(len(chunk), solved_chunk())],\n      )\n      timings.end(\"verify: encode\")\n    }\n    label := t.label\n    // (what its loops' searches found; a verdict made with a search cut short\n    // by the budget isn't cached)\n    search_cut := match get(solved, label) {\n      Some((vc, _)) => {\n        if vc.found_loops != [] {\n          mut found.push((t, vc.found_loops))\n        }\n        vc.search_cut\n      },\n      None => false,\n    }\n    status := get(analysis.status, label)\n    // only code shown to terminate is cross-checked: running anything else\n    // may never end\n    cc := match status {\n      Some(termination.Proven(_)) => cross,\n      _ => 0,\n    }\n    fz := (n: Int, b: Option[Int]) -> match get(index, t.key) {\n      Some(i) => timings.timed(if b is Some {\n        \"verify: cross-check\"\n      } else {\n        \"verify: fuzz\"\n      }, () -> fuzz_run(h, i, t.key, t.shown, n, seed, b)),\n      None => FuzzSkipped(get(why, t.key) ?? \"not compiled\"),\n    }\n    cached := contains(kept, label)\n    lawful := (x: Verdict) -> match t.law_of {\n      Some((lw, ty)) => law_verdict(x, lw, ty),\n      None => x,\n    }\n    timings.begin(\"verify: check a function\")\n    v := match get(kept, label) {\n      Some(x) => Some(x),\n      None => match get(proved, label) {\n        // proven before, with what it relies on unchanged: only the cross-check\n        // runs again, since callees' bodies may have changed\n        Some(p) => Some(lawful(cross_checked(p, cc, t.once, fz))),\n        None => if t.assumed != \"\" {\n          Some(VAssumed(t.assumed))\n        } else {\n          match t.decl {\n            Some(f) => match check_fn(\n              mut launcher,\n              mut disk,\n              ctx,\n              methods,\n              get(solved, label),\n              sh,\n              pre,\n              file,\n              wrappers,\n              holders,\n              f,\n              t.key,\n              t.shown,\n              t.once,\n              cases,\n              cc,\n              seed,\n              fz,\n            ) {\n              Some(x) => {\n                if x is VProven && !no_cache && !search_cut {\n                  match proof_key_of(t) {\n                    Some(k) => write_proof(mut disk, caches, k, x),\n                    None => (),\n                  }\n                }\n                Some(lawful(x))\n              },\n              None => None,\n            },\n            // a method only the trait defines: fuzzed\n            None => Some(fuzzed_with(fz(cases, None), 0, [])),\n          }\n        },\n      },\n    }\n    timings.end(\"verify: check a function\")\n    match v {\n      Some(found) => {\n        // (as reported: a function whose only unproven checks are of assumed\n        // contracts is assumed, trusted, cached, and listed in the proofs as found)\n        verdict := assumed_verdict(found, label, assumed_clauses)\n        // (a cached proof cross-checked again is reported as cached)\n        shown_cached := cached || contains(proved, label) && verdict is VProven\n        if !cached && !no_cache && !search_cut {\n          timings.begin(\"verify: cache keys\")\n          write_verdict(mut disk, caches, key_of(t), found)\n          timings.end(\"verify: cache keys\")\n        }\n        def := def_name(t.def)\n        mut worst.insert(\n          def,\n          match get(worst, def) {\n            Some(w) => if verdict_rank(verdict) > verdict_rank(w) {\n              verdict\n            } else {\n              w\n            },\n            None => verdict,\n          },\n        )\n        proofs += proof_lines(label, found).map(\n          l -> def + \"\\t\" + (get(closures, t.def) ?? \"?\") + \"\\t\" + l,\n        )\n        if verdict is VCounterexample {\n          ok = false\n        }\n        if !shown_cached {\n          fresh += 1\n          match verdict {\n            VProven { .. } => {\n              fresh_proven += 1\n            },\n            VFuzzed { .. } => {\n              fresh_fuzzed += 1\n            },\n            VCounterexample { .. } => mut failed.push(\"`\" + label + \"`\"),\n            _ => (),\n          }\n        }\n        if json {\n          mut entries.push(\n            verdict_json(label, verdict, status, shown_cached),\n          )\n        } else if !quiet {\n          for line in report(\n            label,\n            verdict,\n            status,\n            checks_shown,\n            shown_cached,\n            console.paint(std.term.Output),\n            assumed_clauses,\n          ) {\n            print(line)\n          }\n        }\n        if t.law_of == None {\n          // a rule applies from the command line (everywhere) or from strata.toml\n          // (its modules)\n          module := module_of_check(raw, def)\n          from_toml := \" (strata.toml [verify])\"\n          proven_by := if contains(require, \"proven\") {\n            Some(\"\")\n          } else if covers(rules.0, module) {\n            Some(from_toml)\n          } else {\n            None\n          }\n          match proven_by {\n            Some(src) => match verdict {\n              VProven { .. } => (),\n              VAssumed(_) => mut trusted.push(\"`\" + label + \"`\"),\n              _ => mut violations.push(\"`\" + label + \"` is not proven\" + src),\n            },\n            None => (),\n          }\n          terminates_by := if contains(require, \"terminates\") {\n            Some(\"\")\n          } else if covers(rules.1, module) {\n            Some(from_toml)\n          } else {\n            None\n          }\n          match terminates_by {\n            // (an assumed contract left unproven doesn't stop this one)\n            Some(src) => if !(found is VAssumed) && !(found is VSkipped) {\n              match status {\n                Some(termination.Unknown(_)) => mut violations.push(\n                  \"`\" + label + \"` may not terminate\" + src,\n                ),\n                _ => (),\n              }\n            },\n            None => (),\n          }\n          recursion_by := if contains(require, \"no-recursion\") {\n            Some(\"\")\n          } else if covers(rules.2, module) {\n            Some(from_toml)\n          } else {\n            None\n          }\n          match recursion_by {\n            Some(src) => if contains(analysis.recursive, label) {\n              mut violations.push(\"`\" + label + \"` is recursive\" + src)\n            },\n            None => (),\n          }\n        }\n      },\n      None => if !quiet && !json {\n        print(\n          \"? \" + pad(label, 24) + \" not covered by compiler/smt yet\",\n        )\n      },\n    }\n  }\n  // each definition's status (its worst verdict), for the code as it is\n  for (def, w) in items(worst) {\n    write_status(\n      mut disk,\n      caches,\n      def_key(closures, impl_names, def),\n      w,\n    )\n  }\n  // what `build` may leave out: each check proven, for the code as it is. A\n  // definition not checked this time keeps its record while its code is\n  // unchanged.\n  out_proofs := if proofs_at == \"\" {\n    proofs_own(mut disk, caches, file)\n  } else {\n    proofs_at\n  }\n  in_proofs := if proofs_at == \"\" {\n    proofs_read(disk, caches, file)\n  } else {\n    proofs_at\n  }\n  checked := set(targets.map(t -> def_name(t.def)))\n  mut record := []\n  for row in lines(match disk.read(in_proofs) {\n    Ok(text) => text,\n    Err(_) => \"\",\n  }) {\n    fields := split(row, \"\\t\")\n    def := get(fields, 0) ?? \"\"\n    if len(fields) >= 5\n      && !contains(checked, def)\n      && def_key(closures, impl_names, def) == get(fields, 1) ?? \"\" {\n      mut record.push(row + \"\\n\")\n    }\n  }\n  match mut disk.write(out_proofs, join(record + proofs, \"\")) {\n    _ => (),\n  }\n  // (`--show-searches`: what every loop's search took; `verify` searches\n  // none)\n  for l in search_notes(found, budget, show_searches) {\n    mut console.eprint(l)\n  }\n  // (the whole program verified as it is now: `run` has nothing to verify\n  // alongside it)\n  if selection == \"\" {\n    record_verified(mut disk, caches, file)\n  }\n  if json {\n    print(driver.pretty_json(driver.JList(entries)))\n  } else if quiet {\n    if fresh > 0 {\n      mut line := \"verified \"\n        + to_string(fresh)\n        + \" changed: \"\n        + to_string(fresh_proven)\n        + \" proven, \"\n        + to_string(fresh_fuzzed)\n        + \" fuzzed\"\n      if failed != [] {\n        line += \", \"\n          + to_string(len(failed))\n          + \" with a counterexample (\"\n          + join(failed, \", \")\n          + \": see `strata verify`)\"\n      }\n      mut console.eprint(line)\n    }\n  } else {\n    if trusted != [] {\n      print(\"policy: `proven` accepts \"\n        + join(trusted, \", \")\n        + \" as assumed (trusted, not checked)\")\n    }\n    for x in violations {\n      print(\"policy: \" + x)\n    }\n  }\n  if ok && violations == [] {\n    0\n  } else {\n    1\n  }\n}"},{"name":"lemma_verdict","kind":"fn","old":"e70299bd345449d3","new":"98988b5060714db8","interface_changed":false,"affected":[],"module":"","text":"/// A lemma's verdict: proven, or not. It is never run (never compiled), so a\n/// solver's counterexample is its verdict as found, and what the solver\n/// leaves open stays open (incomplete), never fuzzed.\nfn lemma_verdict(vc: smt.Vc, answers: List[smt.Answer]) -> Verdict {\n  mut proven := []\n  mut open := []\n  for a in answers {\n    if a.outcome == \"proven\" {\n      mut proven.push(a.what)\n    } else if a.outcome == \"refuted\" {\n      return VCounterexample {\n        args: a.args.map(x -> x.0 + \" = \" + text.expr_text(x.1, 0)),\n        kind: \"Ensures\",\n        message: \"not proven: \" + a.what + \": \" + a.message,\n        found_by: \"solver\",\n      }\n    } else {\n      mut open.push(a.what + \": \" + a.message)\n    }\n  }\n  if open == [] {\n    VProven { checks: proven + vc.invariants, given: vc.given }\n  } else {\n    VIncomplete(\"a lemma is proven or not, never run: not proven: \"\n      + join(open, \"; \"))\n  }\n}","old_text":"/// A lemma's verdict: proven, or not. It is never run (never compiled), so a\n/// solver's counterexample is its verdict as found, and what the solver\n/// leaves open stays open (incomplete), never fuzzed.\nfn lemma_verdict(vc: smt.Vc, answers: List[smt.Answer]) -> Verdict {\n  mut proven := []\n  mut open := []\n  for a in answers {\n    if a.outcome == \"proven\" {\n      mut proven.push(a.what)\n    } else if a.outcome == \"refuted\" {\n      return VCounterexample {\n        args: a.args.map(x -> x.0 + \" = \" + text.expr_text(x.1, 0)),\n        kind: \"Lemma\",\n        message: \"not proven: \" + a.what + \": \" + a.message,\n        found_by: \"solver\",\n      }\n    } else {\n      mut open.push(a.what + \": \" + a.message)\n    }\n  }\n  if open == [] {\n    VProven { checks: proven + vc.invariants, given: vc.given }\n  } else {\n    VIncomplete(\"a lemma is proven or not, never run: not proven: \"\n      + join(open, \"; \"))\n  }\n}"}]}
{"id":"ebadee2ea290408e","time":1795665606,"message":"edit","changes":[{"name":"views.use ast","kind":"use","old":"3a7d1bec30fcd978","new":"ad12f8b90ce601d8","interface_changed":true,"affected":[],"module":"views","text":"// views: what `strata view` selects and prints.\n\nfrom ast use Decl, FnDef, ImplDef, TraitDef, CapabilityDef, TestDef, TypeDef,\n  TypeDecl, TypeBody, SumBody, RecordBody, Alias, Variant, MemberType,\n  RecordPayload, Named, UnitType, UnionType, Expr, Stmt, FnDecl, Block, Comment,\n  Invariant, Decreases, AssertBy, Calc, While, For, Loop, UnitExpr, ImplDecl","old_text":"// views: what `strata view` selects and prints.\n\nfrom ast use Decl, FnDef, ImplDef, TraitDef, CapabilityDef, TestDef, TypeDef,\n  TypeDecl, TypeBody, SumBody, RecordBody, Alias, Variant, MemberType,\n  RecordPayload, Named, UnitType, UnionType"},{"name":"views.use text","kind":"use","old":"fe48818d65a8de7c","new":"f7d24481fe69d4f6","interface_changed":true,"affected":[],"module":"views","text":"from text use fn_signature_text, impl_interface_text, trait_interface_text,\n  capability_interface_text, decl_body_text, comments_text, doc_text, type_text,\n  escape, attached_derives, derive_line, derive_owners, expr_text, pattern_text,\n  block_text, loop_clauses","old_text":"from text use fn_signature_text, impl_interface_text, trait_interface_text,\n  capability_interface_text, decl_body_text, comments_text, doc_text, type_text,\n  escape, attached_derives, derive_line, derive_owners"},{"name":"views.use walk","kind":"use","old":null,"new":"f63a3702e9ec7fd8","interface_changed":true,"affected":[],"module":"views","text":"from walk use rewrite_expr, rewrite_decl, kids, stmt_kids"},{"name":"views.is_lemma","kind":"fn","old":null,"new":"7ddd3443086de54e","interface_changed":true,"affected":[],"module":"views","text":"/// Whether `d` is a lemma (`lemma name(…) ensures …`).\npub fn is_lemma(d: ast.Decl) -> Bool {\n  match d.kind {\n    ast.FnDef(f) => f.lemma,\n    _ => false,\n  }\n}"},{"name":"views.hidden_stmt","kind":"fn","old":null,"new":"2754183b114fc182","interface_changed":true,"affected":[],"module":"views","text":"/// Whether `s` is proof material that views hide: a loop's or a function's\n/// clause (`invariant`, `decreases`), an `assert … by`, a `calc`.\nfn hidden_stmt(s: ast.Stmt) -> Bool {\n  match s {\n    ast.Invariant(_) | ast.Decreases(_) | ast.AssertBy { .. } | ast.Calc(_) => true,\n    _ => false,\n  }\n}"},{"name":"views.marker","kind":"fn","old":null,"new":"86bc35ef85ac8b12","interface_changed":true,"affected":[],"module":"views","text":"/// Whether `s` is a marker a view put where it hid proof material (`// ⋯ 2\n/// invariants`): read back, it is dropped.\nfn marker(s: ast.Stmt) -> Bool {\n  match s {\n    ast.Comment(cs) => cs != [] && cs.all(c -> starts_with(c, \"// ⋯\")),\n    _ => false,\n  }\n}"},{"name":"views.counted","kind":"fn","old":null,"new":"4f41fbb8fb7b515a","interface_changed":true,"affected":[],"module":"views","text":"fn counted(n: Int, one: String) -> String {\n  if n == 1 {\n    \"1 \" + one\n  } else {\n    f\"{n} {one}s\"\n  }\n}"},{"name":"views.proofs_hidden","kind":"fn","old":null,"new":"e32728ea79997a6b","interface_changed":true,"affected":[],"module":"views","text":"/// `d` as `strata view` shows it by default: its proof material hidden (a\n/// loop's `invariant` and `decreases` clauses, a function's `decreases`,\n/// `assert … by` and `calc` statements), each place marked by a quiet\n/// comment (`// ⋯ 2 invariants`). A lemma is shown whole (views leave\n/// lemmas out unless asked for). `strata view --proofs` shows everything;\n/// `strata edit` puts the hidden parts back (`proofs_kept`).\npub fn proofs_hidden(d: ast.Decl) -> ast.Decl {\n  if views.is_lemma(d) {\n    return d\n  }\n  walk.rewrite_decl(d, e -> views.hidden_in(e))\n}"},{"name":"views.hidden_in","kind":"fn","old":null,"new":"cbc0ad148726c56f","interface_changed":true,"affected":[],"module":"views","text":"fn hidden_in(e: ast.Expr) -> ast.Expr {\n  match e {\n    ast.Block { stmts, last } => if stmts.any(s -> views.hidden_stmt(s)) {\n      mut out := []\n      // a block's leading clauses (a loop's, a function's `decreases`)\n      invs := text.loop_clauses(e).filter(s -> s is ast.Invariant)\n      decs := text.loop_clauses(e).filter(s -> s is ast.Decreases)\n      mut parts := []\n      if invs != [] {\n        mut parts.push(views.counted(len(invs), \"invariant\"))\n      }\n      if decs != [] {\n        mut parts.push(\"decreases\")\n      }\n      if parts != [] {\n        mut out.push(ast.Comment([\"// ⋯ \" + join(parts, \", \")]))\n      }\n      mut proofs := 0\n      for s in drop(stmts, len(text.loop_clauses(e))) {\n        if s is ast.AssertBy || s is ast.Calc {\n          proofs += 1\n        } else if !views.hidden_stmt(s) {\n          if proofs > 0 {\n            mut out.push(\n              ast.Comment(\n                [\"// ⋯ \" + views.counted(proofs, \"proof\")],\n              ),\n            )\n            proofs = 0\n          }\n          mut out.push(s)\n        }\n      }\n      if proofs > 0 {\n        mut out.push(\n          ast.Comment([\"// ⋯ \" + views.counted(proofs, \"proof\")]),\n        )\n      }\n      ast.Block { stmts: out, last }\n    } else {\n      e\n    },\n    _ => e,\n  }\n}"},{"name":"views.markers_dropped","kind":"fn","old":null,"new":"73ffa2a6086cf645","interface_changed":true,"affected":[],"module":"views","text":"/// `e` without the markers a view left (`marker`).\nfn markers_dropped(e: ast.Expr) -> ast.Expr {\n  walk.rewrite_expr(e, x -> views.markers_dropped_here(x))\n}"},{"name":"views.bare_code","kind":"fn","old":null,"new":"0212c02bb9acc658","interface_changed":true,"affected":[],"module":"views","text":"/// `e` without its proof material (`hidden_stmt`), for comparing code.\nfn bare_code(e: ast.Expr) -> ast.Expr {\n  walk.rewrite_expr(\n    e,\n    x ->\n      match x {\n        ast.Block { stmts, last } => if stmts.any(s -> views.hidden_stmt(s) || views.marker(s)) {\n          kept := stmts.filter(\n            s -> !views.hidden_stmt(s) && !views.marker(s),\n          )\n          if kept == [] {\n            last\n          } else {\n            ast.Block { stmts: kept, last }\n          }\n        } else {\n          x\n        },\n        _ => x,\n      },\n  )\n}"},{"name":"views.code_text","kind":"fn","old":null,"new":"39e82ae50b32244a","interface_changed":true,"affected":[],"module":"views","text":"/// A statement as text, without proof material.\nfn code_text(s: ast.Stmt) -> String {\n  text.block_text(\n    views.bare_code(ast.Block { stmts: [s], last: ast.UnitExpr }),\n    0,\n  )\n}"},{"name":"views.loop_head","kind":"fn","old":null,"new":"197ffbc4fddd3315","interface_changed":true,"affected":[],"module":"views","text":"/// A loop's head: `while c`, `for p in xs`, `loop`. `\"\"` for any other\n/// statement.\nfn loop_head(s: ast.Stmt) -> String {\n  match s {\n    ast.While { cond, .. } => \"while \" + text.expr_text(cond, 0),\n    ast.For { pat, iter, .. } => \"for \"\n      + text.pattern_text(pat)\n      + \" in \"\n      + text.expr_text(iter, 0),\n    ast.Loop(_) => \"loop\",\n    _ => \"\",\n  }\n}"},{"name":"views.loop_body_of","kind":"fn","old":null,"new":"0bd867eb3e7ed5f9","interface_changed":true,"affected":[],"module":"views","text":"fn loop_body_of(s: ast.Stmt) -> ast.Expr {\n  match s {\n    ast.While { body, .. } | ast.For { body, .. } | ast.Loop(body) => body,\n    _ => ast.UnitExpr,\n  }\n}"},{"name":"views.loops_in","kind":"fn","old":null,"new":"9ccaaebad1375cd4","interface_changed":true,"affected":[],"module":"views","text":"/// The loops of `e` in order (a loop before those inside it), each with\n/// its head and its clauses.\nfn loops_in(e: ast.Expr) -> List[(String, ast.Stmt)] {\n  mut out := []\n  match e {\n    ast.Block { stmts, last } => {\n      for s in stmts {\n        if views.loop_head(s) != \"\" {\n          mut out.push((views.loop_head(s), s))\n        }\n        for k in walk.stmt_kids(s) {\n          out += views.loops_in(k)\n        }\n      }\n      out += views.loops_in(last)\n    },\n    _ => {\n      for k in walk.kids(e) {\n        out += views.loops_in(k)\n      }\n    },\n  }\n  out\n}"},{"name":"views.proofs_in","kind":"fn","old":null,"new":"a7779e1bcc085872","interface_changed":true,"affected":[],"module":"views","text":"/// The proof statements of `e` (`assert … by`, `calc`) not first in a\n/// block's clauses, each with the code statement before it (`\"\"`: first)\n/// and the one after it (the block's result, `\"= \"` and its text, when\n/// last), as `code_text` shows them.\nfn proofs_in(e: ast.Expr) -> List[(String, String, ast.Stmt)] {\n  mut out := []\n  match e {\n    ast.Block { stmts, last } => {\n      mut before := \"\"\n      for (k, s) in enumerate(stmts) {\n        if s is ast.AssertBy || s is ast.Calc {\n          after := match drop(stmts, k + 1).filter(\n            x -> !views.hidden_stmt(x) && !views.marker(x),\n          ) {\n            [n, ..] => views.code_text(n),\n            [] => \"= \" + text.expr_text(views.bare_code(last), 0),\n          }\n          mut out.push((before, after, s))\n        } else if !views.hidden_stmt(s) && !views.marker(s) {\n          before = views.code_text(s)\n        }\n        for x in walk.stmt_kids(s) {\n          out += views.proofs_in(x)\n        }\n      }\n      out += views.proofs_in(last)\n    },\n    _ => {\n      for k in walk.kids(e) {\n        out += views.proofs_in(k)\n      }\n    },\n  }\n  out\n}"},{"name":"views.body_kept","kind":"fn","old":null,"new":"cb9df8e43129526f","interface_changed":true,"affected":[],"module":"views","text":"/// What `body` (read back from a view) left out of the stored `stored`,\n/// put back, with a note for each part it couldn't place:\n/// - the function's `decreases`, when `body` has none;\n/// - a loop's clauses, when `body`'s loop of the same head (the k-th loop\n/// with that head, as stored) has none. A loop whose head changed or that\n/// is gone loses them (a note says so);\n/// - an `assert … by` or `calc` not in `body`, after the statement it\n/// followed (or before the one it preceded), when that statement is in\n/// `body` exactly once.\nfn body_kept(\n  stored: ast.Expr,\n  given: ast.Expr,\n  name: String,\n) -> (ast.Expr, List[String]) {\n  mut notes := []\n  body0 := views.markers_dropped(given)\n  // the function's `decreases`\n  old_decs := text.loop_clauses(stored).filter(s -> s is ast.Decreases)\n  body1 := if old_decs != []\n    && text.loop_clauses(body0).filter(s -> s is ast.Decreases) == [] {\n    match body0 {\n      ast.Block { stmts, last } => ast.Block { stmts: old_decs + stmts, last },\n      other => ast.Block { stmts: old_decs, last: other },\n    }\n  } else {\n    body0\n  }\n  // loops, by head and rank among loops of that head\n  old_loops := views.loops_in(stored)\n  new_loops := views.loops_in(body1)\n  mut plan: List[(String, List[ast.Stmt])] = []\n  mut used := Set[Int] {}\n  for (i, (h, s)) in enumerate(new_loops) {\n    rank := len(new_loops[..i].filter(x -> x.0 == h))\n    mut seen := 0\n    for (j, (oh, os)) in enumerate(old_loops) {\n      if oh == h {\n        if seen == rank {\n          mut used.insert(j)\n          clauses := text.loop_clauses(views.loop_body_of(os))\n          if clauses != []\n            && text.loop_clauses(views.loop_body_of(s)) == [] {\n            mut plan.push((h + \"\\n\" + views.code_text(s), clauses))\n          }\n          break\n        }\n        seen += 1\n      }\n    }\n  }\n  for (j, (oh, os)) in enumerate(old_loops) {\n    n := len(text.loop_clauses(views.loop_body_of(os)))\n    if n > 0 && !contains(used, j) {\n      what := views.counted(n, \"clause\")\n      mut notes.push(\n        f\"in `{name}`: the {what} of `{oh}` (hidden in the view) were dropped: that loop changed or is gone; write them again (`strata view {name} --proofs` shows them), or let the search find invariants\",\n      )\n    }\n  }\n  body2 := if plan == [] {\n    body1\n  } else {\n    walk.rewrite_expr(body1, x -> match x {\n      ast.Block { stmts, last } => if stmts.any(s -> views.loop_head(s) != \"\") {\n        ast.Block { stmts: stmts.map(\n          s -> if views.loop_head(s) == \"\"\n            || text.loop_clauses(views.loop_body_of(s)) != [] {\n            s\n          } else {\n            match plan.filter(\n              p ->\n                p.0 == views.loop_head(s) + \"\\n\" + views.code_text(s),\n            ) {\n              [(_, cs), ..] => views.with_clauses(s, cs),\n              [] => s,\n            }\n          },\n        ), last }\n      } else {\n        x\n      },\n      _ => x,\n    })\n  }\n  // proof statements, by the code around them\n  old_proofs := views.proofs_in(stored)\n  given_proofs := views.proofs_in(body2).map(p -> views.code_text(p.2))\n  mut all_code := []\n  for s in views.stmts_in(body2) {\n    if !views.hidden_stmt(s) && !views.marker(s) {\n      mut all_code.push(views.code_text(s))\n    }\n  }\n  mut put := []\n  for (before, after, s) in old_proofs {\n    if contains(given_proofs, views.code_text(s)) {\n      continue\n    }\n    anchor := if before != \"\" {\n      before\n    } else {\n      after\n    }\n    if len(all_code.filter(c -> c == anchor)) == 1 {\n      mut put.push((before, after, s))\n    } else {\n      shown := match s {\n        ast.AssertBy { cond, .. } => \"assert \" + text.expr_text(cond, 0) + \" by …\",\n        _ => \"calc { … }\",\n      }\n      mut notes.push(\n        f\"in `{name}`: the proof `{shown}` (hidden in the view) was dropped: the code around it changed; write it again (`strata view {name} --proofs` shows it)\",\n      )\n    }\n  }\n  body3 := if put == [] {\n    body2\n  } else {\n    walk.rewrite_expr(body2, x -> match x {\n      ast.Block { stmts, last } => {\n        mut out := []\n        for s in stmts {\n          t := if views.hidden_stmt(s) {\n            \"\"\n          } else {\n            views.code_text(s)\n          }\n          for (before, after, p) in put {\n            if before == \"\" && after == t && t != \"\" {\n              mut out.push(p)\n            }\n          }\n          mut out.push(s)\n          for (before, _, p) in put {\n            if before != \"\" && before == t {\n              mut out.push(p)\n            }\n          }\n        }\n        if len(out) == len(stmts) {\n          x\n        } else {\n          ast.Block { stmts: out, last }\n        }\n      },\n      _ => x,\n    })\n  }\n  (body3, notes)\n}"},{"name":"views.stmts_in","kind":"fn","old":null,"new":"82cc0adc410e8205","interface_changed":true,"affected":[],"module":"views","text":"/// The statements of `e`'s blocks, at any depth.\nfn stmts_in(e: ast.Expr) -> List[ast.Stmt] {\n  mut out := []\n  match e {\n    ast.Block { stmts, .. } => {\n      out += stmts\n    },\n    _ => (),\n  }\n  for k in walk.kids(e) {\n    out += views.stmts_in(k)\n  }\n  out\n}"},{"name":"views.with_clauses","kind":"fn","old":null,"new":"2793ebf1675566af","interface_changed":true,"affected":[],"module":"views","text":"fn with_clauses(s: ast.Stmt, cs: List[ast.Stmt]) -> ast.Stmt {\n  put := (b: ast.Expr) -> match b {\n    ast.Block { stmts, last } => ast.Block { stmts: cs + stmts, last },\n    other => ast.Block { stmts: cs, last: other },\n  }\n  match s {\n    ast.While { cond, body } => ast.While { cond, body: put(body) },\n    ast.For { pat, iter, body } => ast.For { pat, iter, body: put(body) },\n    ast.Loop(body) => ast.Loop(put(body)),\n    _ => s,\n  }\n}"},{"name":"views.fn_kept","kind":"fn","old":null,"new":"79f312c8cd14e750","interface_changed":true,"affected":[],"module":"views","text":"fn fn_kept(\n  stored: ast.FnDecl,\n  given: ast.FnDecl,\n  name: String,\n) -> (ast.FnDecl, List[String]) {\n  if given.lemma {\n    return (given, [])\n  }\n  (body, notes) := views.body_kept(stored.body, given.body, name)\n  (ast.FnDecl { ..given, body }, notes)\n}"},{"name":"views.proofs_kept","kind":"fn","old":null,"new":"8debe7573a918e01","interface_changed":true,"affected":[],"module":"views","text":"/// The definitions `edits` (text read back from a view) with the proof\n/// material views hide (`proofs_hidden`) put back from their stored\n/// versions in `old`, where the text has none of its own there, and the\n/// markers dropped. With notes on the parts that couldn't be placed (their\n/// place changed or is gone).\npub fn proofs_kept(\n  old: List[ast.Decl],\n  edits: List[ast.Decl],\n) -> (List[ast.Decl], List[String]) {\n  mut notes := []\n  mut out := []\n  for d in edits {\n    q := store.qname(d)\n    stored := old.filter(o -> store.qname(o) == q)\n    kept := match (d.kind, stored) {\n      (ast.FnDef(f), [ast.Decl { kind: ast.FnDef(of), .. }, ..]) => {\n        (nf, ns) := views.fn_kept(of, f, q)\n        notes += ns\n        ast.Decl { ..d, kind: ast.FnDef(nf) }\n      },\n      (ast.ImplDef(im), [ast.Decl { kind: ast.ImplDef(oi), .. }, ..]) => {\n        mut ms := []\n        for m in im.methods {\n          match oi.methods.filter(x -> x.name == m.name) {\n            [om, ..] => {\n              (nm, ns) := views.fn_kept(om, m, q + \".\" + m.name)\n              notes += ns\n              mut ms.push(nm)\n            },\n            [] => mut ms.push(\n              ast.FnDecl { ..m, body: views.markers_dropped(m.body) },\n            ),\n          }\n        }\n        ast.Decl { ..d, kind: ast.ImplDef(ast.ImplDecl { ..im, methods: ms }) }\n      },\n      _ => walk.rewrite_decl(d, e -> views.markers_dropped_here(e)),\n    }\n    mut out.push(kept)\n  }\n  (out, notes)\n}"},{"name":"views.markers_dropped_here","kind":"fn","old":null,"new":"efb833a59fbd0869","interface_changed":true,"affected":[],"module":"views","text":"/// One block without the markers a view left.\nfn markers_dropped_here(x: ast.Expr) -> ast.Expr {\n  match x {\n    ast.Block { stmts, last } => if stmts.any(s -> views.marker(s)) {\n      kept := stmts.filter(s -> !views.marker(s))\n      if kept == [] {\n        last\n      } else {\n        ast.Block { stmts: kept, last }\n      }\n    } else {\n      x\n    },\n    _ => x,\n  }\n}"}]}
{"id":"68df2480d67e1b2c","time":1795665666,"message":"edit","changes":[{"name":"EditArgs","kind":"type","old":"14b3c839ef41ce3f","new":"8cac595a042e6e58","interface_changed":true,"affected":["edit_args","edit_command","apply_edit","edit_in_editor","edit_file","command_line","repl_command","main","strata_command","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","call_command","loaded_errors","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","package_errors","check_files","apply_change","fix_loops","diff_command","with_base","rename_command","move_command","fix_command"],"module":"","text":"/// The module, the message, the definitions to remove, whether to commit\n/// to git, and whether to search for the invariants of the changed\n/// functions' loops (`--no-search`: not).\ntype EditArgs = {\n  module: Option[String],\n  // (a second one: `add FILE MODULE`)\n  extra: Option[String],\n  message: String,\n  removes: List[String],\n  commit: Bool,\n  search: Bool = true,\n  // `--proofs`: the text shows the proof material (as `view --proofs` does),\n  // so nothing hidden is put back\n  proofs: Bool = false,\n}","old_text":"/// The module, the message, the definitions to remove, whether to commit\n/// to git, and whether to search for the invariants of the changed\n/// functions' loops (`--no-search`: not).\ntype EditArgs = {\n  module: Option[String],\n  // (a second one: `add FILE MODULE`)\n  extra: Option[String],\n  message: String,\n  removes: List[String],\n  commit: Bool,\n  search: Bool = true,\n}"},{"name":"edit_args","kind":"fn","old":"bf48999955867731","new":"41ff79a3740f7a27","interface_changed":false,"affected":[],"module":"","text":"fn edit_args(args: List[String]) -> Result[EditArgs, String] {\n  mut module := None\n  mut message := \"edit\"\n  mut removes := []\n  mut commit := true\n  mut search := true\n  mut proofs := false\n  mut extra := None\n  mut i := 0\n  while i < len(args) {\n    a := get(args, i) ?? \"\"\n    i += 1\n    if a == \"-m\" || a == \"--rm\" {\n      v := match get(args, i) {\n        Some(v) => v,\n        None => return Err(f\"`{a}` needs a value\"),\n      }\n      i += 1\n      if a == \"-m\" {\n        message = v\n      } else {\n        mut removes.push(v)\n      }\n    } else if a == \"--no-commit\" {\n      commit = false\n    } else if a == \"--no-search\" {\n      search = false\n    } else if a == \"--proofs\" {\n      proofs = true\n    } else if a == \"--editor\" || a == \"--json\" {\n      // (`edit_command` reads it)\n      ()\n    } else if starts_with(a, \"-\") {\n      return Err(f\"unknown option `{a}`\")\n    } else if module is None {\n      module = Some(a)\n    } else if extra is None {\n      extra = Some(a)\n    } else {\n      return Err(f\"unexpected argument `{a}`\")\n    }\n  }\n  Ok(EditArgs {\n    module,\n    extra,\n    message,\n    removes,\n    commit,\n    search,\n    proofs,\n  })\n}","old_text":"fn edit_args(args: List[String]) -> Result[EditArgs, String] {\n  mut module := None\n  mut message := \"edit\"\n  mut removes := []\n  mut commit := true\n  mut search := true\n  mut extra := None\n  mut i := 0\n  while i < len(args) {\n    a := get(args, i) ?? \"\"\n    i += 1\n    if a == \"-m\" || a == \"--rm\" {\n      v := match get(args, i) {\n        Some(v) => v,\n        None => return Err(f\"`{a}` needs a value\"),\n      }\n      i += 1\n      if a == \"-m\" {\n        message = v\n      } else {\n        mut removes.push(v)\n      }\n    } else if a == \"--no-commit\" {\n      commit = false\n    } else if a == \"--no-search\" {\n      search = false\n    } else if a == \"--editor\" || a == \"--json\" {\n      // (`edit_command` reads it)\n      ()\n    } else if starts_with(a, \"-\") {\n      return Err(f\"unknown option `{a}`\")\n    } else if module is None {\n      module = Some(a)\n    } else if extra is None {\n      extra = Some(a)\n    } else {\n      return Err(f\"unexpected argument `{a}`\")\n    }\n  }\n  Ok(EditArgs { module, extra, message, removes, commit, search })\n}"},{"name":"edit_command","kind":"fn","old":"5206c92d9378b991","new":"a756240b354f214b","interface_changed":false,"affected":[],"module":"","text":"/// `strata edit [MODULE] [-m MSG] [--rm NAME].. [--no-commit] [--no-search]`\n/// and `strata\n/// add FILE [MODULE]`: definitions from standard input (or the file, or the\n/// editor) replace or join the package's of the same names in MODULE\n/// (default the root module). Recorded only if the whole package checks.\nfn edit_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  args: List[String],\n  cmd: String,\n) -> std.process.ExitCode {\n  if contains(args, \"--help\") || contains(args, \"-h\") {\n    mut console.write(command_usage(cmd))\n    return 0\n  }\n  // `--file F`: a script or a folder, outside any log. std's folder is\n  // edited as a package is, checked and atomic (it is built into strata).\n  mut line := args\n  mut opened: Option[Result[Opened, String]] = None\n  match [k for (k, x) in enumerate(args) where x == \"--file\"] {\n    [k, ..] => {\n      f := get(args, k + 1) ?? \"\"\n      rest := [x for (i, x) in enumerate(args) where i != k && i != k + 1]\n      if disk.is_dir(f) && package_name(disk, f) == \"std\" {\n        opened = Some(open_package_at(disk, process, f, cmd))\n        line = rest\n      } else {\n        return edit_file(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          f,\n          rest,\n          cmd,\n        )\n      }\n    },\n    [] => (),\n  }\n  timings.begin(\"edit: open\")\n  o := match opened ?? open_package(disk, process, cmd) {\n    Ok(o) => o,\n    Err(_) => return fail_with(\n      mut console,\n      \"no package here (no strata.toml in this folder or above: run `strata init`, or pass --file)\",\n    ),\n  }\n  timings.end(\"edit: open\")\n  // (`--file std`: outside any log, as `--file` is: written and checked,\n  // never committed to git)\n  given_args := match edit_args(line) {\n    Ok(g) => EditArgs { ..g, commit: g.commit && opened is None },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // (`--rm NAME`: a qualified name, or a short one naming one definition,\n  // in MODULE first)\n  a := match removed_names(o.decls, if cmd == \"add\" {\n    \"\"\n  } else {\n    package_module(o.name, edit_module(given_args.module ?? \"\"))\n  }, given_args.removes) {\n    Ok(rs) => EditArgs { ..given_args, removes: rs },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // `add FILE [MODULE]`: the file's text, into MODULE. For a module file or\n  // a folder of them: its definitions, in their modules.\n  if cmd == \"add\" {\n    f := a.module ?? \"\"\n    stored_defs := if disk.is_dir(f) {\n      Some(package_decls(disk, f, \"\"))\n    } else {\n      match disk.read_bytes(f) {\n        Ok(bytes) => match binary.read(bytes) {\n          Ok(img) => Some(img.decls),\n          Err(_) => None,\n        },\n        Err(e) => return fail_with(mut console, f\"{f}: {e}\"),\n      }\n    }\n    match stored_defs {\n      Some(ds) => {\n        message := if a.message == \"edit\" {\n          \"import\"\n        } else {\n          a.message\n        }\n        return match apply_edit(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          clock,\n          cache,\n          o,\n          ds,\n          a.removes,\n          message,\n          a.commit,\n          cmd,\n          contains(line, \"--json\"),\n          [],\n          a.search,\n          true,\n        ) {\n          Ok(_) => 0,\n          Err(_) => 1,\n        }\n      },\n      None => (),\n    }\n  }\n  (text, module_arg, message) := if cmd == \"add\" {\n    f := a.module ?? \"\"\n    t := match disk.read(f) {\n      Ok(t) => t,\n      Err(e) => return fail_with(mut console, f\"{f}: {e}\"),\n    }\n    (t, a.extra ?? \"\", if a.message == \"edit\" {\n      \"import\"\n    } else {\n      a.message\n    })\n  } else if contains(line, \"--editor\")\n    || console.interactive()\n      && driver_terminal(1).to_int() == 1\n      && len(a.removes) == 0 {\n    // (an editor only for someone at the terminal: standard input and output\n    // both on it, and nothing to remove)\n    return edit_in_editor(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      clock,\n      cache,\n      o,\n      a,\n    )\n  } else {\n    match piped_input(\n      mut console,\n      len(a.removes) > 0,\n      \"strata edit [MODULE]\",\n    ) {\n      Ok(t) => (t, a.module ?? \"\", a.message),\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  // (std's modules as stored: `io` is `std.io`)\n  timings.begin(\"edit: parse\")\n  edits := match parse.parse_module(\n    text,\n    package_module(o.name, edit_module(module_arg)),\n  ) {\n    Ok(ds) => ds,\n    Err(e) => {\n      code := fail_with(mut console, f\"parse error at {e}\")\n      if cmd == \"edit\" {\n        say_kept(\n          mut console,\n          keep_rejected(mut disk, o.root, [(module_arg, text)]),\n        )\n      }\n      return code\n    },\n  }\n  timings.end(\"edit: parse\")\n  match apply_edit(\n    mut console,\n    mut disk,\n    mut launcher,\n    process,\n    clock,\n    cache,\n    o,\n    edits,\n    a.removes,\n    message,\n    a.commit,\n    cmd,\n    contains(line, \"--json\"),\n    if cmd == \"edit\" {\n      [(module_arg, text)]\n    } else {\n      []\n    },\n    a.search,\n    a.proofs,\n  ) {\n    Ok(_) => 0,\n    Err(_) => 1,\n  }\n}","old_text":"/// `strata edit [MODULE] [-m MSG] [--rm NAME].. [--no-commit] [--no-search]`\n/// and `strata\n/// add FILE [MODULE]`: definitions from standard input (or the file, or the\n/// editor) replace or join the package's of the same names in MODULE\n/// (default the root module). Recorded only if the whole package checks.\nfn edit_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  args: List[String],\n  cmd: String,\n) -> std.process.ExitCode {\n  if contains(args, \"--help\") || contains(args, \"-h\") {\n    mut console.write(command_usage(cmd))\n    return 0\n  }\n  // `--file F`: a script or a folder, outside any log. std's folder is\n  // edited as a package is, checked and atomic (it is built into strata).\n  mut line := args\n  mut opened: Option[Result[Opened, String]] = None\n  match [k for (k, x) in enumerate(args) where x == \"--file\"] {\n    [k, ..] => {\n      f := get(args, k + 1) ?? \"\"\n      rest := [x for (i, x) in enumerate(args) where i != k && i != k + 1]\n      if disk.is_dir(f) && package_name(disk, f) == \"std\" {\n        opened = Some(open_package_at(disk, process, f, cmd))\n        line = rest\n      } else {\n        return edit_file(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          f,\n          rest,\n          cmd,\n        )\n      }\n    },\n    [] => (),\n  }\n  timings.begin(\"edit: open\")\n  o := match opened ?? open_package(disk, process, cmd) {\n    Ok(o) => o,\n    Err(_) => return fail_with(\n      mut console,\n      \"no package here (no strata.toml in this folder or above: run `strata init`, or pass --file)\",\n    ),\n  }\n  timings.end(\"edit: open\")\n  // (`--file std`: outside any log, as `--file` is: written and checked,\n  // never committed to git)\n  given_args := match edit_args(line) {\n    Ok(g) => EditArgs { ..g, commit: g.commit && opened is None },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // (`--rm NAME`: a qualified name, or a short one naming one definition,\n  // in MODULE first)\n  a := match removed_names(o.decls, if cmd == \"add\" {\n    \"\"\n  } else {\n    package_module(o.name, edit_module(given_args.module ?? \"\"))\n  }, given_args.removes) {\n    Ok(rs) => EditArgs { ..given_args, removes: rs },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // `add FILE [MODULE]`: the file's text, into MODULE. For a module file or\n  // a folder of them: its definitions, in their modules.\n  if cmd == \"add\" {\n    f := a.module ?? \"\"\n    stored_defs := if disk.is_dir(f) {\n      Some(package_decls(disk, f, \"\"))\n    } else {\n      match disk.read_bytes(f) {\n        Ok(bytes) => match binary.read(bytes) {\n          Ok(img) => Some(img.decls),\n          Err(_) => None,\n        },\n        Err(e) => return fail_with(mut console, f\"{f}: {e}\"),\n      }\n    }\n    match stored_defs {\n      Some(ds) => {\n        message := if a.message == \"edit\" {\n          \"import\"\n        } else {\n          a.message\n        }\n        return match apply_edit(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          clock,\n          cache,\n          o,\n          ds,\n          a.removes,\n          message,\n          a.commit,\n          cmd,\n          contains(line, \"--json\"),\n          [],\n          a.search,\n        ) {\n          Ok(_) => 0,\n          Err(_) => 1,\n        }\n      },\n      None => (),\n    }\n  }\n  (text, module_arg, message) := if cmd == \"add\" {\n    f := a.module ?? \"\"\n    t := match disk.read(f) {\n      Ok(t) => t,\n      Err(e) => return fail_with(mut console, f\"{f}: {e}\"),\n    }\n    (t, a.extra ?? \"\", if a.message == \"edit\" {\n      \"import\"\n    } else {\n      a.message\n    })\n  } else if contains(line, \"--editor\")\n    || console.interactive()\n      && driver_terminal(1).to_int() == 1\n      && len(a.removes) == 0 {\n    // (an editor only for someone at the terminal: standard input and output\n    // both on it, and nothing to remove)\n    return edit_in_editor(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      clock,\n      cache,\n      o,\n      a,\n    )\n  } else {\n    match piped_input(\n      mut console,\n      len(a.removes) > 0,\n      \"strata edit [MODULE]\",\n    ) {\n      Ok(t) => (t, a.module ?? \"\", a.message),\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  // (std's modules as stored: `io` is `std.io`)\n  timings.begin(\"edit: parse\")\n  edits := match parse.parse_module(\n    text,\n    package_module(o.name, edit_module(module_arg)),\n  ) {\n    Ok(ds) => ds,\n    Err(e) => {\n      code := fail_with(mut console, f\"parse error at {e}\")\n      if cmd == \"edit\" {\n        say_kept(\n          mut console,\n          keep_rejected(mut disk, o.root, [(module_arg, text)]),\n        )\n      }\n      return code\n    },\n  }\n  timings.end(\"edit: parse\")\n  match apply_edit(\n    mut console,\n    mut disk,\n    mut launcher,\n    process,\n    clock,\n    cache,\n    o,\n    edits,\n    a.removes,\n    message,\n    a.commit,\n    cmd,\n    contains(line, \"--json\"),\n    if cmd == \"edit\" {\n      [(module_arg, text)]\n    } else {\n      []\n    },\n    a.search,\n  ) {\n    Ok(_) => 0,\n    Err(_) => 1,\n  }\n}"},{"name":"apply_edit","kind":"fn","old":"3950fec6962d4c75","new":"3517672a1fb8aad1","interface_changed":true,"affected":["edit_command","edit_in_editor","command_line","repl_command","main","strata_command","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","package_errors","check_files","apply_change","fix_loops","diff_command","with_base","rename_command","move_command","fix_command"],"module":"","text":"/// `strata edit [MODULE] [-m MSG] [--rm NAME].. [--no-commit]`: the\n/// definitions read from standard input replace or join the package's of\n/// the same names in MODULE (default the root module). Recorded only if the\n/// package still checks.\n/// - An edit that changes nothing writes, checks, logs and commits nothing.\n/// - Only the module files that change are written, and only what the edit\n/// can affect is checked (`edit_scope`): what it changed, and the users of\n/// what changed in its interface or was removed.\n/// - A rejected edit keeps `draft` (each module's text given, by its module\n/// argument: `keep_rejected`) and says where.\n/// - A declaration given drops its stored derives that are no longer on its\n/// `derive A, B for` line (`codebase.dropped_derives`), with a warning.\n/// - The functions changed that have loops get the invariants a search\n/// finds where those derived from their code don't prove a check (or a\n/// loop's end), written as `invariant` clauses with a warning\n/// (`search_invariants`; not with `search` false, `--no-search`).\nfn apply_edit(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  o: Opened,\n  given: List[ast.Decl],\n  removes: List[String],\n  message: String,\n  commit: Bool,\n  cmd: String,\n  json: Bool,\n  draft: List[(String, String)],\n  search: Bool,\n  proofs: Bool,\n) -> Result[(), List[String]] {\n  root := o.root\n  core := o.core\n  name := o.name\n  global := name == \"core\"\n  context := o.std\n  old := o.decls\n  // (text read back from a view: the proof material it hid is put back)\n  edits := if proofs {\n    given\n  } else {\n    (kept, notes) := views.proofs_kept(resolve.written(old, o.std, o.core), given)\n    for n in notes {\n      mut console.eprint(\"warning: \" + n)\n    }\n    kept\n  }\n  // (a declaration given drops its stored derives that are no longer on its\n  // `derive A, B for` line: `codebase.dropped_derives`)\n  dropped := codebase.dropped_derives(old, edits).filter(\n    q -> !contains(removes, q),\n  )\n  a := EditArgs {\n    module: None,\n    extra: None,\n    message,\n    removes: removes + dropped,\n    commit,\n  }\n  match both_given_and_removed(edits, removes) {\n    Some(e) => {\n      mut console.eprint(\n        std.cli.error_line(e, console.paint(std.term.Errors)),\n      )\n      return Err([e])\n    },\n    None => (),\n  }\n  new := timings.timed(\n    \"edit: merge\",\n    () -> codebase.merge(old, edits, a.removes, context, core),\n  )\n  if new == old {\n    // every definition given is as stored: nothing to write, check or log\n    if json {\n      mut console.print(\"[]\")\n    } else {\n      mut console.print(\n        \"no changes: every definition given is as stored (nothing written, checked or logged)\",\n      )\n    }\n    return Ok(())\n  }\n  before := package_bytes(disk, root)\n  timings.begin(\"edit: write\")\n  match codebase.write_modules(mut disk, root, old, new, global) {\n    Err(e) => return Err([e]),\n    Ok(_) => (),\n  }\n  timings.end(\"edit: write\")\n  // what the edit can affect is checked, as `strata check` checks it\n  open := pending.parse_pending(disk.read(pending.file_of(root)) !! \"\")\n  reach := timings.timed(\n    \"edit: scope\",\n    () -> edit_scope(old, new, before, global),\n  )\n  errors := edit_errors(mut launcher, mut disk, cache, o, new, reach, before)\n  if len(errors) > 0 {\n    // an edit that breaks code elsewhere (or calls what it changed the old\n    // way): the broken uses become holes, in a pending change\n    edited := edits.map(d -> store.qname(d)) + a.removes\n    first := match open {\n      Some(p) => len(p.holes) + 1,\n      None => 1,\n    }\n    match if cmd == \"edit\" {\n      pending.holeify(old, new, edited, errors, first)\n    } else {\n      None\n    } {\n      Some((with_holes, holes, notes)) => {\n        match codebase.write_modules(\n          mut disk,\n          root,\n          new,\n          with_holes,\n          global,\n        ) {\n          Err(e) => return Err([e]),\n          Ok(_) => (),\n        }\n        left := edit_errors(\n          mut launcher,\n          mut disk,\n          cache,\n          o,\n          with_holes,\n          edit_scope(old, with_holes, before, global),\n          before,\n        )\n        if len(left) == 0 {\n          p := match open {\n            Some(p) => p,\n            None => pending.Pending {\n              message: a.message,\n              started: clock.since_epoch().value / 1000000000,\n              before: before.map(b -> (b.0, pending.hex(b.1))),\n              holes: [],\n              renames: [],\n            },\n          }\n          saved := pending.Pending { ..p, holes: p.holes + holes }\n          mut disk.make_dir(root + \"/.strata\") !! ()\n          match mut disk.write(\n            pending.file_of(root),\n            pending.pending_json(saved),\n          ) {\n            Err(e) => return Err([f\"{e}\"]),\n            Ok(_) => (),\n          }\n          n := len(holes)\n          mut console.print(\n            f\"the edit breaks {n} use{if n == 1 {\n  \"\"\n} else {\n  \"s\"\n}} elsewhere; {if n == 1 {\n  \"it is now a hole\"\n} else {\n  \"they are now holes\"\n}}, in a pending change:\",\n          )\n          for h in holes {\n            if h.was == \"\" {\n              mut console.print(\n                f\"  ?{h.name}  in {h.decl}\\n      why: {join(h.why, \"; \")}\",\n              )\n            } else {\n              mut console.print(\n                f\"  ?{h.name}  in {h.decl}\\n      was: {h.was}\\n      why: {join(h.why, \"; \")}\",\n              )\n            }\n          }\n          for note in notes {\n            mut console.print(f\"  {note}\")\n          }\n          mut console.print(\n            \"fill them with `strata edit`, then `strata done` (or `strata abort` to undo the whole change)\",\n          )\n          return Ok(())\n        }\n        restore_files(mut disk, root, before)\n        say_rejected(\n          mut console,\n          mut disk,\n          root,\n          left.map(l -> error_text(l)),\n          draft,\n        )\n        return Err(left.map(l -> error_text(l)))\n      },\n      None => (),\n    }\n  }\n  // what the edit leaves unused (`edit_unused`): errors with `[check]\n  // unused = \"error\"`\n  setting := unused_setting(disk, root)\n  roots := setting.0\n  strict := setting.1\n  fresh := if global {\n    []\n  } else {\n    timings.timed(\"edit: unused\", () -> edit_unused(\n      old,\n      new,\n      edits.map(d -> store.qname(d)),\n      core,\n      roots,\n    ))\n  }\n  refused := errors\n    + if strict {\n      fresh.map(w -> (w.0, w.1))\n    } else {\n      []\n    }\n  if len(refused) > 0 {\n    restore_files(mut disk, root, before)\n    say_rejected(\n      mut console,\n      mut disk,\n      root,\n      refused.map(l -> error_text(l)),\n      draft,\n    )\n    return Err(refused.map(l -> error_text(l)))\n  }\n  cs := if name == \"std\" || name == \"core\" {\n    codebase.changes(old, new, global)\n  } else {\n    codebase.changes_with(old, new, global, Some(reach.graph))\n  }\n  // during a pending change, nothing is logged: `done` logs it as one\n  if len(cs) > 0 && name != \"std\" && name != \"core\" && open is None {\n    line := codebase.log_line(\n      old,\n      new,\n      cs,\n      a.message,\n      [],\n      clock.since_epoch().value,\n    )\n    match mut disk.append(root + \"/\" + codebase.log_file(), line + \"\\n\") {\n      Err(e) => return Err([f\"{e}\"]),\n      Ok(_) => (),\n    }\n  }\n  if len(cs) > 0 && a.commit && open is None {\n    git_commit(mut console, mut launcher, disk, root, a.message)\n  }\n  // (`--json`: the changes)\n  if json {\n    mut console.print(\n      driver.pretty_json(driver.JList(cs.map(\n        c -> driver.JObject([\n          (\"name\", driver.JStr(c.name)),\n          (\"kind\", driver.JStr(c.kind)),\n          (\"old\", match c.old {\n            Some(h) => driver.JStr(h),\n            None => driver.JNull,\n          }),\n          (\"new\", match c.new {\n            Some(h) => driver.JStr(h),\n            None => driver.JNull,\n          }),\n          (\"interface_changed\", driver.JBool(c.interface_changed)),\n          (\n            \"affected\",\n            driver.JList(c.affected.map(x -> driver.JStr(x))),\n          ),\n        ]),\n      ))),\n    )\n    return Ok(())\n  }\n  // (std's definitions by their full names, `std.io.shout`, as its\n  // modules are named)\n  mut console.write(change_lines(cs, new))\n  for q in dropped.filter(q -> !new.any(d -> store.qname(d) == q)) {\n    mut console.print(dropped_warning(q))\n  }\n  if !checked_whole(mut launcher, mut disk, cache, o) {\n    n := len(reach.checked)\n    mut console.print(\n      f\"checked {n} definition{plural(n, \"\", \"s\")} of {len(new)}: what the edit can affect\",\n    )\n  }\n  for w in timings.timed(\n    \"edit: near misses\",\n    () -> edit_warnings(new, edits.map(d -> store.qname(d)), core),\n  ) {\n    mut console.print(w)\n  }\n  for w in fresh {\n    mut console.print(w.2)\n  }\n  // (the holes of what changed: finding every hole would walk the whole\n  // package)\n  holes := len(pending.hole_names(\n    new.filter(d -> contains(reach.changed, store.qname(d))),\n  ))\n  if holes > 0 {\n    mut console.print(\n      f\"{holes} open hole(s) in what changed — see `strata holes`\",\n    )\n  }\n  // the loops of the functions changed: invariants searched for where\n  // those derived from the code don't prove their checks, and written\n  // (logged and committed as the edit is)\n  looped := loop_functions(new, cs.map(c -> c.name))\n  if search && looped != [] && holes == 0 {\n    _ := search_invariants(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      cache,\n      root,\n      looped,\n      \"edit\",\n      a.commit && open is None,\n    )\n  }\n  Ok(())\n}","old_text":"/// `strata edit [MODULE] [-m MSG] [--rm NAME].. [--no-commit]`: the\n/// definitions read from standard input replace or join the package's of\n/// the same names in MODULE (default the root module). Recorded only if the\n/// package still checks.\n/// - An edit that changes nothing writes, checks, logs and commits nothing.\n/// - Only the module files that change are written, and only what the edit\n/// can affect is checked (`edit_scope`): what it changed, and the users of\n/// what changed in its interface or was removed.\n/// - A rejected edit keeps `draft` (each module's text given, by its module\n/// argument: `keep_rejected`) and says where.\n/// - A declaration given drops its stored derives that are no longer on its\n/// `derive A, B for` line (`codebase.dropped_derives`), with a warning.\n/// - The functions changed that have loops get the invariants a search\n/// finds where those derived from their code don't prove a check (or a\n/// loop's end), written as `invariant` clauses with a warning\n/// (`search_invariants`; not with `search` false, `--no-search`).\nfn apply_edit(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  o: Opened,\n  edits: List[ast.Decl],\n  removes: List[String],\n  message: String,\n  commit: Bool,\n  cmd: String,\n  json: Bool,\n  draft: List[(String, String)],\n  search: Bool,\n) -> Result[(), List[String]] {\n  root := o.root\n  core := o.core\n  name := o.name\n  global := name == \"core\"\n  context := o.std\n  old := o.decls\n  // (a declaration given drops its stored derives that are no longer on its\n  // `derive A, B for` line: `codebase.dropped_derives`)\n  dropped := codebase.dropped_derives(old, edits).filter(\n    q -> !contains(removes, q),\n  )\n  a := EditArgs {\n    module: None,\n    extra: None,\n    message,\n    removes: removes + dropped,\n    commit,\n  }\n  match both_given_and_removed(edits, removes) {\n    Some(e) => {\n      mut console.eprint(\n        std.cli.error_line(e, console.paint(std.term.Errors)),\n      )\n      return Err([e])\n    },\n    None => (),\n  }\n  new := timings.timed(\n    \"edit: merge\",\n    () -> codebase.merge(old, edits, a.removes, context, core),\n  )\n  if new == old {\n    // every definition given is as stored: nothing to write, check or log\n    if json {\n      mut console.print(\"[]\")\n    } else {\n      mut console.print(\n        \"no changes: every definition given is as stored (nothing written, checked or logged)\",\n      )\n    }\n    return Ok(())\n  }\n  before := package_bytes(disk, root)\n  timings.begin(\"edit: write\")\n  match codebase.write_modules(mut disk, root, old, new, global) {\n    Err(e) => return Err([e]),\n    Ok(_) => (),\n  }\n  timings.end(\"edit: write\")\n  // what the edit can affect is checked, as `strata check` checks it\n  open := pending.parse_pending(disk.read(pending.file_of(root)) !! \"\")\n  reach := timings.timed(\n    \"edit: scope\",\n    () -> edit_scope(old, new, before, global),\n  )\n  errors := edit_errors(mut launcher, mut disk, cache, o, new, reach, before)\n  if len(errors) > 0 {\n    // an edit that breaks code elsewhere (or calls what it changed the old\n    // way): the broken uses become holes, in a pending change\n    edited := edits.map(d -> store.qname(d)) + a.removes\n    first := match open {\n      Some(p) => len(p.holes) + 1,\n      None => 1,\n    }\n    match if cmd == \"edit\" {\n      pending.holeify(old, new, edited, errors, first)\n    } else {\n      None\n    } {\n      Some((with_holes, holes, notes)) => {\n        match codebase.write_modules(\n          mut disk,\n          root,\n          new,\n          with_holes,\n          global,\n        ) {\n          Err(e) => return Err([e]),\n          Ok(_) => (),\n        }\n        left := edit_errors(\n          mut launcher,\n          mut disk,\n          cache,\n          o,\n          with_holes,\n          edit_scope(old, with_holes, before, global),\n          before,\n        )\n        if len(left) == 0 {\n          p := match open {\n            Some(p) => p,\n            None => pending.Pending {\n              message: a.message,\n              started: clock.since_epoch().value / 1000000000,\n              before: before.map(b -> (b.0, pending.hex(b.1))),\n              holes: [],\n              renames: [],\n            },\n          }\n          saved := pending.Pending { ..p, holes: p.holes + holes }\n          mut disk.make_dir(root + \"/.strata\") !! ()\n          match mut disk.write(\n            pending.file_of(root),\n            pending.pending_json(saved),\n          ) {\n            Err(e) => return Err([f\"{e}\"]),\n            Ok(_) => (),\n          }\n          n := len(holes)\n          mut console.print(\n            f\"the edit breaks {n} use{if n == 1 {\n  \"\"\n} else {\n  \"s\"\n}} elsewhere; {if n == 1 {\n  \"it is now a hole\"\n} else {\n  \"they are now holes\"\n}}, in a pending change:\",\n          )\n          for h in holes {\n            if h.was == \"\" {\n              mut console.print(\n                f\"  ?{h.name}  in {h.decl}\\n      why: {join(h.why, \"; \")}\",\n              )\n            } else {\n              mut console.print(\n                f\"  ?{h.name}  in {h.decl}\\n      was: {h.was}\\n      why: {join(h.why, \"; \")}\",\n              )\n            }\n          }\n          for note in notes {\n            mut console.print(f\"  {note}\")\n          }\n          mut console.print(\n            \"fill them with `strata edit`, then `strata done` (or `strata abort` to undo the whole change)\",\n          )\n          return Ok(())\n        }\n        restore_files(mut disk, root, before)\n        say_rejected(\n          mut console,\n          mut disk,\n          root,\n          left.map(l -> error_text(l)),\n          draft,\n        )\n        return Err(left.map(l -> error_text(l)))\n      },\n      None => (),\n    }\n  }\n  // what the edit leaves unused (`edit_unused`): errors with `[check]\n  // unused = \"error\"`\n  setting := unused_setting(disk, root)\n  roots := setting.0\n  strict := setting.1\n  fresh := if global {\n    []\n  } else {\n    timings.timed(\"edit: unused\", () -> edit_unused(\n      old,\n      new,\n      edits.map(d -> store.qname(d)),\n      core,\n      roots,\n    ))\n  }\n  refused := errors\n    + if strict {\n      fresh.map(w -> (w.0, w.1))\n    } else {\n      []\n    }\n  if len(refused) > 0 {\n    restore_files(mut disk, root, before)\n    say_rejected(\n      mut console,\n      mut disk,\n      root,\n      refused.map(l -> error_text(l)),\n      draft,\n    )\n    return Err(refused.map(l -> error_text(l)))\n  }\n  cs := if name == \"std\" || name == \"core\" {\n    codebase.changes(old, new, global)\n  } else {\n    codebase.changes_with(old, new, global, Some(reach.graph))\n  }\n  // during a pending change, nothing is logged: `done` logs it as one\n  if len(cs) > 0 && name != \"std\" && name != \"core\" && open is None {\n    line := codebase.log_line(\n      old,\n      new,\n      cs,\n      a.message,\n      [],\n      clock.since_epoch().value,\n    )\n    match mut disk.append(root + \"/\" + codebase.log_file(), line + \"\\n\") {\n      Err(e) => return Err([f\"{e}\"]),\n      Ok(_) => (),\n    }\n  }\n  if len(cs) > 0 && a.commit && open is None {\n    git_commit(mut console, mut launcher, disk, root, a.message)\n  }\n  // (`--json`: the changes)\n  if json {\n    mut console.print(\n      driver.pretty_json(driver.JList(cs.map(\n        c -> driver.JObject([\n          (\"name\", driver.JStr(c.name)),\n          (\"kind\", driver.JStr(c.kind)),\n          (\"old\", match c.old {\n            Some(h) => driver.JStr(h),\n            None => driver.JNull,\n          }),\n          (\"new\", match c.new {\n            Some(h) => driver.JStr(h),\n            None => driver.JNull,\n          }),\n          (\"interface_changed\", driver.JBool(c.interface_changed)),\n          (\n            \"affected\",\n            driver.JList(c.affected.map(x -> driver.JStr(x))),\n          ),\n        ]),\n      ))),\n    )\n    return Ok(())\n  }\n  // (std's definitions by their full names, `std.io.shout`, as its\n  // modules are named)\n  mut console.write(change_lines(cs, new))\n  for q in dropped.filter(q -> !new.any(d -> store.qname(d) == q)) {\n    mut console.print(dropped_warning(q))\n  }\n  if !checked_whole(mut launcher, mut disk, cache, o) {\n    n := len(reach.checked)\n    mut console.print(\n      f\"checked {n} definition{plural(n, \"\", \"s\")} of {len(new)}: what the edit can affect\",\n    )\n  }\n  for w in timings.timed(\n    \"edit: near misses\",\n    () -> edit_warnings(new, edits.map(d -> store.qname(d)), core),\n  ) {\n    mut console.print(w)\n  }\n  for w in fresh {\n    mut console.print(w.2)\n  }\n  // (the holes of what changed: finding every hole would walk the whole\n  // package)\n  holes := len(pending.hole_names(\n    new.filter(d -> contains(reach.changed, store.qname(d))),\n  ))\n  if holes > 0 {\n    mut console.print(\n      f\"{holes} open hole(s) in what changed — see `strata holes`\",\n    )\n  }\n  // the loops of the functions changed: invariants searched for where\n  // those derived from the code don't prove their checks, and written\n  // (logged and committed as the edit is)\n  looped := loop_functions(new, cs.map(c -> c.name))\n  if search && looped != [] && holes == 0 {\n    _ := search_invariants(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      cache,\n      root,\n      looped,\n      \"edit\",\n      a.commit && open is None,\n    )\n  }\n  Ok(())\n}"},{"name":"edit_file","kind":"fn","old":"3e5b4a0908763548","new":"73ddfba120e6ab67","interface_changed":false,"affected":[],"module":"","text":"/// `strata --file F edit [MODULE]` (or `add`): a script, or a folder's\n/// module, changed outside any log (created if new). Only what doesn't\n/// parse is refused. The result is written, then checked: what doesn't\n/// check is written all the same, with its errors and exit code 1. The\n/// functions changed that have loops then get the invariants a search\n/// finds, as `apply_edit` does.\nfn edit_file(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  f: String,\n  args: List[String],\n  cmd: String,\n) -> std.process.ExitCode {\n  a := match edit_args(args) {\n    Ok(a) => a,\n    Err(e) => return fail_with(mut console, e),\n  }\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  core := read_core_at(disk, home)\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  is_dir := disk.is_dir(f) || ends_with(f, \"/\")\n  path := if ends_with(f, \"/\") {\n    byte_slice(f, 0, byte_len(f) - 1)\n  } else {\n    f\n  }\n  if !is_dir && codebase.parent(path) != \"\" {\n    mut disk.make_dir(codebase.parent(path)) !! ()\n  }\n  // a module file in a package is the module its path names\n  root := if is_dir {\n    None\n  } else {\n    codebase.find_root(disk, if codebase.parent(path) == \"\" {\n      \".\"\n    } else {\n      codebase.parent(path)\n    })\n  }\n  in_package := match root {\n    Some(r) => {\n      prefix := r + \"/\"\n      rel := if starts_with(path, prefix) {\n        byte_slice(path, byte_len(prefix), byte_len(path))\n      } else {\n        path\n      }\n      Some(deps.module_name(module_prefix(disk, r), rel))\n    },\n    None => None,\n  }\n  // core's folder: its modules by their names (`core.gen`), its files by\n  // theirs (`gen.strata`)\n  in_core := is_dir && disk.exists(path) && package_name(disk, path) == \"core\"\n  old := if !disk.exists(path) {\n    []\n  } else if is_dir {\n    package_decls(disk, path, if in_core {\n      \"core\"\n    } else {\n      \"\"\n    })\n  } else {\n    decls_of(disk, path)\n  }\n  module := match in_package {\n    Some(m) => m,\n    None => if in_core {\n      m := edit_module(a.module ?? \"\")\n      if starts_with(m, \"core.\") || m == \"\" {\n        m\n      } else {\n        \"core.\" + m\n      }\n    } else if is_dir {\n      edit_module(a.module ?? \"\")\n    } else {\n      match old {\n        [d, ..] => d.module,\n        [] => \"\",\n      }\n    },\n  }\n  // (`--rm NAME`: a qualified name, or a short one naming one definition)\n  given_removes := match removed_names(old, module, a.removes) {\n    Ok(rs) => rs,\n    Err(e) => return fail_with(mut console, e),\n  }\n  text := if cmd == \"add\" {\n    disk.read(a.module ?? \"\") !! \"\"\n  } else {\n    match piped_input(\n      mut console,\n      len(given_removes) > 0,\n      \"strata --file F edit\",\n    ) {\n      Ok(t) => t,\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  parsed := match parse.parse_module(text, module) {\n    Ok(ds) => ds,\n    Err(e) => return fail_with(mut console, f\"parse error at {e}\"),\n  }\n  // (text read back from a view: the proof material it hid is put back)\n  edits := if a.proofs || cmd == \"add\" {\n    parsed\n  } else {\n    (kept, notes) := views.proofs_kept(resolve.written(old, std, core), parsed)\n    for n in notes {\n      mut console.eprint(\"warning: \" + n)\n    }\n    kept\n  }\n  match both_given_and_removed(edits, given_removes) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  // (a declaration given drops its stored derives that are no longer on its\n  // `derive A, B for` line)\n  dropped := codebase.dropped_derives(old, edits).filter(\n    q -> !contains(given_removes, q),\n  )\n  removes := given_removes + dropped\n  // (a package's other modules, for its references)\n  others := match root {\n    Some(r) => package_decls(disk, r, \"\").filter(d -> d.module != module),\n    None => [],\n  }\n  // (core's files keep their names as written: core's names are global)\n  of_core := in_core\n    || match root {\n      Some(r) => package_name(disk, r) == \"core\",\n      None => false,\n    }\n  new := if of_core {\n    codebase.merge_parsed(old, edits, removes)\n  } else {\n    codebase.merge(old, edits, removes, std + others, core)\n  }\n  if new == old && disk.exists(path) {\n    // every definition given is as stored: nothing written or checked\n    mut console.print(\n      f\"{f}: no changes: every definition given is as stored (nothing written or checked)\",\n    )\n    return 0\n  }\n  if is_dir {\n    match codebase.write_modules(mut disk, path, old, new, false) {\n      Err(e) => return fail_with(mut console, e),\n      Ok(_) => (),\n    }\n  } else {\n    // (the definitions that didn't change keep their stored bytes)\n    bytes := codebase.module_bytes(\n      disk.read_bytes(path) !! [],\n      module,\n      new,\n      old,\n      others + new,\n      false,\n    )\n    match mut disk.write_bytes(path, bytes) {\n      Err(e) => return fail_with(mut console, f\"{e}\"),\n      Ok(_) => (),\n    }\n  }\n  cs := codebase.changes(old, new, false)\n  mut console.print(\n    f\"{f}: {len(cs)} definition{plural(len(cs), \"\", \"s\")} changed, {len(new)} in all\",\n  )\n  for q in dropped.filter(q -> !new.any(d -> store.qname(d) == q)) {\n    mut console.print(dropped_warning(q))\n  }\n  for w in edit_warnings(new, cs.map(c -> c.name), core) {\n    mut console.print(w)\n  }\n  if !of_core {\n    roots := unused_setting(disk, root ?? path).0\n    for w in edit_unused(\n      old + others,\n      new + others,\n      cs.map(c -> c.name),\n      core,\n      roots,\n    ) {\n      mut console.print(w.2)\n    }\n  }\n  // (core checks only as the runtime's compilation does: `strata build-core`)\n  alone := !of_core\n    && in_package is None\n    && (is_dir || new.all(d -> d.module == \"\"))\n  if alone {\n    lib := std_imports(disk, std_dir, new)\n    sh := shared_at(disk, cache.caches_of(process), home_of_std(std_dir))\n    // (`comptime e` compiled, as `check` runs it, with its budget of steps: a\n    // runaway one is an error instead of a hang)\n    errors := std_use_check(\n        disk,\n        std_dir,\n        new,\n        use_errors_of(new, lib, Set[String] {}, core),\n      )\n      + warned(mut console, check_errors_with(\n        new,\n        lib,\n        core,\n        is_dir && package_reads_values(disk, path),\n        comptime_runner(disk, sh),\n      ))\n      + literal_errors_of(disk, new, lib, core, path, sh, [])\n    if len(errors) > 0 {\n      // (written all the same: a script is often written in steps)\n      n := len(errors)\n      mut console.eprint(\n        f\"written: {f} doesn't check ({n} error{plural(n, \"\", \"s\")}; --file edits are kept as given, unlike a package's edit, which is rejected):\",\n      )\n      for l in errors {\n        mut console.eprint(\"  \" + error_text(l))\n      }\n      return 1\n    }\n  }\n  // the loops of the functions changed: invariants searched for where\n  // those derived from the code don't prove their checks, and written\n  looped := loop_functions(new, cs.map(c -> c.name))\n  if a.search && looped != [] && !of_core {\n    _ := search_invariants(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      cache.caches_of(process),\n      path,\n      looped,\n      \"edit\",\n      false,\n    )\n  }\n  0\n}","old_text":"/// `strata --file F edit [MODULE]` (or `add`): a script, or a folder's\n/// module, changed outside any log (created if new). Only what doesn't\n/// parse is refused. The result is written, then checked: what doesn't\n/// check is written all the same, with its errors and exit code 1. The\n/// functions changed that have loops then get the invariants a search\n/// finds, as `apply_edit` does.\nfn edit_file(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  f: String,\n  args: List[String],\n  cmd: String,\n) -> std.process.ExitCode {\n  a := match edit_args(args) {\n    Ok(a) => a,\n    Err(e) => return fail_with(mut console, e),\n  }\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  core := read_core_at(disk, home)\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  is_dir := disk.is_dir(f) || ends_with(f, \"/\")\n  path := if ends_with(f, \"/\") {\n    byte_slice(f, 0, byte_len(f) - 1)\n  } else {\n    f\n  }\n  if !is_dir && codebase.parent(path) != \"\" {\n    mut disk.make_dir(codebase.parent(path)) !! ()\n  }\n  // a module file in a package is the module its path names\n  root := if is_dir {\n    None\n  } else {\n    codebase.find_root(disk, if codebase.parent(path) == \"\" {\n      \".\"\n    } else {\n      codebase.parent(path)\n    })\n  }\n  in_package := match root {\n    Some(r) => {\n      prefix := r + \"/\"\n      rel := if starts_with(path, prefix) {\n        byte_slice(path, byte_len(prefix), byte_len(path))\n      } else {\n        path\n      }\n      Some(deps.module_name(module_prefix(disk, r), rel))\n    },\n    None => None,\n  }\n  // core's folder: its modules by their names (`core.gen`), its files by\n  // theirs (`gen.strata`)\n  in_core := is_dir && disk.exists(path) && package_name(disk, path) == \"core\"\n  old := if !disk.exists(path) {\n    []\n  } else if is_dir {\n    package_decls(disk, path, if in_core {\n      \"core\"\n    } else {\n      \"\"\n    })\n  } else {\n    decls_of(disk, path)\n  }\n  module := match in_package {\n    Some(m) => m,\n    None => if in_core {\n      m := edit_module(a.module ?? \"\")\n      if starts_with(m, \"core.\") || m == \"\" {\n        m\n      } else {\n        \"core.\" + m\n      }\n    } else if is_dir {\n      edit_module(a.module ?? \"\")\n    } else {\n      match old {\n        [d, ..] => d.module,\n        [] => \"\",\n      }\n    },\n  }\n  // (`--rm NAME`: a qualified name, or a short one naming one definition)\n  given_removes := match removed_names(old, module, a.removes) {\n    Ok(rs) => rs,\n    Err(e) => return fail_with(mut console, e),\n  }\n  text := if cmd == \"add\" {\n    disk.read(a.module ?? \"\") !! \"\"\n  } else {\n    match piped_input(\n      mut console,\n      len(given_removes) > 0,\n      \"strata --file F edit\",\n    ) {\n      Ok(t) => t,\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  edits := match parse.parse_module(text, module) {\n    Ok(ds) => ds,\n    Err(e) => return fail_with(mut console, f\"parse error at {e}\"),\n  }\n  match both_given_and_removed(edits, given_removes) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  // (a declaration given drops its stored derives that are no longer on its\n  // `derive A, B for` line)\n  dropped := codebase.dropped_derives(old, edits).filter(\n    q -> !contains(given_removes, q),\n  )\n  removes := given_removes + dropped\n  // (a package's other modules, for its references)\n  others := match root {\n    Some(r) => package_decls(disk, r, \"\").filter(d -> d.module != module),\n    None => [],\n  }\n  // (core's files keep their names as written: core's names are global)\n  of_core := in_core\n    || match root {\n      Some(r) => package_name(disk, r) == \"core\",\n      None => false,\n    }\n  new := if of_core {\n    codebase.merge_parsed(old, edits, removes)\n  } else {\n    codebase.merge(old, edits, removes, std + others, core)\n  }\n  if new == old && disk.exists(path) {\n    // every definition given is as stored: nothing written or checked\n    mut console.print(\n      f\"{f}: no changes: every definition given is as stored (nothing written or checked)\",\n    )\n    return 0\n  }\n  if is_dir {\n    match codebase.write_modules(mut disk, path, old, new, false) {\n      Err(e) => return fail_with(mut console, e),\n      Ok(_) => (),\n    }\n  } else {\n    // (the definitions that didn't change keep their stored bytes)\n    bytes := codebase.module_bytes(\n      disk.read_bytes(path) !! [],\n      module,\n      new,\n      old,\n      others + new,\n      false,\n    )\n    match mut disk.write_bytes(path, bytes) {\n      Err(e) => return fail_with(mut console, f\"{e}\"),\n      Ok(_) => (),\n    }\n  }\n  cs := codebase.changes(old, new, false)\n  mut console.print(\n    f\"{f}: {len(cs)} definition{plural(len(cs), \"\", \"s\")} changed, {len(new)} in all\",\n  )\n  for q in dropped.filter(q -> !new.any(d -> store.qname(d) == q)) {\n    mut console.print(dropped_warning(q))\n  }\n  for w in edit_warnings(new, cs.map(c -> c.name), core) {\n    mut console.print(w)\n  }\n  if !of_core {\n    roots := unused_setting(disk, root ?? path).0\n    for w in edit_unused(\n      old + others,\n      new + others,\n      cs.map(c -> c.name),\n      core,\n      roots,\n    ) {\n      mut console.print(w.2)\n    }\n  }\n  // (core checks only as the runtime's compilation does: `strata build-core`)\n  alone := !of_core\n    && in_package is None\n    && (is_dir || new.all(d -> d.module == \"\"))\n  if alone {\n    lib := std_imports(disk, std_dir, new)\n    sh := shared_at(disk, cache.caches_of(process), home_of_std(std_dir))\n    // (`comptime e` compiled, as `check` runs it, with its budget of steps: a\n    // runaway one is an error instead of a hang)\n    errors := std_use_check(\n        disk,\n        std_dir,\n        new,\n        use_errors_of(new, lib, Set[String] {}, core),\n      )\n      + warned(mut console, check_errors_with(\n        new,\n        lib,\n        core,\n        is_dir && package_reads_values(disk, path),\n        comptime_runner(disk, sh),\n      ))\n      + literal_errors_of(disk, new, lib, core, path, sh, [])\n    if len(errors) > 0 {\n      // (written all the same: a script is often written in steps)\n      n := len(errors)\n      mut console.eprint(\n        f\"written: {f} doesn't check ({n} error{plural(n, \"\", \"s\")}; --file edits are kept as given, unlike a package's edit, which is rejected):\",\n      )\n      for l in errors {\n        mut console.eprint(\"  \" + error_text(l))\n      }\n      return 1\n    }\n  }\n  // the loops of the functions changed: invariants searched for where\n  // those derived from the code don't prove their checks, and written\n  looped := loop_functions(new, cs.map(c -> c.name))\n  if a.search && looped != [] && !of_core {\n    _ := search_invariants(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      cache.caches_of(process),\n      path,\n      looped,\n      \"edit\",\n      false,\n    )\n  }\n  0\n}"},{"name":"edit_in_editor","kind":"fn","old":"ef91a669cf1834c3","new":"34c1274d2e738b68","interface_changed":false,"affected":[],"module":"","text":"/// `strata edit [MODULE]` at a terminal (or `--editor`): opens the module\n/// (or the whole package, one file per module) in the editor as written,\n/// and applies what is saved. A definition deleted from the text is\n/// removed. An edit that doesn't go through is opened again with its errors\n/// on top. Saving it unchanged, or as an attempt already rejected, gives up\n/// with its errors and keeps the text (`keep_rejected`). The files opened\n/// are in `$TMPDIR`, outside the package, so a commit never takes them.\nfn edit_in_editor(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  o: Opened,\n  a: EditArgs,\n) -> std.process.ExitCode {\n  // (as `view` shows it: proof material and lemmas hidden unless `--proofs`)\n  written := if a.proofs {\n    resolve.written(o.decls, o.std, o.core)\n  } else {\n    resolve.written(o.decls, o.std, o.core).map(\n      d -> views.proofs_hidden(d),\n    )\n  }\n  mut modules := []\n  for d in written {\n    if !contains(modules, d.module) {\n      mut modules.push(d.module)\n    }\n  }\n  modules = to_list(set(modules))\n  // a module (`shop`, its file `shop.strata`, `main`), else the\n  // definitions a selector picks, each module's in a file of its own\n  module_named := match a.module {\n    Some(arg) => ends_with(arg, \".strata\")\n      || arg == \"main\"\n      || contains(modules, package_module(o.name, edit_module(arg))),\n    None => true,\n  }\n  picked := match a.module {\n    Some(arg) => if module_named {\n      []\n    } else {\n      match views.select(written, store.graph(written, false), Some(arg)) {\n        Ok(ns) => ns,\n        Err(_) => [],\n      }\n    },\n    None => [],\n  }\n  if !module_named && picked == [] {\n    sel := a.module ?? \"\"\n    return fail_with(\n      mut console,\n      f\"`{sel}` is no module and picks no definition (a new module is opened by its file: `strata edit {sel}.strata`)\",\n    )\n  }\n  chosen := match a.module {\n    Some(arg) => if module_named {\n      [package_module(o.name, edit_module(arg))]\n    } else {\n      to_list(set(\n        [d.module for d in written where contains(picked, store.qname(d))],\n      ))\n    },\n    None => if len(modules) == 0 {\n      [\"\"]\n    } else {\n      modules\n    },\n  }\n  dir := edit_scratch(process, clock)\n  mut disk.remove_all(dir) !! ()\n  // (module, path, the definitions shown (stored names), text)\n  mut files := []\n  for m in chosen {\n    // (a declaration picked comes with the derives written on it, on its\n    // `derive A, B for` line: `codebase.with_attached`)\n    selected := [k for (k, d) in enumerate(written) where d.module == m\n      && (module_named || contains(picked, store.qname(d)))]\n    here := if module_named {\n      selected\n    } else {\n      codebase.with_attached(written, selected)\n    }\n    text := if len(here) == 0 {\n      \"\"\n    } else if module_named {\n      text.module_text(written.filter(\n        d -> d.module == m && (a.proofs || !views.is_lemma(d)),\n      ))\n    } else {\n      text.module_text(\n        [d for (k, d) in enumerate(written) where contains(here, k)],\n      )\n    }\n    shown := here.map(\n      k -> store.qname(get(o.decls, k) or {\n        ast.Decl {\n          comments: [],\n          doc: [],\n          module: m,\n          public: false,\n          kind: ast.UseDef(\n            ast.UseDecl { path: \"\", alias: None, items: None },\n          ),\n        }\n      }),\n    )\n    p := dir\n      + \"/\"\n      + byte_slice(\n        codebase.module_path(m),\n        0,\n        byte_len(codebase.module_path(m)) - byte_len(\"strata\"),\n      )\n      + \"st\"\n    mut files.push((m, p, shown, text))\n  }\n  editor := editor_of(mut launcher, process)\n  mark := \"// ✗ \"\n  first := files.map(x -> x.3)\n  mut last := first\n  mut errors := []\n  // (the texts saved that were rejected: one saved again gives up)\n  mut tried := []\n  while true {\n    for x in files {\n      mut buffer := x.3\n      if len(errors) > 0 {\n        buffer = join(errors.map(e -> marked(mark, e)), \"\\n\")\n          + \"\\n\"\n          + mark\n          + \"not applied: fix it and save, or save it unchanged to give up\\n\\n\"\n          + x.3\n      }\n      mut disk.make_dir(codebase.parent(x.1)) !! ()\n      mut disk.write(x.1, buffer) !! ()\n    }\n    ran := mut launcher.run_with(\n      \"sh\",\n      [\"-c\", editor + \" \\\"$@\\\"\", \"strata-edit\"]\n        + files.map(x -> x.1),\n      \"\",\n      std.process.RunOptions { terminal: true },\n    )\n    ok := match ran {\n      Ok(r) => r.code == 0,\n      Err(_) => false,\n    }\n    if !ok {\n      mut disk.remove_all(dir) !! ()\n      code := fail_with(\n        mut console,\n        f\"the editor `{editor}` failed; nothing was changed\",\n      )\n      // (a text saved and rejected before is kept)\n      if len(tried) > 0 {\n        say_kept(\n          mut console,\n          keep_rejected(\n            mut disk,\n            o.root,\n            [(x.0, get(last, k) ?? \"\") for (k, x) in enumerate(files) where trim(get(last, k) ?? \"\") != trim(get(first, k) ?? \"\")],\n          ),\n        )\n      }\n      return code\n    }\n    mut now := []\n    for x in files {\n      raw := disk.read(x.1) !! \"\"\n      kept := lines(raw).filter(l -> !starts_with(l, mark))\n      body := join(kept, \"\\n\")\n      mut start := 0\n      while start < byte_len(body)\n        && byte_slice(body, start, start + 1) == \"\\n\" {\n        start += 1\n      }\n      mut now.push(byte_slice(body, start, byte_len(body)) + \"\\n\")\n    }\n    if [k for (k, t) in enumerate(now) where trim(t) != trim(get(last, k) ?? \"\")] == []\n      || tried.any(x -> same_texts(x, now)) {\n      mut disk.remove_all(dir) !! ()\n      untouched := [k for (k, t) in enumerate(now) where trim(t) != trim(get(first, k) ?? \"\")] == []\n      if !untouched {\n        for e in errors {\n          mut console.eprint(e)\n        }\n      }\n      mut console.print(\n        if untouched {\n          \"no changes\"\n        } else {\n          \"gave up: the text saved was rejected before; nothing was changed\"\n        },\n      )\n      if !untouched {\n        say_kept(\n          mut console,\n          keep_rejected(\n            mut disk,\n            o.root,\n            [(x.0, get(now, k) ?? \"\") for (k, x) in enumerate(files) where trim(get(now, k) ?? \"\") != trim(get(first, k) ?? \"\")],\n          ),\n        )\n      }\n      return if untouched {\n        0\n      } else {\n        1\n      }\n    }\n    last = now\n    mut tried.push(now)\n    errors = []\n    mut edits := []\n    for (k, x) in enumerate(files) {\n      match parse.parse_module(get(now, k) ?? \"\", x.0) {\n        Ok(ds) => {\n          edits += ds\n        },\n        Err(e) => mut errors.push(f\"parse error at {e}\"),\n      }\n    }\n    files = [(x.0, x.1, x.2, get(now, k) ?? x.3) for (k, x) in enumerate(files)]\n    if len(errors) == 0 {\n      // (what the text left out is removed; a derive kept is matched as\n      // written, `derive Json for Point`: `codebase.left_out`)\n      // (lemmas the view left out stay)\n      deletes := codebase.left_out(\n        o.decls,\n        flat_strings(files.map(x -> x.2)),\n        edits,\n      ).filter(\n        q -> a.proofs\n          || !o.decls.any(d -> store.qname(d) == q && views.is_lemma(d)),\n      )\n      match apply_edit(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        clock,\n        cache,\n        o,\n        edits,\n        deletes,\n        a.message,\n        a.commit,\n        \"edit\",\n        false,\n        [],\n        a.search,\n        a.proofs,\n      ) {\n        Ok(_) => {\n          mut disk.remove_all(dir) !! ()\n          return 0\n        },\n        Err(es) => {\n          errors = es\n        },\n      }\n    }\n  }\n  0\n}","old_text":"/// `strata edit [MODULE]` at a terminal (or `--editor`): opens the module\n/// (or the whole package, one file per module) in the editor as written,\n/// and applies what is saved. A definition deleted from the text is\n/// removed. An edit that doesn't go through is opened again with its errors\n/// on top. Saving it unchanged, or as an attempt already rejected, gives up\n/// with its errors and keeps the text (`keep_rejected`). The files opened\n/// are in `$TMPDIR`, outside the package, so a commit never takes them.\nfn edit_in_editor(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  o: Opened,\n  a: EditArgs,\n) -> std.process.ExitCode {\n  written := resolve.written(o.decls, o.std, o.core)\n  mut modules := []\n  for d in written {\n    if !contains(modules, d.module) {\n      mut modules.push(d.module)\n    }\n  }\n  modules = to_list(set(modules))\n  // a module (`shop`, its file `shop.strata`, `main`), else the\n  // definitions a selector picks, each module's in a file of its own\n  module_named := match a.module {\n    Some(arg) => ends_with(arg, \".strata\")\n      || arg == \"main\"\n      || contains(modules, package_module(o.name, edit_module(arg))),\n    None => true,\n  }\n  picked := match a.module {\n    Some(arg) => if module_named {\n      []\n    } else {\n      match views.select(written, store.graph(written, false), Some(arg)) {\n        Ok(ns) => ns,\n        Err(_) => [],\n      }\n    },\n    None => [],\n  }\n  if !module_named && picked == [] {\n    sel := a.module ?? \"\"\n    return fail_with(\n      mut console,\n      f\"`{sel}` is no module and picks no definition (a new module is opened by its file: `strata edit {sel}.strata`)\",\n    )\n  }\n  chosen := match a.module {\n    Some(arg) => if module_named {\n      [package_module(o.name, edit_module(arg))]\n    } else {\n      to_list(set(\n        [d.module for d in written where contains(picked, store.qname(d))],\n      ))\n    },\n    None => if len(modules) == 0 {\n      [\"\"]\n    } else {\n      modules\n    },\n  }\n  dir := edit_scratch(process, clock)\n  mut disk.remove_all(dir) !! ()\n  // (module, path, the definitions shown (stored names), text)\n  mut files := []\n  for m in chosen {\n    // (a declaration picked comes with the derives written on it, on its\n    // `derive A, B for` line: `codebase.with_attached`)\n    selected := [k for (k, d) in enumerate(written) where d.module == m\n      && (module_named || contains(picked, store.qname(d)))]\n    here := if module_named {\n      selected\n    } else {\n      codebase.with_attached(written, selected)\n    }\n    text := if len(here) == 0 {\n      \"\"\n    } else if module_named {\n      text.module_text(written.filter(d -> d.module == m))\n    } else {\n      text.module_text(\n        [d for (k, d) in enumerate(written) where contains(here, k)],\n      )\n    }\n    shown := here.map(\n      k -> store.qname(get(o.decls, k) or {\n        ast.Decl {\n          comments: [],\n          doc: [],\n          module: m,\n          public: false,\n          kind: ast.UseDef(\n            ast.UseDecl { path: \"\", alias: None, items: None },\n          ),\n        }\n      }),\n    )\n    p := dir\n      + \"/\"\n      + byte_slice(\n        codebase.module_path(m),\n        0,\n        byte_len(codebase.module_path(m)) - byte_len(\"strata\"),\n      )\n      + \"st\"\n    mut files.push((m, p, shown, text))\n  }\n  editor := editor_of(mut launcher, process)\n  mark := \"// ✗ \"\n  first := files.map(x -> x.3)\n  mut last := first\n  mut errors := []\n  // (the texts saved that were rejected: one saved again gives up)\n  mut tried := []\n  while true {\n    for x in files {\n      mut buffer := x.3\n      if len(errors) > 0 {\n        buffer = join(errors.map(e -> marked(mark, e)), \"\\n\")\n          + \"\\n\"\n          + mark\n          + \"not applied: fix it and save, or save it unchanged to give up\\n\\n\"\n          + x.3\n      }\n      mut disk.make_dir(codebase.parent(x.1)) !! ()\n      mut disk.write(x.1, buffer) !! ()\n    }\n    ran := mut launcher.run_with(\n      \"sh\",\n      [\"-c\", editor + \" \\\"$@\\\"\", \"strata-edit\"]\n        + files.map(x -> x.1),\n      \"\",\n      std.process.RunOptions { terminal: true },\n    )\n    ok := match ran {\n      Ok(r) => r.code == 0,\n      Err(_) => false,\n    }\n    if !ok {\n      mut disk.remove_all(dir) !! ()\n      code := fail_with(\n        mut console,\n        f\"the editor `{editor}` failed; nothing was changed\",\n      )\n      // (a text saved and rejected before is kept)\n      if len(tried) > 0 {\n        say_kept(\n          mut console,\n          keep_rejected(\n            mut disk,\n            o.root,\n            [(x.0, get(last, k) ?? \"\") for (k, x) in enumerate(files) where trim(get(last, k) ?? \"\") != trim(get(first, k) ?? \"\")],\n          ),\n        )\n      }\n      return code\n    }\n    mut now := []\n    for x in files {\n      raw := disk.read(x.1) !! \"\"\n      kept := lines(raw).filter(l -> !starts_with(l, mark))\n      body := join(kept, \"\\n\")\n      mut start := 0\n      while start < byte_len(body)\n        && byte_slice(body, start, start + 1) == \"\\n\" {\n        start += 1\n      }\n      mut now.push(byte_slice(body, start, byte_len(body)) + \"\\n\")\n    }\n    if [k for (k, t) in enumerate(now) where trim(t) != trim(get(last, k) ?? \"\")] == []\n      || tried.any(x -> same_texts(x, now)) {\n      mut disk.remove_all(dir) !! ()\n      untouched := [k for (k, t) in enumerate(now) where trim(t) != trim(get(first, k) ?? \"\")] == []\n      if !untouched {\n        for e in errors {\n          mut console.eprint(e)\n        }\n      }\n      mut console.print(\n        if untouched {\n          \"no changes\"\n        } else {\n          \"gave up: the text saved was rejected before; nothing was changed\"\n        },\n      )\n      if !untouched {\n        say_kept(\n          mut console,\n          keep_rejected(\n            mut disk,\n            o.root,\n            [(x.0, get(now, k) ?? \"\") for (k, x) in enumerate(files) where trim(get(now, k) ?? \"\") != trim(get(first, k) ?? \"\")],\n          ),\n        )\n      }\n      return if untouched {\n        0\n      } else {\n        1\n      }\n    }\n    last = now\n    mut tried.push(now)\n    errors = []\n    mut edits := []\n    for (k, x) in enumerate(files) {\n      match parse.parse_module(get(now, k) ?? \"\", x.0) {\n        Ok(ds) => {\n          edits += ds\n        },\n        Err(e) => mut errors.push(f\"parse error at {e}\"),\n      }\n    }\n    files = [(x.0, x.1, x.2, get(now, k) ?? x.3) for (k, x) in enumerate(files)]\n    if len(errors) == 0 {\n      // (what the text left out is removed; a derive kept is matched as\n      // written, `derive Json for Point`: `codebase.left_out`)\n      deletes := codebase.left_out(\n        o.decls,\n        flat_strings(files.map(x -> x.2)),\n        edits,\n      )\n      match apply_edit(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        clock,\n        cache,\n        o,\n        edits,\n        deletes,\n        a.message,\n        a.commit,\n        \"edit\",\n        false,\n        [],\n        a.search,\n      ) {\n        Ok(_) => {\n          mut disk.remove_all(dir) !! ()\n          return 0\n        },\n        Err(es) => {\n          errors = es\n        },\n      }\n    }\n  }\n  0\n}"},{"name":"view_command","kind":"fn","old":"036887932c7104b6","new":"289a2c4cee815fa4","interface_changed":false,"affected":[],"module":"","text":"/// `strata view [SELECTOR] [--level 0|1|2] [--mocks] [--split DIR]\n/// [--members inline|separate]`.\n/// - A module (`view shop`, `view main` for the root module) is shown as\n/// its file is stored, as the text `edit` reads back, imports first.\n/// - Other selectors show the definitions picked at a level of detail: 0 a\n/// map with one line each, 1 interfaces, 2 source. Default 1, or 0 with no\n/// selector (the package's map).\n/// - `--split DIR` writes every module as text (`shop/orders.st`).\n/// - `strata view LOCATION` is compiler/finding's `view_location`.\n/// - A name the program doesn't define is looked up in core and std (`view\n/// Dict`, `view insert`, `view std.json.parse`: `views.select_library`),\n/// also outside a package.\n/// Code is highlighted on a terminal.\nfn view_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  args: List[String],\n) -> std.process.ExitCode {\n  // a location (`DEF@HASH/PATH`, with `--context N`, `--def`):\n  // compiler/finding's\n  if args.any(a -> finding.is_location(a)) {\n    return finding.view_location(mut console, disk, process, args)\n  }\n  va := match view_args(args) {\n    Ok(v) => v,\n    Err(e) => return fail_with(mut console, e),\n  }\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  core := read_core_at(disk, home)\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  stored := match viewed_program(disk, process, va.file) {\n    Ok(ds) => ds,\n    // (no package: a selector can still name core's and std's definitions)\n    Err(e) => if va.file is None && va.selector is Some {\n      []\n    } else {\n      return fail_with(mut console, e)\n    },\n  }\n  // (proof material hidden unless `--proofs`; `--split` writes everything,\n  // for reading back)\n  as_written := if va.proofs || va.split is Some {\n    resolve.written(stored, std, core)\n  } else {\n    resolve.written(stored, std, core).map(\n      d -> views.proofs_hidden(d),\n    )\n  }\n  // a union's members inline (by default: a type with a doc, an `impl` or\n  // a `derive` of its own stays on its own) or each on its own. Both read\n  // back the same.\n  as_files := if va.members == \"separate\" {\n    views.separate_members(as_written)\n  } else {\n    resolve.inline_members(as_written)\n  }\n  mut modules := []\n  for d in as_written {\n    if !contains(modules, d.module) {\n      mut modules.push(d.module)\n    }\n  }\n  modules = to_list(set(modules))\n  match va.split {\n    Some(dir) => {\n      for m in modules {\n        rel := codebase.module_path(m)\n        p := dir\n          + \"/\"\n          + byte_slice(rel, 0, byte_len(rel) - byte_len(\"strata\"))\n          + \"st\"\n        mut disk.make_dir(codebase.parent(p)) !! ()\n        match mut disk.write(\n          p,\n          text.module_text(\n            imports_first(as_files.filter(d -> d.module == m)),\n          ),\n        ) {\n          Err(e) => return fail_with(mut console, f\"{e}\"),\n          Ok(_) => (),\n        }\n      }\n      return 0\n    },\n    None => (),\n  }\n  paint := console.paint(std.term.Output)\n  caps := capability_names(stored + std)\n  match viewed_module(va, modules) {\n    Some(m) => {\n      // (a module's lemmas only with `--proofs`)\n      text := text.module_text(imports_first(as_files.filter(\n        d -> d.module == m && (va.proofs || !views.is_lemma(d)),\n      )))\n      mut console.write(\n        if text == \"\" {\n          \"\\n\"\n        } else {\n          highlight.code(paint, text, caps)\n        },\n      )\n      return 0\n    },\n    None => (),\n  }\n  g := store.graph(stored, false)\n  // each part of the selector the program doesn't name: core's or std's\n  (own_sel, lib_sel) := match va.selector {\n    Some(sel) => {\n      parts := split(sel, \",\").map(t -> trim(t))\n      mine := parts.filter(t -> views.select(stored, g, Some(t)) is Ok)\n      theirs := parts.filter(t -> !contains(mine, t))\n      (if mine == [] {\n        None\n      } else {\n        Some(join(mine, \",\"))\n      }, theirs)\n    },\n    None => (None, []),\n  }\n  names := if va.selector is Some && own_sel is None {\n    []\n  } else {\n    match views.select(stored, g, own_sel) {\n      Ok(ns) => ns,\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  // mocks are for tests, lemmas for proofs: shown when asked for, or\n  // picked by name\n  shown := if va.selector is Some {\n    names\n  } else {\n    names.filter(\n      q -> !stored.any(\n        d -> store.qname(d) == q\n          && match d.kind {\n            ast.TypeDef(t) => t.mocked && !va.mocks,\n            ast.FnDef(f) => f.lemma && !va.proofs,\n            _ => false,\n          },\n      ),\n    )\n  }\n  level := va.level or {\n    if va.selector is None {\n      0\n    } else {\n      1\n    }\n  }\n  mut text := if names == [] {\n    \"\"\n  } else {\n    views.view(stored, as_written, shown, level)\n  }\n  if lib_sel != [] {\n    // core's definitions (its runtime's left out) and std's\n    lib := core.decls.filter(\n        d ->\n          !builtins.runtime_module(d.module)\n            && d.module != \"core.mem\",\n      )\n      + std\n    lib_names := match views.select_library(lib, join(lib_sel, \",\")) {\n      Ok(ns) => ns,\n      Err(e) => return fail_with(mut console, e),\n    }\n    text += views.view(\n      lib,\n      resolve.written(lib, std, core),\n      lib_names,\n      level,\n    )\n  }\n  mut console.write(highlight.code(paint, text, caps))\n  0\n}","old_text":"/// `strata view [SELECTOR] [--level 0|1|2] [--mocks] [--split DIR]\n/// [--members inline|separate]`.\n/// - A module (`view shop`, `view main` for the root module) is shown as\n/// its file is stored, as the text `edit` reads back, imports first.\n/// - Other selectors show the definitions picked at a level of detail: 0 a\n/// map with one line each, 1 interfaces, 2 source. Default 1, or 0 with no\n/// selector (the package's map).\n/// - `--split DIR` writes every module as text (`shop/orders.st`).\n/// - `strata view LOCATION` is compiler/finding's `view_location`.\n/// - A name the program doesn't define is looked up in core and std (`view\n/// Dict`, `view insert`, `view std.json.parse`: `views.select_library`),\n/// also outside a package.\n/// Code is highlighted on a terminal.\nfn view_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  args: List[String],\n) -> std.process.ExitCode {\n  // a location (`DEF@HASH/PATH`, with `--context N`, `--def`):\n  // compiler/finding's\n  if args.any(a -> finding.is_location(a)) {\n    return finding.view_location(mut console, disk, process, args)\n  }\n  va := match view_args(args) {\n    Ok(v) => v,\n    Err(e) => return fail_with(mut console, e),\n  }\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  core := read_core_at(disk, home)\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  stored := match viewed_program(disk, process, va.file) {\n    Ok(ds) => ds,\n    // (no package: a selector can still name core's and std's definitions)\n    Err(e) => if va.file is None && va.selector is Some {\n      []\n    } else {\n      return fail_with(mut console, e)\n    },\n  }\n  as_written := resolve.written(stored, std, core)\n  // a union's members inline (by default: a type with a doc, an `impl` or\n  // a `derive` of its own stays on its own) or each on its own. Both read\n  // back the same.\n  as_files := if va.members == \"separate\" {\n    views.separate_members(as_written)\n  } else {\n    resolve.inline_members(as_written)\n  }\n  mut modules := []\n  for d in as_written {\n    if !contains(modules, d.module) {\n      mut modules.push(d.module)\n    }\n  }\n  modules = to_list(set(modules))\n  match va.split {\n    Some(dir) => {\n      for m in modules {\n        rel := codebase.module_path(m)\n        p := dir\n          + \"/\"\n          + byte_slice(rel, 0, byte_len(rel) - byte_len(\"strata\"))\n          + \"st\"\n        mut disk.make_dir(codebase.parent(p)) !! ()\n        match mut disk.write(\n          p,\n          text.module_text(\n            imports_first(as_files.filter(d -> d.module == m)),\n          ),\n        ) {\n          Err(e) => return fail_with(mut console, f\"{e}\"),\n          Ok(_) => (),\n        }\n      }\n      return 0\n    },\n    None => (),\n  }\n  paint := console.paint(std.term.Output)\n  caps := capability_names(stored + std)\n  match viewed_module(va, modules) {\n    Some(m) => {\n      text := text.module_text(\n        imports_first(as_files.filter(d -> d.module == m)),\n      )\n      mut console.write(\n        if text == \"\" {\n          \"\\n\"\n        } else {\n          highlight.code(paint, text, caps)\n        },\n      )\n      return 0\n    },\n    None => (),\n  }\n  g := store.graph(stored, false)\n  // each part of the selector the program doesn't name: core's or std's\n  (own_sel, lib_sel) := match va.selector {\n    Some(sel) => {\n      parts := split(sel, \",\").map(t -> trim(t))\n      mine := parts.filter(t -> views.select(stored, g, Some(t)) is Ok)\n      theirs := parts.filter(t -> !contains(mine, t))\n      (if mine == [] {\n        None\n      } else {\n        Some(join(mine, \",\"))\n      }, theirs)\n    },\n    None => (None, []),\n  }\n  names := if va.selector is Some && own_sel is None {\n    []\n  } else {\n    match views.select(stored, g, own_sel) {\n      Ok(ns) => ns,\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  // mocks are for tests: shown when asked for, or picked by name\n  shown := if va.mocks || va.selector is Some {\n    names\n  } else {\n    names.filter(\n      q -> !stored.any(\n        d -> store.qname(d) == q\n          && match d.kind {\n            ast.TypeDef(t) => t.mocked,\n            _ => false,\n          },\n      ),\n    )\n  }\n  level := va.level or {\n    if va.selector is None {\n      0\n    } else {\n      1\n    }\n  }\n  mut text := if names == [] {\n    \"\"\n  } else {\n    views.view(stored, as_written, shown, level)\n  }\n  if lib_sel != [] {\n    // core's definitions (its runtime's left out) and std's\n    lib := core.decls.filter(\n        d ->\n          !builtins.runtime_module(d.module)\n            && d.module != \"core.mem\",\n      )\n      + std\n    lib_names := match views.select_library(lib, join(lib_sel, \",\")) {\n      Ok(ns) => ns,\n      Err(e) => return fail_with(mut console, e),\n    }\n    text += views.view(\n      lib,\n      resolve.written(lib, std, core),\n      lib_names,\n      level,\n    )\n  }\n  mut console.write(highlight.code(paint, text, caps))\n  0\n}"},{"name":"ViewArgs","kind":"type","old":"4a30c172bd23074e","new":"37944c1f8faebece","interface_changed":true,"affected":["view_args","viewed_module","view_command","command_line","main","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","diff_command","with_base","rename_command","move_command","fix_command","edit_in_editor"],"module":"","text":"/// The selector (`None`: the whole package) and the options.\ntype ViewArgs = {\n  file: Option[String],\n  level: Option[Int],\n  split: Option[String],\n  mocks: Bool,\n  members: String,\n  selector: Option[String],\n  // `--proofs`: proof material shown (`views.proofs_hidden` otherwise)\n  proofs: Bool = false,\n}","old_text":"/// The selector (`None`: the whole package) and the options.\ntype ViewArgs = {\n  file: Option[String],\n  level: Option[Int],\n  split: Option[String],\n  mocks: Bool,\n  members: String,\n  selector: Option[String],\n}"},{"name":"view_args","kind":"fn","old":"9504983e0f7c1dc6","new":"dc016de223f8e939","interface_changed":false,"affected":[],"module":"","text":"/// `args` is every word but the command. The selector is the one word that\n/// isn't an option: a module (`shop`, `main`, `shop/orders.strata`), or\n/// what `views.select` takes.\nfn view_args(args: List[String]) -> Result[ViewArgs, String] {\n  mut va := ViewArgs {\n    file: None,\n    level: None,\n    split: None,\n    mocks: false,\n    members: \"inline\",\n    selector: None,\n  }\n  mut i := 0\n  while i < len(args) {\n    a := get(args, i) ?? \"\"\n    i += 1\n    if a == \"--file\"\n      || a == \"--level\"\n      || a == \"--split\"\n      || a == \"--members\" {\n      v := get(args, i)\n      i += 1\n      if a == \"--members\" {\n        m := v ?? \"\"\n        if m != \"inline\" && m != \"separate\" {\n          return Err(f\"`--members {m}`: `separate` or `inline`\")\n        }\n        va.members = m\n      } else if a == \"--file\" {\n        va.file = v\n      } else if a == \"--split\" {\n        va.split = v\n      } else {\n        va.level = match v {\n          Some(\"0\") => Some(0),\n          Some(\"1\") => Some(1),\n          Some(\"2\") => Some(2),\n          _ => return Err(\n            \"--level must be 0 (map), 1 (interfaces) or 2 (source)\",\n          ),\n        }\n      }\n    } else if a == \"--mocks\" {\n      va.mocks = true\n    } else if a == \"--proofs\" {\n      va.proofs = true\n    } else if starts_with(a, \"-\") {\n      return Err(f\"unknown option `{a}`\")\n    } else if va.selector is Some {\n      return Err(f\"`{a}`: one selector (several: `a,b`)\")\n    } else {\n      va.selector = Some(a)\n    }\n  }\n  Ok(va)\n}","old_text":"/// `args` is every word but the command. The selector is the one word that\n/// isn't an option: a module (`shop`, `main`, `shop/orders.strata`), or\n/// what `views.select` takes.\nfn view_args(args: List[String]) -> Result[ViewArgs, String] {\n  mut va := ViewArgs {\n    file: None,\n    level: None,\n    split: None,\n    mocks: false,\n    members: \"inline\",\n    selector: None,\n  }\n  mut i := 0\n  while i < len(args) {\n    a := get(args, i) ?? \"\"\n    i += 1\n    if a == \"--file\"\n      || a == \"--level\"\n      || a == \"--split\"\n      || a == \"--members\" {\n      v := get(args, i)\n      i += 1\n      if a == \"--members\" {\n        m := v ?? \"\"\n        if m != \"inline\" && m != \"separate\" {\n          return Err(f\"`--members {m}`: `separate` or `inline`\")\n        }\n        va.members = m\n      } else if a == \"--file\" {\n        va.file = v\n      } else if a == \"--split\" {\n        va.split = v\n      } else {\n        va.level = match v {\n          Some(\"0\") => Some(0),\n          Some(\"1\") => Some(1),\n          Some(\"2\") => Some(2),\n          _ => return Err(\n            \"--level must be 0 (map), 1 (interfaces) or 2 (source)\",\n          ),\n        }\n      }\n    } else if a == \"--mocks\" {\n      va.mocks = true\n    } else if starts_with(a, \"-\") {\n      return Err(f\"unknown option `{a}`\")\n    } else if va.selector is Some {\n      return Err(f\"`{a}`: one selector (several: `a,b`)\")\n    } else {\n      va.selector = Some(a)\n    }\n  }\n  Ok(va)\n}"}]}
{"id":"31f24eea087f0d45","time":1795665757,"message":"edit","changes":[{"name":"views.proofs_in","kind":"fn","old":"a7779e1bcc085872","new":"f16fe69337aa0ed0","interface_changed":false,"affected":[],"module":"views","text":"/// The proof statements of `e` (`assert … by`, `calc`) not first in a\n/// block's clauses, each with the code statement before it (`\"\"`: first)\n/// and the one after it (the block's result, `\"= \"` and its text, when\n/// last), as `code_text` shows them.\nfn proofs_in(e: ast.Expr) -> List[(String, String, ast.Stmt)] {\n  mut out := []\n  match e {\n    ast.Block { stmts, last } => {\n      mut before := \"\"\n      for (k, s) in enumerate(stmts) {\n        if s is ast.AssertBy || s is ast.Calc {\n          after := match drop(stmts, k + 1).filter(\n            x -> !views.hidden_stmt(x) && !views.marker(x),\n          ) {\n            [n, ..] => views.anchor(n),\n            [] => views.end_anchor(last),\n          }\n          mut out.push((before, after, s))\n        } else if !views.hidden_stmt(s) && !views.marker(s) {\n          before = views.anchor(s)\n        }\n        for x in walk.stmt_kids(s) {\n          out += views.proofs_in(x)\n        }\n      }\n      out += views.proofs_in(last)\n    },\n    _ => {\n      for k in walk.kids(e) {\n        out += views.proofs_in(k)\n      }\n    },\n  }\n  out\n}","old_text":"/// The proof statements of `e` (`assert … by`, `calc`) not first in a\n/// block's clauses, each with the code statement before it (`\"\"`: first)\n/// and the one after it (the block's result, `\"= \"` and its text, when\n/// last), as `code_text` shows them.\nfn proofs_in(e: ast.Expr) -> List[(String, String, ast.Stmt)] {\n  mut out := []\n  match e {\n    ast.Block { stmts, last } => {\n      mut before := \"\"\n      for (k, s) in enumerate(stmts) {\n        if s is ast.AssertBy || s is ast.Calc {\n          after := match drop(stmts, k + 1).filter(\n            x -> !views.hidden_stmt(x) && !views.marker(x),\n          ) {\n            [n, ..] => views.code_text(n),\n            [] => \"= \" + text.expr_text(views.bare_code(last), 0),\n          }\n          mut out.push((before, after, s))\n        } else if !views.hidden_stmt(s) && !views.marker(s) {\n          before = views.code_text(s)\n        }\n        for x in walk.stmt_kids(s) {\n          out += views.proofs_in(x)\n        }\n      }\n      out += views.proofs_in(last)\n    },\n    _ => {\n      for k in walk.kids(e) {\n        out += views.proofs_in(k)\n      }\n    },\n  }\n  out\n}"},{"name":"views.body_kept","kind":"fn","old":"cb9df8e43129526f","new":"1ff83a29a12ee376","interface_changed":false,"affected":[],"module":"views","text":"/// What `body` (read back from a view) left out of the stored `stored`,\n/// put back, with a note for each part it couldn't place:\n/// - the function's `decreases`, when `body` has none;\n/// - a loop's clauses, when `body`'s loop of the same head (the k-th loop\n/// with that head, as stored) has none. A loop whose head changed or that\n/// is gone loses them (a note says so);\n/// - an `assert … by` or `calc` not in `body`, after the statement it\n/// followed (or before the one it preceded), when that statement is in\n/// `body` exactly once.\nfn body_kept(\n  stored: ast.Expr,\n  given: ast.Expr,\n  name: String,\n) -> (ast.Expr, List[String]) {\n  mut notes := []\n  body0 := views.markers_dropped(given)\n  // the function's `decreases`\n  old_decs := text.loop_clauses(stored).filter(s -> s is ast.Decreases)\n  body1 := if old_decs != []\n    && text.loop_clauses(body0).filter(s -> s is ast.Decreases) == [] {\n    match body0 {\n      ast.Block { stmts, last } => ast.Block { stmts: old_decs + stmts, last },\n      other => ast.Block { stmts: old_decs, last: other },\n    }\n  } else {\n    body0\n  }\n  // loops, by head and rank among loops of that head\n  old_loops := views.loops_in(stored)\n  new_loops := views.loops_in(body1)\n  mut plan: List[(String, List[ast.Stmt])] = []\n  mut used := Set[Int] {}\n  for (i, (h, s)) in enumerate(new_loops) {\n    rank := len(new_loops[..i].filter(x -> x.0 == h))\n    mut seen := 0\n    for (j, (oh, os)) in enumerate(old_loops) {\n      if oh == h {\n        if seen == rank {\n          mut used.insert(j)\n          clauses := text.loop_clauses(views.loop_body_of(os))\n          if clauses != []\n            && text.loop_clauses(views.loop_body_of(s)) == [] {\n            mut plan.push((h + \"\\n\" + views.code_text(s), clauses))\n          }\n          break\n        }\n        seen += 1\n      }\n    }\n  }\n  for (j, (oh, os)) in enumerate(old_loops) {\n    n := len(text.loop_clauses(views.loop_body_of(os)))\n    if n > 0 && !contains(used, j) {\n      what := views.counted(n, \"clause\")\n      mut notes.push(\n        f\"in `{name}`: the {what} of `{oh}` (hidden in the view) were dropped: that loop changed or is gone; write them again (`strata view {name} --proofs` shows them), or let the search find invariants\",\n      )\n    }\n  }\n  body2 := if plan == [] {\n    body1\n  } else {\n    walk.rewrite_expr(body1, x -> match x {\n      ast.Block { stmts, last } => if stmts.any(s -> views.loop_head(s) != \"\") {\n        ast.Block { stmts: stmts.map(\n          s -> if views.loop_head(s) == \"\"\n            || text.loop_clauses(views.loop_body_of(s)) != [] {\n            s\n          } else {\n            match plan.filter(\n              p ->\n                p.0 == views.loop_head(s) + \"\\n\" + views.code_text(s),\n            ) {\n              [(_, cs), ..] => views.with_clauses(s, cs),\n              [] => s,\n            }\n          },\n        ), last }\n      } else {\n        x\n      },\n      _ => x,\n    })\n  }\n  // proof statements, by the code around them\n  old_proofs := views.proofs_in(stored)\n  given_proofs := views.proofs_in(body2).map(p -> views.code_text(p.2))\n  mut all_code := []\n  for s in views.stmts_in(body2) {\n    if !views.hidden_stmt(s) && !views.marker(s) {\n      mut all_code.push(views.anchor(s))\n    }\n  }\n  ends := views.block_ends(body2)\n  once := (a: String) -> a != \"\" && len(all_code.filter(c -> c == a)) == 1\n  // (1: after the statement `key`, 2: before it, 3: last in the block\n  // ending with `key`)\n  mut put := []\n  for (before, after, s) in old_proofs {\n    if contains(given_proofs, views.code_text(s)) {\n      continue\n    }\n    if once(before) {\n      mut put.push((1, before, s))\n    } else if once(after) {\n      mut put.push((2, after, s))\n    } else if starts_with(after, \"= \")\n      && len(ends.filter(c -> c == after)) == 1 {\n      mut put.push((3, after, s))\n    } else {\n      shown := match s {\n        ast.AssertBy { cond, .. } => \"assert \" + text.expr_text(cond, 0) + \" by …\",\n        _ => \"calc { … }\",\n      }\n      mut notes.push(\n        f\"in `{name}`: the proof `{shown}` (hidden in the view) was dropped: the code around it changed; write it again (`strata view {name} --proofs` shows it)\",\n      )\n    }\n  }\n  body3 := if put == [] {\n    body2\n  } else {\n    walk.rewrite_expr(body2, x -> match x {\n      ast.Block { stmts, last } => {\n        mut out := []\n        for s in stmts {\n          t := if views.hidden_stmt(s) || views.marker(s) {\n            \"\"\n          } else {\n            views.anchor(s)\n          }\n          for (mode, key, p) in put {\n            if mode == 2 && key == t && t != \"\" {\n              mut out.push(p)\n            }\n          }\n          mut out.push(s)\n          for (mode, key, p) in put {\n            if mode == 1 && key == t && t != \"\" {\n              mut out.push(p)\n            }\n          }\n        }\n        e := views.end_anchor(last)\n        for (mode, key, p) in put {\n          if mode == 3 && key == e {\n            mut out.push(p)\n          }\n        }\n        if len(out) == len(stmts) {\n          x\n        } else {\n          ast.Block { stmts: out, last }\n        }\n      },\n      _ => x,\n    })\n  }\n  (body3, notes)\n}","old_text":"/// What `body` (read back from a view) left out of the stored `stored`,\n/// put back, with a note for each part it couldn't place:\n/// - the function's `decreases`, when `body` has none;\n/// - a loop's clauses, when `body`'s loop of the same head (the k-th loop\n/// with that head, as stored) has none. A loop whose head changed or that\n/// is gone loses them (a note says so);\n/// - an `assert … by` or `calc` not in `body`, after the statement it\n/// followed (or before the one it preceded), when that statement is in\n/// `body` exactly once.\nfn body_kept(\n  stored: ast.Expr,\n  given: ast.Expr,\n  name: String,\n) -> (ast.Expr, List[String]) {\n  mut notes := []\n  body0 := views.markers_dropped(given)\n  // the function's `decreases`\n  old_decs := text.loop_clauses(stored).filter(s -> s is ast.Decreases)\n  body1 := if old_decs != []\n    && text.loop_clauses(body0).filter(s -> s is ast.Decreases) == [] {\n    match body0 {\n      ast.Block { stmts, last } => ast.Block { stmts: old_decs + stmts, last },\n      other => ast.Block { stmts: old_decs, last: other },\n    }\n  } else {\n    body0\n  }\n  // loops, by head and rank among loops of that head\n  old_loops := views.loops_in(stored)\n  new_loops := views.loops_in(body1)\n  mut plan: List[(String, List[ast.Stmt])] = []\n  mut used := Set[Int] {}\n  for (i, (h, s)) in enumerate(new_loops) {\n    rank := len(new_loops[..i].filter(x -> x.0 == h))\n    mut seen := 0\n    for (j, (oh, os)) in enumerate(old_loops) {\n      if oh == h {\n        if seen == rank {\n          mut used.insert(j)\n          clauses := text.loop_clauses(views.loop_body_of(os))\n          if clauses != []\n            && text.loop_clauses(views.loop_body_of(s)) == [] {\n            mut plan.push((h + \"\\n\" + views.code_text(s), clauses))\n          }\n          break\n        }\n        seen += 1\n      }\n    }\n  }\n  for (j, (oh, os)) in enumerate(old_loops) {\n    n := len(text.loop_clauses(views.loop_body_of(os)))\n    if n > 0 && !contains(used, j) {\n      what := views.counted(n, \"clause\")\n      mut notes.push(\n        f\"in `{name}`: the {what} of `{oh}` (hidden in the view) were dropped: that loop changed or is gone; write them again (`strata view {name} --proofs` shows them), or let the search find invariants\",\n      )\n    }\n  }\n  body2 := if plan == [] {\n    body1\n  } else {\n    walk.rewrite_expr(body1, x -> match x {\n      ast.Block { stmts, last } => if stmts.any(s -> views.loop_head(s) != \"\") {\n        ast.Block { stmts: stmts.map(\n          s -> if views.loop_head(s) == \"\"\n            || text.loop_clauses(views.loop_body_of(s)) != [] {\n            s\n          } else {\n            match plan.filter(\n              p ->\n                p.0 == views.loop_head(s) + \"\\n\" + views.code_text(s),\n            ) {\n              [(_, cs), ..] => views.with_clauses(s, cs),\n              [] => s,\n            }\n          },\n        ), last }\n      } else {\n        x\n      },\n      _ => x,\n    })\n  }\n  // proof statements, by the code around them\n  old_proofs := views.proofs_in(stored)\n  given_proofs := views.proofs_in(body2).map(p -> views.code_text(p.2))\n  mut all_code := []\n  for s in views.stmts_in(body2) {\n    if !views.hidden_stmt(s) && !views.marker(s) {\n      mut all_code.push(views.code_text(s))\n    }\n  }\n  mut put := []\n  for (before, after, s) in old_proofs {\n    if contains(given_proofs, views.code_text(s)) {\n      continue\n    }\n    anchor := if before != \"\" {\n      before\n    } else {\n      after\n    }\n    if len(all_code.filter(c -> c == anchor)) == 1 {\n      mut put.push((before, after, s))\n    } else {\n      shown := match s {\n        ast.AssertBy { cond, .. } => \"assert \" + text.expr_text(cond, 0) + \" by …\",\n        _ => \"calc { … }\",\n      }\n      mut notes.push(\n        f\"in `{name}`: the proof `{shown}` (hidden in the view) was dropped: the code around it changed; write it again (`strata view {name} --proofs` shows it)\",\n      )\n    }\n  }\n  body3 := if put == [] {\n    body2\n  } else {\n    walk.rewrite_expr(body2, x -> match x {\n      ast.Block { stmts, last } => {\n        mut out := []\n        for s in stmts {\n          t := if views.hidden_stmt(s) {\n            \"\"\n          } else {\n            views.code_text(s)\n          }\n          for (before, after, p) in put {\n            if before == \"\" && after == t && t != \"\" {\n              mut out.push(p)\n            }\n          }\n          mut out.push(s)\n          for (before, _, p) in put {\n            if before != \"\" && before == t {\n              mut out.push(p)\n            }\n          }\n        }\n        if len(out) == len(stmts) {\n          x\n        } else {\n          ast.Block { stmts: out, last }\n        }\n      },\n      _ => x,\n    })\n  }\n  (body3, notes)\n}"},{"name":"views.anchor","kind":"fn","old":null,"new":"1a7421111b7c78b0","interface_changed":true,"affected":[],"module":"views","text":"/// What places a proof statement next to `s`: its first line, without\n/// proof material (a loop's head line: `while i < n {`).\nfn anchor(s: ast.Stmt) -> String {\n  get(split(views.code_text(s), \"\\n\"), 0) ?? \"\"\n}"},{"name":"views.end_anchor","kind":"fn","old":null,"new":"7f679dfae35b8bc6","interface_changed":true,"affected":[],"module":"views","text":"/// The same of a block's result: `= ` and its first line.\nfn end_anchor(last: ast.Expr) -> String {\n  \"= \"\n    + (get(split(text.expr_text(views.bare_code(last), 0), \"\\n\"), 0) ?? \"\")\n}"},{"name":"views.block_ends","kind":"fn","old":null,"new":"383fd5a2b3d07a63","interface_changed":true,"affected":[],"module":"views","text":"/// `end_anchor` of each block of `e`, at any depth.\nfn block_ends(e: ast.Expr) -> List[String] {\n  mut out := []\n  match e {\n    ast.Block { last, .. } => mut out.push(views.end_anchor(last)),\n    _ => (),\n  }\n  for k in walk.kids(e) {\n    out += views.block_ends(k)\n  }\n  out\n}"}]}
{"id":"9848ae9a24f96592","time":1795665767,"message":"edit","changes":[{"name":"edit_command","kind":"fn","old":"a756240b354f214b","new":"928ebf850c3672c0","interface_changed":false,"affected":[],"module":"","text":"/// `strata edit [MODULE] [-m MSG] [--rm NAME].. [--no-commit] [--no-search]`\n/// and `strata\n/// add FILE [MODULE]`: definitions from standard input (or the file, or the\n/// editor) replace or join the package's of the same names in MODULE\n/// (default the root module). Recorded only if the whole package checks.\nfn edit_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  args: List[String],\n  cmd: String,\n) -> std.process.ExitCode {\n  if contains(args, \"--help\") || contains(args, \"-h\") {\n    mut console.write(command_usage(cmd))\n    return 0\n  }\n  // `--file F`: a script or a folder, outside any log. std's folder is\n  // edited as a package is, checked and atomic (it is built into strata).\n  mut line := args\n  mut opened: Option[Result[Opened, String]] = None\n  match [k for (k, x) in enumerate(args) where x == \"--file\"] {\n    [k, ..] => {\n      f := get(args, k + 1) ?? \"\"\n      rest := [x for (i, x) in enumerate(args) where i != k && i != k + 1]\n      if disk.is_dir(f) && package_name(disk, f) == \"std\" {\n        opened = Some(open_package_at(disk, process, f, cmd))\n        line = rest\n      } else {\n        return edit_file(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          f,\n          rest,\n          cmd,\n        )\n      }\n    },\n    [] => (),\n  }\n  timings.begin(\"edit: open\")\n  o := match opened ?? open_package(disk, process, cmd) {\n    Ok(o) => o,\n    Err(_) => return fail_with(\n      mut console,\n      \"no package here (no strata.toml in this folder or above: run `strata init`, or pass --file)\",\n    ),\n  }\n  timings.end(\"edit: open\")\n  // (`--file std`: outside any log, as `--file` is: written and checked,\n  // never committed to git)\n  given_args := match edit_args(line) {\n    Ok(g) => EditArgs { ..g, commit: g.commit && opened is None },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // (`--rm NAME`: a qualified name, or a short one naming one definition,\n  // in MODULE first)\n  a := match removed_names(o.decls, if cmd == \"add\" {\n    \"\"\n  } else {\n    package_module(o.name, edit_module(given_args.module ?? \"\"))\n  }, given_args.removes) {\n    Ok(rs) => EditArgs { ..given_args, removes: rs },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // `add FILE [MODULE]`: the file's text, into MODULE. For a module file or\n  // a folder of them: its definitions, in their modules.\n  if cmd == \"add\" {\n    f := a.module ?? \"\"\n    stored_defs := if disk.is_dir(f) {\n      Some(package_decls(disk, f, \"\"))\n    } else {\n      match disk.read_bytes(f) {\n        Ok(bytes) => match binary.read(bytes) {\n          Ok(img) => Some(img.decls),\n          Err(_) => None,\n        },\n        Err(e) => return fail_with(mut console, f\"{f}: {e}\"),\n      }\n    }\n    match stored_defs {\n      Some(ds) => {\n        message := if a.message == \"edit\" {\n          \"import\"\n        } else {\n          a.message\n        }\n        return match apply_edit(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          clock,\n          cache,\n          o,\n          ds,\n          a.removes,\n          message,\n          a.commit,\n          cmd,\n          contains(line, \"--json\"),\n          [],\n          a.search,\n          true,\n        ) {\n          Ok(_) => 0,\n          Err(_) => 1,\n        }\n      },\n      None => (),\n    }\n  }\n  (text, module_arg, message) := if cmd == \"add\" {\n    f := a.module ?? \"\"\n    t := match disk.read(f) {\n      Ok(t) => t,\n      Err(e) => return fail_with(mut console, f\"{f}: {e}\"),\n    }\n    (t, a.extra ?? \"\", if a.message == \"edit\" {\n      \"import\"\n    } else {\n      a.message\n    })\n  } else if contains(line, \"--editor\")\n    || console.interactive()\n      && driver_terminal(1).to_int() == 1\n      && len(a.removes) == 0 {\n    // (an editor only for someone at the terminal: standard input and output\n    // both on it, and nothing to remove)\n    return edit_in_editor(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      clock,\n      cache,\n      o,\n      a,\n    )\n  } else {\n    match piped_input(\n      mut console,\n      len(a.removes) > 0,\n      \"strata edit [MODULE]\",\n    ) {\n      Ok(t) => (t, a.module ?? \"\", a.message),\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  // (std's modules as stored: `io` is `std.io`)\n  timings.begin(\"edit: parse\")\n  edits := match parse.parse_module(\n    text,\n    package_module(o.name, edit_module(module_arg)),\n  ) {\n    Ok(ds) => ds,\n    Err(e) => {\n      code := fail_with(mut console, f\"parse error at {e}\")\n      if cmd == \"edit\" {\n        say_kept(\n          mut console,\n          keep_rejected(mut disk, o.root, [(module_arg, text)]),\n        )\n      }\n      return code\n    },\n  }\n  timings.end(\"edit: parse\")\n  match apply_edit(\n    mut console,\n    mut disk,\n    mut launcher,\n    process,\n    clock,\n    cache,\n    o,\n    edits,\n    a.removes,\n    message,\n    a.commit,\n    cmd,\n    contains(line, \"--json\"),\n    if cmd == \"edit\" {\n      [(module_arg, text)]\n    } else {\n      []\n    },\n    a.search,\n    a.proofs || cmd == \"add\",\n  ) {\n    Ok(_) => 0,\n    Err(_) => 1,\n  }\n}","old_text":"/// `strata edit [MODULE] [-m MSG] [--rm NAME].. [--no-commit] [--no-search]`\n/// and `strata\n/// add FILE [MODULE]`: definitions from standard input (or the file, or the\n/// editor) replace or join the package's of the same names in MODULE\n/// (default the root module). Recorded only if the whole package checks.\nfn edit_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  args: List[String],\n  cmd: String,\n) -> std.process.ExitCode {\n  if contains(args, \"--help\") || contains(args, \"-h\") {\n    mut console.write(command_usage(cmd))\n    return 0\n  }\n  // `--file F`: a script or a folder, outside any log. std's folder is\n  // edited as a package is, checked and atomic (it is built into strata).\n  mut line := args\n  mut opened: Option[Result[Opened, String]] = None\n  match [k for (k, x) in enumerate(args) where x == \"--file\"] {\n    [k, ..] => {\n      f := get(args, k + 1) ?? \"\"\n      rest := [x for (i, x) in enumerate(args) where i != k && i != k + 1]\n      if disk.is_dir(f) && package_name(disk, f) == \"std\" {\n        opened = Some(open_package_at(disk, process, f, cmd))\n        line = rest\n      } else {\n        return edit_file(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          f,\n          rest,\n          cmd,\n        )\n      }\n    },\n    [] => (),\n  }\n  timings.begin(\"edit: open\")\n  o := match opened ?? open_package(disk, process, cmd) {\n    Ok(o) => o,\n    Err(_) => return fail_with(\n      mut console,\n      \"no package here (no strata.toml in this folder or above: run `strata init`, or pass --file)\",\n    ),\n  }\n  timings.end(\"edit: open\")\n  // (`--file std`: outside any log, as `--file` is: written and checked,\n  // never committed to git)\n  given_args := match edit_args(line) {\n    Ok(g) => EditArgs { ..g, commit: g.commit && opened is None },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // (`--rm NAME`: a qualified name, or a short one naming one definition,\n  // in MODULE first)\n  a := match removed_names(o.decls, if cmd == \"add\" {\n    \"\"\n  } else {\n    package_module(o.name, edit_module(given_args.module ?? \"\"))\n  }, given_args.removes) {\n    Ok(rs) => EditArgs { ..given_args, removes: rs },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // `add FILE [MODULE]`: the file's text, into MODULE. For a module file or\n  // a folder of them: its definitions, in their modules.\n  if cmd == \"add\" {\n    f := a.module ?? \"\"\n    stored_defs := if disk.is_dir(f) {\n      Some(package_decls(disk, f, \"\"))\n    } else {\n      match disk.read_bytes(f) {\n        Ok(bytes) => match binary.read(bytes) {\n          Ok(img) => Some(img.decls),\n          Err(_) => None,\n        },\n        Err(e) => return fail_with(mut console, f\"{f}: {e}\"),\n      }\n    }\n    match stored_defs {\n      Some(ds) => {\n        message := if a.message == \"edit\" {\n          \"import\"\n        } else {\n          a.message\n        }\n        return match apply_edit(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          clock,\n          cache,\n          o,\n          ds,\n          a.removes,\n          message,\n          a.commit,\n          cmd,\n          contains(line, \"--json\"),\n          [],\n          a.search,\n          true,\n        ) {\n          Ok(_) => 0,\n          Err(_) => 1,\n        }\n      },\n      None => (),\n    }\n  }\n  (text, module_arg, message) := if cmd == \"add\" {\n    f := a.module ?? \"\"\n    t := match disk.read(f) {\n      Ok(t) => t,\n      Err(e) => return fail_with(mut console, f\"{f}: {e}\"),\n    }\n    (t, a.extra ?? \"\", if a.message == \"edit\" {\n      \"import\"\n    } else {\n      a.message\n    })\n  } else if contains(line, \"--editor\")\n    || console.interactive()\n      && driver_terminal(1).to_int() == 1\n      && len(a.removes) == 0 {\n    // (an editor only for someone at the terminal: standard input and output\n    // both on it, and nothing to remove)\n    return edit_in_editor(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      clock,\n      cache,\n      o,\n      a,\n    )\n  } else {\n    match piped_input(\n      mut console,\n      len(a.removes) > 0,\n      \"strata edit [MODULE]\",\n    ) {\n      Ok(t) => (t, a.module ?? \"\", a.message),\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  // (std's modules as stored: `io` is `std.io`)\n  timings.begin(\"edit: parse\")\n  edits := match parse.parse_module(\n    text,\n    package_module(o.name, edit_module(module_arg)),\n  ) {\n    Ok(ds) => ds,\n    Err(e) => {\n      code := fail_with(mut console, f\"parse error at {e}\")\n      if cmd == \"edit\" {\n        say_kept(\n          mut console,\n          keep_rejected(mut disk, o.root, [(module_arg, text)]),\n        )\n      }\n      return code\n    },\n  }\n  timings.end(\"edit: parse\")\n  match apply_edit(\n    mut console,\n    mut disk,\n    mut launcher,\n    process,\n    clock,\n    cache,\n    o,\n    edits,\n    a.removes,\n    message,\n    a.commit,\n    cmd,\n    contains(line, \"--json\"),\n    if cmd == \"edit\" {\n      [(module_arg, text)]\n    } else {\n      []\n    },\n    a.search,\n    a.proofs,\n  ) {\n    Ok(_) => 0,\n    Err(_) => 1,\n  }\n}"}]}
{"id":"ee8e184b94d3a157","time":1795665861,"message":"edit","changes":[{"name":"walk.without_proofs","kind":"fn","old":null,"new":"8317f719fa2ef0bb","interface_changed":true,"affected":[],"module":"walk","text":"/// `e` without its proof material: loops' and functions' clauses\n/// (`invariant`, `decreases`), `assert … by` and `calc` statements. What\n/// runs is the same.\npub fn without_proofs(e: ast.Expr) -> ast.Expr {\n  walk.rewrite_expr(e, x -> match x {\n    ast.Block { stmts, last } => if stmts.any(\n      s -> s is ast.Invariant\n        || s is ast.Decreases\n        || s is ast.AssertBy\n        || s is ast.Calc,\n    ) {\n      kept := stmts.filter(\n        s -> !(s is ast.Invariant\n          || s is ast.Decreases\n          || s is ast.AssertBy\n          || s is ast.Calc),\n      )\n      if kept == [] {\n        last\n      } else {\n        ast.Block { stmts: kept, last }\n      }\n    } else {\n      x\n    },\n    _ => x,\n  })\n}"}]}
{"id":"54a67c466854b289","time":1795665869,"message":"edit","changes":[{"name":"diff.use ast","kind":"use","old":"1a744d5901ecbd64","new":"ce7d3a55ba478a9e","interface_changed":true,"affected":[],"module":"diff","text":"// diff: structural diffs between two versions of a codebase, for\n// `strata diff`, over the patches of a package's log or the git commits of\n// a folder of sources.\n//\n// Definitions are paired by name and through recorded renames. Each pair\n// becomes one typed change: what happened in words, the code with changes\n// marked in place and unchanged parts folded, and a word diff of its doc. A\n// body that was mostly rewritten gets a plain line diff instead. A\n// definition whose only change follows a rename is folded into that rename.\n\nfrom ast use DeriveFnDef, Decl, Expr, FnDecl, TypeDecl, TraitDecl, TypeExpr,\n  Named, Refined, FnType, UnionType, UnitType, UnitExpr, TypeDef, FnDef,\n  TestDef, TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, ExternFn,\n  ExternType, Alias, RecordBody, SumBody, Stmt, Invariant, Decreases, AssertBy,\n  Calc, Block","old_text":"// diff: structural diffs between two versions of a codebase, for\n// `strata diff`, over the patches of a package's log or the git commits of\n// a folder of sources.\n//\n// Definitions are paired by name and through recorded renames. Each pair\n// becomes one typed change: what happened in words, the code with changes\n// marked in place and unchanged parts folded, and a word diff of its doc. A\n// body that was mostly rewritten gets a plain line diff instead. A\n// definition whose only change follows a rename is folded into that rename.\n\nfrom ast use DeriveFnDef, Decl, Expr, FnDecl, TypeDecl, TraitDecl, TypeExpr,\n  Named, Refined, FnType, UnionType, UnitType, UnitExpr, TypeDef, FnDef,\n  TestDef, TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, ExternFn,\n  ExternType, Alias, RecordBody, SumBody"},{"name":"diff.use text","kind":"use","old":"03d45b7bef1ec347","new":"4bf73fb1f172c3ca","interface_changed":true,"affected":[],"module":"diff","text":"from text use comments_text, decl_body_text, fn_signature_text, expr_text,\n  type_text, block_text","old_text":"from text use comments_text, decl_body_text, fn_signature_text, expr_text,\n  type_text"},{"name":"diff.kind_str","kind":"fn","old":"7de70215de58cf94","new":"ee27b0df13a17452","interface_changed":false,"affected":[],"module":"diff","text":"fn kind_str(d: ast.Decl) -> String {\n  match d.kind {\n    ast.TypeDef(_) => \"type\",\n    ast.FnDef(f) => if f.lemma {\n      \"lemma\"\n    } else {\n      \"fn\"\n    },\n    ast.TestDef(_) => \"test\",\n    ast.TraitDef(_) => \"trait\",\n    ast.ImplDef(_) => \"impl\",\n    ast.UseDef(_) => \"use\",\n    ast.ExternDef(_) => \"extern\",\n    ast.CapabilityDef(_) => \"capability\",\n    ast.DeriveFnDef(_) => \"derive\",\n  }\n}","old_text":"fn kind_str(d: ast.Decl) -> String {\n  match d.kind {\n    ast.TypeDef(_) => \"type\",\n    ast.FnDef(_) => \"fn\",\n    ast.TestDef(_) => \"test\",\n    ast.TraitDef(_) => \"trait\",\n    ast.ImplDef(_) => \"impl\",\n    ast.UseDef(_) => \"use\",\n    ast.ExternDef(_) => \"extern\",\n    ast.CapabilityDef(_) => \"capability\",\n    ast.DeriveFnDef(_) => \"derive\",\n  }\n}"},{"name":"diff.methods_words","kind":"fn","old":"2d87d96adb425a80","new":"87f3fb191f38fb61","interface_changed":false,"affected":[],"module":"diff","text":"fn methods_words(\n  o: List[(String, ast.FnDecl)],\n  n: List[(String, ast.FnDecl)],\n  contracts: Bool,\n) -> List[String] {\n  added := n.filter(x -> !o.any(y -> y.0 == x.0)).map(x -> x.0)\n  removed := o.filter(x -> !n.any(y -> y.0 == x.0)).map(x -> x.0)\n  mut out := []\n  if len(added) > 0 {\n    mut out.push(diff.named_list(\"method\", added) + \" added\")\n  }\n  if len(removed) > 0 {\n    mut out.push(diff.named_list(\"method\", removed) + \" removed\")\n  }\n  mut changed := []\n  for (name, b) in n {\n    match o.find(y -> y.0 == name) {\n      None => (),\n      Some((_, a)) => {\n        if contracts {\n          out += diff.contract_words(a, b).map(x -> \"`\" + name + \"`: \" + x)\n        }\n        if diff.fn_sig(a) != diff.fn_sig(b) {\n          mut out.push(\"`\" + name + \"`: signature changed\")\n        } else if diff.body_text(a) != diff.body_text(b)\n          && b.body != ast.UnitExpr {\n          ws := diff.body_words(a, b)\n          if contains(ws, \"body changed\") {\n            mut changed.push(name)\n          }\n          if contains(ws, \"proofs changed\") {\n            mut out.push(\"`\" + name + \"`: proofs changed\")\n          }\n        }\n      },\n    }\n  }\n  if len(changed) > 0 {\n    mut out.push(diff.named_list(\"method\", changed) + \" changed\")\n  }\n  out\n}","old_text":"fn methods_words(\n  o: List[(String, ast.FnDecl)],\n  n: List[(String, ast.FnDecl)],\n  contracts: Bool,\n) -> List[String] {\n  added := n.filter(x -> !o.any(y -> y.0 == x.0)).map(x -> x.0)\n  removed := o.filter(x -> !n.any(y -> y.0 == x.0)).map(x -> x.0)\n  mut out := []\n  if len(added) > 0 {\n    mut out.push(diff.named_list(\"method\", added) + \" added\")\n  }\n  if len(removed) > 0 {\n    mut out.push(diff.named_list(\"method\", removed) + \" removed\")\n  }\n  mut changed := []\n  for (name, b) in n {\n    match o.find(y -> y.0 == name) {\n      None => (),\n      Some((_, a)) => {\n        if contracts {\n          out += diff.contract_words(a, b).map(x -> \"`\" + name + \"`: \" + x)\n        }\n        if diff.fn_sig(a) != diff.fn_sig(b) {\n          mut out.push(\"`\" + name + \"`: signature changed\")\n        } else if diff.body_text(a) != diff.body_text(b)\n          && b.body != ast.UnitExpr {\n          mut changed.push(name)\n        }\n      },\n    }\n  }\n  if len(changed) > 0 {\n    mut out.push(diff.named_list(\"method\", changed) + \" changed\")\n  }\n  out\n}"},{"name":"diff.change_words","kind":"fn","old":"5410086f586d1925","new":"9d2d61b1525ed30a","interface_changed":false,"affected":[],"module":"diff","text":"fn change_words(o: ast.Decl, n: ast.Decl) -> List[String] {\n  mut out := match (o.kind, n.kind) {\n    (ast.FnDef(a), ast.FnDef(b)) => {\n      mut w := []\n      if diff.fn_sig(a) != diff.fn_sig(b) {\n        mut w.push(\"signature changed\")\n      }\n      w += diff.contract_words(a, b)\n      w += diff.body_words(a, b)\n      w\n    },\n    (ast.TypeDef(a), ast.TypeDef(b)) => diff.type_words(a, b),\n    (ast.TraitDef(a), ast.TraitDef(b)) => {\n      mut w := []\n      if a.capability != b.capability {\n        mut w.push(\n          if b.capability {\n            \"made a capability trait\"\n          } else {\n            \"no longer a capability trait\"\n          },\n        )\n      }\n      w += diff.methods_words(\n        a.methods.map(m -> (m.decl.name, m.decl)),\n        b.methods.map(m -> (m.decl.name, m.decl)),\n        true,\n      )\n      if a.laws.map(l -> l.name) != b.laws.map(l -> l.name) {\n        mut w.push(\"laws changed\")\n      }\n      w\n    },\n    (ast.ImplDef(a), ast.ImplDef(b)) => diff.methods_words(\n      a.methods.map(m -> (m.name, m)),\n      b.methods.map(m -> (m.name, m)),\n      false,\n    ),\n    (ast.CapabilityDef(a), ast.CapabilityDef(b)) => diff.methods_words(\n      a.methods.map(m -> (m.name, m)),\n      b.methods.map(m -> (m.name, m)),\n      false,\n    ),\n    (ast.TestDef(a), ast.TestDef(b)) => if a.params != b.params {\n      [\"capabilities asked for changed\"]\n    } else {\n      [\"body changed\"]\n    },\n    (ast.UseDef(a), ast.UseDef(b)) => if a != b {\n      [\"imports changed\"]\n    } else {\n      []\n    },\n    (ast.ExternDef(a), ast.ExternDef(b)) => match (a.item, b.item) {\n      (ast.ExternFn(f), ast.ExternFn(g)) => {\n        mut w := []\n        if diff.fn_sig(f) != diff.fn_sig(g) {\n          mut w.push(\"signature changed\")\n        }\n        w + diff.contract_words(f, g)\n      },\n      (ast.ExternType(_, _), ast.ExternType(_, _)) => [],\n      _ => [\"kind changed\"],\n    },\n    _ => [\"kind changed\"],\n  }\n  if o.public != n.public {\n    mut out.push(\n      if n.public {\n        \"made public\"\n      } else {\n        \"made private\"\n      },\n    )\n  }\n  if len(out) == 0 && diff.prose(o) != diff.prose(n) {\n    mut out.push(\"doc changed\")\n  }\n  if len(out) == 0 && o.comments != n.comments {\n    mut out.push(\"comments changed\")\n  }\n  if len(out) == 0 {\n    mut out.push(\"changed\")\n  }\n  out\n}","old_text":"fn change_words(o: ast.Decl, n: ast.Decl) -> List[String] {\n  mut out := match (o.kind, n.kind) {\n    (ast.FnDef(a), ast.FnDef(b)) => {\n      mut w := []\n      if diff.fn_sig(a) != diff.fn_sig(b) {\n        mut w.push(\"signature changed\")\n      }\n      w += diff.contract_words(a, b)\n      if diff.body_text(a) != diff.body_text(b) {\n        mut w.push(\"body changed\")\n      }\n      w\n    },\n    (ast.TypeDef(a), ast.TypeDef(b)) => diff.type_words(a, b),\n    (ast.TraitDef(a), ast.TraitDef(b)) => {\n      mut w := []\n      if a.capability != b.capability {\n        mut w.push(\n          if b.capability {\n            \"made a capability trait\"\n          } else {\n            \"no longer a capability trait\"\n          },\n        )\n      }\n      w += diff.methods_words(\n        a.methods.map(m -> (m.decl.name, m.decl)),\n        b.methods.map(m -> (m.decl.name, m.decl)),\n        true,\n      )\n      if a.laws.map(l -> l.name) != b.laws.map(l -> l.name) {\n        mut w.push(\"laws changed\")\n      }\n      w\n    },\n    (ast.ImplDef(a), ast.ImplDef(b)) => diff.methods_words(\n      a.methods.map(m -> (m.name, m)),\n      b.methods.map(m -> (m.name, m)),\n      false,\n    ),\n    (ast.CapabilityDef(a), ast.CapabilityDef(b)) => diff.methods_words(\n      a.methods.map(m -> (m.name, m)),\n      b.methods.map(m -> (m.name, m)),\n      false,\n    ),\n    (ast.TestDef(a), ast.TestDef(b)) => if a.params != b.params {\n      [\"capabilities asked for changed\"]\n    } else {\n      [\"body changed\"]\n    },\n    (ast.UseDef(a), ast.UseDef(b)) => if a != b {\n      [\"imports changed\"]\n    } else {\n      []\n    },\n    (ast.ExternDef(a), ast.ExternDef(b)) => match (a.item, b.item) {\n      (ast.ExternFn(f), ast.ExternFn(g)) => {\n        mut w := []\n        if diff.fn_sig(f) != diff.fn_sig(g) {\n          mut w.push(\"signature changed\")\n        }\n        w + diff.contract_words(f, g)\n      },\n      (ast.ExternType(_, _), ast.ExternType(_, _)) => [],\n      _ => [\"kind changed\"],\n    },\n    _ => [\"kind changed\"],\n  }\n  if o.public != n.public {\n    mut out.push(\n      if n.public {\n        \"made public\"\n      } else {\n        \"made private\"\n      },\n    )\n  }\n  if len(out) == 0 && diff.prose(o) != diff.prose(n) {\n    mut out.push(\"doc changed\")\n  }\n  if len(out) == 0 && o.comments != n.comments {\n    mut out.push(\"comments changed\")\n  }\n  if len(out) == 0 {\n    mut out.push(\"changed\")\n  }\n  out\n}"},{"name":"diff.use walk","kind":"use","old":null,"new":"5f0e218467f5155b","interface_changed":true,"affected":[],"module":"diff","text":"from walk use without_proofs, kids"},{"name":"diff.body_words","kind":"fn","old":null,"new":"7b0521c8e5de8111","interface_changed":true,"affected":[],"module":"diff","text":"/// How a function's body changed: its code (`body changed`), and apart from\n/// it its proof material (`proofs changed`: loop invariants, `decreases`,\n/// `assert … by`, `calc`), which `strata view` hides by default.\nfn body_words(a: ast.FnDecl, b: ast.FnDecl) -> List[String] {\n  mut out := []\n  if diff.body_text(a) != diff.body_text(b) {\n    if text.expr_text(walk.without_proofs(a.body), 0) != text.expr_text(walk.without_proofs(b.body), 0) {\n      mut out.push(\"body changed\")\n    }\n    if diff.proof_parts(a.body) != diff.proof_parts(b.body) {\n      mut out.push(\"proofs changed\")\n    }\n  }\n  out\n}"},{"name":"diff.proof_parts","kind":"fn","old":null,"new":"b4b0ff7473c06edf","interface_changed":true,"affected":[],"module":"diff","text":"/// The proof material of `e` as text, block by block.\nfn proof_parts(e: ast.Expr) -> List[String] {\n  diff.stmt_lists(e)\n    .map(ss -> join(ss\n      .filter(s -> s is ast.Invariant\n        || s is ast.Decreases\n        || s is ast.AssertBy\n        || s is ast.Calc)\n      .map(s -> text.block_text(\n        ast.Block { stmts: [s], last: ast.UnitExpr },\n        0,\n      )), \"\\n\"))\n    .filter(t -> t != \"\")\n}"},{"name":"diff.stmt_lists","kind":"fn","old":null,"new":"cff5af87561b0c8c","interface_changed":true,"affected":[],"module":"diff","text":"fn stmt_lists(e: ast.Expr) -> List[List[ast.Stmt]] {\n  mut out := []\n  match e {\n    ast.Block { stmts, .. } => mut out.push(stmts),\n    _ => (),\n  }\n  for k in walk.kids(e) {\n    out += diff.stmt_lists(k)\n  }\n  out\n}"}]}
{"id":"729a0fb80dd40d58","time":1795666002,"message":"edit","changes":[{"name":"smt.assert_by","kind":"fn","old":"c35f5871a7c952ff","new":"c68f1100937685ed","interface_changed":false,"affected":[],"module":"smt","text":"/// `assert cond by proof`: `cond` proven in a query of its own, from the\n/// path's conditions and the facts the proof's steps make (a lemma's\n/// `ensures`, a step's `assert`), none of the function's other facts. The\n/// steps' checks (a lemma's `requires`, an `assert` among them) are proven\n/// where they are, as any check. Then `cond` holds from here on, as one\n/// condition; the proof's facts are dropped.\nfn assert_by(mut vc: smt.Vc, cond: ast.Expr, proof: ast.Expr) {\n  if vc.dead || vc.spec > 0 {\n    return\n  }\n  s0 := len(vc.facts)\n  b := smt.as_bool(mut vc, smt.eval(mut vc, cond))\n  s1 := len(vc.facts)\n  n_ob := len(vc.obligations)\n  n_term := len(vc.term_obs)\n  saved_pc := vc.pc\n  saved_from := vc.proof_from\n  vc.proof_from = s0\n  _ := smt.eval(mut vc, proof)\n  vc.proof_from = saved_from\n  vc.dead = false\n  // (the goal is on the path the steps leave: past their checks, a\n  // lemma's `requires` among them)\n  if smt.start_goal(mut vc) {\n    smt.small_goal(\n      mut vc,\n      \"assert \" + text.expr_text(cond, 0) + \" by …\",\n      b,\n      s0,\n    )\n  }\n  vc.pc = saved_pc\n  smt.proof_ended(mut vc, s1, n_ob, n_term)\n  if b != \"true\" {\n    mut vc.pc.push(b)\n  }\n}","old_text":"/// `assert cond by proof`: `cond` proven in a query of its own, from the\n/// path's conditions and the facts the proof's steps make (a lemma's\n/// `ensures`, a step's `assert`), none of the function's other facts. The\n/// steps' checks (a lemma's `requires`, an `assert` among them) are proven\n/// where they are, as any check. Then `cond` holds from here on, as one\n/// condition; the proof's facts are dropped.\nfn assert_by(mut vc: smt.Vc, cond: ast.Expr, proof: ast.Expr) {\n  if vc.dead || vc.spec > 0 {\n    return\n  }\n  s0 := len(vc.facts)\n  b := smt.as_bool(mut vc, smt.eval(mut vc, cond))\n  s1 := len(vc.facts)\n  n_ob := len(vc.obligations)\n  n_term := len(vc.term_obs)\n  saved_pc := vc.pc\n  saved_from := vc.proof_from\n  vc.proof_from = s0\n  _ := smt.eval(mut vc, proof)\n  vc.proof_from = saved_from\n  vc.dead = false\n  vc.pc = saved_pc\n  if smt.start_goal(mut vc) {\n    smt.small_goal(\n      mut vc,\n      \"assert \" + text.expr_text(cond, 0) + \" by …\",\n      b,\n      s0,\n    )\n  }\n  vc.pc = saved_pc\n  smt.proof_ended(mut vc, s1, n_ob, n_term)\n  if b != \"true\" {\n    mut vc.pc.push(b)\n  }\n}"}]}
{"id":"cc89d96d42fb20c5","time":1795666018,"message":"edit","changes":[{"name":"lemma_verdict","kind":"fn","old":"98988b5060714db8","new":"be48f56c08ac4831","interface_changed":false,"affected":[],"module":"","text":"/// A lemma's verdict: proven, or not. It is never run (never compiled), so a\n/// solver's counterexample is its verdict as found, and what the solver\n/// leaves open stays open (incomplete), never fuzzed.\nfn lemma_verdict(vc: smt.Vc, answers: List[smt.Answer]) -> Verdict {\n  mut proven := []\n  mut open := []\n  for a in answers {\n    if a.outcome == \"proven\" {\n      mut proven.push(a.what)\n    } else if a.outcome == \"refuted\" && !contains(a.message, \"(depends on \") {\n      // (a counterexample that depends on what the solver doesn't model\n      // may not be one: the lemma stays open)\n      return VCounterexample {\n        args: a.args.map(x -> x.0 + \" = \" + text.expr_text(x.1, 0)),\n        kind: \"Ensures\",\n        message: \"not proven: \" + a.what + \": \" + a.message,\n        found_by: \"solver\",\n      }\n    } else {\n      mut open.push(a.what + \": \" + a.message)\n    }\n  }\n  if open == [] {\n    VProven { checks: proven + vc.invariants, given: vc.given }\n  } else {\n    VIncomplete(\"a lemma is proven or not, never run: not proven: \"\n      + join(open, \"; \"))\n  }\n}","old_text":"/// A lemma's verdict: proven, or not. It is never run (never compiled), so a\n/// solver's counterexample is its verdict as found, and what the solver\n/// leaves open stays open (incomplete), never fuzzed.\nfn lemma_verdict(vc: smt.Vc, answers: List[smt.Answer]) -> Verdict {\n  mut proven := []\n  mut open := []\n  for a in answers {\n    if a.outcome == \"proven\" {\n      mut proven.push(a.what)\n    } else if a.outcome == \"refuted\" {\n      return VCounterexample {\n        args: a.args.map(x -> x.0 + \" = \" + text.expr_text(x.1, 0)),\n        kind: \"Ensures\",\n        message: \"not proven: \" + a.what + \": \" + a.message,\n        found_by: \"solver\",\n      }\n    } else {\n      mut open.push(a.what + \": \" + a.message)\n    }\n  }\n  if open == [] {\n    VProven { checks: proven + vc.invariants, given: vc.given }\n  } else {\n    VIncomplete(\"a lemma is proven or not, never run: not proven: \"\n      + join(open, \"; \"))\n  }\n}"}]}
{"id":"8a5bbef578e74227","time":1795666086,"message":"edit","changes":[{"name":"lint.fn_shapes","kind":"fn","old":"9737b3207606e74a","new":"64790c930a2edc1f","interface_changed":false,"affected":[],"module":"lint","text":"/// The contract-shape rules on a function named `name` (as messages give\n/// it): its warnings, and the function fixed.\nfn fn_shapes(name: String, f: ast.FnDecl) -> (List[String], ast.FnDecl) {\n  // (a lemma's `requires` are its hypotheses, its `ensures` the fact it\n  // proves: they stay contracts)\n  if f.derived || f.lemma {\n    return ([], f)\n  }\n  pnames := f.params.map(p -> p.name)\n  mut ws := []\n  // refinements naming another parameter become `requires`, placed first\n  // since they held on entry before any `requires`\n  mut pre_moved := []\n  mut params := []\n  for p in f.params {\n    match p.ty {\n      ast.Refined { base, pred } => if p.mutable {\n        mut params.push(p)\n      } else {\n        mut keep := []\n        mut moved := []\n        for c in lint.conjuncts(pred) {\n          if pnames.any(q -> q != p.name && lint.names(c, q)) {\n            mut moved.push(lint.renamed(c, \"it\", p.name))\n          } else {\n            mut keep.push(c)\n          }\n        }\n        if moved != [] {\n          ty := lint.refined_or(base, keep)\n          shown := join(\n            moved.map(c -> \"requires \" + text.expr_text(c, 0)),\n            \", \",\n          )\n          mut ws.push(\n            f\"in `{name}`, the refinement of `{lint.param_shown(p)}` names another parameter: a refinement names only `it` and constants, a relation is a contract; write `{p.name}: {text.type_text(ty)}` and `{shown}`\",\n          )\n          pre_moved += moved\n          mut params.push(ast.Param { ..p, ty })\n        } else {\n          mut params.push(p)\n        }\n      },\n      _ => mut params.push(p),\n    }\n  }\n  // the result's refinement naming a parameter becomes an `ensures`\n  mut post_moved := []\n  ret := match f.ret {\n    ast.Refined { base, pred } => {\n      mut keep := []\n      mut moved := []\n      for c in lint.conjuncts(pred) {\n        if pnames.any(q -> lint.names(c, q)) {\n          mut moved.push(c)\n        } else {\n          mut keep.push(c)\n        }\n      }\n      if moved != [] {\n        ty := lint.refined_or(base, keep)\n        shown := join(\n          moved.map(c -> \"ensures \" + text.expr_text(c, 0)),\n          \", \",\n        )\n        mut ws.push(\n          f\"in `{name}`, the result's refinement (`-> {text.type_text(f.ret)}`) names a parameter: a refinement names only `it` and constants, a relation is a contract; write `-> {text.type_text(ty)}` and `{shown}`\",\n        )\n        post_moved = moved\n        ty\n      } else {\n        f.ret\n      }\n    },\n    t => t,\n  }\n  // `requires` conjuncts naming one parameter become its refinement\n  mut extra := Dict[String, List[ast.Expr]] {}\n  mut said := Dict[String, List[ast.Expr]] {}\n  mut pre := []\n  for r in f.pre {\n    // an assumed contract stays one: a refinement is checked when the\n    // program runs\n    if r is ast.Assumed {\n      mut pre.push(r)\n      continue\n    }\n    mut kept := []\n    for c in lint.conjuncts(r) {\n      one := match pnames.filter(q -> lint.names(c, q)) {\n        [q] => if lint.names(c, \"it\") {\n          None\n        } else {\n          match params.filter(p -> p.name == q) {\n            [p] => if p.mutable || !lint.refinable(p.ty) {\n              None\n            } else {\n              Some(q)\n            },\n            _ => None,\n          }\n        },\n        _ => None,\n      }\n      match one {\n        Some(q) => {\n          mut extra.insert(\n            q,\n            (get(extra, q) ?? []) + [lint.renamed(c, q, \"it\")],\n          )\n          mut said.insert(q, (get(said, q) ?? []) + [c])\n        },\n        None => mut kept.push(c),\n      }\n    }\n    if kept != [] {\n      mut pre.push(lint.conjunction(kept))\n    }\n  }\n  mut fixed_params := []\n  for p in params {\n    match get(extra, p.name) {\n      Some(cs) => {\n        ty := lint.refined_by(p.ty, cs)\n        written := join(\n          (get(said, p.name) ?? []).map(c -> text.expr_text(c, 0)),\n          \" && \",\n        )\n        mut ws.push(\n          f\"in `{name}`, `requires {written}` only constrains `{p.name}`: that is a refinement of its type, `{p.name}: {text.type_text(ty)}`\",\n        )\n        mut fixed_params.push(ast.Param { ..p, ty })\n      },\n      None => mut fixed_params.push(p),\n    }\n  }\n  // `ensures` conjuncts naming only the result become its refinement; one\n  // naming only an element of it (`it.1`, a named result) that element's\n  elems := match ret {\n    ast.Named { name: \"Tuple\", args } => args,\n    _ => [],\n  }\n  mut post := []\n  mut to_ret := []\n  mut to_elem := Dict[Int, List[ast.Expr]] {}\n  mut elem_said := Dict[Int, List[ast.Expr]] {}\n  for e in f.post {\n    if e is ast.Assumed {\n      mut post.push(e)\n      continue\n    }\n    mut kept := []\n    for c in lint.conjuncts(e) {\n      // one with `old` says how a value changed: a contract\n      if pnames.any(q -> lint.names(c, q))\n        || walk.any_expr(c, x -> x is ast.Old) {\n        mut kept.push(c)\n      } else {\n        match lint.element_of(c, f.results, len(elems)) {\n          Some((k, r)) => {\n            mut to_elem.insert(k, (get(to_elem, k) ?? []) + [r])\n            mut elem_said.insert(k, (get(elem_said, k) ?? []) + [c])\n          },\n          None => if f.results == []\n            && elems == []\n            && lint.names(c, \"it\")\n            && lint.refinable(ret) {\n            mut to_ret.push(c)\n          } else {\n            mut kept.push(c)\n          },\n        }\n      }\n    }\n    if kept != [] {\n      mut post.push(lint.conjunction(kept))\n    }\n  }\n  with_elems := if len(to_elem) == 0 {\n    ret\n  } else {\n    mut args := []\n    for (k, t) in enumerate(elems) {\n      mut args.push(\n        match get(to_elem, k) {\n          Some(cs) => {\n            ty := lint.refined_by(t, cs)\n            written := join(\n              (get(elem_said, k) ?? []).map(\n                c -> text.expr_text(c, 0),\n              ),\n              \" && \",\n            )\n            mut ws.push(\n              match get(f.results, k) {\n                Some(r) => f\"in `{name}`, `ensures {written}` only constrains the result `{r}`: that is a refinement of its type, `{r}: {text.type_text(ty)}`\",\n                None => f\"in `{name}`, `ensures {written}` only constrains the result's element {k}: that is a refinement of its type, `{text.type_text(ty)}` in `-> {text.type_text(ret)}`\",\n              },\n            )\n            ty\n          },\n          None => t,\n        },\n      )\n    }\n    ast.Named { name: \"Tuple\", args }\n  }\n  final_ret := if to_ret == [] {\n    with_elems\n  } else {\n    ty := lint.refined_by(with_elems, to_ret)\n    written := join(to_ret.map(c -> text.expr_text(c, 0)), \" && \")\n    mut ws.push(\n      f\"in `{name}`, `ensures {written}` only constrains the result: that is a refinement of its type, `-> {text.type_text(ty)}`\",\n    )\n    ty\n  }\n  (\n    ws,\n    ast.FnDecl { ..f, params: fixed_params, ret: final_ret, pre: pre_moved + pre, post: post_moved + post },\n  )\n}","old_text":"/// The contract-shape rules on a function named `name` (as messages give\n/// it): its warnings, and the function fixed.\nfn fn_shapes(name: String, f: ast.FnDecl) -> (List[String], ast.FnDecl) {\n  if f.derived {\n    return ([], f)\n  }\n  pnames := f.params.map(p -> p.name)\n  mut ws := []\n  // refinements naming another parameter become `requires`, placed first\n  // since they held on entry before any `requires`\n  mut pre_moved := []\n  mut params := []\n  for p in f.params {\n    match p.ty {\n      ast.Refined { base, pred } => if p.mutable {\n        mut params.push(p)\n      } else {\n        mut keep := []\n        mut moved := []\n        for c in lint.conjuncts(pred) {\n          if pnames.any(q -> q != p.name && lint.names(c, q)) {\n            mut moved.push(lint.renamed(c, \"it\", p.name))\n          } else {\n            mut keep.push(c)\n          }\n        }\n        if moved != [] {\n          ty := lint.refined_or(base, keep)\n          shown := join(\n            moved.map(c -> \"requires \" + text.expr_text(c, 0)),\n            \", \",\n          )\n          mut ws.push(\n            f\"in `{name}`, the refinement of `{lint.param_shown(p)}` names another parameter: a refinement names only `it` and constants, a relation is a contract; write `{p.name}: {text.type_text(ty)}` and `{shown}`\",\n          )\n          pre_moved += moved\n          mut params.push(ast.Param { ..p, ty })\n        } else {\n          mut params.push(p)\n        }\n      },\n      _ => mut params.push(p),\n    }\n  }\n  // the result's refinement naming a parameter becomes an `ensures`\n  mut post_moved := []\n  ret := match f.ret {\n    ast.Refined { base, pred } => {\n      mut keep := []\n      mut moved := []\n      for c in lint.conjuncts(pred) {\n        if pnames.any(q -> lint.names(c, q)) {\n          mut moved.push(c)\n        } else {\n          mut keep.push(c)\n        }\n      }\n      if moved != [] {\n        ty := lint.refined_or(base, keep)\n        shown := join(\n          moved.map(c -> \"ensures \" + text.expr_text(c, 0)),\n          \", \",\n        )\n        mut ws.push(\n          f\"in `{name}`, the result's refinement (`-> {text.type_text(f.ret)}`) names a parameter: a refinement names only `it` and constants, a relation is a contract; write `-> {text.type_text(ty)}` and `{shown}`\",\n        )\n        post_moved = moved\n        ty\n      } else {\n        f.ret\n      }\n    },\n    t => t,\n  }\n  // `requires` conjuncts naming one parameter become its refinement\n  mut extra := Dict[String, List[ast.Expr]] {}\n  mut said := Dict[String, List[ast.Expr]] {}\n  mut pre := []\n  for r in f.pre {\n    // an assumed contract stays one: a refinement is checked when the\n    // program runs\n    if r is ast.Assumed {\n      mut pre.push(r)\n      continue\n    }\n    mut kept := []\n    for c in lint.conjuncts(r) {\n      one := match pnames.filter(q -> lint.names(c, q)) {\n        [q] => if lint.names(c, \"it\") {\n          None\n        } else {\n          match params.filter(p -> p.name == q) {\n            [p] => if p.mutable || !lint.refinable(p.ty) {\n              None\n            } else {\n              Some(q)\n            },\n            _ => None,\n          }\n        },\n        _ => None,\n      }\n      match one {\n        Some(q) => {\n          mut extra.insert(\n            q,\n            (get(extra, q) ?? []) + [lint.renamed(c, q, \"it\")],\n          )\n          mut said.insert(q, (get(said, q) ?? []) + [c])\n        },\n        None => mut kept.push(c),\n      }\n    }\n    if kept != [] {\n      mut pre.push(lint.conjunction(kept))\n    }\n  }\n  mut fixed_params := []\n  for p in params {\n    match get(extra, p.name) {\n      Some(cs) => {\n        ty := lint.refined_by(p.ty, cs)\n        written := join(\n          (get(said, p.name) ?? []).map(c -> text.expr_text(c, 0)),\n          \" && \",\n        )\n        mut ws.push(\n          f\"in `{name}`, `requires {written}` only constrains `{p.name}`: that is a refinement of its type, `{p.name}: {text.type_text(ty)}`\",\n        )\n        mut fixed_params.push(ast.Param { ..p, ty })\n      },\n      None => mut fixed_params.push(p),\n    }\n  }\n  // `ensures` conjuncts naming only the result become its refinement; one\n  // naming only an element of it (`it.1`, a named result) that element's\n  elems := match ret {\n    ast.Named { name: \"Tuple\", args } => args,\n    _ => [],\n  }\n  mut post := []\n  mut to_ret := []\n  mut to_elem := Dict[Int, List[ast.Expr]] {}\n  mut elem_said := Dict[Int, List[ast.Expr]] {}\n  for e in f.post {\n    if e is ast.Assumed {\n      mut post.push(e)\n      continue\n    }\n    mut kept := []\n    for c in lint.conjuncts(e) {\n      // one with `old` says how a value changed: a contract\n      if pnames.any(q -> lint.names(c, q))\n        || walk.any_expr(c, x -> x is ast.Old) {\n        mut kept.push(c)\n      } else {\n        match lint.element_of(c, f.results, len(elems)) {\n          Some((k, r)) => {\n            mut to_elem.insert(k, (get(to_elem, k) ?? []) + [r])\n            mut elem_said.insert(k, (get(elem_said, k) ?? []) + [c])\n          },\n          None => if f.results == []\n            && elems == []\n            && lint.names(c, \"it\")\n            && lint.refinable(ret) {\n            mut to_ret.push(c)\n          } else {\n            mut kept.push(c)\n          },\n        }\n      }\n    }\n    if kept != [] {\n      mut post.push(lint.conjunction(kept))\n    }\n  }\n  with_elems := if len(to_elem) == 0 {\n    ret\n  } else {\n    mut args := []\n    for (k, t) in enumerate(elems) {\n      mut args.push(\n        match get(to_elem, k) {\n          Some(cs) => {\n            ty := lint.refined_by(t, cs)\n            written := join(\n              (get(elem_said, k) ?? []).map(\n                c -> text.expr_text(c, 0),\n              ),\n              \" && \",\n            )\n            mut ws.push(\n              match get(f.results, k) {\n                Some(r) => f\"in `{name}`, `ensures {written}` only constrains the result `{r}`: that is a refinement of its type, `{r}: {text.type_text(ty)}`\",\n                None => f\"in `{name}`, `ensures {written}` only constrains the result's element {k}: that is a refinement of its type, `{text.type_text(ty)}` in `-> {text.type_text(ret)}`\",\n              },\n            )\n            ty\n          },\n          None => t,\n        },\n      )\n    }\n    ast.Named { name: \"Tuple\", args }\n  }\n  final_ret := if to_ret == [] {\n    with_elems\n  } else {\n    ty := lint.refined_by(with_elems, to_ret)\n    written := join(to_ret.map(c -> text.expr_text(c, 0)), \" && \")\n    mut ws.push(\n      f\"in `{name}`, `ensures {written}` only constrains the result: that is a refinement of its type, `-> {text.type_text(ty)}`\",\n    )\n    ty\n  }\n  (\n    ws,\n    ast.FnDecl { ..f, params: fixed_params, ret: final_ret, pre: pre_moved + pre, post: post_moved + post },\n  )\n}"}]}
{"id":"354df3e091ba09c7","time":1795666484,"message":"edit","changes":[{"name":"views.body_kept","kind":"fn","old":"1ff83a29a12ee376","new":"1163282b32329c33","interface_changed":false,"affected":[],"module":"views","text":"/// What `body` (read back from a view) left out of the stored `stored`,\n/// put back, with a note for each part it couldn't place:\n/// - the function's `decreases`, when `body` has none;\n/// - a loop's clauses, when `body`'s loop of the same head (the k-th loop\n/// with that head, as stored) has none. A loop whose head changed or that\n/// is gone loses them (a note says so);\n/// - an `assert … by` or `calc` not in `body`, after the statement it\n/// followed (or before the one it preceded), when that statement is in\n/// `body` exactly once.\nfn body_kept(\n  stored: ast.Expr,\n  given: ast.Expr,\n  name: String,\n) -> (ast.Expr, List[String]) {\n  mut notes := []\n  body0 := views.markers_dropped(given)\n  // the function's `decreases`\n  old_decs := text.loop_clauses(stored).filter(s -> s is ast.Decreases)\n  body1 := if old_decs != []\n    && text.loop_clauses(body0).filter(s -> s is ast.Decreases) == [] {\n    match body0 {\n      ast.Block { stmts, last } => ast.Block { stmts: old_decs + stmts, last },\n      other => ast.Block { stmts: old_decs, last: other },\n    }\n  } else {\n    body0\n  }\n  // loops, by head and rank among loops of that head\n  old_loops := views.loops_in(stored)\n  new_loops := views.loops_in(body1)\n  mut plan: List[(String, List[ast.Stmt])] = []\n  mut used := Set[Int] {}\n  for (i, (h, s)) in enumerate(new_loops) {\n    rank := len(new_loops[..i].filter(x -> x.0 == h))\n    mut seen := 0\n    for (j, (oh, os)) in enumerate(old_loops) {\n      if oh == h {\n        if seen == rank {\n          mut used.insert(j)\n          clauses := text.loop_clauses(views.loop_body_of(os))\n          if clauses != []\n            && text.loop_clauses(views.loop_body_of(s)) == [] {\n            mut plan.push((h + \"\\n\" + views.code_text(s), clauses))\n          }\n          break\n        }\n        seen += 1\n      }\n    }\n  }\n  for (j, (oh, os)) in enumerate(old_loops) {\n    n := len(text.loop_clauses(views.loop_body_of(os)))\n    if n > 0 && !contains(used, j) {\n      what := views.counted(n, \"clause\")\n      mut notes.push(\n        f\"in `{name}`: dropped {what} of `{oh}` (hidden in the view): that loop changed or is gone; write it again (`strata view {name} --proofs` shows what was there), or let the search find invariants\",\n      )\n    }\n  }\n  body2 := if plan == [] {\n    body1\n  } else {\n    walk.rewrite_expr(body1, x -> match x {\n      ast.Block { stmts, last } => if stmts.any(s -> views.loop_head(s) != \"\") {\n        ast.Block { stmts: stmts.map(\n          s -> if views.loop_head(s) == \"\"\n            || text.loop_clauses(views.loop_body_of(s)) != [] {\n            s\n          } else {\n            match plan.filter(\n              p ->\n                p.0 == views.loop_head(s) + \"\\n\" + views.code_text(s),\n            ) {\n              [(_, cs), ..] => views.with_clauses(s, cs),\n              [] => s,\n            }\n          },\n        ), last }\n      } else {\n        x\n      },\n      _ => x,\n    })\n  }\n  // proof statements, by the code around them\n  old_proofs := views.proofs_in(stored)\n  given_proofs := views.proofs_in(body2).map(p -> views.code_text(p.2))\n  mut all_code := []\n  for s in views.stmts_in(body2) {\n    if !views.hidden_stmt(s) && !views.marker(s) {\n      mut all_code.push(views.anchor(s))\n    }\n  }\n  ends := views.block_ends(body2)\n  once := (a: String) -> a != \"\" && len(all_code.filter(c -> c == a)) == 1\n  // (1: after the statement `key`, 2: before it, 3: last in the block\n  // ending with `key`)\n  mut put := []\n  for (before, after, s) in old_proofs {\n    if contains(given_proofs, views.code_text(s)) {\n      continue\n    }\n    if once(before) {\n      mut put.push((1, before, s))\n    } else if once(after) {\n      mut put.push((2, after, s))\n    } else if starts_with(after, \"= \")\n      && len(ends.filter(c -> c == after)) == 1 {\n      mut put.push((3, after, s))\n    } else {\n      shown := match s {\n        ast.AssertBy { cond, .. } => \"assert \" + text.expr_text(cond, 0) + \" by …\",\n        _ => \"calc { … }\",\n      }\n      mut notes.push(\n        f\"in `{name}`: dropped the proof `{shown}` (hidden in the view): the code around it changed; write it again (`strata view {name} --proofs` shows what was there)\",\n      )\n    }\n  }\n  body3 := if put == [] {\n    body2\n  } else {\n    walk.rewrite_expr(body2, x -> match x {\n      ast.Block { stmts, last } => {\n        mut out := []\n        for s in stmts {\n          t := if views.hidden_stmt(s) || views.marker(s) {\n            \"\"\n          } else {\n            views.anchor(s)\n          }\n          for (mode, key, p) in put {\n            if mode == 2 && key == t && t != \"\" {\n              mut out.push(p)\n            }\n          }\n          mut out.push(s)\n          for (mode, key, p) in put {\n            if mode == 1 && key == t && t != \"\" {\n              mut out.push(p)\n            }\n          }\n        }\n        e := views.end_anchor(last)\n        for (mode, key, p) in put {\n          if mode == 3 && key == e {\n            mut out.push(p)\n          }\n        }\n        if len(out) == len(stmts) {\n          x\n        } else {\n          ast.Block { stmts: out, last }\n        }\n      },\n      _ => x,\n    })\n  }\n  (body3, notes)\n}","old_text":"/// What `body` (read back from a view) left out of the stored `stored`,\n/// put back, with a note for each part it couldn't place:\n/// - the function's `decreases`, when `body` has none;\n/// - a loop's clauses, when `body`'s loop of the same head (the k-th loop\n/// with that head, as stored) has none. A loop whose head changed or that\n/// is gone loses them (a note says so);\n/// - an `assert … by` or `calc` not in `body`, after the statement it\n/// followed (or before the one it preceded), when that statement is in\n/// `body` exactly once.\nfn body_kept(\n  stored: ast.Expr,\n  given: ast.Expr,\n  name: String,\n) -> (ast.Expr, List[String]) {\n  mut notes := []\n  body0 := views.markers_dropped(given)\n  // the function's `decreases`\n  old_decs := text.loop_clauses(stored).filter(s -> s is ast.Decreases)\n  body1 := if old_decs != []\n    && text.loop_clauses(body0).filter(s -> s is ast.Decreases) == [] {\n    match body0 {\n      ast.Block { stmts, last } => ast.Block { stmts: old_decs + stmts, last },\n      other => ast.Block { stmts: old_decs, last: other },\n    }\n  } else {\n    body0\n  }\n  // loops, by head and rank among loops of that head\n  old_loops := views.loops_in(stored)\n  new_loops := views.loops_in(body1)\n  mut plan: List[(String, List[ast.Stmt])] = []\n  mut used := Set[Int] {}\n  for (i, (h, s)) in enumerate(new_loops) {\n    rank := len(new_loops[..i].filter(x -> x.0 == h))\n    mut seen := 0\n    for (j, (oh, os)) in enumerate(old_loops) {\n      if oh == h {\n        if seen == rank {\n          mut used.insert(j)\n          clauses := text.loop_clauses(views.loop_body_of(os))\n          if clauses != []\n            && text.loop_clauses(views.loop_body_of(s)) == [] {\n            mut plan.push((h + \"\\n\" + views.code_text(s), clauses))\n          }\n          break\n        }\n        seen += 1\n      }\n    }\n  }\n  for (j, (oh, os)) in enumerate(old_loops) {\n    n := len(text.loop_clauses(views.loop_body_of(os)))\n    if n > 0 && !contains(used, j) {\n      what := views.counted(n, \"clause\")\n      mut notes.push(\n        f\"in `{name}`: the {what} of `{oh}` (hidden in the view) were dropped: that loop changed or is gone; write them again (`strata view {name} --proofs` shows them), or let the search find invariants\",\n      )\n    }\n  }\n  body2 := if plan == [] {\n    body1\n  } else {\n    walk.rewrite_expr(body1, x -> match x {\n      ast.Block { stmts, last } => if stmts.any(s -> views.loop_head(s) != \"\") {\n        ast.Block { stmts: stmts.map(\n          s -> if views.loop_head(s) == \"\"\n            || text.loop_clauses(views.loop_body_of(s)) != [] {\n            s\n          } else {\n            match plan.filter(\n              p ->\n                p.0 == views.loop_head(s) + \"\\n\" + views.code_text(s),\n            ) {\n              [(_, cs), ..] => views.with_clauses(s, cs),\n              [] => s,\n            }\n          },\n        ), last }\n      } else {\n        x\n      },\n      _ => x,\n    })\n  }\n  // proof statements, by the code around them\n  old_proofs := views.proofs_in(stored)\n  given_proofs := views.proofs_in(body2).map(p -> views.code_text(p.2))\n  mut all_code := []\n  for s in views.stmts_in(body2) {\n    if !views.hidden_stmt(s) && !views.marker(s) {\n      mut all_code.push(views.anchor(s))\n    }\n  }\n  ends := views.block_ends(body2)\n  once := (a: String) -> a != \"\" && len(all_code.filter(c -> c == a)) == 1\n  // (1: after the statement `key`, 2: before it, 3: last in the block\n  // ending with `key`)\n  mut put := []\n  for (before, after, s) in old_proofs {\n    if contains(given_proofs, views.code_text(s)) {\n      continue\n    }\n    if once(before) {\n      mut put.push((1, before, s))\n    } else if once(after) {\n      mut put.push((2, after, s))\n    } else if starts_with(after, \"= \")\n      && len(ends.filter(c -> c == after)) == 1 {\n      mut put.push((3, after, s))\n    } else {\n      shown := match s {\n        ast.AssertBy { cond, .. } => \"assert \" + text.expr_text(cond, 0) + \" by …\",\n        _ => \"calc { … }\",\n      }\n      mut notes.push(\n        f\"in `{name}`: the proof `{shown}` (hidden in the view) was dropped: the code around it changed; write it again (`strata view {name} --proofs` shows it)\",\n      )\n    }\n  }\n  body3 := if put == [] {\n    body2\n  } else {\n    walk.rewrite_expr(body2, x -> match x {\n      ast.Block { stmts, last } => {\n        mut out := []\n        for s in stmts {\n          t := if views.hidden_stmt(s) || views.marker(s) {\n            \"\"\n          } else {\n            views.anchor(s)\n          }\n          for (mode, key, p) in put {\n            if mode == 2 && key == t && t != \"\" {\n              mut out.push(p)\n            }\n          }\n          mut out.push(s)\n          for (mode, key, p) in put {\n            if mode == 1 && key == t && t != \"\" {\n              mut out.push(p)\n            }\n          }\n        }\n        e := views.end_anchor(last)\n        for (mode, key, p) in put {\n          if mode == 3 && key == e {\n            mut out.push(p)\n          }\n        }\n        if len(out) == len(stmts) {\n          x\n        } else {\n          ast.Block { stmts: out, last }\n        }\n      },\n      _ => x,\n    })\n  }\n  (body3, notes)\n}"}]}
{"id":"aac781ff997f5b5d","time":1795666747,"message":"edit","changes":[{"name":"highlight.keywords","kind":"fn","old":"88f5f9b3bf415e95","new":"8089acd5fa9070df","interface_changed":false,"affected":[],"module":"highlight","text":"/// site/common.js's `KW`.\nfn keywords() -> Set[String] {\n  set([\n    \"fn\",\n    \"type\",\n    \"trait\",\n    \"impl\",\n    \"for\",\n    \"in\",\n    \"if\",\n    \"else\",\n    \"match\",\n    \"while\",\n    \"loop\",\n    \"return\",\n    \"break\",\n    \"continue\",\n    \"mut\",\n    \"let\",\n    \"pub\",\n    \"use\",\n    \"from\",\n    \"test\",\n    \"assert\",\n    \"requires\",\n    \"ensures\",\n    \"where\",\n    \"it\",\n    \"self\",\n    \"Self\",\n    \"true\",\n    \"false\",\n    \"mock\",\n    \"distinct\",\n    \"derive\",\n    \"derivable\",\n    \"derived\",\n    \"comptime\",\n    \"or\",\n    \"except\",\n    \"invariant\",\n    \"decreases\",\n    \"lemma\",\n    \"by\",\n    \"calc\",\n    \"law\",\n    \"as\",\n    \"is\",\n    \"scope\",\n    \"spawn\",\n    \"await\",\n    \"select\",\n    \"race\",\n    \"supervised\",\n    \"capability\",\n    \"extern\",\n    \"terminates\",\n    \"noalloc\",\n  ])\n}","old_text":"/// site/common.js's `KW`.\nfn keywords() -> Set[String] {\n  set([\n    \"fn\",\n    \"type\",\n    \"trait\",\n    \"impl\",\n    \"for\",\n    \"in\",\n    \"if\",\n    \"else\",\n    \"match\",\n    \"while\",\n    \"loop\",\n    \"return\",\n    \"break\",\n    \"continue\",\n    \"mut\",\n    \"let\",\n    \"pub\",\n    \"use\",\n    \"from\",\n    \"test\",\n    \"assert\",\n    \"requires\",\n    \"ensures\",\n    \"where\",\n    \"it\",\n    \"self\",\n    \"Self\",\n    \"true\",\n    \"false\",\n    \"mock\",\n    \"distinct\",\n    \"derive\",\n    \"derivable\",\n    \"derived\",\n    \"comptime\",\n    \"or\",\n    \"except\",\n    \"invariant\",\n    \"law\",\n    \"as\",\n    \"is\",\n    \"scope\",\n    \"spawn\",\n    \"await\",\n    \"select\",\n    \"race\",\n    \"supervised\",\n    \"capability\",\n    \"extern\",\n    \"terminates\",\n    \"noalloc\",\n  ])\n}"}]}
{"id":"12fb8595a4e03b1f","time":1795667316,"message":"edit","changes":[{"name":"codegen.generate","kind":"fn","old":"94b63fa6749ff443","new":"9847a912df5c692d","interface_changed":false,"affected":[],"module":"codegen","text":"/// The program's `main` and what it calls as LLVM IR, or the constructs not\n/// compiled, each with its function. `assumed_clauses` also checks the\n/// assumed contract clauses (`--check-assumed`). Verify's fuzz drivers\n/// always check them.\npub fn generate(\n  given: List[ast.Decl],\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  proofs: List[String],\n  tests: Option[List[(String, String)]],\n  fuzz: List[String],\n  fuzz_text: Bool,\n  calls: List[String],\n  trace: Bool,\n  library: List[String],\n  precompiled: List[String],\n  bare: Bool,\n  copies: Option[Dict[String, String]],\n  memory_sites: Option[Dict[String, String]],\n  assumed_clauses: Bool,\n) -> Result[String, List[String]] {\n  // unused variables with no effect are not compiled (`unread_dropped`),\n  // and assumed contract clauses are left out (`assumed_compiled`)\n  keep := assumed_clauses || fuzz != []\n  // lemmas and proofs (`assert … by`, `calc`) are for `verify` alone: never\n  // compiled\n  (start, main) := match codegen.new_gen(\n    given\n      .filter(d -> !match d.kind {\n        ast.FnDef(f) => f.lemma,\n        _ => false,\n      })\n      .map(d -> walk.rewrite_decl(\n        codegen.assumed_compiled(d, keep),\n        x -> codegen.unread_dropped(codegen.proofs_dropped(x)),\n      )),\n    core,\n    prelude,\n    proofs,\n    tests,\n    fuzz,\n    fuzz_text,\n    calls,\n    trace,\n    library,\n    precompiled,\n  ) {\n    Ok(x) => x,\n    Err(es) => return Err(es),\n  }\n  // core.rt (`bare`): no call-stack frames, no cancel points\n  mut g := if bare {\n    codegen.Gen { ..start, bare: true, tasks: false, supervises: false }\n  } else {\n    start\n  }\n  // `--copies`: report copies with their locations\n  match copies {\n    Some(sites) => {\n      g.copies = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  // (`--memory-sites`: each counting operation counted, by site)\n  match memory_sites {\n    Some(sites) => {\n      g.memory_sites = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  mut bodies := match tests {\n    // each test as `strata test` runs it (`strata.test.N`), with its name\n    Some(ts) => enumerate(ts).map(x -> codegen.test_entry(x.0, x.1.0, x.1.1)),\n    None => if fuzz != [] || library != [] || calls != [] {\n      []\n    } else if main.name == \"\" {\n      // a library starts when it is loaded\n      [codegen.library_start(mut g)]\n    } else {\n      [codegen.entry(mut g, main)]\n    },\n  }\n  // std's library runs in any program, with tasks or without. It holds its\n  // functions by key and its `impl`s' methods (`library_methods`), except\n  // those `!KEY` excludes. Generic functions, those depending on the\n  // compile, and trait values are compiled per program instead.\n  mut roots := []\n  mut held := []\n  left_out := set(library\n    .filter(k -> starts_with(k, \"!\"))\n    .map(k -> byte_slice(k, 1, byte_len(k))))\n  mut wanted := library.filter(k -> !starts_with(k, \"!\"))\n  if library != [] {\n    wanted += codegen.library_methods(mut g).filter(\n      k -> !contains(left_out, k),\n    )\n  }\n  for k in wanted {\n    match codegen.fn_of(g, k) {\n      Some(f) => if codegen.precompilable(mut g, k, f) {\n        sym := codegen.instance(mut g, k, f, Dict[String, check.Ty] {})\n        mut roots.push(sym)\n        mut held.push(k)\n      },\n      None => (),\n    }\n  }\n  // verify's fuzz drivers (`strata.fuzz.N`)\n  for (i, k) in enumerate(fuzz) {\n    mut bodies.push(codegen.fuzz_driver(mut g, i, k))\n  }\n  // `strata run f ARGS` calls (`strata.call.N`). `session:KEY` is a\n  // `strata repl` line, with the session's arguments.\n  for (i, k) in enumerate(calls) {\n    mut bodies.push(\n      if starts_with(k, \"session:\") {\n        codegen.session_entry(\n          mut g,\n          i,\n          byte_slice(k, 8, byte_len(k)),\n        )\n      } else {\n        codegen.call_entry(mut g, i, k)\n      },\n    )\n  }\n  // the exports of `derive C for f`, each under its symbol\n  if fuzz == [] && library == [] && calls == [] && tests is None {\n    for (symbol, k) in codegen.exports_of(given) {\n      mut bodies.push(codegen.export_entry(mut g, symbol, k))\n    }\n  }\n  // the files they generate: the C header\n  parts := match codegen.file_parts(given) {\n    Ok(ps) => ps,\n    Err(e) => return Err([e]),\n  }\n  // Each reachable function instance, once, in rounds. The workers compile\n  // each function of a round alone from the state the round began with.\n  // Their additions are then merged in queue order, so the output does not\n  // depend on thread timing.\n  if len(g.queue) > 0 && g.keeps is None {\n    g.keeps = Some(codegen.kept_by(g.fns))\n  }\n  // the updates in place proven to find their value held once, for builds\n  // and tests (not for verify's fuzzing, `strata run f` and compile-time\n  // code, which run once). Only a program's build sees every call of its\n  // functions (`closed`).\n  if len(g.queue) > 0 && !bare && fuzz == [] && calls == [] {\n    closed := library == []\n      && tests is None\n      && main.name != \"\"\n      && codegen.exports_of(given) == []\n    g.proven = unique.proven_sites(\n      g.fns,\n      codegen.keeps_of(mut g),\n      closed,\n      g.distincts,\n      g.traits,\n    )\n  }\n  mut global_keys := set(g.globals.map(l -> codegen.global_key(l)))\n  mut def_keys := set(g.helper_defs.map(d -> codegen.def_key(d)))\n  while len(g.queue) > 0 {\n    round := g.queue\n    g.queue = []\n    base := g\n    for (body, d) in parallel.map(\n      round,\n      item -> codegen.compiled_alone(base, item.0, item.1, main),\n    ) {\n      mut bodies.push(body)\n      codegen.merge_alone(\n        mut g,\n        base,\n        d,\n        mut global_keys,\n        mut def_keys,\n      )\n    }\n  }\n  if len(g.errs) > 0 {\n    // std's library leaves out the functions that reach something not\n    // compiled\n    if library != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      out := wanted.filter(k -> contains(left, k))\n      if out != [] {\n        return Err(out.map(k -> \"leave out: \" + k))\n      }\n    }\n    // verify's fuzz drivers: each one reaching something not compiled is\n    // reported as `can't fuzz `KEY`: WHY`, so `verify` drops them all at\n    // once\n    if fuzz != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      callees := codegen.callees_of(g.callers)\n      return Err(g.errs\n        + fuzz\n          .filter(k -> contains(left, \"fuzz:\" + k))\n          .map(k -> \"can't fuzz `\"\n            + k\n            + \"`: \"\n            + join(\n              codegen.failures_of(callees, g.why, \"fuzz:\" + k),\n              \"; \",\n            )))\n    }\n    return Err(g.errs)\n  }\n  mut out := [\n    \"; Strata, compiled by compiler/codegen\",\n    f\"; checks left out {g.left_out}, kept {g.kept}\",\n    \"\",\n  ]\n  // std's library lists the functions it holds: `; precompiled NAME`\n  out += held.map(k -> \"; precompiled \" + k)\n  out += parts.map(p -> codegen.file_line(p.0, p.1))\n  // the symbols a library exports (`; export add`); the rest are hidden\n  out += if fuzz == [] && library == [] && calls == [] && tests is None {\n    codegen.exports_of(given).map(e -> \"; export \" + e.0)\n  } else {\n    []\n  }\n  out += g.globals\n  mut out.push(\"\")\n  // std's library exposes only its functions\n  out += if library != [] {\n    codegen.internal(bodies + g.helper_defs, set(roots))\n  } else {\n    bodies + g.helper_defs\n  }\n  for d in codegen.declarations() {\n    if contains(g.used, d.0) {\n      mut out.push(d.1)\n    }\n  }\n  ir_text := join(out, \"\\n\") + \"\\n\"\n  Ok(if g.memory_sites {\n    codegen.counted_sites(ir_text)\n  } else {\n    ir_text\n  })\n}","old_text":"/// The program's `main` and what it calls as LLVM IR, or the constructs not\n/// compiled, each with its function. `assumed_clauses` also checks the\n/// assumed contract clauses (`--check-assumed`). Verify's fuzz drivers\n/// always check them.\npub fn generate(\n  given: List[ast.Decl],\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  proofs: List[String],\n  tests: Option[List[(String, String)]],\n  fuzz: List[String],\n  fuzz_text: Bool,\n  calls: List[String],\n  trace: Bool,\n  library: List[String],\n  precompiled: List[String],\n  bare: Bool,\n  copies: Option[Dict[String, String]],\n  memory_sites: Option[Dict[String, String]],\n  assumed_clauses: Bool,\n) -> Result[String, List[String]] {\n  // unused variables with no effect are not compiled (`unread_dropped`),\n  // and assumed contract clauses are left out (`assumed_compiled`)\n  keep := assumed_clauses || fuzz != []\n  // lemmas and proofs (`assert … by`, `calc`) are for `verify` alone: never\n  // compiled\n  (start, main) := match codegen.new_gen(\n    given\n      .filter(d -> !match d.kind {\n        ast.FnDef(f) => f.lemma,\n        _ => false,\n      })\n      .map(d -> walk.rewrite_decl(\n        codegen.assumed_compiled(d, keep),\n        x -> codegen.unread_dropped(codegen.proofs_dropped(x)),\n      )),\n    core,\n    prelude,\n    proofs,\n    tests,\n    fuzz,\n    fuzz_text,\n    calls,\n    trace,\n    library,\n    precompiled,\n  ) {\n    Ok(x) => x,\n    Err(es) => return Err(es),\n  }\n  // core.rt (`bare`): no call-stack frames, no cancel points\n  mut g := if bare {\n    codegen.Gen { ..start, bare: true, tasks: false, supervises: false }\n  } else {\n    start\n  }\n  // `--copies`: report copies with their locations\n  match copies {\n    Some(sites) => {\n      g.copies = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  // (`--memory-sites`: each counting operation counted, by site)\n  match memory_sites {\n    Some(sites) => {\n      g.