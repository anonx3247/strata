n    },\n    \"done\" => {\n      code = done_command(\n        mut console,\n        mut disk,\n        mut launcher,\n        clock,\n        process.current_dir(),\n        rest,\n      )\n    },\n    \"abort\" => {\n      code = abort_command(mut console, mut disk, process.current_dir())\n    },\n    \"fix\" => {\n      code = fix_command(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        clock,\n        cache,\n        rest,\n      )\n    },\n    \"rename\" => {\n      code = rename_command(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        clock,\n        cache,\n        rest,\n      )\n    },\n    \"move\" => {\n      code = move_command(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        clock,\n        cache,\n        rest,\n      )\n    },\n    \"header\" => {\n      code = header_command(mut console, disk, rest)\n    },\n    \"interface\" => {\n      code = interface_command(mut console, mut disk, process, rest)\n    },\n    \"doc\" => {\n      code = doc_command(mut console, mut disk, process, rest)\n    },\n    \"docgen\" => {\n      code = docgen_command(mut console, mut disk, process, rest)\n    },\n    \"merge-file\" => {\n      code = merge_file_command(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        rest,\n      )\n    },\n    \"resolve\" => {\n      code = resolve_command(mut console, mut disk, process, rest)\n    },\n    \"setup-git\" => {\n      code = setup_git_command(\n        mut console,\n        mut launcher,\n        disk,\n        process.var(\"STRATA_EXE\") ?? cache.self_exe(),\n      )\n    },\n    \"diff\" => {\n      code = diff_command(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        cache,\n        rest,\n      )\n    },\n    \"pack\" => {\n      code = pack_command(mut console, mut disk, process, rest)\n    },\n    \"upgrade\" => {\n      code = upgrade_command(mut console, mut disk, mut launcher, process)\n    },\n    \"sync\" => {\n      code = sync_command(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        clock,\n        rest,\n      )\n    },\n    \"holes\" => {\n      code = holes_command(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        cache,\n        rest,\n      )\n    },\n    \"view\" => {\n      code = if contains(rest, \"--graph\") {\n        graph_command(\n          mut console,\n          mut disk,\n          process,\n          mut launcher,\n          cache,\n          rest,\n        )\n      } else {\n        view_command(mut console, mut disk, process, rest)\n      }\n    },\n    \"log\" => {\n      code = log_command(mut console, disk, process.current_dir(), rest)\n    },\n    \"object\" => {\n      code = object_command(mut console, mut disk, rest)\n    },\n    \"link\" => {\n      code = link_command(mut console, mut disk, rest)\n    },\n    \"--version\" | \"version\" => print(\"strata \" + version()),\n    \"update\" => update_deps(mut launcher, mut disk, cache, rest),\n    _ => print(\n      \"usage: strata --file compiler run -- (tree | same | hashes | text | bad | lex | parse) FILE... | check [--std DIR] [--with-deps] FILE... | (stored | stored-package | written | use-errors | eval) BASE... -- FILE... | builtins | codegen [--proofs FILE] FILE | smt [--std DIR] FILE | termination [--std DIR] FILE | fuzz [--cases N] [--seed S] FILE F,G | verify [--cases N] [--seed S] [--cross-check N] [--require R] [--checks] [--only SELECTION] [--quiet] FILE | proofs FILE | verdicts FILE | package [--std DIR] DIR | update DIR [NAME...]\",\n    ),\n  }\n  code\n}"},{"name":"merge.renames","kind":"fn","old":"9acf22d63bc3efcd","new":"e21f119c6a9988a0","interface_changed":false,"affected":[],"module":"merge","text":"/// Pairs each definition gone from `o` with one added in `s`: same kind and\n/// module, named as `o` renamed would be (or nearly), and referred to by\n/// its new name in the rest of `s`.\nfn renames(o: List[ast.Decl], s: List[ast.Decl]) -> List[(String, String)] {\n  on := set(o.map(d -> store.qname(d)))\n  sn := set(s.map(d -> store.qname(d)))\n  gone := o.filter(d -> merge.renamable(d) && !contains(sn, store.qname(d)))\n  mut added := s.filter(d -> merge.renamable(d) && !contains(on, store.qname(d)))\n  mut out := []\n  for x in gone {\n    mut best := None\n    for (i, y) in enumerate(added) {\n      if merge.kind_of(y) != merge.kind_of(x) || y.module != x.module {\n        continue\n      }\n      match refactor.rename_all(\n        o,\n        [(store.qname(x), refactor.short(store.qname(y)))],\n      ) {\n        Ok(r) => match r.find(d -> store.qname(d) == store.qname(y)) {\n          Some(ry) => {\n            sim := if merge.canon(ry) == merge.canon(y) {\n              2.0\n            } else {\n              merge.similarity(merge.canon(ry), merge.canon(y))\n            }\n            xn := refactor.short(store.qname(x))\n            yn := refactor.short(store.qname(y))\n            mut followed := false\n            for (k, od) in enumerate(o) {\n              rd := get(r, k) ?? od\n              if store.qname(od) != store.qname(x)\n                && merge.canon(od) != merge.canon(rd) {\n                match s.find(sd -> store.qname(sd) == store.qname(od)) {\n                  Some(sd) => {\n                    ws := merge.words_of(merge.canon(sd))\n                    if contains(ws, yn) && !contains(ws, xn) {\n                      followed = true\n                    }\n                  },\n                  None => (),\n                }\n              }\n            }\n            better := match best {\n              Some((bs, _)) => sim > bs,\n              None => true,\n            }\n            if (sim == 2.0 || sim >= 0.6 && followed) && better {\n              best = Some((sim, i))\n            }\n          },\n          None => (),\n        },\n        Err(_) => (),\n      }\n    }\n    match best {\n      Some((_, i)) => {\n        y := get(added, i) ?? x\n        mut out.push((store.qname(x), store.qname(y)))\n        added = [a for (k, a) in enumerate(added) where k != i]\n      },\n      None => (),\n    }\n  }\n  out\n}","old_text":"/// Pairs each definition gone from `o` with one added in `s`: same kind and\n/// module, named as `o` renamed would be (or nearly), and referred to by\n/// its new name in the rest of `s`.\nfn renames(o: List[ast.Decl], s: List[ast.Decl]) -> List[(String, String)] {\n  on := set(o.map(d -> store.qname(d)))\n  sn := set(s.map(d -> store.qname(d)))\n  gone := o.filter(d -> merge.renamable(d) && !contains(sn, store.qname(d)))\n  mut added := s.filter(d -> merge.renamable(d) && !contains(on, store.qname(d)))\n  mut out := []\n  for x in gone {\n    mut best := None\n    for (i, y) in enumerate(added) {\n      if merge.kind_of(y) != merge.kind_of(x) || y.module != x.module {\n        continue\n      }\n      match refactor.rename_all(\n        o,\n        [(store.qname(x), refactor.short(store.qname(y)))],\n        Set[String] {},\n      ) {\n        Ok(r) => match r.find(d -> store.qname(d) == store.qname(y)) {\n          Some(ry) => {\n            sim := if merge.canon(ry) == merge.canon(y) {\n              2.0\n            } else {\n              merge.similarity(merge.canon(ry), merge.canon(y))\n            }\n            xn := refactor.short(store.qname(x))\n            yn := refactor.short(store.qname(y))\n            mut followed := false\n            for (k, od) in enumerate(o) {\n              rd := get(r, k) ?? od\n              if store.qname(od) != store.qname(x)\n                && merge.canon(od) != merge.canon(rd) {\n                match s.find(sd -> store.qname(sd) == store.qname(od)) {\n                  Some(sd) => {\n                    ws := merge.words_of(merge.canon(sd))\n                    if contains(ws, yn) && !contains(ws, xn) {\n                      followed = true\n                    }\n                  },\n                  None => (),\n                }\n              }\n            }\n            better := match best {\n              Some((bs, _)) => sim > bs,\n              None => true,\n            }\n            if (sim == 2.0 || sim >= 0.6 && followed) && better {\n              best = Some((sim, i))\n            }\n          },\n          None => (),\n        },\n        Err(_) => (),\n      }\n    }\n    match best {\n      Some((_, i)) => {\n        y := get(added, i) ?? x\n        mut out.push((store.qname(x), store.qname(y)))\n        added = [a for (k, a) in enumerate(added) where k != i]\n      },\n      None => (),\n    }\n  }\n  out\n}"},{"name":"merge.merge","kind":"fn","old":"253cb567979a7274","new":"7945c978efeddc2f","interface_changed":false,"affected":[],"module":"merge","text":"/// `base`, `ours` and `theirs` are module texts.\npub fn merge[F: std.fs.Files, C: std.process.Commands](\n  mut files: F,\n  mut run: C,\n  tmp: String,\n  base: String,\n  ours: String,\n  theirs: String,\n) -> Result[merge.Merged, String] {\n  mut o := match parse.parse_module(base, \"\") {\n    Ok(ds) => ds,\n    Err(e) => return Err(f\"base doesn't parse ({e})\"),\n  }\n  mut a := match parse.parse_module(ours, \"\") {\n    Ok(ds) => ds,\n    Err(e) => return Err(f\"ours doesn't parse ({e})\"),\n  }\n  mut b := match parse.parse_module(theirs, \"\") {\n    Ok(ds) => ds,\n    Err(e) => return Err(f\"theirs doesn't parse ({e})\"),\n  }\n  mut notes := []\n  mut conflicts := []\n  ra := merge.renames(o, a)\n  rb := merge.renames(o, b)\n  for (from, to) in ra {\n    mut skip := false\n    match rb.find(r -> r.0 == from) {\n      Some((_, t)) => if t == to {\n        mut notes.push(f\"both sides renamed {from} → {to}\")\n      } else {\n        mut conflicts.push(\n          f\"{from} (renamed to {to} in ours, {t} in theirs)\",\n        )\n        skip = true\n      },\n      None => (),\n    }\n    if skip {\n      continue\n    }\n    o = refactor.rename_all(o, [(from, refactor.short(to))]) !! o\n    if b.any(d -> store.qname(d) == from) {\n      match refactor.rename_all(b, [(from, refactor.short(to))]) {\n        Ok(r) => {\n          b = r\n          mut notes.push(\n            f\"ours renamed {from} → {to}; applied to theirs\",\n          )\n        },\n        Err(e) => mut notes.push(\n          f\"ours renamed {from} → {to}, but theirs can't follow it: {e}\",\n        ),\n      }\n    }\n  }\n  for (from, to) in rb {\n    if ra.any(r -> r.0 == from) {\n      continue\n    }\n    o = refactor.rename_all(o, [(from, refactor.short(to))]) !! o\n    if a.any(d -> store.qname(d) == from) {\n      match refactor.rename_all(a, [(from, refactor.short(to))]) {\n        Ok(r) => {\n          a = r\n          mut notes.push(\n            f\"theirs renamed {from} → {to}; applied to ours\",\n          )\n        },\n        Err(e) => mut notes.push(\n          f\"theirs renamed {from} → {to}, but ours can't follow it: {e}\",\n        ),\n      }\n    }\n  }\n  // ours' order, with each of theirs' new ones after its predecessor\n  mut order := a.map(d -> merge.key(d))\n  for (i, d) in enumerate(b) {\n    q := merge.key(d)\n    if contains(order, q) {\n      continue\n    }\n    mut at := 0\n    mut k := i - 1\n    while k >= 0 {\n      pq := merge.key(get(b, k) ?? d)\n      match [j for (j, n) in enumerate(order) where n == pq] {\n        [j, ..] => {\n          at = j + 1\n          k = -1\n        },\n        [] => {\n          k -= 1\n        },\n      }\n    }\n    order = [n for (j, n) in enumerate(order) where j < at]\n      + [q]\n      + [n for (j, n) in enumerate(order) where j >= at]\n  }\n  find := (ds: List[ast.Decl], q: String) -> ds.find(d -> merge.key(d) == q)\n  mut pieces := []\n  mut from_theirs := 0\n  mut by_line := 0\n  nl := (t: String) -> if t == \"\" {\n    t\n  } else {\n    t + \"\\n\"\n  }\n  for q in order {\n    od := find(o, q)\n    ad := find(a, q)\n    bd := find(b, q)\n    match (od, ad, bd) {\n      (_, Some(x), Some(y)) => if merge.canon(x) == merge.canon(y) {\n        mut pieces.push(merge.Merged_decl(x))\n      } else if od is Some && merge.canon(od ?? x) == merge.canon(x) {\n        from_theirs += 1\n        mut pieces.push(merge.Merged_decl(y))\n      } else if od is Some && merge.canon(od ?? y) == merge.canon(y) {\n        mut pieces.push(merge.Merged_decl(x))\n      } else {\n        ot := match od {\n          Some(z) => merge.canon(z),\n          None => \"\",\n        }\n        (text, clean) := merge.line_merge(\n          mut files,\n          mut run,\n          tmp,\n          nl(ot),\n          nl(merge.canon(x)),\n          nl(merge.canon(y)),\n        )!\n        mut done := false\n        if clean {\n          match parse.parse_module(text, \"\") {\n            Ok([d]) => if merge.decl_name_of(d) == merge.decl_name_of(x) {\n              by_line += 1\n              mut pieces.push(\n                merge.Merged_decl(\n                  ast.Decl { ..d, module: x.module, public: d.public || x.public && y.public },\n                ),\n              )\n              done = true\n            },\n            _ => (),\n          }\n        }\n        if !done {\n          mut conflicts.push(q)\n          mut pieces.push(merge.Merged_text(merge.trim_end(text)))\n        }\n      },\n      (Some(z), Some(x), None) => if merge.canon(z) != merge.canon(x) {\n        mut conflicts.push(f\"{q} (changed in ours, deleted in theirs)\")\n        mut pieces.push(\n          merge.Merged_text(\n            f\"<<<<<<< ours\\n{nl(merge.canon(x))}||||||| base\\n{nl(merge.canon(z))}=======\\n>>>>>>> theirs (deleted)\",\n          ),\n        )\n      },\n      (Some(z), None, Some(y)) => if merge.canon(z) != merge.canon(y) {\n        mut conflicts.push(f\"{q} (deleted in ours, changed in theirs)\")\n        mut pieces.push(\n          merge.Merged_text(\n            f\"<<<<<<< ours (deleted)\\n||||||| base\\n{nl(merge.canon(z))}=======\\n{nl(merge.canon(y))}>>>>>>> theirs\",\n          ),\n        )\n      },\n      (None, Some(x), None) => mut pieces.push(merge.Merged_decl(x)),\n      (None, None, Some(y)) => {\n        from_theirs += 1\n        mut pieces.push(merge.Merged_decl(y))\n      },\n      _ => (),\n    }\n  }\n  if from_theirs > 0 {\n    mut notes.push(\n      f\"{from_theirs} definition{if from_theirs == 1 {\n  \"\"\n} else {\n  \"s\"\n}} from theirs\",\n    )\n  }\n  if by_line > 0 {\n    mut notes.push(\n      f\"{by_line} definition{if by_line == 1 {\n  \"\"\n} else {\n  \"s\"\n}} changed on both sides, merged line by line\",\n    )\n  }\n  out := pieces.map(\n    p -> match p {\n      merge.Merged_decl(d) => merge.canon(d),\n      merge.Merged_text(t) => t,\n    },\n  )\n  Ok(merge.Merged { text: if len(out) == 0 {\n    \"\"\n  } else {\n    join(out, \"\\n\\n\") + \"\\n\"\n  }, conflicts, notes })\n}","old_text":"/// `base`, `ours` and `theirs` are module texts.\npub fn merge[F: std.fs.Files, C: std.process.Commands](\n  mut files: F,\n  mut run: C,\n  tmp: String,\n  base: String,\n  ours: String,\n  theirs: String,\n) -> Result[merge.Merged, String] {\n  mut o := match parse.parse_module(base, \"\") {\n    Ok(ds) => ds,\n    Err(e) => return Err(f\"base doesn't parse ({e})\"),\n  }\n  mut a := match parse.parse_module(ours, \"\") {\n    Ok(ds) => ds,\n    Err(e) => return Err(f\"ours doesn't parse ({e})\"),\n  }\n  mut b := match parse.parse_module(theirs, \"\") {\n    Ok(ds) => ds,\n    Err(e) => return Err(f\"theirs doesn't parse ({e})\"),\n  }\n  mut notes := []\n  mut conflicts := []\n  ra := merge.renames(o, a)\n  rb := merge.renames(o, b)\n  for (from, to) in ra {\n    mut skip := false\n    match rb.find(r -> r.0 == from) {\n      Some((_, t)) => if t == to {\n        mut notes.push(f\"both sides renamed {from} → {to}\")\n      } else {\n        mut conflicts.push(\n          f\"{from} (renamed to {to} in ours, {t} in theirs)\",\n        )\n        skip = true\n      },\n      None => (),\n    }\n    if skip {\n      continue\n    }\n    o = refactor.rename_all(\n      o,\n      [(from, refactor.short(to))],\n      Set[String] {},\n    ) !! o\n    if b.any(d -> store.qname(d) == from) {\n      match refactor.rename_all(\n        b,\n        [(from, refactor.short(to))],\n        Set[String] {},\n      ) {\n        Ok(r) => {\n          b = r\n          mut notes.push(\n            f\"ours renamed {from} → {to}; applied to theirs\",\n          )\n        },\n        Err(e) => mut notes.push(\n          f\"ours renamed {from} → {to}, but theirs can't follow it: {e}\",\n        ),\n      }\n    }\n  }\n  for (from, to) in rb {\n    if ra.any(r -> r.0 == from) {\n      continue\n    }\n    o = refactor.rename_all(\n      o,\n      [(from, refactor.short(to))],\n      Set[String] {},\n    ) !! o\n    if a.any(d -> store.qname(d) == from) {\n      match refactor.rename_all(\n        a,\n        [(from, refactor.short(to))],\n        Set[String] {},\n      ) {\n        Ok(r) => {\n          a = r\n          mut notes.push(\n            f\"theirs renamed {from} → {to}; applied to ours\",\n          )\n        },\n        Err(e) => mut notes.push(\n          f\"theirs renamed {from} → {to}, but ours can't follow it: {e}\",\n        ),\n      }\n    }\n  }\n  // ours' order, with each of theirs' new ones after its predecessor\n  mut order := a.map(d -> merge.key(d))\n  for (i, d) in enumerate(b) {\n    q := merge.key(d)\n    if contains(order, q) {\n      continue\n    }\n    mut at := 0\n    mut k := i - 1\n    while k >= 0 {\n      pq := merge.key(get(b, k) ?? d)\n      match [j for (j, n) in enumerate(order) where n == pq] {\n        [j, ..] => {\n          at = j + 1\n          k = -1\n        },\n        [] => {\n          k -= 1\n        },\n      }\n    }\n    order = [n for (j, n) in enumerate(order) where j < at]\n      + [q]\n      + [n for (j, n) in enumerate(order) where j >= at]\n  }\n  find := (ds: List[ast.Decl], q: String) -> ds.find(d -> merge.key(d) == q)\n  mut pieces := []\n  mut from_theirs := 0\n  mut by_line := 0\n  nl := (t: String) -> if t == \"\" {\n    t\n  } else {\n    t + \"\\n\"\n  }\n  for q in order {\n    od := find(o, q)\n    ad := find(a, q)\n    bd := find(b, q)\n    match (od, ad, bd) {\n      (_, Some(x), Some(y)) => if merge.canon(x) == merge.canon(y) {\n        mut pieces.push(merge.Merged_decl(x))\n      } else if od is Some && merge.canon(od ?? x) == merge.canon(x) {\n        from_theirs += 1\n        mut pieces.push(merge.Merged_decl(y))\n      } else if od is Some && merge.canon(od ?? y) == merge.canon(y) {\n        mut pieces.push(merge.Merged_decl(x))\n      } else {\n        ot := match od {\n          Some(z) => merge.canon(z),\n          None => \"\",\n        }\n        (text, clean) := merge.line_merge(\n          mut files,\n          mut run,\n          tmp,\n          nl(ot),\n          nl(merge.canon(x)),\n          nl(merge.canon(y)),\n        )!\n        mut done := false\n        if clean {\n          match parse.parse_module(text, \"\") {\n            Ok([d]) => if merge.decl_name_of(d) == merge.decl_name_of(x) {\n              by_line += 1\n              mut pieces.push(\n                merge.Merged_decl(\n                  ast.Decl { ..d, module: x.module, public: d.public || x.public && y.public },\n                ),\n              )\n              done = true\n            },\n            _ => (),\n          }\n        }\n        if !done {\n          mut conflicts.push(q)\n          mut pieces.push(merge.Merged_text(merge.trim_end(text)))\n        }\n      },\n      (Some(z), Some(x), None) => if merge.canon(z) != merge.canon(x) {\n        mut conflicts.push(f\"{q} (changed in ours, deleted in theirs)\")\n        mut pieces.push(\n          merge.Merged_text(\n            f\"<<<<<<< ours\\n{nl(merge.canon(x))}||||||| base\\n{nl(merge.canon(z))}=======\\n>>>>>>> theirs (deleted)\",\n          ),\n        )\n      },\n      (Some(z), None, Some(y)) => if merge.canon(z) != merge.canon(y) {\n        mut conflicts.push(f\"{q} (deleted in ours, changed in theirs)\")\n        mut pieces.push(\n          merge.Merged_text(\n            f\"<<<<<<< ours (deleted)\\n||||||| base\\n{nl(merge.canon(z))}=======\\n{nl(merge.canon(y))}>>>>>>> theirs\",\n          ),\n        )\n      },\n      (None, Some(x), None) => mut pieces.push(merge.Merged_decl(x)),\n      (None, None, Some(y)) => {\n        from_theirs += 1\n        mut pieces.push(merge.Merged_decl(y))\n      },\n      _ => (),\n    }\n  }\n  if from_theirs > 0 {\n    mut notes.push(\n      f\"{from_theirs} definition{if from_theirs == 1 {\n  \"\"\n} else {\n  \"s\"\n}} from theirs\",\n    )\n  }\n  if by_line > 0 {\n    mut notes.push(\n      f\"{by_line} definition{if by_line == 1 {\n  \"\"\n} else {\n  \"s\"\n}} changed on both sides, merged line by line\",\n    )\n  }\n  out := pieces.map(\n    p -> match p {\n      merge.Merged_decl(d) => merge.canon(d),\n      merge.Merged_text(t) => t,\n    },\n  )\n  Ok(merge.Merged { text: if len(out) == 0 {\n    \"\"\n  } else {\n    join(out, \"\\n\\n\") + \"\\n\"\n  }, conflicts, notes })\n}"},{"name":"merge.follow_rename","kind":"fn","old":"4e5ad12e589722e2","new":"c3faf2e7a193148a","interface_changed":false,"affected":[],"module":"merge","text":"/// Follows a rename (`from` to `to`) made by one side, for the references\n/// the merge left to the old name. The renamed definition is put back under\n/// its old name and renamed again, which renames every reference, the other\n/// side's new ones included. A move (same short name, another module) is\n/// followed the same way. `None` when there is nothing to follow.\npub fn follow_rename(\n  ds: List[ast.Decl],\n  from: String,\n  to: String,\n  std: List[ast.Decl],\n  core: builtins.Core,\n) -> Option[List[ast.Decl]] {\n  if refactor.short(from) == refactor.short(to) && from != to {\n    return merge.follow_move(ds, from, to, std, core)\n  }\n  // the old name is defined again (the other side kept or re-added it)\n  if refactor.member(ds, from) is Some\n    || refactor.member(ds, to) is None {\n    return None\n  }\n  old_short := refactor.short(from)\n  new_short := refactor.short(to)\n  module := refactor.module_of(to)\n  // `use` lists that name the new name (the renaming side's, kept by the\n  // merge) name the old one again, so the other side's references resolve\n  back := merge.set_member_name(ds, to, old_short).map(\n    d ->\n      match d.kind {\n        ast.UseDef(u) => if u.path == module {\n          ast.Decl { ..d, kind: ast.UseDef(ast.UseDecl { ..u, items: match u.items {\n            Some(items) => Some(items.map(\n              it -> if it.name == new_short {\n                ast.UseItem { ..it, name: old_short }\n              } else {\n                it\n              },\n            )),\n            None => None,\n          } }) }\n        } else {\n          d\n        },\n        _ => d,\n      },\n  )\n  r := match refactor.rename_all(back, [(from, new_short)]) {\n    Ok(x) => x,\n    Err(_) => return None,\n  }\n  if zip(r, ds).any(p -> merge.canon(p.0) != merge.canon(p.1)) {\n    Some(r)\n  } else {\n    None\n  }\n}","old_text":"/// Follows a rename (`from` to `to`) made by one side, for the references\n/// the merge left to the old name. The renamed definition is put back under\n/// its old name and renamed again, which renames every reference, the other\n/// side's new ones included. A move (same short name, another module) is\n/// followed the same way. `None` when there is nothing to follow.\npub fn follow_rename(\n  ds: List[ast.Decl],\n  from: String,\n  to: String,\n  std: List[ast.Decl],\n  core: builtins.Core,\n) -> Option[List[ast.Decl]] {\n  if refactor.short(from) == refactor.short(to) && from != to {\n    return merge.follow_move(ds, from, to, std, core)\n  }\n  // the old name is defined again (the other side kept or re-added it)\n  if refactor.member(ds, from) is Some\n    || refactor.member(ds, to) is None {\n    return None\n  }\n  old_short := refactor.short(from)\n  new_short := refactor.short(to)\n  module := refactor.module_of(to)\n  // `use` lists that name the new name (the renaming side's, kept by the\n  // merge) name the old one again, so the other side's references resolve\n  back := merge.set_member_name(ds, to, old_short).map(\n    d ->\n      match d.kind {\n        ast.UseDef(u) => if u.path == module {\n          ast.Decl { ..d, kind: ast.UseDef(ast.UseDecl { ..u, items: match u.items {\n            Some(items) => Some(items.map(\n              it -> if it.name == new_short {\n                ast.UseItem { ..it, name: old_short }\n              } else {\n                it\n              },\n            )),\n            None => None,\n          } }) }\n        } else {\n          d\n        },\n        _ => d,\n      },\n  )\n  r := match refactor.rename_all(back, [(from, new_short)], Set[String] {}) {\n    Ok(x) => x,\n    Err(_) => return None,\n  }\n  if zip(r, ds).any(p -> merge.canon(p.0) != merge.canon(p.1)) {\n    Some(r)\n  } else {\n    None\n  }\n}"},{"name":"refactor.rename_all","kind":"fn","old":"517e2490271a3c16","new":"d7f3cb15bd485d6b","interface_changed":true,"affected":["diff.diff","rename_command","merge.renames","merge.merge","merge.follow_rename","diff.range_text","diff.range_diff","command_line","merge_file_command","follow_renames","diff_command","main","sync_command","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","move_command","fix_command","edit_in_editor"],"module":"refactor","text":"/// Applied one after the other. Each `old` is qualified.\npub fn rename_all(\n  ds: List[ast.Decl],\n  pairs: List[(String, String)],\n) -> Result[List[ast.Decl], String] {\n  // a field read from a union of records (`field#A,B`, tagged by\n  // `mark_field_reads`): every record's field gets the same new name\n  new_of := (q: String) -> pairs.find(p -> p.0 == q)\n  for d in ds {\n    for (f, owners) in refactor.field_reads(d) {\n      renamed := owners.filter(o -> new_of(o + \".\" + f) is Some)\n      if renamed != [] && len(owners) > 1 {\n        match owners.find(o -> new_of(o + \".\" + f) is None) {\n          Some(other) => return Err(\n            f\"in `{store.qname(d)}`, `.{f}` is read from a union that also has `{refactor.short(other)}.{f}` (rename it too, in the same command)\",\n          ),\n          None => (),\n        }\n        if len(\n          set(renamed.map(o -> (new_of(o + \".\" + f) ?? (\"\", \"\")).1)),\n        ) > 1 {\n          return Err(\n            f\"`.{f}` is read from a union whose records would get different names\",\n          )\n        }\n      }\n    }\n  }\n  mut out := ds\n  for (old, new) in pairs {\n    out = refactor.rename_one(out, old, new)!\n  }\n  // (the tags off)\n  Ok(\n    out.map(\n      d ->\n        walk.rewrite_decl(\n          d,\n          e ->\n            match e {\n              ast.FieldOf { base, name } => ast.FieldOf { base, name: refactor.untagged(name) },\n              _ => e,\n            },\n        ),\n    ),\n  )\n}","old_text":"/// Applied one after the other. Each `old` is qualified.\npub fn rename_all(\n  ds: List[ast.Decl],\n  pairs: List[(String, String)],\n  builtins: Set[String],\n) -> Result[List[ast.Decl], String] {\n  // a field read from a union of records (`field#A,B`, tagged by\n  // `mark_field_reads`): every record's field gets the same new name\n  new_of := (q: String) -> pairs.find(p -> p.0 == q)\n  for d in ds {\n    for (f, owners) in refactor.field_reads(d) {\n      renamed := owners.filter(o -> new_of(o + \".\" + f) is Some)\n      if renamed != [] && len(owners) > 1 {\n        match owners.find(o -> new_of(o + \".\" + f) is None) {\n          Some(other) => return Err(\n            f\"in `{store.qname(d)}`, `.{f}` is read from a union that also has `{refactor.short(other)}.{f}` (rename it too, in the same command)\",\n          ),\n          None => (),\n        }\n        if len(\n          set(renamed.map(o -> (new_of(o + \".\" + f) ?? (\"\", \"\")).1)),\n        ) > 1 {\n          return Err(\n            f\"`.{f}` is read from a union whose records would get different names\",\n          )\n        }\n      }\n    }\n  }\n  mut out := ds\n  for (old, new) in pairs {\n    out = refactor.rename_one(out, old, new)!\n  }\n  // (the tags off)\n  Ok(\n    out.map(\n      d ->\n        walk.rewrite_decl(\n          d,\n          e ->\n            match e {\n              ast.FieldOf { base, name } => ast.FieldOf { base, name: refactor.untagged(name) },\n              _ => e,\n            },\n        ),\n    ),\n  )\n}"}]}
{"id":"a435e7472a04edef","time":1795657636,"message":"edit","changes":[{"name":"resolve.union_members","kind":"fn","old":"50daac425eaa846d","new":"0319b0754192214b","interface_changed":false,"affected":[],"module":"resolve","text":"/// Resolves a union's bare members (`Dot` in `type Shape = Circle | Dot`).\n/// A member is the type of that name when one is in scope: defined earlier\n/// in the module or the root module, or imported. Otherwise the union\n/// declares it. Outside core, a member written with a payload and named like\n/// a prelude type or variant is that type, the payload its arguments\n/// (`Some(Int)` is `Some[Int]`). A union whose members are all such types is\n/// an alias of\n/// their union.\nfn union_members(decls: List[ast.Decl], core: builtins.Core) -> List[ast.Decl] {\n  if !decls.any(\n    d -> match d.kind {\n      ast.TypeDef(t) => resolve.is_bare(t, core),\n      _ => false,\n    },\n  ) {\n    return decls\n  }\n  mut defined := Dict[String, List[resolve.Defined]] {}\n  mut publics := Dict[String, Set[String]] {}\n  for (k, d) in enumerate(decls) {\n    mut names: List[(String, Bool)] = []\n    owner := match d.kind {\n      ast.TypeDef(t) => {\n        mut names.push((t.name, true))\n        match t.body {\n          ast.SumBody(vs) => {\n            for v in vs {\n              match v.payload {\n                ast.MemberType(_) => (),\n                ast.NoPayload => mut names.push((v.name, false)),\n                _ => mut names.push((v.name, true)),\n              }\n            }\n          },\n          _ => (),\n        }\n        resolve.last_part(t.name)\n      },\n      ast.ExternDef(ast.ExternDecl { item: ast.ExternType(x, _), .. }) => {\n        mut names.push((x, true))\n        \"\"\n      },\n      _ => \"\",\n    }\n    for nb in names {\n      mut defined.insert(\n        d.module,\n        (get(defined, d.module) ?? [])\n          + [resolve.Defined {\n            at: k,\n            name: resolve.last_part(nb.0),\n            always: nb.1,\n            owner,\n          }],\n      )\n      if d.public {\n        mut publics.insert(\n          d.module,\n          {\n            mut copy := get(publics, d.module) ?? Set[String] {}\n            mut copy.insert(resolve.last_part(nb.0))\n            copy\n          },\n        )\n      }\n    }\n  }\n  known := set(core.types_and_variants\n    + [\"Int\", \"Float\", \"Bool\", \"String\", \"List\", \"Set\", \"Dict\"])\n  root := get(defined, \"\") ?? []\n  mut out := []\n  for (k, d) in enumerate(decls) {\n    tb := match d.kind {\n      ast.TypeDef(t) => if resolve.is_bare(t, core) {\n        Some(t)\n      } else {\n        None\n      },\n      _ => None,\n    }\n    if tb is None {\n      mut out.push(d)\n      continue\n    }\n    t := tb or {\n      ast.TypeDecl {\n        distinct: false,\n        name: \"\",\n        params: [],\n        body: ast.Alias(ast.UnitType),\n        refinement: None,\n        mocked: false,\n      }\n    }\n    m := d.module\n    own := resolve.last_part(t.name)\n    seen := (ds: List[resolve.Defined], n: String) -> ds.any(\n      x -> x.name == n\n        && x.at != k\n        && x.owner != own\n        && (x.always || x.at < k),\n    )\n    imported := (n: String) ->\n      decls.any(\n        u ->\n          u.module == m\n            && match u.kind {\n              ast.UseDef(use_) => (use_.items ?? []).any(i -> i.alias ?? i.name == n),\n              _ => false,\n            },\n      )\n    in_scope := (n: String) -> contains(known, n)\n      || seen(get(defined, m) ?? [], n)\n      || m != \"\" && seen(root, n)\n      || imported(n)\n    vs := match t.body {\n      ast.SumBody(vs) => vs,\n      _ => [],\n    }\n    refs := vs.map(\n      v -> v.name != t.name\n        && match v.payload {\n          ast.NoPayload => contains(t.params, v.name) || in_scope(v.name),\n          ast.MemberType(_) => false,\n          // `Some(Int)`: the prelude's `Some[Int]`, outside core, which\n          // declares it\n          ast.Positional(_) => !starts_with(m, \"core.\")\n            && contains(core.types_and_variants, v.name),\n          _ => false,\n        },\n    )\n    if !refs.any(r -> r) {\n      mut out.push(d)\n      continue\n    }\n    members := [if r.1 {\n      ast.Variant { ..r.0, payload: ast.MemberType(\n        ast.Named { name: r.0.name, args: match r.0.payload {\n          ast.Positional(ts) => ts,\n          _ => [],\n        } },\n      ) }\n    } else {\n      r.0\n    } for r in zip(vs, refs)]\n    body := if members.all(v -> v.payload is ast.MemberType) {\n      ts := members.map(\n        v -> match v.payload {\n          ast.MemberType(x) => x,\n          _ => ast.UnitType,\n        },\n      )\n      ast.Alias(match ts {\n        [one] => one,\n        _ => ast.UnionType(ts),\n      })\n    } else {\n      ast.SumBody(members)\n    }\n    mut out.push(\n      ast.Decl { ..d, kind: ast.TypeDef(ast.TypeDecl { ..t, body }) },\n    )\n  }\n  out\n}","old_text":"/// Resolves a union's bare members (`Dot` in `type Shape = Circle | Dot`).\n/// A member is the type of that name when one is in scope: defined earlier\n/// in the module or the root module, or imported. Otherwise the union\n/// declares it. A union whose members are all such types is an alias of\n/// their union.\nfn union_members(decls: List[ast.Decl], core: builtins.Core) -> List[ast.Decl] {\n  if !decls.any(\n    d -> match d.kind {\n      ast.TypeDef(t) => resolve.is_bare(t, core),\n      _ => false,\n    },\n  ) {\n    return decls\n  }\n  mut defined := Dict[String, List[resolve.Defined]] {}\n  mut publics := Dict[String, Set[String]] {}\n  for (k, d) in enumerate(decls) {\n    mut names: List[(String, Bool)] = []\n    owner := match d.kind {\n      ast.TypeDef(t) => {\n        mut names.push((t.name, true))\n        match t.body {\n          ast.SumBody(vs) => {\n            for v in vs {\n              match v.payload {\n                ast.MemberType(_) => (),\n                ast.NoPayload => mut names.push((v.name, false)),\n                _ => mut names.push((v.name, true)),\n              }\n            }\n          },\n          _ => (),\n        }\n        resolve.last_part(t.name)\n      },\n      ast.ExternDef(ast.ExternDecl { item: ast.ExternType(x, _), .. }) => {\n        mut names.push((x, true))\n        \"\"\n      },\n      _ => \"\",\n    }\n    for nb in names {\n      mut defined.insert(\n        d.module,\n        (get(defined, d.module) ?? [])\n          + [resolve.Defined {\n            at: k,\n            name: resolve.last_part(nb.0),\n            always: nb.1,\n            owner,\n          }],\n      )\n      if d.public {\n        mut publics.insert(\n          d.module,\n          {\n            mut copy := get(publics, d.module) ?? Set[String] {}\n            mut copy.insert(resolve.last_part(nb.0))\n            copy\n          },\n        )\n      }\n    }\n  }\n  known := set(core.types_and_variants\n    + [\"Int\", \"Float\", \"Bool\", \"String\", \"List\", \"Set\", \"Dict\"])\n  root := get(defined, \"\") ?? []\n  mut out := []\n  for (k, d) in enumerate(decls) {\n    tb := match d.kind {\n      ast.TypeDef(t) => if resolve.is_bare(t, core) {\n        Some(t)\n      } else {\n        None\n      },\n      _ => None,\n    }\n    if tb is None {\n      mut out.push(d)\n      continue\n    }\n    t := tb or {\n      ast.TypeDecl {\n        distinct: false,\n        name: \"\",\n        params: [],\n        body: ast.Alias(ast.UnitType),\n        refinement: None,\n        mocked: false,\n      }\n    }\n    m := d.module\n    own := resolve.last_part(t.name)\n    seen := (ds: List[resolve.Defined], n: String) -> ds.any(\n      x -> x.name == n\n        && x.at != k\n        && x.owner != own\n        && (x.always || x.at < k),\n    )\n    imported := (n: String) ->\n      decls.any(\n        u ->\n          u.module == m\n            && match u.kind {\n              ast.UseDef(use_) => (use_.items ?? []).any(i -> i.alias ?? i.name == n),\n              _ => false,\n            },\n      )\n    in_scope := (n: String) -> contains(known, n)\n      || seen(get(defined, m) ?? [], n)\n      || m != \"\" && seen(root, n)\n      || imported(n)\n    vs := match t.body {\n      ast.SumBody(vs) => vs,\n      _ => [],\n    }\n    refs := vs.map(\n      v -> v.name != t.name\n        && match v.payload {\n          ast.NoPayload => contains(t.params, v.name) || in_scope(v.name),\n          ast.MemberType(_) => false,\n          _ => contains(core.types_and_variants, v.name),\n        },\n    )\n    if !refs.any(r -> r) {\n      mut out.push(d)\n      continue\n    }\n    members := [if r.1 {\n      ast.Variant { ..r.0, payload: ast.MemberType(ast.Named { name: r.0.name, args: [] }) }\n    } else {\n      r.0\n    } for r in zip(vs, refs)]\n    body := if members.all(v -> v.payload is ast.MemberType) {\n      ts := members.map(\n        v -> match v.payload {\n          ast.MemberType(x) => x,\n          _ => ast.UnitType,\n        },\n      )\n      ast.Alias(match ts {\n        [one] => one,\n        _ => ast.UnionType(ts),\n      })\n    } else {\n      ast.SumBody(members)\n    }\n    mut out.push(\n      ast.Decl { ..d, kind: ast.TypeDef(ast.TypeDecl { ..t, body }) },\n    )\n  }\n  out\n}"}]}
{"id":"734f7009efc297b3","time":1795657757,"message":"edit","changes":[{"name":"derive.pairs","kind":"fn","old":"30243ecc5afffad2","new":"7dfef7c8bd105e9a","interface_changed":false,"affected":[],"module":"derive","text":"fn pairs(\n  names: List[String],\n  ts: List[ast.TypeExpr],\n) -> Dict[String, ast.TypeExpr] {\n  mut out := Dict[String, ast.TypeExpr] {}\n  for (n, t) in zip(names, ts) {\n    mut out.insert(n, t)\n  }\n  out\n}","old_text":"fn pairs(\n  names: List[String],\n  ts: List[ast.TypeExpr],\n) -> Dict[String, ast.TypeExpr] {\n  mut out := Dict[String, ast.TypeExpr] {}\n  for (n, t) in zip(names, ts) {\n    mut out.insert(n, t)\n  }\n  out\n}"},{"name":"derive.remember","kind":"fn","old":"3c2e79a9ff48828b","new":"788a1133376e0fd3","interface_changed":false,"affected":[],"module":"derive","text":"fn remember(mut x: derive.Expander, v: ast.Expr, t: ast.TypeExpr) {\n  mut x.written.insert(derive.key(v), t)\n}","old_text":"fn remember(mut x: derive.Expander, v: ast.Expr, t: ast.TypeExpr) {\n  mut x.written.insert(derive.key(v), t)\n}"}]}
{"id":"abea8a8d9c2b79f2","time":1795657766,"message":"edit","changes":[{"name":"diff.fine_segments","kind":"fn","old":"b555b6b7ef4952cf","new":"99999ab93c172ab0","interface_changed":false,"affected":[],"module":"diff","text":"fn fine_segments(a: String, b: String) -> List[diff.Seg] {\n  ta := merge.tokens(a)\n  tb := merge.tokens(b)\n  mut out := []\n  mut k := \"\"\n  mut cur := \"\"\n  for (op, i, j) in diff.lcs(ta, tb) {\n    (kind, s) := if op == 0 {\n      (\"=\", get(ta, i) ?? \"\")\n    } else if op == 1 {\n      (\"-\", get(ta, i) ?? \"\")\n    } else {\n      (\"+\", get(tb, j) ?? \"\")\n    }\n    if kind != k && k != \"\" {\n      mut out.push(diff.Seg { k, t: cur })\n      cur = \"\"\n    }\n    k = kind\n    cur += s\n  }\n  if k != \"\" {\n    mut out.push(diff.Seg { k, t: cur })\n  }\n  out\n}","old_text":"fn fine_segments(a: String, b: String) -> List[diff.Seg] {\n  ta := merge.tokens(a)\n  tb := merge.tokens(b)\n  mut out := []\n  mut k := \"\"\n  mut cur := \"\"\n  for (op, i, j) in diff.lcs(ta, tb) {\n    (kind, s) := if op == 0 {\n      (\"=\", get(ta, i) ?? \"\")\n    } else if op == 1 {\n      (\"-\", get(ta, i) ?? \"\")\n    } else {\n      (\"+\", get(tb, j) ?? \"\")\n    }\n    if kind != k && k != \"\" {\n      mut out.push(diff.Seg { k, t: cur })\n      cur = \"\"\n    }\n    k = kind\n    cur += s\n  }\n  if k != \"\" {\n    mut out.push(diff.Seg { k, t: cur })\n  }\n  out\n}"},{"name":"diff.members_words","kind":"fn","old":"fe2e1fed685ea8a1","new":"e90ae926d28d1c5c","interface_changed":false,"affected":[],"module":"diff","text":"/// Members added, removed and changed, in words: `what` (`field`,\n/// `variant`) by name, with what each is.\nfn members_words(\n  what: String,\n  a: List[(String, String)],\n  b: List[(String, String)],\n) -> List[String] {\n  added := b.filter(x -> !a.any(y -> y.0 == x.0)).map(x -> x.0)\n  removed := a.filter(x -> !b.any(y -> y.0 == x.0)).map(x -> x.0)\n  changed := b.filter(x -> a.any(y -> y.0 == x.0 && y.1 != x.1)).map(x -> x.0)\n  mut out := []\n  if len(added) > 0 {\n    mut out.push(diff.named_list(what, added) + \" added\")\n  }\n  if len(removed) > 0 {\n    mut out.push(diff.named_list(what, removed) + \" removed\")\n  }\n  if len(changed) > 0 {\n    mut out.push(diff.named_list(what, changed) + \" changed\")\n  }\n  out\n}","old_text":"/// Members added, removed and changed, in words: `what` (`field`,\n/// `variant`) by name, with what each is.\nfn members_words(\n  what: String,\n  a: List[(String, String)],\n  b: List[(String, String)],\n) -> List[String] {\n  added := b.filter(x -> !a.any(y -> y.0 == x.0)).map(x -> x.0)\n  removed := a.filter(x -> !b.any(y -> y.0 == x.0)).map(x -> x.0)\n  changed := b.filter(x -> a.any(y -> y.0 == x.0 && y.1 != x.1)).map(x -> x.0)\n  mut out := []\n  if len(added) > 0 {\n    mut out.push(diff.named_list(what, added) + \" added\")\n  }\n  if len(removed) > 0 {\n    mut out.push(diff.named_list(what, removed) + \" removed\")\n  }\n  if len(changed) > 0 {\n    mut out.push(diff.named_list(what, changed) + \" changed\")\n  }\n  out\n}"},{"name":"diff.type_words","kind":"fn","old":"37e0eb30dd3ec98a","new":"060e4ee6646a9a90","interface_changed":false,"affected":[],"module":"diff","text":"fn type_words(o: ast.TypeDecl, n: ast.TypeDecl) -> List[String] {\n  fields := (t: ast.TypeDecl) -> match t.body {\n    ast.RecordBody(fs) => fs.map(f -> (f.name, text.type_text(f.ty))),\n    _ => [],\n  }\n  variants := (t: ast.TypeDecl) -> match t.body {\n    ast.SumBody(vs) => vs.map(v -> (v.name, debug(v.payload))),\n    _ => [],\n  }\n  mut out := diff.members_words(\"field\", fields(o), fields(n))\n    + diff.members_words(\"variant\", variants(o), variants(n))\n  match (o.body, n.body) {\n    (ast.Alias(a), ast.Alias(b)) => if a != b {\n      mut out.push(\"base type changed\")\n    },\n    (ast.RecordBody(_), ast.RecordBody(_)) | (ast.SumBody(_), ast.SumBody(_)) => (),\n    _ => mut out.push(\"shape changed\"),\n  }\n  r := (t: ast.TypeDecl) -> match t.refinement {\n    Some(e) => Some(text.expr_text(e, 0)),\n    None => None,\n  }\n  match (r(o), r(n)) {\n    (None, Some(_)) => mut out.push(\"refinement added\"),\n    (Some(_), None) => mut out.push(\"refinement removed\"),\n    (a, b) => if a != b {\n      mut out.push(\"refinement changed\")\n    },\n  }\n  out\n}","old_text":"fn type_words(o: ast.TypeDecl, n: ast.TypeDecl) -> List[String] {\n  fields := (t: ast.TypeDecl) -> match t.body {\n    ast.RecordBody(fs) => fs.map(f -> (f.name, text.type_text(f.ty))),\n    _ => [],\n  }\n  variants := (t: ast.TypeDecl) -> match t.body {\n    ast.SumBody(vs) => vs.map(v -> (v.name, debug(v.payload))),\n    _ => [],\n  }\n  mut out := diff.members_words(\"field\", fields(o), fields(n))\n    + diff.members_words(\"variant\", variants(o), variants(n))\n  match (o.body, n.body) {\n    (ast.Alias(a), ast.Alias(b)) => if a != b {\n      mut out.push(\"base type changed\")\n    },\n    (ast.RecordBody(_), ast.RecordBody(_)) | (ast.SumBody(_), ast.SumBody(_)) => (),\n    _ => {\n      mut out.push(\"shape changed\")\n    },\n  }\n  r := (t: ast.TypeDecl) -> match t.refinement {\n    Some(e) => Some(text.expr_text(e, 0)),\n    None => None,\n  }\n  match (r(o), r(n)) {\n    (None, Some(_)) => {\n      mut out.push(\"refinement added\")\n    },\n    (Some(_), None) => {\n      mut out.push(\"refinement removed\")\n    },\n    (a, b) => if a != b {\n      mut out.push(\"refinement changed\")\n    },\n  }\n  out\n}"},{"name":"diff.methods_words","kind":"fn","old":"2d87d96adb425a80","new":"c396187eecc458a3","interface_changed":false,"affected":[],"module":"diff","text":"fn methods_words(\n  o: List[(String, ast.FnDecl)],\n  n: List[(String, ast.FnDecl)],\n  contracts: Bool,\n) -> List[String] {\n  added := n.filter(x -> !o.any(y -> y.0 == x.0)).map(x -> x.0)\n  removed := o.filter(x -> !n.any(y -> y.0 == x.0)).map(x -> x.0)\n  mut out := []\n  if len(added) > 0 {\n    mut out.push(diff.named_list(\"method\", added) + \" added\")\n  }\n  if len(removed) > 0 {\n    mut out.push(diff.named_list(\"method\", removed) + \" removed\")\n  }\n  mut changed := []\n  for (name, b) in n {\n    match o.find(y -> y.0 == name) {\n      None => (),\n      Some((_, a)) => {\n        if contracts {\n          out += diff.contract_words(a, b).map(x -> \"`\" + name + \"`: \" + x)\n        }\n        if diff.fn_sig(a) != diff.fn_sig(b) {\n          mut out.push(\"`\" + name + \"`: signature changed\")\n        } else if diff.body_text(a) != diff.body_text(b)\n          && b.body != ast.UnitExpr {\n          mut changed.push(name)\n        }\n      },\n    }\n  }\n  if len(changed) > 0 {\n    mut out.push(diff.named_list(\"method\", changed) + \" changed\")\n  }\n  out\n}","old_text":"fn methods_words(\n  o: List[(String, ast.FnDecl)],\n  n: List[(String, ast.FnDecl)],\n  contracts: Bool,\n) -> List[String] {\n  added := n.filter(x -> !o.any(y -> y.0 == x.0)).map(x -> x.0)\n  removed := o.filter(x -> !n.any(y -> y.0 == x.0)).map(x -> x.0)\n  mut out := []\n  if len(added) > 0 {\n    mut out.push(diff.named_list(\"method\", added) + \" added\")\n  }\n  if len(removed) > 0 {\n    mut out.push(diff.named_list(\"method\", removed) + \" removed\")\n  }\n  mut changed := []\n  for (name, b) in n {\n    match o.find(y -> y.0 == name) {\n      None => (),\n      Some((_, a)) => {\n        if contracts {\n          out += diff.contract_words(a, b).map(x -> \"`\" + name + \"`: \" + x)\n        }\n        if diff.fn_sig(a) != diff.fn_sig(b) {\n          mut out.push(\"`\" + name + \"`: signature changed\")\n        } else if diff.body_text(a) != diff.body_text(b)\n          && b.body != ast.UnitExpr {\n          mut changed.push(name)\n        }\n      },\n    }\n  }\n  if len(changed) > 0 {\n    mut out.push(diff.named_list(\"method\", changed) + \" changed\")\n  }\n  out\n}"}]}
{"id":"9d438dcd1f35199a","time":1795657777,"message":"edit","changes":[{"name":"finding.with_defs","kind":"fn","old":"b1dff1957ad738f6","new":"323edb141af7c9e6","interface_changed":false,"affected":[],"module":"finding","text":"fn with_defs(\n  units: List[finding.Unit],\n  bundle: List[ast.Decl],\n) -> finding.Source {\n  mut defs := []\n  for (u, unit) in enumerate(units) {\n    for (k, e) in enumerate(unit.header.entries) {\n      mut defs.push(\n        finding.Def {\n          qname: store.qualify(unit.module, e.name),\n          module: unit.module,\n          kind: e.kind,\n          public: e.public,\n          hash: finding.short_hash(e.hash),\n          deps: e.deps,\n          unit: u,\n          entry: k,\n        },\n      )\n    }\n  }\n  g := if bundle == [] {\n    Dict[String, List[String]] {}\n  } else {\n    store.graph(bundle, false)\n  }\n  for (k, d) in enumerate(bundle) {\n    q := store.qname(d)\n    mut defs.push(\n      finding.Def {\n        qname: q,\n        module: d.module,\n        kind: binary.kind_name(d),\n        public: d.public,\n        hash: finding.short_hash(binary.hash(d)),\n        deps: get(g, q) ?? [],\n        unit: -1,\n        entry: k,\n      },\n    )\n  }\n  finding.Source { units, bundle, defs }\n}","old_text":"fn with_defs(\n  units: List[finding.Unit],\n  bundle: List[ast.Decl],\n) -> finding.Source {\n  mut defs := []\n  for (u, unit) in enumerate(units) {\n    for (k, e) in enumerate(unit.header.entries) {\n      mut defs.push(\n        finding.Def {\n          qname: store.qualify(unit.module, e.name),\n          module: unit.module,\n          kind: e.kind,\n          public: e.public,\n          hash: finding.short_hash(e.hash),\n          deps: e.deps,\n          unit: u,\n          entry: k,\n        },\n      )\n    }\n  }\n  g := if bundle == [] {\n    Dict[String, List[String]] {}\n  } else {\n    store.graph(bundle, false)\n  }\n  for (k, d) in enumerate(bundle) {\n    q := store.qname(d)\n    mut defs.push(\n      finding.Def {\n        qname: q,\n        module: d.module,\n        kind: binary.kind_name(d),\n        public: d.public,\n        hash: finding.short_hash(binary.hash(d)),\n        deps: get(g, q) ?? [],\n        unit: -1,\n        entry: k,\n      },\n    )\n  }\n  finding.Source { units, bundle, defs }\n}"},{"name":"finding.uses_of","kind":"fn","old":"24f1ef4cbab1b3e1","new":"5a82bbb689d9dc07","interface_changed":false,"affected":[],"module":"finding","text":"/// The target `t`'s uses in the definitions `among` (indexes in `defs`).\nfn uses_of(\n  c: finding.Ctx,\n  t: finding.Target,\n  among: List[Int],\n) -> List[finding.Use] {\n  it := t.it\n  mut cands := among\n  // a method's or field's candidates first resolved or tagged as the\n  // checker types them\n  mut resolved := Dict[Int, ast.Decl] {}\n  if it.kind == \"method\"\n    && it.owner != \"\"\n    && it.target == it.owner + \".\" + it.short {\n    calling := cands.filter(\n      k -> finding.mentions_method(get(c.decls, k), it.short),\n    )\n    own := calling.map(k -> get(c.decls, k) ?? finding.empty_decl())\n    if own != [] {\n      rest := [d for (k, d) in enumerate(c.decls) where !contains(calling, k)]\n      rs := check.own_methods_resolved(own, rest + c.std, c.core)\n      for (j, k) in enumerate(calling) {\n        match get(rs, j) {\n          Some(r) => mut resolved.insert(k, r),\n          None => (),\n        }\n      }\n    }\n  }\n  mut tagged := Dict[Int, ast.Decl] {}\n  if it.kind == \"field\" {\n    reading := cands.filter(\n      k -> finding.reads_field(get(c.decls, k), it.target),\n    )\n    own := reading.map(k -> get(c.decls, k) ?? finding.empty_decl())\n    if own != [] {\n      rest := [d for (k, d) in enumerate(c.decls) where !contains(reading, k)]\n      ts := check.mark_field_reads(own, rest + c.std, c.core, it.target)\n      for (j, k) in enumerate(reading) {\n        match get(ts, j) {\n          Some(x) => mut tagged.insert(k, x),\n          None => (),\n        }\n      }\n    }\n  }\n  mut out := []\n  for k in cands {\n    match (get(tagged, k), get(c.decls, k)) {\n      (Some(x), _) => {\n        out += finding.uses_in(x, k, t, get(resolved, k))\n      },\n      (None, Some(x)) => {\n        out += finding.uses_in(x, k, t, get(resolved, k))\n      },\n      _ => (),\n    }\n  }\n  out\n}","old_text":"/// The target `t`'s uses in the definitions `among` (indexes in `defs`).\nfn uses_of(\n  c: finding.Ctx,\n  t: finding.Target,\n  among: List[Int],\n) -> List[finding.Use] {\n  it := t.it\n  mut cands := among\n  // a method's or field's candidates first resolved or tagged as the\n  // checker types them\n  mut resolved := Dict[Int, ast.Decl] {}\n  if it.kind == \"method\"\n    && it.owner != \"\"\n    && it.target == it.owner + \".\" + it.short {\n    calling := cands.filter(\n      k -> finding.mentions_method(get(c.decls, k), it.short),\n    )\n    own := calling.map(k -> get(c.decls, k) ?? finding.empty_decl())\n    if own != [] {\n      rest := [d for (k, d) in enumerate(c.decls) where !contains(calling, k)]\n      rs := check.own_methods_resolved(own, rest + c.std, c.core)\n      for (j, k) in enumerate(calling) {\n        match get(rs, j) {\n          Some(r) => {\n            mut resolved.insert(k, r)\n          },\n          None => (),\n        }\n      }\n    }\n  }\n  mut tagged := Dict[Int, ast.Decl] {}\n  if it.kind == \"field\" {\n    reading := cands.filter(\n      k -> finding.reads_field(get(c.decls, k), it.target),\n    )\n    own := reading.map(k -> get(c.decls, k) ?? finding.empty_decl())\n    if own != [] {\n      rest := [d for (k, d) in enumerate(c.decls) where !contains(reading, k)]\n      ts := check.mark_field_reads(own, rest + c.std, c.core, it.target)\n      for (j, k) in enumerate(reading) {\n        match get(ts, j) {\n          Some(x) => {\n            mut tagged.insert(k, x)\n          },\n          None => (),\n        }\n      }\n    }\n  }\n  mut out := []\n  for k in cands {\n    match (get(tagged, k), get(c.decls, k)) {\n      (Some(x), _) => {\n        out += finding.uses_in(x, k, t, get(resolved, k))\n      },\n      (None, Some(x)) => {\n        out += finding.uses_in(x, k, t, get(resolved, k))\n      },\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"finding.uses_shown","kind":"fn","old":"0420e767c0c8f104","new":"1f2739b8b82c64b9","interface_changed":false,"affected":[],"module":"finding","text":"/// Uses shown as code, grouped by definition: each use's location and kind,\n/// then the definition with them marked.\nfn uses_shown(\n  c: finding.Ctx,\n  us: List[finding.Use],\n  context: Int,\n  p: std.term.Paint,\n) -> String {\n  mut order := []\n  for u in us {\n    if !contains(order, u.def) {\n      mut order.push(u.def)\n    }\n  }\n  // the written form of each definition, as it is and with stand-ins\n  mut markings := Dict[Int, locate.Marking] {}\n  plain := resolve.written(c.decls, c.std, c.core)\n  for k in order {\n    paths := [u.path for u in us where u.def == k && u.path != \"\"]\n    match (get(c.decls, k), get(plain, k)) {\n      (Some(d), Some(w)) => mut markings.insert(k, locate.marking(d, w, paths)),\n      _ => (),\n    }\n  }\n  marked := resolve.written([match get(markings, k) {\n    Some(m) => locate.with_stand_ins(d, m.names),\n    None => d,\n  } for (k, d) in enumerate(c.decls)], c.std, c.core)\n  mut parts := []\n  for k in order {\n    def := get(c.s.defs, k)\n    heads := [match def {\n      Some(d) => locate.location_text(\n          locate.Location {\n            def: d.qname,\n            hash: d.hash,\n            path: u.path,\n          },\n        )\n        + \"  \"\n        + u.kind,\n      None => u.kind,\n    } for u in us where u.def == k]\n    code := match (get(marked, k), get(markings, k)) {\n      (Some(w), Some(m)) => locate.shown(w, m, context),\n      _ => \"\",\n    }\n    mut parts.push(\n      highlight.dim(p, join(heads, \"\\n\"))\n        + \"\\n\"\n        + finding.shown_code(p, code),\n    )\n  }\n  join(parts, \"\\n\\n\")\n}","old_text":"/// Uses shown as code, grouped by definition: each use's location and kind,\n/// then the definition with them marked.\nfn uses_shown(\n  c: finding.Ctx,\n  us: List[finding.Use],\n  context: Int,\n  p: std.term.Paint,\n) -> String {\n  mut order := []\n  for u in us {\n    if !contains(order, u.def) {\n      mut order.push(u.def)\n    }\n  }\n  // the written form of each definition, as it is and with stand-ins\n  mut markings := Dict[Int, locate.Marking] {}\n  plain := resolve.written(c.decls, c.std, c.core)\n  for k in order {\n    paths := [u.path for u in us where u.def == k && u.path != \"\"]\n    match (get(c.decls, k), get(plain, k)) {\n      (Some(d), Some(w)) => {\n        mut markings.insert(k, locate.marking(d, w, paths))\n      },\n      _ => (),\n    }\n  }\n  marked := resolve.written([match get(markings, k) {\n    Some(m) => locate.with_stand_ins(d, m.names),\n    None => d,\n  } for (k, d) in enumerate(c.decls)], c.std, c.core)\n  mut parts := []\n  for k in order {\n    def := get(c.s.defs, k)\n    heads := [match def {\n      Some(d) => locate.location_text(\n          locate.Location {\n            def: d.qname,\n            hash: d.hash,\n            path: u.path,\n          },\n        )\n        + \"  \"\n        + u.kind,\n      None => u.kind,\n    } for u in us where u.def == k]\n    code := match (get(marked, k), get(markings, k)) {\n      (Some(w), Some(m)) => locate.shown(w, m, context),\n      _ => \"\",\n    }\n    mut parts.push(\n      highlight.dim(p, join(heads, \"\\n\"))\n        + \"\\n\"\n        + finding.shown_code(p, code),\n    )\n  }\n  join(parts, \"\\n\\n\")\n}"},{"name":"finding.uses_from","kind":"fn","old":"6cc47c4f664b2f88","new":"4bf91840747cf3c8","interface_changed":false,"affected":[],"module":"finding","text":"/// What a definition item uses: each definition it depends on, with the\n/// uses of it there.\nfn uses_from(\n  c: finding.Ctx,\n  it: finding.Item,\n) -> List[(finding.Item, List[finding.Use])] {\n  deps := match get(c.s.defs, it.def) {\n    Some(d) => d.deps,\n    None => [],\n  }\n  mut out := []\n  for q in deps {\n    match c.items.find(x -> x.q == q && x.path == \"\") {\n      Some(dep) => mut out.push(\n        (\n          dep,\n          finding.uses_of(c, finding.target_of(c, dep), [it.def]),\n        ),\n      ),\n      None => (),\n    }\n  }\n  out\n}","old_text":"/// What a definition item uses: each definition it depends on, with the\n/// uses of it there.\nfn uses_from(\n  c: finding.Ctx,\n  it: finding.Item,\n) -> List[(finding.Item, List[finding.Use])] {\n  deps := match get(c.s.defs, it.def) {\n    Some(d) => d.deps,\n    None => [],\n  }\n  mut out := []\n  for q in deps {\n    match c.items.find(x -> x.q == q && x.path == \"\") {\n      Some(dep) => {\n        mut out.push(\n          (\n            dep,\n            finding.uses_of(c, finding.target_of(c, dep), [it.def]),\n          ),\n        )\n      },\n      None => (),\n    }\n  }\n  out\n}"},{"name":"finding.error_places","kind":"fn","old":"5017032342d195cb","new":"7522c53451d67f9a","interface_changed":false,"affected":[],"module":"finding","text":"/// For each error `strata check` found (the definition it is in, the\n/// message), where it is shown as code (its location, then the definition\n/// with the place marked), when the definition is found: the place is the\n/// code the message quotes (`quoted_place`), else the definition is shown\n/// by its head. `None` where nothing is found.\npub fn error_places(\n  disk: std.fs.Disk,\n  process: std.process.Process,\n  file: String,\n  errors: List[(String, String)],\n  p: std.term.Paint,\n) -> List[Option[String]] {\n  nothing := errors.map(_ -> None)\n  if errors == [] {\n    return nothing\n  }\n  s := match finding.source_of(disk, process, Some(file)) {\n    Ok(s) => s,\n    Err(_) => return nothing,\n  }\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  decls := s.defs.map(d -> finding.decl_of(s, d) ?? finding.empty_decl())\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  core := read_core_at(disk, home)\n  plain := resolve.written(decls, std, core)\n  // each error's definition and path\n  found := errors.map(\n    e -> {\n      exact := [k for (k, d) in enumerate(s.defs) where d.qname == e.0]\n      short := [k for (k, d) in enumerate(s.defs) where finding.last_part(d.qname) == e.0 && d.kind != \"use\"]\n      match exact + short {\n        [k, ..] => Some((k, match get(plain, k) {\n          Some(w) => finding.quoted_place(w, e.1),\n          None => \"\",\n        })),\n        [] => None,\n      }\n    },\n  )\n  // in rounds, each marking one error per definition\n  mut out := Dict[Int, String] {}\n  mut left := [i for (i, f) in enumerate(found) where f is Some]\n  while left != [] {\n    mut round := []\n    mut taken := Set[Int] {}\n    for i in left {\n      match get(found, i) {\n        Some(Some((k, _))) => if !contains(taken, k) {\n          mut round.push(i)\n          mut taken.insert(k)\n        },\n        _ => (),\n      }\n    }\n    left = left.filter(i -> !contains(round, i))\n    mut markings := Dict[Int, locate.Marking] {}\n    for i in round {\n      match get(found, i) {\n        Some(Some((k, path))) => match (get(decls, k), get(plain, k)) {\n          (Some(d), Some(w)) => mut markings.insert(\n            k,\n            locate.marking(d, w, if path == \"\" {\n              []\n            } else {\n              [path]\n            }),\n          ),\n          _ => (),\n        },\n        _ => (),\n      }\n    }\n    marked := resolve.written([match get(markings, k) {\n      Some(m) => locate.with_stand_ins(d, m.names),\n      None => d,\n    } for (k, d) in enumerate(decls)], std, core)\n    for i in round {\n      match get(found, i) {\n        Some(Some((k, path))) => match (get(s.defs, k), get(marked, k), get(markings, k)) {\n          (Some(def), Some(w), Some(m)) => {\n            at := if get(m.names, path) is Some {\n              path\n            } else {\n              \"\"\n            }\n            code := locate.shown(w, m, if at == \"\" {\n              0\n            } else {\n              1\n            })\n            head := locate.location_text(locate.Location {\n              def: def.qname,\n              hash: def.hash,\n              path: at,\n            })\n            mut out.insert(\n              i,\n              highlight.dim(p, \"--> \" + head)\n                + \"\\n\"\n                + finding.indented(finding.shown_code(p, code)),\n            )\n          },\n          _ => (),\n        },\n        _ => (),\n      }\n    }\n  }\n  [get(out, i) for (i, _) in enumerate(errors)]\n}","old_text":"/// For each error `strata check` found (the definition it is in, the\n/// message), where it is shown as code (its location, then the definition\n/// with the place marked), when the definition is found: the place is the\n/// code the message quotes (`quoted_place`), else the definition is shown\n/// by its head. `None` where nothing is found.\npub fn error_places(\n  disk: std.fs.Disk,\n  process: std.process.Process,\n  file: String,\n  errors: List[(String, String)],\n  p: std.term.Paint,\n) -> List[Option[String]] {\n  nothing := errors.map(_ -> None)\n  if errors == [] {\n    return nothing\n  }\n  s := match finding.source_of(disk, process, Some(file)) {\n    Ok(s) => s,\n    Err(_) => return nothing,\n  }\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  decls := s.defs.map(d -> finding.decl_of(s, d) ?? finding.empty_decl())\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  core := read_core_at(disk, home)\n  plain := resolve.written(decls, std, core)\n  // each error's definition and path\n  found := errors.map(\n    e -> {\n      exact := [k for (k, d) in enumerate(s.defs) where d.qname == e.0]\n      short := [k for (k, d) in enumerate(s.defs) where finding.last_part(d.qname) == e.0 && d.kind != \"use\"]\n      match exact + short {\n        [k, ..] => Some((k, match get(plain, k) {\n          Some(w) => finding.quoted_place(w, e.1),\n          None => \"\",\n        })),\n        [] => None,\n      }\n    },\n  )\n  // in rounds, each marking one error per definition\n  mut out := Dict[Int, String] {}\n  mut left := [i for (i, f) in enumerate(found) where f is Some]\n  while left != [] {\n    mut round := []\n    mut taken := Set[Int] {}\n    for i in left {\n      match get(found, i) {\n        Some(Some((k, _))) => if !contains(taken, k) {\n          mut round.push(i)\n          mut taken.insert(k)\n        },\n        _ => (),\n      }\n    }\n    left = left.filter(i -> !contains(round, i))\n    mut markings := Dict[Int, locate.Marking] {}\n    for i in round {\n      match get(found, i) {\n        Some(Some((k, path))) => match (get(decls, k), get(plain, k)) {\n          (Some(d), Some(w)) => {\n            mut markings.insert(\n              k,\n              locate.marking(d, w, if path == \"\" {\n                []\n              } else {\n                [path]\n              }),\n            )\n          },\n          _ => (),\n        },\n        _ => (),\n      }\n    }\n    marked := resolve.written([match get(markings, k) {\n      Some(m) => locate.with_stand_ins(d, m.names),\n      None => d,\n    } for (k, d) in enumerate(decls)], std, core)\n    for i in round {\n      match get(found, i) {\n        Some(Some((k, path))) => match (get(s.defs, k), get(marked, k), get(markings, k)) {\n          (Some(def), Some(w), Some(m)) => {\n            at := if get(m.names, path) is Some {\n              path\n            } else {\n              \"\"\n            }\n            code := locate.shown(w, m, if at == \"\" {\n              0\n            } else {\n              1\n            })\n            head := locate.location_text(locate.Location {\n              def: def.qname,\n              hash: def.hash,\n              path: at,\n            })\n            mut out.insert(\n              i,\n              highlight.dim(p, \"--> \" + head)\n                + \"\\n\"\n                + finding.indented(finding.shown_code(p, code)),\n            )\n          },\n          _ => (),\n        },\n        _ => (),\n      }\n    }\n  }\n  [get(out, i) for (i, _) in enumerate(errors)]\n}"},{"name":"finding.library_source","kind":"fn","old":"8651cfc8d863f400","new":"e8f867b1bcedc5f6","interface_changed":false,"affected":[],"module":"finding","text":"/// core's and std's module files (core's runtime modules left out), as a\n/// source: where `find` looks for a name the program doesn't define\n/// (`find Dict`, `find insert`).\nfn library_source(\n  disk: std.fs.Disk,\n  process: std.process.Process,\n) -> finding.Source {\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  mut units := []\n  for package in [\"core\", \"std\"] {\n    root := if home == \"\" {\n      package\n    } else {\n      home + \"/\" + package\n    }\n    for rel in deps.module_files(disk, root) {\n      m := deps.module_name(package, rel)\n      if !builtins.runtime_module(m) && m != \"core.mem\" {\n        match disk.read_bytes(root + \"/\" + rel) {\n          Ok(bytes) => match binary.read_header(bytes) {\n            Ok(header) => mut units.push(finding.Unit { module: m, bytes, header }),\n            Err(_) => (),\n          },\n          Err(_) => (),\n        }\n      }\n    }\n  }\n  finding.with_defs(units, [])\n}","old_text":"/// core's and std's module files (core's runtime modules left out), as a\n/// source: where `find` looks for a name the program doesn't define\n/// (`find Dict`, `find insert`).\nfn library_source(\n  disk: std.fs.Disk,\n  process: std.process.Process,\n) -> finding.Source {\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  mut units := []\n  for package in [\"core\", \"std\"] {\n    root := if home == \"\" {\n      package\n    } else {\n      home + \"/\" + package\n    }\n    for rel in deps.module_files(disk, root) {\n      m := deps.module_name(package, rel)\n      if !builtins.runtime_module(m) && m != \"core.mem\" {\n        match disk.read_bytes(root + \"/\" + rel) {\n          Ok(bytes) => match binary.read_header(bytes) {\n            Ok(header) => {\n              mut units.push(finding.Unit { module: m, bytes, header })\n            },\n            Err(_) => (),\n          },\n          Err(_) => (),\n        }\n      }\n    }\n  }\n  finding.with_defs(units, [])\n}"}]}
{"id":"aea40b3fa08ad1ca","time":1795657792,"message":"edit","changes":[{"name":"locate.fn_kids","kind":"fn","old":"703835b66e77746b","new":"7878ce8a221ba60a","interface_changed":false,"affected":[],"module":"locate","text":"/// A function's parts, each label after `prefix`.\nfn fn_kids(prefix: String, f: ast.FnDecl) -> List[locate.Child] {\n  names := f.params.map(p -> p.name)\n  mut out := []\n  for (i, b) in enumerate(f.bounds) {\n    out += locate.indexed_types(\n      prefix + \"bounds/\" + to_string(i) + \"/traits/\",\n      b.traits,\n    )\n  }\n  out += locate.params_kids(prefix, f.params)\n  mut out.push(locate.kid(prefix + \"ret\", locate.TNode(f.ret)))\n  for (i, e) in enumerate(f.pre) {\n    mut out.push(\n      locate.Child {\n        label: prefix + \"pre/\" + to_string(i),\n        node: locate.ENode(e),\n        binds: names,\n      },\n    )\n  }\n  for (i, e) in enumerate(f.post) {\n    mut out.push(\n      locate.Child {\n        label: prefix + \"post/\" + to_string(i),\n        node: locate.ENode(e),\n        binds: names + [\"result\"],\n      },\n    )\n  }\n  out\n    + [locate.Child {\n      label: prefix + \"body\",\n      node: locate.ENode(f.body),\n      binds: names,\n    }]\n}","old_text":"/// A function's parts, each label after `prefix`.\nfn fn_kids(prefix: String, f: ast.FnDecl) -> List[locate.Child] {\n  names := f.params.map(p -> p.name)\n  mut out := []\n  for (i, b) in enumerate(f.bounds) {\n    out += locate.indexed_types(\n      prefix + \"bounds/\" + to_string(i) + \"/traits/\",\n      b.traits,\n    )\n  }\n  out += locate.params_kids(prefix, f.params)\n  mut out.push(locate.kid(prefix + \"ret\", locate.TNode(f.ret)))\n  for (i, e) in enumerate(f.pre) {\n    mut out.push(\n      locate.Child {\n        label: prefix + \"pre/\" + to_string(i),\n        node: locate.ENode(e),\n        binds: names,\n      },\n    )\n  }\n  for (i, e) in enumerate(f.post) {\n    mut out.push(\n      locate.Child {\n        label: prefix + \"post/\" + to_string(i),\n        node: locate.ENode(e),\n        binds: names + [\"result\"],\n      },\n    )\n  }\n  out\n    + [locate.Child {\n      label: prefix + \"body\",\n      node: locate.ENode(f.body),\n      binds: names,\n    }]\n}"},{"name":"locate.around","kind":"fn","old":"7812c5498de676d3","new":"c02544a44fd8f1dc","interface_changed":false,"affected":[],"module":"locate","text":"/// The lines of `ls` that open the blocks around line `i` (by indentation),\n/// and those that close them.\nfn around(ls: List[String], i: Int) -> List[Int] {\n  mut out := []\n  mut level := locate.indent_of(get(ls, i) ?? \"\")\n  mut j := i - 1\n  while j >= 0 && level > 0 {\n    l := get(ls, j) ?? \"\"\n    if trim(l) != \"\" && locate.indent_of(l) < level {\n      mut out.push(j)\n      level = locate.indent_of(l)\n    }\n    j -= 1\n  }\n  level = locate.indent_of(get(ls, i) ?? \"\")\n  j = i + 1\n  while j < len(ls) && level > 0 {\n    l := get(ls, j) ?? \"\"\n    if trim(l) != \"\" && locate.indent_of(l) < level {\n      t := trim(l)\n      if starts_with(t, \"}\")\n        || starts_with(t, \")\")\n        || starts_with(t, \"]\") {\n        mut out.push(j)\n      }\n      level = locate.indent_of(l)\n    }\n    j += 1\n  }\n  out\n}","old_text":"/// The lines of `ls` that open the blocks around line `i` (by indentation),\n/// and those that close them.\nfn around(ls: List[String], i: Int) -> List[Int] {\n  mut out := []\n  mut level := locate.indent_of(get(ls, i) ?? \"\")\n  mut j := i - 1\n  while j >= 0 && level > 0 {\n    l := get(ls, j) ?? \"\"\n    if trim(l) != \"\" && locate.indent_of(l) < level {\n      mut out.push(j)\n      level = locate.indent_of(l)\n    }\n    j -= 1\n  }\n  level = locate.indent_of(get(ls, i) ?? \"\")\n  j = i + 1\n  while j < len(ls) && level > 0 {\n    l := get(ls, j) ?? \"\"\n    if trim(l) != \"\" && locate.indent_of(l) < level {\n      t := trim(l)\n      if starts_with(t, \"}\")\n        || starts_with(t, \")\")\n        || starts_with(t, \"]\") {\n        mut out.push(j)\n      }\n      level = locate.indent_of(l)\n    }\n    j += 1\n  }\n  out\n}"}]}
{"id":"18ec1a9ec1971aa7","time":1795657800,"message":"edit","changes":[{"name":"merge.tokens","kind":"fn","old":"43f8176bbc55bf77","new":"a4edafd2b46d8f30","interface_changed":false,"affected":[],"module":"merge","text":"/// Words, runs of spaces, and each other character, in order.\npub fn tokens(s: String) -> List[String] {\n  mut out := []\n  mut cur := \"\"\n  mut last := -1\n  for c in chars(s) {\n    k := merge.class(c)\n    if cur != \"\" && (k != last || k == 2) {\n      mut out.push(cur)\n      cur = \"\"\n    }\n    cur += c\n    last = k\n  }\n  if cur != \"\" {\n    mut out.push(cur)\n  }\n  out\n}","old_text":"/// Words, runs of spaces, and each other character, in order.\npub fn tokens(s: String) -> List[String] {\n  mut out := []\n  mut cur := \"\"\n  mut last := -1\n  for c in chars(s) {\n    k := merge.class(c)\n    if cur != \"\" && (k != last || k == 2) {\n      mut out.push(cur)\n      cur = \"\"\n    }\n    cur += c\n    last = k\n  }\n  if cur != \"\" {\n    mut out.push(cur)\n  }\n  out\n}"}]}
{"id":"8d994e3f66b9e276","time":1795657813,"message":"edit","changes":[{"name":"termination.call_name","kind":"fn","old":"d49e304f75d179c3","new":"0f2e3bf6a3da4d83","interface_changed":false,"affected":[],"module":"termination","text":"fn call_name(mut st: termination.Calls, ctx: termination.Ctx, n: String) {\n  if st.scopes.any(s -> contains(s, n)) {\n    return\n  }\n  if contains(ctx.fns, n) {\n    mut st.out.insert(n)\n  } else if termination.is_method(ctx, n) {\n    mut st.out.insert(termination.trait_node(n))\n  }\n}","old_text":"fn call_name(mut st: termination.Calls, ctx: termination.Ctx, n: String) {\n  if st.scopes.any(s -> contains(s, n)) {\n    return\n  }\n  if contains(ctx.fns, n) {\n    mut st.out.insert(n)\n  } else if termination.is_method(ctx, n) {\n    mut st.out.insert(termination.trait_node(n))\n  }\n}"},{"name":"termination.struct_call","kind":"fn","old":"cf174b7884bf9fd8","new":"d17c92d6563ba8c6","interface_changed":false,"affected":[],"module":"termination","text":"fn struct_call(\n  mut st: termination.Structural,\n  args: List[ast.Expr],\n  vars: Dict[String, termination.Piece],\n) {\n  mut smaller := Set[Int] {}\n  for (i, a) in enumerate(args) {\n    if contains(termination.piece(a, vars).smaller, i) {\n      mut smaller.insert(i)\n    }\n  }\n  mut st.calls.push(smaller)\n}","old_text":"fn struct_call(\n  mut st: termination.Structural,\n  args: List[ast.Expr],\n  vars: Dict[String, termination.Piece],\n) {\n  mut smaller := Set[Int] {}\n  for (i, a) in enumerate(args) {\n    if contains(termination.piece(a, vars).smaller, i) {\n      mut smaller.insert(i)\n    }\n  }\n  mut st.calls.push(smaller)\n}"}]}
{"id":"bbdd50aef4157a03","time":1795664469,"message":"edit","changes":[{"name":"binary.put_stmt","kind":"fn","old":"7214a9ec3bbc1d5a","new":"d1000eb740ea46f6","interface_changed":false,"affected":[],"module":"binary","text":"fn put_stmt(mut w: binary.Writer, s: ast.Stmt) {\n  match s {\n    ast.Let { pat, ty, value } => {\n      binary.w_byte(mut w, 0)\n      binary.put_pattern(mut w, pat)\n      binary.w_opt_type(mut w, ty)\n      binary.put_expr(mut w, value)\n    },\n    ast.VarDecl { name, ty, value } => {\n      binary.w_byte(mut w, 1)\n      binary.w_str(mut w, name)\n      binary.w_opt_type(mut w, ty)\n      binary.put_expr(mut w, value)\n    },\n    ast.Assign { place, value } => {\n      binary.w_byte(mut w, 2)\n      binary.put_expr(mut w, place)\n      binary.put_expr(mut w, value)\n    },\n    ast.While { cond, body } => {\n      binary.w_byte(mut w, 3)\n      binary.put_expr(mut w, cond)\n      binary.put_expr(mut w, body)\n    },\n    ast.For { pat, iter, body } => {\n      binary.w_byte(mut w, 4)\n      binary.put_pattern(mut w, pat)\n      binary.put_expr(mut w, iter)\n      binary.put_expr(mut w, body)\n    },\n    ast.Loop(body) => {\n      binary.w_byte(mut w, 5)\n      binary.put_expr(mut w, body)\n    },\n    ast.Break => binary.w_byte(mut w, 6),\n    ast.Continue => binary.w_byte(mut w, 7),\n    ast.ExprStmt(e) => {\n      binary.w_byte(mut w, 8)\n      binary.put_expr(mut w, e)\n    },\n    ast.Assert(e) => {\n      binary.w_byte(mut w, 9)\n      binary.put_expr(mut w, e)\n    },\n    ast.Comment(lines) => {\n      binary.w_byte(mut w, 10)\n      binary.w_strs(mut w, lines)\n    },\n    ast.ComptimeFor { pat, iter, body } => {\n      binary.w_byte(mut w, 11)\n      binary.put_pattern(mut w, pat)\n      binary.put_expr(mut w, iter)\n      binary.put_expr(mut w, body)\n    },\n    ast.Invariant(e) => {\n      binary.w_byte(mut w, 12)\n      binary.put_expr(mut w, e)\n    },\n    _ => match s {\n      ast.Decreases(e) => {\n        binary.w_byte(mut w, 13)\n        binary.put_expr(mut w, e)\n      },\n      _ => (),\n    },\n  }\n}","old_text":"fn put_stmt(mut w: binary.Writer, s: ast.Stmt) {\n  match s {\n    ast.Let { pat, ty, value } => {\n      binary.w_byte(mut w, 0)\n      binary.put_pattern(mut w, pat)\n      binary.w_opt_type(mut w, ty)\n      binary.put_expr(mut w, value)\n    },\n    ast.VarDecl { name, ty, value } => {\n      binary.w_byte(mut w, 1)\n      binary.w_str(mut w, name)\n      binary.w_opt_type(mut w, ty)\n      binary.put_expr(mut w, value)\n    },\n    ast.Assign { place, value } => {\n      binary.w_byte(mut w, 2)\n      binary.put_expr(mut w, place)\n      binary.put_expr(mut w, value)\n    },\n    ast.While { cond, body } => {\n      binary.w_byte(mut w, 3)\n      binary.put_expr(mut w, cond)\n      binary.put_expr(mut w, body)\n    },\n    ast.For { pat, iter, body } => {\n      binary.w_byte(mut w, 4)\n      binary.put_pattern(mut w, pat)\n      binary.put_expr(mut w, iter)\n      binary.put_expr(mut w, body)\n    },\n    ast.Loop(body) => {\n      binary.w_byte(mut w, 5)\n      binary.put_expr(mut w, body)\n    },\n    ast.Break => binary.w_byte(mut w, 6),\n    ast.Continue => binary.w_byte(mut w, 7),\n    ast.ExprStmt(e) => {\n      binary.w_byte(mut w, 8)\n      binary.put_expr(mut w, e)\n    },\n    ast.Assert(e) => {\n      binary.w_byte(mut w, 9)\n      binary.put_expr(mut w, e)\n    },\n    ast.Comment(lines) => {\n      binary.w_byte(mut w, 10)\n      binary.w_strs(mut w, lines)\n    },\n    ast.ComptimeFor { pat, iter, body } => {\n      binary.w_byte(mut w, 11)\n      binary.put_pattern(mut w, pat)\n      binary.put_expr(mut w, iter)\n      binary.put_expr(mut w, body)\n    },\n    ast.Invariant(e) => {\n      binary.w_byte(mut w, 12)\n      binary.put_expr(mut w, e)\n    },\n    ast.Decreases(e) => {\n      binary.w_byte(mut w, 13)\n      binary.put_expr(mut w, e)\n    },\n  }\n}"}]}
{"id":"d40778ac9d1430d2","time":1795664523,"message":"edit","changes":[{"name":"codegen.stmt_node","kind":"fn","old":"a8cc0d4b9631d665","new":"e9e2a549f199fc8f","interface_changed":false,"affected":[],"module":"codegen","text":"/// `stmt` of `s`, compiled.\nfn stmt_node(mut g: codegen.Gen, s: ast.Stmt) {\n  // `--copies`: the statement's value, when it is the program's own code\n  // as written and not compiler-made\n  if g.copies {\n    e := match s {\n      ast.Let { value, .. } => value,\n      ast.VarDecl { value, .. } => value,\n      ast.Assign { value, .. } => value,\n      ast.ExprStmt(e) => e,\n      _ => ast.UnitExpr,\n    }\n    t := text.expr_text(e, 0)\n    if contains(g.sites, g.current + \"|\" + t)\n      || contains(g.sites, \"|\" + t) {\n      g.at = e\n    }\n  }\n  match s {\n    ast.Let { pat, ty, value } => match pat {\n      ast.Bind(n) => codegen.declare(mut g, n, ty, value, false),\n      // `let _: T = e`: the value is still checked against `T`\n      ast.Wild => match ty {\n        Some(x) => {\n          want := codegen.lower(mut g, x)\n          v := codegen.expr_want(mut g, value, want)\n          if !(v.ty is check.TAny) && codegen.needs_check(g, x) {\n            codegen.check_type(mut g, x, v, \"let binding\", [])\n          }\n        },\n        None => {\n          _ := codegen.expr(mut g, value)\n        },\n      },\n      other => codegen.destructure(mut g, other, ty, value),\n    },\n    ast.VarDecl { name, ty, value } => codegen.declare(mut g, name, ty, value, true),\n    ast.Assign { place: ast.Var(x), value: given } => {\n      // a refined element type: only the added elements are checked\n      (value, elements) := codegen.checked_update(mut g, ast.Var(x), given)\n      // `xs[i] = v`, `xs = set_at(xs, i, v)`: in place when nothing else\n      // holds `xs`, and only `v` checked against a refined element type\n      each := codegen.element_check(g, x, value)\n      mut whole := !elements\n      // `x = insert(x, …)`: in place when nothing else holds `x`.\n      // `x += e` on a list or string: extended in place when possible.\n      v := match codegen.set_in_place(mut g, ast.Var(x), value, each) {\n        Some(u) => {\n          whole = each is None\n          u\n        },\n        None => match codegen.update_in_place(mut g, ast.Var(x), value) {\n          Some(u) => u,\n          None => match codegen.appended(mut g, ast.Var(x), value) {\n            Some(u) => u,\n            None => codegen.expr(mut g, value),\n          },\n        },\n      }\n      if v.ty is check.TAny {\n        return\n      }\n      match codegen.lookup(g, x) {\n        Some(l0) => {\n          // a variable declared with a partly unknown type (`mut xs := []`)\n          // takes the type the value gives it\n          l := codegen.retype(mut g, l0, v.ty)\n          match get(g.declared, l.slot) {\n            Some(dt) => if whole {\n              codegen.check_type(\n                mut g,\n                dt,\n                v,\n                f\"assigning `{x}`\",\n                [],\n              )\n            },\n            None => (),\n          }\n          // the new value held, the old one dropped\n          x := codegen.converted(mut g, v, l.ty)\n          nv := codegen.take_value(mut g, codegen.V { ..x, ty: l.ty })\n          old := codegen.load(mut g, l)\n          codegen.store_var(mut g, nv, l)\n          codegen.drop_value(mut g, old)\n        },\n        None => codegen.not_yet(mut g, \"assigning to `\" + x + \"`\"),\n      }\n    },\n    ast.Assign { place, value: given } => match codegen.place_of(place) {\n      Some((x, path)) => {\n        (value, elements) := codegen.checked_update(mut g, place, given)\n        v := match codegen.update_in_place(mut g, place, value) {\n          Some(u) => u,\n          None => match codegen.appended(mut g, place, value) {\n            Some(u) => u,\n            None => codegen.expr(mut g, value),\n          },\n        }\n        if v.ty is check.TAny {\n          return\n        }\n        match codegen.lookup(g, x) {\n          Some(l) => {\n            g.elements_checked = elements\n            codegen.assign_at(mut g, l, x, path, v)\n            g.elements_checked = false\n          },\n          None => codegen.not_yet(\n            mut g,\n            \"assigning to `\" + text.expr_text(place, 0) + \"`\",\n          ),\n        }\n      },\n      None => codegen.not_yet(\n        mut g,\n        \"assigning to `\" + text.expr_text(place, 0) + \"`\",\n      ),\n    },\n    ast.While { cond, body } => {\n      (head, inner, end) := (\n        codegen.label(mut g, \"while\"),\n        codegen.label(mut g, \"while.body\"),\n        codegen.label(mut g, \"while.end\"),\n      )\n      kept := codegen.decreases_start(mut g, body)\n      codegen.br(mut g, head)\n      codegen.block(mut g, head)\n      codegen.invariants(mut g, body)\n      codegen.push_transparent(mut g)\n      c := codegen.expr(mut g, cond)\n      if c.ty is check.TAny {\n        codegen.discard_scope(mut g)\n        return\n      }\n      codegen.pop_scope(mut g)\n      codegen.emit(\n        mut g,\n        f\"br i1 {c.op}, label %{inner}, label %{end}\",\n      )\n      codegen.block(mut g, inner)\n      mut g.loops.push((head, end, len(g.scopes)))\n      codegen.loop_step(mut g)\n      codegen.decreases_pass(\n        mut g,\n        body,\n        kept,\n        \"while \" + text.expr_text(cond, 0),\n      )\n      codegen.loop_body(mut g, body)\n      g.loops = take(g.loops, len(g.loops) - 1)\n      codegen.br(mut g, head)\n      codegen.block(mut g, end)\n    },\n    ast.Loop(body) => {\n      (head, end) := (\n        codegen.label(mut g, \"loop\"),\n        codegen.label(mut g, \"loop.end\"),\n      )\n      kept := codegen.decreases_start(mut g, body)\n      codegen.br(mut g, head)\n      codegen.block(mut g, head)\n      codegen.invariants(mut g, body)\n      mut g.loops.push((head, end, len(g.scopes)))\n      codegen.loop_step(mut g)\n      codegen.decreases_pass(mut g, body, kept, \"loop\")\n      codegen.loop_body(mut g, body)\n      g.loops = take(g.loops, len(g.loops) - 1)\n      codegen.br(mut g, head)\n      codegen.block(mut g, end)\n    },\n    ast.Break => match get(g.loops, len(g.loops) - 1) {\n      Some(l) => {\n        codegen.drop_from(mut g, l.2, \"\")\n        codegen.br(mut g, l.1)\n        codegen.dead(mut g)\n      },\n      None => codegen.not_yet(mut g, \"`break` outside a loop\"),\n    },\n    ast.Continue => match get(g.loops, len(g.loops) - 1) {\n      Some(l) => {\n        codegen.drop_from(mut g, l.2, \"\")\n        codegen.br(mut g, l.0)\n        codegen.dead(mut g)\n      },\n      None => codegen.not_yet(mut g, \"`continue` outside a loop\"),\n    },\n    ast.ExprStmt(x) => {\n      _ := codegen.expr(mut g, x)\n    },\n    ast.Assert(x) => codegen.assertion(mut g, x),\n    ast.Comment(_) => (),\n    // checked at the loop's head\n    ast.Invariant(_) => (),\n    ast.For { pat, iter, body } => codegen.for_loop(mut g, pat, iter, body),\n    ast.ComptimeFor { .. } => codegen.not_yet(mut g, \"`comptime for`\"),\n    _ => (),\n  }\n}","old_text":"/// `stmt` of `s`, compiled.\nfn stmt_node(mut g: codegen.Gen, s: ast.Stmt) {\n  // `--copies`: the statement's value, when it is the program's own code\n  // as written and not compiler-made\n  if g.copies {\n    e := match s {\n      ast.Let { value, .. } => value,\n      ast.VarDecl { value, .. } => value,\n      ast.Assign { value, .. } => value,\n      ast.ExprStmt(e) => e,\n      _ => ast.UnitExpr,\n    }\n    t := text.expr_text(e, 0)\n    if contains(g.sites, g.current + \"|\" + t)\n      || contains(g.sites, \"|\" + t) {\n      g.at = e\n    }\n  }\n  match s {\n    ast.Let { pat, ty, value } => match pat {\n      ast.Bind(n) => codegen.declare(mut g, n, ty, value, false),\n      // `let _: T = e`: the value is still checked against `T`\n      ast.Wild => match ty {\n        Some(x) => {\n          want := codegen.lower(mut g, x)\n          v := codegen.expr_want(mut g, value, want)\n          if !(v.ty is check.TAny) && codegen.needs_check(g, x) {\n            codegen.check_type(mut g, x, v, \"let binding\", [])\n          }\n        },\n        None => {\n          _ := codegen.expr(mut g, value)\n        },\n      },\n      other => codegen.destructure(mut g, other, ty, value),\n    },\n    ast.VarDecl { name, ty, value } => codegen.declare(mut g, name, ty, value, true),\n    ast.Assign { place: ast.Var(x), value: given } => {\n      // a refined element type: only the added elements are checked\n      (value, elements) := codegen.checked_update(mut g, ast.Var(x), given)\n      // `xs[i] = v`, `xs = set_at(xs, i, v)`: in place when nothing else\n      // holds `xs`, and only `v` checked against a refined element type\n      each := codegen.element_check(g, x, value)\n      mut whole := !elements\n      // `x = insert(x, …)`: in place when nothing else holds `x`.\n      // `x += e` on a list or string: extended in place when possible.\n      v := match codegen.set_in_place(mut g, ast.Var(x), value, each) {\n        Some(u) => {\n          whole = each is None\n          u\n        },\n        None => match codegen.update_in_place(mut g, ast.Var(x), value) {\n          Some(u) => u,\n          None => match codegen.appended(mut g, ast.Var(x), value) {\n            Some(u) => u,\n            None => codegen.expr(mut g, value),\n          },\n        },\n      }\n      if v.ty is check.TAny {\n        return\n      }\n      match codegen.lookup(g, x) {\n        Some(l0) => {\n          // a variable declared with a partly unknown type (`mut xs := []`)\n          // takes the type the value gives it\n          l := codegen.retype(mut g, l0, v.ty)\n          match get(g.declared, l.slot) {\n            Some(dt) => if whole {\n              codegen.check_type(\n                mut g,\n                dt,\n                v,\n                f\"assigning `{x}`\",\n                [],\n              )\n            },\n            None => (),\n          }\n          // the new value held, the old one dropped\n          x := codegen.converted(mut g, v, l.ty)\n          nv := codegen.take_value(mut g, codegen.V { ..x, ty: l.ty })\n          old := codegen.load(mut g, l)\n          codegen.store_var(mut g, nv, l)\n          codegen.drop_value(mut g, old)\n        },\n        None => codegen.not_yet(mut g, \"assigning to `\" + x + \"`\"),\n      }\n    },\n    ast.Assign { place, value: given } => match codegen.place_of(place) {\n      Some((x, path)) => {\n        (value, elements) := codegen.checked_update(mut g, place, given)\n        v := match codegen.update_in_place(mut g, place, value) {\n          Some(u) => u,\n          None => match codegen.appended(mut g, place, value) {\n            Some(u) => u,\n            None => codegen.expr(mut g, value),\n          },\n        }\n        if v.ty is check.TAny {\n          return\n        }\n        match codegen.lookup(g, x) {\n          Some(l) => {\n            g.elements_checked = elements\n            codegen.assign_at(mut g, l, x, path, v)\n            g.elements_checked = false\n          },\n          None => codegen.not_yet(\n            mut g,\n            \"assigning to `\" + text.expr_text(place, 0) + \"`\",\n          ),\n        }\n      },\n      None => codegen.not_yet(\n        mut g,\n        \"assigning to `\" + text.expr_text(place, 0) + \"`\",\n      ),\n    },\n    ast.While { cond, body } => {\n      (head, inner, end) := (\n        codegen.label(mut g, \"while\"),\n        codegen.label(mut g, \"while.body\"),\n        codegen.label(mut g, \"while.end\"),\n      )\n      kept := codegen.decreases_start(mut g, body)\n      codegen.br(mut g, head)\n      codegen.block(mut g, head)\n      codegen.invariants(mut g, body)\n      codegen.push_transparent(mut g)\n      c := codegen.expr(mut g, cond)\n      if c.ty is check.TAny {\n        codegen.discard_scope(mut g)\n        return\n      }\n      codegen.pop_scope(mut g)\n      codegen.emit(\n        mut g,\n        f\"br i1 {c.op}, label %{inner}, label %{end}\",\n      )\n      codegen.block(mut g, inner)\n      mut g.loops.push((head, end, len(g.scopes)))\n      codegen.loop_step(mut g)\n      codegen.decreases_pass(\n        mut g,\n        body,\n        kept,\n        \"while \" + text.expr_text(cond, 0),\n      )\n      codegen.loop_body(mut g, body)\n      g.loops = take(g.loops, len(g.loops) - 1)\n      codegen.br(mut g, head)\n      codegen.block(mut g, end)\n    },\n    ast.Loop(body) => {\n      (head, end) := (\n        codegen.label(mut g, \"loop\"),\n        codegen.label(mut g, \"loop.end\"),\n      )\n      kept := codegen.decreases_start(mut g, body)\n      codegen.br(mut g, head)\n      codegen.block(mut g, head)\n      codegen.invariants(mut g, body)\n      mut g.loops.push((head, end, len(g.scopes)))\n      codegen.loop_step(mut g)\n      codegen.decreases_pass(mut g, body, kept, \"loop\")\n      codegen.loop_body(mut g, body)\n      g.loops = take(g.loops, len(g.loops) - 1)\n      codegen.br(mut g, head)\n      codegen.block(mut g, end)\n    },\n    ast.Break => match get(g.loops, len(g.loops) - 1) {\n      Some(l) => {\n        codegen.drop_from(mut g, l.2, \"\")\n        codegen.br(mut g, l.1)\n        codegen.dead(mut g)\n      },\n      None => codegen.not_yet(mut g, \"`break` outside a loop\"),\n    },\n    ast.Continue => match get(g.loops, len(g.loops) - 1) {\n      Some(l) => {\n        codegen.drop_from(mut g, l.2, \"\")\n        codegen.br(mut g, l.0)\n        codegen.dead(mut g)\n      },\n      None => codegen.not_yet(mut g, \"`continue` outside a loop\"),\n    },\n    ast.ExprStmt(x) => {\n      _ := codegen.expr(mut g, x)\n    },\n    ast.Assert(x) => codegen.assertion(mut g, x),\n    ast.Comment(_) => (),\n    // checked at the loop's head\n    ast.Invariant(_) | ast.Decreases(_) => (),\n    ast.For { pat, iter, body } => codegen.for_loop(mut g, pat, iter, body),\n    ast.ComptimeFor { .. } => codegen.not_yet(mut g, \"`comptime for`\"),\n  }\n}"}]}
{"id":"79ccc60efcd02bc6","time":1795664524,"message":"edit","changes":[{"name":"eval.stmt","kind":"fn","old":"202edab290ddcd88","new":"68b5f5ba21107a39","interface_changed":false,"affected":[],"module":"eval","text":"fn stmt(\n  mut st: eval.State,\n  w: eval.World,\n  s: ast.Stmt,\n) -> Result[(), eval.Escape] {\n  match s {\n    ast.Let { pat, ty, value } => {\n      v0 := eval.eval(mut st, w, value)!\n      v := match ty {\n        Some(t) => eval.typed(t, v0),\n        None => v0,\n      }\n      match ty {\n        Some(t) => eval.check(mut st, w, t, v, \"let binding\")!,\n        None => (),\n      }\n      match eval.matches(mut st, w, pat, v)! {\n        Some(bs) => {\n          for b in bs {\n            eval.bind(mut st, b.0, b.1)\n          }\n          Ok(())\n        },\n        None => Err(eval.runtime(\n          \"the value \" + eval.code(v) + \" doesn't fit the pattern\",\n        )),\n      }\n    },\n    ast.VarDecl { name, ty, value } => {\n      v0 := eval.eval(mut st, w, value)!\n      v := match ty {\n        Some(t) => eval.typed(t, v0),\n        None => v0,\n      }\n      match ty {\n        Some(t) => {\n          eval.check(mut st, w, t, v, \"assigning `\" + name + \"`\")!\n          eval.bind_typed(mut st, name, v, t)\n        },\n        None => eval.bind(mut st, name, v),\n      }\n      Ok(())\n    },\n    ast.Assign { place, value } => {\n      v := eval.eval(mut st, w, value)!\n      eval.assign(mut st, w, place, v)\n    },\n    ast.While { cond, body } => {\n      eval.invariants_hold(mut st, w, body)!\n      while eval.truth(eval.eval(mut st, w, cond)!)! {\n        eval.stepped(mut st)!\n        match eval.eval(mut st, w, body) {\n          Ok(_) => (),\n          Err(eval.LoopBreak) => return Ok(()),\n          Err(eval.LoopContinue) => (),\n          Err(x) => return Err(x),\n        }\n        eval.invariants_hold(mut st, w, body)!\n      }\n      Ok(())\n    },\n    ast.For { pat, iter, body } => {\n      v := eval.eval(mut st, w, iter)!\n      eval.each(mut st, w, pat, v, body)\n    },\n    ast.Loop(body) => {\n      loop {\n        eval.stepped(mut st)!\n        eval.invariants_hold(mut st, w, body)!\n        match eval.eval(mut st, w, body) {\n          Ok(_) => (),\n          Err(eval.LoopBreak) => return Ok(()),\n          Err(eval.LoopContinue) => (),\n          Err(x) => return Err(x),\n        }\n      }\n      Ok(())\n    },\n    ast.Break => Err(eval.LoopBreak),\n    ast.Continue => Err(eval.LoopContinue),\n    ast.ExprStmt(x) => {\n      _ := eval.eval(mut st, w, x)!\n      Ok(())\n    },\n    ast.Assert(x) => eval.holds(mut st, w, x, \"assertion failed\"),\n    // checked at the loop's head (`invariants_hold`)\n    ast.Invariant(_) => Ok(()),\n    ast.Comment(_) => Ok(()),\n    ast.ComptimeFor { .. } => Err(\n      eval.runtime(\"`comptime for` isn't run by this evaluator yet\"),\n    ),\n    _ => Ok(()),\n  }\n}","old_text":"fn stmt(\n  mut st: eval.State,\n  w: eval.World,\n  s: ast.Stmt,\n) -> Result[(), eval.Escape] {\n  match s {\n    ast.Let { pat, ty, value } => {\n      v0 := eval.eval(mut st, w, value)!\n      v := match ty {\n        Some(t) => eval.typed(t, v0),\n        None => v0,\n      }\n      match ty {\n        Some(t) => eval.check(mut st, w, t, v, \"let binding\")!,\n        None => (),\n      }\n      match eval.matches(mut st, w, pat, v)! {\n        Some(bs) => {\n          for b in bs {\n            eval.bind(mut st, b.0, b.1)\n          }\n          Ok(())\n        },\n        None => Err(eval.runtime(\n          \"the value \" + eval.code(v) + \" doesn't fit the pattern\",\n        )),\n      }\n    },\n    ast.VarDecl { name, ty, value } => {\n      v0 := eval.eval(mut st, w, value)!\n      v := match ty {\n        Some(t) => eval.typed(t, v0),\n        None => v0,\n      }\n      match ty {\n        Some(t) => {\n          eval.check(mut st, w, t, v, \"assigning `\" + name + \"`\")!\n          eval.bind_typed(mut st, name, v, t)\n        },\n        None => eval.bind(mut st, name, v),\n      }\n      Ok(())\n    },\n    ast.Assign { place, value } => {\n      v := eval.eval(mut st, w, value)!\n      eval.assign(mut st, w, place, v)\n    },\n    ast.While { cond, body } => {\n      eval.invariants_hold(mut st, w, body)!\n      while eval.truth(eval.eval(mut st, w, cond)!)! {\n        eval.stepped(mut st)!\n        match eval.eval(mut st, w, body) {\n          Ok(_) => (),\n          Err(eval.LoopBreak) => return Ok(()),\n          Err(eval.LoopContinue) => (),\n          Err(x) => return Err(x),\n        }\n        eval.invariants_hold(mut st, w, body)!\n      }\n      Ok(())\n    },\n    ast.For { pat, iter, body } => {\n      v := eval.eval(mut st, w, iter)!\n      eval.each(mut st, w, pat, v, body)\n    },\n    ast.Loop(body) => {\n      loop {\n        eval.stepped(mut st)!\n        eval.invariants_hold(mut st, w, body)!\n        match eval.eval(mut st, w, body) {\n          Ok(_) => (),\n          Err(eval.LoopBreak) => return Ok(()),\n          Err(eval.LoopContinue) => (),\n          Err(x) => return Err(x),\n        }\n      }\n      Ok(())\n    },\n    ast.Break => Err(eval.LoopBreak),\n    ast.Continue => Err(eval.LoopContinue),\n    ast.ExprStmt(x) => {\n      _ := eval.eval(mut st, w, x)!\n      Ok(())\n    },\n    ast.Assert(x) => eval.holds(mut st, w, x, \"assertion failed\"),\n    // checked at the loop's head (`invariants_hold`)\n    ast.Invariant(_) | ast.Decreases(_) => Ok(()),\n    ast.Comment(_) => Ok(()),\n    ast.ComptimeFor { .. } => Err(\n      eval.runtime(\"`comptime for` isn't run by this evaluator yet\"),\n    ),\n  }\n}"}]}
{"id":"a77a086512b114cb","time":1795664532,"message":"edit","changes":[{"name":"smt.stmt","kind":"fn","old":"a63c61cff9ee15bd","new":"a16bf131cf5cb484","interface_changed":false,"affected":[],"module":"smt","text":"fn stmt(mut vc: smt.Vc, s: ast.Stmt) {\n  match s {\n    ast.Comment(_) | ast.ComptimeFor { .. } | ast.Invariant(_) => (),\n    ast.ExprStmt(e) => {\n      _ := smt.eval(mut vc, e)\n    },\n    ast.Let { pat, ty, value } => {\n      // a dict or set literal: of the type the `let` says\n      saved := vc.want\n      match (ty, value) {\n        (Some(t), ast.Call { args: [x], .. }) => {\n          vc.want = Some((x, t))\n        },\n        _ => (),\n      }\n      v := smt.eval(mut vc, value)\n      vc.want = saved\n      smt.annotated(mut vc, ty, v)\n      match pat {\n        ast.Bind(x) => smt.declare(mut vc, x, ty),\n        _ => (),\n      }\n      mut binds := []\n      c := smt.pattern(mut vc, pat, v, mut binds)\n      mut vc.pc.push(c)\n      for (x, b) in binds {\n        smt.bind(mut vc, x, b)\n      }\n    },\n    ast.VarDecl { name, ty, value } => {\n      v := smt.eval(mut vc, value)\n      smt.annotated(mut vc, ty, v)\n      smt.declare(mut vc, name, ty)\n      smt.bind(mut vc, name, v)\n    },\n    ast.Assign { place, value } => {\n      v := smt.eval(mut vc, value)\n      smt.assign(mut vc, place, v, \"assigning\")\n    },\n    ast.Assert(e) => {\n      v := smt.eval(mut vc, e)\n      b := smt.as_bool(mut vc, v)\n      if smt.start_goal(mut vc) {\n        smt.oblige(mut vc, \"assert \" + text.expr_text(e, 0), b)\n      }\n    },\n    ast.While { cond, body } => smt.while_loop(mut vc, cond, body),\n    ast.For { pat, iter, body } => smt.for_loop(mut vc, pat, iter, body),\n    ast.Loop(body) => smt.plain_loop(mut vc, body),\n    ast.Break => smt.jump(mut vc, true),\n    ast.Continue => smt.jump(mut vc, false),\n    _ => (),\n  }\n}","old_text":"fn stmt(mut vc: smt.Vc, s: ast.Stmt) {\n  match s {\n    ast.Comment(_) | ast.ComptimeFor { .. } | ast.Invariant(_) | ast.Decreases(_) => (),\n    ast.ExprStmt(e) => {\n      _ := smt.eval(mut vc, e)\n    },\n    ast.Let { pat, ty, value } => {\n      // a dict or set literal: of the type the `let` says\n      saved := vc.want\n      match (ty, value) {\n        (Some(t), ast.Call { args: [x], .. }) => {\n          vc.want = Some((x, t))\n        },\n        _ => (),\n      }\n      v := smt.eval(mut vc, value)\n      vc.want = saved\n      smt.annotated(mut vc, ty, v)\n      match pat {\n        ast.Bind(x) => smt.declare(mut vc, x, ty),\n        _ => (),\n      }\n      mut binds := []\n      c := smt.pattern(mut vc, pat, v, mut binds)\n      mut vc.pc.push(c)\n      for (x, b) in binds {\n        smt.bind(mut vc, x, b)\n      }\n    },\n    ast.VarDecl { name, ty, value } => {\n      v := smt.eval(mut vc, value)\n      smt.annotated(mut vc, ty, v)\n      smt.declare(mut vc, name, ty)\n      smt.bind(mut vc, name, v)\n    },\n    ast.Assign { place, value } => {\n      v := smt.eval(mut vc, value)\n      smt.assign(mut vc, place, v, \"assigning\")\n    },\n    ast.Assert(e) => {\n      v := smt.eval(mut vc, e)\n      b := smt.as_bool(mut vc, v)\n      if smt.start_goal(mut vc) {\n        smt.oblige(mut vc, \"assert \" + text.expr_text(e, 0), b)\n      }\n    },\n    ast.While { cond, body } => smt.while_loop(mut vc, cond, body),\n    ast.For { pat, iter, body } => smt.for_loop(mut vc, pat, iter, body),\n    ast.Loop(body) => smt.plain_loop(mut vc, body),\n    ast.Break => smt.jump(mut vc, true),\n    ast.Continue => smt.jump(mut vc, false),\n  }\n}"}]}
{"id":"669ba67dfe5bda90","time":1795664534,"message":"edit","changes":[{"name":"text.stmt_text","kind":"fn","old":"796f2a1d3c539dee","new":"297ac255de60627d","interface_changed":false,"affected":[],"module":"text","text":"fn stmt_text(s: ast.Stmt, d: Int) -> String {\n  match s {\n    ast.Let { pat, ty, value } => match ty {\n      Some(t) => \"let \"\n        + text.pattern_text(pat)\n        + \": \"\n        + text.type_text(t)\n        + \" = \"\n        + text.expr_text(value, d),\n      None => text.pattern_text(pat) + \" := \" + text.expr_text(value, d),\n    },\n    ast.VarDecl { name, ty, value } => match ty {\n      Some(t) => \"mut \"\n        + name\n        + \": \"\n        + text.type_text(t)\n        + \" = \"\n        + text.expr_text(value, d),\n      None => \"mut \" + name + \" := \" + text.expr_text(value, d),\n    },\n    ast.Assign { place, value } => match value {\n      // `x = x + e` is written `x += e`\n      ast.Binary { op, left, right } => if left == place\n        && (op == ast.Add\n          || op == ast.Sub\n          || op == ast.Mul\n          || op == ast.Div\n          || op == ast.Mod) {\n        text.expr_text(place, d)\n          + \" \"\n          + text.symbol(op)\n          + \"= \"\n          + text.expr_text(right, d)\n      } else {\n        text.expr_text(place, d) + \" = \" + text.expr_text(value, d)\n      },\n      _ => text.expr_text(place, d) + \" = \" + text.expr_text(value, d),\n    },\n    ast.While { cond, body } => \"while \"\n      + text.head(cond, d)\n      + text.clauses_text(body, d)\n      + \" \"\n      + text.block_text(text.without_clauses(body), d),\n    ast.Loop(body) => \"loop\"\n      + text.clauses_text(body, d)\n      + \" \"\n      + text.block_text(text.without_clauses(body), d),\n    ast.Break => \"break\",\n    ast.Continue => \"continue\",\n    ast.For { pat, iter, body } => \"for \"\n      + text.pattern_text(pat)\n      + \" in \"\n      + text.head(iter, d)\n      + text.clauses_text(body, d)\n      + \" \"\n      + text.block_text(text.without_clauses(body), d),\n    ast.ComptimeFor { pat, iter, body } => \"comptime for \"\n      + text.pattern_text(pat)\n      + \" in \"\n      + text.head(iter, d)\n      + \" \"\n      + text.block_text(body, d),\n    ast.ExprStmt(x) => text.expr_text(x, d),\n    ast.Assert(x) => \"assert \" + text.expr_text(x, d),\n    // only first in a loop's body, where `clauses_text` takes it\n    ast.Invariant(x) => text.assumed_word(x)\n      + \"invariant \"\n      + text.expr_text(ast.unassumed(x), d),\n    ast.Comment(cs) => join(cs, \"\\n\"),\n    _ => match s {\n      ast.Decreases(x) => \"decreases \" + text.expr_text(x, d),\n      _ => \"\",\n    },\n  }\n}","old_text":"fn stmt_text(s: ast.Stmt, d: Int) -> String {\n  match s {\n    ast.Let { pat, ty, value } => match ty {\n      Some(t) => \"let \"\n        + text.pattern_text(pat)\n        + \": \"\n        + text.type_text(t)\n        + \" = \"\n        + text.expr_text(value, d),\n      None => text.pattern_text(pat) + \" := \" + text.expr_text(value, d),\n    },\n    ast.VarDecl { name, ty, value } => match ty {\n      Some(t) => \"mut \"\n        + name\n        + \": \"\n        + text.type_text(t)\n        + \" = \"\n        + text.expr_text(value, d),\n      None => \"mut \" + name + \" := \" + text.expr_text(value, d),\n    },\n    ast.Assign { place, value } => match value {\n      // `x = x + e` is written `x += e`\n      ast.Binary { op, left, right } => if left == place\n        && (op == ast.Add\n          || op == ast.Sub\n          || op == ast.Mul\n          || op == ast.Div\n          || op == ast.Mod) {\n        text.expr_text(place, d)\n          + \" \"\n          + text.symbol(op)\n          + \"= \"\n          + text.expr_text(right, d)\n      } else {\n        text.expr_text(place, d) + \" = \" + text.expr_text(value, d)\n      },\n      _ => text.expr_text(place, d) + \" = \" + text.expr_text(value, d),\n    },\n    ast.While { cond, body } => \"while \"\n      + text.head(cond, d)\n      + text.clauses_text(body, d)\n      + \" \"\n      + text.block_text(text.without_clauses(body), d),\n    ast.Loop(body) => \"loop\"\n      + text.clauses_text(body, d)\n      + \" \"\n      + text.block_text(text.without_clauses(body), d),\n    ast.Break => \"break\",\n    ast.Continue => \"continue\",\n    ast.For { pat, iter, body } => \"for \"\n      + text.pattern_text(pat)\n      + \" in \"\n      + text.head(iter, d)\n      + text.clauses_text(body, d)\n      + \" \"\n      + text.block_text(text.without_clauses(body), d),\n    ast.ComptimeFor { pat, iter, body } => \"comptime for \"\n      + text.pattern_text(pat)\n      + \" in \"\n      + text.head(iter, d)\n      + \" \"\n      + text.block_text(body, d),\n    ast.ExprStmt(x) => text.expr_text(x, d),\n    ast.Assert(x) => \"assert \" + text.expr_text(x, d),\n    // only first in a loop's body, where `clauses_text` takes it\n    ast.Invariant(x) => text.assumed_word(x)\n      + \"invariant \"\n      + text.expr_text(ast.unassumed(x), d),\n    ast.Decreases(x) => \"decreases \" + text.expr_text(x, d),\n    ast.Comment(cs) => join(cs, \"\\n\"),\n  }\n}"}]}
