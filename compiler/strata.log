 ?? check.TAny)\n    if x.ty is check.TAny {\n      return codegen.never()\n    }\n    mut vs.push(x)\n  }\n  codegen.call_at(mut g, rt, sym, vs)\n}","old_text":"/// `v.name(args)` where `v`'s mock type leaves the method out: the mock's\n/// generated result (`mock_method`, with `v` as its slot).\nfn mock_call(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  tr: String,\n  m: ast.FnDecl,\n  args: List[ast.Expr],\n) -> codegen.V {\n  sym := codegen.mock_method(mut g, tr, m)\n  saved := g.sub\n  mut g.sub.insert(\"Self\", TTrait(tr))\n  mut ps := []\n  for p in drop(m.params, 1) {\n    mut ps.push(codegen.lower(mut g, p.ty))\n  }\n  written := codegen.self_is(\n    m.ret,\n    Dict[String, ast.TypeExpr] { \"Self\": ast.Named { name: tr, args: [] } },\n  )\n  rt := codegen.lower(mut g, written)\n  g.sub = saved\n  mut vs := [codegen.V { ty: TInt, op: codegen.to_slot(mut g, v) }]\n  for (i, a) in enumerate(args) {\n    x := codegen.wanted(mut g, a, get(ps, i) ?? TAny)\n    if x.ty is TAny {\n      return codegen.never()\n    }\n    mut vs.push(x)\n  }\n  codegen.call_at(mut g, rt, sym, vs)\n}"},{"name":"codegen.retype_temp","kind":"fn","old":"fb02f935acdd804d","new":"5a1df918d9cf98ba","interface_changed":true,"affected":["codegen.converted","codegen.list_builtin","codegen.collection_builtin","codegen.list_literal_of","codegen.produce","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.update_in_place","codegen.table_find","codegen.set_in_place","codegen.take_in_place","codegen.expr_want_node","codegen.stmt_node","codegen.builtin","codegen.gen_list","codegen.list_literal","codegen.gen_fn","codegen.construct","codegen.operands","codegen.binary","codegen.builtin_call","codegen.branch_value","codegen.mock_call","codegen.expr_want","codegen.stmt","codegen.call_named","codegen.push_in_place","codegen.expr_node","codegen.generated","codegen.can_generate","codegen.main_arg","codegen.session_capability","codegen.for_loop","codegen.union_call","codegen.dyn_gene