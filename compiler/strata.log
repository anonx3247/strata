"termination.ctor_member","termination.field_type","termination.element_calls","termination.element_builtin","termination.is_list","termination.site_type","termination.in_scope","termination.bind_site","termination.scope_walk","search_invariants","build_proofs","verify_file","live_edit_command","alongside_command","strata_command","graph_command","graph_diff","command_line","verify_command","termination.measure_next","termination.loop_next","termination.loop_answered","termination.measure_answered","edit_file","apply_edit","fix_loops","run_command","std_proofs","main","repl_command","edit_command","edit_in_editor","new_command","fix_command","std_library","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","check_command","test_command","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","build_core_command","comptime_value","literal_errors_of","graph_runs","replay","jit_file","fuzz_file","codegen_file","program_objects","comptime_values","loaded_check","file_errors","edit_errors","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","apply_change","with_base","package_errors","rename_command","move_command"],"module":"smt","text":"/// A builtin's signature (core's `builtin fn`): name, type parameters,\n/// result type, whether it is total (no `requires`), and its parameters'\n/// types.\npub type BuiltinSig = {\n  name: String,\n  type_params: List[String],\n  ret: ast.TypeExpr,\n  total: Bool,\n  params: List[ast.TypeExpr] = [],\n}","old_text":"/// A builtin's signature (core's `builtin fn`): name, type parameters,\n/// result type, and whether it is total (no `requires`).\npub type BuiltinSig = {\n  name: String,\n  type_params: List[String],\n  ret: ast.TypeExpr,\n  total: Bool,\n}"},{"name":"smt.builtins_of","kind":"fn","old":"fb6349ddb8098a40","new":"6036c0ed53cd38f0","interface_changed":false,"affected":[],"module":"smt","text":"/// The builtins' signatures among definitions (core's `builtin fn`s).\npub fn builtins_of(decls: List[ast.Decl]) -> List[smt.BuiltinSig] {\n  mut out := []\n  for d in decls {\n    match d.kind {\n      ast.ExternDef(ast.ExternDecl { lang: ast.Builtin, item: ast.ExternFn(f) }) => {\n        // raw memory (core.mem) is never total, since nothing checks an\n        // address. Neither are the builtins listed here, whose contracts\n        // aren't written.\n        mut out.push(\n          smt.BuiltinSig {\n            name: f.name,\n            type_params: f.type_params,\n            ret: f.ret,\n            params: f.params.map(p -> p.ty),\n            total: len(f.pre) == 0\n              && d.module != \"core.mem\"\n              && !contains([\n                \"matches\",\n                \"channel_send\",\n                \"channel_recv\",\n                \"channel_close\",\n              ], f.name),\n          },\n        )\n      },\n      _ => (),\n    }\n  }\n  out\n}","old_text":"/// The builtins' signatures among definitions (core's `builtin fn`s).\npub fn builtins_of(decls: List[ast.Decl]) -> List[smt.BuiltinSig] {\n  mut out := []\n  for d in decls {\n    match d.kind {\n      ast.ExternDef(ast.ExternDecl { lang: ast.Builtin, item: ast.ExternFn(f) }) => {\n        // raw memory (core.mem) is never total, since nothing checks an\n        // address. Neither are the builtins listed here, whose contracts\n        // aren't written.\n        mut out.push(\n          smt.BuiltinSig {\n            name: f.name,\n            type_params: f.type_params,\n            ret: f.ret,\n            total: len(f.pre) == 0\n              && d.module != \"core.mem\"\n              && !contains([\n                \"matches\",\n                \"channel_send\",\n                \"channel_recv\",\n                \"channel_close\",\n              ], f.name),\n          },\n        )\n      },\n      _ => (),\n    }\n  }\n  out\n}"}]}
{"id":"0340105ae87305ad","time":1795826821,"message":"termination: types of builtin calls whose overload is certain, and of matches and ifs","changes":[{"name":"termination.expr_type","kind":"fn","old":"d064f38d17330404","new":"390eb826bde49b46","interface_changed":false,"affected":[],"module":"termination","text":"/// The type of `e`, as far as the code says it: a variable by its type in\n/// `env`, a call of a function of the program whose result type names none\n/// of its type parameters, a builtin's call (`builtin_result`), a record\n/// built by name, a field of a record, a tuple or list of those, or a\n/// `match` or `if` whose branches agree (`joined`).\nfn expr_type(\n  ctx: termination.Ctx,\n  env: Dict[String, ast.TypeExpr],\n  e: ast.Expr,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0 {\n    return None\n  }\n  match e {\n    ast.Var(n) => get(env, n),\n    ast.Call { callee: ast.Var(g), args } => match get(ctx.fns, g) {\n      Some(d) => if termination.names_any(d.ret, d.type_params + [\"Self\"]) {\n        None\n      } else {\n        Some(d.ret)\n      },\n      None => if contains(env, g) {\n        None\n      } else {\n        termination.builtin_result(ctx, env, g, args, fuel - 1)\n      },\n    },\n    ast.MethodCall { recv, name, args } => termination.builtin_result(\n      ctx,\n      env,\n      name,\n      [recv] + args,\n      fuel - 1,\n    ),\n    ast.ListExpr(es) => Some(ast.Named { name: \"List\", args: match termination.joined(\n      ctx,\n      es.map(x -> termination.expr_type(ctx, env, x, fuel - 1)),\n    ) {\n      Some(t) => [t],\n      None => [],\n    } }),\n    ast.IfExpr { then, otherwise, .. } => termination.joined(ctx, [then, otherwise]\n      .filter(x -> !(x is ast.Return))\n      .map(x -> termination.expr_type(ctx, env, x, fuel - 1))),\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      v := match binding {\n        Some(b) => termination.bind_site(\n          ctx,\n          env,\n          ast.Bind(b),\n          termination.SiteOf(scrutinee),\n        ),\n        None => env,\n      }\n      termination.joined(ctx, arms\n        .filter(a -> !(a.body is ast.Return))\n        .map(a -> termination.expr_type(\n          ctx,\n          termination.bind_site(\n            ctx,\n            v,\n            a.pat,\n            termination.SitePiece {\n              pat: a.pat,\n              ty: None,\n              of: scrutinee,\n            },\n          ),\n          a.body,\n          fuel - 1,\n        )))\n    },\n    ast.Block { stmts: [], last } => termination.expr_type(ctx, env, last, fuel - 1),\n    ast.CtorExpr { name, .. } => match get(ctx.types, name) {\n      Some(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          Some(ast.Named { name, args: [] })\n        } else {\n          None\n        },\n        _ => None,\n      },\n      None => None,\n    },\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, env, base, fuel - 1) {\n      Some(t) => termination.field_type(ctx, t, name),\n      None => None,\n    },\n    ast.TupleExpr(es) => {\n      ts := es.map(x -> termination.expr_type(ctx, env, x, fuel - 1))\n      if ts.all(t -> !(t is None)) {\n        Some(ast.Named {\n          name: \"Tuple\",\n          args: ts.map(t -> t ?? ast.UnitType),\n        })\n      } else {\n        None\n      }\n    },\n    _ => None,\n  }\n}","old_text":"/// The type of `e`, as far as the code says it: a variable by its type in\n/// `env`, a call of a function of the program whose result\n/// type names none of its type parameters, a record built by name, a\n/// field of a record, or a tuple of those.\nfn expr_type(\n  ctx: termination.Ctx,\n  env: Dict[String, ast.TypeExpr],\n  e: ast.Expr,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0 {\n    return None\n  }\n  match e {\n    ast.Var(n) => get(env, n),\n    ast.Call { callee: ast.Var(g), .. } => match get(ctx.fns, g) {\n      Some(d) => if termination.names_any(d.ret, d.type_params + [\"Self\"]) {\n        None\n      } else {\n        Some(d.ret)\n      },\n      None => None,\n    },\n    ast.CtorExpr { name, .. } => match get(ctx.types, name) {\n      Some(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          Some(ast.Named { name, args: [] })\n        } else {\n          None\n        },\n        _ => None,\n      },\n      None => None,\n    },\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, env, base, fuel - 1) {\n      Some(t) => termination.field_type(ctx, t, name),\n      None => None,\n    },\n    ast.TupleExpr(es) => {\n      ts := es.map(x -> termination.expr_type(ctx, env, x, fuel - 1))\n      if ts.all(t -> !(t is None)) {\n        Some(ast.Named {\n          name: \"Tuple\",\n          args: ts.map(t -> t ?? ast.UnitType),\n        })\n      } else {\n        None\n      }\n    },\n    _ => None,\n  }\n}"},{"name":"termination.joined","kind":"fn","old":null,"new":"e69fa5574d3ceb95","interface_changed":true,"affected":[],"module":"termination","text":"/// The type of branches that each have one: the same type, or for lists\n/// of different element types, a `List` with no element type.\nfn joined(\n  ctx: termination.Ctx,\n  ts: List[Option[ast.TypeExpr]],\n) -> Option[ast.TypeExpr] {\n  first := match get(ts, 0) {\n    Some(Some(t)) => t,\n    _ => return None,\n  }\n  if ts.all(x -> x == Some(first)) {\n    Some(first)\n  } else if ts.all(\n    x -> match x {\n      Some(t) => termination.short(\n        termination.head(termination.expand_alias(ctx, t)),\n      ) == \"List\",\n      None => false,\n    },\n  ) {\n    Some(ast.Named { name: \"List\", args: [] })\n  } else {\n    None\n  }\n}"},{"name":"termination.builtin_result","kind":"fn","old":null,"new":"80b8d535d3a4f3a3","interface_changed":true,"affected":[],"module":"termination","text":"/// The result type of a call of the builtin `name` with `args` (the\n/// receiver first), when no function, method or trait method of the\n/// program has the name, and every builtin of the name that the arguments'\n/// known types don't rule out gives the same result.\nfn builtin_result(\n  ctx: termination.Ctx,\n  env: Dict[String, ast.TypeExpr],\n  name: String,\n  args: List[ast.Expr],\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0\n    || contains(ctx.fns, name)\n    || termination.own_methods_named(ctx, name) != []\n    || termination.is_method(ctx, name) {\n    return None\n  }\n  ats := args.map(a -> termination.expr_type(ctx, env, a, fuel - 1))\n  results := ctx.sigs\n    .filter(s -> s.name == name && len(s.params) == len(args))\n    .map(s -> termination.sig_result(ctx, s, ats))\n    .filter(r -> r != Some(None))\n  match get(results, 0) {\n    Some(Some(Some(t))) => if results.all(r -> r == Some(Some(t))) {\n      Some(t)\n    } else {\n      None\n    },\n    _ => None,\n  }\n}"},{"name":"termination.sig_result","kind":"fn","old":null,"new":"0a9a735b071903aa","interface_changed":true,"affected":[],"module":"termination","text":"/// What the builtin `s` gives for arguments of types `ats` (`None` where\n/// not known): `Some(None)` when a known type rules it out, `None` when its\n/// result type isn't known, else `Some(Some(result))`.\nfn sig_result(\n  ctx: termination.Ctx,\n  s: smt.BuiltinSig,\n  ats: List[Option[ast.TypeExpr]],\n) -> Option[Option[ast.TypeExpr]] {\n  mut binds := Dict[String, ast.TypeExpr] {}\n  for (p, a) in zip(s.params, ats) {\n    match a {\n      Some(t) => match termination.bind_params(ctx, s.type_params, p, t, binds) {\n        Some(b) => {\n          binds = b\n        },\n        None => return Some(None),\n      },\n      None => (),\n    }\n  }\n  if values(binds).contains(ast.Named { name: \"$conflict\", args: [] }) {\n    None\n  } else if s.type_params.all(tp -> contains(binds, tp)) {\n    bs := items(binds)\n    Some(Some(termination.substitute(\n      s.ret,\n      bs.map(x -> x.0),\n      bs.map(x -> x.1),\n    )))\n  } else if termination.names_any(s.ret, s.type_params) {\n    None\n  } else {\n    Some(Some(s.ret))\n  }\n}"},{"name":"termination.bind_params","kind":"fn","old":null,"new":"a466c3ef8a877d81","interface_changed":true,"affected":[],"module":"termination","text":"/// `binds` with the type parameters `tps` in `p` bound to the types they\n/// stand for in `t`, or `None` when `t` can't be a `p`: their heads are\n/// different types (`type_head_known`). A parameter that would stand for\n/// two types is bound to `$conflict`.\nfn bind_params(\n  ctx: termination.Ctx,\n  tps: List[String],\n  p: ast.TypeExpr,\n  t: ast.TypeExpr,\n  binds: Dict[String, ast.TypeExpr],\n) -> Option[Dict[String, ast.TypeExpr]] {\n  u := termination.expand_alias(ctx, t)\n  pe := termination.expand_alias(ctx, p)\n  (name, pas) := match pe {\n    ast.Named { name, args } => (name, args),\n    _ => return Some(binds),\n  }\n  if pas == [] && tps.contains(name) {\n    mut out := binds\n    match get(binds, name) {\n      Some(b) => if b != u {\n        mut out.insert(name, ast.Named { name: \"$conflict\", args: [] })\n      },\n      None => mut out.insert(name, u),\n    }\n    return Some(out)\n  }\n  (m, tas) := match u {\n    ast.Named { name, args } => (name, args),\n    _ => return Some(binds),\n  }\n  if termination.short(m) != termination.short(name)\n    || len(pas) != len(tas) {\n    return if termination.short(m) != termination.short(name)\n      && termination.type_head_known(ctx, m)\n      && termination.type_head_known(ctx, name) {\n      None\n    } else {\n      Some(binds)\n    }\n  }\n  mut out := binds\n  for (pa, ta) in zip(pas, tas) {\n    out = termination.bind_params(ctx, tps, pa, ta, out)?\n  }\n  Some(out)\n}"},{"name":"termination.type_head_known","kind":"fn","old":null,"new":"161c4589233836c5","interface_changed":true,"affected":[],"module":"termination","text":"/// Whether `h` names a type (not a trait): one of the program's or a\n/// builtin one.\nfn type_head_known(ctx: termination.Ctx, h: String) -> Bool {\n  contains(ctx.types, h)\n    || [\n      \"List\",\n      \"Dict\",\n      \"Set\",\n      \"String\",\n      \"Int\",\n      \"Float\",\n      \"Bool\",\n      \"Tuple\",\n      \"Real\",\n      \"I8\",\n      \"I16\",\n      \"I32\",\n      \"I64\",\n      \"U8\",\n      \"U16\",\n      \"U32\",\n      \"U64\",\n    ].contains(\n      termination.short(h),\n    )\n}"}]}
{"id":"8228002b6d59367b","time":1795827074,"message":"termination: a for over a value judged by its type when the code says it","changes":[{"name":"termination.source_of","kind":"fn","old":"f40eb30e6397efb2","new":"f8aaebd8b6d5a4fc","interface_changed":false,"affected":[],"module":"termination","text":"/// What a `for` over `e` in `f` runs over. A lazy `map`, `filter`, `drop`,\n/// `enumerate`, `reverse` or `sort` is as finite as what it is called on;\n/// `take`, `slice`, `to_list` and `iter` always are. A variable bound once\n/// is judged by its value, any variable by its type in `env`\n/// (`in_scope`), a call by its result type, and what is left to the\n/// value by its type when the code says it (`expr_type`). `lets`: the body's\n/// `let`s and\n/// `mut` declarations.\nfn source_of(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  env: Dict[String, ast.TypeExpr],\n  e: ast.Expr,\n  lets: List[(String, ast.Expr)],\n  once: Set[String],\n  fuel: Int,\n) -> termination.Source {\n  if fuel <= 0 {\n    return termination.SourceUnknown(\"`\"\n      + text.expr_text(e, 0)\n      + \"`, reached through more `let`s than are followed\")\n  }\n  by_code := match e {\n    ast.MethodCall { recv, name, args } => termination.source_call(\n      ctx,\n      f,\n      env,\n      e,\n      name,\n      [recv] + args,\n      lets,\n      once,\n      fuel,\n    ),\n    ast.Call { callee: ast.Var(n), args } => match get(ctx.fns, n) {\n      Some(g) => termination.source_type(ctx, g.type_params, g.bounds, g.ret),\n      None => if contains(once, n) || f.params.any(p -> p.name == n) {\n        termination.SourceByValue\n      } else {\n        termination.source_call(\n          ctx,\n          f,\n          env,\n          e,\n          n,\n          args,\n          lets,\n          once,\n          fuel,\n        )\n      },\n    },\n    ast.ListExpr(_) | ast.StrLit(_) | ast.Interp(_) => termination.SourceFinite,\n    ast.CtorExpr { name, .. } => termination.source_type(\n      ctx,\n      [],\n      [],\n      ast.Named { name, args: [] },\n    ),\n    // a record field (`h.it`): by the field's type\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, env, base, 8) {\n      Some(t) => match termination.field_type(ctx, t, name) {\n        Some(ft) => termination.source_type(ctx, f.type_params, f.bounds, ft),\n        None => termination.SourceByValue,\n      },\n      None => termination.SourceByValue,\n    },\n    ast.Var(n) => if contains(once, n) {\n      match lets.find(x -> x.0 == n) {\n        Some((_, v)) => termination.source_of(ctx, f, env, v, lets, once, fuel - 1),\n        None => match get(env, n) {\n          Some(t) => termination.source_type(ctx, f.type_params, f.bounds, t),\n          None => termination.SourceByValue,\n        },\n      }\n    } else {\n      match get(env, n) {\n        Some(t) => termination.source_type(ctx, f.type_params, f.bounds, t),\n        None => termination.SourceByValue,\n      }\n    },\n    _ => termination.SourceByValue,\n  }\n  match by_code {\n    termination.SourceByValue => match termination.expr_type(ctx, env, e, 8) {\n      Some(t) => termination.source_type(ctx, f.type_params, f.bounds, t),\n      None => termination.SourceByValue,\n    },\n    other => other,\n  }\n}","old_text":"/// What a `for` over `e` in `f` runs over. A lazy `map`, `filter`, `drop`,\n/// `enumerate`, `reverse` or `sort` is as finite as what it is called on;\n/// `take`, `slice`, `to_list` and `iter` always are. A variable bound once\n/// is judged by its value, any variable by its type in `env`\n/// (`var_types`), a call by its result type. `lets`: the body's `let`s and\n/// `mut` declarations.\nfn source_of(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  env: Dict[String, ast.TypeExpr],\n  e: ast.Expr,\n  lets: List[(String, ast.Expr)],\n  once: Set[String],\n  fuel: Int,\n) -> termination.Source {\n  if fuel <= 0 {\n    return termination.SourceUnknown(\"`\"\n      + text.expr_text(e, 0)\n      + \"`, reached through more `let`s than are followed\")\n  }\n  match e {\n    ast.MethodCall { recv, name, args } => termination.source_call(\n      ctx,\n      f,\n      env,\n      e,\n      name,\n      [recv] + args,\n      lets,\n      once,\n      fuel,\n    ),\n    ast.Call { callee: ast.Var(n), args } => match get(ctx.fns, n) {\n      Some(g) => termination.source_type(ctx, g.type_params, g.bounds, g.ret),\n      None => if contains(once, n) || f.params.any(p -> p.name == n) {\n        termination.SourceByValue\n      } else {\n        termination.source_call(\n          ctx,\n          f,\n          env,\n          e,\n          n,\n          args,\n          lets,\n          once,\n          fuel,\n        )\n      },\n    },\n    ast.ListExpr(_) | ast.StrLit(_) | ast.Interp(_) => termination.SourceFinite,\n    ast.CtorExpr { name, .. } => termination.source_type(\n      ctx,\n      [],\n      [],\n      ast.Named { name, args: [] },\n    ),\n    // a record field (`h.it`): by the field's type\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, env, base, 8) {\n      Some(t) => match termination.field_type(ctx, t, name) {\n        Some(ft) => termination.source_type(ctx, f.type_params, f.bounds, ft),\n        None => termination.SourceByValue,\n      },\n      None => termination.SourceByValue,\n    },\n    ast.Var(n) => if contains(once, n) {\n      match lets.find(x -> x.0 == n) {\n        Some((_, v)) => termination.source_of(ctx, f, env, v, lets, once, fuel - 1),\n        None => match get(env, n) {\n          Some(t) => termination.source_type(ctx, f.type_params, f.bounds, t),\n          None => termination.SourceByValue,\n        },\n      }\n    } else {\n      match get(env, n) {\n        Some(t) => termination.source_type(ctx, f.type_params, f.bounds, t),\n        None => termination.SourceByValue,\n      }\n    },\n    _ => termination.SourceByValue,\n  }\n}"}]}
{"id":"6b5406b9c274c6b4","time":1795827222,"message":"termination: the type of lists joined by +","changes":[{"name":"termination.use ast","kind":"use","old":"083968d5d94bbd8c","new":"14af52dc68dac53a","interface_changed":true,"affected":[],"module":"termination","text":"from ast use FnDecl, TypeDecl, TypeExpr, Expr, Stmt, Pattern, Param, ImplDecl,\n  TraitDecl, Named, FnType, UnitType, Refined, UnionType, RowType, Alias,\n  RecordBody, SumBody, NoPayload, Positional, RecordPayload, MemberType, IntLit,\n  FloatLit, StrLit, Var, Hole, CtorExpr, Call, MethodCall, FieldOf, Lambda,\n  Binary, MatchExpr, MutExpr, Block, MockExpr, Return, TupleExpr, ListExpr, Div,\n  Mod, Sub, Less, LessEq, Greater, GreaterEq, NotEqual, Equal, Let, VarDecl,\n  Assign, While, For, ExprStmt, Assert, Invariant, Decreases, ComptimeFor, Wild,\n  Bind, CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat, NoPats,\n  PositionalPats, RecordPats, TypePats, AssertBy, Calc, BoolLit, Bound, Field,\n  Select, Race, UnitExpr, Add","old_text":"from ast use FnDecl, TypeDecl, TypeExpr, Expr, Stmt, Pattern, Param, ImplDecl,\n  TraitDecl, Named, FnType, UnitType, Refined, UnionType, RowType, Alias,\n  RecordBody, SumBody, NoPayload, Positional, RecordPayload, MemberType, IntLit,\n  FloatLit, StrLit, Var, Hole, CtorExpr, Call, MethodCall, FieldOf, Lambda,\n  Binary, MatchExpr, MutExpr, Block, MockExpr, Return, TupleExpr, ListExpr, Div,\n  Mod, Sub, Less, LessEq, Greater, GreaterEq, NotEqual, Equal, Let, VarDecl,\n  Assign, While, For, ExprStmt, Assert, Invariant, Decreases, ComptimeFor, Wild,\n  Bind, CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat, NoPats,\n  PositionalPats, RecordPats, TypePats, AssertBy, Calc, BoolLit, Bound, Field,\n  Select, Race, UnitExpr"},{"name":"termination.expr_type","kind":"fn","old":"390eb826bde49b46","new":"0e8f9bbcda8c71e3","interface_changed":false,"affected":[],"module":"termination","text":"/// The type of `e`, as far as the code says it: a variable by its type in\n/// `env`, a call of a function of the program whose result type names none\n/// of its type parameters, a builtin's call (`builtin_result`), a record\n/// built by name, a field of a record, a tuple or list of those, lists or\n/// strings joined by `+`, or a `match` or `if` whose branches agree\n/// (`joined`).\nfn expr_type(\n  ctx: termination.Ctx,\n  env: Dict[String, ast.TypeExpr],\n  e: ast.Expr,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0 {\n    return None\n  }\n  match e {\n    ast.Var(n) => get(env, n),\n    ast.Call { callee: ast.Var(g), args } => match get(ctx.fns, g) {\n      Some(d) => if termination.names_any(d.ret, d.type_params + [\"Self\"]) {\n        None\n      } else {\n        Some(d.ret)\n      },\n      None => if contains(env, g) {\n        None\n      } else {\n        termination.builtin_result(ctx, env, g, args, fuel - 1)\n      },\n    },\n    ast.MethodCall { recv, name, args } => termination.builtin_result(\n      ctx,\n      env,\n      name,\n      [recv] + args,\n      fuel - 1,\n    ),\n    ast.ListExpr(es) => Some(ast.Named { name: \"List\", args: match termination.joined(\n      ctx,\n      es.map(x -> termination.expr_type(ctx, env, x, fuel - 1)),\n    ) {\n      Some(t) => [t],\n      None => [],\n    } }),\n    ast.IfExpr { then, otherwise, .. } => termination.joined(ctx, [then, otherwise]\n      .filter(x -> !(x is ast.Return))\n      .map(x -> termination.expr_type(ctx, env, x, fuel - 1))),\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      v := match binding {\n        Some(b) => termination.bind_site(\n          ctx,\n          env,\n          ast.Bind(b),\n          termination.SiteOf(scrutinee),\n        ),\n        None => env,\n      }\n      termination.joined(ctx, arms\n        .filter(a -> !(a.body is ast.Return))\n        .map(a -> termination.expr_type(\n          ctx,\n          termination.bind_site(\n            ctx,\n            v,\n            a.pat,\n            termination.SitePiece {\n              pat: a.pat,\n              ty: None,\n              of: scrutinee,\n            },\n          ),\n          a.body,\n          fuel - 1,\n        )))\n    },\n    ast.Block { stmts: [], last } => termination.expr_type(ctx, env, last, fuel - 1),\n    ast.Binary { op: ast.Add, left, right } => match termination.joined(ctx, [left, right].map(\n      x -> termination.expr_type(ctx, env, x, fuel - 1),\n    )) {\n      Some(t) => if [\"List\", \"String\"].contains(\n        termination.short(\n          termination.head(termination.expand_alias(ctx, t)),\n        ),\n      ) {\n        Some(t)\n      } else {\n        None\n      },\n      None => None,\n    },\n    ast.CtorExpr { name, .. } => match get(ctx.types, name) {\n      Some(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          Some(ast.Named { name, args: [] })\n        } else {\n          None\n        },\n        _ => None,\n      },\n      None => None,\n    },\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, env, base, fuel - 1) {\n      Some(t) => termination.field_type(ctx, t, name),\n      None => None,\n    },\n    ast.TupleExpr(es) => {\n      ts := es.map(x -> termination.expr_type(ctx, env, x, fuel - 1))\n      if ts.all(t -> !(t is None)) {\n        Some(ast.Named {\n          name: \"Tuple\",\n          args: ts.map(t -> t ?? ast.UnitType),\n        })\n      } else {\n        None\n      }\n    },\n    _ => None,\n  }\n}","old_text":"/// The type of `e`, as far as the code says it: a variable by its type in\n/// `env`, a call of a function of the program whose result type names none\n/// of its type parameters, a builtin's call (`builtin_result`), a record\n/// built by name, a field of a record, a tuple or list of those, or a\n/// `match` or `if` whose branches agree (`joined`).\nfn expr_type(\n  ctx: termination.Ctx,\n  env: Dict[String, ast.TypeExpr],\n  e: ast.Expr,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0 {\n    return None\n  }\n  match e {\n    ast.Var(n) => get(env, n),\n    ast.Call { callee: ast.Var(g), args } => match get(ctx.fns, g) {\n      Some(d) => if termination.names_any(d.ret, d.type_params + [\"Self\"]) {\n        None\n      } else {\n        Some(d.ret)\n      },\n      None => if contains(env, g) {\n        None\n      } else {\n        termination.builtin_result(ctx, env, g, args, fuel - 1)\n      },\n    },\n    ast.MethodCall { recv, name, args } => termination.builtin_result(\n      ctx,\n      env,\n      name,\n      [recv] + args,\n      fuel - 1,\n    ),\n    ast.ListExpr(es) => Some(ast.Named { name: \"List\", args: match termination.joined(\n      ctx,\n      es.map(x -> termination.expr_type(ctx, env, x, fuel - 1)),\n    ) {\n      Some(t) => [t],\n      None => [],\n    } }),\n    ast.IfExpr { then, otherwise, .. } => termination.joined(ctx, [then, otherwise]\n      .filter(x -> !(x is ast.Return))\n      .map(x -> termination.expr_type(ctx, env, x, fuel - 1))),\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      v := match binding {\n        Some(b) => termination.bind_site(\n          ctx,\n          env,\n          ast.Bind(b),\n          termination.SiteOf(scrutinee),\n        ),\n        None => env,\n      }\n      termination.joined(ctx, arms\n        .filter(a -> !(a.body is ast.Return))\n        .map(a -> termination.expr_type(\n          ctx,\n          termination.bind_site(\n            ctx,\n            v,\n            a.pat,\n            termination.SitePiece {\n              pat: a.pat,\n              ty: None,\n              of: scrutinee,\n            },\n          ),\n          a.body,\n          fuel - 1,\n        )))\n    },\n    ast.Block { stmts: [], last } => termination.expr_type(ctx, env, last, fuel - 1),\n    ast.CtorExpr { name, .. } => match get(ctx.types, name) {\n      Some(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          Some(ast.Named { name, args: [] })\n        } else {\n          None\n        },\n        _ => None,\n      },\n      None => None,\n    },\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, env, base, fuel - 1) {\n      Some(t) => termination.field_type(ctx, t, name),\n      None => None,\n    },\n    ast.TupleExpr(es) => {\n      ts := es.map(x -> termination.expr_type(ctx, env, x, fuel - 1))\n      if ts.all(t -> !(t is None)) {\n        Some(ast.Named {\n          name: \"Tuple\",\n          args: ts.map(t -> t ?? ast.UnitType),\n        })\n      } else {\n        None\n      }\n    },\n    _ => None,\n  }\n}"}]}
{"id":"127fabc9dd904b9b","time":1795827649,"message":"termination: structural only when the walk met every element call","changes":[{"name":"termination.Structural","kind":"type","old":"4238b4dbe39f36a3","new":"0c30020fb01d7ca3","interface_changed":true,"affected":["termination.structural","termination.struct_expr","termination.struct_call","termination.pattern_conds","termination.bind_piece","termination.struct_element","termination.analyze_with","verify_program","termination.analyze","search_invariants","build_proofs","verify_file","live_edit_command","alongside_command","smt_file","termination_file","static_graph","edit_file","apply_edit","fix_loops","run_command","build_command","command_line","std_proofs","verify_command","strata_command","graph_command","graph_diff","repl_command","edit_command","edit_in_editor","new_command","fix_command","main","std_library","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","check_command","test_command","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","build_core_command","comptime_value","literal_errors_of","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","comptime_values","loaded_check","file_errors","edit_errors","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","apply_change","with_base","package_errors","rename_command","move_command"],"module":"termination","text":"/// The recursive-call walk: the function's names as called, the variables\n/// assigned, and for each recursive call the parameters whose argument is\n/// smaller. `elem_calls`: the calls of `element_calls`, each a recursive\n/// call on an element of its list; `elem_seen`: how many the walk met.\ntype Structural = {\n  names: Set[String],\n  assigned: Set[String],\n  calls: List[Set[Int]],\n  elem_calls: List[ast.Expr] = [],\n  elem_seen: Int = 0,\n}","old_text":"/// The recursive-call walk: the function's names as called, the variables\n/// assigned, and for each recursive call the parameters whose argument is\n/// smaller. `elem_calls`: the calls of `element_calls`, each a recursive\n/// call on an element of its list.\ntype Structural = {\n  names: Set[String],\n  assigned: Set[String],\n  calls: List[Set[Int]],\n  elem_calls: List[ast.Expr] = [],\n}"},{"name":"termination.structural","kind":"fn","old":"babc27786ac36e14","new":"8e050ff37ed431ff","interface_changed":false,"affected":[],"module":"termination","text":"/// The parameter every recursive call passes a smaller piece of, if there\n/// is one.\nfn structural(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  label: String,\n) -> Option[String] {\n  asg := termination.assigned(ctx, f.body)\n  mut vars := Dict[String, termination.Piece] {}\n  for (i, p) in enumerate(f.params) {\n    if !contains(asg, p.name) && !p.mutable {\n      mut vars.insert(\n        p.name,\n        termination.Piece {\n          within: Set { i },\n          smaller: Set[Int] {},\n        },\n      )\n    }\n  }\n  names := Set { label, f.name }\n  mut st := termination.Structural {\n    names,\n    assigned: asg,\n    calls: [],\n    elem_calls: termination.element_calls(ctx, f, names),\n  }\n  termination.struct_expr(mut st, f.body, vars)\n  if st.elem_seen < len(st.elem_calls) {\n    return None\n  }\n  mut common := None\n  for c in st.calls {\n    common = Some(match common {\n      None => c,\n      Some(prev) => intersection(prev, c),\n    })\n  }\n  match common {\n    Some(c) => match get(to_list(c), 0) {\n      Some(i) => Some(get(f.params, i)?.name),\n      None => None,\n    },\n    None => None,\n  }\n}","old_text":"/// The parameter every recursive call passes a smaller piece of, if there\n/// is one.\nfn structural(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  label: String,\n) -> Option[String] {\n  asg := termination.assigned(ctx, f.body)\n  mut vars := Dict[String, termination.Piece] {}\n  for (i, p) in enumerate(f.params) {\n    if !contains(asg, p.name) && !p.mutable {\n      mut vars.insert(\n        p.name,\n        termination.Piece {\n          within: Set { i },\n          smaller: Set[Int] {},\n        },\n      )\n    }\n  }\n  names := Set { label, f.name }\n  mut st := termination.Structural {\n    names,\n    assigned: asg,\n    calls: [],\n    elem_calls: termination.element_calls(ctx, f, names),\n  }\n  termination.struct_expr(mut st, f.body, vars)\n  mut common := None\n  for c in st.calls {\n    common = Some(match common {\n      None => c,\n      Some(prev) => intersection(prev, c),\n    })\n  }\n  match common {\n    Some(c) => match get(to_list(c), 0) {\n      Some(i) => Some(get(f.params, i)?.name),\n      None => None,\n    },\n    None => None,\n  }\n}"},{"name":"termination.struct_element","kind":"fn","old":"5caca0a5837550f2","new":"c379a04910f9a702","interface_changed":false,"affected":[],"module":"termination","text":"/// Records a recursive call on an element of `xs`: smaller than the first\n/// parameter when `xs` is a piece of it or equal to it.\nfn struct_element(\n  mut st: termination.Structural,\n  xs: ast.Expr,\n  vars: Dict[String, termination.Piece],\n) {\n  st.elem_seen += 1\n  mut st.calls.push(\n    if contains(termination.piece(xs, vars).within, 0) {\n      Set { 0 }\n    } else {\n      Set[Int] {}\n    },\n  )\n}","old_text":"/// Records a recursive call on an element of `xs`: smaller than the first\n/// parameter when `xs` is a piece of it or equal to it.\nfn struct_element(\n  mut st: termination.Structural,\n  xs: ast.Expr,\n  vars: Dict[String, termination.Piece],\n) {\n  mut st.calls.push(\n    if contains(termination.piece(xs, vars).within, 0) {\n      Set { 0 }\n    } else {\n      Set[Int] {}\n    },\n  )\n}"}]}
{"id":"25f0d4448729e93c","time":1795828129,"message":"termination: the types of a tuple's elements","changes":[{"name":"termination.field_type","kind":"fn","old":"36fd2a0472c6c231","new":"af3361b686fec271","interface_changed":false,"affected":[],"module":"termination","text":"/// The type of the field `name` of a value of the record type `t`, or of\n/// the element at that index of a tuple (`x.1`).\nfn field_type(\n  ctx: termination.Ctx,\n  t: ast.TypeExpr,\n  name: String,\n) -> Option[ast.TypeExpr] {\n  u := termination.expand_alias(ctx, t)\n  match u {\n    ast.Named { name: \"Tuple\", args } => return match zip(range(0, len(args)), args).find(p -> to_string(p.0) == name) {\n      Some(p) => Some(p.1),\n      None => None,\n    },\n    _ => (),\n  }\n  (td, targs) := termination.decl_of(ctx, u)?\n  match td.body {\n    ast.RecordBody(fs) => match fs.find(x -> x.name == name) {\n      Some(x) => Some(termination.substitute(x.ty, td.params, targs)),\n      None => None,\n    },\n    _ => None,\n  }\n}","old_text":"/// The type of the field `name` of a value of the record type `t`.\nfn field_type(\n  ctx: termination.Ctx,\n  t: ast.TypeExpr,\n  name: String,\n) -> Option[ast.TypeExpr] {\n  (td, targs) := termination.decl_of(ctx, termination.expand_alias(ctx, t))?\n  match td.body {\n    ast.RecordBody(fs) => match fs.find(x -> x.name == name) {\n      Some(x) => Some(termination.substitute(x.ty, td.params, targs)),\n      None => None,\n    },\n    _ => None,\n  }\n}"}]}
{"id":"384f2841afc8c20a","time":1795829221,"message":"termination: a site's type found once per binding, with the caller's fuel","changes":[{"name":"termination.expr_type","kind":"fn","old":"0e8f9bbcda8c71e3","new":"19e4eefe50d38bef","interface_changed":false,"affected":[],"module":"termination","text":"/// The type of `e`, as far as the code says it: a variable by its type in\n/// `env`, a call of a function of the program whose result type names none\n/// of its type parameters, a builtin's call (`builtin_result`), a record\n/// built by name, a field of a record, a tuple or list of those, lists or\n/// strings joined by `+`, or a `match` or `if` whose branches agree\n/// (`joined`).\nfn expr_type(\n  ctx: termination.Ctx,\n  env: Dict[String, ast.TypeExpr],\n  e: ast.Expr,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0 {\n    return None\n  }\n  match e {\n    ast.Var(n) => get(env, n),\n    ast.Call { callee: ast.Var(g), args } => match get(ctx.fns, g) {\n      Some(d) => if termination.names_any(d.ret, d.type_params + [\"Self\"]) {\n        None\n      } else {\n        Some(d.ret)\n      },\n      None => if contains(env, g) {\n        None\n      } else {\n        termination.builtin_result(ctx, env, g, args, fuel - 1)\n      },\n    },\n    ast.MethodCall { recv, name, args } => termination.builtin_result(\n      ctx,\n      env,\n      name,\n      [recv] + args,\n      fuel - 1,\n    ),\n    ast.ListExpr(es) => Some(ast.Named { name: \"List\", args: match termination.joined(\n      ctx,\n      es.map(x -> termination.expr_type(ctx, env, x, fuel - 1)),\n    ) {\n      Some(t) => [t],\n      None => [],\n    } }),\n    ast.IfExpr { then, otherwise, .. } => termination.joined(ctx, [then, otherwise]\n      .filter(x -> !(x is ast.Return))\n      .map(x -> termination.expr_type(ctx, env, x, fuel - 1))),\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      base := match termination.expr_type(ctx, env, scrutinee, fuel - 1) {\n        Some(t) => termination.SiteType(t),\n        None => termination.SiteNone,\n      }\n      v := match binding {\n        Some(b) => termination.bind_site(ctx, env, ast.Bind(b), base, fuel - 1),\n        None => env,\n      }\n      termination.joined(ctx, arms\n        .filter(a -> !(a.body is ast.Return))\n        .map(a -> termination.expr_type(\n          ctx,\n          termination.bind_site(ctx, v, a.pat, base, fuel - 1),\n          a.body,\n          fuel - 1,\n        )))\n    },\n    ast.Block { stmts: [], last } => termination.expr_type(ctx, env, last, fuel - 1),\n    ast.Binary { op: ast.Add, left, right } => match termination.joined(ctx, [left, right].map(\n      x -> termination.expr_type(ctx, env, x, fuel - 1),\n    )) {\n      Some(t) => if [\"List\", \"String\"].contains(\n        termination.short(\n          termination.head(termination.expand_alias(ctx, t)),\n        ),\n      ) {\n        Some(t)\n      } else {\n        None\n      },\n      None => None,\n    },\n    ast.CtorExpr { name, .. } => match get(ctx.types, name) {\n      Some(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          Some(ast.Named { name, args: [] })\n        } else {\n          None\n        },\n        _ => None,\n      },\n      None => None,\n    },\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, env, base, fuel - 1) {\n      Some(t) => termination.field_type(ctx, t, name),\n      None => None,\n    },\n    ast.TupleExpr(es) => {\n      ts := es.map(x -> termination.expr_type(ctx, env, x, fuel - 1))\n      if ts.all(t -> !(t is None)) {\n        Some(ast.Named {\n          name: \"Tuple\",\n          args: ts.map(t -> t ?? ast.UnitType),\n        })\n      } else {\n        None\n      }\n    },\n    _ => None,\n  }\n}","old_text":"/// The type of `e`, as far as the code says it: a variable by its type in\n/// `env`, a call of a function of the program whose result type names none\n/// of its type parameters, a builtin's call (`builtin_result`), a record\n/// built by name, a field of a record, a tuple or list of those, lists or\n/// strings joined by `+`, or a `match` or `if` whose branches agree\n/// (`joined`).\nfn expr_type(\n  ctx: termination.Ctx,\n  env: Dict[String, ast.TypeExpr],\n  e: ast.Expr,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0 {\n    return None\n  }\n  match e {\n    ast.Var(n) => get(env, n),\n    ast.Call { callee: ast.Var(g), args } => match get(ctx.fns, g) {\n      Some(d) => if termination.names_any(d.ret, d.type_params + [\"Self\"]) {\n        None\n      } else {\n        Some(d.ret)\n      },\n      None => if contains(env, g) {\n        None\n      } else {\n        termination.builtin_result(ctx, env, g, args, fuel - 1)\n      },\n    },\n    ast.MethodCall { recv, name, args } => termination.builtin_result(\n      ctx,\n      env,\n      name,\n      [recv] + args,\n      fuel - 1,\n    ),\n    ast.ListExpr(es) => Some(ast.Named { name: \"List\", args: match termination.joined(\n      ctx,\n      es.map(x -> termination.expr_type(ctx, env, x, fuel - 1)),\n    ) {\n      Some(t) => [t],\n      None => [],\n    } }),\n    ast.IfExpr { then, otherwise, .. } => termination.joined(ctx, [then, otherwise]\n      .filter(x -> !(x is ast.Return))\n      .map(x -> termination.expr_type(ctx, env, x, fuel - 1))),\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      v := match binding {\n        Some(b) => termination.bind_site(\n          ctx,\n          env,\n          ast.Bind(b),\n          termination.SiteOf(scrutinee),\n        ),\n        None => env,\n      }\n      termination.joined(ctx, arms\n        .filter(a -> !(a.body is ast.Return))\n        .map(a -> termination.expr_type(\n          ctx,\n          termination.bind_site(\n            ctx,\n            v,\n            a.pat,\n            termination.SitePiece {\n              pat: a.pat,\n              ty: None,\n              of: scrutinee,\n            },\n          ),\n          a.body,\n          fuel - 1,\n        )))\n    },\n    ast.Block { stmts: [], last } => termination.expr_type(ctx, env, last, fuel - 1),\n    ast.Binary { op: ast.Add, left, right } => match termination.joined(ctx, [left, right].map(\n      x -> termination.expr_type(ctx, env, x, fuel - 1),\n    )) {\n      Some(t) => if [\"List\", \"String\"].contains(\n        termination.short(\n          termination.head(termination.expand_alias(ctx, t)),\n        ),\n      ) {\n        Some(t)\n      } else {\n        None\n      },\n      None => None,\n    },\n    ast.CtorExpr { name, .. } => match get(ctx.types, name) {\n      Some(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          Some(ast.Named { name, args: [] })\n        } else {\n          None\n        },\n        _ => None,\n      },\n      None => None,\n    },\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, env, base, fuel - 1) {\n      Some(t) => termination.field_type(ctx, t, name),\n      None => None,\n    },\n    ast.TupleExpr(es) => {\n      ts := es.map(x -> termination.expr_type(ctx, env, x, fuel - 1))\n      if ts.all(t -> !(t is None)) {\n        Some(ast.Named {\n          name: \"Tuple\",\n          args: ts.map(t -> t ?? ast.UnitType),\n        })\n      } else {\n        None\n      }\n    },\n    _ => None,\n  }\n}"},{"name":"termination.Site","kind":"type","old":"36cfbfe17176d85e","new":"d6e085f7865f0c43","interface_changed":true,"affected":["termination.expr_type","termination.bind_site","termination.scope_walk","termination.site_base","termination.source_of","termination.is_list","termination.builtin_result","termination.in_scope","termination.loop_start","termination.source_call","termination.element_calls","termination.analyze_with","termination.structural","termination.passes_itself","verify_program","termination.analyze","search_invariants","build_proofs","verify_file","live_edit_command","alongside_command","smt_file","termination_file","static_graph","edit_file","apply_edit","fix_loops","run_command","build_command","command_line","std_proofs","verify_command","strata_command","graph_command","graph_diff","repl_command","edit_command","edit_in_editor","new_command","fix_command","main","std_library","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","check_command","test_command","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","build_core_command","comptime_value","literal_errors_of","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","comptime_values","loaded_check","file_errors","edit_errors","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","apply_change","with_base","package_errors","rename_command","move_command"],"module":"termination","text":"/// A place that binds names, by what gives the type of the value its\n/// pattern matches: a written type, the written type or else an\n/// expression's type, an element of a list or set, or nothing the code\n/// says.\ntype Site =\n  | SiteType(ast.TypeExpr)\n  | SitePiece { ty: Option[ast.TypeExpr], of: ast.Expr }\n  | SiteElem(ast.Expr)\n  | SiteNone","old_text":"/// A place that binds a name, by what gives its type: a written type, an\n/// expression's type, the piece a pattern binds of a value (of the written\n/// type, else of the expression's), the piece a pattern binds of an element\n/// of a list or set, or nothing the code says.\ntype Site =\n  | SiteType(ast.TypeExpr)\n  | SiteOf(ast.Expr)\n  | SitePiece { pat: ast.Pattern, ty: Option[ast.TypeExpr], of: ast.Expr }\n  | SiteElem { pat: ast.Pattern, of: ast.Expr }\n  | SiteNone"},{"name":"termination.bind_site","kind":"fn","old":"68ce4fecfb3b322f","new":"16dd1adf27d6ad95","interface_changed":true,"affected":["termination.expr_type","termination.scope_walk","termination.source_of","termination.is_list","termination.builtin_result","termination.site_base","termination.in_scope","termination.loop_start","termination.source_call","termination.element_calls","termination.analyze_with","termination.structural","termination.passes_itself","verify_program","termination.analyze","search_invariants","build_proofs","verify_file","live_edit_command","alongside_command","smt_file","termination_file","static_graph","edit_file","apply_edit","fix_loops","run_command","build_command","command_line","std_proofs","verify_command","strata_command","graph_command","graph_diff","repl_command","edit_command","edit_in_editor","new_command","fix_command","main","std_library","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","check_command","test_command","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","build_core_command","comptime_value","literal_errors_of","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","comptime_values","loaded_check","file_errors","edit_errors","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","apply_change","with_base","package_errors","rename_command","move_command"],"module":"termination","text":"/// `env` with the names `p` binds, each with the type of its piece of the\n/// value `s` gives, or with no type (so an outer one is hidden).\nfn bind_site(\n  ctx: termination.Ctx,\n  env: Dict[String, ast.TypeExpr],\n  p: ast.Pattern,\n  s: termination.Site,\n  fuel: Int,\n) -> Dict[String, ast.TypeExpr] {\n  base := termination.site_base(ctx, env, s, fuel)\n  mut out := env\n  for n in termination.pattern_binds(p) {\n    match base {\n      Some(t) => match termination.pattern_type(ctx, p, t, n, 8) {\n        Some(u) => mut out.insert(n, u),\n        None => mut out.remove(n),\n      },\n      None => mut out.remove(n),\n    }\n  }\n  out\n}","old_text":"/// `env` with the names `p` binds, each with the type `s` gives it, or\n/// with no type (so an outer one is hidden).\nfn bind_site(\n  ctx: termination.Ctx,\n  env: Dict[String, ast.TypeExpr],\n  p: ast.Pattern,\n  s: termination.Site,\n) -> Dict[String, ast.TypeExpr] {\n  mut out := env\n  for n in termination.pattern_binds(p) {\n    match termination.site_type(ctx, env, n, s) {\n      Some(t) => mut out.insert(n, t),\n      None => mut out.remove(n),\n    }\n  }\n  out\n}"},{"name":"termination.scope_walk","kind":"fn","old":"96ca1efb8e474c35","new":"e87ac1f9f01b64fa","interface_changed":false,"affected":[],"module":"termination","text":"/// Walks `e` with `env` the types of the variables in scope, each binding\n/// replacing or hiding the one before.\nfn scope_walk(\n  ctx: termination.Ctx,\n  mut out: termination.Scoped,\n  e: ast.Expr,\n  env: Dict[String, ast.TypeExpr],\n  pick: (ast.Expr) -> Bool,\n) {\n  if pick(e) {\n    mut out.picked.push((e, env))\n  }\n  match e {\n    ast.Block { stmts, last } => {\n      mut v := env\n      for s in stmts {\n        match s {\n          ast.Let { pat, ty, value } => {\n            termination.scope_walk(ctx, mut out, value, v, pick)\n            v = termination.bind_site(\n              ctx,\n              v,\n              pat,\n              termination.SitePiece { ty, of: value },\n              8,\n            )\n          },\n          ast.VarDecl { name, ty, value } => {\n            termination.scope_walk(ctx, mut out, value, v, pick)\n            v = termination.bind_site(\n              ctx,\n              v,\n              ast.Bind(name),\n              termination.SitePiece { ty, of: value },\n              8,\n            )\n          },\n          ast.For { pat, iter, body } => {\n            termination.scope_walk(ctx, mut out, iter, v, pick)\n            mut out.fors.push((iter, v))\n            termination.scope_walk(\n              ctx,\n              mut out,\n              body,\n              termination.bind_site(\n                ctx,\n                v,\n                pat,\n                termination.SiteElem(iter),\n                8,\n              ),\n              pick,\n            )\n          },\n          ast.ComptimeFor { pat, iter, body } => {\n            termination.scope_walk(ctx, mut out, iter, v, pick)\n            termination.scope_walk(\n              ctx,\n              mut out,\n              body,\n              termination.bind_site(\n                ctx,\n                v,\n                pat,\n                termination.SiteNone,\n                8,\n              ),\n              pick,\n            )\n          },\n          other => {\n            for k in walk.stmt_kids(other) {\n              termination.scope_walk(ctx, mut out, k, v, pick)\n            }\n          },\n        }\n      }\n      termination.scope_walk(ctx, mut out, last, v, pick)\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      termination.scope_walk(ctx, mut out, scrutinee, env, pick)\n      base := match termination.expr_type(ctx, env, scrutinee, 8) {\n        Some(t) => termination.SiteType(t),\n        None => termination.SiteNone,\n      }\n      mut v := env\n      match binding {\n        Some(b) => {\n          v = termination.bind_site(ctx, v, ast.Bind(b), base, 8)\n        },\n        None => (),\n      }\n      for a in arms {\n        va := termination.bind_site(ctx, v, a.pat, base, 8)\n        for k in walk.pattern_kids(a.pat) {\n          termination.scope_walk(ctx, mut out, k, va, pick)\n        }\n        termination.scope_walk(ctx, mut out, a.body, va, pick)\n      }\n    },\n    ast.Lambda { params, body } => {\n      mut v := env\n      for p in params {\n        match p.ty {\n          Some(t) => mut v.insert(p.name, t),\n          None => mut v.remove(p.name),\n        }\n      }\n      termination.scope_walk(ctx, mut out, body, v, pick)\n    },\n    ast.Select(arms) | ast.Race(arms) => {\n      for a in arms {\n        termination.scope_walk(ctx, mut out, a.op, env, pick)\n        mut v := env\n        match a.name {\n          Some(b) => mut v.remove(b),\n          None => (),\n        }\n        termination.scope_walk(ctx, mut out, a.body, v, pick)\n      }\n    },\n    _ => {\n      for k in walk.kids(e) {\n        termination.scope_walk(ctx, mut out, k, env, pick)\n      }\n    },\n  }\n}","old_text":"/// Walks `e` with `env` the types of the variables in scope, each binding\n/// replacing or hiding the one before.\nfn scope_walk(\n  ctx: termination.Ctx,\n  mut out: termination.Scoped,\n  e: ast.Expr,\n  env: Dict[String, ast.TypeExpr],\n  pick: (ast.Expr) -> Bool,\n) {\n  if pick(e) {\n    mut out.picked.push((e, env))\n  }\n  match e {\n    ast.Block { stmts, last } => {\n      mut v := env\n      for s in stmts {\n        match s {\n          ast.Let { pat, ty, value } => {\n            termination.scope_walk(ctx, mut out, value, v, pick)\n            v = termination.bind_site(\n              ctx,\n              v,\n              pat,\n              termination.SitePiece { pat, ty, of: value },\n            )\n          },\n          ast.VarDecl { name, ty, value } => {\n            termination.scope_walk(ctx, mut out, value, v, pick)\n            v = termination.bind_site(ctx, v, ast.Bind(name), match ty {\n              Some(t) => termination.SiteType(t),\n              None => termination.SiteOf(value),\n            })\n          },\n          ast.For { pat, iter, body } => {\n            termination.scope_walk(ctx, mut out, iter, v, pick)\n            mut out.fors.push((iter, v))\n            termination.scope_walk(\n              ctx,\n              mut out,\n              body,\n              termination.bind_site(\n                ctx,\n                v,\n                pat,\n                termination.SiteElem { pat, of: iter },\n              ),\n              pick,\n            )\n          },\n          ast.ComptimeFor { pat, iter, body } => {\n            termination.scope_walk(ctx, mut out, iter, v, pick)\n            termination.scope_walk(\n              ctx,\n              mut out,\n              body,\n              termination.bind_site(\n                ctx,\n                v,\n                pat,\n                termination.SiteNone,\n              ),\n              pick,\n            )\n          },\n          other => {\n            for k in walk.stmt_kids(other) {\n              termination.scope_walk(ctx, mut out, k, v, pick)\n            }\n          },\n        }\n      }\n      termination.scope_walk(ctx, mut out, last, v, pick)\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      termination.scope_walk(ctx, mut out, scrutinee, env, pick)\n      mut v := env\n      match binding {\n        Some(b) => {\n          v = termination.bind_site(\n            ctx,\n            v,\n            ast.Bind(b),\n            termination.SiteOf(scrutinee),\n          )\n        },\n        None => (),\n      }\n      for a in arms {\n        va := termination.bind_site(ctx, v, a.pat, termination.SitePiece {\n          pat: a.pat,\n          ty: None,\n          of: scrutinee,\n        })\n        for k in walk.pattern_kids(a.pat) {\n          termination.scope_walk(ctx, mut out, k, va, pick)\n        }\n        termination.scope_walk(ctx, mut out, a.body, va, pick)\n      }\n    },\n    ast.Lambda { params, body } => {\n      mut v := env\n      for p in params {\n        match p.ty {\n          Some(t) => mut v.insert(p.name, t),\n          None => mut v.remove(p.name),\n        }\n      }\n      termination.scope_walk(ctx, mut out, body, v, pick)\n    },\n    ast.Select(arms) | ast.Race(arms) => {\n      for a in arms {\n        termination.scope_walk(ctx, mut out, a.op, env, pick)\n        mut v := env\n        match a.name {\n          Some(b) => mut v.remove(b),\n          None => (),\n        }\n        termination.scope_walk(ctx, mut out, a.body, v, pick)\n      }\n    },\n    _ => {\n      for k in walk.kids(e) {\n        termination.scope_walk(ctx, mut out, k, env, pick)\n      }\n    },\n  }\n}"},{"name":"termination.site_base","kind":"fn","old":null,"new":"605f9107ce304213","interface_changed":true,"affected":[],"module":"termination","text":"/// The type of the value a site's pattern matches, with `env` the types\n/// in scope.\nfn site_base(\n  ctx: termination.Ctx,\n  env: Dict[String, ast.TypeExpr],\n  s: termination.Site,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  match s {\n    termination.SiteType(t) => Some(t),\n    termination.SitePiece { ty, of: e } => match ty {\n      Some(t) => Some(t),\n      None => termination.expr_type(ctx, env, e, fuel),\n    },\n    termination.SiteElem(e) => match termination.expr_type(ctx, env, e, fuel) {\n      Some(t) => termination.element_type(ctx, t),\n      None => None,\n    },\n    termination.SiteNone => None,\n  }\n}"},{"name":"termination.site_type","kind":"fn","old":"51d2ddff42f2082b","new":null,"interface_changed":true,"affected":[],"module":"termination","old_text":"/// The type a site gives the name `n`, with `env` the types known so far.\nfn site_type(\n  ctx: termination.Ctx,\n  env: Dict[String, ast.TypeExpr],\n  n: String,\n  s: termination.Site,\n) -> Option[ast.TypeExpr] {\n  of := (e: ast.Expr) -> termination.expr_type(ctx, env, e, 8)\n  match s {\n    termination.SiteType(t) => Some(t),\n    termination.SiteOf(e) => of(e),\n    termination.SitePiece { pat, ty, of: e } => match ty {\n      Some(t) => termination.pattern_type(ctx, pat, t, n, 8),\n      None => match of(e) {\n        Some(t) => termination.pattern_type(ctx, pat, t, n, 8),\n        None => None,\n      },\n    },\n    termination.SiteElem { pat, of: e } => match of(e) {\n      Some(t) => match termination.element_type(ctx, t) {\n        Some(el) => termination.pattern_type(ctx, pat, el, n, 8),\n        None => None,\n      },\n      None => None,\n    },\n    termination.SiteNone => None,\n  }\n}"}]}
{"id":"8309e0931c5d95d5","time":1795823987,"message":"edit","changes":[{"name":"capabilities.capability_errors_in","kind":"fn","old":"a1123273c4331086","new":"2bb7193d808af0a3","interface_changed":false,"affected":[],"module":"capabilities","text":"/// `capability_errors`, with the capabilities of `lib` (std's\n/// `SystemClock`, ...) known too.\npub fn capability_errors_in(\n  decls: List[ast.Decl],\n  lib: List[ast.Decl],\n) -> List[(String, String)] {\n  mut caps := Set[String] {}\n  // the `extern c type`s, by short name\n  mut externs := Set[String] {}\n  for d in lib {\n    match d.kind {\n      ast.ExternDef(ast.ExternDecl { item: ast.ExternType(t, _), .. }) => mut externs.insert(capabilities.short(t)),\n      ast.CapabilityDef(cd) => {\n        caps = {\n          mut copy := {\n            mut copy := caps\n            mut copy.insert(cd.name)\n            copy\n          }\n          mut copy.insert(capabilities.qualified(d.module, cd.name))\n          copy\n        }\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.ExternDef(ast.ExternDecl { item: ast.ExternType(t, _), .. }) => mut externs.insert(capabilities.short(t)),\n      // by its name in the module, and as other modules name it\n      ast.CapabilityDef(cd) => {\n        caps = {\n          mut copy := {\n            mut copy := caps\n            mut copy.insert(cd.name)\n            copy\n          }\n          mut copy.insert(capabilities.qualified(d.module, cd.name))\n          copy\n        }\n      },\n      _ => (),\n    }\n  }\n  mut out := []\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => {\n        for m in capabilities.body_errors(f.params, f.body, caps) {\n          mut out.push((f.name, m))\n        }\n      },\n      ast.TestDef(t) => {\n        at := \"test \\\"\" + t.name + \"\\\"\"\n        for p in t.params {\n          if capabilities.not_capability(p.ty, caps) {\n            mut out.push(\n              (\n                at,\n                \"test parameter `\"\n                  + p.name\n                  + \": \"\n                  + text.type_text(p.ty)\n                  + \"`: a test asks only for capabilities (`capability ...`), `Console`, or (when strata.toml allows it) `RunMode`\",\n              ),\n            )\n          }\n        }\n        for m in capabilities.body_errors(t.params, t.body, caps) {\n          mut out.push((at, m))\n        }\n      },\n      // core has no root module: a package's own `core` is not it\n      ast.ExternDef(ast.ExternDecl { lang: ast.Builtin, item }) => if !starts_with(d.module, \"core.\") {\n        name := match item {\n          ast.ExternFn(f) => f.name,\n          ast.ExternType(t, _) => t,\n          ast.ExternStatic(t, _) => t,\n          ast.ExternThreadStatic(t, _) => t,\n        }\n        mut out.push(\n          (name, \"`builtin` definitions are only in `core`: `\"\n            + name\n            + \"` is what the compiler provides, declared there\"),\n        )\n      },\n      ast.ExternDef(ast.ExternDecl { lang: ast.C, item: ast.ExternFn(f) }) => {\n        if d.public {\n          mut out.push(\n            (\n              f.name,\n              \"`extern c` definitions are never `pub`: wrap them in this module's own functions or a capability, which can be\",\n            ),\n          )\n        }\n        for m in capabilities.extern_fn_errors(f, externs) {\n          mut out.push((f.name, m))\n        }\n      },\n      ast.ExternDef(x) => if d.public {\n        match x.item {\n          ast.ExternFn(f) => mut out.push(\n            (\n              f.name,\n              \"`extern c` definitions are never `pub`: wrap them in this module's own functions or a capability, which can be\",\n            ),\n          ),\n          ast.ExternType(_, _) | ast.ExternStatic(_, _) | ast.ExternThreadStatic(_, _) => (),\n        }\n      },\n      _ => (),\n    }\n  }\n  out\n}","old_text":"/// `capability_errors`, with the capabilities of `lib` (std's\n/// `SystemClock`, ...) known too.\npub fn capability_errors_in(\n  decls: List[ast.Decl],\n  lib: List[ast.Decl],\n) -> List[(String, String)] {\n  mut caps := Set[String] {}\n  for d in lib {\n    match d.kind {\n      ast.CapabilityDef(cd) => {\n        caps = {\n          mut copy := {\n            mut copy := caps\n            mut copy.insert(cd.name)\n            copy\n          }\n          mut copy.insert(capabilities.qualified(d.module, cd.name))\n          copy\n        }\n      },\n      _ => (),\n    }\n  }\n  // the `extern c type`s, by short name\n  mut externs := Set[String] {}\n  for d in decls {\n    match d.kind {\n      ast.ExternDef(ast.ExternDecl { item: ast.ExternType(t, _), .. }) => mut externs.insert(capabilities.short(t)),\n      // by its name in the module, and as other modules name it\n      ast.CapabilityDef(cd) => {\n        caps = {\n          mut copy := {\n            mut copy := caps\n            mut copy.insert(cd.name)\n            copy\n          }\n          mut copy.insert(capabilities.qualified(d.module, cd.name))\n          copy\n        }\n      },\n      _ => (),\n    }\n  }\n  mut out := []\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => {\n        for m in capabilities.body_errors(f.params, f.body, caps) {\n          mut out.push((f.name, m))\n        }\n      },\n      ast.TestDef(t) => {\n        at := \"test \\\"\" + t.name + \"\\\"\"\n        for p in t.params {\n          if capabilities.not_capability(p.ty, caps) {\n            mut out.push(\n              (\n                at,\n                \"test parameter `\"\n                  + p.name\n                  + \": \"\n                  + text.type_text(p.ty)\n                  + \"`: a test asks only for capabilities (`capability ...`), `Console`, or (when strata.toml allows it) `RunMode`\",\n              ),\n            )\n          }\n        }\n        for m in capabilities.body_errors(t.params, t.body, caps) {\n          mut out.push((at, m))\n        }\n      },\n      // core has no root module: a package's own `core` is not it\n      ast.ExternDef(ast.ExternDecl { lang: ast.Builtin, item }) => if !starts_with(d.module, \"core.\") {\n        name := match item {\n          ast.ExternFn(f) => f.name,\n          ast.ExternType(t, _) => t,\n          ast.ExternStatic(t, _) => t,\n          ast.ExternThreadStatic(t, _) => t,\n        }\n        mut out.push(\n          (name, \"`builtin` definitions are only in `core`: `\"\n            + name\n            + \"` is what the compiler provides, declared there\"),\n        )\n      },\n      ast.ExternDef(ast.ExternDecl { lang: ast.C, item: ast.ExternFn(f) }) => {\n        if d.public {\n          mut out.push(\n            (\n              f.name,\n              \"`extern c` definitions are never `pub`: wrap them in this module's own functions or a capability, which can be\",\n            ),\n          )\n        }\n        for m in capabilities.extern_fn_errors(f, externs) {\n          mut out.push((f.name, m))\n        }\n      },\n      ast.ExternDef(x) => if d.public {\n        match x.item {\n          ast.ExternFn(f) => mut out.push(\n            (\n              f.name,\n              \"`extern c` definitions are never `pub`: wrap them in this module's own functions or a capability, which can be\",\n            ),\n          ),\n          ast.ExternType(_, _) | ast.ExternStatic(_, _) | ast.ExternThreadStatic(_, _) => (),\n        }\n      },\n      _ => (),\n    }\n  }\n  out\n}"}]}
{"id":"bc3f2db6c9e0584c","time":1795828106,"message":"edit","changes":[{"name":"codegen.generate","kind":"fn","old":"c31ca397d21815cb","new":"79d81fdb098b19bc","interface_changed":false,"affected":[],"module":"codegen","text":"/// The program's `main` and what it calls as LLVM IR, or the constructs not\n/// compiled, each with its function. `assumed_clauses` also checks the\n/// assumed contract clauses (`--check-assumed`). Verify's fuzz drivers\n/// always check them.\npub fn generate(\n  given: List[ast.Decl],\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  proofs: List[String],\n  tests: Option[List[(String, String)]],\n  fuzz: List[String],\n  fuzz_text: Bool,\n  calls: List[String],\n  trace: Bool,\n  library: List[String],\n  precompiled: List[String],\n  bare: Bool,\n  copies: Option[Dict[String, String]],\n  memory_sites: Option[Dict[String, String]],\n  assumed_clauses: Bool,\n  live: Bool,\n) -> Result[String, List[String]] {\n  // unused variables with no effect are not compiled (`unread_dropped`),\n  // and assumed contract clauses are left out (`assumed_compiled`)\n  timings.begin(\"codegen: tables\")\n  keep := assumed_clauses || fuzz != []\n  // lemmas and proofs (`assert … by`, `calc`) are for `verify` alone: never\n  // compiled\n  (start, main) := codegen.new_gen(\n    given\n      .filter(d -> !match d.kind {\n        ast.FnDef(f) => f.lemma,\n        _ => false,\n      })\n      .map(d -> walk.rewrite_decl(\n        codegen.assumed_compiled(d, keep),\n        x -> codegen.unread_dropped(codegen.proofs_dropped(x)),\n      )),\n    core,\n    prelude,\n    proofs,\n    tests,\n    fuzz,\n    fuzz_text,\n    calls,\n    trace,\n    library,\n    precompiled,\n  ) except es {\n    timings.end(\"codegen: tables\")\n    return Err(es)\n  }\n  // core.rt (`bare`): no call-stack frames, no cancel points\n  mut g := if bare {\n    codegen.Gen {\n      ..start,\n      bare: true,\n      tasks: false,\n      supervises: false,\n    }\n  } else {\n    start\n  }\n  if live {\n    g.live = true\n    // (no function's parameters known to be only borrowed)\n    g.keeps = Some(Dict[String, List[Bool]] {})\n  }\n  // `--copies`: report copies with their locations\n  match copies {\n    Some(sites) => {\n      g.copies = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  // (`--memory-sites`: each counting operation counted, by site)\n  match memory_sites {\n    Some(sites) => {\n      g.memory_sites = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  timings.end(\"codegen: tables\")\n  mut bodies := match tests {\n    // each test as `strata test` runs it (`strata.test.N`), with its name\n    Some(ts) => enumerate(ts).map(x -> codegen.test_entry(x.0, x.1.0, x.1.1)),\n    None => if fuzz != [] || library != [] || calls != [] {\n      []\n    } else if main.name == \"\" {\n      // a library starts when it is loaded\n      [codegen.library_start(mut g)]\n    } else {\n      [codegen.entry(mut g, main)]\n    },\n  }\n  // std's library runs in any program, with tasks or without. It holds its\n  // functions by key and its `impl`s' methods (`library_methods`), except\n  // those `!KEY` excludes. Generic functions, those depending on the\n  // compile, and trait values are compiled per program instead.\n  mut roots := []\n  mut held := []\n  left_out := set(library\n    .filter(k -> starts_with(k, \"!\"))\n    .map(k -> byte_slice(k, 1, byte_len(k))))\n  mut wanted := library.filter(k -> !starts_with(k, \"!\"))\n  if library != [] {\n    wanted += codegen.library_methods(mut g).filter(\n      k -> !contains(left_out, k),\n    )\n  }\n  for k in wanted {\n    match codegen.fn_of(g, k) {\n      Some(f) => if codegen.precompilable(mut g, k, f) {\n        sym := codegen.instance(mut g, k, f, Dict[String, check.Ty] {})\n        mut roots.push(sym)\n        mut held.push(k)\n      },\n      None => (),\n    }\n  }\n  // verify's fuzz drivers (`strata.fuzz.N`)\n  for (i, k) in enumerate(fuzz) {\n    mut bodies.push(codegen.fuzz_driver(mut g, i, k))\n  }\n  // `strata run f ARGS` calls (`strata.call.N`). `session:KEY` is a\n  // `strata repl` line, with the session's arguments.\n  for (i, k) in enumerate(calls) {\n    mut bodies.push(\n      if starts_with(k, \"session:\") {\n        codegen.session_entry(\n          mut g,\n          i,\n          byte_slice(k, 8, byte_len(k)),\n        )\n      } else {\n        codegen.call_entry(mut g, i, k)\n      },\n    )\n  }\n  // the exports of `derive C for f`, each under its symbol\n  if fuzz == [] && library == [] && calls == [] && tests is None {\n    for (symbol, k) in codegen.exports_of(given) {\n      mut bodies.push(codegen.export_entry(mut g, symbol, k))\n    }\n  }\n  // the files they generate: the C header\n  parts := codegen.file_parts(given) except e { return Err([e]) }\n  // Each reachable function instance, once, in rounds. The workers compile\n  // each function of a round alone from the state the round began with.\n  // Their additions are then merged in queue order, so the output does not\n  // depend on thread timing.\n  timings.begin(\"codegen: keeps\")\n  // (the analyses below see the `impl`s' methods: the updates in place\n  // and the stack, for builds and tests)\n  analyzed := len(g.queue) > 0 && !bare && !live && fuzz == [] && calls == []\n  (resolved, methods) := if analyzed {\n    codegen.impl_methods(mut g)\n  } else {\n    (Dict[String, String] {}, Set[String] {})\n  }\n  if len(g.queue) > 0 && g.keeps is None {\n    g.keeps = Some(codegen.kept_by(g.fns))\n  }\n  timings.end(\"codegen: keeps\")\n  timings.begin(\"codegen: unique\")\n  // the updates in place proven to find their value held once, for builds\n  // and tests (not for verify's fuzzing, `strata run f` and compile-time\n  // code, which run once). Only a program's build sees every call of its\n  // functions (`closed`).\n  if analyzed {\n    closed := library == []\n      && tests is None\n      && main.name != \"\"\n      && codegen.exports_of(given) == []\n    g.proven = unique.proven_sites(\n      g.fns,\n      codegen.keeps_of(mut g),\n      closed,\n      g.distincts,\n      g.traits,\n      resolved,\n      methods,\n    )\n  }\n  // (`--memory-sites`: where scoped allocation would put each value)\n  if g.memory_sites && len(g.queue) > 0 {\n    g.roots = roots.verdicts(\n      g.fns,\n      codegen.keeps_of(mut g),\n      g.traits,\n      g.proven,\n    )\n  }\n  timings.end(\"codegen: unique\")\n  mut global_keys := set(g.globals.map(l -> codegen.global_key(l)))\n  mut def_keys := set(g.helper_defs.map(d -> codegen.def_key(d)))\n  timings.begin(\"codegen: functions\")\n  while len(g.queue) > 0 {\n    round := g.queue\n    g.queue = []\n    base := g\n    for (body, d) in parallel.map_parallel(\n      round,\n      item -> codegen.compiled_alone(base, item.0, item.1, main),\n    ) {\n      mut bodies.push(body)\n      codegen.merge_alone(\n        mut g,\n        base,\n        d,\n        mut global_keys,\n        mut def_keys,\n      )\n    }\n  }\n  timings.end(\"codegen: functions\")\n  if len(g.errs) > 0 {\n    // std's library leaves out the functions that reach something not\n    // compiled\n    if library != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      out := wanted.filter(k -> contains(left, k))\n      if out != [] {\n        return Err(out.map(k -> \"leave out: \" + k))\n      }\n    }\n    // verify's fuzz drivers: each one reaching something not compiled is\n    // reported as `can't fuzz `KEY`: WHY`, so `verify` drops them all at\n    // once\n    if fuzz != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      callees := codegen.callees_of(g.callers)\n      return Err(g.errs\n        + fuzz\n          .filter(k -> contains(left, \"fuzz:\" + k))\n          .map(k -> \"can't fuzz `\"\n            + k\n            + \"`: \"\n            + join(\n              codegen.failures_of(callees, g.why, \"fuzz:\" + k),\n              \"; \",\n            )))\n    }\n    return Err(g.errs)\n  }\n  mut out := [\n    \"; Strata, compiled by compiler/codegen\",\n    f\"; checks left out {g.left_out}, kept {g.kept}\",\n    \"\",\n  ]\n  // std's library lists the functions it holds: `; precompiled NAME`\n  out += held.map(k -> \"; precompiled \" + k)\n  out += parts.map(p -> codegen.file_line(p.0, p.1))\n  // the symbols a library exports (`; export add`); the rest are hidden\n  out += if fuzz == [] && library == [] && calls == [] && tests is None {\n    codegen.exports_of(given).map(e -> \"; export \" + e.0)\n  } else {\n    []\n  }\n  out += g.globals\n  mut out.push(\"\")\n  // std's library exposes only its functions\n  out += if library != [] {\n    codegen.internal(bodies + g.helper_defs, set(roots))\n  } else {\n    bodies + g.helper_defs\n  }\n  for d in codegen.declarations() {\n    if contains(g.used, d.0) {\n      mut out.push(d.1)\n    }\n  }\n  ir_text := join(out, \"\\n\") + \"\\n\"\n  Ok(if g.memory_sites {\n    codegen.counted_sites(ir_text)\n  } else {\n    ir_text\n  })\n}","old_text":"/// The program's `main` and what it calls as LLVM IR, or the constructs not\n/// compiled, each with its function. `assumed_clauses` also checks the\n/// assumed contract clauses (`--check-assumed`). Verify's fuzz drivers\n/// always check them.\npub fn generate(\n  given: List[ast.Decl],\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  proofs: List[String],\n  tests: Option[List[(String, String)]],\n  fuzz: List[String],\n  fuzz_text: Bool,\n  calls: List[String],\n  trace: Bool,\n  library: List[String],\n  precompiled: List[String],\n  bare: Bool,\n  copies: Option[Dict[String, String]],\n  memory_sites: Option[Dict[String, String]],\n  assumed_clauses: Bool,\n  live: Bool,\n) -> Result[String, List[String]] {\n  // unused variables with no effect are not compiled (`unread_dropped`),\n  // and assumed contract clauses are left out (`assumed_compiled`)\n  timings.begin(\"codegen: tables\")\n  keep := assumed_clauses || fuzz != []\n  // lemmas and proofs (`assert … by`, `calc`) are for `verify` alone: never\n  // compiled\n  (start, main) := codegen.new_gen(\n    given\n      .filter(d -> !match d.kind {\n        ast.FnDef(f) => f.lemma,\n        _ => false,\n      })\n      .map(d -> walk.rewrite_decl(\n        codegen.assumed_compiled(d, keep),\n        x -> codegen.unread_dropped(codegen.proofs_dropped(x)),\n      )),\n    core,\n    prelude,\n    proofs,\n    tests,\n    fuzz,\n    fuzz_text,\n    calls,\n    trace,\n    library,\n    precompiled,\n  ) except es {\n    timings.end(\"codegen: tables\")\n    return Err(es)\n  }\n  // core.rt (`bare`): no call-stack frames, no cancel points\n  mut g := if bare {\n    codegen.Gen {\n      ..start,\n      bare: true,\n      tasks: false,\n      supervises: false,\n    }\n  } else {\n    start\n  }\n  if live {\n    g.live = true\n    // (no function's parameters known to be only borrowed)\n    g.keeps = Some(Dict[String, List[Bool]] {})\n  }\n  // `--copies`: report copies with their locations\n  match copies {\n    Some(sites) => {\n      g.copies = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  // (`--memory-sites`: each counting operation counted, by site)\n  match memory_sites {\n    Some(sites) => {\n      g.memory_sites = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  timings.end(\"codegen: tables\")\n  mut bodies := match tests {\n    // each test as `strata test` runs it (`strata.test.N`), with its name\n    Some(ts) => enumerate(ts).map(x -> codegen.test_entry(x.0, x.1.0, x.1.1)),\n    None => if fuzz != [] || library != [] || calls != [] {\n      []\n    } else if main.name == \"\" {\n      // a library starts when it is loaded\n      [codegen.library_start(mut g)]\n    } else {\n      [codegen.entry(mut g, main)]\n    },\n  }\n  // std's library runs in any program, with tasks or without. It holds its\n  // functions by key and its `impl`s' methods (`library_methods`), except\n  // those `!KEY` excludes. Generic functions, those depending on the\n  // compile, and trait values are compiled per program instead.\n  mut roots := []\n  mut held := []\n  left_out := set(library\n    .filter(k -> starts_with(k, \"!\"))\n    .map(k -> byte_slice(k, 1, byte_len(k))))\n  mut wanted := library.filter(k -> !starts_with(k, \"!\"))\n  if library != [] {\n    wanted += codegen.library_methods(mut g).filter(\n      k -> !contains(left_out, k),\n    )\n  }\n  for k in wanted {\n    match codegen.fn_of(g, k) {\n      Some(f) => if codegen.precompilable(mut g, k, f) {\n        sym := codegen.instance(mut g, k, f, Dict[String, check.Ty] {})\n        mut roots.push(sym)\n        mut held.push(k)\n      },\n      None => (),\n    }\n  }\n  // verify's fuzz drivers (`strata.fuzz.N`)\n  for (i, k) in enumerate(fuzz) {\n    mut bodies.push(codegen.fuzz_driver(mut g, i, k))\n  }\n  // `strata run f ARGS` calls (`strata.call.N`). `session:KEY` is a\n  // `strata repl` line, with the session's arguments.\n  for (i, k) in enumerate(calls) {\n    mut bodies.push(\n      if starts_with(k, \"session:\") {\n        codegen.session_entry(\n          mut g,\n          i,\n          byte_slice(k, 8, byte_len(k)),\n        )\n      } else {\n        codegen.call_entry(mut g, i, k)\n      },\n    )\n  }\n  // the exports of `derive C for f`, each under its symbol\n  if fuzz == [] && library == [] && calls == [] && tests is None {\n    for (symbol, k) in codegen.exports_of(given) {\n      mut bodies.push(codegen.export_entry(mut g, symbol, k))\n    }\n  }\n  // the files they generate: the C header\n  parts := codegen.file_parts(given) except e { return Err([e]) }\n  // Each reachable function instance, once, in rounds. The workers compile\n  // each function of a round alone from the state the round began with.\n  // Their additions are then merged in queue order, so the output does not\n  // depend on thread timing.\n  timings.begin(\"codegen: keeps\")\n  if len(g.queue) > 0 && g.keeps is None {\n    g.keeps = Some(codegen.kept_by(g.fns))\n  }\n  timings.end(\"codegen: keeps\")\n  timings.begin(\"codegen: unique\")\n  // the updates in place proven to find their value held once, for builds\n  // and tests (not for verify's fuzzing, `strata run f` and compile-time\n  // code, which run once). Only a program's build sees every call of its\n  // functions (`closed`).\n  if len(g.queue) > 0 && !bare && !live && fuzz == [] && calls == [] {\n    closed := library == []\n      && tests is None\n      && main.name != \"\"\n      && codegen.exports_of(given) == []\n    g.proven = unique.proven_sites(\n      g.fns,\n      codegen.keeps_of(mut g),\n      closed,\n      g.distincts,\n      g.traits,\n    )\n  }\n  // (`--memory-sites`: where scoped allocation would put each value)\n  if g.memory_sites && len(g.queue) > 0 {\n    g.roots = roots.verdicts(\n      g.fns,\n      codegen.keeps_of(mut g),\n      g.traits,\n      g.proven,\n    )\n  }\n  timings.end(\"codegen: unique\")\n  mut global_keys := set(g.globals.map(l -> codegen.global_key(l)))\n  mut def_keys := set(g.helper_defs.map(d -> codegen.def_key(d)))\n  timings.begin(\"codegen: functions\")\n  while len(g.queue) > 0 {\n    round := g.queue\n    g.queue = []\n    base := g\n    for (body, d) in parallel.map_parallel(\n      round,\n      item -> codegen.compiled_alone(base, item.0, item.1, main),\n    ) {\n      mut bodies.push(body)\n      codegen.merge_alone(\n        mut g,\n        base,\n        d,\n        mut global_keys,\n        mut def_keys,\n      )\n    }\n  }\n  timings.end(\"codegen: functions\")\n  if len(g.errs) > 0 {\n    // std's library leaves out the functions that reach something not\n    // compiled\n    if library != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      out := wanted.filter(k -> contains(left, k))\n      if out != [] {\n        return Err(out.map(k -> \"leave out: \" + k))\n      }\n    }\n    // verify's fuzz drivers: each one reaching something not compiled is\n    // reported as `can't fuzz `KEY`: WHY`, so `verify` drops them all at\n    // once\n    if fuzz != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      callees := codegen.callees_of(g.callers)\n      return Err(g.errs\n        + fuzz\n          .filter(k -> contains(left, \"fuzz:\" + k))\n          .map(k -> \"can't fuzz `\"\n            + k\n            + \"`: \"\n            + join(\n              codegen.failures_of(callees, g.why, \"fuzz:\" + k),\n              \"; \",\n            )))\n    }\n    return Err(g.errs)\n  }\n  mut out := [\n    \"; Strata, compiled by compiler/codegen\",\n    f\"; checks left out {g.left_out}, kept {g.kept}\",\n    \"\",\n  ]\n  // std's library lists the functions it holds: `; precompiled NAME`\n  out += held.map(k -> \"; precompiled \" + k)\n  out += parts.map(p -> codegen.file_line(p.0, p.1))\n  // the symbols a library exports (`; export add`); the rest are hidden\n  out += if fuzz == [] && library == [] && calls == [] && tests is None {\n    codegen.exports_of(given).map(e -> \"; export \" + e.0)\n  } else {\n    []\n  }\n  out += g.globals\n  mut out.push(\"\")\n  // std's library exposes only its functions\n  out += if library != [] {\n    codegen.internal(bodies + g.helper_defs, set(roots))\n  } else {\n    bodies + g.helper_defs\n  }\n  for d in codegen.declarations() {\n    if contains(g.used, d.0) {\n      mut out.push(d.1)\n    }\n  }\n  ir_text := join(out, \"\\n\") + \"\\n\"\n  Ok(if g.memory_sites {\n    codegen.counted_sites(ir_text)\n  } else {\n    ir_text\n  })\n}"},{"name":"codegen.impl_methods","kind":"fn","old":null,"new":"4435d5ba0d6a4e10","interface_changed":true,"affected":[],"module":"codegen","text":"/// Each `impl`'s methods, and the trait's default ones it doesn't write,\n/// registered as functions (`register_method`) for the analyses that run\n/// before compiling: the method a call `x.m(..)` with `x` of type `TYPE`\n/// runs (`method_key`, by `TYPE.m`), and the keys of all of them. A sum\n/// whose variants have their own `m` dispatches on the tag, so `SUM.m` is\n/// left out, as is a trait's.\nfn impl_methods(mut g: codegen.Gen) -> (Dict[String, String], Set[String]) {\n  mut resolved := Dict[String, String] {}\n  mut all := Set[String] {}\n  for im in g.impls {\n    tr := im.decl.trait_name\n    mut names := im.decl.methods.map(f -> f.name)\n    match get(g.traits, tr) {\n      Some(t) => {\n        for m in t.methods {\n          if m.default && !contains(names, m.decl.name) {\n            mut names.push(m.decl.name)\n          }\n        }\n      },\n      None => (),\n    }\n    for name in names {\n      k := if tr == \"\" {\n        codegen.method_key(mut g, im.head, name)\n      } else {\n        codegen.trait_method_key(mut g, tr, im.head, name)\n      }\n      if k != \"\" {\n        mut all.insert(k)\n      }\n      r := codegen.method_key(mut g, im.head, name)\n      by_variant := contains(g.types.sums, im.head)\n        && (get(g.types.variants, im.head) ?? []).any(\n          c -> codegen.own_method(g, c, name),\n        )\n      if r != \"\" && !contains(g.traits, im.head) && !by_variant {\n        mut resolved.insert(im.head + \".\" + name, r)\n      }\n    }\n  }\n  (resolved, all)\n}"},{"name":"unique.Program","kind":"type","old":"25585d8b61202a3d","new":"de5a76be85107438","interface_changed":true,"affected":["unique.proven_sites","unique.unknown_callers","unique.analyzed","unique.tail","unique.block_flow","unique.stmt_flow","unique.fresh_value","unique.ex","unique.call_flow","unique.borrows","unique.keeps","unique.candidates","unique.scalar_value","unique.mut_param","unique.mut_method","unique.match_flow","unique.returns","unique.assign_flow","unique.loop_flow","unique.loop_pass","unique.lent","unique.method_targets","unique.local_call","codegen.generate","codegen_with","core_rt_text","computed_value","repl_eval","std_library","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","build_core_command","comptime_value","repl_command","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","literal_errors_of","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","strata_command","comptime_values","graph_command","graph_diff","loaded_check","file_errors","edit_file","edit_errors","search_invariants","build_proofs","verify_file","check_fn","command_line","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","main","with_base","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","codegen.read_back","eval_files"],"module":"unique","text":"/// The program as the analysis reads it: its functions by key, which\n/// parameters each may keep (codegen's `kept_by`), the keys by short name,\n/// the `distinct` types, the names of the traits' methods, and the function\n/// each method call resolves to by its receiver's type\n/// (`TYPE.method` -> key).\ntype Program = {\n  fns: Dict[String, ast.FnDecl],\n  kept: Dict[String, List[Bool]],\n  by_short: Dict[String, List[String]],\n  distinct: Set[String],\n  methods: Set[String],\n  resolved: Dict[String, String],\n}","old_text":"/// The program as the analysis reads it: its functions by key, which\n/// parameters each may keep (codegen's `kept_by`), the keys by short name,\n/// the `distinct` types, and the names of the traits' methods.\ntype Program = {\n  fns: Dict[String, ast.FnDecl],\n  kept: Dict[String, List[Bool]],\n  by_short: Dict[String, List[String]],\n  distinct: Set[String],\n  methods: Set[String],\n}"},{"name":"unique.Ctx","kind":"type","old":"f1a0bf9c5558ff2e","new":"255e513056012b49","interface_changed":true,"affected":["unique.proven_sites","unique.analyzed","unique.tail","unique.block_flow","unique.stmt_flow","unique.held","unique.ex","unique.call_flow","unique.mut_method","unique.site","unique.match_flow","unique.returns","unique.assign_flow","unique.loop_flow","unique.loop_pass","unique.lent","unique.method_targets","unique.local_call","codegen.generate","codegen_with","core_rt_text","computed_value","repl_eval","std_library","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","build_core_command","comptime_value","repl_command","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","literal_errors_of","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","strata_command","comptime_values","graph_command","graph_diff","loaded_check","file_errors","edit_file","edit_errors","search_invariants","build_proofs","verify_file","check_fn","command_line","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","main","with_base","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","codegen.read_back","eval_files"],"module":"unique","text":"/// One function's analysis: its key and parameters, the collection kind\n/// of each variable (`kinds`), the names its code binds (`locals`, which\n/// shadow the program's functions), the type each variable is written with\n/// (`heads`), whether this pass records (`record`, false\n/// while a loop's state is still being found), the states at `break` and\n/// `continue` of the innermost loop, and what the recording passes found:\n/// whether every return gives a fresh value, the `mut` parameters held once\n/// at every return, the calls with `mut` arguments (callee, parameter, held\n/// once) and the sites' verdicts.\ntype Ctx = {\n  key: String,\n  params: List[ast.Param],\n  kinds: Dict[String, String],\n  locals: Set[String],\n  heads: Dict[String, String],\n  ret: String,\n  record: Bool,\n  breaks: List[unique.St],\n  conts: List[unique.St],\n  fresh: Bool,\n  exits: Set[String],\n  calls: List[(String, Int, Bool)],\n  sites: Dict[String, Bool],\n}","old_text":"/// One function's analysis: its key and parameters, the collection kind\n/// of each variable (`kinds`), whether this pass records (`record`, false\n/// while a loop's state is still being found), the states at `break` and\n/// `continue` of the innermost loop, and what the recording passes found:\n/// whether every return gives a fresh value, the `mut` parameters held once\n/// at every return, the calls with `mut` arguments (callee, parameter, held\n/// once) and the sites' verdicts.\ntype Ctx = {\n  key: String,\n  params: List[ast.Param],\n  kinds: Dict[String, String],\n  ret: String,\n  record: Bool,\n  breaks: List[unique.St],\n  conts: List[unique.St],\n  fresh: Bool,\n  exits: Set[String],\n  calls: List[(String, Int, Bool)],\n  sites: Dict[String, Bool],\n}"},{"name":"unique.proven_sites","kind":"fn","old":"d7138f1a00936d4e","new":"568650cbc8c5c30d","interface_changed":true,"affected":["codegen.generate","codegen_with","core_rt_text","computed_value","repl_eval","std_library","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","build_core_command","comptime_value","repl_command","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","literal_errors_of","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","strata_command","comptime_values","graph_command","graph_diff","loaded_check","file_errors","edit_file","edit_errors","search_invariants","build_proofs","verify_file","check_fn","command_line","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","main","with_base","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","codegen.read_back","eval_files"],"module":"unique","text":"/// The updates in place proven to find their value held once, by\n/// `site_key` and `mut_key`. A site is proven when every place it occurs at\n/// is. `closed` says every call of the program's functions is in `fns` (a\n/// program's build): else no `mut` parameter is assumed held once at entry.\n/// `resolved` gives the method a call `x.m(..)` runs for `x`'s type\n/// (`TYPE.m` -> key); `methods` are the keys of the `impl`s' methods.\n/// The summaries are a greatest fixed point: each starts true and is made\n/// false where a function's body breaks it, until nothing changes. The\n/// first round analyzes every function; each later one only those whose\n/// analysis reads a summary the round before changed (`names_in`), which\n/// gives the same fixed point as analyzing all each round. Cost: one pass\n/// over every function (on worker threads), then over the few whose\n/// inputs changed, per round;\n/// each loop is walked until its state stops shrinking.\npub fn proven_sites(\n  fns: Dict[String, ast.FnDecl],\n  kept: Dict[String, List[Bool]],\n  closed: Bool,\n  distinct: Set[String],\n  traits: Dict[String, ast.TraitDecl],\n  resolved: Dict[String, String],\n  methods: Set[String],\n) -> Set[String] {\n  mut by_short := Dict[String, List[String]] {}\n  for k in keys(fns) {\n    n := unique.short(k)\n    mut by_short.insert(n, (get(by_short, n) ?? []) + [k])\n  }\n  mut names := Set[String] {}\n  for t in values(traits) {\n    for m in t.methods {\n      mut names.insert(m.decl.name)\n    }\n  }\n  p := unique.Program {\n    fns,\n    kept,\n    by_short,\n    distinct,\n    methods: names,\n    resolved,\n  }\n  // (an `impl`'s method may also be called as a value, `T.m`)\n  mut unknown := unique.unknown_callers(p, closed, traits)\n  for k in methods {\n    mut unknown.insert(k)\n  }\n  mut sum := unique.Summary {\n    fresh: Dict[String, Bool] {},\n    entry: Dict[String, List[Bool]] {},\n    exit: Dict[String, List[Bool]] {},\n  }\n  for (k, f) in items(fns) {\n    mut sum.fresh.insert(k, true)\n    mut sum.entry.insert(\n      k,\n      f.params.map(x -> x.mutable && !contains(unknown, k)),\n    )\n    mut sum.exit.insert(k, f.params.map(x -> x.mutable))\n  }\n  // (whose analyses read each function's summaries: its own, and those of\n  // the functions of each short name its body calls)\n  mut users := Dict[String, List[String]] {}\n  for (k, f) in items(fns) {\n    mut reads := Set[String] { k }\n    for n in unique.names_in(f.body) {\n      for x in get(by_short, n) ?? [] {\n        mut reads.insert(x)\n      }\n    }\n    for x in reads {\n      mut users.insert(x, (get(users, x) ?? []) + [k])\n    }\n  }\n  mut ctxs := Dict[String, unique.Ctx] {}\n  mut dirty := keys(fns)\n  while dirty != [] {\n    mut fresh := sum.fresh\n    mut exit := sum.exit\n    mut entry := sum.entry\n    mut changed := Set[String] {}\n    // (each analysis only reads: on worker threads, each in its own arena,\n    // in order)\n    done := parallel.map_parallel(dirty, k -> std.memory.arena(\n      () ->\n        unique.analyzed(p, sum, k, get(fns, k) ?? unique.no_fn()),\n    ))\n    for (j, k) in enumerate(dirty) {\n      f := get(fns, k) ?? unique.no_fn()\n      c := get(done, j) ?? unique.analyzed(p, sum, k, f)\n      now := get(sum.fresh, k) ?? false && c.fresh\n      if now != get(sum.fresh, k) ?? false {\n        mut fresh.insert(k, now)\n        mut changed.insert(k)\n      }\n      was := get(sum.exit, k) ?? []\n      ex_now := enumerate(f.params).map(\n        x -> get(was, x.0) ?? false && contains(c.exits, x.1.name),\n      )\n      if ex_now != was {\n        mut exit.insert(k, ex_now)\n        mut changed.insert(k)\n      }\n      unique.entry_lowered(mut entry, c.calls, mut changed)\n      mut ctxs.insert(k, c)\n    }\n    sum = unique.Summary { fresh, entry, exit }\n    mut next := Set[String] {}\n    for k in changed {\n      for u in get(users, k) ?? [] {\n        mut next.insert(u)\n      }\n    }\n    dirty = to_list(next)\n  }\n  mut sites := Dict[String, Bool] {}\n  for c in values(ctxs) {\n    for (s, v) in items(c.sites) {\n      mut sites.insert(s, get(sites, s) ?? true && v)\n    }\n  }\n  set(items(sites).filter(x -> x.1).map(x -> x.0))\n}","old_text":"/// The updates in place proven to find their value held once, by\n/// `site_key` and `mut_key`. A site is proven when every place it occurs at\n/// is. `closed` says every call of the program's functions is in `fns` (a\n/// program's build): else no `mut` parameter is assumed held once at entry.\n/// The summaries are a greatest fixed point: each starts true and is made\n/// false where a function's body breaks it, until nothing changes. The\n/// first round analyzes every function; each later one only those whose\n/// analysis reads a summary the round before changed (`names_in`), which\n/// gives the same fixed point as analyzing all each round. Cost: one pass\n/// over every function (on worker threads), then over the few whose\n/// inputs changed, per round;\n/// each loop is walked until its state stops shrinking.\npub fn proven_sites(\n  fns: Dict[String, ast.FnDecl],\n  kept: Dict[String, List[Bool]],\n  closed: Bool,\n  distinct: Set[String],\n  traits: Dict[String, ast.TraitDecl],\n) -> Set[String] {\n  mut by_short := Dict[String, List[String]] {}\n  for k in keys(fns) {\n    n := unique.short(k)\n    mut by_short.insert(n, (get(by_short, n) ?? []) + [k])\n  }\n  mut methods := Set[String] {}\n  for t in values(traits) {\n    for m in t.methods {\n      mut methods.insert(m.decl.name)\n    }\n  }\n  p := unique.Program { fns, kept, by_short, distinct, methods }\n  unknown := unique.unknown_callers(p, closed, traits)\n  mut sum := unique.Summary {\n    fresh: Dict[String, Bool] {},\n    entry: Dict[String, List[Bool]] {},\n    exit: Dict[String, List[Bool]] {},\n  }\n  for (k, f) in items(fns) {\n    mut sum.fresh.insert(k, true)\n    mut sum.entry.insert(\n      k,\n      f.params.map(x -> x.mutable && !contains(unknown, k)),\n    )\n    mut sum.exit.insert(k, f.params.map(x -> x.mutable))\n  }\n  // (whose analyses read each function's summaries: its own, and those of\n  // the functions of each short name its body calls)\n  mut users := Dict[String, List[String]] {}\n  for (k, f) in items(fns) {\n    mut reads := Set[String] { k }\n    for n in unique.names_in(f.body) {\n      for x in get(by_short, n) ?? [] {\n        mut reads.insert(x)\n      }\n    }\n    for x in reads {\n      mut users.insert(x, (get(users, x) ?? []) + [k])\n    }\n  }\n  mut ctxs := Dict[String, unique.Ctx] {}\n  mut dirty := keys(fns)\n  while dirty != [] {\n    mut fresh := sum.fresh\n    mut exit := sum.exit\n    mut entry := sum.entry\n    mut changed := Set[String] {}\n    // (each analysis only reads: on worker threads, each in its own arena,\n    // in order)\n    done := parallel.map_parallel(dirty, k -> std.memory.arena(\n      () ->\n        unique.analyzed(p, sum, k, get(fns, k) ?? unique.no_fn()),\n    ))\n    for (j, k) in enumerate(dirty) {\n      f := get(fns, k) ?? unique.no_fn()\n      c := get(done, j) ?? unique.analyzed(p, sum, k, f)\n      now := get(sum.fresh, k) ?? false && c.fresh\n      if now != get(sum.fresh, k) ?? false {\n        mut fresh.insert(k, now)\n        mut changed.insert(k)\n      }\n      was := get(sum.exit, k) ?? []\n      ex_now := enumerate(f.params).map(\n        x -> get(was, x.0) ?? false && contains(c.exits, x.1.name),\n      )\n      if ex_now != was {\n        mut exit.insert(k, ex_now)\n        mut changed.insert(k)\n      }\n      unique.entry_lowered(mut entry, c.calls, mut changed)\n      mut ctxs.insert(k, c)\n    }\n    sum = unique.Summary { fresh, entry, exit }\n    mut next := Set[String] {}\n    for k in changed {\n      for u in get(users, k) ?? [] {\n        mut next.insert(u)\n      }\n    }\n    dirty = to_list(next)\n  }\n  mut sites := Dict[String, Bool] {}\n  for c in values(ctxs) {\n    for (s, v) in items(c.sites) {\n      mut sites.insert(s, get(sites, s) ?? true && v)\n    }\n  }\n  set(items(sites).filter(x -> x.1).map(x -> x.0))\n}"},{"name":"unique.analyzed","kind":"fn","old":"bb8842499bf381d1","new":"8f2a4e620412370b","interface_changed":false,"affected":[],"module":"unique","text":"/// Function `k` analyzed with summaries `sum`: its body from the state\n/// where each `mut` parameter is held once (as `exit` assumes), on the\n/// condition of `entry`. A parameter that a contract's `old` reads may be\n/// held by the snapshot too, so it starts as not held once.\nfn analyzed(\n  p: unique.Program,\n  sum: unique.Summary,\n  k: String,\n  f: ast.FnDecl,\n) -> unique.Ctx {\n  olds := f.post.any(e -> walk.any_expr(e, x -> x is ast.Old))\n  mut s := Set[String] {}\n  for x in f.params {\n    if x.mutable\n      && !(olds && f.post.any(e -> unique.mentions(e, x.name))) {\n      mut s.insert(x.name)\n    }\n  }\n  mut kinds := Dict[String, String] {}\n  for x in f.params {\n    mut kinds.insert(x.name, unique.kind_of(Some(x.ty)))\n  }\n  kinds = unique.declared_kinds(f.body, kinds)\n  mut bound := f.params.map(x -> (x.name, Some(x.ty)))\n  for e in f.pre + f.post + [f.body] {\n    bound += unique.binders(e)\n  }\n  mut c := unique.Ctx {\n    key: k,\n    params: f.params,\n    kinds,\n    locals: set(bound.map(b -> b.0)),\n    heads: unique.written_heads(bound, set(f.type_params)),\n    ret: unique.kind_of(Some(f.ret)),\n    record: true,\n    breaks: [],\n    conts: [],\n    fresh: true,\n    exits: s,\n    calls: [],\n    sites: Dict[String, Bool] {},\n  }\n  _ := unique.tail(\n    p,\n    sum,\n    mut c,\n    f.body,\n    unique.St { live: true, s, a: s },\n  )\n  c\n}","old_text":"/// Function `k` analyzed with summaries `sum`: its body from the state\n/// where each `mut` parameter is held once (as `exit` assumes), on the\n/// condition of `entry`. A parameter that a contract's `old` reads may be\n/// held by the snapshot too, so it starts as not held once.\nfn analyzed(\n  p: unique.Program,\n  sum: unique.Summary,\n  k: String,\n  f: ast.FnDecl,\n) -> unique.Ctx {\n  olds := f.post.any(e -> walk.any_expr(e, x -> x is ast.Old))\n  mut s := Set[String] {}\n  for x in f.params {\n    if x.mutable\n      && !(olds && f.post.any(e -> unique.mentions(e, x.name))) {\n      mut s.insert(x.name)\n    }\n  }\n  mut kinds := Dict[String, String] {}\n  for x in f.params {\n    mut kinds.insert(x.name, unique.kind_of(Some(x.ty)))\n  }\n  kinds = unique.declared_kinds(f.body, kinds)\n  mut c := unique.Ctx {\n    key: k,\n    params: f.params,\n    kinds,\n    ret: unique.kind_of(Some(f.ret)),\n    record: true,\n    breaks: [],\n    conts: [],\n    fresh: true,\n    exits: s,\n    calls: [],\n    sites: Dict[String, Bool] {},\n  }\n  _ := unique.tail(\n    p,\n    sum,\n    mut c,\n    f.body,\n    unique.St { live: true, s, a: s },\n  )\n  c\n}"},{"name":"unique.stmt_flow","kind":"fn","old":"3151e05bcca180ac","new":"ce1b114f8c00431b","interface_changed":false,"affected":[],"module":"unique","text":"/// A statement from `st`: the state after it, and the names it declares.\nfn stmt_flow(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  s: ast.Stmt,\n  st: unique.St,\n) -> (unique.St, List[String]) {\n  if !st.live {\n    return (st, [])\n  }\n  match s {\n    ast.Let { pat, ty, value } => match pat {\n      ast.Bind(x) => {\n        f := unique.fresh_value(\n          p,\n          sum,\n          c.locals,\n          value,\n          unique.kind_of(ty),\n        )\n        (\n          unique.set_var(unique.ex(p, sum, mut c, value, st), x, f),\n          [x],\n        )\n      },\n      _ => {\n        names := unique.pattern_names(pat)\n        mut out := unique.ex(p, sum, mut c, value, st)\n        for k in walk.pattern_kids(pat) {\n          out = unique.ex(p, sum, mut c, k, out)\n        }\n        for n in names {\n          out = unique.spoil(out, n)\n        }\n        (out, names)\n      },\n    },\n    ast.VarDecl { name, ty, value } => {\n      want := match unique.kind_of(ty) {\n        \"\" => get(c.kinds, name) ?? \"\",\n        k => k,\n      }\n      f := unique.fresh_value(p, sum, c.locals, value, want)\n      (\n        unique.set_var(unique.ex(p, sum, mut c, value, st), name, f),\n        [name],\n      )\n    },\n    ast.Assign { place, value } => (unique.assign_flow(p, sum, mut c, place, value, st), []),\n    ast.While { cond, body } => (unique.loop_flow(p, sum, mut c, Some(cond), [], body, st), []),\n    ast.For { pat, iter, body } | ast.ComptimeFor { pat, iter, body } => {\n      after := unique.ex(p, sum, mut c, iter, st)\n      (unique.loop_flow(\n        p,\n        sum,\n        mut c,\n        Some(ast.BoolLit(true)),\n        unique.pattern_names(pat),\n        body,\n        after,\n      ), [])\n    },\n    ast.Break => {\n      mut c.breaks.push(st)\n      (unique.dead(), [])\n    },\n    ast.Continue => {\n      mut c.conts.push(st)\n      (unique.dead(), [])\n    },\n    ast.ExprStmt(e) | ast.Assert(e) | ast.Invariant(e) | ast.Decreases(e) => (unique.ex(p, sum, mut c, e, st), []),\n    _ => (st, []),\n  }\n}","old_text":"/// A statement from `st`: the state after it, and the names it declares.\nfn stmt_flow(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  s: ast.Stmt,\n  st: unique.St,\n) -> (unique.St, List[String]) {\n  if !st.live {\n    return (st, [])\n  }\n  match s {\n    ast.Let { pat, ty, value } => match pat {\n      ast.Bind(x) => {\n        f := unique.fresh_value(p, sum, value, unique.kind_of(ty))\n        (\n          unique.set_var(unique.ex(p, sum, mut c, value, st), x, f),\n          [x],\n        )\n      },\n      _ => {\n        names := unique.pattern_names(pat)\n        mut out := unique.ex(p, sum, mut c, value, st)\n        for k in walk.pattern_kids(pat) {\n          out = unique.ex(p, sum, mut c, k, out)\n        }\n        for n in names {\n          out = unique.spoil(out, n)\n        }\n        (out, names)\n      },\n    },\n    ast.VarDecl { name, ty, value } => {\n      want := match unique.kind_of(ty) {\n        \"\" => get(c.kinds, name) ?? \"\",\n        k => k,\n      }\n      f := unique.fresh_value(p, sum, value, want)\n      (\n        unique.set_var(unique.ex(p, sum, mut c, value, st), name, f),\n        [name],\n      )\n    },\n    ast.Assign { place, value } => (unique.assign_flow(p, sum, mut c, place, value, st), []),\n    ast.While { cond, body } => (unique.loop_flow(p, sum, mut c, Some(cond), [], body, st), []),\n    ast.For { pat, iter, body } | ast.ComptimeFor { pat, iter, body } => {\n      after := unique.ex(p, sum, mut c, iter, st)\n      (unique.loop_flow(\n        p,\n        sum,\n        mut c,\n        Some(ast.BoolLit(true)),\n        unique.pattern_names(pat),\n        body,\n        after,\n      ), [])\n    },\n    ast.Break => {\n      mut c.breaks.push(st)\n      (unique.dead(), [])\n    },\n    ast.Continue => {\n      mut c.conts.push(st)\n      (unique.dead(), [])\n    },\n    ast.ExprStmt(e) | ast.Assert(e) | ast.Invariant(e) | ast.Decreases(e) => (unique.ex(p, sum, mut c, e, st), []),\n    _ => (st, []),\n  }\n}"},{"name":"unique.fresh_value","kind":"fn","old":"87c87c3097f65f15","new":"02ee889817b137ba","interface_changed":true,"affected":["unique.stmt_flow","unique.returns","unique.assign_flow","unique.block_flow","unique.tail","unique.ex","unique.analyzed","unique.match_flow","unique.call_flow","unique.mut_method","unique.loop_pass","unique.lent","unique.local_call","unique.proven_sites","unique.loop_flow","codegen.generate","codegen_with","core_rt_text","computed_value","repl_eval","std_library","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","build_core_command","comptime_value","repl_command","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","literal_errors_of","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","strata_command","comptime_values","graph_command","graph_diff","loaded_check","file_errors","edit_file","edit_errors","search_invariants","build_proofs","verify_file","check_fn","command_line","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","main","with_base","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","codegen.read_back","eval_files"],"module":"unique","text":"/// Whether `e` makes a new value only its destination holds, of kind\n/// `want` (\"\" when not known): a constructor with fields (not of a\n/// `distinct` type), a list literal (an empty one only where a list is\n/// wanted, since an empty set or dict is a shared constant; a non-empty\n/// one when an element is `made` at run time), a set or dict\n/// literal with elements, or a call of a function whose result is fresh\n/// (none of `locals`, which shadow the program's functions).\nfn fresh_value(\n  p: unique.Program,\n  sum: unique.Summary,\n  locals: Set[String],\n  e: ast.Expr,\n  want: String,\n) -> Bool\n  ensures e is ast.Var ==> !it\n  ensures e is ast.FieldOf ==> !it\n  ensures e == ast.ListExpr([]) && want != \"List\" ==> !it\n  ensures e == ast.ListExpr([ast.IntLit(0)]) ==> !it {\n  match e {\n    ast.CtorExpr { name, args } => !contains(p.distinct, name)\n      && match args {\n        ast.PositionalArgs(xs) => xs != [],\n        ast.RecordArgs(fs) => fs != [],\n        ast.NoArgs => false,\n      },\n    ast.ListExpr(xs) => if xs == [] {\n      want == \"List\"\n    } else {\n      want != \"Set\" && want != \"Dict\" && xs.any(x -> unique.made(x))\n    },\n    ast.Call { callee: ast.Var(n), .. } => !contains(locals, n)\n      && contains(p.fns, n)\n      && !contains(p.methods, unique.short(n))\n      && get(sum.fresh, n) ?? false,\n    ast.IfExpr { then, otherwise, .. } => unique.fresh_value(p, sum, locals, then, want)\n      && unique.fresh_value(p, sum, locals, otherwise, want),\n    ast.Block { stmts: [], last } => unique.fresh_value(p, sum, locals, last, want),\n    _ => false,\n  }\n}","old_text":"/// Whether `e` makes a new value only its destination holds, of kind\n/// `want` (\"\" when not known): a constructor with fields (not of a\n/// `distinct` type), a list literal (an empty one only where a list is\n/// wanted, since an empty set or dict is a shared constant; a non-empty\n/// one when an element is `made` at run time), a set or dict\n/// literal with elements, or a call of a function whose result is fresh.\nfn fresh_value(\n  p: unique.Program,\n  sum: unique.Summary,\n  e: ast.Expr,\n  want: String,\n) -> Bool\n  ensures e is ast.Var ==> !it\n  ensures e is ast.FieldOf ==> !it\n  ensures e == ast.ListExpr([]) && want != \"List\" ==> !it\n  ensures e == ast.ListExpr([ast.IntLit(0)]) ==> !it {\n  match e {\n    ast.CtorExpr { name, args } => !contains(p.distinct, name)\n      && match args {\n        ast.PositionalArgs(xs) => xs != [],\n        ast.RecordArgs(fs) => fs != [],\n        ast.NoArgs => false,\n      },\n    ast.ListExpr(xs) => if xs == [] {\n      want == \"List\"\n    } else {\n      want != \"Set\" && want != \"Dict\" && xs.any(x -> unique.made(x))\n    },\n    ast.Call { callee: ast.Var(n), .. } => contains(p.fns, n)\n      && !contains(p.methods, unique.short(n))\n      && get(sum.fresh, n) ?? false,\n    ast.IfExpr { then, otherwise, .. } => unique.fresh_value(p, sum, then, want)\n      && unique.fresh_value(p, sum, otherwise, want),\n    ast.Block { stmts: [], last } => unique.fresh_value(p, sum, last, want),\n    _ => false,\n  }\n}"},{"name":"unique.ex","kind":"fn","old":"9000ff8676f86e19","new":"93199544c3e56a7a","interface_changed":false,"affected":[],"module":"unique","text":"/// The state after `e` runs from `st`. A variable used in any way not\n/// known to leave its count alone is no longer held once.\nfn ex(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  e: ast.Expr,\n  st: unique.St,\n) -> unique.St {\n  if !st.live {\n    return st\n  }\n  match operators.lowered_node(e) {\n    ast.Var(x) => unique.spoil(st, x),\n    // reads\n    ast.FieldOf { base: ast.Var(_), .. } => st,\n    ast.IsExpr { value: ast.Var(_), .. } => st,\n    ast.Binary { op, left, right } => if op == ast.And || op == ast.Or || op == ast.Implies {\n      l := unique.ex(p, sum, mut c, left, st)\n      unique.merged(l, unique.ex(p, sum, mut c, right, l))\n    } else if unique.compares(op) {\n      l := match left {\n        ast.Var(x) => if unique.mentions(right, x) {\n          unique.spoil(st, x)\n        } else {\n          st\n        },\n        _ => unique.ex(p, sum, mut c, left, st),\n      }\n      match right {\n        ast.Var(_) => l,\n        _ => unique.ex(p, sum, mut c, right, l),\n      }\n    } else {\n      l := unique.ex(p, sum, mut c, left, st)\n      unique.ex(p, sum, mut c, right, l)\n    },\n    ast.Call { callee: ast.Var(name), args } => unique.call_flow(p, sum, mut c, name, args, st),\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => unique.mut_method(p, sum, mut c, e, recv, name, args, st),\n    ast.MethodCall { recv, name, args } => {\n      (ts, known) := unique.method_targets(p, c, recv, name)\n      mut out := match recv {\n        ast.Var(x) => if (unique.reads_only(name) || known && ts != [])\n          && ts.all(k -> !unique.keeps(p, k, 0))\n          && !args.any(o -> unique.mentions(o, x)) {\n          st\n        } else {\n          unique.spoil(st, x)\n        },\n        _ => unique.ex(p, sum, mut c, recv, st),\n      }\n      for a in args {\n        if !(a is ast.MutExpr) {\n          out = unique.ex(p, sum, mut c, a, out)\n        }\n      }\n      unique.lent(p, sum, mut c, ts, 1, known, args, [recv], out)\n    },\n    ast.IfExpr { cond, then, otherwise } => {\n      s1 := unique.ex(p, sum, mut c, cond, st)\n      unique.merged(\n        unique.ex(p, sum, mut c, then, s1),\n        unique.ex(p, sum, mut c, otherwise, s1),\n      )\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => unique.match_flow(\n      p,\n      sum,\n      mut c,\n      scrutinee,\n      binding,\n      arms,\n      st,\n      false,\n    ),\n    ast.Block { stmts, last } => unique.block_flow(p, sum, mut c, stmts, last, st, false),\n    ast.Return(x) => unique.returns(p, sum, mut c, x, st),\n    ast.Lambda { body, .. } => {\n      // its own function: its returns, breaks and continues are its own,\n      // and nothing it captures is known held once\n      (fresh, exits, breaks, conts) := (c.fresh, c.exits, c.breaks, c.conts)\n      c.breaks = []\n      c.conts = []\n      _ := unique.ex(\n        p,\n        sum,\n        mut c,\n        body,\n        unique.St {\n          live: true,\n          s: Set[String] {},\n          a: Set[String] {},\n        },\n      )\n      c.fresh = fresh\n      c.exits = exits\n      c.breaks = breaks\n      c.conts = conts\n      unique.spoil_in(st, e)\n    },\n    ast.Spawn(_) | ast.SupervisedSpawn(_) | ast.Scope(_) | ast.Comptime(_) | ast.Select(_) | ast.Race(_) | ast.Old(_) | ast.Assumed(_) | ast.Await(_) => {\n      // run elsewhere, or more than once: walked with nothing held once\n      for k in walk.kids(e) {\n        _ := unique.ex(p, sum, mut c, k, unique.St {\n          live: true,\n          s: Set[String] {},\n          a: Set[String] {},\n        })\n      }\n      unique.spoil_in(st, e)\n    },\n    _ => {\n      mut out := st\n      for k in walk.kids(e) {\n        out = unique.ex(p, sum, mut c, k, out)\n      }\n      out\n    },\n  }\n}","old_text":"/// The state after `e` runs from `st`. A variable used in any way not\n/// known to leave its count alone is no longer held once.\nfn ex(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  e: ast.Expr,\n  st: unique.St,\n) -> unique.St {\n  if !st.live {\n    return st\n  }\n  match operators.lowered_node(e) {\n    ast.Var(x) => unique.spoil(st, x),\n    // reads\n    ast.FieldOf { base: ast.Var(_), .. } => st,\n    ast.IsExpr { value: ast.Var(_), .. } => st,\n    ast.Binary { op, left, right } => if op == ast.And || op == ast.Or || op == ast.Implies {\n      l := unique.ex(p, sum, mut c, left, st)\n      unique.merged(l, unique.ex(p, sum, mut c, right, l))\n    } else if unique.compares(op) {\n      l := match left {\n        ast.Var(x) => if unique.mentions(right, x) {\n          unique.spoil(st, x)\n        } else {\n          st\n        },\n        _ => unique.ex(p, sum, mut c, left, st),\n      }\n      match right {\n        ast.Var(_) => l,\n        _ => unique.ex(p, sum, mut c, right, l),\n      }\n    } else {\n      l := unique.ex(p, sum, mut c, left, st)\n      unique.ex(p, sum, mut c, right, l)\n    },\n    ast.Call { callee: ast.Var(name), args } => unique.call_flow(p, sum, mut c, name, args, st),\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => unique.mut_method(p, sum, mut c, e, recv, name, args, st),\n    ast.MethodCall { recv, name, args } => {\n      mut out := match recv {\n        ast.Var(x) => if unique.reads_only(name)\n          && (get(p.by_short, name) ?? []).all(\n            k -> !unique.keeps(p, k, 0),\n          )\n          && !args.any(o -> unique.mentions(o, x)) {\n          st\n        } else {\n          unique.spoil(st, x)\n        },\n        _ => unique.ex(p, sum, mut c, recv, st),\n      }\n      for a in args {\n        if !(a is ast.MutExpr) {\n          out = unique.ex(p, sum, mut c, a, out)\n        }\n      }\n      unique.lent(\n        p,\n        sum,\n        mut c,\n        get(p.by_short, name) ?? [],\n        1,\n        false,\n        args,\n        [recv],\n        out,\n      )\n    },\n    ast.IfExpr { cond, then, otherwise } => {\n      s1 := unique.ex(p, sum, mut c, cond, st)\n      unique.merged(\n        unique.ex(p, sum, mut c, then, s1),\n        unique.ex(p, sum, mut c, otherwise, s1),\n      )\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => unique.match_flow(\n      p,\n      sum,\n      mut c,\n      scrutinee,\n      binding,\n      arms,\n      st,\n      false,\n    ),\n    ast.Block { stmts, last } => unique.block_flow(p, sum, mut c, stmts, last, st, false),\n    ast.Return(x) => unique.returns(p, sum, mut c, x, st),\n    ast.Lambda { body, .. } => {\n      // its own function: its returns, breaks and continues are its own,\n      // and nothing it captures is known held once\n      (fresh, exits, breaks, conts) := (c.fresh, c.exits, c.breaks, c.conts)\n      c.breaks = []\n      c.conts = []\n      _ := unique.ex(\n        p,\n        sum,\n        mut c,\n        body,\n        unique.St {\n          live: true,\n          s: Set[String] {},\n          a: Set[String] {},\n        },\n      )\n      c.fresh = fresh\n      c.exits = exits\n      c.breaks = breaks\n      c.conts = conts\n      unique.spoil_in(st, e)\n    },\n    ast.Spawn(_) | ast.SupervisedSpawn(_) | ast.Scope(_) | ast.Comptime(_) | ast.Select(_) | ast.Race(_) | ast.Old(_) | ast.Assumed(_) | ast.Await(_) => {\n      // run elsewhere, or more than once: walked with nothing held once\n      for k in walk.kids(e) {\n        _ := unique.ex(p, sum, mut c, k, unique.St {\n          live: true,\n          s: Set[String] {},\n          a: Set[String] {},\n        })\n      }\n      unique.spoil_in(st, e)\n    },\n    _ => {\n      mut out := st\n      for k in walk.kids(e) {\n        out = unique.ex(p, sum, mut c, k, out)\n      }\n      out\n    },\n  }\n}"},{"name":"unique.call_flow","kind":"fn","old":"aa0000a2bfd7cd5b","new":"ebffd5b8ccd225b0","interface_changed":false,"affected":[],"module":"unique","text":"/// `name(args)`: the arguments worked out in order, those not `mut` first,\n/// then the `mut` ones (`lent`). A variable passed to a parameter the\n/// callee doesn't keep is only borrowed, when no later argument mentions\n/// it. A `mut` argument stays held once only when `name` is a function of\n/// the program, the only one the call may run. A call of a variable\n/// (`local_call`) runs no function the program names.\nfn call_flow(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  name: String,\n  args: List[ast.Expr],\n  st: unique.St,\n) -> unique.St {\n  if contains(c.locals, name) {\n    return unique.local_call(p, sum, mut c, args, st)\n  }\n  mut out := st\n  for (i, a) in enumerate(args) {\n    match a {\n      ast.MutExpr(_) => (),\n      // borrowed, unless a later argument mentions it: the call holds the\n      // value while those are worked out\n      ast.Var(x) => if !unique.borrows(p, name, i)\n        || drop(args, i + 1).any(o -> unique.mentions(o, x)) {\n        out = unique.spoil(out, x)\n      },\n      _ => {\n        out = unique.ex(p, sum, mut c, a, out)\n      },\n    }\n  }\n  known := contains(p.fns, name) && !contains(p.methods, unique.short(name))\n  unique.lent(\n    p,\n    sum,\n    mut c,\n    unique.candidates(p, name),\n    0,\n    known,\n    args,\n    [],\n    out,\n  )\n}","old_text":"/// `name(args)`: the arguments worked out in order, those not `mut` first,\n/// then the `mut` ones (`lent`). A variable passed to a parameter the\n/// callee doesn't keep is only borrowed, when no later argument mentions\n/// it.\nfn call_flow(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  name: String,\n  args: List[ast.Expr],\n  st: unique.St,\n) -> unique.St {\n  mut out := st\n  for (i, a) in enumerate(args) {\n    match a {\n      ast.MutExpr(_) => (),\n      // borrowed, unless a later argument mentions it: the call holds the\n      // value while those are worked out\n      ast.Var(x) => if !unique.borrows(p, name, i)\n        || drop(args, i + 1).any(o -> unique.mentions(o, x)) {\n        out = unique.spoil(out, x)\n      },\n      _ => {\n        out = unique.ex(p, sum, mut c, a, out)\n      },\n    }\n  }\n  unique.lent(\n    p,\n    sum,\n    mut c,\n    unique.candidates(p, name),\n    0,\n    true,\n    args,\n    [],\n    out,\n  )\n}"},{"name":"unique.scalar_value","kind":"fn","old":"e99a284def307ad4","new":"40335b5cfb78c3cf","interface_changed":true,"affected":["unique.lent","unique.ex","unique.call_flow","unique.mut_method","unique.local_call","unique.tail","unique.block_flow","unique.stmt_flow","unique.match_flow","unique.returns","unique.assign_flow","unique.loop_pass","unique.analyzed","unique.loop_flow","unique.proven_sites","codegen.generate","codegen_with","core_rt_text","computed_value","repl_eval","std_library","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","build_core_command","comptime_value","repl_command","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","literal_errors_of","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","strata_command","comptime_values","graph_command","graph_diff","loaded_check","file_errors","edit_file","edit_errors","search_invariants","build_proofs","verify_file","check_fn","command_line","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","main","with_base","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","codegen.read_back","eval_files"],"module":"unique","text":"/// Whether `e`'s value holds no part of any variable: a test, a\n/// comparison, or a call giving a number or a `Bool` (`len(v.d)`, or\n/// `size(v)` of a function declared to return one). Codegen gives a `mut`\n/// variable read by such an argument its own slot, so it stays held once.\nfn scalar_value(p: unique.Program, locals: Set[String], e: ast.Expr) -> Bool {\n  match e {\n    ast.Binary { op, .. } => unique.compares(op)\n      || op == ast.And\n      || op == ast.Or\n      || op == ast.Implies,\n    ast.Unary { op: ast.Not, .. } => true,\n    ast.IsExpr { .. } => true,\n    ast.Call { callee: ast.Var(n), .. } => {\n      ks := unique.candidates(p, n)\n      if contains(locals, n) {\n        false\n      } else if ks == [] {\n        unique.scalar_builtin(n)\n      } else {\n        ks.all(\n          k -> match get(p.fns, k) {\n            Some(f) => unique.scalar_type(f.ret),\n            None => false,\n          },\n        )\n      }\n    },\n    _ => false,\n  }\n}","old_text":"/// Whether `e`'s value holds no part of any variable: a test, a\n/// comparison, or a call giving a number or a `Bool` (`len(v.d)`, or\n/// `size(v)` of a function declared to return one). Codegen gives a `mut`\n/// variable read by such an argument its own slot, so it stays held once.\nfn scalar_value(p: unique.Program, e: ast.Expr) -> Bool {\n  match e {\n    ast.Binary { op, .. } => unique.compares(op)\n      || op == ast.And\n      || op == ast.Or\n      || op == ast.Implies,\n    ast.Unary { op: ast.Not, .. } => true,\n    ast.IsExpr { .. } => true,\n    ast.Call { callee: ast.Var(n), .. } => {\n      ks := unique.candidates(p, n)\n      if ks == [] {\n        unique.scalar_builtin(n)\n      } else {\n        ks.all(\n          k -> match get(p.fns, k) {\n            Some(f) => unique.scalar_type(f.ret),\n            None => false,\n          },\n        )\n      }\n    },\n    _ => false,\n  }\n}"},{"name":"unique.mut_method","kind":"fn","old":"8685c52297fe2171","new":"75c0782f9a343d72","interface_changed":false,"affected":[],"module":"unique","text":"/// `mut p.m(args)` (expression `e`). On a built-in list, dict or set it\n/// is `p = m(p, args)`, an update in place of `p`; on a method taking\n/// `mut self`, a call with a `mut` argument. The site is proven when `p`'s\n/// variable is held once after the arguments.\nfn mut_method(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  e: ast.Expr,\n  recv: ast.Expr,\n  name: String,\n  args: List[ast.Expr],\n  st: unique.St,\n) -> unique.St {\n  x := unique.root(recv)\n  (targets, known) := unique.method_targets(p, c, recv, name)\n  mut out := st\n  for a in args {\n    if !(a is ast.MutExpr) {\n      out = unique.ex(p, sum, mut c, a, out)\n    }\n  }\n  out = unique.lent(p, sum, mut c, targets, 1, known, args, [recv], out)\n  if x == \"\" {\n    return unique.ex(p, sum, mut c, recv, out)\n  }\n  h := unique.held(sum, c, out, x)\n  unique.site(mut c, unique.mut_key(c.key, e), h)\n  ts := targets.filter(k -> unique.mut_param(p, k, 0))\n  whole := recv is ast.Var\n  if c.record {\n    for k in ts {\n      mut c.calls.push((k, 0, h && whole))\n    }\n  }\n  if !whole {\n    // a field changed (by a built-in or a method) and put back: the\n    // record is then held once, changed in place or copied\n    return unique.set_var(out, x, true)\n  }\n  if ts == [] && !builtins.changing(name) {\n    return unique.spoil(out, x)\n  }\n  by_method := ts == [] || h && ts.all(k -> unique.exit_of(sum, k, 0))\n  kind := get(c.kinds, x) ?? \"\"\n  n := len(args)\n  by_builtin := if !builtins.changing(name) {\n    true\n  } else if kind == \"Dict\" && name == \"insert\" && n == 2 {\n    // a dict's insert makes a table of its own when it copies\n    true\n  } else {\n    h\n      && (kind == \"List\"\n          && (name == \"push\" && n == 1 || name == \"pop\" && n == 0)\n        || (kind == \"Dict\" || kind == \"Set\")\n          && (name == \"insert\" || name == \"remove\"))\n  }\n  if !(by_method && by_builtin) {\n    return unique.spoil(out, x)\n  }\n  if h {\n    out\n  } else {\n    unique.set_var(out, x, true)\n  }\n}","old_text":"/// `mut p.m(args)` (expression `e`). On a built-in list, dict or set it\n/// is `p = m(p, args)`, an update in place of `p`; on a method taking\n/// `mut self`, a call with a `mut` argument. The site is proven when `p`'s\n/// variable is held once after the arguments.\nfn mut_method(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  e: ast.Expr,\n  recv: ast.Expr,\n  name: String,\n  args: List[ast.Expr],\n  st: unique.St,\n) -> unique.St {\n  x := unique.root(recv)\n  mut out := st\n  for a in args {\n    if !(a is ast.MutExpr) {\n      out = unique.ex(p, sum, mut c, a, out)\n    }\n  }\n  out = unique.lent(\n    p,\n    sum,\n    mut c,\n    get(p.by_short, name) ?? [],\n    1,\n    false,\n    args,\n    [recv],\n    out,\n  )\n  if x == \"\" {\n    return unique.ex(p, sum, mut c, recv, out)\n  }\n  h := unique.held(sum, c, out, x)\n  unique.site(mut c, unique.mut_key(c.key, e), h)\n  ts := (get(p.by_short, name) ?? []).filter(\n    k -> unique.mut_param(p, k, 0),\n  )\n  whole := recv is ast.Var\n  if c.record {\n    for k in ts {\n      mut c.calls.push((k, 0, h && whole))\n    }\n  }\n  if !whole {\n    // a field changed (by a built-in or a method) and put back: the\n    // record is then held once, changed in place or copied\n    return unique.set_var(out, x, true)\n  }\n  if ts == [] && !builtins.changing(name) {\n    return unique.spoil(out, x)\n  }\n  by_method := ts == [] || h && ts.all(k -> unique.exit_of(sum, k, 0))\n  kind := get(c.kinds, x) ?? \"\"\n  n := len(args)\n  by_builtin := if !builtins.changing(name) {\n    true\n  } else if kind == \"Dict\" && name == \"insert\" && n == 2 {\n    // a dict's insert makes a table of its own when it copies\n    true\n  } else {\n    h\n      && (kind == \"List\"\n          && (name == \"push\" && n == 1 || name == \"pop\" && n == 0)\n        || (kind == \"Dict\" || kind == \"Set\")\n          && (name == \"insert\" || name == \"remove\"))\n  }\n  if !(by_method && by_builtin) {\n    return unique.spoil(out, x)\n  }\n  if h {\n    out\n  } else {\n    unique.set_var(out, x, true)\n  }\n}"},{"name":"unique.returns","kind":"fn","old":"318a14fa97f3cbfe","new":"96a56404edda5da6","interface_changed":false,"affected":[],"module":"unique","text":"/// A return of `e` at `st`, in a recording pass: whether it gives a fresh\n/// value, and which `mut` parameters are held once after it is worked out.\nfn returns(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  e: ast.Expr,\n  st: unique.St,\n) -> unique.St {\n  given := match e {\n    ast.Var(x) => contains(st.s, x)\n      && !contains(st.a, x)\n      && !c.params.any(q -> q.name == x),\n    _ => unique.fresh_value(p, sum, c.locals, e, c.ret),\n  }\n  after := unique.ex(p, sum, mut c, e, st)\n  if c.record && after.live {\n    c.fresh = c.fresh && given\n    c.exits = set(to_list(c.exits).filter(n -> contains(after.s, n)))\n  }\n  unique.dead()\n}","old_text":"/// A return of `e` at `st`, in a recording pass: whether it gives a fresh\n/// value, and which `mut` parameters are held once after it is worked out.\nfn returns(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  e: ast.Expr,\n  st: unique.St,\n) -> unique.St {\n  given := match e {\n    ast.Var(x) => contains(st.s, x)\n      && !contains(st.a, x)\n      && !c.params.any(q -> q.name == x),\n    _ => unique.fresh_value(p, sum, e, c.ret),\n  }\n  after := unique.ex(p, sum, mut c, e, st)\n  if c.record && after.live {\n    c.fresh = c.fresh && given\n    c.exits = set(to_list(c.exits).filter(n -> contains(after.s, n)))\n  }\n  unique.dead()\n}"},{"name":"unique.assign_flow","kind":"fn","old":"7a64cf4ba217fd6e","new":"a4e018387dfd5ca3","interface_changed":false,"affected":[],"module":"unique","text":"/// `place = value`.\n/// - `x = op(x, args)` with `op` an update in place (`in_place_op`): the\n/// site is proven when `x` is held once after the arguments (which may\n/// read it). Afterwards `x` is held once when it was (and always after a\n/// dict's `insert`, whose copy is a table of its own).\n/// - `x = e`: `x` is held once when `e` is a fresh value.\n/// - `x.a.b = e`: the site is proven when `x` is held once after `e`.\n/// Afterwards `x` is held once either way: it was changed in place, or a\n/// new copy was made.\nfn assign_flow(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  place: ast.Expr,\n  value: ast.Expr,\n  st: unique.St,\n) -> unique.St {\n  match place {\n    ast.Var(x) => {\n      (op, rest) := match value {\n        ast.Call { callee: ast.Var(n), args: [ast.Var(y), ..more] } => if y == x\n          && unique.in_place_op(n)\n          && (ast.is_core_ref(n)\n            || !contains(p.fns, n) && !contains(c.locals, n)) {\n          (ast.core_named(n), more)\n        } else {\n          (\"\", [])\n        },\n        _ => (\"\", []),\n      }\n      if op == \"\" {\n        f := unique.fresh_value(\n          p,\n          sum,\n          c.locals,\n          value,\n          get(c.kinds, x) ?? \"\",\n        )\n        return unique.set_var(unique.ex(p, sum, mut c, value, st), x, f)\n      }\n      mut out := st\n      for a in rest {\n        out = unique.ex(p, sum, mut c, a, out)\n      }\n      h := unique.held(sum, c, out, x)\n      unique.site(mut c, unique.site_key(c.key, place, value), h)\n      kind := get(c.kinds, x) ?? \"\"\n      if op == \"insert\" && kind == \"Dict\" && !h {\n        return unique.set_var(out, x, true)\n      }\n      ok := h\n        && match op {\n          \"insert\" | \"remove\" => kind == \"Dict\" || kind == \"Set\",\n          \"push\" | \"take\" | \"set_at\" | \"grow\" => kind == \"List\",\n          _ => false,\n        }\n      if ok {\n        out\n      } else {\n        unique.spoil(out, x)\n      }\n    },\n    _ => {\n      x := unique.root(place)\n      if x == \"\" {\n        return unique.ex(\n          p,\n          sum,\n          mut c,\n          value,\n          unique.ex(p, sum, mut c, place, st),\n        )\n      }\n      out := unique.ex(p, sum, mut c, value, st)\n      unique.site(\n        mut c,\n        unique.site_key(c.key, place, value),\n        unique.held(sum, c, out, x),\n      )\n      unique.set_var(out, x, true)\n    },\n  }\n}","old_text":"/// `place = value`.\n/// - `x = op(x, args)` with `op` an update in place (`in_place_op`): the\n/// site is proven when `x` is held once after the arguments (which may\n/// read it). Afterwards `x` is held once when it was (and always after a\n/// dict's `insert`, whose copy is a table of its own).\n/// - `x = e`: `x` is held once when `e` is a fresh value.\n/// - `x.a.b = e`: the site is proven when `x` is held once after `e`.\n/// Afterwards `x` is held once either way: it was changed in place, or a\n/// new copy was made.\nfn assign_flow(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  place: ast.Expr,\n  value: ast.Expr,\n  st: unique.St,\n) -> unique.St {\n  match place {\n    ast.Var(x) => {\n      (op, rest) := match value {\n        ast.Call { callee: ast.Var(n), args: [ast.Var(y), ..more] } => if y == x\n          && unique.in_place_op(n)\n          && (ast.is_core_ref(n)\n            || !contains(p.fns, n) && !contains(c.kinds, n)) {\n          (ast.core_named(n), more)\n        } else {\n          (\"\", [])\n        },\n        _ => (\"\", []),\n      }\n      if op == \"\" {\n        f := unique.fresh_value(p, sum, value, get(c.kinds, x) ?? \"\")\n        return unique.set_var(unique.ex(p, sum, mut c, value, st), x, f)\n      }\n      mut out := st\n      for a in rest {\n        out = unique.ex(p, sum, mut c, a, out)\n      }\n      h := unique.held(sum, c, out, x)\n      unique.site(mut c, unique.site_key(c.key, place, value), h)\n      kind := get(c.kinds, x) ?? \"\"\n      if op == \"insert\" && kind == \"Dict\" && !h {\n        return unique.set_var(out, x, true)\n      }\n      ok := h\n        && match op {\n          \"insert\" | \"remove\" => kind == \"Dict\" || kind == \"Set\",\n          \"push\" | \"take\" | \"set_at\" | \"grow\" => kind == \"List\",\n          _ => false,\n        }\n      if ok {\n        out\n      } else {\n        unique.spoil(out, x)\n      }\n    },\n    _ => {\n      x := unique.root(place)\n      if x == \"\" {\n        return unique.ex(\n          p,\n          sum,\n          mut c,\n          value,\n          unique.ex(p, sum, mut c, place, st),\n        )\n      }\n      out := unique.ex(p, sum, mut c, value, st)\n      unique.site(\n        mut c,\n        unique.site_key(c.key, place, value),\n        unique.held(sum, c, out, x),\n      )\n      unique.set_var(out, x, true)\n    },\n  }\n}"},{"name":"unique.lent","kind":"fn","old":"9ef7a2244e922b07","new":"a225e6e83001d20f","interface_changed":false,"affected":[],"module":"unique","text":"/// The `mut` arguments of a call, from `st`: `args[i]` goes to parameter\n/// `first + i` of each function in `targets`, `recv` are the call's other\n/// operands (a method's receiver). A `mut` variable stays held once when it\n/// was, no operand in `recv` mentions it, every other argument that reads\n/// it gives a value holding none of it (`scalar_value`, worked out before\n/// the call takes the variable), `known` says `targets` are all the\n/// functions the call may run, and each gives it back held once (`exit`).\n/// A field passed `mut` is put back after the call, so its record is then\n/// held once. Each target taking the argument `mut` is recorded for\n/// `entry`.\nfn lent(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  targets: List[String],\n  first: Int,\n  known: Bool,\n  args: List[ast.Expr],\n  recv: List[ast.Expr],\n  st: unique.St,\n) -> unique.St {\n  mut out := st\n  for (i, a) in enumerate(args) {\n    match a {\n      ast.MutExpr(m) => {\n        j := first + i\n        x := match m {\n          ast.Var(v) => v,\n          _ => \"\",\n        }\n        others := x == \"\"\n          || recv.any(o -> unique.mentions(o, x))\n          || enumerate(args).any(\n            o -> o.0 != i\n              && unique.mentions(o.1, x)\n              && (o.1 is ast.MutExpr\n                || !unique.scalar_value(p, c.locals, o.1)),\n          )\n        h := !others && unique.held(sum, c, out, x)\n        ts := targets.filter(k -> unique.mut_param(p, k, j))\n        if c.record {\n          for k in ts {\n            mut c.calls.push((k, j, h))\n          }\n        }\n        if x == \"\" {\n          // a field lent and put back: the record is then held once,\n          // changed in place or copied\n          out = unique.ex(p, sum, mut c, m, out)\n          out = if unique.root(m) == \"\" {\n            out\n          } else {\n            unique.set_var(out, unique.root(m), true)\n          }\n        } else if !(known\n          && h\n          && ts != []\n          && ts.all(k -> unique.exit_of(sum, k, j))) {\n          out = unique.spoil(out, x)\n        }\n      },\n      _ => (),\n    }\n  }\n  out\n}","old_text":"/// The `mut` arguments of a call, from `st`: `args[i]` goes to parameter\n/// `first + i` of each function in `targets`, `recv` are the call's other\n/// operands (a method's receiver). A `mut` variable stays held once when it\n/// was, no operand in `recv` mentions it, every other argument that reads\n/// it gives a value holding none of it (`scalar_value`, worked out before\n/// the call takes the variable), `known` says `targets` are all the\n/// functions the call may run, and each gives it back held once (`exit`).\n/// A field passed `mut` is put back after the call, so its record is then\n/// held once. Each target taking the argument `mut` is recorded for\n/// `entry`.\nfn lent(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  targets: List[String],\n  first: Int,\n  known: Bool,\n  args: List[ast.Expr],\n  recv: List[ast.Expr],\n  st: unique.St,\n) -> unique.St {\n  mut out := st\n  for (i, a) in enumerate(args) {\n    match a {\n      ast.MutExpr(m) => {\n        j := first + i\n        x := match m {\n          ast.Var(v) => v,\n          _ => \"\",\n        }\n        others := x == \"\"\n          || recv.any(o -> unique.mentions(o, x))\n          || enumerate(args).any(\n            o -> o.0 != i\n              && unique.mentions(o.1, x)\n              && (o.1 is ast.MutExpr || !unique.scalar_value(p, o.1)),\n          )\n        h := !others && unique.held(sum, c, out, x)\n        ts := targets.filter(k -> unique.mut_param(p, k, j))\n        if c.record {\n          for k in ts {\n            mut c.calls.push((k, j, h))\n          }\n        }\n        if x == \"\" {\n          // a field lent and put back: the record is then held once,\n          // changed in place or copied\n          out = unique.ex(p, sum, mut c, m, out)\n          out = if unique.root(m) == \"\" {\n            out\n          } else {\n            unique.set_var(out, unique.root(m), true)\n          }\n        } else if !(known\n          && h\n          && ts != []\n          && ts.all(k -> unique.exit_of(sum, k, j))) {\n          out = unique.spoil(out, x)\n        }\n      },\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"unique.binders","kind":"fn","old":null,"new":"80f80d6c3fe06c9a","interface_changed":true,"affected":[],"module":"unique","text":"/// Each name `e` binds, at any depth, with the type it is written with\n/// (when a variable is): `x := e` and `mut x := e`, patterns' names, `for`\n/// variables, lambdas' parameters, a `match`'s `as` name and `select`\n/// arms' names.\npub fn binders(e: ast.Expr) -> List[(String, Option[ast.TypeExpr])] {\n  mut out := []\n  mut todo := [e]\n  while todo != [] {\n    x := get(todo, len(todo) - 1) ?? ast.UnitExpr\n    todo = todo[..len(todo) - 1]\n    match x {\n      ast.Block { stmts, .. } => {\n        for st in stmts {\n          match st {\n            ast.Let { pat: ast.Bind(n), ty, .. } => mut out.push((n, ty)),\n            ast.VarDecl { name, ty, .. } => mut out.push((name, ty)),\n            ast.Let { pat, .. } | ast.For { pat, .. } | ast.ComptimeFor { pat, .. } => {\n              out += unique.pattern_names(pat).map(n -> (n, None))\n            },\n            _ => (),\n          }\n        }\n      },\n      ast.Lambda { params, .. } => {\n        out += params.map(q -> (q.name, q.ty))\n      },\n      ast.MatchExpr { binding, arms, .. } => {\n        match binding {\n          Some(b) => mut out.push((b, None)),\n          None => (),\n        }\n        for a in arms {\n          out += unique.pattern_names(a.pat).map(n -> (n, None))\n        }\n      },\n      ast.Select(arms) | ast.Race(arms) => {\n        for a in arms {\n          match a.name {\n            Some(n) => mut out.push((n, None)),\n            None => (),\n          }\n        }\n      },\n      _ => (),\n    }\n    todo += walk.kids(x)\n  }\n  out\n}"},{"name":"unique.written_heads","kind":"fn","old":null,"new":"da9287e59d6724db","interface_changed":true,"affected":[],"module":"unique","text":"/// The named type each variable of `bound` has, when every binding of its\n/// name writes the same one and it is none of the type parameters `tps`.\nfn written_heads(\n  bound: List[(String, Option[ast.TypeExpr])],\n  tps: Set[String],\n) -> Dict[String, String] {\n  mut out := Dict[String, String] {}\n  mut mixed := Set[String] {}\n  for (n, t) in bound {\n    h := match t {\n      Some(x) => unique.named_head(x),\n      None => \"\",\n    }\n    if h == \"\" || contains(tps, h) || get(out, n) ?? h != h {\n      mut mixed.insert(n)\n    } else {\n      mut out.insert(n, h)\n    }\n  }\n  for n in mixed {\n    mut out.remove(n)\n  }\n  out\n}"},{"name":"unique.named_head","kind":"fn","old":null,"new":"26b88b17875d416d","interface_changed":true,"affected":[],"module":"unique","text":"/// The name of a named type (refined or not), else \"\".\nfn named_head(t: ast.TypeExpr) -> String {\n  match t {\n    ast.Named { name, .. } => name,\n    ast.Refined { base, .. } => unique.named_head(base),\n    _ => \"\",\n  }\n}"},{"name":"unique.method_targets","kind":"fn","old":null,"new":"b79b0dd35baf8b7b","interface_changed":true,"affected":[],"module":"unique","text":"/// The functions a call `recv.name(..)` may run, and whether they are all\n/// it may run. A variable of a written type runs the method its type\n/// resolves `name` to (`p.resolved`); a list, dict or set without one\n/// runs the program's function of that name or a built-in (none). Else\n/// every function of that short name, not known to be all.\nfn method_targets(\n  p: unique.Program,\n  c: unique.Ctx,\n  recv: ast.Expr,\n  name: String,\n) -> (List[String], Bool) {\n  x := match recv {\n    ast.Var(v) => v,\n    _ => \"\",\n  }\n  head := get(c.heads, x) ?? \"\"\n  match get(p.resolved, head + \".\" + name) {\n    Some(k) => ([k], true),\n    None => if head == \"List\" || head == \"Dict\" || head == \"Set\" {\n      (if contains(p.fns, name) {\n        [name]\n      } else {\n        []\n      }, true)\n    } else {\n      (get(p.by_short, name) ?? [], false)\n    },\n  }\n}"},{"name":"unique.local_call","kind":"fn","old":null,"new":"4fe9c2a53c203043","interface_changed":true,"affected":[],"module":"unique","text":"/// A call of a function value held by a variable: every argument may be\n/// kept, and every `mut` argument is lent to a function not known.\nfn local_call(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  args: List[ast.Expr],\n  st: unique.St,\n) -> unique.St {\n  mut out := st\n  for a in args {\n    if !(a is ast.MutExpr) {\n      out = unique.ex(p, sum, mut c, a, out)\n    }\n  }\n  unique.lent(p, sum, mut c, [], 0, false, args, [], out)\n}"}]}
{"id":"f8e35140feb7f359","time":1795828162,"message":"edit","changes":[{"name":"codegen.use unique","kind":"use","old":"aad98336fa8a42ae","new":"811e8b3e79b433ff","interface_changed":true,"affected":[],"module":"codegen","text":"from unique use proven_sites, site_key, mut_key, binders","old_text":"from unique use proven_sites, site_key, mut_key"},{"name":"codegen.kept_by","kind":"fn","old":"60b0aa3f5f1e4a2f","new":"ca93709b80486ce6","interface_changed":false,"affected":[],"module":"codegen","text":"// ---- escape analysis ----\n//\n// Functions borrow their arguments, so a value passed to a function is\n// still the caller's afterwards, unless the function keeps it: stores it\n// in its result, in another value, in a closure or a task, or passes it to\n// a function that keeps it.\n//\n// The analysis is syntactic and conservative. A variable escapes unless\n// every use is known to borrow: a field read (`p.x`), an `is` test, a\n// comparison, a `match` that binds no name to the whole value, or an\n// argument to a program function whose parameter is not kept.\n\n/// For each function, by key, whether it may keep each parameter. Computed\n/// as a fixed point that starts from nothing kept, so recursion alone keeps\n/// nothing. After a first pass over every function, only the callers of\n/// one that came to keep a parameter are looked at again: the same fixed\n/// point, without walking every body each round.\nfn kept_by(fns: Dict[String, ast.FnDecl]) -> Dict[String, List[Bool]] {\n  mut kept := Dict[String, List[Bool]] {}\n  // (the functions whose code calls each one)\n  mut callers := Dict[String, List[String]] {}\n  for (n, f) in items(fns) {\n    mut kept.insert(n, f.params.map(_ -> false))\n    mut called := Set[String] {}\n    for e in f.pre + f.post + [f.body] {\n      for c in codegen.calls_in(e) {\n        mut called.insert(c)\n      }\n    }\n    for c in called {\n      if contains(fns, c) {\n        mut callers.insert(c, (get(callers, c) ?? []) + [n])\n      }\n    }\n  }\n  // (the names each function binds, which its calls of them don't name the\n  // program's functions)\n  mut locals := Dict[String, Set[String]] {}\n  for (n, f) in items(fns) {\n    mut bound := f.params.map(p -> p.name)\n    for e in f.pre + f.post + [f.body] {\n      bound += unique.binders(e).map(b -> b.0)\n    }\n    mut locals.insert(n, set(bound))\n  }\n  mut todo := keys(fns)\n  while todo != [] {\n    mut next := Set[String] {}\n    for n in todo {\n      f := get(fns, n) ?? codegen.no_fn()\n      ks := get(kept, n) ?? []\n      mut now := []\n      mut grew := false\n      for (i, p) in enumerate(f.params) {\n        k := get(ks, i) ?? true\n        if !k\n          && (f.pre + f.post + [f.body]).any(\n            e ->\n              codegen.escapes(e, p.name, kept, get(locals, n) or {\n                Set[String] {}\n              }),\n          ) {\n          mut now.push(true)\n          grew = true\n        } else {\n          mut now.push(k)\n        }\n      }\n      if grew {\n        mut kept.insert(n, now)\n        for c in get(callers, n) ?? [] {\n          mut next.insert(c)\n        }\n      }\n    }\n    todo = to_list(next)\n  }\n  kept\n}","old_text":"// ---- escape analysis ----\n//\n// Functions borrow their arguments, so a value passed to a function is\n// still the caller's afterwards, unless the function keeps it: stores it\n// in its result, in another value, in a closure or a task, or passes it to\n// a function that keeps it.\n//\n// The analysis is syntactic and conservative. A variable escapes unless\n// every use is known to borrow: a field read (`p.x`), an `is` test, a\n// comparison, a `match` that binds no name to the whole value, or an\n// argument to a program function whose parameter is not kept.\n\n/// For each function, by key, whether it may keep each parameter. Computed\n/// as a fixed point that starts from nothing kept, so recursion alone keeps\n/// nothing. After a first pass over every function, only the callers of\n/// one that came to keep a parameter are looked at again: the same fixed\n/// point, without walking every body each round.\nfn kept_by(fns: Dict[String, ast.FnDecl]) -> Dict[String, List[Bool]] {\n  mut kept := Dict[String, List[Bool]] {}\n  // (the functions whose code calls each one)\n  mut callers := Dict[String, List[String]] {}\n  for (n, f) in items(fns) {\n    mut kept.insert(n, f.params.map(_ -> false))\n    mut called := Set[String] {}\n    for e in f.pre + f.post + [f.body] {\n      for c in codegen.calls_in(e) {\n        mut called.insert(c)\n      }\n    }\n    for c in called {\n      if contains(fns, c) {\n        mut callers.insert(c, (get(callers, c) ?? []) + [n])\n      }\n    }\n  }\n  mut todo := keys(fns)\n  while todo != [] {\n    mut next := Set[String] {}\n    for n in todo {\n      f := get(fns, n) ?? codegen.no_fn()\n      ks := get(kept, n) ?? []\n      mut now := []\n      mut grew := false\n      for (i, p) in enumerate(f.params) {\n        k := get(ks, i) ?? true\n        if !k\n          && (f.pre + f.post + [f.body]).any(\n            e -> codegen.escapes(e, p.name, kept),\n          ) {\n          mut now.push(true)\n          grew = true\n        } else {\n          mut now.push(k)\n        }\n      }\n      if grew {\n        mut kept.insert(n, now)\n        for c in get(callers, n) ?? [] {\n          mut next.insert(c)\n        }\n      }\n    }\n    todo = to_list(next)\n  }\n  kept\n}"},{"name":"codegen.escapes","kind":"fn","old":"ba64b60d4c775830","new":"79d60c113b141d01","interface_changed":true,"affected":["codegen.kept_by","codegen.stack_let","codegen.generate","codegen.keeps_of","codegen.block_expr","codegen_with","core_rt_text","computed_value","repl_eval","codegen.stack_arg","codegen.borrowed_arg","codegen.expr_node","codegen.expr_want_node","std_library","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","build_core_command","comptime_value","repl_command","codegen.call_fn_want","codegen.expr","codegen.expr_want","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","literal_errors_of","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","strata_command","comptime_values","codegen.call_fn","codegen.regex_matches","codegen.call_named","codegen.method_call","codegen.type_check","codegen.by_variant","codegen.clock_now","codegen.options","codegen.main_arg","codegen.construct_want","codegen.operands_want","codegen.with_it","codegen.as_type","codegen.mock_method","codegen.produce","codegen.converted","codegen.stmt_node","codegen.destructure","codegen.matches","codegen.set_in_place","codegen.update_in_place","codegen.take_in_place","codegen.push_in_place","codegen.grow_in_place","codegen.assigned_call","codegen.checked","codegen.compared","codegen.decreases_pass","codegen.loop_body","codegen.for_loop","codegen.for_list","codegen.try_want","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.expr_on_stack","codegen.decreases_call","codegen.binary","codegen.logic","codegen.tag_test","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.except_expr","codegen.interp","codegen.build_fn","codegen.call_entry","codegen.export_entry","codegen.check_requires","codegen.keep_olds","codegen.check_ensures","codegen.lambda_shown","codegen.declare","codegen.checked_update","codegen.appended","codegen.channel_new","codegen.dyn_call","codegen.builtin_call","codegen.wanted","codegen.list_literal_of","codegen.builtin_operator","codegen.match_got","codegen.scope_expr","codegen.list_get_or","codegen.or_else","codegen.fuzz_driver","codegen.function","graph_command","graph_diff","loaded_check","file_errors","edit_file","edit_errors","search_invariants","build_proofs","verify_file","check_fn","command_line","call_command","linked","expanded","comptime_runner","codegen.shown","codegen.show","codegen.dyn_wrapper","codegen.cmp_helper","codegen.collection_builtin","codegen.builtin","codegen.host","codegen.string_builtin","codegen.real_op","codegen.dyn_generic_call","codegen.union_call","codegen.format_spec","codegen.entry","codegen.construct","codegen.operands","codegen.check_type","codegen.holds_pred","codegen.tag_is","codegen.satisfies","codegen.equal","codegen.conversion","codegen.channel_op","codegen.compare_values","codegen.apply","codegen.vtable","codegen.mock_table","codegen.mock_call","codegen.gen_fn","codegen.table_find","codegen.list_builtin","codegen.stmt","codegen.binds","codegen.matching_v","codegen.invariants","codegen.assertion","codegen.try_expr","codegen.if_expr","codegen.matching","codegen.get_field","codegen.built_or_generated","codegen.lambda","codegen.function_value","codegen.list_literal","codegen.compiled_alone","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","main","with_base","codegen.fail_unless","codegen.debug_list","codegen.union_text","codegen.debug_fields","codegen.index_check","codegen.grow_size_check","codegen.decreases_fault","codegen.trace_enter","codegen.trace_leave","codegen.slot_fn","codegen.cmp_fields","codegen.union_cmp","codegen.order_closure","codegen.gen_list","codegen.session_capability","codegen.check_payload","codegen.assign_at","codegen.check_field","codegen.check_union","codegen.check_member","codegen.dyn_ctor_is","codegen.has_field_check","codegen.to_c","codegen.gen_data","codegen.eq_list","codegen.union_eq","codegen.eq_fields","codegen.number_builtin","codegen.held_apply","codegen.dyn_table_is","codegen.to_dyn","codegen.mock_value","codegen.generated","codegen.can_generate","codegen.decreases_start","codegen.iterate","codegen.decreases_entry","codegen.method_value","codegen.spawn_expr","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command","codegen.new_gen","eval.run","codegen.helper","codegen.debug_body","codegen.table_fns","codegen.hash_helper","codegen.session_entry","codegen.foreign_call","codegen.eq_body","codegen.generated_args","codegen.makers","codegen.read_back","eval_files","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// Whether variable `x` may escape `e`. A closure or a task mentioning\n/// `x` counts as escaping, and so does an argument of a call of one of\n/// `locals` (variables, which may hold any function).\nfn escapes(\n  e: ast.Expr,\n  x: String,\n  kept: Dict[String, List[Bool]],\n  locals: Set[String],\n) -> Bool {\n  match operators.lowered_node(e) {\n    ast.Var(v) => v == x,\n    // captured by a closure or a task: the capture may outlive the frame,\n    // or cross to another thread, which passes a count of 0 (a block on\n    // the stack) as it is, without crossing what the block holds\n    ast.Lambda { body, .. } => codegen.mentions_var(body, x),\n    ast.Spawn(b) | ast.SupervisedSpawn(b) => codegen.mentions_var(b, x),\n    // reads\n    ast.FieldOf { base: ast.Var(_), .. } => false,\n    ast.IsExpr { value: ast.Var(_), .. } => false,\n    ast.Binary { op, left, right } => if op == ast.And || op == ast.Or || op == ast.Implies {\n      codegen.escapes(left, x, kept, locals)\n        || codegen.escapes(right, x, kept, locals)\n    } else {\n      left != ast.Var(x) && codegen.escapes(left, x, kept, locals)\n        || right != ast.Var(x)\n          && codegen.escapes(right, x, kept, locals)\n    },\n    // an argument of a function that borrows it\n    ast.Call { callee: ast.Var(name), args } => {\n      for (i, a) in enumerate(args) {\n        if !(a == ast.Var(x)\n            && !contains(locals, name)\n            && !codegen.keeps_arg(kept, name, i))\n          && codegen.escapes(a, x, kept, locals) {\n          return true\n        }\n      }\n      false\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => if scrutinee == ast.Var(x) && sugar.handler_of(e) is None {\n      binding is Some\n        || arms.any(a -> codegen.binds_whole(a.pat))\n        || arms.any(\n          a -> walk.pattern_kids(a.pat).any(\n              p -> codegen.escapes(p, x, kept, locals),\n            )\n            || codegen.escapes(a.body, x, kept, locals),\n        )\n    } else {\n      walk.kids(e).any(k -> codegen.escapes(k, x, kept, locals))\n    },\n    _ => walk.kids(e).any(k -> codegen.escapes(k, x, kept, locals)),\n  }\n}","old_text":"/// Whether variable `x` may escape `e`. A closure or a task mentioning\n/// `x` counts as escaping.\nfn escapes(e: ast.Expr, x: String, kept: Dict[String, List[Bool]]) -> Bool {\n  match operators.lowered_node(e) {\n    ast.Var(v) => v == x,\n    // captured by a closure or a task: the capture may outlive the frame,\n    // or cross to another thread, which passes a count of 0 (a block on\n    // the stack) as it is, without crossing what the block holds\n    ast.Lambda { body, .. } => codegen.mentions_var(body, x),\n    ast.Spawn(b) | ast.SupervisedSpawn(b) => codegen.mentions_var(b, x),\n    // reads\n    ast.FieldOf { base: ast.Var(_), .. } => false,\n    ast.IsExpr { value: ast.Var(_), .. } => false,\n    ast.Binary { op, left, right } => if op == ast.And || op == ast.Or || op == ast.Implies {\n      codegen.escapes(left, x, kept)\n        || codegen.escapes(right, x, kept)\n    } else {\n      left != ast.Var(x) && codegen.escapes(left, x, kept)\n        || right != ast.Var(x) && codegen.escapes(right, x, kept)\n    },\n    // an argument of a function that borrows it\n    ast.Call { callee: ast.Var(name), args } => {\n      for (i, a) in enumerate(args) {\n        if !(a == ast.Var(x) && !codegen.keeps_arg(kept, name, i))\n          && codegen.escapes(a, x, kept) {\n          return true\n        }\n      }\n      false\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => if scrutinee == ast.Var(x) && sugar.handler_of(e) is None {\n      binding is Some\n        || arms.any(a -> codegen.binds_whole(a.pat))\n        || arms.any(\n          a -> walk.pattern_kids(a.pat).any(\n              p -> codegen.escapes(p, x, kept),\n            )\n            || codegen.escapes(a.body, x, kept),\n        )\n    } else {\n      walk.kids(e).any(k -> codegen.escapes(k, x, kept))\n    },\n    _ => walk.kids(e).any(k -> codegen.escapes(k, x, kept)),\n  }\n}"},{"name":"codegen.stack_let","kind":"fn","old":"f1a77c2ad02ea7b1","new":"73bb77fc86fd405a","interface_changed":false,"affected":[],"module":"codegen","text":"/// The variable `x` of `stmts[i]` when it is `x := C { … }` (a constructor\n/// with fields) or `x := f(…)` (a call of the program's function or\n/// method, of a type that is neither a trait nor a union) and `x` does not\n/// outlive the block (`escapes`): its value can go on the stack. Else \"\".\nfn stack_let(\n  mut g: codegen.Gen,\n  stmts: List[ast.Stmt],\n  i: Int,\n  last: ast.Expr,\n) -> String {\n  x := match get(stmts, i) {\n    Some(ast.Let { pat: ast.Bind(n), value: ast.CtorExpr { args, .. }, .. }) => if args is ast.NoArgs {\n      return \"\"\n    } else {\n      n\n    },\n    Some(ast.Let { pat: ast.Bind(n), ty, value }) => if (codegen.call_like(g, value) || codegen.real_arith(value))\n      && codegen.plain_want(mut g, ty) {\n      n\n    } else {\n      return \"\"\n    },\n    _ => return \"\",\n  }\n  ks := codegen.keeps_of(mut g)\n  rest := drop(stmts, i + 1)\n  after := fold(rest.map(s -> walk.stmt_kids(s)), [], (a, b) -> a + b)\n    + [last]\n  // (the names called after it that are variables: in scope, or bound\n  // after it)\n  bound := set(unique.binders(ast.Block { stmts: rest, last }).map(b -> b.0))\n  mut locals := Set[String] {}\n  for e in after {\n    for n in codegen.calls_in(e) {\n      if contains(bound, n) || codegen.lookup(g, n) is Some {\n        mut locals.insert(n)\n      }\n    }\n  }\n  if after.any(e -> codegen.escapes(e, x, ks, locals)) {\n    \"\"\n  } else {\n    x\n  }\n}","old_text":"/// The variable `x` of `stmts[i]` when it is `x := C { … }` (a constructor\n/// with fields) or `x := f(…)` (a call of the program's function or\n/// method, of a type that is neither a trait nor a union) and `x` does not\n/// outlive the block (`escapes`): its value can go on the stack. Else \"\".\nfn stack_let(\n  mut g: codegen.Gen,\n  stmts: List[ast.Stmt],\n  i: Int,\n  last: ast.Expr,\n) -> String {\n  x := match get(stmts, i) {\n    Some(ast.Let { pat: ast.Bind(n), value: ast.CtorExpr { args, .. }, .. }) => if args is ast.NoArgs {\n      return \"\"\n    } else {\n      n\n    },\n    Some(ast.Let { pat: ast.Bind(n), ty, value }) => if (codegen.call_like(g, value) || codegen.real_arith(value))\n      && codegen.plain_want(mut g, ty) {\n      n\n    } else {\n      return \"\"\n    },\n    _ => return \"\",\n  }\n  ks := codegen.keeps_of(mut g)\n  rest := drop(stmts, i + 1)\n  if rest.any(\n      s -> walk.stmt_kids(s).any(e -> codegen.escapes(e, x, ks)),\n    )\n    || codegen.escapes(last, x, ks) {\n    \"\"\n  } else {\n    x\n  }\n}"}]}
{"id":"7916fe1e3af1ef9d","time":1795829126,"message":"edit","changes":[{"name":"unique.Program","kind":"type","old":"de5a76be85107438","new":"393e727f488bc779","interface_changed":true,"affected":["unique.proven_sites","unique.unknown_callers","unique.analyzed","unique.tail","unique.block_flow","unique.stmt_flow","unique.fresh_value","unique.ex","unique.call_flow","unique.borrows","unique.keeps","unique.candidates","unique.scalar_value","unique.mut_param","unique.mut_method","unique.match_flow","unique.returns","unique.assign_flow","unique.loop_flow","unique.loop_pass","unique.lent","unique.method_targets","unique.local_call","codegen.generate","codegen_with","core_rt_text","computed_value","repl_eval","std_library","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","build_core_command","comptime_value","repl_command","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","literal_errors_of","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","strata_command","comptime_values","graph_command","graph_diff","loaded_check","file_errors","edit_file","edit_errors","search_invariants","build_proofs","verify_file","check_fn","command_line","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","main","with_base","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","codegen.read_back","eval_files"],"module":"unique","text":"/// The program as the analysis reads it: its functions by key, which\n/// parameters each may keep (codegen's `kept_by`), the keys by short name,\n/// the `distinct` types, the names of the traits' methods, and the function\n/// each method call resolves to by its receiver's type\n/// (`TYPE.method` -> key), and the keys of the `impl`s' methods (`impls`).\ntype Program = {\n  fns: Dict[String, ast.FnDecl],\n  kept: Dict[String, List[Bool]],\n  by_short: Dict[String, List[String]],\n  distinct: Set[String],\n  methods: Set[String],\n  resolved: Dict[String, String],\n  impls: Set[String],\n}","old_text":"/// The program as the analysis reads it: its functions by key, which\n/// parameters each may keep (codegen's `kept_by`), the keys by short name,\n/// the `distinct` types, the names of the traits' methods, and the function\n/// each method call resolves to by its receiver's type\n/// (`TYPE.method` -> key).\ntype Program = {\n  fns: Dict[String, ast.FnDecl],\n  kept: Dict[String, List[Bool]],\n  by_short: Dict[String, List[String]],\n  distinct: Set[String],\n  methods: Set[String],\n  resolved: Dict[String, String],\n}"},{"name":"unique.proven_sites","kind":"fn","old":"568650cbc8c5c30d","new":"1a7c61a92483b0b9","interface_changed":false,"affected":[],"module":"unique","text":"/// The updates in place proven to find their value held once, by\n/// `site_key` and `mut_key`. A site is proven when every place it occurs at\n/// is. `closed` says every call of the program's functions is in `fns` (a\n/// program's build): else no `mut` parameter is assumed held once at entry.\n/// `resolved` gives the method a call `x.m(..)` runs for `x`'s type\n/// (`TYPE.m` -> key); `methods` are the keys of the `impl`s' methods.\n/// The summaries are a greatest fixed point: each starts true and is made\n/// false where a function's body breaks it, until nothing changes. The\n/// first round analyzes every function; each later one only those whose\n/// analysis reads a summary the round before changed (`names_in`), which\n/// gives the same fixed point as analyzing all each round. Cost: one pass\n/// over every function (on worker threads), then over the few whose\n/// inputs changed, per round;\n/// each loop is walked until its state stops shrinking.\npub fn proven_sites(\n  fns: Dict[String, ast.FnDecl],\n  kept: Dict[String, List[Bool]],\n  closed: Bool,\n  distinct: Set[String],\n  traits: Dict[String, ast.TraitDecl],\n  resolved: Dict[String, String],\n  methods: Set[String],\n) -> Set[String] {\n  mut by_short := Dict[String, List[String]] {}\n  for k in keys(fns) {\n    n := unique.short(k)\n    mut by_short.insert(n, (get(by_short, n) ?? []) + [k])\n  }\n  mut names := Set[String] {}\n  for t in values(traits) {\n    for m in t.methods {\n      mut names.insert(m.decl.name)\n    }\n  }\n  p := unique.Program {\n    fns,\n    kept,\n    by_short,\n    distinct,\n    methods: names,\n    resolved,\n    impls: methods,\n  }\n  // (an `impl`'s method may also be called as a value, `T.m`)\n  mut unknown := unique.unknown_callers(p, closed, traits)\n  for k in methods {\n    mut unknown.insert(k)\n  }\n  mut sum := unique.Summary {\n    fresh: Dict[String, Bool] {},\n    entry: Dict[String, List[Bool]] {},\n    exit: Dict[String, List[Bool]] {},\n  }\n  for (k, f) in items(fns) {\n    mut sum.fresh.insert(k, true)\n    mut sum.entry.insert(\n      k,\n      f.params.map(x -> x.mutable && !contains(unknown, k)),\n    )\n    mut sum.exit.insert(k, f.params.map(x -> x.mutable))\n  }\n  // (whose analyses read each function's summaries: its own, and those of\n  // the functions of each short name its body calls)\n  mut users := Dict[String, List[String]] {}\n  for (k, f) in items(fns) {\n    mut reads := Set[String] { k }\n    for n in unique.names_in(f.body) {\n      for x in get(by_short, n) ?? [] {\n        mut reads.insert(x)\n      }\n    }\n    for x in reads {\n      mut users.insert(x, (get(users, x) ?? []) + [k])\n    }\n  }\n  mut ctxs := Dict[String, unique.Ctx] {}\n  mut dirty := keys(fns)\n  while dirty != [] {\n    mut fresh := sum.fresh\n    mut exit := sum.exit\n    mut entry := sum.entry\n    mut changed := Set[String] {}\n    // (each analysis only reads: on worker threads, each in its own arena,\n    // in order)\n    done := parallel.map_parallel(dirty, k -> std.memory.arena(\n      () ->\n        unique.analyzed(p, sum, k, get(fns, k) ?? unique.no_fn()),\n    ))\n    for (j, k) in enumerate(dirty) {\n      f := get(fns, k) ?? unique.no_fn()\n      c := get(done, j) ?? unique.analyzed(p, sum, k, f)\n      now := get(sum.fresh, k) ?? false && c.fresh\n      if now != get(sum.fresh, k) ?? false {\n        mut fresh.insert(k, now)\n        mut changed.insert(k)\n      }\n      was := get(sum.exit, k) ?? []\n      ex_now := enumerate(f.params).map(\n        x -> get(was, x.0) ?? false && contains(c.exits, x.1.name),\n      )\n      if ex_now != was {\n        mut exit.insert(k, ex_now)\n        mut changed.insert(k)\n      }\n      unique.entry_lowered(mut entry, c.calls, mut changed)\n      mut ctxs.insert(k, c)\n    }\n    sum = unique.Summary { fresh, entry, exit }\n    mut next := Set[String] {}\n    for k in changed {\n      for u in get(users, k) ?? [] {\n        mut next.insert(u)\n      }\n    }\n    dirty = to_list(next)\n  }\n  mut sites := Dict[String, Bool] {}\n  for c in values(ctxs) {\n    for (s, v) in items(c.sites) {\n      mut sites.insert(s, get(sites, s) ?? true && v)\n    }\n  }\n  set(items(sites).filter(x -> x.1).map(x -> x.0))\n}","old_text":"/// The updates in place proven to find their value held once, by\n/// `site_key` and `mut_key`. A site is proven when every place it occurs at\n/// is. `closed` says every call of the program's functions is in `fns` (a\n/// program's build): else no `mut` parameter is assumed held once at entry.\n/// `resolved` gives the method a call `x.m(..)` runs for `x`'s type\n/// (`TYPE.m` -> key); `methods` are the keys of the `impl`s' methods.\n/// The summaries are a greatest fixed point: each starts true and is made\n/// false where a function's body breaks it, until nothing changes. The\n/// first round analyzes every function; each later one only those whose\n/// analysis reads a summary the round before changed (`names_in`), which\n/// gives the same fixed point as analyzing all each round. Cost: one pass\n/// over every function (on worker threads), then over the few whose\n/// inputs changed, per round;\n/// each loop is walked until its state stops shrinking.\npub fn proven_sites(\n  fns: Dict[String, ast.FnDecl],\n  kept: Dict[String, List[Bool]],\n  closed: Bool,\n  distinct: Set[String],\n  traits: Dict[String, ast.TraitDecl],\n  resolved: Dict[String, String],\n  methods: Set[String],\n) -> Set[String] {\n  mut by_short := Dict[String, List[String]] {}\n  for k in keys(fns) {\n    n := unique.short(k)\n    mut by_short.insert(n, (get(by_short, n) ?? []) + [k])\n  }\n  mut names := Set[String] {}\n  for t in values(traits) {\n    for m in t.methods {\n      mut names.insert(m.decl.name)\n    }\n  }\n  p := unique.Program {\n    fns,\n    kept,\n    by_short,\n    distinct,\n    methods: names,\n    resolved,\n  }\n  // (an `impl`'s method may also be called as a value, `T.m`)\n  mut unknown := unique.unknown_callers(p, closed, traits)\n  for k in methods {\n    mut unknown.insert(k)\n  }\n  mut sum := unique.Summary {\n    fresh: Dict[String, Bool] {},\n    entry: Dict[String, List[Bool]] {},\n    exit: Dict[String, List[Bool]] {},\n  }\n  for (k, f) in items(fns) {\n    mut sum.fresh.insert(k, true)\n    mut sum.entry.insert(\n      k,\n      f.params.map(x -> x.mutable && !contains(unknown, k)),\n    )\n    mut sum.exit.insert(k, f.params.map(x -> x.mutable))\n  }\n  // (whose analyses read each function's summaries: its own, and those of\n  // the functions of each short name its body calls)\n  mut users := Dict[String, List[String]] {}\n  for (k, f) in items(fns) {\n    mut reads := Set[String] { k }\n    for n in unique.names_in(f.body) {\n      for x in get(by_short, n) ?? [] {\n        mut reads.insert(x)\n      }\n    }\n    for x in reads {\n      mut users.insert(x, (get(users, x) ?? []) + [k])\n    }\n  }\n  mut ctxs := Dict[String, unique.Ctx] {}\n  mut dirty := keys(fns)\n  while dirty != [] {\n    mut fresh := sum.fresh\n    mut exit := sum.exit\n    mut entry := sum.entry\n    mut changed := Set[String] {}\n    // (each analysis only reads: on worker threads, each in its own arena,\n    // in order)\n    done := parallel.map_parallel(dirty, k -> std.memory.arena(\n      () ->\n        unique.analyzed(p, sum, k, get(fns, k) ?? unique.no_fn()),\n    ))\n    for (j, k) in enumerate(dirty) {\n      f := get(fns, k) ?? unique.no_fn()\n      c := get(done, j) ?? unique.analyzed(p, sum, k, f)\n      now := get(sum.fresh, k) ?? false && c.fresh\n      if now != get(sum.fresh, k) ?? false {\n        mut fresh.insert(k, now)\n        mut changed.insert(k)\n      }\n      was := get(sum.exit, k) ?? []\n      ex_now := enumerate(f.params).map(\n        x -> get(was, x.0) ?? false && contains(c.exits, x.1.name),\n      )\n      if ex_now != was {\n        mut exit.insert(k, ex_now)\n        mut changed.insert(k)\n      }\n      unique.entry_lowered(mut entry, c.calls, mut changed)\n      mut ctxs.insert(k, c)\n    }\n    sum = unique.Summary { fresh, entry, exit }\n    mut next := Set[String] {}\n    for k in changed {\n      for u in get(users, k) ?? [] {\n        mut next.insert(u)\n      }\n    }\n    dirty = to_list(next)\n  }\n  mut sites := Dict[String, Bool] {}\n  for c in values(ctxs) {\n    for (s, v) in items(c.sites) {\n      mut sites.insert(s, get(sites, s) ?? true && v)\n    }\n  }\n  set(items(sites).filter(x -> x.1).map(x -> x.0))\n}"},{"name":"unique.candidates","kind":"fn","old":"fb755a901830373d","new":"dc88f68e97c5f5a9","interface_changed":false,"affected":[],"module":"unique","text":"/// The functions a call of `name` may run: the function of that key, unless\n/// a trait has a method of its short name; else the functions of that\n/// short name, and its methods when a trait has a method of that name.\nfn candidates(p: unique.Program, name: String) -> List[String] {\n  n := unique.short(name)\n  if contains(p.fns, name) && !contains(p.methods, n) {\n    [name]\n  } else {\n    (get(p.by_short, n) ?? []).filter(\n      k -> contains(p.methods, n) || !contains(p.impls, k),\n    )\n  }\n}","old_text":"/// The functions a call of `name` may run: the function of that key, unless\n/// a trait has a method of its short name; else the functions and methods\n/// of that short name.\nfn candidates(p: unique.Program, name: String) -> List[String] {\n  if contains(p.fns, name) && !contains(p.methods, unique.short(name)) {\n    [name]\n  } else {\n    get(p.by_short, unique.short(name)) ?? []\n  }\n}"}]}
{"id":"f0a21f08229dfdbd","time":1795829378,"message":"edit","changes":[{"name":"unique.call_flow","kind":"fn","old":"ebffd5b8ccd225b0","new":"c9c4ae2117736364","interface_changed":false,"affected":[],"module":"unique","text":"/// `name(args)`: the arguments worked out in order, those not `mut` first,\n/// then the `mut` ones (`lent`). A variable passed to a parameter the\n/// callee doesn't keep is only borrowed, when no later argument mentions\n/// it. A `mut` argument stays held once only when `name` is a function of\n/// the program, the only one the call may run. A call of a variable\n/// (`local_call`) runs no function the program names.\nfn call_flow(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  name: String,\n  args: List[ast.Expr],\n  st: unique.St,\n) -> unique.St {\n  if contains(c.locals, name) {\n    return unique.local_call(p, sum, mut c, args, st)\n  }\n  mut out := st\n  for (i, a) in enumerate(args) {\n    match a {\n      ast.MutExpr(_) => (),\n      // borrowed, unless a later argument mentions it: the call holds the\n      // value while those are worked out\n      ast.Var(x) => if !unique.borrows(p, c, name, args, i)\n        || drop(args, i + 1).any(o -> unique.mentions(o, x)) {\n        out = unique.spoil(out, x)\n      },\n      _ => {\n        out = unique.ex(p, sum, mut c, a, out)\n      },\n    }\n  }\n  known := contains(p.fns, name) && !contains(p.methods, unique.short(name))\n  unique.lent(\n    p,\n    sum,\n    mut c,\n    unique.candidates(p, c, name, args),\n    0,\n    known,\n    args,\n    [],\n    out,\n  )\n}","old_text":"/// `name(args)`: the arguments worked out in order, those not `mut` first,\n/// then the `mut` ones (`lent`). A variable passed to a parameter the\n/// callee doesn't keep is only borrowed, when no later argument mentions\n/// it. A `mut` argument stays held once only when `name` is a function of\n/// the program, the only one the call may run. A call of a variable\n/// (`local_call`) runs no function the program names.\nfn call_flow(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  name: String,\n  args: List[ast.Expr],\n  st: unique.St,\n) -> unique.St {\n  if contains(c.locals, name) {\n    return unique.local_call(p, sum, mut c, args, st)\n  }\n  mut out := st\n  for (i, a) in enumerate(args) {\n    match a {\n      ast.MutExpr(_) => (),\n      // borrowed, unless a later argument mentions it: the call holds the\n      // value while those are worked out\n      ast.Var(x) => if !unique.borrows(p, name, i)\n        || drop(args, i + 1).any(o -> unique.mentions(o, x)) {\n        out = unique.spoil(out, x)\n      },\n      _ => {\n        out = unique.ex(p, sum, mut c, a, out)\n      },\n    }\n  }\n  known := contains(p.fns, name) && !contains(p.methods, unique.short(name))\n  unique.lent(\n    p,\n    sum,\n    mut c,\n    unique.candidates(p, name),\n    0,\n    known,\n    args,\n    [],\n    out,\n  )\n}"},{"name":"unique.borrows","kind":"fn","old":"afad385ae4db0ce0","new":"b40631fb45d28f40","interface_changed":true,"affected":["unique.call_flow","unique.ex","unique.tail","unique.block_flow","unique.stmt_flow","unique.mut_method","unique.match_flow","unique.returns","unique.assign_flow","unique.loop_pass","unique.lent","unique.local_call","unique.analyzed","unique.loop_flow","unique.proven_sites","codegen.generate","codegen_with","core_rt_text","computed_value","repl_eval","std_library","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","build_core_command","comptime_value","repl_command","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","literal_errors_of","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","strata_command","comptime_values","graph_command","graph_diff","loaded_check","file_errors","edit_file","edit_errors","search_invariants","build_proofs","verify_file","check_fn","command_line","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","main","with_base","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","codegen.read_back","eval_files"],"module":"unique","text":"/// Whether calling `name` borrows its argument `i` without keeping it.\nfn borrows(\n  p: unique.Program,\n  c: unique.Ctx,\n  name: String,\n  args: List[ast.Expr],\n  i: Int,\n) -> Bool {\n  if contains(p.fns, name) && !contains(p.methods, unique.short(name)) {\n    return !unique.keeps(p, name, i)\n  }\n  unique.reads_only(unique.short(name))\n    && unique.candidates(p, c, name, args).all(\n      k -> !unique.keeps(p, k, i),\n    )\n}","old_text":"/// Whether calling `name` borrows its argument `i` without keeping it.\nfn borrows(p: unique.Program, name: String, i: Int) -> Bool {\n  if contains(p.fns, name) && !contains(p.methods, unique.short(name)) {\n    return !unique.keeps(p, name, i)\n  }\n  unique.reads_only(unique.short(name))\n    && unique.candidates(p, name).all(k -> !unique.keeps(p, k, i))\n}"},{"name":"unique.candidates","kind":"fn","old":"dc88f68e97c5f5a9","new":"224dc6664f4e02d8","interface_changed":true,"affected":["unique.call_flow","unique.borrows","unique.scalar_value","unique.ex","unique.lent","unique.tail","unique.block_flow","unique.stmt_flow","unique.mut_method","unique.match_flow","unique.returns","unique.assign_flow","unique.loop_pass","unique.local_call","unique.analyzed","unique.loop_flow","unique.proven_sites","codegen.generate","codegen_with","core_rt_text","computed_value","repl_eval","std_library","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","build_core_command","comptime_value","repl_command","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","literal_errors_of","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","strata_command","comptime_values","graph_command","graph_diff","loaded_check","file_errors","edit_file","edit_errors","search_invariants","build_proofs","verify_file","check_fn","command_line","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","main","with_base","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","codegen.read_back","eval_files"],"module":"unique","text":"/// The functions a call `name(args)` may run: the function of that key,\n/// unless a trait has a method of its short name. Else a built-in, which\n/// on a value of a program type runs that type's method of the name, so\n/// the functions of that short name: of the `impl`s' methods, only the one\n/// the first argument's written type resolves it to, and none for a\n/// built-in type's value.\nfn candidates(\n  p: unique.Program,\n  c: unique.Ctx,\n  name: String,\n  args: List[ast.Expr],\n) -> List[String] {\n  n := unique.short(name)\n  if contains(p.fns, name) && !contains(p.methods, n) {\n    return [name]\n  }\n  all := get(p.by_short, n) ?? []\n  head := match get(args, 0) {\n    Some(ast.Var(x)) | Some(ast.MutExpr(ast.Var(x))) => get(c.heads, x) ?? \"\",\n    _ => \"\",\n  }\n  match get(p.resolved, head + \".\" + n) {\n    Some(k) => all.filter(x -> x == k || !contains(p.impls, x)),\n    None => if [\n      \"List\",\n      \"Dict\",\n      \"Set\",\n      \"Option\",\n      \"Result\",\n      \"Int\",\n      \"Float\",\n      \"Bool\",\n      \"String\",\n    ].contains(\n      head,\n    ) {\n      all.filter(x -> !contains(p.impls, x))\n    } else {\n      all\n    },\n  }\n}","old_text":"/// The functions a call of `name` may run: the function of that key, unless\n/// a trait has a method of its short name; else the functions of that\n/// short name, and its methods when a trait has a method of that name.\nfn candidates(p: unique.Program, name: String) -> List[String] {\n  n := unique.short(name)\n  if contains(p.fns, name) && !contains(p.methods, n) {\n    [name]\n  } else {\n    (get(p.by_short, n) ?? []).filter(\n      k -> contains(p.methods, n) || !contains(p.impls, k),\n    )\n  }\n}"},{"name":"unique.scalar_value","kind":"fn","old":"40335b5cfb78c3cf","new":"cf02a1513fc4c6c0","interface_changed":true,"affected":["unique.lent","unique.ex","unique.call_flow","unique.mut_method","unique.local_call","unique.tail","unique.block_flow","unique.stmt_flow","unique.match_flow","unique.returns","unique.assign_flow","unique.loop_pass","unique.analyzed","unique.loop_flow","unique.proven_sites","codegen.generate","codegen_with","core_rt_text","computed_value","repl_eval","std_library","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","build_core_command","comptime_value","repl_command","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","literal_errors_of","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","strata_command","comptime_values","graph_command","graph_diff","loaded_check","file_errors","edit_file","edit_errors","search_invariants","build_proofs","verify_file","check_fn","command_line","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","main","with_base","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","codegen.read_back","eval_files"],"module":"unique","text":"/// Whether `e`'s value holds no part of any variable: a test, a\n/// comparison, or a call giving a number or a `Bool` (`len(v.d)`, or\n/// `size(v)` of a function declared to return one). Codegen gives a `mut`\n/// variable read by such an argument its own slot, so it stays held once.\nfn scalar_value(p: unique.Program, c: unique.Ctx, e: ast.Expr) -> Bool {\n  match e {\n    ast.Binary { op, .. } => unique.compares(op)\n      || op == ast.And\n      || op == ast.Or\n      || op == ast.Implies,\n    ast.Unary { op: ast.Not, .. } => true,\n    ast.IsExpr { .. } => true,\n    ast.Call { callee: ast.Var(n), args } => if contains(c.locals, n) {\n      false\n    } else {\n      ks := unique.candidates(p, c, n, args)\n      ret_scalar := ks.all(\n        k -> match get(p.fns, k) {\n          Some(f) => unique.scalar_type(f.ret),\n          None => false,\n        },\n      )\n      if ks == [n] {\n        ret_scalar\n      } else {\n        ret_scalar && unique.scalar_builtin(unique.short(n))\n      }\n    },\n    _ => false,\n  }\n}","old_text":"/// Whether `e`'s value holds no part of any variable: a test, a\n/// comparison, or a call giving a number or a `Bool` (`len(v.d)`, or\n/// `size(v)` of a function declared to return one). Codegen gives a `mut`\n/// variable read by such an argument its own slot, so it stays held once.\nfn scalar_value(p: unique.Program, locals: Set[String], e: ast.Expr) -> Bool {\n  match e {\n    ast.Binary { op, .. } => unique.compares(op)\n      || op == ast.And\n      || op == ast.Or\n      || op == ast.Implies,\n    ast.Unary { op: ast.Not, .. } => true,\n    ast.IsExpr { .. } => true,\n    ast.Call { callee: ast.Var(n), .. } => {\n      ks := unique.candidates(p, n)\n      if contains(locals, n) {\n        false\n      } else if ks == [] {\n        unique.scalar_builtin(n)\n      } else {\n        ks.all(\n          k -> match get(p.fns, k) {\n            Some(f) => unique.scalar_type(f.ret),\n            None => false,\n          },\n        )\n      }\n    },\n    _ => false,\n  }\n}"},{"name":"unique.lent","kind":"fn","old":"a225e6e83001d20f","new":"00faa9c4264feac8","interface_changed":false,"affected":[],"module":"unique","text":"/// The `mut` arguments of a call, from `st`: `args[i]` goes to parameter\n/// `first + i` of each function in `targets`, `recv` are the call's other\n/// operands (a method's receiver). A `mut` variable stays held once when it\n/// was, no operand in `recv` mentions it, every other argument that reads\n/// it gives a value holding none of it (`scalar_value`, worked out before\n/// the call takes the variable), `known` says `targets` are all the\n/// functions the call may run, and each gives it back held once (`exit`).\n/// A field passed `mut` is put back after the call, so its record is then\n/// held once. Each target taking the argument `mut` is recorded for\n/// `entry`.\nfn lent(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  targets: List[String],\n  first: Int,\n  known: Bool,\n  args: List[ast.Expr],\n  recv: List[ast.Expr],\n  st: unique.St,\n) -> unique.St {\n  mut out := st\n  for (i, a) in enumerate(args) {\n    match a {\n      ast.MutExpr(m) => {\n        j := first + i\n        x := match m {\n          ast.Var(v) => v,\n          _ => \"\",\n        }\n        others := x == \"\"\n          || recv.any(o -> unique.mentions(o, x))\n          || enumerate(args).any(\n            o -> o.0 != i\n              && unique.mentions(o.1, x)\n              && (o.1 is ast.MutExpr || !unique.scalar_value(p, c, o.1)),\n          )\n        h := !others && unique.held(sum, c, out, x)\n        ts := targets.filter(k -> unique.mut_param(p, k, j))\n        if c.record {\n          for k in ts {\n            mut c.calls.push((k, j, h))\n          }\n        }\n        if x == \"\" {\n          // a field lent and put back: the record is then held once,\n          // changed in place or copied\n          out = unique.ex(p, sum, mut c, m, out)\n          out = if unique.root(m) == \"\" {\n            out\n          } else {\n            unique.set_var(out, unique.root(m), true)\n          }\n        } else if !(known\n          && h\n          && ts != []\n          && ts.all(k -> unique.exit_of(sum, k, j))) {\n          out = unique.spoil(out, x)\n        }\n      },\n      _ => (),\n    }\n  }\n  out\n}","old_text":"/// The `mut` arguments of a call, from `st`: `args[i]` goes to parameter\n/// `first + i` of each function in `targets`, `recv` are the call's other\n/// operands (a method's receiver). A `mut` variable stays held once when it\n/// was, no operand in `recv` mentions it, every other argument that reads\n/// it gives a value holding none of it (`scalar_value`, worked out before\n/// the call takes the variable), `known` says `targets` are all the\n/// functions the call may run, and each gives it back held once (`exit`).\n/// A field passed `mut` is put back after the call, so its record is then\n/// held once. Each target taking the argument `mut` is recorded for\n/// `entry`.\nfn lent(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  targets: List[String],\n  first: Int,\n  known: Bool,\n  args: List[ast.Expr],\n  recv: List[ast.Expr],\n  st: unique.St,\n) -> unique.St {\n  mut out := st\n  for (i, a) in enumerate(args) {\n    match a {\n      ast.MutExpr(m) => {\n        j := first + i\n        x := match m {\n          ast.Var(v) => v,\n          _ => \"\",\n        }\n        others := x == \"\"\n          || recv.any(o -> unique.mentions(o, x))\n          || enumerate(args).any(\n            o -> o.0 != i\n              && unique.mentions(o.1, x)\n              && (o.1 is ast.MutExpr\n                || !unique.scalar_value(p, c.locals, o.1)),\n          )\n        h := !others && unique.held(sum, c, out, x)\n        ts := targets.filter(k -> unique.mut_param(p, k, j))\n        if c.record {\n          for k in ts {\n            mut c.calls.push((k, j, h))\n          }\n        }\n        if x == \"\" {\n          // a field lent and put back: the record is then held once,\n          // changed in place or copied\n          out = unique.ex(p, sum, mut c, m, out)\n          out = if unique.root(m) == \"\" {\n            out\n          } else {\n            unique.set_var(out, unique.root(m), true)\n          }\n        } else if !(known\n          && h\n          && ts != []\n          && ts.all(k -> unique.exit_of(sum, k, j))) {\n          out = unique.spoil(out, x)\n        }\n      },\n      _ => (),\n    }\n  }\n  out\n}"}]}
{"id":"6c0cf33d95fd82d7","time":1795829690,"message":"edit","changes":[{"name":"unique.stmt_flow","kind":"fn","old":"ce1b114f8c00431b","new":"79f17cdd8e2efb04","interface_changed":false,"affected":[],"module":"unique","text":"/// A statement from `st`: the state after it, and the names it declares.\nfn stmt_flow(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  s: ast.Stmt,\n  st: unique.St,\n) -> (unique.St, List[String]) {\n  if !st.live {\n    return (st, [])\n  }\n  match s {\n    ast.Let { pat, ty, value } => match pat {\n      ast.Bind(x) => {\n        f := unique.fresh_value(p, sum, c, value, unique.kind_of(ty))\n        (\n          unique.set_var(unique.ex(p, sum, mut c, value, st), x, f),\n          [x],\n        )\n      },\n      _ => {\n        names := unique.pattern_names(pat)\n        mut out := unique.ex(p, sum, mut c, value, st)\n        for k in walk.pattern_kids(pat) {\n          out = unique.ex(p, sum, mut c, k, out)\n        }\n        for n in names {\n          out = unique.spoil(out, n)\n        }\n        (out, names)\n      },\n    },\n    ast.VarDecl { name, ty, value } => {\n      want := match unique.kind_of(ty) {\n        \"\" => get(c.kinds, name) ?? \"\",\n        k => k,\n      }\n      f := unique.fresh_value(p, sum, c, value, want)\n      (\n        unique.set_var(unique.ex(p, sum, mut c, value, st), name, f),\n        [name],\n      )\n    },\n    ast.Assign { place, value } => (unique.assign_flow(p, sum, mut c, place, value, st), []),\n    ast.While { cond, body } => (unique.loop_flow(p, sum, mut c, Some(cond), [], body, st), []),\n    ast.For { pat, iter, body } | ast.ComptimeFor { pat, iter, body } => {\n      after := unique.ex(p, sum, mut c, iter, st)\n      (unique.loop_flow(\n        p,\n        sum,\n        mut c,\n        Some(ast.BoolLit(true)),\n        unique.pattern_names(pat),\n        body,\n        after,\n      ), [])\n    },\n    ast.Break => {\n      mut c.breaks.push(st)\n      (unique.dead(), [])\n    },\n    ast.Continue => {\n      mut c.conts.push(st)\n      (unique.dead(), [])\n    },\n    ast.ExprStmt(e) | ast.Assert(e) | ast.Invariant(e) | ast.Decreases(e) => (unique.ex(p, sum, mut c, e, st), []),\n    _ => (st, []),\n  }\n}","old_text":"/// A statement from `st`: the state after it, and the names it declares.\nfn stmt_flow(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  s: ast.Stmt,\n  st: unique.St,\n) -> (unique.St, List[String]) {\n  if !st.live {\n    return (st, [])\n  }\n  match s {\n    ast.Let { pat, ty, value } => match pat {\n      ast.Bind(x) => {\n        f := unique.fresh_value(\n          p,\n          sum,\n          c.locals,\n          value,\n          unique.kind_of(ty),\n        )\n        (\n          unique.set_var(unique.ex(p, sum, mut c, value, st), x, f),\n          [x],\n        )\n      },\n      _ => {\n        names := unique.pattern_names(pat)\n        mut out := unique.ex(p, sum, mut c, value, st)\n        for k in walk.pattern_kids(pat) {\n          out = unique.ex(p, sum, mut c, k, out)\n        }\n        for n in names {\n          out = unique.spoil(out, n)\n        }\n        (out, names)\n      },\n    },\n    ast.VarDecl { name, ty, value } => {\n      want := match unique.kind_of(ty) {\n        \"\" => get(c.kinds, name) ?? \"\",\n        k => k,\n      }\n      f := unique.fresh_value(p, sum, c.locals, value, want)\n      (\n        unique.set_var(unique.ex(p, sum, mut c, value, st), name, f),\n        [name],\n      )\n    },\n    ast.Assign { place, value } => (unique.assign_flow(p, sum, mut c, place, value, st), []),\n    ast.While { cond, body } => (unique.loop_flow(p, sum, mut c, Some(cond), [], body, st), []),\n    ast.For { pat, iter, body } | ast.ComptimeFor { pat, iter, body } => {\n      after := unique.ex(p, sum, mut c, iter, st)\n      (unique.loop_flow(\n        p,\n        sum,\n        mut c,\n        Some(ast.BoolLit(true)),\n        unique.pattern_names(pat),\n        body,\n        after,\n      ), [])\n    },\n    ast.Break => {\n      mut c.breaks.push(st)\n      (unique.dead(), [])\n    },\n    ast.Continue => {\n      mut c.conts.push(st)\n      (unique.dead(), [])\n    },\n    ast.ExprStmt(e) | ast.Assert(e) | ast.Invariant(e) | ast.Decreases(e) => (unique.ex(p, sum, mut c, e, st), []),\n    _ => (st, []),\n  }\n}"},{"name":"unique.fresh_value","kind":"fn","old":"02ee889817b137ba","new":"29526247210206fe","interface_changed":true,"affected":["unique.stmt_flow","unique.returns","unique.assign_flow","unique.block_flow","unique.tail","unique.ex","unique.analyzed","unique.match_flow","unique.call_flow","unique.mut_method","unique.loop_pass","unique.lent","unique.local_call","unique.proven_sites","unique.loop_flow","codegen.generate","codegen_with","core_rt_text","computed_value","repl_eval","std_library","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","build_core_command","comptime_value","repl_command","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","literal_errors_of","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","strata_command","comptime_values","graph_command","graph_diff","loaded_check","file_errors","edit_file","edit_errors","search_invariants","build_proofs","verify_file","check_fn","command_line","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","main","with_base","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","codegen.read_back","eval_files"],"module":"unique","text":"/// Whether `e` makes a new value only its destination holds, of kind\n/// `want` (\"\" when not known): a constructor with fields (not of a\n/// `distinct` type), a list literal (an empty one only where a list is\n/// wanted, since an empty set or dict is a shared constant; a non-empty\n/// one when an element is `made` at run time), a set or dict\n/// literal with elements, or a call of a function whose result is fresh\n/// (`exact`).\nfn fresh_value(\n  p: unique.Program,\n  sum: unique.Summary,\n  c: unique.Ctx,\n  e: ast.Expr,\n  want: String,\n) -> Bool\n  ensures e is ast.Var ==> !it\n  ensures e is ast.FieldOf ==> !it\n  ensures e == ast.ListExpr([]) && want != \"List\" ==> !it\n  ensures e == ast.ListExpr([ast.IntLit(0)]) ==> !it {\n  match e {\n    ast.CtorExpr { name, args } => !contains(p.distinct, name)\n      && match args {\n        ast.PositionalArgs(xs) => xs != [],\n        ast.RecordArgs(fs) => fs != [],\n        ast.NoArgs => false,\n      },\n    ast.ListExpr(xs) => if xs == [] {\n      want == \"List\"\n    } else {\n      want != \"Set\" && want != \"Dict\" && xs.any(x -> unique.made(x))\n    },\n    ast.Call { callee: ast.Var(n), .. } => unique.exact(p, c, n) && get(sum.fresh, n) ?? false,\n    ast.IfExpr { then, otherwise, .. } => unique.fresh_value(p, sum, c, then, want)\n      && unique.fresh_value(p, sum, c, otherwise, want),\n    ast.Block { stmts: [], last } => unique.fresh_value(p, sum, c, last, want),\n    _ => false,\n  }\n}","old_text":"/// Whether `e` makes a new value only its destination holds, of kind\n/// `want` (\"\" when not known): a constructor with fields (not of a\n/// `distinct` type), a list literal (an empty one only where a list is\n/// wanted, since an empty set or dict is a shared constant; a non-empty\n/// one when an element is `made` at run time), a set or dict\n/// literal with elements, or a call of a function whose result is fresh\n/// (none of `locals`, which shadow the program's functions).\nfn fresh_value(\n  p: unique.Program,\n  sum: unique.Summary,\n  locals: Set[String],\n  e: ast.Expr,\n  want: String,\n) -> Bool\n  ensures e is ast.Var ==> !it\n  ensures e is ast.FieldOf ==> !it\n  ensures e == ast.ListExpr([]) && want != \"List\" ==> !it\n  ensures e == ast.ListExpr([ast.IntLit(0)]) ==> !it {\n  match e {\n    ast.CtorExpr { name, args } => !contains(p.distinct, name)\n      && match args {\n        ast.PositionalArgs(xs) => xs != [],\n        ast.RecordArgs(fs) => fs != [],\n        ast.NoArgs => false,\n      },\n    ast.ListExpr(xs) => if xs == [] {\n      want == \"List\"\n    } else {\n      want != \"Set\" && want != \"Dict\" && xs.any(x -> unique.made(x))\n    },\n    ast.Call { callee: ast.Var(n), .. } => !contains(locals, n)\n      && contains(p.fns, n)\n      && !contains(p.methods, unique.short(n))\n      && get(sum.fresh, n) ?? false,\n    ast.IfExpr { then, otherwise, .. } => unique.fresh_value(p, sum, locals, then, want)\n      && unique.fresh_value(p, sum, locals, otherwise, want),\n    ast.Block { stmts: [], last } => unique.fresh_value(p, sum, locals, last, want),\n    _ => false,\n  }\n}"},{"name":"unique.call_flow","kind":"fn","old":"c9c4ae2117736364","new":"de7bb2168db6d39f","interface_changed":false,"affected":[],"module":"unique","text":"/// `name(args)`: the arguments worked out in order, those not `mut` first,\n/// then the `mut` ones (`lent`). A variable passed to a parameter the\n/// callee doesn't keep is only borrowed, when no later argument mentions\n/// it. A `mut` argument stays held once only when `name` is a function of\n/// the program, the only one the call may run. A call of a variable\n/// (`local_call`) runs no function the program names.\nfn call_flow(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  name: String,\n  args: List[ast.Expr],\n  st: unique.St,\n) -> unique.St {\n  if contains(c.locals, name) {\n    return unique.local_call(p, sum, mut c, args, st)\n  }\n  mut out := st\n  for (i, a) in enumerate(args) {\n    match a {\n      ast.MutExpr(_) => (),\n      // borrowed, unless a later argument mentions it: the call holds the\n      // value while those are worked out\n      ast.Var(x) => if !unique.borrows(p, c, name, args, i)\n        || drop(args, i + 1).any(o -> unique.mentions(o, x)) {\n        out = unique.spoil(out, x)\n      },\n      _ => {\n        out = unique.ex(p, sum, mut c, a, out)\n      },\n    }\n  }\n  known := unique.exact(p, c, name)\n  unique.lent(\n    p,\n    sum,\n    mut c,\n    unique.candidates(p, c, name, args),\n    0,\n    known,\n    args,\n    [],\n    out,\n  )\n}","old_text":"/// `name(args)`: the arguments worked out in order, those not `mut` first,\n/// then the `mut` ones (`lent`). A variable passed to a parameter the\n/// callee doesn't keep is only borrowed, when no later argument mentions\n/// it. A `mut` argument stays held once only when `name` is a function of\n/// the program, the only one the call may run. A call of a variable\n/// (`local_call`) runs no function the program names.\nfn call_flow(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  name: String,\n  args: List[ast.Expr],\n  st: unique.St,\n) -> unique.St {\n  if contains(c.locals, name) {\n    return unique.local_call(p, sum, mut c, args, st)\n  }\n  mut out := st\n  for (i, a) in enumerate(args) {\n    match a {\n      ast.MutExpr(_) => (),\n      // borrowed, unless a later argument mentions it: the call holds the\n      // value while those are worked out\n      ast.Var(x) => if !unique.borrows(p, c, name, args, i)\n        || drop(args, i + 1).any(o -> unique.mentions(o, x)) {\n        out = unique.spoil(out, x)\n      },\n      _ => {\n        out = unique.ex(p, sum, mut c, a, out)\n      },\n    }\n  }\n  known := contains(p.fns, name) && !contains(p.methods, unique.short(name))\n  unique.lent(\n    p,\n    sum,\n    mut c,\n    unique.candidates(p, c, name, args),\n    0,\n    known,\n    args,\n    [],\n    out,\n  )\n}"},{"name":"unique.borrows","kind":"fn","old":"b40631fb45d28f40","new":"134280e5fb703aa5","interface_changed":false,"affected":[],"module":"unique","text":"/// Whether calling `name` borrows its argument `i` without keeping it.\nfn borrows(\n  p: unique.Program,\n  c: unique.Ctx,\n  name: String,\n  args: List[ast.Expr],\n  i: Int,\n) -> Bool {\n  if unique.exact(p, c, name) {\n    return !unique.keeps(p, name, i)\n  }\n  unique.reads_only(unique.short(name))\n    && unique.candidates(p, c, name, args).all(\n      k -> !unique.keeps(p, k, i),\n    )\n}","old_text":"/// Whether calling `name` borrows its argument `i` without keeping it.\nfn borrows(\n  p: unique.Program,\n  c: unique.Ctx,\n  name: String,\n  args: List[ast.Expr],\n  i: Int,\n) -> Bool {\n  if contains(p.fns, name) && !contains(p.methods, unique.short(name)) {\n    return !unique.keeps(p, name, i)\n  }\n  unique.reads_only(unique.short(name))\n    && unique.candidates(p, c, name, args).all(\n      k -> !unique.keeps(p, k, i),\n    )\n}"},{"name":"unique.candidates","kind":"fn","old":"224dc6664f4e02d8","new":"7ab782179ea8f2e8","interface_changed":false,"affected":[],"module":"unique","text":"/// The functions a call `name(args)` may run: the function of that key\n/// (`exact`). Else a built-in, which\n/// on a value of a program type runs that type's method of the name, so\n/// the functions of that short name: of the `impl`s' methods, only the one\n/// the first argument's written type resolves it to, and none for a\n/// built-in type's value.\nfn candidates(\n  p: unique.Program,\n  c: unique.Ctx,\n  name: String,\n  args: List[ast.Expr],\n) -> List[String] {\n  n := unique.short(name)\n  if unique.exact(p, c, name) {\n    return [name]\n  }\n  all := get(p.by_short, n) ?? []\n  head := match get(args, 0) {\n    Some(ast.Var(x)) | Some(ast.MutExpr(ast.Var(x))) => get(c.heads, x) ?? \"\",\n    _ => \"\",\n  }\n  match get(p.resolved, head + \".\" + n) {\n    Some(k) => all.filter(x -> x == k || !contains(p.impls, x)),\n    None => if [\n      \"List\",\n      \"Dict\",\n      \"Set\",\n      \"Option\",\n      \"Result\",\n      \"Int\",\n      \"Float\",\n      \"Bool\",\n      \"String\",\n    ].contains(\n      head,\n    ) {\n      all.filter(x -> !contains(p.impls, x))\n    } else {\n      all\n    },\n  }\n}","old_text":"/// The functions a call `name(args)` may run: the function of that key,\n/// unless a trait has a method of its short name. Else a built-in, which\n/// on a value of a program type runs that type's method of the name, so\n/// the functions of that short name: of the `impl`s' methods, only the one\n/// the first argument's written type resolves it to, and none for a\n/// built-in type's value.\nfn candidates(\n  p: unique.Program,\n  c: unique.Ctx,\n  name: String,\n  args: List[ast.Expr],\n) -> List[String] {\n  n := unique.short(name)\n  if contains(p.fns, name) && !contains(p.methods, n) {\n    return [name]\n  }\n  all := get(p.by_short, n) ?? []\n  head := match get(args, 0) {\n    Some(ast.Var(x)) | Some(ast.MutExpr(ast.Var(x))) => get(c.heads, x) ?? \"\",\n    _ => \"\",\n  }\n  match get(p.resolved, head + \".\" + n) {\n    Some(k) => all.filter(x -> x == k || !contains(p.impls, x)),\n    None => if [\n      \"List\",\n      \"Dict\",\n      \"Set\",\n      \"Option\",\n      \"Result\",\n      \"Int\",\n      \"Float\",\n      \"Bool\",\n      \"String\",\n    ].contains(\n      head,\n    ) {\n      all.filter(x -> !contains(p.impls, x))\n    } else {\n      all\n    },\n  }\n}"},{"name":"unique.returns","kind":"fn","old":"96a56404edda5da6","new":"b312046b2e29b342","interface_changed":false,"affected":[],"module":"unique","text":"/// A return of `e` at `st`, in a recording pass: whether it gives a fresh\n/// value, and which `mut` parameters are held once after it is worked out.\nfn returns(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  e: ast.Expr,\n  st: unique.St,\n) -> unique.St {\n  given := match e {\n    ast.Var(x) => contains(st.s, x)\n      && !contains(st.a, x)\n      && !c.params.any(q -> q.name == x),\n    _ => unique.fresh_value(p, sum, c, e, c.ret),\n  }\n  after := unique.ex(p, sum, mut c, e, st)\n  if c.record && after.live {\n    c.fresh = c.fresh && given\n    c.exits = set(to_list(c.exits).filter(n -> contains(after.s, n)))\n  }\n  unique.dead()\n}","old_text":"/// A return of `e` at `st`, in a recording pass: whether it gives a fresh\n/// value, and which `mut` parameters are held once after it is worked out.\nfn returns(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  e: ast.Expr,\n  st: unique.St,\n) -> unique.St {\n  given := match e {\n    ast.Var(x) => contains(st.s, x)\n      && !contains(st.a, x)\n      && !c.params.any(q -> q.name == x),\n    _ => unique.fresh_value(p, sum, c.locals, e, c.ret),\n  }\n  after := unique.ex(p, sum, mut c, e, st)\n  if c.record && after.live {\n    c.fresh = c.fresh && given\n    c.exits = set(to_list(c.exits).filter(n -> contains(after.s, n)))\n  }\n  unique.dead()\n}"},{"name":"unique.assign_flow","kind":"fn","old":"a4e018387dfd5ca3","new":"2f9c5f1ed1ab9d66","interface_changed":false,"affected":[],"module":"unique","text":"/// `place = value`.\n/// - `x = op(x, args)` with `op` an update in place (`in_place_op`): the\n/// site is proven when `x` is held once after the arguments (which may\n/// read it). Afterwards `x` is held once when it was (and always after a\n/// dict's `insert`, whose copy is a table of its own).\n/// - `x = e`: `x` is held once when `e` is a fresh value.\n/// - `x.a.b = e`: the site is proven when `x` is held once after `e`.\n/// Afterwards `x` is held once either way: it was changed in place, or a\n/// new copy was made.\nfn assign_flow(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  place: ast.Expr,\n  value: ast.Expr,\n  st: unique.St,\n) -> unique.St {\n  match place {\n    ast.Var(x) => {\n      (op, rest) := match value {\n        ast.Call { callee: ast.Var(n), args: [ast.Var(y), ..more] } => if y == x\n          && unique.in_place_op(n)\n          && (ast.is_core_ref(n)\n            || !contains(p.fns, n) && !contains(c.locals, n)) {\n          (ast.core_named(n), more)\n        } else {\n          (\"\", [])\n        },\n        _ => (\"\", []),\n      }\n      if op == \"\" {\n        f := unique.fresh_value(p, sum, c, value, get(c.kinds, x) ?? \"\")\n        return unique.set_var(unique.ex(p, sum, mut c, value, st), x, f)\n      }\n      mut out := st\n      for a in rest {\n        out = unique.ex(p, sum, mut c, a, out)\n      }\n      h := unique.held(sum, c, out, x)\n      unique.site(mut c, unique.site_key(c.key, place, value), h)\n      kind := get(c.kinds, x) ?? \"\"\n      if op == \"insert\" && kind == \"Dict\" && !h {\n        return unique.set_var(out, x, true)\n      }\n      ok := h\n        && match op {\n          \"insert\" | \"remove\" => kind == \"Dict\" || kind == \"Set\",\n          \"push\" | \"take\" | \"set_at\" | \"grow\" => kind == \"List\",\n          _ => false,\n        }\n      if ok {\n        out\n      } else {\n        unique.spoil(out, x)\n      }\n    },\n    _ => {\n      x := unique.root(place)\n      if x == \"\" {\n        return unique.ex(\n          p,\n          sum,\n          mut c,\n          value,\n          unique.ex(p, sum, mut c, place, st),\n        )\n      }\n      out := unique.ex(p, sum, mut c, value, st)\n      unique.site(\n        mut c,\n        unique.site_key(c.key, place, value),\n        unique.held(sum, c, out, x),\n      )\n      unique.set_var(out, x, true)\n    },\n  }\n}","old_text":"/// `place = value`.\n/// - `x = op(x, args)` with `op` an update in place (`in_place_op`): the\n/// site is proven when `x` is held once after the arguments (which may\n/// read it). Afterwards `x` is held once when it was (and always after a\n/// dict's `insert`, whose copy is a table of its own).\n/// - `x = e`: `x` is held once when `e` is a fresh value.\n/// - `x.a.b = e`: the site is proven when `x` is held once after `e`.\n/// Afterwards `x` is held once either way: it was changed in place, or a\n/// new copy was made.\nfn assign_flow(\n  p: unique.Program,\n  sum: unique.Summary,\n  mut c: unique.Ctx,\n  place: ast.Expr,\n  value: ast.Expr,\n  st: unique.St,\n) -> unique.St {\n  match place {\n    ast.Var(x) => {\n      (op, rest) := match value {\n        ast.Call { callee: ast.Var(n), args: [ast.Var(y), ..more] } => if y == x\n          && unique.in_place_op(n)\n          && (ast.is_core_ref(n)\n            || !contains(p.fns, n) && !contains(c.locals, n)) {\n          (ast.core_named(n), more)\n        } else {\n          (\"\", [])\n        },\n        _ => (\"\", []),\n      }\n      if op == \"\" {\n        f := unique.fresh_value(\n          p,\n          sum,\n          c.locals,\n          value,\n          get(c.kinds, x) ?? \"\",\n        )\n        return unique.set_var(unique.ex(p, sum, mut c, value, st), x, f)\n      }\n      mut out := st\n      for a in rest {\n        out = unique.ex(p, sum, mut c, a, out)\n      }\n      h := unique.held(sum, c, out, x)\n      unique.site(mut c, unique.site_key(c.key, place, value), h)\n      kind := get(c.kinds, x) ?? \"\"\n      if op == \"insert\" && kind == \"Dict\" && !h {\n        return unique.set_var(out, x, true)\n      }\n      ok := h\n        && match op {\n          \"insert\" | \"remove\" => kind == \"Dict\" || kind == \"Set\",\n          \"push\" | \"take\" | \"set_at\" | \"grow\" => kind == \"List\",\n          _ => false,\n        }\n      if ok {\n        out\n      } else {\n        unique.spoil(out, x)\n      }\n    },\n    _ => {\n      x := unique.root(place)\n      if x == \"\" {\n        return unique.ex(\n          p,\n          sum,\n          mut c,\n          value,\n          unique.ex(p, sum, mut c, place, st),\n        )\n      }\n      out := unique.ex(p, sum, mut c, value, st)\n      unique.site(\n        mut c,\n        unique.site_key(c.key, place, value),\n        unique.held(sum, c, out, x),\n      )\n      unique.set_var(out, x, true)\n    },\n  }\n}"},{"name":"unique.exact","kind":"fn","old":null,"new":"70ac673cf48fdca5","interface_changed":true,"affected":[],"module":"unique","text":"/// Whether a call of `name` in `c`'s function runs the program's function\n/// of that key: a name the function doesn't bind, called outside the\n/// prelude (which calls its own functions first) and not as desugaring\n/// calls a built-in (`ast.core_ref`).\nfn exact(p: unique.Program, c: unique.Ctx, name: String) -> Bool {\n  contains(p.fns, name)\n    && !contains(c.locals, name)\n    && !ast.is_core_ref(name)\n    && !starts_with(c.key, \"strata.\")\n}"}]}
{"id":"d9bb1e52c37b2c6d","time":1795829892,"message":"edit","changes":[{"name":"unique.binders","kind":"fn","old":"80f80d6c3fe06c9a","new":"278aac43e0995083","interface_changed":false,"affected":[],"module":"unique","text":"/// Each name `e` binds, at any depth, with the type it is written with\n/// (when a variable is, or a list literal gives it): `x := e` and\n/// `mut x := e`, patterns' names, `for` variables, lambdas' parameters, a\n/// `match`'s `as` name and `select` arms' names.\npub fn binders(e: ast.Expr) -> List[(String, Option[ast.TypeExpr])] {\n  mut out := []\n  mut todo := [e]\n  while todo != [] {\n    x := get(todo, len(todo) - 1) ?? ast.UnitExpr\n    todo = todo[..len(todo) - 1]\n    match x {\n      ast.Block { stmts, .. } => {\n        for st in stmts {\n          match st {\n            ast.Let { pat: ast.Bind(n), ty, value } => mut out.push((n, unique.given_type(ty, value))),\n            ast.VarDecl { name, ty, value } => mut out.push((name, unique.given_type(ty, value))),\n            ast.Let { pat, .. } | ast.For { pat, .. } | ast.ComptimeFor { pat, .. } => {\n              out += unique.pattern_names(pat).map(n -> (n, None))\n            },\n            _ => (),\n          }\n        }\n      },\n      ast.Lambda { params, .. } => {\n        out += params.map(q -> (q.name, q.ty))\n      },\n      ast.MatchExpr { binding, arms, .. } => {\n        match binding {\n          Some(b) => mut out.push((b, None)),\n          None => (),\n        }\n        for a in arms {\n          out += unique.pattern_names(a.pat).map(n -> (n, None))\n        }\n      },\n      ast.Select(arms) | ast.Race(arms) => {\n        for a in arms {\n          match a.name {\n            Some(n) => mut out.push((n, None)),\n            None => (),\n          }\n        }\n      },\n      _ => (),\n    }\n    todo += walk.kids(x)\n  }\n  out\n}","old_text":"/// Each name `e` binds, at any depth, with the type it is written with\n/// (when a variable is): `x := e` and `mut x := e`, patterns' names, `for`\n/// variables, lambdas' parameters, a `match`'s `as` name and `select`\n/// arms' names.\npub fn binders(e: ast.Expr) -> List[(String, Option[ast.TypeExpr])] {\n  mut out := []\n  mut todo := [e]\n  while todo != [] {\n    x := get(todo, len(todo) - 1) ?? ast.UnitExpr\n    todo = todo[..len(todo) - 1]\n    match x {\n      ast.Block { stmts, .. } => {\n        for st in stmts {\n          match st {\n            ast.Let { pat: ast.Bind(n), ty, .. } => mut out.push((n, ty)),\n            ast.VarDecl { name, ty, .. } => mut out.push((name, ty)),\n            ast.Let { pat, .. } | ast.For { pat, .. } | ast.ComptimeFor { pat, .. } => {\n              out += unique.pattern_names(pat).map(n -> (n, None))\n            },\n            _ => (),\n          }\n        }\n      },\n      ast.Lambda { params, .. } => {\n        out += params.map(q -> (q.name, q.ty))\n      },\n      ast.MatchExpr { binding, arms, .. } => {\n        match binding {\n          Some(b) => mut out.push((b, None)),\n          None => (),\n        }\n        for a in arms {\n          out += unique.pattern_names(a.pat).map(n -> (n, None))\n        }\n      },\n      ast.Select(arms) | ast.Race(arms) => {\n        for a in arms {\n          match a.name {\n            Some(n) => mut out.push((n, None)),\n            None => (),\n          }\n        }\n      },\n      _ => (),\n    }\n    todo += walk.kids(x)\n  }\n  out\n}"},{"name":"unique.given_type","kind":"fn","old":null,"new":"2628a7936b717eda","interface_changed":true,"affected":[],"module":"unique","text":"/// The type a variable is written with, else `List` for a list literal.\nfn given_type(\n  ty: Option[ast.TypeExpr],\n  value: ast.Expr,\n) -> Option[ast.TypeExpr] {\n  match (ty, value) {\n    (None, ast.ListExpr(_)) => Some(ast.Named { name: \"List\", args: [] }),\n    _ => ty,\n  }\n}"}]}
{"id":"9809789db4692693","time":1795830199,"message":"edit","changes":[{"name":"codegen.generate","kind":"fn","old":"79d81fdb098b19bc","new":"97f503eb92f95377","interface_changed":false,"affected":[],"module":"codegen","text":"/// The program's `main` and what it calls as LLVM IR, or the constructs not\n/// compiled, each with its function. `assumed_clauses` also checks the\n/// assumed contract clauses (`--check-assumed`). Verify's fuzz drivers\n/// always check them.\npub fn generate(\n  given: List[ast.Decl],\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  proofs: List[String],\n  tests: Option[List[(String, String)]],\n  fuzz: List[String],\n  fuzz_text: Bool,\n  calls: List[String],\n  trace: Bool,\n  library: List[String],\n  precompiled: List[String],\n  bare: Bool,\n  copies: Option[Dict[String, String]],\n  memory_sites: Option[Dict[String, String]],\n  assumed_clauses: Bool,\n  live: Bool,\n) -> Result[String, List[String]] {\n  // unused variables with no effect are not compiled (`unread_dropped`),\n  // and assumed contract clauses are left out (`assumed_compiled`)\n  timings.begin(\"codegen: tables\")\n  keep := assumed_clauses || fuzz != []\n  // lemmas and proofs (`assert … by`, `calc`) are for `verify` alone: never\n  // compiled\n  (start, main) := codegen.new_gen(\n    given\n      .filter(d -> !match d.kind {\n        ast.FnDef(f) => f.lemma,\n        _ => false,\n      })\n      .map(d -> walk.rewrite_decl(\n        codegen.assumed_compiled(d, keep),\n        x -> codegen.unread_dropped(codegen.proofs_dropped(x)),\n      )),\n    core,\n    prelude,\n    proofs,\n    tests,\n    fuzz,\n    fuzz_text,\n    calls,\n    trace,\n    library,\n    precompiled,\n  ) except es {\n    timings.end(\"codegen: tables\")\n    return Err(es)\n  }\n  // core.rt (`bare`): no call-stack frames, no cancel points\n  mut g := if bare {\n    codegen.Gen {\n      ..start,\n      bare: true,\n      tasks: false,\n      supervises: false,\n    }\n  } else {\n    start\n  }\n  if live {\n    g.live = true\n    // (no function's parameters known to be only borrowed)\n    g.keeps = Some(Dict[String, List[Bool]] {})\n  }\n  // `--copies`: report copies with their locations\n  match copies {\n    Some(sites) => {\n      g.copies = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  // (`--memory-sites`: each counting operation counted, by site)\n  match memory_sites {\n    Some(sites) => {\n      g.memory_sites = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  timings.end(\"codegen: tables\")\n  mut bodies := match tests {\n    // each test as `strata test` runs it (`strata.test.N`), with its name\n    Some(ts) => enumerate(ts).map(x -> codegen.test_entry(x.0, x.1.0, x.1.1)),\n    None => if fuzz != [] || library != [] || calls != [] {\n      []\n    } else if main.name == \"\" {\n      // a library starts when it is loaded\n      [codegen.library_start(mut g)]\n    } else {\n      [codegen.entry(mut g, main)]\n    },\n  }\n  // std's library runs in any program, with tasks or without. It holds its\n  // functions by key and its `impl`s' methods (`library_methods`), except\n  // those `!KEY` excludes. Generic functions, those depending on the\n  // compile, and trait values are compiled per program instead.\n  mut roots := []\n  mut held := []\n  left_out := set(library\n    .filter(k -> starts_with(k, \"!\"))\n    .map(k -> byte_slice(k, 1, byte_len(k))))\n  mut wanted := library.filter(k -> !starts_with(k, \"!\"))\n  if library != [] {\n    wanted += codegen.library_methods(mut g).filter(\n      k -> !contains(left_out, k),\n    )\n  }\n  for k in wanted {\n    match codegen.fn_of(g, k) {\n      Some(f) => if codegen.precompilable(mut g, k, f) {\n        sym := codegen.instance(mut g, k, f, Dict[String, check.Ty] {})\n        mut roots.push(sym)\n        mut held.push(k)\n      },\n      None => (),\n    }\n  }\n  // verify's fuzz drivers (`strata.fuzz.N`)\n  for (i, k) in enumerate(fuzz) {\n    mut bodies.push(codegen.fuzz_driver(mut g, i, k))\n  }\n  // `strata run f ARGS` calls (`strata.call.N`). `session:KEY` is a\n  // `strata repl` line, with the session's arguments.\n  for (i, k) in enumerate(calls) {\n    mut bodies.push(\n      if starts_with(k, \"session:\") {\n        codegen.session_entry(\n          mut g,\n          i,\n          byte_slice(k, 8, byte_len(k)),\n        )\n      } else {\n        codegen.call_entry(mut g, i, k)\n      },\n    )\n  }\n  // the exports of `derive C for f`, each under its symbol\n  if fuzz == [] && library == [] && calls == [] && tests is None {\n    for (symbol, k) in codegen.exports_of(given) {\n      mut bodies.push(codegen.export_entry(mut g, symbol, k))\n    }\n  }\n  // the files they generate: the C header\n  parts := codegen.file_parts(given) except e { return Err([e]) }\n  // Each reachable function instance, once, in rounds. The workers compile\n  // each function of a round alone from the state the round began with.\n  // Their additions are then merged in queue order, so the output does not\n  // depend on thread timing.\n  timings.begin(\"codegen: keeps\")\n  // (the analyses below see the `impl`s' methods: the updates in place\n  // and the stack, for builds and tests)\n  analyzed := len(g.queue) > 0 && !bare && !live && fuzz == [] && calls == []\n  (resolved, methods) := if analyzed {\n    codegen.impl_methods(mut g)\n  } else {\n    (Dict[String, String] {}, Set[String] {})\n  }\n  if len(g.queue) > 0 && g.keeps is None {\n    g.keeps = Some(codegen.kept_by(g.fns))\n  }\n  timings.end(\"codegen: keeps\")\n  timings.begin(\"codegen: unique\")\n  // the updates in place proven to find their value held once, for builds\n  // and tests (not for verify's fuzzing, `strata run f` and compile-time\n  // code, which run once). Only a program's build sees every call of its\n  // functions (`closed`).\n  if analyzed {\n    closed := library == []\n      && tests is None\n      && main.name != \"\"\n      && codegen.exports_of(given) == []\n    g.proven = unique.proven_sites(\n      g.fns,\n      codegen.keeps_of(mut g),\n      closed,\n      g.distincts,\n      g.traits,\n      resolved,\n      methods,\n    )\n  }\n  // (`--memory-sites`: where scoped allocation would put each value,\n  // from the functions but the `impl`s' methods, whose calls `roots` finds\n  // by short name)\n  if g.memory_sites && len(g.queue) > 0 {\n    mut own := g.fns\n    for k in methods {\n      mut own.remove(k)\n    }\n    g.roots = roots.verdicts(own, codegen.keeps_of(mut g), g.traits, g.proven)\n  }\n  timings.end(\"codegen: unique\")\n  mut global_keys := set(g.globals.map(l -> codegen.global_key(l)))\n  mut def_keys := set(g.helper_defs.map(d -> codegen.def_key(d)))\n  timings.begin(\"codegen: functions\")\n  while len(g.queue) > 0 {\n    round := g.queue\n    g.queue = []\n    base := g\n    for (body, d) in parallel.map_parallel(\n      round,\n      item -> codegen.compiled_alone(base, item.0, item.1, main),\n    ) {\n      mut bodies.push(body)\n      codegen.merge_alone(\n        mut g,\n        base,\n        d,\n        mut global_keys,\n        mut def_keys,\n      )\n    }\n  }\n  timings.end(\"codegen: functions\")\n  if len(g.errs) > 0 {\n    // std's library leaves out the functions that reach something not\n    // compiled\n    if library != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      out := wanted.filter(k -> contains(left, k))\n      if out != [] {\n        return Err(out.map(k -> \"leave out: \" + k))\n      }\n    }\n    // verify's fuzz drivers: each one reaching something not compiled is\n    // reported as `can't fuzz `KEY`: WHY`, so `verify` drops them all at\n    // once\n    if fuzz != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      callees := codegen.callees_of(g.callers)\n      return Err(g.errs\n        + fuzz\n          .filter(k -> contains(left, \"fuzz:\" + k))\n          .map(k -> \"can't fuzz `\"\n            + k\n            + \"`: \"\n            + join(\n              codegen.failures_of(callees, g.why, \"fuzz:\" + k),\n              \"; \",\n            )))\n    }\n    return Err(g.errs)\n  }\n  mut out := [\n    \"; Strata, compiled by compiler/codegen\",\n    f\"; checks left out {g.left_out}, kept {g.kept}\",\n    \"\",\n  ]\n  // std's library lists the functions it holds: `; precompiled NAME`\n  out += held.map(k -> \"; precompiled \" + k)\n  out += parts.map(p -> codegen.file_line(p.0, p.1))\n  // the symbols a library exports (`; export add`); the rest are hidden\n  out += if fuzz == [] && library == [] && calls == [] && tests is None {\n    codegen.exports_of(given).map(e -> \"; export \" + e.0)\n  } else {\n    []\n  }\n  out += g.globals\n  mut out.push(\"\")\n  // std's library exposes only its functions\n  out += if library != [] {\n    codegen.internal(bodies + g.helper_defs, set(roots))\n  } else {\n    bodies + g.helper_defs\n  }\n  for d in codegen.declarations() {\n    if contains(g.used, d.0) {\n      mut out.push(d.1)\n    }\n  }\n  ir_text := join(out, \"\\n\") + \"\\n\"\n  Ok(if g.memory_sites {\n    codegen.counted_sites(ir_text)\n  } else {\n    ir_text\n  })\n}","old_text":"/// The program's `main` and what it calls as LLVM IR, or the constructs not\n/// compiled, each with its function. `assumed_clauses` also checks the\n/// assumed contract clauses (`--check-assumed`). Verify's fuzz drivers\n/// always check them.\npub fn generate(\n  given: List[ast.Decl],\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  proofs: List[String],\n  tests: Option[List[(String, String)]],\n  fuzz: List[String],\n  fuzz_text: Bool,\n  calls: List[String],\n  trace: Bool,\n  library: List[String],\n  precompiled: List[String],\n  bare: Bool,\n  copies: Option[Dict[String, String]],\n  memory_sites: Option[Dict[String, String]],\n  assumed_clauses: Bool,\n  live: Bool,\n) -> Result[String, List[String]] {\n  // unused variables with no effect are not compiled (`unread_dropped`),\n  // and assumed contract clauses are left out (`assumed_compiled`)\n  timings.begin(\"codegen: tables\")\n  keep := assumed_clauses || fuzz != []\n  // lemmas and proofs (`assert … by`, `calc`) are for `verify` alone: never\n  // compiled\n  (start, main) := codegen.new_gen(\n    given\n      .filter(d -> !match d.kind {\n        ast.FnDef(f) => f.lemma,\n        _ => false,\n      })\n      .map(d -> walk.rewrite_decl(\n        codegen.assumed_compiled(d, keep),\n        x -> codegen.unread_dropped(codegen.proofs_dropped(x)),\n      )),\n    core,\n    prelude,\n    proofs,\n    tests,\n    fuzz,\n    fuzz_text,\n    calls,\n    trace,\n    library,\n    precompiled,\n  ) except es {\n    timings.end(\"codegen: tables\")\n    return Err(es)\n  }\n  // core.rt (`bare`): no call-stack frames, no cancel points\n  mut g := if bare {\n    codegen.Gen {\n      ..start,\n      bare: true,\n      tasks: false,\n      supervises: false,\n    }\n  } else {\n    start\n  }\n  if live {\n    g.live = true\n    // (no function's parameters known to be only borrowed)\n    g.keeps = Some(Dict[String, List[Bool]] {})\n  }\n  // `--copies`: report copies with their locations\n  match copies {\n    Some(sites) => {\n      g.copies = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  // (`--memory-sites`: each counting operation counted, by site)\n  match memory_sites {\n    Some(sites) => {\n      g.memory_sites = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  timings.end(\"codegen: tables\")\n  mut bodies := match tests {\n    // each test as `strata test` runs it (`strata.test.N`), with its name\n    Some(ts) => enumerate(ts).map(x -> codegen.test_entry(x.0, x.1.0, x.1.1)),\n    None => if fuzz != [] || library != [] || calls != [] {\n      []\n    } else if main.name == \"\" {\n      // a library starts when it is loaded\n      [codegen.library_start(mut g)]\n    } else {\n      [codegen.entry(mut g, main)]\n    },\n  }\n  // std's library runs in any program, with tasks or without. It holds its\n  // functions by key and its `impl`s' methods (`library_methods`), except\n  // those `!KEY` excludes. Generic functions, those depending on the\n  // compile, and trait values are compiled per program instead.\n  mut roots := []\n  mut held := []\n  left_out := set(library\n    .filter(k -> starts_with(k, \"!\"))\n    .map(k -> byte_slice(k, 1, byte_len(k))))\n  mut wanted := library.filter(k -> !starts_with(k, \"!\"))\n  if library != [] {\n    wanted += codegen.library_methods(mut g).filter(\n      k -> !contains(left_out, k),\n    )\n  }\n  for k in wanted {\n    match codegen.fn_of(g, k) {\n      Some(f) => if codegen.precompilable(mut g, k, f) {\n        sym := codegen.instance(mut g, k, f, Dict[String, check.Ty] {})\n        mut roots.push(sym)\n        mut held.push(k)\n      },\n      None => (),\n    }\n  }\n  // verify's fuzz drivers (`strata.fuzz.N`)\n  for (i, k) in enumerate(fuzz) {\n    mut bodies.push(codegen.fuzz_driver(mut g, i, k))\n  }\n  // `strata run f ARGS` calls (`strata.call.N`). `session:KEY` is a\n  // `strata repl` line, with the session's arguments.\n  for (i, k) in enumerate(calls) {\n    mut bodies.push(\n      if starts_with(k, \"session:\") {\n        codegen.session_entry(\n          mut g,\n          i,\n          byte_slice(k, 8, byte_len(k)),\n        )\n      } else {\n        codegen.call_entry(mut g, i, k)\n      },\n    )\n  }\n  // the exports of `derive C for f`, each under its symbol\n  if fuzz == [] && library == [] && calls == [] && tests is None {\n    for (symbol, k) in codegen.exports_of(given) {\n      mut bodies.push(codegen.export_entry(mut g, symbol, k))\n    }\n  }\n  // the files they generate: the C header\n  parts := codegen.file_parts(given) except e { return Err([e]) }\n  // Each reachable function instance, once, in rounds. The workers compile\n  // each function of a round alone from the state the round began with.\n  // Their additions are then merged in