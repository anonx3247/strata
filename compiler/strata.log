s := [\n        \"-O2\",\n        \"-mmacosx-version-min=13.0\",\n        \"-Wno-deprecated-declarations\",\n        \"-DSTRATA_CORE_RT\",\n      ]\n      + if toolchain.profiling() {\n        [\"-fno-omit-frame-pointer\", \"-mno-omit-leaf-frame-pointer\"]\n      } else {\n        []\n      }\n    // (under the C compiler, its flags and the runtime's source)\n    key := toolchain.files_key(\n      join([\"runtime.c\", cc] + flags, \" \"),\n      [home + \"/runtime/runtime.c\"],\n    )\n    runtime = kept + \"/runtime-\" + key + \".o\"\n    if !disk.exists(runtime) {\n      runtime_made = scratch + \"/runtime.o\"\n      mut jobs.push(\n        toolchain.CJob {\n          source: home + \"/runtime/runtime.c\",\n          out: runtime_made,\n          flags,\n        },\n      )\n    }\n  }\n  // a package's own C and C++, each file on its own (archives and objects\n  // linked as they are)\n  mut made := []\n  mut native_made := []\n  match native {\n    Some(n) => {\n      for s in n.sources {\n        if [\".c\", \".cpp\", \".cc\", \".m\"].any(x -> ends_with(s, x)) {\n          flags := [\"-O2\"] + n.includes\n          key := toolchain.files_key(\n            join([\"native\", cc] + flags, \" \"),\n            [s],\n          )\n          o := kept + \"/native-\" + key + \".o\"\n          if !disk.exists(o) {\n            mut jobs.push(\n              toolchain.CJob {\n                source: s,\n                out: scratch + \"/native-\" + key + \".o\",\n                flags,\n              },\n            )\n            mut native_made.push(key)\n          }\n          mut made.push(o)\n        } else {\n          mut made.push(s)\n        }\n      }\n    },\n    None => (),\n  }\n  // the program's objects and core.rt's, while the C compiler runs (its\n  // phase in `--timings` is the time waited for it after)\n  both := if len(jobs) == 0 {\n    (\n      program_objects(mut disk, sh, ir, scratch, kept, opt, release),\n      Ok(()),\n    )\n  } else {\n    scope {\n      c := spawn toolchain.c_objects(launcher, cc, jobs)\n      p := program_objects(mut disk, sh, ir, scratch, kept, opt, release)\n      timings.begin(\"C compiler: compile\")\n      r := await c\n      timings.end(\"C compiler: compile\")\n      (p, r)\n    }\n  }\n  objects_rt := match both.0 {\n    Ok(o) => o,\n    Err(e) => return Err(e),\n  }\n  match both.1 {\n    Ok(_) => (),\n    Err(e) => return Err(e),\n  }\n  if len(jobs) > 0 {\n    cache.make_dirs(mut disk, kept)\n  }\n  if runtime_made != \"\" {\n    match mut disk.rename(runtime_made, runtime) {\n      Ok(_) => (),\n      Err(_) => {\n        runtime = runtime_made\n      },\n    }\n  }\n  for key in native_made {\n    o := kept + \"/native-\" + key + \".o\"\n    match mut disk.rename(scratch + \"/native-\" + key + \".o\", o) {\n      Ok(_) => (),\n      Err(_) => return Err(\"can't keep \" + o),\n    }\n  }\n  // the hash of the sources it is built from, as an object of its own (a\n  // global in the program's IR would keep it from being cut into parts)\n  sources := match sources_object(disk, home, path, kept) {\n    Ok(o) => o,\n    Err(e) => return Err(e),\n  }\n  objects := objects_rt\n    + [runtime, sources]\n    + match lib {\n      Some(l) => [l.object],\n      None => [],\n    }\n  // std's C libraries (std.sqlite's libsqlite3: the system's, through a stub\n  // beside libSystem's for lld), named to every link but kept only by the\n  // executables that call them (`-dead_strip_dylibs`)\n  std_links := std_native_libs(disk).map(l -> \"-l\" + l)\n  // (a library exports only what its `derive`s export, and the runtime's\n  // `strata_string_free` for the strings they return. The program's other\n  // functions, std's and the runtime's are hidden, so two Strata libraries\n  // can be loaded in one process.)\n  mut exported := []\n  if library {\n    for s in library_exports(ir) + [\"strata_string_free\"] {\n      mut exported.push(\"_\" + s)\n    }\n  }\n  mut export_flags := []\n  for s in exported {\n    export_flags += [\"-exported_symbol\", s]\n  }\n  done := match native {\n    None => if library {\n      toolchain.shared_library(\n        mut disk,\n        objects + std_links + export_flags,\n        out,\n        system_dir(disk, home),\n        \"@rpath/\" + path_base(out),\n      )\n    } else {\n      toolchain.link(\n        mut disk,\n        objects + std_links + [\"-dead_strip_dylibs\"],\n        out,\n        system_dir(disk, home),\n      )\n    },\n    Some(n) => if library {\n      toolchain.c_shared_library(\n        mut launcher,\n        cc,\n        objects + made,\n        out,\n        n.links\n          + std_links\n          + [\"-install_name\", \"@rpath/\" + path_base(out)]\n          + exported.map(s -> \"-Wl,-exported_symbol,\" + s),\n      )\n    } else {\n      libs := n.links.filter(x -> x != \"-lm\")\n        + std_links\n        + [\"-Wl,-dead_strip_dylibs\"]\n      exe_key := toolchain.link_key([cc] + objects + made + libs)\n      exe := kept + \"/exe-\" + cache.content_key([out])\n      had := match disk.read(exe + \".key\") {\n        Ok(k) => k,\n        Err(_) => \"\",\n      }\n      if cache.caching() && had == exe_key && toolchain.clone(exe, out) {\n        Ok(())\n      } else {\n        r := toolchain.c_link(\n          mut launcher,\n          cc,\n          objects + made,\n          out,\n          libs,\n        )\n        if r is Ok && cache.caching() {\n          // (its key last: a key never names another executable)\n          match mut disk.remove(exe + \".key\") {\n            _ => (),\n          }\n          if toolchain.clone(out, exe) {\n            match mut disk.write(exe + \".key\", exe_key) {\n              _ => (),\n            }\n          }\n        }\n        r\n      }\n    },\n  }\n  match done {\n    Ok(_) => {\n      if library {\n        return match library_files(\n          mut disk,\n          ir,\n          out,\n          program_name_of(disk, path),\n        ) {\n          Ok(made) => Ok(f\"built {shown} and \"\n            + join(made, \", \")\n            + \" (compiler/codegen)\"),\n          Err(e) => Err(e),\n        }\n      }\n      // a compiler (it links c/cache.c, which reads `<executable>.identity`):\n      // its identity file beside it, as tools/bootstrap.sh writes one, so its\n      // runs don't each hash it\n      match native {\n        Some(n) => if n.sources.any(f -> ends_with(f, \"/c/cache.c\")) {\n          match cache.write_identity(out) {\n            _ => (),\n          }\n        },\n        None => (),\n      }\n      Ok(f\"built {shown} (compiler/codegen)\")\n    },\n    Err(e) => Err(e),\n  }\n}"},{"name":"code_snapshot_decls","kind":"fn","old":"6bd9c84705101065","new":"b0108c5a2e698169","interface_changed":false,"affected":[],"module":"","text":"/// The codebase at `root` as `std.code` sees it under `strata run`:\n/// - `fn $code_snapshot() -> Result[Snapshot, String]`: its definitions,\n/// each with what it uses and what uses it, and the package's log. `Err`\n/// when a file doesn't decode.\n/// - `fn $code_version() -> String`: a hash of its files.\n/// For codegen's `host_code_snapshot` and `host_code_version`.\nfn code_snapshot_decls(\n  disk: std.fs.Disk,\n  core: builtins.Core,\n  root: String,\n) -> List[ast.Decl] {\n  files := deps.module_files(disk, root)\n  version := cache.content_key(\n    [cache.files_part(root, files + [\"strata.log\"])],\n  )\n  label := disk.absolute(root) !! root\n  snapshot := match code_definitions(disk, core, root, files) {\n    Ok(defs) => {\n      log := match disk.read(root + \"/strata.log\") {\n        Ok(text) => codebase.parse_log(text),\n        Err(_) => [],\n      }\n      mut last := Dict[String, Int] {}\n      for (k, e) in enumerate(log) {\n        for c in e.changes {\n          mut last.insert(c.name, k)\n        }\n      }\n      entries := log.map(\n        e -> code_record(\"Entry\", [\n          (\"message\", ast.StrLit(e.message)),\n          (\"time\", code_some(ast.IntLit(e.time))),\n          (\"changes\", ast.ListExpr(e.changes.map(\n            c -> code_record(\"Change\", [\n              (\"name\", ast.StrLit(c.name)),\n              (\"what\", ast.StrLit(change_what(c))),\n            ]),\n          ))),\n        ]),\n      )\n      code_ok(code_record(\"Snapshot\", [\n        (\"version\", ast.StrLit(version)),\n        (\"label\", ast.StrLit(label)),\n        (\"definitions\", ast.ListExpr(\n          defs.map(d -> code_definition(d, get(last, d.name))),\n        )),\n        (\"errors\", ast.ListExpr([])),\n        (\"log\", ast.ListExpr(entries)),\n      ]))\n    },\n    Err(e) => ast.CtorExpr {\n      name: \"Err\",\n      args: ast.PositionalArgs([ast.StrLit(e)]),\n    },\n  }\n  snap_t := ast.Named { name: \"Result\", args: [\n    ast.Named { name: \"std.code.Snapshot\", args: [] },\n    ast.Named { name: \"String\", args: [] },\n  ] }\n  [code_fn(\"$code_snapshot\", snap_t, snapshot), code_fn(\n    \"$code_version\",\n    ast.Named { name: \"String\", args: [] },\n    ast.StrLit(version),\n  )]\n}","old_text":"/// The codebase at `root` as `std.code` sees it under `strata run`:\n/// - `fn $code_snapshot() -> Result[Snapshot, String]`: its definitions,\n/// each with what it uses and what uses it, and the package's log. `Err`\n/// when a file doesn't decode.\n/// - `fn $code_version() -> String`: a hash of its files.\n/// For codegen's `host_code_snapshot` and `host_code_version`.\nfn code_snapshot_decls(\n  disk: std.fs.Disk,\n  core: builtins.Core,\n  root: String,\n) -> List[ast.Decl] {\n  files := deps.module_files(disk, root)\n  version := cache.content_key(\n    [cache.files_part(disk, root, files + [\"strata.log\"])],\n  )\n  label := disk.absolute(root) !! root\n  snapshot := match code_definitions(disk, core, root, files) {\n    Ok(defs) => {\n      log := match disk.read(root + \"/strata.log\") {\n        Ok(text) => codebase.parse_log(text),\n        Err(_) => [],\n      }\n      mut last := Dict[String, Int] {}\n      for (k, e) in enumerate(log) {\n        for c in e.changes {\n          mut last.insert(c.name, k)\n        }\n      }\n      entries := log.map(\n        e -> code_record(\"Entry\", [\n          (\"message\", ast.StrLit(e.message)),\n          (\"time\", code_some(ast.IntLit(e.time))),\n          (\"changes\", ast.ListExpr(e.changes.map(\n            c -> code_record(\"Change\", [\n              (\"name\", ast.StrLit(c.name)),\n              (\"what\", ast.StrLit(change_what(c))),\n            ]),\n          ))),\n        ]),\n      )\n      code_ok(code_record(\"Snapshot\", [\n        (\"version\", ast.StrLit(version)),\n        (\"label\", ast.StrLit(label)),\n        (\"definitions\", ast.ListExpr(\n          defs.map(d -> code_definition(d, get(last, d.name))),\n        )),\n        (\"errors\", ast.ListExpr([])),\n        (\"log\", ast.ListExpr(entries)),\n      ]))\n    },\n    Err(e) => ast.CtorExpr {\n      name: \"Err\",\n      args: ast.PositionalArgs([ast.StrLit(e)]),\n    },\n  }\n  snap_t := ast.Named { name: \"Result\", args: [\n    ast.Named { name: \"std.code.Snapshot\", args: [] },\n    ast.Named { name: \"String\", args: [] },\n  ] }\n  [code_fn(\"$code_snapshot\", snap_t, snapshot), code_fn(\n    \"$code_version\",\n    ast.Named { name: \"String\", args: [] },\n    ast.StrLit(version),\n  )]\n}"},{"name":"sources_object","kind":"fn","old":"68184322f64fe222","new":"a291481e93be93c6","interface_changed":false,"affected":[],"module":"","text":"/// The object `strata build` links into every executable (`linked`): the\n/// hash of the sources it is built from, as the global\n/// `strata_build_sources` (which c/cache.c reads in a compiler:\n/// `cache.build_sources`). Cached in `kept` under the hash.\n/// \n/// The sources are the program at `path` (a package's module files and its\n/// own C, or a script), std's and core's files, the prelude and the C\n/// runtime in `home`: all the code the executable runs. Two executables\n/// with the same hash, built by a correct compiler, behave the same.\nfn sources_object(\n  disk: std.fs.Disk,\n  home: String,\n  path: String,\n  kept: String,\n) -> Result[String, String] {\n  mut d := disk\n  own := if ends_with(path, \".strata\") {\n    dir := driver.parent_dir(path)\n    cache.files_part(\n      dir,\n      [byte_slice(path, byte_len(dir) + 1, byte_len(path))],\n    )\n  } else {\n    native := match deps.native_parts(disk, path) {\n      Ok(Some(n)) => n.sources\n        .filter(f -> starts_with(f, path + \"/\"))\n        .map(f -> byte_slice(f, byte_len(path) + 1, byte_len(f))),\n      _ => [],\n    }\n    cache.files_part(path, deps.module_files(disk, path) + native)\n  }\n  h := cache.content_key([own, cache.files_part(\n    home + \"/std\",\n    deps.module_files(disk, home + \"/std\"),\n  ), cache.files_part(\n    home,\n    core_files() + [\"runtime/prelude.strata\", \"runtime/runtime.c\"],\n  )])\n  o := kept + \"/sources-\" + h + \".o\"\n  if disk.exists(o) {\n    return Ok(o)\n  }\n  cache.make_dirs(mut d, kept)\n  tmp := o + \".\" + f\"{driver_pid().to_int()}\"\n  ir := \"@strata_build_sources = constant [65 x i8] c\\\"\" + h + \"\\00\\\"\\n\"\n  match toolchain.object(ir, tmp, 0) {\n    Ok(_) => (),\n    Err(e) => return Err(e),\n  }\n  match mut d.rename(tmp, o) {\n    Ok(_) => Ok(o),\n    Err(_) => Ok(tmp),\n  }\n}","old_text":"/// The object `strata build` links into every executable (`linked`): the\n/// hash of the sources it is built from, as the global\n/// `strata_build_sources` (which c/cache.c reads in a compiler:\n/// `cache.build_sources`). Cached in `kept` under the hash.\n/// \n/// The sources are the program at `path` (a package's module files and its\n/// own C, or a script), std's and core's files, the prelude and the C\n/// runtime in `home`: all the code the executable runs. Two executables\n/// with the same hash, built by a correct compiler, behave the same.\nfn sources_object(\n  disk: std.fs.Disk,\n  home: String,\n  path: String,\n  kept: String,\n) -> Result[String, String] {\n  mut d := disk\n  own := if ends_with(path, \".strata\") {\n    dir := driver.parent_dir(path)\n    cache.files_part(\n      disk,\n      dir,\n      [byte_slice(path, byte_len(dir) + 1, byte_len(path))],\n    )\n  } else {\n    native := match deps.native_parts(disk, path) {\n      Ok(Some(n)) => n.sources\n        .filter(f -> starts_with(f, path + \"/\"))\n        .map(f -> byte_slice(f, byte_len(path) + 1, byte_len(f))),\n      _ => [],\n    }\n    cache.files_part(\n      disk,\n      path,\n      deps.module_files(disk, path) + native,\n    )\n  }\n  h := cache.content_key([own, cache.files_part(\n    disk,\n    home + \"/std\",\n    deps.module_files(disk, home + \"/std\"),\n  ), cache.files_part(\n    disk,\n    home,\n    core_files() + [\"runtime/prelude.strata\", \"runtime/runtime.c\"],\n  )])\n  o := kept + \"/sources-\" + h + \".o\"\n  if disk.exists(o) {\n    return Ok(o)\n  }\n  cache.make_dirs(mut d, kept)\n  tmp := o + \".\" + f\"{driver_pid().to_int()}\"\n  ir := \"@strata_build_sources = constant [65 x i8] c\\\"\" + h + \"\\00\\\"\\n\"\n  match toolchain.object(mut d, ir, tmp, 0) {\n    Ok(_) => (),\n    Err(e) => return Err(e),\n  }\n  match mut d.rename(tmp, o) {\n    Ok(_) => Ok(o),\n    Err(_) => Ok(tmp),\n  }\n}"},{"name":"core_rt_object","kind":"fn","old":"3c7697ecafeac862","new":"8f9bec13dee95b94","interface_changed":false,"affected":[],"module":"","text":"/// core.rt's object (compiled by compiler/codegen, then LLVM at -O2),\n/// cached by its IR (`core-rt/KEY.o`, `KEY` its SHA-256 with\n/// `toolchain.object_settings`). Which IR this compiler makes of this core\n/// is cached too (`core-rt-of/KEY`: the sources it was built from,\n/// `maker_key`, and core's and the prelude's code, `sh.stamp`), so a new\n/// compiler compiles it again only when it makes other IR of it. In\n/// `scratch` when nothing is cached.\nfn core_rt_object(\n  disk: std.fs.Disk,\n  sh: Shared,\n  scratch: String,\n) -> Result[String, String] {\n  mut d := disk\n  made_of := if sh.stamp == \"\" {\n    \"\"\n  } else {\n    \"core-rt-of/\" + maker_key(\"core-rt\", [sh.stamp])\n  }\n  kept := (key: String) ->\n    cache.find_entry(disk, sh.cache, \"core-rt/\" + key + \".o\")\n  if made_of != \"\" {\n    match cache.read_entry(disk, sh.cache, made_of) {\n      Some(key) => match kept(key) {\n        Some(o) => return Ok(o),\n        None => (),\n      },\n      None => (),\n    }\n  }\n  text := codegen_with(disk, sh, [\"--core-rt\"], [])\n  match driver.codegen_errors(text) {\n    [e, ..] => return Err(\"compiler/codegen can't compile core.rt: \" + e),\n    _ => (),\n  }\n  if made_of == \"\" {\n    o := scratch + \"/core_rt.o\"\n    return match toolchain.object(text, o, 2) {\n      Ok(_) => Ok(o),\n      Err(e) => Err(e),\n    }\n  }\n  key := cache.content_key([\n    \"core.rt\",\n    cache.text_sha256_hex(text),\n    toolchain.object_settings(2),\n  ])\n  match kept(key) {\n    Some(o) => {\n      match cache.write_entry(mut d, sh.cache, made_of, key) {\n        _ => (),\n      }\n      return Ok(o)\n    },\n    None => (),\n  }\n  o := cache.own_path(mut d, sh.cache, \"core-rt/\" + key + \".o\")\n  // (to a file of its own, renamed when done: another process may be\n  // making it too)\n  tmp := o + \".\" + f\"{driver_pid().to_int()}\"\n  match toolchain.object(text, tmp, 2) {\n    Ok(_) => (),\n    Err(e) => return Err(e),\n  }\n  match mut d.rename(tmp, o) {\n    _ => (),\n  }\n  match cache.write_entry(mut d, sh.cache, made_of, key) {\n    _ => (),\n  }\n  Ok(o)\n}","old_text":"/// core.rt's object (compiled by compiler/codegen, then LLVM at -O2),\n/// cached by its IR (`core-rt/KEY.o`, `KEY` its SHA-256 with\n/// `toolchain.object_settings`). Which IR this compiler makes of this core\n/// is cached too (`core-rt-of/KEY`: the sources it was built from,\n/// `maker_key`, and core's and the prelude's code, `sh.stamp`), so a new\n/// compiler compiles it again only when it makes other IR of it. In\n/// `scratch` when nothing is cached.\nfn core_rt_object(\n  disk: std.fs.Disk,\n  sh: Shared,\n  scratch: String,\n) -> Result[String, String] {\n  mut d := disk\n  made_of := if sh.stamp == \"\" {\n    \"\"\n  } else {\n    \"core-rt-of/\" + maker_key(\"core-rt\", [sh.stamp])\n  }\n  kept := (key: String) ->\n    cache.find_entry(disk, sh.cache, \"core-rt/\" + key + \".o\")\n  if made_of != \"\" {\n    match cache.read_entry(disk, sh.cache, made_of) {\n      Some(key) => match kept(key) {\n        Some(o) => return Ok(o),\n        None => (),\n      },\n      None => (),\n    }\n  }\n  text := codegen_with(disk, sh, [\"--core-rt\"], [])\n  match driver.codegen_errors(text) {\n    [e, ..] => return Err(\"compiler/codegen can't compile core.rt: \" + e),\n    _ => (),\n  }\n  if made_of == \"\" {\n    o := scratch + \"/core_rt.o\"\n    return match toolchain.object(mut d, text, o, 2) {\n      Ok(_) => Ok(o),\n      Err(e) => Err(e),\n    }\n  }\n  key := cache.content_key([\n    \"core.rt\",\n    cache.text_sha256_hex(text),\n    toolchain.object_settings(2),\n  ])\n  match kept(key) {\n    Some(o) => {\n      match cache.write_entry(mut d, sh.cache, made_of, key) {\n        _ => (),\n      }\n      return Ok(o)\n    },\n    None => (),\n  }\n  o := cache.own_path(mut d, sh.cache, \"core-rt/\" + key + \".o\")\n  // (to a file of its own, renamed when done: another process may be\n  // making it too)\n  tmp := o + \".\" + f\"{driver_pid().to_int()}\"\n  match toolchain.object(mut d, text, tmp, 2) {\n    Ok(_) => (),\n    Err(e) => return Err(e),\n  }\n  match mut d.rename(tmp, o) {\n    _ => (),\n  }\n  match cache.write_entry(mut d, sh.cache, made_of, key) {\n    _ => (),\n  }\n  Ok(o)\n}"},{"name":"program_objects","kind":"fn","old":"892ff908c6cfcc7e","new":"102cb74dfcc376cd","interface_changed":false,"affected":[],"module":"","text":"/// Compiles `ir` to objects at `opt`, in parts cached in `kept`\n/// (`toolchain.objects`), then adds core.rt's object (`core_rt_object`)\n/// unless the runtime is a release's (`release`: core.rt is in it).\nfn program_objects(\n  mut disk: std.fs.Disk,\n  sh: Shared,\n  ir: String,\n  scratch: String,\n  kept: String,\n  opt: Int,\n  release: Bool,\n) -> Result[List[String], String] {\n  program := match toolchain.objects(ir, scratch, kept, opt) {\n    Ok(o) => o.files,\n    Err(e) => return Err(e),\n  }\n  if release {\n    return Ok(program)\n  }\n  match core_rt_object(disk, sh, scratch) {\n    Ok(o) => Ok(program + [o]),\n    Err(e) => Err(e),\n  }\n}","old_text":"/// Compiles `ir` to objects at `opt`, in parts cached in `kept`\n/// (`toolchain.objects`), then adds core.rt's object (`core_rt_object`)\n/// unless the runtime is a release's (`release`: core.rt is in it).\nfn program_objects(\n  mut disk: std.fs.Disk,\n  sh: Shared,\n  ir: String,\n  scratch: String,\n  kept: String,\n  opt: Int,\n  release: Bool,\n) -> Result[List[String], String] {\n  program := match toolchain.objects(mut disk, ir, scratch, kept, opt) {\n    Ok(o) => o.files,\n    Err(e) => return Err(e),\n  }\n  if release {\n    return Ok(program)\n  }\n  match core_rt_object(disk, sh, scratch) {\n    Ok(o) => Ok(program + [o]),\n    Err(e) => Err(e),\n  }\n}"},{"name":"repl_command","kind":"fn","old":"8ebae567d786457b","new":"228a2502b2249caa","interface_changed":false,"affected":[],"module":"","text":"/// `strata repl [--file F]`: an interactive session on the package around\n/// the current folder (or F). Each line is one of:\n/// - an expression\n/// - a binding (`x := e`, `mut x := e`, `x = e`)\n/// - a definition (`fn`, `type`, `trait`, `impl`), the session's until\n/// `:save NAME` writes it\n/// - a command (`:type e`, `:view NAME`, `:save NAME`, `:reload`, `:quit`)\n/// When standard input isn't a terminal, each line is read in turn, as if\n/// typed.\nfn repl_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  line: driver.Args,\n  cwd: String,\n) -> std.process.ExitCode {\n  path := match target_of(disk, line, cwd) {\n    Ok(f) => f,\n    Err(e) => return fail_with(mut console, e),\n  }\n  // (`--allow files,process`: the real capabilities, else the REPL's own)\n  mut allow := []\n  for a in get(line.flags, \"--allow\") ?? [] {\n    for x in split(a, \",\") {\n      w := trim(x)\n      if w != \"files\" && w != \"process\" {\n        return fail_with(\n          mut console,\n          f\"`--allow` takes `files` or `process` (comma-separated), not `{w}`\",\n        )\n      }\n      mut allow.push(w)\n    }\n  }\n  // (std's precompiled library loaded once: a line compiles only the std\n  // code that isn't in it)\n  pre := match std_library(mut console, mut disk, process, cache) {\n    Some(l) => if jit_load(l.shared).to_int() == 0 {\n      match disk.read(l.names) {\n        Ok(text) => split(text, \"\\n\").filter(x -> x != \"\"),\n        Err(_) => [],\n      }\n    } else {\n      []\n    },\n    None => [],\n  }\n  mut s := match repl_load(\n    mut launcher,\n    mut disk,\n    cache,\n    path,\n    pre,\n    allow,\n    (process.current_dir(), cwd),\n  ) {\n    Ok(x) => x,\n    Err(e) => return fail_with(mut console, e),\n  }\n  interactive := console.interactive()\n  if interactive {\n    mut console.print(\n      \"strata repl: an expression, `x := e`, a definition; :type e, :view NAME, :save NAME, :reload, :quit\",\n    )\n  }\n  mut failed := false\n  // (the REPL's own folder, in memory, unless the real one is allowed: a\n  // value of the session's, bound first)\n  mut pending := if contains(allow, \"files\") {\n    []\n  } else {\n    [\"mut disk := std.fs.mem_files([])\"]\n  }\n  loop {\n    quiet := pending != []\n    got := match pending {\n      [first, ..rest] => {\n        pending = rest\n        Some(first)\n      },\n      [] => repl_input(mut console, interactive),\n    }\n    if got == None {\n      break\n    }\n    text := trim(got ?? \"\")\n    if text == \"\" || starts_with(text, \"//\") && !contains(text, \"\\n\") {\n      continue\n    }\n    if text == \":quit\" || text == \":q\" {\n      break\n    }\n    if text == \":reload\" {\n      match repl_load(\n        mut launcher,\n        mut disk,\n        cache,\n        path,\n        s.pre,\n        s.allow,\n        s.dirs,\n      ) {\n        Ok(fresh) => {\n          // (each value kept whose type means what it meant)\n          (next, dropped) := repl_rebound(s, ReplSession { ..fresh, defs: s.defs })\n          s = next\n          for n in dropped {\n            mut console.print(f\"dropped `{n}`: its type changed\")\n          }\n          mut console.print(\"reloaded\")\n        },\n        Err(e) => {\n          failed = true\n          mut console.eprint(\"error: \" + e)\n        },\n      }\n      continue\n    }\n    // `:save NAME`: the session's definition written to the package, as\n    // `strata add` writes a file (checked, and logged in a package)\n    if starts_with(text, \":save \") {\n      name := trim(byte_slice(text, 6, byte_len(text)))\n      saved := s.defs.filter(d -> desugar.decl_name(d) == name)\n      if saved == [] {\n        failed = true\n        mut console.eprint(\n          f\"error: no definition `{name}` typed in this session\",\n        )\n        continue\n      }\n      tmp := (process.var(\"TMPDIR\") ?? \"/tmp\")\n        + f\"/strata-repl-{driver_pid().to_int()}.st\"\n      match mut disk.write(\n        tmp,\n        join(saved.map(d -> text.decl_text(d)), \"\\n\\n\") + \"\\n\",\n      ) {\n        Ok(_) => (),\n        Err(e) => {\n          failed = true\n          mut console.eprint(f\"error: {e}\")\n          continue\n        },\n      }\n      code := if disk.exists(s.path + \"/strata.toml\") {\n        // (in the package's folder, as `strata add` runs)\n        _ := driver_chdir(s.path)\n        c := edit_command(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          clock,\n          cache,\n          [tmp, \"-m\", f\"repl: save {name}\"],\n          \"add\",\n        )\n        _ := driver_chdir(s.dirs.0)\n        c\n      } else {\n        edit_file(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          s.path,\n          [tmp],\n          \"add\",\n        )\n      }\n      match mut disk.remove(tmp) {\n        _ => (),\n      }\n      if code != 0 {\n        failed = true\n        continue\n      }\n      // (the package as it is now: read again, without the session's)\n      match repl_load(\n        mut launcher,\n        mut disk,\n        cache,\n        s.path,\n        s.pre,\n        s.allow,\n        s.dirs,\n      ) {\n        Ok(fresh) => {\n          (next, _) := repl_rebound(\n            s,\n            ReplSession { ..fresh, defs: s.defs.filter(d -> desugar.decl_name(d) != name) },\n          )\n          s = next\n        },\n        Err(e) => {\n          failed = true\n          mut console.eprint(\"error: \" + e)\n        },\n      }\n      continue\n    }\n    if starts_with(text, \":view \") {\n      name := trim(byte_slice(text, 6, byte_len(text)))\n      shown := (s.defs + s.own).filter(\n        d -> desugar.decl_name(d) == name\n          || qualified_name(d.module, desugar.decl_name(d)) == name,\n      )\n      match shown {\n        [d, ..] => mut console.print(text.decl_text(d)),\n        [] => {\n          failed = true\n          mut console.eprint(f\"error: no definition `{name}`\")\n        },\n      }\n      continue\n    }\n    typing := starts_with(text, \":type \")\n    if starts_with(text, \":\") && !typing {\n      failed = true\n      mut console.eprint(\n        f\"error: unknown command `{text}` (:type e, :view NAME, :save NAME, :reload, :quit)\",\n      )\n      continue\n    }\n    src := if typing {\n      trim(byte_slice(text, 6, byte_len(text)))\n    } else {\n      text\n    }\n    // a definition: the session's, replacing one of the same name\n    if [\n      \"fn \",\n      \"type \",\n      \"trait \",\n      \"impl \",\n      \"impl[\",\n      \"capability \",\n      \"///\",\n    ].any(\n      k -> starts_with(src, k),\n    ) {\n      match parse.parse_program(src) {\n        Ok(ds) => {\n          new_names := ds.map(d -> desugar.decl_name(d))\n          tried := ReplSession { ..s, defs: s.defs.filter(\n              d -> !contains(new_names, desugar.decl_name(d)),\n            )\n            + ds.map(d -> ast.Decl { ..d, module: \"\" }) }\n          // (the values of a type it changes are let go of)\n          (kept, dropped) := repl_rebound(s, tried)\n          match repl_eval(disk, kept, [], ast.UnitExpr, false) {\n            Ok(_) => {\n              s = kept\n              for n in dropped {\n                mut console.print(f\"dropped `{n}`: its type changed\")\n              }\n              mut console.print(\n                \"defined \"\n                  + join(new_names.map(n -> f\"`{n}`\"), \", \"),\n              )\n            },\n            Err(why) => {\n              failed = true\n              mut console.eprint(\"error: \" + why)\n            },\n          }\n        },\n        Err(why) => {\n          failed = true\n          mut console.eprint(\"error: \" + why)\n        },\n      }\n      continue\n    }\n    match repl_line(src) {\n      Ok((stmts, e, bound)) => match repl_eval(disk, s, stmts, e, !typing) {\n        Ok(r) => if typing {\n          mut console.print(text.type_text(r.ty))\n        } else {\n          if r.printed != \"\" {\n            mut console.write(r.printed)\n          }\n          match r.fault {\n            Some(why) => {\n              failed = true\n              mut console.eprint(why)\n              continue\n            },\n            None => (),\n          }\n          // (the values let go of were dropped by the line)\n          s = ReplSession { ..s, free: s.free + s.retired.map(x -> x.0), retired: [] }\n          match bound {\n            Some((n, m)) => {\n              (k, s1) := repl_slot(s)\n              if k < 0\n                || k >= 4000\n                || jit_repl_set_word(to_i64(k), r.word).to_int() != 0 {\n                failed = true\n                mut console.eprint(\n                  \"error: the session holds too many values\",\n                )\n                continue\n              }\n              old := s1.binds.filter(b -> b.name == n)\n              s = ReplSession { ..s1, binds: s1.binds.filter(b -> b.name != n)\n                + [ReplBinding {\n                  name: n,\n                  mutable: m,\n                  ty: r.ty,\n                  slot: k,\n                }], retired: s1.retired + old.map(b -> (b.slot, b.ty)) }\n              if !quiet {\n                mut console.print(\n                  match r.value {\n                    Some(v) => f\"{n}: {text.type_text(r.ty)} = {text.expr_text(v, 0)}\",\n                    None => f\"{n}: {text.type_text(r.ty)}\",\n                  },\n                )\n              }\n            },\n            None => if r.ty != ast.UnitType {\n              mut console.print(\n                match r.value {\n                  Some(v) => f\"{text.expr_text(v, 0)}: {text.type_text(r.ty)}\",\n                  None => f\"<{text.type_text(r.ty)}>\",\n                },\n              )\n              // (the result is let go of)\n              (k, s1) := repl_slot(s)\n              if k >= 0\n                && k < 4000\n                && jit_repl_set_word(to_i64(k), r.word).to_int() == 0 {\n                s = ReplSession { ..s1, retired: s1.retired + [(k, r.ty)] }\n              }\n            },\n          }\n        },\n        Err(why) => {\n          failed = true\n          mut console.eprint(\"error: \" + why)\n        },\n      },\n      Err(why) => {\n        failed = true\n        mut console.eprint(\"error: \" + why)\n      },\n    }\n  }\n  // (piped: an input that failed fails the run)\n  if failed && !interactive {\n    1\n  } else {\n    0\n  }\n}","old_text":"/// `strata repl [--file F]`: an interactive session on the package around\n/// the current folder (or F). Each line is one of:\n/// - an expression\n/// - a binding (`x := e`, `mut x := e`, `x = e`)\n/// - a definition (`fn`, `type`, `trait`, `impl`), the session's until\n/// `:save NAME` writes it\n/// - a command (`:type e`, `:view NAME`, `:save NAME`, `:reload`, `:quit`)\n/// When standard input isn't a terminal, each line is read in turn, as if\n/// typed.\nfn repl_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  line: driver.Args,\n  cwd: String,\n) -> std.process.ExitCode {\n  path := match target_of(disk, line, cwd) {\n    Ok(f) => f,\n    Err(e) => return fail_with(mut console, e),\n  }\n  // (`--allow files,process`: the real capabilities, else the REPL's own)\n  mut allow := []\n  for a in get(line.flags, \"--allow\") ?? [] {\n    for x in split(a, \",\") {\n      w := trim(x)\n      if w != \"files\" && w != \"process\" {\n        return fail_with(\n          mut console,\n          f\"`--allow` takes `files` or `process` (comma-separated), not `{w}`\",\n        )\n      }\n      mut allow.push(w)\n    }\n  }\n  // (std's precompiled library loaded once: a line compiles only the std\n  // code that isn't in it)\n  pre := match std_library(mut console, mut disk, process, mut launcher, cache) {\n    Some(l) => if jit_load(l.shared).to_int() == 0 {\n      match disk.read(l.names) {\n        Ok(text) => split(text, \"\\n\").filter(x -> x != \"\"),\n        Err(_) => [],\n      }\n    } else {\n      []\n    },\n    None => [],\n  }\n  mut s := match repl_load(\n    mut launcher,\n    mut disk,\n    cache,\n    path,\n    pre,\n    allow,\n    (process.current_dir(), cwd),\n  ) {\n    Ok(x) => x,\n    Err(e) => return fail_with(mut console, e),\n  }\n  interactive := console.interactive()\n  if interactive {\n    mut console.print(\n      \"strata repl: an expression, `x := e`, a definition; :type e, :view NAME, :save NAME, :reload, :quit\",\n    )\n  }\n  mut failed := false\n  // (the REPL's own folder, in memory, unless the real one is allowed: a\n  // value of the session's, bound first)\n  mut pending := if contains(allow, \"files\") {\n    []\n  } else {\n    [\"mut disk := std.fs.mem_files([])\"]\n  }\n  loop {\n    quiet := pending != []\n    got := match pending {\n      [first, ..rest] => {\n        pending = rest\n        Some(first)\n      },\n      [] => repl_input(mut console, interactive),\n    }\n    if got == None {\n      break\n    }\n    text := trim(got ?? \"\")\n    if text == \"\" || starts_with(text, \"//\") && !contains(text, \"\\n\") {\n      continue\n    }\n    if text == \":quit\" || text == \":q\" {\n      break\n    }\n    if text == \":reload\" {\n      match repl_load(\n        mut launcher,\n        mut disk,\n        cache,\n        path,\n        s.pre,\n        s.allow,\n        s.dirs,\n      ) {\n        Ok(fresh) => {\n          // (each value kept whose type means what it meant)\n          (next, dropped) := repl_rebound(s, ReplSession { ..fresh, defs: s.defs })\n          s = next\n          for n in dropped {\n            mut console.print(f\"dropped `{n}`: its type changed\")\n          }\n          mut console.print(\"reloaded\")\n        },\n        Err(e) => {\n          failed = true\n          mut console.eprint(\"error: \" + e)\n        },\n      }\n      continue\n    }\n    // `:save NAME`: the session's definition written to the package, as\n    // `strata add` writes a file (checked, and logged in a package)\n    if starts_with(text, \":save \") {\n      name := trim(byte_slice(text, 6, byte_len(text)))\n      saved := s.defs.filter(d -> desugar.decl_name(d) == name)\n      if saved == [] {\n        failed = true\n        mut console.eprint(\n          f\"error: no definition `{name}` typed in this session\",\n        )\n        continue\n      }\n      tmp := (process.var(\"TMPDIR\") ?? \"/tmp\")\n        + f\"/strata-repl-{driver_pid().to_int()}.st\"\n      match mut disk.write(\n        tmp,\n        join(saved.map(d -> text.decl_text(d)), \"\\n\\n\") + \"\\n\",\n      ) {\n        Ok(_) => (),\n        Err(e) => {\n          failed = true\n          mut console.eprint(f\"error: {e}\")\n          continue\n        },\n      }\n      code := if disk.exists(s.path + \"/strata.toml\") {\n        // (in the package's folder, as `strata add` runs)\n        _ := driver_chdir(s.path)\n        c := edit_command(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          clock,\n          cache,\n          [tmp, \"-m\", f\"repl: save {name}\"],\n          \"add\",\n        )\n        _ := driver_chdir(s.dirs.0)\n        c\n      } else {\n        edit_file(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          s.path,\n          [tmp],\n          \"add\",\n        )\n      }\n      match mut disk.remove(tmp) {\n        _ => (),\n      }\n      if code != 0 {\n        failed = true\n        continue\n      }\n      // (the package as it is now: read again, without the session's)\n      match repl_load(\n        mut launcher,\n        mut disk,\n        cache,\n        s.path,\n        s.pre,\n        s.allow,\n        s.dirs,\n      ) {\n        Ok(fresh) => {\n          (next, _) := repl_rebound(\n            s,\n            ReplSession { ..fresh, defs: s.defs.filter(d -> desugar.decl_name(d) != name) },\n          )\n          s = next\n        },\n        Err(e) => {\n          failed = true\n          mut console.eprint(\"error: \" + e)\n        },\n      }\n      continue\n    }\n    if starts_with(text, \":view \") {\n      name := trim(byte_slice(text, 6, byte_len(text)))\n      shown := (s.defs + s.own).filter(\n        d -> desugar.decl_name(d) == name\n          || qualified_name(d.module, desugar.decl_name(d)) == name,\n      )\n      match shown {\n        [d, ..] => mut console.print(text.decl_text(d)),\n        [] => {\n          failed = true\n          mut console.eprint(f\"error: no definition `{name}`\")\n        },\n      }\n      continue\n    }\n    typing := starts_with(text, \":type \")\n    if starts_with(text, \":\") && !typing {\n      failed = true\n      mut console.eprint(\n        f\"error: unknown command `{text}` (:type e, :view NAME, :save NAME, :reload, :quit)\",\n      )\n      continue\n    }\n    src := if typing {\n      trim(byte_slice(text, 6, byte_len(text)))\n    } else {\n      text\n    }\n    // a definition: the session's, replacing one of the same name\n    if [\n      \"fn \",\n      \"type \",\n      \"trait \",\n      \"impl \",\n      \"impl[\",\n      \"capability \",\n      \"///\",\n    ].any(\n      k -> starts_with(src, k),\n    ) {\n      match parse.parse_program(src) {\n        Ok(ds) => {\n          new_names := ds.map(d -> desugar.decl_name(d))\n          tried := ReplSession { ..s, defs: s.defs.filter(\n              d -> !contains(new_names, desugar.decl_name(d)),\n            )\n            + ds.map(d -> ast.Decl { ..d, module: \"\" }) }\n          // (the values of a type it changes are let go of)\n          (kept, dropped) := repl_rebound(s, tried)\n          match repl_eval(disk, kept, [], ast.UnitExpr, false) {\n            Ok(_) => {\n              s = kept\n              for n in dropped {\n                mut console.print(f\"dropped `{n}`: its type changed\")\n              }\n              mut console.print(\n                \"defined \"\n                  + join(new_names.map(n -> f\"`{n}`\"), \", \"),\n              )\n            },\n            Err(why) => {\n              failed = true\n              mut console.eprint(\"error: \" + why)\n            },\n          }\n        },\n        Err(why) => {\n          failed = true\n          mut console.eprint(\"error: \" + why)\n        },\n      }\n      continue\n    }\n    match repl_line(src) {\n      Ok((stmts, e, bound)) => match repl_eval(disk, s, stmts, e, !typing) {\n        Ok(r) => if typing {\n          mut console.print(text.type_text(r.ty))\n        } else {\n          if r.printed != \"\" {\n            mut console.write(r.printed)\n          }\n          match r.fault {\n            Some(why) => {\n              failed = true\n              mut console.eprint(why)\n              continue\n            },\n            None => (),\n          }\n          // (the values let go of were dropped by the line)\n          s = ReplSession { ..s, free: s.free + s.retired.map(x -> x.0), retired: [] }\n          match bound {\n            Some((n, m)) => {\n              (k, s1) := repl_slot(s)\n              if k < 0\n                || k >= 4000\n                || jit_repl_set_word(to_i64(k), r.word).to_int() != 0 {\n                failed = true\n                mut console.eprint(\n                  \"error: the session holds too many values\",\n                )\n                continue\n              }\n              old := s1.binds.filter(b -> b.name == n)\n              s = ReplSession { ..s1, binds: s1.binds.filter(b -> b.name != n)\n                + [ReplBinding {\n                  name: n,\n                  mutable: m,\n                  ty: r.ty,\n                  slot: k,\n                }], retired: s1.retired + old.map(b -> (b.slot, b.ty)) }\n              if !quiet {\n                mut console.print(\n                  match r.value {\n                    Some(v) => f\"{n}: {text.type_text(r.ty)} = {text.expr_text(v, 0)}\",\n                    None => f\"{n}: {text.type_text(r.ty)}\",\n                  },\n                )\n              }\n            },\n            None => if r.ty != ast.UnitType {\n              mut console.print(\n                match r.value {\n                  Some(v) => f\"{text.expr_text(v, 0)}: {text.type_text(r.ty)}\",\n                  None => f\"<{text.type_text(r.ty)}>\",\n                },\n              )\n              // (the result is let go of)\n              (k, s1) := repl_slot(s)\n              if k >= 0\n                && k < 4000\n                && jit_repl_set_word(to_i64(k), r.word).to_int() == 0 {\n                s = ReplSession { ..s1, retired: s1.retired + [(k, r.ty)] }\n              }\n            },\n          }\n        },\n        Err(why) => {\n          failed = true\n          mut console.eprint(\"error: \" + why)\n        },\n      },\n      Err(why) => {\n        failed = true\n        mut console.eprint(\"error: \" + why)\n      },\n    }\n  }\n  // (piped: an input that failed fails the run)\n  if failed && !interactive {\n    1\n  } else {\n    0\n  }\n}"},{"name":"static_graph","kind":"fn","old":"d0617da43b6e03b1","new":"1c2980db04abc316","interface_changed":false,"affected":[],"module":"","text":"/// The graph of `subject` in the program `stored` (the definitions `file`\n/// holds, or held). Each site's questions (compiler/graph's `plan`) are\n/// encoded by compiler/smt as `ensures` of a copy of the function and given\n/// to the solver. Each site's answers are cached under the program's text\n/// and the copy's (`graph-site`), so only what changed is asked again.\n/// Adds the moves the bodies' shape settles and those that follow calls\n/// (`resolved`). With `runs` (`stored` being what `file` holds), what the\n/// solver leaves unknown is run on generated inputs too (`graph_runs`,\n/// with std's library).\nfn static_graph(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  cache: cache.Cache,\n  file: String,\n  stored: List[ast.Decl],\n  subject: graph.Subject,\n  runs: Bool,\n) -> Result[graph.Graph, String] {\n  home := match home_found(disk, process) {\n    Some(h) => h,\n    None => return Err(\n      \"can't find Strata's home (a folder holding core/, std/ and runtime/prelude.strata): set STRATA_HOME\",\n    ),\n  }\n  if driver_chdir(home).to_int() != 0 {\n    return Err(f\"can't enter {home}\")\n  }\n  solver := toolchain.solver(disk, process)\n  pl := graph.plan(stored, subject)\n  sites := pl.sites\n  program := join(stored.map(d -> d.module + \"\\n\" + text.decl_text(d)), \"\\n\")\n  key := (s: graph.Site) -> \"verify-strata/graphs/\"\n    + cache.entry_key(\n      \"graph-site\",\n      [solver, program, text.decl_text(s.decl), s.label, if !runs {\n        \"solver\"\n      } else {\n        \"solver, runs\"\n      }],\n    )\n  reuse := cache.caching() && solver != \"\"\n  mut edges := []\n  mut skipped := []\n  mut todo := []\n  for s in sites {\n    match if reuse {\n      cache.read_entry(disk, cache, key(s))\n    } else {\n      None\n    } {\n      Some(text) => {\n        (es, why) := site_of_text(s.label, text)\n        edges += es\n        skipped += why\n      },\n      None => mut todo.push(s),\n    }\n  }\n  if todo != [] {\n    if solver == \"\" {\n      return Err(\"no solver (z3) found: the moves can't be asked\")\n    }\n    (own, fns, types, sigs, all_methods) := verified_decls(\n      disk,\n      \"std\",\n      [file],\n      stored + todo.map(s -> s.decl),\n    )\n    scratch := cache.smt\n    cache.make_dirs(mut disk, scratch)\n    names := set(todo.map(s -> s.name))\n    made := own.filter(\n      d -> match d.kind {\n        ast.FnDef(f) => contains(names, f.name),\n        _ => false,\n      },\n    )\n    ctx := termination.context(\n      fns,\n      types,\n      sigs,\n      all_methods,\n      scratch,\n      solver,\n    )\n    methods := termination.seen_through(ctx, termination.analyze(\n      mut launcher,\n      mut disk,\n      ctx,\n      Some(set(shown_names(ctx, made))),\n    ))\n    mut answered := []\n    for s in todo {\n      found := made.filter(\n        d -> match d.kind {\n          ast.FnDef(f) => f.name == s.name,\n          _ => false,\n        },\n      )\n      (es, why) := match get(found, 0) {\n        Some(ast.Decl { kind: ast.FnDef(f), module, .. }) => {\n          label := if module == \"\" {\n            f.name\n          } else {\n            module + \".\" + f.name\n          }\n          vc := smt.encode(\n            mut launcher,\n            mut disk,\n            scratch,\n            solver,\n            fns,\n            types,\n            sigs,\n            methods,\n            f,\n            label,\n          )\n          match get(vc.gaps, 0) {\n            Some(gap) => (\n              [],\n              [(s.label, \"not covered by compiler/smt yet: \" + gap)],\n            ),\n            None => if len(f.post) != len(s.queries) {\n              ([], [(\n                s.label,\n                \"its questions changed on the way to the solver\",\n              )])\n            } else {\n              answers := graph_answers(\n                mut launcher,\n                mut disk,\n                scratch,\n                solver,\n                vc,\n              )\n              // a model is a move only when the encoding is exact: no loop (its turns\n              // stand for any), nothing the solver was left to choose (a gap, a function\n              // known by its contract). A trait's method is what its contract says (a\n              // model is a move of some implementation).\n              exact := !graph.loops_in(s)\n                && values(vc.reasons).all(\n                  r -> starts_with(r, \"values of the generic type\")\n                    || starts_with(r, \"the result of `\")\n                      && contains(r, \"::\")\n                      && ends_with(r, \"(only its contract is known)\"),\n                )\n              (graph.edges_of(\n                s,\n                f.post.map(graph.ensures_text),\n                if exact {\n                  answers\n                } else {\n                  answers.map(\n                    a -> if starts_with(a, \"refuted \") {\n                      \"unknown \" + drop_bytes(a, 8)\n                    } else {\n                      a\n                    },\n                  )\n                },\n              ), [])\n            },\n          }\n        },\n        _ => ([], [(s.label, \"it could not be prepared for the solver\")]),\n      }\n      mut answered.push((s, es, why))\n    }\n    // what the solver left unknown, run: a run that makes a move shows it\n    // possible\n    unknown := answered\n      .filter(a -> a.1.any(e -> e.verdict == \"unknown\"))\n      .map(a -> a.0)\n    ran := if runs && unknown != [] {\n      graph_runs(\n        disk,\n        cache,\n        std_loaded(\n          std_library(mut console, mut disk, process, cache),\n        ),\n        file,\n        unknown,\n      )\n    } else {\n      Dict[String, List[Bool]] {}\n    }\n    for (s, es0, why) in answered {\n      es := match get(ran, s.name) {\n        Some(flags) => graph.with_runs(es0, flags),\n        None => es0,\n      }\n      if reuse {\n        _ := cache.write_entry(\n          mut disk,\n          cache,\n          key(s),\n          site_text(es, why),\n        )\n      }\n      edges += es\n      skipped += why\n    }\n  }\n  moved := graph.resolved(subject, edges + pl.fixed, pl.vias)\n  Ok(graph.Graph { subject, edges: graph.merged(moved), skipped })\n}","old_text":"/// The graph of `subject` in the program `stored` (the definitions `file`\n/// holds, or held). Each site's questions (compiler/graph's `plan`) are\n/// encoded by compiler/smt as `ensures` of a copy of the function and given\n/// to the solver. Each site's answers are cached under the program's text\n/// and the copy's (`graph-site`), so only what changed is asked again.\n/// Adds the moves the bodies' shape settles and those that follow calls\n/// (`resolved`). With `runs` (`stored` being what `file` holds), what the\n/// solver leaves unknown is run on generated inputs too (`graph_runs`,\n/// with std's library).\nfn static_graph(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  cache: cache.Cache,\n  file: String,\n  stored: List[ast.Decl],\n  subject: graph.Subject,\n  runs: Bool,\n) -> Result[graph.Graph, String] {\n  home := match home_found(disk, process) {\n    Some(h) => h,\n    None => return Err(\n      \"can't find Strata's home (a folder holding core/, std/ and runtime/prelude.strata): set STRATA_HOME\",\n    ),\n  }\n  if driver_chdir(home).to_int() != 0 {\n    return Err(f\"can't enter {home}\")\n  }\n  solver := toolchain.solver(disk, process)\n  pl := graph.plan(stored, subject)\n  sites := pl.sites\n  program := join(stored.map(d -> d.module + \"\\n\" + text.decl_text(d)), \"\\n\")\n  key := (s: graph.Site) -> \"verify-strata/graphs/\"\n    + cache.entry_key(\n      \"graph-site\",\n      [solver, program, text.decl_text(s.decl), s.label, if !runs {\n        \"solver\"\n      } else {\n        \"solver, runs\"\n      }],\n    )\n  reuse := cache.caching() && solver != \"\"\n  mut edges := []\n  mut skipped := []\n  mut todo := []\n  for s in sites {\n    match if reuse {\n      cache.read_entry(disk, cache, key(s))\n    } else {\n      None\n    } {\n      Some(text) => {\n        (es, why) := site_of_text(s.label, text)\n        edges += es\n        skipped += why\n      },\n      None => mut todo.push(s),\n    }\n  }\n  if todo != [] {\n    if solver == \"\" {\n      return Err(\"no solver (z3) found: the moves can't be asked\")\n    }\n    (own, fns, types, sigs, all_methods) := verified_decls(\n      disk,\n      \"std\",\n      [file],\n      stored + todo.map(s -> s.decl),\n    )\n    scratch := cache.smt\n    cache.make_dirs(mut disk, scratch)\n    names := set(todo.map(s -> s.name))\n    made := own.filter(\n      d -> match d.kind {\n        ast.FnDef(f) => contains(names, f.name),\n        _ => false,\n      },\n    )\n    ctx := termination.context(\n      fns,\n      types,\n      sigs,\n      all_methods,\n      scratch,\n      solver,\n    )\n    methods := termination.seen_through(ctx, termination.analyze(\n      mut launcher,\n      mut disk,\n      ctx,\n      Some(set(shown_names(ctx, made))),\n    ))\n    mut answered := []\n    for s in todo {\n      found := made.filter(\n        d -> match d.kind {\n          ast.FnDef(f) => f.name == s.name,\n          _ => false,\n        },\n      )\n      (es, why) := match get(found, 0) {\n        Some(ast.Decl { kind: ast.FnDef(f), module, .. }) => {\n          label := if module == \"\" {\n            f.name\n          } else {\n            module + \".\" + f.name\n          }\n          vc := smt.encode(\n            mut launcher,\n            mut disk,\n            scratch,\n            solver,\n            fns,\n            types,\n            sigs,\n            methods,\n            f,\n            label,\n          )\n          match get(vc.gaps, 0) {\n            Some(gap) => (\n              [],\n              [(s.label, \"not covered by compiler/smt yet: \" + gap)],\n            ),\n            None => if len(f.post) != len(s.queries) {\n              ([], [(\n                s.label,\n                \"its questions changed on the way to the solver\",\n              )])\n            } else {\n              answers := graph_answers(\n                mut launcher,\n                mut disk,\n                scratch,\n                solver,\n                vc,\n              )\n              // a model is a move only when the encoding is exact: no loop (its turns\n              // stand for any), nothing the solver was left to choose (a gap, a function\n              // known by its contract). A trait's method is what its contract says (a\n              // model is a move of some implementation).\n              exact := !graph.loops_in(s)\n                && values(vc.reasons).all(\n                  r -> starts_with(r, \"values of the generic type\")\n                    || starts_with(r, \"the result of `\")\n                      && contains(r, \"::\")\n                      && ends_with(r, \"(only its contract is known)\"),\n                )\n              (graph.edges_of(\n                s,\n                f.post.map(graph.ensures_text),\n                if exact {\n                  answers\n                } else {\n                  answers.map(\n                    a -> if starts_with(a, \"refuted \") {\n                      \"unknown \" + drop_bytes(a, 8)\n                    } else {\n                      a\n                    },\n                  )\n                },\n              ), [])\n            },\n          }\n        },\n        _ => ([], [(s.label, \"it could not be prepared for the solver\")]),\n      }\n      mut answered.push((s, es, why))\n    }\n    // what the solver left unknown, run: a run that makes a move shows it\n    // possible\n    unknown := answered\n      .filter(a -> a.1.any(e -> e.verdict == \"unknown\"))\n      .map(a -> a.0)\n    ran := if runs && unknown != [] {\n      graph_runs(disk, cache, std_loaded(disk, std_library(\n        mut console,\n        mut disk,\n        process,\n        mut launcher,\n        cache,\n      )), file, unknown)\n    } else {\n      Dict[String, List[Bool]] {}\n    }\n    for (s, es0, why) in answered {\n      es := match get(ran, s.name) {\n        Some(flags) => graph.with_runs(es0, flags),\n        None => es0,\n      }\n      if reuse {\n        _ := cache.write_entry(\n          mut disk,\n          cache,\n          key(s),\n          site_text(es, why),\n        )\n      }\n      edges += es\n      skipped += why\n    }\n  }\n  moved := graph.resolved(subject, edges + pl.fixed, pl.vias)\n  Ok(graph.Graph { subject, edges: graph.merged(moved), skipped })\n}"},{"name":"alongside_command","kind":"fn","old":"f656f43fe5830c95","new":"132669f667fa19c6","interface_changed":false,"affected":[],"module":"","text":"/// `strata verify-alongside DIR PARENT PATH -- CODEGEN_ARGS`, started by\n/// `strata run` (`start_alongside`), at a lower priority than the program.\n/// Verifies the program at `PATH` as `build` does (`verify --quiet`, its\n/// line on stderr, which is DIR/log; no invariants written into the code).\n/// Then, while the run (process `PARENT`) goes on and the checks proven\n/// differ from those it started with (DIR/started.txt), compiles it again\n/// without them (`codegen CODEGEN_ARGS`, whose `--proofs` is\n/// DIR/proofs.txt) into DIR/proven.ll, for the run to swap in.\nfn alongside_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n) -> std.process.ExitCode {\n  match jit_lower_priority().to_int() {\n    _ => (),\n  }\n  dir := get(line.pos, 1) ?? \"\"\n  parent := parse_int(get(line.pos, 2) ?? \"\") ?? 0\n  path := get(line.pos, 3) ?? \"\"\n  if dir == \"\" || path == \"\" {\n    return fail_with(\n      mut console,\n      \"usage: strata verify-alongside DIR PARENT PATH -- CODEGEN_ARGS\",\n    )\n  }\n  lib := std_library(mut console, mut disk, process, cache)\n  solver := toolchain.solver(disk, process)\n  if !toolchain.has_solver(mut launcher, solver) {\n    return 0\n  }\n  match verify_file(\n    mut console,\n    mut launcher,\n    mut disk,\n    cache,\n    solver,\n    toolchain.c_compiler(process),\n    [\"--quiet\"] + std_flags(lib) + [path],\n  ) {\n    _ => (),\n  }\n  // (the run ended: nobody to swap the code into)\n  if jit_parent_alive(parent.wrap_i64()).to_int() == 0 {\n    match mut disk.remove_all(dir) {\n      _ => (),\n    }\n    return 0\n  }\n  facts := proofs_kept(mut disk, cache, path)\n  started := match disk.read(dir + \"/started.txt\") {\n    Ok(t) => t,\n    Err(_) => \"\",\n  }\n  if join(facts, \"\\n\") == started {\n    return 0\n  }\n  match mut disk.write(dir + \"/proofs.txt\", join(facts, \"\\n\")) {\n    _ => (),\n  }\n  ir := codegen_text(disk, shared(disk, cache), line.after)\n  if starts_with(ir, \"error\") || contains(ir, \"\\nerror: \") {\n    return 0\n  }\n  match mut disk.write(dir + \"/proven.ll.tmp\", ir) {\n    Ok(_) => match mut disk.rename(dir + \"/proven.ll.tmp\", dir + \"/proven.ll\") {\n      _ => (),\n    },\n    Err(_) => (),\n  }\n  if jit_parent_alive(parent.wrap_i64()).to_int() == 0 {\n    match mut disk.remove_all(dir) {\n      _ => (),\n    }\n  }\n  0\n}","old_text":"/// `strata verify-alongside DIR PARENT PATH -- CODEGEN_ARGS`, started by\n/// `strata run` (`start_alongside`), at a lower priority than the program.\n/// Verifies the program at `PATH` as `build` does (`verify --quiet`, its\n/// line on stderr, which is DIR/log; no invariants written into the code).\n/// Then, while the run (process `PARENT`) goes on and the checks proven\n/// differ from those it started with (DIR/started.txt), compiles it again\n/// without them (`codegen CODEGEN_ARGS`, whose `--proofs` is\n/// DIR/proofs.txt) into DIR/proven.ll, for the run to swap in.\nfn alongside_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n) -> std.process.ExitCode {\n  match jit_lower_priority().to_int() {\n    _ => (),\n  }\n  dir := get(line.pos, 1) ?? \"\"\n  parent := parse_int(get(line.pos, 2) ?? \"\") ?? 0\n  path := get(line.pos, 3) ?? \"\"\n  if dir == \"\" || path == \"\" {\n    return fail_with(\n      mut console,\n      \"usage: strata verify-alongside DIR PARENT PATH -- CODEGEN_ARGS\",\n    )\n  }\n  lib := std_library(mut console, mut disk, process, mut launcher, cache)\n  solver := toolchain.solver(disk, process)\n  if !toolchain.has_solver(mut launcher, solver) {\n    return 0\n  }\n  match verify_file(\n    mut console,\n    mut launcher,\n    mut disk,\n    cache,\n    solver,\n    toolchain.c_compiler(process),\n    [\"--quiet\"] + std_flags(lib) + [path],\n  ) {\n    _ => (),\n  }\n  // (the run ended: nobody to swap the code into)\n  if jit_parent_alive(parent.wrap_i64()).to_int() == 0 {\n    match mut disk.remove_all(dir) {\n      _ => (),\n    }\n    return 0\n  }\n  facts := proofs_kept(mut disk, cache, path)\n  started := match disk.read(dir + \"/started.txt\") {\n    Ok(t) => t,\n    Err(_) => \"\",\n  }\n  if join(facts, \"\\n\") == started {\n    return 0\n  }\n  match mut disk.write(dir + \"/proofs.txt\", join(facts, \"\\n\")) {\n    _ => (),\n  }\n  ir := codegen_text(disk, shared(disk, cache), line.after)\n  if starts_with(ir, \"error\") || contains(ir, \"\\nerror: \") {\n    return 0\n  }\n  match mut disk.write(dir + \"/proven.ll.tmp\", ir) {\n    Ok(_) => match mut disk.rename(dir + \"/proven.ll.tmp\", dir + \"/proven.ll\") {\n      _ => (),\n    },\n    Err(_) => (),\n  }\n  if jit_parent_alive(parent.wrap_i64()).to_int() == 0 {\n    match mut disk.remove_all(dir) {\n      _ => (),\n    }\n  }\n  0\n}"},{"name":"toolchain.object","kind":"fn","old":"1cd040f3d090ad8b","new":"3e6742efdbacdc84","interface_changed":true,"affected":["object_command","std_library","sources_object","core_rt_object","command_line","check_command","verify_command","build_command","test_command","run_command","repl_command","static_graph","alongside_command","linked","program_objects","main","strata_command","graph_command","graph_diff","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","diff_command","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","built_ir","build_core_command","comptime_value","codegen_file","jit_file","fuzz_file","literal_errors_of","verify_file","graph_runs","replay","or