{"id":"52afca44b1896d90","time":1795635050,"message":"rename lint.old_forms → lint.functional_forms","changes":[{"name":"lint.collection_forms","kind":"fn","old":"1a227912651478d9","new":"a4db1fa0f8aa2163","interface_changed":false,"affected":[],"module":"lint","text":"/// Lists, dicts and sets change through `mut` methods, and new ones come\n/// from expressions.\n/// - Changing: `xs = push(xs, x)` is `mut xs.push(x)`,\n/// `d = insert(d, k, v)` is `mut d.insert(k, v)`, `xs = sort(xs)` is\n/// `mut xs.sort()`.\n/// - New values: `xs + [x]` for `push(xs, x)`, `xs.sorted()` for\n/// `sort(xs)`, `xs.sorted_by(f)`, `xs.reversed()` for `reverse(xs)` (of a\n/// string too), and a changed copy for a dict or set with one entry more\n/// or less (`{ mut copy := d; mut copy.insert(k, v); copy }`).\n/// Syntactic: a program function named `push` (`insert`, ...) is rewritten\n/// too, and a method of that name only where its result is assigned back\n/// to its receiver.\nfn collection_forms(d: ast.Decl) -> (List[String], ast.Decl) {\n  changed := walk.decl_parts(\n    d,\n    e -> lint.collections_fixed(e),\n    t -> walk.rewrite_type(t, e -> lint.collections_fixed(e)),\n  )\n  if changed == d {\n    return ([], d)\n  }\n  found := walk.decl_exprs(d)\n    .map(e -> lint.functional_forms(e))\n    .fold([], (a, b) -> a + b)\n  mut names: List[String] = []\n  for n in found {\n    if !names.contains(n) {\n      names += [n]\n    }\n  }\n  shown := names.map(n -> \"`\" + n + \"`\").join(\", \")\n  w := f\"`{lint.shown_name(d)}`: {shown} as functions: a list, dict or set changes by a `mut` method (`mut xs.push(x)`), a new one is an expression (`xs + [x]`, `xs.sorted()`)\"\n  ([w], changed)\n}","old_text":"/// Lists, dicts and sets change through `mut` methods, and new ones come\n/// from expressions.\n/// - Changing: `xs = push(xs, x)` is `mut xs.push(x)`,\n/// `d = insert(d, k, v)` is `mut d.insert(k, v)`, `xs = sort(xs)` is\n/// `mut xs.sort()`.\n/// - New values: `xs + [x]` for `push(xs, x)`, `xs.sorted()` for\n/// `sort(xs)`, `xs.sorted_by(f)`, `xs.reversed()` for `reverse(xs)` (of a\n/// string too), and a changed copy for a dict or set with one entry more\n/// or less (`{ mut copy := d; mut copy.insert(k, v); copy }`).\n/// Syntactic: a program function named `push` (`insert`, ...) is rewritten\n/// too, and a method of that name only where its result is assigned back\n/// to its receiver.\nfn collection_forms(d: ast.Decl) -> (List[String], ast.Decl) {\n  changed := walk.decl_parts(\n    d,\n    e -> lint.collections_fixed(e),\n    t -> walk.rewrite_type(t, e -> lint.collections_fixed(e)),\n  )\n  if changed == d {\n    return ([], d)\n  }\n  found := walk.decl_exprs(d)\n    .map(e -> lint.old_forms(e))\n    .fold([], (a, b) -> a + b)\n  mut names: List[String] = []\n  for n in found {\n    if !names.contains(n) {\n      names += [n]\n    }\n  }\n  shown := names.map(n -> \"`\" + n + \"`\").join(\", \")\n  w := f\"`{lint.shown_name(d)}`: {shown} as functions: a list, dict or set changes by a `mut` method (`mut xs.push(x)`), a new one is an expression (`xs + [x]`, `xs.sorted()`)\"\n  ([w], changed)\n}"},{"name":"lint.functional_forms","kind":"fn","old":null,"new":"d8a44449685fbbb1","interface_changed":true,"affected":[],"module":"lint","text":"/// The functional forms of the collection built-ins in `e` (`push(xs, x)`,\n/// `xs.sort()` not marked `mut`), by name, once per use.\nfn functional_forms(e: ast.Expr) -> List[String] {\n  here := match e {\n    ast.MutExpr(ast.MethodCall { .. }) => [],\n    ast.Call { callee: ast.Var(q), args } => if lint.old_arity(lint.call_name(q), len(args) - 1) {\n      [lint.call_name(q)]\n    } else {\n      []\n    },\n    ast.MethodCall { name, args, .. } => if lint.old_arity(name, len(args)) {\n      [name]\n    } else {\n      []\n    },\n    _ => [],\n  }\n  inner := match e {\n    ast.MutExpr(ast.MethodCall { recv, args, .. }) => [recv] + args,\n    _ => walk.kids(e),\n  }\n  here\n    + inner\n      .map(k -> lint.functional_forms(k))\n      .fold([], (a, b) -> a + b)\n}"},{"name":"lint.old_forms","kind":"fn","old":"9af0a9eaa684f6dc","new":null,"interface_changed":true,"affected":[],"module":"lint","old_text":"/// The functional forms of the collection built-ins in `e` (`push(xs, x)`,\n/// `xs.sort()` not marked `mut`), by name, once per use.\nfn old_forms(e: ast.Expr) -> List[String] {\n  here := match e {\n    ast.MutExpr(ast.MethodCall { .. }) => [],\n    ast.Call { callee: ast.Var(q), args } => if lint.old_arity(lint.call_name(q), len(args) - 1) {\n      [lint.call_name(q)]\n    } else {\n      []\n    },\n    ast.MethodCall { name, args, .. } => if lint.old_arity(name, len(args)) {\n      [name]\n    } else {\n      []\n    },\n    _ => [],\n  }\n  inner := match e {\n    ast.MutExpr(ast.MethodCall { recv, args, .. }) => [recv] + args,\n    _ => walk.kids(e),\n  }\n  here + inner.map(k -> lint.old_forms(k)).fold([], (a, b) -> a + b)\n}"}],"renames":[{"from":"lint.old_forms","to":"lint.functional_forms","kind":"function"}],"references":["lint.collection_forms"]}
{"id":"fb8b5a5a907397b5","time":1795635053,"message":"rename lint.old_arity → lint.functional_arity","changes":[{"name":"lint.functional_forms","kind":"fn","old":"d8a44449685fbbb1","new":"81baa5c5f21b2548","interface_changed":false,"affected":[],"module":"lint","text":"/// The functional forms of the collection built-ins in `e` (`push(xs, x)`,\n/// `xs.sort()` not marked `mut`), by name, once per use.\nfn functional_forms(e: ast.Expr) -> List[String] {\n  here := match e {\n    ast.MutExpr(ast.MethodCall { .. }) => [],\n    ast.Call { callee: ast.Var(q), args } => if lint.functional_arity(lint.call_name(q), len(args) - 1) {\n      [lint.call_name(q)]\n    } else {\n      []\n    },\n    ast.MethodCall { name, args, .. } => if lint.functional_arity(name, len(args)) {\n      [name]\n    } else {\n      []\n    },\n    _ => [],\n  }\n  inner := match e {\n    ast.MutExpr(ast.MethodCall { recv, args, .. }) => [recv] + args,\n    _ => walk.kids(e),\n  }\n  here\n    + inner\n      .map(k -> lint.functional_forms(k))\n      .fold([], (a, b) -> a + b)\n}","old_text":"/// The functional forms of the collection built-ins in `e` (`push(xs, x)`,\n/// `xs.sort()` not marked `mut`), by name, once per use.\nfn functional_forms(e: ast.Expr) -> List[String] {\n  here := match e {\n    ast.MutExpr(ast.MethodCall { .. }) => [],\n    ast.Call { callee: ast.Var(q), args } => if lint.old_arity(lint.call_name(q), len(args) - 1) {\n      [lint.call_name(q)]\n    } else {\n      []\n    },\n    ast.MethodCall { name, args, .. } => if lint.old_arity(name, len(args)) {\n      [name]\n    } else {\n      []\n    },\n    _ => [],\n  }\n  inner := match e {\n    ast.MutExpr(ast.MethodCall { recv, args, .. }) => [recv] + args,\n    _ => walk.kids(e),\n  }\n  here\n    + inner\n      .map(k -> lint.functional_forms(k))\n      .fold([], (a, b) -> a + b)\n}"},{"name":"lint.functional_arity","kind":"fn","old":null,"new":"f05896e9f5aa688e","interface_changed":true,"affected":[],"module":"lint","text":"/// Whether built-in `n` with `k` arguments after the list, dict or set is\n/// one of the functional forms (`push(xs, x)`: `k` is 1).\nfn functional_arity(n: String, k: Int) -> Bool {\n  match n {\n    \"push\" | \"sort_by\" | \"remove\" => k == 1,\n    \"sort\" | \"reverse\" => k == 0,\n    \"insert\" => k == 1 || k == 2,\n    _ => false,\n  }\n}"},{"name":"lint.assigned_back","kind":"fn","old":"901af6e7ac4ac30b","new":"67b66e09fa6d507f","interface_changed":false,"affected":[],"module":"lint","text":"/// `p = push(p, x)` (or `p = p.push(x)`) as `mut p.push(x)`, and likewise\n/// `insert`, `remove`, `sort` and `sort_by` assigned back to the variable\n/// or field they read. A call whose value is dropped (`xs.push(x)`, which\n/// changes nothing) also becomes the `mut` method.\nfn assigned_back(s: ast.Stmt) -> ast.Stmt {\n  match s {\n    ast.Assign { place, value } => if lint.place_like(place) {\n      match value {\n        ast.Call { callee: ast.Var(q), args: [first, ..rest] } => if first == place\n          && lint.back_form(lint.call_name(q), len(rest)) {\n          return ast.ExprStmt(ast.MutExpr(ast.MethodCall {\n            recv: place,\n            name: lint.call_name(q),\n            args: rest,\n          }))\n        },\n        ast.MethodCall { recv, name, args } => if recv == place && lint.back_form(name, len(args)) {\n          return ast.ExprStmt(\n            ast.MutExpr(ast.MethodCall { recv: place, name, args }),\n          )\n        },\n        _ => (),\n      }\n    },\n    ast.ExprStmt(ast.MethodCall { recv, name, args }) => if lint.place_like(recv) && lint.functional_arity(name, len(args)) {\n      return ast.ExprStmt(ast.MutExpr(ast.MethodCall { recv, name, args }))\n    },\n    _ => (),\n  }\n  s\n}","old_text":"/// `p = push(p, x)` (or `p = p.push(x)`) as `mut p.push(x)`, and likewise\n/// `insert`, `remove`, `sort` and `sort_by` assigned back to the variable\n/// or field they read. A call whose value is dropped (`xs.push(x)`, which\n/// changes nothing) also becomes the `mut` method.\nfn assigned_back(s: ast.Stmt) -> ast.Stmt {\n  match s {\n    ast.Assign { place, value } => if lint.place_like(place) {\n      match value {\n        ast.Call { callee: ast.Var(q), args: [first, ..rest] } => if first == place\n          && lint.back_form(lint.call_name(q), len(rest)) {\n          return ast.ExprStmt(ast.MutExpr(ast.MethodCall {\n            recv: place,\n            name: lint.call_name(q),\n            args: rest,\n          }))\n        },\n        ast.MethodCall { recv, name, args } => if recv == place && lint.back_form(name, len(args)) {\n          return ast.ExprStmt(\n            ast.MutExpr(ast.MethodCall { recv: place, name, args }),\n          )\n        },\n        _ => (),\n      }\n    },\n    ast.ExprStmt(ast.MethodCall { recv, name, args }) => if lint.place_like(recv) && lint.old_arity(name, len(args)) {\n      return ast.ExprStmt(ast.MutExpr(ast.MethodCall { recv, name, args }))\n    },\n    _ => (),\n  }\n  s\n}"},{"name":"lint.back_form","kind":"fn","old":"ef51d849d4a6b78d","new":"e6455ea9934564f6","interface_changed":false,"affected":[],"module":"lint","text":"/// The functional forms whose assignment back is a `mut` method. Not\n/// `reverse`, which strings have too: `s = s.reversed()`.\nfn back_form(n: String, k: Int) -> Bool {\n  lint.functional_arity(n, k) && n != \"reverse\"\n}","old_text":"/// The functional forms whose assignment back is a `mut` method. Not\n/// `reverse`, which strings have too: `s = s.reversed()`.\nfn back_form(n: String, k: Int) -> Bool {\n  lint.old_arity(n, k) && n != \"reverse\"\n}"},{"name":"lint.new_value","kind":"fn","old":"cc71e328ac763c46","new":"0e087f59d4c2888b","interface_changed":false,"affected":[],"module":"lint","text":"/// A functional form as the expression for its new value: `push(xs, x)` is\n/// `xs + [x]`, `sort(xs)` is `xs.sorted()`, `insert(d, k, v)` is a changed\n/// copy.\nfn new_value(e: ast.Expr) -> ast.Expr {\n  (n, first, rest, method) := match e {\n    ast.Call { callee: ast.Var(q), args: [first, ..rest] } => (lint.call_name(q), first, rest, false),\n    ast.MethodCall { recv, name, args } => (name, recv, args, true),\n    _ => return e,\n  }\n  if !lint.functional_arity(n, len(rest)) {\n    return e\n  }\n  match (n, rest) {\n    (\"push\", [x]) => ast.Binary {\n      op: ast.Add,\n      left: first,\n      right: ast.ListExpr([x]),\n    },\n    (\"sort\", []) => ast.MethodCall { recv: first, name: \"sorted\", args: [] },\n    (\"sort_by\", [k]) => ast.MethodCall { recv: first, name: \"sorted_by\", args: [k] },\n    (\"reverse\", []) => ast.MethodCall { recv: first, name: \"reversed\", args: [] },\n    _ => if method {\n      // a method `insert` of the program's own types: left alone\n      e\n    } else {\n      c := lint.fresh_copy(rest)\n      ast.Block { stmts: [\n        ast.VarDecl { name: c, ty: None, value: first },\n        ast.ExprStmt(ast.MutExpr(\n          ast.MethodCall { recv: ast.Var(c), name: n, args: rest },\n        )),\n      ], last: ast.Var(c) }\n    },\n  }\n}","old_text":"/// A functional form as the expression for its new value: `push(xs, x)` is\n/// `xs + [x]`, `sort(xs)` is `xs.sorted()`, `insert(d, k, v)` is a changed\n/// copy.\nfn new_value(e: ast.Expr) -> ast.Expr {\n  (n, first, rest, method) := match e {\n    ast.Call { callee: ast.Var(q), args: [first, ..rest] } => (lint.call_name(q), first, rest, false),\n    ast.MethodCall { recv, name, args } => (name, recv, args, true),\n    _ => return e,\n  }\n  if !lint.old_arity(n, len(rest)) {\n    return e\n  }\n  match (n, rest) {\n    (\"push\", [x]) => ast.Binary {\n      op: ast.Add,\n      left: first,\n      right: ast.ListExpr([x]),\n    },\n    (\"sort\", []) => ast.MethodCall { recv: first, name: \"sorted\", args: [] },\n    (\"sort_by\", [k]) => ast.MethodCall { recv: first, name: \"sorted_by\", args: [k] },\n    (\"reverse\", []) => ast.MethodCall { recv: first, name: \"reversed\", args: [] },\n    _ => if method {\n      // a method `insert` of the program's own types: left alone\n      e\n    } else {\n      c := lint.fresh_copy(rest)\n      ast.Block { stmts: [\n        ast.VarDecl { name: c, ty: None, value: first },\n        ast.ExprStmt(ast.MutExpr(\n          ast.MethodCall { recv: ast.Var(c), name: n, args: rest },\n        )),\n      ], last: ast.Var(c) }\n    },\n  }\n}"},{"name":"lint.call_name","kind":"fn","old":"ae94812d39b8f88a","new":"90374b5e3c2cfd71","interface_changed":false,"affected":[],"module":"lint","text":"/// A called function's name as the rules read it. A collection built-in\n/// stored as a module's trait method (`std.fs.remove`, an imported `Files`\n/// method) reads as the built-in (`remove`).\nfn call_name(q: String) -> String {\n  parts := split(q, \".\")\n  n := get(parts, len(parts) - 1) ?? q\n  if lint.functional_arity(n, 0)\n    || lint.functional_arity(n, 1)\n    || lint.functional_arity(n, 2) {\n    n\n  } else {\n    q\n  }\n}","old_text":"/// A called function's name as the rules read it. A collection built-in\n/// stored as a module's trait method (`std.fs.remove`, an imported `Files`\n/// method) reads as the built-in (`remove`).\nfn call_name(q: String) -> String {\n  parts := split(q, \".\")\n  n := get(parts, len(parts) - 1) ?? q\n  if lint.old_arity(n, 0)\n    || lint.old_arity(n, 1)\n    || lint.old_arity(n, 2) {\n    n\n  } else {\n    q\n  }\n}"},{"name":"lint.old_arity","kind":"fn","old":"a1b542498ebc05f1","new":null,"interface_changed":true,"affected":[],"module":"lint","old_text":"/// Whether built-in `n` with `k` arguments after the list, dict or set is\n/// one of the functional forms (`push(xs, x)`: `k` is 1).\nfn old_arity(n: String, k: Int) -> Bool {\n  match n {\n    \"push\" | \"sort_by\" | \"remove\" => k == 1,\n    \"sort\" | \"reverse\" => k == 0,\n    \"insert\" => k == 1 || k == 2,\n    _ => false,\n  }\n}"}],"renames":[{"from":"lint.old_arity","to":"lint.functional_arity","kind":"function"}],"references":["lint.functional_forms","lint.assigned_back","lint.back_form","lint.new_value","lint.call_name"]}
