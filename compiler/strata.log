codegen.hash_helper","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// The element type of a channel end.\nfn end_elem(t: check.Ty) -> check.Ty {\n  match t {\n    check.TNamed { name: \"Sender\", args: [e] } | check.TNamed { name: \"Receiver\", args: [e] } => e,\n    _ => check.TAny,\n  }\n}","old_text":"/// The element type of a channel end.\nfn end_elem(t: Ty) -> Ty {\n  match t {\n    TNamed { name: \"Sender\", args: [e] } | TNamed { name: \"Receiver\", args: [e] } => e,\n    _ => TAny,\n  }\n}"},{"name":"codegen.channel_op","kind":"fn","old":"6d0a145dbc14576b","new":"e635ec70d89c9d8f","interface_changed":false,"affected":[],"module":"codegen","text":"/// Channel operations called by `core/channel.strata`'s methods, and a\n/// `VirtualClock`'s. A value moved into a channel is a slot it owns.\nfn channel_op(\n  mut g: codegen.Gen,\n  name: String,\n  vs: List[codegen.V],\n) -> codegen.V {\n  first := get(vs, 0) ?? codegen.unit()\n  et := codegen.end_elem(first.ty)\n  if name == \"channel_send\" {\n    v := codegen.as_type(mut g, get(vs, 1) ?? codegen.unit(), et)\n    x := codegen.take_value(\n      mut g,\n      codegen.V { ..v, ty: codegen.better(et, v.ty) },\n    )\n    // (the receiver may be another thread)\n    codegen.share_value(mut g, x)\n    s := codegen.to_slot(mut g, x)\n    codegen.use_rt(mut g, \"strata_channel_send\")\n    codegen.emit(\n      mut g,\n      f\"call void @strata_channel_send(ptr {first.op}, i64 {s})\",\n    )\n    codegen.cancel_point(mut g)\n    return codegen.unit()\n  }\n  if name == \"channel_close\" {\n    codegen.use_rt(mut g, \"strata_channel_close\")\n    codegen.emit(\n      mut g,\n      f\"call void @strata_channel_close(ptr {first.op})\",\n    )\n    codegen.after_builtin(mut g, \"strata_channel_close\")\n    return codegen.unit()\n  }\n  if name == \"channel_recv\" {\n    codegen.use_rt(mut g, \"strata_channel_recv\")\n    out := codegen.fresh(mut g, \"recvd\")\n    mut g.allocas.push(f\"  {out} = alloca i64\")\n    ok := codegen.fresh(mut g, \"ok\")\n    codegen.emit(\n      mut g,\n      f\"{ok} = call i1 @strata_channel_recv(ptr {first.op}, ptr {out})\",\n    )\n    // checked once the received value is held, so leaving drops it\n    r := codegen.option_from(mut g, ok, out, et)\n    codegen.cancel_point(mut g)\n    return r\n  }\n  if name == \"host_virtual_now\" {\n    return codegen.call(mut g, check.TInt, \"strata_virtual_now\", [])\n  }\n  // `host_virtual_sleep`\n  _ := codegen.call(mut g, check.TUnit, \"strata_virtual_sleep\", vs)\n  codegen.cancel_point(mut g)\n  codegen.unit()\n}","old_text":"/// Channel operations called by `core/channel.strata`'s methods, and a\n/// `VirtualClock`'s. A value moved into a channel is a slot it owns.\nfn channel_op(\n  mut g: codegen.Gen,\n  name: String,\n  vs: List[codegen.V],\n) -> codegen.V {\n  first := get(vs, 0) ?? codegen.unit()\n  et := codegen.end_elem(first.ty)\n  if name == \"channel_send\" {\n    v := codegen.as_type(mut g, get(vs, 1) ?? codegen.unit(), et)\n    x := codegen.take_value(\n      mut g,\n      codegen.V { ..v, ty: codegen.better(et, v.ty) },\n    )\n    // (the receiver may be another thread)\n    codegen.share_value(mut g, x)\n    s := codegen.to_slot(mut g, x)\n    codegen.use_rt(mut g, \"strata_channel_send\")\n    codegen.emit(\n      mut g,\n      f\"call void @strata_channel_send(ptr {first.op}, i64 {s})\",\n    )\n    codegen.cancel_point(mut g)\n    return codegen.unit()\n  }\n  if name == \"channel_close\" {\n    codegen.use_rt(mut g, \"strata_channel_close\")\n    codegen.emit(\n      mut g,\n      f\"call void @strata_channel_close(ptr {first.op})\",\n    )\n    codegen.after_builtin(mut g, \"strata_channel_close\")\n    return codegen.unit()\n  }\n  if name == \"channel_recv\" {\n    codegen.use_rt(mut g, \"strata_channel_recv\")\n    out := codegen.fresh(mut g, \"recvd\")\n    mut g.allocas.push(f\"  {out} = alloca i64\")\n    ok := codegen.fresh(mut g, \"ok\")\n    codegen.emit(\n      mut g,\n      f\"{ok} = call i1 @strata_channel_recv(ptr {first.op}, ptr {out})\",\n    )\n    // checked once the received value is held, so leaving drops it\n    r := codegen.option_from(mut g, ok, out, et)\n    codegen.cancel_point(mut g)\n    return r\n  }\n  if name == \"host_virtual_now\" {\n    return codegen.call(mut g, TInt, \"strata_virtual_now\", [])\n  }\n  // `host_virtual_sleep`\n  _ := codegen.call(mut g, TUnit, \"strata_virtual_sleep\", vs)\n  codegen.cancel_point(mut g)\n  codegen.unit()\n}"},{"name":"codegen.option_from","kind":"fn","old":"8dd0c50b542e0a33","new":"15c3b6a20ce28df7","interface_changed":true,"affected":["codegen.channel_op","codegen.select_expr","codegen.builtin","codegen.expr_node","codegen.call_named","codegen.builtin_call","codegen.push_in_place","codegen.expr","codegen.expr_want_node","codegen.method_call","codegen.except_expr","codegen.matching_want","codegen.update_in_place","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.try_want","codegen.tag_test","codegen.set_in_place","codegen.take_in_place","codegen.compared","codegen.stmt_node","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.expr_on_stack","codegen.assigned_call","codegen.expr_want","codegen.matching","codegen.binds","codegen.matching_v","codegen.match_got","codegen.assertion","codegen.invariants","codegen.tag_is","codegen.check_type","codegen.satisfies","codegen.holds_pred","co