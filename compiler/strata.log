l `other`, when `e` is a\n/// method's result.\nfn beside(e: ast.Expr, other: ast.Expr) -> Ty {\n  match e {\n    ast.MethodCall { .. } => match other {\n      ast.IntLit(_) => TInt,\n      ast.FloatLit(_) => TFloat,\n      ast.StrLit(_) => TStr,\n      _ => TAny,\n    },\n    _ => TAny,\n  }\n}"},{"name":"codegen.try_want","kind":"fn","old":"d4b284e30d39f76f","new":"7566c77ba0d82c0f","interface_changed":true,"affected":["codegen.try_expr","codegen.expr_want_node","codegen.expr_node","codegen.expr_want","codegen.expr","codegen.function","codegen.binary","codegen.declare","codegen.destructure","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.method_call","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.compared","codegen.stmt_node","codegen.build_fn","codegen.push_in_place","codegen.call_named","codegen.interp","codegen.logic","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.decreases_pass","codegen.decreases_call","codegen.keep_olds","codegen.export_entry","codegen.expr_on_stack","codegen.assigned_call","codegen.compiled_alone","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.by_variant","codegen.list_literal","codegen.generate","codegen.construct","codegen.operands","codegen.mock_call