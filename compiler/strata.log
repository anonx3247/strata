] },\n    TNamed { name, args } => ast.Named { name, args: args.map(a -> codegen.written_of(a)) },\n    TTrait(tr) => ast.Named { name: tr, args: [] },\n    TFn { params, ret } => ast.FnType {\n      params: params.map(p -> codegen.written_of(p)),\n      ret: codegen.written_of(ret),\n    },\n    _ => ast.UnitType,\n  }\n}"},{"name":"codegen.mock_value","kind":"fn","old":"25d055bbcc5c7353","new":"2f7d243812a99bb0","interface_changed":true,"affected":["codegen.produce","codegen.expr_node","codegen.gen_fn","codegen.expr","codegen.generated","codegen.can_generate","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.method_call","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.try_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.expr_want_node","codegen.compared","codegen.stmt_node","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.gen_list","codegen.gen_data","codegen.fuzz_driver","codegen.built_or_generated","codegen.generated_args","codegen.makers","codegen.binds","codegen.matching_v","codegen.match_got","codegen.assertion","codegen.invariants","codegen.tag_is","codegen.check_type","codegen.satisfies","codegen.holds_pred","codegen.function","codegen.entry","codegen.vtable","codegen.mock_table","codegen.mock_call","codegen.list_builtin","codegen.collection_builtin","codegen.list_literal_of","codegen.wanted","codegen.table_find","codegen.generate","codegen.construct","codegen.operands","codegen.if_expr","codegen.matching","codegen.try_expr","codegen.builtin_call","codegen.expr_want","codegen.stmt","codegen.call_fn_want","codegen.get_field","codegen.options","codegen.to_c","codegen.check_payload","codegen.dyn_ctor_is","codegen.or_else","codegen.has_field_check","codegen.declare","codegen.check_field","codegen.assign_at","codegen.lambda_shown","codegen.checked_update","codegen.check_union","codegen.check_member","codegen.compiled_alone","codegen.to_dyn","codegen.dyn_table_is","codegen.builtin","codegen.list_literal","codegen_with","core_rt_text","computed_value","repl_eval","codegen.session_capability","codegen.union_call","codegen.dyn_generic_call","codegen.block_expr","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.list_get_or","codegen.appended","codegen.iterate","codegen.decreases_start","codegen.decreases_entry","codegen.call_fn","codegen.clock_now","codegen.regex_matches","codegen.by_variant","codegen.foreign_call","codegen.function_value","codegen.lambda","codegen.dyn_wrapper","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.session_entry","codegen.show","codegen.shown","codegen.string_builtin","codegen.host","codegen.spawn_expr","codegen.method_value","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.helper","codegen.debug_body","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.equal","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.read_back","eval_files","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// `mock T`: a trait value whose table's methods give generated values.\nfn mock_value(mut g: codegen.Gen, t: check.Ty) -> codegen.V {\n  tr := match t {\n    check.TTrait(x) => x,\n    _ => {\n      codegen.not_yet(\n        mut g,\n        \"`mock` of a `\" + codegen.key(t) + \"`, which is not a trait\",\n      )\n      return codegen.never()\n    },\n  }\n  vt := codegen.mock_table(mut g, tr)\n  codegen.use_rt(mut g, \"strata_alloc\")\n  (p, a, s) := (\n    codegen.fresh(mut g, \"mock\"),\n    codegen.fresh(mut g, \"vt\"),\n    codegen.fresh(mut g, \"slot\"),\n  )\n  codegen.emit(mut g, f\"{p} = call ptr @strata_alloc(i64 16)\")\n  codegen.emit(mut g, f\"{a} = ptrtoint ptr {vt} to i64\")\n  codegen.emit(mut g, f\"store i64 {a}, ptr {p}\")\n  codegen.emit(mut g, f\"{s} = getelementptr i64, ptr {p}, i64 1\")\n  codegen.emit(mut g, f\"store i64 0, ptr {s}\")\n  codegen.temp(mut g, codegen.V { ty: t, op: p })\n}","old_text":"/// `mock T`: a trait value whose table's methods give generated values.\nfn mock_value(mut g: codegen.Gen, t: Ty) -> codegen.V {\n  tr := match t {\n    TTrait(x) => x,\n    _ => {\n      codegen.not_yet(\n        mut g,\n        \"`mock` of a `\" + codegen.key(t) + \"`, which is not a trait\",\n      )\n      return codegen.never()\n    },\n  }\n  vt := codegen.mock_table(mut g, tr)\n  codegen.use_rt(mut g, \"strata_alloc\")\n  (p, a, s) := (\n    codegen.fresh(mut g, \"mock\"),\n    codegen.fresh(mut g, \"vt\"),\n    codegen.fresh(mut g, \"slot\"),\n  )\n  codegen.emit(mut g, f\"{p} = call ptr @strata_alloc(i64 16)\")\n  codegen.emit(mut g, f\"{a} = ptrtoint ptr {vt} to i64\")\n  codegen.emit(mut g, f\"store i64 {a}, ptr {p}\")\n  codegen.emit(mut g, f\"{s} = getelementptr i64, ptr {p}, i64 1\")\n  codegen.emit(mut g, f\"store i64 0, ptr {s}\")\n  codegen.temp(mut g, codegen.V { ty: t, op: p })\n}"},{"name":"codegen.mock_method","kind":"fn","old":"32d74dc6ab36a3b0","new":"4dca666a99958162","interface_changed":false,"affected":[],"module":"codegen","text":"/// A mock's method `m` of trait `tr`, called by its table with `self`'s\n/// slot first. Checks its `requires`, then generates results until its\n/// `ensures` hold.\n/// A trait whose contracts name its models (`self.orders`) gets no such\n/// checks: this mock holds no models, so its results may break the\n/// contracts. A `mock T` written in a test is the generated type that runs\n/// the models.\nfn mock_method(mut g: codegen.Gen, tr: String, m: ast.FnDecl) -> String {\n  pre := m.pre\n  post := m.post\n  if (pre + post).any(e -> codegen.mentions_var(e, \"self\")) {\n    codegen.not_yet(\n      mut g,\n      f\"a generated `{codegen.short(tr)}`: the contract of `{m.name}` names its models, which a generated value doesn't hold\",\n    )\n    return \"null\"\n  }\n\n  name := f\"@\\\"mock:{tr}::{m.name}\\\"\"\n  saved := g\n  codegen.start_helper(mut g)\n  mut g.sub.insert(\"Self\", check.TTrait(tr))\n  mut sig := [\"i64 %self\"]\n  for (k, p) in enumerate(drop(m.params, 1)) {\n    t := codegen.lower(mut g, p.ty)\n    if p.mutable {\n      mut sig.push(f\"ptr %a{k}\")\n      codegen.local_at(mut g, p.name, t, f\"%a{k}\")\n      continue\n    }\n    slot := codegen.local(mut g, p.name, t)\n    if codegen.has_value(t) {\n      mut sig.push(f\"{codegen.ll(t)} %a{k}\")\n      codegen.store(mut g, codegen.V { ty: t, op: f\"%a{k}\" }, slot)\n    }\n  }\n  tn := codegen.short(tr)\n  for r in pre {\n    codegen.push_scope(mut g)\n    ok := codegen.expr(mut g, r)\n    codegen.pop_scope(mut g)\n    (pass, fail) := (\n      codegen.label(mut g, \"requires.ok\"),\n      codegen.label(mut g, \"requires.fail\"),\n    )\n    codegen.emit(\n      mut g,\n      f\"br i1 {ok.op}, label %{pass}, label %{fail}\",\n    )\n    codegen.block(mut g, fail)\n    codegen.push_scope(mut g)\n    msg := codegen.lit(\n      mut g,\n      f\"precondition of `{tn}.{m.name}` violated: requires {text.expr_text(r, 0)}\",\n    )\n    codegen.fault(mut g, 1, [msg])\n    codegen.discard_scope(mut g)\n    codegen.br(mut g, pass)\n    codegen.block(mut g, pass)\n  }\n  written := codegen.self_is(\n    m.ret,\n    Dict[String, ast.TypeExpr] { \"Self\": ast.Named { name: tr, args: [] } },\n  )\n  ret := codegen.lower(mut g, written)\n  (head, fail) := codegen.tries_start(mut g, 200)\n  v0 := codegen.generated(mut g, written, codegen.no_hints(), \"0\")\n  v := codegen.V { ty: ret, op: v0.op }\n  mut ok := \"true\"\n  if len(post) > 0 {\n    codegen.push_scope(mut g)\n    slot := codegen.local(mut g, \"it\", ret)\n    codegen.store(mut g, v, slot)\n    for en in post {\n      codegen.push_scope(mut g)\n      e := codegen.expr(mut g, en)\n      codegen.pop_scope(mut g)\n      r := codegen.fresh(mut g, \"and\")\n      codegen.emit(mut g, f\"{r} = and i1 {ok}, {e.op}\")\n      ok = r\n    }\n    g.scopes = take(g.scopes, len(g.scopes) - 1)\n  }\n  codegen.tries_end(\n    mut g,\n    v,\n    ok,\n    head,\n    fail,\n    f\"mock {tn}.{m.name}: could not generate a result satisfying its `ensures`\",\n  )\n  codegen.emit(mut g, if codegen.has_value(ret) {\n    f\"ret {codegen.ll(ret)} {v.op}\"\n  } else {\n    \"ret void\"\n  })\n  codegen.restore(mut g, saved, codegen.helper_text(\n    g,\n    f\"define {codegen.ll(ret)} {name}(\" + join(sig, \", \") + \")\",\n  ))\n  name\n}","old_text":"/// A mock's method `m` of trait `tr`, called by its table with `self`'s\n/// slot first. Checks its `requires`, then generates results until its\n/// `ensures` hold.\n/// A trait whose contracts name its models (`self.orders`) gets no such\n/// checks: this mock holds no models, so its results may break the\n/// contracts. A `mock T` written in a test is the generated type that runs\n/// the models.\nfn mock_method(mut g: codegen.Gen, tr: String, m: ast.FnDecl) -> String {\n  pre := m.pre\n  post := m.post\n  if (pre + post).any(e -> codegen.mentions_var(e, \"self\")) {\n    codegen.not_yet(\n      mut g,\n      f\"a generated `{codegen.short(tr)}`: the contract of `{m.name}` names its models, which a generated value doesn't hold\",\n    )\n    return \"null\"\n  }\n\n  name := f\"@\\\"mock:{tr}::{m.name}\\\"\"\n  saved := g\n  codegen.start_helper(mut g)\n  mut g.sub.insert(\"Self\", TTrait(tr))\n  mut sig := [\"i64 %self\"]\n  for (k, p) in enumerate(drop(m.params, 1)) {\n    t := codegen.lower(mut g, p.ty)\n    if p.mutable {\n      mut sig.push(f\"ptr %a{k}\")\n      codegen.local_at(mut g, p.name, t, f\"%a{k}\")\n      continue\n    }\n    slot := codegen.local(mut g, p.name, t)\n    if codegen.has_value(t) {\n      mut sig.push(f\"{codegen.ll(t)} %a{k}\")\n      codegen.store(mut g, codegen.V { ty: t, op: f\"%a{k}\" }, slot)\n    }\n  }\n  tn := codegen.short(tr)\n  for r in pre {\n    codegen.push_scope(mut g)\n    ok := codegen.expr(mut g, r)\n    codegen.pop_scope(mut g)\n    (pass, fail) := (\n      codegen.label(mut g, \"requires.ok\"),\n      codegen.label(mut g, \"requires.fail\"),\n    )\n    codegen.emit(\n      mut g,\n      f\"br i1 {ok.op}, label %{pass}, label %{fail}\",\n    )\n    codegen.block(mut g, fail)\n    codegen.push_scope(mut g)\n    msg := codegen.lit(\n      mut g,\n      f\"precondition of `{tn}.{m.name}` violated: requires {text.expr_text(r, 0)}\",\n    )\n    codegen.fault(mut g, 1, [msg])\n    codegen.discard_scope(mut g)\n    codegen.br(mut g, pass)\n    codegen.block(mut g, pass)\n  }\n  written := codegen.self_is(\n    m.ret,\n    Dict[String, ast.TypeExpr] { \"Self\": ast.Named { name: tr, args: [] } },\n  )\n  ret := codegen.lower(mut g, written)\n  (head, fail) := codegen.tries_start(mut g, 200)\n  v0 := codegen.generated(mut g, written, codegen.no_hints(), \"0\")\n  v := codegen.V { ty: ret, op: v0.op }\n  mut ok := \"true\"\n  if len(post) > 0 {\n    codegen.push_scope(mut g)\n    slot := codegen.local(mut g, \"it\", ret)\n    codegen.store(mut g, v, slot)\n    for en in post {\n      codegen.push_scope(mut g)\n      e := codegen.expr(mut g, en)\n      codegen.pop_scope(mut g)\n      r := codegen.fresh(mut g, \"and\")\n      codegen.emit(mut g, f\"{r} = and i1 {ok}, {e.op}\")\n      ok = r\n    }\n    g.scopes = take(g.scopes, len(g.scopes) - 1)\n  }\n  codegen.tries_end(\n    mut g,\n    v,\n    ok,\n    head,\n    fail,\n    f\"mock {tn}.{m.name}: could not generate a result satisfying its `ensures`\",\n  )\n  codegen.emit(mut g, if codegen.has_value(ret) {\n    f\"ret {codegen.ll(ret)} {v.op}\"\n  } else {\n    \"ret void\"\n  })\n  codegen.restore(mut g, saved, codegen.helper_text(\n    g,\n    f\"define {codegen.ll(ret)} {name}(\" + join(sig, \", \") + \")\",\n  ))\n  name\n}"},{"name":"codegen.fuzz_driver","kind":"fn","old":"805af17f47a95db2","new":"068843b3cd9bc9b1","interface_changed":false,"affected":[],"module":"codegen","text":"/// Verify's fuzz driver `strata.fuzz.i` for function `key`.\n/// - Its arguments are generated. A generic function's take the types\n/// `fuzz_traits` and `fuzz_instance` pick.\n/// - Each argument is handed over: by `strata_fuzz_keep`, read back by its\n/// shape, or with `fuzz_text` as code by `strata_fuzz_arg`.\n/// - Under a `requires`, an argument of a type the program constructs is\n/// mostly built by its functions (`built_or_generated`), unless `name`\n/// is `=KEY`.\n/// - Then the call.\nfn fuzz_driver(mut g: codegen.Gen, i: Int, name: String) -> String {\n  // `=KEY`: every argument generated, none built\n  plain := starts_with(name, \"=\")\n  key := if plain {\n    drop_bytes(name, 1)\n  } else {\n    name\n  }\n  f := match codegen.fn_of(g, key) {\n    Some(x) => x,\n    None => {\n      mut g.errs.push(\n        \"can't compile the fuzzing of `\"\n          + key\n          + \"`: no such function\",\n      )\n      codegen.add_failed(mut g, \"fuzz:\" + name)\n      return \"\"\n    },\n  }\n  saved := g\n  codegen.start_helper(mut g)\n  g.fname = key\n  // what it reaches is attributed to `fuzz:KEY`, so `generate` can say\n  // which drivers cannot be compiled\n  g.current = \"fuzz:\" + name\n  // a parameter of a trait with type arguments gets a value of a type\n  // implementing it, which fixes the type parameters\n  (bound, given) := codegen.fuzz_traits(g, f)\n  mut inst := codegen.fuzz_instance(g, f)\n  for (p, t) in bound {\n    mut inst.insert(p, t)\n  }\n  mut args := []\n  for (k, p) in enumerate(f.params) {\n    // under a `requires`, built by the program's own functions when some\n    // make the type (`built_or_generated`)\n    pt := get(given, k) ?? codegen.self_is(p.ty, inst)\n    v0 := if f.pre == [] || plain {\n      codegen.generated(mut g, pt, codegen.no_hints(), \"0\")\n    } else {\n      codegen.built_or_generated(mut g, key, pt)\n    }\n    v := codegen.temp(mut g, v0)\n    if g.fuzz_text {\n      sv := codegen.shown(mut g, v)\n      t := codegen.temp(mut g, sv)\n      codegen.use_rt(mut g, \"strata_fuzz_arg\")\n      codegen.emit(mut g, f\"call void @strata_fuzz_arg(ptr {t.op})\")\n    } else {\n      s := codegen.to_slot(mut g, v)\n      codegen.use_rt(mut g, \"strata_fuzz_keep\")\n      codegen.emit(\n        mut g,\n        f\"call void @strata_fuzz_keep(i64 {k}, i64 {s})\",\n      )\n    }\n    x := f\"fuzz.arg{k}\"\n    codegen.local_owned(mut g, x, v)\n    mut args.push(\n      if p.mutable {\n        ast.MutExpr(ast.Var(x))\n      } else {\n        ast.Var(x)\n      },\n    )\n  }\n  want := if f.type_params == [] {\n    check.TAny\n  } else {\n    codegen.lower(mut g, codegen.self_is(f.ret, inst))\n  }\n  _ := codegen.expr_want(\n    mut g,\n    ast.Call { callee: ast.Var(key), args },\n    want,\n  )\n  codegen.drop_from(mut g, 0, \"\")\n  codegen.emit(mut g, \"ret void\")\n  codegen.restore(\n    mut g,\n    saved,\n    codegen.helper_text(g, f\"define void @\\\"strata.fuzz.{i}\\\"()\"),\n  )\n  \"\"\n}","old_text":"/// Verify's fuzz driver `strata.fuzz.i` for function `key`.\n/// - Its arguments are generated. A generic function's take the types\n/// `fuzz_traits` and `fuzz_instance` pick.\n/// - Each argument is handed over: by `strata_fuzz_keep`, read back by its\n/// shape, or with `fuzz_text` as code by `strata_fuzz_arg`.\n/// - Under a `requires`, an argument of a type the program constructs is\n/// mostly built by its functions (`built_or_generated`), unless `name`\n/// is `=KEY`.\n/// - Then the call.\nfn fuzz_driver(mut g: codegen.Gen, i: Int, name: String) -> String {\n  // `=KEY`: every argument generated, none built\n  plain := starts_with(name, \"=\")\n  key := if plain {\n    drop_bytes(name, 1)\n  } else {\n    name\n  }\n  f := match codegen.fn_of(g, key) {\n    Some(x) => x,\n    None => {\n      mut g.errs.push(\n        \"can't compile the fuzzing of `\"\n          + key\n          + \"`: no such function\",\n      )\n      codegen.add_failed(mut g, \"fuzz:\" + name)\n      return \"\"\n    },\n  }\n  saved := g\n  codegen.start_helper(mut g)\n  g.fname = key\n  // what it reaches is attributed to `fuzz:KEY`, so `generate` can say\n  // which drivers cannot be compiled\n  g.current = \"fuzz:\" + name\n  // a parameter of a trait with type arguments gets a value of a type\n  // implementing it, which fixes the type parameters\n  (bound, given) := codegen.fuzz_traits(g, f)\n  mut inst := codegen.fuzz_instance(g, f)\n  for (p, t) in bound {\n    mut inst.insert(p, t)\n  }\n  mut args := []\n  for (k, p) in enumerate(f.params) {\n    // under a `requires`, built by the program's own functions when some\n    // make the type (`built_or_generated`)\n    pt := get(given, k) ?? codegen.self_is(p.ty, inst)\n    v0 := if f.pre == [] || plain {\n      codegen.generated(mut g, pt, codegen.no_hints(), \"0\")\n    } else {\n      codegen.built_or_generated(mut g, key, pt)\n    }\n    v := codegen.temp(mut g, v0)\n    if g.fuzz_text {\n      sv := codegen.shown(mut g, v)\n      t := codegen.temp(mut g, sv)\n      codegen.use_rt(mut g, \"strata_fuzz_arg\")\n      codegen.emit(mut g, f\"call void @strata_fuzz_arg(ptr {t.op})\")\n    } else {\n      s := codegen.to_slot(mut g, v)\n      codegen.use_rt(mut g, \"strata_fuzz_keep\")\n      codegen.emit(\n        mut g,\n        f\"call void @strata_fuzz_keep(i64 {k}, i64 {s})\",\n      )\n    }\n    x := f\"fuzz.arg{k}\"\n    codegen.local_owned(mut g, x, v)\n    mut args.push(\n      if p.mutable {\n        ast.MutExpr(ast.Var(x))\n      } else {\n        ast.Var(x)\n      },\n    )\n  }\n  want := if f.type_params == [] {\n    TAny\n  } else {\n    codegen.lower(mut g, codegen.self_is(f.ret, inst))\n  }\n  _ := codegen.expr_want(\n    mut g,\n    ast.Call { callee: ast.Var(key), args },\n    want,\n  )\n  codegen.drop_from(mut g, 0, \"\")\n  codegen.emit(mut g, \"ret void\")\n  codegen.restore(\n    mut g,\n    saved,\n    codegen.helper_text(g, f\"define void @\\\"strata.fuzz.{i}\\\"()\"),\n  )\n  \"\"\n}"},{"name":"codegen.regex_matches","kind":"fn","old":"72eca2bafb8eb480","new":"1ce2343ddaf01b51","interface_changed":false,"affected":[],"module":"codegen","text":"/// `matches(s, pattern)`: std.regex's engine at run time. `match_code` is\n/// 1, 0, or -1 for an invalid regex, which faults saying why.\nfn regex_matches(mut g: codegen.Gen, vs: List[codegen.V]) -> codegen.V {\n  code := codegen.call_fn_want(\n    mut g,\n    \"std.regex.match_code\",\n    vs,\n    [],\n    check.TInt,\n  )\n  if code.ty is check.TAny {\n    return codegen.never()\n  }\n  bad := codegen.fresh(mut g, \"bad\")\n  codegen.emit(mut g, f\"{bad} = icmp eq i64 {code.op}, -1\")\n  (fail, ok) := (\n    codegen.label(mut g, \"bad_regex\"),\n    codegen.label(mut g, \"regex_ok\"),\n  )\n  codegen.emit(mut g, f\"br i1 {bad}, label %{fail}, label %{ok}\")\n  codegen.block(mut g, fail)\n  codegen.push_scope(mut g)\n  why := codegen.call_fn_want(\n    mut g,\n    \"std.regex.pattern_error\",\n    [get(vs, 1) ?? codegen.unit()],\n    [],\n    check.TStr,\n  )\n  pre := codegen.lit(mut g, \"bad regex: \")\n  m := codegen.concat(mut g, [pre, why])\n  _ := codegen.call(\n    mut g,\n    check.TUnit,\n    \"strata_fault\",\n    [codegen.V { ty: check.TInt, op: \"260\" }, m],\n  )\n  codegen.emit(mut g, \"unreachable\")\n  codegen.discard_scope(mut g)\n  codegen.block(mut g, ok)\n  r := codegen.fresh(mut g, \"matches\")\n  codegen.emit(mut g, f\"{r} = icmp eq i64 {code.op}, 1\")\n  codegen.V { ty: check.TBool, op: r }\n}","old_text":"/// `matches(s, pattern)`: std.regex's engine at run time. `match_code` is\n/// 1, 0, or -1 for an invalid regex, which faults saying why.\nfn regex_matches(mut g: codegen.Gen, vs: List[codegen.V]) -> codegen.V {\n  code := codegen.call_fn_want(mut g, \"std.regex.match_code\", vs, [], TInt)\n  if code.ty is TAny {\n    return codegen.never()\n  }\n  bad := codegen.fresh(mut g, \"bad\")\n  codegen.emit(mut g, f\"{bad} = icmp eq i64 {code.op}, -1\")\n  (fail, ok) := (\n    codegen.label(mut g, \"bad_regex\"),\n    codegen.label(mut g, \"regex_ok\"),\n  )\n  codegen.emit(mut g, f\"br i1 {bad}, label %{fail}, label %{ok}\")\n  codegen.block(mut g, fail)\n  codegen.push_scope(mut g)\n  why := codegen.call_fn_want(\n    mut g,\n    \"std.regex.pattern_error\",\n    [get(vs, 1) ?? codegen.unit()],\n    [],\n    TStr,\n  )\n  pre := codegen.lit(mut g, \"bad regex: \")\n  m := codegen.concat(mut g, [pre, why])\n  _ := codegen.call(\n    mut g,\n    TUnit,\n    \"strata_fault\",\n    [codegen.V { ty: TInt, op: \"260\" }, m],\n  )\n  codegen.emit(mut g, \"unreachable\")\n  codegen.discard_scope(mut g)\n  codegen.block(mut g, ok)\n  r := codegen.fresh(mut g, \"matches\")\n  codegen.emit(mut g, f\"{r} = icmp eq i64 {code.op}, 1\")\n  codegen.V { ty: TBool, op: r }\n}"},{"name":"codegen.check_union","kind":"fn","old":"c67134457a44f809","new":"df07e093fc412169","interface_changed":false,"affected":[],"module":"codegen","text":"/// A union value against the written members `ws`: it must be one of them\n/// and satisfy its refinement (`30 is not a `Small | String``).\nfn check_union(\n  mut g: codegen.Gen,\n  ws: List[ast.TypeExpr],\n  v: codegen.V,\n  ctx: String,\n  more: List[codegen.V],\n) {\n  r := codegen.fresh(mut g, \"inunion\")\n  mut g.allocas.push(f\"  {r} = alloca i1\")\n  codegen.emit(mut g, f\"store i1 false, ptr {r}\")\n  for w in ws {\n    m := codegen.lower(mut g, w)\n    h := codegen.holds_member(mut g, v, m)\n    (yes, next) := (\n      codegen.label(mut g, \"member\"),\n      codegen.label(mut g, \"member.next\"),\n    )\n    codegen.emit(\n      mut g,\n      f\"br i1 {h.op}, label %{yes}, label %{next}\",\n    )\n    codegen.block(mut g, yes)\n    if codegen.needs_check(g, w) {\n      codegen.push_scope(mut g)\n      x := codegen.narrow(mut g, v, m)\n      pred := match w {\n        ast.Refined { pred, .. } => Some(pred),\n        ast.Named { name, .. } => match get(g.refines, name) {\n          Some((_, p)) => Some(p),\n          None => None,\n        },\n        _ => None,\n      }\n      ok := match pred {\n        Some(p) => codegen.holds_pred(mut g, w, x, p),\n        None => \"true\",\n      }\n      codegen.emit(mut g, f\"store i1 {ok}, ptr {r}\")\n      codegen.pop_scope(mut g)\n    } else {\n      codegen.emit(mut g, f\"store i1 true, ptr {r}\")\n    }\n    codegen.br(mut g, next)\n    codegen.block(mut g, next)\n  }\n  ok := codegen.fresh(mut g, \"ok\")\n  codegen.emit(mut g, f\"{ok} = load i1, ptr {r}\")\n  shown := join(ws.map(w -> text.type_text(w)), \" | \")\n  codegen.fail_unless(\n    mut g,\n    codegen.V { ty: check.TBool, op: ok },\n    ctx,\n    more,\n    v,\n    f\"is not a `{shown}`\",\n  )\n}","old_text":"/// A union value against the written members `ws`: it must be one of them\n/// and satisfy its refinement (`30 is not a `Small | String``).\nfn check_union(\n  mut g: codegen.Gen,\n  ws: List[ast.TypeExpr],\n  v: codegen.V,\n  ctx: String,\n  more: List[codegen.V],\n) {\n  r := codegen.fresh(mut g, \"inunion\")\n  mut g.allocas.push(f\"  {r} = alloca i1\")\n  codegen.emit(mut g, f\"store i1 false, ptr {r}\")\n  for w in ws {\n    m := codegen.lower(mut g, w)\n    h := codegen.holds_member(mut g, v, m)\n    (yes, next) := (\n      codegen.label(mut g, \"member\"),\n      codegen.label(mut g, \"member.next\"),\n    )\n    codegen.emit(\n      mut g,\n      f\"br i1 {h.op}, label %{yes}, label %{next}\",\n    )\n    codegen.block(mut g, yes)\n    if codegen.needs_check(g, w) {\n      codegen.push_scope(mut g)\n      x := codegen.narrow(mut g, v, m)\n      pred := match w {\n        ast.Refined { pred, .. } => Some(pred),\n        ast.Named { name, .. } => match get(g.refines, name) {\n          Some((_, p)) => Some(p),\n          None => None,\n        },\n        _ => None,\n      }\n      ok := match pred {\n        Some(p) => codegen.holds_pred(mut g, w, x, p),\n        None => \"true\",\n      }\n      codegen.emit(mut g, f\"store i1 {ok}, ptr {r}\")\n      codegen.pop_scope(mut g)\n    } else {\n      codegen.emit(mut g, f\"store i1 true, ptr {r}\")\n    }\n    codegen.br(mut g, next)\n    codegen.block(mut g, next)\n  }\n  ok := codegen.fresh(mut g, \"ok\")\n  codegen.emit(mut g, f\"{ok} = load i1, ptr {r}\")\n  shown := join(ws.map(w -> text.type_text(w)), \" | \")\n  codegen.fail_unless(\n    mut g,\n    codegen.V { ty: TBool, op: ok },\n    ctx,\n    more,\n    v,\n    f\"is not a `{shown}`\",\n  )\n}"},{"name":"codegen.check_member","kind":"fn","old":"6e08d440ddb8afb4","new":"f69d4c53a288eb83","interface_changed":false,"affected":[],"module":"codegen","text":"/// A member-typed value against a union with refined members: it must\n/// satisfy the refinement of one of the members of its type.\nfn check_member(\n  mut g: codegen.Gen,\n  ws: List[ast.TypeExpr],\n  v: codegen.V,\n  ctx: String,\n  more: List[codegen.V],\n) {\n  mut ok := \"false\"\n  mut seen := false\n  for w in ws {\n    m := codegen.lower(mut g, w)\n    if codegen.key(codegen.repr(m)) == codegen.key(codegen.repr(v.ty)) {\n      seen = true\n      pred := match w {\n        ast.Refined { pred, .. } => Some(pred),\n        ast.Named { name, .. } => match get(g.refines, name) {\n          Some((_, p)) => Some(p),\n          None => None,\n        },\n        _ => None,\n      }\n      one := match pred {\n        Some(p) => codegen.holds_pred(mut g, w, v, p),\n        None => \"true\",\n      }\n      o := codegen.fresh(mut g, \"or\")\n      codegen.emit(mut g, f\"{o} = or i1 {ok}, {one}\")\n      ok = o\n    }\n  }\n  if seen {\n    shown := join(ws.map(w -> text.type_text(w)), \" | \")\n    codegen.fail_unless(\n      mut g,\n      codegen.V { ty: check.TBool, op: ok },\n      ctx,\n      more,\n      v,\n      f\"is not a `{shown}`\",\n    )\n  }\n}","old_text":"/// A member-typed value against a union with refined members: it must\n/// satisfy the refinement of one of the members of its type.\nfn check_member(\n  mut g: codegen.Gen,\n  ws: List[ast.TypeExpr],\n  v: codegen.V,\n  ctx: String,\n  more: List[codegen.V],\n) {\n  mut ok := \"false\"\n  mut seen := false\n  for w in ws {\n    m := codegen.lower(mut g, w)\n    if codegen.key(codegen.repr(m)) == codegen.key(codegen.repr(v.ty)) {\n      seen = true\n      pred := match w {\n        ast.Refined { pred, .. } => Some(pred),\n        ast.Named { name, .. } => match get(g.refines, name) {\n          Some((_, p)) => Some(p),\n          None => None,\n        },\n        _ => None,\n      }\n      one := match pred {\n        Some(p) => codegen.holds_pred(mut g, w, v, p),\n        None => \"true\",\n      }\n      o := codegen.fresh(mut g, \"or\")\n      codegen.emit(mut g, f\"{o} = or i1 {ok}, {one}\")\n      ok = o\n    }\n  }\n  if seen {\n    shown := join(ws.map(w -> text.type_text(w)), \" | \")\n    codegen.fail_unless(\n      mut g,\n      codegen.V { ty: TBool, op: ok },\n      ctx,\n      more,\n      v,\n      f\"is not a `{shown}`\",\n    )\n  }\n}"},{"name":"codegen.converted","kind":"fn","old":"11569c98a99c0749","new":"69f0018212086f5d","interface_changed":true,"affected":["codegen.list_builtin","codegen.collection_builtin","codegen.list_literal_of","codegen.produce","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.update_in_place","codegen.table_find","codegen.set_in_place","codegen.take_in_place","codegen.expr_want_node","codegen.stmt_node","codegen.builtin","codegen.gen_list","codegen.list_literal","codegen.gen_fn","codegen.construct","codegen.operands","codegen.binary","codegen.builtin_call","codegen.branch_value","codegen.mock_call","codegen.expr_want","codegen.stmt","codegen.call_named","codegen.push_in_place","codegen.expr_node","codegen.generated","codegen.can_generate","codegen.main_arg","codegen.session_capability","codegen.for_loop","codegen.union_call","codegen.dyn_generic_call","codegen.compared","codegen.method_call","codegen.except_expr","codegen.matching_want","codegen.if_want","codegen.matching_v","codegen.match_got","codegen.function","codegen.declare","codegen.destructure","codegen.block_expr","codegen.call_fn_want","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.try_want","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.checked_update","codegen.appended","codegen.build_fn","codegen.iterate","codegen.decreases_start","codegen.decreases_pass","codegen.decreases_entry","codegen.decr