connective(\"==>\", kernel.conclusion(pq)) {\n    Some((l, r)) => if kernel.same_term(l, kernel.conclusion(p)) {\n      Ok(kernel.make_theorem(kernel.union_of_terms(\n        kernel.assumptions(pq),\n        kernel.assumptions(p),\n      ), r, kernel.joined_dependencies(\n        kernel.depends_on(pq),\n        kernel.depends_on(p),\n      )!, kernel.Step { rule: \"mp\", premises: [pq, p] }))\n    } else {\n      Err(\"mp: the theorem isn't the implication's premise\")\n    },\n    None => Err(\"mp: not an implication\"),\n  }\n}","old_text":"/// `A ⊢ p ⇒ q` and `B ⊢ p` give `A ∪ B ⊢ q`.\npub fn apply_implication(\n  pq: kernel.Theorem,\n  p: kernel.Theorem,\n) -> Result[kernel.Theorem, String] {\n  match kernel.split_connective(\"==>\", kernel.conclusion(pq)) {\n    Some((l, r)) => if kernel.same_term(l, kernel.conclusion(p)) {\n      Ok(kernel.make_theorem(kernel.union_of_terms(\n        kernel.assumptions(pq),\n        kernel.assumptions(p),\n      ), r, kernel.joined_dependencies(\n        kernel.depends_on(pq),\n        kernel.depends_on(p),\n      )!))\n    } else {\n      Err(\"mp: the theorem isn't the implication's premise\")\n    },\n    None => Err(\"mp: not an implication\"),\n  }\n}"},{"name":"kernel.for_all_from_arbitrary","kind":"fn","old":"a1af715eff526fbb","new":"478c73f69526adbc","interface_changed":false,"affected":["kernel_logic.logic_rewrites","kernel_tactics.intro_names","kernel_tactics.case_theorem","kernel_tactics.cases_on_term","kernel_tactics.cases_on_assumption","kernel_translate.flipped_distinct","kernel_translate.close","kernel_cli.check_script","kernel_tactics.logic_not_not","kernel_translate.for_each_value","kernel_tactics.apply_tactic","kernel_tactics.intro","kernel_tactics.opened","kernel_tactics.opened_by","kernel_tactics.closed_by","kernel_tactics.induct","kernel_tactics.induction","kernel_translate.add_datatypes","kernel_cli.base_theory","kernel_tactics.trivial_case","kernel_tactics.rule_theorems","kernel_tactics.discharged","kern