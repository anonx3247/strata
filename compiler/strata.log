mbers\", ast.ListExpr([])),\n    (\"params\", ast.ListExpr([])),\n    (\"result\", derive.none()),\n    (\"parameters\", ast.ListExpr([])),\n    (\"base\", derive.none()),\n  ])\n  c := derive.qualify(get(x.ix.modules, sum) ?? \"\", v.name)\n  mut x.ctors.insert(derive.key(d), c)\n  derive.remember(mut x, d, ast.Named { name: c, args: targs })\n  d\n}","old_text":"/// A sum's variant as a `Type`: a record, a tuple or an atom.\nfn variant_value(\n  mut x: derive.X,\n  sum: String,\n  v: ast.Variant,\n  targs: List[ast.TypeExpr],\n  sub: Dict[String, ast.TypeExpr],\n  mut stack: List[ast.TypeExpr],\n) -> ast.Expr {\n  mut fields := []\n  mut elements := []\n  kind := match v.payload {\n    ast.Positional(ts) => {\n      for t in ts {\n        mut elements.push(\n          derive.type_value_in(\n            mut x,\n            derive.subst(t, sub),\n            mut stack,\n          ),\n        )\n      }\n      \"Tuple\"\n    },\n    ast.RecordPayload(fs) => {\n      for f in fs {\n        mut fields.push(\n          derive.field(\n            mut x,\n            f.name,\n            f.doc,\n            derive.subst(f.ty, sub),\n            f.default,\n            mut stack,\n          ),\n        )\n      }\n      \"Record\"\n    },\n    _ => \"Atom\",\n  }\n  d := derive.record(\"Type\", [\n    (\"name\", derive.some(ast.StrLit(v.name))),\n    (\"doc\", derive.strs(v.doc)),\n    (\"kind\", derive.atom(derive.q(kind))),\n    (\"args\", ast.ListExpr([])),\n    (\"written\", ast.StrLit(v.name)),\n    (\"condition\", derive.none()),\n    (\"fields\", ast.ListExpr(fields)),\n    (\"elements\", ast.ListExpr(elements)),\n    (\"members\", ast.ListExpr([])),\n    (\"params\", ast.ListExpr([])),\n    (\"result\", derive.none()),\n    (\"parameters\", ast.ListExpr([])),\n    (\"base\", derive.none()),\n  ])\n  c := derive.qualify(get(x.ix.modules, sum) ?? \"\", v.name)\n  mut x.ctors.insert(derive.key(d), c)\n  derive.remember(mut x, d, ast.Named { name: c, args: targs })\n  d\n}"},{"name":"derive.field","kind":"fn","old":"782ada15b4b2d63a","new":"1792ec9960ca2888","interface_changed":true,"affected":["derive.type_value_in","derive.variant_value","derive.fn_value","derive.type_value","derive.derive_fn","derive.full","derive.with_self","derive.data_in","derive.derive","derive.match_type","derive.derive_all","derive.make","derive.arm_pattern","derive.eval_as","derive.data","derive.ctor_data","derive.expr","derive.derived_in","derive.comprehension","derive.fold_comptime","derive.eval_here","derive.call_copy","derive.children","derive.field_read","derive.type_method","derive.with_known","derive.block","derive.expand_with","derive.expand_in","std_reached","expanded","check_errors_in","derive.folded_in","derive.call_fn","derive.expand","holes_command","check_summary","verified_decls","verify_file","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","eval_files","instantiated_files","with_extra","command_line","check_command","verified_with","static_graph","verify_command","build_proofs","alongside_command","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","repl_command","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","main","strata_command","verified_program","build_command","graph_command","graph_diff","run_command","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","or_solver_inputs","program_objects","package_errors","merge_file_command","merged_checks","core_rt_text","call_command","edit_command","check_files","rename_command","move_command","fix_command","edit_in_editor","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","smt_file","termination_file","diff_command","check_fn","linked","sync_command","build_core_command","computed_value","codegen.read_back","comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"fn field(\n  mut x: derive.Expander,\n  name: String,\n  doc: List[String],\n  ty: ast.TypeExpr,\n  default: Option[ast.Expr],\n  mut stack: List[ast.TypeExpr],\n) -> ast.Expr {\n  // a refinement written as a type argument stays as written, not its alias\n  t := derive.type_value_in(mut x, derive.unwhere(x, ty), mut stack)\n  dv := match default {\n    Some(e) => derive.some(ast.StrLit(text.expr_text(e, 0))),\n    None => derive.none(),\n  }\n  f := derive.record(\"Field\", [\n    (\"name\", ast.StrLit(name)),\n    (\"doc\", derive.strs(doc)),\n    (\"type\", t),\n    (\"default\", dv),\n  ])\n  match default {\n    Some(e) => mut x.defaults.insert(derive.key(f), e),\n    None => (),\n  }\n  f\n}","old_text":"fn field(\n  mut x: derive.X,\n  name: String,\n  doc: List[String],\n  ty: ast.TypeExpr,\n  default: Option[ast.Expr],\n  mut stack: List[ast.TypeExpr],\n) -> ast.Expr {\n  // a refinement written as a type argument stays as written, not its alias\n  t := derive.type_value_in(mut x, derive.unwhere(x, ty), mut stack)\n  dv := match default {\n    Some(e) => derive.some(ast.StrLit(text.expr_text(e, 0))),\n    None => derive.none(),\n  }\n  f := derive.record(\"Field\", [\n    (\"name\", ast.StrLit(name)),\n    (\"doc\", derive.strs(doc)),\n    (\"type\", t),\n    (\"default\", dv),\n  ])\n  match default {\n    Some(e) => mut x.defaults.insert(derive.key(f), e),\n    None => (),\n  }\n  f\n}"},{"name":"derive.unwhere","kind":"fn","old":"9a1f700563555dda","new":"3af280e63052740d","interface_changed":true,"affected":["derive.field","derive.type_value_in","derive.variant_value","derive.fn_value","derive.type_value","derive.derive_fn","derive.full","derive.with_self","derive.data_in","derive.derive","derive.match_type","derive.derive_all","derive.make","derive.arm_pattern","derive.eval_as","derive.data","derive.ctor_data","derive.expr","derive.derived_in","derive.comprehension","derive.fold_comptime","derive.eval_here","derive.call_copy","derive.children","der