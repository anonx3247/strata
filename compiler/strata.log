.helper","codegen.debug_body","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.equal","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.read_back","eval_files","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// The result type of method `k` of type `head`, called on type `t`, with\n/// its `impl`'s parameters bound by `t` (`T.from_json_at(…)` with `T` a\n/// `List[Int]` gives `Result[List[Int], String]`). `want` if no `impl` of\n/// `head` takes `t`.\nfn self_want(\n  mut g: codegen.Gen,\n  head: String,\n  k: String,\n  t: check.Ty,\n  want: check.Ty,\n) -> check.Ty {\n  f := match codegen.fn_of(g, k) {\n    Some(f) => f,\n    None => return want,\n  }\n  for im in g.impls {\n    if im.head == head {\n      saved := g.sub\n      mut sub := Dict[String, check.Ty] {}\n      for p in im.decl.type_params {\n        mut sub.insert(p, check.TGen(p))\n      }\n      g.sub = sub\n      pat := codegen.lower(mut g, im.decl.for_type)\n      g.sub = saved\n      m := codegen.bind_gen(pat, t, Dict[String, check.Ty] {})\n      if codegen.key(check.inst(pat, m)) == codegen.key(t) {\n        mut own := Dict[String, check.Ty] {}\n        for p in f.type_params {\n          mut own.insert(p, get(m, p) ?? check.TGen(p))\n        }\n        g.sub = own\n        r := codegen.lower(mut g, f.ret)\n        g.sub = saved\n        return r\n      }\n    }\n  }\n  want\n}","old_text":"/// The result type of method `k` of type `head`, called on type `t`, with\n/// its `impl`'s parameters bound by `t` (`T.from_json_at(…)` with `T` a\n/// `List[Int]` gives `Result[List[Int], String]`). `want` if no `impl` of\n/// `head` takes `t`.\nfn self_want(\n  mut g: codegen.Gen,\n  head: String,\n  k: String,\n  t: Ty,\n  want: Ty,\n) -> Ty {\n  f := match codegen.fn_of(g, k) {\n    Some(f) => f,\n    None => return want,\n  }\n  for im in g.impls {\n    if im.head == head {\n      saved := g.sub\n      mut sub := Dict[String, Ty] {}\n      for p in im.decl.type_params {\n        mut sub.insert(p, TGen(p))\n      }\n      g.sub = sub\n      pat := codegen.lower(mut g, im.decl.for_type)\n      g.sub = saved\n      m := codegen.bind_gen(pat, t, Dict[String, Ty] {})\n      if codegen.key(inst(pat, m)) == codegen.key(t) {\n        mut own := Dict[String, Ty] {}\n        for p in f.type_params {\n          mut own.insert(p, get(m, p) ?? TGen(p))\n        }\n        g.sub = own\n        r := codegen.lower(mut g, f.ret)\n        g.sub = saved\n        return r\n      }\n    }\n  }\n  want\n}"},{"name":"codegen.beside","kind":"fn","old":"ffc9e5eb0879c425","new":"1720453a2b80b04f","interface_changed":true,"affected":["codegen.binary","codegen.expr_node","codegen.expr","codegen.call_named","codegen.interp","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.method_call","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.try_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.expr_want_node","codegen.