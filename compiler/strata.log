rm],\n  c: kernel.Term,\n) -> Result[kernel.Theorem, String] {\n  for h in hs {\n    _ := kernel.proposition(h)!\n  }\n  _ := kernel.proposition(c)!\n  Ok(kernel.make_theorem(\n    hs,\n    c,\n    kernel.Dependencies { definitions: [], oracles: [name] },\n    kernel.Step { rule: \"oracle:\" + name, premises: [] },\n  ))\n}","old_text":"// ---- oracles ----\n\n/// `hs ⊢ c` on the word of the oracle `name` (an outside decision procedure,\n/// such as the solver behind `omega`), which the theorem and every theorem\n/// made from it carry in its basis.\npub fn trust_oracle(\n  name: String,\n  hs: List[kernel.Term],\n  c: kernel.Term,\n) -> Result[kernel.Theorem, String] {\n  for h in hs {\n    _ := kernel.proposition(h)!\n  }\n  _ := kernel.proposition(c)!\n  Ok(kernel.make_theorem(\n    hs,\n    c,\n    kernel.Dependencies { definitions: [], oracles: [name] },\n  ))\n}"},{"name":"kernel.axiom_theorem","kind":"fn","old":"5e37a83e98382351","new":"f5d196467db021d2","interface_changed":true,"affected":["kernel.truth","kernel.and_from_both","kernel.and_gives_left","kernel.and_gives_right","kernel.or_from_left","kernel.or_from_right","kernel.or_by_cases","kernel.false_gives_anything","kernel.not_is_implies_false","kernel.excluded_middle","kernel.exists_from_witness","kernel.exists_elimination","kernel.eta","kernel.if_true","kernel.if_false","kernel.add_commutes","kernel.add_associates","kernel.add_zero","kernel.add_negation","kernel.subtraction_adds_negation","kernel.multiply_commutes","kernel.multiply_associates","kernel.multiply_one","kernel.multiply_distributes","kernel.at_most_is_less_or_equal","kernel.less_irreflexive","kernel.less_transitive","kernel.less_total","kernel.less_under_addition","kernel.positive_product","kernel.less_is_successor_at_most","kernel_logic.truth","kernel_logic.both","kernel_logic.one_of_both","kernel_logic.either","kernel_logic.by_either","kernel_logic.from_false","kernel_logic.logic_rewrites","kernel_logic.negation_as_implication","kernel_lo