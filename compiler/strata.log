acts.\n/// - `first_fact`: those before it are left out (a proof's step, an\n/// `assert … by`, sees only its own facts).\n/// - `own`: facts of a proof, gone from `Vc.facts` once the proof ends,\n/// that the check is given too.\npub type Obligation = {\n  what: String,\n  goal: String,\n  pc: List[String],\n  facts: Int,\n  first_fact: Int = 0,\n  own: List[String] = [],\n}","old_text":"/// A check to prove: `goal` on the path `pc`, given the first `facts`\n/// facts.\npub type Obligation = { what: String, goal: String, pc: List[String], facts: Int }"},{"name":"smt.Vc","kind":"type","old":"f93eae6c3bc7a769","new":"3b90fb13e4a96317","interface_changed":true,"affected":["verify_file","check_fn","solved_together","graph_answers","solved_with","loop_hint","smt.new_vc","smt.fresh","smt.fresh_why","smt.unknown_bool","smt.assume","smt.gap","smt.start_goal","smt.oblige","smt.as_int","smt.as_bool","smt.as_str","smt.shape","smt.havoc","smt.refresh","smt.refined","smt.check_type","smt.pred","smt.early_return","smt.lookup","smt.bind","smt.set_var","smt.merge","smt.branches","smt.eq","smt.arith","smt.bits","smt.compare","smt.concat","smt.eval","smt.binary","smt.call_exprs","smt.call_key","smt.call","smt.write_back","smt.call_contract","smt.stmt","smt.annotated","smt.declare","smt.assign","smt.function","smt.cone","smt.header","smt.body","smt.leaves","smt.batch","smt.single","smt.outcome","smt.solve","smt.define","smt.variants_of","smt.expand_alias","smt.structured","smt.is_type_name","smt.sort_type","smt.opaque_sort","smt.new_datatype","smt.set_datatype","smt.field_sort","smt.sort_of","smt.ctors_of","smt.declarations","smt.valid_term","smt.from_term","smt.unfold","smt.force","smt.merge_data","smt.part","smt.erased","smt.valid_by_construction","smt.check_type_at","smt.check_named","smt.different","smt.field","smt.is_ctor","smt.ordered","smt.ctor","smt.pattern","smt.ctor_pattern","smt.eval_expr","smt.fallback_value","smt.leaves_of","smt.sx_ok","smt.showable","smt.undecided","smt