se","codegen.foreign_call","codegen.generated_args","codegen.makers","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// `debug` of a list: `[a, b]`, `[]`.\nfn debug_list(\n  mut g: codegen.Gen,\n  a: codegen.V,\n  et: check.Ty,\n  open: String,\n  close: String,\n  empty: String,\n  pairs: Bool,\n) {\n  n := codegen.list_len(mut g, a)\n  none := codegen.fresh(mut g, \"none\")\n  codegen.emit(mut g, f\"{none} = icmp eq i64 {n.op}, 0\")\n  codegen.emit(mut g, f\"br i1 {none}, label %none, label %some\")\n  codegen.block(mut g, \"none\")\n  e := codegen.string(mut g, empty)\n  codegen.emit(mut g, f\"ret ptr {e}\")\n  codegen.block(mut g, \"some\")\n  acc := codegen.fresh(mut g, \"acc\")\n  mut g.allocas.push(f\"  {acc} = alloca ptr\")\n  o := codegen.string(mut g, open)\n  codegen.emit(mut g, f\"store ptr {o}, ptr {acc}\")\n  (nothing, comma) := (codegen.string(mut g, \"\"), codegen.string(mut g, \", \"))\n  at := codegen.each_start(mut g, a)\n  codegen.push_scope(mut g)\n  first := codegen.fresh(mut g, \"first\")\n  codegen.emit(mut g, f\"{first} = icmp eq i64 {at.1}, 0\")\n  sep := codegen.fresh(mut g, \"sep\")\n  codegen.emit(\n    mut g,\n    f\"{sep} = select i1 {first}, ptr {nothing}, ptr {comma}\",\n  )\n  cur := codegen.fresh(mut g, \"cur\")\n  codegen.emit(mut g, f\"{cur} = load ptr, ptr {acc}\")\n  x := codegen.list_at(mut g, a, at.1, et)\n  d := if pairs {\n    // `k: v`\n    (kt, vt) := match et {\n      check.TNamed { args: [k, v], .. } => (k, v),\n      _ => (check.TAny, check.TAny),\n    }\n    (k, v) := (codegen.field(mut g, x, 0, kt), codegen.field(mut g, x, 1, vt))\n    (kd, vd) := (codegen.shown(mut g, k), codegen.shown(mut g, v))\n    colon := codegen.lit(mut g, \": \")\n    codegen.concat(mut g, [kd, colon, vd])\n  } else {\n    codegen.shown(mut g, x)\n  }\n  t1 := codegen.call(mut g, check.TStr, \"strata_concat\", [\n    codegen.V { ty: check.TStr, op: cur },\n    codegen.V { ty: check.TStr, op: sep },\n  ])\n  t2 := codegen.call(mut g, check.TStr, \"strata_concat\", [t1, d])\n  kept := codegen.take_value(mut g, t2)\n  codegen.emit(mut g, f\"store ptr {kept.op}, ptr {acc}\")\n  codegen.drop_value(mut g, codegen.V { ty: check.TStr, op: cur })\n  codegen.pop_scope(mut g)\n  codegen.each_next(mut g, at)\n  last := codegen.fresh(mut g, \"cur\")\n  codegen.emit(mut g, f\"{last} = load ptr, ptr {acc}\")\n  closing := codegen.lit(mut g, close)\n  r := codegen.call(\n    mut g,\n    check.TStr,\n    \"strata_concat\",\n    [codegen.V { ty: check.TStr, op: last }, closing],\n  )\n  kept_r := codegen.take_value(mut g, r)\n  codegen.drop_value(mut g, codegen.V { ty: check.TStr, op: last })\n  codegen.emit(mut g, f\"ret ptr {kept_r.op}\")\n}","old_text":"/// `debug` of a list: `[a, b]`, `[]`.\nfn debug_list(\n  mut g: codegen.Gen,\n  a: codegen.V,\n  et: Ty,\n  open: String,\n  close: String,\n  empty: String,\n  pairs: Bool,\n) {\n  n := codegen.list_len(mut g, a)\n  none := codegen.fresh(mut g, \"none\")\n  codegen.emit(mut g, f\"{none} = icmp eq i64 {n.op}, 0\")\n  codegen.emit(mut g, f\"br i1 {none}, label %none, label %some\")\n  codegen.block(mut g, \"none\")\n  e := codegen.string(mut g, empty)\n  codegen.emit(mut g, f\"ret ptr {e}\")\n  codegen.block(mut g, \"some\")\n  acc := codegen.fresh(mut g, \"acc\")\n  mut g.allocas.push(f\"  {acc} = alloca ptr\")\n  o := codegen.string(mut g, open)\n  codegen.emit(mut g, f\"store ptr {o}, ptr {acc}\")\n  (nothing, comma) := (codegen.string(mut g, \"\"), codegen.string(mut g, \", \"))\n  at := codegen.each_start(mut g, a)\n  codegen.push_scope(mut g)\n  first := codegen.fresh(mut g, \"first\")\n  codegen.emit(mut g, f\"{first} = icmp eq i64 {at.1}, 0\")\n  sep := codegen.fresh(mut g, \"sep\")\n  codegen.emit(\n    mut g,\n    f\"{sep} = select i1 {first}, ptr {nothing}, ptr {comma}\",\n  )\n  cur := codegen.fresh(mut g, \"cur\")\n  codegen.emit(mut g, f\"{cur} = load ptr, ptr {acc}\")\n  x := codegen.list_at(mut g, a, at.1, et)\n  d := if pairs {\n    // `k: v`\n    (kt, vt) := match et {\n      TNamed { args: [k, v], .. } => (k, v),\n      _ => (TAny, TAny),\n    }\n    (k, v) := (codegen.field(mut g, x, 0, kt), codegen.field(mut g, x, 1, vt))\n    (kd, vd) := (codegen.shown(mut g, k), codegen.shown(mut g, v))\n    colon := codegen.lit(mut g, \": \")\n    codegen.concat(mut g, [kd, colon, vd])\n  } else {\n    codegen.shown(mut g, x)\n  }\n  t1 := codegen.call(\n    mut g,\n    TStr,\n    \"strata_concat\",\n    [\n      codegen.V { ty: TStr, op: cur },\n      codegen.V { ty: TStr, op: sep },\n    ],\n  )\n  t2 := codegen.call(mut g, TStr, \"strata_concat\", [t1, d])\n  kept := codegen.take_value(mut g, t2)\n  codegen.emit(mut g, f\"store ptr {kept.op}, ptr {acc}\")\n  codegen.drop_value(mut g, codegen.V { ty: TStr, op: cur })\n  codegen.pop_scope(mut g)\n  codegen.each_next(mut g, at)\n  last := codegen.fresh(mut g, \"cur\")\n  codegen.emit(mut g, f\"{last} = load ptr, ptr {acc}\")\n  closing := codegen.lit(mut g, close)\n  r := codegen.call(\n    mut g,\n    TStr,\n    \"strata_concat\",\n    [codegen.V { ty: TStr, op: last }, closing],\n  )\n  kept_r := codegen.take_value(mut g, r)\n  codegen.drop_value(mut g, codegen.V { ty: TStr, op: last })\n  codegen.emit(mut g, f\"ret ptr {kept_r.op}\")\n}"},{"name":"codegen.drop_list","kind":"fn","old":"3ad4ef15edf1fe61","new":"00b17cea84d233d5","interface_changed":true,"affected":["codegen.drop_fn","codegen.drop_value","codegen.tail_drop","codegen.function","codegen.drop_scope","codegen.drop_fields","codegen.debug_list","codegen.closure","codegen.collection_builtin","codegen.call_fn_want","codegen.builtin_call","codegen.dyn_wrapper","codegen.set_path","codegen.replace_var","codegen.union_drop","codegen.task_fns","codegen.await_list","codegen.slot_drop_fn","codegen.select_expr","codegen.foreign_call","codegen.tries_end","codegen.gen_list","codegen.drop_stacked","codegen.set_field_in_p