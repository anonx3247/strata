"codegen.untemp","codegen.compare_values","codegen.take_in_place","codegen.expr_node","codegen.expr_want_node","codegen.compared","codegen.stmt_node","codegen.finite_iterator","codegen.decreases_fault","codegen.decreases_start","codegen.decreases_pass","codegen.decreases_entry","codegen.decreases_call","codegen.makers","codegen.can_generate","codegen.built_or_generated","codegen.build_fn","codegen.generated_args","codegen.promises","codegen.keep_olds","codegen.session_entry","codegen.session_capability","codegen.field_written","codegen.fuzz_traits","codegen.trait_key","codegen.export_entry","codegen.library_start","codegen.site_marker","codegen.push_in_place","codegen.share_value","codegen.share_fn","codegen.share_held","codegen.share_fields","codegen.tail_share","codegen.constant_list","codegen.small_words","codegen.small_layout","codegen.tag_word","codegen.by_words","codegen.result_ll","codegen.load_words","codegen.stack_words","codegen.result_block","codegen.in_result","codegen.result_words","codegen.result_own","codegen.result_joined","codegen.words_value","codegen.words_fn","codegen.read_fields","codegen.box_fn","codegen.fields_drop_fn","codegen.drop_counted","codegen.direct_call","codegen.result_kind","codegen.flags_for","codegen.expr_on_stack","codegen.call_words","codegen.borrowed_arg","codegen.plain_want","codegen.held_words","codegen.drop_held","codegen.box_or_copy","codegen.unbox_fn","codegen.call_like","codegen.hand_on","codegen.reusable","codegen.assigned_call","codegen.assign_held","codegen.proven_root","codegen.proven_on","codegen.held_test","codegen.root_code","codegen.root_open","codegen.root_close","codegen.root_drop","codegen.var_code","codegen.slot_code","codegen.root_stmt_code","codegen.refuse_capability","codegen.capability_impl","codegen.has_field_check","codegen.fitting_record","codegen.read_back","codegen_with","core_rt_text","computed_value","repl_eval","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","eval.run","rename_command","move_command","fix_command","edit_in_editor","eval_files"],"module":"codegen","text":"type Gen = {\n  // module-wide\n  strings: Dict[String, String],\n  globals: List[String],\n  used: Set[String],\n  fns: Dict[String, ast.FnDecl],\n  errs: List[String],\n  // the checker's records and sums, each constructor's tag, the types with\n  // constructors, the fields' defaults\n  types: check.Types,\n  tags: Dict[String, Int],\n  data: Set[String],\n  defaults: Dict[String, ast.Expr],\n  // traits, and `impl`s with their type's head\n  traits: Dict[String, ast.TraitDecl],\n  impls: List[codegen.ImplEntry],\n  // helper functions made (`@\"eq:T\"`, `@\"debug:T\"`, `@\"drop:T\"`) and their\n  // text\n  helpers: Set[String],\n  helper_defs: List[String],\n  // each boxed union member's tag, and each union's name, by type key\n  box_tags: Dict[String, Int],\n  union_names: Dict[String, String],\n  // aliases with type parameters (`type Many[T] = List[T] | Problem`):\n  // their parameters and body\n  generic_aliases: Dict[String, (List[String], ast.TypeExpr)],\n  // refined types (core's `Natural` too): base and predicate. Then the\n  // `distinct` types, each field's written type (`C.f`), and each typed\n  // variable's declared type by slot.\n  refines: Dict[String, (ast.TypeExpr, ast.Expr)],\n  // a generic refined type's parameters (`NonEmpty[T]`'s `T`)\n  refine_params: Dict[String, List[String]],\n  distincts: Set[String],\n  field_types: Dict[String, ast.TypeExpr],\n  // each variant's declaration index in its sum (generators pick by it)\n  variant_index: Dict[String, Int],\n  declared: Dict[String, ast.TypeExpr],\n  // function instances asked for (by symbol), those left to compile (name,\n  // type arguments), and the count of lambdas made\n  instances: Set[String],\n  queue: List[(String, Dict[String, check.Ty])],\n  lambdas: Int,\n  // per function\n  fname: String,\n  // its type arguments, and whether it is in the prelude\n  sub: Dict[String, check.Ty],\n  in_prelude: Bool,\n  lines: List[String],\n  allocas: List[String],\n  next: Int,\n  scopes: List[codegen.Scope],\n  // each loop: the `continue` and `break` labels, and the scope depth\n  // outside it\n  loops: List[(String, String, Int)],\n  ret: check.Ty,\n  // each exit's result and the block it leaves from: the exit `phi`\n  rets: List[(String, String)] = [],\n  // depth of `|` alternatives being bound: their names go in slots, which\n  // each alternative stores to\n  alts: Int = 0,\n  // a match arm's names are bound borrowed: the matched value outlives the\n  // arm unchanged\n  borrowing: Bool = false,\n  // the slot whose value leaves the function: scope drops skip it\n  // (`leave_with`)\n  moved: String = \"\",\n  // cancellation unwind blocks by scope depth: the signature of what the\n  // scopes up to it hold, and the block that drops it and falls through to\n  // the ones below. Cancel points with the same signature share a block.\n  unwind_chain: List[(String, String)] = [],\n  // what `verify` proved (`strata build --strata`), by function\n  // (`proofs_of`), and the function whose proofs apply (\"\" in helpers and\n  // lambdas). Proven checks are not emitted.\n  proofs: Dict[String, List[(String, String)]],\n  proving: String,\n  // `tasks`: the program starts tasks. `supervises`: it supervises one, so\n  // a wait, a call or a fault may leave a function (`cancel_point`).\n  // `can_unwind`: the current body may leave so. `unwinds`: it does, through\n  // its `unwound` exit.\n  tasks: Bool,\n  supervises: Bool,\n  can_unwind: Bool,\n  unwinds: Bool,\n  // `extern c` functions (by key) and types (`Counter`)\n  externs: Set[String],\n  handles: Set[String],\n  // core's `builtin static` blocks (core.rt's state) and their sizes\n  statics: Dict[String, Int],\n  // compiling core.rt (`bare`): no call-stack frames and no cancel points,\n  // since the allocator runs inside every allocation\n  bare: Bool,\n  // generators made (`gen_fn`), by type and hints\n  gens: Dict[String, String],\n  // compiling fuzz drivers: functions and loops count steps\n  fuzzing: Bool,\n  // compiling verify's fuzz drivers and replays (`--fuzz`): no real\n  // capability value is made (`refuse_capability`)\n  sandboxed: Bool = false,\n  // fuzz drivers hand their arguments over as code (`strata_fuzz_arg`, for\n  // `verify`) instead of keeping them (`strata_fuzz_keep`)\n  fuzz_text: Bool,\n  // `--trace`: each call and return of the program's functions printed on\n  // stderr (`strata_trace_enter`, `strata_trace_leave`)\n  tracing: Bool,\n  // std functions taken from the precompiled library: declared, not\n  // compiled\n  precompiled: Set[String],\n  // compiling std's precompiled library (`codegen --library`): whatever\n  // depends on the codebase is left out\n  library_mode: Bool,\n  // `ret_w`: the function's result type as written, refined names kept\n  // (`List[Port]` where `ret` is `List[Int]`). `pending_w`: the written type\n  // arguments for the next call's type parameters (`T.from_json(…)` with\n  // `T` a `List[Port]`). They decide what `T.check(v)` checks in an\n  // instance (its sub's `$w:T`).\n  ret_w: check.Ty = check.TAny,\n  pending_w: Dict[String, check.Ty] = Dict[String, check.Ty] {},\n  // the function being compiled (its key), the callers of each function\n  // (by key), and the functions with something not compiled: std's\n  // library leaves these out\n  current: String,\n  callers: Dict[String, Set[String]],\n  failed: Set[String],\n  // `not_yet`'s errors for each of those, for verify's fuzz drivers to\n  // report\n  why: Dict[String, List[String]],\n  // parameters typed by a bounded type parameter (`x: T` with `T: Log`, or\n  // a trait's type compiled for a known type in `for_impls`), by slot, with\n  // their bounds. Their methods resolve to the bounds' methods, ahead of\n  // the type's own methods of the same name.\n  bound_slots: Dict[String, List[String]],\n  // checks of the program's own functions left out as proven, and those\n  // kept (`strata build` reports both)\n  left_out: Int,\n  kept: Int,\n  // `keeps`: which parameters each function may keep (`kept_by`), built on\n  // first use. `stack_next`: the constructor about to be compiled goes on the\n  // stack (a `let` whose value does not outlive its variable), and\n  // `stack_made` holds its field types.\n  keeps: Option[Dict[String, List[Bool]]],\n  stack_next: Bool,\n  stack_made: List[check.Ty],\n  // capabilities: field-less records shown by name alone (`Terminal`)\n  caps: Set[String] = Set[String] {},\n  // compiling one function alone on a worker (`compiled_alone`): its name\n  // prefixes the lambdas, tables and generators it makes (`lambdas` counts\n  // them). Its additions to the shared tables are kept apart, since workers\n  // only read those, and `merge_alone` adds them in order.\n  owner: String = \"\",\n  new_strings: Dict[String, String] = Dict[String, String] {},\n  new_helpers: Set[String] = Set[String] {},\n  // a list so that `merge_alone` can pair it with the queue in request\n  // order\n  new_instances: List[String] = [],\n  new_callers: List[(String, String)] = [],\n  new_failed: List[String] = [],\n  new_why: List[(String, String)] = [],\n  new_used: Set[String] = Set[String] {},\n  new_gens: Dict[String, String] = Dict[String, String] {},\n  new_unions: Dict[String, String] = Dict[String, String] {},\n  new_fns: Dict[String, ast.FnDecl] = Dict[String, ast.FnDecl] {},\n  // the calls after which a cancelled task may leave (`waits_of`): the call\n  // nodes that may reach a wait, and the functions and method names seen\n  // (`calls_wait`). `None` means every call (a supervising program, std's\n  // library).\n  waiting: Option[Set[String]] = None,\n  waits_known: Set[String] = Set[String] {},\n  // `--copies`: each copy made to change a value is reported\n  // (`strata_copied`) with its location. `sites` maps function and\n  // expression text to locations (`finding.copy_sites`), and `at` is the\n  // statement being compiled. `in_update`: compiling the copy an update\n  // falls back to, which reports it itself.\n  copies: Bool = false,\n  sites: Dict[String, String] = Dict[String, String] {},\n  // `--memory-sites`: each statement marked in the IR (`site_marker`) and\n  // each counting operation numbered and counted (`counted_sites`)\n  memory_sites: Bool = false,\n  // `--memory-sites`: the verdicts of `compiler/roots`, by function and\n  // expression text or variable (`roots.verdicts`); the codes of the\n  // expressions being compiled, innermost last; and the code of each\n  // temporary, by operand\n  roots: Dict[String, Int] = Dict[String, Int] {},\n  root_codes: List[Int] = [],\n  temp_codes: Dict[String, Int] = Dict[String, Int] {},\n  // (the hash of the statement being compiled, `roots.text_key`, and of\n  // the one each variable's slot was made in)\n  root_stmt: Int = 0,\n  slot_stmts: Dict[String, Int] = Dict[String, Int] {},\n  // (how many times each expression's key was looked up, `root_code`)\n  root_seen: Dict[String, Int] = Dict[String, Int] {},\n  at: ast.Expr = ast.UnitExpr,\n  in_update: Bool = false,\n  // the assignment being compiled already checked the elements it adds\n  // against the place's type (`checked_update`), so the whole value is not\n  // checked again\n  elements_checked: Bool = false,\n  // the expression being compiled, and the function's name as `strata\n  // check` shows it (`test \"NAME\"` for a test), for `not_yet`\n  here: ast.Expr = ast.UnitExpr,\n  shown_as: String = \"\",\n  // the `old e`s read by `ensures`: `e` as text, the name its entry value\n  // is held under, and that value\n  olds: List[(String, String, codegen.V)] = [],\n  // the updates in place proven to find their value held once\n  // (`unique.proven`), by site key. While a statement is compiled,\n  // `proven_root` is the variable its proven update changes (else \"\"), and\n  // `proven_put` the place a proven `mut p.m(…)` is about to assign.\n  proven: Set[String] = Set[String] {},\n  proven_root: String = \"\",\n  proven_put: String = \"\",\n  // small values (`small_words`): whether the function being compiled gives\n  // its result as words (`by_words`); whether the expression about to be\n  // compiled is in result position (its value is the result), and whether\n  // the call about to be compiled may leave its result on the stack (its\n  // value doesn't outlive the statement or the variable bound to it); the\n  // values in result position with the pointer each gives its caller\n  // (`result_words`: \"null\" for a block on the stack, whose words are\n  // given instead), and every block on the stack holding a small value,\n  // whose end drops its fields (`drop_stacked`)\n  by_words: Bool = false,\n  result_pos: Bool = false,\n  stack_call: Bool = false,\n  // whether the call about to be compiled is assigned to a `mut` variable\n  // (`assign_held`: its words may go into the variable's own block)\n  held_call: Bool = false,\n  rp_ptrs: Dict[String, String] = Dict[String, String] {},\n  stack_ops: Set[String] = Set[String] {},\n}","old_text":"type Gen = {\n  // module-wide\n  strings: Dict[String, String],\n  globals: List[String],\n  used: Set[String],\n  fns: Dict[String, ast.FnDecl],\n  errs: List[String],\n  // the checker's records and sums, each constructor's tag, the types with\n  // constructors, the fields' defaults\n  types: Types,\n  tags: Dict[String, Int],\n  data: Set[String],\n  defaults: Dict[String, ast.Expr],\n  // traits, and `impl`s with their type's head\n  traits: Dict[String, ast.TraitDecl],\n  impls: List[codegen.ImplEntry],\n  // helper functions made (`@\"eq:T\"`, `@\"debug:T\"`, `@\"drop:T\"`) and their\n  // text\n  helpers: Set[String],\n  helper_defs: List[String],\n  // each boxed union member's tag, and each union's name, by type key\n  box_tags: Dict[String, Int],\n  union_names: Dict[String, String],\n  // aliases with type parameters (`type Many[T] = List[T] | Problem`):\n  // their parameters and body\n  generic_aliases: Dict[String, (List[String], ast.TypeExpr)],\n  // refined types (core's `Natural` too): base and predicate. Then the\n  // `distinct` types, each field's written type (`C.f`), and each typed\n  // variable's declared type by slot.\n  refines: Dict[String, (ast.TypeExpr, ast.Expr)],\n  // a generic refined type's parameters (`NonEmpty[T]`'s `T`)\n  refine_params: Dict[String, List[String]],\n  distincts: Set[String],\n  field_types: Dict[String, ast.TypeExpr],\n  // each variant's declaration index in its sum (generators pick by it)\n  variant_index: Dict[String, Int],\n  declared: Dict[String, ast.TypeExpr],\n  // function instances asked for (by symbol), those left to compile (name,\n  // type arguments), and the count of lambdas made\n  instances: Set[String],\n  queue: List[(String, Dict[String, Ty])],\n  lambdas: Int,\n  // per function\n  fname: String,\n  // its type arguments, and whether it is in the prelude\n  sub: Dict[String, Ty],\n  in_prelude: Bool,\n  lines: List[String],\n  allocas: List[String],\n  next: Int,\n  scopes: List[codegen.Scope],\n  // each loop: the `continue` and `break` labels, and the scope depth\n  // outside it\n  loops: List[(String, String, Int)],\n  ret: Ty,\n  // each exit's result and the block it leaves from: the exit `phi`\n  rets: List[(String, String)] = [],\n  // depth of `|` alternatives being bound: their names go in slots, which\n  // each alternative stores to\n  alts: Int = 0,\n  // a match arm's names are bound borrowed: the matched value outlives the\n  // arm unchanged\n  borrowing: Bool = false,\n  // the slot whose value leaves the function: scope drops skip it\n  // (`leave_with`)\n  moved: String = \"\",\n  // cancellation unwind blocks by scope depth: the signature of what the\n  // scopes up to it hold, and the block that drops it and falls through to\n  // the ones below. Cancel points with the same signature share a block.\n  unwind_chain: List[(String, String)] = [],\n  // what `verify` proved (`strata build --strata`), by function\n  // (`proofs_of`), and the function whose proofs apply (\"\" in helpers and\n  // lambdas). Proven checks are not emitted.\n  proofs: Dict[String, List[(String, String)]],\n  proving: String,\n  // `tasks`: the program starts tasks. `supervises`: it supervises one, so\n  // a wait, a call or a fault may leave a function (`cancel_point`).\n  // `can_unwind`: the current body may leave so. `unwinds`: it does, through\n  // its `unwound` exit.\n  tasks: Bool,\n  supervises: Bool,\n  can_unwind: Bool,\n  unwinds: Bool,\n  // `extern c` functions (by key) and types (`Counter`)\n  externs: Set[String],\n  handles: Set[String],\n  // core's `builtin static` blocks (core.rt's state) and their sizes\n  statics: Dict[String, Int],\n  // compiling core.rt (`bare`): no call-stack frames and no cancel points,\n  // since the allocator runs inside every allocation\n  bare: Bool,\n  // generators made (`gen_fn`), by type and hints\n  gens: Dict[String, String],\n  // compiling fuzz drivers: functions and loops count steps\n  fuzzing: Bool,\n  // compiling verify's fuzz drivers and replays (`--fuzz`): no real\n  // capability value is made (`refuse_capability`)\n  sandboxed: Bool = false,\n  // fuzz drivers hand their arguments over as code (`strata_fuzz_arg`, for\n  // `verify`) instead of keeping them (`strata_fuzz_keep`)\n  fuzz_text: Bool,\n  // `--trace`: each call and return of the program's functions printed on\n  // stderr (`strata_trace_enter`, `strata_trace_leave`)\n  tracing: Bool,\n  // std functions taken from the precompiled library: declared, not\n  // compiled\n  precompiled: Set[String],\n  // compiling std's precompiled library (`codegen --library`): whatever\n  // depends on the codebase is left out\n  library_mode: Bool,\n  // `ret_w`: the function's result type as written, refined names kept\n  // (`List[Port]` where `ret` is `List[Int]`). `pending_w`: the written type\n  // arguments for the next call's type parameters (`T.from_json(…)` with\n  // `T` a `List[Port]`). They decide what `T.check(v)` checks in an\n  // instance (its sub's `$w:T`).\n  ret_w: Ty = TAny,\n  pending_w: Dict[String, Ty] = Dict[String, Ty] {},\n  // the function being compiled (its key), the callers of each function\n  // (by key), and the functions with something not compiled: std's\n  // library leaves these out\n  current: String,\n  callers: Dict[String, Set[String]],\n  failed: Set[String],\n  // `not_yet`'s errors for each of those, for verify's fuzz drivers to\n  // report\n  why: Dict[String, List[String]],\n  // parameters typed by a bounded type parameter (`x: T` with `T: Log`, or\n  // a trait's type compiled for a known type in `for_impls`), by slot, with\n  // their bounds. Their methods resolve to the bounds' methods, ahead of\n  // the type's own methods of the same name.\n  bound_slots: Dict[String, List[String]],\n  // checks of the program's own functions left out as proven, and those\n  // kept (`strata build` reports both)\n  left_out: Int,\n  kept: Int,\n  // `keeps`: which parameters each function may keep (`kept_by`), built on\n  // first use. `stack_next`: the constructor about to be compiled goes on the\n  // stack (a `let` whose value does not outlive its variable), and\n  // `stack_made` holds its field types.\n  keeps: Option[Dict[String, List[Bool]]],\n  stack_next: Bool,\n  stack_made: List[Ty],\n  // capabilities: field-less records shown by name alone (`Terminal`)\n  caps: Set[String] = Set[String] {},\n  // compiling one function alone on a worker (`compiled_alone`): its name\n  // prefixes the lambdas, tables and generators it makes (`lambdas` counts\n  // them). Its additions to the shared tables are kept apart, since workers\n  // only read those, and `merge_alone` adds them in order.\n  owner: String = \"\",\n  new_strings: Dict[String, String] = Dict[String, String] {},\n  new_helpers: Set[String] = Set[String] {},\n  // a list so that `merge_alone` can pair it with the queue in request\n  // order\n  new_instances: List[String] = [],\n  new_callers: List[(String, String)] = [],\n  new_failed: List[String] = [],\n  new_why: List[(String, String)] = [],\n  new_used: Set[String] = Set[String] {},\n  new_gens: Dict[String, String] = Dict[String, String] {},\n  new_unions: Dict[String, String] = Dict[String, String] {},\n  new_fns: Dict[String, ast.FnDecl] = Dict[String, ast.FnDecl] {},\n  // the calls after which a cancelled task may leave (`waits_of`): the call\n  // nodes that may reach a wait, and the functions and method names seen\n  // (`calls_wait`). `None` means every call (a supervising program, std's\n  // library).\n  waiting: Option[Set[String]] = None,\n  waits_known: Set[String] = Set[String] {},\n  // `--copies`: each copy made to change a value is reported\n  // (`strata_copied`) with its location. `sites` maps function and\n  // expression text to locations (`finding.copy_sites`), and `at` is the\n  // statement being compiled. `in_update`: compiling the copy an update\n  // falls back to, which reports it itself.\n  copies: Bool = false,\n  sites: Dict[String, String] = Dict[String, String] {},\n  // `--memory-sites`: each statement marked in the IR (`site_marker`) and\n  // each counting operation numbered and counted (`counted_sites`)\n  memory_sites: Bool = false,\n  // `--memory-sites`: the verdicts of `compiler/roots`, by function and\n  // expression text or variable (`roots.verdicts`); the codes of the\n  // expressions being compiled, innermost last; and the code of each\n  // temporary, by operand\n  roots: Dict[String, Int] = Dict[String, Int] {},\n  root_codes: List[Int] = [],\n  temp_codes: Dict[String, Int] = Dict[String, Int] {},\n  // (the hash of the statement being compiled, `roots.text_key`, and of\n  // the one each variable's slot was made in)\n  root_stmt: Int = 0,\n  slot_stmts: Dict[String, Int] = Dict[String, Int] {},\n  // (how many times each expression's key was looked up, `root_code`)\n  root_seen: Dict[String, Int] = Dict[String, Int] {},\n  at: ast.Expr = ast.UnitExpr,\n  in_update: Bool = false,\n  // the assignment being compiled already checked the elements it adds\n  // against the place's type (`checked_update`), so the whole value is not\n  // checked again\n  elements_checked: Bool = false,\n  // the expression being compiled, and the function's name as `strata\n  // check` shows it (`test \"NAME\"` for a test), for `not_yet`\n  here: ast.Expr = ast.UnitExpr,\n  shown_as: String = \"\",\n  // the `old e`s read by `ensures`: `e` as text, the name its entry value\n  // is held under, and that value\n  olds: List[(String, String, codegen.V)] = [],\n  // the updates in place proven to find their value held once\n  // (`unique.proven`), by site key. While a statement is compiled,\n  // `proven_root` is the variable its proven update changes (else \"\"), and\n  // `proven_put` the place a proven `mut p.m(…)` is about to assign.\n  proven: Set[String] = Set[String] {},\n  proven_root: String = \"\",\n  proven_put: String = \"\",\n  // small values (`small_words`): whether the function being compiled gives\n  // its result as words (`by_words`); whether the expression about to be\n  // compiled is in result position (its value is the result), and whether\n  // the call about to be compiled may leave its result on the stack (its\n  // value doesn't outlive the statement or the variable bound to it); the\n  // values in result position with the pointer each gives its caller\n  // (`result_words`: \"null\" for a block on the stack, whose words are\n  // given instead), and every block on the stack holding a small value,\n  // whose end drops its fields (`drop_stacked`)\n  by_words: Bool = false,\n  result_pos: Bool = false,\n  stack_call: Bool = false,\n  // whether the call about to be compiled is assigned to a `mut` variable\n  // (`assign_held`: its words may go into the variable's own block)\n  held_call: Bool = false,\n  rp_ptrs: Dict[String, String] = Dict[String, String] {},\n  stack_ops: Set[String] = Set[String] {},\n}"},{"name":"codegen.lower","kind":"fn","old":"d95ab1456b0f474a","new":"7beb7da25a37385c","interface_changed":true,"affected":["codegen.entry","codegen.function","codegen.declare","codegen.destructure","codegen.scheme","codegen.method_call","codegen.vtable","codegen.dyn_call","codegen.add_type","codegen.generic_ty","codegen.main_arg","codegen.foreign_call","codegen.generated","codegen.gen_fn","codegen.gen_list","codegen.gen_data","codegen.mock_method","codegen.fuzz_driver","codegen.check_payload","codegen.check_union","codegen.check_member","codegen.declaration_of","codegen.precompilable","codegen.new_gen","codegen.read_back","codegen.self_want","codegen.mock_call","codegen.dyn_generic_call","codegen.lambda_shown","codegen.checked_update","codegen.expr_node","codegen.stmt_node","codegen.built_or_generated","codegen.build_fn","codegen.session_entry","codegen.export_entry","codegen.plain_want","codegen.generate","codegen.compiled_alone","codegen.function_value","codegen.call_fn_want","codegen.expr_want_node","codegen.to_dyn","codegen.dyn_table_is","codegen.call_named","codegen.clock_now","codegen.bind_bounds","codegen.impl_args","codegen.produce","codegen.generated_args","codegen.can_generate","codegen.mock_table","codegen.check_type","codegen.instance","computed_value","repl_eval","codegen.lambda","codegen.expr","codegen.stmt","codegen.stack_let","codegen_with","core_rt_text","codegen.call_fn","codegen.options","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.expr_want","codegen.dyn_wrapper","codegen.converted","codegen.session_capability","codegen.dyn_ctor_is","codegen.matching_v","codegen.select_expr","codegen.makers","codegen.mock_value","codegen.construct_want","codegen.check_field","codegen.assign_at","codegen.set_in_place","comptime_value","repl_command","codegen.spawn_expr","codegen.method_value","codegen.interp","codegen.binary","codegen.logic","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.await_expr","codegen.race_expr","codegen.call_entry","codegen.operands_want","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.try_want","codegen.tag_test","codegen.update_in_place","codegen.take_in_place","codegen.compared","codegen.decreases_pass","codegen.decreases_call","codegen.keep_olds","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.block_expr","codegen.iterate","codegen.decreases_start","codegen.decreases_entry","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.builtin_call","codegen.union_call","codegen.host","codegen.list_literal_of","codegen.scope_expr","codegen.channel_new","codegen.wanted","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.appended","codegen.list_builtin","codegen.table_find","codegen.tag_is","codegen.construct","comptime_values","strata_command","codegen.binds","codegen.assertion","codegen.invariants","codegen.satisfies","codegen.holds_pred","codegen.operands","codegen.if_expr","codegen.matching","codegen.try_expr","codegen.get_field","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","check_command","verify_command","build_command","run_command","static_graph","program_objects","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","codegen.list_literal","codegen.to_c","codegen.has_field_check","expanded","comptime_runner","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","codegen.helper","codegen.debug_body","with_base","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","codegen.equal","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","eval_files","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"fn lower(mut g: codegen.Gen, t: ast.TypeExpr) -> check.Ty {\n  // In order: a type parameter of the instance, a trait used as a type, an\n  // alias (core's refined names lower to their base types, since their\n  // checks are contracts), a union, a C handle.\n  match t {\n    ast.Named { name: h, args: [] } => if contains(g.handles, h) {\n      return check.TNamed { name: \"extern:\" + h, args: [] }\n    },\n    _ => (),\n  }\n  // core.mem's `Ptr`: an address, never counted (like a C handle)\n  match t {\n    ast.Named { name: \"Ptr\", args: [] } => return check.TNamed { name: \"extern:Ptr\", args: [] },\n    _ => (),\n  }\n  match t {\n    // an alias with type parameters, given its arguments\n    ast.Named { name, args } => match get(g.generic_aliases, name) {\n      Some((ps, a)) => if len(args) > 0 && len(ps) == len(args) {\n        mut sub := g.sub\n        for (k, p) in enumerate(ps) {\n          mut sub.insert(\n            p,\n            codegen.lower(mut g, get(args, k) ?? ast.UnitType),\n          )\n        }\n        saved := g.sub\n        g.sub = sub\n        u := codegen.lower(mut g, a)\n        g.sub = saved\n        match u {\n          check.TUnion(_) => codegen.put_union(mut g, codegen.key(u), name),\n          _ => (),\n        }\n        return u\n      },\n      None => (),\n    },\n    _ => (),\n  }\n  match t {\n    ast.Named { name: \"NonEmpty\", args: [a] } => return check.TList(codegen.lower(mut g, a)),\n    ast.Named { name, args: [] } => match get(g.sub, name) {\n      Some(x) => return x,\n      None => if contains(g.traits, name) {\n        return check.TTrait(name)\n      } else if [\"Natural\", \"Positive\", \"Negative\", \"NonZero\"].any(\n        n -> n == name,\n      ) {\n        return check.TInt\n      } else if name == \"Probability\" || name == \"Percentage\" {\n        return check.TFloat\n      } else if name == \"NonEmptyString\" {\n        return check.TStr\n      } else {\n        match get(g.types.aliases, name) {\n          Some(a) => {\n            u := codegen.lower(mut g, a)\n            match u {\n              check.TUnion(_) => codegen.put_union(mut g, codegen.key(u), name),\n              _ => (),\n            }\n            return u\n          },\n          None => (),\n        }\n      },\n    },\n    // a channel end or a task handle\n    ast.Named { name: n, args: [a] } => if n == \"Sender\" || n == \"Receiver\" || n == \"Task\" {\n      return check.TNamed { name: n, args: [codegen.lower(mut g, a)] }\n    } else if contains(g.traits, n) {\n      return check.TTrait(n)\n    },\n    // a trait with type arguments (`Iterator[Int]`): its values, and calls\n    // on one of known type compiled for that type\n    ast.Named { name: tn, args: [_, ..] } => if contains(g.traits, tn) {\n      return check.TTrait(tn)\n    },\n    ast.UnionType(ms) => {\n      mut ts := []\n      for m in ms {\n        mut ts.push(codegen.lower(mut g, m))\n      }\n      return codegen.union_ty(codegen.whole_sums(g, ts))\n    },\n    ast.Refined { base, .. } => return codegen.lower(mut g, base),\n    _ => (),\n  }\n  match t {\n    ast.Named { name, args: [] } => if codegen.is_word(name) {\n      return check.TNamed { name, args: [] }\n    },\n    _ => (),\n  }\n  match t {\n    ast.Named { name: \"Int\", args: [] } => check.TInt,\n    ast.Named { name: \"Float\", args: [] } => check.TFloat,\n    ast.Named { name: \"Bool\", args: [] } => check.TBool,\n    ast.Named { name: \"String\", args: [] } => check.TStr,\n    ast.UnitType => check.TUnit,\n    ast.Named { name: \"List\", args: [a] } => check.TList(codegen.lower(mut g, a)),\n    ast.Named { name: \"Set\", args: [a] } => check.TNamed { name: \"Set\", args: [codegen.lower(mut g, a)] },\n    ast.Named { name: \"Dict\", args: [k, v] } => {\n      kt := codegen.lower(mut g, k)\n      check.TNamed {\n        name: \"Dict\",\n        args: [kt, codegen.lower(mut g, v)],\n      }\n    },\n    ast.FnType { params, ret } => {\n      mut ps := []\n      for x in params {\n        mut ps.push(codegen.lower(mut g, x))\n      }\n      check.TFn { params: ps, ret: codegen.lower(mut g, ret) }\n    },\n    ast.Named { name, args } => {\n      n := match get(g.types.named, name) {\n        Some(ps) => len(ps),\n        None => -1,\n      }\n      if name == \"Tuple\" || contains(g.data, name) && n == len(args) {\n        mut xs := []\n        for a in args {\n          mut xs.push(codegen.lower(mut g, a))\n        }\n        check.TN