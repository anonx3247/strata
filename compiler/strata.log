q","codegen.slot_fn","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// The table of trait `tr` for type `t`: its drop, show, debug, eq and dup,\n/// the trait's methods, then marking the value shared (`share_fn`).\nfn vtable(mut g: codegen.Gen, tr: String, t: check.Ty) -> String {\n  name := f\"@\\\"vt:{tr}:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  mut entries := [codegen.dyn_wrapper(\n    mut g,\n    \"drop\",\n    t,\n    [],\n    check.TUnit,\n    \"\",\n    tr,\n    [],\n    [],\n  ), codegen.dyn_wrapper(\n    mut g,\n    \"show\",\n    t,\n    [],\n    check.TStr,\n    \"\",\n    tr,\n    [],\n    [],\n  ), codegen.dyn_wrapper(\n    mut g,\n    \"debug\",\n    t,\n    [],\n    check.TStr,\n    \"\",\n    tr,\n    [],\n    [],\n  ), codegen.dyn_wrapper(\n    mut g,\n    \"eq\",\n    t,\n    [t],\n    check.TBool,\n    \"\",\n    tr,\n    [],\n    [],\n  ), codegen.dyn_wrapper(\n    mut g,\n    \"dup\",\n    t,\n    [],\n    check.TUnit,\n    \"\",\n    tr,\n    [],\n    [],\n  )]\n  for m in codegen.dyn_methods(g, tr) {\n    // a generic method has no entry: its calls dispatch on the table\n    // (`dyn_generic_call`)\n    if m.decl.type_params != [] {\n      mut entries.push(\"null\")\n      continue\n    }\n    // the trait's implementation, ahead of a same-named method in the\n    // type's own `impl` (`impl Item { fn describe }` next to\n    // `impl Describe for Item`)\n    k := match codegen.trait_method_key(\n      mut g,\n      codegen.declaring_trait(g, tr, m.decl.name),\n      codegen.head_of(t),\n      m.decl.name,\n    ) {\n      \"\" => codegen.method_key(mut g, codegen.head_of(t), m.decl.name),\n      found => found,\n    }\n    // its parameters after `self`, and its result, as the trait declares\n    saved := g.sub\n    mut g.sub.insert(\"Self\", t)\n    mut ps := []\n    mut selfs := []\n    mut muts := []\n    for (i, p) in enumerate(drop(m.decl.params, 1)) {\n      mut ps.push(codegen.lower(mut g, p.ty))\n      if codegen.is_self_type(p.ty) {\n        mut selfs.push(i)\n      }\n      if p.mutable {\n        mut muts.push(i)\n      }\n    }\n    if codegen.is_self_type(m.decl.ret) {\n      mut selfs.push(-1)\n    }\n    rt := codegen.lower(mut g, m.decl.ret)\n    g.sub = saved\n    what := if codegen.mut_self_decl(m.decl) {\n      \"mut\"\n    } else {\n      \"method\"\n    }\n    // a mock type's `impl` may leave a method out: a generated result\n    mut entries.push(\n      if k == \"\" {\n        codegen.mock_method(mut g, tr, m.decl)\n      } else {\n        codegen.dyn_wrapper(\n          mut g,\n          what,\n          t,\n          ps,\n          rt,\n          k,\n          tr,\n          selfs,\n          muts,\n        )\n      },\n    )\n  }\n  // (last, after the methods: marking the value shared, `share_fn`)\n  mut entries.push(\n    codegen.dyn_wrapper(\n      mut g,\n      \"share\",\n      t,\n      [],\n      check.TUnit,\n      \"\",\n      tr,\n      [],\n      [],\n    ),\n  )\n  xs := join(entries.map(e -> \"ptr \" + e), \", \")\n  mut g.globals.push(\n    f\"{name} = private unnamed_addr constant [{len(entries)} x ptr] [{xs}], align 8\",\n  )\n  name\n}","old_text":"/// The table of trait `tr` for type `t`: its drop, show, debug, eq and dup,\n/// the trait's methods, then marking the value shared (`share_fn`).\nfn vtable(mut g: codegen.Gen, tr: String, t: Ty) -> String {\n  name := f\"@\\\"vt:{tr}:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  mut entries := [\n    codegen.dyn_wrapper(mut g, \"drop\", t, [], TUnit, \"\", tr, [], []),\n    codegen.dyn_wrapper(mut g, \"show\", t, [], TStr, \"\", tr, [], []),\n    codegen.dyn_wrapper(mut g, \"debug\", t, [], TStr, \"\", tr, [], []),\n    codegen.dyn_wrapper(mut g, \"eq\", t, [t], TBool, \"\", tr, [], []),\n    codegen.dyn_wrapper(mut g, \"dup\", t, [], TUnit, \"\", tr, [], []),\n  ]\n  for m in codegen.dyn_methods(g, tr) {\n    // a generic method has no entry: its calls dispatch on the table\n    // (`dyn_generic_call`)\n    if m.decl.type_params != [] {\n      mut entries.push(\"null\")\n      continue\n    }\n    // the trait's implementation, ahead of a same-named method in the\n    // type's own `impl` (`impl Item { fn describe }` next to\n    // `impl Describe for Item`)\n    k := match codegen.trait_method_key(\n      mut g,\n      codegen.declaring_trait(g, tr, m.decl.name),\n      codegen.head_of(t),\n      m.decl.name,\n    ) {\n      \"\" => codegen.method_key(mut g, codegen.head_of(t), m.decl.name),\n      found => found,\n    }\n    // its parameters after `self`, and its result, as the trait declares\n    saved := g.sub\n    mut g.sub.insert(\"Self\", t)\n    mut ps := []\n    mut selfs := []\n    mut muts := []\n    for (i, p) in enumerate(drop(m.decl.params, 1)) {\n      mut ps.push(codegen.lower(mut g, p.ty))\n      if codegen.is_self_type(p.ty) {\n        mut selfs.push(i)\n      }\n      if p.mutable {\n        mut muts.push(i)\n      }\n    }\n    if codegen.is_self_type(m.decl.ret) {\n      mut selfs.push(-1)\n    }\n    rt := codegen.lower(mut g, m.decl.ret)\n    g.sub = saved\n    what := if codegen.mut_self_decl(m.decl) {\n      \"mut\"\n    } else {\n      \"method\"\n    }\n    // a mock type's `impl` may leave a method out: a generated result\n    mut entries.push(\n      if k == \"\" {\n        codegen.mock_method(mut g, tr, m.decl)\n      } else {\n        codegen.dyn_wrapper(\n          mut g,\n          what,\n          t,\n          ps,\n          rt,\n          k,\n          tr,\n          selfs,\n          muts,\n        )\n      },\n    )\n  }\n  // (last, after the methods: marking the value shared, `share_fn`)\n  mut entries.push(\n    codegen.dyn_wrapper(\n      mut g,\n      \"share\",\n      t,\n      [],\n      TUnit,\n      \"\",\n      tr,\n      [],\n      [],\n    ),\n  )\n  xs := join(entries.map(e -> \"ptr \" + e), \", \")\n  mut g.globals.push(\n    f\"{name} = private unnamed_addr constant [{len(entries)} x ptr] [{xs}], align 8\",\n  )\n  name\n}"},{"name":"codegen.dyn_wrapper","kind":"fn","old":"aae4f3f24b919239","new":"b2fea05ec7e9b7dd","interface_changed":true,"affected":["codegen.vtable","codegen.to_dyn","codegen.dyn_table_is","codegen.main_arg","codegen.converted","codegen.session_capability","codegen.dyn_ctor_is","codegen.dyn_generic_call","codegen.matching_v","codegen.entry","codegen.list_builtin","codegen.collection_builtin","codegen.list_literal_of","codegen.produce","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.update_in_place","codegen.table_find","codegen.set_in_place","codegen.take_in_place","codegen.expr_want_node","codegen.stmt_node","codegen.session_entry","codegen.tag_is","codegen.dyn_call","codegen.matching_want","codegen.generate","codegen.builtin","codegen.gen_list","codegen.list_literal","codegen.gen_fn","codegen.construct","codegen.operands","codegen.binary","codegen.builtin_call","codegen.branch_value","codegen.mock_call","codegen.expr_want","codegen.stmt","codegen.matches","codegen.options","codegen.to_c","codegen.check_payload","codegen.try_want","codegen.or_else","codegen.expr_node","codegen.has_field_check","codegen.call_named","codegen.method_call","codegen.clock_now","codegen.matching","codegen_with","core_rt_text","computed_value","repl_eval","codegen.push_in_place","codegen.generated","codegen.can_generate","codegen.for_loop","codegen.union_call","codegen.compared","codegen.except_expr","codegen.if_want","codegen.match_got","codegen.function","codegen.declare","codegen.destructure","codegen.block_expr","codegen.call_fn_want","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.lambda_shown","codegen.list_get_or","codegen.checked_update","codegen.appended","codegen.build_fn","codegen.iterate","codegen.decreases_start","codegen.decreases_pass","codegen.decreases_entry","codegen.decreases_call","codegen.binds","codegen.foreign_call","codegen.export_entry","codegen.check_type","codegen.try_expr","codegen.expr","codegen.get_field","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.gen_data","codegen.mock_method","codegen.built_or_generated","codegen.generated_args","codegen.makers","codegen.checked","codegen.if_expr","codegen.compiled_alone","codegen.call_fn","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.function_value","codegen.lambda","codegen.for_list","codegen.check_field","codegen.assign_at","codegen.interp","codegen.logic","codegen.loop_body","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.await_expr","codegen.race_expr","codegen.call_entry","codegen.tag_test","codegen.keep_olds","codegen.expr_on_stack","codegen.assigned_call","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.mock_table","codegen.assertion","codegen.invariants","codegen.show","codegen.shown","codegen.string_builtin","codegen.host","codegen.spawn_expr","codegen.method_value","codegen.satisfies","codegen.holds_pred","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.mock_value","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","codegen.check_union","codegen.check_member","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.helper","codegen.debug_body","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.equal","codegen.read_back","eval_files","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// A table entry's function. It loads the value from its slot and passes\n/// it to `what`: `drop`, `dup`, `share`, `show`, `debug`, `eq` (with a\n/// second slot), or method `k` with the other arguments as `%argN` (a name\n/// `fresh` never makes).\n/// - `mut`: a `mut self` method, given the address of the value's cell.\n/// - `selfs`: positions typed `Self` by the trait (-1 is the result). They\n/// are trait `tr` values outside: unwrapped going in, wrapped coming out.\n/// - `muts`: `mut` parameters, given the caller's slot address.\nfn dyn_wrapper(\n  mut g: codegen.Gen,\n  what: String,\n  t: check.Ty,\n  ps: List[check.Ty],\n  rt: check.Ty,\n  k: String,\n  tr: String,\n  selfs: List[Int],\n  muts: List[Int],\n) -> String {\n  g.lambdas += 1\n  sym := f\"@\\\"dyn.{what}.{g.owner}{g.lambdas}\\\"\"\n  saved := g\n  g.lines = []\n  g.proving = \"\"\n  g.can_unwind = false\n  g.unwinds = false\n  g.unwind_chain = []\n  g.allocas = []\n  g.next = 0\n  g.scopes = [codegen.no_scope()]\n  g.loops = []\n  codegen.block(mut g, \"start\")\n  // a `mut self` method: `%s` is the address of the value's cell in the\n  // trait value, written back after the call\n  mut cell := \"\"\n  self_v := if what == \"mut\" {\n    (c, sl) := (codegen.fresh(mut g, \"cell\"), codegen.fresh(mut g, \"sl\"))\n    codegen.emit(mut g, f\"{c} = inttoptr i64 %s to ptr\")\n    codegen.emit(mut g, f\"{sl} = load i64, ptr {c}\")\n    cell = c\n    codegen.from_slot(mut g, sl, t)\n  } else {\n    codegen.from_slot(mut g, \"%s\", t)\n  }\n  mut sig := [\"i64 %s\"]\n  mut args := []\n  if what == \"eq\" {\n    mut sig.push(\"i64 %o\")\n  } else {\n    for (i, pt) in enumerate(ps) {\n      if contains(muts, i) {\n        // a `mut` parameter: the caller's slot address, passed on\n        mut sig.push(f\"ptr %arg{i}\")\n        mut args.push(codegen.V { ty: check.TStr, op: f\"%arg{i}\" })\n      } else if contains(selfs, i) {\n        mut sig.push(f\"ptr %arg{i}\")\n        mut args.push(\n          codegen.dyn_value(\n            mut g,\n            codegen.V { ty: check.TTrait(tr), op: f\"%arg{i}\" },\n            pt,\n          ),\n        )\n      } else {\n        if codegen.has_value(pt) {\n          mut sig.push(f\"{codegen.ll(pt)} %arg{i}\")\n        }\n        mut args.push(codegen.V { ty: pt, op: f\"%arg{i}\" })\n      }\n    }\n  }\n  r0 := match what {\n    \"drop\" => {\n      codegen.drop_value(mut g, self_v)\n      codegen.unit()\n    },\n    \"dup\" => {\n      codegen.dup_value(mut g, self_v)\n      codegen.unit()\n    },\n    \"share\" => {\n      codegen.share_value(mut g, self_v)\n      codegen.unit()\n    },\n    \"show\" => codegen.show(mut g, self_v),\n    \"debug\" => codegen.shown(mut g, self_v),\n    \"eq\" => {\n      o := codegen.from_slot(mut g, \"%o\", t)\n      codegen.equal(mut g, self_v, o)\n    },\n    \"mut\" => {\n      slot := codegen.fresh(mut g, \"self\")\n      mut g.allocas.push(f\"  {slot} = alloca {codegen.ll(t)}\")\n      codegen.emit(\n        mut g,\n        f\"store {codegen.ll(t)} {self_v.op}, ptr {slot}\",\n      )\n      r := codegen.call_fn(\n        mut g,\n        k,\n        [codegen.V { ty: check.TStr, op: slot }] + args,\n        [],\n      )\n      nb := codegen.fresh(mut g, \"back\")\n      codegen.emit(\n        mut g,\n        f\"{nb} = load {codegen.ll(t)}, ptr {slot}\",\n      )\n      s2 := codegen.to_slot(mut g, codegen.V { ty: t, op: nb })\n      codegen.emit(mut g, f\"store i64 {s2}, ptr {cell}\")\n      r\n    },\n    _ => codegen.call_fn(mut g, k, [self_v] + args, []),\n  }\n  // a `Self` result is wrapped in a trait value\n  wrap := contains(selfs, -1) && !(r0.ty is check.TAny)\n  r := if wrap {\n    codegen.to_dyn(mut g, r0, tr)\n  } else {\n    r0\n  }\n  ret := if wrap {\n    check.TTrait(tr)\n  } else if what == \"method\" || what == \"mut\" {\n    rt\n  } else {\n    r.ty\n  }\n  if codegen.has_value(ret) && !(r.ty is check.TAny) {\n    codegen.leave_with(mut g, r)\n    codegen.emit(mut g, f\"ret {codegen.ll(ret)} {r.op}\")\n  } else {\n    codegen.drop_from(mut g, 0, \"\")\n    codegen.emit(mut g, \"ret void\")\n  }\n  def := join([f\"define {codegen.ll(ret)} {sym}({join(sig, \", \")}) {{\"]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, def)\n  sym\n}","old_text":"/// A table entry's function. It loads the value from its slot and passes\n/// it to `what`: `drop`, `dup`, `share`, `show`, `debug`, `eq` (with a\n/// second slot), or method `k` with the other arguments as `%argN` (a name\n/// `fresh` never makes).\n/// - `mut`: a `mut self` method, given the address of the value's cell.\n/// - `selfs`: positions typed `Self` by the trait (-1 is the result). They\n/// are trait `tr` values outside: unwrapped going in, wrapped coming out.\n/// - `muts`: `mut` parameters, given the caller's slot address.\nfn dyn_wrapper(\n  mut g: codegen.Gen,\n  what: String,\n  t: Ty,\n  ps: List[Ty],\n  rt: Ty,\n  k: String,\n  tr: String,\n  selfs: List[Int],\n  muts: List[Int],\n) -> String {\n  g.lambdas += 1\n  sym := f\"@\\\"dyn.{what}.{g.owner}{g.lambdas}\\\"\"\n  saved := g\n  g.lines = []\n  g.proving 