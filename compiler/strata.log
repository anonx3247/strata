","codegen.appended","codegen.session_entry","codegen.gen_fn","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.to_c","codegen.gen_data","codegen.mock_value","codegen.list_literal","codegen.generated","codegen.can_generate","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.foreign_call","codegen.generated_args","codegen.makers","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// The helper `what` (`eq`, `debug`) for type `t`, made once. Returns its\n/// symbol.\nfn helper(mut g: codegen.Gen, what: String, t: check.Ty) -> String {\n  name := f\"@\\\"{what}:{codegen.key(t)}\\\"\"\n  // the node for an equality or a text made once\n  node := \"helper:\" + name\n  codegen.add_caller(mut g, node)\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  saved := g\n  g.current = node\n  g.lines = []\n  g.proving = \"\"\n  g.can_unwind = false\n  g.unwinds = false\n  g.unwind_chain = []\n  g.allocas = []\n  g.next = 0\n  g.scopes = [codegen.no_scope()]\n  g.loops = []\n  codegen.block(mut g, \"start\")\n  a := codegen.V { ty: t, op: \"%a\" }\n  sig := if what == \"eq\" {\n    match t {\n      check.TList(et) => codegen.eq_list(mut g, a, codegen.V { ty: t, op: \"%b\" }, et),\n      check.TUnion(ms) => codegen.union_eq(mut g, a, codegen.V { ty: t, op: \"%b\" }, ms),\n      _ => codegen.eq_body(mut g, a, codegen.V { ty: t, op: \"%b\" }),\n    }\n    f\"define i1 {name}(ptr %a, ptr %b)\"\n  } else {\n    match t {\n      check.TList(et) => codegen.debug_list(mut g, a, et, \"[\", \"]\", \"[]\", false),\n      check.TNamed { name: \"Set\", args: [et] } => codegen.debug_list(\n        mut g,\n        codegen.list_view(mut g, a),\n        et,\n        \"Set { \",\n        \" }\",\n        \"Set {}\",\n        false,\n      ),\n      check.TNamed { name: \"Dict\", args } => codegen.debug_list(\n        mut g,\n        codegen.list_view(mut g, a),\n        check.TNamed { name: \"Tuple\", args },\n        \"Dict { \",\n        \" }\",\n        \"Dict {}\",\n        true,\n      ),\n      check.TUnion(ms) => codegen.union_text(mut g, a, ms, what == \"show\"),\n      _ => codegen.debug_body(mut g, a),\n    }\n    f\"define ptr {name}(ptr %a)\"\n  }\n  def := join([sig + \" {\"]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, def)\n  name\n}","old_text":"/// The helper `what` (`eq`, `debug`) for type `t`, made once. Returns its\n/// symbol.\nfn helper(mut g: codegen.Gen, what: String, t: Ty) -> String {\n  name := f\"@\\\"{what}:{codegen.key(t)}\\\"\"\n  // the node for an equality or a text made once\n  node := \"helper:\" + name\n  codegen.add_caller(mut g, node)\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  saved := g\n  g.current = node\n  g.lines = []\n  g.proving = \"\"\n  g.can_unwind = false\n  g.unwinds = false\n  g.unwind_chain = []\n  g.allocas = []\n  g.next = 0\n  g.scopes = [codegen.no_scope()]\n  g.loops = []\n  codegen.block(mut g, \"start\")\n  a := codegen.V { ty: t, op: \"%a\" }\n  sig := if what == \"eq\" {\n    match t {\n      TList(et) => codegen.eq_list(mut g, a, codegen.V { ty: t, op: \"%b\" }, et),\n      TUnion(ms) => codegen.union_eq(mut g, a, codegen.V { ty: t, op: \"%b\" }, ms),\n      _ => codegen.eq_body(mut g, a, codegen.V { ty: t, op: \"%b\" }),\n    }\n    f\"define i1 {name}(ptr %a, ptr %b)\"\n  } else {\n    match t {\n      TList(et) => codegen.debug_list(mut g, a, et, \"[\", \"]\", \"[]\", false),\n      TNamed { name: \"Set\", args: [et] } => codegen.debug_list(\n        mut g,\n        codegen.list_view(mut g, a),\n        et,\n        \"Set { \",\n        \" }\",\n        \"Set {}\",\n        false,\n      ),\n      TNamed { name: \"Dict\", args } => codegen.debug_list(\n        mut g,\n        codegen.list_view(mut g, a),\n        TNamed { name: \"Tuple\", args },\n        \"Dict { \",\n        \" }\",\n        \"Dict {}\",\n        true,\n      ),\n      TUnion(ms) => codegen.union_text(mut g, a, ms, what == \"show\"),\n      _ => codegen.debug_body(mut g, a),\n    }\n    f\"define ptr {name}(ptr %a)\"\n  }\n  def := join([sig + \" {\"]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, def)\n  name\n}"},{"name":"codegen.eq_body","kind":"fn","old":"1ea4a452f60d8616","new":"eba36ef94124609d","interface_changed":false,"affected":[],"module":"codegen","text":"/// `eq`: the same block, or the same constructor with equal fields.\nfn eq_body(mut g: codegen.Gen, a: codegen.V, b: codegen.V) {\n  same := codegen.fresh(mut g, \"same\")\n  codegen.emit(mut g, f\"{same} = icmp eq ptr %a, %b\")\n  codegen.emit(mut g, f\"br i1 {same}, label %yes, label %compare\")\n  codegen.block(mut g, \"compare\")\n  match a.ty {\n    check.TNamed { name: \"Tuple\", args } => codegen.eq_fields(mut g, a, b, args),\n    _ => {\n      cs := codegen.ctors_of(g, a.ty)\n      if len(cs) == 1 {\n        codegen.eq_fields(\n          mut g,\n          a,\n          b,\n          codegen.fields_of(g, get(cs, 0) ?? \"\", a.ty).map(f -> f.1),\n        )\n      } else {\n        (ta, tb) := (codegen.tag_of(mut g, a), codegen.tag_of(mut g, b))\n        st := codegen.fresh(mut g, \"sametag\")\n        codegen.emit(mut g, f\"{st} = icmp eq i64 {ta}, {tb}\")\n        codegen.emit(mut g, f\"br i1 {st}, label %fields, label %no\")\n        codegen.block(mut g, \"fields\")\n        labels := codegen.on_ctor(mut g, a, cs)\n        for (k, c) in enumerate(cs) {\n          codegen.block(mut g, get(labels, k) ?? \"\")\n          codegen.eq_fields(\n            mut g,\n            a,\n            b,\n            codegen.fields_of(g, c, a.ty).map(f -> f.1),\n          )\n        }\n      }\n    },\n  }\n  codegen.block(mut g, \"yes\")\n  codegen.emit(mut g, \"ret i1 true\")\n  codegen.block(mut g, \"no\")\n  codegen.emit(mut g, \"ret i1 false\")\n}","old_text":"/// `eq`: the same block, or the same constructor with equal fields.\nfn eq_body(mut g: codegen.Gen, a: codegen.V, b: codegen.V) {\n  same := codegen.fresh(mut g, \"same\")\n  codegen.emit(mut g, f\"{same} = icmp eq ptr %a, %b\")\n  codegen.emit(mut g, f\"br i1 {same}, label %yes, label %compare\")\n  codegen.block(mut g, \"compare\")\n  match a.ty {\n    TNamed { name: \"Tuple\", args } => codegen.eq_fields(mut g, a, b, args),\n    _ => {\n      cs := codegen.ctors_of(g, a.ty)\n      if len(cs) == 1 {\n        codegen.eq_fields(\n          mut g,\n          a,\n          b,\n          codegen.fields_of(g, get(cs, 0) ?? \"\", a.ty).map(f -> f.1),\n        )\n      } else {\n        (ta, tb) := (codegen.tag_of(mut g, a), codegen.tag_of(mut g, b))\n        st := codegen.fresh(mut g, \"sametag\")\n        codegen.emit(mut g, f\"{st} = icmp eq i64 {ta}, {tb}\")\n        codegen.emit(mut g, f\"br i1 {st}, label %fields, label %no\")\n        codegen.block(mut g, \"fields\")\n        labels := codegen.on_ctor(mut g, a, cs)\n        for (k, c) in enumerate(cs) {\n          codegen.block(mut g, get(labels, k) ?? \"\")\n          codegen.eq_fields(\n            mut g,\n            a,\n            b,\n            codegen.fields_of(g, c, a.ty).map(f -> f.1),\n          )\n        }\n      }\n    },\n  }\n  codegen.block(mut g, \"yes\")\n  codegen.emit(mut g, \"ret i1 true\")\n  codegen.block(mut g, \"no\")\n  codegen.emit(mut g, \"ret i1 false\")\n}"},{"name":"codegen.eq_fields","kind":"fn","old":"fc9ae5b605bb36da","new":"e97816af289706a7","interface_changed":true,"affected":["codegen.eq_body","codegen.helper","codegen.show","codegen.shown","codegen.equal","codegen.entry","co