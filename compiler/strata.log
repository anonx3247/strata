ommand","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel","text":"/// `A ⊢ ∀x. p` gives `A ⊢ p[t/x]`.\npub fn for_all_to_one(\n  t: kernel.Term,\n  th: kernel.Theorem,\n) -> Result[kernel.Theorem, String] {\n  match kernel.split_binder(\"forall\", kernel.conclusion(th)) {\n    Some((_, ty, body)) => if kernel.type_of(t)! == ty {\n      Ok(kernel.make_theorem(\n        kernel.assumptions(th),\n        kernel.fill_parameter(body, t, 0),\n        kernel.depends_on(th),\n        kernel.Step { rule: \"spec\", premises: [th], terms: [t] },\n      ))\n    } else {\n      Err(\"spec: a term of the wrong type\")\n    },\n    None => Err(\"spec: not a universal\"),\n  }\n}","old_text":"/// `A ⊢ ∀x. p` gives `A ⊢ p[t/x]`.\npub fn for_all_to_one(\n  t: kernel.Term,\n  th: kernel.Theorem,\n) -> Result[kernel.Theorem, String] {\n  match kernel.split_binder(\"forall\", kernel.conclusion(th)) {\n    Some((_, ty, body)) => if kernel.type_of(t)! == ty {\n      Ok(kernel.make_theorem(\n        kernel.assumptions(th),\n        kernel.fill_parameter(body, t, 0),\n        kernel.depends_on(th),\n      ))\n    } else {\n      Err(\"spec: a term of the wrong type\")\n    },\n    None => Err(\"spec: not a universal\"),\n  }\n}"},{"name":"kernel.compute_literals","kind":"fn","old":"979244e0c23b2208","new":"05fc3926929b7845","interface_changed":false,"affected":["kernel_arith.literal_value_of","kernel_logic.rewrite_at_top","kernel_arith.merge