    f\"{r} = phi ptr [ {b}, %{from} ], [ {nothing}, %{none} ]\",\n  )\n  codegen.temp(mut g, codegen.V {\n    ty: check.TNamed { name: \"Option\", args: [et] },\n    op: r,\n  })\n}","old_text":"/// `Some` of the value in slot `out` when `ok`, else `None`. The value is\n/// owned and moves into the `Some`.\nfn option_from(\n  mut g: codegen.Gen,\n  ok: String,\n  out: String,\n  et: Ty,\n) -> codegen.V {\n  (some, none, end) := (\n    codegen.label(mut g, \"got.some\"),\n    codegen.label(mut g, \"got.none\"),\n    codegen.label(mut g, \"got.end\"),\n  )\n  codegen.emit(mut g, f\"br i1 {ok}, label %{some}, label %{none}\")\n  codegen.block(mut g, some)\n  x := codegen.load_slot(mut g, out, et)\n  held := codegen.temp(mut g, x)\n  b := codegen.block_of(mut g, get(g.tags, \"Some\") ?? 0, [held])\n  from := codegen.current_label(g)\n  codegen.emit(mut g, f\"br label %{end}\")\n  codegen.block(mut g, none)\n  nothing := codegen.nullary(mut g, \"None\")\n  codegen.emit(mut g, f\"br label %{end}\")\n  codegen.block(mut g, end)\n  r := codegen.fresh(mut g, \"opt\")\n  codegen.emit(\n    mut g,\n    f\"{r} = phi ptr [ {b}, %{from} ], [ {nothing}, %{none} ]\",\n  )\n  codegen.temp(\n    mut g,\n    codegen.V { ty: TNamed { name: \"Option\", args: [et] }, op: r },\n  )\n}"},{"name":"codegen.slot_drop_fn","kind":"fn","old":"cc4c18c4fec340fb","new":"3d7d6dfe9a8477a4","interface_changed":true,"affected":["codegen.channel_new","codegen.call_named","codegen.expr_node","codegen.expr_want_node","codegen.expr","codegen.expr_want","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.method_call","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operan