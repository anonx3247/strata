(u), name),\n          _ => (),\n        }\n        return u\n      },\n      None => (),\n    },\n    _ => (),\n  }\n  match t {\n    ast.Named { name: \"NonEmpty\", args: [a] } => return TList(codegen.lower(mut g, a)),\n    ast.Named { name, args: [] } => match get(g.sub, name) {\n      Some(x) => return x,\n      None => if contains(g.traits, name) {\n        return TTrait(name)\n      } else if [\"Natural\", \"Positive\", \"Negative\", \"NonZero\"].any(\n        n -> n == name,\n      ) {\n        return TInt\n      } else if name == \"Probability\" || name == \"Percentage\" {\n        return TFloat\n      } else if name == \"NonEmptyString\" {\n        return TStr\n      } else {\n        match get(g.types.aliases, name) {\n          Some(a) => {\n            u := codegen.lower(mut g, a)\n            match u {\n              TUnion(_) => codegen.put_union(mut g, codegen.key(u), name),\n              _ => (),\n            }\n            return u\n          },\n          None => (),\n        }\n      },\n    },\n    // a channel end or a task handle\n    ast.Named { name: n, args: [a] } => if n == \"Sender\" || n == \"Receiver\" || n == \"Task\" {\n      return TNamed { name: n, args: [codegen.lower(mut g, a)] }\n    } else if contains(g.traits, n) {\n      return TTrait(n)\n    },\n    // a trait with type arguments (`Iterator[Int]`): its values, and calls\n    // on one of known type compiled for that type\n    ast.Named { name: tn, args: [_, ..] } => if contains(g.traits, tn) {\n      return TTrait(tn)\n    },\n    ast.UnionType(ms) => {\n      mut ts := []\n      for m in ms {\n        mut ts.push(codegen.lower(mut g, m))\n      }\n      return codegen.union_ty(codegen.whole_sums(g, ts))\n    },\n    ast.Refined { base, .. } => return codegen.lower(mut g, base),\n    _ => (),\n  }\n  match t {\n    ast.Named { name, args: [] } => if codegen.is_word(name) {\n      return TNamed { name, args: [] }\n    },\n    _ => (),\n  }\n  match t {\n    ast.Named { name: \"Int\", args: [] } => TInt,\n    ast.Named { name: \"Float\", args: [] } => TFloat,\n    ast.Named { name: \"Bool\", args: [] } => TBool,\n    ast.Named { name: \"String\", args: [] } => TStr,\n    ast.UnitType => TUnit,\n    ast.Named { name: \"List\", args: [a] } => TList(codegen.lower(mut g, a)),\n    ast.Named { name: \"Set\", args: [a] } => TNamed { name: \"Set\", args: [codegen.lower(mut g, a)] },\n    ast.Named { name: \"Dict\", args: [k, v] } => {\n      kt := codegen.lower(mut g, k)\n      TNamed { name: \"Dict\", args: [kt, codegen.lower(mut g, v)] }\n    },\n    ast.FnType { params, ret } => {\n      mut ps := []\n      for x in params {\n        mut ps.push(codegen.lower(mut g, x))\n      }\n      TFn { params: ps, ret: codegen.lower(mut g, ret) }\n    },\n    ast.Named { name, args } => {\n      n := match get(g.types.named, name) {\n        Some(ps) => len(ps),\n        None => -1,\n      }\n      if name == \"Tuple\" || contains(g.data, name) && n == len(args) {\n        mut xs := []\n        for a in args {\n          mut xs.push(codegen.lower(mut g, a))\n        }\n        TNamed { name, args: xs }\n      } else {\n        // a variant used as a type (`TooBig`): its sum's block\n        sh := get(g.types.ctors, name) ?? codegen.no_shape()\n        if sh.owner != \"\"\n          && sh.owner != name\n          && contains(g.types.sums, sh.owner)\n          && len(sh.params) == len(args) {\n          mut xs := []\n          for a in args {\n            mut xs.push(codegen.lower(mut g, a))\n          }\n          TNamed { name, args: xs }\n        } else {\n          codegen.not_yet(\n            mut g,\n            \"the type `\" + text.type_text(t) + \"`\",\n          )\n          TAny\n        }\n      }\n    },\n    _ => {\n      codegen.not_yet(mut g, \"the type `\" + text.type_text(t) + \"`\")\n      TAny\n    },\n  }\n}"},{"name":"codegen.ll","kind":"fn","old":"14fa63f37b38628a","new":"0c0ec3405c465492","interface_changed":true,"affected":["codeg