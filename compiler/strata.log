"codegen.generated_args","codegen.makers","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// Each field equal jumps to `yes`, else to `no`.\nfn eq_fields(\n  mut g: codegen.Gen,\n  a: codegen.V,\n  b: codegen.V,\n  tys: List[check.Ty],\n) {\n  for (k, t) in enumerate(tys) {\n    x := codegen.field(mut g, a, k, t)\n    y := codegen.field(mut g, b, k, t)\n    e := codegen.equal(mut g, x, y)\n    next := codegen.label(mut g, \"next\")\n    codegen.emit(mut g, f\"br i1 {e.op}, label %{next}, label %no\")\n    codegen.block(mut g, next)\n  }\n  codegen.br(mut g, \"yes\")\n}","old_text":"/// Each field equal jumps to `yes`, else to `no`.\nfn eq_fields(mut g: codegen.Gen, a: codegen.V, b: codegen.V, tys: List[Ty]) {\n  for (k, t) in enumerate(tys) {\n    x := codegen.field(mut g, a, k, t)\n    y := codegen.field(mut g, b, k, t)\n    e := codegen.equal(mut g, x, y)\n    next := codegen.label(mut g, \"next\")\n    codegen.emit(mut g, f\"br i1 {e.op}, label %{next}, label %no\")\n    codegen.block(mut g, next)\n  }\n  codegen.br(mut g, \"yes\")\n}"},{"name":"codegen.debug_body","kind":"fn","old":"55f3db75efb3fefc","new":"2a0575743f5fa6fb","interface_changed":false,"affected":[],"module":"codegen","text":"/// `debug`: as code writes it: `(a, b)`, `Name { f: v }`, `Name(a, b)`,\n/// `Name`, `Name {}`. The caller owns the string returned.\nfn debug_body(mut g: codegen.Gen, a: codegen.V) {\n  match a.ty {\n    check.TNamed { name: \"Tuple\", args } => {\n      codegen.push_scope(mut g)\n      mut parts := [codegen.lit(mut g, \"(\")]\n      parts += codegen.debug_fields(mut g, a, args.map(t -> (\"\", t)))\n      mut parts.push(codegen.lit(mut g, \")\"))\n      s := codegen.concat(mut g, parts)\n      codegen.ret_owned(mut g, s)\n    },\n    _ => {\n      cs := codegen.ctors_of(g, a.ty)\n      labels := if len(cs) == 1 {\n        [codegen.current(g)]\n      } else {\n        codegen.on_ctor(mut g, a, cs)\n      }\n      for (k, c) in enumerate(cs) {\n        if len(cs) > 1 {\n          codegen.block(mut g, get(labels, k) ?? \"\")\n        }\n        codegen.push_scope(mut g)\n        fs := codegen.fields_of(g, c, a.ty)\n        sh := get(g.types.ctors, c) ?? codegen.no_shape()\n        record := !contains(g.types.sums, sh.owner)\n        mut parts := []\n        if len(fs) == 0 {\n          parts = [codegen.lit(mut g, if record && !contains(g.caps, c) {\n            codegen.short(c) + \" {}\"\n          } else {\n            codegen.short(c)\n          })]\n        } else if sh.positional {\n          mut parts.push(codegen.lit(mut g, codegen.short(c) + \"(\"))\n          // positional, no names (a `distinct` type's `value` too)\n          parts += codegen.debug_fields(mut g, a, fs.map(f -> (\"\", f.1)))\n          mut parts.push(codegen.lit(mut g, \")\"))\n        } else {\n          mut parts.push(codegen.lit(mut g, codegen.short(c) + \" { \"))\n          parts += codegen.debug_fields(mut g, a, fs)\n          mut parts.push(codegen.lit(mut g, \" }\"))\n        }\n        s := codegen.concat(mut g, parts)\n        codegen.ret_owned(mut g, s)\n      }\n    },\n  }\n}","old_text":"/// `debug`: as code writes it: `(a, b)`, `Name { f: v }`, `Name(a, b)`,\n/// `Name`, `Name {}`. The caller owns the string returned.\nfn debug_body(mut g: codegen.Gen, a: codegen.V) {\n  match a.ty {\n    TNamed { name: \"Tuple\", args } => {\n      codegen.push_scope(mut g)\n      mut parts := [codegen.lit(mut g, \"(\")]\n      parts += codegen.debug_fields(mut g, a, args.map(t -> (\"\", t)))\n      mut parts.push(codegen.lit(mut g, \")\"))\n      s := codegen.concat(mut g, parts)\n      codegen.ret_owned(mut g, s)\n    },\n    _ => {\n      cs := codegen.ctors_of(g, a.ty)\n      labels := if len(cs) == 1 {\n        [codegen.current(g)]\n      } else {\n        codegen.on_ctor(mut g, a, cs)\n      }\n      for (k, c) in enumerate(cs) {\n        if len(cs) > 1 {\n          codegen.block(mut g, get(labels, k) ?? \"\")\n        }\n        codegen.push_scope(mut g)\n        fs := codegen.fields_of(g, c, a.ty)\n        sh := get(g.types.ctors, c) ?? codegen.no_shape()\n        record := !contains(g.types.sums, sh.owner)\n        mut parts := []\n        if len(fs) == 0 {\n          parts = [codegen.lit(mut g, if record && !contains(g.caps, c) {\n            codegen.short(c) + \" {}\"\n          } else {\n            codegen.short(c)\n          })]\n        } else if sh.positional {\n          mut parts.push(codegen.lit(mut g, codegen.short(c) + \"(\"))\n          // positional, no names (a `distinct` type's `value` too)\n          parts += codegen.debug_fields(mut g, a, fs.map(f -> (\"\", f.1)))\n          mut parts.push(codegen.lit(mut g, \")\"))\n        } else {\n          mut parts.push(codegen.lit(mut g, codegen.short(c) + \" { \"))\n          parts += codegen.debug_fields(mut g, a, fs)\n          mut parts.push(codegen.lit(mut g, \" }\"))\n        }\n        s := codegen.concat(mut g, parts)\n        codegen.ret_owned(mut g, s)\n      }\n    },\n  }\n}"},{"name":"codegen.debug_fields","kind":"fn","old":"12e6841a67c2a124","new":"369bc484bb57be42","interface_changed":true,"affected":["codegen.debug_body","codegen.helper","codegen.show","codegen.shown","codegen.equal","codegen.entry","codegen.interp","codegen.builtin","codegen.string_builtin","codegen.format_spec","codegen.dyn_wrapper","codegen.union_text","codegen.destructure","codegen.for_loop","codegen.debug_list","codegen.checked","codegen.fail_unless","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.fuzz_driver","codegen.trace_enter","codegen.trace_leave","codegen.type_check","codegen.matching_v","codegen.index_check","codegen.checked_update","codegen.decreases_fault","codegen.apply","codegen.eq_fields","codegen.matches","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.generate","codegen.expr_node","codegen.call_named","code