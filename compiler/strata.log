d_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.dyn_ctor_is","codegen.to_c","codegen.gen_data","codegen.mock_value","codegen.generated","codegen.can_generate","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.foreign_call","codegen.generated_args","codegen.makers","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// `v`, a union holding member `m`, as that member's value (borrowed).\nfn narrow(mut g: codegen.Gen, v: codegen.V, m: check.Ty) -> codegen.V {\n  if codegen.boxed(g, m) {\n    codegen.field(mut g, v, 0, m)\n  } else {\n    codegen.V { ..v, ty: m }\n  }\n}","old_text":"/// `v`, a union holding member `m`, as that member's value (borrowed).\nfn narrow(mut g: codegen.Gen, v: codegen.V, m: Ty) -> codegen.V {\n  if codegen.boxed(g, m) {\n    codegen.field(mut g, v, 0, m)\n  } else {\n    codegen.V { ..v, ty: m }\n  }\n}"},{"name":"codegen.word_to_int","kind":"fn","old":"317a9f5d8765ddf1","new":"7581ae3a683ecc30","interface_changed":false,"affected":[],"module":"codegen","text":"/// A sized integer as an `Int`: a big one for a 64-bit value beyond the\n/// small range.\nfn word_to_int(mut g: codegen.Gen, w: String, v: codegen.V) -> codegen.V {\n  if codegen.word_bits(w) < 64 {\n    return codegen.V { ty: check.TInt, op: codegen.wide(mut g, w, v) }\n  }\n  f := if codegen.word_signed(w) {\n    \"strata_int_from_i64\"\n  } else {\n    \"strata_int_from_u64\"\n  }\n  codegen.call(\n    mut g,\n    check.TInt,\n    f,\n    [codegen.V { ty: check.TInt, op: v.op }],\n  )\n}","old_text":"/// A sized integer as an `Int`: a big one for a 64-bit value beyond the\n/// small range.\nfn word_to_int(mut g: codegen.Gen, w: String, v: codegen.V) -> codegen.V {\n  if codegen.word_bits(w) < 64 {\n    return codegen.V { ty: TInt, op: codegen.wide(mut g, w, v) }\n  }\n  f := if codegen.word_signed(w) {\n    \"strata_int_from_i64\"\n  } else {\n    \"strata_int_from_u64\"\n  }\n  codegen.call(mut g, TInt, f, [codegen.V { ty: TInt, op: v.op }])\n}"},{"name":"codegen.conversion","kind":"fn","old":"dc02d4d73c35283e","new":"961888b7570ed0b0","interface_changed":false,"affected":[],"module":"codegen","text":"/// `x.to_int()`, `to_u32(n)` (range checked), `wrap_u32(n)` and the like.\n/// `None` for any other built-in.\nfn conversion(\n  mut g: codegen.Gen,\n  name: String,\n  vs: List[codegen.V],\n) -> Option[codegen.V] {\n  a := get(vs, 0) ?? codegen.unit()\n  if len(vs) != 1 {\n    return None\n  }\n  if name == \"to_int\" {\n    return match codegen.sized(a.ty) {\n      Some(w) => Some(codegen.word_to_int(mut g, w, a)),\n      None => None,\n    }\n  }\n  for w in [\"I8\", \"I16\", \"I32\", \"I64\", \"U8\", \"U16\", \"U32\", \"U64\"] {\n    t := check.TNamed { name: w, args: [] }\n    if name == \"wrap_\" + to_lower(w) && a.ty is check.TInt {\n      return Some(codegen.as_type(mut g, a, t))\n    }\n    if name == \"to_\" + to_lower(w) && a.ty is check.TInt {\n      bits := codegen.word_bits(w)\n      (lo, hi) := if codegen.word_signed(w) {\n        (0 - (1 << bits - 1), (1 << bits - 1) - 1)\n      } else {\n        (0, (1 << bits) - 1)\n      }\n      match parse_int(a.op) {\n        Some(n) => if lo <= n && n <= hi {\n          return Some(codegen.as_type(mut g, a, t))\n        },\n        None => (),\n      }\n      (l, h) := (codegen.int_lit(mut g, lo), codegen.int_lit(mut g, hi))\n      shown := codegen.string(mut g, w)\n      codegen.use_rt(mut g, \"strata_int_fit\")\n      r := codegen.fresh(mut g, \"w\")\n      codegen.emit(\n        mut g,\n        f\"{r} = call i64 @strata_int_fit(i64 {a.op}, i64 {l.op}, i64 {h.op}, ptr {shown})\",\n      )\n      return Some(codegen.V { ty: t, op: codegen.narrow_op(mut g, w, r) })\n    }\n  }\n  None\n}","old_text":"/// `x.to_int()`, `to_u32(n)` (range checked), `wrap_u32(n)` and the like.\n/// `None` for any other built-in.\nfn conversion(\n  mut g: codegen.Gen,\n  name: String,\n  vs: List[codegen.V],\n) -> Option[codegen.V] {\n  a := get(vs, 0) ?? codegen.unit()\n  if len(vs) != 1 {\n    return None\n  }\n  if name == \"to_int\" {\n    return match codegen.sized(a.ty) {\n      Some(w) => Some(codegen.word_to_int(mut g, w, a)),\n      None => None,\n    }\n  }\n  for w in [\"I8\", \"I16\", \"I32\", \"I64\", \"U8\", \"U16\", \"U32\", \"U64\"] {\n    t := TNamed { name: w, args: [] }\n    if name == \"wrap_\" + to_lower(w) && a.ty is TInt {\n      return Some(codegen.as_type(mut g, a, t))\n    }\n    if name == \"to_\" + to_lower(w) && a.ty is TInt {\n      bits := codegen.word_bits(w)\n      (lo, hi) := if codegen.word_signed(w) {\n        (0 - (1 << bits - 1), (1 << bits - 1) - 1)\n      } else {\n        (0, (1 << bits) - 1)\n      }\n      match parse_int(a.op) {\n        Some(n) => if lo <= n && n <= hi {\n          return Some(codegen.as_type(mut g, a, t))\n        },\n        None => (),\n      }\n      (l, h) := (codegen.int_lit(mut g, lo), codegen.int_lit(mut g, hi))\n      shown := codegen.string(mut g, w)\n      codegen.use_rt(mut g, \"strata_int_fit\")\n      r := codegen.fresh(mut g, \"w\")\n      codegen.emit(\n        mut g,\n        f\"{r} = call i64 @strata_int_fit(i64 {a.op}, i64 {l.op}, i64 {h.op}, ptr {shown})\",\n      )\n      return Some(codegen.V { ty: t, op: codegen.narrow_op(mut g, w, r) })\n    }\n  }\n  None\n}"},{"name":"codegen.word_op","kind":"fn","old":"8430d19d4d2d6839","new":"1de453b4730459d0","interface_changed":false,"affected":[],"module":"codegen","text":"/// An operation on two sized integers of type `w`.\nfn word_op(\n  mut g: codegen.Gen,\n  op: ast.BinOp,\n  w: String,\n  a: codegen.V,\n  b: codegen.V,\n) -> codegen.V {\n  t := codegen.ll(a.ty)\n  signed := codegen.word_signed(w)\n  r := codegen.fresh(mut g, \"w\")\n  simple := match op {\n    ast.Add => \"add\",\n    ast.Sub => \"sub\",\n    ast.Mul => \"mul\",\n    ast.BitAnd => \"and\",\n    ast.BitOr => \"or\",\n    ast.BitXor => \"xor\",\n    _ => \"\",\n  }\n  if simple != \"\" {\n    codegen.emit(mut g, f\"{r} = {simple} {t} {a.op}, {b.op}\")\n    return codegen.V { ty: a.ty, op: r }\n  }\n  pred := match op {\n    ast.Less => if signed {\n      \"slt\"\n    } else {\n      \"ult\"\n    },\n    ast.LessEq => if signed {\n      \"sle\"\n    } else {\n      \"ule\"\n    },\n    ast.Greater => if signed {\n      \"sgt\"\n    } else {\n      \"ugt\"\n    },\n    ast.GreaterEq => if signed {\n      \"sge\"\n    } else {\n      \"uge\"\n    },\n    _ => \"\",\n  }\n  if pred != \"\" {\n    codegen.emit(mut g, f\"{r} = icmp {pred} {t} {a.op}, {b.op}\")\n    return codegen.V { ty: check.TBool, op: r }\n  }\n  match op {\n    ast.Div | ast.Mod => {\n      // in 64 bits (`Int`'s Euclidean division), then truncated\n      f := match (op, signed) {\n        (ast.Div, true) => \"strata_word_div\",\n        (ast.Div, false) => \"strata_uword_div\",\n        (_, true) => \"strata_word_mod\",\n        _ => \"strata_uword_mod\",\n      }\n      (x, y) := (codegen.wide(mut g, w, a), codegen.wide(mut g, w, b))\n      q := codegen.raw_call(mut g, f, [x, y])\n      codegen.narrow_word(mut g, w, q, a.ty)\n    },\n    ast.Shl | ast.Shr => {\n      bits := codegen.word_bits(w)\n      k := parse_int(b.op)\n      // a shift by a negative count (signed) faults as `Int`'s does\n      neg_ok := match k {\n        Some(n) => n >= 0,\n        None => false,\n      }\n      if signed && !neg_ok {\n        (neg, bad, ok) := (\n          codegen.fresh(mut g, \"neg\"),\n          codegen.label(mut g, \"shift.neg\"),\n          codegen.label(mut g, \"shift.ok\"),\n        )\n        codegen.emit(mut g, f\"{neg} = icmp slt {t} {b.op}, 0\")\n        codegen.emit(\n          mut g,\n          f\"br i1 {neg}, label %{bad}, label %{ok}\",\n        )\n        codegen.block(mut g, bad)\n        m := codegen.string(mut g, \"`\" + text.op_text(op) + \"`\")\n        codegen.use_rt(mut g, \"strata_word_shift_fault\")\n        codegen.emit(\n          mut g,\n          f\"call void @strata_word_shift_fault(ptr {m})\",\n        )\n        codegen.br(mut g, ok)\n        codegen.block(mut g, ok)\n      }\n      ins := match (op, signed) {\n        (ast.Shl, _) => \"shl\",\n        (_, true) => \"ashr\",\n        _ => \"lshr\",\n      }\n      small := match k {\n        Some(n) => n >= 0 && n < bits,\n        None => false,\n      }\n      if small {\n        codegen.emit(mut g, f\"{r} = {ins} {t} {a.op}, {b.op}\")\n        return codegen.V { ty: a.ty, op: r }\n      }\n      big := codegen.fresh(mut g, \"big\")\n      codegen.emit(mut g, f\"{big} = icmp uge {t} {b.op}, {bits}\")\n      if ins == \"ashr\" {\n        n := codegen.fresh(mut g, \"n\")\n        codegen.emit(\n          mut g,\n          f\"{n} = select i1 {big}, {t} {bits - 1}, {t} {b.op}\",\n        )\n        codegen.emit(mut g, f\"{r} = ashr {t} {a.op}, {n}\")\n        return codegen.V { ty: a.ty, op: r }\n      }\n      sh := codegen.fresh(mut g, \"sh\")\n      codegen.emit(mut g, f\"{sh} = {ins} {t} {a.op}, {b.op}\")\n      codegen.emit(mut g, f\"{r} = select i1 {big}, {t} 0, {t} {sh}\")\n      codegen.V { ty: a.ty, op: r }\n    },\n    _ => codegen.bad_op(mut g, op),\n  }\n}","old_text":"/// An operation on two sized integers of type `w`.\nfn word_op(\n  mut g: codegen.Gen,\n  op: ast.BinOp,\n  w: String,\n  a: codegen.V,\n  b: codegen.V,\n) -> codegen.V {\n  t := codegen.ll(a.ty)\n  signed := codegen.word_signed(w)\n  r := codegen.fresh(mut g, \"w\")\n  simple := match op {\n    ast.Add => \"add\",\n    ast.Sub => \"sub\",\n    ast.Mul => \"mul\",\n    ast.BitAnd => \"and\",\n    ast.BitOr => \"or\",\n    ast.BitXor => \"xor\",\n    _ => \"\",\n  }\n  if simple != \"\" {\n    codegen.emit(mut g, f\"{r} = {simple} {t} {a.op}, {b.op}\")\n    return codegen.V { ty: a.ty, op: r }\n  }\n  pred := match op {\n    ast.Less => if signed {\n      \"slt\"\n    } else {\n      \"ult\"\n    },\n    ast.LessEq => if signed {\n      \"sle\"\n    } else {\n      \"ule\"\n    },\n    ast.Greater => if signed {\n      \"sgt\"\n    } else {\n      \"ugt\"\n    },\n    ast.GreaterEq => if signed {\n      \"sge\"\n    } else {\n      \"uge\"\n    },\n    _ => \"\",\n  }\n  if pred != \"\" {\n    codegen.emit(mut g, f\"{r} = icmp {pred} {t} {a.op}, {b.op}\")\n    return codegen.V { ty: TBool, op: r }\n  }\n  match op {\n    ast.Div | ast.Mod => {\n      // in 64 bits (`Int`'s Euclidean division), then truncated\n      f := match (op, signed) {\n        (ast.Div, true) => \"strata_word_div\",\n        (ast.Div, false) => \"strata_uword_div\",\n        (_, true) => \"strata_word_mod\",\n        _ => \"strata_uword_mod\",\n      }\n      (x, y) := (codegen.wide(mut g, w, a), codegen.wide(mut g, w, b))\n      q := codegen.raw_call(mut g, f, [x, y])\n      codegen.narrow_word(mut g, w, q, a.ty)\n    },\n    ast.Shl | ast.Shr => {\n      bits := codegen.word_bits(w)\n      k := parse_int(b.op)\n      // a shift by a negative count (signed) faults as `Int`'s does\n      neg_ok := match k {\n        Some(n) => n >= 0,\n        None => false,\n      }\n      if signed && !neg_ok {\n        (neg, bad, ok) := (\n          codegen.fresh(mut g, \"neg\"),\n          codegen.label(mut g, \"shift.neg\"),\n          codegen.label(mut g, \"shift.ok\"),\n        )\n        codegen.emit(mut g, f\"{neg} = icmp slt {t} {b.op}, 0\")\n        codegen.emit(\n          mut g,\n          f\"br i1 {neg}, label %{bad}, label %{ok}\",\n        )\n        codegen.block(mut g, bad)\n        m := codegen.string(mut g, \"`\" + text.op_text(op) + \"`\")\n        codegen.use_rt(mut g, \"strata_word_shift_fault\")\n        codegen.emit(\n          mut g,\n          f\"call void @strata_word_shift_fault(ptr {m})\",\n        )\n        codegen.br(mut g, ok)\n        codegen.block(mut g, ok)\n      }\n      ins := match (op, signed) {\n        (ast.Shl, _) => \"shl\",\n        (_, true) => \"ashr\",\n        _ => \"lshr\",\n      }\n      small := match k {\n        Some(n) => n >= 0 && n < bits,\n        None => false,\n      }\n      if small {\n        codegen.emit(mut g, f\"{r} = {ins} {t} {a.op}, {b.op}\")\n        return codegen.V { ty: a.ty, op: r }\n      }\n      big := codegen.fresh(mut g, \"big\")\n      codegen.emit(mut g, f\"{big} = icmp uge {t} {b.op}, {bits}\")\n      if ins == \"ashr\" {\n        n := codegen.fresh(mut g, \"n\")\n        codegen.emit(\n          mut g,\n          f\"{n} = select i1 {big}, {t} {bits - 1}, {t} {b.op}\",\n        )\n        codegen.emit(mut g, f\"{r} = ashr {t} {a.op}, {n}\")\n        return codegen.V { ty: a.ty, op: r }\n      }\n      sh := codegen.fresh(mut g, \"sh\")\n      codegen.emit(mut g, f\"{sh} = {ins} {t} {a.op}, {b.op}\")\n      codegen.emit(mut g, f\"{r} = select i1 {big}, {t} 0, {t} {sh}\")\n      codegen.V { ty: a.ty, op: r }\n    },\n    _ => codegen.bad_op(mut g, op),\n  }\n}"},{"name":"codegen.narrow_word","kind":"fn","old":"f5a4ab003e7962da","new":"990d99d10dd0d351","interface_changed":true,"affected":["codegen.from_slot","codegen.word_op","codegen.drop_list","codegen.dyn_wrapper","codegen.slot_drop_fn","codegen.dyn_value","codegen.update_in_place","codegen.copy_fn","codegen.slot_fn","codegen.load_slot","codegen.swap_in","codegen.take_in_place","codegen.session_entry","codegen.share_held","codegen.read_fields","codegen.apply","codegen.drop_fn","codegen.vtable",