en.sized(want) is Some\n    || codegen.holds_union(want) {\n    codegen.wanted(mut g, e, want)\n  } else {\n    codegen.expr(mut g, e)\n  }\n}","old_text":"/// A branch's value, as it comes, or converted to `want` when that:\n/// - holds a trait value (`if c { Log {} } else { Tally {} }` for an `Out`)\n/// - is a sized integer (`if c { 128 } else { x }` for a `U32`): the literal\n/// becomes one, so the branches join at one width\n/// - holds a union (`Ok(n)` for a `Result[Int | String, E]`,\n/// `if c { n } else { () }` for an `Int | ()`)\nfn branch_value(mut g: codegen.Gen, e: ast.Expr, want: Ty) -> codegen.V {\n  if codegen.holds_trait(want)\n    || codegen.sized(want) is Some\n    || codegen.holds_union(want) {\n    codegen.wanted(mut g, e, want)\n  } else {\n    codegen.expr(mut g, e)\n  }\n}"},{"name":"codegen.matching_want","kind":"fn","old":"7afb20f378827c48","new":"b53c53fb3cee29b5","interface_changed":true,"affected":["codegen.matching","codegen.expr_want_node","codegen.expr_node","codegen.expr_want","codegen.expr","codegen.function","codegen.binary","codegen.declare","codegen.destructure","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.method_call","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.try_want","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.compared","codegen.stmt_node","codegen.build_fn","codegen.push_in_place","codegen.call_named","codegen.interp","codegen.logic","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen