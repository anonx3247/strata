],"module":"kernel","text":"/// `A ⊢ s = t` gives `A ⊢ (λx. s) = (λx. t)`, `x` not free in `A`.\npub fn equal_under_lambda(\n  x: kernel.Term,\n  th: kernel.Theorem,\n) -> Result[kernel.Theorem, String] {\n  match (x, kernel.split_equation(kernel.conclusion(th))) {\n    (kernel.Variable { name, value_type: ty }, Some((s, t))) => if kernel.assumptions(th).any(h -> kernel.occurs_free(name, ty, h)) {\n      Err(\"abs: `\" + name + \"` is free in a hypothesis\")\n    } else {\n      Ok(kernel.make_theorem(\n        kernel.assumptions(th),\n        kernel.equation(kernel.Lambda {\n          parameter_name: name,\n          parameter_type: ty,\n          body: kernel.bind_variable(s, name, ty, 0),\n        }, kernel.Lambda {\n          parameter_name: name,\n          parameter_type: ty,\n          body: kernel.bind_variable(t, name, ty, 0),\n        })!,\n        kernel.depends_on(th),\n        kernel.Step { rule: \"abs\", premises: [th], terms: [x] },\n      ))\n    },\n    _ => Err(\"abs: not a variable and an equation\"),\n  }\n}","old_text":"/// `A ⊢ s = t` gives `A ⊢ (λx. s) = (λx. t)`, `x` not free in `A`.\npub fn equal_under_lambda(\n  x: kernel.Term,\n  th: kernel.Theorem,\n) -> Result[kernel.Theorem, String] {\n  match (x, kernel.split_equation(kernel.conclusion(th))) {\n    (kernel.Variable { name, value_type: ty }, Some((s, t))) => if kernel.assumptions(th).any(h -> kernel.occurs_free(name, ty, h)) {\n      Err(\"abs: `\" + name + \"` is free in a hypothesis\")\n    } else {\n      Ok(kernel.make_theorem(\n        kernel.assumptions(th),\n        kernel.equation(kernel.Lambda {\n          parameter_name: name,\n          parameter_type: ty,\n          body: kernel.bind_variable(s, name, ty, 0),\n        }, kernel.Lambda {\n          parameter_name: name,\n          parameter_type: ty,\n          body: kernel.bind_variable(t, name, ty, 0),\n        })!,\n        kernel.depends_on(th),\n      ))\n    },\n    _ => Err(\"abs: not a variable and an equation\"),\n  }\n}"},{"name":"kernel.call_lambda","kind":"fn","old":"223f7584e671c993","new":"8ce0d19e07f9184b","interface_changed":false,"affected":["kernel_logic.rewrite_at_top","kernel_logic.normal_form","kernel_arith.prettify","kernel_logic.lambdas_applied","kernel_tactics.simp_with","kernel_tactics.split_close","kernel_tactics.linear_arithmetic","kernel_tactics.assumption_facts","kernel_tactics.same_simplified","kernel_tactics.split_on_named","kernel_translate.equation","kernel_translate.for_each_value","kernel_arith.simp_step","kernel_logic.same_up_to_lambdas","kernel_tactics.beta_of","kernel_tactics.equal_sides","kernel_tactics.apply_tactic","kernel_tactics.simplify","kernel_tactics.auto","kernel_tactics.apply_tac_simple","kernel_tactics.spec_term","kernel_tactics.finish_with","kernel_tactics.split_on","kernel_translate.add_field","kernel_translate.plain_definition","kernel_translate.primrec_group","kernel_translate.case_same","kernel_translate.record_eta","kernel_tactics.simp_state","kernel_logic.apply_implication_loosely","kernel_tactics.induct","kernel_tactics.trivial_case","kernel_tactics.case_theorem","kernel_tactics.cases_on_term","kernel_tactics.cases_on_assumption","kernel_tactics.chain_of_equations","kernel_tactics.use_law","kernel_tactics.extensionality","kernel_tactics.witness","kernel_tactics.run","kernel_tactics.rule_theorems","kernel_tactics.split_if","kernel_translate.add_datatypes","kernel_translate.add_group","kernel_cli.mutual","kernel_tactics.induction","kernel_cli.check_script","kernel_tactics.close_with","kernel_tactics.rules_from","kernel_tactics.theorem_of","kernel_translate.add_datatype","kernel_translate.add_decls","kernel_cli.check_source","kernel_cli.check_module","kernel_tactics.prove_step","kernel_tactics.rewrite","kernel_tactics.apply_law","kernel_cli.base_theory","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codeg