odegen.conversion","codegen.list_slice","codegen.as_type","codegen.word_op","fix_loops","diff_command","tour_command"],"module":"codegen","text":"/// The tags the values of member `m` of a union with members `ms` have.\nfn member_tags(\n  mut g: codegen.Gen,\n  ms: List[check.Ty],\n  m: check.Ty,\n) -> List[Int] {\n  if codegen.boxed(g, m) {\n    [codegen.box_tag_in(mut g, ms, m)]\n  } else {\n    codegen.ctors_of(g, m).map(c -> get(g.tags, c) ?? 0)\n  }\n}","old_text":"/// The tags a member's values have.\nfn member_tags(mut g: codegen.Gen, m: check.Ty) -> List[Int] {\n  if codegen.boxed(g, m) {\n    [codegen.box_tag(mut g, m)]\n  } else {\n    codegen.ctors_of(g, m).map(c -> get(g.tags, c) ?? 0)\n  }\n}"},{"name":"codegen.holds_member","kind":"fn","old":"78f0c5235b3ee467","new":"cfd877fa10762854","interface_changed":false,"affected":[],"module":"codegen","text":"/// Whether `v`, a union, holds a value of member `m`.\nfn holds_member(mut g: codegen.Gen, v: codegen.V, m: check.Ty) -> codegen.V {\n  t := codegen.tag_of(mut g, v)\n  ms := match v.ty {\n    check.TUnion(ms) => ms,\n    _ => [m],\n  }\n  mut acc := \"false\"\n  for n in codegen.member_tags(mut g, ms, m) {\n    (e, o) := (codegen.fresh(mut g, \"is\"), codegen.fresh(mut g, \"or\"))\n    codegen.emit(mut g, f\"{e} = icmp eq i64 {t}, {n}\")\n    codegen.emit(mut g, f\"{o} = or i1 {acc}, {e}\")\n    acc = o\n  }\n  codegen.V { ty: check.TBool, op: acc }\n}","old_text":"/// Whether `v`, a union, holds a value of member `m`.\nfn holds_member(mut g: codegen.Gen, v: codegen.V, m: check.Ty) -> codegen.V {\n  t := codegen.tag_of(mut g, v)\n  mut acc := \"false\"\n  for n in codegen.member_tags(mut g, m) {\n    (e, o) := (codegen.fresh(mut g, \"is\"), codegen.fresh(mut g, \"or\"))\n    codegen.emit(mut g, f\"{e} = icmp eq i64 {t}, {n}\")\n    codegen.emit(mut g, f\"{o} = or i1 {acc}, {e}\")\n    acc = o\n  }\n  codegen.V { ty: check.TBool, op: acc }\n}"},{"name":"codegen.to_union","kind":"fn","old":"3f84463bf3ce434f","new":"cdf98918fb8a6841","interface_changed":false,"affected":[],"module":"codegen","text":"/// `v` as a value of union `ut`, boxed when its type is.\nfn to_union(mut g: codegen.Gen, v: codegen.V, ut: check.Ty) -> codegen.V {\n  match v.ty {\n    check.TUnion(_) => codegen.V { ..v, ty: ut },\n    _ => if codegen.boxed(g, v.ty) {\n      ms := match ut {\n        check.TUnion(ms) => ms,\n        _ => [],\n      }\n      // a value whose type is partly unknown (`[]`) takes the member of\n      // its kind (`List[Int]`)\n      m := if codegen.has_any(v.ty) {\n        find(ms, x -> codegen.head_of(x) == codegen.head_of(v.ty)) ?? v.ty\n      } else {\n        v.ty\n      }\n      tag := codegen.box_tag_in(mut g, ms, m)\n      p := codegen.block_tagged(mut g, to_string(tag), [v])\n      codegen.temp(mut g, codegen.V { ty: ut, op: p })\n    } else {\n      codegen.V { ..v, ty: ut }\n    },\n  }\n}","old_text":"/// `v` as a value of union `ut`, boxed when its type is.\nfn to_union(mut g: codegen.Gen, v: codegen.V, ut: check.Ty) -> codegen.V {\n  match v.ty {\n    check.TUnion(_) => codegen.V { ..v, ty: ut },\n    _ => if codegen.boxed(g, v.ty) {\n      // a value whose type is partly unknown (`[]`) takes the member of\n      // its kind (`List[Int]`)\n      m := if codegen.has_any(v.ty) {\n        match ut {\n          check.TUnion(ms) => find(ms, x -> codegen.head_of(x) == codegen.head_of(v.ty)) ?? v.ty,\n          _ => v.ty,\n        }\n      } else {\n        v.ty\n      }\n      tag := codegen.box_tag(mut g, m)\n      p := codegen.block_tagged(mut g, to_string(tag), [v])\n      codegen.temp(mut g, codegen.V { ty: ut, op: p })\n    } else {\n      codegen.V { ..v, ty: ut }\n    },\n  }\n}"},{"name":"codegen.read_slot","kind":"fn","old":"0c5cba58ac74f158","new":"a316c16669e647b0","interface_changed":false,"affected":[],"module":"codegen","text":"/// The value of type `t` in the slot at `slot`: the slot itself for a\n/// number, an address for the rest.\n/// Typed `Raw`, not `I64`, so `verify` never runs it: a random word would\n/// be read as an address.\nfn read_slot(\n  mut g: codegen.Gen,\n  t: check.Ty,\n  slot: Raw,\n) -> Result[ast.Expr, String] {\n  w := slot.address\n  match codegen.sized(t) {\n    Some(n) => return Ok(codegen.word_literal(n, w.to_int())),\n    None => (),\n  }\n  r := slot\n  match t {\n    check.TInt => Ok(codegen.int_literal(slot)),\n    check.TFloat => {\n      bits := w.to_int()\n      match float_from_bits(if bits < 0 {\n        bits + 18446744073709551616\n      } else {\n        bits\n      }) {\n        Some(f) => Ok(ast.FloatLit(f)),\n        None => Err(\"a float that isn't a number\"),\n      }\n    },\n    check.TBool => Ok(ast.BoolLit(w.to_int() % 2 != 0)),\n    check.TUnit => Ok(ast.UnitExpr),\n    check.TStr => match codegen.text_at(r) {\n      Some(s) => Ok(ast.StrLit(s)),\n      None => Err(\"a string that isn't UTF-8\"),\n    },\n    check.TList(et) => match codegen.read_all(mut g, et, codegen.elements_at(r)) {\n      Ok(xs) => Ok(ast.ListExpr(xs)),\n      Err(e) => Err(e),\n    },\n    // a table: its entries are the tuple's first field\n    check.TNamed { name: \"Set\", args: [et] } => match codegen.read_all(mut g, et, codegen.elements_at(r.at(1))) {\n      Ok(xs) => Ok(ast.SetExpr { types: [], elems: xs }),\n      Err(e) => Err(e),\n    },\n    check.TNamed { name: \"Dict\", args: [kt, vt] } => {\n      mut entries := []\n      for pair in codegen.elements_at(r.at(1)) {\n        k := codegen.read_slot(mut g, kt, pair.at(1))!\n        v := codegen.read_slot(mut g, vt, pair.at(2))!\n        mut entries.push((k, v))\n      }\n      Ok(ast.DictExpr { types: [], entries })\n    },\n    check.TNamed { name: \"Tuple\", args } => {\n      mut xs := []\n      for (i, a) in enumerate(args) {\n        x := codegen.read_slot(mut g, a, r.at(to_i64(i + 1)))!\n        mut xs.push(x)\n      }\n      Ok(ast.TupleExpr(xs))\n    },\n    check.TNamed { name, args } => if contains(g.data, name) {\n      codegen.read_ctor(mut g, name, args, r)\n    } else {\n      Err(\n        \"a value of type `\"\n          + codegen.key(t)\n          + \"` can't be read back\",\n      )\n    },\n    check.TUnion(ms) => {\n      tag := r.word(0).to_int()\n      for m in ms {\n        if codegen.boxed(g, m) {\n          if codegen.box_tag_in(mut g, ms, m) == tag {\n            return codegen.read_slot(mut g, m, r.at(1))\n          }\n        } else if codegen.member_tags(mut g, ms, m).contains(tag) {\n          return codegen.read_slot(mut g, m, slot)\n        }\n      }\n      Err(\"a union value with tag \" + to_string(tag))\n    },\n    _ => Err(\n      \"a value of type `\" + codegen.key(t) + \"` can't be read back\",\n    ),\n  }\n}","old_text":"/// The value of type `t` in the slot at `slot`: the slot itself for a\n/// number, an address for the rest.\n/// Typed `Raw`, not `I64`, so `verify` never runs it: a random word would\n/// be read as an address.\nfn read_slot(\n  mut g: codegen.Gen,\n  t: check.Ty,\n  slot: Raw,\n) -> Result[ast.Expr, String] {\n  w := slot.address\n  match codegen.sized(t) {\n    Some(n) => return Ok(codegen.word_literal(n, w.to_int())),\n    None => (),\n  }\n  r := slot\n  match t {\n    check.TInt => Ok(codegen.int_literal(slot)),\n    check.TFloat => {\n      bits := w.to_int()\n      match float_from_bits(if bits < 0 {\n        bits + 18446744073709551616\n      } else {\n        bits\n      }) {\n        Some(f) => Ok(ast.FloatLit(f)),\n        None => Err(\"a float that isn't a number\"),\n      }\n    },\n    check.TBool => Ok(ast.BoolLit(w.to_int() % 2 != 0)),\n    check.TUnit => Ok(ast.UnitExpr),\n    check.TStr => match codegen.text_at(r) {\n      Some(s) => Ok(ast.StrLit(s)),\n      None => Err(\"a string that isn't UTF-8\"),\n    },\n    check.TList(et) => match codegen.read_all(mut g, et, codegen.elements_at(r)) {\n      Ok(xs) => Ok(ast.ListExpr(xs)),\n      Err(e) => Err(e),\n    },\n    // a table: its entries are the tuple's first field\n    check.TNamed { name: \"Set\", args: [et] } => match codegen.read_all(mut g, et, codegen.elements_at(r.at(1))) {\n      Ok(xs) => Ok(ast.SetExpr { types: [], elems: xs }),\n      Err(e) => Err(e),\n    },\n    check.TNamed { name: \"Dict\", args: [kt, vt] } => {\n      mut entries := []\n      for pair in codegen.elements_at(r.at(1)) {\n        k := codegen.read_slot(mut g, kt, pair.at(1))!\n        v := codegen.read_slot(mut g, vt, pair.at(2))!\n        mut entries.push((k, v))\n      }\n      Ok(ast.DictExpr { types: [], entries })\n    },\n    check.TNamed { name: \"Tuple\", args } => {\n      mut xs := []\n      for (i, a) in enumerate(args) {\n        x := codegen.read_slot(mut g, a, r.at(to_i64(i + 1)))!\n        mut xs.push(x)\n      }\n      Ok(ast.TupleExpr(xs))\n    },\n    check.TNamed { name, args } => if contains(g.data, name) {\n      codegen.read_ctor(mut g, name, args, r)\n    } else {\n      Err(\n        \"a value of type `\"\n          + codegen.key(t)\n          + \"` can't be read back\",\n      )\n    },\n    check.TUnion(ms) => {\n      tag := r.word(0).to_int()\n      for m in ms {\n        if codegen.boxed(g, m) {\n          if codegen.box_tag(mut g, m) == tag {\n            return codegen.read_slot(mut g, m, r.at(1))\n          }\n        } else if codegen.member_tags(mut g, m).contains(tag) {\n          return codegen.read_slot(mut g, m, slot)\n        }\n      }\n      Err(\"a union value with tag \" + to_string(tag))\n    },\n    _ => Err(\n      \"a value of type `\" + codegen.key(t) + \"` can't be read back\",\n    ),\n  }\n}"},{"name":"codegen.box_tag_in","kind":"fn","old":null,"new":"a89d88148d4549da","interface_changed":true,"affected":[],"module":"codegen","text":"/// The tag of boxed member `m` of a union with members `ms`: by its head\n/// alone (`List`) when no other boxed member has that head, so a union\n/// whose type argument is still open at a call (`List[Html[?]]`) and the\n/// same union in the instance called (`List[Html[()]]`) agree; else by its\n/// whole type. (A union converted to a wider one keeps its tags, so a\n/// member whose head the wider union holds twice, as in\n/// `List[Int] | List[String]`, would be read under the wrong tag.)\nfn box_tag_in(mut g: codegen.Gen, ms: List[check.Ty], m: check.Ty) -> Int {\n  h := codegen.head_of(m)\n  if len(\n    ms.filter(x -> codegen.boxed(g, x) && codegen.head_of(x) == h),\n  ) == 1 {\n    codegen.box_tag(\n      mut g,\n      check.TNamed { name: \"$head:\" + h, args: [] },\n    )\n  } else {\n    codegen.box_tag(mut g, m)\n  }\n}"}]}
{"id":"268a351a5d412de4","time":1795712642,"message":"edit","changes":[{"name":"text.expr_text","kind":"fn","old":"ce63f804e3089424","new":"eca39b42b08cf8e1","interface_changed":false,"affected":[],"module":"text","text":"/// An expression at depth `d`, broken across lines where it would be too\n/// long:\n/// - a chain of method calls: one call per line.\n/// - a call's arguments or a literal's items: one per line.\n/// - a long lambda's body: on a line of its own.\n/// - `&&`, `||` and `+`: one operand per line.\npub fn expr_text(e: ast.Expr, d: Int) -> String {\n  // markup made by the parser (`web.element(…)`) is shown as markup\n  match text.markup_view(e, d) {\n    Some(s) => return s,\n    None => (),\n  }\n  one := text.inline(e, d)\n  // a chain whose parts had to break is laid out one item per line\n  chain := match e {\n    ast.MethodCall { .. } | ast.Binary { op: ast.And | ast.Or | ast.Add, .. } => true,\n    _ => false,\n  }\n  // so do the items around markup that takes several lines\n  if !text.too_long(one, d)\n    && !((chain || text.holds_markup(e)) && contains(one, \"\\n\")) {\n    return one\n  }\n  match e {\n    // a.b().c().d()  ->  one call per line\n    ast.MethodCall { .. } => {\n      mut calls := []\n      mut cur: ast.Expr = e\n      loop {\n        match cur {\n          ast.MethodCall { recv, name, args } => {\n            mut calls.push((name, args))\n            cur = recv\n          },\n          _ => {\n            break\n          },\n        }\n      }\n      if len(calls) < 2 {\n        c := get(calls, 0) ?? (\"\", [])\n        return text.wrap(cur, 12, d)\n          + \".\"\n          + c.0\n          + text.broken(\n            \"(\",\n            c.1.map(a -> text.expr_text(a, d + 1)),\n            \")\",\n            d,\n          )\n      }\n      mut s := text.wrap(cur, 12, d)\n      for c in calls.reversed() {\n        s += \"\\n\"\n          + text.ind(d + 1)\n          + \".\"\n          + c.0\n          + \"(\"\n          + text.args_text(c.1, d + 1)\n          + \")\"\n      }\n      s\n    },\n    ast.Call { callee, args } => if len(args) > 0 {\n      text.callee_text(callee, d)\n        + text.broken(\n          \"(\",\n          args.map(a -> text.expr_text(a, d + 1)),\n          \")\",\n          d,\n        )\n    } else {\n      one\n    },\n    ast.ListExpr(es) => if len(es) > 0 {\n      text.broken(\n        \"[\",\n        es.map(a -> text.expr_text(a, d + 1)),\n        \"]\",\n        d,\n      )\n    } else {\n      one\n    },\n    ast.TupleExpr(es) => text.broken(\"(\", es.map(a -> text.expr_text(a, d + 1)), \")\", d),\n    ast.CtorExpr { name, args: ast.RecordArgs(fs) } => text.broken(name + \" {\", text.named_parts(fs, d + 1), \"}\", d),\n    ast.CtorExpr { name, args: ast.PositionalArgs(es) } => name\n      + text.broken(\n        \"(\",\n        es.map(a -> text.expr_text(a, d + 1)),\n        \")\",\n        d,\n      ),\n    // x -> long body  ->  body on its own line (a block body breaks by itself)\n    ast.Lambda { params, body } => match text.lambda_view(params, body) {\n      (_, ast.Block { .. }) => one,\n      (ps, b) => text.lambda_params(ps)\n        + \" ->\\n\"\n        + text.ind(d + 1)\n        + text.expr_text(b, d + 1),\n    },\n    // a && b && c, \"x\" + y + \"z\"  ->  one operand per line\n    ast.Binary { op, .. } => if op == ast.And || op == ast.Or || op == ast.Add {\n      mut parts := []\n      mut cur: ast.Expr = e\n      loop {\n        match cur {\n          ast.Binary { op: o, left, right } => if o == op {\n            mut parts.push(right)\n            cur = left\n          } else {\n            break\n          },\n          _ => {\n            break\n          },\n        }\n      }\n      p := text.prec(e)\n      mut s := text.wrap(cur, p, d + 1)\n      for x in parts.reversed() {\n        s += \"\\n\"\n          + text.ind(d + 1)\n          + text.symbol(op)\n          + \" \"\n          + text.wrap(x, p + 1, d + 1)\n      }\n      s\n    } else {\n      one\n    },\n    _ => one,\n  }\n}","old_text":"/// An expression at depth `d`, broken across lines where it would be too\n/// long:\n/// - a chain of method calls: one call per line.\n/// - a call's arguments or a literal's items: one per line.\n/// - a long lambda's body: on a line of its own.\n/// - `&&`, `||` and `+`: one operand per line.\npub fn expr_text(e: ast.Expr, d: Int) -> String {\n  // markup made by the parser (`web.element(…)`) is shown as markup\n  match text.markup_view(e, d) {\n    Some(s) => return s,\n    None => (),\n  }\n  one := text.inline(e, d)\n  // a chain whose parts had to break is laid out one item per line\n  chain := match e {\n    ast.MethodCall { .. } | ast.Binary { op: ast.And | ast.Or | ast.Add, .. } => true,\n    _ => false,\n  }\n  if !text.too_long(one, d) && !(chain && contains(one, \"\\n\")) {\n    return one\n  }\n  match e {\n    // a.b().c().d()  ->  one call per line\n    ast.MethodCall { .. } => {\n      mut calls := []\n      mut cur: ast.Expr = e\n      loop {\n        match cur {\n          ast.MethodCall { recv, name, args } => {\n            mut calls.push((name, args))\n            cur = recv\n          },\n          _ => {\n            break\n          },\n        }\n      }\n      if len(calls) < 2 {\n        c := get(calls, 0) ?? (\"\", [])\n        return text.wrap(cur, 12, d)\n          + \".\"\n          + c.0\n          + text.broken(\n            \"(\",\n            c.1.map(a -> text.expr_text(a, d + 1)),\n            \")\",\n            d,\n          )\n      }\n      mut s := text.wrap(cur, 12, d)\n      for c in calls.reversed() {\n        s += \"\\n\"\n          + text.ind(d + 1)\n          + \".\"\n          + c.0\n          + \"(\"\n          + text.args_text(c.1, d + 1)\n          + \")\"\n      }\n      s\n    },\n    ast.Call { callee, args } => if len(args) > 0 {\n      text.callee_text(callee, d)\n        + text.broken(\n          \"(\",\n          args.map(a -> text.expr_text(a, d + 1)),\n          \")\",\n          d,\n        )\n    } else {\n      one\n    },\n    ast.ListExpr(es) => if len(es) > 0 {\n      text.broken(\n        \"[\",\n        es.map(a -> text.expr_text(a, d + 1)),\n        \"]\",\n        d,\n      )\n    } else {\n      one\n    },\n    ast.TupleExpr(es) => text.broken(\"(\", es.map(a -> text.expr_text(a, d + 1)), \")\", d),\n    ast.CtorExpr { name, args: ast.RecordArgs(fs) } => text.broken(name + \" {\", text.named_parts(fs, d + 1), \"}\", d),\n    ast.CtorExpr { name, args: ast.PositionalArgs(es) } => name\n      + text.broken(\n        \"(\",\n        es.map(a -> text.expr_text(a, d + 1)),\n        \")\",\n        d,\n      ),\n    // x -> long body  ->  body on its own line (a block body breaks by itself)\n    ast.Lambda { params, body } => match text.lambda_view(params, body) {\n      (_, ast.Block { .. }) => one,\n      (ps, b) => text.lambda_params(ps)\n        + \" ->\\n\"\n        + text.ind(d + 1)\n        + text.expr_text(b, d + 1),\n    },\n    // a && b && c, \"x\" + y + \"z\"  ->  one operand per line\n    ast.Binary { op, .. } => if op == ast.And || op == ast.Or || op == ast.Add {\n      mut parts := []\n      mut cur: ast.Expr = e\n      loop {\n        match cur {\n          ast.Binary { op: o, left, right } => if o == op {\n            mut parts.push(right)\n            cur = left\n          } else {\n            break\n          },\n          _ => {\n            break\n          },\n        }\n      }\n      p := text.prec(e)\n      mut s := text.wrap(cur, p, d + 1)\n      for x in parts.reversed() {\n        s += \"\\n\"\n          + text.ind(d + 1)\n          + text.symbol(op)\n          + \" \"\n          + text.wrap(x, p + 1, d + 1)\n      }\n      s\n    } else {\n      one\n    },\n    _ => one,\n  }\n}"},{"name":"text.holds_markup","kind":"fn","old":null,"new":"b820a4159e53a57d","interface_changed":true,"affected":[],"module":"text","text":"/// Whether a call or a list has markup among its items (a call of\n/// `std.web.element` or `std.web.children`).\nfn holds_markup(e: ast.Expr) -> Bool {\n  xs := match e {\n    ast.ListExpr(es) | ast.TupleExpr(es) => es,\n    ast.Call { args, .. } | ast.MethodCall { args, .. } => args,\n    _ => return false,\n  }\n  xs.any(\n    x -> match text.web_fn(x) {\n      Some((f, _)) => f == \"element\" || f == \"children\",\n      None => false,\n    },\n  )\n}"}]}
{"id":"dd2956d7202a5751","time":1795712665,"message":"edit","changes":[{"name":"text.markup_view","kind":"fn","old":"b6a124d210f64cd8","new":"a3a303bb85860932","interface_changed":false,"affected":[],"module":"text","text":"/// Calls the parser made from markup, shown as markup: `<p class=\"x\">Hi\n/// {name}</p>` for `web.element(\"p\", [web.attr(\"class\", \"x\")],\n/// web.children([\"Hi \", name]))`, `<>…</>` for `web.children([…])`. `None`\n/// for anything else, and for calls that markup can't write the same way\n/// (an attribute that isn't one of `web.attr`, `web.attribute`, `web.flag`\n/// or an `on_` event, a void element with children), which are shown as\n/// calls. On one line when it fits, else each child on its own line, and\n/// each attribute too when the start tag is too long.\nfn markup_view(e: ast.Expr, d: Int) -> Option[String] {\n  one := text.markup_line(e, d)?\n  if !text.too_long(one, d) && !contains(one, \"\\n\") {\n    return Some(one)\n  }\n  (tag, attrs, items) := text.markup_parts(e, d + 1, true)?\n  short := \"<\" + tag + join(attrs.map(a -> \" \" + a), \"\")\n  start := if text.too_long(short, d) || contains(short, \"\\n\") {\n    \"<\"\n      + tag\n      + join(attrs.map(a -> \"\\n\" + text.ind(d + 1) + a), \"\")\n      + \"\\n\"\n      + text.ind(d)\n  } else {\n    short\n      + if len(attrs) > 0 && items == None {\n        \" \"\n      } else {\n        \"\"\n      }\n  }\n  match items {\n    None => Some(start + \"/>\"),\n    Some(xs) => Some(start\n      + \">\"\n      + join(xs.map(i -> \"\\n\" + text.ind(d + 1) + i), \"\")\n      + \"\\n\"\n      + text.ind(d)\n      + \"</\"\n      + tag\n      + \">\"),\n  }\n}","old_text":"/// Calls the parser made from markup, shown as markup: `<p class=\"x\">Hi\n/// {name}</p>` for `web.element(\"p\", [web.attr(\"class\", \"x\")],\n/// web.children([\"Hi \", name]))`, `<>…</>` for `web.children([…])`. `None`\n/// for anything else, and for calls that markup can't write the same way\n/// (an attribute that isn't one of `web.attr`, `web.attribute`, `web.flag`\n/// or an `on_` event, a void element with children), which are shown as\n/// calls. On one line when it fits, else each child on its own line.\nfn markup_view(e: ast.Expr, d: Int) -> Option[String] {\n  one := text.markup_line(e, d)?\n  if !text.too_long(one, d) && !contains(one, \"\\n\") {\n    return Some(one)\n  }\n  (open, items, close) := text.markup_parts(e, d + 1, true)?\n  if len(items) == 0 {\n    return Some(open)\n  }\n  Some(open\n    + join(items.map(i -> \"\\n\" + text.ind(d + 1) + i), \"\")\n    + \"\\n\"\n    + text.ind(d)\n    + close)\n}"},{"name":"text.markup_line","kind":"fn","old":"1225988563ceab9c","new":"62a2e3b43d7b82fc","interface_changed":false,"affected":[],"module":"text","text":"/// Markup on one line, or `None` if `e` isn't markup.\nfn markup_line(e: ast.Expr, d: Int) -> Option[String] {\n  (tag, attrs, items) := text.markup_parts(e, d, false)?\n  head := \"<\" + tag + join(attrs.map(a -> \" \" + a), \"\")\n  match items {\n    None => Some(head + \" />\"),\n    Some(xs) => Some(head + \">\" + join(xs, \"\") + \"</\" + tag + \">\"),\n  }\n}","old_text":"/// Markup on one line, or `None` if `e` isn't markup.\nfn markup_line(e: ast.Expr, d: Int) -> Option[String] {\n  (open, items, close) := text.markup_parts(e, d, false)?\n  Some(open + join(items, \"\") + close)\n}"},{"name":"text.markup_parts","kind":"fn","old":"75bcccba8f9c0d99","new":"8a0707398c629f13","interface_changed":true,"affected":["text.markup_view","text.markup_line","text.expr_text","text.markup_child","capabilities.noalloc_sites","capabilities.where_text","capabilities.element_text","check.infer_call","check.infer_method","check.infer_untagged","check.int_literal","check.holes_found","check.written_expr","check.element_assigned","check.changing_call","check.spreads_resolved","check.spread_names","check.spread_filled","codegen.not_yet","codegen.function","codegen.assertion","codegen.block_expr","cod