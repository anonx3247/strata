"repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel","text":"/// `⊢ t = v`: `t` an operation on integer literals (`+ - *`, `-`, `<`,\n/// `<=`, `==`) and `v` its value, computed (literals are the integers'\n/// numerals: this rule is their definition).\npub fn compute_literals(t: kernel.Term) -> Result[kernel.Theorem, String] {\n  v := match t {\n    kernel.Application { function: kernel.Application { function: kernel.Constant { name, value_type: ty }, argument: x }, argument: y } => match (kernel.literal_value(x), kernel.literal_value(y)) {\n      (Some(m), Some(n)) => match name {\n        \"int.add\" => kernel.literal_term(m + n),\n        \"int.sub\" => kernel.literal_term(m - n),\n        \"int.mul\" => kernel.literal_term(m * n),\n        \"int.lt\" => kernel.boolean_literal(m < n),\n        \"int.le\" => kernel.boolean_literal(m <= n),\n        \"=\" => if ty == kernel.function_type_of(\n          [kernel.integer_type(), kernel.integer_type()],\n          kernel.boolean_type(),\n        ) {\n          kernel.boolean_literal(m == n)\n        } else {\n          return Err(\"int_lit: not an operation on integers\")\n        },\n        _ => return Err(\"int_lit: not an operation on integers\"),\n      },\n      _ => return Err(\"int_lit: not literals\"),\n    },\n    kernel.Application { function: kernel.Constant { name: \"int.neg\", .. }, argument: x } => match kernel.literal_value(x) {\n      Some(m) => kernel.literal_term(0 - m),\n      None => return Err(\"int_lit: not a literal\"),\n    },\n    _ => return Err(\"int_lit: not an operation on literals\"),\n  }\n  if kernel.same_term(v, t) {\n    return Err(\"int_lit: already a literal\")\n  }\n  Ok(kernel.make_theorem(\n    [],\n    kernel.equation(t, v)!,\n    kernel.no_dependencies(),\n    kernel.Step { rule: \"compute\", premises: [], terms: [t] },\n  ))\n}","old_text":"/// `⊢ t = v`: `t` an operation on integer literals (`+ - *`, `-`, `<`,\n/// `<=`, `==`) and `v` its value, computed (literals are the integers'\n/// numerals: this rule is their definition).\npub fn compute_literals(t: kernel.Term) -> Result[kernel.Theorem, String] {\n  v := match t {\n    kernel.Application { function: kernel.Application { function: kernel.Constant { name, value_type: ty }, argument: x }, argument: y } => match (kernel.literal_value(x), kernel.literal_value(y)) {\n      (Some(m), Some(n)) => match name {\n        \"int.add\" => kernel.literal_term(m + n),\n        \"int.sub\" => kernel.literal_term(m - n),\n        \"int.mul\" => kernel.literal_term(m * n),\n        \"int.lt\" => kernel.boolean_literal(m < n),\n        \"int.le\" => kernel.boolean_literal(m <= n),\n        \"=\" => if ty == kernel.function_type_of(\n          [kernel.integer_type(), kernel.integer_type()],\n          kernel.boolean_type(),\n        ) {\n          kernel.boolean_literal(m == n)\n        } else {\n          return Err(\"int_lit: not an operation on integers\")\n        },\n        _ => return Err(\"int_lit: not an operation on integers\"),\n      },\n      _ => return Err(\"int_lit: not literals\"),\n    },\n    kernel.Application { function: kernel.Constant { name: \"int.neg\", .. }, argument: x } => match kernel.literal_value(x) {\n      Some(m) => kernel.literal_term(0 - m),\n      None => return Err(\"int_lit: not a literal\"),\n    },\n    _ => return Err(\"int_lit: not an operation on literals\"),\n  }\n  if kernel.same_term(v, t) {\n    return Err(\"int_lit: already a literal\")\n  }\n  Ok(kernel.make_theorem(\n    [],\n    kernel.equation(t, v)!,\n    kernel.no_dependencies(),\n  ))\n}"},{"name":"kernel.define","kind":"fn","old":"7ba9d9a44166a9c9","new":"218b8cabe34c48f7","interface_changed":false,"affected":["kernel_translate.add_field","kernel_translate.plain_definition","kernel_translate.primrec_group","kernel_translate.add_datatypes","kernel_translate.add_group","kernel_translate.add_datatype","kernel_translate.add_decls","kernel_cli.base_theory","kernel_cli.check_script","kernel_cli.command","kernel_cli.check_source","kernel_cli.check_module","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel","text":"/// `⊢ c = rhs` for a new constant `c`: `rhs` closed, with no type variable\n/// that its type doesn't have.\npub fn define(name: String, rhs: kernel.Term) -> Result[kernel.Theorem, String] {\n  ty := kernel.type_of(rhs)!\n  if kernel.reserved(name) {\n    return Err(\"`\" + name + \"` is reserved\")\n  }\n  if kernel.has_free(rhs) {\n    return Err(\"define: the right side has free variables\")\n  }\n  tvs := kernel.type_variables(ty)\n  if !kernel.term_type_variables(rhs).all(v -> contains(tvs, v)) {\n    return Err(\"define: a type variable not in the constant's type\")\n  }\n  Ok(kernel.make_theorem(\n    [],\n    kernel.equation(kernel.Constant { name, value_type: ty }, rhs)!,\n    kernel.Dependencies {\n      definitions: [(name, \"def \" + kernel.term_signature(rhs))],\n      oracles: [],\n    },\n    kernel.Step {\n      rule: \"define\",\n      premises: [],\n      terms: [kernel.Constant { name, value_type: ty }, rhs],\n    },\n  ))\n}","old_text":"/// `⊢ c = rhs` for a new constant `c`: `rhs` closed, with no type variable\n/// that its type doesn't have.\npub fn define(name: String, rhs: kernel.Term) -> Result[kernel.Theorem, String] {\n  ty := kernel.type_of(rhs)!\n  if kernel.reserved(name) {\n    return Err(\"`\" + name + \"` is reserved\")\n  }\n  if kernel.has_free(rhs) {\n    return Err(\"define: the right side has free variables\")\n  }\n  tvs := kernel.type_variables(ty)\n  if !kernel.term_type_variables(rhs).all(v -> contains(tvs, v)) {\n    return Err(\"define: a type variable not in the constant's type\")\n  }\n  Ok(kernel.make_theorem(\n    [],\n    kernel.equation(kernel.Constant { name, value_type: ty }, rhs)!,\n    kernel.Dependencies {\n      definitions: [(name, \"def \" + kernel.term_signature(rhs))],\n      oracles: [],\n    },\n  ))\n}"},{"name":"kernel.datatypes","kind":"fn","old":"87e3b4fb6562af57","new":"4cb86590c02f8b1b","interface_changed":false,"affected":["kernel.datatype","kernel_translate.add_datatypes","kernel_translate.add_datatype","kernel_translate.add_decls","kernel_cli.base_theory","kernel_cli.check_script","kernel_cli.command","kernel_cli.check_source","kernel_cli.check_module","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel","text":"/// A group of mutually recursive datatypes, with their constructors,\n/// recursors and case functions as new constants and their axioms (the\n/// definitional principle in docs/kernel.md). The types share their\n/// parameters; a recursive argument is one of the group's types with those\n/// parameters, no other argument mentions one, and every type is inhabited\n/// (some constructor's recursive arguments are all of inhabited types).\npub fn datatypes(\n  specs: List[kernel.DatatypeSpec],\n) -> Result[List[kernel.DatatypeFacts], String] {\n  params := match specs {\n    [first, ..] => first.params,\n    [] => return Err(\"datatypes: an empty group\"),\n  }\n  names := specs.map(s -> s.name)\n  tys := names.map(\n    n -> kernel.TypeApplication {\n      name: n,\n      arguments: params.map(p -> kernel.TypeVariable(p)),\n    },\n  )\n  mut seen := []\n  for s in specs {\n    if s.params != params {\n      return Err(\"`\"\n        + s.name\n        + \"`: the group's types must have the same parameters\")\n    }\n    if contains([\"bool\", \"Function\", \"int\", \"string\"], s.name)\n      || contains(seen, \"type \" + s.name) {\n      return Err(\"`\" + s.name + \"` is a built-in type or repeated\")\n    }\n    mut seen.push(\"type \" + s.name)\n    for (c, args) in s.ctors {\n      if kernel.reserved(c) || contains(seen, c) {\n        return Err(\"constructor `\" + c + \"`: reserved or repeated\")\n      }\n      mut seen.push(c)\n      for a in args {\n        if !contains(tys, a)\n          && names.any(n -> kernel.mentions_type(a, n)) {\n          return Err(\"constructor `\"\n            + c\n            + \"`: a type of the group nested in an argument\")\n        }\n        if !kernel.type_variables(a).all(v -> contains(params, v)) {\n          return Err(\n            \"constructor `\"\n              + c\n              + \"`: a type variable not a parameter\",\n          )\n        }\n      }\n    }\n  }\n  // inhabited: a fixed point over the group\n  mut inhabited := []\n  mut changed := true\n  while changed {\n    changed = false\n    for s in specs {\n      if !contains(inhabited, s.name)\n        && s.ctors.any(\n          c -> c.1.all(\n            a -> !contains(tys, a)\n              || contains(inhabited, kernel.type_name(a)),\n          ),\n        ) {\n        mut inhabited.push(s.name)\n        changed = true\n      }\n    }\n  }\n  for s in specs {\n    if !contains(inhabited, s.name) {\n      return Err(\n        \"`\"\n          + s.name\n          + \"` has no constructor whose recursive arguments are of inhabited types: it would be empty\",\n      )\n    }\n  }\n  for n in names {\n    if contains(seen, \"rec_\" + n) || contains(seen, \"case_\" + n) {\n      return Err(\"`rec_\" + n + \"` or `case_\" + n + \"` is a constructor\")\n    }\n  }\n  // the result type of each type's recursor\n  rs := enumerate(names).map(\n    p -> kernel.TypeVariable(\n      kernel.fresh_type_variable(params, \"r\" + to_string(p.0)),\n    ),\n  )\n  res_of := (a: kernel.Type) -> {\n    mut out := a\n    for (i, t) in enumerate(tys) {\n      if t == a {\n        out = get(rs, i) ?? a\n      }\n    }\n    out\n  }\n  key := \"datatypes\"\n    + join(specs.map(\n      s -> \" \"\n        + s.name\n        + \"[\"\n        + join(params, \",\")\n        + \"]\"\n        + join(s.ctors.map(\n          c -> \" \"\n            + c.0\n            + join(c.1.map(a -> \":\" + kernel.type_signature(a)), \"\"),\n        ), \"\"),\n    ), \";\")\n  mut defs := []\n  for s in specs {\n    mut defs.push((\"type \" + s.name, key))\n    mut defs.push((\"rec_\" + s.name, key))\n    mut defs.push((\"case_\" + s.name, key))\n    for (c, _) in s.ctors {\n      mut defs.push((c, key))\n    }\n  }\n  b := kernel.Dependencies { definitions: defs, oracles: [] }\n  // every constructor of the group, with the index of its type\n  mut all := []\n  for (j, s) in enumerate(specs) {\n    for (c, args) in s.ctors {\n      mut all.push((j, c, args))\n    }\n  }\n  case_tys := all.map(\n    c -> kernel.function_type_of(\n      c.2 + c.2.filter(a -> contains(tys, a)).map(a -> res_of(a)),\n      get(rs, c.0) ?? kernel.boolean_type(),\n    ),\n  )\n  fs := enumerate(case_tys).map(\n    p ->\n      kernel.Variable {\n        name: \"f\" + to_string(p.0),\n        value_type: p.1,\n      },\n  )\n  rec_of := (x: kernel.Term) -> {\n    xt := match x {\n      kernel.Variable { value_type: ty, .. } => ty,\n      kernel.Application { .. } => kernel.boolean_type(),\n      _ => kernel.boolean_type(),\n    }\n    mut out := x\n    for (i, t) in enumerate(tys) {\n      if t == xt {\n        out = kernel.apply_all(kernel.Constant {\n          name: \"rec_\" + (get(names, i) ?? \"\"),\n          value_type: kernel.function_type_of(case_tys + [t], get(rs, i) ?? t),\n        }, fs + [x])\n      }\n    }\n    out\n  }\n  arg_vars := (args: List[kernel.Type], prefix: String) -> enumerate(args).map(\n    p -> kernel.Variable {\n      name: prefix + to_string(p.0),\n      value_type: p.1,\n    },\n  )\n  mut out := []\n  // induction: ∀P1 … Pn. (one step per constructor) ⇒ (∀x. P1 x) ∧ … ∧ (∀x. Pn x)\n  pvs := enumerate(tys).map(\n    p -> kernel.Variable { name: if len(tys) == 1 {\n      \"P\"\n    } else {\n      \"P\" + to_string(p.0)\n    }, value_type: kernel.function_type(p.1, kernel.boolean_type()) },\n  )\n  pof := (t: kernel.Term, ty: kernel.Type) -> {\n    mut out := kernel.Application { function: get(pvs, 0) ?? t, argument: t }\n    for (i, pt) in enumerate(tys) {\n      if pt == ty {\n        out = kernel.Application {\n          function: get(pvs, i) ?? t,\n          argument: t,\n        }\n      }\n    }\n    out\n  }\n  mut goal := kernel.for_all_of([kernel.Variable {\n    name: \"x\",\n    value_type: get(tys, len(tys) - 1) ?? kernel.boolean_type(),\n  }], pof(kernel.Variable {\n    name: \"x\",\n    value_type: get(tys, len(tys) - 1) ?? kernel.boolean_type(),\n  }, get(tys, len(tys) - 1) ?? kernel.boolean_type()))\n  mut gi := len(tys) - 2\n  while gi >= 0 {\n    t := get(tys, gi) ?? kernel.boolean_type()\n    goal = kernel.connective(\"/\\\\\", kernel.for_all_of(\n      [kernel.Variable { name: \"x\", value_type: t }],\n      pof(kernel.Variable { name: \"x\", value_type: t }, t),\n    ), goal)\n    gi -= 1\n  }\n  mut ci := len(all) - 1\n  while ci >= 0 {\n    (j, c, args) := get(all, ci) ?? (0, \"\", [])\n    t := get(tys, j) ?? kernel.boolean_type()\n    xs := arg_vars(args, \"x\")\n    mut step := pof(kernel.apply_all(kernel.Constant {\n      name: c,\n      value_type: kernel.function_type_of(args, t),\n    }, xs), t)\n    rec_xs := xs.filter(v -> tys.any(ty -> kernel.has_type(v, ty)))\n    mut k := len(rec_xs) - 1\n    while k >= 0 {\n      v := get(rec_xs, k) ?? step\n      vt := match v {\n        kernel.Variable { value_type: ty, .. } => ty,\n        _ => t,\n      }\n      step = kernel.implication(pof(v, vt), step)\n      k -= 1\n    }\n    goal = kernel.implication(kernel.for_all_of(xs, step), goal)\n    ci -= 1\n  }\n  induction := kernel.make_theorem(\n    [],\n    kernel.for_all_of(pvs, goal),\n    b,\n    kernel.Step { rule: \"induction\", premises: [], specs },\n  )\n  for (j, s) in enumerate(specs) {\n    t := get(tys, j) ?? kernel.boolean_type()\n    rname := \"rec_\" + s.name\n    cname := \"case_\" + s.name\n    mut injective := []\n    mut recursion := []\n    mut cases := []\n    sres := kernel.TypeVariable(kernel.fresh_type_variable(params, \"s\"))\n    gs := enumerate(s.ctors).map(\n      p -> kernel.Variable {\n        name: \"g\" + to_string(p.0),\n        value_type: kernel.function_type_of(p.1.1, sres),\n      },\n    )\n    case_c := kernel.Constant {\n      name: cname,\n      value_type: kernel.function_type_of(gs.map(\n          g -> match g {\n            kernel.Variable { value_type: ty, .. } => ty,\n            _ => sres,\n          },\n        )\n        + [t], sres),\n    }\n    for (i, (c, args)) in enumerate(s.ctors) {\n      xs := arg_vars(args, \"x\")\n      ctor := kernel.Constant {\n        name: c,\n        value_type: kernel.function_type_of(args, t),\n      }\n      lhs := kernel.apply_all(ctor, xs)\n      // recursion: rec_T fs (C xs) = f_C xs (rec fs x_r …)\n      idx := enumerate(all).filter(p -> p.1.1 == c).map(p -> p.0)\n      fi := get(fs, get(idx, 0) ?? 0) ?? lhs\n      recs := xs\n        .filter(v -> tys.any(ty -> kernel.has_type(v, ty)))\n        .map(v -> rec_of(v))\n      eqn := kernel.equation(kernel.recursor_applied(\n        rname,\n        case_tys,\n        t,\n        get(rs, j) ?? t,\n        fs,\n        lhs,\n      ), kernel.apply_all(fi, xs + recs))!\n      mut recursion.push(\n        kernel.make_theorem(\n          [],\n          kernel.for_all_of(fs + xs, eqn),\n          b,\n          kernel.Step {\n            rule: \"recursion\",\n            premises: [],\n            specs,\n            indices: [j, i],\n          },\n        ),\n      )\n      // case: case_T gs (C xs) = g_C xs\n      ceq := kernel.equation(\n        kernel.apply_all(case_c, gs + [lhs]),\n        kernel.apply_all(get(gs, i) ?? lhs, xs),\n      )!\n      mut cases.push(\n        kernel.make_theorem(\n          [],\n          kernel.for_all_of(gs + xs, ceq),\n          b,\n          kernel.Step {\n            rule: \"cases\",\n            premises: [],\n            specs,\n            indices: [j, i],\n          },\n        ),\n      )\n      if len(args) > 0 {\n        ys := arg_vars(args, \"y\")\n        both := kernel.equation(lhs, kernel.apply_all(ctor, ys))!\n        mut conj := kernel.equation(\n          get(xs, len(xs) - 1) ?? lhs,\n          get(ys, len(ys) - 1) ?? lhs,\n        )!\n        mut k := len(xs) - 2\n        while k >= 0 {\n          conj = kernel.connective(\n            \"/\\\\\",\n            kernel.equation(get(xs, k) ?? lhs, get(ys, k) ?? lhs)!,\n            conj,\n          )\n          k -= 1\n        }\n        mut injective.push(\n          kernel.make_theorem(\n            [],\n            kernel.for_all_of(xs + ys, kernel.equation(both, conj)!),\n            b,\n            kernel.Step {\n              rule: \"injective\",\n              premises: [],\n              specs,\n              indices: [j, i],\n            },\n          ),\n        )\n      }\n    }\n    mut distinct := []\n    for (i, (c1, a1)) in enumerate(s.ctors) {\n      for (k, (c2, a2)) in enumerate(s.ctors) {\n        if i < k {\n          xs := arg_vars(a1, \"x\")\n          ys := arg_vars(a2, \"y\")\n          l := kernel.apply_all(kernel.Constant {\n            name: c1,\n            value_type: kernel.function_type_of(a1, t),\n          }, xs)\n          r := kernel.apply_all(kernel.Constant {\n            name: c2,\n            value_type: kernel.function_type_of(a2, t),\n          }, ys)\n          mut distinct.push(\n            kernel.make_theorem(\n              [],\n              kernel.for_all_of(xs + ys, kernel.equation(\n                kernel.equation(l, r)!,\n                kernel.false_term(),\n              )!),\n              b,\n              kernel.Step {\n                rule: \"distinct\",\n                premises: [],\n                specs,\n                indices: [j, i, k],\n              },\n            ),\n          )\n        }\n      }\n    }\n    mut out.push(\n      kernel.DatatypeFacts {\n        recursor: rname,\n        induction,\n        injective,\n        distinct,\n        recursion,\n        case_name: cname,\n        cases,\n        group: names,\n      },\n    )\n  }\n  Ok(out)\n}","old_text":"/// A group of mutually recursive datatypes, with their constructors,\n/// recursors and case functions as new constants and their axioms (the\n/// definitional principle in docs/kernel.md). The types share their\n/// parameters; a recursive argument is one of the group's types with those\n/// parameters, no other argument mentions one, and every type is inhabited\n/// (some constructor's recursive arguments are all of inhabited types).\npub fn datatypes(\n  specs: List[kernel.DatatypeSpec],\n) -> Result[List[kernel.DatatypeFacts], String] {\n  params := match specs {\n    [first, ..] => first.params,\n    [] => return Err(\"datatypes: an empty group\"),\n  }\n  names := specs.map(s -> s.name)\n  tys := names.map(\n    n -> kernel.TypeApplication {\n      name: n,\n      arguments: params.map(p -> kernel.TypeVariable(p)),\n    },\n  )\n  mut seen := []\n  for s in specs {\n    if s.params != params {\n      return Err(\"`\"\n        + s.name\n 