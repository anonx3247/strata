eck_union","codegen.check_member","codegen.has_field_check","codegen.number_builtin","codegen.eq_body","codegen.generated","codegen.can_generate","codegen.compared","codegen.if_want","codegen.scope_expr","codegen.channel_new","codegen.try_want","codegen.or_else","codegen.appended","codegen_with","core_rt_text","computed_value","repl_eval","codegen.session_entry","codegen.race_expr","codegen.logic","codegen.loop_body","codegen.with_it","codegen.mock_method","codegen.call_entry","codegen.tag_test","codegen.keep_olds","codegen.export_entry","codegen.expr_on_stack","codegen.assigned_call","codegen.to_dyn","codegen.dyn_table_is","codegen.get_field","codegen.gen_data","codegen.generated_args","codegen.makers","codegen.if_expr","codegen.try_expr","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.tag_is","codegen.satisfies","codegen.holds_pred","codegen.mock_table","codegen.dyn_ctor_is","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.to_c","codegen.mock_value","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.foreign_call","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// Element `i`, known in bounds, borrowed. Its slot comes from the module\n/// function `@\"list.slot\"`, inlined at -O2.\nfn list_at(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  i: String,\n  et: check.Ty,\n) -> codegen.V {\n  f := \"@\\\"list.slot\\\"\"\n  if !codegen.has_helper(g, f) {\n    codegen.add_helper(mut g, f)\n    mut g.helper_defs.push(\n      join([\n        f\"define ptr {f}(ptr %l, i64 %i) {{\",\n        \"start:\",\n        \"  %bp = getelementptr i8, ptr %l, i64 8\",\n        \"  %buf = load ptr, ptr %bp\",\n        \"  %op = getelementptr i8, ptr %l, i64 16\",\n        \"  %off = load i64, ptr %op\",\n        \"  %k = add i64 %off, %i\",\n        \"  %data = getelementptr i64, ptr %buf, i64 2\",\n        \"  %el = getelementptr i64, ptr %data, i64 %k\",\n        \"  ret ptr %el\",\n        \"}\\n\",\n      ], \"\\n\"),\n    )\n  }\n  el := codegen.fresh(mut g, \"elp\")\n  codegen.emit(mut g, f\"{el} = call ptr {f}(ptr {v.op}, i64 {i})\")\n  codegen.load_slot(mut g, el, et)\n}","old_text":"/// Element `i`, known in bounds, borrowed. Its slot comes from the module\n/// function `@\"list.slot\"`, inlined at -O2.\nfn list_at(mut g: codegen.Gen, v: codegen.V, i: String, et: Ty) -> codegen.V {\n  f := \"@\\\"list.slot\\\"\"\n  if !codegen.has_helper(g, f) {\n    codegen.add_helper(mut g, f)\n    mut g.helper_defs.push(\n      join([\n        f\"define ptr {f}(ptr %l, i64 %i) {{\",\n        \"start:\",\n        \"  %bp = getelementptr i8, ptr %l, i64 8\",\n        \"  %buf = load ptr, ptr %bp\",\n        \"  %op = getelementptr i8, ptr %l, i64 16\",\n        \"  %off = load i64, ptr %op\",\n        \"  %k = add i64 %off, %i\",\n        \"  %data = getelementptr i64, ptr %buf, i64 2\",\n        \"  %el = getelementptr i64, ptr %data, i64 %k\",\n        \"  ret ptr %el\",\n        \"}\\n\",\n      ], \"\\n\"),\n    )\n  }\n  el := codegen.fresh(mut g, \"elp\")\n  codegen.emit(mut g, f\"{el} = call ptr {f}(ptr {v.op}, i64 {i})\")\n  codegen.load_slot(mut g, el, et)\n}"},{"name":"codegen.list_literal","kind":"fn","old":"ed4181ab55a19eb9","new":"c7811d1134be2e7a","interface_changed":false,"affected":[],"module":"codegen","text":"/// `[a, b, c]`: a new list whose buffer takes the elements.\nfn list_literal(mut g: codegen.Gen, es: List[ast.Expr]) -> codegen.V {\n  codegen.list_literal_of(mut g, es, check.TAny)\n}","old_text":"/// `[a, b, c]`: a new list whose buffer takes the elements.\nfn list_literal(mut g: codegen.Gen, es: List[ast.Expr]) -> codegen.V {\n  codegen.list_literal_of(mut g, es, TAny)\n}"},{"name":"codegen.slice_raw","kind":"fn","old":"1a55b7bbc14a51b4","new":"41e3903a920752ac","interface_changed":false,"affected":[],"module":"codegen","text":"/// The elements `from` to `to` (within 0..len): a new header sharing the\n/// buffer, as a temporary.\nfn slice_raw(\n  mut g: codegen.Gen,\n  xs: codegen.V,\n  from: String,\n  to: String,\n) -> codegen.V {\n  codegen.call(mut g, xs.ty, \"strata_list_slice\", [\n    xs,\n    codegen.V { ty: check.TInt, op: from },\n    codegen.V { ty: check.TInt, op: to },\n  ])\n}","old_text":"/// The elements `from` to `to` (within 0..len): a new header sharing the\n/// buffer, as a temporary.\nfn slice_raw(\n  mut g: codegen.Gen,\n  xs: codegen.V,\n  from: String,\n  to: String,\n) -> codegen.V {\n  codegen.call(mut g, xs.ty, \"strata_list_slice\", [\n    xs,\n    codegen.V { ty: TInt, op: from },\n    codegen.V { ty: TInt, op: to },\n  ])\n}"},{"name":"codegen.list_builtin","kind":"fn","old":"b7bb4b5cf2c99f71","new":"b73bfd2a7a507405","interface_changed":false,"affected":[],"module":"codegen","text":"/// The list built-ins compiled inline.\nfn list_builtin(\n  mut g: codegen.Gen,\n  name: String,\n  vs: List[codegen.V],\n) -> codegen.V {\n  xs := get(vs, 0) ?? codegen.unit()\n  et := match xs.ty {\n    check.TList(x) => x,\n    _ => {\n      if name == \"range\" && len(vs) == 2 {\n        return codegen.call(\n          mut g,\n          check.TList(check.TInt),\n          \"strata_range\",\n          vs,\n        )\n      }\n      codegen.not_yet(mut g, \"the built-in `\"\n        + name\n        + \"` on a `\"\n        + codegen.key(xs.ty)\n        + \"`\")\n      return codegen.never()\n    },\n  }\n  match (name, len(vs)) {\n    (\"len\", 1) => codegen.list_len(mut g, xs),\n    (\"push\", 2) => {\n      if g.copies {\n        codegen.note_extension(mut g, xs, \"1\")\n      }\n      x0 := codegen.take_value(mut g, get(vs, 1) ?? codegen.unit())\n      // pushing onto a list of a union (`push(xs, 3)` on a `List[U | Int]`)\n      // makes the element the union's value, as list literals do. An element\n      // already of the union, or unboxed, is `x0` held once.\n      x := if et is check.TUnion {\n        u := codegen.to_union(mut g, x0, et)\n        if u.op == x0.op {\n          u\n        } else {\n          codegen.take_value(mut g, u)\n        }\n      } else {\n        x0\n      }\n      sl := codegen.to_slot(mut g, x)\n      t := check.TList(codegen.better(et, x.ty))\n      codegen.call(mut g, t, \"strata_list_push\", [\n        xs,\n        codegen.V { ty: check.TInt, op: sl },\n        codegen.elements_kind(codegen.better(et, x.ty)),\n      ])\n    },\n    (\"at\", 2) => {\n      i := get(vs, 1) ?? codegen.unit()\n      codegen.index_check(mut g, xs, i)\n      codegen.list_at(mut g, xs, i.op, et)\n    },\n    // a held list: `x = set_at(x, …)` goes through `set_in_place`\n    (\"set_at\", 3) => {\n      i := get(vs, 1) ?? codegen.unit()\n      codegen.index_check(mut g, xs, i)\n      x := codegen.converted(mut g, get(vs, 2) ?? codegen.unit(), et)\n      if codegen.counted(x.ty) && !codegen.constant(x.op) {\n        codegen.dup_value(mut g, x)\n      }\n      sl := codegen.to_slot(mut g, x)\n      codegen.call(mut g, xs.ty, \"strata_list_set\", [\n        xs,\n        i,\n        codegen.V { ty: check.TInt, op: sl },\n        codegen.elements_kind(et),\n      ])\n    },\n    (\"get\", 2) => {\n      i := get(vs, 1) ?? codegen.unit()\n      n := codegen.list_len(mut g, xs)\n      (lo, hi, inside) := (\n        codegen.fresh(mut g, \"lo\"),\n        codegen.fresh(mut g, \"hi\"),\n        codegen.fresh(mut g, \"in\"),\n      )\n      codegen.emit(mut g, f\"{lo} = icmp sge i64 {i.op}, 0\")\n      codegen.emit(mut g, f\"{hi} = icmp slt i64 {i.op}, {n.op}\")\n      codegen.emit(mut g, f\"{inside} = and i1 {lo}, {hi}\")\n      (some, none, end) := (\n        codegen.label(mut g, \"get.some\"),\n        codegen.label(mut g, \"get.none\"),\n        codegen.label(mut g, \"get.end\"),\n      )\n      codegen.emit(\n        mut g,\n        f\"br i1 {inside}, label %{some}, label %{none}\",\n      )\n      codegen.block(mut g, some)\n      x := codegen.list_at(mut g, xs, i.op, et)\n      b := codegen.block_of(mut g, get(g.tags, \"Some\") ?? 0, [x])\n      from_some := codegen.current(g)\n      codegen.br(mut g, end)\n      codegen.block(mut g, none)\n      nothing := codegen.nullary(mut g, \"None\")\n      codegen.br(mut g, end)\n      codegen.block(mut g, end)\n      r := codegen.fresh(mut g, \"opt\")\n      codegen.emit(\n        mut g,\n        f\"{r} = phi ptr [ {b}, %{from_some} ], [ {nothing}, %{none} ]\",\n      )\n      codegen.temp(mut g, codegen.V {\n        ty: check.TNamed { name: \"Option\", args: [et] },\n        op: r,\n      })\n    },\n    (\"take\", 2) | (\"drop\", 2) => {\n      n := codegen.list_len(mut g, xs)\n      k := codegen.clamp(mut g, (get(vs, 1) ?? codegen.unit()).op, n.op)\n      if name == \"take\" {\n        codegen.slice_raw(mut g, xs, \"0\", k)\n      } else {\n        codegen.slice_raw(mut g, xs, k, n.op)\n      }\n    },\n    (\"slice\", 3) => codegen.list_slice(\n      mut g,\n      xs,\n      get(vs, 1) ?? codegen.unit(),\n      get(vs, 2) ?? codegen.unit(),\n    ),\n    _ => {\n      codegen.not_yet(\n        mut g,\n        \"the built-in `\" + name + \"` with these arguments\",\n      )\n      codegen.never()\n    },\n  }\n}","old_text":"/// The list built-ins compiled inline.\nfn list_builtin(\n  mut g: codegen.Gen,\n  name: String,\n  vs: List[codegen.V],\n) -> codegen.V {\n  xs := get(vs, 0) ?? codegen.unit()\n  et := match xs.ty {\n    TList(x) => x,\n    _ => {\n      if name == \"range\" && len(vs) == 2 {\n        return codegen.call(mut g, TList(TInt), \"strata_range\", vs)\n      }\n      codegen.not_yet(mut g, \"the built-in `\"\n        + name\n        + \"` on a `\"\n        + codegen.key(xs.ty)\n        + \"`\")\n      return codegen.never()\n    },\n  }\n  match (name, len(vs)) {\n    (\"len\", 1) => codegen.list_len(mut g, xs),\n    (\"push\", 2) => {\n      if g.copies {\n        codegen.note_extension(mut g, xs, \"1\")\n      }\n      x0 := codegen.take_value(mut g, get(vs, 1) ?? codegen.unit())\n      // pushing onto a list of a union (`push(xs, 3)` on a `List[U | Int]`)\n      // makes the element the union's value, as list literals do. An element\n      // already of the union, or unboxed, is `x0` held once.\n      x := if et is TUnion {\n        u := codegen.to_union(mut g, x0, et)\n        if u.op == x0.op {\n          u\n        } else {\n          codegen.take_value(mut g, u)\n        }\n      } else {\n        x0\n      }\n      sl := codegen.to_slot(mut g, x)\n      t := TList(codegen.better(et, x.ty))\n      codegen.call(mut g, t, \"strata_list_push\", [\n        xs,\n        codegen.V { ty: TInt, op: sl },\n        codegen.elements_kind(codegen.better(et, x.ty)),\n      ])\n    },\n    (\"at\", 2) => {\n      i := get(vs, 1) ?? codegen.unit()\n      codegen.index_check(mut g, xs, i)\n      codegen.list_at(mut g, xs, i.op, et)\n    },\n    // a held list: `x = set_at(x, …)` goes through `set_in_place`\n    (\"set_at\", 3) => {\n      i := get(vs, 1) ?? codegen.unit()\n      codegen.index_check(mut g, xs, i)\n      x := codegen.converted(mut g, get(vs, 2) ?? codegen.unit(), et)\n      if codegen.counted(x.ty) && !codegen.constant(x.op) {\n        codegen.dup_value(mut g, x)\n      }\n      sl := codegen.to_slot(mut g, x)\n      codegen.call(mut g, xs.ty, \"strata_list_set\", [\n        xs,\n        i,\n        codegen.V { ty: TInt, op: sl },\n        codegen.elements_kind(et),\n      ])\n    },\n    (\"get\", 2) => {\n      i := get(vs, 1) ?? codegen.unit()\n      n := codegen.list_len(mut g, xs)\n      (lo, hi, inside) := (\n        codegen.fresh(mut g, \"lo\"),\n        codegen.fresh(mut g, \"hi\"),\n        codegen.fresh(mut g, \"in\"),\n      )\n      codegen.emit(mut g, f\"{lo} = icmp sge i64 {i.op}, 0\")\n      codegen.emit(mut g, f\"{hi} = icmp slt i64 {i.op}, {n.op}\")\n      codegen.emit(mut g, f\"{inside} = and i1 {lo}, {hi}\")\n      (some, none, end) := (\n        codegen.label(mut g, \"get.some\"),\n        codegen.label(mut g, \"get.none\"),\n        codegen.label(mut g, \"get.end\"),\n      )\n      codegen.emit(\n        mut g,\n        f\"br i1 {inside}, label %{some}, label %{none}\",\n      )\n      codegen.block(mut g, some)\n      x := codegen.list_at(mut g, xs, i.op, et)\n      b := codegen.block_of(mut g, get(g.tags, \"Some\") ?? 0, [x])\n      from_some := codegen.current(g)\n      codegen.br(mut g, end)\n      codegen.block(mut g, none)\n      nothing := codegen.nullary(mut g, \"None\")\n      codegen.br(mut g, end)\n      codegen.block(mut g, end)\n      r := codegen.fresh(mut g, \"opt\")\n      codegen.emit(\n        mut g,\n        f\"{r} = phi ptr [ {b}, %{from_some} ], [ {nothing}, %{none} ]\",\n      )\n      codegen.temp(\n        mut g,\n        codegen.V {\n          ty: TNamed { name: \"Option\", args: [et] },\n          op: r,\n        },\n      )\n    },\n    (\"take\", 2) | (\"drop\", 2) => {\n      n := codegen.list_len(mut g, xs)\n      k := codegen.clamp(mut g, (get(vs, 1) ?? codegen.unit()).op, n.op)\n      if name == \"take\" {\n        codegen.slice_raw(mut g, xs, \"0\", k)\n      } else {\n        codegen.slice_raw(mut g, xs, k, n.op)\n      }\n    },\n    (\"slice\", 3) => codegen.list_slice(\n      mut g,\n      xs,\n      get(vs, 1) ?? codegen.unit(),\n      get(vs, 2) ?? codegen.unit(),\n    ),\n    _ => {\n      codegen.not_yet(\n        mut g,\n        \"the built-in `\" + name + \"` with these arguments\",\n      )\n      codegen.never()\n    },\n  }\n}"},{"name":"codegen.for_loop","kind":"fn","old":"164e1711338060fd","new":"350a6aad4c1d1f56","interface_changed":false,"affected":[],"module":"codegen","text":"/// `for pat in xs { … }`: a counter over a range, an index over a list.\n/// The loop holds the list, since the body may change its variable.\nfn for_loop(\n  mut g: codegen.Gen,\n  pat: ast.Pattern,\n  iter: ast.Expr,\n  body: ast.Expr,\n) {\n  // `range(a, b)` counts, unless the program defines its own `range`\n  counting := match iter {\n    ast.Call { callee: ast.Var(\"range\"), args: [_, _] } => codegen.fn_key(g, \"range\") == \"\"\n      && codegen.lookup(g, \"range\") is None,\n    _ => false,\n  }\n  (counter, n, xs) := match iter {\n    ast.Call { args: [lo, hi], .. } => if counting {\n      vs := match codegen.operands(mut g, [lo, hi]) {\n        Some(vs) => vs,\n        None => return,\n      }\n      (\n        get(vs, 0) ?? codegen.unit(),\n        get(vs, 1) ?? codegen.unit(),\n        None,\n      )\n    } else {\n      match codegen.for_list(mut g, iter, pat, body) {\n        Some(l) => (\n          codegen.V { ty: check.TInt, op: \"0\" },\n          codegen.V { ty: check.TInt, op: \"\" },\n          Some(l),\n        ),\n        None => return,\n      }\n    },\n    _ => match codegen.for_list(mut g, iter, pat, body) {\n      Some(l) => (\n        codegen.V { ty: check.TInt, op: \"0\" },\n        codegen.V { ty: check.TInt, op: \"\" },\n        Some(l),\n      ),\n      None => return,\n    },\n  }\n  (head, inner, step, end) := (\n    codegen.label(mut g, \"for\"),\n    codegen.label(mut g, \"for.body\"),\n    codegen.label(mut g, \"for.next\"),\n    codegen.label(mut g, \"endfor\"),\n  )\n  // the counter: a `phi` of its start and the step's next value\n  pre := codegen.current(g)\n  (i, next) := (codegen.fresh(mut g, \"i\"), codegen.fresh(mut g, \"i\"))\n  codegen.br(mut g, head)\n  codegen.block(mut g, head)\n  codegen.emit(\n    mut g,\n    f\"{i} = phi i64 [ {counter.op}, %{pre} ], [ {next}, %{step} ]\",\n  )\n  codegen.invariants(mut g, body)\n  bound := match xs {\n    Some(l) => codegen.list_len(mut g, l),\n    None => n,\n  }\n  // over a list, the index and the length are both small\n  more := if xs is Some {\n    r := codegen.fresh(mut g, \"more\")\n    codegen.emit(mut g, f\"{r} = icmp slt i64 {i}, {bound.op}\")\n    codegen.V { ty: check.TBool, op: r }\n  } else {\n    codegen.int_compare(\n      mut g,\n      \"slt\",\n      codegen.V { ty: check.TInt, op: i },\n      bound,\n    )\n  }\n  codegen.emit(\n    mut g,\n    f\"br i1 {more.op}, label %{inner}, label %{end}\",\n  )\n  codegen.block(mut g, inner)\n  x := match xs {\n    Some(l) => match l.ty {\n      check.TList(et) => codegen.list_at(mut g, l, i, et),\n      _ => codegen.never(),\n    },\n    None => codegen.V { ty: check.TInt, op: i },\n  }\n  depth := len(g.scopes)\n  codegen.push_scope(mut g)\n  fail := codegen.label(mut g, \"for.nomatch\")\n  from := len(g.lines)\n  codegen.matches(mut g, pat, x, fail)\n  can_fail := codegen.jumps_to(g, from, fail)\n  // the element is borrowed: the loop holds the list\n  g.borrowing = true\n  codegen.binds(mut g, pat, x)\n  g.borrowing = false\n  mut g.loops.push((step, end, depth))\n  codegen.loop_step(mut g)\n  _ := codegen.expr(mut g, body)\n  g.loops = take(g.loops, len(g.loops) - 1)\n  codegen.pop_scope(mut g)\n  codegen.br(mut g, step)\n  // an irrefutable pattern (`x`) has no fault branch\n  if can_fail {\n    codegen.block(mut g, fail)\n    codegen.push_scope(mut g)\n    sx := codegen.shown(mut g, x)\n    m := codegen.lit(mut g, \"for-loop pattern did not match \")\n    codegen.fault(mut g, 4, [m, sx])\n    codegen.discard_scope(mut g)\n    codegen.br(mut g, step)\n  }\n  codegen.block(mut g, step)\n  codegen.emit(mut g, f\"{next} = add i64 {i}, 1\")\n  codegen.br(mut g, head)\n  codegen.block(mut g, end)\n}","old_text":"/// `for pat in xs { … }`: a counter over a range, an index over a list.\n/// The loop holds the list, since the body may change its variable.\nfn for_loop(\n  mut g: codegen.Gen,\n  pat: ast.Pattern,\n  iter: ast.Expr,\n  body: ast.Expr,\n) {\n  // `range(a, b)` counts, unless the program defines its own `range`\n  counting := match iter {\n    ast.Call { callee: ast.Var(\"range\"), args: [_, _] } => codegen.fn_key(g, \"range\") == \"\"\n      && codegen.lookup(g, \"range\") is None,\n    _ => false,\n  }\n  (counter, n, xs) := match iter {\n    ast.Call { args: [lo, hi], .. } => if counting {\n      vs := match codegen.operands(mut g, [lo, hi]) {\n        Some(vs) => vs,\n        None => return,\n      }\n      (\n        get(vs, 0) ?? codegen.unit(),\n        get(vs, 1) ?? codegen.unit(),\n        None,\n      )\n    } else {\n      match codegen.for_list(mut g, iter, pat, body) {\n        Some(l) => (\n          codegen.V { ty: TInt, op: \"0\" },\n          codegen.V { ty: TInt, op: \"\" },\n          Some(l),\n        ),\n        None => return,\n      }\n    },\n    _ => match codegen.for_list(mut g, iter, pat, body) {\n      Some(l) => (\n        codegen.V { ty: TInt, op: \"0\" },\n        codegen.V { ty: TInt, op: \"\" },\n        Some(l),\n      ),\n      None => return,\n    },\n  }\n  (head, inner, step, end) := (\n    codegen.label(mut g, \"for\"),\n    codegen.label(mut g, \"for.body\"),\n    codegen.label(mut g, \"for.next\"),\n    codegen.label(mut g, \"endfor\"),\n  )\n  // the counter: a `phi` of its start and the step's next value\n  pre := codegen.current(g)\n  (i, next) := (codegen.fresh(mut g, \"i\"), codegen.fresh(mut g, \"i\"))\n  codegen.br(mut g, head)\n  codegen.block(mut g, head)\n  codegen.emit(\n    mut g,\n    f\"{i} = phi i64 [ {counter.op}, %{pre} ], [ {next}, %{step} ]\",\n  )\n  codegen.invariants(mut g, body)\n  bound := match xs {\n    Some(l) => codegen.list_len(mut g, l),\n    None => n,\n  }\n  // over a list, the index and the length are both small\n  more := if xs is Some {\n    r := codegen.fresh(mut g, \"more\")\n    codegen.emit(mut g, f\"{r} = icmp slt i64 {i}, {bound.op}\")\n    codegen.V { ty: TBool, op: r }\n  } else {\n    codegen.int_compare(\n      mut g,\n      \"slt\",\n      codegen.V { ty: TInt, op: i },\n      bound,\n    )\n  }\n  codegen.emit(\n    mut g,\n    f\"br i1 {more.op}, label %{inner}, label %{end}\",\n  )\n  codegen.block(mut g, inner)\n  x := match xs {\n    Some(l) => match l.ty {\n      TList(et) => codegen.list_at(mut g, l, i, et),\n      _ => codegen.never(),\n    },\n    None => codegen.V { ty: TInt, op: i },\n  }\n  depth := len(g.scopes)\n  codegen.push_scope(mut g)\n  fail := codegen.label(mut g, \"for.nomatch\")\n  from := len(g.lines)\n  codegen.matches(mut g, pat, x, fail)\n  can_fail := codegen.jumps_to(g, from, fail)\n  // the element is borrowed: the loop holds the list\n  g.borrowing = true\n  codegen.binds(mut g, pat, x)\n  g.borrowing = false\n  mut g.loops.push((step, end, depth))\n  codegen.loop_step(mut g)\n  _ := codegen.expr(mut g, body)\n  g.loops = take(g.loops, len(g.loops) - 1)\n  codegen.pop_scope(mut g)\n  codegen.br(mut g, step)\n  // an irrefutable pattern (`x`) has no fault branch\n  if can_fail {\n    codegen.block(mut g, fail)\n    codegen.push_scope(mut g)\n    sx := codegen.shown(mut g, x)\n    m := codegen.lit(mut g, \"for-loop pattern did not match \")\n    codegen.fault(mut g, 4, [m, sx])\n    codegen.discard_scope(mut g)\n    codegen.br(mut g, step)\n  }\n  codegen.block(mut g, step)\n  codegen.emit(mut g, f\"{next} = add i64 {i}, 1\")\n  codegen.br(mut g, head)\n  codegen.block(mut g, end)\n}"},{"name":"codegen.eq_list","kind":"fn","old":"beef2f4c90670aa0","new":"b6f3ba0a7601ff01","interface_changed":true,"affected":["codegen.helper","codegen.show","codegen.shown","codegen.equal","codegen.entry","codegen.interp","codegen.builtin","codegen.string_builtin","codegen.format_spec","codegen.dyn_wrapper","codegen.union_text","codegen.destructure","codegen.debug_fields","c