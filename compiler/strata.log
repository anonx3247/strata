esult\", args: [a, _] } => a,\n    _ => check.TAny,\n  }\n}","old_text":"// ---- failures as values ----\n\n/// The type an `Option` or `Result` holds on success.\nfn inner_of(t: Ty) -> Ty {\n  match t {\n    TNamed { name: \"Option\", args: [a] } => a,\n    TNamed { name: \"Result\", args: [a, _] } => a,\n    _ => TAny,\n  }\n}"},{"name":"codegen.try_expr","kind":"fn","old":"f7b4fafc5a065ce3","new":"2e2397784184baa8","interface_changed":false,"affected":[],"module":"codegen","text":"/// `r!`, `o?`: the value held. An `Err` or `None` is returned as is from\n/// the function or lambda.\nfn try_expr(\n  mut g: codegen.Gen,\n  value: ast.Expr,\n  kind: ast.TryKind,\n) -> codegen.V {\n  codegen.try_want(mut g, value, kind, check.TAny)\n}","old_text":"/// `r!`, `o?`: the value held. An `Err` or `None` is returned as is from\n/// the function or lambda.\nfn try_expr(\n  mut g: codegen.Gen,\n  value: ast.Expr,\n  kind: ast.TryKind,\n) -> codegen.V {\n  codegen.try_want(mut g, value, kind, TAny)\n}"},{"name":"codegen.except_expr","kind":"fn","old":"01964a0928943e73","new":"1fce4108585c8374","interface_changed":false,"affected":[],"module":"codegen","text":"/// `x except { … }` and `x except e { … }` on a `Result`, `x ?? v` on an\n/// `Option` or `Result`: the held value, else the fallback (with the error\n/// bound to `e`).\nfn except_expr(\n  mut g: codegen.Gen,\n  value: ast.Expr,\n  err: Option[String],\n  fallback: ast.Expr,\n) -> codegen.V {\n  // `get(xs, i) ?? d` on a list: the element or `d`, no `Option` made\n  match (err, value) {\n    (None, ast.Call { callee: ast.Var(\"get\"), args: [a, b] }) => if codegen.lookup(g, \"get\") is None\n      && codegen.fn_key(g, \"get\") == \"\" {\n      xs := codegen.expr(mut g, a)\n      if xs.ty is check.TAny {\n        return xs\n      }\n      v := match xs.ty {\n        check.TList(et) => return codegen.list_get_or(mut g, xs, b, et, fallback),\n        _ => codegen.builtin_call(mut g, \"get\", xs, [b]),\n      }\n      if v.ty is check.TAny {\n        return v\n      }\n      return codegen.or_else(mut g, v, None, fallback)\n    },\n    _ => (),\n  }\n  // (a call's result only read here: on the stack)\n  v := codegen.expr_on_stack(mut g, value, true)\n  if v.ty is check.TAny {\n    return v\n  }\n  codegen.or_else(mut g, v, err, fallback)\n}","old_text":"/// `x except { … }` and `x except e { … }` on a `Result`, `x ?? v` on an\n/// `Option` or `Result`: the held value, else the fallback (with the error\n/// bound to `e`).\nfn except_expr(\n  mut g: codegen.Gen,\n  value: ast.Expr,\n  err: Option[String],\n  fallback: ast.Expr,\n) -> codegen.V {\n  // `get(xs, i) ?? d` on a list: the element or `d`, no `Option` made\n  match (err, value) {\n    (None, ast.Call { callee: ast.Var(\"get\"), args: [a, b] }) => if codegen.lookup(g, \"get\") is None\n      && codegen.fn_key(g, \"get\") == \"\" {\n      xs := codegen.expr(mut g, a)\n      if xs.ty is TAny {\n        return xs\n      }\n      v := match xs.ty {\n        TList(et) => return codegen.list_get_or(mut g, xs, b, et, fallback),\n        _ => codegen.builtin_call(mut g, \"get\", xs, [b]),\n      }\n      if v.ty is TAny {\n        return v\n      }\n      return codegen.or_else(mut g, v, None, fallback)\n    },\n    _ => (),\n  }\n  // (a call's result only read here: on the stack)\n  v := codegen.expr_on_stack(mut g, value, true)\n  if v.ty is TAny {\n    return v\n  }\n  codegen.or_else(mut g, v, err, fallback)\n}"},{"name":"codegen.get_path","kind":"fn","old":"8f5ba5ed2b8d30db","new":"9e654f3c1b66e0b3","interface_changed":false,"affected":[],"module":"codegen","text":"/// The value at `path` in `v`, borrowed.\nfn get_path(mut g: codegen.Gen, v: codegen.V, path: List[String]) -> codegen.V {\n  mut cur := v\n  for f in path {\n    cur = codegen.field_named(mut g, cur, f)\n    if cur.ty is check.TAny {\n      return cur\n    }\n  }\n  cur\n}","old_text":"/// The value at `path` in `v`, borrowed.\nfn get_path(mut g: codegen.Gen, v: codegen.V, path: List[String]) -> codegen.V {\n  mut cur := v\n  for f in path {\n    cur = codegen.field_named(mut g, cur, f)\n    if cur.ty is TAny {\n      return cur\n    }\n  }\n  cur\n}"},{"name":"codegen.field_index","kind":"fn","old":"5b8ec0abc630e8e4","new":"d615636cf34a95da","interface_changed":true,"affected":["codegen.get_field","codegen.call_fn_want","codegen.field_named","codegen.set_path","codegen.union_field","codegen.check_field","codegen.set_field_in_place","codegen.in_place_path","codegen.walkable","codegen.place_written","codegen.expr_node","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.get_path","codegen.held_once_on","codegen.union_set","codegen.assign_at","codegen.update_in_place","codegen.appended","codegen.checked_update","codegen.expr","codegen.expr_want_node","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.builtin_call","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.main_arg","codegen.select_expr","codegen.dyn_call","codegen.stmt_node","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.await_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.try_want","codegen.tag_test","codegen.set_in_place","codegen.take_in_place","codegen.compared","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.expr_want","codege