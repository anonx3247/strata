egen.check_field","codegen.assign_at","codegen.check_union","codegen.check_member","codegen.to_dyn","codegen.dyn_table_is","codegen.mock_value","codegen.builtin","codegen_with","core_rt_text","computed_value","repl_eval","codegen.session_capability","codegen.union_call","codegen.dyn_generic_call","codegen.iterate","codegen.decreases_start","codegen.decreases_entry","codegen.show","codegen.shown","codegen.string_builtin","codegen.dyn_wrapper","codegen.host","codegen.foreign_call","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.session_entry","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.helper","codegen.debug_body","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.equal","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.read_back","eval_files","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// `x -> body`: a function `@\"lambda.N\"` taking the closure block first,\n/// plus a closure block `{ fn, drop, shown, share, captured... }` holding\n/// the variables it reads. `share` marks them shared between threads\n/// (`closure`). Parameter types are written or come from `want`.\nfn lambda(\n  mut g: codegen.Gen,\n  params: List[ast.LamParam],\n  body: ast.Expr,\n  want: check.Ty,\n) -> codegen.V {\n  codegen.lambda_shown(mut g, params, body, want, \"\")\n}","old_text":"/// `x -> body`: a function `@\"lambda.N\"` taking the closure block first,\n/// plus a closure block `{ fn, drop, shown, share, captured... }` holding\n/// the variables it reads. `share` marks them shared between threads\n/// (`closure`). Parameter types are written or come from `want`.\nfn lambda(\n  mut g: codegen.Gen,\n  params: List[ast.LamParam],\n  body: ast.Expr,\n  want: Ty,\n) -> codegen.V {\n  codegen.lambda_shown(mut g, params, body, want, \"\")\n}"},{"name":"codegen.closure","kind":"fn","old":"9d9bf31571377df9","new":"1afd914b8dafd239","interface_changed":false,"affected":[],"module":"codegen","text":"/// A closure block for function `sym`. Without captures, a constant (count\n/// 0, never freed). Else a new block taking the captured values, with its\n/// own drop function and its own share function. The share function marks\n/// the captured values shared between threads (`share_value`); the block\n/// itself is marked by its caller (`share_fn`).\nfn closure(\n  mut g: codegen.Gen,\n  sym: String,\n  captured: List[codegen.V],\n  shown: String,\n) -> String {\n  s := codegen.string(mut g, shown)\n  name := byte_slice(sym, 2, byte_len(sym) - 1)\n  if len(captured) == 0 {\n    c := f\"@\\\"closure:{name}\\\"\"\n    if !codegen.has_helper(g, c) {\n      codegen.add_helper(mut g, c)\n      codegen.use_rt(mut g, \"strata_free\")\n      mut g.globals.push(\n        f\"{c} = private constant {{ i64, ptr, ptr, ptr, ptr }} {{ i64 0, ptr {sym}, ptr @strata_free, ptr {s}, ptr null }}, align 8\",\n      )\n    }\n    return f\"getelementptr inbounds (i8, ptr {c}, i64 8)\"\n  }\n  // its drop: the captures, then itself\n  d := f\"@\\\"drop.{name}\\\"\"\n  saved := g\n  g.lines = []\n  g.proving = \"\"\n  g.can_unwind = false\n  g.unwinds = false\n  g.unwind_chain = []\n  g.allocas = []\n  g.next = 0\n  g.scopes = [codegen.no_scope()]\n  g.loops = []\n  codegen.block(mut g, \"start\")\n  a := codegen.V { ty: check.TStr, op: \"%a\" }\n  mut held := []\n  for (k, c) in enumerate(captured) {\n    if codegen.counted(c.ty) {\n      mut held.push(codegen.field(mut g, a, k + 3, c.ty))\n    }\n  }\n  codegen.use_rt(mut g, \"strata_free\")\n  codegen.emit(mut g, \"call void @strata_free(ptr %a)\")\n  for x in held {\n    codegen.drop_value(mut g, x)\n  }\n  codegen.emit(mut g, \"ret void\")\n  def := join([f\"define void {d}(ptr %a) {{\"]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, def)\n  // its share: what it captured\n  sh := f\"@\\\"share.{name}\\\"\"\n  saved2 := g\n  codegen.start_helper(mut g)\n  env := codegen.V { ty: check.TStr, op: \"%a\" }\n  for (k, c) in enumerate(captured) {\n    if codegen.crosses(c.ty) {\n      codegen.share_value(\n        mut g,\n        codegen.field(mut g, env, k + 3, c.ty),\n      )\n    }\n  }\n  codegen.emit(mut g, \"ret void\")\n  codegen.restore(\n    mut g,\n    saved2,\n    codegen.helper_text(g, f\"define void {sh}(ptr %a)\"),\n  )\n  mut taken := []\n  for c in captured {\n    mut taken.push(codegen.take_value(mut g, c))\n  }\n  p := codegen.fresh(mut g, \"clo\")\n  codegen.use_rt(mut g, \"strata_alloc\")\n  codegen.emit(\n    mut g,\n    f\"{p} = call ptr @strata_alloc(i64 {8 * (len(captured) + 4)})\",\n  )\n  codegen.emit(mut g, f\"store ptr {sym}, ptr {p}\")\n  fns := [\n    codegen.V { ty: check.TStr, op: d },\n    codegen.V { ty: check.TStr, op: s },\n    codegen.V { ty: check.TStr, op: sh },\n  ]\n  for (k, x) in enumerate(fns + taken) {\n    at := codegen.fresh(mut g, \"at\")\n    codegen.emit(\n      mut g,\n      f\"{at} = getelementptr i64, ptr {p}, i64 {k + 1}\",\n    )\n    codegen.store_slot(mut g, x, at)\n  }\n  p\n}","old_text":"/// A closure block for function `sym`. Without captures, a constant (count\n/// 0, never freed). Else a new block taking the captured values, with its\n/// own drop function and its own share function. The share function marks\n/// the captured values shared between threads (`share_value`); the block\n/// itself is marked by its caller (`share_fn`).\nfn closure(\n  mut g: codegen.Gen,\n  sym: String,\n  captured: List[codegen.V],\n  shown: String,\n) -> String {\n  s := codegen.string(mut g, shown)\n  name := byte_slice(sym, 2, byte_len(sym) - 1)\n  if len(captured) == 0 {\n    c := f\"@\\\"closure:{name}\\\"\"\n    if !codegen.has_helper(g, c) {\n      codegen.add_helper(mut g, c)\n      codegen.use_rt(mut g, \"strata_free\")\n      mut g.globals.push(\n        f\"{c} = private constant {{ i64, ptr, ptr, ptr, ptr }} {{ i64 0, ptr {sym}, ptr @strata_free, ptr {s}, ptr null }}, align 8\",\n      )\n    }\n    return f\"getelementptr inbounds (i8, ptr {c}, i64 8)\"\n  }\n  // its drop: the captures, then itself\n  d := f\"@\\\"drop.{name}\\\"\"\n  saved := g\n  g.lines = []\n  g.proving = \"\"\n  g.can_unwind = false\n  g.unwinds = false\n  g.unwind_chain = []\n  g.allocas = []\n  g.next = 0\n  g.scopes = [codegen.no_scope()]\n  g.loops = []\n  codegen.block(mut g, \"start\")\n  a := codegen.V { ty: TStr, op: \"%a\" }\n  mut held := []\n  for (k, c) in enumerate(captured) {\n    if codegen.counted(c.ty) {\n      mut held.push(codegen.field(mut g, a, k + 3, c.ty))\n    }\n  }\n  codegen.use_rt(mut g, \"strata_free\")\n  codegen.emit(mut g, \"call void @strata_free(ptr %a)\")\n  for x in held {\n    codegen.drop_value(mut g, x)\n  }\n  codegen.emit(mut g, \"ret void\")\n  def := join([f\"define void {d}(ptr %a) {{\"]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, def)\n  // its share: what it captured\n  sh := f\"@\\\"share.{name}\\\"\"\n  saved2 := g\n  codegen.start_helper(mut g)\n  env := codegen.V { ty: TStr, op: \"%a\" }\n  for (k, c) in enumerate(captured) {\n    if codegen.crosses(c.ty) {\n      codegen.share_value(\n        mut g,\n        codegen.field(mut g, env, k + 3, c.ty),\n      )\n    }\n  }\n  codegen.emit(mut g, \"ret void\")\n  codegen.restore(\n    mut g,\n    saved2,\n    codegen.helper_text(g, f\"define void {sh}(ptr %a)\"),\n  )\n  mut taken := []\n  for c in captured {\n    mut taken.push(codegen.take_value(mut g, c))\n  }\n  p := codegen.fresh(mut g, \"clo\")\n  codegen.use_rt(mut g, \"strata_alloc\")\n  codegen.emit(\n    mut g,\n    f\"{p} = call ptr @strata_alloc(i64 {8 * (len(captured) + 4)})\",\n  )\n  codegen.emit(mut g, f\"store ptr {sym}, ptr {p}\")\n  fns := [\n    codegen.V { ty: TStr, op: d },\n    codegen.V { ty: TStr, op: s },\n    codegen.V { ty: TStr, op: sh },\n  ]\n  for (k, x) in enumerate(fns + taken) {\n    at := codegen.fresh(mut g, \"at\")\n    codegen.emit(\n      mut g,\n      f\"{at} = getelementptr i64, ptr {p}, i64 {k + 1}\",\n    )\n    codegen.store_slot(mut g, x, at)\n  }\n  p\n}"},{"name":"codegen.call_closure","kind":"fn","old":"a7c8b08d5cf12a85","new":"94152620dde36a53","interface_changed":false,"affected":[],"module":"codegen","text":"/// Calls a closure's function with the block and the arguments.\nfn call_closure(\n  mut g: codegen.Gen,\n  f: codegen.V,\n  args: List[codegen.V],\n) -> codegen.V {\n  match f.ty {\n    check.TFn { ret, .. } => {\n      (raw, fp) := (codegen.fresh(mut g, \"fnp\"), codegen.fresh(mut g, \"fn\"))\n      codegen.emit(mut g, f\"{raw} = load i64, ptr {f.op}\")\n      codegen.emit(mut g, f\"{fp} = inttoptr i64 {raw} to ptr\")\n      r0 := codegen.call_bare(\n        mut g,\n        ret,\n        fp,\n        [codegen.V { ty: check.TStr, op: f.op }] + args,\n      )\n      // a cancel check only when some lambda or function value may wait\n      if codegen.may_wait(g, \"closure\") {\n        codegen.cancel_point_after(mut g, r0)\n      }\n      r := codegen.temp(mut g, r0)\n      if codegen.has_value(ret) || ret is check.TUnit {\n        r\n      } else {\n        codegen.never()\n      }\n    },\n    _ => {\n      codegen.not_yet(\n        mut g,\n        \"calling a `\" + codegen.key(f.ty) + \"`\",\n      )\n      codegen.never()\n    },\n  }\n}","old_text":"/// Calls a closure's function with the block and the arguments.\nfn call_closure(\n  mut g: codegen.Gen,\n  f: codegen.V,\n  args: List[codegen.V],\n) -> codegen.V {\n  match f.ty {\n    TFn { ret, .. } => {\n      (raw, fp) := (codegen.fresh(mut g, \"fnp\"), codegen.fresh(mut g, \"fn\"))\n      codegen.emit(mut g, f\"{raw} = load i64, ptr {f.op}\")\n      codegen.emit(mut g, f\"{fp} = inttoptr i64 {raw} to ptr\")\n      r0 := codegen.call_bare(\n        mut g,\n        ret,\n        fp,\n        [codegen.V { ty: TStr, op: f.op }] + args,\n      )\n      // a cancel check only when some lambda or function value may wait\n      if codegen.may_wait(g, \"closure\") {\n        codegen.cancel_point_after(mut g, r0)\n      }\n      r := codegen.temp(mut g, r0)\n      if codegen.has_value(ret) || ret is TUnit {\n        r\n      } else {\n        codegen.never()\n      }\n    },\n    _ => {\n      codegen.not_yet(\n        mut g,\n        \"calling a `\" + codegen.key(f.ty) + \"`\",\n      )\n      codegen.never()\n    },\n  }\n}"},{"name":"codegen.inst_sym","kind":"fn","old":"39f89514fd455ec9","new":"9de71a9ee664755c","interface_changed":true,"affected":["codegen.function","codegen.instance","codegen.test_entry","codegen.new_gen","codegen.compiled_alone","codegen.call_fn_want","codegen.generate","codegen.session_entry","codegen.read_back","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.ty