"codegen.host","codegen.spawn_expr","codegen.method_value","codegen.generated_args","codegen.makers","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.helper","codegen.debug_body","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.equal","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.read_back","eval_files","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// The result of task `h` (type `rt`), held. The task keeps its own until\n/// its scope ends, so `await` may be asked twice.\n/// - When the handle crossed to another thread (`strata_task_shared`),\n/// more than one thread may hold the result. It is marked shared first,\n/// under the runtime's lock for results.\n/// - Else only this thread sees it, as the task is done.\nfn await_one(mut g: codegen.Gen, h: codegen.V, rt: check.Ty) -> codegen.V {\n  codegen.use_rt(mut g, \"strata_await\")\n  p := codegen.fresh(mut g, \"out\")\n  codegen.emit(mut g, f\"{p} = call ptr @strata_await(ptr {h.op})\")\n  codegen.cancel_point(mut g)\n  if !codegen.has_value(rt) {\n    return codegen.V { ty: rt, op: \"\" }\n  }\n  r := codegen.fresh(mut g, \"result\")\n  codegen.emit(mut g, f\"{r} = load {codegen.ll(rt)}, ptr {p}\")\n  if codegen.crosses(rt) {\n    codegen.use_rt(mut g, \"strata_task_shared\")\n    codegen.use_rt(mut g, \"strata_results_lock\")\n    codegen.use_rt(mut g, \"strata_results_unlock\")\n    sh := codegen.fresh(mut g, \"shared\")\n    (yes, after) := (\n      codegen.label(mut g, \"await.shared\"),\n      codegen.label(mut g, \"await.held\"),\n    )\n    codegen.emit(\n      mut g,\n      f\"{sh} = call i1 @strata_task_shared(ptr {h.op})\",\n    )\n    codegen.emit(mut g, f\"br i1 {sh}, label %{yes}, label %{after}\")\n    codegen.block(mut g, yes)\n    codegen.emit(mut g, \"call void @strata_results_lock()\")\n    codegen.share_value(mut g, codegen.V { ty: rt, op: r })\n    codegen.emit(mut g, \"call void @strata_results_unlock()\")\n    codegen.br(mut g, after)\n    codegen.block(mut g, after)\n  }\n  codegen.hold(mut g, codegen.V { ty: rt, op: r })\n}","old_text":"/// The result of task `h` (type `rt`), held. The task keeps its own until\n/// its scope ends, so `await` may be asked twice.\n/// - When the handle crossed to another thread (`strata_task_shared`),\n/// more than one thread may hold the result. It is marked shared first,\n/// under the runtime's lock for results.\n/// - Else only this thread sees it, as the task is done.\nfn await_one(mut g: codegen.Gen, h: codegen.V, rt: Ty) -> codegen.V {\n  codegen.use_rt(mut g, \"strata_await\")\n  p := codegen.fresh(mut g, \"out\")\n  codegen.emit(mut g, f\"{p} = call ptr @strata_await(ptr {h.op})\")\n  codegen.cancel_point(mut g)\n  if !codegen.has_value(rt) {\n    return codegen.V { ty: rt, op: \"\" }\n  }\n  r := codegen.fresh(mut g, \"result\")\n  codegen.emit(mut g, f\"{r} = load {codegen.ll(rt)}, ptr {p}\")\n  if codegen.crosses(rt) {\n    codegen.use_rt(mut g, \"strata_task_shared\")\n    codegen.use_rt(mut g, \"strata_results_lock\")\n    codegen.use_rt(mut g, \"strata_results_unlock\")\n    sh := codegen.fresh(mut g, \"shared\")\n    (yes, after) := (\n      codegen.label(mut g, \"await.shared\"),\n      codegen.label(mut g, \"await.held\"),\n    )\n    codegen.emit(\n      mut g,\n      f\"{sh} = call i1 @strata_task_shared(ptr {h.op})\",\n    )\n    codegen.emit(mut g, f\"br i1 {sh}, label %{yes}, label %{after}\")\n    codegen.block(mut g, yes)\n    codegen.emit(mut g, \"call void @strata_results_lock()\")\n    codegen.share_value(mut g, codegen.V { ty: rt, op: r })\n    codegen.emit(mut g, \"call void @strata_results_unlock()\")\n    codegen.br(mut g, after)\n    codegen.block(mut g, after)\n  }\n  codegen.hold(mut g, codegen.V { ty: rt, op: r })\n}"},{"name":"codegen.await_list","kind":"fn","old":"2dc71815ba4b9963","new":"b5168c26d148f923","interface_changed":true,"affected":["codegen.await_expr","codegen.expr_node","codegen.expr","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.method_call","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.try_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.expr_want_node","codegen.compared","codegen.stmt_node","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.binds","codegen.matching_v","codegen.match_got","codegen.assertion","codegen.invariants","codegen.tag