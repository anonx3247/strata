,"lint_decls","core_marked","merge.Piece","merge.decl_name_of","merge.key","mutability.mut_errors","parse.parse_module","parse.parse_program","pending.find_decl","pending.decl_short","pending.short_name_of","resolve.stored","resolve.written","resolve.qual","resolve.errors","resolve.stored_from","store.graph","text.doc_text","unused.looked_at","unused.member_key","views.select","views.select_library","read_core","read_core_at","upgrade_command","members_of","impls","proofs_command","proofs_kept_at","reach","dep_tests","check.with_code","mutability.report","mutability.open","mutability.close","mutability.declare","mutability.is_local","parse.type_params","builtins.builtin_names","load_package","builtin_names","load_found","unused_setting","core_unused","settings_error","finding.all_items","graph.forget","graph.call_flow","graph.one_of","graph.type_hint","graph.joined","graph.variants_of","graph.leaves","graph.mentions_loop","closure_keys","closure_keys_of","resolve.is_local","resolve.bind","resolve.open","resolve.close","resolve.name","resolve.unbound","resolve.covers","resolve.through_binding","resolve.shortest","resolve.check_name","resolve.test_only","diff.touched","diff.diff_text","merge.similarity","diff.closure_hash","main","linked","sync_command","binary.read","binary.read_checked","binary.read_with","store_check","diff.step_names","diff_json","finding.source_of","finding.item_location","finding.find_command","finding.library_source","finding.candidates","finding.target_of","finding.location_of","stored_files","stored_package","use_errors","resolve_command","open_package_at","loading","load","lib_file","lib_hashes","chosen_in","open_package","checked_whole","file_problem","shared","settings_stamp","parse_one","parse_lines","finding.names","proofs_kept","diff.close","tree","bad","parse_files","diff.line_diff"],"module":"ast","text":"/// `Invariant` and `Decreases` are a loop's clauses, first in its body. A\n/// function's `decreases` clause is its body's first statement.\n/// - `AssertBy`: `assert cond by lemma(args)` or `assert cond by { steps }`,\n/// proven from the proof's steps alone, then known. Verify only.\n/// - `Calc`: `calc { a == b; _ <= c }`, a chain proven one step at a time;\n/// a step's `_` is the step before's right side. Verify only.\npub type Stmt =\n  | Let { pat: ast.Pattern, ty: Option[ast.TypeExpr], value: ast.Expr }\n  | VarDecl { name: String, ty: Option[ast.TypeExpr], value: ast.Expr }\n  | Assign { place: ast.Expr, value: ast.Expr }\n  | While { cond: ast.Expr, body: ast.Expr }\n  | For { pat: ast.Pattern, iter: ast.Expr, body: ast.Expr }\n  | Loop(ast.Expr)\n  | Break\n  | Continue\n  | ExprStmt(ast.Expr)\n  | Assert(ast.Expr)\n  | Comment(List[String])\n  | ComptimeFor { pat: ast.Pattern, iter: ast.Expr, body: ast.Expr }\n  | Invariant(ast.Expr)\n  | Decreases(ast.Expr)\n  | AssertBy { cond: ast.Expr, proof: ast.Expr }\n  | Calc(List[ast.Expr])","old_text":"/// `Invariant` and `Decreases` are a loop's clauses, first in its body. A\n/// function's `decreases` clause is its body's first statement.\npub type Stmt =\n  | Let { pat: ast.Pattern, ty: Option[ast.TypeExpr], value: ast.Expr }\n  | VarDecl { name: String, ty: Option[ast.TypeExpr], value: ast.Expr }\n  | Assign { place: ast.Expr, value: ast.Expr }\n  | While { cond: ast.Expr, body: ast.Expr }\n  | For { pat: ast.Pattern, iter: ast.Expr, body: ast.Expr }\n  | Loop(ast.Expr)\n  | Break\n  | Continue\n  | ExprStmt(ast.Expr)\n  | Assert(ast.Expr)\n  | Comment(List[String])\n  | ComptimeFor { pat: ast.Pattern, iter: ast.Expr, body: ast.Expr }\n  | Invariant(ast.Expr)\n  | Decreases(ast.Expr)"}]}
{"id":"bebef3c86f68c9ff","time":1795664573,"message":"edit","changes":[{"name":"binary.use ast","kind":"use","old":"ba504ad73eb33af0","new":"ee5bc51babfeefa9","interface_changed":true,"affected":[],"module":"binary","text":"// binary: the binary format of `.strata` files (docs/binary-format.md). The\n// format is canonical: one tree has one encoding.\n\nfrom ast use DeriveFnDef, DeriveFnDecl, ModelDecl, ModelDef, Decl, DeclKind,\n  TypeDecl, Field, Variant, FnDecl, Param, Bound, TestDecl, TraitDecl,\n  Derivable, TraitMethod, Law, ImplDecl, UseDecl, UseItem, ExternDecl, Lang,\n  CapabilityDecl, TypeExpr, Expr, LamParam, CompFor, CompKind, Arm, FmtSpec,\n  BinOp, UnOp, TryKind, Stmt, Pattern, without_notes, SelectArm, TypeDef, FnDef,\n  TestDef, TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, Alias,\n  RecordBody, SumBody, NoPayload, Positional, RecordPayload, MemberType, C,\n  Python, Builtin, ExternFn, ExternType, ExternStatic, ExternThreadStatic,\n  Named, FnType, UnitType, Refined, UnionType, IntLit, BigIntLit, FloatLit,\n  TupleExpr, StrLit, BoolLit, UnitExpr, Var, Hole, ListExpr, CtorExpr, Call,\n  MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr,\n  MutExpr, Block, MockExpr, Return, Try, Except, Interp, Range, Index, Comp,\n  DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn, Await, Select, Race,\n  SupervisedSpawn, Old, Assumed, Spread, NoArgs, PositionalArgs, RecordArgs,\n  UpdateArgs, ListComp, SetComp, DictComp, TextPart, ValuePart, Add, Sub, Mul,\n  Div, Mod, Equal, NotEqual, Less, LessEq, Greater, GreaterEq, And, Or, Implies,\n  BitAnd, BitOr, BitXor, Shl, Shr, Neg, Not, TryResult, TryOption, Let, VarDecl,\n  Assign, While, For, Loop, Break, Continue, ExprStmt, Assert, Comment,\n  ComptimeFor, Invariant, Decreases, Wild, Bind, IntPat, StrPat, BoolPat,\n  CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat, NoPats,\n  PositionalPats, RecordPats, TypePats, DeriveClause, AssertBy, Calc","old_text":"// binary: the binary format of `.strata` files (docs/binary-format.md). The\n// format is canonical: one tree has one encoding.\n\nfrom ast use DeriveFnDef, DeriveFnDecl, ModelDecl, ModelDef, Decl, DeclKind,\n  TypeDecl, Field, Variant, FnDecl, Param, Bound, TestDecl, TraitDecl,\n  Derivable, TraitMethod, Law, ImplDecl, UseDecl, UseItem, ExternDecl, Lang,\n  CapabilityDecl, TypeExpr, Expr, LamParam, CompFor, CompKind, Arm, FmtSpec,\n  BinOp, UnOp, TryKind, Stmt, Pattern, without_notes, SelectArm, TypeDef, FnDef,\n  TestDef, TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, Alias,\n  RecordBody, SumBody, NoPayload, Positional, RecordPayload, MemberType, C,\n  Python, Builtin, ExternFn, ExternType, ExternStatic, ExternThreadStatic,\n  Named, FnType, UnitType, Refined, UnionType, IntLit, BigIntLit, FloatLit,\n  TupleExpr, StrLit, BoolLit, UnitExpr, Var, Hole, ListExpr, CtorExpr, Call,\n  MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr,\n  MutExpr, Block, MockExpr, Return, Try, Except, Interp, Range, Index, Comp,\n  DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn, Await, Select, Race,\n  SupervisedSpawn, Old, Assumed, Spread, NoArgs, PositionalArgs, RecordArgs,\n  UpdateArgs, ListComp, SetComp, DictComp, TextPart, ValuePart, Add, Sub, Mul,\n  Div, Mod, Equal, NotEqual, Less, LessEq, Greater, GreaterEq, And, Or, Implies,\n  BitAnd, BitOr, BitXor, Shl, Shr, Neg, Not, TryResult, TryOption, Let, VarDecl,\n  Assign, While, For, Loop, Break, Continue, ExprStmt, Assert, Comment,\n  ComptimeFor, Invariant, Decreases, Wild, Bind, IntPat, StrPat, BoolPat,\n  CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat, NoPats,\n  PositionalPats, RecordPats, TypePats, DeriveClause"},{"name":"binary.fn_decl","kind":"fn","old":"aa2de3697da0cec6","new":"db4fb7a60d43c6fb","interface_changed":false,"affected":[],"module":"binary","text":"fn fn_decl(mut r: binary.Reader) -> Result[ast.FnDecl, String] {\n  doc := binary.strs(mut r)!\n  comments := binary.strs(mut r)!\n  name := binary.str(mut r)!\n  type_params := binary.strs(mut r)!\n  bs := binary.bounds(mut r)!\n  ps := binary.params(mut r)!\n  // named results (`-> (next: Q, added: Int)`): tag 5, the names, then the\n  // tuple's type\n  results := if binary.byte(mut r)! == 5 {\n    binary.strs(mut r)!\n  } else {\n    r.pos -= 1\n    []\n  }\n  ret := binary.type_expr(mut r)!\n  pre := binary.exprs(mut r)!\n  post := binary.exprs(mut r)!\n  // one byte: 1 `terminates`, 2 `noalloc`, 4 a `lemma`\n  flags := binary.tag(mut r, \"function flags\", 7)!\n  terminating := flags % 2 == 1\n  no_alloc := flags % 4 >= 2\n  lemma := flags >= 4\n  body := binary.expr(mut r)!\n  compile_time := binary.boolean(mut r)!\n  derived := binary.boolean(mut r)!\n  Ok(ast.FnDecl {\n    doc,\n    comments,\n    name,\n    type_params,\n    bounds: bs,\n    params: ps,\n    ret,\n    pre,\n    post,\n    terminating,\n    body,\n    compile_time,\n    derived,\n    results,\n    no_alloc,\n    lemma,\n  })\n}","old_text":"fn fn_decl(mut r: binary.Reader) -> Result[ast.FnDecl, String] {\n  doc := binary.strs(mut r)!\n  comments := binary.strs(mut r)!\n  name := binary.str(mut r)!\n  type_params := binary.strs(mut r)!\n  bs := binary.bounds(mut r)!\n  ps := binary.params(mut r)!\n  // named results (`-> (next: Q, added: Int)`): tag 5, the names, then the\n  // tuple's type\n  results := if binary.byte(mut r)! == 5 {\n    binary.strs(mut r)!\n  } else {\n    r.pos -= 1\n    []\n  }\n  ret := binary.type_expr(mut r)!\n  pre := binary.exprs(mut r)!\n  post := binary.exprs(mut r)!\n  // one byte: 1 `terminates`, 2 `noalloc`\n  flags := binary.tag(mut r, \"function flags\", 3)!\n  terminating := flags % 2 == 1\n  no_alloc := flags >= 2\n  body := binary.expr(mut r)!\n  compile_time := binary.boolean(mut r)!\n  derived := binary.boolean(mut r)!\n  Ok(ast.FnDecl {\n    doc,\n    comments,\n    name,\n    type_params,\n    bounds: bs,\n    params: ps,\n    ret,\n    pre,\n    post,\n    terminating,\n    body,\n    compile_time,\n    derived,\n    results,\n    no_alloc,\n  })\n}"},{"name":"binary.stmt","kind":"fn","old":"7e123e1414da3b78","new":"6a12ecd9328c1d51","interface_changed":false,"affected":[],"module":"binary","text":"fn stmt(mut r: binary.Reader) -> Result[ast.Stmt, String] {\n  Ok(match binary.tag(mut r, \"statement\", 15)! {\n    0 => {\n      pat := binary.pattern(mut r)!\n      ty := binary.opt_type(mut r)!\n      value := binary.expr(mut r)!\n      ast.Let { pat, ty, value }\n    },\n    1 => {\n      name := binary.str(mut r)!\n      ty := binary.opt_type(mut r)!\n      value := binary.expr(mut r)!\n      ast.VarDecl { name, ty, value }\n    },\n    2 => {\n      place := binary.expr(mut r)!\n      value := binary.expr(mut r)!\n      ast.Assign { place, value }\n    },\n    3 => {\n      cond := binary.expr(mut r)!\n      body := binary.expr(mut r)!\n      ast.While { cond, body }\n    },\n    4 => {\n      pat := binary.pattern(mut r)!\n      iter := binary.expr(mut r)!\n      body := binary.expr(mut r)!\n      ast.For { pat, iter, body }\n    },\n    5 => ast.Loop(binary.expr(mut r)!),\n    6 => ast.Break,\n    7 => ast.Continue,\n    8 => ast.ExprStmt(binary.expr(mut r)!),\n    9 => ast.Assert(binary.expr(mut r)!),\n    10 => ast.Comment(binary.strs(mut r)!),\n    11 => {\n      pat := binary.pattern(mut r)!\n      iter := binary.expr(mut r)!\n      body := binary.expr(mut r)!\n      ast.ComptimeFor { pat, iter, body }\n    },\n    12 => ast.Invariant(binary.expr(mut r)!),\n    13 => ast.Decreases(binary.expr(mut r)!),\n    14 => {\n      cond := binary.expr(mut r)!\n      proof := binary.expr(mut r)!\n      ast.AssertBy { cond, proof }\n    },\n    _ => ast.Calc(binary.exprs(mut r)!),\n  })\n}","old_text":"fn stmt(mut r: binary.Reader) -> Result[ast.Stmt, String] {\n  Ok(match binary.tag(mut r, \"statement\", 13)! {\n    0 => {\n      pat := binary.pattern(mut r)!\n      ty := binary.opt_type(mut r)!\n      value := binary.expr(mut r)!\n      ast.Let { pat, ty, value }\n    },\n    1 => {\n      name := binary.str(mut r)!\n      ty := binary.opt_type(mut r)!\n      value := binary.expr(mut r)!\n      ast.VarDecl { name, ty, value }\n    },\n    2 => {\n      place := binary.expr(mut r)!\n      value := binary.expr(mut r)!\n      ast.Assign { place, value }\n    },\n    3 => {\n      cond := binary.expr(mut r)!\n      body := binary.expr(mut r)!\n      ast.While { cond, body }\n    },\n    4 => {\n      pat := binary.pattern(mut r)!\n      iter := binary.expr(mut r)!\n      body := binary.expr(mut r)!\n      ast.For { pat, iter, body }\n    },\n    5 => ast.Loop(binary.expr(mut r)!),\n    6 => ast.Break,\n    7 => ast.Continue,\n    8 => ast.ExprStmt(binary.expr(mut r)!),\n    9 => ast.Assert(binary.expr(mut r)!),\n    10 => ast.Comment(binary.strs(mut r)!),\n    11 => {\n      pat := binary.pattern(mut r)!\n      iter := binary.expr(mut r)!\n      body := binary.expr(mut r)!\n      ast.ComptimeFor { pat, iter, body }\n    },\n    12 => ast.Invariant(binary.expr(mut r)!),\n    _ => ast.Decreases(binary.expr(mut r)!),\n  })\n}"},{"name":"binary.put_fn","kind":"fn","old":"4b72471047564693","new":"3be3b31c3f6b8243","interface_changed":false,"affected":[],"module":"binary","text":"fn put_fn(mut w: binary.Writer, f: ast.FnDecl) {\n  binary.w_strs(mut w, f.doc)\n  binary.w_strs(mut w, f.comments)\n  binary.w_str(mut w, f.name)\n  binary.w_strs(mut w, f.type_params)\n  binary.w_bounds(mut w, f.bounds)\n  binary.w_params(mut w, f.params)\n  if f.results != [] {\n    binary.w_byte(mut w, 5)\n    binary.w_strs(mut w, f.results)\n  }\n  binary.put_type(mut w, f.ret)\n  binary.w_exprs(mut w, f.pre)\n  binary.w_exprs(mut w, f.post)\n  // one byte: 1 `terminates`, 2 `noalloc`, 4 a `lemma`\n  binary.w_byte(mut w, if f.terminating {\n      1\n    } else {\n      0\n    }\n    + if f.no_alloc {\n      2\n    } else {\n      0\n    }\n    + if f.lemma {\n      4\n    } else {\n      0\n    })\n  binary.put_expr(mut w, f.body)\n  binary.w_bool(mut w, f.compile_time)\n  binary.w_bool(mut w, f.derived)\n}","old_text":"fn put_fn(mut w: binary.Writer, f: ast.FnDecl) {\n  binary.w_strs(mut w, f.doc)\n  binary.w_strs(mut w, f.comments)\n  binary.w_str(mut w, f.name)\n  binary.w_strs(mut w, f.type_params)\n  binary.w_bounds(mut w, f.bounds)\n  binary.w_params(mut w, f.params)\n  if f.results != [] {\n    binary.w_byte(mut w, 5)\n    binary.w_strs(mut w, f.results)\n  }\n  binary.put_type(mut w, f.ret)\n  binary.w_exprs(mut w, f.pre)\n  binary.w_exprs(mut w, f.post)\n  // one byte: 1 `terminates`, 2 `noalloc`\n  binary.w_byte(mut w, if f.terminating {\n      1\n    } else {\n      0\n    }\n    + if f.no_alloc {\n      2\n    } else {\n      0\n    })\n  binary.put_expr(mut w, f.body)\n  binary.w_bool(mut w, f.compile_time)\n  binary.w_bool(mut w, f.derived)\n}"},{"name":"binary.put_stmt","kind":"fn","old":"d1000eb740ea46f6","new":"5e198a4ec9bb07db","interface_changed":false,"affected":[],"module":"binary","text":"fn put_stmt(mut w: binary.Writer, s: ast.Stmt) {\n  match s {\n    ast.Let { pat, ty, value } => {\n      binary.w_byte(mut w, 0)\n      binary.put_pattern(mut w, pat)\n      binary.w_opt_type(mut w, ty)\n      binary.put_expr(mut w, value)\n    },\n    ast.VarDecl { name, ty, value } => {\n      binary.w_byte(mut w, 1)\n      binary.w_str(mut w, name)\n      binary.w_opt_type(mut w, ty)\n      binary.put_expr(mut w, value)\n    },\n    ast.Assign { place, value } => {\n      binary.w_byte(mut w, 2)\n      binary.put_expr(mut w, place)\n      binary.put_expr(mut w, value)\n    },\n    ast.While { cond, body } => {\n      binary.w_byte(mut w, 3)\n      binary.put_expr(mut w, cond)\n      binary.put_expr(mut w, body)\n    },\n    ast.For { pat, iter, body } => {\n      binary.w_byte(mut w, 4)\n      binary.put_pattern(mut w, pat)\n      binary.put_expr(mut w, iter)\n      binary.put_expr(mut w, body)\n    },\n    ast.Loop(body) => {\n      binary.w_byte(mut w, 5)\n      binary.put_expr(mut w, body)\n    },\n    ast.Break => binary.w_byte(mut w, 6),\n    ast.Continue => binary.w_byte(mut w, 7),\n    ast.ExprStmt(e) => {\n      binary.w_byte(mut w, 8)\n      binary.put_expr(mut w, e)\n    },\n    ast.Assert(e) => {\n      binary.w_byte(mut w, 9)\n      binary.put_expr(mut w, e)\n    },\n    ast.Comment(lines) => {\n      binary.w_byte(mut w, 10)\n      binary.w_strs(mut w, lines)\n    },\n    ast.ComptimeFor { pat, iter, body } => {\n      binary.w_byte(mut w, 11)\n      binary.put_pattern(mut w, pat)\n      binary.put_expr(mut w, iter)\n      binary.put_expr(mut w, body)\n    },\n    ast.Invariant(e) => {\n      binary.w_byte(mut w, 12)\n      binary.put_expr(mut w, e)\n    },\n    ast.Decreases(e) => {\n      binary.w_byte(mut w, 13)\n      binary.put_expr(mut w, e)\n    },\n    ast.AssertBy { cond, proof } => {\n      binary.w_byte(mut w, 14)\n      binary.put_expr(mut w, cond)\n      binary.put_expr(mut w, proof)\n    },\n    ast.Calc(steps) => {\n      binary.w_byte(mut w, 15)\n      binary.w_exprs(mut w, steps)\n    },\n  }\n}","old_text":"fn put_stmt(mut w: binary.Writer, s: ast.Stmt) {\n  match s {\n    ast.Let { pat, ty, value } => {\n      binary.w_byte(mut w, 0)\n      binary.put_pattern(mut w, pat)\n      binary.w_opt_type(mut w, ty)\n      binary.put_expr(mut w, value)\n    },\n    ast.VarDecl { name, ty, value } => {\n      binary.w_byte(mut w, 1)\n      binary.w_str(mut w, name)\n      binary.w_opt_type(mut w, ty)\n      binary.put_expr(mut w, value)\n    },\n    ast.Assign { place, value } => {\n      binary.w_byte(mut w, 2)\n      binary.put_expr(mut w, place)\n      binary.put_expr(mut w, value)\n    },\n    ast.While { cond, body } => {\n      binary.w_byte(mut w, 3)\n      binary.put_expr(mut w, cond)\n      binary.put_expr(mut w, body)\n    },\n    ast.For { pat, iter, body } => {\n      binary.w_byte(mut w, 4)\n      binary.put_pattern(mut w, pat)\n      binary.put_expr(mut w, iter)\n      binary.put_expr(mut w, body)\n    },\n    ast.Loop(body) => {\n      binary.w_byte(mut w, 5)\n      binary.put_expr(mut w, body)\n    },\n    ast.Break => binary.w_byte(mut w, 6),\n    ast.Continue => binary.w_byte(mut w, 7),\n    ast.ExprStmt(e) => {\n      binary.w_byte(mut w, 8)\n      binary.put_expr(mut w, e)\n    },\n    ast.Assert(e) => {\n      binary.w_byte(mut w, 9)\n      binary.put_expr(mut w, e)\n    },\n    ast.Comment(lines) => {\n      binary.w_byte(mut w, 10)\n      binary.w_strs(mut w, lines)\n    },\n    ast.ComptimeFor { pat, iter, body } => {\n      binary.w_byte(mut w, 11)\n      binary.put_pattern(mut w, pat)\n      binary.put_expr(mut w, iter)\n      binary.put_expr(mut w, body)\n    },\n    ast.Invariant(e) => {\n      binary.w_byte(mut w, 12)\n      binary.put_expr(mut w, e)\n    },\n    _ => match s {\n      ast.Decreases(e) => {\n        binary.w_byte(mut w, 13)\n        binary.put_expr(mut w, e)\n      },\n      _ => (),\n    },\n  }\n}"}]}
{"id":"ed5deeaa956249da","time":1795664668,"message":"edit","changes":[{"name":"parse.use ast","kind":"use","old":"24396db40f45ef86","new":"5ece79d9bbcaa920","interface_changed":true,"affected":[],"module":"parse","text":"// parse: Strata's parser, from text to the tree in `ast`, comments included.\n// The tree is as written. Storing it (`strata edit`) qualifies its\n// references, which needs name resolution.\n\nfrom ast use DeriveFnDecl, DeriveFnDef, ModelDecl, ModelDef, Decl, DeclKind,\n  TypeDecl, TypeBody, Field, Variant, Payload, FnDecl, Param, Bound, TestDecl,\n  TraitDecl, Derivable, TraitMethod, Law, ImplDecl, UseDecl, UseItem,\n  ExternDecl, CapabilityDecl, TypeExpr, Expr, LamParam, CompFor, Arm, StrPart,\n  FmtSpec, BinOp, Stmt, Pattern, SelectArm, TypeDef, FnDef, TestDef, TraitDef,\n  ImplDef, UseDef, ExternDef, CapabilityDef, Alias, RecordBody, SumBody,\n  NoPayload, Positional, RecordPayload, MemberType, C, Builtin, Python,\n  ExternFn, ExternType, ExternStatic, ExternThreadStatic, Named, FnType,\n  UnitType, Refined, UnionType, IntLit, BigIntLit, FloatLit, TupleExpr, StrLit,\n  BoolLit, UnitExpr, Var, Hole, ListExpr, CtorExpr, Call, MethodCall, FieldOf,\n  Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr, MutExpr, Block, MockExpr,\n  Return, Try, Except, Interp, Range, Index, Comp, DictExpr, SetExpr, Fallback,\n  Comptime, Scope, Spawn, Await, Select, Race, SupervisedSpawn, Old, Assumed,\n  Spread, NoArgs, PositionalArgs, RecordArgs, UpdateArgs, ListComp, SetComp,\n  DictComp, TextPart, ValuePart, Add, Sub, Mul, Div, Mod, Equal, NotEqual, Less,\n  LessEq, Greater, GreaterEq, And, Or, Implies, BitAnd, BitOr, BitXor, Shl, Shr,\n  Neg, Not, TryResult, TryOption, Let, VarDecl, Assign, While, For, Loop, Break,\n  Continue, ExprStmt, Assert, Comment, ComptimeFor, Invariant, Decreases, Wild,\n  Bind, IntPat, StrPat, BoolPat, CtorPattern, ListPat, TuplePat, CondPat, OrPat,\n  ForPat, NoPats, PositionalPats, RecordPats, TypePats, DeriveClause, AssertBy,\n  Calc","old_text":"// parse: Strata's parser, from text to the tree in `ast`, comments included.\n// The tree is as written. Storing it (`strata edit`) qualifies its\n// references, which needs name resolution.\n\nfrom ast use DeriveFnDecl, DeriveFnDef, ModelDecl, ModelDef, Decl, DeclKind,\n  TypeDecl, TypeBody, Field, Variant, Payload, FnDecl, Param, Bound, TestDecl,\n  TraitDecl, Derivable, TraitMethod, Law, ImplDecl, UseDecl, UseItem,\n  ExternDecl, CapabilityDecl, TypeExpr, Expr, LamParam, CompFor, Arm, StrPart,\n  FmtSpec, BinOp, Stmt, Pattern, SelectArm, TypeDef, FnDef, TestDef, TraitDef,\n  ImplDef, UseDef, ExternDef, CapabilityDef, Alias, RecordBody, SumBody,\n  NoPayload, Positional, RecordPayload, MemberType, C, Builtin, Python,\n  ExternFn, ExternType, ExternStatic, ExternThreadStatic, Named, FnType,\n  UnitType, Refined, UnionType, IntLit, BigIntLit, FloatLit, TupleExpr, StrLit,\n  BoolLit, UnitExpr, Var, Hole, ListExpr, CtorExpr, Call, MethodCall, FieldOf,\n  Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr, MutExpr, Block, MockExpr,\n  Return, Try, Except, Interp, Range, Index, Comp, DictExpr, SetExpr, Fallback,\n  Comptime, Scope, Spawn, Await, Select, Race, SupervisedSpawn, Old, Assumed,\n  Spread, NoArgs, PositionalArgs, RecordArgs, UpdateArgs, ListComp, SetComp,\n  DictComp, TextPart, ValuePart, Add, Sub, Mul, Div, Mod, Equal, NotEqual, Less,\n  LessEq, Greater, GreaterEq, And, Or, Implies, BitAnd, BitOr, BitXor, Shl, Shr,\n  Neg, Not, TryResult, TryOption, Let, VarDecl, Assign, While, For, Loop, Break,\n  Continue, ExprStmt, Assert, Comment, ComptimeFor, Invariant, Decreases, Wild,\n  Bind, IntPat, StrPat, BoolPat, CtorPattern, ListPat, TuplePat, CondPat, OrPat,\n  ForPat, NoPats, PositionalPats, RecordPats, TypePats, DeriveClause"},{"name":"parse.decl_kind","kind":"fn","old":"60e926c65e300956","new":"fb96ecd375c543b8","interface_changed":false,"affected":[],"module":"parse","text":"fn decl_kind(mut p: parse.Parser) -> Result[ast.DeclKind, String] {\n  // `distinct` is only a keyword at the start of a declaration\n  if parse.is_kw(p, \"distinct\") && parse.is_kw_at(p, 1, \"type\") {\n    parse.advance(mut p)\n    parse.expect_kw(mut p, \"type\")!\n    t := parse.type_decl(mut p)!\n    // a union of bare names may be a union of types defined elsewhere; storing decides\n    if t.body is ast.RecordBody {\n      return parse.fail(\n        p,\n        \"only an alias can be `distinct` (records and sum types already are)\",\n      )\n    }\n    return Ok(ast.TypeDef(ast.TypeDecl { ..t, distinct: true }))\n  }\n  if parse.is_kw(p, \"mock\")\n    && parse.is_ident_at(p, 1)\n    && (parse.is_sym_at(p, 2, \"=\") || parse.is_sym_at(p, 2, \"[\")) {\n    // `mock MemFiles = { files: ... }`: a test double declared as a type\n    parse.advance(mut p)\n    t := parse.type_decl(mut p)!\n    if !(t.body is ast.RecordBody) {\n      n := t.name\n      return parse.fail(\n        p,\n        f\"a mock holds the data of a fake: `mock {n} = {{ fields }}` (`{{}}` for none)\",\n      )\n    }\n    return Ok(ast.TypeDef(ast.TypeDecl { ..t, mocked: true }))\n  }\n  if parse.eat_kw(mut p, \"type\") {\n    return Ok(ast.TypeDef(parse.type_decl(mut p)!))\n  }\n  if parse.is_kw(p, \"comptime\") && parse.is_kw_at(p, 1, \"fn\") {\n    parse.advance(mut p)\n    parse.advance(mut p)\n    f := parse.fn_decl(mut p)!\n    return Ok(ast.FnDef(ast.FnDecl { ..f, compile_time: true }))\n  }\n  if parse.is_kw(p, \"extern\")\n    && parse.is_ident_at(p, 1)\n    && parse.peek_at(p, 2) is lex.StrTok {\n    // `extern python \"text_utils\" fn slugify(title: String) -> Result[String,\n    // PythonError]`: a function of that Python module\n    parse.advance(mut p)\n    lang_name := parse.ident(mut p)!\n    if lang_name != \"python\" {\n      return parse.fail(\n        p,\n        f\"`extern {lang_name}` names no module: only `extern python \\\"module\\\" fn ...` does\",\n      )\n    }\n    module := match parse.next(mut p) {\n      lex.StrTok(s) => s,\n      _ => \"\",\n    }\n    if module == \"\" {\n      return parse.fail(\n        p,\n        \"`extern python` needs the Python module the function is in: `extern python \\\"text_utils\\\" fn ...`\",\n      )\n    }\n    if !parse.eat_kw(mut p, \"fn\") {\n      return parse.fail(\n        p,\n        f\"`extern python \\\"{module}\\\"` declares functions only: `extern python \\\"{module}\\\" fn name(...) -> Result[T, PythonError]`\",\n      )\n    }\n    (f, has_body) := parse.fn_rest(mut p, true)!\n    if has_body {\n      n := f.name\n      return parse.fail(\n        p,\n        f\"`extern python fn {n}` has no body: it is defined in Python (module `{module}`)\",\n      )\n    }\n    return Ok(ast.ExternDef(ast.ExternDecl {\n      lang: ast.Python(module),\n      item: ast.ExternFn(f),\n    }))\n  }\n  if parse.is_kw(p, \"extern\")\n    && parse.is_ident_at(p, 1)\n    && (parse.is_kw_at(p, 2, \"fn\") || parse.is_kw_at(p, 2, \"type\")) {\n    parse.advance(mut p)\n    lang_name := parse.ident(mut p)!\n    if lang_name == \"python\" {\n      return parse.fail(\n        p,\n        \"`extern python` needs the Python module the function is in: `extern python \\\"text_utils\\\" fn ...`\",\n      )\n    }\n    if lang_name != \"c\" {\n      return parse.fail(\n        p,\n        f\"unknown foreign language `{lang_name}` (`extern c`, `extern python \\\"module\\\"`)\",\n      )\n    }\n    if parse.eat_kw(mut p, \"fn\") {\n      (f, has_body) := parse.fn_rest(mut p, true)!\n      if has_body {\n        n := f.name\n        upper := to_upper(lang_name)\n        return parse.fail(\n          p,\n          f\"`extern {lang_name} fn {n}` has no body: it is defined in {upper}\",\n        )\n      }\n      return Ok(ast.ExternDef(\n        ast.ExternDecl { lang: ast.C, item: ast.ExternFn(f) },\n      ))\n    }\n    parse.expect_kw(mut p, \"type\")!\n    name := parse.ident(mut p)!\n    if parse.is_sym(p, \"[\") || parse.is_sym(p, \"=\") {\n      return parse.fail(\n        p,\n        f\"`extern {lang_name} type {name}` is an opaque handle: no type parameters, no definition\",\n      )\n    }\n    return Ok(ast.ExternDef(\n      ast.ExternDecl { lang: ast.C, item: ast.ExternType(name, []) },\n    ))\n  }\n  if parse.is_kw(p, \"builtin\")\n    && parse.is_kw_at(p, 1, \"thread\")\n    && parse.is_kw_at(p, 2, \"static\") {\n    // `builtin thread static calls: 65552`: a block of bytes per thread\n    parse.advance(mut p)\n    parse.advance(mut p)\n    parse.advance(mut p)\n    name := parse.ident(mut p)!\n    parse.expect_sym(mut p, \":\")!\n    match parse.peek(p) {\n      lex.IntTok(n) => if n > 0 {\n        parse.advance(mut p)\n        return Ok(ast.ExternDef(ast.ExternDecl {\n          lang: ast.Builtin,\n          item: ast.ExternThreadStatic(name, n),\n        }))\n      },\n      _ => (),\n    }\n    return parse.fail(\n      p,\n      f\"`builtin thread static {name}` needs its size in bytes: `builtin thread static {name}: 64`\",\n    )\n  }\n  if parse.is_kw(p, \"builtin\") && parse.is_kw_at(p, 1, \"static\") {\n    // `builtin static allocator: 512`: a block of bytes, its name its address\n    parse.advance(mut p)\n    parse.advance(mut p)\n    name := parse.ident(mut p)!\n    parse.expect_sym(mut p, \":\")!\n    match parse.peek(p) {\n      lex.IntTok(n) => if n > 0 {\n        parse.advance(mut p)\n        return Ok(ast.ExternDef(ast.ExternDecl {\n          lang: ast.Builtin,\n          item: ast.ExternStatic(name, n),\n        }))\n      },\n      _ => (),\n    }\n    return parse.fail(\n      p,\n      f\"`builtin static {name}` needs its size in bytes: `builtin static {name}: 64`\",\n    )\n  }\n  if parse.is_kw(p, \"builtin\")\n    && (parse.is_kw_at(p, 1, \"fn\") || parse.is_kw_at(p, 1, \"type\")) {\n    // `builtin fn len[A](xs: List[A]) -> Int`, `builtin type List[T]`: provided\n    // by the compiler, declared in `core`. `builtin` is contextual.\n    parse.advance(mut p)\n    if parse.eat_kw(mut p, \"fn\") {\n      (f, has_body) := parse.fn_rest(mut p, true)!\n      if has_body {\n        n := f.name\n        return parse.fail(\n          p,\n          f\"`builtin fn {n}` has no body: the compiler provides it\",\n        )\n      }\n      return Ok(ast.ExternDef(\n        ast.ExternDecl { lang: ast.Builtin, item: ast.ExternFn(f) },\n      ))\n    }\n    parse.expect_kw(mut p, \"type\")!\n    name := parse.ident(mut p)!\n    ps := parse.type_params(mut p)!\n    if parse.is_sym(p, \"=\") {\n      return parse.fail(\n        p,\n        f\"`builtin type {name}` has no definition: the compiler provides it\",\n      )\n    }\n    return Ok(ast.ExternDef(ast.ExternDecl {\n      lang: ast.Builtin,\n      item: ast.ExternType(name, ps),\n    }))\n  }\n  if parse.is_kw(p, \"derivable\") && parse.is_sym_at(p, 1, \"(\") {\n    // `derivable(Record) trait ...`: contextual, like `distinct`\n    parse.advance(mut p)\n    parse.advance(mut p)\n    kind := parse.type_expr(mut p)!\n    parse.expect_sym(mut p, \")\")!\n    parse.expect_kw(mut p, \"trait\")!\n    return Ok(ast.TraitDef(parse.trait_decl(mut p, Some(kind))!))\n  }\n  if parse.is_kw(p, \"derive\")\n    && parse.is_ident_at(p, 1)\n    && !parse.is_keyword(parse.ident_text(p, 1)) {\n    // `derive Trait for Type`, with `{ ... }` for methods written by hand\n    parse.advance(mut p)\n    match parse.derive_fn(mut p)! {\n      Some(x) => return Ok(ast.DeriveFnDef(x)),\n      None => (),\n    }\n    return Ok(ast.ImplDef(parse.impl_rest(mut p, true)!))\n  }\n  if parse.is_kw(p, \"effect\") {\n    return parse.fail(\n      p,\n      \"`effect` was removed: declare a `trait` and pass a value that implements it\",\n    )\n  }\n  if parse.eat_kw(mut p, \"fn\") {\n    return Ok(ast.FnDef(parse.fn_decl(mut p)!))\n  }\n  if parse.is_kw(p, \"lemma\")\n    && parse.is_ident_at(p, 1)\n    && !parse.is_keyword(parse.ident_text(p, 1)) {\n    // `lemma name(params) requires … ensures … { steps }`: a fact `verify`\n    // proves once, for proofs to use. `lemma` is contextual. With no body,\n    // the solver proves it from its `requires` alone.\n    parse.advance(mut p)\n    (f, _) := parse.fn_rest(mut p, true)!\n    return Ok(ast.FnDef(ast.FnDecl { ..f, lemma: true }))\n  }\n  if parse.is_kw(p, \"shared\") && parse.is_kw_at(p, 1, \"trait\") {\n    // `shared trait Queue { ... }`: many workers use one value at once\n    parse.advance(mut p)\n    parse.advance(mut p)\n    t := parse.trait_decl(mut p, None)!\n    return Ok(ast.TraitDef(ast.TraitDecl { ..t, shared: true }))\n  }\n  if parse.is_kw(p, \"capability\") && parse.is_kw_at(p, 1, \"trait\") {\n    // `capability trait Database { ... }`: an interface to the outside world\n    parse.advance(mut p)\n    parse.advance(mut p)\n    t := parse.trait_decl(mut p, None)!\n    return Ok(ast.TraitDef(ast.TraitDecl { ..t, capability: true }))\n  }\n  if parse.is_kw(p, \"capability\")\n    && parse.is_ident_at(p, 1)\n    && parse.is_sym_at(p, 2, \"{\") {\n    // `capability Sqlite { fn open(...) ... }`: functions only the runtime gives\n    parse.advance(mut p)\n    return Ok(ast.CapabilityDef(parse.capability_decl(mut p)!))\n  }\n  if parse.eat_kw(mut p, \"trait\") {\n    return Ok(ast.TraitDef(parse.trait_decl(mut p, None)!))\n  }\n  if parse.eat_kw(mut p, \"impl\") {\n    return Ok(ast.ImplDef(parse.impl_rest(mut p, false)!))\n  }\n  if parse.eat_kw(mut p, \"test\") {\n    name := match parse.next(mut p) {\n      lex.StrTok(s) => s,\n      _ => return parse.fail(p, \"expected test name string\"),\n    }\n    // the capabilities it asks for, as `main` does\n    params := if parse.is_sym(p, \"(\") {\n      parse.params(mut p)!\n    } else {\n      []\n    }\n    return Ok(ast.TestDef(\n      ast.TestDecl { name, params, body: parse.block(mut p)! },\n    ))\n  }\n  parse.fail(\n    p,\n    \"expected `type`, `effect`, `trait`, `impl`, `fn` or `test`\",\n  )\n}","old_text":"fn decl_kind(mut p: parse.Parser) -> Result[ast.DeclKind, String] {\n  // `distinct` is only a keyword at the start of a declaration\n  if parse.is_kw(p, \"distinct\") && parse.is_kw_at(p, 1, \"type\") {\n    parse.advance(mut p)\n    parse.expect_kw(mut p, \"type\")!\n    t := parse.type_decl(mut p)!\n    // a union of bare names may be a union of types defined elsewhere; storing decides\n    if t.body is ast.RecordBody {\n      return parse.fail(\n        p,\n        \"only an alias can be `distinct` (records and sum types already are)\",\n      )\n    }\n    return Ok(ast.TypeDef(ast.TypeDecl { ..t, distinct: true }))\n  }\n  if parse.is_kw(p, \"mock\")\n    && parse.is_ident_at(p, 1)\n    && (parse.is_sym_at(p, 2, \"=\") || parse.is_sym_at(p, 2, \"[\")) {\n    // `mock MemFiles = { files: ... }`: a test double declared as a type\n    parse.advance(mut p)\n    t := parse.type_decl(mut p)!\n    if !(t.body is ast.RecordBody) {\n      n := t.name\n      return parse.fail(\n        p,\n        f\"a mock holds the data of a fake: `mock {n} = {{ fields }}` (`{{}}` for none)\",\n      )\n    }\n    return Ok(ast.TypeDef(ast.TypeDecl { ..t, mocked: true }))\n  }\n  if parse.eat_kw(mut p, \"type\") {\n    return Ok(ast.TypeDef(parse.type_decl(mut p)!))\n  }\n  if parse.is_kw(p, \"comptime\") && parse.is_kw_at(p, 1, \"fn\") {\n    parse.advance(mut p)\n    parse.advance(mut p)\n    f := parse.fn_decl(mut p)!\n    return Ok(ast.FnDef(ast.FnDecl { ..f, compile_time: true }))\n  }\n  if parse.is_kw(p, \"extern\")\n    && parse.is_ident_at(p, 1)\n    && parse.peek_at(p, 2) is lex.StrTok {\n    // `extern python \"text_utils\" fn slugify(title: String) -> Result[String,\n    // PythonError]`: a function of that Python module\n    parse.advance(mut p)\n    lang_name := parse.ident(mut p)!\n    if lang_name != \"python\" {\n      return parse.fail(\n        p,\n        f\"`extern {lang_name}` names no module: only `extern python \\\"module\\\" fn ...` does\",\n      )\n    }\n    module := match parse.next(mut p) {\n      lex.StrTok(s) => s,\n      _ => \"\",\n    }\n    if module == \"\" {\n      return parse.fail(\n        p,\n        \"`extern python` needs the Python module the function is in: `extern python \\\"text_utils\\\" fn ...`\",\n      )\n    }\n    if !parse.eat_kw(mut p, \"fn\") {\n      return parse.fail(\n        p,\n        f\"`extern python \\\"{module}\\\"` declares functions only: `extern python \\\"{module}\\\" fn name(...) -> Result[T, PythonError]`\",\n      )\n    }\n    (f, has_body) := parse.fn_rest(mut p, true)!\n    if has_body {\n      n := f.name\n      return parse.fail(\n        p,\n        f\"`extern python fn {n}` has no body: it is defined in Python (module `{module}`)\",\n      )\n    }\n    return Ok(ast.ExternDef(ast.ExternDecl {\n      lang: ast.Python(module),\n      item: ast.ExternFn(f),\n    }))\n  }\n  if parse.is_kw(p, \"extern\")\n    && parse.is_ident_at(p, 1)\n    && (parse.is_kw_at(p, 2, \"fn\") || parse.is_kw_at(p, 2, \"type\")) {\n    parse.advance(mut p)\n    lang_name := parse.ident(mut p)!\n    if lang_name == \"python\" {\n      return parse.fail(\n        p,\n        \"`extern python` needs the Python module the function is in: `extern python \\\"text_utils\\\" fn ...`\",\n      )\n    }\n    if lang_name != \"c\" {\n      return parse.fail(\n        p,\n        f\"unknown foreign language `{lang_name}` (`extern c`, `extern python \\\"module\\\"`)\",\n      )\n    }\n    if parse.eat_kw(mut p, \"fn\") {\n      (f, has_body) := parse.fn_rest(mut p, true)!\n      if has_body {\n        n := f.name\n        upper := to_upper(lang_name)\n        return parse.fail(\n          p,\n          f\"`extern {lang_name} fn {n}` has no body: it is defined in {upper}\",\n        )\n      }\n      return Ok(ast.ExternDef(\n        ast.ExternDecl { lang: ast.C, item: ast.ExternFn(f) },\n      ))\n    }\n    parse.expect_kw(mut p, \"type\")!\n    name := parse.ident(mut p)!\n    if parse.is_sym(p, \"[\") || parse.is_sym(p, \"=\") {\n      return parse.fail(\n        p,\n        f\"`extern {lang_name} type {name}` is an opaque handle: no type parameters, no definition\",\n      )\n    }\n    return Ok(ast.ExternDef(\n      ast.ExternDecl { lang: ast.C, item: ast.ExternType(name, []) },\n    ))\n  }\n  if parse.is_kw(p, \"builtin\")\n    && parse.is_kw_at(p, 1, \"thread\")\n    && parse.is_kw_at(p, 2, \"static\") {\n    // `builtin thread static calls: 65552`: a block of bytes per thread\n    parse.advance(mut p)\n    parse.advance(mut p)\n    parse.advance(mut p)\n    name := parse.ident(mut p)!\n    parse.expect_sym(mut p, \":\")!\n    match parse.peek(p) {\n      lex.IntTok(n) => if n > 0 {\n        parse.advance(mut p)\n        return Ok(ast.ExternDef(ast.ExternDecl {\n          lang: ast.Builtin,\n          item: ast.ExternThreadStatic(name, n),\n        }))\n      },\n      _ => (),\n    }\n    return parse.fail(\n      p,\n      f\"`builtin thread static {name}` needs its size in bytes: `builtin thread static {name}: 64`\",\n    )\n  }\n  if parse.is_kw(p, \"builtin\") && parse.is_kw_at(p, 1, \"static\") {\n    // `builtin static allocator: 512`: a block of bytes, its name its address\n    parse.advance(mut p)\n    parse.advance(mut p)\n    name := parse.ident(mut p)!\n    parse.expect_sym(mut p, \":\")!\n    match parse.peek(p) {\n      lex.IntTok(n) => if n > 0 {\n        parse.advance(mut p)\n        return Ok(ast.ExternDef(ast.ExternDecl {\n          lang: ast.Builtin,\n          item: ast.ExternStatic(name, n),\n        }))\n      },\n      _ => (),\n    }\n    return parse.fail(\n      p,\n      f\"`builtin static {name}` needs its size in bytes: `builtin static {name}: 64`\",\n    )\n  }\n  if parse.is_kw(p, \"builtin\")\n    && (parse.is_kw_at(p, 1, \"fn\") || parse.is_kw_at(p, 1, \"type\")) {\n    // `builtin fn len[A](xs: List[A]) -> Int`, `builtin type List[T]`: provided\n    // by the compiler, declared in `core`. `builtin` is contextual.\n    parse.advance(mut p)\n    if parse.eat_kw(mut p, \"fn\") {\n      (f, has_body) := parse.fn_rest(mut p, true)!\n      if has_body {\n        n := f.name\n        return parse.fail(\n          p,\n          f\"`builtin fn {n}` has no body: the compiler provides it\",\n        )\n      }\n      return Ok(ast.ExternDef(\n        ast.ExternDecl { lang: ast.Builtin, item: ast.ExternFn(f) },\n      ))\n    }\n    parse.expect_kw(mut p, \"type\")!\n    name := parse.ident(mut p)!\n    ps := parse.type_params(mut p)!\n    if parse.is_sym(p, \"=\") {\n      return parse.fail(\n        p,\n        f\"`builtin type {name}` has no definition: the compiler provides it\",\n      )\n    }\n    return Ok(ast.ExternDef(ast.ExternDecl {\n      lang: ast.Builtin,\n      item: ast.ExternType(name, ps),\n    }))\n  }\n  if parse.is_kw(p, \"derivable\") && parse.is_sym_at(p, 1, \"(\") {\n    // `derivable(Record) trait ...`: contextual, like `distinct`\n    parse.advance(mut p)\n    parse.advance(mut p)\n    kind := parse.type_expr(mut p)!\n    parse.expect_sym(mut p, \")\")!\n    parse.expect_kw(mut p, \"trait\")!\n    return Ok(ast.TraitDef(parse.trait_decl(mut p, Some(kind))!))\n  }\n  if parse.is_kw(p, \"derive\")\n    && parse.is_ident_at(p, 1)\n    && !parse.is_keyword(parse.ident_text(p, 1)) {\n    // `derive Trait for Type`, with `{ ... }` for methods written by hand\n    parse.advance(mut p)\n    match parse.derive_fn(mut p)! {\n      Some(x) => return Ok(ast.DeriveFnDef(x)),\n      None => (),\n    }\n    return Ok(ast.ImplDef(parse.impl_rest(mut p, true)!))\n  }\n  if parse.is_kw(p, \"effect\") {\n    return parse.fail(\n      p,\n      \"`effect` was removed: declare a `trait` and pass a value that implements it\",\n    )\n  }\n  if parse.eat_kw(mut p, \"fn\") {\n    return Ok(ast.FnDef(parse.fn_decl(mut p)!))\n  }\n  if parse.is_kw(p, \"shared\") && parse.is_kw_at(p, 1, \"trait\") {\n    // `shared trait Queue { ... }`: many workers use one value at once\n    parse.advance(mut p)\n    parse.advance(mut p)\n    t := parse.trait_decl(mut p, None)!\n    return Ok(ast.TraitDef(ast.TraitDecl { ..t, shared: true }))\n  }\n  if parse.is_kw(p, \"capability\") && parse.is_kw_at(p, 1, \"trait\") {\n    // `capability trait Database { ... }`: an interface to the outside world\n    parse.advance(mut p)\n    parse.advance(mut p)\n    t := parse.trait_decl(mut p, None)!\n    return Ok(ast.TraitDef(ast.TraitDecl { ..t, capability: true }))\n  }\n  if parse.is_kw(p, \"capability\")\n    && parse.is_ident_at(p, 1)\n    && parse.is_sym_at(p, 2, \"{\") {\n    // `capability Sqlite { fn open(...) ... }`: functions only the runtime gives\n    parse.advance(mut p)\n    return Ok(ast.CapabilityDef(parse.capability_decl(mut p)!))\n  }\n  if parse.eat_kw(mut p, \"trait\") {\n    return Ok(ast.TraitDef(parse.trait_decl(mut p, None)!))\n  }\n  if parse.eat_kw(mut p, \"impl\") {\n    return Ok(ast.ImplDef(parse.impl_rest(mut p, false)!))\n  }\n  if parse.eat_kw(mut p, \"test\") {\n    name := match parse.next(mut p) {\n      lex.StrTok(s) => s,\n      _ => return parse.fail(p, \"expected test name string\"),\n    }\n    // the capabilities it asks for, as `main` does\n    params := if parse.is_sym(p, \"(\") {\n      parse.params(mut p)!\n    } else {\n      []\n    }\n    return Ok(ast.TestDef(\n      ast.TestDecl { name, params, body: parse.block(mut p)! },\n    ))\n  }\n  parse.fail(\n    p,\n    \"expected `type`, `effect`, `trait`, `impl`, `fn` or `test`\",\n  )\n}"},{"name":"parse.statement","kind":"fn","old":"2e76222f491afd82","new":"6eb7028e32dbc0f8","interface_changed":false,"affected":[],"module":"parse","text":"fn statement(mut p: parse.Parser) -> Result[ast.Stmt, String] {\n  if parse.eat_kw(mut p, \"let\") {\n    // `let` only introduces a typed binding: `let p: T = e`\n    pat := parse.pattern(mut p)!\n    if parse.is_sym(p, \"=\") || parse.is_sym(p, \":=\") {\n      return parse.fail(\n        p,\n        \"`let` needs a type (`let x: T = e`); without one, write `x := e`\",\n      )\n    }\n    parse.expect_sym(mut p, \":\")!\n    ty := parse.type_expr(mut p)!\n    parse.expect_sym(mut p, \"=\")!\n    return Ok(ast.Let { pat, ty: Some(ty), value: parse.expr(mut p)! })\n  }\n  if parse.is_kw(p, \"mut\")\n    && parse.is_ident_at(p, 1)\n    && (parse.is_sym_at(p, 2, \":=\")\n      || parse.is_sym_at(p, 2, \":\")\n      || parse.is_sym_at(p, 2, \"=\")) {\n    // `mut x := e`, `mut x: T = e`\n    parse.advance(mut p)\n    name := parse.ident(mut p)!\n    if parse.eat_sym(mut p, \":=\") {\n      return Ok(ast.VarDecl { name, ty: None, value: parse.expr(mut p)! })\n    }\n    if parse.eat_sym(mut p, \":\") {\n      ty := parse.type_expr(mut p)!\n      parse.expect_sym(mut p, \"=\")!\n      return Ok(\n        ast.VarDecl {\n          name,\n          ty: Some(ty),\n          value: parse.expr(mut p)!,\n        },\n      )\n    }\n    return parse.fail(\n      p,\n      \"a new variable is `mut x := e` or `mut x: T = e`\",\n    )\n  }\n  match parse.binding_pattern(mut p) {\n    // `p := e`\n    Some(pat) => return Ok(ast.Let { pat, ty: None, value: parse.expr(mut p)! }),\n    None => (),\n  }\n  if parse.eat_kw(mut p, \"assert\") {\n    cond := parse.expr(mut p)!\n    // `assert e by lemma(args)`, `assert e by { steps }`: `by` is\n    // contextual\n    if parse.is_kw(p, \"by\") {\n      parse.advance(mut p)\n      proof := if parse.is_sym(p, \"{\") {\n        parse.block(mut p)!\n      } else {\n        parse.expr(mut p)!\n      }\n      return Ok(ast.AssertBy { cond, proof })\n    }\n    return Ok(ast.Assert(cond))\n  }\n  if parse.is_kw(p, \"calc\") && parse.is_sym_at(p, 1, \"{\") {\n    // `calc { a == b; _ <= c }`: each step proven alone, `_` the step\n    // before's right side. `calc` is contextual.\n    parse.advance(mut p)\n    parse.advance(mut p)\n    mut steps := []\n    while !parse.is_sym(p, \"}\") {\n      mut steps.push(parse.expr(mut p)!)\n      _ := parse.eat_sym(mut p, \";\")\n    }\n    parse.expect_sym(mut p, \"}\")!\n    if steps == [] {\n      return parse.fail(\n        p,\n        \"a `calc` needs its steps: `calc { a == b; _ <= c }`\",\n      )\n    }\n    return Ok(ast.Calc(steps))\n  }\n  if parse.eat_kw(mut p, \"loop\") {\n    return Ok(ast.Loop(parse.loop_body(mut p)!))\n  }\n  if parse.eat_kw(mut p, \"break\") {\n    return Ok(ast.Break)\n  }\n  if parse.eat_kw(mut p, \"continue\") {\n    return Ok(ast.Continue)\n  }\n  if parse.eat_kw(mut p, \"while\") {\n    cond := parse.expr_ns(mut p)!\n    return Ok(ast.While { cond, body: parse.loop_body(mut p)! })\n  }\n  if parse.is_kw(p, \"comptime\") && parse.is_kw_at(p, 1, \"for\") {\n    // `comptime for v in xs { ... }`: written out once per element while compiling\n    parse.advance(mut p)\n    parse.advance(mut p)\n    pat := parse.pattern(mut p)!\n    parse.expect_kw(mut p, \"in\")!\n    iter := parse.expr_ns(mut p)!\n    return Ok(ast.ComptimeFor { pat, iter, body: parse.block(mut p)! })\n  }\n  if parse.eat_kw(mut p, \"for\") {\n    pat := parse.pattern(mut p)!\n    parse.expect_kw(mut p, \"in\")!\n    iter := parse.expr_ns(mut p)!\n    return Ok(ast.For { pat, iter, body: parse.loop_body(mut p)! })\n  }\n  e := parse.expr(mut p)!\n  op := match parse.peek(p) {\n    lex.Sym(\"=\") => Some(None),\n    lex.Sym(\"+=\") => Some(Some(ast.Add)),\n    lex.Sym(\"-=\") => Some(Some(ast.Sub)),\n    lex.Sym(\"*=\") => Some(Some(ast.Mul)),\n    lex.Sym(\"/=\") => Some(Some(ast.Div)),\n    lex.Sym(\"%=\") => Some(Some(ast.Mod)),\n    lex.Sym(\":=\") => return parse.fail(\n      p,\n      \"`:=` declares a new name: `x := e`, `(a, b) := e`\",\n    ),\n    _ => None,\n  }\n  match op {\n    Some(o) => {\n      if !parse.assignable(e) {\n        return parse.fail(\n          p,\n          \"only a variable, a field or an element (`x`, `x.f`, `xs[i]`) can be assigned\",\n        )\n      }\n      parse.advance(mut p)\n      rhs := parse.expr(mut p)!\n      // `x += e` is `x = x + e`\n      value := match o {\n        Some(b) => ast.Binary { op: b, left: e, right: rhs },\n        None => rhs,\n      }\n      Ok(ast.Assign { place: e, value })\n    },\n    None => Ok(ast.ExprStmt(e)),\n  }\n}","old_text":"fn statement(mut p: parse.Parser) -> Result[ast.Stmt, String] {\n  if parse.eat_kw(mut p, \"let\") {\n    // `let` only introduces a typed binding: `let p: T = e`\n    pat := parse.pattern(mut p)!\n    if parse.is_sym(p, \"=\") || parse.is_sym(p, \":=\") {\n      return parse.fail(\n        p,\n        \"`let` needs a type (`let x: T = e`); without one, write `x := e`\",\n      )\n    }\n    parse.expect_sym(mut p, \":\")!\n    ty := parse.type_expr(mut p)!\n    parse.expect_sym(mut p, \"=\")!\n    return Ok(ast.Let { pat, ty: Some(ty), value: parse.expr(mut p)! })\n  }\n  if parse.is_kw(p, \"mut\")\n    && parse.is_ident_at(p, 1)\n    && (parse.is_sym_at(p, 2, \":=\")\n      || parse.is_sym_at(p, 2, \":\")\n      || parse.is_sym_at(p, 2, \"=\")) {\n    // `mut x := e`, `mut x: T = e`\n    parse.advance(mut p)\n    name := parse.ident(mut p)!\n    if parse.eat_sym(mut p, \":=\") {\n      return Ok(ast.VarDecl { name, ty: None, value: parse.expr(mut p)! })\n    }\n    if parse.eat_sym(mut p, \":\") {\n      ty := parse.type_expr(mut p)!\n      parse.expect_sym(mut p, \"=\")!\n      return Ok(\n        ast.VarDecl {\n          name,\n          ty: Some(ty),\n          value: parse.expr(mut p)!,\n        },\n      )\n    }\n    return parse.fail(\n      p,\n      \"a new variable is `mut x := e` or `mut x: T = e`\",\n    )\n  }\n  match parse.binding_pattern(mut p) {\n    // `p := e`\n    Some(pat) => return Ok(ast.Let { pat, ty: None, value: parse.expr(mut p)! }),\n    None => (),\n  }\n  if parse.eat_kw(mut p, \"assert\") {\n    return Ok(ast.Assert(parse.expr(mut p)!))\n  }\n  if parse.eat_kw(mut p, \"loop\") {\n    return Ok(ast.Loop(parse.loop_body(mut p)!))\n  }\n  if parse.eat_kw(mut p, \"break\") {\n    return Ok(ast.Break)\n  }\n  if parse.eat_kw(mut p, \"continue\") {\n    return Ok(ast.Continue)\n  }\n  if parse.eat_kw(mut p, \"while\") {\n    cond := parse.expr_ns(mut p)!\n    return Ok(ast.While { cond, body: parse.loop_body(mut p)! })\n  }\n  if parse.is_kw(p, \"comptime\") && parse.is_kw_at(p, 1, \"for\") {\n    // `comptime for v in xs { ... }`: written out once per element while compiling\n    parse.advance(mut p)\n    parse.advance(mut p)\n    pat := parse.pattern(mut p)!\n    parse.expect_kw(mut p, \"in\")!\n    iter := parse.expr_ns(mut p)!\n    return Ok(ast.ComptimeFor { pat, iter, body: parse.block(mut p)! })\n  }\n  if parse.eat_kw(mut p, \"for\") {\n    pat := parse.pattern(mut p)!\n    parse.expect_kw(mut p, \"in\")!\n    iter := parse.expr_ns(mut p)!\n    return Ok(ast.For { pat, iter, body: parse.loop_body(mut p)! })\n  }\n  e := parse.expr(mut p)!\n  op := match parse.peek(p) {\n    lex.Sym(\"=\") => Some(None),\n    lex.Sym(\"+=\") => Some(Some(ast.Add)),\n    lex.Sym(\"-=\") => Some(Some(ast.Sub)),\n    lex.Sym(\"*=\") => Some(Some(ast.Mul)),\n    lex.Sym(\"/=\") => Some(Some(ast.Div)),\n    lex.Sym(\"%=\") => Some(Some(ast.Mod)),\n    lex.Sym(\":=\") => return parse.fail(\n      p,\n      \"`:=` declares a new name: `x := e`, `(a, b) := e`\",\n    ),\n    _ => None,\n  }\n  match op {\n    Some(o) => {\n      if !parse.assignable(e) {\n        return parse.fail(\n          p,\n          \"only a variable, a field or an element (`x`, `x.f`, `xs[i]`) can be assigned\",\n        )\n      }\n      parse.advance(mut p)\n      rhs := parse.expr(mut p)!\n      // `x += e` is `x = x + e`\n      value := match o {\n        Some(b) => ast.Binary { op: b, left: e, right: rhs },\n        None => rhs,\n      }\n      Ok(ast.Assign { place: e, value })\n    },\n    None => Ok(ast.ExprStmt(e)),\n  }\n}"}]}
{"id":"587cca50091af227","time":1795664693,"message":"edit","changes":[{"name":"text.use ast","kind":"use","old":"1b6bdd87608f3465","new":"3dffea95c4172931","interface_changed":true,"affected":[],"module":"text","text":"// text: the printer, from a tree to code. Expressions break across lines to\n// stay within 80 columns. It prints a tree as given; `strata render` first\n// turns a stored tree into its written form (see `resolve.written`).\n\nfrom ast use DeriveFnDef, Decl, TypeDecl, Field, FnDecl, Param, Bound,\n  TraitDecl, ImplDecl, CapabilityDecl, TypeExpr, Expr, LamParam, FmtSpec, BinOp,\n  Stmt, Pattern, TypeDef, FnDef, TestDef, TraitDef, ImplDef, UseDef, ExternDef,\n  CapabilityDef, Alias, RecordBody, SumBody, NoPayload, Positional,\n  RecordPayload, MemberType, C, Builtin, Python, ExternFn, ExternType,\n  ExternStatic, ExternThreadStatic, Named, FnType, UnitType, Refined, UnionType,\n  IntLit, BigIntLit, FloatLit, TupleExpr, StrLit, BoolLit, UnitExpr, Var, Hole,\n  ListExpr, CtorExpr, Call, MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr,\n  IfExpr, MatchExpr, MutExpr, Block, MockExpr, Return, Try, Except, Interp,\n  Range, Index, Comp, DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn,\n  Await, Select, Race, SupervisedSpawn, Old, Assumed, Spread, NoArgs,\n  PositionalArgs, RecordArgs, UpdateArgs, ListComp, SetComp, DictComp, TextPart,\n  ValuePart, Add, Sub, Mul, Div, Mod, Equal, NotEqual, Less, LessEq, Greater,\n  GreaterEq, And, Or, Implies, BitAnd, BitOr, BitXor, Shl, Shr, Neg, Not,\n  TryResult, TryOption, Let, VarDecl, Assign, While, For, Loop, Break, Continue,\n  ExprStmt, Assert, Comment, ComptimeFor, Invariant, Decreases, Wild, Bind,\n  IntPat, StrPat, BoolPat, CtorPattern, ListPat, TuplePat, CondPat, OrPat,\n  ForPat, NoPats, PositionalPats, RecordPats, TypePats, unassumed, DeriveClause,\n  AssertBy, Calc","old_text":"// text: the printer, from a tree to code. Expressions break across lines to\n// stay within 80 columns. It prints a tree as given; `strata render` first\n// turns a stored tree into its written form (see `resolve.written`).\n\nfrom ast use DeriveFnDef, Decl, TypeDecl, Field, FnDecl, Param, Bound,\n  TraitDecl, ImplDecl, CapabilityDecl, TypeExpr, Expr, LamParam, FmtSpec, BinOp,\n  Stmt, Pattern, TypeDef, FnDef, TestDef, TraitDef, ImplDef, UseDef, ExternDef,\n  CapabilityDef, Alias, RecordBody, SumBody, NoPayload, Positional,\n  RecordPayload, MemberType, C, Builtin, Python, ExternFn, ExternType,\n  ExternStatic, ExternThreadStatic, Named, FnType, UnitType, Refined, UnionType,\n  IntLit, BigIntLit, FloatLit, TupleExpr, StrLit, BoolLit, UnitExpr, Var, Hole,\n  ListExpr, CtorExpr, Call, MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr,\n  IfExpr, MatchExpr, MutExpr, Block, MockExpr, Return, Try, Except, Interp,\n  Range, Index, Comp, DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn,\n  Await, Select, Race, SupervisedSpawn, Old, Assumed, Spread, NoArgs,\n  PositionalArgs, RecordArgs, UpdateArgs, ListComp, SetComp, DictComp, TextPart,\n  ValuePart, Add, Sub, Mul, Div, Mod, Equal, NotEqual, Less, LessEq, Greater,\n  GreaterEq, And, Or, Implies, BitAnd, BitOr, BitXor, Shl, Shr, Neg, Not,\n  TryResult, TryOption, Let, VarDecl, Assign, While, For, Loop, Break, Continue,\n  ExprStmt, Assert, Comment, ComptimeFor, Invariant, Decreases, Wild, Bind,\n  IntPat, StrPat, BoolPat, CtorPattern, ListPat, TuplePat, CondPat, OrPat,\n  ForPat, NoPats, PositionalPats, RecordPats, TypePats, unassumed, DeriveClause"},{"name":"text.stmt_text","kind":"fn","old":"297ac255de60627d","new":"893b1cf85e867925","interface_changed":false,"affected":[],"module":"text","text":"fn stmt_text(s: ast.Stmt, d: Int) -> String {\n  match s {\n    ast.Let { pat, ty, value } => match ty {\n      Some(t) => \"let \"\n        + text.pattern_text(pat)\n        + \": \"\n        + text.type_text(t)\n        + \" = \"\n        + text.expr_text(value, d),\n      None => text.pattern_text(pat) + \" := \" + text.expr_text(value, d),\n    },\n    ast.VarDecl { name, ty, value } => match ty {\n      Some(t) => \"mut \"\n        + name\n        + \": \"\n        + text.type_text(t)\n        + \" = \"\n        + text.expr_text(value, d),\n      None => \"mut \" + name + \" := \" + text.expr_text(value, d),\n    },\n    ast.Assign { place, value } => match value {\n      // `x = x + e` is written `x += e`\n      ast.Binary { op, left, right } => if left == place\n        && (op == ast.Add\n          || op == ast.Sub\n          || op == ast.Mul\n          || op == ast.Div\n          || op == ast.Mod) {\n        text.expr_text(place, d)\n          + \" \"\n          + text.symbol(op)\n          + \"= \"\n          + text.expr_text(right, d)\n      } else {\n        text.expr_text(place, d) + \" = \" + text.expr_text(value, d)\n      },\n      _ => text.expr_text(place, d) + \" = \" + text.expr_text(value, d),\n    },\n    ast.While { cond, body } => \"while \"\n      + text.head(cond, d)\n      + text.clauses_text(body, d)\n      + \" \"\n      + text.block_text(text.without_clauses(body), d),\n    ast.Loop(body) => \"loop\"\n      + text.clauses_text(body, d)\n      + \" \"\n      + text.block_text(text.without_clauses(body), d),\n    ast.Break => \"break\",\n    ast.Continue => \"continue\",\n    ast.For { pat, iter, body } => \"for \"\n      + text.pattern_text(pat)\n      + \" in \"\n      + text.head(iter, d)\n      + text.clauses_text(body, d)\n      + \" \"\n      + text.block_text(text.without_clauses(body), d),\n    ast.ComptimeFor { pat, iter, body } => \"comptime for \"\n      + text.pattern_text(pat)\n      + \" in \"\n      + text.head(iter, d)\n      + \" \"\n      + text.block_text(body, d),\n    ast.ExprStmt(x) => text.expr_text(x, d),\n    ast.Assert(x) => \"assert \" + text.expr_text(x, d),\n    // only first in a loop's body, where `clauses_text` takes it\n    ast.Invariant(x) => text.assumed_word(x)\n      + \"invariant \"\n      + text.expr_text(ast.unassumed(x), d),\n    ast.Comment(cs) => join(cs, \"\\n\"),\n    ast.Decreases(x) => \"decreases \" + text.expr_text(x, d),\n    ast.AssertBy { cond, proof } => \"assert \"\n      + text.expr_text(cond, d)\n      + \" by \"\n      + match proof {\n        ast.Block { .. } => text.block_text(proof, d),\n        _ => text.expr_text(proof, d),\n      },\n    ast.Calc(steps) => \"calc {\\n\"\n      + join(\n        steps.map(x -> text.ind(d + 1) + text.expr_text(x, d + 1)),\n        \"\\n\",\n      )\n      + \"\\n\"\n      + text.ind(d)\n      + \"}\",\n  }\n}","old_text":"fn stmt_text(s: ast.Stmt, d: Int) -> String {\n  match s {\n    ast.Let { pat, ty, value } => match ty {\n      Some(t) => \"let \"\n        + text.pattern_text(pat)\n        + \": \"\n        + text.type_text(t)\n        + \" = \"\n        + text.expr_text(value, d),\n      None => text.pattern_text(pat) + \" := \" + text.expr_text(value, d),\n    },\n    ast.VarDecl { name, ty, value } => match ty {\n      Some(t) => \"mut \"\n        + name\n        + \": \"\n        + text.type_text(t)\n        + \" = \"\n        + text.expr_text(value, d),\n      None => \"mut \" + name + \" := \" + text.expr_text(value, d),\n    },\n    ast.Assign { place, value } => match value {\n      // `x = x + e` is written `x += e`\n      ast.Binary { op, left, right } => if left == place\n        && (op == ast.Add\n          || op == ast.Sub\n          || op == ast.Mul\n          || op == ast.Div\n          || op == ast.Mod) {\n        text.expr_text(place, d)\n          + \" \"\n          + text.symbol(op)\n          + \"= \"\n          + text.expr_text(right, d)\n      } else {\n        text.expr_text(place, d) + \" = \" + text.expr_text(value, d)\n      },\n      _ => text.expr_text(place, d) + \" = \" + text.expr_text(value, d),\n    },\n    ast.While { cond, body } => \"while \"\n      + text.head(cond, d)\n      + text.clauses_text(body, d)\n      + \" \"\n      + text.block_text(text.without_clauses(body), d),\n    ast.Loop(body) => \"loop\"\n      + text.clauses_text(body, d)\n      + \" \"\n      + text.block_text(text.without_clauses(body), d),\n    ast.Break => \"break\",\n    ast.Continue => \"continue\",\n    ast.For { pat, iter, body } => \"for \"\n      + text.pattern_text(pat)\n      + \" in \"\n      + text.head(iter, d)\n      + text.clauses_text(body, d)\n      + \" \"\n      + text.block_text(text.without_clauses(body), d),\n    ast.ComptimeFor { pat, iter, body } => \"comptime for \"\n      + text.pattern_text(pat)\n      + \" in \"\n      + text.head(iter, d)\n      + \" \"\n      + text.block_text(body, d),\n    ast.ExprStmt(x) => text.expr_text(x, d),\n    ast.Assert(x) => \"assert \" + text.expr_text(x, d),\n    // only first in a loop's body, where `clauses_text` takes it\n    ast.Invariant(x) => text.assumed_word(x)\n      + \"invariant \"\n      + text.expr_text(ast.unassumed(x), d),\n    ast.Comment(cs) => join(cs, \"\\n\"),\n    _ => match s {\n      ast.Decreases(x) => \"decreases \" + text.expr_text(x, d),\n      _ => \"\",\n    },\n  }\n}"},{"name":"text.fn_signature_text","kind":"fn","old":"9cf51a078d9c32f7","new":"80b6ed5290490119","interface_changed":false,"affected":[],"module":"text","text":"/// A function's name, type parameters, parameters, result and contracts\n/// (`requires`, `ensures`, `decreases`, `terminates`, `noalloc`), each\n/// contract on a line.\npub fn fn_signature_text(fd: ast.FnDecl) -> String {\n  f := text.fn_view(fd)\n  tp := text.bounded(f.type_params, f.bounds)\n  kw := if f.compile_time {\n    \"comptime fn\"\n  } else if f.lemma {\n    \"lemma\"\n  } else if f.derived {\n    \"derived fn\"\n  } else {\n    \"fn\"\n  }\n  // a function returning `()` leaves out `-> ()`\n  ret := match (f.results, f.ret) {\n    ([_, ..], ast.Named { name: \"Tuple\", args }) => \" -> (\"\n      + join(zip(f.results, args).map(\n        x -> x.0 + \": \" + text.type_text(x.1),\n      ), \", \")\n      + \")\",\n    _ => if f.ret == ast.UnitType {\n      \"\"\n    } else {\n      \" -> \" + text.type_text(f.ret)\n    },\n  }\n  mut s := kw\n    + \" \"\n    + f.name\n    + tp\n    + \"(\"\n    + text.param_list(f.params)\n    + \")\"\n    + ret\n  // 2 columns are kept for an enclosing `module { }` block\n  if text.chars_in(s) > text.width() - 2 && len(f.params) > 0 {\n    s = kw\n      + \" \"\n      + f.name\n      + tp\n      + text.broken(\n        \"(\",\n        f.params.map(p -> text.param_text(p)),\n        \")\",\n        0,\n      )\n      + ret\n  }\n  for r in f.pre {\n    s += \"\\n  \"\n      + text.assumed_word(r)\n      + \"requires \"\n      + text.head(ast.unassumed(r), 1)\n  }\n  for e in f.post {\n    s += \"\\n  \"\n      + text.assumed_word(e)\n      + \"ensures \"\n      + text.head(ast.unassumed(e), 1)\n  }\n  for c in text.loop_clauses(f.body) {\n    match c {\n      ast.Decreases(x) => {\n        s += \"\\n  decreases \" + text.head(x, 1)\n      },\n      _ => (),\n    }\n  }\n  if f.terminating {\n    s += \"\\n  terminates\"\n  }\n  if f.no_alloc {\n    s += \"\\n  noalloc\"\n  }\n  s\n}","old_text":"/// A function's name, type parameters, parameters, result and contracts\n/// (`requires`, `ensures`, `decreases`, `terminates`, `noalloc`), each\n/// contract on a line.\npub fn fn_signature_text(fd: ast.FnDecl) -> String {\n  f := text.fn_view(fd)\n  tp := text.bounded(f.type_params, f.bounds)\n  kw := if f.compile_time {\n    \"comptime fn\"\n  } else if f.derived {\n    \"derived fn\"\n  } else {\n    \"fn\"\n  }\n  // a function returning `()` leaves out `-> ()`\n  ret := match (f.results, f.ret) {\n    ([_, ..], ast.Named { name: \"Tuple\", args }) => \" -> (\"\n      + join(zip(f.results, args).map(\n        x -> x.0 + \": \" + text.type_text(x.1),\n      ), \", \")\n      + \")\",\n    _ => if f.ret == ast.UnitType {\n      \"\"\n    } else {\n      \" -> \" + text.type_text(f.ret)\n    },\n  }\n  mut s := kw\n    + \" \"\n    + f.name\n    + tp\n    + \"(\"\n    + text.param_list(f.params)\n    + \")\"\n    + ret\n  // 2 columns are kept for an enclosing `module { }` block\n  if text.chars_in(s) > text.width() - 2 && len(f.params) > 0 {\n    s = kw\n      + \" \"\n      + f.name\n      + tp\n      + text.broken(\n        \"(\",\n        f.params.map(p -> text.param_text(p)),\n        \")\",\n        0,\n      )\n      + ret\n  }\n  for r in f.pre {\n    s += \"\\n  \"\n      + text.assumed_word(r)\n      + \"requires \"\n      + text.head(ast.unassumed(r), 1)\n  }\n  for e in f.post {\n    s += \"\\n  \"\n      + text.assumed_word(e)\n      + \"ensures \"\n      + text.head(ast.unassumed(e), 1)\n  }\n  for c in text.loop_clauses(f.body) {\n    match c {\n      ast.Decreases(x) => {\n        s += \"\\n  decreases \" + text.head(x, 1)\n      },\n      _ => (),\n    }\n  }\n  if f.terminating {\n    s += \"\\n  terminates\"\n  }\n  if f.no_alloc {\n    s += \"\\n  noalloc\"\n  }\n  s\n}"},{"name":"text.fn_decl_text","kind":"fn","old":"55a8671ca939f0ec","new":"a351f05a1b63f274","interface_changed":false,"affected":[],"module":"text","text":"/// A function's signature, then its body without its `decreases` clause,\n/// which the signature shows.\npub fn fn_decl_text(fd: ast.FnDecl) -> String {\n  f := text.fn_view(fd)\n  sig := text.fn_signature_text(f)\n  b := match text.without_clauses(f.body) {\n    ast.Block { stmts, last: ast.Hole(h) } => if stmts == [] && text.loop_clauses(f.body) != [] {\n      ast.Hole(h)\n    } else {\n      text.without_clauses(f.body)\n    },\n    other => other,\n  }\n  match b {\n    ast.Hole(_) => sig + \"\\n  = \" + text.expr_text(b, 0),\n    // a lemma proven from its `requires` alone has no body\n    ast.UnitExpr => if f.lemma {\n      sig\n    } else {\n      sig + \" \" + text.block_text(b, 0)\n    },\n    _ => sig + \" \" + text.block_text(b, 0),\n  }\n}","old_text":"/// A function's signature, then its body without its `decreases` clause,\n/// which the signature shows.\npub fn fn_decl_text(fd: ast.FnDecl) -> String {\n  f := text.fn_view(fd)\n  sig := text.fn_signature_text(f)\n  b := match text.without_clauses(f.body) {\n    ast.Block { stmts, last: ast.Hole(h) } => if stmts == [] && text.loop_clauses(f.body) != [] {\n      ast.Hole(h)\n    } else {\n      text.without_clauses(f.body)\n    },\n    other => other,\n  }\n  match b {\n    ast.Hole(_) => sig + \"\\n  = \" + text.expr_text(b, 0),\n    _ => sig + \" \" + text.block_text(b, 0),\n  }\n}"}]}
{"id":"078ab520b0431f31","time":1795664725,"message":"edit","changes":[{"name":"walk.use ast","kind":"use","old":"f121d43c1a2b3e8a","new":"466b3062f6a4fcbf","interface_changed":true,"affected":[],"module":"walk","text":"// walk: rebuilding a tree one level at a time, for the passes that rewrite\n// it (`desugar`, `derive`). Each function applies `fe` and `ft` to the direct\n// children only, so a pass recurses where it wants: innermost first, or\n// stopping at a node it rewrites whole.\n\nfrom ast use DeriveFnDef, ModelDecl, ModelDef, Decl, DeclKind, TypeDecl, Field,\n  Variant, FnDecl, Param, Bound, TestDecl, TraitDecl, TraitMethod, Law,\n  ImplDecl, ExternDecl, CapabilityDecl, TypeExpr, Expr, LamParam, CompFor, Arm,\n  Stmt, Pattern, SelectArm, StrPart, CtorArgs, CtorPat, TypeDef, FnDef, TestDef,\n  TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, Alias, RecordBody,\n  SumBody, NoPayload, Positional, RecordPayload, MemberType, ExternFn,\n  ExternType, ExternStatic, ExternThreadStatic, Named, FnType, UnitType,\n  Refined, UnionType, TupleExpr, ListExpr, CtorExpr, Call, MethodCall, FieldOf,\n  Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr, MutExpr, Block, MockExpr,\n  Return, Try, Except, Interp, Range, Index, Comp, DictExpr, SetExpr, Fallback,\n  Comptime, Scope, Spawn, Await, Select, Race, SupervisedSpawn, Old, Assumed,\n  Spread, NoArgs, PositionalArgs, RecordArgs, UpdateArgs, TextPart, ValuePart,\n  Let, VarDecl, Assign, While, For, Loop, ExprStmt, Assert, ComptimeFor,\n  Invariant, Decreases, CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat,\n  NoPats, PositionalPats, RecordPats, TypePats, AssertBy, Calc","old_text":"// walk: rebuilding a tree one level at a time, for the passes that rewrite\n// it (`desugar`, `derive`). Each function applies `fe` and `ft` to the direct\n// children only, so a pass recurses where it wants: innermost first, or\n// stopping at a node it rewrites whole.\n\nfrom ast use DeriveFnDef, ModelDecl, ModelDef, Decl, DeclKind, TypeDecl, Field,\n  Variant, FnDecl, Param, Bound, TestDecl, TraitDecl, TraitMethod, Law,\n  ImplDecl, ExternDecl, CapabilityDecl, TypeExpr, Expr, LamParam, CompFor, Arm,\n  Stmt, Pattern, SelectArm, StrPart, CtorArgs, CtorPat, TypeDef, FnDef, TestDef,\n  TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, Alias, RecordBody,\n  SumBody, NoPayload, Positional, RecordPayload, MemberType, ExternFn,\n  ExternType, ExternStatic, ExternThreadStatic, Named, FnType, UnitType,\n  Refined, UnionType, TupleExpr, ListExpr, CtorExpr, Call, MethodCall, FieldOf,\n  Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr, MutExpr, Block, MockExpr,\n  Return, Try, Except, Interp, Range, Index, Comp, DictExpr, SetExpr, Fallback,\n  Comptime, Scope, Spawn, Await, Select, Race, SupervisedSpawn, Old, Assumed,\n  Spread, NoArgs, PositionalArgs, RecordArgs, UpdateArgs, TextPart, ValuePart,\n  Let, VarDecl, Assign, While, For, Loop, ExprStmt, Assert, ComptimeFor,\n  Invariant, Decreases, CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat,\n  NoPats, PositionalPats, RecordPats, TypePats"},{"name":"walk.stmt_children","kind":"fn","old":"7f8f3e431a3f007e","new":"5679c163f894f16a","interface_changed":false,"affected":[],"module":"walk","text":"/// `s` with `fe` applied to the expressions directly in it and `ft` to its\n/// types.\npub fn stmt_children(\n  s: ast.Stmt,\n  fe: (ast.Expr) -> ast.Expr,\n  ft: (ast.TypeExpr) -> ast.TypeExpr,\n) -> ast.Stmt {\n  match s {\n    ast.Let { pat, ty, value } => ast.Let {\n      pat: walk.pattern_exprs(pat, fe),\n      ty: walk.opt_type(ty, ft),\n      value: fe(value),\n    },\n    ast.VarDecl { name, ty, value } => ast.VarDecl {\n      name,\n      ty: walk.opt_type(ty, ft),\n      value: fe(value),\n    },\n    ast.Assign { place, value } => ast.Assign { place: fe(place), value: fe(value) },\n    ast.While { cond, body } => ast.While { cond: fe(cond), body: fe(body) },\n    ast.For { pat, iter, body } => ast.For {\n      pat: walk.pattern_exprs(pat, fe),\n      iter: fe(iter),\n      body: fe(body),\n    },\n    ast.Loop(b) => ast.Loop(fe(b)),\n    ast.ExprStmt(x) => ast.ExprStmt(fe(x)),\n    ast.Assert(x) => ast.Assert(fe(x)),\n    ast.Invariant(x) => ast.Invariant(fe(x)),\n    ast.Decreases(x) => ast.Decreases(fe(x)),\n    ast.AssertBy { cond, proof } => ast.AssertBy { cond: fe(cond), proof: fe(proof) },\n    ast.Calc(xs) => ast.Calc(xs.map(x -> fe(x))),\n    ast.ComptimeFor { pat, iter, body } => ast.ComptimeFor {\n      pat: walk.pattern_exprs(pat, fe),\n      iter: fe(iter),\n      body: fe(body),\n    },\n    _ => s,\n  }\n}","old_text":"/// `s` with `fe` applied to the expressions directly in it and `ft` to its\n/// types.\npub fn stmt_children(\n  s: ast.Stmt,\n  fe: (ast.Expr) -> ast.Expr,\n  ft: (ast.TypeExpr) -> ast.TypeExpr,\n) -> ast.Stmt {\n  match s {\n    ast.Let { pat, ty, value } => ast.Let {\n      pat: walk.pattern_exprs(pat, fe),\n      ty: walk.opt_type(ty, ft),\n      value: fe(value),\n    },\n    ast.VarDecl { name, ty, value } => ast.VarDecl {\n      name,\n      ty: walk.opt_type(ty, ft),\n      value: fe(value),\n    },\n    ast.Assign { place, value } => ast.Assign { place: fe(place), value: fe(value) },\n    ast.While { cond, body } => ast.While { cond: fe(cond), body: fe(body) },\n    ast.For { pat, iter, body } => ast.For {\n      pat: walk.pattern_exprs(pat, fe),\n      iter: fe(iter),\n      body: fe(body),\n    },\n    ast.Loop(b) => ast.Loop(fe(b)),\n    ast.ExprStmt(x) => ast.ExprStmt(fe(x)),\n    ast.Assert(x) => ast.Assert(fe(x)),\n    ast.Invariant(x) => ast.Invariant(fe(x)),\n    ast.Decreases(x) => ast.Decreases(fe(x)),\n    ast.ComptimeFor { pat, iter, body } => ast.ComptimeFor {\n      pat: walk.pattern_exprs(pat, fe),\n      iter: fe(iter),\n      body: fe(body),\n    },\n    _ => s,\n  }\n}"},{"name":"walk.stmt_kids","kind":"fn","old":"d9cf907f242a94b2","new":"e46b73be921fbc85","interface_changed":false,"affected":[],"module":"walk","text":"pub fn stmt_kids(s: ast.Stmt) -> List[ast.Expr] {\n  match s {\n    ast.Let { pat, value, .. } => walk.pattern_kids(pat) + [value],\n    ast.VarDecl { value, .. } => [value],\n    ast.Assign { place, value } => [place, value],\n    ast.While { cond, body } => [cond, body],\n    ast.For { pat, iter, body } | ast.ComptimeFor { pat, iter, body } => walk.pattern_kids(pat) + [iter, body],\n    ast.Loop(b) | ast.ExprStmt(b) | ast.Assert(b) | ast.Invariant(b) | ast.Decreases(b) => [b],\n    ast.AssertBy { cond, proof } => [cond, proof],\n    ast.Calc(xs) => xs,\n    _ => [],\n  }\n}","old_text":"pub fn stmt_kids(s: ast.Stmt) -> List[ast.Expr] {\n  match s {\n    ast.Let { pat, value, .. } => walk.pattern_kids(pat) + [value],\n    ast.VarDecl { value, .. } => [value],\n    ast.Assign { place, value } => [place, value],\n    ast.While { cond, body } => [cond, body],\n    ast.For { pat, iter, body } | ast.ComptimeFor { pat, iter, body } => walk.pattern_kids(pat) + [iter, body],\n    ast.Loop(b) | ast.ExprStmt(b) | ast.Assert(b) | ast.Invariant(b) | ast.Decreases(b) => [b],\n    _ => [],\n  }\n}"},{"name":"walk.stmt_children_at","kind":"fn","old":"044d8dc2315bb3f9","new":"d1a0caf2a1a6579b","interface_changed":false,"affected":[],"module":"walk","text":"/// Numbered from `at`, in `stmt_kids` order.\nfn stmt_children_at(\n  s: ast.Stmt,\n  at: Int,\n  fe: (Int, ast.Expr) -> ast.Expr,\n) -> ast.Stmt {\n  match s {\n    ast.Let { pat, ty, value } => ast.Let {\n      pat: walk.pattern_exprs_at(pat, at, fe),\n      ty,\n      value: fe(at + walk.pattern_count(pat), value),\n    },\n    ast.VarDecl { name, ty, value } => ast.VarDecl { name, ty, value: fe(at, value) },\n    ast.Assign { place, value } => ast.Assign { place: fe(at, place), value: fe(at + 1, value) },\n    ast.While { cond, body } => ast.While { cond: fe(at, cond), body: fe(at + 1, body) },\n    ast.For { pat, iter, body } => {\n      n := walk.pattern_count(pat)\n      ast.For {\n        pat: walk.pattern_exprs_at(pat, at, fe),\n        iter: fe(at + n, iter),\n        body: fe(at + n + 1, body),\n      }\n    },\n    ast.ComptimeFor { pat, iter, body } => {\n      n := walk.pattern_count(pat)\n      ast.ComptimeFor {\n        pat: walk.pattern_exprs_at(pat, at, fe),\n        iter: fe(at + n, iter),\n        body: fe(at + n + 1, body),\n      }\n    },\n    ast.Loop(b) => ast.Loop(fe(at, b)),\n    ast.ExprStmt(x) => ast.ExprStmt(fe(at, x)),\n    ast.Assert(x) => ast.Assert(fe(at, x)),\n    ast.Invariant(x) => ast.Invariant(fe(at, x)),\n    ast.Decreases(x) => ast.Decreases(fe(at, x)),\n    ast.AssertBy { cond, proof } => ast.AssertBy { cond: fe(at, cond), proof: fe(at + 1, proof) },\n    ast.Calc(xs) => ast.Calc(enumerate(xs).map(p -> fe(at + p.0, p.1))),\n    _ => s,\n  }\n}","old_text":"/// Numbered from `at`, in `stmt_kids` order.\nfn stmt_children_at(\n  s: ast.Stmt,\n  at: Int,\n  fe: (Int, ast.Expr) -> ast.Expr,\n) -> ast.Stmt {\n  match s {\n    ast.Let { pat, ty, value } => ast.Let {\n      pat: walk.pattern_exprs_at(pat, at, fe),\n      ty,\n      value: fe(at + walk.pattern_count(pat), value),\n    },\n    ast.VarDecl { name, ty, value } => ast.VarDecl { name, ty, value: fe(at, value) },\n    ast.Assign { place, value } => ast.Assign { place: fe(at, place), value: fe(at + 1, value) },\n    ast.While { cond, body } => ast.While { cond: fe(at, cond), body: fe(at + 1, body) },\n    ast.For { pat, iter, body } => {\n      n := walk.pattern_count(pat)\n      ast.For {\n        pat: walk.pattern_exprs_at(pat, at, fe),\n        iter: fe(at + n, iter),\n        body: fe(at + n + 1, body),\n      }\n    },\n    ast.ComptimeFor { pat, iter, body } => {\n      n := walk.pattern_count(pat)\n      ast.ComptimeFor {\n        pat: walk.pattern_exprs_at(pat, at, fe),\n        iter: fe(at + n, iter),\n        body: fe(at + n + 1, body),\n      }\n    },\n    ast.Loop(b) => ast.Loop(fe(at, b)),\n    ast.ExprStmt(x) => ast.ExprStmt(fe(at, x)),\n    ast.Assert(x) => ast.Assert(fe(at, x)),\n    ast.Invariant(x) => ast.Invariant(fe(at, x)),\n    ast.Decreases(x) => ast.Decreases(fe(at, x)),\n    _ => s,\n  }\n}"},{"name":"walk.stmt_count","kind":"fn","old":"b24fe77daeaf0e64","new":"0552f4ef0ef8f378","interface_changed":false,"affected":[],"module":"walk","text":"/// `len(stmt_kids(s))`\nfn stmt_count(s: ast.Stmt) -> Int {\n  match s {\n    ast.Let { pat, .. } => walk.pattern_count(pat) + 1,\n    ast.VarDecl { .. } => 1,\n    ast.Assign { .. } | ast.While { .. } => 2,\n    ast.For { pat, .. } | ast.ComptimeFor { pat, .. } => walk.pattern_count(pat) + 2,\n    ast.Loop(_) | ast.ExprStmt(_) | ast.Assert(_) | ast.Invariant(_) | ast.Decreases(_) => 1,\n    ast.AssertBy { .. } => 2,\n    ast.Calc(xs) => len(xs),\n    _ => 0,\n  }\n}","old_text":"/// `len(stmt_kids(s))`\nfn stmt_count(s: ast.Stmt) -> Int {\n  match s {\n    ast.Let { pat, .. } => walk.pattern_count(pat) + 1,\n    ast.VarDecl { .. } => 1,\n    ast.Assign { .. } | ast.While { .. } => 2,\n    ast.For { pat, .. } | ast.ComptimeFor { pat, .. } => walk.pattern_count(pat) + 2,\n    ast.Loop(_) | ast.ExprStmt(_) | ast.Assert(_) | ast.Invariant(_) | ast.Decreases(_) => 1,\n    _ => 0,\n  }\n}"}]}
{"id":"ef3367352ed04f54","time":1795664835,"message":"edit","changes":[{"name":"capabilities.use ast","kind":"use","old":"d4e39edb2b7ef5d0","new":"bde3693b72284f52","interface_changed":true,"affected":[],"module":"capabilities","text":"// capabilities: the checker's rules on capabilities, tasks, raw memory,\n// `noalloc` and foreign functions that need no type inference.\n\nfrom ast use Decl, Param, TypeExpr, Expr, TryKind, Stmt, Pattern, SelectArm,\n  TypeDef, FnDef, TestDef, ExternDef, ExternDecl, Builtin, CapabilityDef, Alias,\n  ExternFn, ExternType, ExternStatic, ExternThreadStatic, Named, FnType,\n  Refined, UnionType, UnitType, TupleExpr, Var, ListExpr, CtorExpr, Call,\n  MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr,\n  MutExpr, Block, Return, Try, Except, Interp, Range, Index, Comp, DictExpr,\n  SetExpr, Fallback, Comptime, Scope, Spawn, Await, Select, Race,\n  SupervisedSpawn, Old, Assumed, Spread, NoArgs, PositionalArgs, RecordArgs,\n  UpdateArgs, TextPart, ValuePart, TryResult, TryOption, Let, VarDecl, Assign,\n  While, For, Loop, ExprStmt, Assert, ComptimeFor, Invariant, Decreases, Bind,\n  CtorPattern, ListPat, TuplePat, OrPat, ForPat, NoPats, PositionalPats,\n  RecordPats, TypePats, MockExpr, FnDecl, IntLit, BigIntLit, FloatLit, StrLit,\n  BoolLit, UnitExpr, Neg, C, ImplDef, TraitDef, Python, AssertBy, Calc","old_text":"// capabilities: the checker's rules on capabilities, tasks, raw memory,\n// `noalloc` and foreign functions that need no type inference.\n\nfrom ast use Decl, Param, TypeExpr, Expr, TryKind, Stmt, Pattern, SelectArm,\n  TypeDef, FnDef, TestDef, ExternDef, ExternDecl, Builtin, CapabilityDef, Alias,\n  ExternFn, ExternType, ExternStatic, ExternThreadStatic, Named, FnType,\n  Refined, UnionType, UnitType, TupleExpr, Var, ListExpr, CtorExpr, Call,\n  MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr,\n  MutExpr, Block, Return, Try, Except, Interp, Range, Index, Comp, DictExpr,\n  SetExpr, Fallback, Comptime, Scope, Spawn, Await, Select, Race,\n  SupervisedSpawn, Old, Assumed, Spread, NoArgs, PositionalArgs, RecordArgs,\n  UpdateArgs, TextPart, ValuePart, TryResult, TryOption, Let, VarDecl, Assign,\n  While, For, Loop, ExprStmt, Assert, ComptimeFor, Invariant, Decreases, Bind,\n  CtorPattern, ListPat, TuplePat, OrPat, ForPat, NoPats, PositionalPats,\n  RecordPats, TypePats, MockExpr, FnDecl, IntLit, BigIntLit, FloatLit, StrLit,\n  BoolLit, UnitExpr, Neg, C, ImplDef, TraitDef, Python"},{"name":"capabilities.lemma_errors","kind":"fn","old":null,"new":"afc4fdfccd4828b8","interface_changed":true,"affected":[],"module":"capabilities","text":"/// The rules on lemmas (`lemma name(params) requires … ensures … { steps\n/// }`), `decls` resolved, `lib` the rest of the program and std:\n/// - a lemma returns nothing (its `ensures` is what it proves) and takes no\n/// `mut` parameter\n/// - it is called only in a proof: a lemma's body, or the steps after an\n/// `assert … by`. It is never compiled, so code that runs can't call it.\npub fn lemma_errors(\n  decls: List[ast.Decl],\n  lib: List[ast.Decl],\n) -> List[(String, String)] {\n  mut lemmas := Set[String] {}\n  for d in decls + lib {\n    match d.kind {\n      ast.FnDef(f) => if f.lemma {\n        mut lemmas.insert(\n          if d.module == \"\" {\n            f.name\n          } else {\n            d.module + \".\" + f.name\n          },\n        )\n      },\n      _ => (),\n    }\n  }\n  mut out := []\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if f.lemma {\n        if f.ret != ast.UnitType {\n          mut out.push(\n            (\n              f.name,\n              \"a lemma returns nothing: its `ensures` is the fact it proves (`lemma \"\n                + f.name\n                + \"(…) ensures …`)\",\n            ),\n          )\n        }\n        if f.params.any(p -> p.mutable) {\n          mut out.push(\n            (\n              f.name,\n              \"a lemma's parameters can't be `mut`: it changes nothing, it states a fact about them\",\n            ),\n          )\n        }\n      } else {\n        mut calls := []\n        capabilities.lemma_calls(\n          f.body,\n          lemmas,\n          d.module,\n          mut calls,\n        )\n        for c in f.pre + f.post {\n          capabilities.lemma_calls(c, lemmas, d.module, mut calls)\n        }\n        mut said := Set[String] {}\n        for n in calls {\n          if !contains(said, n) {\n            mut said.insert(n)\n            mut out.push(\n              (\n                f.name,\n                \"`\"\n                  + n\n                  + \"` is a lemma: it exists only for `verify`, so call it in a proof (`assert … by \"\n                  + n\n                  + \"(…)`, or a lemma's body), never in code that runs\",\n              ),\n            )\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"capabilities.lemma_calls","kind":"fn","old":null,"new":"5de42d30c3813e53","interface_changed":true,"affected":[],"module":"capabilities","text":"/// The lemmas `e` calls outside its proofs (an `assert … by`'s steps, a\n/// `calc`), into `out`.\nfn lemma_calls(\n  e: ast.Expr,\n  lemmas: Set[String],\n  module: String,\n  mut out: List[String],\n) {\n  match e {\n    ast.Block { stmts, last } => {\n      for s in stmts {\n        match s {\n          ast.AssertBy { cond, .. } => capabilities.lemma_calls(cond, lemmas, module, mut out),\n          ast.Calc(_) => (),\n          _ => {\n            for k in walk.stmt_kids(s) {\n              capabilities.lemma_calls(k, lemmas, module, mut out)\n            }\n          },\n        }\n      }\n      capabilities.lemma_calls(last, lemmas, module, mut out)\n    },\n    ast.Call { callee: ast.Var(n), args } => {\n      if contains(lemmas, n)\n        || module != \"\" && contains(lemmas, module + \".\" + n) {\n        mut out.push(n)\n      }\n      for a in args {\n        capabilities.lemma_calls(a, lemmas, module, mut out)\n      }\n    },\n    _ => {\n      for k in walk.kids(e) {\n        capabilities.lemma_calls(k, lemmas, module, mut out)\n      }\n    },\n  }\n}"}]}
{"id":"3570d60198023168","time":1795664846,"message":"edit","changes":[{"name":"check_errors_in","kind":"fn","old":"34507457898cef74","new":"a93e44af4370b4a0","interface_changed":false,"affected":[],"module":"","text":"/// `check_errors_with` in `ds` only. The first `own` definitions of `lib`\n/// are the rest of the program (what an edit leaves alone): the passes that\n/// check `ds` know them as they know `ds`.\nfn check_errors_in(\n  ds: List[ast.Decl],\n  lib: List[ast.Decl],\n  own: Int,\n  core: builtins.Core,\n  values: Bool,\n  run: (List[ast.Decl], String, List[ast.Expr]) -> List[Result[ast.Expr, String]],\n) -> List[(String, String)] {\n  mut out := []\n  // what is checked is the program desugared; definitions are told apart as\n  // written (with the rest of the program as context: the traits whose\n  // models the definitions name)\n  (sweet0, sugar_errors) := timings.timed(\"desugar\", () -> desugar.desugar_in(ds, lib))\n  // each `derive` made (and `comptime e` folded), with the trait's code from\n  // `lib` and core's types: the derived methods are checked as written out\n  sweet_lib := timings.timed(\"desugar\", () -> desugar.desugar(lib).0)\n  context := sweet_lib + core.decls\n  // (the rest of the program, known to the passes that check `ds`)\n  known := [x for (k, x) in enumerate(sweet_lib) where k < own]\n  (derived, derive_errors0) := timings.timed(\"derive\", () -> derive.derived_in(sweet0, context))\n  // (`comptime e` folded in the program's own definitions only: std's are\n  // compiled with the std the program loads)\n  (folded, fold_errors) := derive.folded_in(derived, context, run)\n  // each call spreading records written out (`f(...x)` is `f(x.a, x.b)`), so\n  // the passes below see ordinary calls\n  (sweet, spread_errors) := timings.timed(\n    \"check\",\n    () -> check.spreads_resolved(folded, sweet_lib, core),\n  )\n  all_errors := derive_errors0 + fold_errors\n  // (only the program's own: std's are std's)\n  names := set(ds.map(d -> desugar.decl_name(d)))\n  derive_errors := all_errors.filter(e -> contains(names, e.0))\n  // (an arm both checks find unreachable, `exhaustive`'s on sums and the\n  // checker's on the rest, is said once)\n  timings.begin(\"check: other passes\")\n  matches := exhaustive.match_errors(sweet, lib)\n  timings.end(\"check: other passes\")\n  typed := timings.timed(\n    \"check\",\n    () -> check.type_errors_with(sweet, lib, core),\n  ).filter(\n    e -> !(starts_with(e.1, \"unreachable match arm\")\n      && matches.any(x -> x == e)),\n  )\n  timings.begin(\"check: other passes\")\n  for e in check.definition_errors(ds, core)\n    + check.variant_errors(ds, core)\n    + sugar_errors\n    + derive_errors\n    + spread_errors\n    + check.expression_errors_in(sweet, known, core)\n    + typed\n    + mutability.mut_errors_in(sweet, known)\n    + matches\n    + capabilities.capability_errors_in(sweet, lib)\n    + capabilities.python_errors(ds, lib)\n    + capabilities.lemma_errors(sweet, lib)\n    + contracts.contract_errors_in(sweet, known)\n    + declarations.declaration_errors_in(\n      ds,\n      [x for (k, x) in enumerate(lib) where k < own],\n      core,\n    )\n    + capabilities.core_only_errors(sweet, core.mem, values)\n    + capabilities.runtime_call_errors(sweet, core.rt, core.mem)\n    + capabilities.noalloc_errors(sweet, sweet_lib + core.decls) {\n    // (a warning keeps its mark: `warned` prints it apart)\n    mut out.push(\n      if e.0 == \"$warning\" {\n        e\n      } else {\n        (qualified(ds, e.0), e.1)\n      },\n    )\n  }\n  timings.end(\"check: other passes\")\n  out\n}","old_text":"/// `check_errors_with` in `ds` only. The first `own` definitions of `lib`\n/// are the rest of the program (what an edit leaves alone): the passes that\n/// check `ds` know them as they know `ds`.\nfn check_errors_in(\n  ds: List[ast.Decl],\n  lib: List[ast.Decl],\n  own: Int,\n  core: builtins.Core,\n  values: Bool,\n  run: (List[ast.Decl], String, List[ast.Expr]) -> List[Result[ast.Expr, String]],\n) -> List[(String, String)] {\n  mut out := []\n  // what is checked is the program desugared; definitions are told apart as\n  // written (with the rest of the program as context: the traits whose\n  // models the definitions name)\n  (sweet0, sugar_errors) := timings.timed(\"desugar\", () -> desugar.desugar_in(ds, lib))\n  // each `derive` made (and `comptime e` folded), with the trait's code from\n  // `lib` and core's types: the derived methods are checked as written out\n  sweet_lib := timings.timed(\"desugar\", () -> desugar.desugar(lib).0)\n  context := sweet_lib + core.decls\n  // (the rest of the program, known to the passes that check `ds`)\n  known := [x for (k, x) in enumerate(sweet_lib) where k < own]\n  (derived, derive_errors0) := timings.timed(\"derive\", () -> derive.derived_in(sweet0, context))\n  // (`comptime e` folded in the program's own definitions only: std's are\n  // compiled with the std the program loads)\n  (folded, fold_errors) := derive.folded_in(derived, context, run)\n  // each call spreading records written out (`f(...x)` is `f(x.a, x.b)`), so\n  // the passes below see ordinary calls\n  (sweet, spread_errors) := timings.timed(\n    \"check\",\n    () -> check.spreads_resolved(folded, sweet_lib, core),\n  )\n  all_errors := derive_errors0 + fold_errors\n  // (only the program's own: std's are std's)\n  names := set(ds.map(d -> desugar.decl_name(d)))\n  derive_errors := all_errors.filter(e -> contains(names, e.0))\n  // (an arm both checks find unreachable, `exhaustive`'s on sums and the\n  // checker's on the rest, is said once)\n  timings.begin(\"check: other passes\")\n  matches := exhaustive.match_errors(sweet, lib)\n  timings.end(\"check: other passes\")\n  typed := timings.timed(\n    \"check\",\n    () -> check.type_errors_with(sweet, lib, core),\n  ).filter(\n    e -> !(starts_with(e.1, \"unreachable match arm\")\n      && matches.any(x -> x == e)),\n  )\n  timings.begin(\"check: other passes\")\n  for e in check.definition_errors(ds, core)\n    + check.variant_errors(ds, core)\n    + sugar_errors\n    + derive_errors\n    + spread_errors\n    + check.expression_errors_in(sweet, known, core)\n    + typed\n    + mutability.mut_errors_in(sweet, known)\n    + matches\n    + capabilities.capability_errors_in(sweet, lib)\n    + capabilities.python_errors(ds, lib)\n    + contracts.contract_errors_in(sweet, known)\n    + declarations.declaration_errors_in(\n      ds,\n      [x for (k, x) in enumerate(lib) where k < own],\n      core,\n    )\n    + capabilities.core_only_errors(sweet, core.mem, values)\n    + capabilities.runtime_call_errors(sweet, core.rt, core.mem)\n    + capabilities.noalloc_errors(sweet, sweet_lib + core.decls) {\n    // (a warning keeps its mark: `warned` prints it apart)\n    mut out.push(\n      if e.0 == \"$warning\" {\n        e\n      } else {\n        (qualified(ds, e.0), e.1)\n      },\n    )\n  }\n  timings.end(\"check: other passes\")\n  out\n}"}]}
{"id":"ac2b3fba5d85e66d","time":1795664864,"message":"edit","changes":[{"name":"ast.calc_steps","kind":"fn","old":null,"new":"172ad030b4620bb4","interface_changed":true,"affected":[],"module":"ast","text":"/// A `calc`'s steps with each `_` (the left side of a step after the\n/// first) written out as the step before's right side: `calc { a == b; _ <=\n/// c }` is `[a == b, b <= c]`.\npub fn calc_steps(xs: List[ast.Expr]) -> List[ast.Expr] {\n  mut out := []\n  mut prev: Option[ast.Expr] = None\n  for x in xs {\n    step := match (x, prev) {\n      (ast.Binary { op, left: ast.Var(\"_\"), right }, Some(p)) => ast.Binary { op, left: p, right },\n      _ => x,\n    }\n    prev = match step {\n      ast.Binary { right, .. } => Some(right),\n      _ => None,\n    }\n    mut out.push(step)\n  }\n  out\n}"},{"name":"ast.calc_fact","kind":"fn","old":null,"new":"68720e96ecf1f0b5","interface_changed":true,"affected":[],"module":"ast","text":"/// What a `calc` proves: its first step's left side related to its last\n/// step's right side, by `<` if a step is `<`, else `<=` if one is, else\n/// `==` (and the same with `>`, `>=`), or `==>` for a chain of `==>` and\n/// `==`. `None` when the steps don't chain that way (an error).\npub fn calc_fact(xs: List[ast.Expr]) -> Option[ast.Expr] {\n  steps := ast.calc_steps(xs)\n  mut ops := []\n  for s in steps {\n    match s {\n      ast.Binary { op, .. } => mut ops.push(op),\n      _ => return None,\n    }\n  }\n  first := match get(steps, 0) {\n    Some(ast.Binary { left, .. }) => left,\n    _ => return None,\n  }\n  last := match get(steps, len(steps) - 1) {\n    Some(ast.Binary { right, .. }) => right,\n    _ => return None,\n  }\n  up := ops.all(o -> o == ast.Equal || o == ast.LessEq || o == ast.Less)\n  down := ops.all(\n    o -> o == ast.Equal || o == ast.GreaterEq || o == ast.Greater,\n  )\n  imp := ops.all(o -> o == ast.Equal || o == ast.Implies)\n  op := if ops.all(o -> o == ast.Equal) {\n    ast.Equal\n  } else if up {\n    if ops.any(o -> o == ast.Less) {\n      ast.Less\n    } else {\n      ast.LessEq\n    }\n  } else if down {\n    if ops.any(o -> o == ast.Greater) {\n      ast.Greater\n    } else {\n      ast.GreaterEq\n    }\n  } else if imp {\n    ast.Implies\n  } else {\n    return None\n  }\n  Some(ast.Binary { op, left: first, right: last })\n}"}]}
{"id":"4b76f1b63e091e58","time":1795664910,"message":"edit","changes":[{"name":"resolve.use ast","kind":"use","old":"7c8596851bfa27b5","new":"8af44d018e940668","interface_changed":true,"affected":[],"module":"resolve","text":"// resolve: name resolution. It turns a program into its stored form, where\n// every reference to a definition is its qualified name, and back into the\n// written form. Locals and method names are left as written. A name that\n// resolves to nothing stays as written, and the checker reports it.\n\nfrom ast use DeriveFnDef, DeriveFnDecl, ModelDecl, ModelDef, Decl, DeclKind,\n  TypeDecl, Field, Variant, FnDecl, Param, Bound, TestDecl, TraitDecl,\n  Derivable, TraitMethod, Law, ImplDecl, ExternDecl, CapabilityDecl, TypeExpr,\n  Expr, LamParam, CompFor, Arm, Stmt, Pattern, SelectArm, TypeDef, FnDef,\n  TestDef, TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, Alias,\n  RecordBody, SumBody, NoPayload, Positional, RecordPayload, MemberType,\n  ExternFn, ExternType, ExternStatic, ExternThreadStatic, Named, FnType,\n  UnitType, Refined, UnionType, TupleExpr, Var, ListExpr, CtorExpr, Call,\n  MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr,\n  MutExpr, Block, MockExpr, Return, Try, Except, Interp, Range, Index, Comp,\n  DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn, Await, Select, Race,\n  SupervisedSpawn, Old, Assumed, Spread, NoArgs, PositionalArgs, RecordArgs,\n  UpdateArgs, ValuePart, Let, VarDecl, Assign, While, For, Loop, ExprStmt,\n  Assert, ComptimeFor, Invariant, Decreases, Bind, CtorPattern, ListPat,\n  TuplePat, CondPat, OrPat, ForPat, NoPats, PositionalPats, RecordPats,\n  TypePats, AssertBy, Calc","old_text":"// resolve: name resolution. It turns a program into its stored form, where\n// every reference to a definition is its qualified name, and back into the\n// written form. Locals and method names are left as written. A name that\n// resolves to nothing stays as written, and the checker reports it.\n\nfrom ast use DeriveFnDef, DeriveFnDecl, ModelDecl, ModelDef, Decl, DeclKind,\n  TypeDecl, Field, Variant, FnDecl, Param, Bound, TestDecl, TraitDecl,\n  Derivable, TraitMethod, Law, ImplDecl, ExternDecl, CapabilityDecl, TypeExpr,\n  Expr, LamParam, CompFor, Arm, Stmt, Pattern, SelectArm, TypeDef, FnDef,\n  TestDef, TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, Alias,\n  RecordBody, SumBody, NoPayload, Positional, RecordPayload, MemberType,\n  ExternFn, ExternType, ExternStatic, ExternThreadStatic, Named, FnType,\n  UnitType, Refined, UnionType, TupleExpr, Var, ListExpr, CtorExpr, Call,\n  MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr,\n  MutExpr, Block, MockExpr, Return, Try, Except, Interp, Range, Index, Comp,\n  DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn, Await, Select, Race,\n  SupervisedSpawn, Old, Assumed, Spread, NoArgs, PositionalArgs, RecordArgs,\n  UpdateArgs, ValuePart, Let, VarDecl, Assign, While, For, Loop, ExprStmt,\n  Assert, ComptimeFor, Invariant, Decreases, Bind, CtorPattern, ListPat,\n  TuplePat, CondPat, OrPat, ForPat, NoPats, PositionalPats, RecordPats, TypePats"},{"name":"resolve.stmt","kind":"fn","old":"0cf44993c902ecf0","new":"9fcbde99e9ab4832","interface_changed":false,"affected":[],"module":"resolve","text":"fn stmt(mut r: resolve.Rw, s: ast.Stmt) -> ast.Stmt {\n  match s {\n    ast.Let { pat: p, ty: t, value } => {\n      x := resolve.expr(mut r, value)\n      t2 := resolve.opt_ty(mut r, t)\n      ast.Let { pat: resolve.pat(mut r, p), ty: t2, value: x }\n    },\n    ast.VarDecl { name: n, ty: t, value } => {\n      x := resolve.expr(mut r, value)\n      t2 := resolve.opt_ty(mut r, t)\n      resolve.bind(mut r, n)\n      ast.VarDecl { name: n, ty: t2, value: x }\n    },\n    ast.Assign { place, value } => {\n      pl := resolve.expr(mut r, place)\n      ast.Assign { place: pl, value: resolve.expr(mut r, value) }\n    },\n    ast.While { cond, body } => {\n      c := resolve.expr(mut r, cond)\n      ast.While { cond: c, body: resolve.expr(mut r, body) }\n    },\n    ast.Loop(b) => ast.Loop(resolve.expr(mut r, b)),\n    ast.For { pat: p, iter, body } => {\n      it := resolve.expr(mut r, iter)\n      resolve.open(mut r, [])\n      p2 := resolve.pat(mut r, p)\n      b := resolve.expr(mut r, body)\n      resolve.close(mut r)\n      ast.For { pat: p2, iter: it, body: b }\n    },\n    ast.ComptimeFor { pat: p, iter, body } => {\n      it := resolve.expr(mut r, iter)\n      resolve.open(mut r, [])\n      p2 := resolve.pat(mut r, p)\n      b := resolve.expr(mut r, body)\n      resolve.close(mut r)\n      ast.ComptimeFor { pat: p2, iter: it, body: b }\n    },\n    ast.ExprStmt(x) => ast.ExprStmt(resolve.expr(mut r, x)),\n    ast.Assert(x) => ast.Assert(resolve.expr(mut r, x)),\n    ast.Invariant(x) => ast.Invariant(resolve.expr(mut r, x)),\n    ast.Decreases(x) => ast.Decreases(resolve.expr(mut r, x)),\n    ast.AssertBy { cond, proof } => {\n      c := resolve.expr(mut r, cond)\n      ast.AssertBy { cond: c, proof: resolve.expr(mut r, proof) }\n    },\n    ast.Calc(xs) => {\n      mut ys := []\n      for x in xs {\n        mut ys.push(resolve.expr(mut r, x))\n      }\n      ast.Calc(ys)\n    },\n    _ => s,\n  }\n}","old_text":"fn stmt(mut r: resolve.Rw, s: ast.Stmt) -> ast.Stmt {\n  match s {\n    ast.Let { pat: p, ty: t, value } => {\n      x := resolve.expr(mut r, value)\n      t2 := resolve.opt_ty(mut r, t)\n      ast.Let { pat: resolve.pat(mut r, p), ty: t2, value: x }\n    },\n    ast.VarDecl { name: n, ty: t, value } => {\n      x := resolve.expr(mut r, value)\n      t2 := resolve.opt_ty(mut r, t)\n      resolve.bind(mut r, n)\n      ast.VarDecl { name: n, ty: t2, value: x }\n    },\n    ast.Assign { place, value } => {\n      pl := resolve.expr(mut r, place)\n      ast.Assign { place: pl, value: resolve.expr(mut r, value) }\n    },\n    ast.While { cond, body } => {\n      c := resolve.expr(mut r, cond)\n      ast.While { cond: c, body: resolve.expr(mut r, body) }\n    },\n    ast.Loop(b) => ast.Loop(resolve.expr(mut r, b)),\n    ast.For { pat: p, iter, body } => {\n      it := resolve.expr(mut r, iter)\n      resolve.open(mut r, [])\n      p2 := resolve.pat(mut r, p)\n      b := resolve.expr(mut r, body)\n      resolve.close(mut r)\n      ast.For { pat: p2, iter: it, body: b }\n    },\n    ast.ComptimeFor { pat: p, iter, body } => {\n      it := resolve.expr(mut r, iter)\n      resolve.open(mut r, [])\n      p2 := resolve.pat(mut r, p)\n      b := resolve.expr(mut r, body)\n      resolve.close(mut r)\n      ast.ComptimeFor { pat: p2, iter: it, body: b }\n    },\n    ast.ExprStmt(x) => ast.ExprStmt(resolve.expr(mut r, x)),\n    ast.Assert(x) => ast.Assert(resolve.expr(mut r, x)),\n    ast.Invariant(x) => ast.Invariant(resolve.expr(mut r, x)),\n    ast.Decreases(x) => ast.Decreases(resolve.expr(mut r, x)),\n    _ => s,\n  }\n}"}]}
{"id":"51128988bfd0ccfa","time":1795664913,"message":"edit","changes":[{"name":"store.use ast","kind":"use","old":"d37e67b010af2d84","new":"bc99153cde1e56f9","interface_changed":true,"affected":[],"module":"store","text":"// store: qualified names, and the dependency graph that module file headers\n// list.\n\nfrom ast use DeriveFnDef, Decl, Expr, Stmt, Pattern, TypeExpr, CtorArgs,\n  CtorPat, StrPart, TypeDef, FnDef, TestDef, TraitDef, ImplDef, UseDef,\n  ExternDef, CapabilityDef, Alias, RecordBody, SumBody, NoPayload, Positional,\n  RecordPayload, MemberType, Named, FnType, UnitType, Refined, UnionType, Var,\n  ListExpr, TupleExpr, CtorExpr, Call, MethodCall, FieldOf, Unary, Return,\n  MutExpr, Try, Lambda, Except, Fallback, Interp, ValuePart, MockExpr, IsExpr,\n  Binary, IfExpr, MatchExpr, Block, Let, VarDecl, Assign, While, For, Loop,\n  ExprStmt, Assert, Invariant, Decreases, CtorPattern, ListPat, TuplePat, OrPat,\n  CondPat, PositionalArgs, RecordArgs, UpdateArgs, PositionalPats, RecordPats,\n  TypePats, ExternFn, ComptimeFor, AssertBy, Calc","old_text":"// store: qualified names, and the dependency graph that module file headers\n// list.\n\nfrom ast use DeriveFnDef, Decl, Expr, Stmt, Pattern, TypeExpr, CtorArgs,\n  CtorPat, StrPart, TypeDef, FnDef, TestDef, TraitDef, ImplDef, UseDef,\n  ExternDef, CapabilityDef, Alias, RecordBody, SumBody, NoPayload, Positional,\n  RecordPayload, MemberType, Named, FnType, UnitType, Refined, UnionType, Var,\n  ListExpr, TupleExpr, CtorExpr, Call, MethodCall, FieldOf, Unary, Return,\n  MutExpr, Try, Lambda, Except, Fallback, Interp, ValuePart, MockExpr, IsExpr,\n  Binary, IfExpr, MatchExpr, Block, Let, VarDecl, Assign, While, For, Loop,\n  ExprStmt, Assert, Invariant, Decreases, CtorPattern, ListPat, TuplePat, OrPat,\n  CondPat, PositionalArgs, RecordArgs, UpdateArgs, PositionalPats, RecordPats,\n  TypePats, ExternFn, ComptimeFor"},{"name":"store.stmt","kind":"fn","old":"b77d31f3cbcbbe2a","new":"8a301cdba14dd98a","interface_changed":false,"affected":[],"module":"store","text":"fn stmt(mut out: Set[String], s: ast.Stmt, ct: Dict[String, String]) {\n  match s {\n    ast.VarDecl { ty: t, value, .. } => {\n      match t {\n        Some(x) => store.ty(mut out, x),\n        None => (),\n      }\n      store.ex(mut out, value, ct)\n    },\n    ast.Assign { place, value } => {\n      store.ex(mut out, place, ct)\n      store.ex(mut out, value, ct)\n    },\n    ast.While { cond, body } => {\n      store.ex(mut out, cond, ct)\n      store.ex(mut out, body, ct)\n    },\n    ast.Loop(b) => store.ex(mut out, b, ct),\n    ast.Invariant(b) | ast.Decreases(b) => store.ex(mut out, b, ct),\n    ast.AssertBy { cond, proof } => {\n      store.ex(mut out, cond, ct)\n      store.ex(mut out, proof, ct)\n    },\n    ast.Calc(xs) => {\n      for x in xs {\n        store.ex(mut out, x, ct)\n      }\n    },\n    ast.For { pat: p, iter, body } | ast.ComptimeFor { pat: p, iter, body } => {\n      store.pat(mut out, p, ct)\n      store.ex(mut out, iter, ct)\n      store.ex(mut out, body, ct)\n    },\n    ast.Let { pat: p, ty: t, value } => {\n      store.pat(mut out, p, ct)\n      match t {\n        Some(x) => store.ty(mut out, x),\n        None => (),\n      }\n      store.ex(mut out, value, ct)\n    },\n    ast.ExprStmt(x) => store.ex(mut out, x, ct),\n    ast.Assert(x) => store.ex(mut out, x, ct),\n    _ => (),\n  }\n}","old_text":"fn stmt(mut out: Set[String], s: ast.Stmt, ct: Dict[String, String]) {\n  match s {\n    ast.VarDecl { ty: t, value, .. } => {\n      match t {\n        Some(x) => store.ty(mut out, x),\n        None => (),\n      }\n      store.ex(mut out, value, ct)\n    },\n    ast.Assign { place, value } => {\n      store.ex(mut out, place, ct)\n      store.ex(mut out, value, ct)\n    },\n    ast.While { cond, body } => {\n      store.ex(mut out, cond, ct)\n      store.ex(mut out, body, ct)\n    },\n    ast.Loop(b) => store.ex(mut out, b, ct),\n    ast.Invariant(b) | ast.Decreases(b) => store.ex(mut out, b, ct),\n    ast.For { pat: p, iter, body } | ast.ComptimeFor { pat: p, iter, body } => {\n      store.pat(mut out, p, ct)\n      store.ex(mut out, iter, ct)\n      store.ex(mut out, body, ct)\n    },\n    ast.Let { pat: p, ty: t, value } => {\n      store.pat(mut out, p, ct)\n      match t {\n        Some(x) => store.ty(mut out, x),\n        None => (),\n      }\n      store.ex(mut out, value, ct)\n    },\n    ast.ExprStmt(x) => store.ex(mut out, x, ct),\n    ast.Assert(x) => store.ex(mut out, x, ct),\n    _ => (),\n  }\n}"}]}
{"id":"980c30e19f3bc6bc","time":1795664916,"message":"edit","changes":[{"name":"pending.use ast","kind":"use","old":"c19f5f3bbe83c7e3","new":"be149b81727af4d7","interface_changed":true,"affected":[],"module":"pending","text":"// pending: a change in progress (`strata status`, `done`, `abort`). An\n// edit that breaks callers turns their uses of what changed into holes.\n\nfrom ast use Decl, Expr, Stmt, Pattern, Arm, CompFor, SelectArm, StrPart,\n  TypeDef, FnDef, TestDef, TraitDef, ImplDef, ExternDef, CapabilityDef, SumBody,\n  NoPayload, Positional, RecordPayload, MemberType, Var, Hole, CtorExpr, Call,\n  MethodCall, IsExpr, MatchExpr, TupleExpr, ListExpr, FieldOf, Lambda, Binary,\n  Unary, IfExpr, MutExpr, Block, Return, Try, Except, Interp, ValuePart, Range,\n  Index, Comp, DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn,\n  SupervisedSpawn, Old, Assumed, Spread, Await, Select, Race, NoArgs,\n  PositionalArgs, RecordArgs, UpdateArgs, Let, VarDecl, Assign, While, For,\n  Loop, ExprStmt, Assert, Invariant, Decreases, ComptimeFor, CtorPattern,\n  ListPat, TuplePat, OrPat, Wild, Bind, NoPats, PositionalPats, RecordPats,\n  TypePats, ExternFn, AssertBy, Calc","old_text":"// pending: a change in progress (`strata status`, `done`, `abort`). An\n// edit that breaks callers turns their uses of what changed into holes.\n\nfrom ast use Decl, Expr, Stmt, Pattern, Arm, CompFor, SelectArm, StrPart,\n  TypeDef, FnDef, TestDef, TraitDef, ImplDef, ExternDef, CapabilityDef, SumBody,\n  NoPayload, Positional, RecordPayload, MemberType, Var, Hole, CtorExpr, Call,\n  MethodCall, IsExpr, MatchExpr, TupleExpr, ListExpr, FieldOf, Lambda, Binary,\n  Unary, IfExpr, MutExpr, Block, Return, Try, Except, Interp, ValuePart, Range,\n  Index, Comp, DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn,\n  SupervisedSpawn, Old, Assumed, Spread, Await, Select, Race, NoArgs,\n  PositionalArgs, RecordArgs, UpdateArgs, Let, VarDecl, Assign, While, For,\n  Loop, ExprStmt, Assert, Invariant, Decreases, ComptimeFor, CtorPattern,\n  ListPat, TuplePat, OrPat, Wild, Bind, NoPats, PositionalPats, RecordPats,\n  TypePats, ExternFn"},{"name":"pending.visit_stmt","kind":"fn","old":"d2ba41f9b44cc523","new":"1159a2497d4502f8","interface_changed":false,"affected":[],"module":"pending","text":"fn visit_stmt(mut w: pending.Walk, s: ast.Stmt) -> ast.Stmt {\n  match s {\n    ast.Let { pat, ty, value } => ast.Let { pat, ty, value: pending.visit(mut w, value) },\n    ast.VarDecl { name, ty, value } => ast.VarDecl { name, ty, value: pending.visit(mut w, value) },\n    ast.Assign { place, value } => {\n      p := pending.visit(mut w, place)\n      ast.Assign { place: p, value: pending.visit(mut w, value) }\n    },\n    ast.While { cond, body } => {\n      c := pending.visit(mut w, cond)\n      ast.While { cond: c, body: pending.visit(mut w, body) }\n    },\n    ast.For { pat, iter, body } => {\n      it := pending.visit(mut w, iter)\n      ast.For { pat, iter: it, body: pending.visit(mut w, body) }\n    },\n    ast.Loop(b) => ast.Loop(pending.visit(mut w, b)),\n    ast.ExprStmt(x) => ast.ExprStmt(pending.visit(mut w, x)),\n    ast.Assert(x) => ast.Assert(pending.visit(mut w, x)),\n    ast.Invariant(x) => ast.Invariant(pending.visit(mut w, x)),\n    ast.Decreases(x) => ast.Decreases(pending.visit(mut w, x)),\n    ast.AssertBy { cond, proof } => {\n      c := pending.visit(mut w, cond)\n      ast.AssertBy { cond: c, proof: pending.visit(mut w, proof) }\n    },\n    ast.Calc(xs) => {\n      mut ys := []\n      for x in xs {\n        mut ys.push(pending.visit(mut w, x))\n      }\n      ast.Calc(ys)\n    },\n    ast.ComptimeFor { pat, iter, body } => {\n      it := pending.visit(mut w, iter)\n      ast.ComptimeFor {\n        pat,\n        iter: it,\n        body: pending.visit(mut w, body),\n      }\n    },\n    _ => s,\n  }\n}","old_text":"fn visit_stmt(mut w: pending.Walk, s: ast.Stmt) -> ast.Stmt {\n  match s {\n    ast.Let { pat, ty, value } => ast.Let { pat, ty, value: pending.visit(mut w, value) },\n    ast.VarDecl { name, ty, value } => ast.VarDecl { name, ty, value: pending.visit(mut w, value) },\n    ast.Assign { place, value } => {\n      p := pending.visit(mut w, place)\n      ast.Assign { place: p, value: pending.visit(mut w, value) }\n    },\n    ast.While { cond, body } => {\n      c := pending.visit(mut w, cond)\n      ast.While { cond: c, body: pending.visit(mut w, body) }\n    },\n    ast.For { pat, iter, body } => {\n      it := pending.visit(mut w, iter)\n      ast.For { pat, iter: it, body: pending.visit(mut w, body) }\n    },\n    ast.Loop(b) => ast.Loop(pending.visit(mut w, b)),\n    ast.ExprStmt(x) => ast.ExprStmt(pending.visit(mut w, x)),\n    ast.Assert(x) => ast.Assert(pending.visit(mut w, x)),\n    ast.Invariant(x) => ast.Invariant(pending.visit(mut w, x)),\n    ast.Decreases(x) => ast.Decreases(pending.visit(mut w, x)),\n    ast.ComptimeFor { pat, iter, body } => {\n      it := pending.visit(mut w, iter)\n      ast.ComptimeFor {\n        pat,\n        iter: it,\n        body: pending.visit(mut w, body),\n      }\n    },\n    _ => s,\n  }\n}"}]}
{"id":"d649d1bee5ac3ab4","time":1795664918,"message":"edit","changes":[{"name":"locate.stmt_kids","kind":"fn","old":"c8778e4aeeb09df8","new":"a51b144aa5461a77","interface_changed":false,"affected":[],"module":"locate","text":"fn stmt_kids(s: ast.Stmt) -> List[locate.Child] {\n  match s {\n    ast.Let { pat, ty, value } => [locate.kid(\"pat\", locate.PNode(pat))]\n      + locate.opt_type_kid(\"ty\", ty)\n      + [locate.kid(\"value\", locate.ENode(value))],\n    ast.VarDecl { ty, value, .. } => locate.opt_type_kid(\"ty\", ty)\n      + [locate.kid(\"value\", locate.ENode(value))],\n    ast.Assign { place, value } => [\n      locate.kid(\"place\", locate.ENode(place)),\n      locate.kid(\"value\", locate.ENode(value)),\n    ],\n    ast.While { cond, body } => [\n      locate.kid(\"cond\", locate.ENode(cond)),\n      locate.kid(\"body\", locate.ENode(body)),\n    ],\n    ast.For { pat, iter, body } => [\n      locate.kid(\"pat\", locate.PNode(pat)),\n      locate.kid(\"iter\", locate.ENode(iter)),\n      locate.Child {\n        label: \"body\",\n        node: locate.ENode(body),\n        binds: locate.pattern_binds(pat),\n      },\n    ],\n    ast.ComptimeFor { pat, iter, body } => [\n      locate.kid(\"pat\", locate.PNode(pat)),\n      locate.kid(\"iter\", locate.ENode(iter)),\n      locate.Child {\n        label: \"body\",\n        node: locate.ENode(body),\n        binds: locate.pattern_binds(pat),\n      },\n    ],\n    ast.Loop(b) => [locate.kid(\"body\", locate.ENode(b))],\n    ast.ExprStmt(x) => [locate.kid(\"value\", locate.ENode(x))],\n    ast.Assert(x) => [locate.kid(\"value\", locate.ENode(x))],\n    ast.Invariant(x) | ast.Decreases(x) => [locate.kid(\"value\", locate.ENode(x))],\n    ast.AssertBy { cond, proof } => [\n      locate.kid(\"cond\", locate.ENode(cond)),\n      locate.kid(\"proof\", locate.ENode(proof)),\n    ],\n    _ => [],\n  }\n}","old_text":"fn stmt_kids(s: ast.Stmt) -> List[locate.Child] {\n  match s {\n    ast.Let { pat, ty, value } => [locate.kid(\"pat\", locate.PNode(pat))]\n      + locate.opt_type_kid(\"ty\", ty)\n      + [locate.kid(\"value\", locate.ENode(value))],\n    ast.VarDecl { ty, value, .. } => locate.opt_type_kid(\"ty\", ty)\n      + [locate.kid(\"value\", locate.ENode(value))],\n    ast.Assign { place, value } => [\n      locate.kid(\"place\", locate.ENode(place)),\n      locate.kid(\"value\", locate.ENode(value)),\n    ],\n    ast.While { cond, body } => [\n      locate.kid(\"cond\", locate.ENode(cond)),\n      locate.kid(\"body\", locate.ENode(body)),\n    ],\n    ast.For { pat, iter, body } => [\n      locate.kid(\"pat\", locate.PNode(pat)),\n      locate.kid(\"iter\", locate.ENode(iter)),\n      locate.Child {\n        label: \"body\",\n        node: locate.ENode(body),\n        binds: locate.pattern_binds(pat),\n      },\n    ],\n    ast.ComptimeFor { pat, iter, body } => [\n      locate.kid(\"pat\", locate.PNode(pat)),\n      locate.kid(\"iter\", locate.ENode(iter)),\n      locate.Child {\n        label: \"body\",\n        node: locate.ENode(body),\n        binds: locate.pattern_binds(pat),\n      },\n    ],\n    ast.Loop(b) => [locate.kid(\"body\", locate.ENode(b))],\n    ast.ExprStmt(x) => [locate.kid(\"value\", locate.ENode(x))],\n    ast.Assert(x) => [locate.kid(\"value\", locate.ENode(x))],\n    ast.Invariant(x) | ast.Decreases(x) => [locate.kid(\"value\", locate.ENode(x))],\n    _ => [],\n  }\n}"},{"name":"locate.replaced","kind":"fn","old":"db070499f8bcf594","new":"e39e63a3a0334b59","interface_changed":false,"affected":[],"module":"locate","text":"/// `n` (at `path`) with each node whose path is in `names` replaced by its\n/// stand-in name.\nfn replaced(\n  n: locate.Node,\n  path: String,\n  names: Dict[String, String],\n) -> locate.Node {\n  match get(names, path) {\n    Some(name) => return locate.stand_in(n, name),\n    None => (),\n  }\n  if !keys(names).any(k -> starts_with(k, path + \"/\")) {\n    return n\n  }\n  at := (label: String, x: locate.Node) ->\n    locate.replaced(x, locate.joined(path, label), names)\n  match n {\n    locate.ENode(e) => locate.ENode(locate.replaced_expr(e, path, names)),\n    locate.PNode(p) => locate.PNode(\n      match p {\n        ast.CtorPattern { name, args } => ast.CtorPattern {\n          name,\n          args: match args {\n            ast.PositionalPats(ps) => ast.PositionalPats([locate.as_pattern(\n              at(\"args/\" + to_string(i), locate.PNode(x)),\n              x,\n            ) for (i, x) in enumerate(ps)]),\n            ast.TypePats(ps) => ast.TypePats([locate.as_pattern(\n              at(\"args/\" + to_string(i), locate.PNode(x)),\n              x,\n            ) for (i, x) in enumerate(ps)]),\n            ast.RecordPats { fields, rest } => ast.RecordPats { fields: fields.map(\n              f -> (f.0, locate.as_pattern(\n                at(\"args/\" + f.0, locate.PNode(f.1)),\n                f.1,\n              )),\n            ), rest },\n            other => other,\n          },\n        },\n        ast.ListPat { items, rest } => ast.ListPat { items: [locate.as_pattern(\n          at(\"items/\" + to_string(i), locate.PNode(x)),\n          x,\n        ) for (i, x) in enumerate(items)], rest },\n        ast.TuplePat(ps) => ast.TuplePat(\n          [locate.as_pattern(at(to_string(i), locate.PNode(x)), x) for (i, x) in enumerate(ps)],\n        ),\n        ast.CondPat(c) => ast.CondPat(locate.as_expr(at(\"cond\", locate.ENode(c)), c)),\n        ast.OrPat(ps) => ast.OrPat(\n          [locate.as_pattern(at(to_string(i), locate.PNode(x)), x) for (i, x) in enumerate(ps)],\n        ),\n        ast.ForPat { arm, each, list } => ast.ForPat {\n          arm: locate.as_pattern(at(\"arm\", locate.PNode(arm)), arm),\n          each: locate.as_pattern(at(\"each\", locate.PNode(each)), each),\n          list: locate.as_expr(at(\"list\", locate.ENode(list)), list),\n        },\n        other => other,\n      },\n    ),\n    locate.TNode(t) => locate.TNode(locate.replaced_type(t, path, names)),\n    locate.SNode(s) => locate.SNode(\n      match s {\n        ast.Let { pat, ty, value } => ast.Let {\n          pat: locate.as_pattern(at(\"pat\", locate.PNode(pat)), pat),\n          ty: match ty {\n            Some(x) => Some(locate.as_type(at(\"ty\", locate.TNode(x)), x)),\n            None => None,\n          },\n          value: locate.as_expr(at(\"value\", locate.ENode(value)), value),\n        },\n        ast.VarDecl { name, ty, value } => ast.VarDecl { name, ty: match ty {\n          Some(x) => Some(locate.as_type(at(\"ty\", locate.TNode(x)), x)),\n          None => None,\n        }, value: locate.as_expr(at(\"value\", locate.ENode(value)), value) },\n        ast.Assign { place, value } => ast.Assign {\n          place: locate.as_expr(at(\"place\", locate.ENode(place)), place),\n          value: locate.as_expr(at(\"value\", locate.ENode(value)), value),\n        },\n        ast.While { cond, body } => ast.While {\n          cond: locate.as_expr(at(\"cond\", locate.ENode(cond)), cond),\n          body: locate.as_expr(at(\"body\", locate.ENode(body)), body),\n        },\n        ast.For { pat, iter, body } => ast.For {\n          pat: locate.as_pattern(at(\"pat\", locate.PNode(pat)), pat),\n          iter: locate.as_expr(at(\"iter\", locate.ENode(iter)), iter),\n          body: locate.as_expr(at(\"body\", locate.ENode(body)), body),\n        },\n        ast.ComptimeFor { pat, iter, body } => ast.ComptimeFor {\n          pat: locate.as_pattern(at(\"pat\", locate.PNode(pat)), pat),\n          iter: locate.as_expr(at(\"iter\", locate.ENode(iter)), iter),\n          body: locate.as_expr(at(\"body\", locate.ENode(body)), body),\n        },\n        ast.Loop(b) => ast.Loop(locate.as_expr(at(\"body\", locate.ENode(b)), b)),\n        ast.Assert(x) => ast.Assert(locate.as_expr(at(\"value\", locate.ENode(x)), x)),\n        ast.Invariant(x) => ast.Invariant(\n          locate.as_expr(at(\"value\", locate.ENode(x)), x),\n        ),\n        ast.Decreases(x) => ast.Decreases(\n          locate.as_expr(at(\"value\", locate.ENode(x)), x),\n        ),\n        ast.AssertBy { cond, proof } => ast.AssertBy {\n          cond: locate.as_expr(at(\"cond\", locate.ENode(cond)), cond),\n          proof: locate.as_expr(at(\"proof\", locate.ENode(proof)), proof),\n        },\n        other => other,\n      },\n    ),\n  }\n}","old_text":"/// `n` (at `path`) with each node whose path is in `names` replaced by its\n/// stand-in name.\nfn replaced(\n  n: locate.Node,\n  path: String,\n  names: Dict[String, String],\n) -> locate.Node {\n  match get(names, path) {\n    Some(name) => return locate.stand_in(n, name),\n    None => (),\n  }\n  if !keys(names).any(k -> starts_with(k, path + \"/\")) {\n    return n\n  }\n  at := (label: String, x: locate.Node) ->\n    locate.replaced(x, locate.joined(path, label), names)\n  match n {\n    locate.ENode(e) => locate.ENode(locate.replaced_expr(e, path, names)),\n    locate.PNode(p) => locate.PNode(\n      match p {\n        ast.CtorPattern { name, args } => ast.CtorPattern {\n          name,\n          args: match args {\n            ast.PositionalPats(ps) => ast.PositionalPats([locate.as_pattern(\n              at(\"args/\" + to_string(i), locate.PNode(x)),\n              x,\n            ) for (i, x) in enumerate(ps)]),\n            ast.TypePats(ps) => ast.TypePats([locate.as_pattern(\n              at(\"args/\" + to_string(i), locate.PNode(x)),\n              x,\n            ) for (i, x) in enumerate(ps)]),\n            ast.RecordPats { fields, rest } => ast.RecordPats { fields: fields.map(\n              f -> (f.0, locate.as_pattern(\n                at(\"args/\" + f.0, locate.PNode(f.1)),\n                f.1,\n              )),\n            ), rest },\n            other => other,\n          },\n        },\n        ast.ListPat { items, rest } => ast.ListPat { items: [locate.as_pattern(\n          at(\"items/\" + to_string(i), locate.PNode(x)),\n          x,\n        ) for (i, x) in enumerate(items)], rest },\n        ast.TuplePat(ps) => ast.TuplePat(\n          [locate.as_pattern(at(to_string(i), locate.PNode(x)), x) for (i, x) in enumerate(ps)],\n        ),\n        ast.CondPat(c) => ast.CondPat(locate.as_expr(at(\"cond\", locate.ENode(c)), c)),\n        ast.OrPat(ps) => ast.OrPat(\n          [locate.as_pattern(at(to_string(i), locate.PNode(x)), x) for (i, x) in enumerate(ps)],\n        ),\n        ast.ForPat { arm, each, list } => ast.ForPat {\n          arm: locate.as_pattern(at(\"arm\", locate.PNode(arm)), arm),\n          each: locate.as_pattern(at(\"each\", locate.PNode(each)), each),\n          list: locate.as_expr(at(\"list\", locate.ENode(list)), list),\n        },\n        other => other,\n      },\n    ),\n    locate.TNode(t) => locate.TNode(locate.replaced_type(t, path, names)),\n    locate.SNode(s) => locate.SNode(\n      match s {\n        ast.Let { pat, ty, value } => ast.Let {\n          pat: locate.as_pattern(at(\"pat\", locate.PNode(pat)), pat),\n          ty: match ty {\n            Some(x) => Some(locate.as_type(at(\"ty\", locate.TNode(x)), x)),\n            None => None,\n          },\n          value: locate.as_expr(at(\"value\", locate.ENode(value)), value),\n        },\n        ast.VarDecl { name, ty, value } => ast.VarDecl { name, ty: match ty {\n          Some(x) => Some(locate.as_type(at(\"ty\", locate.TNode(x)), x)),\n          None => None,\n        }, value: locate.as_expr(at(\"value\", locate.ENode(value)), value) },\n        ast.Assign { place, value } => ast.Assign {\n          place: locate.as_expr(at(\"place\", locate.ENode(place)), place),\n          value: locate.as_expr(at(\"value\", locate.ENode(value)), value),\n        },\n        ast.While { cond, body } => ast.While {\n          cond: locate.as_expr(at(\"cond\", locate.ENode(cond)), cond),\n          body: locate.as_expr(at(\"body\", locate.ENode(body)), body),\n        },\n        ast.For { pat, iter, body } => ast.For {\n          pat: locate.as_pattern(at(\"pat\", locate.PNode(pat)), pat),\n          iter: locate.as_expr(at(\"iter\", locate.ENode(iter)), iter),\n          body: locate.as_expr(at(\"body\", locate.ENode(body)), body),\n        },\n        ast.ComptimeFor { pat, iter, body } => ast.ComptimeFor {\n          pat: locate.as_pattern(at(\"pat\", locate.PNode(pat)), pat),\n          iter: locate.as_expr(at(\"iter\", locate.ENode(iter)), iter),\n          body: locate.as_expr(at(\"body\", locate.ENode(body)), body),\n        },\n        ast.Loop(b) => ast.Loop(locate.as_expr(at(\"body\", locate.ENode(b)), b)),\n        ast.Assert(x) => ast.Assert(locate.as_expr(at(\"value\", locate.ENode(x)), x)),\n        ast.Invariant(x) => ast.Invariant(\n          locate.as_expr(at(\"value\", locate.ENode(x)), x),\n        ),\n        ast.Decreases(x) => ast.Decreases(\n          locate.as_expr(at(\"value\", locate.ENode(x)), x),\n        ),\n        other => other,\n      },\n    ),\n  }\n}"}]}
{"id":"cd9ffb88afc8ebf8","time":1795664920,"message":"edit","changes":[{"name":"declarations.use ast","kind":"use","old":"2a95feb2ff513797","new":"b2ec2dfb965a4ae3","interface_changed":true,"affected":[],"module":"declarations","text":"// declarations: the checker's errors about names, type arguments, `Self`,\n// `break` and `continue`, impls against their traits, and constructor patterns.\n\nfrom ast use Decl, TypeDecl, Field, FnDecl, Param, Bound, TypeExpr, Expr,\n  CtorArgs, LamParam, Arm, BinOp, Stmt, Pattern, TypeDef, FnDef, TraitDef,\n  ImplDef, ExternDef, CapabilityDef, Alias, RecordBody, SumBody, NoPayload,\n  Positional, RecordPayload, MemberType, ExternFn, ExternType, ExternStatic,\n  ExternThreadStatic, Named, FnType, UnitType, Refined, UnionType, IntLit,\n  BigIntLit, FloatLit, TupleExpr, StrLit, BoolLit, UnitExpr, Var, ListExpr,\n  CtorExpr, Call, MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr,\n  MatchExpr, MutExpr, Block, Return, Try, Except, Interp, Range, Index, Comp,\n  DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn, Await, NoArgs,\n  PositionalArgs, RecordArgs, UpdateArgs, ListComp, TextPart, ValuePart, Add,\n  Sub, Mul, Div, Mod, Equal, NotEqual, Less, LessEq, Greater, GreaterEq, And,\n  Or, Implies, Neg, Not, TryResult, TryOption, Let, VarDecl, Assign, While, For,\n  Loop, ExprStmt, Assert, ComptimeFor, Invariant, Decreases, Bind, CtorPattern,\n  ListPat, TuplePat, OrPat, ForPat, NoPats, PositionalPats, RecordPats,\n  TypePats, UseDef, Break, Continue, ImplDecl, TraitMethod, C, AssertBy, Calc","old_text":"// declarations: the checker's errors about names, type arguments, `Self`,\n// `break` and `continue`, impls against their traits, and constructor patterns.\n\nfrom ast use Decl, TypeDecl, Field, FnDecl, Param, Bound, TypeExpr, Expr,\n  CtorArgs, LamParam, Arm, BinOp, Stmt, Pattern, TypeDef, FnDef, TraitDef,\n  ImplDef, ExternDef, CapabilityDef, Alias, RecordBody, SumBody, NoPayload,\n  Positional, RecordPayload, MemberType, ExternFn, ExternType, ExternStatic,\n  ExternThreadStatic, Named, FnType, UnitType, Refined, UnionType, IntLit,\n  BigIntLit, FloatLit, TupleExpr, StrLit, BoolLit, UnitExpr, Var, ListExpr,\n  CtorExpr, Call, MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr,\n  MatchExpr, MutExpr, Block, Return, Try, Except, Interp, Range, Index, Comp,\n  DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn, Await, NoArgs,\n  PositionalArgs, RecordArgs, UpdateArgs, ListComp, TextPart, ValuePart, Add,\n  Sub, Mul, Div, Mod, Equal, NotEqual, Less, LessEq, Greater, GreaterEq, And,\n  Or, Implies, Neg, Not, TryResult, TryOption, Let, VarDecl, Assign, While, For,\n  Loop, ExprStmt, Assert, ComptimeFor, Invariant, Decreases, Bind, CtorPattern,\n  ListPat, TuplePat, OrPat, ForPat, NoPats, PositionalPats, RecordPats,\n  TypePats, UseDef, Break, Continue, ImplDecl, TraitMethod, C"},{"name":"declarations.children","kind":"fn","old":"4a810a6ec28ad464","new":"d0254dde473a0b10","interface_changed":false,"affected":[],"module":"declarations","text":"/// An expression's direct parts, a block's statement expressions included.\nfn children(e: ast.Expr) -> List[ast.Expr] {\n  match e {\n    ast.TupleExpr(es) => es,\n    ast.ListExpr(es) => es,\n    ast.CtorExpr { args, .. } => match args {\n      ast.NoArgs => [],\n      ast.PositionalArgs(es) => es,\n      ast.RecordArgs(fs) => fs.map(f -> f.1),\n      ast.UpdateArgs { base, fields } => [base] + fields.map(f -> f.1),\n    },\n    ast.Call { callee, args } => [callee] + args,\n    ast.MethodCall { recv, args, .. } => [recv] + args,\n    ast.FieldOf { base, .. } => [base],\n    ast.Lambda { body, .. } => [body],\n    ast.Binary { left, right, .. } => [left, right],\n    ast.Unary { operand, .. } => [operand],\n    ast.IsExpr { value, .. } => [value],\n    ast.IfExpr { cond, then, otherwise } => [cond, then, otherwise],\n    ast.MatchExpr { scrutinee, arms, .. } => [scrutinee] + arms.map(a -> a.body),\n    ast.MutExpr(x) => [x],\n    ast.Block { stmts, last } => {\n      mut out := []\n      for st in stmts {\n        out += match st {\n          ast.Let { value, .. } => [value],\n          ast.VarDecl { value, .. } => [value],\n          ast.Assign { place, value } => [place, value],\n          ast.While { cond, body } => [cond, body],\n          ast.For { iter, body, .. } => [iter, body],\n          ast.ComptimeFor { iter, body, .. } => [iter, body],\n          ast.Loop(b) => [b],\n          ast.ExprStmt(x) => [x],\n          ast.Assert(x) | ast.Invariant(x) | ast.Decreases(x) => [x],\n          ast.AssertBy { cond, proof } => [cond, proof],\n          ast.Calc(xs) => xs,\n          _ => [],\n        }\n      }\n      out + [last]\n    },\n    ast.Return(x) => [x],\n    ast.Try { value, .. } => [value],\n    ast.Except { value, fallback, .. } => [value, fallback],\n    ast.Interp(parts) => {\n      mut out := []\n      for pt in parts {\n        match pt {\n          ast.ValuePart { value, .. } => mut out.push(value),\n          ast.TextPart(_) => (),\n        }\n      }\n      out\n    },\n    ast.Range { lo, hi, .. } => {\n      mut out := []\n      for x in [lo, hi] {\n        match x {\n          Some(v) => mut out.push(v),\n          None => (),\n        }\n      }\n      out\n    },\n    ast.Index { base, index } => [base, index],\n    ast.Comp { elem, fors, .. } => {\n      mut out := []\n      for f in fors {\n        mut out.push(f.iter)\n        match f.cond {\n          Some(c) => mut out.push(c),\n          None => (),\n        }\n      }\n      out + [elem]\n    },\n    ast.DictExpr { entries, .. } => {\n      mut out := []\n      for kv in entries {\n        out += [kv.0, kv.1]\n      }\n      out\n    },\n    ast.SetExpr { elems, .. } => elems,\n    ast.Fallback { value, fallback } => [value, fallback],\n    ast.Comptime(x) => [x],\n    ast.Old(x) => [x],\n    ast.Spread(x) => [x],\n    ast.Assumed(x) => [x],\n    ast.Scope(x) => [x],\n    ast.Spawn(x) => [x],\n    ast.Await(x) => [x],\n    _ => [],\n  }\n}","old_text":"/// An expression's direct parts, a block's statement expressions included.\nfn children(e: ast.Expr) -> List[ast.Expr] {\n  match e {\n    ast.TupleExpr(es) => es,\n    ast.ListExpr(es) => es,\n    ast.CtorExpr { args, .. } => match args {\n      ast.NoArgs => [],\n      ast.PositionalArgs(es) => es,\n      ast.RecordArgs(fs) => fs.map(f -> f.1),\n      ast.UpdateArgs { base, fields } => [base] + fields.map(f -> f.1),\n    },\n    ast.Call { callee, args } => [callee] + args,\n    ast.MethodCall { recv, args, .. } => [recv] + args,\n    ast.FieldOf { base, .. } => [base],\n    ast.Lambda { body, .. } => [body],\n    ast.Binary { left, right, .. } => [left, right],\n    ast.Unary { operand, .. } => [operand],\n    ast.IsExpr { value, .. } => [value],\n    ast.IfExpr { cond, then, otherwise } => [cond, then, otherwise],\n    ast.MatchExpr { scrutinee, arms, .. } => [scrutinee] + arms.map(a -> a.body),\n    ast.MutExpr(x) => [x],\n    ast.Block { stmts, last } => {\n      mut out := []\n      for st in stmts {\n        out += match st {\n          ast.Let { value, .. } => [value],\n          ast.VarDecl { value, .. } => [value],\n          ast.Assign { place, value } => [place, value],\n          ast.While { cond, body } => [cond, body],\n          ast.For { iter, body, .. } => [iter, body],\n          ast.ComptimeFor { iter, body, .. } => [iter, body],\n          ast.Loop(b) => [b],\n          ast.ExprStmt(x) => [x],\n          ast.Assert(x) | ast.Invariant(x) | ast.Decreases(x) => [x],\n          _ => [],\n        }\n      }\n      out + [last]\n    },\n    ast.Return(x) => [x],\n    ast.Try { value, .. } => [value],\n    ast.Except { value, fallback, .. } => [value, fallback],\n    ast.Interp(parts) => {\n      mut out := []\n      for pt in parts {\n        match pt {\n          ast.ValuePart { value, .. } => mut out.push(value),\n          ast.TextPart(_) => (),\n        }\n      }\n      out\n    },\n    ast.Range { lo, hi, .. } => {\n      mut out := []\n      for x in [lo, hi] {\n        match x {\n          Some(v) => mut out.push(v),\n          None => (),\n        }\n      }\n      out\n    },\n    ast.Index { base, index } => [base, index],\n    ast.Comp { elem, fors, .. } => {\n      mut out := []\n      for f in fors {\n        mut out.push(f.iter)\n        match f.cond {\n          Some(c) => mut out.push(c),\n          None => (),\n        }\n      }\n      out + [elem]\n    },\n    ast.DictExpr { entries, .. } => {\n      mut out := []\n      for kv in entries {\n        out += [kv.0, kv.1]\n      }\n      out\n    },\n    ast.SetExpr { elems, .. } => elems,\n    ast.Fallback { value, fallback } => [value, fallback],\n    ast.Comptime(x) => [x],\n    ast.Old(x) => [x],\n    ast.Spread(x) => [x],\n    ast.Assumed(x) => [x],\n    ast.Scope(x) => [x],\n    ast.Spawn(x) => [x],\n    ast.Await(x) => [x],\n    _ => [],\n  }\n}"}]}
{"id":"08eab182cecb7fff","time":1795664943,"message":"edit","changes":[{"name":"exhaustive.use ast","kind":"use","old":"76f9ee0edb1a7bd2","new":"29fb0c7e52aad222","interface_changed":true,"affected":[],"module":"exhaustive","text":"// exhaustive: whether a script's `match` covers every value, judged on the\n// syntax tree for the simple cases. The rest is left to `strata check`.\n\nfrom ast use Decl, Bound, TypeExpr, Expr, Arm, Stmt, Pattern, TypeDef, FnDef,\n  Alias, RecordBody, SumBody, MemberType, Named, TupleExpr, Var, ListExpr,\n  CtorExpr, Call, MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr,\n  MatchExpr, MutExpr, Block, Return, Try, Except, Interp, Range, Index, Comp,\n  DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn, Await, NoArgs,\n  PositionalArgs, RecordArgs, UpdateArgs, TextPart, ValuePart, Equal, NotEqual,\n  Less, LessEq, Greater, GreaterEq, And, Or, Let, VarDecl, Assign, While, For,\n  Loop, ExprStmt, Assert, ComptimeFor, Invariant, Decreases, Wild, Bind,\n  BoolPat, CtorPattern, ListPat, TuplePat, OrPat, ForPat, NoPats,\n  PositionalPats, RecordPats, TypePats, IntPat, StrPat, AssertBy","old_text":"// exhaustive: whether a script's `match` covers every value, judged on the\n// syntax tree for the simple cases. The rest is left to `strata check`.\n\nfrom ast use Decl, Bound, TypeExpr, Expr, Arm, Stmt, Pattern, TypeDef, FnDef,\n  Alias, RecordBody, SumBody, MemberType, Named, TupleExpr, Var, ListExpr,\n  CtorExpr, Call, MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr,\n  MatchExpr, MutExpr, Block, Return, Try, Except, Interp, Range, Index, Comp,\n  DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn, Await, NoArgs,\n  PositionalArgs, RecordArgs, UpdateArgs, TextPart, ValuePart, Equal, NotEqual,\n  Less, LessEq, Greater, GreaterEq, And, Or, Let, VarDecl, Assign, While, For,\n  Loop, ExprStmt, Assert, ComptimeFor, Invariant, Decreases, Wild, Bind,\n  BoolPat, CtorPattern, ListPat, TuplePat, OrPat, ForPat, NoPats,\n  PositionalPats, RecordPats, TypePats, IntPat, StrPat"},{"name":"exhaustive.seen_block","kind":"fn","old":"7ba076dccab0f886","new":"434b5d50d95d6702","interface_changed":false,"affected":[],"module":"exhaustive","text":"/// What a block's statements and its last expression hold.\nfn seen_block(\n  stmts: List[ast.Stmt],\n  last: ast.Expr,\n  hidden: Set[String],\n  out: List[exhaustive.Seen],\n) -> List[exhaustive.Seen] {\n  mut acc := out\n  for s in stmts {\n    match s {\n      ast.Let { pat, value, .. } => {\n        acc = exhaustive.bound_all(\n          exhaustive.pattern_names(pat, []),\n          exhaustive.seen_in(value, hidden, acc),\n        )\n      },\n      ast.VarDecl { name, value, .. } => {\n        acc = exhaustive.seen_in(value, hidden, acc)\n          + [exhaustive.Bound(name)]\n      },\n      ast.Assign { place, value } => {\n        acc = exhaustive.seen_in(\n          value,\n          hidden,\n          exhaustive.seen_in(place, hidden, acc),\n        )\n        acc = match place {\n          ast.Var(x) => acc + [exhaustive.Bound(x)],\n          _ => acc,\n        }\n      },\n      ast.While { cond, body } => {\n        acc = exhaustive.seen_in(\n          body,\n          hidden,\n          exhaustive.seen_in(cond, hidden, acc),\n        )\n      },\n      ast.For { pat, iter, body } => {\n        acc = exhaustive.seen_in(body, hidden, exhaustive.bound_all(\n          exhaustive.pattern_names(pat, []),\n          exhaustive.seen_in(iter, hidden, acc),\n        ))\n      },\n      ast.ComptimeFor { pat, iter, body } => {\n        acc = exhaustive.seen_in(body, hidden, exhaustive.bound_all(\n          exhaustive.pattern_names(pat, []),\n          exhaustive.seen_in(iter, hidden, acc),\n        ))\n      },\n      ast.Loop(b) => {\n        acc = exhaustive.seen_in(b, hidden, acc)\n      },\n      ast.ExprStmt(x) => {\n        acc = exhaustive.seen_in(x, hidden, acc)\n      },\n      ast.Assert(x) => {\n        acc = exhaustive.seen_in(x, hidden, acc)\n      },\n      ast.Invariant(x) | ast.Decreases(x) => {\n        acc = exhaustive.seen_in(x, hidden, acc)\n      },\n      ast.AssertBy { cond, proof } => {\n        acc = exhaustive.seen_in(\n          proof,\n          hidden,\n          exhaustive.seen_in(cond, hidden, acc),\n        )\n      },\n      _ => (),\n    }\n  }\n  exhaustive.seen_in(last, hidden, acc)\n}","old_text":"/// What a block's statements and its last expression hold.\nfn seen_block(\n  stmts: List[ast.Stmt],\n  last: ast.Expr,\n  hidden: Set[String],\n  out: List[exhaustive.Seen],\n) -> List[exhaustive.Seen] {\n  mut acc := out\n  for s in stmts {\n    match s {\n      ast.Let { pat, value, .. } => {\n        acc = exhaustive.bound_all(\n          exhaustive.pattern_names(pat, []),\n          exhaustive.seen_in(value, hidden, acc),\n        )\n      },\n      ast.VarDecl { name, value, .. } => {\n        acc = exhaustive.seen_in(value, hidden, acc)\n          + [exhaustive.Bound(name)]\n      },\n      ast.Assign { place, value } => {\n        acc = exhaustive.seen_in(\n          value,\n          hidden,\n          exhaustive.seen_in(place, hidden, acc),\n        )\n        acc = match place {\n          ast.Var(x) => acc + [exhaustive.Bound(x)],\n          _ => acc,\n        }\n      },\n      ast.While { cond, body } => {\n        acc = exhaustive.seen_in(\n          body,\n          hidden,\n          exhaustive.seen_in(cond, hidden, acc),\n        )\n      },\n      ast.For { pat, iter, body } => {\n        acc = exhaustive.seen_in(body, hidden, exhaustive.bound_all(\n          exhaustive.pattern_names(pat, []),\n          exhaustive.seen_in(iter, hidden, acc),\n        ))\n      },\n      ast.ComptimeFor { pat, iter, body } => {\n        acc = exhaustive.seen_in(body, hidden, exhaustive.bound_all(\n          exhaustive.pattern_names(pat, []),\n          exhaustive.seen_in(iter, hidden, acc),\n        ))\n      },\n      ast.Loop(b) => {\n        acc = exhaustive.seen_in(b, hidden, acc)\n      },\n      ast.ExprStmt(x) => {\n        acc = exhaustive.seen_in(x, hidden, acc)\n      },\n      ast.Assert(x) => {\n        acc = exhaustive.seen_in(x, hidden, acc)\n      },\n      ast.Invariant(x) | ast.Decreases(x) => {\n        acc = exhaustive.seen_in(x, hidden, acc)\n      },\n      _ => (),\n    }\n  }\n  exhaustive.seen_in(last, hidden, acc)\n}"}]}
{"id":"cd8c5dbf784bdb3b","time":1795664945,"message":"edit","changes":[{"name":"check.errors_block","kind":"fn","old":"d41ab5438ea5116b","new":"bbdfc2d45c46ee48","interface_changed":false,"affected":[],"module":"check","text":"fn errors_block(\n  stmts: List[ast.Stmt],\n  last: ast.Expr,\n  env: Set[String],\n  c: check.Known,\n  out: List[String],\n) -> List[String] {\n  mut seen := env\n  mut acc := out\n  for s in stmts {\n    match s {\n      ast.Let { pat, value, .. } => {\n        acc = check.errors_in(value, seen, c, acc)\n        seen = check.pattern_binds(pat, seen)\n      },\n      ast.VarDecl { name, value, .. } => {\n        acc = check.errors_in(value, seen, c, acc)\n        mut seen.insert(name)\n      },\n      ast.Assign { place, value } => {\n        acc = check.errors_in(\n          value,\n          seen,\n          c,\n          check.errors_in(place, seen, c, acc),\n        )\n      },\n      ast.While { cond, body } => {\n        acc = check.errors_in(\n          body,\n          seen,\n          c,\n          check.errors_in(cond, seen, c, acc),\n        )\n      },\n      ast.For { pat, iter, body } => {\n        acc = check.errors_in(\n          body,\n          check.pattern_binds(pat, seen),\n          c,\n          check.errors_in(iter, seen, c, acc),\n        )\n      },\n      ast.ComptimeFor { pat, iter, body } => {\n        acc = check.errors_in(\n          body,\n          check.pattern_binds(pat, seen),\n          c,\n          check.errors_in(iter, seen, c, acc),\n        )\n      },\n      ast.Loop(b) => {\n        acc = check.errors_in(b, seen, c, acc)\n      },\n      ast.ExprStmt(x) => {\n        acc = check.errors_in(x, seen, c, acc)\n      },\n      ast.Assert(x) | ast.Invariant(x) | ast.Decreases(x) => {\n        acc = check.errors_in(x, seen, c, acc)\n      },\n      ast.AssertBy { cond, proof } => {\n        acc = check.errors_in(\n          proof,\n          seen,\n          c,\n          check.errors_in(cond, seen, c, acc),\n        )\n      },\n      ast.Calc(xs) => {\n        for x in ast.calc_steps(xs) {\n          acc = check.errors_in(x, seen, c, acc)\n        }\n      },\n      _ => (),\n    }\n  }\n  check.errors_in(last, seen, c, acc)\n}","old_text":"fn errors_block(\n  stmts: List[ast.Stmt],\n  last: ast.Expr,\n  env: Set[String],\n  c: check.Known,\n  out: List[String],\n) -> List[String] {\n  mut seen := env\n  mut acc := out\n  for s in stmts {\n    match s {\n      ast.Let { pat, value, .. } => {\n        acc = check.errors_in(value, seen, c, acc)\n        seen = check.pattern_binds(pat, seen)\n      },\n      ast.VarDecl { name, value, .. } => {\n        acc = check.errors_in(value, seen, c, acc)\n        mut seen.insert(name)\n      },\n      ast.Assign { place, value } => {\n        acc = check.errors_in(\n          value,\n          seen,\n          c,\n          check.errors_in(place, seen, c, acc),\n        )\n      },\n      ast.While { cond, body } => {\n        acc = check.errors_in(\n          body,\n          seen,\n          c,\n          check.errors_in(cond, seen, c, acc),\n        )\n      },\n      ast.For { pat, iter, body } => {\n        acc = check.errors_in(\n          body,\n          check.pattern_binds(pat, seen),\n          c,\n          check.errors_in(iter, seen, c, acc),\n        )\n      },\n      ast.ComptimeFor { pat, iter, body } => {\n        acc = check.errors_in(\n          body,\n          check.pattern_binds(pat, seen),\n          c,\n          check.errors_in(iter, seen, c, acc),\n        )\n      },\n      ast.Loop(b) => {\n        acc = check.errors_in(b, seen, c, acc)\n      },\n      ast.ExprStmt(x) => {\n        acc = check.errors_in(x, seen, c, acc)\n      },\n      ast.Assert(x) | ast.Invariant(x) | ast.Decreases(x) => {\n        acc = check.errors_in(x, seen, c, acc)\n      },\n      _ => (),\n    }\n  }\n  check.errors_in(last, seen, c, acc)\n}"},{"name":"check.infer_block","kind":"fn","old":"655cbfd32d53512d","new":"ced6b92c9851c5f8","interface_changed":false,"affected":[],"module":"check","text":"/// The type of a block's statements and last expression. Any type when it\n/// ends in `break`, `continue` or `return`, since it never gives a value.\nfn infer_block(\n  mut i: check.Inf,\n  stmts: List[ast.Stmt],\n  last: ast.Expr,\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  mut seen := env\n  if len(stmts.filter(s -> s is ast.Decreases)) > 1 {\n    check.error(\n      mut i,\n      \"more than one `decreases` clause: write one, `decreases (a, b)` for measures compared in order\",\n    )\n  }\n  for s in stmts {\n    match s {\n      ast.Let { pat, ty, value } => {\n        ann := match ty {\n          Some(a) => Some(check.lower(i.types, i.tparams, a)),\n          None => None,\n        }\n        t := check.infer(mut i, value, seen, ann)\n        match ann {\n          Some(a) => check.expect(mut i, a, t, \"let annotation\"),\n          None => (),\n        }\n        if pat is ast.Wild {\n          mut i.dropped.push((value, t))\n        }\n        // any pattern's value: a tuple's, for codegen\n        mut i.lets.push(\n          (match pat {\n            ast.Bind(n) => n,\n            _ => \"\",\n          }, ann ?? t),\n        )\n        seen = match pat {\n          ast.Bind(n) => {\n            mut copy := seen\n            mut copy.insert(n, ann ?? t)\n            copy\n          },\n          _ => check.bind_typed(mut i, seen, pat, ann ?? t),\n        }\n      },\n      ast.VarDecl { name, ty, value } => {\n        ann := match ty {\n          Some(a) => Some(check.lower(i.types, i.tparams, a)),\n          None => None,\n        }\n        t := check.infer(mut i, value, seen, ann)\n        match ann {\n          Some(a) => check.expect(mut i, a, t, \"let annotation\"),\n          None => (),\n        }\n        mut i.lets.push((name, ann ?? t))\n        mut seen.insert(name, ann ?? t)\n        // a refined type written: what the variable may hold\n        match ty {\n          Some(w) => mut i.written.insert(name, w),\n          None => (),\n        }\n      },\n      ast.Assign { place, value } => {\n        // a variable declared outside the `scope` holding or getting a handle\n        root := check.root_var(place)\n        // a variable assigned has its declared type, even where a `match` narrows\n        // it: `best = match best { None => Some(x), .. }` says what\n        // `mut best := None` holds\n        pt := match place {\n          ast.Var(x) => match get(seen, x) {\n            Some(t) => t,\n            None => check.infer(mut i, place, seen, None),\n          },\n          _ => check.infer(mut i, place, seen, None),\n        }\n        if check.outside_scope(i, root)\n          && check.holds_task(\n            check.res(i, get(seen, root) ?? check.TAny),\n          ) {\n          check.error(\n            mut i,\n            \"`\"\n              + root\n              + \"` is declared outside the `scope`, so a task's handle can't be stored in it\",\n          )\n        }\n        // `xs[i] = v`: the element's type, said as written\n        et := if check.element_assigned(mut i, place, value, seen) {\n          pt\n        } else {\n          vt := check.infer(mut i, value, seen, Some(pt))\n          check.expect(mut i, pt, vt, \"assignment\")\n          vt\n        }\n        if check.outside_scope(i, root)\n          && check.holds_task(check.res(i, et)) {\n          check.error(\n            mut i,\n            \"`\"\n              + root\n              + \"` is declared outside the `scope`, so a task's handle can't be stored in it\",\n          )\n        }\n      },\n      ast.While { cond, body } => {\n        ct := check.infer(mut i, cond, seen, None)\n        check.expect(mut i, check.TBool, ct, \"while condition\")\n        check.infer(mut i, body, seen, None)\n      },\n      ast.For { pat, iter, body } => {\n        it := check.infer(mut i, iter, seen, None)\n        check.not_iterable(mut i, it)\n        mut i.iters.push(it)\n        // the loop's variable isn't in scope in its invariants: they hold between\n        // elements too\n        bound := check.pattern_binds(pat, Set[String] {})\n        invs := match body {\n          ast.Block { stmts, .. } => [x for s in stmts where s is ast.Invariant for x in match s {\n            ast.Invariant(x) => [x],\n            _ => [],\n          }],\n          _ => [],\n        }\n        if match body {\n          ast.Block { stmts, .. } => stmts.any(s -> s is ast.Decreases),\n          _ => false,\n        } {\n          check.error(\n            mut i,\n            \"a `for` loop has no `decreases` clause: it ends on its own (the clause is for `while` and `loop`)\",\n          )\n        }\n        mut named: Option[String] = None\n        for x in invs {\n          if named is None {\n            named = check.var_named(x, bound)\n          }\n        }\n        match named {\n          Some(v) => check.error(mut i, \"an invariant of `for \"\n            + text.pattern_text(pat)\n            + \" in …` can't name the loop's variable `\"\n            + v\n            + \"`: it holds before the first element and after the last too\"),\n          None => (),\n        }\n        inner := check.bind_typed(mut i, seen, pat, check.element_of(i, it))\n        check.infer(mut i, body, inner, None)\n      },\n      ast.ComptimeFor { pat, iter, body } => {\n        _ := check.infer(mut i, iter, seen, None)\n        check.infer(\n          mut i,\n          body,\n          check.bind_pattern(seen, pat),\n          None,\n        )\n      },\n      ast.Loop(b) => check.infer(mut i, b, seen, None),\n      ast.ExprStmt(x) => {\n        t := check.infer(mut i, x, seen, None)\n        first := match x {\n          ast.Call { args: [ast.Var(v), ..], .. } => get(seen, v),\n          _ => None,\n        }\n        mut i.discarded.push((x, t, first))\n      },\n      ast.Assert(x) => {\n        t := check.infer(mut i, x, seen, None)\n        check.expect(mut i, check.TBool, t, \"assert\")\n      },\n      ast.Invariant(x) => {\n        t := check.infer(mut i, x, seen, None)\n        check.expect(mut i, check.TBool, t, \"invariant\")\n      },\n      ast.AssertBy { cond, proof } => {\n        t := check.infer(mut i, cond, seen, None)\n        check.expect(mut i, check.TBool, t, \"assert\")\n        _ := check.infer(mut i, proof, seen, None)\n      },\n      ast.Calc(xs) => {\n        for x in ast.calc_steps(xs) {\n          t := check.infer(mut i, x, seen, None)\n          check.expect(mut i, check.TBool, t, \"calc\")\n        }\n      },\n      ast.Decreases(x) => {\n        parts := match x {\n          ast.TupleExpr(xs) => xs,\n          other => [other],\n        }\n        for p in parts {\n          t := check.infer(mut i, p, seen, None)\n          check.expect(mut i, check.TInt, t, \"decreases\")\n        }\n      },\n      _ => (),\n    }\n  }\n  t := check.infer(mut i, last, seen, expected)\n  if last is ast.UnitExpr && check.ends_in_jump(stmts) {\n    check.TAny\n  } else {\n    t\n  }\n}","old_text":"/// The type of a block's statements and last expression. Any type when it\n/// ends in `break`, `continue` or `return`, since it never gives a value.\nfn infer_block(\n  mut i: check.Inf,\n  stmts: List[ast.Stmt],\n  last: ast.Expr,\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  mut seen := env\n  if len(stmts.filter(s -> s is ast.Decreases)) > 1 {\n    check.error(\n      mut i,\n      \"more than one `decreases` clause: write one, `decreases (a, b)` for measures compared in order\",\n    )\n  }\n  for s in stmts {\n    match s {\n      ast.Let { pat, ty, value } => {\n        ann := match ty {\n          Some(a) => Some(check.lower(i.types, i.tparams, a)),\n          None => None,\n        }\n        t := check.infer(mut i, value, seen, ann)\n        match ann {\n          Some(a) => check.expect(mut i, a, t, \"let annotation\"),\n          None => (),\n        }\n        if pat is ast.Wild {\n          mut i.dropped.push((value, t))\n        }\n        // any pattern's value: a tuple's, for codegen\n        mut i.lets.push(\n          (match pat {\n            ast.Bind(n) => n,\n            _ => \"\",\n          }, ann ?? t),\n        )\n        seen = match pat {\n          ast.Bind(n) => {\n            mut copy := seen\n            mut copy.insert(n, ann ?? t)\n            copy\n          },\n          _ => check.bind_typed(mut i, seen, pat, ann ?? t),\n        }\n      },\n      ast.VarDecl { name, ty, value } => {\n        ann := match ty {\n          Some(a) => Some(check.lower(i.types, i.tparams, a)),\n          None => None,\n        }\n        t := check.infer(mut i, value, seen, ann)\n        match ann {\n          Some(a) => check.expect(mut i, a, t, \"let annotation\"),\n          None => (),\n        }\n        mut i.lets.push((name, ann ?? t))\n        mut seen.insert(name, ann ?? t)\n        // a refined type written: what the variable may hold\n        match ty {\n          Some(w) => mut i.written.insert(name, w),\n          None => (),\n        }\n      },\n      ast.Assign { place, value } => {\n        // a variable declared outside the `scope` holding or getting a handle\n        root := check.root_var(place)\n        // a variable assigned has its declared type, even where a `match` narrows\n        // it: `best = match best { None => Some(x), .. }` says what\n        // `mut best := None` holds\n        pt := match place {\n          ast.Var(x) => match get(seen, x) {\n            Some(t) => t,\n            None => check.infer(mut i, place, seen, None),\n          },\n          _ => check.infer(mut i, place, seen, None),\n        }\n        if check.outside_scope(i, root)\n          && check.holds_task(\n            check.res(i, get(seen, root) ?? check.TAny),\n          ) {\n          check.error(\n            mut i,\n            \"`\"\n              + root\n              + \"` is declared outside the `scope`, so a task's handle can't be stored in it\",\n          )\n        }\n        // `xs[i] = v`: the element's type, said as written\n        et := if check.element_assigned(mut i, place, value, seen) {\n          pt\n        } else {\n          vt := check.infer(mut i, value, seen, Some(pt))\n          check.expect(mut i, pt, vt, \"assignment\")\n          vt\n        }\n        if check.outside_scope(i, root)\n          && check.holds_task(check.res(i, et)) {\n          check.error(\n            mut i,\n            \"`\"\n              + root\n              + \"` is declared outside the `scope`, so a task's handle can't be stored in it\",\n          )\n        }\n      },\n      ast.While { cond, body } => {\n        ct := check.infer(mut i, cond, seen, None)\n        check.expect(mut i, check.TBool, ct, \"while condition\")\n        check.infer(mut i, body, seen, None)\n      },\n      ast.For { pat, iter, body } => {\n        it := check.infer(mut i, iter, seen, None)\n        check.not_iterable(mut i, it)\n        mut i.iters.push(it)\n        // the loop's variable isn't in scope in its invariants: they hold between\n        // elements too\n        bound := check.pattern_binds(pat, Set[String] {})\n        invs := match body {\n          ast.Block { stmts, .. } => [x for s in stmts where s is ast.Invariant for x in match s {\n            ast.Invariant(x) => [x],\n            _ => [],\n          }],\n          _ => [],\n        }\n        if match body {\n          ast.Block { stmts, .. } => stmts.any(s -> s is ast.Decreases),\n          _ => false,\n        } {\n          check.error(\n            mut i,\n            \"a `for` loop has no `decreases` clause: it ends on its own (the clause is for `while` and `loop`)\",\n          )\n        }\n        mut named: Option[String] = None\n        for x in invs {\n          if named is None {\n            named = check.var_named(x, bound)\n          }\n        }\n        match named {\n          Some(v) => check.error(mut i, \"an invariant of `for \"\n            + text.pattern_text(pat)\n            + \" in …` can't name the loop's variable `\"\n            + v\n            + \"`: it holds before the first element and after the last too\"),\n          None => (),\n        }\n        inner := check.bind_typed(mut i, seen, pat, check.element_of(i, it))\n        check.infer(mut i, body, inner, None)\n      },\n      ast.ComptimeFor { pat, iter, body } => {\n        _ := check.infer(mut i, iter, seen, None)\n        check.infer(\n          mut i,\n          body,\n          check.bind_pattern(seen, pat),\n          None,\n        )\n      },\n      ast.Loop(b) => check.infer(mut i, b, seen, None),\n      ast.ExprStmt(x) => {\n        t := check.infer(mut i, x, seen, None)\n        first := match x {\n          ast.Call { args: [ast.Var(v), ..], .. } => get(seen, v),\n          _ => None,\n        }\n        mut i.discarded.push((x, t, first))\n      },\n      ast.Assert(x) => {\n        t := check.infer(mut i, x, seen, None)\n        check.expect(mut i, check.TBool, t, \"assert\")\n      },\n      ast.Invariant(x) => {\n        t := check.infer(mut i, x, seen, None)\n        check.expect(mut i, check.TBool, t, \"invariant\")\n      },\n      ast.Decreases(x) => {\n        parts := match x {\n          ast.TupleExpr(xs) => xs,\n          other => [other],\n        }\n        for p in parts {\n          t := check.infer(mut i, p, seen, None)\n          check.expect(mut i, check.TInt, t, \"decreases\")\n        }\n      },\n      _ => (),\n    }\n  }\n  t := check.infer(mut i, last, seen, expected)\n  if last is ast.UnitExpr && check.ends_in_jump(stmts) {\n    check.TAny\n  } else {\n    t\n  }\n}"},{"name":"check.children","kind":"fn","old":"7e25a67b2252a36d","new":"cdd1461784b6e287","interface_changed":false,"affected":[],"module":"check","text":"/// An expression's direct parts, including a block's statements'\n/// expressions.\nfn children(e: ast.Expr) -> List[ast.Expr] {\n  match e {\n    ast.TupleExpr(es) => es,\n    ast.ListExpr(es) => es,\n    ast.CtorExpr { args, .. } => match args {\n      ast.NoArgs => [],\n      ast.PositionalArgs(es) => es,\n      ast.RecordArgs(fs) => fs.map(f -> f.1),\n      ast.UpdateArgs { base, fields } => [base] + fields.map(f -> f.1),\n    },\n    ast.Call { callee, args } => [callee] + args,\n    ast.MethodCall { recv, args, .. } => [recv] + args,\n    ast.FieldOf { base, .. } => [base],\n    ast.Lambda { body, .. } => [body],\n    ast.Binary { left, right, .. } => [left, right],\n    ast.Unary { operand, .. } => [operand],\n    ast.IsExpr { value, .. } => [value],\n    ast.IfExpr { cond, then, otherwise } => [cond, then, otherwise],\n    ast.MatchExpr { scrutinee, arms, .. } => [scrutinee] + arms.map(a -> a.body),\n    ast.MutExpr(x) => [x],\n    ast.Block { stmts, last } => {\n      mut out := []\n      for st in stmts {\n        out += match st {\n          ast.Let { value, .. } => [value],\n          ast.VarDecl { value, .. } => [value],\n          ast.Assign { place, value } => [place, value],\n          ast.While { cond, body } => [cond, body],\n          ast.For { iter, body, .. } => [iter, body],\n          ast.ComptimeFor { iter, body, .. } => [iter, body],\n          ast.Loop(b) => [b],\n          ast.ExprStmt(x) => [x],\n          ast.Assert(x) | ast.Invariant(x) | ast.Decreases(x) => [x],\n          ast.AssertBy { cond, proof } => [cond, proof],\n          ast.Calc(xs) => ast.calc_steps(xs),\n          _ => [],\n        }\n      }\n      out + [last]\n    },\n    ast.Return(x) => [x],\n    ast.Try { value, .. } => [value],\n    ast.Except { value, fallback, .. } => [value, fallback],\n    ast.Interp(parts) => {\n      mut out := []\n      for pt in parts {\n        match pt {\n          ast.ValuePart { value, .. } => mut out.push(value),\n          ast.TextPart(_) => (),\n        }\n      }\n      out\n    },\n    ast.Range { lo, hi, .. } => {\n      mut out := []\n      for x in [lo, hi] {\n        match x {\n          Some(v) => mut out.push(v),\n          None => (),\n        }\n      }\n      out\n    },\n    ast.Index { base, index } => [base, index],\n    ast.Comp { elem, fors, .. } => {\n      mut out := []\n      for f in fors {\n        mut out.push(f.iter)\n        match f.cond {\n          Some(c) => mut out.push(c),\n          None => (),\n        }\n      }\n      out + [elem]\n    },\n    ast.DictExpr { entries, .. } => {\n      mut out := []\n      for kv in entries {\n        out += [kv.0, kv.1]\n      }\n      out\n    },\n    ast.SetExpr { elems, .. } => elems,\n    ast.Fallback { value, fallback } => [value, fallback],\n    ast.Comptime(x) => [x],\n    ast.Scope(x) => [x],\n    ast.Spawn(x) => [x],\n    ast.Await(x) => [x],\n    ast.SupervisedSpawn(x) => [x],\n    ast.Old(x) => [x],\n    ast.Spread(x) => [x],\n    ast.Assumed(x) => [x],\n    ast.Select(arms) | ast.Race(arms) => {\n      mut out := []\n      for a in arms {\n        mut out.push(a.op)\n        mut out.push(a.body)\n      }\n      out\n    },\n    _ => [],\n  }\n}","old_text":"/// An expression's direct parts, including a block's statements'\n/// expressions.\nfn children(e: ast.Expr) -> List[ast.Expr] {\n  match e {\n    ast.TupleExpr(es) => es,\n    ast.ListExpr(es) => es,\n    ast.CtorExpr { args, .. } => match args {\n      ast.NoArgs => [],\n      ast.PositionalArgs(es) => es,\n      ast.RecordArgs(fs) => fs.map(f -> f.1),\n      ast.UpdateArgs { base, fields } => [base] + fields.map(f -> f.1),\n    },\n    ast.Call { callee, args } => [callee] + args,\n    ast.MethodCall { recv, args, .. } => [recv] + args,\n    ast.FieldOf { base, .. } => [base],\n    ast.Lambda { body, .. } => [body],\n    ast.Binary { left, right, .. } => [left, right],\n    ast.Unary { operand, .. } => [operand],\n    ast.IsExpr { value, .. } => [value],\n    ast.IfExpr { cond, then, otherwise } => [cond, then, otherwise],\n    ast.MatchExpr { scrutinee, arms, .. } => [scrutinee] + arms.map(a -> a.body),\n    ast.MutExpr(x) => [x],\n    ast.Block { stmts, last } => {\n      mut out := []\n      for st in stmts {\n        out += match st {\n          ast.Let { value, .. } => [value],\n          ast.VarDecl { value, .. } => [value],\n          ast.Assign { place, value } => [place, value],\n          ast.While { cond, body } => [cond, body],\n          ast.For { iter, body, .. } => [iter, body],\n          ast.ComptimeFor { iter, body, .. } => [iter, body],\n          ast.Loop(b) => [b],\n          ast.ExprStmt(x) => [x],\n          ast.Assert(x) | ast.Invariant(x) | ast.Decreases(x) => [x],\n          _ => [],\n        }\n      }\n      out + [last]\n    },\n    ast.Return(x) => [x],\n    ast.Try { value, .. } => [value],\n    ast.Except { value, fallback, .. } => [value, fallback],\n    ast.Interp(parts) => {\n      mut out := []\n      for pt in parts {\n        match pt {\n          ast.ValuePart { value, .. } => mut out.push(value),\n          ast.TextPart(_) => (),\n        }\n      }\n      out\n    },\n    ast.Range { lo, hi, .. } => {\n      mut out := []\n      for x in [lo, hi] {\n        match x {\n          Some(v) => mut out.push(v),\n          None => (),\n        }\n      }\n      out\n    },\n    ast.Index { base, index } => [base, index],\n    ast.Comp { elem, fors, .. } => {\n      mut out := []\n      for f in fors {\n        mut out.push(f.iter)\n        match f.cond {\n          Some(c) => mut out.push(c),\n          None => (),\n        }\n      }\n      out + [elem]\n    },\n    ast.DictExpr { entries, .. } => {\n      mut out := []\n      for kv in entries {\n        out += [kv.0, kv.1]\n      }\n      out\n    },\n    ast.SetExpr { elems, .. } => elems,\n    ast.Fallback { value, fallback } => [value, fallback],\n    ast.Comptime(x) => [x],\n    ast.Scope(x) => [x],\n    ast.Spawn(x) => [x],\n    ast.Await(x) => [x],\n    ast.SupervisedSpawn(x) => [x],\n    ast.Old(x) => [x],\n    ast.Spread(x) => [x],\n    ast.Assumed(x) => [x],\n    ast.Select(arms) | ast.Race(arms) => {\n      mut out := []\n      for a in arms {\n        mut out.push(a.op)\n        mut out.push(a.body)\n      }\n      out\n    },\n    _ => [],\n  }\n}"}]}
{"id":"709045faf37fa07a","time":1795664947,"message":"edit","changes":[{"name":"termination.use ast","kind":"use","old":"2055c745bb59aa19","new":"102e32ef559f7677","interface_changed":true,"affected":[],"module":"termination","text":"from ast use FnDecl, TypeDecl, TypeExpr, Expr, Stmt, Pattern, Param, ImplDecl,\n  TraitDecl, Named, FnType, UnitType, Refined, UnionType, Alias, RecordBody,\n  SumBody, NoPayload, Positional, RecordPayload, MemberType, IntLit, FloatLit,\n  StrLit, Var, Hole, CtorExpr, Call, MethodCall, FieldOf, Lambda, Binary,\n  MatchExpr, MutExpr, Block, MockExpr, Return, Try, TupleExpr, ListExpr, Except,\n  Div, Mod, Sub, Less, LessEq, Greater, GreaterEq, NotEqual, Equal, Let,\n  VarDecl, Assign, While, For, Loop, ExprStmt, Assert, Invariant, Decreases,\n  ComptimeFor, Wild, Bind, CtorPattern, ListPat, TuplePat, CondPat, OrPat,\n  ForPat, NoPats, PositionalPats, RecordPats, TypePats, AssertBy, Calc","old_text":"// termination: whether each function always finishes, by structural\n// recursion, a measure the solver checks, or loop bounds.\nfrom ast use FnDecl, TypeDecl, TypeExpr, Expr, Stmt, Pattern, Param, ImplDecl,\n  TraitDecl, Named, FnType, UnitType, Refined, UnionType, Alias, RecordBody,\n  SumBody, NoPayload, Positional, RecordPayload, MemberType, IntLit, FloatLit,\n  StrLit, Var, Hole, CtorExpr, Call, MethodCall, FieldOf, Lambda, Binary,\n  MatchExpr, MutExpr, Block, MockExpr, Return, Try, TupleExpr, ListExpr, Except,\n  Div, Mod, Sub, Less, LessEq, Greater, GreaterEq, NotEqual, Equal, Let,\n  VarDecl, Assign, While, For, Loop, ExprStmt, Assert, Invariant, Decreases,\n  ComptimeFor, Wild, Bind, CtorPattern, ListPat, TuplePat, CondPat, OrPat,\n  ForPat, NoPats, PositionalPats, RecordPats, TypePats"},{"name":"termination.calls_in","kind":"fn","old":"8d227eea6a079c25","new":"bf70d5d0e5b29242","interface_changed":false,"affected":[],"module":"termination","text":"fn calls_in(mut st: termination.Calls, ctx: termination.Ctx, e: ast.Expr) {\n  if termination.is_setting(e) {\n    return\n  }\n  match e {\n    // a function called, or passed as a value that may be called\n    ast.Var(n) => termination.call_name(mut st, ctx, n),\n    ast.MethodCall { recv, name, args } => {\n      smaller := st.own != \"\"\n        && termination.trait_node(name) == st.own\n        && termination.self_field(recv)\n      // a method a type has of its own is that type's, not the function of\n      // the same name: `k.bump()` with `impl Counter { fn bump }`\n      own := ctx.methods.own_types.any(t -> t.1 == name)\n      if !smaller && !own {\n        termination.call_name(mut st, ctx, name)\n      }\n      termination.calls_in(mut st, ctx, recv)\n      for a in args {\n        termination.calls_in(mut st, ctx, a)\n      }\n    },\n    ast.Lambda { params, body } => termination.scoped(mut st, ctx, params.map(p -> p.name), body),\n    ast.MatchExpr { scrutinee, arms, .. } => {\n      termination.calls_in(mut st, ctx, scrutinee)\n      for a in arms {\n        for x in walk.pattern_kids(a.pat) {\n          termination.calls_in(mut st, ctx, x)\n        }\n        termination.scoped(\n          mut st,\n          ctx,\n          termination.pattern_binds(a.pat),\n          a.body,\n        )\n      }\n    },\n    ast.Block { stmts, last } => {\n      // each binding is visible from the next statement on\n      mut st.scopes.push(Set[String] {})\n      for s in stmts {\n        match s {\n          ast.ComptimeFor { .. } => (),\n          ast.Let { pat, value, .. } => {\n            termination.calls_in(mut st, ctx, value)\n            for x in walk.pattern_kids(pat) {\n              termination.calls_in(mut st, ctx, x)\n            }\n            termination.bind_here(\n              mut st,\n              termination.pattern_binds(pat),\n            )\n          },\n          ast.VarDecl { name, value, .. } => {\n            termination.calls_in(mut st, ctx, value)\n            termination.bind_here(mut st, [name])\n          },\n          ast.For { pat, iter, body } => {\n            termination.calls_in(mut st, ctx, iter)\n            for x in walk.pattern_kids(pat) {\n              termination.calls_in(mut st, ctx, x)\n            }\n            termination.scoped(\n              mut st,\n              ctx,\n              termination.pattern_binds(pat),\n              body,\n            )\n          },\n          ast.Assign { place, value } => {\n            termination.calls_in(mut st, ctx, place)\n            termination.calls_in(mut st, ctx, value)\n          },\n          ast.While { cond, body } => {\n            termination.calls_in(mut st, ctx, cond)\n            termination.calls_in(mut st, ctx, body)\n          },\n          ast.Loop(x) | ast.ExprStmt(x) | ast.Assert(x) | ast.Invariant(x) | ast.Decreases(x) => termination.calls_in(mut st, ctx, x),\n          ast.AssertBy { cond, proof } => {\n            termination.calls_in(mut st, ctx, cond)\n            termination.calls_in(mut st, ctx, proof)\n          },\n          ast.Calc(xs) => {\n            for x in xs {\n              termination.calls_in(mut st, ctx, x)\n            }\n          },\n          _ => (),\n        }\n      }\n      termination.calls_in(mut st, ctx, last)\n      st.scopes = take(st.scopes, len(st.scopes) - 1)\n    },\n    _ => {\n      for k in walk.kids(e) {\n        termination.calls_in(mut st, ctx, k)\n      }\n    },\n  }\n}","old_text":"fn calls_in(mut st: termination.Calls, ctx: termination.Ctx, e: ast.Expr) {\n  if termination.is_setting(e) {\n    return\n  }\n  match e {\n    // a function called, or passed as a value that may be called\n    ast.Var(n) => termination.call_name(mut st, ctx, n),\n    ast.MethodCall { recv, name, args } => {\n      smaller := st.own != \"\"\n        && termination.trait_node(name) == st.own\n        && termination.self_field(recv)\n      // a method a type has of its own is that type's, not the function of\n      // the same name: `k.bump()` with `impl Counter { fn bump }`\n      own := ctx.methods.own_types.any(t -> t.1 == name)\n      if !smaller && !own {\n        termination.call_name(mut st, ctx, name)\n      }\n      termination.calls_in(mut st, ctx, recv)\n      for a in args {\n        termination.calls_in(mut st, ctx, a)\n      }\n    },\n    ast.Lambda { params, body } => termination.scoped(mut st, ctx, params.map(p -> p.name), body),\n    ast.MatchExpr { scrutinee, arms, .. } => {\n      termination.calls_in(mut st, ctx, scrutinee)\n      for a in arms {\n        for x in walk.pattern_kids(a.pat) {\n          termination.calls_in(mut st, ctx, x)\n        }\n        termination.scoped(\n          mut st,\n          ctx,\n          termination.pattern_binds(a.pat),\n          a.body,\n        )\n      }\n    },\n    ast.Block { stmts, last } => {\n      // each binding is visible from the next statement on\n      mut st.scopes.push(Set[String] {})\n      for s in stmts {\n        match s {\n          ast.ComptimeFor { .. } => (),\n          ast.Let { pat, value, .. } => {\n            termination.calls_in(mut st, ctx, value)\n            for x in walk.pattern_kids(pat) {\n              termination.calls_in(mut st, ctx, x)\n            }\n            termination.bind_here(\n              mut st,\n              termination.pattern_binds(pat),\n            )\n          },\n          ast.VarDecl { name, value, .. } => {\n            termination.calls_in(mut st, ctx, value)\n            termination.bind_here(mut st, [name])\n          },\n          ast.For { pat, iter, body } => {\n            termination.calls_in(mut st, ctx, iter)\n            for x in walk.pattern_kids(pat) {\n              termination.calls_in(mut st, ctx, x)\n            }\n            termination.scoped(\n              mut st,\n              ctx,\n              termination.pattern_binds(pat),\n              body,\n            )\n          },\n          ast.Assign { place, value } => {\n            termination.calls_in(mut st, ctx, place)\n            termination.calls_in(mut st, ctx, value)\n          },\n          ast.While { cond, body } => {\n            termination.calls_in(mut st, ctx, cond)\n            termination.calls_in(mut st, ctx, body)\n          },\n          ast.Loop(x) | ast.ExprStmt(x) | ast.Assert(x) | ast.Invariant(x) | ast.Decreases(x) => termination.calls_in(mut st, ctx, x),\n          _ => (),\n        }\n      }\n      termination.calls_in(mut st, ctx, last)\n      st.scopes = take(st.scopes, len(st.scopes) - 1)\n    },\n    _ => {\n      for k in walk.kids(e) {\n        termination.calls_in(mut st, ctx, k)\n      }\n    },\n  }\n}"},{"name":"termination.struct_expr","kind":"fn","old":"25c4b4a945384005","new":"68381d3e95832406","interface_changed":false,"affected":[],"module":"termination","text":"fn struct_expr(\n  mut st: termination.Structural,\n  e: ast.Expr,\n  vars: Dict[String, termination.Piece],\n) {\n  match e {\n    ast.Call { callee, args } => {\n      match callee {\n        ast.Var(n) => if contains(st.names, n) {\n          termination.struct_call(mut st, args, vars)\n        },\n        _ => (),\n      }\n      termination.struct_expr(mut st, callee, vars)\n      for a in args {\n        termination.struct_expr(mut st, a, vars)\n      }\n    },\n    ast.MethodCall { recv, name, args } => {\n      if contains(st.names, name) {\n        termination.struct_call(mut st, [recv] + args, vars)\n      }\n      termination.struct_expr(mut st, recv, vars)\n      for a in args {\n        termination.struct_expr(mut st, a, vars)\n      }\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      termination.struct_expr(mut st, scrutinee, vars)\n      whole := termination.piece(scrutinee, vars)\n      for a in arms {\n        mut v := vars\n        // a recursive call in a `where` pattern counts too\n        termination.pattern_conds(mut st, a.pat, vars)\n        match binding {\n          Some(n) => mut v.insert(n, whole),\n          None => (),\n        }\n        termination.bind_piece(\n          st,\n          a.pat,\n          Some(scrutinee),\n          whole,\n          0,\n          mut v,\n        )\n        termination.struct_expr(mut st, a.body, v)\n      }\n    },\n    ast.Lambda { params, body } => {\n      mut v := vars\n      for p in params {\n        mut v.remove(p.name)\n      }\n      termination.struct_expr(mut st, body, v)\n    },\n    ast.Block { stmts, last } => {\n      mut v := vars\n      for s in stmts {\n        match s {\n          ast.ComptimeFor { .. } => (),\n          ast.Let { pat, value, .. } => {\n            termination.struct_expr(mut st, value, v)\n            w := termination.piece(value, v)\n            termination.bind_piece(\n              st,\n              pat,\n              Some(value),\n              w,\n              0,\n              mut v,\n            )\n          },\n          ast.VarDecl { name, value, .. } => {\n            termination.struct_expr(mut st, value, v)\n            mut v.remove(name)\n          },\n          ast.For { pat, iter, body } => {\n            termination.struct_expr(mut st, iter, v)\n            w := termination.piece(iter, v)\n            mut v2 := v\n            // an element is a smaller piece of the list\n            termination.bind_piece(st, pat, None, w, 1, mut v2)\n            termination.struct_expr(mut st, body, v2)\n          },\n          ast.Assign { place, value } => {\n            termination.struct_expr(mut st, place, v)\n            termination.struct_expr(mut st, value, v)\n          },\n          ast.While { cond, body } => {\n            termination.struct_expr(mut st, cond, v)\n            termination.struct_expr(mut st, body, v)\n          },\n          ast.ExprStmt(x) | ast.Assert(x) | ast.Loop(x) | ast.Invariant(x) | ast.Decreases(x) => termination.struct_expr(mut st, x, v),\n          ast.AssertBy { cond, proof } => {\n            termination.struct_expr(mut st, cond, v)\n            termination.struct_expr(mut st, proof, v)\n          },\n          _ => (),\n        }\n      }\n      termination.struct_expr(mut st, last, v)\n    },\n    ast.Except { value, err, fallback } => {\n      termination.struct_expr(mut st, value, vars)\n      termination.struct_expr(mut st, fallback, match err {\n        Some(n) => {\n          mut copy := vars\n          mut copy.remove(n)\n          copy\n        },\n        None => vars,\n      })\n    },\n    // expressions with patterns or bodies of their own are not looked into\n    ast.Interp(_) | ast.IfExpr { .. } | ast.Binary { .. } | ast.Unary { .. } | ast.ListExpr(_) | ast.TupleExpr(_) | ast.CtorExpr { .. } | ast.FieldOf { .. } | ast.IsExpr { .. } | ast.Return(_) | ast.Try { .. } | ast.MutExpr(_) | ast.Fallback { .. } => {\n      for k in walk.kids(e) {\n        termination.struct_expr(mut st, k, vars)\n      }\n    },\n    _ => (),\n  }\n}","old_text":"fn struct_expr(\n  mut st: termination.Structural,\n  e: ast.Expr,\n  vars: Dict[String, termination.Piece],\n) {\n  match e {\n    ast.Call { callee, args } => {\n      match callee {\n        ast.Var(n) => if contains(st.names, n) {\n          termination.struct_call(mut st, args, vars)\n        },\n        _ => (),\n      }\n      termination.struct_expr(mut st, callee, vars)\n      for a in args {\n        termination.struct_expr(mut st, a, vars)\n      }\n    },\n    ast.MethodCall { recv, name, args } => {\n      if contains(st.names, name) {\n        termination.struct_call(mut st, [recv] + args, vars)\n      }\n      termination.struct_expr(mut st, recv, vars)\n      for a in args {\n        termination.struct_expr(mut st, a, vars)\n      }\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      termination.struct_expr(mut st, scrutinee, vars)\n      whole := termination.piece(scrutinee, vars)\n      for a in arms {\n        mut v := vars\n        // a recursive call in a `where` pattern counts too\n        termination.pattern_conds(mut st, a.pat, vars)\n        match binding {\n          Some(n) => mut v.insert(n, whole),\n          None => (),\n        }\n        termination.bind_piece(\n          st,\n          a.pat,\n          Some(scrutinee),\n          whole,\n          0,\n          mut v,\n        )\n        termination.struct_expr(mut st, a.body, v)\n      }\n    },\n    ast.Lambda { params, body } => {\n      mut v := vars\n      for p in params {\n        mut v.remove(p.name)\n      }\n      termination.struct_expr(mut st, body, v)\n    },\n    ast.Block { stmts, last } => {\n      mut v := vars\n      for s in stmts {\n        match s {\n          ast.ComptimeFor { .. } => (),\n          ast.Let { pat, value, .. } => {\n            termination.struct_expr(mut st, value, v)\n            w := termination.piece(value, v)\n            termination.bind_piece(\n              st,\n              pat,\n              Some(value),\n              w,\n              0,\n              mut v,\n            )\n          },\n          ast.VarDecl { name, value, .. } => {\n            termination.struct_expr(mut st, value, v)\n            mut v.remove(name)\n          },\n          ast.For { pat, iter, body } => {\n            termination.struct_expr(mut st, iter, v)\n            w := termination.piece(iter, v)\n            mut v2 := v\n            // an element is a smaller piece of the list\n            termination.bind_piece(st, pat, None, w, 1, mut v2)\n            termination.struct_expr(mut st, body, v2)\n          },\n          ast.Assign { place, value } => {\n            termination.struct_expr(mut st, place, v)\n            termination.struct_expr(mut st, value, v)\n          },\n          ast.While { cond, body } => {\n            termination.struct_expr(mut st, cond, v)\n            termination.struct_expr(mut st, body, v)\n          },\n          ast.ExprStmt(x) | ast.Assert(x) | ast.Loop(x) | ast.Invariant(x) | ast.Decreases(x) => termination.struct_expr(mut st, x, v),\n          _ => (),\n        }\n      }\n      termination.struct_expr(mut st, last, v)\n    },\n    ast.Except { value, err, fallback } => {\n      termination.struct_expr(mut st, value, vars)\n      termination.struct_expr(mut st, fallback, match err {\n        Some(n) => {\n          mut copy := vars\n          mut copy.remove(n)\n          copy\n        },\n        None => vars,\n      })\n    },\n    // expressions with patterns or bodies of their own are not looked into\n    ast.Interp(_) | ast.IfExpr { .. } | ast.Binary { .. } | ast.Unary { .. } | ast.ListExpr(_) | ast.TupleExpr(_) | ast.CtorExpr { .. } | ast.FieldOf { .. } | ast.IsExpr { .. } | ast.Return(_) | ast.Try { .. } | ast.MutExpr(_) | ast.Fallback { .. } => {\n      for k in walk.kids(e) {\n        termination.struct_expr(mut st, k, vars)\n      }\n    },\n    _ => (),\n  }\n}"}]}
{"id":"3c03b33cb5135920","time":1795665000,"message":"edit","changes":[{"name":"codegen.generate","kind":"fn","old":"63edf575ee60bf93","new":"54455a5d2f060326","interface_changed":false,"affected":[],"module":"codegen","text":"/// The program's `main` and what it calls as LLVM IR, or the constructs not\n/// compiled, each with its function. `assumed_clauses` also checks the\n/// assumed contract clauses (`--check-assumed`). Verify's fuzz drivers\n/// always check them.\npub fn generate(\n  given: List[ast.Decl],\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  proofs: List[String],\n  tests: Option[List[(String, String)]],\n  fuzz: List[String],\n  fuzz_text: Bool,\n  calls: List[String],\n  trace: Bool,\n  library: List[String],\n  precompiled: List[String],\n  bare: Bool,\n  copies: Option[Dict[String, String]],\n  memory_sites: Option[Dict[String, String]],\n  assumed_clauses: Bool,\n) -> Result[String, List[String]] {\n  // unused variables with no effect are not compiled (`unread_dropped`),\n  // and assumed contract clauses are left out (`assumed_compiled`)\n  keep := assumed_clauses || fuzz != []\n  // lemmas and proofs (`assert … by`, `calc`) are for `verify` alone: never\n  // compiled\n  (start, main) := match codegen.new_gen(\n    given\n      .filter(d -> !match d.kind {\n        ast.FnDef(f) => f.lemma,\n        _ => false,\n      })\n      .map(d -> walk.rewrite_decl(\n        codegen.assumed_compiled(d, keep),\n        x -> codegen.unread_dropped(codegen.proofs_dropped(x)),\n      )),\n    core,\n    prelude,\n    proofs,\n    tests,\n    fuzz,\n    fuzz_text,\n    calls,\n    trace,\n    library,\n    precompiled,\n  ) {\n    Ok(x) => x,\n    Err(es) => return Err(es),\n  }\n  // core.rt (`bare`): no call-stack frames, no cancel points\n  mut g := if bare {\n    codegen.Gen { ..start, bare: true, tasks: false, supervises: false }\n  } else {\n    start\n  }\n  // `--copies`: report copies with their locations\n  match copies {\n    Some(sites) => {\n      g.copies = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  // (`--memory-sites`: each counting operation counted, by site)\n  match memory_sites {\n    Some(sites) => {\n      g.memory_sites = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  mut bodies := match tests {\n    // each test as `strata test` runs it (`strata.test.N`), with its name\n    Some(ts) => enumerate(ts).map(x -> codegen.test_entry(x.0, x.1.0, x.1.1)),\n    None => if fuzz != [] || library != [] || calls != [] {\n      []\n    } else if main.name == \"\" {\n      // a library starts when it is loaded\n      [codegen.library_start(mut g)]\n    } else {\n      [codegen.entry(mut g, main)]\n    },\n  }\n  // std's library runs in any program, with tasks or without. It holds its\n  // functions by key and its `impl`s' methods (`library_methods`), except\n  // those `!KEY` excludes. Generic functions, those depending on the\n  // compile, and trait values are compiled per program instead.\n  mut roots := []\n  mut held := []\n  left_out := set(library\n    .filter(k -> starts_with(k, \"!\"))\n    .map(k -> byte_slice(k, 1, byte_len(k))))\n  mut wanted := library.filter(k -> !starts_with(k, \"!\"))\n  if library != [] {\n    wanted += codegen.library_methods(mut g).filter(\n      k -> !contains(left_out, k),\n    )\n  }\n  for k in wanted {\n    match codegen.fn_of(g, k) {\n      Some(f) => if codegen.precompilable(mut g, k, f) {\n        sym := codegen.instance(mut g, k, f, Dict[String, check.Ty] {})\n        mut roots.push(sym)\n        mut held.push(k)\n      },\n      None => (),\n    }\n  }\n  // verify's fuzz drivers (`strata.fuzz.N`)\n  for (i, k) in enumerate(fuzz) {\n    mut bodies.push(codegen.fuzz_driver(mut g, i, k))\n  }\n  // `strata run f ARGS` calls (`strata.call.N`). `session:KEY` is a\n  // `strata repl` line, with the session's arguments.\n  for (i, k) in enumerate(calls) {\n    mut bodies.push(\n      if starts_with(k, \"session:\") {\n        codegen.session_entry(\n          mut g,\n          i,\n          byte_slice(k, 8, byte_len(k)),\n        )\n      } else {\n        codegen.call_entry(mut g, i, k)\n      },\n    )\n  }\n  // the exports of `derive C for f`, each under its symbol\n  if fuzz == [] && library == [] && calls == [] && tests is None {\n    for (symbol, k) in codegen.exports_of(given) {\n      mut bodies.push(codegen.export_entry(mut g, symbol, k))\n    }\n  }\n  // the files they generate: the C header\n  parts := match codegen.file_parts(given) {\n    Ok(ps) => ps,\n    Err(e) => return Err([e]),\n  }\n  // Each reachable function instance, once, in rounds. The workers compile\n  // each function of a round alone from the state the round began with.\n  // Their additions are then merged in queue order, so the output does not\n  // depend on thread timing.\n  if len(g.queue) > 0 && g.keeps is None {\n    g.keeps = Some(codegen.kept_by(g.fns))\n  }\n  mut global_keys := set(g.globals.map(l -> codegen.global_key(l)))\n  mut def_keys := set(g.helper_defs.map(d -> codegen.def_key(d)))\n  while len(g.queue) > 0 {\n    round := g.queue\n    g.queue = []\n    base := g\n    for (body, d) in parallel.map(\n      round,\n      item -> codegen.compiled_alone(base, item.0, item.1, main),\n    ) {\n      mut bodies.push(body)\n      codegen.merge_alone(\n        mut g,\n        base,\n        d,\n        mut global_keys,\n        mut def_keys,\n      )\n    }\n  }\n  if len(g.errs) > 0 {\n    // std's library leaves out the functions that reach something not\n    // compiled\n    if library != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      out := wanted.filter(k -> contains(left, k))\n      if out != [] {\n        return Err(out.map(k -> \"leave out: \" + k))\n      }\n    }\n    // verify's fuzz drivers: each one reaching something not compiled is\n    // reported as `can't fuzz `KEY`: WHY`, so `verify` drops them all at\n    // once\n    if fuzz != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      callees := codegen.callees_of(g.callers)\n      return Err(g.errs\n        + fuzz\n          .filter(k -> contains(left, \"fuzz:\" + k))\n          .map(k -> \"can't fuzz `\"\n            + k\n            + \"`: \"\n            + join(\n              codegen.failures_of(callees, g.why, \"fuzz:\" + k),\n              \"; \",\n            )))\n    }\n    return Err(g.errs)\n  }\n  mut out := [\n    \"; Strata, compiled by compiler/codegen\",\n    f\"; checks left out {g.left_out}, kept {g.kept}\",\n    \"\",\n  ]\n  // std's library lists the functions it holds: `; precompiled NAME`\n  out += held.map(k -> \"; precompiled \" + k)\n  out += parts.map(p -> codegen.file_line(p.0, p.1))\n  // the symbols a library exports (`; export add`); the rest are hidden\n  out += if fuzz == [] && library == [] && calls == [] && tests is None {\n    codegen.exports_of(given).map(e -> \"; export \" + e.0)\n  } else {\n    []\n  }\n  out += g.globals\n  mut out.push(\"\")\n  // std's library exposes only its functions\n  out += if library != [] {\n    codegen.internal(bodies + g.helper_defs, set(roots))\n  } else {\n    bodies + g.helper_defs\n  }\n  for d in codegen.declarations() {\n    if contains(g.used, d.0) {\n      mut out.push(d.1)\n    }\n  }\n  ir_text := join(out, \"\\n\") + \"\\n\"\n  Ok(if g.memory_sites {\n    codegen.counted_sites(ir_text)\n  } else {\n    ir_text\n  })\n}","old_text":"/// The program's `main` and what it calls as LLVM IR, or the constructs not\n/// compiled, each with its function. `assumed_clauses` also checks the\n/// assumed contract clauses (`--check-assumed`). Verify's fuzz drivers\n/// always check them.\npub fn generate(\n  given: List[ast.Decl],\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  proofs: List[String],\n  tests: Option[List[(String, String)]],\n  fuzz: List[String],\n  fuzz_text: Bool,\n  calls: List[String],\n  trace: Bool,\n  library: List[String],\n  precompiled: List[String],\n  bare: Bool,\n  copies: Option[Dict[String, String]],\n  memory_sites: Option[Dict[String, String]],\n  assumed_clauses: Bool,\n) -> Result[String, List[String]] {\n  // unused variables with no effect are not compiled (`unread_dropped`),\n  // and assumed contract clauses are left out (`assumed_compiled`)\n  keep := assumed_clauses || fuzz != []\n  (start, main) := match codegen.new_gen(\n    given.map(\n      d -> walk.rewrite_decl(\n        codegen.assumed_compiled(d, keep),\n        x -> codegen.unread_dropped(x),\n      ),\n    ),\n    core,\n    prelude,\n    proofs,\n    tests,\n    fuzz,\n    fuzz_text,\n    calls,\n    trace,\n    library,\n    precompiled,\n  ) {\n    Ok(x) => x,\n    Err(es) => return Err(es),\n  }\n  // core.rt (`bare`): no call-stack frames, no cancel points\n  mut g := if bare {\n    codegen.Gen { ..start, bare: true, tasks: false, supervises: false }\n  } else {\n    start\n  }\n  // `--copies`: report copies with their locations\n  match copies {\n    Some(sites) => {\n      g.copies = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  // (`--memory-sites`: each counting operation counted, by site)\n  match memory_sites {\n    Some(sites) => {\n      g.memory_sites = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  mut bodies := match tests {\n    // each test as `strata test` runs it (`strata.test.N`), with its name\n    Some(ts) => enumerate(ts).map(x -> codegen.test_entry(x.0, x.1.0, x.1.1)),\n    None => if fuzz != [] || library != [] || calls != [] {\n      []\n    } else if main.name == \"\" {\n      // a library starts when it is loaded\n      [codegen.library_start(mut g)]\n    } else {\n      [codegen.entry(mut g, main)]\n    },\n  }\n  // std's library runs in any program, with tasks or without. It holds its\n  // functions by key and its `impl`s' methods (`library_methods`), except\n  // those `!KEY` excludes. Generic functions, those depending on the\n  // compile, and trait values are compiled per program instead.\n  mut roots := []\n  mut held := []\n  left_out := set(library\n    .filter(k -> starts_with(k, \"!\"))\n    .map(k -> byte_slice(k, 1, byte_len(k))))\n  mut wanted := library.filter(k -> !starts_with(k, \"!\"))\n  if library != [] {\n    wanted += codegen.library_methods(mut g).filter(\n      k -> !contains(left_out, k),\n    )\n  }\n  for k in wanted {\n    match codegen.fn_of(g, k) {\n      Some(f) => if codegen.precompilable(mut g, k, f) {\n        sym := codegen.instance(mut g, k, f, Dict[String, check.Ty] {})\n        mut roots.push(sym)\n        mut held.push(k)\n      },\n      None => (),\n    }\n  }\n  // verify's fuzz drivers (`strata.fuzz.N`)\n  for (i, k) in enumerate(fuzz) {\n    mut bodies.push(codegen.fuzz_driver(mut g, i, k))\n  }\n  // `strata run f ARGS` calls (`strata.call.N`). `session:KEY` is a\n  // `strata repl` line, with the session's arguments.\n  for (i, k) in enumerate(calls) {\n    mut bodies.push(\n      if starts_with(k, \"session:\") {\n        codegen.session_entry(\n          mut g,\n          i,\n          byte_slice(k, 8, byte_len(k)),\n        )\n      } else {\n        codegen.call_entry(mut g, i, k)\n      },\n    )\n  }\n  // the exports of `derive C for f`, each under its symbol\n  if fuzz == [] && library == [] && calls == [] && tests is None {\n    for (symbol, k) in codegen.exports_of(given) {\n      mut bodies.push(codegen.export_entry(mut g, symbol, k))\n    }\n  }\n  // the files they generate: the C header\n  parts := match codegen.file_parts(given) {\n    Ok(ps) => ps,\n    Err(e) => return Err([e]),\n  }\n  // Each reachable function instance, once, in rounds. The workers compile\n  // each function of a round alone from the state the round began with.\n  // Their additions are then merged in queue order, so the output does not\n  // depend on thread timing.\n  if len(g.queue) > 0 && g.keeps is None {\n    g.keeps = Some(codegen.kept_by(g.fns))\n  }\n  mut global_keys := set(g.globals.map(l -> codegen.global_key(l)))\n  mut def_keys := set(g.helper_defs.map(d -> codegen.def_key(d)))\n  while len(g.queue) > 0 {\n    round := g.queue\n    g.queue = []\n    base := g\n    for (body, d) in parallel.map(\n      round,\n      item -> codegen.compiled_alone(base, item.0, item.1, main),\n    ) {\n      mut bodies.push(body)\n      codegen.merge_alone(\n        mut g,\n        base,\n        d,\n        mut global_keys,\n        mut def_keys,\n      )\n    }\n  }\n  if len(g.errs) > 0 {\n    // std's library leaves out the functions that reach something not\n    // compiled\n    if library != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      out := wanted.filter(k -> contains(left, k))\n      if out != [] {\n        return Err(out.map(k -> \"leave out: \" + k))\n      }\n    }\n    // verify's fuzz drivers: each one reaching something not compiled is\n    // reported as `can't fuzz `KEY`: WHY`, so `verify` drops them all at\n    // once\n    if fuzz != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      callees := codegen.callees_of(g.callers)\n      return Err(g.errs\n        + fuzz\n          .filter(k -> contains(left, \"fuzz:\" + k))\n          .map(k -> \"can't fuzz `\"\n            + k\n            + \"`: \"\n            + join(\n              codegen.failures_of(callees, g.why, \"fuzz:\" + k),\n              \"; \",\n            )))\n    }\n    return Err(g.errs)\n  }\n  mut out := [\n    \"; Strata, compiled by compiler/codegen\",\n    f\"; checks left out {g.left_out}, kept {g.kept}\",\n    \"\",\n  ]\n  // std's library lists the functions it holds: `; precompiled NAME`\n  out += held.map(k -> \"; precompiled \" + k)\n  out += parts.map(p -> codegen.file_line(p.0, p.1))\n  // the symbols a library exports (`; export add`); the rest are hidden\n  out += if fuzz == [] && library == [] && calls == [] && tests is None {\n    codegen.exports_of(given).map(e -> \"; export \" + e.0)\n  } else {\n    []\n  }\n  out += g.globals\n  mut out.push(\"\")\n  // std's library exposes only its functions\n  out += if library != [] {\n    codegen.internal(bodies + g.helper_defs, set(roots))\n  } else {\n    bodies + g.helper_defs\n  }\n  for d in codegen.declarations() {\n    if contains(g.used, d.0) {\n      mut out.push(d.1)\n    }\n  }\n  ir_text := join(out, \"\\n\") + \"\\n\"\n  Ok(if g.memory_sites {\n    codegen.counted_sites(ir_text)\n  } else {\n    ir_text\n  })\n}"},{"name":"codegen.proofs_dropped","kind":"fn","old":null,"new":"41956737f68907d6","interface_changed":true,"affected":[],"module":"codegen","text":"/// `e` without its proofs (`assert … by`, `calc`): they compile to nothing.\nfn proofs_dropped(e: ast.Expr) -> ast.Expr {\n  match e {\n    ast.Block { stmts, last } => if stmts.any(s -> s is ast.AssertBy || s is ast.Calc) {\n      kept := stmts.filter(s -> !(s is ast.AssertBy || s is ast.Calc))\n      if kept == [] {\n        last\n      } else {\n        ast.Block { stmts: kept, last }\n      }\n    } else {\n      e\n    },\n    _ => e,\n  }\n}"}]}
{"id":"46f87ee009318e2c","time":1795665183,"message":"edit","changes":[{"name":"smt.use ast","kind":"use","old":"4c5e34ce1b09bae9","new":"5c06fbb2a4f4c0fa","interface_changed":true,"affected":[],"module":"smt","text":"from ast use Arm, CapabilityDef, TraitDef, ImplDef, TraitDecl, ImplDecl,\n  ExternDef, ExternDecl, Builtin, ExternFn, LamParam, Decl, FnDecl, TypeDecl,\n  TypeExpr, Expr, Stmt, Pattern, Param, StrPart, BinOp, FnDef, TypeDef, Named,\n  FnType, UnitType, Refined, UnionType, Alias, RecordBody, SumBody, NoPayload,\n  Positional, RecordPayload, MemberType, IntLit, BigIntLit, FloatLit, TupleExpr,\n  StrLit, BoolLit, UnitExpr, Var, Hole, ListExpr, CtorExpr, Call, MethodCall,\n  FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr, MutExpr, Block,\n  MockExpr, Return, Try, Except, Interp, Range, Index, Comp, DictExpr, SetExpr,\n  Fallback, Comptime, Scope, Spawn, Await, Select, Race, SupervisedSpawn,\n  ValuePart, TextPart, Add, Sub, Mul, Div, Mod, Equal, NotEqual, Less, LessEq,\n  Greater, GreaterEq, And, Or, Implies, BitAnd, BitOr, BitXor, Shl, Shr, Neg,\n  Not, Let, VarDecl, Assign, While, For, Loop, Break, Continue, ExprStmt,\n  Assert, Comment, ComptimeFor, Invariant, Decreases, Wild, Bind, IntPat,\n  StrPat, BoolPat, CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat,\n  CtorPat, NoPats, PositionalPats, RecordPats, TypePats, CtorArgs, NoArgs,\n  PositionalArgs, RecordArgs, UpdateArgs, TryResult, TryOption, unassumed,\n  AssertBy, Calc, calc_steps, calc_fact","old_text":"// smt: symbolic execution of a function into SMT-LIB queries for Z3: one\n// obligation per check, contract and refinement, plus termination's.\nfrom ast use Arm, CapabilityDef, TraitDef, ImplDef, TraitDecl, ImplDecl,\n  ExternDef, ExternDecl, Builtin, ExternFn, LamParam, Decl, FnDecl, TypeDecl,\n  TypeExpr, Expr, Stmt, Pattern, Param, StrPart, BinOp, FnDef, TypeDef, Named,\n  FnType, UnitType, Refined, UnionType, Alias, RecordBody, SumBody, NoPayload,\n  Positional, RecordPayload, MemberType, IntLit, BigIntLit, FloatLit, TupleExpr,\n  StrLit, BoolLit, UnitExpr, Var, Hole, ListExpr, CtorExpr, Call, MethodCall,\n  FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr, MutExpr, Block,\n  MockExpr, Return, Try, Except, Interp, Range, Index, Comp, DictExpr, SetExpr,\n  Fallback, Comptime, Scope, Spawn, Await, Select, Race, SupervisedSpawn,\n  ValuePart, TextPart, Add, Sub, Mul, Div, Mod, Equal, NotEqual, Less, LessEq,\n  Greater, GreaterEq, And, Or, Implies, BitAnd, BitOr, BitXor, Shl, Shr, Neg,\n  Not, Let, VarDecl, Assign, While, For, Loop, Break, Continue, ExprStmt,\n  Assert, Comment, ComptimeFor, Invariant, Decreases, Wild, Bind, IntPat,\n  StrPat, BoolPat, CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat,\n  CtorPat, NoPats, PositionalPats, RecordPats, TypePats, CtorArgs, NoArgs,\n  PositionalArgs, RecordArgs, UpdateArgs, TryResult, TryOption, unassumed"},{"name":"smt.Obligation","kind":"type","old":"b4477d4ee49212fb","new":"b36b8153cf2ed19e","interface_changed":true,"affected":["smt.Vc","smt.oblige","smt.cone","smt.body","smt.drop_falsifiable","smt.measure_check","smt.why","smt.answer_of","smt.cone_with","smt.body_with","smt.inputs","smt.pass_measures","smt.mixed_answer","termination.termination_queries","smt.small_goal","smt.kept_facts","verify_file","check_fn","solved_together","graph_answers","solved_with","loop_hint","smt.new_vc","smt.fresh","smt.fresh_why","smt.unknown_bool","smt.assume","smt.gap","smt.start_goal","smt.as_int","smt.as_bool","smt.as_str","smt.shape","smt.havoc","smt.refresh","smt.refined","smt.check_type","smt.pred","smt.early_return","smt.lookup","smt.bind","smt.set_var","smt.merge","smt.branches","smt.eq","smt.arith","smt.bits","smt.compare","smt.concat","smt.eval","smt.binary","smt.call_exprs","smt.call_key","smt.call","smt.write_back","smt.call_contract","smt.stmt","smt.annotated","smt.declare","smt.assign","smt.function","smt.header","smt.leaves","smt.batch","smt.single","smt.outcome","smt.solve","smt