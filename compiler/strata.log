 codegen.V {\n  n := codegen.small_words(g, ret)\n  wt := codegen.words_ll(n)\n  waits := g.tasks && g.can_unwind && codegen.calls_wait(g, fk)\n  as_came := codegen.in_result(g, rp, ret) || assigned\n  if as_came || waits {\n    b := codegen.held_words(mut g, ret, w)\n    if waits {\n      codegen.cancel_point_after(\n        mut g,\n        codegen.V { ty: ret, op: b },\n      )\n    }\n    if as_came {\n      return codegen.temp(mut g, codegen.V { ty: ret, op: b })\n    }\n  }\n  if on_stack {\n    u := codegen.box_or_copy(\n      mut g,\n      codegen.unbox_fn(mut g, ret),\n      wt,\n      w,\n      wt,\n      fk,\n    )\n    p := codegen.stack_words(mut g, ret, u)\n    mut g.stack_ops.insert(p)\n    g.stack_made = [check.TAny]\n    return codegen.temp(mut g, codegen.V { ty: ret, op: p })\n  }\n  r := codegen.box_or_copy(\n    mut g,\n    codegen.box_fn(mut g, ret),\n    wt,\n    w,\n    \"ptr\",\n    fk,\n  )\n  codegen.temp(mut g, codegen.V { ty: ret, op: r })\n}","old_text":"/// The result of a call giving words (`by_words`), `w`, as a value. In\n/// result position (`rp`), or assigned to a variable (`assigned`:\n/// `assign_held`), it stays as it came (`held_words`). Where the\n/// value doesn't outlive what the caller does with it (`on_stack`), it is\n/// in a block on the stack (`unbox_fn`: a block given is copied out and\n/// let go). Anywhere else it is boxed (`box_fn`: the block given, or a\n/// new one). Before a cancel point the value waits as it came, dropped if\n/// the task leaves there.\nfn words_value(\n  mut g: codegen.Gen,\n  fk: String,\n  ret: Ty,\n  w: String,\n  on_stack: Bool,\n  rp: Bool,\n  assigned: Bool,\n) -> codegen.V {\n  n := codegen.small_words(g, ret)\n  wt := codegen.words_ll(n)\n  waits := g.tasks && g.can_unwind && codegen.calls_wait(g, fk)\n  as_came := codegen.in_result(g, rp, ret) || assigned\n  if as_came || waits {\n    b := codegen.held_words(mut g, ret, w)\n    if waits {\n      codegen.cancel_point_after(\n        mut g,\n        codegen.V { ty: ret, op: b },\n      )\n    }\n    if as_came {\n      return codegen.temp(mut g, codegen.V { ty: ret, op: b })\n    }\n  }\n  if on_stack {\n    u := codegen.box_or_copy(\n      mut g,\n      codegen.unbox_fn(mut g, ret),\n      wt,\n      w,\n      wt,\n      fk,\n    )\n    p := codegen.stack_words(mut g, ret, u)\n    mut g.stack_ops.insert(p)\n    g.stack_made = [TAny]\n    return codegen.temp(mut g, codegen.V { ty: ret, op: p })\n  }\n  r := codegen.box_or_copy(\n    mut g,\n    codegen.box_fn(mut g, ret),\n    wt,\n    w,\n    \"ptr\",\n    fk,\n  )\n  codegen.temp(mut g, codegen.V { ty: ret, op: r })\n}"},{"name":"codegen.words_fn","kind":"fn","old":"1045b2e63cb8e4d6","new":"07e99e0238d2fcc8","interface_changed":true,"affected":["codegen.unbox_fn","codegen.words_value","codegen.call_at","codegen.call_fn_want","codegen.call","codegen.entry","codegen.show","codegen.shown","codegen.equal","codegen.mock_call","codegen.session_entry","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.function","codegen.int_lit","codegen.concat","codegen.apply","codegen.finite","codegen.fault","codegen.slice_raw","codegen.list_builtin","codegen.debug_list","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.number_builtin","codegen.format_spec","codegen.word_to_int","codegen.list_literal_of","codegen.checked","codegen.check_type","codegen.host","codegen.channel_op","codegen.trace_enter","codegen.trace_leave","codegen.mem_builtin","codegen.table_from","codegen.set_copy","codegen.checked_update","codegen.appended","codegen.expr_node","codegen.decreases_fault","codegen.build_fn","codegen.push_in_place","codegen.generate","codegen.interp","codegen.dyn_wrapper","codegen.union_text","codegen.destructure","codegen.debug_fields","codegen.for_loop","codegen.fail_unless","codegen.check_requires","codegen.check_ensu