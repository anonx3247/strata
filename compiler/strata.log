    mut vars.insert(name, nl)\n      }\n    }\n    owned := s.owned.map(\n      o -> if o.slot == l.slot {\n        nl\n      } else {\n        o\n      },\n    )\n    codegen.set_scope(mut g, k, codegen.Scope { ..s, vars, owned })\n    k += 1\n  }\n  nl\n}","old_text":"/// Gives local `l` the more precise type `t` where its own is partly\n/// unknown (`List[_]` of `mut xs := []`), in every scope that has it, so\n/// its drop drops its contents.\nfn retype(mut g: codegen.Gen, l: codegen.Local, t: Ty) -> codegen.Local {\n  nt := codegen.better(l.ty, t)\n  if !codegen.has_any(l.ty)\n    || codegen.key(nt) == codegen.key(l.ty)\n    || codegen.ll(nt) != codegen.ll(l.ty) {\n    return l\n  }\n  nl := codegen.Local { ..l, ty: nt }\n  mut k := 0\n  while k < len(g.scopes) {\n    s := get(g.scopes, k) ?? codegen.no_scope()\n    mut vars := s.vars\n    for (name, x) in s.vars {\n      if x.slot == l.slot {\n        mut vars.insert(name, nl)\n      }\n    }\n    owned := s.owned.map(\n      o -> if o.slot == l.slot {\n        nl\n      } else {\n        o\n      },\n    )\n    codegen.set_scope(mut g, k, codegen.Scope { ..s, vars, owned })\n    k += 1\n  }\n  nl\n}"},{"name":"codegen.has_any","kind":"fn","old":"79ba93a7ae903e4c","new":"b4d7697e61daf6e1","interface_changed":true,"affected":["codegen.to_union","codegen.retype","codegen.new_gen","codegen.retype_temp","codegen.alike","codegen.holds_fn","codegen.list_builtin","codegen.converted","codegen.push_in_place","codegen.stmt_node","codegen.generate","codegen.read_back","codegen.checked","codegen.construct_want","codegen.builtin","codegen.take_in_place","codegen.collection_builtin","codegen.list_literal_of","codegen.produce","codegen.operands_want","codegen.wanted","codegen.update_in_place","codegen.table_find","codegen.set_in_place","codegen.expr_want_node","codegen.stmt","codegen_with","core_rt_text","computed_value","repl_eval","codegen.assertion","codegen.invariants","codegen.construct","codegen.call_named","codegen.bui