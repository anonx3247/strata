","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","codegen.read_back","eval_files"],"module":"codegen","text":"/// `matching_want` of value `v` of `scrutinee`.\nfn matching_v(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  scrutinee: ast.Expr,\n  binding: Option[String],\n  arms: List[ast.Arm],\n  want: check.Ty,\n) -> codegen.V {\n  // in result position: each arm's value is, joined in a result block\n  rp := g.result_pos\n  g.result_pos = false\n  // a value held until after the match and never assigned: a temporary of\n  // an outer scope, a constant, or a non-`mut` variable\n  stable := codegen.constant(v.op)\n    || codegen.is_temp(g, v.op)\n    || match scrutinee {\n      ast.Var(x) => match codegen.lookup(g, x) {\n        Some(l) => l.op != \"\",\n        None => false,\n      },\n      _ => false,\n    }\n  codegen.push_scope(mut g)\n  match binding {\n    Some(b) => codegen.let_owned(mut g, b, v),\n    None => (),\n  }\n  end := codegen.label(mut g, \"endmatch\")\n  mut incoming := []\n  // a constructor matched as written (`match Ok(()) { … }`, as compile-time\n  // code makes): only the arms that can match it\n  live := match scrutinee {\n    ast.CtorExpr { name: c, .. } => arms.filter(\n      a -> match a.pat {\n        ast.CtorPattern { name: p, .. } => p == c,\n        _ => true,\n      },\n    ),\n    _ => arms,\n  }\n  // the last arm: where its code starts, and where it goes when it fails\n  mut last := (0, \"\")\n  // when the arms so far accept every constructor with any contents, the\n  // last arm's constructor, the only one left, needs no test\n  all_ctors := match v.ty {\n    check.TNamed { .. } => codegen.ctors_of(g, v.ty),\n    _ => [],\n  }\n  mut covered := Set[String] {}\n  for (ai, a) in enumerate(live) {\n    whole := match a.pat {\n      ast.CtorPattern { name, args } => if contains(g.types.ctors, name) && codegen.takes_any(args) {\n        name\n      } else {\n        \"\"\n      },\n      _ => \"\",\n    }\n    sure := ai + 1 == len(live)\n      && whole != \"\"\n      && all_ctors != []\n      && all_ctors.all(c -> c == whole || contains(covered, c))\n    if whole != \"\" {\n      mut covered.insert(whole)\n    }\n    next := codegen.label(mut g, \"arm\")\n    from := len(g.lines)\n    codegen.push_scope(mut g)\n    // a trait value against a constructor pattern (`Log { lines }`): the\n    // held value, when its table is that type's\n    subject := match (v.ty, a.pat) {\n      (check.TTrait(tr), ast.CtorPattern { name: c, .. }) => match codegen.dyn_type_of(g, c) {\n        Some(t) => {\n          same := codegen.dyn_table_is(mut g, v, tr, t)\n          hit := codegen.label(mut g, \"dyn.hit\")\n          codegen.emit(\n            mut g,\n            f\"br i1 {same}, label %{hit}, label %{next}\",\n          )\n          codegen.block(mut g, hit)\n          codegen.dyn_value(mut g, v, t)\n        },\n        None => v,\n      },\n      _ => v,\n    }\n    if !sure {\n      codegen.matches(mut g, a.pat, subject, next)\n    }\n    // the held value is borrowed when it outlives the arm unchanged\n    g.borrowing = stable\n    codegen.binds(mut g, a.pat, subject)\n    g.borrowing = false\n    // the matched variable, or the name `as m` gives it, is the member an\n    // arm names\n    match v.ty {\n      check.TUnion(ms) => match codegen.pattern_member(g, ms, a.pat) {\n        Some(m) => {\n          mut names := match scrutinee {\n            ast.Var(x) => [x],\n            _ => [],\n          }\n          match binding {\n            Some(b) => mut names.push(b),\n            None => (),\n          }\n          for x in names {\n            match codegen.lookup(g, x) {\n              Some(l) => {\n                nx := codegen.narrow(mut g, v, m)\n                codegen.narrowed_var(mut g, x, l, nx)\n              },\n              None => (),\n            }\n          }\n        },\n        None => (),\n      },\n      _ => (),\n    }\n    g.result_pos = rp\n    r0 := codegen.branch_value(mut g, a.body, want)\n    g.result_pos = false\n    r := if rp {\n      codegen.result_own(mut g, codegen.leave_branch(mut g, r0))\n    } else {\n      codegen.leave_branch(mut g, r0)\n    }\n    mut incoming.push((r, codegen.current(g)))\n    codegen.br(mut g, end)\n    codegen.block(mut g, next)\n    last = (from, next)\n  }\n  if last.1 != \"\" && !codegen.jumps_to(g, last.0, last.1) {\n    // an irrefutable last arm (`_ =>`): nothing goes past it\n    g.lines = take(g.lines, len(g.lines) - 1)\n  } else {\n    codegen.push_scope(mut g)\n    s := codegen.shown(mut g, v)\n    m := codegen.lit(mut g, \"no match arm for \")\n    codegen.fault(mut g, 4, [m, s])\n    codegen.discard_scope(mut g)\n    codegen.br(mut g, end)\n    mut incoming.push((codegen.never(), codegen.current(g)))\n  }\n  codegen.block(mut g, end)\n  r := codegen.result_joined(\n    mut g,\n    rp,\n    codegen.join_values(mut g, incoming),\n    incoming,\n  )\n  // each arm's value is held: the match's scope holds the one that came\n  r1 := codegen.temp(mut g, r)\n  x := codegen.leave_branch(mut g, r1)\n  codegen.temp(mut g, x)\n}","old_text":"/// `matching_want` of value `v` of `scrutinee`.\nfn matching_v(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  scrutinee: ast.Expr,\n  binding: Option[String],\n  arms: List[ast.Arm],\n  want: Ty,\n) -> codegen.V {\n  // in result position: each arm's value is, joined in a result block\n  rp := g.result_pos\n  g.result_pos = false\n  // a value held until after the match and never assigned: a temporary of\n  // an outer scope, a constant, or a non-`mut` variable\n  stable := codegen.constant(v.op)\n    || codegen.is_temp(g, v.op)\n    || match scrutinee {\n      ast.Var(x) => match codegen.lookup(g, x) {\n        Some(l) => l.op != \"\",\n        None => false,\n      },\n      _ => false,\n    }\n  codegen.push_scope(mut g)\n  match binding {\n    Some(b) => codegen.let_owned(mut g, b, v),\n    None => (),\n  }\n  end := codegen.label(mut g, \"endmatch\")\n  mut incoming := []\n  // a constructor matched as written (`match Ok(()) { … }`, as compile-time\n  // code makes): only the arms that can match it\n  live := match scrutinee {\n    ast.CtorExpr { name: c, .. } => arms.filter(\n      a -> match a.pat {\n        ast.CtorPattern { name: p, .. } => p == c,\n        _ => true,\n      },\n    ),\n    _ => arms,\n  }\n  // the last arm: where its code starts, and where it goes when it fails\n  mut last := (0, \"\")\n  // when the arms so far accept every constructor with any contents, the\n  // last arm's constructor, the only one left, needs no test\n  all_ctors := match v.ty {\n    TNamed { .. } => codegen.ctors_of(g, v.ty),\n    _ => [],\n  }\n  mut covered := Set[String] {}\n  for (ai, a) in enumerate(live) {\n    whole := match a.pat {\n      ast.CtorPattern { name, args } => if contains(g.types.ctors, name) && codegen.takes_any(args) {\n        name\n      } else {\n        \"\"\n      },\n      _ => \"\",\n    }\n    sure := ai + 1 == len(live)\n      && whole != \"\"\n      && all_ctors != []\n      && all_ctors.all(c -> c == whole || contains(covered, c))\n    if whole != \"\" {\n      mut covered.insert(whole)\n    }\n    next := codegen.label(mut g, \"arm\")\n    from := len(g.lines)\n    codegen.push_scope(mut g)\n    // a trait value against a constructor pattern (`Log { lines }`): the\n    // held value, when its table is that type's\n    subject := match (v.ty, a.pat) {\n      (TTrait(tr), ast.CtorPattern { name: c, .. }) => match codegen.dyn_type_of(g, c) {\n        Some(t) => {\n          same := codegen.dyn_table_is(mut g, v, tr, t)\n          hit := codegen.label(mut g, \"dyn.hit\")\n          codegen.emit(\n            mut g,\n            f\"br i1 {same}, label %{hit}, label 