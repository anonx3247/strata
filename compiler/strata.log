ords := codegen.by_words(g, sym, ret)\n  r0 := if words {\n    codegen.V {\n      ty: ret,\n      op: codegen.call_words(mut g, ret, sym, vs),\n    }\n  } else {\n    codegen.call_bare(mut g, ret, sym, vs)\n  }\n  // each `mut` argument's slot (its value owned) written back to its place\n  for (slot, x, path, t) in backs {\n    match codegen.lookup(g, x) {\n      Some(l) => match get(lent, slot) {\n        Some(u) => {\n          (put, assign, done) := (\n            codegen.label(mut g, \"back.lent\"),\n            codegen.label(mut g, \"back.assign\"),\n            codegen.label(mut g, \"back.done\"),\n          )\n          codegen.emit(\n            mut g,\n            f\"br i1 {u}, label %{put}, label %{assign}\",\n          )\n          // lent: the returned value is stored in the field, which held\n          // nothing during the call\n          codegen.block(mut g, put)\n          codegen.push_transparent(mut g)\n          nb := codegen.fresh(mut g, \"back\")\n          codegen.emit(\n            mut g,\n            f\"{nb} = load {codegen.ll(t)}, ptr {slot}\",\n          )\n          nv := codegen.V { ty: t, op: nb }\n          codegen.check_field(mut g, l.ty, x, path, nv)\n          root := codegen.load(mut g, l)\n          n := len(path)\n          last := codegen.get_path(mut g, root, take(path, n - 1))\n          (k, _) := codegen.field_index(g, last.ty, get(path, n - 1) ?? \"\")\n          at := codegen.fresh(mut g, \"at\")\n          codegen.emit(\n            mut g,\n            f\"{at} = getelementptr i64, ptr {last.op}, i64 {k + 1}\",\n          )\n          codegen.store_slot(mut g, nv, at)\n          codegen.pop_scope(mut g)\n          codegen.br(mut g, done)\n          codegen.block(mut g, assign)\n          codegen.push_transparent(mut g)\n          nb2 := codegen.fresh(mut g, \"back\")\n          codegen.emit(\n            mut g,\n            f\"{nb2} = load {codegen.ll(t)}, ptr {slot}\",\n          )\n          codegen.assign_at(\n           