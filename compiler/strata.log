odegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// A method that only a union's members have: dispatched per member.\nfn union_call(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  ms: List[check.Ty],\n  name: String,\n  args: List[ast.Expr],\n) -> codegen.V {\n  vs := match codegen.operands(mut g, args) {\n    Some(vs) => vs,\n    None => return codegen.never(),\n  }\n  end := codegen.label(mut g, \"dispatched\")\n  labels := codegen.on_members(mut g, v, ms)\n  mut incoming := []\n  for (k, m) in enumerate(ms) {\n    codegen.block(mut g, get(labels, k) ?? \"\")\n    codegen.push_transparent(mut g)\n    km := codegen.method_key(mut g, codegen.head_of(m), name)\n    if km == \"\" {\n      codegen.not_yet(\n        mut g,\n        \"`.\" + name + \"` on a `\" + codegen.key(m) + \"`\",\n      )\n      return codegen.never()\n    }\n    nx := codegen.narrow(mut g, v, m)\n    r0 := codegen.call_fn(mut g, km, [nx] + vs, [])\n    r := codegen.leave_branch(mut g, r0)\n    mut incoming.push((r, codegen.current(g)))\n    codegen.br(mut g, end)\n  }\n  codegen.block(mut g, end)\n  r := codegen.join_values(mut g, incoming)\n  codegen.temp(mut g, r)\n}","old_text":"/// A method that only a union's members have: dispatched per member.\nfn union_call(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  ms: List[Ty],\n  name: String,\n  args: List[ast.Expr],\n) -> codegen.V {\n  vs := match codegen.operands(mut g, args) {\n    Some(vs) => vs,\n    None => return codegen.never(),\n  }\n  end := codegen.label(mut g, \"dispatched\")\n  labels := codegen.on_members(mut g, v, ms)\n  mut incoming := []\n  for (k, m) in enumerate(ms) {\n    codegen.block(mut g, get(labels, k) ?? \"\")\n    codegen.push_transparent(mut g)\n    km := codegen.method_key(mut g, codegen.head_of(m), name)\n    if km == \"\" {\n      codegen.not_yet(\n        mut g,\n        \"`.\" + name + \"` on a `\" + codegen.key(m) + \"`\",\n      )\n      return codegen.never()\n    }\n    nx := codegen.narrow(mut g, v, m)\n    r0 := codegen.call_fn(mut g, km, [nx] + vs, [])\n    r := codegen.leave_branch(mut g, r0)\n    mut incoming.push((r, codegen.current(g)))\n    codegen.br(mut g, end)\n  }\n  codegen.block(mut g, end)\n  r := codegen.join_values(mut g, incoming)\n  codegen.temp(mut g, r)\n}"},{"name":"codegen.checked","kind":"fn","old":"b599751a8874bc1e","new":"382c0ed2902cadaa","interface_changed":false,"affected":[],"module":"codegen","text":"/// Faults with `what: x` unless `x` holds. A comparison shows both sides.\nfn checked(mut g: codegen.Gen, x: ast.Expr, what: String) {\n  (ok, sides) := match x {\n    ast.Binary { op, left, right } => match op {\n      ast.And | ast.Or | ast.Implies => (codegen.expr(mut g, x), None),\n      _ => match codegen.compared(mut g, left, right) {\n        Some(vs) => {\n          (a, b) := (\n            get(vs, 0) ?? codegen.unit(),\n            get(vs, 1) ?? codegen.unit(),\n          )\n          (codegen.apply(mut g, op, a, b), Some((op, a, b)))\n        },\n        None => (codegen.never(), None),\n      },\n    },\n    _ => (codegen.expr(mut g, x), None),\n  }\n  if ok.ty is check.TAny {\n    return\n  }\n  (pass, fail) := (\n    codegen.label(mut g, \"assert.ok\"),\n    codegen.label(mut g, \"assert.fail\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"br i1 {ok.op}, label %{pass}, label %{fail}\",\n  )\n  codegen.block(mut g, fail)\n  // the message parts are never dropped: the fault ends the program\n  codegen.push_scope(mut g)\n  mut parts := [codegen.V { ty: check.TStr, op: codegen.string(\n    mut g,\n    what + \": \" + text.expr_text(codegen.short_names(x), 0),\n  ) }]\n  match sides {\n    Some((op, a, b)) => {\n      parts += [\n        codegen.V {\n          ty: check.TStr,\n          op: codegen.string(mut g, \" (left: \"),\n        },\n        codegen.shown(mut g, codegen.alike(a, b)),\n        codegen.V {\n          ty: check.TStr,\n          op: codegen.string(mut g, \", right: \"),\n        },\n        codegen.shown(mut g, codegen.alike(b, a)),\n        codegen.V { ty: check.TStr, op: codegen.string(mut g, \")\") },\n      ]\n    },\n    None => (),\n  }\n  m := codegen.concat(mut g, parts)\n  // 3: an assertion, in runtime.c's fault numbering\n  _ := codegen.call(\n    mut g,\n    check.TUnit,\n    \"strata_fault\",\n    [codegen.V { ty: check.TInt, op: \"3\" }, m],\n  )\n  codegen.emit(mut g, \"unreachable\")\n  codegen.discard_scope(mut g)\n  codegen.block(mut g, pass)\n}","old_text":"/// Faults with `what: x` unless `x` holds. A comparison shows both sides.\nfn checked(mut g: codegen.Gen, x: ast.Expr, what: String) {\n  (ok, sides) := match x {\n    ast.Binary { op, left, right } => match op {\n      ast.And | ast.Or | ast.Implies => (codegen.expr(mut g, x), None),\n      _ => match codegen.compared(mut g, left, right) {\n        Some(vs) => {\n          (a, b) := (\n            get(vs, 0) ?? codegen.unit(),\n            get(vs, 1) ?? codegen.unit(),\n          )\n          (codegen.apply(mut g, op, a, b), Some((op, a, b)))\n        },\n        None => (codegen.never(), None),\n      },\n    },\n    _ => (codegen.expr(mut g, x), None),\n  }\n  if ok.ty is TAny {\n    return\n  }\n  (pass, fail) := (\n    codegen.label(mut g, \"assert.ok\"),\n    codegen.label(mut g, \"assert.fail\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"br i1 {ok.op}, label %{pass}, label %{fail}\",\n  )\n  codegen.block(mut g, fail)\n  // the message parts are never dropped: the fault ends the program\n  codegen.push_scope(mut g)\n  mut parts := [codegen.V { ty: TStr, op: codegen.string(\n    mut g,\n    what + \": \" + text.expr_text(codegen.short_names(x), 0),\n  ) }]\n  match sides {\n    Some((op, a, b)) => {\n      parts += [\n        codegen.V {\n          ty: TStr,\n          op: codegen.string(mut g, \" (left: \"),\n        },\n        codegen.shown(mut g, codegen.alike(a, b)),\n        codegen.V {\n          ty: TStr,\n          op: codegen.string(mut g, \", right: \"),\n        },\n        codegen.shown(mut g, codegen.alike(b, a)),\n        codegen.V { ty: TStr, op: codegen.string(mut g, \")\") },\n      ]\n    },\n    None => (),\n  }\n  m := codegen.concat(mut g, parts)\n  // 3: an assertion, in runtime.c's fault numbering\n  _ := codegen.call(\n    mut g,\n    TUnit,\n    \"strata_fault\",\n    [codegen.V { ty: TInt, op: \"3\" }, m],\n  )\n  codegen.emit(mut g, \"unreachable\")\n  codegen.discard_scope(mut g)\n  codegen.block(mut g, pass)\n}"},{"name":"codegen.add_type","kind":"fn","old":"127f11c399e33a44","new":"e34289b95f8f69c9","interface_changed":false,"affected":[],"module":"codegen","text":"/// Adds a record or sum the checker does not model (a refined one).\nfn add_type(mut g: codegen.Gen, q: String, module: String, t: ast.TypeDecl) {\n  saved := g.sub\n  mut sub := Dict[String, check.Ty] {}\n  for p in t.params {\n    mut sub.insert(p, check.TGen(p))\n  }\n  g.sub = sub\n  mut named := {\n    mut copy := g.types.named\n    mut copy.insert(q, t.params)\n    copy\n  }\n  mut ctors := g.types.ctors\n  mut sums := g.types.sums\n  mut variants := g.types.variants\n  match t.body {\n    ast.RecordBody(fs) => {\n      mut xs := []\n      for f in fs {\n        mut xs.push((f.name, codegen.lower(mut g, f.ty)))\n      }\n      mut ctors.insert(\n        q,\n        check.Shape {\n          owner: q,\n          fields: xs,\n          positional: false,\n          required: [],\n          params: t.params,\n        },\n      )\n    },\n    ast.SumBody(vs) => {\n      mut sums.insert(q)\n      mut variants.insert(\n        q,\n        vs.map(v -> codegen.qualified(module, v.name)).sorted(),\n      )\n      for (vi, v) in enumerate(vs) {\n        (xs, positional) := match v.payload {\n          ast.Positional(ts) => {\n            mut ys := []\n            for x in ts {\n              mut ys.push((\"\", codegen.lower(mut g, x)))\n            }\n            (ys, true)\n          },\n          ast.RecordPayload(fs) => {\n            mut ys := []\n            for f in fs {\n              mut ys.push((f.name, codegen.lower(mut g, f.ty)))\n            }\n            (ys, false)\n          },\n          _ => ([], true),\n        }\n        c := codegen.qualified(module, v.name)\n        mut ctors.insert(\n          c,\n          check.Shape {\n            owner: q,\n            fields: xs,\n            positional,\n            required: [],\n            params: t.params,\n          },\n        )\n        mut g.tags.insert(c, codegen.stable_tag(q, vi))\n        // a variant is a type too: its values are blocks, never boxed\n        mut g.data.insert(c)\n      }\n    },\n    _ => (),\n  }\n  g.sub = saved\n  g.types = check.Types { ..g.types, named, ctors, sums, variants }\n  mut g.data.insert(q)\n  if !contains(g.tags, q) {\n    mut g.tags.insert(q, codegen.stable_tag(q, 0))\n  }\n}","old_text":"/// Adds a record or sum the checker does not model (a refined one).\nfn add_type(mut g: codegen.Gen, q: String, module: String, t: ast.TypeDecl) {\n  saved := g.sub\n  mut sub := Dict[String, Ty] {}\n  for p in t.params {\n    mut sub.insert(p, TGen(p))\n  }\n  g.sub = sub\n  mut named := {\n    mut copy := g.types.named\n    mut copy.insert(q, t.params)\n    copy\n  }\n  mut ctors := g.types.ctors\n  mut sums := g.types.sums\n  mut variants := g.types.variants\n  match t.body {\n    ast.RecordBody(fs) => {\n      mut xs := []\n      for f in fs {\n        mut xs.push((f.name, codegen.lower(mut g, f.ty)))\n      }\n      mut ctors.insert(\n        q,\n        Shape {\n          owner: q,\n          fields: xs,\n          positional: false,\n          required: [],\n          params: t.params,\n        },\n      )\n    },\n    ast.SumBody(vs) => {\n      mut sums.insert(q)\n      mut variants.insert(\n        q,\n        vs.map(v -> codegen.qualified(module, v.name)).sorted(),\n      )\n      for (vi, v) in enumerate(vs) {\n        (xs, positional) := match v.payload {\n          ast.Positional(ts) => {\n            mut ys := []\n            for x in ts {\n              mut ys.push((\"\", codegen.lower(mut g, x)))\n            }\n            (ys, true)\n          },\n          ast.RecordPayload(fs) => {\n            mut ys := []\n            for f in fs {\n              mut ys.push((f.name, codegen.lower(mut g, f.ty)))\n            }\n            (ys, false)\n          },\n          _ => ([], true),\n        }\n        c := codegen.qualified(module, v.name)\n        mut ctors.insert(\n          c,\n          Shape {\n            owner: q,\n            fields: xs,\n            positional,\n            required: [],\n            params: t.params,\n          },\n        )\n        mut g.tags.insert(c, codegen.stable_tag(q, vi))\n        // a variant is a type too: its values are blocks, never boxed\n        mut g.data.insert(c)\n      }\n    },\n    _ => (),\n  }\n  g.sub = saved\n  g.types = Types { ..g.types, named, ctors, sums, variants }\n  mut g.data.insert(q)\n  if !contains(g.tags, q) {\n    mut g.tags.insert(q, codegen.stable_tag(q, 0))\n  }\n}"},{"name":"codegen.with_it","kind":"fn","old":"0654287352bbc88e","new":"d8f35b289f6b011b","interface_changed":false,"affected":[],"module":"codegen","text":"/// `pred` with `it` bound to `v`, and the variables in scope. A refined\n/// record type also binds the fields it reads by name (`{ lo: Int, hi: Int }\n/// where lo <= hi`).\nfn with_it(mut g: codegen.Gen, v: codegen.V, pred: ast.Expr) -> codegen.V {\n  codegen.push_scope(mut g)\n  _ := codegen.local_value(mut g, \"it\", v)\n  match v.ty {\n    check.TNamed { name, .. } => if contains(g.types.ctors, name) {\n      used := codegen.names_in(pred, Set[String] {})\n      for (k, (f, ft)) in enumerate(codegen.fields_of(g, name, v.ty)) {\n        if contains(used, f) {\n          codegen.local_value(\n            mut g,\n            f,\n            codegen.field(mut g, v, k, ft),\n          )\n        }\n      }\n    },\n    _ => (),\n  }\n  ok := codegen.expr(mut g, pred)\n  codegen.pop_scope(mut g)\n  ok\n}","old_text":"/// `pred` with `it` bound to `v`, and the variables in scope. A refined\n/// record type also binds the fields it reads by name (`{ lo: Int, hi: Int }\n/// where lo <= hi`).\nfn with_it(mut g: codegen.Gen, v: codegen.V, pred: ast.Expr) -> codegen.V {\n  codegen.push_scope(mut g)\n  _ := codegen.local_value(mut g, \"it\", v)\n  match v.ty {\n    TNamed { name, .. } => if contains(g.types.ctors, name) {\n      used := codegen.names_in(pred, Set[String] {})\n      for (k, (f, ft)) in enumerate(codegen.fields_of(g, name, v.ty)) {\n        if contains(used, f) {\n          codegen.local_value(\n            mut g,\n            f,\n            codegen.field(mut g, v, k, ft),\n          )\n        }\n      }\n    },\n    _ => (),\n  }\n  ok := codegen.expr(mut g, pred)\n  codegen.pop_scope(mut g)\n  ok\n}"},{"name":"codegen.fail_unless","kind":"fn","old":"e09c365d00505a8b","new":"fd634dafe5be44e1","interface_changed":false,"affected":[],"module":"codegen","text":"/// Faults with `ctx: v msg` (a refinement's) unless `ok`.\nfn fail_unless(\n  mut g: codegen.Gen,\n  ok: codegen.V,\n  ctx: String,\n  more: List[codegen.V],\n  v: codegen.V,\n  msg: String,\n) {\n  if ok.ty is check.TAny {\n    return\n  }\n  (pass, fail) := (\n    codegen.label(mut g, \"check.ok\"),\n    codegen.label(mut g, \"check.fail\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"br i1 {ok.op}, label %{pass}, label %{fail}\",\n  )\n  codegen.block(mut g, fail)\n  codegen.push_scope(mut g)\n  sv := codegen.shown(mut g, v)\n  (head, colon, rest) := (\n    codegen.lit(mut g, ctx),\n    codegen.lit(mut g, \": \"),\n    codegen.lit(mut g, \" \" + msg),\n  )\n  codegen.fault(mut g, 0, [head] + more + [colon, sv, rest])\n  codegen.discard_scope(mut g)\n  codegen.br(mut g, pass)\n  codegen.block(mut g, pass)\n}","old_text":"/// Faults with `ctx: v msg` (a refinement's) unless `ok`.\nfn fail_unless(\n  mut g: codegen.Gen,\n  ok: codegen.V,\n  ctx: String,\n  more: List[codegen.V],\n  v: codegen.V,\n  msg: String,\n) {\n  if ok.ty is TAny {\n    return\n  }\n  (pass, fail) := (\n    codegen.label(mut g, \"check.ok\"),\n    codegen.label(mut g, \"check.fail\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"br i1 {ok.op}, label %{pass}, label %{fail}\",\n  )\n  codegen.block(mut g, fail)\n  codegen.push_scope(mut g)\n  sv := codegen.shown(mut g, v)\n  (head, colon, rest) := (\n    codegen.lit(mut g, ctx),\n    codegen.lit(mut g, \": \"),\n    codegen.lit(mut g, \" \" + msg),\n  )\n  codegen.fault(mut g, 0, [head] + more + [colon, sv, rest])\n  codegen.discard_scope(mut g)\n  codegen.br(mut g, pass)\n  codegen.block(mut g, pass)\n}"},{"name":"codegen.check_type","kind":"fn","old":"ec0ce97cfcab3f8b","new":"e9a450955278d99d","interface_changed":false,"affected":[],"module":"codegen","text":"/// The checks of a written type on a value. `ctx` says where.\nfn check_type(\n  mut g: codegen.Gen,\n  t: ast.TypeExpr,\n  v: codegen.V,\n  ctx: String,\n  more: List[codegen.V],\n) {\n  // skipped where `verify` proved it\n  if len(more) == 0\n    && codegen.proven(mut g, codegen.check_key(t, ctx), \"same\") {\n    return\n  }\n  // a union with refined members (written or by name): the value must\n  // satisfy the refinement of one of them\n  ws := match t {\n    ast.UnionType(xs) => xs,\n    ast.Named { name, args: [] } => match get(g.types.aliases, name) {\n      Some(ast.UnionType(xs)) => xs,\n      _ => [],\n    },\n    _ => [],\n  }\n  if len(ws) > 0 && ws.any(w -> codegen.needs_check(g, w)) {\n    return match v.ty {\n      check.TUnion(_) => codegen.check_union(mut g, ws, v, ctx, more),\n      // a value not yet made a union (a `let`'s, an assignment's): the\n      // members of its type\n      _ => codegen.check_member(mut g, ws, v, ctx, more),\n    }\n  }\n  // a refined type with type parameters (`NonEmpty[Int]`): its base with\n  // the arguments substituted, then its refinement\n  match codegen.generic_refined(g, t) {\n    Some((b, pred)) => {\n      codegen.check_type(mut g, b, v, ctx, more)\n      ok := codegen.with_it(mut g, v, pred)\n      codegen.fail_unless(\n        mut g,\n        ok,\n        ctx,\n        more,\n        v,\n        f\"does not satisfy `{text.type_text(t)}` (where {text.expr_text(pred, 0)})\",\n      )\n      return\n    },\n    None => (),\n  }\n  match t {\n    ast.Refined { base, pred } => {\n      codegen.check_type(mut g, base, v, ctx, more)\n      ok := codegen.with_it(mut g, v, pred)\n      codegen.fail_unless(\n        mut g,\n        ok,\n        ctx,\n        more,\n        v,\n        \"does not satisfy `\" + text.type_text(t) + \"`\",\n      )\n    },\n    ast.Named { name, args: [] } => match get(g.refines, name) {\n      Some((base, pred)) => {\n        // a `distinct` value is a one-field block, and its refinement is\n        // about that field (`it`), as at construction\n        if contains(g.distincts, name) {\n          match (v.ty, get(codegen.fields_of(g, name, v.ty), 0)) {\n            (check.TNamed { name: vn, .. }, Some((_, ft))) => if vn == name {\n              x := codegen.field(mut g, v, 0, ft)\n              ok := codegen.with_it(mut g, x, pred)\n              codegen.fail_unless(\n                mut g,\n                ok,\n                ctx,\n                more,\n                v,\n                f\"does not satisfy `{codegen.short(name)}` (where {text.expr_text(pred, 0)})\",\n              )\n              return\n            },\n            _ => (),\n          }\n        }\n        match base {\n          ast.Named { name: b, .. } => if b != name {\n            codegen.check_type(mut g, base, v, ctx, more)\n          },\n          _ => codegen.check_type(mut g, base, v, ctx, more),\n        }\n        ok := codegen.with_it(mut g, v, pred)\n        // the type's full name, `std.web.AttrName`\n        codegen.fail_unless(\n          mut g,\n          ok,\n          ctx,\n          more,\n          v,\n          f\"does not satisfy `{name}` (where {text.expr_text(pred, 0)})\",\n        )\n      },\n      None => (),\n    },\n    // a set's elements (`: element 3`), a dict's keys and values\n    // (`: key \"a\"`, `: [\"a\"]`)\n    ast.Named { name: \"Set\", args: [a] } => if codegen.needs_check(g, a) {\n      lv := codegen.list_view(mut g, v)\n      match lv.ty {\n        check.TList(et) => if !(et is check.TAny) {\n          at := codegen.each_start(mut g, lv)\n          codegen.push_scope(mut g)\n          x := codegen.list_at(mut g, lv, at.1, et)\n          sx := codegen.shown(mut g, x)\n          o := codegen.lit(mut g, \": element \")\n          codegen.check_type(mut g, a, x, ctx, more + [o, sx])\n          codegen.pop_scope(mut g)\n          codegen.each_next(mut g, at)\n        },\n        _ => (),\n      }\n    },\n    ast.Named { name: \"Dict\", args: [ka, va] } => if codegen.needs_check(g, ka) || codegen.needs_check(g, va) {\n      lv := codegen.list_view(mut g, v)\n      match lv.ty {\n        check.TList(check.TNamed { name: \"Tuple\", args: [kt, vt] }) => {\n          at := codegen.each_start(mut g, lv)\n          codegen.push_scope(mut g)\n          x := codegen.list_at(\n            mut g,\n            lv,\n            at.1,\n            check.TNamed { name: \"Tuple\", args: [kt, vt] },\n          )\n          k := codegen.field(mut g, x, 0, kt)\n          val := codegen.field(mut g, x, 1, vt)\n          sk := codegen.shown(mut g, k)\n          (o1, o2, c2) := (\n            codegen.lit(mut g, \": key \"),\n            codegen.lit(mut g, \": [\"),\n            codegen.lit(mut g, \"]\"),\n          )\n          codegen.check_type(mut g, ka, k, ctx, more + [o1, sk])\n          codegen.check_type(\n            mut g,\n            va,\n            val,\n            ctx,\n            more + [o2, sk, c2],\n          )\n          codegen.pop_scope(mut g)\n          codegen.each_next(mut g, at)\n        },\n        _ => (),\n      }\n    },\n    // an `Option`'s or `Result`'s payload of a refined type (`: Some.0`)\n    ast.Named { name: \"Option\", args: [a] } => if codegen.needs_check(g, a) {\n      codegen.check_payload(mut g, v, \"Some\", a, ctx, more)\n    },\n    ast.Named { name: \"Result\", args: [a, b] } => {\n      if codegen.needs_check(g, a) {\n        codegen.check_payload(mut g, v, \"Ok\", a, ctx, more)\n      }\n      if codegen.needs_check(g, b) {\n        codegen.check_payload(mut g, v, \"Err\", b, ctx, more)\n      }\n    },\n    ast.Named { name: \"List\", args: [a] } => match v.ty {\n      // an unknown element type (`[]`'s): no elements to check\n      check.TList(et) => if codegen.needs_check(g, a) && !(et is check.TAny) {\n        // each element: `[2]: -1 does not satisfy …`\n        at := codegen.each_start(mut g, v)\n        codegen.push_scope(mut g)\n        x := codegen.list_at(mut g, v, at.1, et)\n        idx := codegen.call(\n          mut g,\n          check.TStr,\n          \"strata_show_int\",\n          [codegen.V { ty: check.TInt, op: at.1 }],\n        )\n        (o, c) := (codegen.lit(mut g, \": [\"), codegen.lit(mut g, \"]\"))\n        codegen.check_type(mut g, a, x, ctx, more + [o, idx, c])\n        codegen.pop_scope(mut g)\n        codegen.each_next(mut g, at)\n      },\n      _ => (),\n    },\n    _ => (),\n  }\n}","old_text":"/// The checks of a written type on a value. `ctx` says where.\nfn check_type(\n  mut g: codegen.Gen,\n  t: ast.TypeExpr,\n  v: codegen.V,\n  ctx: String,\n  more: List[codegen.V],\n) {\n  // skipped where `verify` proved it\n  if len(more) == 0\n    && codegen.proven(mut g, codegen.check_key(t, ctx), \"same\") {\n    return\n  }\n  // a union with refined members (written or by name): the value must\n  // satisfy the refinement of one of them\n  ws := match t {\n    ast.UnionType(xs) => xs,\n    ast.Named { name, args: [] } => match get(g.types.aliases, name) {\n      Some(ast.UnionType(xs)) => xs,\n      _ => [],\n    },\n    _ => [],\n  }\n  if len(ws) > 0 && ws.any(w -> codegen.needs_check(g, w)) {\n    return match v.ty {\n      TUnion(_) => codegen.check_union(mut g, ws, v, ctx, more),\n      // a value not yet made a union (a `let`'s, an assignment's): the\n      // members of its type\n      _ => codegen.check_member(mut g, ws, v, ctx, more),\n    }\n  }\n  // a refined type with type parameters (`NonEmpty[Int]`): its base with\n  // the arguments substituted, then its refinement\n  match codegen.generic_refined(g, t) {\n    Some((b, pred)) => {\n      codegen.check_type(mut g, b, v, ctx, more)\n      ok := codegen.with_it(mut g, v, pred)\n      codegen.fail_unless(\n        mut g,\n        ok,\n        ctx,\n        more,\n        v,\n        f\"does not satisfy `{text.type_text(t)}` (where {text.expr_text(pred, 0)})\",\n      )\n      return\n    },\n    None => (),\n  }\n  match t {\n    ast.Refined { base, pred } => {\n      codegen.check_type(mut g, base, v, ctx, more)\n      ok := codegen.with_it(mut g, v, pred)\n      codegen.fail_unless(\n        mut g,\n        ok,\n        ctx,\n        more,\n        v,\n        \"does not satisfy `\" + text.type_text(t) + \"`\",\n      )\n    },\n    ast.Named { name, args: [] } => match get(g.refines, name) {\n      Some((base, pred)) => {\n        // a `distinct` value is a one-field block, and its refinement is\n        // about that field (`it`), as at construction\n        if contains(g.distincts, name) {\n          match (v.ty, get(codegen.fields_of(g, name, v.ty), 0)) {\n            (TNamed { name: vn, .. }, Some((_, ft))) => if vn == name {\n              x := codegen.field(mut g, v, 0, ft)\n              ok := codegen.with_it(mut g, x, pred)\n              codegen.fail_unless(\n                mut g,\n                ok,\n                ctx,\n                more,\n                v,\n                f\"does not satisfy `{codegen.short(name)}` (where {text.expr_text(pred, 0)})\",\n              )\n              return\n            },\n            _ => (),\n          }\n        }\n        match base {\n          ast.Named { name: b, .. } => if b != name {\n            codegen.check_type(mut g, base, v, ctx, more)\n          },\n          _ => codegen.check_type(mut g, base, v, ctx, more),\n        }\n        ok := codegen.with_it(mut g, v, pred)\n        // the type's full name, `std.web.AttrName`\n        codegen.fail_unless(\n          mut g,\n          ok,\n          ctx,\n          more,\n          v,\n          f\"does not satisfy `{name}` (where {text.expr_text(pred, 0)})\",\n        )\n      },\n      None => (),\n    },\n    // a set's elements (`: element 3`), a dict's keys and values\n    // (`: key \"a\"`, `: [\"a\"]`)\n    ast.Named { name: \"Set\", args: [a] } => if codegen.needs_check(g, a) {\n      lv := codegen.list_view(mut g, v)\n      match lv.ty {\n        TList(et) => if !(et is TAny) {\n          at := codegen.each_start(mut g, lv)\n          codegen.push_scope(mut g)\n          x := codegen.list_at(mut g, lv, at.1, et)\n          sx := codegen.shown(mut g, x)\n          o := codegen.lit(mut g, \": element \")\n          codegen.check_type(mut g, a, x, ctx, more + [o, sx])\n          codegen.pop_scope(mut g)\n          codegen.each_next(mut g, at)\n        },\n        _ => (),\n      }\n    },\n    ast.Named { name: \"Dict\", args: [ka, va] } => if codegen.needs_check(g, ka) || codegen.needs_check(g, va) {\n      lv := codegen.list_view(mut g, v)\n      match lv.ty {\n        TList(TNamed { name: \"Tuple\", args: [kt, vt] }) => {\n          at := codegen.each_start(mut g, lv)\n          codegen.push_scope(mut g)\n          x := codegen.list_at(\n            mut g,\n            lv,\n            at.1,\n            TNamed { name: \"Tuple\", args: [kt, vt] },\n          )\n          k := codegen.field(mut g, x, 0, kt)\n          val := codegen.field(mut g, x, 1, vt)\n          sk := codegen.shown(mut g, k)\n          (o1, o2, c2) := (\n            codegen.lit(mut g, \": key \"),\n            codegen.lit(mut g, \": [\"),\n            codegen.lit(mut g, \"]\"),\n          )\n          codegen.check_type(mut g, ka, k, ctx, more + [o1, sk])\n          codegen.check_type(\n            mut g,\n            va,\n            val,\n            ctx,\n            more + [o2, sk, c2],\n          )\n          codegen.pop_scope(mut g)\n          codegen.each_next(mut g, at)\n        },\n        _ => (),\n      }\n    },\n    // an `Option`'s or `Result`'s payload of a refined type (`: Some.0`)\n    ast.Named { name: \"Option\", args: [a] } => if codegen.needs_check(g, a) {\n      codegen.check_payload(mut g, v, \"Some\", a, ctx, more)\n    },\n    ast.Named { name: \"Result\", args: [a, b] } => {\n      if codegen.needs_check(g, a) {\n        codegen.check_payload(mut g, v, \"Ok\", a, ctx, more)\n      }\n      if codegen.needs_check(g, b) {\n        codegen.check_payload(mut g, v, \"Err\", b, ctx, more)\n      }\n    },\n    ast.Named { name: \"List\", args: [a] } => match v.ty {\n      // an unknown element type (`[]`'s): no elements to check\n      TList(et) => if codegen.needs_check(g, a) && !(et is TAny) {\n        // each element: `[2]: -1 does not satisfy …`\n        at := codegen.each_start(mut g, v)\n        codegen.push_scope(mut g)\n        x := codegen.list_at(mut g, v, at.1, et)\n        idx := codegen.call(\n          mut g,\n          TStr,\n          \"strata_show_int\",\n          [codegen.V { ty: TInt, op: at.1 }],\n        )\n        (o, c) := (codegen.lit(mut g, \": [\"), codegen.lit(mut g, \"]\"))\n        codegen.check_type(mut g, a, x, ctx, more + [o, idx, c])\n        codegen.pop_scope(mut g)\n        codegen.each_next(mut g, at)\n      },\n      _ => (),\n    },\n    _ => (),\n  }\n}"},{"name":"codegen.check_requires","kind":"fn","old":"cebe34312dd9de14","new":"d1ab8ded3e3603b6","interface_changed":false,"affected":[],"module":"codegen","text":"/// A precondition: faults naming the arguments unless it holds.\nfn check_requires(mut g: codegen.Gen, f: ast.FnDecl, r: ast.Expr) {\n  codegen.push_transparent(mut g)\n  ok := codegen.expr(mut g, r)\n  codegen.pop_scope(mut g)\n  if ok.ty is check.TAny {\n    return\n  }\n  (pass, fail) := (\n    codegen.label(mut g, \"requires.ok\"),\n    codegen.label(mut g, \"requires.fail\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"br i1 {ok.op}, label %{pass}, label %{fail}\",\n  )\n  codegen.block(mut g, fail)\n  codegen.push_scope(mut g)\n  mut parts := [\n    codegen.lit(\n      mut g,\n      f\"precondition of `{f.name}` violated: requires {text.expr_text(r, 0)} (with \",\n    ),\n  ]\n  for (i, p) in enumerate(f.params) {\n    sep := if i > 0 {\n      \", \"\n    } else {\n      \"\"\n    }\n    mut parts.push(codegen.lit(mut g, sep + p.name + \" = \"))\n    match codegen.lookup(g, p.name) {\n      Some(l) => {\n        pv := codegen.load(mut g, l)\n        mut parts.push(codegen.shown(mut g, pv))\n      },\n      None => (),\n    }\n  }\n  mut parts.push(codegen.lit(mut g, \")\"))\n  codegen.fault(mut g, 1, parts)\n  codegen.discard_scope(mut g)\n  codegen.br(mut g, pass)\n  codegen.block(mut g, pass)\n}","old_text":"/// A precondition: faults naming the arguments unless it holds.\nfn check_requires(mut g: codegen.Gen, f: ast.FnDecl, r: ast.Expr) {\n  codegen.push_transparent(mut g)\n  ok := codegen.expr(mut g, r)\n  codegen.pop_scope(mut g)\n  if ok.ty is TAny {\n    return\n  }\n  (pass, fail) := (\n    codegen.label(mut g, \"requires.ok\"),\n    codegen.label(mut g, \"requires.fail\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"br i1 {ok.op}, label %{pass}, label %{fail}\",\n  )\n  codegen.block(mut g, fail)\n  codegen.push_scope(mut g)\n  mut parts := [\n    codegen.lit(\n      mut g,\n      f\"precondition of `{f.name}` violated: requires {text.expr_text(r, 0)} (with \",\n    ),\n  ]\n  for (i, p) in enumerate(f.params) {\n    sep := if i > 0 {\n      \", \"\n    } else {\n      \"\"\n    }\n    mut parts.push(codegen.lit(mut g, sep + p.name + \" = \"))\n    match codegen.lookup(g, p.name) {\n      Some(l) => {\n        pv := codegen.load(mut g, l)\n        mut parts.push(codegen.shown(mut g, pv))\n      },\n      None => (),\n    }\n  }\n  mut parts.push(codegen.lit(mut g, \")\"))\n  codegen.fault(mut g, 1, parts)\n  codegen.discard_scope(mut g)\n  codegen.br(mut g, pass)\n  codegen.block(mut g, pass)\n}"},{"name":"codegen.check_ensures","kind":"fn","old":"ff974a6140620643","new":"19a28ea491c22825","interface_changed":false,"affected":[],"module":"codegen","text":"/// A postcondition, with `it` the result: faults showing it unless it holds.\nfn check_ensures(\n  mut g: codegen.Gen,\n  f: ast.FnDecl,\n  en: ast.Expr,\n  result: codegen.V,\n) {\n  // `old e` reads the value taken on entry (`keep_olds`)\n  codegen.push_transparent(mut g)\n  mut used := []\n  for o in g.olds {\n    if codegen.olds_of(en).any(x -> text.expr_text(x, 0) == o.0) {\n      _ := codegen.local_value(mut g, o.1, o.2)\n      mut used.push(o)\n    }\n  }\n  read := walk.rewrite_expr(en, e -> match e {\n    ast.Old(x) => match g.olds.filter(o -> o.0 == text.expr_text(x, 0)) {\n      [o, ..] => ast.Var(o.1),\n      [] => e,\n    },\n    _ => e,\n  })\n  ok := codegen.expr(mut g, read)\n  codegen.pop_scope(mut g)\n  if ok.ty is check.TAny {\n    return\n  }\n  (pass, fail) := (\n    codegen.label(mut g, \"ensures.ok\"),\n    codegen.label(mut g, \"ensures.fail\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"br i1 {ok.op}, label %{pass}, label %{fail}\",\n  )\n  codegen.block(mut g, fail)\n  codegen.push_scope(mut g)\n  // a function giving `()` shows only the `old` values\n  unit := result.ty is check.TUnit && used != []\n  m := codegen.lit(\n    mut g,\n    f\"postcondition of `{f.name}` violated: ensures {text.expr_text(en, 0)} (\"\n      + if unit {\n        \"\"\n      } else {\n        \"it = \"\n      },\n  )\n  mut parts := [m]\n  if !unit {\n    mut parts.push(codegen.shown(mut g, result))\n  }\n  // each `old e` before and after (`before: len(xs) = 2,\n  // after: len(xs) = 3`)\n  for (i, o) in enumerate(used) {\n    sep := if unit && i == 0 {\n      \"\"\n    } else {\n      \"; \"\n    }\n    mut parts.push(codegen.lit(mut g, f\"{sep}before: {o.0} = \"))\n    mut parts.push(codegen.shown(mut g, o.2))\n    mut parts.push(codegen.lit(mut g, f\", after: {o.0} = \"))\n    now := match codegen.olds_of(en).filter(x -> text.expr_text(x, 0) == o.0) {\n      [x, ..] => codegen.expr(mut g, x),\n      [] => o.2,\n    }\n    mut parts.push(codegen.shown(mut g, now))\n  }\n  close := codegen.lit(mut g, \")\")\n  codegen.fault(mut g, 2, parts + [close])\n  codegen.discard_scope(mut g)\n  codegen.br(mut g, pass)\n  codegen.block(mut g, pass)\n}","old_text":"/// A postcondition, with `it` the result: faults showing it unless it holds.\nfn check_ensures(\n  mut g: codegen.Gen,\n  f: ast.FnDecl,\n  en: ast.Expr,\n  result: codegen.V,\n) {\n  // `old e` reads the value taken on entry (`keep_olds`)\n  codegen.push_transparent(mut g)\n  mut used := []\n  for o in g.olds {\n    if codegen.olds_of(en).any(x -> text.expr_text(x, 0) == o.0) {\n      _ := codegen.local_value(mut g, o.1, o.2)\n      mut used.push(o)\n    }\n  }\n  read := walk.rewrite_expr(en, e -> match e {\n    ast.Old(x) => match g.olds.filter(o -> o.0 == text.expr_text(x, 0)) {\n      [o, ..] => ast.Var(o.1),\n      [] => e,\n    },\n    _ => e,\n  })\n  ok := codegen.expr(mut g, read)\n  codegen.pop_scope(mut g)\n  if ok.ty is TAny {\n    return\n  }\n  (pass, fail) := (\n    codegen.label(mut g, \"ensures.ok\"),\n    codegen.label(mut g, \"ensures.fail\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"br i1 {ok.op}, label %{pass}, label %{fail}\",\n  )\n  codegen.block(mut g, fail)\n  codegen.push_scope(mut g)\n  // a function giving `()` shows only the `old` values\n  unit := result.ty is TUnit && used != []\n  m := codegen.lit(\n    mut g,\n    f\"postcondition of `{f.name}` violated: ensures {text.expr_text(en, 0)} (\"\n      + if unit {\n        \"\"\n      } else {\n        \"it = \"\n      },\n  )\n  mut parts := [m]\n  if !unit {\n    mut parts.push(codegen.shown(mut g, result))\n  }\n  // each `old e` before and after (`before: len(xs) = 2,\n  // after: len(xs) = 3`)\n  for (i, o) in enumerate(used) {\n    sep := if unit && i == 0 {\n      \"\"\n    } else {\n      \"; \"\n    }\n    mut parts.push(codegen.lit(mut g, f\"{sep}before: {o.0} = \"))\n    mut parts.push(codegen.shown(mut g, o.2))\n    mut parts.push(codegen.lit(mut g, f\", after: {o.0} = \"))\n    now := match codegen.olds_of(en).filter(x -> text.expr_text(x, 0) == o.0) {\n      [x, ..] => codegen.expr(mut g, x),\n      [] => o.2,\n    }\n    mut parts.push(codegen.shown(mut g, now))\n  }\n  close := codegen.lit(mut g, \")\")\n  codegen.fault(mut g, 2, parts + [close])\n  codegen.discard_scope(mut g)\n  codegen.br(mut g, pass)\n  codegen.block(mut g, pass)\n}"},{"name":"codegen.for_list","kind":"fn","old":"12f9ab170d0698c4","new":"db14685f7cbe0774","interface_changed":false,"affected":[],"module":"codegen","text":"/// What a `for` loop runs over: a list, held. A non-`mut` variable's list\n/// is borrowed instead: the variable holds it through the loop, which\n/// can't assign it. For an iterator, the loop is\n/// compiled here (`iterate`) and the result is `None`, as for a value it\n/// cannot run over.\nfn for_list(\n  mut g: codegen.Gen,\n  iter: ast.Expr,\n  pat: ast.Pattern,\n  body: ast.Expr,\n) -> Option[codegen.V] {\n  v := codegen.expr(mut g, iter)\n  if v.ty is check.TAny {\n    return None\n  }\n  lv := codegen.list_view(mut g, v)\n  match lv.ty {\n    check.TList(_) => {\n      fixed := match iter {\n        ast.Var(x) => match codegen.lookup(g, x) {\n          Some(l) => l.op != \"\",\n          None => false,\n        },\n        _ => false,\n      }\n      Some(if fixed && lv.op == v.op {\n        lv\n      } else {\n        codegen.hold(mut g, lv)\n      })\n    },\n    _ => {\n      if codegen.method_key(mut g, codegen.head_of(v.ty), \"next\") != \"\" {\n        codegen.iterate(mut g, v, pat, body)\n      } else {\n        codegen.not_yet(\n          mut g,\n          \"`for` over a `\" + codegen.key(v.ty) + \"`\",\n        )\n      }\n      None\n    },\n  }\n}","old_text":"/// What a `for` loop runs over: a list, held. A non-`mut` variable's list\n/// is borrowed instead: the variable holds it through the loop, which\n/// can't assign it. For an iterator, the loop is\n/// compiled here (`iterate`) and the result is `None`, as for a value it\n/// cannot run over.\nfn for_list(\n  mut g: codegen.Gen,\n  iter: ast.Expr,\n  pat: ast.Pattern,\n  body: ast.Expr,\n) -> Option[codegen.V] {\n  v := codegen.expr(mut g, iter)\n  if v.ty is TAny {\n    return None\n  }\n  lv := codegen.list_view(mut g, v)\n  match lv.ty {\n    TList(_) => {\n      fixed := match iter {\n        ast.Var(x) => match codegen.lookup(g, x) {\n          Some(l) => l.op != \"\",\n          None => false,\n        },\n        _ => false,\n      }\n      Some(if fixed && lv.op == v.op {\n        lv\n      } else {\n        codegen.hold(mut g, lv)\n      })\n    },\n    _ => {\n      if codegen.method_key(mut g, codegen.head_of(v.ty), \"next\") != \"\" {\n        codegen.iterate(mut g, v, pat, body)\n      } else {\n        codegen.not_yet(\n          mut g,\n          \"`for` over a `\" + codegen.key(v.ty) + \"`\",\n        )\n      }\n      None\n    },\n  }\n}"},{"name":"codegen.generate","kind":"fn","old":"79f0d6cf828bf007","new":"b8ff4a7ac71e780c","interface_changed":false,"affected":[],"module":"codegen","text":"/// The program's `main` and what it calls as LLVM IR, or the constructs not\n/// compiled, each with its function. `assumed_clauses` also checks the\n/// assumed contract clauses (`--check-assumed`). Verify's fuzz drivers\n/// always check them.\npub fn generate(\n  given: List[ast.Decl],\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  proofs: List[String],\n  tests: Option[List[(String, String)]],\n  fuzz: List[String],\n  fuzz_text: Bool,\n  calls: List[String],\n  trace: Bool,\n  library: List[String],\n  precompiled: List[String],\n  bare: Bool,\n  copies: Option[Dict[String, String]],\n  memory_sites: Option[Dict[String, String]],\n  assumed_clauses: Bool,\n) -> Result[String, List[String]] {\n  // unused variables with no effect are not compiled (`unread_dropped`),\n  // and assumed contract clauses are left out (`assumed_compiled`)\n  keep := assumed_clauses || fuzz != []\n  // lemmas and proofs (`assert … by`, `calc`) are for `verify` alone: never\n  // compiled\n  (start, main) := match codegen.new_gen(\n    given\n      .filter(d -> !match d.kind {\n        ast.FnDef(f) => f.lemma,\n        _ => false,\n      })\n      .map(d -> walk.rewrite_decl(\n        codegen.assumed_compiled(d, keep),\n        x -> codegen.unread_dropped(codegen.proofs_dropped(x)),\n      )),\n    core,\n    prelude,\n    proofs,\n    tests,\n    fuzz,\n    fuzz_text,\n    calls,\n    trace,\n    library,\n    precompiled,\n  ) {\n    Ok(x) => x,\n    Err(es) => return Err(es),\n  }\n  // core.rt (`bare`): no call-stack frames, no cancel points\n  mut g := if bare {\n    codegen.Gen { ..start, bare: true, tasks: false, supervises: false }\n  } else {\n    start\n  }\n  // `--copies`: report copies with their locations\n  match copies {\n    Some(sites) => {\n      g.copies = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  // (`--memory-sites`: each counting operation counted, by site)\n  match memory_sites {\n    Some(sites) => {\n      g.memory_sites = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  mut bodies := match tests {\n    // each test as `strata test` runs it (`strata.test.N`), with its name\n    Some(ts) => enumerate(ts).map(x -> codegen.test_entry(x.0, x.1.0, x.1.1)),\n    None => if fuzz != [] || library != [] || calls != [] {\n      []\n    } else if main.name == \"\" {\n      // a library starts when it is loaded\n      [codegen.library_start(mut g)]\n    } else {\n      [codegen.entry(mut g, main)]\n    },\n  }\n  // std's library runs in any program, with tasks or without. It holds its\n  // functions by key and its `impl`s' methods (`library_methods`), except\n  // those `!KEY` excludes. Generic functions, those depending on the\n  // compile, and trait values are compiled per program instead.\n  mut roots := []\n  mut held := []\n  left_out := set(library\n    .filter(k -> starts_with(k, \"!\"))\n    .map(k -> byte_slice(k, 1, byte_len(k))))\n  mut wanted := library.filter(k -> !starts_with(k, \"!\"))\n  if library != [] {\n    wanted += codegen.library_methods(mut g).filter(\n      k -> !contains(left_out, k),\n    )\n  }\n  for k in wanted {\n    match codegen.fn_of(g, k) {\n      Some(f) => if codegen.precompilable(mut g, k, f) {\n        sym := codegen.instance(mut g, k, f, Dict[String, check.Ty] {})\n        mut roots.push(sym)\n        mut held.push(k)\n      },\n      None => (),\n    }\n  }\n  // verify's fuzz drivers (`strata.fuzz.N`)\n  for (i, k) in enumerate(fuzz) {\n    mut bodies.push(codegen.fuzz_driver(mut g, i, k))\n  }\n  // `strata run f ARGS` calls (`strata.call.N`). `session:KEY` is a\n  // `strata repl` line, with the session's arguments.\n  for (i, k) in enumerate(calls) {\n    mut bodies.push(\n      if starts_with(k, \"session:\") {\n        codegen.session_entry(\n          mut g,\n          i,\n          byte_slice(k, 8, byte_len(k)),\n        )\n      } else {\n        codegen.call_entry(mut g, i, k)\n      },\n    )\n  }\n  // the exports of `derive C for f`, each under its symbol\n  if fuzz == [] && library == [] && calls == [] && tests is None {\n    for (symbol, k) in codegen.exports_of(given) {\n      mut bodies.push(codegen.export_entry(mut g, symbol, k))\n    }\n  }\n  // the files they generate: the C header\n  parts := match codegen.file_parts(given) {\n    Ok(ps) => ps,\n    Err(e) => return Err([e]),\n  }\n  // Each reachable function instance, once, in rounds. The workers compile\n  // each function of a round alone from the state the round began with.\n  // Their additions are then merged in queue order, so the output does not\n  // depend on thread timing.\n  if len(g.queue) > 0 && g.keeps is None {\n    g.keeps = Some(codegen.kept_by(g.fns))\n  }\n  // the updates in place proven to find their value held once, for builds\n  // and tests (not for verify's fuzzing, `strata run f` and compile-time\n  // code, which run once). Only a program's build sees every call of its\n  // functions (`closed`).\n  if len(g.queue) > 0 && !bare && fuzz == [] && calls == [] {\n    closed := library == []\n      && tests is None\n      && main.name != \"\"\n      && codegen.exports_of(given) == []\n    g.proven = unique.proven_sites(\n      g.fns,\n      codegen.keeps_of(mut g),\n      closed,\n      g.distincts,\n      g.traits,\n    )\n  }\n  // (`--memory-sites`: where scoped allocation would put each value)\n  if g.memory_sites && len(g.queue) > 0 {\n    g.roots = roots.verdicts(\n      g.fns,\n      codegen.keeps_of(mut g),\n      g.traits,\n      g.proven,\n    )\n  }\n  mut global_keys := set(g.globals.map(l -> codegen.global_key(l)))\n  mut def_keys := set(g.helper_defs.map(d -> codegen.def_key(d)))\n  while len(g.queue) > 0 {\n    round := g.queue\n    g.queue = []\n    base := g\n    for (body, d) in parallel.map(\n      round,\n      item -> codegen.compiled_alone(base, item.0, item.1, main),\n    ) {\n      mut bodies.push(body)\n      codegen.merge_alone(\n        mut g,\n        base,\n        d,\n        mut global_keys,\n        mut def_keys,\n      )\n    }\n  }\n  if len(g.errs) > 0 {\n    // std's library leaves out the functions that reach something not\n    // compiled\n    if library != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      out := wanted.filter(k -> contains(left, k))\n      if out != [] {\n        return Err(out.map(k -> \"leave out: \" + k))\n      }\n    }\n    // verify's fuzz drivers: each one reaching something not compiled is\n    // reported as `can't fuzz `KEY`: WHY`, so `verify` drops them all at\n    // once\n    if fuzz != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      callees := codegen.callees_of(g.callers)\n      return Err(g.errs\n        + fuzz\n          .filter(k -> contains(left, \"fuzz:\" + k))\n          .map(k -> \"can't fuzz `\"\n            + k\n            + \"`: \"\n            + join(\n              codegen.failures_of(callees, g.why, \"fuzz:\" + k),\n              \"; \",\n            )))\n    }\n    return Err(g.errs)\n  }\n  mut out := [\n    \"; Strata, compiled by compiler/codegen\",\n    f\"; checks left out {g.left_out}, kept {g.kept}\",\n    \"\",\n  ]\n  // std's library lists the functions it holds: `; precompiled NAME`\n  out += held.map(k -> \"; precompiled \" + k)\n  out += parts.map(p -> codegen.file_line(p.0, p.1))\n  // the symbols a library exports (`; export add`); the rest are hidden\n  out += if fuzz == [] && library == [] && calls == [] && tests is None {\n    codegen.exports_of(given).map(e -> \"; export \" + e.0)\n  } else {\n    []\n  }\n  out += g.globals\n  mut out.push(\"\")\n  // std's library exposes only its functions\n  out += if library != [] {\n    codegen.internal(bodies + g.helper_defs, set(roots))\n  } else {\n    bodies + g.helper_defs\n  }\n  for d in codegen.declarations() {\n    if contains(g.used, d.0) {\n      mut out.push(d.1)\n    }\n  }\n  ir_text := join(out, \"\\n\") + \"\\n\"\n  Ok(if g.memory_sites {\n    codegen.counted_sites(ir_text)\n  } else {\n    ir_text\n  })\n}","old_text":"/// The program's `main` and what it calls as LLVM IR, or the constructs not\n/// compiled, each with its function. `assumed_clauses` also checks the\n/// assumed contract clauses (`--check-assumed`). Verify's fuzz drivers\n/// always check them.\npub fn generate(\n  given: List[ast.Decl],\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  proofs: List[String],\n  tests: Option[List[(String, String)]],\n