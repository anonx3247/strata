routed","binary.decl","reach","impls","dep_tests","codegen.raw_call","codegen.dyn_equal","codegen.conversion","codegen.list_slice","binary.definition_at","binary.decode_interface","load","roots.closure_rule","roots.counted_source","check.methods_of","check.with_code","finding.names","impl_instance","for_impl_decl","method_decl","law_wrapper","verify_wrappers","site_inputs","smt.methods_of","codegen.as_type","binary.decode_definition","binary.entry_with","finding.interface_of","std_imports","kept_value","binary.decode_entry","binary.module_with","finding.decl_of","members_of","lib_scope","binary.decode_module","binary.read_with","binary.decode_module_checked","binary.read","binary.read_checked","tree","same","hashes","decls_of","decode_file","decoded_files","tour.package_decls","bad","derive.implements_trait","diff.diff_text","merge.similarity","smt.valid_known","diff.closure_hash","viewed_program","lint_decls","file_problem","module_decls","package_decls","codegen.outcome","codegen.host_snapshot","diff.close","read_core","own_decls","read_core_at","derived_trait_roots","others_at","open_package_at","status_command","diff.line_diff","open_package"],"module":"text","text":"/// An element's tag (`\"\"` for `<>…</>`), its attributes as shown, and its\n/// children as shown (`None`: no children, written `<tag />`). `broken`:\n/// each child goes on its own line, so text with spaces at an end is\n/// written `{\"…\"}`.\nfn markup_parts(\n  e: ast.Expr,\n  d: Int,\n  broken: Bool,\n) -> Option[(String, List[String], Option[List[String]])] {\n  (f, args) := text.web_fn(e)?\n  (tag, attrs, items) := if f == \"element\" && len(args) == 3 {\n    tag := match get(args, 0) {\n      Some(ast.StrLit(t)) => t,\n      _ => return None,\n    }\n    if !matches(tag, \"[a-z][a-z0-9]*(-[a-z0-9]+)*\") {\n      return None\n    }\n    attrs := match get(args, 1) {\n      Some(ast.ListExpr(xs)) => xs,\n      _ => return None,\n    }\n    kids := get(args, 2) ?? ast.UnitExpr\n    items := match kids {\n      ast.ListExpr(xs) => if len(xs) == 0 {\n        None\n      } else {\n        return None\n      },\n      _ => match text.web_fn(kids) {\n        Some((\"children\", [ast.ListExpr(xs)])) => if len(xs) > 0 && !text.is_void_tag(tag) {\n          Some(xs)\n        } else {\n          return None\n        },\n        _ => return None,\n      },\n    }\n    (tag, attrs, items)\n  } else if f == \"children\" {\n    match args {\n      [ast.ListExpr(xs)] => (\"\", [], Some(xs)),\n      _ => return None,\n    }\n  } else {\n    return None\n  }\n  mut shown := []\n  for a in attrs {\n    mut shown.push(text.markup_attr_view(a, d)?)\n  }\n  match items {\n    None => Some((tag, shown, None)),\n    Some(xs) => {\n      mut out := []\n      mut after_text := false\n      for x in xs {\n        (s, bare) := text.markup_child(x, d, broken, after_text)\n        mut out.push(s)\n        after_text = bare\n      }\n      Some((tag, shown, Some(out)))\n    },\n  }\n}","old_text":"/// An element's start tag (the whole element when it has no children),\n/// its children as shown, and its end tag. `broken`: each child goes on its\n/// own line, so text with spaces at an end is written `{\"…\"}`.\nfn markup_parts(\n  e: ast.Expr,\n  d: Int,\n  broken: Bool,\n) -> Option[(String, List[String], String)] {\n  (f, args) := text.web_fn(e)?\n  (tag, attrs, items) := if f == \"element\" && len(args) == 3 {\n    tag := match get(args, 0) {\n      Some(ast.StrLit(t)) => t,\n      _ => return None,\n    }\n    if !matches(tag, \"[a-z][a-z0-9]*(-[a-z0-9]+)*\") {\n      return None\n    }\n    attrs := match get(args, 1) {\n      Some(ast.ListExpr(xs)) => xs,\n      _ => return None,\n    }\n    kids := get(args, 2) ?? ast.UnitExpr\n    items := match kids {\n      ast.ListExpr(xs) => if len(xs) == 0 {\n        None\n      } else {\n        return None\n      },\n      _ => match text.web_fn(kids) {\n        Some((\"children\", [ast.ListExpr(xs)])) => if len(xs) > 0 && !text.is_void_tag(tag) {\n          Some(xs)\n        } else {\n          return None\n        },\n        _ => return None,\n      },\n    }\n    (tag, attrs, items)\n  } else if f == \"children\" {\n    match args {\n      [ast.ListExpr(xs)] => (\"\", [], Some(xs)),\n      _ => return None,\n    }\n  } else {\n    return None\n  }\n  mut shown := []\n  for a in attrs {\n    mut shown.push(text.markup_attr_view(a, d)?)\n  }\n  head := \"<\" + tag + join(shown.map(s -> \" \" + s), \"\")\n  match items {\n    None => Some((head + \" />\", [], \"\")),\n    Some(xs) => {\n      mut out := []\n      mut after_text := false\n      for x in xs {\n        (s, bare) := text.markup_child(x, d, broken, after_text)\n        mut out.push(s)\n        after_text = bare\n      }\n      Some((head + \">\", out, \"</\" + tag + \">\"))\n    },\n  }\n}"}]}
{"id":"6f1898d226c820db","time":1795712682,"message":"edit","changes":[{"name":"text.markup_view","kind":"fn","old":"a3a303bb85860932","new":"fa719ba65f91b7cd","interface_changed":false,"affected":[],"module":"text","text":"/// Calls the parser made from markup, shown as markup: `<p class=\"x\">Hi\n/// {name}</p>` for `web.element(\"p\", [web.attr(\"class\", \"x\")],\n/// web.children([\"Hi \", name]))`, `<>…</>` for `web.children([…])`. `None`\n/// for anything else, and for calls that markup can't write the same way\n/// (an attribute that isn't one of `web.attr`, `web.attribute`, `web.flag`\n/// or an `on_` event, a void element with children), which are shown as\n/// calls. On one line when it fits, else each child on its own line, and\n/// each attribute too when the start tag is too long.\nfn markup_view(e: ast.Expr, d: Int) -> Option[String] {\n  one := text.markup_line(e, d)?\n  if !text.too_long(one, d) && !contains(one, \"\\n\") {\n    return Some(one)\n  }\n  (tag, attrs, items) := text.markup_parts(e, d + 1, true)?\n  short := \"<\" + tag + join(attrs.map(a -> \" \" + a), \"\")\n  start := if text.too_long(short, d) || contains(short, \"\\n\") {\n    \"<\"\n      + tag\n      + join(attrs.map(a -> \"\\n\" + text.ind(d + 1) + a), \"\")\n      + \"\\n\"\n      + text.ind(d)\n  } else {\n    short\n      + if items == None {\n        \" \"\n      } else {\n        \"\"\n      }\n  }\n  match items {\n    None => Some(start + \"/>\"),\n    Some(xs) => Some(start\n      + \">\"\n      + join(xs.map(i -> \"\\n\" + text.ind(d + 1) + i), \"\")\n      + \"\\n\"\n      + text.ind(d)\n      + \"</\"\n      + tag\n      + \">\"),\n  }\n}","old_text":"/// Calls the parser made from markup, shown as markup: `<p class=\"x\">Hi\n/// {name}</p>` for `web.element(\"p\", [web.attr(\"class\", \"x\")],\n/// web.children([\"Hi \", name]))`, `<>…</>` for `web.children([…])`. `None`\n/// for anything else, and for calls that markup can't write the same way\n/// (an attribute that isn't one of `web.attr`, `web.attribute`, `web.flag`\n/// or an `on_` event, a void element with children), which are shown as\n/// calls. On one line when it fits, else each child on its own line, and\n/// each attribute too when the start tag is too long.\nfn markup_view(e: ast.Expr, d: Int) -> Option[String] {\n  one := text.markup_line(e, d)?\n  if !text.too_long(one, d) && !contains(one, \"\\n\") {\n    return Some(one)\n  }\n  (tag, attrs, items) := text.markup_parts(e, d + 1, true)?\n  short := \"<\" + tag + join(attrs.map(a -> \" \" + a), \"\")\n  start := if text.too_long(short, d) || contains(short, \"\\n\") {\n    \"<\"\n      + tag\n      + join(attrs.map(a -> \"\\n\" + text.ind(d + 1) + a), \"\")\n      + \"\\n\"\n      + text.ind(d)\n  } else {\n    short\n      + if len(attrs) > 0 && items == None {\n        \" \"\n      } else {\n        \"\"\n      }\n  }\n  match items {\n    None => Some(start + \"/>\"),\n    Some(xs) => Some(start\n      + \">\"\n      + join(xs.map(i -> \"\\n\" + text.ind(d + 1) + i), \"\")\n      + \"\\n\"\n      + text.ind(d)\n      + \"</\"\n      + tag\n      + \">\"),\n  }\n}"}]}
{"id":"f28152e7d0e5b7d4","time":1795712761,"message":"edit","changes":[{"name":"text.markup_parts","kind":"fn","old":"8a0707398c629f13","new":"41b909589333005c","interface_changed":false,"affected":[],"module":"text","text":"/// An element's tag (`\"\"` for `<>…</>`), its attributes as shown, and its\n/// children as shown (`None`: no children, written `<tag />`). `broken`:\n/// each child goes on its own line, so text with spaces at an end is\n/// written `{\"…\"}`.\nfn markup_parts(\n  e: ast.Expr,\n  d: Int,\n  broken: Bool,\n) -> Option[(String, List[String], Option[List[String]])] {\n  (f, args) := text.web_fn(e)?\n  (tag, attrs, items) := if f == \"element\" && len(args) == 3 {\n    tag := match get(args, 0) {\n      Some(ast.StrLit(t)) => t,\n      _ => return None,\n    }\n    if !matches(tag, \"[a-z][a-z0-9]*(-[a-z0-9]+)*\") {\n      return None\n    }\n    attrs := match get(args, 1) {\n      Some(ast.ListExpr(xs)) => xs,\n      _ => return None,\n    }\n    kids := get(args, 2) ?? ast.UnitExpr\n    items := match kids {\n      ast.ListExpr(xs) => if len(xs) == 0 {\n        None\n      } else {\n        return None\n      },\n      _ => match text.web_fn(kids) {\n        Some((\"children\", [ast.ListExpr(xs)])) => if len(xs) > 0 && !text.is_void_tag(tag) {\n          Some(xs)\n        } else {\n          return None\n        },\n        _ => return None,\n      },\n    }\n    (tag, attrs, items)\n  } else if f == \"children\" {\n    match args {\n      [ast.ListExpr(xs)] => (\"\", [], Some(xs)),\n      _ => return None,\n    }\n  } else {\n    return None\n  }\n  mut shown := []\n  for a in attrs {\n    mut shown.push(text.markup_attr_view(a, d)?)\n  }\n  match items {\n    None => Some((tag, shown, None)),\n    Some(xs) => Some((tag, shown, Some(if broken {\n      text.markup_lines(xs, d)\n    } else {\n      text.markup_children_line(xs, d)\n    }))),\n  }\n}","old_text":"/// An element's tag (`\"\"` for `<>…</>`), its attributes as shown, and its\n/// children as shown (`None`: no children, written `<tag />`). `broken`:\n/// each child goes on its own line, so text with spaces at an end is\n/// written `{\"…\"}`.\nfn markup_parts(\n  e: ast.Expr,\n  d: Int,\n  broken: Bool,\n) -> Option[(String, List[String], Option[List[String]])] {\n  (f, args) := text.web_fn(e)?\n  (tag, attrs, items) := if f == \"element\" && len(args) == 3 {\n    tag := match get(args, 0) {\n      Some(ast.StrLit(t)) => t,\n      _ => return None,\n    }\n    if !matches(tag, \"[a-z][a-z0-9]*(-[a-z0-9]+)*\") {\n      return None\n    }\n    attrs := match get(args, 1) {\n      Some(ast.ListExpr(xs)) => xs,\n      _ => return None,\n    }\n    kids := get(args, 2) ?? ast.UnitExpr\n    items := match kids {\n      ast.ListExpr(xs) => if len(xs) == 0 {\n        None\n      } else {\n        return None\n      },\n      _ => match text.web_fn(kids) {\n        Some((\"children\", [ast.ListExpr(xs)])) => if len(xs) > 0 && !text.is_void_tag(tag) {\n          Some(xs)\n        } else {\n          return None\n        },\n        _ => return None,\n      },\n    }\n    (tag, attrs, items)\n  } else if f == \"children\" {\n    match args {\n      [ast.ListExpr(xs)] => (\"\", [], Some(xs)),\n      _ => return None,\n    }\n  } else {\n    return None\n  }\n  mut shown := []\n  for a in attrs {\n    mut shown.push(text.markup_attr_view(a, d)?)\n  }\n  match items {\n    None => Some((tag, shown, None)),\n    Some(xs) => {\n      mut out := []\n      mut after_text := false\n      for x in xs {\n        (s, bare) := text.markup_child(x, d, broken, after_text)\n        mut out.push(s)\n        after_text = bare\n      }\n      Some((tag, shown, Some(out)))\n    },\n  }\n}"},{"name":"text.markup_child","kind":"fn","old":"5e0239a81f545cba","new":"800ea9fa15abf59f","interface_changed":true,"affected":["text.markup_children_line","text.markup_parts","text.markup_lines","text.markup_view","text.markup_line","text.expr_text","capabilities.noalloc_sites","capabil