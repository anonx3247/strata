{"id":"024c892077102053","time":1795708097,"message":"edit","changes":[{"name":"check.Inf","kind":"type","old":"6ac8287c131ac814","new":"30107196989adb99","interface_changed":true,"affected":["check.fresh","check.resolve","check.res","check.unify","check.error","check.expect","check.join_union","check.numeric","check.fresh_for","check.place","check.bind_typed","check.infer_all","check.binary","check.infer_block","check.infer_call","check.infer_if","check.infer_list","check.infer_match","check.infer_ctor","check.infer_lambda","check.infer","check.infer_method","check.var_type","check.is_sum","check.fresh_scheme","check.builtin_call","check.fits_all","check.element_of","check.fits","check.arm_variants","check.implements","check.bound_method","check.program_type","check.static_call","check.arm_members","check.as_trait","check.trait_method","check.fn_inferred","check.annotated","check.next_let","check.fill","check.wrong_try","check.not_result","check.not_iterable","check.check_spec","check.early_error","check.awaited","check.not_awaitable","check.outside_scope","check.own_trait_of","check.trait_fn","check.reaches","check.solve_pending","check.holds_sender","check.written_calls","check.infer_untagged","check.sized_expected","check.int_literal","check.sized_operands","check.task_body","check.fill_arms","check.lam_unmarked","check.holes_found","check.code_trait_method","check.default_errors","check.owned_reads","check.traits_declaring","check.implements_trait","check.ambiguity","check.self_args","check.named_refinement","check.excluded_by","check.ctor_fields","check.member_for","check.cover_of","check.atoms","check.covers","check.missing","check.useful","check.check_coverage","check.type_of_column","check.mut_narrower","check.written_cover","check.refinement_within","check.code_method_problem","check.unmet_bound","check.iter_builtin","check.own_calls","check.trait_fn_of","check.element_assigned","check.listed_arg","check.as_listed","check.listed_args","check.string_method","check.tuple_taken_apart","check.lam_written","check.unused_values","check.changing_call","check.allocating_arith","check.noalloc_typed","check.spread_calls","check.spread_error","check.infer_spread","check.spread_fn_params","check.spread_method_params","check.spread_method_of","check.spread_filled","check.dropped_results","check.trait_with_method","check.provided_method","check.read_owners","check.named_types","check.narrowed_result","check.narrow_by","check.result_variants","check.variants_named","check.decide","check.variants_field","check.variants_covered","check.narrowed_at","check.fn_errors","check.instantiated","check.fn_lambdas_typed","check.holes_of","check.mark_field_reads","check.own_methods_resolved","check.typed_one","check.decl_type_errors","check.spread_body","check.field_reads","eval_files","instantiated_files","check.lambdas_typed","holes_command","check_summary","finding.uses_of","rename_command","verified_decls","check.typed","check.type_errors_with","check.spreads_resolved","unused.members","command_line","check_command","finding.uses_from","finding.used_by_tree","finding.refs_command","verified_with","static_graph","codegen.new_gen","computed_value","repl_eval","check.type_errors","check_errors_in","literal_errors","expanded","unused.findings","main","strata_command","finding.uses_tree","verified_program","verify_file","build_command","graph_command","graph_diff","tour_graph","codegen.generate","codegen.read_back","comptime_value","repl_command","check_errors_with","edit_errors","literal_errors_of","codegen_with","with_base","unused_of","edit_unused","core_unused","codegen.entry","codegen.compiled_alone","eval.run","smt_file","termination_file","verify_command","build_proofs","alongside_command","search_invariants","diff_command","tour_command","core_rt_text","comptime_values","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","codegen_text","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","run_command","fix_loops","build_core_command","comptime_runner","package_errors","merge_file_command","merged_checks","call_command","edit_command","check_files","move_command","fix_command","edit_in_editor","codegen_file","jit_file","fuzz_file","graph_runs","replay","or_solver_inputs","program_objects","sync_command","check_fn","linked"],"module":"check","text":"/// The inference's state: what type variables stand for, the next fresh\n/// one, the errors found, the program's functions, and the return type of\n/// the function being checked.\ntype Inf = {\n  subst: Dict[Int, check.Ty],\n  next: Int,\n  errs: List[String],\n  fns: Dict[String, check.Ty],\n  ret: check.Ty,\n  types: check.Types,\n  tparams: Set[String],\n  // the traits each type parameter in scope is bound by\n  tbounds: Dict[String, List[String]],\n  methods: check.Methods,\n  narrowed: Set[String],\n  // the variables an arm assigns to: their declared types there\n  exempt: Set[String],\n  // the variables declared outside the innermost `scope` (None: in none)\n  outside: Option[Set[String]],\n  // the variables from outside the closure or `spawn` being checked\n  captured: Set[String],\n  builtins: Dict[String, List[check.Builtin]],\n  // each variable declared (`x := e`, `mut x := e`) and the type it got, in\n  // the order met; `typed` writes them into the tree\n  lets: List[(String, check.Ty)],\n  // each lambda parameter marked by `lambdas_typed` (`$lam…`) and the type\n  // it got\n  lambdas: Dict[String, check.Ty],\n  // the trait obligations met (a trait's method used as a function: its\n  // `Self`, the trait, the method), solved once the body is checked\n  pending: List[(check.Ty, String, String)],\n  // the type of each call tagged by `instantiated` (`f#3(..)`, `x.m#4(..)`)\n  insts: Dict[String, check.Ty],\n  // each arithmetic operation met (`+`, `-`, ...) and its type. On `Int`,\n  // `String` or `List` it allocates, which `noalloc` code can't do.\n  arith: List[(String, check.Ty)],\n  // each hole met (`?name`): the type it must have, and the variables in\n  // scope there with their types (`strata holes`)\n  holes: List[(String, check.Ty, Dict[String, check.Ty])] = [],\n  // each variable's type as written, when refined (`n: Positive`, or the\n  // refinement an arm named: `Positive => …`); a match on it may leave out\n  // what the refinement excludes\n  written: Dict[String, ast.TypeExpr] = Dict[String, ast.TypeExpr] {},\n  // each argument that is a finite iterator where its parameter is a `List`\n  // (the callee's name, the argument's index, the argument); `as_listed`\n  // converts them with `to_list`\n  as_lists: List[(String, Int, ast.Expr)] = [],\n  // each expression statement met, its type, and the type of the variable\n  // its call's first argument names (`xs` in `push(xs, 1)`), if any. A\n  // value other than `()` is an error once the body is solved (`unused_values`).\n  discarded: List[(ast.Expr, check.Ty, Option[check.Ty])] = [],\n  // each call spreading records (`f(...x)`, tagged `f#s0_1` by\n  // `spread_bound`), written out (`f(x.a, x.b)`), by its tag\n  spreads: Dict[String, ast.Expr] = Dict[String, ast.Expr] {},\n  // the errors of calls spreading records, also in `errs`\n  spread_errs: List[String] = [],\n  // the type of what each `for` runs over; a `noalloc` function can't run\n  // over what needs a list made (`noalloc_typed`)\n  iters: List[check.Ty] = [],\n  // each method called and its receiver's type, for `noalloc_typed`\n  recvs: List[(String, check.Ty)] = [],\n  // each `_ := e` met and the type of `e`; a `Result` thrown away this way\n  // is a warning (`dropped_results`)\n  dropped: List[(ast.Expr, check.Ty)] = [],\n  // the last call of one of the program's functions checked: its name, the\n  // variants its result can be there (`narrowed_at`; none: not narrowed),\n  // and whether what its function says of them rests on conditions left to\n  // `verify`. A match on the call reads it (`variants_covered`).\n  last_call: (String, List[String], Bool) = (\"\", [], false),\n}","old_text":"/// The inference's state: what type variables stand for, the next fresh\n/// one, the errors found, the program's functions, and the return type of\n/// the function being checked.\ntype Inf = {\n  subst: Dict[Int, check.Ty],\n  next: Int,\n  errs: List[String],\n  fns: Dict[String, check.Ty],\n  ret: check.Ty,\n  types: check.Types,\n  tparams: Set[String],\n  // the traits each type parameter in scope is bound by\n  tbounds: Dict[String, List[String]],\n  methods: check.Methods,\n  narrowed: Set[String],\n  // the variables an arm assigns to: their declared types there\n  exempt: Set[String],\n  // the variables declared outside the innermost `scope` (None: in none)\n  outside: Option[Set[String]],\n  // the variables from outside the closure or `spawn` being checked\n  captured: Set[String],\n  builtins: Dict[String, List[check.Builtin]],\n  // each variable declared (`x := e`, `mut x := e`) and the type it got, in\n  // the order met; `typed` writes them into the tree\n  lets: List[(String, check.Ty)],\n  // each lambda parameter marked by `lambdas_typed` (`$lam…`) and the type\n  // it got\n  lambdas: Dict[String, check.Ty],\n  // the trait obligations met (a trait's method used as a function: its\n  // `Self`, the trait, the method), solved once the body is checked\n  pending: List[(check.Ty, String, String)],\n  // the type of each call tagged by `instantiated` (`f#3(..)`, `x.m#4(..)`)\n  insts: Dict[String, check.Ty],\n  // each arithmetic operation met (`+`, `-`, ...) and its type. On `Int`,\n  // `String` or `List` it allocates, which `noalloc` code can't do.\n  arith: List[(String, check.Ty)],\n  // each hole met (`?name`): the type it must have, and the variables in\n  // scope there with their types (`strata holes`)\n  holes: List[(String, check.Ty, Dict[String, check.Ty])] = [],\n  // each variable's type as written, when refined (`n: Positive`, or the\n  // refinement an arm named: `Positive => …`); a match on it may leave out\n  // what the refinement excludes\n  written: Dict[String, ast.TypeExpr] = Dict[String, ast.TypeExpr] {},\n  // each argument that is a finite iterator where its parameter is a `List`\n  // (the callee's name, the argument's index, the argument); `as_listed`\n  // converts them with `to_list`\n  as_lists: List[(String, Int, ast.Expr)] = [],\n  // each expression statement met, its type, and the type of the variable\n  // its call's first argument names (`xs` in `push(xs, 1)`), if any. A\n  // value other than `()` is an error once the body is solved (`unused_values`).\n  discarded: List[(ast.Expr, check.Ty, Option[check.Ty])] = [],\n  // each call spreading records (`f(...x)`, tagged `f#s0_1` by\n  // `spread_bound`), written out (`f(x.a, x.b)`), by its tag\n  spreads: Dict[String, ast.Expr] = Dict[String, ast.Expr] {},\n  // the errors of calls spreading records, also in `errs`\n  spread_errs: List[String] = [],\n  // the type of what each `for` runs over; a `noalloc` function can't run\n  // over what needs a list made (`noalloc_typed`)\n  iters: List[check.Ty] = [],\n  // each method called and its receiver's type, for `noalloc_typed`\n  recvs: List[(String, check.Ty)] = [],\n  // each `_ := e` met and the type of `e`; a `Result` thrown away this way\n  // is a warning (`dropped_results`)\n  dropped: List[(ast.Expr, check.Ty)] = [],\n}"},{"name":"check.infer_call","kind":"fn","old":"85e35fc57c5fdc2f","new":"c14ebac5a5a90d00","interface_changed":false,"affected":[],"module":"check","text":"fn infer_call(\n  mut i: check.Inf,\n  callee: ast.Expr,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n) -> check.Ty {\n  // `remove(d, k)` stored as a method of a trait a module imports\n  // (`std.fs.remove`), on a list, dict or set: it is the built-in, which\n  // changes its argument, so it must be the method `mut d.remove(k)`\n  match (callee, args) {\n    (ast.Var(n), [first, ..]) => {\n      parts := split(n, \".\")\n      s := get(parts, len(parts) - 1) ?? n\n      if s != n\n        && builtins.changing(s)\n        && (first is ast.Var || first is ast.FieldOf) {\n        ft := check.res(i, check.infer(mut i, first, env, None))\n        if ft is check.TList || check.is_table(ft) {\n          check.error(mut i, \"`\"\n            + check.short_code(ast.Call { callee: ast.Var(s), args })\n            + \"`: `\"\n            + s\n            + \"` changes the list, dict or set it is called on: write `mut \"\n            + text.expr_text(first, 0)\n            + \".\"\n            + s\n            + \"(…)`\"\n            + check.new_value_hint(s))\n          check.infer_all(mut i, drop(args, 1), env)\n          return check.TAny\n        }\n      }\n    },\n    _ => (),\n  }\n  // a built-in function, unless a local or one of the program's\n  match callee {\n    ast.Var(n) => if !contains(env, n) && get(i.fns, n) is None {\n      match get(i.builtins, n) {\n        Some(bs) => {\n          // `take(it, 2)` on an iterator: the method of core's trait its type\n          // implements (`it.take(2)`). Only a variable or a constructor is looked\n          // at first, since inferring an expression twice would type its lambdas\n          // twice.\n          match args {\n            [first, ..rest] => if first is ast.Var || first is ast.CtorExpr {\n              match check.res(i, check.infer(mut i, first, env, None)) {\n                check.TNamed { name, .. } => if check.code_trait_method(i, name, n, check.TAny) is Some {\n                  return check.infer_method(\n                    mut i,\n                    first,\n                    n,\n                    rest,\n                    env,\n                    false,\n                  )\n                },\n                _ => (),\n              }\n            } else if first is ast.Call || first is ast.MethodCall {\n              // a call, as in `map(filter(it, f), g)` from a comprehension over an\n              // iterator: inferred once, then the method on what it gives, or the\n              // built-in given its type\n              t0 := check.listed_arg(\n                mut i,\n                n,\n                0,\n                first,\n                check.shown_as(n, check.TAny),\n                check.infer(mut i, first, env, None),\n                \"call to `\" + n + \"`\",\n              )\n              match check.iter_builtin(\n                mut i,\n                n,\n                check.res(i, t0),\n                rest,\n                env,\n              ) {\n                Some(t) => return t,\n                None => (),\n              }\n              match check.res(i, t0) {\n                check.TNamed { name, .. } => if check.code_trait_method(i, name, n, check.TAny) is Some {\n                  return check.infer_method(\n                    mut i,\n                    ast.Var(\"$first\"),\n                    n,\n                    rest,\n                    {\n                      mut copy := env\n                      mut copy.insert(\"$first\", t0)\n                      copy\n                    },\n                    false,\n                  )\n                },\n                _ => (),\n              }\n              return check.builtin_call(mut i, n, bs, [t0], rest, env)\n            },\n            [] => (),\n          }\n          // one that changes a list, dict or set is a method: `mut xs.push(x)`\n          if bs.any(b -> b.changes) {\n            check.error(mut i, \"`\"\n              + check.short_code(ast.Call { callee, args })\n              + \"`: `\"\n              + n\n              + \"` changes the \"\n              + \"list, dict or set it is called on: write `mut \"\n              + text.expr_text(\n                check.unmarked_arg(get(args, 0) ?? ast.UnitExpr),\n                0,\n              )\n              + \".\"\n              + n\n              + \"(…)`\"\n              + check.new_value_hint(n))\n            check.infer_all(mut i, args, env)\n            return check.TAny\n          }\n          // a built-in has no `mut` parameters\n          for a in args {\n            match a {\n              ast.MutExpr(x) => if !(x is ast.MethodCall) {\n                check.error(mut i, \"`\"\n                  + text.expr_text(a, 0)\n                  + \"`: `\"\n                  + n\n                  + \"` has no `mut` parameters\")\n              },\n              _ => (),\n            }\n          }\n          return check.builtin_call(mut i, n, bs, [], args, env)\n        },\n        None => (),\n      }\n    },\n    _ => (),\n  }\n  // one of the program's functions with bounds: its type parameters are\n  // kept, to check the bounds once the arguments are checked\n  (ct, vars, bounds) := match callee {\n    ast.Var(n) => if !contains(env, n) && len(get(i.methods.bounds, n) ?? []) > 0 {\n      match get(i.fns, n) {\n        Some(t) => {\n          m := check.fresh_for(\n            mut i,\n            to_list(check.gens(t, Set[String] {})),\n          )\n          (check.inst(t, m), m, get(i.methods.bounds, n) ?? [])\n        },\n        None => (\n          check.infer(mut i, callee, env, None),\n          Dict[String, check.Ty] {},\n          [],\n        ),\n      }\n    } else if !contains(env, n) && get(i.fns, n) is None {\n      // a method called as a function, `describe(x)`, is resolved by its\n      // argument; only a value of it is ambiguous\n      (\n        check.trait_fn_of(mut i, n, false),\n        Dict[String, check.Ty] {},\n        [],\n      )\n    } else {\n      (\n        check.infer(mut i, callee, env, None),\n        Dict[String, check.Ty] {},\n        [],\n      )\n    },\n    _ => (\n      check.infer(mut i, callee, env, None),\n      Dict[String, check.Ty] {},\n      [],\n    ),\n  }\n  what := match callee {\n    ast.Var(n) => \"call to `\" + n + \"`\",\n    _ => \"call\",\n  }\n  match check.res(i, ct) {\n    check.TFn { params, ret } => {\n      // a wrong number of arguments is reported by `expression_errors`\n      mut arg_types := []\n      if len(params) == len(args) {\n        for (k, a) in enumerate(args) {\n          p := get(params, k) ?? check.TAny\n          at := check.listed_arg(\n            mut i,\n            check.n_of(callee),\n            k,\n            a,\n            p,\n            check.infer(mut i, a, env, Some(p)),\n            what,\n          )\n          mut arg_types.push(at)\n          check.expect(\n            mut i,\n            p,\n            at,\n            what + \", argument \" + to_string(k + 1),\n          )\n          // a `mut` parameter takes its exact type: the function can put any value\n          // of it into the caller's variable\n          mp := get(\n            get(i.methods.mut_params, check.n_of(callee)) ?? [],\n            k,\n          ) ?? check.TAny\n          if !(check.res(i, at) is check.TVariants)\n            && !(mp is check.TTrait)\n            && check.exact_differs(mp, check.res(i, at)) {\n            match (check.shown(mp), check.shown(check.res(i, at))) {\n              (Some(w), Some(g)) => check.error(mut i, what\n                + \", argument \"\n                + to_string(k + 1)\n                + \": expected exactly `\"\n                + w\n                + \"`, found `\"\n                + g\n                + \"` (the parameter is `mut`, so the function can put any `\"\n                + w\n                + \"` into the caller's variable)\"),\n              _ => (),\n            }\n          } else if check.mut_narrower(i, check.n_of(callee), k, a) is Some {\n            // nor a value the variable's own refinement rules out\n            match check.mut_narrower(i, check.n_of(callee), k, a) {\n              Some((x, vw, pw)) => check.error(mut i, what\n                + \", argument \"\n                + to_string(k + 1)\n                + \": `\"\n                + x\n                + \"` is declared `\"\n                + text.type_text(vw)\n                + \"`, but the `mut` parameter is `\"\n                + text.type_text(pw)\n                + \"`: the function could store a value `\"\n                + x\n                + \"` must never hold\"),\n              None => (),\n            }\n          } else if !(mp is check.TAny)\n            && len(check.gens(mp, Set[String] {})) == 0 {\n            // a variable whose type isn't known yet (`mut xs := []`) takes the\n            // parameter's\n            _ := check.unify(mut i, mp, at, 100)\n          }\n        }\n        // each bound: the type the parameter stands for implements the trait\n        for b in bounds {\n          if contains(i.methods.checked, b.1) {\n            // a type nothing has determined yet: an obligation, reported at the end\n            // if nothing does\n            match check.res(i, get(vars, b.0) ?? check.TAny) {\n              check.TVar(_) => mut i.pending.push(\n                (\n                  get(vars, b.0) ?? check.TAny,\n                  b.1,\n                  check.n_of(callee),\n                ),\n              ),\n              _ => (),\n            }\n            match check.shown(check.res(i, get(vars, b.0) ?? check.TAny)) {\n              Some(x) => if !check.implements(\n                i,\n                check.res(i, get(vars, b.0) ?? check.TAny),\n                b.1,\n              ) {\n                check.error(mut i, \"calling `\"\n                  + check.n_of(callee)\n                  + \"`: `\"\n                  + x\n                  + \"` does not implement `\"\n                  + b.1\n                  + \"`\")\n              },\n              None => (),\n            }\n          }\n        }\n      }\n      // a program function's result, narrowed by what it says of it\n      match callee {\n        ast.Var(n) => if !contains(env, n) && len(arg_types) == len(args) {\n          i.last_call = match check.narrowed_at(i, n, arg_types, ret) {\n            Some((_, _, left, u)) => (n, to_list(left).sorted(), u),\n            None => (n, [], false),\n          }\n          check.narrowed_result(i, n, arg_types, ret)\n        } else {\n          ret\n        },\n        _ => ret,\n      }\n    },\n    // a value that is not a function (`n(2)` with `n: Int`)\n    other => {\n      match (callee, check.shown(other)) {\n        (ast.Var(_), Some(x)) => if !(other is check.TFn) {\n          check.error(\n            mut i,\n            what + \": `\" + x + \"` is not a function\",\n          )\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}","old_text":"fn infer_call(\n  mut i: check.Inf,\n  callee: ast.Expr,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n) -> check.Ty {\n  // `remove(d, k)` stored as a method of a trait a module imports\n  // (`std.fs.remove`), on a list, dict or set: it is the built-in, which\n  // changes its argument, so it must be the method `mut d.remove(k)`\n  match (callee, args) {\n    (ast.Var(n), [first, ..]) => {\n      parts := split(n, \".\")\n      s := get(parts, len(parts) - 1) ?? n\n      if s != n\n        && builtins.changing(s)\n        && (first is ast.Var || first is ast.FieldOf) {\n        ft := check.res(i, check.infer(mut i, first, env, None))\n        if ft is check.TList || check.is_table(ft) {\n          check.error(mut i, \"`\"\n            + check.short_code(ast.Call { callee: ast.Var(s), args })\n            + \"`: `\"\n            + s\n            + \"` changes the list, dict or set it is called on: write `mut \"\n            + text.expr_text(first, 0)\n            + \".\"\n            + s\n            + \"(…)`\"\n            + check.new_value_hint(s))\n          check.infer_all(mut i, drop(args, 1), env)\n          return check.TAny\n        }\n      }\n    },\n    _ => (),\n  }\n  // a built-in function, unless a local or one of the program's\n  match callee {\n    ast.Var(n) => if !contains(env, n) && get(i.fns, n) is None {\n      match get(i.builtins, n) {\n        Some(bs) => {\n          // `take(it, 2)` on an iterator: the method of core's trait its type\n          // implements (`it.take(2)`). Only a variable or a constructor is looked\n          // at first, since inferring an expression twice would type its lambdas\n          // twice.\n          match args {\n            [first, ..rest] => if first is ast.Var || first is ast.CtorExpr {\n              match check.res(i, check.infer(mut i, first, env, None)) {\n                check.TNamed { name, .. } => if check.code_trait_method(i, name, n, check.TAny) is Some {\n                  return check.infer_method(\n                    mut i,\n                    first,\n                    n,\n                    rest,\n                    env,\n                    false,\n                  )\n                },\n                _ => (),\n              }\n            } else if first is ast.Call || first is ast.MethodCall {\n              // a call, as in `map(filter(it, f), g)` from a comprehension over an\n              // iterator: inferred once, then the method on what it gives, or the\n              // built-in given its type\n              t0 := check.listed_arg(\n                mut i,\n                n,\n                0,\n                first,\n                check.shown_as(n, check.TAny),\n                check.infer(mut i, first, env, None),\n                \"call to `\" + n + \"`\",\n              )\n              match check.iter_builtin(\n                mut i,\n                n,\n                check.res(i, t0),\n                rest,\n                env,\n              ) {\n                Some(t) => return t,\n                None => (),\n              }\n              match check.res(i, t0) {\n                check.TNamed { name, .. } => if check.code_trait_method(i, name, n, check.TAny) is Some {\n                  return check.infer_method(\n                    mut i,\n                    ast.Var(\"$first\"),\n                    n,\n                    rest,\n                    {\n                      mut copy := env\n                      mut copy.insert(\"$first\", t0)\n                      copy\n                    },\n                    false,\n                  )\n                },\n                _ => (),\n              }\n              return check.builtin_call(mut i, n, bs, [t0], rest, env)\n            },\n            [] => (),\n          }\n          // one that changes a list, dict or set is a method: `mut xs.push(x)`\n          if bs.any(b -> b.changes) {\n            check.error(mut i, \"`\"\n              + check.short_code(ast.Call { callee, args })\n              + \"`: `\"\n              + n\n              + \"` changes the \"\n              + \"list, dict or set it is called on: write `mut \"\n              + text.expr_text(\n                check.unmarked_arg(get(args, 0) ?? ast.UnitExpr),\n                0,\n              )\n              + \".\"\n              + n\n              + \"(…)`\"\n              + check.new_value_hint(n))\n            check.infer_all(mut i, args, env)\n            return check.TAny\n          }\n          // a built-in has no `mut` parameters\n          for a in args {\n            match a {\n              ast.MutExpr(x) => if !(x is ast.MethodCall) {\n                check.error(mut i, \"`\"\n                  + text.expr_text(a, 0)\n                  + \"`: `\"\n                  + n\n                  + \"` has no `mut` parameters\")\n              },\n              _ => (),\n            }\n          }\n          return check.builtin_call(mut i, n, bs, [], args, env)\n        },\n        None => (),\n      }\n    },\n    _ => (),\n  }\n  // one of the program's functions with bounds: its type parameters are\n  // kept, to check the bounds once the arguments are checked\n  (ct, vars, bounds) := match callee {\n    ast.Var(n) => if !contains(env, n) && len(get(i.methods.bounds, n) ?? []) > 0 {\n      match get(i.fns, n) {\n        Some(t) => {\n          m := check.fresh_for(\n            mut i,\n            to_list(check.gens(t, Set[String] {})),\n          )\n          (check.inst(t, m), m, get(i.methods.bounds, n) ?? [])\n        },\n        None => (\n          check.infer(mut i, callee, env, None),\n          Dict[String, check.Ty] {},\n          [],\n        ),\n      }\n    } else if !contains(env, n) && get(i.fns, n) is None {\n      // a method called as a function, `describe(x)`, is resolved by its\n      // argument; only a value of it is ambiguous\n      (\n        check.trait_fn_of(mut i, n, false),\n        Dict[String, check.Ty] {},\n        [],\n      )\n    } else {\n      (\n        check.infer(mut i, callee, env, None),\n        Dict[String, check.Ty] {},\n        [],\n      )\n    },\n    _ => (\n      check.infer(mut i, callee, env, None),\n      Dict[String, check.Ty] {},\n      [],\n    ),\n  }\n  what := match callee {\n    ast.Var(n) => \"call to `\" + n + \"`\",\n    _ => \"call\",\n  }\n  match check.res(i, ct) {\n    check.TFn { params, ret } => {\n      // a wrong number of arguments is reported by `expression_errors`\n      mut arg_types := []\n      if len(params) == len(args) {\n        for (k, a) in enumerate(args) {\n          p := get(params, k) ?? check.TAny\n          at := check.listed_arg(\n            mut i,\n            check.n_of(callee),\n            k,\n            a,\n            p,\n            check.infer(mut i, a, env, Some(p)),\n            what,\n          )\n          mut arg_types.push(at)\n          check.expect(\n            mut i,\n            p,\n            at,\n            what + \", argument \" + to_string(k + 1),\n          )\n          // a `mut` parameter takes its exact type: the function can put any value\n          // of it into the caller's variable\n          mp := get(\n            get(i.methods.mut_params, check.n_of(callee)) ?? [],\n            k,\n          ) ?? check.TAny\n          if !(check.res(i, at) is check.TVariants)\n            && !(mp is check.TTrait)\n            && check.exact_differs(mp, check.res(i, at)) {\n            match (check.shown(mp), check.shown(check.res(i, at))) {\n              (Some(w), Some(g)) => check.error(mut i, what\n                + \", argument \"\n                + to_string(k + 1)\n                + \": expected exactly `\"\n                + w\n                + \"`, found `\"\n                + g\n                + \"` (the parameter is `mut`, so the function can put any `\"\n                + w\n                + \"` into the caller's variable)\"),\n              _ => (),\n            }\n          } else if check.mut_narrower(i, check.n_of(callee), k, a) is Some {\n            // nor a value the variable's own refinement rules out\n            match check.mut_narrower(i, check.n_of(callee), k, a) {\n              Some((x, vw, pw)) => check.error(mut i, what\n                + \", argument \"\n                + to_string(k + 1)\n                + \": `\"\n                + x\n                + \"` is declared `\"\n                + text.type_text(vw)\n                + \"`, but the `mut` parameter is `\"\n                + text.type_text(pw)\n                + \"`: the function could store a value `\"\n                + x\n                + \"` must never hold\"),\n              None => (),\n            }\n          } else if !(mp is check.TAny)\n            && len(check.gens(mp, Set[String] {})) == 0 {\n            // a variable whose type isn't known yet (`mut xs := []`) takes the\n            // parameter's\n            _ := check.unify(mut i, mp, at, 100)\n          }\n        }\n        // each bound: the type the parameter stands for implements the trait\n        for b in bounds {\n          if contains(i.methods.checked, b.1) {\n            // a type nothing has determined yet: an obligation, reported at the end\n            // if nothing does\n            match check.res(i, get(vars, b.0) ?? check.TAny) {\n              check.TVar(_) => mut i.pending.push(\n                (\n                  get(vars, b.0) ?? check.TAny,\n                  b.1,\n                  check.n_of(callee),\n                ),\n              ),\n              _ => (),\n            }\n            match check.shown(check.res(i, get(vars, b.0) ?? check.TAny)) {\n              Some(x) => if !check.implements(\n                i,\n                check.res(i, get(vars, b.0) ?? check.TAny),\n                b.1,\n              ) {\n                check.error(mut i, \"calling `\"\n                  + check.n_of(callee)\n                  + \"`: `\"\n                  + x\n                  + \"` does not implement `\"\n                  + b.1\n                  + \"`\")\n              },\n              None => (),\n            }\n          }\n        }\n      }\n      // a program function's result, narrowed by what it says of it\n      match callee {\n        ast.Var(n) => if !contains(env, n) && len(arg_types) == len(args) {\n          check.narrowed_result(i, n, arg_types, ret)\n        } else {\n          ret\n        },\n        _ => ret,\n      }\n    },\n    // a value that is not a function (`n(2)` with `n: Int`)\n    other => {\n      match (callee, check.shown(other)) {\n        (ast.Var(_), Some(x)) => if !(other is check.TFn) {\n          check.error(\n            mut i,\n            what + \": `\" + x + \"` is not a function\",\n          )\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}"},{"name":"check.infer_match","kind":"fn","old":"500d8c4977bd0846","new":"82e002287ba23ba5","interface_changed":false,"affected":[],"module":"check","text":"fn infer_match(\n  mut i: check.Inf,\n  scrutinee: ast.Expr,\n  binding: Option[String],\n  arms: List[ast.Arm],\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  st := check.infer(mut i, scrutinee, env, None)\n  // what the call matched on can give, read before the arms make calls\n  can_at := match (scrutinee, i.last_call) {\n    (ast.Call { callee: ast.Var(f), .. }, (lf, vs, u)) => if lf == f && len(vs) > 0 {\n      Some((vs, u))\n    } else {\n      None\n    },\n    _ => None,\n  }\n  // narrowing drops variants, never type arguments: patterns can use the\n  // matched variable's declared type\n  pt := match scrutinee {\n    ast.Var(x) => get(env, x) ?? st,\n    _ => st,\n  }\n  base := match binding {\n    Some(b) => {\n      mut copy := env\n      mut copy.insert(b, check.TAny)\n      copy\n    },\n    None => env,\n  }\n  // the variable an arm narrows: the `as` name, else the matched variable\n  target := match binding {\n    Some(b) => Some(b),\n    None => match scrutinee {\n      ast.Var(x) => Some(x),\n      _ => None,\n    },\n  }\n  for a in arms {\n    // an arm's own binding of the whole value has its declared type; a\n    // constructor's fields get their types\n    mut inner := check.bind_typed(mut i, base, a.pat, pt)\n    // in an arm naming variants, the matched variable is those variants,\n    // unless the arm assigns to it\n    match (target, check.arm_variants(i, a.pat)) {\n      (Some(x), Some(v)) => if !check.assigns_to(a.body, x) {\n        mut inner.insert(x, v)\n      },\n      // a union's members an arm names (`Int =>`): the variable is them\n      (Some(x), None) => match check.arm_members(i, get(env, x) ?? st, a.pat) {\n        Some(v) => if !check.assigns_to(a.body, x) {\n          mut inner.insert(x, v)\n        },\n        None => (),\n      },\n      _ => (),\n    }\n    // an arm naming a refinement (`Positive =>`): the variable is of it there\n    held := i.written\n    match (target, a.pat) {\n      (Some(x), ast.CtorPattern { name: rn, args: ast.NoPats }) => if !check.assigns_to(a.body, x)\n        && check.named_refinement(i, rn) is Some {\n        mut i.written.insert(x, ast.Named { name: rn, args: [] })\n      },\n      _ => (),\n    }\n    // an arm that assigns to the matched variable sees its declared type\n    outer := i.exempt\n    match target {\n      Some(x) => if check.assigns_to(a.body, x) {\n        mut i.exempt.insert(x)\n      },\n      None => (),\n    }\n    match expected {\n      Some(r) => {\n        bt := check.infer(mut i, a.body, inner, Some(r))\n        check.expect(mut i, r, bt, \"match arm\")\n      },\n      None => check.infer(mut i, a.body, inner, None),\n    }\n    i.exempt = outer\n    i.written = held\n  }\n  // every value covered and no arm unreachable, on integers, floats,\n  // strings, lists, tuples and unions; `exhaustive` checks sums\n  w := match scrutinee {\n    ast.Var(x) => get(i.written, x),\n    ast.Call { callee: ast.Var(fname), .. } => match get(i.types.rets, fname) {\n      Some(rt) => match rt {\n        ast.Refined { .. } => Some(rt),\n        ast.Named { args: [], .. } => Some(rt),\n        _ => None,\n      },\n      None => None,\n    },\n    _ => None,\n  }\n  check.check_coverage(mut i, check.res(i, pt), arms, w)\n  // a call of one of the program's functions giving a sum: covered here,\n  // with the variants it can give at this call\n  match scrutinee {\n    ast.Call { callee: ast.Var(f), .. } => if !contains(env, f) && get(i.fns, f) is Some {\n      check.variants_covered(mut i, check.res(i, st), can_at, arms)\n    },\n    _ => (),\n  }\n  expected ?? check.TAny\n}","old_text":"fn infer_match(\n  mut i: check.Inf,\n  scrutinee: ast.Expr,\n  binding: Option[String],\n  arms: List[ast.Arm],\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  st := check.infer(mut i, scrutinee, env, None)\n  // narrowing drops variants, never type arguments: patterns can use the\n  // matched variable's declared type\n  pt := match scrutinee {\n    ast.Var(x) => get(env, x) ?? st,\n    _ => st,\n  }\n  base := match binding {\n    Some(b) => {\n      mut copy := env\n      mut copy.insert(b, check.TAny)\n      copy\n    },\n    None => env,\n  }\n  // the variable an arm narrows: the `as` name, else the matched variable\n  target := match binding {\n    Some(b) => Some(b),\n    None => match scrutinee {\n      ast.Var(x) => Some(x),\n      _ => None,\n    },\n  }\n  for a in arms {\n    // an arm's own binding of the whole value has its declared type; a\n    // constructor's fields get their types\n    mut inner := check.bind_typed(mut i, base, a.pat, pt)\n    // in an arm naming variants, the matched variable is those variants,\n    // unless the arm assigns to it\n    match (target, check.arm_variants(i, a.pat)) {\n      (Some(x), Some(v)) => if !check.assigns_to(a.body, x) {\n        mut inner.insert(x, v)\n      },\n      // a union's members an arm names (`Int =>`): the variable is them\n      (Some(x), None) => match check.arm_members(i, get(env, x) ?? st, a.pat) {\n        Some(v) => if !check.assigns_to(a.body, x) {\n          mut inner.insert(x, v)\n        },\n        None => (),\n      },\n      _ => (),\n    }\n    // an arm naming a refinement (`Positive =>`): the variable is of it there\n    held := i.written\n    match (target, a.pat) {\n      (Some(x), ast.CtorPattern { name: rn, args: ast.NoPats }) => if !check.assigns_to(a.body, x)\n        && check.named_refinement(i, rn) is Some {\n        mut i.written.insert(x, ast.Named { name: rn, args: [] })\n      },\n      _ => (),\n    }\n    // an arm that assigns to the matched variable sees its declared type\n    outer := i.exempt\n    match target {\n      Some(x) => if check.assigns_to(a.body, x) {\n        mut i.exempt.insert(x)\n      },\n      None => (),\n    }\n    match expected {\n      Some(r) => {\n        bt := check.infer(mut i, a.body, inner, Some(r))\n        check.expect(mut i, r, bt, \"match arm\")\n      },\n      None => check.infer(mut i, a.body, inner, None),\n    }\n    i.exempt = outer\n    i.written = held\n  }\n  // every value covered and no arm unreachable, on integers, floats,\n  // strings, lists, tuples and unions; `exhaustive` checks sums\n  w := match scrutinee {\n    ast.Var(x) => get(i.written, x),\n    ast.Call { callee: ast.Var(fname), .. } => match get(i.types.rets, fname) {\n      Some(rt) => match rt {\n        ast.Refined { .. } => Some(rt),\n        ast.Named { args: [], .. } => Some(rt),\n        _ => None,\n      },\n      None => None,\n    },\n    _ => None,\n  }\n  check.check_coverage(mut i, check.res(i, pt), arms, w)\n  // a call whose callee says which variants its result is: covered here,\n  // with the variants left at this call (`exhaustive` leaves it out)\n  match scrutinee {\n    ast.Call { callee: ast.Var(f), .. } => if !contains(env, f) && contains(i.types.narrows, f) {\n      check.variants_covered(mut i, check.res(i, st), arms)\n    },\n    _ => (),\n  }\n  expected ?? check.TAny\n}"},{"name":"check.types_of","kind":"fn","old":"f50963562348633a","new":"fcdf0bbc32ff2dc6","interface_changed":false,"affected":[],"module":"check","text":"/// The program's record and sum types the checker models, by the names the\n/// stored form uses.\npub fn types_of(decls: List[ast.Decl]) -> check.Types {\n  // `Option` and `Result` come with the language\n  mut named := Dict[String, List[String]] { \"Option\": [\"T\"], \"Result\": [\"T\", \"E\"], \"Dict\": [\"K\", \"V\"], \"Set\": [\"A\"], \"Task\": [\"T\"], \"Sender\": [\"T\"], \"Receiver\": [\"T\"] }\n  mut sums := Set[String] { \"Option\", \"Result\" }\n  mut traits := Set[String] {}\n  for d in decls {\n    match d.kind {\n      // a capability's too, like `Console`: its methods' types are checked\n      ast.TraitDef(t) => if len(t.params) == 0 {\n        mut traits.insert(check.qualified(d.module, t.name))\n      },\n      _ => (),\n    }\n  }\n  mut aliases := Dict[String, ast.TypeExpr] {}\n  mut refinements := Dict[String, (ast.TypeExpr, ast.Expr)] {}\n  mut rets := Dict[String, ast.TypeExpr] {}\n  mut mut_written := Dict[String, List[Option[ast.TypeExpr]]] {}\n  mut narrows := Dict[String, (List[String], List[ast.Expr])] {}\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => if !t.distinct && len(t.params) == 0 {\n        match (t.body, t.refinement) {\n          (ast.Alias(a), Some(pred)) => mut refinements.insert(\n            check.qualified(d.module, t.name),\n            (a, pred),\n          ),\n          _ => (),\n        }\n      },\n      ast.FnDef(f) => {\n        mut rets.insert(check.qualified(d.module, f.name), f.ret)\n        facts := walk.result_facts(f)\n        if walk.says_variant_of_it(facts) {\n          mut narrows.insert(\n            check.qualified(d.module, f.name),\n            (f.params.map(p -> p.name), facts),\n          )\n        }\n        mut mut_written.insert(\n          check.qualified(d.module, f.name),\n          f.params.map(\n            p -> if p.mutable {\n              Some(p.ty)\n            } else {\n              None\n            },\n          ),\n        )\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      // an alias, refined or not, is the type it stands for. A record or a sum,\n      // refined or not, is a type of its own; its refinement is verify's, and\n      // its fields are checked as an unrefined one's are.\n      ast.TypeDef(t) => if !t.distinct {\n        q := check.qualified(d.module, t.name)\n        match t.body {\n          ast.Alias(a) => if len(t.params) == 0 {\n            mut aliases.insert(q, a)\n          },\n          ast.RecordBody(_) => mut named.insert(q, t.params),\n          ast.SumBody(vs) => if !vs.any(v -> v.payload is ast.MemberType) {\n            mut named.insert(q, t.params)\n            mut sums.insert(q)\n          },\n        }\n      } else if t.distinct {\n        // a `distinct` type: a type of its own, made of one field, `value`\n        mut named.insert(check.qualified(d.module, t.name), t.params)\n      },\n      _ => (),\n    }\n  }\n  mut ctors := Dict[String, check.Shape] { \"Some\": check.Shape {\n    owner: \"Option\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"None\": check.Shape {\n    owner: \"Option\",\n    fields: [],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"Ok\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  }, \"Err\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"E\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  } }\n  partial := check.Types {\n    named,\n    sums,\n    ctors: Dict[String, check.Shape] {},\n    aliases,\n    traits,\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => {\n        q := check.qualified(d.module, t.name)\n        if contains(named, q) {\n          tps := set(t.params)\n          match t.body {\n            ast.RecordBody(fs) => mut ctors.insert(\n              q,\n              check.Shape {\n                owner: q,\n                fields: fs.map(\n                  f -> (f.name, check.lower(partial, tps, f.ty)),\n                ),\n                positional: false,\n                required: check.required(fs),\n                params: t.params,\n              },\n            ),\n            ast.SumBody(vs) => {\n              for v in vs {\n                sh := match v.payload {\n                  ast.Positional(ts) => check.Shape {\n                    owner: q,\n                    fields: ts.map(x -> (\"\", check.lower(partial, tps, x))),\n                    positional: true,\n                    required: [],\n                    params: t.params,\n                  },\n                  ast.RecordPayload(fs) => check.Shape {\n                    owner: q,\n                    fields: fs.map(\n                      f -> (f.name, check.lower(partial, tps, f.ty)),\n                    ),\n                    positional: false,\n                    required: check.required(fs),\n                    params: t.params,\n                  },\n                  _ => check.Shape {\n                    owner: q,\n                    fields: [],\n                    positional: true,\n                    required: [],\n                    params: t.params,\n                  },\n                }\n                mut ctors.insert(check.qualified(d.module, v.name), sh)\n              }\n            },\n            ast.Alias(a) => if t.distinct {\n              mut ctors.insert(\n                q,\n                check.Shape {\n                  owner: q,\n                  fields: [(\"value\", check.lower(partial, tps, a))],\n                  positional: true,\n                  required: [],\n                  params: t.params,\n                },\n              )\n            },\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  mut variants := Dict[String, List[String]] {}\n  for (c, sh) in ctors {\n    if contains(sums, sh.owner) {\n      mut variants.insert(\n        sh.owner,\n        (get(variants, sh.owner) ?? []) + [c],\n      )\n    }\n  }\n  check.Types {\n    named,\n    sums,\n    ctors,\n    aliases,\n    traits,\n    refinements,\n    rets,\n    mut_written,\n    variants,\n    narrows,\n  }\n}","old_text":"/// The program's record and sum types the checker models, by the names the\n/// stored form uses.\npub fn types_of(decls: List[ast.Decl]) -> check.Types {\n  // `Option` and `Result` come with the language\n  mut named := Dict[String, List[String]] { \"Option\": [\"T\"], \"Result\": [\"T\", \"E\"], \"Dict\": [\"K\", \"V\"], \"Set\": [\"A\"], \"Task\": [\"T\"], \"Sender\": [\"T\"], \"Receiver\": [\"T\"] }\n  mut sums := Set[String] { \"Option\", \"Result\" }\n  mut traits := Set[String] {}\n  for d in decls {\n    match d.kind {\n      // a capability's too, like `Console`: its methods' types are checked\n      ast.TraitDef(t) => if len(t.params) == 0 {\n        mut traits.insert(check.qualified(d.module, t.name))\n      },\n      _ => (),\n    }\n  }\n  mut aliases := Dict[String, ast.TypeExpr] {}\n  mut refinements := Dict[String, (ast.TypeExpr, ast.Expr)] {}\n  mut rets := Dict[String, ast.TypeExpr] {}\n  mut mut_written := Dict[String, List[Option[ast.TypeExpr]]] {}\n  mut narrows := Dict[String, (List[String], List[ast.Expr])] {}\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => if !t.distinct && len(t.params) == 0 {\n        match (t.body, t.refinement) {\n          (ast.Alias(a), Some(pred)) => mut refinements.insert(\n            check.qualified(d.module, t.name),\n            (a, pred),\n          ),\n          _ => (),\n        }\n      },\n      ast.FnDef(f) => {\n        mut rets.insert(check.qualified(d.module, f.name), f.ret)\n        facts := match f.ret {\n          ast.Refined { pred, .. } => [pred] + f.post,\n          _ => f.post,\n        }\n        if check.says_variant_of_it(facts) && len(f.type_params) == 0 {\n          mut narrows.insert(\n            check.qualified(d.module, f.name),\n            (f.params.map(p -> p.name), facts),\n          )\n        }\n        mut mut_written.insert(\n          check.qualified(d.module, f.name),\n          f.params.map(\n            p -> if p.mutable {\n              Some(p.ty)\n            } else {\n              None\n            },\n          ),\n        )\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      // an alias, refined or not, is the type it stands for. A record or a sum,\n      // refined or not, is a type of its own; its refinement is verify's, and\n      // its fields are checked as an unrefined one's are.\n      ast.TypeDef(t) => if !t.distinct {\n        q := check.qualified(d.module, t.name)\n        match t.body {\n          ast.Alias(a) => if len(t.params) == 0 {\n            mut aliases.insert(q, a)\n          },\n          ast.RecordBody(_) => mut named.insert(q, t.params),\n          ast.SumBody(vs) => if !vs.any(v -> v.payload is ast.MemberType) {\n            mut named.insert(q, t.params)\n            mut sums.insert(q)\n          },\n        }\n      } else if t.distinct {\n        // a `distinct` type: a type of its own, made of one field, `value`\n        mut named.insert(check.qualified(d.module, t.name), t.params)\n      },\n      _ => (),\n    }\n  }\n  mut ctors := Dict[String, check.Shape] { \"Some\": check.Shape {\n    owner: \"Option\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"None\": check.Shape {\n    owner: \"Option\",\n    fields: [],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"Ok\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  }, \"Err\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"E\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  } }\n  partial := check.Types {\n    named,\n    sums,\n    ctors: Dict[String, check.Shape] {},\n    aliases,\n    traits,\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => {\n        q := check.qualified(d.module, t.name)\n        if contains(named, q) {\n          tps := set(t.params)\n          match t.body {\n            ast.RecordBody(fs) => mut ctors.insert(\n              q,\n              check.Shape {\n                owner: q,\n                fields: fs.map(\n                  f -> (f.name, check.lower(partial, tps, f.ty)),\n                ),\n                positional: false,\n                required: check.required(fs),\n                params: t.params,\n              },\n            ),\n            ast.SumBody(vs) => {\n              for v in vs {\n                sh := match v.payload {\n                  ast.Positional(ts) => check.Shape {\n                    owner: q,\n                    fields: ts.map(x -> (\"\", check.lower(partial, tps, x))),\n                    positional: true,\n                    required: [],\n                    params: t.params,\n                  },\n                  ast.RecordPayload(fs) => check.Shape {\n                    owner: q,\n                    fields: fs.map(\n                      f -> (f.name, check.lower(partial, tps, f.ty)),\n                    ),\n                    positional: false,\n                    required: check.required(fs),\n                    params: t.params,\n                  },\n                  _ => check.Shape {\n                    owner: q,\n                    fields: [],\n                    positional: true,\n                    required: [],\n                    params: t.params,\n                  },\n                }\n                mut ctors.insert(check.qualified(d.module, v.name), sh)\n              }\n            },\n            ast.Alias(a) => if t.distinct {\n              mut ctors.insert(\n                q,\n                check.Shape {\n                  owner: q,\n                  fields: [(\"value\", check.lower(partial, tps, a))],\n                  positional: true,\n                  required: [],\n                  params: t.params,\n                },\n              )\n            },\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  mut variants := Dict[String, List[String]] {}\n  for (c, sh) in ctors {\n    if contains(sums, sh.owner) {\n      mut variants.insert(\n        sh.owner,\n        (get(variants, sh.owner) ?? []) + [c],\n      )\n    }\n  }\n  check.Types {\n    named,\n    sums,\n    ctors,\n    aliases,\n    traits,\n    refinements,\n    rets,\n    mut_written,\n    variants,\n    narrows,\n  }\n}"},{"name":"check.use walk","kind":"use","old":"e7093b431b621d86","new":"7b1f83d0fdb3545c","interface_changed":true,"affected":[],"module":"check","text":"from walk use kids, expr_children, expr_children_at, rewrite_expr, decl_kids,\n  decl_exprs, rewrite_decl, says_variant_of_it, result_facts","old_text":"from walk use kids, expr_children, expr_children_at, rewrite_expr, decl_kids,\n  decl_exprs, rewrite_decl"},{"name":"check.narrowed_result","kind":"fn","old":"23a4d8dd4b77d047","new":"2c2c23cd153c77b3","interface_changed":false,"affected":[],"module":"check","text":"/// A call's result type, narrowed to the variants `narrowed_at` leaves,\n/// for a sum without type parameters (what `TVariants` models). `ret`\n/// itself when nothing is left out (or the facts contradict).\nfn narrowed_result(\n  i: check.Inf,\n  f: String,\n  args: List[check.Ty],\n  ret: check.Ty,\n) -> check.Ty {\n  match (check.res(i, ret), check.narrowed_at(i, f, args, ret)) {\n    (check.TNamed { args: [], .. }, Some((owner, all, left, _))) => if len(left) == 0 || len(left) == len(all) {\n      ret\n    } else {\n      check.TVariants { owner, names: to_list(left).sorted() }\n    },\n    _ => ret,\n  }\n}","old_text":"/// The variants of a sum that a call's result can be, from what the callee\n/// says of `it`: its result type's refinement (`-> Order where it is\n/// Shipped`) and its `ensures`, each conjunct `it is V` (or `!`, `||` of\n/// them), `A ==> it is V` and `(it is V) == A`, where the checker decides\n/// `A` from the arguments' types (`o is Paid` with `o` narrowed to `Paid`).\n/// `ret` unchanged when nothing narrows it (or the facts contradict). The\n/// callee's contract is taken as given: `verify` proves it, and while it\n/// isn't proven the callee checks it on return.\nfn narrowed_result(\n  i: check.Inf,\n  f: String,\n  args: List[check.Ty],\n  ret: check.Ty,\n) -> check.Ty {\n  (owner, all) := match check.res(i, ret) {\n    check.TNamed { name, args: [] } => if contains(i.types.sums, name) {\n      (name, get(i.types.variants, name) ?? [])\n    } else {\n      return ret\n    },\n    _ => return ret,\n  }\n  (params, facts) := match get(i.types.narrows, f) {\n    Some(x) => x,\n    None => return ret,\n  }\n  mut left := set(all)\n  for fact in facts {\n    for c in check.conjuncts(fact) {\n      left = check.narrow_by(i, c, params, args, owner, left)\n    }\n  }\n  if len(left) == 0 || len(left) == len(all) {\n    return ret\n  }\n  check.TVariants { owner, names: to_list(left).sorted() }\n}"},{"name":"check.narrow_by","kind":"fn","old":"376d3e5e6b9b8bb5","new":"748a6ad80135144e","interface_changed":true,"affected":["check.narrowed_at","check.infer_call","check.narrowed_result","check.infer_untagged","check.infer","check.infer_spread","check.infer_all","check.binary","check.infer_block","check.infer_if","check.infer_list","check.infer_match","check.infer_ctor","check.infer_lambda","check.infer_method","check.builtin_call","check.static_call","check.fn_inferred","check.task_body","check.default_errors","check.element_assigned","check.spread_method_params","check.spread_filled","check.iter_builtin","check.fn_errors","check.instantiated","check.fn_lambdas_typed","check.holes_of","check.mark_field_reads","check.own_methods_resolved","check.typed_one","check.decl_type_errors","check.spread_body","check.field_reads","eval_files","instantiated_files","check.lambdas_typed","holes_command","check_summary","finding.uses_of","rename_command","verified_decls","check.typed","check.type_errors_with","check.spreads_resolved","unused.members","command_line","check_command","finding.uses_from","finding.used_by_tree","finding.refs_command","verified_with","static_graph","codegen.new_gen","computed_value","repl_eval","check.type_errors","check_errors_in","literal_errors","expanded","unused.findings","main","strata_command","finding.uses_tree","verified_program","verify_file","build_command","graph_command","graph_diff","tour_graph","codegen.generate","codegen.read_back","comptime_value","repl_command","check_errors_with","edit_errors","literal_errors_of","codegen_with","with_base","unused_of","edit_unused","core_unused","codegen.entry","codegen.compiled_alone","eval.run","smt_file","termination_file","verify_command","build_proofs","alongside_command","search_invariants","diff_command","tour_command","core_rt_text","comptime_values","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","codegen_text","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","run_command","fix_loops","build_core_command","comptime_runner","package_errors","merge_file_command","merged_checks","call_command","edit_command","check_files","move_command","fix_command","edit_in_editor","codegen_file","jit_file","fuzz_file","graph_runs","replay","or_solver_inputs","program_objects","sync_command","check_fn","linked"],"module":"check","text":"/// The variants `left` keeps under fact `c` about the result `it`, and\n/// whether `c` speaks of `it`'s variant under a condition the arguments'\n/// types don't decide.\nfn narrow_by(\n  i: check.Inf,\n  c: ast.Expr,\n  params: List[String],\n  args: List[check.Ty],\n  owner: String,\n  left: Set[String],\n) -> (Set[String], Bool) {\n  about := walk.says_variant_of_it([c])\n  match c {\n    ast.Binary { op: ast.Implies, left: a, right: q } => match check.decide(i, a, params, args) {\n      Some(true) => check.narrow_by(i, q, params, args, owner, left),\n      Some(false) => (left, false),\n      None => (left, about),\n    },\n    // `(it is V) == A`: either way round\n    ast.Binary { op: ast.Equal, left: l, right: r } => match (\n      check.result_variants(i, l, owner),\n      check.result_variants(i, r, owner),\n    ) {\n      (Some(vs), None) => match check.decide(i, r, params, args) {\n        Some(true) => (left.intersection(vs), false),\n        Some(false) => (left.difference(vs), false),\n        None => (left, true),\n      },\n      (None, Some(vs)) => match check.decide(i, l, params, args) {\n        Some(true) => (left.intersection(vs), false),\n        Some(false) => (left.difference(vs), false),\n        None => (left, true),\n      },\n      _ => (left, about),\n    },\n    _ => match check.result_variants(i, c, owner) {\n      Some(vs) => (left.intersection(vs), false),\n      None => (left, about),\n    },\n  }\n}","old_text":"/// The variants `left` keeps under fact `c` about the result `it`.\nfn narrow_by(\n  i: check.Inf,\n  c: ast.Expr,\n  params: List[String],\n  args: List[check.Ty],\n  owner: String,\n  left: Set[String],\n) -> Set[String] {\n  match c {\n    ast.Binary { op: ast.Implies, left: a, right: q } => match check.decide(i, a, params, args) {\n      Some(true) => check.narrow_by(i, q, params, args, owner, left),\n      _ => left,\n    },\n    // `(it is V) == A`: either way round\n    ast.Binary { op: ast.Equal, left: l, right: r } => match (\n      check.result_variants(i, l, owner),\n      check.result_variants(i, r, owner),\n    ) {\n      (Some(vs), None) => match check.decide(i, r, params, args) {\n        Some(true) => left.intersection(vs),\n        Some(false) => left.difference(vs),\n        None => left,\n      },\n      (None, Some(vs)) => match check.decide(i, l, params, args) {\n        Some(true) => left.intersection(vs),\n        Some(false) => left.difference(vs),\n        None => left,\n      },\n      _ => left,\n    },\n    _ => match check.result_variants(i, c, owner) {\n      Some(vs) => left.intersection(vs),\n      None => left,\n    },\n  }\n}"},{"name":"check.variants_covered","kind":"fn","old":"28d337eb8b01307f","new":"e5a9622f52193fa3","interface_changed":true,"affected":["check.infer_match","check.infer_untagged","check.infer","check.infer_spread","check.infer_all","check.binary","check.infer_block","check.infer_call","check.infer_if","check.infer_list","check.infer_ctor","check.infer_lambda","check.infer_method","check.builtin_call","check.static_call","check.fn_inferred","check.task_body","check.default_errors","check.element_assigned","check.spread_method_params","check.spread_filled","check.iter_builtin","check.fn_errors","check.instantiated","check.fn_lambdas_typed","check.holes_of","check.mark_field_reads","check.own_methods_resolved","check.typed_one","check.decl_type_errors","check.spread_body","check.field_reads","eval_files","instantiated_files","check.lambdas_typed","holes_command","check_summary","finding.uses_of","rename_command","verified_decls","check.typed","check.type_errors_with","check.spreads_resolved","unused.members","command_line","check_command","finding.uses_from","finding.used_by_tree","finding.refs_command","verified_with","static_graph","codegen.new_gen","computed_value","repl_eval","check.type_errors","check_errors_in","literal_errors","expanded","unused.findings","main","strata_command","finding.uses_tree","verified_program","verify_file","build_command","graph_command","graph_diff","tour_graph","codegen.generate","codegen.read_back","comptime_value","repl_command","check_errors_with","edit_errors","literal_errors_of","codegen_with","with_base","unused_of","edit_unused","core_unused","codegen.entry","codegen.compiled_alone","eval.run","smt_file","termination_file","verify_command","build_proofs","alongside_command","search_invariants","diff_command","tour_command","core_rt_text","comptime_values","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","codegen_text","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","run_command","fix_loops","build_core_command","comptime_runner","package_errors","merge_file_command","merged_checks","call_command","edit_command","check_files","move_command","fix_command","edit_in_editor","codegen_file","jit_file","fuzz_file","graph_runs","replay","or_solver_inputs","program_objects","sync_command","check_fn","linked"],"module":"check","text":"/// A match on a call of one of the program's functions, whose result is\n/// a sum (`t`, or some of its variants: `narrowed_result`): an error for\n/// each arm the arms above leave nothing to, and for a variant no arm\n/// covers. `can`: the variants the call can give, `undecided`: whether\n/// that rests on conditions left to `verify`; then a variant not covered\n/// is `verify`'s to rule out (\"some arm of the `match` matches\"). Arms with\n/// conditions or nested patterns cover nothing here, and then nothing is\n/// reported missing.\nfn variants_covered(\n  mut i: check.Inf,\n  t: check.Ty,\n  can_at: Option[(List[String], Bool)],\n  arms: List[ast.Arm],\n) {\n  owner := match t {\n    check.TVariants { owner, .. } => owner,\n    check.TNamed { name, .. } => if contains(i.types.sums, name) {\n      name\n    } else {\n      return\n    },\n    _ => return,\n  }\n  all := get(i.types.variants, owner) ?? []\n  (can, undecided) := match can_at {\n    Some((c, u)) => (c, u),\n    None => match t {\n      check.TVariants { names, .. } => (names, false),\n      _ => (all, false),\n    },\n  }\n  shown_t := if len(can) < len(all) {\n    join(can.map(v -> check.last_part(v)), \" | \")\n  } else {\n    check.shown(t) ?? owner\n  }\n  mut left := set(can)\n  mut partial := false\n  for a in arms {\n    text := text.pattern_text(a.pat)\n    match check.pattern_variants(a.pat, owner, all) {\n      Some(vs) => {\n        if vs.intersection(left).len() == 0 {\n          if vs.intersection(set(can)).len() == 0\n            && len(can) < len(all) {\n            check.error(\n              mut i,\n              f\"unreachable match arm `{text}`: the result is `{shown_t}` here (from what its function ensures)\",\n            )\n          } else {\n            check.error(\n              mut i,\n              f\"unreachable match arm `{text}`: the arms above already cover it\",\n            )\n          }\n        }\n        left = left.difference(vs)\n      },\n      None => {\n        partial = true\n      },\n    }\n  }\n  if partial || undecided {\n    return\n  }\n  for v in can {\n    if contains(left, v) {\n      check.error(\n        mut i,\n        f\"non-exhaustive match on `{shown_t}`: `{check.last_part(v)}` is not covered\",\n      )\n      return\n    }\n  }\n}","old_text":"/// A match on a call's result of type `t`, a sum without type parameters\n/// or some of its variants (`narrowed_result`): an error for each arm the\n/// arms above leave nothing to, and for a variant no arm covers. Arms with\n/// conditions or nested patterns cover nothing here, and then nothing is\n/// reported missing (`verify` proves the match).\nfn variants_covered(mut i: check.Inf, t: check.Ty, arms: List[ast.Arm]) {\n  (owner, can) := match t {\n    check.TVariants { owner, names } => (owner, names),\n    check.TNamed { name, args: [] } => if contains(i.types.sums, name) {\n      (name, get(i.types.variants, name) ?? [])\n    } else {\n      return\n    },\n    _ => return,\n  }\n  all := get(i.types.variants, owner) ?? []\n  mut left := set(can)\n  mut partial := false\n  for a in arms {\n    text := text.pattern_text(a.pat)\n    match check.pattern_variants(i, a.pat, owner, all) {\n      Some(vs) => {\n        if vs.intersection(left).len() == 0 {\n          if vs.intersection(set(can)).len() == 0 {\n            check.error(\n              mut i,\n              f\"unreachable match arm `{text}`: the result is `{check.shown(t) ?? owner}` here (from what its function ensures)\",\n            )\n          } else {\n            check.error(\n              mut i,\n              f\"unreachable match arm `{text}`: the arms above already cover it\",\n            )\n          }\n        }\n        left = left.difference(vs)\n      },\n      None => {\n        partial = true\n      },\n    }\n  }\n  if !partial {\n    for v in can {\n      if contains(left, v) {\n        parts := split(v, \".\")\n        vn := get(parts, len(parts) - 1) ?? v\n        check.error(\n          mut i,\n          f\"non-exhaustive match on `{check.shown(t) ?? owner}`: `{vn}` is not covered\",\n        )\n        return\n      }\n    }\n  }\n}"},{"name":"check.pattern_variants","kind":"fn","old":"cdf5ab8e6dd69701","new":"6167711010df7c15","interface_changed":true,"affected":["check.variants_covered","check.infer_match","check.infer_untagged","check.infer","check.infer_spread","check.infer_all","check.binary","check.infer_block","check.infer_call","check.infer_if","check.infer_list","check.infer_ctor","check.infer_lambda","check.infer_method","check.builtin_call","check.static_call","check.fn_inferred","check.task_body","check.default_errors","check.element_assigned","check.spread_method_params","check.spread_filled","check.iter_builtin","check.fn_errors","check.instantiated","check.fn_lambdas_typed","check.holes_of","check.mark_field_reads","check.own_methods_resolved","check.typed_one","check.decl_type_errors","check.spread_body","check.field_reads","eval_files","instantiated_files","check.lambdas_typed","holes_command","check_summary","finding.uses_of","rename_command","verified_decls","check.typed","check.type_errors_with","check.spreads_resolved","unused.members","command_line","check_command","finding.uses_from","finding.used_by_tree","finding.refs_command","verified_with","static_graph","codegen.new_gen","computed_value","repl_eval","check.type_errors","check_errors_in","literal_errors","expanded","unused.findings","main","strata_command","finding.uses_tree","verified_program","verify_file","build_command","graph_command","graph_diff","tour_graph","codegen.generate","codegen.read_back","comptime_value","repl_command","check_errors_with","edit_errors","literal_errors_of","codegen_with","with_base","unused_of","edit_unused","core_unused","codegen.entry","codegen.compiled_alone","eval.run","smt_file","termination_file","verify_command","build_proofs","alongside_command","search_invariants","diff_command","tour_command","core_rt_text","comptime_values","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","codegen_text","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","run_command","fix_loops","build_core_command","comptime_runner","package_errors","merge_file_command","merged_checks","call_command","edit_command","check_files","move_command","fix_command","edit_in_editor","codegen_file","jit_file","fuzz_file","graph_runs","replay","or_solver_inputs","program_objects","sync_command","check_fn","linked"],"module":"check","text":"/// The variants of sum `owner` that pattern `p` matches whole (`Shipped`,\n/// `Paid { .. }`, `Some(x)`, `_`, `x`, `A | B`), or `None` when it matches\n/// some values of one only (a nested pattern, a condition).\nfn pattern_variants(\n  p: ast.Pattern,\n  owner: String,\n  all: List[String],\n) -> Option[Set[String]] {\n  match p {\n    ast.Wild => Some(set(all)),\n    ast.Bind(_) => Some(set(all)),\n    ast.CtorPattern { name, args } => {\n      whole := match args {\n        ast.NoPats => true,\n        ast.PositionalPats(ps) => ps.all(q -> q is ast.Wild || q is ast.Bind),\n        ast.RecordPats { fields, .. } => fields.all(fp -> fp.1 is ast.Wild || fp.1 is ast.Bind),\n        ast.TypePats(_) => false,\n      }\n      if !whole {\n        None\n      } else if name == owner {\n        Some(set(all))\n      } else if all.contains(name) {\n        Some(set([name]))\n      } else {\n        None\n      }\n    },\n    ast.OrPat(ps) => {\n      mut out := Set[String] {}\n      for q in ps {\n        match check.pattern_variants(q, owner, all) {\n          Some(vs) => {\n            out = out.union(vs)\n          },\n          None => return None,\n        }\n      }\n      Some(out)\n    },\n    _ => None,\n  }\n}","old_text":"/// The variants of sum `owner` that pattern `p` matches whole (`Shipped`,\n/// `Paid { .. }`, `_`, `x`, `A | B`), or `None` when it matches some values\n/// of one only (a nested pattern, a condition).\nfn pattern_variants(\n  i: check.Inf,\n  p: ast.Pattern,\n  owner: String,\n  all: List[String],\n) -> Option[Set[String]] {\n  match p {\n    ast.Wild => Some(set(all)),\n    ast.Bind(_) => Some(set(all)),\n    ast.CtorPattern { name, args } => {\n      whole := match args {\n        ast.NoPats => true,\n        ast.PositionalPats(ps) => ps.all(q -> q is ast.Wild || q is ast.Bind),\n        ast.RecordPats { fields, .. } => fields.all(fp -> fp.1 is ast.Wild || fp.1 is ast.Bind),\n        ast.TypePats(_) => false,\n      }\n      if !whole {\n        return None\n      }\n      if name == owner {\n        return Some(set(all))\n      }\n      if all.contains(name) {\n        Some(set([name]))\n      } else {\n        None\n      }\n    },\n    ast.OrPat(ps) => {\n      mut out := Set[String] {}\n      for q in ps {\n        match check.pattern_variants(i, q, owner, all) {\n          Some(vs) => {\n            out = out.union(vs)\n          },\n          None => return None,\n        }\n      }\n      Some(out)\n    },\n    _ => None,\n  }\n}"},{"name":"check.narrowed_at","kind":"fn","old":null,"new":"a8c7eed90dabf06b","interface_changed":true,"affected":[],"module":"check","text":"/// The variants of a sum that a call of `f` gives, from what `f` says of\n/// `it` (`walk.result_facts`): conjuncts `it is V` (or `!`, `||`, `&&` of\n/// them), `A ==> it is V` and `(it is V) == A`, where the checker decides\n/// `A` from the arguments' types (`o is Paid` with `o` narrowed to `Paid`).\n/// With the sum, all its variants, those left, and whether a fact about\n/// `it` depended on what the checker can't decide (then `verify` does).\n/// `None`: the result is no sum, or `f` says nothing of its variant. The\n/// callee's contract is taken as given: `verify` proves it, and while it\n/// isn't proven the callee checks it on return.\nfn narrowed_at(\n  i: check.Inf,\n  f: String,\n  args: List[check.Ty],\n  ret: check.Ty,\n) -> Option[(String, List[String], Set[String], Bool)] {\n  (params, facts) := match get(i.types.narrows, f) {\n    Some(x) => x,\n    None => return None,\n  }\n  owner := match check.res(i, ret) {\n    check.TNamed { name, .. } => if contains(i.types.sums, name) {\n      name\n    } else {\n      return None\n    },\n    check.TVariants { owner, .. } => owner,\n    _ => return None,\n  }\n  all := get(i.types.variants, owner) ?? []\n  mut left := set(all)\n  mut undecided := false\n  for fact in facts {\n    for c in check.conjuncts(fact) {\n      (l, u) := check.narrow_by(i, c, params, args, owner, left)\n      left = l\n      undecided = undecided || u\n    }\n  }\n  Some((owner, all, left, undecided))\n}"},{"name":"check.says_variant_of_it","kind":"fn","old":"71e1daf49df845dd","new":null,"interface_changed":true,"affected":[],"module":"check","old_text":"/// Whether one of `facts` says which variant the result is (`it is V`\n/// anywhere in it). A call of a function that does is narrowed by\n/// `narrowed_result`, and its matches are covered by `variants_covered`.\npub fn says_variant_of_it(facts: List[ast.Expr]) -> Bool {\n  facts.any(f -> check.tests_it(f))\n}"},{"name":"check.tests_it","kind":"fn","old":"de6f0eb91fb1cf96","new":null,"interface_changed":true,"affected":[],"module":"check","old_text":"fn tests_it(e: ast.Expr) -> Bool {\n  match e {\n    ast.IsExpr { value: ast.Var(\"it\"), .. } => true,\n    _ => check.children(e).any(c -> check.tests_it(c)),\n  }\n}"}]}
{"id":"bba6148a37d22dda","time":1795708129,"message":"edit","changes":[{"name":"smt.eval_expr","kind":"fn","old":"516e06e5bcae4890","new":"ba91c4e8a65d0e3b","interface_changed":false,"affected":[],"module":"smt","text":"fn eval_expr(mut vc: smt.Vc, e: ast.Expr, pol: Int) -> smt.Val {\n  if vc.dead {\n    return smt.UnitVal\n  }\n  match e {\n    ast.IntLit(n) => smt.VInt(smt.num(n)),\n    ast.BigIntLit(d) => smt.VInt(d),\n    ast.FloatLit(_) => smt.Opaque(\"floats are not modelled yet\"),\n    ast.StrLit(s) => if smt.smt_string(s) {\n      smt.VStr(smt.str_lit(s))\n    } else {\n      smt.Opaque(smt.beyond())\n    },\n    ast.BoolLit(b) => smt.VBool(if b {\n      \"true\"\n    } else {\n      \"false\"\n    }),\n    ast.UnitExpr => smt.UnitVal,\n    ast.TupleExpr(xs) => {\n      mut out := []\n      for x in xs {\n        mut out.push(smt.eval(mut vc, x))\n      }\n      smt.VTuple(out)\n    },\n    ast.Var(x) => match smt.lookup(vc, x) {\n      Some(v) => v,\n      None => smt.fn_name_value(mut vc, x),\n    },\n    ast.Hole(h) => smt.Opaque(f\"the hole `?{h}`\"),\n    ast.Range { .. } | ast.Index { .. } | ast.Comp { .. } | ast.DictExpr { .. } | ast.SetExpr { .. } => smt.Opaque(\"a range, slice or comprehension not desugared\"),\n    ast.MockExpr(t) => smt.Opaque(f\"`mock {text.type_text(t)}`\"),\n    ast.Spread(_) => smt.Opaque(\"a spread (`...x`) not written out\"),\n    ast.Select(_) => smt.Opaque(\"which arm of a `select` runs depends on timing\"),\n    ast.Race(_) => smt.Opaque(\"which arm of a `race` wins depends on timing\"),\n    // `mut xs.push(x)`: a builtin changing a list, dict or set\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => if builtins.changing(name) {\n      rv := smt.eval(mut vc, recv)\n      if smt.is_list(rv) {\n        smt.changed(mut vc, recv, rv, name, args)\n      } else {\n        smt.eval(mut vc, ast.MethodCall { recv, name, args })\n      }\n    } else {\n      smt.eval(mut vc, ast.MethodCall { recv, name, args })\n    },\n    ast.MutExpr(x) | ast.Comptime(x) | ast.Scope(x) | ast.Spawn(x) | ast.Await(x) | ast.Assumed(x) => smt.eval(mut vc, x),\n    // `old e`: `e` over the values before (at the function's start, or a\n    // callee's arguments before the call)\n    ast.Old(x) => match vc.olds {\n      Some(before) => {\n        saved := vc.scopes\n        vc.scopes = smt.old_scopes(before, saved)\n        vc.olds = None\n        v := smt.eval(mut vc, x)\n        vc.olds = Some(before)\n        vc.scopes = saved\n        v\n      },\n      None => {\n        smt.gap(mut vc, \"`old` outside an `ensures`\")\n        smt.Opaque(\"`old` outside an `ensures`\")\n      },\n    },\n    ast.SupervisedSpawn(_) => smt.Opaque(\"a supervised task's result (it may have panicked)\"),\n    ast.Interp(parts) => smt.interpolated(mut vc, parts),\n    ast.Return(x) => {\n      v := smt.eval(mut vc, x)\n      smt.early_return(mut vc, v)\n      smt.UnitVal\n    },\n    ast.Try { value, kind } => {\n      v := smt.eval(mut vc, value)\n      ok_name := match kind {\n        ast.TryResult => \"Ok\",\n        ast.TryOption => \"Some\",\n      }\n      match (v, smt.ctor_index(v, ok_name)) {\n        (smt.VSum { tag, ctors, .. }, Some(k)) => {\n          ok := f\"(= {tag} {k})\"\n          payload := get((get(ctors, k) ?? (\"\", [])).1, 0) ?? smt.Opaque(\"the payload of `Ok` / `Some`\")\n          // the error (or `None`) leaves the function as it is\n          n := len(vc.pc)\n          mut vc.pc.push(smt.neg(ok))\n          smt.early_return(mut vc, v)\n          vc.dead = false\n          vc.pc = take(vc.pc, n) + [ok]\n          payload\n        },\n        _ => {\n          n := len(vc.pc)\n          smt.early_return(\n            mut vc,\n            smt.Opaque(\"an early return through `!` / `?`\"),\n          )\n          vc.dead = false\n          vc.pc = take(vc.pc, n)\n          smt.Opaque(\"the value under `!` / `?`\")\n        },\n      }\n    },\n    ast.Except { value, err, fallback } => smt.fallback_value(mut vc, value, err, fallback),\n    ast.Fallback { value, fallback } => smt.fallback_value(mut vc, value, None, fallback),\n    ast.FieldOf { base, name } => {\n      v := smt.eval(mut vc, base)\n      smt.field(mut vc, v, name)\n    },\n    ast.Unary { op, operand } => {\n      v := match op {\n        ast.Not => smt.eval_pol(mut vc, operand, 0 - pol),\n        ast.Neg => smt.eval(mut vc, operand),\n      }\n      match op {\n        ast.Neg => match (v, smt.word_of(v)) {\n          (smt.VInt(t), _) => smt.VInt(f\"(- {t})\"),\n          (_, Some(w)) => {\n            t := smt.as_int(mut vc, v)\n            smt.word(w, smt.wrap_term(w, f\"(- {t})\"))\n          },\n          (other, _) => other,\n        },\n        ast.Not => smt.VBool(smt.neg(smt.as_bool(mut vc, v))),\n      }\n    },\n    ast.Binary { op, left, right } => smt.binary(mut vc, op, left, right, pol),\n    ast.IsExpr { value, variant } => {\n      v := smt.eval(mut vc, value)\n      if !contains(vc.ctors, variant) && smt.is_type_name(vc, variant) {\n        smt.VBool(smt.in_type(mut vc, smt.named(variant), v, []))\n      } else {\n        smt.VBool(smt.is_ctor(mut vc, v, variant))\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => {\n      cv := smt.eval(mut vc, cond)\n      c := smt.as_bool(mut vc, cv)\n      vc.polarity = pol\n      r := smt.branches(\n        mut vc,\n        [(c, [], then), (smt.neg(c), [], otherwise)],\n      )\n      vc.polarity = 0\n      r\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      v := smt.eval(mut vc, scrutinee)\n      mut prev := []\n      mut alts := []\n      mut narrow := []\n      for a in arms {\n        // a union narrowed to the one member the arm's pattern can match\n        member := match v {\n          smt.VUnion { slots, .. } => match smt.arm_slots(mut vc, a.pat, slots) {\n            [i] => Some((get(slots, i) ?? (\"\", smt.Inactive)).1),\n            _ => None,\n          },\n          _ => None,\n        }\n        mut narrow.push(\n          match (scrutinee, member) {\n            (ast.Var(x), Some(m)) => match smt.lookup(vc, x) {\n              Some(_) => [(x, m)],\n              None => [],\n            },\n            _ => [],\n          },\n        )\n        mut binds := match binding {\n          Some(n) => [(n, member ?? v)],\n          None => [],\n        }\n        n := len(vc.pc)\n        vc.pc += prev.map(p -> smt.neg(p))\n        cond := smt.pattern(mut vc, a.pat, v, mut binds)\n        vc.pc = take(vc.pc, n)\n        mut alts.push(\n          (\n            smt.and_all(prev.map(p -> smt.neg(p)) + [cond]),\n            binds,\n            a.body,\n          ),\n        )\n        mut prev.push(cond)\n      }\n      // arms with conditions the checker can't decide: some arm must match\n      // (else compiled code faults with `no match arm`)\n      // or on a call whose function says which variant it gives: the checker\n      // leaves the variants that rest on conditions to this proof\n      if arms.any(a -> smt.undecided(vc, a.pat))\n        || smt.gives_said_variant(vc, scrutinee) {\n        if smt.start_goal(mut vc) {\n          smt.oblige(\n            mut vc,\n            \"some arm of the `match` matches\",\n            smt.or_all(prev),\n          )\n        }\n      }\n      vc.polarity = pol\n      r := smt.branches_narrowed(mut vc, alts, narrow)\n      vc.polarity = 0\n      r\n    },\n    ast.Block { stmts, last } => {\n      mut vc.scopes.push(Dict[String, smt.Val] {})\n      for s in stmts {\n        smt.stmt(mut vc, s)\n        if vc.dead {\n          break\n        }\n      }\n      v := smt.eval_pol(mut vc, last, pol)\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      v\n    },\n    ast.CtorExpr { name, args } => smt.ctor(mut vc, name, args),\n    ast.Call { callee, args } => match callee {\n      ast.Var(name) => match smt.lookup(vc, name) {\n        None => {\n          vc.call_pol = pol\n          smt.call_exprs(mut vc, name, args)\n        },\n        Some(f) => smt.call_value(mut vc, f, args),\n      },\n      _ => {\n        smt.gap(mut vc, \"calling a function value\")\n        smt.Opaque(\"calling a function value\")\n      },\n    },\n    ast.MethodCall { recv, name, args } => {\n      // a method called on a type (`T.empty()`): a static method, the type\n      // only picking the implementation\n      on_type := match recv {\n        // a record's name is both its type's and its constructor's\n        ast.CtorExpr { name: t, args: ast.NoArgs } => !contains(vc.ctors, t) || contains(vc.types, t),\n        _ => false,\n      }\n      if on_type {\n        t := match recv {\n          ast.CtorExpr { name: n, .. } => n,\n          _ => \"\",\n        }\n        smt.static_call(mut vc, t, name, args)\n      } else if contains(vc.fns, name) && smt.own_method_of(vc, recv, name) {\n        // `k.bump()` where `k`'s type has its own method `bump`: that\n        // method, not the function of that name\n        rv := smt.eval(mut vc, recv)\n        mut vals := [rv]\n        for a in args {\n          mut vals.push(smt.eval(mut vc, a))\n        }\n        smt.method_call(mut vc, name, [recv] + args, vals) or {\n          smt.Opaque(\n            f\"the result of method `{name}` (it depends on the receiver's type)\",\n          )\n        }\n      } else {\n        vc.call_pol = pol\n        smt.call_exprs(mut vc, name, [recv] + args)\n      }\n    },\n    ast.ListExpr(xs) => {\n      mut vals := []\n      for x in xs {\n        mut vals.push(smt.eval(mut vc, x))\n      }\n      smt.new_list(mut vc, f\"{len(xs)}\", smt.GValues(vals))\n    },\n    ast.Lambda { .. } => smt.fn_value(mut vc, e, []).0,\n  }\n}","old_text":"fn eval_expr(mut vc: smt.Vc, e: ast.Expr, pol: Int) -> smt.Val {\n  if vc.dead {\n    return smt.UnitVal\n  }\n  match e {\n    ast.IntLit(n) => smt.VInt(smt.num(n)),\n    ast.BigIntLit(d) => smt.VInt(d),\n    ast.FloatLit(_) => smt.Opaque(\"floats are not modelled yet\"),\n    ast.StrLit(s) => if smt.smt_string(s) {\n      smt.VStr(smt.str_lit(s))\n    } else {\n      smt.Opaque(smt.beyond())\n    },\n    ast.BoolLit(b) => smt.VBool(if b {\n      \"true\"\n    } else {\n      \"false\"\n    }),\n    ast.UnitExpr => smt.UnitVal,\n    ast.TupleExpr(xs) => {\n      mut out := []\n      for x in xs {\n        mut out.push(smt.eval(mut vc, x))\n      }\n      smt.VTuple(out)\n    },\n    ast.Var(x) => match smt.lookup(vc, x) {\n      Some(v) => v,\n      None => smt.fn_name_value(mut vc, x),\n    },\n    ast.Hole(h) => smt.Opaque(f\"the hole `?{h}`\"),\n    ast.Range { .. } | ast.Index { .. } | ast.Comp { .. } | ast.DictExpr { .. } | ast.SetExpr { .. } => smt.Opaque(\"a range, slice or comprehension not desugared\"),\n    ast.MockExpr(t) => smt.Opaque(f\"`mock {text.type_text(t)}`\"),\n    ast.Spread(_) => smt.Opaque(\"a spread (`...x`) not written out\"),\n    ast.Select(_) => smt.Opaque(\"which arm of a `select` runs depends on timing\"),\n    ast.Race(_) => smt.Opaque(\"which arm of a `race` wins depends on timing\"),\n    // `mut xs.push(x)`: a builtin changing a list, dict or set\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => if builtins.changing(name) {\n      rv := smt.eval(mut vc, recv)\n      if smt.is_list(rv) {\n        smt.changed(mut vc, recv, rv, name, args)\n      } else {\n        smt.eval(mut vc, ast.MethodCall { recv, name, args })\n      }\n    } else {\n      smt.eval(mut vc, ast.MethodCall { recv, name, args })\n    },\n    ast.MutExpr(x) | ast.Comptime(x) | ast.Scope(x) | ast.Spawn(x) | ast.Await(x) | ast.Assumed(x) => smt.eval(mut vc, x),\n    // `old e`: `e` over the values before (at the function's start, or a\n    // callee's arguments before the call)\n    ast.Old(x) => match vc.olds {\n      Some(before) => {\n        saved := vc.scopes\n        vc.scopes = smt.old_scopes(before, saved)\n        vc.olds = None\n        v := smt.eval(mut vc, x)\n        vc.olds = Some(before)\n        vc.scopes = saved\n        v\n      },\n      None => {\n        smt.gap(mut vc, \"`old` outside an `ensures`\")\n        smt.Opaque(\"`old` outside an `ensures`\")\n      },\n    },\n    ast.SupervisedSpawn(_) => smt.Opaque(\"a supervised task's result (it may have panicked)\"),\n    ast.Interp(parts) => smt.interpolated(mut vc, parts),\n    ast.Return(x) => {\n      v := smt.eval(mut vc, x)\n      smt.early_return(mut vc, v)\n      smt.UnitVal\n    },\n    ast.Try { value, kind } => {\n      v := smt.eval(mut vc, value)\n      ok_name := match kind {\n        ast.TryResult => \"Ok\",\n        ast.TryOption => \"Some\",\n      }\n      match (v, smt.ctor_index(v, ok_name)) {\n        (smt.VSum { tag, ctors, .. }, Some(k)) => {\n          ok := f\"(= {tag} {k})\"\n          payload := get((get(ctors, k) ?? (\"\", [])).1, 0) ?? smt.Opaque(\"the payload of `Ok` / `Some`\")\n          // the error (or `None`) leaves the function as it is\n          n := len(vc.pc)\n          mut vc.pc.push(smt.neg(ok))\n          smt.early_return(mut vc, v)\n          vc.dead = false\n          vc.pc = take(vc.pc, n) + [ok]\n          payload\n        },\n        _ => {\n          n := len(vc.pc)\n          smt.early_return(\n            mut vc,\n            smt.Opaque(\"an early return through `!` / `?`\"),\n          )\n          vc.dead = false\n          vc.pc = take(vc.pc, n)\n          smt.Opaque(\"the value under `!` / `?`\")\n        },\n      }\n    },\n    ast.Except { value, err, fallback } => smt.fallback_value(mut vc, value, err, fallback),\n    ast.Fallback { value, fallback } => smt.fallback_value(mut vc, value, None, fallback),\n    ast.FieldOf { base, name } => {\n      v := smt.eval(mut vc, base)\n      smt.field(mut vc, v, name)\n    },\n    ast.Unary { op, operand } => {\n      v := match op {\n        ast.Not => smt.eval_pol(mut vc, operand, 0 - pol),\n        ast.Neg => smt.eval(mut vc, operand),\n      }\n      match op {\n        ast.Neg => match (v, smt.word_of(v)) {\n          (smt.VInt(t), _) => smt.VInt(f\"(- {t})\"),\n          (_, Some(w)) => {\n            t := smt.as_int(mut vc, v)\n            smt.word(w, smt.wrap_term(w, f\"(- {t})\"))\n          },\n          (other, _) => other,\n        },\n        ast.Not => smt.VBool(smt.neg(smt.as_bool(mut vc, v))),\n      }\n    },\n    ast.Binary { op, left, right } => smt.binary(mut vc, op, left, right, pol),\n    ast.IsExpr { value, variant } => {\n      v := smt.eval(mut vc, value)\n      if !contains(vc.ctors, variant) && smt.is_type_name(vc, variant) {\n        smt.VBool(smt.in_type(mut vc, smt.named(variant), v, []))\n      } else {\n        smt.VBool(smt.is_ctor(mut vc, v, variant))\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => {\n      cv := smt.eval(mut vc, cond)\n      c := smt.as_bool(mut vc, cv)\n      vc.polarity = pol\n      r := smt.branches(\n        mut vc,\n        [(c, [], then), (smt.neg(c), [], otherwise)],\n      )\n      vc.polarity = 0\n      r\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      v := smt.eval(mut vc, scrutinee)\n      mut prev := []\n      mut alts := []\n      mut narrow := []\n      for a in arms {\n        // a union narrowed to the one member the arm's pattern can match\n        member := match v {\n          smt.VUnion { slots, .. } => match smt.arm_slots(mut vc, a.pat, slots) {\n            [i] => Some((get(slots, i) ?? (\"\", smt.Inactive)).1),\n            _ => None,\n          },\n          _ => None,\n        }\n        mut narrow.push(\n          match (scrutinee, member) {\n            (ast.Var(x), Some(m)) => match smt.lookup(vc, x) {\n              Some(_) => [(x, m)],\n              None => [],\n            },\n            _ => [],\n          },\n        )\n        mut binds := match binding {\n          Some(n) => [(n, member ?? v)],\n          None => [],\n        }\n        n := len(vc.pc)\n        vc.pc += prev.map(p -> smt.neg(p))\n        cond := smt.pattern(mut vc, a.pat, v, mut binds)\n        vc.pc = take(vc.pc, n)\n        mut alts.push(\n          (\n            smt.and_all(prev.map(p -> smt.neg(p)) + [cond]),\n            binds,\n            a.body,\n          ),\n        )\n        mut prev.push(cond)\n      }\n      // arms with conditions the checker can't decide: some arm must match\n      // (else compiled code faults with `no match arm`)\n      if arms.any(a -> smt.undecided(vc, a.pat)) {\n        if smt.start_goal(mut vc) {\n          smt.oblige(\n            mut vc,\n            \"some arm of the `match` matches\",\n            smt.or_all(prev),\n          )\n        }\n      }\n      vc.polarity = pol\n      r := smt.branches_narrowed(mut vc, alts, narrow)\n      vc.polarity = 0\n      r\n    },\n    ast.Block { stmts, last } => {\n      mut vc.scopes.push(Dict[String, smt.Val] {})\n      for s in stmts {\n        smt.stmt(mut vc, s)\n        if vc.dead {\n          break\n        }\n      }\n      v := smt.eval_pol(mut vc, last, pol)\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      v\n    },\n    ast.CtorExpr { name, args } => smt.ctor(mut vc, name, args),\n    ast.Call { callee, args } => match callee {\n      ast.Var(name) => match smt.lookup(vc, name) {\n        None => {\n          vc.call_pol = pol\n          smt.call_exprs(mut vc, name, args)\n        },\n        Some(f) => smt.call_value(mut vc, f, args),\n      },\n      _ => {\n        smt.gap(mut vc, \"calling a function value\")\n        smt.Opaque(\"calling a function value\")\n      },\n    },\n    ast.MethodCall { recv, name, args } => {\n      // a method called on a type (`T.empty()`): a static method, the type\n      // only picking the implementation\n      on_type := match recv {\n        // a record's name is both its type's and its constructor's\n        ast.CtorExpr { name: t, args: ast.NoArgs } => !contains(vc.ctors, t) || contains(vc.types, t),\n        _ => false,\n      }\n      if on_type {\n        t := match recv {\n          ast.CtorExpr { name: n, .. } => n,\n          _ => \"\",\n        }\n        smt.static_call(mut vc, t, name, args)\n      } else if contains(vc.fns, name) && smt.own_method_of(vc, recv, name) {\n        // `k.bump()` where `k`'s type has its own method `bump`: that\n        // method, not the function of that name\n        rv := smt.eval(mut vc, recv)\n        mut vals := [rv]\n        for a in args {\n          mut vals.push(smt.eval(mut vc, a))\n        }\n        smt.method_call(mut vc, name, [recv] + args, vals) or {\n          smt.Opaque(\n            f\"the result of method `{name}` (it depends on the receiver's type)\",\n          )\n        }\n      } else {\n        vc.call_pol = pol\n        smt.call_exprs(mut vc, name, [recv] + args)\n      }\n    },\n    ast.ListExpr(xs) => {\n      mut vals := []\n      for x in xs {\n        mut vals.push(smt.eval(mut vc, x))\n      }\n      smt.new_list(mut vc, f\"{len(xs)}\", smt.GValues(vals))\n    },\n    ast.Lambda { .. } => smt.fn_value(mut vc, e, []).0,\n  }\n}"},{"name":"smt.use walk","kind":"use","old":"f263156f36ab89cd","new":"d471a66fa142c37a","interface_changed":true,"affected":[],"module":"smt","text":"from walk use kids, rewrite_decl, rewrite_expr, without_proofs,\n  says_variant_of_it, result_facts","old_text":"from walk use kids, rewrite_decl, rewrite_expr, without_proofs"},{"name":"smt.gives_said_variant","kind":"fn","old":null,"new":"c8abad8dc0d4c244","interface_changed":true,"affected":[],"module":"smt","text":"/// Whether `e` is a call of a function that says which variant its result\n/// is (`walk.says_variant_of_it`): a match on it is proven to cover the\n/// variants left (`check.variants_covered`).\nfn gives_said_variant(vc: smt.Vc, e: ast.Expr) -> Bool {\n  match e {\n    ast.Call { callee: ast.Var(f), .. } => match get(vc.fns, f) {\n      Some(fd) => walk.says_variant_of_it(walk.result_facts(fd)),\n      None => false,\n    },\n    _ => false,\n  }\n}"}]}
{"id":"ed46bebc6bef9f47","time":1795708394,"message":"edit","changes":[{"name":"smt.expand_alias","kind":"fn","old":"e41c4e215945c5c0","new":"d374d5006c22bf80","interface_changed":true,"affected":["smt.annotated","smt.structured","smt.type_key","smt.union_groups","smt.shape_test","smt.in_type","smt.stmt","smt.part","smt.key_test","smt.sort_of","smt.unfold","smt.sx_ok","smt.sx_literal","smt.arm_slots","smt.check_type_at","smt.pattern","smt.eval_expr","smt.shape","smt.merge","smt.eq","smt.field_sort","smt.valid_term","smt.from_term","smt.merge_data","smt.map_sorts","smt.term_of","smt.receiver_term","smt.rec_call","smt.pure_term","smt.applied_def","smt.same_sort","smt.share_deep","smt.force","smt.showable","smt.literal_of","smt.seq_items","smt.check_type","smt.ctor_pattern","smt.for_loop","smt.eval","smt.havoc","smt.call_exprs","smt.call","smt.call_contract","smt.template","smt.fn_value","smt.builtin","smt.havoc_loop","smt.call_value","smt.field","smt.ctor","smt.element_inner","smt.element_at_inner","smt.positions_either","smt.leave_loop","smt.branches_narrowed","smt.merge_union","smt.binary","smt.eq_lists","smt.eq_union","smt.same_call","smt.same_lists","smt.alias_lists","smt.unique_of","smt.congruent","smt.arg_eq","smt.define_fn","smt.map_store","smt.map_empty","smt.map_op","smt.map_instance","smt.rec_use","smt.fresh_keyed","smt.map_of","smt.map_literal","smt.item_of","smt.list_set","smt.map_key","smt.map_entry","smt.open_map","smt.ctor_terms","smt.element_term","smt.def_call","smt.as_int","smt.as_bool","smt.as_str","smt.is_ctor","smt.list_len","smt.set_path","smt.open_input","smt.element_type","smt.outcome","smt.answer_of","smt.inputs","smt.write_back","smt.assign","smt.function","smt.check_named","smt.apply","smt.map_insert","smt.shared_receiver","smt.ordered","smt.fallback_value","smt.written_on_entry","smt.assume_written","smt.written_kept","smt.candidate_value","smt.infer_invariants","smt.while_loop","smt.plain_loop","smt.method_call","smt.int_of","smt.static_call","smt.pass_measures","smt.pred_old","smt.changed","smt.list_sum","smt.eval_pol","smt.place_kind","smt.interpolated","smt.assert_by","smt.calc","smt.refresh","smt.fn_name_value","smt.instance","smt.element","smt.item_at","smt.element_at","smt.branches","smt.different","smt.eq_list_values","smt.know_map_all","smt.map_read","smt.lists_alike","smt.arith","smt.bits","smt.compare","smt.builtin_faults","smt.for_element","smt.known_of","smt.forall_positions","smt.know_all","smt.every","smt.concat","smt.all_of","smt.solve","smt.obligation_answers","smt.answers_all","or_solver_inputs","smt.write_after","smt.encode","smt.encode_answered","smt.encode_rounds","termination.termination_queries","termination.analyze_with","termination.loop_start","termination.measure_start","smt.prefix_sum","smt.derived_facts","smt.assume_facts","smt.assume_visited","smt.measures_at","smt.pred","smt.known_of_all","smt.list_valid","smt_file","check_fn","solved_with","smt.encode_all","smt.encode_solving","verify_file","termination.analyze","smt.measure_check","verify_command","command_line","solved_together","written_score","static_graph","build_proofs","alongside_command","search_invariants","termination_file","termination.measure_next","strata_command","main","find_invariants","graph_command","graph_diff","tour_graph","build_command","run_command","apply_edit","edit_file","fix_loops","termination.measures_all","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","diff_command","tour_command","edit_command","edit_in_editor","repl_command","fix_command","termination.find_measure","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","check_command","program_objects","comptime_values","call_command","loaded_errors","file_errors","edit_errors","linked","expanded","comptime_runner","package_errors","check_files","apply_change","with_base","rename_command","move_command"],"module":"smt","text":"/// Follows refinement aliases to the type they stand for: never a\n/// `Refined` (so a match on it needs no arm for one).\nfn expand_alias(\n  vc: smt.Vc,\n  t: ast.TypeExpr,\n) -> ast.TypeExpr where !(it is ast.Refined) {\n  match t {\n    ast.Refined { base, .. } => smt.expand_alias(vc, base),\n    ast.Named { name, args } => match get(vc.types, name) {\n      Some(td) => match td.body {\n        ast.Alias(a) => if td.distinct {\n          t\n        } else {\n          smt.expand_alias(\n            vc,\n            smt.subst(a, smt.params_of(td, args)),\n          )\n        },\n        _ => t,\n      },\n      None => t,\n    },\n    _ => t,\n  }\n}","old_text":"/// Follows refinement aliases to the type they stand for.\nfn expand_alias(vc: smt.Vc, t: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Refined { base, .. } => smt.expand_alias(vc, base),\n    ast.Named { name, args } => match get(vc.types, name) {\n      Some(td) => match td.body {\n        ast.Alias(a) => if td.distinct {\n          t\n        } else {\n          smt.expand_alias(\n            vc,\n            smt.subst(a, smt.params_of(td, args)),\n          )\n        },\n        _ => t,\n      },\n      None => t,\n    },\n    _ => t,\n  }\n}"},{"name":"smt.structured","kind":"fn","old":"c05cb44253554935","new":"e56e12144a867260","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether a value of `t` is more than one term (a record, sum or tuple).\nfn structured(vc: smt.Vc, t: ast.TypeExpr) -> Bool {\n  match smt.expand_alias(vc, t) {\n    ast.UnionType(_) => true,\n    ast.UnitType | ast.FnType { .. } => false,\n    ast.Named { name, .. } => match name {\n      \"Int\" | \"Bool\" | \"String\" | \"Float\" | \"List\" | \"Dict\" | \"Set\" => false,\n      \"Tuple\" => true,\n      _ => contains(vc.parents, name) || contains(vc.types, name),\n    },\n  }\n}","old_text":"/// Whether a value of `t` is more than one term (a record, sum or tuple).\nfn structured(vc: smt.Vc, t: ast.TypeExpr) -> Bool {\n  match smt.expand_alias(vc, t) {\n    ast.UnionType(_) => true,\n    ast.UnitType | ast.FnType { .. } | ast.Refined { .. } => false,\n    ast.Named { name, .. } => match name {\n      \"Int\" | \"Bool\" | \"String\" | \"Float\" | \"List\" | \"Dict\" | \"Set\" => false,\n      \"Tuple\" => true,\n      _ => contains(vc.parents, name) || contains(vc.types, name),\n    },\n  }\n}"}]}
{"id":"2944cb99345d04ea","time":1795708446,"message":"edit","changes":[{"name":"check.variants_covered","kind":"fn","old":"e5a9622f52193fa3","new":"fff04113aa67e355","interface_changed":false,"affected":[],"module":"check","text":"/// A match on a call of one of the program's functions, whose result is\n/// a sum (`t`, or some of its variants: `narrowed_result`): an error for\n/// each arm the arms above leave nothing to, and for a variant no arm\n/// covers. `can`: the variants the call can give, `undecided`: whether\n/// that rests on conditions left to `verify`; then a variant not covered\n/// is `verify`'s to rule out (\"some arm of the `match` matches\"). Arms with\n/// conditions or nested patterns cover nothing here, and then nothing is\n/// reported missing.\nfn variants_covered(\n  mut i: check.Inf,\n  t: check.Ty,\n  can_at: Option[(List[String], Bool)],\n  arms: List[ast.Arm],\n) {\n  owner := match t {\n    check.TVariants { owner, .. } => owner,\n    check.TNamed { name, .. } => if contains(i.types.sums, name) {\n      name\n    } else {\n      return\n    },\n    _ => return,\n  }\n  all := get(i.types.variants, owner) ?? []\n  (can, undecided) := match can_at {\n    Some((c, u)) => (c, u),\n    None => match t {\n      check.TVariants { names, .. } => (names, false),\n      _ => (all, false),\n    },\n  }\n  shown_t := if len(can) < len(all) {\n    join(can.map(v -> check.last_part(v)), \" | \")\n  } else {\n    match t {\n      check.TNamed { name, args: [] } => check.last_part(name),\n      _ => check.shown(t) ?? owner,\n    }\n  }\n  mut left := set(can)\n  mut partial := false\n  for a in arms {\n    text := text.pattern_text(a.pat)\n    match check.pattern_variants(a.pat, owner, all) {\n      Some(vs) => {\n        if vs.intersection(left).len() == 0 {\n          if vs.intersection(set(can)).len() == 0\n            && len(can) < len(all) {\n            check.error(\n              mut i,\n              f\"unreachable match arm `{text}`: the result is `{shown_t}` here (from what its function ensures)\",\n            )\n          } else {\n            check.error(\n              mut i,\n              f\"unreachable match arm `{text}`: the arms above already cover it\",\n            )\n          }\n        }\n        left = left.difference(vs)\n      },\n      None => {\n        partial = true\n      },\n    }\n  }\n  if partial || undecided {\n    return\n  }\n  for v in can {\n    if contains(left, v) {\n      check.error(\n        mut i,\n        f\"non-exhaustive match on `{shown_t}`: `{check.last_part(v)}` is not covered\",\n      )\n      return\n    }\n  }\n}","old_text":"/// A match on a call of one of the program's functions, whose result is\n/// a sum (`t`, or some of its variants: `narrowed_result`): an error for\n/// each arm the arms above leave nothing to, and for a variant no arm\n/// covers. `can`: the variants the call can give, `undecided`: whether\n/// that rests on conditions left to `verify`; then a variant not covered\n/// is `verify`'s to rule out (\"some arm of the `match` matches\"). Arms with\n/// conditions or nested patterns cover nothing here, and then nothing is\n/// reported missing.\nfn variants_covered(\n  mut i: check.Inf,\n  t: check.Ty,\n  can_at: Option[(List[String], Bool)],\n  arms: List[ast.Arm],\n) {\n  owner := match t {\n    check.TVariants { owner, .. } => owner,\n    check.TNamed { name, .. } => if contains(i.types.sums, name) {\n      name\n    } else {\n      return\n    },\n    _ => return,\n  }\n  all := get(i.types.variants, owner) ?? []\n  (can, undecided) := match can_at {\n    Some((c, u)) => (c, u),\n    None => match t {\n      check.TVariants { names, .. } => (names, false),\n      _ => (all, false),\n    },\n  }\n  shown_t := if len(can) < len(all) {\n    join(can.map(v -> check.last_part(v)), \" | \")\n  } else {\n    check.shown(t) ?? owner\n  }\n  mut left := set(can)\n  mut partial := false\n  for a in arms {\n    text := text.pattern_text(a.pat)\n    match check.pattern_variants(a.pat, owner, all) {\n      Some(vs) => {\n        if vs.intersection(left).len() == 0 {\n          if vs.intersection(set(can)).len() == 0\n            && len(can) < len(all) {\n            check.error(\n              mut i,\n              f\"unreachable match arm `{text}`: the result is `{shown_t}` here (from what its function ensures)\",\n            )\n          } else {\n            check.error(\n              mut i,\n              f\"unreachable match arm `{text}`: the arms above already cover it\",\n            )\n          }\n        }\n        left = left.difference(vs)\n      },\n      None => {\n        partial = true\n      },\n    }\n  }\n  if partial || undecided {\n    return\n  }\n  for v in can {\n    if contains(left, v) {\n      check.error(\n        mut i,\n        f\"non-exhaustive match on `{shown_t}`: `{check.last_part(v)}` is not covered\",\n      )\n      return\n    }\n  }\n}"}]}
{"id":"f2a2272c51cfb83d","time":1795708483,"message":"edit","changes":[{"name":"check.infer_if","kind":"fn","old":"f4e5ebf81d53cd39","new":"71d8e571baee5d5c","interface_changed":false,"affected":[],"module":"check","text":"fn infer_if(\n  mut i: check.Inf,\n  cond: ast.Expr,\n  then: ast.Expr,\n  otherwise: ast.Expr,\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  ct := check.infer(mut i, cond, env, None)\n  check.expect(mut i, check.TBool, ct, \"if condition\")\n  // `if o is Paid { … }`: `o` is a `Paid` in the branch taken, and not one\n  // in the other, when the branch doesn't assign it\n  (yes, no) := check.is_narrowed(i, cond, env)\n  then_env := check.narrowed_env(env, yes, then)\n  else_env := check.narrowed_env(env, no, otherwise)\n  match expected {\n    Some(exp) => {\n      for (b, be) in [(then, then_env), (otherwise, else_env)] {\n        bt := check.infer(mut i, b, be, Some(exp))\n        check.expect(mut i, exp, bt, \"if branch\")\n      }\n      exp\n    },\n    None => {\n      tt := check.infer(mut i, then, then_env, None)\n      ft := check.infer(mut i, otherwise, else_env, Some(tt))\n      check.join_union(mut i, tt, ft)\n    },\n  }\n}","old_text":"fn infer_if(\n  mut i: check.Inf,\n  cond: ast.Expr,\n  then: ast.Expr,\n  otherwise: ast.Expr,\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  ct := check.infer(mut i, cond, env, None)\n  check.expect(mut i, check.TBool, ct, \"if condition\")\n  match expected {\n    Some(exp) => {\n      for b in [then, otherwise] {\n        bt := check.infer(mut i, b, env, Some(exp))\n        check.expect(mut i, exp, bt, \"if branch\")\n      }\n      exp\n    },\n    None => {\n      tt := check.infer(mut i, then, env, None)\n      ft := check.infer(mut i, otherwise, env, Some(tt))\n      check.join_union(mut i, tt, ft)\n    },\n  }\n}"},{"name":"check.is_narrowed","kind":"fn","old":null,"new":"6d82f28d88b02706","interface_changed":true,"affected":[],"module":"check","text":"/// What condition `c` says of variables of sum types, when it holds and\n/// when it doesn't: each `x is V` conjunct narrows `x` to `V`'s variants\n/// where it holds; a lone `x is V` narrows `x` to the others where it\n/// doesn't. Only for sums without type parameters (`TVariants`).\nfn is_narrowed(\n  i: check.Inf,\n  c: ast.Expr,\n  env: Dict[String, check.Ty],\n) -> (Dict[String, check.Ty], Dict[String, check.Ty]) {\n  mut yes := Dict[String, check.Ty] {}\n  for part in check.conjuncts(c) {\n    match check.variable_is(i, part, env) {\n      Some((x, owner, has, vs)) => {\n        kept := has.intersection(vs)\n        if len(kept) > 0 {\n          mut yes.insert(\n            x,\n            check.TVariants { owner, names: to_list(kept).sorted() },\n          )\n        }\n      },\n      None => (),\n    }\n  }\n  mut no := Dict[String, check.Ty] {}\n  match check.variable_is(i, c, env) {\n    Some((x, owner, has, vs)) => {\n      kept := has.difference(vs)\n      if len(kept) > 0 {\n        mut no.insert(\n          x,\n          check.TVariants { owner, names: to_list(kept).sorted() },\n        )\n      }\n    },\n    None => (),\n  }\n  (yes, no)\n}"},{"name":"check.variable_is","kind":"fn","old":null,"new":"92b8d2c51e5fea44","interface_changed":true,"affected":[],"module":"check","text":"/// `x is V` on a variable of a sum: the variable, the sum, the variants\n/// it can be now, and those `V` accepts.\nfn variable_is(\n  i: check.Inf,\n  c: ast.Expr,\n  env: Dict[String, check.Ty],\n) -> Option[(String, String, Set[String], Set[String])] {\n  match c {\n    ast.IsExpr { value: ast.Var(x), variant } => {\n      (o, vs) := check.variants_named(i, variant)?\n      (owner, has) := match check.res(i, get(env, x) ?? check.TAny) {\n        check.TVariants { owner, names } => (owner, set(names)),\n        check.TNamed { name, args: [] } => (name, set(get(i.types.variants, name) ?? [])),\n        _ => return None,\n      }\n      if owner != o {\n        return None\n      }\n      Some((x, owner, has, vs))\n    },\n    _ => None,\n  }\n}"},{"name":"check.narrowed_env","kind":"fn","old":null,"new":"2d3dacbbd4158571","interface_changed":true,"affected":[],"module":"check","text":"/// `env` with the variables of `narrowed` given their narrowed types, but\n/// those `body` assigns (they keep their declared types).\nfn narrowed_env(\n  env: Dict[String, check.Ty],\n  narrowed: Dict[String, check.Ty],\n  body: ast.Expr,\n) -> Dict[String, check.Ty] {\n  mut out := env\n  for (x, t) in narrowed {\n    if contains(env, x) && !check.assigns_to(body, x) {\n      mut out.insert(x, t)\n    }\n  }\n  out\n}"}]}
{"id":"580b2bb61fc0c6ff","time":1795708572,"message":"edit","changes":[{"name":"check.unify","kind":"fn","old":"fa37feb97f7ce749","new":"619a5c9a8a3be96d","interface_changed":false,"affected":[],"module":"check","text":"/// Makes `a` and `b` the same type, binding type variables. False if they\n/// can't be.\nfn unify(mut i: check.Inf, a: check.Ty, b: check.Ty, fuel: Int) -> Bool {\n  if fuel <= 0 {\n    return true\n  }\n  ra := check.res(i, a)\n  rb := check.res(i, b)\n  if ra is check.TAny || rb is check.TAny {\n    return true\n  }\n  match ra {\n    check.TVar(x) => {\n      if rb != ra {\n        mut i.subst.insert(x, check.widened(rb))\n      }\n      return true\n    },\n    _ => (),\n  }\n  match rb {\n    check.TVar(y) => {\n      mut i.subst.insert(y, check.widened(ra))\n      return true\n    },\n    _ => (),\n  }\n  match ra {\n    check.TList(x) => match rb {\n      check.TList(y) => check.unify(mut i, x, y, fuel - 1),\n      _ => false,\n    },\n    check.TFn { params: ps, ret: r } => match rb {\n      check.TFn { params: qs, ret: s } => {\n        if len(ps) != len(qs) {\n          return false\n        }\n        mut ok := true\n        for (k, p) in enumerate(ps) {\n          if !check.unify(mut i, p, get(qs, k) ?? check.TAny, fuel - 1) {\n            ok = false\n          }\n        }\n        ok && check.unify(mut i, r, s, fuel - 1)\n      },\n      _ => false,\n    },\n    check.TNamed { name: n, args: xs } => match rb {\n      check.TNamed { name: m, args: ys } => {\n        if n != m || len(xs) != len(ys) {\n          return false\n        }\n        mut ok := true\n        for (k, x) in enumerate(xs) {\n          if !check.unify(mut i, x, get(ys, k) ?? check.TAny, fuel - 1) {\n            ok = false\n          }\n        }\n        ok\n      },\n      _ => false,\n    },\n    _ => ra == rb,\n  }\n}","old_text":"/// Makes `a` and `b` the same type, binding type variables. False if they\n/// can't be.\nfn unify(mut i: check.Inf, a: check.Ty, b: check.Ty, fuel: Int) -> Bool {\n  if fuel <= 0 {\n    return true\n  }\n  ra := check.res(i, a)\n  rb := check.res(i, b)\n  if ra is check.TAny || rb is check.TAny {\n    return true\n  }\n  match ra {\n    check.TVar(x) => {\n      if rb != ra {\n        mut i.subst.insert(x, rb)\n      }\n      return true\n    },\n    _ => (),\n  }\n  match rb {\n    check.TVar(y) => {\n      mut i.subst.insert(y, ra)\n      return true\n    },\n    _ => (),\n  }\n  match ra {\n    check.TList(x) => match rb {\n      check.TList(y) => check.unify(mut i, x, y, fuel - 1),\n      _ => false,\n    },\n    check.TFn { params: ps, ret: r } => match rb {\n      check.TFn { params: qs, ret: s } => {\n        if len(ps) != len(qs) {\n          return false\n        }\n        mut ok := true\n        for (k, p) in enumerate(ps) {\n          if !check.unify(mut i, p, get(qs, k) ?? check.TAny, fuel - 1) {\n            ok = false\n          }\n        }\n        ok && check.unify(mut i, r, s, fuel - 1)\n      },\n      _ => false,\n    },\n    check.TNamed { name: n, args: xs } => match rb {\n      check.TNamed { name: m, args: ys } => {\n        if n != m || len(xs) != len(ys) {\n          return false\n        }\n        mut ok := true\n        for (k, x) in enumerate(xs) {\n          if !check.unify(mut i, x, get(ys, k) ?? check.TAny, fuel - 1) {\n            ok = false\n          }\n        }\n        ok\n      },\n      _ => false,\n    },\n    _ => ra == rb,\n  }\n}"},{"name":"check.widened","kind":"fn","old":null,"new":"e59ab7f26aa6df8d","interface_changed":true,"affected":[],"module":"check","text":"/// A type a type variable can stand for: a narrowed value's sum, since what\n/// the variable types (a list's elements, a variable) may later hold any\n/// variant.\nfn widened(t: check.Ty) -> check.Ty {\n  match t {\n    check.TVariants { owner, .. } => check.TNamed { name: owner, args: [] },\n    _ => t,\n  }\n}"}]}
