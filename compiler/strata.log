}`: any record with at least these\n  // fields. Only a type parameter's bound (`T: { id: OrderId, .. }`), or a\n  // parameter's type, which `desugar` makes the bound of a type parameter\n  // of its own.\n  | RowType(List[(String, ast.TypeExpr)])","old_text":"pub type TypeExpr =\n  | Named { name: String, args: List[ast.TypeExpr] }\n  | FnType { params: List[ast.TypeExpr], ret: ast.TypeExpr }\n  | UnitType\n  | Refined { base: ast.TypeExpr, pred: ast.Expr }\n  | UnionType(List[ast.TypeExpr])"},{"name":"ast.bare_type","kind":"fn","old":"945bea905aee0c7b","new":"01cbf700c2c84b12","interface_changed":false,"affected":[],"module":"ast","text":"fn bare_type(t: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => ast.Named { name, args: args.map(x -> ast.bare_type(x)) },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(x -> ast.bare_type(x)),\n      ret: ast.bare_type(ret),\n    },\n    ast.UnitType => ast.UnitType,\n    ast.Refined { base, pred } => ast.Refined { base: ast.bare_type(base), pred: ast.bare(pred) },\n    ast.RowType(fs) => ast.RowType(fs.map(f -> (f.0, ast.bare_type(f.1)))),\n    ast.UnionType(ts) => ast.UnionType(ts.map(x -> ast.bare_type(x))),\n  }\n}","old_text":"fn bare_type(t: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => ast.Named { name, args: args.map(x -> ast.bare_type(x)) },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(x -> ast.bare_type(x)),\n      ret: ast.bare_type(ret),\n    },\n    ast.UnitType => ast.UnitType,\n    ast.Refined { base, pred } => ast.Refined { base: ast.bare_type(base), pred: ast.bare(pred) },\n    ast.UnionType(ts) => ast.UnionType(ts.map(x -> ast.bare_type(x))),\n  }\n}"},{"name":"binary.use ast","kind":"use","old":"ee5bc51babfeefa9","new":"a542dbb638b9ee3a","interface_changed":true,"affected":[],"module":"binary","text":"// binary: the binary format of `.strata` files (docs/binary-format.md). The\n// format is canonical: one tree has one encoding.\n\nfrom ast use DeriveFnDef, DeriveFnDecl, ModelDecl, ModelDef, Decl, DeclKind,\n  TypeDecl, Field, Variant, FnDecl, Param, Bound, TestDecl, TraitDecl,\n  Derivable, TraitMethod, Law, ImplDecl, UseDecl, UseItem, ExternDecl, Lang,\n  CapabilityDecl, TypeExpr, Expr, LamParam, CompFor, CompKind, Arm, FmtSpec,\n  BinOp, UnOp, TryKind, Stmt, Pattern, without_notes, SelectArm, TypeDef, FnDef,\n  TestDef, TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, Alias,\n  RecordBody, SumBody, NoPayload, Positional, RecordPayload, MemberType, C,\n  Python, Builtin, ExternFn, ExternType, ExternStatic, ExternThreadStatic,\n  Named, FnType, UnitType, Refined, UnionType, RowType, IntLit, BigIntLit,\n  FloatLit, TupleExpr, StrLit, BoolLit, UnitExpr, Var, Hole, ListExpr, CtorExpr,\n  Call, MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr,\n  MutExpr, Block, MockExpr, Return, Try, Except, Interp, Range, Index, Comp,\n  DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn, Await, Select, Race,\n  SupervisedSpawn, Old, Assumed, Spread, NoArgs, PositionalArgs, RecordArgs,\n  UpdateArgs, ListComp, SetComp, DictComp, TextPart, ValuePart, Add, Sub, Mul,\n  Div, Mod, Equal, NotEqual, Less, LessEq, Greater, GreaterEq, And, Or, Implies,\n  BitAnd, BitOr, BitXor, Shl, Shr, Neg, Not, TryResult, TryOption, Let, VarDecl,\n  Assign, While, For, Loop, Break, Continue, ExprStmt, Assert, Comment,\n  ComptimeFor, Invariant, Decreases, Wild, Bind, IntPat, StrPat, BoolPat,\n  CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat, NoPats,\n  PositionalPats, RecordPats, TypePats, DeriveClause, AssertBy, Calc","old_text":"// binary: the binary format of `.strata` files (docs/binary-format.md). The\n// format is canonical: one tree has one encoding.\n\nfrom ast use DeriveFnDef, DeriveFnDecl, ModelDecl, ModelDef, Decl, DeclKind,\n  TypeDecl, Field, Variant, FnDecl, Param, Bound, TestDecl, TraitDecl,\n  Derivable, TraitMethod, Law, ImplDecl, UseDecl, UseItem, ExternDecl, Lang,\n  CapabilityDecl, TypeExpr, Expr, LamParam, CompFor, CompKind, Arm, FmtSpec,\n  BinOp, UnOp, TryKind, Stmt, Pattern, without_notes, SelectArm, TypeDef, FnDef,\n  TestDef, TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, Alias,\n  RecordBody, SumBody, NoPayload, Positional, RecordPayload, MemberType, C,\n  Python, Builtin, ExternFn, ExternType, ExternStatic, ExternThreadStatic,\n  Named, FnType, UnitType, Refined, UnionType, IntLit, BigIntLit, FloatLit,\n  TupleExpr, StrLit, BoolLit, UnitExpr, Var, Hole, ListExpr, CtorExpr, Call,\n  MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr,\n  MutExpr, Block, MockExpr, Return, Try, Except, Interp, Range, Index, Comp,\n  DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn, Await, Select, Race,\n  SupervisedSpawn, Old, Assumed, Spread, NoArgs, PositionalArgs, RecordArgs,\n  UpdateArgs, ListComp, SetComp, DictComp, TextPart, ValuePart, Add, Sub, Mul,\n  Div, Mod, Equal, NotEqual, Less, LessEq, Greater, GreaterEq, And, Or, Implies,\n  BitAnd, BitOr, BitXor, Shl, Shr, Neg, Not, TryResult, TryOption, Let, VarDecl,\n  Assign, While, For, Loop, Break, Continue, ExprStmt, Assert, Comment,\n  ComptimeFor, Invariant, Decreases, Wild, Bind, IntPat, StrPat, BoolPat,\n  CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat, NoPats,\n  PositionalPats, RecordPats, TypePats, DeriveClause, AssertBy, Calc"},{"name":"binary.type_expr","kind":"fn","old":"127e5ec524744de1","new":"75c4d6ae0524d449","interface_changed":false,"affected":[],"module":"binary","text":"fn type_expr(mut r: binary.Reader) -> Result[ast.TypeExpr, String] {\n  binary.deeper(mut r)!\n  t := match binary.tag(mut r, \"type\", 5)! {\n    0 => {\n      name := binary.str(mut r)!\n      args := binary.type_exprs(mut r)!\n      ast.Named { name, args }\n    },\n    1 => {\n      ps := binary.type_exprs(mut r)!\n      ret := binary.type_expr(mut r)!\n      ast.FnType { params: ps, ret }\n    },\n    2 => ast.UnitType,\n    3 => {\n      base := binary.type_expr(mut r)!\n      pred := binary.expr(mut r)!\n      ast.Refined { base, pred }\n    },\n    4 => ast.UnionType(binary.type_exprs(mut r)!),\n    _ => {\n      mut fs := []\n      n := binary.length(mut r)!\n      for _ in 0..n {\n        name := binary.str(mut r)!\n        mut fs.push((name, binary.type_expr(mut r)!))\n      }\n      ast.RowType(fs)\n    },\n  }\n  r.depth -= 1\n  Ok(t)\n}","old_text":"fn type_expr(mut r: binary.Reader) -> Result[ast.TypeExpr, String] {\n  binary.deeper(mut r)!\n  t := match binary.tag(mut r, \"type\", 4)! {\n    0 => {\n      name := binary.str(mut r)!\n      args := binary.type_exprs(mut r)!\n      ast.Named { name, args }\n    },\n    1 => {\n      ps := binary.type_exprs(mut r)!\n      ret := binary.type_expr(mut r)!\n      ast.FnType { params: ps, ret }\n    },\n    2 => ast.UnitType,\n    3 => {\n      base := binary.type_expr(mut r)!\n      pred := binary.expr(mut r)!\n      ast.Refined { base, pred }\n    },\n    _ => ast.UnionType(binary.type_exprs(mut r)!),\n  }\n  r.depth -= 1\n  Ok(t)\n}"},{"name":"binary.put_type","kind":"fn","old":"61bcf5a20819347a","new":"caad49f2d1f71432","interface_changed":false,"affected":[],"module":"binary","text":"fn put_type(mut w: binary.Writer, t: ast.TypeExpr) {\n  match t {\n    ast.Named { name, args } => {\n      binary.w_byte(mut w, 0)\n      binary.w_str(mut w, name)\n      binary.w_types(mut w, args)\n    },\n    ast.FnType { params, ret } => {\n      binary.w_byte(mut w, 1)\n      binary.w_types(mut w, params)\n      binary.put_type(mut w, ret)\n    },\n    ast.UnitType => binary.w_byte(mut w, 2),\n    ast.Refined { base, pred } => {\n      binary.w_byte(mut w, 3)\n      binary.put_type(mut w, base)\n      binary.put_expr(mut w, pred)\n    },\n    ast.RowType(fs) => {\n      binary.w_byte(mut w, 5)\n      binary.w_uint(mut w, len(fs))\n      for f in fs {\n        binary.w_str(mut w, f.0)\n        binary.put_type(mut w, f.1)\n      }\n    },\n    ast.UnionType(ts) => {\n      binary.w_byte(mut w, 4)\n      binary.w_types(mut w, ts)\n    },\n  }\n}","old_text":"fn put_type(mut w: binary.Writer, t: ast.TypeExpr) {\n  match t {\n    ast.Named { name, args } => {\n      binary.w_byte(mut w, 0)\n      binary.w_str(mut w, name)\n      binary.w_types(mut w, args)\n    },\n    ast.FnType { params, ret } => {\n      binary.w_byte(mut w, 1)\n      binary.w_types(mut w, params)\n      binary.put_type(mut w, ret)\n    },\n    ast.UnitType => binary.w_byte(mut w, 2),\n    ast.Refined { base, pred } => {\n      binary.w_byte(mut w, 3)\n      binary.put_type(mut w, base)\n      binary.put_expr(mut w, pred)\n    },\n    ast.UnionType(ts) => {\n      binary.w_byte(mut w, 4)\n      binary.w_types(mut w, ts)\n    },\n  }\n}"},{"name":"cache.Cache","kind":"type","old":"ecd9317a704caf89","new":"ea184936611bda79","interface_changed":false,"affected":[],"module":"cache","text":"/// The caches a run uses:\n/// - `dir`: its own, the only one written (`$STRATA_CACHE`, else\n/// `~/.cache/strata`)\n/// - `shipped`: read-only, beside a release's executable, looked up first\n/// (`STRATA_SHIPPED_CACHE`, else `<the executable's\n/// folder>/../lib/strata/cache`;\n/// `\"\"` for none)\n/// - `smt`: scratch for the run's solver inputs, `dir/smt/PID`, removed at\n/// the end (`remove_scratch`). With `STRATA_KEEP_SMT` set it is `dir/smt`,\n/// kept, to read what the solver was asked.\npub type Cache = { dir: String, shipped: String, smt: String }","old_text":"/// The caches a run uses:\n/// - `dir`: its own, the only one written (`$STRATA_CACHE`, else\n/// `~/.cache/strata`)\n/// - `shipped`: read-only, beside a release's executable, looked up first\n/// (`STRATA_SHIPPED_CACHE`, else `<the executable's\n/// folder>/../lib/strata/cache`;\n/// `\"\"` for none)\n/// - `smt`: scratch for the run's solver inputs, `dir/smt/PID`, removed at\n/// the end (`remove_scratch`). With `STRATA_KEEP_SMT` set it is `dir/smt`,\n/// kept, to read what the solver was asked.\npub type Cache = { dir: String, shipped: String, smt: String }"},{"name":"capabilities.use ast","kind":"use","old":"bde3693b72284f52","new":"45626af872ecd109","interface_changed":true,"affected":[],"module":"capabilities","text":"// capabilities: the checker's rules on capabilities, tasks, raw memory,\n// `noalloc` and foreign functions that need no type inference.\n\nfrom ast use Decl, Param, TypeExpr, Expr, TryKind, Stmt, Pattern, SelectArm,\n  TypeDef, FnDef, TestDef, ExternDef, ExternDecl, Builtin, CapabilityDef, Alias,\n  ExternFn, ExternType, ExternStatic, ExternThreadStatic, Named, FnType,\n  Refined, UnionType, RowType, UnitType, TupleExpr, Var, ListExpr, CtorExpr,\n  Call, MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr,\n  MutExpr, Block, Return, Try, Except, Interp, Range, Index, Comp, DictExpr,\n  SetExpr, Fallback, Comptime, Scope, Spawn, Await, Select, Race,\n  SupervisedSpawn, Old, Assumed, Spread, NoArgs, PositionalArgs, RecordArgs,\n  UpdateArgs, TextPart, ValuePart, TryResult, TryOption, Let, VarDecl, Assign,\n  While, For, Loop, ExprStmt, Assert, ComptimeFor, Invariant, Decreases, Bind,\n  CtorPattern, ListPat, TuplePat, OrPat, ForPat, NoPats, PositionalPats,\n  RecordPats, TypePats, MockExpr, FnDecl, IntLit, BigIntLit, FloatLit, StrLit,\n  BoolLit, UnitExpr, Neg, C, ImplDef, TraitDef, Python, AssertBy, Calc","old_text":"// capabilities: the checker's rules on capabilities, tasks, raw memory,\n// `noalloc` and foreign functions that need no type inference.\n\nfrom ast use Decl, Param, TypeExpr, Expr, TryKind, Stmt, Pattern, SelectArm,\n  TypeDef, FnDef, TestDef, ExternDef, ExternDecl, Builtin, CapabilityDef, Alias,\n  ExternFn, ExternType, ExternStatic, ExternThreadStatic, Named, FnType,\n  Refined, UnionType, UnitType, TupleExpr, Var, ListExpr, CtorExpr, Call,\n  MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr,\n  MutExpr, Block, Return, Try, Except, Interp, Range, Index, Comp, DictExpr,\n  SetExpr, Fallback, Comptime, Scope, Spawn, Await, Select, Race,\n  SupervisedSpawn, Old, Assumed, Spread, NoArgs, PositionalArgs, RecordArgs,\n  UpdateArgs, TextPart, ValuePart, TryResult, TryOption, Let, VarDecl, Assign,\n  While, For, Loop, ExprStmt, Assert, ComptimeFor, Invariant, Decreases, Bind,\n  CtorPattern, ListPat, TuplePat, OrPat, ForPat, NoPats, PositionalPats,\n  RecordPats, TypePats, MockExpr, FnDecl, IntLit, BigIntLit, FloatLit, StrLit,\n  BoolLit, UnitExpr, Neg, C, ImplDef, TraitDef, Python, AssertBy, Calc"},{"name":"capabilities.json_error","kind":"fn","old":"66ccc503f192dbfe","new":"2c177e7c7f9b89de","interface_changed":false,"affected":[],"module":"capabilities","text":"/// Why `t` has no JSON form (`Json`), if it has none. `json` names the types\n/// that have one, `aliases` maps aliases to their bodies, and `depth` counts\n/// the aliases followed.\nfn json_error(\n  t: ast.TypeExpr,\n  json: Set[String],\n  aliases: Dict[String, ast.TypeExpr],\n  depth: Int,\n) -> Option[String] {\n  shown := \"`\" + text.type_text(t) + \"`\"\n  match t {\n    ast.Named { name, args } => {\n      n := capabilities.short(name)\n      if contains(json, n) {\n        fold(args.map(\n          a -> capabilities.json_error(a, json, aliases, depth),\n        ), None, (a, b) -> match a {\n          Some(_) => a,\n          None => b,\n        })\n      } else {\n        match get(aliases, n) {\n          Some(a) => if depth < 20 {\n            capabilities.json_error(a, json, aliases, depth + 1)\n          } else {\n            None\n          },\n          None => Some(\n            if n == \"Tuple\" {\n              \"a tuple (\"\n                + shown\n                + \") doesn't cross to Python: use a record that derives `Json`, or a list\"\n            } else {\n              \"`\"\n                + n\n                + \"` has no JSON form, so it can't cross to Python: derive `Json` for it (`derive Json for \"\n                + n\n                + \"`, std.json)\"\n            },\n          ),\n        }\n      }\n    },\n    ast.Refined { base, .. } => capabilities.json_error(base, json, aliases, depth),\n    ast.RowType(_) => Some(\"a structural type (\"\n      + shown\n      + \") doesn't cross to Python: use a record that derives `Json`\"),\n    ast.UnionType(ms) => fold(\n      ms.map(a -> capabilities.json_error(a, json, aliases, depth)),\n      None,\n      (a, b) -> match a {\n        Some(_) => a,\n        None => b,\n      },\n    ),\n    ast.FnType { .. } => Some(\"a function (\"\n      + shown\n      + \") doesn't cross to Python: only values with a JSON form (`Json`) do\"),\n    ast.UnitType => Some(\"`()` doesn't cross to Python (leave the parameter out)\"),\n  }\n}","old_text":"/// Why `t` has no JSON form (`Json`), if it has none. `json` names the types\n/// that have one, `aliases` maps aliases to their bodies, and `depth` counts\n/// the aliases followed.\nfn json_error(\n  t: ast.TypeExpr,\n  json: Set[String],\n  aliases: Dict[String, ast.TypeExpr],\n  depth: Int,\n) -> Option[String] {\n  shown := \"`\" + text.type_text(t) + \"`\"\n  match t {\n    ast.Named { name, args } => {\n      n := capabilities.short(name)\n      if contains(json, n) {\n        fold(args.map(\n          a -> capabilities.json_error(a, json, aliases, depth),\n        ), None, (a, b) -> match a {\n          Some(_) => a,\n          None => b,\n        })\n      } else {\n        match get(aliases, n) {\n          Some(a) => if depth < 20 {\n            capabilities.json_error(a, json, aliases, depth + 1)\n          } else {\n            None\n          },\n          None => Some(\n            if n == \"Tuple\" {\n              \"a tuple (\"\n                + shown\n                + \") doesn't cross to Python: use a record that derives `Json`, or a list\"\n            } else {\n              \"`\"\n                + n\n                + \"` has no JSON form, so it can't cross to Python: derive `Json` for it (`derive Json for \"\n                + n\n                + \"`, std.json)\"\n            },\n          ),\n        }\n      }\n    },\n    ast.Refined { base, .. } => capabilities.json_error(base, json, aliases, depth),\n    ast.UnionType(ms) => fold(\n      ms.map(a -> capabilities.json_error(a, json, aliases, depth)),\n      None,\n      (a, b) -> match a {\n        Some(_) => a,\n        None => b,\n      },\n    ),\n    ast.FnType { .. } => Some(\"a function (\"\n      + shown\n      + \") doesn't cross to Python: only values with a JSON form (`Json`) do\"),\n    ast.UnitType => Some(\"`()` doesn't cross to Python (leave the parameter out)\"),\n  }\n}"},{"name":"check.type_head","kind":"fn","old":"f574e1e02b698b4e","new":"26ba25e463031d4c","interface_changed":false,"affected":[],"module":"check","text":"fn type_head(t: ast.TypeExpr) -> String {\n  match t {\n    ast.Named { name, .. } => name,\n    ast.Refined { base, .. } => check.type_head(base),\n    ast.UnitType => \"Unit\",\n    ast.FnType { .. } => \"Fn\",\n    ast.RowType(_) => \"Row\",\n    ast.UnionType(_) => \"Union\",\n  }\n}","old_text":"fn type_head(t: ast.TypeExpr) -> String {\n  match t {\n    ast.Named { name, .. } => name,\n    ast.Refined { base, .. } => check.type_head(base),\n    ast.UnitType => \"Unit\",\n    ast.FnType { .. } => \"Fn\",\n    ast.UnionType(_) => \"Union\",\n  }\n}"},{"name":"check.lower","kind":"fn","old":"ca3a121dcbace016","new":"6dd7bcdb9c738b35","interface_changed":false,"affected":[],"module":"check","text":"/// A written type as a checker type. `types`: the types modelled. `tps`:\n/// the type parameters in scope.\nfn lower(types: check.Types, tps: Set[String], t: ast.TypeExpr) -> check.Ty {\n  match t {\n    ast.Named { name, args } => if len(args) == 0 && contains(tps, name) {\n      check.TGen(name)\n    } else if len(args) == 0 && name == \"Int\" {\n      check.TInt\n    } else if len(args) == 0 && name == \"Float\" {\n      check.TFloat\n    } else if len(args) == 0 && name == \"Bool\" {\n      check.TBool\n    } else if len(args) == 0 && name == \"String\" {\n      check.TStr\n    } else if len(args) == 0 && check.is_sized(name) {\n      // a sized integer: a type of its own\n      check.TNamed { name, args: [] }\n    } else if len(args) == 0 && check.refined_int(name) {\n      // the prelude's refinements are their base type\n      check.TInt\n    } else if len(args) == 0\n      && (name == \"Probability\" || name == \"Percentage\") {\n      check.TFloat\n    } else if len(args) == 0 && name == \"NonEmptyString\" {\n      check.TStr\n    } else if name == \"NonEmpty\" && len(args) == 1 {\n      check.TList(\n        check.lower(types, tps, get(args, 0) ?? ast.UnitType),\n      )\n    } else if len(args) == 0 && contains(types.traits, name) {\n      check.TTrait(name)\n    } else if len(args) == 0 && contains(types.aliases, name) {\n      // an alias is what it stands for, expanded once so aliases can't loop\n      match get(types.aliases, name) {\n        Some(a) => check.lower(check.Types { ..types, aliases: {\n          mut copy := types.aliases\n          mut copy.remove(name)\n          copy\n        } }, tps, a),\n        None => check.TAny,\n      }\n    } else if name == \"Tuple\" {\n      check.TNamed {\n        name,\n        args: args.map(x -> check.lower(types, tps, x)),\n      }\n    } else if name == \"List\" && len(args) == 1 {\n      check.TList(\n        check.lower(types, tps, get(args, 0) ?? ast.UnitType),\n      )\n    } else {\n      match get(types.named, name) {\n        Some(ps) => if len(ps) == len(args) {\n          mut xs := []\n          for a in args {\n            mut xs.push(check.lower(types, tps, a))\n          }\n          check.TNamed { name, args: xs }\n        } else {\n          check.TAny\n        },\n        None => check.TAny,\n      }\n    },\n    ast.UnitType => check.TUnit,\n    ast.Refined { base, .. } => check.lower(types, tps, base),\n    ast.RowType(_) => check.TAny,\n    ast.UnionType(ms) => check.union_of(ms.map(x -> check.lower(types, tps, x))),\n    ast.FnType { params, ret } => check.TFn {\n      params: params.map(x -> check.lower(types, tps, x)),\n      ret: check.lower(types, tps, ret),\n    },\n  }\n}","old_text":"/// A written type as a checker type. `types`: the types modelled. `tps`:\n/// the type parameters in scope.\nfn lower(types: check.Types, tps: Set[String], t: ast.TypeExpr) -> check.Ty {\n  match t {\n    ast.Named { name, args } => if len(args) == 0 && contains(tps, name) {\n      check.TGen(name)\n    } else if len(args) == 0 && name == \"Int\" {\n      check.TInt\n    } else if len(args) == 0 && name == \"Float\" {\n      check.TFloat\n    } else if len(args) == 0 && name == \"Bool\" {\n      check.TBool\n    } else if len(args) == 0 && name == \"String\" {\n      check.TStr\n    } else if len(args) == 0 && check.is_sized(name) {\n      // a sized integer: a type of its own\n      check.TNamed { name, args: [] }\n    } else if len(args) == 0 && check.refined_int(name) {\n      // the prelude's refinements are their base type\n      check.TInt\n    } else if len(args) == 0\n      && (name == \"Probability\" || name == \"Percentage\") {\n      check.TFloat\n    } else if len(args) == 0 && name == \"NonEmptyString\" {\n      check.TStr\n    } else if name == \"NonEmpty\" && len(args) == 1 {\n      check.TList(\n        check.lower(types, tps, get(args, 0) ?? ast.UnitType),\n      )\n    } else if len(args) == 0 && contains(types.traits, name) {\n      check.TTrait(name)\n    } else if len(args) == 0 && contains(types.aliases, name) {\n      // an alias is what it stands for, expanded once so aliases can't loop\n      match get(types.aliases, name) {\n        Some(a) => check.lower(check.Types { ..types, aliases: {\n          mut copy := types.aliases\n          mut copy.remove(name)\n          copy\n        } }, tps, a),\n        None => check.TAny,\n      }\n    } else if name == \"Tuple\" {\n      check.TNamed {\n        name,\n        args: args.map(x -> check.lower(types, tps, x)),\n      }\n    } else if name == \"List\" && len(args) == 1 {\n      check.TList(\n        check.lower(types, tps, get(args, 0) ?? ast.UnitType),\n      )\n    } else {\n      match get(types.named, name) {\n        Some(ps) => if len(ps) == len(args) {\n          mut xs := []\n          for a in args {\n            mut xs.push(check.lower(types, tps, a))\n          }\n          check.TNamed { name, args: xs }\n        } else {\n          check.TAny\n        },\n        None => check.TAny,\n      }\n    },\n    ast.UnitType => check.TUnit,\n    ast.Refined { base, .. } => check.lower(types, tps, base),\n    ast.UnionType(ms) => check.union_of(ms.map(x -> check.lower(types, tps, x))),\n    ast.FnType { params, ret } => check.TFn {\n      params: params.map(x -> check.lower(types, tps, x)),\n      ret: check.lower(types, tps, ret),\n    },\n  }\n}"},{"name":"check.self_is","kind":"fn","old":"603e7ca6e7f0d40d","new":"cf4951e3d62e2ff7","interface_changed":false,"affected":[],"module":"check","text":"/// `t` with `Self` written as `for_type`.\nfn self_is(t: ast.TypeExpr, for_type: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => if name == \"Self\" && len(args) == 0 {\n      for_type\n    } else {\n      ast.Named {\n        name,\n        args: args.map(a -> check.self_is(a, for_type)),\n      }\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> check.self_is(a, for_type)),\n      ret: check.self_is(ret, for_type),\n    },\n    ast.Refined { base, pred } => ast.Refined { base: check.self_is(base, for_type), pred },\n    ast.RowType(fs) => ast.RowType(fs.map(f -> (f.0, check.self_is(f.1, for_type)))),\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> check.self_is(a, for_type))),\n    ast.UnitType => ast.UnitType,\n  }\n}","old_text":"/// `t` with `Self` written as `for_type`.\nfn self_is(t: ast.TypeExpr, for_type: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => if name == \"Self\" && len(args) == 0 {\n      for_type\n    } else {\n      ast.Named {\n        name,\n        args: args.map(a -> check.self_is(a, for_type)),\n      }\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> check.self_is(a, for_type)),\n      ret: check.self_is(ret, for_type),\n    },\n    ast.Refined { base, pred } => ast.Refined { base: check.self_is(base, for_type), pred },\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> check.self_is(a, for_type))),\n    ast.UnitType => ast.UnitType,\n  }\n}"},{"name":"check.mentions_self","kind":"fn","old":"38038896ce9275e4","new":"0493c82d6c2bd05f","interface_changed":false,"affected":[],"module":"check","text":"/// A written type names `Self`.\nfn mentions_self(t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Named { name, args } => name == \"Self\" || args.any(a -> check.mentions_self(a)),\n    ast.FnType { params, ret } => params.any(a -> check.mentions_self(a))\n      || check.mentions_self(ret),\n    ast.Refined { base, .. } => check.mentions_self(base),\n    ast.RowType(fs) => fs.any(f -> check.mentions_self(f.1)),\n    ast.UnionType(ms) => ms.any(a -> check.mentions_self(a)),\n    ast.UnitType => false,\n  }\n}","old_text":"/// A written type names `Self`.\nfn mentions_self(t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Named { name, args } => name == \"Self\" || args.any(a -> check.mentions_self(a)),\n    ast.FnType { params, ret } => params.any(a -> check.mentions_self(a))\n      || check.mentions_self(ret),\n    ast.Refined { base, .. } => check.mentions_self(base),\n    ast.UnionType(ms) => ms.any(a -> check.mentions_self(a)),\n    ast.UnitType => false,\n  }\n}"},{"name":"check.mentions_any","kind":"fn","old":"5b733d75e8ac7082","new":"b74b12b184e00de6","interface_changed":false,"affected":[],"module":"check","text":"/// A written type names one of the type parameters `ps`.\nfn mentions_any(t: ast.TypeExpr, ps: List[String]) -> Bool {\n  match t {\n    ast.Named { name, args } => ps.contains(name) || args.any(a -> check.mentions_any(a, ps)),\n    ast.Refined { base, .. } => check.mentions_any(base, ps),\n    ast.FnType { params, ret } => params.any(a -> check.mentions_any(a, ps))\n      || check.mentions_any(ret, ps),\n    ast.RowType(fs) => fs.any(f -> check.mentions_any(f.1, ps)),\n    ast.UnionType(xs) => xs.any(a -> check.mentions_any(a, ps)),\n    ast.UnitType => false,\n  }\n}","old_text":"/// A written type names one of the type parameters `ps`.\nfn mentions_any(t: ast.TypeExpr, ps: List[String]) -> Bool {\n  match t {\n    ast.Named { name, args } => ps.contains(name) || args.any(a -> check.mentions_any(a, ps)),\n    ast.Refined { base, .. } => check.mentions_any(base, ps),\n    ast.FnType { params, ret } => params.any(a -> check.mentions_any(a, ps))\n      || check.mentions_any(ret, ps),\n    ast.UnionType(xs) => xs.any(a -> check.mentions_any(a, ps)),\n    ast.UnitType => false,\n  }\n}"},{"name":"codebase.merge_parsed","kind":"fn","old":"5ec5b630ba51538d","new":"157087210e3c84a5","interface_changed":false,"affected":[],"module":"codebase","text":"/// `merge` for core's modules, whose names are global. The edits stay as\n/// parsed, unqualified: a call stays `lock(32)`, since codegen looks\n/// core.rt's\n/// functions up by name.\npub fn merge_parsed(\n  base: List[ast.Decl],\n  edits: List[ast.Decl],\n  deletes: List[String],\n) -> List[ast.Decl] {\n  codebase.put_in(\n    base.filter(d -> !contains(deletes, store.qname(d))),\n    edits,\n  )\n}","old_text":"/// `merge` for core's modules, whose names are global. The edits stay as\n/// parsed, unqualified: a call stays `lock(32)`, since codegen looks\n/// core.rt's\n/// functions up by name.\npub fn merge_parsed(\n  base: List[ast.Decl],\n  edits: List[ast.Decl],\n  deletes: List[String],\n) -> List[ast.Decl] {\n  codebase.put_in(\n    base.filter(d -> !contains(deletes, store.qname(d))),\n    edits,\n  )\n}"},{"name":"codegen.self_is","kind":"fn","old":"c7371998bb876dc6","new":"7f9215ceb981b4a6","interface_changed":false,"affected":[],"module":"codegen","text":"/// `t` with names replaced from `names`: `Self` by the `impl`'s type, a\n/// trait's parameters by the `impl`'s arguments.\nfn self_is(t: ast.TypeExpr, names: Dict[String, ast.TypeExpr]) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => if len(args) == 0 && contains(names, name) {\n      get(names, name) ?? t\n    } else {\n      ast.Named {\n        name,\n        args: args.map(a -> codegen.self_is(a, names)),\n      }\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> codegen.self_is(a, names)),\n      ret: codegen.self_is(ret, names),\n    },\n    ast.Refined { base, pred } => ast.Refined { base: codegen.self_is(base, names), pred },\n    ast.RowType(fs) => ast.RowType(fs.map(f -> (f.0, codegen.self_is(f.1, names)))),\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> codegen.self_is(a, names))),\n    ast.UnitType => ast.UnitType,\n  }\n}","old_text":"/// `t` with names replaced from `names`: `Self` by the `impl`'s type, a\n/// trait's parameters by the `impl`'s arguments.\nfn self_is(t: ast.TypeExpr, names: Dict[String, ast.TypeExpr]) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => if len(args) == 0 && contains(names, name) {\n      get(names, name) ?? t\n    } else {\n      ast.Named {\n        name,\n        args: args.map(a -> codegen.self_is(a, names)),\n      }\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> codegen.self_is(a, names)),\n      ret: codegen.self_is(ret, names),\n    },\n    ast.Refined { base, pred } => ast.Refined { base: codegen.self_is(base, names), pred },\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> codegen.self_is(a, names))),\n    ast.UnitType => ast.UnitType,\n  }\n}"},{"name":"codegen.needs_check","kind":"fn","old":"a45036af9cff85ac","new":"b4edd2e28c33d6d1","interface_changed":false,"affected":[],"module":"codegen","text":"fn needs_check(g: codegen.Gen, t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Refined { .. } => true,\n    // a union with a refined member, written or by name\n    ast.RowType(fs) => fs.any(f -> codegen.needs_check(g, f.1)),\n    ast.UnionType(ws) => ws.any(w -> codegen.needs_check(g, w)),\n    ast.Named { name, args: [] } => contains(g.refines, name)\n      || match get(g.types.aliases, name) {\n        Some(ast.UnionType(ws)) => ws.any(w -> codegen.needs_check(g, w)),\n        _ => false,\n      },\n    // the contents of a list, set, dict, option or result, or an alias with\n    // type parameters and a refinement (`NonEmpty[Int]`)\n    ast.Named { name, args } => [\"List\", \"Set\", \"Dict\", \"Option\", \"Result\"].any(\n          n -> n == name,\n        )\n        && args.any(a -> codegen.needs_check(g, a))\n      || codegen.generic_refined(g, t) is Some,\n    _ => false,\n  }\n}","old_text":"fn needs_check(g: codegen.Gen, t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Refined { .. } => true,\n    // a union with a refined member, written or by name\n    ast.UnionType(ws) => ws.any(w -> codegen.needs_check(g, w)),\n    ast.Named { name, args: [] } => contains(g.refines, name)\n      || match get(g.types.aliases, name) {\n        Some(ast.UnionType(ws)) => ws.any(w -> codegen.needs_check(g, w)),\n        _ => false,\n      },\n    // the contents of a list, set, dict, option or result, or an alias with\n    // type parameters and a refinement (`NonEmpty[Int]`)\n    ast.Named { name, args } => [\"List\", \"Set\", \"Dict\", \"Option\", \"Result\"].any(\n          n -> n == name,\n        )\n        && args.any(a -> codegen.needs_check(g, a))\n      || codegen.generic_refined(g, t) is Some,\n    _ => false,\n  }\n}"},{"name":"codegen.written_in","kind":"fn","old":"69bf5ca248c5bd70","new":"733bb462f586492e","interface_changed":false,"affected":[],"module":"codegen","text":"/// A written type with type parameters `ps` replaced by `args`.\nfn written_in(\n  t: ast.TypeExpr,\n  ps: List[String],\n  args: List[ast.TypeExpr],\n) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args: targs } => {\n      mut found := None\n      for (k, p) in enumerate(ps) {\n        if p == name && targs == [] {\n          found = get(args, k)\n        }\n      }\n      match found {\n        Some(a) => a,\n        None => ast.Named {\n          name,\n          args: targs.map(a -> codegen.written_in(a, ps, args)),\n        },\n      }\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(p -> codegen.written_in(p, ps, args)),\n      ret: codegen.written_in(ret, ps, args),\n    },\n    ast.Refined { base, pred } => ast.Refined { base: codegen.written_in(base, ps, args), pred },\n    ast.RowType(fs) => ast.RowType(\n      fs.map(f -> (f.0, codegen.written_in(f.1, ps, args))),\n    ),\n    ast.UnionType(ms) => ast.UnionType(ms.map(m -> codegen.written_in(m, ps, args))),\n    ast.UnitType => ast.UnitType,\n  }\n}","old_text":"/// A written type with type parameters `ps` replaced by `args`.\nfn written_in(\n  t: ast.TypeExpr,\n  ps: List[String],\n  args: List[ast.TypeExpr],\n) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args: targs } => {\n      mut found := None\n      for (k, p) in enumerate(ps) {\n        if p == name && targs == [] {\n          found = get(args, k)\n        }\n      }\n      match found {\n        Some(a) => a,\n        None => ast.Named {\n          name,\n          args: targs.map(a -> codegen.written_in(a, ps, args)),\n        },\n      }\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(p -> codegen.written_in(p, ps, args)),\n      ret: codegen.written_in(ret, ps, args),\n    },\n    ast.Refined { base, pred } => ast.Refined { base: codegen.written_in(base, ps, args), pred },\n    ast.UnionType(ms) => ast.UnionType(ms.map(m -> codegen.written_in(m, ps, args))),\n    ast.UnitType => ast.UnitType,\n  }\n}"},{"name":"codegen.mentions_self","kind":"fn","old":"04322734205076c8","new":"9c4538d3bd7e9ad4","interface_changed":false,"affected":[],"module":"codegen","text":"/// Whether a written type mentions the trait's `Self` anywhere.\nfn mentions_self(t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Named { name, args } => name == \"Self\" || args.any(a -> codegen.mentions_self(a)),\n    ast.FnType { params, ret } => params.any(p -> codegen.mentions_self(p))\n      || codegen.mentions_self(ret),\n    ast.Refined { base, .. } => codegen.mentions_self(base),\n    ast.RowType(fs) => fs.any(f -> codegen.mentions_self(f.1)),\n    ast.UnionType(ws) => ws.any(w -> codegen.mentions_self(w)),\n    ast.UnitType => false,\n  }\n}","old_text":"/// Whether a written type mentions the trait's `Self` anywhere.\nfn mentions_self(t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Named { name, args } => name == \"Self\" || args.any(a -> codegen.mentions_self(a)),\n    ast.FnType { params, ret } => params.any(p -> codegen.mentions_self(p))\n      || codegen.mentions_self(ret),\n    ast.Refined { base, .. } => codegen.mentions_self(base),\n    ast.UnionType(ws) => ws.any(w -> codegen.mentions_self(w)),\n    ast.UnitType => false,\n  }\n}"},{"name":"codegen.mentions_any","kind":"fn","old":"e30b1ea898ad0b3b","new":"298c91231c46cb2b","interface_changed":false,"affected":[],"module":"codegen","text":"/// Whether written type `t` names any of `vs`.\nfn mentions_any(t: ast.TypeExpr, vs: List[String]) -> Bool {\n  match t {\n    ast.Named { name, args } => contains(vs, name) || args.any(a -> codegen.mentions_any(a, vs)),\n    ast.FnType { params, ret } => params.any(a -> codegen.mentions_any(a, vs))\n      || codegen.mentions_any(ret, vs),\n    ast.Refined { base, .. } => codegen.mentions_any(base, vs),\n    ast.RowType(fs) => fs.any(f -> codegen.mentions_any(f.1, vs)),\n    ast.UnionType(ms) => ms.any(a -> codegen.mentions_any(a, vs)),\n    ast.UnitType => false,\n  }\n}","old_text":"/// Whether written type `t` names any of `vs`.\nfn mentions_any(t: ast.TypeExpr, vs: List[String]) -> Bool {\n  match t {\n    ast.Named { name, args } => contains(vs, name) || args.any(a -> codegen.mentions_any(a, vs)),\n    ast.FnType { params, ret } => params.any(a -> codegen.mentions_any(a, vs))\n      || codegen.mentions_any(ret, vs),\n    ast.Refined { base, .. } => codegen.mentions_any(base, vs),\n    ast.UnionType(ms) => ms.any(a -> codegen.mentions_any(a, vs)),\n    ast.UnitType => false,\n  }\n}"},{"name":"contracts.use ast","kind":"use","old":"033b8d3525db0116","new":"bb01284725273d05","interface_changed":true,"affected":[],"module":"contracts","text":"// contracts: the checker's rules on contracts, refinements, `old`, trait\n// models and `shared` races, judged from literals and written types only.\n\nfrom ast use Decl, TypeDecl, Field, FnDecl, Param, TraitDecl, ImplDecl,\n  TypeExpr, Expr, BinOp, Pattern, TypeDef, FnDef, TestDef, TraitDef, ImplDef,\n  ExternDef, Alias, RecordBody, SumBody, RecordPayload, ExternFn, Named, FnType,\n  UnitType, Refined, UnionType, RowType, IntLit, BigIntLit, FloatLit, TupleExpr,\n  StrLit, BoolLit, UnitExpr, Var, ListExpr, Call, MethodCall, FieldOf, Binary,\n  Unary, IsExpr, IfExpr, MatchExpr, Block, Interp, Index, Comptime, Scope, Add,\n  Sub, Mul, Div, Mod, Equal, NotEqual, Less, LessEq, Greater, GreaterEq, And,\n  Or, Implies, Neg, Not, Let, VarDecl, Assign, While, For, Loop, ExprStmt, Wild,\n  Bind, IntPat, StrPat, BoolPat, Old, Assumed, Spread, Lambda, CapabilityDef,\n  MutExpr, Stmt","old_text":"// contracts: the checker's rules on contracts, refinements, `old`, trait\n// models and `shared` races, judged from literals and written types only.\n\nfrom ast use Decl, TypeDecl, Field, FnDecl, Param, TraitDecl, ImplDecl,\n  TypeExpr, Expr, BinOp, Pattern, TypeDef, FnDef, TestDef, TraitDef, ImplDef,\n  ExternDef, Alias, RecordBody, SumBody, RecordPayload, ExternFn, Named, FnType,\n  UnitType, Refined, UnionType, IntLit, BigIntLit, FloatLit, TupleExpr, StrLit,\n  BoolLit, UnitExpr, Var, ListExpr, Call, MethodCall, FieldOf, Binary, Unary,\n  IsExpr, IfExpr, MatchExpr, Block, Interp, Index, Comptime, Scope, Add, Sub,\n  Mul, Div, Mod, Equal, NotEqual, Less, LessEq, Greater, GreaterEq, And, Or,\n  Implies, Neg, Not, Let, VarDecl, Assign, While, For, Loop, ExprStmt, Wild,\n  Bind, IntPat, StrPat, BoolPat, Old, Assumed, Spread, Lambda, CapabilityDef,\n  MutExpr, Stmt"},{"name":"contracts.refined_errors","kind":"fn","old":"4f0a53ee79cc6dac","new":"23cf0da83b40309d","interface_changed":false,"affected":[],"module":"contracts","text":"/// The errors of the refinements inside a type: each `where` is a `Bool`,\n/// with `it` the value of the type it refines.\nfn refined_errors(\n  types: Dict[String, ast.TypeDecl],\n  env: Dict[String, String],\n  t: ast.TypeExpr,\n) -> List[String] {\n  match t {\n    ast.Refined { base, pred } => contracts.refined_errors(types, env, base)\n      + contracts.not_bool(\n        \"refinement `where \" + text.expr_text(pred, 0) + \"`\",\n        contracts.shallow({\n          mut copy := env\n          mut copy.insert(\"it\", contracts.simple(types, base, 8))\n          copy\n        }, pred),\n      ),\n    ast.Named { args, .. } => contracts.refined_all(types, env, args),\n    ast.RowType(fs) => contracts.refined_all(types, env, fs.map(f -> f.1)),\n    ast.UnionType(ms) => contracts.refined_all(types, env, ms),\n    ast.FnType { params, ret } => contracts.refined_all(types, env, params + [ret]),\n    ast.UnitType => [],\n  }\n}","old_text":"/// The errors of the refinements inside a type: each `where` is a `Bool`,\n/// with `it` the value of the type it refines.\nfn refined_errors(\n  types: Dict[String, ast.TypeDecl],\n  env: Dict[String, String],\n  t: ast.TypeExpr,\n) -> List[String] {\n  match t {\n    ast.Refined { base, pred } => contracts.refined_errors(types, env, base)\n      + contracts.not_bool(\n        \"refinement `where \" + text.expr_text(pred, 0) + \"`\",\n        contracts.shallow({\n          mut copy := env\n          mut copy.insert(\"it\", contracts.simple(types, base, 8))\n          copy\n        }, pred),\n      ),\n    ast.Named { args, .. } => contracts.refined_all(types, env, args),\n    ast.UnionType(ms) => contracts.refined_all(types, env, ms),\n    ast.FnType { params, ret } => contracts.refined_all(types, env, params + [ret]),\n    ast.UnitType => [],\n  }\n}"},{"name":"declarations.use ast","kind":"use","old":"b2ec2dfb965a4ae3","new":"e374fad2b35c207a","interface_changed":true,"affected":[],"module":"declarations","text":"// declarations: the checker's errors about names, type arguments, `Self`,\n// `break` and `continue`, impls against their traits, and constructor patterns.\n\nfrom ast use Decl, TypeDecl, Field, FnDecl, Param, Bound, TypeExpr, Expr,\n  CtorArgs, LamParam, Arm, BinOp, Stmt, Pattern, TypeDef, FnDef, TraitDef,\n  ImplDef, ExternDef, CapabilityDef, Alias, RecordBody, SumBody, NoPayload,\n  Positional, RecordPayload, MemberType, ExternFn, ExternType, ExternStatic,\n  ExternThreadStatic, Named, FnType, UnitType, Refined, UnionType, RowType,\n  IntLit, BigIntLit, FloatLit, TupleExpr, StrLit, BoolLit, UnitExpr, Var,\n  ListExpr, CtorExpr, Call, MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr,\n  IfExpr, MatchExpr, MutExpr, Block, Return, Try, Except, Interp, Range, Index,\n  Comp, DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn, Await, NoArgs,\n  PositionalArgs, RecordArgs, UpdateArgs, ListComp, TextPart, ValuePart, Add,\n  Sub, Mul, Div, Mod, Equal, NotEqual, Less, LessEq, Greater, GreaterEq, And,\n  Or, Implies, Neg, Not, TryResult, TryOption, Let, VarDecl, Assign, While, For,\n  Loop, ExprStmt, Assert, ComptimeFor, Invariant, Decreases, Bind, CtorPattern,\n  ListPat, TuplePat, OrPat, ForPat, NoPats, PositionalPats, RecordPats,\n  TypePats, UseDef, Break, Continue, ImplDecl, TraitMethod, C, AssertBy, Calc","old_text":"// declarations: the checker's errors about names, type arguments, `Self`,\n// `break` and `continue`, impls against their traits, and constructor patterns.\n\nfrom ast use Decl, TypeDecl, Field, FnDecl, Param, Bound, TypeExpr, Expr,\n  CtorArgs, LamParam, Arm, BinOp, Stmt, Pattern, TypeDef, FnDef, TraitDef,\n  ImplDef, ExternDef, CapabilityDef, Alias, RecordBody, SumBody, NoPayload,\n  Positional, RecordPayload, MemberType, ExternFn, ExternType, ExternStatic,\n  ExternThreadStatic, Named, FnType, UnitType, Refined, UnionType, IntLit,\n  BigIntLit, FloatLit, TupleExpr, StrLit, BoolLit, UnitExpr, Var, ListExpr,\n  CtorExpr, Call, MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr,\n  MatchExpr, MutExpr, Block, Return, Try, Except, Interp, Range, Index, Comp,\n  DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn, Await, NoArgs,\n  PositionalArgs, RecordArgs, UpdateArgs, ListComp, TextPart, ValuePart, Add,\n  Sub, Mul, Div, Mod, Equal, NotEqual, Less, LessEq, Greater, GreaterEq, And,\n  Or, Implies, Neg, Not, TryResult, TryOption, Let, VarDecl, Assign, While, For,\n  Loop, ExprStmt, Assert, ComptimeFor, Invariant, Decreases, Bind, CtorPattern,\n  ListPat, TuplePat, OrPat, ForPat, NoPats, PositionalPats, RecordPats,\n  TypePats, UseDef, Break, Continue, ImplDecl, TraitMethod, C, AssertBy, Calc"},{"name":"declarations.type_names","kind":"fn","old":"c4a7d5090ada6e76","new":"7e0721445306b451","interface_changed":false,"affected":[],"module":"declarations","text":"/// Adds the names a type mentions to `out` (to collect the built-ins'\n/// types).\nfn type_names(t: ast.TypeExpr, out: Set[String]) -> Set[String] {\n  match t {\n    ast.Named { name, args } => {\n      mut acc := {\n        mut copy := out\n        mut copy.insert(name)\n        copy\n      }\n      for a in args {\n        acc = declarations.type_names(a, acc)\n      }\n      acc\n    },\n    ast.FnType { params, ret } => {\n      mut acc := out\n      for a in params {\n        acc = declarations.type_names(a, acc)\n      }\n      declarations.type_names(ret, acc)\n    },\n    ast.Refined { base, .. } => declarations.type_names(base, out),\n    ast.RowType(fs) => {\n      mut acc := out\n      for f in fs {\n        acc = declarations.type_names(f.1, acc)\n      }\n      acc\n    },\n    ast.UnionType(ms) => {\n      mut acc := out\n      for a in ms {\n        acc = declarations.type_names(a, acc)\n      }\n      acc\n    },\n    ast.UnitType => out,\n  }\n}","old_text":"/// Adds the names a type mentions to `out` (to collect the built-ins'\n/// types).\nfn type_names(t: ast.TypeExpr, out: Set[String]) -> Set[String] {\n  match t {\n    ast.Named { name, args } => {\n      mut acc := {\n        mut copy := out\n        mut copy.insert(name)\n        copy\n      }\n      for a in args {\n        acc = declarations.type_names(a, acc)\n      }\n      acc\n    },\n    ast.FnType { params, ret } => {\n      mut acc := out\n      for a in params {\n        acc = declarations.type_names(a, acc)\n      }\n      declarations.type_names(ret, acc)\n    },\n    ast.Refined { base, .. } => declarations.type_names(base, out),\n    ast.UnionType(ms) => {\n      mut acc := out\n      for a in ms {\n        acc = declarations.type_names(a, acc)\n      }\n      acc\n    },\n    ast.UnitType => out,\n  }\n}"},{"name":"declarations.type_errors_in","kind":"fn","old":"138f1f7ddbbfd68a","new":"28653bdd05ac5527","interface_changed":false,"affected":[],"module":"declarations","text":"/// The errors of a written type. `tps` are the type parameters in scope,\n/// and `self_ok` is true inside a trait or an impl.\nfn type_errors_in(\n  sc: declarations.Names,\n  t: ast.TypeExpr,\n  tps: Set[String],\n  self_ok: Bool,\n  out: List[String],\n) -> List[String] {\n  match t {\n    ast.Named { name, args } => {\n      mut acc := out\n      if name == \"Self\" && len(args) == 0 {\n        if !self_ok {\n          mut acc.push(\n            \"`Self` only means something inside a trait or an impl\",\n          )\n        }\n      } else if contains(tps, name) || contains(name, \".\") {\n        ()\n      } else {\n        match get(sc.types, name) {\n          Some(k) => if k >= 0 && k != len(args) {\n            mut acc.push(\n              \"type `\"\n                + name\n                + \"` expects \"\n                + to_string(k)\n                + \" type arguments, got \"\n                + to_string(len(args)),\n            )\n          },\n          None => if !sc.open {\n            mut acc.push(\"unknown type `\" + name + \"`\")\n          },\n        }\n      }\n      for a in args {\n        acc = declarations.type_errors_in(sc, a, tps, self_ok, acc)\n      }\n      acc\n    },\n    ast.FnType { params, ret } => {\n      mut acc := out\n      for a in params {\n        acc = declarations.type_errors_in(sc, a, tps, self_ok, acc)\n      }\n      declarations.type_errors_in(sc, ret, tps, self_ok, acc)\n    },\n    ast.Refined { base, .. } => declarations.type_errors_in(sc, base, tps, self_ok, out),\n    ast.RowType(fs) => {\n      mut acc := out\n      for f in fs {\n        acc = declarations.type_errors_in(sc, f.1, tps, self_ok, acc)\n      }\n      acc\n    },\n    ast.UnionType(ms) => {\n      mut acc := out\n      for a in ms {\n        acc = declarations.type_errors_in(sc, a, tps, self_ok, acc)\n      }\n      acc\n    },\n    ast.UnitType => out,\n  }\n}","old_text":"/// The errors of a written type. `tps` are the type parameters in scope,\n/// and `self_ok` is true inside a trait or an impl.\nfn type_errors_in(\n  sc: declarations.Names,\n  t: ast.TypeExpr,\n  tps: Set[String],\n  self_ok: Bool,\n  out: List[String],\n) -> List[String] {\n  match t {\n    ast.Named { name, args } => {\n      mut acc := out\n      if name == \"Self\" && len(args) == 0 {\n        if !self_ok {\n          mut acc.push(\n            \"`Self` only means something inside a trait or an impl\",\n          )\n        }\n      } else if contains(tps, name) || contains(name, \".\") {\n        ()\n      } else {\n        match get(sc.types, name) {\n          Some(k) => if k >= 0 && k != len(args) {\n            mut acc.push(\n              \"type `\"\n                + name\n                + \"` expects \"\n                + to_string(k)\n                + \" type arguments, got \"\n                + to_string(len(args)),\n            )\n          },\n          None => if !sc.open {\n            mut acc.push(\"unknown type `\" + name + \"`\")\n          },\n        }\n      }\n      for a in args {\n        acc = declarations.type_errors_in(sc, a, tps, self_ok, acc)\n      }\n      acc\n    },\n    ast.FnType { params, ret } => {\n      mut acc := out\n      for a in params {\n        acc = declarations.type_errors_in(sc, a, tps, self_ok, acc)\n      }\n      declarations.type_errors_in(sc, ret, tps, self_ok, acc)\n    },\n    ast.Refined { base, .. } => declarations.type_errors_in(sc, base, tps, self_ok, out),\n    ast.UnionType(ms) => {\n      mut acc := out\n      for a in ms {\n        acc = declarations.type_errors_in(sc, a, tps, self_ok, acc)\n      }\n      acc\n    },\n    ast.UnitType => out,\n  }\n}"},{"name":"derive.use ast","kind":"use","old":"9c0bc5db4ec2b4fc","new":"91f891e354643890","interface_changed":true,"affected":[],"module":"derive","text":"// derive: expands each `derive Trait for Type` into an ordinary `impl`\n// and each `comptime e` into its value, so later passes never see them.\n//\n// For `derive Json for P`:\n// 1. `P` is described as a `std.typing.Type` value and checked against the\n//    trait's kind (`derivable(Record | Union)`, possibly a refinement such\n//    as `Choice`) and its requirements, by running them.\n// 2. Each `derived fn` of the trait is specialized with `Self` bound to\n//    that description:\n//    - `comptime e` is evaluated and its value written in;\n//    - `comptime for` writes its body once per element, a match\n//      comprehension one arm per element;\n//    - `match comptime` keeps the arm whose type pattern fits;\n//    - `Self.make(f -> e)` and `try_make` build a `P` field by field;\n//    - a call of a function with `comptime` parameters calls a copy made\n//      for those values (`f.type` is a real type there).\n// 3. The result is `impl Json for P { ... }` with those methods and the\n//    hand-written ones. The copies are added to the program.\n//\n// Compile-time code that is data (a description, a known name, a field of\n// one) is read directly. The rest is run, its value written as a literal.\n\nfrom ast use DeriveFnDecl, DeriveFnDef, Decl, DeclKind, TypeDecl, Field,\n  Variant, FnDecl, Param, Bound, TraitDecl, ImplDecl, TypeExpr, Expr, LamParam,\n  Arm, Stmt, Pattern, CtorArgs, StrPart, TypeDef, FnDef, TestDef, TraitDef,\n  ImplDef, Alias, RecordBody, SumBody, NoPayload, Positional, RecordPayload,\n  MemberType, Named, FnType, UnitType, Refined, UnionType, RowType, IntLit,\n  BigIntLit, FloatLit, TupleExpr, StrLit, BoolLit, UnitExpr, Var, Hole,\n  ListExpr, CtorExpr, Call, MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr,\n  IfExpr, MatchExpr, Block, Interp, Fallback, Comptime, NoArgs, PositionalArgs,\n  RecordArgs, UpdateArgs, TextPart, ValuePart, Equal, NotEqual, Less, LessEq,\n  Greater, GreaterEq, And, Or, Not, Let, ExprStmt, ComptimeFor, Wild, Bind,\n  IntPat, StrPat, BoolPat, CtorPattern, OrPat, ForPat, NoPats, PositionalPats,\n  RecordPats, TypePats, DeriveClause","old_text":"// derive: expands each `derive Trait for Type` into an ordinary `impl`\n// and each `comptime e` into its value, so later passes never see them.\n//\n// For `derive Json for P`:\n// 1. `P` is described as a `std.typing.Type` value and checked against the\n//    trait's kind (`derivable(Record | Union)`, possibly a refinement such\n//    as `Choice`) and its requirements, by running them.\n// 2. Each `derived fn` of the trait is specialized with `Self` bound to\n//    that description:\n//    - `comptime e` is evaluated and its value written in;\n//    - `comptime for` writes its body once per element, a match\n//      comprehension one arm per element;\n//    - `match comptime` keeps the arm whose type pattern fits;\n//    - `Self.make(f -> e)` and `try_make` build a `P` field by field;\n//    - a call of a function with `comptime` parameters calls a copy made\n//      for those values (`f.type` is a real type there).\n// 3. The result is `impl Json for P { ... }` with those methods and the\n//    hand-written ones. The copies are added to the program.\n//\n// Compile-time code that is data (a description, a known name, a field of\n// one) is read directly. The rest is run, its value written as a literal.\n\nfrom ast use DeriveFnDecl, DeriveFnDef, Decl, DeclKind, TypeDecl, Field,\n  Variant, FnDecl, Param, Bound, TraitDecl, ImplDecl, TypeExpr, Expr, LamParam,\n  Arm, Stmt, Pattern, CtorArgs, StrPart, TypeDef, FnDef, TestDef, TraitDef,\n  ImplDef, Alias, RecordBody, SumBody, NoPayload, Positional, RecordPayload,\n  MemberType, Named, FnType, UnitType, Refined, UnionType, IntLit, BigIntLit,\n  FloatLit, TupleExpr, StrLit, BoolLit, UnitExpr, Var, Hole, ListExpr, CtorExpr,\n  Call, MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr,\n  Block, Interp, Fallback, Comptime, NoArgs, PositionalArgs, RecordArgs,\n  UpdateArgs, TextPart, ValuePart, Equal, NotEqual, Less, LessEq, Greater,\n  GreaterEq, And, Or, Not, Let, ExprStmt, ComptimeFor, Wild, Bind, IntPat,\n  StrPat, BoolPat, CtorPattern, OrPat, ForPat, NoPats, PositionalPats,\n  RecordPats, TypePats, DeriveClause"},{"name":"derive.subst","kind":"fn","old":"65ccdb459d79c283","new":"4539f81baeebeb20","interface_changed":false,"affected":[],"module":"derive","text":"fn subst(t: ast.TypeExpr, sub: Dict[String, ast.TypeExpr]) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => if len(args) == 0 && contains(sub, name) {\n      get(sub, name) ?? t\n    } else {\n      ast.Named { name, args: args.map(a -> derive.subst(a, sub)) }\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> derive.subst(a, sub)),\n      ret: derive.subst(ret, sub),\n    },\n    ast.Refined { base, pred } => ast.Refined { base: derive.subst(base, sub), pred },\n    ast.RowType(fs) => ast.RowType(fs.map(f -> (f.0, derive.subst(f.1, sub)))),\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> derive.subst(a, sub))),\n    ast.UnitType => ast.UnitType,\n  }\n}","old_text":"fn subst(t: ast.TypeExpr, sub: Dict[String, ast.TypeExpr]) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => if len(args) == 0 && contains(sub, name) {\n      get(sub, name) ?? t\n    } else {\n      ast.Named { name, args: args.map(a -> derive.subst(a, sub)) }\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> derive.subst(a, sub)),\n      ret: derive.subst(ret, sub),\n    },\n    ast.Refined { base, pred } => ast.Refined { base: derive.subst(base, sub), pred },\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> derive.subst(a, sub))),\n    ast.UnitType => ast.UnitType,\n  }\n}"},{"name":"derive.pairs","kind":"fn","old":"30243ecc5afffad2","new":"7dfef7c8bd105e9a","interface_changed":false,"affected":[],"module":"derive","text":"fn pairs(\n  names: List[String],\n  ts: List[ast.TypeExpr],\n) -> Dict[String, ast.TypeExpr] {\n  mut out := Dict[String, ast.TypeExpr] {}\n  for (n, t) in zip(names, ts) {\n    mut out.insert(n, t)\n  }\n  out\n}","old_text":"fn pairs(\n  names: List[String],\n  ts: List[ast.TypeExpr],\n) -> Dict[String, ast.TypeExpr] {\n  mut out := Dict[String, ast.TypeExpr] {}\n  for (n, t) in zip(names, ts) {\n    mut out.insert(n, t)\n  }\n  out\n}"},{"name":"derive.mentions_name","kind":"fn","old":"775815bb13731a12","new":"a4086d516b67009c","interface_changed":false,"affected":[],"module":"derive","text":"/// Whether a type mentions the name `p` (a type parameter).\nfn mentions_name(t: ast.TypeExpr, p: String) -> Bool {\n  match t {\n    ast.Named { name, args } => name == p || args.any(a -> derive.mentions_name(a, p)),\n    ast.Refined { base, .. } => derive.mentions_name(base, p),\n    ast.FnType { params, ret } => params.any(a -> derive.mentions_name(a, p))\n      || derive.mentions_name(ret, p),\n    ast.RowType(fs) => fs.any(f -> derive.mentions_name(f.1, p)),\n    ast.UnionType(ms) => ms.any(a -> derive.mentions_name(a, p)),\n    ast.UnitType => false,\n  }\n}","old_text":"/// Whether a type mentions the name `p` (a type parameter).\nfn mentions_name(t: ast.TypeExpr, p: String) -> Bool {\n  match t {\n    ast.Named { name, args } => name == p || args.any(a -> derive.mentions_name(a, p)),\n    ast.Refined { base, .. } => derive.mentions_name(base, p),\n    ast.FnType { params, ret } => params.any(a -> derive.mentions_name(a, p))\n      || derive.mentions_name(ret, p),\n    ast.UnionType(ms) => ms.any(a -> derive.mentions_name(a, p)),\n    ast.UnitType => false,\n  }\n}"},{"name":"derive.remember","kind":"fn","old":"3c2e79a9ff48828b","new":"788a1133376e0fd3","interface_changed":false,"affected":[],"module":"derive","text":"fn remember(mut x: derive.Expander, v: ast.Expr, t: ast.TypeExpr) {\n  mut x.written.insert(derive.key(v), t)\n}","old_text":"fn remember(mut x: derive.Expander, v: ast.Expr, t: ast.TypeExpr) {\n  mut x.written.insert(derive.key(v), t)\n}"},{"name":"derive.type_value_in","kind":"fn","old":"9906bfb86a45e6d7","new":"11d024d5b9fee389","interface_changed":false,"affected":[],"module":"derive","text":"fn type_value_in(\n  mut x: derive.Expander,\n  t: ast.TypeExpr,\n  mut stack: List[ast.TypeExpr],\n) -> ast.Expr {\n  mut name := derive.none()\n  mut doc := []\n  mut args := []\n  mut fields := []\n  mut elements := []\n  mut members := []\n  mut params := []\n  mut result := derive.none()\n  // a record's or sum's own refinement (an alias has its base's)\n  mut condition := derive.none()\n  kind := match t {\n    // a refinement: its base, with the condition\n    ast.Refined { base, pred } => {\n      mut v := derive.type_value_in(mut x, base, mut stack)\n      cond := text.expr_text(pred, 0)\n      both := match derive.str_of(v, \"condition\") {\n        Some(c) => c + \" && \" + cond,\n        None => cond,\n      }\n      v = derive.set_field(\n        v,\n        \"condition\",\n        derive.some(ast.StrLit(both)),\n      )\n      v = derive.set_field(v, \"written\", ast.StrLit(text.type_text(t)))\n      derive.remember(mut x, v, t)\n      return v\n    },\n    ast.UnitType => \"Unit\",\n    ast.FnType { params: ps, ret } => {\n      for a in ps {\n        mut params.push(derive.type_value_in(mut x, a, mut stack))\n      }\n      result = derive.some(derive.type_value_in(mut x, ret, mut stack))\n      \"Function\"\n    },\n    // a union's members as written, and each member a union declares\n    // itself (its `$own` sum)\n    ast.RowType(_) => \"Param\",\n    ast.UnionType(ms) => {\n      for a in ms {\n        m := derive.type_value_in(mut x, a, mut stack)\n        own := match a {\n          ast.Named { name: n, .. } => contains(n, desugar.own_suffix()),\n          _ => false,\n        }\n        if own && derive.kind_name(m) == Some(\"Union\") {\n          match derive.full(mut x, m, \"members\") {\n            Some(ast.ListExpr(xs)) => {\n              members += xs\n            },\n            _ => mut members.push(m),\n          }\n        } else {\n          mut members.push(m)\n        }\n      }\n      \"Union\"\n    },\n    ast.Named { name: n, args: targs } => {\n      name = derive.some(ast.StrLit(derive.short(n)))\n      for a in targs {\n        mut args.push(derive.type_value_in(mut x, a, mut stack))\n      }\n      // written out once on the way down, at most 4 levels deep\n      shallow := derive.in_stack(stack, t) || len(stack) >= 4\n      mut stack.push(t)\n      k := if n == \"Tuple\" {\n        elements = args\n        \"Tuple\"\n      } else {\n        match get(x.ix.types, n) {\n          Some(td) => {\n            doc = get(x.ix.docs, n) ?? []\n            match td.refinement {\n              Some(r) => {\n                condition = derive.some(ast.StrLit(text.expr_text(r, 0)))\n              },\n              None => (),\n            }\n            sub := derive.pairs(td.params, targs)\n            match td.body {\n              ast.RecordBody(fs) => {\n                if !shallow {\n                  for f in fs {\n                    mut fields.push(\n                      derive.field(\n                        mut x,\n                        f.name,\n                        f.doc,\n                        derive.subst(f.ty, sub),\n                        f.default,\n                        mut stack,\n                      ),\n                    )\n                  }\n                }\n                \"Record\"\n              },\n              // a sum: a union of the members it declares\n              ast.SumBody(vs) => {\n                if !shallow {\n                  for v in vs {\n                    mut members.push(\n                      derive.variant_value(\n                        mut x,\n                        n,\n                        v,\n                        targs,\n                        sub,\n                        mut stack,\n                      ),\n                    )\n                  }\n                }\n                \"Union\"\n              },\n              // an alias or a `distinct` type: what it stands for, under\n              // its own name\n              ast.Alias(a) => {\n                whole := match td.refinement {\n                  Some(r) => ast.Refined {\n                    base: derive.subst(a, sub),\n                    pred: r,\n                  },\n                  None => derive.subst(a, sub),\n                }\n                mut v := derive.type_value_in(mut x, whole, mut stack)\n                stack = take(stack, len(stack) - 1)\n                // `base`: what it stands for, under that type's name (`Int`)\n                v = derive.set_field(v, \"base\", derive.some(v))\n                v = derive.set_field(\n                  v,\n                  \"name\",\n                  derive.some(ast.StrLit(derive.short(n))),\n                )\n                v = derive.set_field(v, \"doc\", derive.strs(doc))\n                v = derive.set_field(v, \"args\", ast.ListExpr(args))\n                v = derive.set_field(\n                  v,\n                  \"written\",\n                  ast.StrLit(text.type_text(t)),\n                )\n                derive.remember(mut x, v, t)\n                return v\n              },\n            }\n          },\n          None => match get(x.ix.ctors, n) {\n            // a variant used as a type (`TooBig`)\n            Some(sum) => {\n              stack = take(stack, len(stack) - 1)\n              match derive.variant_decl(x, n) {\n                Some(v) => {\n                  sub := derive.pairs(\n                    (get(x.ix.types, sum) ?? derive.unknown_decl()).params,\n                    targs,\n                  )\n                  return derive.variant_value(\n                    mut x,\n                    sum,\n                    v,\n                    targs,\n                    sub,\n                    mut stack,\n                  )\n                },\n                None => \"Param\",\n              }\n            },\n            None => if contains(derive.builtin_types(), n) {\n              \"Builtin\"\n            } else {\n              \"Param\"\n            },\n          },\n        }\n      }\n      stack = take(stack, len(stack) - 1)\n      k\n    },\n  }\n  v := derive.record(\"Type\", [\n    (\"name\", name),\n    (\"doc\", derive.strs(doc)),\n    (\"kind\", derive.atom(derive.q(kind))),\n    (\"args\", ast.ListExpr(args)),\n    (\"written\", ast.StrLit(text.type_text(t))),\n    (\"condition\", condition),\n    (\"fields\", ast.ListExpr(fields)),\n    (\"elements\", ast.ListExpr(elements)),\n    (\"members\", ast.ListExpr(members)),\n    (\"params\", ast.ListExpr(params)),\n    (\"result\", result),\n    (\"parameters\", ast.ListExpr([])),\n    (\"base\", derive.none()),\n    (\"clauses\", derive.clauses_of(x, t)),\n  ])\n  derive.remember(mut x, v, t)\n  v\n}","old_text":"fn type_value_in(\n  mut x: derive.Expander,\n  t: ast.TypeExpr,\n  mut stack: List[ast.TypeExpr],\n) -> ast.Expr {\n  mut name := derive.none()\n  mut doc := []\n  mut args := []\n  mut fields := []\n  mut elements := []\n  mut members := []\n  mut params := []\n  mut result := derive.none()\n  // a record's or sum's own refinement (an alias has its base's)\n  mut condition := derive.none()\n  kind := match t {\n    // a refinement: its base, with the condition\n    ast.Refined { base, pred } => {\n      mut v := derive.type_value_in(mut x, base, mut stack)\n      cond := text.expr_text(pred, 0)\n      both := match derive.str_of(v, \"condition\") {\n        Some(c) => c + \" && \" + cond,\n        None => cond,\n      }\n      v = derive.set_field(\n        v,\n        \"condition\",\n        derive.some(ast.StrLit(both)),\n      )\n      v = derive.set_field(v, \"written\", ast.StrLit(text.type_text(t)))\n      derive.remember(mut x, v, t)\n      return v\n    },\n    ast.UnitType => \"Unit\",\n    ast.FnType { params: ps, ret } => {\n      for a in ps {\n        mut params.push(derive.type_value_in(mut x, a, mut stack))\n      }\n      result = derive.some(derive.type_value_in(mut x, ret, mut stack))\n      \"Function\"\n    },\n    // a union's members as written, and each member a union declares\n    // itself (its `$own` sum)\n    ast.UnionType(ms) => {\n      for a in ms {\n        m := derive.type_value_in(mut x, a, mut stack)\n        own := match a {\n          ast.Named { name: n, .. } => contains(n, desugar.own_suffix()),\n          _ => false,\n        }\n        if own && derive.kind_name(m) == Some(\"Union\") {\n          match derive.full(mut x, m, \"members\") {\n            Some(ast.ListExpr(xs)) => {\n              members += xs\n            },\n            _ => mut members.push(m),\n          }\n        } else {\n          mut members.push(m)\n        }\n      }\n      \"Union\"\n    },\n    ast.Named { name: n, args: targs } => {\n      name = derive.some(ast.StrLit(derive.short(n)))\n      for a in targs {\n        mut args.push(derive.type_value_in(mut x, a, mut stack))\n      }\n      // written out once on the way down, at most 4 levels deep\n      shallow := derive.in_stack(stack, t) || len(stack) >= 4\n      mut stack.push(t)\n      k := if n == \"Tuple\" {\n        elements = args\n        \"Tuple\"\n      } else {\n        match get(x.ix.types, n) {\n          Some(td) => {\n            doc = get(x.ix.docs, n) ?? []\n            match td.refinement {\n              Some(r) => {\n                condition = derive.some(ast.StrLit(text.expr_text(r, 0)))\n              },\n              None => (),\n            }\n            sub := derive.pairs(td.params, targs)\n            match td.body {\n              ast.RecordBody(fs) => {\n                if !shallow {\n                  for f in fs {\n                    mut fields.push(\n                      derive.field(\n                        mut x,\n                        f.name,\n                        f.doc,\n                        derive.subst(f.ty, sub),\n                        f.default,\n                        mut stack,\n                      ),\n                    )\n                  }\n                }\n                \"Record\"\n              },\n              // a sum: a union of the members it declares\n              ast.SumBody(vs) => {\n                if !shallow {\n                  for v in vs {\n                    mut members.push(\n                      derive.variant_value(\n                        mut x,\n                        n,\n                        v,\n                        targs,\n                        sub,\n                        mut stack,\n                      ),\n                    )\n                  }\n                }\n                \"Union\"\n              },\n              // an alias or a `distinct` type: what it stands for, under\n              // its own name\n              ast.Alias(a) => {\n                whole := match td.refinement {\n                  Some(r) => ast.Refined {\n                    base: derive.subst(a, sub),\n                    pred: r,\n                  },\n                  None => derive.subst(a, sub),\n                }\n                mut v := derive.type_value_in(mut x, whole, mut stack)\n                stack = take(stack, len(stack) - 1)\n                // `base`: what it stands for, under that type's name (`Int`)\n                v = derive.set_field(v, \"base\", derive.some(v))\n                v = derive.set_field(\n                  v,\n                  \"name\",\n                  derive.some(ast.StrLit(derive.short(n))),\n                )\n                v = derive.set_field(v, \"doc\", derive.strs(doc))\n                v = derive.set_field(v, \"args\", ast.ListExpr(args))\n                v = derive.set_field(\n                  v,\n                  \"written\",\n                  ast.StrLit(text.type_text(t)),\n                )\n                derive.remember(mut x, v, t)\n                return v\n              },\n            }\n          },\n          None => match get(x.ix.ctors, n) {\n            // a variant used as a type (`TooBig`)\n            Some(sum) => {\n              stack = take(stack, len(stack) - 1)\n              match derive.variant_decl(x, n) {\n                Some(v) => {\n                  sub := derive.pairs(\n                    (get(x.ix.types, sum) ?? derive.unknown_decl()).params,\n                    targs,\n                  )\n                  return derive.variant_value(\n                    mut x,\n                    sum,\n                    v,\n                    targs,\n                    sub,\n                    mut stack,\n                  )\n                },\n                None => \"Param\",\n              }\n            },\n            None => if contains(derive.builtin_types(), n) {\n              \"Builtin\"\n            } else {\n              \"Param\"\n            },\n          },\n        }\n      }\n      stack = take(stack, len(stack) - 1)\n      k\n    },\n  }\n  v := derive.record(\"Type\", [\n    (\"name\", name),\n    (\"doc\", derive.strs(doc)),\n    (\"kind\", derive.atom(derive.q(kind))),\n    (\"args\", ast.ListExpr(args)),\n    (\"written\", ast.StrLit(text.type_text(t))),\n    (\"condition\", condition),\n    (\"fields\", ast.ListExpr(fields)),\n    (\"elements\", ast.ListExpr(elements)),\n    (\"members\", ast.ListExpr(members)),\n    (\"params\", ast.ListExpr(params)),\n    (\"result\", result),\n    (\"parameters\", ast.ListExpr([])),\n    (\"base\", derive.none()),\n    (\"clauses\", derive.clauses_of(x, t)),\n  ])\n  derive.remember(mut x, v, t)\n  v\n}"},{"name":"derive.unwhere","kind":"fn","old":"3af280e63052740d","new":"e7e430cd0d3cd08e","interface_changed":false,"affected":[],"module":"derive","text":"/// `t` with each alias made for a refinement type argument (`$where_0`)\n/// turned back into that refinement.\nfn unwhere(x: derive.Expander, t: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => if len(args) == 0 && starts_with(name, desugar.where_prefix()) {\n      match get(x.ix.types, name) {\n        Some(td) => match (td.body, td.refinement) {\n          (ast.Alias(b), Some(r)) => ast.Refined { base: b, pred: r },\n          _ => t,\n        },\n        None => t,\n      }\n    } else {\n      ast.Named { name, args: args.map(a -> derive.unwhere(x, a)) }\n    },\n    ast.Refined { base, pred } => ast.Refined { base: derive.unwhere(x, base), pred },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> derive.unwhere(x, a)),\n      ret: derive.unwhere(x, ret),\n    },\n    ast.RowType(fs) => ast.RowType(fs.map(f -> (f.0, derive.unwhere(x, f.1)))),\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> derive.unwhere(x, a))),\n    ast.UnitType => ast.UnitType,\n  }\n}","old_text":"/// `t` with each alias made for a refinement type argument (`$where_0`)\n/// turned back into that refinement.\nfn unwhere(x: derive.Expander, t: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => if len(args) == 0 && starts_with(name, desugar.where_prefix()) {\n      match get(x.ix.types, name) {\n        Some(td) => match (td.body, td.refinement) {\n          (ast.Alias(b), Some(r)) => ast.Refined { base: b, pred: r },\n          _ => t,\n        },\n        None => t,\n      }\n    } else {\n      ast.Named { name, args: args.map(a -> derive.unwhere(x, a)) }\n    },\n    ast.Refined { base, pred } => ast.Refined { base: derive.unwhere(x, base), pred },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> derive.unwhere(x, a)),\n      ret: derive.unwhere(x, ret),\n    },\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> derive.unwhere(x, a))),\n    ast.UnitType => ast.UnitType,\n  }\n}"},{"name":"derive.kind_of","kind":"fn","old":"fe5964ec0f9462ac","new":"50ee660f007e3da9","interface_changed":false,"affected":[],"module":"derive","text":"/// A type's kind (`\"Record\"`, `\"Union\"`, ..), seeing through aliases and\n/// ignoring refinements, and whether it is a sum of atoms (a `Choice`).\nfn kind_of(x: derive.Expander, t: ast.TypeExpr) -> (String, Bool) {\n  match t {\n    ast.Refined { base, .. } => derive.kind_of(x, base),\n    ast.UnitType => (\"Unit\", false),\n    ast.FnType { .. } => (\"Function\", false),\n    ast.RowType(_) => (\"Record\", false),\n    ast.UnionType(ms) => (\"Union\", ms.all(\n      m -> match m {\n        ast.Named { name, .. } => if contains(name, desugar.own_suffix()) {\n          derive.kind_of(x, m).1\n        } else {\n          derive.kind_of(x, m).0 == \"Atom\"\n        },\n        _ => derive.kind_of(x, m).0 == \"Atom\",\n      },\n    )),\n    ast.Named { name: \"Tuple\", .. } => (\"Tuple\", false),\n    ast.Named { name, .. } => match get(x.ix.types, name) {\n      Some(td) => match td.body {\n        ast.RecordBody(_) => (\"Record\", false),\n        ast.SumBody(vs) => (\"Union\", vs.all(\n          v -> match v.payload {\n            ast.NoPayload => true,\n            ast.MemberType(m) => derive.kind_of(x, m).0 == \"Atom\",\n            _ => false,\n          },\n        )),\n        ast.Alias(a) => derive.kind_of(x, a),\n      },\n      None => match derive.variant_decl(x, name) {\n        Some(v) => match v.payload {\n          ast.Positional(_) => (\"Tuple\", false),\n          ast.RecordPayload(_) => (\"Record\", false),\n          _ => (\"Atom\", false),\n        },\n        None => if contains(derive.builtin_types(), name) {\n          (\"Builtin\", false)\n        } else {\n          (\"Param\", false)\n        },\n      },\n    },\n  }\n}","old_text":"/// A type's kind (`\"Record\"`, `\"Union\"`, ..), seeing through aliases and\n/// ignoring refinements, and whether it is a sum of atoms (a `Choice`).\nfn kind_of(x: derive.Expander, t: ast.TypeExpr) -> (String, Bool) {\n  match t {\n    ast.Refined { base, .. } => derive.kind_of(x, base),\n    ast.UnitType => (\"Unit\", false),\n    ast.FnType { .. } => (\"Function\", false),\n    ast.UnionType(ms) => (\"Union\", ms.all(\n      m -> match m {\n        ast.Named { name, .. } => if contains(name, desugar.own_suffix()) {\n          derive.kind_of(x, m).1\n        } else {\n          derive.kind_of(x, m).0 == \"Atom\"\n        },\n        _ => derive.kind_of(x, m).0 == \"Atom\",\n      },\n    )),\n    ast.Named { name: \"Tuple\", .. } => (\"Tuple\", false),\n    ast.Named { name, .. } => match get(x.ix.types, name) {\n      Some(td) => match td.body {\n        ast.RecordBody(_) => (\"Record\", false),\n        ast.SumBody(vs) => (\"Union\", vs.all(\n          v -> match v.payload {\n            ast.NoPayload => true,\n            ast.MemberType(m) => derive.kind_of(x, m).0 == \"Atom\",\n            _ => false,\n          },\n        )),\n        ast.Alias(a) => derive.kind_of(x, a),\n      },\n      None => match derive.variant_decl(x, name) {\n        Some(v) => match v.payload {\n          ast.Positional(_) => (\"Tuple\", false),\n          ast.RecordPayload(_) => (\"Record\", false),\n          _ => (\"Atom\", false),\n        },\n        None => if contains(derive.builtin_types(), name) {\n          (\"Builtin\", false)\n        } else {\n          (\"Param\", false)\n        },\n      },\n    },\n  }\n}"},{"name":"derive.ty","kind":"fn","old":"6153793c68f96d0d","new":"59c627016362b1c3","interface_changed":false,"affected":[],"module":"derive","text":"/// A type with the known types written in (`f.type`, an arm's `x`, `Self`).\nfn ty(x: derive.Expander, t: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => if len(args) == 0 && contains(x.types, name) {\n      get(x.types, name) ?? t\n    } else if len(args) == 0 && name == \"Self\" && x.self_ty != ast.UnitType {\n      x.self_ty\n    } else {\n      ast.Named { name, args: args.map(a -> derive.ty(x, a)) }\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> derive.ty(x, a)),\n      ret: derive.ty(x, ret),\n    },\n    ast.Refined { base: b, pred } => ast.Refined { base: derive.ty(x, b), pred },\n    ast.RowType(fs) => ast.RowType(fs.map(f -> (f.0, derive.ty(x, f.1)))),\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> derive.ty(x, a))),\n    ast.UnitType => ast.UnitType,\n  }\n}","old_text":"/// A type with the known types written in (`f.type`, an arm's `x`, `Self`).\nfn ty(x: derive.Expander, t: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => if len(args) == 0 && contains(x.types, name) {\n      get(x.types, name) ?? t\n    } else if len(args) == 0 && name == \"Self\" && x.self_ty != ast.UnitType {\n      x.self_ty\n    } else {\n      ast.Named { name, args: args.map(a -> derive.ty(x, a)) }\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> derive.ty(x, a)),\n      ret: derive.ty(x, ret),\n    },\n    ast.Refined { base: b, pred } => ast.Refined { base: derive.ty(x, b), pred },\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> derive.ty(x, a))),\n    ast.UnitType => ast.UnitType,\n  }\n}"},{"name":"desugar.use ast","kind":"use","old":"10d689b5bb16a465","new":"f31ead21a8038cb4","interface_changed":true,"affected":[],"module":"desugar","text":"// desugar: rewrites ranges, indexing, slices, comprehensions, defaults and\n// mixed unions into plain calls and types after a program is read. The tree\n// keeps them as written, so they render back the same. Names it makes start\n// with `$`, which no program can write.\n\nfrom ast use DeriveFnDef, Decl, DeclKind, TypeDecl, Field, Variant, FnDecl,\n  TypeExpr, Expr, LamParam, CompFor, Stmt, Pattern, TypeDef, FnDef, TestDef,\n  TraitDef, ImplDef, RecordBody, SumBody, Alias, RecordPayload, MemberType,\n  Named, Refined, UnionType, RowType, IntLit, TupleExpr, Var, ListExpr,\n  CtorExpr, Call, FieldOf, Lambda, Binary, Block, Range, Index, Comp, DictExpr,\n  SetExpr, RecordArgs, ListComp, SetComp, DictComp, Add, Let, Bind, UnitExpr,\n  Assign, VarDecl, ExprStmt, ImplDecl, TraitDecl, TraitMethod, ModelDecl,\n  ModelDef, MethodCall, Old, Param, MockExpr, StrLit, BoolLit, NoArgs, Equal,\n  And, FnType, UnitType, Assumed, is_assumed, unassumed, ExternDef, ExternDecl,\n  ExternFn, Python","old_text":"// desugar: rewrites ranges, indexing, slices, comprehensions, defaults and\n// mixed unions into plain calls and types after a program is read. The tree\n// keeps them as written, so they render back the same. Names it makes start\n// with `$`, which no program can write.\n\nfrom ast use DeriveFnDef, Decl, DeclKind, TypeDecl, Field, Variant, FnDecl,\n  TypeExpr, Expr, LamParam, CompFor, Stmt, Pattern, TypeDef, FnDef, TestDef,\n  TraitDef, ImplDef, RecordBody, SumBody, Alias, RecordPayload, MemberType,\n  Named, Refined, UnionType, IntLit, TupleExpr, Var, ListExpr, CtorExpr, Call,\n  FieldOf, Lambda, Binary, Block, Range, Index, Comp, DictExpr, SetExpr,\n  RecordArgs, ListComp, SetComp, DictComp, Add, Let, Bind, UnitExpr, Assign,\n  VarDecl, ExprStmt, ImplDecl, TraitDecl, TraitMethod, ModelDecl, ModelDef,\n  MethodCall, Old, Param, MockExpr, StrLit, BoolLit, NoArgs, Equal, And, FnType,\n  UnitType, Assumed, is_assumed, unassumed, ExternDef, ExternDecl, ExternFn,\n  Python"},{"name":"desugar.inline_refinements","kind":"fn","old":"52e581f294b0d815","new":"2f016ea0f7d2086f","interface_changed":false,"affected":[],"module":"desugar","text":"/// Names each refinement written as a type argument (`List[Int where it >\n/// 0]`)\n/// by an alias of its own, `$where_k`. The same text gets the same alias.\n/// `texts` are the refinements already named, the `k`th as `$where_k`.\n/// Returns `decls` with the refinements named, the aliases of those not in\n/// `texts`, and all the texts.\nfn inline_refinements(\n  decls: List[ast.Decl],\n  texts: List[String],\n) -> (List[ast.Decl], List[String]) {\n  mut all := texts\n  mut made := []\n  mut any := false\n  for d in decls {\n    for t in walk.decl_types(d) {\n      match t {\n        ast.Named { args, .. } => {\n          for a in args {\n            match a {\n              ast.Refined { base, pred } => {\n                any = true\n                text := text.type_text(a)\n                if !contains(all, text) {\n                  mut all.push(text)\n                  mut made.push((base, pred))\n                }\n              },\n              _ => (),\n            }\n          }\n        },\n        _ => (),\n      }\n    }\n  }\n  if !any {\n    return (decls, texts)\n  }\n  named := decls.map(\n    d -> walk.decl_parts(\n      d,\n      x -> desugar.unrefined(all, x),\n      t -> desugar.unrefined_type(all, t),\n    ),\n  )\n  mut aliases := []\n  for (k, m) in enumerate(made) {\n    mut aliases.push(\n      ast.Decl {\n        comments: [],\n        doc: [],\n        module: \"\",\n        public: true,\n        kind: ast.TypeDef(ast.TypeDecl {\n          distinct: false,\n          name: desugar.where_prefix() + to_string(len(texts) + k),\n          params: [],\n          body: ast.Alias(m.0),\n          refinement: Some(m.1),\n          mocked: false,\n        }),\n      },\n    )\n  }\n  (named + aliases, all)\n}","old_text":"/// Names each refinement written as a type argument (`List[Int where it >\n/// 0]`)\n/// by an alias of its own, `$where_k`. The same text gets the same alias.\n/// `texts` are the refinements already named, the `k`th as `$where_k`.\n/// Returns `decls` with the refinements named, the aliases of those not in\n/// `texts`, and all the texts.\nfn inline_refinements(\n  decls: List[ast.Decl],\n  texts: List[String],\n) -> (List[ast.Decl], List[String]) {\n  mut all := texts\n  mut made := []\n  mut any := false\n  for d in decls {\n    for t in walk.decl_types(d) {\n      match t {\n        ast.Named { args, .. } => {\n          for a in args {\n            match a {\n              ast.Refined { base, pred } => {\n                any = true\n                text := text.type_text(a)\n                if !contains(all, text) {\n                  mut all.push(text)\n                  mut made.push((base, pred))\n                }\n              },\n              _ => (),\n            }\n          }\n        },\n        _ => (),\n      }\n    }\n  }\n  if !any {\n    return (decls, texts)\n  }\n  named := decls.map(\n    d -> walk.decl_parts(\n      d,\n      x -> desugar.unrefined(all, x),\n      t -> desugar.unrefined_type(all, t),\n    ),\n  )\n  mut aliases := []\n  for (k, m) in enumerate(made) {\n    mut aliases.push(\n      ast.Decl {\n        comments: [],\n        doc: [],\n        module: \"\",\n        public: true,\n        kind: ast.TypeDef(ast.TypeDecl {\n          distinct: false,\n          name: desugar.where_prefix() + to_string(len(texts) + k),\n          params: [],\n          body: ast.Alias(m.0),\n          refinement: Some(m.1),\n          mocked: false,\n        }),\n      },\n    )\n  }\n  (named + aliases, all)\n}"},{"name":"desugar.subst_type","kind":"fn","old":"ef9bfcb75117b2ed","new":"22ce038ca3b4550d","interface_changed":false,"affected":[],"module":"desugar","text":"fn subst_type(\n  t: ast.TypeExpr,\n  sub: Dict[String, ast.TypeExpr],\n) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => if args == [] && contains(sub, name) {\n      get(sub, name) ?? t\n    } else {\n      ast.Named {\n        name,\n        args: args.map(a -> desugar.subst_type(a, sub)),\n      }\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> desugar.subst_type(a, sub)),\n      ret: desugar.subst_type(ret, sub),\n    },\n    ast.Refined { base, pred } => ast.Refined { base: desugar.subst_type(base, sub), pred },\n    ast.RowType(fs) => ast.RowType(fs.map(f -> (f.0, desugar.subst_type(f.1, sub)))),\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> desugar.subst_type(a, sub))),\n    ast.UnitType => ast.UnitType,\n  }\n}","old_text":"fn subst_type(\n  t: ast.TypeExpr,\n  sub: Dict[String, ast.TypeExpr],\n) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => if args == [] && contains(sub, name) {\n      get(sub, name) ?? t\n    } else {\n      ast.Named {\n        name,\n        args: args.map(a -> desugar.subst_type(a, sub)),\n      }\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> desugar.subst_type(a, sub)),\n      ret: desugar.subst_type(ret, sub),\n    },\n    ast.Refined { base, pred } => ast.Refined { base: desugar.subst_type(base, sub), pred },\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> desugar.subst_type(a, sub))),\n    ast.UnitType => ast.UnitType,\n  }\n}"},{"name":"diff.use ast","kind":"use","old":"ce7d3a55ba478a9e","new":"0f8eaf70ab5516c6","interface_changed":true,"affected":[],"module":"diff","text":"// diff: structural diffs between two versions of a codebase, for\n// `strata diff`, over the patches of a package's log or the git commits of\n// a folder of sources.\n//\n// Definitions are paired by name and through recorded renames. Each pair\n// becomes one typed change: what happened in words, the code with changes\n// marked in place and unchanged parts folded, and a word diff of its doc. A\n// body that was mostly rewritten gets a plain line diff instead. A\n// definition whose only change follows a rename is folded into that rename.\n\nfrom ast use DeriveFnDef, Decl, Expr, FnDecl, TypeDecl, TraitDecl, TypeExpr,\n  Named, Refined, FnType, UnionType, RowType, UnitType, UnitExpr, TypeDef,\n  FnDef, TestDef, TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, ExternFn,\n  ExternType, Alias, RecordBody, SumBody, Stmt, Invariant, Decreases, AssertBy,\n  Calc, Block","old_text":"// diff: structural diffs between two versions of a codebase, for\n// `strata diff`, over the patches of a package's log or the git commits of\n// a folder of sources.\n//\n// Definitions are paired by name and through recorded renames. Each pair\n// becomes one typed change: what happened in words, the code with changes\n// marked in place and unchanged parts folded, and a word diff of its doc. A\n// body that was mostly rewritten gets a plain line diff instead. A\n// definition whose only change follows a rename is folded into that rename.\n\nfrom ast use DeriveFnDef, Decl, Expr, FnDecl, TypeDecl, TraitDecl, TypeExpr,\n  Named, Refined, FnType, UnionType, UnitType, UnitExpr, TypeDef, FnDef,\n  TestDef, TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, ExternFn,\n  ExternType, Alias, RecordBody, SumBody, Stmt, Invariant, Decreases, AssertBy,\n  Calc, Block"},{"name":"diff.members_words","kind":"fn","old":"fe2e1fed685ea8a1","new":"e90ae926d28d1c5c","interface_changed":false,"affected":[],"module":"diff","text":"/// Members added, removed and changed, in words: `what` (`field`,\n/// `variant`) by name, with what each is.\nfn members_words(\n  what: String,\n  a: List[(String, String)],\n  b: List[(String, String)],\n) -> List[String] {\n  added := b.filter(x -> !a.any(y -> y.0 == x.0)).map(x -> x.0)\n  removed := a.filter(x -> !b.any(y -> y.0 == x.0)).map(x -> x.0)\n  changed := b.filter(x -> a.any(y -> y.0 == x.0 && y.1 != x.1)).map(x -> x.0)\n  mut out := []\n  if len(added) > 0 {\n    mut out.push(diff.named_list(what, added) + \" added\")\n  }\n  if len(removed) > 0 {\n    mut out.push(diff.named_list(what, removed) + \" removed\")\n  }\n  if len(changed) > 0 {\n    mut out.push(diff.named_list(what, changed) + \" changed\")\n  }\n  out\n}","old_text":"/// Members added, removed and changed, in words: `what` (`field`,\n/// `variant`) by name, with what each is.\nfn members_words(\n  what: String,\n  a: List[(String, String)],\n  b: List[(String, String)],\n) -> List[String] {\n  added := b.filter(x -> !a.any(y -> y.0 == x.0)).map(x -> x.0)\n  removed := a.filter(x -> !b.any(y -> y.0 == x.0)).map(x -> x.0)\n  changed := b.filter(x -> a.any(y -> y.0 == x.0 && y.1 != x.1)).map(x -> x.0)\n  mut out := []\n  if len(added) > 0 {\n    mut out.push(diff.named_list(what, added) + \" added\")\n  }\n  if len(removed) > 0 {\n    mut out.push(diff.named_list(what, removed) + \" removed\")\n  }\n  if len(changed) > 0 {\n    mut out.push(diff.named_list(what, changed) + \" changed\")\n  }\n  out\n}"},{"name":"diff.type_head","kind":"fn","old":"881c2fec970f7def","new":"cae35146a90fb92f","interface_changed":false,"affected":[],"module":"diff","text":"fn type_head(t: ast.TypeExpr) -> String {\n  match t {\n    ast.Named { name, .. } => name,\n    ast.UnitType => \"Unit\",\n    ast.Refined { base, .. } => diff.type_head(base),\n    ast.FnType { .. } => \"Fn\",\n    ast.RowType(_) => \"Row\",\n    ast.UnionType(_) => \"Union\",\n  }\n}","old_text":"fn type_head(t: ast.TypeExpr) -> String {\n  match t {\n    ast.Named { name, .. } => name,\n    ast.UnitType => \"Unit\",\n    ast.Refined { base, .. } => diff.type_head(base),\n    ast.FnType { .. } => \"Fn\",\n    ast.UnionType(_) => \"Union\",\n  }\n}"},{"name":"docgen.titled","kind":"fn","old":"6e5f54adcde68d34","new":"581728066c6b8207","interface_changed":false,"affected":[],"module":"docgen","text":"/// A module doc's lines with its first line's `name: ` or `name — ` left out,\n/// the rest capitalized.\n/// None when it is a section's rule.\nfn titled(ls: List[String]) -> List[String] {\n  first := get(ls, 0) ?? \"\"\n  if starts_with(first, \"---\") || starts_with(first, \"──\") {\n    return []\n  }\n  sep := if index_of(first, \" — \") is None {\n    \": \"\n  } else {\n    \" — \"\n  }\n  match index_of(first, sep) {\n    Some(k) => if index_of(byte_slice(first, 0, k), \" \") is None {\n      [docgen.capitalized(\n          byte_slice(first, k + byte_len(sep), byte_len(first)),\n        )]\n        + drop(ls, 1)\n    } else {\n      ls\n    },\n    None => ls,\n  }\n}","old_text":"/// A module doc's lines with its first line's `name: ` or `name — ` left out,\n/// the rest capitalized.\n/// None when it is a section's rule.\nfn titled(ls: List[String]) -> List[String] {\n  first := get(ls, 0) ?? \"\"\n  if starts_with(first, \"---\") || starts_with(first, \"──\") {\n    return []\n  }\n  sep := if index_of(first, \" — \") is None {\n    \": \"\n  } else {\n    \" — \"\n  }\n  match index_of(first, sep) {\n    Some(k) => if index_of(byte_slice(first, 0, k), \" \") is None {\n      [docgen.capitalized(\n          byte_slice(first, k + byte_len(sep), byte_len(first)),\n        )]\n        + drop(ls, 1)\n    } else {\n      ls\n    },\n    None => ls,\n  }\n}"},{"name":"eval.use ast","kind":"use","old":"a63b95a4a8e7f07a","new":"89e635c6b78aaf75","interface_changed":true,"affected":[],"module":"eval","text":"// eval: a tree-walking evaluator for compile-time code (`comptime`,\n// `derive`) and the `strata eval` command, matching compiled code's output.\n//\n// It runs the stored trees, where references to definitions are qualified\n// (`shop.orders.ship`) and method calls and locals are as written. A method\n// call resolves at run time, in this order:\n// 1. the receiver type's own `impl`s, a variant's first;\n// 2. the traits it implements and their default methods;\n// 3. a function of that name visible in the caller's module (`x.twice()`\n//    is `twice(x)`);\n// 4. a built-in.\n// Values are `ast` literals (`IntLit(3)`, `CtorExpr`, `ListExpr`). A\n// closure is its lambda with the captured variables bound before it\n// (`{ n := 3; x -> x + n }`). Output, the fault or error that stopped the\n// run, and the exit code come back in `Run`, as a compiled program would\n// show them.\n//\n// Not supported: mocks, `comptime for`, calls of `extern` functions, and\n// writing files.\n\nfrom ast use Decl, TypeDecl, Variant, FnDecl, Param, TraitDecl, ImplDecl,\n  UseDecl, TypeExpr, Expr, CtorArgs, LamParam, CompFor, FmtSpec, BinOp, Stmt,\n  Pattern, TypeDef, FnDef, TraitDef, ImplDef, UseDef, CapabilityDef, Alias,\n  RecordBody, SumBody, Positional, RecordPayload, Named, FnType, UnitType,\n  Refined, UnionType, RowType, IntLit, BigIntLit, FloatLit, TupleExpr, StrLit,\n  BoolLit, UnitExpr, Var, Hole, ListExpr, CtorExpr, Call, MethodCall, FieldOf,\n  Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr, MutExpr, Block, MockExpr,\n  Return, Try, Except, Interp, Range, Index, Comp, DictExpr, SetExpr, Fallback,\n  Comptime, Scope, Spawn, Await, Select, Race, SupervisedSpawn, Old, Assumed,\n  Spread, NoArgs, PositionalArgs, RecordArgs, UpdateArgs, ListComp, SetComp,\n  DictComp, TextPart, ValuePart, Add, Sub, Mul, Div, Mod, Equal, NotEqual, Less,\n  LessEq, Greater, GreaterEq, And, Or, Implies, BitAnd, BitOr, BitXor, Shl, Shr,\n  Neg, Not, TryResult, Let, VarDecl, Assign, While, For, Loop, Break, Continue,\n  ExprStmt, Assert, Comment, ComptimeFor, Invariant, Decreases, Wild, Bind,\n  IntPat, StrPat, BoolPat, CtorPattern, ListPat, TuplePat, CondPat, OrPat,\n  ForPat, NoPats, PositionalPats, RecordPats","old_text":"// eval: a tree-walking evaluator for compile-time code (`comptime`,\n// `derive`) and the `strata eval` command, matching compiled code's output.\n//\n// It runs the stored trees, where references to definitions are qualified\n// (`shop.orders.ship`) and method calls and locals are as written. A method\n// call resolves at run time, in this order:\n// 1. the receiver type's own `impl`s, a variant's first;\n// 2. the traits it implements and their default methods;\n// 3. a function of that name visible in the caller's module (`x.twice()`\n//    is `twice(x)`);\n// 4. a built-in.\n// Values are `ast` literals (`IntLit(3)`, `CtorExpr`, `ListExpr`). A\n// closure is its lambda with the captured variables bound before it\n// (`{ n := 3; x -> x + n }`). Output, the fault or error that stopped the\n// run, and the exit code come back in `Run`, as a compiled program would\n// show them.\n//\n// Not supported: mocks, `comptime for`, calls of `extern` functions, and\n// writing files.\n\nfrom ast use Decl, TypeDecl, Variant, FnDecl, Param, TraitDecl, ImplDecl,\n  UseDecl, TypeExpr, Expr, CtorArgs, LamParam, CompFor, FmtSpec, BinOp, Stmt,\n  Pattern, TypeDef, FnDef, TraitDef, ImplDef, UseDef, CapabilityDef, Alias,\n  RecordBody, SumBody, Positional, RecordPayload, Named, FnType, UnitType,\n  Refined, UnionType, IntLit, BigIntLit, FloatLit, TupleExpr, StrLit, BoolLit,\n  UnitExpr, Var, Hole, ListExpr, CtorExpr, Call, MethodCall, FieldOf, Lambda,\n  Binary, Unary, IsExpr, IfExpr, MatchExpr, MutExpr, Block, MockExpr, Return,\n  Try, Except, Interp, Range, Index, Comp, DictExpr, SetExpr, Fallback,\n  Comptime, Scope, Spawn, Await, Select, Race, SupervisedSpawn, Old, Assumed,\n  Spread, NoArgs, PositionalArgs, RecordArgs, UpdateArgs, ListComp, SetComp,\n  DictComp, TextPart, ValuePart, Add, Sub, Mul, Div, Mod, Equal, NotEqual, Less,\n  LessEq, Greater, GreaterEq, And, Or, Implies, BitAnd, BitOr, BitXor, Shl, Shr,\n  Neg, Not, TryResult, Let, VarDecl, Assign, While, For, Loop, Break, Continue,\n  ExprStmt, Assert, Comment, ComptimeFor, Invariant, Decreases, Wild, Bind,\n  IntPat, StrPat, BoolPat, CtorPattern, ListPat, TuplePat, CondPat, OrPat,\n  ForPat, NoPats, PositionalPats, RecordPats"},{"name":"eval.type_head","kind":"fn","old":"b7a8dabd35a89dde","new":"5b52edb43d7818d1","interface_changed":false,"affected":[],"module":"eval","text":"// ---------------- types at run time ----------------\n\n/// The name a type is found by: `List` for `List[Int]`.\nfn type_head(t: ast.TypeExpr) -> String {\n  match t {\n    ast.Named { name, .. } => name,\n    ast.Refined { base, .. } => eval.type_head(base),\n    ast.UnitType => \"Unit\",\n    ast.FnType { .. } => \"Fn\",\n    ast.RowType(_) => \"Row\",\n    ast.UnionType(_) => \"Union\",\n  }\n}","old_text":"// ---------------- types at run time ----------------\n\n/// The name a type is found by: `List` for `List[Int]`.\nfn type_head(t: ast.TypeExpr) -> String {\n  match t {\n    ast.Named { name, .. } => name,\n    ast.Refined { base, .. } => eval.type_head(base),\n    ast.UnitType => \"Unit\",\n    ast.FnType { .. } => \"Fn\",\n    ast.UnionType(_) => \"Union\",\n  }\n}"},{"name":"eval.substitute","kind":"fn","old":"9413356685ace22b","new":"b7f09e8d43615c95","interface_changed":false,"affected":[],"module":"eval","text":"fn substitute(\n  t: ast.TypeExpr,\n  sub: Dict[String, ast.TypeExpr],\n) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => if len(args) == 0 && contains(sub, name) {\n      get(sub, name) ?? t\n    } else {\n      ast.Named {\n        name,\n        args: args.map(a -> eval.substitute(a, sub)),\n      }\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(p -> eval.substitute(p, sub)),\n      ret: eval.substitute(ret, sub),\n    },\n    ast.Refined { base, pred } => ast.Refined { base: eval.substitute(base, sub), pred },\n    ast.RowType(fs) => ast.RowType(fs.map(f -> (f.0, eval.substitute(f.1, sub)))),\n    ast.UnionType(ms) => ast.UnionType(ms.map(m -> eval.substitute(m, sub))),\n    ast.UnitType => ast.UnitType,\n  }\n}","old_text":"fn substitute(\n  t: ast.TypeExpr,\n  sub: Dict[String, ast.TypeExpr],\n) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => if len(args) == 0 && contains(sub, name) {\n      get(sub, name) ?? t\n    } else {\n      ast.Named {\n        name,\n        args: args.map(a -> eval.substitute(a, sub)),\n      }\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(p -> eval.substitute(p, sub)),\n      ret: eval.substitute(ret, sub),\n    },\n    ast.Refined { base, pred } => ast.Refined { base: eval.substitute(base, sub), pred },\n    ast.UnionType(ms) => ast.UnionType(ms.map(m -> eval.substitute(m, sub))),\n    ast.UnitType => ast.UnitType,\n  }\n}"},{"name":"eval.mentions_param","kind":"fn","old":"7d7b12916077d133","new":"c0e847a301a1fbde","interface_changed":false,"affected":[],"module":"eval","text":"fn mentions_param(t: ast.TypeExpr, params: List[String]) -> Bool {\n  match t {\n    ast.Named { name, args } => contains(params, name)\n      || args.any(a -> eval.mentions_param(a, params)),\n    ast.FnType { params: ps, ret } => ps.any(p -> eval.mentions_param(p, params))\n      || eval.mentions_param(ret, params),\n    ast.Refined { base, .. } => eval.mentions_param(base, params),\n    ast.RowType(fs) => fs.any(f -> eval.mentions_param(f.1, params)),\n    ast.UnionType(ms) => ms.any(m -> eval.mentions_param(m, params)),\n    ast.UnitType => false,\n  }\n}","old_text":"fn mentions_param(t: ast.TypeExpr, params: List[String]) -> Bool {\n  match t {\n    ast.Named { name, args } => contains(params, name)\n      || args.any(a -> eval.mentions_param(a, params)),\n    ast.FnType { params: ps, ret } => ps.any(p -> eval.mentions_param(p, params))\n      || eval.mentions_param(ret, params),\n    ast.Refined { base, .. } => eval.mentions_param(base, params),\n    ast.UnionType(ms) => ms.any(m -> eval.mentions_param(m, params)),\n    ast.UnitType => false,\n  }\n}"},{"name":"eval.fits","kind":"fn","old":"8fc2588b178a5e6c","new":"51e33134b4e86bef","interface_changed":false,"affected":[],"module":"eval","text":"/// Whether `v` is a value of `t` (a type pattern, `is`, a union member):\n/// its shape, then every refinement.\nfn fits(\n  mut st: eval.State,\n  w: eval.World,\n  t: ast.TypeExpr,\n  v: ast.Expr,\n) -> Result[Bool, eval.Escape] {\n  match t {\n    ast.Refined { base, pred } => Ok(eval.fits(mut st, w, base, v)!\n      && eval.holds_on(mut st, w, pred, v)!),\n    ast.RowType(_) => Ok(false),\n    ast.UnionType(ms) => {\n      for m in ms {\n        if eval.fits(mut st, w, m, v)! {\n          return Ok(true)\n        }\n      }\n      Ok(false)\n    },\n    ast.UnitType => Ok(v == ast.UnitExpr),\n    ast.FnType { .. } => Ok(eval.head_of(w, v) == \"Fn\"),\n    ast.Named { name, args } => {\n      prim := match name {\n        \"Int\" => Some(v is ast.IntLit),\n        \"Float\" => Some(v is ast.FloatLit),\n        \"String\" => Some(v is ast.StrLit),\n        \"Bool\" => Some(v is ast.BoolLit),\n        \"List\" => Some(v is ast.ListExpr),\n        \"Set\" => Some(v is ast.SetExpr),\n        \"Dict\" => Some(v is ast.DictExpr),\n        \"Tuple\" => Some(v is ast.TupleExpr),\n        _ => None,\n      }\n      match prim {\n        Some(b) => return Ok(b),\n        None => (),\n      }\n      if contains(w.ctors, name) {\n        return Ok(match v {\n          ast.CtorExpr { name: c, .. } => c == name,\n          _ => false,\n        })\n      }\n      td := match get(w.types, name) {\n        Some(d) => d,\n        None => return Ok(false),\n      }\n      match td.body {\n        ast.Alias(a) => if td.distinct {\n          Ok(match v {\n            ast.CtorExpr { name: c, .. } => c == name,\n            _ => false,\n          })\n        } else {\n          sub := dict(zip(td.params, args))\n          if !eval.fits(mut st, w, eval.substitute(a, sub), v)! {\n            return Ok(false)\n          }\n          match td.refinement {\n            Some(r) => eval.holds_on(mut st, w, r, v),\n            None => Ok(true),\n          }\n        },\n        _ => Ok(eval.head_of(w, v) == name),\n      }\n    },\n  }\n}","old_text":"/// Whether `v` is a value of `t` (a type pattern, `is`, a union member):\n/// its shape, then every refinement.\nfn fits(\n  mut st: eval.State,\n  w: eval.World,\n  t: ast.TypeExpr,\n  v: ast.Expr,\n) -> Result[Bool, eval.Escape] {\n  match t {\n    ast.Refined { base, pred } => Ok(eval.fits(mut st, w, base, v)!\n      && eval.holds_on(mut st, w, pred, v)!),\n    ast.UnionType(ms) => {\n      for m in ms {\n        if eval.fits(mut st, w, m, v)! {\n          return Ok(true)\n        }\n      }\n      Ok(false)\n    },\n    ast.UnitType => Ok(v == ast.UnitExpr),\n    ast.FnType { .. } => Ok(eval.head_of(w, v) == \"Fn\"),\n    ast.Named { name, args } => {\n      prim := match name {\n        \"Int\" => Some(v is ast.IntLit),\n        \"Float\" => Some(v is ast.FloatLit),\n        \"String\" => Some(v is ast.StrLit),\n        \"Bool\" => Some(v is ast.BoolLit),\n        \"List\" => Some(v is ast.ListExpr),\n        \"Set\" => Some(v is ast.SetExpr),\n        \"Dict\" => Some(v is ast.DictExpr),\n        \"Tuple\" => Some(v is ast.TupleExpr),\n        _ => None,\n      }\n      match prim {\n        Some(b) => return Ok(b),\n        None => (),\n      }\n      if contains(w.ctors, name) {\n        return Ok(match v {\n          ast.CtorExpr { name: c, .. } => c == name,\n          _ => false,\n        })\n      }\n      td := match get(w.types, name) {\n        Some(d) => d,\n        None => return Ok(false),\n      }\n      match td.body {\n        ast.Alias(a) => if td.distinct {\n          Ok(match v {\n            ast.CtorExpr { name: c, .. } => c == name,\n            _ => false,\n          })\n        } else {\n          sub := dict(zip(td.params, args))\n          if !eval.fits(mut st, w, eval.substitute(a, sub), v)! {\n            return Ok(false)\n          }\n          match td.refinement {\n            Some(r) => eval.holds_on(mut st, w, r, v),\n            None => Ok(true),\n          }\n        },\n        _ => Ok(eval.head_of(w, v) == name),\n      }\n    },\n  }\n}"},{"name":"eval.has_unknown","kind":"fn","old":"c01de4e3df9e9f25","new":"99c92f6d02d9e87d","interface_changed":false,"affected":[],"module":"eval","text":"fn has_unknown(t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Named { name, args } => name == \"_\" || args.any(a -> eval.has_unknown(a)),\n    ast.FnType { params, ret } => params.any(a -> eval.has_unknown(a)) || eval.has_unknown(ret),\n    ast.Refined { base, .. } => eval.has_unknown(base),\n    ast.RowType(fs) => fs.any(f -> eval.has_unknown(f.1)),\n    ast.UnionType(ms) => ms.any(a -> eval.has_unknown(a)),\n    ast.UnitType => false,\n  }\n}","old_text":"fn has_unknown(t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Named { name, args } => name == \"_\" || args.any(a -> eval.has_unknown(a)),\n    ast.FnType { params, ret } => params.any(a -> eval.has_unknown(a)) || eval.has_unknown(ret),\n    ast.Refined { base, .. } => eval.has_unknown(base),\n    ast.UnionType(ms) => ms.any(a -> eval.has_unknown(a)),\n    ast.UnitType => false,\n  }\n}"},{"name":"finding.untagged","kind":"fn","old":"21992522add54e77","new":"6ffd7e276c625233","interface_changed":false,"affected":[],"module":"finding","text":"/// A field read's name without its owners (`sku` of `sku#Line`), and the\n/// owners.\nfn untagged(n: String) -> (String, List[String]) {\n  match index_of(n, \"#\") {\n    Some(k) => (\n      byte_slice(n, 0, k),\n      split(byte_slice(n, k + 1, byte_len(n)), \",\"),\n    ),\n    None => (n, []),\n  }\n}","old_text":"/// A field read's name without its owners (`sku` of `sku#Line`), and the\n/// owners.\nfn untagged(n: String) -> (String, List[String]) {\n  match index_of(n, \"#\") {\n    Some(k) => (\n      byte_slice(n, 0, k),\n      split(byte_slice(n, k + 1, byte_len(n)), \",\"),\n    ),\n    None => (n, []),\n  }\n}"},{"name":"graph.Shape","kind":"type","old":"db7bbb3113ef7bc6","new":"24c048ae47f60164","interface_changed":false,"affected":[],"module":"graph","text":"/// A function as `trace_graph` reads its calls: its label, and where the type\n/// is in its parameters and result.\ntype Shape = {\n  label: String,\n  ins: List[graph.Place],\n  outs: List[List[graph.Step]],\n}","old_text":"/// A function as `trace_graph` reads its calls: its label, and where the type\n/// is in its parameters and result.\ntype Shape = {\n  label: String,\n  ins: List[graph.Place],\n  outs: List[List[graph.Step]],\n}"},{"name":"locate.type_expr_kids","kind":"fn","old":"f5948bc3a09bc5e8","new":"3102b991db13064e","interface_changed":false,"affected":[],"module":"locate","text":"fn type_expr_kids(t: ast.TypeExpr) -> List[locate.Child] {\n  match t {\n    ast.Named { args, .. } => locate.indexed_types(\"args/\", args),\n    ast.FnType { params, ret } => locate.indexed_types(\"params/\", params)\n      + [locate.kid(\"ret\", locate.TNode(ret))],\n    ast.Refined { base, pred } => [locate.kid(\"base\", locate.TNode(base)), locate.Child {\n      label: \"pred\",\n      node: locate.ENode(pred),\n      binds: [\"self\"],\n    }],\n    ast.RowType(fs) => locate.indexed_types(\"\", fs.map(f -> f.1)),\n    ast.UnionType(ts) => locate.indexed_types(\"\", ts),\n    ast.UnitType => [],\n  }\n}","old_text":"fn type_expr_kids(t: ast.TypeExpr) -> List[locate.Child] {\n  match t {\n    ast.Named { args, .. } => locate.indexed_types(\"args/\", args),\n    ast.FnType { params, ret } => locate.indexed_types(\"params/\", params)\n      + [locate.kid(\"ret\", locate.TNode(ret))],\n    ast.Refined { base, pred } => [locate.kid(\"base\", locate.TNode(base)), locate.Child {\n      label: \"pred\",\n      node: locate.ENode(pred),\n      binds: [\"self\"],\n    }],\n    ast.UnionType(ts) => locate.indexed_types(\"\", ts),\n    ast.UnitType => [],\n  }\n}"},{"name":"locate.replaced_type","kind":"fn","old":"529469aee3b174be","new":"7d8b3d4c52532324","interface_changed":false,"affected":[],"module":"locate","text":"fn replaced_type(\n  t: ast.TypeExpr,\n  path: String,\n  names: Dict[String, String],\n) -> ast.TypeExpr {\n  at := (label: String, x: ast.TypeExpr) ->\n    locate.as_type(locate.replaced(\n      locate.TNode(x),\n      locate.joined(path, label),\n      names,\n    ), x)\n  match t {\n    ast.Named { name, args } => ast.Named {\n      name,\n      args: [at(\"args/\" + to_string(i), x) for (i, x) in enumerate(args)],\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: [at(\"params/\" + to_string(i), x) for (i, x) in enumerate(params)],\n      ret: at(\"ret\", ret),\n    },\n    ast.Refined { base, pred } => ast.Refined {\n      base: at(\"base\", base),\n      pred: locate.as_expr(locate.replaced(\n        locate.ENode(pred),\n        locate.joined(path, \"pred\"),\n        names,\n      ), pred),\n    },\n    ast.RowType(fs) => ast.RowType(\n      [(f.0, at(to_string(i), f.1)) for (i, f) in enumerate(fs)],\n    ),\n    ast.UnionType(ts) => ast.UnionType([at(to_string(i), x) for (i, x) in enumerate(ts)]),\n    ast.UnitType => ast.UnitType,\n  }\n}","old_text":"fn replaced_type(\n  t: ast.TypeExpr,\n  path: String,\n  names: Dict[String, String],\n) -> ast.TypeExpr {\n  at := (label: String, x: ast.TypeExpr) ->\n    locate.as_type(locate.replaced(\n      locate.TNode(x),\n      locate.joined(path, label),\n      names,\n    ), x)\n  match t {\n    ast.Named { name, args } => ast.Named {\n      name,\n      args: [at(\"args/\" + to_string(i), x) for (i, x) in enumerate(args)],\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: [at(\"params/\" + to_string(i), x) for (i, x) in enumerate(params)],\n      ret: at(\"ret\", ret),\n    },\n    ast.Refined { base, pred } => ast.Refined {\n      base: at(\"base\", base),\n      pred: locate.as_expr(locate.replaced(\n        locate.ENode(pred),\n        locate.joined(path, \"pred\"),\n        names,\n      ), pred),\n    },\n    ast.UnionType(ts) => ast.UnionType([at(to_string(i), x) for (i, x) in enumerate(ts)]),\n    ast.UnitType => ast.UnitType,\n  }\n}"},{"name":"refined_in","kind":"fn","old":"702a38ff20580d67","new":"95ba7d75b35027da","interface_changed":false,"affected":[],"module":"","text":"/// Whether a value of `t` can break a refinement: one is in it, or in the\n/// types it names, their fields and variants. `None` when `t` names\n/// something unknown here (a type parameter).\nfn refined_in(\n  types: Dict[String, ast.TypeDecl],\n  t: ast.TypeExpr,\n  seen: List[String],\n) -> Option[Bool] {\n  match t {\n    ast.UnitType | ast.FnType { .. } => Some(false),\n    ast.Refined { .. } => Some(true),\n    ast.RowType(fs) => {\n      mut any := false\n      for f in fs {\n        any = refined_in(types, f.1, seen)? || any\n      }\n      Some(any)\n    },\n    ast.UnionType(ms) => {\n      mut any := false\n      for m in ms {\n        any = refined_in(types, m, seen)? || any\n      }\n      Some(any)\n    },\n    ast.Named { name, args } => {\n      mut any := false\n      for a in args {\n        any = refined_in(types, a, seen)? || any\n      }\n      if contains([\n          \"Int\",\n          \"Float\",\n          \"Bool\",\n          \"String\",\n          \"Unit\",\n          \"List\",\n          \"Set\",\n          \"Dict\",\n          \"Tuple\",\n        ], name)\n        || contains(seen, name) {\n        return Some(any)\n      }\n      td := get(types, name)?\n      if td.refinement != None {\n        return Some(true)\n      }\n      inner := seen + [name]\n      // a declaration's own parameters stand for the arguments, checked above\n      own := (x: ast.TypeExpr) -> match x {\n        ast.Named { name: p, args: [] } => if contains(td.params, p) {\n          Some(false)\n        } else {\n          refined_in(types, x, inner)\n        },\n        _ => refined_in(types, x, inner),\n      }\n      mut r := any\n      match td.body {\n        ast.Alias(a) => {\n          r = own(a)? || r\n        },\n        ast.RecordBody(fs) => {\n          for f in fs {\n            r = own(f.ty)? || r\n          }\n        },\n        ast.SumBody(vs) => {\n          for v in vs {\n            match v.payload {\n              ast.Positional(ts) => {\n                for x in ts {\n                  r = own(x)? || r\n                }\n              },\n              ast.RecordPayload(fs) => {\n                for f in fs {\n                  r = own(f.ty)? || r\n                }\n              },\n              _ => (),\n            }\n          }\n        },\n      }\n      Some(r)\n    },\n  }\n}","old_text":"/// Whether a value of `t` can break a refinement: one is in it, or in the\n/// types it names, their fields and variants. `None` when `t` names\n/// something unknown here (a type parameter).\nfn refined_in(\n  types: Dict[String, ast.TypeDecl],\n  t: ast.TypeExpr,\n  seen: List[String],\n) -> Option[Bool] {\n  match t {\n    ast.UnitType | ast.FnType { .. } => Some(false),\n    ast.Refined { .. } => Some(true),\n    ast.UnionType(ms) => {\n      mut any := false\n      for m in ms {\n        any = refined_in(types, m, seen)? || any\n      }\n      Some(any)\n    },\n    ast.Named { name, args } => {\n      mut any := false\n      for a in args {\n        any = refined_in(types, a, seen)? || any\n      }\n      if contains([\n          \"Int\",\n          \"Float\",\n          \"Bool\",\n          \"String\",\n          \"Unit\",\n          \"List\",\n          \"Set\",\n          \"Dict\",\n          \"Tuple\",\n        ], name)\n        || contains(seen, name) {\n        return Some(any)\n      }\n      td := get(types, name)?\n      if td.refinement != None {\n        return Some(true)\n      }\n      inner := seen + [name]\n      // a declaration's own parameters stand for the arguments, checked above\n      own := (x: ast.TypeExpr) -> match x {\n        ast.Named { name: p, args: [] } => if contains(td.params, p) {\n          Some(false)\n        } else {\n          refined_in(types, x, inner)\n        },\n        _ => refined_in(types, x, inner),\n      }\n      mut r := any\n      match td.body {\n        ast.Alias(a) => {\n          r = own(a)? || r\n        },\n        ast.RecordBody(fs) => {\n          for f in fs {\n            r = own(f.ty)? || r\n          }\n        },\n        ast.SumBody(vs) => {\n          for v in vs {\n            match v.payload {\n              ast.Positional(ts) => {\n                for x in ts {\n                  r = own(x)? || r\n                }\n              },\n              ast.RecordPayload(fs) => {\n                for f in fs {\n                  r = own(f.ty)? || r\n                }\n              },\n              _ => (),\n            }\n          }\n        },\n      }\n      Some(r)\n    },\n  }\n}"},{"name":"takes_raw","kind":"fn","old":"e6046029e0240ae0","new":"c16969b95fc0486d","interface_changed":false,"affected":[],"module":"","text":"/// Whether a parameter's type names core.values' `Raw` (a compiled value's\n/// address).\nfn takes_raw(f: ast.FnDecl) -> Bool {\n  mut todo := f.params.map(p -> p.ty)\n  while len(todo) > 0 {\n    t := get(todo, len(todo) - 1) ?? ast.UnitType\n    todo = todo[..len(todo) - 1]\n    match t {\n      ast.Named { name, args } => {\n        if name == \"Raw\" || name == \"core.values.Raw\" {\n          return true\n        }\n        todo += args\n      },\n      ast.FnType { params, ret } => {\n        todo = todo + params + [ret]\n      },\n      ast.Refined { base, .. } => mut todo.push(base),\n      ast.RowType(fs) => {\n        todo += fs.map(f -> f.1)\n      },\n      ast.UnionType(ms) => {\n        todo += ms\n      },\n      ast.UnitType => (),\n    }\n  }\n  false\n}","old_text":"/// Whether a parameter's type names core.values' `Raw` (a compiled value's\n/// address).\nfn takes_raw(f: ast.FnDecl) -> Bool {\n  mut todo := f.params.map(p -> p.ty)\n  while len(todo) > 0 {\n    t := get(todo, len(todo) - 1) ?? ast.UnitType\n    todo = todo[..len(todo) - 1]\n    match t {\n      ast.Named { name, args } => {\n        if name == \"Raw\" || name == \"core.values.Raw\" {\n          return true\n        }\n        todo += args\n      },\n      ast.FnType { params, ret } => {\n        todo = todo + params + [ret]\n      },\n      ast.Refined { base, .. } => mut todo.push(base),\n      ast.UnionType(ms) => {\n        todo += ms\n      },\n      ast.UnitType => (),\n    }\n  }\n  false\n}"},{"name":"merge.tokens","kind":"fn","old":"43f8176bbc55bf77","new":"a4edafd2b46d8f30","interface_changed":false,"affected":[],"module":"merge","text":"/// Words, runs of spaces, and each other character, in order.\npub fn tokens(s: String) -> List[String] {\n  mut out := []\n  mut cur := \"\"\n  mut last := -1\n  for c in chars(s) {\n    k := merge.class(c)\n    if cur != \"\" && (k != last || k == 2) {\n      mut out.push(cur)\n      cur = \"\"\n    }\n    cur += c\n    last = k\n  }\n  if cur != \"\" {\n    mut out.push(cur)\n  }\n  out\n}","old_text":"/// Words, runs of spaces, and each other character, in order.\npub fn tokens(s: String) -> List[String] {\n  mut out := []\n  mut cur := \"\"\n  mut last := -1\n  for c in chars(s) {\n    k := merge.class(c)\n    if cur != \"\" && (k != last || k == 2) {\n      mut out.push(cur)\n      cur = \"\"\n    }\n    cur += c\n    last = k\n  }\n  if cur != \"\" {\n    mut out.push(cur)\n  }\n  out\n}"},{"name":"parse.use ast","kind":"use","old":"5ece79d9bbcaa920","new":"bd994847a3516cc0","interface_changed":true,"affected":[],"module":"parse","text":"// parse: Strata's parser, from text to the tree in `ast`, comments included.\n// The tree is as written. Storing it (`strata edit`) qualifies its\n// references, which needs name resolution.\n\nfrom ast use DeriveFnDecl, DeriveFnDef, ModelDecl, ModelDef, Decl, DeclKind,\n  TypeDecl, TypeBody, Field, Variant, Payload, FnDecl, Param, Bound, TestDecl,\n  TraitDecl, Derivable, TraitMethod, Law, ImplDecl, UseDecl, UseItem,\n  ExternDecl, CapabilityDecl, TypeExpr, Expr, LamParam, CompFor, Arm, StrPart,\n  FmtSpec, BinOp, Stmt, Pattern, SelectArm, TypeDef, FnDef, TestDef, TraitDef,\n  ImplDef, UseDef, ExternDef, CapabilityDef, Alias, RecordBody, SumBody,\n  NoPayload, Positional, RecordPayload, MemberType, C, Builtin, Python,\n  ExternFn, ExternType, ExternStatic, ExternThreadStatic, Named, FnType,\n  UnitType, Refined, UnionType, RowType, IntLit, BigIntLit, FloatLit, TupleExpr,\n  StrLit, BoolLit, UnitExpr, Var, Hole, ListExpr, CtorExpr, Call, MethodCall,\n  FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr, MutExpr, Block,\n  MockExpr, Return, Try, Except, Interp, Range, Index, Comp, DictExpr, SetExpr,\n  Fallback, Comptime, Scope, Spawn, Await, Select, Race, SupervisedSpawn, Old,\n  Assumed, Spread, NoArgs, PositionalArgs, RecordArgs, UpdateArgs, ListComp,\n  SetComp, DictComp, TextPart, ValuePart, Add, Sub, Mul, Div, Mod, Equal,\n  NotEqual, Less, LessEq, Greater, GreaterEq, And, Or, Implies, BitAnd, BitOr,\n  BitXor, Shl, Shr, Neg, Not, TryResult, TryOption, Let, VarDecl, Assign, While,\n  For, Loop, Break, Continue, ExprStmt, Assert, Comment, ComptimeFor, Invariant,\n  Decreases, Wild, Bind, IntPat, StrPat, BoolPat, CtorPattern, ListPat,\n  TuplePat, CondPat, OrPat, ForPat, NoPats, PositionalPats, RecordPats,\n  TypePats, DeriveClause, AssertBy, Calc","old_text":"// parse: Strata's parser, from text to the tree in `ast`, comments included.\n// The tree is as written. Storing it (`strata edit`) qualifies its\n// references, which needs name resolution.\n\nfrom ast use DeriveFnDecl, DeriveFnDef, ModelDecl, ModelDef, Decl, DeclKind,\n  TypeDecl, TypeBody, Field, Variant, Payload, FnDecl, Param, Bound, TestDecl,\n  TraitDecl, Derivable, TraitMethod, Law, ImplDecl, UseDecl, UseItem,\n  ExternDecl, CapabilityDecl, TypeExpr, Expr, LamParam, CompFor, Arm, StrPart,\n  FmtSpec, BinOp, Stmt, Pattern, SelectArm, TypeDef, FnDef, TestDef, TraitDef,\n  ImplDef, UseDef, ExternDef, CapabilityDef, Alias, RecordBody, SumBody,\n  NoPayload, Positional, RecordPayload, MemberType, C, Builtin, Python,\n  ExternFn, ExternType, ExternStatic, ExternThreadStatic, Named, FnType,\n  UnitType, Refined, UnionType, IntLit, BigIntLit, FloatLit, TupleExpr, StrLit,\n  BoolLit, UnitExpr, Var, Hole, ListExpr, CtorExpr, Call, MethodCall, FieldOf,\n  Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr, MutExpr, Block, MockExpr,\n  Return, Try, Except, Interp, Range, Index, Comp, DictExpr, SetExpr, Fallback,\n  Comptime, Scope, Spawn, Await, Select, Race, SupervisedSpawn, Old, Assumed,\n  Spread, NoArgs, PositionalArgs, RecordArgs, UpdateArgs, ListComp, SetComp,\n  DictComp, TextPart, ValuePart, Add, Sub, Mul, Div, Mod, Equal, NotEqual, Less,\n  LessEq, Greater, GreaterEq, And, Or, Implies, BitAnd, BitOr, BitXor, Shl, Shr,\n  Neg, Not, TryResult, TryOption, Let, VarDecl, Assign, While, For, Loop, Break,\n  Continue, ExprStmt, Assert, Comment, ComptimeFor, Invariant, Decreases, Wild,\n  Bind, IntPat, StrPat, BoolPat, CtorPattern, ListPat, TuplePat, CondPat, OrPat,\n  ForPat, NoPats, PositionalPats, RecordPats, TypePats, DeriveClause, AssertBy,\n  Calc"},{"name":"parse.type_head","kind":"fn","old":"9a1715fab8b05b23","new":"9cc7b7501e1cd8e8","interface_changed":false,"affected":[],"module":"parse","text":"/// The name a type is found by: `List` for `List[Int]`.\nfn type_head(t: ast.TypeExpr) -> String {\n  match t {\n    ast.Named { name, .. } => name,\n    ast.Refined { base, .. } => parse.type_head(base),\n    ast.UnitType => \"Unit\",\n    ast.FnType { .. } => \"Fn\",\n    ast.RowType(_) => \"Row\",\n    ast.UnionType(_) => \"Union\",\n  }\n}","old_text":"/// The name a type is found by: `List` for `List[Int]`.\nfn type_head(t: ast.TypeExpr) -> String {\n  match t {\n    ast.Named { name, .. } => name,\n    ast.Refined { base, .. } => parse.type_head(base),\n    ast.UnitType => \"Unit\",\n    ast.FnType { .. } => \"Fn\",\n    ast.UnionType(_) => \"Union\",\n  }\n}"},{"name":"refactor.use ast","kind":"use","old":"f14bb4c6c118c3b2","new":"0ccb963e6836b95f","interface_changed":true,"affected":[],"module":"refactor","text":"// refactor: `strata rename` and `strata move`, on the stored program.\n\nfrom ast use Decl, DeclKind, Expr, Pattern, TypeExpr, UseItem, UseDecl, TypeDef,\n  FnDef, TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, SumBody,\n  RecordBody, RecordPayload, Var, CtorExpr, MethodCall, IsExpr, FieldOf,\n  RecordArgs, UpdateArgs, CtorPattern, RecordPats, Named, RowType, ExternFn,\n  ExternType, ExternStatic, ExternThreadStatic","old_text":"// refactor: `strata rename` and `strata move`, on the stored program.\n\nfrom ast use Decl, DeclKind, Expr, Pattern, TypeExpr, UseItem, UseDecl, TypeDef,\n  FnDef, TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, SumBody,\n  RecordBody, RecordPayload, Var, CtorExpr, MethodCall, IsExpr, FieldOf,\n  RecordArgs, UpdateArgs, CtorPattern, RecordPats, Named, ExternFn, ExternType,\n  ExternStatic, ExternThreadStatic"},{"name":"refactor.type_renamed","kind":"fn","old":"490cc747ebfae71f","new":"7def5145b48cc15c","interface_changed":false,"affected":[],"module":"refactor","text":"fn type_renamed(\n  t: ast.TypeExpr,\n  renames: Dict[String, String],\n) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => ast.Named {\n      name: get(renames, name) ?? name,\n      args: args.map(a -> refactor.type_renamed(a, renames)),\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> refactor.type_renamed(a, renames)),\n      ret: refactor.type_renamed(ret, renames),\n    },\n    ast.Refined { base, pred } => ast.Refined { base: refactor.type_renamed(base, renames), pred },\n    ast.RowType(fs) => ast.RowType(\n      fs.map(f -> (f.0, refactor.type_renamed(f.1, renames))),\n    ),\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> refactor.type_renamed(a, renames))),\n    _ => t,\n  }\n}","old_text":"fn type_renamed(\n  t: ast.TypeExpr,\n  renames: Dict[String, String],\n) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => ast.Named {\n      name: get(renames, name) ?? name,\n      args: args.map(a -> refactor.type_renamed(a, renames)),\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> refactor.type_renamed(a, renames)),\n      ret: refactor.type_renamed(ret, renames),\n    },\n    ast.Refined { base, pred } => ast.Refined { base: refactor.type_renamed(base, renames), pred },\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> refactor.type_renamed(a, renames))),\n    _ => t,\n  }\n}"},{"name":"resolve.use ast","kind":"use","old":"8af44d018e940668","new":"d075b7eab273bed1","interface_changed":true,"affected":[],"module":"resolve","text":"// resolve: name resolution. It turns a program into its stored form, where\n// every reference to a definition is its qualified name, and back into the\n// written form. Locals and method names are left as written. A name that\n// resolves to nothing stays as written, and the checker reports it.\n\nfrom ast use DeriveFnDef, DeriveFnDecl, ModelDecl, ModelDef, Decl, DeclKind,\n  TypeDecl, Field, Variant, FnDecl, Param, Bound, TestDecl, TraitDecl,\n  Derivable, TraitMethod, Law, ImplDecl, ExternDecl, CapabilityDecl, TypeExpr,\n  Expr, LamParam, CompFor, Arm, Stmt, Pattern, SelectArm, TypeDef, FnDef,\n  TestDef, TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, Alias,\n  RecordBody, SumBody, NoPayload, Positional, RecordPayload, MemberType,\n  ExternFn, ExternType, ExternStatic, ExternThreadStatic, Named, FnType,\n  UnitType, Refined, UnionType, RowType, TupleExpr, Var, ListExpr, CtorExpr,\n  Call, MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr,\n  MutExpr, Block, MockExpr, Return, Try, Except, Interp, Range, Index, Comp,\n  DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn, Await, Select, Race,\n  SupervisedSpawn, Old, Assumed, Spread, NoArgs, PositionalArgs, RecordArgs,\n  UpdateArgs, ValuePart, Let, VarDecl, Assign, While, For, Loop, ExprStmt,\n  Assert, ComptimeFor, Invariant, Decreases, Bind, CtorPattern, ListPat,\n  TuplePat, CondPat, OrPat, ForPat, NoPats, PositionalPats, RecordPats,\n  TypePats, AssertBy, Calc","old_text":"// resolve: name resolution. It turns a program into its stored form, where\n// every reference to a definition is its qualified name, and back into the\n// written form. Locals and method names are left as written. A name that\n// resolves to nothing stays as written, and the checker reports it.\n\nfrom ast use DeriveFnDef, DeriveFnDecl, ModelDecl, ModelDef, Decl, DeclKind,\n  TypeDecl, Field, Variant, FnDecl, Param, Bound, TestDecl, TraitDecl,\n  Derivable, TraitMethod, Law, ImplDecl, ExternDecl, CapabilityDecl, TypeExpr,\n  Expr, LamParam, CompFor, Arm, Stmt, Pattern, SelectArm, TypeDef, FnDef,\n  TestDef, TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, Alias,\n  RecordBody, SumBody, NoPayload, Positional, RecordPayload, MemberType,\n  ExternFn, ExternType, ExternStatic, ExternThreadStatic, Named, FnType,\n  UnitType, Refined, UnionType, TupleExpr, Var, ListExpr, CtorExpr, Call,\n  MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr,\n  MutExpr, Block, MockExpr, Return, Try, Except, Interp, Range, Index, Comp,\n  DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn, Await, Select, Race,\n  SupervisedSpawn, Old, Assumed, Spread, NoArgs, PositionalArgs, RecordArgs,\n  UpdateArgs, ValuePart, Let, VarDecl, Assign, While, For, Loop, ExprStmt,\n  Assert, ComptimeFor, Invariant, Decreases, Bind, CtorPattern, ListPat,\n  TuplePat, CondPat, OrPat, ForPat, NoPats, PositionalPats, RecordPats,\n  TypePats, AssertBy, Calc"},{"name":"resolve.ty","kind":"fn","old":"7ec6bf759b0518ba","new":"21f3a72a2f0ef78b","interface_changed":false,"affected":[],"module":"resolve","text":"fn ty(mut r: resolve.Rw, given: ast.TypeExpr) -> ast.TypeExpr {\n  t := if r.shorten {\n    resolve.named_type(r.unions, r.module, r.own, given)\n  } else {\n    given\n  }\n  match t {\n    ast.Named { name: n, args } => {\n      n2 := if n == \"Self\" || r.tparams.any(s -> contains(s, n)) {\n        n\n      } else {\n        resolve.name(mut r, n)\n      }\n      mut out := []\n      for a in args {\n        mut out.push(resolve.ty(mut r, a))\n      }\n      ast.Named { name: n2, args: out }\n    },\n    ast.FnType { params, ret } => {\n      mut ps := []\n      for a in params {\n        mut ps.push(resolve.ty(mut r, a))\n      }\n      ast.FnType { params: ps, ret: resolve.ty(mut r, ret) }\n    },\n    ast.UnitType => ast.UnitType,\n    ast.RowType(fs) => {\n      mut out := []\n      for f in fs {\n        mut out.push((f.0, resolve.ty(mut r, f.1)))\n      }\n      ast.RowType(out)\n    },\n    ast.UnionType(ms) => {\n      mut out := []\n      for m in ms {\n        mut out.push(resolve.ty(mut r, m))\n      }\n      ast.UnionType(out)\n    },\n    ast.Refined { base, pred } => {\n      b := resolve.ty(mut r, base)\n      resolve.open(mut r, [\"it\"])\n      p := resolve.expr(mut r, pred)\n      resolve.close(mut r)\n      ast.Refined { base: b, pred: p }\n    },\n  }\n}","old_text":"fn ty(mut r: resolve.Rw, given: ast.TypeExpr) -> ast.TypeExpr {\n  t := if r.shorten {\n    resolve.named_type(r.unions, r.module, r.own, given)\n  } else {\n    given\n  }\n  match t {\n    ast.Named { name: n, args } => {\n      n2 := if n == \"Self\" || r.tparams.any(s -> contains(s, n)) {\n        n\n      } else {\n        resolve.name(mut r, n)\n      }\n      mut out := []\n      for a in args {\n        mut out.push(resolve.ty(mut r, a))\n      }\n      ast.Named { name: n2, args: out }\n    },\n    ast.FnType { params, ret } => {\n      mut ps := []\n      for a in params {\n        mut ps.push(resolve.ty(mut r, a))\n      }\n      ast.FnType { params: ps, ret: resolve.ty(mut r, ret) }\n    },\n    ast.UnitType => ast.UnitType,\n    ast.UnionType(ms) => {\n      mut out := []\n      for m in ms {\n        mut out.push(resolve.ty(mut r, m))\n      }\n      ast.UnionType(out)\n    },\n    ast.Refined { base, pred } => {\n      b := resolve.ty(mut r, base)\n      resolve.open(mut r, [\"it\"])\n      p := resolve.expr(mut r, pred)\n      resolve.close(mut r)\n      ast.Refined { base: b, pred: p }\n    },\n  }\n}"},{"name":"resolve.type_head","kind":"fn","old":"897589572d5bde59","new":"4b78a5a76fff9785","interface_changed":false,"affected":[],"module":"resolve","text":"/// `List` for `List[Int]`.\nfn type_head(t: ast.TypeExpr) -> String {\n  match t {\n    ast.Named { name, .. } => name,\n    ast.Refined { base, .. } => resolve.type_head(base),\n    ast.UnitType => \"Unit\",\n    ast.FnType { .. } => \"Fn\",\n    ast.RowType(_) => \"Row\",\n    ast.UnionType(_) => \"Union\",\n  }\n}","old_text":"/// `List` for `List[Int]`.\nfn type_head(t: ast.TypeExpr) -> String {\n  match t {\n    ast.Named { name, .. } => name,\n    ast.Refined { base, .. } => resolve.type_head(base),\n    ast.UnitType => \"Unit\",\n    ast.FnType { .. } => \"Fn\",\n    ast.UnionType(_) => \"Union\",\n  }\n}"},{"name":"resolve.walk","kind":"fn","old":"27be7a052b2b528b","new":"08dc28276f112162","interface_changed":false,"affected":[],"module":"resolve","text":"/// The definitions of `decls` at the places `pick` takes, resolved (stored,\n/// or written when\n/// `shorten`) with all of `given` and `std` in scope, and the errors found.\nfn walk(\n  given: List[ast.Decl],\n  pick: (Int) -> Bool,\n  std: List[ast.Decl],\n  core: builtins.Core,\n  shorten: Bool,\n) -> (List[ast.Decl], List[(String, String)]) {\n  decls := resolve.union_members(given, core)\n  all := decls + std\n  unions := if shorten {\n    resolve.unions_of(decls)\n  } else {\n    resolve.no_unions()\n  }\n  n := resolve.names_of(all)\n  mut scopes := Dict[String, Dict[String, String]] {}\n  // each module's imports, worked out once\n  mut imports := Dict[String, List[String]] {}\n  mut bindings := Dict[String, Dict[String, String]] {}\n  mut uses := Dict[String, List[(String, Bool)]] {}\n  mut out := []\n  mut found := []\n  for (k, d) in enumerate(decls) {\n    if !pick(k) {\n      continue\n    }\n    if !contains(scopes, d.module) {\n      mut scopes.insert(d.module, resolve.scope_of(n, all, d.module))\n      mut imports.insert(d.module, resolve.imports_of(decls, d.module))\n      mut bindings.insert(\n        d.module,\n        resolve.bindings_of(decls, d.module),\n      )\n      mut uses.insert(d.module, resolve.uses_of(decls, d.module))\n    }\n    mut r := resolve.Rw {\n      visible: get(scopes, d.module) ?? Dict[String, String] {},\n      modules: n.modules,\n      methods: n.methods,\n      locals: [],\n      tparams: [],\n      shorten,\n      table: n.table,\n      unions,\n      module: d.module,\n      own: match d.kind {\n        ast.TypeDef(t) => resolve.qual(d, t.name),\n        _ => \"\",\n      },\n      imports: get(imports, d.module) ?? [],\n      bindings: get(bindings, d.module) ?? Dict[String, String] {},\n      uses: get(uses, d.module) ?? [],\n      found: [],\n      relocate: \"\",\n      own_modules: [],\n      collect: false,\n      names: [],\n      for_tests: match d.kind {\n        ast.TestDef(_) => true,\n        ast.TypeDef(t) => t.mocked,\n        ast.ImplDef(i) => {\n          head := resolve.type_head(i.for_type)\n          own_scope := get(scopes, d.module) ?? Dict[String, String] {}\n          q := get(own_scope, head) or {\n            if contains(head, \".\") {\n              head\n            } else {\n              resolve.qualified(d.module, head)\n            }\n          }\n          match get(n.table, q) {\n            Some(it) => it.fake,\n            None => false,\n          }\n        },\n        _ => false,\n      },\n    }\n    mut out.push(\n      ast.Decl { ..d, kind: resolve.decl_kind(mut r, d.kind) },\n    )\n    for e in r.found {\n      mut found.push((resolve.decl_name(d), e))\n    }\n  }\n  (out, found)\n}","old_text":"/// The definitions of `decls` at the places `pick` takes, resolved (stored,\n/// or written when\n/// `shorten`) with all of `given` and `std` in scope, and the errors found.\nfn walk(\n  given: List[ast.Decl],\n  pick: (Int) -> Bool,\n  std: List[ast.Decl],\n  core: builtins.Core,\n  shorten: Bool,\n) -> (List[ast.Decl], List[(String, String)]) {\n  decls := resolve.union_members(given, core)\n  all := decls + std\n  unions := if shorten {\n    resolve.unions_of(decls)\n  } else {\n    resolve.no_unions()\n  }\n  n := resolve.names_of(all)\n  mut scopes := Dict[String, Dict[String, String]] {}\n  // each module's imports, worked out once\n  mut imports := Dict[String, List[String]] {}\n  mut bindings := Dict[String, Dict[String, String]] {}\n  mut uses := Dict[String, List[(String, Bool)]] {}\n  mut out := []\n  mut found := []\n  for (k, d) in enumerate(decls) {\n    if !pick(k) {\n      continue\n    }\n    if !contains(scopes, d.module) {\n      mut scopes.insert(d.module, resolve.scope_of(n, all, d.module))\n      mut imports.insert(d.module, resolve.imports_of(decls, d.module))\n      mut bindings.insert(\n        d.module,\n        resolve.bindings_of(decls, d.module),\n      )\n      mut uses.insert(d.module, resolve.uses_of(decls, d.module))\n    }\n    mut r := resolve.Rw {\n      visible: get(scopes, d.module) ?? Dict[String, String] {},\n      modules: n.modules,\n      methods: n.methods,\n      locals: [],\n      tparams: [],\n      shorten,\n      table: n.table,\n      unions,\n      module: d.module,\n      own: match d.kind {\n        ast.TypeDef(t) => resolve.qual(d, t.name),\n        _ => \"\",\n      },\n      imports: get(imports, d.module) ?? [],\n      bindings: get(bindings, d.module) ?? Dict[String, String] {},\n      uses: get(uses, d.module) ?? [],\n      found: [],\n      relocate: \"\",\n      own_modules: [],\n      collect: false,\n      names: [],\n      for_tests: match d.kind {\n        ast.TestDef(_) => true,\n        ast.TypeDef(t) => t.mocked,\n        ast.ImplDef(i) => {\n          head := resolve.type_head(i.for_type)\n          own_scope := get(scopes, d.module) ?? Dict[String, String] {}\n          q := get(own_scope, head) or {\n            if contains(head, \".\") {\n              head\n            } else {\n              resolve.qualified(d.module, head)\n            }\n          }\n          match get(n.table, q) {\n            Some(it) => it.fake,\n            None => false,\n          }\n        },\n        _ => false,\n      },\n    }\n    mut out.push(\n      ast.Decl { ..d, kind: resolve.decl_kind(mut r, d.kind) },\n    )\n    for e in r.found {\n      mut found.push((resolve.decl_name(d), e))\n    }\n  }\n  (out, found)\n}"},{"name":"resolve.union_members","kind":"fn","old":"0319b0754192214b","new":"5cbe9e0b488b90d6","interface_changed":false,"affected":[],"module":"resolve","text":"/// Resolves a union's bare members (`Dot` in `type Shape = Circle | Dot`).\n/// A member is the type of that name when one is in scope: defined earlier\n/// in the module or the root module, or imported. Otherwise the union\n/// declares it. Outside core, a member written with a payload and named like\n/// a prelude type or variant is that type, the payload its arguments\n/// (`Some(Int)` is `Some[Int]`). A union whose members are all such types is\n/// an alias of\n/// their union.\nfn union_members(decls: List[ast.Decl], core: builtins.Core) -> List[ast.Decl] {\n  if !decls.any(\n    d -> match d.kind {\n      ast.TypeDef(t) => resolve.is_bare(t, core),\n      _ => false,\n    },\n  ) {\n    return decls\n  }\n  mut defined := Dict[String, List[resolve.Defined]] {}\n  mut publics := Dict[String, Set[String]] {}\n  for (k, d) in enumerate(decls) {\n    mut names: List[(String, Bool)] = []\n    owner := match d.kind {\n      ast.TypeDef(t) => {\n        mut names.push((t.name, true))\n        match t.body {\n          ast.SumBody(vs) => {\n            for v in vs {\n              match v.payload {\n                ast.MemberType(_) => (),\n                ast.NoPayload => mut names.push((v.name, false)),\n                _ => mut names.push((v.name, true)),\n              }\n            }\n          },\n          _ => (),\n        }\n        resolve.last_part(t.name)\n      },\n      ast.ExternDef(ast.ExternDecl { item: ast.ExternType(x, _), .. }) => {\n        mut names.push((x, true))\n        \"\"\n      },\n      _ => \"\",\n    }\n    for nb in names {\n      mut defined.insert(\n        d.module,\n        (get(defined, d.module) ?? [])\n          + [resolve.Defined {\n            at: k,\n            name: resolve.last_part(nb.0),\n            always: nb.1,\n            owner,\n          }],\n      )\n      if d.public {\n        mut publics.insert(\n          d.module,\n          {\n            mut copy := get(publics, d.module) ?? Set[String] {}\n            mut copy.insert(resolve.last_part(nb.0))\n            copy\n          },\n        )\n      }\n    }\n  }\n  known := set(core.types_and_variants\n    + [\"Int\", \"Float\", \"Bool\", \"String\", \"List\", \"Set\", \"Dict\"])\n  root := get(defined, \"\") ?? []\n  mut out := []\n  for (k, d) in enumerate(decls) {\n    tb := match d.kind {\n      ast.TypeDef(t) => if resolve.is_bare(t, core) {\n        Some(t)\n      } else {\n        None\n      },\n      _ => None,\n    }\n    if tb is None {\n      mut out.push(d)\n      continue\n    }\n    t := tb or {\n      ast.TypeDecl {\n        distinct: false,\n        name: \"\",\n        params: [],\n        body: ast.Alias(ast.UnitType),\n        refinement: None,\n        mocked: false,\n      }\n    }\n    m := d.module\n    own := resolve.last_part(t.name)\n    seen := (ds: List[resolve.Defined], n: String) -> ds.any(\n      x -> x.name == n\n        && x.at != k\n        && x.owner != own\n        && (x.always || x.at < k),\n    )\n    imported := (n: String) ->\n      decls.any(\n        u ->\n          u.module == m\n            && match u.kind {\n              ast.UseDef(use_) => (use_.items ?? []).any(i -> i.alias ?? i.name == n),\n              _ => false,\n            },\n      )\n    in_scope := (n: String) -> contains(known, n)\n      || seen(get(defined, m) ?? [], n)\n      || m != \"\" && seen(root, n)\n      || imported(n)\n    vs := match t.body {\n      ast.SumBody(vs) => vs,\n      _ => [],\n    }\n    refs := vs.map(\n      v -> v.name != t.name\n        && match v.payload {\n          ast.NoPayload => contains(t.params, v.name) || in_scope(v.name),\n          ast.MemberType(_) => false,\n          // `Some(Int)`: the prelude's `Some[Int]`, outside core, which\n          // declares it\n          ast.Positional(_) => !starts_with(m, \"core.\")\n            && contains(core.types_and_variants, v.name),\n          _ => false,\n        },\n    )\n    if !refs.any(r -> r) {\n      mut out.push(d)\n      continue\n    }\n    members := [if r.1 {\n      ast.Variant { ..r.0, payload: ast.MemberType(\n        ast.Named { name: r.0.name, args: match r.0.payload {\n          ast.Positional(ts) => ts,\n          _ => [],\n        } },\n      ) }\n    } else {\n      r.0\n    } for r in zip(vs, refs)]\n    body := if members.all(v -> v.payload is ast.MemberType) {\n      ts := members.map(\n        v -> match v.payload {\n          ast.MemberType(x) => x,\n          _ => ast.UnitType,\n        },\n      )\n      ast.Alias(match ts {\n        [one] => one,\n        _ => ast.UnionType(ts),\n      })\n    } else {\n      ast.SumBody(members)\n    }\n    mut out.push(\n      ast.Decl { ..d, kind: ast.TypeDef(ast.TypeDecl { ..t, body }) },\n    )\n  }\n  out\n}","old_text":"/// Resolves a union's bare members (`Dot` in `type Shape = Circle | Dot`).\n/// A member is the type of that name when one is in scope: defined earlier\n/// in the module or the root module, or imported. Otherwise the union\n/// declares it. Outside core, a member written with a payload and named like\n/// a prelude type or variant is that type, the payload its arguments\n/// (`Some(Int)` is `Some[Int]`). A union whose members are all such types is\n/// an alias of\n/// their union.\nfn union_members(decls: List[ast.Decl], core: builtins.Core) -> List[ast.Decl] {\n  if !decls.any(\n    d -> match d.kind {\n      ast.TypeDef(t) => resolve.is_bare(t, core),\n      _ => false,\n    },\n  ) {\n    return decls\n  }\n  mut defined := Dict[String, List[resolve.Defined]] {}\n  mut publics := Dict[String, Set[String]] {}\n  for (k, d) in enumerate(decls) {\n    mut names: List[(String, Bool)] = []\n    owner := match d.kind {\n      ast.TypeDef(t) => {\n        mut names.push((t.name, true))\n        match t.body {\n          ast.SumBody(vs) => {\n            for v in vs {\n              match v.payload {\n                ast.MemberType(_) => (),\n                ast.NoPayload => mut names.push((v.name, false)),\n                _ => mut names.push((v.name, true)),\n              }\n            }\n          },\n          _ => (),\n        }\n        resolve.last_part(t.name)\n      },\n      ast.ExternDef(ast.ExternDecl { item: ast.ExternType(x, _), .. }) => {\n        mut names.push((x, true))\n        \"\"\n      },\n      _ => \"\",\n    }\n    for nb in names {\n      mut defined.insert(\n        d.module,\n        (get(defined, d.module) ?? [])\n          + [resolve.Defined {\n            at: k,\n            name: resolve.last_part(nb.0),\n            always: nb.1,\n            owner,\n          }],\n      )\n      if d.public {\n        mut publics.insert(\n          d.module,\n          {\n            mut copy := get(publics, d.module) ?? Set[String] {}\n            mut copy.insert(resolve.last_part(nb.0))\n            copy\n          },\n        )\n      }\n    }\n  }\n  known := set(core.types_and_variants\n    + [\"Int\", \"Float\", \"Bool\", \"String\", \"List\", \"Set\", \"Dict\"])\n  root := get(defined, \"\") ?? []\n  mut out := []\n  for (k, d) in enumerate(decls) {\n    tb := match d.kind {\n      ast.TypeDef(t) => if resolve.is_bare(t, core) {\n        Some(t)\n      } else {\n        None\n      },\n      _ => None,\n    }\n    if tb is None {\n      mut out.push(d)\n      continue\n    }\n    t := tb or {\n      ast.TypeDecl {\n        distinct: false,\n        name: \"\",\n        params: [],\n        body: ast.Alias(ast.UnitType),\n        refinement: None,\n        mocked: false,\n      }\n    }\n    m := d.module\n    own := resolve.last_part(t.name)\n    seen := (ds: List[resolve.Defined], n: String) -> ds.any(\n      x -> x.name == n\n        && x.at != k\n        && x.owner != own\n        && (x.always || x.at < k),\n    )\n    imported := (n: String) ->\n      decls.any(\n        u ->\n          u.module == m\n            && match u.kind {\n              ast.UseDef(use_) => (use_.items ?? []).any(i -> i.alias ?? i.name == n),\n              _ => false,\n            },\n      )\n    in_scope := (n: String) -> contains(known, n)\n      || seen(get(defined, m) ?? [], n)\n      || m != \"\" && seen(root, n)\n      || imported(n)\n    vs := match t.body {\n      ast.SumBody(vs) => vs,\n      _ => [],\n    }\n    refs := vs.map(\n      v -> v.name != t.name\n        && match v.payload {\n          ast.NoPayload => contains(t.params, v.name) || in_scope(v.name),\n          ast.MemberType(_) => false,\n          // `Some(Int)`: the prelude's `Some[Int]`, outside core, which\n          // declares it\n          ast.Positional(_) => !starts_with(m, \"core.\")\n            && contains(core.types_and_variants, v.name),\n          _ => false,\n        },\n    )\n    if !refs.any(r -> r) {\n      mut out.push(d)\n      continue\n    }\n    members := [if r.1 {\n      ast.Variant { ..r.0, payload: ast.MemberType(\n        ast.Named { name: r.0.name, args: match r.0.payload {\n          ast.Positional(ts) => ts,\n          _ => [],\n        } },\n      ) }\n    } else {\n      r.0\n    } for r in zip(vs, refs)]\n    body := if members.all(v -> v.payload is ast.MemberType) {\n      ts := members.map(\n        v -> match v.payload {\n          ast.MemberType(x) => x,\n          _ => ast.UnitType,\n        },\n      )\n      ast.Alias(match ts {\n        [one] => one,\n        _ => ast.UnionType(ts),\n      })\n    } else {\n      ast.SumBody(members)\n    }\n    mut out.push(\n      ast.Decl { ..d, kind: ast.TypeDef(ast.TypeDecl { ..t, body }) },\n    )\n  }\n  out\n}"},{"name":"resolve.named_type","kind":"fn","old":"2af8eecdb1cd2821","new":"c1b8859d9768e577","interface_changed":false,"affected":[],"module":"resolve","text":"fn named_type(\n  u: resolve.Unions,\n  module: String,\n  own: String,\n  t: ast.TypeExpr,\n) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => ast.Named {\n      name,\n      args: resolve.named_types(u, module, own, args),\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: resolve.named_types(u, module, own, params),\n      ret: resolve.named_type(u, module, own, ret),\n    },\n    ast.Refined { base, pred } => ast.Refined {\n      base: resolve.named_type(u, module, own, base),\n      pred,\n    },\n    ast.UnitType => ast.UnitType,\n    ast.RowType(fs) => ast.RowType(\n      fs.map(f -> (f.0, resolve.named_type(u, module, own, f.1))),\n    ),\n    ast.UnionType(given) => {\n      ms := resolve.named_types(u, module, own, given)\n      for g in u.generic {\n        if resolve.visible_in(g.0, module, own) {\n          match resolve.instance(ms, g.1, g.2) {\n            Some(args) => return ast.Named { name: g.0, args },\n            None => (),\n          }\n        }\n      }\n      whole := resolve.flat(u, ast.UnionType(ms), 0)\n      visible := resolve.visible_named(u, module, own)\n      for x in visible {\n        if x.1 == whole {\n          return ast.Named { name: x.0, args: [] }\n        }\n      }\n      maximal := resolve.maximal_parts(visible, whole)\n      overlap := resolve.overlapping(maximal)\n      if len(maximal) == 0 || overlap {\n        return ast.UnionType(ms)\n      }\n      mut out := []\n      mut placed := []\n      for m in ms {\n        one := resolve.flat(u, m, 0)\n        match maximal.find(x -> resolve.subset(one, x.1)) {\n          Some(x) => if !contains(placed, x.0) {\n            mut placed.push(x.0)\n            mut out.push(ast.Named { name: x.0, args: [] })\n          },\n          None => mut out.push(m),\n        }\n      }\n      ast.UnionType(out)\n    },\n  }\n}","old_text":"fn named_type(\n  u: resolve.Unions,\n  module: String,\n  own: String,\n  t: ast.TypeExpr,\n) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => ast.Named {\n      name,\n      args: resolve.named_types(u, module, own, args),\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: resolve.named_types(u, module, own, params),\n      ret: resolve.named_type(u, module, own, ret),\n    },\n    ast.Refined { base, pred } => ast.Refined {\n      base: resolve.named_type(u, module, own, base),\n      pred,\n    },\n    ast.UnitType => ast.UnitType,\n    ast.UnionType(given) => {\n      ms := resolve.named_types(u, module, own, given)\n      for g in u.generic {\n        if resolve.visible_in(g.0, module, own) {\n          match resolve.instance(ms, g.1, g.2) {\n            Some(args) => return ast.Named { name: g.0, args },\n            None => (),\n          }\n        }\n      }\n      whole := resolve.flat(u, ast.UnionType(ms), 0)\n      visible := resolve.visible_named(u, module, own)\n      for x in visible {\n        if x.1 == whole {\n          return ast.Named { name: x.0, args: [] }\n        }\n      }\n      maximal := resolve.maximal_parts(visible, whole)\n      overlap := resolve.overlapping(maximal)\n      if len(maximal) == 0 || overlap {\n        return ast.UnionType(ms)\n      }\n      mut out := []\n      mut placed := []\n      for m in ms {\n        one := resolve.flat(u, m, 0)\n        match maximal.find(x -> resolve.subset(one, x.1)) {\n          Some(x) => if !contains(placed, x.0) {\n            mut placed.push(x.0)\n            mut out.push(ast.Named { name: x.0, args: [] })\n          },\n          None => mut out.push(m),\n        }\n      }\n      ast.UnionType(out)\n    },\n  }\n}"},{"name":"smt.use ast","kind":"use","old":"5c06fbb2a4f4c0fa","new":"b3a2daaeb830ee16","interface_changed":true,"affected":[],"module":"smt","text":"from ast use Arm, CapabilityDef, TraitDef, ImplDef, TraitDecl, ImplDecl,\n  ExternDef, ExternDecl, Builtin, ExternFn, LamParam, Decl, FnDecl, TypeDecl,\n  TypeExpr, Expr, Stmt, Pattern, Param, StrPart, BinOp, FnDef, TypeDef, Named,\n  FnType, UnitType, Refined, UnionType, RowType, Alias, RecordBody, SumBody,\n  NoPayload, Positional, RecordPayload, MemberType, IntLit, BigIntLit, FloatLit,\n  TupleExpr, StrLit, BoolLit, UnitExpr, Var, Hole, ListExpr, CtorExpr, Call,\n  MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr,\n  MutExpr, Block, MockExpr, Return, Try, Except, Interp, Range, Index, Comp,\n  DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn, Await, Select, Race,\n  SupervisedSpawn, ValuePart, TextPart, Add, Sub, Mul, Div, Mod, Equal,\n  NotEqual, Less, LessEq, Greater, GreaterEq, And, Or, Implies, BitAnd, BitOr,\n  BitXor, Shl, Shr, Neg, Not, Let, VarDecl, Assign, While, For, Loop, Break,\n  Continue, ExprStmt, Assert, Comment, ComptimeFor, Invariant, Decreases, Wild,\n  Bind, IntPat, StrPat, BoolPat, CtorPattern, ListPat, TuplePat, CondPat, OrPat,\n  ForPat, CtorPat, NoPats, PositionalPats, RecordPats, TypePats, CtorArgs,\n  NoArgs, PositionalArgs, RecordArgs, UpdateArgs, TryResult, TryOption,\n  unassumed, AssertBy, Calc, calc_steps, calc_fact","old_text":"from ast use Arm, CapabilityDef, TraitDef, ImplDef, TraitDecl, ImplDecl,\n  ExternDef, ExternDecl, Builtin, ExternFn, LamParam, Decl, FnDecl, TypeDecl,\n  TypeExpr, Expr, Stmt, Pattern, Param, StrPart, BinOp, FnDef, TypeDef, Named,\n  FnType, UnitType, Refined, UnionType, Alias, RecordBody, SumBody, NoPayload,\n  Positional, RecordPayload, MemberType, IntLit, BigIntLit, FloatLit, TupleExpr,\n  StrLit, BoolLit, UnitExpr, Var, Hole, ListExpr, CtorExpr, Call, MethodCall,\n  FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr, MutExpr, Block,\n  MockExpr, Return, Try, Except, Interp, Range, Index, Comp, DictExpr, SetExpr,\n  Fallback, Comptime, Scope, Spawn, Await, Select, Race, SupervisedSpawn,\n  ValuePart, TextPart, Add, Sub, Mul, Div, Mod, Equal, NotEqual, Less, LessEq,\n  Greater, GreaterEq, And, Or, Implies, BitAnd, BitOr, BitXor, Shl, Shr, Neg,\n  Not, Let, VarDecl, Assign, While, For, Loop, Break, Continue, ExprStmt,\n  Assert, Comment, ComptimeFor, Invariant, Decreases, Wild, Bind, IntPat,\n  StrPat, BoolPat, CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat,\n  CtorPat, NoPats, PositionalPats, RecordPats, TypePats, CtorArgs, NoArgs,\n  PositionalArgs, RecordArgs, UpdateArgs, TryResult, TryOption, unassumed,\n  AssertBy, Calc, calc_steps, calc_fact"},{"name":"smt.shape","kind":"fn","old":"9ead924627052c83","new":"9b3e9058240cc514","interface_changed":false,"affected":[],"module":"smt","text":"/// A value of type `t` made of fresh unknowns, nothing assumed. Its outer\n/// level is built now, its structured parts are datatype terms.\nfn shape(mut vc: smt.Vc, t: ast.TypeExpr) -> smt.Val {\n  match t {\n    ast.Named { name, .. } => if smt.width_of(name) != None {\n      x := smt.fresh(mut vc, \"Int\")\n      mut vc.facts.push(smt.word_range(name, x))\n      return smt.word(name, x)\n    },\n    _ => (),\n  }\n  match t {\n    ast.Refined { base, .. } => smt.shape(mut vc, base),\n    ast.UnitType => smt.UnitVal,\n    ast.FnType { ret, .. } => smt.VFn { ret },\n    ast.RowType(_) => smt.Opaque(\n      \"a structural type (`{ f: T, .. }`) has no values of its own\",\n    ),\n    ast.UnionType(_) => match smt.sort_of(mut vc, t) {\n      Some(s) => {\n        x := smt.fresh(mut vc, s)\n        smt.unfold(mut vc, t, x)\n      },\n      None => smt.Opaque(\n        \"values of this union type are not modelled (members of overlapping or unknown shapes)\",\n      ),\n    },\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => {\n        // a variant as a type: a value of its sum with that tag\n        v := smt.shape(mut vc, ast.Named { name: p, args })\n        match v {\n          smt.VSum { tag, ctors, .. } => match smt.position(ctors, name) {\n            Some(k) => mut vc.facts.push(f\"(= {tag} {k})\"),\n            None => (),\n          },\n          _ => (),\n        }\n        v\n      },\n      None => match name {\n        \"Int\" => smt.VInt(smt.fresh(mut vc, \"Int\")),\n        \"Bool\" => smt.VBool(smt.fresh(mut vc, \"Bool\")),\n        \"String\" => smt.VStr(smt.fresh(mut vc, \"String\")),\n        \"Float\" => smt.Opaque(\"floats are not modelled yet\"),\n        \"List\" => {\n          l := smt.fresh(mut vc, \"Int\")\n          mut vc.facts.push(f\"(>= {l} 0)\")\n          smt.new_list(mut vc, l, match get(args, 0) {\n            Some(a) => smt.GType(a),\n            None => smt.Untracked,\n          })\n        },\n        // dicts and sets: an array of their entries (`map_sorts`)\n        \"Dict\" | \"Set\" => smt.fresh_keyed(mut vc, t),\n        \"Tuple\" => {\n          mut xs := []\n          for a in args {\n            mut xs.push(smt.shape(mut vc, a))\n          }\n          smt.VTuple(xs)\n        },\n        \"Task\" => smt.shape(mut vc, get(args, 0) ?? ast.UnitType),\n        _ => match get(vc.types, name) {\n          // a type parameter's values: terms of an uninterpreted sort\n          None => match smt.sort_of(mut vc, t) {\n            Some(sort) => smt.VData { ty: t, t: smt.fresh_why(\n              mut vc,\n              sort,\n              f\"values of the generic type `{name}` are not known\",\n            ) },\n            None => smt.Opaque(\n              f\"values of the generic type `{name}` are not known\",\n            ),\n          },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              ) }\n            } else {\n              smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              )\n            },\n            ast.RecordBody(_) => {\n              rc := get(smt.variants_of(vc, name, args) ?? [], 0) ?? smt.Ctor { name, fields: None, types: [] }\n              mut fs := []\n              for (k, f) in enumerate(rc.fields ?? []) {\n                mut fs.push(\n                  (\n                    f,\n                    smt.part(\n                      mut vc,\n                      get(rc.types, k) ?? ast.UnitType,\n                    ),\n                  ),\n                )\n              }\n              smt.VRec { name, fields: fs }\n            },\n            ast.SumBody(_) => {\n              vs := smt.variants_of(vc, name, args) ?? []\n              tag := smt.fresh(mut vc, \"Int\")\n              mut vc.facts.push(\n                f\"(and (<= 0 {tag}) (< {tag} {len(vs)}))\",\n              )\n              mut ctors := []\n              for c in vs {\n                mut payload := []\n                for ft in c.types {\n                  mut payload.push(smt.part(mut vc, ft))\n                }\n                mut ctors.push((c.name, payload))\n              }\n              smt.VSum { ty: name, args, tag, ctors }\n            },\n          },\n        },\n      },\n    },\n  }\n}","old_text":"/// A value of type `t` made of fresh unknowns, nothing assumed. Its outer\n/// level is built now, its structured parts are datatype terms.\nfn shape(mut vc: smt.Vc, t: ast.TypeExpr) -> smt.Val {\n  match t {\n    ast.Named { name, .. } => if smt.width_of(name) != None {\n      x := smt.fresh(mut vc, \"Int\")\n      mut vc.facts.push(smt.word_range(name, x))\n      return smt.word(name, x)\n    },\n    _ => (),\n  }\n  match t {\n    ast.Refined { base, .. } => smt.shape(mut vc, base),\n    ast.UnitType => smt.UnitVal,\n    ast.FnType { ret, .. } => smt.VFn { ret },\n    ast.UnionType(_) => match smt.sort_of(mut vc, t) {\n      Some(s) => {\n        x := smt.fresh(mut vc, s)\n        smt.unfold(mut vc, t, x)\n      },\n      None => smt.Opaque(\n        \"values of this union type are not modelled (members of overlapping or unknown shapes)\",\n      ),\n    },\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => {\n        // a variant as a type: a value of its sum with that tag\n        v := smt.shape(mut vc, ast.Named { name: p, args })\n        match v {\n          smt.VSum { tag, ctors, .. } => match smt.position(ctors, name) {\n            Some(k) => mut vc.facts.push(f\"(= {tag} {k})\"),\n            None => (),\n          },\n          _ => (),\n        }\n        v\n      },\n      None => match name {\n        \"Int\" => smt.VInt(smt.fresh(mut vc, \"Int\")),\n        \"Bool\" => smt.VBool(smt.fresh(mut vc, \"Bool\")),\n        \"String\" => smt.VStr(smt.fresh(mut vc, \"String\")),\n        \"Float\" => smt.Opaque(\"floats are not modelled yet\"),\n        \"List\" => {\n          l := smt.fresh(mut vc, \"Int\")\n          mut vc.facts.push(f\"(>= {l} 0)\")\n          smt.new_list(mut vc, l, match get(args, 0) {\n            Some(a) => smt.GType(a),\n            None => smt.Untracked,\n          })\n        },\n        // dicts and sets: an array of their entries (`map_sorts`)\n        \"Dict\" | \"Set\" => smt.fresh_keyed(mut vc, t),\n        \"Tuple\" => {\n          mut xs := []\n          for a in args {\n            mut xs.push(smt.shape(mut vc, a))\n          }\n          smt.VTuple(xs)\n        },\n        \"Task\" => smt.shape(mut vc, get(args, 0) ?? ast.UnitType),\n        _ => match get(vc.types, name) {\n          // a type parameter's values: terms of an uninterpreted sort\n          None => match smt.sort_of(mut vc, t) {\n            Some(sort) => smt.VData { ty: t, t: smt.fresh_why(\n              mut vc,\n              sort,\n              f\"values of the generic type `{name}` are not known\",\n            ) },\n            None => smt.Opaque(\n              f\"values of the generic type `{name}` are not known\",\n            ),\n          },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              ) }\n            } else {\n              smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              )\n            },\n            ast.RecordBody(_) => {\n              rc := get(smt.variants_of(vc, name, args) ?? [], 0) ?? smt.Ctor { name, fields: None, types: [] }\n              mut fs := []\n              for (k, f) in enumerate(rc.fields ?? []) {\n                mut fs.push(\n                  (\n                    f,\n                    smt.part(\n                      mut vc,\n                      get(rc.types, k) ?? ast.UnitType,\n                    ),\n                  ),\n                )\n              }\n              smt.VRec { name, fields: fs }\n            },\n            ast.SumBody(_) => {\n              vs := smt.variants_of(vc, name, args) ?? []\n              tag := smt.fresh(mut vc, \"Int\")\n              mut vc.facts.push(\n                f\"(and (<= 0 {tag}) (< {tag} {len(vs)}))\",\n              )\n              mut ctors := []\n              for c in vs {\n                mut payload := []\n                for ft in c.types {\n                  mut payload.push(smt.part(mut vc, ft))\n                }\n                mut ctors.push((c.name, payload))\n              }\n              smt.VSum { ty: name, args, tag, ctors }\n            },\n          },\n        },\n      },\n    },\n  }\n}"},{"name":"smt.subst","kind":"fn","old":"d8a07f3311e736fb","new":"e46d4086fc9328b0","interface_changed":false,"affected":[],"module":"smt","text":"/// `t` with each type parameter `sub` names replaced.\nfn subst(t: ast.TypeExpr, sub: Dict[String, ast.TypeExpr]) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => if len(args) == 0 && contains(sub, name) {\n      get(sub, name) ?? t\n    } else {\n      ast.Named { name, args: args.map(a -> smt.subst(a, sub)) }\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(p -> smt.subst(p, sub)),\n      ret: smt.subst(ret, sub),\n    },\n    ast.Refined { base, pred: p } => ast.Refined { base: smt.subst(base, sub), pred: p },\n    ast.RowType(fs) => ast.RowType(fs.map(f -> (f.0, smt.subst(f.1, sub)))),\n    ast.UnionType(ms) => ast.UnionType(ms.map(m -> smt.subst(m, sub))),\n    ast.UnitType => ast.UnitType,\n  }\n}","old_text":"/// `t` with each type parameter `sub` names replaced.\nfn subst(t: ast.TypeExpr, sub: Dict[String, ast.TypeExpr]) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => if len(args) == 0 && contains(sub, name) {\n      get(sub, name) ?? t\n    } else {\n      ast.Named { name, args: args.map(a -> smt.subst(a, sub)) }\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(p -> smt.subst(p, sub)),\n      ret: smt.subst(ret, sub),\n    },\n    ast.Refined { base, pred: p } => ast.Refined { base: smt.subst(base, sub), pred: p },\n    ast.UnionType(ms) => ast.UnionType(ms.map(m -> smt.subst(m, sub))),\n    ast.UnitType => ast.UnitType,\n  }\n}"},{"name":"smt.structured","kind":"fn","old":"c05cb44253554935","new":"d2ece955aee19f06","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether a value of `t` is more than one term (a record, sum or tuple).\nfn structured(vc: smt.Vc, t: ast.TypeExpr) -> Bool {\n  match smt.expand_alias(vc, t) {\n    ast.RowType(_) => false,\n    ast.UnionType(_) => true,\n    ast.UnitType | ast.FnType { .. } | ast.Refined { .. } => false,\n    ast.Named { name, .. } => match name {\n      \"Int\" | \"Bool\" | \"String\" | \"Float\" | \"List\" | \"Dict\" | \"Set\" => false,\n      \"Tuple\" => true,\n      _ => contains(vc.parents, name) || contains(vc.types, name),\n    },\n  }\n}","old_text":"/// Whether a value of `t` is more than one term (a record, sum or tuple).\nfn structured(vc: smt.Vc, t: ast.TypeExpr) -> Bool {\n  match smt.expand_alias(vc, t) {\n    ast.UnionType(_) => true,\n    ast.UnitType | ast.FnType { .. } | ast.Refined { .. } => false,\n    ast.Named { name, .. } => match name {\n      \"Int\" | \"Bool\" | \"String\" | \"Float\" | \"List\" | \"Dict\" | \"Set\" => false,\n      \"Tuple\" => true,\n      _ => contains(vc.parents, name) || contains(vc.types, name),\n    },\n  }\n}"},{"name":"smt.sort_type","kind":"fn","old":"5e45b8c721fd9609","new":"52476675d513ef2b","interface_changed":false,"affected":[],"module":"smt","text":"// ---- sorts ----\n\n/// `t` as far as its sort is concerned: refinements, aliases (distinct\n/// ones too), variants (to their sum) and tasks (to their result) looked\n/// through.\nfn sort_type(vc: smt.Vc, t: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Refined { base, .. } => smt.sort_type(vc, base),\n    ast.RowType(_) => t,\n    ast.UnionType(ms) => ast.UnionType(smt.flatten_all(vc, ms)),\n    ast.UnitType | ast.FnType { .. } => t,\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => smt.sort_type(vc, ast.Named { name: p, args }),\n      None => if name == \"Task\" && len(args) == 1 {\n        smt.sort_type(vc, get(args, 0) ?? ast.UnitType)\n      } else {\n        match get(vc.types, name) {\n          Some(td) => match td.body {\n            ast.Alias(a) => smt.sort_type(vc, smt.subst(a, smt.params_of(td, args))),\n            _ => ast.Named {\n              name,\n              args: args.map(a -> smt.sort_type(vc, a)),\n            },\n          },\n          None => ast.Named {\n            name,\n            args: args.map(a -> smt.sort_type(vc, a)),\n          },\n        }\n      },\n    },\n  }\n}","old_text":"// ---- sorts ----\n\n/// `t` as far as its sort is concerned: refinements, aliases (distinct\n/// ones too), variants (to their sum) and tasks (to their result) looked\n/// through.\nfn sort_type(vc: smt.Vc, t: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Refined { base, .. } => smt.sort_type(vc, base),\n    ast.UnionType(ms) => ast.UnionType(smt.flatten_all(vc, ms)),\n    ast.UnitType | ast.FnType { .. } => t,\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => smt.sort_type(vc, ast.Named { name: p, args }),\n      None => if name == \"Task\" && len(args) == 1 {\n        smt.sort_type(vc, get(args, 0) ?? ast.UnitType)\n      } else {\n        match get(vc.types, name) {\n          Some(td) => match td.body {\n            ast.Alias(a) => smt.sort_type(vc, smt.subst(a, smt.params_of(td, args))),\n            _ => ast.Named {\n              name,\n              args: args.map(a -> smt.sort_type(vc, a)),\n            },\n          },\n          None => ast.Named {\n            name,\n            args: args.map(a -> smt.sort_type(vc, a)),\n          },\n        }\n      },\n    },\n  }\n}"},{"name":"smt.sort_of","kind":"fn","old":"e17abba7c5f54497","new":"a20bca6d5f86fb8d","interface_changed":false,"affected":[],"module":"smt","text":"/// The SMT sort of the values of `t`.\nfn sort_of(mut vc: smt.Vc, t: ast.TypeExpr) -> Option[String] {\n  if smt.sized(t) {\n    return Some(\"Int\")\n  }\n  st := smt.sort_type(vc, t)\n  match st {\n    ast.UnitType => {\n      match smt.new_datatype(mut vc, \"T:Unit\") {\n        Some(i) => smt.set_datatype(mut vc, i, [(\"T:Unit.unit\", [])]),\n        None => (),\n      }\n      Some(smt.sym(\"T:Unit\"))\n    },\n    ast.FnType { .. } => Some(smt.opaque_sort(mut vc, \"Fn\")),\n    ast.Refined { base, .. } => smt.sort_of(mut vc, base),\n    ast.RowType(_) => Some(smt.opaque_sort(mut vc, \"Row\")),\n    ast.UnionType(ms) => {\n      gs := smt.union_groups(vc, ms)?\n      mut sorts := []\n      for g in gs {\n        mut sorts.push(smt.field_sort(mut vc, g.ty))\n      }\n      n := \"T:Union(\" + smt.bare(join(sorts, \",\")) + \")\"\n      match smt.new_datatype(mut vc, n) {\n        Some(i) => {\n          mut cs := []\n          for (k, s) in enumerate(sorts) {\n            mut cs.push((n + \".\" + f\"{k}\", [s]))\n          }\n          smt.set_datatype(mut vc, i, cs)\n        },\n        None => (),\n      }\n      Some(smt.sym(n))\n    },\n    ast.Named { name, args } => match name {\n      \"Int\" | \"Bool\" | \"String\" => Some(name),\n      \"Dict\" | \"Set\" => match smt.map_sorts(mut vc, st) {\n        Some(ms) => Some(ms.arr),\n        None => Some(smt.opaque_sort(mut vc, name)),\n      },\n      \"Float\" | \"_\" => Some(smt.opaque_sort(mut vc, name)),\n      \"List\" => match get(args, 0) {\n        Some(a) => {\n          item := smt.field_sort(mut vc, a)\n          n := \"T:List(\" + smt.bare(item) + \")\"\n          if !contains(vc.sort_index, n) {\n            mut vc.sort_index.insert(n, len(vc.sorts))\n            mut vc.sorts.push((n, smt.ListSort(item)))\n          }\n          Some(smt.sym(n))\n        },\n        None => Some(smt.opaque_sort(mut vc, \"List\")),\n      },\n      \"Tuple\" => {\n        n := smt.dt_name(st)\n        match smt.new_datatype(mut vc, n) {\n          Some(i) => {\n            mut fs := []\n            for a in args {\n              mut fs.push(smt.field_sort(mut vc, a))\n            }\n            smt.set_datatype(mut vc, i, [(n + \".mk\", fs)])\n          },\n          None => (),\n        }\n        Some(smt.sym(n))\n      },\n      // (a datatype declared already: its constructors aren't made again)\n      _ => if contains(vc.sort_index, smt.dt_name(st)) {\n        Some(smt.sym(smt.dt_name(st)))\n      } else {\n        match smt.variants_of(vc, name, args) {\n          Some(vs) => {\n            n := smt.dt_name(st)\n            match smt.new_datatype(mut vc, n) {\n              Some(i) => {\n                mut cs := []\n                for c in vs {\n                  mut fs := []\n                  for ft in c.types {\n                    mut fs.push(smt.field_sort(mut vc, ft))\n                  }\n                  mut cs.push((n + \".\" + c.name, fs))\n                }\n                smt.set_datatype(mut vc, i, cs)\n              },\n              None => (),\n            }\n            Some(smt.sym(n))\n          },\n          None => Some(smt.opaque_sort(mut vc, text.type_text(st))),\n        }\n      },\n    },\n  }\n}","old_text":"/// The SMT sort of the values of `t`.\nfn sort_of(mut vc: smt.Vc, t: ast.TypeExpr) -> Option[String] {\n  if smt.sized(t) {\n    return Some(\"Int\")\n  }\n  st := smt.sort_type(vc, t)\n  match st {\n    ast.UnitType => {\n      match smt.new_datatype(mut vc, \"T:Unit\") {\n        Some(i) => smt.set_datatype(mut vc, i, [(\"T:Unit.unit\", [])]),\n        None => (),\n      }\n      Some(smt.sym(\"T:Unit\"))\n    },\n    ast.FnType { .. } => Some(smt.opaque_sort(mut vc, \"Fn\")),\n    ast.Refined { base, .. } => smt.sort_of(mut vc, base),\n    ast.UnionType(ms) => {\n      gs := smt.union_groups(vc, ms)?\n      mut sorts := []\n      for g in gs {\n        mut sorts.push(smt.field_sort(mut vc, g.ty))\n      }\n      n := \"T:Union(\" + smt.bare(join(sorts, \",\")) + \")\"\n      match smt.new_datatype(mut vc, n) {\n        Some(i) => {\n          mut cs := []\n          for (k, s) in enumerate(sorts) {\n            mut cs.push((n + \".\" + f\"{k}\", [s]))\n          }\n          smt.set_datatype(mut vc, i, cs)\n        },\n        None => (),\n      }\n      Some(smt.sym(n))\n    },\n    ast.Named { name, args } => match name {\n      \"Int\" | \"Bool\" | \"String\" => Some(name),\n      \"Dict\" | \"Set\" => match smt.map_sorts(mut vc, st) {\n        Some(ms) => Some(ms.arr),\n        None => Some(smt.opaque_sort(mut vc, name)),\n      },\n      \"Float\" | \"_\" => Some(smt.opaque_sort(mut vc, name)),\n      \"List\" => match get(args, 0) {\n        Some(a) => {\n          item := smt.field_sort(mut vc, a)\n          n := \"T:List(\" + smt.bare(item) + \")\"\n          if !contains(vc.sort_index, n) {\n            mut vc.sort_index.insert(n, len(vc.sorts))\n            mut vc.sorts.push((n, smt.ListSort(item)))\n          }\n          Some(smt.sym(n))\n        },\n        None => Some(smt.opaque_sort(mut vc, \"List\")),\n      },\n      \"Tuple\" => {\n        n := smt.dt_name(st)\n        match smt.new_datatype(mut vc, n) {\n          Some(i) => {\n            mut fs := []\n            for a in args {\n              mut fs.push(smt.field_sort(mut vc, a))\n            }\n            smt.set_datatype(mut vc, i, [(n + \".mk\", fs)])\n          },\n          None => (),\n        }\n        Some(smt.sym(n))\n      },\n      // (a datatype declared already: its constructors aren't made again)\n      _ => if contains(vc.sort_index, smt.dt_name(st)) {\n        Some(smt.sym(smt.dt_name(st)))\n      } else {\n        match smt.variants_of(vc, name, args) {\n          Some(vs) => {\n            n := smt.dt_name(st)\n            match smt.new_datatype(mut vc, n) {\n              Some(i) => {\n                mut cs := []\n                for c in vs {\n                  mut fs := []\n                  for ft in c.types {\n                    mut fs.push(smt.field_sort(mut vc, ft))\n                  }\n                  mut cs.push((n + \".\" + c.name, fs))\n                }\n                smt.set_datatype(mut vc, i, cs)\n              },\n              None => (),\n            }\n            Some(smt.sym(n))\n          },\n          None => Some(smt.opaque_sort(mut vc, text.type_text(st))),\n        }\n      },\n    },\n  }\n}"},{"name":"smt.from_term","kind":"fn","old":"eaf75d058dabdbd4","new":"d58f612843c63f2d","interface_changed":false,"affected":[],"module":"smt","text":"/// The value a term of type `ty` stands for: a plain value for `Int`,\n/// `Bool`, `String`, and a `VData` (unfolded when read) for a structured\n/// one.\nfn from_term(mut vc: smt.Vc, ty: ast.TypeExpr, t: String) -> smt.Val {\n  match ty {\n    ast.Named { name, .. } => if smt.width_of(name) != None {\n      mut vc.facts.push(smt.word_range(name, t))\n      return smt.word(name, t)\n    },\n    _ => (),\n  }\n  match ty {\n    ast.Refined { base, .. } => smt.from_term(mut vc, base, t),\n    ast.UnitType => smt.UnitVal,\n    ast.FnType { ret, .. } => smt.VFn { ret },\n    ast.RowType(_) => smt.Opaque(\n      \"a structural type (`{ f: T, .. }`) has no values of its own\",\n    ),\n    ast.UnionType(_) => match smt.sort_of(mut vc, ty) {\n      Some(_) => smt.VData { ty, t },\n      None => smt.Opaque(\n        \"values of this union type are not modelled (members of overlapping or unknown shapes)\",\n      ),\n    },\n    ast.Named { name, args } => match name {\n      \"Int\" => smt.VInt(t),\n      \"Bool\" => smt.VBool(t),\n      \"String\" => {\n        if !contains(vc.str_terms, t) {\n          mut vc.str_terms.push(t)\n        }\n        smt.VStr(t)\n      },\n      \"Float\" => smt.Opaque(\"floats are not modelled yet\"),\n      \"List\" => match get(args, 0) {\n        Some(a) => {\n          n := smt.bare(smt.sort_of(mut vc, ty) ?? \"\")\n          l := smt.seq_len(n, t)\n          smt.define(mut vc, f\"(>= {l} 0)\", t)\n          smt.new_list(mut vc, l, smt.GSeq(t, a, n))\n        },\n        None => smt.Opaque(\"a list of unknown elements\"),\n      },\n      \"Dict\" | \"Set\" => match smt.map_sorts(mut vc, ty) {\n        Some(ms) => smt.keyed_array(mut vc, ty, ms, t),\n        None => {\n          l := smt.fresh_why(\n            mut vc,\n            \"Int\",\n            \"dicts and sets of these types are not modelled\",\n          )\n          mut vc.facts.push(f\"(>= {l} 0)\")\n          smt.keyed_list(mut vc, l, ty)\n        },\n      },\n      \"Task\" => smt.from_term(mut vc, get(args, 0) ?? ast.UnitType, t),\n      \"Tuple\" => smt.VData { ty, t },\n      _ => if contains(vc.parents, name) {\n        smt.VData { ty, t }\n      } else {\n        match get(vc.types, name) {\n          None => smt.VData { ty, t },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              ) }\n            } else {\n              smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              )\n            },\n            _ => smt.VData { ty, t },\n          },\n        }\n      },\n    },\n  }\n}","old_text":"/// The value a term of type `ty` stands for: a plain value for `Int`,\n/// `Bool`, `String`, and a `VData` (unfolded when read) for a structured\n/// one.\nfn from_term(mut vc: smt.Vc, ty: ast.TypeExpr, t: String) -> smt.Val {\n  match ty {\n    ast.Named { name, .. } => if smt.width_of(name) != None {\n      mut vc.facts.push(smt.word_range(name, t))\n      return smt.word(name, t)\n    },\n    _ => (),\n  }\n  match ty {\n    ast.Refined { base, .. } => smt.from_term(mut vc, base, t),\n    ast.UnitType => smt.UnitVal,\n    ast.FnType { ret, .. } => smt.VFn { ret },\n    ast.UnionType(_) => match smt.sort_of(mut vc, ty) {\n      Some(_) => smt.VData { ty, t },\n      None => smt.Opaque(\n        \"values of this union type are not modelled (members of overlapping or unknown shapes)\",\n      ),\n    },\n    ast.Named { name, args } => match name {\n      \"Int\" => smt.VInt(t),\n      \"Bool\" => smt.VBool(t),\n      \"String\" => {\n        if !contains(vc.str_terms, t) {\n          mut vc.str_terms.push(t)\n        }\n        smt.VStr(t)\n      },\n      \"Float\" => smt.Opaque(\"floats are not modelled yet\"),\n      \"List\" => match get(args, 0) {\n        Some(a) => {\n          n := smt.bare(smt.sort_of(mut vc, ty) ?? \"\")\n          l := smt.seq_len(n, t)\n          smt.define(mut vc, f\"(>= {l} 0)\", t)\n          smt.new_list(mut vc, l, smt.GSeq(t, a, n))\n        },\n        None => smt.Opaque(\"a list of unknown elements\"),\n      },\n      \"Dict\" | \"Set\" => match smt.map_sorts(mut vc, ty) {\n        Some(ms) => smt.keyed_array(mut vc, ty, ms, t),\n        None => {\n          l := smt.fresh_why(\n            mut vc,\n            \"Int\",\n            \"dicts and sets of these types are not modelled\",\n          )\n          mut vc.facts.push(f\"(>= {l} 0)\")\n          smt.keyed_list(mut vc, l, ty)\n        },\n      },\n      \"Task\" => smt.from_term(mut vc, get(args, 0) ?? ast.UnitType, t),\n      \"Tuple\" => smt.VData { ty, t },\n      _ => if contains(vc.parents, name) {\n        smt.VData { ty, t }\n      } else {\n        match get(vc.types, name) {\n          None => smt.VData { ty, t },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              ) }\n            } else {\n              smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              )\n            },\n            _ => smt.VData { ty, t },\n          },\n        }\n      },\n    },\n  }\n}"},{"name":"smt.unfold","kind":"fn","old":"4148411e24ea56cd","new":"09a09068c0098ed3","interface_changed":false,"affected":[],"module":"smt","text":"/// One level of term `t` of type `ty`: a record's fields, a sum's tag and\n/// payloads, a tuple's items, each a selector of `t`. Facts from its type\n/// (a variant's constructor, its validity's definition) are stated the\n/// first time.\nfn unfold(mut vc: smt.Vc, ty: ast.TypeExpr, t: String) -> smt.Val {\n  key := text.type_text(ty) + \" \" + t\n  global := len(vc.regions) == 0 && !contains(t, \"@@\")\n  if global {\n    match get(vc.unfolded, key) {\n      Some(v) => return v,\n      None => (),\n    }\n  }\n  sort := match smt.sort_of(mut vc, ty) {\n    Some(s) => s,\n    None => return smt.Opaque(\"values of this type are not modelled\"),\n  }\n  cs := smt.ctors_of(vc, sort)\n  tag := if len(cs) == 1 {\n    \"0\"\n  } else {\n    \"(\" + smt.sym(smt.bare(sort) + \".tag\") + \" \" + t + \")\"\n  }\n  mut facts := []\n  v := match ty {\n    ast.Refined { base, .. } => return smt.unfold(mut vc, base, t),\n    ast.UnitType | ast.FnType { .. } => return smt.from_term(mut vc, ty, t),\n    ast.RowType(_) => return smt.Opaque(\n      \"a structural type (`{ f: T, .. }`) has no values of its own\",\n    ),\n    ast.UnionType(ms) => match smt.union_groups(vc, ms) {\n      None => return smt.Opaque(\"values of this union type are not modelled\"),\n      Some(gs) => {\n        mut slots := []\n        for (i, g) in enumerate(gs) {\n          s := smt.selector((get(cs, i) ?? (\"\", [])).0, 0, t)\n          match g.only {\n            // a sum's variants: the member's constructor is one of them\n            Some(only) => {\n              inner := smt.sort_of(mut vc, g.ty) ?? \"\"\n              iname := smt.bare(inner)\n              tests := smt.ctors_of(vc, inner)\n                .filter(ic -> only.any(o -> ic.0 == iname + \".\" + o))\n                .map(ic -> \"((_ is \" + smt.sym(ic.0) + \") \" + s + \")\")\n              mut facts.push(\n                smt.implies(f\"(= {tag} {i})\", smt.or_all(tests)),\n              )\n            },\n            None => (),\n          }\n          mut slots.push((g.key, smt.from_term(mut vc, g.ty, s)))\n        }\n        smt.VUnion { tag, slots }\n      },\n    },\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => {\n        pv := smt.unfold(mut vc, ast.Named { name: p, args }, t)\n        c := smt.bare(sort) + \".\" + name\n        if cs.any(x -> x.0 == c) {\n          mut facts.push(f\"((_ is {smt.sym(c)}) {t})\")\n        }\n        pv\n      },\n      None => if name == \"Tuple\" {\n        c := (get(cs, 0) ?? (\"\", [])).0\n        mut xs := []\n        for (k, a) in enumerate(args) {\n          mut xs.push(smt.from_term(mut vc, a, smt.selector(c, k, t)))\n        }\n        smt.VTuple(xs)\n      } else if name == \"Task\" {\n        return smt.unfold(mut vc, get(args, 0) ?? ast.UnitType, t)\n      } else {\n        match get(vc.types, name) {\n          // a type parameter's value: a term of an uninterpreted sort.\n          // Equal terms are the same value, so a method's result on it is\n          // the same (`Counter::total(c)`).\n          None => return smt.VData { ty: ast.Named { name, args }, t },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              ) }\n            } else {\n              return smt.unfold(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              )\n            },\n            ast.RecordBody(_) => {\n              c := (get(cs, 0) ?? (\"\", [])).0\n              rc := get(smt.variants_of(vc, name, args) ?? [], 0) ?? smt.Ctor { name, fields: None, types: [] }\n              mut fs := []\n              for (k, f) in enumerate(rc.fields ?? []) {\n                ft := get(rc.types, k) ?? ast.UnitType\n                mut fs.push(\n                  (\n                    f,\n                    smt.from_term(mut vc, ft, smt.selector(c, k, t)),\n                  ),\n                )\n              }\n              smt.VRec { name, fields: fs }\n            },\n            ast.SumBody(_) => {\n              mut ctors := []\n              for (i, v) in enumerate(smt.variants_of(vc, name, args) ?? []) {\n                c := (get(cs, i) ?? (\"\", [])).0\n                mut payload := []\n                for (k, ft) in enumerate(v.types) {\n                  mut payload.push(\n                    smt.from_term(mut vc, ft, smt.selector(c, k, t)),\n                  )\n                }\n                mut ctors.push((v.name, payload))\n              }\n              smt.VSum { ty: name, args, tag, ctors }\n            },\n          },\n        }\n      },\n    },\n  }\n  if global {\n    mut vc.unfolded.insert(key, v)\n  }\n  for f in facts {\n    smt.define(mut vc, f, t)\n  }\n  if smt.refined(vc, ty) {\n    // what \"valid\" means for this term: its level checked, its parts by\n    // their own predicates\n    vt := smt.valid_term(mut vc, ty, t)\n    if !global || !contains(vc.defined, vt) {\n      if global {\n        mut vc.defined.insert(vt)\n      }\n      pc := vc.pc\n      checking := vc.checking\n      proving := vc.proving\n      dead := vc.dead\n      vc.pc = []\n      vc.checking = []\n      vc.proving = 0\n      vc.dead = false\n      vc.spec += 1\n      // a definition: both directions\n      pol := vc.polarity\n      vc.polarity = 0\n      c := smt.check_type(mut vc, ty, v, [])\n      vc.polarity = pol\n      vc.spec -= 1\n      vc.dead = dead\n      vc.proving = proving\n      vc.checking = checking\n      vc.pc = pc\n      smt.define(mut vc, smt.let_term(f\"(= {vt} {c})\", t), t)\n    }\n  }\n  v\n}","old_text":"/// One level of term `t` of type `ty`: a record's fields, a sum's tag and\n/// payloads, a tuple's items, each a selector of `t`. Facts from its type\n/// (a variant's constructor, its validity's definition) are stated the\n/// first time.\nfn unfold(mut vc: smt.Vc, ty: ast.TypeExpr, t: String) -> smt.Val {\n  key := text.type_text(ty) + \" \" + t\n  global := len(vc.regions) == 0 && !contains(t, \"@@\")\n  if global {\n    match get(vc.unfolded, key) {\n      Some(v) => return v,\n      None => (),\n    }\n  }\n  sort := match smt.sort_of(mut vc, ty) {\n    Some(s) => s,\n    None => return smt.Opaque(\"values of this type are not modelled\"),\n  }\n  cs := smt.ctors_of(vc, sort)\n  tag := if len(cs) == 1 {\n    \"0\"\n  } else {\n    \"(\" + smt.sym(smt.bare(sort) + \".tag\") + \" \" + t + \")\"\n  }\n  mut facts := []\n  v := match ty {\n    ast.Refined { base, .. } => return smt.unfold(mut vc, base, t),\n    ast.UnitType | ast.FnType { .. } => return smt.from_term(mut vc, ty, t),\n    ast.UnionType(ms) => match smt.union_groups(vc, ms) {\n      None => return smt.Opaque(\"values of this union type are not modelled\"),\n      Some(gs) => {\n        mut slots := []\n        for (i, g) in enumerate(gs) {\n          s := smt.selector((get(cs, i) ?? (\"\", [])).0, 0, t)\n          match g.only {\n            // a sum's variants: the member's constructor is one of them\n            Some(only) => {\n              inner := smt.sort_of(mut vc, g.ty) ?? \"\"\n              iname := smt.bare(inner)\n              tests := smt.ctors_of(vc, inner)\n                .filter(ic -> only.any(o -> ic.0 == iname + \".\" + o))\n                .map(ic -> \"((_ is \" + smt.sym(ic.0) + \") \" + s + \")\")\n              mut facts.push(\n                smt.implies(f\"(= {tag} {i})\", smt.or_all(tests)),\n              )\n            },\n            None => (),\n          }\n          mut slots.push((g.key, smt.from_term(mut vc, g.ty, s)))\n        }\n        smt.VUnion { tag, slots }\n      },\n    },\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => {\n        pv := smt.unfold(mut vc, ast.Named { name: p, args }, t)\n        c := smt.bare(sort) + \".\" + name\n        if cs.any(x -> x.0 == c) {\n          mut facts.push(f\"((_ is {smt.sym(c)}) {t})\")\n        }\n        pv\n      },\n      None => if name == \"Tuple\" {\n        c := (get(cs, 0) ?? (\"\", [])).0\n        mut xs := []\n        for (k, a) in enumerate(args) {\n          mut xs.push(smt.from_term(mut vc, a, smt.selector(c, k, t)))\n        }\n        smt.VTuple(xs)\n      } else if name == \"Task\" {\n        return smt.unfold(mut vc, get(args, 0) ?? ast.UnitType, t)\n      } else {\n        match get(vc.types, name) {\n          // a type parameter's value: a term of an uninterpreted sort.\n          // Equal terms are the same value, so a method's result on it is\n          // the same (`Counter::total(c)`).\n          None => return smt.VData { ty: ast.Named { name, args }, t },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              ) }\n            } else {\n              return smt.unfold(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              )\n            },\n            ast.RecordBody(_) => {\n              c := (get(cs, 0) ?? (\"\", [])).0\n              rc := get(smt.variants_of(vc, name, args) ?? [], 0) ?? smt.Ctor { name, fields: None, types: [] }\n              mut fs := []\n              for (k, f) in enumerate(rc.fields ?? []) {\n                ft := get(rc.types, k) ?? ast.UnitType\n                mut fs.push(\n                  (\n                    f,\n                    smt.from_term(mut vc, ft, smt.selector(c, k, t)),\n                  ),\n                )\n              }\n              smt.VRec { name, fields: fs }\n            },\n            ast.SumBody(_) => {\n              mut ctors := []\n              for (i, v) in enumerate(smt.variants_of(vc, name, args) ?? []) {\n                c := (get(cs, i) ?? (\"\", [])).0\n                mut payload := []\n                for (k, ft) in enumerate(v.types) {\n                  mut payload.push(\n                    smt.from_term(mut vc, ft, smt.selector(c, k, t)),\n                  )\n                }\n                mut ctors.push((v.name, payload))\n              }\n              smt.VSum { ty: name, args, tag, ctors }\n            },\n          },\n        }\n      },\n    },\n  }\n  if global {\n    mut vc.unfolded.insert(key, v)\n  }\n  for f in facts {\n    smt.define(mut vc, f, t)\n  }\n  if smt.refined(vc, ty) {\n    // what \"valid\" means for this term: its level checked, its parts by\n    // their own predicates\n    vt := smt.valid_term(mut vc, ty, t)\n    if !global || !contains(vc.defined, vt) {\n      if global {\n        mut vc.defined.insert(vt)\n      }\n      pc := vc.pc\n      checking := vc.checking\n      proving := vc.proving\n      dead := vc.dead\n      vc.pc = []\n      vc.checking = []\n      vc.proving = 0\n      vc.dead = false\n      vc.spec += 1\n      // a definition: both directions\n      pol := vc.polarity\n      vc.polarity = 0\n      c := smt.check_type(mut vc, ty, v, [])\n      vc.polarity = pol\n      vc.spec -= 1\n      vc.dead = dead\n      vc.proving = proving\n      vc.checking = checking\n      vc.pc = pc\n      smt.define(mut vc, smt.let_term(f\"(= {vt} {c})\", t), t)\n    }\n  }\n  v\n}"},{"name":"smt.erased","kind":"fn","old":"8ada746cc3a46a6e","new":"70c0a17db99a4f51","interface_changed":false,"affected":[],"module":"smt","text":"/// `t` with the type arguments that add no refinement replaced by `_`.\nfn erased(vc: smt.Vc, t: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => ast.Named { name, args: args.map(\n      a ->\n        if smt.refined(vc, a) && !smt.valid_by_construction(vc, a) {\n          smt.erased(vc, a)\n        } else {\n          smt.named(\"_\")\n        },\n    ) },\n    ast.Refined { base, pred: p } => ast.Refined { base: smt.erased(vc, base), pred: p },\n    ast.RowType(fs) => ast.RowType(fs.map(f -> (f.0, smt.erased(vc, f.1)))),\n    ast.UnionType(ms) => ast.UnionType(ms.map(m -> smt.erased(vc, m))),\n    _ => t,\n  }\n}","old_text":"/// `t` with the type arguments that add no refinement replaced by `_`.\nfn erased(vc: smt.Vc, t: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => ast.Named { name, args: args.map(\n      a ->\n        if smt.refined(vc, a) && !smt.valid_by_construction(vc, a) {\n          smt.erased(vc, a)\n        } else {\n          smt.named(\"_\")\n        },\n    ) },\n    ast.Refined { base, pred: p } => ast.Refined { base: smt.erased(vc, base), pred: p },\n    ast.UnionType(ms) => ast.UnionType(ms.map(m -> smt.erased(vc, m))),\n    _ => t,\n  }\n}"},{"name":"smt.check_type_at","kind":"fn","old":"6884bf2ccbe8f103","new":"944540f479bfb08a","interface_changed":false,"affected":[],"module":"smt","text":"fn check_type_at(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  v: smt.Val,\n  extra: List[(String, smt.Val)],\n) -> String {\n  if smt.is_absent(v) || !smt.refined(vc, t) {\n    return \"true\"\n  }\n  match v {\n    smt.Opaque(r) => return smt.unknown_bool(mut vc, r),\n    // a union value against one type (a narrowed value passed on): its\n    // active member must be of that type\n    smt.VUnion { .. } => if !smt.union_or_refined(t) && !smt.is_alias(vc, t) {\n      return smt.in_type(mut vc, t, v, extra)\n    },\n    _ => (),\n  }\n  match t {\n    // valid for a union: a valid value of one of its members\n    ast.RowType(_) => \"true\",\n    ast.UnionType(ms) => {\n      mut cs := []\n      for m in ms {\n        mut cs.push(smt.in_type(mut vc, m, v, extra))\n      }\n      smt.or_all(cs)\n    },\n    ast.Refined { base, pred: p } => {\n      a := smt.check_type(mut vc, base, v, extra)\n      c := smt.pred(mut vc, p, extra + [(\"it\", v)])\n      smt.and_all([a, c])\n    },\n    ast.UnitType | ast.FnType { .. } => \"true\",\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => {\n        c := smt.check_type(\n          mut vc,\n          ast.Named { name: p, args },\n          v,\n          extra,\n        )\n        match v {\n          smt.VSum { tag, ctors, .. } => match smt.position(ctors, name) {\n            Some(k) => smt.and_all([f\"(= {tag} {k})\", c]),\n            None => \"false\",\n          },\n          _ => smt.unknown_bool(mut vc, \"a value of an unexpected shape\"),\n        }\n      },\n      None => match (name, v) {\n        (\"List\", smt.VList { len, id }) => match get(args, 0) {\n          None => \"true\",\n          Some(t) => match smt.list_info(vc, id).source {\n            // a sequence of a datatype value: its own predicate\n            smt.GSeq(s, et, _) => if smt.erased(vc, et) == smt.erased(vc, t) {\n              smt.valid_term(\n                mut vc,\n                ast.Named { name: \"List\", args: [et] },\n                s,\n              )\n            } else {\n              smt.list_valid(mut vc, len, id, t, v)\n            },\n            _ => smt.list_valid(mut vc, len, id, t, v),\n          },\n        },\n        (\"Tuple\", smt.VTuple(xs)) => {\n          mut cs := []\n          for (i, a) in enumerate(args) {\n            match get(xs, i) {\n              Some(x) => mut cs.push(smt.check_type(mut vc, a, x, [])),\n              None => (),\n            }\n          }\n          smt.and_all(cs)\n        },\n        // a dict's or set's array: its predicate, which each operation\n        // preserves (`map_valid`)\n        // (an array of another sort, a generic callee's `Dict[K, Entry[P]]`\n        // where `Entry[Int]` is wanted, can't be checked as one)\n        (\"Dict\", smt.VList { id, .. }) | (\"Set\", smt.VList { id, .. }) => match get(vc.arrays, id) {\n          Some(a) => if smt.same_sort(\n            mut vc,\n            vc.keyed,\n            id,\n            ast.Named { name, args },\n          ) {\n            smt.valid_term(mut vc, ast.Named { name, args }, a)\n          } else {\n            smt.unknown_bool(\n              mut vc,\n              \"a dict or set of a generic function's result whose type arguments the call doesn't tell\",\n            )\n          },\n          None => smt.unknown_bool(\n            mut vc,\n            \"a dict or set of types not modelled\",\n          ),\n        },\n        (\"Dict\", _) | (\"Set\", _) => smt.unknown_bool(\n          mut vc,\n          \"a dict or set of types not modelled\",\n        ),\n        _ => match get(vc.types, name) {\n          None => \"true\",\n          Some(td) => smt.check_named(mut vc, name, args, td, v),\n        },\n      },\n    },\n  }\n}","old_text":"fn check_type_at(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  v: smt.Val,\n  extra: List[(String, smt.Val)],\n) -> String {\n  if smt.is_absent(v) || !smt.refined(vc, t) {\n    return \"true\"\n  }\n  match v {\n    smt.Opaque(r) => return smt.unknown_bool(mut vc, r),\n    // a union value against one type (a narrowed value passed on): its\n    // active member must be of that type\n    smt.VUnion { .. } => if !smt.union_or_refined(t) && !smt.is_alias(vc, t) {\n      return smt.in_type(mut vc, t, v, extra)\n    },\n    _ => (),\n  }\n  match t {\n    // valid for a union: a valid value of one of its members\n    ast.UnionType(ms) => {\n      mut cs := []\n      for m in ms {\n        mut cs.push(smt.in_type(mut vc, m, v, extra))\n      }\n      smt.or_all(cs)\n    },\n    ast.Refined { base, pred: p } => {\n      a := smt.check_type(mut vc, base, v, extra)\n      c := smt.pred(mut vc, p, extra + [(\"it\", v)])\n      smt.and_all([a, c])\n    },\n    ast.UnitType | ast.FnType { .. } => \"true\",\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => {\n        c := smt.check_type(\n          mut vc,\n          ast.Named { name: p, args },\n          v,\n          extra,\n        )\n        match v {\n          smt.VSum { tag, ctors, .. } => match smt.position(ctors, name) {\n            Some(k) => smt.and_all([f\"(= {tag} {k})\", c]),\n            None => \"false\",\n          },\n          _ => smt.unknown_bool(mut vc, \"a value of an unexpected shape\"),\n        }\n      },\n      None => match (name, v) {\n        (\"List\", smt.VList { len, id }) => match get(args, 0) {\n          None => \"true\",\n          Some(t) => match smt.list_info(vc, id).source {\n            // a sequence of a datatype value: its own predicate\n            smt.GSeq(s, et, _) => if smt.erased(vc, et) == smt.erased(vc, t) {\n              smt.valid_term(\n                mut vc,\n                ast.Named { name: \"List\", args: [et] },\n                s,\n              )\n            } else {\n              smt.list_valid(mut vc, len, id, t, v)\n            },\n            _ => smt.list_valid(mut vc, len, id, t, v),\n          },\n        },\n        (\"Tuple\", smt.VTuple(xs)) => {\n          mut cs := []\n          for (i, a) in enumerate(args) {\n            match get(xs, i) {\n              Some(x) => mut cs.push(smt.check_type(mut vc, a, x, [])),\n              None => (),\n            }\n          }\n          smt.and_all(cs)\n        },\n        // a dict's or set's array: its predicate, which each operation\n        // preserves (`map_valid`)\n        // (an array of another sort, a generic callee's `Dict[K, Entry[P]]`\n        // where `Entry[Int]` is wanted, can't be checked as one)\n        (\"Dict\", smt.VList { id, .. }) | (\"Set\", smt.VList { id, .. }) => match get(vc.arrays, id) {\n          Some(a) => if smt.same_sort(\n            mut vc,\n            vc.keyed,\n            id,\n            ast.Named { name, args },\n          ) {\n            smt.valid_term(mut vc, ast.Named { name, args }, a)\n          } else {\n            smt.unknown_bool(\n              mut vc,\n              \"a dict or set of a generic function's result whose type arguments the call doesn't tell\",\n            )\n          },\n          None => smt.unknown_bool(\n            mut vc,\n            \"a dict or set of types not modelled\",\n          ),\n        },\n        (\"Dict\", _) | (\"Set\", _) => smt.unknown_bool(\n          mut vc,\n          \"a dict or set of types not modelled\",\n        ),\n        _ => match get(vc.types, name) {\n          None => \"true\",\n          Some(td) => smt.check_named(mut vc, name, args, td, v),\n        },\n      },\n    },\n  }\n}"},{"name":"smt.sx_ok","kind":"fn","old":"0627ab0fcc9fdf1d","new":"be4437923afb992a","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether a model's value of type `ty` can be written as a literal.\nfn sx_ok(vc: smt.Vc, ty: ast.TypeExpr, x0: smt.Sx) -> Bool {\n  x := match x0 {\n    smt.SList([smt.SAtom(\"as\"), y, _]) => y,\n    _ => x0,\n  }\n  match ty {\n    ast.Refined { base, .. } => smt.sx_ok(vc, base, x),\n    ast.UnitType => true,\n    ast.FnType { .. } => false,\n    ast.RowType(_) => false,\n    ast.UnionType(ms) => match (smt.union_groups(vc, ms), smt.sx_call(x)) {\n      (Some(gs), Some((c, xs))) => match parse_int(smt.after_dot(c)) {\n        Some(k) => match (get(gs, k), get(xs, 0)) {\n          (Some(g), Some(y)) => smt.sx_ok(vc, g.ty, y),\n          _ => false,\n        },\n        None => false,\n      },\n      _ => false,\n    },\n    ast.Named { name, args } => match name {\n      \"Int\" => smt.int_text(smt.sx_text(x)),\n      \"Bool\" => match x {\n        smt.SAtom(_) => true,\n        _ => false,\n      },\n      \"String\" => smt.str_text(smt.sx_text(x)),\n      \"List\" => false,\n      \"Tuple\" => match smt.sx_call(x) {\n        Some((_, xs)) => args\n          .enumerate()\n          .all(p -> match get(xs, p.0) {\n            Some(y) => smt.sx_ok(vc, p.1, y),\n            None => true,\n          }),\n        None => false,\n      },\n      \"Task\" => smt.sx_ok(vc, get(args, 0) ?? ast.UnitType, x),\n      \"Float\" | \"Dict\" | \"Set\" => true,\n      _ => match get(vc.parents, name) {\n        Some(p) => smt.sx_ok(vc, ast.Named { name: p, args }, x),\n        None => match get(vc.types, name) {\n          None => false,\n          Some(td) => match td.body {\n            ast.Alias(a) => smt.sx_ok(vc, smt.subst(a, smt.params_of(td, args)), x),\n            _ => match smt.sx_call(x) {\n              None => false,\n              Some((c, xs)) => {\n                prefix := smt.dt_name(smt.sort_type(vc, ty)) + \".\"\n                if !starts_with(c, prefix) {\n                  return false\n                }\n                cname := byte_slice(c, byte_len(prefix), byte_len(c))\n                match (smt.variants_of(vc, name, args) ?? []).filter(\n                  v -> v.name == cname,\n                ) {\n                  [v, ..] => v.types\n                    .enumerate()\n                    .all(p -> match get(xs, p.0) {\n                      Some(y) => smt.sx_ok(vc, p.1, y),\n                      None => true,\n                    }),\n                  _ => false,\n                }\n              },\n            },\n          },\n        },\n      },\n    },\n  }\n}","old_text":"/// Whether a model's value of type `ty` can be written as a literal.\nfn sx_ok(vc: smt.Vc, ty: ast.TypeExpr, x0: smt.Sx) -> Bool {\n  x := match x0 {\n    smt.SList([smt.SAtom(\"as\"), y, _]) => y,\n    _ => x0,\n  }\n  match ty {\n    ast.Refined { base, .. } => smt.sx_ok(vc, base, x),\n    ast.UnitType => true,\n    ast.FnType { .. } => false,\n    ast.UnionType(ms) => match (smt.union_groups(vc, ms), smt.sx_call(x)) {\n      (Some(gs), Some((c, xs))) => match parse_int(smt.after_dot(c)) {\n        Some(k) => match (get(gs, k), get(xs, 0)) {\n          (Some(g), Some(y)) => smt.sx_ok(vc, g.ty, y),\n          _ => false,\n        },\n        None => false,\n      },\n      _ => false,\n    },\n    ast.Named { name, args } => match name {\n      \"Int\" => smt.int_text(smt.sx_text(x)),\n      \"Bool\" => match x {\n        smt.SAtom(_) => true,\n        _ => false,\n      },\n      \"String\" => smt.str_text(smt.sx_text(x)),\n      \"List\" => false,\n      \"Tuple\" => match smt.sx_call(x) {\n        Some((_, xs)) => args\n          .enumerate()\n          .all(p -> match get(xs, p.0) {\n            Some(y) => smt.sx_ok(vc, p.1, y),\n            None => true,\n          }),\n        None => false,\n      },\n      \"Task\" => smt.sx_ok(vc, get(args, 0) ?? ast.UnitType, x),\n      \"Float\" | \"Dict\" | \"Set\" => true,\n      _ => match get(vc.parents, name) {\n        Some(p) => smt.sx_ok(vc, ast.Named { name: p, args }, x),\n        None => match get(vc.types, name) {\n          None => false,\n          Some(td) => match td.body {\n            ast.Alias(a) => smt.sx_ok(vc, smt.subst(a, smt.params_of(td, args)), x),\n            _ => match smt.sx_call(x) {\n              None => false,\n              Some((c, xs)) => {\n                prefix := smt.dt_name(smt.sort_type(vc, ty)) + \".\"\n                if !starts_with(c, prefix) {\n                  return false\n                }\n                cname := byte_slice(c, byte_len(prefix), byte_len(c))\n                match (smt.variants_of(vc, name, args) ?? []).filter(\n                  v -> v.name == cname,\n                ) {\n                  [v, ..] => v.types\n                    .enumerate()\n                    .all(p -> match get(xs, p.0) {\n                      Some(y) => smt.sx_ok(vc, p.1, y),\n                      None => true,\n                    }),\n                  _ => false,\n                }\n              },\n            },\n          },\n        },\n      },\n    },\n  }\n}"},{"name":"smt.infer_invariants","kind":"fn","old":"0269def284303440","new":"247b43cfc89cc57a","interface_changed":false,"affected":[],"module":"smt","text":"/// Facts every pass of `while c { body }` keeps, from the candidates\n/// `tried` (Houdini): those that can be false on entry are dropped, then,\n/// from any\n/// state where the others and the condition hold, one pass runs and those\n/// that can be false after it are dropped, until a pass drops nothing.\n/// The facts `given` (derived from the code, `derived_facts`) hold at the\n/// head: they are assumed in each pass, and not searched for again. With\n/// `Methods.search` 1, only the candidates naming the variables the\n/// function's failing checks name (`Methods.relevant`) are tried.\nfn infer_invariants(\n  mut vc: smt.Vc,\n  c: ast.Expr,\n  body: ast.Expr,\n  entry: List[(String, String, smt.Val)],\n  written: List[ast.Expr],\n  given: List[smt.Candidate],\n  tried: List[smt.Candidate],\n) -> List[smt.Candidate] {\n  // inner loops of a trial infer nothing\n  if vc.trial > 0 || vc.spec > 0 || vc.dead {\n    return []\n  }\n  known := given.map(k -> smt.candidate_key(k))\n  cands := tried.filter(\n    k ->\n      !contains(known, smt.candidate_key(k))\n        && smt.relevant(vc, c, k),\n  )\n  if len(cands) == 0 {\n    return []\n  }\n  // on entry\n  mut at_entry := []\n  for k in cands {\n    mut at_entry.push(smt.candidate_value(mut vc, k, entry))\n  }\n  mut alive := at_entry.map(t -> t != None)\n  pc0 := vc.pc\n  _ := smt.drop_falsifiable(mut vc, pc0, at_entry, mut alive)\n  // after a pass, from the head\n  for _ in 0..len(cands) + 1 {\n    if !alive.any(a -> a) {\n      break\n    }\n    scopes := vc.scopes\n    n_pc := len(vc.pc)\n    dead := vc.dead\n    n_ob := len(vc.obligations)\n    n_loops := len(vc.loops)\n    n_rec := len(vc.rec_sites)\n    n_term := len(vc.term_obs)\n    returns := vc.returns\n    vc.returns = []\n    vc.trial += 1\n    vc.spec += 1\n    smt.havoc_loop(mut vc, body, Some(c))\n    // the written invariants are proven on their own with these, so\n    // together they hold\n    for x in written {\n      v := smt.eval(mut vc, x)\n      b := smt.as_bool(mut vc, v)\n      mut vc.pc.push(b)\n    }\n    for g in given {\n      match smt.candidate_value(mut vc, g, entry) {\n        Some(t) => mut vc.pc.push(t),\n        None => (),\n      }\n    }\n    for (k, cand) in enumerate(cands) {\n      if get(alive, k) ?? false {\n        match smt.candidate_value(mut vc, cand, entry) {\n          Some(t) => mut vc.pc.push(t),\n          None => (),\n        }\n      }\n    }\n    cv := smt.eval(mut vc, c)\n    cb := smt.as_bool(mut vc, cv)\n    mut vc.pc.push(cb)\n    base := len(vc.pc)\n    depth := len(vc.scopes)\n    mut vc.breaks.push([])\n    mut vc.continues.push([])\n    wiped0 := vc.wiped\n    vc.wiped = []\n    _ := smt.eval(mut vc, body)\n    vc.breaks = take(vc.breaks, len(vc.breaks) - 1)\n    // kept where every pass ends\n    ends := smt.pass_ends(mut vc, depth)\n    // a candidate naming a variable that ends a pass as a callee's\n    // write-back (any value of its type) is dropped without asking\n    if vc.wiped != [] {\n      for e in ends {\n        for (k, cand) in enumerate(cands) {\n          if get(alive, k) ?? false\n            && smt.candidate_roots(cand).any(\n              x -> match smt.scope_value(e.scopes, x) {\n                Some(v) => contains(vc.wiped, v),\n                None => false,\n              },\n            ) {\n            alive = take(alive, k) + [false] + drop(alive, k + 1)\n          }\n        }\n      }\n    }\n    vc.wiped = wiped0\n    pc_after := take(vc.pc, base)\n    mut after := cands.map(_ -> Some(\"true\"))\n    for e in ends {\n      vc.pc = e.pc\n      vc.scopes = e.scopes\n      for (k, cand) in enumerate(cands) {\n        v := if get(alive, k) ?? false {\n          smt.candidate_value(mut vc, cand, entry)\n        } else {\n          None\n        }\n        after = take(after, k)\n          + [match (get(after, k) ?? None, v) {\n            (Some(acc), Some(x)) => Some(smt.and_all(\n              [acc, smt.implies(smt.and_all(drop(e.pc, base)), x)],\n            )),\n            _ => None,\n          }]\n          + drop(after, k + 1)\n      }\n    }\n    vc.pc = pc_after\n    vc.spec -= 1\n    vc.trial -= 1\n    vc.returns = returns\n    vc.scopes = scopes\n    vc.pc = take(vc.pc, n_pc)\n    vc.dead = dead\n    vc.obligations = take(vc.obligations, n_ob)\n    vc.loops = take(vc.loops, n_loops)\n    vc.rec_sites = take(vc.rec_sites, n_rec)\n    vc.term_obs = take(vc.term_obs, n_term)\n    if !smt.drop_falsifiable(mut vc, pc_after, after, mut alive) {\n      break\n    }\n  }\n  mut out := []\n  for (k, cand) in enumerate(cands) {\n    if get(alive, k) ?? false {\n      mut out.push(cand)\n    }\n  }\n  out\n}","old_text":"/// Facts every pass of `while c { body }` keeps, from the candidates\n/// `tried` (Houdini): those that can be false on entry are dropped, then,\n/// from any\n/// state where the others and the condition hold, one pass runs and those\n/// that can be false after it are dropped, until a pass drops nothing.\n/// The facts `given` (derived from the code, `derived_facts`) hold at the\n/// head: they are assumed in each pass, and not searched for again. With\n/// `Methods.search` 1, only the candidates naming the variables the\n/// function's failing checks name (`Methods.relevant`) are tried.\nfn infer_invariants(\n  mut vc: smt.Vc,\n  c: ast.Expr,\n  body: ast.Expr,\n  entry: List[(String, String, smt.Val)],\n  written: List[ast.Expr],\n  given: List[smt.Candidate],\n  tried: List[smt.Candidate],\n) -> List[smt.Candidate] {\n  // inner loops of a trial infer nothing\n  if vc.trial > 0 || vc.spec > 0 || vc.dead {\n    return []\n  }\n  known := given.map(k -> smt.candidate_key(k))\n  cands := tried.filter(\n    k ->\n      !contains(known, smt.candidate_key(k))\n        && smt.relevant(vc, c, k),\n  )\n  if len(cands) == 0 {\n    return []\n  }\n  // on entry\n  mut at_entry := []\n  for k in cands {\n    mut at_entry.push(smt.candidate_value(mut vc, k, entry))\n  }\n  mut alive := at_entry.map(t -> t != None)\n  pc0 := vc.pc\n  _ := smt.drop_falsifiable(mut vc, pc0, at_entry, mut alive)\n  // after a pass, from the head\n  for _ in 0..len(cands) + 1 {\n    if !alive.any(a -> a) {\n      break\n    }\n    scopes := vc.scopes\n    n_pc := len(vc.pc)\n    dead := vc.dead\n    n_ob := len(vc.obligations)\n    n_loops := len(vc.loops)\n    n_rec := len(vc.rec_sites)\n    n_term := len(vc.term_obs)\n    returns := vc.returns\n    vc.returns = []\n    vc.trial += 1\n    vc.spec += 1\n    smt.havoc_loop(mut vc, body, Some(c))\n    // the written invariants are proven on their own with these, so\n    // together they hold\n    for x in written {\n      v := smt.eval(mut vc, x)\n      b := smt.as_bool(mut vc, v)\n      mut vc.pc.push(b)\n    }\n    for g in given {\n      match smt.candidate_value(mut vc, g, entry) {\n        Some(t) => mut vc.pc.push(t),\n        None => (),\n      }\n    }\n    for (k, cand) in enumerate(cands) {\n      if get(alive, k) ?? false {\n        match smt.candidate_value(mut vc, cand, entry) {\n          Some(t) => mut vc.pc.push(t),\n          None => (),\n        }\n      }\n    }\n    cv := smt.eval(mut vc, c)\n    cb := smt.as_bool(mut vc, cv)\n    mut vc.pc.push(cb)\n    base := len(vc.pc)\n    depth := len(vc.scopes)\n    mut vc.breaks.push([])\n    mut vc.continues.push([])\n    wiped0 := vc.wiped\n    vc.wiped = []\n    _ := smt.eval(mut vc, body)\n    vc.breaks = take(vc.breaks, len(vc.breaks) - 1)\n    // kept where every pass ends\n    ends := smt.pass_ends(mut vc, depth)\n    // a candidate naming a variable that ends a pass as a callee's\n    // write-back (any value of its type) is dropped without asking\n    if vc.wiped != [] {\n      for e in ends {\n        for (k, cand) in enumerate(cands) {\n          if get(alive, k) ?? false\n            && smt.candidate_roots(cand).any(\n              x -> match smt.scope_value(e.scopes, x) {\n                Some(v) => contains(vc.wiped, v),\n                None => false,\n              },\n            ) {\n            alive = take(alive, k) + [false] + drop(alive, k + 1)\n          }\n        }\n      }\n    }\n    vc.wiped = wiped0\n    pc_after := take(vc.pc, base)\n    mut after := cands.map(_ -> Some(\"true\"))\n    for e in ends {\n      vc.pc = e.pc\n      vc.scopes = e.scopes\n      for (k, cand) in enumerate(cands) {\n        v := if get(alive, k) ?? false {\n          smt.candidate_value(mut vc, cand, entry)\n        } else {\n          None\n        }\n        after = take(after, k)\n          + [match (get(after, k) ?? None, v) {\n            (Some(acc), Some(x)) => Some(smt.and_all(\n              [acc, smt.implies(smt.and_all(drop(e.pc, base)), x)],\n            )),\n            _ => None,\n          }]\n          + drop(after, k + 1)\n      }\n    }\n    vc.pc = pc_after\n    vc.spec -= 1\n    vc.trial -= 1\n    vc.returns = returns\n    vc.scopes = scopes\n    vc.pc = take(vc.pc, n_pc)\n    vc.dead = dead\n    vc.obligations = take(vc.obligations, n_ob)\n    vc.loops = take(vc.loops, n_loops)\n    vc.rec_sites = take(vc.rec_sites, n_rec)\n    vc.term_obs = take(vc.term_obs, n_term)\n    if !smt.drop_falsifiable(mut vc, pc_after, after, mut alive) {\n      break\n    }\n  }\n  mut out := []\n  for (k, cand) in enumerate(cands) {\n    if get(alive, k) ?? false {\n      mut out.push(cand)\n    }\n  }\n  out\n}"},{"name":"smt.sx_literal","kind":"fn","old":"4fce42a15aacb27d","new":"380a78be38525654","interface_changed":false,"affected":[],"module":"smt","text":"/// A model's term of type `ty` as code.\nfn sx_literal(vc: smt.Vc, ty: ast.TypeExpr, x0: smt.Sx) -> Option[ast.Expr] {\n  x := match x0 {\n    smt.SList([smt.SAtom(\"as\"), y, _]) => y,\n    _ => x0,\n  }\n  match ty {\n    ast.Refined { base, .. } => smt.sx_literal(vc, base, x),\n    ast.UnitType => Some(ast.UnitExpr),\n    ast.FnType { .. } => None,\n    ast.RowType(_) => None,\n    ast.UnionType(ms) => {\n      gs := smt.union_groups(vc, ms)?\n      (c, xs) := smt.sx_call(x)?\n      k := parse_int(smt.after_dot(c))?\n      smt.sx_literal(vc, get(gs, k)?.ty, get(xs, 0)?)\n    },\n    ast.Named { name, args } => if name == \"Int\"\n      || contains(\n        [\"I8\", \"I16\", \"I32\", \"I64\", \"U8\", \"U16\", \"U32\", \"U64\"],\n        name,\n      ) {\n      smt.int_literal(smt.sx_text(x))\n    } else if name == \"Bool\" {\n      match x {\n        smt.SAtom(a) => Some(ast.BoolLit(a == \"true\")),\n        _ => None,\n      }\n    } else if name == \"String\" {\n      Some(ast.StrLit(smt.str_value(smt.sx_text(x))?))\n    } else if name == \"List\" {\n      mut out := []\n      if smt.seq_items(vc, get(args, 0)?, x, mut out) {\n        Some(ast.ListExpr(out))\n      } else {\n        None\n      }\n    } else if name == \"Tuple\" {\n      (_, xs) := smt.sx_call(x)?\n      mut out := []\n      for (i, a) in enumerate(args) {\n        mut out.push(smt.sx_literal(vc, a, get(xs, i)?)?)\n      }\n      Some(ast.TupleExpr(out))\n    } else if name == \"Task\" {\n      smt.sx_literal(vc, get(args, 0)?, x)\n    } else if name == \"Float\" || name == \"Dict\" || name == \"Set\" {\n      None\n    } else {\n      match get(vc.parents, name) {\n        Some(p) => smt.sx_literal(vc, ast.Named { name: p, args }, x),\n        None => {\n          td := get(vc.types, name)?\n          match td.body {\n            ast.Alias(a) => if td.distinct {\n              Some(ast.CtorExpr {\n                name,\n                args: ast.PositionalArgs([smt.sx_literal(\n                  vc,\n                  smt.subst(a, smt.params_of(td, args)),\n                  x,\n                )?]),\n              })\n            } else {\n              smt.sx_literal(\n                vc,\n                smt.subst(a, smt.params_of(td, args)),\n                x,\n              )\n            },\n            _ => {\n              (c, xs) := smt.sx_call(x)?\n              prefix := smt.dt_name(smt.sort_type(vc, ty)) + \".\"\n              if !starts_with(c, prefix) {\n                return None\n              }\n              cname := byte_slice(c, byte_len(prefix), byte_len(c))\n              v := get(smt.variants_of(vc, name, args)?.filter(\n                y -> y.name == cname,\n              ), 0)?\n              mut fields := []\n              for (i, ft) in enumerate(v.types) {\n                mut fields.push(smt.sx_literal(vc, ft, get(xs, i)?)?)\n              }\n              Some(ast.CtorExpr {\n                name: v.name,\n                args: smt.ctor_args(v.fields, fields),\n              })\n            },\n          }\n        },\n      }\n    },\n  }\n}","old_text":"/// A model's term of type `ty` as code.\nfn sx_literal(vc: smt.Vc, ty: ast.TypeExpr, x0: smt.Sx) -> Option[ast.Expr] {\n  x := match x0 {\n    smt.SList([smt.SAtom(\"as\"), y, _]) => y,\n    _ => x0,\n  }\n  match ty {\n    ast.Refined { base, .. } => smt.sx_literal(vc, base, x),\n    ast.UnitType => Some(ast.UnitExpr),\n    ast.FnType { .. } => None,\n    ast.UnionType(ms) => {\n      gs := smt.union_groups(vc, ms)?\n      (c, xs) := smt.sx_call(x)?\n      k := parse_int(smt.after_dot(c))?\n      smt.sx_literal(vc, get(gs, k)?.ty, get(xs, 0)?)\n    },\n    ast.Named { name, args } => if name == \"Int\"\n      || contains(\n        [\"I8\", \"I16\", \"I32\", \"I64\", \"U8\", \"U16\", \"U32\", \"U64\"],\n        name,\n      ) {\n      smt.int_literal(smt.sx_text(x))\n    } else if name == \"Bool\" {\n      match x {\n        smt.SAtom(a) => Some(ast.BoolLit(a == \"true\")),\n        _ => None,\n      }\n    } else if name == \"String\" {\n      Some(ast.StrLit(smt.str_value(smt.sx_text(x))?))\n    } else if name == \"List\" {\n      mut out := []\n      if smt.seq_items(vc, get(args, 0)?, x, mut out) {\n        Some(ast.ListExpr(out))\n      } else {\n        None\n      }\n    } else if name == \"Tuple\" {\n      (_, xs) := smt.sx_call(x)?\n      mut out := []\n      for (i, a) in enumerate(args) {\n        mut out.push(smt.sx_literal(vc, a, get(xs, i)?)?)\n      }\n      Some(ast.TupleExpr(out))\n    } else if name == \"Task\" {\n      smt.sx_literal(vc, get(args, 0)?, x)\n    } else if name == \"Float\" || name == \"Dict\" || name == \"Set\" {\n      None\n    } else {\n      match get(vc.parents, name) {\n        Some(p) => smt.sx_literal(vc, ast.Named { name: p, args }, x),\n        None => {\n          td := get(vc.types, name)?\n          match td.body {\n            ast.Alias(a) => if td.distinct {\n              Some(ast.CtorExpr {\n                name,\n                args: ast.PositionalArgs([smt.sx_literal(\n                  vc,\n                  smt.subst(a, smt.params_of(td, args)),\n                  x,\n                )?]),\n              })\n            } else {\n              smt.sx_literal(\n                vc,\n                smt.subst(a, smt.params_of(td, args)),\n                x,\n              )\n            },\n            _ => {\n              (c, xs) := smt.sx_call(x)?\n              prefix := smt.dt_name(smt.sort_type(vc, ty)) + \".\"\n              if !starts_with(c, prefix) {\n                return None\n              }\n              cname := byte_slice(c, byte_len(prefix), byte_len(c))\n              v := get(smt.variants_of(vc, name, args)?.filter(\n                y -> y.name == cname,\n              ), 0)?\n              mut fields := []\n              for (i, ft) in enumerate(v.types) {\n                mut fields.push(smt.sx_literal(vc, ft, get(xs, i)?)?)\n              }\n              Some(ast.CtorExpr {\n                name: v.name,\n                args: smt.ctor_args(v.fields, fields),\n              })\n            },\n          }\n        },\n      }\n    },\n  }\n}"},{"name":"smt.self_written","kind":"fn","old":"8f48e6d4c74adac6","new":"0af42921a3170c57","interface_changed":false,"affected":[],"module":"smt","text":"/// `t` with `Self` replaced by `for_type`.\nfn self_written(t: ast.TypeExpr, for_type: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Named { name: \"Self\", args: [] } => for_type,\n    ast.Named { name, args } => ast.Named {\n      name,\n      args: args.map(a -> smt.self_written(a, for_type)),\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> smt.self_written(a, for_type)),\n      ret: smt.self_written(ret, for_type),\n    },\n    ast.Refined { base, pred } => ast.Refined { base: smt.self_written(base, for_type), pred },\n    ast.RowType(fs) => ast.RowType(fs.map(f -> (f.0, smt.self_written(f.1, for_type)))),\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> smt.self_written(a, for_type))),\n    ast.UnitType => ast.UnitType,\n  }\n}","old_text":"/// `t` with `Self` replaced by `for_type`.\nfn self_written(t: ast.TypeExpr, for_type: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Named { name: \"Self\", args: [] } => for_type,\n    ast.Named { name, args } => ast.Named {\n      name,\n      args: args.map(a -> smt.self_written(a, for_type)),\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> smt.self_written(a, for_type)),\n      ret: smt.self_written(ret, for_type),\n    },\n    ast.Refined { base, pred } => ast.Refined { base: smt.self_written(base, for_type), pred },\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> smt.self_written(a, for_type))),\n    ast.UnitType => ast.UnitType,\n  }\n}"},{"name":"smt.refined_by","kind":"fn","old":"38e5106031abc76f","new":"636e817c1bd7b78f","interface_changed":false,"affected":[],"module":"smt","text":"/// `refined`, given the types that reach a refinement (`refined_types`). A\n/// type reaches what its declaration reaches, whatever its arguments, plus\n/// what its arguments reach.\nfn refined_by(names: Set[String], t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Refined { .. } => true,\n    ast.UnitType | ast.FnType { .. } => false,\n    ast.RowType(fs) => fs.any(f -> smt.refined_by(names, f.1)),\n    ast.UnionType(ms) => ms.any(m -> smt.refined_by(names, m)),\n    ast.Named { name, args } => contains(names, name) || args.any(a -> smt.refined_by(names, a)),\n  }\n}","old_text":"/// `refined`, given the types that reach a refinement (`refined_types`). A\n/// type reaches what its declaration reaches, whatever its arguments, plus\n/// what its arguments reach.\nfn refined_by(names: Set[String], t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Refined { .. } => true,\n    ast.UnitType | ast.FnType { .. } => false,\n    ast.UnionType(ms) => ms.any(m -> smt.refined_by(names, m)),\n    ast.Named { name, args } => contains(names, name) || args.any(a -> smt.refined_by(names, a)),\n  }\n}"},{"name":"smt.refined_types","kind":"fn","old":"48e7c7e661f12a6b","new":"7d12ddb571f4b702","interface_changed":false,"affected":[],"module":"smt","text":"/// The names of `types` (and of their sums' variants) whose declaration\n/// reaches a refinement, walked as `refined_walk` does: a variant through\n/// its sum; any other type through its own refinement and the fields and\n/// payloads of its body (the types they name, their arguments, a union's\n/// members, but not a function type's parts). Found backwards from the\n/// types that hold one, each type once.\npub fn refined_types(types: Dict[String, ast.TypeDecl]) -> Set[String] {\n  // who names whom: `by[m]` lists the types whose declaration names `m`\n  mut by := Dict[String, List[String]] {}\n  mut holding := []\n  mut parents := Set[String] {}\n  for (n, td) in items(types) {\n    match td.body {\n      ast.SumBody(vs) => {\n        for v in vs {\n          q := smt.qual(n, v.name)\n          mut parents.insert(q)\n          mut by.insert(n, (get(by, n) ?? []) + [q])\n        }\n      },\n      _ => (),\n    }\n  }\n  for (n, td) in items(types) {\n    if contains(parents, n) {\n      continue\n    }\n    mut todo := match td.body {\n      ast.Alias(a) => [a],\n      ast.RecordBody(fs) => fs.map(f -> f.ty),\n      ast.SumBody(vs) => [t for v in vs for t in match v.payload {\n        ast.NoPayload => [],\n        ast.Positional(ts) => ts,\n        ast.RecordPayload(fs) => fs.map(f -> f.ty),\n        ast.MemberType(m) => [m],\n      }],\n    }\n    mut holds := td.refinement != None\n    while len(todo) > 0 && !holds {\n      x := get(todo, len(todo) - 1) ?? ast.UnitType\n      todo = take(todo, len(todo) - 1)\n      match x {\n        ast.Refined { .. } => {\n          holds = true\n        },\n        ast.UnitType | ast.FnType { .. } => (),\n        ast.RowType(fs) => {\n          todo += fs.map(f -> f.1)\n        },\n        ast.UnionType(ms) => {\n          todo += ms\n        },\n        ast.Named { name, args } => {\n          mut by.insert(name, (get(by, name) ?? []) + [n])\n          todo += args\n        },\n      }\n    }\n    if holds {\n      mut holding.push(n)\n    }\n  }\n  mut out := Set[String] {}\n  mut stack := holding\n  while len(stack) > 0 {\n    n := get(stack, len(stack) - 1) ?? \"\"\n    stack = take(stack, len(stack) - 1)\n    if !contains(out, n) {\n      mut out.insert(n)\n      stack += get(by, n) ?? []\n    }\n  }\n  out\n}","old_text":"/// The names of `types` (and of their sums' variants) whose declaration\n/// reaches a refinement, walked as `refined_walk` does: a variant through\n/// its sum; any other type through its own refinement and the fields and\n/// payloads of its body (the types they name, their arguments, a union's\n/// members, but not a function type's parts). Found backwards from the\n/// types that hold one, each type once.\npub fn refined_types(types: Dict[String, ast.TypeDecl]) -> Set[String] {\n  // who names whom: `by[m]` lists the types whose declaration names `m`\n  mut by := Dict[String, List[String]] {}\n  mut holding := []\n  mut parents := Set[String] {}\n  for (n, td) in items(types) {\n    match td.body {\n      ast.SumBody(vs) => {\n        for v in vs {\n          q := smt.qual(n, v.name)\n          mut parents.insert(q)\n          mut by.insert(n, (get(by, n) ?? []) + [q])\n        }\n      },\n      _ => (),\n    }\n  }\n  for (n, td) in items(types) {\n    if contains(parents, n) {\n      continue\n    }\n    mut todo := match td.body {\n      ast.Alias(a) => [a],\n      ast.RecordBody(fs) => fs.map(f -> f.ty),\n      ast.SumBody(vs) => [t for v in vs for t in match v.payload {\n        ast.NoPayload => [],\n        ast.Positional(ts) => ts,\n        ast.RecordPayload(fs) => fs.map(f -> f.ty),\n        ast.MemberType(m) => [m],\n      }],\n    }\n    mut holds := td.refinement != None\n    while len(todo) > 0 && !holds {\n      x := get(todo, len(todo) - 1) ?? ast.UnitType\n      todo = take(todo, len(todo) - 1)\n      match x {\n        ast.Refined { .. } => {\n          holds = true\n        },\n        ast.UnitType | ast.FnType { .. } => (),\n        ast.UnionType(ms) => {\n          todo += ms\n        },\n        ast.Named { name, args } => {\n          mut by.insert(name, (get(by, name) ?? []) + [n])\n          todo += args\n        },\n      }\n    }\n    if holds {\n      mut holding.push(n)\n    }\n  }\n  mut out := Set[String] {}\n  mut stack := holding\n  while len(stack) > 0 {\n    n := get(stack, len(stack) - 1) ?? \"\"\n    stack = take(stack, len(stack) - 1)\n    if !contains(out, n) {\n      mut out.insert(n)\n      stack += get(by, n) ?? []\n    }\n  }\n  out\n}"},{"name":"smt.refined_walk","kind":"fn","old":"f18cdd57ede92a76","new":"33f50c45ed40e249","interface_changed":false,"affected":[],"module":"smt","text":"/// `refined` by walking every type `t` can reach (its arguments, the\n/// fields and payloads of its body, a variant's sum), each once.\nfn refined_walk(vc: smt.Vc, t: ast.TypeExpr) -> Bool {\n  mut seen := []\n  mut todo := [t]\n  while len(todo) > 0 {\n    x := get(todo, len(todo) - 1) ?? ast.UnitType\n    todo = take(todo, len(todo) - 1)\n    if contains(seen, x) {\n      continue\n    }\n    mut seen.push(x)\n    match x {\n      ast.Refined { .. } => return true,\n      ast.UnitType | ast.FnType { .. } => (),\n      ast.RowType(fs) => {\n        todo += fs.map(f -> f.1)\n      },\n      ast.UnionType(ms) => {\n        todo += ms\n      },\n      ast.Named { name, args } => match get(vc.parents, name) {\n        Some(p) => mut todo.push(ast.Named { name: p, args }),\n        None => {\n          todo += args\n          match get(vc.types, name) {\n            Some(td) => {\n              if td.refinement != None {\n                return true\n              }\n              match td.body {\n                ast.Alias(a) => mut todo.push(a),\n                ast.RecordBody(fs) => {\n                  todo += fs.map(f -> f.ty)\n                },\n                ast.SumBody(vs) => {\n                  for v in vs {\n                    match v.payload {\n                      ast.NoPayload => (),\n                      ast.Positional(ts) => {\n                        todo += ts\n                      },\n                      ast.RecordPayload(fs) => {\n                        todo += fs.map(f -> f.ty)\n                      },\n                      ast.MemberType(m) => mut todo.push(m),\n                    }\n                  }\n                },\n              }\n            },\n            None => (),\n          }\n        },\n      },\n    }\n  }\n  false\n}","old_text":"/// `refined` by walking every type `t` can reach (its arguments, the\n/// fields and payloads of its body, a variant's sum), each once.\nfn refined_walk(vc: smt.Vc, t: ast.TypeExpr) -> Bool {\n  mut seen := []\n  mut todo := [t]\n  while len(todo) > 0 {\n    x := get(todo, len(todo) - 1) ?? ast.UnitType\n    todo = take(todo, len(todo) - 1)\n    if contains(seen, x) {\n      continue\n    }\n    mut seen.push(x)\n    match x {\n      ast.Refined { .. } => return true,\n      ast.UnitType | ast.FnType { .. } => (),\n      ast.UnionType(ms) => {\n        todo += ms\n      },\n      ast.Named { name, args } => match get(vc.parents, name) {\n        Some(p) => mut todo.push(ast.Named { name: p, args }),\n        None => {\n          todo += args\n          match get(vc.types, name) {\n            Some(td) => {\n              if td.refinement != None {\n                return true\n              }\n              match td.body {\n                ast.Alias(a) => mut todo.push(a),\n                ast.RecordBody(fs) => {\n                  todo += fs.map(f -> f.ty)\n                },\n                ast.SumBody(vs) => {\n                  for v in vs {\n                    match v.payload {\n                      ast.NoPayload => (),\n                      ast.Positional(ts) => {\n                        todo += ts\n                      },\n                      ast.RecordPayload(fs) => {\n                        todo += fs.map(f -> f.ty)\n                      },\n                      ast.MemberType(m) => mut todo.push(m),\n                    }\n                  }\n                },\n              }\n            },\n            None => (),\n          }\n        },\n      },\n    }\n  }\n  false\n}"},{"name":"store.use ast","kind":"use","old":"bc99153cde1e56f9","new":"b25d094feedb2e29","interface_changed":true,"affected":[],"module":"store","text":"// store: qualified names, and the dependency graph that module file headers\n// list.\n\nfrom ast use DeriveFnDef, Decl, Expr, Stmt, Pattern, TypeExpr, CtorArgs,\n  CtorPat, StrPart, TypeDef, FnDef, TestDef, TraitDef, ImplDef, UseDef,\n  ExternDef, CapabilityDef, Alias, RecordBody, SumBody, NoPayload, Positional,\n  RecordPayload, MemberType, Named, FnType, UnitType, Refined, UnionType,\n  RowType, Var, ListExpr, TupleExpr, CtorExpr, Call, MethodCall, FieldOf, Unary,\n  Return, MutExpr, Try, Lambda, Except, Fallback, Interp, ValuePart, MockExpr,\n  IsExpr, Binary, IfExpr, MatchExpr, Block, Let, VarDecl, Assign, While, For,\n  Loop, ExprStmt, Assert, Invariant, Decreases, CtorPattern, ListPat, TuplePat,\n  OrPat, CondPat, PositionalArgs, RecordArgs, UpdateArgs, PositionalPats,\n  RecordPats, TypePats, ExternFn, ComptimeFor, AssertBy, Calc","old_text":"// store: qualified names, and the dependency graph that module file headers\n// list.\n\nfrom ast use DeriveFnDef, Decl, Expr, Stmt, Pattern, TypeExpr, CtorArgs,\n  CtorPat, StrPart, TypeDef, FnDef, TestDef, TraitDef, ImplDef, UseDef,\n  ExternDef, CapabilityDef, Alias, RecordBody, SumBody, NoPayload, Positional,\n  RecordPayload, MemberType, Named, FnType, UnitType, Refined, UnionType, Var,\n  ListExpr, TupleExpr, CtorExpr, Call, MethodCall, FieldOf, Unary, Return,\n  MutExpr, Try, Lambda, Except, Fallback, Interp, ValuePart, MockExpr, IsExpr,\n  Binary, IfExpr, MatchExpr, Block, Let, VarDecl, Assign, While, For, Loop,\n  ExprStmt, Assert, Invariant, Decreases, CtorPattern, ListPat, TuplePat, OrPat,\n  CondPat, PositionalArgs, RecordArgs, UpdateArgs, PositionalPats, RecordPats,\n  TypePats, ExternFn, ComptimeFor, AssertBy, Calc"},{"name":"store.ty","kind":"fn","old":"9e2bbcc84eeb9c28","new":"28d4090debd0889d","interface_changed":false,"affected":[],"module":"store","text":"fn ty(mut out: Set[String], t: ast.TypeExpr) {\n  match t {\n    ast.Named { name, args } => {\n      mut out.insert(name)\n      for a in args {\n        store.ty(mut out, a)\n      }\n    },\n    ast.FnType { params, ret } => {\n      for p in params {\n        store.ty(mut out, p)\n      }\n      store.ty(mut out, ret)\n    },\n    ast.UnitType => (),\n    ast.Refined { base, .. } => store.ty(mut out, base),\n    ast.RowType(fs) => {\n      for f in fs {\n        store.ty(mut out, f.1)\n      }\n    },\n    ast.UnionType(ms) => {\n      for m in ms {\n        store.ty(mut out, m)\n      }\n    },\n  }\n}","old_text":"fn ty(mut out: Set[String], t: ast.TypeExpr) {\n  match t {\n    ast.Named { name, args } => {\n      mut out.insert(name)\n      for a in args {\n        store.ty(mut out, a)\n      }\n    },\n    ast.FnType { params, ret } => {\n      for p in params {\n        store.ty(mut out, p)\n      }\n      store.ty(mut out, ret)\n    },\n    ast.UnitType => (),\n    ast.Refined { base, .. } => store.ty(mut out, base),\n    ast.UnionType(ms) => {\n      for m in ms {\n        store.ty(mut out, m)\n      }\n    },\n  }\n}"},{"name":"termination.use ast","kind":"use","old":"102e32ef559f7677","new":"6e4ff12d733d3312","interface_changed":true,"affected":[],"module":"termination","text":"from ast use FnDecl, TypeDecl, TypeExpr, Expr, Stmt, Pattern, Param, ImplDecl,\n  TraitDecl, Named, FnType, UnitType, Refined, UnionType, RowType, Alias,\n  RecordBody, SumBody, NoPayload, Positional, RecordPayload, MemberType, IntLit,\n  FloatLit, StrLit, Var, Hole, CtorExpr, Call, MethodCall, FieldOf, Lambda,\n  Binary, MatchExpr, MutExpr, Block, MockExpr, Return, Try, TupleExpr, ListExpr,\n  Except, Div, Mod, Sub, Less, LessEq, Greater, GreaterEq, NotEqual, Equal, Let,\n  VarDecl, Assign, While, For, Loop, ExprStmt, Assert, Invariant, Decreases,\n  ComptimeFor, Wild, Bind, CtorPattern, ListPat, TuplePat, CondPat, OrPat,\n  ForPat, NoPats, PositionalPats, RecordPats, TypePats, AssertBy, Calc","old_text":"from ast use FnDecl, TypeDecl, TypeExpr, Expr, Stmt, Pattern, Param, ImplDecl,\n  TraitDecl, Named, FnType, UnitType, Refined, UnionType, Alias, RecordBody,\n  SumBody, NoPayload, Positional, RecordPayload, MemberType, IntLit, FloatLit,\n  StrLit, Var, Hole, CtorExpr, Call, MethodCall, FieldOf, Lambda, Binary,\n  MatchExpr, MutExpr, Block, MockExpr, Return, Try, TupleExpr, ListExpr, Except,\n  Div, Mod, Sub, Less, LessEq, Greater, GreaterEq, NotEqual, Equal, Let,\n  VarDecl, Assign, While, For, Loop, ExprStmt, Assert, Invariant, Decreases,\n  ComptimeFor, Wild, Bind, CtorPattern, ListPat, TuplePat, CondPat, OrPat,\n  ForPat, NoPats, PositionalPats, RecordPats, TypePats, AssertBy, Calc"},{"name":"termination.call_name","kind":"fn","old":"d49e304f75d179c3","new":"0f2e3bf6a3da4d83","interface_changed":false,"affected":[],"module":"termination","text":"fn call_name(mut st: termination.Calls, ctx: termination.Ctx, n: String) {\n  if st.scopes.any(s -> contains(s, n)) {\n    return\n  }\n  if contains(ctx.fns, n) {\n    mut st.out.insert(n)\n  } else if termination.is_method(ctx, n) {\n    mut st.out.insert(termination.trait_node(n))\n  }\n}","old_text":"fn call_name(mut st: termination.Calls, ctx: termination.Ctx, n: String) {\n  if st.scopes.any(s -> contains(s, n)) {\n    return\n  }\n  if contains(ctx.fns, n) {\n    mut st.out.insert(n)\n  } else if termination.is_method(ctx, n) {\n    mut st.out.insert(termination.trait_node(n))\n  }\n}"},{"name":"termination.struct_call","kind":"fn","old":"cf174b7884bf9fd8","new":"d17c92d6563ba8c6","interface_changed":false,"affected":[],"module":"termination","text":"fn struct_call(\n  mut st: termination.Structural,\n  args: List[ast.Expr],\n  vars: Dict[String, termination.Piece],\n) {\n  mut smaller := Set[Int] {}\n  for (i, a) in enumerate(args) {\n    if contains(termination.piece(a, vars).smaller, i) {\n      mut smaller.insert(i)\n    }\n  }\n  mut st.calls.push(smaller)\n}","old_text":"fn struct_call(\n  mut st: termination.Structural,\n  args: List[ast.Expr],\n  vars: Dict[String, termination.Piece],\n) {\n  mut smaller := Set[Int] {}\n  for (i, a) in enumerate(args) {\n    if contains(termination.piece(a, vars).smaller, i) {\n      mut smaller.insert(i)\n    }\n  }\n  mut st.calls.push(smaller)\n}"},{"name":"termination.refinements_in","kind":"fn","old":"b289df22b2912351","new":"072038a3022a1c9f","interface_changed":false,"affected":[],"module":"termination","text":"fn refinements_in(t: ast.TypeExpr) -> List[ast.Expr] {\n  match t {\n    ast.Refined { base, pred } => [pred] + termination.refinements_in(base),\n    ast.Named { args, .. } => fold(\n      args.map(a -> termination.refinements_in(a)),\n      [],\n      (a, b) -> a + b,\n    ),\n    ast.RowType(fs) => fold(\n      fs.map(f -> termination.refinements_in(f.1)),\n      [],\n      (a, b) -> a + b,\n    ),\n    ast.UnionType(ms) => fold(\n      ms.map(m -> termination.refinements_in(m)),\n      [],\n      (a, b) -> a + b,\n    ),\n    ast.FnType { params, ret } => fold(\n        params.map(p -> termination.refinements_in(p)),\n        [],\n        (a, b) -> a + b,\n      )\n      + termination.refinements_in(ret),\n    ast.UnitType => [],\n  }\n}","old_text":"fn refinements_in(t: ast.TypeExpr) -> List[ast.Expr] {\n  match t {\n    ast.Refined { base, pred } => [pred] + termination.refinements_in(base),\n    ast.Named { args, .. } => fold(\n      args.map(a -> termination.refinements_in(a)),\n      [],\n      (a, b) -> a + b,\n    ),\n    ast.UnionType(ms) => fold(\n      ms.map(m -> termination.refinements_in(m)),\n      [],\n      (a, b) -> a + b,\n    ),\n    ast.FnType { params, ret } => fold(\n        params.map(p -> termination.refinements_in(p)),\n        [],\n        (a, b) -> a + b,\n      )\n      + termination.refinements_in(ret),\n    ast.UnitType => [],\n  }\n}"},{"name":"text.use ast","kind":"use","old":"3dffea95c4172931","new":"49cb66c109a8d104","interface_changed":true,"affected":[],"module":"text","text":"// text: the printer, from a tree to code. Expressions break across lines to\n// stay within 80 columns. It prints a tree as given; `strata render` first\n// turns a stored tree into its written form (see `resolve.written`).\n\nfrom ast use DeriveFnDef, Decl, TypeDecl, Field, FnDecl, Param, Bound,\n  TraitDecl, ImplDecl, CapabilityDecl, TypeExpr, Expr, LamParam, FmtSpec, BinOp,\n  Stmt, Pattern, TypeDef, FnDef, TestDef, TraitDef, ImplDef, UseDef, ExternDef,\n  CapabilityDef, Alias, RecordBody, SumBody, NoPayload, Positional,\n  RecordPayload, MemberType, C, Builtin, Python, ExternFn, ExternType,\n  ExternStatic, ExternThreadStatic, Named, FnType, UnitType, Refined, UnionType,\n  RowType, IntLit, BigIntLit, FloatLit, TupleExpr, StrLit, BoolLit, UnitExpr,\n  Var, Hole, ListExpr, CtorExpr, Call, MethodCall, FieldOf, Lambda, Binary,\n  Unary, IsExpr, IfExpr, MatchExpr, MutExpr, Block, MockExpr, Return, Try,\n  Except, Interp, Range, Index, Comp, DictExpr, SetExpr, Fallback, Comptime,\n  Scope, Spawn, Await, Select, Race, SupervisedSpawn, Old, Assumed, Spread,\n  NoArgs, PositionalArgs, RecordArgs, UpdateArgs, ListComp, SetComp, DictComp,\n  TextPart, ValuePart, Add, Sub, Mul, Div, Mod, Equal, NotEqual, Less, LessEq,\n  Greater, GreaterEq, And, Or, Implies, BitAnd, BitOr, BitXor, Shl, Shr, Neg,\n  Not, TryResult, TryOption, Let, VarDecl, Assign, While, For, Loop, Break,\n  Continue, ExprStmt, Assert, Comment, ComptimeFor, Invariant, Decreases, Wild,\n  Bind, IntPat, StrPat, BoolPat, CtorPattern, ListPat, TuplePat, CondPat, OrPat,\n  ForPat, NoPats, PositionalPats, RecordPats, TypePats, unassumed, DeriveClause,\n  AssertBy, Calc","old_text":"// text: the printer, from a tree to code. Expressions break across lines to\n// stay within 80 columns. It prints a tree as given; `strata render` first\n// turns a stored tree into its written form (see `resolve.written`).\n\nfrom ast use DeriveFnDef, Decl, TypeDecl, Field, FnDecl, Param, Bound,\n  TraitDecl, ImplDecl, CapabilityDecl, TypeExpr, Expr, LamParam, FmtSpec, BinOp,\n  Stmt, Pattern, TypeDef, FnDef, TestDef, TraitDef, ImplDef, UseDef, ExternDef,\n  CapabilityDef, Alias, RecordBody, SumBody, NoPayload, Positional,\n  RecordPayload, MemberType, C, Builtin, Python, ExternFn, ExternType,\n  ExternStatic, ExternThreadStatic, Named, FnType, UnitType, Refined, UnionType,\n  IntLit, BigIntLit, FloatLit, TupleExpr, StrLit, BoolLit, UnitExpr, Var, Hole,\n  ListExpr, CtorExpr, Call, MethodCall, FieldOf, Lambda, Binary, Unary, IsExpr,\n  IfExpr, MatchExpr, MutExpr, Block, MockExpr, Return, Try, Except, Interp,\n  Range, Index, Comp, DictExpr, SetExpr, Fallback, Comptime, Scope, Spawn,\n  Await, Select, Race, SupervisedSpawn, Old, Assumed, Spread, NoArgs,\n  PositionalArgs, RecordArgs, UpdateArgs, ListComp, SetComp, DictComp, TextPart,\n  ValuePart, Add, Sub, Mul, Div, Mod, Equal, NotEqual, Less, LessEq, Greater,\n  GreaterEq, And, Or, Implies, BitAnd, BitOr, BitXor, Shl, Shr, Neg, Not,\n  TryResult, TryOption, Let, VarDecl, Assign, While, For, Loop, Break, Continue,\n  ExprStmt, Assert, Comment, ComptimeFor, Invariant, Decreases, Wild, Bind,\n  IntPat, StrPat, BoolPat, CtorPattern, ListPat, TuplePat, CondPat, OrPat,\n  ForPat, NoPats, PositionalPats, RecordPats, TypePats, unassumed, DeriveClause,\n  AssertBy, Calc"},{"name":"text.type_text","kind":"fn","old":"dc7096304dedbf76","new":"d82dd9c0d1556e9c","interface_changed":false,"affected":[],"module":"text","text":"/// `List[Int]`, `(Int, String)`, `(A) -> B`, `Int where it > 0`, `A | B`.\npub fn type_text(t: ast.TypeExpr) -> String {\n  match t {\n    ast.UnitType => \"()\",\n    ast.Named { name, args } => if name == \"Tuple\" {\n      \"(\" + join(args.map(a -> text.type_text(a)), \", \") + \")\"\n    } else if len(args) == 0 {\n      name\n    } else {\n      name\n        + \"[\"\n        + join(args.map(a -> text.type_text(a)), \", \")\n        + \"]\"\n    },\n    ast.FnType { params, ret } => \"(\"\n      + join(params.map(p -> text.type_text(p)), \", \")\n      + \") -> \"\n      + text.type_text(ret),\n    ast.Refined { base, pred } => text.type_text(base)\n      + \" where \"\n      + text.unpiped(text.head(pred, 0)),\n    // a refined or function member needs parentheses, or `where` / `->` would take in the rest\n    ast.RowType(fs) => \"{ \"\n      + join(\n        fs.map(f -> f.0 + \": \" + text.type_text(f.1)) + [\"..\"],\n        \", \",\n      )\n      + \" }\",\n    ast.UnionType(ms) => join(\n      ms.map(\n        m ->\n          match m {\n            ast.Refined { .. } | ast.FnType { .. } | ast.UnionType(_) => \"(\" + text.type_text(m) + \")\",\n            _ => text.type_text(m),\n          },\n      ),\n      \" | \",\n    ),\n  }\n}","old_text":"/// `List[Int]`, `(Int, String)`, `(A) -> B`, `Int where it > 0`, `A | B`.\npub fn type_text(t: ast.TypeExpr) -> String {\n  match t {\n    ast.UnitType => \"()\",\n    ast.Named { name, args } => if name == \"Tuple\" {\n      \"(\" + join(args.map(a -> text.type_text(a)), \", \") + \")\"\n    } else if len(args) == 0 {\n      name\n    } else {\n      name\n        + \"[\"\n        + join(args.map(a -> text.type_text(a)), \", \")\n        + \"]\"\n    },\n    ast.FnType { params, ret } => \"(\"\n      + join(params.map(p -> text.type_text(p)), \", \")\n      + \") -> \"\n      + text.type_text(ret),\n    ast.Refined { base, pred } => text.type_text(base)\n      + \" where \"\n      + text.unpiped(text.head(pred, 0)),\n    // a refined or function member needs parentheses, or `where` / `->` would take in the rest\n    ast.UnionType(ms) => join(\n      ms.map(\n        m ->\n          match m {\n            ast.Refined { .. } | ast.FnType { .. } | ast.UnionType(_) => \"(\" + text.type_text(m) + \")\",\n            _ => text.type_text(m),\n          },\n      ),\n      \" | \",\n    ),\n  }\n}"},{"name":"unused.use ast","kind":"use","old":"ad4a2d32ceacadef","new":"8bbe46d9294c1fec","interface_changed":true,"affected":[],"module":"unused","text":"// unused: what a whole program never uses. A definition that nothing\n// reaches from the program's roots, a field of a private record that is\n// never read, and a variant of a private sum that is never built. `strata\n// check` warns of each (errors with `[check] unused = \"error\"` in\n// strata.toml), and `strata fix` removes the definitions.\n\nfrom ast use Decl, Expr, Pattern, TypeExpr, FnDecl, TypeDef, FnDef, TestDef,\n  TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, DeriveFnDef, RecordBody,\n  SumBody, Alias, NoPayload, Positional, RecordPayload, MemberType, Named,\n  FnType, Refined, UnionType, RowType, Var, CtorExpr, FieldOf, MethodCall,\n  IsExpr, Spread, MatchExpr, Block, Comp, Let, For, ComptimeFor, CtorPattern,\n  RecordPats, PositionalPats, TypePats, ListPat, TuplePat, OrPat, ForPat,\n  UnitType, UnitExpr, ExternFn","old_text":"// unused: what a whole program never uses. A definition that nothing\n// reaches from the program's roots, a field of a private record that is\n// never read, and a variant of a private sum that is never built. `strata\n// check` warns of each (errors with `[check] unused = \"error\"` in\n// strata.toml), and `strata fix` removes the definitions.\n\nfrom ast use Decl, Expr, Pattern, TypeExpr, FnDecl, TypeDef, FnDef, TestDef,\n  TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, DeriveFnDef, RecordBody,\n  SumBody, Alias, NoPayload, Positional, RecordPayload, MemberType, Named,\n  FnType, Refined, UnionType, Var, CtorExpr, FieldOf, MethodCall, IsExpr,\n  Spread, MatchExpr, Block, Comp, Let, For, ComptimeFor, CtorPattern,\n  RecordPats, PositionalPats, TypePats, ListPat, TuplePat, OrPat, ForPat,\n  UnitType, UnitExpr, ExternFn"},{"name":"unused.type_names","kind":"fn","old":"0395712b6f22a614","new":"d6dca447a5dc3823","interface_changed":false,"affected":[],"module":"unused","text":"/// The named types in `t`, arguments included.\nfn type_names(t: ast.TypeExpr) -> List[String] {\n  match t {\n    ast.Named { name, args } => [name] + unused.flat(args.map(a -> unused.type_names(a))),\n    ast.FnType { params, ret } => unused.flat(params.map(a -> unused.type_names(a)))\n      + unused.type_names(ret),\n    ast.Refined { base, .. } => unused.type_names(base),\n    ast.RowType(fs) => unused.flat(fs.map(f -> unused.type_names(f.1))),\n    ast.UnionType(ms) => unused.flat(ms.map(a -> unused.type_names(a))),\n    ast.UnitType => [],\n  }\n}","old_text":"/// The named types in `t`, arguments included.\nfn type_names(t: ast.TypeExpr) -> List[String] {\n  match t {\n    ast.Named { name, args } => [name] + unused.flat(args.map(a -> unused.type_names(a))),\n    ast.FnType { params, ret } => unused.flat(params.map(a -> unused.type_names(a)))\n      + unused.type_names(ret),\n    ast.Refined { base, .. } => unused.type_names(base),\n    ast.UnionType(ms) => unused.flat(ms.map(a -> unused.type_names(a))),\n    ast.UnitType => [],\n  }\n}"},{"name":"walk.use ast","kind":"use","old":"466b3062f6a4fcbf","new":"a8f7056f23854d0b","interface_changed":true,"affected":[],"module":"walk","text":"// walk: rebuilding a tree one level at a time, for the passes that rewrite\n// it (`desugar`, `derive`). Each function applies `fe` and `ft` to the direct\n// children only, so a pass recurses where it wants: innermost first, or\n// stopping at a node it rewrites whole.\n\nfrom ast use DeriveFnDef, ModelDecl, ModelDef, Decl, DeclKind, TypeDecl, Field,\n  Variant, FnDecl, Param, Bound, TestDecl, TraitDecl, TraitMethod, Law,\n  ImplDecl, ExternDecl, CapabilityDecl, TypeExpr, Expr, LamParam, CompFor, Arm,\n  Stmt, Pattern, SelectArm, StrPart, CtorArgs, CtorPat, TypeDef, FnDef, TestDef,\n  TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, Alias, RecordBody,\n  SumBody, NoPayload, Positional, RecordPayload, MemberType, ExternFn,\n  ExternType, ExternStatic, ExternThreadStatic, Named, FnType, UnitType,\n  Refined, UnionType, RowType, TupleExpr, ListExpr, CtorExpr, Call, MethodCall,\n  FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr, MutExpr, Block,\n  MockExpr, Return, Try, Except, Interp, Range, Index, Comp, DictExpr, SetExpr,\n  Fallback, Comptime, Scope, Spawn, Await, Select, Race, SupervisedSpawn, Old,\n  Assumed, Spread, NoArgs, PositionalArgs, RecordArgs, UpdateArgs, TextPart,\n  ValuePart, Let, VarDecl, Assign, While, For, Loop, ExprStmt, Assert,\n  ComptimeFor, Invariant, Decreases, CtorPattern, ListPat, TuplePat, CondPat,\n  OrPat, ForPat, NoPats, PositionalPats, RecordPats, TypePats, AssertBy, Calc","old_text":"// walk: rebuilding a tree one level at a time, for the passes that rewrite\n// it (`desugar`, `derive`). Each function applies `fe` and `ft` to the direct\n// children only, so a pass recurses where it wants: innermost first, or\n// stopping at a node it rewrites whole.\n\nfrom ast use DeriveFnDef, ModelDecl, ModelDef, Decl, DeclKind, TypeDecl, Field,\n  Variant, FnDecl, Param, Bound, TestDecl, TraitDecl, TraitMethod, Law,\n  ImplDecl, ExternDecl, CapabilityDecl, TypeExpr, Expr, LamParam, CompFor, Arm,\n  Stmt, Pattern, SelectArm, StrPart, CtorArgs, CtorPat, TypeDef, FnDef, TestDef,\n  TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, Alias, RecordBody,\n  SumBody, NoPayload, Positional, RecordPayload, MemberType, ExternFn,\n  ExternType, ExternStatic, ExternThreadStatic, Named, FnType, UnitType,\n  Refined, UnionType, TupleExpr, ListExpr, CtorExpr, Call, MethodCall, FieldOf,\n  Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr, MutExpr, Block, MockExpr,\n  Return, Try, Except, Interp, Range, Index, Comp, DictExpr, SetExpr, Fallback,\n  Comptime, Scope, Spawn, Await, Select, Race, SupervisedSpawn, Old, Assumed,\n  Spread, NoArgs, PositionalArgs, RecordArgs, UpdateArgs, TextPart, ValuePart,\n  Let, VarDecl, Assign, While, For, Loop, ExprStmt, Assert, ComptimeFor,\n  Invariant, Decreases, CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat,\n  NoPats, PositionalPats, RecordPats, TypePats, AssertBy, Calc"},{"name":"walk.type_children","kind":"fn","old":"7167f13a7d75768d","new":"1c924f5169f43cf8","interface_changed":false,"affected":[],"module":"walk","text":"/// `t` with `fe` applied to each expression directly in it (a refinement's\n/// condition) and `ft` to each type directly in it (a type argument).\npub fn type_children(\n  t: ast.TypeExpr,\n  fe: (ast.Expr) -> ast.Expr,\n  ft: (ast.TypeExpr) -> ast.TypeExpr,\n) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => ast.Named { name, args: args.map(a -> ft(a)) },\n    ast.FnType { params, ret } => ast.FnType { params: params.map(a -> ft(a)), ret: ft(ret) },\n    ast.UnitType => ast.UnitType,\n    ast.Refined { base, pred } => ast.Refined { base: ft(base), pred: fe(pred) },\n    ast.RowType(fs) => ast.RowType(fs.map(f -> (f.0, ft(f.1)))),\n    ast.UnionType(ts) => ast.UnionType(ts.map(a -> ft(a))),\n  }\n}","old_text":"/// `t` with `fe` applied to each expression directly in it (a refinement's\n/// condition) and `ft` to each type directly in it (a type argument).\npub fn type_children(\n  t: ast.TypeExpr,\n  fe: (ast.Expr) -> ast.Expr,\n  ft: (ast.TypeExpr) -> ast.TypeExpr,\n) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, args } => ast.Named { name, args: args.map(a -> ft(a)) },\n    ast.FnType { params, ret } => ast.FnType { params: params.map(a -> ft(a)), ret: ft(ret) },\n    ast.UnitType => ast.UnitType,\n    ast.Refined { base, pred } => ast.Refined { base: ft(base), pred: fe(pred) },\n    ast.UnionType(ts) => ast.UnionType(ts.map(a -> ft(a))),\n  }\n}"},{"name":"walk.type_kids","kind":"fn","old":"a8ed45489eac5c3b","new":"d2aae3a03fb467ca","interface_changed":false,"affected":[],"module":"walk","text":"pub fn type_kids(t: ast.TypeExpr) -> (List[ast.TypeExpr], List[ast.Expr]) {\n  match t {\n    ast.Named { args, .. } => (args, []),\n    ast.FnType { params, ret } => (params + [ret], []),\n    ast.UnitType => ([], []),\n    ast.Refined { base, pred } => ([base], [pred]),\n    ast.RowType(fs) => (fs.map(f -> f.1), []),\n    ast.UnionType(ts) => (ts, []),\n  }\n}","old_text":"pub fn type_kids(t: ast.TypeExpr) -> (List[ast.TypeExpr], List[ast.Expr]) {\n  match t {\n    ast.Named { args, .. } => (args, []),\n    ast.FnType { params, ret } => (params + [ret], []),\n    ast.UnitType => ([], []),\n    ast.Refined { base, pred } => ([base], [pred]),\n    ast.UnionType(ts) => (ts, []),\n  }\n}"}]}
{"id":"81869e011bc4be62","time":1795708421,"message":"edit","changes":[{"name":"check.Inf","kind":"type","old":"6ac8287c131ac814","new":"736b232aa43369b8","interface_changed":true,"affected":["check.fresh","check.resolve","check.res","check.unify","check.error","check.expect","check.join_union","check.numeric","check.fresh_for","check.place","check.bind_typed","check.infer_all","check.binary","check.infer_block","check.infer_call","check.infer_if","check.infer_list","check.infer_match","check.infer_ctor","check.infer_lambda","check.infer","check.infer_method","check.var_type","check.is_sum","check.fresh_scheme","check.builtin_call","check.fits_all","check.element_of","check.fits","check.arm_variants","check.implements","check.bound_method","check.program_type","check.static_call","check.arm_members","check.as_trait","check.trait_method","check.fn_inferred","check.annotated","check.next_let","check.fill","check.wrong_try","check.not_result","check.not_iterable","check.check_spec","check.early_error","check.awaited","check.not_awaitable","check.outside_scope","check.own_trait_of","check.trait_fn","check.reaches","check.solve_pending","check.holds_sender","check.written_calls","check.infer_untagged","check.sized_expected","check.int_literal","check.sized_operands","check.task_body","check.fill_arms","check.lam_unmarked","check.holes_found","check.code_trait_method","check.default_errors","check.owned_reads","check.traits_declaring","check.implements_trait","check.ambiguity","check.self_args","check.named_refinement","check.excluded_by","check.ctor_fields","check.member_for","check.cover_of","check.atoms","check.covers","check.missing","check.useful","check.check_coverage","check.type_of_column","check.mut_narrower","check.written_cover","check.refinement_within","check.code_method_problem","check.unmet_bound","check.iter_builtin","check.own_calls","check.trait_fn_of","check.element_assigned","check.listed_arg","check.as_listed","check.listed_args","check.string_method","check.tuple_taken_apart","check.lam_written","check.unused_values","check.changing_call","check.allocating_arith","check.noalloc_typed","check.spread_calls","check.spread_error","check.infer_spread","check.spread_fn_params","check.spread_method_params","check.spread_method_of","check.spread_filled","check.dropped_results","check.trait_with_method","check.provided_method","check.read_owners","check.named_types","check.row_met","check.field_met","check.fn_errors","check.instantiated","check.fn_lambdas_typed","check.holes_of","check.mark_field_reads","check.own_methods_resolved","check.typed_one","check.decl_type_errors","check.spread_body","check.field_reads","eval_files","instantiated_files","check.lambdas_typed","holes_command","check_summary","finding.uses_of","rename_command","verified_decls","check.typed","check.type_errors_with","check.spreads_resolved","unused.members","command_line","check_command","finding.uses_from","finding.used_by_tree","finding.refs_command","verified_with","static_graph","codegen.new_gen","computed_value","repl_eval","check.type_errors","check_errors_in","literal_errors","expanded","unused.findings","main","strata_command","finding.uses_tree","verified_program","verify_file","build_command","graph_command","graph_diff","tour_graph","codegen.generate","codegen.read_back","comptime_value","repl_command","check_errors_with","edit_errors","literal_errors_of","codegen_with","with_base","unused_of","edit_unused","core_unused","codegen.entry","codegen.compiled_alone","eval.run","smt_file","termination_file","verify_command","build_proofs","alongside_command","search_invariants","diff_command","tour_command","core_rt_text","comptime_values","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","codegen_text","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","run_command","fix_loops","build_core_command","comptime_runner","package_errors","merge_file_command","merged_checks","call_command","edit_command","check_files","move_command","fix_command","edit_in_editor","codegen_file","jit_file","fuzz_file","graph_runs","replay","or_solver_inputs","program_objects","sync_command","check_fn","linked"],"module":"check","text":"/// The inference's state: what type variables stand for, the next fresh\n/// one, the errors found, the program's functions, and the return type of\n/// the function being checked.\ntype Inf = {\n  subst: Dict[Int, check.Ty],\n  next: Int,\n  errs: List[String],\n  fns: Dict[String, check.Ty],\n  ret: check.Ty,\n  types: check.Types,\n  tparams: Set[String],\n  // the traits each type parameter in scope is bound by\n  tbounds: Dict[String, List[String]],\n  // the fields each type parameter in scope has, by its structural bounds\n  trows: Dict[String, List[(String, check.Ty, ast.TypeExpr)]] = Dict[String, List[(String, check.Ty, ast.TypeExpr)]] {},\n  methods: check.Methods,\n  narrowed: Set[String],\n  // the variables an arm assigns to: their declared types there\n  exempt: Set[String],\n  // the variables declared outside the innermost `scope` (None: in none)\n  outside: Option[Set[String]],\n  // the variables from outside the closure or `spawn` being checked\n  captured: Set[String],\n  builtins: Dict[String, List[check.Builtin]],\n  // each variable declared (`x := e`, `mut x := e`) and the type it got, in\n  // the order met; `typed` writes them into the tree\n  lets: List[(String, check.Ty)],\n  // each lambda parameter marked by `lambdas_typed` (`$lam…`) and the type\n  // it got\n  lambdas: Dict[String, check.Ty],\n  // the trait obligations met (a trait's method used as a function: its\n  // `Self`, the trait, the method), solved once the body is checked\n  pending: List[(check.Ty, String, String)],\n  // the type of each call tagged by `instantiated` (`f#3(..)`, `x.m#4(..)`)\n  insts: Dict[String, check.Ty],\n  // each arithmetic operation met (`+`, `-`, ...) and its type. On `Int`,\n  // `String` or `List` it allocates, which `noalloc` code can't do.\n  arith: List[(String, check.Ty)],\n  // each hole met (`?name`): the type it must have, and the variables in\n  // scope there with their types (`strata holes`)\n  holes: List[(String, check.Ty, Dict[String, check.Ty])] = [],\n  // each variable's type as written, when refined (`n: Positive`, or the\n  // refinement an arm named: `Positive => …`); a match on it may leave out\n  // what the refinement excludes\n  written: Dict[String, ast.TypeExpr] = Dict[String, ast.TypeExpr] {},\n  // each argument that is a finite iterator where its parameter is a `List`\n  // (the callee's name, the argument's index, the argument); `as_listed`\n  // converts them with `to_list`\n  as_lists: List[(String, Int, ast.Expr)] = [],\n  // each expression statement met, its type, and the type of the variable\n  // its call's first argument names (`xs` in `push(xs, 1)`), if any. A\n  // value other than `()` is an error once the body is solved (`unused_values`).\n  discarded: List[(ast.Expr, check.Ty, Option[check.Ty])] = [],\n  // each call spreading records (`f(...x)`, tagged `f#s0_1` by\n  // `spread_bound`), written out (`f(x.a, x.b)`), by its tag\n  spreads: Dict[String, ast.Expr] = Dict[String, ast.Expr] {},\n  // the errors of calls spreading records, also in `errs`\n  spread_errs: List[String] = [],\n  // the type of what each `for` runs over; a `noalloc` function can't run\n  // over what needs a list made (`noalloc_typed`)\n  iters: List[check.Ty] = [],\n  // each method called and its receiver's type, for `noalloc_typed`\n  recvs: List[(String, check.Ty)] = [],\n  // each `_ := e` met and the type of `e`; a `Result` thrown away this way\n  // is a warning (`dropped_results`)\n  dropped: List[(ast.Expr, check.Ty)] = [],\n}","old_text":"/// The inference's state: what type variables stand for, the next fresh\n/// one, the errors found, the program's functions, and the return type of\n/// the function being checked.\ntype Inf = {\n  subst: Dict[Int, check.Ty],\n  next: Int,\n  errs: List[String],\n  fns: Dict[String, check.Ty],\n  ret: check.Ty,\n  types: check.Types,\n  tparams: Set[String],\n  // the traits each type parameter in scope is bound by\n  tbounds: Dict[String, List[String]],\n  methods: check.Methods,\n  narrowed: Set[String],\n  // the variables an arm assigns to: their declared types there\n  exempt: Set[String],\n  // the variables declared outside the innermost `scope` (None: in none)\n  outside: Option[Set[String]],\n  // the variables from outside the closure or `spawn` being checked\n  captured: Set[String],\n  builtins: Dict[String, List[check.Builtin]],\n  // each variable declared (`x := e`, `mut x := e`) and the type it got, in\n  // the order met; `typed` writes them into the tree\n  lets: List[(String, check.Ty)],\n  // each lambda parameter marked by `lambdas_typed` (`$lam…`) and the type\n  // it got\n  lambdas: Dict[String, check.Ty],\n  // the trait obligations met (a trait's method used as a function: its\n  // `Self`, the trait, the method), solved once the body is checked\n  pending: List[(check.Ty, String, String)],\n  // the type of each call tagged by `instantiated` (`f#3(..)`, `x.m#4(..)`)\n  insts: Dict[String, check.Ty],\n  // each arithmetic operation met (`+`, `-`, ...) and its type. On `Int`,\n  // `String` or `List` it allocates, which `noalloc` code can't do.\n  arith: List[(String, check.Ty)],\n  // each hole met (`?name`): the type it must have, and the variables in\n  // scope there with their types (`strata holes`)\n  holes: List[(String, check.Ty, Dict[String, check.Ty])] = [],\n  // each variable's type as written, when refined (`n: Positive`, or the\n  // refinement an arm named: `Positive => …`); a match on it may leave out\n  // what the refinement excludes\n  written: Dict[String, ast.TypeExpr] = Dict[String, ast.TypeExpr] {},\n  // each argument that is a finite iterator where its parameter is a `List`\n  // (the callee's name, the argument's index, the argument); `as_listed`\n  // converts them with `to_list`\n  as_lists: List[(String, Int, ast.Expr)] = [],\n  // each expression statement met, its type, and the type of the variable\n  // its call's first argument names (`xs` in `push(xs, 1)`), if any. A\n  // value other than `()` is an error once the body is solved (`unused_values`).\n  discarded: List[(ast.Expr, check.Ty, Option[check.Ty])] = [],\n  // each call spreading records (`f(...x)`, tagged `f#s0_1` by\n  // `spread_bound`), written out (`f(x.a, x.b)`), by its tag\n  spreads: Dict[String, ast.Expr] = Dict[String, ast.Expr] {},\n  // the errors of calls spreading records, also in `errs`\n  spread_errs: List[String] = [],\n  // the type of what each `for` runs over; a `noalloc` function can't run\n  // over what needs a list made (`noalloc_typed`)\n  iters: List[check.Ty] = [],\n  // each method called and its receiver's type, for `noalloc_typed`\n  recvs: List[(String, check.Ty)] = [],\n  // each `_ := e` met and the type of `e`; a `Result` thrown away this way\n  // is a warning (`dropped_results`)\n  dropped: List[(ast.Expr, check.Ty)] = [],\n}"},{"name":"check.Shape","kind":"type","old":"b414cdbb5963ba52","new":"6577ed82cc05005f","interface_changed":true,"affected":["check.Types","check.bind_typed","check.field_of","check.infer_ctor","check.types_of","check.no_shape_of","check.own_calls","codegen.no_shape","codegen.add_type","codegen.new_gen","check.Inf","check.lower","check.param_type","check.methods_of","check.fn_errors","check.builtins_of","check.fn_inferred","check.fn_types","check.fn_lambdas_typed","check.default_errors","check.typed_one","check.decl_type_errors","check.spread_body","check.core_code_type","check.FieldTyping","codegen.Gen","check.rows_by_param","check.row_refined","check.infer_block","check.infer_match","check.infer_untagged","check.typed","check.type_errors_with","check.instantiated","check.lambdas_typed","check.holes_of","check.mark_field_reads","check.