.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// `recv.name(args)`: a method of the receiver's type (a trait value's\n/// through its table), `Type.f(args)` (a static method), else a built-in\n/// with the receiver first.\nfn method_call(\n  mut g: codegen.Gen,\n  recv: ast.Expr,\n  name: String,\n  args: List[ast.Expr],\n  want: check.Ty,\n) -> codegen.V {\n  // (the flags for the call's result: handed on to the function it calls)\n  flags := (g.stack_call, g.result_pos, g.held_call)\n  g.stack_call = false\n  g.result_pos = false\n  g.held_call = false\n  match recv {\n    // a type with arguments as receiver (`List[Int].from_json(j)`), which\n    // `derive` writes as `{ let $type: List[Int] = (); $type }`\n    ast.Block { stmts: [ast.Let { pat: ast.Bind(\"$type\"), ty: Some(tt), .. }], last: ast.Var(\"$type\") } => {\n      t := codegen.lower(mut g, tt)\n      head := match t {\n        check.TUnion(_) => codegen.union_name(g, codegen.key(t)),\n        _ => codegen.head_of(t),\n      }\n      k := codegen.method_key(mut g, head, name)\n      if k != \"\" && !codegen.takes_self(g, k) {\n        w := if want is check.TAny {\n          codegen.self_want(mut g, head, k, t, want)\n        } else {\n          want\n        }\n        return codegen.call_fn_want(mut g, k, [], args, w)\n      }\n    },\n    // a type's method without `self`; otherwise the receiver is a value\n    ast.CtorExpr { name: tn, args: ast.NoArgs } => if codegen.is_type_name(g, tn) {\n      head := match get(g.sub, tn) {\n        Some(t) => codegen.head_of(t),\n        None => tn,\n      }\n      k := codegen.method_key(mut g, head, name)\n      if k != \"\" && !codegen.takes_self(g, k) {\n        // a refined type argument (`T` a `List[Port]`) gives the `impl`'s\n        // parameters theirs (`List[T]`'s `T` a `Port`)\n        match get(g.sub, \"$w:\" + tn) {\n          Some(tw) => {\n            g.pending_w = codegen.impl_written(mut g, head, tw)\n          },\n          None => (),\n        }\n        // a type parameter's `T.zero() -> Self`: `T` gives the `impl`'s\n        // parameters (`List[T]`'s `T`), hence the result type\n        w := match get(g.sub, tn) {\n          Some(t) => if want is check.TAny {\n            codegen.self_want(mut g, head, k, t, want)\n          } else {\n            want\n          },\n          None => want,\n        }\n        return codegen.call_fn_want(mut g, k, [], args, w)\n      }\n      // `T.check(x)`: `Ok(())` when `x` meets the type's refinements\n      if k == \"\" && name == \"check\" && len(args) == 1 {\n        return codegen.type_check(mut g, tn, get(args, 0) ?? ast.UnitExpr)\n      }\n    },\n    _ => (),\n  }\n  // a `mut self` method: the receiver is a place, written back\n  match codegen.place_of(recv) {\n    Some((x, path)) => match codegen.lookup(g, x) {\n      Some(l) => {\n        root := codegen.load(mut g, l)\n        rv := codegen.get_path(mut g, root, path)\n        // a trait value's `mut self` method runs on a copy of the place's\n        // block, then puts it back\n        match rv.ty {\n          check.TTrait(tr) => if codegen.dyn_mut(g, tr, name) {\n            own := codegen.dyn_copy(mut g, rv, tr)\n            r := codegen.dyn_call(mut g, own, tr, name, args)\n            codegen.assign_at(mut g, l, x, path, own, false)\n            return r\n          },\n          _ => (),\n        }\n        k := match codegen.bound_key(mut g, recv, codegen.head_of(rv.ty), name) {\n          \"\" => codegen.method_key(mut g, codegen.head_of(rv.ty), name),\n          bk => bk,\n        }\n        if k != \"\" && codegen.mut_self(g, k) {\n          codegen.hand_on(mut g, flags)\n          return codegen.call_fn_want(mut g, k, [], [recv] + args, want)\n        }\n        // `mut xs.pop()`: the program's function `pop(mut xs: …)`\n        uf := codegen.own_fn(g, name, rv.ty)\n        if k == \"\" && uf != \"\" && codegen.first_mut(g, uf) {\n          codegen.hand_on(mut g, flags)\n          return codegen.call_fn_want(mut g, uf, [], [recv] + args, want)\n        }\n        // `mut xs.push(x)`: a built-in changing the list, dict or set at the\n        // place, assigned back as `xs = push(xs, x)` (in place when nothing\n        // else holds it)\n        if k == \"\" && uf == \"\" && builtins.changing(name) {\n          match builtins.changes_as(\n            codegen.table_kind(rv.ty),\n            recv,\n            name,\n            args,\n          ) {\n            Some(b) => {\n              // `--copies` reports a copy made there as the call's\n              if g.copies {\n                c := ast.MutExpr(ast.MethodCall { recv, name, args })\n                t := text.expr_text(c, 0)\n                if contains(g.sites, g.current + \"|\" + t)\n                  || contains(g.sites, \"|\" + t) {\n                  g.at = c\n                }\n              }\n              // its assignment's update in place, when proven\n              c := ast.MutExpr(ast.MethodCall { recv, name, args })\n              g.proven_put = if len(g.proven) > 0\n                && contains(g.proven, unique.mut_key(g.current, c)) {\n                text.expr_text(recv, 0)\n              } else {\n                \"\"\n              }\n              r := codegen.expr_want(mut g, b, want)\n              g.proven_put = \"\"\n              return r\n            },\n            None => (),\n          }\n        }\n      },\n      None => (),\n    },\n    None => (),\n  }\n  v := codegen.expr(mut g, recv)\n  if v.ty is check.TAny {\n    return v\n  }\n  match v.ty {\n    check.TTrait(tr) => return codegen.dyn_call(mut g, v, tr, name, args),\n    _ => (),\n  }\n  h := match v.ty {\n    check.TUnion(_) => codegen.union_name(g, codegen.key(v.ty)),\n    _ => codegen.head_of(v.ty),\n  }\n  k := match codegen.bound_key(mut g, recv, h, name) {\n    \"\" => codegen.method_key(mut g, h, name),\n    bk => bk,\n  }\n  if k != \"\" {\n    // a sum whose variants have their own `impl`s: dispatch on the tag\n    match v.ty {\n      check.TNamed { name: sn, args: targs } => if contains(g.types.sums, sn) {\n        cs := codegen.ctors_of(g, v.ty)\n        if cs.any(c -> codegen.own_method(g, c, name)) {\n          return codegen.by_variant(\n            mut g,\n            v,\n            cs,\n            targs,\n            k,\n            name,\n            args,\n            want,\n          )\n        }\n      },\n      _ => (),\n    }\n    codegen.hand_on(mut g, flags)\n    codegen.call_fn_want(mut g, k, [v], args, want)\n  } else if codegen.left_out(g, h, name) is Some {\n    // a method a mock type's `impl` leaves out: a generated result\n    match codegen.left_out(g, h, name) {\n      Some((tr, m)) => codegen.mock_call(mut g, v, tr, m, args),\n      None => codegen.never(),\n    }\n  } else if codegen.own_fn(g, name, v.ty) != \"\" {\n    // `x.f(…)`: the program's function `f(x, …)`\n    codegen.hand_on(mut g, flags)\n    codegen.call_fn_want(\n      mut g,\n      codegen.own_fn(g, name, v.ty),\n      [v],\n      args,\n      want,\n    )\n  } else {\n    match v.ty {\n      check.TUnion(ms) => codegen.union_call(mut g, v, ms, name, args),\n      _ => codegen.builtin_call(mut g, name, v, args),\n    }\n  }\n}","old_text":"/// `recv.name(args)`: a method of the receiver's type (a trait value's\n/// through its table), `Type.f(args)` (a static method), else a built-in\n/// with the receiver first.\nfn method_call(\n  mut g: codegen.Gen,\n  recv: ast.Expr,\n  name: String,\n  args: List[ast.Expr],\n  want: Ty,\n) -> codegen.V {\n  // (the flags for the call's result: handed on to the function it calls)\n  flags := (g.stack_call, g.result_pos, g.held_call)\n  g.stack_call = false\n  g.result_pos = false\n  g.held_call = false\n  match recv {\n    // a type with arguments as receiver (`List[Int].from_json(j)`), which\n    // `derive` writes as `{ let $type: List[Int] = (); $type }`\n    ast.Block { stmts: [ast.Let { pat: ast.Bind(\"$type\"), ty: Some(tt), .. }], last: ast.Var(\"$type\") } => {\n      t := codegen.lower(mut g, tt)\n      head := match t {\n        TUnion(_) => codegen.union_name(g, codegen.key(t)),\n        _ => codegen.head_of(t),\n      }\n      k := codegen.method_key(mut g, head, name)\n      if k != \"\" && !codegen.takes_self(g, k) {\n        w := if want is TAny {\n          codegen.self_want(mut g, head, k, t, want)\n        } else {\n          want\n        }\n        return codegen.call_fn_want(mut g, k, [], args, w)\n      }\n    },\n    // a type's method without `self`; otherwise the receiver is a value\n    ast.CtorExpr { name: tn, args: ast.NoArgs } => if codegen.is_type_name(g, tn) {\n      head := match get(g.sub, tn) {\n        Some(t) => codegen.head_of(t),\n        None => tn,\n      }\n      k := codegen.method_key(mut g, head, name)\n      if k != \"\" && !codegen.takes_self(g, k) {\n        // a refined type argument (`T` a `List[Port]`) gives the `impl`'s\n        // parameters theirs (`List[T]`'s `T` a `Port`)\n        match get(g.sub, \"$w:\" + tn) {\n          Some(tw) => {\n            g.pending_w = codegen.impl_written(mut g, head, tw)\n          },\n          None => (),\n        }\n        // a type parameter's `T.zero() -> Self`: `T` gives the `impl`'s\n        // parameters (`List[T]`'s `T`), hence the result type\n        w := match get(g.sub, tn) {\n          Some(t) => if want is TAny {\n            codegen.self_want(mut g, head, k, t, want)\n          } else {\n            want\n          },\n          None => want,\n        }\n        return codegen.call_fn_want(mut g, k, [], args, w)\n      }\n      // `T.check(x)`: `Ok(())` when `x` meets the type's refinements\n      if k == \"\" && name == \"check\" && len(args) == 1 {\n        return codegen.type_check(mut g, tn, get(args, 0) ?? ast.UnitExpr)\n      }\n    },\n    _ => (),\n  }\n  // a `mut self` method: the receiver is a place, written back\n  match codegen.place_of(recv) {\n    Some((x, path)) => match codegen.lookup(g, x) {\n      Some(l) => {\n        root := codegen.load(mut g, l)\n        rv := codegen.get_path(mut g, root, path)\n        // a trait value's `mut self` method runs on a copy of the place's\n        // block, then puts it back\n        match rv.ty {\n          TTrait(tr) => if codegen.dyn_mut(g, tr, name) {\n            own := codegen.dyn_copy(mut g, rv, tr)\n            r := codegen.dyn_call(mut g, own, tr, name, args)\n            codegen.assign_at(mut g, l, x, path, own, false)\n            return r\n          },\n          _ => (),\n        }\n        k := match codegen.bound_key(mut g, recv, codegen.head_of(rv.ty), name) {\n          \"\" => codegen.method_key(mut g, codegen.head_of(rv.ty), name),\n          bk => bk,\n        }\n        if k != \"\" && codegen.mut_self(g, k) {\n          codegen.hand_on(mut g, flags)\n          return codegen.call_fn_want(mut g, k, [], [recv] + args, want)\n        }\n        // `mut xs.pop()`: the program's function `pop(mut xs: …)`\n        uf := codegen.own_fn(g, name, rv.ty)\n        if k == \"\" && uf != \"\" && codegen.first_mut(g, uf) {\n          codegen.hand_on(mut g, flags)\n          return codegen.call_fn_want(mut g, uf, [], [recv] + args, want)\n        }\n        // `mut xs.push(x)`: a built-in changing the list, dict or set at the\n        // place, assigned back as `xs = push(xs, x)` (in place when nothing\n        // else holds it)\n        if k == \"\" && uf == \"\" && builtins.changing(name) {\n          match builtins.changes_as(\n            codegen.table_kind(rv.ty),\n            recv,\n            name,\n            args,\n          ) {\n            Some(b) => {\n              // `--copies` reports a copy made there as the call's\n              if g.copies {\n                c := ast.MutExpr(ast.MethodCall { recv, name, args })\n                t := text.expr_text(c, 0)\n                if contains(g.sites, g.current + \"|\" + t)\n                  || contains(g.sites, \"|\" + t) {\n                  g.at = c\n                }\n              }\n              // its assignment's update in place, when proven\n              c := ast.MutExpr(ast.MethodCall { recv, name, args })\n              g.proven_put = if len(g.proven) > 0\n                && contains(g.proven, unique.mut_key(g.current, c)) {\n                text.expr_text(recv, 0)\n              } else {\n                \"\"\n              }\n              r := codegen.expr_want(mut g, b, want)\n              g.proven_put = \"\"\n              return r\n            },\n            None => (),\n          }\n        }\n      },\n      None => (),\n    },\n    None => (),\n  }\n  v := codegen.expr(mut g, recv)\n  if v.ty is TAny {\n    return v\n  }\n  match v.ty {\n    TTrait(tr) => return codegen.dyn_call(mut g, v, tr, name, args),\n    _ => (),\n  }\n  h := match v.ty {\n    TUnion(_) => codegen.union_name(g, codegen.key(v.ty)),\n    _ => codegen.head_of(v.ty),\n  }\n  k := match codegen.bound_key(mut g, recv, h, name) {\n    \"\" => codegen.method_key(mut g, h, name),\n    bk => bk,\n  }\n  if k != \"\" {\n    // a sum whose variants have their own `impl`s: dispatch on the tag\n    match v.ty {\n      TNamed { name: sn, args: targs } => if contains(g.types.sums, sn) {\n        cs := codegen.ctors_of(g, v.ty)\n        if cs.any(c -> codegen.own_method(g, c, name)) {\n          return codegen.by_variant(\n            mut g,\n            v,\n            cs,\n            targs,\n            k,\n            name,\n            args,\n            want,\n          )\n        }\n      },\n      _ => (),\n    }\n    codegen.hand_on(mut g, flags)\n    codegen.call_fn_want(mut g, k, [v], args, want)\n  } else if codegen.left_out(g, h, name) is Some {\n    // a method a mock type's `impl` leaves out: a generated result\n    match codegen.left_out(g, h, name) {\n      Some((tr, m)) => codegen.mock_call(mut g, v, tr, m, args),\n      None => codegen.never(),\n    }\n  } else if codegen.own_fn(g, name, v.ty) != \"\" {\n    // `x.f(…)`: the program's function `f(x, …)`\n    codegen.hand_on(mut g, flags)\n    codegen.call_fn_want(\n      mut g,\n      codegen.own_fn(g, name, v.ty),\n      [v],\n      args,\n      want,\n    )\n  } else {\n    match v.ty {\n      TUnion(ms) => codegen.union_call(mut g, v, ms, name, args),\n      _ => codegen.builtin_call(mut g, name, v, args),\n    }\n  }\n}"},{"name":"codegen.to_dyn","kind":"fn","old":"8184183e88bb2c2c","new":"b0fa8064c4f1d2c6","interface_changed":false,"affected":[],"module":"codegen","text":"/// `v`, of a concrete type, as a value of trait `tr`.\nfn to_dyn(mut g: codegen.Gen, v: codegen.V, tr: String) -> codegen.V {\n  vt := codegen.vtable(mut g, tr, v.ty)\n  x := codegen.take_value(mut g, v)\n  p := codegen.fresh(mut g, \"dyn\")\n  codegen.use_rt(mut g, \"strata_alloc\")\n  codegen.emit(mut g, f\"{p} = call ptr @strata_alloc(i64 16)\")\n  codegen.emit(mut g, f\"store ptr {vt}, ptr {p}\")\n  at := codegen.fresh(mut g, \"at\")\n  codegen.emit(mut g, f\"{at} = getelementptr i64, ptr {p}, i64 1\")\n  codegen.store_slot(mut g, x, at)\n  codegen.temp(mut g, codegen.V { ty: check.TTrait(tr), op: p })\n}","old_text":"/// `v`, of a concrete type, as a value of trait `tr`.\nfn to_dyn(mut g: codegen.Gen, v: codegen.V, tr: String) -> codegen.V {\n  vt := codegen.vtable(mut g, tr, v.ty)\n  x := codegen.take_value(mut g, v)\n  p := codegen.fresh(mut g, \"dyn\")\n  codegen.use_rt(mut g, \"strata_alloc\")\n  codegen.emit(mut g, f\"{p} = call ptr @strata_alloc(i64 16)\")\n  codegen.emit(mut g, f\"store ptr {vt}, ptr {p}\")\n  at := codegen.fresh(mut g, \"at\")\n  codegen.emit(mut g, f\"{at} = getelementptr i64, ptr {p}, i64 1\")\n  codegen.store_slot(mut g, x, at)\n  codegen.temp(mut g, codegen.V { ty: TTrait(tr), op: p })\n}"},{"name":"codegen.vtable","kind":"fn","old":"581340840fbc71d1","new":"f23236756f9b750d","interface_changed":true,"affected":["codegen.to