ves","kernel_dependent.Contents","kernel_dependent.inductive_named","kernel_dependent.extended","kernel_dependent.recursor_type","kernel_dependent.empty_environment","kernel_dependent.add_inductive","kernel_dependent.SealedEnvironment","kernel_dependent.contents","kernel_dependent.reduce_eliminator","kernel_dependent_tactics.eliminate","kernel_dependent.define","kernel_dependent.declare","kernel_dependent.constant_type","kernel_cli.dependent","kernel_dependent_patch.base","kernel_dependent_patch.add_schema","kernel_dependent_patch.refusals","kernel_dependent.Environment","kernel_dependent.lookup","kernel_dependent.axioms","kernel_dependent.new_name","kernel_dependent.whnf","kernel_dependent_tactics.cases","kernel_dependent_tactics.induction","kernel_dependent_patch.define_generic","kernel_dependent_patch.timed","kernel_dependent_patch.instances","kernel_dependent_tactics.prove","kernel_dependent_patch.core_type","kernel_dependent.infer","kernel_cli.command","kernel_dependent_patch.records","kernel_dependent.convertible","kernel_dependent.sort_of","kernel_dependent.has_type","kernel_dependent.reduce_integer","kernel_dependent_patch.definitions","kernel_dependent_patch.laws","kernel_dependent_patch.Instances","kernel_dependent_patch.refused","kernel_dependent_tactics.Goal","kernel_dependent_tactics.normal","kernel_dependent_tactics.equation_parts","kernel_dependent_tactics.intro","kernel_dependent_tactics.funext","kernel_dependent_tactics.type_in","command_line","kernel_dependent_tactics.exact","kernel_dependent_tactics.simplify","kernel_dependent_tactics.rewrite","kernel_dependent_tactics.subst","kernel_dependent_tactics.Then","kernel_dependent_tactics.show_goal","kernel_dependent_tactics.failure","kernel_dependent_tactics.intros","main","kernel_dependent_tactics.Case","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent","text":"/// A constructor: its type `Π params. Π args. I params`, and per argument\n/// the index in the group of its type when it is recursive, else -1.\npub type Constructor = {\n  name: String,\n  ty: kernel_dependent.Term,\n  recursive: List[Int],\n}","old_text":"/// A constructor: its type `Π params. Π args. I params`, and per argument\n/// whether it is recursive (of type `I params`).\npub type Constructor = {\n  name: String,\n  ty: kernel_dependent.Term,\n  recursive: List[Bool],\n}"},{"name":"kernel_dependent.empty_environment","kind":"fn","old":"80b607f091430f28","new":"4a44a6a3840ece38","interface_changed":false,"affected":["kernel_cli.dependent","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent","text":"/// The environment every theory starts from: `Bool` and its connectives\n/// (`and`, `or`, `not`, `implies`, `ite`), whose meaning the built-in\n/// axioms rely on.\npub fn empty_environment() -> kernel_dependent.Environment {\n  bare := kernel_dependent.Environment(kernel_dependent.SealedEnvironment(\n    kernel_dependent.Contents { entries: [], inductives: [] },\n  ))\n  bool := kernel_dependent.Constant { name: \"Bool\", levels: [] }\n  t := kernel_dependent.Constant { name: \"true\", levels: [] }\n  f := kernel_dependent.Constant { name: \"false\", levels: [] }\n  pick := (a: kernel_dependent.Term, b: kernel_dependent.Term, c: kernel_dependent.Term) ->\n    kernel_dependent.applied(\n      kernel_dependent.Constant { name: \"Bool.rec\", levels: [0] },\n      [kernel_dependent.lambda(\"_b\", bool, bool), a, b, c],\n    )\n  a := kernel_dependent.Free(\"a\")\n  b := kernel_dependent.Free(\"b\")\n  bb := kernel_dependent.pi(\n    \"_\",\n    bool,\n    kernel_dependent.pi(\"_\", bool, bool),\n  )\n  with_bool := kernel_dependent.add_inductives(bare, 0, [(\n    \"Bool\",\n    kernel_dependent.Sort(0),\n    [(\"true\", bool), (\"false\", bool)],\n  )]) !! bare\n  defs := [(\"and\", bb, kernel_dependent.lambda(\n    \"a\",\n    bool,\n    kernel_dependent.lambda(\"b\", bool, pick(b, f, a)),\n  )), (\"or\", bb, kernel_dependent.lambda(\n    \"a\",\n    bool,\n    kernel_dependent.lambda(\"b\", bool, pick(t, b, a)),\n  )), (\"implies\", bb, kernel_dependent.lambda(\n    \"a\",\n    bool,\n    kernel_dependent.lambda(\"b\", bool, pick(b, t, a)),\n  )), (\n    \"not\",\n    kernel_dependent.pi(\"_\", bool, bool),\n    kernel_dependent.lambda(\"a\", bool, pick(f, t, a)),\n  ), (\"ite\", kernel_dependent.pi(\n    \"A\",\n    kernel_dependent.Sort(0),\n    kernel_dependent.pi(\"b\", bool, kernel_dependent.pi(\n      \"x\",\n      kernel_dependent.Free(\"A\"),\n      kernel_dependent.pi(\n        \"y\",\n        kernel_dependent.Free(\"A\"),\n        kernel_dependent.Free(\"A\"),\n      ),\n    )),\n  ), kernel_dependent.lambda(\n    \"A\",\n    kernel_dependent.Sort(0),\n    kernel_dependent.lambda(\"b\", bool, kernel_dependent.lambda(\n      \"x\",\n      kernel_dependent.Free(\"A\"),\n      kernel_dependent.lambda(\n        \"y\",\n        kernel_dependent.Free(\"A\"),\n        kernel_dependent.applied(\n          kernel_dependent.Constant {\n            name: \"Bool.rec\",\n            levels: [0],\n          },\n          [\n            kernel_dependent.lambda(\n              \"_b\",\n              bool,\n              kernel_dependent.Free(\"A\"),\n            ),\n            kernel_dependent.Free(\"x\"),\n            kernel_dependent.Free(\"y\"),\n            kernel_dependent.Free(\"b\"),\n          ],\n        ),\n      ),\n    )),\n  ))]\n  mut env := with_bool\n  for (n, ty, value) in defs {\n    env = kernel_dependent.define(env, n, ty, value) !! env\n  }\n  env\n}","old_text":"pub fn empty_environment() -> kernel_dependent.Environment {\n  kernel_dependent.Environment(kernel_dependent.SealedEnvironment(\n    kernel_dependent.Contents { entries: [], inductives: [] },\n  ))\n}"},{"name":"kernel_dependent.built_in_type","kind":"fn","old":"5da1f44f4a54aa9f","new":"b79a2670502a9d31","interface_changed":false,"affected":["kernel_dependent.is_built_in","kernel_dependent.constant_type","kernel_dependent.new_name","kernel_dependent.infer","kernel_dependent_patch.core_type","kernel_dependent.define","kernel_dependent.declare","kernel_dependent.add_inductives","kernel_dependent.sort_of","kernel_dependent.has_type","kernel_dependent_patch.instances","kernel_dependent_tactics.type_in","kernel_dependent_patch.records","kernel_dependent.empty_environment","kernel_dependent_patch.base","kernel_dependent_patch.define_generic","kernel_dependent_patch.timed","kernel_dependent_patch.add_schema","kernel_dependent_patch.refusals","kernel_dependent_tactics.prove","kernel_dependent.add_inductive","kernel_dependent_tactics.rewrite","kernel_dependent_tactics.funext","kernel_dependent_tactics.eliminate","kernel_dependent_tactics.subst","kernel_dependent_tactics.exact","kernel_cli.dependent","kernel_dependent_patch.definitions","kernel_dependent_patch.laws","kernel_dependent_tactics.cases","kernel_dependent_tactics.induction","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent","text":"/// The types of the built-in constants: `Eq`, `refl`, `J` and `funext` at\n/// their levels; `Int`, its literals and operations (which compute on\n/// literals) and its axioms; `eqv`, `all`, `some` (classical equality and\n/// quantifiers as Bools, the HOL kernel's logic) with their rules; and\n/// `oracle`, which a law resting on an outside claim uses.\nfn built_in_type(\n  name: String,\n  levels: List[Int],\n) -> Option[kernel_dependent.Term] {\n  a_type := kernel_dependent.Free(\"A\")\n  a := kernel_dependent.Free(\"a\")\n  b := kernel_dependent.Free(\"b\")\n  p := kernel_dependent.Free(\"P\")\n  x := kernel_dependent.Free(\"x\")\n  i := kernel_dependent.int_type()\n  bool := kernel_dependent.bool_type()\n  if levels == [] {\n    if kernel_dependent.is_numeral(name) || name == \"Int\" {\n      return Some(if name == \"Int\" {\n        kernel_dependent.Sort(0)\n      } else {\n        i\n      })\n    }\n    pred := kernel_dependent.pi(\"_\", a_type, bool)\n    px := kernel_dependent.Apply { function: p, argument: x }\n    return match name {\n      \"int.neg\" => Some(kernel_dependent.pi(\"_\", i, i)),\n      \"int.add\" | \"int.sub\" | \"int.mul\" => Some(\n        kernel_dependent.pi(\"_\", i, kernel_dependent.pi(\"_\", i, i)),\n      ),\n      \"int.lt\" | \"int.le\" | \"int.eq\" => Some(\n        kernel_dependent.pi(\n          \"_\",\n          i,\n          kernel_dependent.pi(\"_\", i, bool),\n        ),\n      ),\n      \"eqv\" => Some(kernel_dependent.pi(\n        \"A\",\n        kernel_dependent.Sort(0),\n        kernel_dependent.pi(\n          \"a\",\n          a_type,\n          kernel_dependent.pi(\"b\", a_type, bool),\n        ),\n      )),\n      \"eqv_intro\" => Some(kernel_dependent.pi(\n        \"A\",\n        kernel_dependent.Sort(0),\n        kernel_dependent.pi(\n          \"a\",\n          a_type,\n          kernel_dependent.pi(\"b\", a_type, kernel_dependent.pi(\n            \"_\",\n            kernel_dependent.equality(0, a_type, a, b),\n            kernel_dependent.holds(\n              kernel_dependent.eqv(a_type, a, b),\n            ),\n          )),\n        ),\n      )),\n      \"eqv_elim\" => Some(kernel_dependent.pi(\n        \"A\",\n        kernel_dependent.Sort(0),\n        kernel_dependent.pi(\n          \"a\",\n          a_type,\n          kernel_dependent.pi(\"b\", a_type, kernel_dependent.pi(\n            \"_\",\n            kernel_dependent.holds(\n              kernel_dependent.eqv(a_type, a, b),\n            ),\n            kernel_dependent.equality(0, a_type, a, b),\n          )),\n        ),\n      )),\n      \"all\" | \"some\" => Some(kernel_dependent.pi(\n        \"A\",\n        kernel_dependent.Sort(0),\n        kernel_dependent.pi(\"_\", pred, bool),\n      )),\n      \"all_intro\" => Some(kernel_dependent.pi(\n        \"A\",\n        kernel_dependent.Sort(0),\n        kernel_dependent.pi(\"P\", pred, kernel_dependent.pi(\n          \"_\",\n          kernel_dependent.pi(\n            \"x\",\n            a_type,\n            kernel_dependent.holds(px),\n          ),\n          kernel_dependent.holds(kernel_dependent.applied(\n            kernel_dependent.Constant { name: \"all\", levels: [] },\n            [a_type, p],\n          )),\n        )),\n      )),\n      \"all_elim\" => Some(kernel_dependent.pi(\n        \"A\",\n        kernel_dependent.Sort(0),\n        kernel_dependent.pi(\"P\", pred, kernel_dependent.pi(\n          \"_\",\n          kernel_dependent.holds(kernel_dependent.applied(\n            kernel_dependent.Constant { name: \"all\", levels: [] },\n            [a_type, p],\n          )),\n          kernel_dependent.pi(\n            \"x\",\n            a_type,\n            kernel_dependent.holds(px),\n          ),\n        )),\n      )),\n      \"some_intro\" => Some(kernel_dependent.pi(\n        \"A\",\n        kernel_dependent.Sort(0),\n        kernel_dependent.pi(\n          \"P\",\n          pred,\n          kernel_dependent.pi(\"x\", a_type, kernel_dependent.pi(\n            \"_\",\n            kernel_dependent.holds(px),\n            kernel_dependent.holds(kernel_dependent.applied(\n              kernel_dependent.Constant { name: \"some\", levels: [] },\n              [a_type, p],\n            )),\n          )),\n        ),\n      )),\n      \"some_elim\" => {\n        q := kernel_dependent.Free(\"q\")\n        Some(kernel_dependent.pi(\n          \"A\",\n          kernel_dependent.Sort(0),\n          kernel_dependent.pi(\n            \"P\",\n            pred,\n            kernel_dependent.pi(\"q\", bool, kernel_dependent.pi(\n              \"_\",\n              kernel_dependent.holds(kernel_dependent.applied(\n                kernel_dependent.Constant {\n                  name: \"some\",\n                  levels: [],\n                },\n                [a_type, p],\n              )),\n              kernel_dependent.pi(\n                \"_\",\n                kernel_dependent.pi(\n                  \"x\",\n                  a_type,\n                  kernel_dependent.pi(\n                    \"_\",\n                    kernel_dependent.holds(px),\n                    kernel_dependent.holds(q),\n                  ),\n                ),\n                kernel_dependent.holds(q),\n              ),\n            )),\n          ),\n        ))\n      },\n      \"oracle\" => Some(kernel_dependent.pi(\"P\", kernel_dependent.Sort(0), p)),\n      _ => kernel_dependent.integer_axiom(name),\n    }\n  }\n  l := get(levels, 0) ?? -1\n  m := get(levels, 1) ?? -1\n  if l < 0 || name != \"Eq\" && name != \"refl\" && m < 0 {\n    return None\n  }\n  if name == \"Eq\" && len(levels) == 1 {\n    Some(kernel_dependent.pi(\n      \"A\",\n      kernel_dependent.Sort(l),\n      kernel_dependent.pi(\n        \"a\",\n        a_type,\n        kernel_dependent.pi(\"b\", a_type, kernel_dependent.Sort(l)),\n      ),\n    ))\n  } else if name == \"refl\" && len(levels) == 1 {\n    Some(kernel_dependent.pi(\n      \"A\",\n      kernel_dependent.Sort(l),\n      kernel_dependent.pi(\n        \"a\",\n        a_type,\n        kernel_dependent.equality(l, a_type, a, a),\n      ),\n    ))\n  } else if name == \"J\" && len(levels) == 2 {\n    motive := kernel_dependent.Free(\"motive\")\n    Some(kernel_dependent.pi(\n      \"A\",\n      kernel_dependent.Sort(l),\n      kernel_dependent.pi(\"a\", a_type, kernel_dependent.pi(\n        \"motive\",\n        kernel_dependent.pi(\"b\", a_type, kernel_dependent.pi(\n          \"e\",\n          kernel_dependent.equality(l, a_type, a, b),\n          kernel_dependent.Sort(m),\n        )),\n        kernel_dependent.pi(\"r\", kernel_dependent.applied(\n          motive,\n          [a, kernel_dependent.reflexivity(l, a_type, a)],\n        ), kernel_dependent.pi(\"b\", a_type, kernel_dependent.pi(\n          \"e\",\n          kernel_dependent.equality(l, a_type, a, b),\n          kernel_dependent.applied(\n            motive,\n            [b, kernel_dependent.Free(\"e\")],\n          ),\n        ))),\n      )),\n    ))\n  } else if name == \"funext\" && len(levels) == 2 {\n    b_type := kernel_dependent.Free(\"B\")\n    f := kernel_dependent.Free(\"f\")\n    g := kernel_dependent.Free(\"g\")\n    fs := kernel_dependent.pi(\n      \"x\",\n      a_type,\n      kernel_dependent.Apply { function: b_type, argument: x },\n    )\n    Some(kernel_dependent.pi(\n      \"A\",\n      kernel_dependent.Sort(l),\n      kernel_dependent.pi(\n        \"B\",\n        kernel_dependent.pi(\"x\", a_type, kernel_dependent.Sort(m)),\n        kernel_dependent.pi(\n          \"f\",\n          fs,\n          kernel_dependent.pi(\n            \"g\",\n            fs,\n            kernel_dependent.pi(\"h\", kernel_dependent.pi(\n              \"x\",\n              a_type,\n              kernel_dependent.equality(\n                m,\n                kernel_dependent.Apply {\n                  function: b_type,\n                  argument: x,\n                },\n                kernel_dependent.Apply { function: f, argument: x },\n                kernel_dependent.Apply { function: g, argument: x },\n              ),\n            ), kernel_dependent.equality(\n              kernel_dependent.larger(l, m),\n              fs,\n              f,\n              g,\n            )),\n          ),\n        ),\n      ),\n    ))\n  } else {\n    None\n  }\n}","old_text":"/// The types of `Eq`, `refl`, `J` (equality's eliminator, which reduces on\n/// `refl`) and `funext` (an axiom), at their levels.\nfn built_in_type(\n  name: String,\n  levels: List[Int],\n) -> Option[kernel_dependent.Term] {\n  a_type := kernel_dependent.Free(\"A\")\n  a := kernel_dependent.Free(\"a\")\n  b := kernel_dependent.Free(\"b\")\n  l := get(levels, 0) ?? -1\n  m := get(levels, 1) ?? -1\n  if l < 0 || name != \"Eq\" && name != \"refl\" && m < 0 {\n    return None\n  }\n  if name == \"Eq\" && len(levels) == 1 {\n    Some(kernel_dependent.pi(\n      \"A\",\n      kernel_dependent.Sort(l),\n      kernel_dependent.pi(\n        \"a\",\n        a_type,\n        kernel_dependent.pi(\"b\", a_type, kernel_dependent.Sort(l)),\n      ),\n    ))\n  } else if name == \"refl\" && len(levels) == 1 {\n    Some(kernel_dependent.pi(\n      \"A\",\n      kernel_dependent.Sort(l),\n      kernel_dependent.pi(\n        \"a\",\n        a_type,\n        kernel_dependent.equality(l, a_type, a, a),\n      ),\n    ))\n  } else if name == \"J\" && len(levels) == 2 {\n    motive := kernel_dependent.Free(\"motive\")\n    Some(kernel_dependent.pi(\n      \"A\",\n      kernel_dependent.Sort(l),\n      kernel_dependent.pi(\"a\", a_type, kernel_dependent.pi(\n        \"motive\",\n        kernel_dependent.pi(\"b\", a_type, kernel_dependent.pi(\n          \"e\",\n          kernel_dependent.equality(l, a_type, a, b),\n          kernel_dependent.Sort(m),\n        )),\n        kernel_dependent.pi(\"r\", kernel_dependent.applied(\n          motive,\n          [a, kernel_dependent.reflexivity(l, a_type, a)],\n        ), kernel_dependent.pi(\"b\", a_type, kernel_dependent.pi(\n          \"e\",\n          kernel_dependent.equality(l, a_type, a, b),\n          kernel_dependent.applied(\n            motive,\n            [b, kernel_dependent.Free(\"e\")],\n          ),\n        ))),\n      )),\n    ))\n  } else if name == \"funext\" && len(levels) == 2 {\n    b_type := kernel_dependent.Free(\"B\")\n    x := kernel_dependent.Free(\"x\")\n    f := kernel_dependent.Free(\"f\")\n    g := kernel_dependent.Free(\"g\")\n    fs := kernel_dependent.pi(\n      \"x\",\n      a_type,\n      kernel_dependent.Apply { function: b_type, argument: x },\n    )\n    Some(kernel_dependent.pi(\n      \"A\",\n      kernel_dependent.Sort(l),\n      kernel_dependent.pi(\n        \"B\",\n        kernel_dependent.pi(\"x\", a_type, kernel_dependent.Sort(m)),\n        kernel_dependent.pi(\n          \"f\",\n          fs,\n          kernel_dependent.pi(\n            \"g\",\n            fs,\n            kernel_dependent.pi(\"h\", kernel_dependent.pi(\n              \"x\",\n              a_type,\n              kernel_dependent.equality(\n                m,\n                kernel_dependent.Apply {\n                  function: b_type,\n                  argument: x,\n                },\n                kernel_dependent.Apply { function: f, argument: x },\n                kernel_dependent.Apply { function: g, argument: x },\n              ),\n            ), kernel_dependent.equality(\n              kernel_dependent.larger(l, m),\n              fs,\n              f,\n              g,\n            )),\n          ),\n        ),\n      ),\n    ))\n  } else {\n    None\n  }\n}"},{"name":"kernel_dependent.is_built_in","kind":"fn","old":"4d1727f120481f5d","new":"87e04528d006f5cd","interface_changed":false,"affected":["kernel_dependent.new_name","kernel_dependent.define","kernel_dependent.declare","kernel_dependent.add_inductives","kernel_dependent.empty_environment","kernel_dependent_patch.base","kernel_dependent_patch.define_generic","kernel_dependent_patch.timed","kernel_dependent_patch.add_schema","kernel_dependent_patch.instances","kernel_dependent_patch.refusals","kernel_dependent_tactics.prove","kernel_dependent_patch.core_type","kernel_dependent.add_inductive","kernel_cli.dependent","kernel_dependent_patch.definitions","kernel_dependent_patch.laws","kernel_dependent_patch.records","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent","text":"fn is_built_in(name: String) -> Bool {\n  kernel_dependent.built_in_type(name, []) != None\n    || contains([\"Eq\", \"refl\", \"J\", \"funext\"], name)\n}","old_text":"fn is_built_in(name: String) -> Bool {\n  contains([\"Eq\", \"refl\", \"J\", \"funext\"], name)\n}"},{"name":"kernel_dependent.recursor_type","kind":"fn","old":"05ef14d0c389b72e","new":"728c96147b6c858a","interface_changed":true,"affected":["kernel_dependent.constant_type","kernel_dependent.infer","kernel_dependent_patch.core_type","kernel_dependent.sort_of","kernel_dependent.has_type","kernel_dependent_patch.instances","kernel_dependent_tactics.type_in","kernel_dependent_patch.records","kernel_dependent.define","kernel_dependent.add_inductives","kernel_dependent_tactics.rewrite","kernel_dependent_tactics.funext","kernel_dependent_tactics.eliminate","kernel_dependent_tactics.subst","kernel_dependent_tactics.exact","kernel_cli.dependent","kernel_dependent.empty_environment","kernel_dependent_patch.base","kernel_dependent_patch.define_generic","kernel_dependent_patch.timed","kernel_dependent_patch.add_schema","kernel_dependent_patch.refusals","kernel_dependent_tactics.prove","kernel_dependent.add_inductive","kernel_dependent_patch.laws","kernel_dependent_tactics.cases","kernel_dependent_tactics.induction","kernel_cli.command","kernel_dependent_patch.definitions","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent","text":"/// The recursor's type of `ind`, a member of its group: `Π params. Π\n/// motives (one per type of the group). Π minors (one per constructor of\n/// the group, in order: `Π args. Π (ih: motive_k a) for each recursive a\n/// of type k. motive (c params args)`). Π (x: ind params). motive x`.\nfn recursor_type(\n  env: kernel_dependent.Environment,\n  ind: kernel_dependent.Inductive,\n  m: Int,\n) -> kernel_dependent.Term {\n  ps := kernel_dependent.peel(ind.ty, ind.params, \"#p\").0\n  pvars := ps.map(p -> kernel_dependent.Free(p.0))\n  self_of := (k: Int) -> kernel_dependent.applied(kernel_dependent.Constant {\n    name: get(ind.group, k) ?? ind.name,\n    levels: [],\n  }, pvars)\n  motive_of := (k: Int) -> kernel_dependent.Free(\"#motive\" + to_string(k))\n  mut minors := []\n  mut own := 0\n  for (k, n) in enumerate(ind.group) {\n    if n == ind.name {\n      own = k\n    }\n    for c in (kernel_dependent.inductive_named(env, n) ?? ind).constructors {\n      args := kernel_dependent.peel(\n        kernel_dependent.peel(c.ty, ind.params, \"#p\").1,\n        -1,\n        \"#a\",\n      ).0\n      mut body := kernel_dependent.Apply {\n        function: motive_of(k),\n        argument: kernel_dependent.applied(\n          kernel_dependent.Constant { name: c.name, levels: [] },\n          pvars + args.map(a -> kernel_dependent.Free(a.0)),\n        ),\n      }\n      for (j, a) in enumerate(args).reversed() {\n        r := get(c.recursive, j) ?? -1\n        if r >= 0 {\n          body = kernel_dependent.pi(\n            \"#ih\" + to_string(j),\n            kernel_dependent.Apply {\n              function: motive_of(r),\n              argument: kernel_dependent.Free(a.0),\n            },\n            body,\n          )\n        }\n      }\n      for a in args.reversed() {\n        body = kernel_dependent.pi(a.0, a.1, body)\n      }\n      mut minors.push(body)\n    }\n  }\n  mut out := kernel_dependent.pi(\"#x\", self_of(own), kernel_dependent.Apply {\n    function: motive_of(own),\n    argument: kernel_dependent.Free(\"#x\"),\n  })\n  for (k, minor) in enumerate(minors).reversed() {\n    out = kernel_dependent.pi(\"#minor\" + to_string(k), minor, out)\n  }\n  for (k, _) in enumerate(ind.group).reversed() {\n    out = kernel_dependent.pi(\n      \"#motive\" + to_string(k),\n      kernel_dependent.pi(\n        \"#x\",\n        self_of(k),\n        kernel_dependent.Sort(m),\n      ),\n      out,\n    )\n  }\n  for p in ps.reversed() {\n    out = kernel_dependent.pi(p.0, p.1, out)\n  }\n  out\n}","old_text":"/// `I.rec.{m} : Π params. Π (motive: I params → Sort m). Π minors. Π (x: I\n/// params). motive x`, a minor per constructor `c`: `Π args. Π (ih: motive\n/// a) for each recursive a. motive (c params args)`.\nfn recursor_type(\n  ind: kernel_dependent.Inductive,\n  m: Int,\n) -> kernel_dependent.Term {\n  ps := kernel_dependent.peel(ind.ty, ind.params, \"#p\").0\n  self := kernel_dependent.applied(\n    kernel_dependent.Constant { name: ind.name, levels: [] },\n    ps.map(p -> kernel_dependent.Free(p.0)),\n  )\n  motive := kernel_dependent.Free(\"#motive\")\n  mut minors := []\n  for c in ind.constructors {\n    args := kernel_dependent.peel(\n      kernel_dependent.peel(c.ty, ind.params, \"#p\").1,\n      -1,\n      \"#a\",\n    ).0\n    mut body := kernel_dependent.Apply {\n      function: motive,\n      argument: kernel_dependent.applied(\n        kernel_dependent.Constant { name: c.name, levels: [] },\n        ps.map(p -> kernel_dependent.Free(p.0))\n          + args.map(a -> kernel_dependent.Free(a.0)),\n      ),\n    }\n    for (j, a) in enumerate(args).reversed() {\n      if get(c.recursive, j) ?? false {\n        body = kernel_dependent.pi(\n          \"#ih\" + to_string(j),\n          kernel_dependent.Apply {\n            function: motive,\n            argument: kernel_dependent.Free(a.0),\n          },\n          body,\n        )\n      }\n    }\n    for a in args.reversed() {\n      body = kernel_dependent.pi(a.0, a.1, body)\n    }\n    mut minors.push(body)\n  }\n  mut out := kernel_dependent.pi(\"#x\", self, kernel_dependent.Apply {\n    function: motive,\n    argument: kernel_dependent.Free(\"#x\"),\n  })\n  for (k, minor) in enumerate(minors).reversed() {\n    out = kernel_dependent.pi(\"#minor\" + to_string(k), minor, out)\n  }\n  out = kernel_dependent.pi(\n    \"#motive\",\n    kernel_dependent.pi(\"#x\", self, kernel_dependent.Sort(m)),\n    out,\n  )\n  for p in ps.reversed() {\n    out = kernel_dependent.pi(p.0, p.1, out)\n  }\n  out\n}"},{"name":"kernel_dependent.constant_type","kind":"fn","old":"4ab0244ec598b2cb","new":"f0ff222347c9e0c8","interface_changed":false,"affected":["kernel_dependent.infer","kernel_dependent_patch.core_type","kernel_dependent.sort_of","kernel_dependent.has_type","kernel_dependent_patch.instances","kernel_dependent_tactics.type_in","kernel_dependent_patch.records","kernel_dependent.define","kernel_dependent.add_inductives","kernel_dependent_tactics.rewrite","kernel_dependent_tactics.funext","kernel_dependent_tactics.eliminate","kernel_dependent_tactics.subst","kernel_dependent_tactics.exact","kernel_cli.dependent","kernel_dependent.empty_environment","kernel_dependent_patch.base","kernel_dependent_patch.define_generic","kernel_dependent_patch.timed","kernel_dependent_patch.add_schema","kernel_dependent_patch.refusals","kernel_dependent_tactics.prove","kernel_dependent.add_inductive","kernel_dependent_patch.laws","kernel_dependent_tactics.cases","kernel_dependent_tactics.induction","kernel_cli.command","kernel_dependent_patch.definitions","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent","text":"/// The type of the constant `name` at `levels`.\npub fn constant_type(\n  env: kernel_dependent.Environment,\n  name: String,\n  levels: List[Int],\n) -> Result[kernel_dependent.Term, String] {\n  match kernel_dependent.built_in_type(name, levels) {\n    Some(t) => return Ok(t),\n    None => (),\n  }\n  for ind in kernel_dependent.contents(env).inductives {\n    if ind.name + \".rec\" == name {\n      return match levels {\n        [m] => if m >= 0 {\n          Ok(kernel_dependent.recursor_type(env, ind, m))\n        } else {\n          Err(\"a negative level\")\n        },\n        _ => Err(\"`\" + name + \"` takes one level\"),\n      }\n    }\n  }\n  match kernel_dependent.lookup(env, name) {\n    Some(e) => if levels == [] {\n      Ok(e.ty)\n    } else {\n      Err(\"`\" + name + \"` takes no levels\")\n    },\n    None => Err(\"no constant `\" + name + \"`\"),\n  }\n}","old_text":"/// The type of the constant `name` at `levels`.\npub fn constant_type(\n  env: kernel_dependent.Environment,\n  name: String,\n  levels: List[Int],\n) -> Result[kernel_dependent.Term, String] {\n  match kernel_dependent.built_in_type(name, levels) {\n    Some(t) => return Ok(t),\n    None => (),\n  }\n  for ind in kernel_dependent.contents(env).inductives {\n    if ind.name + \".rec\" == name {\n      return match levels {\n        [m] => if m >= 0 {\n          Ok(kernel_dependent.recursor_type(ind, m))\n        } else {\n          Err(\"a negative level\")\n        },\n        _ => Err(\"`\" + name + \"` takes one level\"),\n      }\n    }\n  }\n  match kernel_dependent.lookup(env, name) {\n    Some(e) => if levels == [] {\n      Ok(e.ty)\n    } else {\n      Err(\"`\" + name + \"` takes no levels\")\n    },\n    None => Err(\"no constant `\" + name + \"`\"),\n  }\n}"},{"name":"kernel_dependent.whnf","kind":"fn","old":"2406fa95e5bac41d","new":"552fb8fc7e95064a","interface_changed":false,"affected":["kernel_dependent.reduce_eliminator","kernel_dependent.convertible","kernel_dependent.infer","kernel_dependent.sort_of","kernel_dependent.reduce_integer","kernel_dependent_patch.records","kernel_dependent_tactics.normal","kernel_dependent_tactics.equation_parts","kernel_dependent_tactics.intro","kernel_dependent_tactics.funext","kernel_dependent_tactics.eliminate","kernel_dependent.has_type","kernel_dependent_tactics.exact","kernel_dependent_tactics.simplify","kernel_dependent_patch.instances","kernel_dependent_tactics.type_in","kernel_dependent.define","kernel_dependent.add_inductives","kernel_dependent_tactics.rewrite","kernel_dependent_tactics.subst","kernel_cli.dependent","kernel_dependent_tactics.failure","kernel_dependent_tactics.cases","kernel_dependent_tactics.intros","kernel_dependent_patch.laws","kernel_dependent_tactics.induction","kernel_dependent.empty_environment","kernel_dependent_patch.base","kernel_dependent_patch.define_generic","kernel_dependent_patch.timed","kernel_dependent_patch.add_schema","kernel_dependent_patch.refusals","kernel_dependent_tactics.prove","kernel_dependent.add_inductive","kernel_cli.command","kernel_dependent_patch.definitions","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent","text":"// ---- reduction and definitional equality ----\n\n/// The weak head normal form of `t`: β, δ (a definition unfolded), ι (a\n/// recursor on a constructor, `J` on `refl`), and integer operations on\n/// literals computed.\npub fn whnf(\n  env: kernel_dependent.Environment,\n  t: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  (head, args) := kernel_dependent.spine(t)\n  match head {\n    kernel_dependent.Lambda { body, .. } => match args {\n      [first, ..rest] => kernel_dependent.whnf(env, kernel_dependent.applied(\n        kernel_dependent.instantiate(body, first, 0),\n        rest,\n      )),\n      [] => t,\n    },\n    kernel_dependent.Constant { name, levels } => match kernel_dependent.lookup(env, name) {\n      Some(kernel_dependent.Entry { value: Some(v), .. }) => kernel_dependent.whnf(env, kernel_dependent.applied(v, args)),\n      _ => match kernel_dependent.reduce_eliminator(env, name, levels, args) {\n        Some(r) => kernel_dependent.whnf(env, r),\n        None => kernel_dependent.reduce_integer(env, name, args) ?? t,\n      },\n    },\n    _ => t,\n  }\n}","old_text":"// ---- reduction and definitional equality ----\n\n/// The weak head normal form of `t`: β, δ (a definition unfolded), ι (a\n/// recursor on a constructor, `J` on `refl`).\npub fn whnf(\n  env: kernel_dependent.Environment,\n  t: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  (head, args) := kernel_dependent.spine(t)\n  match head {\n    kernel_dependent.Lambda { body, .. } => match args {\n      [first, ..rest] => kernel_dependent.whnf(env, kernel_dependent.applied(\n        kernel_dependent.instantiate(body, first, 0),\n        rest,\n      )),\n      [] => t,\n    },\n    kernel_dependent.Constant { name, levels } => match kernel_dependent.lookup(env, name) {\n      Some(kernel_dependent.Entry { value: Some(v), .. }) => kernel_dependent.whnf(env, kernel_dependent.applied(v, args)),\n      _ => match kernel_dependent.reduce_eliminator(env, name, levels, args) {\n        Some(r) => kernel_dependent.whnf(env, r),\n        None => t,\n      },\n    },\n    _ => t,\n  }\n}"},{"name":"kernel_dependent.reduce_eliminator","kind":"fn","old":"2181c4f1b4a79d9b","new":"2535960976ea247c","interface_changed":false,"affected":["kernel_dependent.whnf","kernel_dependent.convertible","kernel_dependent.infer","kernel_dependent.sort_of","kernel_dependent.reduce_integer","kernel_dependent_patch.records","kernel_dependent_tactics.normal","kernel_dependent_tactics.equation_parts","kernel_dependent_tactics.intro","kernel_dependent_tactics.funext","kernel_dependent_tactics.eliminate","kernel_dependent.has_type","kernel_dependent_tactics.exact","kernel_dependent_tactics.simplify","kernel_dependent_patch.instances","kernel_dependent_tactics.type_in","kernel_dependent.define","kernel_dependent.add_inductives","kernel_dependent_tactics.rewrite","kernel_dependent_tactics.subst","kernel_cli.dependent","kernel_dependent_tactics.failure","kernel_dependent_tactics.cases","kernel_dependent_tactics.intros","kernel_dependent_patch.laws","kernel_dependent_tactics.induction","kernel_dependent.empty_environment","kernel_dependent_patch.base","kernel_dependent_patch.define_generic","kernel_dependent_patch.timed","kernel_dependent_patch.add_schema","kernel_dependent_patch.refusals","kernel_dependent_tactics.prove","kernel_dependent.add_inductive","kernel_cli.command","kernel_dependent_patch.definitions","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent","text":"fn reduce_eliminator(\n  env: kernel_dependent.Environment,\n  name: String,\n  levels: List[Int],\n  args: List[kernel_dependent.Term],\n) -> Option[kernel_dependent.Term] {\n  if name == \"J\" {\n    e := get(args, 5)?\n    return match kernel_dependent.spine(kernel_dependent.whnf(env, e)).0 {\n      kernel_dependent.Constant { name: \"refl\", .. } => Some(kernel_dependent.applied(get(args, 3)?, drop(args, 6))),\n      _ => None,\n    }\n  }\n  if !ends_with(name, \".rec\") {\n    return None\n  }\n  for ind in kernel_dependent.contents(env).inductives {\n    if ind.name + \".rec\" == name {\n      n := ind.params\n      g := len(ind.group)\n      members := ind.group.map(\n        x -> kernel_dependent.inductive_named(env, x) ?? ind,\n      )\n      mut k := 0\n      for mem in members {\n        k += len(mem.constructors)\n      }\n      (h, cargs) := kernel_dependent.spine(\n        kernel_dependent.whnf(env, get(args, n + g + k)?),\n      )\n      common := take(args, n + g + k)\n      mut idx := 0\n      for mem in members {\n        for c in mem.constructors {\n          if (mem.name == ind.name\n            && h == kernel_dependent.Constant { name: c.name, levels: [] }\n            && len(cargs) == n + len(c.recursive)) {\n            fields := drop(cargs, n)\n            mut ihs := []\n            for (j, f) in enumerate(fields) {\n              r := get(c.recursive, j) ?? -1\n              if r >= 0 {\n                mut ihs.push(\n                  kernel_dependent.Apply {\n                    function: kernel_dependent.applied(\n                      kernel_dependent.Constant {\n                        name: (get(ind.group, r) ?? \"\") + \".rec\",\n                        levels,\n                      },\n                      common,\n                    ),\n                    argument: f,\n                  },\n                )\n              }\n            }\n            return Some(kernel_dependent.applied(\n              get(args, n + g + idx)?,\n              fields + ihs + drop(args, n + g + k + 1),\n            ))\n          }\n          idx += 1\n        }\n      }\n      return None\n    }\n  }\n  None\n}","old_text":"fn reduce_eliminator(\n  env: kernel_dependent.Environment,\n  name: String,\n  levels: List[Int],\n  args: List[kernel_dependent.Term],\n) -> Option[kernel_dependent.Term] {\n  if name == \"J\" {\n    e := get(args, 5)?\n    return match kernel_dependent.spine(kernel_dependent.whnf(env, e)).0 {\n      kernel_dependent.Constant { name: \"refl\", .. } => Some(kernel_dependent.applied(get(args, 3)?, drop(args, 6))),\n      _ => None,\n    }\n  }\n  for ind in kernel_dependent.contents(env).inductives {\n    if ind.name + \".rec\" == name {\n      n := ind.params\n      k := len(ind.constructors)\n      (h, cargs) := kernel_dependent.spine(\n        kernel_dependent.whnf(env, get(args, n + 1 + k)?),\n      )\n      for (i, c) in enumerate(ind.constructors) {\n        if (h == kernel_dependent.Constant { name: c.name, levels: [] }\n          && len(cargs) == n + len(c.recursive)) {\n          fields := drop(cargs, n)\n          recurse := kernel_dependent.applied(\n            kernel_dependent.Constant { name, levels },\n            take(args, n + 1 + k),\n          )\n          mut ihs := []\n          for (j, f) in enumerate(fields) {\n            if get(c.recursive, j) ?? false {\n              mut ihs.push(\n                kernel_dependent.Apply {\n                  function: recurse,\n                  argument: f,\n                },\n              )\n            }\n          }\n          return Some(kernel_dependent.applied(\n            get(args, n + 1 + i)?,\n            fields + ihs + drop(args, n + k + 2),\n          ))\n        }\n      }\n      return None\n    }\n  }\n  None\n}"},{"name":"kernel_dependent.declare","kind":"fn","old":"85dce9c3ba496c6c","new":"8fc5ce29298073db","interface_changed":false,"affected":["kernel_dependent_patch.core_type","kernel_dependent_patch.records","kernel_cli.dependent","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent","text":"/// The environment with a new type `name : ty` (`ty` a `Sort`), opaque.\npub fn declare(\n  env: kernel_dependent.Environment,\n  name: String,\n  ty: kernel_dependent.Term,\n) -> Result[kernel_dependent.Environment, String] {\n  kernel_dependent.new_name(env, name, [ty])!\n  match ty {\n    kernel_dependent.Sort(l) => if l >= 0 {\n      Ok(kernel_dependent.extended(env, [\n        kernel_dependent.Entry {\n          name,\n          ty,\n          value: None,\n          axiom: true,\n        },\n      ], []))\n    } else {\n      Err(\"a negative level\")\n    },\n    _ => Err(\"`\" + name + \"`: only a type can be declared\"),\n  }\n}","old_text":"/// The environment with an axiom `name : ty` (`ty` a closed type).\npub fn declare(\n  env: kernel_dependent.Environment,\n  name: String,\n  ty: kernel_dependent.Term,\n) -> Result[kernel_dependent.Environment, String] {\n  kernel_dependent.new_name(env, name, [ty])!\n  _ := kernel_dependent.sort_of(env, [], ty)!\n  Ok(kernel_dependent.extended(\n    env,\n    [kernel_dependent.Entry { name, ty, value: None, axiom: true }],\n    [],\n  ))\n}"},{"name":"kernel_dependent.add_inductive","kind":"fn","old":"386f4a15056fb7ed","new":"1ba11cd71f888efc","interface_changed":false,"affected":["kernel_dependent_patch.base","kernel_dependent_patch.add_schema","kernel_dependent_patch.refusals","kernel_cli.dependent","kernel_dependent_patch.records","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent","text":"/// `add_inductives` with a group of one.\npub fn add_inductive(\n  env: kernel_dependent.Environment,\n  name: String,\n  ty: kernel_dependent.Term,\n  params: Int,\n  constructors: List[(String, kernel_dependent.Term)],\n) -> Result[kernel_dependent.Environment, String] {\n  kernel_dependent.add_inductives(\n    env,\n    params,\n    [(name, ty, constructors)],\n  )\n}","old_text":"/// The environment with the inductive type `name : ty` (`Π params. Sort l`,\n/// no indices) and its constructors: each `Π params. Π args. name params`,\n/// with the type's parameters, and each argument either `name params`\n/// (recursive) or a type not mentioning `name`, at a level at most `l`.\n/// Its recursor is `name.rec`.\npub fn add_inductive(\n  env: kernel_dependent.Environment,\n  name: String,\n  ty: kernel_dependent.Term,\n  params: Int,\n  constructors: List[(String, kernel_dependent.Term)],\n) -> Result[kernel_dependent.Environment, String] {\n  kernel_dependent.new_name(\n    env,\n    name,\n    [ty] + constructors.map(c -> c.1),\n  )!\n  _ := kernel_dependent.sort_of(env, [], ty)!\n  (ps, result) := kernel_dependent.peel(ty, params, \"#p\")\n  level := match result {\n    kernel_dependent.Sort(l) => if len(ps) == params {\n      l\n    } else {\n      return Err(\"`\" + name + \"`: fewer parameters than said\")\n    },\n    _ => return Err(\"`\"\n      + name\n      + \"`: not `Π params. Sort l` (indices aren't supported)\"),\n  }\n  with_type := kernel_dependent.extended(\n    env,\n    [kernel_dependent.Entry { name, ty, value: None, axiom: false }],\n    [],\n  )\n  self := kernel_dependent.applied(\n    kernel_dependent.Constant { name, levels: [] },\n    ps.map(p -> kernel_dependent.Free(p.0)),\n  )\n  mut cs := []\n  mut seen := [name + \".rec\"]\n  for (c, cty) in constructors {\n    kernel_dependent.new_name(with_type, c, [])!\n    if contains(seen, c) {\n      return Err(\"constructor `\" + c + \"` repeated\")\n    }\n    mut seen.push(c)\n    _ := kernel_dependent.sort_of(with_type, [], cty)!\n    (cps, rest) := kernel_dependent.peel(cty, params, \"#p\")\n    if cps != ps {\n      return Err(\"constructor `\" + c + \"`: not the type's parameters\")\n    }\n    (args, out) := kernel_dependent.peel(rest, -1, \"#a\")\n    if out != self {\n      return Err(\"constructor `\"\n        + c\n        + \"`: its result isn't the type at its parameters\")\n    }\n    mut ctx := ps.reversed()\n    mut recursive := []\n    for (a, d) in args {\n      if d == self {\n        mut recursive.push(true)\n      } else if kernel_dependent.mentions(d, name) {\n        return Err(\"constructor `\"\n          + c\n          + \"`: an argument mentions the type other than as itself\")\n      } else {\n        if kernel_dependent.sort_of(with_type, ctx, d)! > level {\n          return Err(\"constructor `\"\n            + c\n            + \"`: an argument in a larger universe than the type\")\n        }\n        mut recursive.push(false)\n      }\n      ctx = [(a, d)] + ctx\n    }\n    mut cs.push(\n      kernel_dependent.Constructor { name: c, ty: cty, recursive },\n    )\n  }\n  Ok(kernel_dependent.extended(\n    env,\n    [\n        kernel_dependent.Entry {\n          name,\n          ty,\n          value: None,\n          axiom: false,\n        },\n      ]\n      + cs.map(\n        c -> kernel_dependent.Entry {\n          name: c.name,\n          ty: c.ty,\n          value: None,\n          axiom: false,\n        },\n      ),\n    [kernel_dependent.Inductive {\n      name,\n      params,\n      level,\n      ty,\n      constructors: cs,\n    }],\n  ))\n}"},{"name":"kernel_dependent.holds","kind":"fn","old":null,"new":"63d616c967478f86","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// `Eq.{0} Bool p true`: the Bool `p` holds.\npub fn holds(p: kernel_dependent.Term) -> kernel_dependent.Term {\n  kernel_dependent.equality(\n    0,\n    kernel_dependent.Constant { name: \"Bool\", levels: [] },\n    p,\n    kernel_dependent.Constant { name: \"true\", levels: [] },\n  )\n}"},{"name":"kernel_dependent.int_type","kind":"fn","old":null,"new":"9280c46d5febbcd9","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"fn int_type() -> kernel_dependent.Term {\n  kernel_dependent.Constant { name: \"Int\", levels: [] }\n}"},{"name":"kernel_dependent.bool_type","kind":"fn","old":null,"new":"24a6ec8567f288e5","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"fn bool_type() -> kernel_dependent.Term {\n  kernel_dependent.Constant { name: \"Bool\", levels: [] }\n}"},{"name":"kernel_dependent.literal","kind":"fn","old":null,"new":"be81966f49e9f7e4","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// The literal for `n`: a numeral, or `int.neg` of one.\npub fn literal(n: Int) -> kernel_dependent.Term {\n  if n >= 0 {\n    kernel_dependent.Constant { name: to_string(n), levels: [] }\n  } else {\n    kernel_dependent.Apply {\n      function: kernel_dependent.Constant { name: \"int.neg\", levels: [] },\n      argument: kernel_dependent.Constant {\n        name: to_string(0 - n),\n        levels: [],\n      },\n    }\n  }\n}"},{"name":"kernel_dependent.literal_value","kind":"fn","old":null,"new":"c0507dfa0066fc9b","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// The value of an integer literal.\npub fn literal_value(t: kernel_dependent.Term) -> Option[Int] {\n  match t {\n    kernel_dependent.Constant { name, levels: [] } => if kernel_dependent.is_numeral(name) {\n      parse_int(name)\n    } else {\n      None\n    },\n    kernel_dependent.Apply { function: kernel_dependent.Constant { name: \"int.neg\", .. }, argument: kernel_dependent.Constant { name, .. } } => if kernel_dependent.is_numeral(name) && name != \"0\" {\n      Some(0 - (parse_int(name) ?? 0))\n    } else {\n      None\n    },\n    _ => None,\n  }\n}"},{"name":"kernel_dependent.is_numeral","kind":"fn","old":null,"new":"566692e1d18f45d7","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"fn is_numeral(name: String) -> Bool {\n  byte_len(name) > 0 && chars(name).all(c -> c >= \"0\" && c <= \"9\")\n}"},{"name":"kernel_dependent.int_op","kind":"fn","old":null,"new":"dbe5eb121c977a33","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"fn int_op(\n  op: String,\n  a: kernel_dependent.Term,\n  b: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  kernel_dependent.applied(\n    kernel_dependent.Constant { name: op, levels: [] },\n    [a, b],\n  )\n}"},{"name":"kernel_dependent.connective","kind":"fn","old":null,"new":"d8fc41b38dad7d56","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"fn connective(\n  op: String,\n  a: kernel_dependent.Term,\n  b: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  kernel_dependent.applied(\n    kernel_dependent.Constant { name: op, levels: [] },\n    [a, b],\n  )\n}"},{"name":"kernel_dependent.eqv","kind":"fn","old":null,"new":"70eb8a7258d8156c","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"fn eqv(\n  a_type: kernel_dependent.Term,\n  a: kernel_dependent.Term,\n  b: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  kernel_dependent.applied(\n    kernel_dependent.Constant { name: \"eqv\", levels: [] },\n    [a_type, a, b],\n  )\n}"},{"name":"kernel_dependent.integer_axiom","kind":"fn","old":null,"new":"5bffb8fe0e23cdbe","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// The integers' axioms, over `a`, `b`, `c`, as the HOL kernel's\n/// (`int.add_comm` …).\nfn integer_axiom(name: String) -> Option[kernel_dependent.Term] {\n  a := kernel_dependent.Free(\"a\")\n  b := kernel_dependent.Free(\"b\")\n  c := kernel_dependent.Free(\"c\")\n  plus := (x: kernel_dependent.Term, y: kernel_dependent.Term) ->\n    kernel_dependent.int_op(\"int.add\", x, y)\n  times := (x: kernel_dependent.Term, y: kernel_dependent.Term) ->\n    kernel_dependent.int_op(\"int.mul\", x, y)\n  less := (x: kernel_dependent.Term, y: kernel_dependent.Term) ->\n    kernel_dependent.int_op(\"int.lt\", x, y)\n  neg := (x: kernel_dependent.Term) -> kernel_dependent.Apply {\n    function: kernel_dependent.Constant { name: \"int.neg\", levels: [] },\n    argument: x,\n  }\n  zero := kernel_dependent.literal(0)\n  one := kernel_dependent.literal(1)\n  s := match name {\n    \"int.add_comm\" => kernel_dependent.eqv(\n      kernel_dependent.int_type(),\n      plus(a, b),\n      plus(b, a),\n    ),\n    \"int.add_assoc\" => kernel_dependent.eqv(\n      kernel_dependent.int_type(),\n      plus(plus(a, b), c),\n      plus(a, plus(b, c)),\n    ),\n    \"int.add_zero\" => kernel_dependent.eqv(\n      kernel_dependent.int_type(),\n      plus(a, zero),\n      a,\n    ),\n    \"int.add_neg\" => kernel_dependent.eqv(\n      kernel_dependent.int_type(),\n      plus(a, neg(a)),\n      zero,\n    ),\n    \"int.sub_def\" => kernel_dependent.eqv(\n      kernel_dependent.int_type(),\n      kernel_dependent.int_op(\"int.sub\", a, b),\n      plus(a, neg(b)),\n    ),\n    \"int.mul_comm\" => kernel_dependent.eqv(\n      kernel_dependent.int_type(),\n      times(a, b),\n      times(b, a),\n    ),\n    \"int.mul_assoc\" => kernel_dependent.eqv(\n      kernel_dependent.int_type(),\n      times(times(a, b), c),\n      times(a, times(b, c)),\n    ),\n    \"int.mul_one\" => kernel_dependent.eqv(\n      kernel_dependent.int_type(),\n      times(a, one),\n      a,\n    ),\n    \"int.distrib\" => kernel_dependent.eqv(\n      kernel_dependent.int_type(),\n      times(a, plus(b, c)),\n      plus(times(a, b), times(a, c)),\n    ),\n    \"int.le_def\" => kernel_dependent.eqv(\n      kernel_dependent.bool_type(),\n      kernel_dependent.int_op(\"int.le\", a, b),\n      kernel_dependent.connective(\n        \"or\",\n        less(a, b),\n        kernel_dependent.eqv(kernel_dependent.int_type(), a, b),\n      ),\n    ),\n    \"int.lt_irrefl\" => kernel_dependent.Apply {\n      function: kernel_dependent.Constant { name: \"not\", levels: [] },\n      argument: less(a, a),\n    },\n    \"int.lt_trans\" => kernel_dependent.connective(\n      \"implies\",\n      less(a, b),\n      kernel_dependent.connective(\"implies\", less(b, c), less(a, c)),\n    ),\n    \"int.lt_total\" => kernel_dependent.connective(\"or\", kernel_dependent.connective(\n      \"or\",\n      less(a, b),\n      kernel_dependent.eqv(kernel_dependent.int_type(), a, b),\n    ), less(b, a)),\n    \"int.lt_add\" => kernel_dependent.connective(\n      \"implies\",\n      less(a, b),\n      less(plus(a, c), plus(b, c)),\n    ),\n    \"int.mul_pos\" => kernel_dependent.connective(\n      \"implies\",\n      less(zero, a),\n      kernel_dependent.connective(\n        \"implies\",\n        less(zero, b),\n        less(zero, times(a, b)),\n      ),\n    ),\n    \"int.discrete\" => kernel_dependent.eqv(\n      kernel_dependent.bool_type(),\n      less(a, b),\n      kernel_dependent.int_op(\"int.le\", plus(a, one), b),\n    ),\n    _ => return None,\n  }\n  Some(kernel_dependent.pi(\n    \"a\",\n    kernel_dependent.int_type(),\n    kernel_dependent.pi(\n      \"b\",\n      kernel_dependent.int_type(),\n      kernel_dependent.pi(\n        \"c\",\n        kernel_dependent.int_type(),\n        kernel_dependent.holds(s),\n      ),\n    ),\n  ))\n}"},{"name":"kernel_dependent.reduce_integer","kind":"fn","old":null,"new":"b9c03affc5333354","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"fn reduce_integer(\n  env: kernel_dependent.Environment,\n  name: String,\n  args: List[kernel_dependent.Term],\n) -> Option[kernel_dependent.Term] {\n  if !starts_with(name, \"int.\") {\n    return None\n  }\n  m := kernel_dependent.literal_value(\n    kernel_dependent.whnf(env, get(args, 0)?),\n  )?\n  if name == \"int.neg\" {\n    return if len(args) == 1 {\n      Some(kernel_dependent.literal(0 - m))\n    } else {\n      None\n    }\n  }\n  if len(args) != 2 {\n    return None\n  }\n  n := kernel_dependent.literal_value(\n    kernel_dependent.whnf(env, get(args, 1)?),\n  )?\n  truth := (c: Bool) -> kernel_dependent.Constant { name: if c {\n    \"true\"\n  } else {\n    \"false\"\n  }, levels: [] }\n  match name {\n    \"int.add\" => Some(kernel_dependent.literal(m + n)),\n    \"int.sub\" => Some(kernel_dependent.literal(m - n)),\n    \"int.mul\" => Some(kernel_dependent.literal(m * n)),\n    \"int.lt\" => Some(truth(m < n)),\n    \"int.le\" => Some(truth(m <= n)),\n    \"int.eq\" => Some(truth(m == n)),\n    _ => None,\n  }\n}"},{"name":"kernel_dependent.add_inductives","kind":"fn","old":null,"new":"577fb342d52fdf8c","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// The environment with the inductive types `types`, defined together:\n/// each `name : ty` (`Π params. Sort l`, the same parameters and level for\n/// all, no indices) with its constructors, each `Π params. Π args. name\n/// params`, and each argument either a type of the group at the\n/// parameters (recursive) or a type mentioning none of them, at a level at\n/// most `l`. Each type's recursor is `name.rec`.\npub fn add_inductives(\n  env: kernel_dependent.Environment,\n  params: Int,\n  types: List[(String, kernel_dependent.Term, List[(String, kernel_dependent.Term)])],\n) -> Result[kernel_dependent.Environment, String] {\n  names := types.map(t -> t.0)\n  mut seen := []\n  for (name, ty, constructors) in types {\n    kernel_dependent.new_name(\n      env,\n      name,\n      [ty] + constructors.map(c -> c.1),\n    )!\n    if contains(seen, name) {\n      return Err(\"`\" + name + \"` repeated\")\n    }\n    mut seen.push(name)\n    mut seen.push(name + \".rec\")\n  }\n  (ps, result) := kernel_dependent.peel(\n    (get(types, 0) ?? (\"\", kernel_dependent.Sort(0), [])).1,\n    params,\n    \"#p\",\n  )\n  level := match result {\n    kernel_dependent.Sort(l) => if len(ps) == params {\n      l\n    } else {\n      return Err(\"fewer parameters than said\")\n    },\n    _ => return Err(\"not `Π params. Sort l` (indices aren't supported)\"),\n  }\n  mut with_types := env\n  for (name, ty, _) in types {\n    _ := kernel_dependent.sort_of(env, [], ty)!\n    if kernel_dependent.peel(ty, params, \"#p\") != (ps, result) {\n      return Err(\"`\" + name + \"`: not the group's parameters and level\")\n    }\n    with_types = kernel_dependent.extended(\n      with_types,\n      [\n        kernel_dependent.Entry {\n          name,\n          ty,\n          value: None,\n          axiom: false,\n        },\n      ],\n      [],\n    )\n  }\n  selves := names.map(\n    n -> kernel_dependent.applied(\n      kernel_dependent.Constant { name: n, levels: [] },\n      ps.map(p -> kernel_dependent.Free(p.0)),\n    ),\n  )\n  mut entries := []\n  mut inductives := []\n  for (name, ty, constructors) in types {\n    mut cs := []\n    for (c, cty) in constructors {\n      kernel_dependent.new_name(with_types, c, [])!\n      if contains(seen, c) {\n        return Err(\"constructor `\" + c + \"` repeated\")\n      }\n      mut seen.push(c)\n      _ := kernel_dependent.sort_of(with_types, [], cty)!\n      (cps, rest) := kernel_dependent.peel(cty, params, \"#p\")\n      if cps != ps {\n        return Err(\"constructor `\" + c + \"`: not the type's parameters\")\n      }\n      (args, out) := kernel_dependent.peel(rest, -1, \"#a\")\n      if out != kernel_dependent.applied(\n        kernel_dependent.Constant { name, levels: [] },\n        ps.map(p -> kernel_dependent.Free(p.0)),\n      ) {\n        return Err(\"constructor `\"\n          + c\n          + \"`: its result isn't the type at its parameters\")\n      }\n      mut ctx := ps.reversed()\n      mut recursive := []\n      for (a, d) in args {\n        mut r := -1\n        for (k, s) in enumerate(selves) {\n          if d == s {\n            r = k\n          }\n        }\n        if r < 0 {\n          if names.any(n -> kernel_dependent.mentions(d, n)) {\n            return Err(\n              \"constructor `\"\n                + c\n                + \"`: an argument mentions a type of the group other than as itself\",\n            )\n          }\n          if kernel_dependent.sort_of(with_types, ctx, d)! > level {\n            return Err(\"constructor `\"\n              + c\n              + \"`: an argument in a larger universe than the type\")\n          }\n        }\n        mut recursive.push(r)\n        ctx = [(a, d)] + ctx\n      }\n      mut cs.push(\n        kernel_dependent.Constructor { name: c, ty: cty, recursive },\n      )\n    }\n    mut entries.push(\n      kernel_dependent.Entry { name, ty, value: None, axiom: false },\n    )\n    entries += cs.map(\n      c -> kernel_dependent.Entry {\n        name: c.name,\n        ty: c.ty,\n        value: None,\n        axiom: false,\n      },\n    )\n    mut inductives.push(\n      kernel_dependent.Inductive {\n        name,\n        params,\n        level,\n        ty,\n        constructors: cs,\n        group: names,\n      },\n    )\n  }\n  Ok(kernel_dependent.extended(env, entries, inductives))\n}"},{"name":"kernel_dependent_patch.base","kind":"fn","old":"030a358c1c06e45e","new":"c8860ffc2f790c4e","interface_changed":false,"affected":["kernel_cli.dependent","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent_patch","text":"// ---- the base: types every schema uses ----\n\n/// `Empty`, `Unit`, `List`, `Change`, `Dec`, `is_yes` and `change`\n/// (`Bool`, `ite` and `or` are the kernel's).\npub fn base(\n  env: kernel_dependent.Environment,\n) -> Result[kernel_dependent.Environment, String] {\n  t := kernel_dependent.Sort(0)\n  a := kernel_dependent_patch.v(\"A\")\n  mut e := kernel_dependent.add_inductive(env, \"Empty\", t, 0, [])!\n  e = kernel_dependent.add_inductive(\n    e,\n    \"Unit\",\n    t,\n    0,\n    [(\"star\", kernel_dependent_patch.c(\"Unit\"))],\n  )!\n  list := kernel_dependent.Apply {\n    function: kernel_dependent_patch.c(\"List\"),\n    argument: a,\n  }\n  e = kernel_dependent.add_inductive(\n    e,\n    \"List\",\n    kernel_dependent_patch.arrow(t, t),\n    1,\n    [\n      (\"nil\", kernel_dependent.pi(\"A\", t, list)),\n      (\"cons\", kernel_dependent_patch.pis(\n        [(\"A\", t), (\"h\", a), (\"rest\", list)],\n        list,\n      )),\n    ],\n  )!\n  change := kernel_dependent.Apply {\n    function: kernel_dependent_patch.c(\"Change\"),\n    argument: a,\n  }\n  e = kernel_dependent.add_inductive(\n    e,\n    \"Change\",\n    kernel_dependent_patch.arrow(t, t),\n    1,\n    [(\"Keep\", kernel_dependent.pi(\"A\", t, change)), (\n      \"Set\",\n      kernel_dependent_patch.pis([(\"A\", t), (\"v\", a)], change),\n    )],\n  )!\n  p := kernel_dependent_patch.v(\"P\")\n  dec := kernel_dependent.Apply {\n    function: kernel_dependent_patch.c(\"Dec\"),\n    argument: p,\n  }\n  e = kernel_dependent.add_inductive(\n    e,\n    \"Dec\",\n    kernel_dependent_patch.arrow(t, t),\n    1,\n    [\n      (\"yes\", kernel_dependent_patch.pis([(\"P\", t), (\"h\", p)], dec)),\n      (\"no\", kernel_dependent_patch.pis(\n        [(\"P\", t), (\"h\", kernel_dependent_patch.arrow(\n          p,\n          kernel_dependent_patch.c(\"Empty\"),\n        ))],\n        dec,\n      )),\n    ],\n  )!\n  bool := kernel_dependent_patch.c(\"Bool\")\n  e = kernel_dependent.define(e, \"is_yes\", kernel_dependent_patch.pis(\n    [(\"P\", t)],\n    kernel_dependent_patch.arrow(dec, bool),\n  ), kernel_dependent_patch.lambdas(\n    [(\"P\", t), (\"d\", dec)],\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(\"Dec\", 0),\n      [\n        p,\n        kernel_dependent.lambda(\"_d\", dec, bool),\n        kernel_dependent.lambda(\n          \"_h\",\n          p,\n          kernel_dependent_patch.c(\"true\"),\n        ),\n        kernel_dependent.lambda(\"_h\", kernel_dependent_patch.arrow(\n          p,\n          kernel_dependent_patch.c(\"Empty\"),\n        ), kernel_dependent_patch.c(\"false\")),\n        kernel_dependent_patch.v(\"d\"),\n      ],\n    ),\n  ))!\n  kernel_dependent.define(e, \"change\", kernel_dependent_patch.pis(\n    [(\"A\", t), (\"c\", change), (\"old\", a)],\n    a,\n  ), kernel_dependent_patch.lambdas(\n    [(\"A\", t), (\"c\", change), (\"old\", a)],\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(\"Change\", 0),\n      [\n        a,\n        kernel_dependent.lambda(\"_c\", change, a),\n        kernel_dependent_patch.v(\"old\"),\n        kernel_dependent.lambda(\n          \"v\",\n          a,\n          kernel_dependent_patch.v(\"v\"),\n        ),\n        kernel_dependent_patch.v(\"c\"),\n      ],\n    ),\n  ))\n}","old_text":"// ---- the base: types every schema uses ----\n\n/// `Empty`, `Unit`, `Bool`, `List`, `Change`, `Dec`, and `ite`, `or`,\n/// `is_yes`, `change`.\npub fn base(\n  env: kernel_dependent.Environment,\n) -> Result[kernel_dependent.Environment, String] {\n  t := kernel_dependent.Sort(0)\n  a := kernel_dependent_patch.v(\"A\")\n  mut e := kernel_dependent.add_inductive(env, \"Empty\", t, 0, [])!\n  e = kernel_dependent.add_inductive(\n    e,\n    \"Unit\",\n    t,\n    0,\n    [(\"star\", kernel_dependent_patch.c(\"Unit\"))],\n  )!\n  e = kernel_dependent.add_inductive(e, \"Bool\", t, 0, [\n    (\"true\", kernel_dependent_patch.c(\"Bool\")),\n    (\"false\", kernel_dependent_patch.c(\"Bool\")),\n  ])!\n  list := kernel_dependent.Apply {\n    function: kernel_dependent_patch.c(\"List\"),\n    argument: a,\n  }\n  e = kernel_dependent.add_inductive(\n    e,\n    \"List\",\n    kernel_dependent_patch.arrow(t, t),\n    1,\n    [\n      (\"nil\", kernel_dependent.pi(\"A\", t, list)),\n      (\"cons\", kernel_dependent_patch.pis(\n        [(\"A\", t), (\"h\", a), (\"rest\", list)],\n        list,\n      )),\n    ],\n  )!\n  change := kernel_dependent.Apply {\n    function: kernel_dependent_patch.c(\"Change\"),\n    argument: a,\n  }\n  e = kernel_dependent.add_inductive(\n    e,\n    \"Change\",\n    kernel_dependent_patch.arrow(t, t),\n    1,\n    [(\"Keep\", kernel_dependent.pi(\"A\", t, change)), (\n      \"Set\",\n      kernel_dependent_patch.pis([(\"A\", t), (\"v\", a)], change),\n    )],\n  )!\n  p := kernel_dependent_patch.v(\"P\")\n  dec := kernel_dependent.Apply {\n    function: kernel_dependent_patch.c(\"Dec\"),\n    argument: p,\n  }\n  e = kernel_dependent.add_inductive(\n    e,\n    \"Dec\",\n    kernel_dependent_patch.arrow(t, t),\n    1,\n    [\n      (\"yes\", kernel_dependent_patch.pis([(\"P\", t), (\"h\", p)], dec)),\n      (\"no\", kernel_dependent_patch.pis(\n        [(\"P\", t), (\"h\", kernel_dependent_patch.arrow(\n          p,\n          kernel_dependent_patch.c(\"Empty\"),\n        ))],\n        dec,\n      )),\n    ],\n  )!\n  bool := kernel_dependent_patch.c(\"Bool\")\n  e = kernel_dependent.define(e, \"ite\", kernel_dependent_patch.pis(\n    [(\"A\", t), (\"b\", bool), (\"x\", a), (\"y\", a)],\n    a,\n  ), kernel_dependent_patch.lambdas(\n    [(\"A\", t), (\"b\", bool), (\"x\", a), (\"y\", a)],\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(\"Bool\", 0),\n      [\n        kernel_dependent.lambda(\"_b\", bool, a),\n        kernel_dependent_patch.v(\"x\"),\n        kernel_dependent_patch.v(\"y\"),\n        kernel_dependent_patch.v(\"b\"),\n      ],\n    ),\n  ))!\n  e = kernel_dependent.define(e, \"or\", kernel_dependent_patch.arrow(\n    bool,\n    kernel_dependent_patch.arrow(bool, bool),\n  ), kernel_dependent_patch.lambdas(\n    [(\"a\", bool), (\"b\", bool)],\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(\"Bool\", 0),\n      [\n        kernel_dependent.lambda(\"_b\", bool, bool),\n        kernel_dependent_patch.c(\"true\"),\n        kernel_dependent_patch.v(\"b\"),\n        kernel_dependent_patch.v(\"a\"),\n      ],\n    ),\n  ))!\n  e = kernel_dependent.define(e, \"is_yes\", kernel_dependent_patch.pis(\n    [(\"P\", t)],\n    kernel_dependent_patch.arrow(dec, bool),\n  ), kernel_dependent_patch.lambdas(\n    [(\"P\", t), (\"d\", dec)],\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(\"Dec\", 0),\n      [\n        p,\n        kernel_dependent.lambda(\"_d\", dec, bool),\n        kernel_dependent.lambda(\n          \"_h\",\n          p,\n          kernel_dependent_patch.c(\"true\"),\n        ),\n        kernel_dependent.lambda(\"_h\", kernel_dependent_patch.arrow(\n          p,\n          kernel_dependent_patch.c(\"Empty\"),\n        ), kernel_dependent_patch.c(\"false\")),\n        kernel_dependent_patch.v(\"d\"),\n      ],\n    ),\n  ))!\n  kernel_dependent.define(e, \"change\", kernel_dependent_patch.pis(\n    [(\"A\", t), (\"c\", change), (\"old\", a)],\n    a,\n  ), kernel_dependent_patch.lambdas(\n    [(\"A\", t), (\"c\", change), (\"old\", a)],\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(\"Change\", 0),\n      [\n        a,\n        kernel_dependent.lambda(\"_c\", change, a),\n        kernel_dependent_patch.v(\"old\"),\n        kernel_dependent.lambda(\n          \"v\",\n          a,\n          kernel_dependent_patch.v(\"v\"),\n        ),\n        kernel_dependent_patch.v(\"c\"),\n      ],\n    ),\n  ))\n}"},{"name":"kernel_dependent_patch.core_type","kind":"fn","old":"d439cca1ed796c21","new":"1bbb2a58d64b3cb1","interface_changed":false,"affected":[],"module":"kernel_dependent_patch","text":"// ---- records of a Strata module, as schemas ----\n\n/// A type value as a type of the kernel: by its name and arguments, a\n/// name the environment lacks declared as an opaque type (a refinement is\n/// dropped).\nfn core_type(\n  mut env: kernel_dependent.Environment,\n  t: std.typing.Type,\n) -> Result[kernel_dependent.Term, String] {\n  name := match t.name {\n    Some(\"Natural\") | Some(\"Positive\") => \"Int\",\n    Some(n) => n,\n    None => return Err(\"a type with no name: `\" + t.written + \"`\"),\n  }\n  mut args := []\n  for a in t.args {\n    mut args.push(kernel_dependent_patch.core_type(mut env, a)!)\n  }\n  if kernel_dependent.constant_type(env, name, []) is Err {\n    if args != [] {\n      return Err(\"`\" + name + \"`: an unknown type with arguments\")\n    }\n    env = kernel_dependent.declare(env, name, kernel_dependent.Sort(0))!\n  }\n  Ok(\n    kernel_dependent_patch.at(kernel_dependent_patch.c(name), args),\n  )\n}","old_text":"// ---- records of a Strata module, as schemas ----\n\n/// A type value as a type of the kernel: by its name and arguments, a\n/// name the environment lacks declared as an opaque type (a refinement is\n/// dropped).\nfn core_type(\n  mut env: kernel_dependent.Environment,\n  t: std.typing.Type,\n) -> Result[kernel_dependent.Term, String] {\n  name := match t.name {\n    Some(\"Natural\") | Some(\"Positive\") => \"Int\",\n    Some(n) => n,\n    None => return Err(\"a type with no name: `\" + t.written + \"`\"),\n  }\n  mut args := []\n  for a in t.args {\n    mut args.push(kernel_dependent_patch.core_type(mut env, a)!)\n  }\n  if kernel_dependent.lookup(env, name) == None {\n    if args != [] {\n      return Err(\"`\" + name + \"`: an unknown type with arguments\")\n    }\n    env = kernel_dependent.declare(env, name, kernel_dependent.Sort(0))!\n  }\n  Ok(\n    kernel_dependent_patch.at(kernel_dependent_patch.c(name), args),\n  )\n}"},{"name":"kernel_dependent_tactics.eliminate","kind":"fn","old":"287a556cacba520e","new":"c1a66c32e2716102","interface_changed":false,"affected":["kernel_dependent_tactics.cases","kernel_dependent_tactics.induction","kernel_dependent_patch.laws","kernel_cli.dependent","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent_tactics","text":"fn eliminate(\n  g: kernel_dependent_tactics.Goal,\n  t: kernel_dependent.Term,\n  body: kernel_dependent.Term,\n  equation: String,\n  with_hypotheses: Bool,\n  cs: List[kernel_dependent_tactics.Case],\n) -> Result[kernel_dependent.Term, String] {\n  tty := kernel_dependent.whnf(\n    g.env,\n    kernel_dependent_tactics.type_in(g, t)!,\n  )\n  (head, params) := kernel_dependent.spine(tty)\n  ind := match head {\n    kernel_dependent.Constant { name, .. } => kernel_dependent.inductive_named(g.env, name) or {\n      return Err(kernel_dependent_tactics.failure(\n        g,\n        \"cases: `\" + name + \"` isn't an inductive type\",\n      ))\n    },\n    _ => return Err(kernel_dependent_tactics.failure(\n      g,\n      \"cases: not of an inductive type\",\n    )),\n  }\n  if len(ind.group) != 1 {\n    return Err(kernel_dependent_tactics.failure(\n      g,\n      \"cases: `\" + ind.name + \"` is defined with other types\",\n    ))\n  }\n  if len(cs) != len(ind.constructors) {\n    return Err(kernel_dependent_tactics.failure(g, \"cases: `\"\n      + ind.name\n      + \"` has \"\n      + to_string(len(ind.constructors))\n      + \" constructors\"))\n  }\n  z := kernel_dependent.Free(\"#z\")\n  goal_body := if equation == \"\" {\n    body\n  } else {\n    kernel_dependent.pi(\n      equation,\n      kernel_dependent.equality(ind.level, tty, t, z),\n      body,\n    )\n  }\n  m := kernel_dependent.sort_of(\n    g.env,\n    [(\"#z\", tty)] + g.context,\n    goal_body,\n  ) except msg {\n    return Err(kernel_dependent_tactics.failure(g, \"cases: \" + msg))\n  }\n  motive := kernel_dependent.lambda(\"#z\", tty, goal_body)\n  mut minors := []\n  for (k, c) in enumerate(ind.constructors) {\n    names := (get(cs, k) ?? kernel_dependent_tactics.Case {\n      names: [],\n      proof: _h -> Err(\"\"),\n    }).names\n    proves := (get(cs, k) ?? kernel_dependent_tactics.Case {\n      names: [],\n      proof: _h -> Err(\"\"),\n    }).proof\n    cty := kernel_dependent_tactics.type_in(g, kernel_dependent.applied(\n      kernel_dependent_tactics.constant(c.name),\n      params,\n    ))!\n    mut ctx := g.context\n    mut args := []\n    mut rest := cty\n    for (j, _) in enumerate(c.recursive) {\n      a := get(names, j) ?? \"#a\" + to_string(j)\n      match kernel_dependent.whnf(g.env, rest) {\n        kernel_dependent.Pi { domain, body: b, .. } => {\n          ctx = [(a, domain)] + ctx\n          mut args.push((a, domain))\n          rest = kernel_dependent.instantiate(\n            b,\n            kernel_dependent.Free(a),\n            0,\n          )\n        },\n        _ => return Err(\"cases: a constructor's type\"),\n      }\n    }\n    mut ihs := []\n    for (j, r) in enumerate(c.recursive) {\n      if r >= 0 {\n        n := if with_hypotheses {\n          get(names, len(c.recursive) + len(ihs)) ?? \"#ih\" + to_string(j)\n        } else {\n          \"#ih\" + to_string(j)\n        }\n        ih := kernel_dependent_tactics.substituted(\n          goal_body,\n          \"#z\",\n          kernel_dependent.Free((get(args, j) ?? (\"\", z)).0),\n        )\n        ctx = [(n, ih)] + ctx\n        mut ihs.push((n, ih))\n      }\n    }\n    value := kernel_dependent.applied(\n      kernel_dependent_tactics.constant(c.name),\n      params + args.map(a -> kernel_dependent.Free(a.0)),\n    )\n    sub := kernel_dependent_tactics.Goal {\n      ..g,\n      context: ctx,\n      target: kernel_dependent_tactics.substituted(goal_body, \"#z\", value),\n    }\n    mut proof := if equation == \"\" {\n      proves(sub)!\n    } else {\n      kernel_dependent_tactics.intro(sub, equation, proves)!\n    }\n    for (n, ih) in ihs.reversed() {\n      proof = kernel_dependent.lambda(n, ih, proof)\n    }\n    for (a, d) in args.reversed() {\n      proof = kernel_dependent.lambda(a, d, proof)\n    }\n    mut minors.push(proof)\n  }\n  out := kernel_dependent.applied(\n    kernel_dependent.Constant {\n      name: ind.name + \".rec\",\n      levels: [m],\n    },\n    params + [motive] + minors + [t],\n  )\n  Ok(if equation == \"\" {\n    out\n  } else {\n    kernel_dependent.Apply {\n      function: out,\n      argument: kernel_dependent.reflexivity(ind.level, tty, t),\n    }\n  })\n}","old_text":"fn eliminate(\n  g: kernel_dependent_tactics.Goal,\n  t: kernel_dependent.Term,\n  body: kernel_dependent.Term,\n  equation: String,\n  with_hypotheses: Bool,\n  cs: List[kernel_dependent_tactics.Case],\n) -> Result[kernel_dependent.Term, String] {\n  tty := kernel_dependent.whnf(\n    g.env,\n    kernel_dependent_tactics.type_in(g, t)!,\n  )\n  (head, params) := kernel_dependent.spine(tty)\n  ind := match head {\n    kernel_dependent.Constant { name, .. } => kernel_dependent.inductive_named(g.env, name) or {\n      return Err(kernel_dependent_tactics.failure(\n        g,\n        \"cases: `\" + name + \"` isn't an inductive type\",\n      ))\n    },\n    _ => return Err(kernel_dependent_tactics.failure(\n      g,\n      \"cases: not of an inductive type\",\n    )),\n  }\n  if len(cs) != len(ind.constructors) {\n    return Err(kernel_dependent_tactics.failure(g, \"cases: `\"\n      + ind.name\n      + \"` has \"\n      + to_string(len(ind.constructors))\n      + \" constructors\"))\n  }\n  z := kernel_dependent.Free(\"#z\")\n  goal_body := if equation == \"\" {\n    body\n  } else {\n    kernel_dependent.pi(\n      equation,\n      kernel_dependent.equality(ind.level, tty, t, z),\n      body,\n    )\n  }\n  m := kernel_dependent.sort_of(\n    g.env,\n    [(\"#z\", tty)] + g.context,\n    goal_body,\n  ) except msg {\n    return Err(kernel_dependent_tactics.failure(g, \"cases: \" + msg))\n  }\n  motive := kernel_dependent.lambda(\"#z\", tty, goal_body)\n  mut minors := []\n  for (k, c) in enumerate(ind.constructors) {\n    names := (get(cs, k) ?? kernel_dependent_tactics.Case {\n      names: [],\n      proof: _h -> Err(\"\"),\n    }).names\n    proves := (get(cs, k) ?? kernel_dependent_tactics.Case {\n      names: [],\n      proof: _h -> Err(\"\"),\n    }).proof\n    cty := kernel_dependent_tactics.type_in(g, kernel_dependent.applied(\n      kernel_dependent_tactics.constant(c.name),\n      params,\n    ))!\n    mut ctx := g.context\n    mut args := []\n    mut rest := cty\n    for (j, _) in enumerate(c.recursive) {\n      a := get(names, j) ?? \"#a\" + to_string(j)\n      match kernel_dependent.whnf(g.env, rest) {\n        kernel_dependent.Pi { domain, body: b, .. } => {\n          ctx = [(a, domain)] + ctx\n          mut args.push((a, domain))\n          rest = kernel_dependent.instantiate(\n            b,\n            kernel_dependent.Free(a),\n            0,\n          )\n        },\n        _ => return Err(\"cases: a constructor's type\"),\n      }\n    }\n    mut ihs := []\n    for (j, r) in enumerate(c.recursive) {\n      if r {\n        n := if with_hypotheses {\n          get(names, len(c.recursive) + len(ihs)) ?? \"#ih\" + to_string(j)\n        } else {\n          \"#ih\" + to_string(j)\n        }\n        ih := kernel_dependent_tactics.substituted(\n          goal_body,\n          \"#z\",\n          kernel_dependent.Free((get(args, j) ?? (\"\", z)).0),\n        )\n        ctx = [(n, ih)] + ctx\n        mut ihs.push((n, ih))\n      }\n    }\n    value := kernel_dependent.applied(\n      kernel_dependent_tactics.constant(c.name),\n      params + args.map(a -> kernel_dependent.Free(a.0)),\n    )\n    sub := kernel_dependent_tactics.Goal {\n      ..g,\n      context: ctx,\n      target: kernel_dependent_tactics.substituted(goal_body, \"#z\", value),\n    }\n    mut proof := if equation == \"\" {\n      proves(sub)!\n    } else {\n      kernel_dependent_tactics.intro(sub, equation, proves)!\n    }\n    for (n, ih) in ihs.reversed() {\n      proof = kernel_dependent.lambda(n, ih, proof)\n    }\n    for (a, d) in args.reversed() {\n      proof = kernel_dependent.lambda(a, d, proof)\n    }\n    mut minors.push(proof)\n  }\n  out := kernel_dependent.applied(\n    kernel_dependent.Constant {\n      name: ind.name + \".rec\",\n      levels: [m],\n    },\n    params + [motive] + minors + [t],\n  )\n  Ok(if equation == \"\" {\n    out\n  } else {\n    kernel_dependent.Apply {\n      function: out,\n      argument: kernel_dependent.reflexivity(ind.level, tty, t),\n    }\n  })\n}"}]}
{"id":"04119fb46fa78b78","time":1795852021,"message":"new kernel_dependent_hol","changes":[{"name":"kernel_dependent_hol.use kernel_dependent","kind":"use","old":null,"new":"ba39e31e4e973425","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"// kernel_dependent_hol: the HOL kernel's theorems as proof terms of the\n// dependent kernel, untrusted. Every step a HOL theorem records becomes a\n// term (a HOL statement `p` as the type `holds p`), and the dependent\n// kernel checks each law's term; the HOL kernel is then one more untrusted\n// proof producer. The front end (the translation of Strata, the proof\n// steps) is the HOL kernel's.\n\nuse kernel_dependent"},{"name":"kernel_dependent_hol.use kernel","kind":"use","old":null,"new":"da3789db0a66026d","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"use kernel"},{"name":"kernel_dependent_hol.use kernel_logic","kind":"use","old":null,"new":"828cd74995a0b08e","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"use kernel_logic"},{"name":"kernel_dependent_hol.use kernel_translate","kind":"use","old":null,"new":"0516f2c9d3c51056","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"use kernel_translate"},{"name":"kernel_dependent_hol.use kernel_dependent_tactics","kind":"use","old":null,"new":"d3367773ec3eaca3","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"use kernel_dependent_tactics"},{"name":"kernel_dependent_hol.Replay","kind":"type","old":null,"new":"a4bc15a74b512ebd","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// What replaying has built: the environment, each HOL constant's\n/// dependent constant (its type variables in order and generic type),\n/// each free variable's HOL variable by name, each named theorem's\n/// constant and the free variables it is applied to, and the datatypes\n/// (by type, its group's specs).\npub type Replay = {\n  env: kernel_dependent.Environment,\n  consts: Dict[String, (List[String], kernel.Type)],\n  vars: Dict[String, kernel.Term],\n  named: Dict[String, (String, List[String])],\n  groups: Dict[String, List[kernel.DatatypeSpec]],\n  equations: Dict[String, List[kernel.Theorem]],\n  defined_groups: List[String],\n}"},{"name":"kernel_dependent_hol.D","kind":"type","old":null,"new":"59d9c1005998414c","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"type D = kernel_dependent.Term"},{"name":"kernel_dependent_hol.c","kind":"fn","old":null,"new":"bcab650abdbdada4","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn c(name: String) -> kernel_dependent_hol.D {\n  kernel_dependent.Constant { name, levels: [] }\n}"},{"name":"kernel_dependent_hol.at","kind":"fn","old":null,"new":"061fe7617c8039cd","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn at(\n  f: kernel_dependent_hol.D,\n  args: List[kernel_dependent_hol.D],\n) -> kernel_dependent_hol.D {\n  kernel_dependent.applied(f, args)\n}"},{"name":"kernel_dependent_hol.holds","kind":"fn","old":null,"new":"43f0ad7efbc22e8e","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn holds(p: kernel_dependent_hol.D) -> kernel_dependent_hol.D {\n  kernel_dependent.holds(p)\n}"},{"name":"kernel_dependent_hol.arrow","kind":"fn","old":null,"new":"3680ce972787da7a","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn arrow(\n  a: kernel_dependent_hol.D,\n  b: kernel_dependent_hol.D,\n) -> kernel_dependent_hol.D {\n  kernel_dependent.Pi { name: \"_\", domain: a, body: b }\n}"},{"name":"kernel_dependent_hol.bool","kind":"fn","old":null,"new":"3febca3de20b843c","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn bool() -> kernel_dependent_hol.D {\n  kernel_dependent_hol.c(\"Bool\")\n}"},{"name":"kernel_dependent_hol.eqv","kind":"fn","old":null,"new":"6f11b6bb55f0d24d","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn eqv(\n  a_type: kernel_dependent_hol.D,\n  a: kernel_dependent_hol.D,\n  b: kernel_dependent_hol.D,\n) -> kernel_dependent_hol.D {\n  kernel_dependent_hol.at(\n    kernel_dependent_hol.c(\"eqv\"),\n    [a_type, a, b],\n  )\n}"},{"name":"kernel_dependent_hol.j","kind":"fn","old":null,"new":"be424735402bbcac","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn j(l: Int, m: Int) -> kernel_dependent_hol.D {\n  kernel_dependent.Constant { name: \"J\", levels: [l, m] }\n}"},{"name":"kernel_dependent_hol.lams","kind":"fn","old":null,"new":"692082255b987eec","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn lams(\n  ps: List[(String, kernel_dependent_hol.D)],\n  body: kernel_dependent_hol.D,\n) -> kernel_dependent_hol.D {\n  mut out := body\n  for (x, d) in ps.reversed() {\n    out = kernel_dependent.lambda(x, d, out)\n  }\n  out\n}"},{"name":"kernel_dependent_hol.pis","kind":"fn","old":null,"new":"40102ccd9a8deaa0","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn pis(\n  ps: List[(String, kernel_dependent_hol.D)],\n  body: kernel_dependent_hol.D,\n) -> kernel_dependent_hol.D {\n  mut out := body\n  for (x, d) in ps.reversed() {\n    out = kernel_dependent.pi(x, d, out)\n  }\n  out\n}"},{"name":"kernel_dependent_hol.sig","kind":"fn","old":null,"new":"80852f3e6637db5d","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"// ---- names ----\n\n/// A type as text, for names.\nfn sig(t: kernel.Type) -> String {\n  match t {\n    kernel.TypeVariable(v) => \"'\" + v,\n    kernel.TypeApplication { name, arguments } => if arguments == [] {\n      name\n    } else {\n      name\n        + \"(\"\n        + join(arguments.map(a -> kernel_dependent_hol.sig(a)), \",\")\n        + \")\"\n    },\n  }\n}"},{"name":"kernel_dependent_hol.key","kind":"fn","old":null,"new":"d6016f08cbea5a1a","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// A term as text, bound variables by position (hints left out): equal\n/// for terms the HOL kernel takes as the same.\nfn key(t: kernel.Term) -> String {\n  match t {\n    kernel.Variable { name, value_type } => name + \":\" + kernel_dependent_hol.sig(value_type),\n    kernel.LambdaParameter(i) => \"#\" + to_string(i),\n    kernel.Constant { name, value_type } => name + \":\" + kernel_dependent_hol.sig(value_type),\n    kernel.Application { function, argument } => \"(\"\n      + kernel_dependent_hol.key(function)\n      + \" \"\n      + kernel_dependent_hol.key(argument)\n      + \")\",\n    kernel.Lambda { parameter_type, body, .. } => \"(\\\\\"\n      + kernel_dependent_hol.sig(parameter_type)\n      + \".\"\n      + kernel_dependent_hol.key(body)\n      + \")\",\n  }\n}"},{"name":"kernel_dependent_hol.hypothesis","kind":"fn","old":null,"new":"e5c24d4bbad56748","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn hypothesis(p: kernel.Term) -> String {\n  \"h:\" + kernel_dependent_hol.key(p)\n}"},{"name":"kernel_dependent_hol.variable","kind":"fn","old":null,"new":"2e5328fc7a87c2d3","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn variable(mut r: kernel_dependent_hol.Replay, v: kernel.Term) -> String {\n  n := \"v:\" + kernel_dependent_hol.key(v)\n  mut r.vars.insert(n, v)\n  n\n}"},{"name":"kernel_dependent_hol.type_term","kind":"fn","old":null,"new":"122d3bee20e865e3","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"// ---- types and terms ----\n\npub fn type_term(\n  mut r: kernel_dependent_hol.Replay,\n  t: kernel.Type,\n) -> Result[kernel_dependent_hol.D, String] {\n  match t {\n    kernel.TypeVariable(v) => Ok(kernel_dependent.Free(\"'\" + v)),\n    kernel.TypeApplication { name, arguments } => {\n      mut args := []\n      for a in arguments {\n        mut args.push(kernel_dependent_hol.type_term(mut r, a)!)\n      }\n      match name {\n        \"Function\" => Ok(kernel_dependent_hol.arrow(\n          get(args, 0) ?? kernel_dependent_hol.bool(),\n          get(args, 1) ?? kernel_dependent_hol.bool(),\n        )),\n        \"bool\" => Ok(kernel_dependent_hol.bool()),\n        \"int\" => Ok(kernel_dependent_hol.c(\"Int\")),\n        _ => {\n          if get(r.groups, name) is Some {\n            kernel_dependent_hol.define_group(mut r, name)!\n          } else if kernel_dependent.lookup(r.env, \"h.\" + name) == None {\n            r.env = kernel_dependent.declare(\n              r.env,\n              \"h.\" + name,\n              kernel_dependent.Sort(0),\n            )!\n          }\n          Ok(kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"h.\" + name),\n            args,\n          ))\n        },\n      }\n    },\n  }\n}"},{"name":"kernel_dependent_hol.hol_type","kind":"fn","old":null,"new":"45f2abaebd037462","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn hol_type(t: kernel.Term) -> kernel.Type {\n  kernel.type_of(t) !! kernel.boolean_type()\n}"},{"name":"kernel_dependent_hol.term","kind":"fn","old":null,"new":"d4f70b8f2e6370f7","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"pub fn term(\n  mut r: kernel_dependent_hol.Replay,\n  t: kernel.Term,\n) -> Result[kernel_dependent_hol.D, String] {\n  match t {\n    kernel.Variable { .. } => Ok(\n      kernel_dependent.Free(kernel_dependent_hol.variable(mut r, t)),\n    ),\n    kernel.LambdaParameter(i) => Ok(kernel_dependent.Bound(i)),\n    kernel.Lambda { parameter_name, parameter_type, body } => Ok(kernel_dependent.Lambda {\n      name: parameter_name,\n      domain: kernel_dependent_hol.type_term(mut r, parameter_type)!,\n      body: kernel_dependent_hol.term(mut r, body)!,\n    }),\n    kernel.Application { function, argument } => Ok(kernel_dependent.Apply {\n      function: kernel_dependent_hol.term(mut r, function)!,\n      argument: kernel_dependent_hol.term(mut r, argument)!,\n    }),\n    kernel.Constant { name, value_type } => kernel_dependent_hol.constant(mut r, name, value_type),\n  }\n}"},{"name":"kernel_dependent_hol.first_argument","kind":"fn","old":null,"new":"1878a83fd81b94d3","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn first_argument(t: kernel.Type) -> kernel.Type {\n  match t {\n    kernel.TypeApplication { arguments, .. } => get(arguments, 0) ?? t,\n    _ => t,\n  }\n}"},{"name":"kernel_dependent_hol.constant","kind":"fn","old":null,"new":"202bfedc904f703e","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn constant(\n  mut r: kernel_dependent_hol.Replay,\n  name: String,\n  ty: kernel.Type,\n) -> Result[kernel_dependent_hol.D, String] {\n  simple := [\n    (\"==>\", \"implies\"),\n    (\"/\\\\\", \"and\"),\n    (\"\\/\", \"or\"),\n    (\"~\", \"not\"),\n    (\"T\", \"true\"),\n    (\"F\", \"false\"),\n  ]\n  for (h, d) in simple {\n    if name == h {\n      return Ok(kernel_dependent_hol.c(d))\n    }\n  }\n  if starts_with(name, \"int.\") || kernel.is_numeral(name) {\n    return Ok(kernel_dependent_hol.c(name))\n  }\n  if name == \"=\" || name == \"ite\" {\n    a := if name == \"=\" {\n      kernel_dependent_hol.first_argument(ty)\n    } else {\n      kernel_dependent_hol.first_argument(\n        kernel_dependent_hol.second(ty),\n      )\n    }\n    return Ok(kernel_dependent.Apply {\n      function: kernel_dependent_hol.c(if name == \"=\" {\n        \"eqv\"\n      } else {\n        \"ite\"\n      }),\n      argument: kernel_dependent_hol.type_term(mut r, a)!,\n    })\n  }\n  if name == \"forall\" || name == \"exists\" {\n    return Ok(kernel_dependent.Apply {\n      function: kernel_dependent_hol.c(if name == \"forall\" {\n        \"all\"\n      } else {\n        \"some\"\n      }),\n      argument: kernel_dependent_hol.type_term(\n        mut r,\n        kernel_dependent_hol.first_argument(\n          kernel_dependent_hol.first_argument(ty),\n        ),\n      )!,\n    })\n  }\n  if get(r.consts, name) == None {\n    // a constant first met in a statement: its equations define it\n    for th in get(r.equations, name) ?? [] {\n      _ := kernel_dependent_hol.proof(mut r, th)!\n    }\n  }\n  match get(r.consts, name) {\n    Some((tvs, generic)) => {\n      mut s := []\n      if !kernel_dependent_hol.match_type(generic, ty, mut s) {\n        return Err(\n          \"`\"\n            + name\n            + \"` at a type that isn't an instance of its own\",\n        )\n      }\n      mut args := []\n      for v in tvs {\n        mut args.push(\n          kernel_dependent_hol.type_term(\n            mut r,\n            kernel_dependent_hol.lookup_type(s, v),\n          )!,\n        )\n      }\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"h.\" + name),\n        args,\n      ))\n    },\n    None => Err(\"`\" + name + \"`: no definition reached\"),\n  }\n}"},{"name":"kernel_dependent_hol.second","kind":"fn","old":null,"new":"c204d6aaa7195f60","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn second(t: kernel.Type) -> kernel.Type {\n  match t {\n    kernel.TypeApplication { arguments, .. } => get(arguments, 1) ?? t,\n    _ => t,\n  }\n}"},{"name":"kernel_dependent_hol.lookup_type","kind":"fn","old":null,"new":"cad15a498c3450c3","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn lookup_type(s: List[(String, kernel.Type)], v: String) -> kernel.Type {\n  for (n, t) in s {\n    if n == v {\n      return t\n    }\n  }\n  kernel.TypeVariable(v)\n}"},{"name":"kernel_dependent_hol.match_type","kind":"fn","old":null,"new":"5c9a51cb0cbc3fca","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn match_type(\n  p: kernel.Type,\n  t: kernel.Type,\n  mut s: List[(String, kernel.Type)],\n) -> Bool {\n  match (p, t) {\n    (kernel.TypeVariable(v), _) => {\n      for (n, u) in s {\n        if n == v {\n          return u == t\n        }\n      }\n      mut s.push((v, t))\n      true\n    },\n    (kernel.TypeApplication { name: a, arguments: xs }, kernel.TypeApplication { name: b, arguments: ys }) => {\n      if a != b || len(xs) != len(ys) {\n        return false\n      }\n      for (i, x) in enumerate(xs) {\n        if !kernel_dependent_hol.match_type(x, get(ys, i) ?? x, mut s) {\n          return false\n        }\n      }\n      true\n    },\n    _ => false,\n  }\n}"},{"name":"kernel_dependent_hol.define_group","kind":"fn","old":null,"new":"b5d2753bebcad213","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"// ---- datatypes ----\n\nfn define_group(\n  mut r: kernel_dependent_hol.Replay,\n  name: String,\n) -> Result[(), String] {\n  specs := get(r.groups, name) ?? []\n  first := (get(specs, 0) ?? kernel.DatatypeSpec { name, params: [], ctors: [] }).name\n  if contains(r.defined_groups, first) {\n    return Ok(())\n  }\n  mut r.defined_groups.push(first)\n  params := (get(specs, 0) ?? kernel.DatatypeSpec { name, params: [], ctors: [] }).params\n  ps := params.map(p -> (\"'\" + p, kernel_dependent.Sort(0)))\n  pvars := params.map(p -> kernel_dependent.Free(\"'\" + p))\n  hol_params := params.map(p -> kernel.TypeVariable(p))\n  mut types := []\n  for s in specs {\n    self := kernel_dependent_hol.at(\n      kernel_dependent_hol.c(\"h.\" + s.name),\n      pvars,\n    )\n    mut ctors := []\n    for (cn, args) in s.ctors {\n      mut targs := []\n      for (i, a) in enumerate(args) {\n        mut targs.push(\n          (\n            \"x\" + to_string(i),\n            kernel_dependent_hol.type_term_in_group(\n              mut r,\n              a,\n              specs,\n              pvars,\n            )!,\n          ),\n        )\n      }\n      mut ctors.push(\n        (\"h.\" + cn, kernel_dependent_hol.pis(ps + targs, self)),\n      )\n    }\n    mut types.push(\n      (\n        \"h.\" + s.name,\n        kernel_dependent_hol.pis(ps, kernel_dependent.Sort(0)),\n        ctors,\n      ),\n    )\n  }\n  r.env = kernel_dependent.add_inductives(r.env, len(params), types)!\n  names := specs.map(s -> s.name)\n  tys := names.map(\n    n -> kernel.TypeApplication { name: n, arguments: hol_params },\n  )\n  rs := enumerate(names).map(\n    p -> kernel.TypeVariable(\"#r\" + to_string(p.0)),\n  )\n  res_of := (a: kernel.Type) -> {\n    mut out := a\n    for (i, t) in enumerate(tys) {\n      if t == a {\n        out = get(rs, i) ?? a\n      }\n    }\n    out\n  }\n  // the constructors, then `rec_T` and `case_T` as the HOL kernel's\n  mut case_tys := []\n  for s in specs {\n    t := kernel.TypeApplication { name: s.name, arguments: hol_params }\n    for (cn, args) in s.ctors {\n      mut r.consts.insert(\n        cn,\n        (params, kernel.function_type_of(args, t)),\n      )\n      mut case_tys.push(\n        kernel.function_type_of(args\n          + args.filter(a -> contains(tys, a)).map(a -> res_of(a)), res_of(t)),\n      )\n    }\n  }\n  rvars := enumerate(names).map(\n    p -> (\"'#r\" + to_string(p.0), kernel_dependent.Sort(0)),\n  )\n  for (k, s) in enumerate(specs) {\n    t := kernel.TypeApplication { name: s.name, arguments: hol_params }\n    rk := get(rs, k) ?? t\n    // rec_T\n    mut fs := []\n    for (i, ct) in enumerate(case_tys) {\n      mut fs.push(\n        (\n          \"f\" + to_string(i),\n          kernel_dependent_hol.type_term(mut r, ct)!,\n        ),\n      )\n    }\n    self := kernel_dependent_hol.at(\n      kernel_dependent_hol.c(\"h.\" + s.name),\n      pvars,\n    )\n    motives := enumerate(specs).map(\n      p -> kernel_dependent.lambda(\"_x\", kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"h.\" + p.1.name),\n        pvars,\n      ), kernel_dependent.Free(\"'#r\" + to_string(p.0))),\n    )\n    rec_value := kernel_dependent_hol.lams(\n      ps + rvars + fs + [(\"x\", self)],\n      kernel_dependent_hol.at(kernel_dependent.Constant {\n        name: \"h.\" + s.name + \".rec\",\n        levels: [0],\n      }, pvars\n        + motives\n        + fs.map(f -> kernel_dependent.Free(f.0))\n        + [kernel_dependent.Free(\"x\")]),\n    )\n    rec_type := kernel_dependent_hol.pis(\n      ps + rvars + fs + [(\"x\", self)],\n      kernel_dependent.Free(\"'#r\" + to_string(k)),\n    )\n    r.env = kernel_dependent.define(\n      r.env,\n      \"h.rec_\" + s.name,\n      rec_type,\n      rec_value,\n    )!\n    mut r.consts.insert(\n      \"rec_\" + s.name,\n      (params\n        + names.map(\n          n ->\n            \"#r\"\n              + to_string(kernel_dependent_hol.index_of(names, n)),\n        ), kernel.function_type_of(case_tys + [t], rk)),\n    )\n    // case_T\n    sres := kernel_dependent.Free(\"'#s\")\n    mut gs := []\n    for (i, (_, args)) in enumerate(s.ctors) {\n      mut gs.push(\n        (\"g\" + to_string(i), kernel_dependent_hol.type_term(\n          mut r,\n          kernel.function_type_of(args, kernel.TypeVariable(\"#s\")),\n        )!),\n      )\n    }\n    trivial := kernel_dependent_hol.holds(kernel_dependent_hol.c(\"true\"))\n    case_motives := enumerate(specs).map(\n      p -> kernel_dependent.lambda(\"_x\", kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"h.\" + p.1.name),\n        pvars,\n      ), if p.0 == k {\n        sres\n      } else {\n        trivial\n      }),\n    )\n    mut minors := []\n    for (q, sp) in enumerate(specs) {\n      for (i, (_, args)) in enumerate(sp.ctors) {\n        mut xs := []\n        for (n, a) in enumerate(args) {\n          mut xs.push(\n            (\n              \"y\" + to_string(n),\n              kernel_dependent_hol.type_term_in_group(\n                mut r,\n                a,\n                specs,\n                pvars,\n              )!,\n            ),\n          )\n        }\n        mut ihs := []\n        for (n, a) in enumerate(args) {\n          if contains(tys, a) {\n            mut ihs.push(\n              (\n                \"ih\" + to_string(n),\n                if kernel_dependent_hol.index_of_type(tys, a) == k {\n                  sres\n                } else {\n                  trivial\n                },\n              ),\n            )\n          }\n        }\n        body := if q == k {\n          kernel_dependent_hol.at(\n            kernel_dependent.Free(\"g\" + to_string(i)),\n            xs.map(x -> kernel_dependent.Free(x.0)),\n          )\n        } else {\n          kernel_dependent.reflexivity(\n            0,\n            kernel_dependent_hol.bool(),\n            kernel_dependent_hol.c(\"true\"),\n          )\n        }\n        mut minors.push(kernel_dependent_hol.lams(xs + ihs, body))\n      }\n    }\n    case_value := kernel_dependent_hol.lams(\n      ps + [(\"'#s\", kernel_dependent.Sort(0))] + gs + [(\"x\", self)],\n      kernel_dependent_hol.at(kernel_dependent.Constant {\n        name: \"h.\" + s.name + \".rec\",\n        levels: [0],\n      }, pvars + case_motives + minors + [kernel_dependent.Free(\"x\")]),\n    )\n    case_type := kernel_dependent_hol.pis(\n      ps + [(\"'#s\", kernel_dependent.Sort(0))] + gs + [(\"x\", self)],\n      sres,\n    )\n    r.env = kernel_dependent.define(\n      r.env,\n      \"h.case_\" + s.name,\n      case_type,\n      case_value,\n    )!\n    mut r.consts.insert(\n      \"case_\" + s.name,\n      (params + [\"#s\"], kernel.function_type_of(s.ctors.map(\n          p ->\n            kernel.function_type_of(p.1, kernel.TypeVariable(\"#s\")),\n        )\n        + [t], kernel.TypeVariable(\"#s\"))),\n    )\n  }\n  Ok(())\n}"},{"name":"kernel_dependent_hol.index_of","kind":"fn","old":null,"new":"44ed41c76caef633","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn index_of(xs: List[String], x: String) -> Int {\n  for (i, y) in enumerate(xs) {\n    if y == x {\n      return i\n    }\n  }\n  -1\n}"},{"name":"kernel_dependent_hol.index_of_type","kind":"fn","old":null,"new":"6709b5b652eed804","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn index_of_type(xs: List[kernel.Type], x: kernel.Type) -> Int {\n  for (i, y) in enumerate(xs) {\n    if y == x {\n      return i\n    }\n  }\n  -1\n}"},{"name":"kernel_dependent_hol.type_term_in_group","kind":"fn","old":null,"new":"48839fcb7bc85d5f","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// A constructor argument's type while its group is defined: the group's\n/// own types by name, the rest as usual.\nfn type_term_in_group(\n  mut r: kernel_dependent_hol.Replay,\n  t: kernel.Type,\n  specs: List[kernel.DatatypeSpec],\n  pvars: List[kernel_dependent_hol.D],\n) -> Result[kernel_dependent_hol.D, String] {\n  match t {\n    kernel.TypeApplication { name, .. } => if specs.any(s -> s.name == name) {\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"h.\" + name),\n        pvars,\n      ))\n    } else {\n      kernel_dependent_hol.type_term(mut r, t)\n    },\n    _ => kernel_dependent_hol.type_term(mut r, t),\n  }\n}"},{"name":"kernel_dependent_hol.base","kind":"fn","old":null,"new":"002be1327a9a5d71","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"// ---- the HOL rules as lemmas, proven once ----\n\n/// `hol.*`: each HOL rule as a lemma of the dependent kernel.\npub fn base(\n  env: kernel_dependent.Environment,\n) -> Result[kernel_dependent.Environment, String] {\n  a_type := kernel_dependent.Free(\"A\")\n  b_type := kernel_dependent.Free(\"B\")\n  a := kernel_dependent.Free(\"a\")\n  b := kernel_dependent.Free(\"b\")\n  cc := kernel_dependent.Free(\"c\")\n  p := kernel_dependent.Free(\"p\")\n  q := kernel_dependent.Free(\"q\")\n  t0 := kernel_dependent.Sort(0)\n  refl0 := (ty: kernel_dependent_hol.D, x: kernel_dependent_hol.D) ->\n    kernel_dependent.reflexivity(0, ty, x)\n  elim := (ty: kernel_dependent_hol.D, x: kernel_dependent_hol.D, y: kernel_dependent_hol.D, h: kernel_dependent_hol.D) ->\n    kernel_dependent_hol.at(\n      kernel_dependent_hol.c(\"eqv_elim\"),\n      [ty, x, y, h],\n    )\n  intro := (ty: kernel_dependent_hol.D, x: kernel_dependent_hol.D, y: kernel_dependent_hol.D, e: kernel_dependent_hol.D) ->\n    kernel_dependent_hol.at(\n      kernel_dependent_hol.c(\"eqv_intro\"),\n      [ty, x, y, e],\n    )\n  eq := (ty: kernel_dependent_hol.D, x: kernel_dependent_hol.D, y: kernel_dependent_hol.D) ->\n    kernel_dependent.equality(0, ty, x, y)\n  mut e := env\n  // absurd: from `holds false`, anything\n  code := kernel_dependent.lambda(\n    \"z\",\n    kernel_dependent_hol.bool(),\n    kernel_dependent_hol.at(\n      kernel_dependent.Constant { name: \"Bool.rec\", levels: [1] },\n      [\n        kernel_dependent.lambda(\n          \"_b\",\n          kernel_dependent_hol.bool(),\n          t0,\n        ),\n        kernel_dependent.Free(\"P\"),\n        eq(\n          kernel_dependent_hol.bool(),\n          kernel_dependent_hol.c(\"true\"),\n          kernel_dependent_hol.c(\"true\"),\n        ),\n        kernel_dependent.Free(\"z\"),\n      ],\n    ),\n  )\n  e = kernel_dependent.define(\n    e,\n    \"hol.absurd\",\n    kernel_dependent_hol.pis([(\"P\", t0), (\n      \"h\",\n      kernel_dependent_hol.holds(kernel_dependent_hol.c(\"false\")),\n    )], kernel_dependent.Free(\"P\")),\n    kernel_dependent_hol.lams([(\"P\", t0), (\n      \"h\",\n      kernel_dependent_hol.holds(kernel_dependent_hol.c(\"false\")),\n    )], kernel_dependent_hol.at(kernel_dependent_hol.j(0, 0), [\n      kernel_dependent_hol.bool(),\n      kernel_dependent_hol.c(\"false\"),\n      kernel_dependent_hol.lams(\n        [(\"z\", kernel_dependent_hol.bool()), (\"_e\", eq(\n          kernel_dependent_hol.bool(),\n          kernel_dependent_hol.c(\"false\"),\n          kernel_dependent.Free(\"z\"),\n        ))],\n        kernel_dependent.Apply {\n          function: code,\n          argument: kernel_dependent.Free(\"z\"),\n        },\n      ),\n      refl0(\n        kernel_dependent_hol.bool(),\n        kernel_dependent_hol.c(\"true\"),\n      ),\n      kernel_dependent_hol.c(\"true\"),\n      kernel_dependent.Free(\"h\"),\n    ])),\n  )!\n  e = kernel_dependent.define(e, \"hol.refl\", kernel_dependent_hol.pis(\n    [(\"A\", t0), (\"a\", a_type)],\n    kernel_dependent_hol.holds(\n      kernel_dependent_hol.eqv(a_type, a, a),\n    ),\n  ), kernel_dependent_hol.lams(\n    [(\"A\", t0), (\"a\", a_type)],\n    intro(a_type, a, a, refl0(a_type, a)),\n  ))!\n  e = kernel_dependent.define(e, \"hol.trans\", kernel_dependent_hol.pis(\n    [\n      (\"A\", t0),\n      (\"a\", a_type),\n      (\"b\", a_type),\n      (\"c\", a_type),\n      (\"h1\", kernel_dependent_hol.holds(\n        kernel_dependent_hol.eqv(a_type, a, b),\n      )),\n      (\"h2\", kernel_dependent_hol.holds(\n        kernel_dependent_hol.eqv(a_type, b, cc),\n      )),\n    ],\n    kernel_dependent_hol.holds(\n      kernel_dependent_hol.eqv(a_type, a, cc),\n    ),\n  ), kernel_dependent_hol.lams(\n    [\n      (\"A\", t0),\n      (\"a\", a_type),\n      (\"b\", a_type),\n      (\"c\", a_type),\n      (\"h1\", kernel_dependent_hol.holds(\n        kernel_dependent_hol.eqv(a_type, a, b),\n      )),\n      (\"h2\", kernel_dependent_hol.holds(\n        kernel_dependent_hol.eqv(a_type, b, cc),\n      )),\n    ],\n    intro(\n      a_type,\n      a,\n      cc,\n      kernel_dependent_hol.at(kernel_dependent_hol.j(0, 0), [\n        a_type,\n        b,\n        kernel_dependent_hol.lams([\n          (\"z\", a_type),\n          (\"_e\", eq(a_type, b, kernel_dependent.Free(\"z\"))),\n        ], eq(a_type, a, kernel_dependent.Free(\"z\"))),\n        elim(a_type, a, b, kernel_dependent.Free(\"h1\")),\n        cc,\n        elim(a_type, b, cc, kernel_dependent.Free(\"h2\")),\n      ]),\n    ),\n  ))!\n  fab := kernel_dependent_hol.arrow(a_type, b_type)\n  f := kernel_dependent.Free(\"f\")\n  g := kernel_dependent.Free(\"g\")\n  x := kernel_dependent.Free(\"x\")\n  y := kernel_dependent.Free(\"y\")\n  app := (u: kernel_dependent_hol.D, v: kernel_dependent_hol.D) ->\n    kernel_dependent.Apply { function: u, argument: v }\n  cong_ps := [\n    (\"A\", t0),\n    (\"B\", t0),\n    (\"f\", fab),\n    (\"g\", fab),\n    (\"x\", a_type),\n    (\"y\", a_type),\n    (\n      \"h1\",\n      kernel_dependent_hol.holds(\n        kernel_dependent_hol.eqv(fab, f, g),\n      ),\n    ),\n    (\"h2\", kernel_dependent_hol.holds(\n      kernel_dependent_hol.eqv(a_type, x, y),\n    )),\n  ]\n  e = kernel_dependent.define(\n    e,\n    \"hol.cong\",\n    kernel_dependent_hol.pis(cong_ps, kernel_dependent_hol.holds(\n      kernel_dependent_hol.eqv(b_type, app(f, x), app(g, y)),\n    )),\n    kernel_dependent_hol.lams(\n      cong_ps,\n      intro(b_type, app(f, x), app(g, y), kernel_dependent_hol.at(\n        kernel_dependent_hol.j(0, 0),\n        [fab, f, kernel_dependent_hol.lams(\n          [\n            (\"k\", fab),\n            (\"_e\", eq(fab, f, kernel_dependent.Free(\"k\"))),\n          ],\n          eq(b_type, app(f, x), app(kernel_dependent.Free(\"k\"), y)),\n        ), kernel_dependent_hol.at(kernel_dependent_hol.j(0, 0), [\n          a_type,\n          x,\n          kernel_dependent_hol.lams([\n            (\"z\", a_type),\n            (\"_e\", eq(a_type, x, kernel_dependent.Free(\"z\"))),\n          ], eq(b_type, app(f, x), app(f, kernel_dependent.Free(\"z\")))),\n          refl0(b_type, app(f, x)),\n          y,\n          elim(a_type, x, y, kernel_dependent.Free(\"h2\")),\n        ]), g, elim(fab, f, g, kernel_dependent.Free(\"h1\"))],\n      )),\n    ),\n  )!\n  abs_ps := [\n    (\"A\", t0),\n    (\"B\", t0),\n    (\"f\", fab),\n    (\"g\", fab),\n    (\n      \"h\",\n      kernel_dependent.pi(\"x\", a_type, kernel_dependent_hol.holds(\n        kernel_dependent_hol.eqv(b_type, app(f, x), app(g, x)),\n      )),\n    ),\n  ]\n  e = kernel_dependent.define(e, \"hol.abs\", kernel_dependent_hol.pis(\n    abs_ps,\n    kernel_dependent_hol.holds(kernel_dependent_hol.eqv(fab, f, g)),\n  ), kernel_dependent_hol.lams(\n    abs_ps,\n    intro(fab, f, g, kernel_dependent_hol.at(\n      kernel_dependent.Constant { name: \"funext\", levels: [0, 0] },\n      [\n        a_type,\n        kernel_dependent.lambda(\"_x\", a_type, b_type),\n        f,\n        g,\n        kernel_dependent.lambda(\"x\", a_type, elim(\n          b_type,\n          app(f, x),\n          app(g, x),\n          app(kernel_dependent.Free(\"h\"), x),\n        )),\n      ],\n    )),\n  ))!\n  mp_ps := [\n    (\"p\", kernel_dependent_hol.bool()),\n    (\"q\", kernel_dependent_hol.bool()),\n    (\"h\", kernel_dependent_hol.holds(\n      kernel_dependent_hol.eqv(kernel_dependent_hol.bool(), p, q),\n    )),\n    (\"hp\", kernel_dependent_hol.holds(p)),\n  ]\n  e = kernel_dependent.define(\n    e,\n    \"hol.eq_mp\",\n    kernel_dependent_hol.pis(mp_ps, kernel_dependent_hol.holds(q)),\n    kernel_dependent_hol.lams(\n      mp_ps,\n      kernel_dependent_hol.at(\n        kernel_dependent_hol.j(0, 0),\n        [kernel_dependent_hol.bool(), p, kernel_dependent_hol.lams(\n          [(\"z\", kernel_dependent_hol.bool()), (\"_e\", eq(\n            kernel_dependent_hol.bool(),\n            p,\n            kernel_dependent.Free(\"z\"),\n          ))],\n          kernel_dependent_hol.holds(kernel_dependent.Free(\"z\")),\n        ), kernel_dependent.Free(\"hp\"), q, elim(\n          kernel_dependent_hol.bool(),\n          p,\n          q,\n          kernel_dependent.Free(\"h\"),\n        )],\n      ),\n    ),\n  )!\n  absurd := (ty: kernel_dependent_hol.D, h: kernel_dependent_hol.D) ->\n    kernel_dependent_hol.at(\n      kernel_dependent_hol.c(\"hol.absurd\"),\n      [ty, h],\n    )\n  tt := refl0(kernel_dependent_hol.bool(), kernel_dependent_hol.c(\"true\"))\n  by_cases := (gl: kernel_dependent_tactics.Goal, v: String, yes: (kernel_dependent_tactics.Goal) -> Result[kernel_dependent_hol.D, String], no: (kernel_dependent_tactics.Goal) -> Result[kernel_dependent_hol.D, String]) ->\n    kernel_dependent_tactics.cases(\n      gl,\n      kernel_dependent.Free(v),\n      \"\",\n      [\n        kernel_dependent_tactics.Case { names: [], proof: yes },\n        kernel_dependent_tactics.Case { names: [], proof: no },\n      ],\n    )\n  // antisym: (q ⇒ p) and (p ⇒ q) give p = q\n  e = kernel_dependent_tactics.prove(\n    e,\n    \"hol.antisym\",\n    kernel_dependent_hol.pis([\n      (\"p\", kernel_dependent_hol.bool()),\n      (\"q\", kernel_dependent_hol.bool()),\n    ], kernel_dependent_hol.arrow(kernel_dependent_hol.arrow(\n      kernel_dependent_hol.holds(q),\n      kernel_dependent_hol.holds(p),\n    ), kernel_dependent_hol.arrow(kernel_dependent_hol.arrow(\n      kernel_dependent_hol.holds(p),\n      kernel_dependent_hol.holds(q),\n    ), kernel_dependent_hol.holds(\n      kernel_dependent_hol.eqv(kernel_dependent_hol.bool(), p, q),\n    )))),\n    gl -> kernel_dependent_tactics.intros(\n      gl,\n      [\"p\", \"q\"],\n      g1 -> by_cases(g1, \"p\", g2 -> by_cases(\n        g2,\n        \"q\",\n        g3 ->\n          kernel_dependent_tactics.intros(\n            g3,\n            [\"h1\", \"h2\"],\n            g4 -> kernel_dependent_tactics.exact(\n              g4,\n              kernel_dependent_hol.at(\n                kernel_dependent_hol.c(\"hol.refl\"),\n                [\n                  kernel_dependent_hol.bool(),\n                  kernel_dependent_hol.c(\"true\"),\n                ],\n              ),\n            ),\n          ),\n        g3 -> kernel_dependent_tactics.intros(\n          g3,\n          [\"h1\", \"h2\"],\n          g4 -> kernel_dependent_tactics.exact(g4, absurd(\n            kernel_dependent_hol.holds(kernel_dependent_hol.eqv(\n              kernel_dependent_hol.bool(),\n              kernel_dependent_hol.c(\"true\"),\n              kernel_dependent_hol.c(\"false\"),\n            )),\n            app(kernel_dependent.Free(\"h2\"), tt),\n          )),\n        ),\n      ), g2 -> by_cases(g2, \"q\", g3 -> kernel_dependent_tactics.intros(\n        g3,\n        [\"h1\", \"h2\"],\n        g4 -> kernel_dependent_tactics.exact(\n          g4,\n          absurd(\n            kernel_dependent_hol.holds(kernel_dependent_hol.eqv(\n              kernel_dependent_hol.bool(),\n              kernel_dependent_hol.c(\"false\"),\n              kernel_dependent_hol.c(\"true\"),\n            )),\n            app(kernel_dependent.Free(\"h1\"), tt),\n          ),\n        ),\n      ), g3 -> kernel_dependent_tactics.intros(g3, [\"h1\", \"h2\"], g4 ->\n        kernel_dependent_tactics.exact(g4, kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.refl\"),\n          [\n            kernel_dependent_hol.bool(),\n            kernel_dependent_hol.c(\"false\"),\n          ],\n        ))))),\n    ),\n  )!\n  implies := (u: kernel_dependent_hol.D, v: kernel_dependent_hol.D) ->\n    kernel_dependent_hol.at(\n      kernel_dependent_hol.c(\"implies\"),\n      [u, v],\n    )\n  e = kernel_dependent_tactics.prove(\n    e,\n    \"hol.disch\",\n    kernel_dependent_hol.pis([\n      (\"p\", kernel_dependent_hol.bool()),\n      (\"q\", kernel_dependent_hol.bool()),\n    ], kernel_dependent_hol.arrow(kernel_dependent_hol.arrow(\n      kernel_dependent_hol.holds(p),\n      kernel_dependent_hol.holds(q),\n    ), kernel_dependent_hol.holds(implies(p, q)))),\n    gl -> kernel_dependent_tactics.intros(\n      gl,\n      [\"p\", \"q\"],\n      g1 -> by_cases(g1, \"p\", g2 -> kernel_dependent_tactics.intros(\n        g2,\n        [\"h\"],\n        g3 -> kernel_dependent_tactics.exact(\n          g3,\n          app(kernel_dependent.Free(\"h\"), tt),\n        ),\n      ), g2 -> kernel_dependent_tactics.intros(\n        g2,\n        [\"h\"],\n        g3 -> kernel_dependent_tactics.exact(g3, tt),\n      )),\n    ),\n  )!\n  e = kernel_dependent_tactics.prove(\n    e,\n    \"hol.mp\",\n    kernel_dependent_hol.pis([\n      (\"p\", kernel_dependent_hol.bool()),\n      (\"q\", kernel_dependent_hol.bool()),\n    ], kernel_dependent_hol.arrow(\n      kernel_dependent_hol.holds(implies(p, q)),\n      kernel_dependent_hol.arrow(\n        kernel_dependent_hol.holds(p),\n        kernel_dependent_hol.holds(q),\n      ),\n    )),\n    gl ->\n      kernel_dependent_tactics.intros(\n        gl,\n        [\"p\", \"q\"],\n        g1 ->\n          by_cases(g1, \"p\", g2 -> kernel_dependent_tactics.intros(\n            g2,\n            [\"h\", \"hp\"],\n            g3 -> kernel_dependent_tactics.exact(\n              g3,\n              kernel_dependent.Free(\"h\"),\n            ),\n          ), g2 -> kernel_dependent_tactics.intros(\n            g2,\n            [\"h\", \"hp\"],\n            g3 -> kernel_dependent_tactics.exact(g3, absurd(\n              kernel_dependent_hol.holds(q),\n              kernel_dependent.Free(\"hp\"),\n            )),\n          )),\n      ),\n  )!\n  e = kernel_dependent_tactics.prove(\n    e,\n    \"hol.eq_true\",\n    kernel_dependent_hol.pis(\n      [(\"p\", kernel_dependent_hol.bool())],\n      kernel_dependent_hol.arrow(\n        kernel_dependent_hol.holds(p),\n        kernel_dependent_hol.holds(kernel_dependent_hol.eqv(\n          kernel_dependent_hol.bool(),\n          p,\n          kernel_dependent_hol.c(\"true\"),\n        )),\n      ),\n    ),\n    gl -> kernel_dependent_tactics.intros(gl, [\"p\"], g1 -> by_cases(\n      g1,\n      \"p\",\n      g2 -> kernel_dependent_tactics.intros(g2, [\"h\"], g3 ->\n        kernel_dependent_tactics.exact(g3, kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.refl\"),\n          [\n            kernel_dependent_hol.bool(),\n            kernel_dependent_hol.c(\"true\"),\n          ],\n        ))),\n      g2 -> kernel_dependent_tactics.intros(\n        g2,\n        [\"h\"],\n        g3 -> kernel_dependent_tactics.exact(\n          g3,\n          absurd(\n            kernel_dependent_hol.holds(kernel_dependent_hol.eqv(\n              kernel_dependent_hol.bool(),\n              kernel_dependent_hol.c(\"false\"),\n              kernel_dependent_hol.c(\"true\"),\n            )),\n            kernel_dependent.Free(\"h\"),\n          ),\n        ),\n      ),\n    )),\n  )!\n  e = kernel_dependent_tactics.prove(\n    e,\n    \"hol.eq_false\",\n    kernel_dependent_hol.pis(\n      [(\"p\", kernel_dependent_hol.bool())],\n      kernel_dependent_hol.arrow(kernel_dependent_hol.arrow(\n        kernel_dependent_hol.holds(p),\n        kernel_dependent_hol.holds(kernel_dependent_hol.c(\"false\")),\n      ), kernel_dependent_hol.holds(kernel_dependent_hol.eqv(\n        kernel_dependent_hol.bool(),\n        p,\n        kernel_dependent_hol.c(\"false\"),\n      ))),\n    ),\n    gl -> kernel_dependent_tactics.intros(\n      gl,\n      [\"p\"],\n      g1 -> by_cases(g1, \"p\", g2 -> kernel_dependent_tactics.intros(\n        g2,\n        [\"h\"],\n        g3 -> kernel_dependent_tactics.exact(\n          g3,\n          absurd(\n            kernel_dependent_hol.holds(kernel_dependent_hol.eqv(\n              kernel_dependent_hol.bool(),\n              kernel_dependent_hol.c(\"true\"),\n              kernel_dependent_hol.c(\"false\"),\n            )),\n            app(kernel_dependent.Free(\"h\"), tt),\n          ),\n        ),\n      ), g2 -> kernel_dependent_tactics.intros(g2, [\"h\"], g3 ->\n        kernel_dependent_tactics.exact(g3, kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.refl\"),\n          [\n            kernel_dependent_hol.bool(),\n            kernel_dependent_hol.c(\"false\"),\n          ],\n        )))),\n    ),\n  )!\n  and_ := (u: kernel_dependent_hol.D, v: kernel_dependent_hol.D) ->\n    kernel_dependent_hol.at(kernel_dependent_hol.c(\"and\"), [u, v])\n  e = kernel_dependent_tactics.prove(\n    e,\n    \"hol.and_intro\",\n    kernel_dependent_hol.pis([\n      (\"p\", kernel_dependent_hol.bool()),\n      (\"q\", kernel_dependent_hol.bool()),\n    ], kernel_dependent_hol.arrow(\n      kernel_dependent_hol.holds(p),\n      kernel_dependent_hol.arrow(\n        kernel_dependent_hol.holds(q),\n        kernel_dependent_hol.holds(and_(p, q)),\n      ),\n    )),\n    gl ->\n      kernel_dependent_tactics.intros(\n        gl,\n        [\"p\", \"q\"],\n        g1 ->\n          by_cases(g1, \"p\", g2 -> kernel_dependent_tactics.intros(\n            g2,\n            [\"hp\", \"hq\"],\n            g3 -> kernel_dependent_tactics.exact(\n              g3,\n              kernel_dependent.Free(\"hq\"),\n            ),\n          ), g2 -> kernel_dependent_tactics.intros(\n            g2,\n            [\"hp\", \"hq\"],\n            g3 -> kernel_dependent_tactics.exact(\n              g3,\n              kernel_dependent.Free(\"hp\"),\n            ),\n          )),\n      ),\n  )!\n  e = kernel_dependent_tactics.prove(\n    e,\n    \"hol.and_left\",\n    kernel_dependent_hol.pis([\n      (\"p\", kernel_dependent_hol.bool()),\n      (\"q\", kernel_dependent_hol.bool()),\n    ], kernel_dependent_hol.arrow(\n      kernel_dependent_hol.holds(and_(p, q)),\n      kernel_dependent_hol.holds(p),\n    )),\n    gl -> kernel_dependent_tactics.intros(\n      gl,\n      [\"p\", \"q\"],\n      g1 -> by_cases(g1, \"p\", g2 -> kernel_dependent_tactics.intros(\n        g2,\n        [\"h\"],\n        g3 -> kernel_dependent_tactics.exact(g3, tt),\n      ), g2 -> kernel_dependent_tactics.intros(g2, [\"h\"], g3 ->\n        kernel_dependent_tactics.exact(\n          g3,\n          kernel_dependent.Free(\"h\"),\n        ))),\n    ),\n  )!\n  kernel_dependent_tactics.prove(\n    e,\n    \"hol.and_right\",\n    kernel_dependent_hol.pis([\n      (\"p\", kernel_dependent_hol.bool()),\n      (\"q\", kernel_dependent_hol.bool()),\n    ], kernel_dependent_hol.arrow(\n      kernel_dependent_hol.holds(and_(p, q)),\n      kernel_dependent_hol.holds(q),\n    )),\n    gl ->\n      kernel_dependent_tactics.intros(\n        gl,\n        [\"p\", \"q\"],\n        g1 ->\n          by_cases(g1, \"p\", g2 -> kernel_dependent_tactics.intros(\n            g2,\n            [\"h\"],\n            g3 -> kernel_dependent_tactics.exact(\n              g3,\n              kernel_dependent.Free(\"h\"),\n            ),\n          ), g2 -> kernel_dependent_tactics.intros(\n            g2,\n            [\"h\"],\n            g3 -> kernel_dependent_tactics.exact(g3, absurd(\n              kernel_dependent_hol.holds(q),\n              kernel_dependent.Free(\"h\"),\n            )),\n          )),\n      ),\n  )\n}"},{"name":"kernel_dependent_hol.conclusion_of","kind":"fn","old":null,"new":"8213ca6a223941e8","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"// ---- theorems as proof terms ----\n\nfn conclusion_of(\n  mut r: kernel_dependent_hol.Replay,\n  th: kernel.Theorem,\n) -> Result[kernel_dependent_hol.D, String] {\n  kernel_dependent_hol.term(mut r, kernel.conclusion(th))\n}"},{"name":"kernel_dependent_hol.eq_parts","kind":"fn","old":null,"new":"7684e82ba7e7835a","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn eq_parts(t: kernel.Term) -> (kernel.Term, kernel.Term) {\n  kernel.split_equation(t) ?? (t, t)\n}"},{"name":"kernel_dependent_hol.proof","kind":"fn","old":null,"new":"dac647fc8bb30bcb","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// The term proving `th`'s conclusion (as `holds`), from its hypotheses as\n/// free variables `h:…` and its free variables as `v:…`.\npub fn proof(\n  mut r: kernel_dependent_hol.Replay,\n  th: kernel.Theorem,\n) -> Result[kernel_dependent_hol.D, String] {\n  st := kernel.step_of(th)\n  premise := (i: Int) -> get(st.premises, i) ?? th\n  rule := st.rule\n  ct := kernel.conclusion(th)\n  if starts_with(rule, \"named:\") {\n    return kernel_dependent_hol.named(\n      mut r,\n      byte_slice(rule, 6, byte_len(rule)),\n      premise(0),\n    )\n  }\n  if starts_with(rule, \"axiom:\") {\n    return kernel_dependent_hol.axiom(\n      mut r,\n      byte_slice(rule, 6, byte_len(rule)),\n      th,\n    )\n  }\n  if starts_with(rule, \"oracle:\") {\n    return Ok(kernel_dependent.Apply {\n      function: kernel_dependent_hol.c(\"oracle\"),\n      argument: kernel_dependent_hol.holds(\n        kernel_dependent_hol.conclusion_of(mut r, th)!,\n      ),\n    })\n  }\n  match rule {\n    \"refl\" | \"beta\" | \"compute\" | \"define\" => {\n      if rule == \"define\" {\n        kernel_dependent_hol.define_constant(mut r, st.terms)!\n      }\n      (l, rt) := kernel_dependent_hol.eq_parts(ct)\n      a_type := kernel_dependent_hol.type_term(\n        mut r,\n        kernel_dependent_hol.hol_type(l),\n      )!\n      if rule == \"compute\"\n        && kernel_dependent_hol.hol_type(l) == kernel.boolean_type() {\n        return kernel_dependent_hol.compute_equality(mut r, l, rt)\n      }\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.refl\"),\n        [a_type, kernel_dependent_hol.term(mut r, l)!],\n      ))\n    },\n    \"trans\" => {\n      (a, b) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      (_, cc) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(1)))\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.trans\"),\n          [\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.hol_type(a),\n            )!,\n            kernel_dependent_hol.term(mut r, a)!,\n            kernel_dependent_hol.term(mut r, b)!,\n            kernel_dependent_hol.term(mut r, cc)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.proof(mut r, premise(1))!,\n          ],\n        ),\n      )\n    },\n    \"cong\" => {\n      (f, g) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      (x, y) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(1)))\n      ft := kernel_dependent_hol.hol_type(f)\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.cong\"),\n          [\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.first_argument(ft),\n            )!,\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.second(ft),\n            )!,\n            kernel_dependent_hol.term(mut r, f)!,\n            kernel_dependent_hol.term(mut r, g)!,\n            kernel_dependent_hol.term(mut r, x)!,\n            kernel_dependent_hol.term(mut r, y)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.proof(mut r, premise(1))!,\n          ],\n        ),\n      )\n    },\n    \"abs\" => {\n      (lhs, rhs) := kernel_dependent_hol.eq_parts(ct)\n      x := get(st.terms, 0) ?? lhs\n      xn := kernel_dependent_hol.variable(mut r, x)\n      xt := kernel_dependent_hol.hol_type(x)\n      (s, t) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      inner := kernel_dependent_hol.proof(mut r, premise(0))!\n      Ok(\n        kernel_dependent_hol.at(kernel_dependent_hol.c(\"hol.abs\"), [\n          kernel_dependent_hol.type_term(mut r, xt)!,\n          kernel_dependent_hol.type_term(\n            mut r,\n            kernel_dependent_hol.hol_type(s),\n          )!,\n          kernel_dependent_hol.term(mut r, lhs)!,\n          kernel_dependent_hol.term(mut r, rhs)!,\n          kernel_dependent.lambda(\n            xn,\n            kernel_dependent_hol.type_term(mut r, xt)!,\n            inner,\n          ),\n        ]),\n      )\n    },\n    \"assume\" => Ok(kernel_dependent.Free(kernel_dependent_hol.hypothesis(ct))),\n    \"eq_mp\" => {\n      (p, q) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.eq_mp\"),\n          [\n            kernel_dependent_hol.term(mut r, p)!,\n            kernel_dependent_hol.term(mut r, q)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.proof(mut r, premise(1))!,\n          ],\n        ),\n      )\n    },\n    \"antisym\" => {\n      p := kernel.conclusion(premise(0))\n      q := kernel.conclusion(premise(1))\n      dp := kernel_dependent_hol.term(mut r, p)!\n      dq := kernel_dependent_hol.term(mut r, q)!\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.antisym\"),\n        [dp, dq, kernel_dependent.lambda(\n          kernel_dependent_hol.hypothesis(q),\n          kernel_dependent_hol.holds(dq),\n          kernel_dependent_hol.proof(mut r, premise(0))!,\n        ), kernel_dependent.lambda(\n          kernel_dependent_hol.hypothesis(p),\n          kernel_dependent_hol.holds(dp),\n          kernel_dependent_hol.proof(mut r, premise(1))!,\n        )],\n      ))\n    },\n    \"disch\" => {\n      p := get(st.terms, 0) ?? ct\n      dp := kernel_dependent_hol.term(mut r, p)!\n      dq := kernel_dependent_hol.term(\n        mut r,\n        kernel.conclusion(premise(0)),\n      )!\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.disch\"),\n        [dp, dq, kernel_dependent.lambda(\n          kernel_dependent_hol.hypothesis(p),\n          kernel_dependent_hol.holds(dp),\n          kernel_dependent_hol.proof(mut r, premise(0))!,\n        )],\n      ))\n    },\n    \"mp\" => {\n      (p, q) := kernel.split_connective(\"==>\", kernel.conclusion(premise(0))) ?? (ct, ct)\n      Ok(kernel_dependent_hol.at(kernel_dependent_hol.c(\"hol.mp\"), [\n        kernel_dependent_hol.term(mut r, p)!,\n        kernel_dependent_hol.term(mut r, q)!,\n        kernel_dependent_hol.proof(mut r, premise(0))!,\n        kernel_dependent_hol.proof(mut r, premise(1))!,\n      ]))\n    },\n    \"gen\" => {\n      x := get(st.terms, 0) ?? ct\n      xn := kernel_dependent_hol.variable(mut r, x)\n      (_, lam) := kernel_dependent_hol.split_application(ct)\n      xt := kernel_dependent_hol.type_term(\n        mut r,\n        kernel_dependent_hol.hol_type(x),\n      )!\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"all_intro\"),\n          [\n            xt,\n            kernel_dependent_hol.term(mut r, lam)!,\n            kernel_dependent.lambda(\n              xn,\n              xt,\n              kernel_dependent_hol.proof(mut r, premise(0))!,\n            ),\n          ],\n        ),\n      )\n    },\n    \"spec\" => {\n      t := get(st.terms, 0) ?? ct\n      (_, lam) := kernel_dependent_hol.split_application(\n        kernel.conclusion(premise(0)),\n      )\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"all_elim\"),\n          [\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.hol_type(t),\n            )!,\n            kernel_dependent_hol.term(mut r, lam)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.term(mut r, t)!,\n          ],\n        ),\n      )\n    },\n    \"inst\" => {\n      inner := kernel_dependent_hol.proof(mut r, premise(0))!\n      mut s := []\n      for (v, u) in st.substitution {\n        mut s.push(\n          (\n            kernel_dependent_hol.variable(mut r, v),\n            kernel_dependent_hol.term(mut r, u)!,\n          ),\n        )\n      }\n      for (i, h) in enumerate(kernel.assumptions(premise(0))) {\n        mut s.push(\n          (\n            kernel_dependent_hol.hypothesis(h),\n            kernel_dependent.Free(kernel_dependent_hol.hypothesis(\n              get(kernel.assumptions(th), i) ?? h,\n            )),\n          ),\n        )\n      }\n      Ok(kernel_dependent_hol.substitute(inner, s))\n    },\n    \"inst_type\" => {\n      inner := kernel_dependent_hol.proof(mut r, premise(0))!\n      mut s := []\n      for (v, t) in st.types {\n        mut s.push((\"'\" + v, kernel_dependent_hol.type_term(mut r, t)!))\n      }\n      for n in kernel_dependent_hol.free_names(inner) {\n        match get(r.vars, n) {\n          Some(kernel.Variable { name, value_type }) => {\n            nv := kernel.Variable {\n              name,\n              value_type: kernel.substitute_types(value_type, st.types),\n            }\n            mut s.push(\n              (n, kernel_dependent.Free(\n                kernel_dependent_hol.variable(mut r, nv),\n              )),\n            )\n          },\n          _ => (),\n        }\n      }\n      for (i, h) in enumerate(kernel.assumptions(premise(0))) {\n        mut s.push(\n          (\n            kernel_dependent_hol.hypothesis(h),\n            kernel_dependent.Free(kernel_dependent_hol.hypothesis(\n              get(kernel.assumptions(th), i) ?? h,\n            )),\n          ),\n        )\n      }\n      Ok(kernel_dependent_hol.substitute(inner, s))\n    },\n    \"induction\" | \"recursion\" | \"cases\" | \"injective\" | \"distinct\" => kernel_dependent_hol.datatype_fact(mut r, st, th),\n    _ => Err(\"no replay for the rule `\" + rule + \"`\"),\n  }\n}"},{"name":"kernel_dependent_hol.split_application","kind":"fn","old":null,"new":"032277a1e20016a8","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn split_application(t: kernel.Term) -> (kernel.Term, kernel.Term) {\n  match t {\n    kernel.Application { function, argument } => (function, argument),\n    _ => (t, t),\n  }\n}"},{"name":"kernel_dependent_hol.define_constant","kind":"fn","old":null,"new":"8dc4376dcb9de99b","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// `c = rhs` from a `define` step: the constant defined (once) by its\n/// right side, over its type variables.\nfn define_constant(\n  mut r: kernel_dependent_hol.Replay,\n  terms: List[kernel.Term],\n) -> Result[(), String] {\n  match terms {\n    [kernel.Constant { name, value_type }, rhs] => if get(r.consts, name) == None {\n      tvs := kernel.type_variables(value_type)\n      ps := tvs.map(v -> (\"'\" + v, kernel_dependent.Sort(0)))\n      value := kernel_dependent_hol.lams(\n        ps,\n        kernel_dependent_hol.term(mut r, rhs)!,\n      )\n      ty := kernel_dependent_hol.pis(\n        ps,\n        kernel_dependent_hol.type_term(mut r, value_type)!,\n      )\n      r.env = kernel_dependent.define(r.env, \"h.\" + name, ty, value)!\n      mut r.consts.insert(name, (tvs, value_type))\n      Ok(())\n    } else {\n      Ok(())\n    },\n    _ => Err(\"define: its terms\"),\n  }\n}"},{"name":"kernel_dependent_hol.compute_equality","kind":"fn","old":null,"new":"075dd2fa4067bdab","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// `(m = n) = T` or `= F` for integer literals.\nfn compute_equality(\n  mut r: kernel_dependent_hol.Replay,\n  l: kernel.Term,\n  v: kernel.Term,\n) -> Result[kernel_dependent_hol.D, String] {\n  (m, n) := kernel_dependent_hol.eq_parts(l)\n  dm := kernel_dependent_hol.term(mut r, m)!\n  dn := kernel_dependent_hol.term(mut r, n)!\n  dl := kernel_dependent_hol.term(mut r, l)!\n  if kernel_dependent_hol.term(mut r, v)! == kernel_dependent_hol.c(\"true\") {\n    Ok(kernel_dependent_hol.at(\n      kernel_dependent_hol.c(\"hol.eq_true\"),\n      [dl, kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.refl\"),\n        [kernel_dependent_hol.c(\"Int\"), dm],\n      )],\n    ))\n  } else {\n    h := \"#ne\"\n    ok := kernel_dependent.lambda(\n      h,\n      kernel_dependent_hol.holds(dl),\n      kernel_dependent_hol.at(kernel_dependent_hol.j(0, 0), [\n        kernel_dependent_hol.c(\"Int\"),\n        dm,\n        kernel_dependent_hol.lams([\n          (\"z\", kernel_dependent_hol.c(\"Int\")),\n          (\"_e\", kernel_dependent.equality(\n            0,\n            kernel_dependent_hol.c(\"Int\"),\n            dm,\n            kernel_dependent.Free(\"z\"),\n          )),\n        ], kernel_dependent_hol.holds(kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"int.eq\"),\n          [dm, kernel_dependent.Free(\"z\")],\n        ))),\n        kernel_dependent.reflexivity(\n          0,\n          kernel_dependent_hol.bool(),\n          kernel_dependent_hol.c(\"true\"),\n        ),\n        dn,\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"eqv_elim\"),\n          [\n            kernel_dependent_hol.c(\"Int\"),\n            dm,\n            dn,\n            kernel_dependent.Free(h),\n          ],\n        ),\n      ]),\n    )\n    Ok(kernel_dependent_hol.at(\n      kernel_dependent_hol.c(\"hol.eq_false\"),\n      [dl, ok],\n    ))\n  }\n}"},{"name":"kernel_dependent_hol.free_names","kind":"fn","old":null,"new":"8ecad0bd4d6be6f7","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// The free variables' names in `t`, each once.\npub fn free_names(t: kernel_dependent_hol.D) -> List[String] {\n  mut out := []\n  kernel_dependent_hol.collect_free(t, mut out)\n  out\n}"},{"name":"kernel_dependent_hol.collect_free","kind":"fn","old":null,"new":"cf73363e0b378b25","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn collect_free(t: kernel_dependent_hol.D, mut out: List[String]) {\n  match t {\n    kernel_dependent.Free(n) => if !contains(out, n) {\n      mut out.push(n)\n    },\n    kernel_dependent.Pi { domain, body, .. } => {\n      kernel_dependent_hol.collect_free(domain, mut out)\n      kernel_dependent_hol.collect_free(body, mut out)\n    },\n    kernel_dependent.Lambda { domain, body, .. } => {\n      kernel_dependent_hol.collect_free(domain, mut out)\n      kernel_dependent_hol.collect_free(body, mut out)\n    },\n    kernel_dependent.Apply { function, argument } => {\n      kernel_dependent_hol.collect_free(function, mut out)\n      kernel_dependent_hol.collect_free(argument, mut out)\n    },\n    _ => (),\n  }\n}"},{"name":"kernel_dependent_hol.substitute","kind":"fn","old":null,"new":"cfa29958d93fe216","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// Each free variable named in `s` replaced by its term, at once.\npub fn substitute(\n  t: kernel_dependent_hol.D,\n  s: List[(String, kernel_dependent_hol.D)],\n) -> kernel_dependent_hol.D {\n  match t {\n    kernel_dependent.Free(n) => {\n      for (m, u) in s {\n        if m == n {\n          return u\n        }\n      }\n      t\n    },\n    kernel_dependent.Pi { name, domain, body } => kernel_dependent.Pi {\n      name,\n      domain: kernel_dependent_hol.substitute(domain, s),\n      body: kernel_dependent_hol.substitute(body, s),\n    },\n    kernel_dependent.Lambda { name, domain, body } => kernel_dependent.Lambda {\n      name,\n      domain: kernel_dependent_hol.substitute(domain, s),\n      body: kernel_dependent_hol.substitute(body, s),\n    },\n    kernel_dependent.Apply { function, argument } => kernel_dependent.Apply {\n      function: kernel_dependent_hol.substitute(function, s),\n      argument: kernel_dependent_hol.substitute(argument, s),\n    },\n    _ => t,\n  }\n}"},{"name":"kernel_dependent_hol.named","kind":"fn","old":null,"new":"13a42f3465b2e712","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// A named theorem: its term defined once as a constant over its free\n/// variables (type variables, then the others, then its hypotheses), then\n/// that constant applied to them.\nfn named(\n  mut r: kernel_dependent_hol.Replay,\n  name: String,\n  th: kernel.Theorem,\n) -> Result[kernel_dependent_hol.D, String] {\n  match get(r.named, name) {\n    Some((cn, args)) => return Ok(kernel_dependent_hol.at(\n      kernel_dependent_hol.c(cn),\n      args.map(a -> kernel_dependent.Free(a)),\n    )),\n    None => (),\n  }\n  body := kernel_dependent_hol.proof(mut r, th)!\n  statement := kernel_dependent_hol.holds(\n    kernel_dependent_hol.conclusion_of(mut r, th)!,\n  )\n  mut hyps := []\n  for h in kernel.assumptions(th) {\n    mut hyps.push(\n      (\n        kernel_dependent_hol.hypothesis(h),\n        kernel_dependent_hol.holds(\n          kernel_dependent_hol.term(mut r, h)!,\n        ),\n      ),\n    )\n  }\n  (cn, args) := kernel_dependent_hol.close_term(\n    mut r,\n    \"h.law.\" + name,\n    statement,\n    body,\n    hyps,\n  )!\n  mut r.named.insert(name, (cn, args))\n  Ok(kernel_dependent_hol.at(\n    kernel_dependent_hol.c(cn),\n    args.map(a -> kernel_dependent.Free(a)),\n  ))\n}"},{"name":"kernel_dependent_hol.close_term","kind":"fn","old":null,"new":"e006032ec202c9b0","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// `statement` and its proof `body` closed over their free variables and\n/// `hyps`, defined as `cn`: the names it is applied to.\nfn close_term(\n  mut r: kernel_dependent_hol.Replay,\n  cn: String,\n  statement: kernel_dependent_hol.D,\n  body: kernel_dependent_hol.D,\n  hyps: List[(String, kernel_dependent_hol.D)],\n) -> Result[(String, List[String]), String] {\n  mut frees := kernel_dependent_hol.free_names(statement)\n  for n in kernel_dependent_hol.free_names(body) {\n    if !contains(frees, n) && !starts_with(n, \"h:\") {\n      mut frees.push(n)\n    }\n  }\n  types := frees\n    .filter(n -> starts_with(n, \"'\"))\n    .map(n -> (n, kernel_dependent.Sort(0)))\n  mut vars := []\n  for n in frees.filter(n -> starts_with(n, \"v:\")) {\n    match get(r.vars, n) {\n      Some(v) => mut vars.push(\n        (n, kernel_dependent_hol.type_term(\n          mut r,\n          kernel_dependent_hol.hol_type(v),\n        )!),\n      ),\n      None => return Err(\"`\" + n + \"`: an unknown variable\"),\n    }\n  }\n  ps := types + vars + hyps\n  r.env = kernel_dependent.define(\n    r.env,\n    cn,\n    kernel_dependent_hol.pis(ps, statement),\n    kernel_dependent_hol.lams(ps, body),\n  )!\n  Ok((cn, ps.map(p -> p.0)))\n}"},{"name":"kernel_dependent_hol.axiom","kind":"fn","old":null,"new":"0aaa9e1422eac074","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"// ---- axioms and datatype facts ----\n\nfn axiom(\n  mut r: kernel_dependent_hol.Replay,\n  name: String,\n  th: kernel.Theorem,\n) -> Result[kernel_dependent_hol.D, String] {\n  ct := kernel.conclusion(th)\n  stmt := kernel_dependent_hol.term(mut r, ct)!\n  integer := [\n    (\"add_commutes\", \"int.add_comm\"),\n    (\"add_associates\", \"int.add_assoc\"),\n    (\"add_zero\", \"int.add_zero\"),\n    (\"add_negation\", \"int.add_neg\"),\n    (\"subtraction_adds_negation\", \"int.sub_def\"),\n    (\"multiply_commutes\", \"int.mul_comm\"),\n    (\"multiply_associates\", \"int.mul_assoc\"),\n    (\"multiply_one\", \"int.mul_one\"),\n    (\"multiply_distributes\", \"int.distrib\"),\n    (\"at_most_is_less_or_equal\", \"int.le_def\"),\n    (\"less_irreflexive\", \"int.lt_irrefl\"),\n    (\"less_transitive\", \"int.lt_trans\"),\n    (\"less_total\", \"int.lt_total\"),\n    (\"less_under_addition\", \"int.lt_add\"),\n    (\"positive_product\", \"int.mul_pos\"),\n    (\"less_is_successor_at_most\", \"int.discrete\"),\n  ]\n  for (h, d) in integer {\n    if name == h {\n      ax := kernel_dependent.constant_type(r.env, d, [])!\n      (ps, body) := kernel_dependent.peel(ax, 3, \"#i\")\n      mut s := []\n      if !kernel_dependent_hol.match_term(\n        body,\n        kernel_dependent_hol.holds(stmt),\n        ps.map(p -> p.0),\n        mut s,\n      ) {\n        return Err(\"`\" + d + \"`: the instance doesn't match\")\n      }\n      return Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(d),\n        ps.map(p -> kernel_dependent_hol.lookup_term(s, p.0)),\n      ))\n    }\n  }\n  if name == \"eta\" || name == \"if_true\" || name == \"if_false\" {\n    (l, _) := kernel_dependent_hol.eq_parts(ct)\n    return Ok(kernel_dependent_hol.at(\n      kernel_dependent_hol.c(\"hol.refl\"),\n      [kernel_dependent_hol.type_term(\n        mut r,\n        kernel_dependent_hol.hol_type(l),\n      )!, kernel_dependent_hol.term(mut r, l)!],\n    ))\n  }\n  if name == \"truth\" {\n    return Ok(kernel_dependent.reflexivity(\n      0,\n      kernel_dependent_hol.bool(),\n      kernel_dependent_hol.c(\"true\"),\n    ))\n  }\n  if name == \"exists_from_witness\" {\n    (px, ex) := kernel.split_connective(\"==>\", ct) ?? (ct, ct)\n    (pred, x) := kernel_dependent_hol.split_application(px)\n    a_type := kernel_dependent_hol.type_term(\n      mut r,\n      kernel_dependent_hol.hol_type(x),\n    )!\n    dpx := kernel_dependent_hol.term(mut r, px)!\n    return Ok(\n      kernel_dependent_hol.at(kernel_dependent_hol.c(\"hol.disch\"), [\n        dpx,\n        kernel_dependent_hol.term(mut r, ex)!,\n        kernel_dependent.lambda(\n          \"#h\",\n          kernel_dependent_hol.holds(dpx),\n          kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"some_intro\"),\n            [\n              a_type,\n              kernel_dependent_hol.term(mut r, pred)!,\n              kernel_dependent_hol.term(mut r, x)!,\n              kernel_dependent.Free(\"#h\"),\n            ],\n          ),\n        ),\n      ]),\n    )\n  }\n  if name == \"exists_elimination\" {\n    (ex, rest) := kernel.split_connective(\"==>\", ct) ?? (ct, ct)\n    (every, q) := kernel.split_connective(\"==>\", rest) ?? (ct, ct)\n    (_, pred) := kernel_dependent_hol.split_application(ex)\n    a_type := kernel_dependent_hol.type_term(\n      mut r,\n      kernel_dependent_hol.first_argument(\n        kernel_dependent_hol.hol_type(pred),\n      ),\n    )!\n    dp := kernel_dependent_hol.term(mut r, pred)!\n    dq := kernel_dependent_hol.term(mut r, q)!\n    dex := kernel_dependent_hol.term(mut r, ex)!\n    devery := kernel_dependent_hol.term(mut r, every)!\n    (_, every_lam) := kernel_dependent_hol.split_application(every)\n    px := kernel_dependent.Apply {\n      function: dp,\n      argument: kernel_dependent.Free(\"#x\"),\n    }\n    inner := kernel_dependent_hol.at(kernel_dependent_hol.c(\"some_elim\"), [\n      a_type,\n      dp,\n      dq,\n      kernel_dependent.Free(\"#h1\"),\n      kernel_dependent_hol.lams(\n        [(\"#x\", a_type), (\"#hx\", kernel_dependent_hol.holds(px))],\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.mp\"),\n          [px, dq, kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"all_elim\"),\n            [\n              a_type,\n              kernel_dependent_hol.term(mut r, every_lam)!,\n              kernel_dependent.Free(\"#h2\"),\n              kernel_dependent.Free(\"#x\"),\n            ],\n          ), kernel_dependent.Free(\"#hx\")],\n        ),\n      ),\n    ])\n    return Ok(kernel_dependent_hol.at(\n      kernel_dependent_hol.c(\"hol.disch\"),\n      [dex, kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"implies\"),\n        [devery, dq],\n      ), kernel_dependent.lambda(\n        \"#h1\",\n        kernel_dependent_hol.holds(dex),\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.disch\"),\n          [devery, dq, kernel_dependent.lambda(\n            \"#h2\",\n            kernel_dependent_hol.holds(devery),\n            inner,\n          )],\n        ),\n      )],\n    ))\n  }\n  kernel_dependent_hol.tautology(mut r, stmt)\n}"},{"name":"kernel_dependent_hol.lookup_term","kind":"fn","old":null,"new":"530cf69ae9e85800","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn lookup_term(\n  s: List[(String, kernel_dependent_hol.D)],\n  n: String,\n) -> kernel_dependent_hol.D {\n  for (m, t) in s {\n    if m == n {\n      return t\n    }\n  }\n  kernel_dependent.literal(0)\n}"},{"name":"kernel_dependent_hol.match_term","kind":"fn","old":null,"new":"decae969010fca13","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// First-order matching of `pattern` (its free variables `vars`) against `t`.\nfn match_term(\n  pattern: kernel_dependent_hol.D,\n  t: kernel_dependent_hol.D,\n  vars: List[String],\n  mut s: List[(String, kernel_dependent_hol.D)],\n) -> Bool {\n  match pattern {\n    kernel_dependent.Free(n) => if contains(vars, n) {\n      for (m, u) in s {\n        if m == n {\n          return u == t\n        }\n      }\n      mut s.push((n, t))\n      true\n    } else {\n      pattern == t\n    },\n    kernel_dependent.Apply { function: f1, argument: a1 } => match t {\n      kernel_dependent.Apply { function: f2, argument: a2 } => kernel_dependent_hol.match_term(f1, f2, vars, mut s)\n        && kernel_dependent_hol.match_term(a1, a2, vars, mut s),\n      _ => false,\n    },\n    _ => pattern == t,\n  }\n}"},{"name":"kernel_dependent_hol.tautology","kind":"fn","old":null,"new":"0124ecce499f53e9","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// A tautology of `and`, `or`, `not`, `implies` and `eqv Bool` over atoms:\n/// its atoms generalized, every case computed.\nfn tautology(\n  mut r: kernel_dependent_hol.Replay,\n  stmt: kernel_dependent_hol.D,\n) -> Result[kernel_dependent_hol.D, String] {\n  match kernel_dependent.spine(stmt) {\n    (kernel_dependent.Constant { name: \"eqv\", .. }, [_, l, rt]) => {\n      il := kernel_dependent_hol.tautology(mut r, kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"implies\"),\n        [rt, l],\n      ))!\n      ir := kernel_dependent_hol.tautology(mut r, kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"implies\"),\n        [l, rt],\n      ))!\n      return Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.antisym\"),\n        [l, rt, kernel_dependent.lambda(\n          \"#t\",\n          kernel_dependent_hol.holds(rt),\n          kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"hol.mp\"),\n            [rt, l, il, kernel_dependent.Free(\"#t\")],\n          ),\n        ), kernel_dependent.lambda(\n          \"#t\",\n          kernel_dependent_hol.holds(l),\n          kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"hol.mp\"),\n            [l, rt, ir, kernel_dependent.Free(\"#t\")],\n          ),\n        )],\n      ))\n    },\n    _ => (),\n  }\n  mut atoms := []\n  kernel_dependent_hol.collect_atoms(stmt, mut atoms)\n  names := enumerate(atoms).map(p -> \"#b\" + to_string(p.0))\n  mut general := stmt\n  for (i, a) in enumerate(atoms) {\n    general = kernel_dependent_tactics.replaced(\n      general,\n      a,\n      get(names, i) ?? \"\",\n    )\n  }\n  statement := kernel_dependent_hol.pis(\n    names.map(n -> (n, kernel_dependent_hol.bool())),\n    kernel_dependent_hol.holds(general),\n  )\n  g := kernel_dependent_tactics.Goal {\n    env: r.env,\n    context: [],\n    target: statement,\n  }\n  p := kernel_dependent_hol.split_all(g, names)!\n  Ok(kernel_dependent_hol.at(p, atoms))\n}"},{"name":"kernel_dependent_hol.split_all","kind":"fn","old":null,"new":"f5bf37f715e4d40a","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn split_all(\n  g: kernel_dependent_tactics.Goal,\n  names: List[String],\n) -> Result[kernel_dependent_hol.D, String] {\n  match names {\n    [] => kernel_dependent_tactics.simplify(g),\n    [n, ..rest] => kernel_dependent_tactics.intros(\n      g,\n      [n],\n      g1 -> kernel_dependent_tactics.cases(\n        g1,\n        kernel_dependent.Free(n),\n        \"\",\n        [kernel_dependent_tactics.Case {\n          names: [],\n          proof: g2 -> kernel_dependent_hol.split_all(g2, rest),\n        }, kernel_dependent_tactics.Case {\n          names: [],\n          proof: g2 -> kernel_dependent_hol.split_all(g2, rest),\n        }],\n      ),\n    ),\n  }\n}"},{"name":"kernel_dependent_hol.collect_atoms","kind":"fn","old":null,"new":"56fa01295797d43c","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn collect_atoms(\n  t: kernel_dependent_hol.D,\n  mut out: List[kernel_dependent_hol.D],\n) {\n  (h, args) := kernel_dependent.spine(t)\n  match h {\n    kernel_dependent.Constant { name, .. } => if contains([\"and\", \"or\", \"implies\", \"not\"], name) {\n      for a in args {\n        kernel_dependent_hol.collect_atoms(a, mut out)\n      }\n      return\n    } else if name == \"true\" || name == \"false\" {\n      return\n    },\n    _ => (),\n  }\n  if !contains(out, t) {\n    mut out.push(t)\n  }\n}"},{"name":"kernel_dependent_hol.datatype_fact","kind":"fn","old":null,"new":"199bbc64d130e3e2","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// A datatype fact, proven once per group, kind and position, then used by\n/// name.\nfn datatype_fact(\n  mut r: kernel_dependent_hol.Replay,\n  st: kernel.Step,\n  th: kernel.Theorem,\n) -> Result[kernel_dependent_hol.D, String] {\n  first := (get(st.specs, 0) ?? kernel.DatatypeSpec { name: \"\", params: [], ctors: [] }).name\n  kernel_dependent_hol.define_group(mut r, first)!\n  name := \"fact.\"\n    + first\n    + \".\"\n    + st.rule\n    + join(st.indices.map(i -> \".\" + to_string(i)), \"\")\n  match get(r.named, name) {\n    Some((cn, args)) => return Ok(kernel_dependent_hol.at(\n      kernel_dependent_hol.c(cn),\n      args.map(a -> kernel_dependent.Free(a)),\n    )),\n    None => (),\n  }\n  ct := kernel.conclusion(th)\n  statement := kernel_dependent_hol.holds(kernel_dependent_hol.term(mut r, ct)!)\n  g := kernel_dependent_tactics.Goal {\n    env: r.env,\n    context: [],\n    target: statement,\n  }\n  body := match st.rule {\n    \"recursion\" | \"cases\" => kernel_dependent_hol.by_conversion(g)!,\n    \"injective\" => kernel_dependent_hol.injective(mut r, g, ct)!,\n    \"distinct\" => kernel_dependent_hol.distinct(mut r, g, ct, st)!,\n    _ => kernel_dependent_hol.induction(mut r, g, ct, st)!,\n  }\n  (cn, args) := kernel_dependent_hol.close_term(\n    mut r,\n    \"h.\" + name,\n    statement,\n    body,\n    [],\n  )!\n  mut r.named.insert(name, (cn, args))\n  Ok(kernel_dependent_hol.at(\n    kernel_dependent_hol.c(cn),\n    args.map(a -> kernel_dependent.Free(a)),\n  ))\n}"},{"name":"kernel_dependent_hol.by_conversion","kind":"fn","old":null,"new":"12741fa94af28ad8","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// Under its `all`s, an equation whose sides compute to the same.\nfn by_conversion(\n  g: kernel_dependent_tactics.Goal,\n) -> Result[kernel_dependent_hol.D, String] {\n  kernel_dependent_hol.under_all(\n    g,\n    (gl: kernel_dependent_tactics.Goal) ->\n      match kernel_dependent.spine(gl.target) {\n        (kernel_dependent.Constant { name: \"Eq\", .. }, [_, eq_term, _]) => match kernel_dependent.spine(eq_term) {\n          (kernel_dependent.Constant { name: \"eqv\", .. }, [a_type, a, _]) => kernel_dependent_tactics.exact(\n            gl,\n            kernel_dependent_hol.at(\n              kernel_dependent_hol.c(\"hol.refl\"),\n              [a_type, a],\n            ),\n          ),\n          _ => Err(\"by_conversion: not an equation\"),\n        },\n        _ => Err(\"by_conversion: not `holds`\"),\n      },\n  )\n}"},{"name":"kernel_dependent_hol.under_all","kind":"fn","old":null,"new":"d26643d80221ef74","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// `holds (all A P)` proven by `all_intro` on a new variable, repeatedly,\n/// then `inner`.\nfn under_all(\n  g: kernel_dependent_tactics.Goal,\n  inner: (kernel_dependent_tactics.Goal) -> Result[kernel_dependent_hol.D, String],\n) -> Result[kernel_dependent_hol.D, String] {\n  match kernel_dependent.spine(g.target) {\n    (kernel_dependent.Constant { name: \"Eq\", .. }, [_, p, _]) => match kernel_dependent.spine(kernel_dependent_hol.beta(p)) {\n      (kernel_dependent.Constant { name: \"all\", .. }, [a_type, pred]) => {\n        x := \"#v\" + to_string(len(g.context))\n        sub := kernel_dependent_tactics.Goal {\n          ..g,\n          context: [(x, a_type)] + g.context,\n          target: kernel_dependent_hol.holds(\n            kernel_dependent_hol.beta(kernel_dependent.Apply {\n              function: pred,\n              argument: kernel_dependent.Free(x),\n            }),\n          ),\n        }\n        body := kernel_dependent_hol.under_all(sub, inner)!\n        Ok(kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"all_intro\"),\n          [a_type, pred, kernel_dependent.lambda(x, a_type, body)],\n        ))\n      },\n      _ => inner(g),\n    },\n    _ => inner(g),\n  }\n}"},{"name":"kernel_dependent_hol.split_eqv","kind":"fn","old":null,"new":"fdd93d195b80430b","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn split_eqv(\n  t: kernel_dependent_hol.D,\n) -> Option[(kernel_dependent_hol.D, kernel_dependent_hol.D, kernel_dependent_hol.D)] {\n  match kernel_dependent.spine(t) {\n    (kernel_dependent.Constant { name: \"eqv\", .. }, [a_type, a, b]) => Some((a_type, a, b)),\n    _ => None,\n  }\n}"},{"name":"kernel_dependent_hol.holds_of","kind":"fn","old":null,"new":"e5dc7de66dc59238","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn holds_of(t: kernel_dependent_hol.D) -> kernel_dependent_hol.D {\n  match kernel_dependent.spine(t) {\n    (kernel_dependent.Constant { name: \"Eq\", .. }, [_, p, _]) => p,\n    _ => t,\n  }\n}"},{"name":"kernel_dependent_hol.injective","kind":"fn","old":null,"new":"7f6399c0b820c4b2","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// `(C xs = C ys) = (x1 = y1 ∧ …)`: by projections one way, congruence\n/// the other.\nfn injective(\n  mut r: kernel_dependent_hol.Replay,\n  g: kernel_dependent_tactics.Goal,\n  ct: kernel.Term,\n) -> Result[kernel_dependent_hol.D, String] {\n  _ := ct\n  _ := r\n  kernel_dependent_hol.under_all(\n    g,\n    (gl: kernel_dependent_tactics.Goal) -> {\n      target := kernel_dependent_hol.beta(\n        kernel_dependent_hol.holds_of(gl.target),\n      )\n      (_, both, conj) := kernel_dependent_hol.split_eqv(target) or {\n        (\n          kernel_dependent_hol.bool(),\n          kernel_dependent_hol.bool(),\n          kernel_dependent_hol.bool(),\n        )\n      }\n      (t_type, l, rt) := kernel_dependent_hol.split_eqv(both) or {\n        (\n          kernel_dependent_hol.bool(),\n          kernel_dependent_hol.bool(),\n          kernel_dependent_hol.bool(),\n        )\n      }\n      (ctor, xs0) := kernel_dependent.spine(l)\n      (_, ys0) := kernel_dependent.spine(rt)\n      (ind, nparams) := kernel_dependent_hol.inductive_of(gl.env, ctor)?\n      xs := drop(xs0, nparams)\n      ys := drop(ys0, nparams)\n      params := take(xs0, nparams)\n      // ⇒: each field by its projection\n      hn := \"#inj\"\n      h := kernel_dependent.Free(hn)\n      mut conjuncts := []\n      for (i, x) in enumerate(xs) {\n        y := get(ys, i) ?? x\n        a_type := kernel_dependent.infer(gl.env, gl.context, x)!\n        proj := kernel_dependent_hol.projection(\n          gl.env,\n          ind,\n          ctor,\n          params,\n          i,\n          x,\n          a_type,\n        )!\n        mut conjuncts.push(\n          (\n            kernel_dependent_hol.eqv(a_type, x, y),\n            kernel_dependent_hol.at(\n              kernel_dependent_hol.c(\"hol.cong\"),\n              [\n                t_type,\n                a_type,\n                proj,\n                proj,\n                l,\n                rt,\n                kernel_dependent_hol.at(\n                  kernel_dependent_hol.c(\"hol.refl\"),\n                  [kernel_dependent_hol.arrow(t_type, a_type), proj],\n                ),\n                h,\n              ],\n            ),\n          ),\n        )\n      }\n      forward := kernel_dependent.lambda(\n        hn,\n        kernel_dependent_hol.holds(both),\n        kernel_dependent_hol.conjunction(conjuncts),\n      )\n      // ⇐: congruence field by field\n      hc := \"#conj\"\n      mut acc := kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.refl\"),\n        [t_type, kernel_dependent_hol.at(ctor, params)],\n      )\n      mut lhs := kernel_dependent_hol.at(ctor, params)\n      mut rhs := kernel_dependent_hol.at(ctor, params)\n      parts := kernel_dependent_hol.conjunction_parts(\n        kernel_dependent.Free(hc),\n        conjuncts.map(p -> p.0),\n      )\n      for (i, x) in enumerate(xs) {\n        y := get(ys, i) ?? x\n        a_type := kernel_dependent.infer(gl.env, gl.context, x)!\n        ftype := kernel_dependent.whnf(\n          gl.env,\n          kernel_dependent.infer(gl.env, gl.context, lhs)!,\n        )\n        b_type := match ftype {\n          kernel_dependent.Pi { body, .. } => body,\n          _ => t_type,\n        }\n        acc = kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.cong\"),\n          [\n            a_type,\n            b_type,\n            lhs,\n            rhs,\n            x,\n            y,\n            acc,\n            get(parts, i) ?? acc,\n          ],\n        )\n        lhs = kernel_dependent.Apply { function: lhs, argument: x }\n        rhs = kernel_dependent.Apply { function: rhs, argument: y }\n      }\n      backward := kernel_dependent.lambda(\n        hc,\n        kernel_dependent_hol.holds(conj),\n        acc,\n      )\n      kernel_dependent_tactics.exact(gl, kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.antisym\"),\n        [both, conj, backward, forward],\n      ))\n    },\n  )\n}"},{"name":"kernel_dependent_hol.inductive_of","kind":"fn","old":null,"new":"4eaeeb7390bc0d62","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn inductive_of(\n  env: kernel_dependent.Environment,\n  ctor: kernel_dependent_hol.D,\n) -> Option[(kernel_dependent.Inductive, Int)] {\n  match ctor {\n    kernel_dependent.Constant { name, .. } => {\n      ty := kernel_dependent.constant_type(env, name, []) !! kernel_dependent.Sort(0)\n      (_, out) := kernel_dependent.peel(ty, -1, \"#q\")\n      match kernel_dependent.spine(out).0 {\n        kernel_dependent.Constant { name: tn, .. } => {\n          ind := kernel_dependent.inductive_named(env, tn)?\n          Some((ind, ind.params))\n        },\n        _ => None,\n      }\n    },\n    _ => None,\n  }\n}"},{"name":"kernel_dependent_hol.projection","kind":"fn","old":null,"new":"ea5335ab39f495c7","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// `λ z. field i of z` for the constructor `ctor` (any other constructor\n/// gives `default`, of type `a_type`).\nfn projection(\n  env: kernel_dependent.Environment,\n  ind: kernel_dependent.Inductive,\n  ctor: kernel_dependent_hol.D,\n  params: List[kernel_dependent_hol.D],\n  i: Int,\n  default: kernel_dependent_hol.D,\n  a_type: kernel_dependent_hol.D,\n) -> Result[kernel_dependent_hol.D, String] {\n  kernel_dependent_hol.eliminate_to(\n    env,\n    ind,\n    params,\n    ctor,\n    a_type,\n    (mine: Bool, fields: List[kernel_dependent_hol.D]) -> if mine {\n      get(fields, i) ?? default\n    } else {\n      default\n    },\n  )\n}"},{"name":"kernel_dependent_hol.eliminate_to","kind":"fn","old":null,"new":"b9ad9fc41ce2356b","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// `λ z. I.rec … z` into the constant type `result`: `pick(true, fields)`\n/// in `ctor`'s case, `pick(false, fields)` in the type's other cases (the\n/// group's other types into `holds true`).\nfn eliminate_to(\n  env: kernel_dependent.Environment,\n  ind: kernel_dependent.Inductive,\n  params: List[kernel_dependent_hol.D],\n  ctor: kernel_dependent_hol.D,\n  result: kernel_dependent_hol.D,\n  pick: (Bool, List[kernel_dependent_hol.D]) -> kernel_dependent_hol.D,\n) -> Result[kernel_dependent_hol.D, String] {\n  trivial := kernel_dependent_hol.holds(kernel_dependent_hol.c(\"true\"))\n  own := kernel_dependent_hol.index_of(ind.group, ind.name)\n  motive_of := (k: Int) -> if k == own {\n    result\n  } else {\n    trivial\n  }\n  motives := enumerate(ind.group).map(\n    p -> kernel_dependent.lambda(\n      \"_z\",\n      kernel_dependent_hol.at(kernel_dependent_hol.c(p.1), params),\n      motive_of(p.0),\n    ),\n  )\n  mut minors := []\n  for (k, n) in enumerate(ind.group) {\n    member := kernel_dependent.inductive_named(env, n) ?? ind\n    for ct in member.constructors {\n      cty := kernel_dependent.infer(env, [], kernel_dependent_hol.at(\n        kernel_dependent_hol.c(ct.name),\n        params,\n      ))!\n      (args, _) := kernel_dependent.peel(cty, -1, \"#y\")\n      mut ihs := []\n      for (q, a) in enumerate(args) {\n        rk := get(ct.recursive, q) ?? -1\n        if rk >= 0 {\n          mut ihs.push((\"#ih\" + to_string(q), motive_of(rk)))\n          _ := a\n        }\n      }\n      body := if k == own {\n        pick(\n          kernel_dependent_hol.c(ct.name) == ctor,\n          args.map(a -> kernel_dependent.Free(a.0)),\n        )\n      } else {\n        kernel_dependent.reflexivity(\n          0,\n          kernel_dependent_hol.bool(),\n          kernel_dependent_hol.c(\"true\"),\n        )\n      }\n      mut minors.push(kernel_dependent_hol.lams(args + ihs, body))\n    }\n  }\n  self := kernel_dependent_hol.at(kernel_dependent_hol.c(ind.name), params)\n  Ok(kernel_dependent.lambda(\"#z\", self, kernel_dependent_hol.at(\n    kernel_dependent.Constant {\n      name: ind.name + \".rec\",\n      levels: [0],\n    },\n    params + motives + minors + [kernel_dependent.Free(\"#z\")],\n  )))\n}"},{"name":"kernel_dependent_hol.beta","kind":"fn","old":null,"new":"0033722f81cc38fd","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// `t` with its head β-redexes reduced.\nfn beta(t: kernel_dependent_hol.D) -> kernel_dependent_hol.D {\n  (h, args) := kernel_dependent.spine(t)\n  match (h, args) {\n    (kernel_dependent.Lambda { body, .. }, [first, ..rest]) => kernel_dependent_hol.beta(kernel_dependent_hol.at(\n      kernel_dependent.instantiate(body, first, 0),\n      rest,\n    )),\n    _ => t,\n  }\n}"},{"name":"kernel_dependent_hol.conjunction","kind":"fn","old":null,"new":"0976347c165665df","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn conjunction(\n  parts: List[(kernel_dependent_hol.D, kernel_dependent_hol.D)],\n) -> kernel_dependent_hol.D {\n  match parts {\n    [] => kernel_dependent.reflexivity(\n      0,\n      kernel_dependent_hol.bool(),\n      kernel_dependent_hol.c(\"true\"),\n    ),\n    [(_, p)] => p,\n    [(s, p), ..rest] => kernel_dependent_hol.at(\n      kernel_dependent_hol.c(\"hol.and_intro\"),\n      [\n        s,\n        kernel_dependent_hol.conjunction_statement(\n          rest.map(x -> x.0),\n        ),\n        p,\n        kernel_dependent_hol.conjunction(rest),\n      ],\n    ),\n  }\n}"},{"name":"kernel_dependent_hol.conjunction_statement","kind":"fn","old":null,"new":"f91c04f30852bbcd","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn conjunction_statement(\n  ss: List[kernel_dependent_hol.D],\n) -> kernel_dependent_hol.D {\n  match ss {\n    [] => kernel_dependent_hol.c(\"true\"),\n    [s] => s,\n    [s, ..rest] => kernel_dependent_hol.at(\n      kernel_dependent_hol.c(\"and\"),\n      [s, kernel_dependent_hol.conjunction_statement(rest)],\n    ),\n  }\n}"},{"name":"kernel_dependent_hol.conjunction_parts","kind":"fn","old":null,"new":"de0f21d91227e2fc","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// The proofs of each conjunct from `h` proving their conjunction.\nfn conjunction_parts(\n  h: kernel_dependent_hol.D,\n  ss: List[kernel_dependent_hol.D],\n) -> List[kernel_dependent_hol.D] {\n  match ss {\n    [] => [],\n    [_] => [h],\n    [s, ..rest] => {\n      tail := kernel_dependent_hol.conjunction_statement(rest)\n      [kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.and_left\"),\n          [s, tail, h],\n        )]\n        + kernel_dependent_hol.conjunction_parts(\n          kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"hol.and_right\"),\n            [s, tail, h],\n          ),\n          rest,\n        )\n    },\n  }\n}"},{"name":"kernel_dependent_hol.distinct","kind":"fn","old":null,"new":"5abc665075826077","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// `(C xs = D ys) = F`: `C xs = D ys` would carry `true` (C's code) to\n/// `false` (D's).\nfn distinct(\n  mut r: kernel_dependent_hol.Replay,\n  g: kernel_dependent_tactics.Goal,\n  ct: kernel.Term,\n  st: kernel.Step,\n) -> Result[kernel_dependent_hol.D, String] {\n  _ := ct\n  _ := st\n  _ := r\n  kernel_dependent_hol.under_all(\n    g,\n    (gl: kernel_dependent_tactics.Goal) -> {\n      (_, both, _) := kernel_dependent_hol.split_eqv(kernel_dependent_hol.beta(\n        kernel_dependent_hol.holds_of(gl.target),\n      )) or {\n        (\n          kernel_dependent_hol.bool(),\n          kernel_dependent_hol.bool(),\n          kernel_dependent_hol.bool(),\n        )\n      }\n      (t_type, l, rt) := kernel_dependent_hol.split_eqv(both) or {\n        (\n          kernel_dependent_hol.bool(),\n          kernel_dependent_hol.bool(),\n          kernel_dependent_hol.bool(),\n        )\n      }\n      (ctor, xs0) := kernel_dependent.spine(l)\n      (ind, nparams) := kernel_dependent_hol.inductive_of(gl.env, ctor) or {\n        return Err(\"distinct: not a constructor\")\n      }\n      params := take(xs0, nparams)\n      code := kernel_dependent_hol.eliminate_to(\n        gl.env,\n        ind,\n        params,\n        ctor,\n        kernel_dependent_hol.bool(),\n        (mine: Bool, _f: List[kernel_dependent_hol.D]) ->\n          kernel_dependent_hol.c(if mine {\n            \"true\"\n          } else {\n            \"false\"\n          }),\n      )!\n      hn := \"#dis\"\n      carried := kernel_dependent_hol.at(\n        kernel_dependent_hol.j(0, 0),\n        [t_type, l, kernel_dependent_hol.lams(\n          [(\"#w\", t_type), (\"_e\", kernel_dependent.equality(\n            0,\n            t_type,\n            l,\n            kernel_dependent.Free(\"#w\"),\n          ))],\n          kernel_dependent_hol.holds(kernel_dependent.Apply {\n            function: code,\n            argument: kernel_dependent.Free(\"#w\"),\n          }),\n        ), kernel_dependent.reflexivity(\n          0,\n          kernel_dependent_hol.bool(),\n          kernel_dependent_hol.c(\"true\"),\n        ), rt, kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"eqv_elim\"),\n          [t_type, l, rt, kernel_dependent.Free(hn)],\n        )],\n      )\n      kernel_dependent_tactics.exact(gl, kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.eq_false\"),\n        [both, kernel_dependent.lambda(\n          hn,\n          kernel_dependent_hol.holds(both),\n          carried,\n        )],\n      ))\n    },\n  )\n}"},{"name":"kernel_dependent_hol.induction","kind":"fn","old":null,"new":"0e9f9ec947e129c5","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// The group's induction: under its `P`s and steps, each type's `all` by\n/// its recursor, each case from its step (`all_elim` on the arguments,\n/// `hol.mp` on the hypotheses).\nfn induction(\n  mut r: kernel_dependent_hol.Replay,\n  g: kernel_dependent_tactics.Goal,\n  ct: kernel.Term,\n  st: kernel.Step,\n) -> Result[kernel_dependent_hol.D, String] {\n  _ := ct\n  spec0 := get(st.specs, 0) ?? kernel.DatatypeSpec { name: \"\", params: [], ctors: [] }\n  params := spec0.params.map(p -> kernel_dependent.Free(\"'\" + p))\n  first := kernel_dependent.inductive_named(r.env, \"h.\" + spec0.name) or {\n    return Err(\"induction: the group isn't defined\")\n  }\n  group := first.group\n  kernel_dependent_hol.under_all(\n    g,\n    (gl: kernel_dependent_tactics.Goal) -> {\n      // the P's are the context's newest variables, in group order\n      ps := take(gl.context, len(group))\n        .reversed()\n        .map(p -> kernel_dependent.Free(p.0))\n      mut steps := []\n      mut rest := kernel_dependent_hol.beta(\n        kernel_dependent_hol.holds_of(gl.target),\n      )\n      mut going := true\n      while going {\n        match kernel_dependent.spine(rest) {\n          (kernel_dependent.Constant { name: \"implies\", .. }, [s, q]) => if len(steps) < kernel_dependent_hol.total_constructors(gl.env, group) {\n            mut steps.push(s)\n            rest = q\n          } else {\n            going = false\n          },\n          _ => {\n            going = false\n          },\n        }\n      }\n      motives := enumerate(group).map(\n        p -> kernel_dependent.lambda(\n          \"#x\",\n          kernel_dependent_hol.at(\n            kernel_dependent_hol.c(p.1),\n            params,\n          ),\n          kernel_dependent_hol.holds(kernel_dependent.Apply {\n            function: get(ps, p.0) ?? kernel_dependent_hol.bool(),\n            argument: kernel_dependent.Free(\"#x\"),\n          }),\n        ),\n      )\n      mut minors := []\n      mut idx := 0\n      for (k, n) in enumerate(group) {\n        member := kernel_dependent.inductive_named(gl.env, n) ?? first\n        _ := k\n        for ctr in member.constructors {\n          cty := kernel_dependent.infer(\n            gl.env,\n            gl.context,\n            kernel_dependent_hol.at(\n              kernel_dependent_hol.c(ctr.name),\n              params,\n            ),\n          )!\n          (args, _) := kernel_dependent.peel(cty, -1, \"#y\")\n          mut ihs := []\n          for (q, a) in enumerate(args) {\n            rk := get(ctr.recursive, q) ?? -1\n            if rk >= 0 {\n              mut ihs.push(\n                (\n                  \"#ih\" + to_string(q),\n                  kernel_dependent_hol.holds(\n                    kernel_dependent.Apply {\n                      function: get(ps, rk) ?? kernel_dependent_hol.bool(),\n                      argument: kernel_dependent.Free(a.0),\n                    },\n                  ),\n                ),\n              )\n            }\n          }\n          // the step: `all` per argument, then `implies` per hypothesis\n          mut prf := kernel_dependent.Free(\"#step\" + to_string(idx))\n          mut stmt := get(steps, idx) ?? kernel_dependent_hol.bool()\n          for a in args {\n            match kernel_dependent.spine(kernel_dependent_hol.beta(stmt)) {\n              (kernel_dependent.Constant { name: \"all\", .. }, [a_type, pred]) => {\n                prf = kernel_dependent_hol.at(\n                  kernel_dependent_hol.c(\"all_elim\"),\n                  [a_type, pred, prf, kernel_dependent.Free(a.0)],\n                )\n                stmt = kernel_dependent_hol.beta(kernel_dependent.Apply {\n                  function: pred,\n                  argument: kernel_dependent.Free(a.0),\n                })\n              },\n              _ => return Err(\"induction: a step's arguments\"),\n            }\n          }\n          for (hname, _) in ihs {\n            match kernel_dependent.spine(kernel_dependent_hol.beta(stmt)) {\n              (kernel_dependent.Constant { name: \"implies\", .. }, [p, q]) => {\n                prf = kernel_dependent_hol.at(\n                  kernel_dependent_hol.c(\"hol.mp\"),\n                  [p, q, prf, kernel_dependent.Free(hname)],\n                )\n                stmt = q\n              },\n              _ => return Err(\"induction: a step's hypotheses\"),\n            }\n          }\n          mut minors.push(kernel_dependent_hol.lams(args + ihs, prf))\n          idx += 1\n        }\n      }\n      mut alls := []\n      for (k, n) in enumerate(group) {\n        self := kernel_dependent_hol.at(kernel_dependent_hol.c(n), params)\n        pk := get(ps, k) ?? kernel_dependent_hol.bool()\n        mut alls.push(\n          (kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"all\"),\n            [self, pk],\n          ), kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"all_intro\"),\n            [self, pk, kernel_dependent.lambda(\n              \"#x\",\n              self,\n              kernel_dependent_hol.at(kernel_dependent.Constant {\n                name: n + \".rec\",\n                levels: [0],\n              }, params\n                + motives\n                + minors\n                + [kernel_dependent.Free(\"#x\")]),\n            )],\n          )),\n        )\n      }\n      mut out := kernel_dependent_hol.conjunction(alls)\n      for (i, s) in enumerate(steps).reversed() {\n        after := kernel_dependent_hol.implications(\n          drop(steps, i + 1),\n          kernel_dependent_hol.conjunction_statement(\n            alls.map(a -> a.0),\n          ),\n        )\n        out = kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.disch\"),\n          [s, after, kernel_dependent.lambda(\n            \"#step\" + to_string(i),\n            kernel_dependent_hol.holds(s),\n            out,\n          )],\n        )\n      }\n      kernel_dependent_tactics.exact(gl, out)\n    },\n  )\n}"},{"name":"kernel_dependent_hol.implications","kind":"fn","old":null,"new":"c373a7ac49c44ef8","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn implications(\n  ss: List[kernel_dependent_hol.D],\n  last: kernel_dependent_hol.D,\n) -> kernel_dependent_hol.D {\n  mut out := last\n  for s in ss.reversed() {\n    out = kernel_dependent_hol.at(\n      kernel_dependent_hol.c(\"implies\"),\n      [s, out],\n    )\n  }\n  out\n}"},{"name":"kernel_dependent_hol.total_constructors","kind":"fn","old":null,"new":"b50f1742926f6575","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn total_constructors(\n  env: kernel_dependent.Environment,\n  group: List[String],\n) -> Int {\n  mut n := 0\n  for g in group {\n    n += len((kernel_dependent.inductive_named(env, g) or {\n      kernel_dependent.Inductive {\n        name: g,\n        params: 0,\n        level: 0,\n        ty: kernel_dependent.Sort(0),\n        constructors: [],\n        group: [],\n      }\n    }).constructors)\n  }\n  n\n}"},{"name":"kernel_dependent_hol.start","kind":"fn","old":null,"new":"d40c1fab988bcfec","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"// ---- laws ----\n\n/// A replay of the HOL kernel's theory `thy`: its datatypes' groups and\n/// its constants' equations known, the `hol.*` lemmas proven.\npub fn start(\n  thy: kernel_translate.Theory,\n) -> Result[kernel_dependent_hol.Replay, String] {\n  mut groups := Dict[String, List[kernel.DatatypeSpec]] {}\n  for (n, d) in thy.datatypes {\n    _ := n\n    mut specs := []\n    for m in d.facts.group {\n      match get(thy.datatypes, m) {\n        Some(x) => mut specs.push(\n          kernel.DatatypeSpec {\n            name: x.name,\n            params: x.params,\n            ctors: x.ctors,\n          },\n        ),\n        None => (),\n      }\n    }\n    mut groups.insert(d.name, specs)\n  }\n  Ok(kernel_dependent_hol.Replay {\n    env: kernel_dependent_hol.base(kernel_dependent.empty_environment())!,\n    consts: Dict[String, (List[String], kernel.Type)] {},\n    vars: Dict[String, kernel.Term] {},\n    named: Dict[String, (String, List[String])] {},\n    groups,\n    equations: thy.theorems,\n    defined_groups: [],\n  })\n}"},{"name":"kernel_dependent_hol.check_law","kind":"fn","old":null,"new":"f2d7bfb46bef1e68","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// A law the HOL kernel proved, checked by the dependent kernel: its proof\n/// term's size.\npub fn check_law(\n  mut r: kernel_dependent_hol.Replay,\n  name: String,\n  th: kernel.Theorem,\n) -> Result[Int, String] {\n  body := kernel_dependent_hol.proof(mut r, th)!\n  statement := kernel_dependent_hol.holds(\n    kernel_dependent_hol.conclusion_of(mut r, th)!,\n  )\n  _ := kernel_dependent_hol.close_term(\n    mut r,\n    \"h.law.\" + name,\n    statement,\n    body,\n    [],\n  )!\n  mut r.named.insert(name, (\"h.law.\" + name, []))\n  Ok(kernel_dependent_hol.size(body))\n}"},{"name":"kernel_dependent_hol.size","kind":"fn","old":null,"new":"8a52f18e5c3a352d","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn size(t: kernel_dependent_hol.D) -> Int {\n  match t {\n    kernel_dependent.Pi { domain, body, .. } => 1\n      + kernel_dependent_hol.size(domain)\n      + kernel_dependent_hol.size(body),\n    kernel_dependent.Lambda { domain, body, .. } => 1\n      + kernel_dependent_hol.size(domain)\n      + kernel_dependent_hol.size(body),\n    kernel_dependent.Apply { function, argument } => 1\n      + kernel_dependent_hol.size(function)\n      + kernel_dependent_hol.size(argument),\n    _ => 1,\n  }\n}"}]}
{"id":"dfd84748145eb6fd","time":1795852081,"message":"edit","changes":[{"name":"kernel_cli.command","kind":"fn","old":"d818c762c3b81d89","new":"9f546247b36a4bb6","interface_changed":false,"affected":[],"module":"kernel_cli","text":"/// `strata kernel check FILE…` (each theorem proven or the step that\n/// failed, with the time the check took) and `strata kernel goals FILE…`\n/// (the statements, for writing proofs). `--z3-arith`: `omega` asks Z3\n/// instead (marked as its oracle), to compare. 0 when every theorem with a\n/// proof is proven.\npub fn command(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  mut cmds: std.process.Commands,\n  clock: std.time.SystemClock,\n  solver: String,\n  home: String,\n  args: List[String],\n) -> std.process.ExitCode {\n  sub := get(args, 0) ?? \"\"\n  z3_arith := contains(args, \"--z3-arith\")\n  replay := contains(args, \"--dependent\")\n  paths := drop(args, 1).filter(a -> !starts_with(a, \"--\"))\n  if sub == \"dependent\" {\n    return kernel_cli.dependent(mut console, files, clock, home, paths)\n  }\n  if sub != \"check\" && sub != \"goals\" || len(paths) == 0 {\n    mut console.write(\n      \"usage: strata kernel (check | goals) [--z3-arith] [--dependent] FILE...\\n       strata kernel dependent [FILE.strata...]\\n\",\n    )\n    return 2\n  }\n  base := kernel_cli.base_theory(mut cmds, files, clock, home, solver) except m {\n    mut console.write(\"the base theory: \" + m + \"\\n\")\n    return 2\n  }\n  mut console.write(\n    f\"core/int.kp: {base.int_lemmas} lemmas proven ({kernel_cli.milliseconds(base.int_ns)})\\n\",\n  )\n  mut code := 0\n  for path in paths {\n    src := if ends_with(path, \".strata\") {\n      \"\"\n    } else {\n      files.read(path) except {\n        mut console.write(path + \": can't read it\\n\")\n        code = 2\n        continue\n      }\n    }\n    t0 := clock.now().value\n    // a module file holds laws written as Strata; a `.kp` file, a script\n    outcomes := if ends_with(path, \".strata\") {\n      match files.read_bytes(path) {\n        Ok(bytes) => match binary.read(bytes) {\n          Ok(img) => match kernel_cli.made_in(\n            img.decls,\n            kernel_cli.typing_decls(files, home),\n          ) {\n            Ok(ds) => kernel_cli.check_module(\n              mut cmds,\n              clock,\n              solver,\n              ds,\n              sub == \"goals\",\n              base,\n              z3_arith,\n            ),\n            Err(m) => Err(m),\n          },\n          Err(m) => Err(m),\n        },\n        Err(_) => Err(\"can't read it\"),\n      }\n    } else {\n      kernel_cli.check_source(\n        mut cmds,\n        clock,\n        solver,\n        src,\n        sub == \"goals\",\n        base,\n        z3_arith,\n      )\n    }\n    t1 := clock.now().value\n    match outcomes {\n      Ok((os, notes, thy)) => {\n        mut console.write(\"== \" + path + \"\\n\")\n        for n in notes {\n          mut console.write(\"note: \" + n + \"\\n\")\n        }\n        mut proven := 0\n        mut failed := 0\n        mut open := 0\n        for o in os {\n          line := match o.verdict {\n            \"proven\" => {\n              proven += 1\n              \"proven \"\n                + o.name\n                + \" (\"\n                + kernel_cli.milliseconds(o.ns)\n                + \")\"\n                + o.detail\n            },\n            \"open\" => {\n              open += 1\n              \"open   \" + o.name + \"\\n\" + o.detail\n            },\n            \"goal\" => o.name + \"\\n\" + o.detail,\n            _ => {\n              failed += 1\n              code = 1\n              \"failed \"\n                + o.name\n                + \" (\"\n                + kernel_cli.milliseconds(o.ns)\n                + \"): \"\n                + o.detail\n            },\n          }\n          mut console.write(line + \"\\n\")\n        }\n        if sub == \"check\" {\n          mut console.write(\n            f\"{proven} proven, {failed} failed, {open} open ({kernel_cli.milliseconds(t1 - t0)} in all)\\n\",\n          )\n        }\n        if replay {\n          if !kernel_cli.replayed(mut console, clock, thy, os) {\n            code = 1\n          }\n        }\n      },\n      Err(m) => {\n        mut console.write(path + \": \" + m + \"\\n\")\n        code = 2\n      },\n    }\n  }\n  code\n}","old_text":"/// `strata kernel check FILE…` (each theorem proven or the step that\n/// failed, with the time the check took) and `strata kernel goals FILE…`\n/// (the statements, for writing proofs). `--z3-arith`: `omega` asks Z3\n/// instead (marked as its oracle), to compare. 0 when every theorem with a\n/// proof is proven.\npub fn command(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  mut cmds: std.process.Commands,\n  clock: std.time.SystemClock,\n  solver: String,\n  home: String,\n  args: List[String],\n) -> std.process.ExitCode {\n  sub := get(args, 0) ?? \"\"\n  z3_arith := contains(args, \"--z3-arith\")\n  paths := drop(args, 1).filter(a -> !starts_with(a, \"--\"))\n  if sub == \"dependent\" {\n    return kernel_cli.dependent(mut console, files, clock, home, paths)\n  }\n  if sub != \"check\" && sub != \"goals\" || len(paths) == 0 {\n    mut console.write(\n      \"usage: strata kernel (check | goals) [--z3-arith] FILE...\\n       strata kernel dependent [FILE.strata...]\\n\",\n    )\n    return 2\n  }\n  base := kernel_cli.base_theory(mut cmds, files, clock, home, solver) except m {\n    mut console.write(\"the base theory: \" + m + \"\\n\")\n    return 2\n  }\n  mut console.write(\n    f\"core/int.kp: {base.int_lemmas} lemmas proven ({kernel_cli.milliseconds(base.int_ns)})\\n\",\n  )\n  mut code := 0\n  for path in paths {\n    src := if ends_with(path, \".strata\") {\n      \"\"\n    } else {\n      files.read(path) except {\n        mut console.write(path + \": can't read it\\n\")\n        code = 2\n        continue\n      }\n    }\n    t0 := clock.now().value\n    // a module file holds laws written as Strata; a `.kp` file, a script\n    outcomes := if ends_with(path, \".strata\") {\n      match files.read_bytes(path) {\n        Ok(bytes) => match binary.read(bytes) {\n          Ok(img) => match kernel_cli.made_in(\n            img.decls,\n            kernel_cli.typing_decls(files, home),\n          ) {\n            Ok(ds) => kernel_cli.check_module(\n              mut cmds,\n              clock,\n              solver,\n              ds,\n              sub == \"goals\",\n              base,\n              z3_arith,\n            ),\n            Err(m) => Err(m),\n          },\n          Err(m) => Err(m),\n        },\n        Err(_) => Err(\"can't read it\"),\n      }\n    } else {\n      kernel_cli.check_source(\n        mut cmds,\n        clock,\n        solver,\n        src,\n        sub == \"goals\",\n        base,\n        z3_arith,\n      )\n    }\n    t1 := clock.now().value\n    match outcomes {\n      Ok((os, notes, _)) => {\n        mut console.write(\"== \" + path + \"\\n\")\n        for n in notes {\n          mut console.write(\"note: \" + n + \"\\n\")\n        }\n        mut proven := 0\n        mut failed := 0\n        mut open := 0\n        for o in os {\n          line := match o.verdict {\n            \"proven\" => {\n              proven += 1\n              \"proven \"\n                + o.name\n                + \" (\"\n                + kernel_cli.milliseconds(o.ns)\n                + \")\"\n                + o.detail\n            },\n            \"open\" => {\n              open += 1\n              \"open   \" + o.name + \"\\n\" + o.detail\n            },\n            \"goal\" => o.name + \"\\n\" + o.detail,\n            _ => {\n              failed += 1\n              code = 1\n              \"failed \"\n                + o.name\n                + \" (\"\n                + kernel_cli.milliseconds(o.ns)\n                + \"): \"\n                + o.detail\n            },\n          }\n          mut console.write(line + \"\\n\")\n        }\n        if sub == \"check\" {\n          mut console.write(\n            f\"{proven} proven, {failed} failed, {open} open ({kernel_cli.milliseconds(t1 - t0)} in all)\\n\",\n          )\n        }\n      },\n      Err(m) => {\n        mut console.write(path + \": \" + m + \"\\n\")\n        code = 2\n      },\n    }\n  }\n  code\n}"},{"name":"kernel_cli.check_script","kind":"fn","old":"2069186908ffd1e6","new":"949b59e1519a6544","interface_changed":false,"affected":[],"module":"kernel_cli","text":"fn check_script(\n  mut cmds: std.process.Commands,\n  clock: std.time.SystemClock,\n  solver: String,\n  script: kernel_tactics.ScriptFile,\n  code: List[ast.Decl],\n  goals_only: Bool,\n  base: kernel_cli.Base,\n  z3_arith: Bool,\n) -> Result[(List[kernel_cli.Outcome], List[String], kernel_translate.Theory), String] {\n  mut thy := base.thy\n  if len(code) > 0 {\n    kernel_translate.add_decls(mut thy, code)!\n  }\n  mut logic := []\n  for (n, th) in kernel_logic.logic_rewrites()! {\n    for r in kernel_logic.rewrites_of(th, \"?\" + n)! {\n      mut logic.push(r)\n    }\n  }\n  for n in [\"int.not_lt\", \"int.not_le\"] {\n    for th in get(thy.theorems, n) ?? [] {\n      for r in kernel_logic.rewrites_of(th, \"?\" + n)! {\n        mut logic.push(r)\n      }\n    }\n  }\n  mut out := []\n  mut i := 0\n  ths := script.theorems\n  while i < len(ths) {\n    s := get(ths, i) or {\n      kernel_tactics.Script {\n        name: \"\",\n        header: \"\",\n        statement: \"\",\n        simp_rule: false,\n        tacs: [],\n        line: 0,\n      }\n    }\n    // a `mutual` block: its theorems together\n    mut block := [s]\n    if s.group > 0 {\n      while i + len(block) < len(ths)\n        && (get(ths, i + len(block)) ?? s).group == s.group {\n        mut block.push(get(ths, i + len(block)) ?? s)\n      }\n    }\n    i += len(block)\n    t0 := clock.now().value\n    mut prepared := []\n    mut bad := false\n    for b in block {\n      match kernel_cli.prepare(thy, b) {\n        Ok(p) => mut prepared.push(\n          kernel_cli.Prepared {\n            ..p,\n            labels: kernel_cli.labels_of(thy),\n          },\n        ),\n        Err(m) => {\n          mut out.push(\n            kernel_cli.Outcome {\n              name: b.name,\n              verdict: \"failed\",\n              detail: \"its statement: \" + m,\n              ns: 0,\n            },\n          )\n          mut thy.failed.push(b.name)\n          bad = true\n        },\n      }\n    }\n    if bad {\n      continue\n    }\n    if goals_only || prepared.all(p -> len(p.script.tacs) == 0) {\n      for p in prepared {\n        goal := kernel_cli.opened_goal(p)\n        mut out.push(\n          kernel_cli.Outcome { name: if p.script.law_form {\n              \"law \"\n            } else {\n              \"theorem \"\n            }\n            + p.script.name\n            + if p.script.header == \"\" {\n              \"\"\n            } else {\n              \" \" + p.script.header\n            }\n            + if p.script.statement == \"\" {\n              \"\"\n            } else {\n              \": \" + p.script.statement\n            }, verdict: if goals_only {\n            \"goal\"\n          } else {\n            \"open\"\n          }, detail: kernel_tactics.goal_text(goal), ns: 0 },\n        )\n        mut thy.unproven.push(p.script.name)\n      }\n      continue\n    }\n    simp_set := logic + kernel_cli.simp_rewrites(thy)!\n    // linear arithmetic once core/int.kp is proven\n    lemmas := kernel_cli.arithmetic_lemmas(thy)\n    mut ctx := kernel_tactics.Context {\n      thy,\n      simp: simp_set,\n      solver,\n      omega_calls: 0,\n      arith: if get(lemmas.by_name, \"int.eq_neg\") is Some {\n        Some(lemmas)\n      } else {\n        None\n      },\n      laws: prepared.map(p -> p.lref),\n      logic,\n      z3_arith,\n    }\n    results := if len(prepared) == 1 {\n      p := get(prepared, 0) or { return Err(\"internal: a lost theorem\") }\n      tacs := kernel_cli.opening(p, thy) + p.script.tacs\n      match kernel_tactics.run(\n        mut cmds,\n        mut ctx,\n        tacs,\n        [kernel_tactics.Goal {\n          assumptions: [],\n          vars: [],\n          conclusion: p.statement,\n          type_params: p.type_params,\n          case: \"\",\n          labels: p.labels,\n        }],\n      ) {\n        Ok(rs) => Ok(rs),\n        Err(m) => Err(m),\n      }\n    } else {\n      kernel_cli.mutual(mut cmds, mut ctx, prepared)\n    }\n    t1 := clock.now().value\n    match results {\n      Ok(rs) => {\n        for (k, p) in enumerate(prepared) {\n          match get(rs, k) {\n            Some(th) => if len(kernel.assumptions(th)) == 0\n              && kernel.same_term(kernel.conclusion(th), p.statement) {\n              b := kernel.depends_on(th)\n              detail := if len(b.oracles) > 0 {\n                \" [assumed: \"\n                  + join(b.oracles, \", \")\n                  + if ctx.omega_calls > 0 {\n                    \", \"\n                      + to_string(ctx.omega_calls)\n                      + \" solver calls\"\n                  } else {\n                    \"\"\n                  }\n                  + \"]\"\n              } else {\n                \"\"\n              }\n              mut out.push(\n                kernel_cli.Outcome {\n                  name: p.script.name,\n                  verdict: \"proven\",\n                  detail,\n                  ns: t1 - t0,\n                },\n              )\n              mut thy.theorems.insert(\n                p.script.name,\n                [kernel.named(p.script.name, th)],\n              )\n              if p.script.simp_rule {\n                mut thy.simp.push(p.script.name)\n              }\n            } else {\n              mut out.push(\n                kernel_cli.Outcome {\n                  name: p.script.name,\n                  verdict: \"failed\",\n                  detail: \"the kernel's theorem isn't the statement (a tactic bug): it is `\"\n                    + kernel_tactics.term_text_of(\n                      kernel.conclusion(th),\n                    )\n                    + \"` from \"\n                    + to_string(len(kernel.assumptions(th)))\n                    + \" hypotheses (\"\n                    + join(kernel.assumptions(th).map(\n                      h -> kernel_tactics.term_text_of(h),\n                    ), \"; \")\n                    + \"), the statement `\"\n                    + kernel_tactics.term_text_of(p.statement)\n                    + \"`; first difference: \"\n                    + kernel_cli.difference(\n                      kernel.conclusion(th),\n                      p.statement,\n                    ),\n                  ns: t1 - t0,\n                },\n              )\n              mut thy.failed.push(p.script.name)\n            },\n            None => {\n              mut out.push(\n                kernel_cli.Outcome {\n                  name: p.script.name,\n                  verdict: \"failed\",\n                  detail: \"goals left\",\n                  ns: t1 - t0,\n                },\n              )\n              mut thy.failed.push(p.script.name)\n            },\n          }\n        }\n      },\n      Err(m) => {\n        for p in prepared {\n          mut out.push(\n            kernel_cli.Outcome {\n              name: p.script.name,\n              verdict: \"failed\",\n              detail: m,\n              ns: t1 - t0,\n            },\n          )\n          mut thy.failed.push(p.script.name)\n        }\n      },\n    }\n  }\n  Ok((out, thy.notes, thy))\n}","old_text":"fn check_script(\n  mut cmds: std.process.Commands,\n  clock: std.time.SystemClock,\n  solver: String,\n  script: kernel_tactics.ScriptFile,\n  code: List[ast.Decl],\n  goals_only: Bool,\n  base: kernel_cli.Base,\n  z3_arith: Bool,\n) -> Result[(List[kernel_cli.Outcome], List[String], kernel_translate.Theory), String] {\n  mut thy := base.thy\n  if len(code) > 0 {\n    kernel_translate.add_decls(mut thy, code)!\n  }\n  mut logic := []\n  for (n, th) in kernel_logic.logic_rewrites()! {\n    for r in kernel_logic.rewrites_of(th, \"?\" + n)! {\n      mut logic.push(r)\n    }\n  }\n  for n in [\"int.not_lt\", \"int.not_le\"] {\n    for th in get(thy.theorems, n) ?? [] {\n      for r in kernel_logic.rewrites_of(th, \"?\" + n)! {\n        mut logic.push(r)\n      }\n    }\n  }\n  mut out := []\n  mut i := 0\n  ths := script.theorems\n  while i < len(ths) {\n    s := get(ths, i) or {\n      kernel_tactics.Script {\n        name: \"\",\n        header: \"\",\n        statement: \"\",\n        simp_rule: false,\n        tacs: [],\n        line: 0,\n      }\n    }\n    // a `mutual` block: its theorems together\n    mut block := [s]\n    if s.group > 0 {\n      while i + len(block) < len(ths)\n        && (get(ths, i + len(block)) ?? s).group == s.group {\n        mut block.push(get(ths, i + len(block)) ?? s)\n      }\n    }\n    i += len(block)\n    t0 := clock.now().value\n    mut prepared := []\n    mut bad := false\n    for b in block {\n      match kernel_cli.prepare(thy, b) {\n        Ok(p) => mut prepared.push(\n          kernel_cli.Prepared {\n            ..p,\n            labels: kernel_cli.labels_of(thy),\n          },\n        ),\n        Err(m) => {\n          mut out.push(\n            kernel_cli.Outcome {\n              name: b.name,\n              verdict: \"failed\",\n              detail: \"its statement: \" + m,\n              ns: 0,\n            },\n          )\n          mut thy.failed.push(b.name)\n          bad = true\n        },\n      }\n    }\n    if bad {\n      continue\n    }\n    if goals_only || prepared.all(p -> len(p.script.tacs) == 0) {\n      for p in prepared {\n        goal := kernel_cli.opened_goal(p)\n        mut out.push(\n          kernel_cli.Outcome { name: if p.script.law_form {\n              \"law \"\n            } else {\n              \"theorem \"\n            }\n            + p.script.name\n            + if p.script.header == \"\" {\n              \"\"\n            } else {\n              \" \" + p.script.header\n            }\n            + if p.script.statement == \"\" {\n              \"\"\n            } else {\n              \": \" + p.script.statement\n            }, verdict: if goals_only {\n            \"goal\"\n          } else {\n            \"open\"\n          }, detail: kernel_tactics.goal_text(goal), ns: 0 },\n        )\n        mut thy.unproven.push(p.script.name)\n      }\n      continue\n    }\n    simp_set := logic + kernel_cli.simp_rewrites(thy)!\n    // linear arithmetic once core/int.kp is proven\n    lemmas := kernel_cli.arithmetic_lemmas(thy)\n    mut ctx := kernel_tactics.Context {\n      thy,\n      simp: simp_set,\n      solver,\n      omega_calls: 0,\n      arith: if get(lemmas.by_name, \"int.eq_neg\") is Some {\n        Some(lemmas)\n      } else {\n        None\n      },\n      laws: prepared.map(p -> p.lref),\n      logic,\n      z3_arith,\n    }\n    results := if len(prepared) == 1 {\n      p := get(prepared, 0) or { return Err(\"internal: a lost theorem\") }\n      tacs := kernel_cli.opening(p, thy) + p.script.tacs\n      match kernel_tactics.run(\n        mut cmds,\n        mut ctx,\n        tacs,\n        [kernel_tactics.Goal {\n          assumptions: [],\n          vars: [],\n          conclusion: p.statement,\n          type_params: p.type_params,\n          case: \"\",\n          labels: p.labels,\n        }],\n      ) {\n        Ok(rs) => Ok(rs),\n        Err(m) => Err(m),\n      }\n    } else {\n      kernel_cli.mutual(mut cmds, mut ctx, prepared)\n    }\n    t1 := clock.now().value\n    match results {\n      Ok(rs) => {\n        for (k, p) in enumerate(prepared) {\n          match get(rs, k) {\n            Some(th) => if len(kernel.assumptions(th)) == 0\n              && kernel.same_term(kernel.conclusion(th), p.statement) {\n              b := kernel.depends_on(th)\n              detail := if len(b.oracles) > 0 {\n                \" [assumed: \"\n                  + join(b.oracles, \", \")\n                  + if ctx.omega_calls > 0 {\n                    \", \"\n                      + to_string(ctx.omega_calls)\n                      + \" solver calls\"\n                  } else {\n                    \"\"\n                  }\n                  + \"]\"\n              } else {\n                \"\"\n              }\n              mut out.push(\n                kernel_cli.Outcome {\n                  name: p.script.name,\n                  verdict: \"proven\",\n                  detail,\n                  ns: t1 - t0,\n                },\n              )\n              mut thy.theorems.insert(p.script.name, [th])\n              if p.script.simp_rule {\n                mut thy.simp.push(p.script.name)\n              }\n            } else {\n              mut out.push(\n                kernel_cli.Outcome {\n                  name: p.script.name,\n                  verdict: \"failed\",\n                  detail: \"the kernel's theorem isn't the statement (a tactic bug): it is `\"\n                    + kernel_tactics.term_text_of(\n                      kernel.conclusion(th),\n                    )\n                    + \"` from \"\n                    + to_string(len(kernel.assumptions(th)))\n                    + \" hypotheses (\"\n                    + join(kernel.assumptions(th).map(\n                      h -> kernel_tactics.term_text_of(h),\n                    ), \"; \")\n                    + \"), the statement `\"\n                    + kernel_tactics.term_text_of(p.statement)\n                    + \"`; first difference: \"\n                    + kernel_cli.difference(\n                      kernel.conclusion(th),\n                      p.statement,\n                    ),\n                  ns: t1 - t0,\n                },\n              )\n              mut thy.failed.push(p.script.name)\n            },\n            None => {\n              mut out.push(\n                kernel_cli.Outcome {\n                  name: p.script.name,\n                  verdict: \"failed\",\n                  detail: \"goals left\",\n                  ns: t1 - t0,\n                },\n              )\n              mut thy.failed.push(p.script.name)\n            },\n          }\n        }\n      },\n      Err(m) => {\n        for p in prepared {\n          mut out.push(\n            kernel_cli.Outcome {\n              name: p.script.name,\n              verdict: \"failed\",\n              detail: m,\n              ns: t1 - t0,\n            },\n          )\n          mut thy.failed.push(p.script.name)\n        }\n      },\n    }\n  }\n  Ok((out, thy.notes, thy))\n}"},{"name":"kernel_cli.use kernel_dependent_hol","kind":"use","old":null,"new":"1d8b3cb85844b11b","interface_changed":true,"affected":[],"module":"kernel_cli","text":"use kernel_dependent_hol"},{"name":"kernel_cli.replayed","kind":"fn","old":null,"new":"2bbb30d15332f356","interface_changed":true,"affected":[],"module":"kernel_cli","text":"/// `--dependent`: each law the HOL kernel proved, its theorem replayed as a\n/// proof term and checked by the dependent kernel (kernel_dependent_hol),\n/// with the time and the term's size. Whether every one checked.\nfn replayed(\n  mut console: std.io.Console,\n  clock: std.time.SystemClock,\n  thy: kernel_translate.Theory,\n  os: List[kernel_cli.Outcome],\n) -> Bool {\n  t0 := clock.now().value\n  mut r := kernel_dependent_hol.start(thy) except m {\n    mut console.write(\"dependent: the base: \" + m + \"\\n\")\n    return false\n  }\n  t1 := clock.now().value\n  mut ok := true\n  mut checked := 0\n  for o in os {\n    if o.verdict != \"proven\" {\n      continue\n    }\n    th := get(get(thy.theorems, o.name) ?? [], 0) or {\n      continue\n    }\n    s0 := clock.now().value\n    match kernel_dependent_hol.check_law(mut r, o.name, th) {\n      Ok(size) => {\n        checked += 1\n        mut console.write(\n          \"dependent: proven \"\n            + o.name\n            + \" (\"\n            + kernel_cli.milliseconds(clock.now().value - s0)\n            + f\", a term of {size} nodes)\\n\",\n        )\n      },\n      Err(m) => {\n        ok = false\n        mut console.write(\n          \"dependent: failed \" + o.name + \": \" + m + \"\\n\",\n        )\n      },\n    }\n  }\n  mut console.write(\n    f\"dependent: {checked} checked ({kernel_cli.milliseconds(clock.now().value - t1)}, the base {kernel_cli.milliseconds(t1 - t0)})\\n\",\n  )\n  ok\n}"}]}
{"id":"f6d96f4f276ea0bc","time":1795852168,"message":"edit","changes":[{"name":"kernel_dependent_hol.constant","kind":"fn","old":"202bfedc904f703e","new":"1af629f295ba47eb","interface_changed":false,"affected":[],"module":"kernel_dependent_hol","text":"fn constant(\n  mut r: kernel_dependent_hol.Replay,\n  name: String,\n  ty: kernel.Type,\n) -> Result[kernel_dependent_hol.D, String] {\n  simple := [\n    (\"==>\", \"implies\"),\n    (\"/\\\\\", \"and\"),\n    (\"\\/\", \"or\"),\n    (\"~\", \"not\"),\n    (\"T\", \"true\"),\n    (\"F\", \"false\"),\n  ]\n  for (h, d) in simple {\n    if name == h {\n      return Ok(kernel_dependent_hol.c(d))\n    }\n  }\n  if starts_with(name, \"int.\") || kernel.is_numeral(name) {\n    return Ok(kernel_dependent_hol.c(name))\n  }\n  if name == \"=\" || name == \"ite\" {\n    a := if name == \"=\" {\n      kernel_dependent_hol.first_argument(ty)\n    } else {\n      kernel_dependent_hol.first_argument(\n        kernel_dependent_hol.second(ty),\n      )\n    }\n    return Ok(kernel_dependent.Apply {\n      function: kernel_dependent_hol.c(if name == \"=\" {\n        \"eqv\"\n      } else {\n        \"ite\"\n      }),\n      argument: kernel_dependent_hol.type_term(mut r, a)!,\n    })\n  }\n  if name == \"forall\" || name == \"exists\" {\n    return Ok(kernel_dependent.Apply {\n      function: kernel_dependent_hol.c(if name == \"forall\" {\n        \"all\"\n      } else {\n        \"some\"\n      }),\n      argument: kernel_dependent_hol.type_term(\n        mut r,\n        kernel_dependent_hol.first_argument(\n          kernel_dependent_hol.first_argument(ty),\n        ),\n      )!,\n    })\n  }\n  if get(r.consts, name) == None {\n    // a constant first met in a statement: the `define` step its\n    // equations rest on\n    for th in get(r.equations, name) ?? [] {\n      match kernel_dependent_hol.definition_in(th, name, 0) {\n        Some(ts) => kernel_dependent_hol.define_constant(mut r, ts)!,\n        None => (),\n      }\n    }\n  }\n  match get(r.consts, name) {\n    Some((tvs, generic)) => {\n      mut s := []\n      if !kernel_dependent_hol.match_type(generic, ty, mut s) {\n        return Err(\n          \"`\"\n            + name\n            + \"` at a type that isn't an instance of its own\",\n        )\n      }\n      mut args := []\n      for v in tvs {\n        mut args.push(\n          kernel_dependent_hol.type_term(\n            mut r,\n            kernel_dependent_hol.lookup_type(s, v),\n          )!,\n        )\n      }\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"h.\" + name),\n        args,\n      ))\n    },\n    None => Err(\"`\" + name + \"`: no definition reached\"),\n  }\n}","old_text":"fn constant(\n  mut r: kernel_dependent_hol.Replay,\n  name: String,\n  ty: kernel.Type,\n) -> Result[kernel_dependent_hol.D, String] {\n  simple := [\n    (\"==>\", \"implies\"),\n    (\"/\\\\\", \"and\"),\n    (\"\\/\", \"or\"),\n    (\"~\", \"not\"),\n    (\"T\", \"true\"),\n    (\"F\", \"false\"),\n  ]\n  for (h, d) in simple {\n    if name == h {\n      return Ok(kernel_dependent_hol.c(d))\n    }\n  }\n  if starts_with(name, \"int.\") || kernel.is_numeral(name) {\n    return Ok(kernel_dependent_hol.c(name))\n  }\n  if name == \"=\" || name == \"ite\" {\n    a := if name == \"=\" {\n      kernel_dependent_hol.first_argument(ty)\n    } else {\n      kernel_dependent_hol.first_argument(\n        kernel_dependent_hol.second(ty),\n      )\n    }\n    return Ok(kernel_dependent.Apply {\n      function: kernel_dependent_hol.c(if name == \"=\" {\n        \"eqv\"\n      } else {\n        \"ite\"\n      }),\n      argument: kernel_dependent_hol.type_term(mut r, a)!,\n    })\n  }\n  if name == \"forall\" || name == \"exists\" {\n    return Ok(kernel_dependent.Apply {\n      function: kernel_dependent_hol.c(if name == \"forall\" {\n        \"all\"\n      } else {\n        \"some\"\n      }),\n      argument: kernel_dependent_hol.type_term(\n        mut r,\n        kernel_dependent_hol.first_argument(\n          kernel_dependent_hol.first_argument(ty),\n        ),\n      )!,\n    })\n  }\n  if get(r.consts, name) == None {\n    // a constant first met in a statement: its equations define it\n    for th in get(r.equations, name) ?? [] {\n      _ := kernel_dependent_hol.proof(mut r, th)!\n    }\n  }\n  match get(r.consts, name) {\n    Some((tvs, generic)) => {\n      mut s := []\n      if !kernel_dependent_hol.match_type(generic, ty, mut s) {\n        return Err(\n          \"`\"\n            + name\n            + \"` at a type that isn't an instance of its own\",\n        )\n      }\n      mut args := []\n      for v in tvs {\n        mut args.push(\n          kernel_dependent_hol.type_term(\n            mut r,\n            kernel_dependent_hol.lookup_type(s, v),\n          )!,\n        )\n      }\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"h.\" + name),\n        args,\n      ))\n    },\n    None => Err(\"`\" + name + \"`: no definition reached\"),\n  }\n}"},{"name":"kernel_dependent_hol.definition_in","kind":"fn","old":null,"new":"eff5feefbb30aa60","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// The terms of the `define` step for `name` that `th` rests on.\nfn definition_in(\n  th: kernel.Theorem,\n  name: String,\n  depth: Int,\n) -> Option[List[kernel.Term]] {\n  st := kernel.step_of(th)\n  if st.rule == \"define\" {\n    return match st.terms {\n      [kernel.Constant { name: n, .. }, _] => if n == name {\n        Some(st.terms)\n      } else {\n        None\n      },\n      _ => None,\n    }\n  }\n  if depth > 200 {\n    return None\n  }\n  for p in st.premises {\n    match kernel_dependent_hol.definition_in(p, name, depth + 1) {\n      Some(ts) => return Some(ts),\n      None => (),\n    }\n  }\n  None\n}"}]}
{"id":"a25107dd05a9cba8","time":1795852271,"message":"edit","changes":[{"name":"kernel_dependent_hol.tautology","kind":"fn","old":"0124ecce499f53e9","new":"120a74710465ac80","interface_changed":false,"affected":[],"module":"kernel_dependent_hol","text":"/// A tautology of `and`, `or`, `not`, `implies` and `eqv Bool` over atoms:\n/// its atoms generalized, every case computed.\nfn tautology(\n  mut r: kernel_dependent_hol.Replay,\n  stmt: kernel_dependent_hol.D,\n) -> Result[kernel_dependent_hol.D, String] {\n  match kernel_dependent.spine(stmt) {\n    (kernel_dependent.Constant { name: \"eqv\", .. }, [_, l, rt]) => {\n      il := kernel_dependent_hol.tautology(mut r, kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"implies\"),\n        [rt, l],\n      ))!\n      ir := kernel_dependent_hol.tautology(mut r, kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"implies\"),\n        [l, rt],\n      ))!\n      return Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.antisym\"),\n        [l, rt, kernel_dependent.lambda(\n          \"#t\",\n          kernel_dependent_hol.holds(rt),\n          kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"hol.mp\"),\n            [rt, l, il, kernel_dependent.Free(\"#t\")],\n          ),\n        ), kernel_dependent.lambda(\n          \"#t\",\n          kernel_dependent_hol.holds(l),\n          kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"hol.mp\"),\n            [l, rt, ir, kernel_dependent.Free(\"#t\")],\n          ),\n        )],\n      ))\n    },\n    _ => (),\n  }\n  mut atoms := []\n  kernel_dependent_hol.collect_atoms(stmt, mut atoms)\n  names := enumerate(atoms).map(p -> \"#b\" + to_string(p.0))\n  mut general := stmt\n  for (i, a) in enumerate(atoms) {\n    general = kernel_dependent_tactics.replaced(\n      general,\n      a,\n      get(names, i) ?? \"\",\n    )\n  }\n  statement := kernel_dependent_hol.pis(\n    names.map(n -> (n, kernel_dependent_hol.bool())),\n    kernel_dependent_hol.holds(general),\n  )\n  g := kernel_dependent_hol.goal_for(mut r, statement)!\n  p := kernel_dependent_hol.split_all(g, names)!\n  Ok(kernel_dependent_hol.at(p, atoms))\n}","old_text":"/// A tautology of `and`, `or`, `not`, `implies` and `eqv Bool` over atoms:\n/// its atoms generalized, every case computed.\nfn tautology(\n  mut r: kernel_dependent_hol.Replay,\n  stmt: kernel_dependent_hol.D,\n) -> Result[kernel_dependent_hol.D, String] {\n  match kernel_dependent.spine(stmt) {\n    (kernel_dependent.Constant { name: \"eqv\", .. }, [_, l, rt]) => {\n      il := kernel_dependent_hol.tautology(mut r, kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"implies\"),\n        [rt, l],\n      ))!\n      ir := kernel_dependent_hol.tautology(mut r, kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"implies\"),\n        [l, rt],\n      ))!\n      return Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.antisym\"),\n        [l, rt, kernel_dependent.lambda(\n          \"#t\",\n          kernel_dependent_hol.holds(rt),\n          kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"hol.mp\"),\n            [rt, l, il, kernel_dependent.Free(\"#t\")],\n          ),\n        ), kernel_dependent.lambda(\n          \"#t\",\n          kernel_dependent_hol.holds(l),\n          kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"hol.mp\"),\n            [l, rt, ir, kernel_dependent.Free(\"#t\")],\n          ),\n        )],\n      ))\n    },\n    _ => (),\n  }\n  mut atoms := []\n  kernel_dependent_hol.collect_atoms(stmt, mut atoms)\n  names := enumerate(atoms).map(p -> \"#b\" + to_string(p.0))\n  mut general := stmt\n  for (i, a) in enumerate(atoms) {\n    general = kernel_dependent_tactics.replaced(\n      general,\n      a,\n      get(names, i) ?? \"\",\n    )\n  }\n  statement := kernel_dependent_hol.pis(\n    names.map(n -> (n, kernel_dependent_hol.bool())),\n    kernel_dependent_hol.holds(general),\n  )\n  g := kernel_dependent_tactics.Goal {\n    env: r.env,\n    context: [],\n    target: statement,\n  }\n  p := kernel_dependent_hol.split_all(g, names)!\n  Ok(kernel_dependent_hol.at(p, atoms))\n}"},{"name":"kernel_dependent_hol.datatype_fact","kind":"fn","old":"199bbc64d130e3e2","new":"82341550c4a85e2a","interface_changed":false,"affected":[],"module":"kernel_dependent_hol","text":"/// A datatype fact, proven once per group, kind and position, then used by\n/// name.\nfn datatype_fact(\n  mut r: kernel_dependent_hol.Replay,\n  st: kernel.Step,\n  th: kernel.Theorem,\n) -> Result[kernel_dependent_hol.D, String] {\n  first := (get(st.specs, 0) ?? kernel.DatatypeSpec { name: \"\", params: [], ctors: [] }).name\n  kernel_dependent_hol.define_group(mut r, first)!\n  name := \"fact.\"\n    + first\n    + \".\"\n    + st.rule\n    + join(st.indices.map(i -> \".\" + to_string(i)), \"\")\n  match get(r.named, name) {\n    Some((cn, args)) => return Ok(kernel_dependent_hol.at(\n      kernel_dependent_hol.c(cn),\n      args.map(a -> kernel_dependent.Free(a)),\n    )),\n    None => (),\n  }\n  ct := kernel.conclusion(th)\n  statement := kernel_dependent_hol.holds(kernel_dependent_hol.term(mut r, ct)!)\n  g := kernel_dependent_hol.goal_for(mut r, statement)!\n  body := match st.rule {\n    \"recursion\" | \"cases\" => kernel_dependent_hol.by_conversion(g)!,\n    \"injective\" => kernel_dependent_hol.injective(mut r, g, ct)!,\n    \"distinct\" => kernel_dependent_hol.distinct(mut r, g, ct, st)!,\n    _ => kernel_dependent_hol.induction(mut r, g, ct, st)!,\n  }\n  (cn, args) := kernel_dependent_hol.close_term(\n    mut r,\n    \"h.\" + name,\n    statement,\n    body,\n    [],\n  )!\n  mut r.named.insert(name, (cn, args))\n  Ok(kernel_dependent_hol.at(\n    kernel_dependent_hol.c(cn),\n    args.map(a -> kernel_dependent.Free(a)),\n  ))\n}","old_text":"/// A datatype fact, proven once per group, kind and position, then used by\n/// name.\nfn datatype_fact(\n  mut r: kernel_dependent_hol.Replay,\n  st: kernel.Step,\n  th: kernel.Theorem,\n) -> Result[kernel_dependent_hol.D, String] {\n  first := (get(st.specs, 0) ?? kernel.DatatypeSpec { name: \"\", params: [], ctors: [] }).name\n  kernel_dependent_hol.define_group(mut r, first)!\n  name := \"fact.\"\n    + first\n    + \".\"\n    + st.rule\n    + join(st.indices.map(i -> \".\" + to_string(i)), \"\")\n  match get(r.named, name) {\n    Some((cn, args)) => return Ok(kernel_dependent_hol.at(\n      kernel_dependent_hol.c(cn),\n      args.map(a -> kernel_dependent.Free(a)),\n    )),\n    None => (),\n  }\n  ct := kernel.conclusion(th)\n  statement := kernel_dependent_hol.holds(kernel_dependent_hol.term(mut r, ct)!)\n  g := kernel_dependent_tactics.Goal {\n    env: r.env,\n    context: [],\n    target: statement,\n  }\n  body := match st.rule {\n    \"recursion\" | \"cases\" => kernel_dependent_hol.by_conversion(g)!,\n    \"injective\" => kernel_dependent_hol.injective(mut r, g, ct)!,\n    \"distinct\" => kernel_dependent_hol.distinct(mut r, g, ct, st)!,\n    _ => kernel_dependent_hol.induction(mut r, g, ct, st)!,\n  }\n  (cn, args) := kernel_dependent_hol.close_term(\n    mut r,\n    \"h.\" + name,\n    statement,\n    body,\n    [],\n  )!\n  mut r.named.insert(name, (cn, args))\n  Ok(kernel_dependent_hol.at(\n    kernel_dependent_hol.c(cn),\n    args.map(a -> kernel_dependent.Free(a)),\n  ))\n}"},{"name":"kernel_dependent_hol.check_law","kind":"fn","old":"f2d7bfb46bef1e68","new":"13173e2218329c4f","interface_changed":false,"affected":[],"module":"kernel_dependent_hol","text":"/// A law the HOL kernel proved, checked by the dependent kernel: its proof\n/// term's size.\npub fn check_law(\n  mut r: kernel_dependent_hol.Replay,\n  name: String,\n  th: kernel.Theorem,\n) -> Result[Int, String] {\n  if kernel.step_of(th).rule != \"named:\" + name {\n    return kernel_dependent_hol.check_law(\n      mut r,\n      name,\n      kernel.named(name, th),\n    )\n  }\n  _ := kernel_dependent_hol.proof(mut r, th)!\n  match kernel_dependent.lookup(r.env, \"h.law.\" + name) {\n    Some(kernel_dependent.Entry { value: Some(v), .. }) => Ok(kernel_dependent_hol.size(v)),\n    _ => Err(\"not defined\"),\n  }\n}","old_text":"/// A law the HOL kernel proved, checked by the dependent kernel: its proof\n/// term's size.\npub fn check_law(\n  mut r: kernel_dependent_hol.Replay,\n  name: String,\n  th: kernel.Theorem,\n) -> Result[Int, String] {\n  body := kernel_dependent_hol.proof(mut r, th)!\n  statement := kernel_dependent_hol.holds(\n    kernel_dependent_hol.conclusion_of(mut r, th)!,\n  )\n  _ := kernel_dependent_hol.close_term(\n    mut r,\n    \"h.law.\" + name,\n    statement,\n    body,\n    [],\n  )!\n  mut r.named.insert(name, (\"h.law.\" + name, []))\n  Ok(kernel_dependent_hol.size(body))\n}"},{"name":"kernel_dependent_hol.goal_for","kind":"fn","old":null,"new":"4c87a2e2ba71869d","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// A goal of `statement` in the context of its free variables (type\n/// variables, then variables).\nfn goal_for(\n  mut r: kernel_dependent_hol.Replay,\n  statement: kernel_dependent_hol.D,\n) -> Result[Goal, String] {\n  frees := kernel_dependent_hol.free_names(statement)\n  mut ctx := frees.filter(n -> starts_with(n, \"'\")).map(n -> (n, Sort(0)))\n  for n in frees.filter(n -> starts_with(n, \"v:\")) {\n    match get(r.vars, n) {\n      Some(v) => {\n        ctx = [(n, kernel_dependent_hol.type_term(\n            mut r,\n            kernel_dependent_hol.hol_type(v),\n          )!)]\n          + ctx\n      },\n      None => return Err(\"`\" + n + \"`: an unknown variable\"),\n    }\n  }\n  Ok(\n    Goal { env: r.env, context: ctx.reversed(), target: statement },\n  )\n}"},{"name":"kernel_dependent_hol.diagnose","kind":"fn","old":null,"new":"eaeeb1af06f919bf","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// Where `t` (meant to prove `want`) is ill-typed: the first application\n/// whose argument isn't of the function's domain, as text.\npub fn diagnose(\n  env: kernel_dependent.Environment,\n  ctx: List[(String, kernel_dependent_hol.D)],\n  t: kernel_dependent_hol.D,\n  want: kernel_dependent_hol.D,\n) -> String {\n  match kernel_dependent.infer(env, ctx, t) {\n    Ok(ty) => if kernel_dependent.convertible(env, len(ctx), ty, want) {\n      \"\"\n    } else {\n      \":\\n  the proof proves \"\n        + kernel_dependent_tactics.show(\n          kernel_dependent_tactics.normal(env, len(ctx), ty),\n          [],\n        )\n        + \"\\n  not \"\n        + kernel_dependent_tactics.show(\n          kernel_dependent_tactics.normal(env, len(ctx), want),\n          [],\n        )\n    },\n    Err(_) => kernel_dependent_hol.find_bad(env, ctx, t),\n  }\n}"},{"name":"kernel_dependent_hol.find_bad","kind":"fn","old":null,"new":"e639ddcb8b3e3e5d","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn find_bad(\n  env: kernel_dependent.Environment,\n  ctx: List[(String, kernel_dependent_hol.D)],\n  t: kernel_dependent_hol.D,\n) -> String {\n  match t {\n    Apply { function, argument } => {\n      match kernel_dependent.infer(env, ctx, function) {\n        Err(_) => return kernel_dependent_hol.find_bad(env, ctx, function),\n        Ok(ft) => match kernel_dependent.infer(env, ctx, argument) {\n          Err(_) => return kernel_dependent_hol.find_bad(env, ctx, argument),\n          Ok(at_) => match kernel_dependent.whnf(env, ft) {\n            Pi { domain, .. } => if !kernel_dependent.convertible(env, len(ctx), at_, domain) {\n              return \":\\n  in \"\n                + kernel_dependent_tactics.show(t, [])\n                + \"\\n  the argument is of type \"\n                + kernel_dependent_tactics.show(\n                  kernel_dependent_tactics.normal(\n                    env,\n                    len(ctx),\n                    at_,\n                  ),\n                  [],\n                )\n                + \"\\n  the function wants \"\n                + kernel_dependent_tactics.show(\n                  kernel_dependent_tactics.normal(\n                    env,\n                    len(ctx),\n                    domain,\n                  ),\n                  [],\n                )\n            },\n            _ => return \":\\n  not a function: \"\n              + kernel_dependent_tactics.show(function, []),\n          },\n        },\n      }\n      \"\"\n    },\n    Lambda { name, domain, body } => {\n      x := kernel_dependent.fresh(len(ctx))\n      _ := name\n      kernel_dependent_hol.find_bad(\n        env,\n        [(x, domain)] + ctx,\n        kernel_dependent.instantiate(body, Free(x), 0),\n      )\n    },\n    _ => match kernel_dependent.infer(env, ctx, t) {\n      Err(m) => \": \" + m + \" in \" + kernel_dependent_tactics.show(t, []),\n      Ok(_) => \"\",\n    },\n  }\n}"}]}
{"id":"c3cef4931058e7b4","time":1795852314,"message":"edit","changes":[{"name":"kernel_dependent_hol.goal_for","kind":"fn","old":"4c87a2e2ba71869d","new":"38575cf6a439fb84","interface_changed":true,"affected":["kernel_dependent_hol.tautology","kernel_dependent_hol.datatype_fact","kernel_dependent_hol.axiom","kernel_dependent_hol.proof","kernel_dependent_hol.named","kernel_dependent_hol.check_law","kernel_cli.replayed","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent_hol","text":"/// A goal of `statement` in the context of its free variables (type\n/// variables, then variables).\nfn goal_for(\n  mut r: kernel_dependent_hol.Replay,\n  statement: kernel_dependent_hol.D,\n) -> Result[kernel_dependent_tactics.Goal, String] {\n  frees := kernel_dependent_hol.free_names(statement)\n  mut ctx := frees\n    .filter(n -> starts_with(n, \"'\"))\n    .map(n -> (n, kernel_dependent.Sort(0)))\n  for n in frees.filter(n -> starts_with(n, \"v:\")) {\n    match get(r.vars, n) {\n      Some(v) => {\n        ctx = [(n, kernel_dependent_hol.type_term(\n            mut r,\n            kernel_dependent_hol.hol_type(v),\n          )!)]\n          + ctx\n      },\n      None => return Err(\"`\" + n + \"`: an unknown variable\"),\n    }\n  }\n  Ok(kernel_dependent_tactics.Goal {\n    env: r.env,\n    context: ctx.reversed(),\n    target: statement,\n  })\n}","old_text":"/// A goal of `statement` in the context of its free variables (type\n/// variables, then variables).\nfn goal_for(\n  mut r: kernel_dependent_hol.Replay,\n  statement: kernel_dependent_hol.D,\n) -> Result[Goal, String] {\n  frees := kernel_dependent_hol.free_names(statement)\n  mut ctx := frees.filter(n -> starts_with(n, \"'\")).map(n -> (n, Sort(0)))\n  for n in frees.filter(n -> starts_with(n, \"v:\")) {\n    match get(r.vars, n) {\n      Some(v) => {\n        ctx = [(n, kernel_dependent_hol.type_term(\n            mut r,\n            kernel_dependent_hol.hol_type(v),\n          )!)]\n          + ctx\n      },\n      None => return Err(\"`\" + n + \"`: an unknown variable\"),\n    }\n  }\n  Ok(\n    Goal { env: r.env, context: ctx.reversed(), target: statement },\n  )\n}"},{"name":"kernel_dependent_hol.find_bad","kind":"fn","old":"e639ddcb8b3e3e5d","new":"b7e5cde889121ec0","interface_changed":false,"affected":["kernel_dependent_hol.diagnose"],"module":"kernel_dependent_hol","text":"fn find_bad(\n  env: kernel_dependent.Environment,\n  ctx: List[(String, kernel_dependent_hol.D)],\n  t: kernel_dependent_hol.D,\n) -> String {\n  match t {\n    kernel_dependent.Apply { function, argument } => {\n      match kernel_dependent.infer(env, ctx, function) {\n        Err(_) => return kernel_dependent_hol.find_bad(env, ctx, function),\n        Ok(ft) => match kernel_dependent.infer(env, ctx, argument) {\n          Err(_) => return kernel_dependent_hol.find_bad(env, ctx, argument),\n          Ok(at_) => match kernel_dependent.whnf(env, ft) {\n            kernel_dependent.Pi { domain, .. } => if !kernel_dependent.convertible(env, len(ctx), at_, domain) {\n              return \":\\n  in \"\n                + kernel_dependent_tactics.show(t, [])\n                + \"\\n  the argument is of type \"\n                + kernel_dependent_tactics.show(\n                  kernel_dependent_tactics.normal(\n                    env,\n                    len(ctx),\n                    at_,\n                  ),\n                  [],\n                )\n                + \"\\n  the function wants \"\n                + kernel_dependent_tactics.show(\n                  kernel_dependent_tactics.normal(\n                    env,\n                    len(ctx),\n                    domain,\n                  ),\n                  [],\n                )\n            },\n            _ => return \":\\n  not a function: \"\n              + kernel_dependent_tactics.show(function, []),\n          },\n        },\n      }\n      \"\"\n    },\n    kernel_dependent.Lambda { name, domain, body } => {\n      x := kernel_dependent.fresh(len(ctx))\n      _ := name\n      kernel_dependent_hol.find_bad(\n        env,\n        [(x, domain)] + ctx,\n        kernel_dependent.instantiate(\n          body,\n          kernel_dependent.Free(x),\n          0,\n        ),\n      )\n    },\n    _ => match kernel_dependent.infer(env, ctx, t) {\n      Err(m) => \": \" + m + \" in \" + kernel_dependent_tactics.show(t, []),\n      Ok(_) => \"\",\n    },\n  }\n}","old_text":"fn find_bad(\n  env: kernel_dependent.Environment,\n  ctx: List[(String, kernel_dependent_hol.D)],\n  t: kernel_dependent_hol.D,\n) -> String {\n  match t {\n    Apply { function, argument } => {\n      match kernel_dependent.infer(env, ctx, function) {\n        Err(_) => return kernel_dependent_hol.find_bad(env, ctx, function),\n        Ok(ft) => match kernel_dependent.infer(env, ctx, argument) {\n          Err(_) => return kernel_dependent_hol.find_bad(env, ctx, argument),\n          Ok(at_) => match kernel_dependent.whnf(env, ft) {\n            Pi { domain, .. } => if !kernel_dependent.convertible(env, len(ctx), at_, domain) {\n              return \":\\n  in \"\n                + kernel_dependent_tactics.show(t, [])\n                + \"\\n  the argument is of type \"\n                + kernel_dependent_tactics.show(\n                  kernel_dependent_tactics.normal(\n                    env,\n                    len(ctx),\n                    at_,\n                  ),\n                  [],\n                )\n                + \"\\n  the function wants \"\n                + kernel_dependent_tactics.show(\n                  kernel_dependent_tactics.normal(\n                    env,\n                    len(ctx),\n                    domain,\n                  ),\n                  [],\n                )\n            },\n            _ => return \":\\n  not a function: \"\n              + kernel_dependent_tactics.show(function, []),\n          },\n        },\n      }\n      \"\"\n    },\n    Lambda { name, domain, body } => {\n      x := kernel_dependent.fresh(len(ctx))\n      _ := name\n      kernel_dependent_hol.find_bad(\n        env,\n        [(x, domain)] + ctx,\n        kernel_dependent.instantiate(body, Free(x), 0),\n      )\n    },\n    _ => match kernel_dependent.infer(env, ctx, t) {\n      Err(m) => \": \" + m + \" in \" + kernel_dependent_tactics.show(t, []),\n      Ok(_) => \"\",\n    },\n  }\n}"}]}
{"id":"57032193828f8927","time":1795852390,"message":"edit","changes":[{"name":"kernel_dependent_hol.tautology","kind":"fn","old":"120a74710465ac80","new":"c6d28a8639a49611","interface_changed":false,"affected":[],"module":"kernel_dependent_hol","text":"/// A tautology of `and`, `or`, `not`, `implies` and `eqv Bool` over atoms:\n/// its atoms generalized, every case computed.\nfn tautology(\n  mut r: kernel_dependent_hol.Replay,\n  stmt: kernel_dependent_hol.D,\n) -> Result[kernel_dependent_hol.D, String] {\n  match kernel_dependent.spine(stmt) {\n    (kernel_dependent.Constant { name: \"eqv\", .. }, [_, l, rt]) => {\n      il := kernel_dependent_hol.tautology(mut r, kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"implies\"),\n        [rt, l],\n      ))!\n      ir := kernel_dependent_hol.tautology(mut r, kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"implies\"),\n        [l, rt],\n      ))!\n      return Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.antisym\"),\n        [l, rt, kernel_dependent.lambda(\n          \"#t\",\n          kernel_dependent_hol.holds(rt),\n          kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"hol.mp\"),\n            [rt, l, il, kernel_dependent.Free(\"#t\")],\n          ),\n        ), kernel_dependent.lambda(\n          \"#t\",\n          kernel_dependent_hol.holds(l),\n          kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"hol.mp\"),\n            [l, rt, ir, kernel_dependent.Free(\"#t\")],\n          ),\n        )],\n      ))\n    },\n    _ => (),\n  }\n  mut atoms := []\n  kernel_dependent_hol.collect_atoms(stmt, mut atoms)\n  names := enumerate(atoms).map(p -> \"#b\" + to_string(p.0))\n  mut general := stmt\n  atoms = atoms.sorted_by(x -> 0 - kernel_dependent_hol.size(x))\n  for (i, a) in enumerate(atoms) {\n    general = kernel_dependent_tactics.replaced(\n      general,\n      a,\n      get(names, i) ?? \"\",\n    )\n  }\n  statement := kernel_dependent_hol.pis(\n    names.map(n -> (n, kernel_dependent_hol.bool())),\n    kernel_dependent_hol.holds(general),\n  )\n  g := kernel_dependent_hol.goal_for(mut r, statement)!\n  p := kernel_dependent_hol.split_all(g, names)!\n  Ok(kernel_dependent_hol.at(p, atoms))\n}","old_text":"/// A tautology of `and`, `or`, `not`, `implies` and `eqv Bool` over atoms:\n/// its atoms generalized, every case computed.\nfn tautology(\n  mut r: kernel_dependent_hol.Replay,\n  stmt: kernel_dependent_hol.D,\n) -> Result[kernel_dependent_hol.D, String] {\n  match kernel_dependent.spine(stmt) {\n    (kernel_dependent.Constant { name: \"eqv\", .. }, [_, l, rt]) => {\n      il := kernel_dependent_hol.tautology(mut r, kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"implies\"),\n        [rt, l],\n      ))!\n      ir := kernel_dependent_hol.tautology(mut r, kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"implies\"),\n        [l, rt],\n      ))!\n      return Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.antisym\"),\n        [l, rt, kernel_dependent.lambda(\n          \"#t\",\n          kernel_dependent_hol.holds(rt),\n          kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"hol.mp\"),\n            [rt, l, il, kernel_dependent.Free(\"#t\")],\n          ),\n        ), kernel_dependent.lambda(\n          \"#t\",\n          kernel_dependent_hol.holds(l),\n          kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"hol.mp\"),\n            [l, rt, ir, kernel_dependent.Free(\"#t\")],\n          ),\n        )],\n      ))\n    },\n    _ => (),\n  }\n  mut atoms := []\n  kernel_dependent_hol.collect_atoms(stmt, mut atoms)\n  names := enumerate(atoms).map(p -> \"#b\" + to_string(p.0))\n  mut general := stmt\n  for (i, a) in enumerate(atoms) {\n    general = kernel_dependent_tactics.replaced(\n      general,\n      a,\n      get(names, i) ?? \"\",\n    )\n  }\n  statement := kernel_dependent_hol.pis(\n    names.map(n -> (n, kernel_dependent_hol.bool())),\n    kernel_dependent_hol.holds(general),\n  )\n  g := kernel_dependent_hol.goal_for(mut r, statement)!\n  p := kernel_dependent_hol.split_all(g, names)!\n  Ok(kernel_dependent_hol.at(p, atoms))\n}"}]}
{"id":"d90b4ea9a7dc8d06","time":1795852437,"message":"edit","changes":[{"name":"kernel_dependent_hol.close_term","kind":"fn","old":"e006032ec202c9b0","new":"dfb5c4d41634803f","interface_changed":false,"affected":[],"module":"kernel_dependent_hol","text":"/// `statement` and its proof `body` closed over their free variables and\n/// `hyps`, defined as `cn`: the names it is applied to.\nfn close_term(\n  mut r: kernel_dependent_hol.Replay,\n  cn: String,\n  statement: kernel_dependent_hol.D,\n  body: kernel_dependent_hol.D,\n  hyps: List[(String, kernel_dependent_hol.D)],\n) -> Result[(String, List[String]), String] {\n  mut frees := kernel_dependent_hol.free_names(statement)\n  for n in kernel_dependent_hol.free_names(body) {\n    if !contains(frees, n) && !starts_with(n, \"h:\") {\n      mut frees.push(n)\n    }\n  }\n  types := frees\n    .filter(n -> starts_with(n, \"'\"))\n    .map(n -> (n, kernel_dependent.Sort(0)))\n  mut vars := []\n  for n in frees.filter(n -> starts_with(n, \"v:\")) {\n    match get(r.vars, n) {\n      Some(v) => mut vars.push(\n        (n, kernel_dependent_hol.type_term(\n          mut r,\n          kernel_dependent_hol.hol_type(v),\n        )!),\n      ),\n      None => return Err(\"`\" + n + \"`: an unknown variable\"),\n    }\n  }\n  ps := types + vars + hyps\n  r.env = kernel_dependent.define(\n    r.env,\n    cn,\n    kernel_dependent_hol.pis(ps, statement),\n    kernel_dependent_hol.lams(ps, body),\n  ) except m {\n    return Err(m\n      + kernel_dependent_hol.diagnose(\n        r.env,\n        ps.reversed(),\n        body,\n        statement,\n      )\n      + match kernel_dependent.infer(\n        r.env,\n        [],\n        kernel_dependent_hol.lams(ps, body),\n      ) {\n        Ok(_) => \" (closed, it infers)\",\n        Err(e) => \" (closed: \" + e + \")\",\n      })\n  }\n  Ok((cn, ps.map(p -> p.0)))\n}","old_text":"/// `statement` and its proof `body` closed over their free variables and\n/// `hyps`, defined as `cn`: the names it is applied to.\nfn close_term(\n  mut r: kernel_dependent_hol.Replay,\n  cn: String,\n  statement: kernel_dependent_hol.D,\n  body: kernel_dependent_hol.D,\n  hyps: List[(String, kernel_dependent_hol.D)],\n) -> Result[(String, List[String]), String] {\n  mut frees := kernel_dependent_hol.free_names(statement)\n  for n in kernel_dependent_hol.free_names(body) {\n    if !contains(frees, n) && !starts_with(n, \"h:\") {\n      mut frees.push(n)\n    }\n  }\n  types := frees\n    .filter(n -> starts_with(n, \"'\"))\n    .map(n -> (n, kernel_dependent.Sort(0)))\n  mut vars := []\n  for n in frees.filter(n -> starts_with(n, \"v:\")) {\n    match get(r.vars, n) {\n      Some(v) => mut vars.push(\n        (n, kernel_dependent_hol.type_term(\n          mut r,\n          kernel_dependent_hol.hol_type(v),\n        )!),\n      ),\n      None => return Err(\"`\" + n + \"`: an unknown variable\"),\n    }\n  }\n  ps := types + vars + hyps\n  r.env = kernel_dependent.define(\n    r.env,\n    cn,\n    kernel_dependent_hol.pis(ps, statement),\n    kernel_dependent_hol.lams(ps, body),\n  )!\n  Ok((cn, ps.map(p -> p.0)))\n}"}]}
{"id":"3b48481e83c5443d","time":1795852484,"message":"edit","changes":[{"name":"kernel_dependent_hol.proof","kind":"fn","old":"dac647fc8bb30bcb","new":"793404619c3da2ca","interface_changed":false,"affected":[],"module":"kernel_dependent_hol","text":"/// The term proving `th`'s conclusion (as `holds`), from its hypotheses as\n/// free variables `h:…` and its free variables as `v:…`.\npub fn proof(\n  mut r: kernel_dependent_hol.Replay,\n  th: kernel.Theorem,\n) -> Result[kernel_dependent_hol.D, String] {\n  st := kernel.step_of(th)\n  premise := (i: Int) -> get(st.premises, i) ?? th\n  rule := st.rule\n  ct := kernel.conclusion(th)\n  if starts_with(rule, \"named:\") {\n    return kernel_dependent_hol.named(\n      mut r,\n      byte_slice(rule, 6, byte_len(rule)),\n      premise(0),\n    )\n  }\n  if starts_with(rule, \"axiom:\") {\n    return kernel_dependent_hol.axiom(\n      mut r,\n      byte_slice(rule, 6, byte_len(rule)),\n      th,\n    )\n  }\n  if starts_with(rule, \"oracle:\") {\n    return Ok(kernel_dependent.Apply {\n      function: kernel_dependent_hol.c(\"oracle\"),\n      argument: kernel_dependent_hol.holds(\n        kernel_dependent_hol.conclusion_of(mut r, th)!,\n      ),\n    })\n  }\n  match rule {\n    \"refl\" | \"beta\" | \"compute\" | \"define\" => {\n      if rule == \"define\" {\n        kernel_dependent_hol.define_constant(mut r, st.terms)!\n      }\n      (l, rt) := kernel_dependent_hol.eq_parts(ct)\n      a_type := kernel_dependent_hol.type_term(\n        mut r,\n        kernel_dependent_hol.hol_type(l),\n      )!\n      if rule == \"compute\" && kernel.split_equation(l) is Some {\n        return kernel_dependent_hol.compute_equality(mut r, l, rt)\n      }\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.refl\"),\n        [a_type, kernel_dependent_hol.term(mut r, l)!],\n      ))\n    },\n    \"trans\" => {\n      (a, b) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      (_, cc) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(1)))\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.trans\"),\n          [\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.hol_type(a),\n            )!,\n            kernel_dependent_hol.term(mut r, a)!,\n            kernel_dependent_hol.term(mut r, b)!,\n            kernel_dependent_hol.term(mut r, cc)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.proof(mut r, premise(1))!,\n          ],\n        ),\n      )\n    },\n    \"cong\" => {\n      (f, g) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      (x, y) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(1)))\n      ft := kernel_dependent_hol.hol_type(f)\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.cong\"),\n          [\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.first_argument(ft),\n            )!,\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.second(ft),\n            )!,\n            kernel_dependent_hol.term(mut r, f)!,\n            kernel_dependent_hol.term(mut r, g)!,\n            kernel_dependent_hol.term(mut r, x)!,\n            kernel_dependent_hol.term(mut r, y)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.proof(mut r, premise(1))!,\n          ],\n        ),\n      )\n    },\n    \"abs\" => {\n      (lhs, rhs) := kernel_dependent_hol.eq_parts(ct)\n      x := get(st.terms, 0) ?? lhs\n      xn := kernel_dependent_hol.variable(mut r, x)\n      xt := kernel_dependent_hol.hol_type(x)\n      (s, t) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      inner := kernel_dependent_hol.proof(mut r, premise(0))!\n      Ok(\n        kernel_dependent_hol.at(kernel_dependent_hol.c(\"hol.abs\"), [\n          kernel_dependent_hol.type_term(mut r, xt)!,\n          kernel_dependent_hol.type_term(\n            mut r,\n            kernel_dependent_hol.hol_type(s),\n          )!,\n          kernel_dependent_hol.term(mut r, lhs)!,\n          kernel_dependent_hol.term(mut r, rhs)!,\n          kernel_dependent.lambda(\n            xn,\n            kernel_dependent_hol.type_term(mut r, xt)!,\n            inner,\n          ),\n        ]),\n      )\n    },\n    \"assume\" => Ok(kernel_dependent.Free(kernel_dependent_hol.hypothesis(ct))),\n    \"eq_mp\" => {\n      (p, q) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.eq_mp\"),\n          [\n            kernel_dependent_hol.term(mut r, p)!,\n            kernel_dependent_hol.term(mut r, q)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.proof(mut r, premise(1))!,\n          ],\n        ),\n      )\n    },\n    \"antisym\" => {\n      p := kernel.conclusion(premise(0))\n      q := kernel.conclusion(premise(1))\n      dp := kernel_dependent_hol.term(mut r, p)!\n      dq := kernel_dependent_hol.term(mut r, q)!\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.antisym\"),\n        [dp, dq, kernel_dependent.lambda(\n          kernel_dependent_hol.hypothesis(q),\n          kernel_dependent_hol.holds(dq),\n          kernel_dependent_hol.proof(mut r, premise(0))!,\n        ), kernel_dependent.lambda(\n          kernel_dependent_hol.hypothesis(p),\n          kernel_dependent_hol.holds(dp),\n          kernel_dependent_hol.proof(mut r, premise(1))!,\n        )],\n      ))\n    },\n    \"disch\" => {\n      p := get(st.terms, 0) ?? ct\n      dp := kernel_dependent_hol.term(mut r, p)!\n      dq := kernel_dependent_hol.term(\n        mut r,\n        kernel.conclusion(premise(0)),\n      )!\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.disch\"),\n        [dp, dq, kernel_dependent.lambda(\n          kernel_dependent_hol.hypothesis(p),\n          kernel_dependent_hol.holds(dp),\n          kernel_dependent_hol.proof(mut r, premise(0))!,\n        )],\n      ))\n    },\n    \"mp\" => {\n      (p, q) := kernel.split_connective(\"==>\", kernel.conclusion(premise(0))) ?? (ct, ct)\n      Ok(kernel_dependent_hol.at(kernel_dependent_hol.c(\"hol.mp\"), [\n        kernel_dependent_hol.term(mut r, p)!,\n        kernel_dependent_hol.term(mut r, q)!,\n        kernel_dependent_hol.proof(mut r, premise(0))!,\n        kernel_dependent_hol.proof(mut r, premise(1))!,\n      ]))\n    },\n    \"gen\" => {\n      x := get(st.terms, 0) ?? ct\n      xn := kernel_dependent_hol.variable(mut r, x)\n      (_, lam) := kernel_dependent_hol.split_application(ct)\n      xt := kernel_dependent_hol.type_term(\n        mut r,\n        kernel_dependent_hol.hol_type(x),\n      )!\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"all_intro\"),\n          [\n            xt,\n            kernel_dependent_hol.term(mut r, lam)!,\n            kernel_dependent.lambda(\n              xn,\n              xt,\n              kernel_dependent_hol.proof(mut r, premise(0))!,\n            ),\n          ],\n        ),\n      )\n    },\n    \"spec\" => {\n      t := get(st.terms, 0) ?? ct\n      (_, lam) := kernel_dependent_hol.split_application(\n        kernel.conclusion(premise(0)),\n      )\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"all_elim\"),\n          [\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.hol_type(t),\n            )!,\n            kernel_dependent_hol.term(mut r, lam)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.term(mut r, t)!,\n          ],\n        ),\n      )\n    },\n    \"inst\" => {\n      inner := kernel_dependent_hol.proof(mut r, premise(0))!\n      mut s := []\n      for (v, u) in st.substitution {\n        mut s.push(\n          (\n            kernel_dependent_hol.variable(mut r, v),\n            kernel_dependent_hol.term(mut r, u)!,\n          ),\n        )\n      }\n      for (i, h) in enumerate(kernel.assumptions(premise(0))) {\n        mut s.push(\n          (\n            kernel_dependent_hol.hypothesis(h),\n            kernel_dependent.Free(kernel_dependent_hol.hypothesis(\n              get(kernel.assumptions(th), i) ?? h,\n            )),\n          ),\n        )\n      }\n      Ok(kernel_dependent_hol.substitute(inner, s))\n    },\n    \"inst_type\" => {\n      inner := kernel_dependent_hol.proof(mut r, premise(0))!\n      mut s := []\n      for (v, t) in st.types {\n        mut s.push((\"'\" + v, kernel_dependent_hol.type_term(mut r, t)!))\n      }\n      for n in kernel_dependent_hol.free_names(inner) {\n        match get(r.vars, n) {\n          Some(kernel.Variable { name, value_type }) => {\n            nv := kernel.Variable {\n              name,\n              value_type: kernel.substitute_types(value_type, st.types),\n            }\n            mut s.push(\n              (n, kernel_dependent.Free(\n                kernel_dependent_hol.variable(mut r, nv),\n              )),\n            )\n          },\n          _ => (),\n        }\n      }\n      for (i, h) in enumerate(kernel.assumptions(premise(0))) {\n        mut s.push(\n          (\n            kernel_dependent_hol.hypothesis(h),\n            kernel_dependent.Free(kernel_dependent_hol.hypothesis(\n              get(kernel.assumptions(th), i) ?? h,\n            )),\n          ),\n        )\n      }\n      Ok(kernel_dependent_hol.substitute(inner, s))\n    },\n    \"induction\" | \"recursion\" | \"cases\" | \"injective\" | \"distinct\" => kernel_dependent_hol.datatype_fact(mut r, st, th),\n    _ => Err(\"no replay for the rule `\" + rule + \"`\"),\n  }\n}","old_text":"/// The term proving `th`'s conclusion (as `holds`), from its hypotheses as\n/// free variables `h:…` and its free variables as `v:…`.\npub fn proof(\n  mut r: kernel_dependent_hol.Replay,\n  th: kernel.Theorem,\n) -> Result[kernel_dependent_hol.D, String] {\n  st := kernel.step_of(th)\n  premise := (i: Int) -> get(st.premises, i) ?? th\n  rule := st.rule\n  ct := kernel.conclusion(th)\n  if starts_with(rule, \"named:\") {\n    return kernel_dependent_hol.named(\n      mut r,\n      byte_slice(rule, 6, byte_len(rule)),\n      premise(0),\n    )\n  }\n  if starts_with(rule, \"axiom:\") {\n    return kernel_dependent_hol.axiom(\n      mut r,\n      byte_slice(rule, 6, byte_len(rule)),\n      th,\n    )\n  }\n  if starts_with(rule, \"oracle:\") {\n    return Ok(kernel_dependent.Apply {\n      function: kernel_dependent_hol.c(\"oracle\"),\n      argument: kernel_dependent_hol.holds(\n        kernel_dependent_hol.conclusion_of(mut r, th)!,\n      ),\n    })\n  }\n  match rule {\n    \"refl\" | \"beta\" | \"compute\" | \"define\" => {\n      if rule == \"define\" {\n        kernel_dependent_hol.define_constant(mut r, st.terms)!\n      }\n      (l, rt) := kernel_dependent_hol.eq_parts(ct)\n      a_type := kernel_dependent_hol.type_term(\n        mut r,\n        kernel_dependent_hol.hol_type(l),\n      )!\n      if rule == \"compute\"\n        && kernel_dependent_hol.hol_type(l) == kernel.boolean_type() {\n        return kernel_dependent_hol.compute_equality(mut r, l, rt)\n      }\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.refl\"),\n        [a_type, kernel_dependent_hol.term(mut r, l)!],\n      ))\n    },\n    \"trans\" => {\n      (a, b) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      (_, cc) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(1)))\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.trans\"),\n          [\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.hol_type(a),\n            )!,\n            kernel_dependent_hol.term(mut r, a)!,\n            kernel_dependent_hol.term(mut r, b)!,\n            kernel_dependent_hol.term(mut r, cc)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.proof(mut r, premise(1))!,\n          ],\n        ),\n      )\n    },\n    \"cong\" => {\n      (f, g) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      (x, y) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(1)))\n      ft := kernel_dependent_hol.hol_type(f)\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.cong\"),\n          [\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.first_argument(ft),\n            )!,\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.second(ft),\n            )!,\n            kernel_dependent_hol.term(mut r, f)!,\n            kernel_dependent_hol.term(mut r, g)!,\n            kernel_dependent_hol.term(mut r, x)!,\n            kernel_dependent_hol.term(mut r, y)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.proof(mut r, premise(1))!,\n          ],\n        ),\n      )\n    },\n    \"abs\" => {\n      (lhs, rhs) := kernel_dependent_hol.eq_parts(ct)\n      x := get(st.terms, 0) ?? lhs\n      xn := kernel_dependent_hol.variable(mut r, x)\n      xt := kernel_dependent_hol.hol_type(x)\n      (s, t) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      inner := kernel_dependent_hol.proof(mut r, premise(0))!\n      Ok(\n        kernel_dependent_hol.at(kernel_dependent_hol.c(\"hol.abs\"), [\n          kernel_dependent_hol.type_term(mut r, xt)!,\n          kernel_dependent_hol.type_term(\n            mut r,\n            kernel_dependent_hol.hol_type(s),\n          )!,\n          kernel_dependent_hol.term(mut r, lhs)!,\n          kernel_dependent_hol.term(mut r, rhs)!,\n          kernel_dependent.lambda(\n            xn,\n            kernel_dependent_hol.type_term(mut r, xt)!,\n            inner,\n          ),\n        ]),\n      )\n    },\n    \"assume\" => Ok(kernel_dependent.Free(kernel_dependent_hol.hypothesis(ct))),\n    \"eq_mp\" => {\n      (p, q) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.eq_mp\"),\n          [\n            kernel_dependent_hol.term(mut r, p)!,\n            kernel_dependent_hol.term(mut r, q)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.proof(mut r, premise(1))!,\n          ],\n        ),\n      )\n    },\n    \"antisym\" => {\n      p := kernel.conclusion(premise(0))\n      q := kernel.conclusion(premise(1))\n      dp := kernel_dependent_hol.term(mut r, p)!\n      dq := kernel_dependent_hol.term(mut r, q)!\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.antisym\"),\n        [dp, dq, kernel_dependent.lambda(\n          kernel_dependent_hol.hypothesis(q),\n          kernel_dependent_hol.holds(dq),\n          kernel_dependent_hol.proof(mut r, premise(0))!,\n        ), kernel_dependent.lambda(\n          kernel_dependent_hol.hypothesis(p),\n          kernel_dependent_hol.holds(dp),\n          kernel_dependent_hol.proof(mut r, premise(1))!,\n        )],\n      ))\n    },\n    \"disch\" => {\n      p := get(st.terms, 0) ?? ct\n      dp := kernel_dependent_hol.term(mut r, p)!\n      dq := kernel_dependent_hol.term(\n        mut r,\n        kernel.conclusion(premise(0)),\n      )!\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.disch\"),\n        [dp, dq, kernel_dependent.lambda(\n          kernel_dependent_hol.hypothesis(p),\n          kernel_dependent_hol.holds(dp),\n          kernel_dependent_hol.proof(mut r, premise(0))!,\n        )],\n      ))\n    },\n    \"mp\" => {\n      (p, q) := kernel.split_connective(\"==>\", kernel.conclusion(premise(0))) ?? (ct, ct)\n      Ok(kernel_dependent_hol.at(kernel_dependent_hol.c(\"hol.mp\"), [\n        kernel_dependent_hol.term(mut r, p)!,\n        kernel_dependent_hol.term(mut r, q)!,\n        kernel_dependent_hol.proof(mut r, premise(0))!,\n        kernel_dependent_hol.proof(mut r, premise(1))!,\n      ]))\n    },\n    \"gen\" => {\n      x := get(st.terms, 0) ?? ct\n      xn := kernel_dependent_hol.variable(mut r, x)\n      (_, lam) := kernel_dependent_hol.split_application(ct)\n      xt := kernel_dependent_hol.type_term(\n        mut r,\n        kernel_dependent_hol.hol_type(x),\n      )!\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"all_intro\"),\n          [\n            xt,\n            kernel_dependent_hol.term(mut r, lam)!,\n            kernel_dependent.lambda(\n              xn,\n              xt,\n              kernel_dependent_hol.proof(mut r, premise(0))!,\n            ),\n          ],\n        ),\n      )\n    },\n    \"spec\" => {\n      t := get(st.terms, 0) ?? ct\n      (_, lam) := kernel_dependent_hol.split_application(\n        kernel.conclusion(premise(0)),\n      )\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"all_elim\"),\n          [\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.hol_type(t),\n            )!,\n            kernel_dependent_hol.term(mut r, lam)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.term(mut r, t)!,\n          ],\n        ),\n      )\n    },\n    \"inst\" => {\n      inner := kernel_dependent_hol.proof(mut r, premise(0))!\n      mut s := []\n      for (v, u) in st.substitution {\n        mut s.push(\n          (\n            kernel_dependent_hol.variable(mut r, v),\n            kernel_dependent_hol.term(mut r, u)!,\n          ),\n        )\n      }\n      for (i, h) in enumerate(kernel.assumptions(premise(0))) {\n        mut s.push(\n          (\n            kernel_dependent_hol.hypothesis(h),\n            kernel_dependent.Free(kernel_dependent_hol.hypothesis(\n              get(kernel.assumptions(th), i) ?? h,\n            )),\n          ),\n        )\n      }\n      Ok(kernel_dependent_hol.substitute(inner, s))\n    },\n    \"inst_type\" => {\n      inner := kernel_dependent_hol.proof(mut r, premise(0))!\n      mut s := []\n      for (v, t) in st.types {\n        mut s.push((\"'\" + v, kernel_dependent_hol.type_term(mut r, t)!))\n      }\n      for n in kernel_dependent_hol.free_names(inner) {\n        match get(r.vars, n) {\n          Some(kernel.Variable { name, value_type }) => {\n            nv := kernel.Variable {\n              name,\n              value_type: kernel.substitute_types(value_type, st.types),\n            }\n            mut s.push(\n              (n, kernel_dependent.Free(\n                kernel_dependent_hol.variable(mut r, nv),\n              )),\n            )\n          },\n          _ => (),\n        }\n      }\n      for (i, h) in enumerate(kernel.assumptions(premise(0))) {\n        mut s.push(\n          (\n            kernel_dependent_hol.hypothesis(h),\n            kernel_dependent.Free(kernel_dependent_hol.hypothesis(\n              get(kernel.assumptions(th), i) ?? h,\n            )),\n          ),\n        )\n      }\n      Ok(kernel_dependent_hol.substitute(inner, s))\n    },\n    \"induction\" | \"recursion\" | \"cases\" | \"injective\" | \"distinct\" => kernel_dependent_hol.datatype_fact(mut r, st, th),\n    _ => Err(\"no replay for the rule `\" + rule + \"`\"),\n  }\n}"}]}
{"id":"32d5fefc720b07b3","time":1795852574,"message":"edit","changes":[{"name":"kernel_dependent_hol.type_term","kind":"fn","old":"122d3bee20e865e3","new":"3e3a36d4800a665a","interface_changed":false,"affected":[],"module":"kernel_dependent_hol","text":"// ---- types and terms ----\n\npub fn type_term(\n  mut r: kernel_dependent_hol.Replay,\n  t: kernel.Type,\n) -> Result[kernel_dependent_hol.D, String] {\n  match t {\n    kernel.TypeVariable(v) => Ok(kernel_dependent.Free(\"'\" + v)),\n    kernel.TypeApplication { name, arguments } => {\n      mut args := []\n      for a in arguments {\n        mut args.push(kernel_dependent_hol.type_term(mut r, a)!)\n      }\n      match name {\n        \"Function\" => Ok(kernel_dependent_hol.arrow(\n          get(args, 0) ?? kernel_dependent_hol.bool(),\n          get(args, 1) ?? kernel_dependent_hol.bool(),\n        )),\n        \"bool\" => Ok(kernel_dependent_hol.bool()),\n        \"int\" => Ok(kernel_dependent_hol.c(\"Int\")),\n        _ => {\n          if get(r.groups, name) is Some {\n            kernel_dependent_hol.define_group(mut r, name)!\n          } else if kernel_dependent.lookup(r.env, \"t.\" + name) == None {\n            r.env = kernel_dependent.declare(\n              r.env,\n              \"t.\" + name,\n              kernel_dependent.Sort(0),\n            )!\n          }\n          Ok(kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"t.\" + name),\n            args,\n          ))\n        },\n      }\n    },\n  }\n}","old_text":"// ---- types and terms ----\n\npub fn type_term(\n  mut r: kernel_dependent_hol.Replay,\n  t: kernel.Type,\n) -> Result[kernel_dependent_hol.D, String] {\n  match t {\n    kernel.TypeVariable(v) => Ok(kernel_dependent.Free(\"'\" + v)),\n    kernel.TypeApplication { name, arguments } => {\n      mut args := []\n      for a in arguments {\n        mut args.push(kernel_dependent_hol.type_term(mut r, a)!)\n      }\n      match name {\n        \"Function\" => Ok(kernel_dependent_hol.arrow(\n          get(args, 0) ?? kernel_dependent_hol.bool(),\n          get(args, 1) ?? kernel_dependent_hol.bool(),\n        )),\n        \"bool\" => Ok(kernel_dependent_hol.bool()),\n        \"int\" => Ok(kernel_dependent_hol.c(\"Int\")),\n        _ => {\n          if get(r.groups, name) is Some {\n            kernel_dependent_hol.define_group(mut r, name)!\n          } else if kernel_dependent.lookup(r.env, \"h.\" + name) == None {\n            r.env = kernel_dependent.declare(\n              r.env,\n              \"h.\" + name,\n              kernel_dependent.Sort(0),\n            )!\n          }\n          Ok(kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"h.\" + name),\n            args,\n          ))\n        },\n      }\n    },\n  }\n}"},{"name":"kernel_dependent_hol.define_group","kind":"fn","old":"b5d2753bebcad213","new":"e6ccc784163912b5","interface_changed":false,"affected":[],"module":"kernel_dependent_hol","text":"// ---- datatypes ----\n\nfn define_group(\n  mut r: kernel_dependent_hol.Replay,\n  name: String,\n) -> Result[(), String] {\n  specs := get(r.groups, name) ?? []\n  first := (get(specs, 0) ?? kernel.DatatypeSpec { name, params: [], ctors: [] }).name\n  if contains(r.defined_groups, first) {\n    return Ok(())\n  }\n  mut r.defined_groups.push(first)\n  params := (get(specs, 0) ?? kernel.DatatypeSpec { name, params: [], ctors: [] }).params\n  ps := params.map(p -> (\"'\" + p, kernel_dependent.Sort(0)))\n  pvars := params.map(p -> kernel_dependent.Free(\"'\" + p))\n  hol_params := params.map(p -> kernel.TypeVariable(p))\n  mut types := []\n  for s in specs {\n    self := kernel_dependent_hol.at(\n      kernel_dependent_hol.c(\"t.\" + s.name),\n      pvars,\n    )\n    mut ctors := []\n    for (cn, args) in s.ctors {\n      mut targs := []\n      for (i, a) in enumerate(args) {\n        mut targs.push(\n          (\n            \"x\" + to_string(i),\n            kernel_dependent_hol.type_term_in_group(\n              mut r,\n              a,\n              specs,\n              pvars,\n            )!,\n          ),\n        )\n      }\n      mut ctors.push(\n        (\"h.\" + cn, kernel_dependent_hol.pis(ps + targs, self)),\n      )\n    }\n    mut types.push(\n      (\n        \"t.\" + s.name,\n        kernel_dependent_hol.pis(ps, kernel_dependent.Sort(0)),\n        ctors,\n      ),\n    )\n  }\n  r.env = kernel_dependent.add_inductives(r.env, len(params), types)!\n  names := specs.map(s -> s.name)\n  tys := names.map(\n    n -> kernel.TypeApplication { name: n, arguments: hol_params },\n  )\n  rs := enumerate(names).map(\n    p -> kernel.TypeVariable(\"#r\" + to_string(p.0)),\n  )\n  res_of := (a: kernel.Type) -> {\n    mut out := a\n    for (i, t) in enumerate(tys) {\n      if t == a {\n        out = get(rs, i) ?? a\n      }\n    }\n    out\n  }\n  // the constructors, then `rec_T` and `case_T` as the HOL kernel's\n  mut case_tys := []\n  for s in specs {\n    t := kernel.TypeApplication { name: s.name, arguments: hol_params }\n    for (cn, args) in s.ctors {\n      mut r.consts.insert(\n        cn,\n        (params, kernel.function_type_of(args, t)),\n      )\n      mut case_tys.push(\n        kernel.function_type_of(args\n          + args.filter(a -> contains(tys, a)).map(a -> res_of(a)), res_of(t)),\n      )\n    }\n  }\n  rvars := enumerate(names).map(\n    p -> (\"'#r\" + to_string(p.0), kernel_dependent.Sort(0)),\n  )\n  for (k, s) in enumerate(specs) {\n    t := kernel.TypeApplication { name: s.name, arguments: hol_params }\n    rk := get(rs, k) ?? t\n    // rec_T\n    mut fs := []\n    for (i, ct) in enumerate(case_tys) {\n      mut fs.push(\n        (\n          \"f\" + to_string(i),\n          kernel_dependent_hol.type_term(mut r, ct)!,\n        ),\n      )\n    }\n    self := kernel_dependent_hol.at(\n      kernel_dependent_hol.c(\"t.\" + s.name),\n      pvars,\n    )\n    motives := enumerate(specs).map(\n      p -> kernel_dependent.lambda(\"_x\", kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"t.\" + p.1.name),\n        pvars,\n      ), kernel_dependent.Free(\"'#r\" + to_string(p.0))),\n    )\n    rec_value := kernel_dependent_hol.lams(\n      ps + rvars + fs + [(\"x\", self)],\n      kernel_dependent_hol.at(kernel_dependent.Constant {\n        name: \"t.\" + s.name + \".rec\",\n        levels: [0],\n      }, pvars\n        + motives\n        + fs.map(f -> kernel_dependent.Free(f.0))\n        + [kernel_dependent.Free(\"x\")]),\n    )\n    rec_type := kernel_dependent_hol.pis(\n      ps + rvars + fs + [(\"x\", self)],\n      kernel_dependent.Free(\"'#r\" + to_string(k)),\n    )\n    r.env = kernel_dependent.define(\n      r.env,\n      \"h.rec_\" + s.name,\n      rec_type,\n      rec_value,\n    )!\n    mut r.consts.insert(\n      \"rec_\" + s.name,\n      (params\n        + names.map(\n          n ->\n            \"#r\"\n              + to_string(kernel_dependent_hol.index_of(names, n)),\n        ), kernel.function_type_of(case_tys + [t], rk)),\n    )\n    // case_T\n    sres := kernel_dependent.Free(\"'#s\")\n    mut gs := []\n    for (i, (_, args)) in enumerate(s.ctors) {\n      mut gs.push(\n        (\"g\" + to_string(i), kernel_dependent_hol.type_term(\n          mut r,\n          kernel.function_type_of(args, kernel.TypeVariable(\"#s\")),\n        )!),\n      )\n    }\n    trivial := kernel_dependent_hol.holds(kernel_dependent_hol.c(\"true\"))\n    case_motives := enumerate(specs).map(\n      p -> kernel_dependent.lambda(\"_x\", kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"t.\" + p.1.name),\n        pvars,\n      ), if p.0 == k {\n        sres\n      } else {\n        trivial\n      }),\n    )\n    mut minors := []\n    for (q, sp) in enumerate(specs) {\n      for (i, (_, args)) in enumerate(sp.ctors) {\n        mut xs := []\n        for (n, a) in enumerate(args) {\n          mut xs.push(\n            (\n              \"y\" + to_string(n),\n              kernel_dependent_hol.type_term_in_group(\n                mut r,\n                a,\n                specs,\n                pvars,\n              )!,\n            ),\n          )\n        }\n        mut ihs := []\n        for (n, a) in enumerate(args) {\n          if contains(tys, a) {\n            mut ihs.push(\n              (\n                \"ih\" + to_string(n),\n                if kernel_dependent_hol.index_of_type(tys, a) == k {\n                  sres\n                } else {\n                  trivial\n                },\n              ),\n            )\n          }\n        }\n        body := if q == k {\n          kernel_dependent_hol.at(\n            kernel_dependent.Free(\"g\" + to_string(i)),\n            xs.map(x -> kernel_dependent.Free(x.0)),\n          )\n        } else {\n          kernel_dependent.reflexivity(\n            0,\n            kernel_dependent_hol.bool(),\n            kernel_dependent_hol.c(\"true\"),\n          )\n        }\n        mut minors.push(kernel_dependent_hol.lams(xs + ihs, body))\n      }\n    }\n    case_value := kernel_dependent_hol.lams(\n      ps + [(\"'#s\", kernel_dependent.Sort(0))] + gs + [(\"x\", self)],\n      kernel_dependent_hol.at(kernel_dependent.Constant {\n        name: \"t.\" + s.name + \".rec\",\n        levels: [0],\n      }, pvars + case_motives + minors + [kernel_dependent.Free(\"x\")]),\n    )\n    case_type := kernel_dependent_hol.pis(\n      ps + [(\"'#s\", kernel_dependent.Sort(0))] + gs + [(\"x\", self)],\n      sres,\n    )\n    r.env = kernel_dependent.define(\n      r.env,\n      \"h.case_\" + s.name,\n      case_type,\n      case_value,\n    )!\n    mut r.consts.insert(\n      \"case_\" + s.name,\n      (params + [\"#s\"], kernel.function_type_of(s.ctors.map(\n          p ->\n            kernel.function_type_of(p.1, kernel.TypeVariable(\"#s\")),\n        )\n        + [t], kernel.TypeVariable(\"#s\"))),\n    )\n  }\n  Ok(())\n}","old_text":"// ---- datatypes ----\n\nfn define_group(\n  mut r: kernel_dependent_hol.Replay,\n  name: String,\n) -> Result[(), String] {\n  specs := get(r.groups, name) ?? []\n  first := (get(specs, 0) ?? kernel.DatatypeSpec { name, params: [], ctors: [] }).name\n  if contains(r.defined_groups, first) {\n    return Ok(())\n  }\n  mut r.defined_groups.push(first)\n  params := (get(specs, 0) ?? kernel.DatatypeSpec { name, params: [], ctors: [] }).params\n  ps := params.map(p -> (\"'\" + p, kernel_dependent.Sort(0)))\n  pvars := params.map(p -> kernel_dependent.Free(\"'\" + p))\n  hol_params := params.map(p -> kernel.TypeVariable(p))\n  mut types := []\n  for s in specs {\n    self := kernel_dependent_hol.at(\n      kernel_dependent_hol.c(\"h.\" + s.name),\n      pvars,\n    )\n    mut ctors := []\n    for (cn, args) in s.ctors {\n      mut targs := []\n      for (i, a) in enumerate(args) {\n        mut targs.push(\n          (\n            \"x\" + to_string(i),\n            kernel_dependent_hol.type_term_in_group(\n              mut r,\n              a,\n              specs,\n              pvars,\n            )!,\n          ),\n        )\n      }\n      mut ctors.push(\n        (\"h.\" + cn, kernel_dependent_hol.pis(ps + targs, self)),\n      )\n    }\n    mut types.push(\n      (\n        \"h.\" + s.name,\n        kernel_dependent_hol.pis(ps, kernel_dependent.Sort(0)),\n        ctors,\n      ),\n    )\n  }\n  r.env = kernel_dependent.add_inductives(r.env, len(params), types)!\n  names := specs.map(s -> s.name)\n  tys := names.map(\n    n -> kernel.TypeApplication { name: n, arguments: hol_params },\n  )\n  rs := enumerate(names).map(\n    p -> kernel.TypeVariable(\"#r\" + to_string(p.0)),\n  )\n  res_of := (a: kernel.Type) -> {\n    mut out := a\n    for (i, t) in enumerate(tys) {\n      if t == a {\n        out = get(rs, i) ?? a\n      }\n    }\n    out\n  }\n  // the constructors, then `rec_T` and `case_T` as the HOL kernel's\n  mut case_tys := []\n  for s in specs {\n    t := kernel.TypeApplication { name: s.name, arguments: hol_params }\n    for (cn, args) in s.ctors {\n      mut r.consts.insert(\n        cn,\n        (params, kernel.function_type_of(args, t)),\n      )\n      mut case_tys.push(\n        kernel.function_type_of(args\n          + args.filter(a -> contains(tys, a)).map(a -> res_of(a)), res_of(t)),\n      )\n    }\n  }\n  rvars := enumerate(names).map(\n    p -> (\"'#r\" + to_string(p.0), kernel_dependent.Sort(0)),\n  )\n  for (k, s) in enumerate(specs) {\n    t := kernel.TypeApplication { name: s.name, arguments: hol_params }\n    rk := get(rs, k) ?? t\n    // rec_T\n    mut fs := []\n    for (i, ct) in enumerate(case_tys) {\n      mut fs.push(\n        (\n          \"f\" + to_string(i),\n          kernel_dependent_hol.type_term(mut r, ct)!,\n        ),\n      )\n    }\n    self := kernel_dependent_hol.at(\n      kernel_dependent_hol.c(\"h.\" + s.name),\n      pvars,\n    )\n    motives := enumerate(specs).map(\n      p -> kernel_dependent.lambda(\"_x\", kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"h.\" + p.1.name),\n        pvars,\n      ), kernel_dependent.Free(\"'#r\" + to_string(p.0))),\n    )\n    rec_value := kernel_dependent_hol.lams(\n      ps + rvars + fs + [(\"x\", self)],\n      kernel_dependent_hol.at(kernel_dependent.Constant {\n        name: \"h.\" + s.name + \".rec\",\n        levels: [0],\n      }, pvars\n        + motives\n        + fs.map(f -> kernel_dependent.Free(f.0))\n        + [kernel_dependent.Free(\"x\")]),\n    )\n    rec_type := kernel_dependent_hol.pis(\n      ps + rvars + fs + [(\"x\", self)],\n      kernel_dependent.Free(\"'#r\" + to_string(k)),\n    )\n    r.env = kernel_dependent.define(\n      r.env,\n      \"h.rec_\" + s.name,\n      rec_type,\n      rec_value,\n    )!\n    mut r.consts.insert(\n      \"rec_\" + s.name,\n      (params\n        + names.map(\n          n ->\n            \"#r\"\n              + to_string(kernel_dependent_hol.index_of(names, n)),\n        ), kernel.function_type_of(case_tys + [t], rk)),\n    )\n    // case_T\n    sres := kernel_dependent.Free(\"'#s\")\n    mut gs := []\n    for (i, (_, args)) in enumerate(s.ctors) {\n      mut gs.push(\n        (\"g\" + to_string(i), kernel_dependent_hol.type_term(\n          mut r,\n          kernel.function_type_of(args, kernel.TypeVariable(\"#s\")),\n        )!),\n      )\n    }\n    trivial := kernel_dependent_hol.holds(kernel_dependent_hol.c(\"true\"))\n    case_motives := enumerate(specs).map(\n      p -> kernel_dependent.lambda(\"_x\", kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"h.\" + p.1.name),\n        pvars,\n      ), if p.0 == k {\n        sres\n      } else {\n        trivial\n      }),\n    )\n    mut minors := []\n    for (q, sp) in enumerate(specs) {\n      for (i, (_, args)) in enumerate(sp.ctors) {\n        mut xs := []\n        for (n, a) in enumerate(args) {\n          mut xs.push(\n            (\n              \"y\" + to_string(n),\n              kernel_dependent_hol.type_term_in_group(\n                mut r,\n                a,\n                specs,\n                pvars,\n              )!,\n            ),\n          )\n        }\n        mut ihs := []\n        for (n, a) in enumerate(args) {\n          if contains(tys, a) {\n            mut ihs.push(\n              (\n                \"ih\" + to_string(n),\n                if kernel_dependent_hol.index_of_type(tys, a) == k {\n                  sres\n                } else {\n                  trivial\n                },\n              ),\n            )\n          }\n        }\n        body := if q == k {\n          kernel_dependent_hol.at(\n            kernel_dependent.Free(\"g\" + to_string(i)),\n            xs.map(x -> kernel_dependent.Free(x.0)),\n          )\n        } else {\n          kernel_dependent.reflexivity(\n            0,\n            kernel_dependent_hol.bool(),\n            kernel_dependent_hol.c(\"true\"),\n          )\n        }\n        mut minors.push(kernel_dependent_hol.lams(xs + ihs, body))\n      }\n    }\n    case_value := kernel_dependent_hol.lams(\n      ps + [(\"'#s\", kernel_dependent.Sort(0))] + gs + [(\"x\", self)],\n      kernel_dependent_hol.at(kernel_dependent.Constant {\n        name: \"h.\" + s.name + \".rec\",\n        levels: [0],\n      }, pvars + case_motives + minors + [kernel_dependent.Free(\"x\")]),\n    )\n    case_type := kernel_dependent_hol.pis(\n      ps + [(\"'#s\", kernel_dependent.Sort(0))] + gs + [(\"x\", self)],\n      sres,\n    )\n    r.env = kernel_dependent.define(\n      r.env,\n      \"h.case_\" + s.name,\n      case_type,\n      case_value,\n    )!\n    mut r.consts.insert(\n      \"case_\" + s.name,\n      (params + [\"#s\"], kernel.function_type_of(s.ctors.map(\n          p ->\n            kernel.function_type_of(p.1, kernel.TypeVariable(\"#s\")),\n        )\n        + [t], kernel.TypeVariable(\"#s\"))),\n    )\n  }\n  Ok(())\n}"},{"name":"kernel_dependent_hol.type_term_in_group","kind":"fn","old":"48839fcb7bc85d5f","new":"9ea339acd76370c1","interface_changed":false,"affected":[],"module":"kernel_dependent_hol","text":"/// A constructor argument's type while its group is defined: the group's\n/// own types by name, the rest as usual.\nfn type_term_in_group(\n  mut r: kernel_dependent_hol.Replay,\n  t: kernel.Type,\n  specs: List[kernel.DatatypeSpec],\n  pvars: List[kernel_dependent_hol.D],\n) -> Result[kernel_dependent_hol.D, String] {\n  match t {\n    kernel.TypeApplication { name, .. } => if specs.any(s -> s.name == name) {\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"t.\" + name),\n        pvars,\n      ))\n    } else {\n      kernel_dependent_hol.type_term(mut r, t)\n    },\n    _ => kernel_dependent_hol.type_term(mut r, t),\n  }\n}","old_text":"/// A constructor argument's type while its group is defined: the group's\n/// own types by name, the rest as usual.\nfn type_term_in_group(\n  mut r: kernel_dependent_hol.Replay,\n  t: kernel.Type,\n  specs: List[kernel.DatatypeSpec],\n  pvars: List[kernel_dependent_hol.D],\n) -> Result[kernel_dependent_hol.D, String] {\n  match t {\n    kernel.TypeApplication { name, .. } => if specs.any(s -> s.name == name) {\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"h.\" + name),\n        pvars,\n      ))\n    } else {\n      kernel_dependent_hol.type_term(mut r, t)\n    },\n    _ => kernel_dependent_hol.type_term(mut r, t),\n  }\n}"},{"name":"kernel_dependent_hol.induction","kind":"fn","old":"0e9f9ec947e129c5","new":"df94bbc8a6b40001","interface_changed":false,"affected":[],"module":"kernel_dependent_hol","text":"/// The group's induction: under its `P`s and steps, each type's `all` by\n/// its recursor, each case from its step (`all_elim` on the arguments,\n/// `hol.mp` on the hypotheses).\nfn induction(\n  mut r: kernel_dependent_hol.Replay,\n  g: kernel_dependent_tactics.Goal,\n  ct: kernel.Term,\n  st: kernel.Step,\n) -> Result[kernel_dependent_hol.D, String] {\n  _ := ct\n  spec0 := get(st.specs, 0) ?? kernel.DatatypeSpec { name: \"\", params: [], ctors: [] }\n  params := spec0.params.map(p -> kernel_dependent.Free(\"'\" + p))\n  first := kernel_dependent.inductive_named(r.env, \"t.\" + spec0.name) or {\n    return Err(\"induction: the group isn't defined\")\n  }\n  group := first.group\n  kernel_dependent_hol.under_all(\n    g,\n    (gl: kernel_dependent_tactics.Goal) -> {\n      // the P's are the context's newest variables, in group order\n      ps := take(gl.context, len(group))\n        .reversed()\n        .map(p -> kernel_dependent.Free(p.0))\n      mut steps := []\n      mut rest := kernel_dependent_hol.beta(\n        kernel_dependent_hol.holds_of(gl.target),\n      )\n      mut going := true\n      while going {\n        match kernel_dependent.spine(rest) {\n          (kernel_dependent.Constant { name: \"implies\", .. }, [s, q]) => if len(steps) < kernel_dependent_hol.total_constructors(gl.env, group) {\n            mut steps.push(s)\n            rest = q\n          } else {\n            going = false\n          },\n          _ => {\n            going = false\n          },\n        }\n      }\n      motives := enumerate(group).map(\n        p -> kernel_dependent.lambda(\n          \"#x\",\n          kernel_dependent_hol.at(\n            kernel_dependent_hol.c(p.1),\n            params,\n          ),\n          kernel_dependent_hol.holds(kernel_dependent.Apply {\n            function: get(ps, p.0) ?? kernel_dependent_hol.bool(),\n            argument: kernel_dependent.Free(\"#x\"),\n          }),\n        ),\n      )\n      mut minors := []\n      mut idx := 0\n      for (k, n) in enumerate(group) {\n        member := kernel_dependent.inductive_named(gl.env, n) ?? first\n        _ := k\n        for ctr in member.constructors {\n          cty := kernel_dependent.infer(\n            gl.env,\n            gl.context,\n            kernel_dependent_hol.at(\n              kernel_dependent_hol.c(ctr.name),\n              params,\n            ),\n          )!\n          (args, _) := kernel_dependent.peel(cty, -1, \"#y\")\n          mut ihs := []\n          for (q, a) in enumerate(args) {\n            rk := get(ctr.recursive, q) ?? -1\n            if rk >= 0 {\n              mut ihs.push(\n                (\n                  \"#ih\" + to_string(q),\n                  kernel_dependent_hol.holds(\n                    kernel_dependent.Apply {\n                      function: get(ps, rk) ?? kernel_dependent_hol.bool(),\n                      argument: kernel_dependent.Free(a.0),\n                    },\n                  ),\n                ),\n              )\n            }\n          }\n          // the step: `all` per argument, then `implies` per hypothesis\n          mut prf := kernel_dependent.Free(\"#step\" + to_string(idx))\n          mut stmt := get(steps, idx) ?? kernel_dependent_hol.bool()\n          for a in args {\n            match kernel_dependent.spine(kernel_dependent_hol.beta(stmt)) {\n              (kernel_dependent.Constant { name: \"all\", .. }, [a_type, pred]) => {\n                prf = kernel_dependent_hol.at(\n                  kernel_dependent_hol.c(\"all_elim\"),\n                  [a_type, pred, prf, kernel_dependent.Free(a.0)],\n                )\n                stmt = kernel_dependent_hol.beta(kernel_dependent.Apply {\n                  function: pred,\n                  argument: kernel_dependent.Free(a.0),\n                })\n              },\n              _ => return Err(\"induction: a step's arguments\"),\n            }\n          }\n          for (hname, _) in ihs {\n            match kernel_dependent.spine(kernel_dependent_hol.beta(stmt)) {\n              (kernel_dependent.Constant { name: \"implies\", .. }, [p, q]) => {\n                prf = kernel_dependent_hol.at(\n                  kernel_dependent_hol.c(\"hol.mp\"),\n                  [p, q, prf, kernel_dependent.Free(hname)],\n                )\n                stmt = q\n              },\n              _ => return Err(\"induction: a step's hypotheses\"),\n            }\n          }\n          mut minors.push(kernel_dependent_hol.lams(args + ihs, prf))\n          idx += 1\n        }\n      }\n      mut alls := []\n      for (k, n) in enumerate(group) {\n        self := kernel_dependent_hol.at(kernel_dependent_hol.c(n), params)\n        pk := get(ps, k) ?? kernel_dependent_hol.bool()\n        mut alls.push(\n          (kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"all\"),\n            [self, pk],\n          ), kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"all_intro\"),\n            [self, pk, kernel_dependent.lambda(\n              \"#x\",\n              self,\n              kernel_dependent_hol.at(kernel_dependent.Constant {\n                name: n + \".rec\",\n                levels: [0],\n              }, params\n                + motives\n                + minors\n                + [kernel_dependent.Free(\"#x\")]),\n            )],\n          )),\n        )\n      }\n      mut out := kernel_dependent_hol.conjunction(alls)\n      for (i, s) in enumerate(steps).reversed() {\n        after := kernel_dependent_hol.implications(\n          drop(steps, i + 1),\n          kernel_dependent_hol.conjunction_statement(\n            alls.map(a -> a.0),\n          ),\n        )\n        out = kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.disch\"),\n          [s, after, kernel_dependent.lambda(\n            \"#step\" + to_string(i),\n            kernel_dependent_hol.holds(s),\n            out,\n          )],\n        )\n      }\n      kernel_dependent_tactics.exact(gl, out)\n    },\n  )\n}","old_text":"/// The group's induction: under its `P`s and steps, each type's `all` by\n/// its recursor, each case from its step (`all_elim` on the arguments,\n/// `hol.mp` on the hypotheses).\nfn induction(\n  mut r: kernel_dependent_hol.Replay,\n  g: kernel_dependent_tactics.Goal,\n  ct: kernel.Term,\n  st: kernel.Step,\n) -> Result[kernel_dependent_hol.D, String] {\n  _ := ct\n  spec0 := get(st.specs, 0) ?? kernel.DatatypeSpec { name: \"\", params: [], ctors: [] }\n  params := spec0.params.map(p -> kernel_dependent.Free(\"'\" + p))\n  first := kernel_dependent.inductive_named(r.env, \"h.\" + spec0.name) or {\n    return Err(\"induction: the group isn't defined\")\n  }\n  group := first.group\n  kernel_dependent_hol.under_all(\n    g,\n    (gl: kernel_dependent_tactics.Goal) -> {\n      // the P's are the context's newest variables, in group order\n      ps := take(gl.context, len(group))\n        .reversed()\n        .map(p -> kernel_dependent.Free(p.0))\n      mut steps := []\n      mut rest := kernel_dependent_hol.beta(\n        kernel_dependent_hol.holds_of(gl.target),\n      )\n      mut going := true\n      while going {\n        match kernel_dependent.spine(rest) {\n          (kernel_dependent.Constant { name: \"implies\", .. }, [s, q]) => if len(steps) < kernel_dependent_hol.total_constructors(gl.env, group) {\n            mut steps.push(s)\n            rest = q\n          } else {\n            going = false\n          },\n          _ => {\n            going = false\n          },\n        }\n      }\n      motives := enumerate(group).map(\n        p -> kernel_dependent.lambda(\n          \"#x\",\n          kernel_dependent_hol.at(\n            kernel_dependent_hol.c(p.1),\n            params,\n          ),\n          kernel_dependent_hol.holds(kernel_dependent.Apply {\n            function: get(ps, p.0) ?? kernel_dependent_hol.bool(),\n            argument: kernel_dependent.Free(\"#x\"),\n          }),\n        ),\n      )\n      mut minors := []\n      mut idx := 0\n      for (k, n) in enumerate(group) {\n        member := kernel_dependent.inductive_named(gl.env, n) ?? first\n        _ := k\n        for ctr in member.constructors {\n          cty := kernel_dependent.infer(\n            gl.env,\n            gl.context,\n            kernel_dependent_hol.at(\n              kernel_dependent_hol.c(ctr.name),\n              params,\n            ),\n          )!\n          (args, _) := kernel_dependent.peel(cty, -1, \"#y\")\n          mut ihs := []\n          for (q, a) in enumerate(args) {\n            rk := get(ctr.recursive, q) ?? -1\n            if rk >= 0 {\n              mut ihs.push(\n                (\n                  \"#ih\" + to_string(q),\n                  kernel_dependent_hol.holds(\n                    kernel_dependent.Apply {\n                      function: get(ps, rk) ?? kernel_dependent_hol.bool(),\n                      argument: kernel_dependent.Free(a.0),\n                    },\n                  ),\n                ),\n              )\n            }\n          }\n          // the step: `all` per argument, then `implies` per hypothesis\n          mut prf := kernel_dependent.Free(\"#step\" + to_string(idx))\n          mut stmt := get(steps, idx) ?? kernel_dependent_hol.bool()\n          for a in args {\n            match kernel_dependent.spine(kernel_dependent_hol.beta(stmt)) {\n              (kernel_dependent.Constant { name: \"all\", .. }, [a_type, pred]) => {\n                prf = kernel_dependent_hol.at(\n                  kernel_dependent_hol.c(\"all_elim\"),\n                  [a_type, pred, prf, kernel_dependent.Free(a.0)],\n                )\n                stmt = kernel_dependent_hol.beta(kernel_dependent.Apply {\n                  function: pred,\n                  argument: kernel_dependent.Free(a.0),\n                })\n              },\n              _ => return Err(\"induction: a step's arguments\"),\n            }\n          }\n          for (hname, _) in ihs {\n            match kernel_dependent.spine(kernel_dependent_hol.beta(stmt)) {\n              (kernel_dependent.Constant { name: \"implies\", .. }, [p, q]) => {\n                prf = kernel_dependent_hol.at(\n                  kernel_dependent_hol.c(\"hol.mp\"),\n                  [p, q, prf, kernel_dependent.Free(hname)],\n                )\n                stmt = q\n              },\n              _ => return Err(\"induction: a step's hypotheses\"),\n            }\n          }\n          mut minors.push(kernel_dependent_hol.lams(args + ihs, prf))\n          idx += 1\n        }\n      }\n      mut alls := []\n      for (k, n) in enumerate(group) {\n        self := kernel_dependent_hol.at(kernel_dependent_hol.c(n), params)\n        pk := get(ps, k) ?? kernel_dependent_hol.bool()\n        mut alls.push(\n          (kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"all\"),\n            [self, pk],\n          ), kernel_dependent_hol.at(\n            kernel_dependent_hol.c(\"all_intro\"),\n            [self, pk, kernel_dependent.lambda(\n              \"#x\",\n              self,\n              kernel_dependent_hol.at(kernel_dependent.Constant {\n                name: n + \".rec\",\n                levels: [0],\n              }, params\n                + motives\n                + minors\n                + [kernel_dependent.Free(\"#x\")]),\n            )],\n          )),\n        )\n      }\n      mut out := kernel_dependent_hol.conjunction(alls)\n      for (i, s) in enumerate(steps).reversed() {\n        after := kernel_dependent_hol.implications(\n          drop(steps, i + 1),\n          kernel_dependent_hol.conjunction_statement(\n            alls.map(a -> a.0),\n          ),\n        )\n        out = kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.disch\"),\n          [s, after, kernel_dependent.lambda(\n            \"#step\" + to_string(i),\n            kernel_dependent_hol.holds(s),\n            out,\n          )],\n        )\n      }\n      kernel_dependent_tactics.exact(gl, out)\n    },\n  )\n}"}]}
{"id":"4e4f68d3de4af15d","time":1795853161,"message":"new kernel_dependent_records","changes":[{"name":"kernel_dependent_records.use ast","kind":"use","old":null,"new":"477148ad2f21906b","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"// kernel_dependent_records: a module's laws for every record (`lemma\n// l[T: Record]`) translated from its syntax tree into the dependent kernel,\n// untrusted. `T` is a schema: its fields `F`, each field's type `ty f`,\n// field names decided (`deq`), the list `fs` (`T.fields`) and that it has\n// every field (`all`). A type function (`type Patch[T: Record] = …`), the\n// blanket impl's methods (`T.make`, `comptime for f in T.fields`, `x.(f.name)`,\n// `match`), the laws' statements and their steps are each translated, then\n// checked; the laws hold at each record of the module by application.\n\nuse ast"},{"name":"kernel_dependent_records.use kernel_dependent","kind":"use","old":null,"new":"be014a5c23036736","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"use kernel_dependent"},{"name":"kernel_dependent_records.use kernel_dependent_tactics","kind":"use","old":null,"new":"35e225f3bea5d826","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"use kernel_dependent_tactics"},{"name":"kernel_dependent_records.use kernel_dependent_patch","kind":"use","old":null,"new":"539bbe234a392ee8","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"use kernel_dependent_patch"},{"name":"kernel_dependent_records.use std.time","kind":"use","old":null,"new":"8326ab15ac7645bb","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"from std.time use SystemClock, Clock"},{"name":"kernel_dependent_records.Records","kind":"type","old":null,"new":"c75a4e8a0c6c08b6","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"/// The translation's state: the environment, each type function's default\n/// field constructor, the impl's methods (`mut self` ones as functions),\n/// the laws proven, each with its time and term size, and each law's\n/// instance at each record of the module, with its statement.\npub type Records = {\n  env: kernel_dependent.Environment,\n  defaults: Dict[String, String],\n  methods: List[String],\n  updating: List[String],\n  proven: List[(String, Int, Int)],\n  instances: List[(String, String)],\n}"},{"name":"kernel_dependent_records.D","kind":"type","old":null,"new":"39ca4e23b1c56924","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"type D = kernel_dependent.Term"},{"name":"kernel_dependent_records.Scope","kind":"type","old":null,"new":"4d28751976206f29","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"/// What an expression is translated in: the variables by name, and the\n/// field a `comptime for` or `T.make` is at.\ntype Scope = {\n  vars: List[(String, kernel_dependent_records.D)],\n  ctx: List[(String, kernel_dependent_records.D)],\n  field: String = \"\",\n}"},{"name":"kernel_dependent_records.c","kind":"fn","old":null,"new":"68aaf45ca3b79e99","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"fn c(name: String) -> kernel_dependent_records.D {\n  kernel_dependent.Constant { name, levels: [] }\n}"},{"name":"kernel_dependent_records.v","kind":"fn","old":null,"new":"ea1e8345f3f7d404","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"fn v(name: String) -> kernel_dependent_records.D {\n  kernel_dependent.Free(name)\n}"},{"name":"kernel_dependent_records.at","kind":"fn","old":null,"new":"38290825335b4be0","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"fn at(\n  f: kernel_dependent_records.D,\n  args: List[kernel_dependent_records.D],\n) -> kernel_dependent_records.D {\n  kernel_dependent.applied(f, args)\n}"},{"name":"kernel_dependent_records.app","kind":"fn","old":null,"new":"d9fceddcbe044c04","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"fn app(\n  f: kernel_dependent_records.D,\n  a: kernel_dependent_records.D,\n) -> kernel_dependent_records.D {\n  kernel_dependent.Apply { function: f, argument: a }\n}"},{"name":"kernel_dependent_records.arrow","kind":"fn","old":null,"new":"80138f036ba0f908","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"fn arrow(\n  a: kernel_dependent_records.D,\n  b: kernel_dependent_records.D,\n) -> kernel_dependent_records.D {\n  kernel_dependent.Pi { name: \"_\", domain: a, body: b }\n}"},{"name":"kernel_dependent_records.pis","kind":"fn","old":null,"new":"55c9517cd25366c5","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"fn pis(\n  ps: List[(String, kernel_dependent_records.D)],\n  body: kernel_dependent_records.D,\n) -> kernel_dependent_records.D {\n  mut out := body\n  for (x, d) in ps.reversed() {\n    out = kernel_dependent.pi(x, d, out)\n  }\n  out\n}"},{"name":"kernel_dependent_records.lams","kind":"fn","old":null,"new":"554cda9d1733240f","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"fn lams(\n  ps: List[(String, kernel_dependent_records.D)],\n  body: kernel_dependent_records.D,\n) -> kernel_dependent_records.D {\n  mut out := body\n  for (x, d) in ps.reversed() {\n    out = kernel_dependent.lambda(x, d, out)\n  }\n  out\n}"},{"name":"kernel_dependent_records.t0","kind":"fn","old":null,"new":"eb3dbc766cfd5ceb","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"fn t0() -> kernel_dependent_records.D {\n  kernel_dependent.Sort(0)\n}"},{"name":"kernel_dependent_records.schema","kind":"fn","old":null,"new":"e65054c41bb3f3df","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"/// `F`, `ty`, `deq` and `fs`: the record type every definition is over.\nfn schema() -> List[(String, kernel_dependent_records.D)] {\n  [\n    (\"F\", kernel_dependent_records.t0()),\n    (\"ty\", kernel_dependent_records.arrow(\n      kernel_dependent_records.v(\"F\"),\n      kernel_dependent_records.t0(),\n    )),\n    (\"deq\", kernel_dependent.pi(\n      \"a\",\n      kernel_dependent_records.v(\"F\"),\n      kernel_dependent.pi(\n        \"b\",\n        kernel_dependent_records.v(\"F\"),\n        kernel_dependent_records.app(\n          kernel_dependent_records.c(\"Dec\"),\n          kernel_dependent.equality(\n            0,\n            kernel_dependent_records.v(\"F\"),\n            kernel_dependent_records.v(\"a\"),\n            kernel_dependent_records.v(\"b\"),\n          ),\n        ),\n      ),\n    )),\n    (\"fs\", kernel_dependent_records.app(\n      kernel_dependent_records.c(\"List\"),\n      kernel_dependent_records.v(\"F\"),\n    )),\n  ]\n}"},{"name":"kernel_dependent_records.schema_args","kind":"fn","old":null,"new":"6d980c61fc3221db","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"fn schema_args() -> List[kernel_dependent_records.D] {\n  [\n    kernel_dependent_records.v(\"F\"),\n    kernel_dependent_records.v(\"ty\"),\n    kernel_dependent_records.v(\"deq\"),\n    kernel_dependent_records.v(\"fs\"),\n  ]\n}"},{"name":"kernel_dependent_records.complete","kind":"fn","old":null,"new":"b36fbbc7186ac91e","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"/// `has fs g` is true for every field: what a law may assume of `fs`.\nfn complete() -> (String, kernel_dependent_records.D) {\n  (\"all\", kernel_dependent.pi(\n    \"g\",\n    kernel_dependent_records.v(\"F\"),\n    kernel_dependent.holds(\n      kernel_dependent_records.at(\n        kernel_dependent_records.c(\"has\"),\n        [\n          kernel_dependent_records.v(\"F\"),\n          kernel_dependent_records.v(\"ty\"),\n          kernel_dependent_records.v(\"deq\"),\n          kernel_dependent_records.v(\"fs\"),\n          kernel_dependent_records.v(\"g\"),\n        ],\n      ),\n    ),\n  ))\n}"},{"name":"kernel_dependent_records.record","kind":"fn","old":null,"new":"2a7fd73354a2bb12","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"fn record() -> kernel_dependent_records.D {\n  kernel_dependent.pi(\n    \"rg\",\n    kernel_dependent_records.v(\"F\"),\n    kernel_dependent_records.app(\n      kernel_dependent_records.v(\"ty\"),\n      kernel_dependent_records.v(\"rg\"),\n    ),\n  )\n}"},{"name":"kernel_dependent_records.generic","kind":"fn","old":null,"new":"bc2eb15cc9e50b12","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"fn generic(name: String) -> kernel_dependent_records.D {\n  kernel_dependent_records.at(\n    kernel_dependent_records.c(\"m.\" + name),\n    kernel_dependent_records.schema_args(),\n  )\n}"},{"name":"kernel_dependent_records.type_of","kind":"fn","old":null,"new":"d55e8370da5c93ed","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"// ---- types ----\n\nfn type_of(\n  mut r: kernel_dependent_records.Records,\n  t: ast.TypeExpr,\n  params: List[String],\n) -> Result[kernel_dependent_records.D, String] {\n  match t {\n    ast.Named { name, args } => {\n      if contains(params, name) {\n        return Ok(kernel_dependent_records.v(\"'\" + name))\n      }\n      if name == \"T\" || name == \"Self\" {\n        return Ok(kernel_dependent_records.record())\n      }\n      mut xs := []\n      for a in args {\n        mut xs.push(kernel_dependent_records.type_of(mut r, a, params)!)\n      }\n      match name {\n        \"Int\" | \"Natural\" => Ok(kernel_dependent_records.c(\"Int\")),\n        \"Bool\" => Ok(kernel_dependent_records.c(\"Bool\")),\n        _ => if kernel_dependent.lookup(r.env, \"m.\" + name) != None {\n          if args == [ast.Named { name: \"T\", args: [] }]\n            && get(r.defaults, name) != None {\n            Ok(kernel_dependent_records.generic(name))\n          } else {\n            Ok(kernel_dependent_records.at(\n              kernel_dependent_records.c(\"m.\" + name),\n              xs,\n            ))\n          }\n        } else if xs == [] {\n          if kernel_dependent.lookup(r.env, \"m.\" + name) == None {\n            r.env = kernel_dependent.declare(\n              r.env,\n              \"m.\" + name,\n              kernel_dependent_records.t0(),\n            )!\n          }\n          Ok(kernel_dependent_records.c(\"m.\" + name))\n        } else {\n          Err(\"the type `\" + name + \"` isn't translated\")\n        },\n      }\n    },\n    _ => Err(\"a type that isn't a name\"),\n  }\n}"},{"name":"kernel_dependent_records.add_sum","kind":"fn","old":null,"new":"a8b89cfb23964995","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"/// A sum type of the module as an inductive type `m.T`.\nfn add_sum(\n  mut r: kernel_dependent_records.Records,\n  td: ast.TypeDecl,\n) -> Result[(), String] {\n  ps := td.params.map(p -> (\"'\" + p, kernel_dependent_records.t0()))\n  self := kernel_dependent_records.at(\n    kernel_dependent_records.c(\"m.\" + td.name),\n    ps.map(p -> kernel_dependent_records.v(p.0)),\n  )\n  mut ctors := []\n  match td.body {\n    ast.SumBody(vs) => {\n      for variant in vs {\n        mut args := []\n        match variant.payload {\n          ast.Positional(ts) => {\n            for (i, t) in enumerate(ts) {\n              mut args.push(\n                (\n                  \"x\" + to_string(i),\n                  kernel_dependent_records.type_of(\n                    mut r,\n                    t,\n                    td.params,\n                  )!,\n                ),\n              )\n            }\n          },\n          _ => (),\n        }\n        mut ctors.push(\n          (\n            \"m.\" + variant.name,\n            kernel_dependent_records.pis(ps + args, self),\n          ),\n        )\n      }\n    },\n    _ => return Err(\"not a sum\"),\n  }\n  r.env = kernel_dependent.add_inductive(\n    r.env,\n    \"m.\" + td.name,\n    kernel_dependent_records.pis(ps, kernel_dependent_records.t0()),\n    len(ps),\n    ctors,\n  )!\n  Ok(())\n}"},{"name":"kernel_dependent_records.add_type_function","kind":"fn","old":null,"new":"b2c1026fcc82bb8d","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"/// A type function `comptime fn P(comptime T: Type) -> Type`, its body\n/// `std.typing.record([Field { name: f.name, type: E, default: D } for f\n/// in T.fields])`: `m.P := λ schema. Π (g: F). ⟦E⟧`, `D`'s constructor the\n/// default of each field.\nfn add_type_function(\n  mut r: kernel_dependent_records.Records,\n  f: ast.FnDecl,\n) -> Result[(), String] {\n  (field, lam_body) := match f.body {\n    ast.Call { callee: ast.Var(\"std.typing.record\"), args: [ast.Call { callee: ast.Var(\"$core:map\"), args: [ast.FieldOf { name: \"fields\", .. }, ast.Lambda { params: [p], body }] }] } => (p.name, body),\n    _ => return Err(\n      \"`\" + f.name + \"`: not a record of one field per field of `T`\",\n    ),\n  }\n  mut type_expr := ast.UnitExpr\n  mut default := \"\"\n  match lam_body {\n    ast.CtorExpr { name: \"Field\", args: ast.RecordArgs(fs) } => {\n      for (n, e) in fs {\n        if n == \"type\" {\n          type_expr = e\n        }\n        if n == \"default\" {\n          default = match e {\n            ast.CtorExpr { name: \"Some\", args: ast.PositionalArgs([ast.Call { args: [ast.CtorExpr { name, .. }], .. }]) } => name,\n            _ => \"\",\n          }\n        }\n      }\n    },\n    _ => return Err(\"`\" + f.name + \"`: each field not a `Field { … }`\"),\n  }\n  body := kernel_dependent_records.type_value(mut r, type_expr, field)!\n  ty := kernel_dependent_records.pis(\n    kernel_dependent_records.schema(),\n    kernel_dependent_records.t0(),\n  )\n  r.env = kernel_dependent.define(\n    r.env,\n    \"m.\" + f.name,\n    ty,\n    kernel_dependent_records.lams(\n      kernel_dependent_records.schema(),\n      kernel_dependent.pi(\n        \"g\",\n        kernel_dependent_records.v(\"F\"),\n        body,\n      ),\n    ),\n  )!\n  mut r.defaults.insert(f.name, default)\n  Ok(())\n}"},{"name":"kernel_dependent_records.type_value","kind":"fn","old":null,"new":"c13d38139bfcabf3","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"/// A type value of a field: `f.type` is `ty g`, and\n/// `std.typing.applied(\"C\", [a])` is `m.C ⟦a⟧`.\nfn type_value(\n  mut r: kernel_dependent_records.Records,\n  e: ast.Expr,\n  field: String,\n) -> Result[kernel_dependent_records.D, String] {\n  match e {\n    ast.FieldOf { base: ast.Var(x), name: \"type\" } => if x == field {\n      Ok(kernel_dependent_records.app(\n        kernel_dependent_records.v(\"ty\"),\n        kernel_dependent_records.v(\"g\"),\n      ))\n    } else {\n      Err(\"`\" + x + \".type`: not the field's\")\n    },\n    ast.Call { callee: ast.Var(\"std.typing.applied\"), args: [ast.StrLit(name), ast.ListExpr(xs)] } => {\n      mut args := []\n      for a in xs {\n        mut args.push(\n          kernel_dependent_records.type_value(mut r, a, field)!,\n        )\n      }\n      Ok(kernel_dependent_records.at(\n        kernel_dependent_records.c(\"m.\" + name),\n        args,\n      ))\n    },\n    _ => Err(\"a type value the translation doesn't take\"),\n  }\n}"},{"name":"kernel_dependent_records.lookup_var","kind":"fn","old":null,"new":"bd33cfc6b973126c","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"// ---- expressions ----\n\nfn lookup_var(\n  sc: kernel_dependent_records.Scope,\n  x: String,\n) -> Option[kernel_dependent_records.D] {\n  for (n, t) in sc.vars {\n    if n == x {\n      return Some(t)\n    }\n  }\n  None\n}"},{"name":"kernel_dependent_records.field_of","kind":"fn","old":null,"new":"e1918410c0bb0b1b","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"/// `x.(f.name)` for the field in scope.\nfn field_of(\n  sc: kernel_dependent_records.Scope,\n  e: ast.Expr,\n) -> Result[kernel_dependent_records.D, String] {\n  match e {\n    ast.FieldOf { base: ast.Var(f), name: \"name\" } => if f == sc.field {\n      Ok(kernel_dependent_records.v(\"g\"))\n    } else {\n      Err(\"`\" + f + \".name`: not the field in scope\")\n    },\n    _ => Err(\"a field name that isn't `f.name`\"),\n  }\n}"},{"name":"kernel_dependent_records.expr","kind":"fn","old":null,"new":"41d5440f6ba62426","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"fn expr(\n  mut r: kernel_dependent_records.Records,\n  sc: kernel_dependent_records.Scope,\n  e: ast.Expr,\n) -> Result[kernel_dependent_records.D, String] {\n  match e {\n    ast.Var(x) => match kernel_dependent_records.lookup_var(sc, x) {\n      Some(t) => Ok(t),\n      None => Err(\"`\" + x + \"` isn't in scope\"),\n    },\n    ast.MethodCall { recv, name: \"$field\", args: [f] } => Ok(kernel_dependent_records.app(\n      kernel_dependent_records.expr(mut r, sc, recv)!,\n      kernel_dependent_records.field_of(sc, f)!,\n    )),\n    ast.MethodCall { recv: ast.CtorExpr { name: \"T\", .. }, name: \"make\", args: [ast.Lambda { params: [p], body }] } => {\n      inner := kernel_dependent_records.expr(\n        mut r,\n        kernel_dependent_records.Scope {\n          ..sc,\n          field: p.name,\n          ctx: [(\"g\", kernel_dependent_records.v(\"F\"))] + sc.ctx,\n        },\n        body,\n      )!\n      Ok(kernel_dependent.lambda(\n        \"g\",\n        kernel_dependent_records.v(\"F\"),\n        inner,\n      ))\n    },\n    ast.MethodCall { recv, name, args } => if contains(r.methods, name) {\n      mut xs := [kernel_dependent_records.expr(mut r, sc, recv)!]\n      for a in args {\n        mut xs.push(kernel_dependent_records.expr(mut r, sc, a)!)\n      }\n      Ok(kernel_dependent_records.at(\n        kernel_dependent_records.generic(name),\n        xs,\n      ))\n    } else {\n      Err(\"the method `\" + name + \"` isn't translated\")\n    },\n    ast.CtorExpr { name, args: ast.RecordArgs([]) } => {\n      // a record literal of a made type, every field its default\n      tf := match split(name, \"[\") {\n        [n, ..] => n,\n        [] => name,\n      }\n      k := get(r.defaults, tf) or {\n        return Err(\"`\" + name + \" {}`: no type function `\" + tf + \"`\")\n      }\n      Ok(kernel_dependent.lambda(\n        \"g\",\n        kernel_dependent_records.v(\"F\"),\n        kernel_dependent_records.app(\n          kernel_dependent_records.c(\"m.\" + k),\n          kernel_dependent_records.app(\n            kernel_dependent_records.v(\"ty\"),\n            kernel_dependent_records.v(\"g\"),\n          ),\n        ),\n      ))\n    },\n    ast.MatchExpr { scrutinee, arms, .. } => kernel_dependent_records.matched(\n      mut r,\n      sc,\n      scrutinee,\n      arms,\n      None,\n    ),\n    ast.Block { stmts, last } => {\n      mut s := sc\n      for st in stmts {\n        match st {\n          ast.VarDecl { name, value, .. } => {\n            s = kernel_dependent_records.Scope { ..s, vars: [(\n                name,\n                kernel_dependent_records.expr(mut r, s, value)!,\n              )]\n              + s.vars }\n          },\n          ast.ExprStmt(ast.MethodCall { recv: ast.Var(y), name, args }) => if contains(r.updating, name) {\n            mut xs := [kernel_dependent_records.lookup_var(s, y) or {\n              return Err(\"`\" + y + \"` isn't in scope\")\n            }]\n            for a in args {\n              mut xs.push(kernel_dependent_records.expr(mut r, s, a)!)\n            }\n            s = kernel_dependent_records.Scope {\n              ..s,\n              vars: [(y, kernel_dependent_records.at(\n                  kernel_dependent_records.generic(name),\n                  xs,\n                ))]\n                + s.vars,\n            }\n          } else {\n            return Err(\"`\" + name + \"` doesn't change its receiver\")\n          },\n          _ => return Err(\"a statement the translation doesn't take\"),\n        }\n      }\n      kernel_dependent_records.expr(mut r, s, last)\n    },\n    _ => Err(\"an expression the translation doesn't take\"),\n  }\n}"},{"name":"kernel_dependent_records.matched","kind":"fn","old":null,"new":"b7198c38f1cd33fb","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"/// A `match` on a value of a sum: its eliminator, into the type of the\n/// arms; with `changing`, each arm a change to `self` from that value.\nfn matched(\n  mut r: kernel_dependent_records.Records,\n  sc: kernel_dependent_records.Scope,\n  scrutinee: ast.Expr,\n  arms: List[ast.Arm],\n  changing: Option[kernel_dependent_records.D],\n) -> Result[kernel_dependent_records.D, String] {\n  s := kernel_dependent_records.expr(mut r, sc, scrutinee)!\n  ctx := sc.ctx\n  sty := kernel_dependent.whnf(\n    r.env,\n    kernel_dependent.infer(r.env, ctx, s)!,\n  )\n  (head, params) := kernel_dependent.spine(sty)\n  ind := match head {\n    kernel_dependent.Constant { name, .. } => kernel_dependent.inductive_named(r.env, name) or {\n      return Err(\"a `match` on a value of no sum\")\n    },\n    _ => return Err(\"a `match` on a value of no sum\"),\n  }\n  mut minors := []\n  mut result := kernel_dependent.Sort(0)\n  for ct in ind.constructors {\n    cty := kernel_dependent.infer(r.env, ctx, kernel_dependent_records.at(\n      kernel_dependent_records.c(ct.name),\n      params,\n    ))!\n    (args, _) := kernel_dependent.peel(cty, -1, \"#m\")\n    mut found := false\n    for a in arms {\n      match a.pat {\n        ast.CtorPattern { name, args: pats } => if \"m.\" + name == ct.name {\n          binds := match pats {\n            ast.PositionalPats(ps) => ps.map(\n              p -> match p {\n                ast.Bind(x) => x,\n                _ => \"_\",\n              },\n            ),\n            _ => [],\n          }\n          named := enumerate(args).map(\n            p -> (get(binds, p.0) ?? p.1.0, p.1.1),\n          )\n          sc2 := kernel_dependent_records.Scope {\n            ..sc,\n            vars: named.map(n -> (n.0, kernel_dependent_records.v(n.0)))\n              + sc.vars,\n            ctx: named.reversed() + ctx,\n          }\n          inner := match changing {\n            Some(now) => kernel_dependent_records.changed(\n              mut r,\n              sc2,\n              a.body,\n              now,\n            )!,\n            None => kernel_dependent_records.expr(mut r, sc2, a.body)!,\n          }\n          if !found && result == kernel_dependent.Sort(0) {\n            result = kernel_dependent.infer(\n              r.env,\n              named.reversed() + ctx,\n              inner,\n            ) !! kernel_dependent.Sort(0)\n          }\n          mut minors.push(kernel_dependent_records.lams(named, inner))\n          found = true\n        },\n        _ => (),\n      }\n    }\n    if !found {\n      return Err(\"`\" + ct.name + \"` has no arm\")\n    }\n  }\n  Ok(kernel_dependent_records.at(\n    kernel_dependent.Constant {\n      name: ind.name + \".rec\",\n      levels: [0],\n    },\n    params\n      + [kernel_dependent.lambda(\"_s\", sty, result)]\n      + minors\n      + [s],\n  ))\n}"},{"name":"kernel_dependent_records.add_impl","kind":"fn","old":null,"new":"428784bf9248a281","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"// ---- the blanket impl ----\n\n/// `T.make` methods and `mut self` methods (a `comptime for f in T.fields`\n/// changing `self`'s fields) as functions over the schema.\nfn add_impl(\n  mut r: kernel_dependent_records.Records,\n  imp: ast.ImplDecl,\n) -> Result[(), String] {\n  for f in imp.methods {\n    mut r.methods.push(f.name)\n    if f.params.any(p -> p.name == \"self\" && p.mutable) {\n      mut r.updating.push(f.name)\n    }\n  }\n  for f in imp.methods {\n    mut ps := []\n    for p in f.params {\n      mut ps.push(\n        (p.name, kernel_dependent_records.type_of(mut r, p.ty, [])!),\n      )\n    }\n    sc := kernel_dependent_records.Scope {\n      vars: ps.map(p -> (p.0, kernel_dependent_records.v(p.0))),\n      ctx: (kernel_dependent_records.schema() + ps).reversed(),\n    }\n    body := if contains(r.updating, f.name) {\n      kernel_dependent_records.changed(\n        mut r,\n        sc,\n        f.body,\n        kernel_dependent_records.v(\"self\"),\n      )!\n    } else {\n      kernel_dependent_records.expr(mut r, sc, f.body)!\n    }\n    r.env = kernel_dependent.define(\n      r.env,\n      \"m.\" + f.name,\n      kernel_dependent_records.pis(\n        kernel_dependent_records.schema() + ps,\n        kernel_dependent_records.record(),\n      ),\n      kernel_dependent_records.lams(\n        kernel_dependent_records.schema() + ps,\n        body,\n      ),\n    )!\n  }\n  Ok(())\n}"},{"name":"kernel_dependent_records.changed","kind":"fn","old":null,"new":"8138ce2313c37771","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"/// `self` after `e`, `self` being `now` before.\nfn changed(\n  mut r: kernel_dependent_records.Records,\n  sc: kernel_dependent_records.Scope,\n  e: ast.Expr,\n  now: kernel_dependent_records.D,\n) -> Result[kernel_dependent_records.D, String] {\n  match e {\n    ast.UnitExpr => Ok(now),\n    ast.Block { stmts, last } => {\n      mut cur := now\n      for st in stmts {\n        cur = match st {\n          ast.ComptimeFor { pat: ast.Bind(f), iter: ast.FieldOf { name: \"fields\", .. }, body } => {\n            step := kernel_dependent_records.changed(\n              mut r,\n              kernel_dependent_records.Scope {\n                vars: [(\"self\", kernel_dependent_records.v(\"y\"))]\n                  + sc.vars,\n                ctx: [\n                    (\"y\", kernel_dependent_records.record()),\n                    (\"g\", kernel_dependent_records.v(\"F\")),\n                  ]\n                  + sc.ctx,\n                field: f,\n              },\n              body,\n              kernel_dependent_records.v(\"y\"),\n            )!\n            kernel_dependent_records.at(kernel_dependent.Constant {\n              name: \"List.rec\",\n              levels: [0],\n            }, [\n              kernel_dependent_records.v(\"F\"),\n              kernel_dependent.lambda(\n                \"_l\",\n                kernel_dependent_records.app(\n                  kernel_dependent_records.c(\"List\"),\n                  kernel_dependent_records.v(\"F\"),\n                ),\n                kernel_dependent_records.arrow(\n                  kernel_dependent_records.record(),\n                  kernel_dependent_records.record(),\n                ),\n              ),\n              kernel_dependent.lambda(\n                \"y\",\n                kernel_dependent_records.record(),\n                kernel_dependent_records.v(\"y\"),\n              ),\n              kernel_dependent_records.lams([\n                (\"g\", kernel_dependent_records.v(\"F\")),\n                (\"rest\", kernel_dependent_records.app(\n                  kernel_dependent_records.c(\"List\"),\n                  kernel_dependent_records.v(\"F\"),\n                )),\n                (\"ih\", kernel_dependent_records.arrow(\n                  kernel_dependent_records.record(),\n                  kernel_dependent_records.record(),\n                )),\n              ], kernel_dependent.lambda(\n                \"y\",\n                kernel_dependent_records.record(),\n                kernel_dependent_records.app(\n                  kernel_dependent_records.v(\"ih\"),\n                  step,\n                ),\n              )),\n              kernel_dependent_records.v(\"fs\"),\n              cur,\n            ])\n          },\n          ast.Assign { place: ast.MethodCall { recv: ast.Var(\"self\"), name: \"$field\", args: [f] }, value } => kernel_dependent_records.at(\n            kernel_dependent_records.c(\"updated\"),\n            [\n              kernel_dependent_records.v(\"F\"),\n              kernel_dependent_records.v(\"ty\"),\n              kernel_dependent_records.v(\"deq\"),\n              cur,\n              kernel_dependent_records.field_of(sc, f)!,\n              kernel_dependent_records.expr(mut r, sc, value)!,\n            ],\n          ),\n          ast.ExprStmt(x) => kernel_dependent_records.changed(\n            mut r,\n            kernel_dependent_records.Scope {\n              ..sc,\n              vars: [(\"self\", cur)] + sc.vars,\n            },\n            x,\n            cur,\n          )!,\n          _ => return Err(\n            \"a statement of a `mut self` method the translation doesn't take\",\n          ),\n        }\n      }\n      kernel_dependent_records.changed(\n        mut r,\n        kernel_dependent_records.Scope {\n          ..sc,\n          vars: [(\"self\", cur)] + sc.vars,\n        },\n        last,\n        cur,\n      )\n    },\n    ast.MatchExpr { scrutinee, arms, .. } => kernel_dependent_records.matched(\n      mut r,\n      kernel_dependent_records.Scope {\n        ..sc,\n        vars: [(\"self\", now)] + sc.vars,\n      },\n      scrutinee,\n      arms,\n      Some(now),\n    ),\n    _ => Err(\"a change to `self` the translation doesn't take\"),\n  }\n}"},{"name":"kernel_dependent_records.statement","kind":"fn","old":null,"new":"6c23b27bd53c9049","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"// ---- laws ----\n\n/// A law's statement: `==` an equation at its sides' type, `T.fields.all(f\n/// -> p)` a `Π` over the fields.\nfn statement(\n  mut r: kernel_dependent_records.Records,\n  sc: kernel_dependent_records.Scope,\n  ctx: List[(String, kernel_dependent_records.D)],\n  e: ast.Expr,\n) -> Result[kernel_dependent_records.D, String] {\n  match e {\n    ast.Call { callee: ast.Var(\"Eq.eq\"), args: [a, b] } => {\n      x := kernel_dependent_records.expr(mut r, sc, a)!\n      y := kernel_dependent_records.expr(mut r, sc, b)!\n      ty := kernel_dependent.infer(r.env, ctx, x)!\n      Ok(kernel_dependent.equality(0, ty, x, y))\n    },\n    ast.MethodCall { recv: ast.FieldOf { name: \"fields\", .. }, name: \"all\", args: [ast.Lambda { params: [p], body }] } => {\n      inner := kernel_dependent_records.statement(\n        mut r,\n        kernel_dependent_records.Scope {\n          ..sc,\n          field: p.name,\n          ctx: [(\"g\", kernel_dependent_records.v(\"F\"))] + ctx,\n        },\n        [(\"g\", kernel_dependent_records.v(\"F\"))] + ctx,\n        body,\n      )!\n      Ok(kernel_dependent.pi(\n        \"g\",\n        kernel_dependent_records.v(\"F\"),\n        inner,\n      ))\n    },\n    _ => Err(\"a statement the translation doesn't take\"),\n  }\n}"},{"name":"kernel_dependent_records.add_applied_at","kind":"fn","old":null,"new":"e6d9d95cf012ac5e","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"/// The library's lemma about `mut self` methods: after `apply`, a field is\n/// as `patched` says if `fs` has it, else as before; by induction over `fs`.\nfn add_applied_at(\n  mut r: kernel_dependent_records.Records,\n  update: String,\n  pure: String,\n) -> Result[(), String] {\n  x := kernel_dependent_records.v(\"x\")\n  p := kernel_dependent_records.v(\"p\")\n  g := kernel_dependent_records.v(\"g\")\n  patch := kernel_dependent_records.type_of(mut r, ast.Named {\n    name: \"Patch\",\n    args: [ast.Named { name: \"T\", args: [] }],\n  }, [])!\n  stmt := kernel_dependent_records.pis(\n    kernel_dependent_records.schema() + [(\"p\", patch)],\n    kernel_dependent.pi(\n      \"x\",\n      kernel_dependent_records.record(),\n      kernel_dependent.pi(\n        \"g\",\n        kernel_dependent_records.v(\"F\"),\n        kernel_dependent.equality(0, kernel_dependent_records.app(\n          kernel_dependent_records.v(\"ty\"),\n          g,\n        ), kernel_dependent_records.app(kernel_dependent_records.at(\n          kernel_dependent_records.generic(update),\n          [x, p],\n        ), g), kernel_dependent_records.at(\n          kernel_dependent_records.c(\"ite\"),\n          [kernel_dependent_records.app(\n            kernel_dependent_records.v(\"ty\"),\n            g,\n          ), kernel_dependent_records.at(\n            kernel_dependent_records.c(\"has\"),\n            [\n              kernel_dependent_records.v(\"F\"),\n              kernel_dependent_records.v(\"ty\"),\n              kernel_dependent_records.v(\"deq\"),\n              kernel_dependent_records.v(\"fs\"),\n              g,\n            ],\n          ), kernel_dependent_records.app(kernel_dependent_records.at(\n            kernel_dependent_records.generic(pure),\n            [x, p],\n          ), g), kernel_dependent_records.app(x, g)],\n        )),\n      ),\n    ),\n  )\n  kernel_dependent_records.prove_applied_at(\n    mut r,\n    update + \"_at\",\n    stmt,\n  )\n}"},{"name":"kernel_dependent_records.prove_applied_at","kind":"fn","old":null,"new":"f863cbd5c98bec41","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"fn prove_applied_at(\n  mut r: kernel_dependent_records.Records,\n  name: String,\n  stmt: kernel_dependent_records.D,\n) -> Result[(), String] {\n  both := [kernel_dependent_tactics.Case {\n    names: [],\n    proof: (g: kernel_dependent_tactics.Goal) ->\n      kernel_dependent_tactics.simplify(g),\n  }, kernel_dependent_tactics.Case {\n    names: [],\n    proof: (g: kernel_dependent_tactics.Goal) ->\n      kernel_dependent_tactics.simplify(g),\n  }]\n  tactic := (gl: kernel_dependent_tactics.Goal) ->\n    kernel_dependent_tactics.intros(\n      gl,\n      [\"F\", \"ty\", \"deq\", \"fs\", \"p\"],\n      g1 -> kernel_dependent_tactics.induction(\n        g1,\n        \"fs\",\n        [kernel_dependent_tactics.Case {\n          names: [],\n          proof: g2 -> kernel_dependent_tactics.intros(\n            g2,\n            [\"x\", \"g\"],\n            kernel_dependent_tactics.simplify,\n          ),\n        }, kernel_dependent_tactics.Case {\n          names: [\"y\", \"rest\", \"ih\"],\n          proof: g2 ->\n            kernel_dependent_tactics.intros(g2, [\"x\", \"g\"], g3 -> {\n              // the step `apply` takes at the list's head: the argument of the\n              // call on `rest`\n              lhs := match kernel_dependent.spine(\n                kernel_dependent.whnf(g3.env, g3.target),\n              ) {\n                (_, [_, l, _]) => l,\n                _ => return Err(\"applied_at: the goal\"),\n              }\n              step := match kernel_dependent.spine(\n                kernel_dependent.whnf(g3.env, lhs),\n              ) {\n                (_, args) => get(args, len(args) - 2) or {\n                  return Err(\"applied_at: the step\")\n                },\n              }\n              kernel_dependent_tactics.rewrite(\n                g3,\n                kernel_dependent_records.at(\n                  kernel_dependent_records.v(\"ih\"),\n                  [step, kernel_dependent_records.v(\"g\")],\n                ),\n                g4 -> kernel_dependent_tactics.cases(\n                  g4,\n                  kernel_dependent_records.app(\n                    kernel_dependent_records.v(\"p\"),\n                    kernel_dependent_records.v(\"y\"),\n                  ),\n                  \"h\",\n                  [kernel_dependent_tactics.Case {\n                    names: [],\n                    proof: g5 ->\n                      kernel_dependent_records.split_field(g5, both),\n                  }, kernel_dependent_tactics.Case {\n                    names: [\"v\"],\n                    proof: g5 ->\n                      kernel_dependent_records.split_field(g5, both),\n                  }],\n                ),\n              )\n            }),\n        }],\n      ),\n    )\n  r.env = kernel_dependent_tactics.prove(r.env, \"m.\" + name, stmt, tactic)!\n  Ok(())\n}"},{"name":"kernel_dependent_records.split_field","kind":"fn","old":null,"new":"93b40553ebc36040","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"/// After `apply`'s step on the head field `y`: `y` and `g` the same field\n/// (then `h` says what `p y` is) or not.\nfn split_field(\n  g: kernel_dependent_tactics.Goal,\n  both: List[kernel_dependent_tactics.Case],\n) -> Result[kernel_dependent_records.D, String] {\n  kernel_dependent_tactics.cases(g, kernel_dependent_records.at(\n    kernel_dependent_records.v(\"deq\"),\n    [\n      kernel_dependent_records.v(\"y\"),\n      kernel_dependent_records.v(\"g\"),\n    ],\n  ), \"\", [kernel_dependent_tactics.Case {\n    names: [\"e\"],\n    proof: g1 -> kernel_dependent_tactics.subst(\n      g1,\n      \"e\",\n      g2 -> kernel_dependent_tactics.rewrite(\n        g2,\n        kernel_dependent_records.v(\"h\"),\n        g3 -> kernel_dependent_tactics.cases(\n          g3,\n          kernel_dependent_records.at(\n            kernel_dependent_records.c(\"has\"),\n            [\n              kernel_dependent_records.v(\"F\"),\n              kernel_dependent_records.v(\"ty\"),\n              kernel_dependent_records.v(\"deq\"),\n              kernel_dependent_records.v(\"rest\"),\n              kernel_dependent_records.v(\"y\"),\n            ],\n          ),\n          \"\",\n          both,\n        ),\n      ),\n    ),\n  }, kernel_dependent_tactics.Case {\n    names: [\"n\"],\n    proof: kernel_dependent_tactics.simplify,\n  }])\n}"},{"name":"kernel_dependent_records.steps","kind":"fn","old":null,"new":"ed585248c1761375","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"/// A law's proof steps: `simplify()` (every `Π` taken, `funext` on an\n/// equation of records, then closed by unfolding), `fields()` (`funext`),\n/// `simplify(L)` (rewritten with the lemma `L` at the goal's variables,\n/// then with `all`, then closed).\nfn steps(\n  r: kernel_dependent_records.Records,\n  body: ast.Expr,\n  g: kernel_dependent_tactics.Goal,\n) -> Result[kernel_dependent_records.D, String] {\n  calls := match body {\n    ast.Block { stmts, last } => stmts.map(\n        s -> match s {\n          ast.ExprStmt(e) => e,\n          _ => ast.UnitExpr,\n        },\n      )\n      + [last],\n    _ => [body],\n  }\n  kernel_dependent_records.run(r, calls, g)\n}"},{"name":"kernel_dependent_records.run","kind":"fn","old":null,"new":"30356de1de35b8c2","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"fn run(\n  r: kernel_dependent_records.Records,\n  calls: List[ast.Expr],\n  g: kernel_dependent_tactics.Goal,\n) -> Result[kernel_dependent_records.D, String] {\n  match kernel_dependent.whnf(g.env, g.target) {\n    kernel_dependent.Pi { name, .. } => {\n      x := if name == \"_\" {\n        \"#h\" + to_string(len(g.context))\n      } else {\n        name\n      }\n      return kernel_dependent_tactics.intro(\n        g,\n        x,\n        g1 -> kernel_dependent_records.run(r, calls, g1),\n      )\n    },\n    _ => (),\n  }\n  match calls {\n    [] => Err(\"the steps ended with the goal left\"),\n    [ast.Call { callee: ast.Var(\"fields\"), args: [] }, ..rest] => kernel_dependent_tactics.funext(\n      g,\n      \"g\",\n      g1 -> kernel_dependent_records.run(r, rest, g1),\n    ),\n    [ast.Call { callee: ast.Var(\"simplify\"), args: [] }] => if kernel_dependent_records.equation_of_records(g) {\n      kernel_dependent_tactics.funext(\n        g,\n        \"g\",\n        kernel_dependent_tactics.simplify,\n      )\n    } else {\n      kernel_dependent_tactics.simplify(g)\n    },\n    [ast.Call { callee: ast.Var(\"simplify\"), args: [ast.Var(lemma)] }] => {\n      args := [\"p\", \"x\", \"g\"].map(n -> kernel_dependent_records.v(n))\n      kernel_dependent_tactics.rewrite(\n        g,\n        kernel_dependent_records.at(\n          kernel_dependent_records.c(\"m.\" + lemma),\n          kernel_dependent_records.schema_args() + args,\n        ),\n        g1 -> kernel_dependent_tactics.rewrite(\n          g1,\n          kernel_dependent_records.app(\n            kernel_dependent_records.v(\"all\"),\n            kernel_dependent_records.v(\"g\"),\n          ),\n          kernel_dependent_tactics.simplify,\n        ),\n      )\n    },\n    _ => Err(\"a step the translation doesn't take\"),\n  }\n}"},{"name":"kernel_dependent_records.equation_of_records","kind":"fn","old":null,"new":"0aec886a8a42346d","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"fn equation_of_records(g: kernel_dependent_tactics.Goal) -> Bool {\n  match kernel_dependent.spine(kernel_dependent.whnf(g.env, g.target)) {\n    (kernel_dependent.Constant { name: \"Eq\", .. }, [ty, _, _]) => kernel_dependent.whnf(g.env, ty) is kernel_dependent.Pi,\n    _ => false,\n  }\n}"},{"name":"kernel_dependent_records.laws","kind":"fn","old":null,"new":"b23b4828461877c6","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"/// The module's laws for every record: its sums, type functions and\n/// blanket impl translated, each `lemma l[T: Record]` stated, proven by\n/// its steps and checked; each with its time and term size.\npub fn laws(\n  clock: std.time.SystemClock,\n  decls: List[ast.Decl],\n) -> Result[kernel_dependent_records.Records, String] {\n  mut checked := []\n  base := kernel_dependent_patch.definitions(\n    kernel_dependent_patch.base(\n      kernel_dependent.empty_environment(),\n    )!,\n  )!\n  env := kernel_dependent_patch.laws(clock, mut checked, base)!\n  mut r := kernel_dependent_records.Records {\n    env,\n    defaults: Dict[String, String] {},\n    methods: [],\n    updating: [],\n    proven: [],\n    instances: [],\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => match td.body {\n        ast.SumBody(_) => kernel_dependent_records.add_sum(mut r, td)!,\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if (f.compile_time\n        && f.ret == ast.Named { name: \"Type\", args: [] }) {\n        kernel_dependent_records.add_type_function(mut r, f)!\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.ImplDef(imp) => if imp.bounds.any(\n        b -> b.traits.any(\n          t -> t == ast.Named { name: \"Record\", args: [] },\n        ),\n      ) {\n        kernel_dependent_records.add_impl(mut r, imp)!\n      },\n      _ => (),\n    }\n  }\n  if contains(r.updating, \"apply\") && contains(r.methods, \"patched\") {\n    kernel_dependent_records.add_applied_at(\n      mut r,\n      \"apply\",\n      \"patched\",\n    )!\n  }\n  mut names := []\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if f.lemma\n        && f.bounds.any(\n          b -> b.traits.any(\n            t -> t == ast.Named { name: \"Record\", args: [] },\n          ),\n        ) {\n        mut ps := []\n        for p in f.params {\n          mut ps.push(\n            (\n              p.name,\n              kernel_dependent_records.type_of(mut r, p.ty, [])!,\n            ),\n          )\n        }\n        ctx := (kernel_dependent_records.schema()\n          + [kernel_dependent_records.complete()]\n          + ps).reversed(\n        )\n        sc := kernel_dependent_records.Scope {\n          vars: ps.map(p -> (p.0, kernel_dependent_records.v(p.0))),\n          ctx,\n        }\n        body := get(f.post, 0) or {\n          return Err(\"`\" + f.name + \"` has no statement\")\n        }\n        s := kernel_dependent_records.statement(mut r, sc, ctx, body) except m {\n          return Err(\"`\" + f.name + \"`: \" + m)\n        }\n        goal := kernel_dependent_records.pis(\n          kernel_dependent_records.schema()\n            + [kernel_dependent_records.complete()]\n            + ps,\n          s,\n        )\n        t1 := clock.now().value\n        proof := kernel_dependent_records.steps(\n          r,\n          f.body,\n          kernel_dependent_tactics.Goal {\n            env: r.env,\n            context: [],\n            target: goal,\n          },\n        ) except m { return Err(\"`\" + f.name + \"`: \" + m) }\n        r.env = kernel_dependent.define(r.env, \"m.\" + f.name, goal, proof)!\n        mut r.proven.push(\n          (\n            f.name,\n            clock.now().value - t1,\n            kernel_dependent_records.size(proof),\n          ),\n        )\n        mut names.push(f.name)\n      },\n      _ => (),\n    }\n  }\n  // each record of the module: its schema, that its field list is complete\n  // (by computation), and every law at it by application\n  inst := kernel_dependent_patch.records(r.env, decls)!\n  r.env = inst.env\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          kernel_dependent_records.at_record(mut r, td.name, names)!\n        },\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  Ok(r)\n}"},{"name":"kernel_dependent_records.at_record","kind":"fn","old":null,"new":"e83835b3c25c846f","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"fn at_record(\n  mut r: kernel_dependent_records.Records,\n  t: String,\n  laws: List[String],\n) -> Result[(), String] {\n  field := kernel_dependent_records.c(t + \".Field\")\n  sc := [\n    field,\n    kernel_dependent_records.c(t + \".ty\"),\n    kernel_dependent_records.c(t + \".deq\"),\n    kernel_dependent_records.c(t + \".fields\"),\n  ]\n  ind := kernel_dependent.inductive_named(r.env, t + \".Field\") or {\n    return Err(\"`\" + t + \"`: no schema\")\n  }\n  has := (g: kernel_dependent_records.D) ->\n    kernel_dependent.holds(kernel_dependent_records.at(\n      kernel_dependent_records.c(\"has\"),\n      take(sc, 3) + [kernel_dependent_records.c(t + \".fields\"), g],\n    ))\n  all := kernel_dependent.lambda(\"g\", field, kernel_dependent_records.at(\n    kernel_dependent.Constant {\n      name: t + \".Field.rec\",\n      levels: [0],\n    },\n    [kernel_dependent.lambda(\n        \"z\",\n        field,\n        has(kernel_dependent_records.v(\"z\")),\n      )]\n      + ind.constructors.map(\n        _k -> kernel_dependent.reflexivity(\n          0,\n          kernel_dependent_records.c(\"Bool\"),\n          kernel_dependent_records.c(\"true\"),\n        ),\n      )\n      + [kernel_dependent_records.v(\"g\")],\n  ))\n  r.env = kernel_dependent.define(r.env, t + \".all\", kernel_dependent.pi(\n    \"g\",\n    field,\n    has(kernel_dependent_records.v(\"g\")),\n  ), all)!\n  for name in laws {\n    value := kernel_dependent_records.at(\n      kernel_dependent_records.c(\"m.\" + name),\n      sc + [kernel_dependent_records.c(t + \".all\")],\n    )\n    ty := kernel_dependent.infer(r.env, [], value)!\n    r.env = kernel_dependent.define(r.env, t + \".\" + name, ty, value)!\n    mut r.instances.push(\n      (t + \".\" + name, kernel_dependent_tactics.show(ty, [])),\n    )\n  }\n  Ok(())\n}"},{"name":"kernel_dependent_records.size","kind":"fn","old":null,"new":"6d1e98718b8d5bc9","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"fn size(t: kernel_dependent_records.D) -> Int {\n  match t {\n    kernel_dependent.Pi { domain, body, .. } => 1\n      + kernel_dependent_records.size(domain)\n      + kernel_dependent_records.size(body),\n    kernel_dependent.Lambda { domain, body, .. } => 1\n      + kernel_dependent_records.size(domain)\n      + kernel_dependent_records.size(body),\n    kernel_dependent.Apply { function, argument } => 1\n      + kernel_dependent_records.size(function)\n      + kernel_dependent_records.size(argument),\n    _ => 1,\n  }\n}"}]}
{"id":"5b3dbb8fd91a6eb1","time":1795853207,"message":"edit","changes":[{"name":"kernel_cli.dependent","kind":"fn","old":"2b3b24c75d60bd06","new":"3a454605150255e6","interface_changed":false,"affected":[],"module":"kernel_cli","text":"/// `strata kernel dependent [FILE.strata…]`: Patch's laws proven once, for\n/// every record, in the dependently typed kernel (kernel_dependent), each\n/// with the time its proof took to build and check; then each file's\n/// records as schemas, with the laws' instances at them.\nfn dependent(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  home: String,\n  paths: List[String],\n) -> std.process.ExitCode {\n  t0 := clock.now().value\n  mut checked := []\n  built := match kernel_dependent_patch.base(kernel_dependent.empty_environment()) {\n    Ok(e) => match kernel_dependent_patch.definitions(e) {\n      Ok(e2) => kernel_dependent_patch.laws(clock, mut checked, e2),\n      Err(m) => Err(m),\n    },\n    Err(m) => Err(m),\n  }\n  t1 := clock.now().value\n  env := built except m {\n    mut console.write(\"failed: \" + m + \"\\n\")\n    return 1\n  }\n  for k in checked {\n    mut console.write(\n      \"proven \"\n        + k.name\n        + \" (tactics \"\n        + kernel_cli.milliseconds(k.tactic_ns)\n        + \", kernel \"\n        + kernel_cli.milliseconds(k.kernel_ns)\n        + f\", a term of {k.size} nodes)\\n\",\n    )\n  }\n  mut console.write(\n    f\"{len(checked)} laws proven for every record ({kernel_cli.milliseconds(t1 - t0)} with the base and definitions); axiom: funext (built in)\\n\",\n  )\n  for k in checked {\n    uses := match kernel_dependent.lookup(env, k.name) {\n      Some(kernel_dependent.Entry { value: Some(p), .. }) => kernel_dependent.mentions(p, \"funext\"),\n      _ => false,\n    }\n    if uses {\n      mut console.write(\"  \" + k.name + \" uses funext\\n\")\n    }\n  }\n  mut code := 0\n  for (what, m) in kernel_dependent_patch.refusals(env) {\n    if m == \"\" {\n      mut console.write(\"ACCEPTED (unsound): \" + what + \"\\n\")\n      code = 1\n    } else {\n      mut console.write(\"refused: \" + what + \" (\" + m + \")\\n\")\n    }\n  }\n  for path in paths {\n    if !kernel_cli.every_record(mut console, files, clock, path) {\n      code = 1\n    }\n    t2 := clock.now().value\n    decls := match files.read_bytes(path) {\n      Ok(bytes) => match binary.read(bytes) {\n        Ok(img) => kernel_cli.made_in(\n          img.decls,\n          kernel_cli.typing_decls(files, home),\n        ),\n        Err(m) => Err(m),\n      },\n      Err(_) => Err(\"can't read it\"),\n    }\n    result := match decls {\n      Ok(ds) => kernel_dependent_patch.records(env, ds),\n      Err(m) => Err(m),\n    }\n    match result {\n      Ok(r) => {\n        mut console.write(\n          \"== \"\n            + path\n            + f\" ({kernel_cli.milliseconds(clock.now().value - t2)})\\n\",\n        )\n        for (n, s) in r.statements {\n          mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n        }\n        mut console.write(\n          \"opaque types: \"\n            + join(kernel_dependent.axioms(r.env), \", \")\n            + \"\\n\",\n        )\n      },\n      Err(m) => {\n        mut console.write(path + \": \" + m + \"\\n\")\n        code = 1\n      },\n    }\n  }\n  code\n}","old_text":"/// `strata kernel dependent [FILE.strata…]`: Patch's laws proven once, for\n/// every record, in the dependently typed kernel (kernel_dependent), each\n/// with the time its proof took to build and check; then each file's\n/// records as schemas, with the laws' instances at them.\nfn dependent(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  home: String,\n  paths: List[String],\n) -> std.process.ExitCode {\n  t0 := clock.now().value\n  mut checked := []\n  built := match kernel_dependent_patch.base(kernel_dependent.empty_environment()) {\n    Ok(e) => match kernel_dependent_patch.definitions(e) {\n      Ok(e2) => kernel_dependent_patch.laws(clock, mut checked, e2),\n      Err(m) => Err(m),\n    },\n    Err(m) => Err(m),\n  }\n  t1 := clock.now().value\n  env := built except m {\n    mut console.write(\"failed: \" + m + \"\\n\")\n    return 1\n  }\n  for k in checked {\n    mut console.write(\n      \"proven \"\n        + k.name\n        + \" (tactics \"\n        + kernel_cli.milliseconds(k.tactic_ns)\n        + \", kernel \"\n        + kernel_cli.milliseconds(k.kernel_ns)\n        + f\", a term of {k.size} nodes)\\n\",\n    )\n  }\n  mut console.write(\n    f\"{len(checked)} laws proven for every record ({kernel_cli.milliseconds(t1 - t0)} with the base and definitions); axiom: funext (built in)\\n\",\n  )\n  for k in checked {\n    uses := match kernel_dependent.lookup(env, k.name) {\n      Some(kernel_dependent.Entry { value: Some(p), .. }) => kernel_dependent.mentions(p, \"funext\"),\n      _ => false,\n    }\n    if uses {\n      mut console.write(\"  \" + k.name + \" uses funext\\n\")\n    }\n  }\n  mut code := 0\n  for (what, m) in kernel_dependent_patch.refusals(env) {\n    if m == \"\" {\n      mut console.write(\"ACCEPTED (unsound): \" + what + \"\\n\")\n      code = 1\n    } else {\n      mut console.write(\"refused: \" + what + \" (\" + m + \")\\n\")\n    }\n  }\n  for path in paths {\n    t2 := clock.now().value\n    decls := match files.read_bytes(path) {\n      Ok(bytes) => match binary.read(bytes) {\n        Ok(img) => kernel_cli.made_in(\n          img.decls,\n          kernel_cli.typing_decls(files, home),\n        ),\n        Err(m) => Err(m),\n      },\n      Err(_) => Err(\"can't read it\"),\n    }\n    result := match decls {\n      Ok(ds) => kernel_dependent_patch.records(env, ds),\n      Err(m) => Err(m),\n    }\n    match result {\n      Ok(r) => {\n        mut console.write(\n          \"== \"\n            + path\n            + f\" ({kernel_cli.milliseconds(clock.now().value - t2)})\\n\",\n        )\n        for (n, s) in r.statements {\n          mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n        }\n        mut console.write(\n          \"opaque types: \"\n            + join(kernel_dependent.axioms(r.env), \", \")\n            + \"\\n\",\n        )\n      },\n      Err(m) => {\n        mut console.write(path + \": \" + m + \"\\n\")\n        code = 1\n      },\n    }\n  }\n  code\n}"},{"name":"kernel_cli.use kernel_dependent_records","kind":"use","old":null,"new":"dbf96a41c81ced49","interface_changed":true,"affected":[],"module":"kernel_cli","text":"use kernel_dependent_records"},{"name":"kernel_cli.every_record","kind":"fn","old":null,"new":"f03df6e4d91d3185","interface_changed":true,"affected":[],"module":"kernel_cli","text":"/// The laws for every record a module states (`lemma l[T: Record]`),\n/// translated from its tree, proven and checked by the dependent kernel\n/// (kernel_dependent_records), then at each of its records. Whether all\n/// were.\nfn every_record(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  path: String,\n) -> Bool {\n  raw := match files.read_bytes(path) {\n    Ok(bytes) => match binary.read(bytes) {\n      Ok(img) => img.decls,\n      Err(_) => [],\n    },\n    Err(_) => [],\n  }\n  generic := raw.any(\n    d -> match d.kind {\n      ast.FnDef(f) => f.lemma && f.type_params == [\"T\"],\n      _ => false,\n    },\n  )\n  if !generic {\n    return true\n  }\n  t0 := clock.now().value\n  match kernel_dependent_records.laws(clock, raw) {\n    Ok(r) => {\n      mut console.write(\n        \"== \"\n          + path\n          + f\": laws for every record, from the module ({kernel_cli.milliseconds(clock.now().value - t0)} in all)\\n\",\n      )\n      for (n, ns, size) in r.proven {\n        mut console.write(\n          \"proven for every record \"\n            + n\n            + \" (\"\n            + kernel_cli.milliseconds(ns)\n            + f\", a term of {size} nodes)\\n\",\n        )\n      }\n      for (n, s) in r.instances {\n        mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n      }\n      true\n    },\n    Err(m) => {\n      mut console.write(path + \": laws for every record: \" + m + \"\\n\")\n      false\n    },\n  }\n}"}]}
{"id":"cbbe871622482d2c","time":1795853286,"message":"edit","changes":[{"name":"kernel_cli.every_record","kind":"fn","old":"f03df6e4d91d3185","new":"f30f674e993c2dc1","interface_changed":false,"affected":[],"module":"kernel_cli","text":"/// The laws for every record a module states (`lemma l[T: Record]`),\n/// translated from its tree, proven and checked by the dependent kernel\n/// (kernel_dependent_records), then at each of its records. Whether all\n/// were.\nfn every_record(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  path: String,\n) -> Bool {\n  raw := match files.read_bytes(path) {\n    Ok(bytes) => match binary.read(bytes) {\n      Ok(img) => img.decls,\n      Err(_) => [],\n    },\n    Err(_) => [],\n  }\n  generic := raw.any(\n    d -> match d.kind {\n      ast.FnDef(f) => f.lemma && f.type_params == [\"T\"],\n      _ => false,\n    },\n  )\n  if !generic {\n    return true\n  }\n  t0 := clock.now().value\n  match kernel_dependent_records.laws(clock, raw) {\n    Ok(r) => {\n      mut console.write(\n        \"== \"\n          + path\n          + f\": laws for every record, from the module ({kernel_cli.milliseconds(clock.now().value - t0)} in all)\\n\",\n      )\n      mut console.write(\n        \"translated: type functions \"\n          + join(r.defaults.keys(), \", \")\n          + \"; methods \"\n          + join(r.methods, \", \")\n          + \"\\n\",\n      )\n      for d in raw {\n        match d.kind {\n          ast.FnDef(f) => if f.lemma {\n            mut console.write(\n              \"lemma \"\n                + f.name\n                + f\": {len(f.bounds)} bounds, type params {len(f.type_params)}\\n\",\n            )\n          },\n          _ => (),\n        }\n      }\n      for (n, ns, size) in r.proven {\n        mut console.write(\n          \"proven for every record \"\n            + n\n            + \" (\"\n            + kernel_cli.milliseconds(ns)\n            + f\", a term of {size} nodes)\\n\",\n        )\n      }\n      for (n, s) in r.instances {\n        mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n      }\n      true\n    },\n    Err(m) => {\n      mut console.write(path + \": laws for every record: \" + m + \"\\n\")\n      false\n    },\n  }\n}","old_text":"/// The laws for every record a module states (`lemma l[T: Record]`),\n/// translated from its tree, proven and checked by the dependent kernel\n/// (kernel_dependent_records), then at each of its records. Whether all\n/// were.\nfn every_record(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  path: String,\n) -> Bool {\n  raw := match files.read_bytes(path) {\n    Ok(bytes) => match binary.read(bytes) {\n      Ok(img) => img.decls,\n      Err(_) => [],\n    },\n    Err(_) => [],\n  }\n  generic := raw.any(\n    d -> match d.kind {\n      ast.FnDef(f) => f.lemma && f.type_params == [\"T\"],\n      _ => false,\n    },\n  )\n  if !generic {\n    return true\n  }\n  t0 := clock.now().value\n  match kernel_dependent_records.laws(clock, raw) {\n    Ok(r) => {\n      mut console.write(\n        \"== \"\n          + path\n          + f\": laws for every record, from the module ({kernel_cli.milliseconds(clock.now().value - t0)} in all)\\n\",\n      )\n      for (n, ns, size) in r.proven {\n        mut console.write(\n          \"proven for every record \"\n            + n\n            + \" (\"\n            + kernel_cli.milliseconds(ns)\n            + f\", a term of {size} nodes)\\n\",\n        )\n      }\n      for (n, s) in r.instances {\n        mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n      }\n      true\n    },\n    Err(m) => {\n      mut console.write(path + \": laws for every record: \" + m + \"\\n\")\n      false\n    },\n  }\n}"}]}
{"id":"01dae85103125f0a","time":1795853349,"message":"edit","changes":[{"name":"kernel_dependent_records.add_type_function","kind":"fn","old":"b2c1026fcc82bb8d","new":"651e09f115506a6c","interface_changed":false,"affected":[],"module":"kernel_dependent_records","text":"/// A type function `comptime fn P(comptime T: Type) -> Type`, its body\n/// `std.typing.record([Field { name: f.name, type: E, default: D } for f\n/// in T.fields])`: `m.P := λ schema. Π (g: F). ⟦E⟧`, `D`'s constructor the\n/// default of each field.\nfn add_type_function(\n  mut r: kernel_dependent_records.Records,\n  f: ast.FnDecl,\n) -> Result[(), String] {\n  (field, lam_body) := match f.body {\n    ast.Call { callee: ast.Var(\"std.typing.record\"), args: [ast.Call { callee: ast.Var(\"$core:map\"), args: [ast.FieldOf { name: \"fields\", .. }, ast.Lambda { params: [p], body }] }] } => (p.name, body),\n    _ => return Err(\n      \"`\" + f.name + \"`: not a record of one field per field of `T`\",\n    ),\n  }\n  mut type_expr := ast.UnitExpr\n  mut default := \"\"\n  match lam_body {\n    ast.CtorExpr { name: field_ctor, args: ast.RecordArgs(fs) } => if !ends_with(field_ctor, \"Field\") {\n      return Err(\"`\" + f.name + \"`: each field not a `Field { … }`\")\n    } else {\n      for (n, e) in fs {\n        if n == \"type\" {\n          type_expr = e\n        }\n        if n == \"default\" {\n          default = match e {\n            ast.CtorExpr { name: \"Some\", args: ast.PositionalArgs([ast.Call { args: [ast.CtorExpr { name, .. }], .. }]) } => name,\n            _ => \"\",\n          }\n        }\n      }\n    },\n    _ => return Err(\"`\" + f.name + \"`: each field not a `Field { … }`\"),\n  }\n  body := kernel_dependent_records.type_value(mut r, type_expr, field)!\n  ty := kernel_dependent_records.pis(\n    kernel_dependent_records.schema(),\n    kernel_dependent_records.t0(),\n  )\n  r.env = kernel_dependent.define(\n    r.env,\n    \"m.\" + f.name,\n    ty,\n    kernel_dependent_records.lams(\n      kernel_dependent_records.schema(),\n      kernel_dependent.pi(\n        \"g\",\n        kernel_dependent_records.v(\"F\"),\n        body,\n      ),\n    ),\n  )!\n  mut r.defaults.insert(f.name, default)\n  Ok(())\n}","old_text":"/// A type function `comptime fn P(comptime T: Type) -> Type`, its body\n/// `std.typing.record([Field { name: f.name, type: E, default: D } for f\n/// in T.fields])`: `m.P := λ schema. Π (g: F). ⟦E⟧`, `D`'s constructor the\n/// default of each field.\nfn add_type_function(\n  mut r: kernel_dependent_records.Records,\n  f: ast.FnDecl,\n) -> Result[(), String] {\n  (field, lam_body) := match f.body {\n    ast.Call { callee: ast.Var(\"std.typing.record\"), args: [ast.Call { callee: ast.Var(\"$core:map\"), args: [ast.FieldOf { name: \"fields\", .. }, ast.Lambda { params: [p], body }] }] } => (p.name, body),\n    _ => return Err(\n      \"`\" + f.name + \"`: not a record of one field per field of `T`\",\n    ),\n  }\n  mut type_expr := ast.UnitExpr\n  mut default := \"\"\n  match lam_body {\n    ast.CtorExpr { name: \"Field\", args: ast.RecordArgs(fs) } => {\n      for (n, e) in fs {\n        if n == \"type\" {\n          type_expr = e\n        }\n        if n == \"default\" {\n          default = match e {\n            ast.CtorExpr { name: \"Some\", args: ast.PositionalArgs([ast.Call { args: [ast.CtorExpr { name, .. }], .. }]) } => name,\n            _ => \"\",\n          }\n        }\n      }\n    },\n    _ => return Err(\"`\" + f.name + \"`: each field not a `Field { … }`\"),\n  }\n  body := kernel_dependent_records.type_value(mut r, type_expr, field)!\n  ty := kernel_dependent_records.pis(\n    kernel_dependent_records.schema(),\n    kernel_dependent_records.t0(),\n  )\n  r.env = kernel_dependent.define(\n    r.env,\n    \"m.\" + f.name,\n    ty,\n    kernel_dependent_records.lams(\n      kernel_dependent_records.schema(),\n      kernel_dependent.pi(\n        \"g\",\n        kernel_dependent_records.v(\"F\"),\n        body,\n      ),\n    ),\n  )!\n  mut r.defaults.insert(f.name, default)\n  Ok(())\n}"},{"name":"kernel_dependent_records.laws","kind":"fn","old":"b23b4828461877c6","new":"e3750eecaa11333f","interface_changed":false,"affected":["kernel_cli.every_record","kernel_cli.dependent","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent_records","text":"/// The module's laws for every record: its sums, type functions and\n/// blanket impl translated, each `lemma l[T: Record]` stated, proven by\n/// its steps and checked; each with its time and term size.\npub fn laws(\n  clock: std.time.SystemClock,\n  decls: List[ast.Decl],\n) -> Result[kernel_dependent_records.Records, String] {\n  mut checked := []\n  base := kernel_dependent_patch.definitions(\n    kernel_dependent_patch.base(\n      kernel_dependent.empty_environment(),\n    )!,\n  )!\n  env := kernel_dependent_patch.laws(clock, mut checked, base)!\n  mut r := kernel_dependent_records.Records {\n    env,\n    defaults: Dict[String, String] {},\n    methods: [],\n    updating: [],\n    proven: [],\n    instances: [],\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => match td.body {\n        ast.SumBody(_) => kernel_dependent_records.add_sum(mut r, td)!,\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if f.compile_time\n        && kernel_dependent_records.is_named(f.ret, \"Type\") {\n        kernel_dependent_records.add_type_function(mut r, f)!\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.ImplDef(imp) => if imp.bounds.any(\n        b -> b.traits.any(\n          t -> kernel_dependent_records.is_named(t, \"Record\"),\n        ),\n      ) {\n        kernel_dependent_records.add_impl(mut r, imp)!\n      },\n      _ => (),\n    }\n  }\n  if contains(r.updating, \"apply\") && contains(r.methods, \"patched\") {\n    kernel_dependent_records.add_applied_at(\n      mut r,\n      \"apply\",\n      \"patched\",\n    )!\n  }\n  mut names := []\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if f.lemma\n        && f.bounds.any(\n          b -> b.traits.any(\n            t -> kernel_dependent_records.is_named(t, \"Record\"),\n          ),\n        ) {\n        mut ps := []\n        for p in f.params {\n          mut ps.push(\n            (\n              p.name,\n              kernel_dependent_records.type_of(mut r, p.ty, [])!,\n            ),\n          )\n        }\n        ctx := (kernel_dependent_records.schema()\n          + [kernel_dependent_records.complete()]\n          + ps).reversed(\n        )\n        sc := kernel_dependent_records.Scope {\n          vars: ps.map(p -> (p.0, kernel_dependent_records.v(p.0))),\n          ctx,\n        }\n        body := get(f.post, 0) or {\n          return Err(\"`\" + f.name + \"` has no statement\")\n        }\n        s := kernel_dependent_records.statement(mut r, sc, ctx, body) except m {\n          return Err(\"`\" + f.name + \"`: \" + m)\n        }\n        goal := kernel_dependent_records.pis(\n          kernel_dependent_records.schema()\n            + [kernel_dependent_records.complete()]\n            + ps,\n          s,\n        )\n        t1 := clock.now().value\n        proof := kernel_dependent_records.steps(\n          r,\n          f.body,\n          kernel_dependent_tactics.Goal {\n            env: r.env,\n            context: [],\n            target: goal,\n          },\n        ) except m { return Err(\"`\" + f.name + \"`: \" + m) }\n        r.env = kernel_dependent.define(r.env, \"m.\" + f.name, goal, proof)!\n        mut r.proven.push(\n          (\n            f.name,\n            clock.now().value - t1,\n            kernel_dependent_records.size(proof),\n          ),\n        )\n        mut names.push(f.name)\n      },\n      _ => (),\n    }\n  }\n  // each record of the module: its schema, that its field list is complete\n  // (by computation), and every law at it by application\n  inst := kernel_dependent_patch.records(r.env, decls)!\n  r.env = inst.env\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          kernel_dependent_records.at_record(mut r, td.name, names)!\n        },\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  Ok(r)\n}","old_text":"/// The module's laws for every record: its sums, type functions and\n/// blanket impl translated, each `lemma l[T: Record]` stated, proven by\n/// its steps and checked; each with its time and term size.\npub fn laws(\n  clock: std.time.SystemClock,\n  decls: List[ast.Decl],\n) -> Result[kernel_dependent_records.Records, String] {\n  mut checked := []\n  base := kernel_dependent_patch.definitions(\n    kernel_dependent_patch.base(\n      kernel_dependent.empty_environment(),\n    )!,\n  )!\n  env := kernel_dependent_patch.laws(clock, mut checked, base)!\n  mut r := kernel_dependent_records.Records {\n    env,\n    defaults: Dict[String, String] {},\n    methods: [],\n    updating: [],\n    proven: [],\n    instances: [],\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => match td.body {\n        ast.SumBody(_) => kernel_dependent_records.add_sum(mut r, td)!,\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if (f.compile_time\n        && f.ret == ast.Named { name: \"Type\", args: [] }) {\n        kernel_dependent_records.add_type_function(mut r, f)!\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.ImplDef(imp) => if imp.bounds.any(\n        b -> b.traits.any(\n          t -> t == ast.Named { name: \"Record\", args: [] },\n        ),\n      ) {\n        kernel_dependent_records.add_impl(mut r, imp)!\n      },\n      _ => (),\n    }\n  }\n  if contains(r.updating, \"apply\") && contains(r.methods, \"patched\") {\n    kernel_dependent_records.add_applied_at(\n      mut r,\n      \"apply\",\n      \"patched\",\n    )!\n  }\n  mut names := []\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if f.lemma\n        && f.bounds.any(\n          b -> b.traits.any(\n            t -> t == ast.Named { name: \"Record\", args: [] },\n          ),\n        ) {\n        mut ps := []\n        for p in f.params {\n          mut ps.push(\n            (\n              p.name,\n              kernel_dependent_records.type_of(mut r, p.ty, [])!,\n            ),\n          )\n        }\n        ctx := (kernel_dependent_records.schema()\n          + [kernel_dependent_records.complete()]\n          + ps).reversed(\n        )\n        sc := kernel_dependent_records.Scope {\n          vars: ps.map(p -> (p.0, kernel_dependent_records.v(p.0))),\n          ctx,\n        }\n        body := get(f.post, 0) or {\n          return Err(\"`\" + f.name + \"` has no statement\")\n        }\n        s := kernel_dependent_records.statement(mut r, sc, ctx, body) except m {\n          return Err(\"`\" + f.name + \"`: \" + m)\n        }\n        goal := kernel_dependent_records.pis(\n          kernel_dependent_records.schema()\n            + [kernel_dependent_records.complete()]\n            + ps,\n          s,\n        )\n        t1 := clock.now().value\n        proof := kernel_dependent_records.steps(\n          r,\n          f.body,\n          kernel_dependent_tactics.Goal {\n            env: r.env,\n            context: [],\n            target: goal,\n          },\n        ) except m { return Err(\"`\" + f.name + \"`: \" + m) }\n        r.env = kernel_dependent.define(r.env, \"m.\" + f.name, goal, proof)!\n        mut r.proven.push(\n          (\n            f.name,\n            clock.now().value - t1,\n            kernel_dependent_records.size(proof),\n          ),\n        )\n        mut names.push(f.name)\n      },\n      _ => (),\n    }\n  }\n  // each record of the module: its schema, that its field list is complete\n  // (by computation), and every law at it by application\n  inst := kernel_dependent_patch.records(r.env, decls)!\n  r.env = inst.env\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          kernel_dependent_records.at_record(mut r, td.name, names)!\n        },\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  Ok(r)\n}"},{"name":"kernel_dependent_records.is_named","kind":"fn","old":null,"new":"6b96e03748a1ab08","interface_changed":true,"affected":[],"module":"kernel_dependent_records","text":"/// Whether `t` is the type named `short`, qualified or not.\nfn is_named(t: ast.TypeExpr, short: String) -> Bool {\n  match t {\n    ast.Named { name, .. } => name == short || ends_with(name, \".\" + short),\n    _ => false,\n  }\n}"}]}
{"id":"48daf97122964063","time":1795853397,"message":"edit","changes":[{"name":"kernel_dependent_records.add_applied_at","kind":"fn","old":"e6d9d95cf012ac5e","new":"de6d0563c80b9d84","interface_changed":false,"affected":[],"module":"kernel_dependent_records","text":"/// The library's lemma about `mut self` methods: after `apply`, a field is\n/// as `patched` says if `fs` has it, else as before; by induction over `fs`.\nfn add_applied_at(\n  mut r: kernel_dependent_records.Records,\n  update: String,\n  pure: String,\n) -> Result[(), String] {\n  x := kernel_dependent_records.v(\"x\")\n  p := kernel_dependent_records.v(\"p\")\n  g := kernel_dependent_records.v(\"g\")\n  patch := kernel_dependent_records.type_of(mut r, ast.Named {\n    name: \"Patch\",\n    args: [ast.Named { name: \"T\", args: [] }],\n  }, [])!\n  stmt := kernel_dependent_records.pis(\n    kernel_dependent_records.schema() + [(\"p\", patch)],\n    kernel_dependent.pi(\n      \"x\",\n      kernel_dependent_records.record(),\n      kernel_dependent.pi(\n        \"g\",\n        kernel_dependent_records.v(\"F\"),\n        kernel_dependent.equality(0, kernel_dependent_records.app(\n          kernel_dependent_records.v(\"ty\"),\n          g,\n        ), kernel_dependent_records.app(kernel_dependent_records.at(\n          kernel_dependent_records.generic(update),\n          [x, p],\n        ), g), kernel_dependent_records.at(\n          kernel_dependent_records.c(\"ite\"),\n          [kernel_dependent_records.app(\n            kernel_dependent_records.v(\"ty\"),\n            g,\n          ), kernel_dependent_records.at(\n            kernel_dependent_records.c(\"has\"),\n            [\n              kernel_dependent_records.v(\"F\"),\n              kernel_dependent_records.v(\"ty\"),\n              kernel_dependent_records.v(\"deq\"),\n              kernel_dependent_records.v(\"fs\"),\n              g,\n            ],\n          ), kernel_dependent_records.app(kernel_dependent_records.at(\n            kernel_dependent_records.generic(pure),\n            [x, p],\n          ), g), kernel_dependent_records.app(x, g)],\n        )),\n      ),\n    ),\n  )\n  kernel_dependent_records.prove_applied_at(\n    mut r,\n    \"applied_at\",\n    stmt,\n  )\n}","old_text":"/// The library's lemma about `mut self` methods: after `apply`, a field is\n/// as `patched` says if `fs` has it, else as before; by induction over `fs`.\nfn add_applied_at(\n  mut r: kernel_dependent_records.Records,\n  update: String,\n  pure: String,\n) -> Result[(), String] {\n  x := kernel_dependent_records.v(\"x\")\n  p := kernel_dependent_records.v(\"p\")\n  g := kernel_dependent_records.v(\"g\")\n  patch := kernel_dependent_records.type_of(mut r, ast.Named {\n    name: \"Patch\",\n    args: [ast.Named { name: \"T\", args: [] }],\n  }, [])!\n  stmt := kernel_dependent_records.pis(\n    kernel_dependent_records.schema() + [(\"p\", patch)],\n    kernel_dependent.pi(\n      \"x\",\n      kernel_dependent_records.record(),\n      kernel_dependent.pi(\n        \"g\",\n        kernel_dependent_records.v(\"F\"),\n        kernel_dependent.equality(0, kernel_dependent_records.app(\n          kernel_dependent_records.v(\"ty\"),\n          g,\n        ), kernel_dependent_records.app(kernel_dependent_records.at(\n          kernel_dependent_records.generic(update),\n          [x, p],\n        ), g), kernel_dependent_records.at(\n          kernel_dependent_records.c(\"ite\"),\n          [kernel_dependent_records.app(\n            kernel_dependent_records.v(\"ty\"),\n            g,\n          ), kernel_dependent_records.at(\n            kernel_dependent_records.c(\"has\"),\n            [\n              kernel_dependent_records.v(\"F\"),\n              kernel_dependent_records.v(\"ty\"),\n              kernel_dependent_records.v(\"deq\"),\n              kernel_dependent_records.v(\"fs\"),\n              g,\n            ],\n          ), kernel_dependent_records.app(kernel_dependent_records.at(\n            kernel_dependent_records.generic(pure),\n            [x, p],\n          ), g), kernel_dependent_records.app(x, g)],\n        )),\n      ),\n    ),\n  )\n  kernel_dependent_records.prove_applied_at(\n    mut r,\n    update + \"_at\",\n    stmt,\n  )\n}"}]}
{"id":"d3b27fd838b46a3f","time":1795853429,"message":"edit","changes":[{"name":"kernel_dependent_records.at_record","kind":"fn","old":"e83835b3c25c846f","new":"6cafe99344ded553","interface_changed":false,"affected":[],"module":"kernel_dependent_records","text":"fn at_record(\n  mut r: kernel_dependent_records.Records,\n  t: String,\n  laws: List[String],\n) -> Result[(), String] {\n  field := kernel_dependent_records.c(t + \".Field\")\n  sc := [\n    field,\n    kernel_dependent_records.c(t + \".ty\"),\n    kernel_dependent_records.c(t + \".deq\"),\n    kernel_dependent_records.c(t + \".fields\"),\n  ]\n  ind := kernel_dependent.inductive_named(r.env, t + \".Field\") or {\n    return Err(\"`\" + t + \"`: no schema\")\n  }\n  has := (g: kernel_dependent_records.D) ->\n    kernel_dependent.holds(kernel_dependent_records.at(\n      kernel_dependent_records.c(\"has\"),\n      take(sc, 3) + [kernel_dependent_records.c(t + \".fields\"), g],\n    ))\n  all := kernel_dependent.lambda(\"g\", field, kernel_dependent_records.at(\n    kernel_dependent.Constant {\n      name: t + \".Field.rec\",\n      levels: [0],\n    },\n    [kernel_dependent.lambda(\n        \"z\",\n        field,\n        has(kernel_dependent_records.v(\"z\")),\n      )]\n      + ind.constructors.map(\n        _k -> kernel_dependent.reflexivity(\n          0,\n          kernel_dependent_records.c(\"Bool\"),\n          kernel_dependent_records.c(\"true\"),\n        ),\n      )\n      + [kernel_dependent_records.v(\"g\")],\n  ))\n  r.env = kernel_dependent.define(r.env, t + \".all\", kernel_dependent.pi(\n    \"g\",\n    field,\n    has(kernel_dependent_records.v(\"g\")),\n  ), all)!\n  for name in laws {\n    value := kernel_dependent_records.at(\n      kernel_dependent_records.c(\"m.\" + name),\n      sc + [kernel_dependent_records.c(t + \".all\")],\n    )\n    ty := kernel_dependent.infer(r.env, [], value)!\n    r.env = kernel_dependent.define(r.env, \"m.\" + t + \".\" + name, ty, value)!\n    mut r.instances.push(\n      (t + \".\" + name, kernel_dependent_tactics.show(ty, [])),\n    )\n  }\n  Ok(())\n}","old_text":"fn at_record(\n  mut r: kernel_dependent_records.Records,\n  t: String,\n  laws: List[String],\n) -> Result[(), String] {\n  field := kernel_dependent_records.c(t + \".Field\")\n  sc := [\n    field,\n    kernel_dependent_records.c(t + \".ty\"),\n    kernel_dependent_records.c(t + \".deq\"),\n    kernel_dependent_records.c(t + \".fields\"),\n  ]\n  ind := kernel_dependent.inductive_named(r.env, t + \".Field\") or {\n    return Err(\"`\" + t + \"`: no schema\")\n  }\n  has := (g: kernel_dependent_records.D) ->\n    kernel_dependent.holds(kernel_dependent_records.at(\n      kernel_dependent_records.c(\"has\"),\n      take(sc, 3) + [kernel_dependent_records.c(t + \".fields\"), g],\n    ))\n  all := kernel_dependent.lambda(\"g\", field, kernel_dependent_records.at(\n    kernel_dependent.Constant {\n      name: t + \".Field.rec\",\n      levels: [0],\n    },\n    [kernel_dependent.lambda(\n        \"z\",\n        field,\n        has(kernel_dependent_records.v(\"z\")),\n      )]\n      + ind.constructors.map(\n        _k -> kernel_dependent.reflexivity(\n          0,\n          kernel_dependent_records.c(\"Bool\"),\n          kernel_dependent_records.c(\"true\"),\n        ),\n      )\n      + [kernel_dependent_records.v(\"g\")],\n  ))\n  r.env = kernel_dependent.define(r.env, t + \".all\", kernel_dependent.pi(\n    \"g\",\n    field,\n    has(kernel_dependent_records.v(\"g\")),\n  ), all)!\n  for name in laws {\n    value := kernel_dependent_records.at(\n      kernel_dependent_records.c(\"m.\" + name),\n      sc + [kernel_dependent_records.c(t + \".all\")],\n    )\n    ty := kernel_dependent.infer(r.env, [], value)!\n    r.env = kernel_dependent.define(r.env, t + \".\" + name, ty, value)!\n    mut r.instances.push(\n      (t + \".\" + name, kernel_dependent_tactics.show(ty, [])),\n    )\n  }\n  Ok(())\n}"}]}
{"id":"9067035b54932b1c","time":1795853471,"message":"edit","changes":[{"name":"kernel_cli.every_record","kind":"fn","old":"f30f674e993c2dc1","new":"240f4bcc5f86af4c","interface_changed":false,"affected":[],"module":"kernel_cli","text":"/// The laws for every record a module states (`lemma l[T: Record]`),\n/// translated from its tree, proven and checked by the dependent kernel\n/// (kernel_dependent_records), then at each of its records. Whether all\n/// were.\nfn every_record(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  path: String,\n) -> Bool {\n  raw := match files.read_bytes(path) {\n    Ok(bytes) => match binary.read(bytes) {\n      Ok(img) => img.decls,\n      Err(_) => [],\n    },\n    Err(_) => [],\n  }\n  generic := raw.any(\n    d -> match d.kind {\n      ast.FnDef(f) => f.lemma && f.type_params == [\"T\"],\n      _ => false,\n    },\n  )\n  if !generic {\n    return true\n  }\n  t0 := clock.now().value\n  match kernel_dependent_records.laws(clock, raw) {\n    Ok(r) => {\n      mut console.write(\n        \"== \"\n          + path\n          + f\": laws for every record, from the module ({kernel_cli.milliseconds(clock.now().value - t0)} in all)\\n\",\n      )\n      mut console.write(\n        \"translated: type functions \"\n          + join(r.defaults.keys(), \", \")\n          + \"; methods \"\n          + join(r.methods, \", \")\n          + \"\\n\",\n      )\n\n      for (n, ns, size) in r.proven {\n        mut console.write(\n          \"proven for every record \"\n            + n\n            + \" (\"\n            + kernel_cli.milliseconds(ns)\n            + f\", a term of {size} nodes)\\n\",\n        )\n      }\n      for (n, s) in r.instances {\n        mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n      }\n      true\n    },\n    Err(m) => {\n      mut console.write(path + \": laws for every record: \" + m + \"\\n\")\n      false\n    },\n  }\n}","old_text":"/// The laws for every record a module states (`lemma l[T: Record]`),\n/// translated from its tree, proven and checked by the dependent kernel\n/// (kernel_dependent_records), then at each of its records. Whether all\n/// were.\nfn every_record(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  path: String,\n) -> Bool {\n  raw := match files.read_bytes(path) {\n    Ok(bytes) => match binary.read(bytes) {\n      Ok(img) => img.decls,\n      Err(_) => [],\n    },\n    Err(_) => [],\n  }\n  generic := raw.any(\n    d -> match d.kind {\n      ast.FnDef(f) => f.lemma && f.type_params == [\"T\"],\n      _ => false,\n    },\n  )\n  if !generic {\n    return true\n  }\n  t0 := clock.now().value\n  match kernel_dependent_records.laws(clock, raw) {\n    Ok(r) => {\n      mut console.write(\n        \"== \"\n          + path\n          + f\": laws for every record, from the module ({kernel_cli.milliseconds(clock.now().value - t0)} in all)\\n\",\n      )\n      mut console.write(\n        \"translated: type functions \"\n          + join(r.defaults.keys(), \", \")\n          + \"; methods \"\n          + join(r.methods, \", \")\n          + \"\\n\",\n      )\n      for d in raw {\n        match d.kind {\n          ast.FnDef(f) => if f.lemma {\n            mut console.write(\n              \"lemma \"\n                + f.name\n                + f\": {len(f.bounds)} bounds, type params {len(f.type_params)}\\n\",\n            )\n          },\n          _ => (),\n        }\n      }\n      for (n, ns, size) in r.proven {\n        mut console.write(\n          \"proven for every record \"\n            + n\n            + \" (\"\n            + kernel_cli.milliseconds(ns)\n            + f\", a term of {size} nodes)\\n\",\n        )\n      }\n      for (n, s) in r.instances {\n        mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n      }\n      true\n    },\n    Err(m) => {\n      mut console.write(path + \": laws for every record: \" + m + \"\\n\")\n      false\n    },\n  }\n}"}]}
{"id":"0dc516d4d0b33fa3","time":1795853615,"message":"edit","changes":[{"name":"kernel_dependent_records.Records","kind":"type","old":"c75a4e8a0c6c08b6","new":"73c5586af9045faa","interface_changed":true,"affected":["kernel_dependent_records.type_of","kernel_dependent_records.add_sum","kernel_dependent_records.add_type_function","kernel_dependent_records.type_value","kernel_dependent_records.expr","kernel_dependent_records.matched","kernel_dependent_records.add_impl","kernel_dependent_records.changed","kernel_dependent_records.statement","kernel_dependent_records.add_applied_at","kernel_dependent_records.prove_applied_at","kernel_dependent_records.steps","kernel_dependent_records.run","kernel_dependent_records.laws","kernel_dependent_records.at_record","kernel_cli.every_record","kernel_cli.dependent","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent_records","text":"/// The translation's state: the environment, each type function's default\n/// field constructor, the impl's methods (`mut self` ones as functions),\n/// the laws proven, each with its time and term size, and each law's\n/// instance at each record of the module, with its statement, and the\n/// laws left open (`?proof`), each with its goal.\npub type Records = {\n  env: kernel_dependent.Environment,\n  defaults: Dict[String, String],\n  methods: List[String],\n  updating: List[String],\n  proven: List[(String, Int, Int)],\n  instances: List[(String, String)],\n  open: List[(String, String)] = [],\n}","old_text":"/// The translation's state: the environment, each type function's default\n/// field constructor, the impl's methods (`mut self` ones as functions),\n/// the laws proven, each with its time and term size, and each law's\n/// instance at each record of the module, with its statement.\npub type Records = {\n  env: kernel_dependent.Environment,\n  defaults: Dict[String, String],\n  methods: List[String],\n  updating: List[String],\n  proven: List[(String, Int, Int)],\n  instances: List[(String, String)],\n}"},{"name":"kernel_dependent_records.laws","kind":"fn","old":"e3750eecaa11333f","new":"59a4254dabe20a69","interface_changed":false,"affected":["kernel_cli.every_record","kernel_cli.dependent","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent_records","text":"/// The module's laws for every record: its sums, type functions and\n/// blanket impl translated, each `lemma l[T: Record]` stated, proven by\n/// its steps and checked; each with its time and term size.\npub fn laws(\n  clock: std.time.SystemClock,\n  decls: List[ast.Decl],\n) -> Result[kernel_dependent_records.Records, String] {\n  mut checked := []\n  base := kernel_dependent_patch.definitions(\n    kernel_dependent_patch.base(\n      kernel_dependent.empty_environment(),\n    )!,\n  )!\n  env := kernel_dependent_patch.laws(clock, mut checked, base)!\n  mut r := kernel_dependent_records.Records {\n    env,\n    defaults: Dict[String, String] {},\n    methods: [],\n    updating: [],\n    proven: [],\n    instances: [],\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => match td.body {\n        ast.SumBody(_) => kernel_dependent_records.add_sum(mut r, td)!,\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if f.compile_time\n        && kernel_dependent_records.is_named(f.ret, \"Type\") {\n        kernel_dependent_records.add_type_function(mut r, f)!\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.ImplDef(imp) => if imp.bounds.any(\n        b -> b.traits.any(\n          t -> kernel_dependent_records.is_named(t, \"Record\"),\n        ),\n      ) {\n        kernel_dependent_records.add_impl(mut r, imp)!\n      },\n      _ => (),\n    }\n  }\n  if contains(r.updating, \"apply\") && contains(r.methods, \"patched\") {\n    kernel_dependent_records.add_applied_at(\n      mut r,\n      \"apply\",\n      \"patched\",\n    )!\n  }\n  mut names := []\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if f.lemma\n        && f.bounds.any(\n          b -> b.traits.any(\n            t -> kernel_dependent_records.is_named(t, \"Record\"),\n          ),\n        ) {\n        mut ps := []\n        for p in f.params {\n          mut ps.push(\n            (\n              p.name,\n              kernel_dependent_records.type_of(mut r, p.ty, [])!,\n            ),\n          )\n        }\n        ctx := (kernel_dependent_records.schema()\n          + [kernel_dependent_records.complete()]\n          + ps).reversed(\n        )\n        sc := kernel_dependent_records.Scope {\n          vars: ps.map(p -> (p.0, kernel_dependent_records.v(p.0))),\n          ctx,\n        }\n        body := get(f.post, 0) or {\n          return Err(\"`\" + f.name + \"` has no statement\")\n        }\n        s := kernel_dependent_records.statement(mut r, sc, ctx, body) except m {\n          return Err(\"`\" + f.name + \"`: \" + m)\n        }\n        goal := kernel_dependent_records.pis(\n          kernel_dependent_records.schema()\n            + [kernel_dependent_records.complete()]\n            + ps,\n          s,\n        )\n        match f.body {\n          ast.Hole(_) => {\n            mut r.open.push(\n              (f.name, kernel_dependent_tactics.show(goal, [])),\n            )\n            continue\n          },\n          _ => (),\n        }\n        t1 := clock.now().value\n        proof := kernel_dependent_records.steps(\n          r,\n          f.body,\n          kernel_dependent_tactics.Goal {\n            env: r.env,\n            context: [],\n            target: goal,\n          },\n        ) except m { return Err(\"`\" + f.name + \"`: \" + m) }\n        r.env = kernel_dependent.define(r.env, \"m.\" + f.name, goal, proof)!\n        mut r.proven.push(\n          (\n            f.name,\n            clock.now().value - t1,\n            kernel_dependent_records.size(proof),\n          ),\n        )\n        mut names.push(f.name)\n      },\n      _ => (),\n    }\n  }\n  // each record of the module: its schema, that its field list is complete\n  // (by computation), and every law at it by application\n  inst := kernel_dependent_patch.records(r.env, decls)!\n  r.env = inst.env\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          kernel_dependent_records.at_record(mut r, td.name, names)!\n        },\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  Ok(r)\n}","old_text":"/// The module's laws for every record: its sums, type functions and\n/// blanket impl translated, each `lemma l[T: Record]` stated, proven by\n/// its steps and checked; each with its time and term size.\npub fn laws(\n  clock: std.time.SystemClock,\n  decls: List[ast.Decl],\n) -> Result[kernel_dependent_records.Records, String] {\n  mut checked := []\n  base := kernel_dependent_patch.definitions(\n    kernel_dependent_patch.base(\n      kernel_dependent.empty_environment(),\n    )!,\n  )!\n  env := kernel_dependent_patch.laws(clock, mut checked, base)!\n  mut r := kernel_dependent_records.Records {\n    env,\n    defaults: Dict[String, String] {},\n    methods: [],\n    updating: [],\n    proven: [],\n    instances: [],\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => match td.body {\n        ast.SumBody(_) => kernel_dependent_records.add_sum(mut r, td)!,\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if f.compile_time\n        && kernel_dependent_records.is_named(f.ret, \"Type\") {\n        kernel_dependent_records.add_type_function(mut r, f)!\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.ImplDef(imp) => if imp.bounds.any(\n        b -> b.traits.any(\n          t -> kernel_dependent_records.is_named(t, \"Record\"),\n        ),\n      ) {\n        kernel_dependent_records.add_impl(mut r, imp)!\n      },\n      _ => (),\n    }\n  }\n  if contains(r.updating, \"apply\") && contains(r.methods, \"patched\") {\n    kernel_dependent_records.add_applied_at(\n      mut r,\n      \"apply\",\n      \"patched\",\n    )!\n  }\n  mut names := []\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if f.lemma\n        && f.bounds.any(\n          b -> b.traits.any(\n            t -> kernel_dependent_records.is_named(t, \"Record\"),\n          ),\n        ) {\n        mut ps := []\n        for p in f.params {\n          mut ps.push(\n            (\n              p.name,\n              kernel_dependent_records.type_of(mut r, p.ty, [])!,\n            ),\n          )\n        }\n        ctx := (kernel_dependent_records.schema()\n          + [kernel_dependent_records.complete()]\n          + ps).reversed(\n        )\n        sc := kernel_dependent_records.Scope {\n          vars: ps.map(p -> (p.0, kernel_dependent_records.v(p.0))),\n          ctx,\n        }\n        body := get(f.post, 0) or {\n          return Err(\"`\" + f.name + \"` has no statement\")\n        }\n        s := kernel_dependent_records.statement(mut r, sc, ctx, body) except m {\n          return Err(\"`\" + f.name + \"`: \" + m)\n        }\n        goal := kernel_dependent_records.pis(\n          kernel_dependent_records.schema()\n            + [kernel_dependent_records.complete()]\n            + ps,\n          s,\n        )\n        t1 := clock.now().value\n        proof := kernel_dependent_records.steps(\n          r,\n          f.body,\n          kernel_dependent_tactics.Goal {\n            env: r.env,\n            context: [],\n            target: goal,\n          },\n        ) except m { return Err(\"`\" + f.name + \"`: \" + m) }\n        r.env = kernel_dependent.define(r.env, \"m.\" + f.name, goal, proof)!\n        mut r.proven.push(\n          (\n            f.name,\n            clock.now().value - t1,\n            kernel_dependent_records.size(proof),\n          ),\n        )\n        mut names.push(f.name)\n      },\n      _ => (),\n    }\n  }\n  // each record of the module: its schema, that its field list is complete\n  // (by computation), and every law at it by application\n  inst := kernel_dependent_patch.records(r.env, decls)!\n  r.env = inst.env\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          kernel_dependent_records.at_record(mut r, td.name, names)!\n        },\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  Ok(r)\n}"}]}
{"id":"1158fab124ea5f86","time":1795853631,"message":"edit","changes":[{"name":"kernel_cli.every_record","kind":"fn","old":"240f4bcc5f86af4c","new":"32d8f6c84768adc0","interface_changed":false,"affected":[],"module":"kernel_cli","text":"/// The laws for every record a module states (`lemma l[T: Record]`),\n/// translated from its tree, proven and checked by the dependent kernel\n/// (kernel_dependent_records), then at each of its records. Whether all\n/// were.\nfn every_record(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  path: String,\n) -> Bool {\n  raw := match files.read_bytes(path) {\n    Ok(bytes) => match binary.read(bytes) {\n      Ok(img) => img.decls,\n      Err(_) => [],\n    },\n    Err(_) => [],\n  }\n  generic := raw.any(\n    d -> match d.kind {\n      ast.FnDef(f) => f.lemma && f.type_params == [\"T\"],\n      _ => false,\n    },\n  )\n  if !generic {\n    return true\n  }\n  t0 := clock.now().value\n  match kernel_dependent_records.laws(clock, raw) {\n    Ok(r) => {\n      mut console.write(\n        \"== \"\n          + path\n          + f\": laws for every record, from the module ({kernel_cli.milliseconds(clock.now().value - t0)} in all)\\n\",\n      )\n      mut console.write(\n        \"translated: type functions \"\n          + join(r.defaults.keys(), \", \")\n          + \"; methods \"\n          + join(r.methods, \", \")\n          + \"\\n\",\n      )\n\n      for (n, ns, size) in r.proven {\n        mut console.write(\n          \"proven for every record \"\n            + n\n            + \" (\"\n            + kernel_cli.milliseconds(ns)\n            + f\", a term of {size} nodes)\\n\",\n        )\n      }\n      for (n, g) in r.open {\n        mut console.write(\"open   \" + n + \"\\n  ⊢ \" + g + \"\\n\")\n      }\n      for (n, s) in r.instances {\n        mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n      }\n      true\n    },\n    Err(m) => {\n      mut console.write(path + \": laws for every record: \" + m + \"\\n\")\n      false\n    },\n  }\n}","old_text":"/// The laws for every record a module states (`lemma l[T: Record]`),\n/// translated from its tree, proven and checked by the dependent kernel\n/// (kernel_dependent_records), then at each of its records. Whether all\n/// were.\nfn every_record(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  path: String,\n) -> Bool {\n  raw := match files.read_bytes(path) {\n    Ok(bytes) => match binary.read(bytes) {\n      Ok(img) => img.decls,\n      Err(_) => [],\n    },\n    Err(_) => [],\n  }\n  generic := raw.any(\n    d -> match d.kind {\n      ast.FnDef(f) => f.lemma && f.type_params == [\"T\"],\n      _ => false,\n    },\n  )\n  if !generic {\n    return true\n  }\n  t0 := clock.now().value\n  match kernel_dependent_records.laws(clock, raw) {\n    Ok(r) => {\n      mut console.write(\n        \"== \"\n          + path\n          + f\": laws for every record, from the module ({kernel_cli.milliseconds(clock.now().value - t0)} in all)\\n\",\n      )\n      mut console.write(\n        \"translated: type functions \"\n          + join(r.defaults.keys(), \", \")\n          + \"; methods \"\n          + join(r.methods, \", \")\n          + \"\\n\",\n      )\n\n      for (n, ns, size) in r.proven {\n        mut console.write(\n          \"proven for every record \"\n            + n\n            + \" (\"\n            + kernel_cli.milliseconds(ns)\n            + f\", a term of {size} nodes)\\n\",\n        )\n      }\n      for (n, s) in r.instances {\n        mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n      }\n      true\n    },\n    Err(m) => {\n      mut console.write(path + \": laws for every record: \" + m + \"\\n\")\n      false\n    },\n  }\n}"}]}
{"id":"150ed6644370ee46","time":1795853726,"message":"edit","changes":[{"name":"kernel_dependent_records.Records","kind":"type","old":"73c5586af9045faa","new":"4839c38b614cbb76","interface_changed":true,"affected":["kernel_dependent_records.type_of","kernel_dependent_records.add_sum","kernel_dependent_records.add_type_function","kernel_dependent_records.type_value","kernel_dependent_records.expr","kernel_dependent_records.matched","kernel_dependent_records.add_impl","kernel_dependent_records.changed","kernel_dependent_records.statement","kernel_dependent_records.add_applied_at","kernel_dependent_records.prove_applied_at","kernel_dependent_records.steps","kernel_dependent_records.run","kernel_dependent_records.laws","kernel_dependent_records.at_record","kernel_cli.every_record","kernel_cli.dependent","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent_records","text":"/// The translation's state: the environment, each type function's default\n/// field constructor, the impl's methods (`mut self` ones as functions),\n/// the laws proven, each with its time and term size, and each law's\n/// instance at each record of the module, with its statement, and the\n/// laws left open (`?proof`), each with its goal.\npub type Records = {\n  env: kernel_dependent.Environment,\n  defaults: Dict[String, String],\n  methods: List[String],\n  updating: List[String],\n  proven: List[(String, Int, Int)],\n  instances: List[(String, String)],\n  open: List[(String, String)] = [],\n  failed: List[(String, String)] = [],\n}","old_text":"/// The translation's state: the environment, each type function's default\n/// field constructor, the impl's methods (`mut self` ones as functions),\n/// the laws proven, each with its time and term size, and each law's\n/// instance at each record of the module, with its statement, and the\n/// laws left open (`?proof`), each with its goal.\npub type Records = {\n  env: kernel_dependent.Environment,\n  defaults: Dict[String, String],\n  methods: List[String],\n  updating: List[String],\n  proven: List[(String, Int, Int)],\n  instances: List[(String, String)],\n  open: List[(String, String)] = [],\n}"},{"name":"kernel_dependent_records.laws","kind":"fn","old":"59a4254dabe20a69","new":"637fd4abdff6c767","interface_changed":false,"affected":["kernel_cli.every_record","kernel_cli.dependent","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent_records","text":"/// The module's laws for every record: its sums, type functions and\n/// blanket impl translated, each `lemma l[T: Record]` stated, proven by\n/// its steps and checked; each with its time and term size.\npub fn laws(\n  clock: std.time.SystemClock,\n  decls: List[ast.Decl],\n) -> Result[kernel_dependent_records.Records, String] {\n  mut checked := []\n  base := kernel_dependent_patch.definitions(\n    kernel_dependent_patch.base(\n      kernel_dependent.empty_environment(),\n    )!,\n  )!\n  env := kernel_dependent_patch.laws(clock, mut checked, base)!\n  mut r := kernel_dependent_records.Records {\n    env,\n    defaults: Dict[String, String] {},\n    methods: [],\n    updating: [],\n    proven: [],\n    instances: [],\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => match td.body {\n        ast.SumBody(_) => kernel_dependent_records.add_sum(mut r, td)!,\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if f.compile_time\n        && kernel_dependent_records.is_named(f.ret, \"Type\") {\n        kernel_dependent_records.add_type_function(mut r, f)!\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.ImplDef(imp) => if imp.bounds.any(\n        b -> b.traits.any(\n          t -> kernel_dependent_records.is_named(t, \"Record\"),\n        ),\n      ) {\n        kernel_dependent_records.add_impl(mut r, imp)!\n      },\n      _ => (),\n    }\n  }\n  if contains(r.updating, \"apply\") && contains(r.methods, \"patched\") {\n    kernel_dependent_records.add_applied_at(\n      mut r,\n      \"apply\",\n      \"patched\",\n    )!\n  }\n  mut names := []\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if f.lemma\n        && f.bounds.any(\n          b -> b.traits.any(\n            t -> kernel_dependent_records.is_named(t, \"Record\"),\n          ),\n        ) {\n        mut ps := []\n        for p in f.params {\n          mut ps.push(\n            (\n              p.name,\n              kernel_dependent_records.type_of(mut r, p.ty, [])!,\n            ),\n          )\n        }\n        ctx := (kernel_dependent_records.schema()\n          + [kernel_dependent_records.complete()]\n          + ps).reversed(\n        )\n        sc := kernel_dependent_records.Scope {\n          vars: ps.map(p -> (p.0, kernel_dependent_records.v(p.0))),\n          ctx,\n        }\n        body := get(f.post, 0) or {\n          return Err(\"`\" + f.name + \"` has no statement\")\n        }\n        s := kernel_dependent_records.statement(mut r, sc, ctx, body) except m {\n          return Err(\"`\" + f.name + \"`: \" + m)\n        }\n        goal := kernel_dependent_records.pis(\n          kernel_dependent_records.schema()\n            + [kernel_dependent_records.complete()]\n            + ps,\n          s,\n        )\n        match f.body {\n          ast.Hole(_) => {\n            mut r.open.push(\n              (f.name, kernel_dependent_tactics.show(goal, [])),\n            )\n            continue\n          },\n          _ => (),\n        }\n        t1 := clock.now().value\n        proof := kernel_dependent_records.steps(\n          r,\n          f.body,\n          kernel_dependent_tactics.Goal {\n            env: r.env,\n            context: [],\n            target: goal,\n          },\n        ) except m {\n          mut r.failed.push((f.name, m))\n          continue\n        }\n        r.env = kernel_dependent.define(r.env, \"m.\" + f.name, goal, proof) except m {\n          mut r.failed.push((f.name, \"the kernel: \" + m))\n          continue\n        }\n        mut r.proven.push(\n          (\n            f.name,\n            clock.now().value - t1,\n            kernel_dependent_records.size(proof),\n          ),\n        )\n        mut names.push(f.name)\n      },\n      _ => (),\n    }\n  }\n  // each record of the module: its schema, that its field list is complete\n  // (by computation), and every law at it by application\n  inst := kernel_dependent_patch.records(r.env, decls)!\n  r.env = inst.env\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          kernel_dependent_records.at_record(mut r, td.name, names)!\n        },\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  Ok(r)\n}","old_text":"/// The module's laws for every record: its sums, type functions and\n/// blanket impl translated, each `lemma l[T: Record]` stated, proven by\n/// its steps and checked; each with its time and term size.\npub fn laws(\n  clock: std.time.SystemClock,\n  decls: List[ast.Decl],\n) -> Result[kernel_dependent_records.Records, String] {\n  mut checked := []\n  base := kernel_dependent_patch.definitions(\n    kernel_dependent_patch.base(\n      kernel_dependent.empty_environment(),\n    )!,\n  )!\n  env := kernel_dependent_patch.laws(clock, mut checked, base)!\n  mut r := kernel_dependent_records.Records {\n    env,\n    defaults: Dict[String, String] {},\n    methods: [],\n    updating: [],\n    proven: [],\n    instances: [],\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => match td.body {\n        ast.SumBody(_) => kernel_dependent_records.add_sum(mut r, td)!,\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if f.compile_time\n        && kernel_dependent_records.is_named(f.ret, \"Type\") {\n        kernel_dependent_records.add_type_function(mut r, f)!\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.ImplDef(imp) => if imp.bounds.any(\n        b -> b.traits.any(\n          t -> kernel_dependent_records.is_named(t, \"Record\"),\n        ),\n      ) {\n        kernel_dependent_records.add_impl(mut r, imp)!\n      },\n      _ => (),\n    }\n  }\n  if contains(r.updating, \"apply\") && contains(r.methods, \"patched\") {\n    kernel_dependent_records.add_applied_at(\n      mut r,\n      \"apply\",\n      \"patched\",\n    )!\n  }\n  mut names := []\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if f.lemma\n        && f.bounds.any(\n          b -> b.traits.any(\n            t -> kernel_dependent_records.is_named(t, \"Record\"),\n          ),\n        ) {\n        mut ps := []\n        for p in f.params {\n          mut ps.push(\n            (\n              p.name,\n              kernel_dependent_records.type_of(mut r, p.ty, [])!,\n            ),\n          )\n        }\n        ctx := (kernel_dependent_records.schema()\n          + [kernel_dependent_records.complete()]\n          + ps).reversed(\n        )\n        sc := kernel_dependent_records.Scope {\n          vars: ps.map(p -> (p.0, kernel_dependent_records.v(p.0))),\n          ctx,\n        }\n        body := get(f.post, 0) or {\n          return Err(\"`\" + f.name + \"` has no statement\")\n        }\n        s := kernel_dependent_records.statement(mut r, sc, ctx, body) except m {\n          return Err(\"`\" + f.name + \"`: \" + m)\n        }\n        goal := kernel_dependent_records.pis(\n          kernel_dependent_records.schema()\n            + [kernel_dependent_records.complete()]\n            + ps,\n          s,\n        )\n        match f.body {\n          ast.Hole(_) => {\n            mut r.open.push(\n              (f.name, kernel_dependent_tactics.show(goal, [])),\n            )\n            continue\n          },\n          _ => (),\n        }\n        t1 := clock.now().value\n        proof := kernel_dependent_records.steps(\n          r,\n          f.body,\n          kernel_dependent_tactics.Goal {\n            env: r.env,\n            context: [],\n            target: goal,\n          },\n        ) except m { return Err(\"`\" + f.name + \"`: \" + m) }\n        r.env = kernel_dependent.define(r.env, \"m.\" + f.name, goal, proof)!\n        mut r.proven.push(\n          (\n            f.name,\n            clock.now().value - t1,\n            kernel_dependent_records.size(proof),\n          ),\n        )\n        mut names.push(f.name)\n      },\n      _ => (),\n    }\n  }\n  // each record of the module: its schema, that its field list is complete\n  // (by computation), and every law at it by application\n  inst := kernel_dependent_patch.records(r.env, decls)!\n  r.env = inst.env\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          kernel_dependent_records.at_record(mut r, td.name, names)!\n        },\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  Ok(r)\n}"}]}
{"id":"81c3b10ac8b13e45","time":1795853760,"message":"edit","changes":[{"name":"kernel_cli.every_record","kind":"fn","old":"32d8f6c84768adc0","new":"3a30363b6ec9322e","interface_changed":false,"affected":[],"module":"kernel_cli","text":"/// The laws for every record a module states (`lemma l[T: Record]`),\n/// translated from its tree, proven and checked by the dependent kernel\n/// (kernel_dependent_records), then at each of its records. Whether all\n/// were.\nfn every_record(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  path: String,\n) -> Bool {\n  raw := match files.read_bytes(path) {\n    Ok(bytes) => match binary.read(bytes) {\n      Ok(img) => img.decls,\n      Err(_) => [],\n    },\n    Err(_) => [],\n  }\n  generic := raw.any(\n    d -> match d.kind {\n      ast.FnDef(f) => f.lemma && f.type_params == [\"T\"],\n      _ => false,\n    },\n  )\n  if !generic {\n    return true\n  }\n  t0 := clock.now().value\n  match kernel_dependent_records.laws(clock, raw) {\n    Ok(r) => {\n      mut console.write(\n        \"== \"\n          + path\n          + f\": laws for every record, from the module ({kernel_cli.milliseconds(clock.now().value - t0)} in all)\\n\",\n      )\n      mut console.write(\n        \"translated: type functions \"\n          + join(r.defaults.keys(), \", \")\n          + \"; methods \"\n          + join(r.methods, \", \")\n          + \"\\n\",\n      )\n\n      for (n, ns, size) in r.proven {\n        mut console.write(\n          \"proven for every record \"\n            + n\n            + \" (\"\n            + kernel_cli.milliseconds(ns)\n            + f\", a term of {size} nodes)\\n\",\n        )\n      }\n      for (n, m) in r.failed {\n        mut console.write(\"failed \" + n + \": \" + m + \"\\n\")\n      }\n      for (n, g) in r.open {\n        mut console.write(\"open   \" + n + \"\\n  ⊢ \" + g + \"\\n\")\n      }\n      for (n, s) in r.instances {\n        mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n      }\n      r.failed == []\n    },\n    Err(m) => {\n      mut console.write(path + \": laws for every record: \" + m + \"\\n\")\n      false\n    },\n  }\n}","old_text":"/// The laws for every record a module states (`lemma l[T: Record]`),\n/// translated from its tree, proven and checked by the dependent kernel\n/// (kernel_dependent_records), then at each of its records. Whether all\n/// were.\nfn every_record(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  path: String,\n) -> Bool {\n  raw := match files.read_bytes(path) {\n    Ok(bytes) => match binary.read(bytes) {\n      Ok(img) => img.decls,\n      Err(_) => [],\n    },\n    Err(_) => [],\n  }\n  generic := raw.any(\n    d -> match d.kind {\n      ast.FnDef(f) => f.lemma && f.type_params == [\"T\"],\n      _ => false,\n    },\n  )\n  if !generic {\n    return true\n  }\n  t0 := clock.now().value\n  match kernel_dependent_records.laws(clock, raw) {\n    Ok(r) => {\n      mut console.write(\n        \"== \"\n          + path\n          + f\": laws for every record, from the module ({kernel_cli.milliseconds(clock.now().value - t0)} in all)\\n\",\n      )\n      mut console.write(\n        \"translated: type functions \"\n          + join(r.defaults.keys(), \", \")\n          + \"; methods \"\n          + join(r.methods, \", \")\n          + \"\\n\",\n      )\n\n      for (n, ns, size) in r.proven {\n        mut console.write(\n          \"proven for every record \"\n            + n\n            + \" (\"\n            + kernel_cli.milliseconds(ns)\n            + f\", a term of {size} nodes)\\n\",\n        )\n      }\n      for (n, g) in r.open {\n        mut console.write(\"open   \" + n + \"\\n  ⊢ \" + g + \"\\n\")\n      }\n      for (n, s) in r.instances {\n        mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n      }\n      true\n    },\n    Err(m) => {\n      mut console.write(path + \": laws for every record: \" + m + \"\\n\")\n      false\n    },\n  }\n}"}]}
{"id":"54b30f97369c06d0","time":1795854055,"message":"edit","changes":[{"name":"kernel_translate.add_datatypes","kind":"fn","old":"2dcd947e889f07b2","new":"580f9e8bb5a80696","interface_changed":false,"affected":[],"module":"kernel_translate","text":"pub fn add_datatypes(\n  mut thy: kernel_translate.Theory,\n  tds: List[ast.TypeDecl],\n) -> Result[(), String] {\n  names := tds.map(td -> td.name)\n  params := match tds {\n    [first, ..] => first.params,\n    [] => return Ok(()),\n  }\n  // each type as a type value, then as a datatype definition\n  defs := tds.map(\n    td -> kernel_translate.datatype_of(\n      kernel_translate.type_value(thy, td),\n    ),\n  )\n  mut nested_names := []\n  for d in defs {\n    for v in d.variants {\n      for a in v.argument_types {\n        match a {\n          kernel.TypeApplication { name: \"List\", arguments: [kernel.TypeApplication { name: x, .. }] } => if contains(names, x) && !contains(nested_names, x) {\n            mut nested_names.push(x)\n          },\n          _ => (),\n        }\n      }\n    }\n  }\n  companions := nested_names.map(x -> \"List_\" + x)\n  for (i, x) in enumerate(nested_names) {\n    mut thy.nested.insert(x, get(companions, i) ?? x)\n  }\n  mut specs := []\n  mut all_fields := []\n  for d in defs {\n    if d.type_parameters != params {\n      return Err(\"`\"\n        + d.name\n        + \"`: the types of a recursive group must have the same parameters\")\n    }\n    mut ctors := []\n    mut fields := []\n    for v in d.variants {\n      mut tys := []\n      for a in v.argument_types {\n        nested := kernel_translate.nest_type(thy, a)\n        kernel_translate.known_type(thy, names + companions, nested)!\n        mut tys.push(nested)\n      }\n      mut ctors.push((v.name, tys))\n      mut fields.push(v.field_names)\n      for (f, given) in zip(v.field_names, v.field_defaults) {\n        match given {\n          Some(src) => match parse.parse_expr(src) {\n            Ok(e) => mut thy.defaults.insert(v.name + \".\" + f, e),\n            Err(m) => return Err(\"`\" + v.name + \".\" + f + \"`'s default: \" + m),\n          },\n          None => (),\n        }\n      }\n    }\n    if len(ctors) == 0 {\n      return Err(\"`\" + d.name + \"`: not a record or a sum\")\n    }\n    mut specs.push(kernel.DatatypeSpec { name: d.name, params, ctors })\n    mut all_fields.push(fields)\n  }\n  for (i, x) in enumerate(nested_names) {\n    c := get(companions, i) ?? x\n    elem := kernel.TypeApplication {\n      name: x,\n      arguments: params.map(q -> kernel.TypeVariable(q)),\n    }\n    self := kernel.TypeApplication {\n      name: c,\n      arguments: params.map(q -> kernel.TypeVariable(q)),\n    }\n    mut specs.push(\n      kernel.DatatypeSpec {\n        name: c,\n        params,\n        ctors: [(c + \".nil\", []), (c + \".cons\", [elem, self])],\n      },\n    )\n    mut all_fields.push([[], []])\n  }\n  facts := kernel.datatypes(specs)!\n  for (i, spec) in enumerate(specs) {\n    f := get(facts, i) or { return Err(\"datatypes: facts missing\") }\n    self_ty := kernel.TypeApplication {\n      name: spec.name,\n      arguments: params.map(q -> kernel.TypeVariable(q)),\n    }\n    d := kernel_translate.Datatype {\n      name: spec.name,\n      params,\n      ctors: spec.ctors,\n      fields: get(all_fields, i) ?? [],\n      facts: f,\n    }\n    mut thy.datatypes.insert(spec.name, d)\n    for (c, args) in spec.ctors {\n      mut thy.consts.insert(c, kernel.function_type_of(args, self_ty))\n      mut thy.ctor_type.insert(c, spec.name)\n    }\n    r := kernel.TypeVariable(\"r\")\n    mut thy.consts.insert(\n      f.recursor,\n      match f.recursion {\n        [first, ..] => kernel_translate.const_type(\n          kernel.conclusion(first),\n          f.recursor,\n        ) ?? r,\n        [] => r,\n      },\n    )\n    mut thy.consts.insert(\n      f.case_name,\n      match f.cases {\n        [first, ..] => kernel_translate.const_type(\n          kernel.conclusion(first),\n          f.case_name,\n        ) ?? r,\n        [] => r,\n      },\n    )\n    mut distinct := f.distinct\n    for th in f.distinct {\n      mut distinct.push(kernel_translate.flipped_distinct(th)!)\n    }\n    mut thy.theorems.insert(spec.name + \".inject\", f.injective)\n    mut thy.theorems.insert(spec.name + \".distinct\", distinct)\n    mut thy.theorems.insert(spec.name + \".induct\", [f.induction])\n    mut thy.theorems.insert(f.recursor, f.recursion)\n    mut thy.theorems.insert(f.case_name, f.cases)\n    mut thy.simp.push(spec.name + \".inject\")\n    mut thy.simp.push(spec.name + \".distinct\")\n    mut thy.simp.push(f.recursor)\n    mut thy.simp.push(f.case_name)\n    // a `match` whose arms all give the same value is that value\n    match kernel_translate.case_same(thy, d) {\n      Ok(th) => {\n        mut thy.theorems.insert(\n          spec.name + \".case_same\",\n          [kernel.named(spec.name + \".case_same\", th)],\n        )\n        mut thy.simp.push(spec.name + \".case_same\")\n      },\n      Err(m) => mut thy.notes.push(\"`\" + spec.name + \"`: \" + m),\n    }\n    // a record's fields: `T.f (T x1 … xn) = xi`\n    if len(spec.ctors) == 1 {\n      for (k, fname) in enumerate(get(d.fields, 0) ?? []) {\n        kernel_translate.add_field(mut thy, d, k, fname)!\n      }\n      // record eta: `T { ..t } == t`, used by simplify\n      if len(get(d.fields, 0) ?? []) > 0 {\n        match kernel_translate.record_eta(thy, d) {\n          Ok(th) => {\n            mut thy.theorems.insert(\n              spec.name + \".eta\",\n              [kernel.named(spec.name + \".eta\", th)],\n            )\n            mut thy.simp.push(spec.name + \".eta\")\n          },\n          Err(m) => mut thy.notes.push(\"`\" + spec.name + \"` eta: \" + m),\n        }\n      }\n    }\n  }\n  Ok(())\n}","old_text":"pub fn add_datatypes(\n  mut thy: kernel_translate.Theory,\n  tds: List[ast.TypeDecl],\n) -> Result[(), String] {\n  names := tds.map(td -> td.name)\n  params := match tds {\n    [first, ..] => first.params,\n    [] => return Ok(()),\n  }\n  // each type as a type value, then as a datatype definition\n  defs := tds.map(\n    td -> kernel_translate.datatype_of(\n      kernel_translate.type_value(thy, td),\n    ),\n  )\n  mut nested_names := []\n  for d in defs {\n    for v in d.variants {\n      for a in v.argument_types {\n        match a {\n          kernel.TypeApplication { name: \"List\", arguments: [kernel.TypeApplication { name: x, .. }] } => if contains(names, x) && !contains(nested_names, x) {\n            mut nested_names.push(x)\n          },\n          _ => (),\n        }\n      }\n    }\n  }\n  companions := nested_names.map(x -> \"List_\" + x)\n  for (i, x) in enumerate(nested_names) {\n    mut thy.nested.insert(x, get(companions, i) ?? x)\n  }\n  mut specs := []\n  mut all_fields := []\n  for d in defs {\n    if d.type_parameters != params {\n      return Err(\"`\"\n        + d.name\n        + \"`: the types of a recursive group must have the same parameters\")\n    }\n    mut ctors := []\n    mut fields := []\n    for v in d.variants {\n      mut tys := []\n      for a in v.argument_types {\n        nested := kernel_translate.nest_type(thy, a)\n        kernel_translate.known_type(thy, names + companions, nested)!\n        mut tys.push(nested)\n      }\n      mut ctors.push((v.name, tys))\n      mut fields.push(v.field_names)\n      for (f, given) in zip(v.field_names, v.field_defaults) {\n        match given {\n          Some(src) => match parse.parse_expr(src) {\n            Ok(e) => mut thy.defaults.insert(v.name + \".\" + f, e),\n            Err(m) => return Err(\"`\" + v.name + \".\" + f + \"`'s default: \" + m),\n          },\n          None => (),\n        }\n      }\n    }\n    if len(ctors) == 0 {\n      return Err(\"`\" + d.name + \"`: not a record or a sum\")\n    }\n    mut specs.push(kernel.DatatypeSpec { name: d.name, params, ctors })\n    mut all_fields.push(fields)\n  }\n  for (i, x) in enumerate(nested_names) {\n    c := get(companions, i) ?? x\n    elem := kernel.TypeApplication {\n      name: x,\n      arguments: params.map(q -> kernel.TypeVariable(q)),\n    }\n    self := kernel.TypeApplication {\n      name: c,\n      arguments: params.map(q -> kernel.TypeVariable(q)),\n    }\n    mut specs.push(\n      kernel.DatatypeSpec {\n        name: c,\n        params,\n        ctors: [(c + \".nil\", []), (c + \".cons\", [elem, self])],\n      },\n    )\n    mut all_fields.push([[], []])\n  }\n  facts := kernel.datatypes(specs)!\n  for (i, spec) in enumerate(specs) {\n    f := get(facts, i) or { return Err(\"datatypes: facts missing\") }\n    self_ty := kernel.TypeApplication {\n      name: spec.name,\n      arguments: params.map(q -> kernel.TypeVariable(q)),\n    }\n    d := kernel_translate.Datatype {\n      name: spec.name,\n      params,\n      ctors: spec.ctors,\n      fields: get(all_fields, i) ?? [],\n      facts: f,\n    }\n    mut thy.datatypes.insert(spec.name, d)\n    for (c, args) in spec.ctors {\n      mut thy.consts.insert(c, kernel.function_type_of(args, self_ty))\n      mut thy.ctor_type.insert(c, spec.name)\n    }\n    r := kernel.TypeVariable(\"r\")\n    mut thy.consts.insert(\n      f.recursor,\n      match f.recursion {\n        [first, ..] => kernel_translate.const_type(\n          kernel.conclusion(first),\n          f.recursor,\n        ) ?? r,\n        [] => r,\n      },\n    )\n    mut thy.consts.insert(\n      f.case_name,\n      match f.cases {\n        [first, ..] => kernel_translate.const_type(\n          kernel.conclusion(first),\n          f.case_name,\n        ) ?? r,\n        [] => r,\n      },\n    )\n    mut distinct := f.distinct\n    for th in f.distinct {\n      mut distinct.push(kernel_translate.flipped_distinct(th)!)\n    }\n    mut thy.theorems.insert(spec.name + \".inject\", f.injective)\n    mut thy.theorems.insert(spec.name + \".distinct\", distinct)\n    mut thy.theorems.insert(spec.name + \".induct\", [f.induction])\n    mut thy.theorems.insert(f.recursor, f.recursion)\n    mut thy.theorems.insert(f.case_name, f.cases)\n    mut thy.simp.push(spec.name + \".inject\")\n    mut thy.simp.push(spec.name + \".distinct\")\n    mut thy.simp.push(f.recursor)\n    mut thy.simp.push(f.case_name)\n    // a `match` whose arms all give the same value is that value\n    match kernel_translate.case_same(thy, d) {\n      Ok(th) => {\n        mut thy.theorems.insert(spec.name + \".case_same\", [th])\n        mut thy.simp.push(spec.name + \".case_same\")\n      },\n      Err(m) => mut thy.notes.push(\"`\" + spec.name + \"`: \" + m),\n    }\n    // a record's fields: `T.f (T x1 … xn) = xi`\n    if len(spec.ctors) == 1 {\n      for (k, fname) in enumerate(get(d.fields, 0) ?? []) {\n        kernel_translate.add_field(mut thy, d, k, fname)!\n      }\n      // record eta: `T { ..t } == t`, used by simplify\n      if len(get(d.fields, 0) ?? []) > 0 {\n        match kernel_translate.record_eta(thy, d) {\n          Ok(th) => {\n            mut thy.theorems.insert(spec.name + \".eta\", [th])\n            mut thy.simp.push(spec.name + \".eta\")\n          },\n          Err(m) => mut thy.notes.push(\"`\" + spec.name + \"` eta: \" + m),\n        }\n      }\n    }\n  }\n  Ok(())\n}"},{"name":"kernel_translate.add_field","kind":"fn","old":"59972ffbbee18bdc","new":"0677cf28e8248ac3","interface_changed":false,"affected":[],"module":"kernel_translate","text":"fn add_field(\n  mut thy: kernel_translate.Theory,\n  d: kernel_translate.Datatype,\n  i: Int,\n  field: String,\n) -> Result[(), String] {\n  (c, args) := get(d.ctors, 0) ?? (\"\", [])\n  self_ty := kernel.TypeApplication {\n    name: d.name,\n    arguments: d.params.map(p -> kernel.TypeVariable(p)),\n  }\n  fty := get(args, i) ?? self_ty\n  xs := enumerate(args).map(\n    p ->\n      kernel.Variable {\n        name: \"x\" + to_string(p.0),\n        value_type: p.1,\n      },\n  )\n  pick := kernel_translate.lambdas(\n    xs,\n    get(xs, i) ?? kernel_translate.self_ty_dummy(),\n  )\n  case_c := kernel.Constant {\n    name: d.facts.case_name,\n    value_type: kernel.function_type_of([kernel.type_of(pick)!, self_ty], fty),\n  }\n  name := d.name + \".\" + field\n  def := kernel.define(\n    name,\n    kernel.Application { function: case_c, argument: pick },\n  )!\n  mut thy.consts.insert(name, kernel.function_type(self_ty, fty))\n  lhs := kernel.Application { function: kernel.Constant {\n    name,\n    value_type: kernel.function_type(self_ty, fty),\n  }, argument: kernel.apply_all(kernel.Constant {\n    name: c,\n    value_type: kernel.function_type_of(args, self_ty),\n  }, xs) }\n  eq := kernel_translate.equation(thy, [def], lhs, get(xs, i) ?? lhs)!\n  mut thy.theorems.insert(\n    name,\n    [kernel.named(name, kernel_translate.close(eq, xs)!)],\n  )\n  mut thy.simp.push(name)\n  Ok(())\n}","old_text":"fn add_field(\n  mut thy: kernel_translate.Theory,\n  d: kernel_translate.Datatype,\n  i: Int,\n  field: String,\n) -> Result[(), String] {\n  (c, args) := get(d.ctors, 0) ?? (\"\", [])\n  self_ty := kernel.TypeApplication {\n    name: d.name,\n    arguments: d.params.map(p -> kernel.TypeVariable(p)),\n  }\n  fty := get(args, i) ?? self_ty\n  xs := enumerate(args).map(\n    p ->\n      kernel.Variable {\n        name: \"x\" + to_string(p.0),\n        value_type: p.1,\n      },\n  )\n  pick := kernel_translate.lambdas(\n    xs,\n    get(xs, i) ?? kernel_translate.self_ty_dummy(),\n  )\n  case_c := kernel.Constant {\n    name: d.facts.case_name,\n    value_type: kernel.function_type_of([kernel.type_of(pick)!, self_ty], fty),\n  }\n  name := d.name + \".\" + field\n  def := kernel.define(\n    name,\n    kernel.Application { function: case_c, argument: pick },\n  )!\n  mut thy.consts.insert(name, kernel.function_type(self_ty, fty))\n  lhs := kernel.Application { function: kernel.Constant {\n    name,\n    value_type: kernel.function_type(self_ty, fty),\n  }, argument: kernel.apply_all(kernel.Constant {\n    name: c,\n    value_type: kernel.function_type_of(args, self_ty),\n  }, xs) }\n  eq := kernel_translate.equation(thy, [def], lhs, get(xs, i) ?? lhs)!\n  mut thy.theorems.insert(name, [kernel_translate.close(eq, xs)!])\n  mut thy.simp.push(name)\n  Ok(())\n}"},{"name":"kernel_translate.plain_definition","kind":"fn","old":"897371421618f7bb","new":"6e712a5583f21182","interface_changed":false,"affected":[],"module":"kernel_translate","text":"fn plain_definition(\n  mut thy: kernel_translate.Theory,\n  sig: kernel_translate.Signature,\n) -> Result[(), String] {\n  mut t := kernel_translate.new_translation(\n    thy,\n    sig.decl.type_params,\n    sig.name,\n  )\n  _ := kernel_translate.dict_vars(mut t, sig.decl.bounds)!\n  (b, bt) := kernel_translate.translate(\n    mut t,\n    kernel_translate.without_block(sig.decl.body),\n    kernel_translate.scope_of(sig),\n  )!\n  kernel_translate.at_name(\n    kernel_translate.unify(mut t.u, bt, sig.rty),\n    sig.name,\n  )!\n  all := sig.dicts + sig.pvars\n  body := kernel_translate.finish(t, b, \"`\" + sig.name + \"`\")!\n  def := kernel.define(sig.name, kernel_translate.lambdas(all, body))!\n  lhs := kernel.apply_all(\n    kernel.Constant { name: sig.name, value_type: sig.fty },\n    all,\n  )\n  eq := kernel_translate.equation(thy, [def], lhs, body)!\n  mut thy.theorems.insert(\n    sig.name,\n    [kernel.named(sig.name, kernel_translate.close(eq, all)!)],\n  )\n  mut thy.simp.push(sig.name)\n  kernel_translate.after_definition(mut thy, sig)\n}","old_text":"fn plain_definition(\n  mut thy: kernel_translate.Theory,\n  sig: kernel_translate.Signature,\n) -> Result[(), String] {\n  mut t := kernel_translate.new_translation(\n    thy,\n    sig.decl.type_params,\n    sig.name,\n  )\n  _ := kernel_translate.dict_vars(mut t, sig.decl.bounds)!\n  (b, bt) := kernel_translate.translate(\n    mut t,\n    kernel_translate.without_block(sig.decl.body),\n    kernel_translate.scope_of(sig),\n  )!\n  kernel_translate.at_name(\n    kernel_translate.unify(mut t.u, bt, sig.rty),\n    sig.name,\n  )!\n  all := sig.dicts + sig.pvars\n  body := kernel_translate.finish(t, b, \"`\" + sig.name + \"`\")!\n  def := kernel.define(sig.name, kernel_translate.lambdas(all, body))!\n  lhs := kernel.apply_all(\n    kernel.Constant { name: sig.name, value_type: sig.fty },\n    all,\n  )\n  eq := kernel_translate.equation(thy, [def], lhs, body)!\n  mut thy.theorems.insert(sig.name, [kernel_translate.close(eq, all)!])\n  mut thy.simp.push(sig.name)\n  kernel_translate.after_definition(mut thy, sig)\n}"},{"name":"kernel_translate.primrec_group","kind":"fn","old":"269d898a3c850e07","new":"886e69323826f499","interface_changed":false,"affected":[],"module":"kernel_translate","text":"/// Functions whose bodies are each a `match` on a parameter of one datatype\n/// group, defined at once through the group's recursors.\nfn primrec_group(\n  mut thy: kernel_translate.Theory,\n  tops: List[(kernel_translate.Signature, Int, List[ast.Arm])],\n) -> Result[(), String] {\n  first := match tops {\n    [x, ..] => x,\n    [] => return Ok(()),\n  }\n  pty0 := kernel_translate.type_or(\n    get(first.0.pvars, first.1) ?? kernel.LambdaParameter(0),\n    kernel_translate.boolean_type(),\n  )\n  (gname, targs) := match pty0 {\n    kernel.TypeApplication { name, arguments: args } => (name, args),\n    _ => return Err(\"`\"\n      + first.0.name\n      + \"` matches on a value that isn't of a datatype\"),\n  }\n  d0 := get(thy.datatypes, gname) or {\n    return Err(\"`\"\n      + first.0.name\n      + \"` matches on a value that isn't of a datatype\")\n  }\n  group := d0.facts.group\n  sub := enumerate(d0.params).map(\n    p -> (p.1, get(targs, p.0) ?? kernel.TypeVariable(p.1)),\n  )\n  // each function's type in the group, and its arms translated\n  mut infos: List[(kernel_translate.Signature, String, Int, List[kernel.Term], kernel.Type, List[(String, List[kernel.Term], kernel.Term, kernel.Term)])] = []\n  for (sig, k, arms) in tops {\n    pty := kernel_translate.type_or(\n      get(sig.pvars, k) ?? kernel.LambdaParameter(0),\n      kernel_translate.boolean_type(),\n    )\n    tn := match pty {\n      kernel.TypeApplication { name, .. } => name,\n      _ => \"\",\n    }\n    if !contains(group, tn) {\n      return Err(\"`\"\n        + sig.name\n        + \"` matches on `\"\n        + tn\n        + \"`, which isn't in the group of `\"\n        + gname\n        + \"`\")\n    }\n    if infos.any(i -> i.1 == tn) {\n      return Err(\n        \"two functions of a recursive group match on `\" + tn + \"`\",\n      )\n    }\n    d := get(thy.datatypes, tn) or {\n      return Err(\"no datatype `\" + tn + \"`\")\n    }\n    mut t := kernel_translate.new_translation(\n      thy,\n      sig.decl.type_params,\n      sig.name,\n    )\n    _ := kernel_translate.dict_vars(mut t, sig.decl.bounds)!\n    pname := match get(sig.pvars, k) {\n      Some(kernel.Variable { name: n, .. }) => n,\n      _ => \"\",\n    }\n    mut arms_out: List[(String, List[kernel.Term], kernel.Term, kernel.Term)] = []\n    for (ci, (c, cargs0)) in enumerate(d.ctors) {\n      cargs := cargs0.map(a -> kernel.substitute_types(a, sub))\n      (arm, vars) := kernel_translate.arm_for(\n        t,\n        d,\n        ci,\n        c,\n        cargs,\n        arms,\n        sig.decl.body,\n      )!\n      value := kernel.apply_all(kernel.Constant {\n        name: c,\n        value_type: kernel.function_type_of(cargs, pty),\n      }, vars)\n      mut inner := kernel_translate.scope_of(sig)\n      mut inner.insert(pname, value)\n      for v in vars {\n        match v {\n          kernel.Variable { name: n, .. } => if !starts_with(n, \"_\") {\n            mut inner.insert(n, v)\n          },\n          _ => (),\n        }\n      }\n      match arm.pat {\n        ast.Bind(x) => mut inner.insert(x, value),\n        _ => (),\n      }\n      (b, bt) := kernel_translate.translate(mut t, arm.body, inner)!\n      kernel_translate.at_name(\n        kernel_translate.unify(mut t.u, bt, sig.rty),\n        sig.name,\n      )!\n      mut arms_out.push((c, vars, value, b))\n    }\n    mut settled_arms: List[(String, List[kernel.Term], kernel.Term, kernel.Term)] = []\n    for (c, vars, value, b) in arms_out {\n      mut settled_arms.push(\n        (\n          c,\n          vars,\n          value,\n          kernel_translate.finish(t, b, \"`\" + sig.name + \"`\")!,\n        ),\n      )\n    }\n    others := sig.dicts\n      + enumerate(sig.pvars).filter(p -> p.0 != k).map(p -> p.1)\n    beta := kernel.function_type_of(\n      others.map(v -> kernel_translate.type_or(v, sig.rty)),\n      sig.rty,\n    )\n    mut infos.push((sig, tn, k, others, beta, settled_arms))\n  }\n  // the result type of each type's recursion: the function's, else `bool`\n  result_of := (tn: String) -> {\n    mut out := kernel_translate.boolean_type()\n    for i in infos {\n      if i.1 == tn {\n        out = i.4\n      }\n    }\n    out\n  }\n  group_ty := (tn: String) -> {\n    params := match get(thy.datatypes, tn) {\n      Some(dd) => dd.params,\n      None => [],\n    }\n    kernel.substitute_types(kernel.TypeApplication {\n      name: tn,\n      arguments: params.map(q -> kernel.TypeVariable(q)),\n    }, sub)\n  }\n  in_group := (v: kernel.Term) ->\n    match v {\n      kernel.Variable { value_type: kernel.TypeApplication { name, .. }, .. } => contains(group, name),\n      _ => false,\n    }\n  // one case function per constructor of the group, in its order\n  mut cases := []\n  for tn in group {\n    dt := get(thy.datatypes, tn) or {\n      return Err(\"no datatype `\" + tn + \"`\")\n    }\n    mut fi := 0 - 1\n    for (ii, i) in enumerate(infos) {\n      if i.1 == tn {\n        fi = ii\n      }\n    }\n    for (c, cargs0) in dt.ctors {\n      cargs := cargs0.map(a -> kernel.substitute_types(a, sub))\n      if fi < 0 {\n        vars := enumerate(cargs).map(\n          p -> kernel.Variable {\n            name: \"_\" + to_string(p.0),\n            value_type: p.1,\n          },\n        )\n        rvars := enumerate(vars.filter(v -> in_group(v))).map(\n          p ->\n            kernel.Variable {\n              name: \"_r\" + to_string(p.0),\n              value_type: result_of(\n                match p.1 {\n                  kernel.Variable { value_type: kernel.TypeApplication { name, .. }, .. } => name,\n                  _ => \"\",\n                },\n              ),\n            },\n        )\n        mut cases.push(\n          kernel_translate.lambdas(vars + rvars, kernel.true_term()),\n        )\n      } else {\n        info := get(infos, fi) or { return Err(\"primrec: a function lost\") }\n        (sig, _, _, others, _, arms) := info\n        (vars, plain) := match arms.filter(a -> a.0 == c) {\n          [(_, vs, _, b), ..] => (vs, b),\n          [] => return Err(\"`\" + sig.name + \"` has no arm for `\" + c + \"`\"),\n        }\n        rec_vars := vars.filter(v -> in_group(v))\n        rvars := enumerate(rec_vars).map(\n          p ->\n            kernel.Variable {\n              name: \"_r\" + to_string(p.0),\n              value_type: result_of(\n                match p.1 {\n                  kernel.Variable { value_type: kernel.TypeApplication { name, .. }, .. } => name,\n                  _ => \"\",\n                },\n              ),\n            },\n        )\n        swapped := kernel_translate.group_calls(plain, infos, rec_vars, rvars)!\n        mut cases.push(\n          kernel_translate.lambdas(\n            vars + rvars,\n            kernel_translate.lambdas(others, swapped),\n          ),\n        )\n      }\n    }\n  }\n  case_tys := cases.map(\n    c ->\n      kernel_translate.type_or(c, kernel_translate.boolean_type()),\n  )\n  mut defs := []\n  for (sig, tn, k, others, beta, _) in infos {\n    rec := kernel.Constant {\n      name: \"rec_\" + tn,\n      value_type: kernel.function_type_of(case_tys + [group_ty(tn)], beta),\n    }\n    pk := get(sig.pvars, k) ?? kernel.LambdaParameter(0)\n    all := sig.dicts + sig.pvars\n    rhs := kernel_translate.lambdas(\n      all,\n      kernel.apply_all(kernel.Application {\n        function: kernel.apply_all(rec, cases),\n        argument: pk,\n      }, others),\n    )\n    mut defs.push(kernel.define(sig.name, rhs)!)\n  }\n  for (sig, _, k, _, _, arms) in infos {\n    mut ths := []\n    all := sig.dicts + sig.pvars\n    for (_, vars, value, plain) in arms {\n      lhs_args := enumerate(all).map(\n        p -> if p.0 == k + len(sig.dicts) {\n          value\n        } else {\n          p.1\n        },\n      )\n      eq := kernel_translate.equation(thy, defs, kernel.apply_all(\n        kernel.Constant { name: sig.name, value_type: sig.fty },\n        lhs_args,\n      ), plain)!\n      vs := enumerate(all)\n        .filter(p -> p.0 != k + len(sig.dicts))\n        .map(p -> p.1)\n      mut ths.push(kernel_translate.close(eq, vars + vs)!)\n    }\n    mut thy.theorems.insert(\n      sig.name,\n      enumerate(ths).map(\n        p -> kernel.named(sig.name + \"#\" + to_string(p.0), p.1),\n      ),\n    )\n    mut thy.simp.push(sig.name)\n  }\n  for (sig, _, _, _, _, _) in infos {\n    kernel_translate.after_definition(mut thy, sig)!\n  }\n  Ok(())\n}","old_text":"/// Functions whose bodies are each a `match` on a parameter of one datatype\n/// group, defined at once through the group's recursors.\nfn primrec_group(\n  mut thy: kernel_translate.Theory,\n  tops: List[(kernel_translate.Signature, Int, List[ast.Arm])],\n) -> Result[(), String] {\n  first := match tops {\n    [x, ..] => x,\n    [] => return Ok(()),\n  }\n  pty0 := kernel_translate.type_or(\n    get(first.0.pvars, first.1) ?? kernel.LambdaParameter(0),\n    kernel_translate.boolean_type(),\n  )\n  (gname, targs) := match pty0 {\n    kernel.TypeApplication { name, arguments: args } => (name, args),\n    _ => return Err(\"`\"\n      + first.0.name\n      + \"` matches on a value that isn't of a datatype\"),\n  }\n  d0 := get(thy.datatypes, gname) or {\n    return Err(\"`\"\n      + first.0.name\n      + \"` matches on a value that isn't of a datatype\")\n  }\n  group := d0.facts.group\n  sub := enumerate(d0.params).map(\n    p -> (p.1, get(targs, p.0) ?? kernel.TypeVariable(p.1)),\n  )\n  // each function's type in the group, and its arms translated\n  mut infos: List[(kernel_translate.Signature, String, Int, List[kernel.Term], kernel.Type, List[(String, List[kernel.Term], kernel.Term, kernel.Term)])] = []\n  for (sig, k, arms) in tops {\n    pty := kernel_translate.type_or(\n      get(sig.pvars, k) ?? kernel.LambdaParameter(0),\n      kernel_translate.boolean_type(),\n    )\n    tn := match pty {\n      kernel.TypeApplication { name, .. } => name,\n      _ => \"\",\n    }\n    if !contains(group, tn) {\n      return Err(\"`\"\n        + sig.name\n        + \"` matches on `\"\n        + tn\n        + \"`, which isn't in the group of `\"\n        + gname\n        + \"`\")\n    }\n    if infos.any(i -> i.1 == tn) {\n      return Err(\n        \"two functions of a recursive group match on `\" + tn + \"`\",\n      )\n    }\n    d := get(thy.datatypes, tn) or {\n      return Err(\"no datatype `\" + tn + \"`\")\n    }\n    mut t := kernel_translate.new_translation(\n      thy,\n      sig.decl.type_params,\n      sig.name,\n    )\n    _ := kernel_translate.dict_vars(mut t, sig.decl.bounds)!\n    pname := match get(sig.pvars, k) {\n      Some(kernel.Variable { name: n, .. }) => n,\n      _ => \"\",\n    }\n    mut arms_out: List[(String, List[kernel.Term], kernel.Term, kernel.Term)] = []\n    for (ci, (c, cargs0)) in enumerate(d.ctors) {\n      cargs := cargs0.map(a -> kernel.substitute_types(a, sub))\n      (arm, vars) := kernel_translate.arm_for(\n        t,\n        d,\n        ci,\n        c,\n        cargs,\n        arms,\n        sig.decl.body,\n      )!\n      value := kernel.apply_all(kernel.Constant {\n        name: c,\n        value_type: kernel.function_type_of(cargs, pty),\n      }, vars)\n      mut inner := kernel_translate.scope_of(sig)\n      mut inner.insert(pname, value)\n      for v in vars {\n        match v {\n          kernel.Variable { name: n, .. } => if !starts_with(n, \"_\") {\n            mut inner.insert(n, v)\n          },\n          _ => (),\n        }\n      }\n      match arm.pat {\n        ast.Bind(x) => mut inner.insert(x, value),\n        _ => (),\n      }\n      (b, bt) := kernel_translate.translate(mut t, arm.body, inner)!\n      kernel_translate.at_name(\n        kernel_translate.unify(mut t.u, bt, sig.rty),\n        sig.name,\n      )!\n      mut arms_out.push((c, vars, value, b))\n    }\n    mut settled_arms: List[(String, List[kernel.Term], kernel.Term, kernel.Term)] = []\n    for (c, vars, value, b) in arms_out {\n      mut settled_arms.push(\n        (\n          c,\n          vars,\n          value,\n          kernel_translate.finish(t, b, \"`\" + sig.name + \"`\")!,\n        ),\n      )\n    }\n    others := sig.dicts\n      + enumerate(sig.pvars).filter(p -> p.0 != k).map(p -> p.1)\n    beta := kernel.function_type_of(\n      others.map(v -> kernel_translate.type_or(v, sig.rty)),\n      sig.rty,\n    )\n    mut infos.push((sig, tn, k, others, beta, settled_arms))\n  }\n  // the result type of each type's recursion: the function's, else `bool`\n  result_of := (tn: String) -> {\n    mut out := kernel_translate.boolean_type()\n    for i in infos {\n      if i.1 == tn {\n        out = i.4\n      }\n    }\n    out\n  }\n  group_ty := (tn: String) -> {\n    params := match get(thy.datatypes, tn) {\n      Some(dd) => dd.params,\n      None => [],\n    }\n    kernel.substitute_types(kernel.TypeApplication {\n      name: tn,\n      arguments: params.map(q -> kernel.TypeVariable(q)),\n    }, sub)\n  }\n  in_group := (v: kernel.Term) ->\n    match v {\n      kernel.Variable { value_type: kernel.TypeApplication { name, .. }, .. } => contains(group, name),\n      _ => false,\n    }\n  // one case function per constructor of the group, in its order\n  mut cases := []\n  for tn in group {\n    dt := get(thy.datatypes, tn) or {\n      return Err(\"no datatype `\" + tn + \"`\")\n    }\n    mut fi := 0 - 1\n    for (ii, i) in enumerate(infos) {\n      if i.1 == tn {\n        fi = ii\n      }\n    }\n    for (c, cargs0) in dt.ctors {\n      cargs := cargs0.map(a -> kernel.substitute_types(a, sub))\n      if fi < 0 {\n        vars := enumerate(cargs).map(\n          p -> kernel.Variable {\n            name: \"_\" + to_string(p.0),\n            value_type: p.1,\n          },\n        )\n        rvars := enumerate(vars.filter(v -> in_group(v))).map(\n          p ->\n            kernel.Variable {\n              name: \"_r\" + to_string(p.0),\n              value_type: result_of(\n                match p.1 {\n                  kernel.Variable { value_type: kernel.TypeApplication { name, .. }, .. } => name,\n                  _ => \"\",\n                },\n              ),\n            },\n        )\n        mut cases.push(\n          kernel_translate.lambdas(vars + rvars, kernel.true_term()),\n        )\n      } else {\n        info := get(infos, fi) or { return Err(\"primrec: a function lost\") }\n        (sig, _, _, others, _, arms) := info\n        (vars, plain) := match arms.filter(a -> a.0 == c) {\n          [(_, vs, _, b), ..] => (vs, b),\n          [] => return Err(\"`\" + sig.name + \"` has no arm for `\" + c + \"`\"),\n        }\n        rec_vars := vars.filter(v -> in_group(v))\n        rvars := enumerate(rec_vars).map(\n          p ->\n            kernel.Variable {\n              name: \"_r\" + to_string(p.0),\n              value_type: result_of(\n                match p.1 {\n                  kernel.Variable { value_type: kernel.TypeApplication { name, .. }, .. } => name,\n                  _ => \"\",\n                },\n              ),\n            },\n        )\n        swapped := kernel_translate.group_calls(plain, infos, rec_vars, rvars)!\n        mut cases.push(\n          kernel_translate.lambdas(\n            vars + rvars,\n            kernel_translate.lambdas(others, swapped),\n          ),\n        )\n      }\n    }\n  }\n  case_tys := cases.map(\n    c ->\n      kernel_translate.type_or(c, kernel_translate.boolean_type()),\n  )\n  mut defs := []\n  for (sig, tn, k, others, beta, _) in infos {\n    rec := kernel.Constant {\n      name: \"rec_\" + tn,\n      value_type: kernel.function_type_of(case_tys + [group_ty(tn)], beta),\n    }\n    pk := get(sig.pvars, k) ?? kernel.LambdaParameter(0)\n    all := sig.dicts + sig.pvars\n    rhs := kernel_translate.lambdas(\n      all,\n      kernel.apply_all(kernel.Application {\n        function: kernel.apply_all(rec, cases),\n        argument: pk,\n      }, others),\n    )\n    mut defs.push(kernel.define(sig.name, rhs)!)\n  }\n  for (sig, _, k, _, _, arms) in infos {\n    mut ths := []\n    all := sig.dicts + sig.pvars\n    for (_, vars, value, plain) in arms {\n      lhs_args := enumerate(all).map(\n        p -> if p.0 == k + len(sig.dicts) {\n          value\n        } else {\n          p.1\n        },\n      )\n      eq := kernel_translate.equation(thy, defs, kernel.apply_all(\n        kernel.Constant { name: sig.name, value_type: sig.fty },\n        lhs_args,\n      ), plain)!\n      vs := enumerate(all)\n        .filter(p -> p.0 != k + len(sig.dicts))\n        .map(p -> p.1)\n      mut ths.push(kernel_translate.close(eq, vars + vs)!)\n    }\n    mut thy.theorems.insert(sig.name, ths)\n    mut thy.simp.push(sig.name)\n  }\n  for (sig, _, _, _, _, _) in infos {\n    kernel_translate.after_definition(mut thy, sig)!\n  }\n  Ok(())\n}"}]}
{"id":"00cf2f7591beecf2","time":1795854157,"message":"edit","changes":[{"name":"kernel_dependent_hol.axioms_used","kind":"fn","old":null,"new":"f4c749ce69624374","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// The built-in axioms the definition `name` rests on, through the\n/// definitions its value uses: `oracle` (an outside claim), `funext`, the\n/// integer axioms, and the rules of `eqv`, `all` and `some`.\npub fn axioms_used(\n  env: kernel_dependent.Environment,\n  name: String,\n) -> List[String] {\n  mut seen := []\n  mut out := []\n  mut todo := [name]\n  while len(todo) > 0 {\n    n := get(todo, len(todo) - 1) ?? \"\"\n    todo = take(todo, len(todo) - 1)\n    if contains(seen, n) {\n      continue\n    }\n    mut seen.push(n)\n    match kernel_dependent.lookup(env, n) {\n      Some(kernel_dependent.Entry { value: Some(value), .. }) => {\n        for m in kernel_dependent_hol.constants_in(value) {\n          if contains([\n              \"oracle\",\n              \"funext\",\n              \"eqv_intro\",\n              \"eqv_elim\",\n              \"all_intro\",\n              \"all_elim\",\n              \"some_intro\",\n              \"some_elim\",\n            ], m)\n            || starts_with(m, \"int.\")\n              && byte_len(m) > 7\n              && !contains([\n                \"int.add\",\n                \"int.sub\",\n                \"int.mul\",\n                \"int.neg\",\n                \"int.lt\",\n                \"int.le\",\n                \"int.eq\",\n              ], m) {\n            if !contains(out, m) {\n              mut out.push(m)\n            }\n          } else {\n            mut todo.push(m)\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  out.sorted()\n}"},{"name":"kernel_dependent_hol.constants_in","kind":"fn","old":null,"new":"e553d6a5ff944625","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn constants_in(t: kernel_dependent.Term) -> List[String] {\n  mut out := []\n  kernel_dependent_hol.collect_constants(t, mut out)\n  out\n}"},{"name":"kernel_dependent_hol.collect_constants","kind":"fn","old":null,"new":"27a2627cc2c425f7","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"fn collect_constants(t: kernel_dependent.Term, mut out: List[String]) {\n  match t {\n    kernel_dependent.Constant { name, .. } => if !contains(out, name) {\n      mut out.push(name)\n    },\n    kernel_dependent.Pi { domain, body, .. } => {\n      kernel_dependent_hol.collect_constants(domain, mut out)\n      kernel_dependent_hol.collect_constants(body, mut out)\n    },\n    kernel_dependent.Lambda { domain, body, .. } => {\n      kernel_dependent_hol.collect_constants(domain, mut out)\n      kernel_dependent_hol.collect_constants(body, mut out)\n    },\n    kernel_dependent.Apply { function, argument } => {\n      kernel_dependent_hol.collect_constants(function, mut out)\n      kernel_dependent_hol.collect_constants(argument, mut out)\n    },\n    _ => (),\n  }\n}"},{"name":"kernel_dependent_hol.environment","kind":"fn","old":null,"new":"ae5ecd7e9d859266","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// The environment the replay has built.\npub fn environment(r: kernel_dependent_hol.Replay) -> kernel_dependent.Environment {\n  r.env\n}"}]}
{"id":"18ccce376571eec5","time":1795854168,"message":"edit","changes":[{"name":"kernel_cli.replayed","kind":"fn","old":"2bbb30d15332f356","new":"4d8e2d65169a63b9","interface_changed":false,"affected":[],"module":"kernel_cli","text":"/// `--dependent`: each law the HOL kernel proved, its theorem replayed as a\n/// proof term and checked by the dependent kernel (kernel_dependent_hol),\n/// with the time and the term's size. Whether every one checked.\nfn replayed(\n  mut console: std.io.Console,\n  clock: std.time.SystemClock,\n  thy: kernel_translate.Theory,\n  os: List[kernel_cli.Outcome],\n) -> Bool {\n  t0 := clock.now().value\n  mut r := kernel_dependent_hol.start(thy) except m {\n    mut console.write(\"dependent: the base: \" + m + \"\\n\")\n    return false\n  }\n  t1 := clock.now().value\n  mut ok := true\n  mut checked := 0\n  for o in os {\n    if o.verdict != \"proven\" {\n      continue\n    }\n    th := get(get(thy.theorems, o.name) ?? [], 0) or {\n      continue\n    }\n    s0 := clock.now().value\n    match kernel_dependent_hol.check_law(mut r, o.name, th) {\n      Ok(size) => {\n        checked += 1\n        mut console.write(\n          \"dependent: proven \"\n            + o.name\n            + \" (\"\n            + kernel_cli.milliseconds(clock.now().value - s0)\n            + f\", a term of {size} nodes)\"\n            + match kernel_dependent_hol.axioms_used(\n              kernel_dependent_hol.environment(r),\n              \"h.law.\" + o.name,\n            ).filter(\n              a -> a == \"oracle\",\n            ) {\n              [] => \"\",\n              _ => \" [assumed: oracle]\",\n            }\n            + \"\\n\",\n        )\n      },\n      Err(m) => {\n        ok = false\n        mut console.write(\n          \"dependent: failed \" + o.name + \": \" + m + \"\\n\",\n        )\n      },\n    }\n  }\n  mut console.write(\n    f\"dependent: {checked} checked ({kernel_cli.milliseconds(clock.now().value - t1)}, the base {kernel_cli.milliseconds(t1 - t0)})\\n\",\n  )\n  ok\n}","old_text":"/// `--dependent`: each law the HOL kernel proved, its theorem replayed as a\n/// proof term and checked by the dependent kernel (kernel_dependent_hol),\n/// with the time and the term's size. Whether every one checked.\nfn replayed(\n  mut console: std.io.Console,\n  clock: std.time.SystemClock,\n  thy: kernel_translate.Theory,\n  os: List[kernel_cli.Outcome],\n) -> Bool {\n  t0 := clock.now().value\n  mut r := kernel_dependent_hol.start(thy) except m {\n    mut console.write(\"dependent: the base: \" + m + \"\\n\")\n    return false\n  }\n  t1 := clock.now().value\n  mut ok := true\n  mut checked := 0\n  for o in os {\n    if o.verdict != \"proven\" {\n      continue\n    }\n    th := get(get(thy.theorems, o.name) ?? [], 0) or {\n      continue\n    }\n    s0 := clock.now().value\n    match kernel_dependent_hol.check_law(mut r, o.name, th) {\n      Ok(size) => {\n        checked += 1\n        mut console.write(\n          \"dependent: proven \"\n            + o.name\n            + \" (\"\n            + kernel_cli.milliseconds(clock.now().value - s0)\n            + f\", a term of {size} nodes)\\n\",\n        )\n      },\n      Err(m) => {\n        ok = false\n        mut console.write(\n          \"dependent: failed \" + o.name + \": \" + m + \"\\n\",\n        )\n      },\n    }\n  }\n  mut console.write(\n    f\"dependent: {checked} checked ({kernel_cli.milliseconds(clock.now().value - t1)}, the base {kernel_cli.milliseconds(t1 - t0)})\\n\",\n  )\n  ok\n}"}]}
{"id":"5c1adac382dd3234","time":1795854436,"message":"edit","changes":[{"name":"kernel_dependent_patch.records","kind":"fn","old":"2f98dede4bc0618e","new":"7623e05f1ce44e11","interface_changed":false,"affected":["kernel_cli.dependent","kernel_dependent_records.laws","kernel_cli.command","kernel_cli.every_record","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent_patch","text":"/// Each record of `decls` (no type parameters) as a schema, with the laws'\n/// instances; a record `Patch[T]` made by the type function is checked to\n/// be `Patch` at `T`'s schema, field by field, by computation. A record\n/// is translated after the records its fields are of.\npub fn records(\n  env: kernel_dependent.Environment,\n  decls: List[ast.Decl],\n) -> Result[kernel_dependent_patch.Instances, String] {\n  thy := kernel_translate.empty_theory()\n  mut e := env\n  mut out := []\n  mut values := []\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => if td.params == [] {\n        t := kernel_translate.type_value(thy, td)\n        if t.kind == std.typing.Record {\n          mut values.push(t)\n        }\n      },\n      _ => (),\n    }\n  }\n  for t in kernel_dependent_patch.in_dependency_order(values) {\n    name := kernel_dependent_patch.schema_name(t.name ?? \"\")\n    mut types := []\n    for f in t.fields {\n      mut types.push(kernel_dependent_patch.core_type(mut e, f.type)!)\n    }\n    names := t.fields.map(f -> f.name)\n    e = kernel_dependent_patch.add_schema(e, name, names, types)!\n    r := kernel_dependent_patch.instances(e, name, names, types)!\n    e = r.env\n    out += r.statements\n    for p in values {\n      if p.name == Some(\"Patch[\" + name + \"]\") {\n        patch := kernel_dependent.whnf(\n          e,\n          kernel_dependent_patch.c(\"Patch[\" + name + \"]\"),\n        )\n        for (i, f) in enumerate(p.fields) {\n          made := kernel_dependent_patch.core_type(mut e, f.type)!\n          generic := match patch {\n            kernel_dependent.Pi { body, .. } => kernel_dependent.instantiate(\n              body,\n              kernel_dependent_patch.c(\n                name + \".\" + (get(names, i) ?? \"\"),\n              ),\n              0,\n            ),\n            _ => return Err(\"`Patch[\" + name + \"]` isn't a Π\"),\n          }\n          if get(names, i) != Some(f.name)\n            || !kernel_dependent.convertible(e, 0, made, generic) {\n            return Err(\"`Patch[\"\n              + name\n              + \"]`'s field `\"\n              + f.name\n              + \"` isn't `Patch`'s at `\"\n              + name\n              + \"`\")\n          }\n        }\n        mut out.push(\n          (\n            \"Patch[\" + name + \"]\",\n            \"made by the type function: its fields are `Patch`'s at `\"\n              + name\n              + \"`, by computation\",\n          ),\n        )\n      }\n    }\n  }\n  Ok(kernel_dependent_patch.Instances { env: e, statements: out })\n}","old_text":"/// Each record of `decls` (no type parameters) as a schema, with the laws'\n/// instances; a record `Patch[T]` made by the type function is checked to\n/// be `Patch` at `T`'s schema, field by field, by computation.\npub fn records(\n  env: kernel_dependent.Environment,\n  decls: List[ast.Decl],\n) -> Result[kernel_dependent_patch.Instances, String] {\n  thy := kernel_translate.empty_theory()\n  mut e := env\n  mut out := []\n  mut values := []\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => if td.params == [] {\n        t := kernel_translate.type_value(thy, td)\n        if t.kind == std.typing.Record {\n          mut values.push(t)\n        }\n      },\n      _ => (),\n    }\n  }\n  for t in values {\n    name := t.name ?? \"\"\n    if starts_with(name, \"Patch[\") {\n      continue\n    }\n    mut types := []\n    for f in t.fields {\n      mut types.push(kernel_dependent_patch.core_type(mut e, f.type)!)\n    }\n    names := t.fields.map(f -> f.name)\n    e = kernel_dependent_patch.add_schema(e, name, names, types)!\n    r := kernel_dependent_patch.instances(e, name, names, types)!\n    e = r.env\n    out += r.statements\n    for p in values {\n      if p.name == Some(\"Patch[\" + name + \"]\") {\n        patch := kernel_dependent.whnf(\n          e,\n          kernel_dependent_patch.c(\"Patch[\" + name + \"]\"),\n        )\n        for (i, f) in enumerate(p.fields) {\n          made := kernel_dependent_patch.core_type(mut e, f.type)!\n          generic := match patch {\n            kernel_dependent.Pi { body, .. } => kernel_dependent.instantiate(\n              body,\n              kernel_dependent_patch.c(\n                name + \".\" + (get(names, i) ?? \"\"),\n              ),\n              0,\n            ),\n            _ => return Err(\"`Patch[\" + name + \"]` isn't a Π\"),\n          }\n          if get(names, i) != Some(f.name)\n            || !kernel_dependent.convertible(e, 0, made, generic) {\n            return Err(\"`Patch[\"\n              + name\n              + \"]`'s field `\"\n              + f.name\n              + \"` isn't `Patch`'s at `\"\n              + name\n              + \"`\")\n          }\n        }\n        mut out.push(\n          (\n            \"Patch[\" + name + \"]\",\n            \"made by the type function: its fields are `Patch`'s at `\"\n              + name\n              + \"`, by computation\",\n          ),\n        )\n      }\n    }\n  }\n  Ok(kernel_dependent_patch.Instances { env: e, statements: out })\n}"},{"name":"kernel_dependent_patch.schema_name","kind":"fn","old":null,"new":"82e6858e0606dcb1","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"/// The schema's name for the record `n`: a made record (`Patch[User]`)\n/// apart from the names `n`'s own schema defines.\npub fn schema_name(n: String) -> String {\n  if starts_with(n, \"Patch[\") {\n    \"made.\" + n\n  } else {\n    n\n  }\n}"},{"name":"kernel_dependent_patch.in_dependency_order","kind":"fn","old":null,"new":"48b242e43f1363db","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"/// `ts` with each record after the records of `ts` its fields are of.\nfn in_dependency_order(ts: List[std.typing.Type]) -> List[std.typing.Type] {\n  mut out := []\n  mut left := ts\n  while len(left) > 0 {\n    names := left.map(t -> t.name ?? \"\")\n    ready := left.filter(\n      t -> !t.fields.any(\n        f -> kernel_dependent_patch.mentions_any(\n          f.type,\n          names.filter(n -> Some(n) != t.name),\n        ),\n      ),\n    )\n    next := if ready == [] {\n      left\n    } else {\n      ready\n    }\n    out += next\n    left = left.filter(t -> !next.any(u -> u.name == t.name))\n  }\n  out\n}"},{"name":"kernel_dependent_patch.mentions_any","kind":"fn","old":null,"new":"2922119ccebee840","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"fn mentions_any(t: std.typing.Type, names: List[String]) -> Bool {\n  match t.name {\n    Some(n) => if contains(names, n) {\n      return true\n    },\n    None => (),\n  }\n  t.args.any(a -> kernel_dependent_patch.mentions_any(a, names))\n}"}]}
{"id":"7137a96fee442beb","time":1795854525,"message":"edit","changes":[{"name":"kernel_cli.dependent","kind":"fn","old":"3a454605150255e6","new":"52ef24a3142ce5ef","interface_changed":false,"affected":[],"module":"kernel_cli","text":"/// `strata kernel dependent [FILE.strata…]`: Patch's laws proven once, for\n/// every record, in the dependently typed kernel (kernel_dependent), each\n/// with the time its proof took to build and check; then each file's\n/// records as schemas, with the laws' instances at them.\nfn dependent(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  home: String,\n  paths: List[String],\n) -> std.process.ExitCode {\n  t0 := clock.now().value\n  mut checked := []\n  built := match kernel_dependent_patch.base(kernel_dependent.empty_environment()) {\n    Ok(e) => match kernel_dependent_patch.definitions(e) {\n      Ok(e2) => kernel_dependent_patch.laws(clock, mut checked, e2),\n      Err(m) => Err(m),\n    },\n    Err(m) => Err(m),\n  }\n  t1 := clock.now().value\n  env := built except m {\n    mut console.write(\"failed: \" + m + \"\\n\")\n    return 1\n  }\n  for k in checked {\n    mut console.write(\n      \"proven \"\n        + k.name\n        + \" (tactics \"\n        + kernel_cli.milliseconds(k.tactic_ns)\n        + \", kernel \"\n        + kernel_cli.milliseconds(k.kernel_ns)\n        + f\", a term of {k.size} nodes)\\n\",\n    )\n  }\n  mut console.write(\n    f\"{len(checked)} laws proven for every record ({kernel_cli.milliseconds(t1 - t0)} with the base and definitions); axiom: funext (built in)\\n\",\n  )\n  for k in checked {\n    uses := match kernel_dependent.lookup(env, k.name) {\n      Some(kernel_dependent.Entry { value: Some(p), .. }) => kernel_dependent.mentions(p, \"funext\"),\n      _ => false,\n    }\n    if uses {\n      mut console.write(\"  \" + k.name + \" uses funext\\n\")\n    }\n  }\n  mut code := 0\n  for (what, m) in kernel_dependent_patch.refusals(env) {\n    if m == \"\" {\n      mut console.write(\"ACCEPTED (unsound): \" + what + \"\\n\")\n      code = 1\n    } else {\n      mut console.write(\"refused: \" + what + \" (\" + m + \")\\n\")\n    }\n  }\n  for path in paths {\n    if !kernel_cli.every_record(mut console, files, clock, home, path) {\n      code = 1\n    }\n    t2 := clock.now().value\n    decls := match files.read_bytes(path) {\n      Ok(bytes) => match binary.read(bytes) {\n        Ok(img) => kernel_cli.made_in(\n          img.decls,\n          kernel_cli.typing_decls(files, home),\n        ),\n        Err(m) => Err(m),\n      },\n      Err(_) => Err(\"can't read it\"),\n    }\n    result := match decls {\n      Ok(ds) => kernel_dependent_patch.records(env, ds),\n      Err(m) => Err(m),\n    }\n    match result {\n      Ok(r) => {\n        mut console.write(\n          \"== \"\n            + path\n            + f\" ({kernel_cli.milliseconds(clock.now().value - t2)})\\n\",\n        )\n        for (n, s) in r.statements {\n          mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n        }\n        mut console.write(\n          \"opaque types: \"\n            + join(kernel_dependent.axioms(r.env), \", \")\n            + \"\\n\",\n        )\n      },\n      Err(m) => {\n        mut console.write(path + \": \" + m + \"\\n\")\n        code = 1\n      },\n    }\n  }\n  code\n}","old_text":"/// `strata kernel dependent [FILE.strata…]`: Patch's laws proven once, for\n/// every record, in the dependently typed kernel (kernel_dependent), each\n/// with the time its proof took to build and check; then each file's\n/// records as schemas, with the laws' instances at them.\nfn dependent(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  home: String,\n  paths: List[String],\n) -> std.process.ExitCode {\n  t0 := clock.now().value\n  mut checked := []\n  built := match kernel_dependent_patch.base(kernel_dependent.empty_environment()) {\n    Ok(e) => match kernel_dependent_patch.definitions(e) {\n      Ok(e2) => kernel_dependent_patch.laws(clock, mut checked, e2),\n      Err(m) => Err(m),\n    },\n    Err(m) => Err(m),\n  }\n  t1 := clock.now().value\n  env := built except m {\n    mut console.write(\"failed: \" + m + \"\\n\")\n    return 1\n  }\n  for k in checked {\n    mut console.write(\n      \"proven \"\n        + k.name\n        + \" (tactics \"\n        + kernel_cli.milliseconds(k.tactic_ns)\n        + \", kernel \"\n        + kernel_cli.milliseconds(k.kernel_ns)\n        + f\", a term of {k.size} nodes)\\n\",\n    )\n  }\n  mut console.write(\n    f\"{len(checked)} laws proven for every record ({kernel_cli.milliseconds(t1 - t0)} with the base and definitions); axiom: funext (built in)\\n\",\n  )\n  for k in checked {\n    uses := match kernel_dependent.lookup(env, k.name) {\n      Some(kernel_dependent.Entry { value: Some(p), .. }) => kernel_dependent.mentions(p, \"funext\"),\n      _ => false,\n    }\n    if uses {\n      mut console.write(\"  \" + k.name + \" uses funext\\n\")\n    }\n  }\n  mut code := 0\n  for (what, m) in kernel_dependent_patch.refusals(env) {\n    if m == \"\" {\n      mut console.write(\"ACCEPTED (unsound): \" + what + \"\\n\")\n      code = 1\n    } else {\n      mut console.write(\"refused: \" + what + \" (\" + m + \")\\n\")\n    }\n  }\n  for path in paths {\n    if !kernel_cli.every_record(mut console, files, clock, path) {\n      code = 1\n    }\n    t2 := clock.now().value\n    decls := match files.read_bytes(path) {\n      Ok(bytes) => match binary.read(bytes) {\n        Ok(img) => kernel_cli.made_in(\n          img.decls,\n          kernel_cli.typing_decls(files, home),\n        ),\n        Err(m) => Err(m),\n      },\n      Err(_) => Err(\"can't read it\"),\n    }\n    result := match decls {\n      Ok(ds) => kernel_dependent_patch.records(env, ds),\n      Err(m) => Err(m),\n    }\n    match result {\n      Ok(r) => {\n        mut console.write(\n          \"== \"\n            + path\n            + f\" ({kernel_cli.milliseconds(clock.now().value - t2)})\\n\",\n        )\n        for (n, s) in r.statements {\n          mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n        }\n        mut console.write(\n          \"opaque types: \"\n            + join(kernel_dependent.axioms(r.env), \", \")\n            + \"\\n\",\n        )\n      },\n      Err(m) => {\n        mut console.write(path + \": \" + m + \"\\n\")\n        code = 1\n      },\n    }\n  }\n  code\n}"},{"name":"kernel_cli.every_record","kind":"fn","old":"3a30363b6ec9322e","new":"d64530e8c99e51ec","interface_changed":true,"affected":["kernel_cli.dependent","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_cli","text":"/// The laws for every record a module states (`lemma l[T: Record]`),\n/// translated from its tree, proven and checked by the dependent kernel\n/// (kernel_dependent_records), then at each of its records. Whether all\n/// were.\nfn every_record(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  home: String,\n  path: String,\n) -> Bool {\n  raw := match files.read_bytes(path) {\n    Ok(bytes) => match binary.read(bytes) {\n      Ok(img) => img.decls,\n      Err(_) => [],\n    },\n    Err(_) => [],\n  }\n  generic := raw.any(\n    d -> match d.kind {\n      ast.FnDef(f) => f.lemma && f.type_params == [\"T\"],\n      _ => false,\n    },\n  )\n  if !generic {\n    return true\n  }\n  t0 := clock.now().value\n  match kernel_dependent_records.laws(\n    clock,\n    raw,\n    kernel_cli.made_in(raw, kernel_cli.typing_decls(files, home)) !! raw,\n  ) {\n    Ok(r) => {\n      mut console.write(\n        \"== \"\n          + path\n          + f\": laws for every record, from the module ({kernel_cli.milliseconds(clock.now().value - t0)} in all)\\n\",\n      )\n      mut console.write(\n        \"translated: type functions \"\n          + join(r.defaults.keys(), \", \")\n          + \"; methods \"\n          + join(r.methods, \", \")\n          + \"\\n\",\n      )\n\n      for (n, ns, size) in r.proven {\n        mut console.write(\n          \"proven for every record \"\n            + n\n            + \" (\"\n            + kernel_cli.milliseconds(ns)\n            + f\", a term of {size} nodes)\\n\",\n        )\n      }\n      for (n, m) in r.failed {\n        mut console.write(\"failed \" + n + \": \" + m + \"\\n\")\n      }\n      for (n, g) in r.open {\n        mut console.write(\"open   \" + n + \"\\n  ⊢ \" + g + \"\\n\")\n      }\n      for (n, s) in r.instances {\n        mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n      }\n      r.failed == []\n    },\n    Err(m) => {\n      mut console.write(path + \": laws for every record: \" + m + \"\\n\")\n      false\n    },\n  }\n}","old_text":"/// The laws for every record a module states (`lemma l[T: Record]`),\n/// translated from its tree, proven and checked by the dependent kernel\n/// (kernel_dependent_records), then at each of its records. Whether all\n/// were.\nfn every_record(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  path: String,\n) -> Bool {\n  raw := match files.read_bytes(path) {\n    Ok(bytes) => match binary.read(bytes) {\n      Ok(img) => img.decls,\n      Err(_) => [],\n    },\n    Err(_) => [],\n  }\n  generic := raw.any(\n    d -> match d.kind {\n      ast.FnDef(f) => f.lemma && f.type_params == [\"T\"],\n      _ => false,\n    },\n  )\n  if !generic {\n    return true\n  }\n  t0 := clock.now().value\n  match kernel_dependent_records.laws(clock, raw) {\n    Ok(r) => {\n      mut console.write(\n        \"== \"\n          + path\n          + f\": laws for every record, from the module ({kernel_cli.milliseconds(clock.now().value - t0)} in all)\\n\",\n      )\n      mut console.write(\n        \"translated: type functions \"\n          + join(r.defaults.keys(), \", \")\n          + \"; methods \"\n          + join(r.methods, \", \")\n          + \"\\n\",\n      )\n\n      for (n, ns, size) in r.proven {\n        mut console.write(\n          \"proven for every record \"\n            + n\n            + \" (\"\n            + kernel_cli.milliseconds(ns)\n            + f\", a term of {size} nodes)\\n\",\n        )\n      }\n      for (n, m) in r.failed {\n        mut console.write(\"failed \" + n + \": \" + m + \"\\n\")\n      }\n      for (n, g) in r.open {\n        mut console.write(\"open   \" + n + \"\\n  ⊢ \" + g + \"\\n\")\n      }\n      for (n, s) in r.instances {\n        mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n      }\n      r.failed == []\n    },\n    Err(m) => {\n      mut console.write(path + \": laws for every record: \" + m + \"\\n\")\n      false\n    },\n  }\n}"},{"name":"kernel_dependent_records.laws","kind":"fn","old":"637fd4abdff6c767","new":"10de79c5bdb33344","interface_changed":true,"affected":["kernel_cli.every_record","kernel_cli.dependent","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent_records","text":"/// The module's laws for every record: its sums, type functions and\n/// blanket impl translated, each `lemma l[T: Record]` stated, proven by\n/// its steps and checked; each with its time and term size; then each\n/// record of `made` (the module with its made types) as a schema, every law\n/// at it.\npub fn laws(\n  clock: std.time.SystemClock,\n  decls: List[ast.Decl],\n  made: List[ast.Decl],\n) -> Result[kernel_dependent_records.Records, String] {\n  mut checked := []\n  base := kernel_dependent_patch.definitions(\n    kernel_dependent_patch.base(\n      kernel_dependent.empty_environment(),\n    )!,\n  )!\n  env := kernel_dependent_patch.laws(clock, mut checked, base)!\n  mut r := kernel_dependent_records.Records {\n    env,\n    defaults: Dict[String, String] {},\n    methods: [],\n    updating: [],\n    proven: [],\n    instances: [],\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => match td.body {\n        ast.SumBody(_) => kernel_dependent_records.add_sum(mut r, td)!,\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if f.compile_time\n        && kernel_dependent_records.is_named(f.ret, \"Type\") {\n        kernel_dependent_records.add_type_function(mut r, f)!\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.ImplDef(imp) => if imp.bounds.any(\n        b -> b.traits.any(\n          t -> kernel_dependent_records.is_named(t, \"Record\"),\n        ),\n      ) {\n        kernel_dependent_records.add_impl(mut r, imp)!\n      },\n      _ => (),\n    }\n  }\n  if contains(r.updating, \"apply\") && contains(r.methods, \"patched\") {\n    kernel_dependent_records.add_applied_at(\n      mut r,\n      \"apply\",\n      \"patched\",\n    )!\n  }\n  mut names := []\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if f.lemma\n        && f.bounds.any(\n          b -> b.traits.any(\n            t -> kernel_dependent_records.is_named(t, \"Record\"),\n          ),\n        ) {\n        mut ps := []\n        for p in f.params {\n          mut ps.push(\n            (\n              p.name,\n              kernel_dependent_records.type_of(mut r, p.ty, [])!,\n            ),\n          )\n        }\n        ctx := (kernel_dependent_records.schema()\n          + [kernel_dependent_records.complete()]\n          + ps).reversed(\n        )\n        sc := kernel_dependent_records.Scope {\n          vars: ps.map(p -> (p.0, kernel_dependent_records.v(p.0))),\n          ctx,\n        }\n        body := get(f.post, 0) or {\n          return Err(\"`\" + f.name + \"` has no statement\")\n        }\n        s := kernel_dependent_records.statement(mut r, sc, ctx, body) except m {\n          return Err(\"`\" + f.name + \"`: \" + m)\n        }\n        goal := kernel_dependent_records.pis(\n          kernel_dependent_records.schema()\n            + [kernel_dependent_records.complete()]\n            + ps,\n          s,\n        )\n        match f.body {\n          ast.Hole(_) => {\n            mut r.open.push(\n              (f.name, kernel_dependent_tactics.show(goal, [])),\n            )\n            continue\n          },\n          _ => (),\n        }\n        t1 := clock.now().value\n        proof := kernel_dependent_records.steps(\n          r,\n          f.body,\n          kernel_dependent_tactics.Goal {\n            env: r.env,\n            context: [],\n            target: goal,\n          },\n        ) except m {\n          mut r.failed.push((f.name, m))\n          continue\n        }\n        r.env = kernel_dependent.define(r.env, \"m.\" + f.name, goal, proof) except m {\n          mut r.failed.push((f.name, \"the kernel: \" + m))\n          continue\n        }\n        mut r.proven.push(\n          (\n            f.name,\n            clock.now().value - t1,\n            kernel_dependent_records.size(proof),\n          ),\n        )\n        mut names.push(f.name)\n      },\n      _ => (),\n    }\n  }\n  // each record of the module: its schema, that its field list is complete\n  // (by computation), and every law at it by application\n  inst := kernel_dependent_patch.records(r.env, made)!\n  r.env = inst.env\n  for d in made {\n    match d.kind {\n      ast.TypeDef(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          kernel_dependent_records.at_record(\n            mut r,\n            kernel_dependent_patch.schema_name(td.name),\n            names,\n          )!\n        },\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  Ok(r)\n}","old_text":"/// The module's laws for every record: its sums, type functions and\n/// blanket impl translated, each `lemma l[T: Record]` stated, proven by\n/// its steps and checked; each with its time and term size.\npub fn laws(\n  clock: std.time.SystemClock,\n  decls: List[ast.Decl],\n) -> Result[kernel_dependent_records.Records, String] {\n  mut checked := []\n  base := kernel_dependent_patch.definitions(\n    kernel_dependent_patch.base(\n      kernel_dependent.empty_environment(),\n    )!,\n  )!\n  env := kernel_dependent_patch.laws(clock, mut checked, base)!\n  mut r := kernel_dependent_records.Records {\n    env,\n    defaults: Dict[String, String] {},\n    methods: [],\n    updating: [],\n    proven: [],\n    instances: [],\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => match td.body {\n        ast.SumBody(_) => kernel_dependent_records.add_sum(mut r, td)!,\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if f.compile_time\n        && kernel_dependent_records.is_named(f.ret, \"Type\") {\n        kernel_dependent_records.add_type_function(mut r, f)!\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.ImplDef(imp) => if imp.bounds.any(\n        b -> b.traits.any(\n          t -> kernel_dependent_records.is_named(t, \"Record\"),\n        ),\n      ) {\n        kernel_dependent_records.add_impl(mut r, imp)!\n      },\n      _ => (),\n    }\n  }\n  if contains(r.updating, \"apply\") && contains(r.methods, \"patched\") {\n    kernel_dependent_records.add_applied_at(\n      mut r,\n      \"apply\",\n      \"patched\",\n    )!\n  }\n  mut names := []\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if f.lemma\n        && f.bounds.any(\n          b -> b.traits.any(\n            t -> kernel_dependent_records.is_named(t, \"Record\"),\n          ),\n        ) {\n        mut ps := []\n        for p in f.params {\n          mut ps.push(\n            (\n              p.name,\n              kernel_dependent_records.type_of(mut r, p.ty, [])!,\n            ),\n          )\n        }\n        ctx := (kernel_dependent_records.schema()\n          + [kernel_dependent_records.complete()]\n          + ps).reversed(\n        )\n        sc := kernel_dependent_records.Scope {\n          vars: ps.map(p -> (p.0, kernel_dependent_records.v(p.0))),\n          ctx,\n        }\n        body := get(f.post, 0) or {\n          return Err(\"`\" + f.name + \"` has no statement\")\n        }\n        s := kernel_dependent_records.statement(mut r, sc, ctx, body) except m {\n          return Err(\"`\" + f.name + \"`: \" + m)\n        }\n        goal := kernel_dependent_records.pis(\n          kernel_dependent_records.schema()\n            + [kernel_dependent_records.complete()]\n            + ps,\n          s,\n        )\n        match f.body {\n          ast.Hole(_) => {\n            mut r.open.push(\n              (f.name, kernel_dependent_tactics.show(goal, [])),\n            )\n            continue\n          },\n          _ => (),\n        }\n        t1 := clock.now().value\n        proof := kernel_dependent_records.steps(\n          r,\n          f.body,\n          kernel_dependent_tactics.Goal {\n            env: r.env,\n            context: [],\n            target: goal,\n          },\n        ) except m {\n          mut r.failed.push((f.name, m))\n          continue\n        }\n        r.env = kernel_dependent.define(r.env, \"m.\" + f.name, goal, proof) except m {\n          mut r.failed.push((f.name, \"the kernel: \" + m))\n          continue\n        }\n        mut r.proven.push(\n          (\n            f.name,\n            clock.now().value - t1,\n            kernel_dependent_records.size(proof),\n          ),\n        )\n        mut names.push(f.name)\n      },\n      _ => (),\n    }\n  }\n  // each record of the module: its schema, that its field list is complete\n  // (by computation), and every law at it by application\n  inst := kernel_dependent_patch.records(r.env, decls)!\n  r.env = inst.env\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          kernel_dependent_records.at_record(mut r, td.name, names)!\n        },\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  Ok(r)\n}"}]}
{"id":"3d1e5eaca31cf6f4","time":1795854677,"message":"edit","changes":[{"name":"kernel_dependent_patch.add_schema","kind":"fn","old":"b98af7286856dc9e","new":"ad535176813ae540","interface_changed":false,"affected":["kernel_dependent_patch.records","kernel_cli.dependent","kernel_dependent_records.laws","kernel_cli.command","kernel_cli.every_record","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent_patch","text":"/// The record `t` with fields `names` of types `types` as a schema:\n/// `t.Field` (a constructor per field), `t.ty`, `t.fields`, `t.deq`\n/// (decided by computation), `t` itself and `Patch[t]`. Each is checked by\n/// the kernel; none is a proof about Patch.\nfn add_schema(\n  env: kernel_dependent.Environment,\n  t: String,\n  names: List[String],\n  types: List[kernel_dependent.Term],\n) -> Result[kernel_dependent.Environment, String] {\n  field := t + \".Field\"\n  ft := kernel_dependent_patch.c(field)\n  ctors := names.map(n -> kernel_dependent_patch.c(t + \".\" + n))\n  mut e := kernel_dependent.add_inductive(\n    env,\n    field,\n    kernel_dependent.Sort(0),\n    0,\n    names.map(n -> (t + \".\" + n, ft)),\n  )!\n  e = kernel_dependent.define(\n    e,\n    t + \".ty\",\n    kernel_dependent_patch.arrow(ft, kernel_dependent.Sort(0)),\n    kernel_dependent.lambda(\"f\", ft, kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(field, 1),\n      [\n          kernel_dependent.lambda(\n            \"_f\",\n            ft,\n            kernel_dependent.Sort(0),\n          ),\n        ]\n        + types\n        + [kernel_dependent_patch.v(\"f\")],\n    )),\n  )!\n  mut list := kernel_dependent_patch.at(kernel_dependent_patch.c(\"nil\"), [ft])\n  for k in ctors.reversed() {\n    list = kernel_dependent_patch.at(\n      kernel_dependent_patch.c(\"cons\"),\n      [ft, k, list],\n    )\n  }\n  e = kernel_dependent.define(e, t + \".fields\", kernel_dependent.Apply {\n    function: kernel_dependent_patch.c(\"List\"),\n    argument: ft,\n  }, list)!\n  // a field's position, and whether two fields are at one position: what\n  // tells two fields apart, in one term per pair\n  e = kernel_dependent.define(e, t + \".index\", kernel_dependent.Pi {\n    name: \"_\",\n    domain: ft,\n    body: kernel_dependent_patch.c(\"Int\"),\n  }, kernel_dependent.lambda(\"z\", ft, kernel_dependent_patch.at(\n    kernel_dependent_patch.rec(field, 0),\n    [kernel_dependent.lambda(\n        \"_f\",\n        ft,\n        kernel_dependent_patch.c(\"Int\"),\n      )]\n      + enumerate(ctors).map(k -> kernel_dependent.literal(k.0))\n      + [kernel_dependent_patch.v(\"z\")],\n  )))!\n  same := (a: kernel_dependent.Term, b: kernel_dependent.Term) ->\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.c(\"int.eq\"),\n      [kernel_dependent.Apply {\n        function: kernel_dependent_patch.c(t + \".index\"),\n        argument: a,\n      }, kernel_dependent.Apply {\n        function: kernel_dependent_patch.c(t + \".index\"),\n        argument: b,\n      }],\n    )\n  if kernel_dependent.lookup(e, \"false_empty\") == None {\n    e = kernel_dependent.define(e, \"false_empty\", kernel_dependent.Pi {\n      name: \"_\",\n      domain: kernel_dependent.holds(kernel_dependent_patch.c(\"false\")),\n      body: kernel_dependent_patch.c(\"Empty\"),\n    }, kernel_dependent.lambda(\n      \"h\",\n      kernel_dependent.holds(kernel_dependent_patch.c(\"false\")),\n      kernel_dependent_patch.at(\n        kernel_dependent.Constant { name: \"J\", levels: [0, 0] },\n        [\n          kernel_dependent_patch.c(\"Bool\"),\n          kernel_dependent_patch.c(\"false\"),\n          kernel_dependent_patch.lambdas([\n            (\"z\", kernel_dependent_patch.c(\"Bool\")),\n            (\"_e\", kernel_dependent_patch.eq0(\n              kernel_dependent_patch.c(\"Bool\"),\n              kernel_dependent_patch.c(\"false\"),\n              kernel_dependent_patch.v(\"z\"),\n            )),\n          ], kernel_dependent_patch.at(kernel_dependent.Constant {\n            name: \"Bool.rec\",\n            levels: [1],\n          }, [\n            kernel_dependent.lambda(\n              \"_b\",\n              kernel_dependent_patch.c(\"Bool\"),\n              kernel_dependent.Sort(0),\n            ),\n            kernel_dependent_patch.c(\"Empty\"),\n            kernel_dependent_patch.c(\"Unit\"),\n            kernel_dependent_patch.v(\"z\"),\n          ])),\n          kernel_dependent_patch.c(\"star\"),\n          kernel_dependent_patch.c(\"true\"),\n          kernel_dependent_patch.v(\"h\"),\n        ],\n      ),\n    ))!\n  }\n  mut minors := []\n  for (i, ci) in enumerate(ctors) {\n    mut inner := []\n    for (j, cj) in enumerate(ctors) {\n      mut inner.push(\n        if i == j {\n          kernel_dependent_patch.at(\n            kernel_dependent_patch.c(\"yes\"),\n            [\n              kernel_dependent_patch.eq0(ft, ci, cj),\n              kernel_dependent.reflexivity(0, ft, ci),\n            ],\n          )\n        } else {\n          kernel_dependent_patch.at(\n            kernel_dependent_patch.c(\"no\"),\n            [\n              kernel_dependent_patch.eq0(ft, ci, cj),\n              kernel_dependent.lambda(\n                \"e\",\n                kernel_dependent_patch.eq0(ft, ci, cj),\n                kernel_dependent.Apply {\n                  function: kernel_dependent_patch.c(\"false_empty\"),\n                  argument: kernel_dependent_patch.at(\n                    kernel_dependent.Constant {\n                      name: \"J\",\n                      levels: [0, 0],\n                    },\n                    [ft, ci, kernel_dependent_patch.lambdas(\n                      [(\"z\", ft), (\"_e\", kernel_dependent_patch.eq0(\n                        ft,\n                        ci,\n                        kernel_dependent_patch.v(\"z\"),\n                      ))],\n                      kernel_dependent.holds(\n                        same(ci, kernel_dependent_patch.v(\"z\")),\n                      ),\n                    ), kernel_dependent.reflexivity(\n                      0,\n                      kernel_dependent_patch.c(\"Bool\"),\n                      kernel_dependent_patch.c(\"true\"),\n                    ), cj, kernel_dependent_patch.v(\"e\")],\n                  ),\n                },\n              ),\n            ],\n          )\n        },\n      )\n    }\n    mut minors.push(\n      kernel_dependent_patch.at(\n        kernel_dependent_patch.rec(field, 0),\n        [\n            kernel_dependent.lambda(\n              \"b2\",\n              ft,\n              kernel_dependent.Apply {\n                function: kernel_dependent_patch.c(\"Dec\"),\n                argument: kernel_dependent_patch.eq0(\n                  ft,\n                  ci,\n                  kernel_dependent_patch.v(\"b2\"),\n                ),\n              },\n            ),\n          ]\n          + inner\n          + [kernel_dependent_patch.v(\"b\")],\n      ),\n    )\n  }\n  e = kernel_dependent.define(e, t + \".deq\", kernel_dependent.pi(\n    \"a\",\n    ft,\n    kernel_dependent.pi(\"b\", ft, kernel_dependent.Apply {\n      function: kernel_dependent_patch.c(\"Dec\"),\n      argument: kernel_dependent_patch.eq0(\n        ft,\n        kernel_dependent_patch.v(\"a\"),\n        kernel_dependent_patch.v(\"b\"),\n      ),\n    }),\n  ), kernel_dependent_patch.lambdas(\n    [(\"a\", ft), (\"b\", ft)],\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(field, 0),\n      [kernel_dependent.lambda(\"a2\", ft, kernel_dependent.Apply {\n          function: kernel_dependent_patch.c(\"Dec\"),\n          argument: kernel_dependent_patch.eq0(\n            ft,\n            kernel_dependent_patch.v(\"a2\"),\n            kernel_dependent_patch.v(\"b\"),\n          ),\n        })]\n        + minors\n        + [kernel_dependent_patch.v(\"a\")],\n    ),\n  ))!\n  e = kernel_dependent.define(\n    e,\n    t,\n    kernel_dependent.Sort(0),\n    kernel_dependent.pi(\"f\", ft, kernel_dependent.Apply {\n      function: kernel_dependent_patch.c(t + \".ty\"),\n      argument: kernel_dependent_patch.v(\"f\"),\n    }),\n  )!\n  kernel_dependent.define(\n    e,\n    \"Patch[\" + t + \"]\",\n    kernel_dependent.Sort(0),\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.c(\"Patch\"),\n      kernel_dependent_patch.at_schema(t),\n    ),\n  )\n}","old_text":"/// The record `t` with fields `names` of types `types` as a schema:\n/// `t.Field` (a constructor per field), `t.ty`, `t.fields`, `t.deq`\n/// (decided by computation), `t` itself and `Patch[t]`. Each is checked by\n/// the kernel; none is a proof about Patch.\nfn add_schema(\n  env: kernel_dependent.Environment,\n  t: String,\n  names: List[String],\n  types: List[kernel_dependent.Term],\n) -> Result[kernel_dependent.Environment, String] {\n  field := t + \".Field\"\n  ft := kernel_dependent_patch.c(field)\n  ctors := names.map(n -> kernel_dependent_patch.c(t + \".\" + n))\n  mut e := kernel_dependent.add_inductive(\n    env,\n    field,\n    kernel_dependent.Sort(0),\n    0,\n    names.map(n -> (t + \".\" + n, ft)),\n  )!\n  e = kernel_dependent.define(\n    e,\n    t + \".ty\",\n    kernel_dependent_patch.arrow(ft, kernel_dependent.Sort(0)),\n    kernel_dependent.lambda(\"f\", ft, kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(field, 1),\n      [\n          kernel_dependent.lambda(\n            \"_f\",\n            ft,\n            kernel_dependent.Sort(0),\n          ),\n        ]\n        + types\n        + [kernel_dependent_patch.v(\"f\")],\n    )),\n  )!\n  mut list := kernel_dependent_patch.at(kernel_dependent_patch.c(\"nil\"), [ft])\n  for k in ctors.reversed() {\n    list = kernel_dependent_patch.at(\n      kernel_dependent_patch.c(\"cons\"),\n      [ft, k, list],\n    )\n  }\n  e = kernel_dependent.define(e, t + \".fields\", kernel_dependent.Apply {\n    function: kernel_dependent_patch.c(\"List\"),\n    argument: ft,\n  }, list)!\n  code := (i: Int) ->\n    kernel_dependent.lambda(\"z\", ft, kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(field, 1),\n      [\n          kernel_dependent.lambda(\n            \"_f\",\n            ft,\n            kernel_dependent.Sort(0),\n          ),\n        ]\n        + enumerate(ctors).map(\n          k -> if k.0 == i {\n            kernel_dependent_patch.c(\"Unit\")\n          } else {\n            kernel_dependent_patch.c(\"Empty\")\n          },\n        )\n        + [kernel_dependent_patch.v(\"z\")],\n    ))\n  mut minors := []\n  for (i, ci) in enumerate(ctors) {\n    mut inner := []\n    for (j, cj) in enumerate(ctors) {\n      mut inner.push(\n        if i == j {\n          kernel_dependent_patch.at(\n            kernel_dependent_patch.c(\"yes\"),\n            [\n              kernel_dependent_patch.eq0(ft, ci, cj),\n              kernel_dependent.reflexivity(0, ft, ci),\n            ],\n          )\n        } else {\n          kernel_dependent_patch.at(\n            kernel_dependent_patch.c(\"no\"),\n            [\n              kernel_dependent_patch.eq0(ft, ci, cj),\n              kernel_dependent.lambda(\n                \"e\",\n                kernel_dependent_patch.eq0(ft, ci, cj),\n                kernel_dependent_patch.at(\n                  kernel_dependent.Constant {\n                    name: \"J\",\n                    levels: [0, 0],\n                  },\n                  [\n                    ft,\n                    ci,\n                    kernel_dependent_patch.lambdas(\n                      [(\"z\", ft), (\"_e\", kernel_dependent_patch.eq0(\n                        ft,\n                        ci,\n                        kernel_dependent_patch.v(\"z\"),\n                      ))],\n                      kernel_dependent.Apply {\n                        function: code(i),\n                        argument: kernel_dependent_patch.v(\"z\"),\n                      },\n                    ),\n                    kernel_dependent_patch.c(\"star\"),\n                    cj,\n                    kernel_dependent_patch.v(\"e\"),\n                  ],\n                ),\n              ),\n            ],\n          )\n        },\n      )\n    }\n    mut minors.push(\n      kernel_dependent_patch.at(\n        kernel_dependent_patch.rec(field, 0),\n        [\n            kernel_dependent.lambda(\n              \"b2\",\n              ft,\n              kernel_dependent.Apply {\n                function: kernel_dependent_patch.c(\"Dec\"),\n                argument: kernel_dependent_patch.eq0(\n                  ft,\n                  ci,\n                  kernel_dependent_patch.v(\"b2\"),\n                ),\n              },\n            ),\n          ]\n          + inner\n          + [kernel_dependent_patch.v(\"b\")],\n      ),\n    )\n  }\n  e = kernel_dependent.define(e, t + \".deq\", kernel_dependent.pi(\n    \"a\",\n    ft,\n    kernel_dependent.pi(\"b\", ft, kernel_dependent.Apply {\n      function: kernel_dependent_patch.c(\"Dec\"),\n      argument: kernel_dependent_patch.eq0(\n        ft,\n        kernel_dependent_patch.v(\"a\"),\n        kernel_dependent_patch.v(\"b\"),\n      ),\n    }),\n  ), kernel_dependent_patch.lambdas(\n    [(\"a\", ft), (\"b\", ft)],\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(field, 0),\n      [kernel_dependent.lambda(\"a2\", ft, kernel_dependent.Apply {\n          function: kernel_dependent_patch.c(\"Dec\"),\n          argument: kernel_dependent_patch.eq0(\n            ft,\n            kernel_dependent_patch.v(\"a2\"),\n            kernel_dependent_patch.v(\"b\"),\n          ),\n        })]\n        + minors\n        + [kernel_dependent_patch.v(\"a\")],\n    ),\n  ))!\n  e = kernel_dependent.define(\n    e,\n    t,\n    kernel_dependent.Sort(0),\n    kernel_dependent.pi(\"f\", ft, kernel_dependent.Apply {\n      function: kernel_dependent_patch.c(t + \".ty\"),\n      argument: kernel_dependent_patch.v(\"f\"),\n    }),\n  )!\n  kernel_dependent.define(\n    e,\n    \"Patch[\" + t + \"]\",\n    kernel_dependent.Sort(0),\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.c(\"Patch\"),\n      kernel_dependent_patch.at_schema(t),\n    ),\n  )\n}"}]}
{"id":"1396fa80d38f9e19","time":1795854765,"message":"edit","changes":[{"name":"kernel_dependent_patch.add_schema","kind":"fn","old":"ad535176813ae540","new":"68aabbe83717eb9b","interface_changed":false,"affected":["kernel_dependent_patch.records","kernel_cli.dependent","kernel_dependent_records.laws","kernel_cli.command","kernel_cli.every_record","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent_patch","text":"/// The record `t` with fields `names` of types `types` as a schema:\n/// `t.Field` (a constructor per field), `t.ty`, `t.fields`, `t.deq`\n/// (decided by computation), `t` itself and `Patch[t]`. Each is checked by\n/// the kernel; none is a proof about Patch.\nfn add_schema(\n  env: kernel_dependent.Environment,\n  t: String,\n  names: List[String],\n  types: List[kernel_dependent.Term],\n) -> Result[kernel_dependent.Environment, String] {\n  field := t + \".Field\"\n  ft := kernel_dependent_patch.c(field)\n  ctors := names.map(n -> kernel_dependent_patch.c(t + \".\" + n))\n  mut e := kernel_dependent.add_inductive(\n    env,\n    field,\n    kernel_dependent.Sort(0),\n    0,\n    names.map(n -> (t + \".\" + n, ft)),\n  )!\n  e = kernel_dependent.define(\n    e,\n    t + \".ty\",\n    kernel_dependent_patch.arrow(ft, kernel_dependent.Sort(0)),\n    kernel_dependent.lambda(\"f\", ft, kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(field, 1),\n      [\n          kernel_dependent.lambda(\n            \"_f\",\n            ft,\n            kernel_dependent.Sort(0),\n          ),\n        ]\n        + types\n        + [kernel_dependent_patch.v(\"f\")],\n    )),\n  )!\n  mut list := kernel_dependent_patch.at(kernel_dependent_patch.c(\"nil\"), [ft])\n  for k in ctors.reversed() {\n    list = kernel_dependent_patch.at(\n      kernel_dependent_patch.c(\"cons\"),\n      [ft, k, list],\n    )\n  }\n  e = kernel_dependent.define(e, t + \".fields\", kernel_dependent.Apply {\n    function: kernel_dependent_patch.c(\"List\"),\n    argument: ft,\n  }, list)!\n  // a field's position, and whether two fields are at one position: what\n  // tells two fields apart, in one term per pair\n  e = kernel_dependent.define(e, t + \".index\", kernel_dependent.Pi {\n    name: \"_\",\n    domain: ft,\n    body: kernel_dependent_patch.c(\"Int\"),\n  }, kernel_dependent.lambda(\"z\", ft, kernel_dependent_patch.at(\n    kernel_dependent_patch.rec(field, 0),\n    [kernel_dependent.lambda(\n        \"_f\",\n        ft,\n        kernel_dependent_patch.c(\"Int\"),\n      )]\n      + enumerate(ctors).map(k -> kernel_dependent.literal(k.0))\n      + [kernel_dependent_patch.v(\"z\")],\n  )))!\n  same := (a: kernel_dependent.Term, b: kernel_dependent.Term) ->\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.c(\"int.eq\"),\n      [kernel_dependent.Apply {\n        function: kernel_dependent_patch.c(t + \".index\"),\n        argument: a,\n      }, kernel_dependent.Apply {\n        function: kernel_dependent_patch.c(t + \".index\"),\n        argument: b,\n      }],\n    )\n  if kernel_dependent.lookup(e, \"false_empty\") == None {\n    e = kernel_dependent.define(e, \"false_empty\", kernel_dependent.Pi {\n      name: \"_\",\n      domain: kernel_dependent.holds(kernel_dependent_patch.c(\"false\")),\n      body: kernel_dependent_patch.c(\"Empty\"),\n    }, kernel_dependent.lambda(\n      \"h\",\n      kernel_dependent.holds(kernel_dependent_patch.c(\"false\")),\n      kernel_dependent_patch.at(\n        kernel_dependent.Constant { name: \"J\", levels: [0, 0] },\n        [\n          kernel_dependent_patch.c(\"Bool\"),\n          kernel_dependent_patch.c(\"false\"),\n          kernel_dependent_patch.lambdas([\n            (\"z\", kernel_dependent_patch.c(\"Bool\")),\n            (\"_e\", kernel_dependent_patch.eq0(\n              kernel_dependent_patch.c(\"Bool\"),\n              kernel_dependent_patch.c(\"false\"),\n              kernel_dependent_patch.v(\"z\"),\n            )),\n          ], kernel_dependent_patch.at(kernel_dependent.Constant {\n            name: \"Bool.rec\",\n            levels: [1],\n          }, [\n            kernel_dependent.lambda(\n              \"_b\",\n              kernel_dependent_patch.c(\"Bool\"),\n              kernel_dependent.Sort(0),\n            ),\n            kernel_dependent_patch.c(\"Empty\"),\n            kernel_dependent_patch.c(\"Unit\"),\n            kernel_dependent_patch.v(\"z\"),\n          ])),\n          kernel_dependent_patch.c(\"star\"),\n          kernel_dependent_patch.c(\"true\"),\n          kernel_dependent_patch.v(\"h\"),\n        ],\n      ),\n    ))!\n  }\n  mut minors := []\n  for (i, ci) in enumerate(ctors) {\n    mut inner := []\n    for (j, cj) in enumerate(ctors) {\n      mut inner.push(\n        if i == j {\n          kernel_dependent_patch.at(\n            kernel_dependent_patch.c(\"yes\"),\n            [\n              kernel_dependent_patch.eq0(ft, ci, cj),\n              kernel_dependent.reflexivity(0, ft, ci),\n            ],\n          )\n        } else {\n          kernel_dependent_patch.at(\n            kernel_dependent_patch.c(\"no\"),\n            [\n              kernel_dependent_patch.eq0(ft, ci, cj),\n              kernel_dependent.lambda(\n                \"e\",\n                kernel_dependent_patch.eq0(ft, ci, cj),\n                kernel_dependent.Apply {\n                  function: kernel_dependent_patch.c(\"false_empty\"),\n                  argument: kernel_dependent_patch.at(\n                    kernel_dependent.Constant {\n                      name: \"J\",\n                      levels: [0, 0],\n                    },\n                    [ft, ci, kernel_dependent_patch.lambdas(\n                      [(\"z\", ft), (\"_e\", kernel_dependent_patch.eq0(\n                        ft,\n                        ci,\n                        kernel_dependent_patch.v(\"z\"),\n                      ))],\n                      kernel_dependent.holds(\n                        same(ci, kernel_dependent_patch.v(\"z\")),\n                      ),\n                    ), kernel_dependent.reflexivity(\n                      0,\n                      kernel_dependent_patch.c(\"Bool\"),\n                      kernel_dependent_patch.c(\"true\"),\n                    ), cj, kernel_dependent_patch.v(\"e\")],\n                  ),\n                },\n              ),\n            ],\n          )\n        },\n      )\n    }\n    // row `i` of the decision, its own constant: unfolding `deq` stays small\n    row := t + \".deq.\" + to_string(i)\n    e = kernel_dependent.define(\n      e,\n      row,\n      kernel_dependent.pi(\"b2\", ft, kernel_dependent.Apply {\n        function: kernel_dependent_patch.c(\"Dec\"),\n        argument: kernel_dependent_patch.eq0(\n          ft,\n          ci,\n          kernel_dependent_patch.v(\"b2\"),\n        ),\n      }),\n      kernel_dependent.lambda(\"b2\", ft, kernel_dependent_patch.at(\n        kernel_dependent_patch.rec(field, 0),\n        [\n            kernel_dependent.lambda(\n              \"b3\",\n              ft,\n              kernel_dependent.Apply {\n                function: kernel_dependent_patch.c(\"Dec\"),\n                argument: kernel_dependent_patch.eq0(\n                  ft,\n                  ci,\n                  kernel_dependent_patch.v(\"b3\"),\n                ),\n              },\n            ),\n          ]\n          + inner\n          + [kernel_dependent_patch.v(\"b2\")],\n      )),\n    )!\n    mut minors.push(\n      kernel_dependent.Apply {\n        function: kernel_dependent_patch.c(row),\n        argument: kernel_dependent_patch.v(\"b\"),\n      },\n    )\n  }\n  e = kernel_dependent.define(e, t + \".deq\", kernel_dependent.pi(\n    \"a\",\n    ft,\n    kernel_dependent.pi(\"b\", ft, kernel_dependent.Apply {\n      function: kernel_dependent_patch.c(\"Dec\"),\n      argument: kernel_dependent_patch.eq0(\n        ft,\n        kernel_dependent_patch.v(\"a\"),\n        kernel_dependent_patch.v(\"b\"),\n      ),\n    }),\n  ), kernel_dependent_patch.lambdas(\n    [(\"a\", ft), (\"b\", ft)],\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(field, 0),\n      [kernel_dependent.lambda(\"a2\", ft, kernel_dependent.Apply {\n          function: kernel_dependent_patch.c(\"Dec\"),\n          argument: kernel_dependent_patch.eq0(\n            ft,\n            kernel_dependent_patch.v(\"a2\"),\n            kernel_dependent_patch.v(\"b\"),\n          ),\n        })]\n        + minors\n        + [kernel_dependent_patch.v(\"a\")],\n    ),\n  ))!\n  e = kernel_dependent.define(\n    e,\n    t,\n    kernel_dependent.Sort(0),\n    kernel_dependent.pi(\"f\", ft, kernel_dependent.Apply {\n      function: kernel_dependent_patch.c(t + \".ty\"),\n      argument: kernel_dependent_patch.v(\"f\"),\n    }),\n  )!\n  kernel_dependent.define(\n    e,\n    \"Patch[\" + t + \"]\",\n    kernel_dependent.Sort(0),\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.c(\"Patch\"),\n      kernel_dependent_patch.at_schema(t),\n    ),\n  )\n}","old_text":"/// The record `t` with fields `names` of types `types` as a schema:\n/// `t.Field` (a constructor per field), `t.ty`, `t.fields`, `t.deq`\n/// (decided by computation), `t` itself and `Patch[t]`. Each is checked by\n/// the kernel; none is a proof about Patch.\nfn add_schema(\n  env: kernel_dependent.Environment,\n  t: String,\n  names: List[String],\n  types: List[kernel_dependent.Term],\n) -> Result[kernel_dependent.Environment, String] {\n  field := t + \".Field\"\n  ft := kernel_dependent_patch.c(field)\n  ctors := names.map(n -> kernel_dependent_patch.c(t + \".\" + n))\n  mut e := kernel_dependent.add_inductive(\n    env,\n    field,\n    kernel_dependent.Sort(0),\n    0,\n    names.map(n -> (t + \".\" + n, ft)),\n  )!\n  e = kernel_dependent.define(\n    e,\n    t + \".ty\",\n    kernel_dependent_patch.arrow(ft, kernel_dependent.Sort(0)),\n    kernel_dependent.lambda(\"f\", ft, kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(field, 1),\n      [\n          kernel_dependent.lambda(\n            \"_f\",\n            ft,\n            kernel_dependent.Sort(0),\n          ),\n        ]\n        + types\n        + [kernel_dependent_patch.v(\"f\")],\n    )),\n  )!\n  mut list := kernel_dependent_patch.at(kernel_dependent_patch.c(\"nil\"), [ft])\n  for k in ctors.reversed() {\n    list = kernel_dependent_patch.at(\n      kernel_dependent_patch.c(\"cons\"),\n      [ft, k, list],\n    )\n  }\n  e = kernel_dependent.define(e, t + \".fields\", kernel_dependent.Apply {\n    function: kernel_dependent_patch.c(\"List\"),\n    argument: ft,\n  }, list)!\n  // a field's position, and whether two fields are at one position: what\n  // tells two fields apart, in one term per pair\n  e = kernel_dependent.define(e, t + \".index\", kernel_dependent.Pi {\n    name: \"_\",\n    domain: ft,\n    body: kernel_dependent_patch.c(\"Int\"),\n  }, kernel_dependent.lambda(\"z\", ft, kernel_dependent_patch.at(\n    kernel_dependent_patch.rec(field, 0),\n    [kernel_dependent.lambda(\n        \"_f\",\n        ft,\n        kernel_dependent_patch.c(\"Int\"),\n      )]\n      + enumerate(ctors).map(k -> kernel_dependent.literal(k.0))\n      + [kernel_dependent_patch.v(\"z\")],\n  )))!\n  same := (a: kernel_dependent.Term, b: kernel_dependent.Term) ->\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.c(\"int.eq\"),\n      [kernel_dependent.Apply {\n        function: kernel_dependent_patch.c(t + \".index\"),\n        argument: a,\n      }, kernel_dependent.Apply {\n        function: kernel_dependent_patch.c(t + \".index\"),\n        argument: b,\n      }],\n    )\n  if kernel_dependent.lookup(e, \"false_empty\") == None {\n    e = kernel_dependent.define(e, \"false_empty\", kernel_dependent.Pi {\n      name: \"_\",\n      domain: kernel_dependent.holds(kernel_dependent_patch.c(\"false\")),\n      body: kernel_dependent_patch.c(\"Empty\"),\n    }, kernel_dependent.lambda(\n      \"h\",\n      kernel_dependent.holds(kernel_dependent_patch.c(\"false\")),\n      kernel_dependent_patch.at(\n        kernel_dependent.Constant { name: \"J\", levels: [0, 0] },\n        [\n          kernel_dependent_patch.c(\"Bool\"),\n          kernel_dependent_patch.c(\"false\"),\n          kernel_dependent_patch.lambdas([\n            (\"z\", kernel_dependent_patch.c(\"Bool\")),\n            (\"_e\", kernel_dependent_patch.eq0(\n              kernel_dependent_patch.c(\"Bool\"),\n              kernel_dependent_patch.c(\"false\"),\n              kernel_dependent_patch.v(\"z\"),\n            )),\n          ], kernel_dependent_patch.at(kernel_dependent.Constant {\n            name: \"Bool.rec\",\n            levels: [1],\n          }, [\n            kernel_dependent.lambda(\n              \"_b\",\n              kernel_dependent_patch.c(\"Bool\"),\n              kernel_dependent.Sort(0),\n            ),\n            kernel_dependent_patch.c(\"Empty\"),\n            kernel_dependent_patch.c(\"Unit\"),\n            kernel_dependent_patch.v(\"z\"),\n          ])),\n          kernel_dependent_patch.c(\"star\"),\n          kernel_dependent_patch.c(\"true\"),\n          kernel_dependent_patch.v(\"h\"),\n        ],\n      ),\n    ))!\n  }\n  mut minors := []\n  for (i, ci) in enumerate(ctors) {\n    mut inner := []\n    for (j, cj) in enumerate(ctors) {\n      mut inner.push(\n        if i == j {\n          kernel_dependent_patch.at(\n            kernel_dependent_patch.c(\"yes\"),\n            [\n              kernel_dependent_patch.eq0(ft, ci, cj),\n              kernel_dependent.reflexivity(0, ft, ci),\n            ],\n          )\n        } else {\n          kernel_dependent_patch.at(\n            kernel_dependent_patch.c(\"no\"),\n            [\n              kernel_dependent_patch.eq0(ft, ci, cj),\n              kernel_dependent.lambda(\n                \"e\",\n                kernel_dependent_patch.eq0(ft, ci, cj),\n                kernel_dependent.Apply {\n                  function: kernel_dependent_patch.c(\"false_empty\"),\n                  argument: kernel_dependent_patch.at(\n                    kernel_dependent.Constant {\n                      name: \"J\",\n                      levels: [0, 0],\n                    },\n                    [ft, ci, kernel_dependent_patch.lambdas(\n                      [(\"z\", ft), (\"_e\", kernel_dependent_patch.eq0(\n                        ft,\n                        ci,\n                        kernel_dependent_patch.v(\"z\"),\n                      ))],\n                      kernel_dependent.holds(\n                        same(ci, kernel_dependent_patch.v(\"z\")),\n                      ),\n                    ), kernel_dependent.reflexivity(\n                      0,\n                      kernel_dependent_patch.c(\"Bool\"),\n                      kernel_dependent_patch.c(\"true\"),\n                    ), cj, kernel_dependent_patch.v(\"e\")],\n                  ),\n                },\n              ),\n            ],\n          )\n        },\n      )\n    }\n    mut minors.push(\n      kernel_dependent_patch.at(\n        kernel_dependent_patch.rec(field, 0),\n        [\n            kernel_dependent.lambda(\n              \"b2\",\n              ft,\n              kernel_dependent.Apply {\n                function: kernel_dependent_patch.c(\"Dec\"),\n                argument: kernel_dependent_patch.eq0(\n                  ft,\n                  ci,\n                  kernel_dependent_patch.v(\"b2\"),\n                ),\n              },\n            ),\n          ]\n          + inner\n          + [kernel_dependent_patch.v(\"b\")],\n      ),\n    )\n  }\n  e = kernel_dependent.define(e, t + \".deq\", kernel_dependent.pi(\n    \"a\",\n    ft,\n    kernel_dependent.pi(\"b\", ft, kernel_dependent.Apply {\n      function: kernel_dependent_patch.c(\"Dec\"),\n      argument: kernel_dependent_patch.eq0(\n        ft,\n        kernel_dependent_patch.v(\"a\"),\n        kernel_dependent_patch.v(\"b\"),\n      ),\n    }),\n  ), kernel_dependent_patch.lambdas(\n    [(\"a\", ft), (\"b\", ft)],\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(field, 0),\n      [kernel_dependent.lambda(\"a2\", ft, kernel_dependent.Apply {\n          function: kernel_dependent_patch.c(\"Dec\"),\n          argument: kernel_dependent_patch.eq0(\n            ft,\n            kernel_dependent_patch.v(\"a2\"),\n            kernel_dependent_patch.v(\"b\"),\n          ),\n        })]\n        + minors\n        + [kernel_dependent_patch.v(\"a\")],\n    ),\n  ))!\n  e = kernel_dependent.define(\n    e,\n    t,\n    kernel_dependent.Sort(0),\n    kernel_dependent.pi(\"f\", ft, kernel_dependent.Apply {\n      function: kernel_dependent_patch.c(t + \".ty\"),\n      argument: kernel_dependent_patch.v(\"f\"),\n    }),\n  )!\n  kernel_dependent.define(\n    e,\n    \"Patch[\" + t + \"]\",\n    kernel_dependent.Sort(0),\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.c(\"Patch\"),\n      kernel_dependent_patch.at_schema(t),\n    ),\n  )\n}"}]}
{"id":"c47acae4837a4c67","time":1795854918,"message":"edit","changes":[{"name":"kernel_cli.replayed","kind":"fn","old":"4d8e2d65169a63b9","new":"6c5c10ac90262ca3","interface_changed":false,"affected":[],"module":"kernel_cli","text":"/// `--dependent`: each law the HOL kernel proved, its theorem replayed as a\n/// proof term and checked by the dependent kernel (kernel_dependent_hol),\n/// with the time and the term's size. Whether every one checked.\nfn replayed(\n  mut console: std.io.Console,\n  clock: std.time.SystemClock,\n  thy: kernel_translate.Theory,\n  os: List[kernel_cli.Outcome],\n) -> Bool {\n  t0 := clock.now().value\n  mut r := kernel_dependent_hol.start(thy, clock) except m {\n    mut console.write(\"dependent: the base: \" + m + \"\\n\")\n    return false\n  }\n  t1 := clock.now().value\n  mut ok := true\n  mut checked := 0\n  for o in os {\n    if o.verdict != \"proven\" {\n      continue\n    }\n    th := get(get(thy.theorems, o.name) ?? [], 0) or {\n      continue\n    }\n    s0 := clock.now().value\n    match kernel_dependent_hol.check_law(mut r, o.name, th) {\n      Ok(size) => {\n        checked += 1\n        mut console.write(\n          \"dependent: proven \"\n            + o.name\n            + \" (\"\n            + kernel_cli.milliseconds(clock.now().value - s0)\n            + f\", a term of {size} nodes)\"\n            + match kernel_dependent_hol.axioms_used(\n              kernel_dependent_hol.environment(r),\n              \"h.law.\" + o.name,\n            ).filter(\n              a -> a == \"oracle\",\n            ) {\n              [] => \"\",\n              _ => \" [assumed: oracle]\",\n            }\n            + \"\\n\",\n        )\n      },\n      Err(m) => {\n        ok = false\n        mut console.write(\n          \"dependent: failed \" + o.name + \": \" + m + \"\\n\",\n        )\n      },\n    }\n  }\n  mut console.write(\n    f\"dependent: {checked} checked ({kernel_cli.milliseconds(clock.now().value - t1)}, of which the kernel {kernel_cli.milliseconds(kernel_dependent_hol.kernel_time(r))}; the base {kernel_cli.milliseconds(t1 - t0)})\\n\",\n  )\n  ok\n}","old_text":"/// `--dependent`: each law the HOL kernel proved, its theorem replayed as a\n/// proof term and checked by the dependent kernel (kernel_dependent_hol),\n/// with the time and the term's size. Whether every one checked.\nfn replayed(\n  mut console: std.io.Console,\n  clock: std.time.SystemClock,\n  thy: kernel_translate.Theory,\n  os: List[kernel_cli.Outcome],\n) -> Bool {\n  t0 := clock.now().value\n  mut r := kernel_dependent_hol.start(thy) except m {\n    mut console.write(\"dependent: the base: \" + m + \"\\n\")\n    return false\n  }\n  t1 := clock.now().value\n  mut ok := true\n  mut checked := 0\n  for o in os {\n    if o.verdict != \"proven\" {\n      continue\n    }\n    th := get(get(thy.theorems, o.name) ?? [], 0) or {\n      continue\n    }\n    s0 := clock.now().value\n    match kernel_dependent_hol.check_law(mut r, o.name, th) {\n      Ok(size) => {\n        checked += 1\n        mut console.write(\n          \"dependent: proven \"\n            + o.name\n            + \" (\"\n            + kernel_cli.milliseconds(clock.now().value - s0)\n            + f\", a term of {size} nodes)\"\n            + match kernel_dependent_hol.axioms_used(\n              kernel_dependent_hol.environment(r),\n              \"h.law.\" + o.name,\n            ).filter(\n              a -> a == \"oracle\",\n            ) {\n              [] => \"\",\n              _ => \" [assumed: oracle]\",\n            }\n            + \"\\n\",\n        )\n      },\n      Err(m) => {\n        ok = false\n        mut console.write(\n          \"dependent: failed \" + o.name + \": \" + m + \"\\n\",\n        )\n      },\n    }\n  }\n  mut console.write(\n    f\"dependent: {checked} checked ({kernel_cli.milliseconds(clock.now().value - t1)}, the base {kernel_cli.milliseconds(t1 - t0)})\\n\",\n  )\n  ok\n}"},{"name":"kernel_dependent_hol.Replay","kind":"type","old":"a4bc15a74b512ebd","new":"9ac52d8c0e6a7841","interface_changed":true,"affected":["kernel_dependent_hol.variable","kernel_dependent_hol.type_term","kernel_dependent_hol.term","kernel_dependent_hol.constant","kernel_dependent_hol.define_group","kernel_dependent_hol.type_term_in_group","kernel_dependent_hol.conclusion_of","kernel_dependent_hol.proof","kernel_dependent_hol.define_constant","kernel_dependent_hol.compute_equality","kernel_dependent_hol.named","kernel_dependent_hol.close_term","kernel_dependent_hol.axiom","kernel_dependent_hol.tautology","kernel_dependent_hol.datatype_fact","kernel_dependent_hol.injective","kernel_dependent_hol.distinct","kernel_dependent_hol.induction","kernel_dependent_hol.start","kernel_dependent_hol.check_law","kernel_dependent_hol.goal_for","kernel_dependent_hol.environment","kernel_dependent_hol.kernel_time","kernel_cli.replayed","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent_hol","text":"/// What replaying has built: the environment, each HOL constant's\n/// dependent constant (its type variables in order and generic type),\n/// each free variable's HOL variable by name, each named theorem's\n/// constant and the free variables it is applied to, and the datatypes\n/// (by type, its group's specs); how long the kernel's checks took.\npub type Replay = {\n  env: kernel_dependent.Environment,\n  consts: Dict[String, (List[String], kernel.Type)],\n  vars: Dict[String, kernel.Term],\n  named: Dict[String, (String, List[String])],\n  groups: Dict[String, List[kernel.DatatypeSpec]],\n  equations: Dict[String, List[kernel.Theorem]],\n  defined_groups: List[String],\n  clock: std.time.SystemClock,\n  kernel_ns: Int = 0,\n}","old_text":"/// What replaying has built: the environment, each HOL constant's\n/// dependent constant (its type variables in order and generic type),\n/// each free variable's HOL variable by name, each named theorem's\n/// constant and the free variables it is applied to, and the datatypes\n/// (by type, its group's specs).\npub type Replay = {\n  env: kernel_dependent.Environment,\n  consts: Dict[String, (List[String], kernel.Type)],\n  vars: Dict[String, kernel.Term],\n  named: Dict[String, (String, List[String])],\n  groups: Dict[String, List[kernel.DatatypeSpec]],\n  equations: Dict[String, List[kernel.Theorem]],\n  defined_groups: List[String],\n}"},{"name":"kernel_dependent_hol.start","kind":"fn","old":"d40c1fab988bcfec","new":"027c2682c333e706","interface_changed":true,"affected":["kernel_cli.replayed","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent_hol","text":"// ---- laws ----\n\n/// A replay of the HOL kernel's theory `thy`: its datatypes' groups and\n/// its constants' equations known, the `hol.*` lemmas proven.\npub fn start(\n  thy: kernel_translate.Theory,\n  clock: std.time.SystemClock,\n) -> Result[kernel_dependent_hol.Replay, String] {\n  mut groups := Dict[String, List[kernel.DatatypeSpec]] {}\n  for (n, d) in thy.datatypes {\n    _ := n\n    mut specs := []\n    for m in d.facts.group {\n      match get(thy.datatypes, m) {\n        Some(x) => mut specs.push(\n          kernel.DatatypeSpec {\n            name: x.name,\n            params: x.params,\n            ctors: x.ctors,\n          },\n        ),\n        None => (),\n      }\n    }\n    mut groups.insert(d.name, specs)\n  }\n  Ok(kernel_dependent_hol.Replay {\n    env: kernel_dependent_hol.base(kernel_dependent.empty_environment())!,\n    consts: Dict[String, (List[String], kernel.Type)] {},\n    vars: Dict[String, kernel.Term] {},\n    named: Dict[String, (String, List[String])] {},\n    groups,\n    equations: thy.theorems,\n    defined_groups: [],\n    clock,\n  })\n}","old_text":"// ---- laws ----\n\n/// A replay of the HOL kernel's theory `thy`: its datatypes' groups and\n/// its constants' equations known, the `hol.*` lemmas proven.\npub fn start(\n  thy: kernel_translate.Theory,\n) -> Result[kernel_dependent_hol.Replay, String] {\n  mut groups := Dict[String, List[kernel.DatatypeSpec]] {}\n  for (n, d) in thy.datatypes {\n    _ := n\n    mut specs := []\n    for m in d.facts.group {\n      match get(thy.datatypes, m) {\n        Some(x) => mut specs.push(\n          kernel.DatatypeSpec {\n            name: x.name,\n            params: x.params,\n            ctors: x.ctors,\n          },\n        ),\n        None => (),\n      }\n    }\n    mut groups.insert(d.name, specs)\n  }\n  Ok(kernel_dependent_hol.Replay {\n    env: kernel_dependent_hol.base(kernel_dependent.empty_environment())!,\n    consts: Dict[String, (List[String], kernel.Type)] {},\n    vars: Dict[String, kernel.Term] {},\n    named: Dict[String, (String, List[String])] {},\n    groups,\n    equations: thy.theorems,\n    defined_groups: [],\n  })\n}"},{"name":"kernel_dependent_hol.use std.time","kind":"use","old":null,"new":"19155c8ad9a37595","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"from std.time use SystemClock, Clock"},{"name":"kernel_dependent_hol.kernel_time","kind":"fn","old":null,"new":"e3dde59dcb4cdecd","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// How long the kernel's checks took, in all.\npub fn kernel_time(r: kernel_dependent_hol.Replay) -> Int {\n  r.kernel_ns\n}"}]}
{"id":"eef282f6ba31b7ea","time":1795854960,"message":"edit","changes":[{"name":"kernel_dependent_hol.close_term","kind":"fn","old":"dfb5c4d41634803f","new":"f9d71b129d94b9cb","interface_changed":false,"affected":[],"module":"kernel_dependent_hol","text":"/// `statement` and its proof `body` closed over their free variables and\n/// `hyps`, defined as `cn`: the names it is applied to.\nfn close_term(\n  mut r: kernel_dependent_hol.Replay,\n  cn: String,\n  statement: kernel_dependent_hol.D,\n  body: kernel_dependent_hol.D,\n  hyps: List[(String, kernel_dependent_hol.D)],\n) -> Result[(String, List[String]), String] {\n  mut frees := kernel_dependent_hol.free_names(statement)\n  for n in kernel_dependent_hol.free_names(body) {\n    if !contains(frees, n) && !starts_with(n, \"h:\") {\n      mut frees.push(n)\n    }\n  }\n  types := frees\n    .filter(n -> starts_with(n, \"'\"))\n    .map(n -> (n, kernel_dependent.Sort(0)))\n  mut vars := []\n  for n in frees.filter(n -> starts_with(n, \"v:\")) {\n    match get(r.vars, n) {\n      Some(v) => mut vars.push(\n        (n, kernel_dependent_hol.type_term(\n          mut r,\n          kernel_dependent_hol.hol_type(v),\n        )!),\n      ),\n      None => return Err(\"`\" + n + \"`: an unknown variable\"),\n    }\n  }\n  ps := types + vars + hyps\n  t0 := r.clock.now().value\n  checked := kernel_dependent.define(\n    r.env,\n    cn,\n    kernel_dependent_hol.pis(ps, statement),\n    kernel_dependent_hol.lams(ps, body),\n  )\n  r.kernel_ns += r.clock.now().value - t0\n  r.env = checked except m {\n    return Err(m\n      + kernel_dependent_hol.diagnose(\n        r.env,\n        ps.reversed(),\n        body,\n        statement,\n      )\n      + match kernel_dependent.infer(\n        r.env,\n        [],\n        kernel_dependent_hol.lams(ps, body),\n      ) {\n        Ok(_) => \" (closed, it infers)\",\n        Err(e) => \" (closed: \" + e + \")\",\n      })\n  }\n  Ok((cn, ps.map(p -> p.0)))\n}","old_text":"/// `statement` and its proof `body` closed over their free variables and\n/// `hyps`, defined as `cn`: the names it is applied to.\nfn close_term(\n  mut r: kernel_dependent_hol.Replay,\n  cn: String,\n  statement: kernel_dependent_hol.D,\n  body: kernel_dependent_hol.D,\n  hyps: List[(String, kernel_dependent_hol.D)],\n) -> Result[(String, List[String]), String] {\n  mut frees := kernel_dependent_hol.free_names(statement)\n  for n in kernel_dependent_hol.free_names(body) {\n    if !contains(frees, n) && !starts_with(n, \"h:\") {\n      mut frees.push(n)\n    }\n  }\n  types := frees\n    .filter(n -> starts_with(n, \"'\"))\n    .map(n -> (n, kernel_dependent.Sort(0)))\n  mut vars := []\n  for n in frees.filter(n -> starts_with(n, \"v:\")) {\n    match get(r.vars, n) {\n      Some(v) => mut vars.push(\n        (n, kernel_dependent_hol.type_term(\n          mut r,\n          kernel_dependent_hol.hol_type(v),\n        )!),\n      ),\n      None => return Err(\"`\" + n + \"`: an unknown variable\"),\n    }\n  }\n  ps := types + vars + hyps\n  r.env = kernel_dependent.define(\n    r.env,\n    cn,\n    kernel_dependent_hol.pis(ps, statement),\n    kernel_dependent_hol.lams(ps, body),\n  ) except m {\n    return Err(m\n      + kernel_dependent_hol.diagnose(\n        r.env,\n        ps.reversed(),\n        body,\n        statement,\n      )\n      + match kernel_dependent.infer(\n        r.env,\n        [],\n        kernel_dependent_hol.lams(ps, body),\n      ) {\n        Ok(_) => \" (closed, it infers)\",\n        Err(e) => \" (closed: \" + e + \")\",\n      })\n  }\n  Ok((cn, ps.map(p -> p.0)))\n}"}]}
{"id":"45f99f4ce2d0d80c","time":1795855026,"message":"edit","changes":[{"name":"kernel_dependent_hol.Replay","kind":"type","old":"9ac52d8c0e6a7841","new":"b2187ee437e71f54","interface_changed":true,"affected":["kernel_dependent_hol.variable","kernel_dependent_hol.type_term","kernel_dependent_hol.term","kernel_dependent_hol.constant","kernel_dependent_hol.define_group","kernel_dependent_hol.type_term_in_group","kernel_dependent_hol.conclusion_of","kernel_dependent_hol.proof","kernel_dependent_hol.define_constant","kernel_dependent_hol.compute_equality","kernel_dependent_hol.named","kernel_dependent_hol.close_term","kernel_dependent_hol.axiom","kernel_dependent_hol.tautology","kernel_dependent_hol.datatype_fact","kernel_dependent_hol.injective","kernel_dependent_hol.distinct","kernel_dependent_hol.induction","kernel_dependent_hol.start","kernel_dependent_hol.check_law","kernel_dependent_hol.goal_for","kernel_dependent_hol.environment","kernel_dependent_hol.kernel_time","kernel_dependent_hol.derive","kernel_cli.replayed","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent_hol","text":"/// What replaying has built: the environment, each HOL constant's\n/// dependent constant (its type variables in order and generic type),\n/// each free variable's HOL variable by name, each named theorem's\n/// constant and the free variables it is applied to, and the datatypes\n/// (by type, its group's specs); how long the kernel's checks took; and\n/// each statement proven so far, by its text: its term, or once met twice,\n/// the constant it is defined as and what that is applied to.\npub type Replay = {\n  env: kernel_dependent.Environment,\n  consts: Dict[String, (List[String], kernel.Type)],\n  vars: Dict[String, kernel.Term],\n  named: Dict[String, (String, List[String])],\n  groups: Dict[String, List[kernel.DatatypeSpec]],\n  equations: Dict[String, List[kernel.Theorem]],\n  defined_groups: List[String],\n  clock: std.time.SystemClock,\n  kernel_ns: Int = 0,\n  shared: Dict[String, (String, List[String], kernel_dependent_hol.D)] = Dict[String, (String, List[String], kernel_dependent_hol.D)] {},\n  share_count: Int = 0,\n}","old_text":"/// What replaying has built: the environment, each HOL constant's\n/// dependent constant (its type variables in order and generic type),\n/// each free variable's HOL variable by name, each named theorem's\n/// constant and the free variables it is applied to, and the datatypes\n/// (by type, its group's specs); how long the kernel's checks took.\npub type Replay = {\n  env: kernel_dependent.Environment,\n  consts: Dict[String, (List[String], kernel.Type)],\n  vars: Dict[String, kernel.Term],\n  named: Dict[String, (String, List[String])],\n  groups: Dict[String, List[kernel.DatatypeSpec]],\n  equations: Dict[String, List[kernel.Theorem]],\n  defined_groups: List[String],\n  clock: std.time.SystemClock,\n  kernel_ns: Int = 0,\n}"},{"name":"kernel_dependent_hol.proof","kind":"fn","old":"793404619c3da2ca","new":"e8e7c2e3dd06ecbc","interface_changed":false,"affected":[],"module":"kernel_dependent_hol","text":"/// The term proving `th`'s conclusion (as `holds`), from its hypotheses as\n/// free variables `h:…` and its free variables as `v:…`. A statement met\n/// a second time is defined as a constant, which the kernel checks once,\n/// and every later proof of it is that constant.\npub fn proof(\n  mut r: kernel_dependent_hol.Replay,\n  th: kernel.Theorem,\n) -> Result[kernel_dependent_hol.D, String] {\n  hs := kernel.assumptions(th)\n  k := kernel_dependent_hol.key(kernel.conclusion(th))\n    + \"|\"\n    + join(hs.map(h -> kernel_dependent_hol.key(h)), \"|\")\n  match get(r.shared, k) {\n    Some((cn, args, t)) => {\n      if cn != \"\" {\n        return Ok(kernel_dependent_hol.at(\n          kernel_dependent_hol.c(cn),\n          args.map(a -> Free(a)),\n        ))\n      }\n      statement := kernel_dependent_hol.holds(\n        kernel_dependent_hol.conclusion_of(mut r, th)!,\n      )\n      mut hyps := []\n      for h in hs {\n        mut hyps.push(\n          (\n            kernel_dependent_hol.hypothesis(h),\n            kernel_dependent_hol.holds(\n              kernel_dependent_hol.term(mut r, h)!,\n            ),\n          ),\n        )\n      }\n      r.share_count += 1\n      (name, xs) := kernel_dependent_hol.close_term(\n        mut r,\n        \"h.shared.\" + to_string(r.share_count),\n        statement,\n        t,\n        hyps,\n      )!\n      mut r.shared.insert(k, (name, xs, t))\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(name),\n        xs.map(a -> Free(a)),\n      ))\n    },\n    None => {\n      t := kernel_dependent_hol.derive(mut r, th)!\n      mut r.shared.insert(k, (\"\", [], t))\n      Ok(t)\n    },\n  }\n}","old_text":"/// The term proving `th`'s conclusion (as `holds`), from its hypotheses as\n/// free variables `h:…` and its free variables as `v:…`.\npub fn proof(\n  mut r: kernel_dependent_hol.Replay,\n  th: kernel.Theorem,\n) -> Result[kernel_dependent_hol.D, String] {\n  st := kernel.step_of(th)\n  premise := (i: Int) -> get(st.premises, i) ?? th\n  rule := st.rule\n  ct := kernel.conclusion(th)\n  if starts_with(rule, \"named:\") {\n    return kernel_dependent_hol.named(\n      mut r,\n      byte_slice(rule, 6, byte_len(rule)),\n      premise(0),\n    )\n  }\n  if starts_with(rule, \"axiom:\") {\n    return kernel_dependent_hol.axiom(\n      mut r,\n      byte_slice(rule, 6, byte_len(rule)),\n      th,\n    )\n  }\n  if starts_with(rule, \"oracle:\") {\n    return Ok(kernel_dependent.Apply {\n      function: kernel_dependent_hol.c(\"oracle\"),\n      argument: kernel_dependent_hol.holds(\n        kernel_dependent_hol.conclusion_of(mut r, th)!,\n      ),\n    })\n  }\n  match rule {\n    \"refl\" | \"beta\" | \"compute\" | \"define\" => {\n      if rule == \"define\" {\n        kernel_dependent_hol.define_constant(mut r, st.terms)!\n      }\n      (l, rt) := kernel_dependent_hol.eq_parts(ct)\n      a_type := kernel_dependent_hol.type_term(\n        mut r,\n        kernel_dependent_hol.hol_type(l),\n      )!\n      if rule == \"compute\" && kernel.split_equation(l) is Some {\n        return kernel_dependent_hol.compute_equality(mut r, l, rt)\n      }\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.refl\"),\n        [a_type, kernel_dependent_hol.term(mut r, l)!],\n      ))\n    },\n    \"trans\" => {\n      (a, b) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      (_, cc) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(1)))\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.trans\"),\n          [\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.hol_type(a),\n            )!,\n            kernel_dependent_hol.term(mut r, a)!,\n            kernel_dependent_hol.term(mut r, b)!,\n            kernel_dependent_hol.term(mut r, cc)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.proof(mut r, premise(1))!,\n          ],\n        ),\n      )\n    },\n    \"cong\" => {\n      (f, g) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      (x, y) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(1)))\n      ft := kernel_dependent_hol.hol_type(f)\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.cong\"),\n          [\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.first_argument(ft),\n            )!,\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.second(ft),\n            )!,\n            kernel_dependent_hol.term(mut r, f)!,\n            kernel_dependent_hol.term(mut r, g)!,\n            kernel_dependent_hol.term(mut r, x)!,\n            kernel_dependent_hol.term(mut r, y)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.proof(mut r, premise(1))!,\n          ],\n        ),\n      )\n    },\n    \"abs\" => {\n      (lhs, rhs) := kernel_dependent_hol.eq_parts(ct)\n      x := get(st.terms, 0) ?? lhs\n      xn := kernel_dependent_hol.variable(mut r, x)\n      xt := kernel_dependent_hol.hol_type(x)\n      (s, t) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      inner := kernel_dependent_hol.proof(mut r, premise(0))!\n      Ok(\n        kernel_dependent_hol.at(kernel_dependent_hol.c(\"hol.abs\"), [\n          kernel_dependent_hol.type_term(mut r, xt)!,\n          kernel_dependent_hol.type_term(\n            mut r,\n            kernel_dependent_hol.hol_type(s),\n          )!,\n          kernel_dependent_hol.term(mut r, lhs)!,\n          kernel_dependent_hol.term(mut r, rhs)!,\n          kernel_dependent.lambda(\n            xn,\n            kernel_dependent_hol.type_term(mut r, xt)!,\n            inner,\n          ),\n        ]),\n      )\n    },\n    \"assume\" => Ok(kernel_dependent.Free(kernel_dependent_hol.hypothesis(ct))),\n    \"eq_mp\" => {\n      (p, q) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.eq_mp\"),\n          [\n            kernel_dependent_hol.term(mut r, p)!,\n            kernel_dependent_hol.term(mut r, q)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.proof(mut r, premise(1))!,\n          ],\n        ),\n      )\n    },\n    \"antisym\" => {\n      p := kernel.conclusion(premise(0))\n      q := kernel.conclusion(premise(1))\n      dp := kernel_dependent_hol.term(mut r, p)!\n      dq := kernel_dependent_hol.term(mut r, q)!\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.antisym\"),\n        [dp, dq, kernel_dependent.lambda(\n          kernel_dependent_hol.hypothesis(q),\n          kernel_dependent_hol.holds(dq),\n          kernel_dependent_hol.proof(mut r, premise(0))!,\n        ), kernel_dependent.lambda(\n          kernel_dependent_hol.hypothesis(p),\n          kernel_dependent_hol.holds(dp),\n          kernel_dependent_hol.proof(mut r, premise(1))!,\n        )],\n      ))\n    },\n    \"disch\" => {\n      p := get(st.terms, 0) ?? ct\n      dp := kernel_dependent_hol.term(mut r, p)!\n      dq := kernel_dependent_hol.term(\n        mut r,\n        kernel.conclusion(premise(0)),\n      )!\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.disch\"),\n        [dp, dq, kernel_dependent.lambda(\n          kernel_dependent_hol.hypothesis(p),\n          kernel_dependent_hol.holds(dp),\n          kernel_dependent_hol.proof(mut r, premise(0))!,\n        )],\n      ))\n    },\n    \"mp\" => {\n      (p, q) := kernel.split_connective(\"==>\", kernel.conclusion(premise(0))) ?? (ct, ct)\n      Ok(kernel_dependent_hol.at(kernel_dependent_hol.c(\"hol.mp\"), [\n        kernel_dependent_hol.term(mut r, p)!,\n        kernel_dependent_hol.term(mut r, q)!,\n        kernel_dependent_hol.proof(mut r, premise(0))!,\n        kernel_dependent_hol.proof(mut r, premise(1))!,\n      ]))\n    },\n    \"gen\" => {\n      x := get(st.terms, 0) ?? ct\n      xn := kernel_dependent_hol.variable(mut r, x)\n      (_, lam) := kernel_dependent_hol.split_application(ct)\n      xt := kernel_dependent_hol.type_term(\n        mut r,\n        kernel_dependent_hol.hol_type(x),\n      )!\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"all_intro\"),\n          [\n            xt,\n            kernel_dependent_hol.term(mut r, lam)!,\n            kernel_dependent.lambda(\n              xn,\n              xt,\n              kernel_dependent_hol.proof(mut r, premise(0))!,\n            ),\n          ],\n        ),\n      )\n    },\n    \"spec\" => {\n      t := get(st.terms, 0) ?? ct\n      (_, lam) := kernel_dependent_hol.split_application(\n        kernel.conclusion(premise(0)),\n      )\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"all_elim\"),\n          [\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.hol_type(t),\n            )!,\n            kernel_dependent_hol.term(mut r, lam)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.term(mut r, t)!,\n          ],\n        ),\n      )\n    },\n    \"inst\" => {\n      inner := kernel_dependent_hol.proof(mut r, premise(0))!\n      mut s := []\n      for (v, u) in st.substitution {\n        mut s.push(\n          (\n            kernel_dependent_hol.variable(mut r, v),\n            kernel_dependent_hol.term(mut r, u)!,\n          ),\n        )\n      }\n      for (i, h) in enumerate(kernel.assumptions(premise(0))) {\n        mut s.push(\n          (\n            kernel_dependent_hol.hypothesis(h),\n            kernel_dependent.Free(kernel_dependent_hol.hypothesis(\n              get(kernel.assumptions(th), i) ?? h,\n            )),\n          ),\n        )\n      }\n      Ok(kernel_dependent_hol.substitute(inner, s))\n    },\n    \"inst_type\" => {\n      inner := kernel_dependent_hol.proof(mut r, premise(0))!\n      mut s := []\n      for (v, t) in st.types {\n        mut s.push((\"'\" + v, kernel_dependent_hol.type_term(mut r, t)!))\n      }\n      for n in kernel_dependent_hol.free_names(inner) {\n        match get(r.vars, n) {\n          Some(kernel.Variable { name, value_type }) => {\n            nv := kernel.Variable {\n              name,\n              value_type: kernel.substitute_types(value_type, st.types),\n            }\n            mut s.push(\n              (n, kernel_dependent.Free(\n                kernel_dependent_hol.variable(mut r, nv),\n              )),\n            )\n          },\n          _ => (),\n        }\n      }\n      for (i, h) in enumerate(kernel.assumptions(premise(0))) {\n        mut s.push(\n          (\n            kernel_dependent_hol.hypothesis(h),\n            kernel_dependent.Free(kernel_dependent_hol.hypothesis(\n              get(kernel.assumptions(th), i) ?? h,\n            )),\n          ),\n        )\n      }\n      Ok(kernel_dependent_hol.substitute(inner, s))\n    },\n    \"induction\" | \"recursion\" | \"cases\" | \"injective\" | \"distinct\" => kernel_dependent_hol.datatype_fact(mut r, st, th),\n    _ => Err(\"no replay for the rule `\" + rule + \"`\"),\n  }\n}"},{"name":"kernel_dependent_hol.derive","kind":"fn","old":null,"new":"7751012373a808f4","interface_changed":true,"affected":[],"module":"kernel_dependent_hol","text":"/// The term proving `th`'s conclusion (as `holds`), from its hypotheses as\n/// free variables `h:…` and its free variables as `v:…`.\nfn derive(\n  mut r: kernel_dependent_hol.Replay,\n  th: kernel.Theorem,\n) -> Result[kernel_dependent_hol.D, String] {\n  st := kernel.step_of(th)\n  premise := (i: Int) -> get(st.premises, i) ?? th\n  rule := st.rule\n  ct := kernel.conclusion(th)\n  if starts_with(rule, \"named:\") {\n    return kernel_dependent_hol.named(\n      mut r,\n      byte_slice(rule, 6, byte_len(rule)),\n      premise(0),\n    )\n  }\n  if starts_with(rule, \"axiom:\") {\n    return kernel_dependent_hol.axiom(\n      mut r,\n      byte_slice(rule, 6, byte_len(rule)),\n      th,\n    )\n  }\n  if starts_with(rule, \"oracle:\") {\n    return Ok(kernel_dependent.Apply {\n      function: kernel_dependent_hol.c(\"oracle\"),\n      argument: kernel_dependent_hol.holds(\n        kernel_dependent_hol.conclusion_of(mut r, th)!,\n      ),\n    })\n  }\n  match rule {\n    \"refl\" | \"beta\" | \"compute\" | \"define\" => {\n      if rule == \"define\" {\n        kernel_dependent_hol.define_constant(mut r, st.terms)!\n      }\n      (l, rt) := kernel_dependent_hol.eq_parts(ct)\n      a_type := kernel_dependent_hol.type_term(\n        mut r,\n        kernel_dependent_hol.hol_type(l),\n      )!\n      if rule == \"compute\" && kernel.split_equation(l) is Some {\n        return kernel_dependent_hol.compute_equality(mut r, l, rt)\n      }\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.refl\"),\n        [a_type, kernel_dependent_hol.term(mut r, l)!],\n      ))\n    },\n    \"trans\" => {\n      (a, b) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      (_, cc) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(1)))\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.trans\"),\n          [\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.hol_type(a),\n            )!,\n            kernel_dependent_hol.term(mut r, a)!,\n            kernel_dependent_hol.term(mut r, b)!,\n            kernel_dependent_hol.term(mut r, cc)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.proof(mut r, premise(1))!,\n          ],\n        ),\n      )\n    },\n    \"cong\" => {\n      (f, g) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      (x, y) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(1)))\n      ft := kernel_dependent_hol.hol_type(f)\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.cong\"),\n          [\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.first_argument(ft),\n            )!,\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.second(ft),\n            )!,\n            kernel_dependent_hol.term(mut r, f)!,\n            kernel_dependent_hol.term(mut r, g)!,\n            kernel_dependent_hol.term(mut r, x)!,\n            kernel_dependent_hol.term(mut r, y)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.proof(mut r, premise(1))!,\n          ],\n        ),\n      )\n    },\n    \"abs\" => {\n      (lhs, rhs) := kernel_dependent_hol.eq_parts(ct)\n      x := get(st.terms, 0) ?? lhs\n      xn := kernel_dependent_hol.variable(mut r, x)\n      xt := kernel_dependent_hol.hol_type(x)\n      (s, t) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      inner := kernel_dependent_hol.proof(mut r, premise(0))!\n      Ok(\n        kernel_dependent_hol.at(kernel_dependent_hol.c(\"hol.abs\"), [\n          kernel_dependent_hol.type_term(mut r, xt)!,\n          kernel_dependent_hol.type_term(\n            mut r,\n            kernel_dependent_hol.hol_type(s),\n          )!,\n          kernel_dependent_hol.term(mut r, lhs)!,\n          kernel_dependent_hol.term(mut r, rhs)!,\n          kernel_dependent.lambda(\n            xn,\n            kernel_dependent_hol.type_term(mut r, xt)!,\n            inner,\n          ),\n        ]),\n      )\n    },\n    \"assume\" => Ok(kernel_dependent.Free(kernel_dependent_hol.hypothesis(ct))),\n    \"eq_mp\" => {\n      (p, q) := kernel_dependent_hol.eq_parts(kernel.conclusion(premise(0)))\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"hol.eq_mp\"),\n          [\n            kernel_dependent_hol.term(mut r, p)!,\n            kernel_dependent_hol.term(mut r, q)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.proof(mut r, premise(1))!,\n          ],\n        ),\n      )\n    },\n    \"antisym\" => {\n      p := kernel.conclusion(premise(0))\n      q := kernel.conclusion(premise(1))\n      dp := kernel_dependent_hol.term(mut r, p)!\n      dq := kernel_dependent_hol.term(mut r, q)!\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.antisym\"),\n        [dp, dq, kernel_dependent.lambda(\n          kernel_dependent_hol.hypothesis(q),\n          kernel_dependent_hol.holds(dq),\n          kernel_dependent_hol.proof(mut r, premise(0))!,\n        ), kernel_dependent.lambda(\n          kernel_dependent_hol.hypothesis(p),\n          kernel_dependent_hol.holds(dp),\n          kernel_dependent_hol.proof(mut r, premise(1))!,\n        )],\n      ))\n    },\n    \"disch\" => {\n      p := get(st.terms, 0) ?? ct\n      dp := kernel_dependent_hol.term(mut r, p)!\n      dq := kernel_dependent_hol.term(\n        mut r,\n        kernel.conclusion(premise(0)),\n      )!\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(\"hol.disch\"),\n        [dp, dq, kernel_dependent.lambda(\n          kernel_dependent_hol.hypothesis(p),\n          kernel_dependent_hol.holds(dp),\n          kernel_dependent_hol.proof(mut r, premise(0))!,\n        )],\n      ))\n    },\n    \"mp\" => {\n      (p, q) := kernel.split_connective(\"==>\", kernel.conclusion(premise(0))) ?? (ct, ct)\n      Ok(kernel_dependent_hol.at(kernel_dependent_hol.c(\"hol.mp\"), [\n        kernel_dependent_hol.term(mut r, p)!,\n        kernel_dependent_hol.term(mut r, q)!,\n        kernel_dependent_hol.proof(mut r, premise(0))!,\n        kernel_dependent_hol.proof(mut r, premise(1))!,\n      ]))\n    },\n    \"gen\" => {\n      x := get(st.terms, 0) ?? ct\n      xn := kernel_dependent_hol.variable(mut r, x)\n      (_, lam) := kernel_dependent_hol.split_application(ct)\n      xt := kernel_dependent_hol.type_term(\n        mut r,\n        kernel_dependent_hol.hol_type(x),\n      )!\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"all_intro\"),\n          [\n            xt,\n            kernel_dependent_hol.term(mut r, lam)!,\n            kernel_dependent.lambda(\n              xn,\n              xt,\n              kernel_dependent_hol.proof(mut r, premise(0))!,\n            ),\n          ],\n        ),\n      )\n    },\n    \"spec\" => {\n      t := get(st.terms, 0) ?? ct\n      (_, lam) := kernel_dependent_hol.split_application(\n        kernel.conclusion(premise(0)),\n      )\n      Ok(\n        kernel_dependent_hol.at(\n          kernel_dependent_hol.c(\"all_elim\"),\n          [\n            kernel_dependent_hol.type_term(\n              mut r,\n              kernel_dependent_hol.hol_type(t),\n            )!,\n            kernel_dependent_hol.term(mut r, lam)!,\n            kernel_dependent_hol.proof(mut r, premise(0))!,\n            kernel_dependent_hol.term(mut r, t)!,\n          ],\n        ),\n      )\n    },\n    \"inst\" => {\n      inner := kernel_dependent_hol.proof(mut r, premise(0))!\n      mut s := []\n      for (v, u) in st.substitution {\n        mut s.push(\n          (\n            kernel_dependent_hol.variable(mut r, v),\n            kernel_dependent_hol.term(mut r, u)!,\n          ),\n        )\n      }\n      for (i, h) in enumerate(kernel.assumptions(premise(0))) {\n        mut s.push(\n          (\n            kernel_dependent_hol.hypothesis(h),\n            kernel_dependent.Free(kernel_dependent_hol.hypothesis(\n              get(kernel.assumptions(th), i) ?? h,\n            )),\n          ),\n        )\n      }\n      Ok(kernel_dependent_hol.substitute(inner, s))\n    },\n    \"inst_type\" => {\n      inner := kernel_dependent_hol.proof(mut r, premise(0))!\n      mut s := []\n      for (v, t) in st.types {\n        mut s.push((\"'\" + v, kernel_dependent_hol.type_term(mut r, t)!))\n      }\n      for n in kernel_dependent_hol.free_names(inner) {\n        match get(r.vars, n) {\n          Some(kernel.Variable { name, value_type }) => {\n            nv := kernel.Variable {\n              name,\n              value_type: kernel.substitute_types(value_type, st.types),\n            }\n            mut s.push(\n              (n, kernel_dependent.Free(\n                kernel_dependent_hol.variable(mut r, nv),\n              )),\n            )\n          },\n          _ => (),\n        }\n      }\n      for (i, h) in enumerate(kernel.assumptions(premise(0))) {\n        mut s.push(\n          (\n            kernel_dependent_hol.hypothesis(h),\n            kernel_dependent.Free(kernel_dependent_hol.hypothesis(\n              get(kernel.assumptions(th), i) ?? h,\n            )),\n          ),\n        )\n      }\n      Ok(kernel_dependent_hol.substitute(inner, s))\n    },\n    \"induction\" | \"recursion\" | \"cases\" | \"injective\" | \"distinct\" => kernel_dependent_hol.datatype_fact(mut r, st, th),\n    _ => Err(\"no replay for the rule `\" + rule + \"`\"),\n  }\n}"}]}
{"id":"3066b0c1a9ce8e6a","time":1795855061,"message":"edit","changes":[{"name":"kernel_dependent_hol.proof","kind":"fn","old":"e8e7c2e3dd06ecbc","new":"f7b5cc9fdc466d3f","interface_changed":false,"affected":[],"module":"kernel_dependent_hol","text":"/// The term proving `th`'s conclusion (as `holds`), from its hypotheses as\n/// free variables `h:…` and its free variables as `v:…`. A statement met\n/// a second time is defined as a constant, which the kernel checks once,\n/// and every later proof of it is that constant.\npub fn proof(\n  mut r: kernel_dependent_hol.Replay,\n  th: kernel.Theorem,\n) -> Result[kernel_dependent_hol.D, String] {\n  hs := kernel.assumptions(th)\n  k := kernel_dependent_hol.key(kernel.conclusion(th))\n    + \"|\"\n    + join(hs.map(h -> kernel_dependent_hol.key(h)), \"|\")\n  match get(r.shared, k) {\n    Some((cn, args, t)) => {\n      if cn != \"\" {\n        return Ok(kernel_dependent_hol.at(\n          kernel_dependent_hol.c(cn),\n          args.map(a -> kernel_dependent.Free(a)),\n        ))\n      }\n      statement := kernel_dependent_hol.holds(\n        kernel_dependent_hol.conclusion_of(mut r, th)!,\n      )\n      mut hyps := []\n      for h in hs {\n        mut hyps.push(\n          (\n            kernel_dependent_hol.hypothesis(h),\n            kernel_dependent_hol.holds(\n              kernel_dependent_hol.term(mut r, h)!,\n            ),\n          ),\n        )\n      }\n      r.share_count += 1\n      (name, xs) := kernel_dependent_hol.close_term(\n        mut r,\n        \"h.shared.\" + to_string(r.share_count),\n        statement,\n        t,\n        hyps,\n      )!\n      mut r.shared.insert(k, (name, xs, t))\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(name),\n        xs.map(a -> kernel_dependent.Free(a)),\n      ))\n    },\n    None => {\n      t := kernel_dependent_hol.derive(mut r, th)!\n      mut r.shared.insert(k, (\"\", [], t))\n      Ok(t)\n    },\n  }\n}","old_text":"/// The term proving `th`'s conclusion (as `holds`), from its hypotheses as\n/// free variables `h:…` and its free variables as `v:…`. A statement met\n/// a second time is defined as a constant, which the kernel checks once,\n/// and every later proof of it is that constant.\npub fn proof(\n  mut r: kernel_dependent_hol.Replay,\n  th: kernel.Theorem,\n) -> Result[kernel_dependent_hol.D, String] {\n  hs := kernel.assumptions(th)\n  k := kernel_dependent_hol.key(kernel.conclusion(th))\n    + \"|\"\n    + join(hs.map(h -> kernel_dependent_hol.key(h)), \"|\")\n  match get(r.shared, k) {\n    Some((cn, args, t)) => {\n      if cn != \"\" {\n        return Ok(kernel_dependent_hol.at(\n          kernel_dependent_hol.c(cn),\n          args.map(a -> Free(a)),\n        ))\n      }\n      statement := kernel_dependent_hol.holds(\n        kernel_dependent_hol.conclusion_of(mut r, th)!,\n      )\n      mut hyps := []\n      for h in hs {\n        mut hyps.push(\n          (\n            kernel_dependent_hol.hypothesis(h),\n            kernel_dependent_hol.holds(\n              kernel_dependent_hol.term(mut r, h)!,\n            ),\n          ),\n        )\n      }\n      r.share_count += 1\n      (name, xs) := kernel_dependent_hol.close_term(\n        mut r,\n        \"h.shared.\" + to_string(r.share_count),\n        statement,\n        t,\n        hyps,\n      )!\n      mut r.shared.insert(k, (name, xs, t))\n      Ok(kernel_dependent_hol.at(\n        kernel_dependent_hol.c(name),\n        xs.map(a -> Free(a)),\n      ))\n    },\n    None => {\n      t := kernel_dependent_hol.derive(mut r, th)!\n      mut r.shared.insert(k, (\"\", [], t))\n      Ok(t)\n    },\n  }\n}"}]}
{"id":"aa4991fbe100e684","time":1795855106,"message":"edit","changes":[{"name":"kernel_dependent_hol.close_term","kind":"fn","old":"f9d71b129d94b9cb","new":"ad96e7d04dae7bc3","interface_changed":false,"affected":[],"module":"kernel_dependent_hol","text":"/// `statement` and its proof `body` closed over their free variables and\n/// `hyps`, defined as `cn`: the names it is applied to.\nfn close_term(\n  mut r: kernel_dependent_hol.Replay,\n  cn: String,\n  statement: kernel_dependent_hol.D,\n  body: kernel_dependent_hol.D,\n  hyps: List[(String, kernel_dependent_hol.D)],\n) -> Result[(String, List[String]), String] {\n  mut frees := kernel_dependent_hol.free_names(statement)\n  for n in kernel_dependent_hol.free_names(body) {\n    if !contains(frees, n) && !starts_with(n, \"h:\") {\n      mut frees.push(n)\n    }\n  }\n  mut vars := []\n  for n in frees.filter(n -> starts_with(n, \"v:\")) {\n    match get(r.vars, n) {\n      Some(v) => mut vars.push(\n        (n, kernel_dependent_hol.type_term(\n          mut r,\n          kernel_dependent_hol.hol_type(v),\n        )!),\n      ),\n      None => return Err(\"`\" + n + \"`: an unknown variable\"),\n    }\n  }\n  // the type variables, also those only the variables' and hypotheses'\n  // types mention\n  mut tnames := frees.filter(n -> starts_with(n, \"'\"))\n  for (_, t) in vars + hyps {\n    for n in kernel_dependent_hol.free_names(t) {\n      if starts_with(n, \"'\") && !contains(tnames, n) {\n        mut tnames.push(n)\n      }\n    }\n  }\n  types := tnames.map(n -> (n, kernel_dependent.Sort(0)))\n  ps := types + vars + hyps\n  t0 := r.clock.now().value\n  checked := kernel_dependent.define(\n    r.env,\n    cn,\n    kernel_dependent_hol.pis(ps, statement),\n    kernel_dependent_hol.lams(ps, body),\n  )\n  r.kernel_ns += r.clock.now().value - t0\n  r.env = checked except m {\n    return Err(m\n      + kernel_dependent_hol.diagnose(\n        r.env,\n        ps.reversed(),\n        body,\n        statement,\n      )\n      + match kernel_dependent.infer(\n        r.env,\n        [],\n        kernel_dependent_hol.lams(ps, body),\n      ) {\n        Ok(_) => \" (closed, it infers)\",\n        Err(e) => \" (closed: \" + e + \")\",\n      })\n  }\n  Ok((cn, ps.map(p -> p.0)))\n}","old_text":"/// `statement` and its proof `body` closed over their free variables and\n/// `hyps`, defined as `cn`: the names it is applied to.\nfn close_term(\n  mut r: kernel_dependent_hol.Replay,\n  cn: String,\n  statement: kernel_dependent_hol.D,\n  body: kernel_dependent_hol.D,\n  hyps: List[(String, kernel_dependent_hol.D)],\n) -> Result[(String, List[String]), String] {\n  mut frees := kernel_dependent_hol.free_names(statement)\n  for n in kernel_dependent_hol.free_names(body) {\n    if !contains(frees, n) && !starts_with(n, \"h:\") {\n      mut frees.push(n)\n    }\n  }\n  types := frees\n    .filter(n -> starts_with(n, \"'\"))\n    .map(n -> (n, kernel_dependent.Sort(0)))\n  mut vars := []\n  for n in frees.filter(n -> starts_with(n, \"v:\")) {\n    match get(r.vars, n) {\n      Some(v) => mut vars.push(\n        (n, kernel_dependent_hol.type_term(\n          mut r,\n          kernel_dependent_hol.hol_type(v),\n        )!),\n      ),\n      None => return Err(\"`\" + n + \"`: an unknown variable\"),\n    }\n  }\n  ps := types + vars + hyps\n  t0 := r.clock.now().value\n  checked := kernel_dependent.define(\n    r.env,\n    cn,\n    kernel_dependent_hol.pis(ps, statement),\n    kernel_dependent_hol.lams(ps, body),\n  )\n  r.kernel_ns += r.clock.now().value - t0\n  r.env = checked except m {\n    return Err(m\n      + kernel_dependent_hol.diagnose(\n        r.env,\n        ps.reversed(),\n        body,\n        statement,\n      )\n      + match kernel_dependent.infer(\n        r.env,\n        [],\n        kernel_dependent_hol.lams(ps, body),\n      ) {\n        Ok(_) => \" (closed, it infers)\",\n        Err(e) => \" (closed: \" + e + \")\",\n      })\n  }\n  Ok((cn, ps.map(p -> p.0)))\n}"}]}
{"id":"7071c755b33d47bd","time":1795855159,"message":"edit","changes":[{"name":"kernel_dependent_hol.check_law","kind":"fn","old":"13173e2218329c4f","new":"6a0e012a527d840a","interface_changed":false,"affected":[],"module":"kernel_dependent_hol","text":"/// A law the HOL kernel proved, checked by the dependent kernel: its proof\n/// term's size.\npub fn check_law(\n  mut r: kernel_dependent_hol.Replay,\n  name: String,\n  th: kernel.Theorem,\n) -> Result[Int, String] {\n  if kernel.step_of(th).rule != \"named:\" + name {\n    return kernel_dependent_hol.check_law(\n      mut r,\n      name,\n      kernel.named(name, th),\n    )\n  }\n  _ := kernel_dependent_hol.named(\n    mut r,\n    name,\n    get(kernel.step_of(th).premises, 0) ?? th,\n  )!\n  match kernel_dependent.lookup(r.env, \"h.law.\" + name) {\n    Some(kernel_dependent.Entry { value: Some(v), .. }) => Ok(kernel_dependent_hol.size(v)),\n    _ => Err(\"not defined\"),\n  }\n}","old_text":"/// A law the HOL kernel proved, checked by the dependent kernel: its proof\n/// term's size.\npub fn check_law(\n  mut r: kernel_dependent_hol.Replay,\n  name: String,\n  th: kernel.Theorem,\n) -> Result[Int, String] {\n  if kernel.step_of(th).rule != \"named:\" + name {\n    return kernel_dependent_hol.check_law(\n      mut r,\n      name,\n      kernel.named(name, th),\n    )\n  }\n  _ := kernel_dependent_hol.proof(mut r, th)!\n  match kernel_dependent.lookup(r.env, \"h.law.\" + name) {\n    Some(kernel_dependent.Entry { value: Some(v), .. }) => Ok(kernel_dependent_hol.size(v)),\n    _ => Err(\"not defined\"),\n  }\n}"}]}
{"id":"966679c64c84781b","time":1795855218,"message":"edit","changes":[{"name":"kernel_dependent.convertible","kind":"fn","old":"204d4dcbbd3d7232","new":"7a5cddb35f243a5b","interface_changed":false,"affected":["kernel_dependent.has_type","kernel_dependent_hol.diagnose","kernel_dependent_hol.find_bad","kernel_dependent_patch.records","kernel_dependent_tactics.exact","kernel_dependent_tactics.simplify","kernel_dependent.infer","kernel_dependent.define","kernel_dependent_hol.close_term","kernel_cli.dependent","kernel_dependent_records.laws","kernel_dependent_hol.base","kernel_dependent_hol.by_conversion","kernel_dependent_hol.injective","kernel_dependent_hol.distinct","kernel_dependent_hol.induction","kernel_dependent_patch.laws","kernel_dependent_hol.split_all","kernel_dependent_records.prove_applied_at","kernel_dependent_records.split_field","kernel_dependent_records.run","kernel_dependent.sort_of","kernel_dependent_hol.eliminate_to","kernel_dependent_patch.instances","kernel_dependent_records.matched","kernel_dependent_records.statement","kernel_dependent_records.at_record","kernel_dependent_tactics.type_in","kernel_dependent.empty_environment","kernel_dependent_hol.define_group","kernel_dependent_hol.define_constant","kernel_dependent_patch.base","kernel_dependent_patch.define_generic","kernel_dependent_patch.timed","kernel_dependent_patch.add_schema","kernel_dependent_patch.refusals","kernel_dependent_records.add_type_function","kernel_dependent_records.add_impl","kernel_dependent_tactics.prove","kernel_dependent_hol.proof","kernel_dependent_hol.named","kernel_dependent_hol.datatype_fact","kernel_cli.command","kernel_cli.every_record","kernel_dependent_hol.start","kernel_dependent_hol.tautology","kernel_dependent_records.add_applied_at","kernel_dependent_records.steps","kernel_dependent.add_inductives","kernel_dependent_tactics.rewrite","kernel_dependent_tactics.funext","kernel_dependent_tactics.eliminate","kernel_dependent_tactics.subst","kernel_dependent_hol.projection","kernel_dependent_records.expr","kernel_dependent_records.changed","kernel_dependent_hol.type_term","kernel_dependent_hol.constant","kernel_dependent_hol.derive","kernel_dependent_patch.definitions","kernel_dependent_hol.check_law","command_line","kernel_cli.replayed","kernel_dependent_hol.axiom","kernel_dependent.add_inductive","kernel_dependent_tactics.cases","kernel_dependent_tactics.induction","kernel_dependent_hol.term","kernel_dependent_hol.type_term_in_group","kernel_dependent_hol.goal_for","main","kernel_dependent_records.add_sum","kernel_dependent_hol.conclusion_of","kernel_dependent_hol.compute_equality","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent","text":"/// Whether `a` and `b` are definitionally equal: the same once reduced,\n/// with η for functions. One constant applied to convertible arguments\n/// on both sides is equal without unfolding it. Free variables named `#k`, `k\n/// >= depth`, are\n/// unused.\npub fn convertible(\n  env: kernel_dependent.Environment,\n  depth: Int,\n  a: kernel_dependent.Term,\n  b: kernel_dependent.Term,\n) -> Bool {\n  if a == b {\n    return true\n  }\n  // the same constant applied to convertible arguments, before unfolding\n  (h1, as1) := kernel_dependent.spine(a)\n  (h2, as2) := kernel_dependent.spine(b)\n  if h1 == h2\n    && len(as1) == len(as2)\n    && len(as1) > 0\n    && h1 is kernel_dependent.Constant {\n    mut same := true\n    for (i, u) in enumerate(as1) {\n      if same\n        && !kernel_dependent.convertible(\n          env,\n          depth,\n          u,\n          get(as2, i) ?? u,\n        ) {\n        same = false\n      }\n    }\n    if same {\n      return true\n    }\n  }\n  wa := kernel_dependent.whnf(env, a)\n  wb := kernel_dependent.whnf(env, b)\n  if wa == wb {\n    return true\n  }\n  x := kernel_dependent.Free(kernel_dependent.fresh(depth))\n  match (wa, wb) {\n    (kernel_dependent.Sort(i), kernel_dependent.Sort(j)) => i == j,\n    (kernel_dependent.Pi { domain: d1, body: b1, .. }, kernel_dependent.Pi { domain: d2, body: b2, .. }) => kernel_dependent.convertible(env, depth, d1, d2)\n      && kernel_dependent.convertible(\n        env,\n        depth + 1,\n        kernel_dependent.instantiate(b1, x, 0),\n        kernel_dependent.instantiate(b2, x, 0),\n      ),\n    (kernel_dependent.Lambda { domain: d1, body: b1, .. }, kernel_dependent.Lambda { domain: d2, body: b2, .. }) => kernel_dependent.convertible(env, depth, d1, d2)\n      && kernel_dependent.convertible(\n        env,\n        depth + 1,\n        kernel_dependent.instantiate(b1, x, 0),\n        kernel_dependent.instantiate(b2, x, 0),\n      ),\n    (kernel_dependent.Lambda { body, .. }, _) => kernel_dependent.convertible(\n      env,\n      depth + 1,\n      kernel_dependent.instantiate(body, x, 0),\n      kernel_dependent.Apply { function: wb, argument: x },\n    ),\n    (_, kernel_dependent.Lambda { body, .. }) => kernel_dependent.convertible(\n      env,\n      depth + 1,\n      kernel_dependent.Apply { function: wa, argument: x },\n      kernel_dependent.instantiate(body, x, 0),\n    ),\n    (kernel_dependent.Apply { .. }, kernel_dependent.Apply { .. }) => {\n      (h1, as1) := kernel_dependent.spine(wa)\n      (h2, as2) := kernel_dependent.spine(wb)\n      if len(as1) != len(as2)\n        || !kernel_dependent.convertible(env, depth, h1, h2) {\n        return false\n      }\n      for (i, u) in enumerate(as1) {\n        if !kernel_dependent.convertible(\n          env,\n          depth,\n          u,\n          get(as2, i) ?? u,\n        ) {\n          return false\n        }\n      }\n      true\n    },\n    _ => false,\n  }\n}","old_text":"/// Whether `a` and `b` are definitionally equal: the same once reduced,\n/// with η for functions. Free variables named `#k`, `k >= depth`, are\n/// unused.\npub fn convertible(\n  env: kernel_dependent.Environment,\n  depth: Int,\n  a: kernel_dependent.Term,\n  b: kernel_dependent.Term,\n) -> Bool {\n  if a == b {\n    return true\n  }\n  wa := kernel_dependent.whnf(env, a)\n  wb := kernel_dependent.whnf(env, b)\n  if wa == wb {\n    return true\n  }\n  x := kernel_dependent.Free(kernel_dependent.fresh(depth))\n  match (wa, wb) {\n    (kernel_dependent.Sort(i), kernel_dependent.Sort(j)) => i == j,\n    (kernel_dependent.Pi { domain: d1, body: b1, .. }, kernel_dependent.Pi { domain: d2, body: b2, .. }) => kernel_dependent.convertible(env, depth, d1, d2)\n      && kernel_dependent.convertible(\n        env,\n        depth + 1,\n        kernel_dependent.instantiate(b1, x, 0),\n        kernel_dependent.instantiate(b2, x, 0),\n      ),\n    (kernel_dependent.Lambda { domain: d1, body: b1, .. }, kernel_dependent.Lambda { domain: d2, body: b2, .. }) => kernel_dependent.convertible(env, depth, d1, d2)\n      && kernel_dependent.convertible(\n        env,\n        depth + 1,\n        kernel_dependent.instantiate(b1, x, 0),\n        kernel_dependent.instantiate(b2, x, 0),\n      ),\n    (kernel_dependent.Lambda { body, .. }, _) => kernel_dependent.convertible(\n      env,\n      depth + 1,\n      kernel_dependent.instantiate(body, x, 0),\n      kernel_dependent.Apply { function: wb, argument: x },\n    ),\n    (_, kernel_dependent.Lambda { body, .. }) => kernel_dependent.convertible(\n      env,\n      depth + 1,\n      kernel_dependent.Apply { function: wa, argument: x },\n      kernel_dependent.instantiate(body, x, 0),\n    ),\n    (kernel_dependent.Apply { .. }, kernel_dependent.Apply { .. }) => {\n      (h1, as1) := kernel_dependent.spine(wa)\n      (h2, as2) := kernel_dependent.spine(wb)\n      if len(as1) != len(as2)\n        || !kernel_dependent.convertible(env, depth, h1, h2) {\n        return false\n      }\n      for (i, u) in enumerate(as1) {\n        if !kernel_dependent.convertible(\n          env,\n          depth,\n          u,\n          get(as2, i) ?? u,\n        ) {\n          return false\n        }\n      }\n      true\n    },\n    _ => false,\n  }\n}"}]}
