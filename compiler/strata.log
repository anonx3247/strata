degen.mock_value","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.host","codegen.spawn_expr","codegen.method_value","codegen.foreign_call","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// `ret` the hash of `a`'s fields (types `tys`), from `seed`.\nfn hash_fields(\n  mut g: codegen.Gen,\n  a: codegen.V,\n  tys: List[check.Ty],\n  seed: String,\n) {\n  mut h := seed\n  for (k, ft) in enumerate(tys) {\n    f := codegen.hash_helper(mut g, ft)\n    x := codegen.field(mut g, a, k, ft)\n    (y, m, n) := (\n      codegen.fresh(mut g, \"h\"),\n      codegen.fresh(mut g, \"h\"),\n      codegen.fresh(mut g, \"h\"),\n    )\n    codegen.emit(\n      mut g,\n      f\"{y} = call i64 {f}({codegen.args_of([x])})\",\n    )\n    codegen.emit(mut g, f\"{m} = mul i64 {h}, 1099511628211\")\n    codegen.emit(mut g, f\"{n} = xor i64 {m}, {y}\")\n    h = n\n  }\n  codegen.emit(mut g, f\"ret i64 {h}\")\n}","old_text":"/// `ret` the hash of `a`'s fields (types `tys`), from `seed`.\nfn hash_fields(mut g: codegen.Gen, a: codegen.V, tys: List[Ty], seed: String) {\n  mut h := seed\n  for (k, ft) in enumerate(tys) {\n    f := codegen.hash_helper(mut g, ft)\n    x := codegen.field(mut g, a, k, ft)\n    (y, m, n) := (\n      codegen.fresh(mut g, \"h\"),\n      codegen.fresh(mut g, \"h\"),\n      codegen.fresh(mut g, \"h\"),\n    )\n    codegen.emit(\n      mut g,\n      f\"{y} = call i64 {f}({codegen.args_of([x])})\",\n    )\n    codegen.emit(mut g, f\"{m} = mul i64 {h}, 1099511628211\")\n    codegen.emit(mut g, f\"{n} = xor i64 {m}, {y}\")\n    h = n\n  }\n  codegen.emit(mut g, f\"ret i64 {h}\")\n}"},{"name":"codegen.table_find","kind":"fn","old":"de598229fd7f6d48","new":"4872ad2cf89f12ec","interface_changed":true,"affected":["codegen.collection_builtin","codegen.update_in_place","codegen.builtin","codegen.gen_list","codegen.converted","codegen.builtin_call","codegen.stmt_node","codegen.call_named","codegen.push_in_place","codegen.produce","codegen.list_builtin","codegen.list_literal_of","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.set_in_place","codegen.take_in_place","codegen.expr_want_node","codegen.method_call","codegen.except_expr","codegen.matching_want","codegen.stmt","codegen.expr_node","codegen.gen_fn","codegen.list_literal","codegen.construct","codegen.operands","codegen.binary","codegen.branch_value","codegen.mock_call","codegen.expr_want","codegen.matching","codegen.block_expr","codegen.iterate","codegen.decreases_start","codegen.decreases_pass","codegen.decreases_entry","codegen.decreases_call","codegen.build_fn","codegen.expr","codegen.generated","codegen.can_generate","codegen.main_arg","codegen.session_capability","codegen.for_loop","codegen.union_call","codegen.dyn_generic_call","codegen.compared","codegen.if_want","codegen.matching_v","codegen.match_got","codegen.function","codegen.declare","codegen.destructure","codegen.call_fn_want","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.try_want","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.checked_update","codegen.appended","codegen.for_list","codegen.built_or_genera