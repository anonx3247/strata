y(x, a))),\n    ast.UnitType => ast.UnitType,\n  }\n}"},{"name":"derive.children","kind":"fn","old":"0382b9d2ef646278","new":"8e08b6fc16e8e452","interface_changed":true,"affected":["derive.expr","derive.block","derive.comprehension","derive.derive","derive.field_read","derive.type_method","derive.with_known","derive.call_copy","derive.derive_fn","derive.derive_all","derive.make","derive.match_type","derive.call_fn","derive.derived_in","derive.expand_with","derive.expand_in","std_reached","expanded","check_errors_in","derive.expand","holes_command","check_summary","verified_decls","verify_file","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","eval_files","instantiated_files","with_extra","command_line","check_command","verified_with","static_graph","verify_command","build_proofs","alongside_command","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","repl_command","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","main","strata_command","verified_program","build_command","graph_command","graph_diff","run_command","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","or_solver_inputs","program_objects","package_errors","merge_file_command","merged_checks","core_rt_text","call_command","edit_command","check_files","rename_command","move_command","fix_command","edit_in_editor","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","smt_file","termination_file","diff_command","check_fn","linked","sync_command","build_core_command","computed_value","codegen.read_back","comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"fn children(mut x: derive.Expander, e: ast.Expr) -> Result[ast.Expr, String] {\n  mut done := []\n  for k in walk.kids(e) {\n    n := derive.expr(mut x, k)!\n    mut done.push((k, n))\n  }\n  fixed := x\n  Ok(walk.expr_children