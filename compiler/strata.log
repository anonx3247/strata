z_file","graph_runs","replay","or_solver_inputs","program_objects","sync_command","fix_loops","check_fn","linked"],"module":"check","text":"/// The program's methods: by type and name (`Pt.norm`, with `self` the\n/// first parameter), and every name a method of an `impl` or a trait has.\ntype Methods = {\n  of: Dict[String, check.Ty],\n  names: Set[String],\n  // a generic `impl`'s type parameters, by method (`Box.get`: `T`)\n  params: Dict[String, List[String]],\n  // a trait's methods (`Area.area`), `Self` a type parameter\n  traits: Dict[String, check.Ty],\n  // `Area for Sq`: the `impl`s of the program's traits\n  impls: Set[String],\n  // the traits whose bounds are checked: declared in the program, not\n  // derivable, implemented for no type parameter\n  checked: Set[String],\n  // each function's bounds: (type parameter, trait)\n  bounds: Dict[String, List[(String, String)]],\n  // each trait's supertraits\n  supers: Dict[String, List[String]],\n  // the types the checked file declares, without those it imports\n  local: Set[String],\n  // the traits it declares\n  own_traits: Set[String],\n  // the methods (`Line.tick`) taking `self`, and those taking `mut self`\n  self_methods: Set[String],\n  mut_self: Set[String],\n  // each function's parameters: a `mut` one's type, `TAny` for the others and\n  // for those of generic functions\n  mut_params: Dict[String, List[check.Ty]],\n  // the method names of `impl`s of no trait (a type's own methods)\n  names_other: Set[String],\n  // the types with an `impl` of a trait from outside the program (derived,\n  // or std's), whose methods the checker can't see\n  foreign: Set[String],\n  // core's code traits (`Iterator`, `FiniteIterator`, ...): their methods are\n  // any implementing type's (`map` of an iterator)\n  code_traits: Set[String],\n  // the methods of `impl`s of no trait, by type (`Q.tag`)\n  own_methods: Set[String] = Set[String] {},\n  // each trait method's parameters' names (`Shape.bigger`: `self, other`)\n  trait_params: Dict[String, List[String]] = Dict[String, List[String]] {},\n  // each `impl`'s bounds on its type's arguments (`FiniteIterator for\n  // Mapped`: argument 0 must be a `FiniteIterator`)\n  impl_bounds: Dict[String, List[(Int, String)]] = Dict[String, List[(Int, String)]] {},\n  // each trait's type parameters (`Iterator`: `T`), and each `impl`'s\n  // arguments for them, with the names its type's arguments take\n  // (`Iterator for Mapped`: `[B]`, `I, A, B`)\n  trait_tparams: Dict[String, List[String]] = Dict[String, List[String]] {},\n  impl_args: Dict[String, (List[check.Ty], List[String])] = Dict[String, (List[check.Ty], List[String])] {},\n  // each function's, method's (`Line.tick`) and trait method's\n  // (`Shape.area`) parameters, `self` included: what a spread (`f(...x)`)\n  // fills by name\n  spread_params: Dict[String, List[ast.Param]] = Dict[String, List[ast.Param]] {},\n  // the `noalloc` methods by type (`Pt.norm`), and the names whose every\n  // function and method is `noalloc` (`noalloc_methods`)\n  noallocs: Set[String] = Set[String] {},\n  // each function's structural bounds, by type parameter: the fields its\n  // type must have (`[T: { id: Int, .. }]`), lowered and as written\n  rows: Dict[String, Dict[String, List[(String, check.Ty, ast.TypeExpr)]]] = Dict[String, Dict[String, List[(String, check.Ty, ast.TypeExpr)]]] {},\n}","old_text":"/// The program's methods: by type and name (`Pt.norm`, with `self` the\n/// first parameter), and every name a method of an `impl` or a trait has.\ntype Methods = {\n  of: Dict[String, check.Ty],\n  names: Set[String],\n  // a generic `impl`'s type parameters, by method (`Box.get`: `T`)\n  params: Dict[String, List[String]],\n  // a trait's methods (`Area.area`), `Self` a type parameter\n  traits: Dict[String, check.Ty],\n  // `Area for Sq`: the `impl`s of the program's traits\n  impls: Set[String],\n  // the traits whose bounds are checked: declared in the program, not\n  // derivable, implemented for no type parameter\n  checked: Set[String],\n  // each function's bounds: (type parameter, trait)\n  bounds: Dict[String, List[(String, String)]],\n  // each trait's supertraits\n  supers: Dict[String, List[String]],\n  // the types the checked file declares, without those it imports\n  local: Set[String],\n  // the traits it declares\n  own_traits: Set[String],\n  // the methods (`Line.tick`) taking `self`, and those taking `mut self`\n  self_methods: Set[String],\n  mut_self: Set[String],\n  // each function's parameters: a `mut` one's type, `TAny` for the others and\n  // for those of generic functions\n  mut_params: Dict[String, List[check.Ty]],\n  // the method names of `impl`s of no trait (a type's own methods)\n  names_other: Set[String],\n  // the types with an `impl` of a trait from outside the program (derived,\n  // or std's), whose methods the checker can't see\n  foreign: Set[String],\n  // core's code traits (`Iterator`, `FiniteIterator`, ...): their methods are\n  // any implementing type's (`map` of an iterator)\n  code_traits: Set[String],\n  // the methods of `impl`s of no trait, by type (`Q.tag`)\n  own_methods: Set[String] = Set[String] {},\n  // each trait method's parameters' names (`Shape.bigger`: `self, other`)\n  trait_params: Dict[String, List[String]] = Dict[String, List[String]] {},\n  // each `impl`'s bounds on its type's arguments (`FiniteIterator for\n  // Mapped`: argument 0 must be a `FiniteIterator`)\n  impl_bounds: Dict[String, List[(Int, String)]] = Dict[String, List[(Int, String)]] {},\n  // each trait's type parameters (`Iterator`: `T`), and each `impl`'s\n  // arguments for them, with the names its type's arguments take\n  // (`Iterator for Mapped`: `[B]`, `I, A, B`)\n  trait_tparams: Dict[String, List[String]] = Dict[String, List[String]] {},\n  impl_args: Dict[String, (List[check.Ty], List[String])] = Dict[String, (List[check.Ty], List[String])] {},\n  // each function's, method's (`Line.tick`) and trait method's\n  // (`Shape.area`) parameters, `self` included: what a spread (`f(...x)`)\n  // fills by name\n  spread_params: Dict[String, List[ast.Param]] = Dict[String, List[ast.Param]] {},\n  // the `noalloc` methods by type (`Pt.norm`), and the names whose every\n  // function and method is `noalloc` (`noalloc_methods`)\n  noallocs: Set[String] = Set[String] {},\n}"},{"name":"check.methods_of","kind":"fn","old":"83ba06010b69ab40","new":"a37deb4ee62da903","interface_changed":false,"affected":[],"module":"check","text":"/// The program's methods: `impl`s without type parameters, on a type\n/// modelled without type parameters.\nfn methods_of(decls: List[ast.Decl], types: check.Types) -> check.Methods {\n  mut supers := Dict[String, List[String]] {}\n  mut pairs_seen := []\n  mut declared := Set[String] {}\n  mut of := Dict[String, check.Ty] {}\n  mut names := Set[String] {}\n  mut names_other := Set[String] {}\n  mut own_recv := Dict[String, Bool] {}\n  mut trait_recv := Dict[String, Bool] {}\n  mut mut_params := Dict[String, List[check.Ty]] {}\n  mut params := Dict[String, List[String]] {}\n  mut traits := Dict[String, check.Ty] {}\n  mut impls := Set[String] {}\n  mut checked := Set[String] {}\n  mut blanket := Set[String] {}\n  mut bounds := Dict[String, List[(String, String)]] {}\n  mut own_methods := Set[String] {}\n  mut impl_bounds := Dict[String, List[(Int, String)]] {}\n  mut trait_tparams := Dict[String, List[String]] {}\n  mut impl_args := Dict[String, (List[check.Ty], List[String])] {}\n  mut trait_params := Dict[String, List[String]] {}\n  mut spread_params := Dict[String, List[ast.Param]] {}\n  mut rows := Dict[String, Dict[String, List[(String, check.Ty, ast.TypeExpr)]]] {}\n  for d in decls {\n    match d.kind {\n      ast.ImplDef(im) => {\n        head := check.type_head(im.for_type)\n        // core's code's types, like `KeyPath`, are named bare everywhere: an\n        // `impl` of another module's on one is on that type\n        q := if contains(head, \".\")\n          || check.core_code_type(types, head)\n            && !contains(types.named, check.qualified(d.module, head)) {\n          head\n        } else {\n          check.qualified(d.module, head)\n        }\n        if im.trait_name != \"\" {\n          mut impls.insert(im.trait_name + \" for \" + q)\n          if im.trait_args != [] {\n            itps := set(im.type_params)\n            mut impl_args.insert(\n              im.trait_name + \" for \" + q,\n              (\n                im.trait_args.map(a -> check.lower(types, itps, a)),\n                match im.for_type {\n                  ast.Named { args: targs, .. } => targs.map(a -> check.type_head(a)),\n                  _ => [],\n                },\n              ),\n            )\n          }\n          // the bounds on the type's arguments, by their position\n          match im.for_type {\n            ast.Named { args: targs, .. } => {\n              mut bs := []\n              for (k, a) in enumerate(targs) {\n                for b in im.bounds {\n                  if check.type_head(a) == b.param {\n                    for tr in b.traits {\n                      mut bs.push((k, check.type_head(tr)))\n                    }\n                  }\n                }\n              }\n              if bs != [] {\n                mut impl_bounds.insert(im.trait_name + \" for \" + q, bs)\n              }\n            },\n            _ => (),\n          }\n          mut pairs_seen.push((im.trait_name, q))\n          // `impl[T] Tr for T`: every type\n          if im.type_params.contains(head) {\n            mut blanket.insert(im.trait_name)\n          }\n        }\n        // a generic `impl` on its type's own parameters, in order\n        own_params := match im.for_type {\n          ast.Named { args, .. } => args.map(a -> check.type_head(a)) == im.type_params,\n          _ => false,\n        }\n        usable := get(types.named, q) ?? [\"?\"] == im.type_params\n          && (len(im.type_params) == 0 || own_params)\n        for f in im.methods {\n          mut names.insert(f.name)\n          mut spread_params.insert(q + \".\" + f.name, f.params)\n          if im.trait_name == \"\" {\n            mut names_other.insert(f.name)\n            mut own_methods.insert(q + \".\" + f.name)\n          }\n          if usable {\n            g := check.method_of(f, im.for_type)\n            tps := set(im.type_params + g.type_params)\n            key := q + \".\" + f.name\n            mut of.insert(\n              key,\n              check.TFn {\n                params: g.params.map(p -> check.param_type(types, tps, p)),\n                ret: check.lower(types, tps, g.ret),\n              },\n            )\n            mut params.insert(key, im.type_params)\n            // whether it takes `mut self`; a type's own method comes before a trait's\n            // of the same name, as calls find them\n            match get(f.params, 0) {\n              Some(sp) => if sp.name == \"self\" {\n                if im.trait_name == \"\" {\n                  mut own_recv.insert(key, sp.mutable)\n                } else {\n                  mut trait_recv.insert(key, sp.mutable)\n                }\n              },\n              None => (),\n            }\n          }\n        }\n      },\n      ast.TraitDef(t) => {\n        mut declared.insert(t.name)\n        mut supers.insert(t.name, t.supers.map(x -> check.type_head(x)))\n        mut trait_tparams.insert(t.name, t.params)\n        if t.derivable is None && !t.capability && len(t.params) == 0 {\n          mut checked.insert(t.name)\n        }\n        for tm in t.methods {\n          mut names.insert(tm.decl.name)\n          tps := set([\"Self\"] + t.params + tm.decl.type_params)\n          mut trait_params.insert(\n            t.name + \".\" + tm.decl.name,\n            tm.decl.params.map(p -> p.name),\n          )\n          mut spread_params.insert(\n            t.name + \".\" + tm.decl.name,\n            tm.decl.params,\n          )\n          mut spread_params.insert(\n            check.qualified(d.module, t.name) + \".\" + tm.decl.name,\n            tm.decl.params,\n          )\n          mut traits.insert(\n            t.name + \".\" + tm.decl.name,\n            check.TFn {\n              params: tm.decl.params.map(\n                p -> check.param_type(types, tps, p),\n              ),\n              ret: check.lower(types, tps, tm.decl.ret),\n            },\n          )\n        }\n      },\n      ast.FnDef(f) => {\n        mut spread_params.insert(\n          check.qualified(d.module, f.name),\n          f.params,\n        )\n        mut bs := []\n        for b in f.bounds {\n          for tr in b.traits {\n            if !(tr is ast.RowType) {\n              mut bs.push((b.param, check.type_head(tr)))\n            }\n          }\n        }\n        fr := check.rows_by_param(types, set(f.type_params), f.bounds)\n        if len(fr) > 0 {\n          mut rows.insert(check.qualified(d.module, f.name), fr)\n        }\n        mut bounds.insert(check.qualified(d.module, f.name), bs)\n        mut mut_params.insert(\n          check.qualified(d.module, f.name),\n          f.params.map(\n            p -> if p.mutable && len(f.type_params) == 0 {\n              check.lower(types, Set[String] {}, p.ty)\n            } else {\n              check.TAny\n            },\n          ),\n        )\n      },\n      ast.ExternDef(x) => match x.item {\n        ast.ExternFn(f) => mut spread_params.insert(\n          check.qualified(d.module, f.name),\n          f.params,\n        ),\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  mut foreign := Set[String] {}\n  for tq in pairs_seen {\n    if !contains(declared, tq.0) {\n      mut foreign.insert(tq.1)\n    }\n  }\n  mut self_methods := Set[String] {}\n  mut mut_self := Set[String] {}\n  for key in keys(trait_recv) + keys(own_recv) {\n    mut self_methods.insert(key)\n    if get(own_recv, key) ?? get(trait_recv, key) ?? false {\n      mut mut_self.insert(key)\n    }\n  }\n  mut kept := Set[String] {}\n  for c in checked {\n    if !contains(blanket, c) {\n      mut kept.insert(c)\n    }\n  }\n  check.Methods {\n    of,\n    names,\n    params,\n    traits,\n    impls,\n    checked: kept,\n    bounds,\n    foreign,\n    code_traits: Set[String] {},\n    supers,\n    local: Set[String] {},\n    own_traits: Set[String] {},\n    names_other,\n    self_methods,\n    mut_self,\n    mut_params,\n    own_methods,\n    trait_params,\n    impl_bounds,\n    trait_tparams,\n    impl_args,\n    spread_params,\n    rows,\n  }\n}","old_text":"/// The program's methods: `impl`s without type parameters, on a type\n/// modelled without type parameters.\nfn methods_of(decls: List[ast.Decl], types: check.Types) -> check.Methods {\n  mut supers := Dict[String, List[String]] {}\n  mut pairs_seen := []\n  mut declared := Set[String] {}\n  mut of := Dict[String, check.Ty] {}\n  mut names := Set[String] {}\n  mut names_other := Set[String] {}\n  mut own_recv := Dict[String, Bool] {}\n  mut trait_recv := Dict[String, Bool] {}\n  mut mut_params := Dict[String, List[check.Ty]] {}\n  mut params := Dict[String, List[String]] {}\n  mut traits := Dict[String, check.Ty] {}\n  mut impls := Set[String] {}\n  mut checked := Set[String] {}\n  mut blanket := Set[String] {}\n  mut bounds := Dict[String, List[(String, String)]] {}\n  mut own_methods := Set[String] {}\n  mut impl_bounds := Dict[String, List[(Int, String)]] {}\n  mut trait_tparams := Dict[String, List[String]] {}\n  mut impl_args := Dict[String, (List[check.Ty], List[String])] {}\n  mut trait_params := Dict[String, List[String]] {}\n  mut spread_params := Dict[String, List[ast.Param]] {}\n  for d in decls {\n    match d.kind {\n      ast.ImplDef(im) => {\n        head := check.type_head(im.for_type)\n        // core's code's types, like `KeyPath`, are named bare everywhere: an\n        // `impl` of another module's on one is on that type\n        q := if contains(head, \".\")\n          || check.core_code_type(types, head)\n            && !contains(types.named, check.qualified(d.module, head)) {\n          head\n        } else {\n          check.qualified(d.module, head)\n        }\n        if im.trait_name != \"\" {\n          mut impls.insert(im.trait_name + \" for \" + q)\n          if im.trait_args != [] {\n            itps := set(im.type_params)\n            mut impl_args.insert(\n              im.trait_name + \" for \" + q,\n              (\n                im.trait_args.map(a -> check.lower(types, itps, a)),\n                match im.for_type {\n                  ast.Named { args: targs, .. } => targs.map(a -> check.type_head(a)),\n                  _ => [],\n                },\n              ),\n            )\n          }\n          // the bounds on the type's arguments, by their position\n          match im.for_type {\n            ast.Named { args: targs, .. } => {\n              mut bs := []\n              for (k, a) in enumerate(targs) {\n                for b in im.bounds {\n                  if check.type_head(a) == b.param {\n                    for tr in b.traits {\n                      mut bs.push((k, check.type_head(tr)))\n                    }\n                  }\n                }\n              }\n              if bs != [] {\n                mut impl_bounds.insert(im.trait_name + \" for \" + q, bs)\n              }\n            },\n            _ => (),\n          }\n          mut pairs_seen.push((im.trait_name, q))\n          // `impl[T] Tr for T`: every type\n          if im.type_params.contains(head) {\n            mut blanket.insert(im.trait_name)\n          }\n        }\n        // a generic `impl` on its type's own parameters, in order\n        own_params := match im.for_type {\n          ast.Named { args, .. } => args.map(a -> check.type_head(a)) == im.type_params,\n          _ => false,\n        }\n        usable := get(types.named, q) ?? [\"?\"] == im.type_params\n          && (len(im.type_params) == 0 || own_params)\n        for f in im.methods {\n          mut names.insert(f.name)\n          mut spread_params.insert(q + \".\" + f.name, f.params)\n          if im.trait_name == \"\" {\n            mut names_other.insert(f.name)\n            mut own_methods.insert(q + \".\" + f.name)\n          }\n          if usable {\n            g := check.method_of(f, im.for_type)\n            tps := set(im.type_params + g.type_params)\n            key := q + \".\" + f.name\n            mut of.insert(\n              key,\n              check.TFn {\n                params: g.params.map(p -> check.param_type(types, tps, p)),\n                ret: check.lower(types, tps, g.ret),\n              },\n            )\n            mut params.insert(key, im.type_params)\n            // whether it takes `mut self`; a type's own method comes before a trait's\n            // of the same name, as calls find them\n            match get(f.params, 0) {\n              Some(sp) => if sp.name == \"self\" {\n                if im.trait_name == \"\" {\n                  mut own_recv.insert(key, sp.mutable)\n                } else {\n                  mut trait_recv.insert(key, sp.mutable)\n                }\n              },\n              None => (),\n            }\n          }\n        }\n      },\n      ast.TraitDef(t) => {\n        mut declared.insert(t.name)\n        mut supers.insert(t.name, t.supers.map(x -> check.type_head(x)))\n        mut trait_tparams.insert(t.name, t.params)\n        if t.derivable is None && !t.capability && len(t.params) == 0 {\n          mut checked.insert(t.name)\n        }\n        for tm in t.methods {\n          mut names.insert(tm.decl.name)\n          tps := set([\"Self\"] + t.params + tm.decl.type_params)\n          mut trait_params.insert(\n            t.name + \".\" + tm.decl.name,\n            tm.decl.params.map(p -> p.name),\n          )\n          mut spread_params.insert(\n            t.name + \".\" + tm.decl.name,\n            tm.decl.params,\n          )\n          mut spread_params.insert(\n            check.qualified(d.module, t.name) + \".\" + tm.decl.name,\n            tm.decl.params,\n          )\n          mut traits.insert(\n            t.name + \".\" + tm.decl.name,\n            check.TFn {\n              params: tm.decl.params.map(\n                p -> check.param_type(types, tps, p),\n              ),\n              ret: check.lower(types, tps, tm.decl.ret),\n            },\n          )\n        }\n      },\n      ast.FnDef(f) => {\n        mut spread_params.insert(\n          check.qualified(d.module, f.name),\n          f.params,\n        )\n        mut bs := []\n        for b in f.bounds {\n          for tr in b.traits {\n            mut bs.push((b.param, check.type_head(tr)))\n          }\n        }\n        mut bounds.insert(check.qualified(d.module, f.name), bs)\n        mut mut_params.insert(\n          check.qualified(d.module, f.name),\n          f.params.map(\n            p -> if p.mutable && len(f.type_params) == 0 {\n              check.lower(types, Set[String] {}, p.ty)\n            } else {\n              check.TAny\n            },\n          ),\n        )\n      },\n      ast.ExternDef(x) => match x.item {\n        ast.ExternFn(f) => mut spread_params.insert(\n          check.qualified(d.module, f.name),\n          f.params,\n        ),\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  mut foreign := Set[String] {}\n  for tq in pairs_seen {\n    if !contains(declared, tq.0) {\n      mut foreign.insert(tq.1)\n    }\n  }\n  mut self_methods := Set[String] {}\n  mut mut_self := Set[String] {}\n  for key in keys(trait_recv) + keys(own_recv) {\n    mut self_methods.insert(key)\n    if get(own_recv, key) ?? get(trait_recv, key) ?? false {\n      mut mut_self.insert(key)\n    }\n  }\n  mut kept := Set[String] {}\n  for c in checked {\n    if !contains(blanket, c) {\n      mut kept.insert(c)\n    }\n  }\n  check.Methods {\n    of,\n    names,\n    params,\n    traits,\n    impls,\n    checked: kept,\n    bounds,\n    foreign,\n    code_traits: Set[String] {},\n    supers,\n    local: Set[String] {},\n    own_traits: Set[String] {},\n    names_other,\n    self_methods,\n    mut_self,\n    mut_params,\n    own_methods,\n    trait_params,\n    impl_bounds,\n    trait_tparams,\n    impl_args,\n    spread_params,\n  }\n}"},{"name":"check.bounds_by_param","kind":"fn","old":"1dac825b30f28cb6","new":"a7755e7280844d91","interface_changed":false,"affected":[],"module":"check","text":"fn bounds_by_param(bs: List[ast.Bound]) -> Dict[String, List[String]] {\n  mut out := Dict[String, List[String]] {}\n  for b in bs {\n    for tr in b.traits {\n      if !(tr is ast.RowType) {\n        mut out.insert(\n          b.param,\n          (get(out, b.param) ?? []) + [check.type_head(tr)],\n        )\n      }\n    }\n  }\n  out\n}","old_text":"fn bounds_by_param(bs: List[ast.Bound]) -> Dict[String, List[String]] {\n  mut out := Dict[String, List[String]] {}\n  for b in bs {\n    for tr in b.traits {\n      mut out.insert(\n        b.param,\n        (get(out, b.param) ?? []) + [check.type_head(tr)],\n      )\n    }\n  }\n  out\n}"},{"name":"check.fn_inferred","kind":"fn","old":"84846cdaf6b031a0","new":"b2ef2cfd716ac89c","interface_changed":false,"affected":[],"module":"check","text":"/// The inference's state after checking `f`'s body.\nfn fn_inferred(\n  f: ast.FnDecl,\n  tps: Set[String],\n  types: check.Types,\n  fns: Dict[String, check.Ty],\n  methods: check.Methods,\n  builtins: Dict[String, List[check.Builtin]],\n) -> check.Inf {\n  // a test's body has no function to return from (`outside_fn`)\n  ret := match f.ret {\n    ast.Named { name: \"$outside\", .. } => check.TNamed { name: \"$outside\", args: [] },\n    _ => check.lower(types, tps, f.ret),\n  }\n  mut i := check.Inf {\n    subst: Dict[Int, check.Ty] {},\n    next: 0,\n    errs: [],\n    fns,\n    ret,\n    types,\n    tparams: tps,\n    tbounds: check.bounds_by_param(f.bounds),\n    trows: check.rows_by_param(types, tps, f.bounds),\n    methods,\n    narrowed: check.narrowed_in(f.body, Set[String] {}),\n    exempt: Set[String] {},\n    outside: None,\n    captured: Set[String] {},\n    builtins,\n    lets: [],\n    lambdas: Dict[String, check.Ty] {},\n    pending: [],\n    insts: Dict[String, check.Ty] {},\n    arith: [],\n  }\n  mut env := Dict[String, check.Ty] {}\n  for p in f.params {\n    match p.ty {\n      ast.Named { args: [], .. } | ast.Named { name: \"NonEmpty\", .. } | ast.Refined { .. } => mut i.written.insert(p.name, p.ty),\n      _ => (),\n    }\n    // a `comptime` parameter is worked on while compiling (`f.default_value`\n    // is the field's default, written out by `derive`): not modelled\n    mut env.insert(\n      p.name,\n      if p.compile_time {\n        check.TAny\n      } else {\n        check.lower(types, tps, p.ty)\n      },\n    )\n  }\n  bt := check.infer(mut i, f.body, env, if check.outside_fn(ret) {\n    None\n  } else {\n    Some(ret)\n  })\n  if !check.outside_fn(ret) {\n    check.expect(mut i, ret, bt, \"function body\")\n  }\n  check.solve_pending(mut i)\n  // an unused value is reported once the body has no other error: an\n  // expression that doesn't check is no value to keep\n  if i.errs == [] {\n    check.unused_values(mut i)\n  }\n  i\n}","old_text":"/// The inference's state after checking `f`'s body.\nfn fn_inferred(\n  f: ast.FnDecl,\n  tps: Set[String],\n  types: check.Types,\n  fns: Dict[String, check.Ty],\n  methods: check.Methods,\n  builtins: Dict[String, List[check.Builtin]],\n) -> check.Inf {\n  // a test's body has no function to return from (`outside_fn`)\n  ret := match f.ret {\n    ast.Named { name: \"$outside\", .. } => check.TNamed { name: \"$outside\", args: [] },\n    _ => check.lower(types, tps, f.ret),\n  }\n  mut i := check.Inf {\n    subst: Dict[Int, check.Ty] {},\n    next: 0,\n    errs: [],\n    fns,\n    ret,\n    types,\n    tparams: tps,\n    tbounds: check.bounds_by_param(f.bounds),\n    methods,\n    narrowed: check.narrowed_in(f.body, Set[String] {}),\n    exempt: Set[String] {},\n    outside: None,\n    captured: Set[String] {},\n    builtins,\n    lets: [],\n    lambdas: Dict[String, check.Ty] {},\n    pending: [],\n    insts: Dict[String, check.Ty] {},\n    arith: [],\n  }\n  mut env := Dict[String, check.Ty] {}\n  for p in f.params {\n    match p.ty {\n      ast.Named { args: [], .. } | ast.Named { name: \"NonEmpty\", .. } | ast.Refined { .. } => mut i.written.insert(p.name, p.ty),\n      _ => (),\n    }\n    // a `comptime` parameter is worked on while compiling (`f.default_value`\n    // is the field's default, written out by `derive`): not modelled\n    mut env.insert(\n      p.name,\n      if p.compile_time {\n        check.TAny\n      } else {\n        check.lower(types, tps, p.ty)\n      },\n    )\n  }\n  bt := check.infer(mut i, f.body, env, if check.outside_fn(ret) {\n    None\n  } else {\n    Some(ret)\n  })\n  if !check.outside_fn(ret) {\n    check.expect(mut i, ret, bt, \"function body\")\n  }\n  check.solve_pending(mut i)\n  // an unused value is reported once the body has no other error: an\n  // expression that doesn't check is no value to keep\n  if i.errs == [] {\n    check.unused_values(mut i)\n  }\n  i\n}"},{"name":"check.infer_untagged","kind":"fn","old":"d436cae315d6f48c","new":"fc11ed742fa60811","interface_changed":false,"affected":[],"module":"check","text":"/// The type of `e`, where `expected` is the type its place asks for. The\n/// mismatches found go to `i.errs`, in the order found.\nfn infer_untagged(\n  mut i: check.Inf,\n  e: ast.Expr,\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  match e {\n    ast.IntLit(_) => check.int_literal(mut i, e, expected),\n    ast.BigIntLit(_) => check.int_literal(mut i, e, expected),\n    ast.FloatLit(_) => check.TFloat,\n    ast.StrLit(_) => check.TStr,\n    ast.BoolLit(_) => check.TBool,\n    ast.UnitExpr => check.TUnit,\n    // `env` holds declared types; a narrowed variable reads as a place\n    ast.Var(x) => match get(env, x) {\n      Some(t) => {\n        // a closure or `spawn` can't hold a handle from outside it\n        if contains(i.captured, x) && check.holds_task(check.res(i, t)) {\n          check.error(mut i, \"a closure or `spawn` can't hold `\"\n            + x\n            + \"`, a task's handle: await it where it was spawned\")\n        }\n        check.var_type(i, x, t)\n      },\n      None => match get(i.fns, x) {\n        // a function's type parameters: fresh at each use\n        Some(t) => check.inst(t, check.fresh_for(\n          mut i,\n          to_list(check.gens(t, Set[String] {})),\n        )),\n        None => check.trait_fn(mut i, x),\n      },\n    },\n    ast.Interp(parts) => {\n      for p in parts {\n        match p {\n          ast.ValuePart { value, spec } => {\n            t := check.listed_arg(\n              mut i,\n              \"$interp\",\n              0,\n              value,\n              check.TList(check.TAny),\n              check.infer(mut i, value, env, None),\n              \"interpolation\",\n            )\n            match spec {\n              Some(f) => check.check_spec(mut i, f, t),\n              None => (),\n            }\n          },\n          ast.TextPart(_) => (),\n        }\n      }\n      check.TStr\n    },\n    ast.Binary { op, left, right } => check.binary(mut i, op, left, right, env, expected),\n    // a negative literal of a sized type (`-2^63`, beyond 64 bits once negated)\n    ast.Unary { op, operand } => if op == ast.Neg\n      && check.is_int_lit(operand)\n      && check.sized_expected(i, expected) is Some {\n      _ := check.infer(mut i, operand, env, None)\n      check.int_literal(mut i, e, expected)\n    } else {\n      t := check.infer(mut i, operand, env, None)\n      if op == ast.Neg && !check.is_int_lit(operand) {\n        mut i.arith.push((\"-\", t))\n      }\n      match op {\n        ast.Neg => {\n          match check.res(i, t) {\n            check.TInt | check.TFloat | check.TAny => (),\n            check.TNamed { name, args } => if !(len(args) == 0 && check.is_sized(name)) {\n              check.error(\n                mut i,\n                \"operand of `-` must be Int or Float, found `\"\n                  + (check.shown(check.res(i, t)) ?? name)\n                  + \"`\",\n              )\n            },\n            check.TVar(_) => check.expect(mut i, check.TInt, t, \"operand of `-`\"),\n            other => match check.shown(other) {\n              Some(s) => check.error(\n                mut i,\n                \"operand of `-` must be Int or Float, found `\"\n                  + s\n                  + \"`\",\n              ),\n              None => (),\n            },\n          }\n          t\n        },\n        ast.Not => {\n          check.expect(mut i, check.TBool, t, \"operand of `!`\")\n          check.TBool\n        },\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => check.infer_if(mut i, cond, then, otherwise, env, expected),\n    ast.Block { stmts, last } => check.infer_block(mut i, stmts, last, env, expected),\n    ast.Call { callee, args } => check.infer_call(mut i, callee, args, env),\n    ast.ListExpr(es) => check.infer_list(mut i, es, env, expected),\n    ast.MatchExpr { scrutinee, binding, arms } => check.infer_match(\n      mut i,\n      scrutinee,\n      binding,\n      arms,\n      env,\n      expected,\n    ),\n    ast.Lambda { params, body } => check.infer_lambda(mut i, params, body, env, expected),\n    ast.Return(x) => {\n      r := i.ret\n      if check.outside_fn(check.res(i, r)) {\n        check.error(mut i, \"`return` outside a function\")\n        _ := check.infer(mut i, x, env, None)\n      } else {\n        t := check.infer(mut i, x, env, Some(r))\n        check.expect(mut i, r, t, \"`return` value\")\n      }\n      check.TAny\n    },\n    ast.IsExpr { value, .. } => {\n      _ := check.infer(mut i, value, env, None)\n      check.TBool\n    },\n    ast.TupleExpr(es) => {\n      // each element with the expected tuple's element as its hint\n      hints := match expected {\n        Some(e) => match check.res(i, e) {\n          check.TNamed { name, args } => if name == \"Tuple\" && len(args) == len(es) {\n            args\n          } else {\n            []\n          },\n          _ => [],\n        },\n        None => [],\n      }\n      mut ts := []\n      for (k, x) in enumerate(es) {\n        mut ts.push(check.infer(mut i, x, env, get(hints, k)))\n      }\n      check.TNamed { name: \"Tuple\", args: ts }\n    },\n    ast.CtorExpr { name, args } => match get(i.types.ctors, name) {\n      Some(sh) => check.infer_ctor(mut i, name, sh, args, env, expected),\n      None => {\n        match args {\n          ast.PositionalArgs(es) => check.infer_all(mut i, es, env),\n          ast.RecordArgs(fs) => check.infer_all(mut i, fs.map(f -> f.1), env),\n          ast.UpdateArgs { base, fields } => check.infer_all(mut i, [base] + fields.map(f -> f.1), env),\n          ast.NoArgs => (),\n        }\n        check.TAny\n      },\n    },\n    ast.MethodCall { recv, name, args } => check.infer_method(mut i, recv, name, args, env, false),\n    ast.FieldOf { base, name: tagged } => {\n      // a tagged read, `sku#0.1`: its receiver's type is kept for `rename`\n      (name, tag) := match check.untag(tagged) {\n        Some(nk) => nk,\n        None => (tagged, \"\"),\n      }\n      bt := check.infer(mut i, base, env, None)\n      if tag != \"\" {\n        mut i.insts.insert(tag + \":field\", bt)\n      }\n      match check.res(i, bt) {\n        // a field of a value that has none\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => {\n          match check.shown(check.res(i, bt)) {\n            Some(x) => check.error(\n              mut i,\n              \"cannot access field `\" + name + \"` on `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          check.TAny\n        },\n        // `p.1`: a tuple's element\n        check.TNamed { name: \"Tuple\", args: targs } => match parse_int(name) {\n          Some(k) => match get(targs, k) {\n            Some(t) => check.place(i, t),\n            None => {\n              match check.shown(check.res(i, bt)) {\n                Some(x) => check.error(\n                  mut i,\n                  \"tuple `\" + x + \"` has no element \" + name,\n                ),\n                None => (),\n              }\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a field of the one variant a variable is narrowed to\n        check.TVariants { names: [v], .. } => match get(i.types.ctors, v) {\n          Some(sh) => match check.field_of(sh, name) {\n            Some(ft) => check.place(i, ft),\n            None => {\n              check.error(\n                mut i,\n                \"variant `\" + v + \"` has no field `\" + name + \"`\",\n              )\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a field every member of a union has, with the same type\n        check.TUnion(ms) => {\n          mut out: Option[check.Ty] = None\n          for m in ms {\n            ft := match m {\n              check.TNamed { name: mn, .. } => match get(i.types.ctors, mn) {\n                Some(sh) => check.field_of(sh, name),\n                None => None,\n              },\n              _ => None,\n            }\n            match ft {\n              Some(x) => {\n                out = Some(x)\n              },\n              None => {\n                mt := check.shown(m) ?? \"?\"\n                ut := check.shown(check.res(i, bt)) ?? \"?\"\n                check.error(\n                  mut i,\n                  f\"`{mt}` has no field `{name}`, so not every `{ut}` does (match on it first)\",\n                )\n                return check.TAny\n              },\n            }\n          }\n          match out {\n            Some(x) => check.place(i, x),\n            None => check.TAny,\n          }\n        },\n        // a type parameter's field, by its structural bound\n        check.TGen(p) => match get(i.trows, p) {\n          Some(fs) => match fs.filter(x -> x.0 == name) {\n            [x, ..] => check.place(i, x.1),\n            _ => {\n              check.error(\n                mut i,\n                f\"`{check.row_text(fs)}` has no field `{name}` (a value of a structural type has only the fields it names)\",\n              )\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        check.TNamed { name: n, args: targs } => match get(i.types.ctors, n) {\n          // a record type; a sum's name is not a constructor\n          Some(sh) => match check.field_of(sh, name) {\n            Some(ft) => {\n              mut m := Dict[String, check.Ty] {}\n              for (k, p) in enumerate(sh.params) {\n                mut m.insert(p, get(targs, k) ?? check.TAny)\n              }\n              check.place(i, check.inst(ft, m))\n            },\n            None => {\n              check.error(mut i, \"type `\"\n                + n\n                + \"` has no field `\"\n                + name\n                + \"` (match on variants to access their fields)\")\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        _ => check.TAny,\n      }\n    },\n    // `mut q.claim(2)`: a call that changes its receiver\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => match check.untag(name) {\n      // a tagged call: its receiver's type is kept, as `infer` keeps it. A call\n      // spreading records, tagged by `spread_bound`, is written out.\n      Some(nk) => if starts_with(nk.1, \"s\") {\n        check.infer_spread(mut i, e, nk.1, env, expected)\n      } else {\n        rt := check.infer(mut i, recv, env, None)\n        mut i.insts.insert(nk.1 + \":recv\", rt)\n        t := check.infer_method(mut i, recv, nk.0, args, env, true)\n        mut i.insts.insert(nk.1, t)\n        t\n      },\n      None => check.infer_method(mut i, recv, name, args, env, true),\n    },\n    ast.MutExpr(x) => check.infer(mut i, x, env, expected),\n    // `r!`, `o?`: the value a `Result` or an `Option` holds\n    ast.Try { value, kind } => {\n      vt := check.infer(mut i, value, env, None)\n      want := if kind == ast.TryResult {\n        \"Result\"\n      } else {\n        \"Option\"\n      }\n      match check.res(i, vt) {\n        check.TNamed { name, args } => if name == want {\n          check.early_error(mut i, kind, if kind == ast.TryResult {\n            get(args, 1) ?? check.TAny\n          } else {\n            check.TAny\n          })\n          get(args, 0) ?? check.TAny\n        } else {\n          check.wrong_try(mut i, kind, check.res(i, vt))\n        },\n        check.TAny | check.TVar(_) => check.TAny,\n        other => check.wrong_try(mut i, kind, other),\n      }\n    },\n    // `r except e { fallback }`: the value, or the fallback (of the same\n    // type) with `e` the error\n    ast.Except { value, err, fallback } => {\n      vt := check.infer(mut i, value, env, None)\n      (ok, bad) := match check.res(i, vt) {\n        check.TNamed { name, args } => if name == \"Result\" && len(args) == 2 {\n          (get(args, 0) ?? check.TAny, get(args, 1) ?? check.TAny)\n        } else if name == \"Option\" {\n          check.error(\n            mut i,\n            \"`except` / `!!` handle a Result; an Option is handled with `or { … }` / `??`\",\n          )\n          (check.fresh(mut i), check.TAny)\n        } else {\n          check.not_result(mut i, check.res(i, vt))\n        },\n        check.TAny | check.TVar(_) => (check.TAny, check.TAny),\n        other => check.not_result(mut i, other),\n      }\n      inner := match err {\n        Some(n) => {\n          mut copy := env\n          mut copy.insert(n, bad)\n          copy\n        },\n        None => env,\n      }\n      ft := check.infer(mut i, fallback, inner, Some(ok))\n      check.expect(mut i, ok, ft, \"`except` fallback\")\n      ok\n    },\n    ast.Fallback { value, fallback } => {\n      vt := check.infer(mut i, value, env, None)\n      inner := match check.res(i, vt) {\n        check.TNamed { name, args } => if name == \"Option\" && len(args) == 1 {\n          get(args, 0) ?? check.TAny\n        } else if name == \"Result\" && len(args) == 2 {\n          check.error(\n            mut i,\n            \"`or` / `??` handle an Option; a Result is handled with `except { … }` / `!!`\",\n          )\n          get(args, 0) ?? check.TAny\n        } else {\n          match check.shown(check.res(i, vt)) {\n            Some(x) => check.error(\n              mut i,\n              \"`or` / `??` handle an Option, found `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          check.fresh(mut i)\n        },\n        check.TAny => check.TAny,\n        other => {\n          match check.shown(other) {\n            Some(x) => check.error(\n              mut i,\n              \"`or` / `??` handle an Option, found `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          // the fallback's type, so checking goes on\n          check.fresh(mut i)\n        },\n      }\n      ft := check.infer(mut i, fallback, env, Some(inner))\n      check.expect(mut i, inner, ft, \"`or` fallback\")\n      inner\n    },\n    ast.Index { base, index } => {\n      bt := check.infer(mut i, base, env, None)\n      match index {\n        // `xs[a..b]`: a slice, of the same type\n        ast.Range { lo, hi, .. } => {\n          for x in [lo, hi] {\n            match x {\n              Some(v) => check.infer(mut i, v, env, Some(check.TInt)),\n              None => check.TAny,\n            }\n          }\n          match check.res(i, bt) {\n            check.TList(_) => bt,\n            _ => check.TAny,\n          }\n        },\n        // `xs[k]`: the built-in `at(xs, k)`\n        _ => match check.res(i, bt) {\n          check.TList(_) => match get(i.builtins, \"at\") {\n            Some(bs) => check.builtin_call(mut i, \"at\", bs, [bt], [index], env),\n            None => {\n              _ := check.infer(mut i, index, env, None)\n              check.TAny\n            },\n          },\n          _ => {\n            _ := check.infer(mut i, index, env, None)\n            check.TAny\n          },\n        },\n      }\n    },\n    // `a..b`: the list of the integers from `a`\n    ast.Range { lo, hi, .. } => {\n      for x in [lo, hi] {\n        match x {\n          Some(v) => check.infer(mut i, v, env, Some(check.TInt)),\n          None => check.TAny,\n        }\n      }\n      check.TList(check.TInt)\n    },\n    ast.Comp { kind, elem, fors } => {\n      mut seen := env\n      // over an iterator, one of the program's types or core's, a comprehension\n      // is lazy: an iterator instead of a list\n      mut lazy := false\n      for f in fors {\n        it := check.infer(mut i, f.iter, seen, None)\n        match check.res(i, it) {\n          check.TNamed { name, .. } => if contains(i.methods.impls, \"Iterator for \" + name)\n            || contains(i.methods.impls, \"FiniteIterator for \" + name) {\n            lazy = true\n          },\n          _ => (),\n        }\n        seen = check.bind_typed(\n          mut i,\n          seen,\n          f.pat,\n          check.element_of(i, it),\n        )\n        match f.cond {\n          Some(c) => check.infer(mut i, c, seen, None),\n          None => (),\n        }\n      }\n      et := check.infer(mut i, elem, seen, None)\n      // a list comprehension is a list of its element's type\n      if kind == ast.ListComp && !lazy {\n        check.TList(et)\n      } else {\n        check.TAny\n      }\n    },\n    ast.DictExpr { entries, .. } => {\n      for kv in entries {\n        check.infer_all(mut i, [kv.0, kv.1], env)\n      }\n      check.TAny\n    },\n    ast.SetExpr { elems, .. } => {\n      check.infer_all(mut i, elems, env)\n      check.TAny\n    },\n    ast.Comptime(x) => {\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    // `old e`: `e`'s value where the function started, of `e`'s type\n    ast.Old(x) => check.infer(mut i, x, env, expected),\n    // `...x` where `spread_bound` found no call by name to fill\n    ast.Spread(x) => {\n      check.spread_error(\n        mut i,\n        \"`...\"\n          + text.expr_text(x, 0)\n          + \"`: a spread gives a record's fields to the parameters of a function or method called by name; it can't be used here\",\n      )\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    ast.Assumed(x) => check.infer(mut i, x, env, expected),\n    // a `scope`'s result can't hold one of its tasks' handles\n    ast.Scope(x) => {\n      held := i.outside\n      i.outside = Some(set(keys(env)))\n      // `scope { …; spawn e }`: the last task's handle isn't its value\n      t := if check.ends_in_spawn(x) {\n        _ := check.infer(mut i, x, env, None)\n        check.TUnit\n      } else {\n        check.infer(mut i, x, env, expected)\n      }\n      i.outside = held\n      if check.holds_task(check.res(i, t)) {\n        match check.shown(check.res(i, t)) {\n          Some(s) => check.error(\n            mut i,\n            \"a task's handle can't leave its `scope` (its result is `\"\n              + s\n              + \"`): await it inside\",\n          ),\n          None => (),\n        }\n      }\n      t\n    },\n    // `spawn e`: a handle to `e`'s value\n    ast.Spawn(x) => {\n      outer := i.ret\n      i.ret = check.TAny\n      held := i.captured\n      i.captured = set(keys(env))\n      t := check.infer(mut i, x, env, None)\n      i.captured = held\n      i.ret = outer\n      // a sender is captured on its own, never inside another value\n      for v in keys(env).sorted() {\n        vt := check.res(i, get(env, v) ?? check.TAny)\n        if !(vt is check.TNamed && check.type_name(vt) == \"Sender\")\n          && check.holds_sender(i, vt, 8)\n          && check.uses(x, v)\n          && !check.rebinds(x, v) {\n          check.error(\n            mut i,\n            \"a task (a `spawn`, a `race` arm) can capture a sender only on its own (a variable holding it): `\"\n              + v\n              + \"` holds one inside\",\n          )\n        }\n      }\n      check.TNamed { name: \"Task\", args: [t] }\n    },\n    // `select`: each arm's operation (`rx.recv()` an `Option`, `tx.send(v)`,\n    // `await h`, `clock.after(d)` with `clock` a clock and `d` a `Duration`),\n    // its name, and its body with the type wanted\n    ast.Select(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.MethodCall { recv, name, args } => if name == \"after\" && len(args) == 1 {\n            ct := check.res(i, check.infer(mut i, recv, env, None))\n            match ct {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(ct) {\n                Some(x) => check.error(\n                  mut i,\n                  \"an `after` arm waits on a clock: `\"\n                    + x\n                    + \"` doesn't implement `Clock` (std.time)\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            dt := check.res(i, check.infer(\n              mut i,\n              get(args, 0) ?? ast.UnitExpr,\n              env,\n              None,\n            ))\n            match dt {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(dt) {\n                Some(x) => check.error(\n                  mut i,\n                  \"the time an `after` arm waits: expected `std.time.Duration`, found `\"\n                    + x\n                    + \"`\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            check.TUnit\n          } else {\n            check.infer(mut i, a.op, env, None)\n          },\n          _ => check.infer(mut i, a.op, env, None),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `race`: each left side is a task's body (a supervised one's result is a\n    // `Result[T, Panic]`), then its name and its body\n    ast.Race(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.SupervisedSpawn(x) => check.TNamed { name: \"Result\", args: [\n            check.task_body(mut i, x, env),\n            check.TNamed { name: \"Panic\", args: [] },\n          ] },\n          op => check.task_body(mut i, op, env),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `supervised spawn e`: a handle to `e`'s value, or its panic\n    ast.SupervisedSpawn(x) => check.TNamed {\n      name: \"Task\",\n      args: [check.TNamed { name: \"Result\", args: [\n        check.task_body(mut i, x, env),\n        check.TNamed { name: \"Panic\", args: [] },\n      ] }],\n    },\n    // `await h`: the task's value, or each task's for a tuple or list of handles\n    ast.Await(x) => {\n      t := check.infer(mut i, x, env, None)\n      check.awaited(mut i, check.res(i, t))\n    },\n    ast.Hole(h) => {\n      t := expected ?? check.fresh(mut i)\n      mut i.holes.push((h, t, env))\n      t\n    },\n    _ => check.TAny,\n  }\n}","old_text":"/// The type of `e`, where `expected` is the type its place asks for. The\n/// mismatches found go to `i.errs`, in the order found.\nfn infer_untagged(\n  mut i: check.Inf,\n  e: ast.Expr,\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  match e {\n    ast.IntLit(_) => check.int_literal(mut i, e, expected),\n    ast.BigIntLit(_) => check.int_literal(mut i, e, expected),\n    ast.FloatLit(_) => check.TFloat,\n    ast.StrLit(_) => check.TStr,\n    ast.BoolLit(_) => check.TBool,\n    ast.UnitExpr => check.TUnit,\n    // `env` holds declared types; a narrowed variable reads as a place\n    ast.Var(x) => match get(env, x) {\n      Some(t) => {\n        // a closure or `spawn` can't hold a handle from outside it\n        if contains(i.captured, x) && check.holds_task(check.res(i, t)) {\n          check.error(mut i, \"a closure or `spawn` can't hold `\"\n            + x\n            + \"`, a task's handle: await it where it was spawned\")\n        }\n        check.var_type(i, x, t)\n      },\n      None => match get(i.fns, x) {\n        // a function's type parameters: fresh at each use\n        Some(t) => check.inst(t, check.fresh_for(\n          mut i,\n          to_list(check.gens(t, Set[String] {})),\n        )),\n        None => check.trait_fn(mut i, x),\n      },\n    },\n    ast.Interp(parts) => {\n      for p in parts {\n        match p {\n          ast.ValuePart { value, spec } => {\n            t := check.listed_arg(\n              mut i,\n              \"$interp\",\n              0,\n              value,\n              check.TList(check.TAny),\n              check.infer(mut i, value, env, None),\n              \"interpolation\",\n            )\n            match spec {\n              Some(f) => check.check_spec(mut i, f, t),\n              None => (),\n            }\n          },\n          ast.TextPart(_) => (),\n        }\n      }\n      check.TStr\n    },\n    ast.Binary { op, left, right } => check.binary(mut i, op, left, right, env, expected),\n    // a negative literal of a sized type (`-2^63`, beyond 64 bits once negated)\n    ast.Unary { op, operand } => if op == ast.Neg\n      && check.is_int_lit(operand)\n      && check.sized_expected(i, expected) is Some {\n      _ := check.infer(mut i, operand, env, None)\n      check.int_literal(mut i, e, expected)\n    } else {\n      t := check.infer(mut i, operand, env, None)\n      if op == ast.Neg && !check.is_int_lit(operand) {\n        mut i.arith.push((\"-\", t))\n      }\n      match op {\n        ast.Neg => {\n          match check.res(i, t) {\n            check.TInt | check.TFloat | check.TAny => (),\n            check.TNamed { name, args } => if !(len(args) == 0 && check.is_sized(name)) {\n              check.error(\n                mut i,\n                \"operand of `-` must be Int or Float, found `\"\n                  + (check.shown(check.res(i, t)) ?? name)\n                  + \"`\",\n              )\n            },\n            check.TVar(_) => check.expect(mut i, check.TInt, t, \"operand of `-`\"),\n            other => match check.shown(other) {\n              Some(s) => check.error(\n                mut i,\n                \"operand of `-` must be Int or Float, found `\"\n                  + s\n                  + \"`\",\n              ),\n              None => (),\n            },\n          }\n          t\n        },\n        ast.Not => {\n          check.expect(mut i, check.TBool, t, \"operand of `!`\")\n          check.TBool\n        },\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => check.infer_if(mut i, cond, then, otherwise, env, expected),\n    ast.Block { stmts, last } => check.infer_block(mut i, stmts, last, env, expected),\n    ast.Call { callee, args } => check.infer_call(mut i, callee, args, env),\n    ast.ListExpr(es) => check.infer_list(mut i, es, env, expected),\n    ast.MatchExpr { scrutinee, binding, arms } => check.infer_match(\n      mut i,\n      scrutinee,\n      binding,\n      arms,\n      env,\n      expected,\n    ),\n    ast.Lambda { params, body } => check.infer_lambda(mut i, params, body, env, expected),\n    ast.Return(x) => {\n      r := i.ret\n      if check.outside_fn(check.res(i, r)) {\n        check.error(mut i, \"`return` outside a function\")\n        _ := check.infer(mut i, x, env, None)\n      } else {\n        t := check.infer(mut i, x, env, Some(r))\n        check.expect(mut i, r, t, \"`return` value\")\n      }\n      check.TAny\n    },\n    ast.IsExpr { value, .. } => {\n      _ := check.infer(mut i, value, env, None)\n      check.TBool\n    },\n    ast.TupleExpr(es) => {\n      // each element with the expected tuple's element as its hint\n      hints := match expected {\n        Some(e) => match check.res(i, e) {\n          check.TNamed { name, args } => if name == \"Tuple\" && len(args) == len(es) {\n            args\n          } else {\n            []\n          },\n          _ => [],\n        },\n        None => [],\n      }\n      mut ts := []\n      for (k, x) in enumerate(es) {\n        mut ts.push(check.infer(mut i, x, env, get(hints, k)))\n      }\n      check.TNamed { name: \"Tuple\", args: ts }\n    },\n    ast.CtorExpr { name, args } => match get(i.types.ctors, name) {\n      Some(sh) => check.infer_ctor(mut i, name, sh, args, env, expected),\n      None => {\n        match args {\n          ast.PositionalArgs(es) => check.infer_all(mut i, es, env),\n          ast.RecordArgs(fs) => check.infer_all(mut i, fs.map(f -> f.1), env),\n          ast.UpdateArgs { base, fields } => check.infer_all(mut i, [base] + fields.map(f -> f.1), env),\n          ast.NoArgs => (),\n        }\n        check.TAny\n      },\n    },\n    ast.MethodCall { recv, name, args } => check.infer_method(mut i, recv, name, args, env, false),\n    ast.FieldOf { base, name: tagged } => {\n      // a tagged read, `sku#0.1`: its receiver's type is kept for `rename`\n      (name, tag) := match check.untag(tagged) {\n        Some(nk) => nk,\n        None => (tagged, \"\"),\n      }\n      bt := check.infer(mut i, base, env, None)\n      if tag != \"\" {\n        mut i.insts.insert(tag + \":field\", bt)\n      }\n      match check.res(i, bt) {\n        // a field of a value that has none\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => {\n          match check.shown(check.res(i, bt)) {\n            Some(x) => check.error(\n              mut i,\n              \"cannot access field `\" + name + \"` on `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          check.TAny\n        },\n        // `p.1`: a tuple's element\n        check.TNamed { name: \"Tuple\", args: targs } => match parse_int(name) {\n          Some(k) => match get(targs, k) {\n            Some(t) => check.place(i, t),\n            None => {\n              match check.shown(check.res(i, bt)) {\n                Some(x) => check.error(\n                  mut i,\n                  \"tuple `\" + x + \"` has no element \" + name,\n                ),\n                None => (),\n              }\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a field of the one variant a variable is narrowed to\n        check.TVariants { names: [v], .. } => match get(i.types.ctors, v) {\n          Some(sh) => match check.field_of(sh, name) {\n            Some(ft) => check.place(i, ft),\n            None => {\n              check.error(\n                mut i,\n                \"variant `\" + v + \"` has no field `\" + name + \"`\",\n              )\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a field every member of a union has, with the same type\n        check.TUnion(ms) => {\n          mut out: Option[check.Ty] = None\n          for m in ms {\n            ft := match m {\n              check.TNamed { name: mn, .. } => match get(i.types.ctors, mn) {\n                Some(sh) => check.field_of(sh, name),\n                None => None,\n              },\n              _ => None,\n            }\n            match ft {\n              Some(x) => {\n                out = Some(x)\n              },\n              None => {\n                mt := check.shown(m) ?? \"?\"\n                ut := check.shown(check.res(i, bt)) ?? \"?\"\n                check.error(\n                  mut i,\n                  f\"`{mt}` has no field `{name}`, so not every `{ut}` does (match on it first)\",\n                )\n                return check.TAny\n              },\n            }\n          }\n          match out {\n            Some(x) => check.place(i, x),\n            None => check.TAny,\n          }\n        },\n        check.TNamed { name: n, args: targs } => match get(i.types.ctors, n) {\n          // a record type; a sum's name is not a constructor\n          Some(sh) => match check.field_of(sh, name) {\n            Some(ft) => {\n              mut m := Dict[String, check.Ty] {}\n              for (k, p) in enumerate(sh.params) {\n                mut m.insert(p, get(targs, k) ?? check.TAny)\n              }\n              check.place(i, check.inst(ft, m))\n            },\n            None => {\n              check.error(mut i, \"type `\"\n                + n\n                + \"` has no field `\"\n                + name\n                + \"` (match on variants to access their fields)\")\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        _ => check.TAny,\n      }\n    },\n    // `mut q.claim(2)`: a call that changes its receiver\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => match check.untag(name) {\n      // a tagged call: its receiver's type is kept, as `infer` keeps it. A call\n      // spreading records, tagged by `spread_bound`, is written out.\n      Some(nk) => if starts_with(nk.1, \"s\") {\n        check.infer_spread(mut i, e, nk.1, env, expected)\n      } else {\n        rt := check.infer(mut i, recv, env, None)\n        mut i.insts.insert(nk.1 + \":recv\", rt)\n        t := check.infer_method(mut i, recv, nk.0, args, env, true)\n        mut i.insts.insert(nk.1, t)\n        t\n      },\n      None => check.infer_method(mut i, recv, name, args, env, true),\n    },\n    ast.MutExpr(x) => check.infer(mut i, x, env, expected),\n    // `r!`, `o?`: the value a `Result` or an `Option` holds\n    ast.Try { value, kind } => {\n      vt := check.infer(mut i, value, env, None)\n      want := if kind == ast.TryResult {\n        \"Result\"\n      } else {\n        \"Option\"\n      }\n      match check.res(i, vt) {\n        check.TNamed { name, args } => if name == want {\n          check.early_error(mut i, kind, if kind == ast.TryResult {\n            get(args, 1) ?? check.TAny\n          } else {\n            check.TAny\n          })\n          get(args, 0) ?? check.TAny\n        } else {\n          check.wrong_try(mut i, kind, check.res(i, vt))\n        },\n        check.TAny | check.TVar(_) => check.TAny,\n        other => check.wrong_try(mut i, kind, other),\n      }\n    },\n    // `r except e { fallback }`: the value, or the fallback (of the same\n    // type) with `e` the error\n    ast.Except { value, err, fallback } => {\n      vt := check.infer(mut i, value, env, None)\n      (ok, bad) := match check.res(i, vt) {\n        check.TNamed { name, args } => if name == \"Result\" && len(args) == 2 {\n          (get(args, 0) ?? check.TAny, get(args, 1) ?? check.TAny)\n        } else if name == \"Option\" {\n          check.error(\n            mut i,\n            \"`except` / `!!` handle a Result; an Option is handled with `or { … }` / `??`\",\n          )\n          (check.fresh(mut i), check.TAny)\n        } else {\n          check.not_result(mut i, check.res(i, vt))\n        },\n        check.TAny | check.TVar(_) => (check.TAny, check.TAny),\n        other => check.not_result(mut i, other),\n      }\n      inner := match err {\n        Some(n) => {\n          mut copy := env\n          mut copy.insert(n, bad)\n          copy\n        },\n        None => env,\n      }\n      ft := check.infer(mut i, fallback, inner, Some(ok))\n      check.expect(mut i, ok, ft, \"`except` fallback\")\n      ok\n    },\n    ast.Fallback { value, fallback } => {\n      vt := check.infer(mut i, value, env, None)\n      inner := match check.res(i, vt) {\n        check.TNamed { name, args } => if name == \"Option\" && len(args) == 1 {\n          get(args, 0) ?? check.TAny\n        } else if name == \"Result\" && len(args) == 2 {\n          check.error(\n            mut i,\n            \"`or` / `??` handle an Option; a Result is handled with `except { … }` / `!!`\",\n          )\n          get(args, 0) ?? check.TAny\n        } else {\n          match check.shown(check.res(i, vt)) {\n            Some(x) => check.error(\n              mut i,\n              \"`or` / `??` handle an Option, found `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          check.fresh(mut i)\n        },\n        check.TAny => check.TAny,\n        other => {\n          match check.shown(other) {\n            Some(x) => check.error(\n              mut i,\n              \"`or` / `??` handle an Option, found `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          // the fallback's type, so checking goes on\n          check.fresh(mut i)\n        },\n      }\n      ft := check.infer(mut i, fallback, env, Some(inner))\n      check.expect(mut i, inner, ft, \"`or` fallback\")\n      inner\n    },\n    ast.Index { base, index } => {\n      bt := check.infer(mut i, base, env, None)\n      match index {\n        // `xs[a..b]`: a slice, of the same type\n        ast.Range { lo, hi, .. } => {\n          for x in [lo, hi] {\n            match x {\n              Some(v) => check.infer(mut i, v, env, Some(check.TInt)),\n              None => check.TAny,\n            }\n          }\n          match check.res(i, bt) {\n            check.TList(_) => bt,\n            _ => check.TAny,\n          }\n        },\n        // `xs[k]`: the built-in `at(xs, k)`\n        _ => match check.res(i, bt) {\n          check.TList(_) => match get(i.builtins, \"at\") {\n            Some(bs) => check.builtin_call(mut i, \"at\", bs, [bt], [index], env),\n            None => {\n              _ := check.infer(mut i, index, env, None)\n              check.TAny\n            },\n          },\n          _ => {\n            _ := check.infer(mut i, index, env, None)\n            check.TAny\n          },\n        },\n      }\n    },\n    // `a..b`: the list of the integers from `a`\n    ast.Range { lo, hi, .. } => {\n      for x in [lo, hi] {\n        match x {\n          Some(v) => check.infer(mut i, v, env, Some(check.TInt)),\n          None => check.TAny,\n        }\n      }\n      check.TList(check.TInt)\n    },\n    ast.Comp { kind, elem, fors } => {\n      mut seen := env\n      // over an iterator, one of the program's types or core's, a comprehension\n      // is lazy: an iterator instead of a list\n      mut lazy := false\n      for f in fors {\n        it := check.infer(mut i, f.iter, seen, None)\n        match check.res(i, it) {\n          check.TNamed { name, .. } => if contains(i.methods.impls, \"Iterator for \" + name)\n            || contains(i.methods.impls, \"FiniteIterator for \" + name) {\n            lazy = true\n          },\n          _ => (),\n        }\n        seen = check.bind_typed(\n          mut i,\n          seen,\n          f.pat,\n          check.element_of(i, it),\n        )\n        match f.cond {\n          Some(c) => check.infer(mut i, c, seen, None),\n          None => (),\n        }\n      }\n      et := check.infer(mut i, elem, seen, None)\n      // a list comprehension is a list of its element's type\n      if kind == ast.ListComp && !lazy {\n        check.TList(et)\n      } else {\n        check.TAny\n      }\n    },\n    ast.DictExpr { entries, .. } => {\n      for kv in entries {\n        check.infer_all(mut i, [kv.0, kv.1], env)\n      }\n      check.TAny\n    },\n    ast.SetExpr { elems, .. } => {\n      check.infer_all(mut i, elems, env)\n      check.TAny\n    },\n    ast.Comptime(x) => {\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    // `old e`: `e`'s value where the function started, of `e`'s type\n    ast.Old(x) => check.infer(mut i, x, env, expected),\n    // `...x` where `spread_bound` found no call by name to fill\n    ast.Spread(x) => {\n      check.spread_error(\n        mut i,\n        \"`...\"\n          + text.expr_text(x, 0)\n          + \"`: a spread gives a record's fields to the parameters of a function or method called by name; it can't be used here\",\n      )\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    ast.Assumed(x) => check.infer(mut i, x, env, expected),\n    // a `scope`'s result can't hold one of its tasks' handles\n    ast.Scope(x) => {\n      held := i.outside\n      i.outside = Some(set(keys(env)))\n      // `scope { …; spawn e }`: the last task's handle isn't its value\n      t := if check.ends_in_spawn(x) {\n        _ := check.infer(mut i, x, env, None)\n        check.TUnit\n      } else {\n        check.infer(mut i, x, env, expected)\n      }\n      i.outside = held\n      if check.holds_task(check.res(i, t)) {\n        match check.shown(check.res(i, t)) {\n          Some(s) => check.error(\n            mut i,\n            \"a task's handle can't leave its `scope` (its result is `\"\n              + s\n              + \"`): await it inside\",\n          ),\n          None => (),\n        }\n      }\n      t\n    },\n    // `spawn e`: a handle to `e`'s value\n    ast.Spawn(x) => {\n      outer := i.ret\n      i.ret = check.TAny\n      held := i.captured\n      i.captured = set(keys(env))\n      t := check.infer(mut i, x, env, None)\n      i.captured = held\n      i.ret = outer\n      // a sender is captured on its own, never inside another value\n      for v in keys(env).sorted() {\n        vt := check.res(i, get(env, v) ?? check.TAny)\n        if !(vt is check.TNamed && check.type_name(vt) == \"Sender\")\n          && check.holds_sender(i, vt, 8)\n          && check.uses(x, v)\n          && !check.rebinds(x, v) {\n          check.error(\n            mut i,\n            \"a task (a `spawn`, a `race` arm) can capture a sender only on its own (a variable holding it): `\"\n              + v\n              + \"` holds one inside\",\n          )\n        }\n      }\n      check.TNamed { name: \"Task\", args: [t] }\n    },\n    // `select`: each arm's operation (`rx.recv()` an `Option`, `tx.send(v)`,\n    // `await h`, `clock.after(d)` with `clock` a clock and `d` a `Duration`),\n    // its name, and its body with the type wanted\n    ast.Select(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.MethodCall { recv, name, args } => if name == \"after\" && len(args) == 1 {\n            ct := check.res(i, check.infer(mut i, recv, env, None))\n            match ct {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(ct) {\n                Some(x) => check.error(\n                  mut i,\n                  \"an `after` arm waits on a clock: `\"\n                    + x\n                    + \"` doesn't implement `Clock` (std.time)\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            dt := check.res(i, check.infer(\n              mut i,\n              get(args, 0) ?? ast.UnitExpr,\n              env,\n              None,\n            ))\n            match dt {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(dt) {\n                Some(x) => check.error(\n                  mut i,\n                  \"the time an `after` arm waits: expected `std.time.Duration`, found `\"\n                    + x\n                    + \"`\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            check.TUnit\n          } else {\n            check.infer(mut i, a.op, env, None)\n          },\n          _ => check.infer(mut i, a.op, env, None),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `race`: each left side is a task's body (a supervised one's result is a\n    // `Result[T, Panic]`), then its name and its body\n    ast.Race(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.SupervisedSpawn(x) => check.TNamed { name: \"Result\", args: [\n            check.task_body(mut i, x, env),\n            check.TNamed { name: \"Panic\", args: [] },\n          ] },\n          op => check.task_body(mut i, op, env),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `supervised spawn e`: a handle to `e`'s value, or its panic\n    ast.SupervisedSpawn(x) => check.TNamed {\n      name: \"Task\",\n      args: [check.TNamed { name: \"Result\", args: [\n        check.task_body(mut i, x, env),\n        check.TNamed { name: \"Panic\", args: [] },\n      ] }],\n    },\n    // `await h`: the task's value, or each task's for a tuple or list of handles\n    ast.Await(x) => {\n      t := check.infer(mut i, x, env, None)\n      check.awaited(mut i, check.res(i, t))\n    },\n    ast.Hole(h) => {\n      t := expected ?? check.fresh(mut i)\n      mut i.holes.push((h, t, env))\n      t\n    },\n    _ => check.TAny,\n  }\n}"},{"name":"declarations.signature_errors","kind":"fn","old":"65e22530293ea0fc","new":"1a9effb255e896af","interface_changed":false,"affected":[],"module":"declarations","text":"/// A function signature's errors: its parameter and result types, and its\n/// bounds' traits.\nfn signature_errors(\n  sc: declarations.Names,\n  f: ast.FnDecl,\n  tps: Set[String],\n  self_ok: Bool,\n) -> List[String] {\n  mut out := []\n  for n in declarations.twice(f.type_params) {\n    mut out.push(\"two type parameters are named `\" + n + \"`\")\n  }\n  for n in declarations.twice(f.params.map(p -> p.name)) {\n    mut out.push(\"two parameters are named `\" + n + \"`\")\n  }\n  for b in f.bounds {\n    for tr in b.traits {\n      match tr {\n        // a structural type: its fields' types\n        ast.RowType(fs) => {\n          for x in fs {\n            out = declarations.type_errors_in(sc, x.1, tps, self_ok, out)\n          }\n        },\n        _ => {\n          n := declarations.type_head_of(tr)\n          if !contains(sc.traits, n) && !contains(n, \".\") && !sc.open {\n            mut out.push(\"`\" + n + \"` is not a trait\")\n          }\n        },\n      }\n    }\n  }\n  for p in f.params {\n    out = declarations.type_errors_in(sc, p.ty, tps, self_ok, out)\n  }\n  declarations.type_errors_in(sc, f.ret, tps, self_ok, out)\n}","old_text":"/// A function signature's errors: its parameter and result types, and its\n/// bounds' traits.\nfn signature_errors(\n  sc: declarations.Names,\n  f: ast.FnDecl,\n  tps: Set[String],\n  self_ok: Bool,\n) -> List[String] {\n  mut out := []\n  for n in declarations.twice(f.type_params) {\n    mut out.push(\"two type parameters are named `\" + n + \"`\")\n  }\n  for n in declarations.twice(f.params.map(p -> p.name)) {\n    mut out.push(\"two parameters are named `\" + n + \"`\")\n  }\n  for b in f.bounds {\n    for tr in b.traits {\n      n := declarations.type_head_of(tr)\n      if !contains(sc.traits, n) && !contains(n, \".\") && !sc.open {\n        mut out.push(\"`\" + n + \"` is not a trait\")\n      }\n    }\n  }\n  for p in f.params {\n    out = declarations.type_errors_in(sc, p.ty, tps, self_ok, out)\n  }\n  declarations.type_errors_in(sc, f.ret, tps, self_ok, out)\n}"},{"name":"desugar.use ast","kind":"use","old":"f31ead21a8038cb4","new":"92fe8870817ed9b3","interface_changed":true,"affected":[],"module":"desugar","text":"// desugar: rewrites ranges, indexing, slices, comprehensions, defaults and\n// mixed unions into plain calls and types after a program is read. The tree\n// keeps them as written, so they render back the same. Names it makes start\n// with `$`, which no program can write.\n\nfrom ast use DeriveFnDef, Decl, DeclKind, TypeDecl, Field, Variant, FnDecl,\n  TypeExpr, Expr, LamParam, CompFor, Stmt, Pattern, TypeDef, FnDef, TestDef,\n  TraitDef, ImplDef, RecordBody, SumBody, Alias, RecordPayload, MemberType,\n  Named, Refined, UnionType, Bound, RowType, IntLit, TupleExpr, Var, ListExpr,\n  CtorExpr, Call, FieldOf, Lambda, Binary, Block, Range, Index, Comp, DictExpr,\n  SetExpr, RecordArgs, ListComp, SetComp, DictComp, Add, Let, Bind, UnitExpr,\n  Assign, VarDecl, ExprStmt, ImplDecl, TraitDecl, TraitMethod, ModelDecl,\n  ModelDef, MethodCall, Old, Param, MockExpr, StrLit, BoolLit, NoArgs, Equal,\n  And, FnType, UnitType, Assumed, is_assumed, unassumed, ExternDef, ExternDecl,\n  ExternFn, Python","old_text":"// desugar: rewrites ranges, indexing, slices, comprehensions, defaults and\n// mixed unions into plain calls and types after a program is read. The tree\n// keeps them as written, so they render back the same. Names it makes start\n// with `$`, which no program can write.\n\nfrom ast use DeriveFnDef, Decl, DeclKind, TypeDecl, Field, Variant, FnDecl,\n  TypeExpr, Expr, LamParam, CompFor, Stmt, Pattern, TypeDef, FnDef, TestDef,\n  TraitDef, ImplDef, RecordBody, SumBody, Alias, RecordPayload, MemberType,\n  Named, Refined, UnionType, RowType, IntLit, TupleExpr, Var, ListExpr,\n  CtorExpr, Call, FieldOf, Lambda, Binary, Block, Range, Index, Comp, DictExpr,\n  SetExpr, RecordArgs, ListComp, SetComp, DictComp, Add, Let, Bind, UnitExpr,\n  Assign, VarDecl, ExprStmt, ImplDecl, TraitDecl, TraitMethod, ModelDecl,\n  ModelDef, MethodCall, Old, Param, MockExpr, StrLit, BoolLit, NoArgs, Equal,\n  And, FnType, UnitType, Assumed, is_assumed, unassumed, ExternDef, ExternDecl,\n  ExternFn, Python"},{"name":"desugar.desugar_more","kind":"fn","old":"2db4912c8cc65940","new":"177bc47b56ea9c82","interface_changed":false,"affected":[],"module":"desugar","text":"/// `desugar` of definitions added to a program already without its sugar\n/// (`context`, not returned). Each definition is desugared once. Returns\n/// `new` without sugar, with the aliases made for refinements the program\n/// had no alias for yet; the errors; and all refinements named so far\n/// (`texts`, then the new ones; `$where_k` is the `k`th).\npub fn desugar_more(\n  new: List[ast.Decl],\n  context: List[ast.Decl],\n  texts: List[String],\n) -> (List[ast.Decl], List[(String, String)], List[String]) {\n  mut errors := []\n  mut out := []\n  for d0 in desugar.with_models(new, context) {\n    // an `extern python` function becomes the call of the Python worker\n    d := desugar.python_lowered(d0)\n    for e in walk.decl_kids(d).1 {\n      for _ in 0..desugar.open_ranges(e) {\n        mut errors.push(\n          (\n            desugar.decl_name(d),\n            \"a range needs both ends (`a..b`), except in a slice: `xs[a..]`, `xs[..b]`\",\n          ),\n        )\n      }\n    }\n    lifted := desugar.rows_lifted(d)\n    for e in desugar.row_errors(lifted) {\n      mut errors.push((desugar.decl_name(d), e))\n    }\n    mut out.push(\n      desugar.named_results(walk.decl_parts(\n        lifted,\n        x -> desugar.unsugared(x),\n        t -> desugar.unsugared_type(t),\n      )),\n    )\n  }\n  (refined, all) := desugar.inline_refinements(\n    desugar.key_paths(desugar.defaults(out, context), context),\n    texts,\n  )\n  (desugar.mixed_unions(refined), errors, all)\n}","old_text":"/// `desugar` of definitions added to a program already without its sugar\n/// (`context`, not returned). Each definition is desugared once. Returns\n/// `new` without sugar, with the aliases made for refinements the program\n/// had no alias for yet; the errors; and all refinements named so far\n/// (`texts`, then the new ones; `$where_k` is the `k`th).\npub fn desugar_more(\n  new: List[ast.Decl],\n  context: List[ast.Decl],\n  texts: List[String],\n) -> (List[ast.Decl], List[(String, String)], List[String]) {\n  mut errors := []\n  mut out := []\n  for d0 in desugar.with_models(new, context) {\n    // an `extern python` function becomes the call of the Python worker\n    d := desugar.python_lowered(d0)\n    for e in walk.decl_kids(d).1 {\n      for _ in 0..desugar.open_ranges(e) {\n        mut errors.push(\n          (\n            desugar.decl_name(d),\n            \"a range needs both ends (`a..b`), except in a slice: `xs[a..]`, `xs[..b]`\",\n          ),\n        )\n      }\n    }\n    mut out.push(\n      desugar.named_results(walk.decl_parts(\n        d,\n        x -> desugar.unsugared(x),\n        t -> desugar.unsugared_type(t),\n      )),\n    )\n  }\n  (refined, all) := desugar.inline_refinements(\n    desugar.key_paths(desugar.defaults(out, context), context),\n    texts,\n  )\n  (desugar.mixed_unions(refined), errors, all)\n}"},{"name":"parse.type_expr_plain","kind":"fn","old":"b19be3e729b70db7","new":"4a26bfcc4bc47ac8","interface_changed":false,"affected":[],"module":"parse","text":"/// A type without `where` or `|`: `Int`, `List[T]`, `(A, B)`, `(A) -> B`,\n/// `{ id: Int, .. }`.\nfn type_expr_plain(mut p: parse.Parser) -> Result[ast.TypeExpr, String] {\n  if parse.eat_sym(mut p, \"{\") {\n    return parse.row_type(mut p)\n  }\n  if parse.eat_sym(mut p, \"(\") {\n    args := parse.type_list(mut p, \")\")!\n    if parse.eat_sym(mut p, \"->\") {\n      return Ok(ast.FnType { params: args, ret: parse.type_expr(mut p)! })\n    }\n    return Ok(match args {\n      [] => ast.UnitType,\n      [t] => t,\n      _ => ast.Named { name: \"Tuple\", args },\n    })\n  }\n  name := parse.path(mut p)!\n  args := if parse.eat_sym(mut p, \"[\") {\n    parse.type_list(mut p, \"]\")!\n  } else {\n    []\n  }\n  Ok(ast.Named { name, args })\n}","old_text":"/// A type without `where` or `|`: `Int`, `List[T]`, `(A, B)`, `(A) -> B`.\nfn type_expr_plain(mut p: parse.Parser) -> Result[ast.TypeExpr, String] {\n  if parse.eat_sym(mut p, \"(\") {\n    args := parse.type_list(mut p, \")\")!\n    if parse.eat_sym(mut p, \"->\") {\n      return Ok(ast.FnType { params: args, ret: parse.type_expr(mut p)! })\n    }\n    return Ok(match args {\n      [] => ast.UnitType,\n      [t] => t,\n      _ => ast.Named { name: \"Tuple\", args },\n    })\n  }\n  name := parse.path(mut p)!\n  args := if parse.eat_sym(mut p, \"[\") {\n    parse.type_list(mut p, \"]\")!\n  } else {\n    []\n  }\n  Ok(ast.Named { name, args })\n}"},{"name":"check.rows_by_param","kind":"fn","old":null,"new":"65d9f18f724e21fd","interface_changed":true,"affected":[],"module":"check","text":"/// The fields each type parameter's structural bounds ask for\n/// (`[T: { id: Int, .. }]`), with their types lowered and as written.\nfn rows_by_param(\n  types: check.Types,\n  tps: Set[String],\n  bs: List[ast.Bound],\n) -> Dict[String, List[(String, check.Ty, ast.TypeExpr)]] {\n  mut out := Dict[String, List[(String, check.Ty, ast.TypeExpr)]] {}\n  for b in bs {\n    for tr in b.traits {\n      match tr {\n        ast.RowType(fs) => mut out.insert(\n          b.param,\n          (get(out, b.param) ?? [])\n            + fs.map(f -> (f.0, check.lower(types, tps, f.1), f.1)),\n        ),\n        _ => (),\n      }\n    }\n  }\n  out\n}"},{"name":"check.row_text","kind":"fn","old":null,"new":"62653821851311cc","interface_changed":true,"affected":[],"module":"check","text":"/// A structural bound as written: `{ id: Int, total: Cents, .. }`.\nfn row_text(fs: List[(String, check.Ty, ast.TypeExpr)]) -> String {\n  \"{ \"\n    + join(\n      fs.map(f -> f.0 + \": \" + text.type_text(f.2)) + [\"..\"],\n      \", \",\n    )\n    + \" }\"\n}"},{"name":"check.row_met","kind":"fn","old":null,"new":"3467d48bfe1020fd","interface_changed":true,"affected":[],"module":"check","text":"/// The type `t` a call gives a type parameter of `fname` has the fields\n/// its structural bound asks for (`fs`, their types with the callee's type\n/// parameters as `vars` has them): a record type with each field, of a type\n/// that fits (the same written type for a refined one), or a type parameter\n/// of the caller's whose own bound has them. An error for each one missing.\nfn row_met(\n  mut i: check.Inf,\n  fname: String,\n  fs: List[(String, check.Ty, ast.TypeExpr)],\n  vars: Dict[String, check.Ty],\n  t: check.Ty,\n) {\n  row := check.row_text(fs)\n  what := f\"calling `{fname}`: \"\n  given := check.shown(check.res(i, t)) ?? \"?\"\n  match check.res(i, t) {\n    check.TVar(_) | check.TAny => (),\n    check.TGen(q) => match get(i.trows, q) {\n      Some(have) => {\n        for f in fs {\n          match have.filter(h -> h.0 == f.0) {\n            [h, ..] => check.field_met(\n              mut i,\n              what,\n              check.row_text(have),\n              f,\n              vars,\n              h.1,\n              h.2,\n            ),\n            _ => check.error(\n              mut i,\n              what\n                + f\"`{check.row_text(have)}` has no field `{f.0}` (the parameter must be `{row}`)\",\n            ),\n          }\n        }\n      },\n      None => check.error(\n        mut i,\n        what\n          + f\"`{q}` is not known to have fields (the parameter must be `{row}`: bound it, `[{q}: {row}]`)\",\n      ),\n    },\n    check.TNamed { name, args } => match get(i.types.ctors, name) {\n      Some(sh) => if sh.positional || sh.owner != name {\n        check.error(mut i, what\n          + f\"`{given}` is not a record (the parameter must be `{row}`)\")\n      } else {\n        mut m := Dict[String, check.Ty] {}\n        for (k, tp) in enumerate(sh.params) {\n          mut m.insert(tp, get(args, k) ?? check.TAny)\n        }\n        for f in fs {\n          mut found := false\n          for (k, x) in enumerate(sh.fields) {\n            if x.0 == f.0 {\n              found = true\n              check.field_met(\n                mut i,\n                what,\n                given,\n                f,\n                vars,\n                check.inst(x.1, m),\n                get(sh.written, k) ?? ast.UnitType,\n              )\n            }\n          }\n          if !found {\n            check.error(\n              mut i,\n              what\n                + f\"`{given}` has no field `{f.0}` (the parameter must be `{row}`)\",\n            )\n          }\n        }\n      },\n      None => check.error(mut i, what\n        + f\"`{given}` is not a record (the parameter must be `{row}`)\"),\n    },\n    _ => check.error(mut i, what\n      + f\"`{given}` is not a record (the parameter must be `{row}`)\"),\n  }\n}"},{"name":"check.field_met","kind":"fn","old":null,"new":"6f243c45e4b350b7","interface_changed":true,"affected":[],"module":"check","text":"/// Field `f` of a structural bound, given by a field of `owner` of type\n/// `got` (`got_w` as written): its type fits, and a refined one is the\n/// same written type (the callee is proven knowing the refinement).\nfn field_met(\n  mut i: check.Inf,\n  what: String,\n  owner: String,\n  f: (String, check.Ty, ast.TypeExpr),\n  vars: Dict[String, check.Ty],\n  got: check.Ty,\n  got_w: ast.TypeExpr,\n) {\n  want := check.inst(f.1, vars)\n  if !check.fits(mut i, want, got) {\n    w := check.shown(check.res(i, want)) ?? text.type_text(f.2)\n    g := check.shown(check.res(i, got)) ?? text.type_text(got_w)\n    check.error(\n      mut i,\n      what + f\"field `{f.0}` of `{owner}` is `{g}`, not `{w}`\",\n    )\n  } else if check.row_refined(i.types, f.2, 0) && got_w != f.2 {\n    check.error(\n      mut i,\n      what\n        + f\"field `{f.0}` of `{owner}` is `{text.type_text(got_w)}`, not `{text.type_text(f.2)}` (a refined field is given by a field of the same type)\",\n    )\n  }\n}"},{"name":"check.row_refined","kind":"fn","old":null,"new":"4ab3d94542d4f659","interface_changed":true,"affected":[],"module":"check","text":"/// A written type holds a refinement: its own, an alias's, a field's type\n/// argument's.\nfn row_refined(types: check.Types, t: ast.TypeExpr, depth: Int) -> Bool {\n  if depth > 20 {\n    return true\n  }\n  match t {\n    ast.Refined { .. } => true,\n    ast.Named { name, args } => contains(types.refinements, name)\n      || check.refined_int(name)\n      || [\"NonEmpty\", \"NonEmptyString\", \"Probability\", \"Percentage\"].contains(\n        name,\n      )\n      || contains(types.aliases, name)\n        && check.row_refined(\n          types,\n          get(types.aliases, name) ?? ast.UnitType,\n          depth + 1,\n        )\n      || args.any(a -> check.row_refined(types, a, depth + 1)),\n    ast.FnType { params, ret } => params.any(a -> check.row_refined(types, a, depth + 1))\n      || check.row_refined(types, ret, depth + 1),\n    ast.UnionType(ms) => ms.any(a -> check.row_refined(types, a, depth + 1)),\n    _ => false,\n  }\n}"},{"name":"desugar.rows_lifted","kind":"fn","old":null,"new":"18568624f20e247c","interface_changed":true,"affected":[],"module":"desugar","text":"/// `d` with each structural type in a parameter's type a type parameter of\n/// its own, bound by it: `fn f(o: { id: Int, .. })` is\n/// `fn f[$o: { id: Int, .. }](o: $o)`, and `os: List[{ id: Int, .. }]` is\n/// `os: List[$os]` (one record type for the whole list).\nfn rows_lifted(d: ast.Decl) -> ast.Decl {\n  match d.kind {\n    ast.FnDef(f) => ast.Decl { ..d, kind: ast.FnDef(desugar.fn_rows_lifted(f)) },\n    ast.ImplDef(im) => ast.Decl { ..d, kind: ast.ImplDef(\n      ast.ImplDecl { ..im, methods: im.methods.map(f -> desugar.fn_rows_lifted(f)) },\n    ) },\n    ast.TraitDef(t) => ast.Decl { ..d, kind: ast.TraitDef(ast.TraitDecl { ..t, methods: t.methods.map(\n      m ->\n        ast.TraitMethod { ..m, decl: desugar.fn_rows_lifted(m.decl) },\n    ) }) },\n    _ => d,\n  }\n}"},{"name":"desugar.fn_rows_lifted","kind":"fn","old":null,"new":"227dff1b86fd6218","interface_changed":true,"affected":[],"module":"desugar","text":"fn fn_rows_lifted(f: ast.FnDecl) -> ast.FnDecl {\n  if !f.params.any(p -> desugar.has_row(p.ty)) {\n    return f\n  }\n  mut tps := f.type_params\n  mut bounds := f.bounds\n  mut params := []\n  for p in f.params {\n    mut k := 0\n    ty := desugar.row_lifted(p.ty, p.name, mut k, mut tps, mut bounds)\n    mut params.push(ast.Param { ..p, ty })\n  }\n  ast.FnDecl { ..f, type_params: tps, bounds, params }\n}"},{"name":"desugar.has_row","kind":"fn","old":null,"new":"e48f601bacf2e940","interface_changed":true,"affected":[],"module":"desugar","text":"fn has_row(t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.RowType(_) => true,\n    _ => walk.type_kids(t).0.any(u -> desugar.has_row(u)),\n  }\n}"},{"name":"desugar.row_lifted","kind":"fn","old":null,"new":"f6ce35183445d30f","interface_changed":true,"affected":[],"module":"desugar","text":"/// `t` with each structural type at its top or in its type arguments a new\n/// type parameter (`$name`, then `$name2`, ...) bound by it.\nfn row_lifted(\n  t: ast.TypeExpr,\n  name: String,\n  mut k: Int,\n  mut tps: List[String],\n  mut bounds: List[ast.Bound],\n) -> ast.TypeExpr {\n  match t {\n    ast.RowType(_) => {\n      k += 1\n      n := if k == 1 {\n        \"$\" + name\n      } else {\n        \"$\" + name + to_string(k)\n      }\n      mut tps.push(n)\n      mut bounds.push(ast.Bound { param: n, traits: [t] })\n      ast.Named { name: n, args: [] }\n    },\n    ast.Named { name: tn, args } => {\n      mut out := []\n      for a in args {\n        mut out.push(\n          desugar.row_lifted(a, name, mut k, mut tps, mut bounds),\n        )\n      }\n      ast.Named { name: tn, args: out }\n    },\n    _ => t,\n  }\n}"},{"name":"desugar.row_errors","kind":"fn","old":null,"new":"97dc3de3e2e527db","interface_changed":true,"affected":[],"module":"desugar","text":"/// A structural type anywhere but as a bound: it has no values of its own,\n/// so it can't be a variable's, a field's or a result's type.\nfn row_errors(d: ast.Decl) -> List[String] {\n  all := walk.decl_types(d).filter(t -> t is ast.RowType)\n  // (a bound's rows are listed at its top; the fields' types after them)\n  bound := match d.kind {\n    ast.FnDef(f) => desugar.bound_rows(f.bounds),\n    ast.ImplDef(im) => desugar.bound_rows(im.bounds)\n      + fold(\n        im.methods.map(f -> desugar.bound_rows(f.bounds)),\n        0,\n        (a, b) -> a + b,\n      ),\n    ast.TraitDef(t) => fold(\n      t.methods.map(m -> desugar.bound_rows(m.decl.bounds)),\n      0,\n      (a, b) -> a + b,\n    ),\n    _ => 0,\n  }\n  if len(all) > bound {\n    [\n      \"a structural type (`{ id: Int, .. }`) is only a parameter's type or a type parameter's bound (`[T: { id: Int, .. }]`): it has no values of its own, so a result, a variable or a field can't be one (use a type parameter: `-> T`), and its fields can't be one either\",\n    ]\n  } else {\n    []\n  }\n}"},{"name":"desugar.bound_rows","kind":"fn","old":null,"new":"1f5ed68aff06e0b1","interface_changed":true,"affected":[],"module":"desugar","text":"fn bound_rows(bs: List[ast.Bound]) -> Int {\n  mut n := 0\n  for b in bs {\n    for t in b.traits {\n      if t is ast.RowType {\n        n += 1\n      }\n    }\n  }\n  n\n}"},{"name":"parse.row_type","kind":"fn","old":null,"new":"c58a60752716b702","interface_changed":true,"affected":[],"module":"parse","text":"/// `{ id: OrderId, total: Cents, .. }` after its `{`: the fields a record\n/// must have, then `..` (it may have others).\nfn row_type(mut p: parse.Parser) -> Result[ast.TypeExpr, String] {\n  mut fs := []\n  while !parse.is_sym(p, \"..\") {\n    if parse.is_sym(p, \"}\") || parse.peek(p) == lex.Eof {\n      return parse.fail(\n        p,\n        \"a structural type ends with `..`, for the other fields a record may have: `{ id: Int, .. }`\",\n      )\n    }\n    n := parse.ident(mut p)!\n    if fs.any(f -> f.0 == n) {\n      return parse.fail(p, f\"field `{n}` is named twice\")\n    }\n    parse.expect_sym(mut p, \":\")!\n    mut fs.push((n, parse.type_expr(mut p)!))\n    if !parse.eat_sym(mut p, \",\") && !parse.is_sym(p, \"..\") {\n      return parse.fail(\n        p,\n        \"a structural type ends with `..`, for the other fields a record may have: `{ id: Int, .. }`\",\n      )\n    }\n  }\n  parse.expect_sym(mut p, \"..\")!\n  _ := parse.eat_sym(mut p, \",\")\n  parse.expect_sym(mut p, \"}\")!\n  if fs == [] {\n    return parse.fail(\n      p,\n      \"a structural type names the fields it needs: `{ id: Int, .. }`\",\n    )\n  }\n  Ok(ast.RowType(fs))\n}"}]}
{"id":"47fdedfb93659500","time":1795708626,"message":"edit","changes":[{"name":"smt.function","kind":"fn","old":"fe1ecacf94fda49a","new":"0384678443ce82d5","interface_changed":false,"affected":[],"module":"smt","text":"/// Runs `f` symbolically, collecting its obligations and what it uses that\n/// smt doesn't model (`gaps`).\npub fn function(mut vc: smt.Vc, f: ast.FnDecl, label: String) {\n  vc.self_name = label\n  vc.own_name = f.name\n  smt.rows_as_records(mut vc, f)\n  // a lemma, or a law (its wrapper, `strata_verify_K_law_NAME`), is a\n  // proof: spec functions are seen through (`in_proof`)\n  if f.lemma\n    || contains(label, \"strata_verify_\") && contains(label, \"_law_\") {\n    vc.proof_from = 0\n  }\n  vc.own_whiles = smt.while_loops(f.body)\n  for p in f.params {\n    v := smt.havoc(mut vc, p.ty)\n    if p.mutable {\n      smt.declare(mut vc, p.name, Some(p.ty))\n      mut vc.mut_params.push(p.name)\n    }\n    mut vc.params.push((p.name, v))\n    smt.bind(mut vc, p.name, v)\n  }\n  // the lists' first elements, for a counterexample to show (their facts\n  // set aside): one level of nested lists, bounded in terms\n  if vc.examples {\n    nf := len(vc.facts)\n    mut lens := []\n    mut ls := []\n    vc.input_depth = 1\n    for (_, v) in vc.params {\n      smt.open_input(mut vc, v, 0, mut lens, mut ls)\n    }\n    vc.input_depth = 3\n    vc.example_facts = drop(vc.facts, nf)\n    vc.facts = take(vc.facts, nf)\n    vc.example_leaves = ls\n  }\n  binds := vc.params\n  for r in f.pre {\n    c := smt.pred(mut vc, r, binds)\n    mut vc.pc.push(c)\n  }\n  // what a loop may need to keep: the `ensures` of the returned variable,\n  // and those of a `mut` parameter that don't name the result\n  match f.body {\n    ast.Block { last: ast.Var(x), .. } => {\n      vc.hints = f.post.map(e -> (e, x))\n      vc.returned = Some((x, f.ret))\n    },\n    _ => (),\n  }\n  for p in f.params {\n    if p.mutable {\n      for e in f.post {\n        names := smt.var_names(e)\n        if contains(names, p.name)\n          && !contains(names, \"it\")\n          && !vc.hints.any(h -> h.0 == e && h.1 == p.name) {\n          mut vc.hints.push((e, p.name))\n        }\n      }\n    }\n  }\n  vc.result_text = match f.body {\n    ast.Block { last, .. } => text.expr_text(last, 0),\n    other => text.expr_text(other, 0),\n  }\n  vc.requires_hints = f.pre\n  res := smt.eval(mut vc, f.body)\n  // the result is checked where the body ends and at every early return\n  mut exits := []\n  if !vc.dead {\n    mut exits.push((vc.pc, res, \"\", smt.mut_state(vc)))\n  }\n  for x in vc.returns {\n    mut exits.push((x.pc, x.value, \" (early return)\", x.state))\n  }\n  vc.returns = []\n  shown := smt.shown_name(label)\n  for (pc, value, how, state) in exits {\n    vc.pc = pc\n    vc.dead = false\n    // the `ensures` name the `mut` parameters as they are at this exit,\n    // `old x` as they were on entry\n    after := smt.rebound(binds, state)\n    if smt.refined(vc, f.ret) {\n      if smt.start_goal(mut vc) {\n        g := smt.check_type(mut vc, f.ret, value, binds)\n        smt.oblige(\n          mut vc,\n          f\"result of `{shown}`{how}: {text.type_text(f.ret)}\",\n          g,\n        )\n      }\n    }\n    for en in f.post {\n      n := len(vc.pc)\n      if smt.start_goal(mut vc) {\n        g := smt.pred_old(\n          mut vc,\n          en,\n          after + [(\"it\", value)],\n          Some(binds),\n        )\n        smt.oblige(\n          mut vc,\n          f\"ensures {text.expr_text(en, 0)}{how}\",\n          g,\n        )\n      }\n      vc.pc = take(vc.pc, n)\n    }\n  }\n}","old_text":"/// Runs `f` symbolically, collecting its obligations and what it uses that\n/// smt doesn't model (`gaps`).\npub fn function(mut vc: smt.Vc, f: ast.FnDecl, label: String) {\n  vc.self_name = label\n  vc.own_name = f.name\n  // a lemma, or a law (its wrapper, `strata_verify_K_law_NAME`), is a\n  // proof: spec functions are seen through (`in_proof`)\n  if f.lemma\n    || contains(label, \"strata_verify_\") && contains(label, \"_law_\") {\n    vc.proof_from = 0\n  }\n  vc.own_whiles = smt.while_loops(f.body)\n  for p in f.params {\n    v := smt.havoc(mut vc, p.ty)\n    if p.mutable {\n      smt.declare(mut vc, p.name, Some(p.ty))\n      mut vc.mut_params.push(p.name)\n    }\n    mut vc.params.push((p.name, v))\n    smt.bind(mut vc, p.name, v)\n  }\n  // the lists' first elements, for a counterexample to show (their facts\n  // set aside): one level of nested lists, bounded in terms\n  if vc.examples {\n    nf := len(vc.facts)\n    mut lens := []\n    mut ls := []\n    vc.input_depth = 1\n    for (_, v) in vc.params {\n      smt.open_input(mut vc, v, 0, mut lens, mut ls)\n    }\n    vc.input_depth = 3\n    vc.example_facts = drop(vc.facts, nf)\n    vc.facts = take(vc.facts, nf)\n    vc.example_leaves = ls\n  }\n  binds := vc.params\n  for r in f.pre {\n    c := smt.pred(mut vc, r, binds)\n    mut vc.pc.push(c)\n  }\n  // what a loop may need to keep: the `ensures` of the returned variable,\n  // and those of a `mut` parameter that don't name the result\n  match f.body {\n    ast.Block { last: ast.Var(x), .. } => {\n      vc.hints = f.post.map(e -> (e, x))\n      vc.returned = Some((x, f.ret))\n    },\n    _ => (),\n  }\n  for p in f.params {\n    if p.mutable {\n      for e in f.post {\n        names := smt.var_names(e)\n        if contains(names, p.name)\n          && !contains(names, \"it\")\n          && !vc.hints.any(h -> h.0 == e && h.1 == p.name) {\n          mut vc.hints.push((e, p.name))\n        }\n      }\n    }\n  }\n  vc.result_text = match f.body {\n    ast.Block { last, .. } => text.expr_text(last, 0),\n    other => text.expr_text(other, 0),\n  }\n  vc.requires_hints = f.pre\n  res := smt.eval(mut vc, f.body)\n  // the result is checked where the body ends and at every early return\n  mut exits := []\n  if !vc.dead {\n    mut exits.push((vc.pc, res, \"\", smt.mut_state(vc)))\n  }\n  for x in vc.returns {\n    mut exits.push((x.pc, x.value, \" (early return)\", x.state))\n  }\n  vc.returns = []\n  shown := smt.shown_name(label)\n  for (pc, value, how, state) in exits {\n    vc.pc = pc\n    vc.dead = false\n    // the `ensures` name the `mut` parameters as they are at this exit,\n    // `old x` as they were on entry\n    after := smt.rebound(binds, state)\n    if smt.refined(vc, f.ret) {\n      if smt.start_goal(mut vc) {\n        g := smt.check_type(mut vc, f.ret, value, binds)\n        smt.oblige(\n          mut vc,\n          f\"result of `{shown}`{how}: {text.type_text(f.ret)}\",\n          g,\n        )\n      }\n    }\n    for en in f.post {\n      n := len(vc.pc)\n      if smt.start_goal(mut vc) {\n        g := smt.pred_old(\n          mut vc,\n          en,\n          after + [(\"it\", value)],\n          Some(binds),\n        )\n        smt.oblige(\n          mut vc,\n          f\"ensures {text.expr_text(en, 0)}{how}\",\n          g,\n        )\n      }\n      vc.pc = take(vc.pc, n)\n    }\n  }\n}"},{"name":"smt.rows_as_records","kind":"fn","old":null,"new":"f94deb08084cb63a","interface_changed":true,"affected":[],"module":"smt","text":"/// Each type parameter of `f` with a structural bound\n/// (`[T: { id: Int, .. }]`) as a record type of its own with those fields:\n/// `f` can only read them (it makes no value of `T` and compares none), so\n/// what holds for that record holds for every record with the fields.\n/// A type of the program with the parameter's name keeps it opaque.\nfn rows_as_records(mut vc: smt.Vc, f: ast.FnDecl) {\n  mut rows := Dict[String, List[ast.Field]] {}\n  for b in f.bounds {\n    for tr in b.traits {\n      match tr {\n        ast.RowType(fs) => mut rows.insert(\n          b.param,\n          (get(rows, b.param) ?? [])\n            + fs.map(\n              x -> ast.Field {\n                comments: [],\n                doc: [],\n                name: x.0,\n                ty: x.1,\n                default: None,\n              },\n            ),\n        ),\n        _ => (),\n      }\n    }\n  }\n  for (p, fs) in rows {\n    if !contains(vc.types, p) {\n      mut vc.types.insert(\n        p,\n        ast.TypeDecl {\n          distinct: false,\n          name: p,\n          params: [],\n          body: ast.RecordBody(fs),\n          refinement: None,\n          mocked: false,\n        },\n      )\n      mut vc.ctors.insert(p, p)\n    }\n  }\n}"}]}
{"id":"fb281a5b6fb1db53","time":1795708716,"message":"edit","changes":[{"name":"smt.rows_as_records","kind":"fn","old":"f94deb08084cb63a","new":"64454f0f28ec3f70","interface_changed":false,"affected":[],"module":"smt","text":"/// Each type parameter of `f` with a structural bound\n/// (`[T: { id: Int, .. }]`) as a record type of its own with those fields:\n/// `f` can only read them (it makes no value of `T` and compares none), so\n/// what holds for that record holds for every record with the fields.\n/// A type of the program with the parameter's name keeps it opaque.\nfn rows_as_records(mut vc: smt.Vc, f: ast.FnDecl) {\n  mut rows := Dict[String, List[ast.Field]] {}\n  for b in f.bounds {\n    for tr in b.traits {\n      match tr {\n        ast.RowType(fs) => mut rows.insert(\n          b.param,\n          (get(rows, b.param) ?? [])\n            + fs.map(\n              x -> ast.Field {\n                comments: [],\n                doc: [],\n                name: x.0,\n                ty: x.1,\n                default: None,\n              },\n            ),\n        ),\n        _ => (),\n      }\n    }\n  }\n  for (p, fs) in rows {\n    if !contains(vc.types, p) {\n      mut vc.types.insert(\n        p,\n        ast.TypeDecl {\n          distinct: false,\n          name: p,\n          params: [],\n          body: ast.RecordBody(fs),\n          refinement: None,\n          mocked: false,\n        },\n      )\n      mut vc.ctors.insert(p, p)\n      // (a refined field: checking a value of it involves the refinement)\n      match vc.methods.refined_types {\n        Some(names) => if fs.any(x -> smt.refined(vc, x.ty)) {\n          mut more := names\n          mut more.insert(p)\n          vc.methods = smt.Methods { ..vc.methods, refined_types: Some(more) }\n        },\n        None => (),\n      }\n    }\n  }\n}","old_text":"/// Each type parameter of `f` with a structural bound\n/// (`[T: { id: Int, .. }]`) as a record type of its own with those fields:\n/// `f` can only read them (it makes no value of `T` and compares none), so\n/// what holds for that record holds for every record with the fields.\n/// A type of the program with the parameter's name keeps it opaque.\nfn rows_as_records(mut vc: smt.Vc, f: ast.FnDecl) {\n  mut rows := Dict[String, List[ast.Field]] {}\n  for b in f.bounds {\n    for tr in b.traits {\n      match tr {\n        ast.RowType(fs) => mut rows.insert(\n          b.param,\n          (get(rows, b.param) ?? [])\n            + fs.map(\n              x -> ast.Field {\n                comments: [],\n                doc: [],\n                name: x.0,\n                ty: x.1,\n                default: None,\n              },\n            ),\n        ),\n        _ => (),\n      }\n    }\n  }\n  for (p, fs) in rows {\n    if !contains(vc.types, p) {\n      mut vc.types.insert(\n        p,\n        ast.TypeDecl {\n          distinct: false,\n          name: p,\n          params: [],\n          body: ast.RecordBody(fs),\n          refinement: None,\n          mocked: false,\n        },\n      )\n      mut vc.ctors.insert(p, p)\n    }\n  }\n}"}]}
{"id":"8511dd508a415ce6","time":1795708810,"message":"edit","changes":[{"name":"codegen.fuzz_instance","kind":"fn","old":"95f568ea862a0d2a","new":"bab3bb5a7621a34f","interface_changed":false,"affected":[],"module":"codegen","text":"/// Concrete types to fuzz a generic function `f` with. An unbounded type\n/// parameter is `Int`. A bounded one is the first type implementing all its\n/// bounds (with its own type parameters `Int`), else the first bound's\n/// trait, as a mock. One with a structural bound (`{ id: Int, .. }`) is the\n/// first record of the program with those fields (`fitting_record`).\nfn fuzz_instance(g: codegen.Gen, f: ast.FnDecl) -> Dict[String, ast.TypeExpr] {\n  int := ast.Named { name: \"Int\", args: [] }\n  mut out := Dict[String, ast.TypeExpr] {}\n  for p in f.type_params {\n    mut trs := []\n    mut rows := []\n    for b in f.bounds {\n      if b.param == p {\n        for t in b.traits {\n          match t {\n            ast.RowType(fs) => {\n              rows += fs\n            },\n            _ => mut trs.push(codegen.texpr_head(t)),\n          }\n        }\n      }\n    }\n    if rows != [] {\n      mut out.insert(p, codegen.fitting_record(g, rows, trs) ?? int)\n      continue\n    }\n    // a trait as `g.traits` names it: qualified\n    full := (tr: String) -> if contains(g.traits, tr) {\n      tr\n    } else {\n      get(keys(g.traits).filter(\n        k -> codegen.short(k) == codegen.short(tr),\n      ), 0) ?? tr\n    }\n    implements := (head: String, tr: String) -> g.impls.any(\n      im -> im.head == head && full(im.decl.trait_name) == full(tr),\n    )\n    t := match get(trs, 0) {\n      None => int,\n      Some(first) => {\n        mut chosen := ast.Named { name: full(first), args: [] }\n        mut found := false\n        for im in g.impls {\n          if !found\n            && full(im.decl.trait_name) == full(first)\n            && trs.all(tr -> implements(im.head, tr)) {\n            mut ints := Dict[String, ast.TypeExpr] {}\n            for q in im.decl.type_params {\n              mut ints.insert(q, int)\n            }\n            args := match im.decl.for_type {\n              ast.Named { args, .. } => args.map(a -> codegen.self_is(a, ints)),\n              _ => [],\n            }\n            chosen = ast.Named { name: im.head, args }\n            found = true\n          }\n        }\n        chosen\n      },\n    }\n    mut out.insert(p, t)\n  }\n  out\n}","old_text":"/// Concrete types to fuzz a generic function `f` with. An unbounded type\n/// parameter is `Int`. A bounded one is the first type implementing all its\n/// bounds (with its own type parameters `Int`), else the first bound's\n/// trait, as a mock.\nfn fuzz_instance(g: codegen.Gen, f: ast.FnDecl) -> Dict[String, ast.TypeExpr] {\n  int := ast.Named { name: \"Int\", args: [] }\n  mut out := Dict[String, ast.TypeExpr] {}\n  for p in f.type_params {\n    mut trs := []\n    for b in f.bounds {\n      if b.param == p {\n        trs += b.traits.map(t -> codegen.texpr_head(t))\n      }\n    }\n    // a trait as `g.traits` names it: qualified\n    full := (tr: String) -> if contains(g.traits, tr) {\n      tr\n    } else {\n      get(keys(g.traits).filter(\n        k -> codegen.short(k) == codegen.short(tr),\n      ), 0) ?? tr\n    }\n    implements := (head: String, tr: String) -> g.impls.any(\n      im -> im.head == head && full(im.decl.trait_name) == full(tr),\n    )\n    t := match get(trs, 0) {\n      None => int,\n      Some(first) => {\n        mut chosen := ast.Named { name: full(first), args: [] }\n        mut found := false\n        for im in g.impls {\n          if !found\n            && full(im.decl.trait_name) == full(first)\n            && trs.all(tr -> implements(im.head, tr)) {\n            mut ints := Dict[String, ast.TypeExpr] {}\n            for q in im.decl.type_params {\n              mut ints.insert(q, int)\n            }\n            args := match im.decl.for_type {\n              ast.Named { args, .. } => args.map(a -> codegen.self_is(a, ints)),\n              _ => [],\n            }\n            chosen = ast.Named { name: im.head, args }\n            found = true\n          }\n        }\n        chosen\n      },\n    }\n    mut out.insert(p, t)\n  }\n  out\n}"},{"name":"codegen.fitting_record","kind":"fn","old":null,"new":"6003fe83fbb9c147","interface_changed":true,"affected":[],"module":"codegen","text":"/// The first record type of the program, without type parameters, with each\n/// of `rows`' fields (of the same written type) and implementing the traits\n/// `trs`.\nfn fitting_record(\n  g: codegen.Gen,\n  rows: List[(String, ast.TypeExpr)],\n  trs: List[String],\n) -> Option[ast.TypeExpr] {\n  for (n, sh) in items(g.types.ctors) {\n    if sh.owner == n\n      && !sh.positional\n      && sh.params == []\n      && rows.all(r -> get(g.field_types, n + \".\" + r.0) == Some(r.1))\n      && trs.all(\n        tr -> g.impls.any(\n          im -> im.head == n\n            && codegen.short(im.decl.trait_name) == codegen.short(tr),\n        ),\n      ) {\n      return Some(ast.Named { name: n, args: [] })\n    }\n  }\n  None\n}"}]}
{"id":"6d8ab027e02579cc","time":1795709324,"message":"edit","changes":[{"name":"parse.fields","kind":"fn","old":"ca53c0d72abd1cbc","new":"71697ab8fc33609d","interface_changed":false,"affected":[],"module":"parse","text":"/// A record's fields, up to its `}`.\nfn fields(mut p: parse.Parser) -> Result[List[ast.Field], String] {\n  mut out := []\n  while !parse.is_sym(p, \"}\") {\n    mut comments := parse.leading(mut p)\n    doc := parse.docs(mut p)\n    if parse.is_sym(p, \"..\") {\n      return parse.fail(\n        p,\n        \"a record type lists all its fields: `{ id: Int, .. }`, any record with at least these fields, is only a parameter's type or a type parameter's bound\",\n      )\n    }\n    name := parse.field_name(mut p)!\n    parse.expect_sym(mut p, \":\")!\n    ty := parse.type_expr(mut p)!\n    default := if parse.eat_sym(mut p, \"=\") {\n      Some(parse.expr(mut p)!)\n    } else {\n      None\n    }\n    comments += parse.trailing(mut p)\n    mut out.push(ast.Field { comments, doc, name, ty, default })\n    if !parse.eat_sym(mut p, \",\") {\n      break\n    }\n  }\n  parse.expect_sym(mut p, \"}\")!\n  Ok(out)\n}","old_text":"/// A record's fields, up to its `}`.\nfn fields(mut p: parse.Parser) -> Result[List[ast.Field], String] {\n  mut out := []\n  while !parse.is_sym(p, \"}\") {\n    mut comments := parse.leading(mut p)\n    doc := parse.docs(mut p)\n    name := parse.field_name(mut p)!\n    parse.expect_sym(mut p, \":\")!\n    ty := parse.type_expr(mut p)!\n    default := if parse.eat_sym(mut p, \"=\") {\n      Some(parse.expr(mut p)!)\n    } else {\n      None\n    }\n    comments += parse.trailing(mut p)\n    mut out.push(ast.Field { comments, doc, name, ty, default })\n    if !parse.eat_sym(mut p, \",\") {\n      break\n    }\n  }\n  parse.expect_sym(mut p, \"}\")!\n  Ok(out)\n}"}]}
{"id":"1e2ec813df5936f7","time":1795709399,"message":"edit","changes":[{"name":"desugar.row_errors","kind":"fn","old":"97dc3de3e2e527db","new":"63ae302180ff3f03","interface_changed":false,"affected":[],"module":"desugar","text":"/// A structural type anywhere but as a bound: it has no values of its own,\n/// so it can't be a variable's, a field's or a result's type.\nfn row_errors(d: ast.Decl) -> List[String] {\n  all := walk.decl_types(d).filter(t -> t is ast.RowType)\n  // (a bound's rows are listed at its top; the fields' types after them)\n  bound := match d.kind {\n    ast.FnDef(f) => desugar.bound_rows(f.bounds),\n    ast.ImplDef(im) => desugar.bound_rows(im.bounds)\n      + fold(\n        im.methods.map(f -> desugar.bound_rows(f.bounds)),\n        0,\n        (a, b) -> a + b,\n      ),\n    ast.TraitDef(t) => fold(\n      t.methods.map(m -> desugar.bound_rows(m.decl.bounds)),\n      0,\n      (a, b) -> a + b,\n    ),\n    _ => 0,\n  }\n  if len(all) > bound {\n    [\n      \"a structural type (`{ id: Int, .. }`) is only a parameter's type or a type parameter's bound: it has no values of its own, so it is no result's, variable's or field's type (name a type parameter: `[T: { id: Int, .. }]`, `-> T`)\",\n    ]\n  } else {\n    []\n  }\n}","old_text":"/// A structural type anywhere but as a bound: it has no values of its own,\n/// so it can't be a variable's, a field's or a result's type.\nfn row_errors(d: ast.Decl) -> List[String] {\n  all := walk.decl_types(d).filter(t -> t is ast.RowType)\n  // (a bound's rows are listed at its top; the fields' types after them)\n  bound := match d.kind {\n    ast.FnDef(f) => desugar.bound_rows(f.bounds),\n    ast.ImplDef(im) => desugar.bound_rows(im.bounds)\n      + fold(\n        im.methods.map(f -> desugar.bound_rows(f.bounds)),\n        0,\n        (a, b) -> a + b,\n      ),\n    ast.TraitDef(t) => fold(\n      t.methods.map(m -> desugar.bound_rows(m.decl.bounds)),\n      0,\n      (a, b) -> a + b,\n    ),\n    _ => 0,\n  }\n  if len(all) > bound {\n    [\n      \"a structural type (`{ id: Int, .. }`) is only a parameter's type or a type parameter's bound (`[T: { id: Int, .. }]`): it has no values of its own, so a result, a variable or a field can't be one (use a type parameter: `-> T`), and its fields can't be one either\",\n    ]\n  } else {\n    []\n  }\n}"}]}
{"id":"e9791de8af4c033f","time":1795709734,"message":"edit","changes":[{"name":"check.infer_method","kind":"fn","old":"88c143c2c71080cf","new":"5a5245e9619b8336","interface_changed":false,"affected":[],"module":"check","text":"/// A call `recv.m(args)`: a method of the receiver's type, or one of the\n/// program's functions or a built-in with the receiver as its first\n/// argument. Other calls (std's methods, closures) are not modelled.\n/// `marked`: written `mut recv.m(..)`.\nfn infer_method(\n  mut i: check.Inf,\n  recv: ast.Expr,\n  m: String,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n  marked: Bool,\n) -> check.Ty {\n  // `Item.new(..)`, `T.zero()`: a method called on a type\n  match recv {\n    ast.CtorExpr { name: tn, args: ast.NoArgs } => if contains(i.types.named, tn)\n      || contains(i.tparams, tn)\n      || [\"Int\", \"Float\", \"Bool\", \"String\"].contains(tn) {\n      mut i.recvs.push((m, check.TNamed { name: tn, args: [] }))\n      return check.static_call(mut i, tn, m, args, env)\n    },\n    // a type with its arguments as the receiver, as `derive` writes it:\n    // `{ $type: List[Int] := (); $type }.from_json_at(..)`\n    ast.Block { stmts: [ast.Let { pat: ast.Bind(\"$type\"), ty: Some(t), value: ast.UnitExpr }], last: ast.Var(\"$type\") } => return check.static_call(mut i, check.type_head(t), m, args, env),\n    _ => (),\n  }\n  rt := check.infer(mut i, recv, env, None)\n  mut i.recvs.push((m, rt))\n  // two traits with `m`, and nothing to choose between them\n  match check.ambiguity(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `s.bigger(t)` with `bigger(self, other: Self)` on a trait value\n  check.self_args(mut i, recv, check.res(i, rt), m, args)\n  // a code trait's method on a type that isn't one (`fold` of an iterator\n  // that may not end), or whose `impl` asks more of its arguments\n  match check.code_method_problem(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `xs.to_list()` of what is a list already (`s.code_points()`, a\n  // comprehension over one) is itself\n  match check.res(i, rt) {\n    check.TList(_) => if m == \"to_list\" && len(args) == 0 {\n      return rt\n    },\n    _ => (),\n  }\n  own := match check.res(i, rt) {\n    // a generic `impl`'s parameters are the receiver's type arguments\n    check.TNamed { name, args } => match get(i.methods.of, name + \".\" + m) {\n      Some(t) => Some(check.inst(\n        t,\n        check.pairs(\n          get(i.methods.params, name + \".\" + m) ?? [],\n          args,\n        ),\n      )),\n      None => match check.code_trait_method(i, name, m, check.res(i, rt)) {\n        Some(t) => Some(t),\n        // a method a trait it implements provides (`to_json` of a type deriving\n        // `Json`)\n        None => check.provided_method(i, name, m, check.res(i, rt)),\n      },\n    },\n    // `xs.iter()`: a list's method of core's code traits\n    check.TList(_) => check.code_trait_method(i, \"List\", m, check.res(i, rt)),\n    // `s.bytes()`, `s.graphemes()`: a string's methods of code traits\n    check.TStr => check.string_method(i, m),\n    // `x.m()` with `x: T` and `T: Tr`: the trait's method, `Self` being `T`\n    check.TGen(p) => check.bound_method(i, p, m),\n    // a trait value: the trait's method\n    check.TTrait(tr) => check.trait_method(i, tr, m, check.TTrait(tr), 8),\n    _ => None,\n  }\n  // a method of one of the program's types that changes its receiver\n  // (`mut self`) is called `mut recv.m(..)`, and only such a method is\n  // called so\n  match check.res(i, rt) {\n    check.TNamed { name, .. } => if check.program_type(i, name)\n      && contains(i.methods.self_methods, name + \".\" + m) {\n      changes := contains(i.methods.mut_self, name + \".\" + m)\n      shown := text.expr_text(recv, 0)\n      if changes && !marked {\n        check.error(mut i, \"`\"\n          + m\n          + \"` changes its receiver (`mut self`): write `mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)` to show that `\"\n          + shown\n          + \"` may change\")\n      } else if marked && !changes {\n        check.error(mut i, \"`mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)`: `\"\n          + m\n          + \"` doesn't change its receiver (it doesn't take `mut self`)\")\n      }\n    },\n    _ => (),\n  }\n  // `.to_list()` of what the checker types as a list (a comprehension or a\n  // built-in over a string's code points) is the list\n  if m == \"to_list\"\n    && len(args) == 0\n    && check.res(i, rt) is check.TList {\n    return check.res(i, rt)\n  }\n  // `x.f(..)` with `f` a built-in function is `f(x, ..)`, on a list even\n  // when a trait has a method of that name (`xs.map(f)`)\n  if own is None\n    && check.known(check.res(i, rt))\n    && !contains(env, m)\n    && (!contains(i.methods.names, m)\n      || check.res(i, rt) is check.TList\n      || check.is_table(check.res(i, rt)))\n    && get(i.fns, m) is None {\n    match get(i.builtins, m) {\n      Some(bs) => {\n        check.changing_call(mut i, recv, m, bs, marked)\n        return check.builtin_call(mut i, m, bs, [rt], args, env)\n      },\n      None => (),\n    }\n  }\n  sig := match own {\n    Some(t) => Some(t),\n    // a receiver of a type not known may have a method of that name, such as\n    // one of std's types\n    None => if !check.known(check.res(i, rt))\n      || contains(env, m)\n      || contains(i.methods.names, m)\n      || contains(i.builtins, m) {\n      None\n    } else {\n      get(i.fns, m)\n    },\n  }\n  match sig {\n    Some(t) => {\n      vars := check.fresh_for(mut i, to_list(check.gens(t, Set[String] {})))\n      ft := check.inst(t, vars)\n      match ft {\n        check.TFn { params, ret } => {\n          what := \"call to `\" + m + \"`\"\n          if len(params) != len(args) + 1 {\n            check.error(mut i, what\n              + \": expects \"\n              + to_string(len(params))\n              + \" arguments, got \"\n              + to_string(len(args) + 1))\n            return ret\n          }\n          check.expect(\n            mut i,\n            get(params, 0) ?? check.TAny,\n            rt,\n            what + \", argument 1\",\n          )\n          for (k, a) in enumerate(args) {\n            p := get(params, k + 1) ?? check.TAny\n            at := check.listed_arg(\n              mut i,\n              m,\n              k,\n              a,\n              p,\n              check.infer(mut i, a, env, Some(p)),\n              what,\n            )\n            check.expect(\n              mut i,\n              p,\n              at,\n              what + \", argument \" + to_string(k + 2),\n            )\n          }\n          // a type's own method with structural bounds: each one met\n          match (own, check.res(i, rt)) {\n            (Some(_), check.TNamed { name, .. }) => match get(i.methods.rows, name + \".\" + m) {\n              Some(rs) => {\n                for (p, fs) in rs {\n                  check.row_met(\n                    mut i,\n                    name + \".\" + m,\n                    fs,\n                    vars,\n                    get(vars, p) ?? check.TAny,\n                  )\n                }\n              },\n              None => (),\n            },\n            _ => (),\n          }\n          ret\n        },\n        _ => check.TAny,\n      }\n    },\n    None => {\n      // a method no `impl`, trait or function has, on one of the program's\n      // types the checker sees every method of\n      match check.res(i, rt) {\n        check.TNamed { name, .. } => if check.program_type(i, name)\n          && !contains(i.methods.foreign, name)\n          && !contains(env, m)\n          && !contains(i.methods.names, m)\n          && get(i.fns, m) is None\n          && get(i.builtins, m) is None {\n          check.error(mut i, \"unknown function `\" + m + \"`\")\n        },\n        _ => (),\n      }\n      // `true.price()`: a method of one of the file's traits, on a value of a\n      // basic or program type, which must implement it\n      match check.res(i, rt) {\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TNamed { .. } => if !contains(env, m) {\n          match check.own_trait_of(i, m) {\n            Some(tr) => mut i.pending.push((rt, tr, m)),\n            None => (),\n          }\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}","old_text":"/// A call `recv.m(args)`: a method of the receiver's type, or one of the\n/// program's functions or a built-in with the receiver as its first\n/// argument. Other calls (std's methods, closures) are not modelled.\n/// `marked`: written `mut recv.m(..)`.\nfn infer_method(\n  mut i: check.Inf,\n  recv: ast.Expr,\n  m: String,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n  marked: Bool,\n) -> check.Ty {\n  // `Item.new(..)`, `T.zero()`: a method called on a type\n  match recv {\n    ast.CtorExpr { name: tn, args: ast.NoArgs } => if contains(i.types.named, tn)\n      || contains(i.tparams, tn)\n      || [\"Int\", \"Float\", \"Bool\", \"String\"].contains(tn) {\n      mut i.recvs.push((m, check.TNamed { name: tn, args: [] }))\n      return check.static_call(mut i, tn, m, args, env)\n    },\n    // a type with its arguments as the receiver, as `derive` writes it:\n    // `{ $type: List[Int] := (); $type }.from_json_at(..)`\n    ast.Block { stmts: [ast.Let { pat: ast.Bind(\"$type\"), ty: Some(t), value: ast.UnitExpr }], last: ast.Var(\"$type\") } => return check.static_call(mut i, check.type_head(t), m, args, env),\n    _ => (),\n  }\n  rt := check.infer(mut i, recv, env, None)\n  mut i.recvs.push((m, rt))\n  // two traits with `m`, and nothing to choose between them\n  match check.ambiguity(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `s.bigger(t)` with `bigger(self, other: Self)` on a trait value\n  check.self_args(mut i, recv, check.res(i, rt), m, args)\n  // a code trait's method on a type that isn't one (`fold` of an iterator\n  // that may not end), or whose `impl` asks more of its arguments\n  match check.code_method_problem(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `xs.to_list()` of what is a list already (`s.code_points()`, a\n  // comprehension over one) is itself\n  match check.res(i, rt) {\n    check.TList(_) => if m == \"to_list\" && len(args) == 0 {\n      return rt\n    },\n    _ => (),\n  }\n  own := match check.res(i, rt) {\n    // a generic `impl`'s parameters are the receiver's type arguments\n    check.TNamed { name, args } => match get(i.methods.of, name + \".\" + m) {\n      Some(t) => Some(check.inst(\n        t,\n        check.pairs(\n          get(i.methods.params, name + \".\" + m) ?? [],\n          args,\n        ),\n      )),\n      None => match check.code_trait_method(i, name, m, check.res(i, rt)) {\n        Some(t) => Some(t),\n        // a method a trait it implements provides (`to_json` of a type deriving\n        // `Json`)\n        None => check.provided_method(i, name, m, check.res(i, rt)),\n      },\n    },\n    // `xs.iter()`: a list's method of core's code traits\n    check.TList(_) => check.code_trait_method(i, \"List\", m, check.res(i, rt)),\n    // `s.bytes()`, `s.graphemes()`: a string's methods of code traits\n    check.TStr => check.string_method(i, m),\n    // `x.m()` with `x: T` and `T: Tr`: the trait's method, `Self` being `T`\n    check.TGen(p) => check.bound_method(i, p, m),\n    // a trait value: the trait's method\n    check.TTrait(tr) => check.trait_method(i, tr, m, check.TTrait(tr), 8),\n    _ => None,\n  }\n  // a method of one of the program's types that changes its receiver\n  // (`mut self`) is called `mut recv.m(..)`, and only such a method is\n  // called so\n  match check.res(i, rt) {\n    check.TNamed { name, .. } => if check.program_type(i, name)\n      && contains(i.methods.self_methods, name + \".\" + m) {\n      changes := contains(i.methods.mut_self, name + \".\" + m)\n      shown := text.expr_text(recv, 0)\n      if changes && !marked {\n        check.error(mut i, \"`\"\n          + m\n          + \"` changes its receiver (`mut self`): write `mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)` to show that `\"\n          + shown\n          + \"` may change\")\n      } else if marked && !changes {\n        check.error(mut i, \"`mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)`: `\"\n          + m\n          + \"` doesn't change its receiver (it doesn't take `mut self`)\")\n      }\n    },\n    _ => (),\n  }\n  // `.to_list()` of what the checker types as a list (a comprehension or a\n  // built-in over a string's code points) is the list\n  if m == \"to_list\"\n    && len(args) == 0\n    && check.res(i, rt) is check.TList {\n    return check.res(i, rt)\n  }\n  // `x.f(..)` with `f` a built-in function is `f(x, ..)`, on a list even\n  // when a trait has a method of that name (`xs.map(f)`)\n  if own is None\n    && check.known(check.res(i, rt))\n    && !contains(env, m)\n    && (!contains(i.methods.names, m)\n      || check.res(i, rt) is check.TList\n      || check.is_table(check.res(i, rt)))\n    && get(i.fns, m) is None {\n    match get(i.builtins, m) {\n      Some(bs) => {\n        check.changing_call(mut i, recv, m, bs, marked)\n        return check.builtin_call(mut i, m, bs, [rt], args, env)\n      },\n      None => (),\n    }\n  }\n  sig := match own {\n    Some(t) => Some(t),\n    // a receiver of a type not known may have a method of that name, such as\n    // one of std's types\n    None => if !check.known(check.res(i, rt))\n      || contains(env, m)\n      || contains(i.methods.names, m)\n      || contains(i.builtins, m) {\n      None\n    } else {\n      get(i.fns, m)\n    },\n  }\n  match sig {\n    Some(t) => {\n      ft := check.inst(\n        t,\n        check.fresh_for(\n          mut i,\n          to_list(check.gens(t, Set[String] {})),\n        ),\n      )\n      match ft {\n        check.TFn { params, ret } => {\n          what := \"call to `\" + m + \"`\"\n          if len(params) != len(args) + 1 {\n            check.error(mut i, what\n              + \": expects \"\n              + to_string(len(params))\n              + \" arguments, got \"\n              + to_string(len(args) + 1))\n            return ret\n          }\n          check.expect(\n            mut i,\n            get(params, 0) ?? check.TAny,\n            rt,\n            what + \", argument 1\",\n          )\n          for (k, a) in enumerate(args) {\n            p := get(params, k + 1) ?? check.TAny\n            at := check.listed_arg(\n              mut i,\n              m,\n              k,\n              a,\n              p,\n              check.infer(mut i, a, env, Some(p)),\n              what,\n            )\n            check.expect(\n              mut i,\n              p,\n              at,\n              what + \", argument \" + to_string(k + 2),\n            )\n          }\n          ret\n        },\n        _ => check.TAny,\n      }\n    },\n    None => {\n      // a method no `impl`, trait or function has, on one of the program's\n      // types the checker sees every method of\n      match check.res(i, rt) {\n        check.TNamed { name, .. } => if check.program_type(i, name)\n          && !contains(i.methods.foreign, name)\n          && !contains(env, m)\n          && !contains(i.methods.names, m)\n          && get(i.fns, m) is None\n          && get(i.builtins, m) is None {\n          check.error(mut i, \"unknown function `\" + m + \"`\")\n        },\n        _ => (),\n      }\n      // `true.price()`: a method of one of the file's traits, on a value of a\n      // basic or program type, which must implement it\n      match check.res(i, rt) {\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TNamed { .. } => if !contains(env, m) {\n          match check.own_trait_of(i, m) {\n            Some(tr) => mut i.pending.push((rt, tr, m)),\n            None => (),\n          }\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}"},{"name":"check.methods_of","kind":"fn","old":"a37deb4ee62da903","new":"c9ab7524e1e4472a","interface_changed":false,"affected":[],"module":"check","text":"/// The program's methods: `impl`s without type parameters, on a type\n/// modelled without type parameters.\nfn methods_of(decls: List[ast.Decl], types: check.Types) -> check.Methods {\n  mut supers := Dict[String, List[String]] {}\n  mut pairs_seen := []\n  mut declared := Set[String] {}\n  mut of := Dict[String, check.Ty] {}\n  mut names := Set[String] {}\n  mut names_other := Set[String] {}\n  mut own_recv := Dict[String, Bool] {}\n  mut trait_recv := Dict[String, Bool] {}\n  mut mut_params := Dict[String, List[check.Ty]] {}\n  mut params := Dict[String, List[String]] {}\n  mut traits := Dict[String, check.Ty] {}\n  mut impls := Set[String] {}\n  mut checked := Set[String] {}\n  mut blanket := Set[String] {}\n  mut bounds := Dict[String, List[(String, String)]] {}\n  mut own_methods := Set[String] {}\n  mut impl_bounds := Dict[String, List[(Int, String)]] {}\n  mut trait_tparams := Dict[String, List[String]] {}\n  mut impl_args := Dict[String, (List[check.Ty], List[String])] {}\n  mut trait_params := Dict[String, List[String]] {}\n  mut spread_params := Dict[String, List[ast.Param]] {}\n  mut rows := Dict[String, Dict[String, List[(String, check.Ty, ast.TypeExpr)]]] {}\n  for d in decls {\n    match d.kind {\n      ast.ImplDef(im) => {\n        head := check.type_head(im.for_type)\n        // core's code's types, like `KeyPath`, are named bare everywhere: an\n        // `impl` of another module's on one is on that type\n        q := if contains(head, \".\")\n          || check.core_code_type(types, head)\n            && !contains(types.named, check.qualified(d.module, head)) {\n          head\n        } else {\n          check.qualified(d.module, head)\n        }\n        if im.trait_name != \"\" {\n          mut impls.insert(im.trait_name + \" for \" + q)\n          if im.trait_args != [] {\n            itps := set(im.type_params)\n            mut impl_args.insert(\n              im.trait_name + \" for \" + q,\n              (\n                im.trait_args.map(a -> check.lower(types, itps, a)),\n                match im.for_type {\n                  ast.Named { args: targs, .. } => targs.map(a -> check.type_head(a)),\n                  _ => [],\n                },\n              ),\n            )\n          }\n          // the bounds on the type's arguments, by their position\n          match im.for_type {\n            ast.Named { args: targs, .. } => {\n              mut bs := []\n              for (k, a) in enumerate(targs) {\n                for b in im.bounds {\n                  if check.type_head(a) == b.param {\n                    for tr in b.traits {\n                      mut bs.push((k, check.type_head(tr)))\n                    }\n                  }\n                }\n              }\n              if bs != [] {\n                mut impl_bounds.insert(im.trait_name + \" for \" + q, bs)\n              }\n            },\n            _ => (),\n          }\n          mut pairs_seen.push((im.trait_name, q))\n          // `impl[T] Tr for T`: every type\n          if im.type_params.contains(head) {\n            mut blanket.insert(im.trait_name)\n          }\n        }\n        // a generic `impl` on its type's own parameters, in order\n        own_params := match im.for_type {\n          ast.Named { args, .. } => args.map(a -> check.type_head(a)) == im.type_params,\n          _ => false,\n        }\n        usable := get(types.named, q) ?? [\"?\"] == im.type_params\n          && (len(im.type_params) == 0 || own_params)\n        for f in im.methods {\n          mut names.insert(f.name)\n          mut spread_params.insert(q + \".\" + f.name, f.params)\n          if im.trait_name == \"\" {\n            mut names_other.insert(f.name)\n            mut own_methods.insert(q + \".\" + f.name)\n          }\n          if usable {\n            g := check.method_of(f, im.for_type)\n            tps := set(im.type_params + g.type_params)\n            key := q + \".\" + f.name\n            mut of.insert(\n              key,\n              check.TFn {\n                params: g.params.map(p -> check.param_type(types, tps, p)),\n                ret: check.lower(types, tps, g.ret),\n              },\n            )\n            mut params.insert(key, im.type_params)\n            fr := check.rows_by_param(types, tps, g.bounds)\n            if len(fr) > 0 {\n              mut rows.insert(key, fr)\n            }\n            // whether it takes `mut self`; a type's own method comes before a trait's\n            // of the same name, as calls find them\n            match get(f.params, 0) {\n              Some(sp) => if sp.name == \"self\" {\n                if im.trait_name == \"\" {\n                  mut own_recv.insert(key, sp.mutable)\n                } else {\n                  mut trait_recv.insert(key, sp.mutable)\n                }\n              },\n              None => (),\n            }\n          }\n        }\n      },\n      ast.TraitDef(t) => {\n        mut declared.insert(t.name)\n        mut supers.insert(t.name, t.supers.map(x -> check.type_head(x)))\n        mut trait_tparams.insert(t.name, t.params)\n        if t.derivable is None && !t.capability && len(t.params) == 0 {\n          mut checked.insert(t.name)\n        }\n        for tm in t.methods {\n          mut names.insert(tm.decl.name)\n          tps := set([\"Self\"] + t.params + tm.decl.type_params)\n          mut trait_params.insert(\n            t.name + \".\" + tm.decl.name,\n            tm.decl.params.map(p -> p.name),\n          )\n          mut spread_params.insert(\n            t.name + \".\" + tm.decl.name,\n            tm.decl.params,\n          )\n          mut spread_params.insert(\n            check.qualified(d.module, t.name) + \".\" + tm.decl.name,\n            tm.decl.params,\n          )\n          mut traits.insert(\n            t.name + \".\" + tm.decl.name,\n            check.TFn {\n              params: tm.decl.params.map(\n                p -> check.param_type(types, tps, p),\n              ),\n              ret: check.lower(types, tps, tm.decl.ret),\n            },\n          )\n        }\n      },\n      ast.FnDef(f) => {\n        mut spread_params.insert(\n          check.qualified(d.module, f.name),\n          f.params,\n        )\n        mut bs := []\n        for b in f.bounds {\n          for tr in b.traits {\n            if !(tr is ast.RowType) {\n              mut bs.push((b.param, check.type_head(tr)))\n            }\n          }\n        }\n        fr := check.rows_by_param(types, set(f.type_params), f.bounds)\n        if len(fr) > 0 {\n          mut rows.insert(check.qualified(d.module, f.name), fr)\n        }\n        mut bounds.insert(check.qualified(d.module, f.name), bs)\n        mut mut_params.insert(\n          check.qualified(d.module, f.name),\n          f.params.map(\n            p -> if p.mutable && len(f.type_params) == 0 {\n              check.lower(types, Set[String] {}, p.ty)\n            } else {\n              check.TAny\n            },\n          ),\n        )\n      },\n      ast.ExternDef(x) => match x.item {\n        ast.ExternFn(f) => mut spread_params.insert(\n          check.qualified(d.module, f.name),\n          f.params,\n        ),\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  mut foreign := Set[String] {}\n  for tq in pairs_seen {\n    if !contains(declared, tq.0) {\n      mut foreign.insert(tq.1)\n    }\n  }\n  mut self_methods := Set[String] {}\n  mut mut_self := Set[String] {}\n  for key in keys(trait_recv) + keys(own_recv) {\n    mut self_methods.insert(key)\n    if get(own_recv, key) ?? get(trait_recv, key) ?? false {\n      mut mut_self.insert(key)\n    }\n  }\n  mut kept := Set[String] {}\n  for c in checked {\n    if !contains(blanket, c) {\n      mut kept.insert(c)\n    }\n  }\n  check.Methods {\n    of,\n    names,\n    params,\n    traits,\n    impls,\n    checked: kept,\n    bounds,\n    foreign,\n    code_traits: Set[String] {},\n    supers,\n    local: Set[String] {},\n    own_traits: Set[String] {},\n    names_other,\n    self_methods,\n    mut_self,\n    mut_params,\n    own_methods,\n    trait_params,\n    impl_bounds,\n    trait_tparams,\n    impl_args,\n    spread_params,\n    rows,\n  }\n}","old_text":"/// The program's methods: `impl`s without type parameters, on a type\n/// modelled without type parameters.\nfn methods_of(decls: List[ast.Decl], types: check.Types) -> check.Methods {\n  mut supers := Dict[String, List[String]] {}\n  mut pairs_seen := []\n  mut declared := Set[String] {}\n  mut of := Dict[String, check.Ty] {}\n  mut names := Set[String] {}\n  mut names_other := Set[String] {}\n  mut own_recv := Dict[String, Bool] {}\n  mut trait_recv := Dict[String, Bool] {}\n  mut mut_params := Dict[String, List[check.Ty]] {}\n  mut params := Dict[String, List[String]] {}\n  mut traits := Dict[String, check.Ty] {}\n  mut impls := Set[String] {}\n  mut checked := Set[String] {}\n  mut blanket := Set[String] {}\n  mut bounds := Dict[String, List[(String, String)]] {}\n  mut own_methods := Set[String] {}\n  mut impl_bounds := Dict[String, List[(Int, String)]] {}\n  mut trait_tparams := Dict[String, List[String]] {}\n  mut impl_args := Dict[String, (List[check.Ty], List[String])] {}\n  mut trait_params := Dict[String, List[String]] {}\n  mut spread_params := Dict[String, List[ast.Param]] {}\n  mut rows := Dict[String, Dict[String, List[(String, check.Ty, ast.TypeExpr)]]] {}\n  for d in decls {\n    match d.kind {\n      ast.ImplDef(im) => {\n        head := check.type_head(im.for_type)\n        // core's code's types, like `KeyPath`, are named bare everywhere: an\n        // `impl` of another module's on one is on that type\n        q := if contains(head, \".\")\n          || check.core_code_type(types, head)\n            && !contains(types.named, check.qualified(d.module, head)) {\n          head\n        } else {\n          check.qualified(d.module, head)\n        }\n        if im.trait_name != \"\" {\n          mut impls.insert(im.trait_name + \" for \" + q)\n          if im.trait_args != [] {\n            itps := set(im.type_params)\n            mut impl_args.insert(\n              im.trait_name + \" for \" + q,\n              (\n                im.trait_args.map(a -> check.lower(types, itps, a)),\n                match im.for_type {\n                  ast.Named { args: targs, .. } => targs.map(a -> check.type_head(a)),\n                  _ => [],\n                },\n              ),\n            )\n          }\n          // the bounds on the type's arguments, by their position\n          match im.for_type {\n            ast.Named { args: targs, .. } => {\n              mut bs := []\n              for (k, a) in enumerate(targs) {\n                for b in im.bounds {\n                  if check.type_head(a) == b.param {\n                    for tr in b.traits {\n                      mut bs.push((k, check.type_head(tr)))\n                    }\n                  }\n                }\n              }\n              if bs != [] {\n                mut impl_bounds.insert(im.trait_name + \" for \" + q, bs)\n              }\n            },\n            _ => (),\n          }\n          mut pairs_seen.push((im.trait_name, q))\n          // `impl[T] Tr for T`: every type\n          if im.type_params.contains(head) {\n            mut blanket.insert(im.trait_name)\n          }\n        }\n        // a generic `impl` on its type's own parameters, in order\n        own_params := match im.for_type {\n          ast.Named { args, .. } => args.map(a -> check.type_head(a)) == im.type_params,\n          _ => false,\n        }\n        usable := get(types.named, q) ?? [\"?\"] == im.type_params\n          && (len(im.type_params) == 0 || own_params)\n        for f in im.methods {\n          mut names.insert(f.name)\n          mut spread_params.insert(q + \".\" + f.name, f.params)\n          if im.trait_name == \"\" {\n            mut names_other.insert(f.name)\n            mut own_methods.insert(q + \".\" + f.name)\n          }\n          if usable {\n            g := check.method_of(f, im.for_type)\n            tps := set(im.type_params + g.type_params)\n            key := q + \".\" + f.name\n            mut of.insert(\n              key,\n              check.TFn {\n                params: g.params.map(p -> check.param_type(types, tps, p)),\n                ret: check.lower(types, tps, g.ret),\n              },\n            )\n            mut params.insert(key, im.type_params)\n            // whether it takes `mut self`; a type's own method comes before a trait's\n            // of the same name, as calls find them\n            match get(f.params, 0) {\n              Some(sp) => if sp.name == \"self\" {\n                if im.trait_name == \"\" {\n                  mut own_recv.insert(key, sp.mutable)\n                } else {\n                  mut trait_recv.insert(key, sp.mutable)\n                }\n              },\n              None => (),\n            }\n          }\n        }\n      },\n      ast.TraitDef(t) => {\n        mut declared.insert(t.name)\n        mut supers.insert(t.name, t.supers.map(x -> check.type_head(x)))\n        mut trait_tparams.insert(t.name, t.params)\n        if t.derivable is None && !t.capability && len(t.params) == 0 {\n          mut checked.insert(t.name)\n        }\n        for tm in t.methods {\n          mut names.insert(tm.decl.name)\n          tps := set([\"Self\"] + t.params + tm.decl.type_params)\n          mut trait_params.insert(\n            t.name + \".\" + tm.decl.name,\n            tm.decl.params.map(p -> p.name),\n          )\n          mut spread_params.insert(\n            t.name + \".\" + tm.decl.name,\n            tm.decl.params,\n          )\n          mut spread_params.insert(\n            check.qualified(d.module, t.name) + \".\" + tm.decl.name,\n            tm.decl.params,\n          )\n          mut traits.insert(\n            t.name + \".\" + tm.decl.name,\n            check.TFn {\n              params: tm.decl.params.map(\n                p -> check.param_type(types, tps, p),\n              ),\n              ret: check.lower(types, tps, tm.decl.ret),\n            },\n          )\n        }\n      },\n      ast.FnDef(f) => {\n        mut spread_params.insert(\n          check.qualified(d.module, f.name),\n          f.params,\n        )\n        mut bs := []\n        for b in f.bounds {\n          for tr in b.traits {\n            if !(tr is ast.RowType) {\n              mut bs.push((b.param, check.type_head(tr)))\n            }\n          }\n        }\n        fr := check.rows_by_param(types, set(f.type_params), f.bounds)\n        if len(fr) > 0 {\n          mut rows.insert(check.qualified(d.module, f.name), fr)\n        }\n        mut bounds.insert(check.qualified(d.module, f.name), bs)\n        mut mut_params.insert(\n          check.qualified(d.module, f.name),\n          f.params.map(\n            p -> if p.mutable && len(f.type_params) == 0 {\n              check.lower(types, Set[String] {}, p.ty)\n            } else {\n              check.TAny\n            },\n          ),\n        )\n      },\n      ast.ExternDef(x) => match x.item {\n        ast.ExternFn(f) => mut spread_params.insert(\n          check.qualified(d.module, f.name),\n          f.params,\n        ),\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  mut foreign := Set[String] {}\n  for tq in pairs_seen {\n    if !contains(declared, tq.0) {\n      mut foreign.insert(tq.1)\n    }\n  }\n  mut self_methods := Set[String] {}\n  mut mut_self := Set[String] {}\n  for key in keys(trait_recv) + keys(own_recv) {\n    mut self_methods.insert(key)\n    if get(own_recv, key) ?? get(trait_recv, key) ?? false {\n      mut mut_self.insert(key)\n    }\n  }\n  mut kept := Set[String] {}\n  for c in checked {\n    if !contains(blanket, c) {\n      mut kept.insert(c)\n    }\n  }\n  check.Methods {\n    of,\n    names,\n    params,\n    traits,\n    impls,\n    checked: kept,\n    bounds,\n    foreign,\n    code_traits: Set[String] {},\n    supers,\n    local: Set[String] {},\n    own_traits: Set[String] {},\n    names_other,\n    self_methods,\n    mut_self,\n    mut_params,\n    own_methods,\n    trait_params,\n    impl_bounds,\n    trait_tparams,\n    impl_args,\n    spread_params,\n    rows,\n  }\n}"}]}
{"id":"102174b8f20deb19","time":1795709902,"message":"edit","changes":[{"name":"check.infer_method","kind":"fn","old":"5a5245e9619b8336","new":"42bee23710491e7c","interface_changed":false,"affected":[],"module":"check","text":"/// A call `recv.m(args)`: a method of the receiver's type, or one of the\n/// program's functions or a built-in with the receiver as its first\n/// argument. Other calls (std's methods, closures) are not modelled.\n/// `marked`: written `mut recv.m(..)`.\nfn infer_method(\n  mut i: check.Inf,\n  recv: ast.Expr,\n  m: String,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n  marked: Bool,\n) -> check.Ty {\n  // `Item.new(..)`, `T.zero()`: a method called on a type\n  match recv {\n    ast.CtorExpr { name: tn, args: ast.NoArgs } => if contains(i.types.named, tn)\n      || contains(i.tparams, tn)\n      || [\"Int\", \"Float\", \"Bool\", \"String\"].contains(tn) {\n      mut i.recvs.push((m, check.TNamed { name: tn, args: [] }))\n      return check.static_call(mut i, tn, m, args, env)\n    },\n    // a type with its arguments as the receiver, as `derive` writes it:\n    // `{ $type: List[Int] := (); $type }.from_json_at(..)`\n    ast.Block { stmts: [ast.Let { pat: ast.Bind(\"$type\"), ty: Some(t), value: ast.UnitExpr }], last: ast.Var(\"$type\") } => return check.static_call(mut i, check.type_head(t), m, args, env),\n    _ => (),\n  }\n  rt := check.infer(mut i, recv, env, None)\n  mut i.recvs.push((m, rt))\n  // two traits with `m`, and nothing to choose between them\n  match check.ambiguity(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `s.bigger(t)` with `bigger(self, other: Self)` on a trait value\n  check.self_args(mut i, recv, check.res(i, rt), m, args)\n  // a code trait's method on a type that isn't one (`fold` of an iterator\n  // that may not end), or whose `impl` asks more of its arguments\n  match check.code_method_problem(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `xs.to_list()` of what is a list already (`s.code_points()`, a\n  // comprehension over one) is itself\n  match check.res(i, rt) {\n    check.TList(_) => if m == \"to_list\" && len(args) == 0 {\n      return rt\n    },\n    _ => (),\n  }\n  own := match check.res(i, rt) {\n    // a generic `impl`'s parameters are the receiver's type arguments\n    check.TNamed { name, args } => match get(i.methods.of, name + \".\" + m) {\n      Some(t) => Some(check.inst(\n        t,\n        check.pairs(\n          get(i.methods.params, name + \".\" + m) ?? [],\n          args,\n        ),\n      )),\n      None => match check.code_trait_method(i, name, m, check.res(i, rt)) {\n        Some(t) => Some(t),\n        // a method a trait it implements provides (`to_json` of a type deriving\n        // `Json`)\n        None => check.provided_method(i, name, m, check.res(i, rt)),\n      },\n    },\n    // `xs.iter()`: a list's method of core's code traits\n    check.TList(_) => check.code_trait_method(i, \"List\", m, check.res(i, rt)),\n    // `s.bytes()`, `s.graphemes()`: a string's methods of code traits\n    check.TStr => check.string_method(i, m),\n    // `x.m()` with `x: T` and `T: Tr`: the trait's method, `Self` being `T`\n    check.TGen(p) => check.bound_method(i, p, m),\n    // a trait value: the trait's method\n    check.TTrait(tr) => check.trait_method(i, tr, m, check.TTrait(tr), 8),\n    _ => None,\n  }\n  // a method of one of the program's types that changes its receiver\n  // (`mut self`) is called `mut recv.m(..)`, and only such a method is\n  // called so\n  match check.res(i, rt) {\n    check.TNamed { name, .. } => if check.program_type(i, name)\n      && contains(i.methods.self_methods, name + \".\" + m) {\n      changes := contains(i.methods.mut_self, name + \".\" + m)\n      shown := text.expr_text(recv, 0)\n      if changes && !marked {\n        check.error(mut i, \"`\"\n          + m\n          + \"` changes its receiver (`mut self`): write `mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)` to show that `\"\n          + shown\n          + \"` may change\")\n      } else if marked && !changes {\n        check.error(mut i, \"`mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)`: `\"\n          + m\n          + \"` doesn't change its receiver (it doesn't take `mut self`)\")\n      }\n    },\n    _ => (),\n  }\n  // `.to_list()` of what the checker types as a list (a comprehension or a\n  // built-in over a string's code points) is the list\n  if m == \"to_list\"\n    && len(args) == 0\n    && check.res(i, rt) is check.TList {\n    return check.res(i, rt)\n  }\n  // `x.f(..)` with `f` a built-in function is `f(x, ..)`, on a list even\n  // when a trait has a method of that name (`xs.map(f)`)\n  if own is None\n    && check.known(check.res(i, rt))\n    && !contains(env, m)\n    && (!contains(i.methods.names, m)\n      || check.res(i, rt) is check.TList\n      || check.is_table(check.res(i, rt)))\n    && get(i.fns, m) is None {\n    match get(i.builtins, m) {\n      Some(bs) => {\n        check.changing_call(mut i, recv, m, bs, marked)\n        return check.builtin_call(mut i, m, bs, [rt], args, env)\n      },\n      None => (),\n    }\n  }\n  sig := match own {\n    Some(t) => Some(t),\n    // a receiver of a type not known may have a method of that name, such as\n    // one of std's types\n    None => if !check.known(check.res(i, rt))\n      || contains(env, m)\n      || contains(i.methods.names, m)\n      || contains(i.builtins, m) {\n      None\n    } else {\n      get(i.fns, m)\n    },\n  }\n  match sig {\n    Some(t) => {\n      vars := check.fresh_for(mut i, to_list(check.gens(t, Set[String] {})))\n      ft := check.inst(t, vars)\n      match ft {\n        check.TFn { params, ret } => {\n          what := \"call to `\" + m + \"`\"\n          if len(params) != len(args) + 1 {\n            check.error(mut i, what\n              + \": expects \"\n              + to_string(len(params))\n              + \" arguments, got \"\n              + to_string(len(args) + 1))\n            return ret\n          }\n          check.expect(\n            mut i,\n            get(params, 0) ?? check.TAny,\n            rt,\n            what + \", argument 1\",\n          )\n          for (k, a) in enumerate(args) {\n            p := get(params, k + 1) ?? check.TAny\n            at := check.listed_arg(\n              mut i,\n              m,\n              k,\n              a,\n              p,\n              check.infer(mut i, a, env, Some(p)),\n              what,\n            )\n            check.expect(\n              mut i,\n              p,\n              at,\n              what + \", argument \" + to_string(k + 2),\n            )\n          }\n          // a type's own method with structural bounds: each one met\n          match (own, check.res(i, rt)) {\n            (Some(_), check.TNamed { name, .. }) => match get(i.methods.rows, name + \".\" + m) {\n              Some(rs) => {\n                for (p, fs) in rs {\n                  check.row_met(\n                    mut i,\n                    name + \".\" + m,\n                    fs,\n                    vars,\n                    get(vars, p) ?? check.TAny,\n                  )\n                }\n              },\n              None => check.error(mut i, \"DEBUG no rows \"\n                + name\n                + \".\"\n                + m\n                + \" in \"\n                + join(keys(i.methods.rows), \",\")),\n            },\n            _ => check.error(mut i, \"DEBUG other\"),\n          }\n          ret\n        },\n        _ => check.TAny,\n      }\n    },\n    None => {\n      // a method no `impl`, trait or function has, on one of the program's\n      // types the checker sees every method of\n      match check.res(i, rt) {\n        check.TNamed { name, .. } => if check.program_type(i, name)\n          && !contains(i.methods.foreign, name)\n          && !contains(env, m)\n          && !contains(i.methods.names, m)\n          && get(i.fns, m) is None\n          && get(i.builtins, m) is None {\n          check.error(mut i, \"unknown function `\" + m + \"`\")\n        },\n        _ => (),\n      }\n      // `true.price()`: a method of one of the file's traits, on a value of a\n      // basic or program type, which must implement it\n      match check.res(i, rt) {\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TNamed { .. } => if !contains(env, m) {\n          match check.own_trait_of(i, m) {\n            Some(tr) => mut i.pending.push((rt, tr, m)),\n            None => (),\n          }\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}","old_text":"/// A call `recv.m(args)`: a method of the receiver's type, or one of the\n/// program's functions or a built-in with the receiver as its first\n/// argument. Other calls (std's methods, closures) are not modelled.\n/// `marked`: written `mut recv.m(..)`.\nfn infer_method(\n  mut i: check.Inf,\n  recv: ast.Expr,\n  m: String,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n  marked: Bool,\n) -> check.Ty {\n  // `Item.new(..)`, `T.zero()`: a method called on a type\n  match recv {\n    ast.CtorExpr { name: tn, args: ast.NoArgs } => if contains(i.types.named, tn)\n      || contains(i.tparams, tn)\n      || [\"Int\", \"Float\", \"Bool\", \"String\"].contains(tn) {\n      mut i.recvs.push((m, check.TNamed { name: tn, args: [] }))\n      return check.static_call(mut i, tn, m, args, env)\n    },\n    // a type with its arguments as the receiver, as `derive` writes it:\n    // `{ $type: List[Int] := (); $type }.from_json_at(..)`\n    ast.Block { stmts: [ast.Let { pat: ast.Bind(\"$type\"), ty: Some(t), value: ast.UnitExpr }], last: ast.Var(\"$type\") } => return check.static_call(mut i, check.type_head(t), m, args, env),\n    _ => (),\n  }\n  rt := check.infer(mut i, recv, env, None)\n  mut i.recvs.push((m, rt))\n  // two traits with `m`, and nothing to choose between them\n  match check.ambiguity(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `s.bigger(t)` with `bigger(self, other: Self)` on a trait value\n  check.self_args(mut i, recv, check.res(i, rt), m, args)\n  // a code trait's method on a type that isn't one (`fold` of an iterator\n  // that may not end), or whose `impl` asks more of its arguments\n  match check.code_method_problem(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `xs.to_list()` of what is a list already (`s.code_points()`, a\n  // comprehension over one) is itself\n  match check.res(i, rt) {\n    check.TList(_) => if m == \"to_list\" && len(args) == 0 {\n      return rt\n    },\n    _ => (),\n  }\n  own := match check.res(i, rt) {\n    // a generic `impl`'s parameters are the receiver's type arguments\n    check.TNamed { name, args } => match get(i.methods.of, name + \".\" + m) {\n      Some(t) => Some(check.inst(\n        t,\n        check.pairs(\n          get(i.methods.params, name + \".\" + m) ?? [],\n          args,\n        ),\n      )),\n      None => match check.code_trait_method(i, name, m, check.res(i, rt)) {\n        Some(t) => Some(t),\n        // a method a trait it implements provides (`to_json` of a type deriving\n        // `Json`)\n        None => check.provided_method(i, name, m, check.res(i, rt)),\n      },\n    },\n    // `xs.iter()`: a list's method of core's code traits\n    check.TList(_) => check.code_trait_method(i, \"List\", m, check.res(i, rt)),\n    // `s.bytes()`, `s.graphemes()`: a string's methods of code traits\n    check.TStr => check.string_method(i, m),\n    // `x.m()` with `x: T` and `T: Tr`: the trait's method, `Self` being `T`\n    check.TGen(p) => check.bound_method(i, p, m),\n    // a trait value: the trait's method\n    check.TTrait(tr) => check.trait_method(i, tr, m, check.TTrait(tr), 8),\n    _ => None,\n  }\n  // a method of one of the program's types that changes its receiver\n  // (`mut self`) is called `mut recv.m(..)`, and only such a method is\n  // called so\n  match check.res(i, rt) {\n    check.TNamed { name, .. } => if check.program_type(i, name)\n      && contains(i.methods.self_methods, name + \".\" + m) {\n      changes := contains(i.methods.mut_self, name + \".\" + m)\n      shown := text.expr_text(recv, 0)\n      if changes && !marked {\n        check.error(mut i, \"`\"\n          + m\n          + \"` changes its receiver (`mut self`): write `mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)` to show that `\"\n          + shown\n          + \"` may change\")\n      } else if marked && !changes {\n        check.error(mut i, \"`mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)`: `\"\n          + m\n          + \"` doesn't change its receiver (it doesn't take `mut self`)\")\n      }\n    },\n    _ => (),\n  }\n  // `.to_list()` of what the checker types as a list (a comprehension or a\n  // built-in over a string's code points) is the list\n  if m == \"to_list\"\n    && len(args) == 0\n    && check.res(i, rt) is check.TList {\n    return check.res(i, rt)\n  }\n  // `x.f(..)` with `f` a built-in function is `f(x, ..)`, on a list even\n  // when a trait has a method of that name (`xs.map(f)`)\n  if own is None\n    && check.known(check.res(i, rt))\n    && !contains(env, m)\n    && (!contains(i.methods.names, m)\n      || check.res(i, rt) is check.TList\n      || check.is_table(check.res(i, rt)))\n    && get(i.fns, m) is None {\n    match get(i.builtins, m) {\n      Some(bs) => {\n        check.changing_call(mut i, recv, m, bs, marked)\n        return check.builtin_call(mut i, m, bs, [rt], args, env)\n      },\n      None => (),\n    }\n  }\n  sig := match own {\n    Some(t) => Some(t),\n    // a receiver of a type not known may have a method of that name, such as\n    // one of std's types\n    None => if !check.known(check.res(i, rt))\n      || contains(env, m)\n      || contains(i.methods.names, m)\n      || contains(i.builtins, m) {\n      None\n    } else {\n      get(i.fns, m)\n    },\n  }\n  match sig {\n    Some(t) => {\n      vars := check.fresh_for(mut i, to_list(check.gens(t, Set[String] {})))\n      ft := check.inst(t, vars)\n      match ft {\n        check.TFn { params, ret } => {\n          what := \"call to `\" + m + \"`\"\n          if len(params) != len(args) + 1 {\n            check.error(mut i, what\n              + \": expects \"\n              + to_string(len(params))\n              + \" arguments, got \"\n              + to_string(len(args) + 1))\n            return ret\n          }\n          check.expect(\n            mut i,\n            get(params, 0) ?? check.TAny,\n            rt,\n            what + \", argument 1\",\n          )\n          for (k, a) in enumerate(args) {\n            p := get(params, k + 1) ?? check.TAny\n            at := check.listed_arg(\n              mut i,\n              m,\n              k,\n              a,\n              p,\n              check.infer(mut i, a, env, Some(p)),\n              what,\n            )\n            check.expect(\n              mut i,\n              p,\n              at,\n              what + \", argument \" + to_string(k + 2),\n            )\n          }\n          // a type's own method with structural bounds: each one met\n          match (own, check.res(i, rt)) {\n            (Some(_), check.TNamed { name, .. }) => match get(i.methods.rows, name + \".\" + m) {\n              Some(rs) => {\n                for (p, fs) in rs {\n                  check.row_met(\n                    mut i,\n                    name + \".\" + m,\n                    fs,\n                    vars,\n                    get(vars, p) ?? check.TAny,\n                  )\n                }\n              },\n              None => (),\n            },\n            _ => (),\n          }\n          ret\n        },\n        _ => check.TAny,\n      }\n    },\n    None => {\n      // a method no `impl`, trait or function has, on one of the program's\n      // types the checker sees every method of\n      match check.res(i, rt) {\n        check.TNamed { name, .. } => if check.program_type(i, name)\n          && !contains(i.methods.foreign, name)\n          && !contains(env, m)\n          && !contains(i.methods.names, m)\n          && get(i.fns, m) is None\n          && get(i.builtins, m) is None {\n          check.error(mut i, \"unknown function `\" + m + \"`\")\n        },\n        _ => (),\n      }\n      // `true.price()`: a method of one of the file's traits, on a value of a\n      // basic or program type, which must implement it\n      match check.res(i, rt) {\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TNamed { .. } => if !contains(env, m) {\n          match check.own_trait_of(i, m) {\n            Some(tr) => mut i.pending.push((rt, tr, m)),\n            None => (),\n          }\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}"}]}
{"id":"f6efe605695f7eb3","time":1795709998,"message":"edit","changes":[{"name":"check.infer_call","kind":"fn","old":"e0a23c302e201d7d","new":"6d93c5295e3ab00c","interface_changed":false,"affected":[],"module":"check","text":"fn infer_call(\n  mut i: check.Inf,\n  callee: ast.Expr,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n) -> check.Ty {\n  // `remove(d, k)` stored as a method of a trait a module imports\n  // (`std.fs.remove`), on a list, dict or set: it is the built-in, which\n  // changes its argument, so it must be the method `mut d.remove(k)`\n  match (callee, args) {\n    (ast.Var(n), [first, ..]) => {\n      parts := split(n, \".\")\n      s := get(parts, len(parts) - 1) ?? n\n      if s != n\n        && builtins.changing(s)\n        && (first is ast.Var || first is ast.FieldOf) {\n        ft := check.res(i, check.infer(mut i, first, env, None))\n        if ft is check.TList || check.is_table(ft) {\n          check.error(mut i, \"`\"\n            + check.short_code(ast.Call { callee: ast.Var(s), args })\n            + \"`: `\"\n            + s\n            + \"` changes the list, dict or set it is called on: write `mut \"\n            + text.expr_text(first, 0)\n            + \".\"\n            + s\n            + \"(…)`\"\n            + check.new_value_hint(s))\n          check.infer_all(mut i, drop(args, 1), env)\n          return check.TAny\n        }\n      }\n    },\n    _ => (),\n  }\n  // a built-in function, unless a local or one of the program's\n  match callee {\n    ast.Var(n) => if !contains(env, n) && get(i.fns, n) is None {\n      match get(i.builtins, n) {\n        Some(bs) => {\n          // `take(it, 2)` on an iterator: the method of core's trait its type\n          // implements (`it.take(2)`). Only a variable or a constructor is looked\n          // at first, since inferring an expression twice would type its lambdas\n          // twice.\n          match args {\n            [first, ..rest] => if first is ast.Var || first is ast.CtorExpr {\n              match check.res(i, check.infer(mut i, first, env, None)) {\n                check.TNamed { name, .. } => if check.code_trait_method(i, name, n, check.TAny) is Some {\n                  return check.infer_method(\n                    mut i,\n                    first,\n                    n,\n                    rest,\n                    env,\n                    false,\n                  )\n                },\n                _ => (),\n              }\n            } else if first is ast.Call || first is ast.MethodCall {\n              // a call, as in `map(filter(it, f), g)` from a comprehension over an\n              // iterator: inferred once, then the method on what it gives, or the\n              // built-in given its type\n              t0 := check.listed_arg(\n                mut i,\n                n,\n                0,\n                first,\n                check.shown_as(n, check.TAny),\n                check.infer(mut i, first, env, None),\n                \"call to `\" + n + \"`\",\n              )\n              match check.iter_builtin(\n                mut i,\n                n,\n                check.res(i, t0),\n                rest,\n                env,\n              ) {\n                Some(t) => return t,\n                None => (),\n              }\n              match check.res(i, t0) {\n                check.TNamed { name, .. } => if check.code_trait_method(i, name, n, check.TAny) is Some {\n                  return check.infer_method(\n                    mut i,\n                    ast.Var(\"$first\"),\n                    n,\n                    rest,\n                    {\n                      mut copy := env\n                      mut copy.insert(\"$first\", t0)\n                      copy\n                    },\n                    false,\n                  )\n                },\n                _ => (),\n              }\n              return check.builtin_call(mut i, n, bs, [t0], rest, env)\n            },\n            [] => (),\n          }\n          // one that changes a list, dict or set is a method: `mut xs.push(x)`\n          if bs.any(b -> b.changes) {\n            check.error(mut i, \"`\"\n              + check.short_code(ast.Call { callee, args })\n              + \"`: `\"\n              + n\n              + \"` changes the \"\n              + \"list, dict or set it is called on: write `mut \"\n              + text.expr_text(\n                check.unmarked_arg(get(args, 0) ?? ast.UnitExpr),\n                0,\n              )\n              + \".\"\n              + n\n              + \"(…)`\"\n              + check.new_value_hint(n))\n            check.infer_all(mut i, args, env)\n            return check.TAny\n          }\n          // a built-in has no `mut` parameters\n          for a in args {\n            match a {\n              ast.MutExpr(x) => if !(x is ast.MethodCall) {\n                check.error(mut i, \"`\"\n                  + text.expr_text(a, 0)\n                  + \"`: `\"\n                  + n\n                  + \"` has no `mut` parameters\")\n              },\n              _ => (),\n            }\n          }\n          return check.builtin_call(mut i, n, bs, [], args, env)\n        },\n        None => (),\n      }\n    },\n    _ => (),\n  }\n  // one of the program's functions with bounds: its type parameters are\n  // kept, to check the bounds once the arguments are checked\n  (ct, vars, bounds) := match callee {\n    ast.Var(n) => if !contains(env, n)\n      && (len(get(i.methods.bounds, n) ?? []) > 0\n        || contains(i.methods.rows, n)) {\n      // (a type's own method as a function, `Shop.line(s, x)`, as\n      // `own_methods_resolved` writes `s.line(x)`)\n      match get(i.fns, n) ?? get(i.methods.of, n) ?? check.TAny {\n        check.TAny => (\n          check.infer(mut i, callee, env, None),\n          Dict[String, check.Ty] {},\n          [],\n        ),\n        t => {\n          m := check.fresh_for(\n            mut i,\n            to_list(check.gens(t, Set[String] {})),\n          )\n          (check.inst(t, m), m, get(i.methods.bounds, n) ?? [])\n        },\n      }\n    } else if !contains(env, n) && get(i.fns, n) is None {\n      // a method called as a function, `describe(x)`, is resolved by its\n      // argument; only a value of it is ambiguous\n      (\n        check.trait_fn_of(mut i, n, false),\n        Dict[String, check.Ty] {},\n        [],\n      )\n    } else {\n      (\n        check.infer(mut i, callee, env, None),\n        Dict[String, check.Ty] {},\n        [],\n      )\n    },\n    _ => (\n      check.infer(mut i, callee, env, None),\n      Dict[String, check.Ty] {},\n      [],\n    ),\n  }\n  what := match callee {\n    ast.Var(n) => \"call to `\" + n + \"`\",\n    _ => \"call\",\n  }\n  match check.res(i, ct) {\n    check.TFn { params, ret } => {\n      // a wrong number of arguments is reported by `expression_errors`\n      if len(params) == len(args) {\n        for (k, a) in enumerate(args) {\n          p := get(params, k) ?? check.TAny\n          at := check.listed_arg(\n            mut i,\n            check.n_of(callee),\n            k,\n            a,\n            p,\n            check.infer(mut i, a, env, Some(p)),\n            what,\n          )\n          check.expect(\n            mut i,\n            p,\n            at,\n            what + \", argument \" + to_string(k + 1),\n          )\n          // a `mut` parameter takes its exact type: the function can put any value\n          // of it into the caller's variable\n          mp := get(\n            get(i.methods.mut_params, check.n_of(callee)) ?? [],\n            k,\n          ) ?? check.TAny\n          if !(check.res(i, at) is check.TVariants)\n            && !(mp is check.TTrait)\n            && check.exact_differs(mp, check.res(i, at)) {\n            match (check.shown(mp), check.shown(check.res(i, at))) {\n              (Some(w), Some(g)) => check.error(mut i, what\n                + \", argument \"\n                + to_string(k + 1)\n                + \": expected exactly `\"\n                + w\n                + \"`, found `\"\n                + g\n                + \"` (the parameter is `mut`, so the function can put any `\"\n                + w\n                + \"` into the caller's variable)\"),\n              _ => (),\n            }\n          } else if check.mut_narrower(i, check.n_of(callee), k, a) is Some {\n            // nor a value the variable's own refinement rules out\n            match check.mut_narrower(i, check.n_of(callee), k, a) {\n              Some((x, vw, pw)) => check.error(mut i, what\n                + \", argument \"\n                + to_string(k + 1)\n                + \": `\"\n                + x\n                + \"` is declared `\"\n                + text.type_text(vw)\n                + \"`, but the `mut` parameter is `\"\n                + text.type_text(pw)\n                + \"`: the function could store a value `\"\n                + x\n                + \"` must never hold\"),\n              None => (),\n            }\n          } else if !(mp is check.TAny)\n            && len(check.gens(mp, Set[String] {})) == 0 {\n            // a variable whose type isn't known yet (`mut xs := []`) takes the\n            // parameter's\n            _ := check.unify(mut i, mp, at, 100)\n          }\n        }\n        // each bound: the type the parameter stands for implements the trait\n        for b in bounds {\n          if contains(i.methods.checked, b.1) {\n            // a type nothing has determined yet: an obligation, reported at the end\n            // if nothing does\n            match check.res(i, get(vars, b.0) ?? check.TAny) {\n              check.TVar(_) => mut i.pending.push(\n                (\n                  get(vars, b.0) ?? check.TAny,\n                  b.1,\n                  check.n_of(callee),\n                ),\n              ),\n              _ => (),\n            }\n            match check.shown(check.res(i, get(vars, b.0) ?? check.TAny)) {\n              Some(x) => if !check.implements(\n                i,\n                check.res(i, get(vars, b.0) ?? check.TAny),\n                b.1,\n              ) {\n                check.error(mut i, \"calling `\"\n                  + check.n_of(callee)\n                  + \"`: `\"\n                  + x\n                  + \"` does not implement `\"\n                  + b.1\n                  + \"`\")\n              },\n              None => (),\n            }\n          }\n        }\n      }\n      // each structural bound: the type the parameter stands for has the fields\n      match callee {\n        ast.Var(n) => if !contains(env, n) && len(params) == len(args) {\n          match get(i.methods.rows, n) {\n            Some(rs) => {\n              for (p, fs) in rs {\n                check.row_met(\n                  mut i,\n                  n,\n                  fs,\n                  vars,\n                  get(vars, p) ?? check.TAny,\n                )\n              }\n            },\n            None => (),\n          }\n        },\n        _ => (),\n      }\n      ret\n    },\n    // a value that is not a function (`n(2)` with `n: Int`)\n    other => {\n      match (callee, check.shown(other)) {\n        (ast.Var(_), Some(x)) => if !(other is check.TFn) {\n          check.error(\n            mut i,\n            what + \": `\" + x + \"` is not a function\",\n          )\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}","old_text":"fn infer_call(\n  mut i: check.Inf,\n  callee: ast.Expr,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n) -> check.Ty {\n  // `remove(d, k)` stored as a method of a trait a module imports\n  // (`std.fs.remove`), on a list, dict or set: it is the built-in, which\n  // changes its argument, so it must be the method `mut d.remove(k)`\n  match (callee, args) {\n    (ast.Var(n), [first, ..]) => {\n      parts := split(n, \".\")\n      s := get(parts, len(parts) - 1) ?? n\n      if s != n\n        && builtins.changing(s)\n        && (first is ast.Var || first is ast.FieldOf) {\n        ft := check.res(i, check.infer(mut i, first, env, None))\n        if ft is check.TList || check.is_table(ft) {\n          check.error(mut i, \"`\"\n            + check.short_code(ast.Call { callee: ast.Var(s), args })\n            + \"`: `\"\n            + s\n            + \"` changes the list, dict or set it is called on: write `mut \"\n            + text.expr_text(first, 0)\n            + \".\"\n            + s\n            + \"(…)`\"\n            + check.new_value_hint(s))\n          check.infer_all(mut i, drop(args, 1), env)\n          return check.TAny\n        }\n      }\n    },\n    _ => (),\n  }\n  // a built-in function, unless a local or one of the program's\n  match callee {\n    ast.Var(n) => if !contains(env, n) && get(i.fns, n) is None {\n      match get(i.builtins, n) {\n        Some(bs) => {\n          // `take(it, 2)` on an iterator: the method of core's trait its type\n          // implements (`it.take(2)`). Only a variable or a constructor is looked\n          // at first, since inferring an expression twice would type its lambdas\n          // twice.\n          match args {\n            [first, ..rest] => if first is ast.Var || first is ast.CtorExpr {\n              match check.res(i, check.infer(mut i, first, env, None)) {\n                check.TNamed { name, .. } => if check.code_trait_method(i, name, n, check.TAny) is Some {\n                  return check.infer_method(\n                    mut i,\n                    first,\n                    n,\n                    rest,\n                    env,\n                    false,\n                  )\n                },\n                _ => (),\n              }\n            } else if first is ast.Call || first is ast.MethodCall {\n              // a call, as in `map(filter(it, f), g)` from a comprehension over an\n              // iterator: inferred once, then the method on what it gives, or the\n              // built-in given its type\n              t0 := check.listed_arg(\n                mut i,\n                n,\n                0,\n                first,\n                check.shown_as(n, check.TAny),\n                check.infer(mut i, first, env, None),\n                \"call to `\" + n + \"`\",\n              )\n              match check.iter_builtin(\n                mut i,\n                n,\n                check.res(i, t0),\n                rest,\n                env,\n              ) {\n                Some(t) => return t,\n                None => (),\n              }\n              match check.res(i, t0) {\n                check.TNamed { name, .. } => if check.code_trait_method(i, name, n, check.TAny) is Some {\n                  return check.infer_method(\n                    mut i,\n                    ast.Var(\"$first\"),\n                    n,\n                    rest,\n                    {\n                      mut copy := env\n                      mut copy.insert(\"$first\", t0)\n                      copy\n                    },\n                    false,\n                  )\n                },\n                _ => (),\n              }\n              return check.builtin_call(mut i, n, bs, [t0], rest, env)\n            },\n            [] => (),\n          }\n          // one that changes a list, dict or set is a method: `mut xs.push(x)`\n          if bs.any(b -> b.changes) {\n            check.error(mut i, \"`\"\n              + check.short_code(ast.Call { callee, args })\n              + \"`: `\"\n              + n\n              + \"` changes the \"\n              + \"list, dict or set it is called on: write `mut \"\n              + text.expr_text(\n                check.unmarked_arg(get(args, 0) ?? ast.UnitExpr),\n                0,\n              )\n              + \".\"\n              + n\n              + \"(…)`\"\n              + check.new_value_hint(n))\n            check.infer_all(mut i, args, env)\n            return check.TAny\n          }\n          // a built-in has no `mut` parameters\n          for a in args {\n            match a {\n              ast.MutExpr(x) => if !(x is ast.MethodCall) {\n                check.error(mut i, \"`\"\n                  + text.expr_text(a, 0)\n                  + \"`: `\"\n                  + n\n                  + \"` has no `mut` parameters\")\n              },\n              _ => (),\n            }\n          }\n          return check.builtin_call(mut i, n, bs, [], args, env)\n        },\n        None => (),\n      }\n    },\n    _ => (),\n  }\n  // one of the program's functions with bounds: its type parameters are\n  // kept, to check the bounds once the arguments are checked\n  (ct, vars, bounds) := match callee {\n    ast.Var(n) => if !contains(env, n)\n      && (len(get(i.methods.bounds, n) ?? []) > 0\n        || contains(i.methods.rows, n)) {\n      match get(i.fns, n) {\n        Some(t) => {\n          m := check.fresh_for(\n            mut i,\n            to_list(check.gens(t, Set[String] {})),\n          )\n          (check.inst(t, m), m, get(i.methods.bounds, n) ?? [])\n        },\n        None => (\n          check.infer(mut i, callee, env, None),\n          Dict[String, check.Ty] {},\n          [],\n        ),\n      }\n    } else if !contains(env, n) && get(i.fns, n) is None {\n      // a method called as a function, `describe(x)`, is resolved by its\n      // argument; only a value of it is ambiguous\n      (\n        check.trait_fn_of(mut i, n, false),\n        Dict[String, check.Ty] {},\n        [],\n      )\n    } else {\n      (\n        check.infer(mut i, callee, env, None),\n        Dict[String, check.Ty] {},\n        [],\n      )\n    },\n    _ => (\n      check.infer(mut i, callee, env, None),\n      Dict[String, check.Ty] {},\n      [],\n    ),\n  }\n  what := match callee {\n    ast.Var(n) => \"call to `\" + n + \"`\",\n    _ => \"call\",\n  }\n  match check.res(i, ct) {\n    check.TFn { params, ret } => {\n      // a wrong number of arguments is reported by `expression_errors`\n      if len(params) == len(args) {\n        for (k, a) in enumerate(args) {\n          p := get(params, k) ?? check.TAny\n          at := check.listed_arg(\n            mut i,\n            check.n_of(callee),\n            k,\n            a,\n            p,\n            check.infer(mut i, a, env, Some(p)),\n            what,\n          )\n          check.expect(\n            mut i,\n            p,\n            at,\n            what + \", argument \" + to_string(k + 1),\n          )\n          // a `mut` parameter takes its exact type: the function can put any value\n          // of it into the caller's variable\n          mp := get(\n            get(i.methods.mut_params, check.n_of(callee)) ?? [],\n            k,\n          ) ?? check.TAny\n          if !(check.res(i, at) is check.TVariants)\n            && !(mp is check.TTrait)\n            && check.exact_differs(mp, check.res(i, at)) {\n            match (check.shown(mp), check.shown(check.res(i, at))) {\n              (Some(w), Some(g)) => check.error(mut i, what\n                + \", argument \"\n                + to_string(k + 1)\n                + \": expected exactly `\"\n                + w\n                + \"`, found `\"\n                + g\n                + \"` (the parameter is `mut`, so the function can put any `\"\n                + w\n                + \"` into the caller's variable)\"),\n              _ => (),\n            }\n          } else if check.mut_narrower(i, check.n_of(callee), k, a) is Some {\n            // nor a value the variable's own refinement rules out\n            match check.mut_narrower(i, check.n_of(callee), k, a) {\n              Some((x, vw, pw)) => check.error(mut i, what\n                + \", argument \"\n                + to_string(k + 1)\n                + \": `\"\n                + x\n                + \"` is declared `\"\n                + text.type_text(vw)\n                + \"`, but the `mut` parameter is `\"\n                + text.type_text(pw)\n                + \"`: the function could store a value `\"\n                + x\n                + \"` must never hold\"),\n              None => (),\n            }\n          } else if !(mp is check.TAny)\n            && len(check.gens(mp, Set[String] {})) == 0 {\n            // a variable whose type isn't known yet (`mut xs := []`) takes the\n            // parameter's\n            _ := check.unify(mut i, mp, at, 100)\n          }\n        }\n        // each bound: the type the parameter stands for implements the trait\n        for b in bounds {\n          if contains(i.methods.checked, b.1) {\n            // a type nothing has determined yet: an obligation, reported at the end\n            // if nothing does\n            match check.res(i, get(vars, b.0) ?? check.TAny) {\n              check.TVar(_) => mut i.pending.push(\n                (\n                  get(vars, b.0) ?? check.TAny,\n                  b.1,\n                  check.n_of(callee),\n                ),\n              ),\n              _ => (),\n            }\n            match check.shown(check.res(i, get(vars, b.0) ?? check.TAny)) {\n              Some(x) => if !check.implements(\n                i,\n                check.res(i, get(vars, b.0) ?? check.TAny),\n                b.1,\n              ) {\n                check.error(mut i, \"calling `\"\n                  + check.n_of(callee)\n                  + \"`: `\"\n                  + x\n                  + \"` does not implement `\"\n                  + b.1\n                  + \"`\")\n              },\n              None => (),\n            }\n          }\n        }\n      }\n      // each structural bound: the type the parameter stands for has the fields\n      match callee {\n        ast.Var(n) => if !contains(env, n) && len(params) == len(args) {\n          match get(i.methods.rows, n) {\n            Some(rs) => {\n              for (p, fs) in rs {\n                check.row_met(\n                  mut i,\n                  n,\n                  fs,\n                  vars,\n                  get(vars, p) ?? check.TAny,\n                )\n              }\n            },\n            None => (),\n          }\n        },\n        _ => (),\n      }\n      ret\n    },\n    // a value that is not a function (`n(2)` with `n: Int`)\n    other => {\n      match (callee, check.shown(other)) {\n        (ast.Var(_), Some(x)) => if !(other is check.TFn) {\n          check.error(\n            mut i,\n            what + \": `\" + x + \"` is not a function\",\n          )\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}"},{"name":"check.infer_method","kind":"fn","old":"42bee23710491e7c","new":"5a5245e9619b8336","interface_changed":false,"affected":[],"module":"check","text":"/// A call `recv.m(args)`: a method of the receiver's type, or one of the\n/// program's functions or a built-in with the receiver as its first\n/// argument. Other calls (std's methods, closures) are not modelled.\n/// `marked`: written `mut recv.m(..)`.\nfn infer_method(\n  mut i: check.Inf,\n  recv: ast.Expr,\n  m: String,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n  marked: Bool,\n) -> check.Ty {\n  // `Item.new(..)`, `T.zero()`: a method called on a type\n  match recv {\n    ast.CtorExpr { name: tn, args: ast.NoArgs } => if contains(i.types.named, tn)\n      || contains(i.tparams, tn)\n      || [\"Int\", \"Float\", \"Bool\", \"String\"].contains(tn) {\n      mut i.recvs.push((m, check.TNamed { name: tn, args: [] }))\n      return check.static_call(mut i, tn, m, args, env)\n    },\n    // a type with its arguments as the receiver, as `derive` writes it:\n    // `{ $type: List[Int] := (); $type }.from_json_at(..)`\n    ast.Block { stmts: [ast.Let { pat: ast.Bind(\"$type\"), ty: Some(t), value: ast.UnitExpr }], last: ast.Var(\"$type\") } => return check.static_call(mut i, check.type_head(t), m, args, env),\n    _ => (),\n  }\n  rt := check.infer(mut i, recv, env, None)\n  mut i.recvs.push((m, rt))\n  // two traits with `m`, and nothing to choose between them\n  match check.ambiguity(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `s.bigger(t)` with `bigger(self, other: Self)` on a trait value\n  check.self_args(mut i, recv, check.res(i, rt), m, args)\n  // a code trait's method on a type that isn't one (`fold` of an iterator\n  // that may not end), or whose `impl` asks more of its arguments\n  match check.code_method_problem(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `xs.to_list()` of what is a list already (`s.code_points()`, a\n  // comprehension over one) is itself\n  match check.res(i, rt) {\n    check.TList(_) => if m == \"to_list\" && len(args) == 0 {\n      return rt\n    },\n    _ => (),\n  }\n  own := match check.res(i, rt) {\n    // a generic `impl`'s parameters are the receiver's type arguments\n    check.TNamed { name, args } => match get(i.methods.of, name + \".\" + m) {\n      Some(t) => Some(check.inst(\n        t,\n        check.pairs(\n          get(i.methods.params, name + \".\" + m) ?? [],\n          args,\n        ),\n      )),\n      None => match check.code_trait_method(i, name, m, check.res(i, rt)) {\n        Some(t) => Some(t),\n        // a method a trait it implements provides (`to_json` of a type deriving\n        // `Json`)\n        None => check.provided_method(i, name, m, check.res(i, rt)),\n      },\n    },\n    // `xs.iter()`: a list's method of core's code traits\n    check.TList(_) => check.code_trait_method(i, \"List\", m, check.res(i, rt)),\n    // `s.bytes()`, `s.graphemes()`: a string's methods of code traits\n    check.TStr => check.string_method(i, m),\n    // `x.m()` with `x: T` and `T: Tr`: the trait's method, `Self` being `T`\n    check.TGen(p) => check.bound_method(i, p, m),\n    // a trait value: the trait's method\n    check.TTrait(tr) => check.trait_method(i, tr, m, check.TTrait(tr), 8),\n    _ => None,\n  }\n  // a method of one of the program's types that changes its receiver\n  // (`mut self`) is called `mut recv.m(..)`, and only such a method is\n  // called so\n  match check.res(i, rt) {\n    check.TNamed { name, .. } => if check.program_type(i, name)\n      && contains(i.methods.self_methods, name + \".\" + m) {\n      changes := contains(i.methods.mut_self, name + \".\" + m)\n      shown := text.expr_text(recv, 0)\n      if changes && !marked {\n        check.error(mut i, \"`\"\n          + m\n          + \"` changes its receiver (`mut self`): write `mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)` to show that `\"\n          + shown\n          + \"` may change\")\n      } else if marked && !changes {\n        check.error(mut i, \"`mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)`: `\"\n          + m\n          + \"` doesn't change its receiver (it doesn't take `mut self`)\")\n      }\n    },\n    _ => (),\n  }\n  // `.to_list()` of what the checker types as a list (a comprehension or a\n  // built-in over a string's code points) is the list\n  if m == \"to_list\"\n    && len(args) == 0\n    && check.res(i, rt) is check.TList {\n    return check.res(i, rt)\n  }\n  // `x.f(..)` with `f` a built-in function is `f(x, ..)`, on a list even\n  // when a trait has a method of that name (`xs.map(f)`)\n  if own is None\n    && check.known(check.res(i, rt))\n    && !contains(env, m)\n    && (!contains(i.methods.names, m)\n      || check.res(i, rt) is check.TList\n      || check.is_table(check.res(i, rt)))\n    && get(i.fns, m) is None {\n    match get(i.builtins, m) {\n      Some(bs) => {\n        check.changing_call(mut i, recv, m, bs, marked)\n        return check.builtin_call(mut i, m, bs, [rt], args, env)\n      },\n      None => (),\n    }\n  }\n  sig := match own {\n    Some(t) => Some(t),\n    // a receiver of a type not known may have a method of that name, such as\n    // one of std's types\n    None => if !check.known(check.res(i, rt))\n      || contains(env, m)\n      || contains(i.methods.names, m)\n      || contains(i.builtins, m) {\n      None\n    } else {\n      get(i.fns, m)\n    },\n  }\n  match sig {\n    Some(t) => {\n      vars := check.fresh_for(mut i, to_list(check.gens(t, Set[String] {})))\n      ft := check.inst(t, vars)\n      match ft {\n        check.TFn { params, ret } => {\n          what := \"call to `\" + m + \"`\"\n          if len(params) != len(args) + 1 {\n            check.error(mut i, what\n              + \": expects \"\n              + to_string(len(params))\n              + \" arguments, got \"\n              + to_string(len(args) + 1))\n            return ret\n          }\n          check.expect(\n            mut i,\n            get(params, 0) ?? check.TAny,\n            rt,\n            what + \", argument 1\",\n          )\n          for (k, a) in enumerate(args) {\n            p := get(params, k + 1) ?? check.TAny\n            at := check.listed_arg(\n              mut i,\n              m,\n              k,\n              a,\n              p,\n              check.infer(mut i, a, env, Some(p)),\n              what,\n            )\n            check.expect(\n              mut i,\n              p,\n              at,\n              what + \", argument \" + to_string(k + 2),\n            )\n          }\n          // a type's own method with structural bounds: each one met\n          match (own, check.res(i, rt)) {\n            (Some(_), check.TNamed { name, .. }) => match get(i.methods.rows, name + \".\" + m) {\n              Some(rs) => {\n                for (p, fs) in rs {\n                  check.row_met(\n                    mut i,\n                    name + \".\" + m,\n                    fs,\n                    vars,\n                    get(vars, p) ?? check.TAny,\n                  )\n                }\n              },\n              None => (),\n            },\n            _ => (),\n          }\n          ret\n        },\n        _ => check.TAny,\n      }\n    },\n    None => {\n      // a method no `impl`, trait or function has, on one of the program's\n      // types the checker sees every method of\n      match check.res(i, rt) {\n        check.TNamed { name, .. } => if check.program_type(i, name)\n          && !contains(i.methods.foreign, name)\n          && !contains(env, m)\n          && !contains(i.methods.names, m)\n          && get(i.fns, m) is None\n          && get(i.builtins, m) is None {\n          check.error(mut i, \"unknown function `\" + m + \"`\")\n        },\n        _ => (),\n      }\n      // `true.price()`: a method of one of the file's traits, on a value of a\n      // basic or program type, which must implement it\n      match check.res(i, rt) {\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TNamed { .. } => if !contains(env, m) {\n          match check.own_trait_of(i, m) {\n            Some(tr) => mut i.pending.push((rt, tr, m)),\n            None => (),\n          }\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}","old_text":"/// A call `recv.m(args)`: a method of the receiver's type, or one of the\n/// program's functions or a built-in with the receiver as its first\n/// argument. Other calls (std's methods, closures) are not modelled.\n/// `marked`: written `mut recv.m(..)`.\nfn infer_method(\n  mut i: check.Inf,\n  recv: ast.Expr,\n  m: String,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n  marked: Bool,\n) -> check.Ty {\n  // `Item.new(..)`, `T.zero()`: a method called on a type\n  match recv {\n    ast.CtorExpr { name: tn, args: ast.NoArgs } => if contains(i.types.named, tn)\n      || contains(i.tparams, tn)\n      || [\"Int\", \"Float\", \"Bool\", \"String\"].contains(tn) {\n      mut i.recvs.push((m, check.TNamed { name: tn, args: [] }))\n      return check.static_call(mut i, tn, m, args, env)\n    },\n    // a type with its arguments as the receiver, as `derive` writes it:\n    // `{ $type: List[Int] := (); $type }.from_json_at(..)`\n    ast.Block { stmts: [ast.Let { pat: ast.Bind(\"$type\"), ty: Some(t), value: ast.UnitExpr }], last: ast.Var(\"$type\") } => return check.static_call(mut i, check.type_head(t), m, args, env),\n    _ => (),\n  }\n  rt := check.infer(mut i, recv, env, None)\n  mut i.recvs.push((m, rt))\n  // two traits with `m`, and nothing to choose between them\n  match check.ambiguity(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `s.bigger(t)` with `bigger(self, other: Self)` on a trait value\n  check.self_args(mut i, recv, check.res(i, rt), m, args)\n  // a code trait's method on a type that isn't one (`fold` of an iterator\n  // that may not end), or whose `impl` asks more of its arguments\n  match check.code_method_problem(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `xs.to_list()` of what is a list already (`s.code_points()`, a\n  // comprehension over one) is itself\n  match check.res(i, rt) {\n    check.TList(_) => if m == \"to_list\" && len(args) == 0 {\n      return rt\n    },\n    _ => (),\n  }\n  own := match check.res(i, rt) {\n    // a generic `impl`'s parameters are the receiver's type arguments\n    check.TNamed { name, args } => match get(i.methods.of, name + \".\" + m) {\n      Some(t) => Some(check.inst(\n        t,\n        check.pairs(\n          get(i.methods.params, name + \".\" + m) ?? [],\n          args,\n        ),\n      )),\n      None => match check.code_trait_method(i, name, m, check.res(i, rt)) {\n        Some(t) => Some(t),\n        // a method a trait it implements provides (`to_json` of a type deriving\n        // `Json`)\n        None => check.provided_method(i, name, m, check.res(i, rt)),\n      },\n    },\n    // `xs.iter()`: a list's method of core's code traits\n    check.TList(_) => check.code_trait_method(i, \"List\", m, check.res(i, rt)),\n    // `s.bytes()`, `s.graphemes()`: a string's methods of code traits\n    check.TStr => check.string_method(i, m),\n    // `x.m()` with `x: T` and `T: Tr`: the trait's method, `Self` being `T`\n    check.TGen(p) => check.bound_method(i, p, m),\n    // a trait value: the trait's method\n    check.TTrait(tr) => check.trait_method(i, tr, m, check.TTrait(tr), 8),\n    _ => None,\n  }\n  // a method of one of the program's types that changes its receiver\n  // (`mut self`) is called `mut recv.m(..)`, and only such a method is\n  // called so\n  match check.res(i, rt) {\n    check.TNamed { name, .. } => if check.program_type(i, name)\n      && contains(i.methods.self_methods, name + \".\" + m) {\n      changes := contains(i.methods.mut_self, name + \".\" + m)\n      shown := text.expr_text(recv, 0)\n      if changes && !marked {\n        check.error(mut i, \"`\"\n          + m\n          + \"` changes its receiver (`mut self`): write `mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)` to show that `\"\n          + shown\n          + \"` may change\")\n      } else if marked && !changes {\n        check.error(mut i, \"`mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)`: `\"\n          + m\n          + \"` doesn't change its receiver (it doesn't take `mut self`)\")\n      }\n    },\n    _ => (),\n  }\n  // `.to_list()` of what the checker types as a list (a comprehension or a\n  // built-in over a string's code points) is the list\n  if m == \"to_list\"\n    && len(args) == 0\n    && check.res(i, rt) is check.TList {\n    return check.res(i, rt)\n  }\n  // `x.f(..)` with `f` a built-in function is `f(x, ..)`, on a list even\n  // when a trait has a method of that name (`xs.map(f)`)\n  if own is None\n    && check.known(check.res(i, rt))\n    && !contains(env, m)\n    && (!contains(i.methods.names, m)\n      || check.res(i, rt) is check.TList\n      || check.is_table(check.res(i, rt)))\n    && get(i.fns, m) is None {\n    match get(i.builtins, m) {\n      Some(bs) => {\n        check.changing_call(mut i, recv, m, bs, marked)\n        return check.builtin_call(mut i, m, bs, [rt], args, env)\n      },\n      None => (),\n    }\n  }\n  sig := match own {\n    Some(t) => Some(t),\n    // a receiver of a type not known may have a method of that name, such as\n    // one of std's types\n    None => if !check.known(check.res(i, rt))\n      || contains(env, m)\n      || contains(i.methods.names, m)\n      || contains(i.builtins, m) {\n      None\n    } else {\n      get(i.fns, m)\n    },\n  }\n  match sig {\n    Some(t) => {\n      vars := check.fresh_for(mut i, to_list(check.gens(t, Set[String] {})))\n      ft := check.inst(t, vars)\n      match ft {\n        check.TFn { params, ret } => {\n          what := \"call to `\" + m + \"`\"\n          if len(params) != len(args) + 1 {\n            check.error(mut i, what\n              + \": expects \"\n              + to_string(len(params))\n              + \" arguments, got \"\n              + to_string(len(args) + 1))\n            return ret\n          }\n          check.expect(\n            mut i,\n            get(params, 0) ?? check.TAny,\n            rt,\n            what + \", argument 1\",\n          )\n          for (k, a) in enumerate(args) {\n            p := get(params, k + 1) ?? check.TAny\n            at := check.listed_arg(\n              mut i,\n              m,\n              k,\n              a,\n              p,\n              check.infer(mut i, a, env, Some(p)),\n              what,\n            )\n            check.expect(\n              mut i,\n              p,\n              at,\n              what + \", argument \" + to_string(k + 2),\n            )\n          }\n          // a type's own method with structural bounds: each one met\n          match (own, check.res(i, rt)) {\n            (Some(_), check.TNamed { name, .. }) => match get(i.methods.rows, name + \".\" + m) {\n              Some(rs) => {\n                for (p, fs) in rs {\n                  check.row_met(\n                    mut i,\n                    name + \".\" + m,\n                    fs,\n                    vars,\n                    get(vars, p) ?? check.TAny,\n                  )\n                }\n              },\n              None => check.error(mut i, \"DEBUG no rows \"\n                + name\n                + \".\"\n                + m\n                + \" in \"\n                + join(keys(i.methods.rows), \",\")),\n            },\n            _ => check.error(mut i, \"DEBUG other\"),\n          }\n          ret\n        },\n        _ => check.TAny,\n      }\n    },\n    None => {\n      // a method no `impl`, trait or function has, on one of the program's\n      // types the checker sees every method of\n      match check.res(i, rt) {\n        check.TNamed { name, .. } => if check.program_type(i, name)\n          && !contains(i.methods.foreign, name)\n          && !contains(env, m)\n          && !contains(i.methods.names, m)\n          && get(i.fns, m) is None\n          && get(i.builtins, m) is None {\n          check.error(mut i, \"unknown function `\" + m + \"`\")\n        },\n        _ => (),\n      }\n      // `true.price()`: a method of one of the file's traits, on a value of a\n      // basic or program type, which must implement it\n      match check.res(i, rt) {\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TNamed { .. } => if !contains(env, m) {\n          match check.own_trait_of(i, m) {\n            Some(tr) => mut i.pending.push((rt, tr, m)),\n            None => (),\n          }\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}"}]}
{"id":"be6c5e26ca0199cf","time":1795710125,"message":"edit","changes":[{"name":"check.static_call","kind":"fn","old":"225d392d117dff3e","new":"527b9ea810646e0f","interface_changed":false,"affected":[],"module":"check","text":"/// `T.m(args)`: a method without `self` of type `tn`'s `impl`s, or for a\n/// type parameter, of its bounds.\nfn static_call(\n  mut i: check.Inf,\n  tn: String,\n  m: String,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n) -> check.Ty {\n  // `T.check(x)`: every type has it (its refinements on `x`), unless its own\n  // `check` says otherwise\n  if m == \"check\"\n    && len(args) == 1\n    && get(i.methods.of, tn + \".check\") is None\n    && !(contains(i.tparams, tn) && check.bound_method(i, tn, m) is Some) {\n    check.infer_all(mut i, args, env)\n    return check.TNamed { name: \"Result\", args: [check.TUnit, check.TStr] }\n  }\n  // the type variables of a type's own method, for its structural bounds\n  mut row_vars := Dict[String, check.Ty] {}\n  sig := if contains(i.tparams, tn) {\n    match check.bound_method(i, tn, m) {\n      Some(t) => Some(t),\n      None => {\n        // with bounds, the method may be one the checker doesn't see: a derived\n        // trait's, std's\n        if len(get(i.tbounds, tn) ?? []) == 0 {\n          check.error(mut i, \"`\"\n            + tn\n            + \"` has no method `\"\n            + m\n            + \"` called on the type (none of its traits declares one)\")\n        }\n        check.infer_all(mut i, args, env)\n        return check.TAny\n      },\n    }\n  } else if get(i.methods.of, tn + \".\" + m) is None\n    && !check.program_type(i, tn) {\n    // a type with no `impl` of its own that has the method (`Int.empty()`):\n    // the one trait declaring it, which the type must implement\n    statics := [k for k in keys(i.methods.traits) where ends_with(k, \".\" + m)]\n    match statics {\n      [k] => {\n        tr := byte_slice(k, 0, byte_len(k) - byte_len(m) - 1)\n        self_t := check.lower(\n          i.types,\n          Set[String] {},\n          ast.Named { name: tn, args: [] },\n        )\n        mut i.pending.push((self_t, tr, m))\n        match check.trait_method(i, tr, m, self_t, 8) {\n          Some(t) => Some(check.inst(t, check.fresh_for(\n            mut i,\n            to_list(check.gens(t, Set[String] {})),\n          ))),\n          None => None,\n        }\n      },\n      _ => None,\n    }\n  } else {\n    match get(i.methods.of, tn + \".\" + m) {\n      Some(t) => {\n        row_vars = check.fresh_for(\n          mut i,\n          to_list(check.gens(t, Set[String] {})),\n        )\n        Some(check.inst(t, row_vars))\n      },\n      // a default method of a trait the type implements (`Todo.filter(c)` of a\n      // derived `Table`)\n      None => match check.trait_with_method(i, tn, m) {\n        Some(tr) => {\n          self_t := check.lower(\n            i.types,\n            Set[String] {},\n            ast.Named { name: tn, args: [] },\n          )\n          match check.trait_method(i, tr, m, self_t, 8) {\n            Some(t) => Some(check.inst(t, check.fresh_for(\n              mut i,\n              to_list(check.gens(t, Set[String] {})),\n            ))),\n            None => None,\n          }\n        },\n        None => None,\n      },\n    }\n  }\n  match sig {\n    Some(t) => match t {\n      check.TFn { params, ret } => {\n        what := \"call to `\" + tn + \".\" + m + \"`\"\n        if len(params) == len(args) {\n          for (k, a) in enumerate(args) {\n            p := get(params, k) ?? check.TAny\n            at := check.listed_arg(\n              mut i,\n              tn + \".\" + m,\n              k,\n              a,\n              p,\n              check.infer(mut i, a, env, Some(p)),\n              what,\n            )\n            check.expect(\n              mut i,\n              p,\n              at,\n              what + \", argument \" + to_string(k + 1),\n            )\n          }\n          // a type's own method with structural bounds: each one met\n          match get(i.methods.rows, tn + \".\" + m) {\n            Some(rs) => {\n              for (q, fs) in rs {\n                check.row_met(\n                  mut i,\n                  tn + \".\" + m,\n                  fs,\n                  row_vars,\n                  get(row_vars, q) ?? check.TAny,\n                )\n              }\n            },\n            None => (),\n          }\n        } else {\n          check.infer_all(mut i, args, env)\n        }\n        ret\n      },\n      _ => {\n        check.infer_all(mut i, args, env)\n        check.TAny\n      },\n    },\n    None => {\n      if check.program_type(i, tn)\n        && !contains(i.methods.foreign, tn)\n        && !contains(i.methods.names, m) {\n        check.error(mut i, \"`\"\n          + tn\n          + \"` has no method `\"\n          + m\n          + \"` called on the type (one without `self`, in `impl \"\n          + tn\n          + \"`)\")\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}","old_text":"/// `T.m(args)`: a method without `self` of type `tn`'s `impl`s, or for a\n/// type parameter, of its bounds.\nfn static_call(\n  mut i: check.Inf,\n  tn: String,\n  m: String,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n) -> check.Ty {\n  // `T.check(x)`: every type has it (its refinements on `x`), unless its own\n  // `check` says otherwise\n  if m == \"check\"\n    && len(args) == 1\n    && get(i.methods.of, tn + \".check\") is None\n    && !(contains(i.tparams, tn) && check.bound_method(i, tn, m) is Some) {\n    check.infer_all(mut i, args, env)\n    return check.TNamed { name: \"Result\", args: [check.TUnit, check.TStr] }\n  }\n  sig := if contains(i.tparams, tn) {\n    match check.bound_method(i, tn, m) {\n      Some(t) => Some(t),\n      None => {\n        // with bounds, the method may be one the checker doesn't see: a derived\n        // trait's, std's\n        if len(get(i.tbounds, tn) ?? []) == 0 {\n          check.error(mut i, \"`\"\n            + tn\n            + \"` has no method `\"\n            + m\n            + \"` called on the type (none of its traits declares one)\")\n        }\n        check.infer_all(mut i, args, env)\n        return check.TAny\n      },\n    }\n  } else if get(i.methods.of, tn + \".\" + m) is None\n    && !check.program_type(i, tn) {\n    // a type with no `impl` of its own that has the method (`Int.empty()`):\n    // the one trait declaring it, which the type must implement\n    statics := [k for k in keys(i.methods.traits) where ends_with(k, \".\" + m)]\n    match statics {\n      [k] => {\n        tr := byte_slice(k, 0, byte_len(k) - byte_len(m) - 1)\n        self_t := check.lower(\n          i.types,\n          Set[String] {},\n          ast.Named { name: tn, args: [] },\n        )\n        mut i.pending.push((self_t, tr, m))\n        match check.trait_method(i, tr, m, self_t, 8) {\n          Some(t) => Some(check.inst(t, check.fresh_for(\n            mut i,\n            to_list(check.gens(t, Set[String] {})),\n          ))),\n          None => None,\n        }\n      },\n      _ => None,\n    }\n  } else {\n    match get(i.methods.of, tn + \".\" + m) {\n      Some(t) => Some(check.inst(\n        t,\n        check.fresh_for(\n          mut i,\n          to_list(check.gens(t, Set[String] {})),\n        ),\n      )),\n      // a default method of a trait the type implements (`Todo.filter(c)` of a\n      // derived `Table`)\n      None => match check.trait_with_method(i, tn, m) {\n        Some(tr) => {\n          self_t := check.lower(\n            i.types,\n            Set[String] {},\n            ast.Named { name: tn, args: [] },\n          )\n          match check.trait_method(i, tr, m, self_t, 8) {\n            Some(t) => Some(check.inst(t, check.fresh_for(\n              mut i,\n              to_list(check.gens(t, Set[String] {})),\n            ))),\n            None => None,\n          }\n        },\n        None => None,\n      },\n    }\n  }\n  match sig {\n    Some(t) => match t {\n      check.TFn { params, ret } => {\n        what := \"call to `\" + tn + \".\" + m + \"`\"\n        if len(params) == len(args) {\n          for (k, a) in enumerate(args) {\n            p := get(params, k) ?? check.TAny\n            at := check.listed_arg(\n              mut i,\n              tn + \".\" + m,\n              k,\n              a,\n              p,\n              check.infer(mut i, a, env, Some(p)),\n              what,\n            )\n            check.expect(\n              mut i,\n              p,\n              at,\n              what + \", argument \" + to_string(k + 1),\n            )\n          }\n        } else {\n          check.infer_all(mut i, args, env)\n        }\n        ret\n      },\n      _ => {\n        check.infer_all(mut i, args, env)\n        check.TAny\n      },\n    },\n    None => {\n      if check.program_type(i, tn)\n        && !contains(i.methods.foreign, tn)\n        && !contains(i.methods.names, m) {\n        check.error(mut i, \"`\"\n          + tn\n          + \"` has no method `\"\n          + m\n          + \"` called on the type (one without `self`, in `impl \"\n          + tn\n          + \"`)\")\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}"}]}
{"id":"6d0124ddf0d4a0aa","time":1795710189,"message":"edit","changes":[{"name":"check.infer_method","kind":"fn","old":"5a5245e9619b8336","new":"c860e76d06dcc627","interface_changed":false,"affected":[],"module":"check","text":"/// A call `recv.m(args)`: a method of the receiver's type, or one of the\n/// program's functions or a built-in with the receiver as its first\n/// argument. Other calls (std's methods, closures) are not modelled.\n/// `marked`: written `mut recv.m(..)`.\nfn infer_method(\n  mut i: check.Inf,\n  recv: ast.Expr,\n  m: String,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n  marked: Bool,\n) -> check.Ty {\n  // `Item.new(..)`, `T.zero()`: a method called on a type\n  match recv {\n    ast.CtorExpr { name: tn, args: ast.NoArgs } => if contains(i.types.named, tn)\n      || contains(i.tparams, tn)\n      || [\"Int\", \"Float\", \"Bool\", \"String\"].contains(tn) {\n      mut i.recvs.push((m, check.TNamed { name: tn, args: [] }))\n      return check.static_call(mut i, tn, m, args, env)\n    },\n    // a type with its arguments as the receiver, as `derive` writes it:\n    // `{ $type: List[Int] := (); $type }.from_json_at(..)`\n    ast.Block { stmts: [ast.Let { pat: ast.Bind(\"$type\"), ty: Some(t), value: ast.UnitExpr }], last: ast.Var(\"$type\") } => return check.static_call(mut i, check.type_head(t), m, args, env),\n    _ => (),\n  }\n  rt := check.infer(mut i, recv, env, None)\n  mut i.recvs.push((m, rt))\n  // two traits with `m`, and nothing to choose between them\n  match check.ambiguity(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `s.bigger(t)` with `bigger(self, other: Self)` on a trait value\n  check.self_args(mut i, recv, check.res(i, rt), m, args)\n  // a code trait's method on a type that isn't one (`fold` of an iterator\n  // that may not end), or whose `impl` asks more of its arguments\n  match check.code_method_problem(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `xs.to_list()` of what is a list already (`s.code_points()`, a\n  // comprehension over one) is itself\n  match check.res(i, rt) {\n    check.TList(_) => if m == \"to_list\" && len(args) == 0 {\n      return rt\n    },\n    _ => (),\n  }\n  own := match check.res(i, rt) {\n    // a generic `impl`'s parameters are the receiver's type arguments\n    check.TNamed { name, args } => match get(i.methods.of, name + \".\" + m) {\n      Some(t) => Some(check.inst(\n        t,\n        check.pairs(\n          get(i.methods.params, name + \".\" + m) ?? [],\n          args,\n        ),\n      )),\n      None => match check.code_trait_method(i, name, m, check.res(i, rt)) {\n        Some(t) => Some(t),\n        // a method a trait it implements provides (`to_json` of a type deriving\n        // `Json`)\n        None => check.provided_method(i, name, m, check.res(i, rt)),\n      },\n    },\n    // `xs.iter()`: a list's method of core's code traits\n    check.TList(_) => check.code_trait_method(i, \"List\", m, check.res(i, rt)),\n    // `s.bytes()`, `s.graphemes()`: a string's methods of code traits\n    check.TStr => check.string_method(i, m),\n    // `x.m()` with `x: T` and `T: Tr`: the trait's method, `Self` being `T`\n    check.TGen(p) => check.bound_method(i, p, m),\n    // a trait value: the trait's method\n    check.TTrait(tr) => check.trait_method(i, tr, m, check.TTrait(tr), 8),\n    _ => None,\n  }\n  // a method of one of the program's types that changes its receiver\n  // (`mut self`) is called `mut recv.m(..)`, and only such a method is\n  // called so\n  match check.res(i, rt) {\n    check.TNamed { name, .. } => if check.program_type(i, name)\n      && contains(i.methods.self_methods, name + \".\" + m) {\n      changes := contains(i.methods.mut_self, name + \".\" + m)\n      shown := text.expr_text(recv, 0)\n      if changes && !marked {\n        check.error(mut i, \"`\"\n          + m\n          + \"` changes its receiver (`mut self`): write `mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)` to show that `\"\n          + shown\n          + \"` may change\")\n      } else if marked && !changes {\n        check.error(mut i, \"`mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)`: `\"\n          + m\n          + \"` doesn't change its receiver (it doesn't take `mut self`)\")\n      }\n    },\n    _ => (),\n  }\n  // `.to_list()` of what the checker types as a list (a comprehension or a\n  // built-in over a string's code points) is the list\n  if m == \"to_list\"\n    && len(args) == 0\n    && check.res(i, rt) is check.TList {\n    return check.res(i, rt)\n  }\n  // `x.f(..)` with `f` a built-in function is `f(x, ..)`, on a list even\n  // when a trait has a method of that name (`xs.map(f)`)\n  if own is None\n    && check.known(check.res(i, rt))\n    && !contains(env, m)\n    && (!contains(i.methods.names, m)\n      || check.res(i, rt) is check.TList\n      || check.is_table(check.res(i, rt)))\n    && get(i.fns, m) is None {\n    match get(i.builtins, m) {\n      Some(bs) => {\n        check.changing_call(mut i, recv, m, bs, marked)\n        return check.builtin_call(mut i, m, bs, [rt], args, env)\n      },\n      None => (),\n    }\n  }\n  sig := match own {\n    Some(t) => Some(t),\n    // a receiver of a type not known may have a method of that name, such as\n    // one of std's types\n    None => if !check.known(check.res(i, rt))\n      || contains(env, m)\n      || contains(i.methods.names, m)\n      || contains(i.builtins, m) {\n      None\n    } else {\n      get(i.fns, m)\n    },\n  }\n  match sig {\n    Some(t) => {\n      vars := check.fresh_for(mut i, to_list(check.gens(t, Set[String] {})))\n      ft := check.inst(t, vars)\n      match ft {\n        check.TFn { params, ret } => {\n          what := \"call to `\" + m + \"`\"\n          if len(params) != len(args) + 1 {\n            check.error(mut i, what\n              + \": expects \"\n              + to_string(len(params))\n              + \" arguments, got \"\n              + to_string(len(args) + 1))\n            return ret\n          }\n          check.expect(\n            mut i,\n            get(params, 0) ?? check.TAny,\n            rt,\n            what + \", argument 1\",\n          )\n          for (k, a) in enumerate(args) {\n            p := get(params, k + 1) ?? check.TAny\n            at := check.listed_arg(\n              mut i,\n              m,\n              k,\n              a,\n              p,\n              check.infer(mut i, a, env, Some(p)),\n              what,\n            )\n            check.expect(\n              mut i,\n              p,\n              at,\n              what + \", argument \" + to_string(k + 2),\n            )\n          }\n          // a type's own method with structural bounds: each one met\n          check.error(mut i, \"DEBUG \"\n            + m\n            + \" own=\"\n            + to_string(own is Some)\n            + \" rt=\"\n            + (check.shown(check.res(i, rt)) ?? \"?\")\n            + \" vars=\"\n            + join(keys(vars), \",\")\n            + \" rows=\"\n            + join(keys(i.methods.rows), \",\"))\n          match (own, check.res(i, rt)) {\n            (Some(_), check.TNamed { name, .. }) => match get(i.methods.rows, name + \".\" + m) {\n              Some(rs) => {\n                for (p, fs) in rs {\n                  check.row_met(\n                    mut i,\n                    name + \".\" + m,\n                    fs,\n                    vars,\n                    get(vars, p) ?? check.TAny,\n                  )\n                }\n              },\n              None => (),\n            },\n            _ => (),\n          }\n          ret\n        },\n        _ => check.TAny,\n      }\n    },\n    None => {\n      // a method no `impl`, trait or function has, on one of the program's\n      // types the checker sees every method of\n      match check.res(i, rt) {\n        check.TNamed { name, .. } => if check.program_type(i, name)\n          && !contains(i.methods.foreign, name)\n          && !contains(env, m)\n          && !contains(i.methods.names, m)\n          && get(i.fns, m) is None\n          && get(i.builtins, m) is None {\n          check.error(mut i, \"unknown function `\" + m + \"`\")\n        },\n        _ => (),\n      }\n      // `true.price()`: a method of one of the file's traits, on a value of a\n      // basic or program type, which must implement it\n      match check.res(i, rt) {\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TNamed { .. } => if !contains(env, m) {\n          match check.own_trait_of(i, m) {\n            Some(tr) => mut i.pending.push((rt, tr, m)),\n            None => (),\n          }\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}","old_text":"/// A call `recv.m(args)`: a method of the receiver's type, or one of the\n/// program's functions or a built-in with the receiver as its first\n/// argument. Other calls (std's methods, closures) are not modelled.\n/// `marked`: written `mut recv.m(..)`.\nfn infer_method(\n  mut i: check.Inf,\n  recv: ast.Expr,\n  m: String,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n  marked: Bool,\n) -> check.Ty {\n  // `Item.new(..)`, `T.zero()`: a method called on a type\n  match recv {\n    ast.CtorExpr { name: tn, args: ast.NoArgs } => if contains(i.types.named, tn)\n      || contains(i.tparams, tn)\n      || [\"Int\", \"Float\", \"Bool\", \"String\"].contains(tn) {\n      mut i.recvs.push((m, check.TNamed { name: tn, args: [] }))\n      return check.static_call(mut i, tn, m, args, env)\n    },\n    // a type with its arguments as the receiver, as `derive` writes it:\n    // `{ $type: List[Int] := (); $type }.from_json_at(..)`\n    ast.Block { stmts: [ast.Let { pat: ast.Bind(\"$type\"), ty: Some(t), value: ast.UnitExpr }], last: ast.Var(\"$type\") } => return check.static_call(mut i, check.type_head(t), m, args, env),\n    _ => (),\n  }\n  rt := check.infer(mut i, recv, env, None)\n  mut i.recvs.push((m, rt))\n  // two traits with `m`, and nothing to choose between them\n  match check.ambiguity(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `s.bigger(t)` with `bigger(self, other: Self)` on a trait value\n  check.self_args(mut i, recv, check.res(i, rt), m, args)\n  // a code trait's method on a type that isn't one (`fold` of an iterator\n  // that may not end), or whose `impl` asks more of its arguments\n  match check.code_method_problem(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `xs.to_list()` of what is a list already (`s.code_points()`, a\n  // comprehension over one) is itself\n  match check.res(i, rt) {\n    check.TList(_) => if m == \"to_list\" && len(args) == 0 {\n      return rt\n    },\n    _ => (),\n  }\n  own := match check.res(i, rt) {\n    // a generic `impl`'s parameters are the receiver's type arguments\n    check.TNamed { name, args } => match get(i.methods.of, name + \".\" + m) {\n      Some(t) => Some(check.inst(\n        t,\n        check.pairs(\n          get(i.methods.params, name + \".\" + m) ?? [],\n          args,\n        ),\n      )),\n      None => match check.code_trait_method(i, name, m, check.res(i, rt)) {\n        Some(t) => Some(t),\n        // a method a trait it implements provides (`to_json` of a type deriving\n        // `Json`)\n        None => check.provided_method(i, name, m, check.res(i, rt)),\n      },\n    },\n    // `xs.iter()`: a list's method of core's code traits\n    check.TList(_) => check.code_trait_method(i, \"List\", m, check.res(i, rt)),\n    // `s.bytes()`, `s.graphemes()`: a string's methods of code traits\n    check.TStr => check.string_method(i, m),\n    // `x.m()` with `x: T` and `T: Tr`: the trait's method, `Self` being `T`\n    check.TGen(p) => check.bound_method(i, p, m),\n    // a trait value: the trait's method\n    check.TTrait(tr) => check.trait_method(i, tr, m, check.TTrait(tr), 8),\n    _ => None,\n  }\n  // a method of one of the program's types that changes its receiver\n  // (`mut self`) is called `mut recv.m(..)`, and only such a method is\n  // called so\n  match check.res(i, rt) {\n    check.TNamed { name, .. } => if check.program_type(i, name)\n      && contains(i.methods.self_methods, name + \".\" + m) {\n      changes := contains(i.methods.mut_self, name + \".\" + m)\n      shown := text.expr_text(recv, 0)\n      if changes && !marked {\n        check.error(mut i, \"`\"\n          + m\n          + \"` changes its receiver (`mut self`): write `mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)` to show that `\"\n          + shown\n          + \"` may change\")\n      } else if marked && !changes {\n        check.error(mut i, \"`mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)`: `\"\n          + m\n          + \"` doesn't change its receiver (it doesn't take `mut self`)\")\n      }\n    },\n    _ => (),\n  }\n  // `.to_list()` of what the checker types as a list (a comprehension or a\n  // built-in over a string's code points) is the list\n  if m == \"to_list\"\n    && len(args) == 0\n    && check.res(i, rt) is check.TList {\n    return check.res(i, rt)\n  }\n  // `x.f(..)` with `f` a built-in function is `f(x, ..)`, on a list even\n  // when a trait has a method of that name (`xs.map(f)`)\n  if own is None\n    && check.known(check.res(i, rt))\n    && !contains(env, m)\n    && (!contains(i.methods.names, m)\n      || check.res(i, rt) is check.TList\n      || check.is_table(check.res(i, rt)))\n    && get(i.fns, m) is None {\n    match get(i.builtins, m) {\n      Some(bs) => {\n        check.changing_call(mut i, recv, m, bs, marked)\n        return check.builtin_call(mut i, m, bs, [rt], args, env)\n      },\n      None => (),\n    }\n  }\n  sig := match own {\n    Some(t) => Some(t),\n    // a receiver of a type not known may have a method of that name, such as\n    // one of std's types\n    None => if !check.known(check.res(i, rt))\n      || contains(env, m)\n      || contains(i.methods.names, m)\n      || contains(i.builtins, m) {\n      None\n    } else {\n      get(i.fns, m)\n    },\n  }\n  match sig {\n    Some(t) => {\n      vars := check.fresh_for(mut i, to_list(check.gens(t, Set[String] {})))\n      ft := check.inst(t, vars)\n      match ft {\n        check.TFn { params, ret } => {\n          what := \"call to `\" + m + \"`\"\n          if len(params) != len(args) + 1 {\n            check.error(mut i, what\n              + \": expects \"\n              + to_string(len(params))\n              + \" arguments, got \"\n              + to_string(len(args) + 1))\n            return ret\n          }\n          check.expect(\n            mut i,\n            get(params, 0) ?? check.TAny,\n            rt,\n            what + \", argument 1\",\n          )\n          for (k, a) in enumerate(args) {\n            p := get(params, k + 1) ?? check.TAny\n            at := check.listed_arg(\n              mut i,\n              m,\n              k,\n              a,\n              p,\n              check.infer(mut i, a, env, Some(p)),\n              what,\n            )\n            check.expect(\n              mut i,\n              p,\n              at,\n              what + \", argument \" + to_string(k + 2),\n            )\n          }\n          // a type's own method with structural bounds: each one met\n          match (own, check.res(i, rt)) {\n            (Some(_), check.TNamed { name, .. }) => match get(i.methods.rows, name + \".\" + m) {\n              Some(rs) => {\n                for (p, fs) in rs {\n                  check.row_met(\n                    mut i,\n                    name + \".\" + m,\n                    fs,\n                    vars,\n                    get(vars, p) ?? check.TAny,\n                  )\n                }\n              },\n              None => (),\n            },\n            _ => (),\n          }\n          ret\n        },\n        _ => check.TAny,\n      }\n    },\n    None => {\n      // a method no `impl`, trait or function has, on one of the program's\n      // types the checker sees every method of\n      match check.res(i, rt) {\n        check.TNamed { name, .. } => if check.program_type(i, name)\n          && !contains(i.methods.foreign, name)\n          && !contains(env, m)\n          && !contains(i.methods.names, m)\n          && get(i.fns, m) is None\n          && get(i.builtins, m) is None {\n          check.error(mut i, \"unknown function `\" + m + \"`\")\n        },\n        _ => (),\n      }\n      // `true.price()`: a method of one of the file's traits, on a value of a\n      // basic or program type, which must implement it\n      match check.res(i, rt) {\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TNamed { .. } => if !contains(env, m) {\n          match check.own_trait_of(i, m) {\n            Some(tr) => mut i.pending.push((rt, tr, m)),\n            None => (),\n          }\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}"}]}
{"id":"aca1bde9d59abc89","time":1795710269,"message":"edit","changes":[{"name":"check.infer_method","kind":"fn","old":"c860e76d06dcc627","new":"ce817656263d005e","interface_changed":false,"affected":[],"module":"check","text":"/// A call `recv.m(args)`: a method of the receiver's type, or one of the\n/// program's functions or a built-in with the receiver as its first\n/// argument. Other calls (std's methods, closures) are not modelled.\n/// `marked`: written `mut recv.m(..)`.\nfn infer_method(\n  mut i: check.Inf,\n  recv: ast.Expr,\n  m: String,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n  marked: Bool,\n) -> check.Ty {\n  // `Item.new(..)`, `T.zero()`: a method called on a type\n  match recv {\n    ast.CtorExpr { name: tn, args: ast.NoArgs } => if contains(i.types.named, tn)\n      || contains(i.tparams, tn)\n      || [\"Int\", \"Float\", \"Bool\", \"String\"].contains(tn) {\n      mut i.recvs.push((m, check.TNamed { name: tn, args: [] }))\n      return check.static_call(mut i, tn, m, args, env)\n    },\n    // a type with its arguments as the receiver, as `derive` writes it:\n    // `{ $type: List[Int] := (); $type }.from_json_at(..)`\n    ast.Block { stmts: [ast.Let { pat: ast.Bind(\"$type\"), ty: Some(t), value: ast.UnitExpr }], last: ast.Var(\"$type\") } => return check.static_call(mut i, check.type_head(t), m, args, env),\n    _ => (),\n  }\n  rt := check.infer(mut i, recv, env, None)\n  mut i.recvs.push((m, rt))\n  // two traits with `m`, and nothing to choose between them\n  match check.ambiguity(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `s.bigger(t)` with `bigger(self, other: Self)` on a trait value\n  check.self_args(mut i, recv, check.res(i, rt), m, args)\n  // a code trait's method on a type that isn't one (`fold` of an iterator\n  // that may not end), or whose `impl` asks more of its arguments\n  match check.code_method_problem(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `xs.to_list()` of what is a list already (`s.code_points()`, a\n  // comprehension over one) is itself\n  match check.res(i, rt) {\n    check.TList(_) => if m == \"to_list\" && len(args) == 0 {\n      return rt\n    },\n    _ => (),\n  }\n  own := match check.res(i, rt) {\n    // a generic `impl`'s parameters are the receiver's type arguments\n    check.TNamed { name, args } => match get(i.methods.of, name + \".\" + m) {\n      Some(t) => Some(check.inst(\n        t,\n        check.pairs(\n          get(i.methods.params, name + \".\" + m) ?? [],\n          args,\n        ),\n      )),\n      None => match check.code_trait_method(i, name, m, check.res(i, rt)) {\n        Some(t) => Some(t),\n        // a method a trait it implements provides (`to_json` of a type deriving\n        // `Json`)\n        None => check.provided_method(i, name, m, check.res(i, rt)),\n      },\n    },\n    // `xs.iter()`: a list's method of core's code traits\n    check.TList(_) => check.code_trait_method(i, \"List\", m, check.res(i, rt)),\n    // `s.bytes()`, `s.graphemes()`: a string's methods of code traits\n    check.TStr => check.string_method(i, m),\n    // `x.m()` with `x: T` and `T: Tr`: the trait's method, `Self` being `T`\n    check.TGen(p) => check.bound_method(i, p, m),\n    // a trait value: the trait's method\n    check.TTrait(tr) => check.trait_method(i, tr, m, check.TTrait(tr), 8),\n    _ => None,\n  }\n  // a method of one of the program's types that changes its receiver\n  // (`mut self`) is called `mut recv.m(..)`, and only such a method is\n  // called so\n  match check.res(i, rt) {\n    check.TNamed { name, .. } => if check.program_type(i, name)\n      && contains(i.methods.self_methods, name + \".\" + m) {\n      changes := contains(i.methods.mut_self, name + \".\" + m)\n      shown := text.expr_text(recv, 0)\n      if changes && !marked {\n        check.error(mut i, \"`\"\n          + m\n          + \"` changes its receiver (`mut self`): write `mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)` to show that `\"\n          + shown\n          + \"` may change\")\n      } else if marked && !changes {\n        check.error(mut i, \"`mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)`: `\"\n          + m\n          + \"` doesn't change its receiver (it doesn't take `mut self`)\")\n      }\n    },\n    _ => (),\n  }\n  // `.to_list()` of what the checker types as a list (a comprehension or a\n  // built-in over a string's code points) is the list\n  if m == \"to_list\"\n    && len(args) == 0\n    && check.res(i, rt) is check.TList {\n    return check.res(i, rt)\n  }\n  // `x.f(..)` with `f` a built-in function is `f(x, ..)`, on a list even\n  // when a trait has a method of that name (`xs.map(f)`)\n  if own is None\n    && check.known(check.res(i, rt))\n    && !contains(env, m)\n    && (!contains(i.methods.names, m)\n      || check.res(i, rt) is check.TList\n      || check.is_table(check.res(i, rt)))\n    && get(i.fns, m) is None {\n    match get(i.builtins, m) {\n      Some(bs) => {\n        check.changing_call(mut i, recv, m, bs, marked)\n        return check.builtin_call(mut i, m, bs, [rt], args, env)\n      },\n      None => (),\n    }\n  }\n  sig := match own {\n    Some(t) => Some(t),\n    // a receiver of a type not known may have a method of that name, such as\n    // one of std's types\n    None => if !check.known(check.res(i, rt))\n      || contains(env, m)\n      || contains(i.methods.names, m)\n      || contains(i.builtins, m) {\n      None\n    } else {\n      get(i.fns, m)\n    },\n  }\n  match sig {\n    Some(t) => {\n      vars := check.fresh_for(mut i, to_list(check.gens(t, Set[String] {})))\n      ft := check.inst(t, vars)\n      match ft {\n        check.TFn { params, ret } => {\n          what := \"call to `\" + m + \"`\"\n          if len(params) != len(args) + 1 {\n            check.error(mut i, what\n              + \": expects \"\n              + to_string(len(params))\n              + \" arguments, got \"\n              + to_string(len(args) + 1))\n            return ret\n          }\n          check.expect(\n            mut i,\n            get(params, 0) ?? check.TAny,\n            rt,\n            what + \", argument 1\",\n          )\n          mut ats := []\n          for (k, a) in enumerate(args) {\n            p := get(params, k + 1) ?? check.TAny\n            at := check.listed_arg(\n              mut i,\n              m,\n              k,\n              a,\n              p,\n              check.infer(mut i, a, env, Some(p)),\n              what,\n            )\n            check.expect(\n              mut i,\n              p,\n              at,\n              what + \", argument \" + to_string(k + 2),\n            )\n            mut ats.push(at)\n          }\n          // a type's own method with structural bounds: each one met by the\n          // type an argument gives its type parameter (`own` has the method's\n          // type parameters as `TAny`)\n          match (own, check.res(i, rt)) {\n            (Some(_), check.TNamed { name, .. }) => match (\n              get(i.methods.rows, name + \".\" + m),\n              get(i.methods.of, name + \".\" + m),\n            ) {\n              (Some(rs), Some(check.TFn { params: raw, .. })) => {\n                for (q, fs) in rs {\n                  mut met := false\n                  for (k, at) in enumerate(ats) {\n                    if !met {\n                      match check.given_for(\n                        i,\n                        get(raw, k + 1) ?? check.TAny,\n                        at,\n                        q,\n                      ) {\n                        Some(g) => {\n                          met = true\n                          check.row_met(\n                            mut i,\n                            name + \".\" + m,\n                            fs,\n                            vars,\n                            g,\n                          )\n                        },\n                        None => (),\n                      }\n                    }\n                  }\n                }\n              },\n              _ => (),\n            },\n            _ => (),\n          }\n          ret\n        },\n        _ => check.TAny,\n      }\n    },\n    None => {\n      // a method no `impl`, trait or function has, on one of the program's\n      // types the checker sees every method of\n      match check.res(i, rt) {\n        check.TNamed { name, .. } => if check.program_type(i, name)\n          && !contains(i.methods.foreign, name)\n          && !contains(env, m)\n          && !contains(i.methods.names, m)\n          && get(i.fns, m) is None\n          && get(i.builtins, m) is None {\n          check.error(mut i, \"unknown function `\" + m + \"`\")\n        },\n        _ => (),\n      }\n      // `true.price()`: a method of one of the file's traits, on a value of a\n      // basic or program type, which must implement it\n      match check.res(i, rt) {\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TNamed { .. } => if !contains(env, m) {\n          match check.own_trait_of(i, m) {\n            Some(tr) => mut i.pending.push((rt, tr, m)),\n            None => (),\n          }\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}","old_text":"/// A call `recv.m(args)`: a method of the receiver's type, or one of the\n/// program's functions or a built-in with the receiver as its first\n/// argument. Other calls (std's methods, closures) are not modelled.\n/// `marked`: written `mut recv.m(..)`.\nfn infer_method(\n  mut i: check.Inf,\n  recv: ast.Expr,\n  m: String,\n  args: List[ast.Expr],\n  env: