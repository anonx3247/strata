odegen.generated_args","codegen.makers","codegen.equal","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","codegen.read_back","eval_files"],"module":"codegen","text":"/// A non-empty list literal whose elements are all constants (`Int`\n/// literals, string constants, field-less constructors) as one constant\n/// block: a header and a buffer with counts of 0, emitted once per program\n/// and never counted or freed. The buffer is writable data:\n/// `list_extend` claims its slots by writing the slots used, unchanged, when\n/// it adds no element. Named by a hash of its elements' code, so the\n/// same literal anywhere is the same block. `None` for any other list.\nfn constant_list(\n  mut g: codegen.Gen,\n  vs: List[codegen.V],\n  et: check.Ty,\n) -> Option[codegen.V] {\n  if vs == [] || codegen.sized(et) is Some {\n    return None\n  }\n  mut cells := []\n  for v in vs {\n    cell := match v.ty {\n      check.TInt => if parse_int(v.op) is Some {\n        \"i64 \" + v.op\n      } else {\n        return None\n      },\n      check.TStr | check.TNamed { .. } => if starts_with(v.op, \"getelementptr inbounds (i8, ptr @\") {\n        \"ptr \" + v.op\n      } else {\n        return None\n      },\n      _ => return None,\n    }\n    mut cells.push(cell)\n  }\n  // one IR type for the slots: all `i64` or all `ptr`\n  slot := if vs.all(v -> v.ty is check.TInt) {\n    \"i64\"\n  } else if vs.any(v -> v.ty is check.TInt) {\n    return None\n  } else {\n    \"ptr\"\n  }\n  n := len(cells)\n  xs := join(cells, \", \")\n  name := \"@.list.\" + codegen.hex(codegen.text_hash(xs).to_int(), 15)\n  if !codegen.has_helper(g, name) {\n    codegen.add_helper(mut g, name)\n    mut g.globals.push(\n      f\"{name}.buf = private global {{ i64, i64, i64, [{n} x {slot}] }} {{ i64 0, i64 {n}, i64 {n}, [{n} x {slot}] [{xs}] }}, align 8\",\n    )\n    mut g.globals.push(\n      f\"{name} = private unnamed_addr constant {{ i64, i64, ptr, i64 }} {{ i64 0, i64 {n}, ptr getelementptr inbounds (i8, ptr {name}.buf, i64 8), i64 0 }}, align 8\",\n    )\n  }\n  Some(codegen.V {\n    ty: check.TList(et),\n    op: f\"getelementptr inbounds (i8, ptr {name}, i64 8)\",\n  })\n}","old_text":"/// A non-empty list literal whose elements are all constants (`Int`\n/// literals, string constants, field-less constructors) as one constant\n/// block: a header and a buffer with counts of 0, emitted once per program\n/// and never counted or freed. The buffer is writable data:\n/// `list_extend` claims its slots by writing the slots used, unchanged, when\n/// it adds no element. Named by a hash of its elements' code, so the\n/// same literal anywhere is the same block. `None` for any other list.\nfn constant_list(\n  mut g: codegen.Gen,\n  vs: List[codegen.V],\n  et: Ty,\n) -> Option[codegen.V] {\n  if vs == [] || codegen.sized(et) is Some {\n    return None\n  }\n  mut cells := []\n  for v in vs {\n    cell := match v.ty {\n      TInt => if parse_int(v.op) is Some {\n        \"i64 \" + v.op\n      } else {\n        return None\n      },\n      TStr | TNamed { .. } => if starts_with(v.op, \"getelementptr inbounds (i8, ptr @\") {\n        \"ptr \" + v.op\n      } else {\n        return None\n      },\n      _ => return None,\n    }\n    mut cells.push(cell)\n  }\n  // one IR type for the slots: all `i64` or all `ptr`\n  slot := if vs.all(v -> v.ty is TInt) {\n    \"i64\"\n  } else if vs.any(v -> v.ty is TInt) {\n    return None\n  } else {\n    \"ptr\"\n  }\n  n := len(cells)\n  xs := join(cells, \", \")\n  name := \"@.list.\" + codegen.hex(codegen.text_hash(xs).to_int(), 15)\n  if !codegen.has_helper(g, name) {\n    codegen.add_helper(mut g, name)\n    mut g.globals.push(\n      f\"{name}.buf = private global {{ i64, i64, i64, [{n} x {slot}] }} {{ i64 0, i64 {n}, i64 {n}, [{n} x {slot}] [{xs}] }}, align 8\",\n    )\n    mut g.globals.push(\n      f\"{name} = private unnamed_addr constant {{ i64, i64, ptr, i64 }} {{ i64 0, i64 {n}, ptr getelementptr inbounds (i8, ptr {name}.buf, i64 8), i64 0 }}, align 8\",\n    )\n  }\n  Some(codegen.V {\n    ty: TList(et),\n    op: f\"getelementptr inbounds (i8, ptr {name}, i64 8)\",\n  })\n}"},{"name":"codegen.small_words","kind":"fn","old":"894ba5945ef06d4e","new":"f920310f55d37d15","interface_changed":true,"affected":["codegen.unwound_exit","codegen.result_phi","codegen.expr_node","codegen.by_words","codegen.result_ll","codegen.load_words","codegen.stack_words","codegen.result_block","codegen.result_words","codegen.words_value","codegen.words_fn","codegen.box_fn","codegen.held_words","codegen.unbox_fn","codegen.reusable","codegen.assign_held","codegen.function","codegen.lambda_shown","codegen.expr","codegen.call_at","codegen.call_fn_want","codegen.declaration_of","codegen.call_words","codegen.construct_want","codegen.give_result","codegen.assigned_call","codegen.stmt_node","codegen.compiled_alone","codegen.function_value","codegen.lambda","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.method_call","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codeg