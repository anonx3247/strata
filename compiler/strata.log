,"program_objects","comptime_values","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.generated_args","codegen.makers","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// Whether `x.path = v` can change `x`'s value in place along the whole\n/// path, when nothing else holds the records on it. Each step must be a\n/// field of a tuple, or of a record with one constructor that is not\n/// `distinct` and has no refinement of its own. `x` must not be declared\n/// with a refined type.\nfn in_place_path(\n  g: codegen.Gen,\n  l: codegen.Local,\n  t: check.Ty,\n  path: List[String],\n) -> Bool {\n  if path == [] || contains(g.declared, l.slot) {\n    return false\n  }\n  mut owner := t\n  for f in path {\n    if codegen.boxed(g, owner) {\n      return false\n    }\n    match owner {\n      check.TNamed { name, .. } => if codegen.field_index(g, owner, f).0 < 0\n        || contains(g.distincts, name)\n        || contains(g.refines, name) {\n        return false\n      },\n      _ => return false,\n    }\n    owner = codegen.field_index(g, owner, f).1\n  }\n  true\n}","old_text":"/// Whether `x.path = v` can change `x`'s value in place along the whole\n/// path, when nothing else holds the records on it. Each step must be a\n/// field of a tuple, or of a record with one constructor that is not\n/// `distinct` and has no refinement of its own. `x` must not be declared\n/// with a refined type.\nfn in_place_path(\n  g: codegen.Gen,\n  l: codegen.Local,\n  t: Ty,\n  path: List[String],\n) -> Bool {\n  if path == [] || contains(g.declared, l.slot) {\n    return false\n  }\n  mut owner := t\n  for f in path {\n    if codegen.boxed(g, owner) {\n      return false\n    }\n    match owner {\n      TNamed { name, .. } => if codegen.field_index(g, owner, f).0 < 0\n        || contains(g.distincts, name)\n        || contains(g.refines, name) {\n        return false\n      },\n      _ => return false,\n    }\n    owner = codegen.field_index(g, owner, f).1\n  }\n  true\n}"},{"name":"codegen.walkable","kind":"fn","old":"79918be34e9ce164","new":"7a94341ed53477ff","interface_changed":true,"affected":["codegen.update_in_place","codegen.appended","codegen.builtin_call","codegen.stmt_node","codegen.call_named","codegen.method_call","codegen.except_expr","codegen.matching_want","codegen.stmt","codegen.expr_node","codegen.expr_want_node","codegen.matching","codegen.block_expr","codegen.iterate","codegen.decreases_start","codegen.decreases_pass","codegen.decreases_entry","codegen.decreases_call","codegen.build_fn","codegen.expr","codegen.expr_want","codegen.for_list","codegen.function","codegen.call_fn_want","codegen.built_or_generated","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.try_want","codegen.tag_test","codegen.set_in_place","codegen.take_in_place","codegen.compared","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.declare","codegen.list_literal_of","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.fuzz_driver","codegen.wanted","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.compiled_alone","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.by_variant","codegen.binds","codegen.matching_v","codegen.assertion","codegen.invariants","codegen.tag_is","codegen.check_type","codegen.satisfies","codegen.holds_pred","codegen.entry","codegen.vtable","codegen.mock_table","codegen.mock_call","codegen.list_builtin","codegen.collection_builtin","codegen.produce","codegen.table_find","codegen.generate","codegen.construct","codegen.operands","codegen.if_expr","codegen.try_expr","codegen.get_field","codegen.list_literal","codegen.function_value","codegen.lambda","codegen.show","codegen.shown","codegen.builtin","codegen.string_builtin","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.to_c","codegen.check_payload","codegen.dyn_ctor_is","codegen.has_field_check","codegen.check_field","codegen.assign_at","codegen.gen_data","codegen.check_union","codegen.check_member","codegen.to_dyn","codegen.dyn_table_is","codegen.mock_value","codegen.gen_list","codegen.gen_fn","codegen_with","core_rt_text","computed_value","repl_eval","codegen.session_capability","codegen.spawn_expr","codegen.method_value","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","codegen.foreign_call","codegen.generated","codegen.can_generate","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.session_entry","codegen.helper","codegen.debug_body","codegen.generated_args","codegen.makers","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.equal","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","codegen.read_back","eval_files"],"module":"codegen","text":"/// Whether each step of `path` from a `t` is a field of a record or tuple\n/// (not of a union member), so `held_once_on` can walk it.\nfn walkable(g: codegen.Gen, t: check.Ty, path: List[String]) -> Bool {\n  mut owner := t\n  for f in path {\n    if codegen.boxed(g, owner) {\n      return false\n    }\n    (k, ft) := codegen.field_index(g, owner, f)\n    if k < 0 {\n      return false\n    }\n    owner = ft\n  }\n  true\n}","old_text":"/// Whether each step of `path` from a `t` is a field of a record or tuple\n/// (not of a union member), so `held_once_on` can walk it.\nfn walkable(g: codegen.Gen, t: Ty, path: List[String]) -> Bool {\n  mut owner := t\n  for f in path {\n    if codegen.boxed(g, owner) {\n      return false\n    }\n    (k, ft) := codegen.field_index(g, owner, f)\n    if k < 0 {\n      return false\n    }\n    owner = ft\n  }\n  true\n}"},{"name":"codegen.place_written","kind":"fn","old":"0473cf280ac363c0","new":"5b6b3d9f16d898f5","interface_changed":false,"affected":[],"module":"codegen","text":"/// The written type of a place (`x`'s declared type, a field's written\n/// type), if any.\nfn place_written(g: codegen.Gen, place: ast.Expr) -> Option[ast.TypeExpr] {\n  (x, path) := match codegen.place_of(place) {\n    Some(p) => p,\n    None => return None,\n  }\n  l := match codegen.lookup(g, x) {\n    Some(l) => l,\n    None => return None,\n  }\n  n := len(path)\n  if n == 0 {\n    return get(g.declared, l.slot)\n  }\n  mut owner := l.ty\n  for f in take(path, n - 1) {\n    owner = codegen.field_index(g, owner, f).1\n  }\n  match owner {\n    check.TNamed { name, .. } => if contains(g.types.sums, name) {\n      None\n    } else {\n      codegen.field_written(g, owner, name, get(path, n - 1) ?? \"\")\n    },\n    _ => None,\n  }\n}","old_text":"/// The written type of a place (`x`'s declared type, a field's written\n/// type), if any.\nfn place_written(g: codegen.Gen, place: ast.Expr) -> Option[ast.TypeExpr] {\n  (x, path) := match codegen.place_of(place) {\n    Some(p) => p,\n    None => return None,\n  }\n  l := match codegen.lookup(g, x) {\n    Some(l) => l,\n    None => return None,\n  }\n  n := len(path)\n  if n == 0 {\n    return get(g.declared, l.slot)\n  }\n  mut owner := l.ty\n  for f in take(path, n - 1) {\n    owner = codegen.field_index(g, owner, f).1\n  }\n  match owner {\n    TNamed { name, .. } => if contains(g.types.sums, name) {\n      None\n    } else {\n      codegen.field_written(g, owner, name, get(path, n - 1) ?? \"\")\n    },\n    _ => None,\n  }\n}"},{"name":"codegen.checked_update","kind":"fn","old":"4dac15e76a67f304","new":"0a135f3509ab6093","interface_changed":false,"affected":[],"module":"codegen","text":"/// `x = insert(x, k, v)`, `x.f = push(x.f, e)`, `x = remove(x, k)` where the\n/// place's written type is a `Dict`, `Set` or `List` of refined elements.\n/// The old value already has its type, so only what the update adds is\n/// checked: each argument in order, against its element type, into its own\n/// variable. Every element of the new value is not rechecked.\n/// Returns the update over those variables, and whether it applies (then\n/// the assignment does not check the whole value).\nfn checked_update(\n  mut g: codegen.Gen,\n  place: ast.Expr,\n  value: ast.Expr,\n) -> (ast.Expr, Bool) {\n  t := match codegen.place_written(g, place) {\n    Some(t) => t,\n    None => return (value, false),\n  }\n  if !codegen.needs_check(g, t) {\n    return (value, false)\n  }\n  (name, target, rest, method) := match value {\n    ast.Call { callee: ast.Var(n), args } => match args {\n      [tg, ..more] => (n, tg, more, false),\n      [] => return (value, false),\n    },\n    ast.MethodCall { recv, name: n, args } => (n, recv, args, true),\n    _ => return (value, false),\n  }\n  root := match codegen.place_of(place) {\n    Some(p) => p.0,\n    None => return (value, false),\n  }\n  if target != place\n    || codegen.lookup(g, name) is Some\n    || codegen.has_fn(g, name)\n    || rest.any(a -> codegen.mentions_var(a, root)) {\n    return (value, false)\n  }\n  elems := match (t, name, len(rest)) {\n    (ast.Named { name: \"Dict\", args: [k, v] }, \"insert\", 2) => [k, v],\n    (ast.Named { name: \"Set\", args: [a] }, \"insert\", 1) => [a],\n    (ast.Named { name: \"List\", args: [a] }, \"push\", 1) => [a],\n    (ast.Named { name: \"Dict\", .. }, \"remove\", 1) => return (value, true),\n    (ast.Named { name: \"Set\", .. }, \"remove\", 1) => return (value, true),\n    _ => return (value, false),\n  }\n  (x, path) := codegen.place_of(place) ?? (root, [])\n  ctx := if path == [] {\n    f\"assigning `{x}`\"\n  } else {\n    \"assigning `\" + x + \".\" + join(path, \".\") + \"`\"\n  }\n  // each value's position in fault messages, as a whole-value check says\n  // it: `: element 3`, `: key \"a\"`, `: [\"a\"]`, `: [2]`\n  kind := match t {\n    ast.Named { name, .. } => name,\n    _ => \"\",\n  }\n  mut args := []\n  mut vals := []\n  for (i, a) in enumerate(rest) {\n    et := get(elems, i) ?? t\n    v := codegen.expr_want(mut g, a, codegen.lower(mut g, et))\n    if !(v.ty is check.TAny) && codegen.needs_check(g, et) {\n      more := if kind == \"Set\" {\n        [codegen.lit(mut g, \": element \"), codegen.shown(mut g, v)]\n      } else if kind == \"Dict\" && i == 0 {\n        [codegen.lit(mut g, \": key \"), codegen.shown(mut g, v)]\n      } else if kind == \"Dict\" {\n        k := get(vals, 0) ?? v\n        [\n          codegen.lit(mut g, \": [\"),\n          codegen.shown(mut g, k),\n          codegen.lit(mut g, \"]\"),\n        ]\n      } else {\n        // a list's new element: its index is the list's length\n        cur := match codegen.lookup(g, x) {\n          Some(l) => codegen.get_path(mut g, codegen.load(mut g, l), path),\n          None => v,\n        }\n        n := codegen.list_len(mut g, cur)\n        idx := codegen.call(mut g, check.TStr, \"strata_show_int\", [n])\n        [codegen.lit(mut g, \": [\"), idx, codegen.lit(mut g, \"]\")]\n      }\n      codegen.check_type(mut g, et, v, ctx, more)\n    }\n    mut vals.push(v)\n    r := codegen.fresh(mut g, \"elem\")\n    n := \"$\" + byte_slice(r, 1, byte_len(r))\n    codegen.local_owned(mut g, n, v)\n    mut args.push(ast.Var(n))\n  }\n  updated := if method {\n    ast.MethodCall { recv: target, name, args }\n  } else {\n    ast.Call { callee: ast.Var(name), args: [target] + args }\n  }\n  (updated, true)\n}","old_text":"/// `x = insert(x, k, v)`, `x.f = push(x.f, e)`, `x = remove(x, k)` where the\n/// place's written type is a `Dict`, `Set` or `List` of refined elements.\n/// The old value already has its type, so only what the update adds is\n/// checked: each argument in order, against its element type, into its own\n/// variable. Every element of the new value is not rechecked.\n/// Returns the update over those variables, and whether it applies (then\n/// the assignment does not check the whole value).\nfn checked_update(\n  mut g: codegen.Gen,\n  place: ast.Expr,\n  value: ast.Expr,\n) -> (ast.Expr, Bool) {\n  t := match codegen.place_written(g, place) {\n    Some(t) => t,\n    None => return (value, false),\n  }\n  if !codegen.needs_check(g, t) {\n    return (value, false)\n  }\n  (name, target, rest, method) := match value {\n    ast.Call { callee: ast.Var(n), args } => match args {\n      [tg, ..more] => (n, tg, more, false),\n      [] => return (value, false),\n    },\n    ast.MethodCall { recv, name: n, args } => (n, recv, args, true),\n    _ => return (value, false),\n  }\n  root := match codegen.place_of(place) {\n    Some(p) => p.0,\n    None => return (value, false),\n  }\n  if target != place\n    || codegen.lookup(g, name) is Some\n    || codegen.has_fn(g, name)\n    || rest.any(a -> codegen.mentions_var(a, root)) {\n    return (value, false)\n  }\n  elems := match (t, name, len(rest)) {\n    (ast.Named { name: \"Dict\", args: [k, v] }, \"insert\", 2) => [k, v],\n    (ast.Named { name: \"Set\", args: [a] }, \"insert\", 1) => [a],\n    (ast.Named { name: \"List\", args: [a] }, \"push\", 1) => [a],\n    (ast.Named { name: \"Dict\", .. }, \"remove\", 1) => return (value, true),\n    (ast.Named { name: \"Set\", .. }, \"remove\", 1) => return (value, true),\n    _ => return (value, false),\n  }\n  (x, path) := codegen.place_of(place) ?? (root, [])\n  ctx := if path == [] {\n    f\"assigning `{x}`\"\n  } else {\n    \"assigning `\" + x + \".\" + join(path, \".\") + \"`\"\n  }\n  // each value's position in fault messages, as a whole-value check says\n  // it: `: element 3`, `: key \"a\"`, `: [\"a\"]`, `: [2]`\n  kind := match t {\n    ast.Named { name, .. } => name,\n    _ => \"\",\n  }\n  mut args := []\n  mut vals := []\n  for (i, a) in enumerate(rest) {\n    et := get(elems, i) ?? t\n    v := codegen.expr_want(mut g, a, codegen.lower(mut g, et))\n    if !(v.ty is TAny) && codegen.needs_check(g, et) {\n      more := if kind == \"Set\" {\n        [codegen.lit(mut g, \": element \"), codegen.shown(mut g, v)]\n      } else if kind == \"Dict\" && i == 0 {\n        [codegen.lit(mut g, \": key \"), codegen.shown(mut g, v)]\n      } else if kind == \"Dict\" {\n        k := get(vals, 0) ?? v\n        [\n          codegen.lit(mut g, \": [\"),\n          codegen.shown(mut g, k),\n          codegen.lit(mut g, \"]\"),\n        ]\n      } else {\n        // a list's new element: its index is the list's length\n        cur := match codegen.lookup(g, x) {\n          Some(l) => codegen.get_path(mut g, codegen.load(mut g, l), path),\n          None => v,\n        }\n        n := codegen.list_len(mut g, cur)\n        idx := codegen.call(mut g, TStr, \"strata_show_int\", [n])\n        [codegen.lit(mut g, \": [\"), idx, codegen.lit(mut g, \"]\")]\n      }\n      codegen.check_type(mut g, et, v, ctx, more)\n    }\n    mut vals.push(v)\n    r := codegen.fresh(mut g, \"elem\")\n    n := \"$\" + byte_slice(r, 1, byte_len(r))\n    codegen.local_owned(mut g, n, v)\n    mut args.push(ast.Var(n))\n  }\n  updated := if method {\n    ast.MethodCall { recv: target, name, args }\n  } else {\n    ast.Call { callee: ast.Var(name), args: [target] + args }\n  }\n  (updated, true)\n}"},{"name":"codegen.appended","kind":"fn","old":"f12a38bdecda87c5","new":"9b3afe348ff46938","interface_changed":false,"affected":[],"module":"codegen","text":"/// `x = x + e` (`x += e`) on a list or string, with `x` a place. Extends `x`\n/// (`strata_list_extend`, `strata_str_append`) in place when possible:\n/// - a list: its buffer has room past its end that no other list sharing\n/// it has used\n/// - a string: only the place holds it, and the records on the place's\n/// path are held once\n/// Else into a new block with room for as much again, so repeated\n/// extension copies O(log n) times. `None` when `value` is not such a `+`.\nfn appended(\n  mut g: codegen.Gen,\n  place: ast.Expr,\n  value: ast.Expr,\n) -> Option[codegen.V] {\n  right := match value {\n    ast.Binary { op: ast.Add, left, right } => if left == place {\n      right\n    } else {\n      return None\n    },\n    _ => return None,\n  }\n  (x, path) := match codegen.place_of(place) {\n    Some(p) => p,\n    None => return None,\n  }\n  l := match codegen.lookup(g, x) {\n    Some(l) => l,\n    None => return None,\n  }\n  if !codegen.walkable(g, l.ty, path) {\n    return None\n  }\n  root := codegen.load(mut g, l)\n  cur := codegen.get_path(mut g, root, path)\n  match cur.ty {\n    check.TList(et) => {\n      r := codegen.expr_want(mut g, right, cur.ty)\n      if r.ty is check.TAny {\n        return Some(r)\n      }\n      t := codegen.better(cur.ty, r.ty)\n      k := codegen.elements_kind(match t {\n        check.TList(e) => e,\n        _ => et,\n      })\n      if g.copies {\n        rn := codegen.list_len(mut g, r)\n        codegen.note_extension(mut g, cur, rn.op)\n      }\n      Some(\n        codegen.call(mut g, t, \"strata_list_extend\", [cur, r, k]),\n      )\n    },\n    check.TStr => {\n      r := codegen.expr_want(mut g, right, check.TStr)\n      if r.ty is check.TAny {\n        return Some(r)\n      }\n      mine := if path == [] {\n        \"true\"\n      } else {\n        codegen.held_once_on(\n          mut g,\n          root,\n          path,\n          codegen.proven_on(g, place),\n        )\n      }\n      if g.copies {\n        codegen.use_rt(mut g, \"strata_copies_append\")\n        site := codegen.site_of(mut g)\n        codegen.emit(\n          mut g,\n          f\"call void @strata_copies_append(ptr {cur.op}, i1 {mine}, ptr {site})\",\n        )\n      }\n      Some(codegen.call(\n        mut g,\n        check.TStr,\n        \"strata_str_append\",\n        [cur, r, codegen.V { ty: check.TBool, op: mine }],\n      ))\n    },\n    _ => None,\n  }\n}","old_text":"/// `x = x + e` (`x += e`) on a list or string, with `x` a place. Extends `x`\n/// (`strata_list_extend`, `strata_str_append`) in place when possible:\n/// - a list: its buffer has room past its end that no other list sharing\n/// it has used\n/// - a string: only the place holds it, and the records on the place's\n/// path are held once\n/// Else into a new block with room for as much again, so repeated\n/// extension copies O(log n) times. `None` when `value` is not such a `+`.\nfn appended(\n  mut g: codegen.Gen,\n  place: ast.Expr,\n  value: ast.Expr,\n) -> Option[codegen.V] {\n  right := match value {\n    ast.Binary { op: ast.Add, left, right } => if left == place {\n      right\n    } else {\n      return None\n    },\n    _ => return None,\n  }\n  (x, path) := match codegen.place_of(place) {\n    Some(p) => p,\n    None => return None,\n  }\n  l := match codegen.lookup(g, x) {\n    Some(l) => l,\n    None => return None,\n  }\n  if !codegen.walkable(g, l.ty, path) {\n    return None\n  }\n  root := codegen.load(mut g, l)\n  cur := codegen.get_path(mut g, root, path)\n  match cur.ty {\n    TList(et) => {\n      r := codegen.expr_want(mut g, right, cur.ty)\n      if r.ty is TAny {\n        return Some(r)\n      }\n      t := codegen.better(cur.ty, r.ty)\n      k := codegen.elements_kind(match t {\n        TList(e) => e,\n        _ => et,\n      })\n      if g.copies {\n        rn := codegen.list_len(mut g, r)\n        codegen.note_extension(mut g, cur, rn.op)\n      }\n      Some(\n        codegen.call(mut g, t, \"strata_list_extend\", [cur, r, k]),\n      )\n    },\n    TStr => {\n      r := codegen.expr_want(mut g, right, TStr)\n      if r.ty is TAny {\n        return Some(r)\n      }\n      mine := if path == [] {\n        \"true\"\n      } else {\n        codegen.held_once_on(\n          mut g,\n          root,\n          path,\n          codegen.proven_on(g, place),\n        )\n      }\n      if g.copies {\n        codegen.use_rt(mut g, \"strata_copies_append\")\n        site := codegen.site_of(mut g)\n        codegen.emit(\n          mut g,\n          f\"call void @strata_copies_append(ptr {cur.op}, i1 {mine}, ptr {site})\",\n        )\n      }\n      Some(codegen.call(\n        mut g,\n        TStr,\n        \"strata_str_append\",\n        [cur, r, codegen.V { ty: TBool, op: mine }],\n      ))\n    },\n    _ => None,\n  }\n}"},{"name":"codegen.copied_what","kind":"fn","old":"bde7dadb1b573b6e","new":"941df7897a6376f6","interface_changed":true,"affected":["codegen.note_copy","codegen.note_extension","codegen.collection_builtin","codegen.set_field_in_place","codegen.update_in_place","codegen.list_builtin","codegen.appended","codegen.push_in_place","codegen.builtin","codegen.gen_list","codegen.converted","codegen.assign_at","codegen.builtin_call","codegen.stmt_node","codegen.take_in_place","codegen.call_named","codegen.produce","codegen.list_literal_of","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.table_find","codegen.set_in_place","codegen.expr_want_node","codegen.call_fn_want","codegen.method_call","codegen.dyn_call","codegen.except_expr","codegen.matching_want","codegen.stmt","codegen.expr_node","codegen.gen_fn","codegen.list_literal","codegen.construct","codegen.operands","codegen.binary","codegen.branch_value","codegen.mock_call","codegen.expr_want","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.matching","codegen.block_expr","codegen.iterate","codegen.decreases_start","codegen.decreases_pass","codegen.decreases_entry","codegen.decreases_call","codegen.build_fn","codegen.expr","codegen.generated","codegen.can_generate","codegen.main_arg","codegen.session_capability","codegen.for_loop","codegen.union_call","codegen.dyn_generic_call","codegen.compared","codegen.if_want","codegen.matching_v","codegen.match_got","codegen.function","codegen.declare","codegen.destructure","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.try_want","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.checked_update","codegen.show","codegen.shown","codegen.string_builtin","cod