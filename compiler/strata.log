      check.TFn { params: out, ret: codegen.better(r, q) }\n    } else {\n      a\n    },\n    (check.TNamed { name, args: xs }, check.TNamed { args: ys, .. }) => if len(xs) == len(ys) {\n      mut out := []\n      for (k, x) in enumerate(xs) {\n        mut out.push(codegen.better(x, get(ys, k) ?? check.TAny))\n      }\n      check.TNamed { name, args: out }\n    } else {\n      a\n    },\n    _ => a,\n  }\n}","old_text":"/// The more precise of two views of a value's type: `Option[_]` and\n/// `Option[Int]` give `Option[Int]`.\nfn better(a: Ty, b: Ty) -> Ty {\n  match (a, b) {\n    (TAny, _) => b,\n    (TList(x), TList(y)) => TList(codegen.better(x, y)),\n    (TFn { params: xs, ret: r }, TFn { params: ys, ret: q }) => if len(xs) == len(ys) {\n      mut out := []\n      for (k, x) in enumerate(xs) {\n        mut out.push(codegen.better(x, get(ys, k) ?? TAny))\n      }\n      TFn { params: out, ret: codegen.better(r, q) }\n    } else {\n      a\n    },\n    (TNamed { name, args: xs }, TNamed { args: ys, .. }) => if len(xs) == len(ys) {\n      mut out := []\n      for (k, x) in enumerate(xs) {\n        mut out.push(codegen.better(x, get(ys, k) ?? TAny))\n      }\n      TNamed { name, args: out }\n    } else {\n      a\n    },\n    _ => a,\n  }\n}"},{"name":"codegen.bind_gen","kind":"fn","old":"d95f05e0751ea268","new":"c46170d34e13fab8","interface_changed":true,"affected":["codegen.call_fn_want","codegen.bind_bounds","codegen.impl_args","codegen.construct_want","codegen.self_want","codegen.written_args","codegen.impl_written","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.construct","codegen.expr_want_node","codegen.expr_node","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.builtin_call","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.m