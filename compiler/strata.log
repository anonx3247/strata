holds values: its helpers look at the known parts.\n  if t is check.TAny {\n    return \"null\"\n  }\n  name := f\"@\\\"tbl.{what}:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  saved := g\n  g.lines = []\n  g.proving = \"\"\n  g.can_unwind = false\n  g.unwinds = false\n  g.unwind_chain = []\n  g.allocas = []\n  g.next = 0\n  g.scopes = [codegen.no_scope()]\n  g.loops = []\n  codegen.block(mut g, \"start\")\n  a := codegen.from_slot(mut g, \"%x\", t)\n  if what == \"hash\" {\n    f := codegen.hash_helper(mut g, t)\n    codegen.emit(\n      mut g,\n      f\"%res = call i64 {f}({codegen.args_of([a])})\",\n    )\n  } else {\n    b := codegen.from_slot(mut g, \"%y\", t)\n    if what == \"cmp\" {\n      f := codegen.cmp_helper(mut g, t)\n      codegen.emit(\n        mut g,\n        f\"%res = call i64 {f}({codegen.args_of([a, b])})\",\n      )\n    } else {\n      e := codegen.equal(mut g, a, b)\n      codegen.emit(mut g, f\"%res = zext i1 {e.op} to i64\")\n    }\n  }\n  codegen.emit(mut g, \"ret i64 %res\")\n  sig := if what == \"hash\" {\n    f\"define i64 {name}(i64 %x)\"\n  } else {\n    f\"define i64 {name}(i64 %x, i64 %y)\"\n  }\n  def := join([sig + \" {\"]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, def)\n  name\n}","old_text":"/// A function of runtime.c's tables on 64-bit slots holding values of type\n/// `t`:\n/// - `hash`: `i64 (i64)`, the structural hash (`hash_helper`)\n/// - `cmp`: `i64 (i64, i64)`, the order (`cmp_helper`)\n/// - `eq`: `i64 (i64, i64)`, 1 when `==`\nfn slot_fn(mut g: codegen.Gen, what: String, t: Ty) -> String {\n  // a table of a type not yet known: empty, never searched. One whose type\n  // is known in part (`Entry[_]`, in an instance whose type arguments the\n  // code doesn't tell) holds values: its helpers look at the known parts.\n  if t is TAny {\n    return \"null\"\n  }\n  name := f\"@\\\"tbl.{what}:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  saved := g\n  g.lines = []\n  g.proving = \"\"\n  g.can_unwind = false\n  g.unwinds = false\n  g.unwind_chain = []\n  g.allocas = []\n  g.next = 0\n  g.scopes = [codegen.no_scope()]\n  g.loops = []\n  codegen.block(mut g, \"start\")\n  a := codegen.from_slot(mut g, \"%x\", t)\n  if what == \"hash\" {\n    f := codegen.hash_helper(mut g, t)\n    codegen.emit(\n      mut g,\n      f\"%res = call i64 {f}({codegen.args_of([a])})\",\n    )\n  } else {\n    b := codegen.from_slot(mut g, \"%y\", t)\n    if what == \"cmp\" {\n      f := codegen.cmp_helper(mut g, t)\n      codegen.emit(\n        mut g,\n        f\"%res = call i64 {f}({codegen.args_of([a, b])})\",\n      )\n    } else {\n      e := codegen.equal(mut g, a, b)\n      codegen.emit(mut g, f\"%res = zext i1 {e.op} to i64\")\n    }\n  }\n  codegen.emit(mut g, \"ret i64 %res\")\n  sig := if what == \"hash\" {\n    f\"define i64 {name}(i64 %x)\"\n  } else {\n    f\"define i64 {name}(i64 %x, i64 %y)\"\n  }\n  def := join([sig + \" {\"]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, def)\n  name\n}"},{"name":"codegen.hash_helper","kind":"fn","old":"5ceab7ec1aa368fd","new":"34c3c05c994825e4","interface_changed":true,"affected":["codegen.slot_fn","codegen.hash_fields","codegen.equal","codegen.cmp_helper","codegen.table_fns","codegen.apply","codegen.eq_fields","codegen.matches","codegen.eq_list","codegen.dyn_wrapper","codegen.union_eq","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.collection_builtin","codegen.update_in_place","codegen.table_from","codegen.binary","codegen.number_builtin","codegen.checked","codegen.eq_body","codegen.destructure","codegen.binds","codegen.for_loop","codegen.matching_v","codegen.match_got","codegen.helper","codegen.vtable","co