a value of type `t` crosses a call in, when it is\n/// small: a tuple, or a type with constructors (records, sums, `Option`,\n/// `Result`) without a refinement of its own, whose largest constructor's\n/// fields and, with more than one constructor, the tag fit in 4 words. 0\n/// for any other type: its values are always pointers to blocks.\nfn small_words(g: codegen.Gen, t: check.Ty) -> Int {\n  (multi, cs) := codegen.small_layout(g, t)\n  if cs == [] {\n    return 0\n  }\n  mut most := 0\n  for c in cs {\n    // (a field of a type not known here: neither held nor dropped by it)\n    if c.1.any(ft -> ft is check.TAny || ft is check.TGen) {\n      return 0\n    }\n    if len(c.1) > most {\n      most = len(c.1)\n    }\n  }\n  words := if multi {\n    most + 1\n  } else {\n    most\n  }\n  if most > 0 && words <= 4 {\n    words\n  } else {\n    0\n  }\n}","old_text":"/// How many 64-bit words a value of type `t` crosses a call in, when it is\n/// small: a tuple, or a type with constructors (records, sums, `Option`,\n/// `Result`) without a refinement of its own, whose largest constructor's\n/// fields and, with more than one constructor, the tag fit in 4 words. 0\n/// for any other type: its values are always pointers to blocks.\nfn small_words(g: codegen.Gen, t: Ty) -> Int {\n  (multi, cs) := codegen.small_layout(g, t)\n  if cs == [] {\n    return 0\n  }\n  mut most := 0\n  for c in cs {\n    // (a field of a type not known here: neither held nor dropped by it)\n    if c.1.any(ft -> ft is TAny || ft is TGen) {\n      return 0\n    }\n    if len(c.1) > most {\n      most = len(c.1)\n    }\n  }\n  words := if multi {\n    most + 1\n  } else {\n    most\n  }\n  if most > 0 && words <= 4 {\n    words\n  } else {\n    0\n  }\n}"},{"name":"codegen.small_layout","kind":"fn","old":"7ba177cc749ab02f","new":"04941e7cf9ec6682","interface_changed":true,"affected":["codegen.small_words","codegen.load_words","codegen.stack_words","codegen.result_block","codegen.words_fn","codegen