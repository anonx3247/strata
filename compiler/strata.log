n  saved := g\n  codegen.start_helper(mut g)\n  codegen.emit(mut g, f\"%given = extractvalue {ty} %w, 0\")\n  codegen.emit(mut g, \"%none = icmp eq ptr %given, null\")\n  codegen.emit(mut g, \"br i1 %none, label %words, label %block\")\n  codegen.block(mut g, \"block\")\n  codegen.emit(mut g, \"ret ptr %given\")\n  codegen.block(mut g, \"words\")\n  most := if multi {\n    n - 1\n  } else {\n    n\n  }\n  tg := if multi {\n    x := codegen.fresh(mut g, \"tag\")\n    codegen.emit(mut g, f\"{x} = extractvalue {ty} %w, 1\")\n    // a constructor without fields: its constant\n    for c in cs.filter(c -> len(c.1) == 0) {\n      (hit, yes, no) := (\n        codegen.fresh(mut g, \"is\"),\n        codegen.label(mut g, \"const\"),\n        codegen.label(mut g, \"made\"),\n      )\n      codegen.emit(\n        mut g,\n        f\"{hit} = icmp eq i64 {x}, {codegen.tag_word(g, c.0)}\",\n      )\n      codegen.emit(mut g, f\"br i1 {hit}, label %{yes}, label %{no}\")\n      codegen.block(mut g, yes)\n      codegen.emit(mut g, f\"ret ptr {codegen.nullary(mut g, c.0)}\")\n      codegen.block(mut g, no)\n    }\n    x\n  } else {\n    to_string(codegen.tag_word(g, (get(cs, 0) ?? (\"\", [])).0))\n  }\n  codegen.emit(\n    mut g,\n    f\"%p = call ptr @strata_alloc(i64 {8 * (most + 1)})\",\n  )\n  codegen.emit(mut g, f\"store i64 {tg}, ptr %p\")\n  off := if multi {\n    2\n  } else {\n    1\n  }\n  for k in 0..most {\n    (x, at) := (codegen.fresh(mut g, \"wd\"), codegen.fresh(mut g, \"at\"))\n    codegen.emit(mut g, f\"{x} = extractvalue {ty} %w, {k + off}\")\n    codegen.emit(\n      mut g,\n      f\"{at} = getelementptr i64, ptr %p, i64 {k + 1}\",\n    )\n    codegen.emit(mut g, f\"store i64 {x}, ptr {at}\")\n  }\n  codegen.emit(mut g, \"ret ptr %p\")\n  codegen.restore(\n    mut g,\n    saved,\n    codegen.helper_text(g, f\"define internal ptr {name}({ty} %w)\"),\n  )\n  name\n}","old_text":"/// The function making what a call gave (`words_ll`) a value of small type\n/// `t` held by one block (`@\"box:T\"`): the block given, else a heap block\n/// of the words, what the fields hold moved into it. A constructor without\n/// fields gives its constant (`None`), as constructing it does. At most\n/// one allocation, of the largest constructor's size.\nfn box_fn(mut g: codegen.Gen, t: Ty) -> String {\n  name := f\"@\\\"box:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  codegen.use_rt(mut g, \"strata_alloc\")\n  n := codegen.small_words(g, t)\n  ty := codegen.words_ll(n)\n  (multi, cs) := codegen.small_layout(g, t)\n  saved := g\n  codegen.start_helper(mut g)\n  codegen.emit(mut g, f\"%given = extractvalue {ty} %w, 0\")\n  codegen.emit(mut g, \"%none = icmp eq ptr %given, null\")\n  codegen.emit(mut g, \"br i1 %none, label %words, label %block\")\n  codegen.block(mut g, \"block\")\n  codegen.emit(mut g, \"ret ptr %given\")\n  codegen.block(mut g, \"words\")\n  most := if multi {\n    n - 1\n  } else {\n    n\n  }\n  tg := if multi {\n    x := codegen.fresh(mut g, \"tag\")\n    codegen.emit(mut g, f\"{x} = extractvalue {ty} %w, 1\")\n    // a constructor without fields: its constant\n    for c in cs.filter(c -> len(c.1) == 0) {\n      (hit, yes, no) := (\n        codegen.fresh(mut g, \"is\"),\n        codegen.label(mut g, \"const\"),\n        codegen.label(mut g, \"made\"),\n      )\n      codegen.emit(\n        mut g,\n        f\"{hit} = icmp eq i64 {x}, {codegen.tag_word(g, c.0)}\",\n      )\n      codegen.emit(mut g, f\"br i1 {hit}, label %{yes}, label %{no}\")\n      codegen.block(mut g, yes)\n      codegen.emit(mut g, f\"ret ptr {codegen.nullary(mut g, c.0)}\")\n      codegen.block(mut g, no)\n    }\n    x\n  } else {\n    to_string(codegen.tag_word(g, (get(cs, 0) ?? (\"\", [])).0))\n  }\n  codegen.emit(\n    mut g,\n    f\"%p = call ptr @strata_alloc(i64 {8 * (most + 1)})\",\n  )\n  codegen.emit(mut g, f\"store i64 {tg}, ptr %p\")\n  off := if multi {\n    2\n  } else {\n    1\n  }\n  for k in 0..most {\n    (x, at) := (codegen.fresh(mut g, \"wd\"), codegen.fresh(mut g, \"at\"))\n    codegen.emit(mut g, f\"{x} = extractvalue {ty} %w, {k + off}\")\n    codegen.emit(\n      mut g,\n      f\"{at} = getelementptr i64, ptr %p, i64 {k + 1}\",\n    )\n    codegen.emit(mut g, f\"store i64 {x}, ptr {at}\")\n  }\n  codegen.emit(mut g, \"ret ptr %p\")\n  codegen.restore(\n    mut g,\n    saved,\n    codegen.helper_text(g, f\"define internal ptr {name}({ty} %w)\"),\n  )\n  name\n}"},{"name":"codegen.fields_drop_fn","kind":"fn","old":"430984f26fe37c1f","new":"2944e5ffcf0996ae","interface_changed":true,"affected":["codegen.drop_stacked","codegen.assign_held","codegen.drop_scope","codegen.unwind_all","codegen.drop_held","codegen.stmt_node","codegen.pop_scope","codegen.drop_from","codegen.unwind_here","codegen.cancel_point_after","codegen.stmt","codegen.tag_is","codegen.leave_branch","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.debug_list","codegen.block_expr","codegen.call_fn_want","codegen.with_it","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.invariants","codegen.iterate","codegen.await_list","codegen.select_expr","codegen.race_expr","codegen.satisfies","codegen.produce","codegen.gen_list","codegen.gen_data","codegen.mock_method","codegen.check_payload","codegen.check_union","codegen.trace_enter","codegen.trace_leave","codegen.update_in_place","codegen.set_in_place","codegen.put_in","codegen.take_in_place","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.push_in_place","codegen.entry","codegen.fault","codegen.ret_owned","codegen.dyn_wrapper","codegen.options","codegen.fuzz_driver","codegen.call_entry","codegen.leave_with","codegen.session_entry","codegen.export_entry","codegen.call_closure","codegen.cancel_point","codegen.dyn_entry_at","codegen.words_value","codegen.decreases_start","codegen.decreases_entry","codegen.to_c","codegen.dyn_ctor_is","