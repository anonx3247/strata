,"smt.fresh_keyed","smt.list_set","smt.map_key","smt.ctor_terms","smt.arith","smt.bits","smt.compare","smt.builtin_faults","smt.concat","smt.arm_slots","smt.lists_alike","shown_names","tour.interface_of","done_command","sync_command","repl_load","merge.follow_rename","finding.find_command","unique.analyzed","unique.loop_flow","finding.uses_from","finding.used_by_tree","codegen.drop_scope","codegen.task_fns","codegen.tries_end","codegen.unwind_all","codegen.drop_held","codegen.region_hold","codegen.debug_body","codegen.fields_drop_fn","codegen.await_one","codegen.words_value","tour.prepare","smt.eq_list_values","smt.list_valid","diff.put","diff.log_steps","diff.states","diff.log_range","diff.decoded","diff.git_range","diff.step","binary.encode_bundle","codebase.encode_files","store_check","encode_at","pack_command","script_bytes","eval.world","shared_at","load_found","closure_keys","closure_keys_of","use_errors_from","resolve.errors","codebase.changes","finding.source_of","finding.library_source","chosen_in","merge.set_member_name","pending.changed_names","pending.variants_of","pending.decl_short","tour.page_rows","tour.show","unused_of","stored_package","upgrade_command","stored_one","stored_lines","others_at_stored","resolve.opt_ty","resolve.types","resolve.expr","resolve.func","resolve.fields","resolve.params_of","resolve.decl_kind","smt.outcome","smt.different","unique.proven_sites","finding.uses_tree","codegen.pop_scope","codegen.drop_from","codegen.supervised_fns","codegen.unwind_here","codegen.cancel_point_after","codegen.region_block","codegen.call_at","diff.sources_at","tour.side_range","resolve_command","shared","load_package","with_dependencies","use_errors_of","use_errors","tour.printed","tour.screen","tour.browse","tour.replayed","stored_files","resolve.stmt","resolve.bounds","resolve.pat","resolve.call","resolve.exprs","resolve.named","resolve.opt","resolve.relocated","smt.solve","codegen.leave_branch","codegen.fault","codegen.ret_owned","codegen.leave_with","codegen.cancel_point","codegen.dyn_entry_at","codegen.call","binary.trait_decl","dep_test_decls","files_decls","resolve.pats","package_roots","take_entry","codegen.from_c","codegen.after_builtin","codegen.dyn_entry","codegen.int_lit","codegen.concat","codegen.finite","codegen.slice_raw","codegen.word_to_int","codegen.mem_builtin","codegen.set_copy","codegen.routed","binary.decl","reach","impls","dep_tests","codegen.raw_call","codegen.dyn_equal","codegen.conversion","codegen.list_slice","binary.definition_at","binary.decode_interface","load","roots.closure_rule","roots.counted_source","check.methods_of","check.with_code","finding.names","impl_instance","for_impl_decl","method_decl","law_wrapper","verify_wrappers","site_inputs","smt.methods_of","codegen.as_type","binary.decode_definition","binary.entry_with","finding.interface_of","std_imports","kept_value","binary.decode_entry","binary.module_with","finding.decl_of","members_of","lib_scope","binary.decode_module","binary.read_with","binary.decode_module_checked","binary.read","binary.read_checked","tree","same","hashes","decls_of","decode_file","decoded_files","tour.package_decls","bad","derive.implements_trait","diff.diff_text","merge.similarity","smt.valid_known","diff.closure_hash","viewed_program","lint_decls","file_problem","module_decls","package_decls","codegen.outcome","codegen.host_snapshot","diff.close","read_core","own_decls","read_core_at","derived_trait_roots","others_at","open_package_at","status_command","diff.line_diff","open_package"],"module":"text","text":"/// A child as markup, and whether it is bare text. Text is bare unless\n/// reading it back would change it: it holds `<`, `{`, `}` or a line break,\n/// or follows bare text (the two would read as one). Other code is in\n/// braces, unless it is markup itself (only markup's text starts with `<`).\nfn markup_child(x: ast.Expr, d: Int, after_text: Bool) -> (String, Bool) {\n  match x {\n    ast.StrLit(s) => {\n      plain := s != \"\"\n        && !after_text\n        && !contains(s, \"<\")\n        && !contains(s, \"{\")\n        && !contains(s, \"}\")\n        && !contains(s, \"\\n\")\n        && !contains(s, \"\\r\")\n      if plain {\n        (s, true)\n      } else {\n        (\"{\" + text.expr_text(x, d) + \"}\", false)\n      }\n    },\n    _ => {\n      s := text.markup_line(x, d) ?? \"\"\n      if starts_with(s, \"<\") {\n        (s, false)\n      } else {\n        (\"{\" + text.expr_text(x, d) + \"}\", false)\n      }\n    },\n  }\n}","old_text":"/// A child as markup, and whether it is bare text. Text is bare unless\n/// reading it back would change it: it holds `<`, `{`, `}` or a line break,\n/// follows bare text (the two would read as one), or, on a line of its own,\n/// starts or ends with a space. Other code is in braces, unless it is\n/// markup itself (only markup's text starts with `<`).\nfn markup_child(\n  x: ast.Expr,\n  d: Int,\n  broken: Bool,\n  after_text: Bool,\n) -> (String, Bool) {\n  match x {\n    ast.StrLit(s) => {\n      edges := starts_with(s, \" \")\n        || ends_with(s, \" \")\n        || starts_with(s, \"\\t\")\n        || ends_with(s, \"\\t\")\n      plain := s != \"\"\n        && !after_text\n        && !contains(s, \"<\")\n        && !contains(s, \"{\")\n        && !contains(s, \"}\")\n        && !contains(s, \"\\n\")\n        && !contains(s, \"\\r\")\n        && !(broken && edges)\n      if plain {\n        (s, true)\n      } else {\n        (\"{\" + text.expr_text(x, d) + \"}\", false)\n      }\n    },\n    _ => {\n      s := if broken {\n        text.expr_text(x, d)\n      } else {\n        text.markup_line(x, d) ?? \"\"\n      }\n      if starts_with(s, \"<\") {\n        (s, false)\n      } else {\n        (\"{\" + text.expr_text(x, d) + \"}\", false)\n      }\n    },\n  }\n}"},{"name":"text.markup_children_line","kind":"fn","old":null,"new":"0e51552c02c3d8fe","interface_changed":true,"affected":[],"module":"text","text":"/// Children on one line, each as `markup_child` shows it.\nfn markup_children_line(xs: List[ast.Expr], d: Int) -> List[String] {\n  mut out := []\n  mut after_text := false\n  for x in xs {\n    (s, bare) := text.markup_child(x, d, after_text)\n    mut out.push(s)\n    after_text = bare\n  }\n  out\n}"},{"name":"text.markup_lines","kind":"fn","old":null,"new":"de181e6033578184","interface_changed":true,"affected":[],"module":"text","text":"/// Children as lines: as many on a line as fit, an element or code that\n/// takes several lines on lines of its own. A line break drops the spaces\n/// next to it, so bare text with a space where its line starts or ends is\n/// written `{\" …\"}` there.\nfn markup_lines(xs: List[ast.Expr], d: Int) -> List[String] {\n  parts := text.markup_children_line(xs, d)\n  // each line: the children on it, or one child that takes several lines\n  mut groups: List[(List[Int], Bool)] = []\n  mut cur: List[Int] = []\n  mut width := \"\"\n  for (k, s) in enumerate(parts) {\n    multi := contains(s, \"\\n\") || text.too_long(s, d)\n    if len(cur) > 0 && !multi && !text.too_long(width + s, d) {\n      mut cur.push(k)\n      width += s\n      continue\n    }\n    if len(cur) > 0 {\n      mut groups.push((cur, false))\n    }\n    if multi {\n      mut groups.push(([k], true))\n      cur = []\n      width = \"\"\n    } else {\n      cur = [k]\n      width = s\n    }\n  }\n  if len(cur) > 0 {\n    mut groups.push((cur, false))\n  }\n  mut lines := []\n  for (ks, multi) in groups {\n    if multi {\n      x := get(xs, get(ks, 0) ?? 0) ?? ast.UnitExpr\n      s := text.expr_text(x, d)\n      mut lines.push(\n        if starts_with(s, \"<\") || x is ast.StrLit {\n          if x is ast.StrLit {\n            get(parts, get(ks, 0) ?? 0) ?? \"\"\n          } else {\n            s\n          }\n        } else {\n          \"{\" + s + \"}\"\n        },\n      )\n      continue\n    }\n    mut line := \"\"\n    for (j, k) in enumerate(ks) {\n      s := get(parts, k) ?? \"\"\n      x := get(xs, k) ?? ast.UnitExpr\n      at_edge := j == 0 && (starts_with(s, \" \") || starts_with(s, \"\\t\"))\n        || j == len(ks) - 1\n          && (ends_with(s, \" \") || ends_with(s, \"\\t\"))\n      line += if x is ast.StrLit && !starts_with(s, \"{\") && at_edge {\n        \"{\" + text.expr_text(x, d) + \"}\"\n      } else {\n        s\n      }\n    }\n    mut lines.push(line)\n  }\n  lines\n}"}]}
{"id":"edabfed703558c2c","time":1795712779,"message":"edit","changes":[{"name":"text.markup_lines","kind":"fn","old":"de181e6033578184","new":"428c96b44d0349cb","interface_changed":false,"affected":[],"module":"text","text":"/// Children as lines: as many on a line as fit, an element or code that\n/// takes several lines on lines of its own. A line break drops the spaces\n/// next to it, so bare text with a space where its line starts or ends is\n/// written `{\" …\"}` there.\nfn markup_lines(xs: List[ast.Expr], d: Int) -> List[String] {\n  parts := text.markup_children_line(xs, d)\n  // each line: the children on it, or one child that takes several lines\n  mut groups: List[(List[Int], Bool)] = []\n  mut cur: List[Int] = []\n  mut run := \"\"\n  for (k, s) in enumerate(parts) {\n    multi := contains(s, \"\\n\") || text.too_long(s, d)\n    if len(cur) > 0 && !multi && !text.too_long(run + s, d) {\n      mut cur.push(k)\n      run += s\n      continue\n    }\n    if len(cur) > 0 {\n      mut groups.push((cur, false))\n    }\n    if multi {\n      mut groups.push(([k], true))\n      cur = []\n      run = \"\"\n    } else {\n      cur = [k]\n      run = s\n    }\n  }\n  if len(cur) > 0 {\n    mut groups.push((cur, false))\n  }\n  mut lines := []\n  for (ks, multi) in groups {\n    if multi {\n      x := get(xs, get(ks, 0) ?? 0) ?? ast.UnitExpr\n      s := text.expr_text(x, d)\n      mut lines.push(\n        if starts_with(s, \"<\") || x is ast.StrLit {\n          if x is ast.StrLit {\n            get(parts, get(ks, 0) ?? 0) ?? \"\"\n          } else {\n            s\n          }\n        } else {\n          \"{\" + s + \"}\"\n        },\n      )\n      continue\n    }\n    mut line := \"\"\n    for (j, k) in enumerate(ks) {\n      s := get(parts, k) ?? \"\"\n      x := get(xs, k) ?? ast.UnitExpr\n      at_edge := j == 0 && (starts_with(s, \" \") || starts_with(s, \"\\t\"))\n        || j == len(ks) - 1\n          && (ends_with(s, \" \") || ends_with(s, \"\\t\"))\n      line += if x is ast.StrLit && !starts_with(s, \"{\") && at_edge {\n        \"{\" + text.expr_text(x, d) + \"}\"\n      } else {\n        s\n      }\n    }\n    mut lines.push(line)\n  }\n  lines\n}","old_text":"/// Children as lines: as many on a line as fit, an element or code that\n/// takes several lines on lines of its own. A line break drops the spaces\n/// next to it, so bare text with a space where its line starts or ends is\n/// written `{\" …\"}` there.\nfn markup_lines(xs: List[ast.Expr], d: Int) -> List[String] {\n  parts := text.markup_children_line(xs, d)\n  // each line: the children on it, or one child that takes several lines\n  mut groups: List[(List[Int], Bool)] = []\n  mut cur: List[Int] = []\n  mut width := \"\"\n  for (k, s) in enumerate(parts) {\n    multi := contains(s, \"\\n\") || text.too_long(s, d)\n    if len(cur) > 0 && !multi && !text.too_long(width + s, d) {\n      mut cur.push(k)\n      width += s\n      continue\n    }\n    if len(cur) > 0 {\n      mut groups.push((cur, false))\n    }\n    if multi {\n      mut groups.push(([k], true))\n      cur = []\n      width = \"\"\n    } else {\n      cur = [k]\n      width = s\n    }\n  }\n  if len(cur) > 0 {\n    mut groups.push((cur, false))\n  }\n  mut lines := []\n  for (ks, multi) in groups {\n    if multi {\n      x := get(xs, get(ks, 0) ?? 0) ?? ast.UnitExpr\n      s := text.expr_text(x, d)\n      mut lines.push(\n        if starts_with(s, \"<\") || x is ast.StrLit {\n          if x is ast.StrLit {\n            get(parts, get(ks, 0) ?? 0) ?? \"\"\n          } else {\n            s\n          }\n        } else {\n          \"{\" + s + \"}\"\n        },\n      )\n      continue\n    }\n    mut line := \"\"\n    for (j, k) in enumerate(ks) {\n      s := get(parts, k) ?? \"\"\n      x := get(xs, k) ?? ast.UnitExpr\n      at_edge := j == 0 && (starts_with(s, \" \") || starts_with(s, \"\\t\"))\n        || j == len(ks) - 1\n          && (ends_with(s, \" \") || ends_with(s, \"\\t\"))\n      line += if x is ast.StrLit && !starts_with(s, \"{\") && at_edge {\n        \"{\" + text.expr_text(x, d) + \"}\"\n      } else {\n        s\n      }\n    }\n    mut lines.push(line)\n  }\n  lines\n}"}]}
{"id":"82c43cddfe0cbc01","time":1795712860,"message":"edit","changes":[{"name":"lex.lex","kind":"fn","old":"ae41d2f1cd3bc8c0","new":"df00aa2b56ed2d31","interface_changed":false,"affected":[],"module":"lex","text":"/// The last token is `Eof`.\npub fn lex(src: String) -> Result[(List[lex.Token], List[lex.Comment]), String] {\n  mut lx := lex.Lexer {\n    chars: src.chars(),\n    at: 0,\n    line: 1,\n    col: 1,\n    nl: true,\n    tokens: [],\n    comments: [],\n    modes: [],\n  }\n  n := len(lx.chars)\n  while lx.at < n {\n    if lex.in_children(lx) {\n      lex.markup_children(mut lx)!\n      continue\n    }\n    c := lex.char_at(lx, lx.at)\n    if c == \"\\n\" {\n      lx.nl = true\n      lx.at += 1\n      lx.line += 1\n      lx.col = 1\n      continue\n    }\n    if lex.is_white(c) {\n      lx.at += 1\n      lx.col += 1\n      continue\n    }\n    (sl, sc) := (lx.line, lx.col)\n    space := lx.at == 0 || lex.is_white(lex.char_at(lx, lx.at - 1))\n    if lex.in_tag(lx) {\n      lex.markup_tag(mut lx, sl, sc, space)!\n      continue\n    }\n    if c == \"/\" && lex.char_at(lx, lx.at + 1) == \"/\" {\n      start := lx.at\n      while lx.at < n && lex.char_at(lx, lx.at) != \"\\n\"\n        invariant lx.at <= n {\n        lx.at += 1\n      }\n      t := lex.text_of(lx, start, lx.at)\n      if starts_with(t, \"///\") {\n        lex.push_token(\n          mut lx,\n          lex.DocTok(trim(byte_slice(t, 3, byte_len(t)))),\n          sl,\n          sc,\n          space,\n        )\n      } else {\n        mut lx.comments.push(\n          lex.Comment {\n            line: sl,\n            col: sc,\n            text: lex.trim_end(t),\n            trailing: !lx.nl,\n          },\n        )\n      }\n      lx.col += lx.at - start\n      continue\n    }\n    if lex.is_ascii_digit(c) {\n      lex.number(mut lx, sl, sc, space)!\n      continue\n    }\n    if c == \"f\" && lex.char_at(lx, lx.at + 1) == \"\\\"\" {\n      lex.fstring(mut lx, sl, sc, space)!\n      continue\n    }\n    if lex.is_letter(c)\n      || c == \"_\"\n      || c == \"?\" && lex.is_letter(lex.char_at(lx, lx.at + 1)) {\n      hole := c == \"?\"\n      start := if hole {\n        lx.at + 1\n      } else {\n        lx.at\n      }\n      lx.at = start\n      while lx.at < n && lex.is_word(lex.char_at(lx, lx.at)) {\n        lx.at += 1\n      }\n      s := lex.text_of(lx, start, lx.at)\n      lx.col += lx.at - start\n        + if hole {\n          1\n        } else {\n          0\n        }\n      lex.push_token(mut lx, if hole {\n        lex.HoleTok(s)\n      } else {\n        lex.Ident(s)\n      }, sl, sc, space)\n      continue\n    }\n    if c == \"\\\"\" {\n      lex.string(mut lx, sl, sc, space)!\n      continue\n    }\n    if c == \"<\" && lex.markup_starts(lx) {\n      lex.markup_open(mut lx, sl, sc, space)\n      continue\n    }\n    rest := lex.text_of(lx, lx.at, lx.at + 3)\n    match lex.symbols().find(y -> starts_with(rest, y)) {\n      Some(y) => {\n        k := len(y.chars())\n        lx.at += k\n        lx.col += k\n        lex.push_token(mut lx, lex.Sym(y), sl, sc, space)\n        lex.code_brace(mut lx, y)\n      },\n      None => {\n        (l, cc) := (lx.line, lx.col)\n        return Err(f\"{l}:{cc}: unexpected character {lex.debug_char(c)}\")\n      },\n    }\n  }\n  if len(lx.modes) > 0 {\n    (l, cc) := (lx.line, lx.col)\n    return Err(\n      f\"{l}:{cc}: markup not closed: an element needs its `</tag>`, or `/>`\",\n    )\n  }\n  mut lx.tokens.push(\n    lex.Token {\n      tok: lex.Eof,\n      line: lx.line,\n      col: lx.col,\n      nl_before: true,\n      space_before: true,\n    },\n  )\n  Ok((lx.tokens, lx.comments))\n}","old_text":"/// The last token is `Eof`.\npub fn lex(src: String) -> Result[(List[lex.Token], List[lex.Comment]), String] {\n  mut lx := lex.Lexer {\n    chars: src.chars(),\n    at: 0,\n    line: 1,\n    col: 1,\n    nl: true,\n    tokens: [],\n    comments: [],\n    modes: [],\n  }\n  n := len(lx.chars)\n  while lx.at < n {\n    if lex.mode(lx) == Some(lex.InChildren) {\n      lex.markup_children(mut lx)!\n      continue\n    }\n    c := lex.char_at(lx, lx.at)\n    if c == \"\\n\" {\n      lx.nl = true\n      lx.at += 1\n      lx.line += 1\n      lx.col = 1\n      continue\n    }\n    if lex.is_white(c) {\n      lx.at += 1\n      lx.col += 1\n      continue\n    }\n    (sl, sc) := (lx.line, lx.col)\n    space := lx.at == 0 || lex.is_white(lex.char_at(lx, lx.at - 1))\n    if lex.mode(lx) == Some(lex.InTag) {\n      lex.markup_tag(mut lx, sl, sc, space)!\n      continue\n    }\n    if c == \"/\" && lex.char_at(lx, lx.at + 1) == \"/\" {\n      start := lx.at\n      while lx.at < n && lex.char_at(lx, lx.at) != \"\\n\"\n        invariant lx.at <= n {\n        lx.at += 1\n      }\n      t := lex.text_of(lx, start, lx.at)\n      if starts_with(t, \"///\") {\n        lex.push_token(\n          mut lx,\n          lex.DocTok(trim(byte_slice(t, 3, byte_len(t)))),\n          sl,\n          sc,\n          space,\n        )\n      } else {\n        mut lx.comments.push(\n          lex.Comment {\n            line: sl,\n            col: sc,\n            text: lex.trim_end(t),\n            trailing: !lx.nl,\n          },\n        )\n      }\n      lx.col += lx.at - start\n      continue\n    }\n    if lex.is_ascii_digit(c) {\n      lex.number(mut lx, sl, sc, space)!\n      continue\n    }\n    if c == \"f\" && lex.char_at(lx, lx.at + 1) == \"\\\"\" {\n      lex.fstring(mut lx, sl, sc, space)!\n      continue\n    }\n    if lex.is_letter(c)\n      || c == \"_\"\n      || c == \"?\" && lex.is_letter(lex.char_at(lx, lx.at + 1)) {\n      hole := c == \"?\"\n      start := if hole {\n        lx.at + 1\n      } else {\n        lx.at\n      }\n      lx.at = start\n      while lx.at < n && lex.is_word(lex.char_at(lx, lx.at)) {\n        lx.at += 1\n      }\n      s := lex.text_of(lx, start, lx.at)\n      lx.col += lx.at - start\n        + if hole {\n          1\n        } else {\n          0\n        }\n      lex.push_token(mut lx, if hole {\n        lex.HoleTok(s)\n      } else {\n        lex.Ident(s)\n      }, sl, sc, space)\n      continue\n    }\n    if c == \"\\\"\" {\n      lex.string(mut lx, sl, sc, space)!\n      continue\n    }\n    if c == \"<\" && lex.markup_starts(lx) {\n      lex.markup_open(mut lx, sl, sc, space)\n      continue\n    }\n    rest := lex.text_of(lx, lx.at, lx.at + 3)\n    match lex.symbols().find(y -> starts_with(rest, y)) {\n      Some(y) => {\n        k := len(y.chars())\n        lx.at += k\n        lx.col += k\n        lex.push_token(mut lx, lex.Sym(y), sl, sc, space)\n        lex.code_brace(mut lx, y)\n      },\n      None => {\n        (l, cc) := (lx.line, lx.col)\n        return Err(f\"{l}:{cc}: unexpected character {lex.debug_char(c)}\")\n      },\n    }\n  }\n  if len(lx.modes) > 0 {\n    (l, cc) := (lx.line, lx.col)\n    return Err(\n      f\"{l}:{cc}: markup not closed: an element needs its `</tag>`, or `/>`\",\n    )\n  }\n  mut lx.tokens.push(\n    lex.Token {\n      tok: lex.Eof,\n      line: lx.line,\n      col: lx.col,\n      nl_before: true,\n      space_before: true,\n    },\n  )\n  Ok((lx.tokens, lx.comments))\n}"},{"name":"lex.Mode","kind":"type","old":"50ab8b9a704c0f71","new":"0f8222c730b14222","interface_changed":true,"affected":["lex.Lexer","lex.mode","lex.push_mode","lex.set_mode","lex.code_brace","lex.markup_open","lex.markup_tag","lex.markup_children","lex.in_children","lex.in_tag","lex.char_at","lex.text_of","lex.push_token","lex.lex","lex.number","lex.fstring","lex.string","lex.pop_mode","lex.markup_starts","lex_one","lex_lines","parse.parser","lex_files","front_command","parse.parse_module","parse.parse_expr","parse.fstring_part","command_line","strata_command","diff.parsed","stored_package","edit_command","edit_file","edit_in_editor","merge_file_command","resolve_command","write_found","merge.merge","parse.parse_program","graph.trace_graph","call_command","kept_invariants","parse.primary_inner","main","diff.apply","di