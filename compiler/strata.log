!disk.exists(path) {\n    []\n  } else if is_dir {\n    package_decls(disk, path, if in_core {\n      \"core\"\n    } else {\n      \"\"\n    })\n  } else {\n    decls_of(disk, path)\n  }\n  module := in_package or {\n    if in_core {\n      m := edit_module(a.module ?? \"\")\n      if starts_with(m, \"core.\") || m == \"\" {\n        m\n      } else {\n        \"core.\" + m\n      }\n    } else if is_dir {\n      edit_module(a.module ?? \"\")\n    } else {\n      match old {\n        [d, ..] => d.module,\n        [] => \"\",\n      }\n    }\n  }\n  // (`--rm NAME`: a qualified name, or a short one naming one definition)\n  given_removes := removed_names(old, module, a.removes) except e {\n    return fail_with(mut console, e)\n  }\n  text := if cmd == \"add\" {\n    disk.read(a.module ?? \"\") !! \"\"\n  } else {\n    piped_input(\n      mut console,\n      len(given_removes) > 0,\n      \"strata --file F edit\",\n    ) except e { return fail_with(mut console, e) }\n  }\n  parsed := parse.parse_module(text, module) except e {\n    return fail_with(mut console, f\"parse error at {e}\")\n  }\n  // (text read back from a view: the proof material it hid is put back)\n  edits := if a.proofs || cmd == \"add\" {\n    parsed\n  } else {\n    (kept, notes) := views.proofs_kept(resolve.written(old, std, core), parsed)\n    for n in notes {\n      mut console.eprint(\"warning: \" + n)\n    }\n    kept\n  }\n  match both_given_and_removed(edits, given_removes) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  // (a declaration given drops its stored derives that are no longer on its\n  // `derive A, B for` line)\n  dropped := codebase.dropped_derives(old, edits).filter(\n    q -> !contains(given_removes, q),\n  )\n  removes := given_removes + dropped\n  // (a package's other modules, for its references)\n  others := match root {\n    Some(r) => package_decls(disk, r, \"\").filter(d -> d.module != module),\n    None => [],\n  }\n  // (core's files keep their names as written: core's names are global)\n  of_core := in_core\n    || match root {\n      Some(r) => package_name(disk, r) == \"core\",\n      None => false,\n    }\n  new := if of_core {\n    codebase.merge_parsed(old, edits, removes)\n  } else {\n    codebase.merge(old, edits, removes, std + others, core)\n  }\n  if new == old && disk.exists(path) {\n    // every definition given is as stored: nothing written or checked\n    mut console.print(\n      f\"{f}: no changes: every definition given is as stored (nothing written or checked)\",\n    )\n    return 0\n  }\n  // checked before anything is written: an edit that doesn't check\n  // leaves every file as it was (core checks only as the runtime's\n  // compilation does, `strata build-core`; a module file of a package\n  // isn't checked alone, its neighbours may not be written yet)\n  alone := !of_core\n    && in_package is None\n    && (is_dir || new.all(d -> d.module == \"\"))\n  errors := if alone {\n    lib := std_imports(disk, std_dir, new)\n    sh := shared_at(disk, cache.caches_of(process), home_of_std(std_dir))\n    // (`comptime e` compiled, as `check` runs it, with its budget of steps: a\n    // runaway one is an error instead of a hang)\n    std_use_check(\n        disk,\n        std_dir,\n        new,\n        use_errors_of(new, lib, Set[String] {}, core),\n      )\n      + warned(mut console, check_errors_with(\n        new,\n        lib,\n        core,\n        is_dir && package_reads_values(disk, path),\n        comptime_runner(disk, sh),\n      ))\n      + literal_errors_of(disk, new, lib, core, path, sh, [])\n  } else {\n    []\n  }\n  n := len(errors)\n  if n > 0 && !a.as_given {\n    mut console.eprint(\n      f\"rejected: {f} doesn't check ({n} error{plural(n, \"\", \"s\")}; nothing was written; `--as-given` writes it all the same):\",\n    )\n    for l in errors {\n      mut console.eprint(\"  \" + error_text(l))\n    }\n    return 1\n  }\n  if is_dir {\n    match codebase.write_modules(mut disk, path, old, new, false) {\n      Err(e) => return fail_with(mut console, e),\n      Ok(_) => (),\n    }\n  } else {\n    if codebase.parent(path) != \"\" {\n      mut disk.make_dir(codebase.parent(path)) !! ()\n    }\n    // (the definitions that didn't change keep their stored bytes)\n    bytes := codebase.module_bytes(\n      disk.read_bytes(path) !! [],\n      module,\n      new,\n      old,\n      others + new,\n      false,\n      Dict[String, ast.Key] {},\n    )\n    match codebase.write_file(mut disk, path, bytes) {\n      Err(e) => return fail_with(mut console, e),\n      Ok(_) => (),\n    }\n  }\n  cs := codebase.changes(old, new, false)\n  mut console.print(\n    f\"{f}: {len(cs)} definition{plural(len(cs), \"\", \"s\")} changed, {len(new)} in all\",\n  )\n  for q in dropped.filter(q -> !new.any(d -> store.qname(d) == q)) {\n    mut console.print(dropped_warning(q))\n  }\n  for w in edit_warnings(new, cs.map(c -> c.name), core) {\n    mut console.print(w)\n  }\n  if !of_core {\n    roots := unused_setting(disk, root ?? path).0\n    for w in edit_unused(\n      old + others,\n      new + others,\n      cs.map(c -> c.name),\n      core,\n      roots,\n    ) {\n      mut console.print(w.2)\n    }\n  }\n  if n > 0 {\n    mut console.eprint(\n      f\"written as given: {f} doesn't check ({n} error{plural(n, \"\", \"s\")}):\",\n    )\n    for l in errors {\n      mut console.eprint(\"  \" + error_text(l))\n    }\n    return 1\n  }\n  // the loops of the functions changed: invariants searched for where\n  // those derived from the code don't prove their checks, and written\n  looped := loop_functions(new, cs.map(c -> c.name))\n  if a.search && looped != [] && !of_core {\n    _ := search_invariants(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      cache.caches_of(process),\n      path,\n      looped,\n      \"edit\",\n      false,\n    )\n  }\n  0\n}"},{"name":"done_command","kind":"fn","old":"380147bff3601bc2","new":"100539721d3ae01a","interface_changed":false,"affected":[],"module":"","text":"/// `strata done [--keep-holes] [-m MSG] [--no-commit]`: records the pending\n/// change as one log entry.\nfn done_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  clock: std.time.SystemClock,\n  dir: String,\n  args: List[String],\n) -> std.process.ExitCode {\n  root := codebase.find_root(disk, dir) or {\n    return fail_with(mut console, \"`done` needs a package\")\n  }\n  p := pending.parse_pending(disk.read(pending.file_of(root)) !! \"\") or {\n    return fail_with(mut console, \"no pending change\")\n  }\n  keep := contains(args, \"--keep-holes\")\n  commit := !contains(args, \"--no-commit\")\n  message := match args.find(a -> a == \"-m\") {\n    Some(_) => {\n      mut m := p.message\n      for (i, a) in enumerate(args) {\n        if a == \"-m\" {\n          m = get(args, i + 1) ?? p.message\n        }\n      }\n      m\n    },\n    None => p.message,\n  }\n  current := read_package(disk, root, \"\") except e {\n    return fail_with(mut console, e)\n  }\n  open := pending.hole_names(current)\n  left := p.holes.filter(h -> contains(open, h.name))\n  if len(left) > 0 && !keep {\n    n := len(left)\n    mut console.eprint(\n      f\"{n} hole{if n == 1 {\n  \"\"\n} else {\n  \"s\"\n}} of this change {if n == 1 {\n  \"is\"\n} else {\n  \"are\"\n}} still open:\",\n    )\n    for h in left {\n      mut console.eprint(f\"  ?{h.name}  in {h.decl}  (was: {h.was})\")\n    }\n    mut console.eprint(\n      \"fill them with `strata edit`, keep them with `strata done --keep-holes`, or undo the change with `strata abort`\",\n    )\n    return 1\n  }\n  name := package_name(disk, root)\n  global := name == \"core\"\n  mut now_decls := current\n  if len(left) > 0 {\n    now_decls = pending.keep_holes(current)\n    match codebase.write_modules(\n      mut disk,\n      root,\n      current,\n      now_decls,\n      global,\n    ) {\n      Err(e) => return fail_with(mut console, e),\n      Ok(_) => (),\n    }\n  }\n  mut before := []\n  for b in p.before {\n    match binary.read(pending.unhex(b.1)) {\n      Ok(img) => {\n        m := deps.module_name(\"\", b.0)\n        before += img.decls.map(d -> ast.Decl { ..d, module: m })\n      },\n      Err(e) => return fail_with(\n        mut console,\n        f\"pending.json: corrupt bytes for {b.0}: {e}\",\n      ),\n    }\n  }\n  cs := codebase.changes(before, now_decls, global)\n  extra := if len(p.renames) == 0 {\n    []\n  } else {\n    [(\"renames\", \"[\" + join(p.renames, \",\") + \"]\")]\n  }\n  if len(cs) > 0 && name != \"std\" && name != \"core\" {\n    line := codebase.log_line(\n      before,\n      now_decls,\n      cs,\n      message,\n      extra,\n      clock.since_epoch().value,\n    )\n    match mut disk.append(root + \"/\" + codebase.log_file(), line + \"\\n\") {\n      Err(e) => return fail_with(mut console, f\"{e}\"),\n      Ok(_) => (),\n    }\n  }\n  mut disk.remove(pending.file_of(root)) !! ()\n  if commit {\n    git_commit(mut console, mut launcher, disk, root, message)\n  }\n  n := len(cs)\n  mut console.print(\n    f\"recorded \\\"{message}\\\" as one change: {n} definition{if n == 1 {\n  \"\"\n} else {\n  \"s\"\n}}\",\n  )\n  if len(left) > 0 {\n    k := len(left)\n    mut console.print(\n      f\"{k} hole{if k == 1 {\n  \"\"\n} else {\n  \"s\"\n}} kept as ?todo_…, see `strata holes`\",\n    )\n  }\n  0\n}","old_text":"/// `strata done [--keep-holes] [-m MSG] [--no-commit]`: records the pending\n/// change as one log entry.\nfn done_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  clock: std.time.SystemClock,\n  dir: String,\n  args: List[String],\n) -> std.process.ExitCode {\n  root := codebase.find_root(disk, dir) or {\n    return fail_with(mut console, \"`done` needs a package\")\n  }\n  p := pending.parse_pending(disk.read(pending.file_of(root)) !! \"\") or {\n    return fail_with(mut console, \"no pending change\")\n  }\n  keep := contains(args, \"--keep-holes\")\n  commit := !contains(args, \"--no-commit\")\n  message := match args.find(a -> a == \"-m\") {\n    Some(_) => {\n      mut m := p.message\n      for (i, a) in enumerate(args) {\n        if a == \"-m\" {\n          m = get(args, i + 1) ?? p.message\n        }\n      }\n      m\n    },\n    None => p.message,\n  }\n  current := package_decls(disk, root, \"\")\n  open := pending.hole_names(current)\n  left := p.holes.filter(h -> contains(open, h.name))\n  if len(left) > 0 && !keep {\n    n := len(left)\n    mut console.eprint(\n      f\"{n} hole{if n == 1 {\n  \"\"\n} else {\n  \"s\"\n}} of this change {if n == 1 {\n  \"is\"\n} else {\n  \"are\"\n}} still open:\",\n    )\n    for h in left {\n      mut console.eprint(f\"  ?{h.name}  in {h.decl}  (was: {h.was})\")\n    }\n    mut console.eprint(\n      \"fill them with `strata edit`, keep them with `strata done --keep-holes`, or undo the change with `strata abort`\",\n    )\n    return 1\n  }\n  name := package_name(disk, root)\n  global := name == \"core\"\n  mut now_decls := current\n  if len(left) > 0 {\n    now_decls = pending.keep_holes(current)\n    match codebase.write_modules(\n      mut disk,\n      root,\n      current,\n      now_decls,\n      global,\n    ) {\n      Err(e) => return fail_with(mut console, e),\n      Ok(_) => (),\n    }\n  }\n  mut before := []\n  for b in p.before {\n    match binary.read(pending.unhex(b.1)) {\n      Ok(img) => {\n        m := deps.module_name(\"\", b.0)\n        before += img.decls.map(d -> ast.Decl { ..d, module: m })\n      },\n      Err(e) => return fail_with(\n        mut console,\n        f\"pending.json: corrupt bytes for {b.0}: {e}\",\n      ),\n    }\n  }\n  cs := codebase.changes(before, now_decls, global)\n  extra := if len(p.renames) == 0 {\n    []\n  } else {\n    [(\"renames\", \"[\" + join(p.renames, \",\") + \"]\")]\n  }\n  if len(cs) > 0 && name != \"std\" && name != \"core\" {\n    line := codebase.log_line(\n      before,\n      now_decls,\n      cs,\n      message,\n      extra,\n      clock.since_epoch().value,\n    )\n    match mut disk.append(root + \"/\" + codebase.log_file(), line + \"\\n\") {\n      Err(e) => return fail_with(mut console, f\"{e}\"),\n      Ok(_) => (),\n    }\n  }\n  mut disk.remove(pending.file_of(root)) !! ()\n  if commit {\n    git_commit(mut console, mut launcher, disk, root, message)\n  }\n  n := len(cs)\n  mut console.print(\n    f\"recorded \\\"{message}\\\" as one change: {n} definition{if n == 1 {\n  \"\"\n} else {\n  \"s\"\n}}\",\n  )\n  if len(left) > 0 {\n    k := len(left)\n    mut console.print(\n      f\"{k} hole{if k == 1 {\n  \"\"\n} else {\n  \"s\"\n}} kept as ?todo_…, see `strata holes`\",\n    )\n  }\n  0\n}"},{"name":"viewed_program","kind":"fn","old":"1ef37927ece1a5f6","new":"df08f396180b5b45","interface_changed":false,"affected":[],"module":"","text":"/// `--file F` (a script, or a folder of module files), else the package\n/// around the current folder.\n/// core's modules are read under their names in core's folder (`rt`), so\n/// `--file core view rt` finds them. `core.rt` is found in core itself.\nfn viewed_program(\n  disk: std.fs.Disk,\n  process: std.process.Process,\n  file: Option[String],\n) -> Result[List[ast.Decl], String] {\n  match file {\n    Some(f) => if disk.is_dir(f) {\n      read_package(disk, f, if package_name(disk, f) == \"std\" {\n        \"std\"\n      } else {\n        \"\"\n      })\n    } else if disk.exists(f) {\n      read_module(disk, f)\n    } else {\n      Err(f\"{f}: no such file\")\n    },\n    None => match codebase.find_root(disk, process.current_dir()) {\n      Some(r) => read_package(disk, r, if package_name(disk, r) == \"std\" {\n        \"std\"\n      } else {\n        \"\"\n      }),\n      None => Err(\n        \"no package here (no strata.toml in this folder or above: run `strata init`, or pass --file)\",\n      ),\n    },\n  }\n}","old_text":"/// `--file F` (a script, or a folder of module files), else the package\n/// around the current folder.\n/// core's modules are read under their names in core's folder (`rt`), so\n/// `--file core view rt` finds them. `core.rt` is found in core itself.\nfn viewed_program(\n  disk: std.fs.Disk,\n  process: std.process.Process,\n  file: Option[String],\n) -> Result[List[ast.Decl], String] {\n  match file {\n    Some(f) => if disk.is_dir(f) {\n      Ok(package_decls(disk, f, if package_name(disk, f) == \"std\" {\n        \"std\"\n      } else {\n        \"\"\n      }))\n    } else if disk.exists(f) {\n      Ok(decls_of(disk, f))\n    } else {\n      Err(f\"{f}: no such file\")\n    },\n    None => match codebase.find_root(disk, process.current_dir()) {\n      Some(r) => Ok(package_decls(disk, r, if package_name(disk, r) == \"std\" {\n        \"std\"\n      } else {\n        \"\"\n      })),\n      None => Err(\n        \"no package here (no strata.toml in this folder or above: run `strata init`, or pass --file)\",\n      ),\n    },\n  }\n}"},{"name":"merge_file_command","kind":"fn","old":"a638468d7c467fad","new":"0719501665ae941e","interface_changed":false,"affected":[],"module":"","text":"/// `strata merge-file BASE OURS THEIRS [PATH]` (git: `%O %A %B %P`):\n/// merges the three versions definition by definition, and inside a\n/// definition changed on both sides node by node (their stored forms, so\n/// an import that shortens names changes nothing), into OURS, then checks.\n/// A node in conflict is left in OURS as a hole, `?conflict_N(ours, base,\n/// theirs)` (`strata holes` lists them); a conflict outside every\n/// expression leaves OURS as text with conflict markers.\nfn merge_file_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  args: List[String],\n) -> std.process.ExitCode {\n  (o, a, b) := match args {\n    [o, a, b, ..] => (o, a, b),\n    _ => return fail_with(\n      mut console,\n      \"usage: strata merge-file BASE OURS THEIRS [PATH]  (git: `strata merge-file %O %A %B %P`)\",\n    ),\n  }\n  path := get(args, 3) ?? a\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  core := read_core_at(disk, home)\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  // each id read by one name on all three sides: as the module that has\n  // it in the working tree names it, else as the side that changed it\n  // names it (ours first), so that a rename on one side is followed by the\n  // other side's uses\n  here := match module_at(disk, path) {\n    Some((_, m)) => m,\n    None => \"\",\n  }\n  owners := others_at(disk, path, here)\n  (names, renamed) := merged_names([o, a, b].map(\n    f -> match disk.read_bytes(f) {\n      Ok(bytes) => match binary.read_header(bytes) {\n        Ok(h) => h.table,\n        Err(_) => Dict[ast.Key, String] {},\n      },\n      Err(_) => Dict[ast.Key, String] {},\n    },\n  ), binary.ids_of(owners))\n  read := (f: String) -> match disk.read_bytes(f) {\n    Ok([]) => Ok([]),\n    Ok(bytes) => match binary.read_named(bytes, names) {\n      Ok(img) => Ok(img.decls),\n      Err(e) => Err(e),\n    },\n    Err(e) => Err(f\"{f}: {e}\"),\n  }\n  (base, ours, theirs) := match (read(o), read(a), read(b)) {\n    (Ok(x), Ok(y), Ok(z)) => (x, y, z),\n    (x, y, z) => {\n      es := [e for e in [x, y, z].map(\n        r -> match r {\n          Err(e) => e,\n          Ok(_) => \"\",\n        },\n      ) where e != \"\"]\n      mut console.eprint(\n        f\"strata: {path}: can't merge: {join(es, \"; \")}\",\n      )\n      return 1\n    },\n  }\n  // (the module as the sides store it. A package's own name for it can\n  // differ: core's `core.list` is the file `list.strata`. Else the module the\n  // file is in its package. A side stored as a script, `save`d or `--file`\n  // edited, has its definitions in no module.)\n  module := match [d.module for d in ours + theirs + base where d.module != \"\"] {\n    [m, ..] => m,\n    [] => match module_at(disk, path) {\n      Some((_, m)) => m,\n      None => \"\",\n    },\n  }\n  relabel := (ds: List[ast.Decl]) -> ds.map(d -> ast.Decl { ..d, module })\n  // (each side written against the package's other modules, as `render`\n  // shows it. A name a module imports stays short, `helper()`: written in\n  // full, `util.helper()`, a local named `util` would read it, once stored\n  // again, as that local's method.)\n  others := others_at_stored(disk, path, module, std, core)\n  side_text := (ds: List[ast.Decl]) ->\n    resolve.written(others + relabel(ds), std, core).filter(\n      d -> d.module == module,\n    )\n  tmp := (process.var(\"TMPDIR\") ?? \"/tmp\")\n    + \"/strata-merge-\"\n    + f\"{byte_len(path)}-{byte_len(o)}\"\n  // a definition merged from the stored forms, written as ours shows it,\n  // with the imports theirs added\n  added_uses := relabel(theirs).filter(\n    d -> match d.kind {\n      ast.UseDef(_) => !ours.any(x -> store.qname(x) == store.qname(d)),\n      _ => false,\n    },\n  )\n  write := (d: ast.Decl) -> {\n    mine := relabel(ours)\n    at := [i for (i, x) in enumerate(mine) where store.qname(x) == store.qname(d)]\n    match at {\n      [i] => {\n        ctx := others\n          + [if k == i {\n            ast.Decl { ..d, module }\n          } else {\n            x\n          } for (k, x) in enumerate(mine)]\n          + added_uses\n        get(\n          resolve.written_at(\n            ctx,\n            Set { len(others) + i },\n            std,\n            core,\n          ),\n          0,\n        )\n      },\n      _ => None,\n    }\n  }\n  m := merge.merge(\n    mut disk,\n    mut launcher,\n    tmp,\n    side_text(base),\n    side_text(ours),\n    side_text(theirs),\n    [relabel(base), relabel(ours), relabel(theirs)],\n    write,\n  ) except e { return fail_with(mut console, e) }\n  for n in renamed + m.notes {\n    mut console.eprint(f\"strata: {path}: {n}\")\n  }\n  if len(m.conflicts) > 0 {\n    mut disk.write(a, m.text) !! ()\n    for c in m.conflicts {\n      mut console.eprint(f\"strata: {path}: conflict in {c}\")\n    }\n    mut console.eprint(\n      f\"strata: {path} is left as text with conflict markers: fix it, then `strata resolve {path}` stores it\",\n    )\n    return 1\n  }\n  merged := parse.parse_module(m.text, module) except e {\n    return fail_with(mut console, f\"{path}: the merge doesn't parse ({e})\")\n  }\n  // a definition taken whole from one side keeps that side's stored form:\n  // read back from its text, a name it shows in full (`cache.caching()`)\n  // would be taken for a method of a local of the module's name\n  kept := (side: List[ast.Decl]) -> {\n    ws := side_text(side)\n    own := relabel(side)\n    if len(ws) == len(own) {\n      zip(ws.map(w -> text.decl_text(w)), own)\n    } else {\n      []\n    }\n  }\n  whole := kept(ours) + kept(theirs) + m.kept\n  // (a definition merged line by line keeps its id, ours' first)\n  // (two definitions of the module with one id, one from each side: the\n  // second gets another, said so)\n  merged_decls := kept_decls(disk, path, module, merged, whole, std, core)\n  final := binary.assign_ids(\n    merged_decls,\n    relabel(ours) + relabel(theirs),\n    [],\n  )\n  for n in binary.rerolled(merged_decls, final) {\n    mut console.eprint(f\"strata: {path}: {n}\")\n  }\n  around := others_at_stored(disk, path, module, std, core)\n  mut known := binary.ids_of(around + std)\n  match disk.read_bytes(a) {\n    Ok(bytes) => match binary.read_header(bytes) {\n      Ok(h) => {\n        for (q, id) in items(binary.ref_ids(h)) {\n          if !contains(known, q) {\n            mut known.insert(q, id)\n          }\n        }\n      },\n      Err(_) => (),\n    },\n    Err(_) => (),\n  }\n  match mut disk.write_bytes(\n    a,\n    binary.encode_module_kept(\n      final,\n      module,\n      store.graph(around + final, false),\n      [],\n      Dict[String, binary.Entry] {},\n      known,\n    ),\n  ) {\n    Err(e) => return fail_with(mut console, f\"{a}: {e}\"),\n    Ok(_) => (),\n  }\n  if len(m.holes) > 0 {\n    for h in m.holes {\n      mut console.eprint(f\"strata: {path}: conflict in {h}\")\n    }\n    mut console.eprint(\n      f\"strata: {path}: each conflict is a hole `?conflict_N(ours, base, theirs)`: replace it with the code to keep (`strata edit`), then `git add {path}`\",\n    )\n    return 1\n  }\n  if process.var(\"STRATA_MERGE_BASE\") is Some {\n    return 0\n  }\n  // what doesn't check now that checked on both sides\n  others := match module_at(disk, path) {\n    Some((r, _)) => (read_package(disk, r, module_prefix(disk, r)) except e {\n      return fail_with(mut console, e)\n    }).filter(\n      d -> d.module != module,\n    ),\n    None => [],\n  }\n  // (`[values] read = true`: the package may read compiled values back)\n  values := match module_at(disk, path) {\n    Some((r, _)) => package_reads_values(disk, r),\n    None => false,\n  }\n  errors_of := (side: List[ast.Decl]) -> {\n    all := resolve.stored(\n      others + side.map(d -> ast.Decl { ..d, module }),\n      std,\n      core,\n    )\n    lib := std_imports(disk, std_dir, all)\n    check_errors_of(all, lib, core, values).map(\n      e -> f\"{e.0}: {e.1}\",\n    )\n  }\n  known := errors_of(ours) + errors_of(theirs)\n  fresh := errors_of(final).filter(e -> !contains(known, e))\n  if len(fresh) > 0 {\n    mut console.eprint(\n      f\"strata: {path}: merged definition by definition, but the result doesn't check:\",\n    )\n    for e in fresh {\n      mut console.eprint(f\"    {e}\")\n    }\n    return 1\n  }\n  0\n}","old_text":"/// `strata merge-file BASE OURS THEIRS [PATH]` (git: `%O %A %B %P`):\n/// merges the three versions definition by definition, and inside a\n/// definition changed on both sides node by node (their stored forms, so\n/// an import that shortens names changes nothing), into OURS, then checks.\n/// A node in conflict is left in OURS as a hole, `?conflict_N(ours, base,\n/// theirs)` (`strata holes` lists them); a conflict outside every\n/// expression leaves OURS as text with conflict markers.\nfn merge_file_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  args: List[String],\n) -> std.process.ExitCode {\n  (o, a, b) := match args {\n    [o, a, b, ..] => (o, a, b),\n    _ => return fail_with(\n      mut console,\n      \"usage: strata merge-file BASE OURS THEIRS [PATH]  (git: `strata merge-file %O %A %B %P`)\",\n    ),\n  }\n  path := get(args, 3) ?? a\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  core := read_core_at(disk, home)\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  // each id read by one name on all three sides: as the module that has\n  // it in the working tree names it, else as the side that changed it\n  // names it (ours first), so that a rename on one side is followed by the\n  // other side's uses\n  here := match module_at(disk, path) {\n    Some((_, m)) => m,\n    None => \"\",\n  }\n  owners := others_at(disk, path, here)\n  (names, renamed) := merged_names([o, a, b].map(\n    f -> match disk.read_bytes(f) {\n      Ok(bytes) => match binary.read_header(bytes) {\n        Ok(h) => h.table,\n        Err(_) => Dict[ast.Key, String] {},\n      },\n      Err(_) => Dict[ast.Key, String] {},\n    },\n  ), binary.ids_of(owners))\n  read := (f: String) -> match disk.read_bytes(f) {\n    Ok([]) => Ok([]),\n    Ok(bytes) => match binary.read_named(bytes, names) {\n      Ok(img) => Ok(img.decls),\n      Err(e) => Err(e),\n    },\n    Err(e) => Err(f\"{f}: {e}\"),\n  }\n  (base, ours, theirs) := match (read(o), read(a), read(b)) {\n    (Ok(x), Ok(y), Ok(z)) => (x, y, z),\n    (x, y, z) => {\n      es := [e for e in [x, y, z].map(\n        r -> match r {\n          Err(e) => e,\n          Ok(_) => \"\",\n        },\n      ) where e != \"\"]\n      mut console.eprint(\n        f\"strata: {path}: can't merge: {join(es, \"; \")}\",\n      )\n      return 1\n    },\n  }\n  // (the module as the sides store it. A package's own name for it can\n  // differ: core's `core.list` is the file `list.strata`. Else the module the\n  // file is in its package. A side stored as a script, `save`d or `--file`\n  // edited, has its definitions in no module.)\n  module := match [d.module for d in ours + theirs + base where d.module != \"\"] {\n    [m, ..] => m,\n    [] => match module_at(disk, path) {\n      Some((_, m)) => m,\n      None => \"\",\n    },\n  }\n  relabel := (ds: List[ast.Decl]) -> ds.map(d -> ast.Decl { ..d, module })\n  // (each side written against the package's other modules, as `render`\n  // shows it. A name a module imports stays short, `helper()`: written in\n  // full, `util.helper()`, a local named `util` would read it, once stored\n  // again, as that local's method.)\n  others := others_at_stored(disk, path, module, std, core)\n  side_text := (ds: List[ast.Decl]) ->\n    resolve.written(others + relabel(ds), std, core).filter(\n      d -> d.module == module,\n    )\n  tmp := (process.var(\"TMPDIR\") ?? \"/tmp\")\n    + \"/strata-merge-\"\n    + f\"{byte_len(path)}-{byte_len(o)}\"\n  // a definition merged from the stored forms, written as ours shows it,\n  // with the imports theirs added\n  added_uses := relabel(theirs).filter(\n    d -> match d.kind {\n      ast.UseDef(_) => !ours.any(x -> store.qname(x) == store.qname(d)),\n      _ => false,\n    },\n  )\n  write := (d: ast.Decl) -> {\n    mine := relabel(ours)\n    at := [i for (i, x) in enumerate(mine) where store.qname(x) == store.qname(d)]\n    match at {\n      [i] => {\n        ctx := others\n          + [if k == i {\n            ast.Decl { ..d, module }\n          } else {\n            x\n          } for (k, x) in enumerate(mine)]\n          + added_uses\n        get(\n          resolve.written_at(\n            ctx,\n            Set { len(others) + i },\n            std,\n            core,\n          ),\n          0,\n        )\n      },\n      _ => None,\n    }\n  }\n  m := merge.merge(\n    mut disk,\n    mut launcher,\n    tmp,\n    side_text(base),\n    side_text(ours),\n    side_text(theirs),\n    [relabel(base), relabel(ours), relabel(theirs)],\n    write,\n  ) except e { return fail_with(mut console, e) }\n  for n in renamed + m.notes {\n    mut console.eprint(f\"strata: {path}: {n}\")\n  }\n  if len(m.conflicts) > 0 {\n    mut disk.write(a, m.text) !! ()\n    for c in m.conflicts {\n      mut console.eprint(f\"strata: {path}: conflict in {c}\")\n    }\n    mut console.eprint(\n      f\"strata: {path} is left as text with conflict markers: fix it, then `strata resolve {path}` stores it\",\n    )\n    return 1\n  }\n  merged := parse.parse_module(m.text, module) except e {\n    return fail_with(mut console, f\"{path}: the merge doesn't parse ({e})\")\n  }\n  // a definition taken whole from one side keeps that side's stored form:\n  // read back from its text, a name it shows in full (`cache.caching()`)\n  // would be taken for a method of a local of the module's name\n  kept := (side: List[ast.Decl]) -> {\n    ws := side_text(side)\n    own := relabel(side)\n    if len(ws) == len(own) {\n      zip(ws.map(w -> text.decl_text(w)), own)\n    } else {\n      []\n    }\n  }\n  whole := kept(ours) + kept(theirs) + m.kept\n  // (a definition merged line by line keeps its id, ours' first)\n  // (two definitions of the module with one id, one from each side: the\n  // second gets another, said so)\n  merged_decls := kept_decls(disk, path, module, merged, whole, std, core)\n  final := binary.assign_ids(\n    merged_decls,\n    relabel(ours) + relabel(theirs),\n    [],\n  )\n  for n in binary.rerolled(merged_decls, final) {\n    mut console.eprint(f\"strata: {path}: {n}\")\n  }\n  around := others_at_stored(disk, path, module, std, core)\n  mut known := binary.ids_of(around + std)\n  match disk.read_bytes(a) {\n    Ok(bytes) => match binary.read_header(bytes) {\n      Ok(h) => {\n        for (q, id) in items(binary.ref_ids(h)) {\n          if !contains(known, q) {\n            mut known.insert(q, id)\n          }\n        }\n      },\n      Err(_) => (),\n    },\n    Err(_) => (),\n  }\n  match mut disk.write_bytes(\n    a,\n    binary.encode_module_kept(\n      final,\n      module,\n      store.graph(around + final, false),\n      [],\n      Dict[String, binary.Entry] {},\n      known,\n    ),\n  ) {\n    Err(e) => return fail_with(mut console, f\"{a}: {e}\"),\n    Ok(_) => (),\n  }\n  if len(m.holes) > 0 {\n    for h in m.holes {\n      mut console.eprint(f\"strata: {path}: conflict in {h}\")\n    }\n    mut console.eprint(\n      f\"strata: {path}: each conflict is a hole `?conflict_N(ours, base, theirs)`: replace it with the code to keep (`strata edit`), then `git add {path}`\",\n    )\n    return 1\n  }\n  if process.var(\"STRATA_MERGE_BASE\") is Some {\n    return 0\n  }\n  // what doesn't check now that checked on both sides\n  others := match module_at(disk, path) {\n    Some((r, _)) => package_decls(disk, r, module_prefix(disk, r)).filter(\n      d -> d.module != module,\n    ),\n    None => [],\n  }\n  // (`[values] read = true`: the package may read compiled values back)\n  values := match module_at(disk, path) {\n    Some((r, _)) => package_reads_values(disk, r),\n    None => false,\n  }\n  errors_of := (side: List[ast.Decl]) -> {\n    all := resolve.stored(\n      others + side.map(d -> ast.Decl { ..d, module }),\n      std,\n      core,\n    )\n    lib := std_imports(disk, std_dir, all)\n    check_errors_of(all, lib, core, values).map(\n      e -> f\"{e.0}: {e.1}\",\n    )\n  }\n  known := errors_of(ours) + errors_of(theirs)\n  fresh := errors_of(final).filter(e -> !contains(known, e))\n  if len(fresh) > 0 {\n    mut console.eprint(\n      f\"strata: {path}: merged definition by definition, but the result doesn't check:\",\n    )\n    for e in fresh {\n      mut console.eprint(f\"    {e}\")\n    }\n    return 1\n  }\n  0\n}"},{"name":"revert_command","kind":"fn","old":"03a999efb7cde50f","new":"7fd6404273d8cdba","interface_changed":false,"affected":[],"module":"","text":"/// `strata revert NAME [COMMIT] [--force]`: the definition NAME put back as\n/// it was before COMMIT changed it (default: the last commit that did), in\n/// the working tree, the other definitions untouched; removed if COMMIT\n/// added it. Not committed, and not logged. Refused while NAME has\n/// uncommitted changes, which it would lose, unless `--force`. Prints what\n/// it changed, as `strata diff` does.\nfn revert_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  args: List[String],\n) -> std.process.ExitCode {\n  if contains(args, \"--help\") || contains(args, \"-h\") {\n    mut console.write(command_usage(\"revert\"))\n    return 0\n  }\n  mut file := None\n  mut force := false\n  mut words := []\n  mut i := 0\n  while i < len(args) {\n    a := get(args, i) ?? \"\"\n    i += 1\n    if a == \"--file\" {\n      file = get(args, i)\n      i += 1\n    } else if a == \"--force\" {\n      force = true\n    } else if starts_with(a, \"-\") {\n      return fail_with(mut console, f\"unknown option `{a}`\")\n    } else {\n      mut words.push(a)\n    }\n  }\n  (name, commit) := match words {\n    [n] => (n, None),\n    [n, c] => (n, Some(c)),\n    _ => return fail_with(\n      mut console,\n      \"usage: strata [--file F] revert NAME [COMMIT] [--force]\",\n    ),\n  }\n  p := history_place(mut launcher, disk, process, file, name) except e {\n    return fail_with(mut console, e)\n  }\n  // (a commit given: its full id, to find it in the definition's history)\n  sha := match commit {\n    Some(c) => if starts_with(c, \"-\") {\n      return fail_with(mut console, f\"`{c}` is not a commit\")\n    } else {\n      match git_in(\n        mut launcher,\n        p.top,\n        [\"rev-parse\", \"--verify\", \"-q\", c + \"^{commit}\"],\n      ) {\n        Ok(f) => if f.code == 0 {\n          Some(trim(f.out))\n        } else {\n          return fail_with(\n            mut console,\n            f\"`{c}` is not a commit in this repository\",\n          )\n        },\n        Err(e) => return fail_with(mut console, e),\n      }\n    },\n    None => None,\n  }\n  // the whole history when a commit is given; else up to the last commit\n  cs := history.changes(mut launcher, disk, p, match sha {\n    Some(_) => None,\n    None => Some(2),\n  }) except e { return fail_with(mut console, e) }\n  if !force && cs.any(c -> c.sha == \"\") {\n    return fail_with(\n      mut console,\n      f\"`{name}` has uncommitted changes, which reverting would lose: commit them first, or pass --force\",\n    )\n  }\n  picked := match sha {\n    Some(s) => cs.find(c -> c.sha == s) or {\n      return fail_with(\n        mut console,\n        f\"{byte_slice(s, 0, 8)} didn't change `{name}` (`strata history {name}` lists the commits that did)\",\n      )\n    },\n    None => cs.find(c -> c.sha != \"\") or {\n      return fail_with(\n        mut console,\n        f\"no commit changed `{name}`: there is nothing to revert\"\n          + bare_name_hint(name, p),\n      )\n    },\n  }\n  bytes := disk.read_bytes(p.path) !! []\n  root := codebase.find_root(disk, if codebase.parent(p.path) == \"\" {\n    \".\"\n  } else {\n    codebase.parent(p.path)\n  })\n  others := match root {\n    Some(r) => (read_package(disk, r, module_prefix(disk, r)) except e {\n      return fail_with(mut console, e)\n    }).filter(\n      d -> r + \"/\" + codebase.module_path(d.module) != p.path,\n    ),\n    None => [],\n  }\n  (written, now, rest) := history.reverted(bytes, p.name, picked.before, others) except e {\n    return fail_with(mut console, f\"{p.path}: {e}\")\n  }\n  match mut disk.write_bytes(p.path, written) {\n    Ok(_) => (),\n    Err(e) => return fail_with(mut console, f\"{p.path}: {e}\"),\n  }\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  core := read_core_at(disk, home)\n  std := std_decls_at(disk, home)\n  paint := console.paint(std.term.Output)\n  what := match picked.before {\n    Some(_) => f\"`{name}` as it was before {byte_slice(picked.sha, 0, 8)} ({picked.subject})\",\n    None => f\"`{name}` removed: {byte_slice(picked.sha, 0, 8)} ({picked.subject}) added it\",\n  }\n  mut console.print(what + \", in \" + p.rel + \" (not committed)\")\n  undone := history.Change {\n    ..picked,\n    before: now,\n    after: picked.before,\n    context: rest,\n  }\n  mut console.write(\n    join(\n      split(history.change_text(disk, undone, std, core), \"\\n\").map(\n        l -> highlight.diff_line(paint, l),\n      ),\n      \"\\n\",\n    ),\n  )\n  0\n}","old_text":"/// `strata revert NAME [COMMIT] [--force]`: the definition NAME put back as\n/// it was before COMMIT changed it (default: the last commit that did), in\n/// the working tree, the other definitions untouched; removed if COMMIT\n/// added it. Not committed, and not logged. Refused while NAME has\n/// uncommitted changes, which it would lose, unless `--force`. Prints what\n/// it changed, as `strata diff` does.\nfn revert_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  args: List[String],\n) -> std.process.ExitCode {\n  if contains(args, \"--help\") || contains(args, \"-h\") {\n    mut console.write(command_usage(\"revert\"))\n    return 0\n  }\n  mut file := None\n  mut force := false\n  mut words := []\n  mut i := 0\n  while i < len(args) {\n    a := get(args, i) ?? \"\"\n    i += 1\n    if a == \"--file\" {\n      file = get(args, i)\n      i += 1\n    } else if a == \"--force\" {\n      force = true\n    } else if starts_with(a, \"-\") {\n      return fail_with(mut console, f\"unknown option `{a}`\")\n    } else {\n      mut words.push(a)\n    }\n  }\n  (name, commit) := match words {\n    [n] => (n, None),\n    [n, c] => (n, Some(c)),\n    _ => return fail_with(\n      mut console,\n      \"usage: strata [--file F] revert NAME [COMMIT] [--force]\",\n    ),\n  }\n  p := history_place(mut launcher, disk, process, file, name) except e {\n    return fail_with(mut console, e)\n  }\n  // (a commit given: its full id, to find it in the definition's history)\n  sha := match commit {\n    Some(c) => if starts_with(c, \"-\") {\n      return fail_with(mut console, f\"`{c}` is not a commit\")\n    } else {\n      match git_in(\n        mut launcher,\n        p.top,\n        [\"rev-parse\", \"--verify\", \"-q\", c + \"^{commit}\"],\n      ) {\n        Ok(f) => if f.code == 0 {\n          Some(trim(f.out))\n        } else {\n          return fail_with(\n            mut console,\n            f\"`{c}` is not a commit in this repository\",\n          )\n        },\n        Err(e) => return fail_with(mut console, e),\n      }\n    },\n    None => None,\n  }\n  // the whole history when a commit is given; else up to the last commit\n  cs := history.changes(mut launcher, disk, p, match sha {\n    Some(_) => None,\n    None => Some(2),\n  }) except e { return fail_with(mut console, e) }\n  if !force && cs.any(c -> c.sha == \"\") {\n    return fail_with(\n      mut console,\n      f\"`{name}` has uncommitted changes, which reverting would lose: commit them first, or pass --force\",\n    )\n  }\n  picked := match sha {\n    Some(s) => cs.find(c -> c.sha == s) or {\n      return fail_with(\n        mut console,\n        f\"{byte_slice(s, 0, 8)} didn't change `{name}` (`strata history {name}` lists the commits that did)\",\n      )\n    },\n    None => cs.find(c -> c.sha != \"\") or {\n      return fail_with(\n        mut console,\n        f\"no commit changed `{name}`: there is nothing to revert\"\n          + bare_name_hint(name, p),\n      )\n    },\n  }\n  bytes := disk.read_bytes(p.path) !! []\n  root := codebase.find_root(disk, if codebase.parent(p.path) == \"\" {\n    \".\"\n  } else {\n    codebase.parent(p.path)\n  })\n  others := match root {\n    Some(r) => package_decls(disk, r, module_prefix(disk, r)).filter(\n      d -> r + \"/\" + codebase.module_path(d.module) != p.path,\n    ),\n    None => [],\n  }\n  (written, now, rest) := history.reverted(bytes, p.name, picked.before, others) except e {\n    return fail_with(mut console, f\"{p.path}: {e}\")\n  }\n  match mut disk.write_bytes(p.path, written) {\n    Ok(_) => (),\n    Err(e) => return fail_with(mut console, f\"{p.path}: {e}\"),\n  }\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  core := read_core_at(disk, home)\n  std := std_decls_at(disk, home)\n  paint := console.paint(std.term.Output)\n  what := match picked.before {\n    Some(_) => f\"`{name}` as it was before {byte_slice(picked.sha, 0, 8)} ({picked.subject})\",\n    None => f\"`{name}` removed: {byte_slice(picked.sha, 0, 8)} ({picked.subject}) added it\",\n  }\n  mut console.print(what + \", in \" + p.rel + \" (not committed)\")\n  undone := history.Change {\n    ..picked,\n    before: now,\n    after: picked.before,\n    context: rest,\n  }\n  mut console.write(\n    join(\n      split(history.change_text(disk, undone, std, core), \"\\n\").map(\n        l -> highlight.diff_line(paint, l),\n      ),\n      \"\\n\",\n    ),\n  )\n  0\n}"},{"name":"follow_renames","kind":"fn","old":"d7c31570841baffd","new":"02295a12f56e06c4","interface_changed":false,"affected":[],"module":"","text":"/// Applies the renames recorded in either side's log since `base` to every\n/// package in the working tree, so the other side's new references follow\n/// them, in any file. Each package that changes gets a log entry and is\n/// staged. Returns what was done, one line each.\nfn follow_renames(\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  clock: std.time.SystemClock,\n  top: String,\n  base: String,\n  theirs: String,\n  std: List[ast.Decl],\n  core: builtins.Core,\n) -> Result[List[String], String] {\n  mut notes := []\n  (packages, _) := discover(mut launcher, disk, top)\n  for dir in packages {\n    rel := if dir == top {\n      codebase.log_file()\n    } else {\n      byte_slice(dir, byte_len(top) + 1, byte_len(dir))\n        + \"/\"\n        + codebase.log_file()\n    }\n    renames := logged_renames(mut launcher, top, rel, base, theirs)\n    if len(renames) == 0 {\n      continue\n    }\n    name := package_name(disk, dir)\n    global := name == \"core\"\n    mut program := read_package(disk, dir, if name == \"std\" {\n      \"std\"\n    } else {\n      \"\"\n    })!\n    for (from, to, side) in renames {\n      followed := merge.follow_rename(program, from, to, std, core)\n      if followed is None {\n        continue\n      }\n      next := followed ?? program\n      before := dict(program.map(d -> (store.qname(d), text.decl_text(d))))\n      updated := next\n        .filter(d -> match get(before, store.qname(d)) {\n          Some(t) => t != text.decl_text(d),\n          None => false,\n        })\n        .map(d -> store.qname(d))\n      other := if side == \"ours\" {\n        \"theirs\"\n      } else {\n        \"ours\"\n      }\n      message := f\"merge: {other} code follows the rename {from} → {to}\"\n      cs := codebase.changes(program, next, global)\n      if len(cs) > 0 {\n        codebase.write_modules(mut disk, dir, program, next, global)!\n        if name != \"std\" && name != \"core\" {\n          follows := \"{\\\"from\\\":\"\n            + codebase.json_string(from)\n            + \",\\\"to\\\":\"\n            + codebase.json_string(to)\n            + \",\\\"references\\\":[\"\n            + join(updated.map(u -> codebase.json_string(u)), \",\")\n            + \"]}\"\n          line := codebase.log_line(\n            program,\n            next,\n            cs,\n            message,\n            [(\"follows\", follows)],\n            clock.since_epoch().value,\n          )\n          match mut disk.append(dir + \"/\" + codebase.log_file(), line + \"\\n\") {\n            Err(e) => return Err(f\"{e}\"),\n            Ok(_) => (),\n          }\n        }\n        program = next\n      }\n      mut notes.push(message + \" (\" + join(updated, \", \") + \")\")\n    }\n    git_run(mut launcher, top, [\"add\", \"--\", dir])!\n  }\n  Ok(notes)\n}","old_text":"/// Applies the renames recorded in either side's log since `base` to every\n/// package in the working tree, so the other side's new references follow\n/// them, in any file. Each package that changes gets a log entry and is\n/// staged. Returns what was done, one line each.\nfn follow_renames(\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  clock: std.time.SystemClock,\n  top: String,\n  base: String,\n  theirs: String,\n  std: List[ast.Decl],\n  core: builtins.Core,\n) -> Result[List[String], String] {\n  mut notes := []\n  (packages, _) := discover(mut launcher, disk, top)\n  for dir in packages {\n    rel := if dir == top {\n      codebase.log_file()\n    } else {\n      byte_slice(dir, byte_len(top) + 1, byte_len(dir))\n        + \"/\"\n        + codebase.log_file()\n    }\n    renames := logged_renames(mut launcher, top, rel, base, theirs)\n    if len(renames) == 0 {\n      continue\n    }\n    name := package_name(disk, dir)\n    global := name == \"core\"\n    mut program := package_decls(disk, dir, if name == \"std\" {\n      \"std\"\n    } else {\n      \"\"\n    })\n    for (from, to, side) in renames {\n      followed := merge.follow_rename(program, from, to, std, core)\n      if followed is None {\n        continue\n      }\n      next := followed ?? program\n      before := dict(program.map(d -> (store.qname(d), text.decl_text(d))))\n      updated := next\n        .filter(d -> match get(before, store.qname(d)) {\n          Some(t) => t != text.decl_text(d),\n          None => false,\n        })\n        .map(d -> store.qname(d))\n      other := if side == \"ours\" {\n        \"theirs\"\n      } else {\n        \"ours\"\n      }\n      message := f\"merge: {other} code follows the rename {from} → {to}\"\n      cs := codebase.changes(program, next, global)\n      if len(cs) > 0 {\n        codebase.write_modules(mut disk, dir, program, next, global)!\n        if name != \"std\" && name != \"core\" {\n          follows := \"{\\\"from\\\":\"\n            + codebase.json_string(from)\n            + \",\\\"to\\\":\"\n            + codebase.json_string(to)\n            + \",\\\"references\\\":[\"\n            + join(updated.map(u -> codebase.json_string(u)), \",\")\n            + \"]}\"\n          line := codebase.log_line(\n            program,\n            next,\n            cs,\n            message,\n            [(\"follows\", follows)],\n            clock.since_epoch().value,\n          )\n          match mut disk.append(dir + \"/\" + codebase.log_file(), line + \"\\n\") {\n            Err(e) => return Err(f\"{e}\"),\n            Ok(_) => (),\n          }\n        }\n        program = next\n      }\n      mut notes.push(message + \" (\" + join(updated, \", \") + \")\")\n    }\n    git_run(mut launcher, top, [\"add\", \"--\", dir])!\n  }\n  Ok(notes)\n}"},{"name":"read_package","kind":"fn","old":null,"new":"486812a0b9e3920d","interface_changed":true,"affected":[],"module":"","text":"/// `package_decls`, or an error naming each file that can't be read or\n/// decoded.\nfn read_package(\n  disk: std.fs.Disk,\n  dir: String,\n  package: String,\n) -> Result[List[ast.Decl], String] {\n  rels := deps.module_files(disk, dir)\n  mut out := []\n  mut bad := []\n  for (i, r) in enumerate(decoded_files(disk, rels.map(rel -> dir + \"/\" + rel))) {\n    m := deps.module_name(package, get(rels, i) ?? \"\")\n    match r {\n      Ok(decls) => {\n        for d in decls {\n          mut out.push(ast.Decl { ..d, module: m })\n        }\n      },\n      Err(e) => mut bad.push(e),\n    }\n  }\n  if bad != [] {\n    return Err(join(bad, \"\\n\"))\n  }\n  Ok(deps.noalloc_marked(\n    out,\n    package,\n    deps.noalloc_modules(disk.read(dir + \"/strata.toml\") !! \"\"),\n  ))\n}"},{"name":"read_module","kind":"fn","old":null,"new":"8cd91695b71b855d","interface_changed":true,"affected":[],"module":"","text":"/// The definitions of module file `f`, or why it can't be read or decoded.\nfn read_module(disk: std.fs.Disk, f: String) -> Result[List[ast.Decl], String] {\n  bytes := disk.read_bytes(f) except e { return Err(f\"{f}: {e}\") }\n  img := binary.read(bytes) except e { return Err(f\"{f}: {e}\") }\n  Ok(img.decls)\n}"}]}
{"id":"3a81bd14796ddbee","time":1795821739,"message":"edit","changes":[{"name":"codebase.write_modules","kind":"fn","old":"49351f010e2c4d6f","new":"35caffe544b04391","interface_changed":false,"affected":[],"module":"codebase","text":"/// Writes `new`'s module files under `root` where they differ from `old`'s,\n/// each in one step (`write_file`), and removes the files of modules `new`\n/// no longer has. Every file is encoded before the first is written, and\n/// none is when a file to be replaced doesn't decode. A\n/// module whose definitions are unchanged is not written, nor encoded. In\n/// one that is, each unchanged definition keeps its stored bytes and header\n/// entry: only what changed is encoded. (`strata upgrade` encodes every\n/// file again.) A definition without an id takes that of the one it\n/// replaces (`binary.assign_ids`: the definition of its name in `old` or in\n/// the file), else a new one.\npub fn write_modules[F: std.fs.Files](\n  mut files: F,\n  root: String,\n  old: List[ast.Decl],\n  new0: List[ast.Decl],\n  global: Bool,\n) -> Result[(), String] {\n  was := codebase.by_module(old)\n  // the stored headers, for the ids of what `old` doesn't have\n  mut headers := []\n  for m in codebase.by_module(new0).0 {\n    match binary.read_header(\n      files.read_bytes(root + \"/\" + codebase.module_path(m)) !! [],\n    ) {\n      Ok(h) => mut headers.push(h),\n      Err(_) => (),\n    }\n  }\n  new := binary.assign_ids(new0, old, headers)\n  // (a name of another package, std's, that one module refers to by id is\n  // referred to by that id from all of them)\n  mut extra := Dict[String, ast.Key] {}\n  for h in headers {\n    for (q, id) in items(binary.ref_ids(h)) {\n      mut extra.insert(q, id)\n    }\n  }\n  now := codebase.by_module(new)\n  mut writes := []\n  for m in now.0 {\n    ds := get(now.1, m) ?? []\n    before := get(was.1, m) ?? []\n    path := root + \"/\" + codebase.module_path(m)\n    if ds == before && files.exists(path) {\n      continue\n    }\n    stored := files.read_bytes(path) !! []\n    bytes := codebase.module_bytes(stored, m, ds, before, new, global, extra)\n    if stored != bytes || !files.exists(path) {\n      if files.exists(path) {\n        match binary.read(stored) {\n          Err(e) => return Err(\n            f\"{path} can't be read or decoded ({e}): nothing is written\",\n          ),\n          Ok(_) => (),\n        }\n      }\n      mut writes.push((path, bytes))\n    }\n  }\n  for (path, bytes) in writes {\n    dir := codebase.parent(path)\n    if dir != \"\" {\n      mut files.make_dir(dir) !! ()\n    }\n    match codebase.write_file(mut files, path, bytes) {\n      Err(e) => return Err(e),\n      Ok(_) => (),\n    }\n  }\n  for m in was.0 {\n    path := root + \"/\" + codebase.module_path(m)\n    if !contains(now.1, m) && files.exists(path) {\n      match mut files.remove(path) {\n        Err(e) => return Err(f\"{e}\"),\n        Ok(_) => (),\n      }\n    }\n  }\n  Ok(())\n}","old_text":"/// Writes `new`'s module files under `root` where they differ from `old`'s,\n/// each in one step (`write_file`), and removes the files of modules `new`\n/// no longer has. Every file is encoded before the first is written. A\n/// module whose definitions are unchanged is not written, nor encoded. In\n/// one that is, each unchanged definition keeps its stored bytes and header\n/// entry: only what changed is encoded. (`strata upgrade` encodes every\n/// file again.) A definition without an id takes that of the one it\n/// replaces (`binary.assign_ids`: the definition of its name in `old` or in\n/// the file), else a new one.\npub fn write_modules[F: std.fs.Files](\n  mut files: F,\n  root: String,\n  old: List[ast.Decl],\n  new0: List[ast.Decl],\n  global: Bool,\n) -> Result[(), String] {\n  was := codebase.by_module(old)\n  // the stored headers, for the ids of what `old` doesn't have\n  mut headers := []\n  for m in codebase.by_module(new0).0 {\n    match binary.read_header(\n      files.read_bytes(root + \"/\" + codebase.module_path(m)) !! [],\n    ) {\n      Ok(h) => mut headers.push(h),\n      Err(_) => (),\n    }\n  }\n  new := binary.assign_ids(new0, old, headers)\n  // (a name of another package, std's, that one module refers to by id is\n  // referred to by that id from all of them)\n  mut extra := Dict[String, ast.Key] {}\n  for h in headers {\n    for (q, id) in items(binary.ref_ids(h)) {\n      mut extra.insert(q, id)\n    }\n  }\n  now := codebase.by_module(new)\n  mut writes := []\n  for m in now.0 {\n    ds := get(now.1, m) ?? []\n    before := get(was.1, m) ?? []\n    path := root + \"/\" + codebase.module_path(m)\n    if ds == before && files.exists(path) {\n      continue\n    }\n    stored := files.read_bytes(path) !! []\n    bytes := codebase.module_bytes(stored, m, ds, before, new, global, extra)\n    if stored != bytes || !files.exists(path) {\n      mut writes.push((path, bytes))\n    }\n  }\n  for (path, bytes) in writes {\n    dir := codebase.parent(path)\n    if dir != \"\" {\n      mut files.make_dir(dir) !! ()\n    }\n    match codebase.write_file(mut files, path, bytes) {\n      Err(e) => return Err(e),\n      Ok(_) => (),\n    }\n  }\n  for m in was.0 {\n    path := root + \"/\" + codebase.module_path(m)\n    if !contains(now.1, m) && files.exists(path) {\n      match mut files.remove(path) {\n        Err(e) => return Err(f\"{e}\"),\n        Ok(_) => (),\n      }\n    }\n  }\n  Ok(())\n}"}]}
{"id":"17b659d581b6d3ad","time":1795821825,"message":"edit","changes":[{"name":"edit_command","kind":"fn","old":"282beef3a61d5ce1","new":"ef36348ccde247e6","interface_changed":false,"affected":[],"module":"","text":"/// `strata edit [MODULE] [-m MSG] [--rm NAME].. [--no-commit] [--no-search]`\n/// and `strata\n/// add FILE [MODULE]`: definitions from standard input (or the file, or the\n/// editor) replace or join the package's of the same names in MODULE\n/// (default the root module). Recorded only if the whole package checks.\nfn edit_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  args: List[String],\n  cmd: String,\n) -> std.process.ExitCode {\n  if contains(args, \"--help\") || contains(args, \"-h\") {\n    mut console.write(command_usage(cmd))\n    return 0\n  }\n  // `--file F`: a script or a folder, outside any log. std's folder is\n  // edited as a package is, checked and atomic (it is built into strata).\n  mut line := args\n  mut opened: Option[Result[Opened, String]] = None\n  match [k for (k, x) in enumerate(args) where x == \"--file\"] {\n    [k, ..] => {\n      f := get(args, k + 1) ?? \"\"\n      rest := [x for (i, x) in enumerate(args) where i != k && i != k + 1]\n      if disk.is_dir(f) && package_name(disk, f) == \"std\" {\n        opened = Some(open_package_at(disk, process, f, cmd))\n        line = rest\n      } else {\n        return edit_file(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          f,\n          rest,\n          cmd,\n        )\n      }\n    },\n    [] => (),\n  }\n  timings.begin(\"edit: open\")\n  if opened is None\n    && codebase.find_root(disk, process.current_dir()) is None {\n    return fail_with(\n      mut console,\n      \"no package here (no strata.toml in this folder or above: run `strata init`, or pass --file)\",\n    )\n  }\n  o := (opened ?? open_package(disk, process, cmd)) except e {\n    return fail_with(mut console, e)\n  }\n  timings.end(\"edit: open\")\n  // (`--file std`: outside any log, as `--file` is: written and checked,\n  // never committed to git)\n  given_args := match edit_args(line) {\n    Ok(g) => EditArgs { ..g, commit: g.commit && opened is None },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // (`--rm NAME`: a qualified name, or a short one naming one definition,\n  // in MODULE first)\n  a := match removed_names(o.decls, if cmd == \"add\" {\n    \"\"\n  } else {\n    package_module(o.name, edit_module(given_args.module ?? \"\"))\n  }, given_args.removes) {\n    Ok(rs) => EditArgs { ..given_args, removes: rs },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // `add FILE [MODULE]`: the file's text, into MODULE. For a module file or\n  // a folder of them: its definitions, in their modules.\n  if cmd == \"add\" {\n    f := a.module ?? \"\"\n    stored_defs := if disk.is_dir(f) {\n      Some(read_package(disk, f, \"\") except e {\n        return fail_with(mut console, e)\n      })\n    } else {\n      match disk.read_bytes(f) {\n        Ok(bytes) => match binary.read(bytes) {\n          Ok(img) => Some(img.decls),\n          Err(_) => None,\n        },\n        Err(e) => return fail_with(mut console, f\"{f}: {e}\"),\n      }\n    }\n    match stored_defs {\n      Some(ds) => {\n        message := if a.message == \"edit\" {\n          \"import\"\n        } else {\n          a.message\n        }\n        return match apply_edit(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          clock,\n          cache,\n          o,\n          ds,\n          a.removes,\n          message,\n          a.commit,\n          cmd,\n          contains(line, \"--json\"),\n          [],\n          a.search,\n          true,\n        ) {\n          Ok(_) => 0,\n          Err(_) => 1,\n        }\n      },\n      None => (),\n    }\n  }\n  (text, module_arg, message) := if cmd == \"add\" {\n    f := a.module ?? \"\"\n    t := disk.read(f) except e {\n      return fail_with(mut console, f\"{f}: {e}\")\n    }\n    (t, a.extra ?? \"\", if a.message == \"edit\" {\n      \"import\"\n    } else {\n      a.message\n    })\n  } else if contains(line, \"--editor\")\n    || console.interactive()\n      && driver_terminal(1).to_int() == 1\n      && len(a.removes) == 0 {\n    // (an editor only for someone at the terminal: standard input and output\n    // both on it, and nothing to remove)\n    return edit_in_editor(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      clock,\n      cache,\n      o,\n      a,\n    )\n  } else {\n    match piped_input(\n      mut console,\n      len(a.removes) > 0,\n      \"strata edit [MODULE]\",\n    ) {\n      Ok(t) => (t, a.module ?? \"\", a.message),\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  // (std's modules as stored: `io` is `std.io`)\n  timings.begin(\"edit: parse\")\n  edits := parse.parse_module(\n    text,\n    package_module(o.name, edit_module(module_arg)),\n  ) except e {\n    code := fail_with(mut console, f\"parse error at {e}\")\n    if cmd == \"edit\" {\n      say_kept(\n        mut console,\n        keep_rejected(mut disk, o.root, [(module_arg, text)]),\n      )\n    }\n    return code\n  }\n  timings.end(\"edit: parse\")\n  match apply_edit(\n    mut console,\n    mut disk,\n    mut launcher,\n    process,\n    clock,\n    cache,\n    o,\n    edits,\n    a.removes,\n    message,\n    a.commit,\n    cmd,\n    contains(line, \"--json\"),\n    if cmd == \"edit\" {\n      [(module_arg, text)]\n    } else {\n      []\n    },\n    a.search,\n    a.proofs || cmd == \"add\",\n  ) {\n    Ok(_) => 0,\n    Err(_) => 1,\n  }\n}","old_text":"/// `strata edit [MODULE] [-m MSG] [--rm NAME].. [--no-commit] [--no-search]`\n/// and `strata\n/// add FILE [MODULE]`: definitions from standard input (or the file, or the\n/// editor) replace or join the package's of the same names in MODULE\n/// (default the root module). Recorded only if the whole package checks.\nfn edit_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  args: List[String],\n  cmd: String,\n) -> std.process.ExitCode {\n  if contains(args, \"--help\") || contains(args, \"-h\") {\n    mut console.write(command_usage(cmd))\n    return 0\n  }\n  // `--file F`: a script or a folder, outside any log. std's folder is\n  // edited as a package is, checked and atomic (it is built into strata).\n  mut line := args\n  mut opened: Option[Result[Opened, String]] = None\n  match [k for (k, x) in enumerate(args) where x == \"--file\"] {\n    [k, ..] => {\n      f := get(args, k + 1) ?? \"\"\n      rest := [x for (i, x) in enumerate(args) where i != k && i != k + 1]\n      if disk.is_dir(f) && package_name(disk, f) == \"std\" {\n        opened = Some(open_package_at(disk, process, f, cmd))\n        line = rest\n      } else {\n        return edit_file(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          f,\n          rest,\n          cmd,\n        )\n      }\n    },\n    [] => (),\n  }\n  timings.begin(\"edit: open\")\n  o := (opened ?? open_package(disk, process, cmd)) except {\n    return fail_with(\n      mut console,\n      \"no package here (no strata.toml in this folder or above: run `strata init`, or pass --file)\",\n    )\n  }\n  timings.end(\"edit: open\")\n  // (`--file std`: outside any log, as `--file` is: written and checked,\n  // never committed to git)\n  given_args := match edit_args(line) {\n    Ok(g) => EditArgs { ..g, commit: g.commit && opened is None },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // (`--rm NAME`: a qualified name, or a short one naming one definition,\n  // in MODULE first)\n  a := match removed_names(o.decls, if cmd == \"add\" {\n    \"\"\n  } else {\n    package_module(o.name, edit_module(given_args.module ?? \"\"))\n  }, given_args.removes) {\n    Ok(rs) => EditArgs { ..given_args, removes: rs },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // `add FILE [MODULE]`: the file's text, into MODULE. For a module file or\n  // a folder of them: its definitions, in their modules.\n  if cmd == \"add\" {\n    f := a.module ?? \"\"\n    stored_defs := if disk.is_dir(f) {\n      Some(read_package(disk, f, \"\") except e {\n        return fail_with(mut console, e)\n      })\n    } else {\n      match disk.read_bytes(f) {\n        Ok(bytes) => match binary.read(bytes) {\n          Ok(img) => Some(img.decls),\n          Err(_) => None,\n        },\n        Err(e) => return fail_with(mut console, f\"{f}: {e}\"),\n      }\n    }\n    match stored_defs {\n      Some(ds) => {\n        message := if a.message == \"edit\" {\n          \"import\"\n        } else {\n          a.message\n        }\n        return match apply_edit(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          clock,\n          cache,\n          o,\n          ds,\n          a.removes,\n          message,\n          a.commit,\n          cmd,\n          contains(line, \"--json\"),\n          [],\n          a.search,\n          true,\n        ) {\n          Ok(_) => 0,\n          Err(_) => 1,\n        }\n      },\n      None => (),\n    }\n  }\n  (text, module_arg, message) := if cmd == \"add\" {\n    f := a.module ?? \"\"\n    t := disk.read(f) except e {\n      return fail_with(mut console, f\"{f}: {e}\")\n    }\n    (t, a.extra ?? \"\", if a.message == \"edit\" {\n      \"import\"\n    } else {\n      a.message\n    })\n  } else if contains(line, \"--editor\")\n    || console.interactive()\n      && driver_terminal(1).to_int() == 1\n      && len(a.removes) == 0 {\n    // (an editor only for someone at the terminal: standard input and output\n    // both on it, and nothing to remove)\n    return edit_in_editor(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      clock,\n      cache,\n      o,\n      a,\n    )\n  } else {\n    match piped_input(\n      mut console,\n      len(a.removes) > 0,\n      \"strata edit [MODULE]\",\n    ) {\n      Ok(t) => (t, a.module ?? \"\", a.message),\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  // (std's modules as stored: `io` is `std.io`)\n  timings.begin(\"edit: parse\")\n  edits := parse.parse_module(\n    text,\n    package_module(o.name, edit_module(module_arg)),\n  ) except e {\n    code := fail_with(mut console, f\"parse error at {e}\")\n    if cmd == \"edit\" {\n      say_kept(\n        mut console,\n        keep_rejected(mut disk, o.root, [(module_arg, text)]),\n      )\n    }\n    return code\n  }\n  timings.end(\"edit: parse\")\n  match apply_edit(\n    mut console,\n    mut disk,\n    mut launcher,\n    process,\n    clock,\n    cache,\n    o,\n    edits,\n    a.removes,\n    message,\n    a.commit,\n    cmd,\n    contains(line, \"--json\"),\n    if cmd == \"edit\" {\n      [(module_arg, text)]\n    } else {\n      []\n    },\n    a.search,\n    a.proofs || cmd == \"add\",\n  ) {\n    Ok(_) => 0,\n    Err(_) => 1,\n  }\n}"},{"name":"move_command","kind":"fn","old":"4a3c8af931dc2a95","new":"a41250adf2578427","interface_changed":false,"affected":[],"module":"","text":"/// `strata move <name> <module> [-m MSG]` (`main` is the root module).\nfn move_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  args: List[String],\n) -> std.process.ExitCode {\n  o := open_package(disk, process, \"move\") except e {\n    return fail_with(mut console, e)\n  }\n  (msg, commit, words0) := message_and_rest(args)\n  json := contains(words0, \"--json\")\n  words := words0.filter(w -> w != \"--json\")\n  (old, target0) := match words {\n    [a, b] => (a, b),\n    _ => return fail_with(\n      mut console,\n      \"usage: strata move <name> <module>  (`main` is the root module)\",\n    ),\n  }\n  // (std's modules as stored: `io` is `std.io`)\n  target := package_module(o.name, if target0 == \"main\" {\n    \"\"\n  } else {\n    target0\n  })\n  old_q := if o.decls.any(d -> store.qname(d) == old) {\n    old\n  } else {\n    found := [store.qname(d) for d in o.decls where refactor.short(store.qname(d)) == old && !(d.kind is ast.UseDef)]\n    match found {\n      [one] => one,\n      [] => return fail_with(mut console, f\"no definition `{old}`\"),\n      many => return fail_with(\n        mut console,\n        f\"`{old}` is ambiguous: {join(many, \", \")}\",\n      ),\n    }\n  }\n  written := resolve.written(o.decls, o.std, o.core)\n  moved := refactor.move_def(\n    o.decls,\n    written,\n    old_q,\n    target,\n    builtin_names(o.core),\n  ) except e { return fail_with(mut console, e) }\n  // (its module as the definition says: a test's name may hold dots)\n  from_m := match o.decls.find(d -> store.qname(d) == old_q) {\n    Some(d) => d.module,\n    None => refactor.module_of(old_q),\n  }\n  short := if from_m == \"\" {\n    old_q\n  } else {\n    byte_slice(old_q, byte_len(from_m) + 1, byte_len(old_q))\n  }\n  new_q := refactor.qualify(target, short)\n  mut before := Dict[String, String] {}\n  for d in o.decls {\n    mut before.insert(\n      store.qname(d),\n      codebase.short_hex(binary.hash(d)),\n    )\n  }\n  shown_q := written_names(moved, o.std, o.core)\n  updated := [get(shown_q, store.qname(d)) ?? store.qname(d) for d in moved where !(d.kind is ast.UseDef)\n    && store.qname(d) != new_q\n    && match get(before, store.qname(d)) {\n      Some(h) => h != codebase.short_hex(binary.hash(d)),\n      None => false,\n    }]\n  shown := (m: String) -> if m == \"\" {\n    \"main\"\n  } else {\n    m\n  }\n  old_uses := [(d.module, text.decl_text(d)) for d in o.decls where d.kind is ast.UseDef]\n  imports := [f\"{shown(d.module)}: {text.decl_text(d)}\" for d in moved where d.kind is ast.UseDef\n    && !contains(old_uses, (d.module, text.decl_text(d)))]\n  message := msg ?? f\"move {old_q} → {shown(target)}\"\n  entry := f\"{{\\\"from\\\":{codebase.json_string(old_q)},\\\"to\\\":{codebase.json_string(new_q)},\\\"kind\\\":\\\"move\\\"}}\"\n  extra := [(\"renames\", \"[\" + entry + \"]\"), (\n    \"references\",\n    \"[\" + join(updated.map(u -> codebase.json_string(u)), \",\") + \"]\",\n  )]\n  if !apply_change(\n    mut console,\n    mut disk,\n    mut launcher,\n    clock,\n    cache,\n    o,\n    moved,\n    message,\n    extra,\n    [entry],\n    commit,\n  ) {\n    return 1\n  }\n  if json {\n    refs := \"[\" + join(updated.map(u -> codebase.json_string(u)), \",\") + \"]\"\n    mut console.print(\n      \"{\\\"from\\\":\"\n        + codebase.json_string(old_q)\n        + \",\\\"to\\\":\"\n        + codebase.json_string(new_q)\n        + \",\\\"references\\\":\"\n        + refs\n        + \"}\",\n    )\n    return 0\n  }\n  mut console.print(\n    f\"moved {old_q} from {shown(from_m)} to {shown(target)} ({codebase.module_path(target)})\",\n  )\n  match len(updated) {\n    0 => mut console.print(\"no other definition refers to it\"),\n    n => mut console.print(\n      f\"updated {n} definition{plural(n, \"\", \"s\")} that refer{plural(n, \"s\", \"\")} to it: {join(updated, \", \")}\",\n    ),\n  }\n  if len(imports) > 0 {\n    mut console.print(f\"imports: {join(imports, \"; \")}\")\n  }\n  0\n}","old_text":"/// `strata move <name> <module> [-m MSG]` (`main` is the root module).\nfn move_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  args: List[String],\n) -> std.process.ExitCode {\n  o := open_package(disk, process, \"move\") except {\n    return fail_with(\n      mut console,\n      \"`move` needs a package (it commits the change)\",\n    )\n  }\n  (msg, commit, words0) := message_and_rest(args)\n  json := contains(words0, \"--json\")\n  words := words0.filter(w -> w != \"--json\")\n  (old, target0) := match words {\n    [a, b] => (a, b),\n    _ => return fail_with(\n      mut console,\n      \"usage: strata move <name> <module>  (`main` is the root module)\",\n    ),\n  }\n  // (std's modules as stored: `io` is `std.io`)\n  target := package_module(o.name, if target0 == \"main\" {\n    \"\"\n  } else {\n    target0\n  })\n  old_q := if o.decls.any(d -> store.qname(d) == old) {\n    old\n  } else {\n    found := [store.qname(d) for d in o.decls where refactor.short(store.qname(d)) == old && !(d.kind is ast.UseDef)]\n    match found {\n      [one] => one,\n      [] => return fail_with(mut console, f\"no definition `{old}`\"),\n      many => return fail_with(\n        mut console,\n        f\"`{old}` is ambiguous: {join(many, \", \")}\",\n      ),\n    }\n  }\n  written := resolve.written(o.decls, o.std, o.core)\n  moved := refactor.move_def(\n    o.decls,\n    written,\n    old_q,\n    target,\n    builtin_names(o.core),\n  ) except e { return fail_with(mut console, e) }\n  // (its module as the definition says: a test's name may hold dots)\n  from_m := match o.decls.find(d -> store.qname(d) == old_q) {\n    Some(d) => d.module,\n    None => refactor.module_of(old_q),\n  }\n  short := if from_m == \"\" {\n    old_q\n  } else {\n    byte_slice(old_q, byte_len(from_m) + 1, byte_len(old_q))\n  }\n  new_q := refactor.qualify(target, short)\n  mut before := Dict[String, String] {}\n  for d in o.decls {\n    mut before.insert(\n      store.qname(d),\n      codebase.short_hex(binary.hash(d)),\n    )\n  }\n  shown_q := written_names(moved, o.std, o.core)\n  updated := [get(shown_q, store.qname(d)) ?? store.qname(d) for d in moved where !(d.kind is ast.UseDef)\n    && store.qname(d) != new_q\n    && match get(before, store.qname(d)) {\n      Some(h) => h != codebase.short_hex(binary.hash(d)),\n      None => false,\n    }]\n  shown := (m: String) -> if m == \"\" {\n    \"main\"\n  } else {\n    m\n  }\n  old_uses := [(d.module, text.decl_text(d)) for d in o.decls where d.kind is ast.UseDef]\n  imports := [f\"{shown(d.module)}: {text.decl_text(d)}\" for d in moved where d.kind is ast.UseDef\n    && !contains(old_uses, (d.module, text.decl_text(d)))]\n  message := msg ?? f\"move {old_q} → {shown(target)}\"\n  entry := f\"{{\\\"from\\\":{codebase.json_string(old_q)},\\\"to\\\":{codebase.json_string(new_q)},\\\"kind\\\":\\\"move\\\"}}\"\n  extra := [(\"renames\", \"[\" + entry + \"]\"), (\n    \"references\",\n    \"[\" + join(updated.map(u -> codebase.json_string(u)), \",\") + \"]\",\n  )]\n  if !apply_change(\n    mut console,\n    mut disk,\n    mut launcher,\n    clock,\n    cache,\n    o,\n    moved,\n    message,\n    extra,\n    [entry],\n    commit,\n  ) {\n    return 1\n  }\n  if json {\n    refs := \"[\" + join(updated.map(u -> codebase.json_string(u)), \",\") + \"]\"\n    mut console.print(\n      \"{\\\"from\\\":\"\n        + codebase.json_string(old_q)\n        + \",\\\"to\\\":\"\n        + codebase.json_string(new_q)\n        + \",\\\"references\\\":\"\n        + refs\n        + \"}\",\n    )\n    return 0\n  }\n  mut console.print(\n    f\"moved {old_q} from {shown(from_m)} to {shown(target)} ({codebase.module_path(target)})\",\n  )\n  match len(updated) {\n    0 => mut console.print(\"no other definition refers to it\"),\n    n => mut console.print(\n      f\"updated {n} definition{plural(n, \"\", \"s\")} that refer{plural(n, \"s\", \"\")} to it: {join(updated, \", \")}\",\n    ),\n  }\n  if len(imports) > 0 {\n    mut console.print(f\"imports: {join(imports, \"; \")}\")\n  }\n  0\n}"}]}
{"id":"5ea00ca812f7ab76","time":1795821901,"message":"edit","changes":[{"name":"view_command","kind":"fn","old":"ec1e0e66545c99b2","new":"f2c876e57e91e549","interface_changed":false,"affected":[],"module":"","text":"/// `strata view [SELECTOR] [--level 0|1|2] [--mocks] [--split DIR]\n/// [--members inline|separate]`.\n/// - A module (`view shop`, `view main` for the root module) is shown as\n/// the text `edit` reads back, in reading order (`views.order`), as is\n/// every view.\n/// - Other selectors show the definitions picked at a level of detail: 0 a\n/// map with one line each, 1 interfaces, 2 source. Default 1, or 0 with no\n/// selector (the package's map).\n/// - `--split DIR` writes every module as text (`shop/orders.st`).\n/// - `strata view LOCATION` is compiler/finding's `view_location`.\n/// - A name the program doesn't define is looked up in core and std (`view\n/// Dict`, `view insert`, `view std.json.parse`: `views.select_library`),\n/// also outside a package.\n/// Code is highlighted on a terminal.\nfn view_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  args: List[String],\n) -> std.process.ExitCode {\n  // a location (`DEF@HASH/PATH`, with `--context N`, `--def`):\n  // compiler/finding's\n  if args.any(a -> finding.is_location(a)) {\n    return finding.view_location(mut console, disk, process, args)\n  }\n  va := view_args(args) except e { return fail_with(mut console, e) }\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  core := read_core_at(disk, home)\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  stored := match viewed_program(disk, process, va.file) {\n    Ok(ds) => ds,\n    // (no package: a selector can still name core's and std's definitions)\n    Err(e) => if va.file is None\n      && va.selector is Some\n      && codebase.find_root(disk, process.current_dir()) is None {\n      []\n    } else {\n      return fail_with(mut console, e)\n    },\n  }\n  // (proof material hidden unless `--proofs`; `--split` writes everything,\n  // for reading back)\n  as_written := if va.proofs || va.split is Some {\n    resolve.written(stored, std, core)\n  } else {\n    resolve.written(stored, std, core).map(\n      d -> views.proofs_hidden(d),\n    )\n  }\n  // a union's members inline (by default: a type with a doc, an `impl` or\n  // a `derive` of its own stays on its own) or each on its own. Both read\n  // back the same.\n  as_files := if va.members == \"separate\" {\n    views.separate_members(as_written)\n  } else {\n    resolve.inline_members(as_written)\n  }\n  mut modules := []\n  for d in as_written {\n    if !contains(modules, d.module) {\n      mut modules.push(d.module)\n    }\n  }\n  modules = to_list(set(modules))\n  match va.split {\n    Some(dir) => {\n      for m in modules {\n        rel := codebase.module_path(m)\n        p := dir\n          + \"/\"\n          + byte_slice(rel, 0, byte_len(rel) - byte_len(\"strata\"))\n          + \"st\"\n        mut disk.make_dir(codebase.parent(p)) !! ()\n        match mut disk.write(\n          p,\n          text.module_text(\n            views.order(as_files.filter(d -> d.module == m)),\n          ),\n        ) {\n          Err(e) => return fail_with(mut console, f\"{e}\"),\n          Ok(_) => (),\n        }\n      }\n      return 0\n    },\n    None => (),\n  }\n  paint := console.paint(std.term.Output)\n  caps := capability_names(stored + std)\n  match viewed_module(va, modules) {\n    Some(m) => {\n      // (a module's lemmas only with `--proofs`)\n      text := text.module_text(views.order(as_files.filter(\n        d -> d.module == m && (va.proofs || !views.is_lemma(d)),\n      )))\n      mut console.write(\n        if text == \"\" {\n          \"\\n\"\n        } else {\n          highlight.code(paint, text, caps)\n        },\n      )\n      return 0\n    },\n    None => (),\n  }\n  g := store.graph(stored, false)\n  // each part of the selector the program doesn't name: core's or std's\n  (own_sel, lib_sel) := match va.selector {\n    Some(sel) => {\n      parts := split(sel, \",\").map(t -> trim(t))\n      mine := parts.filter(t -> views.select(stored, g, Some(t)) is Ok)\n      theirs := parts.filter(t -> !contains(mine, t))\n      (if mine == [] {\n        None\n      } else {\n        Some(join(mine, \",\"))\n      }, theirs)\n    },\n    None => (None, []),\n  }\n  names := if va.selector is Some && own_sel is None {\n    []\n  } else {\n    views.select(stored, g, own_sel) except e {\n      return fail_with(mut console, e)\n    }\n  }\n  // mocks are for tests, lemmas for proofs: shown when asked for, or\n  // picked by name\n  shown := if va.selector is Some {\n    names\n  } else {\n    names.filter(\n      q -> !stored.any(\n        d -> store.qname(d) == q\n          && match d.kind {\n            ast.TypeDef(t) => t.mocked && !va.mocks,\n            ast.FnDef(f) => f.lemma && !va.proofs,\n            _ => false,\n          },\n      ),\n    )\n  }\n  level := va.level or {\n    if va.selector is None {\n      0\n    } else {\n      1\n    }\n  }\n  mut text := if names == [] {\n    \"\"\n  } else {\n    views.view(stored, as_written, shown, level)\n  }\n  if lib_sel != [] {\n    // core's definitions (its runtime's left out) and std's\n    lib := core.decls.filter(\n        d ->\n          !builtins.runtime_module(d.module)\n            && d.module != \"core.mem\",\n      )\n      + std\n    lib_names := views.select_library(lib, join(lib_sel, \",\")) except e {\n      return fail_with(mut console, e)\n    }\n    text += views.view(\n      lib,\n      resolve.written(lib, std, core),\n      lib_names,\n      level,\n    )\n  }\n  mut console.write(highlight.code(paint, text, caps))\n  0\n}","old_text":"/// `strata view [SELECTOR] [--level 0|1|2] [--mocks] [--split DIR]\n/// [--members inline|separate]`.\n/// - A module (`view shop`, `view main` for the root module) is shown as\n/// the text `edit` reads back, in reading order (`views.order`), as is\n/// every view.\n/// - Other selectors show the definitions picked at a level of detail: 0 a\n/// map with one line each, 1 interfaces, 2 source. Default 1, or 0 with no\n/// selector (the package's map).\n/// - `--split DIR` writes every module as text (`shop/orders.st`).\n/// - `strata view LOCATION` is compiler/finding's `view_location`.\n/// - A name the program doesn't define is looked up in core and std (`view\n/// Dict`, `view insert`, `view std.json.parse`: `views.select_library`),\n/// also outside a package.\n/// Code is highlighted on a terminal.\nfn view_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  args: List[String],\n) -> std.process.ExitCode {\n  // a location (`DEF@HASH/PATH`, with `--context N`, `--def`):\n  // compiler/finding's\n  if args.any(a -> finding.is_location(a)) {\n    return finding.view_location(mut console, disk, process, args)\n  }\n  va := view_args(args) except e { return fail_with(mut console, e) }\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  core := read_core_at(disk, home)\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  stored := match viewed_program(disk, process, va.file) {\n    Ok(ds) => ds,\n    // (no package: a selector can still name core's and std's definitions)\n    Err(e) => if va.file is None && va.selector is Some {\n      []\n    } else {\n      return fail_with(mut console, e)\n    },\n  }\n  // (proof material hidden unless `--proofs`; `--split` writes everything,\n  // for reading back)\n  as_written := if va.proofs || va.split is Some {\n    resolve.written(stored, std, core)\n  } else {\n    resolve.written(stored, std, core).map(\n      d -> views.proofs_hidden(d),\n    )\n  }\n  // a union's members inline (by default: a type with a doc, an `impl` or\n  // a `derive` of its own stays on its own) or each on its own. Both read\n  // back the same.\n  as_files := if va.members == \"separate\" {\n    views.separate_members(as_written)\n  } else {\n    resolve.inline_members(as_written)\n  }\n  mut modules := []\n  for d in as_written {\n    if !contains(modules, d.module) {\n      mut modules.push(d.module)\n    }\n  }\n  modules = to_list(set(modules))\n  match va.split {\n    Some(dir) => {\n      for m in modules {\n        rel := codebase.module_path(m)\n        p := dir\n          + \"/\"\n          + byte_slice(rel, 0, byte_len(rel) - byte_len(\"strata\"))\n          + \"st\"\n        mut disk.make_dir(codebase.parent(p)) !! ()\n        match mut disk.write(\n          p,\n          text.module_text(\n            views.order(as_files.filter(d -> d.module == m)),\n          ),\n        ) {\n          Err(e) => return fail_with(mut console, f\"{e}\"),\n          Ok(_) => (),\n        }\n      }\n      return 0\n    },\n    None => (),\n  }\n  paint := console.paint(std.term.Output)\n  caps := capability_names(stored + std)\n  match viewed_module(va, modules) {\n    Some(m) => {\n      // (a module's lemmas only with `--proofs`)\n      text := text.module_text(views.order(as_files.filter(\n        d -> d.module == m && (va.proofs || !views.is_lemma(d)),\n      )))\n      mut console.write(\n        if text == \"\" {\n          \"\\n\"\n        } else {\n          highlight.code(paint, text, caps)\n        },\n      )\n      return 0\n    },\n    None => (),\n  }\n  g := store.graph(stored, false)\n  // each part of the selector the program doesn't name: core's or std's\n  (own_sel, lib_sel) := match va.selector {\n    Some(sel) => {\n      parts := split(sel, \",\").map(t -> trim(t))\n      mine := parts.filter(t -> views.select(stored, g, Some(t)) is Ok)\n      theirs := parts.filter(t -> !contains(mine, t))\n      (if mine == [] {\n        None\n      } else {\n        Some(join(mine, \",\"))\n      }, theirs)\n    },\n    None => (None, []),\n  }\n  names := if va.selector is Some && own_sel is None {\n    []\n  } else {\n    views.select(stored, g, own_sel) except e {\n      return fail_with(mut console, e)\n    }\n  }\n  // mocks are for tests, lemmas for proofs: shown when asked for, or\n  // picked by name\n  shown := if va.selector is Some {\n    names\n  } else {\n    names.filter(\n      q -> !stored.any(\n        d -> store.qname(d) == q\n          && match d.kind {\n            ast.TypeDef(t) => t.mocked && !va.mocks,\n            ast.FnDef(f) => f.lemma && !va.proofs,\n            _ => false,\n          },\n      ),\n    )\n  }\n  level := va.level or {\n    if va.selector is None {\n      0\n    } else {\n      1\n    }\n  }\n  mut text := if names == [] {\n    \"\"\n  } else {\n    views.view(stored, as_written, shown, level)\n  }\n  if lib_sel != [] {\n    // core's definitions (its runtime's left out) and std's\n    lib := core.decls.filter(\n        d ->\n          !builtins.runtime_module(d.module)\n            && d.module != \"core.mem\",\n      )\n      + std\n    lib_names := views.select_library(lib, join(lib_sel, \",\")) except e {\n      return fail_with(mut console, e)\n    }\n    text += views.view(\n      lib,\n      resolve.written(lib, std, core),\n      lib_names,\n      level,\n    )\n  }\n  mut console.write(highlight.code(paint, text, caps))\n  0\n}"}]}
{"id":"02fce38620084d91","time":1795821983,"message":"edit","changes":[{"name":"file_errors","kind":"fn","old":"381caf1f4bf49027","new":"4ee1ad983fa7c80c","interface_changed":false,"affected":[],"module":"","text":"/// As `strata check` finds them, for a stored file or package folder `a`.\n/// A module file of a package is checked with its package, and only its\n/// module's errors are kept.\n/// `pre` holds codegen's options naming std's precompiled functions, for\n/// the literal probes.\n/// \n/// A package's module files are checked together, each definition in its\n/// module (`core.run`), with the definitions of std and of its dependencies\n/// they reach as context. The resolver's errors come first: a `use` of what\n/// isn't there, or of what a dependency keeps private or doesn't export.\n/// `with_deps` checks the dependencies' tests too; otherwise they are\n/// checked in their own package. What the program never uses comes last\n/// (`unused_of`).\nfn file_errors(\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  cache: cache.Cache,\n  std_dir: String,\n  a: String,\n  with_deps: Bool,\n  core: builtins.Core,\n  sh: Shared,\n  pre: List[String],\n) -> List[(String, String)] {\n  match disk.read(a + \"/strata.toml\") {\n    Ok(_) => match load_package(\n      mut launcher,\n      mut disk,\n      cache,\n      std_dir,\n      a,\n      with_deps,\n      core,\n    ) {\n      Err(e) => [(\"\", e)],\n      Ok(p) => {\n        (s, strict) := unused_setting(disk, a)\n        loaded_errors(mut disk, p, core, a, std_dir, sh, pre)\n          + unused_of(p.own, p.context, core, s, strict)\n      },\n    },\n    Err(_) => {\n      // a module file of a package: checked with its package, as `strata\n      // check` checks it (its imports name the package's other modules),\n      // and only its own module's errors kept\n      if !disk.is_dir(a) {\n        match module_at(disk, a) {\n          Some((r, m)) => return file_errors(\n            mut launcher,\n            mut disk,\n            cache,\n            std_dir,\n            r,\n            with_deps,\n            core,\n            sh,\n            pre,\n          ).filter(\n            e -> e.0 == \"\"\n              || owning_module(modules_of(disk, r), e.0) == m,\n          ),\n          None => (),\n        }\n      }\n      // a folder of module files without strata.toml: a package with no\n      // dependencies\n      ds := if len(deps.module_files(disk, a)) > 0 {\n        read_package(disk, a, \"\") except e { return [(\"\", e)] }\n      } else {\n        match get(decoded_files(disk, [a]), 0) {\n          Some(Ok(ds)) => ds,\n          Some(Err(e)) => return [(\"\", e)],\n          None => [],\n        }\n      }\n      lib := std_imports(disk, std_dir, ds)\n      std_use_check(\n          disk,\n          std_dir,\n          ds,\n          use_errors_of(ds, lib, Set[String] {}, core),\n        )\n        + check_errors_with(\n          ds,\n          lib,\n          core,\n          false,\n          comptime_runner(disk, sh),\n        )\n        + literal_errors_of(disk, ds, lib, core, a, sh, pre)\n        + unused_of(ds, lib, core, unused.script(), false)\n    },\n  }\n}","old_text":"/// As `strata check` finds them, for a stored file or package folder `a`.\n/// A module file of a package is checked with its package, and only its\n/// module's errors are kept.\n/// `pre` holds codegen's options naming std's precompiled functions, for\n/// the literal probes.\n/// \n/// A package's module files are checked together, each definition in its\n/// module (`core.run`), with the definitions of std and of its dependencies\n/// they reach as context. The resolver's errors come first: a `use` of what\n/// isn't there, or of what a dependency keeps private or doesn't export.\n/// `with_deps` checks the dependencies' tests too; otherwise they are\n/// checked in their own package. What the program never uses comes last\n/// (`unused_of`).\nfn file_errors(\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  cache: cache.Cache,\n  std_dir: String,\n  a: String,\n  with_deps: Bool,\n  core: builtins.Core,\n  sh: Shared,\n  pre: List[String],\n) -> List[(String, String)] {\n  match disk.read(a + \"/strata.toml\") {\n    Ok(_) => match load_package(\n      mut launcher,\n      mut disk,\n      cache,\n      std_dir,\n      a,\n      with_deps,\n      core,\n    ) {\n      Err(e) => [(\"\", e)],\n      Ok(p) => {\n        (s, strict) := unused_setting(disk, a)\n        loaded_errors(mut disk, p, core, a, std_dir, sh, pre)\n          + unused_of(p.own, p.context, core, s, strict)\n      },\n    },\n    Err(_) => {\n      // a module file of a package: checked with its package, as `strata\n      // check` checks it (its imports name the package's other modules),\n      // and only its own module's errors kept\n      if !disk.is_dir(a) {\n        match module_at(disk, a) {\n          Some((r, m)) => return file_errors(\n            mut launcher,\n            mut disk,\n            cache,\n            std_dir,\n            r,\n            with_deps,\n            core,\n            sh,\n            pre,\n          ).filter(\n            e -> e.0 == \"\"\n              || owning_module(modules_of(disk, r), e.0) == m,\n          ),\n          None => (),\n        }\n      }\n      // a folder of module files without strata.toml: a package with no\n      // dependencies\n      ds := if len(deps.module_files(disk, a)) > 0 {\n        package_decls(disk, a, \"\")\n      } else {\n        module_decls(disk, [a])\n      }\n      lib := std_imports(disk, std_dir, ds)\n      std_use_check(\n          disk,\n          std_dir,\n          ds,\n          use_errors_of(ds, lib, Set[String] {}, core),\n        )\n        + check_errors_with(\n          ds,\n          lib,\n          core,\n          false,\n          comptime_runner(disk, sh),\n        )\n        + literal_errors_of(disk, ds, lib, core, a, sh, pre)\n        + unused_of(ds, lib, core, unused.script(), false)\n    },\n  }\n}"}]}
{"id":"f597f31cd36965ce","time":1795824811,"message":"termination: model pattern-bound types, recursion on elements through builtins","changes":[{"name":"termination.use ast","kind":"use","old":"5760c52f10265b45","new":"083968d5d94bbd8c","interface_changed":true,"affected":[],"module":"termination","text":"from ast use FnDecl, TypeDecl, TypeExpr, Expr, Stmt, Pattern, Param, ImplDecl,\n  TraitDecl, Named, FnType, UnitType, Refined, UnionType, RowType, Alias,\n  RecordBody, SumBody, NoPayload, Positional, RecordPayload, MemberType, IntLit,\n  FloatLit, StrLit, Var, Hole, CtorExpr, Call, MethodCall, FieldOf, Lambda,\n  Binary, MatchExpr, MutExpr, Block, MockExpr, Return, TupleExpr, ListExpr, Div,\n  Mod, Sub, Less, LessEq, Greater, GreaterEq, NotEqual, Equal, Let, VarDecl,\n  Assign, While, For, ExprStmt, Assert, Invariant, Decreases, ComptimeFor, Wild,\n  Bind, CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat, NoPats,\n  PositionalPats, RecordPats, TypePats, AssertBy, Calc, BoolLit, Bound, Field,\n  Select, Race, UnitExpr","old_text":"from ast use FnDecl, TypeDecl, TypeExpr, Expr, Stmt, Pattern, Param, ImplDecl,\n  TraitDecl, Named, FnType, UnitType, Refined, UnionType, RowType, Alias,\n  RecordBody, SumBody, NoPayload, Positional, RecordPayload, MemberType, IntLit,\n  FloatLit, StrLit, Var, Hole, CtorExpr, Call, MethodCall, FieldOf, Lambda,\n  Binary, MatchExpr, MutExpr, Block, MockExpr, Return, TupleExpr, ListExpr, Div,\n  Mod, Sub, Less, LessEq, Greater, GreaterEq, NotEqual, Equal, Let, VarDecl,\n  Assign, While, For, ExprStmt, Assert, Invariant, Decreases, ComptimeFor, Wild,\n  Bind, CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat, NoPats,\n  PositionalPats, RecordPats, TypePats, AssertBy, Calc, BoolLit, Bound"},{"name":"termination.Structural","kind":"type","old":"708fa26ab86fe90e","new":"4238b4dbe39f36a3","interface_changed":true,"affected":["termination.structural","termination.struct_expr","termination.struct_call","termination.pattern_conds","termination.bind_piece","termination.struct_element","termination.analyze_with","verify_program","termination.analyze","search_invariants","build_proofs","verify_file","live_edit_command","alongside_command","smt_file","termination_file","static_graph","edit_file","apply_edit","fix_loops","run_command","build_command","command_line","std_proofs","verify_command","strata_command","graph_command","graph_diff","repl_command","edit_command","edit_in_editor","new_command","fix_command","main","std_library","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","check_command","test_command","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","build_core_command","comptime_value","literal_errors_of","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","comptime_values","loaded_check","file_errors","edit_errors","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","apply_change","with_base","package_errors","rename_command","move_command"],"module":"termination","text":"/// The recursive-call walk: the function's names as called, the variables\n/// assigned, and for each recursive call the parameters whose argument is\n/// smaller. `elem_calls`: the calls of `element_calls`, each a recursive\n/// call on an element of its list.\ntype Structural = {\n  names: Set[String],\n  assigned: Set[String],\n  calls: List[Set[Int]],\n  elem_calls: List[ast.Expr] = [],\n}","old_text":"/// The recursive-call walk: the function's names as called, the variables\n/// assigned, and for each recursive call the parameters whose argument is\n/// smaller.\ntype Structural = {\n  names: Set[String],\n  assigned: Set[String],\n  calls: List[Set[Int]],\n}"},{"name":"termination.analyze_with","kind":"fn","old":"1f22348614466b43","new":"fd51566515943fe1","interface_changed":false,"affected":[],"module":"termination","text":"/// A call graph node: a function, an implementation's method, or a trait\n/// `analyze`, reusing what earlier runs found: `known` gives a function's\n/// loops (how each ends or why one may not, and whether one is a `for` over\n/// an iterator), `known_measure` a recursive function's measure (`None`\n/// when none was found). Returns the analysis and the new loop and measure\n/// results. The graph work is linear: strongly connected components are found\n/// once.\n/// All solver questions (`while` bounds, measures) are asked together, each\n/// function's in its own order.\npub fn analyze_with(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  ctx: termination.Ctx,\n  roots: Option[Set[String]],\n  known: (String) -> Option[(Result[List[String], String], Bool)],\n  known_measure: (String) -> Option[Option[String]],\n) -> (termination.Analysis, Dict[String, (Result[List[String], String], Bool)], Dict[String, Option[String]]) {\n  mut nodes := Dict[String, termination.Node] {}\n  for (name, f) in items(ctx.fns) {\n    m := termination.short(name)\n    self_head := if (get(ctx.own_fns, m) ?? []).contains(name) {\n      termination.own_type_of(name, m)\n    } else {\n      \"\"\n    }\n    mut calls := termination.calls_within(\n      ctx,\n      f.body,\n      f.params,\n      f.type_params,\n      self_head,\n      \"\",\n    )\n    for c in f.pre + f.post {\n      calls = union(calls, termination.calls_within(\n        ctx,\n        c,\n        f.params,\n        f.type_params,\n        self_head,\n        \"\",\n      ))\n    }\n    mut nodes.insert(\n      name,\n      termination.Node { decl: Some(f), calls, body: Some(f) },\n    )\n  }\n  // implementation methods by label; each trait method's node reaches\n  // every implementation of it\n  mut impl_decls := []\n  for imp in ctx.methods.impls {\n    match termination.trait_of(ctx, imp) {\n      Some(tr) => {\n        for tm in tr.methods {\n          own := get(imp.methods.filter(m -> m.name == tm.decl.name), 0)\n          decl := match own {\n            Some(d) => Some(d),\n            None => if tm.default {\n              Some(tm.decl)\n            } else {\n              None\n            },\n          }\n          match decl {\n            Some(d) => {\n              label := termination.impl_label(ctx, imp, tm.decl.name)\n              tn := termination.trait_node(tm.decl.name)\n              calls := termination.calls_within(\n                ctx,\n                d.body,\n                termination.for_impl(imp, d).params,\n                imp.type_params + d.type_params,\n                \"\",\n                tn,\n              )\n              mut nodes.insert(\n                label,\n                termination.Node {\n                  decl: None,\n                  calls,\n                  body: Some(termination.for_impl(imp, d)),\n                },\n              )\n              t := get(nodes, tn) ?? termination.no_node()\n              mut nodes.insert(\n                tn,\n                termination.Node { ..t, calls: {\n                  mut copy := t.calls\n                  mut copy.insert(label)\n                  copy\n                } },\n              )\n              mut impl_decls.push((label, d))\n            },\n            None => (),\n          }\n        }\n      },\n      None => (),\n    }\n  }\n  // trait methods no implementation defines\n  for n in values(nodes) {\n    for c in to_list(n.calls) {\n      if !contains(nodes, c) {\n        mut nodes.insert(c, termination.no_node())\n      }\n    }\n  }\n  names := keys(nodes)\n  // a node reaches itself when it calls itself or shares its component\n  comp := termination.components(names, nodes)\n  mut sizes := Dict[Int, Int] {}\n  for n in names {\n    c := get(comp, n) ?? -1\n    mut sizes.insert(c, (get(sizes, c) ?? 0) + 1)\n  }\n  same := (a: String, b: String) -> get(comp, a) ?? -1 == get(comp, b) ?? -2\n  recursive := set(names.filter(\n    n -> contains((get(nodes, n) ?? termination.no_node()).calls, n)\n      || get(sizes, get(comp, n) ?? -1) ?? 0 > 1,\n  ))\n  // the nodes whose verdict is wanted: the roots, the helpers refinements\n  // call (seen through wherever a type is checked), and what they reach\n  needed := match roots {\n    None => None,\n    Some(rs) => {\n      mut preds := []\n      for td in values(ctx.types) {\n        match td.refinement {\n          Some(r) => mut preds.push(r),\n          None => (),\n        }\n        match td.body {\n          ast.Alias(a) => {\n            preds += termination.refinements_in(a)\n          },\n          ast.RecordBody(fs) => {\n            for f in fs {\n              preds += termination.refinements_in(f.ty)\n            }\n          },\n          ast.SumBody(vs) => {\n            for v in vs {\n              match v.payload {\n                ast.Positional(ts) => {\n                  for t in ts {\n                    preds += termination.refinements_in(t)\n                  }\n                },\n                ast.RecordPayload(fs) => {\n                  for f in fs {\n                    preds += termination.refinements_in(f.ty)\n                  }\n                },\n                ast.MemberType(t) => {\n                  preds += termination.refinements_in(t)\n                },\n                ast.NoPayload => (),\n              }\n            }\n          },\n        }\n      }\n      for f in values(ctx.fns) {\n        for p in f.params {\n          preds += termination.refinements_in(p.ty)\n        }\n        preds += termination.refinements_in(f.ret)\n      }\n      mut all := rs\n      for e in preds {\n        all = union(all, termination.calls_within(ctx, e, [ast.Param {\n          name: \"it\",\n          ty: ast.UnitType,\n          mutable: false,\n          compile_time: false,\n        }], [], \"\", \"\"))\n      }\n      starts := to_list(all).filter(r -> contains(nodes, r))\n      Some(\n        union(set(starts), termination.reached_from(starts, nodes)),\n      )\n    },\n  }\n  wanted := (n: String) -> match needed {\n    None => true,\n    Some(s) => contains(s, n),\n  }\n  skipped := \"not analysed (nothing being verified reaches it)\"\n  // the `while` loops' bounds of what is wanted and not known, encoded\n  // together so their solver questions are asked at once\n  mut whiles := []\n  mut had := Dict[String, (Result[List[String], String], Bool)] {}\n  for n in names {\n    match (get(nodes, n) ?? termination.no_node()).body {\n      Some(b) => if wanted(n) {\n        match known(n) {\n          Some(x) => mut had.insert(n, x),\n          None => if termination.has_while(b) {\n            mut whiles.push((b, n))\n          },\n        }\n      },\n      None => (),\n    }\n  }\n  mut learned := Dict[String, (Result[List[String], String], Bool)] {}\n  mut encoded := Dict[String, smt.Vc] {}\n  timings.begin(\"verify: termination: encode\")\n  // (with the loop invariants derived from the code: a loop whose bound\n  // isn't shown to go down with them alone is searched below)\n  quick := smt.Methods { ..ctx.methods, search: 0 }\n  encoded_all := smt.encode_all(\n    mut commands,\n    mut files,\n    ctx.scratch,\n    ctx.solver,\n    ctx.fns,\n    ctx.types,\n    ctx.sigs,\n    quick,\n    whiles,\n  )\n  timings.end(\"verify: termination: encode\")\n  for (i, vc) in enumerate(encoded_all) {\n    match get(whiles, i) {\n      Some((_, n)) => mut encoded.insert(n, vc),\n      None => (),\n    }\n  }\n  // the loops of what is wanted and not known: those that need no solver\n  // first, then all `while` bounds asked together, each function's in order\n  mut searched := []\n  mut searches := []\n  timings.begin(\"verify: termination: loops\")\n  // functions with a `for` loop and no `while`, run on the workers to find\n  // what their loops run over\n  mut fors := []\n  for n in names {\n    match (get(nodes, n) ?? termination.no_node()).body {\n      Some(b) => if wanted(n)\n        && !contains(had, n)\n        && !termination.has_while(b)\n        && termination.has_for(b) {\n        mut fors.push((b, n))\n      },\n      None => (),\n    }\n  }\n  for ((_, n), vc) in zip(fors, parallel.map_parallel(fors, x -> {\n    mut v := smt.new_vc(ctx.fns, ctx.types, ctx.sigs, quick)\n    smt.function(mut v, x.0, x.1)\n    v\n  })) {\n    mut encoded.insert(n, vc)\n  }\n  for n in names {\n    match (get(nodes, n) ?? termination.no_node()).body {\n      Some(b) => if wanted(n) && !contains(had, n) {\n        mut iterates := false\n        s := termination.loop_start(\n          mut commands,\n          mut files,\n          ctx,\n          b,\n          n,\n          encoded,\n          mut iterates,\n        )\n        mut searched.push((n, iterates))\n        mut searches.push(s)\n      },\n      None => (),\n    }\n  }\n  timings.end(\"verify: termination: loops\")\n  for ((n, iterates), r) in zip(\n    searched,\n    termination.loops_all(mut commands, mut files, ctx, searches),\n  ) {\n    mut learned.insert(n, (r, iterates))\n  }\n  // the functions with a loop whose bound isn't shown to go down, where\n  // a loop's invariant search was left out: encoded again with it\n  mut again := []\n  for (b, n) in whiles {\n    match (get(learned, n), get(encoded, n)) {\n      (Some((Err(m), _)), Some(vc)) => if vc.skipped != []\n        && contains(m, \"no bound was shown to go down\") {\n        mut again.push((b, n))\n      },\n      _ => (),\n    }\n  }\n  // (no search, `Methods.search` 0, as `verify` and `build` run: a loop\n  // whose bound isn't shown to go down says how to go on)\n  mut found_loops := Dict[String, List[smt.LoopFound]] {}\n  if ctx.methods.search == 0 {\n    for (_, n) in again {\n      match get(learned, n) {\n        Some((Err(m), it)) => mut learned.insert(\n          n,\n          (\n            Err(\n              m\n                + \"; write an `invariant` or a `decreases` for it, or run `strata fix \"\n                + n\n                + \"` to search for an invariant\",\n            ),\n            it,\n          ),\n        ),\n        _ => (),\n      }\n    }\n  }\n  if again != [] && ctx.methods.search > 0 {\n    timings.begin(\"verify: termination: searched\")\n    for (i, vc) in enumerate(smt.encode_all(\n      mut commands,\n      mut files,\n      ctx.scratch,\n      ctx.solver,\n      ctx.fns,\n      ctx.types,\n      ctx.sigs,\n      ctx.methods,\n      again,\n    )) {\n      match get(again, i) {\n        Some((_, n)) => {\n          mut encoded.insert(n, vc)\n          if vc.found_loops != [] {\n            mut found_loops.insert(n, vc.found_loops)\n          }\n        },\n        None => (),\n      }\n    }\n    mut searched_again := []\n    mut searches_again := []\n    for (b, n) in again {\n      mut iterates := false\n      s := termination.loop_start(\n        mut commands,\n        mut files,\n        ctx,\n        b,\n        n,\n        encoded,\n        mut iterates,\n      )\n      mut searched_again.push((n, iterates))\n      mut searches_again.push(s)\n    }\n    for ((n, iterates), r) in zip(searched_again, termination.loops_all(\n      mut commands,\n      mut files,\n      ctx,\n      searches_again,\n    )) {\n      mut learned.insert(n, (r, iterates))\n    }\n    timings.end(\"verify: termination: searched\")\n  }\n  mut loops_of := Dict[String, Result[List[String], String]] {}\n  mut iterating := Set[String] {}\n  for n in names {\n    node := get(nodes, n) ?? termination.no_node()\n    match node.body {\n      Some(_) => {\n        r := if wanted(n) {\n          (found, iterates) := get(had, n) ?? get(learned, n) ?? (Ok([]), false)\n          if iterates {\n            mut iterating.insert(n)\n          }\n          found\n        } else {\n          Err(skipped)\n        }\n        mut loops_of.insert(n, r)\n      },\n      None => (),\n    }\n  }\n  // a callee in its component reaches it\n  mutual := (n: String) -> get(\n    to_list((get(nodes, n) ?? termination.no_node()).calls).filter(\n      c -> c != n && same(c, n),\n    ),\n    0,\n  )\n  // the measures of functions that call only themselves without passing a\n  // smaller piece of a parameter, searched together, each in its order\n  mut measured_names := []\n  mut measure_searches := []\n  mut measures := Dict[String, Option[String]] {}\n  for n in names {\n    node := get(nodes, n) ?? termination.no_node()\n    if wanted(n) && contains(node.calls, n) && mutual(n) is None {\n      match (get(loops_of, n) ?? Ok([]), node.decl) {\n        (Ok(_), Some(f)) => if termination.structural(ctx, f, n) is None\n          && termination.element_calls(ctx, f, Set { n, f.name }) == [] {\n          match known_measure(n) {\n            Some(m) => mut measures.insert(n, m),\n            None => {\n              mut measured_names.push(n)\n              mut measure_searches.push(\n                termination.measure_start(ctx, f, n),\n              )\n            },\n          }\n        },\n        _ => (),\n      }\n    }\n  }\n  mut measured := Dict[String, Option[String]] {}\n  for (n, s) in zip(measured_names, termination.measures_all(\n    mut commands,\n    mut files,\n    ctx,\n    measure_searches,\n  )) {\n    // a `decreases` clause's measure is the one tried\n    written := match (get(nodes, n) ?? termination.no_node()).decl {\n      Some(f) => text.decreases_text(f.body),\n      None => \"\",\n    }\n    m := match s.found {\n      Some(ms) => Some(if written != \"\" {\n        \"its `\" + written + \"` measure\"\n      } else {\n        termination.measure_shown(ms)\n      }),\n      None => None,\n    }\n    mut measures.insert(n, m)\n    mut measured.insert(n, m)\n  }\n  // each node's own verdict, ignoring its callees\n  mut own := Dict[String, Result[String, String]] {}\n  for n in names {\n    node := get(nodes, n) ?? termination.no_node()\n    if !wanted(n) {\n      mut own.insert(n, Err(skipped))\n      continue\n    }\n    r := match get(loops_of, n) ?? Ok([]) {\n      Err(e) => Err(e),\n      Ok(hows) => match mutual(n) {\n        Some(other) => Err(\"it is recursive through `\"\n          + termination.shown_node(other)\n          + \"`\"),\n        None => if contains(node.calls, n) {\n          match node.decl {\n            Some(f) => if termination.passes_itself(ctx, f, Set { n, f.name }) {\n              Err(\n                \"it passes itself as a function value, and calls through a function value aren't followed\",\n              )\n            } else {\n              match termination.structural(ctx, f, n) {\n                Some(p) => Ok(\"each recursive call gets a smaller piece of `\"\n                  + p\n                  + \"`\"),\n                None => if termination.element_calls(ctx, f, Set { n, f.name }) != [] {\n                  Err(\n                    \"it passes itself to a builtin that calls it on the elements of a list, and no parameter was found that the list is a piece of\",\n                  )\n                } else {\n                  match get(measures, n) ?? None {\n                    Some(m) => Ok(\n                      m\n                        + \" goes down on every recursive call and is never negative there\",\n                    ),\n                    None => Err(\n                      if text.decreases_text(f.body) != \"\" {\n                        \"its `\"\n                          + text.decreases_text(f.body)\n                          + \"` was not shown to go down on every recursive call (it is checked when the program runs)\"\n                      } else {\n                        \"it calls itself, and nothing was found that gets smaller on every call (a piece of a parameter, or a non-negative measure of the parameters)\"\n                      },\n                    ),\n                  }\n                },\n              }\n            },\n            None => Err(\n              \"it calls itself, and nothing was found that gets smaller on every call (a piece of a parameter, or a non-negative measure of the parameters)\",\n            ),\n          }\n        } else if len(hows) == 0 {\n          Ok(\"no recursion, and only `for` loops\")\n        } else {\n          Ok(join(hows, \"; \"))\n        },\n      },\n    }\n    mut own.insert(n, r)\n  }\n  mut marked := Set[String] {}\n  for (n, f) in items(ctx.fns) {\n    if f.terminating {\n      mut marked.insert(n)\n    }\n  }\n  for (label, d) in impl_decls {\n    if d.terminating {\n      mut marked.insert(label)\n    }\n  }\n  // combined with the callees, deepest first; cycles are already unknown\n  mut memo := Dict[String, termination.Termination] {}\n  for n in names {\n    termination.resolve(\n      nodes,\n      own,\n      marked,\n      mut memo,\n      n,\n      Set[String] {},\n    )\n  }\n  // transparent: finishes, and cannot fail (its callees transparent, or\n  // recursive functions a contract may unfold); recursive functions a\n  // contract may unfold (`compiler/smt`'s `def_call`): they call only\n  // themselves, finish, and fail nowhere else\n  mut transparent := Dict[String, Bool] {}\n  mut unfold := Set[String] {}\n  // (both: what a body seen through may call)\n  mut callable := Dict[String, Bool] {}\n  mut changed := true\n  while changed {\n    changed = false\n    for (name, f) in items(ctx.fns) {\n      if contains(unfold, name)\n        || !contains(recursive, name)\n        || get(sizes, get(comp, name) ?? -1) ?? 0 != 1 {\n        continue\n      }\n      ends := match get(memo, name) {\n        Some(termination.Proven(_)) | Some(termination.Assumed(_)) => true,\n        _ => false,\n      }\n      mut with_self := callable\n      mut with_self.insert(name, false)\n      if ends && termination.cannot_fail(ctx, f, with_self) {\n        mut unfold.insert(name)\n        mut callable.insert(name, false)\n        changed = true\n      }\n    }\n    for (name, f) in items(ctx.fns) {\n      if contains(transparent, name)\n        || contains(recursive, name)\n        || contains(iterating, name) {\n        continue\n      }\n      (ends, assumed) := match get(memo, name) {\n        Some(termination.Proven(_)) => (true, false),\n        Some(termination.Assumed(_)) => (true, true),\n        _ => (false, false),\n      }\n      if !ends {\n        continue\n      }\n      if termination.cannot_fail(ctx, f, callable) {\n        mut transparent.insert(name, assumed)\n        mut callable.insert(name, assumed)\n        changed = true\n      }\n    }\n    // implementation methods, by label\n    for imp in ctx.methods.impls {\n      for m in imp.methods {\n        label := termination.impl_label(ctx, imp, m.name)\n        if contains(transparent, label)\n          || contains(recursive, label)\n          || contains(iterating, label) {\n          continue\n        }\n        (ends, assumed) := match get(memo, label) {\n          Some(termination.Proven(_)) => (true, false),\n          Some(termination.Assumed(_)) => (true, true),\n          _ => (false, false),\n        }\n        if !ends {\n          continue\n        }\n        if termination.cannot_fail(\n          ctx,\n          termination.with_trait_contract(ctx, imp, m),\n          callable,\n        ) {\n          mut transparent.insert(label, assumed)\n          mut callable.insert(label, assumed)\n          changed = true\n        }\n      }\n    }\n  }\n  // (what a search cut short, the search budget used up, found is not kept)\n  mut learned_kept := Dict[String, (Result[List[String], String], Bool)] {}\n  for (n, x) in items(learned) {\n    match get(encoded, n) {\n      Some(vc) => if !vc.search_cut {\n        mut learned_kept.insert(n, x)\n      },\n      None => mut learned_kept.insert(n, x),\n    }\n  }\n  mut status := Dict[String, termination.Termination] {}\n  for (k, t) in items(memo) {\n    if !starts_with(k, \"trait method \") {\n      mut status.insert(k, t)\n    }\n  }\n  (termination.Analysis { status, recursive: set(\n    to_list(recursive).filter(k -> !starts_with(k, \"trait method \")),\n  ), transparent, unfold, found_loops }, learned_kept, measured)\n}","old_text":"/// A call graph node: a function, an implementation's method, or a trait\n/// `analyze`, reusing what earlier runs found: `known` gives a function's\n/// loops (how each ends or why one may not, and whether one is a `for` over\n/// an iterator), `known_measure` a recursive function's measure (`None`\n/// when none was found). Returns the analysis and the new loop and measure\n/// results. The graph work is linear: strongly connected components are found\n/// once.\n/// All solver questions (`while` bounds, measures) are asked together, each\n/// function's in its own order.\npub fn analyze_with(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  ctx: termination.Ctx,\n  roots: Option[Set[String]],\n  known: (String) -> Option[(Result[List[String], String], Bool)],\n  known_measure: (String) -> Option[Option[String]],\n) -> (termination.Analysis, Dict[String, (Result[List[String], String], Bool)], Dict[String, Option[String]]) {\n  mut nodes := Dict[String, termination.Node] {}\n  for (name, f) in items(ctx.fns) {\n    m := termination.short(name)\n    self_head := if (get(ctx.own_fns, m) ?? []).contains(name) {\n      termination.own_type_of(name, m)\n    } else {\n      \"\"\n    }\n    mut calls := termination.calls_within(\n      ctx,\n      f.body,\n      f.params,\n      f.type_params,\n      self_head,\n      \"\",\n    )\n    for c in f.pre + f.post {\n      calls = union(calls, termination.calls_within(\n        ctx,\n        c,\n        f.params,\n        f.type_params,\n        self_head,\n        \"\",\n      ))\n    }\n    mut nodes.insert(\n      name,\n      termination.Node { decl: Some(f), calls, body: Some(f) },\n    )\n  }\n  // implementation methods by label; each trait method's node reaches\n  // every implementation of it\n  mut impl_decls := []\n  for imp in ctx.methods.impls {\n    match termination.trait_of(ctx, imp) {\n      Some(tr) => {\n        for tm in tr.methods {\n          own := get(imp.methods.filter(m -> m.name == tm.decl.name), 0)\n          decl := match own {\n            Some(d) => Some(d),\n            None => if tm.default {\n              Some(tm.decl)\n            } else {\n              None\n            },\n          }\n          match decl {\n            Some(d) => {\n              label := termination.impl_label(ctx, imp, tm.decl.name)\n              tn := termination.trait_node(tm.decl.name)\n              calls := termination.calls_within(\n                ctx,\n                d.body,\n                termination.for_impl(imp, d).params,\n                imp.type_params + d.type_params,\n                \"\",\n                tn,\n              )\n              mut nodes.insert(\n                label,\n                termination.Node {\n                  decl: None,\n                  calls,\n                  body: Some(termination.for_impl(imp, d)),\n                },\n              )\n              t := get(nodes, tn) ?? termination.no_node()\n              mut nodes.insert(\n                tn,\n                termination.Node { ..t, calls: {\n                  mut copy := t.calls\n                  mut copy.insert(label)\n                  copy\n                } },\n              )\n              mut impl_decls.push((label, d))\n            },\n            None => (),\n          }\n        }\n      },\n      None => (),\n    }\n  }\n  // trait methods no implementation defines\n  for n in values(nodes) {\n    for c in to_list(n.calls) {\n      if !contains(nodes, c) {\n        mut nodes.insert(c, termination.no_node())\n      }\n    }\n  }\n  names := keys(nodes)\n  // a node reaches itself when it calls itself or shares its component\n  comp := termination.components(names, nodes)\n  mut sizes := Dict[Int, Int] {}\n  for n in names {\n    c := get(comp, n) ?? -1\n    mut sizes.insert(c, (get(sizes, c) ?? 0) + 1)\n  }\n  same := (a: String, b: String) -> get(comp, a) ?? -1 == get(comp, b) ?? -2\n  recursive := set(names.filter(\n    n -> contains((get(nodes, n) ?? termination.no_node()).calls, n)\n      || get(sizes, get(comp, n) ?? -1) ?? 0 > 1,\n  ))\n  // the nodes whose verdict is wanted: the roots, the helpers refinements\n  // call (seen through wherever a type is checked), and what they reach\n  needed := match roots {\n    None => None,\n    Some(rs) => {\n      mut preds := []\n      for td in values(ctx.types) {\n        match td.refinement {\n          Some(r) => mut preds.push(r),\n          None => (),\n        }\n        match td.body {\n          ast.Alias(a) => {\n            preds += termination.refinements_in(a)\n          },\n          ast.RecordBody(fs) => {\n            for f in fs {\n              preds += termination.refinements_in(f.ty)\n            }\n          },\n          ast.SumBody(vs) => {\n            for v in vs {\n              match v.payload {\n                ast.Positional(ts) => {\n                  for t in ts {\n                    preds += termination.refinements_in(t)\n                  }\n                },\n                ast.RecordPayload(fs) => {\n                  for f in fs {\n                    preds += termination.refinements_in(f.ty)\n                  }\n                },\n                ast.MemberType(t) => {\n                  preds += termination.refinements_in(t)\n                },\n                ast.NoPayload => (),\n              }\n            }\n          },\n        }\n      }\n      for f in values(ctx.fns) {\n        for p in f.params {\n          preds += termination.refinements_in(p.ty)\n        }\n        preds += termination.refinements_in(f.ret)\n      }\n      mut all := rs\n      for e in preds {\n        all = union(all, termination.calls_within(ctx, e, [ast.Param {\n          name: \"it\",\n          ty: ast.UnitType,\n          mutable: false,\n          compile_time: false,\n        }], [], \"\", \"\"))\n      }\n      starts := to_list(all).filter(r -> contains(nodes, r))\n      Some(\n        union(set(starts), termination.reached_from(starts, nodes)),\n      )\n    },\n  }\n  wanted := (n: String) -> match needed {\n    None => true,\n    Some(s) => contains(s, n),\n  }\n  skipped := \"not analysed (nothing being verified reaches it)\"\n  // the `while` loops' bounds of what is wanted and not known, encoded\n  // together so their solver questions are asked at once\n  mut whiles := []\n  mut had := Dict[String, (Result[List[String], String], Bool)] {}\n  for n in names {\n    match (get(nodes, n) ?? termination.no_node()).body {\n      Some(b) => if wanted(n) {\n        match known(n) {\n          Some(x) => mut had.insert(n, x),\n          None => if termination.has_while(b) {\n            mut whiles.push((b, n))\n          },\n        }\n      },\n      None => (),\n    }\n  }\n  mut learned := Dict[String, (Result[List[String], String], Bool)] {}\n  mut encoded := Dict[String, smt.Vc] {}\n  timings.begin(\"verify: termination: encode\")\n  // (with the loop invariants derived from the code: a loop whose bound\n  // isn't shown to go down with them alone is searched below)\n  quick := smt.Methods { ..ctx.methods, search: 0 }\n  encoded_all := smt.encode_all(\n    mut commands,\n    mut files,\n    ctx.scratch,\n    ctx.solver,\n    ctx.fns,\n    ctx.types,\n    ctx.sigs,\n    quick,\n    whiles,\n  )\n  timings.end(\"verify: termination: encode\")\n  for (i, vc) in enumerate(encoded_all) {\n    match get(whiles, i) {\n      Some((_, n)) => mut encoded.insert(n, vc),\n      None => (),\n    }\n  }\n  // the loops of what is wanted and not known: those that need no solver\n  // first, then all `while` bounds asked together, each function's in order\n  mut searched := []\n  mut searches := []\n  timings.begin(\"verify: termination: loops\")\n  // functions with a `for` loop and no `while`, run on the workers to find\n  // what their loops run over\n  mut fors := []\n  for n in names {\n    match (get(nodes, n) ?? termination.no_node()).body {\n      Some(b) => if wanted(n)\n        && !contains(had, n)\n        && !termination.has_while(b)\n        && termination.has_for(b) {\n        mut fors.push((b, n))\n      },\n      None => (),\n    }\n  }\n  for ((_, n), vc) in zip(fors, parallel.map_parallel(fors, x -> {\n    mut v := smt.new_vc(ctx.fns, ctx.types, ctx.sigs, quick)\n    smt.function(mut v, x.0, x.1)\n    v\n  })) {\n    mut encoded.insert(n, vc)\n  }\n  for n in names {\n    match (get(nodes, n) ?? termination.no_node()).body {\n      Some(b) => if wanted(n) && !contains(had, n) {\n        mut iterates := false\n        s := termination.loop_start(\n          mut commands,\n          mut files,\n          ctx,\n          b,\n          n,\n          encoded,\n          mut iterates,\n        )\n        mut searched.push((n, iterates))\n        mut searches.push(s)\n      },\n      None => (),\n    }\n  }\n  timings.end(\"verify: termination: loops\")\n  for ((n, iterates), r) in zip(\n    searched,\n    termination.loops_all(mut commands, mut files, ctx, searches),\n  ) {\n    mut learned.insert(n, (r, iterates))\n  }\n  // the functions with a loop whose bound isn't shown to go down, where\n  // a loop's invariant search was left out: encoded again with it\n  mut again := []\n  for (b, n) in whiles {\n    match (get(learned, n), get(encoded, n)) {\n      (Some((Err(m), _)), Some(vc)) => if vc.skipped != []\n        && contains(m, \"no bound was shown to go down\") {\n        mut again.push((b, n))\n      },\n      _ => (),\n    }\n  }\n  // (no search, `Methods.search` 0, as `verify` and `build` run: a loop\n  // whose bound isn't shown to go down says how to go on)\n  mut found_loops := Dict[String, List[smt.LoopFound]] {}\n  if ctx.methods.search == 0 {\n    for (_, n) in again {\n      match get(learned, n) {\n        Some((Err(m), it)) => mut learned.insert(\n          n,\n          (\n            Err(\n              m\n                + \"; write an `invariant` or a `decreases` for it, or run `strata fix \"\n                + n\n                + \"` to search for an invariant\",\n            ),\n            it,\n          ),\n        ),\n        _ => (),\n      }\n    }\n  }\n  if again != [] && ctx.methods.search > 0 {\n    timings.begin(\"verify: termination: searched\")\n    for (i, vc) in enumerate(smt.encode_all(\n      mut commands,\n      mut files,\n      ctx.scratch,\n      ctx.solver,\n      ctx.fns,\n      ctx.types,\n      ctx.sigs,\n      ctx.methods,\n      again,\n    )) {\n      match get(again, i) {\n        Some((_, n)) => {\n          mut encoded.insert(n, vc)\n          if vc.found_loops != [] {\n            mut found_loops.insert(n, vc.found_loops)\n          }\n        },\n        None => (),\n      }\n    }\n    mut searched_again := []\n    mut searches_again := []\n    for (b, n) in again {\n      mut iterates := false\n      s := termination.loop_start(\n        mut commands,\n        mut files,\n        ctx,\n        b,\n        n,\n        encoded,\n        mut iterates,\n      )\n      mut searched_again.push((n, iterates))\n      mut searches_again.push(s)\n    }\n    for ((n, iterates), r) in zip(searched_again, termination.loops_all(\n      mut commands,\n      mut files,\n      ctx,\n      searches_again,\n    )) {\n      mut learned.insert(n, (r, iterates))\n    }\n    timings.end(\"verify: termination: searched\")\n  }\n  mut loops_of := Dict[String, Result[List[String], String]] {}\n  mut iterating := Set[String] {}\n  for n in names {\n    node := get(nodes, n) ?? termination.no_node()\n    match node.body {\n      Some(_) => {\n        r := if wanted(n) {\n          (found, iterates) := get(had, n) ?? get(learned, n) ?? (Ok([]), false)\n          if iterates {\n            mut iterating.insert(n)\n          }\n          found\n        } else {\n          Err(skipped)\n        }\n        mut loops_of.insert(n, r)\n      },\n      None => (),\n    }\n  }\n  // a callee in its component reaches it\n  mutual := (n: String) -> get(\n    to_list((get(nodes, n) ?? termination.no_node()).calls).filter(\n      c -> c != n && same(c, n),\n    ),\n    0,\n  )\n  // the measures of functions that call only themselves without passing a\n  // smaller piece of a parameter, searched together, each in its order\n  mut measured_names := []\n  mut measure_searches := []\n  mut measures := Dict[String, Option[String]] {}\n  for n in names {\n    node := get(nodes, n) ?? termination.no_node()\n    if wanted(n) && contains(node.calls, n) && mutual(n) is None {\n      match (get(loops_of, n) ?? Ok([]), node.decl) {\n        (Ok(_), Some(f)) => if termination.structural(ctx, f, n) is None {\n          match known_measure(n) {\n            Some(m) => mut measures.insert(n, m),\n            None => {\n              mut measured_names.push(n)\n              mut measure_searches.push(\n                termination.measure_start(ctx, f, n),\n              )\n            },\n          }\n        },\n        _ => (),\n      }\n    }\n  }\n  mut measured := Dict[String, Option[String]] {}\n  for (n, s) in zip(measured_names, termination.measures_all(\n    mut commands,\n    mut files,\n    ctx,\n    measure_searches,\n  )) {\n    // a `decreases` clause's measure is the one tried\n    written := match (get(nodes, n) ?? termination.no_node()).decl {\n      Some(f) => text.decreases_text(f.body),\n      None => \"\",\n    }\n    m := match s.found {\n      Some(ms) => Some(if written != \"\" {\n        \"its `\" + written + \"` measure\"\n      } else {\n        termination.measure_shown(ms)\n      }),\n      None => None,\n    }\n    mut measures.insert(n, m)\n    mut measured.insert(n, m)\n  }\n  // each node's own verdict, ignoring its callees\n  mut own := Dict[String, Result[String, String]] {}\n  for n in names {\n    node := get(nodes, n) ?? termination.no_node()\n    if !wanted(n) {\n      mut own.insert(n, Err(skipped))\n      continue\n    }\n    r := match get(loops_of, n) ?? Ok([]) {\n      Err(e) => Err(e),\n      Ok(hows) => match mutual(n) {\n        Some(other) => Err(\"it is recursive through `\"\n          + termination.shown_node(other)\n          + \"`\"),\n        None => if contains(node.calls, n) {\n          match node.decl {\n            Some(f) => if termination.passes_itself(f, Set { n, f.name }) {\n              Err(\n                \"it passes itself as a function value, and calls through a function value aren't followed\",\n              )\n            } else {\n              match termination.structural(ctx, f, n) {\n                Some(p) => Ok(\"each recursive call gets a smaller piece of `\"\n                  + p\n                  + \"`\"),\n                None => match get(measures, n) ?? None {\n                  Some(m) => Ok(\n                    m\n                      + \" goes down on every recursive call and is never negative there\",\n                  ),\n                  None => Err(\n                    if text.decreases_text(f.body) != \"\" {\n                      \"its `\"\n                        + text.decreases_text(f.body)\n                        + \"` was not shown to go down on every recursive call (it is checked when the program runs)\"\n                    } else {\n                      \"it calls itself, and nothing was found that gets smaller on every call (a piece of a parameter, or a non-negative measure of the parameters)\"\n                    },\n                  ),\n                },\n              }\n            },\n            None => Err(\n              \"it calls itself, and nothing was found that gets smaller on every call (a piece of a parameter, or a non-negative measure of the parameters)\",\n            ),\n          }\n        } else if len(hows) == 0 {\n          Ok(\"no recursion, and only `for` loops\")\n        } else {\n          Ok(join(hows, \"; \"))\n        },\n      },\n    }\n    mut own.insert(n, r)\n  }\n  mut marked := Set[String] {}\n  for (n, f) in items(ctx.fns) {\n    if f.terminating {\n      mut marked.insert(n)\n    }\n  }\n  for (label, d) in impl_decls {\n    if d.terminating {\n      mut marked.insert(label)\n    }\n  }\n  // combined with the callees, deepest first; cycles are already unknown\n  mut memo := Dict[String, termination.Termination] {}\n  for n in names {\n    termination.resolve(\n      nodes,\n      own,\n      marked,\n      mut memo,\n      n,\n      Set[String] {},\n    )\n  }\n  // transparent: finishes, and cannot fail (its callees transparent, or\n  // recursive functions a contract may unfold); recursive functions a\n  // contract may unfold (`compiler/smt`'s `def_call`): they call only\n  // themselves, finish, and fail nowhere else\n  mut transparent := Dict[String, Bool] {}\n  mut unfold := Set[String] {}\n  // (both: what a body seen through may call)\n  mut callable := Dict[String, Bool] {}\n  mut changed := true\n  while changed {\n    changed = false\n    for (name, f) in items(ctx.fns) {\n      if contains(unfold, name)\n        || !contains(recursive, name)\n        || get(sizes, get(comp, name) ?? -1) ?? 0 != 1 {\n        continue\n      }\n      ends := match get(memo, name) {\n        Some(termination.Proven(_)) | Some(termination.Assumed(_)) => true,\n        _ => false,\n      }\n      mut with_self := callable\n      mut with_self.insert(name, false)\n      if ends && termination.cannot_fail(ctx, f, with_self) {\n        mut unfold.insert(name)\n        mut callable.insert(name, false)\n        changed = true\n      }\n    }\n    for (name, f) in items(ctx.fns) {\n      if contains(transparent, name)\n        || contains(recursive, name)\n        || contains(iterating, name) {\n        continue\n      }\n      (ends, assumed) := match get(memo, name) {\n        Some(termination.Proven(_)) => (true, false),\n        Some(termination.Assumed(_)) => (true, true),\n        _ => (false, false),\n      }\n      if !ends {\n        continue\n      }\n      if termination.cannot_fail(ctx, f, callable) {\n        mut transparent.insert(name, assumed)\n        mut callable.insert(name, assumed)\n        changed = true\n      }\n    }\n    // implementation methods, by label\n    for imp in ctx.methods.impls {\n      for m in imp.methods {\n        label := termination.impl_label(ctx, imp, m.name)\n        if contains(transparent, label)\n          || contains(recursive, label)\n          || contains(iterating, label) {\n          continue\n        }\n        (ends, assumed) := match get(memo, label) {\n          Some(termination.Proven(_)) => (true, false),\n          Some(termination.Assumed(_)) => (true, true),\n          _ => (false, false),\n        }\n        if !ends {\n          continue\n        }\n        if termination.cannot_fail(\n          ctx,\n          termination.with_trait_contract(ctx, imp, m),\n          callable,\n        ) {\n          mut transparent.insert(label, assumed)\n          mut callable.insert(label, assumed)\n          changed = true\n        }\n      }\n    }\n  }\n  // (what a search cut short, the search budget used up, found is not kept)\n  mut learned_kept := Dict[String, (Result[List[String], String], Bool)] {}\n  for (n, x) in items(learned) {\n    match get(encoded, n) {\n      Some(vc) => if !vc.search_cut {\n        mut learned_kept.insert(n, x)\n      },\n      None => mut learned_kept.insert(n, x),\n    }\n  }\n  mut status := Dict[String, termination.Termination] {}\n  for (k, t) in items(memo) {\n    if !starts_with(k, \"trait method \") {\n      mut status.insert(k, t)\n    }\n  }\n  (termination.Analysis { status, recursive: set(\n    to_list(recursive).filter(k -> !starts_with(k, \"trait method \")),\n  ), transparent, unfold, found_loops }, learned_kept, measured)\n}"},{"name":"termination.structural","kind":"fn","old":"2c3afc5b5cb14973","new":"babc27786ac36e14","interface_changed":false,"affected":[],"module":"termination","text":"/// The parameter every recursive call passes a smaller piece of, if there\n/// is one.\nfn structural(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  label: String,\n) -> Option[String] {\n  asg := termination.assigned(ctx, f.body)\n  mut vars := Dict[String, termination.Piece] {}\n  for (i, p) in enumerate(f.params) {\n    if !contains(asg, p.name) && !p.mutable {\n      mut vars.insert(\n        p.name,\n        termination.Piece {\n          within: Set { i },\n          smaller: Set[Int] {},\n        },\n      )\n    }\n  }\n  names := Set { label, f.name }\n  mut st := termination.Structural {\n    names,\n    assigned: asg,\n    calls: [],\n    elem_calls: termination.element_calls(ctx, f, names),\n  }\n  termination.struct_expr(mut st, f.body, vars)\n  mut common := None\n  for c in st.calls {\n    common = Some(match common {\n      None => c,\n      Some(prev) => intersection(prev, c),\n    })\n  }\n  match common {\n    Some(c) => match get(to_list(c), 0) {\n      Some(i) => Some(get(f.params, i)?.name),\n      None => None,\n    },\n    None => None,\n  }\n}","old_text":"/// The parameter every recursive call passes a smaller piece of, if there\n/// is one.\nfn structural(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  label: String,\n) -> Option[String] {\n  asg := termination.assigned(ctx, f.body)\n  mut vars := Dict[String, termination.Piece] {}\n  for (i, p) in enumerate(f.params) {\n    if !contains(asg, p.name) && !p.mutable {\n      mut vars.insert(\n        p.name,\n        termination.Piece {\n          within: Set { i },\n          smaller: Set[Int] {},\n        },\n      )\n    }\n  }\n  mut st := termination.Structural {\n    names: Set { label, f.name },\n    assigned: asg,\n    calls: [],\n  }\n  termination.struct_expr(mut st, f.body, vars)\n  mut common := None\n  for c in st.calls {\n    common = Some(match common {\n      None => c,\n      Some(prev) => intersection(prev, c),\n    })\n  }\n  match common {\n    Some(c) => match get(to_list(c), 0) {\n      Some(i) => Some(get(f.params, i)?.name),\n      None => None,\n    },\n    None => None,\n  }\n}"},{"name":"termination.struct_expr","kind":"fn","old":"cf9cf30f628d98a4","new":"e8780324527984ae","interface_changed":false,"affected":[],"module":"termination","text":"fn struct_expr(\n  mut st: termination.Structural,\n  e: ast.Expr,\n  vars: Dict[String, termination.Piece],\n) {\n  match e {\n    ast.Call { callee, args } => {\n      match callee {\n        ast.Var(n) => if contains(st.names, n) {\n          termination.struct_call(mut st, args, vars)\n        } else if st.elem_calls.contains(e) {\n          termination.struct_element(\n            mut st,\n            get(args, 0) ?? ast.UnitExpr,\n            vars,\n          )\n        },\n        _ => (),\n      }\n      termination.struct_expr(mut st, callee, vars)\n      for a in args {\n        termination.struct_expr(mut st, a, vars)\n      }\n    },\n    ast.MethodCall { recv, name, args } => {\n      if contains(st.names, name) {\n        termination.struct_call(mut st, [recv] + args, vars)\n      } else if st.elem_calls.contains(e) {\n        termination.struct_element(mut st, recv, vars)\n      }\n      termination.struct_expr(mut st, recv, vars)\n      for a in args {\n        termination.struct_expr(mut st, a, vars)\n      }\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      termination.struct_expr(mut st, scrutinee, vars)\n      whole := termination.piece(scrutinee, vars)\n      for a in arms {\n        mut v := vars\n        // a recursive call in a `where` pattern counts too\n        termination.pattern_conds(mut st, a.pat, vars)\n        match binding {\n          Some(n) => mut v.insert(n, whole),\n          None => (),\n        }\n        termination.bind_piece(\n          st,\n          a.pat,\n          Some(scrutinee),\n          whole,\n          0,\n          mut v,\n        )\n        termination.struct_expr(mut st, a.body, v)\n      }\n    },\n    ast.Lambda { params, body } => {\n      mut v := vars\n      for p in params {\n        mut v.remove(p.name)\n      }\n      termination.struct_expr(mut st, body, v)\n    },\n    ast.Block { stmts, last } => {\n      mut v := vars\n      for s in stmts {\n        match s {\n          ast.ComptimeFor { .. } => (),\n          ast.Let { pat, value, .. } => {\n            termination.struct_expr(mut st, value, v)\n            w := termination.piece(value, v)\n            termination.bind_piece(\n              st,\n              pat,\n              Some(value),\n              w,\n              0,\n              mut v,\n            )\n          },\n          ast.VarDecl { name, value, .. } => {\n            termination.struct_expr(mut st, value, v)\n            mut v.remove(name)\n          },\n          ast.For { pat, iter, body } => {\n            termination.struct_expr(mut st, iter, v)\n            w := termination.piece(iter, v)\n            mut v2 := v\n            // an element is a smaller piece of the list\n            termination.bind_piece(st, pat, None, w, 1, mut v2)\n            termination.struct_expr(mut st, body, v2)\n          },\n          ast.Assign { place, value } => {\n            termination.struct_expr(mut st, place, v)\n            termination.struct_expr(mut st, value, v)\n          },\n          ast.While { cond, body } => {\n            termination.struct_expr(mut st, cond, v)\n            termination.struct_expr(mut st, body, v)\n          },\n          ast.ExprStmt(x) | ast.Assert(x) | ast.Invariant(x) | ast.Decreases(x) => termination.struct_expr(mut st, x, v),\n          ast.AssertBy { cond, proof } => {\n            termination.struct_expr(mut st, cond, v)\n            termination.struct_expr(mut st, proof, v)\n          },\n          _ => (),\n        }\n      }\n      termination.struct_expr(mut st, last, v)\n    },\n    // expressions with patterns or bodies of their own are not looked into\n    ast.Interp(_) | ast.IfExpr { .. } | ast.Binary { .. } | ast.Unary { .. } | ast.ListExpr(_) | ast.TupleExpr(_) | ast.CtorExpr { .. } | ast.FieldOf { .. } | ast.IsExpr { .. } | ast.Return(_) | ast.MutExpr(_) => {\n      for k in walk.kids(e) {\n        termination.struct_expr(mut st, k, vars)\n      }\n    },\n    _ => (),\n  }\n}","old_text":"fn struct_expr(\n  mut st: termination.Structural,\n  e: ast.Expr,\n  vars: Dict[String, termination.Piece],\n) {\n  match e {\n    ast.Call { callee, args } => {\n      match callee {\n        ast.Var(n) => if contains(st.names, n) {\n          termination.struct_call(mut st, args, vars)\n        },\n        _ => (),\n      }\n      termination.struct_expr(mut st, callee, vars)\n      for a in args {\n        termination.struct_expr(mut st, a, vars)\n      }\n    },\n    ast.MethodCall { recv, name, args } => {\n      if contains(st.names, name) {\n        termination.struct_call(mut st, [recv] + args, vars)\n      }\n      termination.struct_expr(mut st, recv, vars)\n      for a in args {\n        termination.struct_expr(mut st, a, vars)\n      }\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      termination.struct_expr(mut st, scrutinee, vars)\n      whole := termination.piece(scrutinee, vars)\n      for a in arms {\n        mut v := vars\n        // a recursive call in a `where` pattern counts too\n        termination.pattern_conds(mut st, a.pat, vars)\n        match binding {\n          Some(n) => mut v.insert(n, whole),\n          None => (),\n        }\n        termination.bind_piece(\n          st,\n          a.pat,\n          Some(scrutinee),\n          whole,\n          0,\n          mut v,\n        )\n        termination.struct_expr(mut st, a.body, v)\n      }\n    },\n    ast.Lambda { params, body } => {\n      mut v := vars\n      for p in params {\n        mut v.remove(p.name)\n      }\n      termination.struct_expr(mut st, body, v)\n    },\n    ast.Block { stmts, last } => {\n      mut v := vars\n      for s in stmts {\n        match s {\n          ast.ComptimeFor { .. } => (),\n          ast.Let { pat, value, .. } => {\n            termination.struct_expr(mut st, value, v)\n            w := termination.piece(value, v)\n            termination.bind_piece(\n              st,\n              pat,\n              Some(value),\n              w,\n              0,\n              mut v,\n            )\n          },\n          ast.VarDecl { name, value, .. } => {\n            termination.struct_expr(mut st, value, v)\n            mut v.remove(name)\n          },\n          ast.For { pat, iter, body } => {\n            termination.struct_expr(mut st, iter, v)\n            w := termination.piece(iter, v)\n            mut v2 := v\n            // an element is a smaller piece of the list\n            termination.bind_piece(st, pat, None, w, 1, mut v2)\n            termination.struct_expr(mut st, body, v2)\n          },\n          ast.Assign { place, value } => {\n            termination.struct_expr(mut st, place, v)\n            termination.struct_expr(mut st, value, v)\n          },\n          ast.While { cond, body } => {\n            termination.struct_expr(mut st, cond, v)\n            termination.struct_expr(mut st, body, v)\n          },\n          ast.ExprStmt(x) | ast.Assert(x) | ast.Invariant(x) | ast.Decreases(x) => termination.struct_expr(mut st, x, v),\n          ast.AssertBy { cond, proof } => {\n            termination.struct_expr(mut st, cond, v)\n            termination.struct_expr(mut st, proof, v)\n          },\n          _ => (),\n        }\n      }\n      termination.struct_expr(mut st, last, v)\n    },\n    // expressions with patterns or bodies of their own are not looked into\n    ast.Interp(_) | ast.IfExpr { .. } | ast.Binary { .. } | ast.Unary { .. } | ast.ListExpr(_) | ast.TupleExpr(_) | ast.CtorExpr { .. } | ast.FieldOf { .. } | ast.IsExpr { .. } | ast.Return(_) | ast.MutExpr(_) => {\n      for k in walk.kids(e) {\n        termination.struct_expr(mut st, k, vars)\n      }\n    },\n    _ => (),\n  }\n}"},{"name":"termination.passes_itself","kind":"fn","old":"cc0f9dbe1d26ef94","new":"51e890afee2719b3","interface_changed":true,"affected":["termination.analyze_with","verify_program","termination.analyze","search_invariants","build_proofs","verify_file","live_edit_command","alongside_command","smt_file","termination_file","static_graph","edit_file","apply_edit","fix_loops","run_command","build_command","command_line","std_proofs","verify_command","strata_command","graph_command","graph_diff","repl_command","edit_command","edit_in_editor","new_command","fix_command","main","std_library","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","check_command","test_command","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","build_core_command","comptime_value","literal_errors_of","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","comptime_values","loaded_check","file_errors","edit_errors","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","apply_change","with_base","package_errors","rename_command","move_command"],"module":"termination","text":"/// Whether `f`'s body names one of `names` other than as the function\n/// called (`apply(f, t)`, `xs.map(f)`), leaving out the calls of\n/// `element_calls`.\nfn passes_itself(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  names: Set[String],\n) -> Bool {\n  xs := termination.preorder(f.body)\n  named := xs.count(\n    x -> match x {\n      ast.Var(v) => contains(names, v),\n      _ => false,\n    },\n  )\n  called := xs.count(\n    x -> match x {\n      ast.Call { callee: ast.Var(v), .. } => contains(names, v),\n      _ => false,\n    },\n  )\n  named > called + len(termination.element_calls(ctx, f, names))\n}","old_text":"/// Whether `f`'s body names one of `names` other than as the function\n/// called (`apply(f, t)`, `xs.map(f)`).\nfn passes_itself(f: ast.FnDecl, names: Set[String]) -> Bool {\n  xs := termination.preorder(f.body)\n  named := xs.count(\n    x -> match x {\n      ast.Var(v) => contains(names, v),\n      _ => false,\n    },\n  )\n  called := xs.count(\n    x -> match x {\n      ast.Call { callee: ast.Var(v), .. } => contains(names, v),\n      _ => false,\n    },\n  )\n  named > called\n}"},{"name":"termination.bound_once","kind":"fn","old":"4617d359a865a215","new":"548273541ac138f3","interface_changed":false,"affected":[],"module":"termination","text":"/// The names bound exactly once in `f`: as a parameter, by a `let`, a\n/// `for`, a `match` arm, a lambda or a `select` arm.\nfn bound_once(f: ast.FnDecl) -> Set[String] {\n  mut names := f.params.map(p -> p.name)\n  for x in termination.preorder(f.body) {\n    match x {\n      ast.Block { stmts, .. } => {\n        for s in stmts {\n          match s {\n            ast.Let { pat, .. } => {\n              names += termination.pattern_binds(pat)\n            },\n            ast.VarDecl { name, .. } => mut names.push(name),\n            ast.For { pat, .. } | ast.ComptimeFor { pat, .. } => {\n              names += termination.pattern_binds(pat)\n            },\n            _ => (),\n          }\n        }\n      },\n      ast.MatchExpr { binding, arms, .. } => {\n        match binding {\n          Some(b) => mut names.push(b),\n          None => (),\n        }\n        for a in arms {\n          names += termination.pattern_binds(a.pat)\n        }\n      },\n      ast.Lambda { params, .. } => {\n        names += params.map(p -> p.name)\n      },\n      ast.Select(arms) | ast.Race(arms) => {\n        for a in arms {\n          match a.name {\n            Some(b) => mut names.push(b),\n            None => (),\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  mut seen := Dict[String, Int] {}\n  for n in names {\n    mut seen.insert(n, (get(seen, n) ?? 0) + 1)\n  }\n  set(keys(seen).filter(n -> get(seen, n) ?? 0 == 1))\n}","old_text":"/// The names bound exactly once in `f`: as a parameter, by a `let`, a\n/// `for`, a `match` arm or a lambda.\nfn bound_once(f: ast.FnDecl) -> Set[String] {\n  mut names := f.params.map(p -> p.name)\n  for x in termination.preorder(f.body) {\n    match x {\n      ast.Block { stmts, .. } => {\n        for s in stmts {\n          match s {\n            ast.Let { pat, .. } => {\n              names += termination.pattern_binds(pat)\n            },\n            ast.VarDecl { name, .. } => mut names.push(name),\n            ast.For { pat, .. } => {\n              names += termination.pattern_binds(pat)\n            },\n            _ => (),\n          }\n        }\n      },\n      ast.MatchExpr { binding, arms, .. } => {\n        match binding {\n          Some(b) => mut names.push(b),\n          None => (),\n        }\n        for a in arms {\n          names += termination.pattern_binds(a.pat)\n        }\n      },\n      ast.Lambda { params, .. } => {\n        names += params.map(p -> p.name)\n      },\n      _ => (),\n    }\n  }\n  mut seen := Dict[String, Int] {}\n  for n in names {\n    mut seen.insert(n, (get(seen, n) ?? 0) + 1)\n  }\n  set(keys(seen).filter(n -> get(seen, n) ?? 0 == 1))\n}"},{"name":"termination.source_of","kind":"fn","old":"4449dcecf4bf046f","new":"b34032ac26161344","interface_changed":false,"affected":[],"module":"termination","text":"/// What a `for` over `e` in `f` runs over. A lazy `map`, `filter`, `drop`,\n/// `enumerate`, `reverse` or `sort` is as finite as what it is called on;\n/// `take`, `slice`, `to_list` and `iter` always are. A variable bound once\n/// is judged by its value or its type (`binding_type`), a call by its\n/// result type. `lets`: the body's `let`s and `mut` declarations.\nfn source_of(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  e: ast.Expr,\n  lets: List[(String, ast.Expr)],\n  once: Set[String],\n  fuel: Int,\n) -> termination.Source {\n  if fuel <= 0 {\n    return termination.SourceUnknown(\"`\"\n      + text.expr_text(e, 0)\n      + \"`, reached through more `let`s than are followed\")\n  }\n  match e {\n    ast.MethodCall { recv, name, args } => termination.source_call(\n      ctx,\n      f,\n      e,\n      name,\n      [recv] + args,\n      lets,\n      once,\n      fuel,\n    ),\n    ast.Call { callee: ast.Var(n), args } => match get(ctx.fns, n) {\n      Some(g) => termination.source_type(ctx, g.type_params, g.bounds, g.ret),\n      None => if contains(once, n) || f.params.any(p -> p.name == n) {\n        termination.SourceByValue\n      } else {\n        termination.source_call(\n          ctx,\n          f,\n          e,\n          n,\n          args,\n          lets,\n          once,\n          fuel,\n        )\n      },\n    },\n    ast.ListExpr(_) | ast.StrLit(_) | ast.Interp(_) => termination.SourceFinite,\n    ast.CtorExpr { name, .. } => termination.source_type(\n      ctx,\n      [],\n      [],\n      ast.Named { name, args: [] },\n    ),\n    // a record field (`h.it`): by the field's type\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, f, once, base, fuel) {\n      Some(t) => match termination.field_type(ctx, t, name) {\n        Some(ft) => termination.source_type(ctx, f.type_params, f.bounds, ft),\n        None => termination.SourceByValue,\n      },\n      None => termination.SourceByValue,\n    },\n    ast.Var(n) => if contains(once, n) {\n      match lets.find(x -> x.0 == n) {\n        Some((_, v)) => termination.source_of(ctx, f, v, lets, once, fuel - 1),\n        None => match termination.binding_type(ctx, f, once, n, fuel) {\n          Some(t) => termination.source_type(ctx, f.type_params, f.bounds, t),\n          None => termination.SourceByValue,\n        },\n      }\n    } else {\n      termination.SourceByValue\n    },\n    _ => termination.SourceByValue,\n  }\n}","old_text":"/// What a `for` over `e` in `f` runs over. A lazy `map`, `filter`, `drop`,\n/// `enumerate`, `reverse` or `sort` is as finite as what it is called on;\n/// `take`, `slice`, `to_list` and `iter` always are. A variable bound once\n/// is judged by its value or its parameter's type, a call by its result\n/// type. `lets`: the body's `let`s and `mut` declarations.\nfn source_of(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  e: ast.Expr,\n  lets: List[(String, ast.Expr)],\n  once: Set[String],\n  fuel: Int,\n) -> termination.Source {\n  if fuel <= 0 {\n    return termination.SourceUnknown(\"`\"\n      + text.expr_text(e, 0)\n      + \"`, reached through more `let`s than are followed\")\n  }\n  match e {\n    ast.MethodCall { recv, name, args } => termination.source_call(\n      ctx,\n      f,\n      e,\n      name,\n      [recv] + args,\n      lets,\n      once,\n      fuel,\n    ),\n    ast.Call { callee: ast.Var(n), args } => match get(ctx.fns, n) {\n      Some(g) => termination.source_type(ctx, g.type_params, g.bounds, g.ret),\n      None => if contains(once, n) || f.params.any(p -> p.name == n) {\n        termination.SourceByValue\n      } else {\n        termination.source_call(\n          ctx,\n          f,\n          e,\n          n,\n          args,\n          lets,\n          once,\n          fuel,\n        )\n      },\n    },\n    ast.ListExpr(_) | ast.StrLit(_) | ast.Interp(_) => termination.SourceFinite,\n    ast.CtorExpr { name, .. } => termination.source_type(\n      ctx,\n      [],\n      [],\n      ast.Named { name, args: [] },\n    ),\n    // a record field (`h.it`): by the field's type\n    ast.FieldOf { base, name } => {\n      record := match base {\n        ast.Var(n) => if contains(once, n) {\n          match lets.find(x -> x.0 == n) {\n            Some((_, ast.CtorExpr { name: t, .. })) => t,\n            Some(_) => \"\",\n            None => match f.params.find(x -> x.name == n) {\n              Some(x) => termination.head(termination.expand_alias(ctx, x.ty)),\n              None => \"\",\n            },\n          }\n        } else {\n          \"\"\n        },\n        _ => \"\",\n      }\n      match get(ctx.types, record) {\n        Some(t) => match t.body {\n          ast.RecordBody(fs) => match fs.find(x -> x.name == name) {\n            Some(x) => termination.source_type(ctx, [], [], x.ty),\n            None => termination.SourceByValue,\n          },\n          _ => termination.SourceByValue,\n        },\n        None => termination.SourceByValue,\n      }\n    },\n    ast.Var(n) => if contains(once, n) {\n      match lets.find(x -> x.0 == n) {\n        Some((_, v)) => termination.source_of(ctx, f, v, lets, once, fuel - 1),\n        None => match f.params.find(x -> x.name == n) {\n          Some(x) => termination.source_type(\n            ctx,\n            f.type_params,\n            f.bounds,\n            x.ty,\n          ),\n          None => termination.SourceByValue,\n        },\n      }\n    } else {\n      termination.SourceByValue\n    },\n    _ => termination.SourceByValue,\n  }\n}"},{"name":"termination.expr_type","kind":"fn","old":null,"new":"8d840137258a0dab","interface_changed":true,"affected":[],"module":"termination","text":"/// The type of `e` in `f`, as far as the code says it: a variable bound\n/// once (`binding_type`), a call of a function of the program whose result\n/// type names none of its type parameters, a record built by name, or a\n/// field of a record.\nfn expr_type(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  once: Set[String],\n  e: ast.Expr,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0 {\n    return None\n  }\n  match e {\n    ast.Var(n) => termination.binding_type(ctx, f, once, n, fuel - 1),\n    ast.Call { callee: ast.Var(g), .. } => match get(ctx.fns, g) {\n      Some(d) => if termination.names_any(d.ret, d.type_params + [\"Self\"]) {\n        None\n      } else {\n        Some(d.ret)\n      },\n      None => None,\n    },\n    ast.CtorExpr { name, .. } => match get(ctx.types, name) {\n      Some(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          Some(ast.Named { name, args: [] })\n        } else {\n          None\n        },\n        _ => None,\n      },\n      None => None,\n    },\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, f, once, base, fuel - 1) {\n      Some(t) => termination.field_type(ctx, t, name),\n      None => None,\n    },\n    _ => None,\n  }\n}"},{"name":"termination.binding_type","kind":"fn","old":null,"new":"d6e427b18facf7ea","interface_changed":true,"affected":[],"module":"termination","text":"/// The type of `n`, bound once in `f`: a parameter's type, a `let`'s or\n/// `mut` declaration's (written, or its value's), a lambda parameter's\n/// written type, the piece a `match` arm or a `let` pattern binds of the\n/// value matched, or an element of the list or set a `for` runs over.\nfn binding_type(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  once: Set[String],\n  n: String,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if !contains(once, n) {\n    return None\n  }\n  match f.params.find(p -> p.name == n) {\n    Some(p) => return Some(p.ty),\n    None => (),\n  }\n  of := (x: ast.Expr) -> termination.expr_type(ctx, f, once, x, fuel)\n  piece_of := (p: ast.Pattern, t: Option[ast.TypeExpr]) -> match t {\n    Some(u) => termination.pattern_type(ctx, p, u, n, 8),\n    None => None,\n  }\n  for x in termination.preorder(f.body) {\n    match x {\n      ast.Block { stmts, .. } => {\n        for s in stmts {\n          match s {\n            ast.Let { pat, ty, value } => if termination.pattern_binds(pat).contains(n) {\n              return piece_of(pat, match ty {\n                Some(t) => Some(t),\n                None => of(value),\n              })\n            },\n            ast.VarDecl { name, ty, value } => if name == n {\n              return match ty {\n                Some(t) => Some(t),\n                None => of(value),\n              }\n            },\n            ast.For { pat, iter, .. } => if termination.pattern_binds(pat).contains(n) {\n              return piece_of(pat, match of(iter) {\n                Some(t) => termination.element_type(ctx, t),\n                None => None,\n              })\n            },\n            _ => (),\n          }\n        }\n      },\n      ast.MatchExpr { scrutinee, binding, arms } => {\n        if binding == Some(n) {\n          return of(scrutinee)\n        }\n        for a in arms {\n          if termination.pattern_binds(a.pat).contains(n) {\n            return piece_of(a.pat, of(scrutinee))\n          }\n        }\n      },\n      ast.Lambda { params, .. } => match params.find(p -> p.name == n) {\n        Some(p) => return p.ty,\n        None => (),\n      },\n      _ => (),\n    }\n  }\n  None\n}"},{"name":"termination.pattern_type","kind":"fn","old":null,"new":"71bfce0b900b495b","interface_changed":true,"affected":[],"module":"termination","text":"/// The type of what `p`, matched against a value of type `t`, binds to\n/// `n`, when the code says it.\nfn pattern_type(\n  ctx: termination.Ctx,\n  p: ast.Pattern,\n  t: ast.TypeExpr,\n  n: String,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0 {\n    return None\n  }\n  u := termination.expand_alias(ctx, t)\n  first := (pts: List[(ast.Pattern, ast.TypeExpr)]) ->\n    termination.first_type(ctx, pts, n, fuel - 1)\n  match p {\n    ast.Bind(x) => if x == n {\n      Some(t)\n    } else {\n      None\n    },\n    ast.TuplePat(ps) => match u {\n      ast.Named { name: \"Tuple\", args } => if len(args) == len(ps) {\n        first(zip(ps, args))\n      } else {\n        None\n      },\n      _ => None,\n    },\n    ast.ListPat { items, rest } => if termination.short(termination.head(u)) != \"List\" {\n      None\n    } else if rest == Some(n) {\n      Some(u)\n    } else {\n      match termination.element_type(ctx, u) {\n        Some(e) => first(items.map(q -> (q, e))),\n        None => None,\n      }\n    },\n    ast.OrPat(alts) => first(alts.map(q -> (q, t))),\n    ast.CtorPattern { name, args } => match termination.ctor_parts(ctx, u, name, args) {\n      Some(pts) => first(pts),\n      None => match termination.ctor_member(ctx, u, name) {\n        Some(m) => termination.pattern_type(ctx, p, m, n, fuel - 1),\n        None => None,\n      },\n    },\n    _ => None,\n  }\n}"},{"name":"termination.first_type","kind":"fn","old":null,"new":"408a1167e7b33778","interface_changed":true,"affected":[],"module":"termination","text":"/// The type the first of `pts` that binds `n` binds it to.\nfn first_type(\n  ctx: termination.Ctx,\n  pts: List[(ast.Pattern, ast.TypeExpr)],\n  n: String,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  for (q, qt) in pts {\n    if termination.pattern_binds(q).contains(n) {\n      return termination.pattern_type(ctx, q, qt, n, fuel)\n    }\n  }\n  None\n}"},{"name":"termination.element_type","kind":"fn","old":null,"new":"a70631aad6650b6f","interface_changed":true,"affected":[],"module":"termination","text":"/// The element type of a list or set type.\nfn element_type(ctx: termination.Ctx, t: ast.TypeExpr) -> Option[ast.TypeExpr] {\n  match termination.expand_alias(ctx, t) {\n    ast.Named { name, args: [a] } => if termination.short(name) == \"List\"\n      || termination.short(name) == \"Set\" {\n      Some(a)\n    } else {\n      None\n    },\n    _ => None,\n  }\n}"},{"name":"termination.decl_of","kind":"fn","old":null,"new":"b4d9b2ad5ad0fade","interface_changed":true,"affected":[],"module":"termination","text":"/// The declaration of `t`'s head, and `t`'s type arguments.\nfn decl_of(\n  ctx: termination.Ctx,\n  t: ast.TypeExpr,\n) -> Option[(ast.TypeDecl, List[ast.TypeExpr])] {\n  match t {\n    ast.Named { name, args } => match get(ctx.types, name) {\n      Some(td) => if len(td.params) == len(args) {\n        Some((td, args))\n      } else {\n        None\n      },\n      None => None,\n    },\n    _ => None,\n  }\n}"},{"name":"termination.ctor_parts","kind":"fn","old":null,"new":"a1cce211f4511161","interface_changed":true,"affected":[],"module":"termination","text":"/// The subpatterns of the constructor pattern `name(args)` on a value of\n/// type `t` (a variant of the sum `t`, or the record `t`), each with its\n/// type.\nfn ctor_parts(\n  ctx: termination.Ctx,\n  t: ast.TypeExpr,\n  name: String,\n  args: CtorPat,\n) -> Option[List[(ast.Pattern, ast.TypeExpr)]] {\n  (td, targs) := termination.decl_of(ctx, t)?\n  sub := (x: ast.TypeExpr) -> termination.substitute(x, td.params, targs)\n  fields := (fs: List[ast.Field]) -> termination.field_parts(\n    fs.map(x -> ast.Field { ..x, ty: sub(x.ty) }),\n    args,\n  )\n  match td.body {\n    ast.SumBody(vs) => match vs.find(\n      v -> termination.short(v.name) == termination.short(name),\n    ) {\n      Some(v) => match v.payload {\n        ast.Positional(ts) => match args {\n          ast.PositionalPats(ps) => if len(ps) == len(ts) {\n            Some(zip(ps, ts.map(sub)))\n          } else {\n            None\n          },\n          ast.NoPats => Some([]),\n          _ => None,\n        },\n        ast.RecordPayload(fs) => fields(fs),\n        ast.NoPayload => Some([]),\n        ast.MemberType(_) => None,\n      },\n      None => None,\n    },\n    ast.RecordBody(fs) => if termination.short(name) == termination.short(td.name) {\n      fields(fs)\n    } else {\n      None\n    },\n    ast.Alias(_) => None,\n  }\n}"},{"name":"termination.field_parts","kind":"fn","old":null,"new":"f91f910e05074d02","interface_changed":true,"affected":[],"module":"termination","text":"/// The record pattern `args`'s subpatterns, each with its field's type\n/// among `fs`.\nfn field_parts(\n  fs: List[ast.Field],\n  args: CtorPat,\n) -> Option[List[(ast.Pattern, ast.TypeExpr)]] {\n  match args {\n    ast.RecordPats { fields: ps, .. } => {\n      mut out := []\n      for (fname, q) in ps {\n        match fs.find(x -> x.name == fname) {\n          Some(x) => mut out.push((q, x.ty)),\n          None => return None,\n        }\n      }\n      Some(out)\n    },\n    ast.NoPats => Some([]),\n    _ => None,\n  }\n}"},{"name":"termination.ctor_member","kind":"fn","old":null,"new":"4a18f18e23dd3f60","interface_changed":true,"affected":[],"module":"termination","text":"/// The type of the union member `name` of the sum `t`.\nfn ctor_member(\n  ctx: termination.Ctx,\n  t: ast.TypeExpr,\n  name: String,\n) -> Option[ast.TypeExpr] {\n  (td, targs) := termination.decl_of(ctx, t)?\n  match td.body {\n    ast.SumBody(vs) => match vs.find(\n      v -> termination.short(v.name) == termination.short(name),\n    ) {\n      Some(v) => match v.payload {\n        ast.MemberType(m) => Some(termination.substitute(m, td.params, targs)),\n        _ => None,\n      },\n      None => None,\n    },\n    _ => None,\n  }\n}"},{"name":"termination.field_type","kind":"fn","old":null,"new":"36fd2a0472c6c231","interface_changed":true,"affected":[],"module":"termination","text":"/// The type of the field `name` of a value of the record type `t`.\nfn field_type(\n  ctx: termination.Ctx,\n  t: ast.TypeExpr,\n  name: String,\n) -> Option[ast.TypeExpr] {\n  (td, targs) := termination.decl_of(ctx, termination.expand_alias(ctx, t))?\n  match td.body {\n    ast.RecordBody(fs) => match fs.find(x -> x.name == name) {\n      Some(x) => Some(termination.substitute(x.ty, td.params, targs)),\n      None => None,\n    },\n    _ => None,\n  }\n}"},{"name":"termination.substitute","kind":"fn","old":null,"new":"f14642b92eecae34","interface_changed":true,"affected":[],"module":"termination","text":"/// `t` with each type parameter of `params` replaced by the argument at\n/// its place in `args`.\nfn substitute(\n  t: ast.TypeExpr,\n  params: List[String],\n  args: List[ast.TypeExpr],\n) -> ast.TypeExpr {\n  go := (x: ast.TypeExpr) -> termination.substitute(x, params, args)\n  match t {\n    ast.Named { name, args: [] } => match zip(params, args).find(pa -> pa.0 == name) {\n      Some(pa) => pa.1,\n      None => t,\n    },\n    ast.Named { name, args: xs } => ast.Named { name, args: xs.map(go) },\n    ast.FnType { params: ps, ret } => ast.FnType { params: ps.map(go), ret: go(ret) },\n    ast.Refined { base, pred } => ast.Refined { base: go(base), pred },\n    ast.UnionType(ms) => ast.UnionType(ms.map(go)),\n    ast.RowType(fs) => ast.RowType(fs.map(x -> (x.0, go(x.1)))),\n    ast.UnitType => ast.UnitType,\n  }\n}"},{"name":"termination.names_any","kind":"fn","old":null,"new":"8234503244340c9a","interface_changed":true,"affected":[],"module":"termination","text":"/// Whether `t` names one of `names` as a type.\nfn names_any(t: ast.TypeExpr, names: List[String]) -> Bool {\n  match t {\n    ast.Named { name, args } => names.contains(name)\n      || args.any(a -> termination.names_any(a, names)),\n    ast.FnType { params, ret } => params.any(a -> termination.names_any(a, names))\n      || termination.names_any(ret, names),\n    ast.Refined { base, .. } => termination.names_any(base, names),\n    ast.UnionType(ms) => ms.any(a -> termination.names_any(a, names)),\n    ast.RowType(fs) => fs.any(x -> termination.names_any(x.1, names)),\n    ast.UnitType => false,\n  }\n}"},{"name":"termination.element_calls","kind":"fn","old":null,"new":"e3bb5bc1710287eb","interface_changed":true,"affected":[],"module":"termination","text":"/// The calls in `f` of a builtin that calls its function argument, one of\n/// `names`, on elements of its list argument only (`args.any(has_gen)`):\n/// `any`, `all`, `map`, `filter`, `find` and `count` of a value whose type\n/// the code says is a `List`, where no function, method or trait method of\n/// the program has the name.\nfn element_calls(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  names: Set[String],\n) -> List[ast.Expr] {\n  once := termination.bound_once(f)\n  termination.preorder(f.body).filter(\n    e ->\n      match e {\n        ast.MethodCall { recv, name, args: [ast.Var(v)] } => contains(names, v)\n          && termination.element_builtin(ctx, name)\n          && termination.is_list(ctx, f, once, recv),\n        ast.Call { callee: ast.Var(name), args: [xs, ast.Var(v)] } => contains(names, v)\n          && termination.element_builtin(ctx, name)\n          && termination.is_list(ctx, f, once, xs),\n        _ => false,\n      },\n  )\n}"},{"name":"termination.element_builtin","kind":"fn","old":null,"new":"475ce7d8770ffaf5","interface_changed":true,"affected":[],"module":"termination","text":"/// Whether `name` is only a builtin that calls its function argument on\n/// elements of its list.\nfn element_builtin(ctx: termination.Ctx, name: String) -> Bool {\n  [\"any\", \"all\", \"map\", \"filter\", \"find\", \"count\"].contains(name)\n    && termination.own_methods_named(ctx, name) == []\n    && !termination.is_method(ctx, name)\n    && !contains(ctx.fns, name)\n}"},{"name":"termination.is_list","kind":"fn","old":null,"new":"ed4aaafe7ffd0b05","interface_changed":true,"affected":[],"module":"termination","text":"/// Whether the code says `e`, in `f`, is a `List`.\nfn is_list(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  once: Set[String],\n  e: ast.Expr,\n) -> Bool {\n  match termination.expr_type(ctx, f, once, e, 8) {\n    Some(t) => termination.short(\n      termination.head(termination.expand_alias(ctx, t)),\n    ) == \"List\",\n    None => false,\n  }\n}"},{"name":"termination.struct_element","kind":"fn","old":null,"new":"5caca0a5837550f2","interface_changed":true,"affected":[],"module":"termination","text":"/// Records a recursive call on an element of `xs`: smaller than the first\n/// parameter when `xs` is a piece of it or equal to it.\nfn struct_element(\n  mut st: termination.Structural,\n  xs: ast.Expr,\n  vars: Dict[String, termination.Piece],\n) {\n  mut st.calls.push(\n    if contains(termination.piece(xs, vars).within, 0) {\n      Set { 0 }\n    } else {\n      Set[Int] {}\n    },\n  )\n}"}]}
{"id":"e9e7f401bebc8184","time":1795824944,"message":"termination: import CtorPat","changes":[{"name":"termination.use ast","kind":"use","old":"083968d5d94bbd8c","new":"b8fe98619b0a8b3b","interface_changed":true,"affected":[],"module":"termination","text":"from ast use FnDecl, TypeDecl, TypeExpr, Expr, Stmt, Pattern, Param, ImplDecl,\n  TraitDecl, Named, FnType, UnitType, Refined, UnionType, RowType, Alias,\n  RecordBody, SumBody, NoPayload, Positional, RecordPayload, MemberType, IntLit,\n  FloatLit, StrLit, Var, Hole, CtorExpr, Call, MethodCall, FieldOf, Lambda,\n  Binary, MatchExpr, MutExpr, Block, MockExpr, Return, TupleExpr, ListExpr, Div,\n  Mod, Sub, Less, LessEq, Greater, GreaterEq, NotEqual, Equal, Let, VarDecl,\n  Assign, While, For, ExprStmt, Assert, Invariant, Decreases, ComptimeFor, Wild,\n  Bind, CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat, NoPats,\n  PositionalPats, RecordPats, TypePats, AssertBy, Calc, BoolLit, Bound, Field,\n  Select, Race, UnitExpr, CtorPat","old_text":"from ast use FnDecl, TypeDecl, TypeExpr, Expr, Stmt, Pattern, Param, ImplDecl,\n  TraitDecl, Named, FnType, UnitType, Refined, UnionType, RowType, Alias,\n  RecordBody, SumBody, NoPayload, Positional, RecordPayload, MemberType, IntLit,\n  FloatLit, StrLit, Var, Hole, CtorExpr, Call, MethodCall, FieldOf, Lambda,\n  Binary, MatchExpr, MutExpr, Block, MockExpr, Return, TupleExpr, ListExpr, Div,\n  Mod, Sub, Less, LessEq, Greater, GreaterEq, NotEqual, Equal, Let, VarDecl,\n  Assign, While, For, ExprStmt, Assert, Invariant, Decreases, ComptimeFor, Wild,\n  Bind, CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat, NoPats,\n  PositionalPats, RecordPats, TypePats, AssertBy, Calc, BoolLit, Bound, Field,\n  Select, Race, UnitExpr"}]}
{"id":"2531111768df60a1","time":1795824988,"message":"termination: constructor parts from the pattern","changes":[{"name":"termination.use ast","kind":"use","old":"b8fe98619b0a8b3b","new":"083968d5d94bbd8c","interface_changed":true,"affected":[],"module":"termination","text":"from ast use FnDecl, TypeDecl, TypeExpr, Expr, Stmt, Pattern, Param, ImplDecl,\n  TraitDecl, Named, FnType, UnitType, Refined, UnionType, RowType, Alias,\n  RecordBody, SumBody, NoPayload, Positional, RecordPayload, MemberType, IntLit,\n  FloatLit, StrLit, Var, Hole, CtorExpr, Call, MethodCall, FieldOf, Lambda,\n  Binary, MatchExpr, MutExpr, Block, MockExpr, Return, TupleExpr, ListExpr, Div,\n  Mod, Sub, Less, LessEq, Greater, GreaterEq, NotEqual, Equal, Let, VarDecl,\n  Assign, While, For, ExprStmt, Assert, Invariant, Decreases, ComptimeFor, Wild,\n  Bind, CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat, NoPats,\n  PositionalPats, RecordPats, TypePats, AssertBy, Calc, BoolLit, Bound, Field,\n  Select, Race, UnitExpr","old_text":"from ast use FnDecl, TypeDecl, TypeExpr, Expr, Stmt, Pattern, Param, ImplDecl,\n  TraitDecl, Named, FnType, UnitType, Refined, UnionType, RowType, Alias,\n  RecordBody, SumBody, NoPayload, Positional, RecordPayload, MemberType, IntLit,\n  FloatLit, StrLit, Var, Hole, CtorExpr, Call, MethodCall, FieldOf, Lambda,\n  Binary, MatchExpr, MutExpr, Block, MockExpr, Return, TupleExpr, ListExpr, Div,\n  Mod, Sub, Less, LessEq, Greater, GreaterEq, NotEqual, Equal, Let, VarDecl,\n  Assign, While, For, ExprStmt, Assert, Invariant, Decreases, ComptimeFor, Wild,\n  Bind, CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat, NoPats,\n  PositionalPats, RecordPats, TypePats, AssertBy, Calc, BoolLit, Bound, Field,\n  Select, Race, UnitExpr, CtorPat"},{"name":"termination.pattern_type","kind":"fn","old":"71bfce0b900b495b","new":"6ae83bd7df7e20f0","interface_changed":false,"affected":[],"module":"termination","text":"/// The type of what `p`, matched against a value of type `t`, binds to\n/// `n`, when the code says it.\nfn pattern_type(\n  ctx: termination.Ctx,\n  p: ast.Pattern,\n  t: ast.TypeExpr,\n  n: String,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0 {\n    return None\n  }\n  u := termination.expand_alias(ctx, t)\n  first := (pts: List[(ast.Pattern, ast.TypeExpr)]) ->\n    termination.first_type(ctx, pts, n, fuel - 1)\n  match p {\n    ast.Bind(x) => if x == n {\n      Some(t)\n    } else {\n      None\n    },\n    ast.TuplePat(ps) => match u {\n      ast.Named { name: \"Tuple\", args } => if len(args) == len(ps) {\n        first(zip(ps, args))\n      } else {\n        None\n      },\n      _ => None,\n    },\n    ast.ListPat { items, rest } => if termination.short(termination.head(u)) != \"List\" {\n      None\n    } else if rest == Some(n) {\n      Some(u)\n    } else {\n      match termination.element_type(ctx, u) {\n        Some(e) => first(items.map(q -> (q, e))),\n        None => None,\n      }\n    },\n    ast.OrPat(alts) => first(alts.map(q -> (q, t))),\n    ast.CtorPattern { name, .. } => match termination.ctor_parts(ctx, u, p) {\n      Some(pts) => first(pts),\n      None => match termination.ctor_member(ctx, u, name) {\n        Some(m) => termination.pattern_type(ctx, p, m, n, fuel - 1),\n        None => None,\n      },\n    },\n    _ => None,\n  }\n}","old_text":"/// The type of what `p`, matched against a value of type `t`, binds to\n/// `n`, when the code says it.\nfn pattern_type(\n  ctx: termination.Ctx,\n  p: ast.Pattern,\n  t: ast.TypeExpr,\n  n: String,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0 {\n    return None\n  }\n  u := termination.expand_alias(ctx, t)\n  first := (pts: List[(ast.Pattern, ast.TypeExpr)]) ->\n    termination.first_type(ctx, pts, n, fuel - 1)\n  match p {\n    ast.Bind(x) => if x == n {\n      Some(t)\n    } else {\n      None\n    },\n    ast.TuplePat(ps) => match u {\n      ast.Named { name: \"Tuple\", args } => if len(args) == len(ps) {\n        first(zip(ps, args))\n      } else {\n        None\n      },\n      _ => None,\n    },\n    ast.ListPat { items, rest } => if termination.short(termination.head(u)) != \"List\" {\n      None\n    } else if rest == Some(n) {\n      Some(u)\n    } else {\n      match termination.element_type(ctx, u) {\n        Some(e) => first(items.map(q -> (q, e))),\n        None => None,\n      }\n    },\n    ast.OrPat(alts) => first(alts.map(q -> (q, t))),\n    ast.CtorPattern { name, args } => match termination.ctor_parts(ctx, u, name, args) {\n      Some(pts) => first(pts),\n      None => match termination.ctor_member(ctx, u, name) {\n        Some(m) => termination.pattern_type(ctx, p, m, n, fuel - 1),\n        None => None,\n      },\n    },\n    _ => None,\n  }\n}"},{"name":"termination.ctor_parts","kind":"fn","old":"a1cce211f4511161","new":"fc3ed9539eddec6e","interface_changed":true,"affected":["termination.pattern_type","termination.binding_type","termination.first_type","termination.source_of","termination.expr_type","termination.loop_start","termination.source_call","termination.is_list","termination.analyze_with","termination.element_calls","verify_program","termination.analyze","termination.structural","termination.passes_itself","search_invariants","build_proofs","verify_file","live_edit_command","alongside_command","smt_file","termination_file","static_graph","edit_file","apply_edit","fix_loops","run_command","build_command","command_line","std_proofs","verify_command","strata_command","graph_command","graph_diff","repl_command","edit_command","edit_in_editor","new_command","fix_command","main","std_library","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","check_command","test_command","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","build_core_command","comptime_value","literal_errors_of","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","comptime_values","loaded_check","file_errors","edit_errors","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","apply_change","with_base","package_errors","rename_command","move_command"],"module":"termination","text":"/// The subpatterns of the constructor pattern `p` on a value of\n/// type `t` (a variant of the sum `t`, or the record `t`), each with its\n/// type.\nfn ctor_parts(\n  ctx: termination.Ctx,\n  t: ast.TypeExpr,\n  p: ast.Pattern,\n) -> Option[List[(ast.Pattern, ast.TypeExpr)]] {\n  name := match p {\n    ast.CtorPattern { name, .. } => name,\n    _ => return None,\n  }\n  (td, targs) := termination.decl_of(ctx, t)?\n  sub := (x: ast.TypeExpr) -> termination.substitute(x, td.params, targs)\n  fields := (fs: List[ast.Field]) -> termination.field_parts(\n    fs.map(x -> ast.Field { ..x, ty: sub(x.ty) }),\n    p,\n  )\n  match td.body {\n    ast.SumBody(vs) => match vs.find(\n      v -> termination.short(v.name) == termination.short(name),\n    ) {\n      Some(v) => match v.payload {\n        ast.Positional(ts) => match p {\n          ast.CtorPattern { args: ast.PositionalPats(ps), .. } => if len(ps) == len(ts) {\n            Some(zip(ps, ts.map(sub)))\n          } else {\n            None\n          },\n          ast.CtorPattern { args: ast.NoPats, .. } => Some([]),\n          _ => None,\n        },\n        ast.RecordPayload(fs) => fields(fs),\n        ast.NoPayload => Some([]),\n        ast.MemberType(_) => None,\n      },\n      None => None,\n    },\n    ast.RecordBody(fs) => if termination.short(name) == termination.short(td.name) {\n      fields(fs)\n    } else {\n      None\n    },\n    ast.Alias(_) => None,\n  }\n}","old_text":"/// The subpatterns of the constructor pattern `name(args)` on a value of\n/// type `t` (a variant of the sum `t`, or the record `t`), each with its\n/// type.\nfn ctor_parts(\n  ctx: termination.Ctx,\n  t: ast.TypeExpr,\n  name: String,\n  args: CtorPat,\n) -> Option[List[(ast.Pattern, ast.TypeExpr)]] {\n  (td, targs) := termination.decl_of(ctx, t)?\n  sub := (x: ast.TypeExpr) -> termination.substitute(x, td.params, targs)\n  fields := (fs: List[ast.Field]) -> termination.field_parts(\n    fs.map(x -> ast.Field { ..x, ty: sub(x.ty) }),\n    args,\n  )\n  match td.body {\n    ast.SumBody(vs) => match vs.find(\n      v -> termination.short(v.name) == termination.short(name),\n    ) {\n      Some(v) => match v.payload {\n        ast.Positional(ts) => match args {\n          ast.PositionalPats(ps) => if len(ps) == len(ts) {\n            Some(zip(ps, ts.map(sub)))\n          } else {\n            None\n          },\n          ast.NoPats => Some([]),\n          _ => None,\n        },\n        ast.RecordPayload(fs) => fields(fs),\n        ast.NoPayload => Some([]),\n        ast.MemberType(_) => None,\n      },\n      None => None,\n    },\n    ast.RecordBody(fs) => if termination.short(name) == termination.short(td.name) {\n      fields(fs)\n    } else {\n      None\n    },\n    ast.Alias(_) => None,\n  }\n}"},{"name":"termination.field_parts","kind":"fn","old":"f91f910e05074d02","new":"490e146f9af07e3e","interface_changed":true,"affected":["termination.ctor_parts","termination.pattern_type","termination.binding_type","termination.first_type","termination.source_of","termination.expr_type","termination.loop_start","termination.source_call","termination.is_list","termination.analyze_with","termination.element_calls","verify_program","termination.analyze","termination.structural","termination.passes_itself","search_invariants","build_proofs","verify_file","live_edit_command","alongside_command","smt_file","termination_file","static_graph","edit_file","apply_edit","fix_loops","run_command","build_command","command_line","std_proofs","verify_command","strata_command","graph_command","graph_diff","repl_command","edit_command","edit_in_editor","new_command","fix_command","main","std_library","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","check_command","test_command","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","build_core_command","comptime_value","literal_errors_of","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","comptime_values","loaded_check","file_errors","edit_errors","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","apply_change","with_base","package_errors","rename_command","move_command"],"module":"termination","text":"/// The record pattern `p`'s subpatterns, each with its field's type\n/// among `fs`.\nfn field_parts(\n  fs: List[ast.Field],\n  p: ast.Pattern,\n) -> Option[List[(ast.Pattern, ast.TypeExpr)]] {\n  match p {\n    ast.CtorPattern { args: ast.RecordPats { fields: ps, .. }, .. } => {\n      mut out := []\n      for (fname, q) in ps {\n        match fs.find(x -> x.name == fname) {\n          Some(x) => mut out.push((q, x.ty)),\n          None => return None,\n        }\n      }\n      Some(out)\n    },\n    ast.CtorPattern { args: ast.NoPats, .. } => Some([]),\n    _ => None,\n  }\n}","old_text":"/// The record pattern `args`'s subpatterns, each with its field's type\n/// among `fs`.\nfn field_parts(\n  fs: List[ast.Field],\n  args: CtorPat,\n) -> Option[List[(ast.Pattern, ast.TypeExpr)]] {\n  match args {\n    ast.RecordPats { fields: ps, .. } => {\n      mut out := []\n      for (fname, q) in ps {\n        match fs.find(x -> x.name == fname) {\n          Some(x) => mut out.push((q, x.ty)),\n          None => return None,\n        }\n      }\n      Some(out)\n    },\n    ast.NoPats => Some([]),\n    _ => None,\n  }\n}"}]}
{"id":"cee3361483299376","time":1795825939,"message":"termination: a variable's type when all its bindings agree","changes":[{"name":"termination.source_of","kind":"fn","old":"b34032ac26161344","new":"873ccae0c9a52530","interface_changed":false,"affected":[],"module":"termination","text":"/// What a `for` over `e` in `f` runs over. A lazy `map`, `filter`, `drop`,\n/// `enumerate`, `reverse` or `sort` is as finite as what it is called on;\n/// `take`, `slice`, `to_list` and `iter` always are. A variable bound once\n/// is judged by its value, any variable by its type (`binding_type`), a call\n/// by its\n/// result type. `lets`: the body's `let`s and `mut` declarations.\nfn source_of(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  e: ast.Expr,\n  lets: List[(String, ast.Expr)],\n  once: Set[String],\n  fuel: Int,\n) -> termination.Source {\n  if fuel <= 0 {\n    return termination.SourceUnknown(\"`\"\n      + text.expr_text(e, 0)\n      + \"`, reached through more `let`s than are followed\")\n  }\n  match e {\n    ast.MethodCall { recv, name, args } => termination.source_call(\n      ctx,\n      f,\n      e,\n      name,\n      [recv] + args,\n      lets,\n      once,\n      fuel,\n    ),\n    ast.Call { callee: ast.Var(n), args } => match get(ctx.fns, n) {\n      Some(g) => termination.source_type(ctx, g.type_params, g.bounds, g.ret),\n      None => if contains(once, n) || f.params.any(p -> p.name == n) {\n        termination.SourceByValue\n      } else {\n        termination.source_call(\n          ctx,\n          f,\n          e,\n          n,\n          args,\n          lets,\n          once,\n          fuel,\n        )\n      },\n    },\n    ast.ListExpr(_) | ast.StrLit(_) | ast.Interp(_) => termination.SourceFinite,\n    ast.CtorExpr { name, .. } => termination.source_type(\n      ctx,\n      [],\n      [],\n      ast.Named { name, args: [] },\n    ),\n    // a record field (`h.it`): by the field's type\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, f, base, fuel) {\n      Some(t) => match termination.field_type(ctx, t, name) {\n        Some(ft) => termination.source_type(ctx, f.type_params, f.bounds, ft),\n        None => termination.SourceByValue,\n      },\n      None => termination.SourceByValue,\n    },\n    ast.Var(n) => if contains(once, n) {\n      match lets.find(x -> x.0 == n) {\n        Some((_, v)) => termination.source_of(ctx, f, v, lets, once, fuel - 1),\n        None => match termination.binding_type(ctx, f, n, fuel) {\n          Some(t) => termination.source_type(ctx, f.type_params, f.bounds, t),\n          None => termination.SourceByValue,\n        },\n      }\n    } else {\n      match termination.binding_type(ctx, f, n, fuel) {\n        Some(t) => termination.source_type(ctx, f.type_params, f.bounds, t),\n        None => termination.SourceByValue,\n      }\n    },\n    _ => termination.SourceByValue,\n  }\n}","old_text":"/// What a `for` over `e` in `f` runs over. A lazy `map`, `filter`, `drop`,\n/// `enumerate`, `reverse` or `sort` is as finite as what it is called on;\n/// `take`, `slice`, `to_list` and `iter` always are. A variable bound once\n/// is judged by its value or its type (`binding_type`), a call by its\n/// result type. `lets`: the body's `let`s and `mut` declarations.\nfn source_of(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  e: ast.Expr,\n  lets: List[(String, ast.Expr)],\n  once: Set[String],\n  fuel: Int,\n) -> termination.Source {\n  if fuel <= 0 {\n    return termination.SourceUnknown(\"`\"\n      + text.expr_text(e, 0)\n      + \"`, reached through more `let`s than are followed\")\n  }\n  match e {\n    ast.MethodCall { recv, name, args } => termination.source_call(\n      ctx,\n      f,\n      e,\n      name,\n      [recv] + args,\n      lets,\n      once,\n      fuel,\n    ),\n    ast.Call { callee: ast.Var(n), args } => match get(ctx.fns, n) {\n      Some(g) => termination.source_type(ctx, g.type_params, g.bounds, g.ret),\n      None => if contains(once, n) || f.params.any(p -> p.name == n) {\n        termination.SourceByValue\n      } else {\n        termination.source_call(\n          ctx,\n          f,\n          e,\n          n,\n          args,\n          lets,\n          once,\n          fuel,\n        )\n      },\n    },\n    ast.ListExpr(_) | ast.StrLit(_) | ast.Interp(_) => termination.SourceFinite,\n    ast.CtorExpr { name, .. } => termination.source_type(\n      ctx,\n      [],\n      [],\n      ast.Named { name, args: [] },\n    ),\n    // a record field (`h.it`): by the field's type\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, f, once, base, fuel) {\n      Some(t) => match termination.field_type(ctx, t, name) {\n        Some(ft) => termination.source_type(ctx, f.type_params, f.bounds, ft),\n        None => termination.SourceByValue,\n      },\n      None => termination.SourceByValue,\n    },\n    ast.Var(n) => if contains(once, n) {\n      match lets.find(x -> x.0 == n) {\n        Some((_, v)) => termination.source_of(ctx, f, v, lets, once, fuel - 1),\n        None => match termination.binding_type(ctx, f, once, n, fuel) {\n          Some(t) => termination.source_type(ctx, f.type_params, f.bounds, t),\n          None => termination.SourceByValue,\n        },\n      }\n    } else {\n      termination.SourceByValue\n    },\n    _ => termination.SourceByValue,\n  }\n}"},{"name":"termination.expr_type","kind":"fn","old":"8d840137258a0dab","new":"02d171943e3cdf7d","interface_changed":true,"affected":["termination.source_of","termination.binding_type","termination.is_list","termination.loop_start","termination.source_call","termination.element_calls","termination.analyze_with","termination.structural","termination.passes_itself","verify_program","termination.analyze","search_invariants","build_proofs","verify_file","live_edit_command","alongside_command","smt_file","termination_file","static_graph","edit_file","apply_edit","fix_loops","run_command","build_command","command_line","std_proofs","verify_command","strata_command","graph_command","graph_diff","repl_command","edit_command","edit_in_editor","new_command","fix_command","main","std_library","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","check_command","test_command","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","build_core_command","comptime_value","literal_errors_of","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","comptime_values","loaded_check","file_errors","edit_errors","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","apply_change","with_base","package_errors","rename_command","move_command"],"module":"termination","text":"/// The type of `e` in `f`, as far as the code says it: a variable\n/// (`binding_type`), a call of a function of the program whose result\n/// type names none of its type parameters, a record built by name, or a\n/// field of a record.\nfn expr_type(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  e: ast.Expr,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0 {\n    return None\n  }\n  match e {\n    ast.Var(n) => termination.binding_type(ctx, f, n, fuel - 1),\n    ast.Call { callee: ast.Var(g), .. } => match get(ctx.fns, g) {\n      Some(d) => if termination.names_any(d.ret, d.type_params + [\"Self\"]) {\n        None\n      } else {\n        Some(d.ret)\n      },\n      None => None,\n    },\n    ast.CtorExpr { name, .. } => match get(ctx.types, name) {\n      Some(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          Some(ast.Named { name, args: [] })\n        } else {\n          None\n        },\n        _ => None,\n      },\n      None => None,\n    },\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, f, base, fuel - 1) {\n      Some(t) => termination.field_type(ctx, t, name),\n      None => None,\n    },\n    _ => None,\n  }\n}","old_text":"/// The type of `e` in `f`, as far as the code says it: a variable bound\n/// once (`binding_type`), a call of a function of the program whose result\n/// type names none of its type parameters, a record built by name, or a\n/// field of a record.\nfn expr_type(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  once: Set[String],\n  e: ast.Expr,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0 {\n    return None\n  }\n  match e {\n    ast.Var(n) => termination.binding_type(ctx, f, once, n, fuel - 1),\n    ast.Call { callee: ast.Var(g), .. } => match get(ctx.fns, g) {\n      Some(d) => if termination.names_any(d.ret, d.type_params + [\"Self\"]) {\n        None\n      } else {\n        Some(d.ret)\n      },\n      None => None,\n    },\n    ast.CtorExpr { name, .. } => match get(ctx.types, name) {\n      Some(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          Some(ast.Named { name, args: [] })\n        } else {\n          None\n        },\n        _ => None,\n      },\n      None => None,\n    },\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, f, once, base, fuel - 1) {\n      Some(t) => termination.field_type(ctx, t, name),\n      None => None,\n    },\n    _ => None,\n  }\n}"},{"name":"termination.binding_type","kind":"fn","old":"d6e427b18facf7ea","new":"224801ee9c785314","interface_changed":true,"affected":["termination.source_of","termination.expr_type","termination.loop_start","termination.source_call","termination.is_list","termination.analyze_with","termination.element_calls","verify_program","termination.analyze","termination.structural","termination.passes_itself","search_invariants","build_proofs","verify_file","live_edit_command","alongside_command","smt_file","termination_file","static_graph","edit_file","apply_edit","fix_loops","run_command","build_command","command_line","std_proofs","verify_command","strata_command","graph_command","graph_diff","repl_command","edit_command","edit_in_editor","new_command","fix_command","main","std_library","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","check_command","test_command","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","build_core_command","comptime_value","literal_errors_of","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","comptime_values","loaded_check","file_errors","edit_errors","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","apply_change","with_base","package_errors","rename_command","move_command"],"module":"termination","text":"/// The type of `n` in `f`, when every place `f` binds it says the same\n/// type: a parameter's type, a `let`'s or `mut` declaration's (written, or\n/// its value's), a lambda parameter's written type, the piece a `match` arm\n/// or a `let` pattern binds of the value matched, or an element of the list\n/// or set a `for` runs over. A `comptime for` or a `select` arm binding it\n/// says no type.\nfn binding_type(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  n: String,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0 {\n    return None\n  }\n  of := (x: ast.Expr) -> termination.expr_type(ctx, f, x, fuel - 1)\n  piece_of := (p: ast.Pattern, t: Option[ast.TypeExpr]) -> match t {\n    Some(u) => termination.pattern_type(ctx, p, u, n, 8),\n    None => None,\n  }\n  mut sites: List[Option[ast.TypeExpr]] = f.params.filter(p -> p.name == n).map(p -> Some(p.ty))\n  for x in termination.preorder(f.body) {\n    match x {\n      ast.Block { stmts, .. } => {\n        for s in stmts {\n          match s {\n            ast.Let { pat, ty, value } => if termination.pattern_binds(pat).contains(n) {\n              mut sites.push(\n                piece_of(pat, match ty {\n                  Some(t) => Some(t),\n                  None => of(value),\n                }),\n              )\n            },\n            ast.VarDecl { name, ty, value } => if name == n {\n              mut sites.push(\n                match ty {\n                  Some(t) => Some(t),\n                  None => of(value),\n                },\n              )\n            },\n            ast.For { pat, iter, .. } => if termination.pattern_binds(pat).contains(n) {\n              mut sites.push(\n                piece_of(pat, match of(iter) {\n                  Some(t) => termination.element_type(ctx, t),\n                  None => None,\n                }),\n              )\n            },\n            ast.ComptimeFor { pat, .. } => if termination.pattern_binds(pat).contains(n) {\n              mut sites.push(None)\n            },\n            _ => (),\n          }\n        }\n      },\n      ast.MatchExpr { scrutinee, binding, arms } => {\n        if binding == Some(n) {\n          mut sites.push(of(scrutinee))\n        }\n        for a in arms {\n          if termination.pattern_binds(a.pat).contains(n) {\n            mut sites.push(piece_of(a.pat, of(scrutinee)))\n          }\n        }\n      },\n      ast.Lambda { params, .. } => {\n        for p in params.filter(p -> p.name == n) {\n          mut sites.push(p.ty)\n        }\n      },\n      ast.Select(arms) | ast.Race(arms) => if arms.any(a -> a.name == Some(n)) {\n        mut sites.push(None)\n      },\n      _ => (),\n    }\n  }\n  match get(sites, 0) {\n    Some(Some(t)) => if sites.all(s -> s == Some(t)) {\n      Some(t)\n    } else {\n      None\n    },\n    _ => None,\n  }\n}","old_text":"/// The type of `n`, bound once in `f`: a parameter's type, a `let`'s or\n/// `mut` declaration's (written, or its value's), a lambda parameter's\n/// written type, the piece a `match` arm or a `let` pattern binds of the\n/// value matched, or an element of the list or set a `for` runs over.\nfn binding_type(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  once: Set[String],\n  n: String,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if !contains(once, n) {\n    return None\n  }\n  match f.params.find(p -> p.name == n) {\n    Some(p) => return Some(p.ty),\n    None => (),\n  }\n  of := (x: ast.Expr) -> termination.expr_type(ctx, f, once, x, fuel)\n  piece_of := (p: ast.Pattern, t: Option[ast.TypeExpr]) -> match t {\n    Some(u) => termination.pattern_type(ctx, p, u, n, 8),\n    None => None,\n  }\n  for x in termination.preorder(f.body) {\n    match x {\n      ast.Block { stmts, .. } => {\n        for s in stmts {\n          match s {\n            ast.Let { pat, ty, value } => if termination.pattern_binds(pat).contains(n) {\n              return piece_of(pat, match ty {\n                Some(t) => Some(t),\n                None => of(value),\n              })\n            },\n            ast.VarDecl { name, ty, value } => if name == n {\n              return match ty {\n                Some(t) => Some(t),\n                None => of(value),\n              }\n            },\n            ast.For { pat, iter, .. } => if termination.pattern_binds(pat).contains(n) {\n              return piece_of(pat, match of(iter) {\n                Some(t) => termination.element_type(ctx, t),\n                None => None,\n              })\n            },\n            _ => (),\n          }\n        }\n      },\n      ast.MatchExpr { scrutinee, binding, arms } => {\n        if binding == Some(n) {\n          return of(scrutinee)\n        }\n        for a in arms {\n          if termination.pattern_binds(a.pat).contains(n) {\n            return piece_of(a.pat, of(scrutinee))\n          }\n        }\n      },\n      ast.Lambda { params, .. } => match params.find(p -> p.name == n) {\n        Some(p) => return p.ty,\n        None => (),\n      },\n      _ => (),\n    }\n  }\n  None\n}"},{"name":"termination.element_calls","kind":"fn","old":"e3bb5bc1710287eb","new":"4ab3210f49f31e38","interface_changed":false,"affected":[],"module":"termination","text":"/// The calls in `f` of a builtin that calls its function argument, one of\n/// `names`, on elements of its list argument only (`args.any(has_gen)`):\n/// `any`, `all`, `map`, `filter`, `find` and `count` of a value whose type\n/// the code says is a `List`, where no function, method or trait method of\n/// the program has the name.\nfn element_calls(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  names: Set[String],\n) -> List[ast.Expr] {\n  termination.preorder(f.body).filter(\n    e ->\n      match e {\n        ast.MethodCall { recv, name, args: [ast.Var(v)] } => contains(names, v)\n          && termination.element_builtin(ctx, name)\n          && termination.is_list(ctx, f, recv),\n        ast.Call { callee: ast.Var(name), args: [xs, ast.Var(v)] } => contains(names, v)\n          && termination.element_builtin(ctx, name)\n          && termination.is_list(ctx, f, xs),\n        _ => false,\n      },\n  )\n}","old_text":"/// The calls in `f` of a builtin that calls its function argument, one of\n/// `names`, on elements of its list argument only (`args.any(has_gen)`):\n/// `any`, `all`, `map`, `filter`, `find` and `count` of a value whose type\n/// the code says is a `List`, where no function, method or trait method of\n/// the program has the name.\nfn element_calls(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  names: Set[String],\n) -> List[ast.Expr] {\n  once := termination.bound_once(f)\n  termination.preorder(f.body).filter(\n    e ->\n      match e {\n        ast.MethodCall { recv, name, args: [ast.Var(v)] } => contains(names, v)\n          && termination.element_builtin(ctx, name)\n          && termination.is_list(ctx, f, once, recv),\n        ast.Call { callee: ast.Var(name), args: [xs, ast.Var(v)] } => contains(names, v)\n          && termination.element_builtin(ctx, name)\n          && termination.is_list(ctx, f, once, xs),\n        _ => false,\n      },\n  )\n}"},{"name":"termination.is_list","kind":"fn","old":"ed4aaafe7ffd0b05","new":"3a130c830f5e3eca","interface_changed":true,"affected":["termination.element_calls","termination.analyze_with","termination.structural","termination.passes_itself","verify_program","termination.analyze","search_invariants","build_proofs","verify_file","live_edit_command","alongside_command","smt_file","termination_file","static_graph","edit_file","apply_edit","fix_loops","run_command","build_command","command_line","std_proofs","verify_command","strata_command","graph_command","graph_diff","repl_command","edit_command","edit_in_editor","new_command","fix_command","main","std_library","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","check_command","test_command","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","build_core_command","comptime_value","literal_errors_of","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","comptime_values","loaded_check","file_errors","edit_errors","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","apply_change","with_base","package_errors","rename_command","move_command"],"module":"termination","text":"/// Whether the code says `e`, in `f`, is a `List`.\nfn is_list(ctx: termination.Ctx, f: ast.FnDecl, e: ast.Expr) -> Bool {\n  match termination.expr_type(ctx, f, e, 6) {\n    Some(t) => termination.short(\n      termination.head(termination.expand_alias(ctx, t)),\n    ) == \"List\",\n    None => false,\n  }\n}","old_text":"/// Whether the code says `e`, in `f`, is a `List`.\nfn is_list(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  once: Set[String],\n  e: ast.Expr,\n) -> Bool {\n  match termination.expr_type(ctx, f, once, e, 8) {\n    Some(t) => termination.short(\n      termination.head(termination.expand_alias(ctx, t)),\n    ) == \"List\",\n    None => false,\n  }\n}"}]}
{"id":"16bd2e5c91009737","time":1795826217,"message":"termination: variable types found in rounds over every binding","changes":[{"name":"termination.loop_start","kind":"fn","old":"f7176f716cde4def","new":"fa27fbec2338c577","interface_changed":false,"affected":[],"module":"termination","text":"/// A body's loops before the solver is asked anything. `Ok(how they end)`\n/// or `Err(why one may not)` when that is known already, else a search for\n/// the `while` bounds. `iterates`: whether it has a `for` over an iterator\n/// that is no list (compiled as calls of `next`).\nfn loop_start(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  label: String,\n  encoded: Dict[String, smt.Vc],\n  mut iterates: Bool,\n) -> termination.LoopSearch {\n  done := (r: Result[List[String], String]) -> termination.LoopSearch {\n    vc: ctx.base,\n    at: 0,\n    cand: 0,\n    hows: [],\n    result: Some(r),\n  }\n  ss := termination.statements(f.body)\n  has_for := ss.any(\n    s -> match s {\n      ast.For { .. } => true,\n      _ => false,\n    },\n  )\n  // (`loop { … }` is stored as `while true { … }`)\n  has_while := ss.any(\n    s -> match s {\n      ast.While { cond, .. } => cond != ast.BoolLit(true),\n      _ => false,\n    },\n  )\n  has_loop := ss.any(\n    s -> match s {\n      ast.While { cond: ast.BoolLit(true), .. } => true,\n      _ => false,\n    },\n  )\n  // a `loop` with no `decreases` clause (one with it is checked as a\n  // `while` loop)\n  bare_loop := ss.any(\n    s ->\n      match s {\n        ast.While { cond: ast.BoolLit(true), body } => text.decreases_of(body) == [],\n        _ => false,\n      },\n  )\n  measured := has_while || has_loop && !bare_loop\n  // what each `for` runs over, as far as the code says; a lazy `.map(..)`,\n  // `.filter(..)` or `.drop(n)` is judged here, as the encoder gives it as\n  // a list\n  lets := [x for st in ss for x in match st {\n    ast.Let { pat: ast.Bind(n), value, .. } => [(n, value)],\n    ast.VarDecl { name, value, .. } => [(name, value)],\n    _ => [],\n  }]\n  once := termination.bound_once(f)\n  env := if has_for {\n    termination.var_types(ctx, f)\n  } else {\n    Dict[String, ast.TypeExpr] {}\n  }\n  mut by_value := false\n  for st in ss {\n    match st {\n      ast.For { iter, .. } => match termination.source_of(ctx, f, env, iter, lets, once, 8) {\n        termination.SourceLazy => return done(Err(termination.never_ends())),\n        termination.SourceUnknown(why) => return done(\n          Err(\n            \"it has a `for` over \"\n              + why\n              + \", which isn't known to end (only `for` loops over lists, sets, dicts and finite iterators, and `while` loops whose bound goes down, are shown to end)\",\n          ),\n        ),\n        termination.SourceByValue => {\n          by_value = true\n        },\n        termination.SourceFinite => (),\n      },\n      _ => (),\n    }\n  }\n  if !has_for && !has_while && !has_loop {\n    return done(Ok([]))\n  }\n  // the loops' invariants help show their bounds go down; without a\n  // solver none can be shown\n  if measured && !bare_loop && ctx.solver == \"\" {\n    return done(Err(\n      \"it has a `while` loop, and no SMT solver was found to check its bound\",\n    ))\n  }\n  vc := if measured {\n    get(encoded, label) or {\n      smt.encode(\n        mut commands,\n        mut files,\n        ctx.scratch,\n        ctx.solver,\n        ctx.fns,\n        ctx.types,\n        ctx.sigs,\n        ctx.methods,\n        f,\n        label,\n      )\n    }\n  } else if has_for {\n    get(encoded, label) or {\n      mut v := smt.new_vc(ctx.fns, ctx.types, ctx.sigs, ctx.methods)\n      smt.function(mut v, f, label)\n      v\n    }\n  } else {\n    smt.new_vc(ctx.fns, ctx.types, ctx.sigs, ctx.methods)\n  }\n  // a `for` over an `Iterator` is a `loop` calling `next`\n  iterates = vc.iter_fors.any(h -> h != \"\")\n  // (the encoder's value of each `for`'s iterator, for those the code\n  // doesn't say the type of)\n  if by_value && vc.iter_fors.any(h -> h == \"\") {\n    return done(\n      Err(\n        \"it has a `for` over a value whose type the prover doesn't model, which isn't known to end (only `for` loops over lists, sets, dicts and finite iterators, and `while` loops whose bound goes down, are shown to end)\",\n      ),\n    )\n  }\n  if by_value\n    && vc.iter_fors.any(\n      h -> h != \"\" && !termination.finite_iterator(ctx, h),\n    ) {\n    return done(Err(termination.never_ends()))\n  }\n  if bare_loop {\n    return done(\n      Err(\n        \"it has a `loop` without a `decreases` clause (only `for` loops, `while` loops whose bound goes down, and loops whose `decreases` measure goes down, are shown to end)\",\n      ),\n    )\n  }\n  if !measured {\n    return done(Ok([]))\n  }\n  termination.LoopSearch {\n    vc,\n    at: 0,\n    cand: 0,\n    hows: [],\n    result: None,\n  }\n}","old_text":"/// A body's loops before the solver is asked anything. `Ok(how they end)`\n/// or `Err(why one may not)` when that is known already, else a search for\n/// the `while` bounds. `iterates`: whether it has a `for` over an iterator\n/// that is no list (compiled as calls of `next`).\nfn loop_start(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  label: String,\n  encoded: Dict[String, smt.Vc],\n  mut iterates: Bool,\n) -> termination.LoopSearch {\n  done := (r: Result[List[String], String]) -> termination.LoopSearch {\n    vc: ctx.base,\n    at: 0,\n    cand: 0,\n    hows: [],\n    result: Some(r),\n  }\n  ss := termination.statements(f.body)\n  has_for := ss.any(\n    s -> match s {\n      ast.For { .. } => true,\n      _ => false,\n    },\n  )\n  // (`loop { … }` is stored as `while true { … }`)\n  has_while := ss.any(\n    s -> match s {\n      ast.While { cond, .. } => cond != ast.BoolLit(true),\n      _ => false,\n    },\n  )\n  has_loop := ss.any(\n    s -> match s {\n      ast.While { cond: ast.BoolLit(true), .. } => true,\n      _ => false,\n    },\n  )\n  // a `loop` with no `decreases` clause (one with it is checked as a\n  // `while` loop)\n  bare_loop := ss.any(\n    s ->\n      match s {\n        ast.While { cond: ast.BoolLit(true), body } => text.decreases_of(body) == [],\n        _ => false,\n      },\n  )\n  measured := has_while || has_loop && !bare_loop\n  // what each `for` runs over, as far as the code says; a lazy `.map(..)`,\n  // `.filter(..)` or `.drop(n)` is judged here, as the encoder gives it as\n  // a list\n  lets := [x for st in ss for x in match st {\n    ast.Let { pat: ast.Bind(n), value, .. } => [(n, value)],\n    ast.VarDecl { name, value, .. } => [(name, value)],\n    _ => [],\n  }]\n  once := termination.bound_once(f)\n  mut by_value := false\n  for st in ss {\n    match st {\n      ast.For { iter, .. } => match termination.source_of(ctx, f, iter, lets, once, 8) {\n        termination.SourceLazy => return done(Err(termination.never_ends())),\n        termination.SourceUnknown(why) => return done(\n          Err(\n            \"it has a `for` over \"\n              + why\n              + \", which isn't known to end (only `for` loops over lists, sets, dicts and finite iterators, and `while` loops whose bound goes down, are shown to end)\",\n          ),\n        ),\n        termination.SourceByValue => {\n          by_value = true\n        },\n        termination.SourceFinite => (),\n      },\n      _ => (),\n    }\n  }\n  if !has_for && !has_while && !has_loop {\n    return done(Ok([]))\n  }\n  // the loops' invariants help show their bounds go down; without a\n  // solver none can be shown\n  if measured && !bare_loop && ctx.solver == \"\" {\n    return done(Err(\n      \"it has a `while` loop, and no SMT solver was found to check its bound\",\n    ))\n  }\n  vc := if measured {\n    get(encoded, label) or {\n      smt.encode(\n        mut commands,\n        mut files,\n        ctx.scratch,\n        ctx.solver,\n        ctx.fns,\n        ctx.types,\n        ctx.sigs,\n        ctx.methods,\n        f,\n        label,\n      )\n    }\n  } else if has_for {\n    get(encoded, label) or {\n      mut v := smt.new_vc(ctx.fns, ctx.types, ctx.sigs, ctx.methods)\n      smt.function(mut v, f, label)\n      v\n    }\n  } else {\n    smt.new_vc(ctx.fns, ctx.types, ctx.sigs, ctx.methods)\n  }\n  // a `for` over an `Iterator` is a `loop` calling `next`\n  iterates = vc.iter_fors.any(h -> h != \"\")\n  // (the encoder's value of each `for`'s iterator, for those the code\n  // doesn't say the type of)\n  if by_value && vc.iter_fors.any(h -> h == \"\") {\n    return done(\n      Err(\n        \"it has a `for` over a value whose type the prover doesn't model, which isn't known to end (only `for` loops over lists, sets, dicts and finite iterators, and `while` loops whose bound goes down, are shown to end)\",\n      ),\n    )\n  }\n  if by_value\n    && vc.iter_fors.any(\n      h -> h != \"\" && !termination.finite_iterator(ctx, h),\n    ) {\n    return done(Err(termination.never_ends()))\n  }\n  if bare_loop {\n    return done(\n      Err(\n        \"it has a `loop` without a `decreases` clause (only `for` loops, `while` loops whose bound goes down, and loops whose `decreases` measure goes down, are shown to end)\",\n      ),\n    )\n  }\n  if !measured {\n    return done(Ok([]))\n  }\n  termination.LoopSearch {\n    vc,\n    at: 0,\n    cand: 0,\n    hows: [],\n    result: None,\n  }\n}"},{"name":"termination.source_of","kind":"fn","old":"873ccae0c9a52530","new":"f40eb30e6397efb2","interface_changed":true,"affected":["termination.loop_start","termination.source_call","termination.analyze_with","verify_program","termination.analyze","search_invariants","build_proofs","verify_file","live_edit_command","alongside_command","smt_file","termination_file","static_graph","edit_file","apply_edit","fix_loops","run_command","build_command","command_line","std_proofs","verify_command","strata_command","graph_command","graph_diff","repl_command","edit_command","edit_in_editor","new_command","fix_command","main","std_library","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","check_command","test_command","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","build_core_command","comptime_value","literal_errors_of","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","comptime_values","loaded_check","file_errors","edit_errors","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","apply_change","with_base","package_errors","rename_command","move_command"],"module":"termination","text":"/// What a `for` over `e` in `f` runs over. A lazy `map`, `filter`, `drop`,\n/// `enumerate`, `reverse` or `sort` is as finite as what it is called on;\n/// `take`, `slice`, `to_list` and `iter` always are. A variable bound once\n/// is judged by its value, any variable by its type in `env`\n/// (`var_types`), a call by its result type. `lets`: the body's `let`s and\n/// `mut` declarations.\nfn source_of(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  env: Dict[String, ast.TypeExpr],\n  e: ast.Expr,\n  lets: List[(String, ast.Expr)],\n  once: Set[String],\n  fuel: Int,\n) -> termination.Source {\n  if fuel <= 0 {\n    return termination.SourceUnknown(\"`\"\n      + text.expr_text(e, 0)\n      + \"`, reached through more `let`s than are followed\")\n  }\n  match e {\n    ast.MethodCall { recv, name, args } => termination.source_call(\n      ctx,\n      f,\n      env,\n      e,\n      name,\n      [recv] + args,\n      lets,\n      once,\n      fuel,\n    ),\n    ast.Call { callee: ast.Var(n), args } => match get(ctx.fns, n) {\n      Some(g) => termination.source_type(ctx, g.type_params, g.bounds, g.ret),\n      None => if contains(once, n) || f.params.any(p -> p.name == n) {\n        termination.SourceByValue\n      } else {\n        termination.source_call(\n          ctx,\n          f,\n          env,\n          e,\n          n,\n          args,\n          lets,\n          once,\n          fuel,\n        )\n      },\n    },\n    ast.ListExpr(_) | ast.StrLit(_) | ast.Interp(_) => termination.SourceFinite,\n    ast.CtorExpr { name, .. } => termination.source_type(\n      ctx,\n      [],\n      [],\n      ast.Named { name, args: [] },\n    ),\n    // a record field (`h.it`): by the field's type\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, env, base, 8) {\n      Some(t) => match termination.field_type(ctx, t, name) {\n        Some(ft) => termination.source_type(ctx, f.type_params, f.bounds, ft),\n        None => termination.SourceByValue,\n      },\n      None => termination.SourceByValue,\n    },\n    ast.Var(n) => if contains(once, n) {\n      match lets.find(x -> x.0 == n) {\n        Some((_, v)) => termination.source_of(ctx, f, env, v, lets, once, fuel - 1),\n        None => match get(env, n) {\n          Some(t) => termination.source_type(ctx, f.type_params, f.bounds, t),\n          None => termination.SourceByValue,\n        },\n      }\n    } else {\n      match get(env, n) {\n        Some(t) => termination.source_type(ctx, f.type_params, f.bounds, t),\n        None => termination.SourceByValue,\n      }\n    },\n    _ => termination.SourceByValue,\n  }\n}","old_text":"/// What a `for` over `e` in `f` runs over. A lazy `map`, `filter`, `drop`,\n/// `enumerate`, `reverse` or `sort` is as finite as what it is called on;\n/// `take`, `slice`, `to_list` and `iter` always are. A variable bound once\n/// is judged by its value, any variable by its type (`binding_type`), a call\n/// by its\n/// result type. `lets`: the body's `let`s and `mut` declarations.\nfn source_of(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  e: ast.Expr,\n  lets: List[(String, ast.Expr)],\n  once: Set[String],\n  fuel: Int,\n) -> termination.Source {\n  if fuel <= 0 {\n    return termination.SourceUnknown(\"`\"\n      + text.expr_text(e, 0)\n      + \"`, reached through more `let`s than are followed\")\n  }\n  match e {\n    ast.MethodCall { recv, name, args } => termination.source_call(\n      ctx,\n      f,\n      e,\n      name,\n      [recv] + args,\n      lets,\n      once,\n      fuel,\n    ),\n    ast.Call { callee: ast.Var(n), args } => match get(ctx.fns, n) {\n      Some(g) => termination.source_type(ctx, g.type_params, g.bounds, g.ret),\n      None => if contains(once, n) || f.params.any(p -> p.name == n) {\n        termination.SourceByValue\n      } else {\n        termination.source_call(\n          ctx,\n          f,\n          e,\n          n,\n          args,\n          lets,\n          once,\n          fuel,\n        )\n      },\n    },\n    ast.ListExpr(_) | ast.StrLit(_) | ast.Interp(_) => termination.SourceFinite,\n    ast.CtorExpr { name, .. } => termination.source_type(\n      ctx,\n      [],\n      [],\n      ast.Named { name, args: [] },\n    ),\n    // a record field (`h.it`): by the field's type\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, f, base, fuel) {\n      Some(t) => match termination.field_type(ctx, t, name) {\n        Some(ft) => termination.source_type(ctx, f.type_params, f.bounds, ft),\n        None => termination.SourceByValue,\n      },\n      None => termination.SourceByValue,\n    },\n    ast.Var(n) => if contains(once, n) {\n      match lets.find(x -> x.0 == n) {\n        Some((_, v)) => termination.source_of(ctx, f, v, lets, once, fuel - 1),\n        None => match termination.binding_type(ctx, f, n, fuel) {\n          Some(t) => termination.source_type(ctx, f.type_params, f.bounds, t),\n          None => termination.SourceByValue,\n        },\n      }\n    } else {\n      match termination.binding_type(ctx, f, n, fuel) {\n        Some(t) => termination.source_type(ctx, f.type_params, f.bounds, t),\n        None => termination.SourceByValue,\n      }\n    },\n    _ => termination.SourceByValue,\n  }\n}"},{"name":"termination.source_call","kind":"fn","old":"05524172efd70ece","new":"19f66a5940ddd68c","interface_changed":true,"affected":["termination.source_of","termination.loop_start","termination.analyze_with","verify_program","termination.analyze","search_invariants","build_proofs","verify_file","live_edit_command","alongside_command","smt_file","termination_file","static_graph","edit_file","apply_edit","fix_loops","run_command","build_command","command_line","std_proofs","verify_command","strata_command","graph_command","graph_diff","repl_command","edit_command","edit_in_editor","new_command","fix_command","main","std_library","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","check_command","test_command","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","build_core_command","comptime_value","literal_errors_of","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","comptime_values","loaded_check","file_errors","edit_errors","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","apply_change","with_base","package_errors","rename_command","move_command"],"module":"termination","text":"/// What a `for` over a call of `name` with `args` (the receiver first)\n/// runs over, when `name` is no function of the program: a lazy adapter or\n/// a builtin. A name some type has a method of its own by, or a trait\n/// method, may be either, so it is left to the value.\nfn source_call(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  env: Dict[String, ast.TypeExpr],\n  e: ast.Expr,\n  name: String,\n  args: List[ast.Expr],\n  lets: List[(String, ast.Expr)],\n  once: Set[String],\n  fuel: Int,\n) -> termination.Source {\n  if termination.own_methods_named(ctx, name) != []\n    || termination.is_method(ctx, name)\n    || contains(ctx.fns, name) {\n    return termination.SourceByValue\n  }\n  of := (x: ast.Expr) ->\n    termination.source_of(ctx, f, env, x, lets, once, fuel - 1)\n  made_from := (s: termination.Source) -> match s {\n    termination.SourceByValue => termination.SourceUnknown(\"`\"\n      + text.expr_text(e, 0)\n      + \"`, made from a value whose type isn't known here\"),\n    other => other,\n  }\n  if [\n    \"map\",\n    \"filter\",\n    \"drop\",\n    \"enumerate\",\n    \"reverse\",\n    \"reversed\",\n    \"sort\",\n    \"sort_by\",\n  ].contains(\n    name,\n  ) {\n    return match get(args, 0) {\n      Some(x) => made_from(of(x)),\n      None => termination.SourceByValue,\n    }\n  }\n  if [\"take\", \"slice\", \"to_list\", \"iter\"].contains(name) {\n    return termination.SourceFinite\n  }\n  if name == \"zip\" {\n    ss := take(args, 2).map(x -> made_from(of(x)))\n    return if ss.any(s -> s is termination.SourceFinite) {\n      termination.SourceFinite\n    } else {\n      get(ss.filter(s -> !(s is termination.SourceLazy)), 0) ?? termination.SourceLazy\n    }\n  }\n  sigs := ctx.sigs.filter(s -> s.name == name)\n  if sigs != []\n    && sigs.all(\n      s ->\n        termination.source_type(ctx, s.type_params, [], s.ret) is termination.SourceFinite,\n    ) {\n    termination.SourceFinite\n  } else {\n    termination.SourceByValue\n  }\n}","old_text":"/// What a `for` over a call of `name` with `args` (the receiver first)\n/// runs over, when `name` is no function of the program: a lazy adapter or\n/// a builtin. A name some type has a method of its own by, or a trait\n/// method, may be either, so it is left to the value.\nfn source_call(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  e: ast.Expr,\n  name: String,\n  args: List[ast.Expr],\n  lets: List[(String, ast.Expr)],\n  once: Set[String],\n  fuel: Int,\n) -> termination.Source {\n  if termination.own_methods_named(ctx, name) != []\n    || termination.is_method(ctx, name)\n    || contains(ctx.fns, name) {\n    return termination.SourceByValue\n  }\n  of := (x: ast.Expr) ->\n    termination.source_of(ctx, f, x, lets, once, fuel - 1)\n  made_from := (s: termination.Source) -> match s {\n    termination.SourceByValue => termination.SourceUnknown(\"`\"\n      + text.expr_text(e, 0)\n      + \"`, made from a value whose type isn't known here\"),\n    other => other,\n  }\n  if [\n    \"map\",\n    \"filter\",\n    \"drop\",\n    \"enumerate\",\n    \"reverse\",\n    \"reversed\",\n    \"sort\",\n    \"sort_by\",\n  ].contains(\n    name,\n  ) {\n    return match get(args, 0) {\n      Some(x) => made_from(of(x)),\n      None => termination.SourceByValue,\n    }\n  }\n  if [\"take\", \"slice\", \"to_list\", \"iter\"].contains(name) {\n    return termination.SourceFinite\n  }\n  if name == \"zip\" {\n    ss := take(args, 2).map(x -> made_from(of(x)))\n    return if ss.any(s -> s is termination.SourceFinite) {\n      termination.SourceFinite\n    } else {\n      get(ss.filter(s -> !(s is termination.SourceLazy)), 0) ?? termination.SourceLazy\n    }\n  }\n  sigs := ctx.sigs.filter(s -> s.name == name)\n  if sigs != []\n    && sigs.all(\n      s ->\n        termination.source_type(ctx, s.type_params, [], s.ret) is termination.SourceFinite,\n    ) {\n    termination.SourceFinite\n  } else {\n    termination.SourceByValue\n  }\n}"},{"name":"termination.expr_type","kind":"fn","old":"02d171943e3cdf7d","new":"ff140ec16cb7c7dc","interface_changed":true,"affected":["termination.source_of","termination.is_list","termination.site_type","termination.loop_start","termination.source_call","termination.element_calls","termination.var_types","termination.analyze_with","termination.structural","termination.passes_itself","verify_program","termination.analyze","search_invariants","build_proofs","verify_file","live_edit_command","alongside_command","smt_file","termination_file","static_graph","edit_file","apply_edit","fix_loops","run_command","build_command","command_line","std_proofs","verify_command","strata_command","graph_command","graph_diff","repl_command","edit_command","edit_in_editor","new_command","fix_command","main","std_library","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","check_command","test_command","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","build_core_command","comptime_value","literal_errors_of","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","comptime_values","loaded_check","file_errors","edit_errors","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","apply_change","with_base","package_errors","rename_command","move_command"],"module":"termination","text":"/// The type of `e`, as far as the code says it: a variable by its type in\n/// `env`, a call of a function of the program whose result\n/// type names none of its type parameters, a record built by name, or a\n/// field of a record.\nfn expr_type(\n  ctx: termination.Ctx,\n  env: Dict[String, ast.TypeExpr],\n  e: ast.Expr,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0 {\n    return None\n  }\n  match e {\n    ast.Var(n) => get(env, n),\n    ast.Call { callee: ast.Var(g), .. } => match get(ctx.fns, g) {\n      Some(d) => if termination.names_any(d.ret, d.type_params + [\"Self\"]) {\n        None\n      } else {\n        Some(d.ret)\n      },\n      None => None,\n    },\n    ast.CtorExpr { name, .. } => match get(ctx.types, name) {\n      Some(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          Some(ast.Named { name, args: [] })\n        } else {\n          None\n        },\n        _ => None,\n      },\n      None => None,\n    },\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, env, base, fuel - 1) {\n      Some(t) => termination.field_type(ctx, t, name),\n      None => None,\n    },\n    _ => None,\n  }\n}","old_text":"/// The type of `e` in `f`, as far as the code says it: a variable\n/// (`binding_type`), a call of a function of the program whose result\n/// type names none of its type parameters, a record built by name, or a\n/// field of a record.\nfn expr_type(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  e: ast.Expr,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0 {\n    return None\n  }\n  match e {\n    ast.Var(n) => termination.binding_type(ctx, f, n, fuel - 1),\n    ast.Call { callee: ast.Var(g), .. } => match get(ctx.fns, g) {\n      Some(d) => if termination.names_any(d.ret, d.type_params + [\"Self\"]) {\n        None\n      } else {\n        Some(d.ret)\n      },\n      None => None,\n    },\n    ast.CtorExpr { name, .. } => match get(ctx.types, name) {\n      Some(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          Some(ast.Named { name, args: [] })\n        } else {\n          None\n        },\n        _ => None,\n      },\n      None => None,\n    },\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, f, base, fuel - 1) {\n      Some(t) => termination.field_type(ctx, t, name),\n      None => None,\n    },\n    _ => None,\n  }\n}"},{"name":"termination.element_calls","kind":"fn","old":"4ab3210f49f31e38","new":"608ac9f288292dee","interface_changed":false,"affected":[],"module":"termination","text":"/// The calls in `f` of a builtin that calls its function argument, one of\n/// `names`, on elements of its list argument only (`args.any(has_gen)`):\n/// `any`, `all`, `map`, `filter`, `find` and `count` of a value whose type\n/// the code says is a `List`, where no function, method or trait method of\n/// the program has the name.\nfn element_calls(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  names: Set[String],\n) -> List[ast.Expr] {\n  list_of := (e: ast.Expr) ->\n    match e {\n      ast.MethodCall { recv, name, args: [ast.Var(v)] } => if contains(names, v) && termination.element_builtin(ctx, name) {\n        Some(recv)\n      } else {\n        None\n      },\n      ast.Call { callee: ast.Var(name), args: [xs, ast.Var(v)] } => if contains(names, v) && termination.element_builtin(ctx, name) {\n        Some(xs)\n      } else {\n        None\n      },\n      _ => None,\n    }\n  calls := termination.preorder(f.body).filter(e -> !(list_of(e) is None))\n  if calls == [] {\n    return []\n  }\n  env := termination.var_types(ctx, f)\n  calls.filter(\n    e -> match list_of(e) {\n      Some(xs) => termination.is_list(ctx, env, xs),\n      None => false,\n    },\n  )\n}","old_text":"/// The calls in `f` of a builtin that calls its function argument, one of\n/// `names`, on elements of its list argument only (`args.any(has_gen)`):\n/// `any`, `all`, `map`, `filter`, `find` and `count` of a value whose type\n/// the code says is a `List`, where no function, method or trait method of\n/// the program has the name.\nfn element_calls(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  names: Set[String],\n) -> List[ast.Expr] {\n  termination.preorder(f.body).filter(\n    e ->\n      match e {\n        ast.MethodCall { recv, name, args: [ast.Var(v)] } => contains(names, v)\n          && termination.element_builtin(ctx, name)\n          && termination.is_list(ctx, f, recv),\n        ast.Call { callee: ast.Var(name), args: [xs, ast.Var(v)] } => contains(names, v)\n          && termination.element_builtin(ctx, name)\n          && termination.is_list(ctx, f, xs),\n        _ => false,\n      },\n  )\n}"},{"name":"termination.is_list","kind":"fn","old":"3a130c830f5e3eca","new":"db5956cddedf7674","interface_changed":true,"affected":["termination.element_calls","termination.analyze_with","termination.structural","termination.passes_itself","verify_program","termination.analyze","search_invariants","build_proofs","verify_file","live_edit_command","alongside_command","smt_file","termination_file","static_graph","edit_file","apply_edit","fix_loops","run_command","build_command","command_line","std_proofs","verify_command","strata_command","graph_command","graph_diff","repl_command","edit_command","edit_in_editor","new_command","fix_command","main","std_library","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","check_command","test_command","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","build_core_command","comptime_value","literal_errors_of","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","comptime_values","loaded_check","file_errors","edit_errors","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","apply_change","with_base","package_errors","rename_command","move_command"],"module":"termination","text":"/// Whether the code says `e` is a `List`.\nfn is_list(\n  ctx: termination.Ctx,\n  env: Dict[String, ast.TypeExpr],\n  e: ast.Expr,\n) -> Bool {\n  match termination.expr_type(ctx, env, e, 8) {\n    Some(t) => termination.short(\n      termination.head(termination.expand_alias(ctx, t)),\n    ) == \"List\",\n    None => false,\n  }\n}","old_text":"/// Whether the code says `e`, in `f`, is a `List`.\nfn is_list(ctx: termination.Ctx, f: ast.FnDecl, e: ast.Expr) -> Bool {\n  match termination.expr_type(ctx, f, e, 6) {\n    Some(t) => termination.short(\n      termination.head(termination.expand_alias(ctx, t)),\n    ) == \"List\",\n    None => false,\n  }\n}"},{"name":"termination.Site","kind":"type","old":null,"new":"36cfbfe17176d85e","interface_changed":true,"affected":[],"module":"termination","text":"/// A place that binds a name, by what gives its type: a written type, an\n/// expression's type, the piece a pattern binds of a value (of the written\n/// type, else of the expression's), the piece a pattern binds of an element\n/// of a list or set, or nothing the code says.\ntype Site =\n  | SiteType(ast.TypeExpr)\n  | SiteOf(ast.Expr)\n  | SitePiece { pat: ast.Pattern, ty: Option[ast.TypeExpr], of: ast.Expr }\n  | SiteElem { pat: ast.Pattern, of: ast.Expr }\n  | SiteNone"},{"name":"termination.binding_sites","kind":"fn","old":null,"new":"d53b5d7571d4ea1e","interface_changed":true,"affected":[],"module":"termination","text":"/// Every place `f` binds each name: its parameters, `let`s, `mut`\n/// declarations, `for` and `comptime for` patterns, `match` arms and\n/// bindings, lambda parameters and `select` arms.\nfn binding_sites(f: ast.FnDecl) -> Dict[String, List[termination.Site]] {\n  mut by := Dict[String, List[termination.Site]] {}\n  for p in f.params {\n    termination.add_site(mut by, p.name, termination.SiteType(p.ty))\n  }\n  for x in termination.preorder(f.body) {\n    match x {\n      ast.Block { stmts, .. } => {\n        for s in stmts {\n          match s {\n            ast.Let { pat, ty, value } => {\n              for n in termination.pattern_binds(pat) {\n                termination.add_site(\n                  mut by,\n                  n,\n                  termination.SitePiece { pat, ty, of: value },\n                )\n              }\n            },\n            ast.VarDecl { name, ty, value } => termination.add_site(mut by, name, match ty {\n              Some(t) => termination.SiteType(t),\n              None => termination.SiteOf(value),\n            }),\n            ast.For { pat, iter, .. } => {\n              for n in termination.pattern_binds(pat) {\n                termination.add_site(\n                  mut by,\n                  n,\n                  termination.SiteElem { pat, of: iter },\n                )\n              }\n            },\n            ast.ComptimeFor { pat, .. } => {\n              for n in termination.pattern_binds(pat) {\n                termination.add_site(\n                  mut by,\n                  n,\n                  termination.SiteNone,\n                )\n              }\n            },\n            _ => (),\n          }\n        }\n      },\n      ast.MatchExpr { scrutinee, binding, arms } => {\n        match binding {\n          Some(b) => termination.add_site(\n            mut by,\n            b,\n            termination.SiteOf(scrutinee),\n          ),\n          None => (),\n        }\n        for a in arms {\n          for n in termination.pattern_binds(a.pat) {\n            termination.add_site(mut by, n, termination.SitePiece {\n              pat: a.pat,\n              ty: None,\n              of: scrutinee,\n            })\n          }\n        }\n      },\n      ast.Lambda { params, .. } => {\n        for p in params {\n          termination.add_site(mut by, p.name, match p.ty {\n            Some(t) => termination.SiteType(t),\n            None => termination.SiteNone,\n          })\n        }\n      },\n      ast.Select(arms) | ast.Race(arms) => {\n        for a in arms {\n          match a.name {\n            Some(b) => termination.add_site(mut by, b, termination.SiteNone),\n            None => (),\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  by\n}"},{"name":"termination.add_site","kind":"fn","old":null,"new":"46021264a4f9ad0e","interface_changed":true,"affected":[],"module":"termination","text":"fn add_site(\n  mut by: Dict[String, List[termination.Site]],\n  n: String,\n  s: termination.Site,\n) {\n  mut by.insert(n, (get(by, n) ?? []) + [s])\n}"},{"name":"termination.site_type","kind":"fn","old":null,"new":"51d2ddff42f2082b","interface_changed":true,"affected":[],"module":"termination","text":"/// The type a site gives the name `n`, with `env` the types known so far.\nfn site_type(\n  ctx: termination.Ctx,\n  env: Dict[String, ast.TypeExpr],\n  n: String,\n  s: termination.Site,\n) -> Option[ast.TypeExpr] {\n  of := (e: ast.Expr) -> termination.expr_type(ctx, env, e, 8)\n  match s {\n    termination.SiteType(t) => Some(t),\n    termination.SiteOf(e) => of(e),\n    termination.SitePiece { pat, ty, of: e } => match ty {\n      Some(t) => termination.pattern_type(ctx, pat, t, n, 8),\n      None => match of(e) {\n        Some(t) => termination.pattern_type(ctx, pat, t, n, 8),\n        None => None,\n      },\n    },\n    termination.SiteElem { pat, of: e } => match of(e) {\n      Some(t) => match termination.element_type(ctx, t) {\n        Some(el) => termination.pattern_type(ctx, pat, el, n, 8),\n        None => None,\n      },\n      None => None,\n    },\n    termination.SiteNone => None,\n  }\n}"},{"name":"termination.var_types","kind":"fn","old":null,"new":"71ec35bd36859531","interface_changed":true,"affected":[],"module":"termination","text":"/// The types of the variables of `f` the code says: a name has a type when\n/// every place `f` binds it gives one and they are the same. Found in\n/// rounds, each using the types found before it, until a round finds no\n/// more (at most 32).\nfn var_types(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n) -> Dict[String, ast.TypeExpr] {\n  sites := termination.binding_sites(f)\n  mut env := Dict[String, ast.TypeExpr] {}\n  for _ in 0..32 {\n    mut more := false\n    for (n, ss) in items(sites) {\n      if contains(env, n) {\n        continue\n      }\n      ts := ss.map(s -> termination.site_type(ctx, env, n, s))\n      match get(ts, 0) {\n        Some(Some(t)) => if ts.all(x -> x == Some(t)) {\n          mut env.insert(n, t)\n          more = true\n        },\n        _ => (),\n      }\n    }\n    if !more {\n      break\n    }\n  }\n  env\n}"},{"name":"termination.binding_type","kind":"fn","old":"224801ee9c785314","new":null,"interface_changed":true,"affected":[],"module":"termination","old_text":"/// The type of `n` in `f`, when every place `f` binds it says the same\n/// type: a parameter's type, a `let`'s or `mut` declaration's (written, or\n/// its value's), a lambda parameter's written type, the piece a `match` arm\n/// or a `let` pattern binds of the value matched, or an element of the list\n/// or set a `for` runs over. A `comptime for` or a `select` arm binding it\n/// says no type.\nfn binding_type(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  n: String,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0 {\n    return None\n  }\n  of := (x: ast.Expr) -> termination.expr_type(ctx, f, x, fuel - 1)\n  piece_of := (p: ast.Pattern, t: Option[ast.TypeExpr]) -> match t {\n    Some(u) => termination.pattern_type(ctx, p, u, n, 8),\n    None => None,\n  }\n  mut sites: List[Option[ast.TypeExpr]] = f.params.filter(p -> p.name == n).map(p -> Some(p.ty))\n  for x in termination.preorder(f.body) {\n    match x {\n      ast.Block { stmts, .. } => {\n        for s in stmts {\n          match s {\n            ast.Let { pat, ty, value } => if termination.pattern_binds(pat).contains(n) {\n              mut sites.push(\n                piece_of(pat, match ty {\n                  Some(t) => Some(t),\n                  None => of(value),\n                }),\n              )\n            },\n            ast.VarDecl { name, ty, value } => if name == n {\n              mut sites.push(\n                match ty {\n                  Some(t) => Some(t),\n                  None => of(value),\n                },\n              )\n            },\n            ast.For { pat, iter, .. } => if termination.pattern_binds(pat).contains(n) {\n              mut sites.push(\n                piece_of(pat, match of(iter) {\n                  Some(t) => termination.element_type(ctx, t),\n                  None => None,\n                }),\n              )\n            },\n            ast.ComptimeFor { pat, .. } => if termination.pattern_binds(pat).contains(n) {\n              mut sites.push(None)\n            },\n            _ => (),\n          }\n        }\n      },\n      ast.MatchExpr { scrutinee, binding, arms } => {\n        if binding == Some(n) {\n          mut sites.push(of(scrutinee))\n        }\n        for a in arms {\n          if termination.pattern_binds(a.pat).contains(n) {\n            mut sites.push(piece_of(a.pat, of(scrutinee)))\n          }\n        }\n      },\n      ast.Lambda { params, .. } => {\n        for p in params.filter(p -> p.name == n) {\n          mut sites.push(p.ty)\n        }\n      },\n      ast.Select(arms) | ast.Race(arms) => if arms.any(a -> a.name == Some(n)) {\n        mut sites.push(None)\n      },\n      _ => (),\n    }\n  }\n  match get(sites, 0) {\n    Some(Some(t)) => if sites.all(s -> s == Some(t)) {\n      Some(t)\n    } else {\n      None\n    },\n    _ => None,\n  }\n}"}]}
{"id":"668ee72263811ddf","time":1795826473,"message":"termination: judge each for and element call with the types in scope there","changes":[{"name":"termination.use walk","kind":"use","old":"643a8d89367a605f","new":"d584faacd10de63f","interface_changed":true,"affected":[],"module":"termination","text":"from walk use kids, pattern_kids, stmt_kids","old_text":"from walk use kids, pattern_kids"},{"name":"termination.loop_start","kind":"fn","old":"fa27fbec2338c577","new":"31b98aa408b1a4c2","interface_changed":false,"affected":[],"module":"termination","text":"/// A body's loops before the solver is asked anything. `Ok(how they end)`\n/// or `Err(why one may not)` when that is known already, else a search for\n/// the `while` bounds. `iterates`: whether it has a `for` over an iterator\n/// that is no list (compiled as calls of `next`).\nfn loop_start(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  label: String,\n  encoded: Dict[String, smt.Vc],\n  mut iterates: Bool,\n) -> termination.LoopSearch {\n  done := (r: Result[List[String], String]) -> termination.LoopSearch {\n    vc: ctx.base,\n    at: 0,\n    cand: 0,\n    hows: [],\n    result: Some(r),\n  }\n  ss := termination.statements(f.body)\n  has_for := ss.any(\n    s -> match s {\n      ast.For { .. } => true,\n      _ => false,\n    },\n  )\n  // (`loop { … }` is stored as `while true { … }`)\n  has_while := ss.any(\n    s -> match s {\n      ast.While { cond, .. } => cond != ast.BoolLit(true),\n      _ => false,\n    },\n  )\n  has_loop := ss.any(\n    s -> match s {\n      ast.While { cond: ast.BoolLit(true), .. } => true,\n      _ => false,\n    },\n  )\n  // a `loop` with no `decreases` clause (one with it is checked as a\n  // `while` loop)\n  bare_loop := ss.any(\n    s ->\n      match s {\n        ast.While { cond: ast.BoolLit(true), body } => text.decreases_of(body) == [],\n        _ => false,\n      },\n  )\n  measured := has_while || has_loop && !bare_loop\n  // what each `for` runs over, as far as the code says; a lazy `.map(..)`,\n  // `.filter(..)` or `.drop(n)` is judged here, as the encoder gives it as\n  // a list\n  lets := [x for st in ss for x in match st {\n    ast.Let { pat: ast.Bind(n), value, .. } => [(n, value)],\n    ast.VarDecl { name, value, .. } => [(name, value)],\n    _ => [],\n  }]\n  once := termination.bound_once(f)\n  fors := if has_for {\n    termination.in_scope(ctx, f, x -> false).fors\n  } else {\n    []\n  }\n  mut by_value := false\n  for (iter, env) in fors {\n    match termination.source_of(ctx, f, env, iter, lets, once, 8) {\n      termination.SourceLazy => return done(Err(termination.never_ends())),\n      termination.SourceUnknown(why) => return done(\n        Err(\n          \"it has a `for` over \"\n            + why\n            + \", which isn't known to end (only `for` loops over lists, sets, dicts and finite iterators, and `while` loops whose bound goes down, are shown to end)\",\n        ),\n      ),\n      termination.SourceByValue => {\n        by_value = true\n      },\n      termination.SourceFinite => (),\n    }\n  }\n  if !has_for && !has_while && !has_loop {\n    return done(Ok([]))\n  }\n  // the loops' invariants help show their bounds go down; without a\n  // solver none can be shown\n  if measured && !bare_loop && ctx.solver == \"\" {\n    return done(Err(\n      \"it has a `while` loop, and no SMT solver was found to check its bound\",\n    ))\n  }\n  vc := if measured {\n    get(encoded, label) or {\n      smt.encode(\n        mut commands,\n        mut files,\n        ctx.scratch,\n        ctx.solver,\n        ctx.fns,\n        ctx.types,\n        ctx.sigs,\n        ctx.methods,\n        f,\n        label,\n      )\n    }\n  } else if has_for {\n    get(encoded, label) or {\n      mut v := smt.new_vc(ctx.fns, ctx.types, ctx.sigs, ctx.methods)\n      smt.function(mut v, f, label)\n      v\n    }\n  } else {\n    smt.new_vc(ctx.fns, ctx.types, ctx.sigs, ctx.methods)\n  }\n  // a `for` over an `Iterator` is a `loop` calling `next`\n  iterates = vc.iter_fors.any(h -> h != \"\")\n  // (the encoder's value of each `for`'s iterator, for those the code\n  // doesn't say the type of)\n  if by_value && vc.iter_fors.any(h -> h == \"\") {\n    return done(\n      Err(\n        \"it has a `for` over a value whose type the prover doesn't model, which isn't known to end (only `for` loops over lists, sets, dicts and finite iterators, and `while` loops whose bound goes down, are shown to end)\",\n      ),\n    )\n  }\n  if by_value\n    && vc.iter_fors.any(\n      h -> h != \"\" && !termination.finite_iterator(ctx, h),\n    ) {\n    return done(Err(termination.never_ends()))\n  }\n  if bare_loop {\n    return done(\n      Err(\n        \"it has a `loop` without a `decreases` clause (only `for` loops, `while` loops whose bound goes down, and loops whose `decreases` measure goes down, are shown to end)\",\n      ),\n    )\n  }\n  if !measured {\n    return done(Ok([]))\n  }\n  termination.LoopSearch {\n    vc,\n    at: 0,\n    cand: 0,\n    hows: [],\n    result: None,\n  }\n}","old_text":"/// A body's loops before the solver is asked anything. `Ok(how they end)`\n/// or `Err(why one may not)` when that is known already, else a search for\n/// the `while` bounds. `iterates`: whether it has a `for` over an iterator\n/// that is no list (compiled as calls of `next`).\nfn loop_start(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  label: String,\n  encoded: Dict[String, smt.Vc],\n  mut iterates: Bool,\n) -> termination.LoopSearch {\n  done := (r: Result[List[String], String]) -> termination.LoopSearch {\n    vc: ctx.base,\n    at: 0,\n    cand: 0,\n    hows: [],\n    result: Some(r),\n  }\n  ss := termination.statements(f.body)\n  has_for := ss.any(\n    s -> match s {\n      ast.For { .. } => true,\n      _ => false,\n    },\n  )\n  // (`loop { … }` is stored as `while true { … }`)\n  has_while := ss.any(\n    s -> match s {\n      ast.While { cond, .. } => cond != ast.BoolLit(true),\n      _ => false,\n    },\n  )\n  has_loop := ss.any(\n    s -> match s {\n      ast.While { cond: ast.BoolLit(true), .. } => true,\n      _ => false,\n    },\n  )\n  // a `loop` with no `decreases` clause (one with it is checked as a\n  // `while` loop)\n  bare_loop := ss.any(\n    s ->\n      match s {\n        ast.While { cond: ast.BoolLit(true), body } => text.decreases_of(body) == [],\n        _ => false,\n      },\n  )\n  measured := has_while || has_loop && !bare_loop\n  // what each `for` runs over, as far as the code says; a lazy `.map(..)`,\n  // `.filter(..)` or `.drop(n)` is judged here, as the encoder gives it as\n  // a list\n  lets := [x for st in ss for x in match st {\n    ast.Let { pat: ast.Bind(n), value, .. } => [(n, value)],\n    ast.VarDecl { name, value, .. } => [(name, value)],\n    _ => [],\n  }]\n  once := termination.bound_once(f)\n  env := if has_for {\n    termination.var_types(ctx, f)\n  } else {\n    Dict[String, ast.TypeExpr] {}\n  }\n  mut by_value := false\n  for st in ss {\n    match st {\n      ast.For { iter, .. } => match termination.source_of(ctx, f, env, iter, lets, once, 8) {\n        termination.SourceLazy => return done(Err(termination.never_ends())),\n        termination.SourceUnknown(why) => return done(\n          Err(\n            \"it has a `for` over \"\n              + why\n              + \", which isn't known to end (only `for` loops over lists, sets, dicts and finite iterators, and `while` loops whose bound goes down, are shown to end)\",\n          ),\n        ),\n        termination.SourceByValue => {\n          by_value = true\n        },\n        termination.SourceFinite => (),\n      },\n      _ => (),\n    }\n  }\n  if !has_for && !has_while && !has_loop {\n    return done(Ok([]))\n  }\n  // the loops' invariants help show their bounds go down; without a\n  // solver none can be shown\n  if measured && !bare_loop && ctx.solver == \"\" {\n    return done(Err(\n      \"it has a `while` loop, and no SMT solver was found to check its bound\",\n    ))\n  }\n  vc := if measured {\n    get(encoded, label) or {\n      smt.encode(\n        mut commands,\n        mut files,\n        ctx.scratch,\n        ctx.solver,\n        ctx.fns,\n        ctx.types,\n        ctx.sigs,\n        ctx.methods,\n        f,\n        label,\n      )\n    }\n  } else if has_for {\n    get(encoded, label) or {\n      mut v := smt.new_vc(ctx.fns, ctx.types, ctx.sigs, ctx.methods)\n      smt.function(mut v, f, label)\n      v\n    }\n  } else {\n    smt.new_vc(ctx.fns, ctx.types, ctx.sigs, ctx.methods)\n  }\n  // a `for` over an `Iterator` is a `loop` calling `next`\n  iterates = vc.iter_fors.any(h -> h != \"\")\n  // (the encoder's value of each `for`'s iterator, for those the code\n  // doesn't say the type of)\n  if by_value && vc.iter_fors.any(h -> h == \"\") {\n    return done(\n      Err(\n        \"it has a `for` over a value whose type the prover doesn't model, which isn't known to end (only `for` loops over lists, sets, dicts and finite iterators, and `while` loops whose bound goes down, are shown to end)\",\n      ),\n    )\n  }\n  if by_value\n    && vc.iter_fors.any(\n      h -> h != \"\" && !termination.finite_iterator(ctx, h),\n    ) {\n    return done(Err(termination.never_ends()))\n  }\n  if bare_loop {\n    return done(\n      Err(\n        \"it has a `loop` without a `decreases` clause (only `for` loops, `while` loops whose bound goes down, and loops whose `decreases` measure goes down, are shown to end)\",\n      ),\n    )\n  }\n  if !measured {\n    return done(Ok([]))\n  }\n  termination.LoopSearch {\n    vc,\n    at: 0,\n    cand: 0,\n    hows: [],\n    result: None,\n  }\n}"},{"name":"termination.expr_type","kind":"fn","old":"ff140ec16cb7c7dc","new":"d064f38d17330404","interface_changed":false,"affected":[],"module":"termination","text":"/// The type of `e`, as far as the code says it: a variable by its type in\n/// `env`, a call of a function of the program whose result\n/// type names none of its type parameters, a record built by name, a\n/// field of a record, or a tuple of those.\nfn expr_type(\n  ctx: termination.Ctx,\n  env: Dict[String, ast.TypeExpr],\n  e: ast.Expr,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0 {\n    return None\n  }\n  match e {\n    ast.Var(n) => get(env, n),\n    ast.Call { callee: ast.Var(g), .. } => match get(ctx.fns, g) {\n      Some(d) => if termination.names_any(d.ret, d.type_params + [\"Self\"]) {\n        None\n      } else {\n        Some(d.ret)\n      },\n      None => None,\n    },\n    ast.CtorExpr { name, .. } => match get(ctx.types, name) {\n      Some(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          Some(ast.Named { name, args: [] })\n        } else {\n          None\n        },\n        _ => None,\n      },\n      None => None,\n    },\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, env, base, fuel - 1) {\n      Some(t) => termination.field_type(ctx, t, name),\n      None => None,\n    },\n    ast.TupleExpr(es) => {\n      ts := es.map(x -> termination.expr_type(ctx, env, x, fuel - 1))\n      if ts.all(t -> !(t is None)) {\n        Some(ast.Named {\n          name: \"Tuple\",\n          args: ts.map(t -> t ?? ast.UnitType),\n        })\n      } else {\n        None\n      }\n    },\n    _ => None,\n  }\n}","old_text":"/// The type of `e`, as far as the code says it: a variable by its type in\n/// `env`, a call of a function of the program whose result\n/// type names none of its type parameters, a record built by name, or a\n/// field of a record.\nfn expr_type(\n  ctx: termination.Ctx,\n  env: Dict[String, ast.TypeExpr],\n  e: ast.Expr,\n  fuel: Int,\n) -> Option[ast.TypeExpr] {\n  if fuel <= 0 {\n    return None\n  }\n  match e {\n    ast.Var(n) => get(env, n),\n    ast.Call { callee: ast.Var(g), .. } => match get(ctx.fns, g) {\n      Some(d) => if termination.names_any(d.ret, d.type_params + [\"Self\"]) {\n        None\n      } else {\n        Some(d.ret)\n      },\n      None => None,\n    },\n    ast.CtorExpr { name, .. } => match get(ctx.types, name) {\n      Some(td) => match td.body {\n        ast.RecordBody(_) => if td.params == [] {\n          Some(ast.Named { name, args: [] })\n        } else {\n          None\n        },\n        _ => None,\n      },\n      None => None,\n    },\n    ast.FieldOf { base, name } => match termination.expr_type(ctx, env, base, fuel - 1) {\n      Some(t) => termination.field_type(ctx, t, name),\n      None => None,\n    },\n    _ => None,\n  }\n}"},{"name":"termination.element_calls","kind":"fn","old":"608ac9f288292dee","new":"b940dc29ddb03d01","interface_changed":false,"affected":[],"module":"termination","text":"/// The calls in `f` of a builtin that calls its function argument, one of\n/// `names`, on elements of its list argument only (`args.any(has_gen)`):\n/// `any`, `all`, `map`, `filter`, `find` and `count` of a value whose type\n/// the code says is a `List`, where no function, method or trait method of\n/// the program has the name.\nfn element_calls(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  names: Set[String],\n) -> List[ast.Expr] {\n  list_of := (e: ast.Expr) ->\n    match e {\n      ast.MethodCall { recv, name, args: [ast.Var(v)] } => if contains(names, v) && termination.element_builtin(ctx, name) {\n        Some(recv)\n      } else {\n        None\n      },\n      ast.Call { callee: ast.Var(name), args: [xs, ast.Var(v)] } => if contains(names, v) && termination.element_builtin(ctx, name) {\n        Some(xs)\n      } else {\n        None\n      },\n      _ => None,\n    }\n  if termination.preorder(f.body).all(e -> list_of(e) is None) {\n    return []\n  }\n  termination.in_scope(ctx, f, e -> !(list_of(e) is None)).picked\n    .filter(x -> match list_of(x.0) {\n      Some(xs) => termination.is_list(ctx, x.1, xs),\n      None => false,\n    })\n    .map(x -> x.0)\n}","old_text":"/// The calls in `f` of a builtin that calls its function argument, one of\n/// `names`, on elements of its list argument only (`args.any(has_gen)`):\n/// `any`, `all`, `map`, `filter`, `find` and `count` of a value whose type\n/// the code says is a `List`, where no function, method or trait method of\n/// the program has the name.\nfn element_calls(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  names: Set[String],\n) -> List[ast.Expr] {\n  list_of := (e: ast.Expr) ->\n    match e {\n      ast.MethodCall { recv, name, args: [ast.Var(v)] } => if contains(names, v) && termination.element_builtin(ctx, name) {\n        Some(recv)\n      } else {\n        None\n      },\n      ast.Call { callee: ast.Var(name), args: [xs, ast.Var(v)] } => if contains(names, v) && termination.element_builtin(ctx, name) {\n        Some(xs)\n      } else {\n        None\n      },\n      _ => None,\n    }\n  calls := termination.preorder(f.body).filter(e -> !(list_of(e) is None))\n  if calls == [] {\n    return []\n  }\n  env := termination.var_types(ctx, f)\n  calls.filter(\n    e -> match list_of(e) {\n      Some(xs) => termination.is_list(ctx, env, xs),\n      None => false,\n    },\n  )\n}"},{"name":"termination.Scoped","kind":"type","old":null,"new":"388ba1a32121ffc9","interface_changed":true,"affected":[],"module":"termination","text":"/// What a walk of a body in scope order finds: the iterator of each `for`\n/// and each expression picked, with the types of the variables in scope\n/// there that the code says.\ntype Scoped = {\n  fors: List[(ast.Expr, Dict[String, ast.TypeExpr])],\n  picked: List[(ast.Expr, Dict[String, ast.TypeExpr])],\n}"},{"name":"termination.in_scope","kind":"fn","old":null,"new":"f4484baca9eefb71","interface_changed":true,"affected":[],"module":"termination","text":"/// The `for` iterators and the expressions `pick` chooses in `f`'s body,\n/// each with the types of the variables in scope there (`scope_walk`).\nfn in_scope(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n  pick: (ast.Expr) -> Bool,\n) -> termination.Scoped {\n  mut env := Dict[String, ast.TypeExpr] {}\n  for p in f.params {\n    mut env.insert(p.name, p.ty)\n  }\n  mut out := termination.Scoped { fors: [], picked: [] }\n  termination.scope_walk(ctx, mut out, f.body, env, pick)\n  out\n}"},{"name":"termination.bind_site","kind":"fn","old":null,"new":"68ce4fecfb3b322f","interface_changed":true,"affected":[],"module":"termination","text":"/// `env` with the names `p` binds, each with the type `s` gives it, or\n/// with no type (so an outer one is hidden).\nfn bind_site(\n  ctx: termination.Ctx,\n  env: Dict[String, ast.TypeExpr],\n  p: ast.Pattern,\n  s: termination.Site,\n) -> Dict[String, ast.TypeExpr] {\n  mut out := env\n  for n in termination.pattern_binds(p) {\n    match termination.site_type(ctx, env, n, s) {\n      Some(t) => mut out.insert(n, t),\n      None => mut out.remove(n),\n    }\n  }\n  out\n}"},{"name":"termination.scope_walk","kind":"fn","old":null,"new":"96ca1efb8e474c35","interface_changed":true,"affected":[],"module":"termination","text":"/// Walks `e` with `env` the types of the variables in scope, each binding\n/// replacing or hiding the one before.\nfn scope_walk(\n  ctx: termination.Ctx,\n  mut out: termination.Scoped,\n  e: ast.Expr,\n  env: Dict[String, ast.TypeExpr],\n  pick: (ast.Expr) -> Bool,\n) {\n  if pick(e) {\n    mut out.picked.push((e, env))\n  }\n  match e {\n    ast.Block { stmts, last } => {\n      mut v := env\n      for s in stmts {\n        match s {\n          ast.Let { pat, ty, value } => {\n            termination.scope_walk(ctx, mut out, value, v, pick)\n            v = termination.bind_site(\n              ctx,\n              v,\n              pat,\n              termination.SitePiece { pat, ty, of: value },\n            )\n          },\n          ast.VarDecl { name, ty, value } => {\n            termination.scope_walk(ctx, mut out, value, v, pick)\n            v = termination.bind_site(ctx, v, ast.Bind(name), match ty {\n              Some(t) => termination.SiteType(t),\n              None => termination.SiteOf(value),\n            })\n          },\n          ast.For { pat, iter, body } => {\n            termination.scope_walk(ctx, mut out, iter, v, pick)\n            mut out.fors.push((iter, v))\n            termination.scope_walk(\n              ctx,\n              mut out,\n              body,\n              termination.bind_site(\n                ctx,\n                v,\n                pat,\n                termination.SiteElem { pat, of: iter },\n              ),\n              pick,\n            )\n          },\n          ast.ComptimeFor { pat, iter, body } => {\n            termination.scope_walk(ctx, mut out, iter, v, pick)\n            termination.scope_walk(\n              ctx,\n              mut out,\n              body,\n              termination.bind_site(\n                ctx,\n                v,\n                pat,\n                termination.SiteNone,\n              ),\n              pick,\n            )\n          },\n          other => {\n            for k in walk.stmt_kids(other) {\n              termination.scope_walk(ctx, mut out, k, v, pick)\n            }\n          },\n        }\n      }\n      termination.scope_walk(ctx, mut out, last, v, pick)\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      termination.scope_walk(ctx, mut out, scrutinee, env, pick)\n      mut v := env\n      match binding {\n        Some(b) => {\n          v = termination.bind_site(\n            ctx,\n            v,\n            ast.Bind(b),\n            termination.SiteOf(scrutinee),\n          )\n        },\n        None => (),\n      }\n      for a in arms {\n        va := termination.bind_site(ctx, v, a.pat, termination.SitePiece {\n          pat: a.pat,\n          ty: None,\n          of: scrutinee,\n        })\n        for k in walk.pattern_kids(a.pat) {\n          termination.scope_walk(ctx, mut out, k, va, pick)\n        }\n        termination.scope_walk(ctx, mut out, a.body, va, pick)\n      }\n    },\n    ast.Lambda { params, body } => {\n      mut v := env\n      for p in params {\n        match p.ty {\n          Some(t) => mut v.insert(p.name, t),\n          None => mut v.remove(p.name),\n        }\n      }\n      termination.scope_walk(ctx, mut out, body, v, pick)\n    },\n    ast.Select(arms) | ast.Race(arms) => {\n      for a in arms {\n        termination.scope_walk(ctx, mut out, a.op, env, pick)\n        mut v := env\n        match a.name {\n          Some(b) => mut v.remove(b),\n          None => (),\n        }\n        termination.scope_walk(ctx, mut out, a.body, v, pick)\n      }\n    },\n    _ => {\n      for k in walk.kids(e) {\n        termination.scope_walk(ctx, mut out, k, env, pick)\n      }\n    },\n  }\n}"},{"name":"termination.binding_sites","kind":"fn","old":"d53b5d7571d4ea1e","new":null,"interface_changed":true,"affected":[],"module":"termination","old_text":"/// Every place `f` binds each name: its parameters, `let`s, `mut`\n/// declarations, `for` and `comptime for` patterns, `match` arms and\n/// bindings, lambda parameters and `select` arms.\nfn binding_sites(f: ast.FnDecl) -> Dict[String, List[termination.Site]] {\n  mut by := Dict[String, List[termination.Site]] {}\n  for p in f.params {\n    termination.add_site(mut by, p.name, termination.SiteType(p.ty))\n  }\n  for x in termination.preorder(f.body) {\n    match x {\n      ast.Block { stmts, .. } => {\n        for s in stmts {\n          match s {\n            ast.Let { pat, ty, value } => {\n              for n in termination.pattern_binds(pat) {\n                termination.add_site(\n                  mut by,\n                  n,\n                  termination.SitePiece { pat, ty, of: value },\n                )\n              }\n            },\n            ast.VarDecl { name, ty, value } => termination.add_site(mut by, name, match ty {\n              Some(t) => termination.SiteType(t),\n              None => termination.SiteOf(value),\n            }),\n            ast.For { pat, iter, .. } => {\n              for n in termination.pattern_binds(pat) {\n                termination.add_site(\n                  mut by,\n                  n,\n                  termination.SiteElem { pat, of: iter },\n                )\n              }\n            },\n            ast.ComptimeFor { pat, .. } => {\n              for n in termination.pattern_binds(pat) {\n                termination.add_site(\n                  mut by,\n                  n,\n                  termination.SiteNone,\n                )\n              }\n            },\n            _ => (),\n          }\n        }\n      },\n      ast.MatchExpr { scrutinee, binding, arms } => {\n        match binding {\n          Some(b) => termination.add_site(\n            mut by,\n            b,\n            termination.SiteOf(scrutinee),\n          ),\n          None => (),\n        }\n        for a in arms {\n          for n in termination.pattern_binds(a.pat) {\n            termination.add_site(mut by, n, termination.SitePiece {\n              pat: a.pat,\n              ty: None,\n              of: scrutinee,\n            })\n          }\n        }\n      },\n      ast.Lambda { params, .. } => {\n        for p in params {\n          termination.add_site(mut by, p.name, match p.ty {\n            Some(t) => termination.SiteType(t),\n            None => termination.SiteNone,\n          })\n        }\n      },\n      ast.Select(arms) | ast.Race(arms) => {\n        for a in arms {\n          match a.name {\n            Some(b) => termination.add_site(mut by, b, termination.SiteNone),\n            None => (),\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  by\n}"},{"name":"termination.add_site","kind":"fn","old":"46021264a4f9ad0e","new":null,"interface_changed":true,"affected":[],"module":"termination","old_text":"fn add_site(\n  mut by: Dict[String, List[termination.Site]],\n  n: String,\n  s: termination.Site,\n) {\n  mut by.insert(n, (get(by, n) ?? []) + [s])\n}"},{"name":"termination.var_types","kind":"fn","old":"71ec35bd36859531","new":null,"interface_changed":true,"affected":[],"module":"termination","old_text":"/// The types of the variables of `f` the code says: a name has a type when\n/// every place `f` binds it gives one and they are the same. Found in\n/// rounds, each using the types found before it, until a round finds no\n/// more (at most 32).\nfn var_types(\n  ctx: termination.Ctx,\n  f: ast.FnDecl,\n) -> Dict[String, ast.TypeExpr] {\n  sites := termination.binding_sites(f)\n  mut env := Dict[String, ast.TypeExpr] {}\n  for _ in 0..32 {\n    mut more := false\n    for (n, ss) in items(sites) {\n      if contains(env, n) {\n        continue\n      }\n      ts := ss.map(s -> termination.site_type(ctx, env, n, s))\n      match get(ts, 0) {\n        Some(Some(t)) => if ts.all(x -> x == Some(t)) {\n          mut env.insert(n, t)\n          more = true\n        },\n        _ => (),\n      }\n    }\n    if !more {\n      break\n    }\n  }\n  env\n}"}]}
{"id":"a01b643c51005651","time":1795826766,"message":"smt.BuiltinSig: the parameters' types","changes":[{"name":"smt.BuiltinSig","kind":"type","old":"044b89f71a9228cc","new":"16e018299d66ed6c","interface_changed":true,"affected":["verified_with","verified_decls","verified_program","smt.Vc","smt.encode","smt.new_vc","smt.builtins_of","smt.elaborated","smt.elaborate_call","smt.elaborate_plain","smt.encode_all","smt.encode_answered","smt.encode_rounds","smt.inputs","smt.encode_solving","termination.Ctx","termination.context","verify_program","build_command","static_graph","smt_file","termination_file","solved_together","solved_with","check_fn","lemma_verdict","loop_hint","graph_answers_all","smt.solve","smt.batch","smt.leaves","smt.leaves_of","smt.list_info","smt.str_names","smt.word","smt.fact_table","smt.part","smt.structured","smt.expand_alias","smt.shape","smt.fresh","smt.bits","smt.as_int","smt.union_as","smt.fresh_why","smt.why","smt.cone","smt.cone_with","smt.cone_in","smt.changed","smt.val_type","smt.rec_type","smt.elem_type","smt.eval","smt.eval_expr","smt.try_value","smt.real_record","smt.ctor","smt.gap","smt.variants_of","smt.ordered","smt.refined","smt.trait_invariants","smt.refined_walk","smt.start_goal","smt.check_type","smt.pred","smt.pred_old","smt.unknown_bool","smt.as_bool","smt.force","smt.unfold","smt.sort_of","smt.sort_type","smt.flatten_all","smt.flatten_union","smt.new_datatype","smt.set_datatype","smt.opaque_sort","smt.union_groups","smt.type_key","smt.field_sort","smt.real_key","smt.map_sorts","smt.ctors_of","smt.from_term","smt.define","smt.define_at","smt.local_fact","smt.made_here","smt.new_list","smt.positional","smt.keyed_array","smt.keyed_list","smt.valid_term","smt.erased","smt.valid_by_construction","smt.define_valid","smt.body","smt.body_with","smt.body_in","smt.stated_in","smt.share","smt.ob_lines","smt.check_type_at","smt.is_alias","smt.in_type","smt.shape_test","smt.key_test","smt.list_valid","smt.valid_known","smt.all_of","smt.list