n.interp","codegen.logic","codegen.destructure","codegen.loop_body","codegen.for_loop","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.call_entry","codegen.type_check","codegen.if_want","codegen.tag_test","codegen.compared","codegen.decreases_pass","codegen.decreases_call","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.function","codegen.declare","codegen.block_expr","codegen.call_fn_want","codegen.scope_expr","codegen.channel_new","codegen.lambda_shown","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.union_call","codegen.iterate","codegen.decreases_start","codegen.decreases_entry","codegen.binds","codegen.foreign_call","codegen.check_type","codegen.try_expr","codegen.get_field","codegen.assertion","codegen.invariants","codegen.satisfies","codegen.holds_pred","codegen.if_expr","codegen.compiled_alone","codegen.call_fn","codegen.regex_matches","codegen.by_variant","codegen.function_value","codegen.lambda","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.check_field","codegen.assign_at","codegen.check_union","codegen.check_member","codegen.show","codegen.shown","codegen.string_builtin","codegen.host","codegen.spawn_expr","codegen.method_value","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","codegen.read_back","eval_files","codegen.helper","codegen.debug_body","codegen.equal","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// A record, sum or alias: a variant picked at random (the one with the\n/// fewest fields once deep), retried until its refinement holds.\nfn gen_data(\n  mut g: codegen.Gen,\n  t: ast.TypeExpr,\n  n: String,\n  args: List[ast.TypeExpr],\n  ty: check.Ty,\n) -> codegen.V {\n  owner := match get(g.types.ctors, n) {\n    Some(sh) => sh.owner,\n    None => n,\n  }\n  mut variants := []\n  for (c, sh) in g.types.ctors {\n    if sh.owner == owner && (c == n || n == owner) {\n      mut variants.push((c, sh))\n    }\n  }\n  if len(variants) == 0 {\n    codegen.not_yet(\n      mut g,\n      \"generating a value of `\" + text.type_text(t) + \"`\",\n    )\n    return codegen.never()\n  }\n  // in the sum's declaration order\n  mut variants.sort_by(v -> get(g.variant_index, v.0) ?? 0)\n  mut targs := []\n  for a in args {\n    mut targs.push(codegen.lower(mut g, a))\n  }\n  // a `distinct` type's inner value is made within its refinement (a string\n  // matching its regex), and the refinement is checked on that inner value\n  // (`it`, as construction checks it), not on the block holding it\n  distinct := contains(g.distincts, owner)\n  inner_ok := codegen.fresh(mut g, \"inner.ok\")\n  if distinct {\n    mut g.allocas.push(f\"  {inner_ok} = alloca i1\")\n  }\n  fh := if distinct {\n    match get(g.refines, owner) {\n      Some((_, p)) => codegen.hints_and(codegen.no_hints(), p),\n      None => codegen.no_hints(),\n    }\n  } else {\n    codegen.no_hints()\n  }\n  (head, fail) := codegen.tries_start(mut g, 300)\n  mut smallest := 0\n  for (k, v) in enumerate(variants) {\n    if len(v.1.fields) < len((get(variants, smallest) ?? v).1.fields) {\n      smallest = k\n    }\n  }\n  deep := codegen.too_deep(mut g)\n  (any, which) := (codegen.fresh(mut g, \"any\"), codegen.fresh(mut g, \"which\"))\n  codegen.use_rt(mut g, \"strata_random\")\n  codegen.emit(\n    mut g,\n    f\"{any} = call i64 @strata_random(i64 0, i64 {len(variants) - 1})\",\n  )\n  codegen.emit(\n    mut g,\n    f\"{which} = select i1 {deep}, i64 {smallest}, i64 {any}\",\n  )\n  slot := codegen.fresh(mut g, \"made\")\n  mut g.allocas.push(f\"  {slot} = alloca ptr\")\n  end := codegen.label(mut g, \"made.end\")\n  mut labels := []\n  for _ in variants {\n    mut labels.push(codegen.label(mut g, \"variant\"))\n  }\n  cases := join(enumerate(labels).map(x -> f\"i64 {x.0}, label %{x.1}\"), \" \")\n  codegen.emit(\n    mut g,\n    f\"switch i64 {which}, label %{get(labels, 0) ?? \"\"} [ {cases} ]\",\n  )\n  for (k, v) in enumerate(variants) {\n    codegen.block(mut g, get(labels, k) ?? \"\")\n    (c, sh) := v\n    sub := codegen.pairs_of(sh.params, targs)\n    b := if len(sh.fields) == 0 {\n      codegen.nullary(mut g, c)\n    } else {\n      codegen.push_scope(mut g)\n      d := codegen.deeper(mut g)\n      mut vs := []\n      for (fi, f) in enumerate(sh.fields) {\n        ft := check.inst(f.1, sub)\n        // a positional field by its index\n        fkey := if f.0 == \"\" {\n          to_string(fi)\n        } else {\n          f.0\n        }\n        // as written, with the type's arguments substituted: `Option[Pos]`'s\n        // `Some.0` is a `Pos`\n        fe := match get(g.field_types, c + \".\" + fkey) {\n          Some(x) => if len(sh.params) == len(args) {\n            codegen.written_in(x, sh.params, args)\n          } else {\n            x\n          },\n          None => codegen.written_of(ft),\n        }\n        x := codegen.generated(mut g, fe, fh, d)\n        if distinct {\n          ok := codegen.satisfies(\n            mut g,\n            t,\n            codegen.V { ty: ft, op: x.op },\n          )\n          codegen.emit(mut g, f\"store i1 {ok}, ptr {inner_ok}\")\n        }\n        mut vs.push(codegen.temp(mut g, codegen.V { ty: ft, op: x.op }))\n      }\n      p := codegen.block_of(mut g, get(g.tags, c) ?? 0, vs)\n      codegen.pop_scope(mut g)\n      p\n    }\n    codegen.emit(mut g, f\"store ptr {b}, ptr {slot}\")\n    codegen.br(mut g, end)\n  }\n  codegen.block(mut g, end)\n  r := codegen.fresh(mut g, \"v\")\n  codegen.emit(mut g, f\"{r} = load ptr, ptr {slot}\")\n  x := codegen.V { ty, op: r }\n  ok := if distinct {\n    o := codegen.fresh(mut g, \"ok\")\n    codegen.emit(mut g, f\"{o} = load i1, ptr {inner_ok}\")\n    o\n  } else {\n    codegen.satisfies(mut g, t, x)\n  }\n  codegen.tries_end(\n    mut g,\n    x,\n    ok,\n    head,\n    fail,\n    f\"could not generate a value satisfying `{text.type_text(t)}` after 300 attempts\",\n  )\n  x\n}","old_text":"/// A record, sum or alias: a variant picked at random (the one with the\n/// fewest fields once deep), retried until its refinement holds.\nfn gen_data(\n  mut g: codegen.Gen,\n  t: ast.TypeExpr,\n  n: String,\n  args: List[ast.TypeExpr],\n  ty: Ty,\n) -> codegen.V {\n  owner := match get(g.types.ctors, n) {\n    Some(sh) => sh.owner,\n    None => n,\n  }\n  mut variants := []\n  for (c, sh) in g.types.ctors {\n    if sh.owner == owner && (c == n || n == owner) {\n      mut variants.push((c, sh))\n    }\n  }\n  if len(variants) == 0 {\n    codegen.not_yet(\n      mut g,\n      \"generating a value of `\" + text.type_text(t) + \"`\",\n    )\n    return codegen.never()\n  }\n  // in the sum's declaration order\n  mut variants.sort_by(v -> get(g.variant_index, v.0) ?? 0)\n  mut targs := []\n  for a in args {\n    mut targs.push(codegen.lower(mut g, a))\n  }\n  // a `distinct` type's inner value is made within its refinement (a string\n  // matching its regex), and the refinement is checked on that inner value\n  // (`it`, as construction checks it), not on the block holding it\n  distinct := contains(g.distincts, owner)\n  inner_ok := codegen.fresh(mut g, \"inner.ok\")\n  if distinct {\n    mut g.allocas.push(f\"  {inner_ok} = alloca i1\")\n  }\n  fh := if distinct {\n    match get(g.refines, owner) {\n      Some((_, p)) => codegen.hints_and(codegen.no_hints(), p),\n      None => codegen.no_hints(),\n    }\n  } else {\n    codegen.no_hints()\n  }\n  (head, fail) := codegen.tries_start(mut g, 300)\n  mut smallest := 0\n  for (k, v) in enumerate(variants) {\n    if len(v.1.fields) < len((get(variants, smallest) ?? v).1.fields) {\n      smallest = k\n    }\n  }\n  deep := codegen.too_deep(mut g)\n  (any, which) := (codegen.fresh(mut g, \"any\"), codegen.fresh(mut g, \"which\"))\n  codegen.use_rt(mut g, \"strata_random\")\n  codegen.emit(\n    mut g,\n    f\"{any} = call i64 @strata_random(i64 0, i64 {len(variants) - 1})\",\n  )\n  codegen.emit(\n    mut g,\n    f\"{which} = select i1 {deep}, i64 {smallest}, i64 {any}\",\n  )\n  slot := codegen.fresh(mut g, \"made\")\n  mut g.allocas.push(f\"  {slot} = alloca ptr\")\n  end := codegen.label(mut g, \"made.end\")\n  mut labels := []\n  for _ in variants {\n    mut labels.push(codegen.label(mut g, \"variant\"))\n  }\n  cases := join(enumerate(labels).map(x -> f\"i64 {x.0}, label %{x.1}\"), \" \")\n  codegen.emit(\n    mut g,\n    f\"switch i64 {which}, label %{get(labels, 0) ?? \"\"} [ {cases} ]\",\n  )\n  for (k, v) in enumerate(variants) {\n    codegen.block(mut g, get(labels, k) ?? \"\")\n    (c, sh) := v\n    sub := codegen.pairs_of(sh.params, targs)\n    b := if len(sh.fields) == 0 {\n      codegen.nullary(mut g, c)\n    } else {\n      codegen.push_scope(mut g)\n      d := codegen.deeper(mut g)\n      mut vs := []\n      for (fi, f) in enumerate(sh.fields) {\n        ft := inst(f.1, sub)\n        // a positional field by its index\n        fkey := if f.0 == \"\" {\n          to_string(fi)\n        } else {\n          f.0\n        }\n        // as written, with the type's arguments substituted: `Option[Pos]`'s\n        // `Some.0` is a `Pos`\n        fe := match get(g.field_types, c + \".\" + fkey) {\n          Some(x) => if len(sh.params) == len(args) {\n            codegen.written_in(x, sh.params, args)\n          } else {\n            x\n          },\n          None => codegen.written_of(ft),\n        }\n        x := codegen.generated(mut g, fe, fh, d)\n        if distinct {\n          ok := codegen.satisfies(\n            mut g,\n            t,\n            codegen.V { ty: ft, op: x.op },\n          )\n          codegen.emit(mut g, f\"store i1 {ok}, ptr {inner_ok}\")\n        }\n        mut vs.push(codegen.temp(mut g, codegen.V { ty: ft, op: x.op }))\n      }\n      p := codegen.block_of(mut g, get(g.tags, c) ?? 0, vs)\n      codegen.pop_scope(mut g)\n      p\n    }\n    codegen.emit(mut g, f\"store ptr {b}, ptr {slot}\")\n    codegen.br(mut g, end)\n  }\n  codegen.block(mut g, end)\n  r := codegen.fresh(mut g, \"v\")\n  codegen.emit(mut g, f\"{r} = load ptr, ptr {slot}\")\n  x := codegen.V { ty, op: r }\n  ok := if distinct {\n    o := codegen.fresh(mut g, \"ok\")\n    codegen.emit(mut g, f\"{o} = load i1, ptr {inner_ok}\")\n    o\n  } else {\n    codegen.satisfies(mut g, t, x)\n  }\n  codegen.tries_end(\n    mut g,\n    x,\n    ok,\n    head,\n    fail,\n    f\"could not generate a value satisfying `{text.type_text(t)}` after 300 attempts\",\n  )\n  x\n}"},{"name":"codegen.pairs_of","kind":"fn","old":"6f6e2fcecd89aa48","new":"282ab2b8b840e56f","interface_changed":true,"affected":["codegen.gen_data","codegen.produce","codegen.gen_fn","codegen.generated","codegen.can_generate","codegen.gen_list","codegen.mock_method","codegen.fuzz_driver","codegen.built_or_generated","codegen.generated_args","codegen.makers","codegen.vtable","codegen.mock_table","codegen.mock_call","codegen.generate","codegen.build_fn","codegen.to_dyn","codegen.dyn_table_is","codegen.mock_value","codegen.method_call","codegen_with","core_rt