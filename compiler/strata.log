gen.hash_fields"],"module":"codegen","text":"/// A variable at an existing slot (a `mut` parameter's).\nfn local_at(mut g: codegen.Gen, name: String, t: check.Ty, slot: String) {\n  k := codegen.var_scope(g)\n  s := get(g.scopes, k) ?? codegen.no_scope()\n  codegen.set_scope(mut g, k, codegen.Scope { ..s, vars: {\n    mut copy := s.vars\n    mut copy.insert(name, codegen.Local { slot, ty: t })\n    copy\n  } })\n}","old_text":"/// A variable at an existing slot (a `mut` parameter's).\nfn local_at(mut g: codegen.Gen, name: String, t: Ty, slot: String) {\n  k := codegen.var_scope(g)\n  s := get(g.scopes, k) ?? codegen.no_scope()\n  codegen.set_scope(mut g, k, codegen.Scope { ..s, vars: {\n    mut copy := s.vars\n    mut copy.insert(name, codegen.Local { slot, ty: t })\n    copy\n  } })\n}"},{"name":"codegen.union_ty","kind":"fn","old":"4516d19f8f9a9ed2","new":"b453781021c680df","interface_changed":true,"affected":["codegen.lower","codegen.list_literal_of","codegen.entry","codegen.function","codegen.declare","codegen.destructure","codegen.scheme","codegen.method_call","codegen.vtable","codegen.dyn_call","codegen.add_type","codegen.generic_ty","codegen.main_arg","codegen.foreign_call","codegen.generated","codegen.gen_fn","codegen.gen_list","codegen.gen_data","codegen.mock_method","codegen.fuzz_driver","codegen.check_payload","codegen.check_union","codegen.check_member","codegen.declaration_of","codegen.precompilable","codegen.new_gen","codegen.read_back","codegen.self_want","codegen.mock_call","codegen.dyn_generic_call","codegen.lambda_shown","codegen.checked_update","codegen.expr_node","codegen.stmt_node","codegen.built_or_generated","codegen.build_fn","codegen.session_entry","codegen.export_entry","codegen.plain_want","codegen.list_literal","codegen.expr_want_node","codegen.generate","codegen.compiled_alone","codegen.function_value","codegen.call_fn_want","codegen.to_dyn","codegen.dyn_table_is","codegen.call_named","codegen.clock_now","codegen.bind_bounds","codegen.im