"history.change_diff","check_fn","linked","sync_command","fix_loops","std_proofs","with_dependencies","load_package","fresh_verdicts","resolve.named_type","follow_renames","diff.states","diff.log_steps","diff.range_text","diff_command","history.change_text","history.change_words","files_decls","dep_test_decls","resolve.ty","resolve.named_types","diff.log_range","diff.git_range","history_command","revert_command","resolve.expr_here","resolve.fields","resolve.types","resolve.opt_ty","resolve.decl_kind","resolve.func","resolve.params_of","tour.side_range","resolve.expr","resolve.bounds","resolve.stmt","resolve.relocated","resolve.named","resolve.exprs","resolve.pat","resolve.opt","resolve.call","take_entry","package_roots","resolve.pats","reach","impls","dep_tests","checked.keys_of","load","drivers_planned","roots.closure_rule","roots.counted_source","check.definition_errors","check.with_code","codegen.waits_of","finding.names","declared_of","verify_wrappers","impl_instance","for_impl_decl","method_decl","law_wrapper","site_inputs","smt.methods_of","unused.reached","check_keys","with_extra","std_imports","std_reached","roots.walked","roots.verdicts","finding.find_command","unused.removable","repl_std"],"module":"check","text":"/// The program's record and sum types the checker models (without\n/// refinements), with their type parameters, the sums among them, and their\n/// constructors.\npub type Types = {\n  named: Dict[String, List[String]],\n  sums: Set[String],\n  ctors: Dict[String, check.Shape],\n  // what the program's aliases without type parameters stand for\n  // (`type Id = Int | String`, `type Small = Int where it < 10`)\n  aliases: Dict[String, ast.TypeExpr],\n  // the program's aliases with type parameters, their parameters and what\n  // they stand for (`type Many[T] = List[T] | Option[T]`)\n  generic_aliases: Dict[String, (List[String], ast.TypeExpr)] = Dict[String, (List[String], ast.TypeExpr)] {},\n  // the program's traits usable as types (`List[Shape]`)\n  traits: Set[String],\n  // each refined alias's base and predicate (`type Port = Int where …`)\n  refinements: Dict[String, (ast.TypeExpr, ast.Expr)] = Dict[String, (ast.TypeExpr, ast.Expr)] {},\n  // each function's result type as written (`-> Int where it == 5`)\n  rets: Dict[String, ast.TypeExpr] = Dict[String, ast.TypeExpr] {},\n  // each function's `mut` parameters' types as written (`None`: not `mut`)\n  mut_written: Dict[String, List[Option[ast.TypeExpr]]] = Dict[String, List[Option[ast.TypeExpr]]] {},\n  // each sum's constructors, in order\n  variants: Dict[String, List[String]] = Dict[String, List[String]] {},\n  // each function's parameters' names and what it says of its result: its\n  // result type's refinement and its `ensures` (`narrowed_result`)\n  narrows: Dict[String, (List[String], List[ast.Expr])] = Dict[String, (List[String], List[ast.Expr])] {},\n  // each record type that isn't `pub`, outside the root module, to its module\n  private: Dict[String, String] = Dict[String, String] {},\n  // the module of the definition being checked, when one is\n  module: Option[String] = None,\n}","old_text":"/// The program's record and sum types the checker models (without\n/// refinements), with their type parameters, the sums among them, and their\n/// constructors.\npub type Types = {\n  named: Dict[String, List[String]],\n  sums: Set[String],\n  ctors: Dict[String, check.Shape],\n  // what the program's aliases without type parameters stand for\n  // (`type Id = Int | String`, `type Small = Int where it < 10`)\n  aliases: Dict[String, ast.TypeExpr],\n  // the program's aliases with type parameters, their parameters and what\n  // they stand for (`type Many[T] = List[T] | Option[T]`)\n  generic_aliases: Dict[String, (List[String], ast.TypeExpr)] = Dict[String, (List[String], ast.TypeExpr)] {},\n  // the program's traits usable as types (`List[Shape]`)\n  traits: Set[String],\n  // each refined alias's base and predicate (`type Port = Int where …`)\n  refinements: Dict[String, (ast.TypeExpr, ast.Expr)] = Dict[String, (ast.TypeExpr, ast.Expr)] {},\n  // each function's result type as written (`-> Int where it == 5`)\n  rets: Dict[String, ast.TypeExpr] = Dict[String, ast.TypeExpr] {},\n  // each function's `mut` parameters' types as written (`None`: not `mut`)\n  mut_written: Dict[String, List[Option[ast.TypeExpr]]] = Dict[String, List[Option[ast.TypeExpr]]] {},\n  // each sum's constructors, in order\n  variants: Dict[String, List[String]] = Dict[String, List[String]] {},\n  // each function's parameters' names and what it says of its result: its\n  // result type's refinement and its `ensures` (`narrowed_result`)\n  narrows: Dict[String, (List[String], List[ast.Expr])] = Dict[String, (List[String], List[ast.Expr])] {},\n}"},{"name":"check.types_of","kind":"fn","old":"91f0b64f5e3b294a","new":"04825daef7ec6a37","interface_changed":false,"affected":[],"module":"check","text":"/// The program's record and sum types the checker models, by the names the\n/// stored form uses.\npub fn types_of(decls: List[ast.Decl]) -> check.Types {\n  // `Option` and `Result` come with the language\n  mut named := Dict[String, List[String]] { \"Option\": [\"T\"], \"Result\": [\"T\", \"E\"], \"Dict\": [\"K\", \"V\"], \"Set\": [\"A\"], \"Task\": [\"T\"], \"Sender\": [\"T\"], \"Receiver\": [\"T\"] }\n  mut sums := Set[String] { \"Option\", \"Result\" }\n  mut traits := Set[String] {}\n  for d in decls {\n    match d.kind {\n      // a capability's too, like `Console`: its methods' types are checked\n      ast.TraitDef(t) => if len(t.params) == 0 {\n        mut traits.insert(check.qualified(d.module, t.name))\n      },\n      _ => (),\n    }\n  }\n  mut aliases := Dict[String, ast.TypeExpr] {}\n  mut generic_aliases := Dict[String, (List[String], ast.TypeExpr)] {}\n  mut refinements := Dict[String, (ast.TypeExpr, ast.Expr)] {}\n  mut rets := Dict[String, ast.TypeExpr] {}\n  mut mut_written := Dict[String, List[Option[ast.TypeExpr]]] {}\n  mut narrows := Dict[String, (List[String], List[ast.Expr])] {}\n  mut private := Dict[String, String] {}\n  // a trait's methods' facts, which hold of every implementation\n  mut trait_facts := Dict[String, List[ast.Expr]] {}\n  for d in decls {\n    match d.kind {\n      ast.TraitDef(t) => {\n        for tm in t.methods {\n          facts := walk.result_facts(tm.decl)\n          if walk.says_variant_of_it(facts) {\n            k := check.qualified(d.module, t.name) + \".\" + tm.decl.name\n            mut trait_facts.insert(k, facts)\n            mut narrows.insert(\n              k,\n              (tm.decl.params.map(p -> p.name), facts),\n            )\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      // an `impl`'s methods, by `Type.m` as the checker finds them, with\n      // their trait's facts\n      ast.ImplDef(im) => {\n        head := check.type_head(im.for_type)\n        q := if contains(head, \".\") {\n          head\n        } else {\n          check.qualified(d.module, head)\n        }\n        for f in im.methods {\n          inherited := if im.trait_name == \"\" {\n            []\n          } else {\n            get(trait_facts, im.trait_name + \".\" + f.name) or {\n              get(\n                trait_facts,\n                check.qualified(d.module, im.trait_name)\n                  + \".\"\n                  + f.name,\n              ) ?? []\n            }\n          }\n          facts := walk.result_facts(f) + inherited\n          if walk.says_variant_of_it(facts) {\n            mut narrows.insert(\n              q + \".\" + f.name,\n              (f.params.map(p -> p.name), facts),\n            )\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => if !t.distinct && len(t.params) == 0 {\n        match (t.body, t.refinement) {\n          (ast.Alias(a), Some(pred)) => mut refinements.insert(\n            check.qualified(d.module, t.name),\n            (a, pred),\n          ),\n          _ => (),\n        }\n      },\n      ast.FnDef(f) => {\n        mut rets.insert(check.qualified(d.module, f.name), f.ret)\n        facts := walk.result_facts(f)\n        if walk.says_variant_of_it(facts) {\n          mut narrows.insert(\n            check.qualified(d.module, f.name),\n            (f.params.map(p -> p.name), facts),\n          )\n        }\n        mut mut_written.insert(\n          check.qualified(d.module, f.name),\n          f.params.map(\n            p -> if p.mutable {\n              Some(p.ty)\n            } else {\n              None\n            },\n          ),\n        )\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      // an alias, refined or not, is the type it stands for. A record or a sum,\n      // refined or not, is a type of its own; its refinement is verify's, and\n      // its fields are checked as an unrefined one's are.\n      ast.TypeDef(t) => if !t.distinct {\n        q := check.qualified(d.module, t.name)\n        match t.body {\n          ast.Alias(a) => if len(t.params) == 0 {\n            mut aliases.insert(q, a)\n          } else {\n            mut generic_aliases.insert(q, (t.params, a))\n          },\n          ast.RecordBody(_) => {\n            mut named.insert(q, t.params)\n            if !d.public && d.module != \"\" {\n              mut private.insert(q, d.module)\n            }\n          },\n          ast.SumBody(vs) => if !vs.any(v -> v.payload is ast.MemberType) {\n            mut named.insert(q, t.params)\n            mut sums.insert(q)\n          },\n        }\n      } else if t.distinct {\n        // a `distinct` type: a type of its own, made of one field, `value`\n        mut named.insert(check.qualified(d.module, t.name), t.params)\n        if !d.public && d.module != \"\" {\n          mut private.insert(\n            check.qualified(d.module, t.name),\n            d.module,\n          )\n        }\n      },\n      _ => (),\n    }\n  }\n  mut ctors := Dict[String, check.Shape] { \"Some\": check.Shape {\n    owner: \"Option\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"None\": check.Shape {\n    owner: \"Option\",\n    fields: [],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"Ok\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  }, \"Err\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"E\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  } }\n  partial := check.Types {\n    named,\n    sums,\n    ctors: Dict[String, check.Shape] {},\n    aliases,\n    traits,\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => {\n        q := check.qualified(d.module, t.name)\n        if contains(named, q) {\n          tps := set(t.params)\n          match t.body {\n            ast.RecordBody(fs) => mut ctors.insert(\n              q,\n              check.Shape {\n                params: t.params,\n                owner: q,\n                fields: fs.map(\n                  f -> (f.name, check.lower(partial, tps, f.ty)),\n                ),\n                positional: false,\n                required: check.required(fs),\n                written: fs.map(f -> f.ty),\n              },\n            ),\n            ast.SumBody(vs) => {\n              for v in vs {\n                sh := match v.payload {\n                  ast.Positional(ts) => check.Shape {\n                    params: t.params,\n                    owner: q,\n                    fields: ts.map(x -> (\"\", check.lower(partial, tps, x))),\n                    positional: true,\n                    required: [],\n                  },\n                  ast.RecordPayload(fs) => check.Shape {\n                    params: t.params,\n                    owner: q,\n                    fields: fs.map(\n                      f -> (f.name, check.lower(partial, tps, f.ty)),\n                    ),\n                    positional: false,\n                    required: check.required(fs),\n                  },\n                  _ => check.Shape {\n                    params: t.params,\n                    owner: q,\n                    fields: [],\n                    positional: true,\n                    required: [],\n                  },\n                }\n                mut ctors.insert(check.qualified(d.module, v.name), sh)\n              }\n            },\n            ast.Alias(a) => if t.distinct {\n              mut ctors.insert(\n                q,\n                check.Shape {\n                  params: t.params,\n                  owner: q,\n                  fields: [(\"value\", check.lower(partial, tps, a))],\n                  positional: true,\n                  required: [],\n                },\n              )\n            },\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  mut variants := Dict[String, List[String]] {}\n  for (c, sh) in ctors {\n    if contains(sums, sh.owner) {\n      mut variants.insert(\n        sh.owner,\n        (get(variants, sh.owner) ?? []) + [c],\n      )\n    }\n  }\n  check.Types {\n    named,\n    sums,\n    ctors,\n    aliases,\n    traits,\n    refinements,\n    rets,\n    mut_written,\n    variants,\n    narrows,\n    generic_aliases,\n    private,\n  }\n}","old_text":"/// The program's record and sum types the checker models, by the names the\n/// stored form uses.\npub fn types_of(decls: List[ast.Decl]) -> check.Types {\n  // `Option` and `Result` come with the language\n  mut named := Dict[String, List[String]] { \"Option\": [\"T\"], \"Result\": [\"T\", \"E\"], \"Dict\": [\"K\", \"V\"], \"Set\": [\"A\"], \"Task\": [\"T\"], \"Sender\": [\"T\"], \"Receiver\": [\"T\"] }\n  mut sums := Set[String] { \"Option\", \"Result\" }\n  mut traits := Set[String] {}\n  for d in decls {\n    match d.kind {\n      // a capability's too, like `Console`: its methods' types are checked\n      ast.TraitDef(t) => if len(t.params) == 0 {\n        mut traits.insert(check.qualified(d.module, t.name))\n      },\n      _ => (),\n    }\n  }\n  mut aliases := Dict[String, ast.TypeExpr] {}\n  mut generic_aliases := Dict[String, (List[String], ast.TypeExpr)] {}\n  mut refinements := Dict[String, (ast.TypeExpr, ast.Expr)] {}\n  mut rets := Dict[String, ast.TypeExpr] {}\n  mut mut_written := Dict[String, List[Option[ast.TypeExpr]]] {}\n  mut narrows := Dict[String, (List[String], List[ast.Expr])] {}\n  // a trait's methods' facts, which hold of every implementation\n  mut trait_facts := Dict[String, List[ast.Expr]] {}\n  for d in decls {\n    match d.kind {\n      ast.TraitDef(t) => {\n        for tm in t.methods {\n          facts := walk.result_facts(tm.decl)\n          if walk.says_variant_of_it(facts) {\n            k := check.qualified(d.module, t.name) + \".\" + tm.decl.name\n            mut trait_facts.insert(k, facts)\n            mut narrows.insert(\n              k,\n              (tm.decl.params.map(p -> p.name), facts),\n            )\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      // an `impl`'s methods, by `Type.m` as the checker finds them, with\n      // their trait's facts\n      ast.ImplDef(im) => {\n        head := check.type_head(im.for_type)\n        q := if contains(head, \".\") {\n          head\n        } else {\n          check.qualified(d.module, head)\n        }\n        for f in im.methods {\n          inherited := if im.trait_name == \"\" {\n            []\n          } else {\n            get(trait_facts, im.trait_name + \".\" + f.name) or {\n              get(\n                trait_facts,\n                check.qualified(d.module, im.trait_name)\n                  + \".\"\n                  + f.name,\n              ) ?? []\n            }\n          }\n          facts := walk.result_facts(f) + inherited\n          if walk.says_variant_of_it(facts) {\n            mut narrows.insert(\n              q + \".\" + f.name,\n              (f.params.map(p -> p.name), facts),\n            )\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => if !t.distinct && len(t.params) == 0 {\n        match (t.body, t.refinement) {\n          (ast.Alias(a), Some(pred)) => mut refinements.insert(\n            check.qualified(d.module, t.name),\n            (a, pred),\n          ),\n          _ => (),\n        }\n      },\n      ast.FnDef(f) => {\n        mut rets.insert(check.qualified(d.module, f.name), f.ret)\n        facts := walk.result_facts(f)\n        if walk.says_variant_of_it(facts) {\n          mut narrows.insert(\n            check.qualified(d.module, f.name),\n            (f.params.map(p -> p.name), facts),\n          )\n        }\n        mut mut_written.insert(\n          check.qualified(d.module, f.name),\n          f.params.map(\n            p -> if p.mutable {\n              Some(p.ty)\n            } else {\n              None\n            },\n          ),\n        )\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      // an alias, refined or not, is the type it stands for. A record or a sum,\n      // refined or not, is a type of its own; its refinement is verify's, and\n      // its fields are checked as an unrefined one's are.\n      ast.TypeDef(t) => if !t.distinct {\n        q := check.qualified(d.module, t.name)\n        match t.body {\n          ast.Alias(a) => if len(t.params) == 0 {\n            mut aliases.insert(q, a)\n          } else {\n            mut generic_aliases.insert(q, (t.params, a))\n          },\n          ast.RecordBody(_) => mut named.insert(q, t.params),\n          ast.SumBody(vs) => if !vs.any(v -> v.payload is ast.MemberType) {\n            mut named.insert(q, t.params)\n            mut sums.insert(q)\n          },\n        }\n      } else if t.distinct {\n        // a `distinct` type: a type of its own, made of one field, `value`\n        mut named.insert(check.qualified(d.module, t.name), t.params)\n      },\n      _ => (),\n    }\n  }\n  mut ctors := Dict[String, check.Shape] { \"Some\": check.Shape {\n    owner: \"Option\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"None\": check.Shape {\n    owner: \"Option\",\n    fields: [],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"Ok\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  }, \"Err\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"E\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  } }\n  partial := check.Types {\n    named,\n    sums,\n    ctors: Dict[String, check.Shape] {},\n    aliases,\n    traits,\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => {\n        q := check.qualified(d.module, t.name)\n        if contains(named, q) {\n          tps := set(t.params)\n          match t.body {\n            ast.RecordBody(fs) => mut ctors.insert(\n              q,\n              check.Shape {\n                params: t.params,\n                owner: q,\n                fields: fs.map(\n                  f -> (f.name, check.lower(partial, tps, f.ty)),\n                ),\n                positional: false,\n                required: check.required(fs),\n                written: fs.map(f -> f.ty),\n              },\n            ),\n            ast.SumBody(vs) => {\n              for v in vs {\n                sh := match v.payload {\n                  ast.Positional(ts) => check.Shape {\n                    params: t.params,\n                    owner: q,\n                    fields: ts.map(x -> (\"\", check.lower(partial, tps, x))),\n                    positional: true,\n                    required: [],\n                  },\n                  ast.RecordPayload(fs) => check.Shape {\n                    params: t.params,\n                    owner: q,\n                    fields: fs.map(\n                      f -> (f.name, check.lower(partial, tps, f.ty)),\n                    ),\n                    positional: false,\n                    required: check.required(fs),\n                  },\n                  _ => check.Shape {\n                    params: t.params,\n                    owner: q,\n                    fields: [],\n                    positional: true,\n                    required: [],\n                  },\n                }\n                mut ctors.insert(check.qualified(d.module, v.name), sh)\n              }\n            },\n            ast.Alias(a) => if t.distinct {\n              mut ctors.insert(\n                q,\n                check.Shape {\n                  params: t.params,\n                  owner: q,\n                  fields: [(\"value\", check.lower(partial, tps, a))],\n                  positional: true,\n                  required: [],\n                },\n              )\n            },\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  mut variants := Dict[String, List[String]] {}\n  for (c, sh) in ctors {\n    if contains(sums, sh.owner) {\n      mut variants.insert(\n        sh.owner,\n        (get(variants, sh.owner) ?? []) + [c],\n      )\n    }\n  }\n  check.Types {\n    named,\n    sums,\n    ctors,\n    aliases,\n    traits,\n    refinements,\n    rets,\n    mut_written,\n    variants,\n    narrows,\n    generic_aliases,\n  }\n}"},{"name":"check.decl_type_errors","kind":"fn","old":"74942366af623b05","new":"62bfeb16f12f26d8","interface_changed":true,"affected":["check.type_errors_with","check.type_errors","check_errors_in","check_errors_with","loaded_check","edit_errors","check_errors_of","file_errors","edit_file","package_checked","loaded_errors","apply_edit","apply_change","core_rt_text","repl_eval","call_command","merge_file_command","merged_checks","check_command","verify_program","run_command","build_command","test_command","live_edit_command","check_files","repl_command","edit_command","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command","codegen_with","build_core_command","command_line","sync_command","strata_command","search_invariants","build_proofs","verify_file","alongside_command","std_library","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","main","fix_loops","std_proofs","verify_command","static_graph","literal_errors_of","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","graph_command","graph_diff","check_fn","linked","computed_value","codegen.read_back","eval_files","comptime_value","comptime_values","expanded","comptime_runner","with_base"],"module":"check","text":"/// `type_errors_with`'s errors in one definition: a function's body, a\n/// field's default, a trait's methods, a test's body, an `impl`'s methods.\nfn decl_type_errors(\n  d: ast.Decl,\n  given: check.Types,\n  fns: Dict[String, check.Ty],\n  methods: check.Methods,\n  builtins: Dict[String, List[check.Builtin]],\n) -> List[(String, String)] {\n  types := check.Types { ..given, module: Some(d.module) }\n  mut out := []\n  match d.kind {\n    ast.FnDef(f) => {\n      // inferred in an arena, keeping only the errors\n      errs := std.memory.arena(() -> {\n        inf := check.fn_inferred(\n          f,\n          set(f.type_params),\n          types,\n          fns,\n          methods,\n          builtins,\n        )\n        // a `noalloc` function, or one of a module its strata.toml declares\n        // `noalloc`: no arithmetic on `Int`, ...\n        inf.errs\n          + check.dropped_results(inf)\n          + if f.no_alloc {\n            check.noalloc_typed(f.name, inf)\n          } else {\n            []\n          }\n      })\n      for m in errs {\n        mut out.push(\n          if starts_with(m, \"$warning \") {\n            check.labelled(check.qualified(d.module, f.name), m)\n          } else {\n            (f.name, m)\n          },\n        )\n      }\n    },\n    // each field's default has the field's type\n    ast.TypeDef(t) => {\n      mut fs := match t.body {\n        ast.RecordBody(xs) => xs,\n        _ => [],\n      }\n      match t.body {\n        ast.SumBody(vs) => {\n          for v in vs {\n            match v.payload {\n              ast.RecordPayload(xs) => {\n                fs += xs\n              },\n              _ => (),\n            }\n          }\n        },\n        _ => (),\n      }\n      for m in check.default_errors(\n        fs,\n        set(t.params),\n        types,\n        fns,\n        methods,\n        builtins,\n      ) {\n        mut out.push((t.name, m))\n      }\n    },\n    // a trait method without `self` must mention `Self`, or no implementation\n    // could be chosen for a call. A trait derivable over functions has no such\n    // constraint: what deriving it makes is top-level.\n    ast.TraitDef(t) => {\n      for tm in t.methods {\n        takes := match get(tm.decl.params, 0) {\n          Some(p) => p.name == \"self\",\n          None => false,\n        }\n        if !takes\n          && !check.over_functions(t)\n          && !tm.decl.params.any(p -> check.mentions_self(p.ty))\n          && !check.mentions_self(tm.decl.ret) {\n          mut out.push(\n            (\n              t.name,\n              \"trait method `\"\n                + tm.decl.name\n                + \"` has no `self` and doesn't mention `Self`, so no implementation could be chosen for a call: make it a function\",\n            ),\n          )\n        }\n      }\n    },\n    // a test's body, as a function of its parameters returning nothing\n    ast.TestDef(t) => {\n      label := \"test \\\"\" + t.name + \"\\\"\"\n      g := ast.FnDecl {\n        doc: [],\n        comments: [],\n        name: label,\n        type_params: [],\n        bounds: [],\n        params: t.params,\n        ret: ast.Named { name: \"$outside\", args: [] },\n        pre: [],\n        post: [],\n        terminating: false,\n        body: t.body,\n        compile_time: false,\n        derived: false,\n      }\n      for m in check.fn_errors(\n        g,\n        Set[String] {},\n        types,\n        fns,\n        methods,\n        builtins,\n      ) {\n        mut out.push(check.labelled(label, m))\n      }\n    },\n    // a method's errors are the `impl`'s: `impl Pt`, `impl Area for Pt`\n    ast.ImplDef(im) => {\n      label := if im.trait_name == \"\" {\n        \"impl \" + text.type_text(im.for_type)\n      } else {\n        \"impl \"\n          + im.trait_name\n          + \" for \"\n          + text.type_text(im.for_type)\n      }\n      for f in im.methods {\n        // the `impl`'s bounds hold in its methods (`impl[T: Iterator]`)\n        g := ast.FnDecl {\n          ..check.method_of(f, im.for_type),\n          bounds: im.bounds + f.bounds,\n        }\n        for m in check.fn_errors(\n          g,\n          set(im.type_params + g.type_params),\n          types,\n          fns,\n          methods,\n          builtins,\n        ) {\n          mut out.push(check.labelled(label, m))\n        }\n      }\n    },\n    _ => (),\n  }\n  out\n}","old_text":"/// `type_errors_with`'s errors in one definition: a function's body, a\n/// field's default, a trait's methods, a test's body, an `impl`'s methods.\nfn decl_type_errors(\n  d: ast.Decl,\n  types: check.Types,\n  fns: Dict[String, check.Ty],\n  methods: check.Methods,\n  builtins: Dict[String, List[check.Builtin]],\n) -> List[(String, String)] {\n  mut out := []\n  match d.kind {\n    ast.FnDef(f) => {\n      // inferred in an arena, keeping only the errors\n      errs := std.memory.arena(() -> {\n        inf := check.fn_inferred(\n          f,\n          set(f.type_params),\n          types,\n          fns,\n          methods,\n          builtins,\n        )\n        // a `noalloc` function, or one of a module its strata.toml declares\n        // `noalloc`: no arithmetic on `Int`, ...\n        inf.errs\n          + check.dropped_results(inf)\n          + if f.no_alloc {\n            check.noalloc_typed(f.name, inf)\n          } else {\n            []\n          }\n      })\n      for m in errs {\n        mut out.push(\n          if starts_with(m, \"$warning \") {\n            check.labelled(check.qualified(d.module, f.name), m)\n          } else {\n            (f.name, m)\n          },\n        )\n      }\n    },\n    // each field's default has the field's type\n    ast.TypeDef(t) => {\n      mut fs := match t.body {\n        ast.RecordBody(xs) => xs,\n        _ => [],\n      }\n      match t.body {\n        ast.SumBody(vs) => {\n          for v in vs {\n            match v.payload {\n              ast.RecordPayload(xs) => {\n                fs += xs\n              },\n              _ => (),\n            }\n          }\n        },\n        _ => (),\n      }\n      for m in check.default_errors(\n        fs,\n        set(t.params),\n        types,\n        fns,\n        methods,\n        builtins,\n      ) {\n        mut out.push((t.name, m))\n      }\n    },\n    // a trait method without `self` must mention `Self`, or no implementation\n    // could be chosen for a call. A trait derivable over functions has no such\n    // constraint: what deriving it makes is top-level.\n    ast.TraitDef(t) => {\n      for tm in t.methods {\n        takes := match get(tm.decl.params, 0) {\n          Some(p) => p.name == \"self\",\n          None => false,\n        }\n        if !takes\n          && !check.over_functions(t)\n          && !tm.decl.params.any(p -> check.mentions_self(p.ty))\n          && !check.mentions_self(tm.decl.ret) {\n          mut out.push(\n            (\n              t.name,\n              \"trait method `\"\n                + tm.decl.name\n                + \"` has no `self` and doesn't mention `Self`, so no implementation could be chosen for a call: make it a function\",\n            ),\n          )\n        }\n      }\n    },\n    // a test's body, as a function of its parameters returning nothing\n    ast.TestDef(t) => {\n      label := \"test \\\"\" + t.name + \"\\\"\"\n      g := ast.FnDecl {\n        doc: [],\n        comments: [],\n        name: label,\n        type_params: [],\n        bounds: [],\n        params: t.params,\n        ret: ast.Named { name: \"$outside\", args: [] },\n        pre: [],\n        post: [],\n        terminating: false,\n        body: t.body,\n        compile_time: false,\n        derived: false,\n      }\n      for m in check.fn_errors(\n        g,\n        Set[String] {},\n        types,\n        fns,\n        methods,\n        builtins,\n      ) {\n        mut out.push(check.labelled(label, m))\n      }\n    },\n    // a method's errors are the `impl`'s: `impl Pt`, `impl Area for Pt`\n    ast.ImplDef(im) => {\n      label := if im.trait_name == \"\" {\n        \"impl \" + text.type_text(im.for_type)\n      } else {\n        \"impl \"\n          + im.trait_name\n          + \" for \"\n          + text.type_text(im.for_type)\n      }\n      for f in im.methods {\n        // the `impl`'s bounds hold in its methods (`impl[T: Iterator]`)\n        g := ast.FnDecl {\n          ..check.method_of(f, im.for_type),\n          bounds: im.bounds + f.bounds,\n        }\n        for m in check.fn_errors(\n          g,\n          set(im.type_params + g.type_params),\n          types,\n          fns,\n          methods,\n          builtins,\n        ) {\n          mut out.push(check.labelled(label, m))\n        }\n      }\n    },\n    _ => (),\n  }\n  out\n}"},{"name":"check.infer_untagged","kind":"fn","old":"14ac83c218864980","new":"33de3211c1df1adf","interface_changed":false,"affected":[],"module":"check","text":"/// The type of `e`, where `expected` is the type its place asks for. The\n/// mismatches found go to `i.errs`, in the order found.\nfn infer_untagged(\n  mut i: check.Inf,\n  e: ast.Expr,\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  match operators.lowered_node(e) {\n    // `...x` where `spread_bound` found no call by name to fill\n    ast.Call { callee: ast.Var(\"...\"), args: [x] } => {\n      check.spread_error(\n        mut i,\n        \"`...\"\n          + text.expr_text(x, 0)\n          + \"`: a spread gives a record's fields to the parameters of a function or method called by name; it can't be used here\",\n      )\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    ast.IntLit(_) => check.int_literal(mut i, e, expected),\n    ast.BigIntLit(_) => check.int_literal(mut i, e, expected),\n    ast.FloatLit(_) => check.dec_literal(mut i, expected),\n    ast.StrLit(_) => check.TStr,\n    ast.BoolLit(_) => check.TBool,\n    ast.UnitExpr => check.TUnit,\n    // `env` holds declared types, narrowed in the arms and branches that narrow them\n    ast.Var(x) => match get(env, x) {\n      Some(t) => {\n        // a closure or `spawn` can't hold a handle from outside it\n        if contains(i.captured, x) && check.holds_task(check.res(i, t)) {\n          check.error(mut i, \"a closure or `spawn` can't hold `\"\n            + x\n            + \"`, a task's handle: await it where it was spawned\")\n        }\n        t\n      },\n      None => match get(i.fns, x) {\n        // a function's type parameters: fresh at each use\n        Some(t) => check.inst(t, check.fresh_for(\n          mut i,\n          to_list(check.gens(t, Set[String] {})),\n        )),\n        None => check.trait_fn(mut i, x),\n      },\n    },\n    ast.Interp(parts) => {\n      for p in parts {\n        match p {\n          ast.ValuePart { value, spec } => {\n            t := check.listed_arg(\n              mut i,\n              \"$interp\",\n              0,\n              value,\n              check.TList(check.TAny),\n              check.infer(mut i, value, env, None),\n              \"interpolation\",\n            )\n            match spec {\n              Some(f) => check.check_spec(mut i, f, t),\n              None => (),\n            }\n          },\n          ast.TextPart(_) => (),\n        }\n      }\n      check.TStr\n    },\n    ast.Binary { op, left, right } => check.binary(mut i, op, left, right, env, expected),\n    // a negative literal of a sized type (`-2^63`, beyond 64 bits once negated)\n    ast.Unary { op, operand } => if op == ast.Neg\n      && check.is_int_lit(operand)\n      && check.sized_expected(i, expected) is Some {\n      _ := check.infer(mut i, operand, env, None)\n      check.int_literal(mut i, e, expected)\n    } else {\n      // (`-(1.5 + x)` where a `Float` is wanted: the literal is one)\n      t := check.infer(mut i, operand, env, if op == ast.Neg {\n        check.float_wanted(i, expected)\n      } else {\n        None\n      })\n      if op == ast.Neg && !check.is_int_lit(operand) {\n        mut i.arith.push((\"-\", t))\n      }\n      match op {\n        ast.Neg => {\n          // `-v` on a type with `impl Neg for T`\n          if check.own_negation(i, t) {\n            mut i.operators.push(e)\n            return t\n          }\n          match check.res(i, t) {\n            check.TInt | check.TFloat | check.TAny => (),\n            check.TGen(p) => if !check.sized_family(i, p) {\n              check.error(\n                mut i,\n                \"operand of `-` must be Int or Float, found `\"\n                  + p\n                  + \"`\",\n              )\n            },\n            check.TNamed { name, args } => if !(len(args) == 0\n              && (check.is_sized(name) || name == \"Real\")) {\n              check.error(\n                mut i,\n                \"operand of `-` must be Int, Real or Float, found `\"\n                  + (check.shown(check.res(i, t)) ?? name)\n                  + \"`\",\n              )\n            },\n            check.TVar(n) => if !contains(i.decs, n) {\n              check.expect(mut i, check.TInt, t, \"operand of `-`\")\n            },\n            other => match check.shown(other) {\n              Some(s) => check.error(\n                mut i,\n                \"operand of `-` must be Int, Real or Float, found `\"\n                  + s\n                  + \"`\",\n              ),\n              None => (),\n            },\n          }\n          t\n        },\n        ast.Not => {\n          check.expect(mut i, check.TBool, t, \"operand of `!`\")\n          check.TBool\n        },\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => check.infer_if(mut i, cond, then, otherwise, env, expected),\n    ast.Block { stmts, last } => check.infer_block(mut i, stmts, last, env, expected),\n    // a decimal literal marked by `dec_marked`: its type is recorded\n    ast.Call { callee, args } => match check.dec_mark(e) {\n      Some(m) => {\n        t := check.dec_literal(mut i, expected)\n        mut i.insts.insert(m, t)\n        t\n      },\n      // an integer literal marked by `dec_marked`: a `Real` where one is\n      // wanted\n      None => match check.int_mark(e) {\n        Some(m) => {\n          t := check.int_literal(\n            mut i,\n            get(args, 0) ?? ast.IntLit(0),\n            expected,\n          )\n          mut i.insts.insert(m, t)\n          t\n        },\n        None => check.infer_call(mut i, callee, args, env),\n      },\n    },\n    ast.ListExpr(es) => check.infer_list(mut i, es, env, expected),\n    ast.MatchExpr { scrutinee, binding, arms } => match sugar.handler_of(e) {\n      Some(h) => check.infer_handler(mut i, h, env),\n      None => check.infer_match(\n        mut i,\n        scrutinee,\n        binding,\n        arms,\n        env,\n        expected,\n      ),\n    },\n    ast.Lambda { params, body } => check.infer_lambda(mut i, params, body, env, expected),\n    ast.Return(x) => {\n      r := i.ret\n      if check.outside_fn(check.res(i, r)) {\n        check.error(mut i, \"`return` outside a function\")\n        _ := check.infer(mut i, x, env, None)\n      } else {\n        t := check.infer(mut i, x, env, Some(r))\n        check.expect(mut i, r, t, \"`return` value\")\n      }\n      check.TAny\n    },\n    ast.IsExpr { value, .. } => {\n      _ := check.infer(mut i, value, env, None)\n      check.TBool\n    },\n    ast.TupleExpr(es) => {\n      // each element with the expected tuple's element as its hint\n      hints := match expected {\n        Some(e) => match check.res(i, e) {\n          check.TNamed { name, args } => if name == \"Tuple\" && len(args) == len(es) {\n            args\n          } else {\n            []\n          },\n          _ => [],\n        },\n        None => [],\n      }\n      mut ts := []\n      for (k, x) in enumerate(es) {\n        mut ts.push(check.infer(mut i, x, env, get(hints, k)))\n      }\n      check.TNamed { name: \"Tuple\", args: ts }\n    },\n    // `{ ..x, f: v }` (tagged `$upd:PATH`), or `T { ..x, f: v }` that\n    // `desugar.records_lowered` left (`T` no record of the program)\n    ast.CtorExpr { name: tagged, args: ast.RecordArgs([(\"..\", base), ..fields]) } => if starts_with(tagged, \"$upd:\") {\n      check.infer_update(mut i, tagged, base, fields, env)\n    } else {\n      match get(i.types.ctors, tagged) {\n        Some(_) => check.infer_update(mut i, \"\", base, fields, env),\n        // a type parameter's record (`T { ..x, f: v }`, as `updates_named`\n        // writes it): its base's type\n        None => if contains(i.trows, tagged) {\n          check.infer_update(mut i, \"\", base, fields, env)\n        } else {\n          check.infer_all(mut i, [base] + fields.map(f -> f.1), env)\n          check.TAny\n        },\n      }\n    },\n    ast.CtorExpr { name, args } => match get(i.types.ctors, name) {\n      Some(sh) => check.infer_ctor(mut i, name, sh, args, env, expected),\n      None => {\n        match args {\n          ast.PositionalArgs(es) => check.infer_all(mut i, es, env),\n          ast.RecordArgs(fs) => check.infer_all(mut i, fs.map(f -> f.1), env),\n          ast.NoArgs => (),\n        }\n        check.TAny\n      },\n    },\n    ast.MethodCall { recv, name, args } => check.infer_method(mut i, recv, name, args, env, false),\n    ast.FieldOf { base, name: tagged } => {\n      // a tagged read, `sku#0.1`: its receiver's type is kept for `rename`\n      (name, tag) := check.untag(tagged) ?? (tagged, \"\")\n      seq := i.call_seq\n      bt := check.infer(mut i, base, env, None)\n      check.default_dec(mut i, bt)\n      match check.res(i, bt) {\n        check.TNamed { name: n, .. } => check.closed_fields(mut i, n),\n        _ => (),\n      }\n      if tag != \"\" {\n        mut i.insts.insert(tag + \":field\", bt)\n      }\n      // a field an arm narrows (`match t.status { Closed => t.status.why }`)\n      match check.place_key(ast.FieldOf { base, name: tagged }) {\n        Some(k) => match get(env, k) {\n          Some(nt) => return nt,\n          None => (),\n        },\n        None => (),\n      }\n      // a call whose function speaks of its variant under a condition only\n      // `verify` decides: the field of the variants left that have it, which\n      // `verify` proves the result is one of (else it faults when it runs)\n      match (i.last_call, check.sum_variants(i, bt)) {\n        ((ls, _, vs, true), Some((_, targs, _))) => if ls == seq\n          && (base is ast.Call || base is ast.MethodCall)\n          && len(check.with_field(i, vs, name)) > 0 {\n          return check.variants_field(\n            mut i,\n            check.with_field(i, vs, name),\n            targs,\n            name,\n            check.shown(check.widened(check.res(i, bt))) ?? \"?\",\n          )\n        },\n        _ => (),\n      }\n      match check.res(i, bt) {\n        // a field of a value that has none\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => {\n          match check.shown(check.res(i, bt)) {\n            Some(x) => check.error(\n              mut i,\n              \"cannot access field `\" + name + \"` on `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          check.TAny\n        },\n        // `p.1`: a tuple's element\n        check.TNamed { name: \"Tuple\", args: targs } => match parse_int(name) {\n          Some(k) => get(targs, k) or {\n            match check.shown(check.res(i, bt)) {\n              Some(x) => check.error(\n                mut i,\n                \"tuple `\" + x + \"` has no element \" + name,\n              ),\n              None => (),\n            }\n            check.TAny\n          },\n          None => check.TAny,\n        },\n        // a field of the one variant a value is narrowed to\n        check.TVariants { names: [v], args: targs, .. } => match get(i.types.ctors, v) {\n          Some(sh) => match check.field_of(sh, name) {\n            Some(ft) => check.inst(ft, check.pairs(sh.params, targs)),\n            None => {\n              check.error(\n                mut i,\n                \"variant `\" + v + \"` has no field `\" + name + \"`\",\n              )\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a field every variant a value is narrowed to has\n        check.TVariants { names, args: targs, .. } => check.variants_field(\n          mut i,\n          names,\n          targs,\n          name,\n          check.shown(check.res(i, bt)) ?? \"?\",\n        ),\n        // a field every member of a union has, with the same type\n        check.TUnion(ms) => {\n          mut out: Option[check.Ty] = None\n          for m in ms {\n            ft := match m {\n              check.TNamed { name: mn, .. } => match get(i.types.ctors, mn) {\n                Some(sh) => check.field_of(sh, name),\n                None => None,\n              },\n              _ => None,\n            }\n            match ft {\n              Some(x) => {\n                out = Some(x)\n              },\n              None => {\n                mt := check.printed(m)\n                ut := check.printed(check.res(i, bt))\n                check.error(\n                  mut i,\n                  f\"`{mt}` has no field `{name}`, so not every `{ut}` does (match on it first)\",\n                )\n                return check.TAny\n              },\n            }\n          }\n          out ?? check.TAny\n        },\n        // a type parameter's field, by its structural bound\n        check.TGen(p) => match get(i.trows, p) {\n          Some(fs) => match fs.filter(x -> x.0 == name) {\n            [x, ..] => x.1,\n            _ => {\n              check.error(\n                mut i,\n                f\"`{check.row_text(fs)}` has no field `{name}` (a value of a structural type has only the fields it names)\",\n              )\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a sum's field: one every variant has\n        check.TNamed { name: n, args: targs } => if contains(i.types.sums, n) && !contains(i.types.ctors, n) {\n          check.variants_field(\n            mut i,\n            get(i.types.variants, n) ?? [],\n            targs,\n            name,\n            check.shown(check.res(i, bt)) ?? n,\n          )\n        } else {\n          match get(i.types.ctors, n) {\n            // a record type; a sum's name is not a constructor\n            Some(sh) => match check.field_of(sh, name) {\n              Some(ft) => {\n                mut m := Dict[String, check.Ty] {}\n                for (k, p) in enumerate(sh.params) {\n                  mut m.insert(p, get(targs, k) ?? check.TAny)\n                }\n                check.inst(ft, m)\n              },\n              None => {\n                check.error(mut i, \"type `\"\n                  + n\n                  + \"` has no field `\"\n                  + name\n                  + \"` (match on variants to access their fields)\")\n                check.TAny\n              },\n            },\n            None => check.TAny,\n          }\n        },\n        _ => check.TAny,\n      }\n    },\n    // `mut q.claim(2)`: a call that changes its receiver\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => match check.untag(name) {\n      // a tagged call: its receiver's type is kept, as `infer` keeps it. A call\n      // spreading records, tagged by `spread_bound`, is written out.\n      Some(nk) => if starts_with(nk.1, \"s\") {\n        check.infer_spread(mut i, e, nk.1, env, expected)\n      } else {\n        rt := check.infer(mut i, recv, env, None)\n        mut i.insts.insert(nk.1 + \":recv\", rt)\n        t := check.infer_method(mut i, recv, nk.0, args, env, true)\n        mut i.insts.insert(nk.1, t)\n        t\n      },\n      None => check.infer_method(mut i, recv, name, args, env, true),\n    },\n    ast.MutExpr(x) => check.infer(mut i, x, env, expected),\n    // `r!`, `o?`: the value a `Result` or an `Option` holds\n    // `r except e { fallback }`: the value, or the fallback (of the same\n    // type) with `e` the error\n    // `a..b`: the list of the integers from `a`\n    ast.Comptime(x) => {\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    // `old e`: `e`'s value where the function started, of `e`'s type\n    ast.Old(x) => check.infer(mut i, x, env, expected),\n    ast.Assumed(x) => check.infer(mut i, x, env, expected),\n    // a `scope`'s result can't hold one of its tasks' handles\n    ast.Scope(x) => {\n      held := i.outside\n      i.outside = Some(set(keys(env)))\n      // `scope { …; spawn e }`: the last task's handle isn't its value\n      t := if check.ends_in_spawn(x) {\n        _ := check.infer(mut i, x, env, None)\n        check.TUnit\n      } else {\n        check.infer(mut i, x, env, expected)\n      }\n      i.outside = held\n      if check.holds_task(check.res(i, t)) {\n        match check.shown(check.res(i, t)) {\n          Some(s) => check.error(\n            mut i,\n            \"a task's handle can't leave its `scope` (its result is `\"\n              + s\n              + \"`): await it inside\",\n          ),\n          None => (),\n        }\n      }\n      t\n    },\n    // `spawn e`: a handle to `e`'s value\n    ast.Spawn(x) => {\n      outer := i.ret\n      i.ret = check.TAny\n      held := i.captured\n      i.captured = set(keys(env))\n      t := check.infer(mut i, x, env, None)\n      i.captured = held\n      i.ret = outer\n      // a sender is captured on its own, never inside another value\n      for v in keys(env).sorted() {\n        vt := check.res(i, get(env, v) ?? check.TAny)\n        if !(vt is check.TNamed && check.type_name(vt) == \"Sender\")\n          && check.holds_sender(i, vt, 8)\n          && check.uses(x, v)\n          && !check.rebinds(x, v) {\n          check.error(\n            mut i,\n            \"a task (a `spawn`, a `race` arm) can capture a sender only on its own (a variable holding it): `\"\n              + v\n              + \"` holds one inside\",\n          )\n        }\n      }\n      check.TNamed { name: \"Task\", args: [t] }\n    },\n    // `select`: each arm's operation (`rx.recv()` an `Option`, `tx.send(v)`,\n    // `await h`, `clock.after(d)` with `clock` a clock and `d` a `Duration`),\n    // its name, and its body with the type wanted\n    ast.Select(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.MethodCall { recv, name, args } => if name == \"after\" && len(args) == 1 {\n            ct := check.res(i, check.infer(mut i, recv, env, None))\n            match ct {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(ct) {\n                Some(x) => check.error(\n                  mut i,\n                  \"an `after` arm waits on a clock: `\"\n                    + x\n                    + \"` doesn't implement `Clock` (std.time)\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            dt := check.res(i, check.infer(\n              mut i,\n              get(args, 0) ?? ast.UnitExpr,\n              env,\n              None,\n            ))\n            match dt {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(dt) {\n                Some(x) => check.error(\n                  mut i,\n                  \"the time an `after` arm waits: expected `std.time.Duration`, found `\"\n                    + x\n                    + \"`\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            check.TUnit\n          } else {\n            check.infer(mut i, a.op, env, None)\n          },\n          _ => check.infer(mut i, a.op, env, None),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `race`: each left side is a task's body (a supervised one's result is a\n    // `Result[T, Panic]`), then its name and its body\n    ast.Race(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.SupervisedSpawn(x) => check.TNamed { name: \"Result\", args: [\n            check.task_body(mut i, x, env),\n            check.TNamed { name: \"Panic\", args: [] },\n          ] },\n          op => check.task_body(mut i, op, env),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `supervised spawn e`: a handle to `e`'s value, or its panic\n    ast.SupervisedSpawn(x) => check.TNamed {\n      name: \"Task\",\n      args: [check.TNamed { name: \"Result\", args: [\n        check.task_body(mut i, x, env),\n        check.TNamed { name: \"Panic\", args: [] },\n      ] }],\n    },\n    // `await h`: the task's value, or each task's for a tuple or list of handles\n    ast.Await(x) => {\n      t := check.infer(mut i, x, env, None)\n      check.awaited(mut i, check.res(i, t))\n    },\n    ast.Hole(h) => {\n      t := expected ?? check.fresh(mut i)\n      mut i.holes.push((h, t, env))\n      t\n    },\n    _ => check.TAny,\n  }\n}","old_text":"/// The type of `e`, where `expected` is the type its place asks for. The\n/// mismatches found go to `i.errs`, in the order found.\nfn infer_untagged(\n  mut i: check.Inf,\n  e: ast.Expr,\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  match operators.lowered_node(e) {\n    // `...x` where `spread_bound` found no call by name to fill\n    ast.Call { callee: ast.Var(\"...\"), args: [x] } => {\n      check.spread_error(\n        mut i,\n        \"`...\"\n          + text.expr_text(x, 0)\n          + \"`: a spread gives a record's fields to the parameters of a function or method called by name; it can't be used here\",\n      )\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    ast.IntLit(_) => check.int_literal(mut i, e, expected),\n    ast.BigIntLit(_) => check.int_literal(mut i, e, expected),\n    ast.FloatLit(_) => check.dec_literal(mut i, expected),\n    ast.StrLit(_) => check.TStr,\n    ast.BoolLit(_) => check.TBool,\n    ast.UnitExpr => check.TUnit,\n    // `env` holds declared types, narrowed in the arms and branches that narrow them\n    ast.Var(x) => match get(env, x) {\n      Some(t) => {\n        // a closure or `spawn` can't hold a handle from outside it\n        if contains(i.captured, x) && check.holds_task(check.res(i, t)) {\n          check.error(mut i, \"a closure or `spawn` can't hold `\"\n            + x\n            + \"`, a task's handle: await it where it was spawned\")\n        }\n        t\n      },\n      None => match get(i.fns, x) {\n        // a function's type parameters: fresh at each use\n        Some(t) => check.inst(t, check.fresh_for(\n          mut i,\n          to_list(check.gens(t, Set[String] {})),\n        )),\n        None => check.trait_fn(mut i, x),\n      },\n    },\n    ast.Interp(parts) => {\n      for p in parts {\n        match p {\n          ast.ValuePart { value, spec } => {\n            t := check.listed_arg(\n              mut i,\n              \"$interp\",\n              0,\n              value,\n              check.TList(check.TAny),\n              check.infer(mut i, value, env, None),\n              \"interpolation\",\n            )\n            match spec {\n              Some(f) => check.check_spec(mut i, f, t),\n              None => (),\n            }\n          },\n          ast.TextPart(_) => (),\n        }\n      }\n      check.TStr\n    },\n    ast.Binary { op, left, right } => check.binary(mut i, op, left, right, env, expected),\n    // a negative literal of a sized type (`-2^63`, beyond 64 bits once negated)\n    ast.Unary { op, operand } => if op == ast.Neg\n      && check.is_int_lit(operand)\n      && check.sized_expected(i, expected) is Some {\n      _ := check.infer(mut i, operand, env, None)\n      check.int_literal(mut i, e, expected)\n    } else {\n      // (`-(1.5 + x)` where a `Float` is wanted: the literal is one)\n      t := check.infer(mut i, operand, env, if op == ast.Neg {\n        check.float_wanted(i, expected)\n      } else {\n        None\n      })\n      if op == ast.Neg && !check.is_int_lit(operand) {\n        mut i.arith.push((\"-\", t))\n      }\n      match op {\n        ast.Neg => {\n          // `-v` on a type with `impl Neg for T`\n          if check.own_negation(i, t) {\n            mut i.operators.push(e)\n            return t\n          }\n          match check.res(i, t) {\n            check.TInt | check.TFloat | check.TAny => (),\n            check.TGen(p) => if !check.sized_family(i, p) {\n              check.error(\n                mut i,\n                \"operand of `-` must be Int or Float, found `\"\n                  + p\n                  + \"`\",\n              )\n            },\n            check.TNamed { name, args } => if !(len(args) == 0\n              && (check.is_sized(name) || name == \"Real\")) {\n              check.error(\n                mut i,\n                \"operand of `-` must be Int, Real or Float, found `\"\n                  + (check.shown(check.res(i, t)) ?? name)\n                  + \"`\",\n              )\n            },\n            check.TVar(n) => if !contains(i.decs, n) {\n              check.expect(mut i, check.TInt, t, \"operand of `-`\")\n            },\n            other => match check.shown(other) {\n              Some(s) => check.error(\n                mut i,\n                \"operand of `-` must be Int, Real or Float, found `\"\n                  + s\n                  + \"`\",\n              ),\n              None => (),\n            },\n          }\n          t\n        },\n        ast.Not => {\n          check.expect(mut i, check.TBool, t, \"operand of `!`\")\n          check.TBool\n        },\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => check.infer_if(mut i, cond, then, otherwise, env, expected),\n    ast.Block { stmts, last } => check.infer_block(mut i, stmts, last, env, expected),\n    // a decimal literal marked by `dec_marked`: its type is recorded\n    ast.Call { callee, args } => match check.dec_mark(e) {\n      Some(m) => {\n        t := check.dec_literal(mut i, expected)\n        mut i.insts.insert(m, t)\n        t\n      },\n      // an integer literal marked by `dec_marked`: a `Real` where one is\n      // wanted\n      None => match check.int_mark(e) {\n        Some(m) => {\n          t := check.int_literal(\n            mut i,\n            get(args, 0) ?? ast.IntLit(0),\n            expected,\n          )\n          mut i.insts.insert(m, t)\n          t\n        },\n        None => check.infer_call(mut i, callee, args, env),\n      },\n    },\n    ast.ListExpr(es) => check.infer_list(mut i, es, env, expected),\n    ast.MatchExpr { scrutinee, binding, arms } => match sugar.handler_of(e) {\n      Some(h) => check.infer_handler(mut i, h, env),\n      None => check.infer_match(\n        mut i,\n        scrutinee,\n        binding,\n        arms,\n        env,\n        expected,\n      ),\n    },\n    ast.Lambda { params, body } => check.infer_lambda(mut i, params, body, env, expected),\n    ast.Return(x) => {\n      r := i.ret\n      if check.outside_fn(check.res(i, r)) {\n        check.error(mut i, \"`return` outside a function\")\n        _ := check.infer(mut i, x, env, None)\n      } else {\n        t := check.infer(mut i, x, env, Some(r))\n        check.expect(mut i, r, t, \"`return` value\")\n      }\n      check.TAny\n    },\n    ast.IsExpr { value, .. } => {\n      _ := check.infer(mut i, value, env, None)\n      check.TBool\n    },\n    ast.TupleExpr(es) => {\n      // each element with the expected tuple's element as its hint\n      hints := match expected {\n        Some(e) => match check.res(i, e) {\n          check.TNamed { name, args } => if name == \"Tuple\" && len(args) == len(es) {\n            args\n          } else {\n            []\n          },\n          _ => [],\n        },\n        None => [],\n      }\n      mut ts := []\n      for (k, x) in enumerate(es) {\n        mut ts.push(check.infer(mut i, x, env, get(hints, k)))\n      }\n      check.TNamed { name: \"Tuple\", args: ts }\n    },\n    // `{ ..x, f: v }` (tagged `$upd:PATH`), or `T { ..x, f: v }` that\n    // `desugar.records_lowered` left (`T` no record of the program)\n    ast.CtorExpr { name: tagged, args: ast.RecordArgs([(\"..\", base), ..fields]) } => if starts_with(tagged, \"$upd:\") {\n      check.infer_update(mut i, tagged, base, fields, env)\n    } else {\n      match get(i.types.ctors, tagged) {\n        Some(_) => check.infer_update(mut i, \"\", base, fields, env),\n        // a type parameter's record (`T { ..x, f: v }`, as `updates_named`\n        // writes it): its base's type\n        None => if contains(i.trows, tagged) {\n          check.infer_update(mut i, \"\", base, fields, env)\n        } else {\n          check.infer_all(mut i, [base] + fields.map(f -> f.1), env)\n          check.TAny\n        },\n      }\n    },\n    ast.CtorExpr { name, args } => match get(i.types.ctors, name) {\n      Some(sh) => check.infer_ctor(mut i, name, sh, args, env, expected),\n      None => {\n        match args {\n          ast.PositionalArgs(es) => check.infer_all(mut i, es, env),\n          ast.RecordArgs(fs) => check.infer_all(mut i, fs.map(f -> f.1), env),\n          ast.NoArgs => (),\n        }\n        check.TAny\n      },\n    },\n    ast.MethodCall { recv, name, args } => check.infer_method(mut i, recv, name, args, env, false),\n    ast.FieldOf { base, name: tagged } => {\n      // a tagged read, `sku#0.1`: its receiver's type is kept for `rename`\n      (name, tag) := check.untag(tagged) ?? (tagged, \"\")\n      seq := i.call_seq\n      bt := check.infer(mut i, base, env, None)\n      check.default_dec(mut i, bt)\n      if tag != \"\" {\n        mut i.insts.insert(tag + \":field\", bt)\n      }\n      // a field an arm narrows (`match t.status { Closed => t.status.why }`)\n      match check.place_key(ast.FieldOf { base, name: tagged }) {\n        Some(k) => match get(env, k) {\n          Some(nt) => return nt,\n          None => (),\n        },\n        None => (),\n      }\n      // a call whose function speaks of its variant under a condition only\n      // `verify` decides: the field of the variants left that have it, which\n      // `verify` proves the result is one of (else it faults when it runs)\n      match (i.last_call, check.sum_variants(i, bt)) {\n        ((ls, _, vs, true), Some((_, targs, _))) => if ls == seq\n          && (base is ast.Call || base is ast.MethodCall)\n          && len(check.with_field(i, vs, name)) > 0 {\n          return check.variants_field(\n            mut i,\n            check.with_field(i, vs, name),\n            targs,\n            name,\n            check.shown(check.widened(check.res(i, bt))) ?? \"?\",\n          )\n        },\n        _ => (),\n      }\n      match check.res(i, bt) {\n        // a field of a value that has none\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => {\n          match check.shown(check.res(i, bt)) {\n            Some(x) => check.error(\n              mut i,\n              \"cannot access field `\" + name + \"` on `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          check.TAny\n        },\n        // `p.1`: a tuple's element\n        check.TNamed { name: \"Tuple\", args: targs } => match parse_int(name) {\n          Some(k) => get(targs, k) or {\n            match check.shown(check.res(i, bt)) {\n              Some(x) => check.error(\n                mut i,\n                \"tuple `\" + x + \"` has no element \" + name,\n              ),\n              None => (),\n            }\n            check.TAny\n          },\n          None => check.TAny,\n        },\n        // a field of the one variant a value is narrowed to\n        check.TVariants { names: [v], args: targs, .. } => match get(i.types.ctors, v) {\n          Some(sh) => match check.field_of(sh, name) {\n            Some(ft) => check.inst(ft, check.pairs(sh.params, targs)),\n            None => {\n              check.error(\n                mut i,\n                \"variant `\" + v + \"` has no field `\" + name + \"`\",\n              )\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a field every variant a value is narrowed to has\n        check.TVariants { names, args: targs, .. } => check.variants_field(\n          mut i,\n          names,\n          targs,\n          name,\n          check.shown(check.res(i, bt)) ?? \"?\",\n        ),\n        // a field every member of a union has, with the same type\n        check.TUnion(ms) => {\n          mut out: Option[check.Ty] = None\n          for m in ms {\n            ft := match m {\n              check.TNamed { name: mn, .. } => match get(i.types.ctors, mn) {\n                Some(sh) => check.field_of(sh, name),\n                None => None,\n              },\n              _ => None,\n            }\n            match ft {\n              Some(x) => {\n                out = Some(x)\n              },\n              None => {\n                mt := check.printed(m)\n                ut := check.printed(check.res(i, bt))\n                check.error(\n                  mut i,\n                  f\"`{mt}` has no field `{name}`, so not every `{ut}` does (match on it first)\",\n                )\n                return check.TAny\n              },\n            }\n          }\n          out ?? check.TAny\n        },\n        // a type parameter's field, by its structural bound\n        check.TGen(p) => match get(i.trows, p) {\n          Some(fs) => match fs.filter(x -> x.0 == name) {\n            [x, ..] => x.1,\n            _ => {\n              check.error(\n                mut i,\n                f\"`{check.row_text(fs)}` has no field `{name}` (a value of a structural type has only the fields it names)\",\n              )\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a sum's field: one every variant has\n        check.TNamed { name: n, args: targs } => if contains(i.types.sums, n) && !contains(i.types.ctors, n) {\n          check.variants_field(\n            mut i,\n            get(i.types.variants, n) ?? [],\n            targs,\n            name,\n            check.shown(check.res(i, bt)) ?? n,\n          )\n        } else {\n          match get(i.types.ctors, n) {\n            // a record type; a sum's name is not a constructor\n            Some(sh) => match check.field_of(sh, name) {\n              Some(ft) => {\n                mut m := Dict[String, check.Ty] {}\n                for (k, p) in enumerate(sh.params) {\n                  mut m.insert(p, get(targs, k) ?? check.TAny)\n                }\n                check.inst(ft, m)\n              },\n              None => {\n                check.error(mut i, \"type `\"\n                  + n\n                  + \"` has no field `\"\n                  + name\n                  + \"` (match on variants to access their fields)\")\n                check.TAny\n              },\n            },\n            None => check.TAny,\n          }\n        },\n        _ => check.TAny,\n      }\n    },\n    // `mut q.claim(2)`: a call that changes its receiver\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => match check.untag(name) {\n      // a tagged call: its receiver's type is kept, as `infer` keeps it. A call\n      // spreading records, tagged by `spread_bound`, is written out.\n      Some(nk) => if starts_with(nk.1, \"s\") {\n        check.infer_spread(mut i, e, nk.1, env, expected)\n      } else {\n        rt := check.infer(mut i, recv, env, None)\n        mut i.insts.insert(nk.1 + \":recv\", rt)\n        t := check.infer_method(mut i, recv, nk.0, args, env, true)\n        mut i.insts.insert(nk.1, t)\n        t\n      },\n      None => check.infer_method(mut i, recv, name, args, env, true),\n    },\n    ast.MutExpr(x) => check.infer(mut i, x, env, expected),\n    // `r!`, `o?`: the value a `Result` or an `Option` holds\n    // `r except e { fallback }`: the value, or the fallback (of the same\n    // type) with `e` the error\n    // `a..b`: the list of the integers from `a`\n    ast.Comptime(x) => {\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    // `old e`: `e`'s value where the function started, of `e`'s type\n    ast.Old(x) => check.infer(mut i, x, env, expected),\n    ast.Assumed(x) => check.infer(mut i, x, env, expected),\n    // a `scope`'s result can't hold one of its tasks' handles\n    ast.Scope(x) => {\n      held := i.outside\n      i.outside = Some(set(keys(env)))\n      // `scope { …; spawn e }`: the last task's handle isn't its value\n      t := if check.ends_in_spawn(x) {\n        _ := check.infer(mut i, x, env, None)\n        check.TUnit\n      } else {\n        check.infer(mut i, x, env, expected)\n      }\n      i.outside = held\n      if check.holds_task(check.res(i, t)) {\n        match check.shown(check.res(i, t)) {\n          Some(s) => check.error(\n            mut i,\n            \"a task's handle can't leave its `scope` (its result is `\"\n              + s\n              + \"`): await it inside\",\n          ),\n          None => (),\n        }\n      }\n      t\n    },\n    // `spawn e`: a handle to `e`'s value\n    ast.Spawn(x) => {\n      outer := i.ret\n      i.ret = check.TAny\n      held := i.captured\n      i.captured = set(keys(env))\n      t := check.infer(mut i, x, env, None)\n      i.captured = held\n      i.ret = outer\n      // a sender is captured on its own, never inside another value\n      for v in keys(env).sorted() {\n        vt := check.res(i, get(env, v) ?? check.TAny)\n        if !(vt is check.TNamed && check.type_name(vt) == \"Sender\")\n          && check.holds_sender(i, vt, 8)\n          && check.uses(x, v)\n          && !check.rebinds(x, v) {\n          check.error(\n            mut i,\n            \"a task (a `spawn`, a `race` arm) can capture a sender only on its own (a variable holding it): `\"\n              + v\n              + \"` holds one inside\",\n          )\n        }\n      }\n      check.TNamed { name: \"Task\", args: [t] }\n    },\n    // `select`: each arm's operation (`rx.recv()` an `Option`, `tx.send(v)`,\n    // `await h`, `clock.after(d)` with `clock` a clock and `d` a `Duration`),\n    // its name, and its body with the type wanted\n    ast.Select(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.MethodCall { recv, name, args } => if name == \"after\" && len(args) == 1 {\n            ct := check.res(i, check.infer(mut i, recv, env, None))\n            match ct {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(ct) {\n                Some(x) => check.error(\n                  mut i,\n                  \"an `after` arm waits on a clock: `\"\n                    + x\n                    + \"` doesn't implement `Clock` (std.time)\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            dt := check.res(i, check.infer(\n              mut i,\n              get(args, 0) ?? ast.UnitExpr,\n              env,\n              None,\n            ))\n            match dt {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(dt) {\n                Some(x) => check.error(\n                  mut i,\n                  \"the time an `after` arm waits: expected `std.time.Duration`, found `\"\n                    + x\n                    + \"`\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            check.TUnit\n          } else {\n            check.infer(mut i, a.op, env, None)\n          },\n          _ => check.infer(mut i, a.op, env, None),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `race`: each left side is a task's body (a supervised one's result is a\n    // `Result[T, Panic]`), then its name and its body\n    ast.Race(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.SupervisedSpawn(x) => check.TNamed { name: \"Result\", args: [\n            check.task_body(mut i, x, env),\n            check.TNamed { name: \"Panic\", args: [] },\n          ] },\n          op => check.task_body(mut i, op, env),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `supervised spawn e`: a handle to `e`'s value, or its panic\n    ast.SupervisedSpawn(x) => check.TNamed {\n      name: \"Task\",\n      args: [check.TNamed { name: \"Result\", args: [\n        check.task_body(mut i, x, env),\n        check.TNamed { name: \"Panic\", args: [] },\n      ] }],\n    },\n    // `await h`: the task's value, or each task's for a tuple or list of handles\n    ast.Await(x) => {\n      t := check.infer(mut i, x, env, None)\n      check.awaited(mut i, check.res(i, t))\n    },\n    ast.Hole(h) => {\n      t := expected ?? check.fresh(mut i)\n      mut i.holes.push((h, t, env))\n      t\n    },\n    _ => check.TAny,\n  }\n}"},{"name":"check.infer_update","kind":"fn","old":"35312c349bc7e012","new":"d067d85a26409b22","interface_changed":false,"affected":[],"module":"check","text":"/// `{ ..x, f: v }`: of `x`'s type, which has each field given, of a type\n/// that fits.\nfn infer_update(\n  mut i: check.Inf,\n  tag: String,\n  base: ast.Expr,\n  fields: List[(String, ast.Expr)],\n  env: Dict[String, check.Ty],\n) -> check.Ty {\n  bt := check.infer(mut i, base, env, None)\n  mut i.insts.insert(tag, bt)\n  shown_b := check.shown(check.res(i, bt)) ?? \"?\"\n  match check.res(i, bt) {\n    check.TNamed { name, .. } => check.closed_fields(mut i, name),\n    _ => (),\n  }\n  for f in fields {\n    want := match check.res(i, bt) {\n      check.TGen(p) => match get(i.trows, p) {\n        Some(fs) => match fs.filter(x -> x.0 == f.0) {\n          [x, ..] => Some(x.1),\n          _ => None,\n        },\n        None => None,\n      },\n      check.TNamed { name, args } => match get(i.types.ctors, name) {\n        Some(sh) => if sh.positional || sh.owner != name {\n          None\n        } else {\n          match check.field_of(sh, f.0) {\n            Some(ft) => Some(check.inst(ft, check.pairs(sh.params, args))),\n            None => None,\n          }\n        },\n        None => None,\n      },\n      _ => Some(check.TAny),\n    }\n    match want {\n      Some(w) => {\n        got := check.infer(mut i, f.1, env, Some(w))\n        if !check.fits(mut i, w, got) {\n          mut i.spread_errs.push(\n            f\"`{{ ..{text.expr_text(base, 0)}, {f.0}: … }}`: field `{f.0}` of `{shown_b}` is `{check.shown(check.res(i, w)) ?? \"?\"}`, not `{check.shown(check.res(i, got)) ?? \"?\"}`\",\n          )\n        }\n      },\n      None => mut i.spread_errs.push(\n        f\"`{{ ..{text.expr_text(base, 0)}, {f.0}: … }}`: `{shown_b}` has no field `{f.0}`\",\n      ),\n    }\n  }\n  bt\n}","old_text":"/// `{ ..x, f: v }`: of `x`'s type, which has each field given, of a type\n/// that fits.\nfn infer_update(\n  mut i: check.Inf,\n  tag: String,\n  base: ast.Expr,\n  fields: List[(String, ast.Expr)],\n  env: Dict[String, check.Ty],\n) -> check.Ty {\n  bt := check.infer(mut i, base, env, None)\n  mut i.insts.insert(tag, bt)\n  shown_b := check.shown(check.res(i, bt)) ?? \"?\"\n  for f in fields {\n    want := match check.res(i, bt) {\n      check.TGen(p) => match get(i.trows, p) {\n        Some(fs) => match fs.filter(x -> x.0 == f.0) {\n          [x, ..] => Some(x.1),\n          _ => None,\n        },\n        None => None,\n      },\n      check.TNamed { name, args } => match get(i.types.ctors, name) {\n        Some(sh) => if sh.positional || sh.owner != name {\n          None\n        } else {\n          match check.field_of(sh, f.0) {\n            Some(ft) => Some(check.inst(ft, check.pairs(sh.params, args))),\n            None => None,\n          }\n        },\n        None => None,\n      },\n      _ => Some(check.TAny),\n    }\n    match want {\n      Some(w) => {\n        got := check.infer(mut i, f.1, env, Some(w))\n        if !check.fits(mut i, w, got) {\n          mut i.spread_errs.push(\n            f\"`{{ ..{text.expr_text(base, 0)}, {f.0}: … }}`: field `{f.0}` of `{shown_b}` is `{check.shown(check.res(i, w)) ?? \"?\"}`, not `{check.shown(check.res(i, got)) ?? \"?\"}`\",\n          )\n        }\n      },\n      None => mut i.spread_errs.push(\n        f\"`{{ ..{text.expr_text(base, 0)}, {f.0}: … }}`: `{shown_b}` has no field `{f.0}`\",\n      ),\n    }\n  }\n  bt\n}"},{"name":"check.closed_fields","kind":"fn","old":null,"new":"28e9b3d904bba70e","interface_changed":true,"affected":[],"module":"check","text":"/// A field of a value of type `n` read or changed: an error outside `n`'s\n/// module and its submodules when `n` is a record that isn't `pub`.\nfn closed_fields(mut i: check.Inf, n: String) {\n  match (get(i.types.private, n), i.types.module) {\n    (Some(m), Some(here)) => if here != m && !starts_with(here, m + \".\") {\n      check.error(\n        mut i,\n        f\"`{n}` is private to module `{m}`, so its fields can't be read or changed outside it (only `pub` definitions are part of its contract)\",\n      )\n    },\n    _ => (),\n  }\n}"}]}
{"id":"4abbda91b6818106","time":1795835291,"message":"edit","changes":[{"name":"check.lower","kind":"fn","old":"44411a78edb7e2ed","new":"9ff511c7e06f4999","interface_changed":false,"affected":[],"module":"check","text":"/// A written type as a checker type. `types`: the types modelled. `tps`:\n/// the type parameters in scope.\nfn lower(types: check.Types, tps: Set[String], t: ast.TypeExpr) -> check.Ty {\n  match t {\n    ast.Named { name, args } => if len(args) == 0 && contains(tps, name) {\n      check.TGen(name)\n    } else if len(args) == 0 && name == \"Int\" {\n      check.TInt\n    } else if len(args) == 0 && name == \"Float\" {\n      check.TFloat\n    } else if len(args) == 0 && name == \"Bool\" {\n      check.TBool\n    } else if len(args) == 0 && name == \"String\" {\n      check.TStr\n    } else if len(args) == 0 && name == \"Real\" {\n      check.real_ty()\n    } else if len(args) == 0 && check.is_sized(name) {\n      // a sized integer: a type of its own\n      check.TNamed { name, args: [] }\n    } else if len(args) == 0 && check.refined_int(name) {\n      // the prelude's refinements are their base type\n      check.TInt\n    } else if len(args) == 0\n      && (name == \"Probability\" || name == \"Percentage\") {\n      check.TFloat\n    } else if len(args) == 0 && name == \"NonEmptyString\" {\n      check.TStr\n    } else if name == \"NonEmpty\" && len(args) == 1 {\n      check.TList(\n        check.lower(types, tps, get(args, 0) ?? ast.UnitType),\n      )\n    } else if len(args) == 0 && contains(types.traits, name) {\n      check.TTrait(name)\n    } else if len(args) == 0 && contains(types.aliases, name) {\n      // an alias is what it stands for, expanded once so aliases can't loop\n      match get(types.aliases, name) {\n        Some(a) => check.lower(check.Types { ..types, aliases: {\n          mut copy := types.aliases\n          mut copy.remove(name)\n          copy\n        } }, tps, a),\n        None => check.TAny,\n      }\n    } else if contains(types.generic_aliases, name) {\n      // a generic alias is what it stands for, with its arguments, expanded\n      // once so aliases can't loop\n      match get(types.generic_aliases, name) {\n        Some((ps, body)) => if len(ps) == len(args) {\n          mut m := Dict[String, check.Ty] {}\n          for (k, p) in enumerate(ps) {\n            mut m.insert(\n              p,\n              check.lower(types, tps, get(args, k) ?? ast.UnitType),\n            )\n          }\n          inner := check.Types { ..types, generic_aliases: {\n            mut copy := types.generic_aliases\n            mut copy.remove(name)\n            copy\n          } }\n          check.inst(check.lower(inner, set(ps), body), m)\n        } else {\n          check.TAny\n        },\n        None => check.TAny,\n      }\n    } else if name == \"Tuple\" {\n      check.TNamed {\n        name,\n        args: args.map(x -> check.lower(types, tps, x)),\n      }\n    } else if name == \"List\" && len(args) == 1 {\n      check.TList(\n        check.lower(types, tps, get(args, 0) ?? ast.UnitType),\n      )\n    } else {\n      match get(types.named, name) {\n        Some(ps) => if len(ps) == len(args) {\n          mut xs := []\n          for a in args {\n            mut xs.push(check.lower(types, tps, a))\n          }\n          check.TNamed { name, args: xs }\n        } else {\n          check.TAny\n        },\n        None => check.TAny,\n      }\n    },\n    ast.UnitType => check.TUnit,\n    ast.Refined { base, .. } => check.lower(types, tps, base),\n    ast.RowType(_) => check.TAny,\n    ast.UnionType(ms) => check.union_of(ms.map(x -> check.lower(types, tps, x))),\n    ast.FnType { params, ret } => check.TFn {\n      params: params.map(x -> check.lower(types, tps, x)),\n      ret: check.lower(types, tps, ret),\n    },\n  }\n}","old_text":"/// A written type as a checker type. `types`: the types modelled. `tps`:\n/// the type parameters in scope.\nfn lower(types: check.Types, tps: Set[String], t: ast.TypeExpr) -> check.Ty {\n  match t {\n    ast.Named { name, args } => if len(args) == 0 && contains(tps, name) {\n      check.TGen(name)\n    } else if len(args) == 0 && name == \"Int\" {\n      check.TInt\n    } else if len(args) == 0 && name == \"Float\" {\n      check.TFloat\n    } else if len(args) == 0 && name == \"Bool\" {\n      check.TBool\n    } else if len(args) == 0 && name == \"String\" {\n      check.TStr\n    } else if len(args) == 0 && check.is_sized(name) {\n      // a sized integer: a type of its own\n      check.TNamed { name, args: [] }\n    } else if len(args) == 0 && check.refined_int(name) {\n      // the prelude's refinements are their base type\n      check.TInt\n    } else if len(args) == 0\n      && (name == \"Probability\" || name == \"Percentage\") {\n      check.TFloat\n    } else if len(args) == 0 && name == \"NonEmptyString\" {\n      check.TStr\n    } else if name == \"NonEmpty\" && len(args) == 1 {\n      check.TList(\n        check.lower(types, tps, get(args, 0) ?? ast.UnitType),\n      )\n    } else if len(args) == 0 && contains(types.traits, name) {\n      check.TTrait(name)\n    } else if len(args) == 0 && contains(types.aliases, name) {\n      // an alias is what it stands for, expanded once so aliases can't loop\n      match get(types.aliases, name) {\n        Some(a) => check.lower(check.Types { ..types, aliases: {\n          mut copy := types.aliases\n          mut copy.remove(name)\n          copy\n        } }, tps, a),\n        None => check.TAny,\n      }\n    } else if contains(types.generic_aliases, name) {\n      // a generic alias is what it stands for, with its arguments, expanded\n      // once so aliases can't loop\n      match get(types.generic_aliases, name) {\n        Some((ps, body)) => if len(ps) == len(args) {\n          mut m := Dict[String, check.Ty] {}\n          for (k, p) in enumerate(ps) {\n            mut m.insert(\n              p,\n              check.lower(types, tps, get(args, k) ?? ast.UnitType),\n            )\n          }\n          inner := check.Types { ..types, generic_aliases: {\n            mut copy := types.generic_aliases\n            mut copy.remove(name)\n            copy\n          } }\n          check.inst(check.lower(inner, set(ps), body), m)\n        } else {\n          check.TAny\n        },\n        None => check.TAny,\n      }\n    } else if name == \"Tuple\" {\n      check.TNamed {\n        name,\n        args: args.map(x -> check.lower(types, tps, x)),\n      }\n    } else if name == \"List\" && len(args) == 1 {\n      check.TList(\n        check.lower(types, tps, get(args, 0) ?? ast.UnitType),\n      )\n    } else {\n      match get(types.named, name) {\n        Some(ps) => if len(ps) == len(args) {\n          mut xs := []\n          for a in args {\n            mut xs.push(check.lower(types, tps, a))\n          }\n          check.TNamed { name, args: xs }\n        } else {\n          check.TAny\n        },\n        None => check.TAny,\n      }\n    },\n    ast.UnitType => check.TUnit,\n    ast.Refined { base, .. } => check.lower(types, tps, base),\n    ast.RowType(_) => check.TAny,\n    ast.UnionType(ms) => check.union_of(ms.map(x -> check.lower(types, tps, x))),\n    ast.FnType { params, ret } => check.TFn {\n      params: params.map(x -> check.lower(types, tps, x)),\n      ret: check.lower(types, tps, ret),\n    },\n  }\n}"}]}
{"id":"f655b8cf909091e6","time":1795835385,"message":"edit","changes":[{"name":"smt.annotated","kind":"fn","old":"7d432cbe18f31a15","new":"d4a30fcebf6bcf97","interface_changed":false,"affected":[],"module":"smt","text":"/// Checks a value against the type its `let` is annotated with.\nfn annotated(mut vc: smt.Vc, ty: Option[ast.TypeExpr], v: smt.Val) {\n  match ty {\n    Some(t) => if smt.refined(vc, t) {\n      smt.own_refinements(mut vc, t, v, [])\n      mut parts := Set[String] {}\n      smt.own_parts(mut vc, t, [], mut parts, 0)\n      if smt.start_goal(mut vc) {\n        g := smt.check_type(mut vc, t, v, [])\n        smt.oblige(\n          mut vc,\n          \"`let` annotated `\" + text.type_text(t) + \"`\",\n          g,\n        )\n      }\n      // past the check, the elements are valid on this path\n      match (v, smt.expand_alias(vc, t)) {\n        (smt.VList { id, .. }, ast.Named { name: \"List\", args: [et] }) => {\n          t_24 := smt.txs(vc, vc.pc)\n          smt.know_all(\n            mut vc,\n            id,\n            smt.and_all(t_24),\n            smt.FValid(et),\n          )\n        },\n        _ => (),\n      }\n    },\n    None => (),\n  }\n}","old_text":"/// Checks a value against the type its `let` is annotated with.\nfn annotated(mut vc: smt.Vc, ty: Option[ast.TypeExpr], v: smt.Val) {\n  match ty {\n    Some(t) => if smt.refined(vc, t) {\n      if smt.start_goal(mut vc) {\n        g := smt.check_type(mut vc, t, v, [])\n        smt.oblige(\n          mut vc,\n          \"`let` annotated `\" + text.type_text(t) + \"`\",\n          g,\n        )\n      }\n      // past the check, the elements are valid on this path\n      match (v, smt.expand_alias(vc, t)) {\n        (smt.VList { id, .. }, ast.Named { name: \"List\", args: [et] }) => {\n          t_24 := smt.txs(vc, vc.pc)\n          smt.know_all(\n            mut vc,\n            id,\n            smt.and_all(t_24),\n            smt.FValid(et),\n          )\n        },\n        _ => (),\n      }\n    },\n    None => (),\n  }\n}"},{"name":"smt.function","kind":"fn","old":"fb160b63a6a90d1d","new":"d0c0752599781ad0","interface_changed":false,"affected":[],"module":"smt","text":"/// Runs `f` symbolically, collecting its obligations and what it uses that\n/// smt doesn't model (`gaps`).\npub fn function(mut vc: smt.Vc, f: ast.FnDecl, label: String) {\n  vc.self_name = label\n  vc.own_name = f.name\n  smt.rows_as_records(mut vc, f)\n  // a lemma, or a law (its wrapper, `strata_verify_K_law_NAME`), is a\n  // proof: spec functions are seen through (`in_proof`)\n  if f.lemma\n    || contains(label, \"strata_verify_\") && contains(label, \"_law_\") {\n    vc.proof_from = 0\n  }\n  vc.own_whiles = smt.while_loops(f.body)\n  for p in f.params {\n    v := smt.shape(mut vc, p.ty)\n    smt.own_refinements(mut vc, p.ty, v, [])\n    smt.assume(mut vc, smt.check_type(mut vc, p.ty, v, []))\n    if p.mutable {\n      smt.declare(mut vc, p.name, Some(p.ty))\n      mut vc.mut_params.push(p.name)\n    }\n    mut vc.params.push((p.name, v))\n    smt.bind(mut vc, p.name, v)\n  }\n  // the lists' first elements, for a counterexample to show (their facts\n  // set aside): one level of nested lists, bounded in terms\n  if vc.examples {\n    nf := len(vc.facts)\n    mut lens := []\n    mut ls := []\n    vc.input_depth = 1\n    for (_, v) in vc.params {\n      smt.open_input(mut vc, v, 0, mut lens, mut ls)\n    }\n    vc.input_depth = 3\n    vc.example_facts = drop(vc.facts, nf)\n    vc.facts = take(vc.facts, nf)\n    vc.example_leaves = ls\n  }\n  binds := vc.params\n  mut parts := Set[String] {}\n  for p in f.params {\n    smt.own_parts(mut vc, p.ty, [], mut parts, 0)\n  }\n  smt.own_parts(mut vc, f.ret, binds, mut parts, 0)\n  for r in f.pre {\n    c := smt.own_pred(mut vc, r, binds, None)\n    smt.push_pc(mut vc, c)\n  }\n  for m in text.decreases_of(f.body) {\n    _ := smt.own_val(mut vc, m, binds, None)\n  }\n  // what a loop may need to keep: the `ensures` of the returned variable,\n  // and those of a `mut` parameter that don't name the result\n  match f.body {\n    ast.Block { last: ast.Var(x), .. } => {\n      vc.hints = f.post.map(e -> (e, x))\n      vc.returned = Some((x, f.ret))\n    },\n    _ => (),\n  }\n  for p in f.params {\n    if p.mutable {\n      for e in f.post {\n        names := smt.var_names(e)\n        if contains(names, p.name)\n          && !contains(names, \"it\")\n          && !vc.hints.any(h -> h.0 == e && h.1 == p.name) {\n          mut vc.hints.push((e, p.name))\n        }\n      }\n    }\n  }\n  vc.result_text = match f.body {\n    ast.Block { last, .. } => text.expr_text(last, 0),\n    other => text.expr_text(other, 0),\n  }\n  vc.requires_hints = f.pre\n  res := smt.eval(mut vc, f.body)\n  // the result is checked where the body ends and at every early return\n  mut exits := []\n  if !vc.dead {\n    mut exits.push((vc.pc, res, \"\", smt.mut_state(vc)))\n  }\n  for x in vc.returns {\n    mut exits.push((x.pc, x.value, \" (early return)\", x.state))\n  }\n  vc.returns = []\n  shown := smt.shown_name(label)\n  for (pc, value, how, state) in exits {\n    vc.pc = pc\n    vc.dead = false\n    // the `ensures` name the `mut` parameters as they are at this exit,\n    // `old x` as they were on entry\n    after := smt.rebound(binds, state)\n    if smt.refined(vc, f.ret) {\n      smt.own_refinements(mut vc, f.ret, value, binds)\n      if smt.start_goal(mut vc) {\n        g := smt.check_type(mut vc, f.ret, value, binds)\n        smt.oblige(\n          mut vc,\n          f\"result of `{shown}`{how}: {text.type_text(f.ret)}\",\n          g,\n        )\n      }\n    }\n    for en in f.post {\n      n := len(vc.pc)\n      // (evaluated as a goal, though its own checks are made first)\n      vc.proving += 1\n      g := smt.own_pred(mut vc, en, after + [(\"it\", value)], Some(binds))\n      vc.proving -= 1\n      if smt.start_goal(mut vc) {\n        smt.oblige(\n          mut vc,\n          f\"ensures {text.expr_text(en, 0)}{how}\",\n          g,\n        )\n      }\n      vc.pc = take(vc.pc, n)\n    }\n  }\n}","old_text":"/// Runs `f` symbolically, collecting its obligations and what it uses that\n/// smt doesn't model (`gaps`).\npub fn function(mut vc: smt.Vc, f: ast.FnDecl, label: String) {\n  vc.self_name = label\n  vc.own_name = f.name\n  smt.rows_as_records(mut vc, f)\n  // a lemma, or a law (its wrapper, `strata_verify_K_law_NAME`), is a\n  // proof: spec functions are seen through (`in_proof`)\n  if f.lemma\n    || contains(label, \"strata_verify_\") && contains(label, \"_law_\") {\n    vc.proof_from = 0\n  }\n  vc.own_whiles = smt.while_loops(f.body)\n  for p in f.params {\n    v := smt.shape(mut vc, p.ty)\n    smt.own_refinements(mut vc, p.ty, v, [])\n    smt.assume(mut vc, smt.check_type(mut vc, p.ty, v, []))\n    if p.mutable {\n      smt.declare(mut vc, p.name, Some(p.ty))\n      mut vc.mut_params.push(p.name)\n    }\n    mut vc.params.push((p.name, v))\n    smt.bind(mut vc, p.name, v)\n  }\n  // the lists' first elements, for a counterexample to show (their facts\n  // set aside): one level of nested lists, bounded in terms\n  if vc.examples {\n    nf := len(vc.facts)\n    mut lens := []\n    mut ls := []\n    vc.input_depth = 1\n    for (_, v) in vc.params {\n      smt.open_input(mut vc, v, 0, mut lens, mut ls)\n    }\n    vc.input_depth = 3\n    vc.example_facts = drop(vc.facts, nf)\n    vc.facts = take(vc.facts, nf)\n    vc.example_leaves = ls\n  }\n  binds := vc.params\n  for r in f.pre {\n    c := smt.own_pred(mut vc, r, binds, None)\n    smt.push_pc(mut vc, c)\n  }\n  for m in text.decreases_of(f.body) {\n    _ := smt.own_val(mut vc, m, binds, None)\n  }\n  // what a loop may need to keep: the `ensures` of the returned variable,\n  // and those of a `mut` parameter that don't name the result\n  match f.body {\n    ast.Block { last: ast.Var(x), .. } => {\n      vc.hints = f.post.map(e -> (e, x))\n      vc.returned = Some((x, f.ret))\n    },\n    _ => (),\n  }\n  for p in f.params {\n    if p.mutable {\n      for e in f.post {\n        names := smt.var_names(e)\n        if contains(names, p.name)\n          && !contains(names, \"it\")\n          && !vc.hints.any(h -> h.0 == e && h.1 == p.name) {\n          mut vc.hints.push((e, p.name))\n        }\n      }\n    }\n  }\n  vc.result_text = match f.body {\n    ast.Block { last, .. } => text.expr_text(last, 0),\n    other => text.expr_text(other, 0),\n  }\n  vc.requires_hints = f.pre\n  res := smt.eval(mut vc, f.body)\n  // the result is checked where the body ends and at every early return\n  mut exits := []\n  if !vc.dead {\n    mut exits.push((vc.pc, res, \"\", smt.mut_state(vc)))\n  }\n  for x in vc.returns {\n    mut exits.push((x.pc, x.value, \" (early return)\", x.state))\n  }\n  vc.returns = []\n  shown := smt.shown_name(label)\n  for (pc, value, how, state) in exits {\n    vc.pc = pc\n    vc.dead = false\n    // the `ensures` name the `mut` parameters as they are at this exit,\n    // `old x` as they were on entry\n    after := smt.rebound(binds, state)\n    if smt.refined(vc, f.ret) {\n      smt.own_refinements(mut vc, f.ret, value, binds)\n      if smt.start_goal(mut vc) {\n        g := smt.check_type(mut vc, f.ret, value, binds)\n        smt.oblige(\n          mut vc,\n          f\"result of `{shown}`{how}: {text.type_text(f.ret)}\",\n          g,\n        )\n      }\n    }\n    for en in f.post {\n      n := len(vc.pc)\n      // (evaluated as a goal, though its own checks are made first)\n      vc.proving += 1\n      g := smt.own_pred(mut vc, en, after + [(\"it\", value)], Some(binds))\n      vc.proving -= 1\n      if smt.start_goal(mut vc) {\n        smt.oblige(\n          mut vc,\n          f\"ensures {text.expr_text(en, 0)}{how}\",\n          g,\n        )\n      }\n      vc.pc = take(vc.pc, n)\n    }\n  }\n}"},{"name":"smt.own_parts","kind":"fn","old":null,"new":"30c18d8430dbdc03","interface_changed":true,"affected":[],"module":"smt","text":"/// The checks inside the refinements nested in `t` (in its type arguments,\n/// fields, payloads and union members, at any depth) as obligations, each\n/// on any value of its type. `extra`: what an inline refinement sees besides\n/// `it`; `seen`: the types already done.\nfn own_parts(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  extra: List[(String, smt.Val)],\n  mut seen: Set[String],\n  depth: Int,\n) {\n  for c in smt.type_parts(vc, t) {\n    key := text.type_text(c)\n    if !contains(seen, key) && smt.refined(vc, c) {\n      mut seen.insert(key)\n      if depth >= 8 {\n        if smt.start_goal(mut vc) {\n          g := smt.unknown_bool(\n            mut vc,\n            \"a refinement nested more than 8 types deep\",\n          )\n          smt.oblige(mut vc, f\"the checks inside `{key}`\", g)\n        }\n      } else {\n        v := smt.shape(mut vc, c)\n        smt.own_refinements(mut vc, c, v, extra)\n        smt.own_parts(mut vc, c, extra, mut seen, depth + 1)\n      }\n    }\n  }\n}"},{"name":"smt.type_parts","kind":"fn","old":null,"new":"807e654d4bcd41dc","interface_changed":true,"affected":[],"module":"smt","text":"/// The types directly inside `t`: its type arguments, an alias's parts, a\n/// record's fields, a sum's payloads, a union's members.\nfn type_parts(vc: smt.Vc, t: ast.TypeExpr) -> List[ast.TypeExpr] {\n  match t {\n    ast.Refined { base, .. } => smt.type_parts(vc, base),\n    ast.UnionType(ms) => ms,\n    ast.RowType(fs) => fs.map(f -> f.1),\n    ast.FnType { .. } | ast.UnitType => [],\n    ast.Named { name, args } => match get(vc.types, name) {\n      None => args,\n      Some(td) => {\n        sub := smt.params_of(td, args)\n        match td.body {\n          ast.Alias(a) => smt.type_parts(vc, smt.subst(a, sub)),\n          ast.RecordBody(fs) => fs.map(f -> smt.subst(f.ty, sub)),\n          ast.SumBody(vs) => {\n            mut out := []\n            for v in vs {\n              match v.payload {\n                ast.NoPayload => (),\n                ast.Positional(ts) => {\n                  out += ts.map(x -> smt.subst(x, sub))\n                },\n                ast.RecordPayload(fs) => {\n                  out += fs.map(f -> smt.subst(f.ty, sub))\n                },\n                ast.MemberType(m) => mut out.push(smt.subst(m, sub)),\n              }\n            }\n            out\n          },\n        }\n      },\n    },\n  }\n}"}]}
{"id":"613f2a19387e4ab3","time":1795835541,"message":"edit","changes":[{"name":"smt.element_at_inner","kind":"fn","old":"9ea21822cdbedbf6","new":"0332eed2f8f417d7","interface_changed":false,"affected":[],"module":"smt","text":"fn element_at_inner(mut vc: smt.Vc, id: Int, i: String) -> Option[smt.Val] {\n  if !smt.positional(vc, id) {\n    return None\n  }\n  x := match smt.list_info(vc, id).source {\n    smt.GType(_) => smt.instance(mut vc, id, i)?,\n    smt.GSeq(s, t, n) => {\n      x := smt.from_term(mut vc, t, smt.seq_at(n, s, i))\n      // an item of a valid list is valid\n      if smt.refined(vc, t) {\n        all := smt.valid_term(\n          mut vc,\n          ast.Named { name: \"List\", args: [t] },\n          s,\n        )\n        vc.spec += 1\n        c := smt.check_type(mut vc, t, x, [])\n        vc.spec -= 1\n        smt.assume(mut vc, smt.implies(all, c))\n      }\n      x\n    },\n    smt.GValues(vs) => if len(vs) == 0 {\n      smt.assume(mut vc, \"false\")\n      smt.Opaque(\"an element of an empty list\")\n    } else {\n      mut v := get(vs, len(vs) - 1) ?? smt.Inactive\n      mut k := len(vs) - 2\n      while k >= 0 {\n        v = smt.merge(\n          mut vc,\n          f\"(= {i} {k})\",\n          get(vs, k) ?? smt.Inactive,\n          v,\n        )\n        k -= 1\n      }\n      v\n    },\n    smt.GRange(lo, _) => smt.vint(mut vc, f\"(+ {lo} {i})\"),\n    smt.GEnum(p, _) => smt.VTuple([smt.vint(mut vc, i), smt.item_at(mut vc, p, i)]),\n    smt.GZip(a, b, _) => smt.VTuple(\n      [smt.item_at(mut vc, a, i), smt.item_at(mut vc, b, i)],\n    ),\n    smt.GShift(p, off) => smt.element_at_inner(mut vc, p, f\"(+ {off} {i})\")?,\n    smt.GRev(p, l) => smt.element_at_inner(mut vc, p, f\"(- {l} 1 {i})\")?,\n    smt.GMap(p, f) => {\n      y := smt.element_at_inner(mut vc, p, i)?\n      smt.element_applied(mut vc, f, y)\n    },\n    smt.GConcat(a, b, la) => smt.positions_either(\n      mut vc,\n      f\"(< {i} {la})\",\n      a,\n      i,\n      b,\n      f\"(- {i} {la})\",\n    )?,\n    smt.GEither(c, a, b) => smt.positions_either(mut vc, c, a, i, b, i)?,\n    _ => return None,\n  }\n  smt.known_of_at(mut vc, id, x, i)\n  if vc.in_same == 0 {\n    for (g, other) in smt.list_info(vc, id).same {\n      vc.in_same += 1\n      match smt.element_at_inner(mut vc, other, i) {\n        Some(y) => {\n          e := smt.eq(mut vc, x, y)\n          smt.push_fact(mut vc, smt.implies(g, e))\n        },\n        None => (),\n      }\n      vc.in_same -= 1\n    }\n  }\n  Some(x)\n}","old_text":"fn element_at_inner(mut vc: smt.Vc, id: Int, i: String) -> Option[smt.Val] {\n  if !smt.positional(vc, id) {\n    return None\n  }\n  x := match smt.list_info(vc, id).source {\n    smt.GType(_) => smt.instance(mut vc, id, i)?,\n    smt.GSeq(s, t, n) => {\n      x := smt.from_term(mut vc, t, smt.seq_at(n, s, i))\n      // an item of a valid list is valid\n      if smt.refined(vc, t) {\n        all := smt.valid_term(\n          mut vc,\n          ast.Named { name: \"List\", args: [t] },\n          s,\n        )\n        vc.spec += 1\n        c := smt.check_type(mut vc, t, x, [])\n        vc.spec -= 1\n        smt.assume(mut vc, smt.implies(all, c))\n      }\n      x\n    },\n    smt.GValues(vs) => if len(vs) == 0 {\n      smt.assume(mut vc, \"false\")\n      smt.Opaque(\"an element of an empty list\")\n    } else {\n      mut v := get(vs, len(vs) - 1) ?? smt.Inactive\n      mut k := len(vs) - 2\n      while k >= 0 {\n        v = smt.merge(\n          mut vc,\n          f\"(= {i} {k})\",\n          get(vs, k) ?? smt.Inactive,\n          v,\n        )\n        k -= 1\n      }\n      v\n    },\n    smt.GRange(lo, _) => smt.vint(mut vc, f\"(+ {lo} {i})\"),\n    smt.GEnum(p, _) => smt.VTuple([smt.vint(mut vc, i), smt.item_at(mut vc, p, i)]),\n    smt.GZip(a, b, _) => smt.VTuple(\n      [smt.item_at(mut vc, a, i), smt.item_at(mut vc, b, i)],\n    ),\n    smt.GShift(p, off) => smt.element_at_inner(mut vc, p, f\"(+ {off} {i})\")?,\n    smt.GRev(p, l) => smt.element_at_inner(mut vc, p, f\"(- {l} 1 {i})\")?,\n    smt.GMap(p, f) => {\n      y := smt.element_at_inner(mut vc, p, i)?\n      smt.apply(mut vc, f, y)\n    },\n    smt.GConcat(a, b, la) => smt.positions_either(\n      mut vc,\n      f\"(< {i} {la})\",\n      a,\n      i,\n      b,\n      f\"(- {i} {la})\",\n    )?,\n    smt.GEither(c, a, b) => smt.positions_either(mut vc, c, a, i, b, i)?,\n    _ => return None,\n  }\n  smt.known_of_at(mut vc, id, x, i)\n  if vc.in_same == 0 {\n    for (g, other) in smt.list_info(vc, id).same {\n      vc.in_same += 1\n      match smt.element_at_inner(mut vc, other, i) {\n        Some(y) => {\n          e := smt.eq(mut vc, x, y)\n          smt.push_fact(mut vc, smt.implies(g, e))\n        },\n        None => (),\n      }\n      vc.in_same -= 1\n    }\n  }\n  Some(x)\n}"},{"name":"smt.element_inner","kind":"fn","old":"d2596adb955d544e","new":"9fecebf004a5f02c","interface_changed":false,"affected":[],"module":"smt","text":"fn element_inner(mut vc: smt.Vc, id: Int) -> smt.Val {\n  x := match smt.list_info(vc, id).source {\n    smt.Untracked => smt.Opaque(\"the elements of a list are not tracked\"),\n    smt.GType(t) => smt.havoc(mut vc, t),\n    // an item at some position\n    smt.GSeq(s, _, n) => {\n      k := smt.fresh(mut vc, \"Int\")\n      smt.assume(\n        mut vc,\n        f\"(and (<= 0 {k}) (< {k} {smt.seq_len(n, s)}))\",\n      )\n      return smt.element_at_inner(mut vc, id, k) ?? smt.Opaque(\"an element\")\n    },\n    smt.GValues(vs) => if len(vs) == 0 {\n      // a list literal `[]` has no element: this one doesn't exist\n      smt.assume(mut vc, \"false\")\n      smt.Opaque(\"an element of an empty list\")\n    } else {\n      k := smt.fresh(mut vc, \"Int\")\n      smt.assume(mut vc, f\"(and (<= 0 {k}) (< {k} {len(vs)}))\")\n      mut v := get(vs, len(vs) - 1) ?? smt.Inactive\n      mut i := len(vs) - 2\n      while i >= 0 {\n        v = smt.merge(\n          mut vc,\n          f\"(= {k} {i})\",\n          get(vs, i) ?? smt.Inactive,\n          v,\n        )\n        i -= 1\n      }\n      v\n    },\n    smt.GRange(lo, hi) => {\n      x := smt.fresh(mut vc, \"Int\")\n      smt.assume(mut vc, f\"(and (<= {lo} {x}) (< {x} {hi}))\")\n      smt.vint(mut vc, x)\n    },\n    smt.GItems(t) => smt.item_of(mut vc, id, t),\n    // `(k, x)`: some position `k` and an element, taken as any element\n    // instead of the one at `k`. By position, the facts every `for` over\n    // `enumerate` adds made the solver slow.\n    smt.GEnum(p, l) => {\n      k := smt.fresh(mut vc, \"Int\")\n      smt.assume(mut vc, f\"(and (<= 0 {k}) (< {k} {l}))\")\n      x := smt.element_inner(mut vc, p)\n      smt.VTuple([smt.vint(mut vc, k), x])\n    },\n    smt.GZip(a, b, _) => {\n      x := smt.element_inner(mut vc, a)\n      y := smt.element_inner(mut vc, b)\n      smt.VTuple([x, y])\n    },\n    smt.GSub(p) | smt.GShift(p, _) | smt.GRev(p, _) => smt.element_inner(mut vc, p),\n    // an element of `a + b` is one of `a`'s or one of `b`'s\n    smt.GConcat(a, b, _) => {\n      c := smt.fresh(mut vc, \"Bool\")\n      n := len(vc.pc)\n      smt.push_pc(mut vc, c)\n      ea := smt.element_inner(mut vc, a)\n      vc.pc = take(vc.pc, n)\n      smt.push_pc(mut vc, smt.neg(c))\n      eb := smt.element_inner(mut vc, b)\n      vc.pc = take(vc.pc, n)\n      smt.merge(mut vc, c, ea, eb)\n    },\n    smt.GFilter(p, f) => {\n      x := smt.element_inner(mut vc, p)\n      cv := smt.element_applied(mut vc, f, x)\n      c := smt.as_bool(mut vc, cv)\n      smt.assume(mut vc, c)\n      x\n    },\n    smt.GMap(p, f) => {\n      y := smt.element_inner(mut vc, p)\n      smt.element_applied(mut vc, f, y)\n    },\n    smt.GEither(c, a, b) => if smt.is_empty_literal(vc, a) {\n      // one side is `[]`: the element is from the other one\n      smt.assume(mut vc, smt.neg(c))\n      smt.element_inner(mut vc, b)\n    } else if smt.is_empty_literal(vc, b) {\n      smt.assume(mut vc, c)\n      smt.element_inner(mut vc, a)\n    } else {\n      n := len(vc.pc)\n      smt.push_pc(mut vc, c)\n      ea := smt.element_inner(mut vc, a)\n      vc.pc = take(vc.pc, n)\n      smt.push_pc(mut vc, smt.neg(c))\n      eb := smt.element_inner(mut vc, b)\n      vc.pc = take(vc.pc, n)\n      smt.merge(mut vc, c, ea, eb)\n    },\n  }\n  smt.known_of(mut vc, id, x)\n  x\n}","old_text":"fn element_inner(mut vc: smt.Vc, id: Int) -> smt.Val {\n  x := match smt.list_info(vc, id).source {\n    smt.Untracked => smt.Opaque(\"the elements of a list are not tracked\"),\n    smt.GType(t) => smt.havoc(mut vc, t),\n    // an item at some position\n    smt.GSeq(s, _, n) => {\n      k := smt.fresh(mut vc, \"Int\")\n      smt.assume(\n        mut vc,\n        f\"(and (<= 0 {k}) (< {k} {smt.seq_len(n, s)}))\",\n      )\n      return smt.element_at_inner(mut vc, id, k) ?? smt.Opaque(\"an element\")\n    },\n    smt.GValues(vs) => if len(vs) == 0 {\n      // a list literal `[]` has no element: this one doesn't exist\n      smt.assume(mut vc, \"false\")\n      smt.Opaque(\"an element of an empty list\")\n    } else {\n      k := smt.fresh(mut vc, \"Int\")\n      smt.assume(mut vc, f\"(and (<= 0 {k}) (< {k} {len(vs)}))\")\n      mut v := get(vs, len(vs) - 1) ?? smt.Inactive\n      mut i := len(vs) - 2\n      while i >= 0 {\n        v = smt.merge(\n          mut vc,\n          f\"(= {k} {i})\",\n          get(vs, i) ?? smt.Inactive,\n          v,\n        )\n        i -= 1\n      }\n      v\n    },\n    smt.GRange(lo, hi) => {\n      x := smt.fresh(mut vc, \"Int\")\n      smt.assume(mut vc, f\"(and (<= {lo} {x}) (< {x} {hi}))\")\n      smt.vint(mut vc, x)\n    },\n    smt.GItems(t) => smt.item_of(mut vc, id, t),\n    // `(k, x)`: some position `k` and an element, taken as any element\n    // instead of the one at `k`. By position, the facts every `for` over\n    // `enumerate` adds made the solver slow.\n    smt.GEnum(p, l) => {\n      k := smt.fresh(mut vc, \"Int\")\n      smt.assume(mut vc, f\"(and (<= 0 {k}) (< {k} {l}))\")\n      x := smt.element_inner(mut vc, p)\n      smt.VTuple([smt.vint(mut vc, k), x])\n    },\n    smt.GZip(a, b, _) => {\n      x := smt.element_inner(mut vc, a)\n      y := smt.element_inner(mut vc, b)\n      smt.VTuple([x, y])\n    },\n    smt.GSub(p) | smt.GShift(p, _) | smt.GRev(p, _) => smt.element_inner(mut vc, p),\n    // an element of `a + b` is one of `a`'s or one of `b`'s\n    smt.GConcat(a, b, _) => {\n      c := smt.fresh(mut vc, \"Bool\")\n      n := len(vc.pc)\n      smt.push_pc(mut vc, c)\n      ea := smt.element_inner(mut vc, a)\n      vc.pc = take(vc.pc, n)\n      smt.push_pc(mut vc, smt.neg(c))\n      eb := smt.element_inner(mut vc, b)\n      vc.pc = take(vc.pc, n)\n      smt.merge(mut vc, c, ea, eb)\n    },\n    smt.GFilter(p, f) => {\n      x := smt.element_inner(mut vc, p)\n      cv := smt.apply(mut vc, f, x)\n      c := smt.as_bool(mut vc, cv)\n      smt.assume(mut vc, c)\n      x\n    },\n    smt.GMap(p, f) => {\n      y := smt.element_inner(mut vc, p)\n      smt.apply(mut vc, f, y)\n    },\n    smt.GEither(c, a, b) => if smt.is_empty_literal(vc, a) {\n      // one side is `[]`: the element is from the other one\n      smt.assume(mut vc, smt.neg(c))\n      smt.element_inner(mut vc, b)\n    } else if smt.is_empty_literal(vc, b) {\n      smt.assume(mut vc, c)\n      smt.element_inner(mut vc, a)\n    } else {\n      n := len(vc.pc)\n      smt.push_pc(mut vc, c)\n      ea := smt.element_inner(mut vc, a)\n      vc.pc = take(vc.pc, n)\n      smt.push_pc(mut vc, smt.neg(c))\n      eb := smt.element_inner(mut vc, b)\n      vc.pc = take(vc.pc, n)\n      smt.merge(mut vc, c, ea, eb)\n    },\n  }\n  smt.known_of(mut vc, id, x)\n  x\n}"},{"name":"smt.call_exprs","kind":"fn","old":"9e94cf47e2b1bea6","new":"f6a0123e2dafaa83","interface_changed":false,"affected":[],"module":"smt","text":"fn call_exprs(\n  mut vc: smt.Vc,\n  called: String,\n  exprs: List[ast.Expr],\n) -> smt.Val {\n  // a built-in desugaring calls by `ast.core_ref`: never the program's\n  core := ast.is_core_ref(called)\n  name := ast.core_named(called)\n  // a function of no parameters whose body is a literal (`fn limit() ->\n  // Float { 2.0 }`) is that constant\n  if !core {\n    match smt.constant_body(vc, name, exprs) {\n      Some(e) => return smt.eval(mut vc, e),\n      None => (),\n    }\n  }\n  // the call's polarity (`Vc.polarity`), kept from calls in its arguments\n  pol := vc.call_pol\n  vc.call_pol = 0\n  mut vals := []\n  for e in exprs {\n    mut vals.push(\n      if smt.is_fn(vc, e) {\n        None\n      } else {\n        match (name, smt.string_unit(e)) {\n          // `len(s.bytes())`: the units of a string, a prelude method's\n          // result that is not modelled, read through `s` by `call`\n          (\"len\", Some((_, s))) => {\n            _ := smt.eval(mut vc, s)\n            Some(smt.Opaque(\"a string's units\"))\n          },\n          _ => Some(smt.eval(mut vc, e)),\n        }\n      },\n    )\n  }\n  // a `Real`'s own methods (`x.floor()`, as `Real.floor(x)`)\n  if starts_with(name, \"Real.\") && vals.all(v -> v is Some) {\n    rn := byte_slice(name, 5, byte_len(name))\n    rvs := vals.map(v -> v ?? smt.Inactive)\n    match smt.real_fn(mut vc, rn, rvs) {\n      Some(v) => return v,\n      None => (),\n    }\n  }\n  builtin := core || !contains(vc.fns, name)\n  for (i, e) in enumerate(exprs) {\n    if get(vals, i) ?? None == None && vc.spec > 0 {\n      // in a contract nothing is checked and the function isn't run; what\n      // it does is in `fn_args`. In the function's own contract its checks\n      // are obligations.\n      if smt.in_own(vc)\n        && !(builtin\n          && (contains([\"all\", \"any\", \"find\"], name)\n            || name == \"filter\" && smt.own_here(vc))) {\n        _ := smt.fn_arg_run(mut vc, name, core, builtin, i, e, vals)\n      }\n      vals = take(vals, i)\n        + [Some(smt.Opaque(\"function values are not modelled\"))]\n        + drop(vals, i + 1)\n    } else if get(vals, i) ?? None == None {\n      fv := smt.fn_arg_run(mut vc, name, core, builtin, i, e, vals)\n      vals = take(vals, i) + [Some(fv)] + drop(vals, i + 1)\n    }\n  }\n  given := vals.map(v -> v ?? smt.Opaque(\"a missing argument\"))\n  key := smt.call_key(vc, called, exprs, given)\n  mut funcs := []\n  for e in exprs {\n    mut funcs.push(\n      if smt.is_fn(vc, e) {\n        smt.func_of(vc, e)\n      } else {\n        None\n      },\n    )\n  }\n  saved := vc.fn_args\n  vc.fn_args = funcs\n  vc.call_pol = pol\n  r := smt.call(mut vc, called, exprs, given)\n  vc.fn_args = saved\n  // the same call of a function on the same values made a list before, out\n  // of any quantifier: that list, so what is known of all its elements (an `all` in a\n  // `requires`) holds of this one, not only at the positions both are read\n  // (not inside a quantifier's body or a scope's region, whose terms\n  // name what is bound there)\n  pure := match get(vc.fns, name) {\n      Some(f) => !f.params.any(p -> p.mutable),\n      None => false,\n    }\n    && len(vc.regions) == 0\n    && vc.indexing == None\n  before := match key {\n    Some(k) => get(vc.memo, k),\n    None => None,\n  }\n  smt.same_call(mut vc, key, r)\n  match (before, r) {\n    (Some(smt.VList { .. }), smt.VList { .. }) => if pure {\n      return before ?? r\n    },\n    _ => (),\n  }\n  r\n}","old_text":"fn call_exprs(\n  mut vc: smt.Vc,\n  called: String,\n  exprs: List[ast.Expr],\n) -> smt.Val {\n  // a built-in desugaring calls by `ast.core_ref`: never the program's\n  core := ast.is_core_ref(called)\n  name := ast.core_named(called)\n  // a function of no parameters whose body is a literal (`fn limit() ->\n  // Float { 2.0 }`) is that constant\n  if !core {\n    match smt.constant_body(vc, name, exprs) {\n      Some(e) => return smt.eval(mut vc, e),\n      None => (),\n    }\n  }\n  // the call's polarity (`Vc.polarity`), kept from calls in its arguments\n  pol := vc.call_pol\n  vc.call_pol = 0\n  mut vals := []\n  for e in exprs {\n    mut vals.push(\n      if smt.is_fn(vc, e) {\n        None\n      } else {\n        match (name, smt.string_unit(e)) {\n          // `len(s.bytes())`: the units of a string, a prelude method's\n          // result that is not modelled, read through `s` by `call`\n          (\"len\", Some((_, s))) => {\n            _ := smt.eval(mut vc, s)\n            Some(smt.Opaque(\"a string's units\"))\n          },\n          _ => Some(smt.eval(mut vc, e)),\n        }\n      },\n    )\n  }\n  // a `Real`'s own methods (`x.floor()`, as `Real.floor(x)`)\n  if starts_with(name, \"Real.\") && vals.all(v -> v is Some) {\n    rn := byte_slice(name, 5, byte_len(name))\n    rvs := vals.map(v -> v ?? smt.Inactive)\n    match smt.real_fn(mut vc, rn, rvs) {\n      Some(v) => return v,\n      None => (),\n    }\n  }\n  builtin := core || !contains(vc.fns, name)\n  for (i, e) in enumerate(exprs) {\n    if get(vals, i) ?? None == None && vc.spec > 0 {\n      // in a contract nothing is checked and the function isn't run; what\n      // it does is in `fn_args`\n      vals = take(vals, i)\n        + [Some(smt.Opaque(\"function values are not modelled\"))]\n        + drop(vals, i + 1)\n    } else if get(vals, i) ?? None == None {\n      // the function runs on the elements, if there are any, so its checks\n      // hold under that condition\n      mut exists := None\n      mut elem := None\n      match get(vals, 0) ?? None {\n        Some(smt.VList { len, id }) => if builtin && i > 0 {\n          ex := f\"(> {len} 0)\"\n          exists = Some(ex)\n          elem = Some(smt.element(mut vc, id, ex))\n        },\n        _ => (),\n      }\n      args := match elem {\n        Some(x) => if name == \"fold\" {\n          [smt.Opaque(\"the accumulator of `fold`\"), x]\n        } else {\n          [x]\n        },\n        // passed for a parameter of a function type: it is called with\n        // valid values of its parameter types\n        None => match if core {\n          None\n        } else {\n          get(vc.fns, name)\n        } {\n          Some(f) => match get(f.params, i) {\n            Some(p) => match p.ty {\n              ast.FnType { params, .. } => {\n                mut out := []\n                for t in params {\n                  old := vc.reason\n                  vc.reason = Some(\n                    \"an argument a function value is called with (only its type is known)\",\n                  )\n                  v := smt.shape(mut vc, t)\n                  vc.reason = old\n                  vc.spec += 1\n                  c := smt.check_type(mut vc, t, v, [])\n                  vc.spec -= 1\n                  smt.assume(mut vc, c)\n                  mut out.push(v)\n                }\n                out\n              },\n              _ => [],\n            },\n            None => [],\n          },\n          None => [],\n        },\n      }\n      n := len(vc.pc)\n      match exists {\n        Some(ex) => smt.push_pc(mut vc, ex),\n        None => (),\n      }\n      (fv, _) := smt.fn_value(mut vc, e, args)\n      vc.pc = take(vc.pc, n)\n      vals = take(vals, i) + [Some(fv)] + drop(vals, i + 1)\n    }\n  }\n  given := vals.map(v -> v ?? smt.Opaque(\"a missing argument\"))\n  key := smt.call_key(vc, called, exprs, given)\n  mut funcs := []\n  for e in exprs {\n    mut funcs.push(\n      if smt.is_fn(vc, e) {\n        smt.func_of(vc, e)\n      } else {\n        None\n      },\n    )\n  }\n  saved := vc.fn_args\n  vc.fn_args = funcs\n  vc.call_pol = pol\n  r := smt.call(mut vc, called, exprs, given)\n  vc.fn_args = saved\n  // the same call of a function on the same values made a list before, out\n  // of any quantifier: that list, so what is known of all its elements (an `all` in a\n  // `requires`) holds of this one, not only at the positions both are read\n  // (not inside a quantifier's body or a scope's region, whose terms\n  // name what is bound there)\n  pure := match get(vc.fns, name) {\n      Some(f) => !f.params.any(p -> p.mutable),\n      None => false,\n    }\n    && len(vc.regions) == 0\n    && vc.indexing == None\n  before := match key {\n    Some(k) => get(vc.memo, k),\n    None => None,\n  }\n  smt.same_call(mut vc, key, r)\n  match (before, r) {\n    (Some(smt.VList { .. }), smt.VList { .. }) => if pure {\n      return before ?? r\n    },\n    _ => (),\n  }\n  r\n}"},{"name":"smt.fn_arg_run","kind":"fn","old":null,"new":"316c2b4d2e102723","interface_changed":true,"affected":[],"module":"smt","text":"/// A function value passed as argument `i` of a call of `name`, run once:\n/// on an element of the first argument when that is a list (the function\n/// runs on the elements, if there are any, so its checks hold under that\n/// condition), else on valid values of its parameter types. Its value.\nfn fn_arg_run(\n  mut vc: smt.Vc,\n  name: String,\n  core: Bool,\n  builtin: Bool,\n  i: Int,\n  e: ast.Expr,\n  vals: List[Option[smt.Val]],\n) -> smt.Val {\n  mut exists := None\n  mut elem := None\n  match get(vals, 0) ?? None {\n    Some(smt.VList { len, id }) => if builtin && i > 0 {\n      ex := f\"(> {len} 0)\"\n      exists = Some(ex)\n      elem = Some(smt.element(mut vc, id, ex))\n    },\n    _ => (),\n  }\n  args := match elem {\n    Some(x) => if name == \"fold\" {\n      [smt.Opaque(\"the accumulator of `fold`\"), x]\n    } else {\n      [x]\n    },\n    // passed for a parameter of a function type: it is called with\n    // valid values of its parameter types\n    None => match if core {\n      None\n    } else {\n      get(vc.fns, name)\n    } {\n      Some(f) => match get(f.params, i) {\n        Some(p) => match p.ty {\n          ast.FnType { params, .. } => {\n            mut out := []\n            for t in params {\n              old := vc.reason\n              vc.reason = Some(\n                \"an argument a function value is called with (only its type is known)\",\n              )\n              v := smt.shape(mut vc, t)\n              vc.reason = old\n              vc.spec += 1\n              c := smt.check_type(mut vc, t, v, [])\n              vc.spec -= 1\n              smt.assume(mut vc, c)\n              mut out.push(v)\n            }\n            out\n          },\n          _ => [],\n        },\n        None => [],\n      },\n      None => [],\n    },\n  }\n  n := len(vc.pc)\n  match exists {\n    Some(ex) => smt.push_pc(mut vc, ex),\n    None => (),\n  }\n  (fv, _) := smt.fn_value(mut vc, e, args)\n  vc.pc = take(vc.pc, n)\n  fv\n}"},{"name":"smt.in_own","kind":"fn","old":null,"new":"dea6eb1f9d7979e1","interface_changed":true,"affected":[],"module":"smt","text":"/// Whether the run is inside the function's own contract (`own_here`, or\n/// nested in it), where a check it can't make is reported (`own_lost`).\nfn in_own(vc: smt.Vc) -> Bool {\n  vc.own_spec > 0\n    && vc.spec >= vc.own_spec\n    && vc.through == vc.own_through\n}"},{"name":"smt.element_applied","kind":"fn","old":null,"new":"1840d90386d96059","interface_changed":true,"affected":[],"module":"smt","text":"/// `apply` for an element of a list `map` or `filter` made: the checks `f`\n/// makes are those of the call that made the list, none here.\nfn element_applied(mut vc: smt.Vc, f: smt.Func, x: smt.Val) -> smt.Val {\n  own_spec := vc.own_spec\n  vc.own_spec = 0\n  v := smt.apply(mut vc, f, x)\n  vc.own_spec = own_spec\n  v\n}"}]}
{"id":"ccdb1ba5325ad10d","time":1795832654,"message":"rename smt.real_key → smt.builtin_key","changes":[{"name":"smt.shape","kind":"fn","old":"3f74c219e7a9fa3a","new":"104e55b67a49c31a","interface_changed":false,"affected":[],"module":"smt","text":"/// A value of type `t` made of fresh unknowns, nothing assumed. Its outer\n/// level is built now, its structured parts are datatype terms.\nfn shape(mut vc: smt.Vc, t: ast.TypeExpr) -> smt.Val {\n  match t {\n    ast.Named { name, .. } => if smt.width_of(name) != None {\n      x := smt.fresh(mut vc, \"Int\")\n      smt.push_fact(mut vc, smt.word_range(name, x))\n      return smt.word(mut vc, name, x)\n    },\n    _ => (),\n  }\n  match t {\n    ast.Refined { base, .. } => smt.shape(mut vc, base),\n    ast.UnitType => smt.UnitVal,\n    ast.FnType { ret, .. } => smt.VFn { ret },\n    ast.RowType(_) => smt.Opaque(\n      \"a structural type (`{ f: T, .. }`) has no values of its own\",\n    ),\n    ast.UnionType(_) => match smt.sort_of(mut vc, t) {\n      Some(s) => {\n        x := smt.fresh(mut vc, s)\n        smt.unfold(mut vc, t, x)\n      },\n      None => smt.Opaque(\n        \"values of this union type are not modelled (members of overlapping or unknown shapes)\",\n      ),\n    },\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => {\n        // a variant as a type: a value of its sum with that tag\n        v := smt.shape(mut vc, ast.Named { name: p, args })\n        match v {\n          smt.VSum { tag, ctors, .. } => match smt.position(ctors, name) {\n            Some(k) => smt.push_fact(mut vc, f\"(= {tag} {k})\"),\n            None => (),\n          },\n          _ => (),\n        }\n        v\n      },\n      None => match smt.builtin_key(vc, name) {\n        \"Int\" => {\n          a1 := smt.fresh(mut vc, \"Int\")\n          smt.vint(mut vc, a1)\n        },\n        \"Real\" => {\n          a0 := smt.fresh(mut vc, \"Real\")\n          smt.VReal(smt.tm(mut vc, a0))\n        },\n        \"Bool\" => {\n          a2 := smt.fresh(mut vc, \"Bool\")\n          smt.vbool(mut vc, a2)\n        },\n        \"String\" => {\n          a3 := smt.fresh(mut vc, \"String\")\n          smt.vstr(mut vc, a3)\n        },\n        \"Float\" => {\n          t := smt.fresh(mut vc, \"Real\")\n          smt.push_fact(mut vc, smt.float_range(t))\n          smt.VFloat(smt.tm(mut vc, t))\n        },\n        \"List\" => {\n          l := smt.fresh(mut vc, \"Int\")\n          smt.push_fact(mut vc, f\"(>= {l} 0)\")\n          smt.new_list(mut vc, l, match get(args, 0) {\n            Some(a) => smt.GType(a),\n            None => smt.Untracked,\n          })\n        },\n        // dicts and sets: an array of their entries (`map_sorts`)\n        \"Dict\" | \"Set\" => smt.fresh_keyed(mut vc, t),\n        \"Tuple\" => {\n          mut xs := []\n          for a in args {\n            mut xs.push(smt.shape(mut vc, a))\n          }\n          smt.VTuple(xs)\n        },\n        \"Task\" => smt.shape(mut vc, get(args, 0) ?? ast.UnitType),\n        _ => match get(vc.types, name) {\n          // a type parameter's values: terms of an uninterpreted sort\n          None => match smt.sort_of(mut vc, t) {\n            Some(sort) => smt.VData { ty: t, t: smt.fresh_why(\n              mut vc,\n              sort,\n              f\"values of the generic type `{name}` are not known\",\n            ) },\n            None => smt.Opaque(\n              f\"values of the generic type `{name}` are not known\",\n            ),\n          },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              ) }\n            } else {\n              smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              )\n            },\n            ast.RecordBody(_) => {\n              rc := get(smt.variants_of(vc, name, args) ?? [], 0) ?? smt.Ctor { name, fields: None, types: [] }\n              mut fs := []\n              for (k, f) in enumerate(rc.fields ?? []) {\n                mut fs.push(\n                  (\n                    f,\n                    smt.part(\n                      mut vc,\n                      get(rc.types, k) ?? ast.UnitType,\n                    ),\n                  ),\n                )\n              }\n              smt.VRec { name, fields: fs }\n            },\n            ast.SumBody(_) => {\n              vs := smt.variants_of(vc, name, args) ?? []\n              tag := smt.fresh(mut vc, \"Int\")\n              smt.push_fact(\n                mut vc,\n                f\"(and (<= 0 {tag}) (< {tag} {len(vs)}))\",\n              )\n              mut ctors := []\n              for c in vs {\n                mut payload := []\n                for ft in c.types {\n                  mut payload.push(smt.part(mut vc, ft))\n                }\n                mut ctors.push((c.name, payload))\n              }\n              smt.VSum { ty: name, args, tag, ctors }\n            },\n          },\n        },\n      },\n    },\n  }\n}","old_text":"/// A value of type `t` made of fresh unknowns, nothing assumed. Its outer\n/// level is built now, its structured parts are datatype terms.\nfn shape(mut vc: smt.Vc, t: ast.TypeExpr) -> smt.Val {\n  match t {\n    ast.Named { name, .. } => if smt.width_of(name) != None {\n      x := smt.fresh(mut vc, \"Int\")\n      smt.push_fact(mut vc, smt.word_range(name, x))\n      return smt.word(mut vc, name, x)\n    },\n    _ => (),\n  }\n  match t {\n    ast.Refined { base, .. } => smt.shape(mut vc, base),\n    ast.UnitType => smt.UnitVal,\n    ast.FnType { ret, .. } => smt.VFn { ret },\n    ast.RowType(_) => smt.Opaque(\n      \"a structural type (`{ f: T, .. }`) has no values of its own\",\n    ),\n    ast.UnionType(_) => match smt.sort_of(mut vc, t) {\n      Some(s) => {\n        x := smt.fresh(mut vc, s)\n        smt.unfold(mut vc, t, x)\n      },\n      None => smt.Opaque(\n        \"values of this union type are not modelled (members of overlapping or unknown shapes)\",\n      ),\n    },\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => {\n        // a variant as a type: a value of its sum with that tag\n        v := smt.shape(mut vc, ast.Named { name: p, args })\n        match v {\n          smt.VSum { tag, ctors, .. } => match smt.position(ctors, name) {\n            Some(k) => smt.push_fact(mut vc, f\"(= {tag} {k})\"),\n            None => (),\n          },\n          _ => (),\n        }\n        v\n      },\n      None => match smt.real_key(vc, name) {\n        \"Int\" => {\n          a1 := smt.fresh(mut vc, \"Int\")\n          smt.vint(mut vc, a1)\n        },\n        \"Real\" => {\n          a0 := smt.fresh(mut vc, \"Real\")\n          smt.VReal(smt.tm(mut vc, a0))\n        },\n        \"Bool\" => {\n          a2 := smt.fresh(mut vc, \"Bool\")\n          smt.vbool(mut vc, a2)\n        },\n        \"String\" => {\n          a3 := smt.fresh(mut vc, \"String\")\n          smt.vstr(mut vc, a3)\n        },\n        \"Float\" => {\n          t := smt.fresh(mut vc, \"Real\")\n          smt.push_fact(mut vc, smt.float_range(t))\n          smt.VFloat(smt.tm(mut vc, t))\n        },\n        \"List\" => {\n          l := smt.fresh(mut vc, \"Int\")\n          smt.push_fact(mut vc, f\"(>= {l} 0)\")\n          smt.new_list(mut vc, l, match get(args, 0) {\n            Some(a) => smt.GType(a),\n            None => smt.Untracked,\n          })\n        },\n        // dicts and sets: an array of their entries (`map_sorts`)\n        \"Dict\" | \"Set\" => smt.fresh_keyed(mut vc, t),\n        \"Tuple\" => {\n          mut xs := []\n          for a in args {\n            mut xs.push(smt.shape(mut vc, a))\n          }\n          smt.VTuple(xs)\n        },\n        \"Task\" => smt.shape(mut vc, get(args, 0) ?? ast.UnitType),\n        _ => match get(vc.types, name) {\n          // a type parameter's values: terms of an uninterpreted sort\n          None => match smt.sort_of(mut vc, t) {\n            Some(sort) => smt.VData { ty: t, t: smt.fresh_why(\n              mut vc,\n              sort,\n              f\"values of the generic type `{name}` are not known\",\n            ) },\n            None => smt.Opaque(\n              f\"values of the generic type `{name}` are not known\",\n            ),\n          },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              ) }\n            } else {\n              smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              )\n            },\n            ast.RecordBody(_) => {\n              rc := get(smt.variants_of(vc, name, args) ?? [], 0) ?? smt.Ctor { name, fields: None, types: [] }\n              mut fs := []\n              for (k, f) in enumerate(rc.fields ?? []) {\n                mut fs.push(\n                  (\n                    f,\n                    smt.part(\n                      mut vc,\n                      get(rc.types, k) ?? ast.UnitType,\n                    ),\n                  ),\n                )\n              }\n              smt.VRec { name, fields: fs }\n            },\n            ast.SumBody(_) => {\n              vs := smt.variants_of(vc, name, args) ?? []\n              tag := smt.fresh(mut vc, \"Int\")\n              smt.push_fact(\n                mut vc,\n                f\"(and (<= 0 {tag}) (< {tag} {len(vs)}))\",\n              )\n              mut ctors := []\n              for c in vs {\n                mut payload := []\n                for ft in c.types {\n                  mut payload.push(smt.part(mut vc, ft))\n                }\n                mut ctors.push((c.name, payload))\n              }\n              smt.VSum { ty: name, args, tag, ctors }\n            },\n          },\n        },\n      },\n    },\n  }\n}"},{"name":"smt.sort_of","kind":"fn","old":"252d80d5c093ea49","new":"a224a06c749469ba","interface_changed":false,"affected":[],"module":"smt","text":"/// The SMT sort of the values of `t`.\nfn sort_of(mut vc: smt.Vc, t: ast.TypeExpr) -> Option[String] {\n  st := smt.sort_type(vc, t)\n  if smt.sized(st) {\n    return Some(\"Int\")\n  }\n  match st {\n    ast.UnitType => {\n      match smt.new_datatype(mut vc, \"T:Unit\") {\n        Some(i) => smt.set_datatype(mut vc, i, [(\"T:Unit.unit\", [])]),\n        None => (),\n      }\n      Some(smt.sym(\"T:Unit\"))\n    },\n    ast.FnType { .. } => Some(smt.opaque_sort(mut vc, \"Fn\")),\n    ast.Refined { base, .. } => smt.sort_of(mut vc, base),\n    ast.RowType(_) => Some(smt.opaque_sort(mut vc, \"Row\")),\n    ast.UnionType(ms) => {\n      gs := smt.union_groups(vc, ms)?\n      mut sorts := []\n      for g in gs {\n        mut sorts.push(smt.field_sort(mut vc, g.ty))\n      }\n      n := \"T:Union(\" + smt.bare(join(sorts, \",\")) + \")\"\n      match smt.new_datatype(mut vc, n) {\n        Some(i) => {\n          mut cs := []\n          for (k, s) in enumerate(sorts) {\n            mut cs.push((n + \".\" + f\"{k}\", [s]))\n          }\n          smt.set_datatype(mut vc, i, cs)\n        },\n        None => (),\n      }\n      Some(smt.sym(n))\n    },\n    ast.Named { name, args } => match smt.builtin_key(vc, name) {\n      \"Int\" | \"Real\" | \"Bool\" | \"String\" => Some(name),\n      \"Dict\" | \"Set\" => match smt.map_sorts(mut vc, st) {\n        Some(ms) => Some(ms.arr),\n        None => Some(smt.opaque_sort(mut vc, name)),\n      },\n      \"Float\" => Some(\"Real\"),\n      \"_\" => Some(smt.opaque_sort(mut vc, name)),\n      \"List\" => match get(args, 0) {\n        Some(a) => {\n          item := smt.field_sort(mut vc, a)\n          n := \"T:List(\" + smt.bare(item) + \")\"\n          if !contains(vc.sort_index, n) {\n            mut vc.sort_index.insert(n, len(vc.sorts))\n            mut vc.sorts.push((n, smt.ListSort(item)))\n          }\n          Some(smt.sym(n))\n        },\n        None => Some(smt.opaque_sort(mut vc, \"List\")),\n      },\n      \"Tuple\" => {\n        n := smt.dt_name(st)\n        match smt.new_datatype(mut vc, n) {\n          Some(i) => {\n            mut fs := []\n            for a in args {\n              mut fs.push(smt.field_sort(mut vc, a))\n            }\n            smt.set_datatype(mut vc, i, [(n + \".mk\", fs)])\n          },\n          None => (),\n        }\n        Some(smt.sym(n))\n      },\n      // (a datatype declared already: its constructors aren't made again)\n      _ => if contains(vc.sort_index, smt.dt_name(st)) {\n        Some(smt.sym(smt.dt_name(st)))\n      } else {\n        match smt.variants_of(vc, name, args) {\n          Some(vs) => {\n            n := smt.dt_name(st)\n            match smt.new_datatype(mut vc, n) {\n              Some(i) => {\n                mut cs := []\n                for c in vs {\n                  mut fs := []\n                  for ft in c.types {\n                    mut fs.push(smt.field_sort(mut vc, ft))\n                  }\n                  mut cs.push((n + \".\" + c.name, fs))\n                }\n                smt.set_datatype(mut vc, i, cs)\n              },\n              None => (),\n            }\n            Some(smt.sym(n))\n          },\n          None => Some(smt.opaque_sort(mut vc, text.type_text(st))),\n        }\n      },\n    },\n  }\n}","old_text":"/// The SMT sort of the values of `t`.\nfn sort_of(mut vc: smt.Vc, t: ast.TypeExpr) -> Option[String] {\n  st := smt.sort_type(vc, t)\n  if smt.sized(st) {\n    return Some(\"Int\")\n  }\n  match st {\n    ast.UnitType => {\n      match smt.new_datatype(mut vc, \"T:Unit\") {\n        Some(i) => smt.set_datatype(mut vc, i, [(\"T:Unit.unit\", [])]),\n        None => (),\n      }\n      Some(smt.sym(\"T:Unit\"))\n    },\n    ast.FnType { .. } => Some(smt.opaque_sort(mut vc, \"Fn\")),\n    ast.Refined { base, .. } => smt.sort_of(mut vc, base),\n    ast.RowType(_) => Some(smt.opaque_sort(mut vc, \"Row\")),\n    ast.UnionType(ms) => {\n      gs := smt.union_groups(vc, ms)?\n      mut sorts := []\n      for g in gs {\n        mut sorts.push(smt.field_sort(mut vc, g.ty))\n      }\n      n := \"T:Union(\" + smt.bare(join(sorts, \",\")) + \")\"\n      match smt.new_datatype(mut vc, n) {\n        Some(i) => {\n          mut cs := []\n          for (k, s) in enumerate(sorts) {\n            mut cs.push((n + \".\" + f\"{k}\", [s]))\n          }\n          smt.set_datatype(mut vc, i, cs)\n        },\n        None => (),\n      }\n      Some(smt.sym(n))\n    },\n    ast.Named { name, args } => match smt.real_key(vc, name) {\n      \"Int\" | \"Real\" | \"Bool\" | \"String\" => Some(name),\n      \"Dict\" | \"Set\" => match smt.map_sorts(mut vc, st) {\n        Some(ms) => Some(ms.arr),\n        None => Some(smt.opaque_sort(mut vc, name)),\n      },\n      \"Float\" => Some(\"Real\"),\n      \"_\" => Some(smt.opaque_sort(mut vc, name)),\n      \"List\" => match get(args, 0) {\n        Some(a) => {\n          item := smt.field_sort(mut vc, a)\n          n := \"T:List(\" + smt.bare(item) + \")\"\n          if !contains(vc.sort_index, n) {\n            mut vc.sort_index.insert(n, len(vc.sorts))\n            mut vc.sorts.push((n, smt.ListSort(item)))\n          }\n          Some(smt.sym(n))\n        },\n        None => Some(smt.opaque_sort(mut vc, \"List\")),\n      },\n      \"Tuple\" => {\n        n := smt.dt_name(st)\n        match smt.new_datatype(mut vc, n) {\n          Some(i) => {\n            mut fs := []\n            for a in args {\n              mut fs.push(smt.field_sort(mut vc, a))\n            }\n            smt.set_datatype(mut vc, i, [(n + \".mk\", fs)])\n          },\n          None => (),\n        }\n        Some(smt.sym(n))\n      },\n      // (a datatype declared already: its constructors aren't made again)\n      _ => if contains(vc.sort_index, smt.dt_name(st)) {\n        Some(smt.sym(smt.dt_name(st)))\n      } else {\n        match smt.variants_of(vc, name, args) {\n          Some(vs) => {\n            n := smt.dt_name(st)\n            match smt.new_datatype(mut vc, n) {\n              Some(i) => {\n                mut cs := []\n                for c in vs {\n                  mut fs := []\n                  for ft in c.types {\n                    mut fs.push(smt.field_sort(mut vc, ft))\n                  }\n                  mut cs.push((n + \".\" + c.name, fs))\n                }\n                smt.set_datatype(mut vc, i, cs)\n              },\n              None => (),\n            }\n            Some(smt.sym(n))\n          },\n          None => Some(smt.opaque_sort(mut vc, text.type_text(st))),\n        }\n      },\n    },\n  }\n}"},{"name":"smt.builtin_key","kind":"fn","old":null,"new":"0a985e37105ca095","interface_changed":true,"affected":[],"module":"smt","text":"/// A type's name as the sorts are chosen by: `$Real` (a record) for `Real`\n/// inside core.real (`real_record`).\nfn builtin_key(vc: smt.Vc, name: String) -> String {\n  if name == \"Real\" && smt.real_record(vc) {\n    \"$Real\"\n  } else {\n    name\n  }\n}"},{"name":"smt.from_term","kind":"fn","old":"3a6826cf8f8207ea","new":"d48c847e9219c8fe","interface_changed":false,"affected":[],"module":"smt","text":"/// The value a term of type `ty` stands for: a plain value for `Int`,\n/// `Bool`, `String`, and a `VData` (unfolded when read) for a structured\n/// one.\nfn from_term(mut vc: smt.Vc, ty: ast.TypeExpr, t: String) -> smt.Val {\n  match ty {\n    ast.Named { name, .. } => if smt.width_of(name) != None {\n      smt.push_fact(mut vc, smt.word_range(name, t))\n      return smt.word(mut vc, name, t)\n    },\n    _ => (),\n  }\n  match ty {\n    ast.Refined { base, .. } => smt.from_term(mut vc, base, t),\n    ast.UnitType => smt.UnitVal,\n    ast.FnType { ret, .. } => smt.VFn { ret },\n    ast.RowType(_) => smt.Opaque(\n      \"a structural type (`{ f: T, .. }`) has no values of its own\",\n    ),\n    ast.UnionType(_) => match smt.sort_of(mut vc, ty) {\n      Some(_) => smt.VData { ty, t },\n      None => smt.Opaque(\n        \"values of this union type are not modelled (members of overlapping or unknown shapes)\",\n      ),\n    },\n    ast.Named { name, args } => match smt.builtin_key(vc, name) {\n      \"Int\" => smt.vint(mut vc, t),\n      \"Real\" => smt.VReal(smt.tm(mut vc, t)),\n      \"Bool\" => smt.vbool(mut vc, t),\n      \"String\" => {\n        if !contains(vc.str_terms, t) {\n          mut vc.str_terms.push(t)\n        }\n        smt.vstr(mut vc, t)\n      },\n      \"Float\" => {\n        smt.define(mut vc, smt.float_range(t), t)\n        smt.VFloat(smt.tm(mut vc, t))\n      },\n      \"List\" => match get(args, 0) {\n        Some(a) => {\n          n := smt.bare(smt.sort_of(mut vc, ty) ?? \"\")\n          l := smt.seq_len(n, t)\n          smt.define(mut vc, f\"(>= {l} 0)\", t)\n          smt.new_list(mut vc, l, smt.GSeq(t, a, n))\n        },\n        None => smt.Opaque(\"a list of unknown elements\"),\n      },\n      \"Dict\" | \"Set\" => match smt.map_sorts(mut vc, ty) {\n        Some(ms) => smt.keyed_array(mut vc, ty, ms, t),\n        None => {\n          l := smt.fresh_why(\n            mut vc,\n            \"Int\",\n            \"dicts and sets of these types are not modelled\",\n          )\n          smt.push_fact(mut vc, f\"(>= {l} 0)\")\n          smt.keyed_list(mut vc, l, ty)\n        },\n      },\n      \"Task\" => smt.from_term(mut vc, get(args, 0) ?? ast.UnitType, t),\n      \"Tuple\" => smt.VData { ty, t },\n      _ => if contains(vc.parents, name) {\n        smt.VData { ty, t }\n      } else {\n        match get(vc.types, name) {\n          None => smt.VData { ty, t },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              ) }\n            } else {\n              smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              )\n            },\n            _ => smt.VData { ty, t },\n          },\n        }\n      },\n    },\n  }\n}","old_text":"/// The value a term of type `ty` stands for: a plain value for `Int`,\n/// `Bool`, `String`, and a `VData` (unfolded when read) for a structured\n/// one.\nfn from_term(mut vc: smt.Vc, ty: ast.TypeExpr, t: String) -> smt.Val {\n  match ty {\n    ast.Named { name, .. } => if smt.width_of(name) != None {\n      smt.push_fact(mut vc, smt.word_range(name, t))\n      return smt.word(mut vc, name, t)\n    },\n    _ => (),\n  }\n  match ty {\n    ast.Refined { base, .. } => smt.from_term(mut vc, base, t),\n    ast.UnitType => smt.UnitVal,\n    ast.FnType { ret, .. } => smt.VFn { ret },\n    ast.RowType(_) => smt.Opaque(\n      \"a structural type (`{ f: T, .. }`) has no values of its own\",\n    ),\n    ast.UnionType(_) => match smt.sort_of(mut vc, ty) {\n      Some(_) => smt.VData { ty, t },\n      None => smt.Opaque(\n        \"values of this union type are not modelled (members of overlapping or unknown shapes)\",\n      ),\n    },\n    ast.Named { name, args } => match smt.real_key(vc, name) {\n      \"Int\" => smt.vint(mut vc, t),\n      \"Real\" => smt.VReal(smt.tm(mut vc, t)),\n      \"Bool\" => smt.vbool(mut vc, t),\n      \"String\" => {\n        if !contains(vc.str_terms, t) {\n          mut vc.str_terms.push(t)\n        }\n        smt.vstr(mut vc, t)\n      },\n      \"Float\" => {\n        smt.define(mut vc, smt.float_range(t), t)\n        smt.VFloat(smt.tm(mut vc, t))\n      },\n      \"List\" => match get(args, 0) {\n        Some(a) => {\n          n := smt.bare(smt.sort_of(mut vc, ty) ?? \"\")\n          l := smt.seq_len(n, t)\n          smt.define(mut vc, f\"(>= {l} 0)\", t)\n          smt.new_list(mut vc, l, smt.GSeq(t, a, n))\n        },\n        None => smt.Opaque(\"a list of unknown elements\"),\n      },\n      \"Dict\" | \"Set\" => match smt.map_sorts(mut vc, ty) {\n        Some(ms) => smt.keyed_array(mut vc, ty, ms, t),\n        None => {\n          l := smt.fresh_why(\n            mut vc,\n            \"Int\",\n            \"dicts and sets of these types are not modelled\",\n          )\n          smt.push_fact(mut vc, f\"(>= {l} 0)\")\n          smt.keyed_list(mut vc, l, ty)\n        },\n      },\n      \"Task\" => smt.from_term(mut vc, get(args, 0) ?? ast.UnitType, t),\n      \"Tuple\" => smt.VData { ty, t },\n      _ => if contains(vc.parents, name) {\n        smt.VData { ty, t }\n      } else {\n        match get(vc.types, name) {\n          None => smt.VData { ty, t },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              ) }\n            } else {\n              smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              )\n            },\n            _ => smt.VData { ty, t },\n          },\n        }\n      },\n    },\n  }\n}"},{"name":"smt.real_key","kind":"fn","old":"7e33bffa186305e4","new":null,"interface_changed":true,"affected":[],"module":"smt","old_text":"/// A type's name as the sorts are chosen by: `$Real` (a record) for `Real`\n/// inside core.real (`real_record`).\nfn real_key(vc: smt.Vc, name: String) -> String {\n  if name == \"Real\" && smt.real_record(vc) {\n    \"$Real\"\n  } else {\n    name\n  }\n}"}],"renames":[{"from":"smt.real_key","to":"smt.builtin_key","kind":"function"}],"references":["smt.shape","smt.sort_of","smt.from_term"]}
{"id":"b70d84b89fc7e656","time":1795837877,"message":"edit","changes":[{"name":"smt.type_parts","kind":"fn","old":"807e654d4bcd41dc","new":"2cc1f3afccab00cb","interface_changed":false,"affected":[],"module":"smt","text":"/// The types directly inside `t`: its type arguments, an alias's parts, a\n/// record's fields, a sum's payloads, a union's members, a function type's\n/// parameters\n/// and result.\nfn type_parts(vc: smt.Vc, t: ast.TypeExpr) -> List[ast.TypeExpr] {\n  match t {\n    ast.Refined { base, .. } => smt.type_parts(vc, base),\n    ast.UnionType(ms) => ms,\n    ast.RowType(fs) => fs.map(f -> f.1),\n    ast.FnType { params, ret } => params + [ret],\n    ast.UnitType => [],\n    ast.Named { name, args } => match get(vc.types, name) {\n      None => args,\n      Some(td) => {\n        sub := smt.params_of(td, args)\n        match td.body {\n          ast.Alias(a) => smt.type_parts(vc, smt.subst(a, sub)),\n          ast.RecordBody(fs) => fs.map(f -> smt.subst(f.ty, sub)),\n          ast.SumBody(vs) => {\n            mut out := []\n            for v in vs {\n              match v.payload {\n                ast.NoPayload => (),\n                ast.Positional(ts) => {\n                  out += ts.map(x -> smt.subst(x, sub))\n                },\n                ast.RecordPayload(fs) => {\n                  out += fs.map(f -> smt.subst(f.ty, sub))\n                },\n                ast.MemberType(m) => mut out.push(smt.subst(m, sub)),\n              }\n            }\n            out\n          },\n        }\n      },\n    },\n  }\n}","old_text":"/// The types directly inside `t`: its type arguments, an alias's parts, a\n/// record's fields, a sum's payloads, a union's members.\nfn type_parts(vc: smt.Vc, t: ast.TypeExpr) -> List[ast.TypeExpr] {\n  match t {\n    ast.Refined { base, .. } => smt.type_parts(vc, base),\n    ast.UnionType(ms) => ms,\n    ast.RowType(fs) => fs.map(f -> f.1),\n    ast.FnType { .. } | ast.UnitType => [],\n    ast.Named { name, args } => match get(vc.types, name) {\n      None => args,\n      Some(td) => {\n        sub := smt.params_of(td, args)\n        match td.body {\n          ast.Alias(a) => smt.type_parts(vc, smt.subst(a, sub)),\n          ast.RecordBody(fs) => fs.map(f -> smt.subst(f.ty, sub)),\n          ast.SumBody(vs) => {\n            mut out := []\n            for v in vs {\n              match v.payload {\n                ast.NoPayload => (),\n                ast.Positional(ts) => {\n                  out += ts.map(x -> smt.subst(x, sub))\n                },\n                ast.RecordPayload(fs) => {\n                  out += fs.map(f -> smt.subst(f.ty, sub))\n                },\n                ast.MemberType(m) => mut out.push(smt.subst(m, sub)),\n              }\n            }\n            out\n          },\n        }\n      },\n    },\n  }\n}"}]}
{"id":"42375a5de6f08a60","time":1795839691,"message":"edit","changes":[{"name":"check.infer_method","kind":"fn","old":"efe082e3570bcc31","new":"bf09a66371e2d236","interface_changed":false,"affected":[],"module":"check","text":"/// A call `recv.m(args)`: a method of the receiver's type, or one of the\n/// program's functions or a built-in with the receiver as its first\n/// argument. Other calls (std's methods, closures) are not modelled.\n/// `marked`: written `mut recv.m(..)`.\nfn infer_method(\n  mut i: check.Inf,\n  recv: ast.Expr,\n  m: String,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n  marked: Bool,\n) -> check.Ty {\n  seq := i.call_seq\n  i.call_seq += 1\n  // `Item.new(..)`, `T.zero()`: a method called on a type\n  match recv {\n    ast.CtorExpr { name: tn, args: ast.NoArgs } => if contains(i.types.named, tn)\n      || contains(i.tparams, tn)\n      || [\"Int\", \"Float\", \"Bool\", \"String\"].contains(tn) {\n      mut i.recvs.push((m, check.TNamed { name: tn, args: [] }))\n      return check.static_call(mut i, tn, m, args, env)\n    },\n    // a type with its arguments as the receiver, as `derive` writes it:\n    // `{ $type: List[Int] := (); $type }.from_json_at(..)`\n    ast.Block { stmts: [ast.Let { pat: ast.Bind(\"$type\"), ty: Some(t), value: ast.UnitExpr }], last: ast.Var(\"$type\") } => return check.static_call(mut i, check.type_head(t), m, args, env),\n    _ => (),\n  }\n  rt := check.infer(mut i, recv, env, None)\n  // a decimal literal's value with a method called on it is a `Real`\n  check.default_dec(mut i, rt)\n  mut i.recvs.push((m, rt))\n  // two traits with `m`, and nothing to choose between them\n  match check.ambiguity(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `s.bigger(t)` with `bigger(self, other: Self)` on a trait value\n  check.self_args(mut i, recv, check.res(i, rt), m, args)\n  // a code trait's method on a type that isn't one (`fold` of an iterator\n  // that may not end), or whose `impl` asks more of its arguments\n  match check.code_method_problem(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `xs.to_list()` of what is a list already (`s.code_points()`, a\n  // comprehension over one) is itself\n  match check.res(i, rt) {\n    check.TList(_) => if m == \"to_list\" && len(args) == 0 {\n      return rt\n    },\n    _ => (),\n  }\n  // a value narrowed to some variants has its sum's methods\n  rt_whole := check.widened(check.res(i, rt))\n  own := match rt_whole {\n    // a generic `impl`'s parameters are the receiver's type arguments\n    check.TNamed { name, args } => match get(i.methods.of, name + \".\" + m) {\n      Some(t) => Some(check.inst(\n        t,\n        check.pairs(\n          get(i.methods.params, name + \".\" + m) ?? [],\n          args,\n        ),\n      )),\n      None => match check.code_trait_method(i, name, m, rt_whole) {\n        Some(t) => Some(t),\n        // a method a trait it implements provides (`to_json` of a type deriving\n        // `Json`)\n        None => check.provided_method(i, name, m, rt_whole),\n      },\n    },\n    // `xs.iter()`: a list's method of core's code traits\n    check.TList(_) => check.code_trait_method(i, \"List\", m, check.res(i, rt)),\n    // `s.bytes()`, `s.graphemes()`: a string's methods of code traits\n    check.TStr => check.string_method(i, m),\n    // `x.m()` with `x: T` and `T: Tr`: the trait's method, `Self` being `T`\n    check.TGen(p) => check.bound_method(i, p, m),\n    // a trait value: the trait's method\n    check.TTrait(tr) => check.trait_method(i, tr, m, check.TTrait(tr), 8),\n    _ => None,\n  }\n  // a method of one of the program's types that changes its receiver\n  // (`mut self`) is called `mut recv.m(..)`, and only such a method is\n  // called so\n  match check.res(i, rt) {\n    check.TNamed { name, .. } => if check.program_type(i, name)\n      && contains(i.methods.self_methods, name + \".\" + m) {\n      changes := contains(i.methods.mut_self, name + \".\" + m)\n      shown := text.expr_text(recv, 0)\n      if changes && !marked {\n        check.error(mut i, \"`\"\n          + m\n          + \"` changes its receiver (`mut self`): write `mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)` to show that `\"\n          + shown\n          + \"` may change\")\n      } else if marked && !changes {\n        check.error(mut i, \"`mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)`: `\"\n          + m\n          + \"` doesn't change its receiver (it doesn't take `mut self`)\")\n      }\n    },\n    _ => (),\n  }\n  // `.to_list()` of what the checker types as a list (a comprehension or a\n  // built-in over a string's code points) is the list\n  if m == \"to_list\"\n    && len(args) == 0\n    && check.res(i, rt) is check.TList {\n    return check.res(i, rt)\n  }\n  // `x.f(..)` with `f` a built-in function is `f(x, ..)`, on a list even\n  // when a trait has a method of that name (`xs.map(f)`)\n  if own is None\n    && check.known(check.res(i, rt))\n    && !contains(env, m)\n    && (!contains(i.methods.names, m)\n      || check.res(i, rt) is check.TList\n      || check.is_table(check.res(i, rt))\n      || check.basic_without(i, check.res(i, rt), m))\n    && get(i.fns, m) is None {\n    match get(i.builtins, m) {\n      Some(bs) => {\n        check.changing_call(mut i, recv, m, bs, marked)\n        return check.builtin_call(mut i, m, bs, [rt], args, env)\n      },\n      None => (),\n    }\n  }\n  sig := match own {\n    Some(t) => Some(t),\n    // a receiver of a type not known may have a method of that name, such as\n    // one of std's types\n    None => if !check.known(check.res(i, rt))\n      || contains(env, m)\n      || contains(i.methods.names, m)\n      || contains(i.builtins, m) {\n      None\n    } else {\n      get(i.fns, m)\n    },\n  }\n  match sig {\n    Some(t) => {\n      vars := check.fresh_for(mut i, to_list(check.gens(t, Set[String] {})))\n      ft := check.inst(t, vars)\n      match ft {\n        check.TFn { params, ret } => {\n          what := \"call to `\" + m + \"`\"\n          if len(params) != len(args) + 1 {\n            check.error(mut i, what\n              + \": expects \"\n              + to_string(len(params))\n              + \" arguments, got \"\n              + to_string(len(args) + 1))\n            return ret\n          }\n          check.expect(\n            mut i,\n            get(params, 0) ?? check.TAny,\n            rt,\n            what + \", argument 1\",\n          )\n          mut ats := []\n          mut arg_types := [rt]\n          for (k, a) in enumerate(args) {\n            p := get(params, k + 1) ?? check.TAny\n            at := check.listed_arg(\n              mut i,\n              m,\n              k,\n              a,\n              p,\n              check.infer(mut i, a, env, Some(p)),\n              what,\n            )\n            mut arg_types.push(at)\n            check.expect(\n              mut i,\n              p,\n              at,\n              what + \", argument \" + to_string(k + 2),\n            )\n            mut ats.push(at)\n          }\n          // a method with structural bounds, a type's own or a trait's (through\n          // a trait value or a bound): each one met by the type an argument\n          // gives its type parameter (`own` has the method's type parameters\n          // as `TAny`), a generic `impl`'s parameters being the receiver's\n          // type arguments\n          match check.method_rows_at(i, own is Some, check.res(i, rt), m) {\n            Some((key, rs, raw, sub)) => {\n              for (q, fs) in rs {\n                mut met := false\n                for (k, at) in enumerate(ats) {\n                  if !met {\n                    match check.given_for(\n                      i,\n                      get(raw, k + 1) ?? check.TAny,\n                      at,\n                      q,\n                    ) {\n                      Some(g) => {\n                        met = true\n                        check.row_met(mut i, key, fs, sub, g)\n                      },\n                      None => (),\n                    }\n                  }\n                }\n              }\n            },\n            None => (),\n          }\n          // a method's result, narrowed by what it (or its trait) says of it\n          key := check.method_facts_key(i, check.res(i, rt), m)\n          i.last_call = match check.narrowed_at(i, key, arg_types, ret) {\n            Some((_, _, left, u)) => (seq, key, to_list(left).sorted(), u),\n            None => (seq, key, [], false),\n          }\n          check.narrowed_result(i, key, arg_types, ret)\n        },\n        _ => check.TAny,\n      }\n    },\n    None => {\n      // a method no `impl`, trait or function has, on one of the program's\n      // types the checker sees every method of\n      match check.res(i, rt) {\n        check.TNamed { name, .. } => if check.program_type(i, name)\n          && !contains(i.methods.foreign, name)\n          && !contains(env, m)\n          && !contains(i.methods.names, m)\n          && get(i.fns, m) is None\n          && get(i.builtins, m) is None {\n          check.error(mut i, \"unknown function `\" + m + \"`\")\n        },\n        _ => (),\n      }\n      // `true.price()`: a method of one of the file's traits, on a value of a\n      // basic or program type, which must implement it\n      match check.res(i, rt) {\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TNamed { .. } => if !contains(env, m) {\n          match check.own_trait_of(i, m) {\n            Some(tr) => mut i.pending.push((rt, tr, m)),\n            None => (),\n          }\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}","old_text":"/// A call `recv.m(args)`: a method of the receiver's type, or one of the\n/// program's functions or a built-in with the receiver as its first\n/// argument. Other calls (std's methods, closures) are not modelled.\n/// `marked`: written `mut recv.m(..)`.\nfn infer_method(\n  mut i: check.Inf,\n  recv: ast.Expr,\n  m: String,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n  marked: Bool,\n) -> check.Ty {\n  seq := i.call_seq\n  i.call_seq += 1\n  // `Item.new(..)`, `T.zero()`: a method called on a type\n  match recv {\n    ast.CtorExpr { name: tn, args: ast.NoArgs } => if contains(i.types.named, tn)\n      || contains(i.tparams, tn)\n      || [\"Int\", \"Float\", \"Bool\", \"String\"].contains(tn) {\n      mut i.recvs.push((m, check.TNamed { name: tn, args: [] }))\n      return check.static_call(mut i, tn, m, args, env)\n    },\n    // a type with its arguments as the receiver, as `derive` writes it:\n    // `{ $type: List[Int] := (); $type }.from_json_at(..)`\n    ast.Block { stmts: [ast.Let { pat: ast.Bind(\"$type\"), ty: Some(t), value: ast.UnitExpr }], last: ast.Var(\"$type\") } => return check.static_call(mut i, check.type_head(t), m, args, env),\n    _ => (),\n  }\n  rt := check.infer(mut i, recv, env, None)\n  // a decimal literal's value with a method called on it is a `Real`\n  check.default_dec(mut i, rt)\n  mut i.recvs.push((m, rt))\n  // two traits with `m`, and nothing to choose between them\n  match check.ambiguity(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `s.bigger(t)` with `bigger(self, other: Self)` on a trait value\n  check.self_args(mut i, recv, check.res(i, rt), m, args)\n  // a code trait's method on a type that isn't one (`fold` of an iterator\n  // that may not end), or whose `impl` asks more of its arguments\n  match check.code_method_problem(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `xs.to_list()` of what is a list already (`s.code_points()`, a\n  // comprehension over one) is itself\n  match check.res(i, rt) {\n    check.TList(_) => if m == \"to_list\" && len(args) == 0 {\n      return rt\n    },\n    _ => (),\n  }\n  // a value narrowed to some variants has its sum's methods\n  rt_whole := check.widened(check.res(i, rt))\n  own := match rt_whole {\n    // a generic `impl`'s parameters are the receiver's type arguments\n    check.TNamed { name, args } => match get(i.methods.of, name + \".\" + m) {\n      Some(t) => Some(check.inst(\n        t,\n        check.pairs(\n          get(i.methods.params, name + \".\" + m) ?? [],\n          args,\n        ),\n      )),\n      None => match check.code_trait_method(i, name, m, rt_whole) {\n        Some(t) => Some(t),\n        // a method a trait it implements provides (`to_json` of a type deriving\n        // `Json`)\n        None => check.provided_method(i, name, m, rt_whole),\n      },\n    },\n    // `xs.iter()`: a list's method of core's code traits\n    check.TList(_) => check.code_trait_method(i, \"List\", m, check.res(i, rt)),\n    // `s.bytes()`, `s.graphemes()`: a string's methods of code traits\n    check.TStr => check.string_method(i, m),\n    // `x.m()` with `x: T` and `T: Tr`: the trait's method, `Self` being `T`\n    check.TGen(p) => check.bound_method(i, p, m),\n    // a trait value: the trait's method\n    check.TTrait(tr) => check.trait_method(i, tr, m, check.TTrait(tr), 8),\n    _ => None,\n  }\n  // a method of one of the program's types that changes its receiver\n  // (`mut self`) is called `mut recv.m(..)`, and only such a method is\n  // called so\n  match check.res(i, rt) {\n    check.TNamed { name, .. } => if check.program_type(i, name)\n      && contains(i.methods.self_methods, name + \".\" + m) {\n      changes := contains(i.methods.mut_self, name + \".\" + m)\n      shown := text.expr_text(recv, 0)\n      if changes && !marked {\n        check.error(mut i, \"`\"\n          + m\n          + \"` changes its receiver (`mut self`): write `mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)` to show that `\"\n          + shown\n          + \"` may change\")\n      } else if marked && !changes {\n        check.error(mut i, \"`mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)`: `\"\n          + m\n          + \"` doesn't change its receiver (it doesn't take `mut self`)\")\n      }\n    },\n    _ => (),\n  }\n  // `.to_list()` of what the checker types as a list (a comprehension or a\n  // built-in over a string's code points) is the list\n  if m == \"to_list\"\n    && len(args) == 0\n    && check.res(i, rt) is check.TList {\n    return check.res(i, rt)\n  }\n  // `x.f(..)` with `f` a built-in function is `f(x, ..)`, on a list even\n  // when a trait has a method of that name (`xs.map(f)`)\n  if own is None\n    && check.known(check.res(i, rt))\n    && !contains(env, m)\n    && (!contains(i.methods.names, m)\n      || check.res(i, rt) is check.TList\n      || check.is_table(check.res(i, rt)))\n    && get(i.fns, m) is None {\n    match get(i.builtins, m) {\n      Some(bs) => {\n        check.changing_call(mut i, recv, m, bs, marked)\n        return check.builtin_call(mut i, m, bs, [rt], args, env)\n      },\n      None => (),\n    }\n  }\n  sig := match own {\n    Some(t) => Some(t),\n    // a receiver of a type not known may have a method of that name, such as\n    // one of std's types\n    None => if !check.known(check.res(i, rt))\n      || contains(env, m)\n      || contains(i.methods.names, m)\n      || contains(i.builtins, m) {\n      None\n    } else {\n      get(i.fns, m)\n    },\n  }\n  match sig {\n    Some(t) => {\n      vars := check.fresh_for(mut i, to_list(check.gens(t, Set[String] {})))\n      ft := check.inst(t, vars)\n      match ft {\n        check.TFn { params, ret } => {\n          what := \"call to `\" + m + \"`\"\n          if len(params) != len(args) + 1 {\n            check.error(mut i, what\n              + \": expects \"\n              + to_string(len(params))\n              + \" arguments, got \"\n              + to_string(len(args) + 1))\n            return ret\n          }\n          check.expect(\n            mut i,\n            get(params, 0) ?? check.TAny,\n            rt,\n            what + \", argument 1\",\n          )\n          mut ats := []\n          mut arg_types := [rt]\n          for (k, a) in enumerate(args) {\n            p := get(params, k + 1) ?? check.TAny\n            at := check.listed_arg(\n              mut i,\n              m,\n              k,\n              a,\n              p,\n              check.infer(mut i, a, env, Some(p)),\n              what,\n            )\n            mut arg_types.push(at)\n            check.expect(\n              mut i,\n              p,\n              at,\n              what + \", argument \" + to_string(k + 2),\n            )\n            mut ats.push(at)\n          }\n          // a method with structural bounds, a type's own or a trait's (through\n          // a trait value or a bound): each one met by the type an argument\n          // gives its type parameter (`own` has the method's type parameters\n          // as `TAny`), a generic `impl`'s parameters being the receiver's\n          // type arguments\n          match check.method_rows_at(i, own is Some, check.res(i, rt), m) {\n            Some((key, rs, raw, sub)) => {\n              for (q, fs) in rs {\n                mut met := false\n                for (k, at) in enumerate(ats) {\n                  if !met {\n                    match check.given_for(\n                      i,\n                      get(raw, k + 1) ?? check.TAny,\n                      at,\n                      q,\n                    ) {\n                      Some(g) => {\n                        met = true\n                        check.row_met(mut i, key, fs, sub, g)\n                      },\n                      None => (),\n                    }\n                  }\n                }\n              }\n            },\n            None => (),\n          }\n          // a method's result, narrowed by what it (or its trait) says of it\n          key := check.method_facts_key(i, check.res(i, rt), m)\n          i.last_call = match check.narrowed_at(i, key, arg_types, ret) {\n            Some((_, _, left, u)) => (seq, key, to_list(left).sorted(), u),\n            None => (seq, key, [], false),\n          }\n          check.narrowed_result(i, key, arg_types, ret)\n        },\n        _ => check.TAny,\n      }\n    },\n    None => {\n      // a method no `impl`, trait or function has, on one of the program's\n      // types the checker sees every method of\n      match check.res(i, rt) {\n        check.TNamed { name, .. } => if check.program_type(i, name)\n          && !contains(i.methods.foreign, name)\n          && !contains(env, m)\n          && !contains(i.methods.names, m)\n          && get(i.fns, m) is None\n          && get(i.builtins, m) is None {\n          check.error(mut i, \"unknown function `\" + m + \"`\")\n        },\n        _ => (),\n      }\n      // `true.price()`: a method of one of the file's traits, on a value of a\n      // basic or program type, which must implement it\n      match check.res(i, rt) {\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TNamed { .. } => if !contains(env, m) {\n          match check.own_trait_of(i, m) {\n            Some(tr) => mut i.pending.push((rt, tr, m)),\n            None => (),\n          }\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}"},{"name":"check.basic_without","kind":"fn","old":null,"new":"a95ad50326f94e05","interface_changed":true,"affected":[],"module":"check","text":"/// Whether `t` is `Int`, `Float`, `Bool` or `String` and the program gives\n/// it no method `m`.\nfn basic_without(i: check.Inf, t: check.Ty, m: String) -> Bool {\n  n := match t {\n    check.TInt => \"Int\",\n    check.TFloat => \"Float\",\n    check.TBool => \"Bool\",\n    check.TStr => \"String\",\n    _ => return false,\n  }\n  get(i.methods.of, n + \".\" + m) is None\n}"}]}
{"id":"cf24d040654363bd","time":1795833737,"message":"edit","changes":[{"name":"smt.with_replies","kind":"fn","old":"0b9aab043d669473","new":"98de2a2dc373d3f4","interface_changed":false,"affected":[],"module":"smt","text":"/// `script` as it is sent to the solver: asking it to reply to every\n/// command (`:print-success`), so that each reply is matched to its command\n/// (`read_replies`), in the list encoding `STRATA_LISTS` names (`listed`).\npub fn with_replies(script: String) -> String {\n  \"(set-option :print-success true)\\n\" + smt.listed(script)\n}","old_text":"/// `script` as it is sent to the solver: asking it to reply to every\n/// command (`:print-success`), so that each reply is matched to its command\n/// (`read_replies`).\npub fn with_replies(script: String) -> String {\n  \"(set-option :print-success true)\\n\" + script\n}"},{"name":"smt.shape","kind":"fn","old":"3f74c219e7a9fa3a","new":"002655606648f81a","interface_changed":false,"affected":[],"module":"smt","text":"/// A value of type `t` made of fresh unknowns, nothing assumed. Its outer\n/// level is built now, its structured parts are datatype terms.\nfn shape(mut vc: smt.Vc, t: ast.TypeExpr) -> smt.Val {\n  match t {\n    ast.Named { name, .. } => if smt.width_of(name) != None {\n      x := smt.fresh(mut vc, \"Int\")\n      smt.push_fact(mut vc, smt.word_range(name, x))\n      return smt.word(mut vc, name, x)\n    },\n    _ => (),\n  }\n  match t {\n    ast.Refined { base, .. } => smt.shape(mut vc, base),\n    ast.UnitType => smt.UnitVal,\n    ast.FnType { ret, .. } => smt.VFn { ret },\n    ast.RowType(_) => smt.Opaque(\n      \"a structural type (`{ f: T, .. }`) has no values of its own\",\n    ),\n    ast.UnionType(_) => match smt.sort_of(mut vc, t) {\n      Some(s) => {\n        x := smt.fresh(mut vc, s)\n        smt.unfold(mut vc, t, x)\n      },\n      None => smt.Opaque(\n        \"values of this union type are not modelled (members of overlapping or unknown shapes)\",\n      ),\n    },\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => {\n        // a variant as a type: a value of its sum with that tag\n        v := smt.shape(mut vc, ast.Named { name: p, args })\n        match v {\n          smt.VSum { tag, ctors, .. } => match smt.position(ctors, name) {\n            Some(k) => smt.push_fact(mut vc, f\"(= {tag} {k})\"),\n            None => (),\n          },\n          _ => (),\n        }\n        v\n      },\n      None => match smt.real_key(vc, name) {\n        \"Int\" => {\n          a1 := smt.fresh(mut vc, \"Int\")\n          smt.vint(mut vc, a1)\n        },\n        \"Real\" => {\n          a0 := smt.fresh(mut vc, \"Real\")\n          smt.VReal(smt.tm(mut vc, a0))\n        },\n        \"Bool\" => {\n          a2 := smt.fresh(mut vc, \"Bool\")\n          smt.vbool(mut vc, a2)\n        },\n        \"String\" => {\n          a3 := smt.fresh(mut vc, \"String\")\n          smt.vstr(mut vc, a3)\n        },\n        \"Float\" => {\n          t := smt.fresh(mut vc, \"Real\")\n          smt.push_fact(mut vc, smt.float_range(t))\n          smt.VFloat(smt.tm(mut vc, t))\n        },\n        \"List\" => smt.seq_list(mut vc, t, args) or {\n          l := smt.fresh(mut vc, \"Int\")\n          smt.push_fact(mut vc, f\"(>= {l} 0)\")\n          smt.new_list(mut vc, l, match get(args, 0) {\n            Some(a) => smt.GType(a),\n            None => smt.Untracked,\n          })\n        },\n        // dicts and sets: an array of their entries (`map_sorts`)\n        \"Dict\" | \"Set\" => smt.fresh_keyed(mut vc, t),\n        \"Tuple\" => {\n          mut xs := []\n          for a in args {\n            mut xs.push(smt.shape(mut vc, a))\n          }\n          smt.VTuple(xs)\n        },\n        \"Task\" => smt.shape(mut vc, get(args, 0) ?? ast.UnitType),\n        _ => match get(vc.types, name) {\n          // a type parameter's values: terms of an uninterpreted sort\n          None => match smt.sort_of(mut vc, t) {\n            Some(sort) => smt.VData { ty: t, t: smt.fresh_why(\n              mut vc,\n              sort,\n              f\"values of the generic type `{name}` are not known\",\n            ) },\n            None => smt.Opaque(\n              f\"values of the generic type `{name}` are not known\",\n            ),\n          },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              ) }\n            } else {\n              smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              )\n            },\n            ast.RecordBody(_) => {\n              rc := get(smt.variants_of(vc, name, args) ?? [], 0) ?? smt.Ctor { name, fields: None, types: [] }\n              mut fs := []\n              for (k, f) in enumerate(rc.fields ?? []) {\n                mut fs.push(\n                  (\n                    f,\n                    smt.part(\n                      mut vc,\n                      get(rc.types, k) ?? ast.UnitType,\n                    ),\n                  ),\n                )\n              }\n              smt.VRec { name, fields: fs }\n            },\n            ast.SumBody(_) => {\n              vs := smt.variants_of(vc, name, args) ?? []\n              tag := smt.fresh(mut vc, \"Int\")\n              smt.push_fact(\n                mut vc,\n                f\"(and (<= 0 {tag}) (< {tag} {len(vs)}))\",\n              )\n              mut ctors := []\n              for c in vs {\n                mut payload := []\n                for ft in c.types {\n                  mut payload.push(smt.part(mut vc, ft))\n                }\n                mut ctors.push((c.name, payload))\n              }\n              smt.VSum { ty: name, args, tag, ctors }\n            },\n          },\n        },\n      },\n    },\n  }\n}","old_text":"/// A value of type `t` made of fresh unknowns, nothing assumed. Its outer\n/// level is built now, its structured parts are datatype terms.\nfn shape(mut vc: smt.Vc, t: ast.TypeExpr) -> smt.Val {\n  match t {\n    ast.Named { name, .. } => if smt.width_of(name) != None {\n      x := smt.fresh(mut vc, \"Int\")\n      smt.push_fact(mut vc, smt.word_range(name, x))\n      return smt.word(mut vc, name, x)\n    },\n    _ => (),\n  }\n  match t {\n    ast.Refined { base, .. } => smt.shape(mut vc, base),\n    ast.UnitType => smt.UnitVal,\n    ast.FnType { ret, .. } => smt.VFn { ret },\n    ast.RowType(_) => smt.Opaque(\n      \"a structural type (`{ f: T, .. }`) has no values of its own\",\n    ),\n    ast.UnionType(_) => match smt.sort_of(mut vc, t) {\n      Some(s) => {\n        x := smt.fresh(mut vc, s)\n        smt.unfold(mut vc, t, x)\n      },\n      None => smt.Opaque(\n        \"values of this union type are not modelled (members of overlapping or unknown shapes)\",\n      ),\n    },\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => {\n        // a variant as a type: a value of its sum with that tag\n        v := smt.shape(mut vc, ast.Named { name: p, args })\n        match v {\n          smt.VSum { tag, ctors, .. } => match smt.position(ctors, name) {\n            Some(k) => smt.push_fact(mut vc, f\"(= {tag} {k})\"),\n            None => (),\n          },\n          _ => (),\n        }\n        v\n      },\n      None => match smt.real_key(vc, name) {\n        \"Int\" => {\n          a1 := smt.fresh(mut vc, \"Int\")\n          smt.vint(mut vc, a1)\n        },\n        \"Real\" => {\n          a0 := smt.fresh(mut vc, \"Real\")\n          smt.VReal(smt.tm(mut vc, a0))\n        },\n        \"Bool\" => {\n          a2 := smt.fresh(mut vc, \"Bool\")\n          smt.vbool(mut vc, a2)\n        },\n        \"String\" => {\n          a3 := smt.fresh(mut vc, \"String\")\n          smt.vstr(mut vc, a3)\n        },\n        \"Float\" => {\n          t := smt.fresh(mut vc, \"Real\")\n          smt.push_fact(mut vc, smt.float_range(t))\n          smt.VFloat(smt.tm(mut vc, t))\n        },\n        \"List\" => {\n          l := smt.fresh(mut vc, \"Int\")\n          smt.push_fact(mut vc, f\"(>= {l} 0)\")\n          smt.new_list(mut vc, l, match get(args, 0) {\n            Some(a) => smt.GType(a),\n            None => smt.Untracked,\n          })\n        },\n        // dicts and sets: an array of their entries (`map_sorts`)\n        \"Dict\" | \"Set\" => smt.fresh_keyed(mut vc, t),\n        \"Tuple\" => {\n          mut xs := []\n          for a in args {\n            mut xs.push(smt.shape(mut vc, a))\n          }\n          smt.VTuple(xs)\n        },\n        \"Task\" => smt.shape(mut vc, get(args, 0) ?? ast.UnitType),\n        _ => match get(vc.types, name) {\n          // a type parameter's values: terms of an uninterpreted sort\n          None => match smt.sort_of(mut vc, t) {\n            Some(sort) => smt.VData { ty: t, t: smt.fresh_why(\n              mut vc,\n              sort,\n              f\"values of the generic type `{name}` are not known\",\n            ) },\n            None => smt.Opaque(\n              f\"values of the generic type `{name}` are not known\",\n            ),\n          },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              ) }\n            } else {\n              smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              )\n            },\n            ast.RecordBody(_) => {\n              rc := get(smt.variants_of(vc, name, args) ?? [], 0) ?? smt.Ctor { name, fields: None, types: [] }\n              mut fs := []\n              for (k, f) in enumerate(rc.fields ?? []) {\n                mut fs.push(\n                  (\n                    f,\n                    smt.part(\n                      mut vc,\n                      get(rc.types, k) ?? ast.UnitType,\n                    ),\n                  ),\n                )\n              }\n              smt.VRec { name, fields: fs }\n            },\n            ast.SumBody(_) => {\n              vs := smt.variants_of(vc, name, args) ?? []\n              tag := smt.fresh(mut vc, \"Int\")\n              smt.push_fact(\n                mut vc,\n                f\"(and (<= 0 {tag}) (< {tag} {len(vs)}))\",\n              )\n              mut ctors := []\n              for c in vs {\n                mut payload := []\n                for ft in c.types {\n                  mut payload.push(smt.part(mut vc, ft))\n                }\n                mut ctors.push((c.name, payload))\n              }\n              smt.VSum { ty: name, args, tag, ctors }\n            },\n          },\n        },\n      },\n    },\n  }\n}"},{"name":"smt.eq_list_values","kind":"fn","old":"806968895f214826","new":"8828a515d2069de3","interface_changed":false,"affected":[],"module":"smt","text":"// ---- list equality ----\n\n/// Two lists equal: as sequences of a datatype (equal terms), by position\n/// in a goal where both are known so, else only their lengths.\nfn eq_list_values(\n  mut vc: smt.Vc,\n  l1: String,\n  i1: Int,\n  l2: String,\n  i2: Int,\n) -> String {\n  match (smt.list_info(vc, i1).source, smt.list_info(vc, i2).source) {\n    (smt.GSeq(x, _, n), smt.GSeq(y, _, m)) => return if n != m {\n      smt.unknown_bool(mut vc, \"comparing lists of different types\")\n    } else {\n      f\"(= {x} {y})\"\n    },\n    _ => (),\n  }\n  match smt.seq_equal(mut vc, i1, i2) {\n    Some(e) => return e,\n    None => (),\n  }\n  if i1 == i2 {\n    return f\"(= {l1} {l2})\"\n  }\n  // by position, where both are known so: only in a goal, and not inside a\n  // quantified fact\n  if vc.proving > 0\n    && vc.eq_depth < 2\n    && vc.indexing == None\n    && len(vc.regions) == 0 {\n    vc.eq_depth += 1\n    e := smt.eq_lists(mut vc, i1, l1, i2, l2)\n    vc.eq_depth -= 1\n    match e {\n      Some(x) => return x,\n      None => (),\n    }\n  }\n  // equal lists have equal lengths and, when both are known by position,\n  // equal elements at the positions the code takes (`ListInfo.same`)\n  if vc.list_eq > 0\n    && vc.in_same == 0\n    && vc.binding == 0\n    && len(vc.regions) == 0\n    && smt.positional(vc, i1)\n    && smt.positional(vc, i2) {\n    b := smt.unknown_bool(\n      mut vc,\n      \"comparing lists (their elements are equal only where taken)\",\n    )\n    smt.push_fact(mut vc, f\"(=> {b} (= {l1} {l2}))\")\n    smt.same_lists(mut vc, b, i1, i2)\n    smt.same_lists(mut vc, b, i2, i1)\n    return b\n  }\n  b := smt.unknown_bool(mut vc, \"the elements of a list are not tracked\")\n  smt.push_fact(mut vc, f\"(=> {b} (= {l1} {l2}))\")\n  b\n}","old_text":"// ---- list equality ----\n\n/// Two lists equal: as sequences of a datatype (equal terms), by position\n/// in a goal where both are known so, else only their lengths.\nfn eq_list_values(\n  mut vc: smt.Vc,\n  l1: String,\n  i1: Int,\n  l2: String,\n  i2: Int,\n) -> String {\n  match (smt.list_info(vc, i1).source, smt.list_info(vc, i2).source) {\n    (smt.GSeq(x, _, n), smt.GSeq(y, _, m)) => return if n != m {\n      smt.unknown_bool(mut vc, \"comparing lists of different types\")\n    } else {\n      f\"(= {x} {y})\"\n    },\n    _ => (),\n  }\n  if i1 == i2 {\n    return f\"(= {l1} {l2})\"\n  }\n  // by position, where both are known so: only in a goal, and not inside a\n  // quantified fact\n  if vc.proving > 0\n    && vc.eq_depth < 2\n    && vc.indexing == None\n    && len(vc.regions) == 0 {\n    vc.eq_depth += 1\n    e := smt.eq_lists(mut vc, i1, l1, i2, l2)\n    vc.eq_depth -= 1\n    match e {\n      Some(x) => return x,\n      None => (),\n    }\n  }\n  // equal lists have equal lengths and, when both are known by position,\n  // equal elements at the positions the code takes (`ListInfo.same`)\n  if vc.list_eq > 0\n    && vc.in_same == 0\n    && vc.binding == 0\n    && len(vc.regions) == 0\n    && smt.positional(vc, i1)\n    && smt.positional(vc, i2) {\n    b := smt.unknown_bool(\n      mut vc,\n      \"comparing lists (their elements are equal only where taken)\",\n    )\n    smt.push_fact(mut vc, f\"(=> {b} (= {l1} {l2}))\")\n    smt.same_lists(mut vc, b, i1, i2)\n    smt.same_lists(mut vc, b, i2, i1)\n    return b\n  }\n  b := smt.unknown_bool(mut vc, \"the elements of a list are not tracked\")\n  smt.push_fact(mut vc, f\"(=> {b} (= {l1} {l2}))\")\n  b\n}"},{"name":"smt.declarations","kind":"fn","old":"a03feb22f12718d0","new":"2c557b387152cb34","interface_changed":false,"affected":[],"module":"smt","text":"/// The declarations of every sort and predicate. The datatypes form one\n/// group, since they may refer to each other.\nfn declarations(vc: smt.Vc) -> String {\n  mut s := \"\"\n  mut heads := []\n  mut bodies := []\n  for (n, d) in vc.sorts {\n    match d {\n      smt.OpaqueSort => {\n        s += f\"(declare-sort {smt.sym(n)} 0)\\n\"\n      },\n      smt.ListSort(item) => {\n        s += if smt.list_mode() == \"seq\" && smt.seq_sorted(vc, n) {\n          f\"(define-sort {smt.sym(n)} () (Seq {item}))\\n\"\n        } else {\n          f\"(declare-sort {smt.sym(n)} 0)\\n\"\n        }\n      },\n      smt.MapSort(_) => (),\n      smt.DataSort(cs) => {\n        mut heads.push(f\"({smt.sym(n)} 0)\")\n        mut ctors := []\n        for (c, fs) in cs {\n          mut fields := \"\"\n          for (k, f) in enumerate(fs) {\n            fields += f\" ({smt.sym(c + \".\" + f\"{k}\")} {f})\"\n          }\n          mut ctors.push(\"(\" + smt.sym(c) + fields + \")\")\n        }\n        mut bodies.push(\"(\" + join(ctors, \" \") + \")\")\n      },\n    }\n  }\n  if len(heads) > 0 {\n    s += \"(declare-datatypes (\"\n      + join(heads, \" \")\n      + \") (\"\n      + join(bodies, \" \")\n      + \"))\\n\"\n  }\n  for (n, d) in vc.sorts {\n    match d {\n      smt.DataSort(cs) => {\n        last := len(cs) - 1\n        mut e := if last < 0 {\n          \"0\"\n        } else {\n          f\"{last}\"\n        }\n        mut k := last - 1\n        while k >= 0 {\n          c := (get(cs, k) ?? (\"\", [])).0\n          e = f\"(ite ((_ is {smt.sym(c)}) x) {k} {e})\"\n          k -= 1\n        }\n        s += f\"(define-fun {smt.sym(n + \".tag\")} ((x {smt.sym(n)})) Int {e})\\n\"\n      },\n      _ => (),\n    }\n  }\n  for (n, d) in vc.sorts {\n    match d {\n      smt.ListSort(item) => if smt.list_mode() == \"seq\" && smt.seq_sorted(vc, n) {\n        s += \"(define-fun \"\n          + smt.sym(n + \".len\")\n          + \" ((s \"\n          + smt.sym(n)\n          + \")) Int (seq.len s))\\n(define-fun \"\n          + smt.sym(n + \".at\")\n          + \" ((s \"\n          + smt.sym(n)\n          + \") (i Int)) \"\n          + item\n          + \" (seq.nth s i))\\n\"\n      } else {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".len\")\n          + \" (\"\n          + smt.sym(n)\n          + \") Int)\\n(declare-fun \"\n          + smt.sym(n + \".at\")\n          + \" (\"\n          + smt.sym(n)\n          + \" Int) \"\n          + item\n          + \")\\n\"\n      },\n      smt.MapSort(arr) => {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".size\")\n          + \" (\"\n          + arr\n          + \") Int)\\n\"\n      },\n      _ => (),\n    }\n  }\n  for (v, sort) in vc.valid {\n    s += f\"(declare-fun {v} ({sort}) Bool)\\n\"\n  }\n  for (r, (args, ret)) in items(vc.rec_fns) {\n    s += \"(declare-fun \"\n      + smt.sym(r)\n      + \" (\"\n      + join(args, \" \")\n      + \") \"\n      + ret\n      + \")\\n\"\n  }\n  for (f, a, r) in vc.of_receiver {\n    s += f\"(declare-fun {f} ({a}) {r})\\n\"\n  }\n  for (f, a) in vc.orders {\n    s += f\"(declare-fun {f} ({a} {a}) Int)\\n\"\n  }\n  s\n}","old_text":"/// The declarations of every sort and predicate. The datatypes form one\n/// group, since they may refer to each other.\nfn declarations(vc: smt.Vc) -> String {\n  mut s := \"\"\n  mut heads := []\n  mut bodies := []\n  for (n, d) in vc.sorts {\n    match d {\n      smt.OpaqueSort | smt.ListSort(_) => {\n        s += f\"(declare-sort {smt.sym(n)} 0)\\n\"\n      },\n      smt.MapSort(_) => (),\n      smt.DataSort(cs) => {\n        mut heads.push(f\"({smt.sym(n)} 0)\")\n        mut ctors := []\n        for (c, fs) in cs {\n          mut fields := \"\"\n          for (k, f) in enumerate(fs) {\n            fields += f\" ({smt.sym(c + \".\" + f\"{k}\")} {f})\"\n          }\n          mut ctors.push(\"(\" + smt.sym(c) + fields + \")\")\n        }\n        mut bodies.push(\"(\" + join(ctors, \" \") + \")\")\n      },\n    }\n  }\n  if len(heads) > 0 {\n    s += \"(declare-datatypes (\"\n      + join(heads, \" \")\n      + \") (\"\n      + join(bodies, \" \")\n      + \"))\\n\"\n  }\n  for (n, d) in vc.sorts {\n    match d {\n      smt.DataSort(cs) => {\n        last := len(cs) - 1\n        mut e := if last < 0 {\n          \"0\"\n        } else {\n          f\"{last}\"\n        }\n        mut k := last - 1\n        while k >= 0 {\n          c := (get(cs, k) ?? (\"\", [])).0\n          e = f\"(ite ((_ is {smt.sym(c)}) x) {k} {e})\"\n          k -= 1\n        }\n        s += f\"(define-fun {smt.sym(n + \".tag\")} ((x {smt.sym(n)})) Int {e})\\n\"\n      },\n      _ => (),\n    }\n  }\n  for (n, d) in vc.sorts {\n    match d {\n      smt.ListSort(item) => {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".len\")\n          + \" (\"\n          + smt.sym(n)\n          + \") Int)\\n(declare-fun \"\n          + smt.sym(n + \".at\")\n          + \" (\"\n          + smt.sym(n)\n          + \" Int) \"\n          + item\n          + \")\\n\"\n      },\n      smt.MapSort(arr) => {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".size\")\n          + \" (\"\n          + arr\n          + \") Int)\\n\"\n      },\n      _ => (),\n    }\n  }\n  for (v, sort) in vc.valid {\n    s += f\"(declare-fun {v} ({sort}) Bool)\\n\"\n  }\n  for (r, (args, ret)) in items(vc.rec_fns) {\n    s += \"(declare-fun \"\n      + smt.sym(r)\n      + \" (\"\n      + join(args, \" \")\n      + \") \"\n      + ret\n      + \")\\n\"\n  }\n  for (f, a, r) in vc.of_receiver {\n    s += f\"(declare-fun {f} ({a}) {r})\\n\"\n  }\n  for (f, a) in vc.orders {\n    s += f\"(declare-fun {f} ({a} {a}) Int)\\n\"\n  }\n  s\n}"},{"name":"smt.list_mode","kind":"fn","old":null,"new":"6f4f7ec4bda5d681","interface_changed":true,"affected":[],"module":"smt","text":"/// The list encoding the environment's `STRATA_LISTS` names: `patterns`\n/// (each quantifier with triggers, `listed`), `seq` (lists of plain\n/// elements as z3 sequences, `seq_sorted`), else the default.\nfn list_mode() -> String {\n  smt.driver_env(\"STRATA_LISTS\")\n}"},{"name":"smt.listed","kind":"fn","old":null,"new":"c4adbe604f6fd82f","interface_changed":true,"affected":[],"module":"smt","text":"/// `script`, under `STRATA_LISTS=patterns` with each quantifier that has no\n/// triggers given those its body offers (`triggers`), its body's defined\n/// functions read through.\nfn listed(script: String) -> String {\n  if smt.list_mode() != \"patterns\" || !contains(script, \"(forall\") {\n    return script\n  }\n  mut defs := Dict[String, (List[String], smt.Sx)] {}\n  mut decls := Set[String] {}\n  mut out := []\n  for line in split(script, \"\\n\") {\n    mut l := line\n    if starts_with(line, \"(\") && contains(line, \"(forall\") {\n      l = join(smt.parse_sx(line).map(\n        x -> smt.sx_symbols(smt.triggered(x, defs, decls)),\n      ), \" \")\n    }\n    if starts_with(line, \"(define-fun \") {\n      match get(smt.parse_sx(line), 0) {\n        Some(smt.SList([_, smt.SAtom(name), smt.SList(ps), _, body])) => mut defs.insert(name, (ps.map(p -> smt.sx_head(p)), body)),\n        _ => (),\n      }\n    } else if starts_with(line, \"(declare-fun \") {\n      match get(smt.parse_sx(line), 0) {\n        Some(smt.SList([_, smt.SAtom(name), smt.SList(args), _])) => if len(args) > 0 {\n          mut decls.insert(name)\n        },\n        _ => (),\n      }\n    }\n    mut out.push(l)\n  }\n  join(out, \"\\n\")\n}"},{"name":"smt.sx_head","kind":"fn","old":null,"new":"5a5ab02ce4d51387","interface_changed":true,"affected":[],"module":"smt","text":"/// The first atom of `x`: a list's head, or `x` itself.\nfn sx_head(x: smt.Sx) -> String {\n  match x {\n    smt.SAtom(a) => a,\n    smt.SList(xs) => match get(xs, 0) {\n      Some(smt.SAtom(a)) => a,\n      _ => \"\",\n    },\n  }\n}"},{"name":"smt.triggered","kind":"fn","old":null,"new":"d596717f77558600","interface_changed":true,"affected":[],"module":"smt","text":"/// `x` with each `forall` that has no attributes given `:pattern`s from\n/// `triggers`, when its body has some.\nfn triggered(\n  x: smt.Sx,\n  defs: Dict[String, (List[String], smt.Sx)],\n  decls: Set[String],\n) -> smt.Sx {\n  match x {\n    smt.SAtom(_) => x,\n    smt.SList(xs) => {\n      ys := xs.map(y -> smt.triggered(y, defs, decls))\n      match ys {\n        [smt.SAtom(q), smt.SList(bs), body] => if q == \"forall\" && smt.sx_head(body) != \"!\" {\n          ps := smt.triggers(\n            body,\n            bs.map(b -> smt.sx_head(b)),\n            defs,\n            decls,\n          )\n          if len(ps) == 0 {\n            smt.SList(ys)\n          } else {\n            mut ann := [smt.SAtom(\"!\"), body]\n            for p in ps {\n              ann += [smt.SAtom(\":pattern\"), smt.SList(p)]\n            }\n            smt.SList([smt.SAtom(q), smt.SList(bs), smt.SList(ann)])\n          }\n        } else {\n          smt.SList(ys)\n        },\n        _ => smt.SList(ys),\n      }\n    },\n  }\n}"},{"name":"smt.triggers","kind":"fn","old":null,"new":"3879d5192e04072b","interface_changed":true,"affected":[],"module":"smt","text":"/// Triggers for a quantifier over `vars` with this body: each a list of\n/// terms. Up to three single terms that name every variable and hold no\n/// smaller such term, else one term per variable together; none when the\n/// body has no application of a declared function (or `select`,\n/// `seq.nth`) over the variables.\nfn triggers(\n  body: smt.Sx,\n  vars: List[String],\n  defs: Dict[String, (List[String], smt.Sx)],\n  decls: Set[String],\n) -> List[List[smt.Sx]] {\n  mut found: List[smt.Sx] = []\n  smt.trigger_terms(body, vars, [], defs, decls, 0, mut found)\n  covering := found.filter(t -> vars.all(v -> smt.sx_mentions(t, v)))\n  least := covering.filter(\n    t -> !covering.any(u -> u != t && smt.sx_inside(u, t)),\n  )\n  if len(least) > 0 {\n    return take(least, 3).map(t -> [t])\n  }\n  mut multi: List[smt.Sx] = []\n  for v in vars {\n    if !multi.any(t -> smt.sx_mentions(t, v)) {\n      match get(found.filter(t -> smt.sx_mentions(t, v)), 0) {\n        Some(t) => mut multi.push(t),\n        None => return [],\n      }\n    }\n  }\n  [multi]\n}"},{"name":"smt.trigger_terms","kind":"fn","old":null,"new":"efdf2f882bbc50e1","interface_changed":true,"affected":[],"module":"smt","text":"/// Adds to `found` the terms of `x` fit to be triggers for `vars`: an\n/// application of a declared function, `select` or `seq.nth` naming some\n/// of `vars`, no variable bound inside (`locals`), and no connective,\n/// `ite` or binder. Defined functions are read through, three levels deep.\nfn trigger_terms(\n  x: smt.Sx,\n  vars: List[String],\n  locals: List[String],\n  defs: Dict[String, (List[String], smt.Sx)],\n  decls: Set[String],\n  depth: Int,\n  mut found: List[smt.Sx],\n) {\n  match x {\n    smt.SAtom(_) => (),\n    smt.SList(xs) => {\n      h := smt.sx_head(x)\n      if h == \"forall\" || h == \"exists\" || h == \"lambda\" || h == \"let\" {\n        bound := match get(xs, 1) {\n          Some(smt.SList(bs)) => bs,\n          _ => [],\n        }\n        if h == \"let\" {\n          for b in bound {\n            match b {\n              smt.SList(p) => {\n                for y in drop(p, 1) {\n                  smt.trigger_terms(\n                    y,\n                    vars,\n                    locals,\n                    defs,\n                    decls,\n                    depth,\n                    mut found,\n                  )\n                }\n              },\n              _ => (),\n            }\n          }\n        }\n        inner := locals + bound.map(b -> smt.sx_head(b))\n        for y in drop(xs, 2) {\n          smt.trigger_terms(\n            y,\n            vars,\n            inner,\n            defs,\n            decls,\n            depth,\n            mut found,\n          )\n        }\n        return\n      }\n      for y in drop(xs, 1) {\n        smt.trigger_terms(\n          y,\n          vars,\n          locals,\n          defs,\n          decls,\n          depth,\n          mut found,\n        )\n      }\n      if len(found) < 32\n        && (contains(decls, h) || h == \"select\" || h == \"seq.nth\")\n        && vars.any(v -> smt.sx_mentions(x, v))\n        && !locals.any(v -> smt.sx_mentions(x, v))\n        && smt.sx_plain(x)\n        && !found.any(t -> t == x) {\n        mut found.push(x)\n      }\n      if depth < 3 {\n        match get(defs, h) {\n          Some((ps, d)) => if len(ps) > 0 && len(ps) + 1 == len(xs) {\n            e := smt.sx_subst(d, dict(zip(ps, drop(xs, 1))))\n            smt.trigger_terms(\n              e,\n              vars,\n              locals,\n              defs,\n              decls,\n              depth + 1,\n              mut found,\n            )\n          },\n          None => (),\n        }\n      }\n    },\n  }\n}"},{"name":"smt.sx_subst","kind":"fn","old":null,"new":"393be97468d0fd37","interface_changed":true,"affected":[],"module":"smt","text":"/// `x` with each atom in `to` replaced by its term.\nfn sx_subst(x: smt.Sx, to: Dict[String, smt.Sx]) -> smt.Sx {\n  match x {\n    smt.SAtom(a) => get(to, a) ?? x,\n    smt.SList(xs) => smt.SList(xs.map(y -> smt.sx_subst(y, to))),\n  }\n}"},{"name":"smt.sx_mentions","kind":"fn","old":null,"new":"15b339b1b7c77e60","interface_changed":true,"affected":[],"module":"smt","text":"/// Whether atom `v` occurs in `x`.\nfn sx_mentions(x: smt.Sx, v: String) -> Bool {\n  match x {\n    smt.SAtom(a) => a == v,\n    smt.SList(xs) => xs.any(y -> smt.sx_mentions(y, v)),\n  }\n}"},{"name":"smt.sx_inside","kind":"fn","old":null,"new":"137bd708ca2d8ea1","interface_changed":true,"affected":[],"module":"smt","text":"/// Whether `u` is a proper part of `t`.\nfn sx_inside(u: smt.Sx, t: smt.Sx) -> Bool {\n  match t {\n    smt.SAtom(_) => false,\n    smt.SList(xs) => xs.any(y -> y == u || smt.sx_inside(u, y)),\n  }\n}"},{"name":"smt.sx_plain","kind":"fn","old":null,"new":"8c2877359e23fcec","interface_changed":true,"affected":[],"module":"smt","text":"/// Whether no list in `x` is headed by a connective, `=`, `ite`, a binder\n/// or an attribute, which z3 refuses in a trigger.\nfn sx_plain(x: smt.Sx) -> Bool {\n  match x {\n    smt.SAtom(_) => true,\n    smt.SList(xs) => !contains([\n        \"ite\",\n        \"and\",\n        \"or\",\n        \"not\",\n        \"=>\",\n        \"=\",\n        \"distinct\",\n        \"xor\",\n        \"forall\",\n        \"exists\",\n        \"let\",\n        \"lambda\",\n        \"!\",\n      ], smt.sx_head(x))\n      && xs.all(y -> smt.sx_plain(y)),\n  }\n}"},{"name":"smt.sx_symbols","kind":"fn","old":null,"new":"562e4bf1e4554785","interface_changed":true,"affected":[],"module":"smt","text":"/// An s-expression as SMT-LIB text, atoms that aren't simple symbols,\n/// numerals, keywords or string literals quoted as `|…|` (`parse_sx`\n/// takes the bars off).\nfn sx_symbols(x: smt.Sx) -> String {\n  match x {\n    smt.SAtom(a) => if smt.simple_symbol(a) {\n      a\n    } else {\n      \"|\" + a + \"|\"\n    },\n    smt.SList(xs) => \"(\" + join(xs.map(y -> smt.sx_symbols(y)), \" \") + \")\",\n  }\n}"},{"name":"smt.simple_symbol","kind":"fn","old":null,"new":"1aa2260747ee027a","interface_changed":true,"affected":[],"module":"smt","text":"/// Whether `a` reads as itself unquoted: a string literal, or letters,\n/// digits and SMT-LIB's symbol characters (a `:` only first).\nfn simple_symbol(a: String) -> Bool {\n  n := byte_len(a)\n  if n == 0 {\n    return false\n  }\n  if byte_at(a, 0) == 34 {\n    return true\n  }\n  for i in 0..n {\n    b := byte_at(a, i)\n    ok := b >= 48 && b <= 57\n      || b >= 65 && b <= 90\n      || b >= 97 && b <= 122\n      || contains(\"~!@$%^&*_-+=<>.?/#\", chr(b))\n      || b == 58 && i == 0\n    if !ok {\n      return false\n    }\n  }\n  true\n}"},{"name":"smt.seq_sorted","kind":"fn","old":null,"new":"f119e33576da2d88","interface_changed":true,"affected":[],"module":"smt","text":"/// Whether the list sort named `n` is a z3 sequence under\n/// `STRATA_LISTS=seq`: its elements are of a plain sort, or of such a list\n/// sort.\nfn seq_sorted(vc: smt.Vc, n: String) -> Bool {\n  match get(vc.sort_index, n) {\n    Some(i) => match get(vc.sorts, i) {\n      Some((_, smt.ListSort(item))) => item == \"Int\"\n        || item == \"Real\"\n        || item == \"Bool\"\n        || item == \"String\"\n        || starts_with(item, \"|T:List(\")\n          && item != smt.sym(n)\n          && smt.seq_sorted(vc, smt.bare(item)),\n      _ => false,\n    },\n    None => false,\n  }\n}"},{"name":"smt.seq_list","kind":"fn","old":null,"new":"098c0b1f7f181c78","interface_changed":true,"affected":[],"module":"smt","text":"/// Under `STRATA_LISTS=seq`, a fresh list of type `t` as an unknown of its\n/// sequence sort, valid when its elements are refined: `None` where it is\n/// no sequence or no unknown may be made (a quantifier, an element's\n/// template).\nfn seq_list(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  args: List[ast.TypeExpr],\n) -> Option[smt.Val] {\n  if smt.list_mode() != \"seq\"\n    || vc.binding > 0\n    || len(vc.regions) > 0\n    || vc.indexing != None {\n    return None\n  }\n  a := get(args, 0)?\n  s := smt.sort_of(mut vc, t)?\n  if !smt.seq_sorted(vc, smt.bare(s)) {\n    return None\n  }\n  k := smt.fresh(mut vc, s)\n  v := smt.from_term(mut vc, t, k)\n  if smt.refined(vc, a) {\n    ok := smt.valid_term(mut vc, ast.Named { name: \"List\", args: [a] }, k)\n    smt.push_fact(mut vc, ok)\n  }\n  Some(v)\n}"},{"name":"smt.seq_equal","kind":"fn","old":null,"new":"78ac66038a2131f7","interface_changed":true,"affected":[],"module":"smt","text":"/// Under `STRATA_LISTS=seq`, lists `a` and `b` equal as sequences, when\n/// both are made of sequence terms, concatenations and literals.\nfn seq_equal(mut vc: smt.Vc, a: Int, b: Int) -> Option[String] {\n  if smt.list_mode() != \"seq\" {\n    return None\n  }\n  (t, n) := smt.seq_kind(vc, a, 0) ?? smt.seq_kind(vc, b, 0)?\n  x := smt.seq_of(mut vc, a, t, n, 0)?\n  y := smt.seq_of(mut vc, b, t, n, 0)?\n  Some(f\"(= {x} {y})\")\n}"},{"name":"smt.seq_kind","kind":"fn","old":null,"new":"6af299431bf29cb2","interface_changed":true,"affected":[],"module":"smt","text":"/// The element type and sequence sort of list `id`, when a sequence term\n/// is part of it.\nfn seq_kind(vc: smt.Vc, id: Int, depth: Int) -> Option[(ast.TypeExpr, String)] {\n  if depth > 8 {\n    return None\n  }\n  match smt.list_info(vc, id).source {\n    smt.GSeq(_, t, n) => if smt.seq_sorted(vc, n) {\n      Some((t, n))\n    } else {\n      None\n    },\n    smt.GConcat(x, y, _) => match smt.seq_kind(vc, x, depth + 1) {\n      Some(k) => Some(k),\n      None => smt.seq_kind(vc, y, depth + 1),\n    },\n    _ => None,\n  }\n}"},{"name":"smt.seq_of","kind":"fn","old":null,"new":"5eb26d88f58f5349","interface_changed":true,"affected":[],"module":"smt","text":"/// List `id` as a term of sequence sort `n` (elements of type `t`): a\n/// sequence term, a concatenation of such, or a literal of plain values.\nfn seq_of(\n  mut vc: smt.Vc,\n  id: Int,\n  t: ast.TypeExpr,\n  n: String,\n  depth: Int,\n) -> Option[String] {\n  if depth > 8 {\n    return None\n  }\n  match smt.list_info(vc, id).source {\n    smt.GSeq(s, _, m) => if m == n {\n      Some(s)\n    } else {\n      None\n    },\n    smt.GConcat(x, y, _) => {\n      p := smt.seq_of(mut vc, x, t, n, depth + 1)?\n      q := smt.seq_of(mut vc, y, t, n, depth + 1)?\n      Some(f\"(seq.++ {p} {q})\")\n    },\n    smt.GValues(vs) => {\n      mut parts := []\n      for v in vs {\n        e := smt.pure_term(mut vc, t, v)?\n        mut parts.push(f\"(seq.unit {e})\")\n      }\n      Some(if len(parts) == 0 {\n        f\"(as seq.empty {smt.sym(n)})\"\n      } else if len(parts) == 1 {\n        get(parts, 0) ?? \"\"\n      } else {\n        \"(seq.++ \" + join(parts, \" \") + \")\"\n      })\n    },\n    _ => None,\n  }\n}"}]}
{"id":"ccdb1ba5325ad10d","time":1795832654,"message":"rename smt.real_key → smt.builtin_key","changes":[{"name":"smt.shape","kind":"fn","old":"3f74c219e7a9fa3a","new":"104e55b67a49c31a","interface_changed":false,"affected":[],"module":"smt","text":"/// A value of type `t` made of fresh unknowns, nothing assumed. Its outer\n/// level is built now, its structured parts are datatype terms.\nfn shape(mut vc: smt.Vc, t: ast.TypeExpr) -> smt.Val {\n  match t {\n    ast.Named { name, .. } => if smt.width_of(name) != None {\n      x := smt.fresh(mut vc, \"Int\")\n      smt.push_fact(mut vc, smt.word_range(name, x))\n      return smt.word(mut vc, name, x)\n    },\n    _ => (),\n  }\n  match t {\n    ast.Refined { base, .. } => smt.shape(mut vc, base),\n    ast.UnitType => smt.UnitVal,\n    ast.FnType { ret, .. } => smt.VFn { ret },\n    ast.RowType(_) => smt.Opaque(\n      \"a structural type (`{ f: T, .. }`) has no values of its own\",\n    ),\n    ast.UnionType(_) => match smt.sort_of(mut vc, t) {\n      Some(s) => {\n        x := smt.fresh(mut vc, s)\n        smt.unfold(mut vc, t, x)\n      },\n      None => smt.Opaque(\n        \"values of this union type are not modelled (members of overlapping or unknown shapes)\",\n      ),\n    },\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => {\n        // a variant as a type: a value of its sum with that tag\n        v := smt.shape(mut vc, ast.Named { name: p, args })\n        match v {\n          smt.VSum { tag, ctors, .. } => match smt.position(ctors, name) {\n            Some(k) => smt.push_fact(mut vc, f\"(= {tag} {k})\"),\n            None => (),\n          },\n          _ => (),\n        }\n        v\n      },\n      None => match smt.builtin_key(vc, name) {\n        \"Int\" => {\n          a1 := smt.fresh(mut vc, \"Int\")\n          smt.vint(mut vc, a1)\n        },\n        \"Real\" => {\n          a0 := smt.fresh(mut vc, \"Real\")\n          smt.VReal(smt.tm(mut vc, a0))\n        },\n        \"Bool\" => {\n          a2 := smt.fresh(mut vc, \"Bool\")\n          smt.vbool(mut vc, a2)\n        },\n        \"String\" => {\n          a3 := smt.fresh(mut vc, \"String\")\n          smt.vstr(mut vc, a3)\n        },\n        \"Float\" => {\n          t := smt.fresh(mut vc, \"Real\")\n          smt.push_fact(mut vc, smt.float_range(t))\n          smt.VFloat(smt.tm(mut vc, t))\n        },\n        \"List\" => {\n          l := smt.fresh(mut vc, \"Int\")\n          smt.push_fact(mut vc, f\"(>= {l} 0)\")\n          smt.new_list(mut vc, l, match get(args, 0) {\n            Some(a) => smt.GType(a),\n            None => smt.Untracked,\n          })\n        },\n        // dicts and sets: an array of their entries (`map_sorts`)\n        \"Dict\" | \"Set\" => smt.fresh_keyed(mut vc, t),\n        \"Tuple\" => {\n          mut xs := []\n          for a in args {\n            mut xs.push(smt.shape(mut vc, a))\n          }\n          smt.VTuple(xs)\n        },\n        \"Task\" => smt.shape(mut vc, get(args, 0) ?? ast.UnitType),\n        _ => match get(vc.types, name) {\n          // a type parameter's values: terms of an uninterpreted sort\n          None => match smt.sort_of(mut vc, t) {\n            Some(sort) => smt.VData { ty: t, t: smt.fresh_why(\n              mut vc,\n              sort,\n              f\"values of the generic type `{name}` are not known\",\n            ) },\n            None => smt.Opaque(\n              f\"values of the generic type `{name}` are not known\",\n            ),\n          },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              ) }\n            } else {\n              smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              )\n            },\n            ast.RecordBody(_) => {\n              rc := get(smt.variants_of(vc, name, args) ?? [], 0) ?? smt.Ctor { name, fields: None, types: [] }\n              mut fs := []\n              for (k, f) in enumerate(rc.fields ?? []) {\n                mut fs.push(\n                  (\n                    f,\n                    smt.part(\n                      mut vc,\n                      get(rc.types, k) ?? ast.UnitType,\n                    ),\n                  ),\n                )\n              }\n              smt.VRec { name, fields: fs }\n            },\n            ast.SumBody(_) => {\n              vs := smt.variants_of(vc, name, args) ?? []\n              tag := smt.fresh(mut vc, \"Int\")\n              smt.push_fact(\n                mut vc,\n                f\"(and (<= 0 {tag}) (< {tag} {len(vs)}))\",\n              )\n              mut ctors := []\n              for c in vs {\n                mut payload := []\n                for ft in c.types {\n                  mut payload.push(smt.part(mut vc, ft))\n                }\n                mut ctors.push((c.name, payload))\n              }\n              smt.VSum { ty: name, args, tag, ctors }\n            },\n          },\n        },\n      },\n    },\n  }\n}","old_text":"/// A value of type `t` made of fresh unknowns, nothing assumed. Its outer\n/// level is built now, its structured parts are datatype terms.\nfn shape(mut vc: smt.Vc, t: ast.TypeExpr) -> smt.Val {\n  match t {\n    ast.Named { name, .. } => if smt.width_of(name) != None {\n      x := smt.fresh(mut vc, \"Int\")\n      smt.push_fact(mut vc, smt.word_range(name, x))\n      return smt.word(mut vc, name, x)\n    },\n    _ => (),\n  }\n  match t {\n    ast.Refined { base, .. } => smt.shape(mut vc, base),\n    ast.UnitType => smt.UnitVal,\n    ast.FnType { ret, .. } => smt.VFn { ret },\n    ast.RowType(_) => smt.Opaque(\n      \"a structural type (`{ f: T, .. }`) has no values of its own\",\n    ),\n    ast.UnionType(_) => match smt.sort_of(mut vc, t) {\n      Some(s) => {\n        x := smt.fresh(mut vc, s)\n        smt.unfold(mut vc, t, x)\n      },\n      None => smt.Opaque(\n        \"values of this union type are not modelled (members of overlapping or unknown shapes)\",\n      ),\n    },\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => {\n        // a variant as a type: a value of its sum with that tag\n        v := smt.shape(mut vc, ast.Named { name: p, args })\n        match v {\n          smt.VSum { tag, ctors, .. } => match smt.position(ctors, name) {\n            Some(k) => smt.push_fact(mut vc, f\"(= {tag} {k})\"),\n            None => (),\n          },\n          _ => (),\n        }\n        v\n      },\n      None => match smt.real_key(vc, name) {\n        \"Int\" => {\n          a1 := smt.fresh(mut vc, \"Int\")\n          smt.vint(mut vc, a1)\n        },\n        \"Real\" => {\n          a0 := smt.fresh(mut vc, \"Real\")\n          smt.VReal(smt.tm(mut vc, a0))\n        },\n        \"Bool\" => {\n          a2 := smt.fresh(mut vc, \"Bool\")\n          smt.vbool(mut vc, a2)\n        },\n        \"String\" => {\n          a3 := smt.fresh(mut vc, \"String\")\n          smt.vstr(mut vc, a3)\n        },\n        \"Float\" => {\n          t := smt.fresh(mut vc, \"Real\")\n          smt.push_fact(mut vc, smt.float_range(t))\n          smt.VFloat(smt.tm(mut vc, t))\n        },\n        \"List\" => {\n          l := smt.fresh(mut vc, \"Int\")\n          smt.push_fact(mut vc, f\"(>= {l} 0)\")\n          smt.new_list(mut vc, l, match get(args, 0) {\n            Some(a) => smt.GType(a),\n            None => smt.Untracked,\n          })\n        },\n        // dicts and sets: an array of their entries (`map_sorts`)\n        \"Dict\" | \"Set\" => smt.fresh_keyed(mut vc, t),\n        \"Tuple\" => {\n          mut xs := []\n          for a in args {\n            mut xs.push(smt.shape(mut vc, a))\n          }\n          smt.VTuple(xs)\n        },\n        \"Task\" => smt.shape(mut vc, get(args, 0) ?? ast.UnitType),\n        _ => match get(vc.types, name) {\n          // a type parameter's values: terms of an uninterpreted sort\n          None => match smt.sort_of(mut vc, t) {\n            Some(sort) => smt.VData { ty: t, t: smt.fresh_why(\n              mut vc,\n              sort,\n              f\"values of the generic type `{name}` are not known\",\n            ) },\n            None => smt.Opaque(\n              f\"values of the generic type `{name}` are not known\",\n            ),\n          },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              ) }\n            } else {\n              smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              )\n            },\n            ast.RecordBody(_) => {\n              rc := get(smt.variants_of(vc, name, args) ?? [], 0) ?? smt.Ctor { name, fields: None, types: [] }\n              mut fs := []\n              for (k, f) in enumerate(rc.fields ?? []) {\n                mut fs.push(\n                  (\n                    f,\n                    smt.part(\n                      mut vc,\n                      get(rc.types, k) ?? ast.UnitType,\n                    ),\n                  ),\n                )\n              }\n              smt.VRec { name, fields: fs }\n            },\n            ast.SumBody(_) => {\n              vs := smt.variants_of(vc, name, args) ?? []\n              tag := smt.fresh(mut vc, \"Int\")\n              smt.push_fact(\n                mut vc,\n                f\"(and (<= 0 {tag}) (< {tag} {len(vs)}))\",\n              )\n              mut ctors := []\n              for c in vs {\n                mut payload := []\n                for ft in c.types {\n                  mut payload.push(smt.part(mut vc, ft))\n                }\n                mut ctors.push((c.name, payload))\n              }\n              smt.VSum { ty: name, args, tag, ctors }\n            },\n          },\n        },\n      },\n    },\n  }\n}"},{"name":"smt.sort_of","kind":"fn","old":"252d80d5c093ea49","new":"a224a06c749469ba","interface_changed":false,"affected":[],"module":"smt","text":"/// The SMT sort of the values of `t`.\nfn sort_of(mut vc: smt.Vc, t: ast.TypeExpr) -> Option[String] {\n  st := smt.sort_type(vc, t)\n  if smt.sized(st) {\n    return Some(\"Int\")\n  }\n  match st {\n    ast.UnitType => {\n      match smt.new_datatype(mut vc, \"T:Unit\") {\n        Some(i) => smt.set_datatype(mut vc, i, [(\"T:Unit.unit\", [])]),\n        None => (),\n      }\n      Some(smt.sym(\"T:Unit\"))\n    },\n    ast.FnType { .. } => Some(smt.opaque_sort(mut vc, \"Fn\")),\n    ast.Refined { base, .. } => smt.sort_of(mut vc, base),\n    ast.RowType(_) => Some(smt.opaque_sort(mut vc, \"Row\")),\n    ast.UnionType(ms) => {\n      gs := smt.union_groups(vc, ms)?\n      mut sorts := []\n      for g in gs {\n        mut sorts.push(smt.field_sort(mut vc, g.ty))\n      }\n      n := \"T:Union(\" + smt.bare(join(sorts, \",\")) + \")\"\n      match smt.new_datatype(mut vc, n) {\n        Some(i) => {\n          mut cs := []\n          for (k, s) in enumerate(sorts) {\n            mut cs.push((n + \".\" + f\"{k}\", [s]))\n          }\n          smt.set_datatype(mut vc, i, cs)\n        },\n        None => (),\n      }\n      Some(smt.sym(n))\n    },\n    ast.Named { name, args } => match smt.builtin_key(vc, name) {\n      \"Int\" | \"Real\" | \"Bool\" | \"String\" => Some(name),\n      \"Dict\" | \"Set\" => match smt.map_sorts(mut vc, st) {\n        Some(ms) => Some(ms.arr),\n        None => Some(smt.opaque_sort(mut vc, name)),\n      },\n      \"Float\" => Some(\"Real\"),\n      \"_\" => Some(smt.opaque_sort(mut vc, name)),\n      \"List\" => match get(args, 0) {\n        Some(a) => {\n          item := smt.field_sort(mut vc, a)\n          n := \"T:List(\" + smt.bare(item) + \")\"\n          if !contains(vc.sort_index, n) {\n            mut vc.sort_index.insert(n, len(vc.sorts))\n            mut vc.sorts.push((n, smt.ListSort(item)))\n          }\n          Some(smt.sym(n))\n        },\n        None => Some(smt.opaque_sort(mut vc, \"List\")),\n      },\n      \"Tuple\" => {\n        n := smt.dt_name(st)\n        match smt.new_datatype(mut vc, n) {\n          Some(i) => {\n            mut fs := []\n            for a in args {\n              mut fs.push(smt.field_sort(mut vc, a))\n            }\n            smt.set_datatype(mut vc, i, [(n + \".mk\", fs)])\n          },\n          None => (),\n        }\n        Some(smt.sym(n))\n      },\n      // (a datatype declared already: its constructors aren't made again)\n      _ => if contains(vc.sort_index, smt.dt_name(st)) {\n        Some(smt.sym(smt.dt_name(st)))\n      } else {\n        match smt.variants_of(vc, name, args) {\n          Some(vs) => {\n            n := smt.dt_name(st)\n            match smt.new_datatype(mut vc, n) {\n              Some(i) => {\n                mut cs := []\n                for c in vs {\n                  mut fs := []\n                  for ft in c.types {\n                    mut fs.push(smt.field_sort(mut vc, ft))\n                  }\n                  mut cs.push((n + \".\" + c.name, fs))\n                }\n                smt.set_datatype(mut vc, i, cs)\n              },\n              None => (),\n            }\n            Some(smt.sym(n))\n          },\n          None => Some(smt.opaque_sort(mut vc, text.type_text(st))),\n        }\n      },\n    },\n  }\n}","old_text":"/// The SMT sort of the values of `t`.\nfn sort_of(mut vc: smt.Vc, t: ast.TypeExpr) -> Option[String] {\n  st := smt.sort_type(vc, t)\n  if smt.sized(st) {\n    return Some(\"Int\")\n  }\n  match st {\n    ast.UnitType => {\n      match smt.new_datatype(mut vc, \"T:Unit\") {\n        Some(i) => smt.set_datatype(mut vc, i, [(\"T:Unit.unit\", [])]),\n        None => (),\n      }\n      Some(smt.sym(\"T:Unit\"))\n    },\n    ast.FnType { .. } => Some(smt.opaque_sort(mut vc, \"Fn\")),\n    ast.Refined { base, .. } => smt.sort_of(mut vc, base),\n    ast.RowType(_) => Some(smt.opaque_sort(mut vc, \"Row\")),\n    ast.UnionType(ms) => {\n      gs := smt.union_groups(vc, ms)?\n      mut sorts := []\n      for g in gs {\n        mut sorts.push(smt.field_sort(mut vc, g.ty))\n      }\n      n := \"T:Union(\" + smt.bare(join(sorts, \",\")) + \")\"\n      match smt.new_datatype(mut vc, n) {\n        Some(i) => {\n          mut cs := []\n          for (k, s) in enumerate(sorts) {\n            mut cs.push((n + \".\" + f\"{k}\", [s]))\n          }\n          smt.set_datatype(mut vc, i, cs)\n        },\n        None => (),\n      }\n      Some(smt.sym(n))\n    },\n    ast.Named { name, args } => match smt.real_key(vc, name) {\n      \"Int\" | \"Real\" | \"Bool\" | \"String\" => Some(name),\n      \"Dict\" | \"Set\" => match smt.map_sorts(mut vc, st) {\n        Some(ms) => Some(ms.arr),\n        None => Some(smt.opaque_sort(mut vc, name)),\n      },\n      \"Float\" => Some(\"Real\"),\n      \"_\" => Some(smt.opaque_sort(mut vc, name)),\n      \"List\" => match get(args, 0) {\n        Some(a) => {\n          item := smt.field_sort(mut vc, a)\n          n := \"T:List(\" + smt.bare(item) + \")\"\n          if !contains(vc.sort_index, n) {\n            mut vc.sort_index.insert(n, len(vc.sorts))\n            mut vc.sorts.push((n, smt.ListSort(item)))\n          }\n          Some(smt.sym(n))\n        },\n        None => Some(smt.opaque_sort(mut vc, \"List\")),\n      },\n      \"Tuple\" => {\n        n := smt.dt_name(st)\n        match smt.new_datatype(mut vc, n) {\n          Some(i) => {\n            mut fs := []\n            for a in args {\n              mut fs.push(smt.field_sort(mut vc, a))\n            }\n            smt.set_datatype(mut vc, i, [(n + \".mk\", fs)])\n          },\n          None => (),\n        }\n        Some(smt.sym(n))\n      },\n      // (a datatype declared already: its constructors aren't made again)\n      _ => if contains(vc.sort_index, smt.dt_name(st)) {\n        Some(smt.sym(smt.dt_name(st)))\n      } else {\n        match smt.variants_of(vc, name, args) {\n          Some(vs) => {\n            n := smt.dt_name(st)\n            match smt.new_datatype(mut vc, n) {\n              Some(i) => {\n                mut cs := []\n                for c in vs {\n                  mut fs := []\n                  for ft in c.types {\n                    mut fs.push(smt.field_sort(mut vc, ft))\n                  }\n                  mut cs.push((n + \".\" + c.name, fs))\n                }\n                smt.set_datatype(mut vc, i, cs)\n              },\n              None => (),\n            }\n            Some(smt.sym(n))\n          },\n          None => Some(smt.opaque_sort(mut vc, text.type_text(st))),\n        }\n      },\n    },\n  }\n}"},{"name":"smt.builtin_key","kind":"fn","old":null,"new":"0a985e37105ca095","interface_changed":true,"affected":[],"module":"smt","text":"/// A type's name as the sorts are chosen by: `$Real` (a record) for `Real`\n/// inside core.real (`real_record`).\nfn builtin_key(vc: smt.Vc, name: String) -> String {\n  if name == \"Real\" && smt.real_record(vc) {\n    \"$Real\"\n  } else {\n    name\n  }\n}"},{"name":"smt.from_term","kind":"fn","old":"3a6826cf8f8207ea","new":"d48c847e9219c8fe","interface_changed":false,"affected":[],"module":"smt","text":"/// The value a term of type `ty` stands for: a plain value for `Int`,\n/// `Bool`, `String`, and a `VData` (unfolded when read) for a structured\n/// one.\nfn from_term(mut vc: smt.Vc, ty: ast.TypeExpr, t: String) -> smt.Val {\n  match ty {\n    ast.Named { name, .. } => if smt.width_of(name) != None {\n      smt.push_fact(mut vc, smt.word_range(name, t))\n      return smt.word(mut vc, name, t)\n    },\n    _ => (),\n  }\n  match ty {\n    ast.Refined { base, .. } => smt.from_term(mut vc, base, t),\n    ast.UnitType => smt.UnitVal,\n    ast.FnType { ret, .. } => smt.VFn { ret },\n    ast.RowType(_) => smt.Opaque(\n      \"a structural type (`{ f: T, .. }`) has no values of its own\",\n    ),\n    ast.UnionType(_) => match smt.sort_of(mut vc, ty) {\n      Some(_) => smt.VData { ty, t },\n      None => smt.Opaque(\n        \"values of this union type are not modelled (members of overlapping or unknown shapes)\",\n      ),\n    },\n    ast.Named { name, args } => match smt.builtin_key(vc, name) {\n      \"Int\" => smt.vint(mut vc, t),\n      \"Real\" => smt.VReal(smt.tm(mut vc, t)),\n      \"Bool\" => smt.vbool(mut vc, t),\n      \"String\" => {\n        if !contains(vc.str_terms, t) {\n          mut vc.str_terms.push(t)\n        }\n        smt.vstr(mut vc, t)\n      },\n      \"Float\" => {\n        smt.define(mut vc, smt.float_range(t), t)\n        smt.VFloat(smt.tm(mut vc, t))\n      },\n      \"List\" => match get(args, 0) {\n        Some(a) => {\n          n := smt.bare(smt.sort_of(mut vc, ty) ?? \"\")\n          l := smt.seq_len(n, t)\n          smt.define(mut vc, f\"(>= {l} 0)\", t)\n          smt.new_list(mut vc, l, smt.GSeq(t, a, n))\n        },\n        None => smt.Opaque(\"a list of unknown elements\"),\n      },\n      \"Dict\" | \"Set\" => match smt.map_sorts(mut vc, ty) {\n        Some(ms) => smt.keyed_array(mut vc, ty, ms, t),\n        None => {\n          l := smt.fresh_why(\n            mut vc,\n            \"Int\",\n            \"dicts and sets of these types are not modelled\",\n          )\n          smt.push_fact(mut vc, f\"(>= {l} 0)\")\n          smt.keyed_list(mut vc, l, ty)\n        },\n      },\n      \"Task\" => smt.from_term(mut vc, get(args, 0) ?? ast.UnitType, t),\n      \"Tuple\" => smt.VData { ty, t },\n      _ => if contains(vc.parents, name) {\n        smt.VData { ty, t }\n      } else {\n        match get(vc.types, name) {\n          None => smt.VData { ty, t },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              ) }\n            } else {\n              smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              )\n            },\n            _ => smt.VData { ty, t },\n          },\n        }\n      },\n    },\n  }\n}","old_text":"/// The value a term of type `ty` stands for: a plain value for `Int`,\n/// `Bool`, `String`, and a `VData` (unfolded when read) for a structured\n/// one.\nfn from_term(mut vc: smt.Vc, ty: ast.TypeExpr, t: String) -> smt.Val {\n  match ty {\n    ast.Named { name, .. } => if smt.width_of(name) != None {\n      smt.push_fact(mut vc, smt.word_range(name, t))\n      return smt.word(mut vc, name, t)\n    },\n    _ => (),\n  }\n  match ty {\n    ast.Refined { base, .. } => smt.from_term(mut vc, base, t),\n    ast.UnitType => smt.UnitVal,\n    ast.FnType { ret, .. } => smt.VFn { ret },\n    ast.RowType(_) => smt.Opaque(\n      \"a structural type (`{ f: T, .. }`) has no values of its own\",\n    ),\n    ast.UnionType(_) => match smt.sort_of(mut vc, ty) {\n      Some(_) => smt.VData { ty, t },\n      None => smt.Opaque(\n        \"values of this union type are not modelled (members of overlapping or unknown shapes)\",\n      ),\n    },\n    ast.Named { name, args } => match smt.real_key(vc, name) {\n      \"Int\" => smt.vint(mut vc, t),\n      \"Real\" => smt.VReal(smt.tm(mut vc, t)),\n      \"Bool\" => smt.vbool(mut vc, t),\n      \"String\" => {\n        if !contains(vc.str_terms, t) {\n          mut vc.str_terms.push(t)\n        }\n        smt.vstr(mut vc, t)\n      },\n      \"Float\" => {\n        smt.define(mut vc, smt.float_range(t), t)\n        smt.VFloat(smt.tm(mut vc, t))\n      },\n      \"List\" => match get(args, 0) {\n        Some(a) => {\n          n := smt.bare(smt.sort_of(mut vc, ty) ?? \"\")\n          l := smt.seq_len(n, t)\n          smt.define(mut vc, f\"(>= {l} 0)\", t)\n          smt.new_list(mut vc, l, smt.GSeq(t, a, n))\n        },\n        None => smt.Opaque(\"a list of unknown elements\"),\n      },\n      \"Dict\" | \"Set\" => match smt.map_sorts(mut vc, ty) {\n        Some(ms) => smt.keyed_array(mut vc, ty, ms, t),\n        None => {\n          l := smt.fresh_why(\n            mut vc,\n            \"Int\",\n            \"dicts and sets of these types are not modelled\",\n          )\n          smt.push_fact(mut vc, f\"(>= {l} 0)\")\n          smt.keyed_list(mut vc, l, ty)\n        },\n      },\n      \"Task\" => smt.from_term(mut vc, get(args, 0) ?? ast.UnitType, t),\n      \"Tuple\" => smt.VData { ty, t },\n      _ => if contains(vc.parents, name) {\n        smt.VData { ty, t }\n      } else {\n        match get(vc.types, name) {\n          None => smt.VData { ty, t },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              ) }\n            } else {\n              smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              )\n            },\n            _ => smt.VData { ty, t },\n          },\n        }\n      },\n    },\n  }\n}"},{"name":"smt.real_key","kind":"fn","old":"7e33bffa186305e4","new":null,"interface_changed":true,"affected":[],"module":"smt","old_text":"/// A type's name as the sorts are chosen by: `$Real` (a record) for `Real`\n/// inside core.real (`real_record`).\nfn real_key(vc: smt.Vc, name: String) -> String {\n  if name == \"Real\" && smt.real_record(vc) {\n    \"$Real\"\n  } else {\n    name\n  }\n}"}],"renames":[{"from":"smt.real_key","to":"smt.builtin_key","kind":"function"}],"references":["smt.shape","smt.sort_of","smt.from_term"]}
{"id":"8b200e4c45779712","time":1795837220,"message":"edit","changes":[{"name":"smt.declarations","kind":"fn","old":"e65a0faf6cd0da75","new":"8cca557c9a3867c8","interface_changed":false,"affected":[],"module":"smt","text":"// [holes: ?conflict_1]\n/// The declarations of every sort and predicate. The datatypes are declared\n/// in groups (`datatype_groups`).\nfn declarations(vc: smt.Vc) -> String {\n  mut s := \"\"\n  for (n, d) in vc.sorts {\n    match d {\n      smt.OpaqueSort | smt.KeyedSort(_) => {\n        s += f\"(declare-sort {smt.sym(n)} 0)\\n\"\n      },\n      smt.ListSort(item) => {\n        s += if smt.list_mode() == \"seq\" && smt.seq_sorted(vc, n) {\n          f\"(define-sort {smt.sym(n)} () (Seq {item}))\\n\"\n        } else {\n          f\"(declare-sort {smt.sym(n)} 0)\\n\"\n        }\n      },\n      _ => (),\n    }\n  }\n  for g in smt.datatype_groups(vc) {\n    mut heads := []\n    mut bodies := []\n    for i in g {\n      match get(vc.sorts, i) {\n        Some((n, smt.DataSort(cs))) => {\n          mut heads.push(f\"({smt.sym(n)} 0)\")\n          mut ctors := []\n          for (c, fs) in cs {\n            mut fields := \"\"\n            for (k, f) in enumerate(fs) {\n              fields += f\" ({smt.sym(c + \".\" + f\"{k}\")} {f})\"\n            }\n            mut ctors.push(\"(\" + smt.sym(c) + fields + \")\")\n          }\n          mut bodies.push(\"(\" + join(ctors, \" \") + \")\")\n        },\n        _ => (),\n      }\n    }\n    if len(heads) > 0 {\n      s += \"(declare-datatypes (\"\n        + join(heads, \" \")\n        + \") (\"\n        + join(bodies, \" \")\n        + \"))\\n\"\n    }\n  }\n  for (n, d) in vc.sorts {\n    match d {\n      smt.DataSort(cs) => {\n        last := len(cs) - 1\n        mut e := if last < 0 {\n          \"0\"\n        } else {\n          f\"{last}\"\n        }\n        mut k := last - 1\n        while k >= 0 {\n          c := (get(cs, k) ?? (\"\", [])).0\n          e = f\"(ite ((_ is {smt.sym(c)}) x) {k} {e})\"\n          k -= 1\n        }\n        s += f\"(define-fun {smt.sym(n + \".tag\")} ((x {smt.sym(n)})) Int {e})\\n\"\n      },\n      _ => (),\n    }\n  }\n  for (n, d) in vc.sorts {\n    match d {\n      smt.ListSort(item) => if smt.list_mode() == \"seq\" && smt.seq_sorted(vc, n) {\n        s += \"(define-fun \"\n          + smt.sym(n + \".len\")\n          + \" ((s \"\n          + smt.sym(n)\n          + \")) Int (seq.len s))\\n(define-fun \"\n          + smt.sym(n + \".at\")\n          + \" ((s \"\n          + smt.sym(n)\n          + \") (i Int)) \"\n          + item\n          + \" (seq.nth s i))\\n\"\n      } else {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".len\")\n          + \" (\"\n          + smt.sym(n)\n          + \") Int)\\n(declare-fun \"\n          + smt.sym(n + \".at\")\n          + \" (\"\n          + smt.sym(n)\n          + \" Int) \"\n          + item\n          + \")\\n\"\n      },\n      smt.MapSort(arr) => {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".size\")\n          + \" (\"\n          + arr\n          + \") Int)\\n\"\n      },\n      smt.KeyedSort(arr) => {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".box\")\n          + \" (\"\n          + arr\n          + \") \"\n          + smt.sym(n)\n          + \")\\n\"\n        s += \"(declare-fun \"\n          + smt.sym(n + \".open\")\n          + \" (\"\n          + smt.sym(n)\n          + \") \"\n          + arr\n          + \")\\n\"\n      },\n      _ => (),\n    }\n  }\n  for (v, sort) in vc.valid {\n    s += f\"(declare-fun {v} ({sort}) Bool)\\n\"\n  }\n  for (r, (args, ret)) in items(vc.rec_fns) {\n    s += \"(declare-fun \"\n      + smt.sym(r)\n      + \" (\"\n      + join(args, \" \")\n      + \") \"\n      + ret\n      + \")\\n\"\n  }\n  for (f, a, r) in vc.of_receiver {\n    s += f\"(declare-fun {f} ({a}) {r})\\n\"\n  }\n  for (f, a) in vc.orders {\n    s += f\"(declare-fun {f} ({a} {a}) Int)\\n\"\n  }\n  s\n}","old_text":"/// The declarations of every sort and predicate. The datatypes are declared\n/// in groups (`datatype_groups`).\nfn declarations(vc: smt.Vc) -> String {\n  mut s := \"\"\n  ?conflict_1({\n    mut heads := []\n    mut bodies := []\n    for (n, d) in vc.sorts {\n      match d {\n        smt.OpaqueSort => {\n          s += f\"(declare-sort {smt.sym(n)} 0)\\n\"\n        },\n        smt.ListSort(item) => {\n          s += if smt.list_mode() == \"seq\" && smt.seq_sorted(vc, n) {\n            f\"(define-sort {smt.sym(n)} () (Seq {item}))\\n\"\n          } else {\n            f\"(declare-sort {smt.sym(n)} 0)\\n\"\n          }\n        },\n        smt.MapSort(_) => (),\n        smt.DataSort(cs) => {\n          mut heads.push(f\"({smt.sym(n)} 0)\")\n          mut ctors := []\n          for (c, fs) in cs {\n            mut fields := \"\"\n            for (k, f) in enumerate(fs) {\n              fields += f\" ({smt.sym(c + \".\" + f\"{k}\")} {f})\"\n            }\n            mut ctors.push(\"(\" + smt.sym(c) + fields + \")\")\n          }\n          mut bodies.push(\"(\" + join(ctors, \" \") + \")\")\n        },\n      }\n    }\n    if len(heads) > 0 {\n      s += \"(declare-datatypes (\"\n        + join(heads, \" \")\n        + \") (\"\n        + join(bodies, \" \")\n        + \"))\\n\"\n    }\n  }, {\n    mut heads := []\n    mut bodies := []\n    for (n, d) in vc.sorts {\n      match d {\n        smt.OpaqueSort | smt.ListSort(_) => {\n          s += f\"(declare-sort {smt.sym(n)} 0)\\n\"\n        },\n        smt.MapSort(_) => (),\n        smt.DataSort(cs) => {\n          mut heads.push(f\"({smt.sym(n)} 0)\")\n          mut ctors := []\n          for (c, fs) in cs {\n            mut fields := \"\"\n            for (k, f) in enumerate(fs) {\n              fields += f\" ({smt.sym(c + \".\" + f\"{k}\")} {f})\"\n            }\n            mut ctors.push(\"(\" + smt.sym(c) + fields + \")\")\n          }\n          mut bodies.push(\"(\" + join(ctors, \" \") + \")\")\n        },\n      }\n    }\n    if len(heads) > 0 {\n      s += \"(declare-datatypes (\"\n        + join(heads, \" \")\n        + \") (\"\n        + join(bodies, \" \")\n        + \"))\\n\"\n    }\n  }, {\n    for (n, d) in vc.sorts {\n      match d {\n        smt.OpaqueSort | smt.ListSort(_) | smt.KeyedSort(_) => {\n          s += f\"(declare-sort {smt.sym(n)} 0)\\n\"\n        },\n        _ => (),\n      }\n    }\n    for g in smt.datatype_groups(vc) {\n      mut heads := []\n      mut bodies := []\n      for i in g {\n        match get(vc.sorts, i) {\n          Some((n, smt.DataSort(cs))) => {\n            mut heads.push(f\"({smt.sym(n)} 0)\")\n            mut ctors := []\n            for (c, fs) in cs {\n              mut fields := \"\"\n              for (k, f) in enumerate(fs) {\n                fields += f\" ({smt.sym(c + \".\" + f\"{k}\")} {f})\"\n              }\n              mut ctors.push(\"(\" + smt.sym(c) + fields + \")\")\n            }\n            mut bodies.push(\"(\" + join(ctors, \" \") + \")\")\n          },\n          _ => (),\n        }\n      }\n      if len(heads) > 0 {\n        s += \"(declare-datatypes (\"\n          + join(heads, \" \")\n          + \") (\"\n          + join(bodies, \" \")\n          + \"))\\n\"\n      }\n    }\n  })\n  for (n, d) in vc.sorts {\n    match d {\n      smt.DataSort(cs) => {\n        last := len(cs) - 1\n        mut e := if last < 0 {\n          \"0\"\n        } else {\n          f\"{last}\"\n        }\n        mut k := last - 1\n        while k >= 0 {\n          c := (get(cs, k) ?? (\"\", [])).0\n          e = f\"(ite ((_ is {smt.sym(c)}) x) {k} {e})\"\n          k -= 1\n        }\n        s += f\"(define-fun {smt.sym(n + \".tag\")} ((x {smt.sym(n)})) Int {e})\\n\"\n      },\n      _ => (),\n    }\n  }\n  for (n, d) in vc.sorts {\n    match d {\n      smt.ListSort(item) => if smt.list_mode() == \"seq\" && smt.seq_sorted(vc, n) {\n        s += \"(define-fun \"\n          + smt.sym(n + \".len\")\n          + \" ((s \"\n          + smt.sym(n)\n          + \")) Int (seq.len s))\\n(define-fun \"\n          + smt.sym(n + \".at\")\n          + \" ((s \"\n          + smt.sym(n)\n          + \") (i Int)) \"\n          + item\n          + \" (seq.nth s i))\\n\"\n      } else {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".len\")\n          + \" (\"\n          + smt.sym(n)\n          + \") Int)\\n(declare-fun \"\n          + smt.sym(n + \".at\")\n          + \" (\"\n          + smt.sym(n)\n          + \" Int) \"\n          + item\n          + \")\\n\"\n      },\n      smt.MapSort(arr) => {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".size\")\n          + \" (\"\n          + arr\n          + \") Int)\\n\"\n      },\n      smt.KeyedSort(arr) => {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".box\")\n          + \" (\"\n          + arr\n          + \") \"\n          + smt.sym(n)\n          + \")\\n\"\n        s += \"(declare-fun \"\n          + smt.sym(n + \".open\")\n          + \" (\"\n          + smt.sym(n)\n          + \") \"\n          + arr\n          + \")\\n\"\n      },\n      _ => (),\n    }\n  }\n  for (v, sort) in vc.valid {\n    s += f\"(declare-fun {v} ({sort}) Bool)\\n\"\n  }\n  for (r, (args, ret)) in items(vc.rec_fns) {\n    s += \"(declare-fun \"\n      + smt.sym(r)\n      + \" (\"\n      + join(args, \" \")\n      + \") \"\n      + ret\n      + \")\\n\"\n  }\n  for (f, a, r) in vc.of_receiver {\n    s += f\"(declare-fun {f} ({a}) {r})\\n\"\n  }\n  for (f, a) in vc.orders {\n    s += f\"(declare-fun {f} ({a} {a}) Int)\\n\"\n  }\n  s\n}"}]}
{"id":"be1d242358ebc617","time":1795837282,"message":"edit","changes":[{"name":"smt.declarations","kind":"fn","old":"8cca557c9a3867c8","new":"441e03b139d9886e","interface_changed":false,"affected":[],"module":"smt","text":"/// The declarations of every sort and predicate. The datatypes are declared\n/// in groups (`datatype_groups`).\nfn declarations(vc: smt.Vc) -> String {\n  mut s := \"\"\n  for (n, d) in vc.sorts {\n    match d {\n      smt.OpaqueSort | smt.KeyedSort(_) => {\n        s += f\"(declare-sort {smt.sym(n)} 0)\\n\"\n      },\n      smt.ListSort(item) => {\n        s += if smt.list_mode() == \"seq\" && smt.seq_sorted(vc, n) {\n          f\"(define-sort {smt.sym(n)} () (Seq {item}))\\n\"\n        } else {\n          f\"(declare-sort {smt.sym(n)} 0)\\n\"\n        }\n      },\n      _ => (),\n    }\n  }\n  for g in smt.datatype_groups(vc) {\n    mut heads := []\n    mut bodies := []\n    for i in g {\n      match get(vc.sorts, i) {\n        Some((n, smt.DataSort(cs))) => {\n          mut heads.push(f\"({smt.sym(n)} 0)\")\n          mut ctors := []\n          for (c, fs) in cs {\n            mut fields := \"\"\n            for (k, f) in enumerate(fs) {\n              fields += f\" ({smt.sym(c + \".\" + f\"{k}\")} {f})\"\n            }\n            mut ctors.push(\"(\" + smt.sym(c) + fields + \")\")\n          }\n          mut bodies.push(\"(\" + join(ctors, \" \") + \")\")\n        },\n        _ => (),\n      }\n    }\n    if len(heads) > 0 {\n      s += \"(declare-datatypes (\"\n        + join(heads, \" \")\n        + \") (\"\n        + join(bodies, \" \")\n        + \"))\\n\"\n    }\n  }\n  for (n, d) in vc.sorts {\n    match d {\n      smt.DataSort(cs) => {\n        last := len(cs) - 1\n        mut e := if last < 0 {\n          \"0\"\n        } else {\n          f\"{last}\"\n        }\n        mut k := last - 1\n        while k >= 0 {\n          c := (get(cs, k) ?? (\"\", [])).0\n          e = f\"(ite ((_ is {smt.sym(c)}) x) {k} {e})\"\n          k -= 1\n        }\n        s += f\"(define-fun {smt.sym(n + \".tag\")} ((x {smt.sym(n)})) Int {e})\\n\"\n      },\n      _ => (),\n    }\n  }\n  for (n, d) in vc.sorts {\n    match d {\n      smt.ListSort(item) => if smt.list_mode() == \"seq\" && smt.seq_sorted(vc, n) {\n        s += \"(define-fun \"\n          + smt.sym(n + \".len\")\n          + \" ((s \"\n          + smt.sym(n)\n          + \")) Int (seq.len s))\\n(define-fun \"\n          + smt.sym(n + \".at\")\n          + \" ((s \"\n          + smt.sym(n)\n          + \") (i Int)) \"\n          + item\n          + \" (seq.nth s i))\\n\"\n      } else {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".len\")\n          + \" (\"\n          + smt.sym(n)\n          + \") Int)\\n(declare-fun \"\n          + smt.sym(n + \".at\")\n          + \" (\"\n          + smt.sym(n)\n          + \" Int) \"\n          + item\n          + \")\\n\"\n      },\n      smt.MapSort(arr) => {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".size\")\n          + \" (\"\n          + arr\n          + \") Int)\\n\"\n      },\n      smt.KeyedSort(arr) => {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".box\")\n          + \" (\"\n          + arr\n          + \") \"\n          + smt.sym(n)\n          + \")\\n\"\n        s += \"(declare-fun \"\n          + smt.sym(n + \".open\")\n          + \" (\"\n          + smt.sym(n)\n          + \") \"\n          + arr\n          + \")\\n\"\n      },\n      _ => (),\n    }\n  }\n  for (v, sort) in vc.valid {\n    s += f\"(declare-fun {v} ({sort}) Bool)\\n\"\n  }\n  for (r, (args, ret)) in items(vc.rec_fns) {\n    s += \"(declare-fun \"\n      + smt.sym(r)\n      + \" (\"\n      + join(args, \" \")\n      + \") \"\n      + ret\n      + \")\\n\"\n  }\n  for (f, a, r) in vc.of_receiver {\n    s += f\"(declare-fun {f} ({a}) {r})\\n\"\n  }\n  for (f, a) in vc.orders {\n    s += f\"(declare-fun {f} ({a} {a}) Int)\\n\"\n  }\n  s\n}","old_text":"// [holes: ?conflict_1]\n/// The declarations of every sort and predicate. The datatypes are declared\n/// in groups (`datatype_groups`).\nfn declarations(vc: smt.Vc) -> String {\n  mut s := \"\"\n  for (n, d) in vc.sorts {\n    match d {\n      smt.OpaqueSort | smt.KeyedSort(_) => {\n        s += f\"(declare-sort {smt.sym(n)} 0)\\n\"\n      },\n      smt.ListSort(item) => {\n        s += if smt.list_mode() == \"seq\" && smt.seq_sorted(vc, n) {\n          f\"(define-sort {smt.sym(n)} () (Seq {item}))\\n\"\n        } else {\n          f\"(declare-sort {smt.sym(n)} 0)\\n\"\n        }\n      },\n      _ => (),\n    }\n  }\n  for g in smt.datatype_groups(vc) {\n    mut heads := []\n    mut bodies := []\n    for i in g {\n      match get(vc.sorts, i) {\n        Some((n, smt.DataSort(cs))) => {\n          mut heads.push(f\"({smt.sym(n)} 0)\")\n          mut ctors := []\n          for (c, fs) in cs {\n            mut fields := \"\"\n            for (k, f) in enumerate(fs) {\n              fields += f\" ({smt.sym(c + \".\" + f\"{k}\")} {f})\"\n            }\n            mut ctors.push(\"(\" + smt.sym(c) + fields + \")\")\n          }\n          mut bodies.push(\"(\" + join(ctors, \" \") + \")\")\n        },\n        _ => (),\n      }\n    }\n    if len(heads) > 0 {\n      s += \"(declare-datatypes (\"\n        + join(heads, \" \")\n        + \") (\"\n        + join(bodies, \" \")\n        + \"))\\n\"\n    }\n  }\n  for (n, d) in vc.sorts {\n    match d {\n      smt.DataSort(cs) => {\n        last := len(cs) - 1\n        mut e := if last < 0 {\n          \"0\"\n        } else {\n          f\"{last}\"\n        }\n        mut k := last - 1\n        while k >= 0 {\n          c := (get(cs, k) ?? (\"\", [])).0\n          e = f\"(ite ((_ is {smt.sym(c)}) x) {k} {e})\"\n          k -= 1\n        }\n        s += f\"(define-fun {smt.sym(n + \".tag\")} ((x {smt.sym(n)})) Int {e})\\n\"\n      },\n      _ => (),\n    }\n  }\n  for (n, d) in vc.sorts {\n    match d {\n      smt.ListSort(item) => if smt.list_mode() == \"seq\" && smt.seq_sorted(vc, n) {\n        s += \"(define-fun \"\n          + smt.sym(n + \".len\")\n          + \" ((s \"\n          + smt.sym(n)\n          + \")) Int (seq.len s))\\n(define-fun \"\n          + smt.sym(n + \".at\")\n          + \" ((s \"\n          + smt.sym(n)\n          + \") (i Int)) \"\n          + item\n          + \" (seq.nth s i))\\n\"\n      } else {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".len\")\n          + \" (\"\n          + smt.sym(n)\n          + \") Int)\\n(declare-fun \"\n          + smt.sym(n + \".at\")\n          + \" (\"\n          + smt.sym(n)\n          + \" Int) \"\n          + item\n          + \")\\n\"\n      },\n      smt.MapSort(arr) => {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".size\")\n          + \" (\"\n          + arr\n          + \") Int)\\n\"\n      },\n      smt.KeyedSort(arr) => {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".box\")\n          + \" (\"\n          + arr\n          + \") \"\n          + smt.sym(n)\n          + \")\\n\"\n        s += \"(declare-fun \"\n          + smt.sym(n + \".open\")\n          + \" (\"\n          + smt.sym(n)\n          + \") \"\n          + arr\n          + \")\\n\"\n      },\n      _ => (),\n    }\n  }\n  for (v, sort) in vc.valid {\n    s += f\"(declare-fun {v} ({sort}) Bool)\\n\"\n  }\n  for (r, (args, ret)) in items(vc.rec_fns) {\n    s += \"(declare-fun \"\n      + smt.sym(r)\n      + \" (\"\n      + join(args, \" \")\n      + \") \"\n      + ret\n      + \")\\n\"\n  }\n  for (f, a, r) in vc.of_receiver {\n    s += f\"(declare-fun {f} ({a}) {r})\\n\"\n  }\n  for (f, a) in vc.orders {\n    s += f\"(declare-fun {f} ({a} {a}) Int)\\n\"\n  }\n  s\n}"}]}
{"id":"d6123759f62fe284","time":1795837368,"message":"edit","changes":[{"name":"smt.simple_symbol","kind":"fn","old":"1aa2260747ee027a","new":"7836e7d08aff359a","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether `a` reads as itself unquoted: a string literal, a numeral, a\n/// `#b`/`#x` literal, a keyword, or letters, digits and SMT-LIB's symbol\n/// characters not starting with a digit.\nfn simple_symbol(a: String) -> Bool {\n  n := byte_len(a)\n  if n == 0 {\n    return false\n  }\n  first := byte_at(a, 0)\n  if first == 34 {\n    return true\n  }\n  digits := first >= 48 && first <= 57\n  for i in 0..n {\n    b := byte_at(a, i)\n    ok := if digits {\n      b >= 48 && b <= 57 || b == 46\n    } else {\n      b >= 48 && b <= 57\n        || b >= 65 && b <= 90\n        || b >= 97 && b <= 122\n        || contains(\"~!@$%^&*_-+=<>.?/\", chr(b))\n        || (b == 58 || b == 35) && i == 0\n    }\n    if !ok {\n      return false\n    }\n  }\n  true\n}","old_text":"/// Whether `a` reads as itself unquoted: a string literal, or letters,\n/// digits and SMT-LIB's symbol characters (a `:` only first).\nfn simple_symbol(a: String) -> Bool {\n  n := byte_len(a)\n  if n == 0 {\n    return false\n  }\n  if byte_at(a, 0) == 34 {\n    return true\n  }\n  for i in 0..n {\n    b := byte_at(a, i)\n    ok := b >= 48 && b <= 57\n      || b >= 65 && b <= 90\n      || b >= 97 && b <= 122\n      || contains(\"~!@$%^&*_-+=<>.?/#\", chr(b))\n      || b == 58 && i == 0\n    if !ok {\n      return false\n    }\n  }\n  true\n}"}]}
{"id":"b6e61bd51c89cc09","time":1795840194,"message":"edit","changes":[{"name":"smt.own_parts","kind":"fn","old":"30c18d8430dbdc03","new":"5bdad9f91dd72ea1","interface_changed":false,"affected":[],"module":"smt","text":"/// The checks inside the refinements nested in `t` (in its type arguments,\n/// fields, payloads and union members, at any depth) as obligations, each\n/// on any value of its type. `extra`: what an inline refinement sees besides\n/// `it`; `seen`: the types already done.\nfn own_parts(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  extra: List[(String, smt.Val)],\n  mut seen: Set[String],\n  depth: Int,\n) {\n  for c in smt.type_parts(vc, t) {\n    key := text.type_text(c)\n    if !contains(seen, key) && smt.refined(vc, c) {\n      mut seen.insert(key)\n      if depth >= 8 {\n        if smt.start_goal(mut vc) {\n          g := smt.unknown_bool(\n            mut vc,\n            \"a refinement nested more than 8 types deep\",\n          )\n          smt.oblige(mut vc, f\"the checks inside `{key}`\", g)\n        }\n      } else {\n        nf := len(vc.facts)\n        n_ob := len(vc.obligations)\n        n_term := len(vc.term_obs)\n        v := smt.shape(mut vc, c)\n        smt.own_refinements(mut vc, c, v, extra)\n        smt.own_parts(mut vc, c, extra, mut seen, depth + 1)\n        // the value's facts are the new obligations' own, not the function's\n        facts := vc.facts\n        vc.obligations = take(vc.obligations, n_ob)\n          + drop(vc.obligations, n_ob).map(\n            ob -> smt.kept_facts(facts, ob, nf),\n          )\n        vc.term_obs = take(vc.term_obs, n_term)\n          + drop(vc.term_obs, n_term).map(\n            ob -> smt.kept_facts(facts, ob, nf),\n          )\n        vc.facts = take(vc.facts, nf)\n      }\n    }\n  }\n}","old_text":"/// The checks inside the refinements nested in `t` (in its type arguments,\n/// fields, payloads and union members, at any depth) as obligations, each\n/// on any value of its type. `extra`: what an inline refinement sees besides\n/// `it`; `seen`: the types already done.\nfn own_parts(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  extra: List[(String, smt.Val)],\n  mut seen: Set[String],\n  depth: Int,\n) {\n  for c in smt.type_parts(vc, t) {\n    key := text.type_text(c)\n    if !contains(seen, key) && smt.refined(vc, c) {\n      mut seen.insert(key)\n      if depth >= 8 {\n        if smt.start_goal(mut vc) {\n          g := smt.unknown_bool(\n            mut vc,\n            \"a refinement nested more than 8 types deep\",\n          )\n          smt.oblige(mut vc, f\"the checks inside `{key}`\", g)\n        }\n      } else {\n        v := smt.shape(mut vc, c)\n        smt.own_refinements(mut vc, c, v, extra)\n        smt.own_parts(mut vc, c, extra, mut seen, depth + 1)\n      }\n    }\n  }\n}"}]}
{"id":"14047422ed92857c","time":1795840233,"message":"edit","changes":[{"name":"smt.own_parts","kind":"fn","old":"5bdad9f91dd72ea1","new":"2d6f1f341eb94903","interface_changed":false,"affected":[],"module":"smt","text":"/// The checks inside the refinements nested in `t` (in its type arguments,\n/// fields, payloads and union members, at any depth) as obligations, each\n/// on any value of its type. `extra`: what an inline refinement sees besides\n/// `it`; `seen`: the types already done.\nfn own_parts(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  extra: List[(String, smt.Val)],\n  mut seen: Set[String],\n  depth: Int,\n) {\n  for c in smt.type_parts(vc, t) {\n    key := text.type_text(c)\n    if !contains(seen, key) && smt.refined(vc, c) {\n      mut seen.insert(key)\n      if depth >= 8 {\n        if smt.start_goal(mut vc) {\n          g := smt.unknown_bool(\n            mut vc,\n            \"a refinement nested more than 8 types deep\",\n          )\n          smt.oblige(mut vc, f\"the checks inside `{key}`\", g)\n        }\n      } else {\n        nf := len(vc.facts)\n        n_ob := len(vc.obligations)\n        n_term := len(vc.term_obs)\n        v := smt.shape(mut vc, c)\n        smt.own_refinements(mut vc, c, v, extra)\n        smt.own_parts(mut vc, c, extra, mut seen, depth + 1)\n        facts := vc.facts\n        vc.obligations = take(vc.obligations, n_ob)\n          + drop(vc.obligations, n_ob).map(\n            ob -> smt.kept_facts(facts, ob, nf),\n          )\n        vc.term_obs = take(vc.term_obs, n_term)\n          + drop(vc.term_obs, n_term).map(\n            ob -> smt.kept_facts(facts, ob, nf),\n          )\n        vc.facts = take(vc.facts, nf)\n      }\n    }\n  }\n}","old_text":"/// The checks inside the refinements nested in `t` (in its type arguments,\n/// fields, payloads and union members, at any depth) as obligations, each\n/// on any value of its type. `extra`: what an inline refinement sees besides\n/// `it`; `seen`: the types already done.\nfn own_parts(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  extra: List[(String, smt.Val)],\n  mut seen: Set[String],\n  depth: Int,\n) {\n  for c in smt.type_parts(vc, t) {\n    key := text.type_text(c)\n    if !contains(seen, key) && smt.refined(vc, c) {\n      mut seen.insert(key)\n      if depth >= 8 {\n        if smt.start_goal(mut vc) {\n          g := smt.unknown_bool(\n            mut vc,\n            \"a refinement nested more than 8 types deep\",\n          )\n          smt.oblige(mut vc, f\"the checks inside `{key}`\", g)\n        }\n      } else {\n        nf := len(vc.facts)\n        n_ob := len(vc.obligations)\n        n_term := len(vc.term_obs)\n        v := smt.shape(mut vc, c)\n        smt.own_refinements(mut vc, c, v, extra)\n        smt.own_parts(mut vc, c, extra, mut seen, depth + 1)\n        // the value's facts are the new obligations' own, not the function's\n        facts := vc.facts\n        vc.obligations = take(vc.obligations, n_ob)\n          + drop(vc.obligations, n_ob).map(\n            ob -> smt.kept_facts(facts, ob, nf),\n          )\n        vc.term_obs = take(vc.term_obs, n_term)\n          + drop(vc.term_obs, n_term).map(\n            ob -> smt.kept_facts(facts, ob, nf),\n          )\n        vc.facts = take(vc.facts, nf)\n      }\n    }\n  }\n}"}]}
{"id":"54107fdfa2c555b0","time":1795840385,"message":"edit","changes":[{"name":"smt.function","kind":"fn","old":"d0c0752599781ad0","new":"8b0c9b8412008657","interface_changed":false,"affected":[],"module":"smt","text":"/// Runs `f` symbolically, collecting its obligations and what it uses that\n/// smt doesn't model (`gaps`).\npub fn function(mut vc: smt.Vc, f: ast.FnDecl, label: String) {\n  vc.self_name = label\n  vc.own_name = f.name\n  smt.rows_as_records(mut vc, f)\n  // a lemma, or a law (its wrapper, `strata_verify_K_law_NAME`), is a\n  // proof: spec functions are seen through (`in_proof`)\n  if f.lemma\n    || contains(label, \"strata_verify_\") && contains(label, \"_law_\") {\n    vc.proof_from = 0\n  }\n  vc.own_whiles = smt.while_loops(f.body)\n  for p in f.params {\n    v := smt.shape(mut vc, p.ty)\n    smt.own_refinements(mut vc, p.ty, v, [])\n    smt.assume(mut vc, smt.check_type(mut vc, p.ty, v, []))\n    if p.mutable {\n      smt.declare(mut vc, p.name, Some(p.ty))\n      mut vc.mut_params.push(p.name)\n    }\n    mut vc.params.push((p.name, v))\n    smt.bind(mut vc, p.name, v)\n  }\n  // the lists' first elements, for a counterexample to show (their facts\n  // set aside): one level of nested lists, bounded in terms\n  if vc.examples {\n    nf := len(vc.facts)\n    mut lens := []\n    mut ls := []\n    vc.input_depth = 1\n    for (_, v) in vc.params {\n      smt.open_input(mut vc, v, 0, mut lens, mut ls)\n    }\n    vc.input_depth = 3\n    vc.example_facts = drop(vc.facts, nf)\n    vc.facts = take(vc.facts, nf)\n    vc.example_leaves = ls\n  }\n  binds := vc.params\n  entry_pc := vc.pc\n  for r in f.pre {\n    c := smt.own_pred(mut vc, r, binds, None)\n    smt.push_pc(mut vc, c)\n  }\n  for m in text.decreases_of(f.body) {\n    _ := smt.own_val(mut vc, m, binds, None)\n  }\n  // what a loop may need to keep: the `ensures` of the returned variable,\n  // and those of a `mut` parameter that don't name the result\n  match f.body {\n    ast.Block { last: ast.Var(x), .. } => {\n      vc.hints = f.post.map(e -> (e, x))\n      vc.returned = Some((x, f.ret))\n    },\n    _ => (),\n  }\n  for p in f.params {\n    if p.mutable {\n      for e in f.post {\n        names := smt.var_names(e)\n        if contains(names, p.name)\n          && !contains(names, \"it\")\n          && !vc.hints.any(h -> h.0 == e && h.1 == p.name) {\n          mut vc.hints.push((e, p.name))\n        }\n      }\n    }\n  }\n  vc.result_text = match f.body {\n    ast.Block { last, .. } => text.expr_text(last, 0),\n    other => text.expr_text(other, 0),\n  }\n  vc.requires_hints = f.pre\n  res := smt.eval(mut vc, f.body)\n  // the result is checked where the body ends and at every early return\n  mut exits := []\n  if !vc.dead {\n    mut exits.push((vc.pc, res, \"\", smt.mut_state(vc)))\n  }\n  for x in vc.returns {\n    mut exits.push((x.pc, x.value, \" (early return)\", x.state))\n  }\n  vc.returns = []\n  shown := smt.shown_name(label)\n  for (pc, value, how, state) in exits {\n    vc.pc = pc\n    vc.dead = false\n    // the `ensures` name the `mut` parameters as they are at this exit,\n    // `old x` as they were on entry\n    after := smt.rebound(binds, state)\n    if smt.refined(vc, f.ret) {\n      smt.own_refinements(mut vc, f.ret, value, binds)\n      if smt.start_goal(mut vc) {\n        g := smt.check_type(mut vc, f.ret, value, binds)\n        smt.oblige(\n          mut vc,\n          f\"result of `{shown}`{how}: {text.type_text(f.ret)}\",\n          g,\n        )\n      }\n    }\n    for en in f.post {\n      n := len(vc.pc)\n      // (evaluated as a goal, though its own checks are made first)\n      vc.proving += 1\n      g := smt.own_pred(mut vc, en, after + [(\"it\", value)], Some(binds))\n      vc.proving -= 1\n      if smt.start_goal(mut vc) {\n        smt.oblige(\n          mut vc,\n          f\"ensures {text.expr_text(en, 0)}{how}\",\n          g,\n        )\n      }\n      vc.pc = take(vc.pc, n)\n    }\n  }\n  vc.pc = entry_pc\n  vc.dead = false\n  mut parts := Set[String] {}\n  for p in f.params {\n    smt.own_parts(mut vc, p.ty, [], mut parts, 0)\n  }\n  smt.own_parts(mut vc, f.ret, binds, mut parts, 0)\n}","old_text":"/// Runs `f` symbolically, collecting its obligations and what it uses that\n/// smt doesn't model (`gaps`).\npub fn function(mut vc: smt.Vc, f: ast.FnDecl, label: String) {\n  vc.self_name = label\n  vc.own_name = f.name\n  smt.rows_as_records(mut vc, f)\n  // a lemma, or a law (its wrapper, `strata_verify_K_law_NAME`), is a\n  // proof: spec functions are seen through (`in_proof`)\n  if f.lemma\n    || contains(label, \"strata_verify_\") && contains(label, \"_law_\") {\n    vc.proof_from = 0\n  }\n  vc.own_whiles = smt.while_loops(f.body)\n  for p in f.params {\n    v := smt.shape(mut vc, p.ty)\n    smt.own_refinements(mut vc, p.ty, v, [])\n    smt.assume(mut vc, smt.check_type(mut vc, p.ty, v, []))\n    if p.mutable {\n      smt.declare(mut vc, p.name, Some(p.ty))\n      mut vc.mut_params.push(p.name)\n    }\n    mut vc.params.push((p.name, v))\n    smt.bind(mut vc, p.name, v)\n  }\n  // the lists' first elements, for a counterexample to show (their facts\n  // set aside): one level of nested lists, bounded in terms\n  if vc.examples {\n    nf := len(vc.facts)\n    mut lens := []\n    mut ls := []\n    vc.input_depth = 1\n    for (_, v) in vc.params {\n      smt.open_input(mut vc, v, 0, mut lens, mut ls)\n    }\n    vc.input_depth = 3\n    vc.example_facts = drop(vc.facts, nf)\n    vc.facts = take(vc.facts, nf)\n    vc.example_leaves = ls\n  }\n  binds := vc.params\n  mut parts := Set[String] {}\n  for p in f.params {\n    smt.own_parts(mut vc, p.ty, [], mut parts, 0)\n  }\n  smt.own_parts(mut vc, f.ret, binds, mut parts, 0)\n  for r in f.pre {\n    c := smt.own_pred(mut vc, r, binds, None)\n    smt.push_pc(mut vc, c)\n  }\n  for m in text.decreases_of(f.body) {\n    _ := smt.own_val(mut vc, m, binds, None)\n  }\n  // what a loop may need to keep: the `ensures` of the returned variable,\n  // and those of a `mut` parameter that don't name the result\n  match f.body {\n    ast.Block { last: ast.Var(x), .. } => {\n      vc.hints = f.post.map(e -> (e, x))\n      vc.returned = Some((x, f.ret))\n    },\n    _ => (),\n  }\n  for p in f.params {\n    if p.mutable {\n      for e in f.post {\n        names := smt.var_names(e)\n        if contains(names, p.name)\n          && !contains(names, \"it\")\n          && !vc.hints.any(h -> h.0 == e && h.1 == p.name) {\n          mut vc.hints.push((e, p.name))\n        }\n      }\n    }\n  }\n  vc.result_text = match f.body {\n    ast.Block { last, .. } => text.expr_text(last, 0),\n    other => text.expr_text(other, 0),\n  }\n  vc.requires_hints = f.pre\n  res := smt.eval(mut vc, f.body)\n  // the result is checked where the body ends and at every early return\n  mut exits := []\n  if !vc.dead {\n    mut exits.push((vc.pc, res, \"\", smt.mut_state(vc)))\n  }\n  for x in vc.returns {\n    mut exits.push((x.pc, x.value, \" (early return)\", x.state))\n  }\n  vc.returns = []\n  shown := smt.shown_name(label)\n  for (pc, value, how, state) in exits {\n    vc.pc = pc\n    vc.dead = false\n    // the `ensures` name the `mut` parameters as they are at this exit,\n    // `old x` as they were on entry\n    after := smt.rebound(binds, state)\n    if smt.refined(vc, f.ret) {\n      smt.own_refinements(mut vc, f.ret, value, binds)\n      if smt.start_goal(mut vc) {\n        g := smt.check_type(mut vc, f.ret, value, binds)\n        smt.oblige(\n          mut vc,\n          f\"result of `{shown}`{how}: {text.type_text(f.ret)}\",\n          g,\n        )\n      }\n    }\n    for en in f.post {\n      n := len(vc.pc)\n      // (evaluated as a goal, though its own checks are made first)\n      vc.proving += 1\n      g := smt.own_pred(mut vc, en, after + [(\"it\", value)], Some(binds))\n      vc.proving -= 1\n      if smt.start_goal(mut vc) {\n        smt.oblige(\n          mut vc,\n          f\"ensures {text.expr_text(en, 0)}{how}\",\n          g,\n        )\n      }\n      vc.pc = take(vc.pc, n)\n    }\n  }\n}"}]}
{"id":"146ceecb544db352","time":1795840550,"message":"edit","changes":[{"name":"smt.own_parts","kind":"fn","old":"2d6f1f341eb94903","new":"102031a3529cc3f2","interface_changed":false,"affected":[],"module":"smt","text":"/// The checks inside the refinements nested in `t` (in its type arguments,\n/// fields, payloads and union members, at any depth) as obligations, each\n/// on any value of its type. `extra`: what an inline refinement sees besides\n/// `it`; `seen`: the types already done.\nfn own_parts(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  extra: List[(String, smt.Val)],\n  mut seen: Set[String],\n  depth: Int,\n) {\n  for c in smt.type_parts(vc, t) {\n    key := text.type_text(c)\n    if !contains(seen, key) && smt.refined(vc, c) {\n      mut seen.insert(key)\n      if depth >= 8 {\n        if smt.start_goal(mut vc) {\n          g := smt.unknown_bool(\n            mut vc,\n            \"a refinement nested more than 8 types deep\",\n          )\n          smt.oblige(mut vc, f\"the checks inside `{key}`\", g)\n        }\n      } else {\n        nf := len(vc.facts)\n        memo := vc.memo\n        n_ob := len(vc.obligations)\n        n_term := len(vc.term_obs)\n        v := smt.shape(mut vc, c)\n        smt.own_refinements(mut vc, c, v, extra)\n        smt.own_parts(mut vc, c, extra, mut seen, depth + 1)\n        facts := vc.facts\n        vc.obligations = take(vc.obligations, n_ob)\n          + drop(vc.obligations, n_ob).map(\n            ob -> smt.kept_facts(facts, ob, nf),\n          )\n        vc.term_obs = take(vc.term_obs, n_term)\n          + drop(vc.term_obs, n_term).map(\n            ob -> smt.kept_facts(facts, ob, nf),\n          )\n        vc.facts = take(vc.facts, nf)\n        vc.memo = memo\n      }\n    }\n  }\n}","old_text":"/// The checks inside the refinements nested in `t` (in its type arguments,\n/// fields, payloads and union members, at any depth) as obligations, each\n/// on any value of its type. `extra`: what an inline refinement sees besides\n/// `it`; `seen`: the types already done.\nfn own_parts(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  extra: List[(String, smt.Val)],\n  mut seen: Set[String],\n  depth: Int,\n) {\n  for c in smt.type_parts(vc, t) {\n    key := text.type_text(c)\n    if !contains(seen, key) && smt.refined(vc, c) {\n      mut seen.insert(key)\n      if depth >= 8 {\n        if smt.start_goal(mut vc) {\n          g := smt.unknown_bool(\n            mut vc,\n            \"a refinement nested more than 8 types deep\",\n          )\n          smt.oblige(mut vc, f\"the checks inside `{key}`\", g)\n        }\n      } else {\n        nf := len(vc.facts)\n        n_ob := len(vc.obligations)\n        n_term := len(vc.term_obs)\n        v := smt.shape(mut vc, c)\n        smt.own_refinements(mut vc, c, v, extra)\n        smt.own_parts(mut vc, c, extra, mut seen, depth + 1)\n        facts := vc.facts\n        vc.obligations = take(vc.obligations, n_ob)\n          + drop(vc.obligations, n_ob).map(\n            ob -> smt.kept_facts(facts, ob, nf),\n          )\n        vc.term_obs = take(vc.term_obs, n_term)\n          + drop(vc.term_obs, n_term).map(\n            ob -> smt.kept_facts(facts, ob, nf),\n          )\n        vc.facts = take(vc.facts, nf)\n      }\n    }\n  }\n}"}]}
{"id":"49c5a32d1b967aab","time":1795841613,"message":"edit","changes":[{"name":"edit_command","kind":"fn","old":"b0d1da14ed95ebfd","new":"76dcf1c298356866","interface_changed":false,"affected":[],"module":"","text":"/// `strata edit [MODULE] [-m MSG] [--rm NAME].. [--no-commit] [--no-search]`\n/// and `strata\n/// add FILE [MODULE]`: definitions from standard input (or the file, or the\n/// editor) replace or join the package's of the same names in MODULE\n/// (default the root module). Recorded only if the whole package checks.\nfn edit_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  args: List[String],\n  cmd: String,\n) -> std.process.ExitCode {\n  if contains(args, \"--help\") || contains(args, \"-h\") {\n    mut console.write(command_usage(cmd))\n    return 0\n  }\n  // `--file F`: a script or a folder, outside any log. std's folder, and\n  // a module file of std, are edited as a package is, checked and atomic\n  // (std is built into strata).\n  mut line := args\n  mut opened: Option[Result[Opened, String]] = None\n  match [k for (k, x) in enumerate(args) where x == \"--file\"] {\n    [k, ..] => {\n      f := get(args, k + 1) ?? \"\"\n      rest := [x for (i, x) in enumerate(args) where i != k && i != k + 1]\n      std_file := if cmd == \"edit\" {\n        std_module_file(disk, f)\n      } else {\n        None\n      }\n      if disk.is_dir(f) && package_name(disk, f) == \"std\" {\n        opened = Some(open_package_at(disk, process, f, cmd))\n        line = rest\n      } else {\n        match std_file {\n          Some((root, module)) => {\n            opened = Some(open_package_at(disk, process, root, cmd))\n            line = [module] + rest\n          },\n          None => return edit_file(\n            mut console,\n            mut disk,\n            mut launcher,\n            process,\n            f,\n            rest,\n            cmd,\n          ),\n        }\n      }\n    },\n    [] => (),\n  }\n  timings.begin(\"edit: open\")\n  if opened is None\n    && codebase.find_root(disk, process.current_dir()) is None {\n    return fail_with(\n      mut console,\n      \"no package here (no strata.toml in this folder or above: run `strata init`, or pass --file)\",\n    )\n  }\n  o := (opened ?? open_package(disk, process, cmd)) except e {\n    return fail_with(mut console, e)\n  }\n  timings.end(\"edit: open\")\n  // (`--file std`: outside any log, as `--file` is: written and checked,\n  // never committed to git)\n  given_args := match edit_args(line) {\n    Ok(g) => EditArgs { ..g, commit: g.commit && opened is None },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // (`--rm NAME`: a qualified name, or a short one naming one definition,\n  // in MODULE first)\n  a := match removed_names(o.decls, if cmd == \"add\" {\n    \"\"\n  } else {\n    package_module(o.name, edit_module(given_args.module ?? \"\"))\n  }, given_args.removes) {\n    Ok(rs) => EditArgs { ..given_args, removes: rs },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // `add FILE [MODULE]`: the file's text, into MODULE. For a module file or\n  // a folder of them: its definitions, in their modules.\n  if cmd == \"add\" {\n    f := a.module ?? \"\"\n    stored_defs := if disk.is_dir(f) {\n      Some(read_package(disk, f, \"\") except e {\n        return fail_with(mut console, e)\n      })\n    } else {\n      match disk.read_bytes(f) {\n        Ok(bytes) => match binary.read(bytes) {\n          Ok(img) => Some(img.decls),\n          Err(_) => None,\n        },\n        Err(e) => return fail_with(mut console, f\"{f}: {e}\"),\n      }\n    }\n    match stored_defs {\n      Some(ds) => {\n        message := if a.message == \"edit\" {\n          \"import\"\n        } else {\n          a.message\n        }\n        return match apply_edit(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          clock,\n          cache,\n          o,\n          ds,\n          a.removes,\n          message,\n          a.commit,\n          cmd,\n          contains(line, \"--json\"),\n          [],\n          a.search,\n          true,\n        ) {\n          Ok(_) => 0,\n          Err(_) => 1,\n        }\n      },\n      None => (),\n    }\n  }\n  (text, module_arg, message) := if cmd == \"add\" {\n    f := a.module ?? \"\"\n    t := disk.read(f) except e {\n      return fail_with(mut console, f\"{f}: {e}\")\n    }\n    (t, a.extra ?? \"\", if a.message == \"edit\" {\n      \"import\"\n    } else {\n      a.message\n    })\n  } else if contains(line, \"--editor\")\n    || console.interactive()\n      && driver_terminal(1).to_int() == 1\n      && len(a.removes) == 0 {\n    // (an editor only for someone at the terminal: standard input and output\n    // both on it, and nothing to remove)\n    return edit_in_editor(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      clock,\n      cache,\n      o,\n      a,\n    )\n  } else {\n    match piped_input(\n      mut console,\n      len(a.removes) > 0,\n      \"strata edit [MODULE]\",\n    ) {\n      Ok(t) => (t, a.module ?? \"\", a.message),\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  // (std's modules as stored: `io` is `std.io`)\n  timings.begin(\"edit: parse\")\n  edits := parse.parse_module(\n    text,\n    package_module(o.name, edit_module(module_arg)),\n  ) except e {\n    code := fail_with(mut console, f\"parse error at {e}\")\n    if cmd == \"edit\" {\n      say_kept(\n        mut console,\n        keep_rejected(mut disk, o.root, [(module_arg, text)]),\n      )\n    }\n    return code\n  }\n  timings.end(\"edit: parse\")\n  match apply_edit(\n    mut console,\n    mut disk,\n    mut launcher,\n    process,\n    clock,\n    cache,\n    o,\n    edits,\n    a.removes,\n    message,\n    a.commit,\n    cmd,\n    contains(line, \"--json\"),\n    if cmd == \"edit\" {\n      [(module_arg, text)]\n    } else {\n      []\n    },\n    a.search,\n    a.proofs || cmd == \"add\",\n  ) {\n    Ok(_) => 0,\n    Err(_) => 1,\n  }\n}","old_text":"/// `strata edit [MODULE] [-m MSG] [--rm NAME].. [--no-commit] [--no-search]`\n/// and `strata\n/// add FILE [MODULE]`: definitions from standard input (or the file, or the\n/// editor) replace or join the package's of the same names in MODULE\n/// (default the root module). Recorded only if the whole package checks.\nfn edit_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  args: List[String],\n  cmd: String,\n) -> std.process.ExitCode {\n  if contains(args, \"--help\") || contains(args, \"-h\") {\n    mut console.write(command_usage(cmd))\n    return 0\n  }\n  // `--file F`: a script or a folder, outside any log. std's folder, and\n  // a module file of std, are edited as a package is, checked and atomic\n  // (std is built into strata).\n  mut line := args\n  mut opened: Option[Result[Opened, String]] = None\n  match [k for (k, x) in enumerate(args) where x == \"--file\"] {\n    [k, ..] => {\n      f := get(args, k + 1) ?? \"\"\n      rest := [x for (i, x) in enumerate(args) where i != k && i != k + 1]\n      std_file := if cmd == \"edit\" {\n        std_module_file(disk, f)\n      } else {\n        None\n      }\n      if disk.is_dir(f) && package_name(disk, f) == \"std\" {\n        opened = Some(open_package_at(disk, process, f, cmd))\n        line = rest\n      } else if std_file is Some {\n        (root, module) := std_file ?? (\"\", \"\")\n        opened = Some(open_package_at(disk, process, root, cmd))\n        line = [module] + rest\n      } else {\n        return edit_file(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          f,\n          rest,\n          cmd,\n        )\n      }\n    },\n    [] => (),\n  }\n  timings.begin(\"edit: open\")\n  if opened is None\n    && codebase.find_root(disk, process.current_dir()) is None {\n    return fail_with(\n      mut console,\n      \"no package here (no strata.toml in this folder or above: run `strata init`, or pass --file)\",\n    )\n  }\n  o := (opened ?? open_package(disk, process, cmd)) except e {\n    return fail_with(mut console, e)\n  }\n  timings.end(\"edit: open\")\n  // (`--file std`: outside any log, as `--file` is: written and checked,\n  // never committed to git)\n  given_args := match edit_args(line) {\n    Ok(g) => EditArgs { ..g, commit: g.commit && opened is None },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // (`--rm NAME`: a qualified name, or a short one naming one definition,\n  // in MODULE first)\n  a := match removed_names(o.decls, if cmd == \"add\" {\n    \"\"\n  } else {\n    package_module(o.name, edit_module(given_args.module ?? \"\"))\n  }, given_args.removes) {\n    Ok(rs) => EditArgs { ..given_args, removes: rs },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // `add FILE [MODULE]`: the file's text, into MODULE. For a module file or\n  // a folder of them: its definitions, in their modules.\n  if cmd == \"add\" {\n    f := a.module ?? \"\"\n    stored_defs := if disk.is_dir(f) {\n      Some(read_package(disk, f, \"\") except e {\n        return fail_with(mut console, e)\n      })\n    } else {\n      match disk.read_bytes(f) {\n        Ok(bytes) => match binary.read(bytes) {\n          Ok(img) => Some(img.decls),\n          Err(_) => None,\n        },\n        Err(e) => return fail_with(mut console, f\"{f}: {e}\"),\n      }\n    }\n    match stored_defs {\n      Some(ds) => {\n        message := if a.message == \"edit\" {\n          \"import\"\n        } else {\n          a.message\n        }\n        return match apply_edit(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          clock,\n          cache,\n          o,\n          ds,\n          a.removes,\n          message,\n          a.commit,\n          cmd,\n          contains(line, \"--json\"),\n          [],\n          a.search,\n          true,\n        ) {\n          Ok(_) => 0,\n          Err(_) => 1,\n        }\n      },\n      None => (),\n    }\n  }\n  (text, module_arg, message) := if cmd == \"add\" {\n    f := a.module ?? \"\"\n    t := disk.read(f) except e {\n      return fail_with(mut console, f\"{f}: {e}\")\n    }\n    (t, a.extra ?? \"\", if a.message == \"edit\" {\n      \"import\"\n    } else {\n      a.message\n    })\n  } else if contains(line, \"--editor\")\n    || console.interactive()\n      && driver_terminal(1).to_int() == 1\n      && len(a.removes) == 0 {\n    // (an editor only for someone at the terminal: standard input and output\n    // both on it, and nothing to remove)\n    return edit_in_editor(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      clock,\n      cache,\n      o,\n      a,\n    )\n  } else {\n    match piped_input(\n      mut console,\n      len(a.removes) > 0,\n      \"strata edit [MODULE]\",\n    ) {\n      Ok(t) => (t, a.module ?? \"\", a.message),\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  // (std's modules as stored: `io` is `std.io`)\n  timings.begin(\"edit: parse\")\n  edits := parse.parse_module(\n    text,\n    package_module(o.name, edit_module(module_arg)),\n  ) except e {\n    code := fail_with(mut console, f\"parse error at {e}\")\n    if cmd == \"edit\" {\n      say_kept(\n        mut console,\n        keep_rejected(mut disk, o.root, [(module_arg, text)]),\n      )\n    }\n    return code\n  }\n  timings.end(\"edit: parse\")\n  match apply_edit(\n    mut console,\n    mut disk,\n    mut launcher,\n    process,\n    clock,\n    cache,\n    o,\n    edits,\n    a.removes,\n    message,\n    a.commit,\n    cmd,\n    contains(line, \"--json\"),\n    if cmd == \"edit\" {\n      [(module_arg, text)]\n    } else {\n      []\n    },\n    a.search,\n    a.proofs || cmd == \"add\",\n  ) {\n    Ok(_) => 0,\n    Err(_) => 1,\n  }\n}"}]}
{"id":"a86c941854466257","time":1795848898,"message":"new kernel_dependent","changes":[{"name":"kernel_dependent.Term","kind":"type","old":null,"new":"b6ad980d4ce4c32c","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"// kernel_dependent: the trusted core of a dependently typed kernel, measured\n// beside the HOL `kernel`: the terms of a type theory with Π, a universe\n// hierarchy, equality and inductive types; its type checker; and the only\n// functions that extend an `Environment`.\n\n/// A term, locally nameless: `Free` is a variable of the context by name,\n/// `Bound` one bound by the binder that many binders out. A `Constant`'s\n/// `levels` are the universe levels a built-in family or a recursor is\n/// taken at (`[]` for the others).\npub type Term =\n  | Sort(Int)\n  | Bound(Int)\n  | Free(String)\n  | Constant { name: String, levels: List[Int] }\n  | Pi { name: String, domain: kernel_dependent.Term, body: kernel_dependent.Term }\n  | Lambda { name: String, domain: kernel_dependent.Term, body: kernel_dependent.Term }\n  | Apply { function: kernel_dependent.Term, argument: kernel_dependent.Term }"},{"name":"kernel_dependent.Inductive","kind":"type","old":null,"new":"f249ecd222ea3bb2","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// An inductive type: `ty` is `Π params. Sort level`, and each constructor\n/// says which of its arguments are recursive.\npub type Inductive = {\n  name: String,\n  params: Int,\n  level: Int,\n  ty: kernel_dependent.Term,\n  constructors: List[kernel_dependent.Constructor],\n}"},{"name":"kernel_dependent.Constructor","kind":"type","old":null,"new":"8d4da646de376840","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// A constructor: its type `Π params. Π args. I params`, and per argument\n/// whether it is recursive (of type `I params`).\npub type Constructor = {\n  name: String,\n  ty: kernel_dependent.Term,\n  recursive: List[Bool],\n}"},{"name":"kernel_dependent.Entry","kind":"type","old":null,"new":"49b1c2406e839078","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// A constant: a definition (`value`), an axiom, or an inductive type or\n/// one of its constructors (neither).\npub type Entry = {\n  name: String,\n  ty: kernel_dependent.Term,\n  value: Option[kernel_dependent.Term],\n  axiom: Bool,\n}"},{"name":"kernel_dependent.Environment","kind":"type","old":null,"new":"20362a68dcf35b29","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// The constants checked so far. Only this module's functions make or\n/// extend one, each after checking what it adds.\npub distinct type Environment = kernel_dependent.SealedEnvironment"},{"name":"kernel_dependent.SealedEnvironment","kind":"type","old":null,"new":"1b4f64380d1641ca","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"type SealedEnvironment(kernel_dependent.Contents)"},{"name":"kernel_dependent.Contents","kind":"type","old":null,"new":"d1edc8201d01df65","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"type Contents = {\n  entries: List[kernel_dependent.Entry],\n  inductives: List[kernel_dependent.Inductive],\n}"},{"name":"kernel_dependent.empty_environment","kind":"fn","old":null,"new":"80b607f091430f28","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"pub fn empty_environment() -> kernel_dependent.Environment {\n  kernel_dependent.Environment(kernel_dependent.SealedEnvironment(\n    kernel_dependent.Contents { entries: [], inductives: [] },\n  ))\n}"},{"name":"kernel_dependent.contents","kind":"fn","old":null,"new":"cc5b630b4a2f87b9","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"fn contents(env: kernel_dependent.Environment) -> kernel_dependent.Contents {\n  match env.value {\n    kernel_dependent.SealedEnvironment(c) => c,\n  }\n}"},{"name":"kernel_dependent.lookup","kind":"fn","old":null,"new":"f314d95942452a60","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"pub fn lookup(\n  env: kernel_dependent.Environment,\n  name: String,\n) -> Option[kernel_dependent.Entry] {\n  for e in kernel_dependent.contents(env).entries {\n    if e.name == name {\n      return Some(e)\n    }\n  }\n  None\n}"},{"name":"kernel_dependent.inductive_named","kind":"fn","old":null,"new":"8c5b5691711a9ee5","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"pub fn inductive_named(\n  env: kernel_dependent.Environment,\n  name: String,\n) -> Option[kernel_dependent.Inductive] {\n  for i in kernel_dependent.contents(env).inductives {\n    if i.name == name {\n      return Some(i)\n    }\n  }\n  None\n}"},{"name":"kernel_dependent.axioms","kind":"fn","old":null,"new":"9478b2fe88b6bfd6","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// The names of the axioms the environment holds.\npub fn axioms(env: kernel_dependent.Environment) -> List[String] {\n  kernel_dependent.contents(env).entries\n    .filter(e -> e.axiom)\n    .map(e -> e.name)\n}"},{"name":"kernel_dependent.extended","kind":"fn","old":null,"new":"4278d6ef7210c72e","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"fn extended(\n  env: kernel_dependent.Environment,\n  es: List[kernel_dependent.Entry],\n  ins: List[kernel_dependent.Inductive],\n) -> kernel_dependent.Environment {\n  c := kernel_dependent.contents(env)\n  kernel_dependent.Environment(\n    kernel_dependent.SealedEnvironment(kernel_dependent.Contents {\n      entries: c.entries + es,\n      inductives: c.inductives + ins,\n    }),\n  )\n}"},{"name":"kernel_dependent.abstract","kind":"fn","old":null,"new":"92efddff88ebf803","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"// ---- terms ----\n\n/// `t` with the free variable `x` bound by the binder `depth` levels up.\npub fn abstract(\n  t: kernel_dependent.Term,\n  x: String,\n  depth: Int,\n) -> kernel_dependent.Term {\n  match t {\n    kernel_dependent.Free(y) => if y == x {\n      kernel_dependent.Bound(depth)\n    } else {\n      t\n    },\n    kernel_dependent.Pi { name, domain, body } => kernel_dependent.Pi {\n      name,\n      domain: kernel_dependent.abstract(domain, x, depth),\n      body: kernel_dependent.abstract(body, x, depth + 1),\n    },\n    kernel_dependent.Lambda { name, domain, body } => kernel_dependent.Lambda {\n      name,\n      domain: kernel_dependent.abstract(domain, x, depth),\n      body: kernel_dependent.abstract(body, x, depth + 1),\n    },\n    kernel_dependent.Apply { function, argument } => kernel_dependent.Apply {\n      function: kernel_dependent.abstract(function, x, depth),\n      argument: kernel_dependent.abstract(argument, x, depth),\n    },\n    _ => t,\n  }\n}"},{"name":"kernel_dependent.instantiate","kind":"fn","old":null,"new":"fb0cfae8065a1fba","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// `t` with `u` (no loose bound variables) for the variable bound by the\n/// binder `depth` levels up.\npub fn instantiate(\n  t: kernel_dependent.Term,\n  u: kernel_dependent.Term,\n  depth: Int,\n) -> kernel_dependent.Term {\n  match t {\n    kernel_dependent.Bound(i) => if i == depth {\n      u\n    } else {\n      t\n    },\n    kernel_dependent.Pi { name, domain, body } => kernel_dependent.Pi {\n      name,\n      domain: kernel_dependent.instantiate(domain, u, depth),\n      body: kernel_dependent.instantiate(body, u, depth + 1),\n    },\n    kernel_dependent.Lambda { name, domain, body } => kernel_dependent.Lambda {\n      name,\n      domain: kernel_dependent.instantiate(domain, u, depth),\n      body: kernel_dependent.instantiate(body, u, depth + 1),\n    },\n    kernel_dependent.Apply { function, argument } => kernel_dependent.Apply {\n      function: kernel_dependent.instantiate(function, u, depth),\n      argument: kernel_dependent.instantiate(argument, u, depth),\n    },\n    _ => t,\n  }\n}"},{"name":"kernel_dependent.pi","kind":"fn","old":null,"new":"dbc8f753914c86a3","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// `Π (x: d). b`, binding the free variable `x` of `b`.\npub fn pi(\n  x: String,\n  d: kernel_dependent.Term,\n  b: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  kernel_dependent.Pi {\n    name: x,\n    domain: d,\n    body: kernel_dependent.abstract(b, x, 0),\n  }\n}"},{"name":"kernel_dependent.lambda","kind":"fn","old":null,"new":"719e10e461911b99","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// `λ (x: d). b`, binding the free variable `x` of `b`.\npub fn lambda(\n  x: String,\n  d: kernel_dependent.Term,\n  b: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  kernel_dependent.Lambda {\n    name: x,\n    domain: d,\n    body: kernel_dependent.abstract(b, x, 0),\n  }\n}"},{"name":"kernel_dependent.applied","kind":"fn","old":null,"new":"28ea7f090d1973dc","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// `f a1 … an`\npub fn applied(\n  f: kernel_dependent.Term,\n  args: List[kernel_dependent.Term],\n) -> kernel_dependent.Term {\n  mut out := f\n  for a in args {\n    out = kernel_dependent.Apply { function: out, argument: a }\n  }\n  out\n}"},{"name":"kernel_dependent.spine","kind":"fn","old":null,"new":"64ca6dd5b7218f4f","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// The head of an application and its arguments.\npub fn spine(\n  t: kernel_dependent.Term,\n) -> (kernel_dependent.Term, List[kernel_dependent.Term]) {\n  match t {\n    kernel_dependent.Apply { function, argument } => {\n      (h, args) := kernel_dependent.spine(function)\n      (h, args + [argument])\n    },\n    _ => (t, []),\n  }\n}"},{"name":"kernel_dependent.mentions","kind":"fn","old":null,"new":"e0dd94c826413bcd","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// Whether the constant `name` occurs in `t`.\npub fn mentions(t: kernel_dependent.Term, name: String) -> Bool {\n  match t {\n    kernel_dependent.Constant { name: n, .. } => n == name,\n    kernel_dependent.Pi { domain, body, .. } => kernel_dependent.mentions(domain, name)\n      || kernel_dependent.mentions(body, name),\n    kernel_dependent.Lambda { domain, body, .. } => kernel_dependent.mentions(domain, name)\n      || kernel_dependent.mentions(body, name),\n    kernel_dependent.Apply { function, argument } => kernel_dependent.mentions(function, name)\n      || kernel_dependent.mentions(argument, name),\n    _ => false,\n  }\n}"},{"name":"kernel_dependent.peel","kind":"fn","old":null,"new":"1b82be16a709d3a4","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// `n` binders of `t` opened, each as a free variable `prefix` + its\n/// position (all of them when `n` is negative).\npub fn peel(\n  t: kernel_dependent.Term,\n  n: Int,\n  prefix: String,\n) -> (List[(String, kernel_dependent.Term)], kernel_dependent.Term) {\n  kernel_dependent.peel_from(t, n, prefix, [])\n}"},{"name":"kernel_dependent.peel_from","kind":"fn","old":null,"new":"76021c132d11e414","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"fn peel_from(\n  t: kernel_dependent.Term,\n  n: Int,\n  prefix: String,\n  binders: List[(String, kernel_dependent.Term)],\n) -> (List[(String, kernel_dependent.Term)], kernel_dependent.Term) {\n  if n >= 0 && len(binders) >= n {\n    return (binders, t)\n  }\n  match t {\n    kernel_dependent.Pi { domain, body, .. } => {\n      x := prefix + to_string(len(binders))\n      kernel_dependent.peel_from(kernel_dependent.instantiate(\n        body,\n        kernel_dependent.Free(x),\n        0,\n      ), n, prefix, binders + [(x, domain)])\n    },\n    _ => (binders, t),\n  }\n}"},{"name":"kernel_dependent.larger","kind":"fn","old":null,"new":"da397cba9485898d","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"fn larger(a: Int, b: Int) -> Int {\n  if a > b {\n    a\n  } else {\n    b\n  }\n}"},{"name":"kernel_dependent.equality","kind":"fn","old":null,"new":"4ac087489e52644b","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"// ---- the built-in families: equality and function extensionality ----\n\n/// `Eq.{l} A a b`\npub fn equality(\n  l: Int,\n  a_type: kernel_dependent.Term,\n  a: kernel_dependent.Term,\n  b: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  kernel_dependent.applied(\n    kernel_dependent.Constant { name: \"Eq\", levels: [l] },\n    [a_type, a, b],\n  )\n}"},{"name":"kernel_dependent.reflexivity","kind":"fn","old":null,"new":"87542129ace6a451","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// `refl.{l} A a : Eq A a a`\npub fn reflexivity(\n  l: Int,\n  a_type: kernel_dependent.Term,\n  a: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  kernel_dependent.applied(\n    kernel_dependent.Constant { name: \"refl\", levels: [l] },\n    [a_type, a],\n  )\n}"},{"name":"kernel_dependent.built_in_type","kind":"fn","old":null,"new":"5da1f44f4a54aa9f","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// The types of `Eq`, `refl`, `J` (equality's eliminator, which reduces on\n/// `refl`) and `funext` (an axiom), at their levels.\nfn built_in_type(\n  name: String,\n  levels: List[Int],\n) -> Option[kernel_dependent.Term] {\n  a_type := kernel_dependent.Free(\"A\")\n  a := kernel_dependent.Free(\"a\")\n  b := kernel_dependent.Free(\"b\")\n  l := get(levels, 0) ?? -1\n  m := get(levels, 1) ?? -1\n  if l < 0 || name != \"Eq\" && name != \"refl\" && m < 0 {\n    return None\n  }\n  if name == \"Eq\" && len(levels) == 1 {\n    Some(kernel_dependent.pi(\n      \"A\",\n      kernel_dependent.Sort(l),\n      kernel_dependent.pi(\n        \"a\",\n        a_type,\n        kernel_dependent.pi(\"b\", a_type, kernel_dependent.Sort(l)),\n      ),\n    ))\n  } else if name == \"refl\" && len(levels) == 1 {\n    Some(kernel_dependent.pi(\n      \"A\",\n      kernel_dependent.Sort(l),\n      kernel_dependent.pi(\n        \"a\",\n        a_type,\n        kernel_dependent.equality(l, a_type, a, a),\n      ),\n    ))\n  } else if name == \"J\" && len(levels) == 2 {\n    motive := kernel_dependent.Free(\"motive\")\n    Some(kernel_dependent.pi(\n      \"A\",\n      kernel_dependent.Sort(l),\n      kernel_dependent.pi(\"a\", a_type, kernel_dependent.pi(\n        \"motive\",\n        kernel_dependent.pi(\"b\", a_type, kernel_dependent.pi(\n          \"e\",\n          kernel_dependent.equality(l, a_type, a, b),\n          kernel_dependent.Sort(m),\n        )),\n        kernel_dependent.pi(\"r\", kernel_dependent.applied(\n          motive,\n          [a, kernel_dependent.reflexivity(l, a_type, a)],\n        ), kernel_dependent.pi(\"b\", a_type, kernel_dependent.pi(\n          \"e\",\n          kernel_dependent.equality(l, a_type, a, b),\n          kernel_dependent.applied(\n            motive,\n            [b, kernel_dependent.Free(\"e\")],\n          ),\n        ))),\n      )),\n    ))\n  } else if name == \"funext\" && len(levels) == 2 {\n    b_type := kernel_dependent.Free(\"B\")\n    x := kernel_dependent.Free(\"x\")\n    f := kernel_dependent.Free(\"f\")\n    g := kernel_dependent.Free(\"g\")\n    fs := kernel_dependent.pi(\n      \"x\",\n      a_type,\n      kernel_dependent.Apply { function: b_type, argument: x },\n    )\n    Some(kernel_dependent.pi(\n      \"A\",\n      kernel_dependent.Sort(l),\n      kernel_dependent.pi(\n        \"B\",\n        kernel_dependent.pi(\"x\", a_type, kernel_dependent.Sort(m)),\n        kernel_dependent.pi(\n          \"f\",\n          fs,\n          kernel_dependent.pi(\n            \"g\",\n            fs,\n            kernel_dependent.pi(\"h\", kernel_dependent.pi(\n              \"x\",\n              a_type,\n              kernel_dependent.equality(\n                m,\n                kernel_dependent.Apply {\n                  function: b_type,\n                  argument: x,\n                },\n                kernel_dependent.Apply { function: f, argument: x },\n                kernel_dependent.Apply { function: g, argument: x },\n              ),\n            ), kernel_dependent.equality(\n              kernel_dependent.larger(l, m),\n              fs,\n              f,\n              g,\n            )),\n          ),\n        ),\n      ),\n    ))\n  } else {\n    None\n  }\n}"},{"name":"kernel_dependent.is_built_in","kind":"fn","old":null,"new":"4d1727f120481f5d","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"fn is_built_in(name: String) -> Bool {\n  contains([\"Eq\", \"refl\", \"J\", \"funext\"], name)\n}"},{"name":"kernel_dependent.recursor_type","kind":"fn","old":null,"new":"05ef14d0c389b72e","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// `I.rec.{m} : Π params. Π (motive: I params → Sort m). Π minors. Π (x: I\n/// params). motive x`, a minor per constructor `c`: `Π args. Π (ih: motive\n/// a) for each recursive a. motive (c params args)`.\nfn recursor_type(\n  ind: kernel_dependent.Inductive,\n  m: Int,\n) -> kernel_dependent.Term {\n  ps := kernel_dependent.peel(ind.ty, ind.params, \"#p\").0\n  self := kernel_dependent.applied(\n    kernel_dependent.Constant { name: ind.name, levels: [] },\n    ps.map(p -> kernel_dependent.Free(p.0)),\n  )\n  motive := kernel_dependent.Free(\"#motive\")\n  mut minors := []\n  for c in ind.constructors {\n    args := kernel_dependent.peel(\n      kernel_dependent.peel(c.ty, ind.params, \"#p\").1,\n      -1,\n      \"#a\",\n    ).0\n    mut body := kernel_dependent.Apply {\n      function: motive,\n      argument: kernel_dependent.applied(\n        kernel_dependent.Constant { name: c.name, levels: [] },\n        ps.map(p -> kernel_dependent.Free(p.0))\n          + args.map(a -> kernel_dependent.Free(a.0)),\n      ),\n    }\n    for (j, a) in enumerate(args).reversed() {\n      if get(c.recursive, j) ?? false {\n        body = kernel_dependent.pi(\n          \"#ih\" + to_string(j),\n          kernel_dependent.Apply {\n            function: motive,\n            argument: kernel_dependent.Free(a.0),\n          },\n          body,\n        )\n      }\n    }\n    for a in args.reversed() {\n      body = kernel_dependent.pi(a.0, a.1, body)\n    }\n    mut minors.push(body)\n  }\n  mut out := kernel_dependent.pi(\"#x\", self, kernel_dependent.Apply {\n    function: motive,\n    argument: kernel_dependent.Free(\"#x\"),\n  })\n  for (k, minor) in enumerate(minors).reversed() {\n    out = kernel_dependent.pi(\"#minor\" + to_string(k), minor, out)\n  }\n  out = kernel_dependent.pi(\n    \"#motive\",\n    kernel_dependent.pi(\"#x\", self, kernel_dependent.Sort(m)),\n    out,\n  )\n  for p in ps.reversed() {\n    out = kernel_dependent.pi(p.0, p.1, out)\n  }\n  out\n}"},{"name":"kernel_dependent.constant_type","kind":"fn","old":null,"new":"4ab0244ec598b2cb","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// The type of the constant `name` at `levels`.\npub fn constant_type(\n  env: kernel_dependent.Environment,\n  name: String,\n  levels: List[Int],\n) -> Result[kernel_dependent.Term, String] {\n  match kernel_dependent.built_in_type(name, levels) {\n    Some(t) => return Ok(t),\n    None => (),\n  }\n  for ind in kernel_dependent.contents(env).inductives {\n    if ind.name + \".rec\" == name {\n      return match levels {\n        [m] => if m >= 0 {\n          Ok(kernel_dependent.recursor_type(ind, m))\n        } else {\n          Err(\"a negative level\")\n        },\n        _ => Err(\"`\" + name + \"` takes one level\"),\n      }\n    }\n  }\n  match kernel_dependent.lookup(env, name) {\n    Some(e) => if levels == [] {\n      Ok(e.ty)\n    } else {\n      Err(\"`\" + name + \"` takes no levels\")\n    },\n    None => Err(\"no constant `\" + name + \"`\"),\n  }\n}"},{"name":"kernel_dependent.whnf","kind":"fn","old":null,"new":"2406fa95e5bac41d","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"// ---- reduction and definitional equality ----\n\n/// The weak head normal form of `t`: β, δ (a definition unfolded), ι (a\n/// recursor on a constructor, `J` on `refl`).\npub fn whnf(\n  env: kernel_dependent.Environment,\n  t: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  (head, args) := kernel_dependent.spine(t)\n  match head {\n    kernel_dependent.Lambda { body, .. } => match args {\n      [first, ..rest] => kernel_dependent.whnf(env, kernel_dependent.applied(\n        kernel_dependent.instantiate(body, first, 0),\n        rest,\n      )),\n      [] => t,\n    },\n    kernel_dependent.Constant { name, levels } => match kernel_dependent.lookup(env, name) {\n      Some(kernel_dependent.Entry { value: Some(v), .. }) => kernel_dependent.whnf(env, kernel_dependent.applied(v, args)),\n      _ => match kernel_dependent.reduce_eliminator(env, name, levels, args) {\n        Some(r) => kernel_dependent.whnf(env, r),\n        None => t,\n      },\n    },\n    _ => t,\n  }\n}"},{"name":"kernel_dependent.reduce_eliminator","kind":"fn","old":null,"new":"2181c4f1b4a79d9b","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"fn reduce_eliminator(\n  env: kernel_dependent.Environment,\n  name: String,\n  levels: List[Int],\n  args: List[kernel_dependent.Term],\n) -> Option[kernel_dependent.Term] {\n  if name == \"J\" {\n    e := get(args, 5)?\n    return match kernel_dependent.spine(kernel_dependent.whnf(env, e)).0 {\n      kernel_dependent.Constant { name: \"refl\", .. } => Some(kernel_dependent.applied(get(args, 3)?, drop(args, 6))),\n      _ => None,\n    }\n  }\n  for ind in kernel_dependent.contents(env).inductives {\n    if ind.name + \".rec\" == name {\n      n := ind.params\n      k := len(ind.constructors)\n      (h, cargs) := kernel_dependent.spine(\n        kernel_dependent.whnf(env, get(args, n + 1 + k)?),\n      )\n      for (i, c) in enumerate(ind.constructors) {\n        if (h == kernel_dependent.Constant { name: c.name, levels: [] }\n          && len(cargs) == n + len(c.recursive)) {\n          fields := drop(cargs, n)\n          recurse := kernel_dependent.applied(\n            kernel_dependent.Constant { name, levels },\n            take(args, n + 1 + k),\n          )\n          mut ihs := []\n          for (j, f) in enumerate(fields) {\n            if get(c.recursive, j) ?? false {\n              mut ihs.push(\n                kernel_dependent.Apply {\n                  function: recurse,\n                  argument: f,\n                },\n              )\n            }\n          }\n          return Some(kernel_dependent.applied(\n            get(args, n + 1 + i)?,\n            fields + ihs + drop(args, n + k + 2),\n          ))\n        }\n      }\n      return None\n    }\n  }\n  None\n}"},{"name":"kernel_dependent.fresh","kind":"fn","old":null,"new":"f63367e586139283","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// A name for a new free variable at `depth`: never a user's name.\npub fn fresh(depth: Int) -> String {\n  \"#\" + to_string(depth)\n}"},{"name":"kernel_dependent.convertible","kind":"fn","old":null,"new":"204d4dcbbd3d7232","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// Whether `a` and `b` are definitionally equal: the same once reduced,\n/// with η for functions. Free variables named `#k`, `k >= depth`, are\n/// unused.\npub fn convertible(\n  env: kernel_dependent.Environment,\n  depth: Int,\n  a: kernel_dependent.Term,\n  b: kernel_dependent.Term,\n) -> Bool {\n  if a == b {\n    return true\n  }\n  wa := kernel_dependent.whnf(env, a)\n  wb := kernel_dependent.whnf(env, b)\n  if wa == wb {\n    return true\n  }\n  x := kernel_dependent.Free(kernel_dependent.fresh(depth))\n  match (wa, wb) {\n    (kernel_dependent.Sort(i), kernel_dependent.Sort(j)) => i == j,\n    (kernel_dependent.Pi { domain: d1, body: b1, .. }, kernel_dependent.Pi { domain: d2, body: b2, .. }) => kernel_dependent.convertible(env, depth, d1, d2)\n      && kernel_dependent.convertible(\n        env,\n        depth + 1,\n        kernel_dependent.instantiate(b1, x, 0),\n        kernel_dependent.instantiate(b2, x, 0),\n      ),\n    (kernel_dependent.Lambda { domain: d1, body: b1, .. }, kernel_dependent.Lambda { domain: d2, body: b2, .. }) => kernel_dependent.convertible(env, depth, d1, d2)\n      && kernel_dependent.convertible(\n        env,\n        depth + 1,\n        kernel_dependent.instantiate(b1, x, 0),\n        kernel_dependent.instantiate(b2, x, 0),\n      ),\n    (kernel_dependent.Lambda { body, .. }, _) => kernel_dependent.convertible(\n      env,\n      depth + 1,\n      kernel_dependent.instantiate(body, x, 0),\n      kernel_dependent.Apply { function: wb, argument: x },\n    ),\n    (_, kernel_dependent.Lambda { body, .. }) => kernel_dependent.convertible(\n      env,\n      depth + 1,\n      kernel_dependent.Apply { function: wa, argument: x },\n      kernel_dependent.instantiate(body, x, 0),\n    ),\n    (kernel_dependent.Apply { .. }, kernel_dependent.Apply { .. }) => {\n      (h1, as1) := kernel_dependent.spine(wa)\n      (h2, as2) := kernel_dependent.spine(wb)\n      if len(as1) != len(as2)\n        || !kernel_dependent.convertible(env, depth, h1, h2) {\n        return false\n      }\n      for (i, u) in enumerate(as1) {\n        if !kernel_dependent.convertible(\n          env,\n          depth,\n          u,\n          get(as2, i) ?? u,\n        ) {\n          return false\n        }\n      }\n      true\n    },\n    _ => false,\n  }\n}"},{"name":"kernel_dependent.infer","kind":"fn","old":null,"new":"8538e598d599344d","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"// ---- typing ----\n\n/// The type of `t` in `ctx` (each free variable with its type, assumed well\n/// formed): an error when `t` is ill-typed.\npub fn infer(\n  env: kernel_dependent.Environment,\n  ctx: List[(String, kernel_dependent.Term)],\n  t: kernel_dependent.Term,\n) -> Result[kernel_dependent.Term, String] {\n  match t {\n    kernel_dependent.Sort(l) => if l >= 0 {\n      Ok(kernel_dependent.Sort(l + 1))\n    } else {\n      Err(\"a negative level\")\n    },\n    kernel_dependent.Bound(_) => Err(\"a loose bound variable\"),\n    kernel_dependent.Free(x) => {\n      for (y, ty) in ctx {\n        if y == x {\n          return Ok(ty)\n        }\n      }\n      Err(\"`\" + x + \"` isn't in scope\")\n    },\n    kernel_dependent.Constant { name, levels } => kernel_dependent.constant_type(env, name, levels),\n    kernel_dependent.Pi { domain, body, .. } => {\n      i := kernel_dependent.sort_of(env, ctx, domain)!\n      x := kernel_dependent.fresh(len(ctx))\n      j := kernel_dependent.sort_of(\n        env,\n        [(x, domain)] + ctx,\n        kernel_dependent.instantiate(\n          body,\n          kernel_dependent.Free(x),\n          0,\n        ),\n      )!\n      Ok(kernel_dependent.Sort(kernel_dependent.larger(i, j)))\n    },\n    kernel_dependent.Lambda { name, domain, body } => {\n      _ := kernel_dependent.sort_of(env, ctx, domain)!\n      x := kernel_dependent.fresh(len(ctx))\n      b := kernel_dependent.infer(\n        env,\n        [(x, domain)] + ctx,\n        kernel_dependent.instantiate(\n          body,\n          kernel_dependent.Free(x),\n          0,\n        ),\n      )!\n      Ok(kernel_dependent.Pi {\n        name,\n        domain,\n        body: kernel_dependent.abstract(b, x, 0),\n      })\n    },\n    kernel_dependent.Apply { function, argument } => match kernel_dependent.whnf(\n      env,\n      kernel_dependent.infer(env, ctx, function)!,\n    ) {\n      kernel_dependent.Pi { domain, body, .. } => {\n        kernel_dependent.has_type(env, ctx, argument, domain)!\n        Ok(kernel_dependent.instantiate(body, argument, 0))\n      },\n      _ => Err(\"a non-function applied\"),\n    },\n  }\n}"},{"name":"kernel_dependent.sort_of","kind":"fn","old":null,"new":"3e938cb6363cceef","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// The level of the type `t`.\npub fn sort_of(\n  env: kernel_dependent.Environment,\n  ctx: List[(String, kernel_dependent.Term)],\n  t: kernel_dependent.Term,\n) -> Result[Int, String] {\n  match kernel_dependent.whnf(env, kernel_dependent.infer(env, ctx, t)!) {\n    kernel_dependent.Sort(l) => Ok(l),\n    _ => Err(\"not a type\"),\n  }\n}"},{"name":"kernel_dependent.has_type","kind":"fn","old":null,"new":"edd3565cc720ff62","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// `t : ty` in `ctx`.\npub fn has_type(\n  env: kernel_dependent.Environment,\n  ctx: List[(String, kernel_dependent.Term)],\n  t: kernel_dependent.Term,\n  ty: kernel_dependent.Term,\n) -> Result[(), String] {\n  if kernel_dependent.convertible(\n    env,\n    len(ctx),\n    kernel_dependent.infer(env, ctx, t)!,\n    ty,\n  ) {\n    Ok(())\n  } else {\n    Err(\"a term of the wrong type\")\n  }\n}"},{"name":"kernel_dependent.new_name","kind":"fn","old":null,"new":"879469147ca6a5ab","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"// ---- extending the environment ----\n\nfn new_name(\n  env: kernel_dependent.Environment,\n  name: String,\n) -> Result[(), String] {\n  if kernel_dependent.is_built_in(name)\n    || kernel_dependent.lookup(env, name) != None\n    || kernel_dependent.contents(env).inductives.any(\n      i -> i.name + \".rec\" == name,\n    )\n    || ends_with(name, \".rec\")\n    || starts_with(name, \"#\") {\n    Err(\"`\" + name + \"` is taken\")\n  } else {\n    Ok(())\n  }\n}"},{"name":"kernel_dependent.define","kind":"fn","old":null,"new":"ef54baa8a5b92b23","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// The environment with `name := value : ty`: `ty` a type and `value` of\n/// type `ty`, both closed. A law is a definition whose type is its\n/// statement, and its value the proof.\npub fn define(\n  env: kernel_dependent.Environment,\n  name: String,\n  ty: kernel_dependent.Term,\n  value: kernel_dependent.Term,\n) -> Result[kernel_dependent.Environment, String] {\n  kernel_dependent.new_name(env, name)!\n  _ := kernel_dependent.sort_of(env, [], ty)!\n  match kernel_dependent.has_type(env, [], value, ty) {\n    Ok(_) => (),\n    Err(m) => return Err(\"`\" + name + \"`: \" + m),\n  }\n  Ok(kernel_dependent.extended(env, [kernel_dependent.Entry {\n    name,\n    ty,\n    value: Some(value),\n    axiom: false,\n  }], []))\n}"},{"name":"kernel_dependent.declare","kind":"fn","old":null,"new":"654970df339f85c9","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// The environment with an axiom `name : ty` (`ty` a closed type).\npub fn declare(\n  env: kernel_dependent.Environment,\n  name: String,\n  ty: kernel_dependent.Term,\n) -> Result[kernel_dependent.Environment, String] {\n  kernel_dependent.new_name(env, name)!\n  _ := kernel_dependent.sort_of(env, [], ty)!\n  Ok(kernel_dependent.extended(\n    env,\n    [kernel_dependent.Entry { name, ty, value: None, axiom: true }],\n    [],\n  ))\n}"},{"name":"kernel_dependent.add_inductive","kind":"fn","old":null,"new":"3ecd40c85652ea0a","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"/// The environment with the inductive type `name : ty` (`Π params. Sort l`,\n/// no indices) and its constructors: each `Π params. Π args. name params`,\n/// with the type's parameters, and each argument either `name params`\n/// (recursive) or a type not mentioning `name`, at a level at most `l`.\n/// Its recursor is `name.rec`.\npub fn add_inductive(\n  env: kernel_dependent.Environment,\n  name: String,\n  ty: kernel_dependent.Term,\n  params: Int,\n  constructors: List[(String, kernel_dependent.Term)],\n) -> Result[kernel_dependent.Environment, String] {\n  kernel_dependent.new_name(env, name)!\n  _ := kernel_dependent.sort_of(env, [], ty)!\n  (ps, result) := kernel_dependent.peel(ty, params, \"#p\")\n  level := match result {\n    kernel_dependent.Sort(l) => if len(ps) == params {\n      l\n    } else {\n      return Err(\"`\" + name + \"`: fewer parameters than said\")\n    },\n    _ => return Err(\"`\"\n      + name\n      + \"`: not `Π params. Sort l` (indices aren't supported)\"),\n  }\n  with_type := kernel_dependent.extended(\n    env,\n    [kernel_dependent.Entry { name, ty, value: None, axiom: false }],\n    [],\n  )\n  self := kernel_dependent.applied(\n    kernel_dependent.Constant { name, levels: [] },\n    ps.map(p -> kernel_dependent.Free(p.0)),\n  )\n  mut cs := []\n  mut seen := [name + \".rec\"]\n  for (c, cty) in constructors {\n    kernel_dependent.new_name(with_type, c)!\n    if contains(seen, c) {\n      return Err(\"constructor `\" + c + \"` repeated\")\n    }\n    mut seen.push(c)\n    _ := kernel_dependent.sort_of(with_type, [], cty)!\n    (cps, rest) := kernel_dependent.peel(cty, params, \"#p\")\n    if cps != ps {\n      return Err(\"constructor `\" + c + \"`: not the type's parameters\")\n    }\n    (args, out) := kernel_dependent.peel(rest, -1, \"#a\")\n    if out != self {\n      return Err(\"constructor `\"\n        + c\n        + \"`: its result isn't the type at its parameters\")\n    }\n    mut ctx := ps.reversed()\n    mut recursive := []\n    for (a, d) in args {\n      if d == self {\n        mut recursive.push(true)\n      } else if kernel_dependent.mentions(d, name) {\n        return Err(\"constructor `\"\n          + c\n          + \"`: an argument mentions the type other than as itself\")\n      } else {\n        if kernel_dependent.sort_of(with_type, ctx, d)! > level {\n          return Err(\"constructor `\"\n            + c\n            + \"`: an argument in a larger universe than the type\")\n        }\n        mut recursive.push(false)\n      }\n      ctx = [(a, d)] + ctx\n    }\n    mut cs.push(\n      kernel_dependent.Constructor { name: c, ty: cty, recursive },\n    )\n  }\n  Ok(kernel_dependent.extended(\n    env,\n    [\n        kernel_dependent.Entry {\n          name,\n          ty,\n          value: None,\n          axiom: false,\n        },\n      ]\n      + cs.map(\n        c -> kernel_dependent.Entry {\n          name: c.name,\n          ty: c.ty,\n          value: None,\n          axiom: false,\n        },\n      ),\n    [kernel_dependent.Inductive {\n      name,\n      params,\n      level,\n      ty,\n      constructors: cs,\n    }],\n  ))\n}"}]}
{"id":"edf8bbf64219142f","time":1795849098,"message":"new kernel_dependent_tactics","changes":[{"name":"kernel_dependent_tactics.use kernel_dependent","kind":"use","old":null,"new":"8fc623c2b446229f","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"// kernel_dependent_tactics: proofs for `kernel_dependent`, untrusted: goals,\n// tactics that build proof terms, normal forms, and a printer. The kernel\n// checks the finished term when it is defined.\n\nuse kernel_dependent"},{"name":"kernel_dependent_tactics.Goal","kind":"type","old":null,"new":"b04f159e3c33f68a","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"/// What is left to prove: the variables and hypotheses in scope (innermost\n/// first) and the statement.\npub type Goal = {\n  env: kernel_dependent.Environment,\n  context: List[(String, kernel_dependent.Term)],\n  target: kernel_dependent.Term,\n}"},{"name":"kernel_dependent_tactics.Then","kind":"type","old":null,"new":"d983acaaed9ae5f4","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"/// A tactic's continuation: the proof of the goal it is given.\npub type Then = (kernel_dependent_tactics.Goal) -> Result[kernel_dependent.Term, String]"},{"name":"kernel_dependent_tactics.constant","kind":"fn","old":null,"new":"99610474907adba5","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"fn constant(name: String) -> kernel_dependent.Term {\n  kernel_dependent.Constant { name, levels: [] }\n}"},{"name":"kernel_dependent_tactics.show_goal","kind":"fn","old":null,"new":"865ed49719c74ddf","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"/// The goal printed: its context, then `⊢` and the statement.\npub fn show_goal(g: kernel_dependent_tactics.Goal) -> String {\n  mut out := \"\"\n  for (x, ty) in g.context.reversed() {\n    out = out\n      + \"  \"\n      + x\n      + \" : \"\n      + kernel_dependent_tactics.show(ty, [])\n      + \"\\n\"\n  }\n  out + \"  ⊢ \" + kernel_dependent_tactics.show(g.target, [])\n}"},{"name":"kernel_dependent_tactics.failure","kind":"fn","old":null,"new":"6e1aca19984aa544","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"fn failure(g: kernel_dependent_tactics.Goal, m: String) -> String {\n  m\n    + \":\\n\"\n    + kernel_dependent_tactics.show_goal(\n      kernel_dependent_tactics.Goal {\n        ..g,\n        target: kernel_dependent_tactics.normal(\n          g.env,\n          len(g.context),\n          g.target,\n        ),\n      },\n    )\n}"},{"name":"kernel_dependent_tactics.show","kind":"fn","old":null,"new":"e33625fbdef8bf6f","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"/// `t` as text, `names` naming its loose bound variables (innermost first).\npub fn show(t: kernel_dependent.Term, names: List[String]) -> String {\n  match t {\n    kernel_dependent.Sort(0) => \"Type\",\n    kernel_dependent.Sort(l) => \"Type\" + to_string(l),\n    kernel_dependent.Bound(i) => get(names, i) ?? \"#\" + to_string(i),\n    kernel_dependent.Free(x) => x,\n    kernel_dependent.Constant { name, levels } => if levels == [] {\n      name\n    } else {\n      name + \".{\" + join(levels.map(l -> to_string(l)), \",\") + \"}\"\n    },\n    kernel_dependent.Pi { name, domain, body } => if kernel_dependent_tactics.uses(body, 0) {\n      \"Π (\"\n        + name\n        + \" : \"\n        + kernel_dependent_tactics.show(domain, names)\n        + \"), \"\n        + kernel_dependent_tactics.show(body, [name] + names)\n    } else {\n      kernel_dependent_tactics.atom(domain, names)\n        + \" → \"\n        + kernel_dependent_tactics.show(body, [\"_\"] + names)\n    },\n    kernel_dependent.Lambda { name, domain, body } => \"λ (\"\n      + name\n      + \" : \"\n      + kernel_dependent_tactics.show(domain, names)\n      + \"), \"\n      + kernel_dependent_tactics.show(body, [name] + names),\n    kernel_dependent.Apply { .. } => {\n      (h, args) := kernel_dependent.spine(t)\n      kernel_dependent_tactics.atom(h, names)\n        + join(\n          args.map(\n            a -> \" \" + kernel_dependent_tactics.atom(a, names),\n          ),\n          \"\",\n        )\n    },\n  }\n}"},{"name":"kernel_dependent_tactics.atom","kind":"fn","old":null,"new":"4bc6667b882e0436","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"fn atom(t: kernel_dependent.Term, names: List[String]) -> String {\n  match t {\n    kernel_dependent.Apply { .. } => \"(\" + kernel_dependent_tactics.show(t, names) + \")\",\n    kernel_dependent.Pi { .. } => \"(\" + kernel_dependent_tactics.show(t, names) + \")\",\n    kernel_dependent.Lambda { .. } => \"(\" + kernel_dependent_tactics.show(t, names) + \")\",\n    _ => kernel_dependent_tactics.show(t, names),\n  }\n}"},{"name":"kernel_dependent_tactics.uses","kind":"fn","old":null,"new":"060d8d0e7188bb94","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"fn uses(t: kernel_dependent.Term, depth: Int) -> Bool {\n  match t {\n    kernel_dependent.Bound(i) => i == depth,\n    kernel_dependent.Pi { domain, body, .. } => kernel_dependent_tactics.uses(domain, depth)\n      || kernel_dependent_tactics.uses(body, depth + 1),\n    kernel_dependent.Lambda { domain, body, .. } => kernel_dependent_tactics.uses(domain, depth)\n      || kernel_dependent_tactics.uses(body, depth + 1),\n    kernel_dependent.Apply { function, argument } => kernel_dependent_tactics.uses(function, depth)\n      || kernel_dependent_tactics.uses(argument, depth),\n    _ => false,\n  }\n}"},{"name":"kernel_dependent_tactics.normal","kind":"fn","old":null,"new":"30ae32bf9632559a","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"/// The normal form of `t`: reduced everywhere, under binders too.\npub fn normal(\n  env: kernel_dependent.Environment,\n  depth: Int,\n  t: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  w := kernel_dependent.whnf(env, t)\n  x := kernel_dependent.fresh(depth)\n  match w {\n    kernel_dependent.Pi { name, domain, body } => kernel_dependent.Pi {\n      name,\n      domain: kernel_dependent_tactics.normal(env, depth, domain),\n      body: kernel_dependent.abstract(kernel_dependent_tactics.normal(\n        env,\n        depth + 1,\n        kernel_dependent.instantiate(\n          body,\n          kernel_dependent.Free(x),\n          0,\n        ),\n      ), x, 0),\n    },\n    kernel_dependent.Lambda { name, domain, body } => kernel_dependent.Lambda {\n      name,\n      domain: kernel_dependent_tactics.normal(env, depth, domain),\n      body: kernel_dependent.abstract(kernel_dependent_tactics.normal(\n        env,\n        depth + 1,\n        kernel_dependent.instantiate(\n          body,\n          kernel_dependent.Free(x),\n          0,\n        ),\n      ), x, 0),\n    },\n    kernel_dependent.Apply { .. } => {\n      (h, args) := kernel_dependent.spine(w)\n      kernel_dependent.applied(\n        h,\n        args.map(\n          a -> kernel_dependent_tactics.normal(env, depth, a),\n        ),\n      )\n    },\n    _ => w,\n  }\n}"},{"name":"kernel_dependent_tactics.replaced","kind":"fn","old":null,"new":"315b578371af0143","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"/// `t` with each occurrence of `pattern` (no loose bound variables) as the\n/// free variable `x`.\npub fn replaced(\n  t: kernel_dependent.Term,\n  pattern: kernel_dependent.Term,\n  x: String,\n) -> kernel_dependent.Term {\n  if t == pattern {\n    return kernel_dependent.Free(x)\n  }\n  match t {\n    kernel_dependent.Pi { name, domain, body } => kernel_dependent.Pi {\n      name,\n      domain: kernel_dependent_tactics.replaced(domain, pattern, x),\n      body: kernel_dependent_tactics.replaced(body, pattern, x),\n    },\n    kernel_dependent.Lambda { name, domain, body } => kernel_dependent.Lambda {\n      name,\n      domain: kernel_dependent_tactics.replaced(domain, pattern, x),\n      body: kernel_dependent_tactics.replaced(body, pattern, x),\n    },\n    kernel_dependent.Apply { function, argument } => kernel_dependent.Apply {\n      function: kernel_dependent_tactics.replaced(function, pattern, x),\n      argument: kernel_dependent_tactics.replaced(argument, pattern, x),\n    },\n    _ => t,\n  }\n}"},{"name":"kernel_dependent_tactics.substituted","kind":"fn","old":null,"new":"0f910b4a90f3ea73","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"/// `t[u/x]` for the free variable `x`.\nfn substituted(\n  t: kernel_dependent.Term,\n  x: String,\n  u: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  kernel_dependent.instantiate(\n    kernel_dependent.abstract(t, x, 0),\n    u,\n    0,\n  )\n}"},{"name":"kernel_dependent_tactics.type_in","kind":"fn","old":null,"new":"b4554bd2bd3642e8","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"fn type_in(\n  g: kernel_dependent_tactics.Goal,\n  t: kernel_dependent.Term,\n) -> Result[kernel_dependent.Term, String] {\n  match kernel_dependent.infer(g.env, g.context, t) {\n    Ok(ty) => Ok(ty),\n    Err(m) => Err(kernel_dependent_tactics.failure(\n      g,\n      m + \" in `\" + kernel_dependent_tactics.show(t, []) + \"`\",\n    )),\n  }\n}"},{"name":"kernel_dependent_tactics.equation_parts","kind":"fn","old":null,"new":"94b076a3f6efacb4","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"/// `(l, A, a, b)` of `Eq.{l} A a b`.\nfn equation_parts(\n  env: kernel_dependent.Environment,\n  t: kernel_dependent.Term,\n) -> Option[(Int, kernel_dependent.Term, kernel_dependent.Term, kernel_dependent.Term)] {\n  match kernel_dependent.spine(kernel_dependent.whnf(env, t)) {\n    (kernel_dependent.Constant { name: \"Eq\", levels: [l] }, [a_type, a, b]) => Some((l, a_type, a, b)),\n    _ => None,\n  }\n}"},{"name":"kernel_dependent_tactics.intro","kind":"fn","old":null,"new":"48bf062965c3de9d","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"// ---- tactics ----\n\n/// `intro x`: the goal's `Π` taken as the variable or hypothesis `x`.\npub fn intro(\n  g: kernel_dependent_tactics.Goal,\n  x: String,\n  then: kernel_dependent_tactics.Then,\n) -> Result[kernel_dependent.Term, String] {\n  match kernel_dependent.whnf(g.env, g.target) {\n    kernel_dependent.Pi { domain, body, .. } => {\n      inner := then(kernel_dependent_tactics.Goal {\n        ..g,\n        context: [(x, domain)] + g.context,\n        target: kernel_dependent.instantiate(\n          body,\n          kernel_dependent.Free(x),\n          0,\n        ),\n      })!\n      Ok(kernel_dependent.lambda(x, domain, inner))\n    },\n    _ => Err(\n      kernel_dependent_tactics.failure(\n        g,\n        \"intro: the goal isn't a Π\",\n      ),\n    ),\n  }\n}"},{"name":"kernel_dependent_tactics.intros","kind":"fn","old":null,"new":"38f1a8ff21ba5b9b","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"/// `intro x y …`\npub fn intros(\n  g: kernel_dependent_tactics.Goal,\n  xs: List[String],\n  then: kernel_dependent_tactics.Then,\n) -> Result[kernel_dependent.Term, String] {\n  match xs {\n    [] => then(g),\n    [x, ..rest] => kernel_dependent_tactics.intro(\n      g,\n      x,\n      h -> kernel_dependent_tactics.intros(h, rest, then),\n    ),\n  }\n}"},{"name":"kernel_dependent_tactics.exact","kind":"fn","old":null,"new":"71e88303b952cdc6","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"/// `exact t`: `t` proves the goal, up to definitional equality.\npub fn exact(\n  g: kernel_dependent_tactics.Goal,\n  t: kernel_dependent.Term,\n) -> Result[kernel_dependent.Term, String] {\n  ty := kernel_dependent_tactics.type_in(g, t)!\n  if kernel_dependent.convertible(g.env, len(g.context), ty, g.target) {\n    Ok(t)\n  } else {\n    Err(kernel_dependent_tactics.failure(g, \"exact: `\"\n      + kernel_dependent_tactics.show(t, [])\n      + \"` proves `\"\n      + kernel_dependent_tactics.show(\n        kernel_dependent_tactics.normal(g.env, len(g.context), ty),\n        [],\n      )\n      + \"`\"))\n  }\n}"},{"name":"kernel_dependent_tactics.simplify","kind":"fn","old":null,"new":"a298ea8f8ac1167f","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"/// `simplify`: an equation whose sides are the same once definitions are\n/// unfolded and reduced, closed by `refl`.\npub fn simplify(\n  g: kernel_dependent_tactics.Goal,\n) -> Result[kernel_dependent.Term, String] {\n  match kernel_dependent_tactics.equation_parts(g.env, g.target) {\n    Some((l, a_type, a, b)) => if kernel_dependent.convertible(g.env, len(g.context), a, b) {\n      Ok(kernel_dependent.reflexivity(l, a_type, a))\n    } else {\n      Err(kernel_dependent_tactics.failure(\n        g,\n        \"simplify: the sides differ once unfolded\",\n      ))\n    },\n    None => Err(kernel_dependent_tactics.failure(\n      g,\n      \"simplify: the goal isn't an equation\",\n    )),\n  }\n}"},{"name":"kernel_dependent_tactics.rewrite","kind":"fn","old":null,"new":"2b0aef75ba3588aa","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"/// `rewrite e`: with `e : a = b`, each `a` of the goal (both in normal form)\n/// becomes `b`. The proof transports along `e` reversed, by `J`.\npub fn rewrite(\n  g: kernel_dependent_tactics.Goal,\n  e: kernel_dependent.Term,\n  then: kernel_dependent_tactics.Then,\n) -> Result[kernel_dependent.Term, String] {\n  (l, a_type, a, b) := kernel_dependent_tactics.equation_parts(\n    g.env,\n    kernel_dependent_tactics.type_in(g, e)!,\n  ) or {\n    return Err(kernel_dependent_tactics.failure(g, \"rewrite: `\"\n      + kernel_dependent_tactics.show(e, [])\n      + \"` isn't an equation\"))\n  }\n  depth := len(g.context)\n  target := kernel_dependent_tactics.normal(g.env, depth, g.target)\n  body := kernel_dependent_tactics.replaced(\n    target,\n    kernel_dependent_tactics.normal(g.env, depth, a),\n    \"#z\",\n  )\n  if body == target {\n    return Err(kernel_dependent_tactics.failure(g, \"rewrite: `\"\n      + kernel_dependent_tactics.show(\n        kernel_dependent_tactics.normal(g.env, depth, a),\n        [],\n      )\n      + \"` isn't in the goal\"))\n  }\n  m := kernel_dependent.sort_of(g.env, g.context, g.target) except msg {\n    return Err(kernel_dependent_tactics.failure(g, msg))\n  }\n  proof := then(kernel_dependent_tactics.Goal {\n    ..g,\n    target: kernel_dependent_tactics.substituted(body, \"#z\", b),\n  })!\n  z := kernel_dependent.Free(\"#z\")\n  motive := kernel_dependent.lambda(\"#z\", a_type, kernel_dependent.lambda(\n    \"#e\",\n    kernel_dependent.equality(l, a_type, b, z),\n    body,\n  ))\n  reversed := kernel_dependent.applied(\n    kernel_dependent.Constant { name: \"J\", levels: [l, l] },\n    [\n      a_type,\n      a,\n      kernel_dependent.lambda(\"#z\", a_type, kernel_dependent.lambda(\n        \"#e\",\n        kernel_dependent.equality(l, a_type, a, z),\n        kernel_dependent.equality(l, a_type, z, a),\n      )),\n      kernel_dependent.reflexivity(l, a_type, a),\n      b,\n      e,\n    ],\n  )\n  Ok(kernel_dependent.applied(\n    kernel_dependent.Constant { name: \"J\", levels: [l, m] },\n    [a_type, b, motive, proof, a, reversed],\n  ))\n}"},{"name":"kernel_dependent_tactics.funext","kind":"fn","old":null,"new":"8e373b571906c475","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"/// `funext x`: `f = g` between functions, from `f x = g x` for a new `x`.\npub fn funext(\n  g: kernel_dependent_tactics.Goal,\n  x: String,\n  then: kernel_dependent_tactics.Then,\n) -> Result[kernel_dependent.Term, String] {\n  (_, fty, f, h) := kernel_dependent_tactics.equation_parts(g.env, g.target) or {\n    return Err(kernel_dependent_tactics.failure(\n      g,\n      \"funext: the goal isn't an equation\",\n    ))\n  }\n  match kernel_dependent.whnf(g.env, fty) {\n    kernel_dependent.Pi { domain, body, .. } => {\n      bx := kernel_dependent.instantiate(\n        body,\n        kernel_dependent.Free(x),\n        0,\n      )\n      inner := [(x, domain)] + g.context\n      la := kernel_dependent.sort_of(g.env, g.context, domain)!\n      mb := kernel_dependent.sort_of(g.env, inner, bx)!\n      proof := then(kernel_dependent_tactics.Goal {\n        ..g,\n        context: inner,\n        target: kernel_dependent.equality(mb, bx, kernel_dependent.Apply {\n          function: f,\n          argument: kernel_dependent.Free(x),\n        }, kernel_dependent.Apply {\n          function: h,\n          argument: kernel_dependent.Free(x),\n        }),\n      })!\n      Ok(kernel_dependent.applied(\n        kernel_dependent.Constant {\n          name: \"funext\",\n          levels: [la, mb],\n        },\n        [\n          domain,\n          kernel_dependent.lambda(x, domain, bx),\n          f,\n          h,\n          kernel_dependent.lambda(x, domain, proof),\n        ],\n      ))\n    },\n    _ => Err(kernel_dependent_tactics.failure(\n      g,\n      \"funext: not an equation between functions\",\n    )),\n  }\n}"},{"name":"kernel_dependent_tactics.Case","kind":"type","old":null,"new":"d88ba824c96557ea","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"/// A case of `cases` or `induction`: names for the constructor's arguments\n/// (then, for `induction`, one per recursive argument for its hypothesis),\n/// and its proof.\npub type Case = { names: List[String], proof: kernel_dependent_tactics.Then }"},{"name":"kernel_dependent_tactics.cases","kind":"fn","old":null,"new":"e60d26d436e16176","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"/// `cases t`: one goal per constructor of `t`'s inductive type, with `t`\n/// (in normal form) replaced by the constructor applied to new variables.\n/// `equation`: the name of a hypothesis `t = c args` in each case (`\"\"`:\n/// none).\npub fn cases(\n  g: kernel_dependent_tactics.Goal,\n  t: kernel_dependent.Term,\n  equation: String,\n  cs: List[kernel_dependent_tactics.Case],\n) -> Result[kernel_dependent.Term, String] {\n  depth := len(g.context)\n  pattern := kernel_dependent_tactics.normal(g.env, depth, t)\n  body := kernel_dependent_tactics.replaced(\n    kernel_dependent_tactics.normal(g.env, depth, g.target),\n    pattern,\n    \"#z\",\n  )\n  kernel_dependent_tactics.eliminate(\n    g,\n    t,\n    body,\n    equation,\n    false,\n    cs,\n  )\n}"},{"name":"kernel_dependent_tactics.induction","kind":"fn","old":null,"new":"61ed29f97db0b683","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"/// `induction x`: `cases` on the variable `x`, with an induction hypothesis\n/// for each recursive argument (the goal is not normalized).\npub fn induction(\n  g: kernel_dependent_tactics.Goal,\n  x: String,\n  cs: List[kernel_dependent_tactics.Case],\n) -> Result[kernel_dependent.Term, String] {\n  kernel_dependent_tactics.eliminate(\n    g,\n    kernel_dependent.Free(x),\n    kernel_dependent_tactics.substituted(\n      g.target,\n      x,\n      kernel_dependent.Free(\"#z\"),\n    ),\n    \"\",\n    true,\n    cs,\n  )\n}"},{"name":"kernel_dependent_tactics.eliminate","kind":"fn","old":null,"new":"287a556cacba520e","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"fn eliminate(\n  g: kernel_dependent_tactics.Goal,\n  t: kernel_dependent.Term,\n  body: kernel_dependent.Term,\n  equation: String,\n  with_hypotheses: Bool,\n  cs: List[kernel_dependent_tactics.Case],\n) -> Result[kernel_dependent.Term, String] {\n  tty := kernel_dependent.whnf(\n    g.env,\n    kernel_dependent_tactics.type_in(g, t)!,\n  )\n  (head, params) := kernel_dependent.spine(tty)\n  ind := match head {\n    kernel_dependent.Constant { name, .. } => kernel_dependent.inductive_named(g.env, name) or {\n      return Err(kernel_dependent_tactics.failure(\n        g,\n        \"cases: `\" + name + \"` isn't an inductive type\",\n      ))\n    },\n    _ => return Err(kernel_dependent_tactics.failure(\n      g,\n      \"cases: not of an inductive type\",\n    )),\n  }\n  if len(cs) != len(ind.constructors) {\n    return Err(kernel_dependent_tactics.failure(g, \"cases: `\"\n      + ind.name\n      + \"` has \"\n      + to_string(len(ind.constructors))\n      + \" constructors\"))\n  }\n  z := kernel_dependent.Free(\"#z\")\n  goal_body := if equation == \"\" {\n    body\n  } else {\n    kernel_dependent.pi(\n      equation,\n      kernel_dependent.equality(ind.level, tty, t, z),\n      body,\n    )\n  }\n  m := kernel_dependent.sort_of(\n    g.env,\n    [(\"#z\", tty)] + g.context,\n    goal_body,\n  ) except msg {\n    return Err(kernel_dependent_tactics.failure(g, \"cases: \" + msg))\n  }\n  motive := kernel_dependent.lambda(\"#z\", tty, goal_body)\n  mut minors := []\n  for (k, c) in enumerate(ind.constructors) {\n    names := (get(cs, k) ?? kernel_dependent_tactics.Case {\n      names: [],\n      proof: _h -> Err(\"\"),\n    }).names\n    proves := (get(cs, k) ?? kernel_dependent_tactics.Case {\n      names: [],\n      proof: _h -> Err(\"\"),\n    }).proof\n    cty := kernel_dependent_tactics.type_in(g, kernel_dependent.applied(\n      kernel_dependent_tactics.constant(c.name),\n      params,\n    ))!\n    mut ctx := g.context\n    mut args := []\n    mut rest := cty\n    for (j, _) in enumerate(c.recursive) {\n      a := get(names, j) ?? \"#a\" + to_string(j)\n      match kernel_dependent.whnf(g.env, rest) {\n        kernel_dependent.Pi { domain, body: b, .. } => {\n          ctx = [(a, domain)] + ctx\n          mut args.push((a, domain))\n          rest = kernel_dependent.instantiate(\n            b,\n            kernel_dependent.Free(a),\n            0,\n          )\n        },\n        _ => return Err(\"cases: a constructor's type\"),\n      }\n    }\n    mut ihs := []\n    for (j, r) in enumerate(c.recursive) {\n      if r {\n        n := if with_hypotheses {\n          get(names, len(c.recursive) + len(ihs)) ?? \"#ih\" + to_string(j)\n        } else {\n          \"#ih\" + to_string(j)\n        }\n        ih := kernel_dependent_tactics.substituted(\n          goal_body,\n          \"#z\",\n          kernel_dependent.Free((get(args, j) ?? (\"\", z)).0),\n        )\n        ctx = [(n, ih)] + ctx\n        mut ihs.push((n, ih))\n      }\n    }\n    value := kernel_dependent.applied(\n      kernel_dependent_tactics.constant(c.name),\n      params + args.map(a -> kernel_dependent.Free(a.0)),\n    )\n    sub := kernel_dependent_tactics.Goal {\n      ..g,\n      context: ctx,\n      target: kernel_dependent_tactics.substituted(goal_body, \"#z\", value),\n    }\n    mut proof := if equation == \"\" {\n      proves(sub)!\n    } else {\n      kernel_dependent_tactics.intro(sub, equation, proves)!\n    }\n    for (n, ih) in ihs.reversed() {\n      proof = kernel_dependent.lambda(n, ih, proof)\n    }\n    for (a, d) in args.reversed() {\n      proof = kernel_dependent.lambda(a, d, proof)\n    }\n    mut minors.push(proof)\n  }\n  out := kernel_dependent.applied(\n    kernel_dependent.Constant {\n      name: ind.name + \".rec\",\n      levels: [m],\n    },\n    params + [motive] + minors + [t],\n  )\n  Ok(if equation == \"\" {\n    out\n  } else {\n    kernel_dependent.Apply {\n      function: out,\n      argument: kernel_dependent.reflexivity(ind.level, tty, t),\n    }\n  })\n}"},{"name":"kernel_dependent_tactics.subst","kind":"fn","old":null,"new":"1cff99d2fa11c7a5","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"/// `subst e`: with the hypothesis `e : a = y`, `y` a variable not in `a`,\n/// the goal with `a` for `y` and `refl` for `e` (by `J`).\npub fn subst(\n  g: kernel_dependent_tactics.Goal,\n  e: String,\n  then: kernel_dependent_tactics.Then,\n) -> Result[kernel_dependent.Term, String] {\n  (l, a_type, a, y) := kernel_dependent_tactics.equation_parts(\n    g.env,\n    kernel_dependent_tactics.type_in(g, kernel_dependent.Free(e))!,\n  ) or {\n    return Err(kernel_dependent_tactics.failure(\n      g,\n      \"subst: `\" + e + \"` isn't an equation\",\n    ))\n  }\n  yn := match y {\n    kernel_dependent.Free(n) => if kernel_dependent_tactics.replaced(a, y, \"#y\") == a {\n      n\n    } else {\n      return Err(kernel_dependent_tactics.failure(\n        g,\n        \"subst: `\" + n + \"` occurs in the other side\",\n      ))\n    },\n    _ => return Err(kernel_dependent_tactics.failure(\n      g,\n      \"subst: `\" + e + \"`'s right side isn't a variable\",\n    )),\n  }\n  body := kernel_dependent_tactics.substituted(\n    kernel_dependent_tactics.substituted(\n      g.target,\n      e,\n      kernel_dependent.Free(\"#e\"),\n    ),\n    yn,\n    kernel_dependent.Free(\"#y\"),\n  )\n  equation := kernel_dependent.equality(\n    l,\n    a_type,\n    a,\n    kernel_dependent.Free(\"#y\"),\n  )\n  m := kernel_dependent.sort_of(\n    g.env,\n    [(\"#e\", equation), (\"#y\", a_type)] + g.context,\n    body,\n  )!\n  proof := then(kernel_dependent_tactics.Goal {\n    ..g,\n    target: kernel_dependent_tactics.substituted(\n      kernel_dependent_tactics.substituted(body, \"#y\", a),\n      \"#e\",\n      kernel_dependent.reflexivity(l, a_type, a),\n    ),\n  })!\n  Ok(kernel_dependent.applied(\n    kernel_dependent.Constant { name: \"J\", levels: [l, m] },\n    [a_type, a, kernel_dependent.lambda(\n      \"#y\",\n      a_type,\n      kernel_dependent.lambda(\"#e\", equation, body),\n    ), proof, y, kernel_dependent.Free(e)],\n  ))\n}"},{"name":"kernel_dependent_tactics.prove","kind":"fn","old":null,"new":"0142436edb3902af","interface_changed":true,"affected":[],"module":"kernel_dependent_tactics","text":"/// The proof of `statement` by `tactic`, checked: the environment with it\n/// as the law `name`.\npub fn prove(\n  env: kernel_dependent.Environment,\n  name: String,\n  statement: kernel_dependent.Term,\n  tactic: kernel_dependent_tactics.Then,\n) -> Result[kernel_dependent.Environment, String] {\n  proof := tactic(kernel_dependent_tactics.Goal {\n    env,\n    context: [],\n    target: statement,\n  })!\n  kernel_dependent.define(env, name, statement, proof)\n}"}]}
{"id":"1324c1f496da8302","time":1795849246,"message":"new kernel_dependent_patch","changes":[{"name":"kernel_dependent_patch.use kernel_dependent","kind":"use","old":null,"new":"c969a8e63ab669c1","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"// kernel_dependent_patch: Patch's laws for every record, in the dependently\n// typed kernel. A record type is a schema: a type of field names `F`, each\n// field's type `ty f`, and equality of names decided (`deq`). A record is\n// a dependent map `(f: F) -> ty f`, `x.(f.name)` is `x f`, and `Patch[T]`\n// is `(f: F) -> Change (ty f)`, from its type function. The laws are proven\n// once, over every schema; `User`'s are instances, with no proof of their\n// own.\n\nuse kernel_dependent"},{"name":"kernel_dependent_patch.use kernel_dependent_tactics","kind":"use","old":null,"new":"4b54360bd1505a56","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"use kernel_dependent_tactics"},{"name":"kernel_dependent_patch.use ast","kind":"use","old":null,"new":"b163563165f5c0fd","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"use ast"},{"name":"kernel_dependent_patch.use kernel_translate","kind":"use","old":null,"new":"1e2ff157c322a9ed","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"use kernel_translate"},{"name":"kernel_dependent_patch.use std.time","kind":"use","old":null,"new":"b7e476d428f6913f","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"from std.time use SystemClock, Clock"},{"name":"kernel_dependent_patch.use std.typing","kind":"use","old":null,"new":"05f7f79803b87f5f","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"use std.typing"},{"name":"kernel_dependent_patch.Checked","kind":"type","old":null,"new":"74bebe49c05d087e","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"/// A law proven, with how long its proof took to build and check.\npub type Checked = { name: String, ns: Int }"},{"name":"kernel_dependent_patch.c","kind":"fn","old":null,"new":"78de379e8f983f45","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"fn c(name: String) -> kernel_dependent.Term {\n  kernel_dependent.Constant { name, levels: [] }\n}"},{"name":"kernel_dependent_patch.v","kind":"fn","old":null,"new":"ecee21cb9b1a2122","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"fn v(name: String) -> kernel_dependent.Term {\n  kernel_dependent.Free(name)\n}"},{"name":"kernel_dependent_patch.at","kind":"fn","old":null,"new":"1b12bd25c3786144","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"fn at(\n  f: kernel_dependent.Term,\n  args: List[kernel_dependent.Term],\n) -> kernel_dependent.Term {\n  kernel_dependent.applied(f, args)\n}"},{"name":"kernel_dependent_patch.rec","kind":"fn","old":null,"new":"7db8e9f636c29f1c","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"fn rec(name: String, level: Int) -> kernel_dependent.Term {\n  kernel_dependent.Constant { name: name + \".rec\", levels: [level] }\n}"},{"name":"kernel_dependent_patch.arrow","kind":"fn","old":null,"new":"3a23e9232a3ac2c0","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"/// `a → b`, `b` not depending on the argument.\nfn arrow(\n  a: kernel_dependent.Term,\n  b: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  kernel_dependent.Pi { name: \"_\", domain: a, body: b }\n}"},{"name":"kernel_dependent_patch.pis","kind":"fn","old":null,"new":"45781db05464609f","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"fn pis(\n  ps: List[(String, kernel_dependent.Term)],\n  body: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  mut out := body\n  for (x, d) in ps.reversed() {\n    out = kernel_dependent.pi(x, d, out)\n  }\n  out\n}"},{"name":"kernel_dependent_patch.lambdas","kind":"fn","old":null,"new":"f242bab1dddf30d4","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"fn lambdas(\n  ps: List[(String, kernel_dependent.Term)],\n  body: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  mut out := body\n  for (x, d) in ps.reversed() {\n    out = kernel_dependent.lambda(x, d, out)\n  }\n  out\n}"},{"name":"kernel_dependent_patch.eq0","kind":"fn","old":null,"new":"fb70660c5d8eab30","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"fn eq0(\n  a_type: kernel_dependent.Term,\n  a: kernel_dependent.Term,\n  b: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  kernel_dependent.equality(0, a_type, a, b)\n}"},{"name":"kernel_dependent_patch.base","kind":"fn","old":null,"new":"030a358c1c06e45e","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"// ---- the base: types every schema uses ----\n\n/// `Empty`, `Unit`, `Bool`, `List`, `Change`, `Dec`, and `ite`, `or`,\n/// `is_yes`, `change`.\npub fn base(\n  env: kernel_dependent.Environment,\n) -> Result[kernel_dependent.Environment, String] {\n  t := kernel_dependent.Sort(0)\n  a := kernel_dependent_patch.v(\"A\")\n  mut e := kernel_dependent.add_inductive(env, \"Empty\", t, 0, [])!\n  e = kernel_dependent.add_inductive(\n    e,\n    \"Unit\",\n    t,\n    0,\n    [(\"star\", kernel_dependent_patch.c(\"Unit\"))],\n  )!\n  e = kernel_dependent.add_inductive(e, \"Bool\", t, 0, [\n    (\"true\", kernel_dependent_patch.c(\"Bool\")),\n    (\"false\", kernel_dependent_patch.c(\"Bool\")),\n  ])!\n  list := kernel_dependent.Apply {\n    function: kernel_dependent_patch.c(\"List\"),\n    argument: a,\n  }\n  e = kernel_dependent.add_inductive(\n    e,\n    \"List\",\n    kernel_dependent_patch.arrow(t, t),\n    1,\n    [\n      (\"nil\", kernel_dependent.pi(\"A\", t, list)),\n      (\"cons\", kernel_dependent_patch.pis(\n        [(\"A\", t), (\"h\", a), (\"rest\", list)],\n        list,\n      )),\n    ],\n  )!\n  change := kernel_dependent.Apply {\n    function: kernel_dependent_patch.c(\"Change\"),\n    argument: a,\n  }\n  e = kernel_dependent.add_inductive(\n    e,\n    \"Change\",\n    kernel_dependent_patch.arrow(t, t),\n    1,\n    [(\"Keep\", kernel_dependent.pi(\"A\", t, change)), (\n      \"Set\",\n      kernel_dependent_patch.pis([(\"A\", t), (\"v\", a)], change),\n    )],\n  )!\n  p := kernel_dependent_patch.v(\"P\")\n  dec := kernel_dependent.Apply {\n    function: kernel_dependent_patch.c(\"Dec\"),\n    argument: p,\n  }\n  e = kernel_dependent.add_inductive(\n    e,\n    \"Dec\",\n    kernel_dependent_patch.arrow(t, t),\n    1,\n    [\n      (\"yes\", kernel_dependent_patch.pis([(\"P\", t), (\"h\", p)], dec)),\n      (\"no\", kernel_dependent_patch.pis(\n        [(\"P\", t), (\"h\", kernel_dependent_patch.arrow(\n          p,\n          kernel_dependent_patch.c(\"Empty\"),\n        ))],\n        dec,\n      )),\n    ],\n  )!\n  bool := kernel_dependent_patch.c(\"Bool\")\n  e = kernel_dependent.define(e, \"ite\", kernel_dependent_patch.pis(\n    [(\"A\", t), (\"b\", bool), (\"x\", a), (\"y\", a)],\n    a,\n  ), kernel_dependent_patch.lambdas(\n    [(\"A\", t), (\"b\", bool), (\"x\", a), (\"y\", a)],\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(\"Bool\", 0),\n      [\n        kernel_dependent.lambda(\"_b\", bool, a),\n        kernel_dependent_patch.v(\"x\"),\n        kernel_dependent_patch.v(\"y\"),\n        kernel_dependent_patch.v(\"b\"),\n      ],\n    ),\n  ))!\n  e = kernel_dependent.define(e, \"or\", kernel_dependent_patch.arrow(\n    bool,\n    kernel_dependent_patch.arrow(bool, bool),\n  ), kernel_dependent_patch.lambdas(\n    [(\"a\", bool), (\"b\", bool)],\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(\"Bool\", 0),\n      [\n        kernel_dependent.lambda(\"_b\", bool, bool),\n        kernel_dependent_patch.c(\"true\"),\n        kernel_dependent_patch.v(\"b\"),\n        kernel_dependent_patch.v(\"a\"),\n      ],\n    ),\n  ))!\n  e = kernel_dependent.define(e, \"is_yes\", kernel_dependent_patch.pis(\n    [(\"P\", t)],\n    kernel_dependent_patch.arrow(dec, bool),\n  ), kernel_dependent_patch.lambdas(\n    [(\"P\", t), (\"d\", dec)],\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(\"Dec\", 0),\n      [\n        p,\n        kernel_dependent.lambda(\"_d\", dec, bool),\n        kernel_dependent.lambda(\n          \"_h\",\n          p,\n          kernel_dependent_patch.c(\"true\"),\n        ),\n        kernel_dependent.lambda(\"_h\", kernel_dependent_patch.arrow(\n          p,\n          kernel_dependent_patch.c(\"Empty\"),\n        ), kernel_dependent_patch.c(\"false\")),\n        kernel_dependent_patch.v(\"d\"),\n      ],\n    ),\n  ))!\n  kernel_dependent.define(e, \"change\", kernel_dependent_patch.pis(\n    [(\"A\", t), (\"c\", change), (\"old\", a)],\n    a,\n  ), kernel_dependent_patch.lambdas(\n    [(\"A\", t), (\"c\", change), (\"old\", a)],\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(\"Change\", 0),\n      [\n        a,\n        kernel_dependent.lambda(\"_c\", change, a),\n        kernel_dependent_patch.v(\"old\"),\n        kernel_dependent.lambda(\n          \"v\",\n          a,\n          kernel_dependent_patch.v(\"v\"),\n        ),\n        kernel_dependent_patch.v(\"c\"),\n      ],\n    ),\n  ))\n}"},{"name":"kernel_dependent_patch.schema","kind":"fn","old":null,"new":"66b833bec284f74f","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"// ---- over every schema ----\n\n/// `F`, `ty` and `deq`: what describes a record type.\nfn schema() -> List[(String, kernel_dependent.Term)] {\n  [\n    (\"F\", kernel_dependent.Sort(0)),\n    (\"ty\", kernel_dependent_patch.arrow(\n      kernel_dependent_patch.v(\"F\"),\n      kernel_dependent.Sort(0),\n    )),\n    (\"deq\", kernel_dependent.pi(\n      \"a\",\n      kernel_dependent_patch.v(\"F\"),\n      kernel_dependent.pi(\n        \"b\",\n        kernel_dependent_patch.v(\"F\"),\n        kernel_dependent.Apply {\n          function: kernel_dependent_patch.c(\"Dec\"),\n          argument: kernel_dependent_patch.eq0(\n            kernel_dependent_patch.v(\"F\"),\n            kernel_dependent_patch.v(\"a\"),\n            kernel_dependent_patch.v(\"b\"),\n          ),\n        },\n      ),\n    )),\n  ]\n}"},{"name":"kernel_dependent_patch.s","kind":"fn","old":null,"new":"62f8c035f33f404b","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"/// A constant defined over the schema, taken at the schema in scope.\nfn s(name: String) -> kernel_dependent.Term {\n  kernel_dependent_patch.at(kernel_dependent_patch.c(name), [\n    kernel_dependent_patch.v(\"F\"),\n    kernel_dependent_patch.v(\"ty\"),\n    kernel_dependent_patch.v(\"deq\"),\n  ])\n}"},{"name":"kernel_dependent_patch.ty","kind":"fn","old":null,"new":"b0d8dc298fa344ba","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"fn ty(f: kernel_dependent.Term) -> kernel_dependent.Term {\n  kernel_dependent.Apply {\n    function: kernel_dependent_patch.v(\"ty\"),\n    argument: f,\n  }\n}"},{"name":"kernel_dependent_patch.record","kind":"fn","old":null,"new":"5c44220a92b2a1f2","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"/// `(g: F) -> ty g`: a record.\nfn record() -> kernel_dependent.Term {\n  kernel_dependent.pi(\n    \"g\",\n    kernel_dependent_patch.v(\"F\"),\n    kernel_dependent_patch.ty(kernel_dependent_patch.v(\"g\")),\n  )\n}"},{"name":"kernel_dependent_patch.fields","kind":"fn","old":null,"new":"ff8ebb238cf41c78","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"fn fields() -> kernel_dependent.Term {\n  kernel_dependent.Apply {\n    function: kernel_dependent_patch.c(\"List\"),\n    argument: kernel_dependent_patch.v(\"F\"),\n  }\n}"},{"name":"kernel_dependent_patch.ite","kind":"fn","old":null,"new":"097c77826cdbc71a","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"fn ite(\n  a_type: kernel_dependent.Term,\n  b: kernel_dependent.Term,\n  x: kernel_dependent.Term,\n  y: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  kernel_dependent_patch.at(\n    kernel_dependent_patch.c(\"ite\"),\n    [a_type, b, x, y],\n  )\n}"},{"name":"kernel_dependent_patch.change","kind":"fn","old":null,"new":"3ca62148926970b7","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"fn change(\n  a_type: kernel_dependent.Term,\n  ch: kernel_dependent.Term,\n  old: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  kernel_dependent_patch.at(\n    kernel_dependent_patch.c(\"change\"),\n    [a_type, ch, old],\n  )\n}"},{"name":"kernel_dependent_patch.patch_value","kind":"fn","old":null,"new":"4e01a82dc4ff67b9","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"/// `λ g. change (ty g) (p g) (x g)`: `patched`'s field values.\nfn patch_value(\n  p: kernel_dependent.Term,\n  x: kernel_dependent.Term,\n) -> kernel_dependent.Term {\n  kernel_dependent.lambda(\n    \"pg\",\n    kernel_dependent_patch.v(\"F\"),\n    kernel_dependent_patch.change(\n      kernel_dependent_patch.ty(kernel_dependent_patch.v(\"pg\")),\n      kernel_dependent.Apply {\n        function: p,\n        argument: kernel_dependent_patch.v(\"pg\"),\n      },\n      kernel_dependent.Apply {\n        function: x,\n        argument: kernel_dependent_patch.v(\"pg\"),\n      },\n    ),\n  )\n}"},{"name":"kernel_dependent_patch.define_generic","kind":"fn","old":null,"new":"5e36aaa9047ba884","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"fn define_generic(\n  e: kernel_dependent.Environment,\n  name: String,\n  ps: List[(String, kernel_dependent.Term)],\n  result: kernel_dependent.Term,\n  body: kernel_dependent.Term,\n) -> Result[kernel_dependent.Environment, String] {\n  kernel_dependent.define(e, name, kernel_dependent_patch.pis(\n    kernel_dependent_patch.schema() + ps,\n    result,\n  ), kernel_dependent_patch.lambdas(\n    kernel_dependent_patch.schema() + ps,\n    body,\n  ))\n}"},{"name":"kernel_dependent_patch.definitions","kind":"fn","old":null,"new":"b2bf02b3c508eb48","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"/// `Patch`, `updated`, `made`, `has`, `patched`, `step` and `applied`.\npub fn definitions(\n  env: kernel_dependent.Environment,\n) -> Result[kernel_dependent.Environment, String] {\n  f := kernel_dependent_patch.v(\"F\")\n  r := kernel_dependent_patch.record()\n  mut e := kernel_dependent_patch.define_generic(\n    env,\n    \"Patch\",\n    [],\n    kernel_dependent.Sort(0),\n    kernel_dependent.pi(\"f\", f, kernel_dependent.Apply {\n      function: kernel_dependent_patch.c(\"Change\"),\n      argument: kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n    }),\n  )!\n  ef := kernel_dependent_patch.eq0(\n    f,\n    kernel_dependent_patch.v(\"f\"),\n    kernel_dependent_patch.v(\"g\"),\n  )\n  e = kernel_dependent_patch.define_generic(e, \"updated\", [\n    (\"r\", r),\n    (\"f\", f),\n    (\"v\", kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\"))),\n  ], r, kernel_dependent.lambda(\n    \"g\",\n    f,\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(\"Dec\", 0),\n      [\n        ef,\n        kernel_dependent.lambda(\"_d\", kernel_dependent.Apply {\n          function: kernel_dependent_patch.c(\"Dec\"),\n          argument: ef,\n        }, kernel_dependent_patch.ty(kernel_dependent_patch.v(\"g\"))),\n        kernel_dependent.lambda(\"e\", ef, kernel_dependent_patch.at(\n          kernel_dependent.Constant { name: \"J\", levels: [0, 0] },\n          [\n            f,\n            kernel_dependent_patch.v(\"f\"),\n            kernel_dependent_patch.lambdas(\n              [(\"z\", f), (\"_e\", kernel_dependent_patch.eq0(\n                f,\n                kernel_dependent_patch.v(\"f\"),\n                kernel_dependent_patch.v(\"z\"),\n              ))],\n              kernel_dependent_patch.ty(\n                kernel_dependent_patch.v(\"z\"),\n              ),\n            ),\n            kernel_dependent_patch.v(\"v\"),\n            kernel_dependent_patch.v(\"g\"),\n            kernel_dependent_patch.v(\"e\"),\n          ],\n        )),\n        kernel_dependent.lambda(\"n\", kernel_dependent_patch.arrow(\n          ef,\n          kernel_dependent_patch.c(\"Empty\"),\n        ), kernel_dependent.Apply {\n          function: kernel_dependent_patch.v(\"r\"),\n          argument: kernel_dependent_patch.v(\"g\"),\n        }),\n        kernel_dependent_patch.at(kernel_dependent_patch.v(\"deq\"), [\n          kernel_dependent_patch.v(\"f\"),\n          kernel_dependent_patch.v(\"g\"),\n        ]),\n      ],\n    ),\n  ))!\n  e = kernel_dependent_patch.define_generic(e, \"made\", [\n    (\"fs\", kernel_dependent_patch.fields()),\n    (\"value\", r),\n    (\"base\", r),\n  ], r, kernel_dependent_patch.at(kernel_dependent_patch.rec(\"List\", 0), [\n    f,\n    kernel_dependent.lambda(\n      \"_l\",\n      kernel_dependent_patch.fields(),\n      r,\n    ),\n    kernel_dependent_patch.v(\"base\"),\n    kernel_dependent_patch.lambdas(\n      [\n        (\"x\", f),\n        (\"rest\", kernel_dependent_patch.fields()),\n        (\"ih\", r),\n      ],\n      kernel_dependent_patch.at(\n        kernel_dependent_patch.s(\"updated\"),\n        [\n          kernel_dependent_patch.v(\"ih\"),\n          kernel_dependent_patch.v(\"x\"),\n          kernel_dependent.Apply {\n            function: kernel_dependent_patch.v(\"value\"),\n            argument: kernel_dependent_patch.v(\"x\"),\n          },\n        ],\n      ),\n    ),\n    kernel_dependent_patch.v(\"fs\"),\n  ]))!\n  e = kernel_dependent_patch.define_generic(\n    e,\n    \"has\",\n    [(\"fs\", kernel_dependent_patch.fields()), (\"g\", f)],\n    kernel_dependent_patch.c(\"Bool\"),\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(\"List\", 0),\n      [f, kernel_dependent.lambda(\n        \"_l\",\n        kernel_dependent_patch.fields(),\n        kernel_dependent_patch.c(\"Bool\"),\n      ), kernel_dependent_patch.c(\"false\"), kernel_dependent_patch.lambdas([\n        (\"x\", f),\n        (\"rest\", kernel_dependent_patch.fields()),\n        (\"ih\", kernel_dependent_patch.c(\"Bool\")),\n      ], kernel_dependent_patch.at(\n        kernel_dependent_patch.c(\"or\"),\n        [kernel_dependent_patch.at(\n          kernel_dependent_patch.c(\"is_yes\"),\n          [kernel_dependent_patch.eq0(\n            f,\n            kernel_dependent_patch.v(\"x\"),\n            kernel_dependent_patch.v(\"g\"),\n          ), kernel_dependent_patch.at(\n            kernel_dependent_patch.v(\"deq\"),\n            [\n              kernel_dependent_patch.v(\"x\"),\n              kernel_dependent_patch.v(\"g\"),\n            ],\n          )],\n        ), kernel_dependent_patch.v(\"ih\")],\n      )), kernel_dependent_patch.v(\"fs\")],\n    ),\n  )!\n  patch := kernel_dependent_patch.s(\"Patch\")\n  e = kernel_dependent_patch.define_generic(\n    e,\n    \"patched\",\n    [\n      (\"fs\", kernel_dependent_patch.fields()),\n      (\"x\", r),\n      (\"p\", patch),\n    ],\n    r,\n    kernel_dependent_patch.at(kernel_dependent_patch.s(\"made\"), [\n      kernel_dependent_patch.v(\"fs\"),\n      kernel_dependent_patch.patch_value(\n        kernel_dependent_patch.v(\"p\"),\n        kernel_dependent_patch.v(\"x\"),\n      ),\n      kernel_dependent_patch.v(\"x\"),\n    ]),\n  )!\n  e = kernel_dependent_patch.define_generic(\n    e,\n    \"step\",\n    [(\"f\", f), (\"c\", kernel_dependent.Apply {\n      function: kernel_dependent_patch.c(\"Change\"),\n      argument: kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n    }), (\"x\", r)],\n    r,\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(\"Change\", 0),\n      [\n        kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n        kernel_dependent.lambda(\"_c\", kernel_dependent.Apply {\n          function: kernel_dependent_patch.c(\"Change\"),\n          argument: kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n        }, r),\n        kernel_dependent_patch.v(\"x\"),\n        kernel_dependent.lambda(\n          \"v\",\n          kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n          kernel_dependent_patch.at(\n            kernel_dependent_patch.s(\"updated\"),\n            [\n              kernel_dependent_patch.v(\"x\"),\n              kernel_dependent_patch.v(\"f\"),\n              kernel_dependent_patch.v(\"v\"),\n            ],\n          ),\n        ),\n        kernel_dependent_patch.v(\"c\"),\n      ],\n    ),\n  )!\n  kernel_dependent_patch.define_generic(\n    e,\n    \"applied\",\n    [\n      (\"fs\", kernel_dependent_patch.fields()),\n      (\"x\", r),\n      (\"p\", patch),\n    ],\n    r,\n    kernel_dependent.Apply { function: kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(\"List\", 0),\n      [\n        f,\n        kernel_dependent.lambda(\n          \"_l\",\n          kernel_dependent_patch.fields(),\n          kernel_dependent_patch.arrow(r, r),\n        ),\n        kernel_dependent.lambda(\n          \"y\",\n          r,\n          kernel_dependent_patch.v(\"y\"),\n        ),\n        kernel_dependent_patch.lambdas([\n          (\"x\", f),\n          (\"rest\", kernel_dependent_patch.fields()),\n          (\"ih\", kernel_dependent_patch.arrow(r, r)),\n          (\"y\", r),\n        ], kernel_dependent.Apply {\n          function: kernel_dependent_patch.v(\"ih\"),\n          argument: kernel_dependent_patch.at(\n            kernel_dependent_patch.s(\"step\"),\n            [kernel_dependent_patch.v(\"x\"), kernel_dependent.Apply {\n              function: kernel_dependent_patch.v(\"p\"),\n              argument: kernel_dependent_patch.v(\"x\"),\n            }, kernel_dependent_patch.v(\"y\")],\n          ),\n        }),\n        kernel_dependent_patch.v(\"fs\"),\n      ],\n    ), argument: kernel_dependent_patch.v(\"x\") },\n  )\n}"},{"name":"kernel_dependent_patch.schema_names","kind":"fn","old":null,"new":"3e1c0b8b354995fe","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"fn schema_names() -> List[String] {\n  kernel_dependent_patch.schema().map(p -> p.0)\n}"},{"name":"kernel_dependent_patch.timed","kind":"fn","old":null,"new":"7d1b97bf662ebf3a","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"fn timed(\n  clock: std.time.SystemClock,\n  mut out: List[kernel_dependent_patch.Checked],\n  env: kernel_dependent.Environment,\n  name: String,\n  ps: List[(String, kernel_dependent.Term)],\n  statement: kernel_dependent.Term,\n  tactic: (kernel_dependent_tactics.Goal) -> Result[kernel_dependent.Term, String],\n) -> Result[kernel_dependent.Environment, String] {\n  t0 := clock.now().value\n  e := kernel_dependent_tactics.prove(\n    env,\n    name,\n    kernel_dependent_patch.pis(\n      kernel_dependent_patch.schema() + ps,\n      statement,\n    ),\n    tactic,\n  ) except m { return Err(\"`\" + name + \"`: \" + m) }\n  mut out.push(\n    kernel_dependent_patch.Checked {\n      name,\n      ns: clock.now().value - t0,\n    },\n  )\n  Ok(e)\n}"},{"name":"kernel_dependent_patch.laws","kind":"fn","old":null,"new":"0c245f7cbafdbffa","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"/// `made_at`, `patched_nothing`, `patched_set`, `patched_keep`, `applied_at`\n/// and `applied_is_patched`, each proven once for every schema.\npub fn laws(\n  clock: std.time.SystemClock,\n  mut out: List[kernel_dependent_patch.Checked],\n  env: kernel_dependent.Environment,\n) -> Result[kernel_dependent.Environment, String] {\n  f := kernel_dependent_patch.v(\"F\")\n  r := kernel_dependent_patch.record()\n  patch := kernel_dependent_patch.s(\"Patch\")\n  x := kernel_dependent_patch.v(\"x\")\n  p := kernel_dependent_patch.v(\"p\")\n  g := kernel_dependent_patch.v(\"g\")\n  bool := kernel_dependent_patch.c(\"Bool\")\n  made_at := (fs: kernel_dependent.Term, value: kernel_dependent.Term, b: kernel_dependent.Term, h: kernel_dependent.Term) ->\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.s(\"made_at\"),\n      [fs, value, b, h],\n    )\n  mut e := kernel_dependent_patch.timed(clock, mut out, env, \"made_at\", [\n    (\"fs\", kernel_dependent_patch.fields()),\n    (\"value\", r),\n    (\"base\", r),\n    (\"g\", f),\n  ], kernel_dependent_patch.eq0(\n    kernel_dependent_patch.ty(g),\n    kernel_dependent.Apply {\n      function: kernel_dependent_patch.at(kernel_dependent_patch.s(\"made\"), [\n        kernel_dependent_patch.v(\"fs\"),\n        kernel_dependent_patch.v(\"value\"),\n        kernel_dependent_patch.v(\"base\"),\n      ]),\n      argument: g,\n    },\n    kernel_dependent_patch.ite(\n      kernel_dependent_patch.ty(g),\n      kernel_dependent_patch.at(\n        kernel_dependent_patch.s(\"has\"),\n        [kernel_dependent_patch.v(\"fs\"), g],\n      ),\n      kernel_dependent.Apply {\n        function: kernel_dependent_patch.v(\"value\"),\n        argument: g,\n      },\n      kernel_dependent.Apply {\n        function: kernel_dependent_patch.v(\"base\"),\n        argument: g,\n      },\n    ),\n  ), gl -> kernel_dependent_tactics.intros(\n    gl,\n    kernel_dependent_patch.schema_names() + [\"fs\"],\n    g1 -> kernel_dependent_tactics.induction(\n      g1,\n      \"fs\",\n      [kernel_dependent_tactics.Case {\n        names: [],\n        proof: g2 -> kernel_dependent_tactics.intros(\n          g2,\n          [\"value\", \"base\", \"g\"],\n          kernel_dependent_tactics.simplify,\n        ),\n      }, kernel_dependent_tactics.Case {\n        names: [\"y\", \"rest\", \"ih\"],\n        proof: g2 -> kernel_dependent_tactics.intros(\n          g2,\n          [\"value\", \"base\", \"g\"],\n          g3 -> kernel_dependent_tactics.cases(\n            g3,\n            kernel_dependent_patch.at(\n              kernel_dependent_patch.v(\"deq\"),\n              [kernel_dependent_patch.v(\"y\"), g],\n            ),\n            \"\",\n            [kernel_dependent_tactics.Case {\n              names: [\"e\"],\n              proof: g4 -> kernel_dependent_tactics.subst(\n                g4,\n                \"e\",\n                kernel_dependent_tactics.simplify,\n              ),\n            }, kernel_dependent_tactics.Case {\n              names: [\"n\"],\n              proof: g4 -> kernel_dependent_tactics.exact(\n                g4,\n                kernel_dependent_patch.at(\n                  kernel_dependent_patch.v(\"ih\"),\n                  [\n                    kernel_dependent_patch.v(\"value\"),\n                    kernel_dependent_patch.v(\"base\"),\n                    g,\n                  ],\n                ),\n              ),\n            }],\n          ),\n        ),\n      }],\n    ),\n  ))!\n  keep_all := kernel_dependent.lambda(\"kg\", f, kernel_dependent.Apply {\n    function: kernel_dependent_patch.c(\"Keep\"),\n    argument: kernel_dependent_patch.ty(kernel_dependent_patch.v(\"kg\")),\n  })\n  e = kernel_dependent_patch.timed(\n    clock,\n    mut out,\n    e,\n    \"patched_nothing\",\n    [(\"fs\", kernel_dependent_patch.fields()), (\"x\", r)],\n    kernel_dependent_patch.eq0(r, kernel_dependent_patch.at(\n      kernel_dependent_patch.s(\"patched\"),\n      [kernel_dependent_patch.v(\"fs\"), x, keep_all],\n    ), x),\n    gl -> kernel_dependent_tactics.intros(\n      gl,\n      kernel_dependent_patch.schema_names() + [\"fs\", \"x\"],\n      g1 -> kernel_dependent_tactics.funext(\n        g1,\n        \"g\",\n        g2 -> kernel_dependent_tactics.rewrite(g2, made_at(\n          kernel_dependent_patch.v(\"fs\"),\n          kernel_dependent_patch.patch_value(keep_all, x),\n          x,\n          g,\n        ), g3 -> kernel_dependent_tactics.cases(\n          g3,\n          kernel_dependent_patch.at(\n            kernel_dependent_patch.s(\"has\"),\n            [kernel_dependent_patch.v(\"fs\"), g],\n          ),\n          \"\",\n          [kernel_dependent_tactics.Case {\n            names: [],\n            proof: kernel_dependent_tactics.simplify,\n          }, kernel_dependent_tactics.Case {\n            names: [],\n            proof: kernel_dependent_tactics.simplify,\n          }],\n        )),\n      ),\n    ),\n  )!\n  changes := (fv: kernel_dependent.Term) -> kernel_dependent.Apply {\n    function: kernel_dependent_patch.c(\"Change\"),\n    argument: kernel_dependent_patch.ty(fv),\n  }\n  e = kernel_dependent_patch.timed(clock, mut out, e, \"patched_set\", [\n    (\"fs\", kernel_dependent_patch.fields()),\n    (\"x\", r),\n    (\"p\", patch),\n    (\"f\", f),\n    (\"v\", kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\"))),\n    (\n      \"h1\",\n      kernel_dependent_patch.eq0(\n        bool,\n        kernel_dependent_patch.at(kernel_dependent_patch.s(\"has\"), [\n          kernel_dependent_patch.v(\"fs\"),\n          kernel_dependent_patch.v(\"f\"),\n        ]),\n        kernel_dependent_patch.c(\"true\"),\n      ),\n    ),\n    (\"h2\", kernel_dependent_patch.eq0(\n      changes(kernel_dependent_patch.v(\"f\")),\n      kernel_dependent.Apply {\n        function: p,\n        argument: kernel_dependent_patch.v(\"f\"),\n      },\n      kernel_dependent_patch.at(kernel_dependent_patch.c(\"Set\"), [\n        kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n        kernel_dependent_patch.v(\"v\"),\n      ]),\n    )),\n  ], kernel_dependent_patch.eq0(\n    kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n    kernel_dependent.Apply { function: kernel_dependent_patch.at(\n      kernel_dependent_patch.s(\"patched\"),\n      [kernel_dependent_patch.v(\"fs\"), x, p],\n    ), argument: kernel_dependent_patch.v(\"f\") },\n    kernel_dependent_patch.v(\"v\"),\n  ), gl -> kernel_dependent_tactics.intros(\n    gl,\n    kernel_dependent_patch.schema_names()\n      + [\"fs\", \"x\", \"p\", \"f\", \"v\", \"h1\", \"h2\"],\n    g1 -> kernel_dependent_tactics.rewrite(g1, made_at(\n      kernel_dependent_patch.v(\"fs\"),\n      kernel_dependent_patch.patch_value(p, x),\n      x,\n      kernel_dependent_patch.v(\"f\"),\n    ), g2 -> kernel_dependent_tactics.rewrite(\n      g2,\n      kernel_dependent_patch.v(\"h1\"),\n      g3 -> kernel_dependent_tactics.rewrite(\n        g3,\n        kernel_dependent_patch.v(\"h2\"),\n        kernel_dependent_tactics.simplify,\n      ),\n    )),\n  ))!\n  both_simplify := [kernel_dependent_tactics.Case {\n    names: [],\n    proof: kernel_dependent_tactics.simplify,\n  }, kernel_dependent_tactics.Case {\n    names: [],\n    proof: kernel_dependent_tactics.simplify,\n  }]\n  e = kernel_dependent_patch.timed(clock, mut out, e, \"patched_keep\", [\n    (\"fs\", kernel_dependent_patch.fields()),\n    (\"x\", r),\n    (\"p\", patch),\n    (\"f\", f),\n    (\"h\", kernel_dependent_patch.eq0(\n      changes(kernel_dependent_patch.v(\"f\")),\n      kernel_dependent.Apply {\n        function: p,\n        argument: kernel_dependent_patch.v(\"f\"),\n      },\n      kernel_dependent.Apply {\n        function: kernel_dependent_patch.c(\"Keep\"),\n        argument: kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n      },\n    )),\n  ], kernel_dependent_patch.eq0(\n    kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n    kernel_dependent.Apply { function: kernel_dependent_patch.at(\n      kernel_dependent_patch.s(\"patched\"),\n      [kernel_dependent_patch.v(\"fs\"), x, p],\n    ), argument: kernel_dependent_patch.v(\"f\") },\n    kernel_dependent.Apply {\n      function: x,\n      argument: kernel_dependent_patch.v(\"f\"),\n    },\n  ), gl -> kernel_dependent_tactics.intros(\n    gl,\n    kernel_dependent_patch.schema_names()\n      + [\"fs\", \"x\", \"p\", \"f\", \"h\"],\n    g1 -> kernel_dependent_tactics.rewrite(g1, made_at(\n      kernel_dependent_patch.v(\"fs\"),\n      kernel_dependent_patch.patch_value(p, x),\n      x,\n      kernel_dependent_patch.v(\"f\"),\n    ), g2 -> kernel_dependent_tactics.rewrite(\n      g2,\n      kernel_dependent_patch.v(\"h\"),\n      g3 -> kernel_dependent_tactics.cases(\n        g3,\n        kernel_dependent_patch.at(kernel_dependent_patch.s(\"has\"), [\n          kernel_dependent_patch.v(\"fs\"),\n          kernel_dependent_patch.v(\"f\"),\n        ]),\n        \"\",\n        both_simplify,\n      ),\n    )),\n  ))!\n  // a field `f` equal to `g`, after `apply`'s step on `f`: `h` says what `p f` is\n  same_field := (g4: kernel_dependent_tactics.Goal) ->\n    kernel_dependent_tactics.subst(\n      g4,\n      \"e\",\n      g5 -> kernel_dependent_tactics.rewrite(\n        g5,\n        kernel_dependent_patch.v(\"h\"),\n        g6 -> kernel_dependent_tactics.cases(\n          g6,\n          kernel_dependent_patch.at(\n            kernel_dependent_patch.s(\"has\"),\n            [\n              kernel_dependent_patch.v(\"rest\"),\n              kernel_dependent_patch.v(\"y\"),\n            ],\n          ),\n          \"\",\n          both_simplify,\n        ),\n      ),\n    )\n  split_field := (g3: kernel_dependent_tactics.Goal) ->\n    kernel_dependent_tactics.cases(g3, kernel_dependent_patch.at(\n      kernel_dependent_patch.v(\"deq\"),\n      [kernel_dependent_patch.v(\"y\"), g],\n    ), \"\", [kernel_dependent_tactics.Case {\n      names: [\"e\"],\n      proof: same_field,\n    }, kernel_dependent_tactics.Case {\n      names: [\"n\"],\n      proof: kernel_dependent_tactics.simplify,\n    }])\n  e = kernel_dependent_patch.timed(clock, mut out, e, \"applied_at\", [\n    (\"p\", patch),\n    (\"fs\", kernel_dependent_patch.fields()),\n    (\"x\", r),\n    (\"g\", f),\n  ], kernel_dependent_patch.eq0(\n    kernel_dependent_patch.ty(g),\n    kernel_dependent.Apply { function: kernel_dependent_patch.at(\n      kernel_dependent_patch.s(\"applied\"),\n      [kernel_dependent_patch.v(\"fs\"), x, p],\n    ), argument: g },\n    kernel_dependent_patch.ite(\n      kernel_dependent_patch.ty(g),\n      kernel_dependent_patch.at(\n        kernel_dependent_patch.s(\"has\"),\n        [kernel_dependent_patch.v(\"fs\"), g],\n      ),\n      kernel_dependent_patch.change(\n        kernel_dependent_patch.ty(g),\n        kernel_dependent.Apply { function: p, argument: g },\n        kernel_dependent.Apply { function: x, argument: g },\n      ),\n      kernel_dependent.Apply { function: x, argument: g },\n    ),\n  ), gl -> kernel_dependent_tactics.intros(\n    gl,\n    kernel_dependent_patch.schema_names() + [\"p\", \"fs\"],\n    g1 -> kernel_dependent_tactics.induction(\n      g1,\n      \"fs\",\n      [kernel_dependent_tactics.Case {\n        names: [],\n        proof: g2 -> kernel_dependent_tactics.intros(\n          g2,\n          [\"x\", \"g\"],\n          kernel_dependent_tactics.simplify,\n        ),\n      }, kernel_dependent_tactics.Case {\n        names: [\"y\", \"rest\", \"ih\"],\n        proof: g2 -> kernel_dependent_tactics.intros(\n          g2,\n          [\"x\", \"g\"],\n          g3 -> kernel_dependent_tactics.rewrite(\n            g3,\n            kernel_dependent_patch.at(\n              kernel_dependent_patch.v(\"ih\"),\n              [kernel_dependent_patch.at(\n                kernel_dependent_patch.s(\"step\"),\n                [\n                  kernel_dependent_patch.v(\"y\"),\n                  kernel_dependent.Apply {\n                    function: p,\n                    argument: kernel_dependent_patch.v(\"y\"),\n                  },\n                  x,\n                ],\n              ), g],\n            ),\n            g4 -> kernel_dependent_tactics.cases(\n              g4,\n              kernel_dependent.Apply {\n                function: p,\n                argument: kernel_dependent_patch.v(\"y\"),\n              },\n              \"h\",\n              [kernel_dependent_tactics.Case {\n                names: [],\n                proof: split_field,\n              }, kernel_dependent_tactics.Case {\n                names: [\"v\"],\n                proof: split_field,\n              }],\n            ),\n          ),\n        ),\n      }],\n    ),\n  ))!\n  kernel_dependent_patch.timed(\n    clock,\n    mut out,\n    e,\n    \"applied_is_patched\",\n    [\n      (\"fs\", kernel_dependent_patch.fields()),\n      (\"x\", r),\n      (\"p\", patch),\n    ],\n    kernel_dependent_patch.eq0(r, kernel_dependent_patch.at(\n      kernel_dependent_patch.s(\"applied\"),\n      [kernel_dependent_patch.v(\"fs\"), x, p],\n    ), kernel_dependent_patch.at(\n      kernel_dependent_patch.s(\"patched\"),\n      [kernel_dependent_patch.v(\"fs\"), x, p],\n    )),\n    gl -> kernel_dependent_tactics.intros(\n      gl,\n      kernel_dependent_patch.schema_names() + [\"fs\", \"x\", \"p\"],\n      g1 -> kernel_dependent_tactics.funext(\n        g1,\n        \"g\",\n        g2 -> kernel_dependent_tactics.rewrite(\n          g2,\n          kernel_dependent_patch.at(\n            kernel_dependent_patch.s(\"applied_at\"),\n            [p, kernel_dependent_patch.v(\"fs\"), x, g],\n          ),\n          g3 -> kernel_dependent_tactics.rewrite(g3, made_at(\n            kernel_dependent_patch.v(\"fs\"),\n            kernel_dependent_patch.patch_value(p, x),\n            x,\n            g,\n          ), kernel_dependent_tactics.simplify),\n        ),\n      ),\n    ),\n  )\n}"},{"name":"kernel_dependent_patch.core_type","kind":"fn","old":null,"new":"d439cca1ed796c21","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"// ---- records of a Strata module, as schemas ----\n\n/// A type value as a type of the kernel: by its name and arguments, a\n/// name the environment lacks declared as an opaque type (a refinement is\n/// dropped).\nfn core_type(\n  mut env: kernel_dependent.Environment,\n  t: std.typing.Type,\n) -> Result[kernel_dependent.Term, String] {\n  name := match t.name {\n    Some(\"Natural\") | Some(\"Positive\") => \"Int\",\n    Some(n) => n,\n    None => return Err(\"a type with no name: `\" + t.written + \"`\"),\n  }\n  mut args := []\n  for a in t.args {\n    mut args.push(kernel_dependent_patch.core_type(mut env, a)!)\n  }\n  if kernel_dependent.lookup(env, name) == None {\n    if args != [] {\n      return Err(\"`\" + name + \"`: an unknown type with arguments\")\n    }\n    env = kernel_dependent.declare(env, name, kernel_dependent.Sort(0))!\n  }\n  Ok(\n    kernel_dependent_patch.at(kernel_dependent_patch.c(name), args),\n  )\n}"},{"name":"kernel_dependent_patch.add_schema","kind":"fn","old":null,"new":"b98af7286856dc9e","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"/// The record `t` with fields `names` of types `types` as a schema:\n/// `t.Field` (a constructor per field), `t.ty`, `t.fields`, `t.deq`\n/// (decided by computation), `t` itself and `Patch[t]`. Each is checked by\n/// the kernel; none is a proof about Patch.\nfn add_schema(\n  env: kernel_dependent.Environment,\n  t: String,\n  names: List[String],\n  types: List[kernel_dependent.Term],\n) -> Result[kernel_dependent.Environment, String] {\n  field := t + \".Field\"\n  ft := kernel_dependent_patch.c(field)\n  ctors := names.map(n -> kernel_dependent_patch.c(t + \".\" + n))\n  mut e := kernel_dependent.add_inductive(\n    env,\n    field,\n    kernel_dependent.Sort(0),\n    0,\n    names.map(n -> (t + \".\" + n, ft)),\n  )!\n  e = kernel_dependent.define(\n    e,\n    t + \".ty\",\n    kernel_dependent_patch.arrow(ft, kernel_dependent.Sort(0)),\n    kernel_dependent.lambda(\"f\", ft, kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(field, 1),\n      [\n          kernel_dependent.lambda(\n            \"_f\",\n            ft,\n            kernel_dependent.Sort(0),\n          ),\n        ]\n        + types\n        + [kernel_dependent_patch.v(\"f\")],\n    )),\n  )!\n  mut list := kernel_dependent_patch.at(kernel_dependent_patch.c(\"nil\"), [ft])\n  for k in ctors.reversed() {\n    list = kernel_dependent_patch.at(\n      kernel_dependent_patch.c(\"cons\"),\n      [ft, k, list],\n    )\n  }\n  e = kernel_dependent.define(e, t + \".fields\", kernel_dependent.Apply {\n    function: kernel_dependent_patch.c(\"List\"),\n    argument: ft,\n  }, list)!\n  code := (i: Int) ->\n    kernel_dependent.lambda(\"z\", ft, kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(field, 1),\n      [\n          kernel_dependent.lambda(\n            \"_f\",\n            ft,\n            kernel_dependent.Sort(0),\n          ),\n        ]\n        + enumerate(ctors).map(\n          k -> if k.0 == i {\n            kernel_dependent_patch.c(\"Unit\")\n          } else {\n            kernel_dependent_patch.c(\"Empty\")\n          },\n        )\n        + [kernel_dependent_patch.v(\"z\")],\n    ))\n  mut minors := []\n  for (i, ci) in enumerate(ctors) {\n    mut inner := []\n    for (j, cj) in enumerate(ctors) {\n      mut inner.push(\n        if i == j {\n          kernel_dependent_patch.at(\n            kernel_dependent_patch.c(\"yes\"),\n            [\n              kernel_dependent_patch.eq0(ft, ci, cj),\n              kernel_dependent.reflexivity(0, ft, ci),\n            ],\n          )\n        } else {\n          kernel_dependent_patch.at(\n            kernel_dependent_patch.c(\"no\"),\n            [\n              kernel_dependent_patch.eq0(ft, ci, cj),\n              kernel_dependent.lambda(\n                \"e\",\n                kernel_dependent_patch.eq0(ft, ci, cj),\n                kernel_dependent_patch.at(\n                  kernel_dependent.Constant {\n                    name: \"J\",\n                    levels: [0, 0],\n                  },\n                  [\n                    ft,\n                    ci,\n                    kernel_dependent_patch.lambdas(\n                      [(\"z\", ft), (\"_e\", kernel_dependent_patch.eq0(\n                        ft,\n                        ci,\n                        kernel_dependent_patch.v(\"z\"),\n                      ))],\n                      kernel_dependent.Apply {\n                        function: code(i),\n                        argument: kernel_dependent_patch.v(\"z\"),\n                      },\n                    ),\n                    kernel_dependent_patch.c(\"star\"),\n                    cj,\n                    kernel_dependent_patch.v(\"e\"),\n                  ],\n                ),\n              ),\n            ],\n          )\n        },\n      )\n    }\n    mut minors.push(\n      kernel_dependent_patch.at(\n        kernel_dependent_patch.rec(field, 0),\n        [\n            kernel_dependent.lambda(\n              \"b2\",\n              ft,\n              kernel_dependent.Apply {\n                function: kernel_dependent_patch.c(\"Dec\"),\n                argument: kernel_dependent_patch.eq0(\n                  ft,\n                  ci,\n                  kernel_dependent_patch.v(\"b2\"),\n                ),\n              },\n            ),\n          ]\n          + inner\n          + [kernel_dependent_patch.v(\"b\")],\n      ),\n    )\n  }\n  e = kernel_dependent.define(e, t + \".deq\", kernel_dependent.pi(\n    \"a\",\n    ft,\n    kernel_dependent.pi(\"b\", ft, kernel_dependent.Apply {\n      function: kernel_dependent_patch.c(\"Dec\"),\n      argument: kernel_dependent_patch.eq0(\n        ft,\n        kernel_dependent_patch.v(\"a\"),\n        kernel_dependent_patch.v(\"b\"),\n      ),\n    }),\n  ), kernel_dependent_patch.lambdas(\n    [(\"a\", ft), (\"b\", ft)],\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.rec(field, 0),\n      [kernel_dependent.lambda(\"a2\", ft, kernel_dependent.Apply {\n          function: kernel_dependent_patch.c(\"Dec\"),\n          argument: kernel_dependent_patch.eq0(\n            ft,\n            kernel_dependent_patch.v(\"a2\"),\n            kernel_dependent_patch.v(\"b\"),\n          ),\n        })]\n        + minors\n        + [kernel_dependent_patch.v(\"a\")],\n    ),\n  ))!\n  e = kernel_dependent.define(\n    e,\n    t,\n    kernel_dependent.Sort(0),\n    kernel_dependent.pi(\"f\", ft, kernel_dependent.Apply {\n      function: kernel_dependent_patch.c(t + \".ty\"),\n      argument: kernel_dependent_patch.v(\"f\"),\n    }),\n  )!\n  kernel_dependent.define(\n    e,\n    \"Patch[\" + t + \"]\",\n    kernel_dependent.Sort(0),\n    kernel_dependent_patch.at(\n      kernel_dependent_patch.c(\"Patch\"),\n      kernel_dependent_patch.at_schema(t),\n    ),\n  )\n}"},{"name":"kernel_dependent_patch.at_schema","kind":"fn","old":null,"new":"176c5f1060536f58","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"fn at_schema(t: String) -> List[kernel_dependent.Term] {\n  [\n    kernel_dependent_patch.c(t + \".Field\"),\n    kernel_dependent_patch.c(t + \".ty\"),\n    kernel_dependent_patch.c(t + \".deq\"),\n  ]\n}"},{"name":"kernel_dependent_patch.Instances","kind":"type","old":null,"new":"1de41d9eaea3592c","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"/// What instantiating the laws at a record gave: the environment, and per\n/// instance its name and statement.\npub type Instances = {\n  env: kernel_dependent.Environment,\n  statements: List[(String, String)],\n}"},{"name":"kernel_dependent_patch.instances","kind":"fn","old":null,"new":"86269f1034ea8dca","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"/// The laws at the record `t` (its fields `names` of types `types`), by\n/// application alone: each law's instance, and for each field the\n/// `patched_set` and `patched_keep` instances with `has` decided by\n/// computation.\nfn instances(\n  env: kernel_dependent.Environment,\n  t: String,\n  names: List[String],\n  types: List[kernel_dependent.Term],\n) -> Result[kernel_dependent_patch.Instances, String] {\n  mut e := env\n  mut out := []\n  sc := kernel_dependent_patch.at_schema(t)\n  fs := kernel_dependent_patch.c(t + \".fields\")\n  for name in [\"patched_nothing\", \"applied_is_patched\"] {\n    value := kernel_dependent_patch.at(\n      kernel_dependent_patch.c(name),\n      sc + [fs],\n    )\n    ty := kernel_dependent.infer(e, [], value)!\n    e = kernel_dependent.define(e, t + \".\" + name, ty, value)!\n    mut out.push(\n      (t + \".\" + name, kernel_dependent_tactics.show(ty, [])),\n    )\n  }\n  rt := kernel_dependent_patch.c(t)\n  pt := kernel_dependent_patch.c(\"Patch[\" + t + \"]\")\n  for (i, n) in enumerate(names) {\n    fi := kernel_dependent_patch.c(t + \".\" + n)\n    vt := get(types, i) ?? kernel_dependent.Sort(0)\n    pf := kernel_dependent.Apply {\n      function: kernel_dependent_patch.v(\"p\"),\n      argument: fi,\n    }\n    patched_at := kernel_dependent.Apply { function: kernel_dependent_patch.at(\n      kernel_dependent_patch.c(\"patched\"),\n      sc\n        + [\n          fs,\n          kernel_dependent_patch.v(\"x\"),\n          kernel_dependent_patch.v(\"p\"),\n        ],\n    ), argument: fi }\n    set_ty := kernel_dependent_patch.pis([\n      (\"x\", rt),\n      (\"p\", pt),\n      (\"v\", vt),\n      (\"h\", kernel_dependent_patch.eq0(kernel_dependent.Apply {\n        function: kernel_dependent_patch.c(\"Change\"),\n        argument: vt,\n      }, pf, kernel_dependent_patch.at(\n        kernel_dependent_patch.c(\"Set\"),\n        [vt, kernel_dependent_patch.v(\"v\")],\n      ))),\n    ], kernel_dependent_patch.eq0(\n      vt,\n      patched_at,\n      kernel_dependent_patch.v(\"v\"),\n    ))\n    set_value := kernel_dependent_patch.lambdas([\n      (\"x\", rt),\n      (\"p\", pt),\n      (\"v\", vt),\n      (\"h\", kernel_dependent_patch.eq0(kernel_dependent.Apply {\n        function: kernel_dependent_patch.c(\"Change\"),\n        argument: vt,\n      }, pf, kernel_dependent_patch.at(\n        kernel_dependent_patch.c(\"Set\"),\n        [vt, kernel_dependent_patch.v(\"v\")],\n      ))),\n    ], kernel_dependent_patch.at(\n      kernel_dependent_patch.c(\"patched_set\"),\n      sc\n        + [\n          fs,\n          kernel_dependent_patch.v(\"x\"),\n          kernel_dependent_patch.v(\"p\"),\n          fi,\n          kernel_dependent_patch.v(\"v\"),\n          kernel_dependent.reflexivity(\n            0,\n            kernel_dependent_patch.c(\"Bool\"),\n            kernel_dependent_patch.c(\"true\"),\n          ),\n          kernel_dependent_patch.v(\"h\"),\n        ],\n    ))\n    e = kernel_dependent.define(\n      e,\n      t + \".patched_set.\" + n,\n      set_ty,\n      set_value,\n    )!\n    mut out.push(\n      (\n        t + \".patched_set.\" + n,\n        kernel_dependent_tactics.show(set_ty, []),\n      ),\n    )\n  }\n  Ok(kernel_dependent_patch.Instances { env: e, statements: out })\n}"},{"name":"kernel_dependent_patch.records","kind":"fn","old":null,"new":"2f98dede4bc0618e","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"/// Each record of `decls` (no type parameters) as a schema, with the laws'\n/// instances; a record `Patch[T]` made by the type function is checked to\n/// be `Patch` at `T`'s schema, field by field, by computation.\npub fn records(\n  env: kernel_dependent.Environment,\n  decls: List[ast.Decl],\n) -> Result[kernel_dependent_patch.Instances, String] {\n  thy := kernel_translate.empty_theory()\n  mut e := env\n  mut out := []\n  mut values := []\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(td) => if td.params == [] {\n        t := kernel_translate.type_value(thy, td)\n        if t.kind == std.typing.Record {\n          mut values.push(t)\n        }\n      },\n      _ => (),\n    }\n  }\n  for t in values {\n    name := t.name ?? \"\"\n    if starts_with(name, \"Patch[\") {\n      continue\n    }\n    mut types := []\n    for f in t.fields {\n      mut types.push(kernel_dependent_patch.core_type(mut e, f.type)!)\n    }\n    names := t.fields.map(f -> f.name)\n    e = kernel_dependent_patch.add_schema(e, name, names, types)!\n    r := kernel_dependent_patch.instances(e, name, names, types)!\n    e = r.env\n    out += r.statements\n    for p in values {\n      if p.name == Some(\"Patch[\" + name + \"]\") {\n        patch := kernel_dependent.whnf(\n          e,\n          kernel_dependent_patch.c(\"Patch[\" + name + \"]\"),\n        )\n        for (i, f) in enumerate(p.fields) {\n          made := kernel_dependent_patch.core_type(mut e, f.type)!\n          generic := match patch {\n            kernel_dependent.Pi { body, .. } => kernel_dependent.instantiate(\n              body,\n              kernel_dependent_patch.c(\n                name + \".\" + (get(names, i) ?? \"\"),\n              ),\n              0,\n            ),\n            _ => return Err(\"`Patch[\" + name + \"]` isn't a Π\"),\n          }\n          if get(names, i) != Some(f.name)\n            || !kernel_dependent.convertible(e, 0, made, generic) {\n            return Err(\"`Patch[\"\n              + name\n              + \"]`'s field `\"\n              + f.name\n              + \"` isn't `Patch`'s at `\"\n              + name\n              + \"`\")\n          }\n        }\n        mut out.push(\n          (\n            \"Patch[\" + name + \"]\",\n            \"made by the type function: its fields are `Patch`'s at `\"\n              + name\n              + \"`, by computation\",\n          ),\n        )\n      }\n    }\n  }\n  Ok(kernel_dependent_patch.Instances { env: e, statements: out })\n}"}]}
{"id":"4eb0e656977e08a0","time":1795849286,"message":"edit","changes":[{"name":"kernel_cli.command","kind":"fn","old":"a71952672d79d647","new":"d818c762c3b81d89","interface_changed":false,"affected":[],"module":"kernel_cli","text":"/// `strata kernel check FILE…` (each theorem proven or the step that\n/// failed, with the time the check took) and `strata kernel goals FILE…`\n/// (the statements, for writing proofs). `--z3-arith`: `omega` asks Z3\n/// instead (marked as its oracle), to compare. 0 when every theorem with a\n/// proof is proven.\npub fn command(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  mut cmds: std.process.Commands,\n  clock: std.time.SystemClock,\n  solver: String,\n  home: String,\n  args: List[String],\n) -> std.process.ExitCode {\n  sub := get(args, 0) ?? \"\"\n  z3_arith := contains(args, \"--z3-arith\")\n  paths := drop(args, 1).filter(a -> !starts_with(a, \"--\"))\n  if sub == \"dependent\" {\n    return kernel_cli.dependent(mut console, files, clock, home, paths)\n  }\n  if sub != \"check\" && sub != \"goals\" || len(paths) == 0 {\n    mut console.write(\n      \"usage: strata kernel (check | goals) [--z3-arith] FILE...\\n       strata kernel dependent [FILE.strata...]\\n\",\n    )\n    return 2\n  }\n  base := kernel_cli.base_theory(mut cmds, files, clock, home, solver) except m {\n    mut console.write(\"the base theory: \" + m + \"\\n\")\n    return 2\n  }\n  mut console.write(\n    f\"core/int.kp: {base.int_lemmas} lemmas proven ({kernel_cli.milliseconds(base.int_ns)})\\n\",\n  )\n  mut code := 0\n  for path in paths {\n    src := if ends_with(path, \".strata\") {\n      \"\"\n    } else {\n      files.read(path) except {\n        mut console.write(path + \": can't read it\\n\")\n        code = 2\n        continue\n      }\n    }\n    t0 := clock.now().value\n    // a module file holds laws written as Strata; a `.kp` file, a script\n    outcomes := if ends_with(path, \".strata\") {\n      match files.read_bytes(path) {\n        Ok(bytes) => match binary.read(bytes) {\n          Ok(img) => match kernel_cli.made_in(\n            img.decls,\n            kernel_cli.typing_decls(files, home),\n          ) {\n            Ok(ds) => kernel_cli.check_module(\n              mut cmds,\n              clock,\n              solver,\n              ds,\n              sub == \"goals\",\n              base,\n              z3_arith,\n            ),\n            Err(m) => Err(m),\n          },\n          Err(m) => Err(m),\n        },\n        Err(_) => Err(\"can't read it\"),\n      }\n    } else {\n      kernel_cli.check_source(\n        mut cmds,\n        clock,\n        solver,\n        src,\n        sub == \"goals\",\n        base,\n        z3_arith,\n      )\n    }\n    t1 := clock.now().value\n    match outcomes {\n      Ok((os, notes, _)) => {\n        mut console.write(\"== \" + path + \"\\n\")\n        for n in notes {\n          mut console.write(\"note: \" + n + \"\\n\")\n        }\n        mut proven := 0\n        mut failed := 0\n        mut open := 0\n        for o in os {\n          line := match o.verdict {\n            \"proven\" => {\n              proven += 1\n              \"proven \"\n                + o.name\n                + \" (\"\n                + kernel_cli.milliseconds(o.ns)\n                + \")\"\n                + o.detail\n            },\n            \"open\" => {\n              open += 1\n              \"open   \" + o.name + \"\\n\" + o.detail\n            },\n            \"goal\" => o.name + \"\\n\" + o.detail,\n            _ => {\n              failed += 1\n              code = 1\n              \"failed \"\n                + o.name\n                + \" (\"\n                + kernel_cli.milliseconds(o.ns)\n                + \"): \"\n                + o.detail\n            },\n          }\n          mut console.write(line + \"\\n\")\n        }\n        if sub == \"check\" {\n          mut console.write(\n            f\"{proven} proven, {failed} failed, {open} open ({kernel_cli.milliseconds(t1 - t0)} in all)\\n\",\n          )\n        }\n      },\n      Err(m) => {\n        mut console.write(path + \": \" + m + \"\\n\")\n        code = 2\n      },\n    }\n  }\n  code\n}","old_text":"/// `strata kernel check FILE…` (each theorem proven or the step that\n/// failed, with the time the check took) and `strata kernel goals FILE…`\n/// (the statements, for writing proofs). `--z3-arith`: `omega` asks Z3\n/// instead (marked as its oracle), to compare. 0 when every theorem with a\n/// proof is proven.\npub fn command(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  mut cmds: std.process.Commands,\n  clock: std.time.SystemClock,\n  solver: String,\n  home: String,\n  args: List[String],\n) -> std.process.ExitCode {\n  sub := get(args, 0) ?? \"\"\n  z3_arith := contains(args, \"--z3-arith\")\n  paths := drop(args, 1).filter(a -> !starts_with(a, \"--\"))\n  if sub != \"check\" && sub != \"goals\" || len(paths) == 0 {\n    mut console.write(\n      \"usage: strata kernel (check | goals) [--z3-arith] FILE...\\n\",\n    )\n    return 2\n  }\n  base := kernel_cli.base_theory(mut cmds, files, clock, home, solver) except m {\n    mut console.write(\"the base theory: \" + m + \"\\n\")\n    return 2\n  }\n  mut console.write(\n    f\"core/int.kp: {base.int_lemmas} lemmas proven ({kernel_cli.milliseconds(base.int_ns)})\\n\",\n  )\n  mut code := 0\n  for path in paths {\n    src := if ends_with(path, \".strata\") {\n      \"\"\n    } else {\n      files.read(path) except {\n        mut console.write(path + \": can't read it\\n\")\n        code = 2\n        continue\n      }\n    }\n    t0 := clock.now().value\n    // a module file holds laws written as Strata; a `.kp` file, a script\n    outcomes := if ends_with(path, \".strata\") {\n      match files.read_bytes(path) {\n        Ok(bytes) => match binary.read(bytes) {\n          Ok(img) => match kernel_cli.made_in(\n            img.decls,\n            kernel_cli.typing_decls(files, home),\n          ) {\n            Ok(ds) => kernel_cli.check_module(\n              mut cmds,\n              clock,\n              solver,\n              ds,\n              sub == \"goals\",\n              base,\n              z3_arith,\n            ),\n            Err(m) => Err(m),\n          },\n          Err(m) => Err(m),\n        },\n        Err(_) => Err(\"can't read it\"),\n      }\n    } else {\n      kernel_cli.check_source(\n        mut cmds,\n        clock,\n        solver,\n        src,\n        sub == \"goals\",\n        base,\n        z3_arith,\n      )\n    }\n    t1 := clock.now().value\n    match outcomes {\n      Ok((os, notes, _)) => {\n        mut console.write(\"== \" + path + \"\\n\")\n        for n in notes {\n          mut console.write(\"note: \" + n + \"\\n\")\n        }\n        mut proven := 0\n        mut failed := 0\n        mut open := 0\n        for o in os {\n          line := match o.verdict {\n            \"proven\" => {\n              proven += 1\n              \"proven \"\n                + o.name\n                + \" (\"\n                + kernel_cli.milliseconds(o.ns)\n                + \")\"\n                + o.detail\n            },\n            \"open\" => {\n              open += 1\n              \"open   \" + o.name + \"\\n\" + o.detail\n            },\n            \"goal\" => o.name + \"\\n\" + o.detail,\n            _ => {\n              failed += 1\n              code = 1\n              \"failed \"\n                + o.name\n                + \" (\"\n                + kernel_cli.milliseconds(o.ns)\n                + \"): \"\n                + o.detail\n            },\n          }\n          mut console.write(line + \"\\n\")\n        }\n        if sub == \"check\" {\n          mut console.write(\n            f\"{proven} proven, {failed} failed, {open} open ({kernel_cli.milliseconds(t1 - t0)} in all)\\n\",\n          )\n        }\n      },\n      Err(m) => {\n        mut console.write(path + \": \" + m + \"\\n\")\n        code = 2\n      },\n    }\n  }\n  code\n}"},{"name":"kernel_cli.use kernel_dependent","kind":"use","old":null,"new":"a8e0a7e93d19cbc7","interface_changed":true,"affected":[],"module":"kernel_cli","text":"use kernel_dependent"},{"name":"kernel_cli.use kernel_dependent_patch","kind":"use","old":null,"new":"034019ddb006fd55","interface_changed":true,"affected":[],"module":"kernel_cli","text":"use kernel_dependent_patch"},{"name":"kernel_cli.dependent","kind":"fn","old":null,"new":"24f903a9e0c0990a","interface_changed":true,"affected":[],"module":"kernel_cli","text":"/// `strata kernel dependent [FILE.strata…]`: Patch's laws proven once, for\n/// every record, in the dependently typed kernel (kernel_dependent), each\n/// with the time its proof took to build and check; then each file's\n/// records as schemas, with the laws' instances at them.\nfn dependent(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  home: String,\n  paths: List[String],\n) -> std.process.ExitCode {\n  t0 := clock.now().value\n  mut checked := []\n  built := match kernel_dependent_patch.base(kernel_dependent.empty_environment()) {\n    Ok(e) => match kernel_dependent_patch.definitions(e) {\n      Ok(e2) => kernel_dependent_patch.laws(clock, mut checked, e2),\n      Err(m) => Err(m),\n    },\n    Err(m) => Err(m),\n  }\n  t1 := clock.now().value\n  env := built except m {\n    mut console.write(\"failed: \" + m + \"\\n\")\n    return 1\n  }\n  for k in checked {\n    mut console.write(\n      \"proven \"\n        + k.name\n        + \" (\"\n        + kernel_cli.milliseconds(k.ns)\n        + \")\\n\",\n    )\n  }\n  mut console.write(\n    f\"{len(checked)} laws proven for every record ({kernel_cli.milliseconds(t1 - t0)} with the base and definitions); axioms: \"\n      + join(kernel_dependent.axioms(env), \", \")\n      + \"\\n\",\n  )\n  mut code := 0\n  for path in paths {\n    t2 := clock.now().value\n    decls := match files.read_bytes(path) {\n      Ok(bytes) => match binary.read(bytes) {\n        Ok(img) => kernel_cli.made_in(\n          img.decls,\n          kernel_cli.typing_decls(files, home),\n        ),\n        Err(m) => Err(m),\n      },\n      Err(_) => Err(\"can't read it\"),\n    }\n    result := match decls {\n      Ok(ds) => kernel_dependent_patch.records(env, ds),\n      Err(m) => Err(m),\n    }\n    match result {\n      Ok(r) => {\n        mut console.write(\n          \"== \"\n            + path\n            + f\" ({kernel_cli.milliseconds(clock.now().value - t2)})\\n\",\n        )\n        for (n, s) in r.statements {\n          mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n        }\n      },\n      Err(m) => {\n        mut console.write(path + \": \" + m + \"\\n\")\n        code = 1\n      },\n    }\n  }\n  code\n}"}]}
{"id":"0fdbcb2317a3f975","time":1795849369,"message":"edit","changes":[{"name":"kernel_dependent_patch.refusals","kind":"fn","old":null,"new":"74da9b8d09c5a3dc","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"/// What the kernel must refuse, each with its error: `Type : Type`, a\n/// proof of `Empty`, a non-positive inductive type, a constructor\n/// argument in a larger universe, a `refl` that isn't one, and a proof\n/// of a law that is false (a kept field set to `v`). An entry with no\n/// error is a soundness bug.\npub fn refusals(env: Environment) -> List[(String, Result[Environment, String])] {\n  t := Sort(0)\n  r := kernel_dependent_patch.record()\n  kept_set := kernel_dependent_patch.pis(kernel_dependent_patch.schema()\n    + [\n      (\"fs\", kernel_dependent_patch.fields()),\n      (\"x\", r),\n      (\"p\", kernel_dependent_patch.s(\"Patch\")),\n      (\"f\", kernel_dependent_patch.v(\"F\")),\n      (\n        \"v\",\n        kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n      ),\n    ], kernel_dependent_patch.eq0(\n    kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n    Apply {\n      function: kernel_dependent_patch.at(\n        kernel_dependent_patch.s(\"patched\"),\n        [\n          kernel_dependent_patch.v(\"fs\"),\n          kernel_dependent_patch.v(\"x\"),\n          kernel_dependent_patch.v(\"p\"),\n        ],\n      ),\n      argument: kernel_dependent_patch.v(\"f\"),\n    },\n    kernel_dependent_patch.v(\"v\"),\n  ))\n  [\n    (\"Type : Type\", kernel_dependent.define(env, \"bad\", t, t)),\n    (\"Empty proven by star\", kernel_dependent.define(\n      env,\n      \"bad\",\n      kernel_dependent_patch.c(\"Empty\"),\n      kernel_dependent_patch.c(\"star\"),\n    )),\n    (\n      \"Bad = mk (Bad → Empty)\",\n      kernel_dependent.add_inductive(env, \"Bad\", t, 0, [(\n        \"bad.mk\",\n        kernel_dependent_patch.arrow(kernel_dependent_patch.arrow(\n          kernel_dependent_patch.c(\"Bad\"),\n          kernel_dependent_patch.c(\"Empty\"),\n        ), kernel_dependent_patch.c(\"Bad\")),\n      )]),\n    ),\n    (\n      \"Box : Type = mk Type\",\n      kernel_dependent.add_inductive(\n        env,\n        \"Box\",\n        t,\n        0,\n        [(\"box.mk\", kernel_dependent_patch.arrow(\n          t,\n          kernel_dependent_patch.c(\"Box\"),\n        ))],\n      ),\n    ),\n    (\n      \"true = false by refl\",\n      kernel_dependent.define(\n        env,\n        \"bad\",\n        kernel_dependent_patch.eq0(\n          kernel_dependent_patch.c(\"Bool\"),\n          kernel_dependent_patch.c(\"true\"),\n          kernel_dependent_patch.c(\"false\"),\n        ),\n        kernel_dependent.reflexivity(\n          0,\n          kernel_dependent_patch.c(\"Bool\"),\n          kernel_dependent_patch.c(\"true\"),\n        ),\n      ),\n    ),\n    (\"any field patched is v, by refl\", kernel_dependent.define(\n      env,\n      \"bad\",\n      kept_set,\n      kernel_dependent_patch.lambdas(kernel_dependent_patch.schema()\n        + [\n          (\"fs\", kernel_dependent_patch.fields()),\n          (\"x\", r),\n          (\"p\", kernel_dependent_patch.s(\"Patch\")),\n          (\"f\", kernel_dependent_patch.v(\"F\")),\n          (\n            \"v\",\n            kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n          ),\n        ], kernel_dependent.reflexivity(\n        0,\n        kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n        kernel_dependent_patch.v(\"v\"),\n      )),\n    )),\n  ]\n}"}]}
{"id":"6d81050cc0d93771","time":1795849374,"message":"edit","changes":[{"name":"kernel_cli.dependent","kind":"fn","old":"24f903a9e0c0990a","new":"232997915d61e18b","interface_changed":false,"affected":[],"module":"kernel_cli","text":"/// `strata kernel dependent [FILE.strata…]`: Patch's laws proven once, for\n/// every record, in the dependently typed kernel (kernel_dependent), each\n/// with the time its proof took to build and check; then each file's\n/// records as schemas, with the laws' instances at them.\nfn dependent(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  home: String,\n  paths: List[String],\n) -> std.process.ExitCode {\n  t0 := clock.now().value\n  mut checked := []\n  built := match kernel_dependent_patch.base(kernel_dependent.empty_environment()) {\n    Ok(e) => match kernel_dependent_patch.definitions(e) {\n      Ok(e2) => kernel_dependent_patch.laws(clock, mut checked, e2),\n      Err(m) => Err(m),\n    },\n    Err(m) => Err(m),\n  }\n  t1 := clock.now().value\n  env := built except m {\n    mut console.write(\"failed: \" + m + \"\\n\")\n    return 1\n  }\n  for k in checked {\n    mut console.write(\n      \"proven \"\n        + k.name\n        + \" (\"\n        + kernel_cli.milliseconds(k.ns)\n        + \")\\n\",\n    )\n  }\n  mut console.write(\n    f\"{len(checked)} laws proven for every record ({kernel_cli.milliseconds(t1 - t0)} with the base and definitions); axioms: \"\n      + join(kernel_dependent.axioms(env), \", \")\n      + \"\\n\",\n  )\n  for k in checked {\n    uses := match kernel_dependent.lookup(env, k.name) {\n      Some(kernel_dependent.Entry { value: Some(p), .. }) => kernel_dependent.mentions(p, \"funext\"),\n      _ => false,\n    }\n    if uses {\n      mut console.write(\"  \" + k.name + \" uses funext\\n\")\n    }\n  }\n  mut code := 0\n  for (what, r) in kernel_dependent_patch.refusals(env) {\n    match r {\n      Ok(_) => {\n        mut console.write(\"ACCEPTED (unsound): \" + what + \"\\n\")\n        code = 1\n      },\n      Err(m) => mut console.write(\"refused: \" + what + \" (\" + m + \")\\n\"),\n    }\n  }\n  for path in paths {\n    t2 := clock.now().value\n    decls := match files.read_bytes(path) {\n      Ok(bytes) => match binary.read(bytes) {\n        Ok(img) => kernel_cli.made_in(\n          img.decls,\n          kernel_cli.typing_decls(files, home),\n        ),\n        Err(m) => Err(m),\n      },\n      Err(_) => Err(\"can't read it\"),\n    }\n    result := match decls {\n      Ok(ds) => kernel_dependent_patch.records(env, ds),\n      Err(m) => Err(m),\n    }\n    match result {\n      Ok(r) => {\n        mut console.write(\n          \"== \"\n            + path\n            + f\" ({kernel_cli.milliseconds(clock.now().value - t2)})\\n\",\n        )\n        for (n, s) in r.statements {\n          mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n        }\n      },\n      Err(m) => {\n        mut console.write(path + \": \" + m + \"\\n\")\n        code = 1\n      },\n    }\n  }\n  code\n}","old_text":"/// `strata kernel dependent [FILE.strata…]`: Patch's laws proven once, for\n/// every record, in the dependently typed kernel (kernel_dependent), each\n/// with the time its proof took to build and check; then each file's\n/// records as schemas, with the laws' instances at them.\nfn dependent(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  home: String,\n  paths: List[String],\n) -> std.process.ExitCode {\n  t0 := clock.now().value\n  mut checked := []\n  built := match kernel_dependent_patch.base(kernel_dependent.empty_environment()) {\n    Ok(e) => match kernel_dependent_patch.definitions(e) {\n      Ok(e2) => kernel_dependent_patch.laws(clock, mut checked, e2),\n      Err(m) => Err(m),\n    },\n    Err(m) => Err(m),\n  }\n  t1 := clock.now().value\n  env := built except m {\n    mut console.write(\"failed: \" + m + \"\\n\")\n    return 1\n  }\n  for k in checked {\n    mut console.write(\n      \"proven \"\n        + k.name\n        + \" (\"\n        + kernel_cli.milliseconds(k.ns)\n        + \")\\n\",\n    )\n  }\n  mut console.write(\n    f\"{len(checked)} laws proven for every record ({kernel_cli.milliseconds(t1 - t0)} with the base and definitions); axioms: \"\n      + join(kernel_dependent.axioms(env), \", \")\n      + \"\\n\",\n  )\n  mut code := 0\n  for path in paths {\n    t2 := clock.now().value\n    decls := match files.read_bytes(path) {\n      Ok(bytes) => match binary.read(bytes) {\n        Ok(img) => kernel_cli.made_in(\n          img.decls,\n          kernel_cli.typing_decls(files, home),\n        ),\n        Err(m) => Err(m),\n      },\n      Err(_) => Err(\"can't read it\"),\n    }\n    result := match decls {\n      Ok(ds) => kernel_dependent_patch.records(env, ds),\n      Err(m) => Err(m),\n    }\n    match result {\n      Ok(r) => {\n        mut console.write(\n          \"== \"\n            + path\n            + f\" ({kernel_cli.milliseconds(clock.now().value - t2)})\\n\",\n        )\n        for (n, s) in r.statements {\n          mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n        }\n      },\n      Err(m) => {\n        mut console.write(path + \": \" + m + \"\\n\")\n        code = 1\n      },\n    }\n  }\n  code\n}"}]}
{"id":"1fa3c5b6ec39863e","time":1795849541,"message":"edit","changes":[{"name":"kernel_cli.dependent","kind":"fn","old":"232997915d61e18b","new":"720a85d092fb4ee0","interface_changed":false,"affected":[],"module":"kernel_cli","text":"/// `strata kernel dependent [FILE.strata…]`: Patch's laws proven once, for\n/// every record, in the dependently typed kernel (kernel_dependent), each\n/// with the time its proof took to build and check; then each file's\n/// records as schemas, with the laws' instances at them.\nfn dependent(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  home: String,\n  paths: List[String],\n) -> std.process.ExitCode {\n  t0 := clock.now().value\n  mut checked := []\n  built := match kernel_dependent_patch.base(kernel_dependent.empty_environment()) {\n    Ok(e) => match kernel_dependent_patch.definitions(e) {\n      Ok(e2) => kernel_dependent_patch.laws(clock, mut checked, e2),\n      Err(m) => Err(m),\n    },\n    Err(m) => Err(m),\n  }\n  t1 := clock.now().value\n  env := built except m {\n    mut console.write(\"failed: \" + m + \"\\n\")\n    return 1\n  }\n  for k in checked {\n    mut console.write(\n      \"proven \"\n        + k.name\n        + \" (\"\n        + kernel_cli.milliseconds(k.ns)\n        + \")\\n\",\n    )\n  }\n  mut console.write(\n    f\"{len(checked)} laws proven for every record ({kernel_cli.milliseconds(t1 - t0)} with the base and definitions); axioms: \"\n      + join(kernel_dependent.axioms(env), \", \")\n      + \"\\n\",\n  )\n  for k in checked {\n    uses := match kernel_dependent.lookup(env, k.name) {\n      Some(kernel_dependent.Entry { value: Some(p), .. }) => kernel_dependent.mentions(p, \"funext\"),\n      _ => false,\n    }\n    if uses {\n      mut console.write(\"  \" + k.name + \" uses funext\\n\")\n    }\n  }\n  mut code := 0\n  for (what, m) in kernel_dependent_patch.refusals(env) {\n    if m == \"\" {\n      mut console.write(\"ACCEPTED (unsound): \" + what + \"\