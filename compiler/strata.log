 them.\nfn hash_helper(mut g: codegen.Gen, t: check.Ty) -> String {\n  name := f\"@\\\"hash:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  saved := g\n  g.lines = []\n  g.proving = \"\"\n  g.can_unwind = false\n  g.unwinds = false\n  g.unwind_chain = []\n  g.allocas = []\n  g.next = 0\n  g.scopes = [codegen.no_scope()]\n  g.loops = []\n  codegen.block(mut g, \"start\")\n  a := codegen.V { ty: t, op: \"%a\" }\n  if codegen.sized(t) is Some {\n    s := codegen.to_slot(mut g, a)\n    codegen.emit(mut g, f\"ret i64 {s}\")\n  } else {\n    match t {\n      check.TInt => {\n        codegen.use_rt(mut g, \"strata_int_hash\")\n        codegen.emit(\n          mut g,\n          \"%h = call i64 @strata_int_hash(i64 %a)\",\n        )\n        codegen.emit(mut g, \"ret i64 %h\")\n      },\n      check.TBool | check.TFloat => {\n        s := codegen.to_slot(mut g, a)\n        codegen.emit(mut g, f\"ret i64 {s}\")\n      },\n      check.TStr => {\n        codegen.use_rt(mut g, \"strata_str_hash\")\n        codegen.emit(\n          mut g,\n          \"%h = call i64 @strata_str_hash(ptr %a)\",\n        )\n        codegen.emit(mut g, \"ret i64 %h\")\n      },\n      check.TNamed { name: \"Tuple\", args } => codegen.hash_fields(mut g, a, args, \"0\"),\n      check.TNamed { name: \"Set\", .. } | check.TNamed { name: \"Dict\", .. } => {\n        f := codegen.slot_fn(mut g, \"hash\", codegen.entry_ty(t))\n        codegen.use_rt(mut g, \"strata_tbl_hash\")\n        codegen.emit(\n          mut g,\n          f\"%h = call i64 @strata_tbl_hash(ptr %a, ptr {f})\",\n        )\n        codegen.emit(mut g, \"ret i64 %h\")\n      },\n      check.TList(et) => {\n        f := codegen.slot_fn(mut g, \"hash\", et)\n        codegen.use_rt(mut g, \"strata_list_hash\")\n        codegen.emit(\n          mut g,\n          f\"%h = call i64 @strata_list_hash(ptr %a, ptr {f})\",\n        )\n        codegen.emit(mut g, \"ret i64 %h\")\n      },\n      check.TNamed { .. } => if codegen.counted(t) {\n        // the variant (its tag), then its fields\n        cs := codegen.ctors_of(g, t)\n        if len(cs) > 1 {\n          labels := codegen.on_ctor(mut g, a, cs)\n          for (k, c) in enumerate(cs) {\n            codegen.block(mut g, get(labels, k) ?? \"\")\n            codegen.hash_fields(\n              mut g,\n              a,\n              codegen.fields_of(g, c, t).map(f -> f.1),\n              to_string(get(g.tags, c) ?? 0),\n            )\n          }\n        } else {\n          codegen.hash_fields(\n            mut g,\n            a,\n            codegen.fields_of(g, get(cs, 0) ?? \"\", t).map(f -> f.1),\n            \"0\",\n          )\n        }\n      } else {\n        codegen.emit(mut g, \"ret i64 0\")\n      },\n      _ => codegen.emit(mut g, \"ret i64 0\"),\n    }\n  }\n  sig := if codegen.has_value(t) {\n    f\"define i64 {name}({codegen.ll(t)} %a)\"\n  } else {\n    f\"define i64 {name}()\"\n  }\n  def := join([sig + \" {\"]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, def)\n  name\n}","old_text":"/// The structural hash of values of type `t` (`i64 (T)`), consistent with\n/// `cmp_helper`: values it finds equal hash the same. A set or dict hashes\n/// its entries order-independently. Types it does not look into (a union, a\n/// function) hash to 0: they all collide, and `cmp` still finds them.\nfn hash_helper(mut g: codegen.Gen, t: Ty) -> String {\n  name := f\"@\\\"hash:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  saved := g\n  g.lines = []\n  g.proving = \"\"\n  g.can_unwind = false\n  g.unwinds = false\n  g.unwind_chain = []\n  g.allocas = []\n  g.next = 0\n  g.scopes = [codegen.no_scope()]\n  g.loops = []\n  codegen.block(mut g, \"start\")\n  a := codegen.V { ty: t, op: \"%a\" }\n  if codegen.sized(t) is Some {\n    s := codegen.to_slot(mut g, a)\n    codegen.emit(mut g, f\"ret i64 {s}\")\n  } else {\n    match t {\n      TInt => {\n        codegen.use_rt(mut g, \"strata_int_hash\")\n        codegen.emit(\n          mut g,\n          \"%h = call i64 @strata_int_hash(i64 %a)\",\n        )\n        codegen.emit(mut g, \"ret i64 %h\")\n      },\n      TBool | TFloat => {\n        s := codegen.to_slot(mut g, a)\n        codegen.emit(mut g, f\"ret i64 {s}\")\n      },\n      TStr => {\n        codegen.use_rt(mut g, \"strata_str_hash\")\n        codegen.emit(\n          mut g,\n          \"%h = call i64 @strata_str_hash(ptr %a)\",\n        )\n        codegen.emit(mut g, \"ret i64 %h\")\n      },\n      TNamed { name: \"Tuple\", args } => codegen.hash_fields(mut g, a, args, \"0\"),\n      TNamed { name: \"Set\", .. } | TNamed { name: \"Dict\", .. } => {\n        f := codegen.slot_fn(mut g, \"hash\", codegen.entry_ty(t))\n        codegen.use_rt(mut g, \"strata_tbl_hash\")\n        codegen.emit(\n          mut g,\n          f\"%h = call i64 @strata_tbl_hash(ptr %a, ptr {f})\",\n        )\n        codegen.emit(mut g, \"ret i64 %h\")\n      },\n      TList(et) => {\n        f := codegen.slot_fn(mut g, \"hash\", et)\n        codegen.use_rt(mut g, \"strata_list_hash\")\n        codegen.emit(\n          mut g,\n          f\"%h = call i64 @strata_list_hash(ptr %a, ptr {f})\",\n        )\n        codegen.emit(mut g, \"ret i64 %h\")\n      },\n      TNamed { .. } => if codegen.counted(t) {\n        // the variant (its tag), then its fields\n        cs := codegen.ctors_of(g, t)\n        if len(cs) > 1 {\n          labels := codegen.on_ctor(mut g, a, cs)\n          for (k, c) in enumerate(cs) {\n            codegen.block(mut g, get(labels, k) ?? \"\")\n            codegen.hash_fields(\n              mut g,\n              a,\n              codegen.fields_of(g, c, t).map(f -> f.1),\n              to_string(get(g.tags, c) ?? 0),\n            )\n          }\n        } else {\n          codegen.hash_fields(\n            mut g,\n            a,\n            codegen.fields_of(g, get(cs, 0) ?? \"\", t).map(f -> f.1),\n            \"0\",\n          )\n        }\n      } else {\n        codegen.emit(mut g, \"ret i64 0\")\n      },\n      _ => codegen.emit(mut g, \"ret i64 0\"),\n    }\n  }\n  sig := if codegen.has_value(t) {\n    f\"define i64 {name}({codegen.ll(t)} %a)\"\n  } else {\n    f\"define i64 {name}()\"\n  }\n  def := join([sig + \" {\"]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, def)\n  name\n}"},{"name":"codegen.hash_fields","kind":"fn","old":"77306fb4e11c8edc","new":"1f2b2b2ee4998a39","interface_changed":true,"affected":["codegen.hash_helper","codegen.slot_fn","codegen.equal","codegen.cmp_helper","codegen.table_fns","codegen.apply","codegen.eq_fields","codegen.matches","codegen.eq_list","codegen.dyn_wrapper","codegen.union_eq","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.collection_builtin","codegen.update_in_place","codegen.table_from","codegen.binary","codegen.number_builtin","codegen.checked","codegen.eq_body","codegen.destructure","codegen.binds","codegen.for_loop","codegen.matching_v","codegen.match_got","codegen.helper","codegen.vtable","codegen.builtin_call","codegen.builtin","codegen.gen_list","codegen.converted","codegen.stmt_node","codegen.expr_node","codegen.assertion","codegen.invariants","codegen.matching_want","codegen.show","codegen.shown","codegen.to_dyn","codegen.dyn_table_is","codegen.call_named","codegen.method_call","codegen.except_expr","codegen.push_in_place","codegen.produce","codegen.list_builtin","codegen.list_literal_of","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.table_find","codegen.set_in_place","codegen.take_in_place","codegen.expr_want_node","codegen.stmt","codegen.expr","codegen.matching","codegen.entry","codegen.interp","codegen.string_builtin","codegen.format_spec","