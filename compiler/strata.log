{"id":"08caeafd24760502","time":1795657343,"message":"remove unused parameters","changes":[{"name":"cache.files_part","kind":"fn","old":"6a7520e3bf2504bd","new":"bb568c98617bbefe","interface_changed":true,"affected":["native_key","std_library_key","code_snapshot_decls","sources_object","verify_file","load_native","std_library","codegen_with","linked","verify_command","build_proofs","command_line","alongside_command","search_invariants","test_command","check_command","build_command","run_command","repl_command","static_graph","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","built_ir","core_rt_object","strata_command","main","apply_edit","edit_file","fix_loops","graph_command","graph_diff","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","or_solver_inputs","program_objects","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","edit_command","edit_in_editor","fix_command","diff_command","call_command","loaded_errors","file_errors","edit_errors","check_fn","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","package_errors","check_files","apply_change","build_core_command","comptime_value","rename_command","move_command","comptime_values","expanded","comptime_runner","with_base"],"module":"cache","text":"/// One key part for the files `paths`, in this order: each path as given\n/// and the SHA-256 of its bytes, a missing file as `-`. Paths are relative,\n/// so the same tree anywhere gives the same part. For a cache of what is\n/// built from files (the compiler package, std's library).\npub fn files_part(root: String, paths: List[String]) -> String {\n  mut out := []\n  for p in paths {\n    h := cache.cache_sha256_file(root + \"/\" + p)\n    mut out.push(\n      p\n        + \"=\"\n        + if h == \"\" {\n          \"-\"\n        } else {\n          h\n        },\n    )\n  }\n  cache.content_key(out)\n}","old_text":"/// One key part for the files `paths`, in this order: each path as given\n/// and the SHA-256 of its bytes, a missing file as `-`. Paths are relative,\n/// so the same tree anywhere gives the same part. For a cache of what is\n/// built from files (the compiler package, std's library).\npub fn files_part(disk: std.fs.Disk, root: String, paths: List[String]) -> String {\n  mut out := []\n  for p in paths {\n    h := cache.cache_sha256_file(root + \"/\" + p)\n    mut out.push(\n      p\n        + \"=\"\n        + if h == \"\" {\n          \"-\"\n        } else {\n          h\n        },\n    )\n  }\n  cache.content_key(out)\n}"},{"name":"comptime_value","kind":"fn","old":"c0d4ce3fcc5d99a5","new":"6f31951da44aa779","interface_changed":false,"affected":[],"module":"","text":"/// `comptime e`'s value (`comptime_values`). `base` is the key of what it\n/// reaches (`\"\"`: nothing cached), `near` the definitions of `ds` it\n/// reaches.\nfn comptime_value(\n  disk: std.fs.Disk,\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  base: String,\n  cache: cache.Cache,\n  near: List[ast.Decl],\n  ds: List[ast.Decl],\n  m: String,\n  e: ast.Expr,\n) -> Result[ast.Expr, String] {\n  // computed before for the same code (here or where the shipped cache was\n  // made): read back\n  key := if base == \"\" {\n    \"\"\n  } else {\n    cache.content_key([\"comptime\", base, text.expr_text(e, 0)])\n  }\n  rel := \"comptime/\" + key + \".strata\"\n  if key != \"\" {\n    match cache.find_entry(disk, cache, rel) {\n      Some(path) => match kept_value(disk, path) {\n        Some(v) => return Ok(v),\n        None => (),\n      },\n      None => (),\n    }\n  }\n  // (with what it reaches, else, when that doesn't compile, with the\n  // whole program)\n  computed := match timings.timed(\n    \"comptime: compile and run\",\n    () -> computed_value(core, prelude, near, m, e),\n  ) {\n    Err(why) => if starts_with(why, derive.not_compiled()) {\n      timings.timed(\n        \"comptime: with the whole program\",\n        () -> computed_value(core, prelude, ds, m, e),\n      )\n    } else {\n      Err(why)\n    },\n    done => done,\n  }\n  match computed {\n    Ok(v) => {\n      if key != \"\" {\n        keep_value(disk, cache, rel, v)\n      }\n      Ok(v)\n    },\n    Err(why) => Err(why),\n  }\n}","old_text":"/// `comptime e`'s value (`comptime_values`). `base` is the key of what it\n/// reaches (`\"\"`: nothing cached), `near` the definitions of `ds` it\n/// reaches.\nfn comptime_value(\n  disk: std.fs.Disk,\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  base: String,\n  cache: cache.Cache,\n  near: List[ast.Decl],\n  ds: List[ast.Decl],\n  m: String,\n  e: ast.Expr,\n) -> Result[ast.Expr, String] {\n  // computed before for the same code (here or where the shipped cache was\n  // made): read back\n  key := if base == \"\" {\n    \"\"\n  } else {\n    cache.content_key([\"comptime\", base, text.expr_text(e, 0)])\n  }\n  rel := \"comptime/\" + key + \".strata\"\n  if key != \"\" {\n    match cache.find_entry(disk, cache, rel) {\n      Some(path) => match kept_value(disk, path) {\n        Some(v) => return Ok(v),\n        None => (),\n      },\n      None => (),\n    }\n  }\n  // (with what it reaches, else, when that doesn't compile, with the\n  // whole program)\n  computed := match timings.timed(\n    \"comptime: compile and run\",\n    () -> computed_value(disk, core, prelude, near, m, e),\n  ) {\n    Err(why) => if starts_with(why, derive.not_compiled()) {\n      timings.timed(\n        \"comptime: with the whole program\",\n        () -> computed_value(disk, core, prelude, ds, m, e),\n      )\n    } else {\n      Err(why)\n    },\n    done => done,\n  }\n  match computed {\n    Ok(v) => {\n      if key != \"\" {\n        keep_value(disk, cache, rel, v)\n      }\n      Ok(v)\n    },\n    Err(why) => Err(why),\n  }\n}"},{"name":"computed_value","kind":"fn","old":"00ab1f446d8940a6","new":"950ea715c69b3ee3","interface_changed":true,"affected":["comptime_value","comptime_values","expanded","comptime_runner","codegen_with","with_base","repl_eval","loaded_errors","edit_file","file_errors","edit_errors","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","verify_file","repl_command","package_errors","edit_command","check_files","check_command","build_command","run_command","apply_change","apply_edit","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","graph_runs","replay","or_solver_inputs","strata_command","verify_command","static_graph","program_objects","build_proofs","command_line","search_invariants","rename_command","move_command","fix_command","edit_in_editor","call_command","check_fn","graph_command","graph_diff","linked","main","fix_loops","diff_command","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","core_rt_text","codegen.read_back","eval_files","build_core_command"],"module":"","text":"/// Compiles and runs `comptime_value`'s value, without the cache.\nfn computed_value(\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  ds: List[ast.Decl],\n  m: String,\n  e: ast.Expr,\n) -> Result[ast.Expr, String] {\n  name := \"strata_comptime\"\n  key := if m == \"\" {\n    name\n  } else {\n    m + \".\" + name\n  }\n  // its type, as the checker infers it for a variable holding it\n  probe := ast.FnDecl {\n    doc: [],\n    comments: [],\n    name,\n    type_params: [],\n    bounds: [],\n    params: [],\n    ret: ast.UnitType,\n    pre: [],\n    post: [],\n    terminating: false,\n    body: ast.Block {\n      stmts: [\n        ast.Let {\n          pat: ast.Bind(\"strata_value\"),\n          ty: None,\n          value: e,\n        },\n      ],\n      last: ast.UnitExpr,\n    },\n    compile_time: false,\n    derived: false,\n  }\n  at := ast.Decl {\n    comments: [],\n    doc: [],\n    module: m,\n    public: false,\n    kind: ast.FnDef(probe),\n  }\n  mut t := None\n  for d in check.typed(ds + [at], core) {\n    match d.kind {\n      ast.FnDef(f) => if f.name == name && d.module == m {\n        match f.body {\n          ast.Block { stmts: [ast.Let { ty, .. }], .. } => {\n            t = ty\n          },\n          _ => (),\n        }\n      },\n      _ => (),\n    }\n  }\n  ty := match t {\n    Some(x) => x,\n    None => return Err(derive.not_compiled() + \"its type isn't known\"),\n  }\n  program := ds\n    + [\n      ast.Decl { ..at, kind: ast.FnDef(ast.FnDecl { ..probe, ret: ty, body: e }) },\n    ]\n  ir := match codegen.generate(\n    program,\n    core,\n    prelude,\n    [],\n    None,\n    [],\n    false,\n    [key],\n    false,\n    [],\n    [],\n    false,\n    None,\n    None,\n    false,\n  ) {\n    Ok(x) => x,\n    Err(es) => return Err(derive.not_compiled() + join(es, \"; \")),\n  }\n  h := jit_fuzz_load(ir)\n  if h.to_int() < 0 {\n    return Err(derive.not_compiled() + jit_fuzz_error())\n  }\n  match jit_call_case(h, 0, to_i64(comptime_budget())).to_int() {\n    // (written with its type, which a literal alone may not say: `[1, \"x\"]`\n    // of a `List[Int | String]`)\n    0 => match codegen.read_back(\n      program,\n      core,\n      prelude,\n      ty,\n      Raw { address: jit_kept() },\n    ) {\n      Ok(v) => Ok(ast.Block { stmts: [ast.Let {\n        pat: ast.Bind(\"strata_value\"),\n        ty: Some(ty),\n        value: v,\n      }], last: ast.Var(\"strata_value\") }),\n      Err(why) => Err(derive.not_compiled() + why),\n    },\n    1 => {\n      why := jit_fault_message()\n      if why == \"too many steps\" {\n        Err(\n          f\"ran for more than {comptime_budget()} steps: compile-time code must finish\",\n        )\n      } else {\n        Err(why)\n      }\n    },\n    _ => Err(derive.not_compiled() + \"no call to run\"),\n  }\n}","old_text":"/// Compiles and runs `comptime_value`'s value, without the cache.\nfn computed_value(\n  disk: std.fs.Disk,\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  ds: List[ast.Decl],\n  m: String,\n  e: ast.Expr,\n) -> Result[ast.Expr, String] {\n  name := \"strata_comptime\"\n  key := if m == \"\" {\n    name\n  } else {\n    m + \".\" + name\n  }\n  // its type, as the checker infers it for a variable holding it\n  probe := ast.FnDecl {\n    doc: [],\n    comments: [],\n    name,\n    type_params: [],\n    bounds: [],\n    params: [],\n    ret: ast.UnitType,\n    pre: [],\n    post: [],\n    terminating: false,\n    body: ast.Block {\n      stmts: [\n        ast.Let {\n          pat: ast.Bind(\"strata_value\"),\n          ty: None,\n          value: e,\n        },\n      ],\n      last: ast.UnitExpr,\n    },\n    compile_time: false,\n    derived: false,\n  }\n  at := ast.Decl {\n    comments: [],\n    doc: [],\n    module: m,\n    public: false,\n    kind: ast.FnDef(probe),\n  }\n  mut t := None\n  for d in check.typed(ds + [at], core) {\n    match d.kind {\n      ast.FnDef(f) => if f.name == name && d.module == m {\n        match f.body {\n          ast.Block { stmts: [ast.Let { ty, .. }], .. } => {\n            t = ty\n          },\n          _ => (),\n        }\n      },\n      _ => (),\n    }\n  }\n  ty := match t {\n    Some(x) => x,\n    None => return Err(derive.not_compiled() + \"its type isn't known\"),\n  }\n  program := ds\n    + [\n      ast.Decl { ..at, kind: ast.FnDef(ast.FnDecl { ..probe, ret: ty, body: e }) },\n    ]\n  ir := match codegen.generate(\n    program,\n    core,\n    prelude,\n    [],\n    None,\n    [],\n    false,\n    [key],\n    false,\n    [],\n    [],\n    false,\n    None,\n    None,\n    false,\n  ) {\n    Ok(x) => x,\n    Err(es) => return Err(derive.not_compiled() + join(es, \"; \")),\n  }\n  h := jit_fuzz_load(ir)\n  if h.to_int() < 0 {\n    return Err(derive.not_compiled() + jit_fuzz_error())\n  }\n  match jit_call_case(h, 0, to_i64(comptime_budget())).to_int() {\n    // (written with its type, which a literal alone may not say: `[1, \"x\"]`\n    // of a `List[Int | String]`)\n    0 => match codegen.read_back(\n      program,\n      core,\n      prelude,\n      ty,\n      Raw { address: jit_kept() },\n    ) {\n      Ok(v) => Ok(ast.Block { stmts: [ast.Let {\n        pat: ast.Bind(\"strata_value\"),\n        ty: Some(ty),\n        value: v,\n      }], last: ast.Var(\"strata_value\") }),\n      Err(why) => Err(derive.not_compiled() + why),\n    },\n    1 => {\n      why := jit_fault_message()\n      if why == \"too many steps\" {\n        Err(\n          f\"ran for more than {comptime_budget()} steps: compile-time code must finish\",\n        )\n      } else {\n        Err(why)\n      }\n    },\n    _ => Err(derive.not_compiled() + \"no call to run\"),\n  }\n}"},{"name":"object_command","kind":"fn","old":"b0d47e7a3aebd0b8","new":"32f847b4ba960b21","interface_changed":false,"affected":[],"module":"","text":"/// `compiler object IR OUT [-O N]`: an LLVM IR file to an object file, with\n/// the LLVM linked into the compiler (compiler/toolchain's `object`).\nfn object_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  args: List[String],\n) -> Int {\n  ir_path := get(args, 0) ?? \"\"\n  out := get(args, 1) ?? \"\"\n  opt := match get(args, 2) {\n    Some(\"-O\") => parse_int(get(args, 3) ?? \"0\") ?? 0,\n    _ => 0,\n  }\n  match disk.read(ir_path) {\n    Ok(ir) => match toolchain.object(ir, out, opt) {\n      Ok(_) => 0,\n      Err(e) => {\n        mut console.eprint(\"error: \" + e)\n        1\n      },\n    },\n    Err(_) => {\n      mut console.eprint(\"error: \" + ir_path + \": unreadable\")\n      1\n    },\n  }\n}","old_text":"/// `compiler object IR OUT [-O N]`: an LLVM IR file to an object file, with\n/// the LLVM linked into the compiler (compiler/toolchain's `object`).\nfn object_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  args: List[String],\n) -> Int {\n  ir_path := get(args, 0) ?? \"\"\n  out := get(args, 1) ?? \"\"\n  opt := match get(args, 2) {\n    Some(\"-O\") => parse_int(get(args, 3) ?? \"0\") ?? 0,\n    _ => 0,\n  }\n  match disk.read(ir_path) {\n    Ok(ir) => match toolchain.object(mut disk, ir, out, opt) {\n      Ok(_) => 0,\n      Err(e) => {\n        mut console.eprint(\"error: \" + e)\n        1\n      },\n    },\n    Err(_) => {\n      mut console.eprint(\"error: \" + ir_path + \": unreadable\")\n      1\n    },\n  }\n}"},{"name":"link_command","kind":"fn","old":"3bd028e3a09a51fc","new":"01a4898d461ad954","interface_changed":false,"affected":[],"module":"","text":"/// `compiler link ARG...`: lld's Mach-O linker on these arguments\n/// (compiler/toolchain's `lld`).\nfn link_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  args: List[String],\n) -> Int {\n  match toolchain.lld(args) {\n    Ok(_) => 0,\n    Err(e) => {\n      mut console.eprint(\"error: \" + e)\n      1\n    },\n  }\n}","old_text":"/// `compiler link ARG...`: lld's Mach-O linker on these arguments\n/// (compiler/toolchain's `lld`).\nfn link_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  args: List[String],\n) -> Int {\n  match toolchain.lld(mut disk, args) {\n    Ok(_) => 0,\n    Err(e) => {\n      mut console.eprint(\"error: \" + e)\n      1\n    },\n  }\n}"},{"name":"native_key","kind":"fn","old":"863b30e009e6904d","new":"77622e1092daea8f","interface_changed":false,"affected":[],"module":"","text":"/// By content: its `strata.toml` and every C file (`.c`, `.h`) in its\n/// folder.\nfn native_key(disk: std.fs.Disk, dir: String) -> String {\n  cache.entry_key(\"native\", [match disk.read(dir + \"/strata.toml\") {\n    Ok(t) => t,\n    Err(_) => \"\",\n  }, cache.files_part(dir, c_files(disk, dir, \"\"))])\n}","old_text":"/// By content: its `strata.toml` and every C file (`.c`, `.h`) in its\n/// folder.\nfn native_key(disk: std.fs.Disk, dir: String) -> String {\n  cache.entry_key(\"native\", [match disk.read(dir + \"/strata.toml\") {\n    Ok(t) => t,\n    Err(_) => \"\",\n  }, cache.files_part(disk, dir, c_files(disk, dir, \"\"))])\n}"},{"name":"strata_command","kind":"fn","old":"2181208c72600d04","new":"50eacf0f514446a3","interface_changed":false,"affected":[],"module":"","text":"/// The `strata` command `command`, its command line read into `line`:\n/// help, and the commands that compile, run and check programs. Exit code\n/// 2 for a mistake in the command (said on stderr), 1 when the program is\n/// rejected.\nfn strata_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  command: String,\n  line: driver.Args,\n) -> std.process.ExitCode {\n  if driver.given(line, \"--version\") || command == \"version\" {\n    print(\"strata \" + version())\n    return 0\n  }\n  if command == \"\" || command == \"help\" {\n    print(std.cli.styled_help(\n      driver.usage_text(),\n      console.paint(std.term.Output),\n    ))\n    return 0\n  }\n  // (`skill` is compiler/skill's: no home needed)\n  if command == \"skill\" {\n    rest := driver.words_without(process.args(), line.command_at)\n    return skill.skill_command(mut console, mut disk, process, rest)\n  }\n  // (`cache` works on the own cache, compiler/cache's: no home needed)\n  if command == \"cache\" {\n    return cache_command(mut console, mut disk, process, cache, line)\n  }\n  if contains([\"ui\", \"serve\", \"ast\"], command) {\n    return fail_with(\n      mut console,\n      f\"`{command}` is not part of this strata (the command written in Strata)\",\n    )\n  }\n  if !contains([\n    \"check\",\n    \"run\",\n    \"repl\",\n    \"build\",\n    \"test\",\n    \"verify\",\n    \"verify-alongside\",\n    \"build-core\",\n    \"lex\",\n    \"parse\",\n    \"builtins\",\n    \"find\",\n    \"refs\",\n  ], command) {\n    return fail_with(\n      mut console,\n      f\"unknown command `{command}` (try `strata help`)\",\n    )\n  }\n  // the paths given are the current folder's. The compiler reads core/,\n  // std/ and the prelude from its home, which it enters.\n  cwd := process.current_dir()\n  home := match home_found(disk, process) {\n    Some(h) => h,\n    None => return fail_with(\n      mut console,\n      \"can't find Strata's home (a folder holding core/, std/ and runtime/prelude.strata, above this executable or the current folder): set STRATA_HOME\",\n    ),\n  }\n  // programs and tests are compiled unoptimized (several times faster to\n  // compile); `--release` optimizes as clang -O2 would\n  if command == \"run\" || command == \"test\" {\n    level := if driver.given(line, \"--release\") {\n      2\n    } else {\n      0\n    }\n    match jit_set_opt(level.wrap_i32()).to_int() {\n      _ => (),\n    }\n  }\n  // (`find` and `refs` are compiler/finding's)\n  if command == \"find\" || command == \"refs\" {\n    rest := driver.words_without(process.args(), line.command_at)\n    return if command == \"find\" {\n      finding.find_command(mut console, disk, process, rest)\n    } else {\n      finding.refs_command(mut console, disk, process, rest)\n    }\n  }\n  // `--profile`: every function compiled keeps its frame pointer, for\n  // `sample` (compiler/toolchain's `profiling`)\n  if driver.given(line, \"--profile\") {\n    toolchain.set_profile()\n  }\n  // `--timings`: each phase's time, on stderr when the command ends\n  // (compiler/timings)\n  if driver.given(line, \"--timings\") {\n    timings.enable()\n  }\n  if driver_chdir(home).to_int() != 0 {\n    return fail_with(mut console, f\"can't enter {home}\")\n  }\n  match command {\n    \"check\" => check_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    \"repl\" => repl_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      clock,\n      cache,\n      line,\n      cwd,\n    ),\n    \"run\" => run_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    \"build\" => build_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n      home,\n    ),\n    \"test\" => test_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    \"verify\" => verify_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    // (started by `run`: `start_alongside`)\n    \"verify-alongside\" => alongside_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n    ),\n    \"build-core\" => build_core_command(mut console, mut disk, line, cwd),\n    \"lex\" | \"parse\" => front_command(mut console, disk, command, line, cwd),\n    _ => builtins_command(disk, line),\n  }\n}","old_text":"/// The `strata` command `command`, its command line read into `line`:\n/// help, and the commands that compile, run and check programs. Exit code\n/// 2 for a mistake in the command (said on stderr), 1 when the program is\n/// rejected.\nfn strata_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  command: String,\n  line: driver.Args,\n) -> std.process.ExitCode {\n  if driver.given(line, \"--version\") || command == \"version\" {\n    print(\"strata \" + version())\n    return 0\n  }\n  if command == \"\" || command == \"help\" {\n    print(std.cli.styled_help(\n      driver.usage_text(),\n      console.paint(std.term.Output),\n    ))\n    return 0\n  }\n  // (`skill` is compiler/skill's: no home needed)\n  if command == \"skill\" {\n    rest := driver.words_without(process.args(), line.command_at)\n    return skill.skill_command(mut console, mut disk, process, rest)\n  }\n  // (`cache` works on the own cache, compiler/cache's: no home needed)\n  if command == \"cache\" {\n    return cache_command(mut console, mut disk, process, cache, line)\n  }\n  if contains([\"ui\", \"serve\", \"ast\"], command) {\n    return fail_with(\n      mut console,\n      f\"`{command}` is not part of this strata (the command written in Strata)\",\n    )\n  }\n  if !contains([\n    \"check\",\n    \"run\",\n    \"repl\",\n    \"build\",\n    \"test\",\n    \"verify\",\n    \"verify-alongside\",\n    \"build-core\",\n    \"lex\",\n    \"parse\",\n    \"builtins\",\n    \"find\",\n    \"refs\",\n  ], command) {\n    return fail_with(\n      mut console,\n      f\"unknown command `{command}` (try `strata help`)\",\n    )\n  }\n  // the paths given are the current folder's. The compiler reads core/,\n  // std/ and the prelude from its home, which it enters.\n  cwd := process.current_dir()\n  home := match home_found(disk, process) {\n    Some(h) => h,\n    None => return fail_with(\n      mut console,\n      \"can't find Strata's home (a folder holding core/, std/ and runtime/prelude.strata, above this executable or the current folder): set STRATA_HOME\",\n    ),\n  }\n  // programs and tests are compiled unoptimized (several times faster to\n  // compile); `--release` optimizes as clang -O2 would\n  if command == \"run\" || command == \"test\" {\n    level := if driver.given(line, \"--release\") {\n      2\n    } else {\n      0\n    }\n    match jit_set_opt(level.wrap_i32()).to_int() {\n      _ => (),\n    }\n  }\n  // (`find` and `refs` are compiler/finding's)\n  if command == \"find\" || command == \"refs\" {\n    rest := driver.words_without(process.args(), line.command_at)\n    return if command == \"find\" {\n      finding.find_command(mut console, disk, process, rest)\n    } else {\n      finding.refs_command(mut console, disk, process, rest)\n    }\n  }\n  // `--profile`: every function compiled keeps its frame pointer, for\n  // `sample` (compiler/toolchain's `profiling`)\n  if driver.given(line, \"--profile\") {\n    toolchain.set_profile()\n  }\n  // `--timings`: each phase's time, on stderr when the command ends\n  // (compiler/timings)\n  if driver.given(line, \"--timings\") {\n    timings.enable()\n  }\n  if driver_chdir(home).to_int() != 0 {\n    return fail_with(mut console, f\"can't enter {home}\")\n  }\n  match command {\n    \"check\" => check_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    \"repl\" => repl_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      clock,\n      cache,\n      line,\n      cwd,\n    ),\n    \"run\" => run_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    \"build\" => build_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n      home,\n    ),\n    \"test\" => test_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    \"verify\" => verify_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    // (started by `run`: `start_alongside`)\n    \"verify-alongside\" => alongside_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n    ),\n    \"build-core\" => build_core_command(mut console, mut disk, line, cwd),\n    \"lex\" | \"parse\" => front_command(mut console, disk, command, line, cwd),\n    _ => builtins_command(mut console, disk, line),\n  }\n}"},{"name":"builtins_command","kind":"fn","old":"5dca3ade1a8f53d9","new":"acd52925d9a9d29c","interface_changed":true,"affected":["strata_command","command_line","main","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","diff_command","with_base","rename_command","move_command","fix_command","edit_in_editor"],"module":"","text":"/// `strata builtins`: the prelude's types (core.types), then the built-in\n/// functions' signatures.\nfn builtins_command(\n  disk: std.fs.Disk,\n  line: driver.Args,\n) -> std.process.ExitCode {\n  if driver.given(line, \"--json\") {\n    print(driver.pretty_json(builtins_json(read_core(disk))))\n    return 0\n  }\n  print(\"// prelude types\\n\")\n  for d in module_decls(disk, [\"core/types.strata\"]) {\n    print(text.decl_text(d) + \"\\n\")\n  }\n  print(\"// builtin functions\\n\")\n  print_builtins(read_core(disk))\n  0\n}","old_text":"/// `strata builtins`: the prelude's types (core.types), then the built-in\n/// functions' signatures.\nfn builtins_command(\n  mut console: std.io.Console,\n  disk: std.fs.Disk,\n  line: driver.Args,\n) -> std.process.ExitCode {\n  if driver.given(line, \"--json\") {\n    print(driver.pretty_json(builtins_json(read_core(disk))))\n    return 0\n  }\n  print(\"// prelude types\\n\")\n  for d in module_decls(disk, [\"core/types.strata\"]) {\n    print(text.decl_text(d) + \"\\n\")\n  }\n  print(\"// builtin functions\\n\")\n  print_builtins(read_core(disk))\n  0\n}"},{"name":"std_library_key","kind":"fn","old":"d4be19ad8f3b0f54","new":"cabcf667e5d3729c","interface_changed":false,"affected":[],"module":"","text":"/// The key of what this compiler makes of std. The cache entry\n/// `std-library-of/KEY` holds the key of the library made (`library_key`).\n/// Covers std's, core's and the prelude's module files (their bytes'\n/// SHA-256, computed in C: reading their headers costs more) and how std\n/// is compiled, under the sources the compiler was built from\n/// (`maker_key`). A compiler built from other sources may make other IR of\n/// the same std; one built from the same sources (the next bootstrap\n/// stage) makes the same.\nfn std_library_key(disk: std.fs.Disk) -> String {\n  maker_key(\"std-library\", [\n      cache.files_part(\n        \".\",\n        deps.module_files(disk, \"std\").map(f -> \"std/\" + f),\n      ),\n      cache.files_part(\n        \".\",\n        core_files() + [\"runtime/prelude.strata\"],\n      ),\n      \"codegen --library\",\n    ]\n    + if toolchain.profiling() {\n      [\"frame pointers\"]\n    } else {\n      []\n    })\n}","old_text":"/// The key of what this compiler makes of std. The cache entry\n/// `std-library-of/KEY` holds the key of the library made (`library_key`).\n/// Covers std's, core's and the prelude's module files (their bytes'\n/// SHA-256, computed in C: reading their headers costs more) and how std\n/// is compiled, under the sources the compiler was built from\n/// (`maker_key`). A compiler built from other sources may make other IR of\n/// the same std; one built from the same sources (the next bootstrap\n/// stage) makes the same.\nfn std_library_key(disk: std.fs.Disk) -> String {\n  maker_key(\"std-library\", [cache.files_part(\n      disk,\n      \".\",\n      deps.module_files(disk, \"std\").map(f -> \"std/\" + f),\n    ), cache.files_part(\n      disk,\n      \".\",\n      core_files() + [\"runtime/prelude.strata\"],\n    ), \"codegen --library\"]\n    + if toolchain.profiling() {\n      [\"frame pointers\"]\n    } else {\n      []\n    })\n}"},{"name":"std_loaded","kind":"fn","old":"1f4b5c43fde803e1","new":"88050de6e2548f2d","interface_changed":true,"affected":["check_command","build_command","test_command","run_command","static_graph","strata_command","graph_command","graph_diff","command_line","diff_command","main","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","verify_command","program_objects","comptime_values","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","linked","expanded","comptime_runner","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","rename_command","move_command","fix_command","edit_in_editor"],"module":"","text":"/// Loads std's precompiled library into this process from its file, for\n/// the literal probes `file_errors` runs. Returns its names (`--precompiled\n/// NAMES`), or nothing when there is none.\nfn std_loaded(lib: Option[driver.StdLibrary]) -> List[String] {\n  match lib {\n    Some(l) => if jit_load(l.shared).to_int() == 0 {\n      [\"--precompiled\", l.names]\n    } else {\n      []\n    },\n    None => [],\n  }\n}","old_text":"/// Loads std's precompiled library into this process from its file, for\n/// the literal probes `file_errors` runs. Returns its names (`--precompiled\n/// NAMES`), or nothing when there is none.\nfn std_loaded(\n  disk: std.fs.Disk,\n  lib: Option[driver.StdLibrary],\n) -> List[String] {\n  match lib {\n    Some(l) => if jit_load(l.shared).to_int() == 0 {\n      [\"--precompiled\", l.names]\n    } else {\n      []\n    },\n    None => [],\n  }\n}"},{"name":"check_command","kind":"fn","old":"23bd4579d7f56c22","new":"ef634ee9682e7065","interface_changed":false,"affected":[],"module":"","text":"/// `strata check`: types, exhaustiveness and literal refinements of the\n/// script or package (`--file`, else the package here). The errors go on\n/// stderr (exit 1), else it says how many definitions check. The warnings\n/// (`compiler/lint`, what `strata fix` changes) go on stderr either way.\nfn check_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n  cwd: String,\n) -> std.process.ExitCode {\n  // (`--json`: the errors and holes)\n  json := driver.given(line, \"--json\")\n  given_path := program_given(disk, line, cwd)\n  file := match given_path {\n    Some(p) => p,\n    None => match target_of(disk, line, cwd) {\n      Ok(f) => f,\n      Err(e) => return fail_with(mut console, e),\n    },\n  }\n  if !disk.exists(file) {\n    return fail_with(mut console, missing(line, file))\n  }\n  match file_problem(disk, file) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  // core's own package: each of its module files is read. Its runtime\n  // modules check only together, when codegen compiles core.rt.\n  if package_name(disk, file) == \"core\" {\n    mut bad := []\n    for rel in deps.module_files(disk, file).sorted() {\n      match disk.read_bytes(file + \"/\" + rel) {\n        Ok(bs) => match binary.decode_module(bs) {\n          Ok(_) => (),\n          Err(e) => mut bad.push((\"core/\" + rel, e)),\n        },\n        Err(_) => mut bad.push((\"core/\" + rel, \"unreadable\")),\n      }\n    }\n    for e in bad {\n      mut console.eprint(\n        error_painted(e, console.paint(std.term.Errors)),\n      )\n    }\n    if bad == [] {\n      for w in core_unused(disk, file) {\n        mut console.eprint(\"warning: \" + w)\n      }\n      print(highlight.ok(console.paint(std.term.Output), \"ok:\")\n        + \" core checks\")\n      return 0\n    }\n    return 1\n  }\n  // a package's settings name what it has (`exports`, `[verify]`)\n  match settings_error(disk, file) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  pre := std_loaded(std_library(mut console, mut disk, process, cache))\n  sh := shared(disk, cache)\n  mut errors := []\n  mut n := 0\n  mut holes := []\n  // (core: each module file on its own)\n  for unit in units_of(disk, file, \"\") {\n    errors += warned(mut console, file_errors(\n      mut launcher,\n      mut disk,\n      cache,\n      \"std\",\n      unit,\n      false,\n      sh.core,\n      sh,\n      pre,\n    ))\n    errors += run_mode_errors(disk, unit)\n    if errors == [] || json {\n      (k, h) := check_summary(mut launcher, mut disk, cache, sh.core, unit)\n      n += k\n      holes += h\n    }\n  }\n  if json {\n    print(driver.pretty_json(\n      driver.JObject([(\"errors\", driver.JList(errors.map(\n        e -> driver.JObject(\n          [(\"decl\", driver.JStr(e.0)), (\"msg\", driver.JStr(e.1))],\n        ),\n      ))), (\"holes\", holes_json(holes))]),\n    ))\n    return if errors == [] {\n      0\n    } else {\n      1\n    }\n  }\n  for w in lint_warnings(lint_decls(disk, file)) {\n    mut console.eprint(w)\n  }\n  if errors != [] {\n    // each with where it is, shown as code (compiler/finding)\n    at := finding.error_places(\n      disk,\n      process,\n      file,\n      errors,\n      console.paint(std.term.Errors),\n    )\n    for (i, e) in enumerate(errors) {\n      mut console.eprint(\n        error_painted(e, console.paint(std.term.Errors)),\n      )\n      match get(at, i) {\n        Some(Some(p)) => mut console.eprint(p),\n        _ => (),\n      }\n    }\n    return 1\n  }\n  k := len(holes)\n  print(highlight.ok(console.paint(std.term.Output), \"ok:\")\n    + f\" {n} definitions check ({k} open holes)\")\n  0\n}","old_text":"/// `strata check`: types, exhaustiveness and literal refinements of the\n/// script or package (`--file`, else the package here). The errors go on\n/// stderr (exit 1), else it says how many definitions check. The warnings\n/// (`compiler/lint`, what `strata fix` changes) go on stderr either way.\nfn check_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n  cwd: String,\n) -> std.process.ExitCode {\n  // (`--json`: the errors and holes)\n  json := driver.given(line, \"--json\")\n  given_path := program_given(disk, line, cwd)\n  file := match given_path {\n    Some(p) => p,\n    None => match target_of(disk, line, cwd) {\n      Ok(f) => f,\n      Err(e) => return fail_with(mut console, e),\n    },\n  }\n  if !disk.exists(file) {\n    return fail_with(mut console, missing(line, file))\n  }\n  match file_problem(disk, file) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  // core's own package: each of its module files is read. Its runtime\n  // modules check only together, when codegen compiles core.rt.\n  if package_name(disk, file) == \"core\" {\n    mut bad := []\n    for rel in deps.module_files(disk, file).sorted() {\n      match disk.read_bytes(file + \"/\" + rel) {\n        Ok(bs) => match binary.decode_module(bs) {\n          Ok(_) => (),\n          Err(e) => mut bad.push((\"core/\" + rel, e)),\n        },\n        Err(_) => mut bad.push((\"core/\" + rel, \"unreadable\")),\n      }\n    }\n    for e in bad {\n      mut console.eprint(\n        error_painted(e, console.paint(std.term.Errors)),\n      )\n    }\n    if bad == [] {\n      for w in core_unused(disk, file) {\n        mut console.eprint(\"warning: \" + w)\n      }\n      print(highlight.ok(console.paint(std.term.Output), \"ok:\")\n        + \" core checks\")\n      return 0\n    }\n    return 1\n  }\n  // a package's settings name what it has (`exports`, `[verify]`)\n  match settings_error(disk, file) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  pre := std_loaded(\n    disk,\n    std_library(mut console, mut disk, process, mut launcher, cache),\n  )\n  sh := shared(disk, cache)\n  mut errors := []\n  mut n := 0\n  mut holes := []\n  // (core: each module file on its own)\n  for unit in units_of(disk, file, \"\") {\n    errors += warned(mut console, file_errors(\n      mut launcher,\n      mut disk,\n      cache,\n      \"std\",\n      unit,\n      false,\n      sh.core,\n      sh,\n      pre,\n    ))\n    errors += run_mode_errors(disk, unit)\n    if errors == [] || json {\n      (k, h) := check_summary(mut launcher, mut disk, cache, sh.core, unit)\n      n += k\n      holes += h\n    }\n  }\n  if json {\n    print(driver.pretty_json(\n      driver.JObject([(\"errors\", driver.JList(errors.map(\n        e -> driver.JObject(\n          [(\"decl\", driver.JStr(e.0)), (\"msg\", driver.JStr(e.1))],\n        ),\n      ))), (\"holes\", holes_json(holes))]),\n    ))\n    return if errors == [] {\n      0\n    } else {\n      1\n    }\n  }\n  for w in lint_warnings(lint_decls(disk, file)) {\n    mut console.eprint(w)\n  }\n  if errors != [] {\n    // each with where it is, shown as code (compiler/finding)\n    at := finding.error_places(\n      disk,\n      process,\n      file,\n      errors,\n      console.paint(std.term.Errors),\n    )\n    for (i, e) in enumerate(errors) {\n      mut console.eprint(\n        error_painted(e, console.paint(std.term.Errors)),\n      )\n      match get(at, i) {\n        Some(Some(p)) => mut console.eprint(p),\n        _ => (),\n      }\n    }\n    return 1\n  }\n  k := len(holes)\n  print(highlight.ok(console.paint(std.term.Output), \"ok:\")\n    + f\" {n} definitions check ({k} open holes)\")\n  0\n}"},{"name":"verify_command","kind":"fn","old":"03b3c0595933083e","new":"618872baab076a2b","interface_changed":false,"affected":[],"module":"","text":"/// `strata verify [SELECTION]` on the script or package (`--file`, else the\n/// package here), with std precompiled loaded; the selection as `--only`.\n/// `--obligations`, `--smt`, `--termination` and `--fuzz` run `smt`, `smt\n/// --queries`, `termination` and `fuzz` instead. Exit 1 on a counterexample\n/// or a broken rule.\nfn verify_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n  cwd: String,\n) -> std.process.ExitCode {\n  given_path := program_given(disk, line, cwd)\n  file := match given_path {\n    Some(p) => p,\n    None => match target_of(disk, line, cwd) {\n      Ok(f) => f,\n      Err(e) => return fail_with(mut console, e),\n    },\n  }\n  mode := match [m for m in [\"--obligations\", \"--termination\", \"--fuzz\", \"--smt\"] where driver.given(line, m)] {\n    [m, ..] => m,\n    _ => \"\",\n  }\n  opts := if mode == \"\" {\n    [\"--cases\", \"--seed\", \"--cross-check\", \"--require\"]\n  } else if mode == \"--fuzz\" {\n    [\"--cases\", \"--seed\"]\n  } else {\n    []\n  }\n  mut args := []\n  for o in opts {\n    match driver.option_value(line, o) {\n      Some(x) => {\n        args += [o, x]\n      },\n      None => (),\n    }\n  }\n  if mode == \"\" {\n    for f in [\"--checks\", \"--no-cache\", \"--json\", \"--show-searches\"] {\n      if driver.given(line, f) {\n        mut args.push(f)\n      }\n    }\n    args += std_flags(std_library(mut console, mut disk, process, cache))\n  }\n  // (the selection follows the program's path, when it is given)\n  selection := get(line.pos, if given_path is Some {\n    2\n  } else {\n    1\n  }) ?? \"\"\n  if selection != \"\" {\n    args += [\"--only\", selection]\n  }\n  s := toolchain.solver(disk, process)\n  // (core: each of its module files the selection names, on its own)\n  mut code := 0\n  for unit in units_of(disk, file, selection) {\n    one := args + [unit]\n    c := match mode {\n      \"\" => verify_file(\n        mut console,\n        mut launcher,\n        mut disk,\n        cache,\n        s,\n        toolchain.c_compiler(process),\n        one,\n      ),\n      \"--obligations\" => {\n        smt_file(mut launcher, mut disk, cache, s, one)\n        0\n      },\n      \"--smt\" => {\n        smt_file(\n          mut launcher,\n          mut disk,\n          cache,\n          s,\n          [\"--queries\"] + one,\n        )\n        0\n      },\n      \"--termination\" => {\n        termination_file(mut launcher, mut disk, cache, s, one)\n        0\n      },\n      _ => {\n        fuzz_file(disk, cache, one)\n        0\n      },\n    }\n    if c > code {\n      code = c\n    }\n  }\n  code\n}","old_text":"/// `strata verify [SELECTION]` on the script or package (`--file`, else the\n/// package here), with std precompiled loaded; the selection as `--only`.\n/// `--obligations`, `--smt`, `--termination` and `--fuzz` run `smt`, `smt\n/// --queries`, `termination` and `fuzz` instead. Exit 1 on a counterexample\n/// or a broken rule.\nfn verify_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n  cwd: String,\n) -> std.process.ExitCode {\n  given_path := program_given(disk, line, cwd)\n  file := match given_path {\n    Some(p) => p,\n    None => match target_of(disk, line, cwd) {\n      Ok(f) => f,\n      Err(e) => return fail_with(mut console, e),\n    },\n  }\n  mode := match [m for m in [\"--obligations\", \"--termination\", \"--fuzz\", \"--smt\"] where driver.given(line, m)] {\n    [m, ..] => m,\n    _ => \"\",\n  }\n  opts := if mode == \"\" {\n    [\"--cases\", \"--seed\", \"--cross-check\", \"--require\"]\n  } else if mode == \"--fuzz\" {\n    [\"--cases\", \"--seed\"]\n  } else {\n    []\n  }\n  mut args := []\n  for o in opts {\n    match driver.option_value(line, o) {\n      Some(x) => {\n        args += [o, x]\n      },\n      None => (),\n    }\n  }\n  if mode == \"\" {\n    for f in [\"--checks\", \"--no-cache\", \"--json\", \"--show-searches\"] {\n      if driver.given(line, f) {\n        mut args.push(f)\n      }\n    }\n    args += std_flags(\n      std_library(\n        mut console,\n        mut disk,\n        process,\n        mut launcher,\n        cache,\n      ),\n    )\n  }\n  // (the selection follows the program's path, when it is given)\n  selection := get(line.pos, if given_path is Some {\n    2\n  } else {\n    1\n  }) ?? \"\"\n  if selection != \"\" {\n    args += [\"--only\", selection]\n  }\n  s := toolchain.solver(disk, process)\n  // (core: each of its module files the selection names, on its own)\n  mut code := 0\n  for unit in units_of(disk, file, selection) {\n    one := args + [unit]\n    c := match mode {\n      \"\" => verify_file(\n        mut console,\n        mut launcher,\n        mut disk,\n        cache,\n        s,\n        toolchain.c_compiler(process),\n        one,\n      ),\n      \"--obligations\" => {\n        smt_file(mut launcher, mut disk, cache, s, one)\n        0\n      },\n      \"--smt\" => {\n        smt_file(\n          mut launcher,\n          mut disk,\n          cache,\n          s,\n          [\"--queries\"] + one,\n        )\n        0\n      },\n      \"--termination\" => {\n        termination_file(mut launcher, mut disk, cache, s, one)\n        0\n      },\n      _ => {\n        fuzz_file(disk, cache, one)\n        0\n      },\n    }\n    if c > code {\n      code = c\n    }\n  }\n  code\n}"},{"name":"build_command","kind":"fn","old":"1023b4bccb946cda","new":"781abfe654aca79c","interface_changed":false,"affected":[],"module":"","text":"/// `strata build [PATH] [-o OUT] [--lib] [--emit-llvm] [--all-checks]\n/// [--no-verify]`: the program compiled by compiler/codegen, without the\n/// checks `verify` proves of it now (`build_proofs`; with `--no-verify`\n/// every check is kept), then made an\n/// executable (compiler/toolchain), or with `--lib` a shared library of\n/// what its `derive C for f`s export, with its C header. Linked with\n/// core.rt, the C runtime, std's precompiled object and the package's own\n/// C (`linked`). The IR is cached under the bytes of the files it is made\n/// of (`built_ir`), and its objects part by part (`linked`).\nfn build_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n  cwd: String,\n  home: String,\n) -> std.process.ExitCode {\n  path := match get(line.pos, 1) {\n    Some(p) => driver.absolute_path(cwd, p),\n    None => match target_of(disk, line, cwd) {\n      Ok(f) => f,\n      Err(e) => return fail_with(mut console, e),\n    },\n  }\n  if !disk.exists(path) {\n    return fail_with(mut console, missing(line, path))\n  }\n  lib := std_library(mut console, mut disk, process, cache)\n  // (`[check] unused = \"error\"`: the program must check as `strata check`\n  // checks it, with nothing unused, before it is built)\n  if unused_setting(disk, path).1 {\n    sh0 := shared(disk, cache)\n    refused := warned(mut console, file_errors(\n      mut launcher,\n      mut disk,\n      cache,\n      \"std\",\n      path,\n      false,\n      sh0.core,\n      sh0,\n      std_loaded(lib),\n    ))\n    if refused != [] {\n      for e in refused {\n        mut console.eprint(\n          error_painted(e, console.paint(std.term.Errors)),\n        )\n      }\n      return 1\n    }\n  }\n  // (`--no-verify`: no proofs, every check kept. What earlier `verify` runs\n  // recorded is history, not these sources' answer: with it, the same\n  // sources would build other bytes from another cache)\n  facts := if driver.given(line, \"--all-checks\")\n    || driver.given(line, \"--no-verify\") {\n    []\n  } else {\n    build_proofs(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      lib,\n      path,\n      true,\n    )\n  }\n  // (an invariant verify didn't prove is checked at every pass, a contract\n  // walking a list at every call, and an assumed contract not proven is\n  // never checked: each is said once)\n  // (the clauses as verify writes them, lambdas typed: only for a program\n  // with an assumed contract or a contract walking a list)\n  raw := own_decls(disk, source_files(disk, path))\n  ds := if driver.given(line, \"--all-checks\")\n    || !raw.any(d -> contract_heavy(d)) {\n    []\n  } else {\n    verified_with(disk, [path], []).0\n  }\n  warned := if driver.given(line, \"--all-checks\") {\n    []\n  } else {\n    kept_invariants(facts, assumed_texts(ds))\n      + runtime_contracts(ds, facts)\n  }\n  for w in warned {\n    mut console.eprint(w)\n  }\n  scratch := scratch_of(mut disk, cache, \"build\")\n  proofs := scratch + \"/proofs.txt\"\n  match mut disk.write(proofs, join(facts, \"\\n\")) {\n    _ => (),\n  }\n  // (`--memory-sites`: std compiled with the program, its sites counted\n  // too)\n  reports := [\"--copies\", \"--memory-sites\"].filter(f -> driver.given(line, f))\n  linked_lib := if driver.given(line, \"--memory-sites\") {\n    None\n  } else {\n    lib\n  }\n  pre := match linked_lib {\n      Some(l) => [\"--precompiled\", l.names],\n      None => [],\n    }\n    + if driver.given(line, \"--lib\") {\n      [\"--lib\"]\n    } else {\n      []\n    }\n  sh := shared(disk, cache)\n  (ir, errors) := built_ir(mut disk, sh, home, path, proofs, pre, reports)\n  result := if errors == [\"error: no `main` function\"] {\n    Err(\n      if driver.given(line, \"--lib\") {\n        \"nothing to export: a library exports what `derive C for f` names (std.ffi)\"\n      } else {\n        \"no `main` function to compile\"\n      },\n    )\n  } else if main_asks(errors) is Some {\n    Err(main_asks(errors) ?? \"\")\n  } else if errors != [] {\n    Err(\"compiler/codegen doesn't cover this program yet:\\n\"\n      + placed(\n        disk,\n        process,\n        path,\n        errors,\n        console.paint(std.term.Errors),\n      ))\n  } else if driver.given(line, \"--emit-llvm\") {\n    match driver.option_value(line, \"-o\") {\n      Some(o) => match mut disk.write(driver.absolute_path(cwd, o), ir) {\n        Ok(_) => Ok(\"\"),\n        Err(_) => Err(f\"{o}: can't write it\"),\n      },\n      None => {\n        mut console.write(ir)\n        Ok(\"\")\n      },\n    }\n  } else {\n    linked(\n      mut disk,\n      process,\n      mut launcher,\n      sh,\n      line,\n      cwd,\n      home,\n      linked_lib,\n      path,\n      scratch,\n      ir,\n    )\n  }\n  match mut disk.remove_all(scratch) {\n    _ => (),\n  }\n  match result {\n    Ok(said) => {\n      if said != \"\" {\n        // (with the proofs of `verify`: how many checks they left out)\n        print(said\n          + if facts == [] {\n            \"\"\n          } else {\n            checks_said(ir)\n          })\n      }\n      0\n    },\n    Err(e) => fail_with(mut console, e),\n  }\n}","old_text":"/// `strata build [PATH] [-o OUT] [--lib] [--emit-llvm] [--all-checks]\n/// [--no-verify]`: the program compiled by compiler/codegen, without the\n/// checks `verify` proves of it now (`build_proofs`; with `--no-verify`\n/// every check is kept), then made an\n/// executable (compiler/toolchain), or with `--lib` a shared library of\n/// what its `derive C for f`s export, with its C header. Linked with\n/// core.rt, the C runtime, std's precompiled object and the package's own\n/// C (`linked`). The IR is cached under the bytes of the files it is made\n/// of (`built_ir`), and its objects part by part (`linked`).\nfn build_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n  cwd: String,\n  home: String,\n) -> std.process.ExitCode {\n  path := match get(line.pos, 1) {\n    Some(p) => driver.absolute_path(cwd, p),\n    None => match target_of(disk, line, cwd) {\n      Ok(f) => f,\n      Err(e) => return fail_with(mut console, e),\n    },\n  }\n  if !disk.exists(path) {\n    return fail_with(mut console, missing(line, path))\n  }\n  lib := std_library(mut console, mut disk, process, mut launcher, cache)\n  // (`[check] unused = \"error\"`: the program must check as `strata check`\n  // checks it, with nothing unused, before it is built)\n  if unused_setting(disk, path).1 {\n    sh0 := shared(disk, cache)\n    refused := warned(mut console, file_errors(\n      mut launcher,\n      mut disk,\n      cache,\n      \"std\",\n      path,\n      false,\n      sh0.core,\n      sh0,\n      std_loaded(disk, lib),\n    ))\n    if refused != [] {\n      for e in refused {\n        mut console.eprint(\n          error_painted(e, console.paint(std.term.Errors)),\n        )\n      }\n      return 1\n    }\n  }\n  // (`--no-verify`: no proofs, every check kept. What earlier `verify` runs\n  // recorded is history, not these sources' answer: with it, the same\n  // sources would build other bytes from another cache)\n  facts := if driver.given(line, \"--all-checks\")\n    || driver.given(line, \"--no-verify\") {\n    []\n  } else {\n    build_proofs(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      lib,\n      path,\n      true,\n    )\n  }\n  // (an invariant verify didn't prove is checked at every pass, a contract\n  // walking a list at every call, and an assumed contract not proven is\n  // never checked: each is said once)\n  // (the clauses as verify writes them, lambdas typed: only for a program\n  // with an assumed contract or a contract walking a list)\n  raw := own_decls(disk, source_files(disk, path))\n  ds := if driver.given(line, \"--all-checks\")\n    || !raw.any(d -> contract_heavy(d)) {\n    []\n  } else {\n    verified_with(disk, [path], []).0\n  }\n  warned := if driver.given(line, \"--all-checks\") {\n    []\n  } else {\n    kept_invariants(facts, assumed_texts(ds))\n      + runtime_contracts(ds, facts)\n  }\n  for w in warned {\n    mut console.eprint(w)\n  }\n  scratch := scratch_of(mut disk, cache, \"build\")\n  proofs := scratch + \"/proofs.txt\"\n  match mut disk.write(proofs, join(facts, \"\\n\")) {\n    _ => (),\n  }\n  // (`--memory-sites`: std compiled with the program, its sites counted\n  // too)\n  reports := [\"--copies\", \"--memory-sites\"].filter(f -> driver.given(line, f))\n  linked_lib := if driver.given(line, \"--memory-sites\") {\n    None\n  } else {\n    lib\n  }\n  pre := match linked_lib {\n      Some(l) => [\"--precompiled\", l.names],\n      None => [],\n    }\n    + if driver.given(line, \"--lib\") {\n      [\"--lib\"]\n    } else {\n      []\n    }\n  sh := shared(disk, cache)\n  (ir, errors) := built_ir(mut disk, sh, home, path, proofs, pre, reports)\n  result := if errors == [\"error: no `main` function\"] {\n    Err(\n      if driver.given(line, \"--lib\") {\n        \"nothing to export: a library exports what `derive C for f` names (std.ffi)\"\n      } else {\n        \"no `main` function to compile\"\n      },\n    )\n  } else if main_asks(errors) is Some {\n    Err(main_asks(errors) ?? \"\")\n  } else if errors != [] {\n    Err(\"compiler/codegen doesn't cover this program yet:\\n\"\n      + placed(\n        disk,\n        process,\n        path,\n        errors,\n        console.paint(std.term.Errors),\n      ))\n  } else if driver.given(line, \"--emit-llvm\") {\n    match driver.option_value(line, \"-o\") {\n      Some(o) => match mut disk.write(driver.absolute_path(cwd, o), ir) {\n        Ok(_) => Ok(\"\"),\n        Err(_) => Err(f\"{o}: can't write it\"),\n      },\n      None => {\n        mut console.write(ir)\n        Ok(\"\")\n      },\n    }\n  } else {\n    linked(\n      mut disk,\n      process,\n      mut launcher,\n      sh,\n      line,\n      cwd,\n      home,\n      linked_lib,\n      path,\n      scratch,\n      ir,\n    )\n  }\n  match mut disk.remove_all(scratch) {\n    _ => (),\n  }\n  match result {\n    Ok(said) => {\n      if said != \"\" {\n        // (with the proofs of `verify`: how many checks they left out)\n        print(said\n          + if facts == [] {\n            \"\"\n          } else {\n            checks_said(ir)\n          })\n      }\n      0\n    },\n    Err(e) => fail_with(mut console, e),\n  }\n}"},{"name":"test_command","kind":"fn","old":"3d93a0e4c9ed8c56","new":"b8ce27f4fe40e32e","interface_changed":false,"affected":[],"module":"","text":"/// `strata test [FILTER] [--with-deps]`: compiles the tests of the script\n/// or package (`--file`, else the package here) with compiler/codegen\n/// (`codegen --tests`) and runs each in the JIT on its own (a fault ends\n/// it), in the current folder. Prints `✓ NAME`, or `✗ NAME` with the fault,\n/// its stack and what it printed; then how many passed. Exit 1 when one\n/// failed.\nfn test_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n  cwd: String,\n) -> std.process.ExitCode {\n  file := match target_of(disk, line, cwd) {\n    Ok(f) => f,\n    Err(e) => return fail_with(mut console, e),\n  }\n  if !disk.exists(file) {\n    return fail_with(mut console, missing(line, file))\n  }\n  filter := get(line.pos, 1) ?? \"\"\n  sh := shared(disk, cache)\n  // the program checks first, as `strata check` checks it. core's own tests:\n  // its module files, as `check` reads them; its runtime modules check only\n  // together, compiled.\n  errors := if package_name(disk, file) == \"core\" {\n    []\n  } else {\n    lib := std_library(mut console, mut disk, process, cache)\n    warned(mut console, file_errors(\n      mut launcher,\n      mut disk,\n      cache,\n      \"std\",\n      file,\n      false,\n      sh.core,\n      sh,\n      std_loaded(lib),\n    ))\n  }\n  if errors != [] {\n    for e in errors {\n      mut console.eprint(\n        error_painted(e, console.paint(std.term.Errors)),\n      )\n    }\n    return 1\n  }\n  // `--with-deps`: the tests of what it imports too (std's modules, its\n  // dependencies), named after their module, before its own\n  deps := if driver.given(line, \"--with-deps\") {\n    dep_test_decls(mut launcher, mut disk, cache, sh.core, file)\n  } else {\n    []\n  }\n  first := set(deps.map(\n    d -> match d.kind {\n      ast.TestDef(t) => t.name,\n      _ => \"\",\n    },\n  ))\n  copies := if driver.given(line, \"--copies\") {\n    [\"--copies\"]\n  } else {\n    []\n  }\n  ir := codegen_with(\n    disk,\n    sh,\n    copies + assumed_flag(line) + [\"--tests\", file],\n    deps,\n  )\n  errors := driver.codegen_errors(ir)\n  if errors != [] {\n    return fail_with(\n      mut console,\n      \"compiler/codegen doesn't cover these tests yet:\\n\"\n        + placed(\n          disk,\n          process,\n          file,\n          errors,\n          console.paint(std.term.Errors),\n        ),\n    )\n  }\n  // (`--emit-llvm`: the tests' IR, each `strata.test.N`)\n  if driver.given(line, \"--emit-llvm\") {\n    mut console.write(ir)\n    return 0\n  }\n  // a package's own C (`[native]` in strata.toml), for its `extern c`\n  // functions: built (once, as `verify` builds it) and loaded\n  if !ends_with(file, \".strata\") {\n    load_native(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      file,\n    )\n  }\n  m := jit_fuzz_load(ir).to_int()\n  if m < 0 {\n    return fail_with(\n      mut console,\n      \"the JIT can't compile the tests: \" + jit_fuzz_error(),\n    )\n  }\n  match driver_chdir(cwd).to_int() {\n    _ => (),\n  }\n  p := console.paint(std.term.Output)\n  mut passed := 0\n  mut failed := 0\n  // (what it imports first, then its own, each in order)\n  mut theirs := []\n  mut ours := []\n  for x in driver.test_names(ir) {\n    if contains(first, x.1) {\n      mut theirs.push(x)\n    } else {\n      mut ours.push(x)\n    }\n  }\n  for (n, name) in theirs + ours {\n    if contains(name, filter) {\n      if jit_test_case(m.wrap_i32(), n.wrap_i64()).to_int() == 0 {\n        passed += 1\n        print(highlight.ok(p, \"✓ \" + name))\n      } else {\n        failed += 1\n        print(highlight.bad(p, \"✗ \" + name))\n        print(\n          fault_painted(jit_fault_kind(), jit_fault_message(), p),\n        )\n        stack := jit_fault_stack()\n        if stack != \"\" {\n          print(\"    stack: \" + stack)\n        }\n        printed := jit_test_printed()\n        if printed != \"\" {\n          print(\"    printed:\")\n          for l in lines(printed) {\n            print(\"      \" + l)\n          }\n        }\n      }\n    }\n  }\n  // (core's runtime modules' tests are left out, and it says so)\n  if package_name(disk, file) == \"core\" {\n    n := len(package_decls(disk, file, \"core\").filter(\n      d ->\n        d.kind is ast.TestDef && builtins.runtime_module(d.module),\n    ))\n    if n > 0 {\n      print(\n        f\"({n} tests of core's runtime modules not run: those modules compile only together, into the runtime, `strata build-core`)\",\n      )\n    }\n  }\n  print(\"\")\n  print(if passed > 0 {\n      highlight.ok(p, f\"{passed} passed\")\n    } else {\n      f\"{passed} passed\"\n    }\n    + \", \"\n    + if failed > 0 {\n      highlight.bad(p, f\"{failed} failed\")\n    } else {\n      f\"{failed} failed\"\n    })\n  if failed == 0 {\n    0\n  } else {\n    1\n  }\n}","old_text":"/// `strata test [FILTER] [--with-deps]`: compiles the tests of the script\n/// or package (`--file`, else the package here) with compiler/codegen\n/// (`codegen --tests`) and runs each in the JIT on its own (a fault ends\n/// it), in the current folder. Prints `✓ NAME`, or `✗ NAME` with the fault,\n/// its stack and what it printed; then how many passed. Exit 1 when one\n/// failed.\nfn test_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n  cwd: String,\n) -> std.process.ExitCode {\n  file := match target_of(disk, line, cwd) {\n    Ok(f) => f,\n    Err(e) => return fail_with(mut console, e),\n  }\n  if !disk.exists(file) {\n    return fail_with(mut console, missing(line, file))\n  }\n  filter := get(line.pos, 1) ?? \"\"\n  sh := shared(disk, cache)\n  // the program checks first, as `strata check` checks it. core's own tests:\n  // its module files, as `check` reads them; its runtime modules check only\n  // together, compiled.\n  errors := if package_name(disk, file) == \"core\" {\n    []\n  } else {\n    lib := std_library(mut console, mut disk, process, mut launcher, cache)\n    warned(mut console, file_errors(\n      mut launcher,\n      mut disk,\n      cache,\n      \"std\",\n      file,\n      false,\n      sh.core,\n      sh,\n      std_loaded(disk, lib),\n    ))\n  }\n  if errors != [] {\n    for e in errors {\n      mut console.eprint(\n        error_painted(e, console.paint(std.term.Errors)),\n      )\n    }\n    return 1\n  }\n  // `--with-deps`: the tests of what it imports too (std's modules, its\n  // dependencies), named after their module, before its own\n  deps := if driver.given(line, \"--with-deps\") {\n    dep_test_decls(mut launcher, mut disk, cache, sh.core, file)\n  } else {\n    []\n  }\n  first := set(deps.map(\n    d -> match d.kind {\n      ast.TestDef(t) => t.name,\n      _ => \"\",\n    },\n  ))\n  copies := if driver.given(line, \"--copies\") {\n    [\"--copies\"]\n  } else {\n    []\n  }\n  ir := codegen_with(\n    disk,\n    sh,\n    copies + assumed_flag(line) + [\"--tests\", file],\n    deps,\n  )\n  errors := driver.codegen_errors(ir)\n  if errors != [] {\n    return fail_with(\n      mut console,\n      \"compiler/codegen doesn't cover these tests yet:\\n\"\n        + placed(\n          disk,\n          process,\n          file,\n          errors,\n          console.paint(std.term.Errors),\n        ),\n    )\n  }\n  // (`--emit-llvm`: the tests' IR, each `strata.test.N`)\n  if driver.given(line, \"--emit-llvm\") {\n    mut console.write(ir)\n    return 0\n  }\n  // a package's own C (`[native]` in strata.toml), for its `extern c`\n  // functions: built (once, as `verify` builds it) and loaded\n  if !ends_with(file, \".strata\") {\n    load_native(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      file,\n    )\n  }\n  m := jit_fuzz_load(ir).to_int()\n  if m < 0 {\n    return fail_with(\n      mut console,\n      \"the JIT can't compile the tests: \" + jit_fuzz_error(),\n    )\n  }\n  match driver_chdir(cwd).to_int() {\n    _ => (),\n  }\n  p := console.paint(std.term.Output)\n  mut passed := 0\n  mut failed := 0\n  // (what it imports first, then its own, each in order)\n  mut theirs := []\n  mut ours := []\n  for x in driver.test_names(ir) {\n    if contains(first, x.1) {\n      mut theirs.push(x)\n    } else {\n      mut ours.push(x)\n    }\n  }\n  for (n, name) in theirs + ours {\n    if contains(name, filter) {\n      if jit_test_case(m.wrap_i32(), n.wrap_i64()).to_int() == 0 {\n        passed += 1\n        print(highlight.ok(p, \"✓ \" + name))\n      } else {\n        failed += 1\n        print(highlight.bad(p, \"✗ \" + name))\n        print(\n          fault_painted(jit_fault_kind(), jit_fault_message(), p),\n        )\n        stack := jit_fault_stack()\n        if stack != \"\" {\n          print(\"    stack: \" + stack)\n        }\n        printed := jit_test_printed()\n        if printed != \"\" {\n          print(\"    printed:\")\n          for l in lines(printed) {\n            print(\"      \" + l)\n          }\n        }\n      }\n    }\n  }\n  // (core's runtime modules' tests are left out, and it says so)\n  if package_name(disk, file) == \"core\" {\n    n := len(package_decls(disk, file, \"core\").filter(\n      d ->\n        d.kind is ast.TestDef && builtins.runtime_module(d.module),\n    ))\n    if n > 0 {\n      print(\n        f\"({n} tests of core's runtime modules not run: those modules compile only together, into the runtime, `strata build-core`)\",\n      )\n    }\n  }\n  print(\"\")\n  print(if passed > 0 {\n      highlight.ok(p, f\"{passed} passed\")\n    } else {\n      f\"{passed} passed\"\n    }\n    + \", \"\n    + if failed > 0 {\n      highlight.bad(p, f\"{failed} failed\")\n    } else {\n      f\"{failed} failed\"\n    })\n  if failed == 0 {\n    0\n  } else {\n    1\n  }\n}"},{"name":"run_command","kind":"fn","old":"67f9beebb46cde96","new":"2e6b7bd6bf2fb7c3","interface_changed":false,"affected":[],"module":"","text":"/// `strata run [PATH] [--trace] [--all-checks] [--no-verify]\n/// [--wait-for-proofs] [--verify-alongside] [-- ARGS]`: checks the program\n/// (PATH, else `--file`, else the package here), compiles it with\n/// compiler/codegen without the checks `verify` proved, and runs it in the\n/// JIT in this process, in the current folder, with ARGS. The exit code is\n/// the program's.\n/// \n/// A program changed since it was last verified starts at once with the\n/// checks not proven yet, while it is verified alongside (`run_verifying`,\n/// `start_alongside`). The proven code is swapped in while it runs, and\n/// the next run starts with it.\nfn run_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n  cwd: String,\n) -> std.process.ExitCode {\n  // `strata run hello.strata`: the program's path in place of --file\n  first := get(line.pos, 1) ?? \"\"\n  named := first != \"\"\n    && (ends_with(first, \".strata\")\n      || disk.exists(driver.absolute_path(cwd, first) + \"/strata.toml\"))\n  path := if named {\n    driver.absolute_path(cwd, first)\n  } else {\n    match target_of(disk, line, cwd) {\n      Ok(f) => f,\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  if !disk.exists(path) {\n    return fail_with(mut console, missing(line, path))\n  }\n  match file_problem(disk, path) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  rest := drop(line.pos, if named {\n    2\n  } else {\n    1\n  })\n  lib := std_library(mut console, mut disk, process, cache)\n  sh := shared(disk, cache)\n  // (a package's settings, each one of its values: `[json] unknown_keys`)\n  match settings_error(disk, path) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  errors := warned(mut console, file_errors(\n    mut launcher,\n    mut disk,\n    cache,\n    \"std\",\n    path,\n    false,\n    sh.core,\n    sh,\n    std_loaded(lib),\n  ))\n  if errors != [] {\n    for e in errors {\n      mut console.eprint(error_text(e))\n    }\n    return 1\n  }\n  if rest != [] {\n    return call_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n      path,\n      lib,\n      rest,\n    )\n  }\n  // the checks the last `verify` proved are left out (`--all-checks` keeps\n  // them all). With `--wait-for-proofs`, what changed is verified first, as\n  // `build` does.\n  verifying := run_verifying(line)\n  facts := if driver.given(line, \"--all-checks\") {\n    []\n  } else {\n    build_proofs(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      lib,\n      path,\n      verifying is WaitForProofs,\n    )\n  }\n  scratch := scratch_of(mut disk, cache, \"run\")\n  proofs := scratch + \"/proofs.txt\"\n  not_covered := scratch + \"/errors.txt\"\n  match mut disk.write(proofs, join(facts, \"\\n\")) {\n    _ => (),\n  }\n  // (`--trace`: std's functions are compiled with the program, so their\n  // calls are traced too; `--memory-sites`: so their sites are counted)\n  traced := driver.given(line, \"--trace\")\n    || driver.given(line, \"--memory-sites\")\n  mut loads := match lib {\n    Some(l) => if traced {\n      []\n    } else {\n      [\"--load\", l.shared]\n    },\n    None => [],\n  }\n  // the package's C (`[native]`), for its `extern c` functions: a shared\n  // library loaded too\n  native := scratch + \"/native.dylib\"\n  match deps.native_library(\n    mut launcher,\n    mut disk,\n    toolchain.c_compiler(process),\n    path,\n    native,\n  ) {\n    Ok(true) => {\n      loads += [\"--load\", native]\n    },\n    Ok(false) => (),\n    Err(e) => {\n      match mut disk.remove_all(scratch) {\n        _ => (),\n      }\n      return fail_with(mut console, e)\n    },\n  }\n  pre := match lib {\n    Some(l) => if traced {\n      []\n    } else {\n      [\"--precompiled\", l.names]\n    },\n    None => [],\n  }\n  trace := if driver.given(line, \"--trace\") {\n    [\"--trace\"]\n  } else {\n    []\n  }\n  // (`--copies`: the copies the program makes are reported when it ends;\n  // `--memory-sites`: its counting operations, by site)\n  copies := [\"--copies\", \"--memory-sites\"].filter(f -> driver.given(line, f))\n  // (a program changed since it was last verified: verified alongside, and\n  // compiled swappable)\n  if verifying is VerifyAlongside\n    && !driver.given(line, \"--all-checks\") {\n    start_alongside(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      path,\n      facts,\n      cwd,\n      pre + trace + copies + assumed_flag(line),\n    )\n  }\n  code := jit_file(mut disk, cache, loads\n    + [\n      \"--name\",\n      program_name_of(disk, path),\n      \"--errors\",\n      not_covered,\n      \"--dir\",\n      cwd,\n      \"--scratch\",\n      scratch,\n      \"--proofs\",\n      proofs,\n    ]\n    + pre\n    + trace\n    + copies\n    + assumed_flag(line)\n    + [path, \"--\"]\n    + line.after)\n  // (when the program ran, `jit_file` ended the process with its exit code:\n  // here, it couldn't run)\n  uncovered := match disk.read(not_covered) {\n    Ok(t) => [l for l in lines(t) where starts_with(l, \"error:\")],\n    Err(_) => [],\n  }\n  match mut disk.remove_all(scratch) {\n    _ => (),\n  }\n  if code == 3 && uncovered == [\"error: no `main` function\"] {\n    return fail_with(\n      mut console,\n      \"no `main` function to run (the entry point is `fn main` in main.strata, or in the file you run)\",\n    )\n  }\n  match main_asks(uncovered) {\n    Some(e) => if code == 3 {\n      return fail_with(mut console, e)\n    },\n    None => (),\n  }\n  if code == 3 && uncovered != [] {\n    return fail_with(\n      mut console,\n      \"compiler/codegen doesn't cover this program yet:\\n\"\n        + placed(\n          disk,\n          process,\n          path,\n          uncovered,\n          console.paint(std.term.Errors),\n        ),\n    )\n  }\n  code\n}","old_text":"/// `strata run [PATH] [--trace] [--all-checks] [--no-verify]\n/// [--wait-for-proofs] [--verify-alongside] [-- ARGS]`: checks the program\n/// (PATH, else `--file`, else the package here), compiles it with\n/// compiler/codegen without the checks `verify` proved, and runs it in the\n/// JIT in this process, in the current folder, with ARGS. The exit code is\n/// the program's.\n/// \n/// A program changed since it was last verified starts at once with the\n/// checks not proven yet, while it is verified alongside (`run_verifying`,\n/// `start_alongside`). The proven code is swapped in while it runs, and\n/// the next run starts with it.\nfn run_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n  cwd: String,\n) -> std.process.ExitCode {\n  // `strata run hello.strata`: the program's path in place of --file\n  first := get(line.pos, 1) ?? \"\"