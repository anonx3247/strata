 the\n/// others.\nfn by_variant(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  cs: List[String],\n  targs: List[check.Ty],\n  k: String,\n  name: String,\n  args: List[ast.Expr],\n  want: check.Ty,\n) -> codegen.V {\n  labels := codegen.on_ctor(mut g, v, cs)\n  end := codegen.label(mut g, \"variant.end\")\n  mut incoming := []\n  for (j, c) in enumerate(cs) {\n    codegen.block(mut g, get(labels, j) ?? \"\")\n    codegen.push_transparent(mut g)\n    r0 := if codegen.own_method(g, c, name) {\n      ck := codegen.method_key(mut g, c, name)\n      codegen.call_fn_want(\n        mut g,\n        ck,\n        [\n          codegen.V { ..v, ty: check.TNamed { name: c, args: targs } },\n        ],\n        args,\n        want,\n      )\n    } else {\n      codegen.call_fn_want(mut g, k, [v], args, want)\n    }\n    r := codegen.leave_branch(mut g, r0)\n    mut incoming.push((r, codegen.current(g)))\n    codegen.br(mut g, end)\n  }\n  codegen.block(mut g, end)\n  r := codegen.join_values(mut g, incoming)\n  codegen.temp(mut g, r)\n}","old_text":"/// `v.name(args)` on sum value `v` where some variants (`cs`) have their\n/// own method: a variant's own for its values, the sum's (`k`) for the\n/// others.\nfn by_variant(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  cs: List[String],\n  targs: List[Ty],\n  k: String,\n  name: String,\n  args: List[ast.Expr],\n  want: Ty,\n) -> codegen.V {\n  labels := codegen.on_ctor(mut g, v, cs)\n  end := codegen.label(mut g, \"variant.end\")\n  mut incoming := []\n  for (j, c) in enumerate(cs) {\n    codegen.block(mut g, get(labels, j) ?? \"\")\n    codegen.push_transparent(mut g)\n    r0 := if codegen.own_method(g, c, name) {\n      ck := codegen.method_key(mut g, c, name)\n      codegen.call_fn_want(\n        mut g,\n        ck,\n        [codegen.V { ..v, ty: TNamed { name: c, args: targs } }],\n        args,\n        want,\n      )\n    } else {\n      codegen.call_fn_want(mut g, k, [v], args, want)\n    }\n    r := codegen.leave_branch(mut g, r0)\n    mut incoming.push((r, codegen.current(g)))\n    codegen.br(mut g, end)\n  }\n  codegen.block(mut g, end)\n  r := codegen.join_values(mut g, incoming)\n  codegen.temp(mut g, r)\n}"},{"name":"codegen.union_field","kind":"fn","old":"3c9a3e6c696afc9d","new":"4b1f0c14000573c5","interface_changed":true,"affected":["codegen.get_field","codegen.expr_node","codegen.expr","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.method_call","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.try_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.expr_want_node","codegen.compared","codegen.stmt_node","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.binds","codegen.matching_v","codegen.match_got","codegen.assertion","codegen.invariants","codegen.tag_is","codegen.check_type","codegen.satisfies","codegen.holds_pred","codegen.function","codegen.entry","codegen.vtable","codegen.mock_table","codegen.mock_call","codegen.list_builtin","codegen.collection_builtin","codegen.list_literal_of","codegen.produce","codegen.wanted","codegen.table_find","codegen.generate","codegen.construct","codegen.operands","codegen.if_expr","codegen.matching","codegen.try_expr","codegen.builtin_call","codegen.expr_want","codegen.stmt","codegen.call_fn_want","codegen.built_or_generated","codegen.options","codegen.to_c","codegen.check_payload","cod