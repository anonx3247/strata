files","apply_change","apply_edit","fix_loops","with_base","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// The order of union values: by member index, then as that member.\nfn union_cmp(\n  mut g: codegen.Gen,\n  a: codegen.V,\n  b: codegen.V,\n  ms: List[check.Ty],\n) {\n  la := codegen.on_members(mut g, a, ms)\n  for (i, ma) in enumerate(ms) {\n    codegen.block(mut g, get(la, i) ?? \"\")\n    lb := codegen.on_members(mut g, b, ms)\n    for (j, _) in enumerate(ms) {\n      codegen.block(mut g, get(lb, j) ?? \"\")\n      if i != j {\n        codegen.emit(mut g, if i < j {\n          \"ret i64 -1\"\n        } else {\n          \"ret i64 1\"\n        })\n      } else {\n        f := codegen.cmp_helper(mut g, ma)\n        x := codegen.narrow(mut g, a, ma)\n        y := codegen.narrow(mut g, b, ma)\n        c := codegen.fresh(mut g, \"c\")\n        args := join([x, y]\n          .filter(v -> codegen.has_value(v.ty))\n          .map(v -> codegen.ll(v.ty) + \" \" + v.op), \", \")\n        codegen.emit(mut g, f\"{c} = call i64 {f}({args})\")\n        codegen.emit(mut g, f\"ret i64 {c}\")\n      }\n    }\n  }\n}","old_text":"/// The order of union values: by member index, then as that member.\nfn union_cmp(mut g: codegen.Gen, a: codegen.V, b: codegen.V, ms: List[Ty]) {\n  la := codegen.on_members(mut g, a, ms)\n  for (i, ma) in enumerate(ms) {\n    codegen.block(mut g, get(la, i) ?? \"\")\n    lb := codegen.on_members(mut g, b, ms)\n    for (j, _) in enumerate(ms) {\n      codegen.block(mut g, get(lb, j) ?? \"\")\n      if i != j {\n        codegen.emit(mut g, if i < j {\n          \"ret i64 -1\"\n        } else {\n          \"ret i64 1\"\n        })\n      } else {\n        f := codegen.cmp_helper(mut g, ma)\n        x := codegen.narrow(mut g, a, ma)\n        y := codegen.narrow(mut g, b, ma)\n        c := codegen.fresh(mut g, \"c\")\n        args := join([x, y]\n          .filter(v -> codegen.has_value(v.ty))\n          .map(v -> codegen.ll(v.ty) + \" \" + v.op), \", \")\n        codegen.emit(mut g, f\"{c} = call i64 {f}({args})\")\n        codegen.emit(mut g, f\"ret i64 {c}\")\n      }\n    }\n  }\n}"},{"name":"codegen.union_drop","kind":"fn","old":"ef651fe2122d30e2","new":"53a357b76a794f00","interface_changed":true,"affected":["codegen.drop_value","codegen.tail_drop","codegen.function","codegen.drop_scope","codegen.drop_fields","codegen.debug_list","codegen.drop_list","codegen.closure","codegen.collection_builtin","codegen.call_fn_want","codegen.builtin_call","codegen.dyn_wrapper","codegen.set_path","codegen.replace_var","codegen.task_fns","codegen.await_list","codegen.slot_drop_fn","codegen.select_expr","codegen.foreign_call","codegen.tries_end","codegen.gen_list","codegen.drop_stacked","codegen.set_field_in_place","codegen.update_in_place","codegen.arena_run","codegen.unwind_all","codegen.swap_in","codegen.take_in_place","codegen.stmt_node","codegen.session_entry","codegen.drop_counted","codegen.drop_held","codegen.unbox_fn","codegen.assign_held","codegen.compiled_alone","codegen.pop_scope","codegen.drop_from","codegen.drop_fn","codegen.helper","codegen.order_closure","codegen.lambda_shown","codegen.builtin","codegen.converted","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.except_expr","codegen.matching_want","codegen.vtable","codegen.union_set","codegen.assign_at","codegen.spawn_expr","codegen.supervised_fns","codegen.await_expr","codegen.channel_new","codegen.expr_node","codegen.produce","codegen.gen_data","codegen.mock_method","codegen.unwind_here","codegen.cancel_point_after","codegen.put_in","codegen.stmt","codegen.generate","codegen.fields_drop_fn","codegen.words_value","codegen.tag_is","codegen.leave_branch","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.block_expr","co