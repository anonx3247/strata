gen.V],\n) -> codegen.V {\n  shown := join(args\n    .filter(a -> codegen.has_value(a.ty))\n    .map(a -> codegen.ll(a.ty) + \" \" + a.op), \", \")\n  if codegen.by_words(g, sym, ret) {\n    w := codegen.call_words(mut g, ret, sym, args)\n    return codegen.words_value(mut g, \"\", ret, w, false, false, false)\n  }\n  if codegen.has_value(ret) {\n    r := codegen.fresh(mut g, \"c\")\n    codegen.emit(\n      mut g,\n      f\"{r} = call {codegen.ll(ret)} {sym}({shown})\",\n    )\n    codegen.temp(mut g, codegen.V { ty: ret, op: r })\n  } else {\n    codegen.emit(mut g, f\"call void {sym}({shown})\")\n    codegen.unit()\n  }\n}","old_text":"/// `call RET SYM(ARGS)`. The result is a temporary: every function returns\n/// a value its caller owns. A function giving words (`by_words`) has its\n/// result boxed.\nfn call_at(\n  mut g: codegen.Gen,\n  ret: Ty,\n  sym: String,\n  args: List[codegen.V],\n) -> codegen.V {\n  shown := join(args\n    .filter(a -> codegen.has_value(a.ty))\n    .map(a -> codegen.ll(a.ty) + \" \" + a.op), \", \")\n  if codegen.by_words(g, sym, ret) {\n    w := codegen.call_words(mut g, ret, sym, args)\n    return codegen.words_value(mut g, \"\", ret, w, false, false, false)\n  }\n  if codegen.has_value(ret) {\n    r := codegen.fresh(mut g, \"c\")\n    codegen.emit(\n      mut g,\n      f\"{r} = call {codegen.ll(ret)} {sym}({shown})\",\n    )\n    codegen.temp(mut g, codegen.V { ty: ret, op: r })\n  } else {\n    codegen.emit(mut g, f\"call void {sym}({shown})\")\n    codegen.unit()\n  }\n}"},{"name":"codegen.fault","kind":"fn","old":"3a42e70f08900670","new":"f67d2d4e24d042b1","interface_changed":false,"affected":[],"module":"codegen","text":"/// Stops with a fault.\n/// In a program with tasks, inside a function body, the panic may belong\n/// to a supervised task. `strata_panic` then records it and returns, and\n/// the function leaves as a cancelled one does, dropping what it holds.\n/// Anywhere else the program ends.\nfn fault(mut g: codegen.Gen, kind: Int, parts: List[codegen.V]) {\n  m := codegen.concat(mut g, parts)\n  if g.tasks && g.can_unwind {\n    codegen.use_rt(mut g, \"strata_panic\")\n    codegen.emit(\n      mut g,\n      f\"call void @strata_panic(i32 {kind}, ptr {m.op})\",\n    )\n    // the message belongs to the panic\n    codegen.drop_from(mut g, 0, m.op)\n    codegen.br(mut g, \"unwound\")\n    g.unwinds = true\n  } else {\n    _ := codegen.call(\n      mut g,\n      check.TUnit,\n      \"strata_fault\",\n      [codegen.V { ty: check.TInt, op: to_string(kind) }, m],\n    )\n    codegen.emit(mut g, \"unreachable\")\n  }\n  codegen.dead(mut g)\n}","old_text":"/// Stops with a fault.\n/// In a program with tasks, inside a function body, the panic may belong\n/// to a supervised task. `strata_panic` then records it and returns, and\n/// the function leaves as a cancelled one does, dropping what it holds.\n/// Anywhere else the program ends.\nfn fault(mut g: codegen.Gen, kind: Int, parts: List[codegen.V]) {\n  m := codegen.concat(mut g, parts)\n  if g.tasks && g.can_unwind {\n    codegen.use_rt(mut g, \"strata_panic\")\n    codegen.emit(\n      mut g,\n      f\"call void @strata_panic(i32 {kind}, ptr {m.op})\",\n    )\n    // the message belongs to the panic\n    codegen.drop_from(mut g, 0, m.op)\n    codegen.br(mut g, \"unwound\")\n    g.unwinds = true\n  } else {\n    _ := codegen.call(\n      mut g,\n      TUnit,\n      \"strata_fault\",\n      [codegen.V { ty: TInt, op: to_string(kind) }, m],\n    )\n    codegen.emit(mut g, \"unreachable\")\n  }\n  codegen.dead(mut g)\n}"},{"name":"codegen.lit","kind":"fn","old":"7e9542e6a44f24df","new":"3b34be3b98c0158a","interface_changed":false,"affected":[],"module":"codegen","text":"fn lit(mut g: codegen.Gen, s: String) -> codegen.V {\n  codegen.V { ty: check.TStr, op: codegen.string(mut g, s) }\n}","old_text":"fn lit(mut g: codegen.Gen, s: String) -> codegen.V {\n  codegen.V { ty: TStr, op: codegen.string(mut g, s) }\n}"},{"name":"codegen.to_slot","kind":"fn","old":"327232a652fc5168","new":"4228adbf0e81e33b","interface_changed":false,"affected":[],"module":"codegen","text":"// ---- slots ----\n\n/// A value as the 64-bit slot a block keeps it in.\nfn to_slot(mut g: codegen.Gen, v: codegen.V) -> String {\n  match codegen.sized(v.ty) {\n    Some(w) => return codegen.wide(mut g, w, v),\n    None => (),\n  }\n  match v.ty {\n    check.TInt => v.op,\n    check.TFloat => {\n      r := codegen.fresh(mut g, \"slot\")\n      codegen.emit(mut g, f\"{r} = bitcast double {v.op} to i64\")\n      r\n    },\n    check.TBool => {\n      r := codegen.fresh(mut g, \"slot\")\n      codegen.emit(mut g, f\"{r} = zext i1 {v.op} to i64\")\n      r\n    },\n    check.TStr | check.TNamed { .. } | check.TList(_) | check.TFn { .. } | check.TTrait(_) | check.TUnion(_) => {\n      r := codegen.fresh(mut g, \"slot\")\n      codegen.emit(mut g, f\"{r} = ptrtoint ptr {v.op} to i64\")\n      r\n    },\n    _ => \"0\",\n  }\n}","old_text":"// ---- slots ----\n\n/// A value as the 64-bit slot a block keeps it in.\nfn to_slot(mut g: codegen.Gen, v: codegen.V) -> String {\n  match codegen.sized(v.ty) {\n    Some(w) => return codegen.wide(mut g, w, v),\n    None => (),\n  }\n  match v.ty {\n    TInt => v.op,\n    TFloat => {\n      r := codegen.fresh(mut g, \"slot\")\n      codegen.emit(mut g, f\"{r} = bitcast double {v.op} to i64\")\n      r\n    },\n    TBool => {\n      r := codegen.fresh(mut g, \"slot\")\n      codegen.emit(mut g, f\"{r} = zext i1 {v.op} to i64\")\n      r\n    },\n    TStr | TNamed { .. } | TList(_) | TFn { .. } | TTrait(_) | TUnion(_) => {\n      r := codegen.fresh(mut g, \"slot\")\n      codegen.emit(mut g, f\"{r} = ptrtoint ptr {v.op} to i64\")\n      r\n    },\n    _ => \"0\",\n  }\n}"},{"name":"codegen.from_slot","kind":"fn","old":"80edf92be644073c","new":"4dbabe1a513e1c2f","interface_changed":true,"affected":["codegen.drop_list","codegen.dyn_wrapper","codegen.slot_drop_fn","codegen.dyn_value","codegen.update_in_place","