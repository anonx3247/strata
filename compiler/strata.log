\n  match t {\n    check.TInt => {\n      codegen.use_rt(mut g, \"strata_int_cmp\")\n      codegen.emit(\n        mut g,\n        \"%c = call i64 @strata_int_cmp(i64 %a, i64 %b)\",\n      )\n      codegen.emit(mut g, \"ret i64 %c\")\n    },\n    check.TBool => codegen.three(mut g, \"icmp ult i1 %a, %b\", \"icmp ugt i1 %a, %b\"),\n    check.TFloat => {\n      for x in [\"a\", \"b\"] {\n        codegen.emit(\n          mut g,\n          f\"%bits.{x} = bitcast double %{x} to i64\",\n        )\n        codegen.emit(mut g, f\"%sign.{x} = ashr i64 %bits.{x}, 63\")\n        codegen.emit(mut g, f\"%mask.{x} = lshr i64 %sign.{x}, 1\")\n        codegen.emit(\n          mut g,\n          f\"%key.{x} = xor i64 %bits.{x}, %mask.{x}\",\n        )\n      }\n      codegen.three(\n        mut g,\n        \"icmp slt i64 %key.a, %key.b\",\n        \"icmp sgt i64 %key.a, %key.b\",\n      )\n    },\n    check.TStr => {\n      codegen.use_rt(mut g, \"strata_str_cmp\")\n      codegen.emit(\n        mut g,\n        \"%c = call i64 @strata_str_cmp(ptr %a, ptr %b)\",\n      )\n      codegen.emit(mut g, \"ret i64 %c\")\n    },\n    check.TUnit => codegen.emit(mut g, \"ret i64 0\"),\n    check.TNamed { name: \"Tuple\", args } => {\n      codegen.cmp_fields(mut g, a, b, args)\n      codegen.emit(mut g, \"ret i64 0\")\n    },\n    check.TNamed { name: \"Set\", .. } | check.TNamed { name: \"Dict\", .. } => {\n      f := codegen.slot_fn(mut g, \"cmp\", codegen.entry_ty(t))\n      codegen.use_rt(mut g, \"strata_tbl_cmp\")\n      codegen.emit(\n        mut g,\n        f\"%c = call i64 @strata_tbl_cmp(ptr %a, ptr %b, ptr {f})\",\n      )\n      codegen.emit(mut g, \"ret i64 %c\")\n    },\n    check.TList(et) => {\n      f := codegen.cmp_helper(mut g, et)\n      nb := codegen.list_len(mut g, b)\n      at := codegen.each_start(mut g, a)\n      inb := codegen.fresh(mut g, \"inb\")\n      codegen.emit(mut g, f\"{inb} = icmp slt i64 {at.1}, {nb.op}\")\n      (go, past) := (codegen.label(mut g, \"both\"), codegen.label(mut g, \"past\"))\n      codegen.emit(\n        mut g,\n        f\"br i1 {inb}, label %{go}, label %{past}\",\n      )\n      codegen.block(mut g, past)\n      codegen.emit(mut g, \"ret i64 1\")\n      codegen.block(mut g, go)\n      x := codegen.list_at(mut g, a, at.1, et)\n      y := codegen.list_at(mut g, b, at.1, et)\n      codegen.differ(mut g, f, x, y)\n      codegen.each_next(mut g, at)\n      na := codegen.list_len(mut g, a)\n      nb2 := codegen.list_len(mut g, b)\n      codegen.three(\n        mut g,\n        f\"icmp slt i64 {na.op}, {nb2.op}\",\n        f\"icmp sgt i64 {na.op}, {nb2.op}\",\n      )\n    },\n    check.TNamed { .. } => {\n      // by variant (tags follow declaration order), then fields\n      cs := codegen.ctors_of(g, t)\n      if len(cs) > 1 {\n        (ta, tb) := (codegen.tag_of(mut g, a), codegen.tag_of(mut g, b))\n        (lt, gt) := (codegen.fresh(mut g, \"l\"), codegen.fresh(mut g, \"g\"))\n        codegen.emit(mut g, f\"{lt} = icmp slt i64 {ta}, {tb}\")\n        codegen.emit(mut g, f\"{gt} = icmp sgt i64 {ta}, {tb}\")\n        (lx, gx, d) := (\n          codegen.fresh(mut g, \"lx\"),\n          codegen.fresh(mut g, \"gx\"),\n          codegen.fresh(mut g, \"d\"),\n        )\n        codegen.emit(mut g, f\"{lx} = zext i1 {lt} to i64\")\n        codegen.emit(mut g, f\"{gx} = zext i1 {gt} to i64\")\n        codegen.emit(mut g, f\"{d} = sub i64 {gx}, {lx}\")\n        z := codegen.fresh(mut g, \"z\")\n        codegen.emit(mut g, f\"{z} = icmp eq i64 {d}, 0\")\n        codegen.emit(\n          mut g,\n          f\"br i1 {z}, label %fields, label %differ\",\n        )\n        codegen.block(mut g, \"differ\")\n        codegen.emit(mut g, f\"ret i64 {d}\")\n        codegen.block(mut g, \"fields\")\n        labels := codegen.on_ctor(mut g, a, cs)\n        for (k, c) in enumerate(cs) {\n          codegen.block(mut g, get(labels, k) ?? \"\")\n          codegen.cmp_fields(\n            mut g,\n            a,\n            b,\n      