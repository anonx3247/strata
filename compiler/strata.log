egen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// Marks the variable in `slot` as holding a stack block with these field\n/// types, in the scope that owns it.\nfn mark_stacked(mut g: codegen.Gen, slot: String, tys: List[check.Ty]) {\n  mut k := len(g.scopes) - 1\n  while k >= 0 {\n    s := get(g.scopes, k) ?? codegen.no_scope()\n    if s.owned.any(l -> l.slot == slot) {\n      codegen.set_scope(mut g, k, codegen.Scope { ..s, stacked: {\n        mut copy := s.stacked\n        mut copy.insert(slot, tys)\n        copy\n      } })\n      return\n    }\n    k -= 1\n  }\n}","old_text":"/// Marks the variable in `slot` as holding a stack block with these field\n/// types, in the scope that owns it.\nfn mark_stacked(mut g: codegen.Gen, slot: String, tys: List[Ty]) {\n  mut k := len(g.scopes) - 1\n  while k >= 0 {\n    s := get(g.scopes, k) ?? codegen.no_scope()\n    if s.owned.any(l -> l.slot == slot) {\n      codegen.set_scope(mut g, k, codegen.Scope { ..s, stacked: {\n        mut copy := s.stacked\n        mut copy.insert(slot, tys)\n        copy\n      } })\n      return\n    }\n    k -= 1\n  }\n}"},{"name":"codegen.drop_stacked","kind":"fn","old":"3b33e34422a3c6c9","new":"59b0b46d874557cd","interface_changed":true,"affected":["codegen.drop_scope","codegen.unwind_all","codegen.drop_held","codegen.pop_scope","codegen.drop_from","codegen.unwind_here","codegen.cancel_point_after","codegen.tag_is","codegen.leave_branch","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.debug_list","codegen.block_expr","codegen.call_fn_want","codegen.with_it","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.invariants","codegen.iterate","codegen.await_list","codegen.select_expr","codegen.race_expr","codegen.satisfies","codegen.produce","codegen.gen_list","codegen.gen_data","codegen.mock_method","codegen.check_payload","codegen.check_unio