","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.spawn_expr","codegen.method_value","codegen.iterate","codegen.decreases_start","codegen.decreases_entry","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.to_c","codegen.check_payload","codegen.dyn_ctor_is","codegen.has_field_check","codegen.check_field","codegen.assign_at","codegen.gen_data","codegen.check_union","codegen.check_member","codegen.to_dyn","codegen.dyn_table_is","codegen.mock_value","codegen.gen_list","codegen.gen_fn","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.foreign_call","codegen.generated","codegen.can_generate","codegen.helper","codegen.debug_body","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.generated_args","codegen.makers","codegen.equal","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.read_back","eval_files","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// Whether values of `t` hold a function with a fully known type\n/// (`Option[(Int, Int) -> Int]`). A lambda made for it takes its parameter\n/// types from there.\nfn holds_fn(t: check.Ty) -> Bool {\n  match t {\n    check.TFn { .. } => !codegen.has_any(t),\n    check.TList(a) => codegen.holds_fn(a),\n    check.TNamed { args, .. } => args.any(a -> codegen.holds_fn(a)),\n    _ => false,\n  }\n}","old_text":"/// Whether values of `t` hold a function with a fully known type\n/// (`Option[(Int, Int) -> Int]`). A lambda made for it takes its parameter\n/// types from there.\nfn holds_fn(t: Ty) -> Bool {\n  match t {\n    TFn { .. } => !codegen.has_any(t),\n    TList(a) => codegen.holds_fn(a),\n    TNamed { args, .. } => args.any(a -> codegen.holds_fn(a)),\n    _ => false,\n  }\n}"},{"name":"codegen.expr_node","kind":"fn","old":"85a465ae5f1d5cc1","new":"e734b724de35ca37","interface_changed":false,"affected":[],"module":"codegen","text":"fn expr_node(mut g: codegen.Gen, e: ast.Expr) -> codegen.V {\n  match e {\n    ast.IntLit(n) => codegen.int_lit(mut g, n),\n    ast.BigIntLit(digits) => {\n      s := codegen.string(mut g, digits)\n      codegen.call(\n        mut g,\n        check.TInt,\n        \"strata_int_lit\",\n        [codegen.V { ty: check.TStr, op: s }],\n      )\n    },\n    ast.FloatLit(f) => codegen.V { ty: check.TFloat, op: codegen.float_op(f) },\n    ast.BoolLit(b) => codegen.V { ty: check.TBool, op: if b {\n      \"true\"\n    } else {\n      \"false\"\n    } },\n    ast.StrLit(s) => codegen.V { ty: check.TStr, op: codegen.string(mut g, s) },\n    ast.UnitExpr => codegen.unit(),\n    ast.Var(x) => match codegen.lookup(g, x) {\n      Some(l) => codegen.load(mut g, l),\n      None => codegen.expr_want(mut g, e, check.TAny),\n    },\n    ast.Binary { op, left, right } => codegen.binary(mut g, op, left, right),\n    ast.Unary { op: ast.Not, operand } => {\n      v := codegen.expr(mut g, operand)\n      if v.ty is check.TAny {\n        return v\n      }\n      r := codegen.fresh(mut g, \"not\")\n      codegen.emit(mut g, f\"{r} = xor i1 {v.op}, true\")\n      codegen.V { ty: check.TBool, op: r }\n    },\n    ast.Unary { op: ast.Neg, operand } => {\n      v := codegen.expr(mut g, operand)\n      match codegen.sized(v.ty) {\n        Some(_) => {\n          r := codegen.fresh(mut g, \"neg\")\n          codegen.emit(\n            mut g,\n            f\"{r} = sub {codegen.ll(v.ty)} 0, {v.op}\",\n          )\n          return codegen.V { ty: v.ty, op: r }\n        },\n        None => (),\n      }\n      match v.ty {\n        check.TInt => codegen.int_op(\n          mut g,\n          \"ssub\",\n          codegen.V { ty: check.TInt, op: \"0\" },\n          v,\n        ),\n        check.TFloat => {\n          r := codegen.fresh(mut g, \"neg\")\n          codegen.emit(mut g, f\"{r} = fneg double {v.op}\")\n          codegen.V { ty: check.TFloat, op: r }\n        },\n        _ => v,\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => codegen.if_expr(mut g, cond, then, otherwise),\n    ast.Block { stmts, last } => codegen.block_expr(mut g, stmts, last, check.TAny),\n    ast.Lambda { params, body } => codegen.lambda(mut g, params, body, check.TAny),\n    ast.Call { callee: ast.Var(name), args } => if contains(g.tags, name)\n      && !(codegen.lookup(g, name) is Some)\n      && !codegen.has_fn(g, name) {\n      codegen.construct(mut g, name, ast.PositionalArgs(args))\n    } else {\n      codegen.call_named(mut g, name, args, check.TAny)\n    },\n    ast.CtorExpr { name, args } => codegen.construct(mut g, name, args),\n    ast.TupleExpr(es) => {\n      // (in result position: on the stack, its words the result)\n      rp := g.result_pos\n      g.result_pos = false\n      match codegen.operands(mut g, es) {\n        Some(vs) => {\n          t := check.TNamed { name: \"Tuple\", args: vs.map(v -> v.ty) }\n          p := if codegen.in_result(g, rp, t)\n            && codegen.small_words(g, t) == codegen.small_words(g, g.ret) {\n            codegen.result_block(mut g, 0, vs)\n          } else {\n            codegen.block_of(mut g, 0, vs)\n          }\n          codegen.temp(mut g, codegen.V { ty: t, op: p })\n        },\n        None => codegen.never(),\n      }\n    },\n    ast.FieldOf { base, name } => codegen.get_field(mut g, base, name),\n    ast.IsExpr { value, variant } => {\n      v := codegen.expr(mut g, value)\n      if v.ty is check.TAny {\n        return v\n      }\n      match v.ty {\n        check.TUnion(ms) => match codegen.member_named(g, ms, variant) {\n          Some(m) => if contains(g.types.ctors, variant)\n            && !(codegen.head_of(m) == variant) {\n            codegen.tag_is(mut g, codegen.V { ..v, ty: m }, variant)\n          } else {\n            codegen.holds_member(mut g, v, m)\n          },\n          None => codegen.tag_is(mut g, v, variant),\n        },\n        _ => codegen.tag_is(mut g, v, variant),\n      }\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => codegen.matching(mut g, scrutinee, binding, arms),\n    // a `mut` argument or receiver mark: the call writes back\n    ast.MutExpr(x) => codegen.expr(mut g, x),\n    // an unfilled hole `?name`, which compile-time code may leave in a\n    // branch never taken: a fault if reached\n    ast.Hole(h) => {\n      codegen.push_scope(mut g)\n      m := codegen.lit(mut g, f\"reached unfilled hole `?{h}`\")\n      codegen.fault(mut g, 5, [m])\n      codegen.discard_scope(mut g)\n      codegen.never()\n    },\n    ast.Scope(b) => codegen.scope_expr(mut g, b, check.TAny),\n    ast.Spawn(b) => codegen.spawn_expr(mut g, b, false),\n    ast.SupervisedSpawn(b) => codegen.spawn_expr(mut g, b, true),\n    ast.Await(h) => codegen.await_expr(mut g, h),\n    // `old e` where nothing was taken on entry (a mock's `ensures`): `e`\n    // as is\n    ast.Old(x) => codegen.expr(mut g, x),\n    // a spread the checker did not expand: compile-time code, folded before\n    // it runs\n    ast.Spread(_) => {\n      codegen.push_scope(mut g)\n      m := codegen.lit(\n        mut g,\n        \"reached a spread (`...x`) not written out as a call\",\n      )\n      codegen.fault(mut g, 5, [m])\n      codegen.discard_scope(mut g)\n      codegen.never()\n    },\n    ast.Assumed(x) => codegen.expr(mut g, x),\n    ast.MockExpr(t) => {\n      mt := codegen.lower(mut g, t)\n      codegen.mock_value(mut g, mt)\n    },\n    ast.Select(arms) => codegen.select_expr(mut g, arms),\n    ast.Race(arms) => codegen.race_expr(mut g, arms),\n    ast.Try { value, kind } => codegen.try_expr(mut g, value, kind),\n    ast.Except { value, err, fallback } => codegen.except_expr(mut g, value, err, fallback),\n    ast.Fallback { value, fallback } => codegen.except_expr(mut g, value, None, fallback),\n    ast.ListExpr(es) => codegen.list_literal(mut g, es),\n    ast.MethodCall { recv, name, args } => codegen.method_call(mut g, recv, name, args, check.TAny),\n    ast.Call { callee, args } => {\n      f := codegen.expr(mut g, callee)\n      if f.ty is check.TAny {\n        return f\n      }\n      match codegen.operands(mut g, args) {\n        Some(vs) => codegen.call_closure(mut g, f, vs),\n        None => codegen.never(),\n      }\n    },\n    ast.Return(x) => {\n      g.result_pos = g.by_words\n      v := codegen.expr_want(mut g, x, g.ret)\n      g.result_pos = false\n      if v.ty is check.TAny {\n        return v\n      }\n      x := codegen.as_type(mut g, v, g.ret)\n      codegen.leave_with(mut g, x)\n      codegen.give_result(\n        mut g,\n        codegen.V { ..x, ty: codegen.better(g.ret, x.ty) },\n      )\n      codegen.br(mut g, \"exit\")\n      codegen.dead(mut g)\n      codegen.never()\n    },\n    ast.Interp(parts) => codegen.interp(mut g, parts),\n    other => {\n      codegen.not_yet(mut g, \"`\" + text.expr_text(other, 0) + \"`\")\n      codegen.never()\n    },\n  }\n}","old_text":"fn expr_node(mut g: codegen.Gen, e: ast.Expr) -> codegen.V {\n  match e {\n    ast.IntLit(n) => codegen.int_lit(mut g, n),\n    ast.BigIntLit(digits) => {\n      s := codegen.string(mut g, digits)\n      codegen.call(\n        mut g,\n        TInt,\n        \"strata_int_lit\",\n        [codegen.V { ty: TStr, op: s }],\n      )\n    },\n    ast.FloatLit(f) => codegen.V { ty: TFloat, op: codegen.float_op(f) },\n    ast.BoolLit(b) => codegen.V { ty: TBool, op: if b {\n      \"true\"\n    } else {\n      \"false\"\n    } },\n    ast.StrLit(s) => codegen.V { ty: TStr, op: codegen.string(mut g, s) },\n    ast.UnitExpr => codegen.unit(),\n    ast.Var(x) => match codegen.lookup(g, x) {\n      Some(l) => codegen.load(mut g, l),\n      None => codegen.expr_want(mut g, e, TAny),\n    },\n    ast.Binary { op, left, right } => codegen.binary(mut g, op, left, right),\n    ast.Unary { op: ast.Not, operand } => {\n      v := codegen.expr(mut g, operand)\n      if v.ty is TAny {\n        return v\n      }\n      r := codegen.fresh(mut g, \"not\")\n      codegen.emit(mut g, f\"{r} = xor i1 {v.op}, true\")\n      codegen.V { ty: TBool, op: r }\n    },\n    ast.Unary { op: ast.Neg, operand } => {\n      v := codegen.expr(mut g, operand)\n      match codegen.sized(v.ty) {\n        Some(_) => {\n          r := codegen.fresh(mut g, \"neg\")\n          codegen.emit(\n            mut g,\n            f\"{r} = sub {codegen.ll(v.ty)} 0, {v.op}\",\n          )\n          return codegen.V { ty: v.ty, op: r }\n        },\n        None => (),\n      }\n      match v.ty {\n        TInt => codegen.int_op(\n          mut g,\n          \"ssub\",\n          codegen.V { ty: TInt, op: \"0\" },\n          v,\n        ),\n        TFloat => {\n          r := codegen.fresh(mut g, \"neg\")\n          codegen.emit(mut g, f\"{r} = fneg double {v.op}\")\n          codegen.V { ty: TFloat, op: r }\n        },\n        _ => v,\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => codegen.if_expr(mut g, cond, then, otherwise),\n    ast.Block { stmts, last } => codegen.block_expr(mut g, stmts, last, TAny),\n    ast.Lambda { params, body } => codegen.lambda(mut g, params, body, TAny),\n    ast.Call { callee: ast.Var(name), args } => if contains(g.tags, name)\n      && !(codegen.lookup(g, name) is Some)\n      && !codegen.has_fn(g, name) {\n      codegen.construct(mut g, name, ast.PositionalArgs(args))\n    } else {\n      codegen.call_named(mut g, name, args, TAny)\n    },\n    ast.CtorExpr { name, args } => codegen.construct(mut g, name, args),\n    ast.TupleExpr(es) => {\n      // (in result position: on the stack, its words the result)\n      rp := g.result_pos\n      g.result_pos = false\n      match codegen.operands(mut g, es) {\n        Some(vs) => {\n          t := TNamed { name: \"Tuple\", args: vs.map(v -> v.ty) }\n          p := if codegen.in_result(g, rp, t)\n            && codegen.small_words(g, t) == codegen.small_words(g, g.ret) {\n            codegen.result_block(mut g, 0, vs)\n          } else {\n            codegen.block_of(mut g, 0, vs)\n          }\n          codegen.temp(mut g, codegen.V { ty: t, op: p })\n        },\n        None => codegen.never(),\n      }\n    },\n    ast.FieldOf { base, name } => codegen.get_field(mut g, base, name),\n    ast.IsExpr { value, variant } => {\n      v := codegen.expr(mut g, value)\n      if v.ty is TAny {\n        return v\n      }\n      match v.ty {\n        TUnion(ms) => match codegen.member_named(g, ms, variant) {\n          Some(m) => if contains(g.types.ctors, variant)\n            && !(codegen.head_of(m) == variant) {\n            codegen.tag_is(mut g, codegen.V { ..v, ty: m }, variant)\n          } else {\n            codegen.holds_member(mut g, v, m)\n          },\n          None => codegen.tag_is(mut g, v, variant),\n        },\n        _ => codegen.tag_is(mut g, v, variant),\n      }\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => codegen.matching(mut g, scrutinee, binding, arms),\n    // a `mut` argument or receiver mark: the call writes back\n    ast.MutExpr(x) => codegen.expr(mut g, x),\n    // an unfilled hole `?name`, which compile-time code may leave in a\n    // branch never taken: a fault if reached\n    ast.Hole(h) => {\n      codegen.push_scope(mut g)\n      m := codegen.lit(mut g, f\"reached unfilled hole `?{h}`\")\n      codegen.fault(mut g, 5, [m])\n      codegen.discard_scope(mut g)\n      codegen.never()\n    },\n    ast.Scope(b) => codegen.scope_expr(mut g, b, TAny),\n    ast.Spawn(b) => codegen.spawn_expr(mut g, b, false),\n    ast.SupervisedSpawn(b) => codegen.spawn_expr(mut g, b, true),\n    ast.Await(h) => codegen.await_expr(mut g, h),\n    // `old e` where nothing was taken on entry (a mock's `ensures`): `e`\n    // as is\n    ast.Old(x) => codegen.expr(mut g, x),\n    // a spread the checker did not expand: compile-time code, folded before\n    // it runs\n    ast.Spread(_) => {\n      codegen.push_scope(mut g)\n      m := codegen.lit(\n        mut g,\n        \"reached a spread (`...x`) not written out as a call\",\n      )\n      codegen.fault(mut g, 5, [m])\n      codegen.discard_scope(mut g)\n      codegen.never()\n    },\n    ast.Assumed(x) => codegen.expr(mut g, x),\n    ast.MockExpr(t) => {\n      mt := codegen.lower(mut g, t)\n      codegen.mock_value(mut g, mt)\n    },\n    ast.Select(arms) => codegen.select_expr(mut g, arms),\n    ast.Race(arms) => codegen.race_expr(mut g, arms),\n    ast.Try { value, kind } => codegen.try_expr(mut g, value, kind),\n    ast.Except { value, err, fallback } => codegen.except_expr(mut g, value, err, fallback),\n    ast.Fallback { value, fallback } => codegen.except_expr(mut g, value, None, fallback),\n    ast.ListExpr(es) => codegen.list_literal(mut g, es),\n    ast.MethodCall { recv, name, args } => codegen.method_call(mut g, recv, name, args, TAny),\n    ast.Call { callee, args } => {\n      f := codegen.expr(mut g, callee)\n      if f.ty is TAny {\n        return f\n      }\n      match codegen.operands(mut g, args) {\n        Some(vs) => codegen.call_closure(mut g, f, vs),\n        None => codegen.never(),\n      }\n    },\n    ast.Return(x) => {\n      g.result_pos = g.by_words\n      v := codegen.expr_want(mut g, x, g.ret)\n      g.result_pos = false\n      if v.ty is TAny {\n        return v\n      }\n      x := codegen.as_type(mut g, v, g.ret)\n      codegen.leave_with(mut g, x)\n      codegen.give_result(\n        mut g,\n        codegen.V { ..x, ty: codegen.better(g.ret, x.ty) },\n      )\n      codegen.br(mut g, \"exit\")\n      codegen.dead(mut g)\n      codegen.never()\n    },\n    ast.Interp(parts) => codegen.interp(mut g, parts),\n    other => {\n      codegen.not_yet(mut g, \"`\" + text.expr_text(other, 0) + \"`\")\n      codegen.never()\n    },\n  }\n}"},{"name":"codegen.expr_want_node","kind":"fn","old":"b91da9a9364f2815","new":"64744fca477afa8f","interface_changed":true,"affected":["codegen.expr_want","codegen.function","codegen.binary","codegen.declare","codegen.destructure","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.method_call","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.try_want","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.expr_node","codegen.compared","codegen.stmt_node","codegen.build_fn","codegen.push_in_place","codegen.compiled_alone","codegen.call_named","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.except_expr","codegen.matching_want","codegen.list_literal","codegen.generate","codegen.construct","codegen.operands","codegen.branch_value","codegen.mock_call","codegen.try_expr","codegen.function_value","codegen.lambda","codegen.expr","codegen.checked","codegen.stmt","codegen.built_or_generated","codegen.update_in_place","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.main_arg","codegen.matching","codegen_with","core_rt_text","computed_value","repl_eval","codegen.session_capability","codegen.for_loop","codegen.take_in_place","codegen.if_want","codegen.matching_v","codegen.spawn_expr","codegen.produce","codegen.method_value","codegen.interp","codegen.logic","codegen.loop_body","codegen.matches","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.await_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.tag_test","codegen.set_in_place","codegen.decreases_pass","codegen.decreases_call","codegen.keep_olds","codegen.export_entry","codegen.expr_on_stack","codegen.assigned_call","codegen.assertion","codegen.invariants","codegen.iterate","codegen.decreases_start","codegen.decreases_entry","codegen.entry","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.check_type","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","codegen.gen_list","codegen.vtable","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.session_entry","codegen.if_expr","codegen.gen_fn","codegen.binds","codegen.tag_is","codegen.satisfies","codegen.holds_pred","codegen.mock_table","codegen.list_builtin","codegen.table_find","codegen.get_field","codegen.helper","codegen.debug_body","codegen.check_union","codegen.check_member","codegen.has_field_check","codegen.check_payload","codegen.check_field","codegen.assign_at","codegen.to_dyn","codegen.dyn_table_is","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.generated","codegen.can_generate","codegen.to_c","codegen.dyn_ctor_is","codegen.gen_data","codegen.mock_value","codegen.equal","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.generated_args","codegen.makers","codegen.foreign_call","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","codegen.read_back","eval_files"],"module":"codegen","text":"/// `expr_want` of `e`, compiled.\nfn expr_want_node(\n  mut g: codegen.Gen,\n  e: ast.Expr,\n  want: check.Ty,\n) -> codegen.V {\n  v := match e {\n    ast.Lambda { params, body } => return codegen.lambda(mut g, params, body, want),\n    ast.Block { stmts, last } => return codegen.block_expr(mut g, stmts, last, want),\n    // a function's result or a channel's ends, as wanted; a constructor\n    // with its fields as the wanted type has them\n    ast.Call { callee: ast.Var(name), args } => if contains(g.tags, name)\n      && !(codegen.lookup(g, name) is Some)\n      && !codegen.has_fn(g, name) {\n      codegen.construct_want(\n        mut g,\n        name,\n        ast.PositionalArgs(args),\n        want,\n      )\n    } else if codegen.lookup(g, name) is None\n      && (codegen.fn_key(g, name) != \"\"\n        || name == \"channel\"\n        || codegen.prelude_builtin(name)) {\n      return codegen.call_named(mut g, name, args, want)\n    } else {\n      codegen.expr(mut g, e)\n    },\n    ast.Var(x) => match codegen.lookup(g, x) {\n      Some(l) => codegen.load(mut g, l),\n      None => if codegen.fn_key(g, x) != \"\" || codegen.is_builtin_value(x) {\n        // a function as a value: a lambda calling it\n        return codegen.function_value(mut g, x, want)\n      } else if contains(g.statics, x) {\n        return codegen.static_block(mut g, x)\n      } else if g.traits\n        .values()\n        .any(t -> t.methods.any(m -> m.decl.name == x)) {\n        // a trait method as a value (`xs.map(price)`): a lambda calling it\n        return codegen.method_value(mut g, x, want)\n      } else {\n        codegen.not_yet(mut g, \"`\" + x + \"` as a value\")\n        return codegen.never()\n      },\n    },\n    ast.ListExpr(es) => codegen.list_literal_of(mut g, es, match want {\n      check.TList(et) => et,\n      _ => check.TAny,\n    }),\n    ast.MethodCall { recv, name, args } => codegen.method_call(mut g, recv, name, args, want),\n    ast.Try { value, kind } => codegen.try_want(mut g, value, kind, want),\n    ast.CtorExpr { name, args } => codegen.construct_want(mut g, name, args, want),\n    ast.IfExpr { cond, then, otherwise } => return codegen.if_want(mut g, cond, then, otherwise, want),\n    ast.MatchExpr { scrutinee, binding, arms } => return codegen.matching_want(mut g, scrutinee, binding, arms, want),\n    _ => codegen.expr(mut g, e),\n  }\n  if v.ty is check.TAny {\n    return v\n  }\n  // an integer literal where a sized integer is wanted becomes one\n  codegen.converted(mut g, v, want)\n}","old_text":"/// `expr_want` of `e`, compiled.\nfn expr_want_node(mut g: codegen.Gen, e: ast.Expr, want: Ty) -> codegen.V {\n  v := match e {\n    ast.Lambda { params, body } => return codegen.lambda(mut g, params, body, want),\n    ast.Block { stmts, last } => return codegen.block_expr(mut g, stmts, last, want),\n    // a function's result or a channel's ends, as wanted; a constructor\n    // with its fields as the wanted type has them\n    ast.Call { callee: ast.Var(name), args } => if contains(g.tags, name)\n      && !(codegen.lookup(g, name) is Some)\n      && !codegen.has_fn(g, name) {\n      codegen.construct_want(\n        mut g,\n        name,\n        ast.PositionalArgs(args),\n        want,\n      )\n    } else if codegen.lookup(g, name) is None\n      && (codegen.fn_key(g, name) != \"\"\n        || name == \"channel\"\n        || codegen.prelude_builtin(name)) {\n      return codegen.call_named(mut g, name, args, want)\n    } else {\n      codegen.expr(mut g, e)\n    },\n    ast.Var(x) => match codegen.lookup(g, x) {\n      Some(l) => codegen.load(mut g, l),\n      None => if codegen.fn_key(g, x) != \"\" || codegen.is_builtin_value(x) {\n        // a function as a value: a lambda calling it\n        return codegen.function_value(mut g, x, want)\n      } else if contains(g.statics, x) {\n        return codegen.static_block(mut g, x)\n      } else if g.traits\n        .values()\n        .any(t -> t.methods.any(m -> m.decl.name == x)) {\n        // a trait method as a value (`xs.map(price)`): a lambda calling it\n        return codegen.method_value(mut g, x, want)\n      } else {\n        codegen.not_yet(mut g, \"`\" + x + \"` as a value\")\n        return codegen.never()\n      },\n    },\n    ast.ListExpr(es) => codegen.list_literal_of(mut g, es, match want {\n      TList(et) => et,\n      _ => TAny,\n    }),\n    ast.MethodCall { recv, name, args } => codegen.method_call(mut g, recv, name, args, want),\n    ast.Try { value, kind } => codegen.try_want(mut g, value, kind, want),\n    ast.CtorExpr { name, args } => codegen.construct_want(mut g, name, args, want),\n    ast.IfExpr { cond, then, otherwise } => return codegen.if_want(mut g, cond, then, otherwise, want),\n    ast.MatchExpr { scrutinee, binding, arms } => return codegen.matching_want(mut g, scrutinee, binding, arms, want),\n    _ => codegen.expr(mut g, e),\n  }\n  if v.ty is TAny {\n    return v\n  }\n  // an integer literal where a sized integer is wanted becomes one\n  codegen.converted(mut g, v, want)\n}"},{"name":"codegen.compared","kind":"fn","old":"007b2e7e892a7628","new":"08557c97a3ff931d","interface_changed":false,"affected":[],"module":"codegen","text":"/// The two sides of a comparison: an empty list (`[]`) takes the other\n/// side's type, compiled first. Else `operands`.\nfn compared(\n  mut g: codegen.Gen,\n  l: ast.Expr,\n  r: ast.Expr,\n) -> Option[List[codegen.V]] {\n  match (l, r) {\n    (ast.ListExpr([]), ast.ListExpr([])) => codegen.operands(mut g, [l, r]),\n    (ast.ListExpr([]), _) => {\n      b := codegen.expr(mut g, r)\n      if b.ty is check.TAny {\n        return None\n      }\n      a := codegen.expr_want(mut g, l, b.ty)\n      if a.ty is check.TAny {\n        None\n      } else {\n        Some([a, b])\n      }\n    },\n    (_, ast.ListExpr([])) => {\n      a := codegen.expr(mut g, l)\n      if a.ty is check.TAny {\n        return None\n      }\n      b := codegen.expr_want(mut g, r, a.ty)\n      if b.ty is check.TAny {\n        None\n      } else {\n        Some([a, b])\n      }\n    },\n    _ => codegen.operands(mut g, [l, r]),\n  }\n}","old_text":"/// The two sides of a comparison: an empty list (`[]`) takes the other\n/// side's type, compiled first. Else `operands`.\nfn compared(\n  mut g: codegen.Gen,\n  l: ast.Expr,\n  r: ast.Expr,\n) -> Option[List[codegen.V]] {\n  match (l, r) {\n    (ast.ListExpr([]), ast.ListExpr([])) => codegen.operands(mut g, [l, r]),\n    (ast.ListExpr([]), _) => {\n      b := codegen.expr(mut g, r)\n      if b.ty is TAny {\n        return None\n      }\n      a := codegen.expr_want(mut g, l, b.ty)\n      if a.ty is TAny {\n        None\n      } else {\n        Some([a, b])\n      }\n    },\n    (_, ast.ListExpr([])) => {\n      a := codegen.expr(mut g, l)\n      if a.ty is TAny {\n        return None\n      }\n      b := codegen.expr_want(mut g, r, a.ty)\n      if b.ty is TAny {\n        None\n      } else {\n        Some([a, b])\n      }\n    },\n    _ => codegen.operands(mut g, [l, r]),\n  }\n}"},{"name":"codegen.stmt_node","kind":"fn","old":"630344bfb1c4276e","new":"35836235152b2d6e","interface_changed":false,"affected":[],"module":"codegen","text":"/// `stmt` of `s`, compiled.\nfn stmt_node(mut g: codegen.Gen, s: ast.Stmt) {\n  // `--copies`: the statement's value, when it is the program's own code\n  // as written and not compiler-made\n  if g.copies {\n    e := match s {\n      ast.Let { value, .. } => value,\n      ast.VarDecl { value, .. } => value,\n      ast.Assign { value, .. } => value,\n      ast.ExprStmt(e) => e,\n      _ => ast.UnitExpr,\n    }\n    t := text.expr_text(e, 0)\n    if contains(g.sites, g.current + \"|\" + t)\n      || contains(g.sites, \"|\" + t) {\n      g.at = e\n    }\n  }\n  match s {\n    ast.Let { pat, ty, value } => match pat {\n      ast.Bind(n) => codegen.declare(mut g, n, ty, value, false),\n      // `let _: T = e`: the value is still checked against `T`\n      ast.Wild => match ty {\n        Some(x) => {\n          want := codegen.lower(mut g, x)\n          v := codegen.expr_want(mut g, value, want)\n          if !(v.ty is check.TAny) && codegen.needs_check(g, x) {\n            codegen.check_type(mut g, x, v, \"let binding\", [])\n          }\n        },\n        None => {\n          _ := codegen.expr(mut g, value)\n        },\n      },\n      other => codegen.destructure(mut g, other, ty, value),\n    },\n    ast.VarDecl { name, ty, value } => codegen.declare(mut g, name, ty, value, true),\n    ast.Assign { place: ast.Var(x), value: given } => {\n      // a refined element type: only the added elements are checked\n      (value, elements) := codegen.checked_update(mut g, ast.Var(x), given)\n      // `xs[i] = v`, `xs = set_at(xs, i, v)`: in place when nothing else\n      // holds `xs`, and only `v` checked against a refined element type\n      each := codegen.element_check(g, x, value)\n      mut whole := !elements\n      // `x = insert(x, …)`: in place when nothing else holds `x`.\n      // `x += e` on a list or string: extended in place when possible.\n      v := match codegen.set_in_place(mut g, ast.Var(x), value, each) {\n        Some(u) => {\n          whole = each is None\n          u\n        },\n        None => match codegen.update_in_place(mut g, ast.Var(x), value) {\n          Some(u) => u,\n          None => match codegen.appended(mut g, ast.Var(x), value) {\n            Some(u) => u,\n            None => codegen.assigned_call(mut g, x, value),\n          },\n        },\n      }\n      if v.ty is check.TAny {\n        return\n      }\n      match codegen.lookup(g, x) {\n        Some(l0) => {\n          // a variable declared with a partly unknown type (`mut xs := []`)\n          // takes the type the value gives it\n          l := codegen.retype(mut g, l0, v.ty)\n          // (a call's words: into the variable's own block when nothing\n          // else holds it)\n          if codegen.assign_held(mut g, l, v) {\n            return\n          }\n          match get(g.declared, l.slot) {\n            Some(dt) => if whole {\n              codegen.check_type(\n                mut g,\n                dt,\n                v,\n                f\"assigning `{x}`\",\n                [],\n              )\n            },\n            None => (),\n          }\n          // the new value held, the old one dropped\n          x := codegen.converted(mut g, v, l.ty)\n          nv := codegen.take_value(mut g, codegen.V { ..x, ty: l.ty })\n          old := codegen.load(mut g, l)\n          codegen.store_var(mut g, nv, l)\n          codegen.drop_value(mut g, old)\n        },\n        None => codegen.not_yet(mut g, \"assigning to `\" + x + \"`\"),\n      }\n    },\n    ast.Assign { place, value: given } => match codegen.place_of(place) {\n      Some((x, path)) => {\n        (value, elements) := codegen.checked_update(mut g, place, given)\n        v := match codegen.update_in_place(mut g, place, value) {\n          Some(u) => u,\n          None => match codegen.appended(mut g, place, value) {\n            Some(u) => u,\n            None => codegen.expr(mut g, value),\n          },\n        }\n        if v.ty is check.TAny {\n          return\n        }\n        match codegen.lookup(g, x) {\n          Some(l) => {\n            g.elements_checked = elements\n            codegen.assign_at(\n              mut g,\n              l,\n              x,\n              path,\n              v,\n              g.proven_root == x,\n            )\n            g.elements_checked = false\n          },\n          None => codegen.not_yet(\n            mut g,\n            \"assigning to `\" + text.expr_text(place, 0) + \"`\",\n          ),\n        }\n      },\n      None => codegen.not_yet(\n        mut g,\n        \"assigning to `\" + text.expr_text(place, 0) + \"`\",\n      ),\n    },\n    ast.While { cond, body } => {\n      (head, inner, end) := (\n        codegen.label(mut g, \"while\"),\n        codegen.label(mut g, \"while.body\"),\n        codegen.label(mut g, \"while.end\"),\n      )\n      kept := codegen.decreases_start(mut g, body)\n      codegen.br(mut g, head)\n      codegen.block(mut g, head)\n      codegen.invariants(mut g, body)\n      codegen.push_transparent(mut g)\n      c := codegen.expr(mut g, cond)\n      if c.ty is check.TAny {\n        codegen.discard_scope(mut g)\n        return\n      }\n      codegen.pop_scope(mut g)\n      codegen.emit(\n        mut g,\n        f\"br i1 {c.op}, label %{inner}, label %{end}\",\n      )\n      codegen.block(mut g, inner)\n      mut g.loops.push((head, end, len(g.scopes)))\n      codegen.loop_step(mut g)\n      codegen.decreases_pass(\n        mut g,\n        body,\n        kept,\n        \"while \" + text.expr_text(cond, 0),\n      )\n      codegen.loop_body(mut g, body)\n      g.loops = take(g.loops, len(g.loops) - 1)\n      codegen.br(mut g, head)\n      codegen.block(mut g, end)\n    },\n    ast.Loop(body) => {\n      (head, end) := (\n        codegen.label(mut g, \"loop\"),\n        codegen.label(mut g, \"loop.end\"),\n      )\n      kept := codegen.decreases_start(mut g, body)\n      codegen.br(mut g, head)\n      codegen.block(mut g, head)\n      codegen.invariants(mut g, body)\n      mut g.loops.push((head, end, len(g.scopes)))\n      codegen.loop_step(mut g)\n      codegen.decreases_pass(mut g, body, kept, \"loop\")\n      codegen.loop_body(mut g, body)\n      g.loops = take(g.loops, len(g.loops) - 1)\n      codegen.br(mut g, head)\n      codegen.block(mut g, end)\n    },\n    ast.Break => match get(g.loops, len(g.loops) - 1) {\n      Some(l) => {\n        codegen.drop_from(mut g, l.2, \"\")\n        codegen.br(mut g, l.1)\n        codegen.dead(mut g)\n      },\n      None => codegen.not_yet(mut g, \"`break` outside a loop\"),\n    },\n    ast.Continue => match get(g.loops, len(g.loops) - 1) {\n      Some(l) => {\n        codegen.drop_from(mut g, l.2, \"\")\n        codegen.br(mut g, l.0)\n        codegen.dead(mut g)\n      },\n      None => codegen.not_yet(mut g, \"`continue` outside a loop\"),\n    },\n    ast.ExprStmt(x) => {\n      _ := codegen.expr(mut g, x)\n    },\n    ast.Assert(x) => codegen.assertion(mut g, x),\n    ast.Comment(_) => (),\n    // checked at the loop's head\n    ast.Invariant(_) => (),\n    ast.For { pat, iter, body } => codegen.for_loop(mut g, pat, iter, body),\n    ast.ComptimeFor { .. } => codegen.not_yet(mut g, \"`comptime for`\"),\n    _ => (),\n  }\n}","old_text":"/// `stmt` of `s`, compiled.\nfn stmt_node(mut g: codegen.Gen, s: ast.Stmt) {\n  // `--copies`: the statement's value, when it is the program's own code\n  // as written and not compiler-made\n  if g.copies {\n    e := match s {\n      ast.Let { value, .. } => value,\n      ast.VarDecl { value, .. } => value,\n      ast.Assign { value, .. } => value,\n   