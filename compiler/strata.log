urrent(g)))\n  }\n  codegen.block(mut g, end)\n  r := codegen.result_joined(\n    mut g,\n    rp,\n    codegen.join_values(mut g, incoming),\n    incoming,\n  )\n  // each arm's value is held: the match's scope holds the one that came\n  r1 := codegen.temp(mut g, r)\n  x := codegen.leave_branch(mut g, r1)\n  codegen.temp(mut g, x)\n}"},{"name":"codegen.match_got","kind":"fn","old":"321ff3d3cc60b5cc","new":"4a47443f0b27fa84","interface_changed":true,"affected":["codegen.matching_want","codegen.matching","codegen.expr_want_node","codegen.expr_node","codegen.expr_want","codegen.expr","codegen.function","codegen.binary","codegen.declare","codegen.destructure","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.method_call","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.try_want","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.checked_update","codegen.appended","codegen.compared","codegen.stmt_node","codegen.build_fn","codegen.push_in_place","codegen.call_named","codegen.interp","codegen.logic","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.decreases_pass","codegen.decreases_call","codegen.keep_olds","codegen.export_entry","codegen.expr_on_stack","codegen.assigned_call","codegen.compiled_alone","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.by_variant","codegen.list_literal","codegen.generate","codegen.construct