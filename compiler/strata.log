st.Expr,\n  otherwise: ast.Expr,\n  want: check.Ty,\n) -> codegen.V {\n  // (in result position: each branch's value is, joined in a result block)\n  rp := g.result_pos\n  g.result_pos = false\n  c := codegen.expr(mut g, cond)\n  if c.ty is check.TAny {\n    return c\n  }\n  (lt, lf, end) := (\n    codegen.label(mut g, \"then\"),\n    codegen.label(mut g, \"else\"),\n    codegen.label(mut g, \"endif\"),\n  )\n  // no `else`, and `()` wanted: no block for it\n  bare := (otherwise == ast.UnitExpr\n      || otherwise == ast.Block { stmts: [], last: ast.UnitExpr })\n    && !(codegen.holds_trait(want)\n      || codegen.sized(want) is Some\n      || codegen.holds_union(want))\n  from_c := codegen.current(g)\n  to_f := if bare {\n    end\n  } else {\n    lf\n  }\n  codegen.emit(mut g, f\"br i1 {c.op}, label %{lt}, label %{to_f}\")\n  codegen.block(mut g, lt)\n  codegen.push_transparent(mut g)\n  // `if x is M`: `x` is the member `M` inside\n  match cond {\n    ast.IsExpr { value: ast.Var(x), variant } => match codegen.lookup(g, x) {\n      Some(l) => match l.ty {\n        check.TUnion(ms) => match codegen.member_named(g, ms, variant) {\n          Some(m) => {\n            cur := codegen.load(mut g, l)\n            nx := codegen.narrow(mut g, cur, m)\n            codegen.narrowed_var(mut g, x, l, nx)\n          },\n          None => (),\n        },\n        _ => (),\n      },\n      None => (),\n    },\n    _ => (),\n  }\n  g.result_pos = rp\n  t0 := codegen.branch_value(mut g, then, want)\n  g.result_pos = false\n  tv := if rp {\n    codegen.result_own(mut g, codegen.leave_branch(mut g, t0))\n  } else {\n    codegen.leave_branch(mut g, t0)\n  }\n  from_t := codegen.current(g)\n  codegen.br(mut g, end)\n  if bare {\n    codegen.block(mut g, end)\n    r := codegen.join_values(\n      mut g,\n      [(tv, from_t), (codegen.unit(), from_c)],\n    )\n    return codegen.temp(mut g, r)\n  }\n  codegen.block(mut g, lf)\n  codegen.push_transparent(mut g)\n  g.result_pos = rp\n  f0 := codegen.branch_value(mut g, otherwise, want)\n  g.result_pos = false\n  fv := if rp {\n    codegen.result_own(mut g, codegen.leave_branch(mut g, f0))\n  } else {\n    codegen.leave_branch(mut g, f0)\n  }\n  from_f := codegen.current(g)\n  codegen.br(mut g, end)\n  codegen.block(mut g, end)\n  joined := [(tv, from_t), (fv, from_f)]\n  r := codegen.join_values(mut g, joined)\n  codegen.temp(mut g, codegen.result_joined(mut g, rp, r, joined))\n}","old_text":"/// `if_expr` with each branch's value made as `want` says (a trait value\n/// from a concrete one).\nfn if_want(\n  mut g: codegen.Gen,\n  cond: ast.Expr,\n  then: ast.Expr,\n  otherwise: ast.Expr,\n  want: Ty,\n) -> codegen.V {\n  // (in result position: each branch's value is, joined in a result block)\n  rp := g.result_pos\n  g.result_pos = false\n  c := codegen.expr(mut g, cond)\n  if c.ty is TAny {\n    return c\n  }\n  (lt, lf, end) := (\n    codegen.label(mut g, \"then\"),\n    codegen.label(mut g, \"else\"),\n    codegen.label(mut g, \"endif\"),\n  )\n  // no `else`, and `()` wanted: no block for it\n  bare := (otherwise == ast.UnitExpr\n      || otherwise == ast.Block { stmts: [], last: ast.UnitExpr })\n    && !(codegen.holds_trait(want)\n      || codegen.sized(want) is Some\n      || codegen.holds_union(want))\n  from_c := codegen.current(g)\n  to_f := if bare {\n    end\n  } else {\n    lf\n  }\n  codegen.emit(mut g, f\"br i1 {c.op}, label %{lt}, label %{to_f}\")\n  codegen.block(mut g, lt)\n  codegen.push_transparent(mut g)\n  // `if x is M`: `x` is the member `M` inside\n  match cond {\n    ast.IsExpr { value: ast.Var(x), variant } => match codegen.lookup(g, x) {\n      Some(l) => match l.ty {\n        TUnion(ms) => match codegen.member_named(g, ms, variant) {\n          Some(m) => {\n            cur := codegen.load(mut g, l)\n            nx := codegen.narrow(mut g, cur, m)\n            codegen.narrowed_var(mut g, x, l, nx)\n          },\n          None => (),\n        },\n        _ => (),\n      },\n      None => (),\n    },\n    _ => (),\n  }\n  g.result_pos = rp\n  t0 := codegen.branch_value(mut g, then, want)\n  g.result_pos = false\n  tv := if rp {\n    codegen.result_own(mut g, codegen.leave_branch(mut g, t0))\n  } else {\n    codegen.leave_branch(mut g, t0)\n  }\n  from_t := codegen.current(g)\n  codegen.br(mut g, end)\n  if bare {\n    codegen.block(mut g, end)\n    r := codegen.join_values(\n      mut g,\n      [(tv, from_t), (codegen.unit(), from_c)],\n    )\n    return codegen.temp(mut g, r)\n  }\n  codegen.block(mut g, lf)\n  codegen.push_transparent(mut g)\n  g.result_pos = rp\n  f0 := codegen.branch_value(mut g, otherwise, want)\n  g.result_pos = false\n  fv := if rp {\n    codegen.result_own(mut g, codegen.leave_branch(mut g, f0))\n  } else {\n    codegen.leave_branch(mut g, f0)\n  }\n  from_f := codegen.current(g)\n  codegen.br(mut g, end)\n  codegen.block(mut g, end)\n  joined := [(tv, from_t), (fv, from_f)]\n  r := codegen.join_values(mut g, joined)\n  codegen.temp(mut g, codegen.result_joined(mut g, rp, r, joined))\n}"},{"name":"codegen.branch_value","kind":"fn","old":"334438aac7408ab8","new":"290f135891b7c086","interface_changed":true,"affected":["codegen.if_want","codegen.matching_v","codegen.match_got","codegen.if_expr","codegen.expr_want_node","codegen.matching_want","codegen.expr_node","codegen.expr_want","codegen.matching","codegen.expr","codegen.function","codegen.binary","codegen.declare","codegen.destructure","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.method_call","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.try_want","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.checked_update","codegen.appended","codegen.compared","codegen.stmt_node","codegen.build_fn","codegen.push_in_place","codegen.call_named","codegen.interp",