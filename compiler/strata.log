= codegen.to_slot(mut g, x)\n  cur := codegen.fresh(mut g, \"cur\")\n  codegen.emit(mut g, f\"{cur} = load ptr, ptr {acc}\")\n  args := [\n    codegen.V { ty: lt, op: cur },\n    codegen.V { ty: check.TInt, op: s },\n    codegen.elements_kind(rt),\n  ]\n  nx := codegen.call_bare(mut g, lt, \"@strata_list_push\", args)\n  codegen.drop_value(mut g, codegen.V { ty: lt, op: cur })\n  codegen.emit(mut g, f\"store ptr {nx.op}, ptr {acc}\")\n  codegen.pop_scope(mut g)\n  codegen.each_next(mut g, at)\n  r := codegen.fresh(mut g, \"awaited\")\n  codegen.emit(mut g, f\"{r} = load ptr, ptr {acc}\")\n  codegen.temp(mut g, codegen.V { ty: lt, op: r })\n}","old_text":"/// `await` of a list of handles: their results in order.\nfn await_list(mut g: codegen.Gen, v: codegen.V, rt: Ty) -> codegen.V {\n  codegen.use_rt(mut g, \"strata_list_new\")\n  codegen.use_rt(mut g, \"strata_list_push\")\n  lt := TList(rt)\n  acc := codegen.fresh(mut g, \"awaited\")\n  mut g.allocas.push(f\"  {acc} = alloca ptr\")\n  n := codegen.list_len(mut g, v)\n  l0 := codegen.call_bare(mut g, lt, \"@strata_list_new\", [n])\n  codegen.emit(mut g, f\"store ptr {l0.op}, ptr {acc}\")\n  at := codegen.each_start(mut g, v)\n  codegen.push_scope(mut g)\n  h := codegen.list_at(\n    mut g,\n    v,\n    at.1,\n    TNamed { name: \"Task\", args: [rt] },\n  )\n  y := codegen.await_one(mut g, h, rt)\n  x := codegen.take_value(mut g, y)\n  s := codegen.to_slot(mut g, x)\n  cur := codegen.fresh(mut g, \"cur\")\n  codegen.emit(mut g, f\"{cur} = load ptr, ptr {acc}\")\n  args := [\n    codegen.V { ty: lt, op: cur },\n    codegen.V { ty: TInt, op: s },\n    codegen.elements_kind(rt),\n  ]\n  nx := codegen.call_bare(mut g, lt, \"@strata_list_push\", args)\n  codegen.drop_value(mut g, codegen.V { ty: lt, op: cur })\n  codegen.emit(mut g, f\"store ptr {nx.op}, ptr {acc}\")\n  codegen.pop_scope(mut g)\n  codegen.each_next(mut g, at)\n  r := codegen.fresh(mut g, \"awaited\")\n  codegen.emit(mut g, f\"{r} = load ptr, ptr {acc}\")\n  codegen.temp(mut g, codegen.V { ty: lt, op: r })\n}"},{"name":"codegen.channel_new","kind":"fn","old":"c576c88b6e0fb488","new":"b2835c37c6731995","interface_changed":true,"affected":["codegen.call_named","codegen.expr_node","codegen.expr_want_node","codegen.expr","codegen.expr_want","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.method_call","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.try_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.compared","codegen.stmt_node","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.function","codegen.declare","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.dyn_call","codegen.scope_expr","codegen.fuzz_driver","codegen.wanted","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.binds","codegen.matching_v","codegen.assertion","codegen.invariants","codegen.tag_is","codegen.check_type","codegen.satisfies","codegen.holds_pred","codegen.entry","codegen.vtable","codegen.mock_table","codegen.mock_call","codegen.list_builtin","codegen.collection_builtin","codegen.produce","codegen.table_find","codegen.generate","codegen.construct","codegen.operands","codegen.if_expr","codegen.matching","codegen.try_expr","codegen.stmt","codegen.built_or_generated","codeg