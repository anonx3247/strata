(mut x, x.self_ty)\n  derive.self_in(e, v)\n}","old_text":"/// `e` with `Self`, the type derived for as a value, written in.\nfn with_self(mut x: derive.X, e: ast.Expr) -> ast.Expr {\n  if x.self_ty == ast.UnitType {\n    return e\n  }\n  v := derive.type_value(mut x, x.self_ty)\n  derive.self_in(e, v)\n}"},{"name":"derive.data","kind":"fn","old":"aa1f6dc7a3f7f460","new":"6eee0ce101e33e64","interface_changed":true,"affected":["derive.fold_comptime","derive.eval_as","derive.expr","derive.folded_in","derive.eval_here","derive.derive","derive.call_copy","derive.derive_fn","derive.children","derive.field_read","derive.type_method","derive.with_known","derive.block","derive.comprehension","derive.expand_with","derive.expand_in","expanded","check_errors_in","derive.match_type","derive.derive_all","derive.make","derive.call_fn","derive.expand","holes_command","check_summary","verified_decls","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","derive.derived_in","eval_files","instantiated_files","with_extra","command_line","check_command","verified_with","static_graph","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","verify_file","repl_command","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","std_reached","main","strata_command","verified_program","build_command","graph_command","graph_diff","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","graph_runs","replay","or_solver_inputs","verify_command","run_command","program_objects","build_proofs","package_errors","merge_file_command","merged_checks","core_rt_text","call_command","edit_command","check_files","rename_command","move_command","fix_command","edit_in_editor","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","smt_file","termination_file","diff_command","check_fn","linked","sync_command","build_core_command","computed_value","codegen.read_back","comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"/// The value of `e` if it is data: literals, constructors of them, known\n/// names and their fields. `None` when something would have to run.\nfn data(mut x: derive.Expander, e: ast.Expr) -> Option[ast.Expr] {\n  mut locals := []\n  derive.data_in(mut x, e, mut locals)\n}","old_text":"/// The value of `e` if it is data: literals, constructors of them, known\n/// names and their fields. `None` when something would have to run.\nfn data(mut x: derive.X, e: ast.Expr) -> Option[ast.Expr] {\n  mut locals := []\n  derive.data_in(mut x, e, mut locals)\n}"},{"name":"derive.data_in","kind":"fn","old":"7a6d534c7b24f4e7","new":"07b8ca51daa710cd","interface_changed":true,"affected":["derive.data","derive.ctor_data","derive.fold_comptime","derive.eval_as","derive.expr","derive.folded_in","derive.eval_here","derive.derive","derive.call_copy","derive.derive_fn","derive.children","derive.field_read","derive.type_method","derive.with_known","derive.block","derive.comprehension","derive.expand_with","derive.expand_in","expanded","check_errors_in","derive.match_type","derive.derive_all","derive.make","derive.call_fn","derive.expand","holes_command","check_summary","verified_decls","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","derive.derived_in","eval_files","instantiated_files","with_extra","command_line","check_command","verified_with","static_graph","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","verify_file","repl_command","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","std_reached","main","strata_command","verified_program","build_command","graph_command","graph_diff","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","graph_runs","replay","or_solver_inputs","verify_command","run_command","program_objects","build_proofs","package_errors","merge_file_command","merged_checks","core_rt_text","call_command","edit_command","check_files","rename_command","move_command","fix_command","edit_in_editor","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","smt_file","termination_file","diff_command","check_fn","linked","sync_command","build_core_command","computed_value","codegen.read_back","comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"fn data_in(\n  mut x: derive.Expander,\n  e: ast.Expr,\n  mut locals: List[(String, ast.Expr)],\n) -> Option[ast.Expr] {\n  match e {\n    ast.Var(n) => {\n      mut found := None\n      for l in locals {\n        if l.0 == n {\n          found = Some(l.1)\n        }\n      }\n      match found {\n        Some(v) => return Some(v),\n        None => (),\n      }\n      if derive.is_known(x, n) {\n        return get(x.known, n)\n      }\n      if derive.is_self(e) && x.self_ty != ast.UnitType {\n        return Some(derive.type_value(mut x, x.self_ty))\n      }\n      None\n    },\n    ast.CtorExpr { name: \"Self\", args: ast.NoArgs } => if x.self_ty != ast.UnitType {\n      Some(derive.type_value(mut x, x.self_ty))\n    } else {\n      None\n    },\n    // `m.kind is Union`: a known constructor name\n    ast.IsExpr { value, variant } => if contains(x.ix.ctors, variant) && !contains(x.ix.types, variant) {\n      match derive.data_in(mut x, value, mut locals) {\n        Some(ast.CtorExpr { name, .. }) => Some(\n          ast.BoolLit(derive.short(name) == derive.short(variant)),\n        ),\n        _ => None,\n      }\n    } else {\n      None\n    },\n    // `Self.fields.map(f -> f.name)`: each item through a lambda that is data too\n    ast.MethodCall { recv, name: \"map\", args: [ast.Lambda { params: [p], body }] } => match derive.data_in(mut x, recv, mut locals) {\n      Some(ast.ListExpr(items)) => {\n        mut out := []\n        for it in items {\n          mut locals.push((p.name, it))\n          v := derive.data_in(mut x, body, mut locals)\n          locals = take(locals, len(locals) - 1)\n          match v {\n            Some(y) => mut out.push(y),\n            None => return None,\n          }\n        }\n        Some(ast.ListExpr(out))\n      },\n      _ => None,\n    },\n    ast.IntLit(_) | ast.BigIntLit(_) | ast.FloatLit(_) | ast.BoolLit(_) | ast.StrLit(_) | ast.UnitExpr => Some(e),\n    // `a ?? b`\n    ast.Fallback { value, fallback } => match derive.data_in(mut x, value, mut locals) {\n      Some(ast.CtorExpr { name: \"Some\", args: ast.PositionalArgs([v]) }) => Some(v),\n      Some(ast.CtorExpr { name: \"None\", args: ast.NoArgs }) => derive.data_in(mut x, fallback, mut locals),\n      _ => None,\n    },\n    ast.Binary { op, left, right } => {\n      a := match derive.data_in(mut x, left, mut locals) {\n        Some(v) => v,\n        None => return None,\n      }\n      b := match derive.data_in(mut x, right, mut locals) {\n        Some(v) => v,\n        None => return None,\n      }\n      match (op, a, b) {\n        (ast.Equal, _, _) => Some(ast.BoolLit(a == b)),\n        (ast.NotEqual, _, _) => Some(ast.BoolLit(a != b)),\n        (ast.And, ast.BoolLit(p), ast.BoolLit(r)) => Some(ast.BoolLit(p && r)),\n        (ast.Or, ast.BoolLit(p), ast.BoolLit(r)) => Some(ast.BoolLit(p || r)),\n        (ast.Less, ast.IntLit(p), ast.IntLit(r)) => Some(ast.BoolLit(p < r)),\n        (ast.LessEq, ast.IntLit(p), ast.IntLit(r)) => Some(ast.BoolLit(p <= r)),\n        (ast.Greater, ast.IntLit(p), ast.IntLit(r)) => Some(ast.BoolLit(p > r)),\n        (ast.GreaterEq, ast.IntLit(p), ast.IntLit(r)) => Some(ast.BoolLit(p >= r)),\n        _ => None,\n      }\n    },\n    ast.Unary { op: ast.Not, operand } => match derive.data_in(mut x, operand, mut locals) {\n      Some(ast.BoolLit(b)) => Some(ast.BoolLit(!b)),\n      _ => None,\n    },\n    ast.Call { callee: ast.Var(\"len\"), args: [a] } => match derive.data_in(mut x, a, mut locals) {\n      Some(ast.ListExpr(xs)) => Some(ast.IntLit(len(xs))),\n      _ => None,\n    },\n    ast.ListExpr(xs) => {\n      mut out := []\n      for y in xs {\n        match derive.data_in(mut x, y, mut locals) {\n          Some(v) => mut out.push(v),\n          None => return None,\n        }\n      }\n      Some(ast.ListExpr(out))\n    },\n    ast.TupleExpr(xs) => {\n      mut out := []\n      for y in xs {\n        match derive.data_in(mut x, y, mut locals) {\n          Some(v) => mut out.push(v),\n          None => return None,\n        }\n      }\n      Some(ast.TupleExpr(out))\n    },\n    ast.FieldOf { base: b, name: f } => match derive.data_in(mut x, b, mut locals) {\n      // a type's lists, written out in full (`f.type.fields`)\n      Some(v) => match v {\n        ast.CtorExpr { name: c, args: ast.RecordArgs(fs) } => if c == derive.q(\"Type\")\n          && contains([\"fields\", \"elements\", \"members\"], f) {\n          derive.full(mut x, v, f)\n        } else {\n          match fs.find(kv -> kv.0 == f) {\n            Some(kv) => Some(kv.1),\n            None => None,\n          }\n        },\n        _ => None,\n      },\n      None => None,\n    },\n    ast.CtorExpr { name: c, args } => derive.ctor_data(mut x, c, args, mut locals),\n    _ => None,\n  }\n}","old_text":"fn data_in(\n  mut x: derive.X,\n  e: ast.Expr,\n  mut locals: List[(String, ast.Expr)],\n) -> Option[ast.Expr] {\n  match e {\n    ast.Var(n) => {\n      mut found := None\n      for l in locals {\n        if l.0 == n {\n          found = Some(l.1)\n        }\n      }\n      match found {\n        Some(v) => return Some(v),\n        None => (),\n      }\n      if derive.is_known(x, n) {\n        return get(x.known, n)\n      }\n      if derive.is_self(e) && x.self_ty != ast.UnitType {\n        return Some(derive.type_value(mut x, x.self_ty))\n      }\n      None\n    },\n    ast.CtorExpr { name: \"Self\", args: ast.NoArgs } => if x.self_ty != ast.UnitType {\n      Some(derive.type_value(mut x, x.self_ty))\n    } else {\n      None\n    },\n    // `m.kind is Union`: a known constructor name\n    ast.IsExpr { value, variant } => if contains(x.ix.ctors, variant) && !contains(x.ix.types, variant) {\n      match derive.data_in(mut x, value, mut locals) {\n        Some(ast.CtorExpr { name, .. }) => Some(\n          ast.BoolLit(derive.short(name) == derive.short(variant)),\n        ),\n        _ => None,\n      }\n    } else {\n      None\n    },\n    // `Self.fields.map(f -> f.name)`: each item through a lambda that is data too\n    ast.MethodCall { recv, name: \"map\", args: [ast.Lambda { params: [p], body }] } => match derive.data_in(mut x, recv, mut locals) {\n      Some(ast.ListExpr(items)) => {\n        mut out := []\n        for it in items {\n          mut locals.push((p.name, it))\n          v := derive.data_in(mut x, body, mut locals)\n          locals = take(locals, len(locals) - 1)\n          match v {\n            Some(y) => mut out.push(y),\n            None => return None,\n          }\n        }\n        Some(ast.ListExpr(out))\n      },\n      _ => None,\n    },\n    ast.IntLit(_) | ast.BigIntLit(_) | ast.FloatLit(_) | ast.BoolLit(_) | ast.StrLit(_) | ast.UnitExpr => Some(e),\n    // `a ?? b`\n    ast.Fallback { value, fallback } => match derive.data_in(mut x, value, mut locals) {\n      Some(ast.CtorExpr { name: \"Some\", args: ast.PositionalArgs([v]) }) => Some(v),\n      Some(ast.CtorExpr { name: \"None\", args: ast.NoArgs }) => derive.data_in(mut x, fallback, mut locals),\n      _ => None,\n    },\n    ast.Binary { op, left, right } => {\n      a := match derive.data_in(mut x, left, mut locals) {\n        Some(v) => v,\n        None => return None,\n      }\n      b := match derive.data_in(mut x, right, mut locals) {\n        Some(v) => v,\n        None => return None,\n      }\n      match (op, a, b) {\n        (ast.Equal, _, _) => Some(ast.BoolLit(a == b)),\n        (ast.NotEqual, _, _) => Some(ast.BoolLit(a != b)),\n        (ast.And, ast.BoolLit(p), ast.BoolLit(r)) => Some(ast.BoolLit(p && r)),\n        (ast.Or, ast.BoolLit(p), ast.BoolLit(r)) => Some(ast.BoolLit(p || r)),\n        (ast.Less, ast.IntLit(p), ast.IntLit(r)) => Some(ast.BoolLit(p < r)),\n        (ast.LessEq, ast.IntLit(p), ast.IntLit(r)) => Some(ast.BoolLit(p <= r)),\n        (ast.Greater, ast.IntLit(p), ast.IntLit(r)) => Some(ast.BoolLit(p > r)),\n        (ast.GreaterEq, ast.IntLit(p), ast.IntLit(r)) => Some(ast.BoolLit(p >= r)),\n        _ => None,\n      }\n    },\n    ast.Unary { op: ast.Not, operand } => match derive.data_in(mut x, operand, mut locals) {\n      Some(ast.BoolLit(b)) => Some(ast.BoolLit(!b)),\n      _ => None,\n    },\n    ast.Call { callee: ast.Var(\"len\"), args: [a] } => match derive.data_in(mut x, a, mut locals) {\n      Some(ast.ListExpr(xs)) => Some(ast.IntLit(len(xs))),\n      _ => None,\n    },\n    ast.ListExpr(xs) => {\n      mut out := []\n      for y in xs {\n        match derive.data_in(mut x, y, mut locals) {\n          Some(v) => mut out.push(v),\n          None => return None,\n        }\n      }\n      Some(ast.ListExpr(out))\n    },\n    ast.TupleExpr(xs) => {\n      mut out := []\n      for y in xs {\n        match derive.data_in(mut x, y, mut locals) {\n          Some(v) => mut out.push(v),\n          None => return None,\n        }\n      }\n      Some(ast.TupleExpr(out))\n    },\n    ast.FieldOf { base: b, name: f } => match derive.data_in(mut x, b, mut locals) {\n      // a type's lists, written out in full (`f.type.fields`)\n      Some(v) => match v {\n        ast.CtorExpr { name: c, args: ast.RecordArgs(fs) } => if c == derive.q(\"Type\")\n          && contains([\"fields\", \"elements\", \"members\"], f) {\n          derive.full(mut x, v, f)\n        } else {\n          match fs.find(kv -> kv.0 == f) {\n            Some(kv) => Some(kv.1),\n            None => None,\n          }\n        },\n        _ => None,\n      },\n      None => None,\n    },\n    ast.CtorExpr { name: c, args } => derive.ctor_data(mut x, c, args, mut locals),\n    _ => None,\n  }\n}"},{"name":"derive.ctor_data","kind":"fn","old":"eadd3ea08b8e9cce","new":"43d2b23a69fc6384","interface_changed":true,"affected":["derive.data_in","derive.data","derive.fold_comptime","derive.eval_as","derive.expr","derive.folded_in","derive.eval_here","derive.derive","derive.call_copy","derive.derive_fn","derive.children","derive.field_read","derive.type_method","derive.with_known","derive.block","derive.comprehension","derive.expand_with","derive.expand_in","expanded","check_errors_in","derive.match_type","derive.derive_all","derive.make","derive.call_fn","derive.expand","holes_command","check_summary","verified_decls","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","derive.derived_in","eval_files","instantiated_files","with_extra","command_line","check_command","verified_with","static_graph","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","verify_file","repl_command","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","std_reached","main","strata_command","verified_program","build_command","graph_command","graph_diff","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","graph_runs","replay","or_solver_inputs","verify_command","run_command","program_objects","build_proofs","package_errors","merge_file_command","merged_checks","core_rt_text","call_command","edit_command","check_files","rename_command","move_command","fix_command","edit_in_editor","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","smt_file","termination_file","diff_command","check_fn","linked","sync_command","build_core_command","computed_value","codegen.read_back","comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"/// A constructor that is data: its type is neither `distinct` nor refined,\n/// and a record's fields are all given in declared order (a default would\n/// have to run).\nfn ctor_data(\n  mut x: derive.Expander,\n  c: String,\n  args: ast.CtorArgs,\n  mut locals: List[(String, ast.Expr)],\n) -> Option[ast.Expr] {\n  (tname, order) := match get(x.ix.ctors, c) {\n    Some(t) => (t, match derive.variant_decl(x, c) {\n      Some(v) => match v.payload {\n        ast.RecordPayload(fs) => fs.map(f -> f.name),\n        _ => [],\n      },\n      None => [],\n    }),\n    None => match get(x.ix.types, c) {\n      Some(td) => match td.body {\n        ast.RecordBody(fs) => (c, fs.map(f -> f.name)),\n        _ => return None,\n      },\n      None => return None,\n    },\n  }\n  td := match get(x.ix.types, tname) {\n    Some(t) => t,\n    None => return None,\n  }\n  if td.distinct || td.refinement is Some {\n    return None\n  }\n  match args {\n    ast.NoArgs => Some(ast.CtorExpr { name: c, args: ast.NoArgs }),\n    ast.PositionalArgs(es) => {\n      mut out := []\n      for y in es {\n        match derive.data_in(mut x, y, mut locals) {\n          Some(v) => mut out.push(v),\n          None => return None,\n        }\n      }\n      Some(ast.CtorExpr { name: c, args: ast.PositionalArgs(out) })\n    },\n    ast.RecordArgs(fs) => {\n      if len(order) != len(fs) {\n        return None\n      }\n      mut vals := []\n      for f in order {\n        match fs.find(kv -> kv.0 == f) {\n          Some(kv) => match derive.data_in(mut x, kv.1, mut locals) {\n            Some(v) => mut vals.push((f, v)),\n            None => return None,\n          },\n          None => return None,\n        }\n      }\n      Some(ast.CtorExpr { name: c, args: ast.RecordArgs(vals) })\n    },\n    ast.UpdateArgs { .. } => None,\n  }\n}","old_text":"/// A constructor that is data: its type is neither `distinct` nor refined,\n/// and a record's fields are all given in declared order (a default would\n/// have to run).\nfn ctor_data(\n  mut x: derive.X,\n  c: String,\n  args: ast.CtorArgs,\n  mut locals: List[(String, ast.Expr)],\n) -> Option[ast.Expr] {\n  (tname, order) := match get(x.ix.ctors, c) {\n    Some(t) => (t, match derive.variant_decl(x, c) {\n      Some(v) => match v.payload {\n        ast.RecordPayload(fs) => fs.map(f -> f.name),\n        _ => [],\n      },\n      None => [],\n    }),\n    None => match get(x.ix.types, c) {\n      Some(td) => match td.body {\n        ast.RecordBody(fs) => (c, fs.map(f -> f.name)),\n        _ => return None,\n      },\n      None => return None,\n    },\n  }\n  td := match get(x.ix.types, tname) {\n    Some(t) => t,\n    None => return None,\n  }\n  if td.distinct || td.refinement is Some {\n    return None\n  }\n  match args {\n    ast.NoArgs => Some(ast.CtorExpr { name: c, args: ast.NoArgs }),\n    ast.PositionalArgs(es) => {\n      mut out := []\n      for y in es {\n        match derive.data_in(mut x, y, mut locals) {\n          Some(v) => mut out.push(v),\n          None => return None,\n        }\n      }\n      Some(ast.CtorExpr { name: c, args: ast.PositionalArgs(out) })\n    },\n    ast.RecordArgs(fs) => {\n      if len(order) != len(fs) {\n        return None\n      }\n      mut vals := []\n      for f in order {\n        match fs.find(kv -> kv.0 == f) {\n          Some(kv) => match derive.data_in(mut x, kv.1, mut locals) {\n            Some(v) => mut vals.push((f, v)),\n            None => return None,\n          },\n          None => return None,\n        }\n      }\n      Some(ast.CtorExpr { name: c, args: ast.RecordArgs(vals) })\n    },\n    ast.UpdateArgs { .. } => None,\n  }\n}"},{"name":"derive.derive","kind":"fn","old":"ef80191711aecaf0","new":"90722d2986bf5ed4","interface_changed":true,"affected":["derive.derive_all","derive.derived_in","derive.expand_with","derive.expand_in","std_reached","expanded","check_errors_in","derive.expand","holes_command","check_summary","verified_decls","verify_file","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","eval_files","instantiated_files","with_extra","command_line","check_command","verified_with","static_graph","verify_command","build_proofs","alongside_command","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","repl_command","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","main","strata_command","verified_program","build_command","graph_command","graph_diff","run_command","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","or_solver_inputs","program_objects","package_errors","merge_file_command","merged_checks","core_rt_text","call_command","edit_command","check_files","rename_command","move_command","fix_command","edit_in_editor","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","smt_file","termination_file","diff_command","check_fn","linked","sync_command","build_core_command","computed_value","codegen.read_back","comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"// ---- deriving ----\n\n/// `derive Trait for Type { written }` as an ordinary `impl`.\nfn derive(\n  mut x: derive.Expander,\n  given: ast.ImplDecl,\n) -> Result[ast.ImplDecl, String] {\n  tr := match get(x.ix.traits, given.trait_name) {\n    Some(t) => t,\n    None => return Err(\"`\" + derive.short(given.trait_name) + \"` is not a trait\"),\n  }\n  dv := match tr.derivable {\n    Some(d) => d,\n    None => return Err(\"`\"\n      + derive.short(tr.name)\n      + \"` can't be derived: only a `derivable` trait can (write `impl \"\n      + derive.short(tr.name)\n      + \" for \"\n      + text.type_text(given.for_type)\n      + \"` instead)\"),\n  }\n  // a generic type (`derive Json for Pair`): for `Pair[T]`, each `T` must\n  // have the trait\n  mut i := given\n  head0 := derive.type_head(i.for_type)\n  match (i.for_type, get(x.ix.types, head0)) {\n    (ast.Named { name, args: [] }, Some(td)) => if len(td.params) > 0 {\n      i.for_type = ast.Named {\n        name,\n        args: td.params.map(p -> ast.Named { name: p, args: [] }),\n      }\n      for p in td.params {\n        if !contains(i.type_params, p) {\n          mut i.type_params.push(p)\n        }\n        if !i.bounds.any(b -> b.param == p) {\n          mut i.bounds.push(\n            ast.Bound {\n              param: p,\n              traits: [ast.Named { name: given.trait_name, args: [] }],\n            },\n          )\n        }\n      }\n    },\n    _ => (),\n  }\n  x.params = i.type_params\n  x.self_ty = i.for_type\n  x.trait_name = given.trait_name\n  x.trait_methods = tr.methods.map(m -> m.decl.name)\n  head := derive.type_head(i.for_type)\n  match get(x.ix.types, head) {\n    Some(td) => match td.body {\n      ast.RecordBody(_) | ast.SumBody(_) => (),\n      ast.Alias(_) => if !derive.union_alias(td) {\n        return Err(\"`\"\n          + derive.short(head)\n          + \"` is an alias: a derived trait needs a record or a sum type\")\n      },\n    },\n    None => return Err(\"`\" + head + \"` is not a type defined in this program\"),\n  }\n  // the kind: one of `std.typing.Kind`, `Choice`, or another refinement of\n  // `Type` that the type's value meets. A union of kinds accepts any.\n  ks := match dv.kind {\n    ast.UnionType(ms) => ms,\n    k => [k],\n  }\n  (kind, choice) := derive.kind_of(x, i.for_type)\n  mut kind_ok := false\n  for k in ks {\n    kn := derive.type_head(k)\n    sk := derive.short(kn)\n    fit := if kn == derive.q(sk) && contains(derive.kinds(), sk) {\n      kind == sk\n    } else if kn == derive.q(\"Choice\") {\n      choice\n    } else {\n      match get(x.ix.types, kn) {\n        Some(td) => match (td.body, td.refinement) {\n          (ast.Alias(ast.Named { name: b, .. }), Some(_)) => if b == derive.q(\"Type\") {\n            desc := derive.type_value(mut x, i.for_type)\n            match eval.value_in(\n              x.w,\n              x.module,\n              ast.IsExpr { value: desc, variant: kn },\n            ) {\n              Ok(ast.BoolLit(b2)) => b2,\n              _ => false,\n            }\n          } else {\n            false\n          },\n          _ => false,\n        },\n        None => false,\n      }\n    }\n    kind_ok = kind_ok || fit\n  }\n  if !kind_ok {\n    names := join(\n      ks.map(k -> \"`\" + derive.short(derive.type_head(k)) + \"`\"),\n      \" or a \",\n    )\n    return Err(\"`\"\n      + derive.short(tr.name)\n      + \"` can only be derived for a \"\n      + names\n      + \", and `\"\n      + derive.short(head)\n      + \"` isn't one\")\n  }\n  for r in dv.conditions {\n    r2 := derive.expr(mut x, r)!\n    ok := match derive.eval_as(mut x, r2, r) {\n      Ok(v) => v,\n      Err(m) => return Err(\n        \"checking what `\"\n          + derive.short(tr.name)\n          + \"` requires: \"\n          + m,\n      ),\n    }\n    if ok != ast.BoolLit(true) {\n      return Err(\"`\"\n        + derive.short(head)\n        + \"` doesn't meet what `\"\n        + derive.short(tr.name)\n        + \"` requires: \"\n        + text.expr_text(r, 0))\n    }\n  }\n  mut methods := i.methods\n  for m in tr.methods {\n    if i.methods.any(w -> w.name == m.decl.name) {\n      continue\n    }\n    if m.decl.derived {\n      body := match derive.expr(mut x, m.decl.body) {\n        Ok(b) => b,\n        Err(e) => return Err(\"deriving `\" + derive.short(m.decl.name) + \"`: \" + e),\n      }\n      mut methods.push(ast.FnDecl { ..m.decl, derived: false, body })\n    } else if !m.default {\n      return Err(\"`\"\n        + derive.short(tr.name)\n        + \"` doesn't derive `\"\n        + derive.short(m.decl.name)\n        + \"`: write it in `derive \"\n        + derive.short(tr.name)\n        + \" for \"\n        + derive.short(head)\n        + \" { ... }`\")\n    }\n  }\n  Ok(ast.ImplDecl { ..i, methods, derived: false })\n}","old_text":"// ---- deriving ----\n\n/// `derive Trait for Type { written }` as an ordinary `impl`.\nfn derive(\n  mut x: derive.X,\n  given: ast.ImplDecl,\n) -> Result[ast.ImplDecl, String] {\n  tr := match get(x.ix.traits, given.trait_name) {\n    Some(t) => t,\n    None => return Err(\"`\" + derive.short(given.trait_name) + \"` is not a trait\"),\n  }\n  dv := match tr.derivable {\n    Some(d) => d,\n    None => return Err(\"`\"\n      + derive.short(tr.name)\n      + \"` can't be derived: only a `derivable` trait can (write `impl \"\n      + derive.short(tr.name)\n      + \" for \"\n      + text.type_text(given.for_type)\n      + \"` instead)\"),\n  }\n  // a generic type (`derive Json for Pair`): for `Pair[T]`, each `T` must\n  // have the trait\n  mut i := given\n  head0 := derive.type_head(i.for_type)\n  match (i.for_type, get(x.ix.types, head0)) {\n    (ast.Named { name, args: [] }, Some(td)) => if len(td.params) > 0 {\n      i.for_type = ast.Named {\n        name,\n        args: td.params.map(p -> ast.Named { name: p, args: [] }),\n      }\n      for p in td.params {\n        if !contains(i.type_params, p) {\n          mut i.type_params.push(p)\n        }\n        if !i.bounds.any(b -> b.param == p) {\n          mut i.bounds.push(\n            ast.Bound {\n              param: p,\n              traits: [ast.Named { name: given.trait_name, args: [] }],\n            },\n          )\n        }\n      }\n    },\n    _ => (),\n  }\n  x.params = i.type_params\n  x.self_ty = i.for_type\n  x.trait_name = given.trait_name\n  x.trait_methods = tr.methods.map(m -> m.decl.name)\n  head := derive.type_head(i.for_type)\n  match get(x.ix.types, head) {\n    Some(td) => match td.body {\n      ast.RecordBody(_) | ast.SumBody(_) => (),\n      ast.Alias(_) => if !derive.union_alias(td) {\n        return Err(\"`\"\n          + derive.short(head)\n          + \"` is an alias: a derived trait needs a record or a sum type\")\n      },\n    },\n    None => return Err(\"`\" + head + \"` is not a type defined in this program\"),\n  }\n  // the kind: one of `std.typing.Kind`, `Choice`, or another refinement of\n  // `Type` that the type's value meets. A union of kinds accepts any.\n  ks := match dv.kind {\n    ast.UnionType(ms) => ms,\n    k => [k],\n  }\n  (kind, choice) := derive.kind_of(x, i.for_type)\n  mut kind_ok := false\n  for k in ks {\n    kn := derive.type_head(k)\n    sk := derive.short(kn)\n    fit := if kn == derive.q(sk) && contains(derive.kinds(), sk) {\n      kind == sk\n    } else if kn == derive.q(\"Choice\") {\n      choice\n    } else {\n      match get(x.ix.types, kn) {\n        Some(td) => match (td.body, td.refinement) {\n          (ast.Alias(ast.Named { name: b, .. }), Some(_)) => if b == derive.q(\"Type\") {\n            desc := derive.type_value(mut x, i.for_type)\n            match eval.value_in(\n              x.w,\n              x.module,\n              ast.IsExpr { value: desc, variant: kn },\n            ) {\n              Ok(ast.BoolLit(b2)) => b2,\n              _ => false,\n            }\n          } else {\n            false\n          },\n          _ => false,\n        },\n        None => false,\n      }\n    }\n    kind_ok = kind_ok || fit\n  }\n  if !kind_ok {\n    names := join(\n      ks.map(k -> \"`\" + derive.short(derive.type_head(k)) + \"`\"),\n      \" or a \",\n    )\n    return Err(\"`\"\n      + derive.short(tr.name)\n      + \"` can only be derived for a \"\n      + names\n      + \", and `\"\n      + derive.short(head)\n      + \"` isn't one\")\n  }\n  for r in dv.conditions {\n    r2 := derive.expr(mut x, r)!\n    ok := match derive.eval_as(mut x, r2, r) {\n      Ok(v) => v,\n      Err(m) => return Err(\n        \"checking what `\"\n          + derive.short(tr.name)\n          + \"` requires: \"\n          + m,\n      ),\n    }\n    if ok != ast.BoolLit(true) {\n      return Err(\"`\"\n        + derive.short(head)\n        + \"` doesn't meet what `\"\n        + derive.short(tr.name)\n        + \"` requires: \"\n        + text.expr_text(r, 0))\n    }\n  }\n  mut methods