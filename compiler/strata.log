shown})\")\n    codegen.unit()\n  }\n}","old_text":"/// Calls a function the program compiles, holding its result after the\n/// cancel point: an unwound callee returns nothing to drop.\nfn call_bare(\n  mut g: codegen.Gen,\n  ret: Ty,\n  sym: String,\n  args: List[codegen.V],\n) -> codegen.V {\n  shown := join(args\n    .filter(a -> codegen.has_value(a.ty))\n    .map(a -> codegen.ll(a.ty) + \" \" + a.op), \", \")\n  if codegen.has_value(ret) {\n    r := codegen.fresh(mut g, \"c\")\n    codegen.emit(\n      mut g,\n      f\"{r} = call {codegen.ll(ret)} {sym}({shown})\",\n    )\n    codegen.V { ty: ret, op: r }\n  } else {\n    codegen.emit(mut g, f\"call void {sym}({shown})\")\n    codegen.unit()\n  }\n}"},{"name":"codegen.scope_expr","kind":"fn","old":"e0d57e2625d6d43c","new":"92e7ee871c4032f4","interface_changed":true,"affected":["codegen.expr_node","codegen.expr","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.method_call","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.try_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.expr_want_node","codegen.compared","codegen.stmt_node","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.binds","codegen.matching_v","codegen.match_got","codegen.assertion","codegen.invariants","codegen.tag_is","codegen.check_type","codegen.satisfies","codegen.holds_pred","codege