.tail_share(mut g, x) {\n      return\n    }\n    codegen.share_value(mut g, x)\n  }\n  codegen.br(mut g, \"done\")\n}","old_text":"/// The fields of types `tys` of the block `a`, each marked shared; the\n/// last object's by a tail call (the function returns), else on to\n/// `%done`.\nfn share_fields(mut g: codegen.Gen, a: codegen.V, tys: List[Ty]) {\n  mut held := []\n  for (k, t) in enumerate(tys) {\n    if codegen.crosses(t) {\n      mut held.push(codegen.field(mut g, a, k, t))\n    }\n  }\n  for (k, x) in enumerate(held) {\n    if k + 1 == len(held) && codegen.tail_share(mut g, x) {\n      return\n    }\n    codegen.share_value(mut g, x)\n  }\n  codegen.br(mut g, \"done\")\n}"},{"name":"codegen.tail_share","kind":"fn","old":"bd9a92226b07e187","new":"59bf9beee278a8d6","interface_changed":false,"affected":[],"module":"codegen","text":"/// `share_value` of `v` as a tail call, then the return, when it is a call\n/// of a `share:T` helper: whether it was.\nfn tail_share(mut g: codegen.Gen, v: codegen.V) -> Bool {\n  if codegen.constant(v.op) {\n    return false\n  }\n  if codegen.is_collection(v.ty) {\n    return codegen.tail_share(\n      mut g,\n      codegen.V { ..v, ty: codegen.repr(v.ty) },\n    )\n  }\n  match v.ty {\n    check.TNamed { name: \"Sender\", .. } | check.TNamed { name: \"Receiver\", .. } => false,\n    check.TList(_) | check.TNamed { .. } | check.TUnion(_) | check.TFn { .. } | check.TTrait(_) => {\n      f := codegen.share_fn(mut g, v.ty)\n      codegen.emit(mut g, f\"musttail call void {f}(ptr {v.op})\")\n      codegen.emit(mut g, \"ret void\")\n      true\n    },\n    _ => false,\n  }\n}","old_text":"/// `share_value` of `v` as a tail call, then the return, when it is a call\n/// of a `share:T` helper: whether it was.\nfn tail_share(mut g: codegen.Gen, v: codegen.V) -> Bool {\n  if codegen.constant(v.op) {\n    return false\n  }\n  if codegen.is_collection(v.ty) {\n    return codegen.tail_share(\n      mut g,\n      codegen.V { ..v, ty: codegen.repr(v.ty) },\n    )\n  }\n  match v.ty {\n    TNamed { name: \"Sender\", .. } | TNamed { name: \"Receiver\", .. } => false,\n    TList(_) | TNamed { .. } | TUnion(_) | TFn { .. } | TTrait(_) => {\n      f := codegen.share_fn(mut g, v.ty)\n      codegen.emit(mut g, f\"musttail call void {f}(ptr {v.op})\")\n      codegen.emit(mut g, \"ret void\")\n      true\n    },\n    _ => false,\n  }\n}"},{"name":"codegen.constant_list","kind":"fn","old":"321031c466196b1b","new":"1d3e2c8110d2c8c5","interface_changed":true,"affected":["codegen.list_literal_of","codegen.list_literal","codegen.expr_want_node","codegen.expr_node","codegen.expr_want","codegen.expr","codegen.function","codegen.binary","codegen.declare","codegen.destructure","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.method_call","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.try_want","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.compared","codegen.stmt_node","codegen.build_fn","codegen.push_in_place","codegen.call_named","codegen.interp","codegen.logic","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.decreases_pass","codegen.decreases_call","codegen.keep_olds","codegen.export_entry","codegen.expr_on_stack","codegen.assigned_call","codegen.compiled_alone","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matc