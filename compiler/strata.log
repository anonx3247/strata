rors","edit_errors","build_proofs","search_invariants","check_fn","linked","expanded","comptime_runner","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","rename_command","move_command","fix_command","edit_in_editor"],"module":"","text":"/// std precompiled by compiler/codegen: its functions that compile once for\n/// every program (`codegen --library`), as an object executables link and a\n/// shared library the JIT loads, with their names. Runs in the home.\n/// \n/// A release ships it (`std/` in its home). Otherwise it is made the first\n/// time, then cached by its IR (`library_key`). Which library this compiler\n/// makes of this std is cached too (`std_library_key`), so the IR isn't\n/// made again. `None` with `STRATA_NO_STD_LIBRARY`, or when it can't be made\n/// (each program then compiles the std code it uses; `STRATA_DEBUG` says\n/// why).\nfn std_library(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  cache: cache.Cache,\n) -> Option[driver.StdLibrary] {\n  if process.var(\"STRATA_NO_STD_LIBRARY\") is Some {\n    return None\n  }\n  home := process.current_dir()\n  shipped := driver.std_library_at(home + \"/std\")\n  // (a release's was compiled without frame pointers)\n  if !toolchain.profiling()\n    && disk.exists(shipped.names)\n    && disk.exists(shipped.object)\n    && disk.exists(shipped.shared) {\n    return Some(shipped)\n  }\n  if !cache.caching() {\n    return None\n  }\n  // (what this compiler made of this std before)\n  made_of := \"std-library-of/\" + std_library_key(disk)\n  match cache.read_entry(disk, cache, made_of) {\n    Some(key) => match library_kept(disk, cache, key) {\n      Some(lib) => return Some(lib),\n      None => (),\n    },\n    None => (),\n  }\n  debug := process.var(\"STRATA_DEBUG\") is Some\n  ir := timings.timed(\n    \"std library: IR\",\n    () -> codegen_with(disk, shared(disk, cache), [\"--library\"], []),\n  )\n  errors := driver.codegen_errors(ir)\n  if errors != [] {\n    if debug {\n      mut console.eprint(\n        \"note: std is compiled with each program: \"\n          + join(errors, \"\\n\"),\n      )\n    }\n    return None\n  }\n  key := library_key(ir)\n  // (the same IR compiled before, by another compiler)\n  match library_kept(disk, cache, key) {\n    Some(lib) => {\n      match cache.write_entry(mut disk, cache, made_of, key) {\n        _ => (),\n      }\n      return Some(lib)\n    },\n    None => (),\n  }\n  dir := driver.parent_dir(\n    cache.own_path(mut disk, cache, \"std-library/\" + key + \"/names\"),\n  )\n  lib := driver.std_library_at(dir)\n  // (each to a file of its own, renamed when done: another process may be\n  // making it too)\n  tag := f\"{driver_pid().to_int()}\"\n  obj := dir + \"/std.\" + tag + \".o\"\n  so := dir + \"/libstd.\" + tag + \".dylib\"\n  names := dir + \"/names.\" + tag\n  made := match toolchain.object(ir, obj, 2) {\n    Err(e) => Err(e),\n    Ok(_) => toolchain.shared_library(\n      [obj],\n      so,\n      system_dir(disk, home),\n      \"@rpath/libstd.dylib\",\n    ),\n  }\n  match made {\n    Err(e) => {\n      if debug {\n        mut console.eprint(\n          \"note: std is compiled with each program: \" + e,\n        )\n      }\n      None\n    },\n    Ok(_) => {\n      match mut disk.rename(obj, lib.object) {\n        _ => (),\n      }\n      match mut disk.rename(so, lib.shared) {\n        _ => (),\n      }\n      match mut disk.write(\n        names,\n        join(driver.precompiled_names(ir), \"\\n\") + \"\\n\",\n      ) {\n        _ => (),\n      }\n      match mut disk.rename(names, lib.names) {\n        _ => (),\n      }\n      match cache.write_entry(mut disk, cache, made_of, key) {\n        _ => (),\n      }\n      Some(lib)\n    },\n  }\n}","old_text":"/// std precompiled by compiler/codegen: its functions that compile once for\n/// every program (`codegen --library`), as an object executables link and a\n/// shared library the JIT loads, with their names. Runs in the home.\n/// \n/// A release ships it (`std/` in its home). Otherwise it is made the first\n/// time, then cached by its IR (`library_key`). Which library this compiler\n/// makes of this std is cached too (`std_library_key`), so the IR isn't\n/// made again. `None` with `STRATA_NO_STD_LIBRARY`, or when it can't be made\n/// (each program then compiles the std code it uses; `STRATA_DEBUG` says\n/// why).\nfn std_library(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n) -> Option[driver.StdLibrary] {\n  if process.var(\"STRATA_NO_STD_LIBRARY\") is Some {\n    return None\n  }\n  home := process.current_dir()\n  shipped := driver.std_library_at(home + \"/std\")\n  // (a release's was compiled without frame pointers)\n  if !toolchain.profiling()\n    && disk.exists(shipped.names)\n    && disk.exists(shipped.object)\n    && disk.exists(shipped.shared) {\n    return Some(shipped)\n  }\n  if !cache.caching() {\n    return None\n  }\n  // (what this compiler made of this std before)\n  made_of := \"std-library-of/\" + std_library_key(disk)\n  match cache.read_entry(disk, cache, made_of) {\n    Some(key) => match library_kept(disk, cache, key) {\n      Some(lib) => return Some(lib),\n      None => (),\n    },\n    None => (),\n  }\n  debug := process.var(\"STRATA_DEBUG\") is Some\n  ir := timings.timed(\n    \"std library: IR\",\n    () -> codegen_with(disk, shared(disk, cache), [\"--library\"], []),\n  )\n  errors := driver.codegen_errors(ir)\n  if errors != [] {\n    if debug {\n      mut console.eprint(\n        \"note: std is compiled with each program: \"\n          + join(errors, \"\\n\"),\n      )\n    }\n    return None\n  }\n  key := library_key(ir)\n  // (the same IR compiled before, by another compiler)\n  match library_kept(disk, cache, key) {\n    Some(lib) => {\n      match cache.write_entry(mut disk, cache, made_of, key) {\n        _ => (),\n      }\n      return Some(lib)\n    },\n    None => (),\n  }\n  dir := driver.parent_dir(\n    cache.own_path(mut disk, cache, \"std-library/\" + key + \"/names\"),\n  )\n  lib := driver.std_library_at(dir)\n  // (each to a file of its own, renamed when done: another process may be\n  // making it too)\n  tag := f\"{driver_pid().to_int()}\"\n  obj := dir + \"/std.\" + tag + \".o\"\n  so := dir + \"/libstd.\" + tag + \".dylib\"\n  names := dir + \"/names.\" + tag\n  made := match toolchain.object(mut disk, ir, obj, 2) {\n    Err(e) => Err(e),\n    Ok(_) => toolchain.shared_library(\n      mut disk,\n      [obj],\n      so,\n      system_dir(disk, home),\n      \"@rpath/libstd.dylib\",\n    ),\n  }\n  match made {\n    Err(e) => {\n      if debug {\n        mut console.eprint(\n          \"note: std is compiled with each program: \" + e,\n        )\n      }\n      None\n    },\n    Ok(_) => {\n      match mut disk.rename(obj, lib.object) {\n        _ => (),\n      }\n      match mut disk.rename(so, lib.shared) {\n        _ => (),\n      }\n      match mut disk.write(\n        names,\n        join(driver.precompiled_names(ir), \"\\n\") + \"\\n\",\n      ) {\n        _ => (),\n      }\n      match mut disk.rename(names, lib.names) {\n        _ => (),\n      }\n      match cache.write_entry(mut disk, cache, made_of, key) {\n        _ => (),\n      }\n      Some(lib)\n    },\n  }\n}"},{"name":"linked","kind":"fn","old":"20f85cfbfdae0741","new":"e7df78459c986226","interface_changed":false,"affected":[],"module":"","text":"/// Makes the program's IR `ir` an executable. Returns what `build` says, or\n/// why it failed.\n/// - The program's objects are compiled in this process by\n/// compiler/toolchain, in parts and in parallel, each part's object cached\n/// in the cache's `objects` folder.\n/// - The runtime is a release's `runtime-lto.o` (the C runtime and core.rt\n/// optimized together, made once by tools/release.sh), else core.rt's\n/// object (by compiler/codegen, cached by its IR: `core_rt_object`) and the\n/// C runtime's (compiled by the C compiler, cached).\n/// - These are linked by lld against libSystem's stub, with the hash of the\n/// sources (`sources_object`) and std's precompiled object.\n/// - A package with C of its own (`[native]`) is linked by the C compiler\n/// instead. Each C file is compiled once and its object cached under the\n/// file's bytes and the flags (a header it includes is not in the key).\n/// The executable is cached too, one per output path, under the link's\n/// arguments (`link_key`): linking what didn't change again is a clone.\n/// - The C files not cached (the runtime's, the package's) are compiled at\n/// once, a C compiler process each (`toolchain.c_objects`), while LLVM\n/// compiles the program.\n/// - std's C libraries (`std_native_libs`) are named to the linker, which\n/// keeps those the executable calls.\n/// - A compiler (it links c/cache.c) gets its identity file beside it.\nfn linked(\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  sh: Shared,\n  line: driver.Args,\n  cwd: String,\n  home: String,\n  lib: Option[driver.StdLibrary],\n  path: String,\n  scratch: String,\n  ir: String,\n) -> Result[String, String] {\n  // (`--lib`: a shared library, `libNAME.dylib`)\n  library := driver.given(line, \"--lib\")\n  shown := driver.option_value(line, \"-o\") or {\n    if library {\n      \"lib\" + program_name_of(disk, path) + \".dylib\"\n    } else {\n      program_name_of(disk, path)\n    }\n  }\n  out := driver.absolute_path(cwd, shown)\n  cc := toolchain.c_compiler(process)\n  // (unoptimized by default; `--release` is -O2. core.rt and std's library\n  // are optimized either way.)\n  opt := if driver.given(line, \"--release\") {\n    2\n  } else {\n    0\n  }\n  // the objects made here are cached (`kept`)\n  kept := sh.cache.dir + \"/objects\"\n  // a release's runtime, made once (`--profile` wants frame pointers)\n  shipped := home + \"/runtime-lto.o\"\n  release := disk.exists(shipped) && !toolchain.profiling()\n  native := match deps.native_parts(disk, path) {\n    Ok(n) => n,\n    Err(e) => return Err(e),\n  }\n  // the C to compile (`jobs`), each object then moved to where it is cached\n  mut jobs := []\n  // the C runtime, with core.rt in place of its own versions\n  mut runtime := shipped\n  mut runtime_made := \"\"\n  if !release {\n    flags := [\n        \"-O2\",\n        \"-mmacosx-version-min=13.0\",\n        \"-Wno-deprecated-declarations\",\n        \"-DSTRATA_CORE_RT\",\n      ]\n      + if toolchain.profiling() {\n        [\"-fno-omit-frame-pointer\", \"-mno-omit-leaf-frame-pointer\"]\n      } else {\n        []\n      }\n    // (under the C compiler, its flags and the runtime's source)\n    key := toolchain.files_key(\n      join([\"runtime.c\", cc] + flags, \" \"),\n      [home + \"/runtime/runtime.c\"],\n    )\n    runtime = kept + \"/runtime-\" + key + \".o\"\n    if !disk.exists(runtime) {\n      runtime_made = scratch + \"/runtime.o\"\n      mut jobs.push(\n        toolchain.CJob {\n          source: home + \"/runtime/runtime.c\",\n          out: runtime_made,\n          flags,\n        },\n      )\n    }\n  }\n  // a package's own C and C++, each file on its own (archives and objects\n  // linked as they are)\n  mut made := []\n  mut native_made := []\n  match native {\n    Some(n) => {\n      for s in n.sources {\n        if [\".c\", \".cpp\", \".cc\", \".m\"].any(x -> ends_with(s, x)) {\n          flags := [\"-O2\"] + n.includes\n          key := toolchain.files_key(\n            join([\"native\", cc] + flags, \" \"),\n            [s],\n          )\n          o := kept + \"/native-\" + key + \".o\"\n          if !disk.exists(o) {\n            mut jobs.push(\n              toolchain.CJob {\n                source: s,\n                out: scratch + \"/native-\" + key + \".o\",\n                flags,\n              },\n            )\n            mut native_made.push(key)\n          }\n          mut made.push(o)\n        } else {\n          mut made.push(s)\n        }\n      }\n    },\n    None => (),\n  }\n  // the program's objects and core.rt's, while the C compiler runs (its\n  // phase in `--timings` is the time waited for it after)\n  both := if len(jobs) == 0 {\n    (\n      program_objects(mut disk, sh, ir, scratch, kept, opt, release),\n      Ok(()),\n    )\n  } else {\n    scope {\n      c := spawn toolchain.c_objects(launcher, cc, jobs)\n      p := program_objects(mut disk, sh, ir, scratch, kept, opt, release)\n      timings.begin(\"C compiler: compile\")\n      r := await c\n      timings.end(\"C compiler: compile\")\n      (p, r)\n    }\n  }\n  objects_rt := match both.0 {\n    Ok(o) => o,\n    Err(e) => return Err(e),\n  }\n  match both.1 {\n    Ok(_) => (),\n    Err(e) => return Err(e),\n  }\n  if len(jobs) > 0 {\n    cache.make_dirs(mut disk, kept)\n  }\n  if runtime_made != \"\" {\n    match mut disk.rename(runtime_made, runtime) {\n      Ok(_) => (),\n      Err(_) => {\n        runtime = runtime_made\n      },\n    }\n  }\n  for key in native_made {\n    o := kept + \"/native-\" + key + \".o\"\n    match mut disk.rename(scratch + \"/native-\" + key + \".o\", o) {\n      Ok(_) => (),\n      Err(_) => return Err(\"can't keep \" + o),\n    }\n  }\n  // the hash of the sources it is built from, as an object of its own (a\n  // global in the program's IR would keep it from being cut into parts)\n  sources := match sources_object(disk, home, path, kept) {\n    Ok(o) => o,\n    Err(e) => return Err(e),\n  }\n  objects := objects_rt\n    + [runtime, sources]\n    + match lib {\n      Some(l) => [l.object],\n      None => [],\n    }\n  // std's C libraries (std.sqlite's libsqlite3: the system's, through a stub\n  // beside libSystem's for lld), named to every link but kept only by the\n  // executables that call them (`-dead_strip_dylibs`)\n  std_links := std_native_libs(disk).map(l -> \"-l\" + l)\n  // (a library exports only what its `derive`s export, and the runtime's\n  // `strata_string_free` for the strings they return. The program's other\n  // functions, std's and the runtime's are hidden, so two Strata libraries\n  // can be loaded in one process.)\n  mut exported := []\n  if library {\n    for s in library_exports(ir) + [\"strata_string_free\"] {\n      mut exported.push(\"_\" + s)\n    }\n  }\n  mut export_flags := []\n  for s in exported {\n    export_flags += [\"-exported_symbol\", s]\n  }\n  done := match native {\n    None => if library {\n      toolchain.shared_library(\n        objects + std_links + export_flags,\n        out,\n        system_dir(disk, home),\n        \"@rpath/\" + path_base(out),\n      )\n    } else {\n      toolchain.link(\n        objects + std_links + [\"-dead_strip_dylibs\"],\n        out,\n        system_dir(disk, home),\n      )\n    },\n    Some(n) => if library {\n      toolchain.c_shared_library(\n        mut launcher,\n        cc,\n        objects + made,\n        out,\n        n.links\n          + std_links\n          + [\"-install_name\", \"@rpath/\" + path_base(out)]\n          + exported.map(s -> \"-Wl,-exported_symbol,\" + s),\n      )\n    } else {\n      libs := n.links.filter(x -> x != \"-lm\")\n        + std_links\n        + [\"-Wl,-dead_strip_dylibs\"]\n      exe_key := toolchain.link_key([cc] + objects + made + libs)\n      exe := kept + \"/exe-\" + cache.content_key([out])\n      had := match disk.read(exe + \".key\") {\n        Ok(k) => k,\n        Err(_) => \"\",\n      }\n      if cache.caching() && had == exe_key && toolchain.clone(exe, out) {\n        Ok(())\n      } else {\n        r := toolchain.c_link(\n          mut launcher,\n          cc,\n          objects + made,\n          out,\n          libs,\n        )\n        if r is Ok && cache.caching() {\n          // (its key last: a key never names another executable)\n          match mut disk.remove(exe + \".key\") {\n            _ => (),\n          }\n          if toolchain.clone(out, exe) {\n            match mut disk.write(exe + \".key\", exe_key) {\n              _ => (),\n            }\n          }\n        }\n        r\n      }\n    },\n  }\n  match done {\n    Ok(_) => {\n      if library {\n        return match library_files(\n          mut disk,\n          ir,\n          out,\n          program_name_of(disk, path),\n        ) {\n          Ok(made) => Ok(f\"built {shown} and \"\n            + join(made, \", \")\n            + \" (compiler/codegen)\"),\n          Err(e) => Err(e),\n        }\n      }\n      // a compiler (it links c/cache.c, which reads `<executable>.identity`):\n      // its identity file beside it, as tools/bootstrap.sh writes one, so its\n      // runs don't each hash it\n      match native {\n        Some(n) => if n.sources.any(f -> ends_with(f, \"/c/cache.c\")) {\n          match cache.write_identity(out) {\n            _ => (),\n          }\n        },\n        None => (),\n      }\n      Ok(f\"built {shown} (compiler/codegen)\")\n    },\n    Err(e) => Err(e),\n  }\n}","old_text":"/// Makes the program's IR `ir` an executable. Returns what `build` says, or\n/// why it failed.\n/// - The program's objects are compiled in this process by\n/// compiler/toolchain, in parts and in parallel, each part's object cached\n/// in the cache's `objects` folder.\n/// - The runtime is a release's `runtime-lto.o` (the C runtime and core.rt\n/// optimized together, made once by tools/release.sh), else core.rt's\n/// object (by compiler/codegen, cached by its IR: `core_rt_object`) and the\n/// C runtime's (compiled by the C compiler, cached).\n/// - These are linked by lld against libSystem's stub, with the hash of the\n/// sources (`sources_object`) and std's precompiled object.\n/// - A package with C of its own (`[native]`) is linked by the C compiler\n/// instead. Each C file is compiled once and its object cached under the\n/// file's bytes and the flags (a header