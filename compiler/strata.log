rify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.generated","codegen.can_generate","codegen.to_c","codegen.dyn_ctor_is","codegen.gen_data","codegen.mock_value","codegen.equal","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.generated_args","codegen.makers","codegen.foreign_call","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","codegen.read_back","eval_files"],"module":"codegen","text":"/// A function or built-in `name` used as a value: `(a, b) -> name(a, b)`,\n/// with parameter types from `want`, else the function's own.\nfn function_value(\n  mut g: codegen.Gen,\n  name: String,\n  want: check.Ty,\n) -> codegen.V {\n  n := match want {\n    check.TFn { params, .. } => len(params),\n    _ => match codegen.fn_of(g, codegen.fn_key(g, name)) {\n      Some(f) => len(f.params),\n      None => {\n        codegen.not_yet(\n          mut g,\n          \"`\" + name + \"` as a value, its type not known here\",\n        )\n        return codegen.never()\n      },\n    },\n  }\n  mut ps := []\n  for k in 0..n {\n    mut ps.push(f\"$p{k}\")\n  }\n  let w: check.Ty = match want {\n    check.TFn { .. } => want,\n    _ => match codegen.fn_of(g, codegen.fn_key(g, name)) {\n      Some(f) => if len(f.type_params) == 0 {\n        (ts, r) := codegen.scheme(mut g, f)\n        check.TFn { params: ts, ret: r }\n      } else {\n        want\n      },\n      None => want,\n    },\n  }\n  body := ast.Call { callee: ast.Var(name), args: ps.map(p -> ast.Var(p)) }\n  // shown as `<fn name>`\n  codegen.lambda_shown(\n    mut g,\n    ps.map(p -> ast.LamParam { name: p, ty: None }),\n    body,\n    w,\n    \"<fn \" + codegen.short(name) + \">\",\n  )\n}","old_text":"/// A function or built-in `name` used as a value: `(a, b) -> name(a, b)`,\n/// with parameter types from `want`, else the function's own.\nfn function_value(mut g: codegen.Gen, name: String, want: Ty) -> codegen.V {\n  n := match want {\n    TFn { params, .. } => len(params),\n    _ => match codegen.fn_of(g, codegen.fn_key(g, name)) {\n      Some(f) => len(f.params),\n      None => {\n        codegen.not_yet(\n          mut g,\n          \"`\" + name + \"` as a value, its type not known here\",\n        )\n        return codegen.never()\n      },\n    },\n  }\n  mut ps := []\n  for k in 0..n {\n    mut ps.push(f\"$p{k}\")\n  }\n  let w: Ty = match want {\n    TFn { .. } => want,\n    _ => match codegen.fn_of(g, codegen.fn_key(g, name)) {\n      Some(f) => if len(f.type_params) == 0 {\n        (ts, r) := codegen.scheme(mut g, f)\n        TFn { params: ts, ret: r }\n      } else {\n        want\n      },\n      None => want,\n    },\n  }\n  body := ast.Call { callee: ast.Var(name), args: ps.map(p -> ast.Var(p)) }\n  // shown as `<fn name>`\n  codegen.lambda_shown(\n    mut g,\n    ps.map(p -> ast.LamParam { name: p, ty: None }),\n    body,\n    w,\n    \"<fn \" + codegen.short(name) + \">\",\n  )\n}"},{"name":"codegen.lambda","kind":"fn","old":"067c50284f27e503","new":"7714bd7cc6b7e4f6","interface_changed":true,"affected":["codegen.spawn_expr","codegen.produce","codegen.method_value","codegen.expr_node","codegen.expr_want_node","codegen.race_expr","codegen.gen_fn","codegen.expr","codegen.expr_want","codegen.generated","codegen.can_generate","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codeg