wn_expr","codegen.method_value","codegen.foreign_call","codegen.generated","codegen.can_generate","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.hash_fields","codegen.generated_args","codegen.makers","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// Whether a constructor of type `t` in result position goes in a\n/// `result_block`: the function gives its result as words, of `t`'s type.\nfn in_result(g: codegen.Gen, rp: Bool, t: check.Ty) -> Bool {\n  rp && g.by_words && codegen.head_of(t) == codegen.head_of(g.ret)\n}","old_text":"/// Whether a constructor of type `t` in result position goes in a\n/// `result_block`: the function gives its result as words, of `t`'s type.\nfn in_result(g: codegen.Gen, rp: Bool, t: Ty) -> Bool {\n  rp && g.by_words && codegen.head_of(t) == codegen.head_of(g.ret)\n}"},{"name":"codegen.result_own","kind":"fn","old":"ab85ad7ccedefe7b","new":"8eea6e5484b5e3b8","interface_changed":false,"affected":[],"module":"codegen","text":"/// A branch's value `v` (owned) in result position, where the branches\n/// join (`if`, `match`): its pointer, for the join's (`result_joined`).\nfn result_own(mut g: codegen.Gen, v: codegen.V) -> codegen.V {\n  if v.ty is check.TAny\n    || contains(g.rp_ptrs, v.op)\n    || !codegen.in_result(g, true, v.ty) {\n    return v\n  }\n  mut g.rp_ptrs.insert(v.op, v.op)\n  v\n}","old_text":"/// A branch's value `v` (owned) in result position, where the branches\n/// join (`if`, `match`): its pointer, for the join's (`result_joined`).\nfn result_own(mut g: codegen.Gen, v: codegen.V) -> codegen.V {\n  if v.ty is TAny\n    || contains(g.rp_ptrs, v.op)\n    || !codegen.in_result(g, true, v.ty) {\n    return v\n  }\n  mut g.rp_ptrs.insert(v.op, v.op)\n  v\n}"},{"name":"codegen.result_joined","kind":"fn","old":"087790b961a6c7f3","new":"e754e4a1725c6d7f","interface_changed":false,"affected":[],"module":"codegen","text":"/// The value `r` joining branches (`incoming`) in result position: its\n/// pointer joins theirs (`result_own`), null where every branch made its\n/// value on the stack.\nfn result_joined(\n  mut g: codegen.Gen,\n  rp: Bool,\n  r: codegen.V,\n  incoming: List[(codegen.V, String)],\n) -> codegen.V {\n  if !codegen.in_result(g, rp, r.ty)\n    || codegen.constant(r.op)\n    || r.ty is check.TAny {\n    return r\n  }\n  ptrs := incoming.map(\n    x -> (if x.0.ty is check.TAny || x.0.op == \"\" {\n      \"null\"\n    } else {\n      get(g.rp_ptrs, x.0.op) ?? x.0.op\n    }, x.1),\n  )\n  if ptrs.all(x -> x.0 == \"null\") {\n    mut g.rp_ptrs.insert(r.op, \"null\")\n  } else {\n    p := codegen.fresh(mut g, \"given\")\n    ins := join(ptrs.map(x -> f\"[ {x.0}, %{x.1} ]\"), \", \")\n    codegen.emit(mut g, f\"{p} = phi ptr {ins}\")\n    mut g.rp_ptrs.insert(r.op, p)\n  }\n  r\n}","old_text":"/// The value `r` joining branches (`incoming`) in result position: its\n/// pointer joins theirs (`result_own`), null where every branch made its\n/// value on the stack.\nfn result_joined(\n  mut g: codegen.Gen,\n  rp: Bool,\n  r: codegen.V,\n  incoming: List[(codegen.V, String)],\n) -> codegen.V {\n  if !codegen.in_result(g, rp, r.ty)\n    || codegen.constant(r.op)\n    || r.ty is TAny {\n    return r\n  }\n  ptrs := incoming.map(\n    x -> (if x.0.ty is TAny || x.0.op == \"\" {\n      \"null\"\n    } else {\n      get(g.rp_ptrs, x.0.op) ?? x.0.op\n    }, x.1),\n  )\n  if ptrs.all(x -> x.0 == \"null\") {\n    mut g.rp_ptrs.insert(r.op, \"null\")\n  } else {\n    p := codegen.fresh(mut g, \"given\")\n    ins := join(ptrs.map(x -> f\"[ {x.0}, %{x.1} ]\"), \", \")\n    codegen.emit(mut g, f\"{p} = phi ptr {ins}\")\n    mut g.rp_ptrs.insert(r.op, p)\n  }\n  r\n}"},{"name":"codegen.words_value","kind":"fn","old":"db8bad8f70cd9e31","new":"f7eac8a9490fa237","interface_changed":true,"affected":["codegen.call_at","codegen.call_fn_want","codegen.call","codegen.entry","codegen.show","codegen.shown","codegen.equal","codegen.mock_call","codegen.session_entry","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.function","codegen.int_lit","codegen.concat","codegen.apply","codegen.finite","codegen.fault","codegen.slice_raw","codegen.list_builtin","codegen.debug_list","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.number_builtin","codegen.format_spec","codegen.word_to_int","codegen.list_literal_of","codegen.checked","codegen.check_type","codegen.host","codegen.channel_op","codegen.trace_enter","codegen.trace_leave","codegen.mem_builtin","codegen.table_from","codegen.set_copy","codegen.checked_update","codegen.appended","codegen.expr_node","codegen.decreases_fault","codegen.build_fn","codegen.push_in_place","codegen.generate","codegen.interp","codegen.dyn_wrapper","codegen.union_text","codegen.destructure","codegen.debug_fields","codegen.for_loop","codegen.fail_unless","codegen.check_requires","codegen.check_ensures","codegen.fuzz_driver","codegen.matching_v","codegen.index_check","codegen.eq_fields","codegen.matches","