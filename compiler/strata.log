en.Gen, t: check.Ty) -> Bool {\n  match t {\n    check.TNamed { name, args } => contains(g.refines, name)\n      || args.any(a -> codegen.has_refined(g, a)),\n    check.TList(a) => codegen.has_refined(g, a),\n    _ => false,\n  }\n}","old_text":"/// Whether a written type holds a refined name.\nfn has_refined(g: codegen.Gen, t: Ty) -> Bool {\n  match t {\n    TNamed { name, args } => contains(g.refines, name)\n      || args.any(a -> codegen.has_refined(g, a)),\n    TList(a) => codegen.has_refined(g, a),\n    _ => false,\n  }\n}"},{"name":"codegen.written_args","kind":"fn","old":"5a41fc461ae52ec2","new":"59ab3198600096e2","interface_changed":true,"affected":["codegen.call_fn_want","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.expr_node","codegen.expr_want_node","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.builtin_call","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.main_arg","codegen.select_expr","codegen.expr","codegen.expr_want","codegen.entry","codegen.interp","codegen.format_spec","codegen.union_text","codegen.destructure","codegen.debug_fields","codegen.for_loop","codegen.debug_list","codegen.checked","codegen.fail_unless","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.fuzz_driver","codegen.trace_enter","codegen.trace_leave","codegen.matching_v","codegen.index_check","codegen.checked_update","codegen.decreases_fault","codegen.push_in_place","codegen.gen_list","codegen.converted","codegen.update_in_place","codegen.except_expr","codegen.matching_want","codegen.vtable","codegen.dyn_call","codegen.binary","codegen.logic","codegen.loop_body","codegen.matches","codegen.with_it","codegen.for_list","codegen.await_expr","codegen.race_expr","codegen.mock_method","codegen.call_entry","codegen.construct_w