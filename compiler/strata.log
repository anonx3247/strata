text":"/// A union's members with complete sets of a sum's variants replaced by the\n/// sum (`Circle | Square | Dot` is `Circle | Shape$own`): the union's own\n/// members, with their `impl`s.\nfn whole_sums(g: codegen.Gen, ts: List[check.Ty]) -> List[check.Ty] {\n  mut by_owner := Dict[String, List[String]] {}\n  for t in ts {\n    match t {\n      check.TNamed { name, .. } => {\n        o := (get(g.types.ctors, name) ?? codegen.no_shape()).owner\n        if o != \"\" && o != name && contains(g.types.sums, o) {\n          mut by_owner.insert(o, (get(by_owner, o) ?? []) + [name])\n        }\n      },\n      _ => (),\n    }\n  }\n  mut whole := Set[String] {}\n  for o in keys(by_owner) {\n    have := get(by_owner, o) ?? []\n    all := codegen.ctors_of(g, check.TNamed { name: o, args: [] })\n    if all.all(c -> have.any(h -> h == c)) {\n      mut whole.insert(o)\n    }\n  }\n  if len(whole) == 0 {\n    return ts\n  }\n  mut out := []\n  mut added := Set[String] {}\n  for t in ts {\n    match t {\n      check.TNamed { name, args } => {\n        o := (get(g.types.ctors, name) ?? codegen.no_shape()).owner\n        if contains(whole, o) && o != name {\n          if !contains(added, o) {\n            mut added.insert(o)\n            mut out.push(check.TNamed { name: o, args })\n          }\n        } else {\n          mut out.push(t)\n        }\n      },\n      _ => mut out.push(t),\n    }\n  }\n  out\n}","old_text":"/// A union's members with complete sets of a sum's variants replaced by the\n/// sum (`Circle | Square | Dot` is `Circle | Shape$own`): the union's own\n/// members, with their `impl`s.\nfn whole_sums(g: codegen.Gen, ts: List[Ty]) -> List[Ty] {\n  mut by_owner := Dict[String, List[String]] {}\n  for t in ts {\n    match t {\n      TNamed { name, .. } => {\n        o := (get(g.types.ctors, name) ?? codegen.no_shape()).owner\n        if o != \"\" && o != name && contains(g.types.sums, o) {\n          mut by_owner.insert(o, (get(by_owner, o) ?? []) + [name])\n        }\n      },\n      _ => (),\n    }\n  }\n  mut whole := Set[String] {}\n  for o in keys(by_owner) {\n    have := get(by_owner, o) ?? []\n    all := codegen.ctors_of(g, TNamed { name: o, args: [] })\n    if all.all(c -> have.any(h -> h == c)) {\n      mut whole.insert(o)\n    }\n  }\n  if len(whole) == 0 {\n    return ts\n  }\n  mut out := []\n  mut added := Set[String] {}\n  for t in ts {\n    match t {\n      TNamed { name, args } => {\n        o := (get(g.types.ctors, name) ?? codegen.no_shape()).owner\n        if contains(whole, o) && o != name {\n          if !contains(added, o) {\n            mut added.insert(o)\n            mut out.push(TNamed { name: o, args })\n          }\n        } else {\n          mut out.push(t)\n        }\n      },\n      _ => mut out.push(t),\n    }\n  }\n  out\n}"},{"name":"codegen.method_value","kind":"fn","old":"aa5ce715e068b1bb","new":"670505d801ebcf12","interface_changed":true,"affected":["codegen.expr_want_node","codegen.expr_want","codegen.function","codegen.binary","codegen.declare","codegen.destructure","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.method_call","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.try_want","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.expr_node","codegen.compared","codegen.stmt_node","codegen.build_fn","codegen.push_in_place","codegen.compiled_alone","codegen.call_named","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.except_expr","codegen.matching_want","codegen.list_literal","codegen.generate","codegen.construct","codegen.operands","codegen.branch_value","codegen.mock_call","codegen.try_expr","codegen.function_value","codegen.lambda"