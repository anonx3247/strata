and","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// Copies each counted field of block `b` (types `tys`) out of arena `%d`,\n/// in place.\nfn copy_fields(mut g: codegen.Gen, b: codegen.V, tys: List[check.Ty]) {\n  for (k, t) in enumerate(tys) {\n    if codegen.counted(t) {\n      x := codegen.field(mut g, b, k, t)\n      y := codegen.copy_out(mut g, x, \"%d\")\n      s := codegen.to_slot(mut g, y)\n      at := codegen.fresh(mut g, \"at\")\n      codegen.emit(\n        mut g,\n        f\"{at} = getelementptr i64, ptr {b.op}, i64 {k + 1}\",\n      )\n      codegen.emit(mut g, f\"store i64 {s}, ptr {at}\")\n    }\n  }\n}","old_text":"/// Copies each counted field of block `b` (types `tys`) out of arena `%d`,\n/// in place.\nfn copy_fields(mut g: codegen.Gen, b: codegen.V, tys: List[Ty]) {\n  for (k, t) in enumerate(tys) {\n    if codegen.counted(t) {\n      x := codegen.field(mut g, b, k, t)\n      y := codegen.copy_out(mut g, x, \"%d\")\n      s := codegen.to_slot(mut g, y)\n      at := codegen.fresh(mut g, \"at\")\n      codegen.emit(\n        mut g,\n        f\"{at} = getelementptr i64, ptr {b.op}, i64 {k + 1}\",\n      )\n      codegen.emit(mut g, f\"store i64 {s}, ptr {at}\")\n    }\n  }\n}"},{"name":"codegen.or_else","kind":"fn","old":"a3f8e849c1a24d48","new":"a1ac31d654badcdc","interface_changed":false,"affected":[],"module":"codegen","text":"/// `except_expr` of the `Result` or `Option` `v`.\nfn or_else(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  err: Option[String],\n  fallback: ast.Expr,\n) -> codegen.V {\n  want := codegen.inner_of(v.ty)\n  good := match v.ty {\n    check.TNamed { name: \"Option\", .. } => \"Some\",\n    _ => \"Ok\",\n  }\n  is_good := codegen.tag_is(mut g, v, good)\n  (ok, fail, end) := (\n    codegen.label(mut g, \"except.ok\"),\n    codegen.label(mut g, \"except.else\"),\n    codegen.label(mut g, \"except.end\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"br i1 {is_good.op}, label %{ok}, label %{fail}\",\n  )\n  codegen.block(mut g, ok)\n  codegen.push_transparent(mut g)\n  x := codegen.field(mut g, v, 0, want)\n  gv := codegen.leave_branch(mut g, x)\n  from_ok := codegen.current(g)\n  codegen.br(mut g, end)\n  codegen.block(mut g, fail)\n  codegen.push_scope(mut g)\n  match err {\n    Some(n) => {\n      et := match v.ty {\n        check.TNamed { name: \"Result\", args: [_, e] } => e,\n        _ => check.TUnit,\n      }\n      e := codegen.field(mut g, v, 0, et)\n      codegen.local_owned(mut g, n, e)\n    },\n    None => (),\n  }\n  f0 := codegen.expr_want(mut g, fallback, want)\n  fv := codegen.leave_branch(mut g, f0)\n  from_f := codegen.current(g)\n  codegen.br(mut g, end)\n  codegen.block(mut g, end)\n  r := codegen.join_values(mut g, [(gv, from_ok), (fv, from_f)])\n  codegen.temp(mut g, r)\n}","old_text":"/// `except_expr` of the `Result` or `Option` `v`.\nfn or_else(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  err: Option[String],\n  fallback: ast.Expr,\n) -> codegen.V {\n  want := codegen.inner_of(v.ty)\n  good := match v.ty {\n    TNamed { name: \"Option\", .. } => \"Some\",\n    _ => \"Ok\",\n  }\n  is_good := codegen.tag_is(mut g, v, good)\n  (ok, fail, end) := (\n    codegen.label(mut g, \"except.ok\"),\n    codegen.label(mut g, \"except.else\"),\n    codegen.label(mut g, \"except.end\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"br i1 {is_good.op}, label %{ok}, label %{fail}\",\n  )\n  codegen.block(mut g, ok)\n  codegen.push_transparent(mut g)\n  x := codegen.field(mut g, v, 0, want)\n  gv := codegen.leave_branch(mut g, x)\n  from_ok := codegen.current(g)\n  codegen.br(mut g, end)\n  codegen.block(mut g, fail)\n  codegen.push_scope(mut g)\n  match err {\n    Some(n) => {\n      et := match v.ty {\n        TNamed { name: \"Result\", args: [_, e] } => e,\n        _ => TUnit,\n      }\n      e := codegen.field(mut g, v, 0, et)\n      codegen.local_owned(mut g, n, e)\n    },\n    None => (),\n  }\n  f0 := codegen.expr_want(mut g, fallback, want)\n  fv := codegen.leave_branch(mut g, f0)\n  from_f := codegen.current(g)\n  codegen.br(mut g, end)\n  codegen.block(mut g, end)\n  r := codegen.join_values(mut g, [(gv, from_ok), (fv, from_f)])\n  codegen.temp(mut g, r)\n}"},{"name":"codegen.list_get_or","kind":"fn","old":"3028e82dc8324333","new":"069864125a85a2f0","interface_changed":true,"affected":["codegen.except_expr","codegen.expr_node","codegen.expr","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.method_call","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.try_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.expr_want_node","codegen.compared","codegen.stmt_node","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.binds","codegen.matching_v","codegen.match_got","codegen.assertion","codegen.invariants","codegen.tag_is","codegen.check_type","codegen.satisfies","codegen.holds_pred","codegen.function","codegen.entry","codegen.vtable","codegen.mock_table","codegen.mock_call","codegen.list_builtin","codegen.collection_builtin","codegen.list_literal_of","codegen.produce","codegen.wanted","codegen.table_find","codegen.generate","codegen.construct","codegen.operands","codegen.if_expr","codegen.matching","codegen.try_expr","codegen.builtin_call","codegen.expr_want","codegen.stmt","codegen.call_fn_want","codegen.built_or_generated","codegen.get_field","codegen.options","codegen.to_c","c