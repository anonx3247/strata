comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"/// A type's kind (`\"Record\"`, `\"Union\"`, ..), seeing through aliases and\n/// ignoring refinements, and whether it is a sum of atoms (a `Choice`).\nfn kind_of(x: derive.Expander, t: ast.TypeExpr) -> (String, Bool) {\n  match t {\n    ast.Refined { base, .. } => derive.kind_of(x, base),\n    ast.UnitType => (\"Unit\", false),\n    ast.FnType { .. } => (\"Function\", false),\n    ast.UnionType(ms) => (\"Union\", ms.all(\n      m -> match m {\n        ast.Named { name, .. } => if contains(name, desugar.own_suffix()) {\n          derive.kind_of(x, m).1\n        } else {\n          derive.kind_of(x, m).0 == \"Atom\"\n        },\n        _ => derive.kind_of(x, m).0 == \"Atom\",\n      },\n    )),\n    ast.Named { name: \"Tuple\", .. } => (\"Tuple\", false),\n    ast.Named { name, .. } => match get(x.ix.types, name) {\n      Some(td) => match td.body {\n        ast.RecordBody(_) => (\"Record\", false),\n        ast.SumBody(vs) => (\"Union\", vs.all(\n          v -> match v.payload {\n            ast.NoPayload => true,\n            ast.MemberType(m) => derive.kind_of(x, m).0 == \"Atom\",\n            _ => false,\n          },\n        )),\n        ast.Alias(a) => derive.kind_of(x, a),\n      },\n      None => match derive.variant_decl(x, name) {\n        Some(v) => match v.payload {\n          ast.Positional(_) => (\"Tuple\", false),\n          ast.RecordPayload(_) => (\"Record\", false),\n          _ => (\"Atom\", false),\n        },\n        None => if contains(derive.builtin_types(), name) {\n          (\"Builtin\", false)\n        } else {\n          (\"Param\", false)\n        },\n      },\n    },\n  }\n}","old_text":"/// A type's kind (`\"Record\"`, `\"Union\"`, ..), seeing through aliases and\n/// ignoring refinements, and whether it is a sum of atoms (a `Choice`).\nfn kind_of(x: derive.X, t: ast.TypeExpr) -> (String, Bool) {\n  match t {\n    ast.Refined { base, .. } => derive.kind_of(x, base),\n    ast.UnitType => (\"Unit\", false),\n    ast.FnType { .. } => (\"Function\", false),\n    ast.UnionType(ms) => (\"Union\", ms.all(\n      m -> match m {\n        ast.Named { name, .. } => if contains(name, desugar.own_suffix()) {\n          derive.kind_of(x, m).1\n        } else {\n          derive.kind_of(x, m).0 == \"Atom\"\n        },\n        _ => derive.kind_of(x, m).0 == \"Atom\",\n      },\n    )),\n    ast.Named { name: \"Tuple\", .. } => (\"Tuple\", false),\n    ast.Named { name, .. } => match get(x.ix.types, name) {\n      Some(td) => match td.body {\n        ast.RecordBody(_) => (\"Record\", false),\n        ast.SumBody(vs) => (\"Union\", vs.all(\n          v -> match v.payload {\n            ast.NoPayload => true,\n            ast.MemberType(m) => derive.kind_of(x, m).0 == \"Atom\",\n            _ => false,\n          },\n        )),\n        ast.Alias(a) => derive.kind_of(x, a),\n      },\n      None => match derive.variant_decl(x, name) {\n        Some(v) => match v.payload {\n          ast.Positional(_) => (\"Tuple\", false),\n          ast.RecordPayload(_) => (\"Record\", false),\n          _ => (\"Atom\", false),\n        },\n        None => if contains(derive.builtin_types(), name) {\n          (\"Builtin\", false)\n        } else {\n          (\"Param\", false)\n        },\n      },\n    },\n  }\n}"},{"name":"derive.distinct_head","kind":"fn","old":"a9f07f315c3f08de","new":"5fb95e6244c81de2","interface_changed":true,"affected":["derive.expr","derive.derive","derive.children","derive.field_read","derive.type_method","derive.with_known","derive.block","derive.comprehension","derive.call_copy","derive.derive_fn","derive.derive_all","derive.make","derive.match_type","derive.call_fn","derive.derived_in","derive.expand_with","derive.expand_in","std_reached","expanded","check_errors_in","derive.expand","holes_command","check_summary","verified_decls","verify_file","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","e