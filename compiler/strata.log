"move_command"],"module":"kernel","text":"/// `A ⊢ p` gives `A ⊢ ∀x. p`, `x` not free in `A`.\npub fn for_all_from_arbitrary(\n  x: kernel.Term,\n  th: kernel.Theorem,\n) -> Result[kernel.Theorem, String] {\n  match x {\n    kernel.Variable { name, value_type: ty } => if kernel.assumptions(th).any(h -> kernel.occurs_free(name, ty, h)) {\n      Err(\"gen: `\" + name + \"` is free in a hypothesis\")\n    } else {\n      Ok(kernel.make_theorem(\n        kernel.assumptions(th),\n        kernel.binder(\"forall\", name, ty, kernel.conclusion(th)),\n        kernel.depends_on(th),\n        kernel.Step { rule: \"gen\", premises: [th], terms: [x] },\n      ))\n    },\n    _ => Err(\"gen: not a variable\"),\n  }\n}","old_text":"/// `A ⊢ p` gives `A ⊢ ∀x. p`, `x` not free in `A`.\npub fn for_all_from_arbitrary(\n  x: kernel.Term,\n  th: kernel.Theorem,\n) -> Result[kernel.Theorem, String] {\n  match x {\n    kernel.Variable { name, value_type: ty } => if kernel.assumptions(th).any(h -> kernel.occurs_free(name, ty, h)) {\n      Err(\"gen: `\" + name + \"` is free in a hypothesis\")\n    } else {\n      Ok(kernel.make_theorem(\n        kernel.assumptions(th),\n        kernel.binder(\"forall\", name, ty, kernel.conclusion(th)),\n        kernel.depends_on(th),\n      ))\n    },\n    _ => Err(\"gen: not a variable\"),\n  }\n}"},{"name":"kernel.for_all_to_one","kind":"fn","old":"afe851b6e2b29e23","new":"4230f43427595302","interface_changed":false,"affected":["kernel_logic.for_all_to_fresh_variables","kernel_logic.for_all_to_each","kernel_tactics.induct","kernel_tactics.cases_on_term","kernel_tactics.spec_term","kernel_translate.for_each_value","kernel_logic.rewrites_fixing","kernel_tactics.rule_theorems","kernel_tactics.discharged","kernel_tactics.finish_with","kernel_tactics.apply_law","kernel_tactics.refinement_facts","kernel_tactics.forward_facts","kernel_translate.flipped_distinct","kernel_arith.lemma","kernel_cli.mutual","kernel_tactics.induction","kernel_tactics.apply_tactic","