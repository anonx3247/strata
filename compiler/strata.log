f, x, y)\n      codegen.each_next(mut g, at)\n      na := codegen.list_len(mut g, a)\n      nb2 := codegen.list_len(mut g, b)\n      codegen.three(\n        mut g,\n        f\"icmp slt i64 {na.op}, {nb2.op}\",\n        f\"icmp sgt i64 {na.op}, {nb2.op}\",\n      )\n    },\n    TNamed { .. } => {\n      // by variant (tags follow declaration order), then fields\n      cs := codegen.ctors_of(g, t)\n      if len(cs) > 1 {\n        (ta, tb) := (codegen.tag_of(mut g, a), codegen.tag_of(mut g, b))\n        (lt, gt) := (codegen.fresh(mut g, \"l\"), codegen.fresh(mut g, \"g\"))\n        codegen.emit(mut g, f\"{lt} = icmp slt i64 {ta}, {tb}\")\n        codegen.emit(mut g, f\"{gt} = icmp sgt i64 {ta}, {tb}\")\n        (lx, gx, d) := (\n          codegen.fresh(mut g, \"lx\"),\n          codegen.fresh(mut g, \"gx\"),\n          codegen.fresh(mut g, \"d\"),\n        )\n        codegen.emit(mut g, f\"{lx} = zext i1 {lt} to i64\")\n        codegen.emit(mut g, f\"{gx} = zext i1 {gt} to i64\")\n        codegen.emit(mut g, f\"{d} = sub i64 {gx}, {lx}\")\n        z := codegen.fresh(mut g, \"z\")\n        codegen.emit(mut g, f\"{z} = icmp eq i64 {d}, 0\")\n        codegen.emit(\n          mut g,\n          f\"br i1 {z}, label %fields, label %differ\",\n        )\n        codegen.block(mut g, \"differ\")\n        codegen.emit(mut g, f\"ret i64 {d}\")\n        codegen.block(mut g, \"fields\")\n        labels := codegen.on_ctor(mut g, a, cs)\n        for (k, c) in enumerate(cs) {\n          codegen.block(mut g, get(labels, k) ?? \"\")\n          codegen.cmp_fields(\n            mut g,\n            a,\n            b,\n            codegen.fields_of(g, c, t).map(f -> f.1),\n          )\n          codegen.emit(mut g, \"ret i64 0\")\n        }\n      } else {\n        codegen.cmp_fields(\n          mut g,\n          a,\n          b,\n          codegen.fields_of(g, get(cs, 0) ?? \"\", t).map(f -> f.1),\n        )\n        codegen.emit(mut g, \"ret i64 0\")\n      }\n    },\n    TUnion(ms) => co