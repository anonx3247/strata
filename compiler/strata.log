kernel.Application { function: g, argument: y },\n    )!, kernel.joined_dependencies(\n      kernel.depends_on(fg),\n      kernel.depends_on(xy),\n    )!, kernel.Step { rule: \"cong\", premises: [fg, xy] })),\n    _ => Err(\"mk_comb: not equations\"),\n  }\n}","old_text":"/// `A ⊢ f = g` and `B ⊢ x = y` give `A ∪ B ⊢ f x = g y`.\npub fn apply_equal_to_equal(\n  fg: kernel.Theorem,\n  xy: kernel.Theorem,\n) -> Result[kernel.Theorem, String] {\n  match (\n    kernel.split_equation(kernel.conclusion(fg)),\n    kernel.split_equation(kernel.conclusion(xy)),\n  ) {\n    (Some((f, g)), Some((x, y))) => Ok(kernel.make_theorem(kernel.union_of_terms(\n      kernel.assumptions(fg),\n      kernel.assumptions(xy),\n    ), kernel.equation(\n      kernel.Application { function: f, argument: x },\n      kernel.Application { function: g, argument: y },\n    )!, kernel.joined_dependencies(\n      kernel.depends_on(fg),\n      kernel.depends_on(xy),\n    )!)),\n    _ => Err(\"mk_comb: not equations\"),\n  }\n}"},{"name":"kernel.equal_under_lambda","kind":"fn","old":"ecbb1ab3d4b80549","new":"4ff107af237ce1f0","interface_changed":false,"affected":["kernel_logic.normal_form","kernel_tactics.rewrite_all","kernel_tactics.extensionality","kernel_arith.prettify","kernel_logic.rewrite_at_top","kernel_logic.lambdas_applied","kernel_tactics.simp_with","kernel_tactics.split_close","kernel_tactics.linear_arithmetic","kernel_tactics.assumption_facts","kernel_tactics.same_simplified","kernel_tactics.split_on_named","kernel_translate.equation","kernel_translate.for_each_value","kernel_tactics.rewrite","kernel_tactics.apply_tactic","kernel_arith.simp_step","kernel_logic.same_up_to_lambdas","kernel_tactics.beta_of","kernel_tactics.equal_sides","kernel_tactics.simplify","kernel_tactics.auto","kernel_tactics.apply_tac_simple","kernel_tactics.spec_term","kernel_tactics.finish_with","kernel_tactics.split_on","kernel_translate.add_field","kernel_translate.plain_definition","kernel_translate.primrec_group",