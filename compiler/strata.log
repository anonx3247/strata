{"id":"52afca44b1896d90","time":1795635050,"message":"rename lint.old_forms → lint.functional_forms","changes":[{"name":"lint.collection_forms","kind":"fn","old":"1a227912651478d9","new":"a4db1fa0f8aa2163","interface_changed":false,"affected":[],"module":"lint","text":"/// Lists, dicts and sets change through `mut` methods, and new ones come\n/// from expressions.\n/// - Changing: `xs = push(xs, x)` is `mut xs.push(x)`,\n/// `d = insert(d, k, v)` is `mut d.insert(k, v)`, `xs = sort(xs)` is\n/// `mut xs.sort()`.\n/// - New values: `xs + [x]` for `push(xs, x)`, `xs.sorted()` for\n/// `sort(xs)`, `xs.sorted_by(f)`, `xs.reversed()` for `reverse(xs)` (of a\n/// string too), and a changed copy for a dict or set with one entry more\n/// or less (`{ mut copy := d; mut copy.insert(k, v); copy }`).\n/// Syntactic: a program function named `push` (`insert`, ...) is rewritten\n/// too, and a method of that name only where its result is assigned back\n/// to its receiver.\nfn collection_forms(d: ast.Decl) -> (List[String], ast.Decl) {\n  changed := walk.decl_parts(\n    d,\n    e -> lint.collections_fixed(e),\n    t -> walk.rewrite_type(t, e -> lint.collections_fixed(e)),\n  )\n  if changed == d {\n    return ([], d)\n  }\n  found := walk.decl_exprs(d)\n    .map(e -> lint.functional_forms(e))\n    .fold([], (a, b) -> a + b)\n  mut names: List[String] = []\n  for n in found {\n    if !names.contains(n) {\n      names += [n]\n    }\n  }\n  shown := names.map(n -> \"`\" + n + \"`\").join(\", \")\n  w := f\"`{lint.shown_name(d)}`: {shown} as functions: a list, dict or set changes by a `mut` method (`mut xs.push(x)`), a new one is an expression (`xs + [x]`, `xs.sorted()`)\"\n  ([w], changed)\n}","old_text":"/// Lists, dicts and sets change through `mut` methods, and new ones come\n/// from expressions.\n/// - Changing: `xs = push(xs, x)` is `mut xs.push(x)`,\n/// `d = insert(d, k, v)` is `mut d.insert(k, v)`, `xs = sort(xs)` is\n/// `mut xs.sort()`.\n/// - New values: `xs + [x]` for `push(xs, x)`, `xs.sorted()` for\n/// `sort(xs)`, `xs.sorted_by(f)`, `xs.reversed()` for `reverse(xs)` (of a\n/// string too), and a changed copy for a dict or set with one entry more\n/// or less (`{ mut copy := d; mut copy.insert(k, v); copy }`).\n/// Syntactic: a program function named `push` (`insert`, ...) is rewritten\n/// too, and a method of that name only where its result is assigned back\n/// to its receiver.\nfn collection_forms(d: ast.Decl) -> (List[String], ast.Decl) {\n  changed := walk.decl_parts(\n    d,\n    e -> lint.collections_fixed(e),\n    t -> walk.rewrite_type(t, e -> lint.collections_fixed(e)),\n  )\n  if changed == d {\n    return ([], d)\n  }\n  found := walk.decl_exprs(d)\n    .map(e -> lint.old_forms(e))\n    .fold([], (a, b) -> a + b)\n  mut names: List[String] = []\n  for n in found {\n    if !names.contains(n) {\n      names += [n]\n    }\n  }\n  shown := names.map(n -> \"`\" + n + \"`\").join(\", \")\n  w := f\"`{lint.shown_name(d)}`: {shown} as functions: a list, dict or set changes by a `mut` method (`mut xs.push(x)`), a new one is an expression (`xs + [x]`, `xs.sorted()`)\"\n  ([w], changed)\n}"},{"name":"lint.functional_forms","kind":"fn","old":null,"new":"d8a44449685fbbb1","interface_changed":true,"affected":[],"module":"lint","text":"/// The functional forms of the collection built-ins in `e` (`push(xs, x)`,\n/// `xs.sort()` not marked `mut`), by name, once per use.\nfn functional_forms(e: ast.Expr) -> List[String] {\n  here := match e {\n    ast.MutExpr(ast.MethodCall { .. }) => [],\n    ast.Call { callee: ast.Var(q), args } => if lint.old_arity(lint.call_name(q), len(args) - 1) {\n      [lint.call_name(q)]\n    } else {\n      []\n    },\n    ast.MethodCall { name, args, .. } => if lint.old_arity(name, len(args)) {\n      [name]\n    } else {\n      []\n    },\n    _ => [],\n  }\n  inner := match e {\n    ast.MutExpr(ast.MethodCall { recv, args, .. }) => [recv] + args,\n    _ => walk.kids(e),\n  }\n  here\n    + inner\n      .map(k -> lint.functional_forms(k))\n      .fold([], (a, b) -> a + b)\n}"},{"name":"lint.old_forms","kind":"fn","old":"9af0a9eaa684f6dc","new":null,"interface_changed":true,"affected":[],"module":"lint","old_text":"/// The functional forms of the collection built-ins in `e` (`push(xs, x)`,\n/// `xs.sort()` not marked `mut`), by name, once per use.\nfn old_forms(e: ast.Expr) -> List[String] {\n  here := match e {\n    ast.MutExpr(ast.MethodCall { .. }) => [],\n    ast.Call { callee: ast.Var(q), args } => if lint.old_arity(lint.call_name(q), len(args) - 1) {\n      [lint.call_name(q)]\n    } else {\n      []\n    },\n    ast.MethodCall { name, args, .. } => if lint.old_arity(name, len(args)) {\n      [name]\n    } else {\n      []\n    },\n    _ => [],\n  }\n  inner := match e {\n    ast.MutExpr(ast.MethodCall { recv, args, .. }) => [recv] + args,\n    _ => walk.kids(e),\n  }\n  here + inner.map(k -> lint.old_forms(k)).fold([], (a, b) -> a + b)\n}"}],"renames":[{"from":"lint.old_forms","to":"lint.functional_forms","kind":"function"}],"references":["lint.collection_forms"]}
