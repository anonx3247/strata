degen.union_call","codegen.host","codegen.dyn_generic_call","codegen_with","core_rt_text","computed_value","repl_eval","codegen.session_capability","codegen.iterate","codegen.decreases_start","codegen.decreases_entry","codegen.to_c","codegen.check_payload","codegen.dyn_ctor_is","codegen.has_field_check","codegen.check_field","codegen.assign_at","codegen.check_union","codegen.check_member","codegen.to_dyn","codegen.dyn_table_is","codegen.mock_value","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.session_entry","codegen.foreign_call","codegen.helper","codegen.debug_body","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.equal","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","codegen.read_back","eval_files"],"module":"codegen","text":"/// `lambda`, shown as `label` (`<fn twice>` for a function used as a\n/// value), or by its parameters when \"\". A lambda of several parameters\n/// where a function of one tuple of as many elements is wanted takes the\n/// tuple apart.\nfn lambda_shown(\n  mut g: codegen.Gen,\n  params: List[ast.LamParam],\n  body: ast.Expr,\n  want: check.Ty,\n  label: String,\n) -> codegen.V {\n  // `(i, x) -> …` where a function of one pair is wanted takes the pair and\n  // binds its elements (the checker's `lambdas_typed` does the same where\n  // it knows the types)\n  match want {\n    check.TFn { params: [check.TNamed { name: \"Tuple\", args }], .. } => if len(params) >= 2\n      && len(args) == len(params)\n      && params.all(p -> p.ty is None) {\n      return codegen.lambda_shown(\n        mut g,\n        [ast.LamParam { name: \"$tuple\", ty: None }],\n        ast.Block { stmts: [ast.Let {\n          pat: ast.TuplePat(params.map(p -> ast.Bind(p.name))),\n          ty: None,\n          value: ast.Var(\"$tuple\"),\n        }], last: body },\n        want,\n        label,\n      )\n    },\n    _ => (),\n  }\n  (wps, wret) := match want {\n    check.TFn { params: ps, ret } => (ps, ret),\n    _ => ([], check.TAny),\n  }\n  mut pts := []\n  for (k, p) in enumerate(params) {\n    t0 := match p.ty {\n      Some(x) => codegen.lower(mut g, x),\n      None => get(wps, k) ?? check.TAny,\n    }\n    // an untyped lambda (`(1, x -> x)`) is never called with a value, so\n    // its parameter holds none\n    t := if t0 is check.TAny && want is check.TAny && p.ty is None {\n      check.TUnit\n    } else {\n      t0\n    }\n    // only the layout matters: `List[_]` is a list\n    if t is check.TAny || t is check.TGen {\n      codegen.not_yet(mut g, \"a lambda whose parameter `\"\n        + p.name\n        + \"` has a type not known here\")\n      return codegen.never()\n    }\n    mut pts.push(t)\n  }\n  // its captures: the variables it reads, except its parameters\n  mut captured := []\n  for x in codegen.names_in(body, Set[String] {}) {\n    if !params.any(p -> p.name == x) {\n      match codegen.lookup(g, x) {\n        Some(l) => mut captured.push((x, codegen.load(mut g, l))),\n        None => (),\n      }\n    }\n  }\n  g.lambdas += 1\n  sym := f\"@\\\"lambda.{g.owner}{g.lambdas}\\\"\"\n  saved := g\n  g.by_words = false\n  g.result_pos = false\n  g.lines = []\n  g.proving = \"\"\n  g.can_unwind = false\n  g.unwinds = false\n  g.unwind_chain = []\n  g.allocas = []\n  g.next = 0\n  g.scopes = []\n  g.loops = []\n  codegen.push_scope(mut g)\n  codegen.block(mut g, \"start\")\n  env := codegen.V { ty: check.TStr, op: \"%env\" }\n  g.can_unwind = true\n  for (k, c) in enumerate(captured) {\n    x := codegen.field(mut g, env, k + 3, c.1.ty)\n    codegen.local_value(mut g, c.0, codegen.V { ..x, ty: c.1.ty })\n  }\n  mut sig := [\"ptr %env\"]\n  for (k, p) in enumerate(params) {\n    t := get(pts, k) ?? check.TAny\n    _ := codegen.local_value(\n      mut g,\n      p.name,\n      codegen.V { ty: t, op: f\"%lp.{k}\" },\n    )\n    if codegen.has_value(t) {\n      mut sig.push(f\"{codegen.ll(t)} %lp.{k}\")\n    }\n  }\n  // a parameter's written refinement (`(n: Positive) -> …`)\n  for p in params {\n    match p.ty {\n      Some(x) => if codegen.needs_check(g, x) {\n        match codegen.lookup(g, p.name) {\n          Some(l) => {\n            pv := codegen.load(mut g, l)\n            codegen.check_type(\n              mut g,\n              x,\n              pv,\n              f\"argument `{p.name}` of a lambda\",\n              [],\n            )\n          },\n          None => (),\n        }\n      },\n      None => (),\n    }\n  }\n  g.ret = codegen.ground(wret)\n  g.rets = []\n  v := codegen.expr_want(mut g, body, g.ret)\n  rt := codegen.better(g.ret, v.ty)\n  if !(v.ty is check.TAny) {\n    codegen.leave_with(mut g, v)\n    codegen.give_result(mut g, codegen.V { ..v, ty: rt })\n  } else {\n    // an unreachable end still jumps to the exit\n    codegen.give_result(mut g, codegen.V { ty: rt, op: \"poison\" })\n  }\n  codegen.br(mut g, \"exit\")\n  codegen.block(mut g, \"exit\")\n  _ := codegen.result_phi(mut g, rt)\n  mut tail := []\n  if codegen.has_value(rt) {\n    tail = [f\"  ret {codegen.ll(rt)} %result\"]\n  } else {\n    tail = [\"  ret void\"]\n  }\n  tail += codegen.unwound_exit(mut g, rt, false)\n  head := f\"define {codegen.ll(rt)} {sym}({join(sig, \", \")}) {{\"\n  def := join([head]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + tail\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, def)\n  t := check.TFn { params: pts, ret: rt }\n  shown := if label != \"\" {\n    label\n  } else {\n    \"<closure (\" + join(params.map(p -> p.name), \", \") + \") -> …>\"\n  }\n  p := codegen.closure(mut g, sym, captured.map(c -> c.1), shown)\n  codegen.temp(mut g, codegen.V { ty: t, op: p })\n}","old_text":"/// `lambda`, shown as `label` (`<fn twice>` for a function used as a\n/// value), or by its parameters when \"\". A lambda of several parameters\n/// where a function of one tuple of as many elements is wanted takes the\n/// tuple apart.\nfn lambda_shown(\n  mut g: codegen.Gen,\n  params: List[ast.LamParam],\n  body: ast.Expr,\n  want: Ty,\n  label: String,\n) -> codegen.V {\n  // `(i, x) -> …` where a function of one pair is wanted takes the pair and\n  // binds its elements (the checker's `lambdas_typed` does the same where\n  // it knows the types)\n  match want {\n    TFn { params: [TNamed { name: \"Tuple\", args }], .. } => if len(params) >= 2\n      && len(args) == len(params)\n      && params.all(p -> p.ty is None) {\n      return codegen.lambda_shown(\n        mut g,\n        [ast.LamParam { name: \"$tuple\", ty: None }],\n        ast.Block { stmts: [ast.Let {\n          pat: ast.TuplePat(params.map(p -> ast.Bind(p.name))),\n          ty: None,\n          value: ast.Var(\"$tuple\"),\n        }], last: body },\n        want,\n        label,\n      )\n    },\n    _ => (),\n  }\n  (wps, wret) := match want {\n    TFn { params: ps, ret } => (ps, ret),\n    _ => ([], TAny),\n  }\n  mut pts := []\n  for (k, p) in enumerate(params) {\n    t0 := match p.ty {\n      Some(x) => codegen.lower(mut g, x),\n      None => get(wps, k) ?? TAny,\n    }\n    // an untyped lambda (`(1, x -> x)`) is never called with a value, so\n    // its parameter holds none\n    t := if t0 is TAny && want is TAny && p.ty is None {\n      TUnit\n    } else {\n      t0\n    }\n    // only the layout matters: `List[_]` is a list\n    if t is TAny || t is TGen {\n      codegen.not_yet(mut g, \"a lambda whose parameter `\"\n        + p.name\n        + \"` has a type not known here\")\n      return codegen.never()\n    }\n    mut pts.push(t)\n  }\n  // its captures: the variables it reads, except its parameters\n  mut captured := []\n  for x in codegen.names_in(body, Set[String] {}) {\n    if !params.any(p -> p.name == x) {\n      match codegen.lookup(g, x) {\n        Some(l) => mut captured.push((x, codegen.load(mut g, l))),\n        None => (),\n      }\n    }\n  }\n  g.lambdas += 1\n  sym := f\"@\\\"lambda.{g.owner}{g.lambdas}\\\"\"\n  saved := g\n  g.by_words = false\n  g.result_pos = false\n  g.lines = []\n  g.proving = \"\"\n  g.can_unwind = false\n  g.unwinds = false\n  g.unwind_chain = []\n  g.allocas = []\n  g.next = 0\n  g.scopes = []\n  g.loops = []\n  codegen.push_scope(mut g)\n  codegen.block(mut g, \"start\")\n  env := codegen.V { ty: TStr, op: \"%env\" }\n  g.can_unwind = true\n  for (k, c) in enumerate(captured) {\n    x := codegen.field(mut g, env, k + 3, c.1.ty)\n    codegen.local_value(mut g, c.0, codegen.V { ..x, ty: c.1.ty })\n  }\n  mut sig := [\"ptr %env\"]\n  for (k, p) in enumerate(params) {\n    t := get(pts, k) ?? TAny\n    _ := codegen.local_value(\n      mut g,\n      p.name,\n      codegen.V { ty: t, op: f\"%lp.{k}\" },\n    )\n    if codegen.has_value(t) {\n      mut sig.push(f\"{codegen.ll(t)} %lp.{k}\")\n    }\n  }\n  // a parameter's written refinement (`(n: Positive) -> …`)\n  for p in params {\n    match p.ty {\n      Some(x) => if codegen.needs_check(g, x) {\n        match codegen.lookup(g, p.name) {\n          Some(l) => {\n            pv := codegen.load(mut g, l)\n            codegen.check_type(\n              mut g,\n              x,\n              pv,\n              f\"argument `{p.name}` of a lambda\",\n              [],\n            )\n          },\n          None => (),\n        }\n      },\n      None => (),\n    }\n  }\n  g.ret = codegen.ground(wret)\n  g.rets = []\n  v := codegen.expr_want(mut g, body, g.ret)\n  rt := codegen.better(g.ret, v.ty)\n  if !(v.ty is TAny) {\n    codegen.leave_with(mut g, v)\n    codegen.give_result(mut g, codegen.V { ..v, ty: rt })\n  } else {\n    // an unreachable end still jumps to the exit\n    codegen.give_result(mut g, codegen.V { ty: rt, op: \"poison\" })\n  }\n  codegen.br(mut g, \"exit\")\n  codegen.block(mut g, \"exit\")\n  _ := codegen.result_phi(mut g, rt)\n  mut tail := []\n  if codegen.has_value(rt) {\n    tail = [f\"  ret {codegen.ll(rt)} %result\"]\n  } else {\n    tail = [\"  ret void\"]\n  }\n  tail += codegen.unwound_exit(mut g, rt, false)\n  head := f\"define {codegen.ll(rt)} {sym}({join(sig, \", \")}) {{\"\n  def := join([head]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + tail\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, def)\n  t := TFn { params: pts, ret: rt }\n  shown := if label != \"\" {\n    label\n  } else {\n    \"<closure (\" + join(params.map(p -> p.name), \", \") + \") -> …>\"\n  }\n  p := codegen.closure(mut g, sym, captured.map(c -> c.1), shown)\n  codegen.temp(mut g, codegen.V { ty: t, op: p })\n}"},{"name":"codegen.mark_stacked","kind":"fn","old":"c15b19ff0e72138a","new":"82aac7f7f2dcc06a","interface_changed":true,"affected":["codegen.block_expr","codegen.expr_node","codegen.expr_want_node","codegen.expr","codegen.expr_want","codegen.call_named","codegen.interp","codegen.binary","co