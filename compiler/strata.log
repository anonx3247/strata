 `sorted(ls: List[Language])`\n  // is not what std's `rs.sorted()` calls\n  if g.in_prelude\n    || contains(name, \".\")\n    || starts_with(g.current, \"std.\")\n    || starts_with(g.current, \"core.\") {\n    return \"\"\n  }\n  match codegen.fn_of(g, name) {\n    Some(f) => match get(f.params, 0) {\n      Some(p) => match p.ty {\n        ast.Named { name: n, .. } => if contains(f.type_params, n)\n          || codegen.short(n) == codegen.short(codegen.head_of(t)) {\n          name\n        } else {\n          \"\"\n        },\n        _ => \"\",\n      },\n      None => \"\",\n    },\n    None => \"\",\n  }\n}","old_text":"/// The program's own function `name` (not the prelude's, not a method) for\n/// `x.name(…)` with `x` of type `t`, matched on the first parameter's type\n/// by head, or a type parameter. \"\" if none.\nfn own_fn(g: codegen.Gen, name: String, t: Ty) -> String {\n  // also not std's or core's code: a program's `sorted(ls: List[Language])`\n  // is not what std's `rs.sorted()` calls\n  if g.in_prelude\n    || contains(name, \".\")\n    || starts_with(g.current, \"std.\")\n    || starts_with(g.current, \"core.\") {\n    return \"\"\n  }\n  match codegen.fn_of(g, name) {\n    Some(f) => match get(f.params, 0) {\n      Some(p) => match p.ty {\n        ast.Named { name: n, .. } => if contains(f.type_params, n)\n          || codegen.short(n) == codegen.short(codegen.head_of(t)) {\n          name\n        } else {\n          \"\"\n        },\n        _ => \"\",\n      },\n      None => \"\",\n    },\n    None => \"\",\n  }\n}"},{"name":"codegen.lambda_shown","kind":"fn","old":"ffcf914682bb27df","new":"12e05beaa33230ce","interface_changed":true,"affected":["codegen.function_value","codegen.lambda","codegen.expr_want_node","codegen.spawn_expr","codegen.produce","codegen.method_value","codegen.expr_node","codegen.expr_want","codegen.race_expr","codegen.gen_fn","codegen.expr","codegen.function","codegen.binary","codegen.declare","codegen.destructure","cod