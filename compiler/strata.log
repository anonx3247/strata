"at\"),\n      codegen.fresh(mut g, \"wd\"),\n      codegen.fresh(mut g, \"words\"),\n    )\n    codegen.emit(\n      mut g,\n      f\"{at} = getelementptr i64, ptr %a, i64 {k + 1}\",\n    )\n    codegen.emit(mut g, f\"{x} = load i64, ptr {at}\")\n    if codegen.counted(ft) {\n      v := codegen.from_slot(mut g, x, ft)\n      codegen.dup_value(mut g, v)\n    }\n    codegen.emit(\n      mut g,\n      f\"{nw} = insertvalue {codegen.words_ll(n)} {w}, i64 {x}, {k + off}\",\n    )\n    w = nw\n  }\n  w\n}"},{"name":"codegen.box_fn","kind":"fn","old":"929216ce8b28e4a9","new":"046bd00c9b278f6c","interface_changed":true,"affected":["codegen.words_value","codegen.assign_held","codegen.call_at","codegen.call_fn_want","codegen.stmt_node","codegen.call","codegen.entry","codegen.show","codegen.shown","codegen.equal","codegen.mock_call","codegen.session_entry","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.stmt","codegen.function","codegen.int_lit","codegen.concat","codegen.apply","codegen.finite","codegen.fault","codegen.slice_raw","codegen.list_builtin","codegen.debug_list","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.number_builtin","codegen.format_spec","codegen.word_to_int","codegen.list_literal_of","codegen.checked","codegen.check_type","codegen.host","codegen.channel_op","codegen.trace_enter","codegen.trace_leave","codegen.mem_builtin","codegen.table_from","codegen.set_copy","codegen.checked_update","codegen.appended","codegen.expr_node","codegen.decreases_fault","codegen.build_fn","codegen.push_in_place","codegen.generate","codegen.interp","codegen.dyn_wrapper","codegen.union_text","codegen.destructure","codegen.debug_fields","codegen.for_loop","codegen.fail_unless","codegen.check_requires","codegen.check_ensures","codegen.fuzz_driver","codegen.matching_v","codegen.index_check","codegen.eq_fields","codegen.match