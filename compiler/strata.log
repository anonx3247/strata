.assigned_call","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.to_dyn","codegen.dyn_table_is","codegen.get_field","codegen.matching","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.hash_fields","codegen.block_expr","codegen.scope_expr","codegen.channel_new","codegen.or_else","codegen.list_get_or","codegen.gen_fn","codegen.mock_value","codegen.operands","codegen.session_capability","codegen.spawn_expr","codegen.method_value","codegen.iterate","codegen.decreases_start","codegen.decreases_entry","codegen.tag_is","codegen.satisfies","codegen.holds_pred","codegen.if_expr","codegen.try_expr","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.dyn_ctor_is","codegen.generated","codegen.can_generate","codegen.to_c","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.generated_args","codegen.makers","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// A block in a slot of the frame (a count of 0, as `stack_block`) holding\n/// the words of `w` (`words_ll`, its pointer not read) of a value of small\n/// type `t`, what its fields hold moved there, with room for the largest\n/// constructor. A few stores, no allocation.\nfn stack_words(mut g: codegen.Gen, t: check.Ty, w: String) -> String {\n  n := codegen.small_words(g, t)\n  (multi, cs) := codegen.small_layout(g, t)\n  (frame, p) := (codegen.fresh(mut g, \"stack\"), codegen.fresh(mut g, \"obj\"))\n  most := if multi {\n    n - 1\n  } else {\n    n\n  }\n  mut g.allocas.push(f\"  {frame} = alloca [{most + 2} x i64], align 8\")\n  codegen.emit(mut g, f\"store i64 0, ptr {frame}\")\n  codegen.emit(\n    mut g,\n    f\"{p} = getelementptr i64, ptr {frame}, i64 1\",\n  )\n  if !multi {\n    codegen.emit(\n      mut g,\n      f\"store i64 {codegen.tag_word(g, (get(cs, 0) ?? (\"\", [])).0)}, ptr {p}\",\n    )\n  }\n  off := if multi {\n    0\n  } else {\n    1\n  }\n  for k in 0..n {\n    (x, at) := (codegen.fresh(mut g, \"wd\"), codegen.fresh(mut g, \"at\"))\n    codegen.emit(\n      mut g,\n      f\"{x} = extractvalue {codegen.words_ll(n)} {w}, {k + 1}\",\n    )\n    codegen.emit(\n      mut g,\n      f\"{at} = getelementptr i64, ptr {p}, i64 {k + off}\",\n    )\n    codegen.emit(mut g, f\"store i64 {x}, ptr {at}\")\n  }\n  p\n}","old_text":"/// A block in a slot of the frame (a count of 0, as `stack_block`) holding\n/// the words of `w` (`words_ll`, its pointer not read) of a value of small\n/// type `t`, what its fields hold moved there, with room for the largest\n/// constructor. A few stores, no allocation.\nfn stack_words(mut g: codegen.Gen, t: Ty, w: String) -> String {\n  n := codegen.small_words(g, t)\n  (multi, cs) := codegen.small_layout(g, t)\n  (frame, p) := (codegen.fresh(mut g, \"stack\"), codegen.fresh(mut g, \"obj\"))\n  most := if multi {\n    n - 1\n  } else {\n    n\n  }\n  mut g.allocas.push(f\"  {frame} = alloca [{most + 2} x i64], align 8\")\n  codegen.emit(mut g, f\"store i64 0, ptr {frame}\")\n  codegen.emit(\n    mut g,\n    f\"{p} = getelementptr i64, ptr {frame}, i64 1\",\n  )\n  if !multi {\n    codegen.emit(\n      mut g,\n      f\"store i64 {codegen.tag_word(g, (get(cs, 0) ?? (\"\", [])).0)}, ptr {p}\",\n    )\n  }\n  off := if multi {\n    0\n  } else {\n    1\n  }\n  for k in 0..n {\n    (x, at) := (codegen.fresh(mut g, \"wd\"), codegen.fresh(mut g, \"at\"))\n    codegen.emit(\n      mut g,\n      f\"{x} = extractvalue {codegen.words_ll(n)} {w}, {k + 1}\",\n    )\n    codegen.emit(\n      mut g,\n      f\"{at} = getelementptr i64, ptr {p}, i64 {k + off}\",\n    )\n    codegen.emit(mut g, f\"store i64 {x}, ptr {at}\")\n  }\n  p\n}"},{"name":"codegen.in_result","kind":"fn","old":"e873da42dac3dfef","new":"087f81b8f823000a","interface_changed":true,"affected":["codegen.construct_want","codegen.expr_node","codegen.result_own","codegen.result_joined","codegen.words_value","codegen.construct","codegen.expr_want_node","codegen.expr","codegen.if_want","codegen.matching_v","codegen.call_at","codegen.call_fn_want","codegen.main_arg","codegen.session_capability","codegen.expr_want","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.method_call","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.operands_want","codegen.type_check","codegen.branch_value","codegen.matching_want","codegen.try_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.compared","codegen.stmt_node","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.if_expr","codegen.call","codegen.entry","codegen.show","codegen.shown","codegen.equal","codegen.mock_call","codegen.session_entry","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.by_variant","codegen.function","codegen.declare","codegen.block_expr","codegen.builtin_call","codegen.list_literal_of","codege