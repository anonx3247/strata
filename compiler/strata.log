"command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.helper","codegen.debug_body","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.equal","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.read_back","eval_files","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// The words of the small value in the block on the stack `p`\n/// (`stack_words`, room for any constructor), read as they are (what the\n/// fields hold moves with them), behind a null pointer. A few loads.\nfn load_words(mut g: codegen.Gen, t: check.Ty, p: String) -> String {\n  n := codegen.small_words(g, t)\n  (multi, _) := codegen.small_layout(g, t)\n  off := if multi {\n    0\n  } else {\n    1\n  }\n  ty := codegen.words_ll(n)\n  mut w := codegen.fresh(mut g, \"words\")\n  codegen.emit(mut g, f\"{w} = insertvalue {ty} undef, ptr null, 0\")\n  for k in 0..n {\n    (at, x, nw) := (\n      codegen.fresh(mut g, \"at\"),\n      codegen.fresh(mut g, \"wd\"),\n      codegen.fresh(mut g, \"words\"),\n    )\n    codegen.emit(\n      mut g,\n      f\"{at} = getelementptr i64, ptr {p}, i64 {k + off}\",\n    )\n    codegen.emit(mut g, f\"{x} = load i64, ptr {at}\")\n    codegen.emit(\n      mut g,\n      f\"{nw} = insertvalue {ty} {w}, i64 {x}, {k + 1}\",\n    )\n    w = nw\n  }\n  w\n}","old_text":"/// The words of the small value in the block on the stack `p`\n/// (`stack_words`, room for any constructor), read as they are (what the\n/// fields hold moves with them), behind a null pointer. A few loads.\nfn load_words(mut g: codegen.Gen, t: Ty, p: String) -> String {\n  n := codegen.small_words(g, t)\n  (multi, _) := codegen.small_layout(g, t)\n  off := if multi {\n    0\n  } else {\n    1\n  }\n  ty := codegen.words_ll(n)\n  mut w := codegen.fresh(mut g, \"words\")\n  codegen.emit(mut g, f\"{w} = insertvalue {ty} undef, ptr null, 0\")\n  for k in 0..n {\n    (at, x, nw) := (\n      codegen.fresh(mut g, \"at\"),\n      codegen.fresh(mut g, \"wd\"),\n      codegen.fresh(mut g, \"words\"),\n    )\n    codegen.emit(\n      mut g,\n      f\"{at} = getelementptr i64, ptr {p}, i64 {k + off}\",\n    )\n    codegen.emit(mut g, f\"{x} = load i64, ptr {at}\")\n    codegen.emit(\n      mut g,\n      f\"{nw} = insertvalue {ty} {w}, i64 {x}, {k + 1}\",\n    )\n    w = nw\n  }\n  w\n}"},{"name":"codegen.stack_words","kind":"fn","old":"53e61900b1b45794","new":"aeb00d96e8349e90","interface_changed":true,"affected":["codegen.words_value","codegen.held_words","codegen.call_at","codegen.call_fn_want","codegen.function","codegen.call","codegen.entry","codegen.show","codegen.shown","codegen.equal","codegen.mock_call","codegen.session_entry","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.compiled_alone","codegen.int_lit","codegen.concat","codegen.apply","codegen.finite","codegen.fault","codegen.slice_raw","codegen.list_builtin","codegen.debug_list","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.number_builtin","codegen.format_spec","codegen.word_to_int","codegen.list_literal_of","codegen.checked","codegen.check_type","codegen.host","codegen.channel_op","codegen.trace_enter","codegen.trace_leave","codegen.mem_builtin","codegen.table_from","codegen.set_copy","codegen.checked_update","codegen.appended","codegen.expr_node","codegen.decreases_fault","codegen.build_fn","code