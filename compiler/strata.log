egen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// Whether calling `sym`, whose result is of type `t`, gives the result's\n/// words (`small_words`) instead of a block: the program's functions but\n/// `main` (core.rt's, `bare`, keep the C runtime's conventions).\nfn by_words(g: codegen.Gen, sym: String, t: check.Ty) -> Bool {\n  !g.bare\n    && starts_with(sym, \"@\\\"strata:\")\n    && sym != \"@\\\"strata:main\\\"\"\n    && codegen.small_words(g, t) > 0\n}","old_text":"/// Whether calling `sym`, whose result is of type `t`, gives the result's\n/// words (`small_words`) instead of a block: the program's functions but\n/// `main` (core.rt's, `bare`, keep the C runtime's conventions).\nfn by_words(g: codegen.Gen, sym: String, t: Ty) -> Bool {\n  !g.bare\n    && starts_with(sym, \"@\\\"strata:\")\n    && sym != \"@\\\"strata:main\\\"\"\n    && codegen.small_words(g, t) > 0\n}"},{"name":"codegen.result_ll","kind":"fn","old":"498c4c49958729aa","new":"7e829a394b95e5c8","interface_changed":true,"affected":["codegen.function","codegen.declaration_of","codegen.call_words","codegen.compiled_alone","codegen.instance","codegen.call_at","codegen.call_fn_want","codegen.generate","codegen.session_entry","codegen.call","codegen.entry","codegen.show","codegen.shown","codegen.equal","codegen.mock_call","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen_with","core_rt_text","computed_value","repl_eval","codegen.int_lit","codegen.concat","codegen.apply","codegen.finite","codegen.fault","codegen.slice_raw","codegen.list_builtin","codegen.debug_list","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.number_builtin","codegen.format_spec","codegen.word_to_int","codegen.list_literal_of","codegen.checked","codegen.check_type","codegen.hos