odegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.generated_args","codegen.makers","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// Checks `v`, assigned to the field at `path` of variable `x` (of type\n/// `t`), against the field's declared type where it is refined\n/// (`assigning `l.qty`: Line.qty: …`).\nfn check_field(\n  mut g: codegen.Gen,\n  t: check.Ty,\n  x: String,\n  path: List[String],\n  v: codegen.V,\n) {\n  n := len(path)\n  if n == 0 {\n    return\n  }\n  mut owner := t\n  for f in take(path, n - 1) {\n    owner = codegen.field_index(g, owner, f).1\n  }\n  last := get(path, n - 1) ?? \"\"\n  match owner {\n    check.TNamed { name, .. } => if !contains(g.types.sums, name) {\n      match codegen.field_written(g, owner, name, last) {\n        Some(ft) => if codegen.needs_check(g, ft) {\n          ctx := \"assigning `\" + x + \".\" + join(path, \".\") + \"`\"\n          codegen.check_type(\n            mut g,\n            ft,\n            v,\n            ctx + \": \" + codegen.short(name) + \".\" + last,\n            [],\n          )\n        },\n        None => (),\n      }\n    },\n    _ => (),\n  }\n}","old_text":"/// Checks `v`, assigned to the field at `path` of variable `x` (of type\n/// `t`), against the field's declared type where it is refined\n/// (`assigning `l.qty`: Line.qty: …`).\nfn check_field(\n  mut g: codegen.Gen,\n  t: Ty,\n  x: String,\n  path: List[String],\n  v: codegen.V,\n) {\n  n := len(path)\n  if n == 0 {\n    return\n  }\n  mut owner := t\n  for f in take(path, n - 1) {\n    owner = codegen.field_index(g, owner, f).1\n  }\n  last := get(path, n - 1) ?? \"\"\n  match owner {\n    TNamed { name, .. } => if !contains(g.types.sums, name) {\n      match codegen.field_written(g, owner, name, last) {\n        Some(ft) => if codegen.needs_check(g, ft) {\n          ctx := \"assigning `\" + x + \".\" + join(path, \".\") + \"`\"\n          codegen.check_type(\n            mut g,\n            ft,\n            v,\n            ctx + \": \" + codegen.short(name) + \".\" + last,\n            [],\n          )\n        },\n        None => (),\n      }\n    },\n    _ => (),\n  }\n}"},{"name":"codegen.assign_at","kind":"fn","old":"5a9f36aa263f7838","new":"bac6618e5893fc7e","interface_changed":false,"affected":[],"module":"codegen","text":"/// `x.path = v` (`l` is `x`'s local; `v` taken). Where refined, `v` is\n/// checked against the field's type and the record's new value against its\n/// refinement (`assigning `r.lo``). `proven`: the update is proven to find\n/// `x` held once (`held_test`).\nfn assign_at(\n  mut g: codegen.Gen,\n  l: codegen.Local,\n  x: String,\n  path: List[String],\n  v: codegen.V,\n  proven: Bool,\n) {\n  if !g.elements_checked {\n    codegen.check_field(mut g, l.ty, x, path, v)\n  }\n  cur := codegen.load(mut g, l)\n  // a field of records and tuples nothing else holds, at any depth, is\n  // changed in place\n  nv := if codegen.in_place_path(g, l, cur.ty, path) {\n    codegen.set_field_in_place(mut g, cur, path, v, proven)\n  } else {\n    codegen.set_path(mut g, cur, path, v)\n  }\n  // a refined record's refinement, on its new value\n  if len(path) > 0 {\n    match nv.ty {\n      check.TNamed { name: rn, args: [] } => if contains(g.refines, rn) {\n        ctx := \"assigning `\" + x + \".\" + join(path, \".\") + \"`\"\n        codegen.check_type(\n          mut g,\n          ast.Named { name: rn, args: [] },\n          nv,\n          ctx,\n          [],\n        )\n      },\n      _ => (),\n    }\n  }\n  codegen.replace_var(mut g, l, nv)\n}","old_text":"/// `x.path = v` (`l` is `x`'s local; `v` taken). Where refined, `v` is\n/// checked against the field's type and the record's new value against its\n/// refinement (`assigning `r.lo``). `proven`: the update is proven to find\n/// `x` held once (`held_test`).\nfn assign_at(\n  mut g: codegen.Gen,\n  l: codegen.Local,\n  x: String,\n  path: List[String],\n  v: codegen.V,\n  proven: Bool,\n) {\n  if !g.elements_checked {\n    codegen.check_field(mut g, l.ty, x, path, v)\n  }\n  cur := codegen.load(mut g, l)\n  // a field of records and tuples nothing else holds, at any depth, is\n  // changed in place\n  nv := if codegen.in_place_path(g, l, cur.ty, path) {\n    codegen.set_field_in_place(mut g, cur, path, v, proven)\n  } else {\n    codegen.set_path(mut g, cur, path, v)\n  }\n  // a refined record's refinement, on its new value\n  if len(path) > 0 {\n    match nv.ty {\n      TNamed { name: rn, args: [] } => if contains(g.refines, rn) {\n        ctx := \"assigning `\" + x + \".\" + join(path, \".\") + \"`\"\n        codegen.check_type(\n          mut g,\n          ast.Named { name: rn, args: [] },\n          nv,\n          ctx,\n          [],\n        )\n      },\n      _ => (),\n    }\n  }\n  codegen.replace_var(mut g, l, nv)\n}"},{"name":"codegen.dyn_copy","kind":"fn","old":"0fca97b8e8470d33","new":"bc7961a859aad892","interface_changed":false,"affected":[],"module":"codegen","text":"/// A new block for trait value `v` of trait `tr`: its table, with its value\n/// held once more (the table's `dup`). A temporary.\nfn dyn_copy(mut g: codegen.Gen, v: codegen.V, tr: String) -> codegen.V {\n  (raw, vt, fp, f, sp, s, p, at) := (\n    codegen.fresh(mut g, \"vraw\"),\n    codegen.fresh(mut g, \"vt\"),\n    codegen.fresh(mut g, \"fp\"),\n    codegen.fresh(mut g, \"f\"),\n    codegen.fresh(mut g, \"sp\"),\n    codegen.fresh(mut g, \"s\"),\n    codegen.fresh(mut g, \"dyn\"),\n    codegen.fresh(mut g, \"at\"),\n  )\n  codegen.emit(mut g, f\"{raw} = load i64, ptr {v.op}\")\n  codegen.emit(mut g, f\"{vt} = inttoptr i64 {raw} to ptr\")\n  codegen.emit(mut g, f\"{fp} = getelementptr ptr, ptr {vt}, i64 4\")\n  codegen.emit(mut g, f\"{f} = load ptr, ptr {fp}\")\n  codegen.emit(\n    mut g,\n    f\"{sp} = getelementptr i64, ptr {v.op}, i64 1\",\n  )\n  codegen.emit(mut g, f\"{s} = load i64, ptr {sp}\")\n  codegen.emit(mut g, f\"call void {f}(i64 {s})\")\n  codegen.use_rt(mut g, \"strata_alloc\")\n  codegen.emit(mut g, f\"{p} = call ptr @strata_alloc(i64 16)\")\n  codegen.emit(mut g, f\"store i64 {raw}, ptr {p}\")\n  codegen.emit(mut g, f\"{at} = getelementptr i64, ptr {p}, i64 1\")\n  codegen.emit(mut g, f\"store i64 {s}, ptr {at}\")\n  codegen.temp(mut g, codegen.V { ty: check.TTrait(tr), op: p })\n}","old_text":"/// A new block for trait value `v` of trait `tr`: its table, with its value\n/// held once more (the table's `dup`). A temporary.\nfn dyn_copy(mut g: codegen.Gen, v: codegen.V, tr: String) -> codegen.V {\n  (raw, vt, fp, f, sp, s, p, at) := (\n    codegen.fresh(mut g, \"vraw\"),\n    codegen.fresh(mut g, \"vt\"),\n    codegen.fresh(mut g, \"fp\"),\n    codegen.fresh(mut g, \"f\"),\n    codegen.fresh(mut g, \"sp\"),\n    codegen.fresh(mut g, \"s\"),\n    codegen.fresh(mut g, \"dyn\"),\n    codegen.fresh(mut g, \"at\"),\n  )\n  codegen.emit(mut g, f\"{raw} = load i64, ptr {v.op}\")\n  codegen.emit(mut g, f\"{vt} = inttoptr i64 {raw} to ptr\")\n  codegen.emit(mut g, f\"{fp} = getelementptr ptr, ptr {vt}, i64 4\")\n  codegen.emit(mut g, f\"{f} = load ptr, ptr {fp}\")\n  codegen.emit(\n    mut g,\n    f\"{sp} = getelementptr i64, ptr {v.op}, i64 1\",\n  )\n  codegen.emit(mut g, f\"{s} = load i64, ptr {sp}\")\n  codegen.emit(mut g, f\"call void {f}(i64 {s})\")\n  codegen.use_rt(mut g, \"strata_alloc\")\n  codegen.emit(mut g, f\"{p} = call ptr @strata_alloc(i64 16)\")\n  codegen.emit(mut g, f\"store i64 {raw}, ptr {p}\")\n  codegen.emit(mut g, f\"{at} = getelementptr i64, ptr {p}, i64 1\")\n  codegen.emit(mut g, f\"store i64 {s}, ptr {at}\")\n  codegen.temp(mut g, codegen.V { ty: TTrait(tr), op: p })\n}"},{"name":"codegen.tag_test","kind":"fn","old":"dc66904673a24267","new":"08cb3711d26c3b83","interface_changed":false,"affected":[],"module":"codegen","text":"/// `e == C` (`op`), with `C` a field-less constructor, as `e is C`.\nfn tag_test(\n  mut g: codegen.Gen,\n  op: ast.BinOp,\n  e: ast.Expr,\n  c: String,\n) -> codegen.V {\n  v := codegen.expr(mut g, ast.IsExpr { value: e, variant: c })\n  if v.ty is check.TAny || op is ast.Equal {\n    return v\n  }\n  r := codegen.fresh(mut g, \"ne\")\n  codegen.emit(mut g, f\"{r} = xor i1 {v.op}, true\")\n  codegen.V { ty: check.TBool, op: r }\n}","old_text":"/// `e == C` (`op`), with `C` a field-less constructor, as `e is C`.\nfn tag_test(\n  mut g: codegen.Gen,\n  op: ast.BinOp,\n  e: ast.Expr,\n  c: String,\n) -> codegen.V {\n  v := codegen.expr(mut g, ast.IsExpr { value: e, variant: c })\n  if v.ty is TAny || op is ast.Equal {\n    return v\n  }\n  r := codegen.fresh(mut g, \"ne\")\n  codegen.emit(mut g, f\"{r} = xor i1 {v.op}, true\")\n  codegen.V { ty: TBool, op: r }\n}"},{"name":"codegen.own_fn","kind":"fn","old":"be279824c4528e6d","new":"b79e65fa18be53fe","interface_changed":true,"affected":["codegen.method_call","codegen.expr_node","codegen.expr_want_node","codegen.expr","codegen.expr_want","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_check","codegen.if_want","codegen.branch_value