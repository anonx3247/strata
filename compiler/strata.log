,"codegen.string_builtin","codegen.dyn_wrapper","codegen.host","codegen.spawn_expr","codegen.method_value","codegen.foreign_call","codegen.generated","codegen.can_generate","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.session_entry","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","codegen.generated_args","codegen.makers","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.helper","codegen.debug_body","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.equal","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.read_back","eval_files","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// The function dropping a value of type `t` held as an `i64` slot, as a\n/// channel holds what was sent. `null` when there is nothing to drop.\nfn slot_drop_fn(mut g: codegen.Gen, t: check.Ty) -> String {\n  if !codegen.counted(t) {\n    return \"null\"\n  }\n  name := f\"@\\\"slot.drop:{codegen.key(t)}\\\"\"\n  if !codegen.has_helper(g, name) {\n    codegen.add_helper(mut g, name)\n    saved := g\n    codegen.start_helper(mut g)\n    v := codegen.from_slot(mut g, \"%s\", t)\n    codegen.drop_value(mut g, v)\n    codegen.emit(mut g, \"ret void\")\n    codegen.restore(\n      mut g,\n      saved,\n      codegen.helper_text(g, f\"define void {name}(i64 %s)\"),\n    )\n  }\n  name\n}","old_text":"/// The function dropping a value of type `t` held as an `i64` slot, as a\n/// channel holds what was sent. `null` when there is nothing to drop.\nfn slot_drop_fn(mut g: codegen.Gen, t: Ty) -> String {\n  if !codegen.counted(t) {\n    return \"null\"\n  }\n  name := f\"@\\\"slot.drop:{codegen.key(t)}\\\"\"\n  if !codegen.has_helper(g, name) {\n    codegen.add_helper(mut g, name)\n    saved := g\n    codegen.start_helper(mut g)\n    v := codegen.from_slot(mut g, \"%s\", t)\n    codegen.drop_value(mut g, v)\n    codegen.emit(mut g, \"ret void\")\n    codegen.restore(\n      mut g,\n      saved,\n      codegen.helper_text(g, f\"define void {name}(i64 %s)\"),\n    )\n  }\n  name\n}"},{"name":"codegen.opaque","kind":"fn","old":"48ab5b34b5d97786","new":"e2cc1bc6007a217b","interface_changed":true,"affected":["codegen.shown","codegen.equal","codegen.show","codegen.destructure","codegen.debug_fields","codegen.for_loop","codegen.debug_list","codegen.builtin","codegen.string_builtin","codegen.format_spec","codegen.dyn_wrapper","codegen.union_text","codegen.checked","codegen.fail_unless","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.fuzz_driver","codegen.trace_enter","codegen.trace_leave","codegen.type_check","codegen.matching_v","codegen.index_check","codegen.checked_update","codegen.decreases_fault","codegen.apply","codegen.eq_fields","codegen.matches","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.entry","codegen.interp","codegen.stmt_node","codegen.debug_body","codegen.helper","codegen.call_named