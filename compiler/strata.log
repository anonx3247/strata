rrors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","codegen.read_back","eval_files"],"module":"codegen","text":"/// `value!` with a wanted type: `value` is wanted as an `Option` or a\n/// `Result` of it (with the function's error), which types a generic\n/// callee's result (`decode_as(T, …)!` for an `Int`).\nfn try_want(\n  mut g: codegen.Gen,\n  value: ast.Expr,\n  kind: ast.TryKind,\n  want: check.Ty,\n) -> codegen.V {\n  w := if want is check.TAny {\n    check.TAny\n  } else if kind == ast.TryResult {\n    err := match g.ret {\n      check.TNamed { name: \"Result\", args: [_, e] } => e,\n      _ => check.TAny,\n    }\n    check.TNamed { name: \"Result\", args: [want, err] }\n  } else {\n    check.TNamed { name: \"Option\", args: [want] }\n  }\n  // (a call's result in result position: on the stack, its words the\n  // result when it isn't good)\n  g.result_pos = g.by_words && codegen.call_like(g, value)\n  v := if w is check.TAny {\n    codegen.expr(mut g, value)\n  } else {\n    codegen.expr_want(mut g, value, w)\n  }\n  g.result_pos = false\n  if v.ty is check.TAny {\n    return v\n  }\n  good := if kind == ast.TryResult {\n    \"Ok\"\n  } else {\n    \"Some\"\n  }\n  is_good := codegen.tag_is(mut g, v, good)\n  (ok, fail) := (codegen.label(mut g, \"try.ok\"), codegen.label(mut g, \"try.fail\"))\n  codegen.emit(\n    mut g,\n    f\"br i1 {is_good.op}, label %{ok}, label %{fail}\",\n  )\n  codegen.block(mut g, fail)\n  codegen.leave_with(mut g, v)\n  codegen.give_result(\n    mut g,\n    codegen.V { ..v, ty: codegen.better(g.ret, v.ty) },\n  )\n  codegen.br(mut g, \"exit\")\n  codegen.block(mut g, ok)\n  codegen.field(mut g, v, 0, codegen.inner_of(v.ty))\n}","old_text":"/// `value!` with a wanted type: `value` is wanted as an `Option` or a\n/// `Result` of it (with the function's error), which types a generic\n/// callee's result (`decode_as(T, …)!` for an `Int`).\nfn try_want(\n  mut g: codegen.Gen,\n  value: ast.Expr,\n  kind: ast.TryKind,\n  want: Ty,\n) -> codegen.V {\n  w := if want is TAny {\n    TAny\n  } else if kind == ast.TryResult {\n    err := match g.ret {\n      TNamed { name: \"Result\", args: [_, e] } => e,\n      _ => TAny,\n    }\n    TNamed { name: \"Result\", args: [want, err] }\n  } else {\n    TNamed { name: \"Option\", args: [want] }\n  }\n  // (a call's result in result position: on the stack, its words the\n  // result when it isn't good)\n  g.result_pos = g.by_words && codegen.call_like(g, value)\n  v := if w is TAny {\n    codegen.expr(mut g, value)\n  } else {\n    codegen.expr_want(mut g, value, w)\n  }\n  g.result_pos = false\n  if v.ty is TAny {\n    return v\n  }\n  good := if kind == ast.TryResult {\n    \"Ok\"\n  } else {\n    \"Some\"\n  }\n  is_good := codegen.tag_is(mut g, v, good)\n  (ok, fail) := (codegen.label(mut g, \"try.ok\"), codegen.label(mut g, \"try.fail\"))\n  codegen.emit(\n    mut g,\n    f\"br i1 {is_good.op}, label %{ok}, label %{fail}\",\n  )\n  codegen.block(mut g, fail)\n  codegen.leave_with(mut g, v)\n  codegen.give_result(\n    mut g,\n    codegen.V { ..v, ty: codegen.better(g.ret, v.ty) },\n  )\n  codegen.br(mut g, \"exit\")\n  codegen.block(mut g, ok)\n  codegen.field(mut g, v, 0, codegen.inner_of(v.ty))\n}"},{"name":"codegen.holds_union","kind":"fn","old":"565db7c15445dc2c","new":"e00d2122ea86e7d3","interface_changed":true,"affected":["codegen.call_fn_want","codege