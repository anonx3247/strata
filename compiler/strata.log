e FILE holds the function that makes the call\n  // (in `f`'s module, with the arguments written in it); it is added to the\n  // program.\n  mut made := []\n  if get(files, 0) ?? \"\" == \"--call\" {\n    made = module_decls(disk, [get(files, 1) ?? \"\"])\n    files = drop(files, 2)\n  }\n  calls := fn_names(made)\n  // (with core's types: their refinements, `Natural` and the others)\n  prelude := sh.prelude\n  // the program as it runs: desugared, its `derive`s expanded, with the std\n  // modules it uses (read from `std/`, until what the expanded code names is\n  // there too) and core's code (iterators: only what it uses is compiled),\n  // its names global as core's types are. A script, or a package's folder\n  // with each module named by its path. `Base` holds the run's program,\n  // already expanded, when it is this one.\n  base := match sh.base {\n    Some(b) => if b.files == files && !library && !tests && made == [] {\n      Some(b)\n    } else {\n      None\n    },\n    None => None,\n  }\n  mut own := if library {\n    package_decls(disk, \"std\", \"std\")\n  } else {\n    []\n  }\n  own += match base {\n    Some(b) => b.own,\n    None => files_decls(disk, sh.cache.dir, sh.core, files),\n  }\n  own += extra + made\n  if lib {\n    own = own.filter(\n      d -> !(d.module == \"\"\n        && match d.kind {\n          ast.FnDef(f) => f.name == \"main\",\n          _ => false,\n        }),\n    )\n  }\n  // the tests, each a function of no parameters given what it asks for\n  mut test_fns := []\n  if tests {\n    mut kept := []\n    for d in own {\n      match d.kind {\n        // (not the runtime's modules' (core.rt …): they compile only together,\n        // into the runtime, `strata build-core`)\n        ast.TestDef(t) => if !builtins.runtime_module(d.module) {\n          fd := test_fn(t, \"test:\" + to_string(len(test_fns)))\n          // (named after its module outside the root one, as `core.mem: …`)\n          shown := if d.module == \"\" {\n            t.name\n          } else {\n            d.module + \": \" + t.name\n          }\n          // (its key as the code generator names it, qualified by its module: a key\n          // naming no function compiles `main` in its place)\n          mut test_fns.push((qualified_name(d.module, fd.name), shown))\n          mut kept.push(ast.Decl { ..d, kind: ast.FnDef(fd) })\n        },\n        _ => mut kept.push(d),\n      }\n    }\n    own = kept\n  }\n  core := sh.core\n  extended := match base {\n    Some(b) => with_extra(disk, sh, b, extra),\n    None => None,\n  }\n  (program, errors) := match extended {\n    Some(x) => x,\n    None => {\n      made_now := expanded(\n        disk,\n        Shared { ..sh, settings: settings_of_files(disk, files) },\n        own,\n      )\n      (made_now.0, made_now.1)\n    },\n  }\n  for e in errors {\n    mut out.push(\"error: in `\" + e.0 + \"`: \" + e.1)\n  }\n  // (the codebase, when the program reaches `std.code`)\n  program := if code_root != \"\" && program.any(d -> d.module == \"std.code\") {\n    program + code_snapshot_decls(disk, core, code_root)\n  } else {\n    program\n  }\n  // (std's library: each of std's functions except those reading a\n  // package's setting, `std.typing.setting`, which compile with each program)\n  mut roots := []\n  if library {\n    mut reads := Set[String] {}\n    for d in own {\n      match d.kind {\n        ast.FnDef(f) => if walk.any_expr(f.body, e -> match e {\n          ast.Call { callee: ast.Var(\"std.typing.setting\"), .. } => true,\n          _ => false,\n        }) {\n          mut reads.insert(d.module + \".\" + f.name)\n        },\n        _ => (),\n      }\n    }\n    for d in program {\n      match d.kind {\n        ast.FnDef(f) => if starts_with(d.module, \"std.\")\n          && !contains(reads, d.module + \".\" + f.name) {\n          mut roots.push(d.module + \".\" + f.name)\n        },\n        _ => (),\n      }\n    }\n  }\n  wanted := if tests {\n    Some(test_fns)\n  } else {\n    None\n  }\n  // (std's library: compiled again without the functions it can't hold,\n  // until it compiles; an `impl` method it can't hold is `!KEY`)\n  mut left_out := []\n  places := if copies || memory_sites {\n    finding.copy_sites(own)\n  } else {\n    Dict[String, String] {}\n  }\n  sites := if copies {\n    Some(places)\n  } else {\n    None\n  }\n  counted := if memory_sites {\n    Some(places)\n  } else {\n    None\n  }\n  for _ in 0..16 {\n    match timings.timed(\"codegen IR\", () -> codegen.generate(\n      program,\n      core,\n      prelude,\n      proofs,\n      wanted,\n      fuzz,\n      fuzz_text,\n      calls,\n      trace,\n      roots + left_out,\n      precompiled,\n      false,\n      sites,\n      counted,\n      assumed_clauses,\n      regions,\n    )) {\n      Ok(ir) => {\n        mut out.push(ir)\n        break\n      },\n      Err(es) => if es.all(e -> starts_with(e, \"leave out: \")) && es != [] {\n        left := set(es.map(e -> byte_slice(e, 11, byte_len(e))))\n        roots = roots.filter(r -> !contains(left, r))\n        for k in left {\n          mut left_out.push(\"!\" + k)\n        }\n      } else {\n        for e in es {\n          mut out.push(\"error: \" + e)\n        }\n        break\n      },\n    }\n  }\n  join(out, \"\\n\")\n}"},{"name":"core_rt_text","kind":"fn","old":"ff5c0211d517119b","new":"c75e5f1749ddc2d8","interface_changed":false,"affected":[],"module":"","text":"// ---- the runtime in Strata (core.rt) ----\n\n/// core.rt (`core/rt.strata`) with the topic modules it uses (core.str,\n/// core.int: `runtime_module`), as LLVM IR to link with the C runtime built\n/// without its own versions (`STRATA_CORE_RT`). Each function named\n/// `strata_...` is compiled as a library's.\nfn core_rt_text(disk: std.fs.Disk) -> String {\n  prelude := desugar.desugar(module_decls(\n    disk,\n    [\"runtime/prelude.strata\", \"core/types.strata\"],\n  )).0\n  // (in the root module, as core's other code. core's names are global, so\n  // its module files keep calls as written, `lock(32)`, and codegen looks\n  // them up by name. Under `core.rt` its functions would be keyed\n  // `core.rt.lock`, the calls would find nothing, and library mode would\n  // leave out every function reaching one.)\n  runtime := core_marked(disk, \"\", module_decls(disk, [\n    \"core/rt.strata\",\n    \"core/str.strata\",\n    \"core/int.strata\",\n    \"core/list.strata\",\n    \"core/fmt.strata\",\n    \"core/float.strata\",\n    \"core/gen.strata\",\n    \"core/fault.strata\",\n    \"core/run.strata\",\n  ])).filter(\n    d -> match d.kind {\n      ast.TestDef(_) => false,\n      _ => true,\n    },\n  )\n  // the runtime checks first, in its own modules, resolved (its files are\n  // stored as written). What doesn't check isn't compiled: a function that\n  // allocates, a word mixed with an `Int`.\n  core := read_core(disk)\n  errs := check_errors_of(resolve.stored(runtime, [], core), [], core, true)\n  if errs != [] {\n    return join(errs.map(e -> \"error: in \" + e.0 + \": \" + e.1), \"\\n\")\n  }\n  own := runtime.map(d -> ast.Decl { ..d, module: \"\" })\n  program := desugar.desugar(own).0\n  mut roots := []\n  for d in program {\n    match d.kind {\n      ast.FnDef(f) => if starts_with(f.name, \"strata_\") {\n        mut roots.push(f.name)\n      },\n      _ => (),\n    }\n  }\n  match codegen.generate(\n    program,\n    core,\n    prelude,\n    [],\n    None,\n    [],\n    false,\n    [],\n    false,\n    roots,\n    [],\n    true,\n    None,\n    None,\n    false,\n    false,\n    false,\n  ) {\n    Ok(ir) => with_c_names(ir, roots),\n    Err(es) => join(es.map(e -> \"error: \" + e), \"\\n\"),\n  }\n}","old_text":"// ---- the runtime in Strata (core.rt) ----\n\n/// core.rt (`core/rt.strata`) with the topic modules it uses (core.str,\n/// core.int: `runtime_module`), as LLVM IR to link with the C runtime built\n/// without its own versions (`STRATA_CORE_RT`). Each function named\n/// `strata_...` is compiled as a library's.\nfn core_rt_text(disk: std.fs.Disk) -> String {\n  prelude := desugar.desugar(module_decls(\n    disk,\n    [\"runtime/prelude.strata\", \"core/types.strata\"],\n  )).0\n  // (in the root module, as core's other code. core's names are global, so\n  // its module files keep calls as written, `lock(32)`, and codegen looks\n  // them up by name. Under `core.rt` its functions would be keyed\n  // `core.rt.lock`, the calls would find nothing, and library mode would\n  // leave out every function reaching one.)\n  runtime := core_marked(disk, \"\", module_decls(disk, [\n    \"core/rt.strata\",\n    \"core/str.strata\",\n    \"core/int.strata\",\n    \"core/list.strata\",\n    \"core/fmt.strata\",\n    \"core/float.strata\",\n    \"core/gen.strata\",\n    \"core/fault.strata\",\n    \"core/run.strata\",\n  ])).filter(\n    d -> match d.kind {\n      ast.TestDef(_) => false,\n      _ => true,\n    },\n  )\n  // the runtime checks first, in its own modules, resolved (its files are\n  // stored as written). What doesn't check isn't compiled: a function that\n  // allocates, a word mixed with an `Int`.\n  core := read_core(disk)\n  errs := check_errors_of(resolve.stored(runtime, [], core), [], core, true)\n  if errs != [] {\n    return join(errs.map(e -> \"error: in \" + e.0 + \": \" + e.1), \"\\n\")\n  }\n  own := runtime.map(d -> ast.Decl { ..d, module: \"\" })\n  program := desugar.desugar(own).0\n  mut roots := []\n  for d in program {\n    match d.kind {\n      ast.FnDef(f) => if starts_with(f.name, \"strata_\") {\n        mut roots.push(f.name)\n      },\n      _ => (),\n    }\n  }\n  match codegen.generate(\n    program,\n    core,\n    prelude,\n    [],\n    None,\n    [],\n    false,\n    [],\n    false,\n    roots,\n    [],\n    true,\n    None,\n    None,\n    false,\n    false,\n  ) {\n    Ok(ir) => with_c_names(ir, roots),\n    Err(es) => join(es.map(e -> \"error: \" + e), \"\\n\"),\n  }\n}"},{"name":"computed_value","kind":"fn","old":"892701e2294080d5","new":"d452c1ddc24c462c","interface_changed":false,"affected":[],"module":"","text":"/// Compiles and runs `comptime_value`'s value, without the cache.\nfn computed_value(\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  ds: List[ast.Decl],\n  m: String,\n  e: ast.Expr,\n) -> Result[ast.Expr, String] {\n  name := \"strata_comptime\"\n  key := if m == \"\" {\n    name\n  } else {\n    m + \".\" + name\n  }\n  // its type, as the checker infers it for a variable holding it\n  probe := ast.FnDecl {\n    doc: [],\n    comments: [],\n    name,\n    type_params: [],\n    bounds: [],\n    params: [],\n    ret: ast.UnitType,\n    pre: [],\n    post: [],\n    terminating: false,\n    body: ast.Block {\n      stmts: [\n        ast.Let {\n          pat: ast.Bind(\"strata_value\"),\n          ty: None,\n          value: e,\n        },\n      ],\n      last: ast.UnitExpr,\n    },\n    compile_time: false,\n    derived: false,\n  }\n  at := ast.Decl {\n    comments: [],\n    doc: [],\n    module: m,\n    public: false,\n    kind: ast.FnDef(probe),\n  }\n  mut t := None\n  for d in check.typed(ds + [at], core) {\n    match d.kind {\n      ast.FnDef(f) => if f.name == name && d.module == m {\n        match f.body {\n          ast.Block { stmts: [ast.Let { ty, .. }], .. } => {\n            t = ty\n          },\n          _ => (),\n        }\n      },\n      _ => (),\n    }\n  }\n  ty := match t {\n    Some(x) => x,\n    None => return Err(derive.not_compiled() + \"its type isn't known\"),\n  }\n  program := ds\n    + [\n      ast.Decl { ..at, kind: ast.FnDef(ast.FnDecl { ..probe, ret: ty, body: e }) },\n    ]\n  ir := match codegen.generate(\n    program,\n    core,\n    prelude,\n    [],\n    None,\n    [],\n    false,\n    [key],\n    false,\n    [],\n    [],\n    false,\n    None,\n    None,\n    false,\n    false,\n    false,\n  ) {\n    Ok(x) => x,\n    Err(es) => return Err(derive.not_compiled() + join(es, \"; \")),\n  }\n  h := jit_fuzz_load(ir)\n  if h.to_int() < 0 {\n    return Err(derive.not_compiled() + jit_fuzz_error())\n  }\n  match jit_call_case(h, 0, to_i64(comptime_budget())).to_int() {\n    // (written with its type, which a literal alone may not say: `[1, \"x\"]`\n    // of a `List[Int | String]`)\n    0 => match codegen.read_back(\n      program,\n      core,\n      prelude,\n      ty,\n      Raw { address: jit_kept() },\n    ) {\n      Ok(v) => Ok(ast.Block { stmts: [ast.Let {\n        pat: ast.Bind(\"strata_value\"),\n        ty: Some(ty),\n        value: v,\n      }], last: ast.Var(\"strata_value\") }),\n      Err(why) => Err(derive.not_compiled() + why),\n    },\n    1 => {\n      why := jit_fault_message()\n      if why == \"too many steps\" {\n        Err(\n          f\"ran for more than {comptime_budget()} steps: compile-time code must finish\",\n        )\n      } else {\n        Err(why)\n      }\n    },\n    _ => Err(derive.not_compiled() + \"no call to run\"),\n  }\n}","old_text":"/// Compiles and runs `comptime_value`'s value, without the cache.\nfn computed_value(\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  ds: List[ast.Decl],\n  m: String,\n  e: ast.Expr,\n) -> Result[ast.Expr, String] {\n  name := \"strata_comptime\"\n  key := if m == \"\" {\n    name\n  } else {\n    m + \".\" + name\n  }\n  // its type, as the checker infers it for a variable holding it\n  probe := ast.FnDecl {\n    doc: [],\n    comments: [],\n    name,\n    type_params: [],\n    bounds: [],\n    params: [],\n    ret: ast.UnitType,\n    pre: [],\n    post: [],\n    terminating: false,\n    body: ast.Block {\n      stmts: [\n        ast.Let {\n          pat: ast.Bind(\"strata_value\"),\n          ty: None,\n          value: e,\n        },\n      ],\n      last: ast.UnitExpr,\n    },\n    compile_time: false,\n    derived: false,\n  }\n  at := ast.Decl {\n    comments: [],\n    doc: [],\n    module: m,\n    public: false,\n    kind: ast.FnDef(probe),\n  }\n  mut t := None\n  for d in check.typed(ds + [at], core) {\n    match d.kind {\n      ast.FnDef(f) => if f.name == name && d.module == m {\n        match f.body {\n          ast.Block { stmts: [ast.Let { ty, .. }], .. } => {\n            t = ty\n          },\n          _ => (),\n        }\n      },\n      _ => (),\n    }\n  }\n  ty := match t {\n    Some(x) => x,\n    None => return Err(derive.not_compiled() + \"its type isn't known\"),\n  }\n  program := ds\n    + [\n      ast.Decl { ..at, kind: ast.FnDef(ast.FnDecl { ..probe, ret: ty, body: e }) },\n    ]\n  ir := match codegen.generate(\n    program,\n    core,\n    prelude,\n    [],\n    None,\n    [],\n    false,\n    [key],\n    false,\n    [],\n    [],\n    false,\n    None,\n    None,\n    false,\n    false,\n  ) {\n    Ok(x) => x,\n    Err(es) => return Err(derive.not_compiled() + join(es, \"; \")),\n  }\n  h := jit_fuzz_load(ir)\n  if h.to_int() < 0 {\n    return Err(derive.not_compiled() + jit_fuzz_error())\n  }\n  match jit_call_case(h, 0, to_i64(comptime_budget())).to_int() {\n    // (written with its type, which a literal alone may not say: `[1, \"x\"]`\n    // of a `List[Int | String]`)\n    0 => match codegen.read_back(\n      program,\n      core,\n      prelude,\n      ty,\n      Raw { address: jit_kept() },\n    ) {\n      Ok(v) => Ok(ast.Block { stmts: [ast.Let {\n        pat: ast.Bind(\"strata_value\"),\n        ty: Some(ty),\n        value: v,\n      }], last: ast.Var(\"strata_value\") }),\n      Err(why) => Err(derive.not_compiled() + why),\n    },\n    1 => {\n      why := jit_fault_message()\n      if why == \"too many steps\" {\n        Err(\n          f\"ran for more than {comptime_budget()} steps: compile-time code must finish\",\n        )\n      } else {\n        Err(why)\n      }\n    },\n    _ => Err(derive.not_compiled() + \"no call to run\"),\n  }\n}"},{"name":"run_command","kind":"fn","old":"b7ec59bff1611a18","new":"02458269f6868103","interface_changed":false,"affected":[],"module":"","text":"/// `strata run [PATH] [--trace] [--all-checks] [--no-verify]\n/// [--wait-for-proofs] [--verify-alongside] [--live] [-- ARGS]`: checks the\n/// program\n/// (PATH, else `--file`, else the package here), compiles it with\n/// compiler/codegen without the checks `verify` proved, and runs it in the\n/// JIT in this process, in the current folder, with ARGS. The exit code is\n/// the program's.\n/// \n/// A program changed since it was last verified starts at once with the\n/// checks not proven yet, while it is verified alongside (`run_verifying`,\n/// `start_alongside`). The proven code is swapped in while it runs, and\n/// the next run starts with it.\n/// \n/// `--live`: while it runs, an edit of its files that checks and verifies\n/// is swapped in (`start_live`, `live_edits_command`); no verifier runs\n/// alongside.\nfn run_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n  cwd: String,\n) -> std.process.ExitCode {\n  // `strata run hello.strata`: the program's path in place of --file\n  first := get(line.pos, 1) ?? \"\"\n  named := first != \"\"\n    && (ends_with(first, \".strata\")\n      || disk.exists(driver.absolute_path(cwd, first) + \"/strata.toml\"))\n  path := if named {\n    driver.absolute_path(cwd, first)\n  } else {\n    match target_of(disk, line, cwd) {\n      Ok(f) => f,\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  if !disk.exists(path) {\n    return fail_with(mut console, missing(line, path))\n  }\n  match file_problem(disk, path) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  rest := drop(line.pos, if named {\n    2\n  } else {\n    1\n  })\n  lib := std_library(mut console, mut disk, process, cache)\n  sh := shared(disk, cache)\n  // (a package's settings, each one of its values: `[json] unknown_keys`)\n  match settings_error(disk, path) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  errors := warned(mut console, file_errors(\n    mut launcher,\n    mut disk,\n    cache,\n    \"std\",\n    path,\n    false,\n    sh.core,\n    sh,\n    std_loaded(lib),\n  ))\n  if errors != [] {\n    for e in errors {\n      mut console.eprint(error_text(e))\n    }\n    return 1\n  }\n  if rest != [] {\n    return call_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n      path,\n      lib,\n      rest,\n    )\n  }\n  // the checks the last `verify` proved are left out (`--all-checks` keeps\n  // them all). With `--wait-for-proofs`, what changed is verified first, as\n  // `build` does.\n  verifying := run_verifying(line)\n  facts := if driver.given(line, \"--all-checks\") {\n    []\n  } else {\n    build_proofs(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      lib,\n      path,\n      verifying is WaitForProofs,\n    )\n  }\n  scratch := scratch_of(mut disk, cache, \"run\")\n  proofs := scratch + \"/proofs.txt\"\n  not_covered := scratch + \"/errors.txt\"\n  match mut disk.write(proofs, join(facts, \"\\n\")) {\n    _ => (),\n  }\n  // (`--trace`: std's functions are compiled with the program, so their\n  // calls are traced too; `--memory-sites`: so their sites are counted;\n  // `--regions`: so their values go in statement regions too)\n  traced := driver.given(line, \"--trace\")\n    || driver.given(line, \"--memory-sites\")\n    || driver.given(line, \"--regions\")\n  mut loads := match lib {\n    Some(l) => if traced {\n      []\n    } else {\n      [\"--load\", l.shared]\n    },\n    None => [],\n  }\n  // the package's C (`[native]`), for its `extern c` functions: a shared\n  // library loaded too\n  native := scratch + \"/native.dylib\"\n  match deps.native_library(\n    mut launcher,\n    mut disk,\n    toolchain.c_compiler(process),\n    path,\n    native,\n  ) {\n    Ok(true) => {\n      loads += [\"--load\", native]\n    },\n    Ok(false) => (),\n    Err(e) => {\n      match mut disk.remove_all(scratch) {\n        _ => (),\n      }\n      return fail_with(mut console, e)\n    },\n  }\n  pre := match lib {\n    Some(l) => if traced {\n      []\n    } else {\n      [\"--precompiled\", l.names]\n    },\n    None => [],\n  }\n  trace := if driver.given(line, \"--trace\") {\n    [\"--trace\"]\n  } else {\n    []\n  }\n  // (`--copies`: the copies the program makes are reported when it ends;\n  // `--memory-sites`: its counting operations, by site; `--regions`:\n  // statement regions; `--live`: each function compiled from its own code\n  // alone, since edits swap some of them)\n  copies := [\"--copies\", \"--memory-sites\", \"--regions\", \"--live\"].filter(\n    f -> driver.given(line, f),\n  )\n  // (a program changed since it was last verified: verified alongside, and\n  // compiled swappable)\n  if driver.given(line, \"--live\") {\n    start_live(\n      mut console,\n      mut disk,\n      process,\n      cache,\n      path,\n      cwd,\n      pre + trace + copies + assumed_flag(line),\n    )\n  } else if verifying is VerifyAlongside\n    && !driver.given(line, \"--all-checks\") {\n    start_alongside(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      path,\n      facts,\n      cwd,\n      pre + trace + copies + assumed_flag(line),\n    )\n  }\n  code := jit_file(mut disk, cache, loads\n    + [\n      \"--name\",\n      program_name_of(disk, path),\n      \"--errors\",\n      not_covered,\n      \"--dir\",\n      cwd,\n      \"--scratch\",\n      scratch,\n      \"--proofs\",\n      proofs,\n    ]\n    + pre\n    + trace\n    + copies\n    + assumed_flag(line)\n    + [path, \"--\"]\n    + line.after)\n  // (when the program ran, `jit_file` ended the process with its exit code:\n  // here, it couldn't run)\n  uncovered := match disk.read(not_covered) {\n    Ok(t) => [l for l in lines(t) where starts_with(l, \"error:\")],\n    Err(_) => [],\n  }\n  match mut disk.remove_all(scratch) {\n    _ => (),\n  }\n  if code == 3 && uncovered == [\"error: no `main` function\"] {\n    return fail_with(\n      mut console,\n      \"no `main` function to run (the entry point is `fn main` in main.strata, or in the file you run)\",\n    )\n  }\n  match main_asks(uncovered) {\n    Some(e) => if code == 3 {\n      return fail_with(mut console, e)\n    },\n    None => (),\n  }\n  if code == 3 && uncovered != [] {\n    return fail_with(\n      mut console,\n      \"compiler/codegen doesn't cover this program yet:\\n\"\n        + placed(\n          disk,\n          process,\n          path,\n          uncovered,\n          console.paint(std.term.Errors),\n        ),\n    )\n  }\n  code\n}","old_text":"/// `strata run [PATH] [--trace] [--all-checks] [--no-verify]\n/// [--wait-for-proofs] [--verify-alongside] [--live] [-- ARGS]`: checks the\n/// program\n/// (PATH, else `--file`, else the package here), compiles it with\n/// compiler/codegen without the checks `verify` proved, and runs it in the\n/// JIT in this process, in the current folder, with ARGS. The exit code is\n/// the program's.\n/// \n/// A program changed since it was last verified starts at once with the\n/// checks not proven yet, while it is verified alongside (`run_verifying`,\n/// `start_alongside`). The proven code is swapped in while it runs, and\n/// the next run starts with it.\n/// \n/// `--live`: while it runs, an edit of its files that checks and verifies\n/// is swapped in (`start_live`, `live_edits_command`); no verifier runs\n/// alongside.\nfn run_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n  cwd: String,\n) -> std.process.ExitCode {\n  // `strata run hello.strata`: the program's path in place of --file\n  first := get(line.pos, 1) ?? \"\"\n  named := first != \"\"\n    && (ends_with(first, \".strata\")\n      || disk.exists(driver.absolute_path(cwd, first) + \"/strata.toml\"))\n  path := if named {\n    driver.absolute_path(cwd, first)\n  } else {\n    match target_of(disk, line, cwd) {\n      Ok(f) => f,\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  if !disk.exists(path) {\n    return fail_with(mut console, missing(line, path))\n  }\n  match file_problem(disk, path) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  rest := drop(line.pos, if named {\n    2\n  } else {\n    1\n  })\n  lib := std_library(mut console, mut disk, process, cache)\n  sh := shared(disk, cache)\n  // (a package's settings, each one of its values: `[json] unknown_keys`)\n  match settings_error(disk, path) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  errors := warned(mut console, file_errors(\n    mut launcher,\n    mut disk,\n    cache,\n    \"std\",\n    path,\n    false,\n    sh.core,\n    sh,\n    std_loaded(lib),\n  ))\n  if errors != [] {\n    for e in errors {\n      mut console.eprint(error_text(e))\n    }\n    return 1\n  }\n  if rest != [] {\n    return call_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n      path,\n      lib,\n      rest,\n    )\n  }\n  // the checks the last `verify` proved are left out (`--all-checks` keeps\n  // them all). With `--wait-for-proofs`, what changed is verified first, as\n  // `build` does.\n  verifying := run_verifying(line)\n  facts := if driver.given(line, \"--all-checks\") {\n    []\n  } else {\n    build_proofs(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      lib,\n      path,\n      verifying is WaitForProofs,\n    )\n  }\n  scratch := scratch_of(mut disk, cache, \"run\")\n  proofs := scratch + \"/proofs.txt\"\n  not_covered := scratch + \"/errors.txt\"\n  match mut disk.write(proofs, join(facts, \"\\n\")) {\n    _ => (),\n  }\n  // (`--trace`: std's functions are compiled with the program, so their\n  // calls are traced too; `--memory-sites`: so their sites are counted;\n  // `--regions`: so their values go in statement regions too)\n  traced := driver.given(line, \"--trace\")\n    || driver.given(line, \"--memory-sites\")\n    || driver.given(line, \"--regions\")\n  mut loads := match lib {\n    Some(l) => if traced {\n      []\n    } else {\n      [\"--load\", l.shared]\n    },\n    None => [],\n  }\n  // the package's C (`[native]`), for its `extern c` functions: a shared\n  // library loaded too\n  native := scratch + \"/native.dylib\"\n  match deps.native_library(\n    mut launcher,\n    mut disk,\n    toolchain.c_compiler(process),\n    path,\n    native,\n  ) {\n    Ok(true) => {\n      loads += [\"--load\", native]\n    },\n    Ok(false) => (),\n    Err(e) => {\n      match mut disk.remove_all(scratch) {\n        _ => (),\n      }\n      return fail_with(mut console, e)\n    },\n  }\n  pre := match lib {\n    Some(l) => if traced {\n      []\n    } else {\n      [\"--precompiled\", l.names]\n    },\n    None => [],\n  }\n  trace := if driver.given(line, \"--trace\") {\n    [\"--trace\"]\n  } else {\n    []\n  }\n  // (`--copies`: the copies the program makes are reported when it ends;\n  // `--memory-sites`: its counting operations, by site; `--regions`:\n  // statement regions)\n  copies := [\"--copies\", \"--memory-sites\", \"--regions\"].filter(\n    f -> driver.given(line, f),\n  )\n  // (a program changed since it was last verified: verified alongside, and\n  // compiled swappable)\n  if driver.given(line, \"--live\") {\n    start_live(\n      mut console,\n      mut disk,\n      process,\n      cache,\n      path,\n      cwd,\n      pre + trace + copies + assumed_flag(line),\n    )\n  } else if verifying is VerifyAlongside\n    && !driver.given(line, \"--all-checks\") {\n    start_alongside(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      path,\n      facts,\n      cwd,\n      pre + trace + copies + assumed_flag(line),\n    )\n  }\n  code := jit_file(mut disk, cache, loads\n    + [\n      \"--name\",\n      program_name_of(disk, path),\n      \"--errors\",\n      not_covered,\n      \"--dir\",\n      cwd,\n      \"--scratch\",\n      scratch,\n      \"--proofs\",\n      proofs,\n    ]\n    + pre\n    + trace\n    + copies\n    + assumed_flag(line)\n    + [path, \"--\"]\n    + line.after)\n  // (when the program ran, `jit_file` ended the process with its exit code:\n  // here, it couldn't run)\n  uncovered := match disk.read(not_covered) {\n    Ok(t) => [l for l in lines(t) where starts_with(l, \"error:\")],\n    Err(_) => [],\n  }\n  match mut disk.remove_all(scratch) {\n    _ => (),\n  }\n  if code == 3 && uncovered == [\"error: no `main` function\"] {\n    return fail_with(\n      mut console,\n      \"no `main` function to run (the entry point is `fn main` in main.strata, or in the file you run)\",\n    )\n  }\n  match main_asks(uncovered) {\n    Some(e) => if code == 3 {\n      return fail_with(mut console, e)\n    },\n    None => (),\n  }\n  if code == 3 && uncovered != [] {\n    return fail_with(\n      mut console,\n      \"compiler/codegen doesn't cover this program yet:\\n\"\n        + placed(\n          disk,\n          process,\n          path,\n          uncovered,\n          console.paint(std.term.Errors),\n        ),\n    )\n  }\n  code\n}"},{"name":"repl_eval","kind":"fn","old":"2ae59c72928ea942","new":"869f88cabe95fb4e","interface_changed":false,"affected":[],"module":"","text":"/// Runs the statements `stmts` and the value `e` of one input in the\n/// session (with `run` false, only checks and types them). They go in a\n/// function of their own (`strata_repl`), given the session's values from\n/// compiled memory (`repl_params`) and the REPL's console\n/// (`std.io.ReplConsole`, whose output is shown with the input's result and\n/// written nowhere else). The function is checked against the program and\n/// the session's definitions, compiled by compiler/codegen and run by the\n/// JIT (as `comptime` runs: a fault is caught). Its result stays in compiled\n/// memory.\nfn repl_eval(\n  disk: std.fs.Disk,\n  s: ReplSession,\n  stmts: List[ast.Stmt],\n  e: ast.Expr,\n  run: Bool,\n) -> Result[ReplResult, String] {\n  sh := s.sh\n  core := sh.core\n  names := s.defs.map(d -> desugar.decl_name(d))\n  params := repl_params(s)\n  probe := repl_fn(params, ast.UnitType, ast.Block {\n    stmts: stmts\n      + [\n        ast.Let {\n          pat: ast.Bind(\"strata_value\"),\n          ty: None,\n          value: e,\n        },\n      ],\n    last: ast.UnitExpr,\n  })\n  // (the program's own definitions that the session's replace are left out)\n  as_written := s.written.filter(\n    d -> !(d.module == \"\" && contains(names, desugar.decl_name(d))),\n  )\n  own := s.own.filter(\n    d -> !(d.module == \"\" && contains(names, desugar.decl_name(d))),\n  )\n  made := timings.timed(\"repl: store\", () ->\n    resolve.stored(as_written + s.defs + [probe], s.context, core)).filter(\n    d -> d.module == \"\"\n      && (desugar.decl_name(d) == \"strata_repl\"\n        || contains(names, desugar.decl_name(d))),\n  )\n  errors := timings.timed(\n    \"repl: check\",\n    () -> check_errors_of(own + made, s.context, core, false),\n  ).filter(\n    x -> ends_with(x.0, \"strata_repl\")\n      || names.any(n -> ends_with(x.0, n)),\n  )\n  if errors != [] {\n    return Err(repl_denied(join(errors.map(x -> x.1), \"\\n\")))\n  }\n  program := timings.timed(\n    \"repl: expand\",\n    () -> expanded(disk, sh, own + made).0,\n  )\n  mut found := None\n  for d in timings.timed(\"repl: type\", () -> check.typed(program, core)) {\n    match d.kind {\n      ast.FnDef(f) => if f.name == \"strata_repl\" && d.module == \"\" {\n        found = Some(f.body)\n      },\n      _ => (),\n    }\n  }\n  mut t := None\n  mut all := []\n  match found {\n    Some(ast.Block { stmts: xs, .. }) => {\n      all = xs\n      for x in xs {\n        match x {\n          ast.Let { pat: ast.Bind(\"strata_value\"), ty, .. } => {\n            t = ty\n          },\n          _ => (),\n        }\n      }\n    },\n    _ => (),\n  }\n  ty := match t {\n    Some(x) => x,\n    None => return Err(\"its type isn't known\"),\n  }\n  if !run {\n    return Ok(ReplResult {\n      ty,\n      word: to_i64(0),\n      value: None,\n      printed: \"\",\n      fault: None,\n    })\n  }\n  // the line's function giving its value, called on the session's values\n  line := repl_fn(\n    params,\n    ty,\n    ast.Block { stmts: all, last: ast.Var(\"strata_value\") },\n  )\n  ds := program.map(\n    d -> match d.kind {\n      ast.FnDef(f) => if f.name == \"strata_repl\" && d.module == \"\" {\n        line\n      } else {\n        d\n      },\n      _ => d,\n    },\n  )\n  ir := match timings.timed(\"repl: IR\", () -> codegen.generate(\n    ds,\n    core,\n    sh.prelude,\n    [],\n    None,\n    [],\n    false,\n    [\"session:strata_repl\"],\n    false,\n    [],\n    s.pre,\n    false,\n    None,\n    None,\n    false,\n    false,\n    false,\n  )) {\n    Ok(x) => x,\n    Err(es) => return Err(derive.not_compiled() + join(es, \"; \")),\n  }\n  h := timings.timed(\"repl: JIT load\", () -> jit_fuzz_load(ir))\n  if h.to_int() < 0 {\n    return Err(derive.not_compiled() + jit_fuzz_error())\n  }\n  // (run where the REPL started when it has the real files or process,\n  // which see that folder: compiled in the home)\n  if s.allow != [] {\n    _ := driver_chdir(s.dirs.1)\n  }\n  r := timings.timed(\n    \"repl: run\",\n    () -> jit_call_case(h, 0, repl_budget()).to_int(),\n  )\n  if s.allow != [] {\n    _ := driver_chdir(s.dirs.0)\n  }\n  printed := jit_test_printed()\n  match r {\n    0 => {\n      w := jit_kept()\n      shown := match timings.timed(\"repl: read back\", () -> codegen.read_back(\n        ds,\n        core,\n        sh.prelude,\n        ty,\n        Raw { address: w },\n      )) {\n        Ok(v) => Some(v),\n        Err(_) => None,\n      }\n      Ok(\n        ReplResult {\n          ty,\n          word: w,\n          value: shown,\n          printed,\n          fault: None,\n        },\n      )\n    },\n    1 => Ok(ReplResult {\n      ty,\n      word: to_i64(0),\n      value: None,\n      printed,\n      fault: Some(repl_fault(\n        jit_fault_kind(),\n        jit_fault_message(),\n        jit_fault_stack(),\n      )),\n    }),\n    _ => Err(derive.not_compiled() + \"no call to run\"),\n  }\n}","old_text":"/// Runs the statements `stmts` and the value `e` of one input in the\n/// session (with `run` false, only checks and types them). They go in a\n/// function of their own (`strata_repl`), given the session's values from\n/// compiled memory (`repl_params`) and the REPL's console\n/// (`std.io.ReplConsole`, whose output is shown with the input's result and\n/// written nowhere else). The function is checked against the program and\n/// the session's definitions, compiled by compiler/codegen and run by the\n/// JIT (as `comptime` runs: a fault is caught). Its result stays in compiled\n/// memory.\nfn repl_eval(\n  disk: std.fs.Disk,\n  s: ReplSession,\n  stmts: List[ast.Stmt],\n  e: ast.Expr,\n  run: Bool,\n) -> Result[ReplResult, String] {\n  sh := s.sh\n  core := sh.core\n  names := s.defs.map(d -> desugar.decl_name(d))\n  params := repl_params(s)\n  probe := repl_fn(params, ast.UnitType, ast.Block {\n    stmts: stmts\n      + [\n        ast.Let {\n          pat: ast.Bind(\"strata_value\"),\n          ty: None,\n          value: e,\n        },\n      ],\n    last: ast.UnitExpr,\n  })\n  // (the program's own definitions that the session's replace are left out)\n  as_written := s.written.filter(\n    d -> !(d.module == \"\" && contains(names, desugar.decl_name(d))),\n  )\n  own := s.own.filter(\n    d -> !(d.module == \"\" && contains(names, desugar.decl_name(d))),\n  )\n  made := timings.timed(\"repl: store\", () ->\n    resolve.stored(as_written + s.defs + [probe], s.context, core)).filter(\n    d -> d.module == \"\"\n      && (desugar.decl_name(d) == \"strata_repl\"\n        || contains(names, desugar.decl_name(d))),\n  )\n  errors := timings.timed(\n    \"repl: check\",\n    () -> check_errors_of(own + made, s.context, core, false),\n  ).filter(\n    x -> ends_with(x.0, \"strata_repl\")\n      || names.any(n -> ends_with(x.0, n)),\n  )\n  if errors != [] {\n    return Err(repl_denied(join(errors.map(x -> x.1), \"\\n\")))\n  }\n  program := timings.timed(\n    \"repl: expand\",\n    () -> expanded(disk, sh, own + made).0,\n  )\n  mut found := None\n  for d in timings.timed(\"repl: type\", () -> check.typed(program, core)) {\n    match d.kind {\n      ast.FnDef(f) => if f.name == \"strata_repl\" && d.module == \"\" {\n        found = Some(f.body)\n      },\n      _ => (),\n    }\n  }\n  mut t := None\n  mut all := []\n  match found {\n    Some(ast.Block { stmts: xs, .. }) => {\n      all = xs\n      for x in xs {\n        match x {\n          ast.Let { pat: ast.Bind(\"strata_value\"), ty, .. } => {\n            t = ty\n          },\n          _ => (),\n        }\n      }\n    },\n    _ => (),\n  }\n  ty := match t {\n    Some(x) => x,\n    None => return Err(\"its type isn't known\"),\n  }\n  if !run {\n    return Ok(ReplResult {\n      ty,\n      word: to_i64(0),\n      value: None,\n      printed: \"\",\n      fault: None,\n    })\n  }\n  // the line's function giving its value, called on the session's values\n  line := repl_fn(\n    params,\n    ty,\n    ast.Block { stmts: all, last: ast.Var(\"strata_value\") },\n  )\n  ds := program.map(\n    d -> match d.kind {\n      ast.FnDef(f) => if f.name == \"strata_repl\" && d.module == \"\" {\n        line\n      } else {\n        d\n      },\n      _ => d,\n    },\n  )\n  ir := match timings.timed(\"repl: IR\", () -> codegen.generate(\n    ds,\n    core,\n    sh.prelude,\n    [],\n    None,\n    [],\n    false,\n    [\"session:strata_repl\"],\n    false,\n    [],\n    s.pre,\n    false,\n    None,\n    None,\n    false,\n    false,\n  )) {\n    Ok(x) => x,\n    Err(es) => return Err(derive.not_compiled() + join(es, \"; \")),\n  }\n  h := timings.timed(\"repl: JIT load\", () -> jit_fuzz_load(ir))\n  if h.to_int() < 0 {\n    return Err(derive.not_compiled() + jit_fuzz_error())\n  }\n  // (run where the REPL started when it has the real files or process,\n  // which see that folder: compiled in the home)\n  if s.allow != [] {\n    _ := driver_chdir(s.dirs.1)\n  }\n  r := timings.timed(\n    \"repl: run\",\n    () -> jit_call_case(h, 0, repl_budget()).to_int(),\n  )\n  if s.allow != [] {\n    _ := driver_chdir(s.dirs.0)\n  }\n  printed := jit_test_printed()\n  match r {\n    0 => {\n      w := jit_kept()\n      shown := match timings.timed(\"repl: read back\", () -> codegen.read_back(\n        ds,\n        core,\n        sh.prelude,\n        ty,\n        Raw { address: w },\n      )) {\n        Ok(v) => Some(v),\n        Err(_) => None,\n      }\n      Ok(\n        ReplResult {\n          ty,\n          word: w,\n          value: shown,\n          printed,\n          fault: None,\n        },\n      )\n    },\n    1 => Ok(ReplResult {\n      ty,\n      word: to_i64(0),\n      value: None,\n      printed,\n      fault: Some(repl_fault(\n        jit_fault_kind(),\n        jit_fault_message(),\n        jit_fault_stack(),\n      )),\n    }),\n    _ => Err(derive.not_compiled() + \"no call to run\"),\n  }\n}"}]}
{"id":"b7a802e9b0a31a45","time":1795709021,"message":"edit","changes":[{"name":"tree.use ast","kind":"use","old":null,"new":"08a155780698e59b","interface_changed":true,"affected":[],"module":"tree","text":"// tree: definitions as trees of nodes, compared node by node (`diff`) and\n// merged three ways node by node (`merge-file`).\n\nuse ast"},{"name":"tree.use locate","kind":"use","old":null,"new":"4d00163a7823e1d4","interface_changed":true,"affected":[],"module":"tree","text":"use locate"},{"name":"tree.use text","kind":"use","old":null,"new":"d48c048c27df3cde","interface_changed":true,"affected":[],"module":"tree","text":"from text use decl_text, fn_decl_text, type_text, pattern_text, expr_text"},{"name":"tree.Node","kind":"type","old":null,"new":"1322cbdcff64f5d7","interface_changed":true,"affected":[],"module":"tree","text":"/// A node of a definition: the definition itself, or one of its parts.\n/// Its children are in its slots (`slots`); the rest of it (a name, an\n/// operator, a literal, comments) is its head.\npub type Node =\n  | DN(ast.Decl)\n  | EN(ast.Expr)\n  | SN(ast.Stmt)\n  | PN(ast.Pattern)\n  | TN(ast.TypeExpr)\n  | FnN(ast.FnDecl)\n  | MethodN(ast.TraitMethod)\n  | FieldN(ast.Field)\n  | VariantN(ast.Variant)\n  | ParamN(ast.Param)\n  | LawN(ast.Law)\n  | ArmN(ast.Arm)\n  | ForN(ast.CompFor)\n  | SelectN(ast.SelectArm)\n  | NamedEN((String, ast.Expr))\n  | NamedPN((String, ast.Pattern))\n  | EntryN((ast.Expr, ast.Expr))\n  | PartN(ast.StrPart)\n  | LamN(ast.LamParam)\n  | BoundN(ast.Bound)\n  | ModelN(ast.ModelDecl)\n  | ModelDefN(ast.ModelDef)"},{"name":"tree.Slot","kind":"type","old":null,"new":"4ed25fbcc96d6a81","interface_changed":true,"affected":[],"module":"tree","text":"/// A named place for children: one child (`many` false, with no item when\n/// it is optional and absent) or an ordered list. `of` is the family of\n/// its items (`family`). A child's path is its slot's name, then its index\n/// in a list (a field's name for `NamedEN` and `NamedPN`), as `locate`\n/// names them.\npub type Slot = { name: String, many: Bool, of: Int, items: List[tree.Node] }"},{"name":"tree.Change","kind":"type","old":null,"new":"79c1ec9ab4564b77","interface_changed":true,"affected":[],"module":"tree","text":"/// A difference between two versions of a definition, by path in each:\n/// - `edited`: the node's head changed (an operator, a name, a literal);\n/// its children are compared on their own.\n/// - `replaced`: a node of another form in its place.\n/// - `added`, `removed`: an item of a list or an optional child (`old` or\n/// `new` is `\"\"`).\n/// - `moved`: the same item at another place of its list.\npub type Change = { kind: String, old: String, new: String }"},{"name":"tree.Conflict","kind":"type","old":null,"new":"31e40f9abc3f807f","interface_changed":true,"affected":[],"module":"tree","text":"/// A node changed on both sides differently, left as the hole `name` in\n/// the merge: `?name(ours, base, theirs)`. `path` is where it is in the\n/// merged definition's base.\npub type Conflict = {\n  name: String,\n  path: String,\n  ours: List[tree.Node],\n  base: List[tree.Node],\n  theirs: List[tree.Node],\n}"},{"name":"tree.DeclMerge","kind":"type","old":null,"new":"2db51e67282a6d7c","interface_changed":true,"affected":[],"module":"tree","text":"/// A three-way merge of one definition. `decl` is `None` when a conflict\n/// is outside every expression (a signature, a field), where no hole can\n/// stand.\npub type DeclMerge = { decl: Option[ast.Decl], conflicts: List[tree.Conflict] }"},{"name":"tree.St","kind":"type","old":null,"new":"09143217dc6ab79a","interface_changed":true,"affected":[],"module":"tree","text":"type St = { next: Int, conflicts: List[tree.Conflict] }"},{"name":"tree.family","kind":"fn","old":null,"new":"94436af696df6f46","interface_changed":true,"affected":[],"module":"tree","text":"// ---- the node walk: the only part that knows the tree's forms ----\n\n/// What kind of node it is, as a number: the variant of `Node`.\npub fn family(n: tree.Node) -> Int {\n  match n {\n    tree.DN(_) => 0,\n    tree.EN(_) => 1,\n    tree.SN(_) => 2,\n    tree.PN(_) => 3,\n    tree.TN(_) => 4,\n    tree.FnN(_) => 5,\n    tree.MethodN(_) => 6,\n    tree.FieldN(_) => 7,\n    tree.VariantN(_) => 8,\n    tree.ParamN(_) => 9,\n    tree.LawN(_) => 10,\n    tree.ArmN(_) => 11,\n    tree.ForN(_) => 12,\n    tree.SelectN(_) => 13,\n    tree.NamedEN(_) => 14,\n    tree.NamedPN(_) => 15,\n    tree.EntryN(_) => 16,\n    tree.PartN(_) => 17,\n    tree.LamN(_) => 18,\n    tree.BoundN(_) => 19,\n    tree.ModelN(_) => 20,\n    tree.ModelDefN(_) => 21,\n  }\n}"},{"name":"tree.one","kind":"fn","old":null,"new":"abe143bffe3b9f69","interface_changed":true,"affected":[],"module":"tree","text":"fn one(name: String, n: tree.Node) -> tree.Slot {\n  tree.Slot { name, many: false, of: tree.family(n), items: [n] }\n}"},{"name":"tree.many","kind":"fn","old":null,"new":"2ad0326990922eae","interface_changed":true,"affected":[],"module":"tree","text":"fn many(name: String, of: Int, items: List[tree.Node]) -> tree.Slot {\n  tree.Slot { name, many: true, of, items }\n}"},{"name":"tree.opt_e","kind":"fn","old":null,"new":"e380452d7155c24e","interface_changed":true,"affected":[],"module":"tree","text":"fn opt_e(name: String, x: Option[ast.Expr]) -> tree.Slot {\n  tree.Slot { name, many: false, of: 1, items: match x {\n    Some(e) => [tree.EN(e)],\n    None => [],\n  } }\n}"},{"name":"tree.opt_t","kind":"fn","old":null,"new":"aa9b5e20ee65a41b","interface_changed":true,"affected":[],"module":"tree","text":"fn opt_t(name: String, x: Option[ast.TypeExpr]) -> tree.Slot {\n  tree.Slot { name, many: false, of: 4, items: match x {\n    Some(t) => [tree.TN(t)],\n    None => [],\n  } }\n}"},{"name":"tree.es","kind":"fn","old":null,"new":"38a6c97ffb6bc2c1","interface_changed":true,"affected":[],"module":"tree","text":"fn es(xs: List[ast.Expr]) -> List[tree.Node] {\n  xs.map(x -> tree.EN(x))\n}"},{"name":"tree.ts","kind":"fn","old":null,"new":"f6f4ed5c95b97428","interface_changed":true,"affected":[],"module":"tree","text":"fn ts(xs: List[ast.TypeExpr]) -> List[tree.Node] {\n  xs.map(x -> tree.TN(x))\n}"},{"name":"tree.ps","kind":"fn","old":null,"new":"14e62719636a3ee2","interface_changed":true,"affected":[],"module":"tree","text":"fn ps(xs: List[ast.Pattern]) -> List[tree.Node] {\n  xs.map(x -> tree.PN(x))\n}"},{"name":"tree.slots","kind":"fn","old":null,"new":"10cdfda1a36f4271","interface_changed":true,"affected":[],"module":"tree","text":"/// A node's children, slot by slot, always in the same order for one form.\npub fn slots(n: tree.Node) -> List[tree.Slot] {\n  match n {\n    tree.DN(d) => tree.decl_slots(d),\n    tree.EN(e) => tree.expr_slots(e),\n    tree.SN(s) => tree.stmt_slots(s),\n    tree.PN(p) => tree.pattern_slots(p),\n    tree.TN(t) => tree.type_slots(t),\n    tree.FnN(f) => tree.fn_slots(f),\n    tree.MethodN(m) => tree.fn_slots(m.decl),\n    tree.FieldN(f) => [\n      tree.one(\"ty\", tree.TN(f.ty)),\n      tree.opt_e(\"default\", f.default),\n    ],\n    tree.VariantN(v) => match v.payload {\n      ast.NoPayload => [],\n      ast.Positional(xs) => [tree.many(\"payload\", 4, tree.ts(xs))],\n      ast.RecordPayload(fs) => [tree.many(\"payload\", 7, fs.map(f -> tree.FieldN(f)))],\n      ast.MemberType(t) => [tree.one(\"payload\", tree.TN(t))],\n    },\n    tree.ParamN(p) => [tree.one(\"ty\", tree.TN(p.ty))],\n    tree.LawN(l) => [\n      tree.many(\"params\", 9, l.params.map(p -> tree.ParamN(p))),\n      tree.one(\"body\", tree.EN(l.body)),\n    ],\n    tree.ArmN(a) => [\n      tree.one(\"pat\", tree.PN(a.pat)),\n      tree.one(\"body\", tree.EN(a.body)),\n    ],\n    tree.ForN(c) => [\n      tree.one(\"pat\", tree.PN(c.pat)),\n      tree.one(\"iter\", tree.EN(c.iter)),\n      tree.opt_e(\"cond\", c.cond),\n    ],\n    tree.SelectN(a) => [\n      tree.one(\"op\", tree.EN(a.op)),\n      tree.one(\"body\", tree.EN(a.body)),\n    ],\n    tree.NamedEN(x) => [tree.one(\"value\", tree.EN(x.1))],\n    tree.NamedPN(x) => [tree.one(\"value\", tree.PN(x.1))],\n    tree.EntryN(kv) => [\n      tree.one(\"key\", tree.EN(kv.0)),\n      tree.one(\"value\", tree.EN(kv.1)),\n    ],\n    tree.PartN(p) => match p {\n      ast.ValuePart { value, .. } => [tree.one(\"value\", tree.EN(value))],\n      _ => [],\n    },\n    tree.LamN(p) => [tree.opt_t(\"ty\", p.ty)],\n    tree.BoundN(b) => [tree.many(\"traits\", 4, tree.ts(b.traits))],\n    tree.ModelN(m) => [tree.one(\"ty\", tree.TN(m.ty))],\n    tree.ModelDefN(m) => [tree.one(\"value\", tree.EN(m.value))],\n  }\n}"},{"name":"tree.fn_slots","kind":"fn","old":null,"new":"552cbfd312f26194","interface_changed":true,"affected":[],"module":"tree","text":"fn fn_slots(f: ast.FnDecl) -> List[tree.Slot] {\n  [\n    tree.many(\"bounds\", 19, f.bounds.map(b -> tree.BoundN(b))),\n    tree.many(\"params\", 9, f.params.map(p -> tree.ParamN(p))),\n    tree.one(\"ret\", tree.TN(f.ret)),\n    tree.many(\"pre\", 1, tree.es(f.pre)),\n    tree.many(\"post\", 1, tree.es(f.post)),\n    tree.one(\"body\", tree.EN(f.body)),\n  ]\n}"},{"name":"tree.decl_slots","kind":"fn","old":null,"new":"777f823de24dba18","interface_changed":true,"affected":[],"module":"tree","text":"fn decl_slots(d: ast.Decl) -> List[tree.Slot] {\n  match d.kind {\n    ast.FnDef(f) => tree.fn_slots(f),\n    ast.TestDef(t) => [\n      tree.many(\"params\", 9, t.params.map(p -> tree.ParamN(p))),\n      tree.one(\"body\", tree.EN(t.body)),\n    ],\n    ast.TypeDef(t) => {\n      body := match t.body {\n        ast.Alias(a) => tree.one(\"body\", tree.TN(a)),\n        ast.RecordBody(fs) => tree.many(\"body\", 7, fs.map(f -> tree.FieldN(f))),\n        ast.SumBody(vs) => tree.many(\"body\", 8, vs.map(v -> tree.VariantN(v))),\n      }\n      [body, tree.opt_e(\"refinement\", t.refinement)]\n    },\n    ast.TraitDef(t) => [\n      tree.many(\"supers\", 4, tree.ts(t.supers)),\n      tree.many(\"methods\", 6, t.methods.map(m -> tree.MethodN(m))),\n      tree.many(\"laws\", 10, t.laws.map(l -> tree.LawN(l))),\n      tree.many(\"models\", 20, t.models.map(m -> tree.ModelN(m))),\n      tree.many(\"invariants\", 1, tree.es(t.invariants)),\n      tree.many(\"post\", 1, tree.es(t.post)),\n    ],\n    ast.ImplDef(i) => [\n      tree.many(\"trait_args\", 4, tree.ts(i.trait_args)),\n      tree.one(\"for_type\", tree.TN(i.for_type)),\n      tree.many(\"methods\", 5, i.methods.map(m -> tree.FnN(m))),\n      tree.many(\"models\", 21, i.models.map(m -> tree.ModelDefN(m))),\n    ],\n    ast.ExternDef(x) => match x.item {\n      ast.ExternFn(f) => tree.fn_slots(f),\n      _ => [],\n    },\n    ast.CapabilityDef(c) => [tree.many(\"methods\", 5, c.methods.map(m -> tree.FnN(m)))],\n    _ => [],\n  }\n}"},{"name":"tree.block_items","kind":"fn","old":null,"new":"e1ae433e71f404ed","interface_changed":true,"affected":[],"module":"tree","text":"/// A block's statements and its result are one list, so a statement added\n/// before the result lines up: an expression statement is its expression.\nfn block_items(stmts: List[ast.Stmt], last: ast.Expr) -> List[tree.Node] {\n  stmts.map(\n      s -> match s {\n        ast.ExprStmt(x) => tree.EN(x),\n        _ => tree.SN(s),\n      },\n    )\n    + [tree.EN(last)]\n}"},{"name":"tree.expr_slots","kind":"fn","old":null,"new":"bdad0158ded60691","interface_changed":true,"affected":[],"module":"tree","text":"fn expr_slots(e: ast.Expr) -> List[tree.Slot] {\n  match e {\n    ast.TupleExpr(xs) => [tree.many(\"\", 1, tree.es(xs))],\n    ast.ListExpr(xs) => [tree.many(\"\", 1, tree.es(xs))],\n    ast.CtorExpr { args, .. } => match args {\n      ast.NoArgs => [],\n      ast.PositionalArgs(xs) => [tree.many(\"args\", 1, tree.es(xs))],\n      ast.RecordArgs(fs) => [tree.many(\"args\", 14, fs.map(f -> tree.NamedEN(f)))],\n      ast.UpdateArgs { base, fields } => [\n        tree.one(\"base\", tree.EN(base)),\n        tree.many(\"args\", 14, fields.map(f -> tree.NamedEN(f))),\n      ],\n    },\n    ast.Call { callee, args } => [\n      tree.one(\"callee\", tree.EN(callee)),\n      tree.many(\"args\", 1, tree.es(args)),\n    ],\n    ast.MethodCall { recv, args, .. } => [\n      tree.one(\"recv\", tree.EN(recv)),\n      tree.many(\"args\", 1, tree.es(args)),\n    ],\n    ast.FieldOf { base, .. } => [tree.one(\"base\", tree.EN(base))],\n    ast.Lambda { params, body } => [\n      tree.many(\"params\", 18, params.map(p -> tree.LamN(p))),\n      tree.one(\"body\", tree.EN(body)),\n    ],\n    ast.Binary { left, right, .. } => [\n      tree.one(\"left\", tree.EN(left)),\n      tree.one(\"right\", tree.EN(right)),\n    ],\n    ast.Unary { operand, .. } => [tree.one(\"operand\", tree.EN(operand))],\n    ast.IsExpr { value, .. } => [tree.one(\"value\", tree.EN(value))],\n    ast.IfExpr { cond, then, otherwise } => [\n      tree.one(\"cond\", tree.EN(cond)),\n      tree.one(\"then\", tree.EN(then)),\n      tree.one(\"otherwise\", tree.EN(otherwise)),\n    ],\n    ast.MatchExpr { scrutinee, arms, .. } => [\n      tree.one(\"scrutinee\", tree.EN(scrutinee)),\n      tree.many(\"arms\", 11, arms.map(a -> tree.ArmN(a))),\n    ],\n    ast.MutExpr(x) => [tree.one(\"value\", tree.EN(x))],\n    ast.Block { stmts, last } => [tree.many(\"\", 1, tree.block_items(stmts, last))],\n    ast.MockExpr(t) => [tree.one(\"type\", tree.TN(t))],\n    ast.Return(x) => [tree.one(\"value\", tree.EN(x))],\n    ast.Try { value, .. } => [tree.one(\"value\", tree.EN(value))],\n    ast.Except { value, fallback, .. } => [\n      tree.one(\"value\", tree.EN(value)),\n      tree.one(\"fallback\", tree.EN(fallback)),\n    ],\n    ast.Interp(parts) => [tree.many(\"\", 17, parts.map(p -> tree.PartN(p)))],\n    ast.Range { lo, hi, .. } => [tree.opt_e(\"lo\", lo), tree.opt_e(\"hi\", hi)],\n    ast.Index { base, index } => [\n      tree.one(\"base\", tree.EN(base)),\n      tree.one(\"index\", tree.EN(index)),\n    ],\n    ast.Comp { elem, fors, .. } => [\n      tree.many(\"fors\", 12, fors.map(c -> tree.ForN(c))),\n      tree.one(\"elem\", tree.EN(elem)),\n    ],\n    ast.DictExpr { types, entries } => [\n      tree.many(\"types\", 4, tree.ts(types)),\n      tree.many(\"entries\", 16, entries.map(kv -> tree.EntryN(kv))),\n    ],\n    ast.SetExpr { types, elems } => [\n      tree.many(\"types\", 4, tree.ts(types)),\n      tree.many(\"elems\", 1, tree.es(elems)),\n    ],\n    ast.Fallback { value, fallback } => [\n      tree.one(\"value\", tree.EN(value)),\n      tree.one(\"fallback\", tree.EN(fallback)),\n    ],\n    ast.Comptime(x) => [tree.one(\"value\", tree.EN(x))],\n    ast.Scope(x) => [tree.one(\"value\", tree.EN(x))],\n    ast.Spawn(x) => [tree.one(\"value\", tree.EN(x))],\n    ast.Await(x) => [tree.one(\"value\", tree.EN(x))],\n    ast.SupervisedSpawn(x) => [tree.one(\"value\", tree.EN(x))],\n    ast.Old(x) => [tree.one(\"value\", tree.EN(x))],\n    ast.Assumed(x) => [tree.one(\"value\", tree.EN(x))],\n    ast.Spread(x) => [tree.one(\"value\", tree.EN(x))],\n    ast.Select(arms) => [tree.many(\"\", 13, arms.map(a -> tree.SelectN(a)))],\n    ast.Race(arms) => [tree.many(\"\", 13, arms.map(a -> tree.SelectN(a)))],\n    _ => [],\n  }\n}"},{"name":"tree.stmt_slots","kind":"fn","old":null,"new":"fec45403f12b1414","interface_changed":true,"affected":[],"module":"tree","text":"fn stmt_slots(s: ast.Stmt) -> List[tree.Slot] {\n  match s {\n    ast.Let { pat, ty, value } => [\n      tree.one(\"pat\", tree.PN(pat)),\n      tree.opt_t(\"ty\", ty),\n      tree.one(\"value\", tree.EN(value)),\n    ],\n    ast.VarDecl { ty, value, .. } => [tree.opt_t(\"ty\", ty), tree.one(\"value\", tree.EN(value))],\n    ast.Assign { place, value } => [\n      tree.one(\"place\", tree.EN(place)),\n      tree.one(\"value\", tree.EN(value)),\n    ],\n    ast.While { cond, body } => [\n      tree.one(\"cond\", tree.EN(cond)),\n      tree.one(\"body\", tree.EN(body)),\n    ],\n    ast.For { pat, iter, body } => [\n      tree.one(\"pat\", tree.PN(pat)),\n      tree.one(\"iter\", tree.EN(iter)),\n      tree.one(\"body\", tree.EN(body)),\n    ],\n    ast.ComptimeFor { pat, iter, body } => [\n      tree.one(\"pat\", tree.PN(pat)),\n      tree.one(\"iter\", tree.EN(iter)),\n      tree.one(\"body\", tree.EN(body)),\n    ],\n    ast.Loop(b) => [tree.one(\"body\", tree.EN(b))],\n    ast.ExprStmt(x) => [tree.one(\"value\", tree.EN(x))],\n    ast.Assert(x) => [tree.one(\"value\", tree.EN(x))],\n    ast.Invariant(x) => [tree.one(\"value\", tree.EN(x))],\n    ast.Decreases(x) => [tree.one(\"value\", tree.EN(x))],\n    ast.AssertBy { cond, proof } => [\n      tree.one(\"cond\", tree.EN(cond)),\n      tree.one(\"proof\", tree.EN(proof)),\n    ],\n    ast.Calc(xs) => [tree.many(\"\", 1, tree.es(xs))],\n    _ => [],\n  }\n}"},{"name":"tree.pattern_slots","kind":"fn","old":null,"new":"3a4020ad9879c881","interface_changed":true,"affected":[],"module":"tree","text":"fn pattern_slots(p: ast.Pattern) -> List[tree.Slot] {\n  match p {\n    ast.CtorPattern { args, .. } => match args {\n      ast.NoPats => [],\n      ast.PositionalPats(xs) => [tree.many(\"args\", 3, tree.ps(xs))],\n      ast.TypePats(xs) => [tree.many(\"args\", 3, tree.ps(xs))],\n      ast.RecordPats { fields, .. } => [tree.many(\"args\", 15, fields.map(f -> tree.NamedPN(f)))],\n    },\n    ast.ListPat { items, .. } => [tree.many(\"items\", 3, tree.ps(items))],\n    ast.TuplePat(xs) => [tree.many(\"\", 3, tree.ps(xs))],\n    ast.OrPat(xs) => [tree.many(\"\", 3, tree.ps(xs))],\n    ast.CondPat(c) => [tree.one(\"cond\", tree.EN(c))],\n    ast.ForPat { arm, each, list } => [\n      tree.one(\"arm\", tree.PN(arm)),\n      tree.one(\"each\", tree.PN(each)),\n      tree.one(\"list\", tree.EN(list)),\n    ],\n    _ => [],\n  }\n}"},{"name":"tree.type_slots","kind":"fn","old":null,"new":"00b3f7b8a553a203","interface_changed":true,"affected":[],"module":"tree","text":"fn type_slots(t: ast.TypeExpr) -> List[tree.Slot] {\n  match t {\n    ast.Named { args, .. } => [tree.many(\"args\", 4, tree.ts(args))],\n    ast.FnType { params, ret } => [\n      tree.many(\"params\", 4, tree.ts(params)),\n      tree.one(\"ret\", tree.TN(ret)),\n    ],\n    ast.Refined { base, pred } => [\n      tree.one(\"base\", tree.TN(base)),\n      tree.one(\"pred\", tree.EN(pred)),\n    ],\n    ast.UnionType(xs) => [tree.many(\"\", 4, tree.ts(xs))],\n    ast.UnitType => [],\n  }\n}"},{"name":"tree.at","kind":"fn","old":null,"new":"1b23377c210655f1","interface_changed":true,"affected":[],"module":"tree","text":"// ---- rebuilding a node from its head and children ----\n\nfn at(ks: List[List[tree.Node]], i: Int) -> List[tree.Node] {\n  get(ks, i) ?? []\n}"},{"name":"tree.opt_expr","kind":"fn","old":null,"new":"8179b08367c92359","interface_changed":true,"affected":[],"module":"tree","text":"fn opt_expr(ks: List[List[tree.Node]], i: Int) -> Option[ast.Expr] {\n  match tree.at(ks, i) {\n    [tree.EN(e), ..] => Some(e),\n    _ => None,\n  }\n}"},{"name":"tree.expr1","kind":"fn","old":null,"new":"edbb2456473e0222","interface_changed":true,"affected":[],"module":"tree","text":"fn expr1(ks: List[List[tree.Node]], i: Int) -> ast.Expr {\n  tree.opt_expr(ks, i) ?? ast.UnitExpr\n}"},{"name":"tree.opt_type","kind":"fn","old":null,"new":"52167d8aa7f6c47f","interface_changed":true,"affected":[],"module":"tree","text":"fn opt_type(ks: List[List[tree.Node]], i: Int) -> Option[ast.TypeExpr] {\n  match tree.at(ks, i) {\n    [tree.TN(t), ..] => Some(t),\n    _ => None,\n  }\n}"},{"name":"tree.type1","kind":"fn","old":null,"new":"aaad800c0fcb8250","interface_changed":true,"affected":[],"module":"tree","text":"fn type1(ks: List[List[tree.Node]], i: Int) -> ast.TypeExpr {\n  tree.opt_type(ks, i) ?? ast.UnitType\n}"},{"name":"tree.pat1","kind":"fn","old":null,"new":"423d9d56c6e868b9","interface_changed":true,"affected":[],"module":"tree","text":"fn pat1(ks: List[List[tree.Node]], i: Int) -> ast.Pattern {\n  match tree.at(ks, i) {\n    [tree.PN(p), ..] => p,\n    _ => ast.Wild,\n  }\n}"},{"name":"tree.exprs","kind":"fn","old":null,"new":"eaa0201828fb53ba","interface_changed":true,"affected":[],"module":"tree","text":"fn exprs(ks: List[List[tree.Node]], i: Int) -> List[ast.Expr] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.EN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.types","kind":"fn","old":null,"new":"6b2a9ec3615c41f0","interface_changed":true,"affected":[],"module":"tree","text":"fn types(ks: List[List[tree.Node]], i: Int) -> List[ast.TypeExpr] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.TN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.pats","kind":"fn","old":null,"new":"099d5d1e01893ccd","interface_changed":true,"affected":[],"module":"tree","text":"fn pats(ks: List[List[tree.Node]], i: Int) -> List[ast.Pattern] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.PN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.fields","kind":"fn","old":null,"new":"ce9f2af490cf2ae0","interface_changed":true,"affected":[],"module":"tree","text":"fn fields(ks: List[List[tree.Node]], i: Int) -> List[ast.Field] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.FieldN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.variants","kind":"fn","old":null,"new":"157eeb916a9fc07e","interface_changed":true,"affected":[],"module":"tree","text":"fn variants(ks: List[List[tree.Node]], i: Int) -> List[ast.Variant] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.VariantN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.params","kind":"fn","old":null,"new":"704c555cfc1fab34","interface_changed":true,"affected":[],"module":"tree","text":"fn params(ks: List[List[tree.Node]], i: Int) -> List[ast.Param] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.ParamN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.laws","kind":"fn","old":null,"new":"4318abb36acc7ed0","interface_changed":true,"affected":[],"module":"tree","text":"fn laws(ks: List[List[tree.Node]], i: Int) -> List[ast.Law] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.LawN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.arms","kind":"fn","old":null,"new":"aecac71993605236","interface_changed":true,"affected":[],"module":"tree","text":"fn arms(ks: List[List[tree.Node]], i: Int) -> List[ast.Arm] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.ArmN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.comp_fors","kind":"fn","old":null,"new":"50ad542b09820e12","interface_changed":true,"affected":[],"module":"tree","text":"fn comp_fors(ks: List[List[tree.Node]], i: Int) -> List[ast.CompFor] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.ForN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.select_arms","kind":"fn","old":null,"new":"a9826fed56bec8cb","interface_changed":true,"affected":[],"module":"tree","text":"fn select_arms(ks: List[List[tree.Node]], i: Int) -> List[ast.SelectArm] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.SelectN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.named_exprs","kind":"fn","old":null,"new":"fab3f2a98b481cdd","interface_changed":true,"affected":[],"module":"tree","text":"fn named_exprs(ks: List[List[tree.Node]], i: Int) -> List[(String, ast.Expr)] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.NamedEN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.named_pats","kind":"fn","old":null,"new":"0299b80088e1d4f7","interface_changed":true,"affected":[],"module":"tree","text":"fn named_pats(\n  ks: List[List[tree.Node]],\n  i: Int,\n) -> List[(String, ast.Pattern)] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.NamedPN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.entries","kind":"fn","old":null,"new":"2febb440ab6593bc","interface_changed":true,"affected":[],"module":"tree","text":"fn entries(ks: List[List[tree.Node]], i: Int) -> List[(ast.Expr, ast.Expr)] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.EntryN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.parts","kind":"fn","old":null,"new":"98bb89e675d025e9","interface_changed":true,"affected":[],"module":"tree","text":"fn parts(ks: List[List[tree.Node]], i: Int) -> List[ast.StrPart] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.PartN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.lam_params","kind":"fn","old":null,"new":"3633d0c6b3a3a269","interface_changed":true,"affected":[],"module":"tree","text":"fn lam_params(ks: List[List[tree.Node]], i: Int) -> List[ast.LamParam] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.LamN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.bounds","kind":"fn","old":null,"new":"79c39593586b2357","interface_changed":true,"affected":[],"module":"tree","text":"fn bounds(ks: List[List[tree.Node]], i: Int) -> List[ast.Bound] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.BoundN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.model_decls","kind":"fn","old":null,"new":"72bec5f53cc0de6f","interface_changed":true,"affected":[],"module":"tree","text":"fn model_decls(ks: List[List[tree.Node]], i: Int) -> List[ast.ModelDecl] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.ModelN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.model_defs","kind":"fn","old":null,"new":"9ad56ce82d77df8b","interface_changed":true,"affected":[],"module":"tree","text":"fn model_defs(ks: List[List[tree.Node]], i: Int) -> List[ast.ModelDef] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.ModelDefN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.trait_methods","kind":"fn","old":null,"new":"e1a55125e8440226","interface_changed":true,"affected":[],"module":"tree","text":"fn trait_methods(ks: List[List[tree.Node]], i: Int) -> List[ast.TraitMethod] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.MethodN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.fns","kind":"fn","old":null,"new":"609ea486ce708553","interface_changed":true,"affected":[],"module":"tree","text":"fn fns(ks: List[List[tree.Node]], i: Int) -> List[ast.FnDecl] {\n  mut out := []\n  for n in tree.at(ks, i) {\n    match n {\n      tree.FnN(x) => mut out.push(x),\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"tree.block_of","kind":"fn","old":null,"new":"25e02d9ecdd0202b","interface_changed":true,"affected":[],"module":"tree","text":"/// A block from its items: the last is its result when it is an\n/// expression, the others are statements.\nfn block_of(items: List[tree.Node]) -> ast.Expr {\n  n := len(items)\n  (body, last) := match get(items, n - 1) {\n    Some(tree.EN(e)) => (take(items, n - 1), e),\n    _ => (items, ast.UnitExpr),\n  }\n  mut stmts := []\n  for x in body {\n    match x {\n      tree.EN(e) => mut stmts.push(ast.ExprStmt(e)),\n      tree.SN(s) => mut stmts.push(s),\n      _ => (),\n    }\n  }\n  ast.Block { stmts, last }\n}"},{"name":"tree.rebuilt","kind":"fn","old":null,"new":"6a6411d91985881e","interface_changed":true,"affected":[],"module":"tree","text":"/// `n` with the children of each slot replaced by `ks`, slot by slot (as\n/// `slots(n)` lists them). `rebuilt(n, slots(n).map(s -> s.items)) == n`.\npub fn rebuilt(n: tree.Node, ks: List[List[tree.Node]]) -> tree.Node {\n  match n {\n    tree.DN(d) => tree.DN(ast.Decl { ..d, kind: tree.decl_rebuilt(d.kind, ks) }),\n    tree.EN(e) => tree.EN(tree.expr_rebuilt(e, ks)),\n    tree.SN(s) => tree.SN(tree.stmt_rebuilt(s, ks)),\n    tree.PN(p) => tree.PN(tree.pattern_rebuilt(p, ks)),\n    tree.TN(t) => tree.TN(tree.type_rebuilt(t, ks)),\n    tree.FnN(f) => tree.FnN(tree.fn_rebuilt(f, ks)),\n    tree.MethodN(m) => tree.MethodN(\n      ast.TraitMethod { ..m, decl: tree.fn_rebuilt(m.decl, ks) },\n    ),\n    tree.FieldN(f) => tree.FieldN(\n      ast.Field { ..f, ty: tree.type1(ks, 0), default: tree.opt_expr(ks, 1) },\n    ),\n    tree.VariantN(v) => tree.VariantN(ast.Variant { ..v, payload: match v.payload {\n      ast.NoPayload => ast.NoPayload,\n      ast.Positional(_) => ast.Positional(tree.types(ks, 0)),\n      ast.RecordPayload(_) => ast.RecordPayload(tree.fields(ks, 0)),\n      ast.MemberType(_) => ast.MemberType(tree.type1(ks, 0)),\n    } }),\n    tree.ParamN(p) => tree.ParamN(ast.Param { ..p, ty: tree.type1(ks, 0) }),\n    tree.LawN(l) => tree.LawN(\n      ast.Law { ..l, params: tree.params(ks, 0), body: tree.expr1(ks, 1) },\n    ),\n    tree.ArmN(a) => tree.ArmN(\n      ast.Arm { ..a, pat: tree.pat1(ks, 0), body: tree.expr1(ks, 1) },\n    ),\n    tree.ForN(_) => tree.ForN(ast.CompFor {\n      pat: tree.pat1(ks, 0),\n      iter: tree.expr1(ks, 1),\n      cond: tree.opt_expr(ks, 2),\n    }),\n    tree.SelectN(a) => tree.SelectN(\n      ast.SelectArm { ..a, op: tree.expr1(ks, 0), body: tree.expr1(ks, 1) },\n    ),\n    tree.NamedEN(x) => tree.NamedEN((x.0, tree.expr1(ks, 0))),\n    tree.NamedPN(x) => tree.NamedPN((x.0, tree.pat1(ks, 0))),\n    tree.EntryN(_) => tree.EntryN((tree.expr1(ks, 0), tree.expr1(ks, 1))),\n    tree.PartN(p) => tree.PartN(\n      match p {\n        ast.ValuePart { spec, .. } => ast.ValuePart { value: tree.expr1(ks, 0), spec },\n        other => other,\n      },\n    ),\n    tree.LamN(p) => tree.LamN(ast.LamParam { ..p, ty: tree.opt_type(ks, 0) }),\n    tree.BoundN(b) => tree.BoundN(ast.Bound { ..b, traits: tree.types(ks, 0) }),\n    tree.ModelN(m) => tree.ModelN(ast.ModelDecl { ..m, ty: tree.type1(ks, 0) }),\n    tree.ModelDefN(m) => tree.ModelDefN(ast.ModelDef { ..m, value: tree.expr1(ks, 0) }),\n  }\n}"},{"name":"tree.fn_rebuilt","kind":"fn","old":null,"new":"9a24639a8a1973b2","interface_changed":true,"affected":[],"module":"tree","text":"fn fn_rebuilt(f: ast.FnDecl, ks: List[List[tree.Node]]) -> ast.FnDecl {\n  ast.FnDecl { ..f, bounds: tree.bounds(ks, 0), params: tree.params(ks, 1), ret: tree.type1(ks, 2), pre: tree.exprs(ks, 3), post: tree.exprs(ks, 4), body: tree.expr1(ks, 5) }\n}"},{"name":"tree.decl_rebuilt","kind":"fn","old":null,"new":"cff162edfda9bcbd","interface_changed":true,"affected":[],"module":"tree","text":"fn decl_rebuilt(k: ast.DeclKind, ks: List[List[tree.Node]]) -> ast.DeclKind {\n  match k {\n    ast.FnDef(f) => ast.FnDef(tree.fn_rebuilt(f, ks)),\n    ast.TestDef(t) => ast.TestDef(\n      ast.TestDecl { ..t, params: tree.params(ks, 0), body: tree.expr1(ks, 1) },\n    ),\n    ast.TypeDef(t) => ast.TypeDef(ast.TypeDecl { ..t, body: match t.body {\n      ast.Alias(_) => ast.Alias(tree.type1(ks, 0)),\n      ast.RecordBody(_) => ast.RecordBody(tree.fields(ks, 0)),\n      ast.SumBody(_) => ast.SumBody(tree.variants(ks, 0)),\n    }, refinement: tree.opt_expr(ks, 1) }),\n    ast.TraitDef(t) => ast.TraitDef(\n      ast.TraitDecl { ..t, supers: tree.types(ks, 0), methods: tree.trait_methods(ks, 1), laws: tree.laws(ks, 2), models: tree.model_decls(ks, 3), invariants: tree.exprs(ks, 4), post: tree.exprs(ks, 5) },\n    ),\n    ast.ImplDef(i) => ast.ImplDef(\n      ast.ImplDecl { ..i, trait_args: tree.types(ks, 0), for_type: tree.type1(ks, 1), methods: tree.fns(ks, 2), models: tree.model_defs(ks, 3) },\n    ),\n    ast.ExternDef(x) => match x.item {\n      ast.ExternFn(f) => ast.ExternDef(\n        ast.ExternDecl { ..x, item: ast.ExternFn(tree.fn_rebuilt(f, ks)) },\n      ),\n      _ => k,\n    },\n    ast.CapabilityDef(c) => ast.CapabilityDef(\n      ast.CapabilityDecl { ..c, methods: tree.fns(ks, 0) },\n    ),\n    other => other,\n  }\n}"},{"name":"tree.expr_rebuilt","kind":"fn","old":null,"new":"c40139a6afee2646","interface_changed":true,"affected":[],"module":"tree","text":"fn expr_rebuilt(e: ast.Expr, ks: List[List[tree.Node]]) -> ast.Expr {\n  match e {\n    ast.TupleExpr(_) => ast.TupleExpr(tree.exprs(ks, 0)),\n    ast.ListExpr(_) => ast.ListExpr(tree.exprs(ks, 0)),\n    ast.CtorExpr { name, args } => ast.CtorExpr { name, args: match args {\n      ast.NoArgs => ast.NoArgs,\n      ast.PositionalArgs(_) => ast.PositionalArgs(tree.exprs(ks, 0)),\n      ast.RecordArgs(_) => ast.RecordArgs(tree.named_exprs(ks, 0)),\n      ast.UpdateArgs { .. } => ast.UpdateArgs {\n        base: tree.expr1(ks, 0),\n        fields: tree.named_exprs(ks, 1),\n      },\n    } },\n    ast.Call { .. } => ast.Call { callee: tree.expr1(ks, 0), args: tree.exprs(ks, 1) },\n    ast.MethodCall { name, .. } => ast.MethodCall {\n      recv: tree.expr1(ks, 0),\n      name,\n      args: tree.exprs(ks, 1),\n    },\n    ast.FieldOf { name, .. } => ast.FieldOf { base: tree.expr1(ks, 0), name },\n    ast.Lambda { .. } => ast.Lambda {\n      params: tree.lam_params(ks, 0),\n      body: tree.expr1(ks, 1),\n    },\n    ast.Binary { op, .. } => ast.Binary {\n      op,\n      left: tree.expr1(ks, 0),\n      right: tree.expr1(ks, 1),\n    },\n    ast.Unary { op, .. } => ast.Unary { op, operand: tree.expr1(ks, 0) },\n    ast.IsExpr { variant, .. } => ast.IsExpr { value: tree.expr1(ks, 0), variant },\n    ast.IfExpr { .. } => ast.IfExpr {\n      cond: tree.expr1(ks, 0),\n      then: tree.expr1(ks, 1),\n      otherwise: tree.expr1(ks, 2),\n    },\n    ast.MatchExpr { binding, .. } => ast.MatchExpr {\n      scrutinee: tree.expr1(ks, 0),\n      binding,\n      arms: tree.arms(ks, 1),\n    },\n    ast.MutExpr(_) => ast.MutExpr(tree.expr1(ks, 0)),\n    ast.Block { .. } => tree.block_of(tree.at(ks, 0)),\n    ast.MockExpr(_) => ast.MockExpr(tree.type1(ks, 0)),\n    ast.Return(_) => ast.Return(tree.expr1(ks, 0)),\n    ast.Try { kind, .. } => ast.Try { value: tree.expr1(ks, 0), kind },\n    ast.Except { err, .. } => ast.Except {\n      value: tree.expr1(ks, 0),\n      err,\n      fallback: tree.expr1(ks, 1),\n    },\n    ast.Interp(_) => ast.Interp(tree.parts(ks, 0)),\n    ast.Range { inclusive, .. } => ast.Range {\n      lo: tree.opt_expr(ks, 0),\n      hi: tree.opt_expr(ks, 1),\n      inclusive,\n    },\n    ast.Index { .. } => ast.Index { base: tree.expr1(ks, 0), index: tree.expr1(ks, 1) },\n    ast.Comp { kind, .. } => ast.Comp {\n      kind,\n      elem: tree.expr1(ks, 1),\n      fors: tree.comp_fors(ks, 0),\n    },\n    ast.DictExpr { .. } => ast.DictExpr {\n      types: tree.types(ks, 0),\n      entries: tree.entries(ks, 1),\n    },\n    ast.SetExpr { .. } => ast.SetExpr {\n      types: tree.types(ks, 0),\n      elems: tree.exprs(ks, 1),\n    },\n    ast.Fallback { .. } => ast.Fallback {\n      value: tree.expr1(ks, 0),\n      fallback: tree.expr1(ks, 1),\n    },\n    ast.Comptime(_) => ast.Comptime(tree.expr1(ks, 0)),\n    ast.Scope(_) => ast.Scope(tree.expr1(ks, 0)),\n    ast.Spawn(_) => ast.Spawn(tree.expr1(ks, 0)),\n    ast.Await(_) => ast.Await(tree.expr1(ks, 0)),\n    ast.SupervisedSpawn(_) => ast.SupervisedSpawn(tree.expr1(ks, 0)),\n    ast.Old(_) => ast.Old(tree.expr1(ks, 0)),\n    ast.Assumed(_) => ast.Assumed(tree.expr1(ks, 0)),\n    ast.Spread(_) => ast.Spread(tree.expr1(ks, 0)),\n    ast.Select(_) => ast.Select(tree.select_arms(ks, 0)),\n    ast.Race(_) => ast.Race(tree.select_arms(ks, 0)),\n    other => other,\n  }\n}"},{"name":"tree.stmt_rebuilt","kind":"fn","old":null,"new":"52c6e15ed16f05f9","interface_changed":true,"affected":[],"module":"tree","text":"fn stmt_rebuilt(s: ast.Stmt, ks: List[List[tree.Node]]) -> ast.Stmt {\n  match s {\n    ast.Let { .. } => ast.Let {\n      pat: tree.pat1(ks, 0),\n      ty: tree.opt_type(ks, 1),\n      value: tree.expr1(ks, 2),\n    },\n    ast.VarDecl { name, .. } => ast.VarDecl {\n      name,\n      ty: tree.opt_type(ks, 0),\n      value: tree.expr1(ks, 1),\n    },\n    ast.Assign { .. } => ast.Assign {\n      place: tree.expr1(ks, 0),\n      value: tree.expr1(ks, 1),\n    },\n    ast.While { .. } => ast.While { cond: tree.expr1(ks, 0), body: tree.expr1(ks, 1) },\n    ast.For { .. } => ast.For {\n      pat: tree.pat1(ks, 0),\n      iter: tree.expr1(ks, 1),\n      body: tree.expr1(ks, 2),\n    },\n    ast.ComptimeFor { .. } => ast.ComptimeFor {\n      pat: tree.pat1(ks, 0),\n      iter: tree.expr1(ks, 1),\n      body: tree.expr1(ks, 2),\n    },\n    ast.Loop(_) => ast.Loop(tree.expr1(ks, 0)),\n    ast.ExprStmt(_) => ast.ExprStmt(tree.expr1(ks, 0)),\n    ast.Assert(_) => ast.Assert(tree.expr1(ks, 0)),\n    ast.Invariant(_) => ast.Invariant(tree.expr1(ks, 0)),\n    ast.Decreases(_) => ast.Decreases(tree.expr1(ks, 0)),\n    ast.AssertBy { .. } => ast.AssertBy {\n      cond: tree.expr1(ks, 0),\n      proof: tree.expr1(ks, 1),\n    },\n    ast.Calc(_) => ast.Calc(tree.exprs(ks, 0)),\n    other => other,\n  }\n}"},{"name":"tree.pattern_rebuilt","kind":"fn","old":null,"new":"b9920fa53e10872b","interface_changed":true,"affected":[],"module":"tree","text":"fn pattern_rebuilt(p: ast.Pattern, ks: List[List[tree.Node]]) -> ast.Pattern {\n  match p {\n    ast.CtorPattern { name, args } => ast.CtorPattern {\n      name,\n      args: match args {\n        ast.NoPats => ast.NoPats,\n        ast.PositionalPats(_) => ast.PositionalPats(tree.pats(ks, 0)),\n        ast.TypePats(_) => ast.TypePats(tree.pats(ks, 0)),\n        ast.RecordPats { rest, .. } => ast.RecordPats { fields: tree.named_pats(ks, 0), rest },\n      },\n    },\n    ast.ListPat { rest, .. } => ast.ListPat { items: tree.pats(ks, 0), rest },\n    ast.TuplePat(_) => ast.TuplePat(tree.pats(ks, 0)),\n    ast.OrPat(_) => ast.OrPat(tree.pats(ks, 0)),\n    ast.CondPat(_) => ast.CondPat(tree.expr1(ks, 0)),\n    ast.ForPat { .. } => ast.ForPat {\n      arm: tree.pat1(ks, 0),\n      each: tree.pat1(ks, 1),\n      list: tree.expr1(ks, 2),\n    },\n    other => other,\n  }\n}"},{"name":"tree.type_rebuilt","kind":"fn","old":null,"new":"a6f3a334599745d1","interface_changed":true,"affected":[],"module":"tree","text":"fn type_rebuilt(t: ast.TypeExpr, ks: List[List[tree.Node]]) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, .. } => ast.Named { name, args: tree.types(ks, 0) },\n    ast.FnType { .. } => ast.FnType { params: tree.types(ks, 0), ret: tree.type1(ks, 1) },\n    ast.Refined { .. } => ast.Refined { base: tree.type1(ks, 0), pred: tree.expr1(ks, 1) },\n    ast.UnionType(_) => ast.UnionType(tree.types(ks, 0)),\n    ast.UnitType => ast.UnitType,\n  }\n}"},{"name":"tree.head","kind":"fn","old":null,"new":"28f515e043fbd2ea","interface_changed":true,"affected":[],"module":"tree","text":"// ---- generic: everything below works through `slots` and `rebuilt` ----\n\n/// The node without its children: what `edited` compares.\nfn head(n: tree.Node, ss: List[tree.Slot]) -> tree.Node {\n  tree.rebuilt(n, ss.map(_ -> []))\n}"},{"name":"tree.same_form","kind":"fn","old":null,"new":"7c09480674270f70","interface_changed":true,"affected":[],"module":"tree","text":"/// Two nodes of the same form: the same family, the same slots.\nfn same_form(\n  a: tree.Node,\n  sa: List[tree.Slot],\n  b: tree.Node,\n  sb: List[tree.Slot],\n) -> Bool {\n  tree.family(a) == tree.family(b)\n    && len(sa) == len(sb)\n    && zip(sa, sb).all(\n      p -> p.0.name == p.1.name\n        && p.0.many == p.1.many\n        && p.0.of == p.1.of,\n    )\n}"},{"name":"tree.joined","kind":"fn","old":null,"new":"ce2d4d3ce8a457bd","interface_changed":true,"affected":[],"module":"tree","text":"fn joined(path: String, step: String) -> String {\n  if path == \"\" {\n    step\n  } else if step == \"\" {\n    path\n  } else {\n    path + \"/\" + step\n  }\n}"},{"name":"tree.item_path","kind":"fn","old":null,"new":"d6cee9d461f96756","interface_changed":true,"affected":[],"module":"tree","text":"/// The path of item `i` of slot `s` under `path`.\nfn item_path(path: String, s: tree.Slot, i: Int, n: tree.Node) -> String {\n  if !s.many {\n    return tree.joined(path, s.name)\n  }\n  key := match n {\n    tree.NamedEN(x) => x.0,\n    tree.NamedPN(x) => x.0,\n    _ => to_string(i),\n  }\n  tree.joined(tree.joined(path, s.name), key)\n}"},{"name":"tree.matched","kind":"fn","old":null,"new":"f588a903a47b094d","interface_changed":true,"affected":[],"module":"tree","text":"/// Lines `a` up with `b`: for each index of `a`, the index of the equal\n/// item of `b` it is paired with, or -1. The longest common subsequence,\n/// after the common start and end, which cost one comparison per item.\n/// O(len(a) * len(b)) comparisons for the rest.\npub fn matched(a: List[tree.Node], b: List[tree.Node]) -> List[Int] {\n  n := len(a)\n  m := len(b)\n  mut out := [-1 for _ in 0..n]\n  mut s := 0\n  while s < n && s < m && get(a, s) == get(b, s) {\n    out[s] = s\n    s += 1\n  }\n  mut e := 0\n  while e < n - s && e < m - s && get(a, n - 1 - e) == get(b, m - 1 - e) {\n    out[n - 1 - e] = m - 1 - e\n    e += 1\n  }\n  // the middle: a[s..n-e] against b[s..m-e]\n  ra := n - e - s\n  rb := m - e - s\n  if ra == 0 || rb == 0 {\n    return out\n  }\n  // rows[i][j]: the longest common subsequence of a[s+i..] and b[s+j..]\n  mut rows := [[0 for _ in 0..rb + 1] for _ in 0..ra + 1]\n  mut i := ra - 1\n  while i >= 0 {\n    mut j := rb - 1\n    while j >= 0 {\n      v := if get(a, s + i) == get(b, s + j) {\n        (get(get(rows, i + 1) ?? [], j + 1) ?? 0) + 1\n      } else {\n        max(\n          get(get(rows, i + 1) ?? [], j) ?? 0,\n          get(get(rows, i) ?? [], j + 1) ?? 0,\n        )\n      }\n      rows[i][j] = v\n      j -= 1\n    }\n    i -= 1\n  }\n  mut x := 0\n  mut y := 0\n  while x < ra && y < rb {\n    if get(a, s + x) == get(b, s + y) {\n      out[s + x] = s + y\n      x += 1\n      y += 1\n    } else if get(get(rows, x + 1) ?? [], y) ?? 0 >= get(get(rows, x) ?? [], y + 1) ?? 0 {\n      x += 1\n    } else {\n      y += 1\n    }\n  }\n  out\n}"},{"name":"tree.changes","kind":"fn","old":null,"new":"7b851c421e7d7bc7","interface_changed":true,"affected":[],"module":"tree","text":"// ---- diff ----\n\n/// How `b` differs from `a`, node by node, outermost first. Equal subtrees\n/// are skipped with one comparison; a list is lined up by its equal items\n/// (`matched`), and the items left between two equal ones are compared in\n/// order when they have the same form.\npub fn changes(a: ast.Decl, b: ast.Decl) -> List[tree.Change] {\n  mut out := []\n  tree.walk_diff(mut out, tree.DN(a), tree.DN(b), \"\", \"\")\n  out\n}"},{"name":"tree.walk_diff","kind":"fn","old":null,"new":"14d767eb5d892c90","interface_changed":true,"affected":[],"module":"tree","text":"fn walk_diff(\n  mut out: List[tree.Change],\n  a: tree.Node,\n  b: tree.Node,\n  pa: String,\n  pb: String,\n) {\n  if a == b {\n    return\n  }\n  sa := tree.slots(a)\n  sb := tree.slots(b)\n  if !tree.same_form(a, sa, b, sb) {\n    mut out.push(tree.Change { kind: \"replaced\", old: pa, new: pb })\n    return\n  }\n  if tree.head(a, sa) != tree.head(b, sb) {\n    mut out.push(tree.Change { kind: \"edited\", old: pa, new: pb })\n  }\n  for (k, s) in enumerate(sa) {\n    t := get(sb, k) ?? s\n    tree.diff_items(mut out, s, t, pa, pb)\n  }\n}"},{"name":"tree.diff_items","kind":"fn","old":null,"new":"82df43004f131d07","interface_changed":true,"affected":[],"module":"tree","text":"fn diff_items(\n  mut out: List[tree.Change],\n  s: tree.Slot,\n  t: tree.Slot,\n  pa: String,\n  pb: String,\n) {\n  xs := s.items\n  ys := t.items\n  if xs == ys {\n    return\n  }\n  m := tree.matched(xs, ys)\n  used_b := set([j for j in m where j >= 0])\n  // the items of each side that no equal item pairs\n  gone := [i for (i, j) in enumerate(m) where j < 0]\n  came := [j for j in 0..len(ys) where !contains(used_b, j)]\n  // the same item elsewhere in the list: moved\n  mut moved_a := Set[Int] {}\n  mut moved_b := Set[Int] {}\n  for i in gone {\n    x := get(xs, i) ?? tree.DN(tree.empty_decl())\n    match came.find(j -> !contains(moved_b, j) && get(ys, j) == Some(x)) {\n      Some(j) => {\n        mut moved_a.insert(i)\n        mut moved_b.insert(j)\n        mut out.push(\n          tree.Change {\n            kind: \"moved\",\n            old: tree.item_path(pa, s, i, x),\n            new: tree.item_path(pb, t, j, x),\n          },\n        )\n      },\n      None => (),\n    }\n  }\n  // what is left between two paired items is compared in order\n  mut i := 0\n  mut j := 0\n  while i < len(xs) || j < len(ys) {\n    if i < len(xs) && get(m, i) ?? -1 >= 0 {\n      // a paired item: the other side's items before its partner were added\n      partner := get(m, i) ?? 0\n      while j < partner {\n        if !contains(moved_b, j) {\n          y := get(ys, j) ?? tree.DN(tree.empty_decl())\n          mut out.push(\n            tree.Change {\n              kind: \"added\",\n              old: \"\",\n              new: tree.item_path(pb, t, j, y),\n            },\n          )\n        }\n        j += 1\n      }\n      i += 1\n      j = partner + 1\n      continue\n    }\n    // a gap: the unpaired items of each side up to the next pair\n    mut dels := []\n    while i < len(xs) && get(m, i) ?? -1 < 0 {\n      if !contains(moved_a, i) {\n        mut dels.push(i)\n      }\n      i += 1\n    }\n    stop := if i < len(xs) {\n      get(m, i) ?? len(ys)\n    } else {\n      len(ys)\n    }\n    mut adds := []\n    while j < stop {\n      if !contains(moved_b, j) {\n        mut adds.push(j)\n      }\n      j += 1\n    }\n    for (k, di) in enumerate(dels) {\n      x := get(xs, di) ?? tree.DN(tree.empty_decl())\n      match get(adds, k) {\n        Some(aj) => {\n          y := get(ys, aj) ?? x\n          if tree.same_form(x, tree.slots(x), y, tree.slots(y)) {\n            tree.walk_diff(\n              mut out,\n              x,\n              y,\n              tree.item_path(pa, s, di, x),\n              tree.item_path(pb, t, aj, y),\n            )\n          } else {\n            mut out.push(\n              tree.Change {\n                kind: \"replaced\",\n                old: tree.item_path(pa, s, di, x),\n                new: tree.item_path(pb, t, aj, y),\n              },\n            )\n          }\n        },\n        None => mut out.push(\n          tree.Change {\n            kind: \"removed\",\n            old: tree.item_path(pa, s, di, x),\n            new: \"\",\n          },\n        ),\n      }\n    }\n    for (k, aj) in enumerate(adds) {\n      if k >= len(dels) {\n        y := get(ys, aj) ?? tree.DN(tree.empty_decl())\n        mut out.push(\n          tree.Change {\n            kind: \"added\",\n            old: \"\",\n            new: tree.item_path(pb, t, aj, y),\n          },\n        )\n      }\n    }\n  }\n}"},{"name":"tree.empty_decl","kind":"fn","old":null,"new":"043bcaddd7b091cb","interface_changed":true,"affected":[],"module":"tree","text":"fn empty_decl() -> ast.Decl {\n  ast.Decl {\n    comments: [],\n    doc: [],\n    module: \"\",\n    public: false,\n    kind: ast.UseDef(ast.UseDecl { path: \"\", alias: None, items: None }),\n  }\n}"},{"name":"tree.merge","kind":"fn","old":null,"new":"d43c348b40715c4a","interface_changed":true,"affected":[],"module":"tree","text":"// ---- three-way merge ----\n\n/// Merges `ours` and `theirs`, both changed from `base`, node by node: a\n/// node changed on one side only is taken from that side, and one changed\n/// on both sides differently is merged by its children when it kept its\n/// form, else it is a conflict. A conflict inside an expression or a\n/// block becomes the hole `?conflict_N(ours, base, theirs)` (numbered from\n/// `first`); one elsewhere makes the whole definition a conflict\n/// (`decl: None`).\npub fn merge(\n  base: ast.Decl,\n  ours: ast.Decl,\n  theirs: ast.Decl,\n  first: Int,\n) -> tree.DeclMerge {\n  mut st := tree.St { next: first, conflicts: [] }\n  r := tree.merge_node(\n    mut st,\n    tree.DN(base),\n    tree.DN(ours),\n    tree.DN(theirs),\n    \"\",\n  )\n  match r {\n    Some(tree.DN(d)) => tree.DeclMerge { decl: Some(d), conflicts: st.conflicts },\n    _ => tree.DeclMerge { decl: None, conflicts: st.conflicts },\n  }\n}"},{"name":"tree.merge_node","kind":"fn","old":null,"new":"2a1cb14b0f30a097","interface_changed":true,"affected":[],"module":"tree","text":"fn merge_node(\n  mut st: tree.St,\n  o: tree.Node,\n  a: tree.Node,\n  b: tree.Node,\n  path: String,\n) -> Option[tree.Node] {\n  if a == b || o == b {\n    return Some(a)\n  }\n  if o == a {\n    return Some(b)\n  }\n  so := tree.slots(o)\n  sa := tree.slots(a)\n  sb := tree.slots(b)\n  if tree.same_form(o, so, a, sa) && tree.same_form(o, so, b, sb) {\n    ho := tree.head(o, so)\n    ha := tree.head(a, sa)\n    hb := tree.head(b, sb)\n    // the side whose head is kept: the one that changed it, if only one did\n    keep := if ha == ho {\n      Some(b)\n    } else if hb == ho || ha == hb {\n      Some(a)\n    } else {\n      None\n    }\n    match keep {\n      Some(k) => {\n        saved := st\n        mut ks := []\n        mut ok := true\n        for (i, s) in enumerate(so) {\n          ta := get(sa, i) ?? s\n          tb := get(sb, i) ?? s\n          match tree.merge_items(\n            mut st,\n            s,\n            s.items,\n            ta.items,\n            tb.items,\n            path,\n          ) {\n            Some(xs) => mut ks.push(xs),\n            None => {\n              ok = false\n            },\n          }\n          if !ok {\n            break\n          }\n        }\n        if ok {\n          return Some(tree.rebuilt(k, ks))\n        }\n        st = saved\n      },\n      None => (),\n    }\n  }\n  if tree.holds_hole(o) && tree.holds_hole(a) && tree.holds_hole(b) {\n    Some(tree.hole(mut st, path, [a], [o], [b]))\n  } else {\n    None\n  }\n}"},{"name":"tree.holds_hole","kind":"fn","old":null,"new":"bf580502091746c8","interface_changed":true,"affected":[],"module":"tree","text":"/// Whether a hole (an expression) can stand where `n` is: an expression,\n/// or a statement of a block.\nfn holds_hole(n: tree.Node) -> Bool {\n  tree.family(n) == 1 || tree.family(n) == 2\n}"},{"name":"tree.hole","kind":"fn","old":null,"new":"a1b9059cc725ecf3","interface_changed":true,"affected":[],"module":"tree","text":"fn hole(\n  mut st: tree.St,\n  path: String,\n  ours: List[tree.Node],\n  base: List[tree.Node],\n  theirs: List[tree.Node],\n) -> tree.Node {\n  name := \"conflict_\" + to_string(st.next)\n  st = tree.St {\n    next: st.next + 1,\n    conflicts: st.conflicts\n      + [tree.Conflict { name, path, ours, base, theirs }],\n  }\n  tree.EN(ast.Call {\n    callee: ast.Hole(name),\n    args: [tree.side(ours), tree.side(base), tree.side(theirs)],\n  })\n}"},{"name":"tree.side","kind":"fn","old":null,"new":"65da4730bcdb7a51","interface_changed":true,"affected":[],"module":"tree","text":"/// One side of a conflict as an expression: the expression, `()` for\n/// nothing, else a block of the statements.\nfn side(items: List[tree.Node]) -> ast.Expr {\n  match items {\n    [tree.EN(e)] => e,\n    [] => ast.UnitExpr,\n    _ => tree.block_of(items),\n  }\n}"},{"name":"tree.merge_items","kind":"fn","old":null,"new":"0f9316c389d9a6e6","interface_changed":true,"affected":[],"module":"tree","text":"/// Merges one slot's items: three-way, by the base's items that both sides\n/// kept (`matched`). Between two such, a run changed on one side only is\n/// taken from it; changed on both, it is merged item by item when the\n/// three runs are as long, else it is a conflict.\nfn merge_items(\n  mut st: tree.St,\n  s: tree.Slot,\n  xo: List[tree.Node],\n  xa: List[tree.Node],\n  xb: List[tree.Node],\n  path: String,\n) -> Option[List[tree.Node]] {\n  if xa == xb || xo == xb {\n    return Some(xa)\n  }\n  if xo == xa {\n    return Some(xb)\n  }\n  ma := tree.matched(xo, xa)\n  mb := tree.matched(xo, xb)\n  mut out := []\n  mut po := 0\n  mut pa := 0\n  mut pb := 0\n  n := len(xo)\n  mut k := 0\n  while k <= n {\n    ia := if k == n {\n      len(xa)\n    } else {\n      get(ma, k) ?? -1\n    }\n    ib := if k == n {\n      len(xb)\n    } else {\n      get(mb, k) ?? -1\n    }\n    if ia >= 0 && ib >= 0 {\n      oc := slice(xo, po, k)\n      ac := slice(xa, pa, ia)\n      bc := slice(xb, pb, ib)\n      match tree.merge_run(mut st, s, oc, ac, bc, path, po) {\n        Some(xs) => {\n          out += xs\n        },\n        None => return None,\n      }\n      if k < n {\n        match get(xo, k) {\n          Some(x) => mut out.push(x),\n          None => (),\n        }\n      }\n      po = k + 1\n      pa = ia + 1\n      pb = ib + 1\n    }\n    k += 1\n  }\n  Some(out)\n}"},{"name":"tree.merge_run","kind":"fn","old":null,"new":"4f798153a3f30199","interface_changed":true,"affected":[],"module":"tree","text":"fn merge_run(\n  mut st: tree.St,\n  s: tree.Slot,\n  oc: List[tree.Node],\n  ac: List[tree.Node],\n  bc: List[tree.Node],\n  path: String,\n  start: Int,\n) -> Option[List[tree.Node]] {\n  if ac == bc || oc == bc {\n    return Some(ac)\n  }\n  if oc == ac {\n    return Some(bc)\n  }\n  if len(oc) == len(ac) && len(oc) == len(bc) {\n    saved := st\n    mut xs := []\n    mut ok := true\n    for (i, x) in enumerate(oc) {\n      y := get(ac, i) ?? x\n      z := get(bc, i) ?? x\n      match tree.merge_node(\n        mut st,\n        x,\n        y,\n        z,\n        tree.item_path(path, s, start + i, x),\n      ) {\n        Some(r) => mut xs.push(r),\n        None => {\n          ok = false\n        },\n      }\n      if !ok {\n        break\n      }\n    }\n    if ok {\n      return Some(xs)\n    }\n    st = saved\n  }\n  // a run in conflict: one hole for it, in a block or a list of expressions\n  all := oc + ac + bc\n  if s.of == 1 && all.all(x -> tree.holds_hole(x)) {\n    at_path := if s.many {\n      tree.joined(tree.joined(path, s.name), to_string(start))\n    } else {\n      tree.joined(path, s.name)\n    }\n    Some([tree.hole(mut st, at_path, ac, oc, bc)])\n  } else {\n    None\n  }\n}"},{"name":"tree.node_text","kind":"fn","old":null,"new":"7c75c9a0ce5ca20d","interface_changed":true,"affected":[],"module":"tree","text":"// ---- shown ----\n\n/// A node as code, at depth 1.\npub fn node_text(n: tree.Node) -> String {\n  match n {\n    tree.DN(d) => text.decl_text(d),\n    tree.EN(e) => locate.node_text(locate.ENode(e), 1),\n    tree.SN(s) => locate.node_text(locate.SNode(s), 1),\n    tree.PN(p) => text.pattern_text(p),\n    tree.TN(t) => text.type_text(t),\n    tree.FnN(f) => text.fn_decl_text(f),\n    tree.MethodN(m) => text.fn_decl_text(m.decl),\n    tree.FieldN(f) => f.name + \": \" + text.type_text(f.ty),\n    tree.VariantN(v) => v.name,\n    tree.ParamN(p) => p.name + \": \" + text.type_text(p.ty),\n    tree.LawN(l) => \"law \" + l.name,\n    tree.ArmN(a) => text.pattern_text(a.pat) + \" => \" + text.expr_text(a.body, 1),\n    tree.ForN(c) => \"for \"\n      + text.pattern_text(c.pat)\n      + \" in \"\n      + text.expr_text(c.iter, 1),\n    tree.SelectN(a) => text.expr_text(a.op, 1),\n    tree.NamedEN(x) => x.0 + \": \" + text.expr_text(x.1, 1),\n    tree.NamedPN(x) => x.0 + \": \" + text.pattern_text(x.1),\n    tree.EntryN(kv) => text.expr_text(kv.0, 1) + \": \" + text.expr_text(kv.1, 1),\n    tree.PartN(p) => match p {\n      ast.ValuePart { value, .. } => \"{\" + text.expr_text(value, 1) + \"}\",\n      ast.TextPart(t) => t,\n    },\n    tree.LamN(p) => p.name,\n    tree.BoundN(b) => b.param,\n    tree.ModelN(m) => \"model \" + m.name,\n    tree.ModelDefN(m) => \"model \" + m.name,\n  }\n}"},{"name":"tree.node_at","kind":"fn","old":null,"new":"daeba2b0ee24d39f","interface_changed":true,"affected":[],"module":"tree","text":"/// The node at `path` of a definition, by the paths `changes` gives.\npub fn node_at(d: ast.Decl, path: String) -> Option[tree.Node] {\n  mut n := tree.DN(d)\n  if path == \"\" {\n    return Some(n)\n  }\n  mut rest := path\n  while rest != \"\" {\n    mut found := false\n    for s in tree.slots(n) {\n      for (i, x) in enumerate(s.items) {\n        p := tree.item_path(\"\", s, i, x)\n        if !found\n          && (rest == p || starts_with(rest, p + \"/\"))\n          && (p != \"\" || !s.many) {\n          n = x\n          rest = if rest == p {\n            \"\"\n          } else {\n            byte_slice(rest, byte_len(p) + 1, byte_len(rest))\n          }\n          found = true\n        }\n      }\n    }\n    if !found {\n      return None\n    }\n  }\n  Some(n)\n}"},{"name":"tree.marked_paths","kind":"fn","old":null,"new":"62c9019ac1d2db5d","interface_changed":true,"affected":[],"module":"tree","text":"/// The paths `locate` marks for a node at `path`: the node itself when\n/// `locate` has it, else its outermost parts that it has (an arm's pattern\n/// and body), else the nearest node around it.\npub fn marked_paths(d: ast.Decl, path: String) -> List[String] {\n  places := locate.places(d)\n  if places.any(p -> p.path == path) {\n    return [path]\n  }\n  inside := places\n    .filter(p -> starts_with(p.path, path + \"/\"))\n    .map(p -> p.path)\n  outer := inside.filter(\n    p -> !inside.any(q -> q != p && starts_with(p, q + \"/\")),\n  )\n  if len(outer) > 0 {\n    return outer\n  }\n  deepest := locate.deepest(d, path)\n  if deepest == \"\" {\n    []\n  } else {\n    [deepest]\n  }\n}"},{"name":"tree.test \"a definition rebuilt from its own slots is itself\"","kind":"test","old":null,"new":"3b640ac019803ea9","interface_changed":true,"affected":[],"module":"tree","text":"test \"a definition rebuilt from its own slots is itself\" {\n  d := ast.Decl {\n    comments: [],\n    doc: [],\n    module: \"\",\n    public: false,\n    kind: ast.FnDef(ast.FnDecl {\n      doc: [],\n      comments: [],\n      name: \"f\",\n      type_params: [],\n      bounds: [],\n      params: [ast.Param {\n        name: \"x\",\n        ty: ast.Named { name: \"Int\", args: [] },\n        mutable: false,\n        compile_time: false,\n      }],\n      ret: ast.Named { name: \"Int\", args: [] },\n      pre: [],\n      post: [],\n      terminating: false,\n      body: ast.Block {\n        stmts: [ast.Let { pat: ast.Bind(\"y\"), ty: None, value: ast.Binary {\n          op: ast.Add,\n          left: ast.Var(\"x\"),\n          right: ast.IntLit(1),\n        } }],\n        last: ast.Var(\"y\"),\n      },\n      compile_time: false,\n      derived: false,\n    }),\n  }\n  n := tree.DN(d)\n  assert tree.rebuilt(n, tree.slots(n).map(s -> s.items)) == n\n}"}]}
{"id":"31b0db9eac9d4ba3","time":1795709128,"message":"edit","changes":[{"name":"tree.use binary","kind":"use","old":null,"new":"8bf155e80e608e8b","interface_changed":true,"affected":[],"module":"tree","text":"use binary"},{"name":"tree.use deps","kind":"use","old":null,"new":"97ce686f2f6c030c","interface_changed":true,"affected":[],"module":"tree","text":"use deps"},{"name":"tree.use std.fs","kind":"use","old":null,"new":"a64329301f03c759","interface_changed":true,"affected":[],"module":"tree","text":"from std.fs use Disk"},{"name":"tree.test \"every definition of the compiler is rebuilt from its slots\"","kind":"test","old":null,"new":"c2f7ad33f168197a","interface_changed":true,"affected":[],"module":"tree","text":"test \"every definition of the compiler is rebuilt from its slots\" (disk: std.fs.Disk) {\n  mut n := 0\n  mut bad := 0\n  for rel in deps.module_files(disk, \".\") {\n    match disk.read_bytes(rel) {\n      Ok(bytes) => match binary.read(bytes) {\n        Ok(img) => {\n          for d in img.decls {\n            mut nodes := [tree.DN(d)]\n            while len(nodes) > 0 {\n              x := nodes[len(nodes) - 1]\n              nodes = slice(nodes, 0, len(nodes) - 1)\n              ss := tree.slots(x)\n              n += 1\n              if tree.rebuilt(x, ss.map(s -> s.items)) != x {\n                bad += 1\n                if bad < 5 {\n                  print(f\"{rel}: {tree.node_text(x)}\")\n                }\n              }\n              for s in ss {\n                nodes += s.items\n              }\n            }\n          }\n        },\n        Err(e) => print(f\"{rel}: {e}\"),\n      },\n      Err(e) => print(f\"{rel}: {e}\"),\n    }\n  }\n  print(f\"{n} nodes, {bad} not rebuilt\")\n  assert bad == 0\n}"}]}
{"id":"093ff7cf96904e91","time":1795709158,"message":"edit","changes":[{"name":"tree.block_of","kind":"fn","old":"25e02d9ecdd0202b","new":"78bb77c135617ef1","interface_changed":false,"affected":[],"module":"tree","text":"/// A block from its items: the last is its result when it is an\n/// expression, the others are statements.\nfn block_of(items: List[tree.Node]) -> ast.Expr {\n  n := len(items)\n  (body, last) := match get(items, n - 1) {\n    Some(tree.EN(e)) => (slice(items, 0, n - 1), e),\n    _ => (items, ast.UnitExpr),\n  }\n  mut stmts := []\n  for x in body {\n    match x {\n      tree.EN(e) => mut stmts.push(ast.ExprStmt(e)),\n      tree.SN(s) => mut stmts.push(s),\n      _ => (),\n    }\n  }\n  ast.Block { stmts, last }\n}","old_text":"/// A block from its items: the last is its result when it is an\n/// expression, the others are statements.\nfn block_of(items: List[tree.Node]) -> ast.Expr {\n  n := len(items)\n  (body, last) := match get(items, n - 1) {\n    Some(tree.EN(e)) => (take(items, n - 1), e),\n    _ => (items, ast.UnitExpr),\n  }\n  mut stmts := []\n  for x in body {\n    match x {\n      tree.EN(e) => mut stmts.push(ast.ExprStmt(e)),\n      tree.SN(s) => mut stmts.push(s),\n      _ => (),\n    }\n  }\n  ast.Block { stmts, last }\n}"}]}
{"id":"9f5b5b2b6f619ec2","time":1795709184,"message":"edit","changes":[{"name":"tree.test \"every definition of the compiler is rebuilt from its slots\"","kind":"test","old":"c2f7ad33f168197a","new":"1d2b5b4d31aa32eb","interface_changed":false,"affected":[],"module":"tree","text":"test \"every definition of the compiler is rebuilt from its slots\" (disk: std.fs.Disk) {\n  mut n := 0\n  mut bad := 0\n  for rel in deps.module_files(disk, \".\") {\n    match disk.read_bytes(rel) {\n      Ok(bytes) => match binary.read(bytes) {\n        Ok(img) => {\n          for d in img.decls {\n            mut nodes := [tree.DN(d)]\n            while len(nodes) > 0 {\n              x := nodes[len(nodes) - 1]\n              nodes = slice(nodes, 0, len(nodes) - 1)\n              ss := tree.slots(x)\n              n += 1\n              if tree.rebuilt(x, ss.map(s -> s.items)) != x {\n                bad += 1\n                if bad < 5 {\n                  print(f\"{rel}: {tree.node_text(x)}\")\n                }\n              }\n              for s in ss {\n                nodes += s.items\n              }\n            }\n          }\n        },\n        Err(e) => print(f\"{rel}: {e}\"),\n      },\n      Err(e) => print(f\"{rel}: {e}\"),\n    }\n  }\n  print(f\"{n} nodes, {bad} not rebuilt\")\n  assert n > 100000 && bad == 0\n}","old_text":"test \"every definition of the compiler is rebuilt from its slots\" (disk: std.fs.Disk) {\n  mut n := 0\n  mut bad := 0\n  for rel in deps.module_files(disk, \".\") {\n    match disk.read_bytes(rel) {\n      Ok(bytes) => match binary.read(bytes) {\n        Ok(img) => {\n          for d in img.decls {\n            mut nodes := [tree.DN(d)]\n            while len(nodes) > 0 {\n              x := nodes[len(nodes) - 1]\n              nodes = slice(nodes, 0, len(nodes) - 1)\n              ss := tree.slots(x)\n              n += 1\n              if tree.rebuilt(x, ss.map(s -> s.items)) != x {\n                bad += 1\n                if bad < 5 {\n                  print(f\"{rel}: {tree.node_text(x)}\")\n                }\n              }\n              for s in ss {\n                nodes += s.items\n              }\n            }\n          }\n        },\n        Err(e) => print(f\"{rel}: {e}\"),\n      },\n      Err(e) => print(f\"{rel}: {e}\"),\n    }\n  }\n  print(f\"{n} nodes, {bad} not rebuilt\")\n  assert bad == 0\n}"}]}
{"id":"df355320ea99e7e3","time":1795709222,"message":"edit","changes":[{"name":"tree.use binary","kind":"use","old":"8bf155e80e608e8b","new":null,"interface_changed":true,"affected":[],"module":"tree","old_text":"use binary"},{"name":"tree.use deps","kind":"use","old":"97ce686f2f6c030c","new":null,"interface_changed":true,"affected":[],"module":"tree","old_text":"use deps"},{"name":"tree.use std.fs","kind":"use","old":"a64329301f03c759","new":null,"interface_changed":true,"affected":[],"module":"tree","old_text":"from std.fs use Disk"},{"name":"tree.test \"every definition of the compiler is rebuilt from its slots\"","kind":"test","old":"1d2b5b4d31aa32eb","new":null,"interface_changed":true,"affected":[],"module":"tree","old_text":"test \"every definition of the compiler is rebuilt from its slots\" (disk: std.fs.Disk) {\n  mut n := 0\n  mut bad := 0\n  for rel in deps.module_files(disk, \".\") {\n    match disk.read_bytes(rel) {\n      Ok(bytes) => match binary.read(bytes) {\n        Ok(img) => {\n          for d in img.decls {\n            mut nodes := [tree.DN(d)]\n            while len(nodes) > 0 {\n              x := nodes[len(nodes) - 1]\n              nodes = slice(nodes, 0, len(nodes) - 1)\n              ss := tree.slots(x)\n              n += 1\n              if tree.rebuilt(x, ss.map(s -> s.items)) != x {\n                bad += 1\n                if bad < 5 {\n                  print(f\"{rel}: {tree.node_text(x)}\")\n                }\n              }\n              for s in ss {\n                nodes += s.items\n              }\n            }\n          }\n        },\n        Err(e) => print(f\"{rel}: {e}\"),\n      },\n      Err(e) => print(f\"{rel}: {e}\"),\n    }\n  }\n  print(f\"{n} nodes, {bad} not rebuilt\")\n  assert n > 100000 && bad == 0\n}"}]}
{"id":"0897359edb4b3c74","time":1795709262,"message":"edit","changes":[{"name":"tree.use parse","kind":"use","old":null,"new":"d2b127fa0dcfbcff","interface_changed":true,"affected":[],"module":"tree","text":"from parse use parse_module"},{"name":"tree.decl_of","kind":"fn","old":null,"new":"e8c2b20fdf36524e","interface_changed":true,"affected":[],"module":"tree","text":"/// The first definition of `text`, for the tests.\nfn decl_of(text: String) -> ast.Decl {\n  match parse.parse_module(text, \"\") {\n    Ok([d, ..]) => d,\n    _ => tree.empty_decl(),\n  }\n}"},{"name":"tree.merged_text","kind":"fn","old":null,"new":"bd81269fb6f3c604","interface_changed":true,"affected":[],"module":"tree","text":"/// `base`, `ours` and `theirs` merged, as text, and the conflicts' names.\nfn merged_text(\n  base: String,\n  ours: String,\n  theirs: String,\n) -> (String, List[String]) {\n  m := tree.merge(\n    tree.decl_of(base),\n    tree.decl_of(ours),\n    tree.decl_of(theirs),\n    1,\n  )\n  (match m.decl {\n    Some(d) => text.decl_text(d),\n    None => \"\",\n  }, m.conflicts.map(c -> c.name + \" at \" + c.path))\n}"},{"name":"tree.test \"edits to neighbouring statements merge\"","kind":"test","old":null,"new":"aa39271e620c5ee8","interface_changed":true,"affected":[],"module":"tree","text":"test \"edits to neighbouring statements merge\" {\n  (t, cs) := tree.merged_text(\n    \"fn f(x: Int) -> Int {\\n  a := x + 1\\n  b := a * 2\\n  a + b\\n}\",\n    \"fn f(x: Int) -> Int {\\n  a := x + 10\\n  b := a * 2\\n  a + b\\n}\",\n    \"fn f(x: Int) -> Int {\\n  a := x + 1\\n  b := a * 20\\n  a + b\\n}\",\n  )\n  assert cs == []\n  assert t == \"fn f(x: Int) -> Int {\\n  a := x + 10\\n  b := a * 20\\n  a + b\\n}\"\n}"},{"name":"tree.test \"edits to two arguments of one call merge\"","kind":"test","old":null,"new":"bbfddc252a291577","interface_changed":true,"affected":[],"module":"tree","text":"test \"edits to two arguments of one call merge\" {\n  (t, cs) := tree.merged_text(\n    \"fn f(x: Int) -> Int = g(x + 1, x * 2)\",\n    \"fn f(x: Int) -> Int = g(x + 5, x * 2)\",\n    \"fn f(x: Int) -> Int = g(x + 1, x * 7)\",\n  )\n  assert cs == []\n  assert t == \"fn f(x: Int) -> Int = g(x + 5, x * 7)\"\n}"},{"name":"tree.test \"statements added at different places merge\"","kind":"test","old":null,"new":"ea4a3eaf4bdecfcc","interface_changed":true,"affected":[],"module":"tree","text":"test \"statements added at different places merge\" {\n  (t, cs) := tree.merged_text(\n    \"fn f(x: Int) -> Int {\\n  a := x\\n  b := a\\n  b\\n}\",\n    \"fn f(x: Int) -> Int {\\n  print(1)\\n  a := x\\n  b := a\\n  b\\n}\",\n    \"fn f(x: Int) -> Int {\\n  a := x\\n  b := a\\n  print(2)\\n  b\\n}\",\n  )\n  assert cs == []\n  assert t == \"fn f(x: Int) -> Int {\\n  print(1)\\n  a := x\\n  b := a\\n  print(2)\\n  b\\n}\"\n}"},{"name":"tree.test \"one node changed on both sides is a conflict there\"","kind":"test","old":null,"new":"4b7e5c607a715c3c","interface_changed":true,"affected":[],"module":"tree","text":"test \"one node changed on both sides is a conflict there\" {\n  (t, cs) := tree.merged_text(\n    \"fn f(x: Int) -> Int {\\n  a := x + 1\\n  b := a * 2\\n  a + b\\n}\",\n    \"fn f(x: Int) -> Int {\\n  a := x + 2\\n  b := a * 2\\n  a + b\\n}\",\n    \"fn f(x: Int) -> Int {\\n  a := x + 3\\n  b := a * 3\\n  a + b\\n}\",\n  )\n  assert cs == [\"conflict_1 at body/0/value/right\"]\n  assert t == \"fn f(x: Int) -> Int {\\n  a := x + ?conflict_1(2, 1, 3)\\n  b := a * 3\\n  a + b\\n}\"\n}"},{"name":"tree.test \"statements added at one place on both sides are one conflict\"","kind":"test","old":null,"new":"c44057cd719a596d","interface_changed":true,"affected":[],"module":"tree","text":"test \"statements added at one place on both sides are one conflict\" {\n  (t, cs) := tree.merged_text(\n    \"fn f(x: Int) -> Int {\\n  a := x\\n  a\\n}\",\n    \"fn f(x: Int) -> Int {\\n  a := x\\n  print(1)\\n  a\\n}\",\n    \"fn f(x: Int) -> Int {\\n  a := x\\n  print(2)\\n  a\\n}\",\n  )\n  assert cs == [\"conflict_1 at body/1\"]\n  assert t == \"fn f(x: Int) -> Int {\\n  a := x\\n  ?conflict_1(print(1), (), print(2))\\n  a\\n}\"\n}"},{"name":"tree.test \"arms reordered on one side, an arm changed on the other\"","kind":"test","old":null,"new":"1ed826197668815e","interface_changed":true,"affected":[],"module":"tree","text":"test \"arms reordered on one side, an arm changed on the other\" {\n  (t, cs) := tree.merged_text(\n    \"fn f(x: Int) -> Int {\\n  match x {\\n    0 => 1,\\n    1 => 2,\\n    _ => 3,\\n  }\\n}\",\n    \"fn f(x: Int) -> Int {\\n  match x {\\n    1 => 2,\\n    0 => 1,\\n    _ => 3,\\n  }\\n}\",\n    \"fn f(x: Int) -> Int {\\n  match x {\\n    0 => 1,\\n    1 => 2,\\n    _ => 30,\\n  }\\n}\",\n  )\n  assert cs == []\n  assert t == \"fn f(x: Int) -> Int {\\n  match x {\\n    1 => 2,\\n    0 => 1,\\n    _ => 30,\\n  }\\n}\"\n}"},{"name":"tree.test \"a signature changed on both sides has no hole\"","kind":"test","old":null,"new":"a237cbb134290851","interface_changed":true,"affected":[],"module":"tree","text":"test \"a signature changed on both sides has no hole\" {\n  m := tree.merge(\n    tree.decl_of(\"fn f(x: Int) -> Int = x\"),\n    tree.decl_of(\"fn f(x: Float) -> Int = x\"),\n    tree.decl_of(\"fn f(x: String) -> Int = x\"),\n    1,\n  )\n  assert m.decl == None\n}"},{"name":"tree.test \"a diff names the nodes that changed\"","kind":"test","old":null,"new":"c5a18a555cd1f70c","interface_changed":true,"affected":[],"module":"tree","text":"test \"a diff names the nodes that changed\" {\n  a := tree.decl_of(\n    \"fn f(x: Int) -> Int {\\n  a := x + 1\\n  match a {\\n    0 => 1,\\n    _ => 2,\\n  }\\n}\",\n  )\n  b := tree.decl_of(\n    \"fn f(x: Int) -> Int {\\n  a := x - 1\\n  print(a)\\n  match a {\\n    _ => 2,\\n    0 => 1,\\n  }\\n}\",\n  )\n  cs := tree.changes(a, b).map(c -> c.kind + \" \" + c.old + \" \" + c.new)\n  assert cs == [\n    \"edited body/0/value body/0/value\",\n    \"added  body/1\",\n    \"moved body/1/arms/0 body/2/arms/1\",\n  ]\n}"},{"name":"tree.test \"the same definition has no changes\"","kind":"test","old":null,"new":"41fdb14f1cedf0ab","interface_changed":true,"affected":[],"module":"tree","text":"test \"the same definition has no changes\" {\n  a := tree.decl_of(\"fn f(x: Int) -> Int {\\n  a := x + 1\\n  a\\n}\")\n  assert tree.changes(a, a) == []\n}"}]}
{"id":"35aba32a665c07b2","time":1795709338,"message":"edit","changes":[{"name":"tree.matched","kind":"fn","old":"f588a903a47b094d","new":"a1412e1ed6756a3c","interface_changed":false,"affected":[],"module":"tree","text":"/// Lines `a` up with `b`: for each index of `a`, the index of the equal\n/// item of `b` it is paired with, or -1. The longest common subsequence,\n/// after the common start and end, which cost one comparison per item.\n/// O(len(a) * len(b)) comparisons for the rest.\npub fn matched(a: List[tree.Node], b: List[tree.Node]) -> List[Int] {\n  n := len(a)\n  m := len(b)\n  mut out := [-1 for _ in 0..n]\n  mut s := 0\n  while s < n && s < m && get(a, s) == get(b, s) {\n    out[s] = s\n    s += 1\n  }\n  mut e := 0\n  while e < n - s && e < m - s && get(a, n - 1 - e) == get(b, m - 1 - e) {\n    out[n - 1 - e] = m - 1 - e\n    e += 1\n  }\n  // the middle: a[s..n-e] against b[s..m-e]\n  ra := n - e - s\n  rb := m - e - s\n  if ra == 0 || rb == 0 {\n    return out\n  }\n  for (i, j) in tree.lcs_by(ra, rb, (i, j) -> get(a, s + i) == get(b, s + j)) {\n    out[s + i] = s + j\n  }\n  out\n}","old_text":"/// Lines `a` up with `b`: for each index of `a`, the index of the equal\n/// item of `b` it is paired with, or -1. The longest common subsequence,\n/// after the common start and end, which cost one comparison per item.\n/// O(len(a) * len(b)) comparisons for the rest.\npub fn matched(a: List[tree.Node], b: List[tree.Node]) -> List[Int] {\n  n := len(a)\n  m := len(b)\n  mut out := [-1 for _ in 0..n]\n  mut s := 0\n  while s < n && s < m && get(a, s) == get(b, s) {\n    out[s] = s\n    s += 1\n  }\n  mut e := 0\n  while e < n - s && e < m - s && get(a, n - 1 - e) == get(b, m - 1 - e) {\n    out[n - 1 - e] = m - 1 - e\n    e += 1\n  }\n  // the middle: a[s..n-e] against b[s..m-e]\n  ra := n - e - s\n  rb := m - e - s\n  if ra == 0 || rb == 0 {\n    return out\n  }\n  // rows[i][j]: the longest common subsequence of a[s+i..] and b[s+j..]\n  mut rows := [[0 for _ in 0..rb + 1] for _ in 0..ra + 1]\n  mut i := ra - 1\n  while i >= 0 {\n    mut j := rb - 1\n    while j >= 0 {\n      v := if get(a, s + i) == get(b, s + j) {\n        (get(get(rows, i + 1) ?? [], j + 1) ?? 0) + 1\n      } else {\n        max(\n          get(get(rows, i + 1) ?? [], j) ?? 0,\n          get(get(rows, i) ?? [], j + 1) ?? 0,\n        )\n      }\n      rows[i][j] = v\n      j -= 1\n    }\n    i -= 1\n  }\n  mut x := 0\n  mut y := 0\n  while x < ra && y < rb {\n    if get(a, s + x) == get(b, s + y) {\n      out[s + x] = s + y\n      x += 1\n      y += 1\n    } else if get(get(rows, x + 1) ?? [], y) ?? 0 >= get(get(rows, x) ?? [], y + 1) ?? 0 {\n      x += 1\n    } else {\n      y += 1\n    }\n  }\n  out\n}"},{"name":"tree.diff_items","kind":"fn","old":"82df43004f131d07","new":"36fe411f3d67a6e6","interface_changed":false,"affected":[],"module":"tree","text":"fn diff_items(\n  mut out: List[tree.Change],\n  s: tree.Slot,\n  t: tree.Slot,\n  pa: String,\n  pb: String,\n) {\n  xs := s.items\n  ys := t.items\n  if xs == ys {\n    return\n  }\n  m := tree.matched(xs, ys)\n  used_b := set([j for j in m where j >= 0])\n  // the items of each side that no equal item pairs\n  gone := [i for (i, j) in enumerate(m) where j < 0]\n  came := [j for j in 0..len(ys) where !contains(used_b, j)]\n  // the same item elsewhere in the list: moved\n  mut moved_a := Set[Int] {}\n  mut moved_b := Set[Int] {}\n  for i in gone {\n    x := get(xs, i) ?? tree.DN(tree.empty_decl())\n    match came.find(j -> !contains(moved_b, j) && get(ys, j) == Some(x)) {\n      Some(j) => {\n        mut moved_a.insert(i)\n        mut moved_b.insert(j)\n        mut out.push(\n          tree.Change {\n            kind: \"moved\",\n            old: tree.item_path(pa, s, i, x),\n            new: tree.item_path(pb, t, j, x),\n          },\n        )\n      },\n      None => (),\n    }\n  }\n  // what is left between two paired items is compared in order\n  mut i := 0\n  mut j := 0\n  while i < len(xs) || j < len(ys) {\n    if i < len(xs) && get(m, i) ?? -1 >= 0 {\n      // a paired item: the other side's items before its partner were added\n      partner := get(m, i) ?? 0\n      while j < partner {\n        if !contains(moved_b, j) {\n          y := get(ys, j) ?? tree.DN(tree.empty_decl())\n          mut out.push(\n            tree.Change {\n              kind: \"added\",\n              old: \"\",\n              new: tree.item_path(pb, t, j, y),\n            },\n          )\n        }\n        j += 1\n      }\n      i += 1\n      j = partner + 1\n      continue\n    }\n    // a gap: the unpaired items of each side up to the next pair\n    mut dels := []\n    while i < len(xs) && get(m, i) ?? -1 < 0 {\n      if !contains(moved_a, i) {\n        mut dels.push(i)\n      }\n      i += 1\n    }\n    stop := if i < len(xs) {\n      get(m, i) ?? len(ys)\n    } else {\n      len(ys)\n    }\n    mut adds := []\n    while j < stop {\n      if !contains(moved_b, j) {\n        mut adds.push(j)\n      }\n      j += 1\n    }\n    for (di, aj) in tree.gap_pairs(xs, dels, ys, adds) {\n      if di >= 0 && aj >= 0 {\n        x := get(xs, di) ?? tree.DN(tree.empty_decl())\n        y := get(ys, aj) ?? x\n        if tree.same_form(x, tree.slots(x), y, tree.slots(y)) {\n          tree.walk_diff(\n            mut out,\n            x,\n            y,\n            tree.item_path(pa, s, di, x),\n            tree.item_path(pb, t, aj, y),\n          )\n        } else {\n          mut out.push(\n            tree.Change {\n              kind: \"replaced\",\n              old: tree.item_path(pa, s, di, x),\n              new: tree.item_path(pb, t, aj, y),\n            },\n          )\n        }\n      } else if di >= 0 {\n        x := get(xs, di) ?? tree.DN(tree.empty_decl())\n        mut out.push(\n          tree.Change {\n            kind: \"removed\",\n            old: tree.item_path(pa, s, di, x),\n            new: \"\",\n          },\n        )\n      } else {\n        y := get(ys, aj) ?? tree.DN(tree.empty_decl())\n        mut out.push(\n          tree.Change {\n            kind: \"added\",\n            old: \"\",\n            new: tree.item_path(pb, t, aj, y),\n          },\n        )\n      }\n    }\n  }\n}","old_text":"fn diff_items(\n  mut out: List[tree.Change],\n  s: tree.Slot,\n  t: tree.Slot,\n  pa: String,\n  pb: String,\n) {\n  xs := s.items\n  ys := t.items\n  if xs == ys {\n    return\n  }\n  m := tree.matched(xs, ys)\n  used_b := set([j for j in m where j >= 0])\n  // the items of each side that no equal item pairs\n  gone := [i for (i, j) in enumerate(m) where j < 0]\n  came := [j for j in 0..len(ys) where !contains(used_b, j)]\n  // the same item elsewhere in the list: moved\n  mut moved_a := Set[Int] {}\n  mut moved_b := Set[Int] {}\n  for i in gone {\n    x := get(xs, i) ?? tree.DN(tree.empty_decl())\n    match came.find(j -> !contains(moved_b, j) && get(ys, j) == Some(x)) {\n      Some(j) => {\n        mut moved_a.insert(i)\n        mut moved_b.insert(j)\n        mut out.push(\n          tree.Change {\n            kind: \"moved\",\n            old: tree.item_path(pa, s, i, x),\n            new: tree.item_path(pb, t, j, x),\n          },\n        )\n      },\n      None => (),\n    }\n  }\n  // what is left between two paired items is compared in order\n  mut i := 0\n  mut j := 0\n  while i < len(xs) || j < len(ys) {\n    if i < len(xs) && get(m, i) ?? -1 >= 0 {\n      // a paired item: the other side's items before its partner were added\n      partner := get(m, i) ?? 0\n      while j < partner {\n        if !contains(moved_b, j) {\n          y := get(ys, j) ?? tree.DN(tree.empty_decl())\n          mut out.push(\n            tree.Change {\n              kind: \"added\",\n              old: \"\",\n              new: tree.item_path(pb, t, j, y),\n            },\n          )\n        }\n        j += 1\n      }\n      i += 1\n      j = partner + 1\n      continue\n    }\n    // a gap: the unpaired items of each side up to the next pair\n    mut dels := []\n    while i < len(xs) && get(m, i) ?? -1 < 0 {\n      if !contains(moved_a, i) {\n        mut dels.push(i)\n      }\n      i += 1\n    }\n    stop := if i < len(xs) {\n      get(m, i) ?? len(ys)\n    } else {\n      len(ys)\n    }\n    mut adds := []\n    while j < stop {\n      if !contains(moved_b, j) {\n        mut adds.push(j)\n      }\n      j += 1\n    }\n    for (k, di) in enumerate(dels) {\n      x := get(xs, di) ?? tree.DN(tree.empty_decl())\n      match get(adds, k) {\n        Some(aj) => {\n          y := get(ys, aj) ?? x\n          if tree.same_form(x, tree.slots(x), y, tree.slots(y)) {\n            tree.walk_diff(\n              mut out,\n              x,\n              y,\n              tree.item_path(pa, s, di, x),\n              tree.item_path(pb, t, aj, y),\n            )\n          } else {\n            mut out.push(\n              tree.Change {\n                kind: \"replaced\",\n                old: tree.item_path(pa, s, di, x),\n                new: tree.item_path(pb, t, aj, y),\n              },\n            )\n          }\n        },\n        None => mut out.push(\n          tree.Change {\n            kind: \"removed\",\n            old: tree.item_path(pa, s, di, x),\n            new: \"\",\n          },\n        ),\n      }\n    }\n    for (k, aj) in enumerate(adds) {\n      if k >= len(dels) {\n        y := get(ys, aj) ?? tree.DN(tree.empty_decl())\n        mut out.push(\n          tree.Change {\n            kind: \"added\",\n            old: \"\",\n            new: tree.item_path(pb, t, aj, y),\n          },\n        )\n      }\n    }\n  }\n}"},{"name":"tree.merge_items","kind":"fn","old":"0f9316c389d9a6e6","new":"f9db3b0d831cba9d","interface_changed":false,"affected":[],"module":"tree","text":"/// Merges one slot's items: three-way, by the base's items that both sides\n/// kept (`matched`). Between two such, a run changed on one side only is\n/// taken from it; changed on both, it is merged item by item when the\n/// three runs are as long, else it is a conflict.\nfn merge_items(\n  mut st: tree.St,\n  s: tree.Slot,\n  xo: List[tree.Node],\n  xa: List[tree.Node],\n  xb: List[tree.Node],\n  path: String,\n) -> Option[List[tree.Node]] {\n  if xa == xb || xo == xb {\n    return Some(xa)\n  }\n  if xo == xa {\n    return Some(xb)\n  }\n  // one side only reordered the items, the other changed them in place\n  match (tree.reordering(xo, xa), tree.in_place(xo, xb)) {\n    (Some(perm), true) => return Some(perm.map(i -> get(xb, i) ?? tree.DN(tree.empty_decl()))),\n    _ => (),\n  }\n  match (tree.reordering(xo, xb), tree.in_place(xo, xa)) {\n    (Some(perm), true) => return Some(perm.map(i -> get(xa, i) ?? tree.DN(tree.empty_decl()))),\n    _ => (),\n  }\n  ma := tree.matched(xo, xa)\n  mb := tree.matched(xo, xb)\n  mut out := []\n  mut po := 0\n  mut pa := 0\n  mut pb := 0\n  n := len(xo)\n  mut k := 0\n  while k <= n {\n    ia := if k == n {\n      len(xa)\n    } else {\n      get(ma, k) ?? -1\n    }\n    ib := if k == n {\n      len(xb)\n    } else {\n      get(mb, k) ?? -1\n    }\n    if ia >= 0 && ib >= 0 {\n      oc := slice(xo, po, k)\n      ac := slice(xa, pa, ia)\n      bc := slice(xb, pb, ib)\n      match tree.merge_run(mut st, s, oc, ac, bc, path, po) {\n        Some(xs) => {\n          out += xs\n        },\n        None => return None,\n      }\n      if k < n {\n        match get(xo, k) {\n          Some(x) => mut out.push(x),\n          None => (),\n        }\n      }\n      po = k + 1\n      pa = ia + 1\n      pb = ib + 1\n    }\n    k += 1\n  }\n  Some(out)\n}","old_text":"/// Merges one slot's items: three-way, by the base's items that both sides\n/// kept (`matched`). Between two such, a run changed on one side only is\n/// taken from it; changed on both, it is merged item by item when the\n/// three runs are as long, else it is a conflict.\nfn merge_items(\n  mut st: tree.St,\n  s: tree.Slot,\n  xo: List[tree.Node],\n  xa: List[tree.Node],\n  xb: List[tree.Node],\n  path: String,\n) -> Option[List[tree.Node]] {\n  if xa == xb || xo == xb {\n    return Some(xa)\n  }\n  if xo == xa {\n    return Some(xb)\n  }\n  ma := tree.matched(xo, xa)\n  mb := tree.matched(xo, xb)\n  mut out := []\n  mut po := 0\n  mut pa := 0\n  mut pb := 0\n  n := len(xo)\n  mut k := 0\n  while k <= n {\n    ia := if k == n {\n      len(xa)\n    } else {\n      get(ma, k) ?? -1\n    }\n    ib := if k == n {\n      len(xb)\n    } else {\n      get(mb, k) ?? -1\n    }\n    if ia >= 0 && ib >= 0 {\n      oc := slice(xo, po, k)\n      ac := slice(xa, pa, ia)\n      bc := slice(xb, pb, ib)\n      match tree.merge_run(mut st, s, oc, ac, bc, path, po) {\n        Some(xs) => {\n          out += xs\n        },\n        None => return None,\n      }\n      if k < n {\n        match get(xo, k) {\n          Some(x) => mut out.push(x),\n          None => (),\n        }\n      }\n      po = k + 1\n      pa = ia + 1\n      pb = ib + 1\n    }\n    k += 1\n  }\n  Some(out)\n}"},{"name":"tree.alike","kind":"fn","old":null,"new":"a282404da98760a5","interface_changed":true,"affected":[],"module":"tree","text":"/// Two nodes alike enough to be one changed: the same form and head.\nfn alike(x: tree.Node, y: tree.Node) -> Bool {\n  sx := tree.slots(x)\n  sy := tree.slots(y)\n  tree.same_form(x, sx, y, sy)\n    && tree.head(x, sx) == tree.head(y, sy)\n}"},{"name":"tree.gap_pairs","kind":"fn","old":null,"new":"9bcbcca2a1542bfe","interface_changed":true,"affected":[],"module":"tree","text":"/// Pairs the items removed (`dels`, indices of `xs`) and added (`adds`,\n/// of `ys`) between two kept items: the alike ones in order (the longest\n/// such run), then what is left between them in order. `(i, -1)`: removed;\n/// `(-1, j)`: added.\nfn gap_pairs(\n  xs: List[tree.Node],\n  dels: List[Int],\n  ys: List[tree.Node],\n  adds: List[Int],\n) -> List[(Int, Int)] {\n  dn := dels.map(i -> get(xs, i) ?? tree.DN(tree.empty_decl()))\n  an := adds.map(j -> get(ys, j) ?? tree.DN(tree.empty_decl()))\n  m := tree.lcs_by(len(dn), len(an), (i, j) -> tree.alike(\n    get(dn, i) ?? tree.DN(tree.empty_decl()),\n    get(an, j) ?? tree.DN(tree.empty_decl()),\n  ))\n  mut out := []\n  mut i := 0\n  mut j := 0\n  for (pi, pj) in m + [(len(dn), len(an))] {\n    // between two alike pairs: in order\n    while i < pi || j < pj {\n      di := if i < pi {\n        get(dels, i) ?? -1\n      } else {\n        -1\n      }\n      aj := if j < pj {\n        get(adds, j) ?? -1\n      } else {\n        -1\n      }\n      mut out.push((di, aj))\n      if i < pi {\n        i += 1\n      }\n      if j < pj {\n        j += 1\n      }\n    }\n    if pi < len(dn) {\n      mut out.push((get(dels, pi) ?? -1, get(adds, pj) ?? -1))\n      i = pi + 1\n      j = pj + 1\n    }\n  }\n  out\n}"},{"name":"tree.lcs_by","kind":"fn","old":null,"new":"3cd93e6b69595ae2","interface_changed":true,"affected":[],"module":"tree","text":"/// The longest common subsequence of two sequences of lengths `n` and `m`\n/// under `eq`, as pairs of indices in order. O(n * m) calls of `eq`.\nfn lcs_by(n: Int, m: Int, eq: (Int, Int) -> Bool) -> List[(Int, Int)] {\n  if n == 0 || m == 0 {\n    return []\n  }\n  // rows[i][j]: the longest common subsequence of a[i..] and b[j..]\n  mut rows := [[0 for _ in 0..m + 1] for _ in 0..n + 1]\n  mut i := n - 1\n  while i >= 0 {\n    mut j := m - 1\n    while j >= 0 {\n      v := if eq(i, j) {\n        (get(get(rows, i + 1) ?? [], j + 1) ?? 0) + 1\n      } else {\n        max(\n          get(get(rows, i + 1) ?? [], j) ?? 0,\n          get(get(rows, i) ?? [], j + 1) ?? 0,\n        )\n      }\n      rows[i][j] = v\n      j -= 1\n    }\n    i -= 1\n  }\n  mut out := []\n  mut x := 0\n  mut y := 0\n  while x < n && y < m {\n    if eq(x, y)\n      && get(get(rows, x) ?? [], y) ?? 0 == (get(get(rows, x + 1) ?? [], y + 1) ?? 0) + 1 {\n      mut out.push((x, y))\n      x += 1\n      y += 1\n    } else if get(get(rows, x + 1) ?? [], y) ?? 0 >= get(get(rows, x) ?? [], y + 1) ?? 0 {\n      x += 1\n    } else {\n      y += 1\n    }\n  }\n  out\n}"},{"name":"tree.reordering","kind":"fn","old":null,"new":"1eb0322d9adeb421","interface_changed":true,"affected":[],"module":"tree","text":"/// When `b` holds the items of `a` in another order: for each item of\n/// `b`, the index of its item in `a`.\nfn reordering(a: List[tree.Node], b: List[tree.Node]) -> Option[List[Int]] {\n  if len(a) != len(b) || a == b {\n    return None\n  }\n  mut used := Set[Int] {}\n  mut out := []\n  for y in b {\n    match [i for (i, x) in enumerate(a) where x == y && !contains(used, i)] {\n      [i, ..] => {\n        mut used.insert(i)\n        mut out.push(i)\n      },\n      [] => return None,\n    }\n  }\n  Some(out)\n}"},{"name":"tree.in_place","kind":"fn","old":null,"new":"bb1ad28093a96273","interface_changed":true,"affected":[],"module":"tree","text":"/// Whether `b` is `a` with items changed in place: as many items, each\n/// equal to `a`'s at its index or of its form.\nfn in_place(a: List[tree.Node], b: List[tree.Node]) -> Bool {\n  len(a) == len(b)\n    && zip(a, b).all(\n      p -> p.0 == p.1\n        || tree.same_form(p.0, tree.slots(p.0), p.1, tree.slots(p.1)),\n    )\n}"}]}
{"id":"106a1ae4f469cc90","time":1795709371,"message":"edit","changes":[{"name":"tree.matched","kind":"fn","old":"a1412e1ed6756a3c","new":"2516c7f67891a9bd","interface_changed":false,"affected":[],"module":"tree","text":"/// Lines `a` up with `b`: for each index of `a`, the index of the equal\n/// item of `b` it is paired with, or -1. The longest common subsequence,\n/// after the common start and end, which cost one comparison per item.\n/// O(len(a) * len(b)) comparisons for the rest.\npub fn matched(a: List[tree.Node], b: List[tree.Node]) -> List[Int] {\n  n := len(a)\n  m := len(b)\n  mut pairs := Dict[Int, Int] {}\n  mut s := 0\n  while s < n && s < m && get(a, s) == get(b, s) {\n    mut pairs.insert(s, s)\n    s += 1\n  }\n  mut e := 0\n  while e < n - s && e < m - s && get(a, n - 1 - e) == get(b, m - 1 - e) {\n    mut pairs.insert(n - 1 - e, m - 1 - e)\n    e += 1\n  }\n  // the middle: a[s..n-e] against b[s..m-e]\n  for (i, j) in tree.lcs_by(\n    n - e - s,\n    m - e - s,\n    (i, j) -> get(a, s + i) == get(b, s + j),\n  ) {\n    mut pairs.insert(s + i, s + j)\n  }\n  [get(pairs, i) ?? -1 for i in 0..n]\n}","old_text":"/// Lines `a` up with `b`: for each index of `a`, the index of the equal\n/// item of `b` it is paired with, or -1. The longest common subsequence,\n/// after the common start and end, which cost one comparison per item.\n/// O(len(a) * len(b)) comparisons for the rest.\npub fn matched(a: List[tree.Node], b: List[tree.Node]) -> List[Int] {\n  n := len(a)\n  m := len(b)\n  mut out := [-1 for _ in 0..n]\n  mut s := 0\n  while s < n && s < m && get(a, s) == get(b, s) {\n    out[s] = s\n    s += 1\n  }\n  mut e := 0\n  while e < n - s && e < m - s && get(a, n - 1 - e) == get(b, m - 1 - e) {\n    out[n - 1 - e] = m - 1 - e\n    e += 1\n  }\n  // the middle: a[s..n-e] against b[s..m-e]\n  ra := n - e - s\n  rb := m - e - s\n  if ra == 0 || rb == 0 {\n    return out\n  }\n  for (i, j) in tree.lcs_by(ra, rb, (i, j) -> get(a, s + i) == get(b, s + j)) {\n    out[s + i] = s + j\n  }\n  out\n}"},{"name":"tree.lcs_by","kind":"fn","old":"3cd93e6b69595ae2","new":"2371aa1a09cb920c","interface_changed":false,"affected":[],"module":"tree","text":"/// The longest common subsequence of two sequences of lengths `n` and `m`\n/// under `eq`, as pairs of indices in order. O(n * m) calls of `eq`.\nfn lcs_by(n: Int, m: Int, eq: (Int, Int) -> Bool) -> List[(Int, Int)] {\n  if n <= 0 || m <= 0 {\n    return []\n  }\n  // rows[n - i][j]: the longest common subsequence of a[i..] and b[j..]\n  mut rows := [[0 for _ in 0..m + 1]]\n  mut i := n - 1\n  while i >= 0 {\n    below := get(rows, n - i - 1) ?? []\n    mut rev := [0]\n    mut j := m - 1\n    while j >= 0 {\n      right := get(rev, len(rev) - 1) ?? 0\n      v := if eq(i, j) {\n        (get(below, j + 1) ?? 0) + 1\n      } else {\n        max(get(below, j) ?? 0, right)\n      }\n      mut rev.push(v)\n      j -= 1\n    }\n    mut rows.push(rev.reversed())\n    i -= 1\n  }\n  // the length from (x, y) on\n  at := (x: Int, y: Int) -> get(get(rows, n - x) ?? [], y) ?? 0\n  mut out := []\n  mut x := 0\n  mut y := 0\n  while x < n && y < m {\n    if eq(x, y) && at(x, y) == at(x + 1, y + 1) + 1 {\n      mut out.push((x, y))\n      x += 1\n      y += 1\n    } else if at(x + 1, y) >= at(x, y + 1) {\n      x += 1\n    } else {\n      y += 1\n    }\n  }\n  out\n}","old_text":"/// The longest common subsequence of two sequences of lengths `n` and `m`\n/// under `eq`, as pairs of indices in order. O(n * m) calls of `eq`.\nfn lcs_by(n: Int, m: Int, eq: (Int, Int) -> Bool) -> List[(Int, Int)] {\n  if n == 0 || m == 0 {\n    return []\n  }\n  // rows[i][j]: the longest common subsequence of a[i..] and b[j..]\n  mut rows := [[0 for _ in 0..m + 1] for _ in 0..n + 1]\n  mut i := n - 1\n  while i >= 0 {\n    mut j := m - 1\n    while j >= 0 {\n      v := if eq(i, j) {\n        (get(get(rows, i + 1) ?? [], j + 1) ?? 0) + 1\n      } else {\n        max(\n          get(get(rows, i + 1) ?? [], j) ?? 0,\n          get(get(rows, i) ?? [], j + 1) ?? 0,\n        )\n      }\n      rows[i][j] = v\n      j -= 1\n    }\n    i -= 1\n  }\n  mut out := []\n  mut x := 0\n  mut y := 0\n  while x < n && y < m {\n    if eq(x, y)\n      && get(get(rows, x) ?? [], y) ?? 0 == (get(get(rows, x + 1) ?? [], y + 1) ?? 0) + 1 {\n      mut out.push((x, y))\n      x += 1\n      y += 1\n    } else if get(get(rows, x + 1) ?? [], y) ?? 0 >= get(get(rows, x) ?? [], y + 1) ?? 0 {\n      x += 1\n    } else {\n      y += 1\n    }\n  }\n  out\n}"}]}
{"id":"5bcc5571bb1fe723","time":1795709380,"message":"edit","changes":[{"name":"tree.test \"edits to two arguments of one call merge\"","kind":"test","old":"bbfddc252a291577","new":"1452332192e0e692","interface_changed":false,"affected":[],"module":"tree","text":"test \"edits to two arguments of one call merge\" {\n  (t, cs) := tree.merged_text(\n    \"fn f(x: Int) -> Int = g(x + 1, x * 2)\",\n    \"fn f(x: Int) -> Int = g(x + 5, x * 2)\",\n    \"fn f(x: Int) -> Int = g(x + 1, x * 7)\",\n  )\n  assert cs == []\n  assert t == \"fn f(x: Int) -> Int {\\n  g(x + 5, x * 7)\\n}\"\n}","old_text":"test \"edits to two arguments of one call merge\" {\n  (t, cs) := tree.merged_text(\n    \"fn f(x: Int) -> Int = g(x + 1, x * 2)\",\n    \"fn f(x: Int) -> Int = g(x + 5, x * 2)\",\n    \"fn f(x: Int) -> Int = g(x + 1, x * 7)\",\n  )\n  assert cs == []\n  assert t == \"fn f(x: Int) -> Int = g(x + 5, x * 7)\"\n}"}]}
{"id":"42fc454b042e2902","time":1795709411,"message":"edit","changes":[{"name":"merge.Merged","kind":"type","old":"8b6c62f238335b22","new":"664d810083b628e8","interface_changed":true,"affected":["merge.merge","merge_file_command","command_line","main","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","tour_graph","linked","expanded","comptime_runner","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","diff_command","tour_command","with_base","rename_command","move_command","fix_command","edit_in_editor"],"module":"merge","text":"/// The merged text, the definitions left in conflict as text, and what was\n/// done. `holes`: the nodes in conflict inside definitions that merged\n/// otherwise, each left as a hole `?conflict_N(ours, base, theirs)` in the\n/// merged code (`definition: ?conflict_N at PATH`).\npub type Merged = {\n  text: String,\n  conflicts: List[String],\n  notes: List[String],\n  holes: List[String] = [],\n}","old_text":"/// The merged text, the definitions left in conflict, and what was done.\npub type Merged = { text: String, conflicts: List[String], notes: List[String] }"},{"name":"merge.merge","kind":"fn","old":"7945c978efeddc2f","new":"092fd2476feebc57","interface_changed":false,"affected":[],"module":"merge","text":"/// `base`, `ours` and `theirs` are module texts.\npub fn merge[F: std.fs.Files, C: std.process.Commands](\n  mut files: F,\n  mut run: C,\n  tmp: String,\n  base: String,\n  ours: String,\n  theirs: String,\n) -> Result[merge.Merged, String] {\n  mut o := match parse.parse_module(base, \"\") {\n    Ok(ds) => ds,\n    Err(e) => return Err(f\"base doesn't parse ({e})\"),\n  }\n  mut a := match parse.parse_module(ours, \"\") {\n    Ok(ds) => ds,\n    Err(e) => return Err(f\"ours doesn't parse ({e})\"),\n  }\n  mut b := match parse.parse_module(theirs, \"\") {\n    Ok(ds) => ds,\n    Err(e) => return Err(f\"theirs doesn't parse ({e})\"),\n  }\n  mut notes := []\n  mut conflicts := []\n  ra := merge.renames(o, a)\n  rb := merge.renames(o, b)\n  for (from, to) in ra {\n    mut skip := false\n    match rb.find(r -> r.0 == from) {\n      Some((_, t)) => if t == to {\n        mut notes.push(f\"both sides renamed {from} → {to}\")\n      } else {\n        mut conflicts.push(\n          f\"{from} (renamed to {to} in ours, {t} in theirs)\",\n        )\n        skip = true\n      },\n      None => (),\n    }\n    if skip {\n      continue\n    }\n    o = refactor.rename_all(o, [(from, refactor.short(to))]) !! o\n    if b.any(d -> store.qname(d) == from) {\n      match refactor.rename_all(b, [(from, refactor.short(to))]) {\n        Ok(r) => {\n          b = r\n          mut notes.push(\n            f\"ours renamed {from} → {to}; applied to theirs\",\n          )\n        },\n        Err(e) => mut notes.push(\n          f\"ours renamed {from} → {to}, but theirs can't follow it: {e}\",\n        ),\n      }\n    }\n  }\n  for (from, to) in rb {\n    if ra.any(r -> r.0 == from) {\n      continue\n    }\n    o = refactor.rename_all(o, [(from, refactor.short(to))]) !! o\n    if a.any(d -> store.qname(d) == from) {\n      match refactor.rename_all(a, [(from, refactor.short(to))]) {\n        Ok(r) => {\n          a = r\n          mut notes.push(\n            f\"theirs renamed {from} → {to}; applied to ours\",\n          )\n        },\n        Err(e) => mut notes.push(\n          f\"theirs renamed {from} → {to}, but ours can't follow it: {e}\",\n        ),\n      }\n    }\n  }\n  // ours' order, with each of theirs' new ones after its predecessor\n  mut order := a.map(d -> merge.key(d))\n  for (i, d) in enumerate(b) {\n    q := merge.key(d)\n    if contains(order, q) {\n      continue\n    }\n    mut at := 0\n    mut k := i - 1\n    while k >= 0 {\n      pq := merge.key(get(b, k) ?? d)\n      match [j for (j, n) in enumerate(order) where n == pq] {\n        [j, ..] => {\n          at = j + 1\n          k = -1\n        },\n        [] => {\n          k -= 1\n        },\n      }\n    }\n    order = [n for (j, n) in enumerate(order) where j < at]\n      + [q]\n      + [n for (j, n) in enumerate(order) where j >= at]\n  }\n  find := (ds: List[ast.Decl], q: String) -> ds.find(d -> merge.key(d) == q)\n  mut pieces := []\n  mut from_theirs := 0\n  mut by_line := 0\n  mut by_node := 0\n  mut next_hole := 1\n  mut holes := []\n  nl := (t: String) -> if t == \"\" {\n    t\n  } else {\n    t + \"\\n\"\n  }\n  for q in order {\n    od := find(o, q)\n    ad := find(a, q)\n    bd := find(b, q)\n    match (od, ad, bd) {\n      (_, Some(x), Some(y)) => if merge.canon(x) == merge.canon(y) {\n        mut pieces.push(merge.Merged_decl(x))\n      } else if od is Some && merge.canon(od ?? x) == merge.canon(x) {\n        from_theirs += 1\n        mut pieces.push(merge.Merged_decl(y))\n      } else if od is Some && merge.canon(od ?? y) == merge.canon(y) {\n        mut pieces.push(merge.Merged_decl(x))\n      } else {\n        // node by node from the base; a conflict outside every expression\n        // falls back to the lines\n        mut done := false\n        match od {\n          Some(z) => {\n            t := tree.merge(z, x, y, next_hole)\n            match t.decl {\n              Some(d) => {\n                next_hole += len(t.conflicts)\n                if len(t.conflicts) == 0 {\n                  by_node += 1\n                }\n                for c in t.conflicts {\n                  mut holes.push(f\"{q}: ?{c.name} at {c.path}\")\n                }\n                mut pieces.push(merge.Merged_decl(d))\n                done = true\n              },\n              None => (),\n            }\n          },\n          None => (),\n        }\n        if !done {\n          ot := match od {\n            Some(z) => merge.canon(z),\n            None => \"\",\n          }\n          (text, clean) := merge.line_merge(\n            mut files,\n            mut run,\n            tmp,\n            nl(ot),\n            nl(merge.canon(x)),\n            nl(merge.canon(y)),\n          )!\n          if clean {\n            match parse.parse_module(text, \"\") {\n              Ok([d]) => if merge.decl_name_of(d) == merge.decl_name_of(x) {\n                by_line += 1\n                mut pieces.push(\n                  merge.Merged_decl(\n                    ast.Decl { ..d, module: x.module, public: d.public || x.public && y.public },\n                  ),\n                )\n                done = true\n              },\n              _ => (),\n            }\n          }\n          if !done {\n            mut conflicts.push(q)\n            mut pieces.push(merge.Merged_text(merge.trim_end(text)))\n          }\n        }\n      },\n      (Some(z), Some(x), None) => if merge.canon(z) != merge.canon(x) {\n        mut conflicts.push(f\"{q} (changed in ours, deleted in theirs)\")\n        mut pieces.push(\n          merge.Merged_text(\n            f\"<<<<<<< ours\\n{nl(merge.canon(x))}||||||| base\\n{nl(merge.canon(z))}=======\\n>>>>>>> theirs (deleted)\",\n          ),\n        )\n      },\n      (Some(z), None, Some(y)) => if merge.canon(z) != merge.canon(y) {\n        mut conflicts.push(f\"{q} (deleted in ours, changed in theirs)\")\n        mut pieces.push(\n          merge.Merged_text(\n            f\"<<<<<<< ours (deleted)\\n||||||| base\\n{nl(merge.canon(z))}=======\\n{nl(merge.canon(y))}>>>>>>> theirs\",\n          ),\n        )\n      },\n      (None, Some(x), None) => mut pieces.push(merge.Merged_decl(x)),\n      (None, None, Some(y)) => {\n        from_theirs += 1\n        mut pieces.push(merge.Merged_decl(y))\n      },\n      _ => (),\n    }\n  }\n  if from_theirs > 0 {\n    mut notes.push(\n      f\"{from_theirs} definition{if from_theirs == 1 {\n  \"\"\n} else {\n  \"s\"\n}} from theirs\",\n    )\n  }\n  if by_node > 0 {\n    mut notes.push(\n      f\"{by_node} definition{if by_node == 1 {\n  \"\"\n} else {\n  \"s\"\n}} changed on both sides, merged node by node\",\n    )\n  }\n  if by_line > 0 {\n    mut notes.push(\n      f\"{by_line} definition{if by_line == 1 {\n  \"\"\n} else {\n  \"s\"\n}} changed on both sides, merged line by line\",\n    )\n  }\n  out := pieces.map(\n    p -> match p {\n      merge.Merged_decl(d) => merge.canon(d),\n      merge.Merged_text(t) => t,\n    },\n  )\n  Ok(merge.Merged { text: if len(out) == 0 {\n    \"\"\n  } else {\n    join(out, \"\\n\\n\") + \"\\n\"\n  }, conflicts, notes, holes })\n}","old_text":"/// `base`, `ours` and `theirs` are module texts.\npub fn merge[F: std.fs.Files, C: std.process.Commands](\n  mut files: F,\n  mut run: C,\n  tmp: String,\n  base: String,\n  ours: String,\n  theirs: String,\n) -> Result[merge.Merged, String] {\n  mut o := match parse.parse_module(base, \"\") {\n    Ok(ds) => ds,\n    Err(e) => return Err(f\"base doesn't parse ({e})\"),\n  }\n  mut a := match parse.parse_module(ours, \"\") {\n    Ok(ds) => ds,\n    Err(e) => return Err(f\"ours doesn't parse ({e})\"),\n  }\n  mut b := match parse.parse_module(theirs, \"\") {\n    Ok(ds) => ds,\n    Err(e) => return Err(f\"theirs doesn't parse ({e})\"),\n  }\n  mut notes := []\n  mut conflicts := []\n  ra := merge.renames(o, a)\n  rb := merge.renames(o, b)\n  for (from, to) in ra {\n    mut skip := false\n    match rb.find(r -> r.0 == from) {\n      Some((_, t)) => if t == to {\n        mut notes.push(f\"both sides renamed {from} → {to}\")\n      } else {\n        mut conflicts.push(\n          f\"{from} (renamed to {to} in ours, {t} in theirs)\",\n        )\n        skip = true\n      },\n      None => (),\n    }\n    if skip {\n      continue\n    }\n    o = refactor.rename_all(o, [(from, refactor.short(to))]) !! o\n    if b.any(d -> store.qname(d) == from) {\n      match refactor.rename_all(b, [(from, refactor.short(to))]) {\n        Ok(r) => {\n          b = r\n          mut notes.push(\n            f\"ours renamed {from} → {to}; applied to theirs\",\n          )\n        },\n        Err(e) => mut notes.push(\n          f\"ours renamed {from} → {to}, but theirs can't follow it: {e}\",\n        ),\n      }\n    }\n  }\n  for (from, to) in rb {\n    if ra.any(r -> r.0 == from) {\n      continue\n    }\n    o = refactor.rename_all(o, [(from, refactor.short(to))]) !! o\n    if a.any(d -> store.qname(d) == from) {\n      match refactor.rename_all(a, [(from, refactor.short(to))]) {\n        Ok(r) => {\n          a = r\n          mut notes.push(\n            f\"theirs renamed {from} → {to}; applied to ours\",\n          )\n        },\n        Err(e) => mut notes.push(\n          f\"theirs renamed {from} → {to}, but ours can't follow it: {e}\",\n        ),\n      }\n    }\n  }\n  // ours' order, with each of theirs' new ones after its predecessor\n  mut order := a.map(d -> merge.key(d))\n  for (i, d) in enumerate(b) {\n    q := merge.key(d)\n    if contains(order, q) {\n      continue\n    }\n    mut at := 0\n    mut k := i - 1\n    while k >= 0 {\n      pq := merge.key(get(b, k) ?? d)\n      match [j for (j, n) in enumerate(order) where n == pq] {\n        [j, ..] => {\n          at = j + 1\n          k = -1\n        },\n        [] => {\n          k -= 1\n        },\n      }\n    }\n    order = [n for (j, n) in enumerate(order) where j < at]\n      + [q]\n      + [n for (j, n) in enumerate(order) where j >= at]\n  }\n  find := (ds: List[ast.Decl], q: String) -> ds.find(d -> merge.key(d) == q)\n  mut pieces := []\n  mut from_theirs := 0\n  mut by_line := 0\n  nl := (t: String) -> if t == \"\" {\n    t\n  } else {\n    t + \"\\n\"\n  }\n  for q in order {\n    od := find(o, q)\n    ad := find(a, q)\n    bd := find(b, q)\n    match (od, ad, bd) {\n      (_, Some(x), Some(y)) => if merge.canon(x) == merge.canon(y) {\n        mut pieces.push(merge.Merged_decl(x))\n      } else if od is Some && merge.canon(od ?? x) == merge.canon(x) {\n        from_theirs += 1\n        mut pieces.push(merge.Merged_decl(y))\n      } else if od is Some && merge.canon(od ?? y) == merge.canon(y) {\n        mut pieces.push(merge.Merged_decl(x))\n      } else {\n        ot := match od {\n          Some(z) => merge.canon(z),\n          None => \"\",\n        }\n        (text, clean) := merge.line_merge(\n          mut files,\n          mut run,\n          tmp,\n          nl(ot),\n          nl(merge.canon(x)),\n          nl(merge.canon(y)),\n        )!\n        mut done := false\n        if clean {\n          match parse.parse_module(text, \"\") {\n            Ok([d]) => if merge.decl_name_of(d) == merge.decl_name_of(x) {\n              by_line += 1\n              mut pieces.push(\n                merge.Merged_decl(\n                  ast.Decl { ..d, module: x.module, public: d.public || x.public && y.public },\n                ),\n              )\n              done = true\n            },\n            _ => (),\n          }\n        }\n        if !done {\n          mut conflicts.push(q)\n          mut pieces.push(merge.Merged_text(merge.trim_end(text)))\n        }\n      },\n      (Some(z), Some(x), None) => if merge.canon(z) != merge.canon(x) {\n        mut conflicts.push(f\"{q} (changed in ours, deleted in theirs)\")\n        mut pieces.push(\n          merge.Merged_text(\n            f\"<<<<<<< ours\\n{nl(merge.canon(x))}||||||| base\\n{nl(merge.canon(z))}=======\\n>>>>>>> theirs (deleted)\",\n          ),\n        )\n      },\n      (Some(z), None, Some(y)) => if merge.canon(z) != merge.canon(y) {\n        mut conflicts.push(f\"{q} (deleted in ours, changed in theirs)\")\n        mut pieces.push(\n          merge.Merged_text(\n            f\"<<<<<<< ours (deleted)\\n||||||| base\\n{nl(merge.canon(z))}=======\\n{nl(merge.canon(y))}>>>>>>> theirs\",\n          ),\n        )\n      },\n      (None, Some(x), None) => mut pieces.push(merge.Merged_decl(x)),\n      (None, None, Some(y)) => {\n        from_theirs += 1\n        mut pieces.push(merge.Merged_decl(y))\n      },\n      _ => (),\n    }\n  }\n  if from_theirs > 0 {\n    mut notes.push(\n      f\"{from_theirs} definition{if from_theirs == 1 {\n  \"\"\n} else {\n  \"s\"\n}} from theirs\",\n    )\n  }\n  if by_line > 0 {\n    mut notes.push(\n      f\"{by_line} definition{if by_line == 1 {\n  \"\"\n} else {\n  \"s\"\n}} changed on both sides, merged line by line\",\n    )\n  }\n  out := pieces.map(\n    p -> match p {\n      merge.Merged_decl(d) => merge.canon(d),\n      merge.Merged_text(t) => t,\n    },\n  )\n  Ok(merge.Merged { text: if len(out) == 0 {\n    \"\"\n  } else {\n    join(out, \"\\n\\n\") + \"\\n\"\n  }, conflicts, notes })\n}"},{"name":"merge.use tree","kind":"use","old":null,"new":"6798b196e1ce863b","interface_changed":true,"affected":[],"module":"merge","text":"use tree"}]}
{"id":"fecf32818db66343","time":1795709435,"message":"edit","changes":[{"name":"merge_file_command","kind":"fn","old":"e250de0c242fe3d2","new":"cf4a2d17d732e445","interface_changed":false,"affected":[],"module":"","text":"/// `strata merge-file BASE OURS THEIRS [PATH]` (git: `%O %A %B %P`):\n/// merges the three versions definition by definition, and inside a\n/// definition changed on both sides node by node, into OURS, then checks.\n/// A node in conflict is left in OURS as a hole, `?conflict_N(ours, base,\n/// theirs)` (`strata holes` lists them); a conflict outside every\n/// expression leaves OURS as text with conflict markers.\nfn merge_file_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  args: List[String],\n) -> std.process.ExitCode {\n  (o, a, b) := match args {\n    [o, a, b, ..] => (o, a, b),\n    _ => return fail_with(\n      mut console,\n      \"usage: strata merge-file BASE OURS THEIRS [PATH]  (git: `strata merge-file %O %A %B %P`)\",\n    ),\n  }\n  path := get(args, 3) ?? a\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  core := read_core_at(disk, home)\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  read := (f: String) -> match disk.read_bytes(f) {\n    Ok([]) => Ok([]),\n    Ok(bytes) => match binary.read(bytes) {\n      Ok(img) => Ok(img.decls),\n      Err(e) => Err(e),\n    },\n    Err(e) => Err(f\"{f}: {e}\"),\n  }\n  (base, ours, theirs) := match (read(o), read(a), read(b)) {\n    (Ok(x), Ok(y), Ok(z)) => (x, y, z),\n    (x, y, z) => {\n      es := [e for e in [x, y, z].map(\n        r -> match r {\n          Err(e) => e,\n          Ok(_) => \"\",\n        },\n      ) where e != \"\"]\n      mut console.eprint(\n        f\"strata: {path}: can't merge: {join(es, \"; \")}\",\n      )\n      return 1\n    },\n  }\n  // (the module as the sides store it. A package's own name for it can\n  // differ: core's `core.list` is the file `list.strata`. Else the module the\n  // file is in its package. A side stored as a script, `save`d or `--file`\n  // edited, has its definitions in no module.)\n  module := match [d.module for d in ours + theirs + base where d.module != \"\"] {\n    [m, ..] => m,\n    [] => match module_at(disk, path) {\n      Some((_, m)) => m,\n      None => \"\",\n    },\n  }\n  relabel := (ds: List[ast.Decl]) -> ds.map(d -> ast.Decl { ..d, module })\n  // (each side written against the package's other modules, as `render`\n  // shows it. A name a module imports stays short, `helper()`: written in\n  // full, `util.helper()`, a local named `util` would read it, once stored\n  // again, as that local's method.)\n  others := others_at_stored(disk, path, module, std, core)\n  side_text := (ds: List[ast.Decl]) ->\n    resolve.written(others + relabel(ds), std, core).filter(\n      d -> d.module == module,\n    )\n  text := (ds: List[ast.Decl]) -> text.module_text(side_text(ds))\n  tmp := (process.var(\"TMPDIR\") ?? \"/tmp\")\n    + \"/strata-merge-\"\n    + f\"{byte_len(path)}-{byte_len(o)}\"\n  m := match merge.merge(\n    mut disk,\n    mut launcher,\n    tmp,\n    text(base),\n    text(ours),\n    text(theirs),\n  ) {\n    Ok(m) => m,\n    Err(e) => return fail_with(mut console, e),\n  }\n  for n in m.notes {\n    mut console.eprint(f\"strata: {path}: {n}\")\n  }\n  if len(m.conflicts) > 0 {\n    mut disk.write(a, m.text) !! ()\n    for c in m.conflicts {\n      mut console.eprint(f\"strata: {path}: conflict in {c}\")\n    }\n    mut console.eprint(\n      f\"strata: {path} is left as text with conflict markers: fix it, then `strata resolve {path}` stores it\",\n    )\n    return 1\n  }\n  merged := match parse.parse_module(m.text, module) {\n    Ok(ds) => ds,\n    Err(e) => return fail_with(mut console, f\"{path}: the merge doesn't parse ({e})\"),\n  }\n  // a definition taken whole from one side keeps that side's stored form:\n  // read back from its text, a name it shows in full (`cache.caching()`)\n  // would be taken for a method of a local of the module's name\n  kept := (side: List[ast.Decl]) -> {\n    ws := side_text(side)\n    own := relabel(side)\n    if len(ws) == len(own) {\n      zip(ws.map(w -> text.decl_text(w)), own)\n    } else {\n      []\n    }\n  }\n  whole := kept(ours) + kept(theirs)\n  final := kept_decls(disk, path, module, merged, whole, std, core)\n  match mut disk.write_bytes(\n    a,\n    binary.encode_module(final, module, store.graph(\n      others_at_stored(disk, path, module, std, core) + final,\n      false,\n    )),\n  ) {\n    Err(e) => return fail_with(mut console, f\"{a}: {e}\"),\n    Ok(_) => (),\n  }\n  if len(m.holes) > 0 {\n    for h in m.holes {\n      mut console.eprint(f\"strata: {path}: conflict in {h}\")\n    }\n    mut console.eprint(\n      f\"strata: {path}: each conflict is a hole `?conflict_N(ours, base, theirs)`: replace it with the code to keep (`strata edit`), then `git add {path}`\",\n    )\n    return 1\n  }\n  if process.var(\"STRATA_MERGE_BASE\") is Some {\n    return 0\n  }\n  // what doesn't check now that checked on both sides\n  others := match module_at(disk, path) {\n    Some((r, _)) => package_decls(disk, r, module_prefix(disk, r)).filter(\n      d -> d.module != module,\n    ),\n    None => [],\n  }\n  // (`[values] read = true`: the package may read compiled values back)\n  values := match module_at(disk, path) {\n    Some((r, _)) => package_reads_values(disk, r),\n    None => false,\n  }\n  errors_of := (side: List[ast.Decl]) -> {\n    all := resolve.stored(\n      others + side.map(d -> ast.Decl { ..d, module }),\n      std,\n      core,\n    )\n    lib := std_imports(disk, std_dir, all)\n    check_errors_of(all, lib, core, values).map(\n      e -> f\"{e.0}: {e.1}\",\n    )\n  }\n  known := errors_of(ours) + errors_of(theirs)\n  fresh := errors_of(final).filter(e -> !contains(known, e))\n  if len(fresh) > 0 {\n    mut console.eprint(\n      f\"strata: {path}: merged definition by definition, but the result doesn't check:\",\n    )\n    for e in fresh {\n      mut console.eprint(f\"    {e}\")\n    }\n    return 1\n  }\n  0\n}","old_text":"/// `strata merge-file BASE OURS THEIRS [PATH]` (git: `%O %A %B %P`):\n/// merges the three versions definition by definition into OURS, then\n/// checks. A conflict leaves OURS as text with conflict markers.\nfn merge_file_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  args: List[String],\n) -> std.process.ExitCode {\n  (o, a, b) := match args {\n    [o, a, b, ..] => (o, a, b),\n    _ => return fail_with(\n      mut console,\n      \"usage: strata merge-file BASE OURS THEIRS [PATH]  (git: `strata merge-file %O %A %B %P`)\",\n    ),\n  }\n  path := get(args, 3) ?? a\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  core := read_core_at(disk, home)\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  read := (f: String) -> match disk.read_bytes(f) {\n    Ok([]) => Ok([]),\n    Ok(bytes) => match binary.read(bytes) {\n      Ok(img) => Ok(img.decls),\n      Err(e) => Err(e),\n    },\n    Err(e) => Err(f\"{f}: {e}\"),\n  }\n  (base, ours, theirs) := match (read(o), read(a), read(b)) {\n    (Ok(x), Ok(y), Ok(z)) => (x, y, z),\n    (x, y, z) => {\n      es := [e for e in [x, y, z].map(\n        r -> match r {\n          Err(e) => e,\n          Ok(_) => \"\",\n        },\n      ) where e != \"\"]\n      mut console.eprint(\n        f\"strata: {path}: can't merge: {join(es, \"; \")}\",\n      )\n      return 1\n    },\n  }\n  // (the module as the sides store it. A package's own name for it can\n  // differ: core's `core.list` is the file `list.strata`. Else the module the\n  // file is in its package. A side stored as a script, `save`d or `--file`\n  // edited, has its definitions in no module.)\n  module := match [d.module for d in ours + theirs + base where d.module != \"\"] {\n    [m, ..] => m,\n    [] => match module_at(disk, path) {\n      Some((_, m)) => m,\n      None => \"\",\n    },\n  }\n  relabel := (ds: List[ast.Decl]) -> ds.map(d -> ast.Decl { ..d, module })\n  // (each side written against the package's other modules, as `render`\n  // shows it. A name a module imports stays short, `helper()`: written in\n  // full, `util.helper()`, a local named `util` would read it, once stored\n  // again, as that local's method.)\n  others := others_at_stored(disk, path, module, std, core)\n  side_text := (ds: List[ast.Decl]) ->\n    resolve.written(others + relabel(ds), std, core).filter(\n      d -> d.module == module,\n    )\n  text := (ds: List[ast.Decl]) -> text.module_text(side_text(ds))\n  tmp := (process.var(\"TMPDIR\") ?? \"/tmp\")\n    + \"/strata-merge-\"\n    + f\"{byte_len(path)}-{byte_len(o)}\"\n  m := match merge.merge(\n    mut disk,\n    mut launcher,\n    tmp,\n    text(base),\n    text(ours),\n    text(theirs),\n  ) {\n    Ok(m) => m,\n    Err(e) => return fail_with(mut console, e),\n  }\n  for n in m.notes {\n    mut console.eprint(f\"strata: {path}: {n}\")\n  }\n  if len(m.conflicts) > 0 {\n    mut disk.write(a, m.text) !! ()\n    for c in m.conflicts {\n      mut console.eprint(f\"strata: {path}: conflict in {c}\")\n    }\n    mut console.eprint(\n      f\"strata: {path} is left as text with conflict markers: fix it, then `strata resolve {path}` stores it\",\n    )\n    return 1\n  }\n  merged := match parse.parse_module(m.text, module) {\n    Ok(ds) => ds,\n    Err(e) => return fail_with(mut console, f\"{path}: the merge doesn't parse ({e})\"),\n  }\n  // a definition taken whole from one side keeps that side's stored form:\n  // read back from its text, a name it shows in full (`cache.caching()`)\n  // would be taken for a method of a local of the module's name\n  kept := (side: List[ast.Decl]) -> {\n    ws := side_text(side)\n    own := relabel(side)\n    if len(ws) == len(own) {\n      zip(ws.map(w -> text.decl_text(w)), own)\n    } else {\n      []\n    }\n  }\n  whole := kept(ours) + kept(theirs)\n  final := kept_decls(disk, path, module, merged, whole, std, core)\n  match mut disk.write_bytes(\n    a,\n    binary.encode_module(final, module, store.graph(\n      others_at_stored(disk, path, module, std, core) + final,\n      false,\n    )),\n  ) {\n    Err(e) => return fail_with(mut console, f\"{a}: {e}\"),\n    Ok(_) => (),\n  }\n  if process.var(\"STRATA_MERGE_BASE\") is Some {\n    return 0\n  }\n  // what doesn't check now that checked on both sides\n  others := match module_at(disk, path) {\n    Some((r, _)) => package_decls(disk, r, module_prefix(disk, r)).filter(\n      d -> d.module != module,\n    ),\n    None => [],\n  }\n  // (`[values] read = true`: the package may read compiled values back)\n  values := match module_at(disk, path) {\n    Some((r, _)) => package_reads_values(disk, r),\n    None => false,\n  }\n  errors_of := (side: List[ast.Decl]) -> {\n    all := resolve.stored(\n      others + side.map(d -> ast.Decl { ..d, module }),\n      std,\n      core,\n    )\n    lib := std_imports(disk, std_dir, all)\n    check_errors_of(all, lib, core, values).map(\n      e -> f\"{e.0}: {e.1}\",\n    )\n  }\n  known := errors_of(ours) + errors_of(theirs)\n  fresh := errors_of(final).filter(e -> !contains(known, e))\n  if len(fresh) > 0 {\n    mut console.eprint(\n      f\"strata: {path}: merged definition by definition, but the result doesn't check:\",\n    )\n    for e in fresh {\n      mut console.eprint(f\"    {e}\")\n    }\n    return 1\n  }\n  0\n}"}]}
{"id":"a431db4a37b28ed3","time":1795709618,"message":"edit","changes":[{"name":"diff.Item","kind":"type","old":"26264fd80ba00fce","new":"c32dcfb3817b11ab","interface_changed":true,"affected":["diff.Diff","diff.diff","diff_json","tour.change_of","diff.diff_text","diff.range_diff","diff.nodes_text","diff_command","tour.package_changes","diff.range_text","command_line","tour.prepare","main","tour_command","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","tour_graph","linked","expanded","comptime_runner","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","rename_command","move_command","fix_command","edit_in_editor"],"module":"diff","text":"/// One definition's change, in its section (`Types`, `Interfaces`,\n/// `Implementations`, `Tests`). `mk`: `add`, `del`, `ren` (renamed) or `chg`.\npub type Item = {\n  section: String,\n  id: String,\n  mk: String,\n  what: List[String],\n  detail: List[String],\n  doc_diff: Option[List[diff.Seg]],\n  lines: List[diff.Line],\n  refs: List[String],\n  // the name it had (`None`: added), how it is shown, its kind and module\n  old_id: Option[String] = None,\n  label: String = \"\",\n  kind: String = \"\",\n  module: String = \"\",\n  // its doc after the change (`None`: removed)\n  doc: Option[String] = None,\n  rewritten: Bool = false,\n  interface_changed: Bool = false,\n  // what uses it directly, and whether this change updated it; how much\n  // depends on it in all\n  affected: List[(String, Bool)] = [],\n  affected_total: Int = 0,\n  // the references that only follow its rename, folded into it\n  refs_folded: List[String] = [],\n  // the steps of the range that touch it\n  steps: List[Int] = [],\n  // its verdict before and after\n  verdict_before: Option[String] = None,\n  verdict_after: Option[String] = None,\n  // the nodes that changed (compiler/tree), and both sides as written, to\n  // show them with those nodes marked\n  nodes: List[diff.NodeChange] = [],\n  old_decl: Option[ast.Decl] = None,\n  new_decl: Option[ast.Decl] = None,\n}","old_text":"/// One definition's change, in its section (`Types`, `Interfaces`,\n/// `Implementations`, `Tests`). `mk`: `add`, `del`, `ren` (renamed) or `chg`.\npub type Item = {\n  section: String,\n  id: String,\n  mk: String,\n  what: List[String],\n  detail: List[String],\n  doc_diff: Option[List[diff.Seg]],\n  lines: List[diff.Line],\n  refs: List[String],\n  // the name it had (`None`: added), how it is shown, its kind and module\n  old_id: Option[String] = None,\n  label: String = \"\",\n  kind: String = \"\",\n  module: String = \"\",\n  // its doc after the change (`None`: removed)\n  doc: Option[String] = None,\n  rewritten: Bool = false,\n  interface_changed: Bool = false,\n  // what uses it directly, and whether this change updated it; how much\n  // depends on it in all\n  affected: List[(String, Bool)] = [],\n  affected_total: Int = 0,\n  // the references that only follow its rename, folded into it\n  refs_folded: List[String] = [],\n  // the steps of the range that touch it\n  steps: List[Int] = [],\n  // its verdict before and after\n  verdict_before: Option[String] = None,\n  verdict_after: Option[String] = None,\n}"},{"name":"diff.diff","kind":"fn","old":"fb290dde2622458a","new":"069b061ebd505be9","interface_changed":false,"affected":[],"module":"diff","text":"pub fn diff[F: std.fs.Files](\n  files: F,\n  verdicts: diff.Verdicts,\n  old: diff.Version,\n  new: diff.Version,\n  recorded: List[(String, String)],\n  steps: List[(Int, List[String])],\n  std: List[ast.Decl],\n  core: builtins.Core,\n) -> diff.Diff {\n  // each side's dependency graph and code hashes, only if there are\n  // verdicts to look up\n  looking := verdicts.root is Some\n  hashes := (p: List[ast.Decl]) -> dict(p.map(\n    d -> (diff.qname(d), codebase.short_hex(binary.code_hash(d))),\n  ))\n  old_graph := if looking {\n    store.graph(old.decls, false)\n  } else {\n    Dict[String, List[String]] {}\n  }\n  // what refers to what, from each side as stored; as written, a name an\n  // import shortens is not qualified\n  new_graph := store.graph(new.decls, false)\n  // what uses each definition directly, worked out once\n  users_of := diff.users_by(new_graph)\n  old_hashes := if looking {\n    hashes(old.decls)\n  } else {\n    Dict[String, String] {}\n  }\n  new_hashes := if looking {\n    hashes(new.decls)\n  } else {\n    Dict[String, String] {}\n  }\n  closure_old := (n: String) -> if looking {\n    diff.closure_hash(old_graph, old_hashes, n)\n  } else {\n    \"\"\n  }\n  closure_new := (n: String) -> if looking {\n    diff.closure_hash(new_graph, new_hashes, n)\n  } else {\n    \"\"\n  }\n  // renames of a variant, trait method or field: (from, to, kind, owning definition)\n  mut members := []\n  for (f, t) in recorded {\n    match refactor.member(old.decls, f) {\n      Some((k, _)) => if (k == \"variant\" || k == \"method\" || k == \"field\")\n        && refactor.member(new.decls, t) is Some {\n        match refactor.owner(old.decls, f) {\n          Some(o) => mut members.push((f, t, k, o)),\n          None => (),\n        }\n      },\n      None => (),\n    }\n  }\n  owners := set(members.map(m -> m.3))\n  renames := diff.effective_renames(old.decls, new.decls, recorded)\n  // code that only follows a rename: definitions' and members' short names\n  substitutions := renames + members.map(m -> (m.0, m.1))\n  // the definitions that differ, written out as `strata render` shows them\n  om := diff.written_changes(old, new, std, core)\n  nm := diff.written_changes(new, old, std, core)\n  renamed_to := dict(renames.map(r -> (r.1, r.0)))\n  renamed_from := set(renames.map(r -> r.0))\n  // pairs (old, new) in the new program's order, then removals\n  mut pairs := []\n  for s in new.decls {\n    q := diff.qname(s)\n    match get(nm, q) {\n      Some(d) => if contains(old.hashes, q) {\n        mut pairs.push((get(om, q), Some(d), d))\n      } else {\n        match get(renamed_to, q) {\n          Some(f) => mut pairs.push((get(om, f), Some(d), d)),\n          None => mut pairs.push((None, Some(d), d)),\n        }\n      },\n      None => (),\n    }\n  }\n  for s in old.decls {\n    q := diff.qname(s)\n    if !contains(new.hashes, q) && !contains(renamed_from, q) {\n      match get(om, q) {\n        Some(d) => mut pairs.push((Some(d), None, d)),\n        None => (),\n      }\n    }\n  }\n  // the new side's names among the changes\n  paired := set(\n    [diff.qname(n) for p in pairs where p.1 is Some for n in [p.1 ?? p.2]],\n  )\n  // definitions that only follow a rename are folded into it\n  mut refs_of := Dict[String, List[String]] {}\n  mut ref_only := Set[String] {}\n  if len(substitutions) > 0 {\n    for (po, pn, _) in pairs {\n      match (po, pn) {\n        (Some(o), Some(n)) => {\n          // the type or trait that declares a renamed member is shown, not folded\n          if diff.qname(o) != diff.qname(n)\n            || diff.prose(o) != diff.prose(n)\n            || contains(owners, diff.qname(o)) {\n            continue\n          }\n          oc := diff.code(o)\n          nc := diff.code(n)\n          ot := merge.tokens(oc)\n          nt := merge.tokens(nc)\n          for (f, t) in substitutions {\n            if contains(ot, refactor.short(f))\n              && contains(nt, refactor.short(t)) {\n              mut refs_of.insert(\n                t,\n                (get(refs_of, t) ?? []) + [diff.qname(n)],\n              )\n            }\n          }\n          if diff.substitute(oc, substitutions) == nc {\n            mut ref_only.insert(diff.qname(n))\n          }\n        },\n        _ => (),\n      }\n    }\n  }\n  mut items := []\n  mut added := 0\n  mut removed := 0\n  mut renamed := 0\n  mut changed := 0\n  mut iface := 0\n  for (po, pn, d) in pairs {\n    p := (po, pn)\n    q := diff.qname(d)\n    if contains(ref_only, q) {\n      continue\n    }\n    kind := diff.kind_str(d)\n    mut mk := \"\"\n    mut what := []\n    mut shown := []\n    mut interface_changed := true\n    mut rewritten := false\n    match p {\n      (None, Some(n)) => {\n        added += 1\n        mk = \"add\"\n        what = [\"added\"]\n        shown = lines(diff.code(n)).map(l -> diff.Line { s: \"+\", text: l })\n      },\n      (Some(o), None) => {\n        removed += 1\n        mk = \"del\"\n        what = [\"removed\"]\n        shown = lines(diff.code(o)).map(l -> diff.Line { s: \"-\", text: l })\n      },\n      (Some(o), Some(n)) => {\n        is_rename := diff.qname(o) != diff.qname(n)\n        interface_changed = is_rename\n          || binary.interface_hash(o) != binary.interface_hash(n)\n        oc := diff.code(o)\n        nc := diff.code(n)\n        (ls, rw) := diff.line_diff(oc, nc)\n        rewritten = rw\n        ls2 := diff.annotate(ls, oc, kind, if is_rename {\n          []\n        } else {\n          renames\n        })\n        // a move keeps the short name and changes the module\n        moved := is_rename\n          && refactor.short(diff.qname(o)) == refactor.short(diff.qname(n))\n        what = if moved {\n          [\"moved from `\"\n            + if o.module == \"\" {\n              \"main\"\n            } else {\n              o.module\n            }\n            + \"`\"]\n        } else if is_rename {\n          [\"renamed from `\" + refactor.short(diff.qname(o)) + \"`\"]\n        } else {\n          []\n        }\n        // a rename alone changes only the name\n        mut rest := if is_rename {\n          diff.substitute(oc, renames) != nc\n            || diff.prose(o) != diff.prose(n)\n        } else {\n          true\n        }\n        // a renamed member: say so, then whatever else changed, compared with the\n        // old definition with the rename applied\n        if !is_rename {\n          for (f, t, k, ow) in members {\n            if ow != q {\n              continue\n            }\n            mut what.push(\n              k\n                + \" `\"\n                + refactor.short(f)\n                + \"` renamed to `\"\n                + refactor.short(t)\n                + \"`\",\n            )\n            o2 := match refactor.rename_all(old.decls, [(f, refactor.short(t))]) {\n              Ok(r) => match diff.index_of_decl(r, q) {\n                Some(i) => get(resolve.written_at(r, set([i]), std, core), 0),\n                None => None,\n              },\n              Err(_) => None,\n            }\n            match o2 {\n              Some(x) => if !(diff.code(x) == nc && diff.prose(x) == diff.prose(n)) {\n                what += diff.change_words(x, n)\n              },\n              None => {\n                what += diff.change_words(o, n)\n              },\n            }\n            rest = false\n          }\n        }\n        if rest {\n          ws := diff.change_words(o, n)\n          if !(is_rename\n            && ws == [\"signature changed\"]\n            && diff.substitute(oc, renames) == nc) {\n            what += ws\n          }\n        }\n        if is_rename {\n          renamed += 1\n        } else {\n          changed += 1\n        }\n        if interface_changed {\n          iface += 1\n        }\n        mk = if is_rename {\n          \"ren\"\n        } else {\n          \"chg\"\n        }\n        shown = diff.fold_lines(ls2, kind)\n      },\n      _ => (),\n    }\n    // for the reader: what uses it directly, and how much depends on it in all\n    users := get(users_of, q) ?? []\n    total := diff.dependents_count(users_of, q)\n    mut detail := []\n    if rewritten {\n      mut detail.push(\n        \"most of it changed, so it is shown as a line diff\",\n      )\n    }\n    only_renamed := mk == \"ren\" && len(what) == 1\n    member_only := contains(owners, q)\n      && what.all(w -> contains(w, \"` renamed to `\"))\n    if member_only {\n      r := sum(members\n        .filter(m -> m.3 == q)\n        .map(m -> len(get(refs_of, m.1) ?? [])))\n      mut detail.push(\n        f\"only a name changed · {r} reference{diff.plural(r)} updated\",\n      )\n    } else if only_renamed {\n      r := len(get(refs_of, q) ?? [])\n      what_changed := if starts_with(get(what, 0) ?? \"\", \"moved\") {\n        \"its module\"\n      } else {\n        \"the name\"\n      }\n      mut detail.push(\n        f\"only {what_changed} changed · {r} reference{diff.plural(r)} updated\",\n      )\n    } else if what == [\"doc changed\"] || what == [\"comments changed\"] {\n      mut detail.push(\n        \"only the \"\n          + if what == [\"doc changed\"] {\n            \"doc\"\n          } else {\n            \"comments\"\n          }\n          + \" changed · interface unchanged\",\n      )\n    } else if mk == \"chg\" && kind == \"impl\" {\n      match d.kind {\n        ast.ImplDef(i) => mut detail.push(\n          if i.trait_name == \"\" {\n            \"methods of `\"\n              + refactor.short(diff.type_head(i.for_type))\n              + \"` · checked against the contracts of the traits they serve\"\n          } else {\n            \"implementation of `\"\n              + refactor.short(i.trait_name)\n              + \"` · checked against its contracts\"\n          },\n        ),\n        _ => (),\n      }\n    } else if mk == \"chg\" || mk == \"ren\" {\n      if kind == \"trait\"\n        && what.any(\n          w -> contains(w, \"added\") || contains(w, \"stronger\"),\n        ) {\n        impls := len(new.decls.filter(\n          x -> match x.kind {\n            ast.ImplDef(i) => refactor.short(i.trait_name) == refactor.short(q),\n            _ => false,\n          },\n        ))\n        mut detail.push(\n          f\"every implementation must follow · {impls} in the codebase\",\n        )\n      } else if interface_changed && kind != \"test\" {\n        mut detail.push(\n          if len(users) == 0 {\n            \"interface changed · nothing uses it\"\n          } else {\n            \"interface changed · used by \"\n              + f\"{len(users)}\"\n              + if total > len(users) {\n                f\", {total} depend on it in all\"\n              } else {\n                \"\"\n              }\n          },\n        )\n      } else if kind != \"test\" {\n        mut detail.push(\n          \"implementation only · nothing else needs re-checking\",\n        )\n      }\n    }\n    if mk == \"add\" {\n      match p {\n        (_, Some(n)) => if len(n.doc) > 0 {\n          mut detail.push(diff.prose(n))\n        },\n        _ => (),\n      }\n    }\n    doc_diff := match p {\n      (Some(o), Some(n)) => if diff.prose(o) != diff.prose(n) {\n        Some(diff.segments(diff.prose(o), diff.prose(n)))\n      } else {\n        None\n      },\n      _ => None,\n    }\n    owned := [diff.qname(x) for x in [p.0, p.1] where x is Some for x in [x ?? d]]\n    affected := if interface_changed\n      && p.0 is Some\n      && p.1 is Some\n      && kind != \"impl\" {\n      users.map(x -> (x, contains(paired, x)))\n    } else {\n      []\n    }\n    mut items.push(\n      diff.Item {\n        section: diff.section(kind, mk, interface_changed),\n        id: q,\n        mk,\n        what,\n        detail,\n        doc_diff,\n        lines: shown,\n        refs: get(refs_of, q) ?? [],\n        old_id: match p.0 {\n          Some(o) => Some(diff.qname(o)),\n          None => None,\n        },\n        label: match p {\n          (Some(o), Some(n)) => if diff.qname(o) != diff.qname(n) {\n            diff.label_of(o) + \" → \" + diff.label_of(n)\n          } else {\n            diff.label_of(d)\n          },\n          _ => diff.label_of(d),\n        },\n        kind,\n        module: d.module,\n        doc: match p.1 {\n          Some(n) => Some(diff.prose(n)),\n          None => None,\n        },\n        rewritten,\n        interface_changed,\n        affected,\n        affected_total: if affected == [] {\n          0\n        } else {\n          total\n        },\n        refs_folded: (get(refs_of, q) ?? []).filter(x -> contains(ref_only, x)),\n        steps: [s.0 for s in steps where s.1.any(x -> owned.contains(x))],\n        verdict_before: match p.0 {\n          Some(o) => Some(diff.verdict_word(diff.verdict_of(\n            files,\n            verdicts,\n            closure_old(diff.qname(o)),\n          ))),\n          None => None,\n        },\n        verdict_after: match p.1 {\n          Some(n) => Some(diff.verdict_word(diff.verdict_of(\n            files,\n            verdicts,\n            closure_new(diff.qname(n)),\n          ))),\n          None => None,\n        },\n        nodes: match p {\n          (Some(o), Some(n)) => diff.node_changes(o, n),\n          _ => [],\n        },\n        old_decl: p.0,\n        new_decl: p.1,\n      },\n    )\n  }\n  // verification before and after: what changed, and dependents whose result changed\n  mut checks := []\n  mut rechecked_same := 0\n  // only a change, or what depends on one, can have a new verdict\n  // (and what used a definition that went)\n  gone := [diff.qname(o) for p in pairs where p.0 is Some for o in [p.0 ?? p.2]]\n  rechecked := union(\n    diff.dependents_of_all(users_of, to_list(paired)),\n    if looking {\n      diff.dependents_of_all(diff.users_by(old_graph), gone)\n    } else {\n      Set[String] {}\n    },\n  )\n  for d in new.decls {\n    q := diff.qname(d)\n    if !contains(rechecked, q) {\n      continue\n    }\n    oq := get(renamed_to, q) ?? q\n    before_hash := if contains(old.hashes, oq) {\n      Some(closure_old(oq))\n    } else {\n      None\n    }\n    after_hash := closure_new(q)\n    if before_hash == Some(after_hash) {\n      continue\n    }\n    b := match before_hash {\n      Some(h) => diff.verdict_of(files, verdicts, h),\n      None => None,\n    }\n    a := diff.verdict_of(files, verdicts, after_hash)\n    is_fn := match d.kind {\n      ast.FnDef(_) => true,\n      _ => false,\n    }\n    if b is None && a is None && !(before_hash is None && is_fn) {\n      continue\n    }\n    changed_here := contains(paired, q)\n    // a dependent gets a row only if both results are known and differ\n    if before_hash is Some && !changed_here {\n      known := match (b, a) {\n        (Some(x), Some(y)) => if x.status == y.status {\n          1\n        } else {\n          2\n        },\n        _ => 0,\n      }\n      if known == 1 {\n        rechecked_same += 1\n      }\n      if known != 2 {\n        continue\n      }\n    }\n    why := if before_hash is None {\n      \"new definition\"\n    } else if changed_here {\n      \"changed\"\n    } else {\n      \"something it depends on changed\"\n    }\n    after := if a is None && before_hash is Some {\n      \"not verified yet\"\n    } else {\n      diff.verdict_word(a)\n    }\n    mut checks.push(\n      diff.Check { name: q, before: match before_hash {\n        Some(_) => Some(diff.verdict_word(b)),\n        None => None,\n      }, after, why },\n    )\n  }\n  diff.Diff {\n    added,\n    removed,\n    renamed,\n    changed,\n    interface_changes: iface,\n    items,\n    checks,\n    rechecked_same,\n    follow_renames: len(to_list(ref_only)),\n  }\n}","old_text":"/// The changes from `old` to `new`, each as an `Item`, with what verification\n/// found before and after. `recorded`: the renames made in between;\n/// `steps`: the definitions each step of the range touched. Only the\n/// definitions whose hash differs are written out and compared: the cost\n/// follows what changed, plus a walk of each side's scopes and its\n/// dependency graph.\npub fn diff[F: std.fs.Files](\n  files: F,\n  verdicts: diff.Verdicts,\n  old: diff.Version,\n  new: diff.Version,\n  recorded: List[(String, String)],\n  steps: List[(Int, List[String])],\n  std: List[ast.Decl],\n  core: builtins.Core,\n) -> diff.Diff {\n  // each side's dependency graph and code hashes, only if there are\n  // verdicts to look up\n  looking := verdicts.root is Some\n  hashes := (p: List[ast.Decl]) -> dict(p.map(\n    d -> (diff.qname(d), codebase.short_hex(binary.code_hash(d))),\n  ))\n  old_graph := if looking {\n    store.graph(old.decls, false)\n  } else {\n    Dict[String, List[String]] {}\n  }\n  // what refers to what, from each side as stored; as written, a name an\n  // import shortens is not qualified\n  new_graph := store.graph(new.decls, false)\n  // what uses each definition directly, worked out once\n  users_of := diff.users_by(new_graph)\n  old_hashes := if looking {\n    hashes(old.decls)\n  } else {\n    Dict[String, String] {}\n  }\n  new_hashes := if looking {\n    hashes(new.decls)\n  } else {\n    Dict[String, String] {}\n  }\n  closure_old := (n: String) -> if looking {\n    diff.closure_hash(old_graph, old_hashes, n)\n  } else {\n    \"\"\n  }\n  closure_new := (n: String) -> if looking {\n    diff.closure_hash(new_graph, new_hashes, n)\n  } else {\n    \"\"\n  }\n  // renames of a variant, trait method or field: (from, to, kind, owning definition)\n  mut members := []\n  for (f, t) in recorded {\n    match refactor.member(old.decls, f) {\n      Some((k, _)) => if (k == \"variant\" || k == \"method\" || k == \"field\")\n        && refactor.member(new.decls, t) is Some {\n        match refactor.owner(old.decls, f) {\n          Some(o) => mut members.push((f, t, k, o)),\n          None => (),\n        }\n      },\n      None => (),\n    }\n  }\n  owners := set(members.map(m -> m.3))\n  renames := diff.effective_renames(old.decls, new.decls, recorded)\n  // code that only follows a rename: definitions' and members' short names\n  substitutions := renames + members.map(m -> (m.0, m.1))\n  // the definitions that differ, written out as `strata render` shows them\n  om := diff.written_changes(old, new, std, core)\n  nm := diff.written_changes(new, old, std, core)\n  renamed_to := dict(renames.map(r -> (r.1, r.0)))\n  renamed_from := set(renames.map(r -> r.0))\n  // pairs (old, new) in the new program's order, then removals\n  mut pairs := []\n  for s in new.decls {\n    q := diff.qname(s)\n    match get(nm, q) {\n      Some(d) => if contains(old.hashes, q) {\n        mut pairs.push((get(om, q), Some(d), d))\n      } else {\n        match get(renamed_to, q) {\n          Some(f) => mut pairs.push((get(om, f), Some(d), d)),\n          None => mut pairs.push((None, Some(d), d)),\n        }\n      },\n      None => (),\n    }\n  }\n  for s in old.decls {\n    q := diff.qname(s)\n    if !contains(new.hashes, q) && !contains(renamed_from, q) {\n      match get(om, q) {\n        Some(d) => mut pairs.push((Some(d), None, d)),\n        None => (),\n      }\n    }\n  }\n  // the new side's names among the changes\n  paired := set(\n    [diff.qname(n) for p in pairs where p.1 is Some for n in [p.1 ?? p.2]],\n  )\n  // definitions that only follow a rename are folded into it\n  mut refs_of := Dict[String, List[String]] {}\n  mut ref_only := Set[String] {}\n  if len(substitutions) > 0 {\n    for (po, pn, _) in pairs {\n      match (po, pn) {\n        (Some(o), Some(n)) => {\n          // the type or trait that declares a renamed member is shown, not folded\n          if diff.qname(o) != diff.qname(n)\n            || diff.prose(o) != diff.prose(n)\n            || contains(owners, diff.qname(o)) {\n            continue\n          }\n          oc := diff.code(o)\n          nc := diff.code(n)\n          ot := merge.tokens(oc)\n          nt := merge.tokens(nc)\n          for (f, t) in substitutions {\n            if contains(ot, refactor.short(f))\n              && contains(nt, refactor.short(t)) {\n              mut refs_of.insert(\n                t,\n                (get(refs_of, t) ?? []) + [diff.qname(n)],\n              )\n            }\n          }\n          if diff.substitute(oc, substitutions) == nc {\n            mut ref_only.insert(diff.qname(n))\n          }\n        },\n        _ => (),\n      }\n    }\n  }\n  mut items := []\n  mut added := 0\n  mut removed := 0\n  mut renamed := 0\n  mut changed := 0\n  mut iface := 0\n  for (po, pn, d) in pairs {\n    p := (po, pn)\n    q := diff.qname(d)\n    if contains(ref_only, q) {\n      continue\n    }\n    kind := diff.kind_str(d)\n    mut mk := \"\"\n    mut what := []\n    mut shown := []\n    mut interface_changed := true\n    mut rewritten := false\n    match p {\n      (None, Some(n)) => {\n        added += 1\n        mk = \"add\"\n        what = [\"added\"]\n        shown = lines(diff.code(n)).map(l -> diff.Line { s: \"+\", text: l })\n      },\n      (Some(o), None) => {\n        removed += 1\n        mk = \"del\"\n        what = [\"removed\"]\n        shown = lines(diff.code(o)).map(l -> diff.Line { s: \"-\", text: l })\n      },\n      (Some(o), Some(n)) => {\n        is_rename := diff.qname(o) != diff.qname(n)\n        interface_changed = is_rename\n          || binary.interface_hash(o) != binary.interface_hash(n)\n        oc := diff.code(o)\n        nc := diff.code(n)\n        (ls, rw) := diff.line_diff(oc, nc)\n        rewritten = rw\n        ls2 := diff.annotate(ls, oc, kind, if is_rename {\n          []\n        } else {\n          renames\n        })\n        // a move keeps the short name and changes the module\n        moved := is_rename\n          && refactor.short(diff.qname(o)) == refactor.short(diff.qname(n))\n        what = if moved {\n          [\"moved from `\"\n            + if o.module == \"\" {\n              \"main\"\n            } else {\n              o.module\n            }\n            + \"`\"]\n        } else if is_rename {\n          [\"renamed from `\" + refactor.short(diff.qname(o)) + \"`\"]\n        } else {\n          []\n        }\n        // a rename alone changes only the name\n        mut rest := if is_rename {\n          diff.substitute(oc, renames) != nc\n            || diff.prose(o) != diff.prose(n)\n        } else {\n          true\n        }\n        // a renamed member: say so, then whatever else changed, compared with the\n        // old definition with the rename applied\n        if !is_rename {\n          for (f, t, k, ow) in members {\n            if ow != q {\n              continue\n            }\n            mut what.push(\n              k\n                + \" `\"\n                + refactor.short(f)\n                + \"` renamed to `\"\n                + refactor.short(t)\n                + \"`\",\n            )\n            o2 := match refactor.rename_all(old.decls, [(f, refactor.short(t))]) {\n              Ok(r) => match diff.index_of_decl(r, q) {\n                Some(i) => get(resolve.written_at(r, set([i]), std, core), 0),\n                None => None,\n              },\n              Err(_) => None,\n            }\n            match o2 {\n              Some(x) => if !(diff.code(x) == nc && diff.prose(x) == diff.prose(n)) {\n                what += diff.change_words(x, n)\n              },\n              None => {\n                what += diff.change_words(o, n)\n              },\n            }\n            rest = false\n          }\n        }\n        if rest {\n          ws := diff.change_words(o, n)\n          if !(is_rename\n            && ws == [\"signature changed\"]\n            && diff.substitute(oc, renames) == nc) {\n            what += ws\n          }\n        }\n        if is_rename {\n          renamed += 1\n        } else {\n          changed += 1\n        }\n        if interface_changed {\n          iface += 1\n        }\n        mk = if is_rename {\n          \"ren\"\n        } else {\n          \"chg\"\n        }\n        shown = diff.fold_lines(ls2, kind)\n      },\n      _ => (),\n    }\n    // for the reader: what uses it directly, and how much depends on it in all\n    users := get(users_of, q) ?? []\n    total := diff.dependents_count(users_of, q)\n    mut detail := []\n    if rewritten {\n      mut detail.push(\n        \"most of it changed, so it is shown as a line diff\",\n      )\n    }\n    only_renamed := mk == \"ren\" && len(what) == 1\n    member_only := contains(owners, q)\n      && what.all(w -> contains(w, \"` renamed to `\"))\n    if member_only {\n      r := sum(members\n        .filter(m -> m.3 == q)\n        .map(m -> len(get(refs_of, m.1) ?? [])))\n      mut detail.push(\n        f\"only a name changed · {r} reference{diff.plural(r)} updated\",\n      )\n    } else if only_renamed {\n      r := len(get(refs_of, q) ?? [])\n      what_changed := if starts_with(get(what, 0) ?? \"\", \"moved\") {\n        \"its module\"\n      } else {\n        \"the name\"\n      }\n      mut detail.push(\n        f\"only {what_changed} changed · {r} reference{diff.plural(r)} updated\",\n      )\n    } else if what == [\"doc changed\"] || what == [\"comments changed\"] {\n      mut detail.push(\n        \"only the \"\n          + if what == [\"doc changed\"] {\n            \"doc\"\n          } else {\n            \"comments\"\n          }\n          + \" changed · interface unchanged\",\n      )\n    } else if mk == \"chg\" && kind == \"impl\" {\n      match d.kind {\n        ast.ImplDef(i) => mut detail.push(\n          if i.trait_name == \"\" {\n            \"methods of `\"\n              + refactor.short(diff.type_head(i.for_type))\n              + \"` · checked against the contracts of the traits they serve\"\n          } else {\n            \"implementation of `\"\n              + refactor.short(i.trait_name)\n              + \"` · checked against its contracts\"\n          },\n        ),\n        _ => (),\n      }\n    } else if mk == \"chg\" || mk == \"ren\" {\n      if kind == \"trait\"\n        && what.any(\n          w -> contains(w, \"added\") || contains(w, \"stronger\"),\n        ) {\n        impls := len(new.decls.filter(\n          x -> match x.kind {\n            ast.ImplDef(i) => refactor.short(i.trait_name) == refactor.short(q),\n            _ => false,\n          },\n        ))\n        mut detail.push(\n          f\"every implementation must follow · {impls} in the codebase\",\n        )\n      } else if interface_changed && kind != \"test\" {\n        mut detail.push(\n          if len(users) == 0 {\n            \"interface changed · nothing uses it\"\n          } else {\n            \"interface changed · used by \"\n              + f\"{len(users)}\"\n              + if total > len(users) {\n                f\", {total} depend on it in all\"\n              } else {\n                \"\"\n              }\n          },\n        )\n      } else if kind != \"test\" {\n        mut detail.push(\n          \"implementation only · nothing else needs re-checking\",\n        )\n      }\n    }\n    if mk == \"add\" {\n      match p {\n        (_, Some(n)) => if len(n.doc) > 0 {\n          mut detail.push(diff.prose(n))\n        },\n        _ => (),\n      }\n    }\n    doc_diff := match p {\n      (Some(o), Some(n)) => if diff.prose(o) != diff.prose(n) {\n        Some(diff.segments(diff.prose(o), diff.prose(n)))\n      } else {\n        None\n      },\n      _ => None,\n    }\n    owned := [diff.qname(x) for x in [p.0, p.1] where x is Some for x in [x ?? d]]\n    affected := if interface_changed\n      && p.0 is Some\n      && p.1 is Some\n      && kind != \"impl\" {\n      users.map(x -> (x, contains(paired, x)))\n    } else {\n      []\n    }\n    mut items.push(\n      diff.Item {\n        section: diff.section(kind, mk, interface_changed),\n        id: q,\n        mk,\n        what,\n        detail,\n        doc_diff,\n        lines: shown,\n        refs: get(refs_of, q) ?? [],\n        old_id: match p.0 {\n          Some(o) => Some(diff.qname(o)),\n          None => None,\n        },\n        label: match p {\n          (Some(o), Some(n)) => if diff.qname(o) != diff.qname(n) {\n            diff.label_of(o) + \" → \" + diff.label_of(n)\n          } else {\n            diff.label_of(d)\n          },\n          _ => diff.label_of(d),\n        },\n        kind,\n        module: d.module,\n        doc: match p.1 {\n          Some(n) => Some(diff.prose(n)),\n          None => None,\n        },\n        rewritten,\n        interface_changed,\n        affected,\n        affected_total: if affected == [] {\n          0\n        } else {\n          total\n        },\n        refs_folded: (get(refs_of, q) ?? []).filter(x -> contains(ref_only, x)),\n        steps: [s.0 for s in steps where s.1.any(x -> owned.contains(x))],\n        verdict_before: match p.0 {\n          Some(o) => Some(diff.verdict_word(diff.verdict_of(\n            files,\n            verdicts,\n            closure_old(diff.qname(o)),\n          ))),\n          None => None,\n        },\n        verdict_after: match p.1 {\n          Some(n) => Some(diff.verdict_word(diff.verdict_of(\n            files,\n            verdicts,\n            closure_new(diff.qname(n)),\n          ))),\n          None => None,\n        },\n      },\n    )\n  }\n  // verification before and after: what changed, and dependents whose result changed\n  mut checks := []\n  mut rechecked_same := 0\n  // only a change, or what depends on one, can have a new verdict\n  // (and what used a definition that went)\n  gone := [diff.qname(o) for p in pairs where p.0 is Some for o in [p.0 ?? p.2]]\n  rechecked := union(\n    diff.dependents_of_all(users_of, to_list(paired)),\n    if looking {\n      diff.dependents_of_all(diff.users_by(old_graph), gone)\n    } else {\n      Set[String] {}\n    },\n  )\n  for d in new.decls {\n    q := diff.qname(d)\n    if !contains(rechecked, q) {\n      continue\n    }\n    oq := get(renamed_to, q) ?? q\n    before_hash := if contains(old.hashes, oq) {\n      Some(closure_old(oq))\n    } else {\n      None\n    }\n    after_hash := closure_new(q)\n    if before_hash == Some(after_hash) {\n      continue\n    }\n    b := match before_hash {\n      Some(h) => diff.verdict_of(files, verdicts, h),\n      None => None,\n    }\n    a := diff.verdict_of(files, verdicts, after_hash)\n    is_fn := match d.kind {\n      ast.FnDef(_) => true,\n      _ => false,\n    }\n    if b is None && a is None && !(before_hash is None && is_fn) {\n      continue\n    }\n    changed_here := contains(paired, q)\n    // a dependent gets a row only if both results are known and differ\n    if before_hash is Some && !changed_here {\n      known := match (b, a) {\n        (Some(x), Some(y)) => if x.status == y.status {\n          1\n        } else {\n          2\n        },\n        _ => 0,\n      }\n      if known == 1 {\n        rechecked_same += 1\n      }\n      if known != 2 {\n        continue\n      }\n    }\n    why := if before_hash is None {\n      \"new definition\"\n    } else if changed_here {\n      \"changed\"\n    } else {\n      \"something it depends on changed\"\n    }\n    after := if a is None && before_hash is Some {\n      \"not verified yet\"\n    } else {\n      diff.verdict_word(a)\n    }\n    mut checks.push(\n      diff.Check { name: q, before: match before_hash {\n        Some(_) => Some(diff.verdict_word(b)),\n        None => None,\n      }, after, why },\n    )\n  }\n  diff.Diff {\n    added,\n    removed,\n    renamed,\n    changed,\n    interface_changes: iface,\n    items,\n    checks,\n    rechecked_same,\n    follow_renames: len(to_list(ref_only)),\n  }\n}"},{"name":"diff.use tree","kind":"use","old":null,"new":"73699d6e6cf0a17a","interface_changed":true,"affected":[],"module":"diff","text":"use tree"},{"name":"diff.use locate","kind":"use","old":null,"new":"4f7b92c1e6eb9647","interface_changed":true,"affected":[],"module":"diff","text":"use locate"},{"name":"diff.NodeChange","kind":"type","old":null,"new":"612597f8b712ac83","interface_changed":true,"affected":[],"module":"diff","text":"/// A node that changed (`tree.Change`): how, its path in each side (`\"\"`\n/// on the side it is not in), and its text on each side.\npub type NodeChange = {\n  kind: String,\n  old: String,\n  new: String,\n  before: String,\n  after: String,\n}"},{"name":"diff.node_changes","kind":"fn","old":null,"new":"8c8891f9ee93d209","interface_changed":true,"affected":[],"module":"diff","text":"/// The nodes that changed from `o` to `n`, with their text on each side.\n/// Costs one walk of both trees, down the parts that differ.\nfn node_changes(o: ast.Decl, n: ast.Decl) -> List[diff.NodeChange] {\n  timings.begin(\"diff nodes\")\n  out := tree.changes(o, n).map(\n    c -> diff.NodeChange {\n      kind: c.kind,\n      old: c.old,\n      new: c.new,\n      before: diff.node_text_at(o, c.old),\n      after: diff.node_text_at(n, c.new),\n    },\n  )\n  timings.end(\"diff nodes\")\n  out\n}"},{"name":"diff.node_text_at","kind":"fn","old":null,"new":"2da325c2b8dd1462","interface_changed":true,"affected":[],"module":"diff","text":"/// The text of the node at `path`; `\"\"` for none, or for the definition\n/// itself.\nfn node_text_at(d: ast.Decl, path: String) -> String {\n  if path == \"\" {\n    return \"\"\n  }\n  match tree.node_at(d, path) {\n    Some(x) => tree.node_text(x),\n    None => \"\",\n  }\n}"},{"name":"diff.nodes_text","kind":"fn","old":null,"new":"66785389f4ad3892","interface_changed":true,"affected":[],"module":"diff","text":"/// `strata diff --nodes`: each changed definition as it was and as it is,\n/// with the nodes that changed marked (`^^^` under them), then each change\n/// by path. Added and removed definitions are one line each.\npub fn nodes_text(d: diff.Diff) -> String {\n  if len(d.items) == 0 {\n    return \"no changes\\n\"\n  }\n  mut out := \"\"\n  for it in d.items {\n    mk := if it.mk == \"add\" {\n      \"+\"\n    } else if it.mk == \"del\" {\n      \"-\"\n    } else if it.mk == \"ren\" {\n      \"↪\"\n    } else {\n      \"~\"\n    }\n    out += \"\\n\" + mk + \" \" + it.id + \"  (\" + join(it.what, \", \") + \")\\n\"\n    match (it.old_decl, it.new_decl) {\n      (Some(o), Some(n)) => {\n        olds := it.nodes\n          .filter(c -> c.kind != \"added\" && c.old != \"\")\n          .map(c -> c.old)\n        news := it.nodes\n          .filter(c -> c.kind != \"removed\" && c.new != \"\")\n          .map(c -> c.new)\n        if len(olds) > 0 {\n          out += \"  before:\\n\" + diff.indented(diff.marked(o, olds)) + \"\\n\"\n        }\n        if len(news) > 0 {\n          out += \"  after:\\n\" + diff.indented(diff.marked(n, news)) + \"\\n\"\n        }\n        for c in it.nodes {\n          out += \"  \"\n            + c.kind\n            + \" \"\n            + if c.old == c.new {\n              c.old\n            } else if c.old == \"\" {\n              c.new\n            } else if c.new == \"\" {\n              c.old\n            } else {\n              c.old + \" → \" + c.new\n            }\n          out += if c.before != \"\"\n            && c.after != \"\"\n            && !contains(c.before, \"\\n\")\n            && !contains(c.after, \"\\n\") {\n            \": \" + c.before + \"  →  \" + c.after\n          } else {\n            \"\"\n          }\n          out += \"\\n\"\n        }\n      },\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"diff.marked","kind":"fn","old":null,"new":"37420ccbfaacae83","interface_changed":true,"affected":[],"module":"diff","text":"/// A definition shown with the nodes at `paths` marked.\nfn marked(d: ast.Decl, paths: List[String]) -> String {\n  mut ps := []\n  for p in paths {\n    for x in tree.marked_paths(d, p) {\n      if !contains(ps, x) {\n        mut ps.push(x)\n      }\n    }\n  }\n  m := locate.marking(d, d, ps)\n  locate.shown(locate.with_stand_ins(d, m.names), m, 1)\n}"},{"name":"diff.indented","kind":"fn","old":null,"new":"5a115e7e59ad7019","interface_changed":true,"affected":[],"module":"diff","text":"fn indented(text: String) -> String {\n  join(lines(text).map(l -> \"    \" + l), \"\\n\")\n}"}]}
{"id":"d8ba2596a3fdd299","time":1795709641,"message":"edit","changes":[{"name":"diff_command","kind":"fn","old":"3ff10b31e320edfc","new":"1114ec07a04bb5f3","interface_changed":false,"affected":[],"module":"","text":"/// `strata diff [--from N] [--to N] [--step N]`: the patches of the\n/// package's log, from entry `--from` to `--to`, or the one of `--step`.\n/// `--file F [BASE]` (or `--base BASE`): F's sources (a file, or a\n/// package's folder) from git's BASE (default `HEAD`) to the working tree,\n/// commit by commit.\n/// \n/// Shows each definition's change, sorted by what it affects, then what\n/// verification found before and after. `--graph T` adds how the values of\n/// the sum type `T` move (compiler/graph), the moves added and removed in\n/// words; with `--html`, a page with both graphs drawn instead. `--nodes`\n/// shows each changed definition before and after with the nodes that\n/// changed marked, and each change by path (compiler/tree).\nfn diff_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  cache: cache.Cache,\n  args: List[String],\n) -> std.process.ExitCode {\n  mut file := None\n  mut json := false\n  mut graph_of := None\n  mut html := false\n  mut nodes := false\n  mut base := None\n  mut nums := Dict[String, Int] {}\n  mut i := 0\n  while i < len(args) {\n    a := get(args, i) ?? \"\"\n    i += 1\n    if a == \"--file\"\n      || a == \"--base\"\n      || a == \"--from\"\n      || a == \"--to\"\n      || a == \"--step\"\n      || a == \"--graph\" {\n      v := get(args, i) ?? \"\"\n      i += 1\n      if a == \"--file\" {\n        file = Some(v)\n      } else if a == \"--graph\" {\n        graph_of = Some(v)\n      } else if a == \"--base\" {\n        base = Some(v)\n      } else {\n        match parse_int(v) {\n          Some(n) => if n >= 0 {\n            mut nums.insert(a, n)\n          } else {\n            return fail_with(mut console, f\"{a} needs a number\")\n          },\n          None => return fail_with(mut console, f\"{a} needs a number\"),\n        }\n      }\n    } else if a == \"--\" {\n      ()\n    } else if a == \"--html\" {\n      html = true\n    } else if a == \"--json\" {\n      json = true\n    } else if a == \"--nodes\" {\n      nodes = true\n    } else if starts_with(a, \"-\") {\n      return fail_with(mut console, f\"unknown option `{a}`\")\n    } else if base is None {\n      base = Some(a)\n    }\n  }\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  core := read_core_at(disk, home)\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  // (`--step K`: the K-th step of the range, counted from 1 as shown)\n  if get(nums, \"--step\") == Some(0) {\n    return fail_with(mut console, \"--step counts from 1\")\n  }\n  nums = match get(nums, \"--step\") {\n    Some(k) => {\n      mut copy := nums\n      mut copy.insert(\"--step\", k - 1)\n      copy\n    },\n    None => nums,\n  }\n  (range, verdicts) := match file {\n    Some(f) => {\n      head := match viewed_program(disk, process, Some(f)) {\n        Ok(ds) => ds,\n        Err(e) => return fail_with(mut console, e),\n      }\n      package := if disk.is_dir(f) && package_name(disk, f) == \"std\" {\n        \"std\"\n      } else {\n        \"\"\n      }\n      scratch := cache.dir\n        + \"/diff-\"\n        + byte_slice(\n          deps.sha256_hex(f\"{process.current_dir()}:{f}\"),\n          0,\n          16,\n        )\n      match diff.git_range(\n        mut launcher,\n        mut disk,\n        scratch,\n        f,\n        base,\n        package,\n        head,\n        std,\n        core,\n      ) {\n        Ok(r) => (r, diff.Verdicts { root: None }),\n        Err(e) => return fail_with(mut console, e),\n      }\n    },\n    None => {\n      root := match codebase.find_root(disk, process.current_dir()) {\n        Some(r) => r,\n        None => return fail_with(\n          mut console,\n          \"no package here (no strata.toml in this folder or above: run `strata init`, or pass --file)\",\n        ),\n      }\n      program := package_decls(\n        disk,\n        root,\n        if package_name(disk, root) == \"std\" {\n          \"std\"\n        } else {\n          \"\"\n        },\n      )\n      log := codebase.parse_log(\n        disk.read(root + \"/\" + codebase.log_file()) !! \"\",\n      )\n      match diff.log_range(\n        program,\n        log,\n        get(nums, \"--from\"),\n        get(nums, \"--to\"),\n        std,\n        core,\n      ) {\n        Ok(r) => (r, verdicts_at(mut launcher, disk, process, cache, root)),\n        Err(e) => return fail_with(mut console, e),\n      }\n    },\n  }\n  // (`--graph T`: the moves of `T` before and after, compiler/graph's)\n  match graph_of {\n    Some(t) => {\n      text := if html {\n        \"\"\n      } else {\n        match diff.range_text(\n          disk,\n          verdicts,\n          range,\n          get(nums, \"--step\"),\n          std,\n          core,\n        ) {\n          Ok(x) => x,\n          Err(e) => return fail_with(mut console, e),\n        }\n      }\n      program := match file {\n        Some(f) => absolute_path(process, f),\n        None => codebase.find_root(disk, process.current_dir()) ?? process.current_dir(),\n      }\n      return graph_diff(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        cache,\n        program,\n        range,\n        t,\n        html,\n        text,\n      )\n    },\n    None => (),\n  }\n  // (`--nodes`: each side with its changed nodes marked)\n  if nodes {\n    return match diff.range_diff(\n      disk,\n      verdicts,\n      range,\n      get(nums, \"--step\"),\n      std,\n      core,\n    ) {\n      Ok((d, label)) => {\n        mut console.write(label + \"\\n\" + diff.nodes_text(d))\n        0\n      },\n      Err(e) => fail_with(mut console, e),\n    }\n  }\n  // (`--json`: the diff's structure)\n  if json {\n    return match diff.range_diff(\n      disk,\n      verdicts,\n      range,\n      get(nums, \"--step\"),\n      std,\n      core,\n    ) {\n      Ok((d, label)) => {\n        mut console.print(\n          driver.pretty_json(diff_json(\n            d,\n            label,\n            range,\n            get(nums, \"--step\"),\n            file is Some,\n          )),\n        )\n        0\n      },\n      Err(e) => fail_with(mut console, e),\n    }\n  }\n  match diff.range_text(\n    disk,\n    verdicts,\n    range,\n    get(nums, \"--step\"),\n    std,\n    core,\n  ) {\n    Ok(text) => {\n      p := console.paint(std.term.Output)\n      mut console.write(\n        join(\n          split(text, \"\\n\").map(l -> highlight.diff_line(p, l)),\n          \"\\n\",\n        ),\n      )\n      0\n    },\n    Err(e) => fail_with(mut console, e),\n  }\n}","old_text":"/// `strata diff [--from N] [--to N] [--step N]`: the patches of the\n/// package's log, from entry `--from` to `--to`, or the one of `--step`.\n/// `--file F [BASE]` (or `--base BASE`): F's sources (a file, or a\n/// package's folder) from git's BASE (default `HEAD`) to the working tree,\n/// commit by commit.\n/// \n/// Shows each definition's change, sorted by what it affects, then what\n/// verification found before and after. `--graph T` adds how the values of\n/// the sum type `T` move (compiler/graph), the moves added and removed in\n/// words; with `--html`, a page with both graphs drawn instead.\nfn diff_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  cache: cache.Cache,\n  args: List[String],\n) -> std.process.ExitCode {\n  mut file := None\n  mut json := false\n  mut graph_of := None\n  mut html := false\n  mut base := None\n  mut nums := Dict[String, Int] {}\n  mut i := 0\n  while i < len(args) {\n    a := get(args, i) ?? \"\"\n    i += 1\n    if a == \"--file\"\n      || a == \"--base\"\n      || a == \"--from\"\n      || a == \"--to\"\n      || a == \"--step\"\n      || a == \"--graph\" {\n      v := get(args, i) ?? \"\"\n      i += 1\n      if a == \"--file\" {\n        file = Some(v)\n      } else if a == \"--graph\" {\n        graph_of = Some(v)\n      } else if a == \"--base\" {\n        base = Some(v)\n      } else {\n        match parse_int(v) {\n          Some(n) => if n >= 0 {\n            mut nums.insert(a, n)\n          } else {\n            return fail_with(mut console, f\"{a} needs a number\")\n          },\n          None => return fail_with(mut console, f\"{a} needs a number\"),\n        }\n      }\n    } else if a == \"--\" {\n      ()\n    } else if a == \"--html\" {\n      html = true\n    } else if a == \"--json\" {\n      json = true\n    } else if starts_with(a, \"-\") {\n      return fail_with(mut console, f\"unknown option `{a}`\")\n    } else if base is None {\n      base = Some(a)\n    }\n  }\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  core := read_core_at(disk, home)\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  // (`--step K`: the K-th step of the range, counted from 1 as shown)\n  if get(nums, \"--step\") == Some(0) {\n    return fail_with(mut console, \"--step counts from 1\")\n  }\n  nums = match get(nums, \"--step\") {\n    Some(k) => {\n      mut copy := nums\n      mut copy.insert(\"--step\", k - 1)\n      copy\n    },\n    None => nums,\n  }\n  (range, verdicts) := match file {\n    Some(f) => {\n      head := match viewed_program(disk, process, Some(f)) {\n        Ok(ds) => ds,\n        Err(e) => return fail_with(mut console, e),\n      }\n      package := if disk.is_dir(f) && package_name(disk, f) == \"std\" {\n        \"std\"\n      } else {\n        \"\"\n      }\n      scratch := cache.dir\n        + \"/diff-\"\n        + byte_slice(\n          deps.sha256_hex(f\"{process.current_dir()}:{f}\"),\n          0,\n          16,\n        )\n      match diff.git_range(\n        mut launcher,\n        mut disk,\n        scratch,\n        f,\n        base,\n        package,\n        head,\n        std,\n        core,\n      ) {\n        Ok(r) => (r, diff.Verdicts { root: None }),\n        Err(e) => return fail_with(mut console, e),\n      }\n    },\n    None => {\n      root := match codebase.find_root(disk, process.current_dir()) {\n        Some(r) => r,\n        None => return fail_with(\n          mut console,\n          \"no package here (no strata.toml in this folder or above: run `strata init`, or pass --file)\",\n        ),\n      }\n      program := package_decls(\n        disk,\n        root,\n        if package_name(disk, root) == \"std\" {\n          \"std\"\n        } else {\n          \"\"\n        },\n      )\n      log := codebase.parse_log(\n        disk.read(root + \"/\" + codebase.log_file()) !! \"\",\n      )\n      match diff.log_range(\n        program,\n        log,\n        get(nums, \"--from\"),\n        get(nums, \"--to\"),\n        std,\n        core,\n      ) {\n        Ok(r) => (r, verdicts_at(mut launcher, disk, process, cache, root)),\n        Err(e) => return fail_with(mut console, e),\n      }\n    },\n  }\n  // (`--graph T`: the moves of `T` before and after, compiler/graph's)\n  match graph_of {\n    Some(t) => {\n      text := if html {\n        \"\"\n      } else {\n        match diff.range_text(\n          disk,\n          verdicts,\n          range,\n          get(nums, \"--step\"),\n          std,\n          core,\n        ) {\n          Ok(x) => x,\n          Err(e) => return fail_with(mut console, e),\n        }\n      }\n      program := match file {\n        Some(f) => absolute_path(process, f),\n        None => codebase.find_root(disk, process.current_dir()) ?? process.current_dir(),\n      }\n      return graph_diff(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        cache,\n        program,\n        range,\n        t,\n        html,\n        text,\n      )\n    },\n    None => (),\n  }\n  // (`--json`: the diff's structure)\n  if json {\n    return match diff.range_diff(\n      disk,\n      verdicts,\n      range,\n      get(nums, \"--step\"),\n      std,\n      core,\n    ) {\n      Ok((d, label)) => {\n        mut console.print(\n          driver.pretty_json(diff_json(\n            d,\n            label,\n            range,\n            get(nums, \"--step\"),\n            file is Some,\n          )),\n        )\n        0\n      },\n      Err(e) => fail_with(mut console, e),\n    }\n  }\n  match diff.range_text(\n    disk,\n    verdicts,\n    range,\n    get(nums, \"--step\"),\n    std,\n    core,\n  ) {\n    Ok(text) => {\n      p := console.paint(std.term.Output)\n      mut console.write(\n        join(\n          split(text, \"\\n\").map(l -> highlight.diff_line(p, l)),\n          \"\\n\",\n        ),\n      )\n      0\n    },\n    Err(e) => fail_with(mut console, e),\n  }\n}"},{"name":"diff_json","kind":"fn","old":"d45d4b311619d511","new":"5ffb80b58f79fe84","interface_changed":false,"affected":[],"module":"","text":"/// For `strata diff --json`: its summary, the renames, the changes by\n/// section (each with what changed, its lines and the nodes that changed),\n/// what to verify again,\n/// and the range's steps.\nfn diff_json(\n  d: diff.Diff,\n  label: String,\n  r: diff.Range,\n  step: Option[Int],\n  from_git: Bool,\n) -> driver.Json {\n  renames := [x for s in r.steps for x in s.renames]\n  segs := (ss: List[diff.Seg]) -> driver.JList(\n    ss.map(x -> driver.JList([driver.JStr(x.k), driver.JStr(x.t)])),\n  )\n  opt := (x: Option[String]) -> match x {\n    Some(v) => driver.JStr(v),\n    None => driver.JNull,\n  }\n  item := (it: diff.Item) -> driver.JObject([\n    (\"id\", driver.JStr(it.id)),\n    (\"old_id\", opt(it.old_id)),\n    (\"label\", driver.JStr(it.label)),\n    (\"kind\", driver.JStr(it.kind)),\n    (\"module\", driver.JStr(it.module)),\n    (\"mk\", driver.JStr(it.mk)),\n    (\"what\", driver.JList(it.what.map(x -> driver.JStr(x)))),\n    (\"detail\", driver.JList(it.detail.map(x -> driver.JStr(x)))),\n    (\"doc_diff\", match it.doc_diff {\n      Some(dd) => segs(dd),\n      None => driver.JNull,\n    }),\n    (\"doc\", opt(it.doc)),\n    (\"lines\", driver.JList(it.lines.map(l -> line_json(l)))),\n    (\"nodes\", driver.JList(it.nodes.map(\n      c -> driver.JObject([\n        (\"kind\", driver.JStr(c.kind)),\n        (\"old\", driver.JStr(c.old)),\n        (\"new\", driver.JStr(c.new)),\n        (\"before\", driver.JStr(c.before)),\n        (\"after\", driver.JStr(c.after)),\n      ]),\n    ))),\n    (\"rewritten\", driver.JBool(it.rewritten)),\n    (\"interface_changed\", driver.JBool(it.interface_changed)),\n    (\"affected\", driver.JList(it.affected.map(\n      a -> driver.JObject(\n        [(\"name\", driver.JStr(a.0)), (\"updated\", driver.JBool(a.1))],\n      ),\n    ))),\n    (\"affected_total\", driver.JInt(it.affected_total)),\n    (\"refs\", driver.JList(it.refs.map(x -> driver.JStr(x)))),\n    (\n      \"refs_folded\",\n      driver.JList(it.refs_folded.map(x -> driver.JStr(x))),\n    ),\n    (\"steps\", driver.JList(it.steps.map(x -> driver.JInt(x)))),\n    (\"verdict\", driver.JObject([\n      (\"before\", opt(it.verdict_before)),\n      (\"after\", opt(it.verdict_after)),\n    ])),\n  ])\n  why := (sec: String) -> if sec == \"Types\" {\n    \"new fields, variants and shapes first: everything else builds on them\"\n  } else if sec == \"Interfaces\" {\n    \"signatures and contracts: what other code can rely on\"\n  } else if sec == \"Implementations\" {\n    \"bodies\"\n  } else {\n    \"\"\n  }\n  sections := [sec for sec in [\"Types\", \"Interfaces\", \"Implementations\", \"Tests\"] where d.items.any(i -> i.section == sec)]\n  steps := diff.step_names(r)\n  driver.JObject([\n    (\"summary\", driver.JObject([\n      (\"added\", driver.JInt(d.added)),\n      (\"removed\", driver.JInt(d.removed)),\n      (\"renamed\", driver.JInt(d.renamed)),\n      (\"changed\", driver.JInt(d.changed)),\n      (\"interface_changes\", driver.JInt(d.interface_changes)),\n      (\"follow_renames\", driver.JInt(d.follow_renames)),\n    ])),\n    (\"renames\", driver.JList(renames.map(\n      x -> driver.JObject(\n        [(\"from\", driver.JStr(x.0)), (\"to\", driver.JStr(x.1))],\n      ),\n    ))),\n    (\"sections\", driver.JList(sections.map(\n      sec -> driver.JObject([\n        (\"name\", driver.JStr(sec)),\n        (\"why\", driver.JStr(why(sec))),\n        (\"items\", driver.JList(\n          d.items.filter(i -> i.section == sec).map(i -> item(i)),\n        )),\n      ]),\n    ))),\n    (\"verification\", driver.JList(d.checks.map(\n      c -> driver.JObject(\n        [(\"name\", driver.JStr(c.name)), (\"before\", match c.before {\n          Some(b) => driver.JStr(b),\n          None => driver.JNull,\n        }), (\"after\", driver.JStr(c.after)), (\"why\", driver.JStr(c.why))],\n      ),\n    ))),\n    (\"rechecked_same\", driver.JInt(d.rechecked_same)),\n    (\"range\", driver.JObject([(\"kind\", driver.JStr(if from_git {\n      \"git\"\n    } else {\n      \"log\"\n    })), (\"label\", driver.JStr(label)), (\"step\", match step {\n      Some(k) => driver.JInt(k),\n      None => driver.JNull,\n    })])),\n    (\"steps\", driver.JList([driver.JObject([\n      (\"id\", driver.JInt(s.id)),\n      (\"n\", driver.JInt(k + 1)),\n      (\"title\", driver.JStr(s.title)),\n      (\"group\", driver.JStr(s.group)),\n      (\"when\", match s.when {\n        Some(t) => driver.JInt(t),\n        None => driver.JNull,\n      }),\n      (\n        \"names\",\n        driver.JList(\n          (steps.find(x -> x.0 == s.id) ?? (0, [])).1.map(\n            n -> driver.JStr(n),\n          ),\n 