","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// Field `f` of a record or a tuple: its index and type.\nfn field_index(g: codegen.Gen, t: check.Ty, f: String) -> (Int, check.Ty) {\n  match t {\n    check.TNamed { name: \"Tuple\", args } => match parse_int(f) {\n      Some(k) => (k, get(args, k) ?? check.TAny),\n      None => (-1, check.TAny),\n    },\n    check.TNamed { name, .. } => if contains(g.types.sums, name) {\n      (-1, check.TAny)\n    } else {\n      mut out := (-1, check.TAny)\n      for (k, x) in enumerate(codegen.fields_of(g, name, t)) {\n        if x.0 == f {\n          out = (k, x.1)\n        }\n      }\n      out\n    },\n    _ => (-1, check.TAny),\n  }\n}","old_text":"/// Field `f` of a record or a tuple: its index and type.\nfn field_index(g: codegen.Gen, t: Ty, f: String) -> (Int, Ty) {\n  match t {\n    TNamed { name: \"Tuple\", args } => match parse_int(f) {\n      Some(k) => (k, get(args, k) ?? TAny),\n      None => (-1, TAny),\n    },\n    TNamed { name, .. } => if contains(g.types.sums, name) {\n      (-1, TAny)\n    } else {\n      mut out := (-1, TAny)\n      for (k, x) in enumerate(codegen.fields_of(g, name, t)) {\n        if x.0 == f {\n          out = (k, x.1)\n        }\n      }\n      out\n    },\n    _ => (-1, TAny),\n  }\n}"},{"name":"codegen.set_path","kind":"fn","old":"bf99dc41112ac1f8","new":"ddac1a22480fd816","interface_changed":false,"affected":[],"module":"codegen","text":"/// `v` with the value at `path` replaced by `x` (taken), as a temporary.\n/// Each record or tuple on the path is a new block sharing the other\n/// fields. An empty path gives `x`.\nfn set_path(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  path: List[String],\n  x: codegen.V,\n) -> codegen.V {\n  f := match get(path, 0) {\n    Some(f) => f,\n    None => return x,\n  }\n  // a union of records or variants that all have the field: per member\n  match v.ty {\n    check.TUnion(ms) => if ms.all(\n      m ->\n        !codegen.boxed(g, m) && codegen.field_index(g, m, f).0 >= 0,\n    ) {\n      return codegen.union_set(mut g, v, ms, path, x)\n    },\n    _ => (),\n  }\n  (k, ft) := codegen.field_index(g, v.ty, f)\n  if k < 0 {\n    codegen.not_yet(mut g, \"assigning the field `\"\n      + f\n      + \"` of a `\"\n      + codegen.key(v.ty)\n      + \"`\")\n    return codegen.never()\n  }\n  nx := if len(path) > 1 {\n    inner := codegen.field(mut g, v, k, ft)\n    codegen.set_path(mut g, inner, drop(path, 1), x)\n  } else {\n    x\n  }\n  if nx.ty is check.TAny {\n    return nx\n  }\n  tys := match v.ty {\n    check.TNamed { name: \"Tuple\", args } => args,\n    check.TNamed { name, .. } => codegen.fields_of(g, name, v.ty).map(y -> y.1),\n    _ => [],\n  }\n  if len(tys) > 3 {\n    // a large block: copied by a helper, then the field replaced\n    c := codegen.clone_fn(mut g, v.ty, tys)\n    p := codegen.fresh(mut g, \"obj\")\n    codegen.emit(mut g, f\"{p} = call ptr {c}(ptr {v.op})\")\n    x2 := codegen.take_value(mut g, codegen.V { ..nx, ty: ft })\n    at := codegen.fresh(mut g, \"at\")\n    codegen.emit(\n      mut g,\n      f\"{at} = getelementptr i64, ptr {p}, i64 {k + 1}\",\n    )\n    old := codegen.load_slot(mut g, at, ft)\n    codegen.store_slot(mut g, x2, at)\n    codegen.drop_value(mut g, old)\n    return codegen.temp(mut g, codegen.V { ty: v.ty, op: p })\n  }\n  mut fields := []\n  for (j, t) in enumerate(tys) {\n    mut fields.push(\n      if j == k {\n        codegen.V { ..nx, ty: t }\n      } else {\n        codegen.field(mut g, v, j, t)\n      },\n    )\n  }\n  tag := codegen.tag_of(mut g, v)\n  p := codegen.block_tagged(mut g, tag, fields)\n  codegen.temp(mut g, codegen.V { ty: v.ty, op: p })\n}","old_text":"/// `v` with the value at `path` replaced by `x` (taken), as a temporary.\n/// Each record or tuple on the path is a new block sharing the other\n/// fields. An empty path gives `x`.\nfn set_path(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  path: List[String],\n  x: codegen.V,\n) -> codegen.V {\n  f := match get(path, 0) {\n    Some(f) => f,\n    None => return x,\n  }\n  // a union of records or variants that all have the field: per member\n  match v.ty {\n    TUnion(ms) => if ms.all(\n      m ->\n        !codegen.boxed(g, m) && codegen.field_index(g, m, f).0 >= 0,\n    ) {\n      return codegen.union_set(mut g, v, ms, path, x)\n    },\n    _ => (),\n  }\n  (k, ft) := codegen.field_index(g, v.ty, f)\n  if k < 0 {\n    codegen.not_yet(mut g, \"assigning the field `\"\n      + f\n      + \"` of a `\"\n      + codegen.key(v.ty)\n      + \"`\")\n    return codegen.never()\n  }\n  nx := if len(path) > 1 {\n    inner := codegen.field(mut g, v, k, ft)\n    codegen.set_path(mut g, inner, drop(path, 1), x)\n  } else {\n    x\n  }\n  if nx.ty is TAny {\n    return nx\n  }\n  tys := match v.ty {\n    TNamed { name: \"Tuple\", args } => args,\n    TNamed { name, .. } => codegen.fields_of(g, name, v.ty).map(y -> y.1),\n    _ => [],\n  }\n  if len(tys) > 3 {\n    // a large block: copied by a helper, then the field replaced\n    c := codegen.clone_fn(mut g, v.ty, tys)\n    p := codegen.fresh(mut g, \"obj\")\n    codegen.emit(mut g, f\"{p} = call ptr {c}(ptr {v.op})\")\n    x2 := codegen.take_value(mut g, codegen.V { ..nx, ty: ft })\n    at := codegen.fresh(mut g, \"at\")\n    codegen.emit(\n      mut g,\n      f\"{at} = getelementptr i64, ptr {p}, i64 {k + 1}\",\n    )\n    old := codegen.load_slot(mut g, at, ft)\n    codegen.store_slot(mut g, x2, at)\n    codegen.drop_value(mut g, old)\n    return codegen.temp(mut g, codegen.V { ty: v.ty, op: p })\n  }\n  mut fields := []\n  for (j, t) in enumerate(tys) {\n    mut fields.push(\n      if j == k {\n        codegen.V { ..nx, ty: t }\n      } else {\n        codegen.field(mut g, v, j, t)\n      },\n    )\n  }\n  tag := codegen.tag_of(mut g, v)\n  p := codegen.block_tagged(mut g, tag, fields)\n  codegen.temp(mut g, codegen.V { ty: v.ty, op: p })\n}"},{"name":"codegen.replace_var","kind":"fn","old":"f14540a89cd2cde9","new":"a3c19fb7d92ef3a1","interface_changed":false,"affected":[],"module":"codegen","text":"/// Replaces the variable's value by `v` (held) and drops the old one.\nfn replace_var(mut g: codegen.Gen, l: codegen.Local, v: codegen.V) {\n  if v.ty is check.TAny {\n    return\n  }\n  nv := codegen.take_value(mut g, codegen.V { ..v, ty: l.ty })\n  old := codegen.load(mut g, l)\n  codegen.store_var(mut g, nv, l)\n  codegen.drop_value(mut g, old)\n}","old_text":"/// Replaces the variable's value by `v` (held) and drops the old one.\nfn replace_var(mut g: codegen.Gen, l: codegen.Local, v: codegen.V) {\n  if v.ty is TAny {\n    return\n  }\n  nv := codegen.take_value(mut g, codegen.V { ..v, ty: l.ty })\n  old := codegen.load(mut g, l)\n  codegen.store_var(mut g, nv, l)\n  codegen.drop_value(mut g, old)\n}"},{"name":"codegen.local_at","kind":"fn","old":"26f79305757b5c70","new":"97c0f4c3a16aa2c5","interface_changed":true,"affected":["codegen.function","codegen.mock_method","codegen.compiled_alone","codegen.vtable","codegen.mock_table","codegen.mock_call","codegen.generate","codegen.to_dyn","codegen.dyn_table_is","codegen.mock_value","codegen.method_call","codegen_with","core_rt_text","computed_value