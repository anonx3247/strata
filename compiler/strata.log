mt.is_fn","smt.func_of","smt.fn_value","smt.utf8_len","smt.option","smt.fn_arg","smt.builtin_faults","smt.builtin","smt.eq_list_values","smt.list_valid","smt.changed_vars","smt.passed_mut","smt.pass_ends","smt.written_on_entry","smt.assume_written","smt.written_kept","smt.leave_loop","smt.entry_values","smt.havoc_loop","smt.invariant_candidates","smt.candidate_value","smt.ask","smt.drop_falsifiable","smt.infer_invariants","smt.while_loop","smt.for_loop","smt.plain_loop","smt.jump","smt.encode","smt.method_decls","smt.method_contract","smt.method_call","smt.fn_name_value","smt.calls_of","smt.total_builtin","smt.cannot_fail","smt.callee_seen","smt.transparency","smt.regex_match","smt.contract_label","smt.set_path","smt.call_value","smt.method_params","smt.head_of","smt.implementation","smt.impl_seen","smt.branches_narrowed","smt.merge_union","smt.union_as","smt.type_key","smt.flatten_union","smt.flatten_all","smt.union_groups","smt.shape_test","smt.key_test","smt.in_type","smt.is_alias","smt.eq_union","smt.pattern_key","smt.pattern_type","smt.arm_slots","smt.int_of","smt.measure_check","smt.term_query","smt.refined_ctor","smt.why","smt.answer_of","smt.literal_of","smt.sx_literal","smt.seq_items","smt.obligation_answers","smt.cone_with","smt.body_with","smt.open_input","smt.static_call","smt.static_impl","smt.share","smt.share_val","smt.unshift","smt.known_of_all","smt.encode_all","smt.answers_all","smt.query_text","smt.term_query_text","smt.own_method_of","smt.encode_answered","smt.encode_rounds","smt.refined_walk","smt.encode_solving","smt.search_question","smt.subst_val_in","smt.loop_measures","smt.pass_measures","smt.measures_at","smt.item_at","smt.keyed_list","smt.type_args_at","smt.val_type","smt.pred_old","smt.mut_state","smt.write_after","smt.same_call","smt.map_sorts","smt.opt_ctor","smt.keyed_array","smt.fresh_keyed","smt.map_of","smt.term_of","smt.has_term","smt.map_key","smt.map_store","smt.map_entry","smt.map_insert","smt.map_empty","smt.literal_type","smt.map_literal","smt.map_op","smt.item_of","smt.open_map","smt.changed","smt.receiver_term","smt.trait_invariants","smt.same_lists","smt.prefix_sum","smt.new_sum_fn","smt.list_sum","smt.rec_call","smt.shared_receiver","smt.eval_pol","smt.alias_lists","smt.know_map_all","smt.map_read","smt.map_instance","smt.member_of","smt.unrefined","smt.infers_over_list","smt.blank_lists","smt.place_kind","smt.derived_facts","smt.assume_facts","smt.relevant","smt.headed","smt.def_call","smt.define_fn","smt.defining_ensures","smt.pure_term","smt.ctor_terms","smt.rec_use","smt.applied_def","smt.interpolated","smt.changed_fields","smt.passed_mut_args","smt.fresh_fun","smt.element_term","smt.list_set","smt.unique_of","smt.visited_candidates","smt.assume_visited","smt.for_element","smt.same_sort","smt.sort_mixes","smt.unmixed","termination.Ctx","termination.find_measure","termination.analyze_with","termination.LoopSearch","termination.loop_start","termination.MeasureSearch","termination.measure_search","verify_command","build_proofs","command_line","alongside_command","search_invariants","find_invariants","static_graph","written_score","smt.methods_of","smt.inputs","termination.context","termination.termination_queries","termination.measure_start","smt_file","termination.assigned","termination.measure_next","termination.loop_next","shown_names","checks_of","or_solver_inputs","termination.is_method","termination.trait_of","termination.impl_label","termination.calls_within","termination.call_name","termination.scoped","termination.calls_in","termination.finite_iterator","termination.structural","termination.expand_alias","termination.candidate_measures","termination.cannot_fail","termination.total_builtin","termination.analyze","termination.impl_labels","termination.seen_through","termination.with_trait_contract","termination.trait_method","termination.finite_source","termination.unsat_all","termination.loops_all","termination.measures_all","termination.loop_answered","termination.measure_answered","strata_command","build_command","run_command","main","apply_edit","edit_file","fix_loops","graph_command","graph_diff","verified_decls","termination_file","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","edit_command","edit_in_editor","repl_command","fix_command","diff_command","verified_with","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","verified_program","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","check_command","program_objects","comptime_values","call_command","loaded_errors","file_errors","edit_errors","linked","expanded","comptime_runner","package_errors","check_files","apply_change","with_base","rename_command","move_command"],"module":"smt","text":"/// The state of the symbolic run of one function.\npub type Vc = {\n  // the functions and types of the program, std and core, by the names\n  // code uses, and the builtins' signatures\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  builtins: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  // each sum type's variants, with the type's name\n  parents: Dict[String, String],\n  // each constructor, with its type's name\n  ctors: Dict[String, String],\n  consts: List[smt.Const],\n  next_var: Int,\n  facts: List[String],\n  // facts that hold on every path (what a term's type gives)\n  defs: List[String],\n  // why each unknown was made (something not modelled)\n  reasons: Dict[String, String],\n  reason: Option[String],\n  pc: List[String],\n  scopes: List[Dict[String, smt.Val]],\n  obligations: List[smt.Obligation],\n  // obligations true for all values: proven without a query\n  given: List[String],\n  // inside a contract or refinement: no obligations are made there\n  spec: Int,\n  proving: Int,\n  dead: Bool,\n  depth: Int,\n  returns: List[smt.Exit],\n  memo: Dict[String, smt.Val],\n  bit_terms: Dict[String, String],\n  // the types variables were declared with, which hold after each\n  // assignment\n  declared: Dict[String, List[ast.TypeExpr]],\n  params: List[(String, smt.Val)],\n  // the sorts, in the order met, by name\n  sorts: List[(String, smt.SortDef)],\n  sort_index: Dict[String, Int],\n  // the validity predicates (name, sort), by type and sort\n  valid: List[(String, String)],\n  valid_index: Dict[String, Int],\n  // the validity predicates defined, and the terms unfolded\n  defined: Set[String],\n  unfolded: Dict[String, smt.Val],\n  // strings read from datatype values, named in the queries\n  str_terms: List[String],\n  // the types being checked (a recursive one is checked to a fixed depth)\n  checking: List[String],\n  cutoffs: Dict[String, String],\n  // the lists, by id\n  lists: List[smt.ListInfo],\n  // open scopes (a quantified fact, a template): where the unknowns and\n  // facts made inside them start\n  regions: List[(Int, Int)],\n  // the positions new unknowns are functions of (a list's template)\n  indexing: Option[List[String]],\n  // the quantifier nesting, and the quantified variables made\n  binding: Int,\n  qvars: Int,\n  // the unknowns a quantifier binds\n  bound: Set[String],\n  // nesting depth of lists compared by position\n  eq_depth: Int,\n  // the functions passed to the call being made, by argument\n  fn_args: List[Option[smt.Func]],\n  // the `break`s and `continue`s of the loops being run, innermost last\n  breaks: List[List[smt.Jump]],\n  continues: List[List[smt.Jump]],\n  // inside a trial pass of a loop: inner loops infer nothing\n  trial: Int,\n  // in a trial pass, the values callees wrote back to `mut` arguments of a\n  // type without refinements: any value of the type, nothing known\n  wiped: List[smt.Val],\n  // candidate invariants: the `ensures` of the returned variable, and the\n  // `requires`\n  hints: List[(ast.Expr, String)],\n  requires_hints: List[ast.Expr],\n  // the solver's answers from earlier runs, by query, and the queries\n  // this run still needs\n  answers: Dict[String, String],\n  pending: List[String],\n  // the strings tested against regular expressions: the string, the\n  // pattern, its Bool, and whether it is approximated\n  matched: List[(String, String, String, Bool)],\n  // what this function uses that smt doesn't model\n  gaps: List[String],\n  // for the termination check: the function's own name (a call of it is\n  // recursion), its `while` loops, its recursive calls (path and\n  // arguments), their obligations (kept apart), and the type of each\n  // non-list value a `for` runs over (`\"\"` when not known)\n  self_name: String,\n  loops: List[smt.LoopInfo],\n  rec_sites: List[(List[String], List[smt.Val])],\n  term_obs: List[smt.Obligation],\n  iter_fors: List[String],\n  // for `verify`'s report: the loop invariants inferred, and the functions\n  // seen through whose finishing is only assumed (`terminates`)\n  invariants: List[String],\n  relied_on: Set[String],\n  // `verify`'s counterexamples (`Methods.examples`): each list parameter's\n  // first elements (`input_elems`). Their facts and terms are set aside for\n  // a second query when a model can't be shown without them.\n  examples: Bool,\n  example_facts: List[String],\n  example_leaves: List[String],\n  input_elems: Dict[Int, List[smt.Val]],\n  input_depth: Int,\n  // a running solver (c/solver.c) that `ask` sends each question to as it\n  // comes, waiting for the answer, so the function is run once. With `\"\"`\n  // the questions stay pending and the run is repeated once answered.\n  live: String,\n  // the function's own `while` loops (`while_loops`), to tell them from\n  // those of callees seen through\n  own_whiles: List[(ast.Expr, ast.Expr)],\n  // the cost of the loop-invariant searches (solver resource units and\n  // microseconds, from their answers), and whether one was refused because\n  // the run's search budget was used up\n  search_units: Int,\n  search_micros: Int,\n  search_cut: Bool,\n  // inside a loop with written invariants: inference asks only at a\n  // proof's limit, and gives up at the first unanswered question\n  cheap: Int,\n  // for `verify` to write: each own `while` loop's inferred invariants and\n  // their cost\n  found_loops: List[smt.LoopFound],\n  // the `mut` parameters of the function. Its `ensures` name their values\n  // at each exit; `old x` is the starting value.\n  mut_params: List[String] = [],\n  // in an `ensures`: what `old e` reads (the values at the function's\n  // start, or the arguments before a call)\n  olds: Option[Dict[String, smt.Val]] = None,\n  // after a call seen through its contract: the `mut` parameters' values\n  // it leaves (`write_after` writes them back)\n  after: List[smt.Val] = [],\n  // the dicts and sets among the lists, by id, with their types. An\n  // input's is shown as a dict or set (`literal_of`).\n  keyed: Dict[Int, ast.TypeExpr],\n  // dict and set entries by list id: an SMT array from each key to an\n  // `Option` of its value (dict) or a Bool (set). Its size is a function\n  // of the array (`map_sorts`).\n  arrays: Dict[Int, String],\n  // the type a `let` gives the dict or set literal bound to it, so `set`\n  // and `dict` make an array of that type\n  want: Option[(ast.Expr, ast.TypeExpr)],\n  // in a loop's written invariant: calls are seen through as in a contract\n  see: Int = 0,\n  // inside a contract or refinement (`pred_old`)\n  contract: Int = 0,\n  // the function being run (`function`), by its name in `fns`\n  own_name: String = \"\",\n  // inside a fact made of two lists' elements known equal\n  in_same: Int = 0,\n  // the lists whose facts about every element are being given to one of\n  // them (`known_of`): a fact about a list's elements that takes another\n  // element of it (`!contains(xs, x)`) is not given again to that one\n  knowing: List[Int] = [],\n  // comparing two lists the code compares (`binary`)\n  list_eq: Int = 0,\n  // the prefix-sum functions of lists (`prefix_sum`), by list and function\n  sum_fns: Dict[String, String] = Dict[String, String] {},\n  // those of `sum_fns` of a list through a function: the list, the\n  // function and the prefix-sum function (for `for_element`)\n  mapped_sums: List[(Int, smt.Func, String)] = [],\n  // the lengths of the lists whose first elements are in `input_elems`\n  input_lens: Dict[Int, String] = Dict[Int, String] {},\n  // the recursive functions unfolded in contracts, as SMT functions: by\n  // symbol, their argument sorts and result sort (`rec_call`)\n  rec_fns: Dict[String, (List[String], String)] = Dict[String, (List[String], String)] {},\n  // nesting depth of unfolding them\n  unfolding: Int = 0,\n  // making a definition (`define_fn`): no unknown may be made\n  defining: Int = 0,\n  // the orders of values of a sort `compare` uses (the order unknown: a\n  // function of the two values), with their sorts\n  orders: List[(String, String)] = [],\n  // the functions contracts see through, each defined once (`def_call`):\n  // its symbol and its `define-fun` (or `define-fun-rec`), each after those\n  // it uses; by function and argument sorts, its symbol (`\"\"`: it has no\n  // definition, its body not being one term of its parameters)\n  fun_defs: List[(String, String)] = [],\n  def_index: Dict[String, String] = Dict[String, String] {},\n  // the definitions' parameters and recursive calls, by key (`def_call`);\n  // in a definition being made, the recursive calls met; the uses of\n  // recursive functions stated, by levels and application (`rec_use`)\n  def_info: Dict[String, smt.DefInfo] = Dict[String, smt.DefInfo] {},\n  calls: List[(String, List[String])] = [],\n  rec_stated: Set[String] = Set[String] {},\n  // nesting depth of comparing two datatype terms of different sorts\n  data_eq: Int = 0,\n  // uninterpreted functions of a receiver, standing for pure methods seen\n  // only through their contracts (a trait model, `self.total()`): name,\n  // receiver sort, result sort (`receiver_term`)\n  of_receiver: List[(String, String, String)] = [],\n  // the polarity of the Bool being made, read by `eval`:\n  // 1: only ever assumed true (a fact of every position, inside `all`);\n  // -1: only ever proven (inside `every`);\n  // 0: either.\n  // `all` makes only the direction it needs, so a quantifier is never\n  // nested in another (`all_of`).\n  polarity: Int = 0,\n  // the polarity of the call being made (`call`, `builtin` read it)\n  call_pol: Int = 0,\n  // how many seen-through bodies (in a contract) the run is in. There a\n  // refined constructor that may fail is a value only where it doesn't\n  // (`ctor`).\n  through: Int = 0,\n  // what holds of every entry of a dict (`all(d.items(), f)` assumed), the\n  // keys read in dicts' arrays, and whether such a fact is being stated\n  // (`map_instance` does not recurse)\n  map_alls: List[smt.MapAll] = [],\n  map_reads: List[smt.MapRead] = [],\n  map_inst: Int = 0,\n  // each array made by a store, with the array it was stored into\n  map_from: Dict[String, String] = Dict[String, String] {},\n  // the facts in `defs`, to make each once\n  def_set: Set[String] = Set[String] {},\n  // each `for`'s list, by the name its index loop binds it to (`for_loop`)\n  for_lists: Dict[String, ast.Expr] = Dict[String, ast.Expr] {},\n  // the variable the body ends with, and the result's type\n  returned: Option[(String, ast.TypeExpr)] = None,\n  // the obligations made before each loop whose invariant search was left\n  // out (`Methods.search` 0): a check failing after one of them asks for\n  // the search (compiler `verify`)\n  skipped: List[Int] = [],\n  // `unique` of each list asked, by its id: the same list, the same answer\n  uniques: Dict[Int, String] = Dict[Int, String] {},\n  // those loops, with where their checks are (for `verify` to say which\n  // loop a check failing after one of them may need an invariant of)\n  skipped_loops: List[smt.SkippedLoop] = [],\n  // the expression the body ends with, as shown (what its `ensures` are\n  // about, for `verify` to name)\n  result_text: String = \"\",\n}","old_text":"/// The state of the symbolic run of one function.\npub type Vc = {\n  // the functions and types of the program, std and core, by the names\n  // code uses, and the builtins' signatures\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  builtins: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  // each sum type's variants, with the type's name\n  parents: Dict[String, String],\n  // each constructor, with its type's name\n  ctors: Dict[String, String],\n  consts: List[smt.Const],\n  next_var: Int,\n  facts: List[String],\n  // facts that hold on every path (what a term's type gives)\n  defs: List[String],\n  // why each unknown was made (something not modelled)\n  reasons: Dict[String, String],\n  reason: Option[String],\n  pc: List[String],\n  scopes: List[Dict[String, smt.Val]],\n  obligations: List[smt.Obligation],\n  // obligations true for all values: proven without a query\n  given: List[String],\n  // inside a contract or refinement: no obligations are made there\n  spec: Int,\n  proving: Int,\n  dead: Bool,\n  depth: Int,\n  returns: List[smt.Exit],\n  memo: Dict[String, smt.Val],\n  bit_terms: Dict[String, String],\n  // the types variables were declared with, which hold after each\n  // assignment\n  declared: Dict[String, List[ast.TypeExpr]],\n  params: List[(String, smt.Val)],\n  // the sorts, in the order met, by name\n  sorts: List[(String, smt.SortDef)],\n  sort_index: Dict[String, Int],\n  // the validity predicates (name, sort), by type and sort\n  valid: List[(String, String)],\n  valid_index: Dict[String, Int],\n  // the validity predicates defined, and the terms unfolded\n  defined: Set[String],\n  unfolded: Dict[String, smt.Val],\n  // strings read from datatype values, named in the queries\n  str_terms: List[String],\n  // the types being checked (a recursive one is checked to a fixed depth)\n  checking: List[String],\n  cutoffs: Dict[String, String],\n  // the lists, by id\n  lists: List[smt.ListInfo],\n  // open scopes (a quantified fact, a template): where the unknowns and\n  // facts made inside them start\n  regions: List[(Int, Int)],\n  // the positions new unknowns are functions of (a list's template)\n  indexing: Option[List[String]],\n  // the quantifier nesting, and the quantified variables made\n  binding: Int,\n  qvars: Int,\n  // the unknowns a quantifier binds\n  bound: Set[String],\n  // nesting depth of lists compared by position\n  eq_depth: Int,\n  // the functions passed to the call being made, by argument\n  fn_args: List[Option[smt.Func]],\n  // the `break`s and `continue`s of the loops being run, innermost last\n  breaks: List[List[smt.Jump]],\n  continues: List[List[smt.Jump]],\n  // inside a trial pass of a loop: inner loops infer nothing\n  trial: Int,\n  // in a trial pass, the values callees wrote back to `mut` arguments of a\n  // type without refinements: any value of the type, nothing known\n  wiped: List[smt.Val],\n  // candidate invariants: the `ensures` of the returned variable, and the\n  // `requires`\n  hints: List[(ast.Expr, String)],\n  requires_hints: List[ast.Expr],\n  // the solver's answers from earlier runs, by query, and the queries\n  // this run still needs\n  answers: Dict[String, String],\n  pending: List[String],\n  // the strings tested against regular expressions: the string, the\n  // pattern, its Bool, and whether it is approximated\n  matched: List[(String, String, String, Bool)],\n  // what this function uses that smt doesn't model\n  gaps: List[String],\n  // for the termination check: the function's own name (a call of it is\n  // recursion), its `while` loops, its recursive calls (path and\n  // arguments), their obligations (kept apart), and the type of each\n  // non-list value a `for` runs over (`\"\"` when not known)\n  self_name: String,\n  loops: List[smt.LoopInfo],\n  rec_sites: List[(List[String], List[smt.Val])],\n  term_obs: List[smt.Obligation],\n  iter_fors: List[String],\n  // for `verify`'s report: the loop invariants inferred, and the functions\n  // seen through whose finishing is only assumed (`terminates`)\n  invariants: List[String],\n  relied_on: Set[String],\n  // `verify`'s counterexamples (`Methods.examples`): each list parameter's\n  // first elements (`input_elems`). Their facts and terms are set aside for\n  // a second query when a model can't be shown without them.\n  examples: Bool,\n  example_facts: List[String],\n  example_leaves: List[String],\n  input_elems: Dict[Int, List[smt.Val]],\n  input_depth: Int,\n  // a running solver (c/solver.c) that `ask` sends each question to as it\n  // comes, waiting for the answer, so the function is run once. With `\"\"`\n  // the questions stay pending and the run is repeated once answered.\n  live: String,\n  // the function's own `while` loops (`while_loops`), to tell them from\n  // those of callees seen through\n  own_whiles: List[(ast.Expr, ast.Expr)],\n  // the cost of the loop-invariant searches (solver resource units and\n  // microseconds, from their answers), and whether one was refused because\n  // the run's search budget was used up\n  search_units: Int,\n  search_micros: Int,\n  search_cut: Bool,\n  // inside a loop with written invariants: inference asks only at a\n  // proof's limit, and gives up at the first unanswered question\n  cheap: Int,\n  // for `verify` to write: each own `while` loop's inferred invariants and\n  // their cost\n  found_loops: List[smt.LoopFound],\n  // the `mut` parameters of the function. Its `ensures` name their values\n  // at each exit; `old x` is the starting value.\n  mut_params: List[String] = [],\n  // in an `ensures`: what `old e` reads (the values at the function's\n  // start, or the arguments before a call)\n  olds: Option[Dict[String, smt.Val]] = None,\n  // after a call seen through its contract: the `mut` parameters' values\n  // it leaves (`write_after` writes them back)\n  after: List[smt.Val] = [],\n  // the dicts and sets among the lists, by id, with their types. An\n  // input's is shown as a dict or set (`literal_of`).\n  keyed: Dict[Int, ast.TypeExpr],\n  // dict and set entries by list id: an SMT array from each key to an\n  // `Option` of its value (dict) or a Bool (set). Its size is a function\n  // of the array (`map_sorts`).\n  arrays: Dict[Int, String],\n  // the type a `let` gives the dict or set literal bound to it, so `set`\n  // and `dict` make an array of that type\n  want: Option[(ast.Expr, ast.TypeExpr)],\n  // in a loop's written invariant: calls are seen through as in a contract\n  see: Int = 0,\n  // inside a contract or refinement (`pred_old`)\n  contract: Int = 0,\n  // inside a fact made of two lists' elements known equal\n  in_same: Int = 0,\n  // the lists whose facts about every element are being given to one of\n  // them (`known_of`): a fact about a list's elements that takes another\n  // element of it (`!contains(xs, x)`) is not given again to that one\n  knowing: List[Int] = [],\n  // comparing two lists the code compares (`binary`)\n  list_eq: Int = 0,\n  // the prefix-sum functions of lists (`prefix_sum`), by list and function\n  sum_fns: Dict[String, String] = Dict[String, String] {},\n  // those of `sum_fns` of a list through a function: the list, the\n  // function and the prefix-sum function (for `for_element`)\n  mapped_sums: List[(Int, smt.Func, String)] = [],\n  // the lengths of the lists whose first elements are in `input_elems`\n  input_lens: Dict[Int, String] = Dict[Int, String] {},\n  // the recursive functions unfolded in contracts, as SMT functions: by\n  // symbol, their argument sorts and result sort (`rec_call`)\n  rec_fns: Dict[String, (List[String], String)] = Dict[String, (List[String], String)] {},\n  // nesting depth of unfolding them\n  unfolding: Int = 0,\n  // making a definition (`define_fn`): no unknown may be made\n  defining: Int = 0,\n  // the orders of values of a sort `compare` uses (the order unknown: a\n  // function of the two values), with their sorts\n  orders: List[(String, String)] = [],\n  // the functions contracts see through, each defined once (`def_call`):\n  // its symbol and its `define-fun` (or `define-fun-rec`), each after those\n  // it uses; by function and argument sorts, its symbol (`\"\"`: it has no\n  // definition, its body not being one term of its parameters)\n  fun_defs: List[(String, String)] = [],\n  def_index: Dict[String, String] = Dict[String, String] {},\n  // the definitions' parameters and recursive calls, by key (`def_call`);\n  // in a definition being made, the recursive calls met; the uses of\n  // recursive functions stated, by levels and application (`rec_use`)\n  def_info: Dict[String, smt.DefInfo] = Dict[String, smt.DefInfo] {},\n  calls: List[(String, List[String])] = [],\n  rec_stated: Set[String] = Set[String] {},\n  // nesting depth of comparing two datatype terms of different sorts\n  data_eq: Int = 0,\n  // uninterpreted functions of a receiver, standing for pure methods seen\n  // only through their contracts (a trait model, `self.total()`): name,\n  // receiver sort, result sort (`receiver_term`)\n  of_receiver: List[(String, String, String)] = [],\n  // the polarity of the Bool being made, read by `eval`:\n  // 1: only ever assumed true (a fact of every position, inside `all`);\n  // -1: only ever proven (inside `every`);\n  // 0: either.\n  // `all` makes only the direction it needs, so a quantifier is never\n  // nested in another (`all_of`).\n  polarity: Int = 0,\n  // the polarity of the call being made (`call`, `builtin` read it)\n  call_pol: Int = 0,\n  // how many seen-through bodies (in a contract) the run is in. There a\n  // refined constructor that may fail is a value only where it doesn't\n  // (`ctor`).\n  through: Int = 0,\n  // what holds of every entry of a dict (`all(d.items(), f)` assumed), the\n  // keys read in dicts' arrays, and whether such a fact is being stated\n  // (`map_instance` does not recurse)\n  map_alls: List[smt.MapAll] = [],\n  map_reads: List[smt.MapRead] = [],\n  map_inst: Int = 0,\n  // each array made by a store, with the array it was stored into\n  map_from: Dict[String, String] = Dict[String, String] {},\n  // the facts in `defs`, to make each once\n  def_set: Set[String] = Set[String] {},\n  // each `for`'s list, by the name its index loop binds it to (`for_loop`)\n  for_lists: Dict[String, ast.Expr] = Dict[String, ast.Expr] {},\n  // the variable the body ends with, and the result's type\n  returned: Option[(String, ast.TypeExpr)] = None,\n  // the obligations made before each loop whose invariant search was left\n  // out (`Methods.search` 0): a check failing after one of them asks for\n  // the search (compiler `verify`)\n  skipped: List[Int] = [],\n  // `unique` of each list asked, by its id: the same list, the same answer\n  uniques: Dict[Int, String] = Dict[Int, String] {},\n  // those loops, with where their checks are (for `verify` to say which\n  // loop a check failing after one of them may need an invariant of)\n  skipped_loops: List[smt.SkippedLoop] = [],\n  // the expression the body ends with, as shown (what its `ensures` are\n  // about, for `verify` to name)\n  result_text: String = \"\",\n}"},{"name":"smt.call","kind":"fn","old":"13c9493e64219b9b","new":"97fb095a4e11a1d0","interface_changed":false,"affected":[],"module":"smt","text":"fn call(\n  mut vc: smt.Vc,\n  name: String,\n  arg_exprs: List[ast.Expr],\n  args: List[smt.Val],\n) -> smt.Val {\n  // the polarity of the call's result (`Vc.polarity`), for the body seen\n  // through or the builtin\n  pol := vc.call_pol\n  vc.call_pol = 0\n  // a `for`'s element (`for_loop`): at its position, which is in range\n  if name == \"$at\" {\n    return smt.for_element(mut vc, args)\n  }\n  // `len(s.code_points())` is the SMT string's length, `len(s.bytes())` its\n  // `byte_len`: both modelled on `s` itself\n  if name == \"len\" {\n    match get(arg_exprs, 0) {\n      Some(a) => match smt.string_unit(a) {\n        Some((unit, s)) => {\n          v := smt.eval(mut vc, s)\n          return if unit == \"code_points\" {\n            smt.VInt(\"(str.len \" + smt.as_str(mut vc, v) + \")\")\n          } else {\n            smt.builtin(mut vc, \"byte_len\", [s], [v])\n          }\n        },\n        None => (),\n      },\n      None => (),\n    }\n  }\n  // `len` of an iterator (a type implementing `FiniteIterator`) is its\n  // method\n  if name == \"len\" && len(args) == 1 {\n    match smt.implementation(vc, \"FiniteIterator::len\", args) {\n      Some(_) => match smt.method_call(\n        mut vc,\n        \"FiniteIterator::len\",\n        arg_exprs,\n        args,\n      ) {\n        Some(r) => return r,\n        None => (),\n      },\n      None => (),\n    }\n  }\n  match get(vc.fns, name) {\n    Some(f) => {\n      // a call of the function being checked in a function its code passes\n      // (`xs.all(x -> f(x))`), not in a contract nor a body seen through:\n      // by its contract, as a recursive call in the code is. Its body seen\n      // through there is seen through again at each element it is applied\n      // to, nested (`contracts.refn`'s queries were 15 MB)\n      own := (name == vc.self_name || name == vc.own_name)\n        && vc.contract == 0\n        && vc.see == 0\n        && vc.through == 0\n        && vc.unfolding == 0\n      if (vc.spec > 0 || vc.see > 0) && vc.depth < 4 && !own {\n        // in a contract or a loop's written invariant, a call is seen\n        // through to its body when it finishes and can't fail\n        if contains(vc.methods.unfold, name) {\n          match smt.def_call(mut vc, name, f, arg_exprs, args, true) {\n            Some(r) => return r,\n            None => (),\n          }\n          match smt.rec_call(mut vc, name, f, args) {\n            Some(r) => return r,\n            None => (),\n          }\n        }\n        match get(vc.methods.seen, name) ?? smt.ContractOnly {\n          smt.SeeThrough => {\n            if contains(vc.methods.assumed, name) {\n              mut vc.relied_on.insert(name)\n            }\n            match smt.def_call(mut vc, name, f, arg_exprs, args, false) {\n              Some(r) => return r,\n              None => (),\n            }\n            // the same call on the same values already made a list: reuse\n            // it instead of a second one said equal element by element\n            key := smt.call_key(vc, name, arg_exprs, args)\n            match key {\n              Some(k) => match get(vc.memo, k) {\n                Some(before) => match before {\n                  smt.VList { .. } => return before,\n                  _ => (),\n                },\n                None => (),\n              },\n              None => (),\n            }\n            binds := dict(zip(f.params.map(p -> p.name), args))\n            vc.depth += 1\n            vc.spec += 1\n            vc.through += 1\n            saved := vc.scopes\n            vc.scopes = [binds]\n            r := smt.eval_pol(mut vc, f.body, pol)\n            vc.scopes = saved\n            vc.through -= 1\n            vc.spec -= 1\n            vc.depth -= 1\n            // the same call in the code on the same values gave the same\n            // result: when its body is made both ways, `pol` 0\n            if pol == 0 {\n              smt.same_call(mut vc, key, r)\n            }\n            return r\n          },\n          smt.NotKnown => smt.gap(\n            mut vc,\n            f\"the call of `{name}` in a contract (whether it finishes needs a proof not ported)\",\n          ),\n          smt.ContractOnly => (),\n        }\n      }\n      r := smt.call_contract(mut vc, name, f, args)\n      smt.write_after(mut vc, f.params, arg_exprs)\n      // a function a contract sees through gives the same result on the\n      // same values, so what a contract says of its body holds of this call\n      if vc.spec == 0\n        && !f.params.any(p -> p.mutable)\n        && match get(vc.methods.seen, name) {\n          Some(smt.SeeThrough) => true,\n          _ => false,\n        } {\n        smt.same_call(\n          mut vc,\n          smt.call_key(vc, name, arg_exprs, args),\n          r,\n        )\n      }\n      r\n    },\n    // (a builtin's name called on a value of a program's type, `todo.\n    // insert(mut db)`: a trait's method, never the builtin)\n    None => if vc.builtins.any(b -> b.name == name)\n      && !(match smt.head_of(vc, get(args, 0) ?? smt.UnitVal) {\n          Some(h) => contains(vc.types, h),\n          None => false,\n        }\n        && smt.method_contract(vc, name) is Some) {\n      vc.call_pol = pol\n      smt.builtin(mut vc, name, arg_exprs, args)\n    } else {\n      match smt.method_call(mut vc, name, arg_exprs, args) {\n        Some(r) => r,\n        None => match keys(vc.fns).filter(k -> ends_with(k, \".\" + name)) {\n          // a module's function called as a method (`s.graphemes()` is\n          // `std.unicode.graphemes(s)`), as the resolver reads it\n          [q] => match get(vc.fns, q) {\n            // a capability's function called on one (`clock.seconds()`):\n            // the receiver isn't an argument\n            Some(f) => if len(f.params) + 1 == len(args) {\n              smt.call(mut vc, q, drop(arg_exprs, 1), drop(args, 1))\n            } else {\n              smt.call(mut vc, q, arg_exprs, args)\n            },\n            None => smt.call(mut vc, q, arg_exprs, args),\n          },\n          // a builtin stored under a module's name (`std.http.get`, where\n          // the module's type has a method `get`).\n          // `T.check(x)` on any type: whether `x` meets the type's\n          // refinements, an unconstrained `Result[(), String]`.\n          _ => if contains(name, \".\")\n            && vc.builtins.any(b -> b.name == smt.last_name(name)) {\n            smt.builtin(\n              mut vc,\n              smt.last_name(name),\n              arg_exprs,\n              args,\n            )\n          } else if name == \"check\" {\n            smt.shape(mut vc, ast.Named {\n              name: \"Result\",\n              args: [ast.UnitType, ast.Named { name: \"String\", args: [] }],\n            })\n          } else {\n            smt.gap(mut vc, f\"the method `{name}`\")\n            smt.Opaque(f\"the result of `{name}`\")\n          },\n        },\n      }\n    },\n  }\n}","old_text":"fn call(\n  mut vc: smt.Vc,\n  name: String,\n  arg_exprs: List[ast.Expr],\n  args: List[smt.Val],\n) -> smt.Val {\n  // the polarity of the call's result (`Vc.polarity`), for the body seen\n  // through or the builtin\n  pol := vc.call_pol\n  vc.call_pol = 0\n  // a `for`'s element (`for_loop`): at its position, which is in range\n  if name == \"$at\" {\n    return smt.for_element(mut vc, args)\n  }\n  // `len(s.code_points())` is the SMT string's length, `len(s.bytes())` its\n  // `byte_len`: both modelled on `s` itself\n  if name == \"len\" {\n    match get(arg_exprs, 0) {\n      Some(a) => match smt.string_unit(a) {\n        Some((unit, s)) => {\n          v := smt.eval(mut vc, s)\n          return if unit == \"code_points\" {\n            smt.VInt(\"(str.len \" + smt.as_str(mut vc, v) + \")\")\n          } else {\n            smt.builtin(mut vc, \"byte_len\", [s], [v])\n          }\n        },\n        None => (),\n      },\n      None => (),\n    }\n  }\n  // `len` of an iterator (a type implementing `FiniteIterator`) is its\n  // method\n  if name == \"len\" && len(args) == 1 {\n    match smt.implementation(vc, \"FiniteIterator::len\", args) {\n      Some(_) => match smt.method_call(\n        mut vc,\n        \"FiniteIterator::len\",\n        arg_exprs,\n        args,\n      ) {\n        Some(r) => return r,\n        None => (),\n      },\n      None => (),\n    }\n  }\n  match get(vc.fns, name) {\n    Some(f) => {\n      // a call of the function being checked in a function its code passes\n      // (`xs.all(x -> f(x))`), not in a contract nor a body seen through:\n      // by its contract, as a recursive call in the code is. Its body seen\n      // through there is seen through again at each element it is applied\n      // to, nested (`contracts.refn`'s queries were 15 MB)\n      own := name == vc.self_name\n        && vc.contract == 0\n        && vc.see == 0\n        && vc.through == 0\n        && vc.unfolding == 0\n      if (vc.spec > 0 || vc.see > 0) && vc.depth < 4 && !own {\n        // in a contract or a loop's written invariant, a call is seen\n        // through to its body when it finishes and can't fail\n        if contains(vc.methods.unfold, name) {\n          match smt.def_call(mut vc, name, f, arg_exprs, args, true) {\n            Some(r) => return r,\n            None => (),\n          }\n          match smt.rec_call(mut vc, name, f, args) {\n            Some(r) => return r,\n            None => (),\n          }\n        }\n        match get(vc.methods.seen, name) ?? smt.ContractOnly {\n          smt.SeeThrough => {\n            if contains(vc.methods.assumed, name) {\n              mut vc.relied_on.insert(name)\n            }\n            match smt.def_call(mut vc, name, f, arg_exprs, args, false) {\n              Some(r) => return r,\n              None => (),\n            }\n            // the same call on the same values already made a list: reuse\n            // it instead of a second one said equal element by element\n            key := smt.call_key(vc, name, arg_exprs, args)\n            match key {\n              Some(k) => match get(vc.memo, k) {\n                Some(before) => match before {\n                  smt.VList { .. } => return before,\n                  _ => (),\n                },\n                None => (),\n              },\n              None => (),\n            }\n            binds := dict(zip(f.params.map(p -> p.name), args))\n            vc.depth += 1\n            vc.spec += 1\n            vc.through += 1\n            saved := vc.scopes\n            vc.scopes = [binds]\n            r := smt.eval_pol(mut vc, f.body, pol)\n            vc.scopes = saved\n            vc.through -= 1\n            vc.spec -= 1\n            vc.depth -= 1\n            // the same call in the code on the same values gave the same\n            // result: when its body is made both ways, `pol` 0\n            if pol == 0 {\n              smt.same_call(mut vc, key, r)\n            }\n            return r\n          },\n          smt.NotKnown => smt.gap(\n            mut vc,\n            f\"the call of `{name}` in a contract (whether it finishes needs a proof not ported)\",\n          ),\n          smt.ContractOnly => (),\n        }\n      }\n      r := smt.call_contract(mut vc, name, f, args)\n      smt.write_after(mut vc, f.params, arg_exprs)\n      // a function a contract sees through gives the same result on the\n      // same values, so what a contract says of its body holds of this call\n      if vc.spec == 0\n        && !f.params.any(p -> p.mutable)\n        && match get(vc.methods.seen, name) {\n          Some(smt.SeeThrough) => true,\n          _ => false,\n        } {\n        smt.same_call(\n          mut vc,\n          smt.call_key(vc, name, arg_exprs, args),\n          r,\n        )\n      }\n      r\n    },\n    // (a builtin's name called on a value of a program's type, `todo.\n    // insert(mut db)`: a trait's method, never the builtin)\n    None => if vc.builtins.any(b -> b.name == name)\n      && !(match smt.head_of(vc, get(args, 0) ?? smt.UnitVal) {\n          Some(h) => contains(vc.types, h),\n          None => false,\n        }\n        && smt.method_contract(vc, name) is Some) {\n      vc.call_pol = pol\n      smt.builtin(mut vc, name, arg_exprs, args)\n    } else {\n      match smt.method_call(mut vc, name, arg_exprs, args) {\n        Some(r) => r,\n        None => match keys(vc.fns).filter(k -> ends_with(k, \".\" + name)) {\n          // a module's function called as a method (`s.graphemes()` is\n          // `std.unicode.graphemes(s)`), as the resolver reads it\n          [q] => match get(vc.fns, q) {\n            // a capability's function called on one (`clock.seconds()`):\n            // the receiver isn't an argument\n            Some(f) => if len(f.params) + 1 == len(args) {\n              smt.call(mut vc, q, drop(arg_exprs, 1), drop(args, 1))\n            } else {\n              smt.call(mut vc, q, arg_exprs, args)\n            },\n            None => smt.call(mut vc, q, arg_exprs, args),\n          },\n          // a builtin stored under a module's name (`std.http.get`, where\n          // the module's type has a method `get`).\n          // `T.check(x)` on any type: whether `x` meets the type's\n          // refinements, an unconstrained `Result[(), String]`.\n          _ => if contains(name, \".\")\n            && vc.builtins.any(b -> b.name == smt.last_name(name)) {\n            smt.builtin(\n              mut vc,\n              smt.last_name(name),\n              arg_exprs,\n              args,\n            )\n          } else if name == \"check\" {\n            smt.shape(mut vc, ast.Named {\n              name: \"Result\",\n              args: [ast.UnitType, ast.Named { name: \"String\", args: [] }],\n            })\n          } else {\n            smt.gap(mut vc, f\"the method `{name}`\")\n            smt.Opaque(f\"the result of `{name}`\")\n          },\n        },\n      }\n    },\n  }\n}"},{"name":"smt.function","kind":"fn","old":"162051c8fd216222","new":"d744652cefc8fbbe","interface_changed":false,"affected":[],"module":"smt","text":"/// Runs `f` symbolically, collecting its obligations and what it uses that\n/// smt doesn't model (`gaps`).\npub fn function(mut vc: smt.Vc, f: ast.FnDecl, label: String) {\n  vc.self_name = label\n  vc.own_name = f.name\n  vc.own_whiles = smt.while_loops(f.body)\n  for p in f.params {\n    v := smt.havoc(mut vc, p.ty)\n    if p.mutable {\n      smt.declare(mut vc, p.name, Some(p.ty))\n      mut vc.mut_params.push(p.name)\n    }\n    mut vc.params.push((p.name, v))\n    smt.bind(mut vc, p.name, v)\n  }\n  // the lists' first elements, for a counterexample to show (their facts\n  // set aside): one level of nested lists, bounded in terms\n  if vc.examples {\n    nf := len(vc.facts)\n    mut lens := []\n    mut ls := []\n    vc.input_depth = 1\n    for (_, v) in vc.params {\n      smt.open_input(mut vc, v, 0, mut lens, mut ls)\n    }\n    vc.input_depth = 3\n    vc.example_facts = drop(vc.facts, nf)\n    vc.facts = take(vc.facts, nf)\n    vc.example_leaves = ls\n  }\n  binds := vc.params\n  for r in f.pre {\n    c := smt.pred(mut vc, r, binds)\n    mut vc.pc.push(c)\n  }\n  // what a loop may need to keep: the `ensures` of the returned variable,\n  // and those of a `mut` parameter that don't name the result\n  match f.body {\n    ast.Block { last: ast.Var(x), .. } => {\n      vc.hints = f.post.map(e -> (e, x))\n      vc.returned = Some((x, f.ret))\n    },\n    _ => (),\n  }\n  for p in f.params {\n    if p.mutable {\n      for e in f.post {\n        names := smt.var_names(e)\n        if contains(names, p.name)\n          && !contains(names, \"it\")\n          && !vc.hints.any(h -> h.0 == e && h.1 == p.name) {\n          mut vc.hints.push((e, p.name))\n        }\n      }\n    }\n  }\n  vc.result_text = match f.body {\n    ast.Block { last, .. } => text.expr_text(last, 0),\n    other => text.expr_text(other, 0),\n  }\n  vc.requires_hints = f.pre\n  res := smt.eval(mut vc, f.body)\n  // the result is checked where the body ends and at every early return\n  mut exits := []\n  if !vc.dead {\n    mut exits.push((vc.pc, res, \"\", smt.mut_state(vc)))\n  }\n  for x in vc.returns {\n    mut exits.push((x.pc, x.value, \" (early return)\", x.state))\n  }\n  vc.returns = []\n  shown := smt.shown_name(label)\n  for (pc, value, how, state) in exits {\n    vc.pc = pc\n    vc.dead = false\n    // the `ensures` name the `mut` parameters as they are at this exit,\n    // `old x` as they were on entry\n    after := smt.rebound(binds, state)\n    if smt.refined(vc, f.ret) {\n      if smt.start_goal(mut vc) {\n        g := smt.check_type(mut vc, f.ret, value, binds)\n        smt.oblige(\n          mut vc,\n          f\"result of `{shown}`{how}: {text.type_text(f.ret)}\",\n          g,\n        )\n      }\n    }\n    for en in f.post {\n      n := len(vc.pc)\n      if smt.start_goal(mut vc) {\n        g := smt.pred_old(\n          mut vc,\n          en,\n          after + [(\"it\", value)],\n          Some(binds),\n        )\n        smt.oblige(\n          mut vc,\n          f\"ensures {text.expr_text(en, 0)}{how}\",\n          g,\n        )\n      }\n      vc.pc = take(vc.pc, n)\n    }\n  }\n}","old_text":"/// Runs `f` symbolically, collecting its obligations and what it uses that\n/// smt doesn't model (`gaps`).\npub fn function(mut vc: smt.Vc, f: ast.FnDecl, label: String) {\n  vc.self_name = label\n  vc.own_whiles = smt.while_loops(f.body)\n  for p in f.params {\n    v := smt.havoc(mut vc, p.ty)\n    if p.mutable {\n      smt.declare(mut vc, p.name, Some(p.ty))\n      mut vc.mut_params.push(p.name)\n    }\n    mut vc.params.push((p.name, v))\n    smt.bind(mut vc, p.name, v)\n  }\n  // the lists' first elements, for a counterexample to show (their facts\n  // set aside): one level of nested lists, bounded in terms\n  if vc.examples {\n    nf := len(vc.facts)\n    mut lens := []\n    mut ls := []\n    vc.input_depth = 1\n    for (_, v) in vc.params {\n      smt.open_input(mut vc, v, 0, mut lens, mut ls)\n    }\n    vc.input_depth = 3\n    vc.example_facts = drop(vc.facts, nf)\n    vc.facts = take(vc.facts, nf)\n    vc.example_leaves = ls\n  }\n  binds := vc.params\n  for r in f.pre {\n    c := smt.pred(mut vc, r, binds)\n    mut vc.pc.push(c)\n  }\n  // what a loop may need to keep: the `ensures` of the returned variable,\n  // and those of a `mut` parameter that don't name the result\n  match f.body {\n    ast.Block { last: ast.Var(x), .. } => {\n      vc.hints = f.post.map(e -> (e, x))\n      vc.returned = Some((x, f.ret))\n    },\n    _ => (),\n  }\n  for p in f.params {\n    if p.mutable {\n      for e in f.post {\n        names := smt.var_names(e)\n        if contains(names, p.name)\n          && !contains(names, \"it\")\n          && !vc.hints.any(h -> h.0 == e && h.1 == p.name) {\n          mut vc.hints.push((e, p.name))\n        }\n      }\n    }\n  }\n  vc.result_text = match f.body {\n    ast.Block { last, .. } => text.expr_text(last, 0),\n    other => text.expr_text(other, 0),\n  }\n  vc.requires_hints = f.pre\n  res := smt.eval(mut vc, f.body)\n  // the result is checked where the body ends and at every early return\n  mut exits := []\n  if !vc.dead {\n    mut exits.push((vc.pc, res, \"\", smt.mut_state(vc)))\n  }\n  for x in vc.returns {\n    mut exits.push((x.pc, x.value, \" (early return)\", x.state))\n  }\n  vc.returns = []\n  shown := smt.shown_name(label)\n  for (pc, value, how, state) in exits {\n    vc.pc = pc\n    vc.dead = false\n    // the `ensures` name the `mut` parameters as they are at this exit,\n    // `old x` as they were on entry\n    after := smt.rebound(binds, state)\n    if smt.refined(vc, f.ret) {\n      if smt.start_goal(mut vc) {\n        g := smt.check_type(mut vc, f.ret, value, binds)\n        smt.oblige(\n          mut vc,\n          f\"result of `{shown}`{how}: {text.type_text(f.ret)}\",\n          g,\n        )\n      }\n    }\n    for en in f.post {\n      n := len(vc.pc)\n      if smt.start_goal(mut vc) {\n        g := smt.pred_old(\n          mut vc,\n          en,\n          after + [(\"it\", value)],\n          Some(binds),\n        )\n        smt.oblige(\n          mut vc,\n          f\"ensures {text.expr_text(en, 0)}{how}\",\n          g,\n        )\n      }\n      vc.pc = take(vc.pc, n)\n    }\n  }\n}"}]}
{"id":"639ca846441ee131","time":1795666629,"message":"edit","changes":[{"name":"smt.Vc","kind":"type","old":"848ebeb261127b1a","new":"4fc596456fa8777d","interface_changed":false,"affected":[],"module":"smt","text":"/// The state of the symbolic run of one function.\npub type Vc = {\n  // the functions and types of the program, std and core, by the names\n  // code uses, and the builtins' signatures\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  builtins: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  // each sum type's variants, with the type's name\n  parents: Dict[String, String],\n  // each constructor, with its type's name\n  ctors: Dict[String, String],\n  consts: List[smt.Const],\n  next_var: Int,\n  facts: List[String],\n  // facts that hold on every path (what a term's type gives)\n  defs: List[String],\n  // why each unknown was made (something not modelled)\n  reasons: Dict[String, String],\n  reason: Option[String],\n  pc: List[String],\n  scopes: List[Dict[String, smt.Val]],\n  obligations: List[smt.Obligation],\n  // obligations true for all values: proven without a query\n  given: List[String],\n  // inside a contract or refinement: no obligations are made there\n  spec: Int,\n  proving: Int,\n  dead: Bool,\n  depth: Int,\n  returns: List[smt.Exit],\n  memo: Dict[String, smt.Val],\n  bit_terms: Dict[String, String],\n  // the types variables were declared with, which hold after each\n  // assignment\n  declared: Dict[String, List[ast.TypeExpr]],\n  params: List[(String, smt.Val)],\n  // the sorts, in the order met, by name\n  sorts: List[(String, smt.SortDef)],\n  sort_index: Dict[String, Int],\n  // the validity predicates (name, sort), by type and sort\n  valid: List[(String, String)],\n  valid_index: Dict[String, Int],\n  // the validity predicates defined, and the terms unfolded\n  defined: Set[String],\n  unfolded: Dict[String, smt.Val],\n  // strings read from datatype values, named in the queries\n  str_terms: List[String],\n  // the types being checked (a recursive one is checked to a fixed depth)\n  checking: List[String],\n  cutoffs: Dict[String, String],\n  // the lists, by id\n  lists: List[smt.ListInfo],\n  // open scopes (a quantified fact, a template): where the unknowns and\n  // facts made inside them start\n  regions: List[(Int, Int)],\n  // the positions new unknowns are functions of (a list's template)\n  indexing: Option[List[String]],\n  // the quantifier nesting, and the quantified variables made\n  binding: Int,\n  qvars: Int,\n  // the unknowns a quantifier binds\n  bound: Set[String],\n  // nesting depth of lists compared by position\n  eq_depth: Int,\n  // the functions passed to the call being made, by argument\n  fn_args: List[Option[smt.Func]],\n  // the `break`s and `continue`s of the loops being run, innermost last\n  breaks: List[List[smt.Jump]],\n  continues: List[List[smt.Jump]],\n  // inside a trial pass of a loop: inner loops infer nothing\n  trial: Int,\n  // in a trial pass, the values callees wrote back to `mut` arguments of a\n  // type without refinements: any value of the type, nothing known\n  wiped: List[smt.Val],\n  // candidate invariants: the `ensures` of the returned variable, and the\n  // `requires`\n  hints: List[(ast.Expr, String)],\n  requires_hints: List[ast.Expr],\n  // the solver's answers from earlier runs, by query, and the queries\n  // this run still needs\n  answers: Dict[String, String],\n  pending: List[String],\n  // the strings tested against regular expressions: the string, the\n  // pattern, its Bool, and whether it is approximated\n  matched: List[(String, String, String, Bool)],\n  // what this function uses that smt doesn't model\n  gaps: List[String],\n  // for the termination check: the function's own name (a call of it is\n  // recursion), its `while` loops, its recursive calls (path and\n  // arguments), their obligations (kept apart), and the type of each\n  // non-list value a `for` runs over (`\"\"` when not known)\n  self_name: String,\n  loops: List[smt.LoopInfo],\n  rec_sites: List[(List[String], List[smt.Val])],\n  term_obs: List[smt.Obligation],\n  iter_fors: List[String],\n  // for `verify`'s report: the loop invariants inferred, and the functions\n  // seen through whose finishing is only assumed (`terminates`)\n  invariants: List[String],\n  relied_on: Set[String],\n  // `verify`'s counterexamples (`Methods.examples`): each list parameter's\n  // first elements (`input_elems`). Their facts and terms are set aside for\n  // a second query when a model can't be shown without them.\n  examples: Bool,\n  example_facts: List[String],\n  example_leaves: List[String],\n  input_elems: Dict[Int, List[smt.Val]],\n  input_depth: Int,\n  // a running solver (c/solver.c) that `ask` sends each question to as it\n  // comes, waiting for the answer, so the function is run once. With `\"\"`\n  // the questions stay pending and the run is repeated once answered.\n  live: String,\n  // the function's own `while` loops (`while_loops`), to tell them from\n  // those of callees seen through\n  own_whiles: List[(ast.Expr, ast.Expr)],\n  // the cost of the loop-invariant searches (solver resource units and\n  // microseconds, from their answers), and whether one was refused because\n  // the run's search budget was used up\n  search_units: Int,\n  search_micros: Int,\n  search_cut: Bool,\n  // inside a loop with written invariants: inference asks only at a\n  // proof's limit, and gives up at the first unanswered question\n  cheap: Int,\n  // for `verify` to write: each own `while` loop's inferred invariants and\n  // their cost\n  found_loops: List[smt.LoopFound],\n  // the `mut` parameters of the function. Its `ensures` name their values\n  // at each exit; `old x` is the starting value.\n  mut_params: List[String] = [],\n  // in an `ensures`: what `old e` reads (the values at the function's\n  // start, or the arguments before a call)\n  olds: Option[Dict[String, smt.Val]] = None,\n  // after a call seen through its contract: the `mut` parameters' values\n  // it leaves (`write_after` writes them back)\n  after: List[smt.Val] = [],\n  // the dicts and sets among the lists, by id, with their types. An\n  // input's is shown as a dict or set (`literal_of`).\n  keyed: Dict[Int, ast.TypeExpr],\n  // dict and set entries by list id: an SMT array from each key to an\n  // `Option` of its value (dict) or a Bool (set). Its size is a function\n  // of the array (`map_sorts`).\n  arrays: Dict[Int, String],\n  // the type a `let` gives the dict or set literal bound to it, so `set`\n  // and `dict` make an array of that type\n  want: Option[(ast.Expr, ast.TypeExpr)],\n  // in a loop's written invariant: calls are seen through as in a contract\n  see: Int = 0,\n  // inside a contract or refinement (`pred_old`)\n  contract: Int = 0,\n  // the name of the function being run (`function`), unqualified\n  own_name: String = \"\",\n  // inside a fact made of two lists' elements known equal\n  in_same: Int = 0,\n  // the lists whose facts about every element are being given to one of\n  // them (`known_of`): a fact about a list's elements that takes another\n  // element of it (`!contains(xs, x)`) is not given again to that one\n  knowing: List[Int] = [],\n  // comparing two lists the code compares (`binary`)\n  list_eq: Int = 0,\n  // the prefix-sum functions of lists (`prefix_sum`), by list and function\n  sum_fns: Dict[String, String] = Dict[String, String] {},\n  // those of `sum_fns` of a list through a function: the list, the\n  // function and the prefix-sum function (for `for_element`)\n  mapped_sums: List[(Int, smt.Func, String)] = [],\n  // the lengths of the lists whose first elements are in `input_elems`\n  input_lens: Dict[Int, String] = Dict[Int, String] {},\n  // the recursive functions unfolded in contracts, as SMT functions: by\n  // symbol, their argument sorts and result sort (`rec_call`)\n  rec_fns: Dict[String, (List[String], String)] = Dict[String, (List[String], String)] {},\n  // nesting depth of unfolding them\n  unfolding: Int = 0,\n  // making a definition (`define_fn`): no unknown may be made\n  defining: Int = 0,\n  // the orders of values of a sort `compare` uses (the order unknown: a\n  // function of the two values), with their sorts\n  orders: List[(String, String)] = [],\n  // the functions contracts see through, each defined once (`def_call`):\n  // its symbol and its `define-fun` (or `define-fun-rec`), each after those\n  // it uses; by function and argument sorts, its symbol (`\"\"`: it has no\n  // definition, its body not being one term of its parameters)\n  fun_defs: List[(String, String)] = [],\n  def_index: Dict[String, String] = Dict[String, String] {},\n  // the definitions' parameters and recursive calls, by key (`def_call`);\n  // in a definition being made, the recursive calls met; the uses of\n  // recursive functions stated, by levels and application (`rec_use`)\n  def_info: Dict[String, smt.DefInfo] = Dict[String, smt.DefInfo] {},\n  calls: List[(String, List[String])] = [],\n  rec_stated: Set[String] = Set[String] {},\n  // nesting depth of comparing two datatype terms of different sorts\n  data_eq: Int = 0,\n  // uninterpreted functions of a receiver, standing for pure methods seen\n  // only through their contracts (a trait model, `self.total()`): name,\n  // receiver sort, result sort (`receiver_term`)\n  of_receiver: List[(String, String, String)] = [],\n  // the polarity of the Bool being made, read by `eval`:\n  // 1: only ever assumed true (a fact of every position, inside `all`);\n  // -1: only ever proven (inside `every`);\n  // 0: either.\n  // `all` makes only the direction it needs, so a quantifier is never\n  // nested in another (`all_of`).\n  polarity: Int = 0,\n  // the polarity of the call being made (`call`, `builtin` read it)\n  call_pol: Int = 0,\n  // how many seen-through bodies (in a contract) the run is in. There a\n  // refined constructor that may fail is a value only where it doesn't\n  // (`ctor`).\n  through: Int = 0,\n  // what holds of every entry of a dict (`all(d.items(), f)` assumed), the\n  // keys read in dicts' arrays, and whether such a fact is being stated\n  // (`map_instance` does not recurse)\n  map_alls: List[smt.MapAll] = [],\n  map_reads: List[smt.MapRead] = [],\n  map_inst: Int = 0,\n  // each array made by a store, with the array it was stored into\n  map_from: Dict[String, String] = Dict[String, String] {},\n  // the facts in `defs`, to make each once\n  def_set: Set[String] = Set[String] {},\n  // each `for`'s list, by the name its index loop binds it to (`for_loop`)\n  for_lists: Dict[String, ast.Expr] = Dict[String, ast.Expr] {},\n  // the variable the body ends with, and the result's type\n  returned: Option[(String, ast.TypeExpr)] = None,\n  // the obligations made before each loop whose invariant search was left\n  // out (`Methods.search` 0): a check failing after one of them asks for\n  // the search (compiler `verify`)\n  skipped: List[Int] = [],\n  // `unique` of each list asked, by its id: the same list, the same answer\n  uniques: Dict[Int, String] = Dict[Int, String] {},\n  // those loops, with where their checks are (for `verify` to say which\n  // loop a check failing after one of them may need an invariant of)\n  skipped_loops: List[smt.SkippedLoop] = [],\n  // the expression the body ends with, as shown (what its `ensures` are\n  // about, for `verify` to name)\n  result_text: String = \"\",\n}","old_text":"/// The state of the symbolic run of one function.\npub type Vc = {\n  // the functions and types of the program, std and core, by the names\n  // code uses, and the builtins' signatures\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  builtins: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  // each sum type's variants, with the type's name\n  parents: Dict[String, String],\n  // each constructor, with its type's name\n  ctors: Dict[String, String],\n  consts: List[smt.Const],\n  next_var: Int,\n  facts: List[String],\n  // facts that hold on every path (what a term's type gives)\n  defs: List[String],\n  // why each unknown was made (something not modelled)\n  reasons: Dict[String, String],\n  reason: Option[String],\n  pc: List[String],\n  scopes: List[Dict[String, smt.Val]],\n  obligations: List[smt.Obligation],\n  // obligations true for all values: proven without a query\n  given: List[String],\n  // inside a contract or refinement: no obligations are made there\n  spec: Int,\n  proving: Int,\n  dead: Bool,\n  depth: Int,\n  returns: List[smt.Exit],\n  memo: Dict[String, smt.Val],\n  bit_terms: Dict[String, String],\n  // the types variables were declared with, which hold after each\n  // assignment\n  declared: Dict[String, List[ast.TypeExpr]],\n  params: List[(String, smt.Val)],\n  // the sorts, in the order met, by name\n  sorts: List[(String, smt.SortDef)],\n  sort_index: Dict[String, Int],\n  // the validity predicates (name, sort), by type and sort\n  valid: List[(String, String)],\n  valid_index: Dict[String, Int],\n  // the validity predicates defined, and the terms unfolded\n  defined: Set[String],\n  unfolded: Dict[String, smt.Val],\n  // strings read from datatype values, named in the queries\n  str_terms: List[String],\n  // the types being checked (a recursive one is checked to a fixed depth)\n  checking: List[String],\n  cutoffs: Dict[String, String],\n  // the lists, by id\n  lists: List[smt.ListInfo],\n  // open scopes (a quantified fact, a template): where the unknowns and\n  // facts made inside them start\n  regions: List[(Int, Int)],\n  // the positions new unknowns are functions of (a list's template)\n  indexing: Option[List[String]],\n  // the quantifier nesting, and the quantified variables made\n  binding: Int,\n  qvars: Int,\n  // the unknowns a quantifier binds\n  bound: Set[String],\n  // nesting depth of lists compared by position\n  eq_depth: Int,\n  // the functions passed to the call being made, by argument\n  fn_args: List[Option[smt.Func]],\n  // the `break`s and `continue`s of the loops being run, innermost last\n  breaks: List[List[smt.Jump]],\n  continues: List[List[smt.Jump]],\n  // inside a trial pass of a loop: inner loops infer nothing\n  trial: Int,\n  // in a trial pass, the values callees wrote back to `mut` arguments of a\n  // type without refinements: any value of the type, nothing known\n  wiped: List[smt.Val],\n  // candidate invariants: the `ensures` of the returned variable, and the\n  // `requires`\n  hints: List[(ast.Expr, String)],\n  requires_hints: List[ast.Expr],\n  // the solver's answers from earlier runs, by query, and the queries\n  // this run still needs\n  answers: Dict[String, String],\n  pending: List[String],\n  // the strings tested against regular expressions: the string, the\n  // pattern, its Bool, and whether it is approximated\n  matched: List[(String, String, String, Bool)],\n  // what this function uses that smt doesn't model\n  gaps: List[String],\n  // for the termination check: the function's own name (a call of it is\n  // recursion), its `while` loops, its recursive calls (path and\n  // arguments), their obligations (kept apart), and the type of each\n  // non-list value a `for` runs over (`\"\"` when not known)\n  self_name: String,\n  loops: List[smt.LoopInfo],\n  rec_sites: List[(List[String], List[smt.Val])],\n  term_obs: List[smt.Obligation],\n  iter_fors: List[String],\n  // for `verify`'s report: the loop invariants inferred, and the functions\n  // seen through whose finishing is only assumed (`terminates`)\n  invariants: List[String],\n  relied_on: Set[String],\n  // `verify`'s counterexamples (`Methods.examples`): each list parameter's\n  // first elements (`input_elems`). Their facts and terms are set aside for\n  // a second query when a model can't be shown without them.\n  examples: Bool,\n  example_facts: List[String],\n  example_leaves: List[String],\n  input_elems: Dict[Int, List[smt.Val]],\n  input_depth: Int,\n  // a running solver (c/solver.c) that `ask` sends each question to as it\n  // comes, waiting for the answer, so the function is run once. With `\"\"`\n  // the questions stay pending and the run is repeated once answered.\n  live: String,\n  // the function's own `while` loops (`while_loops`), to tell them from\n  // those of callees seen through\n  own_whiles: List[(ast.Expr, ast.Expr)],\n  // the cost of the loop-invariant searches (solver resource units and\n  // microseconds, from their answers), and whether one was refused because\n  // the run's search budget was used up\n  search_units: Int,\n  search_micros: Int,\n  search_cut: Bool,\n  // inside a loop with written invariants: inference asks only at a\n  // proof's limit, and gives up at the first unanswered question\n  cheap: Int,\n  // for `verify` to write: each own `while` loop's inferred invariants and\n  // their cost\n  found_loops: List[smt.LoopFound],\n  // the `mut` parameters of the function. Its `ensures` name their values\n  // at each exit; `old x` is the starting value.\n  mut_params: List[String] = [],\n  // in an `ensures`: what `old e` reads (the values at the function's\n  // start, or the arguments before a call)\n  olds: Option[Dict[String, smt.Val]] = None,\n  // after a call seen through its contract: the `mut` parameters' values\n  // it leaves (`write_after` writes them back)\n  after: List[smt.Val] = [],\n  // the dicts and sets among the lists, by id, with their types. An\n  // input's is shown as a dict or set (`literal_of`).\n  keyed: Dict[Int, ast.TypeExpr],\n  // dict and set entries by list id: an SMT array from each key to an\n  // `Option` of its value (dict) or a Bool (set). Its size is a function\n  // of the array (`map_sorts`).\n  arrays: Dict[Int, String],\n  // the type a `let` gives the dict or set literal bound to it, so `set`\n  // and `dict` make an array of that type\n  want: Option[(ast.Expr, ast.TypeExpr)],\n  // in a loop's written invariant: calls are seen through as in a contract\n  see: Int = 0,\n  // inside a contract or refinement (`pred_old`)\n  contract: Int = 0,\n  // the function being run (`function`), by its name in `fns`\n  own_name: String = \"\",\n  // inside a fact made of two lists' elements known equal\n  in_same: Int = 0,\n  // the lists whose facts about every element are being given to one of\n  // them (`known_of`): a fact about a list's elements that takes another\n  // element of it (`!contains(xs, x)`) is not given again to that one\n  knowing: List[Int] = [],\n  // comparing two lists the code compares (`binary`)\n  list_eq: Int = 0,\n  // the prefix-sum functions of lists (`prefix_sum`), by list and function\n  sum_fns: Dict[String, String] = Dict[String, String] {},\n  // those of `sum_fns` of a list through a function: the list, the\n  // function and the prefix-sum function (for `for_element`)\n  mapped_sums: List[(Int, smt.Func, String)] = [],\n  // the lengths of the lists whose first elements are in `input_elems`\n  input_lens: Dict[Int, String] = Dict[Int, String] {},\n  // the recursive functions unfolded in contracts, as SMT functions: by\n  // symbol, their argument sorts and result sort (`rec_call`)\n  rec_fns: Dict[String, (List[String], String)] = Dict[String, (List[String], String)] {},\n  // nesting depth of unfolding them\n  unfolding: Int = 0,\n  // making a definition (`define_fn`): no unknown may be made\n  defining: Int = 0,\n  // the orders of values of a sort `compare` uses (the order unknown: a\n  // function of the two values), with their sorts\n  orders: List[(String, String)] = [],\n  // the functions contracts see through, each defined once (`def_call`):\n  // its symbol and its `define-fun` (or `define-fun-rec`), each after those\n  // it uses; by function and argument sorts, its symbol (`\"\"`: it has no\n  // definition, its body not being one term of its parameters)\n  fun_defs: List[(String, String)] = [],\n  def_index: Dict[String, String] = Dict[String, String] {},\n  // the definitions' parameters and recursive calls, by key (`def_call`);\n  // in a definition being made, the recursive calls met; the uses of\n  // recursive functions stated, by levels and application (`rec_use`)\n  def_info: Dict[String, smt.DefInfo] = Dict[String, smt.DefInfo] {},\n  calls: List[(String, List[String])] = [],\n  rec_stated: Set[String] = Set[String] {},\n  // nesting depth of comparing two datatype terms of different sorts\n  data_eq: Int = 0,\n  // uninterpreted functions of a receiver, standing for pure methods seen\n  // only through their contracts (a trait model, `self.total()`): name,\n  // receiver sort, result sort (`receiver_term`)\n  of_receiver: List[(String, String, String)] = [],\n  // the polarity of the Bool being made, read by `eval`:\n  // 1: only ever assumed true (a fact of every position, inside `all`);\n  // -1: only ever proven (inside `every`);\n  // 0: either.\n  // `all` makes only the direction it needs, so a quantifier is never\n  // nested in another (`all_of`).\n  polarity: Int = 0,\n  // the polarity of the call being made (`call`, `builtin` read it)\n  call_pol: Int = 0,\n  // how many seen-through bodies (in a contract) the run is in. There a\n  // refined constructor that may fail is a value only where it doesn't\n  // (`ctor`).\n  through: Int = 0,\n  // what holds of every entry of a dict (`all(d.items(), f)` assumed), the\n  // keys read in dicts' arrays, and whether such a fact is being stated\n  // (`map_instance` does not recurse)\n  map_alls: List[smt.MapAll] = [],\n  map_reads: List[smt.MapRead] = [],\n  map_inst: Int = 0,\n  // each array made by a store, with the array it was stored into\n  map_from: Dict[String, String] = Dict[String, String] {},\n  // the facts in `defs`, to make each once\n  def_set: Set[String] = Set[String] {},\n  // each `for`'s list, by the name its index loop binds it to (`for_loop`)\n  for_lists: Dict[String, ast.Expr] = Dict[String, ast.Expr] {},\n  // the variable the body ends with, and the result's type\n  returned: Option[(String, ast.TypeExpr)] = None,\n  // the obligations made before each loop whose invariant search was left\n  // out (`Methods.search` 0): a check failing after one of them asks for\n  // the search (compiler `verify`)\n  skipped: List[Int] = [],\n  // `unique` of each list asked, by its id: the same list, the same answer\n  uniques: Dict[Int, String] = Dict[Int, String] {},\n  // those loops, with where their checks are (for `verify` to say which\n  // loop a check failing after one of them may need an invariant of)\n  skipped_loops: List[smt.SkippedLoop] = [],\n  // the expression the body ends with, as shown (what its `ensures` are\n  // about, for `verify` to name)\n  result_text: String = \"\",\n}"},{"name":"smt.call","kind":"fn","old":"97fb095a4e11a1d0","new":"5ef5069f387eb93b","interface_changed":false,"affected":[],"module":"smt","text":"fn call(\n  mut vc: smt.Vc,\n  name: String,\n  arg_exprs: List[ast.Expr],\n  args: List[smt.Val],\n) -> smt.Val {\n  // the polarity of the call's result (`Vc.polarity`), for the body seen\n  // through or the builtin\n  pol := vc.call_pol\n  vc.call_pol = 0\n  // a `for`'s element (`for_loop`): at its position, which is in range\n  if name == \"$at\" {\n    return smt.for_element(mut vc, args)\n  }\n  // `len(s.code_points())` is the SMT string's length, `len(s.bytes())` its\n  // `byte_len`: both modelled on `s` itself\n  if name == \"len\" {\n    match get(arg_exprs, 0) {\n      Some(a) => match smt.string_unit(a) {\n        Some((unit, s)) => {\n          v := smt.eval(mut vc, s)\n          return if unit == \"code_points\" {\n            smt.VInt(\"(str.len \" + smt.as_str(mut vc, v) + \")\")\n          } else {\n            smt.builtin(mut vc, \"byte_len\", [s], [v])\n          }\n        },\n        None => (),\n      },\n      None => (),\n    }\n  }\n  // `len` of an iterator (a type implementing `FiniteIterator`) is its\n  // method\n  if name == \"len\" && len(args) == 1 {\n    match smt.implementation(vc, \"FiniteIterator::len\", args) {\n      Some(_) => match smt.method_call(\n        mut vc,\n        \"FiniteIterator::len\",\n        arg_exprs,\n        args,\n      ) {\n        Some(r) => return r,\n        None => (),\n      },\n      None => (),\n    }\n  }\n  match get(vc.fns, name) {\n    Some(f) => {\n      // a call of the function being checked in a function its code passes\n      // (`xs.all(x -> f(x))`), not in a contract nor a body seen through:\n      // by its contract, as a recursive call in the code is. Its body seen\n      // through there is seen through again at each element it is applied\n      // to, nested (`contracts.refn`'s queries were 15 MB)\n      own := (name == vc.self_name\n          || f.name == vc.own_name && ends_with(name, \".\" + f.name))\n        && vc.contract == 0\n        && vc.see == 0\n        && vc.through == 0\n        && vc.unfolding == 0\n      if (vc.spec > 0 || vc.see > 0) && vc.depth < 4 && !own {\n        // in a contract or a loop's written invariant, a call is seen\n        // through to its body when it finishes and can't fail\n        if contains(vc.methods.unfold, name) {\n          match smt.def_call(mut vc, name, f, arg_exprs, args, true) {\n            Some(r) => return r,\n            None => (),\n          }\n          match smt.rec_call(mut vc, name, f, args) {\n            Some(r) => return r,\n            None => (),\n          }\n        }\n        match get(vc.methods.seen, name) ?? smt.ContractOnly {\n          smt.SeeThrough => {\n            if contains(vc.methods.assumed, name) {\n              mut vc.relied_on.insert(name)\n            }\n            match smt.def_call(mut vc, name, f, arg_exprs, args, false) {\n              Some(r) => return r,\n              None => (),\n            }\n            // the same call on the same values already made a list: reuse\n            // it instead of a second one said equal element by element\n            key := smt.call_key(vc, name, arg_exprs, args)\n            match key {\n              Some(k) => match get(vc.memo, k) {\n                Some(before) => match before {\n                  smt.VList { .. } => return before,\n                  _ => (),\n                },\n                None => (),\n              },\n              None => (),\n            }\n            binds := dict(zip(f.params.map(p -> p.name), args))\n            vc.depth += 1\n            vc.spec += 1\n            vc.through += 1\n            saved := vc.scopes\n            vc.scopes = [binds]\n            r := smt.eval_pol(mut vc, f.body, pol)\n            vc.scopes = saved\n            vc.through -= 1\n            vc.spec -= 1\n            vc.depth -= 1\n            // the same call in the code on the same values gave the same\n            // result: when its body is made both ways, `pol` 0\n            if pol == 0 {\n              smt.same_call(mut vc, key, r)\n            }\n            return r\n          },\n          smt.NotKnown => smt.gap(\n            mut vc,\n            f\"the call of `{name}` in a contract (whether it finishes needs a proof not ported)\",\n          ),\n          smt.ContractOnly => (),\n        }\n      }\n      r := smt.call_contract(mut vc, name, f, args)\n      smt.write_after(mut vc, f.params, arg_exprs)\n      // a function a contract sees through gives the same result on the\n      // same values, so what a contract says of its body holds of this call\n      if vc.spec == 0\n        && !f.params.any(p -> p.mutable)\n        && match get(vc.methods.seen, name) {\n          Some(smt.SeeThrough) => true,\n          _ => false,\n        } {\n        smt.same_call(\n          mut vc,\n          smt.call_key(vc, name, arg_exprs, args),\n          r,\n        )\n      }\n      r\n    },\n    // (a builtin's name called on a value of a program's type, `todo.\n    // insert(mut db)`: a trait's method, never the builtin)\n    None => if vc.builtins.any(b -> b.name == name)\n      && !(match smt.head_of(vc, get(args, 0) ?? smt.UnitVal) {\n          Some(h) => contains(vc.types, h),\n          None => false,\n        }\n        && smt.method_contract(vc, name) is Some) {\n      vc.call_pol = pol\n      smt.builtin(mut vc, name, arg_exprs, args)\n    } else {\n      match smt.method_call(mut vc, name, arg_exprs, args) {\n        Some(r) => r,\n        None => match keys(vc.fns).filter(k -> ends_with(k, \".\" + name)) {\n          // a module's function called as a method (`s.graphemes()` is\n          // `std.unicode.graphemes(s)`), as the resolver reads it\n          [q] => match get(vc.fns, q) {\n            // a capability's function called on one (`clock.seconds()`):\n            // the receiver isn't an argument\n            Some(f) => if len(f.params) + 1 == len(args) {\n              smt.call(mut vc, q, drop(arg_exprs, 1), drop(args, 1))\n            } else {\n              smt.call(mut vc, q, arg_exprs, args)\n            },\n            None => smt.call(mut vc, q, arg_exprs, args),\n          },\n          // a builtin stored under a module's name (`std.http.get`, where\n          // the module's type has a method `get`).\n          // `T.check(x)` on any type: whether `x` meets the type's\n          // refinements, an unconstrained `Result[(), String]`.\n          _ => if contains(name, \".\")\n            && vc.builtins.any(b -> b.name == smt.last_name(name)) {\n            smt.builtin(\n              mut vc,\n              smt.last_name(name),\n              arg_exprs,\n              args,\n            )\n          } else if name == \"check\" {\n            smt.shape(mut vc, ast.Named {\n              name: \"Result\",\n              args: [ast.UnitType, ast.Named { name: \"String\", args: [] }],\n            })\n          } else {\n            smt.gap(mut vc, f\"the method `{name}`\")\n            smt.Opaque(f\"the result of `{name}`\")\n          },\n        },\n      }\n    },\n  }\n}","old_text":"fn call(\n  mut vc: smt.Vc,\n  name: String,\n  arg_exprs: List[ast.Expr],\n  args: List[smt.Val],\n) -> smt.Val {\n  // the polarity of the call's result (`Vc.polarity`), for the body seen\n  // through or the builtin\n  pol := vc.call_pol\n  vc.call_pol = 0\n  // a `for`'s element (`for_loop`): at its position, which is in range\n  if name == \"$at\" {\n    return smt.for_element(mut vc, args)\n  }\n  // `len(s.code_points())` is the SMT string's length, `len(s.bytes())` its\n  // `byte_len`: both modelled on `s` itself\n  if name == \"len\" {\n    match get(arg_exprs, 0) {\n      Some(a) => match smt.string_unit(a) {\n        Some((unit, s)) => {\n          v := smt.eval(mut vc, s)\n          return if unit == \"code_points\" {\n            smt.VInt(\"(str.len \" + smt.as_str(mut vc, v) + \")\")\n          } else {\n            smt.builtin(mut vc, \"byte_len\", [s], [v])\n          }\n        },\n        None => (),\n      },\n      None => (),\n    }\n  }\n  // `len` of an iterator (a type implementing `FiniteIterator`) is its\n  // method\n  if name == \"len\" && len(args) == 1 {\n    match smt.implementation(vc, \"FiniteIterator::len\", args) {\n      Some(_) => match smt.method_call(\n        mut vc,\n        \"FiniteIterator::len\",\n        arg_exprs,\n        args,\n      ) {\n        Some(r) => return r,\n        None => (),\n      },\n      None => (),\n    }\n  }\n  match get(vc.fns, name) {\n    Some(f) => {\n      // a call of the function being checked in a function its code passes\n      // (`xs.all(x -> f(x))`), not in a contract nor a body seen through:\n      // by its contract, as a recursive call in the code is. Its body seen\n      // through there is seen through again at each element it is applied\n      // to, nested (`contracts.refn`'s queries were 15 MB)\n      own := (name == vc.self_name || name == vc.own_name)\n        && vc.contract == 0\n        && vc.see == 0\n        && vc.through == 0\n        && vc.unfolding == 0\n      if (vc.spec > 0 || vc.see > 0) && vc.depth < 4 && !own {\n        // in a contract or a loop's written invariant, a call is seen\n        // through to its body when it finishes and can't fail\n        if contains(vc.methods.unfold, name) {\n          match smt.def_call(mut vc, name, f, arg_exprs, args, true) {\n            Some(r) => return r,\n            None => (),\n          }\n          match smt.rec_call(mut vc, name, f, args) {\n            Some(r) => return r,\n            None => (),\n          }\n        }\n        match get(vc.methods.seen, name) ?? smt.ContractOnly {\n          smt.SeeThrough => {\n            if contains(vc.methods.assumed, name) {\n              mut vc.relied_on.insert(name)\n            }\n            match smt.def_call(mut vc, name, f, arg_exprs, args, false) {\n              Some(r) => return r,\n              None => (),\n            }\n            // the same call on the same values already made a list: reuse\n            // it instead of a second one said equal element by element\n            key := smt.call_key(vc, name, arg_exprs, args)\n            match key {\n              Some(k) => match get(vc.memo, k) {\n                Some(before) => match before {\n                  smt.VList { .. } => return before,\n                  _ => (),\n                },\n                None => (),\n              },\n              None => (),\n            }\n            binds := dict(zip(f.params.map(p -> p.name), args))\n            vc.depth += 1\n            vc.spec += 1\n            vc.through += 1\n            saved := vc.scopes\n            vc.scopes = [binds]\n            r := smt.eval_pol(mut vc, f.body, pol)\n            vc.scopes = saved\n            vc.through -= 1\n            vc.spec -= 1\n            vc.depth -= 1\n            // the same call in the code on the same values gave the same\n            // result: when its body is made both ways, `pol` 0\n            if pol == 0 {\n              smt.same_call(mut vc, key, r)\n            }\n            return r\n          },\n          smt.NotKnown => smt.gap(\n            mut vc,\n            f\"the call of `{name}` in a contract (whether it finishes needs a proof not ported)\",\n          ),\n          smt.ContractOnly => (),\n        }\n      }\n      r := smt.call_contract(mut vc, name, f, args)\n      smt.write_after(mut vc, f.params, arg_exprs)\n      // a function a contract sees through gives the same result on the\n      // same values, so what a contract says of its body holds of this call\n      if vc.spec == 0\n        && !f.params.any(p -> p.mutable)\n        && match get(vc.methods.seen, name) {\n          Some(smt.SeeThrough) => true,\n          _ => false,\n        } {\n        smt.same_call(\n          mut vc,\n          smt.call_key(vc, name, arg_exprs, args),\n          r,\n        )\n      }\n      r\n    },\n    // (a builtin's name called on a value of a program's type, `todo.\n    // insert(mut db)`: a trait's method, never the builtin)\n    None => if vc.builtins.any(b -> b.name == name)\n      && !(match smt.head_of(vc, get(args, 0) ?? smt.UnitVal) {\n          Some(h) => contains(vc.types, h),\n          None => false,\n        }\n        && smt.method_contract(vc, name) is Some) {\n      vc.call_pol = pol\n      smt.builtin(mut vc, name, arg_exprs, args)\n    } else {\n      match smt.method_call(mut vc, name, arg_exprs, args) {\n        Some(r) => r,\n        None => match keys(vc.fns).filter(k -> ends_with(k, \".\" + name)) {\n          // a module's function called as a method (`s.graphemes()` is\n          // `std.unicode.graphemes(s)`), as the resolver reads it\n          [q] => match get(vc.fns, q) {\n            // a capability's function called on one (`clock.seconds()`):\n            // the receiver isn't an argument\n            Some(f) => if len(f.params) + 1 == len(args) {\n              smt.call(mut vc, q, drop(arg_exprs, 1), drop(args, 1))\n            } else {\n              smt.call(mut vc, q, arg_exprs, args)\n            },\n            None => smt.call(mut vc, q, arg_exprs, args),\n          },\n          // a builtin stored under a module's name (`std.http.get`, where\n          // the module's type has a method `get`).\n          // `T.check(x)` on any type: whether `x` meets the type's\n          // refinements, an unconstrained `Result[(), String]`.\n          _ => if contains(name, \".\")\n            && vc.builtins.any(b -> b.name == smt.last_name(name)) {\n            smt.builtin(\n              mut vc,\n              smt.last_name(name),\n              arg_exprs,\n              args,\n            )\n          } else if name == \"check\" {\n            smt.shape(mut vc, ast.Named {\n              name: \"Result\",\n              args: [ast.UnitType, ast.Named { name: \"String\", args: [] }],\n            })\n          } else {\n            smt.gap(mut vc, f\"the method `{name}`\")\n            smt.Opaque(f\"the result of `{name}`\")\n          },\n        },\n      }\n    },\n  }\n}"}]}
{"id":"31b8924de1302657","time":1795702302,"message":"edit","changes":[{"name":"static_graph","kind":"fn","old":"1c2980db04abc316","new":"817a0ebe82fa8faf","interface_changed":false,"affected":[],"module":"","text":"/// The graph of `subject` in the program `stored` (the definitions `file`\n/// holds, or held). Each site's questions (compiler/graph's `plan`) are\n/// encoded by compiler/smt as `ensures` of a copy of the function and given\n/// to the solver. Each site's answers are cached under the program's text\n/// and the copy's (`graph-site`), so only what changed is asked again.\n/// Adds the moves the bodies' shape settles and those that follow calls\n/// (`resolved`). With `runs` (`stored` being what `file` holds), what the\n/// solver leaves unknown is run on generated inputs too (`graph_runs`,\n/// with std's library).\n/// \n/// A site's cache key is its copy and the definitions the copy reaches\n/// (`site_inputs`), not the whole program: in a diff, or after an edit,\n/// only the functions whose code or dependencies changed are asked again.\nfn static_graph(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  cache: cache.Cache,\n  file: String,\n  stored: List[ast.Decl],\n  subject: graph.Subject,\n  runs: Bool,\n) -> Result[graph.Graph, String] {\n  home := match home_found(disk, process) {\n    Some(h) => h,\n    None => return Err(\n      \"can't find Strata's home (a folder holding core/, std/ and runtime/prelude.strata): set STRATA_HOME\",\n    ),\n  }\n  if driver_chdir(home).to_int() != 0 {\n    return Err(f\"can't enter {home}\")\n  }\n  solver := toolchain.solver(disk, process)\n  pl := timings.timed(\"graph plan\", () -> graph.plan(stored, subject))\n  sites := pl.sites\n  timings.begin(\"graph keys\")\n  deps := store.graph(stored + sites.map(s -> s.decl), false)\n  mut texts := Dict[String, String] {}\n  mut impls := []\n  for d in stored {\n    n := store.qname(d)\n    mut texts.insert(n, text.decl_text(d))\n    if d.kind is ast.ImplDef {\n      mut impls.push(n)\n    }\n  }\n  keys := dict(sites.map(\n    s -> (s.name, \"verify-strata/graphs/\"\n      + cache.entry_key(\"graph-site\", [\n        solver,\n        site_inputs(deps, texts, impls, store.qname(s.decl)),\n        text.decl_text(s.decl),\n        s.label,\n        if !runs {\n          \"solver\"\n        } else {\n          \"solver, runs\"\n        },\n      ])),\n  ))\n  key := (s: graph.Site) -> get(keys, s.name) ?? s.name\n  timings.end(\"graph keys\")\n  reuse := cache.caching() && solver != \"\"\n  mut edges := []\n  mut skipped := []\n  mut todo := []\n  for s in sites {\n    match if reuse {\n      cache.read_entry(disk, cache, key(s))\n    } else {\n      None\n    } {\n      Some(text) => {\n        (es, why) := site_of_text(s.label, text)\n        edges += es\n        skipped += why\n      },\n      None => mut todo.push(s),\n    }\n  }\n  if todo != [] {\n    if solver == \"\" {\n      return Err(\"no solver (z3) found: the moves can't be asked\")\n    }\n    timings.begin(\"graph prepare\")\n    (own, fns, types, sigs, all_methods) := verified_decls(\n      disk,\n      \"std\",\n      [file],\n      stored + todo.map(s -> s.decl),\n    )\n    scratch := cache.smt\n    cache.make_dirs(mut disk, scratch)\n    names := set(todo.map(s -> s.name))\n    made := own.filter(\n      d -> match d.kind {\n        ast.FnDef(f) => contains(names, f.name),\n        _ => false,\n      },\n    )\n    ctx := termination.context(\n      fns,\n      types,\n      sigs,\n      all_methods,\n      scratch,\n      solver,\n    )\n    methods := termination.seen_through(ctx, termination.analyze(\n      mut launcher,\n      mut disk,\n      ctx,\n      Some(set(shown_names(ctx, made))),\n    ))\n    timings.end(\"graph prepare\")\n    mut answered := []\n    for s in todo {\n      found := made.filter(\n        d -> match d.kind {\n          ast.FnDef(f) => f.name == s.name,\n          _ => false,\n        },\n      )\n      (es, why) := match get(found, 0) {\n        Some(ast.Decl { kind: ast.FnDef(f), module, .. }) => {\n          label := if module == \"\" {\n            f.name\n          } else {\n            module + \".\" + f.name\n          }\n          timings.begin(\"graph encode\")\n          vc := smt.encode(\n            mut launcher,\n            mut disk,\n            scratch,\n            solver,\n            fns,\n            types,\n            sigs,\n            methods,\n            f,\n            label,\n          )\n          timings.end(\"graph encode\")\n          match get(vc.gaps, 0) {\n            Some(gap) => (\n              [],\n              [(s.label, \"not covered by compiler/smt yet: \" + gap)],\n            ),\n            None => if len(f.post) != len(s.queries) {\n              ([], [(\n                s.label,\n                \"its questions changed on the way to the solver\",\n              )])\n            } else {\n              timings.begin(\"graph answers\")\n              answers := graph_answers(\n                mut launcher,\n                mut disk,\n                scratch,\n                solver,\n                vc,\n              )\n              timings.end(\"graph answers\")\n              // a model is a move only when the encoding is exact: no loop (its turns\n              // stand for any), nothing the solver was left to choose (a gap, a function\n              // known by its contract). A trait's method is what its contract says (a\n              // model is a move of some implementation).\n              exact := !graph.loops_in(s)\n                && values(vc.reasons).all(\n                  r -> starts_with(r, \"values of the generic type\")\n                    || starts_with(r, \"the result of `\")\n                      && contains(r, \"::\")\n                      && ends_with(r, \"(only its contract is known)\"),\n                )\n              (graph.edges_of(\n                s,\n                f.post.map(graph.ensures_text),\n                if exact {\n                  answers\n                } else {\n                  answers.map(\n                    a -> if starts_with(a, \"refuted \") {\n                      \"unknown \" + drop_bytes(a, 8)\n                    } else {\n                      a\n                    },\n                  )\n                },\n              ), [])\n            },\n          }\n        },\n        _ => ([], [(s.label, \"it could not be prepared for the solver\")]),\n      }\n      mut answered.push((s, es, why))\n    }\n    // what the solver left unknown, run: a run that makes a move shows it\n    // possible\n    unknown := answered\n      .filter(a -> a.1.any(e -> e.verdict == \"unknown\"))\n      .map(a -> a.0)\n    ran := if runs && unknown != [] {\n      graph_runs(\n        disk,\n        cache,\n        std_loaded(\n          std_library(mut console, mut disk, process, cache),\n        ),\n        file,\n        unknown,\n      )\n    } else {\n      Dict[String, List[Bool]] {}\n    }\n    for (s, es0, why) in answered {\n      es := match get(ran, s.name) {\n        Some(flags) => graph.with_runs(es0, flags),\n        None => es0,\n      }\n      if reuse {\n        _ := cache.write_entry(\n          mut disk,\n          cache,\n          key(s),\n          site_text(es, why),\n        )\n      }\n      edges += es\n      skipped += why\n    }\n  }\n  moved := graph.resolved(subject, edges + pl.fixed, pl.vias)\n  Ok(graph.Graph { subject, edges: graph.merged(moved), skipped })\n}","old_text":"/// The graph of `subject` in the program `stored` (the definitions `file`\n/// holds, or held). Each site's questions (compiler/graph's `plan`) are\n/// encoded by compiler/smt as `ensures` of a copy of the function and given\n/// to the solver. Each site's answers are cached under the program's text\n/// and the copy's (`graph-site`), so only what changed is asked again.\n/// Adds the moves the bodies' shape settles and those that follow calls\n/// (`resolved`). With `runs` (`stored` being what `file` holds), what the\n/// solver leaves unknown is run on generated inputs too (`graph_runs`,\n/// with std's library).\nfn static_graph(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  cache: cache.Cache,\n  file: String,\n  stored: List[ast.Decl],\n  subject: graph.Subject,\n  runs: Bool,\n) -> Result[graph.Graph, String] {\n  home := match home_found(disk, process) {\n    Some(h) => h,\n    None => return Err(\n      \"can't find Strata's home (a folder holding core/, std/ and runtime/prelude.strata): set STRATA_HOME\",\n    ),\n  }\n  if driver_chdir(home).to_int() != 0 {\n    return Err(f\"can't enter {home}\")\n  }\n  solver := toolchain.solver(disk, process)\n  pl := graph.plan(stored, subject)\n  sites := pl.sites\n  program := join(stored.map(d -> d.module + \"\\n\" + text.decl_text(d)), \"\\n\")\n  key := (s: graph.Site) -> \"verify-strata/graphs/\"\n    + cache.entry_key(\n      \"graph-site\",\n      [solver, program, text.decl_text(s.decl), s.label, if !runs {\n        \"solver\"\n      } else {\n        \"solver, runs\"\n      }],\n    )\n  reuse := cache.caching() && solver != \"\"\n  mut edges := []\n  mut skipped := []\n  mut todo := []\n  for s in sites {\n    match if reuse {\n      cache.read_entry(disk, cache, key(s))\n    } else {\n      None\n    } {\n      Some(text) => {\n        (es, why) := site_of_text(s.label, text)\n        edges += es\n        skipped += why\n      },\n      None => mut todo.push(s),\n    }\n  }\n  if todo != [] {\n    if solver == \"\" {\n      return Err(\"no solver (z3) found: the moves can't be asked\")\n    }\n    (own, fns, types, sigs, all_methods) := verified_decls(\n      disk,\n      \"std\",\n      [file],\n      stored + todo.map(s -> s.decl),\n    )\n    scratch := cache.smt\n    cache.make_dirs(mut disk, scratch)\n    names := set(todo.map(s -> s.name))\n    made := own.filter(\n      d -> match d.kind {\n        ast.FnDef(f) => contains(names, f.name),\n        _ => false,\n      },\n    )\n    ctx := termination.context(\n      fns,\n      types,\n      sigs,\n      all_methods,\n      scratch,\n      solver,\n    )\n    methods := termination.seen_through(ctx, termination.analyze(\n      mut launcher,\n      mut disk,\n      ctx,\n      Some(set(shown_names(ctx, made))),\n    ))\n    mut answered := []\n    for s in todo {\n      found := made.filter(\n        d -> match d.kind {\n          ast.FnDef(f) => f.name == s.name,\n          _ => false,\n        },\n      )\n      (es, why) := match get(found, 0) {\n        Some(ast.Decl { kind: ast.FnDef(f), module, .. }) => {\n          label := if module == \"\" {\n            f.name\n          } else {\n            module + \".\" + f.name\n          }\n          vc := smt.encode(\n            mut launcher,\n            mut disk,\n            scratch,\n            solver,\n            fns,\n            types,\n            sigs,\n            methods,\n            f,\n            label,\n          )\n          match get(vc.gaps, 0) {\n            Some(gap) => (\n              [],\n              [(s.label, \"not covered by compiler/smt yet: \" + gap)],\n            ),\n            None => if len(f.post) != len(s.queries) {\n              ([], [(\n                s.label,\n                \"its questions changed on the way to the solver\",\n              )])\n            } else {\n              answers := graph_answers(\n                mut launcher,\n                mut disk,\n                scratch,\n                solver,\n                vc,\n              )\n              // a model is a move only when the encoding is exact: no loop (its turns\n              // stand for any), nothing the solver was left to choose (a gap, a function\n              // known by its contract). A trait's method is what its contract says (a\n              // model is a move of some implementation).\n              exact := !graph.loops_in(s)\n                && values(vc.reasons).all(\n                  r -> starts_with(r, \"values of the generic type\")\n                    || starts_with(r, \"the result of `\")\n                      && contains(r, \"::\")\n                      && ends_with(r, \"(only its contract is known)\"),\n                )\n              (graph.edges_of(\n                s,\n                f.post.map(graph.ensures_text),\n                if exact {\n                  answers\n                } else {\n                  answers.map(\n                    a -> if starts_with(a, \"refuted \") {\n                      \"unknown \" + drop_bytes(a, 8)\n                    } else {\n                      a\n                    },\n                  )\n                },\n              ), [])\n            },\n          }\n        },\n        _ => ([], [(s.label, \"it could not be prepared for the solver\")]),\n      }\n      mut answered.push((s, es, why))\n    }\n    // what the solver left unknown, run: a run that makes a move shows it\n    // possible\n    unknown := answered\n      .filter(a -> a.1.any(e -> e.verdict == \"unknown\"))\n      .map(a -> a.0)\n    ran := if runs && unknown != [] {\n      graph_runs(\n        disk,\n        cache,\n        std_loaded(\n          std_library(mut console, mut disk, process, cache),\n        ),\n        file,\n        unknown,\n      )\n    } else {\n      Dict[String, List[Bool]] {}\n    }\n    for (s, es0, why) in answered {\n      es := match get(ran, s.name) {\n        Some(flags) => graph.with_runs(es0, flags),\n        None => es0,\n      }\n      if reuse {\n        _ := cache.write_entry(\n          mut disk,\n          cache,\n          key(s),\n          site_text(es, why),\n        )\n      }\n      edges += es\n      skipped += why\n    }\n  }\n  moved := graph.resolved(subject, edges + pl.fixed, pl.vias)\n  Ok(graph.Graph { subject, edges: graph.merged(moved), skipped })\n}"},{"name":"site_inputs","kind":"fn","old":null,"new":"67ca258a2477779f","interface_changed":true,"affected":[],"module":"","text":"/// What a graph site's answers depend on besides its copy: the definitions\n/// the copy `root` reaches in `deps` (`store.graph`), directly or not, and\n/// the impls of what it reaches (a trait's method is asked through them),\n/// each by name with its text (`texts`). Sorted, so equal code gives equal\n/// text.\nfn site_inputs(\n  deps: Dict[String, List[String]],\n  texts: Dict[String, String],\n  impls: List[String],\n  root: String,\n) -> String {\n  mut seen := Set[String] {}\n  mut seen.insert(root)\n  for _ in range(0, len(deps) + 1) {\n    before := len(seen)\n    for n in to_list(seen) {\n      for d in get(deps, n) ?? [] {\n        mut seen.insert(d)\n      }\n    }\n    for i in impls {\n      if (get(deps, i) ?? []).any(d -> contains(seen, d)) {\n        mut seen.insert(i)\n      }\n    }\n    if len(seen) == before {\n      break\n    }\n  }\n  mut names := to_list(seen).filter(n -> n != root)\n  mut names.sort()\n  join(names.map(n -> n + \"\\n\" + (get(texts, n) ?? \"\")), \"\\n\")\n}"}]}
{"id":"d13e36eab07c659e","time":1795702367,"message":"edit","changes":[{"name":"graph_answers","kind":"fn","old":"3ab9ee7018a73651","new":"b63cf63417c79c39","interface_changed":false,"affected":[],"module":"","text":"/// The solver's answer to each obligation of `vc`, as `solve` gives them\n/// (`proven …`, `refuted …`, `unknown …`), except that a model is enough\n/// for `refuted`: a move is possible when some values make it, whether or\n/// not they can be shown (a type parameter's can't).\n/// \n/// A question the batch left unknown is asked again alone, with the same\n/// budget. In a batch, the solver's state from earlier questions can make\n/// one cost several times what it costs alone (`cancel`'s `Pending ->\n/// Cancelled` in examples/orders.strata).\nfn graph_answers(\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  scratch: String,\n  solver: String,\n  vc: smt.Vc,\n) -> List[String] {\n  n := len(vc.obligations)\n  mut outs := if n > 0 {\n    smt.run_script(\n      mut launcher,\n      mut disk,\n      scratch,\n      solver,\n      timings.timed(\"graph script\", () -> smt.batch(vc)),\n      [\"-t:20000\", \"rlimit=2000000\"],\n    )\n  } else {\n    []\n  }\n  while n > 0 && len(outs) < n {\n    one := smt.run_script(\n      mut launcher,\n      mut disk,\n      scratch,\n      solver,\n      timings.timed(\"graph script\", () -> smt.single(vc, len(outs))),\n      [\"-T:20\", \"rlimit=2000000\"],\n    )\n    mut outs.push(get(one, 0) ?? \"\")\n  }\n  mixes := timings.timed(\"graph mixes\", () -> smt.sort_mixes(vc))\n  mut out := []\n  for (i, ob) in enumerate(vc.obligations) {\n    mut first := trim(get(lines(get(outs, i) ?? \"\"), 0) ?? \"\")\n    if first != \"sat\" && first != \"unsat\" {\n      one := smt.run_script(\n        mut launcher,\n        mut disk,\n        scratch,\n        solver,\n        timings.timed(\"graph script\", () -> smt.single(vc, i)),\n        [\"-T:20\", \"rlimit=2000000\"],\n      )\n      first = trim(get(lines(get(one, 0) ?? \"\"), 0) ?? \"\")\n    }\n    word := if contains(mixes, i) {\n      \"unknown\"\n    } else {\n      match first {\n        \"unsat\" => \"proven\",\n        \"sat\" => \"refuted\",\n        _ => \"unknown\",\n      }\n    }\n    mut out.push(word + \" \" + ob.what)\n  }\n  out + vc.given.map(g -> \"proven \" + g)\n}","old_text":"/// The solver's answer to each obligation of `vc`, as `solve` gives them\n/// (`proven …`, `refuted …`, `unknown …`), except that a model is enough\n/// for `refuted`: a move is possible when some values make it, whether or\n/// not they can be shown (a type parameter's can't).\n/// \n/// A question the batch left unknown is asked again alone, with the same\n/// budget. In a batch, the solver's state from earlier questions can make\n/// one cost several times what it costs alone (`cancel`'s `Pending ->\n/// Cancelled` in examples/orders.strata).\nfn graph_answers(\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  scratch: String,\n  solver: String,\n  vc: smt.Vc,\n) -> List[String] {\n  n := len(vc.obligations)\n  mut outs := if n > 0 {\n    smt.run_script(\n      mut launcher,\n      mut disk,\n      scratch,\n      solver,\n      smt.batch(vc),\n      [\"-t:20000\", \"rlimit=2000000\"],\n    )\n  } else {\n    []\n  }\n  while n > 0 && len(outs) < n {\n    one := smt.run_script(\n      mut launcher,\n      mut disk,\n      scratch,\n      solver,\n      smt.single(vc, len(outs)),\n      [\"-T:20\", \"rlimit=2000000\"],\n    )\n    mut outs.push(get(one, 0) ?? \"\")\n  }\n  mixes := smt.sort_mixes(vc)\n  mut out := []\n  for (i, ob) in enumerate(vc.obligations) {\n    mut first := trim(get(lines(get(outs, i) ?? \"\"), 0) ?? \"\")\n    if first != \"sat\" && first != \"unsat\" {\n      one := smt.run_script(\n        mut launcher,\n        mut disk,\n        scratch,\n        solver,\n        smt.single(vc, i),\n        [\"-T:20\", \"rlimit=2000000\"],\n      )\n      first = trim(get(lines(get(one, 0) ?? \"\"), 0) ?? \"\")\n    }\n    word := if contains(mixes, i) {\n      \"unknown\"\n    } else {\n      match first {\n        \"unsat\" => \"proven\",\n        \"sat\" => \"refuted\",\n        _ => \"unknown\",\n      }\n    }\n    mut out.push(word + \" \" + ob.what)\n  }\n  out + vc.given.map(g -> \"proven \" + g)\n}"}]}
{"id":"6c430c2bee82bbc4","time":1795702794,"message":"edit","changes":[{"name":"static_graph","kind":"fn","old":"817a0ebe82fa8faf","new":"7f4123fdbd072958","interface_changed":false,"affected":[],"module":"","text":"/// The graph of `subject` in the program `stored` (the definitions `file`\n/// holds, or held). Each site's questions (compiler/graph's `plan`) are\n/// encoded by compiler/smt as `ensures` of a copy of the function and given\n/// to the solver. Each site's answers are cached under the program's text\n/// and the copy's (`graph-site`), so only what changed is asked again.\n/// Adds the moves the bodies' shape settles and those that follow calls\n/// (`resolved`). With `runs` (`stored` being what `file` holds), what the\n/// solver leaves unknown is run on generated inputs too (`graph_runs`,\n/// with std's library).\n/// \n/// A site's cache key is its copy and the definitions the copy reaches\n/// (`site_inputs`), not the whole program: in a diff, or after an edit,\n/// only the functions whose code or dependencies changed are asked again.\n/// The solver's answers are kept apart from what runs added to them, so\n/// `view --graph` (with runs) and `diff --graph` (without) share them.\nfn static_graph(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  cache: cache.Cache,\n  file: String,\n  stored: List[ast.Decl],\n  subject: graph.Subject,\n  runs: Bool,\n) -> Result[graph.Graph, String] {\n  home := match home_found(disk, process) {\n    Some(h) => h,\n    None => return Err(\n      \"can't find Strata's home (a folder holding core/, std/ and runtime/prelude.strata): set STRATA_HOME\",\n    ),\n  }\n  if driver_chdir(home).to_int() != 0 {\n    return Err(f\"can't enter {home}\")\n  }\n  solver := toolchain.solver(disk, process)\n  pl := timings.timed(\"graph plan\", () -> graph.plan(stored, subject))\n  sites := pl.sites\n  timings.begin(\"graph keys\")\n  deps := store.graph(stored + sites.map(s -> s.decl), false)\n  mut texts := Dict[String, String] {}\n  mut impls := []\n  for d in stored {\n    n := store.qname(d)\n    mut texts.insert(n, text.decl_text(d))\n    if d.kind is ast.ImplDef {\n      mut impls.push(n)\n    }\n  }\n  keys := dict(sites.map(\n    s -> (s.name, \"verify-strata/graphs/\"\n      + cache.entry_key(\"graph-site\", [\n        solver,\n        site_inputs(deps, texts, impls, store.qname(s.decl)),\n        text.decl_text(s.decl),\n        s.label,\n      ])),\n  ))\n  key := (s: graph.Site) -> get(keys, s.name) ?? s.name\n  // the answers with what runs showed\n  run_key := (s: graph.Site) -> key(s) + \"-runs\"\n  timings.end(\"graph keys\")\n  reuse := cache.caching() && solver != \"\"\n  mut edges := []\n  mut skipped := []\n  // the solver's answers, from the cache or asked now, before any run\n  mut answered := []\n  mut todo := []\n  for s in sites {\n    match if reuse && runs {\n      cache.read_entry(disk, cache, run_key(s))\n    } else {\n      None\n    } {\n      Some(text) => {\n        (es, why) := site_of_text(s.label, text)\n        edges += es\n        skipped += why\n      },\n      None => match if reuse {\n        cache.read_entry(disk, cache, key(s))\n      } else {\n        None\n      } {\n        Some(text) => {\n          (es, why) := site_of_text(s.label, text)\n          mut answered.push((s, es, why))\n        },\n        None => mut todo.push(s),\n      },\n    }\n  }\n  if todo != [] {\n    if solver == \"\" {\n      return Err(\"no solver (z3) found: the moves can't be asked\")\n    }\n    timings.begin(\"graph prepare\")\n    (own, fns, types, sigs, all_methods) := verified_decls(\n      disk,\n      \"std\",\n      [file],\n      stored + todo.map(s -> s.decl),\n    )\n    scratch := cache.smt\n    cache.make_dirs(mut disk, scratch)\n    names := set(todo.map(s -> s.name))\n    made := own.filter(\n      d -> match d.kind {\n        ast.FnDef(f) => contains(names, f.name),\n        _ => false,\n      },\n    )\n    ctx := termination.context(\n      fns,\n      types,\n      sigs,\n      all_methods,\n      scratch,\n      solver,\n    )\n    methods := termination.seen_through(ctx, termination.analyze(\n      mut launcher,\n      mut disk,\n      ctx,\n      Some(set(shown_names(ctx, made))),\n    ))\n    timings.end(\"graph prepare\")\n    for s in todo {\n      found := made.filter(\n        d -> match d.kind {\n          ast.FnDef(f) => f.name == s.name,\n          _ => false,\n        },\n      )\n      (es, why) := match get(found, 0) {\n        Some(ast.Decl { kind: ast.FnDef(f), module, .. }) => {\n          label := if module == \"\" {\n            f.name\n          } else {\n            module + \".\" + f.name\n          }\n          timings.begin(\"graph encode\")\n          vc := smt.encode(\n            mut launcher,\n            mut disk,\n            scratch,\n            solver,\n            fns,\n            types,\n            sigs,\n            methods,\n            f,\n            label,\n          )\n          timings.end(\"graph encode\")\n          match get(vc.gaps, 0) {\n            Some(gap) => (\n              [],\n              [(s.label, \"not covered by compiler/smt yet: \" + gap)],\n            ),\n            None => if len(f.post) != len(s.queries) {\n              ([], [(\n                s.label,\n                \"its questions changed on the way to the solver\",\n              )])\n            } else {\n              timings.begin(\"graph answers\")\n              answers := graph_answers(\n                mut launcher,\n                mut disk,\n                scratch,\n                solver,\n                vc,\n              )\n              timings.end(\"graph answers\")\n              // a model is a move only when the encoding is exact: no loop (its turns\n              // stand for any), nothing the solver was left to choose (a gap, a function\n              // known by its contract). A trait's method is what its contract says (a\n              // model is a move of some implementation).\n              exact := !graph.loops_in(s)\n                && values(vc.reasons).all(\n                  r -> starts_with(r, \"values of the generic type\")\n                    || starts_with(r, \"the result of `\")\n                      && contains(r, \"::\")\n                      && ends_with(r, \"(only its contract is known)\"),\n                )\n              (graph.edges_of(\n                s,\n                f.post.map(graph.ensures_text),\n                if exact {\n                  answers\n                } else {\n                  answers.map(\n                    a -> if starts_with(a, \"refuted \") {\n                      \"unknown \" + drop_bytes(a, 8)\n                    } else {\n                      a\n                    },\n                  )\n                },\n              ), [])\n            },\n          }\n        },\n        _ => ([], [(s.label, \"it could not be prepared for the solver\")]),\n      }\n      // kept at once: a run stopped later keeps what was asked\n      if reuse {\n        _ := cache.write_entry(\n          mut disk,\n          cache,\n          key(s),\n          site_text(es, why),\n        )\n      }\n      mut answered.push((s, es, why))\n    }\n  }\n  // what the solver left unknown, run: a run that makes a move shows it\n  // possible\n  unknown := answered\n    .filter(a -> a.1.any(e -> e.verdict == \"unknown\"))\n    .map(a -> a.0)\n  ran := if runs && unknown != [] {\n    graph_runs(\n      disk,\n      cache,\n      std_loaded(std_library(mut console, mut disk, process, cache)),\n      file,\n      unknown,\n    )\n  } else {\n    Dict[String, List[Bool]] {}\n  }\n  for (s, es0, why) in answered {\n    es := match get(ran, s.name) {\n      Some(flags) => graph.with_runs(es0, flags),\n      None => es0,\n    }\n    if reuse && runs {\n      _ := cache.write_entry(\n        mut disk,\n        cache,\n        run_key(s),\n        site_text(es, why),\n      )\n    }\n    edges += es\n    skipped += why\n  }\n  moved := graph.resolved(subject, edges + pl.fixed, pl.vias)\n  Ok(graph.Graph { subject, edges: graph.merged(moved), skipped })\n}","old_text":"/// The graph of `subject` in the program `stored` (the definitions `file`\n/// holds, or held). Each site's questions (compiler/graph's `plan`) are\n/// encoded by compiler/smt as `ensures` of a copy of the function and given\n/// to the solver. Each site's answers are cached under the program's text\n/// and the copy's (`graph-site`), so only what changed is asked again.\n/// Adds the moves the bodies' shape settles and those that follow calls\n/// (`resolved`). With `runs` (`stored` being what `file` holds), what the\n/// solver leaves unknown is run on generated inputs too (`graph_runs`,\n/// with std's library).\n/// \n/// A site's cache key is its copy and the definitions the copy reaches\n/// (`site_inputs`), not the whole program: in a diff, or after an edit,\n/// only the functions whose code or dependencies changed are asked again.\nfn static_graph(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  cache: cache.Cache,\n  file: String,\n  stored: List[ast.Decl],\n  subject: graph.Subject,\n  runs: Bool,\n) -> Result[graph.Graph, String] {\n  home := match home_found(disk, process) {\n    Some(h) => h,\n    None => return Err(\n      \"can't find Strata's home (a folder holding core/, std/ and runtime/prelude.strata): set STRATA_HOME\",\n    ),\n  }\n  if driver_chdir(home).to_int() != 0 {\n    return Err(f\"can't enter {home}\")\n  }\n  solver := toolchain.solver(disk, process)\n  pl := timings.timed(\"graph plan\", () -> graph.plan(stored, subject))\n  sites := pl.sites\n  timings.begin(\"graph keys\")\n  deps := store.graph(stored + sites.map(s -> s.decl), false)\n  mut texts := Dict[String, String] {}\n  mut impls := []\n  for d in stored {\n    n := store.qname(d)\n    mut texts.insert(n, text.decl_text(d))\n    if d.kind is ast.ImplDef {\n      mut impls.push(n)\n    }\n  }\n  keys := dict(sites.map(\n    s -> (s.name, \"verify-strata/graphs/\"\n      + cache.entry_key(\"graph-site\", [\n        solver,\n        site_inputs(deps, texts, impls, store.qname(s.decl)),\n        text.decl_text(s.decl),\n        s.label,\n        if !runs {\n          \"solver\"\n        } else {\n          \"solver, runs\"\n        },\n      ])),\n  ))\n  key := (s: graph.Site) -> get(keys, s.name) ?? s.name\n  timings.end(\"graph keys\")\n  reuse := cache.caching() && solver != \"\"\n  mut edges := []\n  mut skipped := []\n  mut todo := []\n  for s in sites {\n    match if reuse {\n      cache.read_entry(disk, cache, key(s))\n    } else {\n      None\n    } {\n      Some(text) => {\n        (es, why) := site_of_text(s.label, text)\n        edges += es\n        skipped += why\n      },\n      None => mut todo.push(s),\n    }\n  }\n  if todo != [] {\n    if solver == \"\" {\n      return Err(\"no solver (z3) found: the moves can't be asked\")\n    }\n    timings.begin(\"graph prepare\")\n    (own, fns, types, sigs, all_methods) := verified_decls(\n      disk,\n      \"std\",\n      [file],\n      stored + todo.map(s -> s.decl),\n    )\n    scratch := cache.smt\n    cache.make_dirs(mut disk, scratch)\n    names := set(todo.map(s -> s.name))\n    made := own.filter(\n      d -> match d.kind {\n        ast.FnDef(f) => contains(names, f.name),\n        _ => false,\n      },\n    )\n    ctx := termination.context(\n      fns,\n      types,\n      sigs,\n      all_methods,\n      scratch,\n      solver,\n    )\n    methods := termination.seen_through(ctx, termination.analyze(\n      mut launcher,\n      mut disk,\n      ctx,\n      Some(set(shown_names(ctx, made))),\n    ))\n    timings.end(\"graph prepare\")\n    mut answered := []\n    for s in todo {\n      found := made.filter(\n        d -> match d.kind {\n          ast.FnDef(f) => f.name == s.name,\n          _ => false,\n        },\n      )\n      (es, why) := match get(found, 0) {\n        Some(ast.Decl { kind: ast.FnDef(f), module, .. }) => {\n          label := if module == \"\" {\n            f.name\n          } else {\n            module + \".\" + f.name\n          }\n          timings.begin(\"graph encode\")\n          vc := smt.encode(\n            mut launcher,\n            mut disk,\n            scratch,\n            solver,\n            fns,\n            types,\n            sigs,\n            methods,\n            f,\n            label,\n          )\n          timings.end(\"graph encode\")\n          match get(vc.gaps, 0) {\n            Some(gap) => (\n              [],\n              [(s.label, \"not covered by compiler/smt yet: \" + gap)],\n            ),\n            None => if len(f.post) != len(s.queries) {\n              ([], [(\n                s.label,\n                \"its questions changed on the way to the solver\",\n              )])\n            } else {\n              timings.begin(\"graph answers\")\n              answers := graph_answers(\n                mut launcher,\n                mut disk,\n                scratch,\n                solver,\n                vc,\n              )\n              timings.end(\"graph answers\")\n              // a model is a move only when the encoding is exact: no loop (its turns\n              // stand for any), nothing the solver was left to choose (a gap, a function\n              // known by its contract). A trait's method is what its contract says (a\n              // model is a move of some implementation).\n              exact := !graph.loops_in(s)\n                && values(vc.reasons).all(\n                  r -> starts_with(r, \"values of the generic type\")\n                    || starts_with(r, \"the result of `\")\n                      && contains(r, \"::\")\n                      && ends_with(r, \"(only its contract is known)\"),\n                )\n              (graph.edges_of(\n                s,\n                f.post.map(graph.ensures_text),\n                if exact {\n                  answers\n                } else {\n                  answers.map(\n                    a -> if starts_with(a, \"refuted \") {\n                      \"unknown \" + drop_bytes(a, 8)\n                    } else {\n                      a\n                    },\n                  )\n                },\n              ), [])\n            },\n          }\n        },\n        _ => ([], [(s.label, \"it could not be prepared for the solver\")]),\n      }\n      mut answered.push((s, es, why))\n    }\n    // what the solver left unknown, run: a run that makes a move shows it\n    // possible\n    unknown := answered\n      .filter(a -> a.1.any(e -> e.verdict == \"unknown\"))\n      .map(a -> a.0)\n    ran := if runs && unknown != [] {\n      graph_runs(\n        disk,\n        cache,\n        std_loaded(\n          std_library(mut console, mut disk, process, cache),\n        ),\n        file,\n        unknown,\n      )\n    } else {\n      Dict[String, List[Bool]] {}\n    }\n    for (s, es0, why) in answered {\n      es := match get(ran, s.name) {\n        Some(flags) => graph.with_runs(es0, flags),\n        None => es0,\n      }\n      if reuse {\n        _ := cache.write_entry(\n          mut disk,\n          cache,\n          key(s),\n          site_text(es, why),\n        )\n      }\n      edges += es\n      skipped += why\n    }\n  }\n  moved := graph.resolved(subject, edges + pl.fixed, pl.vias)\n  Ok(graph.Graph { subject, edges: graph.merged(moved), skipped })\n}"}]}
{"id":"5dfbff046cc56789","time":1795703389,"message":"edit","changes":[{"name":"use smt","kind":"use","old":"57493817b94d618b","new":"d93fd37008e3641b","interface_changed":true,"affected":[],"module":"","text":"from smt use tables, solve, builtins_of, encode, methods_of, elaborated,\n  BuiltinSig, Methods, obligation_answers, single, encode_all, encode_solving,\n  answers_all, Vc, Answer, inputs, query_text, SeeThrough, ContractOnly,\n  LoopFound, while_loops, set_search_budget, search_spent, batch, run_script,\n  sort_mixes, run_scripts","old_text":"from smt use tables, solve, builtins_of, encode, methods_of, elaborated,\n  BuiltinSig, Methods, obligation_answers, single, encode_all, encode_solving,\n  answers_all, Vc, Answer, inputs, query_text, SeeThrough, ContractOnly,\n  LoopFound, while_loops, set_search_budget, search_spent, batch, run_script,\n  sort_mixes"},{"name":"static_graph","kind":"fn","old":"7f4123fdbd072958","new":"83d9f72f76f1f52a","interface_changed":false,"affected":[],"module":"","text":"/// The graph of `subject` in the program `stored` (the definitions `file`\n/// holds, or held). Each site's questions (compiler/graph's `plan`) are\n/// encoded by compiler/smt as `ensures` of a copy of the function and given\n/// to the solver. Each site's answers are cached under the program's text\n/// and the copy's (`graph-site`), so only what changed is asked again.\n/// Adds the moves the bodies' shape settles and those that follow calls\n/// (`resolved`). With `runs` (`stored` being what `file` holds), what the\n/// solver leaves unknown is run on generated inputs too (`graph_runs`,\n/// with std's library).\n/// \n/// A site's cache key is its copy and the definitions the copy reaches\n/// (`site_inputs`), not the whole program: in a diff, or after an edit,\n/// only the functions whose code or dependencies changed are asked again.\n/// The solver's answers are kept apart from what runs added to them, so\n/// `view --graph` (with runs) and `diff --graph` (without) share them.\nfn static_graph(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  cache: cache.Cache,\n  file: String,\n  stored: List[ast.Decl],\n  subject: graph.Subject,\n  runs: Bool,\n) -> Result[graph.Graph, String] {\n  home := match home_found(disk, process) {\n    Some(h) => h,\n    None => return Err(\n      \"can't find Strata's home (a folder holding core/, std/ and runtime/prelude.strata): set STRATA_HOME\",\n    ),\n  }\n  if driver_chdir(home).to_int() != 0 {\n    return Err(f\"can't enter {home}\")\n  }\n  solver := toolchain.solver(disk, process)\n  pl := timings.timed(\"graph plan\", () -> graph.plan(stored, subject))\n  sites := pl.sites\n  timings.begin(\"graph keys\")\n  deps := store.graph(stored + sites.map(s -> s.decl), false)\n  mut texts := Dict[String, String] {}\n  mut impls := []\n  for d in stored {\n    n := store.qname(d)\n    mut texts.insert(n, text.decl_text(d))\n    if d.kind is ast.ImplDef {\n      mut impls.push(n)\n    }\n  }\n  keys := dict(sites.map(\n    s -> (s.name, \"verify-strata/graphs/\"\n      + cache.entry_key(\"graph-site\", [\n        solver,\n        site_inputs(deps, texts, impls, store.qname(s.decl)),\n        text.decl_text(s.decl),\n        s.label,\n      ])),\n  ))\n  key := (s: graph.Site) -> get(keys, s.name) ?? s.name\n  // the answers with what runs showed\n  run_key := (s: graph.Site) -> key(s) + \"-runs\"\n  timings.end(\"graph keys\")\n  reuse := cache.caching() && solver != \"\"\n  mut edges := []\n  mut skipped := []\n  // the solver's answers, from the cache or asked now, before any run\n  mut answered := []\n  mut todo := []\n  for s in sites {\n    match if reuse && runs {\n      cache.read_entry(disk, cache, run_key(s))\n    } else {\n      None\n    } {\n      Some(text) => {\n        (es, why) := site_of_text(s.label, text)\n        edges += es\n        skipped += why\n      },\n      None => match if reuse {\n        cache.read_entry(disk, cache, key(s))\n      } else {\n        None\n      } {\n        Some(text) => {\n          (es, why) := site_of_text(s.label, text)\n          mut answered.push((s, es, why))\n        },\n        None => mut todo.push(s),\n      },\n    }\n  }\n  if todo != [] {\n    if solver == \"\" {\n      return Err(\"no solver (z3) found: the moves can't be asked\")\n    }\n    timings.begin(\"graph prepare\")\n    (own, fns, types, sigs, all_methods) := verified_decls(\n      disk,\n      \"std\",\n      [file],\n      stored + todo.map(s -> s.decl),\n    )\n    scratch := cache.smt\n    cache.make_dirs(mut disk, scratch)\n    names := set(todo.map(s -> s.name))\n    made := own.filter(\n      d -> match d.kind {\n        ast.FnDef(f) => contains(names, f.name),\n        _ => false,\n      },\n    )\n    ctx := termination.context(\n      fns,\n      types,\n      sigs,\n      all_methods,\n      scratch,\n      solver,\n    )\n    methods := termination.seen_through(ctx, termination.analyze(\n      mut launcher,\n      mut disk,\n      ctx,\n      Some(set(shown_names(ctx, made))),\n    ))\n    timings.end(\"graph prepare\")\n    // each site's copy, with its label, or why it can't be asked\n    mut fs := []\n    mut ready := []\n    for s in todo {\n      found := made.filter(\n        d -> match d.kind {\n          ast.FnDef(f) => f.name == s.name,\n          _ => false,\n        },\n      )\n      match get(found, 0) {\n        Some(ast.Decl { kind: ast.FnDef(f), module, .. }) => {\n          label := if module == \"\" {\n            f.name\n          } else {\n            module + \".\" + f.name\n          }\n          mut fs.push((f, label))\n          mut ready.push(s)\n        },\n        _ => {\n          why := [(s.label, \"it could not be prepared for the solver\")]\n          if reuse {\n            _ := cache.write_entry(\n              mut disk,\n              cache,\n              key(s),\n              site_text([], why),\n            )\n          }\n          mut answered.push((s, [], why))\n        },\n      }\n    }\n    // encoded on worker threads, and every site's questions asked together\n    timings.begin(\"graph encode\")\n    vcs := smt.encode_all(\n      mut launcher,\n      mut disk,\n      scratch,\n      solver,\n      fns,\n      types,\n      sigs,\n      methods,\n      fs,\n    )\n    timings.end(\"graph encode\")\n    mut asked := []\n    for (k, s) in enumerate(ready) {\n      match (get(vcs, k), get(fs, k)) {\n        (Some(vc), Some((f, _))) => if vc.gaps == [] && len(f.post) == len(s.queries) {\n          mut asked.push((s, f, vc))\n        },\n        _ => (),\n      }\n    }\n    timings.begin(\"graph answers\")\n    replies := graph_answers_all(\n      mut launcher,\n      mut disk,\n      scratch,\n      solver,\n      asked.map(a -> a.2),\n    )\n    timings.end(\"graph answers\")\n    for (k, s) in enumerate(ready) {\n      (es, why) := match (get(vcs, k), get(fs, k)) {\n        (Some(vc), Some((f, _))) => match get(vc.gaps, 0) {\n          Some(gap) => (\n            [],\n            [(s.label, \"not covered by compiler/smt yet: \" + gap)],\n          ),\n          None => if len(f.post) != len(s.queries) {\n            ([], [(\n              s.label,\n              \"its questions changed on the way to the solver\",\n            )])\n          } else {\n            at := index_of_site(asked.map(a -> a.0.name), s.name)\n            answers := get(replies, at) ?? []\n            // a model is a move only when the encoding is exact: no loop (its turns\n            // stand for any), nothing the solver was left to choose (a gap, a function\n            // known by its contract). A trait's method is what its contract says (a\n            // model is a move of some implementation).\n            exact := !graph.loops_in(s)\n              && values(vc.reasons).all(\n                r -> starts_with(r, \"values of the generic type\")\n                  || starts_with(r, \"the result of `\")\n                    && contains(r, \"::\")\n                    && ends_with(r, \"(only its contract is known)\"),\n              )\n            (graph.edges_of(\n              s,\n              f.post.map(graph.ensures_text),\n              if exact {\n                answers\n              } else {\n                answers.map(\n                  a -> if starts_with(a, \"refuted \") {\n                    \"unknown \" + drop_bytes(a, 8)\n                  } else {\n                    a\n                  },\n                )\n              },\n            ), [])\n          },\n        },\n        _ => ([], [(s.label, \"it could not be prepared for the solver\")]),\n      }\n      // kept at once: a run stopped later keeps what was asked\n      if reuse {\n        _ := cache.write_entry(\n          mut disk,\n          cache,\n          key(s),\n          site_text(es, why),\n        )\n      }\n      mut answered.push((s, es, why))\n    }\n  }\n  // what the solver left unknown, run: a run that makes a move shows it\n  // possible\n  unknown := answered\n    .filter(a -> a.1.any(e -> e.verdict == \"unknown\"))\n    .map(a -> a.0)\n  ran := if runs && unknown != [] {\n    graph_runs(\n      disk,\n      cache,\n      std_loaded(std_library(mut console, mut disk, process, cache)),\n      file,\n      unknown,\n    )\n  } else {\n    Dict[String, List[Bool]] {}\n  }\n  for (s, es0, why) in answered {\n    es := match get(ran, s.name) {\n      Some(flags) => graph.with_runs(es0, flags),\n      None => es0,\n    }\n    if reuse && runs {\n      _ := cache.write_entry(\n        mut disk,\n        cache,\n        run_key(s),\n        site_text(es, why),\n      )\n    }\n    edges += es\n    skipped += why\n  }\n  moved := graph.resolved(subject, edges + pl.fixed, pl.vias)\n  Ok(graph.Graph { subject, edges: graph.merged(moved), skipped })\n}","old_text":"/// The graph of `subject` in the program `stored` (the definitions `file`\n/// h