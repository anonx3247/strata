&& x.self_ty != ast.UnitType {\n    return Some(x.self_ty)\n  }\n  match e {\n    ast.Var(n) => if derive.is_hidden(x, n) {\n      None\n    } else {\n      get(x.types, n)\n    },\n    ast.CtorExpr { name: n, args: ast.NoArgs } => if derive.is_hidden(x, n) {\n      None\n    } else {\n      get(x.types, n)\n    },\n    ast.FieldOf { base: ast.Var(n), name: \"type\" } => if derive.is_known(x, n) {\n      get(x.types, n + \".type\")\n    } else {\n      None\n    },\n    _ => None,\n  }\n}","old_text":"/// The type an expression names at compile time: `Self`, a type bound by\n/// `match comptime` or a `comptime t: Type`, or a field's type (`f.type`).\nfn type_named(x: derive.X, e: ast.Expr) -> Option[ast.TypeExpr] {\n  if derive.is_self(e) && x.self_ty != ast.UnitType {\n    return Some(x.self_ty)\n  }\n  match e {\n    ast.Var(n) => if derive.is_hidden(x, n) {\n      None\n    } else {\n      get(x.types, n)\n    },\n    ast.CtorExpr { name: n, args: ast.NoArgs } => if derive.is_hidden(x, n) {\n      None\n    } else {\n      get(x.types, n)\n    },\n    ast.FieldOf { base: ast.Var(n), name: \"type\" } => if derive.is_known(x, n) {\n      get(x.types, n + \".type\")\n    } else {\n      None\n    },\n    _ => None,\n  }\n}"},{"name":"derive.base","kind":"fn","old":"f1c4b0583d03bdc1","new":"741e9dc32438f28d","interface_changed":true,"affected":["derive.type_method","derive.arm_pattern","derive.fits","derive.expr","derive.comprehension","derive.match_type","derive.derive","derive.children","derive.field_read","derive.with_known","derive.block","derive.call_copy","derive.derive_fn","derive.derive_all","derive.make","derive.call_fn","derive.derived_in","derive.expand_with","derive.expand_in","std_reached","expanded","check_errors_in","derive.expand","holes_command","check_summary","verified_decls","verify_file","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","eval_files","instantiated_files","with_extra","command_line","check_command","verified_