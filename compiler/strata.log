se {\n    t\n  }\n}","old_text":"/// The representation of a set or dictionary: a hash table (runtime.c's\n/// `strata_tbl_…`) as the tuple of its entries (set elements, dict pairs)\n/// and their index. Any other type is itself.\nfn repr(t: Ty) -> Ty {\n  if codegen.is_collection(t) {\n    TNamed {\n      name: \"Tuple\",\n      args: [TList(codegen.entry_ty(t)), TList(TInt)],\n    }\n  } else {\n    t\n  }\n}"},{"name":"codegen.collection_builtin","kind":"fn","old":"a1f9e45a6c500275","new":"09fc03718b1206ec","interface_changed":false,"affected":[],"module":"codegen","text":"/// Set and dictionary built-ins (`contains`, `get`, `insert`, …, and `set`\n/// and `dict` from a list) on runtime.c's tables.\nfn collection_builtin(\n  mut g: codegen.Gen,\n  name: String,\n  vs: List[codegen.V],\n) -> codegen.V {\n  first := get(vs, 0) ?? codegen.unit()\n  rest := drop(vs, 1)\n  match first.ty {\n    check.TList(et) => {\n      // from a list. An empty one's type comes from its destination: an\n      // empty table, typed later.\n      if et is check.TAny {\n        (kind, args) := if name == \"set\" {\n          (\"Set\", [check.TAny])\n        } else {\n          (\"Dict\", [check.TAny, check.TAny])\n        }\n        if codegen.is_temp(g, first.op) {\n          // the empty list has no elements to drop\n          x := codegen.take_value(mut g, first)\n          codegen.drop_value(\n            mut g,\n            codegen.V { ..x, ty: check.TList(check.TBool) },\n          )\n        }\n        return codegen.call(\n          mut g,\n          check.TNamed { name: kind, args },\n          \"strata_tbl_empty\",\n          [],\n        )\n      }\n      if name == \"set\" {\n        return codegen.table_from(\n          mut g,\n          first,\n          check.TNamed { name: \"Set\", args: [et] },\n        )\n      }\n      match et {\n        check.TNamed { name: \"Tuple\", args: [kt, vt] } => return codegen.table_from(\n          mut g,\n          first,\n          check.TNamed { name: \"Dict\", args: [kt, vt] },\n        ),\n        _ => {\n          codegen.not_yet(\n            mut g,\n            \"`dict` of a `\" + codegen.key(first.ty) + \"`\",\n          )\n          return codegen.never()\n        },\n      }\n    },\n    _ => (),\n  }\n  (kind, targs) := match first.ty {\n    check.TNamed { name: n, args } => (n, args),\n    _ => (\"\", []),\n  }\n  k0 := get(targs, 0) ?? check.TAny\n  et := codegen.entry_ty(first.ty)\n  fs := if [\n    \"len\",\n    \"to_list\",\n    \"items\",\n    \"keys\",\n    \"values\",\n    \"map_values\",\n    \"excluding\",\n    \"key_set\",\n  ].any(\n    x -> x == name,\n  ) {\n    []\n  } else {\n    codegen.table_fns(mut g, first.ty)\n  }\n  (h, c, dict) := (\n    get(fs, 0) ?? codegen.unit(),\n    get(fs, 1) ?? codegen.unit(),\n    get(fs, 2) ?? codegen.unit(),\n  )\n  kind_of := codegen.elements_kind(et)\n  same := r -> codegen.V { ..r, ty: first.ty }\n  match (kind, name, len(rest)) {\n    (_, \"len\", 0) => codegen.list_len(mut g, codegen.list_view(mut g, first)),\n    (\"Set\", \"to_list\", 0) | (\"Dict\", \"items\", 0) => codegen.hold(mut g, codegen.list_view(mut g, first)),\n    (\"Set\", \"contains\", 1) | (\"Dict\", \"contains\", 1) => {\n      at := codegen.table_find(\n        mut g,\n        first,\n        get(rest, 0) ?? codegen.unit(),\n        k0,\n        fs,\n      )\n      r := codegen.fresh(mut g, \"found\")\n      codegen.emit(mut g, f\"{r} = icmp sge i64 {at.op}, 0\")\n      codegen.V { ty: check.TBool, op: r }\n    },\n    (\"Dict\", \"get\", 1) => {\n      vt := get(targs, 1) ?? check.TAny\n      at := codegen.table_find(\n        mut g,\n        first,\n        get(rest, 0) ?? codegen.unit(),\n        k0,\n        fs,\n      )\n      ok := codegen.fresh(mut g, \"found\")\n      codegen.emit(mut g, f\"{ok} = icmp sge i64 {at.op}, 0\")\n      (some, none, end) := (\n        codegen.label(mut g, \"some\"),\n        codegen.label(mut g, \"none\"),\n        codegen.label(mut g, \"opt\"),\n      )\n      codegen.emit(\n        mut g,\n        f\"br i1 {ok}, label %{some}, label %{none}\",\n      )\n      codegen.block(mut g, some)\n      pair := codegen.list_at(\n        mut g,\n        codegen.list_view(mut g, first),\n        at.op,\n        et,\n      )\n      b := codegen.block_of(\n        mut g,\n        get(g.tags, \"Some\") ?? 0,\n        [codegen.field(mut g, pair, 1, vt)],\n      )\n      from := codegen.current(g)\n      codegen.br(mut g, end)\n      codegen.block(mut g, none)\n      n := codegen.nullary(mut g, \"None\")\n      codegen.br(mut g, end)\n      codegen.block(mut g, end)\n      r := codegen.fresh(mut g, \"o\")\n      codegen.emit(\n        mut g,\n        f\"{r} = phi ptr [ {b}, %{from} ], [ {n}, %{none} ]\",\n      )\n      codegen.temp(\n        mut g,\n        codegen.V { ty: codegen.option_of(vt), op: r },\n      )\n    },\n    (\"Set\", \"insert\", 1) | (\"Dict\", \"insert\", 2) => {\n      if g.copies && !g.in_update {\n        codegen.note_copy(\n          mut g,\n          1,\n          first,\n          0,\n          codegen.new_table_why(),\n        )\n      }\n      x := if kind == \"Set\" {\n        codegen.converted(mut g, get(rest, 0) ?? codegen.unit(), k0)\n      } else {\n        kv := codegen.converted(mut g, get(rest, 0) ?? codegen.unit(), k0)\n        vv := codegen.converted(\n          mut g,\n          get(rest, 1) ?? codegen.unit(),\n          get(targs, 1) ?? check.TAny,\n        )\n        p := codegen.block_of(mut g, 0, [kv, vv])\n        codegen.temp(mut g, codegen.V { ty: et, op: p })\n      }\n      xs := codegen.to_slot(mut g, x)\n      same(codegen.call(mut g, first.ty, \"strata_tbl_insert\", [\n        first,\n        codegen.V { ty: check.TInt, op: xs },\n        h,\n        c,\n        dict,\n        kind_of,\n      ]))\n    },\n    (\"Set\", \"remove\", 1) | (\"Dict\", \"remove\", 1) => {\n      if g.copies && !g.in_update {\n        codegen.note_copy(\n          mut g,\n          1,\n          first,\n          0,\n          codegen.new_table_why(),\n        )\n      }\n      kv := codegen.converted(mut g, get(rest, 0) ?? codegen.unit(), k0)\n      ks := codegen.to_slot(mut g, kv)\n      same(codegen.call(mut g, first.ty, \"strata_tbl_remove\", [\n        first,\n        codegen.V { ty: check.TInt, op: ks },\n        h,\n        c,\n        dict,\n        kind_of,\n      ]))\n    },\n    (\"Set\", \"union\", 1) | (\"Set\", \"intersection\", 1) | (\"Set\", \"difference\", 1) => {\n      op := match name {\n        \"union\" => \"0\",\n        \"intersection\" => \"1\",\n        _ => \"2\",\n      }\n      same(codegen.call(mut g, first.ty, \"strata_tbl_combine\", [\n        first,\n        get(rest, 0) ?? codegen.unit(),\n        codegen.V { ty: check.TInt, op },\n        h,\n        c,\n        kind_of,\n      ]))\n    },\n    (\"Dict\", \"keys\", 0) | (\"Dict\", \"values\", 0) => codegen.call_fn(\n      mut g,\n      codegen.prelude_name(\"dict_\" + name),\n      [codegen.list_view(mut g, first)],\n      [],\n    ),\n    // written in Strata (the prelude)\n    (\"Dict\", \"excluding\", 1) => {\n      ks := get(rest, 0) ?? codegen.unit()\n      f := if codegen.head_of(ks.ty) == \"Set\" {\n        \"dict_excluding_set\"\n      } else {\n        \"dict_excluding\"\n      }\n      codegen.call_fn(\n        mut g,\n        codegen.prelude_name(f),\n        [first, ks],\n        [],\n      )\n    },\n    (\"Dict\", \"key_set\", 0) => codegen.call_fn(\n      mut g,\n      codegen.prelude_name(\"dict_key_set\"),\n      [codegen.list_view(mut g, first)],\n      [],\n    ),\n    (\"Dict\", \"map_values\", 1) => {\n      // the same keys in the same places: the same index\n      r := codegen.call_fn(\n        mut g,\n        codegen.prelude_name(\"dict_map_values\"),\n        [codegen.list_view(mut g, first)] + rest,\n        [],\n      )\n      match r.ty {\n        check.TList(check.TNamed { args, .. }) => codegen.call(\n          mut g,\n          check.TNamed { name: \"Dict\", args },\n          \"strata_tbl_with_entries\",\n          [r, first],\n        ),\n        _ => r,\n      }\n    },\n    _ => {\n      codegen.not_yet(mut g, \"the built-in `\"\n        + name\n        + \"` on a `\"\n        + codegen.key(first.ty)\n        + \"`\")\n      codegen.never()\n    },\n  }\n}","old_text":"/// Set and dictionary built-ins (`contains`, `get`, `insert`, …, and `set`\n/// and `dict` from a list) on runtime.c's tables.\nfn collection_builtin(\n  mut g: codegen.Gen,\n  name: String,\n  vs: List[codegen.V],\n) -> codegen.V {\n  first := get(vs, 0) ?? codegen.unit()\n  rest := drop(vs, 1)\n  match first.ty {\n    TList(et) => {\n      // from a list. An empty one's type comes from its destination: an\n      // empty table, typed later.\n      if et is TAny {\n        (kind, args) := if name == \"set\" {\n          (\"Set\", [TAny])\n        } else {\n          (\"Dict\", [TAny, TAny])\n        }\n        if codegen.is_temp(g, first.op) {\n          // the empty list has no elements to drop\n          x := codegen.take_value(mut g, first)\n          codegen.drop_value(\n            mut g,\n            codegen.V { ..x, ty: TList(TBool) },\n          )\n        }\n        return codegen.call(\n          mut g,\n          TNamed { name: kind, args },\n          \"strata_tbl_empty\",\n          [],\n        )\n      }\n      if name == \"set\" {\n        return codegen.table_from(\n          mut g,\n          first,\n          TNamed { name: \"Set\", args: [et] },\n        )\n      }\n      match et {\n        TNamed { name: \"Tuple\", args: [kt, vt] } => return codegen.table_from(\n          mut g,\n          first,\n          TNamed { name: \"Dict\", args: [kt, vt] },\n        ),\n        _ => {\n          codegen.not_yet(\n            mut g,\n            \"`dict` of a `\" + codegen.key(first.ty) + \"`\",\n          )\n          return codegen.never()\n        },\n      }\n    },\n    _ => (),\n  }\n  (kind, targs) := match first.ty {\n    TNamed { name: n, args } => (n, args),\n    _ => (\"\", []),\n  }\n  k0 := get(targs, 0) ?? TAny\n  et := codegen.entry_ty(first.ty)\n  fs := if [\n    \"len\",\n    \"to_list\",\n    \"items\",\n    \"keys\",\n    \"values\",\n    \"map_values\",\n    \"excluding\",\n    \"key_set\",\n  ].any(\n    x -> x == name,\n  ) {\n    []\n  } else {\n    codegen.table_fns(mut g, first.ty)\n  }\n  (h, c, dict) := (\n    get(fs, 0) ?? codegen.unit(),\n    get(fs, 1) ?? codegen.unit(),\n    get(fs, 2) ?? codegen.unit(),\n  )\n  kind_of := codegen.elements_kind(et)\n  same := r -> codegen.V { ..r, ty: first.ty }\n  match (kind, name, len(rest)) {\n    (_, \"len\", 0) => codegen.list_len(mut g, codegen.list_view(mut g, first)),\n    (\"Set\", \"to_list\", 0) | (\"Dict\", \"items\", 0) => codegen.hold(mut g, codegen.list_view(mut g, first)),\n    (\"Set\", \"contains\", 1) | (\"Dict\", \"contains\", 1) => {\n      at := codegen.table_find(\n        mut g,\n        first,\n        get(rest, 0) ?? codegen.unit(),\n        k0,\n        fs,\n      )\n      r := codegen.fresh(mut g, \"found\")\n      codegen.emit(mut g, f\"{r} = icmp sge i64 {at.op}, 0\")\n      codegen.V { ty: TBool, op: r }\n    },\n    (\"Dict\", \"get\", 1) => {\n      vt := get(targs, 1) ?? TAny\n      at := codegen.table_find(\n        mut g,\n        first,\n        get(rest, 0) ?? codegen.unit(),\n        k0,\n        fs,\n      )\n      ok := codegen.fresh(mut g, \"found\")\n      codegen.emit(mut g, f\"{ok} = icmp sge i64 {at.op}, 0\")\n      (some, none, end) := (\n        codegen.label(mut g, \"some\"),\n        codegen.label(mut g, \"none\"),\n        codegen.label(mut g, \"opt\"),\n      )\n      codegen.emit(\n        mut g,\n        f\"br i1 {ok}, label %{some}, label %{none}\",\n      )\n      codegen.block(mut g, some)\n      pair := codegen.list_at(\n        mut g,\n        codegen.list_view(mut g, first),\n        at.op,\n        et,\n      )\n      b := codegen.block_of(\n        mut g,\n        get(g.tags, \"Some\") ?? 0,\n        [codegen.field(mut g, pair, 1, vt)],\n      )\n      from := codegen.current(g)\n      codegen.br(mut g, end)\n      codegen.block(mut g, none)\n      n := codegen.nullary(mut g, \"None\")\n      codegen.br(mut g, end)\n      codegen.block(mut g, end)\n      r := codegen.fresh(mut g, \"o\")\n      codegen.emit(\n        mut g,\n        f\"{r} = phi ptr [ {b}, %{from} ], [ {n}, %{none} ]\",\n      )\n      codegen.temp(\n        mut g,\n        codegen.V { ty: codegen.option_of(vt), op: r },\n      )\n    },\n    (\"Set\", \"insert\", 1) | (\"Dict\", \"insert\", 2) => {\n      if g.copies && !g.in_update {\n        codegen.note_copy(\n          mut g,\n          1,\n          first,\n          0,\n          codegen.new_table_why(),\n        )\n      }\n      x := if kind == \"Set\" {\n        codegen.converted(mut g, get(rest, 0) ?? codegen.unit(), k0)\n      } else {\n        kv := codegen.converted(mut g, get(rest, 0) ?? codegen.unit(), k0)\n        vv := codegen.converted(\n          mut g,\n          get(rest, 1) ?? codegen.unit(),\n          get(targs, 1) ?? TAny,\n        )\n        p := codegen.block_of(mut g, 0, [kv, vv])\n        codegen.temp(mut g, codegen.V { ty: et, op: p })\n      }\n      xs := codegen.to_slot(mut g, x)\n      same(codegen.call(\n        mut g,\n        first.ty,\n        \"strata_tbl_insert\",\n        [first, codegen.V { ty: TInt, op: xs }, h, c, dict, kind_of],\n      ))\n    },\n    (\"Set\", \"remove\", 1) | (\"Dict\", \"remove\", 1) => {\n      if g.copies && !g.in_update {\n        codegen.note_copy(\n          mut g,\n          1,\n          first,\n          0,\n          codegen.new_table_why(),\n        )\n      }\n      kv := codegen.converted(mut g, get(rest, 0) ?? codegen.unit(), k0)\n      ks := codegen.to_slot(mut g, kv)\n      same(codegen.call(\n        mut g,\n        first.ty,\n        \"strata_tbl_remove\",\n        [first, codegen.V { ty: TInt, op: ks }, h, c, dict, kind_of],\n      ))\n    },\n    (\"Set\", \"union\", 1) | (\"Set\", \"intersection\", 1) | (\"Set\", \"difference\", 1) => {\n      op := match name {\n        \"union\" => \"0\",\n        \"intersection\" => \"1\",\n        _ => \"2\",\n      }\n      same(codegen.call(mut g, first.ty, \"strata_tbl_combine\", [\n        first,\n        get(rest, 0) ?? codegen.unit(),\n        codegen.V { ty: TInt, op },\n        h,\n        c,\n        kind_of,\n      ]))\n    },\n    (\"Dict\", \"keys\", 0) | (\"Dict\", \"values\", 0) => codegen.call_fn(\n      mut g,\n      codegen.prelude_name(\"dict_\" + name),\n      [codegen.list_view(mut g, first)],\n      [],\n    ),\n    // written in Strata (the prelude)\n    (\"Dict\", \"excluding\", 1) => {\n      ks := get(rest, 0) ?? codegen.unit()\n      f := if codegen.head_of(ks.ty) == \"Set\" {\n        \"dict_excluding_set\"\n      } else {\n        \"dict_excluding\"\n      }\n      codegen.call_fn(\n        mut g,\n        codegen.prelude_name(f),\n        [first, ks],\n        [],\n      )\n    },\n    (\"Dict\", \"key_set\", 0) => codegen.call_fn(\n      mut g,\n      codegen.prelude_name(\"dict_key_set\"),\n      [codegen.list_view(mut g, first)],\n      [],\n    ),\n    (\"Dict\", \"map_values\", 1) => {\n      // the same keys in the same places: the same index\n      r := codegen.call_fn(\n        mut g,\n        codegen.prelude_name(\"dict_map_values\"),\n        [codegen.list_view(mut g, first)] + rest,\n        [],\n      )\n      match r.ty {\n        TList(TNamed { args, .. }) => codegen.call(\n          mut g,\n          TNamed { name: \"Dict\", args },\n          \"strata_tbl_with_entries\",\n          [r, first],\n        ),\n        _ => r,\n      }\n    },\n    _ => {\n      codegen.not_yet(mut g, \"the built-in `\"\n        + name\n        + \"` on a `\"\n        + codegen.key(first.ty)\n        + \"`\")\n      codegen.never()\n    },\n  }\n}"},{"name":"codegen.order_closure","kind":"fn","old":