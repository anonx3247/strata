"old":"7d1b97bf662ebf3a","new":"a3883020d774cd6d","interface_changed":false,"affected":[],"module":"kernel_dependent_patch","text":"fn timed(\n  clock: std.time.SystemClock,\n  mut out: List[kernel_dependent_patch.Checked],\n  env: kernel_dependent.Environment,\n  name: String,\n  ps: List[(String, kernel_dependent.Term)],\n  statement: kernel_dependent.Term,\n  tactic: (kernel_dependent_tactics.Goal) -> Result[kernel_dependent.Term, String],\n) -> Result[kernel_dependent.Environment, String] {\n  goal := kernel_dependent_patch.pis(\n    kernel_dependent_patch.schema() + ps,\n    statement,\n  )\n  t0 := clock.now().value\n  proof := tactic(\n    kernel_dependent_tactics.Goal { env, context: [], target: goal },\n  ) except m { return Err(\"`\" + name + \"`: \" + m) }\n  t1 := clock.now().value\n  e := kernel_dependent.define(env, name, goal, proof) except m {\n    return Err(\"`\" + name + \"`: \" + m)\n  }\n  mut out.push(\n    kernel_dependent_patch.Checked {\n      name,\n      tactic_ns: t1 - t0,\n      kernel_ns: clock.now().value - t1,\n      size: kernel_dependent_patch.size(proof),\n    },\n  )\n  Ok(e)\n}","old_text":"fn timed(\n  clock: std.time.SystemClock,\n  mut out: List[kernel_dependent_patch.Checked],\n  env: kernel_dependent.Environment,\n  name: String,\n  ps: List[(String, kernel_dependent.Term)],\n  statement: kernel_dependent.Term,\n  tactic: (kernel_dependent_tactics.Goal) -> Result[kernel_dependent.Term, String],\n) -> Result[kernel_dependent.Environment, String] {\n  t0 := clock.now().value\n  e := kernel_dependent_tactics.prove(\n    env,\n    name,\n    kernel_dependent_patch.pis(\n      kernel_dependent_patch.schema() + ps,\n      statement,\n    ),\n    tactic,\n  ) except m { return Err(\"`\" + name + \"`: \" + m) }\n  mut out.push(\n    kernel_dependent_patch.Checked {\n      name,\n      ns: clock.now().value - t0,\n    },\n  )\n  Ok(e)\n}"},{"name":"kernel_dependent_patch.size","kind":"fn","old":null,"new":"352ba0e752d45aee","interface_changed":true,"affected":[],"module":"kernel_dependent_patch","text":"fn size(t: kernel_dependent.Term) -> Int {\n  match t {\n    kernel_dependent.Pi { domain, body, .. } => 1\n      + kernel_dependent_patch.size(domain)\n      + kernel_dependent_patch.size(body),\n    kernel_dependent.Lambda { domain, body, .. } => 1\n      + kernel_dependent_patch.size(domain)\n      + kernel_dependent_patch.size(body),\n    kernel_dependent.Apply { function, argument } => 1\n      + kernel_dependent_patch.size(function)\n      + kernel_dependent_patch.size(argument),\n    _ => 1,\n  }\n}"}]}
