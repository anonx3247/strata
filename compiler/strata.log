e_command","computed_value","codegen.read_back","comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"/// Specializes code for the known values.\nfn expr(mut x: derive.Expander, e: ast.Expr) -> Result[ast.Expr, String] {\n  match e {\n    ast.Comptime(inner) => {\n      // what it uses (`Self`, known names) written in, then run\n      known := derive.expr(mut x, inner)!\n      return derive.eval_as(mut x, known, inner)\n    },\n    // a known value used at run time: written in\n    ast.Var(n) => if derive.is_known(x, n) {\n      return Ok(get(x.known, n) ?? e)\n    },\n    // `f.default_value`: the field's default, as written\n    ast.FieldOf { base: ast.Var(n), name: \"default_value\" } => if derive.is_known(x, n) {\n      return Ok(\n        get(x.defaults, derive.key(get(x.known, n) ?? ast.UnitExpr)) ?? ast.Hole(\"no_default\"),\n      )\n    },\n    _ => (),\n  }\n  // `self.0` in a match comprehension arm that matched a tuple variant\n  match e {\n    ast.FieldOf { base: b, name: d } => {\n      shown := text.expr_text(b, 0)\n      match derive.last_arm(x, shown) {\n        Some(names) => match names.find(kv -> kv.0 == d) {\n          Some(kv) => return Ok(ast.Var(kv.1)),\n          None => (),\n        },\n        None => (),\n      }\n    },\n    _ => (),\n  }\n  // `f.name`, `Self.name`, `v.fields`, `v.name ?? \"\"`: read at compile time\n  match e {\n    ast.FieldOf { .. } | ast.Fallback { .. } => match derive.data(mut x, e) {\n      Some(v) => return Ok(v),\n      None => (),\n    },\n    _ => (),\n  }\n  // `Self.call(p -> e)`, `Self.try_call(p -> e)`: a call of the function\n  // derived for\n  match e {\n    ast.MethodCall { recv, name: m, args } => if (m == \"call\" || m == \"try_call\") && x.self_fn != \"\" {\n      match derive.expr(mut x, recv) {\n        Ok(r) => match derive.eval_here(mut x, r) {\n          Ok(d) => if derive.kind_name(d) == Some(\"Function\") {\n            return derive.call_fn(mut x, d, m == \"try_call\", args)\n          },\n          Err(_) => (),\n        },\n        Err(_) => (),\n      }\n    },\n    _ => (),\n  }\n  match e {\n    // `t.check(x)`: `Ok(())`, or `Err` with what it breaks\n    ast.MethodCall { recv, name: \"check\", args } => match derive.type_named(x, recv) {\n      Some(t) => match args {\n        [a] => {\n          v := derive.expr(mut x, a)!\n          return Ok(derive.check_code(x, t, v))\n        },\n        _ => return Err(\"`check` takes the value to check\"),\n      },\n      None => (),\n    },\n    // `Self.make(f -> e)`, `v.make()`, `v.try_make(f -> e)`: only on a\n    // description known at compile time\n    ast.MethodCall { recv, name: m, args } => if m == \"make\" || m == \"try_make\" {\n      desc := match derive.expr(mut x, recv) {\n        Ok(r) => derive.eval_here(mut x, r),\n        Err(err) => Err(err),\n      }\n      return match desc {\n        Ok(d) => derive.make(mut x, d, m == \"try_make\", args),\n        Err(_) => Err(\n          \"`\"\n            + text.expr_text(recv, 0)\n            + \".\"\n            + m\n            + \"(..)` needs `\"\n            + text.expr_text(recv, 0)\n            + \"` known at compile time: build each variant in a `comptime for v in $Self.variants` (or a match comprehension)\",\n        ),\n      }\n    } else if m == \"of\" {\n      match recv {\n        ast.Var(f) => if derive.is_known(x, f) {\n          return derive.field_read(mut x, f, args)\n        },\n        _ => (),\n      }\n    } else if m != \"check\" {\n      // `t.decode(j)`, `f.type.decode(j)`: a method of a type known at\n      // compile time, called on that type\n      match derive.type_named(x, recv) {\n        Some(t) => return derive.type_method(mut x, recv, t, m, args),\n        None => (),\n      }\n    },\n    // `if comptime c { a } else { b }`: only the branch taken is kept\n    ast.IfExpr { cond, then, otherwise } => if walk.any_expr(cond, c -> derive.is_comptime(c)) {\n      c := derive.expr(mut x, cond)!\n      return match derive.eval_here(mut x, c) {\n        Ok(ast.BoolLit(true)) => derive.expr(mut x, then),\n        Ok(ast.BoolLit(false)) => derive.expr(mut x, otherwise),\n        _ => Err(\"`if \"\n          + text.expr_text(c, 0)\n          + \"`: the condition must be known while compiling\"),\n      }\n    },\n    ast.Block { stmts, last } => return derive.block(mut x, stmts, last),\n    ast.MatchExpr { scrutinee, binding, arms } => if arms.any(a -> a.pat is ast.ForPat) {\n      return derive.comprehension(mut x, scrutinee, binding, arms)\n    } else {\n      match (scrutinee, binding) {\n        (ast.Comptime(inner), None) => return derive.match_type(mut x, inner, arms),\n        _ => (),\n      }\n    },\n    ast.Call { callee, args } => {\n      match callee {\n        ast.Var(n) => if derive.short(n) == \"compile_error\" && len(args) == 1 {\n          // reached in specialized code, the `derive` fails with this message\n          m := derive.expr(mut x, get(args, 0) ?? ast.UnitExpr)!\n          return Err(match derive.eval_here(mut x, m)! {\n            ast.StrLit(s) => s,\n            other => text.expr_text(other, 0),\n          })\n        },\n        _ => (),\n      }\n      // `t(v)`: a value of the `distinct` type `t`, known at compile time\n      match derive.type_named(x, callee) {\n        Some(t) => match derive.distinct_head(x, t) {\n          Some(h) => {\n            mut out := []\n            for a in args {\n              mut out.push(derive.expr(mut x, a)!)\n            }\n            return Ok(\n              ast.CtorExpr {\n                name: h,\n                args: ast.PositionalArgs(out),\n              },\n            )\n          },\n          None => (),\n        },\n        None => (),\n      }\n      match callee {\n        ast.Var(n) => match get(x.ix.fns, n) {\n          Some(fd) => if fd.params.any(p -> p.compile_time)\n            && !derive.is_hidden(x, n) {\n            return derive.call_copy(mut x, n, fd, args)\n          },\n          None => (),\n        },\n        _ => (),\n      }\n    },\n    ast.Lambda { params, .. } => {\n      mut x.hidden.push(params.map(p -> p.name))\n      r := derive.children(mut x, e)\n      x.hidden = take(x.hidden, len(x.hidden) - 1)\n      return r\n    },\n    _ => (),\n  }\n  derive.children(mut x, e)\n}","old_text":"/// Specializes code for the known values.\nfn expr(mut x: derive.X, e: ast.Expr) -> Result[ast.Expr, String] {\n  match e {\n    ast.Comptime(inner) => {\n      // what it uses (`Self`, known names) written in, then run\n      known := derive.expr(mut x, inner)!\n      return derive.eval_as(mut x, known, inner)\n    },\n    // a known value used at run time: written in\n    ast.Var(n) => if derive.is_known(x, n) {\n      return Ok(get(x.known, n) ?? e)\n    },\n    // `f.default_value`: the field's default, as written\n    ast.FieldOf { base: ast.Var(n), name: \"default_value\" } => if derive.is_known(x, n) {\n      return Ok(\n        get(x.defaults, derive.key(get(x.known, n) ?? ast.UnitExpr)) ?? ast.Hole(\"no_default\"),\n      )\n    },\n    _ => (),\n  }\n  // `self.0` in a match comprehension arm that matched a tuple variant\n  match e {\n    ast.FieldOf { base: b, name: d } => {\n      shown := text.expr_text(b, 0)\n      match derive.last_arm(x, shown) {\n        Some(names) => match names.find(kv -> kv.0 == d) {\n          Some(kv) => return Ok(ast.Var(kv.1)),\n          None => (),\n        },\n        None => (),\n      }\n    },\n    _ => (),\n  }\n  // `f.name`, `Self.name`, `v.fields`, `v.name ?? \"\"`: read at compile time\n  match e {\n    ast.FieldOf { .. } | ast.Fallback { .. } => match derive.data(mut x, e) {\n      Some(v) => return Ok(v),\n      None => (),\n    },\n    _ => (),\n  }\n  // `Self.call(p -> e)`, `Self.try_call(p -> e)`: a call of the function\n  // derived for\n  match e {\n    ast.MethodCall { recv, name: m, args } => if (m == \"call\" || m == \"try_call\") && x.self_fn != \"\" {\n      match derive.expr(mut x, recv) {\n        Ok(r) => match derive.eval_here(mut x, r) {\n          Ok(d) => if derive.kind_name(d) == Some(\"Function\") {\n            return derive.call_fn(mut x, d, m == \"try_call\", args)\n          },\n          Err(_) => (),\n        },\n        Err(_) => (),\n      }\n    },\n    _ => (),\n  }\n  match e {\n    // `t.check(x)`: `Ok(())`, or `Err` with what it breaks\n    ast.MethodCall { recv, name: \"check\", args } => match derive.type_named(x, recv) {\n      Some(t) => match args {\n        [a] => {\n          v := derive.expr(mut x, a)!\n          return Ok(derive.check_code(x, t, v))\n        },\n        _ => return Err(\"`check` takes the value to check\"),\n      },\n      None => (),\n    },\n    // `Self.make(f -> e)`, `v.make()`, `v.try_make(f -> e)`: only on a\n    // description known at compile time\n    ast.MethodCall { recv, name: m, args } => if m == \"make\" || m == \"try_make\" {\n      desc := match derive.expr(mut x, recv) {\n        Ok(r) => derive.eval_here(mut x, r),\n        Err(err) => Err(err),\n      }\n      return match desc {\n        Ok(d) => derive.make(mut x, d, m == \"try_make\", args),\n        Err(_) => Err(\n          \"`\"\n            + text.expr_text(recv, 0)\n            + \".\"\n            + m\n            + \"(..)` needs `\"\n            + text.expr_text(recv, 0)\n            + \"` known at compile time: build each variant in a `comptime for v in $Self.variants` (or a match comprehension)\",\n        ),\n      }\n    } else if m == \"of\" {\n      match recv {\n        ast.Var(f) => if derive.is_known(x, f) {\n          return derive.field_read(mut x, f, args)\n        },\n        _ => (),\n      }\n    } else if m != \"check\" {\n      // `t.decode(j)`, `f.type.decode(j)`: a method of a type known at\n      // compile time, called on that type\n      match derive.type_named(x, recv) {\n        Some(t) => return derive.type_method(mut x, recv, t, m, args),\n        None => (),\n      }\n    },\n    // `if comptime c { a } else { b }`: only the branch taken is kept\n    ast.IfExpr { cond, then, otherwise } => if walk.any_expr(cond, c -> derive.is_comptime(c)) {\n      c := derive.expr(mut x, cond)!\n      return match derive.eval_here(mut x, c) {\n        Ok(ast.BoolLit(true)) => derive.expr(mut x, then),\n        Ok(ast.BoolLit(false)) => derive.expr(mut x, otherwise),\n        _ => Err(\"`if \"\n          + text.expr_text(c, 0)\n          + \"`: the condition must be known while compiling\"),\n      }\n    },\n    ast.Block { stmts, last } => return derive.block(mut x, stmts, last),\n    ast.MatchExpr { scrutinee, binding, arms } => if arms.any(a -> a.pat is ast.ForPat) {\n      return derive.comprehension(mut x, scrutinee, binding, arms)\n    } else {\n      match (scrutinee, binding) {\n        (ast.Comptime(inner), None) => return derive.match_type(mut x, inner, arms),\n        _ => (),\n      }\n    },\n    ast.Call { callee, args } => {\n      match callee {\n        ast.Var(n) => if derive.short(n) == \"compile_error\" && len(args) == 1 {\n          // reached in specialized code, the `derive` fails with this message\n          m := derive.expr(mut x, get(args, 0) ?? ast.UnitExpr)!\n          return Err(match derive.eval_here(mut x, m)! {\n            ast.StrLit(s) => s,\n            other => text.expr_text(other, 0),\n          })\n        },\n        _ => (),\n      }\n      // `t(v)`: a value of the `distinct` type `t`, known at compile time\n      match derive.type_named(x, callee) {\n        Some(t) => match derive.distinct_head(x, t) {\n          Some(h) => {\n            mut out := []\n            for a in args {\n              mut out.push(derive.expr(mut x, a)!)\n            }\n            return Ok(\n              ast.CtorExpr {\n                name: h,\n                args: ast.PositionalArgs(out),\n              },\n            )\n          },\n          None => (),\n        },\n        None => (),\n      }\n      match callee