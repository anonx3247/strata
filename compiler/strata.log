odegen.assigned_call","codegen.generated","codegen.can_generate","codegen.mock_value","codegen.call","codegen.await_one","codegen.channel_op","codegen.after_builtin","codegen.dyn_entry","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.try_expr","codegen.get_field","codegen.if_expr","codegen.check_member","codegen.assertion","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.appended","codegen.generated_args","codegen.makers","codegen.int_lit","codegen.concat","codegen.finite","codegen.slice_raw","codegen.word_to_int","codegen.mem_builtin","codegen.table_from","codegen.set_copy","codegen.raw_call","codegen.dyn_equal","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.hash_fields","codegen.conversion","codegen.list_slice","codegen.as_type","codegen.word_op","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// Frees the block, then drops its counted fields, integers first. The last\n/// object field's drop is then a `musttail` call, so a long chain\n/// (`Link(i, Link(…))`) does not grow the stack.\nfn drop_fields(mut g: codegen.Gen, a: codegen.V, tys: List[check.Ty]) {\n  mut ints := []\n  mut objects := []\n  for (k, t) in enumerate(tys) {\n    if codegen.counted(t) {\n      x := codegen.field(mut g, a, k, t)\n      if t is check.TInt {\n        mut ints.push(x)\n      } else {\n        mut objects.push(x)\n      }\n    }\n  }\n  codegen.emit(mut g, \"call void @strata_free(ptr %a)\")\n  for x in ints {\n    codegen.drop_value(mut g, x)\n  }\n  for (k, x) in enumerate(objects) {\n    if k + 1 == len(objects) && codegen.tail_drop(mut g, x) {\n      return\n    }\n    codegen.drop_value(mut g, x)\n  }\n  codegen.br(mut g, \"kept\")\n}","old_text":"/// Frees the block, then drops its counted fields, integers first. The last\n/// object field's drop is then a `musttail` call, so a long chain\n/// (`Link(i, Link(…))`) does not grow the stack.\nfn drop_fields(mut g: codegen.Gen, a: codegen.V, tys: List[Ty]) {\n  mut ints := []\n  mut objects := []\n  for (k, t) in enumerate(tys) {\n    if codegen.counted(t) {\n      x := codegen.field(mut g, a, k, t)\n      if t is TInt {\n        mut ints.push(x)\n      } else {\n        mut objects.push(x)\n      }\n    }\n  }\n  codegen.emit(mut g, \"call void @strata_free(ptr %a)\")\n  for x in ints {\n    codegen.drop_value(mut g, x)\n  }\n  for (k, x) in enumerate(objects) {\n    if k + 1 == len(objects) && codegen.tail_drop(mut g, x) {\n      return\n    }\n    codegen.drop_value(mut g, x)\n  }\n  codegen.br(mut g, \"kept\")\n}"},{"name":"codegen.matches","kind":"fn","old":"3c676e3e06a15ada","new":"02b02f78ef183266","interface_changed":false,"affected":[],"module":"codegen","text":"/// Tests `v` against a pattern: jumps to `fail` on a mismatch, else goes on.\n/// `binds` binds the names afterwards, once nothing can fail.\nfn matches(mut g: codegen.Gen, p: ast.Pattern, v: codegen.V, fail: String) {\n  match v.ty {\n    check.TUnion(ms) => match codegen.pattern_member(g, ms, p) {\n      Some(m) => {\n        ok := codegen.holds_member(mut g, v, m)\n        codegen.go_on_if(mut g, ok, fail)\n        if !codegen.type_pattern(g, p, m) {\n          nx := codegen.narrow(mut g, v, m)\n          codegen.matches(mut g, p, nx, fail)\n        }\n        return\n      },\n      None => (),\n    },\n    _ => (),\n  }\n  match p {\n    ast.Wild | ast.Bind(_) => (),\n    ast.IntPat(n) => {\n      // a big literal is dropped before going on\n      codegen.push_transparent(mut g)\n      x := codegen.int_lit(mut g, n)\n      ok := codegen.equal(mut g, v, x)\n      codegen.pop_scope(mut g)\n      codegen.go_on_if(mut g, ok, fail)\n    },\n    ast.StrPat(s) => {\n      x := codegen.lit(mut g, s)\n      ok := codegen.equal(mut g, v, x)\n      codegen.go_on_if(mut g, ok, fail)\n    },\n    ast.BoolPat(b) => {\n      ok := codegen.equal(\n        mut g,\n        v,\n        codegen.V { ty: check.TBool, op: to_string(b) },\n      )\n      codegen.go_on_if(mut g, ok, fail)\n    },\n    ast.CtorPattern { name, args } => if contains(g.types.ctors, name) {\n      ok := codegen.tag_is(mut g, v, name)\n      codegen.go_on_if(mut g, ok, fail)\n      for (x, q) in codegen.sub_patterns(mut g, name, args, v, false) {\n        codegen.matches(mut g, q, x, fail)\n      }\n    } else {\n      // a refined type's name (`Positive =>`): the value satisfies it\n      match (get(g.refines, name), args) {\n        (Some((_, pred)), ast.NoPats) => {\n          codegen.push_transparent(mut g)\n          ok := codegen.with_it(mut g, v, pred)\n          codegen.pop_scope(mut g)\n          codegen.go_on_if(mut g, ok, fail)\n        },\n        _ => codegen.not_yet(\n          mut g,\n          \"the pattern `\" + text.pattern_text(p) + \"`\",\n        ),\n      }\n    },\n    ast.TuplePat(ps) => match v.ty {\n      check.TNamed { name: \"Tuple\", args } => {\n        for (k, q) in enumerate(ps) {\n          if codegen.sub_wanted(q, false) {\n            x := codegen.field(mut g, v, k, get(args, k) ?? check.TAny)\n            codegen.matches(mut g, q, x, fail)\n          }\n        }\n      },\n      _ => codegen.not_yet(\n        mut g,\n        \"the pattern `\" + text.pattern_text(p) + \"`\",\n      ),\n    },\n    ast.OrPat(ps) => {\n      matched := codegen.label(mut g, \"alt.matched\")\n      for (k, q) in enumerate(ps) {\n        if k + 1 == len(ps) {\n          codegen.matches(mut g, q, v, fail)\n        } else {\n          next := codegen.label(mut g, \"alt.next\")\n          codegen.matches(mut g, q, v, next)\n          codegen.br(mut g, matched)\n          codegen.block(mut g, next)\n        }\n      }\n      codegen.br(mut g, matched)\n      codegen.block(mut g, matched)\n    },\n    ast.CondPat(c) => {\n      // the condition sees `it` (borrowed), in its own scope\n      codegen.push_scope(mut g)\n      _ := codegen.local_value(mut g, \"it\", v)\n      ok := codegen.expr(mut g, c)\n      codegen.pop_scope(mut g)\n      if !(ok.ty is check.TAny) {\n        codegen.go_on_if(mut g, ok, fail)\n      }\n    },\n    ast.ListPat { items, rest } => match v.ty {\n      check.TList(et) => {\n        n := codegen.list_len(mut g, v)\n        ok := codegen.fresh(mut g, \"lenok\")\n        cmp := match rest {\n          Some(_) => \"sge\",\n          None => \"eq\",\n        }\n        codegen.emit(\n          mut g,\n          f\"{ok} = icmp {cmp} i64 {n.op}, {len(items)}\",\n        )\n        codegen.go_on_if(\n          mut g,\n          codegen.V { ty: check.TBool, op: ok },\n          fail,\n        )\n        for (k, q) in enumerate(items) {\n          x := codegen.list_at(mut g, v, to_string(k), et)\n          codegen.matches(mut g, q, x, fail)\n        }\n      },\n      _ => codegen.not_yet(\n        mut g,\n        \"the pattern `\" + text.pattern_text(p) + \"`\",\n      ),\n    },\n    _ => codegen.not_yet(\n      mut g,\n      \"the pattern `\" + text.pattern_text(p) + \"`\",\n    ),\n  }\n}","old_text":"/// Tests `v` against a pattern: jumps to `fail` on a mismatch, else goes on.\n/// `binds` binds the names afterwards, once nothing can fail.\nfn matches(mut g: codegen.Gen, p: ast.Pattern, v: codegen.V, fail: String) {\n  match v.ty {\n    TUnion(ms) => match codegen.pattern_member(g, ms, p) {\n      Some(m) => {\n        ok := codegen.holds_member(mut g, v, m)\n        codegen.go_on_if(mut g, ok, fail)\n        if !codegen.type_pattern(g, p, m) {\n          nx := codegen.narrow(mut g, v, m)\n          codegen.matches(mut g, p, nx, fail)\n        }\n        return\n      },\n      None => (),\n    },\n    _ => (),\n  }\n  match p {\n    ast.Wild | ast.Bind(_) => (),\n    ast.IntPat(n) => {\n      // a big literal is dropped before going on\n      codegen.push_transparent(mut g)\n      x := codegen.int_lit(mut g, n)\n      ok := codegen.equal(mut g, v, x)\n      codegen.pop_scope(mut g)\n      codegen.go_on_if(mut g, ok, fail)\n    },\n    ast.StrPat(s) => {\n      x := codegen.lit(mut g, s)\n      ok := codegen.equal(mut g, v, x)\n      codegen.go_on_if(mut g, ok, fail)\n    },\n    ast.BoolPat(b) => {\n      ok := codegen.equal(\n        mut g,\n        v,\n        codegen.V { ty: TBool, op: to_string(b) },\n      )\n      codegen.go_on_if(mut g, ok, fail)\n    },\n    ast.CtorPattern { name, args } => if contains(g.types.ctors, name) {\n      ok := codegen.tag_is(mut g, v, name)\n      codegen.go_on_if(mut g, ok, fail)\n      for (x, q) in codegen.sub_patterns(mut g, name, args, v, false) {\n        codegen.matches(mut g, q, x, fail)\n      }\n    } else {\n      // a refined type's name (`Positive =>`): the value satisfies it\n      match (get(g.refines, name), args) {\n        (Some((_, pred)), ast.NoPats) => {\n          codegen.push_transparent(mut g)\n          ok := codegen.with_it(mut g, v, pred)\n          codegen.pop_scope(mut g)\n          codegen.go_on_if(mut g, ok, fail)\n        },\n        _ => codegen.not_yet(\n          mut g,\n          \"the pattern `\" + text.pattern_text(p) + \"`\",\n        ),\n      }\n    },\n    ast.TuplePat(ps) => match v.ty {\n      TNamed { name: \"Tuple\", args } => {\n        for (k, q) in enumerate(ps) {\n          if codegen.sub_wanted(q, false) {\n            x := codegen.field(mut g, v, k, get(args, k) ?? TAny)\n            codegen.matches(mut g, q, x, fail)\n          }\n        }\n      },\n      _ => codegen.not_yet(\n        mut g,\n        \"the pattern `\" + text.pattern_text(p) + \"`\",\n      ),\n    },\n    ast.OrPat(ps) => {\n      matched := codegen.label(mut g, \"alt.matched\")\n      for (k, q) in enumerate(ps) {\n        if k + 1 == len(ps) {\n          codegen.matches(mut g, q, v, fail)\n        } else {\n          next := codegen.label(mut g, \"alt.next\")\n          codegen.matches(mut g, q, v, next)\n          codegen.br(mut g, matched)\n          codegen.block(mut g, next)\n        }\n      }\n      codegen.br(mut g, matched)\n      codegen.block(mut g, matched)\n    },\n    ast.CondPat(c) => {\n      // the condition sees `it` (borrowed), in its own scope\n      codegen.push_scope(mut g)\n      _ := codegen.local_value(mut g, \"it\", v)\n      ok := codegen.expr(mut g, c)\n      codegen.pop_scope(mut g)\n      if !(ok.ty is TAny) {\n        codegen.go_on_if(mut g, ok, fail)\n      }\n    },\n    ast.ListPat { items, rest } => match v.ty {\n      TList(et) => {\n        n := codegen.list_len(mut g, v)\n        ok := codegen.fresh(mut g, \"lenok\")\n        cmp := match rest {\n          Some(_) => \"sge\",\n          None => \"eq\",\n        }\n        codegen.emit(\n          mut g,\n          f\"{ok} = icmp {cmp} i64 {n.op}, {len(items)}\",\n        )\n        codegen.go_on_if(\n          mut g,\n          codegen.V { ty: TBool, op: ok },\n          fail,\n        )\n        for (k, q) in enumerate(items) {\n          x := codegen.list_at(mut g, v, to_string(k), et)\n          codegen.matches(mut g, q, x, fail)\n        }\n      },\n      _ => codegen.not_yet(\n        mut g,\n        \"the pattern `\" + text.pattern_text(p) + \"`\",\n      ),\n    },\n    _ => codegen.not_yet(\n      mut g,\n      \"the pattern `\" + text.pattern_text(p) + \"`\",\n    ),\n  }\n}"},{"name":"codegen.binds","kind":"fn","old":"bba87d47c29ba05e","new":"89684a9799fc1c05","interface_changed":false,"affected":[],"module":"codegen","text":"/// Binds the names of a pattern that `v` matched.\nfn binds(mut g: codegen.Gen, p: ast.Pattern, v: codegen.V) {\n  match v.ty {\n    check.TUnion(ms) => match codegen.pattern_member(g, ms, p) {\n      Some(m) => {\n        if !codegen.type_pattern(g, p, m) {\n          nx := codegen.narrow(mut g, v, m)\n          codegen.binds(mut g, p, nx)\n        }\n        return\n      },\n      None => (),\n    },\n    _ => (),\n  }\n  match p {\n    ast.Bind(n) => codegen.bind(mut g, n, v),\n    ast.CtorPattern { name, args } => if contains(g.types.ctors, name) {\n      for (x, q) in codegen.sub_patterns(mut g, name, args, v, true) {\n        codegen.binds(mut g, q, x)\n      }\n    },\n    ast.TuplePat(ps) => match v.ty {\n      check.TNamed { name: \"Tuple\", args } => {\n        for (k, q) in enumerate(ps) {\n          if codegen.binds_names(q) {\n            x := codegen.field(mut g, v, k, get(args, k) ?? check.TAny)\n            codegen.binds(mut g, q, x)\n          }\n        }\n      },\n      _ => (),\n    },\n    ast.OrPat(ps) => if codegen.binds_names(p) {\n      // the matching alternative binds them, each to the shared slots\n      done := codegen.label(mut g, \"alt.bound\")\n      g.alts += 1\n      for (k, q) in enumerate(ps) {\n        if k + 1 == len(ps) {\n          codegen.binds(mut g, q, v)\n        } else {\n          next := codegen.label(mut g, \"alt.other\")\n          codegen.matches(mut g, q, v, next)\n          codegen.binds(mut g, q, v)\n          codegen.br(mut g, done)\n          codegen.block(mut g, next)\n        }\n      }\n      g.alts -= 1\n      codegen.br(mut g, done)\n      codegen.block(mut g, done)\n    },\n    ast.ListPat { items, rest } => match v.ty {\n      check.TList(et) => {\n        for (k, q) in enumerate(items) {\n          if codegen.binds_names(q) {\n            x := codegen.list_at(mut g, v, to_string(k), et)\n            codegen.binds(mut g, q, x)\n          }\n        }\n        match rest {\n          Some(r) => if r != \"_\" {\n            n := codegen.list_len(mut g, v)\n            tail := codegen.slice_raw(mut g, v, to_string(len(items)), n.op)\n            codegen.bind(mut g, r, tail)\n          },\n          None => (),\n        }\n      },\n      _ => (),\n    },\n    _ => (),\n  }\n}","old_text":"/// Binds the names of a pattern that `v` matched.\nfn binds(mut g: codegen.Gen, p: ast.Pattern, v: codegen.V) {\n  match v.ty {\n    TUnion(ms) => match codegen.pattern_member(g, ms, p) {\n      Some(m) => {\n        if !codegen.type_pattern(g, p, m) {\n          nx := codegen.narrow(mut g, v, m)\n          codegen.binds(mut g, p, nx)\n        }\n        return\n      },\n      None => (),\n    },\n    _ => (),\n  }\n  match p {\n    ast.Bind(n) => codegen.bind(mut g, n, v),\n    ast.CtorPattern { name, args } => if contains(g.types.ctors, name) {\n      for (x, q) in codegen.sub_patterns(mut g, name, args, v, true) {\n        codegen.binds(mut g, q, x)\n      }\n    },\n    ast.TuplePat(ps) => match v.ty {\n      TNamed { name: \"Tuple\", args } => {\n        for (k, q) in enumerate(ps) {\n          if codegen.binds_names(q) {\n            x := codegen.field(mut g, v, k, get(args, k) ?? TAny)\n            codegen.binds(mut g, q, x)\n          }\n        }\n      },\n      _ => (),\n    },\n    ast.OrPat(ps) => if codegen.binds_names(p) {\n      // the matching alternative binds them, each to the shared slots\n      done := codegen.label(mut g, \"alt.bound\")\n      g.alts += 1\n      for (k, q) in enumerate(ps) {\n        if k + 1 == len(ps) {\n          codegen.binds(mut g, q, v)\n        } else {\n          next := codegen.label(mut g, \"alt.other\")\n          codegen.matches(mut g, q, v, next)\n          codegen.binds(mut g, q, v)\n          codegen.br(mut g, done)\n          codegen.block(mut g, next)\n        }\n      }\n      g.alts -= 1\n      codegen.br(mut g, done)\n      codegen.block(mut g, done)\n    },\n    ast.ListPat { items, rest } => match v.ty {\n      TList(et) => {\n        for (k, q) in enumerate(items) {\n          if codegen.binds_names(q) {\n            x := codegen.list_at(mut g, v, to_string(k), et)\n            codegen.binds(mut g, q, x)\n          }\n        }\n        match rest {\n          Some(r) => if r != \"_\" {\n            n := codegen.list_len(mut g, v)\n            tail := codegen.slice_raw(mut g, v, to_string(len(items)), n.op)\n            codegen.bind(mut g, r, tail)\n          },\n          None => (),\n        }\n      },\n      _ => (),\n    },\n    _ => (),\n  }\n}"},{"name":"codegen.sub_patterns","kind":"fn","old":"b904fa03f0e58ffc","new":"012169afe6450096","interface_changed":false,"affected":[],"module":"codegen","text":"/// A constructor pattern's sub-patterns with their fields. With `naming`,\n/// those that bind names; else those that test something (neither `_` nor\n/// a name). No field is read for nothing.\nfn sub_patterns(\n  mut g: codegen.Gen,\n  c: String,\n  args: ast.CtorPat,\n  v: codegen.V,\n  naming: Bool,\n) -> List[(codegen.V, ast.Pattern)] {\n  fs := codegen.fields_of(g, c, v.ty)\n  mut out := []\n  match args {\n    ast.NoPats => (),\n    ast.PositionalPats(ps) => {\n      for (k, q) in enumerate(ps) {\n        if codegen.sub_wanted(q, naming) {\n          mut out.push(\n            (codegen.field(\n              mut g,\n              v,\n              k,\n              (get(fs, k) ?? (\"\", check.TAny)).1,\n            ), q),\n          )\n        }\n      }\n    },\n    ast.RecordPats { fields, .. } => {\n      for (n, q) in fields {\n        mut at := -1\n        for (k, x) in enumerate(fs) {\n          if x.0 == n {\n            at = k\n          }\n        }\n        if codegen.sub_wanted(q, naming) {\n          mut out.push(\n            (codegen.field(\n              mut g,\n              v,\n              at,\n              (get(fs, at) ?? (\"\", check.TAny)).1,\n            ), q),\n          )\n        }\n      }\n    },\n    _ => codegen.not_yet(mut g, \"the pattern `\" + c + \"(...)`\"),\n  }\n  out\n}","old_text":"/// A constructor pattern's sub-patterns with their fields. With `naming`,\n/// those that bind names; else those that test something (neither `_` nor\n/// a name). No field is read for nothing.\nfn sub_patterns(\n  mut g: codegen.Gen,\n  c: String,\n  args: ast.CtorPat,\n  v: codegen.V,\n  naming: Bool,\n) -> List[(codegen.V, ast.Pattern)] {\n  fs := codegen.fields_of(g, c, v.ty)\n  mut out := []\n  match args {\n    ast.NoPats => (),\n    ast.PositionalPats(ps) => {\n      for (k, q) in enumerate(ps) {\n        if codegen.sub_wanted(q, naming) {\n          mut out.push(\n            (\n              codegen.field(\n                mut g,\n                v,\n                k,\n                (get(fs, k) ?? (\"\", TAny)).1,\n              ),\n              q,\n            ),\n          )\n        }\n      }\n    },\n    ast.RecordPats { fields, .. } => {\n      for (n, q) in fields {\n        mut at := -1\n        for (k, x) in enumerate(fs) {\n          if x.0 == n {\n            at = k\n          }\n        }\n        if codegen.sub_wanted(q, naming) {\n          mut out.push(\n            (codegen.field(\n              mut g,\n              v,\n              at,\n              (get(fs, at) ?? (\"\", TAny)).1,\n            ), q),\n          )\n        }\n      }\n    },\n    _ => codegen.not_yet(mut g, \"the pattern `\" + c + \"(...)`\"),\n  }\n  out\n}"},{"name":"codegen.elements_kind","kind":"fn","old":"5190121897f4c917","new":"efc4bab0170a8f44","interface_changed":true,"affected":["codegen.apply","codegen.list_builtin","codegen.collection_builtin","codegen.await_list","codegen.gen_list","codegen.table_from","codegen.set_copy","codegen.appended","codegen.push_in_place","codegen.binary","codegen.number_