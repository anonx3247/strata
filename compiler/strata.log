verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.helper","codegen.debug_body","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.equal","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.read_back","eval_files","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// `scope { … }`: its tasks end before it does.\nfn scope_expr(mut g: codegen.Gen, b: ast.Expr, want: check.Ty) -> codegen.V {\n  codegen.use_rt(mut g, \"strata_scope_begin\")\n  codegen.use_rt(mut g, \"strata_scope_end\")\n  s := codegen.fresh(mut g, \"tasks\")\n  codegen.emit(mut g, f\"{s} = call ptr @strata_scope_begin()\")\n  codegen.push_scope(mut g)\n  k := len(g.scopes) - 1\n  sc := get(g.scopes, k) ?? codegen.no_scope()\n  codegen.set_scope(mut g, k, codegen.Scope { ..sc, tasks: s })\n  v0 := codegen.expr_want(mut g, b, want)\n  // `scope { …; spawn e }` is `()`: a handle is not counted\n  v := if codegen.ends_in_spawn(b) && !(v0.ty is check.TAny) {\n    codegen.unit()\n  } else {\n    v0\n  }\n  x := codegen.leave_branch(mut g, v)\n  r := codegen.temp(mut g, x)\n  // a task in it may have panicked inside a supervised one: then this one\n  // leaves\n  codegen.cancel_point(mut g)\n  r\n}","old_text":"/// `scope { … }`: its tasks end before it does.\nfn scope_expr(mut g: codegen.Gen, b: ast.Expr, want: Ty) -> codegen.V {\n  codegen.use_rt(mut g, \"strata_scope_begin\")\n  codegen.use_rt(mut g, \"strata_scope_end\")\n  s := codegen.fresh(mut g, \"tasks\")\n  codegen.emit(mut g, f\"{s} = call ptr @strata_scope_begin()\")\n  codegen.push_scope(mut g)\n  k := len(g.scopes) - 1\n  sc := get(g.scopes, k) ?? codegen.no_scope()\n  codegen.set_scope(mut g, k, codegen.Scope { ..sc, tasks: s })\n  v0 := codegen.expr_want(mut g, b, want)\n  // `scope { …; spawn e }` is `()`: a handle is not counted\n  v := if codegen.ends_in_spawn(b) && !(v0.ty is TAny) {\n    codegen.unit()\n  } else {\n    v0\n  }\n  x := codegen.leave_branch(mut g, v)\n  r := codegen.temp(mut g, x)\n  // a task in it may have panicked inside a supervised one: then this one\n  // leaves\n  codegen.cancel_point(mut g)\n  r\n}"},{"name":"codegen.spawn_expr","kind":"fn","old":"405b82777713ff09","new":"0559627962320c8c","interface_changed":false,"affected":[],"module":"codegen","text":"/// `spawn e` and `spawn supervised e`: `e` as a closure with no parameters,\n/// marked shared between threads with what it captures (`share_value`),\n/// started as a task of the innermost scope. Gives its handle. A supervised\n/// task's result is `Ok(v)` or `Err(Panic { … })`.\nfn spawn_expr(\n  mut g: codegen.Gen,\n  body: ast.Expr,\n  supervised: Bool,\n) -> codegen.V {\n  // each captured sender is copied for the task, which closes it\n  mut senders := []\n  for x in codegen.names_in(body, Set[String] {}) {\n    match codegen.lookup(g, x) {\n      Some(l) => match l.ty {\n        check.TNamed { name: \"Sender\", .. } => mut senders.push(codegen.load(mut g, l)),\n        _ => (),\n      },\n      None => (),\n    }\n  }\n  shares := codegen.fresh(mut g, \"shares\")\n  n := len(senders)\n  room := if n > 0 {\n    n\n  } else {\n    1\n  }\n  mut g.allocas.push(f\"  {shares} = alloca [{room} x ptr]\")\n  for (i, s) in enumerate(senders) {\n    p := codegen.fresh(mut g, \"share\")\n    codegen.emit(\n      mut g,\n      f\"{p} = getelementptr ptr, ptr {shares}, i64 {i}\",\n    )\n    codegen.emit(mut g, f\"store ptr {s.op}, ptr {p}\")\n  }\n  clo0 := codegen.lambda(\n    mut g,\n    [],\n    body,\n    check.TFn { params: [], ret: check.TAny },\n  )\n  rt := match clo0.ty {\n    check.TFn { ret, .. } => ret,\n    _ => return codegen.never(),\n  }\n  clo := codegen.take_value(mut g, clo0)\n  // (the closure, and what it captured, cross to the task's thread)\n  codegen.share_value(mut g, clo)\n  (run, drop, fail, result) := if supervised {\n    (r, d, f) := codegen.supervised_fns(mut g, rt)\n    (\n      r,\n      d,\n      f,\n      check.TNamed {\n        name: \"Result\",\n        args: [rt, codegen.panic_ty()],\n      },\n    )\n  } else {\n    (r, d) := codegen.task_fns(mut g, rt)\n    (r, d, \"null\", rt)\n  }\n  codegen.use_rt(mut g, \"strata_spawn_shared\")\n  h := codegen.fresh(mut g, \"task\")\n  codegen.emit(\n    mut g,\n    f\"{h} = call ptr @strata_spawn_shared(ptr {clo.op}, ptr {run}, ptr {drop}, ptr {fail}, ptr {shares}, i64 {n})\",\n  )\n  codegen.V {\n    ty: check.TNamed { name: \"Task\", args: [result] },\n    op: h,\n  }\n}","old_text":"/// `spawn e` and `spawn supervised e`: `e` as a closure with no parameters,\n/// marked shared between threads with what it captures (`share_value`),\n/// started as a task of the innermost scope. Gives its handle. A supervised\n/// task's result is `Ok(v)` or `Err(Panic { … })`.\nfn spawn_expr(\n  mut g: codegen.Gen,\n  body: ast.Expr,\n  supervised: Bool,\n) -> codegen.V {\n  // each captured sender is copied for the task, which closes it\n  mut senders := []\n  for x in codegen.names_in(body, Set[String] {}) {\n    match codegen.lookup(g, x) {\n      Some(l) => match l.ty {\n        TNamed { name: \"Sender\", .. } => mut senders.push(codegen.load(mut g, l)),\n        _ => (),\n      },\n      None => (),\n    }\n  }\n  shares := codegen.fresh(mut g, \"shares\")\n  n := len(senders)\n  room := if n > 0 {\n    n\n  } else {\n    1\n  }\n  mut g.allocas.push(f\"  {shares} = alloca [{room} x ptr]\")\n  for (i, s) in enumerate(senders) {\n    p := codegen.fresh(mut g, \"share\")\n    codegen.emit(\n      mut g,\n      f\"{p} = getelementptr ptr, ptr {shares}, i64 {i}\",\n    )\n    codegen.emit(mut g, f\"store ptr {s.op}, ptr {p}\")\n  }\n  clo0 := codegen.lambda(mut g, [], body, TFn { params: [], ret: TAny })\n  rt := match clo0.ty {\n    TFn { ret, .. } => ret,\n    _ => return codegen.never(),\n  }\n  clo := codegen.take_value(mut g, clo0)\n  // (the closure, and what it captured, cross to the task's thread)\n  codegen.share_value(mut g, clo)\n  (run, drop, fail, result) := if supervised {\n    (r, d, f) := codegen.supervised_fns(mut g, rt)\n    (\n      r,\n      d,\n      f,\n      TNamed { name: \"Result\", args: [rt, codegen.panic_ty()] },\n    )\n  } else {\n    (r, d) := codegen.task_fns(mut g, rt)\n    (r, d, \"null\", rt)\n  }\n  codegen.use_rt(mut g, \"strata_spawn_shared\")\n  h := codegen.fresh(mut g, \"task\")\n  codegen.emit(\n    mut g,\n    f\"{h} = call ptr @strata_spawn_shared(ptr {clo.op}, ptr {run}, ptr {drop}, ptr {fail}, ptr {shares}, i64 {n})\",\n  )\n  codegen.V { ty: TNamed { name: \"Task\", args: [result] }, op: h }\n}"},{"name":"codegen.panic_ty","kind":"fn","old":"7a3b835901200477","new":"721792d77cde183d","interface_changed":true,"affected":["codegen.spawn_expr","codegen.supervised_fns","codegen.race_expr","codegen.expr_node","codegen.expr","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.method_call","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.moc