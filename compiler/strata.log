s -> (s.name, \"verify-strata/graphs/\"\n      + cache.entry_key(\"graph-site\", [\n        solver,\n        site_inputs(deps, texts, impls, store.qname(s.decl)),\n        text.decl_text(s.decl),\n        s.label,\n      ])),\n  ))\n  key := (s: graph.Site) -> get(keys, s.name) ?? s.name\n  // the answers with what runs showed\n  run_key := (s: graph.Site) -> key(s) + \"-runs\"\n  timings.end(\"graph keys\")\n  reuse := cache.caching() && solver != \"\"\n  mut edges := []\n  mut skipped := []\n  // the solver's answers, from the cache or asked now, before any run\n  mut answered := []\n  mut todo := []\n  for s in sites {\n    match if reuse && runs {\n      cache.read_entry(disk, cache, run_key(s))\n    } else {\n      None\n    } {\n      Some(text) => {\n        (es, why) := site_of_text(s.label, text)\n        edges += es\n        skipped += why\n      },\n      None => match if reuse {\n        cache.read_entry(disk, cache, key(s))\n      } else {\n        None\n      } {\n        Some(text) => {\n          (es, why) := site_of_text(s.label, text)\n          mut answered.push((s, es, why))\n        },\n        None => mut todo.push(s),\n      },\n    }\n  }\n  if todo != [] {\n    if solver == \"\" {\n      return Err(\"no solver (z3) found: the moves can't be asked\")\n    }\n    timings.begin(\"graph prepare\")\n    (own, fns, types, sigs, all_methods) := verified_decls(\n      disk,\n      \"std\",\n      [file],\n      stored + todo.map(s -> s.decl),\n    )\n    scratch := cache.smt\n    cache.make_dirs(mut disk, scratch)\n    names := set(todo.map(s -> s.name))\n    made := own.filter(\n      d -> match d.kind {\n        ast.FnDef(f) => contains(names, f.name),\n        _ => false,\n      },\n    )\n    ctx := termination.context(\n      fns,\n      types,\n      sigs,\n      all_methods,\n      scratch,\n      solver,\n    )\n    methods := termination.seen_through(ctx, termination.analyze(\n      mut launcher,\n      mut disk,\n      ctx,\n      Some(set(shown_names(ctx, made))),\n    ))\n    timings.end(\"graph prepare\")\n    for s in todo {\n      found := made.filter(\n        d -> match d.kind {\n          ast.FnDef(f) => f.name == s.name,\n          _ => false,\n        },\n      )\n      (es, why) := match get(found, 0) {\n        Some(ast.Decl { kind: ast.FnDef(f), module, .. }) => {\n          label := if module == \"\" {\n            f.name\n          } else {\n            module + \".\" + f.name\n          }\n          timings.begin(\"graph encode\")\n          vc := smt.encode(\n            mut launcher,\n            mut disk,\n            scratch,\n            solver,\n            fns,\n            types,\n            sigs,\n            methods,\n            f,\n            label,\n          )\n          timings.end(\"graph encode\")\n          match get(vc.gaps, 0) {\n            Some(gap) => (\n              [],\n              [(s.label, \"not covered by compiler/smt yet: \" + gap)],\n            ),\n            None => if len(f.post) != len(s.queries) {\n              ([], [(\n                s.label,\n                \"its questions changed on the way to the solver\",\n              )])\n            } else {\n              timings.begin(\"graph answers\")\n              answers := graph_answers(\n                mut launcher,\n                mut disk,\n                scratch,\n                solver,\n                vc,\n              )\n              timings.end(\"graph answers\")\n              // a model is a move only when the encoding is exact: no loop (its turns\n              // stand for any), nothing the solver was left to choose (a gap, a function\n              // known by its contract). A trait's method is what its contract says (a\n              // model is a move of some implementation).\n              exact := !graph.loops_in(s)\n                && values(vc.reasons).all(\n                  r -> starts_with(r, \"values of the generic type\")\n                    || starts_with(r, \"the result of `\")\n                      && contains(r, \"::\")\n                      && ends_with(r, \"(only its contract is known)\"),\n                )\n              (graph.edges_of(\n                s,\n                f.post.map(graph.ensures_text),\n                if exact {\n                  answers\n                } else {\n                  answers.map(\n                    a -> if starts_with(a, \"refuted \") {\n                      \"unknown \" + drop_bytes(a, 8)\n                    } else {\n                      a\n                    },\n                  )\n                },\n              ), [])\n            },\n          }\n        },\n        _ => ([], [(s.label, \"it could not be prepared for the solver\")]),\n      }\n      // kept at once: a run stopped later keeps what was asked\n      if reuse {\n        _ := cache.write_entry(\n          mut disk,\n          cache,\n          key(s),\n          site_text(es, why),\n        )\n      }\n      mut answered.push((s, es, why))\n    }\n  }\n  // what the solver left unknown, run: a run that makes a move shows it\n  // possible\n  unknown := answered\n    .filter(a -> a.1.any(e -> e.verdict == \"unknown\"))\n    .map(a -> a.0)\n  ran := if runs && unknown != [] {\n    graph_runs(\n      disk,\n      cache,\n      std_loaded(std_library(mut console, mut disk, process, cache)),\n      file,\n      unknown,\n    )\n  } else {\n    Dict[String, List[Bool]] {}\n  }\n  for (s, es0, why) in answered {\n    es := match get(ran, s.name) {\n      Some(flags) => graph.with_runs(es0, flags),\n      None => es0,\n    }\n    if reuse && runs {\n      _ := cache.write_entry(\n        mut disk,\n        cache,\n        run_key(s),\n        site_text(es, why),\n      )\n    }\n    edges += es\n    skipped += why\n  }\n  moved := graph.resolved(subject, edges + pl.fixed, pl.vias)\n  Ok(graph.Graph { subject, edges: graph.merged(moved), skipped })\n}"},{"name":"index_of_site","kind":"fn","old":null,"new":"62137c2da14a1c67","interface_changed":true,"affected":[],"module":"","text":"/// Where `name` is in `names` (`-1`: nowhere).\nfn index_of_site(names: List[String], name: String) -> Int {\n  for (k, n) in enumerate(names) {\n    if n == name {\n      return k\n    }\n  }\n  -1\n}"},{"name":"graph_answers_all","kind":"fn","old":null,"new":"39cb65a743485b1e","interface_changed":true,"affected":[],"module":"","text":"/// The solver's answer to each obligation of each of `vcs`, as `solve`\n/// gives them (`proven …`, `refuted …`, `unknown …`), except that a model is\n/// enough for `refuted`: a move is possible when some values make it,\n/// whether or not they can be shown (a type parameter's can't).\n/// \n/// The scripts are written on worker threads and run together\n/// (`run_scripts`): first each function's batch, then each question a\n/// batch didn't answer, alone with the same budget. In a batch, the\n/// solver's state from earlier questions can make one cost several times\n/// what it costs alone (`cancel`'s `Pending -> Cancelled` in\n/// examples/orders.strata).\nfn graph_answers_all(\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  scratch: String,\n  solver: String,\n  vcs: List[smt.Vc],\n) -> List[List[String]] {\n  mixes := parallel.map(vcs, vc -> smt.sort_mixes(vc))\n  batches := parallel.map(\n    vcs.filter(vc -> len(vc.obligations) > 0),\n    vc -> (smt.batch(vc), [\"-t:20000\", \"rlimit=2000000\"]),\n  )\n  outs := smt.run_scripts(mut launcher, mut disk, scratch, solver, batches)\n  // each function's first lines, by obligation\n  mut firsts := []\n  mut b := 0\n  for vc in vcs {\n    if len(vc.obligations) > 0 {\n      got := get(outs, b) ?? []\n      b += 1\n      mut firsts.push(got.map(o -> trim(get(lines(o), 0) ?? \"\")))\n    } else {\n      mut firsts.push([])\n    }\n  }\n  mut again := []\n  for (k, vc) in enumerate(vcs) {\n    fk := get(firsts, k) ?? []\n    for i in range(0, len(vc.obligations)) {\n      first := get(fk, i) ?? \"\"\n      if first != \"sat\" && first != \"unsat\" {\n        mut again.push((k, i, vc))\n      }\n    }\n  }\n  singles := parallel.map(\n    again,\n    x -> (smt.single(x.2, x.1), [\"-T:20\", \"rlimit=2000000\"]),\n  )\n  alone := smt.run_scripts(mut launcher, mut disk, scratch, solver, singles)\n  mut retried := Dict[String, String] {}\n  for (j, x) in enumerate(again) {\n    mut retried.insert(\n      f\"{x.0} {x.1}\",\n      trim(get(lines(get(get(alone, j) ?? [], 0) ?? \"\"), 0) ?? \"\"),\n    )\n  }\n  mut all := []\n  for (k, vc) in enumerate(vcs) {\n    fk := get(firsts, k) ?? []\n    mk := get(mixes, k) ?? Dict[Int, String] {}\n    mut out := []\n    for (i, ob) in enumerate(vc.obligations) {\n      first := get(retried, f\"{k} {i}\") ?? get(fk, i) ?? \"\"\n      word := if contains(mk, i) {\n        \"unknown\"\n      } else {\n        match first {\n          \"unsat\" => \"proven\",\n          \"sat\" => \"refuted\",\n          _ => \"unknown\",\n        }\n      }\n      mut out.push(word + \" \" + ob.what)\n    }\n    mut all.push(out + vc.given.map(g -> \"proven \" + g))\n  }\n  all\n}"},{"name":"graph_answers","kind":"fn","old":"b63cf63417c79c39","new":null,"interface_changed":true,"affected":[],"module":"","old_text":"/// The solver's answer to each obligation of `vc`, as `solve` gives them\n/// (`proven …`, `refuted …`, `unknown …`), except that a model is enough\n/// for `refuted`: a move is possible when some values make it, whether or\n/// not they can be shown (a type parameter's can't).\n/// \n/// A question the batch left unknown is asked again alone, with the same\n/// budget. In a batch, the solver's state from earlier questions can make\n/// one cost several times what it costs alone (`cancel`'s `Pending ->\n/// Cancelled` in examples/orders.strata).\nfn graph_answers(\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  scratch: String,\n  solver: String,\n  vc: smt.Vc,\n) -> List[String] {\n  n := len(vc.obligations)\n  mut outs := if n > 0 {\n    smt.run_script(\n      mut launcher,\n      mut disk,\n      scratch,\n      solver,\n      timings.timed(\"graph script\", () -> smt.batch(vc)),\n      [\"-t:20000\", \"rlimit=2000000\"],\n    )\n  } else {\n    []\n  }\n  while n > 0 && len(outs) < n {\n    one := smt.run_script(\n      mut launcher,\n      mut disk,\n      scratch,\n      solver,\n      timings.timed(\"graph script\", () -> smt.single(vc, len(outs))),\n      [\"-T:20\", \"rlimit=2000000\"],\n    )\n    mut outs.push(get(one, 0) ?? \"\")\n  }\n  mixes := timings.timed(\"graph mixes\", () -> smt.sort_mixes(vc))\n  mut out := []\n  for (i, ob) in enumerate(vc.obligations) {\n    mut first := trim(get(lines(get(outs, i) ?? \"\"), 0) ?? \"\")\n    if first != \"sat\" && first != \"unsat\" {\n      one := smt.run_script(\n        mut launcher,\n        mut disk,\n        scratch,\n        solver,\n        timings.timed(\"graph script\", () -> smt.single(vc, i)),\n        [\"-T:20\", \"rlimit=2000000\"],\n      )\n      first = trim(get(lines(get(one, 0) ?? \"\"), 0) ?? \"\")\n    }\n    word := if contains(mixes, i) {\n      \"unknown\"\n    } else {\n      match first {\n        \"unsat\" => \"proven\",\n        \"sat\" => \"refuted\",\n        _ => \"unknown\",\n      }\n    }\n    mut out.push(word + \" \" + ob.what)\n  }\n  out + vc.given.map(g -> \"proven \" + g)\n}"}]}
{"id":"d0f4d83f85a3ded6","time":1795703746,"message":"edit","changes":[{"name":"smt.cone_with","kind":"fn","old":"1fe7a5a1dcd3d83a","new":"816d20c42864cd98","interface_changed":false,"affected":[],"module":"smt","text":"/// `cone`, with `extra` facts.\nfn cone_with(\n  vc: smt.Vc,\n  ob: smt.Obligation,\n  seeds: List[String],\n  extra: List[String],\n) -> (List[String], Set[String]) {\n  // a proof's step (`small_goal`): its cone is its goal's and path's,\n  // without the parameters' (`seeds`, declared all the same), and its\n  // paths are names defined without the checks on them (`small_path_def`)\n  small := ob.first_fact > 0 && ob.first_fact == ob.facts\n  defs := if small {\n    vc.defs.filter(d -> !contains(vc.path_defs, d))\n      + items(vc.path_prev).map(\n        kp -> smt.small_path_def(kp.0, kp.1.0, kp.1.1),\n      )\n  } else {\n    vc.defs\n  }\n  facts := defs\n    + drop(take(vc.facts, ob.facts), ob.first_fact)\n    + ob.own\n    + extra\n  mut seen := set(smt.consts_in(ob.goal))\n  for p in if small {\n    ob.pc\n  } else {\n    ob.pc + seeds\n  } {\n    for c in smt.consts_in(p) {\n      mut seen.insert(c)\n    }\n  }\n  fact_consts := facts.map(f -> smt.consts_in(f))\n  mut used := Set[Int] {}\n  mut changed := true\n  while changed {\n    changed = false\n    for (i, fc) in enumerate(fact_consts) {\n      if !contains(used, i) && fc.any(c -> contains(seen, c)) {\n        mut used.insert(i)\n        changed = true\n        for c in fc {\n          mut seen.insert(c)\n        }\n      }\n    }\n  }\n  mut kept := []\n  for (i, f) in enumerate(facts) {\n    if contains(used, i) {\n      mut kept.push(f)\n    }\n  }\n  if small {\n    for p in seeds {\n      for c in smt.consts_in(p) {\n        mut seen.insert(c)\n      }\n    }\n  }\n  (kept, seen)\n}","old_text":"/// `cone`, with `extra` facts.\nfn cone_with(\n  vc: smt.Vc,\n  ob: smt.Obligation,\n  seeds: List[String],\n  extra: List[String],\n) -> (List[String], Set[String]) {\n  // a proof's step (`small_goal`): its cone is its goal's and path's,\n  // without the parameters' (`seeds`, declared all the same), and its\n  // paths are names defined without the checks on them (`small_path_def`)\n  small := ob.first_fact > 0 && ob.first_fact == ob.facts\n  defs := if small {\n    vc.defs.filter(d -> !contains(vc.path_defs, d))\n      + items(vc.path_prev).map(\n        kp -> smt.small_path_def(kp.0, kp.1.0, kp.1.1),\n      )\n  } else {\n    vc.defs\n  }\n  facts := defs\n    + drop(take(vc.facts, ob.facts), ob.first_fact)\n    + ob.own\n    + extra\n  mut seen := set(smt.consts_in(ob.goal))\n  for p in if small {\n    ob.pc\n  } else {\n    ob.pc + seeds\n  } {\n    for c in smt.consts_in(p) {\n      mut seen.insert(c)\n    }\n  }\n  fact_consts := facts.map(f -> smt.consts_in(f))\n  mut used := facts.map(_ -> false)\n  mut changed := true\n  while changed {\n    changed = false\n    for (i, fc) in enumerate(fact_consts) {\n      if !(get(used, i) ?? true) && fc.any(c -> contains(seen, c)) {\n        used = take(used, i) + [true] + drop(used, i + 1)\n        changed = true\n        for c in fc {\n          mut seen.insert(c)\n        }\n      }\n    }\n  }\n  mut kept := []\n  for (i, f) in enumerate(facts) {\n    if get(used, i) ?? false {\n      mut kept.push(f)\n    }\n  }\n  if small {\n    for p in seeds {\n      for c in smt.consts_in(p) {\n        mut seen.insert(c)\n      }\n    }\n  }\n  (kept, seen)\n}"}]}
{"id":"4e007f82afd7956c","time":1795703760,"message":"edit","changes":[{"name":"static_graph","kind":"fn","old":"83d9f72f76f1f52a","new":"e1bf2210ae48445d","interface_changed":false,"affected":[],"module":"","text":"/// The graph of `subject` in the program `stored` (the definitions `file`\n/// holds, or held). Each site's questions (compiler/graph's `plan`) are\n/// encoded by compiler/smt as `ensures` of a copy of the function and given\n/// to the solver. Each site's answers are cached under the program's text\n/// and the copy's (`graph-site`), so only what changed is asked again.\n/// Adds the moves the bodies' shape settles and those that follow calls\n/// (`resolved`). With `runs` (`stored` being what `file` holds), what the\n/// solver leaves unknown is run on generated inputs too (`graph_runs`,\n/// with std's library).\n/// \n/// A site's cache key is its copy and the definitions the copy reaches\n/// (`site_inputs`), not the whole program: in a diff, or after an edit,\n/// only the functions whose code or dependencies changed are asked again.\n/// The solver's answers are kept apart from what runs added to them, so\n/// `view --graph` (with runs) and `diff --graph` (without) share them.\nfn static_graph(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  cache: cache.Cache,\n  file: String,\n  stored: List[ast.Decl],\n  subject: graph.Subject,\n  runs: Bool,\n) -> Result[graph.Graph, String] {\n  home := match home_found(disk, process) {\n    Some(h) => h,\n    None => return Err(\n      \"can't find Strata's home (a folder holding core/, std/ and runtime/prelude.strata): set STRATA_HOME\",\n    ),\n  }\n  if driver_chdir(home).to_int() != 0 {\n    return Err(f\"can't enter {home}\")\n  }\n  solver := toolchain.solver(disk, process)\n  pl := timings.timed(\"graph plan\", () -> graph.plan(stored, subject))\n  sites := pl.sites\n  timings.begin(\"graph keys\")\n  deps := store.graph(stored + sites.map(s -> s.decl), false)\n  mut texts := Dict[String, String] {}\n  mut impls := []\n  for d in stored {\n    n := store.qname(d)\n    mut texts.insert(n, text.decl_text(d))\n    if d.kind is ast.ImplDef {\n      mut impls.push(n)\n    }\n  }\n  keys := dict(sites.map(\n    s -> (s.name, \"verify-strata/graphs/\"\n      + cache.entry_key(\"graph-site\", [\n        solver,\n        site_inputs(deps, texts, impls, store.qname(s.decl)),\n        text.decl_text(s.decl),\n        s.label,\n      ])),\n  ))\n  key := (s: graph.Site) -> get(keys, s.name) ?? s.name\n  // the answers with what runs showed\n  run_key := (s: graph.Site) -> key(s) + \"-runs\"\n  timings.end(\"graph keys\")\n  reuse := cache.caching() && solver != \"\"\n  mut edges := []\n  mut skipped := []\n  // the solver's answers, from the cache or asked now, before any run\n  mut answered := []\n  mut todo := []\n  for s in sites {\n    match if reuse && runs {\n      cache.read_entry(disk, cache, run_key(s))\n    } else {\n      None\n    } {\n      Some(text) => {\n        (es, why) := site_of_text(s.label, text)\n        edges += es\n        skipped += why\n      },\n      None => match if reuse {\n        cache.read_entry(disk, cache, key(s))\n      } else {\n        None\n      } {\n        Some(text) => {\n          (es, why) := site_of_text(s.label, text)\n          mut answered.push((s, es, why))\n        },\n        None => mut todo.push(s),\n      },\n    }\n  }\n  if todo != [] {\n    if solver == \"\" {\n      return Err(\"no solver (z3) found: the moves can't be asked\")\n    }\n    timings.begin(\"graph prepare\")\n    (own, fns, types, sigs, all_methods) := verified_decls(\n      disk,\n      \"std\",\n      [file],\n      stored + todo.map(s -> s.decl),\n    )\n    scratch := cache.smt\n    cache.make_dirs(mut disk, scratch)\n    names := set(todo.map(s -> s.name))\n    made := own.filter(\n      d -> match d.kind {\n        ast.FnDef(f) => contains(names, f.name),\n        _ => false,\n      },\n    )\n    ctx := termination.context(\n      fns,\n      types,\n      sigs,\n      all_methods,\n      scratch,\n      solver,\n    )\n    methods := termination.seen_through(ctx, termination.analyze(\n      mut launcher,\n      mut disk,\n      ctx,\n      Some(set(shown_names(ctx, made))),\n    ))\n    timings.end(\"graph prepare\")\n    // each site's copy, with its label, or why it can't be asked\n    mut fs := []\n    mut ready := []\n    for s in todo {\n      found := made.filter(\n        d -> match d.kind {\n          ast.FnDef(f) => f.name == s.name,\n          _ => false,\n        },\n      )\n      match get(found, 0) {\n        Some(ast.Decl { kind: ast.FnDef(f), module, .. }) => {\n          label := if module == \"\" {\n            f.name\n          } else {\n            module + \".\" + f.name\n          }\n          mut fs.push((f, label))\n          mut ready.push(s)\n        },\n        _ => {\n          why := [(s.label, \"it could not be prepared for the solver\")]\n          if reuse {\n            _ := cache.write_entry(\n              mut disk,\n              cache,\n              key(s),\n              site_text([], why),\n            )\n          }\n          mut answered.push((s, [], why))\n        },\n      }\n    }\n    // encoded on worker threads, and every site's questions asked together\n    timings.begin(\"graph encode\")\n    vcs := smt.encode_all(\n      mut launcher,\n      mut disk,\n      scratch,\n      solver,\n      fns,\n      types,\n      sigs,\n      methods,\n      fs,\n    )\n    timings.end(\"graph encode\")\n    mut asked := []\n    for (k, s) in enumerate(ready) {\n      match (get(vcs, k), get(fs, k)) {\n        (Some(vc), Some((f, _))) => if vc.gaps == [] && len(f.post) == len(s.queries) {\n          mut asked.push((s, f, vc))\n        },\n        _ => (),\n      }\n    }\n    timings.begin(\"graph answers\")\n    replies := graph_answers_all(\n      mut launcher,\n      mut disk,\n      scratch,\n      solver,\n      asked.map(a -> a.2),\n    )\n    timings.end(\"graph answers\")\n    for (k, s) in enumerate(ready) {\n      // one per site asked (`STRATA_TIMINGS=1` counts them)\n      timings.begin(\"graph: site asked\")\n      (es, why) := match (get(vcs, k), get(fs, k)) {\n        (Some(vc), Some((f, _))) => match get(vc.gaps, 0) {\n          Some(gap) => (\n            [],\n            [(s.label, \"not covered by compiler/smt yet: \" + gap)],\n          ),\n          None => if len(f.post) != len(s.queries) {\n            ([], [(\n              s.label,\n              \"its questions changed on the way to the solver\",\n            )])\n          } else {\n            at := index_of_site(asked.map(a -> a.0.name), s.name)\n            answers := get(replies, at) ?? []\n            // a model is a move only when the encoding is exact: no loop (its turns\n            // stand for any), nothing the solver was left to choose (a gap, a function\n            // known by its contract). A trait's method is what its contract says (a\n            // model is a move of some implementation).\n            exact := !graph.loops_in(s)\n              && values(vc.reasons).all(\n                r -> starts_with(r, \"values of the generic type\")\n                  || starts_with(r, \"the result of `\")\n                    && contains(r, \"::\")\n                    && ends_with(r, \"(only its contract is known)\"),\n              )\n            (graph.edges_of(\n              s,\n              f.post.map(graph.ensures_text),\n              if exact {\n                answers\n              } else {\n                answers.map(\n                  a -> if starts_with(a, \"refuted \") {\n                    \"unknown \" + drop_bytes(a, 8)\n                  } else {\n                    a\n                  },\n                )\n              },\n            ), [])\n          },\n        },\n        _ => ([], [(s.label, \"it could not be prepared for the solver\")]),\n      }\n      // kept at once: a run stopped later keeps what was asked\n      if reuse {\n        _ := cache.write_entry(\n          mut disk,\n          cache,\n          key(s),\n          site_text(es, why),\n        )\n      }\n      mut answered.push((s, es, why))\n      timings.end(\"graph: site asked\")\n    }\n  }\n  // what the solver left unknown, run: a run that makes a move shows it\n  // possible\n  unknown := answered\n    .filter(a -> a.1.any(e -> e.verdict == \"unknown\"))\n    .map(a -> a.0)\n  ran := if runs && unknown != [] {\n    graph_runs(\n      disk,\n      cache,\n      std_loaded(std_library(mut console, mut disk, process, cache)),\n      file,\n      unknown,\n    )\n  } else {\n    Dict[String, List[Bool]] {}\n  }\n  for (s, es0, why) in answered {\n    es := match get(ran, s.name) {\n      Some(flags) => graph.with_runs(es0, flags),\n      None => es0,\n    }\n    if reuse && runs {\n      _ := cache.write_entry(\n        mut disk,\n        cache,\n        run_key(s),\n        site_text(es, why),\n      )\n    }\n    edges += es\n    skipped += why\n  }\n  moved := graph.resolved(subject, edges + pl.fixed, pl.vias)\n  Ok(graph.Graph { subject, edges: graph.merged(moved), skipped })\n}","old_text":"/// The graph of `subject` in the program `stored` (the definitions `file`\n/// holds, or held). Each site's questions (compiler/graph's `plan`) are\n/// encoded by compiler/smt as `ensures` of a copy of the function and given\n/// to the solver. Each site's answers are cached under the program's text\n/// and the copy's (`graph-site`), so only what changed is asked again.\n/// Adds the moves the bodies' shape settles and those that follow calls\n/// (`resolved`). With `runs` (`stored` being what `file` holds), what the\n/// solver leaves unknown is run on generated inputs too (`graph_runs`,\n/// with std's library).\n/// \n/// A site's cache key is its copy and the definitions the copy reaches\n/// (`site_inputs`), not the whole program: in a diff, or after an edit,\n/// only the functions whose code or dependencies changed are asked again.\n/// The solver's answers are kept apart from what runs added to them, so\n/// `view --graph` (with runs) and `diff --graph` (without) share them.\nfn static_graph(\n  mut console: std.io.Console,\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  cache: cache.Cache,\n  file: String,\n  stored: List[ast.Decl],\n  subject: graph.Subject,\n  runs: Bool,\n) -> Result[graph.Graph, String] {\n  home := match home_found(disk, process) {\n    Some(h) => h,\n    None => return Err(\n      \"can't find Strata's home (a folder holding core/, std/ and runtime/prelude.strata): set STRATA_HOME\",\n    ),\n  }\n  if driver_chdir(home).to_int() != 0 {\n    return Err(f\"can't enter {home}\")\n  }\n  solver := toolchain.solver(disk, process)\n  pl := timings.timed(\"graph plan\", () -> graph.plan(stored, subject))\n  sites := pl.sites\n  timings.begin(\"graph keys\")\n  deps := store.graph(stored + sites.map(s -> s.decl), false)\n  mut texts := Dict[String, String] {}\n  mut impls := []\n  for d in stored {\n    n := store.qname(d)\n    mut texts.insert(n, text.decl_text(d))\n    if d.kind is ast.ImplDef {\n      mut impls.push(n)\n    }\n  }\n  keys := dict(sites.map(\n    s -> (s.name, \"verify-strata/graphs/\"\n      + cache.entry_key(\"graph-site\", [\n        solver,\n        site_inputs(deps, texts, impls, store.qname(s.decl)),\n        text.decl_text(s.decl),\n        s.label,\n      ])),\n  ))\n  key := (s: graph.Site) -> get(keys, s.name) ?? s.name\n  // the answers with what runs showed\n  run_key := (s: graph.Site) -> key(s) + \"-runs\"\n  timings.end(\"graph keys\")\n  reuse := cache.caching() && solver != \"\"\n  mut edges := []\n  mut skipped := []\n  // the solver's answers, from the cache or asked now, before any run\n  mut answered := []\n  mut todo := []\n  for s in sites {\n    match if reuse && runs {\n      cache.read_entry(disk, cache, run_key(s))\n    } else {\n      None\n    } {\n      Some(text) => {\n        (es, why) := site_of_text(s.label, text)\n        edges += es\n        skipped += why\n      },\n      None => match if reuse {\n        cache.read_entry(disk, cache, key(s))\n      } else {\n        None\n      } {\n        Some(text) => {\n          (es, why) := site_of_text(s.label, text)\n          mut answered.push((s, es, why))\n        },\n        None => mut todo.push(s),\n      },\n    }\n  }\n  if todo != [] {\n    if solver == \"\" {\n      return Err(\"no solver (z3) found: the moves can't be asked\")\n    }\n    timings.begin(\"graph prepare\")\n    (own, fns, types, sigs, all_methods) := verified_decls(\n      disk,\n      \"std\",\n      [file],\n      stored + todo.map(s -> s.decl),\n    )\n    scratch := cache.smt\n    cache.make_dirs(mut disk, scratch)\n    names := set(todo.map(s -> s.name))\n    made := own.filter(\n      d -> match d.kind {\n        ast.FnDef(f) => contains(names, f.name),\n        _ => false,\n      },\n    )\n    ctx := termination.context(\n      fns,\n      types,\n      sigs,\n      all_methods,\n      scratch,\n      solver,\n    )\n    methods := termination.seen_through(ctx, termination.analyze(\n      mut launcher,\n      mut disk,\n      ctx,\n      Some(set(shown_names(ctx, made))),\n    ))\n    timings.end(\"graph prepare\")\n    // each site's copy, with its label, or why it can't be asked\n    mut fs := []\n    mut ready := []\n    for s in todo {\n      found := made.filter(\n        d -> match d.kind {\n          ast.FnDef(f) => f.name == s.name,\n          _ => false,\n        },\n      )\n      match get(found, 0) {\n        Some(ast.Decl { kind: ast.FnDef(f), module, .. }) => {\n          label := if module == \"\" {\n            f.name\n          } else {\n            module + \".\" + f.name\n          }\n          mut fs.push((f, label))\n          mut ready.push(s)\n        },\n        _ => {\n          why := [(s.label, \"it could not be prepared for the solver\")]\n          if reuse {\n            _ := cache.write_entry(\n              mut disk,\n              cache,\n              key(s),\n              site_text([], why),\n            )\n          }\n          mut answered.push((s, [], why))\n        },\n      }\n    }\n    // encoded on worker threads, and every site's questions asked together\n    timings.begin(\"graph encode\")\n    vcs := smt.encode_all(\n      mut launcher,\n      mut disk,\n      scratch,\n      solver,\n      fns,\n      types,\n      sigs,\n      methods,\n      fs,\n    )\n    timings.end(\"graph encode\")\n    mut asked := []\n    for (k, s) in enumerate(ready) {\n      match (get(vcs, k), get(fs, k)) {\n        (Some(vc), Some((f, _))) => if vc.gaps == [] && len(f.post) == len(s.queries) {\n          mut asked.push((s, f, vc))\n        },\n        _ => (),\n      }\n    }\n    timings.begin(\"graph answers\")\n    replies := graph_answers_all(\n      mut launcher,\n      mut disk,\n      scratch,\n      solver,\n      asked.map(a -> a.2),\n    )\n    timings.end(\"graph answers\")\n    for (k, s) in enumerate(ready) {\n      (es, why) := match (get(vcs, k), get(fs, k)) {\n        (Some(vc), Some((f, _))) => match get(vc.gaps, 0) {\n          Some(gap) => (\n            [],\n            [(s.label, \"not covered by compiler/smt yet: \" + gap)],\n          ),\n          None => if len(f.post) != len(s.queries) {\n            ([], [(\n              s.label,\n              \"its questions changed on the way to the solver\",\n            )])\n          } else {\n            at := index_of_site(asked.map(a -> a.0.name), s.name)\n            answers := get(replies, at) ?? []\n            // a model is a move only when the encoding is exact: no loop (its turns\n            // stand for any), nothing the solver was left to choose (a gap, a function\n            // known by its contract). A trait's method is what its contract says (a\n            // model is a move of some implementation).\n            exact := !graph.loops_in(s)\n              && values(vc.reasons).all(\n                r -> starts_with(r, \"values of the generic type\")\n                  || starts_with(r, \"the result of `\")\n                    && contains(r, \"::\")\n                    && ends_with(r, \"(only its contract is known)\"),\n              )\n            (graph.edges_of(\n              s,\n              f.post.map(graph.ensures_text),\n              if exact {\n                answers\n              } else {\n                answers.map(\n                  a -> if starts_with(a, \"refuted \") {\n                    \"unknown \" + drop_bytes(a, 8)\n                  } else {\n                    a\n                  },\n                )\n              },\n            ), [])\n          },\n        },\n        _ => ([], [(s.label, \"it could not be prepared for the solver\")]),\n      }\n      // kept at once: a run stopped later keeps what was asked\n      if reuse {\n        _ := cache.write_entry(\n          mut disk,\n          cache,\n          key(s),\n          site_text(es, why),\n        )\n      }\n      mut answered.push((s, es, why))\n    }\n  }\n  // what the solver left unknown, run: a run that makes a move shows it\n  // possible\n  unknown := answered\n    .filter(a -> a.1.any(e -> e.verdict == \"unknown\"))\n    .map(a -> a.0)\n  ran := if runs && unknown != [] {\n    graph_runs(\n      disk,\n      cache,\n      std_loaded(std_library(mut console, mut disk, process, cache)),\n      file,\n      unknown,\n    )\n  } else {\n    Dict[String, List[Bool]] {}\n  }\n  for (s, es0, why) in answered {\n    es := match get(ran, s.name) {\n      Some(flags) => graph.with_runs(es0, flags),\n      None => es0,\n    }\n    if reuse && runs {\n      _ := cache.write_entry(\n        mut disk,\n        cache,\n        run_key(s),\n        site_text(es, why),\n      )\n    }\n    edges += es\n    skipped += why\n  }\n  moved := graph.resolved(subject, edges + pl.fixed, pl.vias)\n  Ok(graph.Graph { subject, edges: graph.merged(moved), skipped })\n}"}]}
{"id":"ae0ddd8a02fb007a","time":1795704200,"message":"edit","changes":[{"name":"graph_answers_all","kind":"fn","old":"39cb65a743485b1e","new":"f32a154ffe3adce0","interface_changed":false,"affected":[],"module":"","text":"/// The solver's answer to each obligation of each of `vcs`, as `solve`\n/// gives them (`proven …`, `refuted …`, `unknown …`), except that a model is\n/// enough for `refuted`: a move is possible when some values make it,\n/// whether or not they can be shown (a type parameter's can't).\n/// \n/// Each question is a script of its own, written on worker threads and run\n/// together (`run_scripts`), so no question waits for another. A batch\n/// would answer few of them: in one, the solver's state from earlier\n/// questions can make one cost several times what it costs alone\n/// (`cancel`'s `Pending -> Cancelled` in examples/orders.strata). A\n/// question whose script mixes sorts (`sorts.sort_error`) is unknown: the\n/// solver would reject it.\nfn graph_answers_all(\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  scratch: String,\n  solver: String,\n  vcs: List[smt.Vc],\n) -> List[List[String]] {\n  mut asked := []\n  for (k, vc) in enumerate(vcs) {\n    for i in 0..len(vc.obligations) {\n      mut asked.push((k, i, vc))\n    }\n  }\n  written := parallel.map(asked, x -> {\n    text := smt.single(x.2, x.1)\n    (text, sorts.sort_error(text) is Some)\n  })\n  outs := smt.run_scripts(\n    mut launcher,\n    mut disk,\n    scratch,\n    solver,\n    written.map(w -> (w.0, [\"-T:20\", \"rlimit=2000000\"])),\n  )\n  mut firsts := Dict[String, String] {}\n  for (j, x) in enumerate(asked) {\n    mixed := match get(written, j) {\n      Some(w) => w.1,\n      None => true,\n    }\n    mut firsts.insert(\n      f\"{x.0} {x.1}\",\n      if mixed {\n        \"mixed\"\n      } else {\n        trim(get(lines(get(get(outs, j) ?? [], 0) ?? \"\"), 0) ?? \"\")\n      },\n    )\n  }\n  mut all := []\n  for (k, vc) in enumerate(vcs) {\n    mut out := []\n    for (i, ob) in enumerate(vc.obligations) {\n      word := match get(firsts, f\"{k} {i}\") ?? \"\" {\n        \"unsat\" => \"proven\",\n        \"sat\" => \"refuted\",\n        _ => \"unknown\",\n      }\n      mut out.push(word + \" \" + ob.what)\n    }\n    mut all.push(out + vc.given.map(g -> \"proven \" + g))\n  }\n  all\n}","old_text":"/// The solver's answer to each obligation of each of `vcs`, as `solve`\n/// gives them (`proven …`, `refuted …`, `unknown …`), except that a model is\n/// enough for `refuted`: a move is possible when some values make it,\n/// whether or not they can be shown (a type parameter's can't).\n/// \n/// The scripts are written on worker threads and run together\n/// (`run_scripts`): first each function's batch, then each question a\n/// batch didn't answer, alone with the same budget. In a batch, the\n/// solver's state from earlier questions can make one cost several times\n/// what it costs alone (`cancel`'s `Pending -> Cancelled` in\n/// examples/orders.strata).\nfn graph_answers_all(\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  scratch: String,\n  solver: String,\n  vcs: List[smt.Vc],\n) -> List[List[String]] {\n  mixes := parallel.map(vcs, vc -> smt.sort_mixes(vc))\n  batches := parallel.map(\n    vcs.filter(vc -> len(vc.obligations) > 0),\n    vc -> (smt.batch(vc), [\"-t:20000\", \"rlimit=2000000\"]),\n  )\n  outs := smt.run_scripts(mut launcher, mut disk, scratch, solver, batches)\n  // each function's first lines, by obligation\n  mut firsts := []\n  mut b := 0\n  for vc in vcs {\n    if len(vc.obligations) > 0 {\n      got := get(outs, b) ?? []\n      b += 1\n      mut firsts.push(got.map(o -> trim(get(lines(o), 0) ?? \"\")))\n    } else {\n      mut firsts.push([])\n    }\n  }\n  mut again := []\n  for (k, vc) in enumerate(vcs) {\n    fk := get(firsts, k) ?? []\n    for i in range(0, len(vc.obligations)) {\n      first := get(fk, i) ?? \"\"\n      if first != \"sat\" && first != \"unsat\" {\n        mut again.push((k, i, vc))\n      }\n    }\n  }\n  singles := parallel.map(\n    again,\n    x -> (smt.single(x.2, x.1), [\"-T:20\", \"rlimit=2000000\"]),\n  )\n  alone := smt.run_scripts(mut launcher, mut disk, scratch, solver, singles)\n  mut retried := Dict[String, String] {}\n  for (j, x) in enumerate(again) {\n    mut retried.insert(\n      f\"{x.0} {x.1}\",\n      trim(get(lines(get(get(alone, j) ?? [], 0) ?? \"\"), 0) ?? \"\"),\n    )\n  }\n  mut all := []\n  for (k, vc) in enumerate(vcs) {\n    fk := get(firsts, k) ?? []\n    mk := get(mixes, k) ?? Dict[Int, String] {}\n    mut out := []\n    for (i, ob) in enumerate(vc.obligations) {\n      first := get(retried, f\"{k} {i}\") ?? get(fk, i) ?? \"\"\n      word := if contains(mk, i) {\n        \"unknown\"\n      } else {\n        match first {\n          \"unsat\" => \"proven\",\n          \"sat\" => \"refuted\",\n          _ => \"unknown\",\n        }\n      }\n      mut out.push(word + \" \" + ob.what)\n    }\n    mut all.push(out + vc.given.map(g -> \"proven \" + g))\n  }\n  all\n}"},{"name":"use sorts","kind":"use","old":null,"new":"3b5fda2eee9d0323","interface_changed":true,"affected":[],"module":"","text":"from sorts use sort_error"}]}
{"id":"d7944a1de1b6d7e4","time":1795719433,"message":"rename eval.at → eval.element_at","changes":[{"name":"eval.element_at","kind":"fn","old":null,"new":"024ca304aeb15024","interface_changed":true,"affected":[],"module":"eval","text":"fn element_at(xs: List[ast.Expr], i: Int) -> Result[ast.Expr, eval.Escape] {\n  match get(xs, i) {\n    Some(x) => Ok(x),\n    None => Err(eval.runtime(\"index \"\n      + to_string(i)\n      + \" out of range (length \"\n      + to_string(len(xs))\n      + \")\")),\n  }\n}"},{"name":"eval.field","kind":"fn","old":"952d4967712fd315","new":"51acfb9a1be91676","interface_changed":false,"affected":[],"module":"eval","text":"/// A field of a value: a record's or variant's by name, a tuple's or\n/// positional variant's by position, a distinct value's `value`.\nfn field(\n  w: eval.World,\n  v: ast.Expr,\n  name: String,\n) -> Result[ast.Expr, eval.Escape] {\n  match v {\n    ast.CtorExpr { args: ast.RecordArgs(fs), .. } => {\n      for f in fs {\n        if f.0 == name {\n          return Ok(f.1)\n        }\n      }\n    },\n    ast.CtorExpr { name: c, args: ast.PositionalArgs(xs) } => {\n      if eval.is_distinct(w, c) && name == \"value\" {\n        return Ok(get(xs, 0) ?? ast.UnitExpr)\n      }\n      match parse_int(name) {\n        Some(i) => return eval.element_at(xs, i),\n        None => (),\n      }\n    },\n    ast.TupleExpr(xs) => match parse_int(name) {\n      Some(i) => return eval.element_at(xs, i),\n      None => (),\n    },\n    _ => (),\n  }\n  Err(eval.runtime(eval.code(v) + \" has no field `\" + name + \"`\"))\n}","old_text":"/// A field of a value: a record's or variant's by name, a tuple's or\n/// positional variant's by position, a distinct value's `value`.\nfn field(\n  w: eval.World,\n  v: ast.Expr,\n  name: String,\n) -> Result[ast.Expr, eval.Escape] {\n  match v {\n    ast.CtorExpr { args: ast.RecordArgs(fs), .. } => {\n      for f in fs {\n        if f.0 == name {\n          return Ok(f.1)\n        }\n      }\n    },\n    ast.CtorExpr { name: c, args: ast.PositionalArgs(xs) } => {\n      if eval.is_distinct(w, c) && name == \"value\" {\n        return Ok(get(xs, 0) ?? ast.UnitExpr)\n      }\n      match parse_int(name) {\n        Some(i) => return eval.at(xs, i),\n        None => (),\n      }\n    },\n    ast.TupleExpr(xs) => match parse_int(name) {\n      Some(i) => return eval.at(xs, i),\n      None => (),\n    },\n    _ => (),\n  }\n  Err(eval.runtime(eval.code(v) + \" has no field `\" + name + \"`\"))\n}"},{"name":"eval.set_path","kind":"fn","old":"34f9082c8f1ec8b8","new":"b1b7b386860284d3","interface_changed":false,"affected":[],"module":"eval","text":"/// The value with the field at `path` set to `x`.\nfn set_path(\n  w: eval.World,\n  v: ast.Expr,\n  path: List[String],\n  x: ast.Expr,\n) -> Result[ast.Expr, eval.Escape] {\n  if len(path) == 0 {\n    return Ok(x)\n  }\n  name := get(path, 0) ?? \"\"\n  rest := drop(path, 1)\n  match v {\n    ast.CtorExpr { name: c, args: ast.RecordArgs(fs) } => {\n      mut out := []\n      mut found := false\n      for f in fs {\n        if f.0 == name {\n          found = true\n          mut out.push((f.0, eval.set_path(w, f.1, rest, x)!))\n        } else {\n          mut out.push(f)\n        }\n      }\n      if found {\n        return Ok(ast.CtorExpr { name: c, args: ast.RecordArgs(out) })\n      }\n    },\n    ast.CtorExpr { name: c, args: ast.PositionalArgs(xs) } => match parse_int(name) {\n      Some(i) => {\n        old := eval.element_at(xs, i)!\n        return Ok(\n          ast.CtorExpr {\n            name: c,\n            args: ast.PositionalArgs(take(xs, i)\n              + [eval.set_path(w, old, rest, x)!]\n              + drop(xs, i + 1)),\n          },\n        )\n      },\n      None => (),\n    },\n    ast.TupleExpr(xs) => match parse_int(name) {\n      Some(i) => {\n        old := eval.element_at(xs, i)!\n        return Ok(ast.TupleExpr(take(xs, i)\n          + [eval.set_path(w, old, rest, x)!]\n          + drop(xs, i + 1)))\n      },\n      None => (),\n    },\n    ast.ListExpr(xs) => match parse_int(name) {\n      Some(i) => {\n        old := eval.element_at(xs, i)!\n        return Ok(ast.ListExpr(take(xs, i)\n          + [eval.set_path(w, old, rest, x)!]\n          + drop(xs, i + 1)))\n      },\n      None => (),\n    },\n    _ => (),\n  }\n  Err(eval.runtime(eval.code(v) + \" has no field `\" + name + \"`\"))\n}","old_text":"/// The value with the field at `path` set to `x`.\nfn set_path(\n  w: eval.World,\n  v: ast.Expr,\n  path: List[String],\n  x: ast.Expr,\n) -> Result[ast.Expr, eval.Escape] {\n  if len(path) == 0 {\n    return Ok(x)\n  }\n  name := get(path, 0) ?? \"\"\n  rest := drop(path, 1)\n  match v {\n    ast.CtorExpr { name: c, args: ast.RecordArgs(fs) } => {\n      mut out := []\n      mut found := false\n      for f in fs {\n        if f.0 == name {\n          found = true\n          mut out.push((f.0, eval.set_path(w, f.1, rest, x)!))\n        } else {\n          mut out.push(f)\n        }\n      }\n      if found {\n        return Ok(ast.CtorExpr { name: c, args: ast.RecordArgs(out) })\n      }\n    },\n    ast.CtorExpr { name: c, args: ast.PositionalArgs(xs) } => match parse_int(name) {\n      Some(i) => {\n        old := eval.at(xs, i)!\n        return Ok(\n          ast.CtorExpr {\n            name: c,\n            args: ast.PositionalArgs(take(xs, i)\n              + [eval.set_path(w, old, rest, x)!]\n              + drop(xs, i + 1)),\n          },\n        )\n      },\n      None => (),\n    },\n    ast.TupleExpr(xs) => match parse_int(name) {\n      Some(i) => {\n        old := eval.at(xs, i)!\n        return Ok(ast.TupleExpr(take(xs, i)\n          + [eval.set_path(w, old, rest, x)!]\n          + drop(xs, i + 1)))\n      },\n      None => (),\n    },\n    ast.ListExpr(xs) => match parse_int(name) {\n      Some(i) => {\n        old := eval.at(xs, i)!\n        return Ok(ast.ListExpr(take(xs, i)\n          + [eval.set_path(w, old, rest, x)!]\n          + drop(xs, i + 1)))\n      },\n      None => (),\n    },\n    _ => (),\n  }\n  Err(eval.runtime(eval.code(v) + \" has no field `\" + name + \"`\"))\n}"},{"name":"eval.builtin","kind":"fn","old":"676413e6983b1cd8","new":"05f653715f33ef0c","interface_changed":false,"affected":[],"module":"eval","text":"fn builtin(\n  mut st: eval.State,\n  w: eval.World,\n  given: String,\n  vs: List[ast.Expr],\n) -> Result[ast.Expr, eval.Escape] {\n  // `xs.sorted()` is the built-in `sort`, returning a new list\n  name := builtins.internal_name(given)\n  // an iterator where a list is wanted: its elements (`join(s.graphemes(), \"\")`)\n  a := match eval.arg(vs, 0) {\n    ast.CtorExpr { .. } => if eval.method_of(w, eval.arg(vs, 0), \"next\") is Some\n      && !(name == \"to_string\" || name == \"debug\" || name == \"print\") {\n      ast.ListExpr(eval.elements(mut st, w, eval.arg(vs, 0))!)\n    } else {\n      eval.arg(vs, 0)\n    },\n    x => x,\n  }\n  b := eval.arg(vs, 1)\n  c := eval.arg(vs, 2)\n  match eval.conversion(name, a) {\n    Some(r) => return r,\n    None => (),\n  }\n  match name {\n    \"print\" => {\n      st.out += eval.display(mut st, w, a)! + \"\\n\"\n      Ok(ast.UnitExpr)\n    },\n    // what std reaches the system through: the run's own output and arguments\n    \"host_write\" => {\n      if a == ast.IntLit(2) {\n        st.err += eval.str_of(b)!\n      } else {\n        st.out += eval.str_of(b)!\n      }\n      Ok(ast.UnitExpr)\n    },\n    \"host_args\" => Ok(eval.str_list(st.args)),\n    // reading files through the run's `Files`. Writing files is not\n    // supported.\n    \"host_read_file\" | \"host_read_bytes\" | \"host_exists\" | \"host_list_dir\" => match st.files {\n      Some(fs) => eval.host_files(fs, name, eval.str_of(a)!),\n      None => Err(eval.runtime(\"the built-in `\"\n        + name\n        + \"` reads files, which compile-time code can't\")),\n    },\n    \"host_env_var\" | \"host_read_line\" => Ok(eval.none()),\n    \"to_string\" => Ok(ast.StrLit(eval.display(mut st, w, a)!)),\n    \"debug\" => Ok(ast.StrLit(eval.show(mut st, w, a)!)),\n    \"len\" => match a {\n      ast.StrLit(_) => Err(eval.runtime(\"a String has no `len`: name the unit\")),\n      _ => Ok(ast.IntLit(len(eval.collection_of(a)!))),\n    },\n    \"contains\" => match (a, b) {\n      (ast.StrLit(s), ast.StrLit(p)) => Ok(ast.BoolLit(contains(s, p))),\n      (ast.DictExpr { entries, .. }, _) => Ok(ast.BoolLit(eval.dict_get(entries, b) is Some)),\n      _ => Ok(ast.BoolLit(contains(eval.collection_of(a)!, b))),\n    },\n    \"get\" => match a {\n      ast.DictExpr { entries, .. } => Ok(eval.option(eval.dict_get(entries, b))),\n      _ => Ok(eval.option(get(eval.list_of(a)!, eval.int_of(b)!))),\n    },\n    \"at\" => eval.element_at(eval.list_of(a)!, eval.int_of(b)!),\n    \"set_at\" => {\n      xs := eval.list_of(a)!\n      i := eval.int_of(b)!\n      _ := eval.element_at(xs, i)!\n      Ok(ast.ListExpr(take(xs, i) + [c] + drop(xs, i + 1)))\n    },\n    \"dict\" => Ok(eval.make_dict(w, eval.list_of(a)!.map(\n      x -> match x {\n        ast.TupleExpr([k, v]) => (k, v),\n        _ => (x, ast.UnitExpr),\n      },\n    ))),\n    \"insert\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.DictExpr {\n        types: [],\n        entries: eval.dict_put(w, entries, b, c),\n      }),\n      ast.SetExpr { elems, .. } => Ok(\n        ast.SetExpr { types: [], elems: eval.set_put(w, elems, b) },\n      ),\n      _ => Err(eval.runtime(\"insert into \" + eval.code(a))),\n    },\n    \"remove\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.DictExpr { types: [], entries: eval.swap_removed(\n        entries,\n        eval.index_where(entries.map(kv -> kv.0), b),\n      ) }),\n      ast.SetExpr { elems, .. } => Ok(ast.SetExpr {\n        types: [],\n        elems: eval.swap_removed(elems, eval.index_where(elems, b)),\n      }),\n      _ => Err(eval.runtime(\"remove from \" + eval.code(a))),\n    },\n    \"keys\" => match a {\n      a