     }\n      v := match xs.ty {\n        check.TList(et) => return codegen.match_got(mut g, xs, b, et, arms, want),\n        _ => codegen.builtin_call(mut g, \"get\", xs, [b]),\n      }\n      if v.ty is check.TAny {\n        return v\n      }\n      g.result_pos = rp\n      return codegen.matching_v(mut g, v, scrutinee, binding, arms, want)\n    },\n    _ => (),\n  }\n  // (a call's result only read by the arms: on the stack)\n  v := codegen.expr_on_stack(\n    mut g,\n    scrutinee,\n    binding is None && !arms.any(a -> codegen.binds_whole(a.pat)),\n  )\n  if v.ty is check.TAny {\n    return v\n  }\n  g.result_pos = rp\n  codegen.matching_v(mut g, v, scrutinee, binding, arms, want)\n}","old_text":"/// `matching` with each arm's value made as `want` says.\nfn matching_want(\n  mut g: codegen.Gen,\n  scrutinee: ast.Expr,\n  binding: Option[String],\n  arms: List[ast.Arm],\n  want: Ty,\n) -> codegen.V {\n  // (in result position: each arm's value is, `matching_v`)\n  rp := g.result_pos\n  g.result_pos = false\n  // `match get(xs, i) { Some(p) => …, None => … }` on a list: the element\n  // is matched in place, no `Option` made\n  match (binding, scrutinee) {\n    (None, ast.Call { callee: ast.Var(\"get\"), args: [a, b] }) => if codegen.lookup(g, \"get\") is None\n      && codegen.fn_key(g, \"get\") == \"\"\n      && arms.all(x -> codegen.option_arm(x.pat)) {\n      xs := codegen.expr(mut g, a)\n      if xs.ty is TAny {\n        return xs\n      }\n      v := match xs.ty {\n        TList(et) => return codegen.match_got(mut g, xs, b, et, arms, want),\n        _ => codegen.builtin_call(mut g, \"get\", xs, [b]),\n      }\n      if v.ty is TAny {\n        return v\n      }\n      g.result_pos = rp\n      return codegen.matching_v(mut g, v, scrutinee, binding, arms, want)\n    },\n    _ => (),\n  }\n  // (a call's result only read by the arms: on the stack)\n  v := codegen.expr_on_stack(\n    mut g,\n    scrutinee,\n    binding is None && !arms.any(a -> codegen.binds_whole(a.pat)),\n  )\n  if v.ty is TAny {\n    return v\n  }\n  g.result_pos = rp\n  codegen.matching_v(mut g, v, scrutinee, binding, arms, want)\n}"},{"name":"codegen.wanted","kind":"fn","old":"6522f78c069747e7","new":"548799289ed3a51f","interface_changed":true,"affected":["codegen.builtin_call","codegen.branch_value","codegen.mock_call","codegen.call_named","codegen.method_call","codegen.except_expr","codegen.matching_want","codegen.if_want","codegen.matching_v","codegen.match_got","codegen.expr_node","codegen.expr_want_node","codegen.matching","codegen.if_expr","codegen.expr","codegen.expr_want","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_check","codegen.try_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.compared","codegen.stmt_node","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.function","codegen.declare","codegen.block_expr","codegen.call_fn_want","codegen.list_literal_of","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.fuzz_driver","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.checked_update","codegen.appended","codegen.binds","codegen.assertion","codegen.invariants","codegen.tag_is","codegen.check_type","codegen.satisfies","codegen.holds_pred","codegen.entry","codegen.vtable","codegen.mock_table","codegen.list_builtin","codegen.collection_builtin","codegen.produce","codegen.table_find","codegen.generate","codegen.construct