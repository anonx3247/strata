m_slot(mut g: codegen.Gen, s: String, t: check.Ty) -> codegen.V {\n  match codegen.sized(t) {\n    Some(w) => return codegen.narrow_word(mut g, w, s, t),\n    None => (),\n  }\n  match t {\n    check.TInt => codegen.V { ty: t, op: s },\n    check.TFloat => {\n      r := codegen.fresh(mut g, \"f\")\n      codegen.emit(mut g, f\"{r} = bitcast i64 {s} to double\")\n      codegen.V { ty: t, op: r }\n    },\n    check.TBool => {\n      r := codegen.fresh(mut g, \"b\")\n      codegen.emit(mut g, f\"{r} = trunc i64 {s} to i1\")\n      codegen.V { ty: t, op: r }\n    },\n    check.TStr | check.TNamed { .. } | check.TList(_) | check.TFn { .. } | check.TTrait(_) | check.TUnion(_) => {\n      r := codegen.fresh(mut g, \"p\")\n      codegen.emit(mut g, f\"{r} = inttoptr i64 {s} to ptr\")\n      codegen.V { ty: t, op: r }\n    },\n    check.TUnit => codegen.unit(),\n    _ => {\n      codegen.not_yet(mut g, \"a value whose type isn't known here\")\n      codegen.never()\n    },\n  }\n}","old_text":"/// The value of type `t` held in a slot.\nfn from_slot(mut g: codegen.Gen, s: String, t: Ty) -> codegen.V {\n  match codegen.sized(t) {\n    Some(w) => return codegen.narrow_word(mut g, w, s, t),\n    None => (),\n  }\n  match t {\n    TInt => codegen.V { ty: t, op: s },\n    TFloat => {\n      r := codegen.fresh(mut g, \"f\")\n      codegen.emit(mut g, f\"{r} = bitcast i64 {s} to double\")\n      codegen.V { ty: t, op: r }\n    },\n    TBool => {\n      r := codegen.fresh(mut g, \"b\")\n      codegen.emit(mut g, f\"{r} = trunc i64 {s} to i1\")\n      codegen.V { ty: t, op: r }\n    },\n    TStr | TNamed { .. } | TList(_) | TFn { .. } | TTrait(_) | TUnion(_) => {\n      r := codegen.fresh(mut g, \"p\")\n      codegen.emit(mut g, f\"{r} = inttoptr i64 {s} to ptr\")\n      codegen.V { ty: t, op: r }\n    },\n    TUnit => codegen.unit(),\n    _ => {\n      codegen.not_yet(mut g, \"a value whose type isn't known here\")\n      codegen.never()\n    },\n  }\n}"},{"name":"codegen.field","kin