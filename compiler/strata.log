\n      }\n      match codegen.lookup(g, x) {\n        Some(l0) => {\n          // a variable declared with a partly unknown type (`mut xs := []`)\n          // takes the type the value gives it\n          l := codegen.retype(mut g, l0, v.ty)\n          // (a call's words: into the variable's own block when nothing\n          // else holds it)\n          if codegen.assign_held(mut g, l, v) {\n            return\n          }\n          match get(g.declared, l.slot) {\n            Some(dt) => if whole {\n              codegen.check_type(\n                mut g,\n                dt,\n                v,\n                f\"assigning `{x}`\",\n                [],\n              )\n            },\n            None => (),\n          }\n          // the new value held, the old one dropped\n          x := codegen.converted(mut g, v, l.ty)\n          nv := codegen.take_value(mut g, codegen.V { ..x, ty: l.ty })\n          old := codegen.load(mut g, l)\n          codegen.store_var(mut g, nv, l)\n          codegen.drop_value(mut g, old)\n        },\n        None => codegen.not_yet(mut g, \"assigning to `\" + x + \"`\"),\n      }\n    },\n    ast.Assign { place, value: given } => match codegen.place_of(place) {\n      Some((x, path)) => {\n        (value, elements) := codegen.checked_update(mut g, place, given)\n        v := match codegen.update_in_place(mut g, place, value) {\n          Some(u) => u,\n          None => match codegen.appended(mut g, place, value) {\n            Some(u) => u,\n            None => codegen.expr(mut g, value),\n          },\n        }\n        if v.ty is TAny {\n          return\n        }\n        match codegen.lookup(g, x) {\n          Some(l) => {\n            g.elements_checked = elements\n            codegen.assign_at(\n              mut g,\n              l,\n              x,\n              path,\n              v,\n              g.proven_root == x,\n            )\n            g.elements_checked = false\n          },\n          None => codegen.not_yet(\n            mut g,\n            \"assigning to `\" + text.expr_text(place, 0) + \"`\",\n          ),\n        }\n      },\n      None => codegen.not_yet(\n        mut g,\n        \"assigning to `\" + text.expr_text(place, 0) + \"`\",\n      ),\n    },\n    ast.While { cond, body } => {\n      (head, inner, end) := (\n        codegen.label(mut g, \"while\"),\n        codegen.label(mut g, \"while.body\"),\n        codegen.label(mut g, \"while.end\"),\n      )\n      kept := codegen.decreases_start(mut g, body)\n      codegen.br(mut g, head)\n      codegen.block(mut g, head)\n      codegen.invariants(mut g, body)\n      codegen.push_transparent(mut g)\n      c := codegen.expr(mut g, cond)\n      if c.ty is TAny {\n        codegen.discard_scope(mut g)\n        return\n      }\n      codegen.pop_scope(mut g)\n      codegen.emit(\n        mut g,\n        f\"br i1 {c.op}, label %{inner}, label %{end}\",\n      )\n      codegen.block(mut g, inner)\n      mut g.loops.push((head, end, len(g.scopes)))\n      codegen.loop_step(mut g)\n      codegen.decreases_pass(\n        mut g,\n        body,\n        kept,\n        \"while \" + text.expr_text(cond, 0),\n      )\n      codegen.loop_body(mut g, body)\n      g.loops = take(g.loops, len(g.loops) - 1)\n      codegen.br(mut g, head)\n      codegen.block(mut g, end)\n    },\n    ast.Loop(body) => {\n      (head, end) := (\n        codegen.label(mut g, \"loop\"),\n        codegen.label(mut g, \"loop.end\"),\n      )\n      kept := codegen.decreases_start(mut g, body)\n      codegen.br(mut g, head)\n      codegen.block(mut g, head)\n      codegen.invariants(mut g, body)\n      mut g.loops.push((head, end, len(g.scopes)))\n      codegen.loop_step(mut g)\n      codegen.decreases_pass(mut g, body, kept, \"loop\")\n      codegen.loop_body(mut g, body)\n      g.loops = take(g.loops, len(g.loops) - 1)\n      codegen.br(mut g, head)\n      codegen.block(mut g, end)\n    },\n    ast.Break => match get(g.loops, len(g.loops) - 1) {\n      Some(l) => {\n        codegen.drop_from(mut g, l.2, \"\")\n        codegen.br(mut g, l.1)\n        codegen.dead(mut g)\n      },\n      None => codegen.not_yet(mut g, \"`break` outside a loop\"),\n    },\n    ast.Continue => match get(g.loops, len(g.loops) - 1) {\n      Some(l) => {\n        codegen.drop_from(mut g, l.2, \"\")\n        codegen.br(mut g, l.0)\n        codegen.dead(mut g)\n      },\n      None => codegen.not_yet(mut g, \"`continue` outside a loop\"),\n    },\n    ast.ExprStmt(x) => {\n      _ := codegen.expr(mut g, x)\n    },\n    ast.Assert(x) => codegen.assertion(mut g, x),\n    ast.Comment(_) => (),\n    // checked at the loop's head\n    ast.Invariant(_) => (),\n    ast.For { pat, iter, body } => codegen.for_loop(mut g, pat, iter, body),\n    ast.ComptimeFor { .. } => codegen.not_yet(mut g, \"`comptime for`\"),\n    _ => (),\n  }\n}"},{"name":"codegen.decreases_fault","kind":"fn","old":"2463468f3d60994c","new":"449f2d6a461a4163","interface_changed":false,"affected":[],"module":"codegen","text":"/// Faults unless `ok` holds: `what`, then the measure's values before and\n/// after (`decreases failed: …`).\nfn decreases_fault(\n  mut g: codegen.Gen,\n  ok: codegen.V,\n  what: String,\n  before: List[codegen.V],\n  after: List[codegen.V],\n) {\n  (pass, fail) := (\n    codegen.label(mut g, \"decreases.ok\"),\n    codegen.label(mut g, \"decreases.fail\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"br i1 {ok.op}, label %{pass}, label %{fail}\",\n  )\n  codegen.block(mut g, fail)\n  // the message parts are never dropped: the fault ends the program\n  codegen.push_scope(mut g)\n  mut parts := [codegen.V {\n    ty: check.TStr,\n    op: codegen.string(mut g, what + \" (before: \"),\n  }]\n  for (k, v) in enumerate(before) {\n    if k > 0 {\n      mut parts.push(\n        codegen.V {\n          ty: check.TStr,\n          op: codegen.string(mut g, \", \"),\n        },\n      )\n    }\n    mut parts.push(codegen.shown(mut g, v))\n  }\n  mut parts.push(\n    codegen.V {\n      ty: check.TStr,\n      op: codegen.string(mut g, \", after: \"),\n    },\n  )\n  for (k, v) in enumerate(after) {\n    if k > 0 {\n      mut parts.push(\n        codegen.V {\n          ty: check.TStr,\n          op: codegen.string(mut g, \", \"),\n        },\n      )\n    }\n    mut parts.push(codegen.shown(mut g, v))\n  }\n  mut parts.push(\n    codegen.V { ty: check.TStr, op: codegen.string(mut g, \")\") },\n  )\n  m := codegen.concat(mut g, parts)\n  // 3: an assertion, in runtime.c's fault numbering\n  _ := codegen.call(\n    mut g,\n    check.TUnit,\n    \"strata_fault\",\n    [codegen.V { ty: check.TInt, op: \"3\" }, m],\n  )\n  codegen.emit(mut g, \"unreachable\")\n  codegen.discard_scope(mut g)\n  codegen.block(mut g, pass)\n}","old_text":"/// Faults unless `ok` holds: `what`, then the measure's values before and\n/// after (`decreases failed: …`).\nfn decreases_fault(\n  mut g: codegen.Gen,\n  ok: codegen.V,\n  what: String,\n  before: List[codegen.V],\n  after: List[codegen.V],\n) {\n  (pass, fail) := (\n    codegen.label(mut g, \"decreases.ok\"),\n    codegen.label(mut g, \"decreases.fail\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"br i1 {ok.op}, label %{pass}, label %{fail}\",\n  )\n  codegen.block(mut g, fail)\n  // the message parts are never dropped: the fault ends the program\n  codegen.push_scope(mut g)\n  mut parts := [codegen.V {\n    ty: TStr,\n    op: codegen.string(mut g, what + \" (before: \"),\n  }]\n  for (k, v) in enumerate(before) {\n    if k > 0 {\n      mut parts.push(\n        codegen.V { ty: TStr, op: codegen.string(mut g, \", \") },\n      )\n    }\n    mut parts.push(codegen.shown(mut g, v))\n  }\n  mut parts.push(\n    codegen.V { ty: TStr, op: codegen.string(mut g, \", after: \") },\n  )\n  for (k, v) in enumerate(after) {\n    if k > 0 {\n      mut parts.push(\n        codegen.V { ty: TStr, op: codegen.string(mut g, \", \") },\n      )\n    }\n    mut parts.push(codegen.shown(mut g, v))\n  }\n  mut parts.push(codegen.V { ty: TStr, op: codegen.string(mut g, \")\") })\n  m := codegen.concat(mut g, parts)\n  // 3: an assertion, in runtime.c's fault numbering\n  _ := codegen.call(\n    mut g,\n    TUnit,\n    \"strata_fault\",\n    [codegen.V { ty: TInt, op: \"3\" }, m],\n  )\n  codegen.emit(mut g, \"unreachable\")\n  codegen.discard_scope(mut g)\n  codegen.block(mut g, pass)\n}"},{"name":"codegen.decreases_pass","kind":"fn","old":"5ce7acb48aa1cfe8","new":"76e0a794029fb9bb","interface_changed":false,"affected":[],"module":"codegen","text":"/// At the start of a loop iteration (`head` its header as written): checks\n/// the `decreases` clause against the last iteration's start (`kept`, from\n/// `decreases_start`). The measure must go down, compared in order and\n/// non-negative where it decides. Nothing is checked on the first\n/// iteration.\nfn decreases_pass(\n  mut g: codegen.Gen,\n  body: ast.Expr,\n  kept: List[String],\n  head: String,\n) {\n  if kept == [] {\n    return\n  }\n  ms := text.decreases_of(body)\n  first := get(kept, 0) ?? \"\"\n  prev := drop(kept, 1)\n  codegen.push_scope(mut g)\n  now := prev.map(p -> p + \".now\")\n  for (n, m) in zip(now, ms) {\n    codegen.stmt(\n      mut g,\n      ast.Let { pat: ast.Bind(n), ty: None, value: m },\n    )\n  }\n  ok := codegen.expr(mut g, ast.Binary {\n    op: ast.Or,\n    left: ast.Var(first),\n    right: codegen.lex_down_expr(prev, now),\n  })\n  if !(ok.ty is check.TAny) {\n    mut before := []\n    for p in prev {\n      mut before.push(codegen.expr(mut g, ast.Var(p)))\n    }\n    mut after := []\n    for n in now {\n      mut after.push(codegen.expr(mut g, ast.Var(n)))\n    }\n    codegen.decreases_fault(mut g, ok, \"decreases failed: `\"\n      + drop_bytes(text.decreases_text(body), 10)\n      + \"` did not go down in a pass of `\"\n      + head\n      + \"`\", before, after)\n  }\n  codegen.stmt(\n    mut g,\n    ast.Assign { place: ast.Var(first), value: ast.BoolLit(false) },\n  )\n  for (p, n) in zip(prev, now) {\n    codegen.stmt(\n      mut g,\n      ast.Assign { place: ast.Var(p), value: ast.Var(n) },\n    )\n  }\n  codegen.pop_scope(mut g)\n}","old_text":"/// At the start of a loop iteration (`head` its header as written): checks\n/// the `decreases` clause against the last iteration's start (`kept`, from\n/// `decreases_start`). The measure must go down, compared in order and\n/// non-negative where it decides. Nothing is checked on the first\n/// iteration.\nfn decreases_pass(\n  mut g: codegen.Gen,\n  body: ast.Expr,\n  kept: List[String],\n  head: String,\n) {\n  if kept == [] {\n    return\n  }\n  ms := text.decreases_of(body)\n  first := get(kept, 0) ?? \"\"\n  prev := drop(kept, 1)\n  codegen.push_scope(mut g)\n  now := prev.map(p -> p + \".now\")\n  for (n, m) in zip(now, ms) {\n    codegen.stmt(\n      mut g,\n      ast.Let { pat: ast.Bind(n), ty: None, value: m },\n    )\n  }\n  ok := codegen.expr(mut g, ast.Binary {\n    op: ast.Or,\n    left: ast.Var(first),\n    right: codegen.lex_down_expr(prev, now),\n  })\n  if !(ok.ty is TAny) {\n    mut before := []\n    for p in prev {\n      mut before.push(codegen.expr(mut g, ast.Var(p)))\n    }\n    mut after := []\n    for n in now {\n      mut after.push(codegen.expr(mut g, ast.Var(n)))\n    }\n    codegen.decreases_fault(mut g, ok, \"decreases failed: `\"\n      + drop_bytes(text.decreases_text(body), 10)\n      + \"` did not go down in a pass of `\"\n      + head\n      + \"`\", before, after)\n  }\n  codegen.stmt(\n    mut g,\n    ast.Assign { place: ast.Var(first), value: ast.BoolLit(false) },\n  )\n  for (p, n) in zip(prev, now) {\n    codegen.stmt(\n      mut g,\n      ast.Assign { place: ast.Var(p), value: ast.Var(n) },\n    )\n  }\n  codegen.pop_scope(mut g)\n}"},{"name":"codegen.decreases_call","kind":"fn","old":"bd6ca0302998652e","new":"0692ec94ad5f964a","interface_changed":false,"affected":[],"module":"codegen","text":"/// A recursive call (`f`, arguments `vs`) when its `decreases` clause is\n/// checked (`decreases_entry`): the arguments' measure must be below the\n/// function's own, compared in order and non-negative where it decides.\nfn decreases_call(mut g: codegen.Gen, f: ast.FnDecl, vs: List[codegen.V]) {\n  ms := text.decreases_of(f.body)\n  if ms == [] || codegen.lookup(g, \"decreases.entry.0\") is None {\n    return\n  }\n  codegen.push_scope(mut g)\n  for (p, v) in zip(f.params, vs) {\n    if !p.mutable {\n      codegen.local_value(mut g, p.name, v)\n    }\n  }\n  entry := range(0, len(ms)).map(i -> \"decreases.entry.\" + to_string(i))\n  now := range(0, len(ms)).map(i -> \"decreases.call.\" + to_string(i))\n  for (n, m) in zip(now, ms) {\n    codegen.stmt(\n      mut g,\n      ast.Let { pat: ast.Bind(n), ty: None, value: m },\n    )\n  }\n  ok := codegen.expr(mut g, codegen.lex_down_expr(entry, now))\n  if !(ok.ty is check.TAny) {\n    mut before := []\n    for p in entry {\n      mut before.push(codegen.expr(mut g, ast.Var(p)))\n    }\n    mut after := []\n    for n in now {\n      mut after.push(codegen.expr(mut g, ast.Var(n)))\n    }\n    codegen.decreases_fault(mut g, ok, \"decreases failed: `\"\n      + drop_bytes(text.decreases_text(f.body), 10)\n      + \"` did not go down at a call of `\"\n      + f.name\n      + \"`\", before, after)\n  }\n  codegen.pop_scope(mut g)\n}","old_text":"/// A recursive call (`f`, arguments `vs`) when its `decreases` clause is\n/// checked (`decreases_entry`): the arguments' measure must be below the\n/// function's own, compared in order and non-negative where it decides.\nfn decreases_call(mut g: codegen.Gen, f: ast.FnDecl, vs: List[codegen.V]) {\n  ms := text.decreases_of(f.body)\n  if ms == [] || codegen.lookup(g, \"decreases.entry.0\") is None {\n    return\n  }\n  codegen.push_scope(mut g)\n  for (p, v) in zip(f.params, vs) {\n    if !p.mutable {\n      codegen.local_value(mut g, p.name, v)\n    }\n  }\n  entry := range(0, len(ms)).map(i -> \"decreases.entry.\" + to_string(i))\n  now := range(0, len(ms)).map(i -> \"decreases.call.\" + to_string(i))\n  for (n, m) in zip(now, ms) {\n    codegen.stmt(\n      mut g,\n      ast.Let { pat: ast.Bind(n), ty: None, value: m },\n    )\n  }\n  ok := codegen.expr(mut g, codegen.lex_down_expr(entry, now))\n  if !(ok.ty is TAny) {\n    mut before := []\n    for p in entry {\n      mut before.push(codegen.expr(mut g, ast.Var(p)))\n    }\n    mut after := []\n    for n in now {\n      mut after.push(codegen.expr(mut g, ast.Var(n)))\n    }\n    codegen.decreases_fault(mut g, ok, \"decreases failed: `\"\n      + drop_bytes(text.decreases_text(f.body), 10)\n      + \"` did not go down at a call of `\"\n      + f.name\n      + \"`\", before, after)\n  }\n  codegen.pop_scope(mut g)\n}"},{"name":"codegen.built_or_generated","kind":"fn","old":"e92d8f5b39a09bd2","new":"2e5c97624c4551a3","interface_changed":false,"affected":[],"module":"codegen","text":"/// An argument of type `t` for verify's fuzz driver of `key`, whose\n/// `requires` random values rarely meet. When the program has functions\n/// making `t`s (`makers`), three cases in four build it with them (a\n/// builder, then steps). The rest are generated.\nfn built_or_generated(\n  mut g: codegen.Gen,\n  key: String,\n  t: ast.TypeExpr,\n) -> codegen.V {\n  plain := match t {\n    ast.Named { name, args } => args != [] || !contains(g.data, name),\n    _ => true,\n  }\n  if plain {\n    return codegen.generated(mut g, t, codegen.no_hints(), \"0\")\n  }\n  (bs, ss) := codegen.makers(g, key, t)\n  if bs == [] {\n    return codegen.generated(mut g, t, codegen.no_hints(), \"0\")\n  }\n  b := codegen.build_fn(mut g, key, t, bs, ss)\n  ty := codegen.lower(mut g, t)\n  codegen.use_rt(mut g, \"strata_random\")\n  (w, c) := (codegen.fresh(mut g, \"how\"), codegen.fresh(mut g, \"random\"))\n  codegen.emit(\n    mut g,\n    f\"{w} = call i64 @strata_random(i64 0, i64 3)\",\n  )\n  codegen.emit(mut g, f\"{c} = icmp eq i64 {w}, 0\")\n  slot := codegen.fresh(mut g, \"arg\")\n  mut g.allocas.push(f\"  {slot} = alloca {codegen.ll(ty)}\")\n  (gen, made, end) := (\n    codegen.label(mut g, \"arg.generated\"),\n    codegen.label(mut g, \"arg.built\"),\n    codegen.label(mut g, \"arg.end\"),\n  )\n  codegen.emit(mut g, f\"br i1 {c}, label %{gen}, label %{made}\")\n  codegen.block(mut g, gen)\n  v := codegen.generated(mut g, t, codegen.no_hints(), \"0\")\n  codegen.store(mut g, v, slot)\n  codegen.br(mut g, end)\n  codegen.block(mut g, made)\n  x := codegen.call_bare(\n    mut g,\n    ty,\n    b,\n    [codegen.V { ty: check.TInt, op: \"0\" }],\n  )\n  codegen.store(mut g, x, slot)\n  codegen.br(mut g, end)\n  codegen.block(mut g, end)\n  r := codegen.fresh(mut g, \"arg\")\n  codegen.emit(mut g, f\"{r} = load {codegen.ll(ty)}, ptr {slot}\")\n  codegen.V { ty, op: r }\n}","old_text":"/// An argument of type `t` for verify's fuzz driver of `key`, whose\n/// `requires` random values rarely meet. When the program has functions\n/// making `t`s (`makers`), three cases in four build it with them (a\n/// builder, then steps). The rest are generated.\nfn built_or_generated(\n  mut g: codegen.Gen,\n  key: String,\n  t: ast.TypeExpr,\n) -> codegen.V {\n  plain := match t {\n    ast.Named { name, args } => args != [] || !contains(g.data, name),\n    _ => true,\n  }\n  if plain {\n    return codegen.generated(mut g, t, codegen.no_hints(), \"0\")\n  }\n  (bs, ss) := codegen.makers(g, key, t)\n  if bs == [] {\n    return codegen.generated(mut g, t, codegen.no_hints(), \"0\")\n  }\n  b := codegen.build_fn(mut g, key, t, bs, ss)\n  ty := codegen.lower(mut g, t)\n  codegen.use_rt(mut g, \"strata_random\")\n  (w, c) := (codegen.fresh(mut g, \"how\"), codegen.fresh(mut g, \"random\"))\n  codegen.emit(\n    mut g,\n    f\"{w} = call i64 @strata_random(i64 0, i64 3)\",\n  )\n  codegen.emit(mut g, f\"{c} = icmp eq i64 {w}, 0\")\n  slot := codegen.fresh(mut g, \"arg\")\n  mut g.allocas.push(f\"  {slot} = alloca {codegen.ll(ty)}\")\n  (gen, made, end) := (\n    codegen.label(mut g, \"arg.generated\"),\n    codegen.label(mut g, \"arg.built\"),\n    codegen.label(mut g, \"arg.end\"),\n  )\n  codegen.emit(mut g, f\"br i1 {c}, label %{gen}, label %{made}\")\n  codegen.block(mut g, gen)\n  v := codegen.generated(mut g, t, codegen.no_hints(), \"0\")\n  codegen.store(mut g, v, slot)\n  codegen.br(mut g, end)\n  codegen.block(mut g, made)\n  x := codegen.call_bare(mut g, ty, b, [codegen.V { ty: TInt, op: \"0\" }])\n  codegen.store(mut g, x, slot)\n  codegen.br(mut g, end)\n  codegen.block(mut g, end)\n  r := codegen.fresh(mut g, \"arg\")\n  codegen.emit(mut g, f\"{r} = load {codegen.ll(ty)}, ptr {slot}\")\n  codegen.V { ty, op: r }\n}"},{"name":"codegen.build_fn","kind":"fn","old":"00634623a54f372c","new":"80f6fa7a78f85296","interface_changed":false,"affected":[],"module":"codegen","text":"/// The function building a `t` for `key`'s fuzz driver, made once:\n/// `(i64 depth) -> t`. It calls one of `builders` on generated arguments,\n/// then for `build_rounds()` rounds calls one of `steppers` (or none) on\n/// it when its `requires` holds. It runs in its own frame,\n/// `strata_fuzz_build`: a fault in it (a builder's or stepper's unmet\n/// precondition) discards the case.\nfn build_fn(\n  mut g: codegen.Gen,\n  key: String,\n  t: ast.TypeExpr,\n  builders: List[String],\n  steppers: List[(String, Int)],\n) -> String {\n  k := \"build:\" + key + \"|\" + text.type_text(t)\n  codegen.add_caller(mut g, k)\n  match get(g.gens, k) {\n    Some(n) => return n,\n    None => (),\n  }\n  match get(g.new_gens, k) {\n    Some(n) => return n,\n    None => (),\n  }\n  g.lambdas += 1\n  name := f\"@\\\"build.{g.owner}{g.lambdas}\\\"\"\n  if g.owner == \"\" {\n    mut g.gens.insert(k, name)\n  } else {\n    mut g.new_gens.insert(k, name)\n  }\n  ty := codegen.lower(mut g, t)\n  saved := g\n  codegen.start_helper(mut g)\n  g.current = k\n  frame := codegen.string(mut g, \"strata_fuzz_build\")\n  _ := codegen.call(\n    mut g,\n    check.TUnit,\n    \"strata_enter\",\n    [codegen.V { ty: check.TStr, op: frame }],\n  )\n  codegen.use_rt(mut g, \"strata_random\")\n  // a builder\n  slot := codegen.fresh(mut g, \"made\")\n  mut g.allocas.push(f\"  {slot} = alloca {codegen.ll(ty)}\")\n  made := codegen.label(mut g, \"build.made\")\n  which := codegen.fresh(mut g, \"which\")\n  codegen.emit(\n    mut g,\n    f\"{which} = call i64 @strata_random(i64 0, i64 {len(builders) - 1})\",\n  )\n  mut labels := []\n  for _ in builders {\n    mut labels.push(codegen.label(mut g, \"build.with\"))\n  }\n  mut cases := []\n  for (j, l) in enumerate(labels) {\n    mut cases.push(f\"i64 {j}, label %{l}\")\n  }\n  codegen.emit(\n    mut g,\n    f\"switch i64 {which}, label %{get(labels, 0) ?? made} [ {join(cases, \" \")} ]\",\n  )\n  for (j, bk) in enumerate(builders) {\n    codegen.block(mut g, get(labels, j) ?? made)\n    codegen.push_scope(mut g)\n    match codegen.fn_of(g, bk) {\n      Some(f) => {\n        args := codegen.generated_args(mut g, f, -1, \"\")\n        v := codegen.expr_want(\n          mut g,\n          ast.Call { callee: ast.Var(bk), args },\n          ty,\n        )\n        held := codegen.take_value(mut g, v)\n        codegen.pop_scope(mut g)\n        codegen.store(mut g, held, slot)\n      },\n      None => codegen.pop_scope(mut g),\n    }\n    codegen.br(mut g, made)\n  }\n  codegen.block(mut g, made)\n  x := codegen.fresh(mut g, \"made\")\n  codegen.emit(mut g, f\"{x} = load {codegen.ll(ty)}, ptr {slot}\")\n  codegen.local_owned(mut g, \"build.x\", codegen.V { ty, op: x })\n  // its steps\n  if steppers != [] {\n    for _ in 0..codegen.build_rounds() {\n      next := codegen.label(mut g, \"build.next\")\n      pick := codegen.fresh(mut g, \"step\")\n      codegen.emit(\n        mut g,\n        f\"{pick} = call i64 @strata_random(i64 0, i64 {len(steppers)})\",\n      )\n      mut ls := []\n      for _ in steppers {\n        mut ls.push(codegen.label(mut g, \"build.step\"))\n      }\n      mut cs := []\n      for (j, l) in enumerate(ls) {\n        mut cs.push(f\"i64 {j}, label %{l}\")\n      }\n      codegen.emit(\n        mut g,\n        f\"switch i64 {pick}, label %{next} [ {join(cs, \" \")} ]\",\n      )\n      for (j, (sk, at)) in enumerate(steppers) {\n        codegen.block(mut g, get(ls, j) ?? next)\n        codegen.push_scope(mut g)\n        match codegen.fn_of(g, sk) {\n          Some(f) => {\n            args := codegen.generated_args(mut g, f, at, \"build.x\")\n            call_e := ast.Call { callee: ast.Var(sk), args }\n            by_mut := match get(f.params, at) {\n              Some(p) => p.mutable,\n              None => false,\n            }\n            step := if by_mut {\n              ast.ExprStmt(call_e)\n            } else {\n              ast.Assign {\n                place: ast.Var(\"build.x\"),\n                value: call_e,\n              }\n            }\n            if f.pre == [] {\n              codegen.stmt(mut g, step)\n            } else {\n              // its `requires` first, on the value as its parameter: a\n              // rejected step is skipped\n              codegen.push_scope(mut g)\n              match (get(f.params, at), codegen.lookup(g, \"build.x\")) {\n                (Some(p), Some(l)) => codegen.local_owned(\n                  mut g,\n                  p.name,\n                  codegen.load(mut g, l),\n                ),\n                _ => (),\n              }\n              mut all := get(f.pre, 0) ?? ast.BoolLit(true)\n              for c in drop(f.pre, 1) {\n                all = ast.Binary { op: ast.And, left: all, right: c }\n              }\n              ok := codegen.expr(mut g, all)\n              codegen.pop_scope(mut g)\n              (go, skip) := (\n                codegen.label(mut g, \"build.go\"),\n                codegen.label(mut g, \"build.skip\"),\n              )\n              codegen.emit(\n                mut g,\n                f\"br i1 {ok.op}, label %{go}, label %{skip}\",\n              )\n              codegen.block(mut g, go)\n              codegen.stmt(mut g, step)\n              codegen.br(mut g, skip)\n              codegen.block(mut g, skip)\n            }\n          },\n          None => (),\n        }\n        codegen.pop_scope(mut g)\n        codegen.br(mut g, next)\n      }\n      codegen.block(mut g, next)\n    }\n  }\n  r := match codegen.lookup(g, \"build.x\") {\n    Some(l) => codegen.load(mut g, l),\n    None => codegen.V { ty, op: x },\n  }\n  codegen.dup_value(mut g, r)\n  codegen.drop_from(mut g, 0, \"\")\n  codegen.use_rt(mut g, \"strata_leave\")\n  codegen.emit(mut g, \"call void @strata_leave()\")\n  codegen.emit(mut g, if codegen.has_value(ty) {\n    f\"ret {codegen.ll(ty)} {r.op}\"\n  } else {\n    \"ret void\"\n  })\n  codegen.restore(mut g, saved, codegen.helper_text(\n    g,\n    f\"define {codegen.ll(ty)} {name}(i64 %depth)\",\n  ))\n  name\n}","old_text":"/// The function building a `t` for `key`'s fuzz driver, made once:\n/// `(i64 depth) -> t`. It calls one of `builders` on generated arguments,\n/// then for `build_rounds()` rounds calls one of `steppers` (or none) on\n/// it when its `requires` holds. It runs in its own frame,\n/// `strata_fuzz_build`: a fault in it (a builder's or stepper's unmet\n/// precondition) discards the case.\nfn build_fn(\n  mut g: codegen.Gen,\n  key: String,\n  t: ast.TypeExpr,\n  builders: List[String],\n  steppers: List[(String, Int)],\n) -> String {\n  k := \"build:\" + key + \"|\" + text.type_text(t)\n  codegen.add_caller(mut g, k)\n  match get(g.gens, k) {\n    Some(n) => return n,\n    None => (),\n  }\n  match get(g.new_gens, k) {\n    Some(n) => return n,\n    None => (),\n  }\n  g.lambdas += 1\n  name := f\"@\\\"build.{g.owner}{g.lambdas}\\\"\"\n  if g.owner == \"\" {\n    mut g.gens.insert(k, name)\n  } else {\n    mut g.new_gens.insert(k, name)\n  }\n  ty := codegen.lower(mut g, t)\n  saved := g\n  codegen.start_helper(mut g)\n  g.current = k\n  frame := codegen.string(mut g, \"strata_fuzz_build\")\n  _ := codegen.call(\n    mut g,\n    TUnit,\n    \"strata_enter\",\n    [codegen.V { ty: TStr, op: frame }],\n  )\n  codegen.use_rt(mut g, \"strata_random\")\n  // a builder\n  slot := codegen.fresh(mut g, \"made\")\n  mut g.allocas.push(f\"  {slot} = alloca {codegen.ll(ty)}\")\n  made := codegen.label(mut g, \"build.made\")\n  which := codegen.fresh(mut g, \"which\")\n  codegen.emit(\n    mut g,\n    f\"{which} = call i64 @strata_random(i64 0, i64 {len(builders) - 1})\",\n  )\n  mut labels := []\n  for _ in builders {\n    mut labels.push(codegen.label(mut g, \"build.with\"))\n  }\n  mut cases := []\n  for (j, l) in enumerate(labels) {\n    mut cases.push(f\"i64 {j}, label %{l}\")\n  }\n  codegen.emit(\n    mut g,\n    f\"switch i64 {which}, label %{get(labels, 0) ?? made} [ {join(cases, \" \")} ]\",\n  )\n  for (j, bk) in enumerate(builders) {\n    codegen.block(mut g, get(labels, j) ?? made)\n    codegen.push_scope(mut g)\n    match codegen.fn_of(g, bk) {\n      Some(f) => {\n        args := codegen.generated_args(mut g, f, -1, \"\")\n        v := codegen.expr_want(\n          mut g,\n          ast.Call { callee: ast.Var(bk), args },\n          ty,\n        )\n        held := codegen.take_value(mut g, v)\n        codegen.pop_scope(mut g)\n        codegen.store(mut g, held, slot)\n      },\n      None => codegen.pop_scope(mut g),\n    }\n    codegen.br(mut g, made)\n  }\n  codegen.block(mut g, made)\n  x := codegen.fresh(mut g, \"made\")\n  codegen.emit(mut g, f\"{x} = load {codegen.ll(ty)}, ptr {slot}\")\n  codegen.local_owned(mut g, \"build.x\", codegen.V { ty, op: x })\n  // its steps\n  if steppers != [] {\n    for _ in 0..codegen.build_rounds() {\n      next := codegen.label(mut g, \"build.next\")\n      pick := codegen.fresh(mut g, \"step\")\n      codegen.emit(\n        mut g,\n        f\"{pick} = call i64 @strata_random(i64 0, i64 {len(steppers)})\",\n      )\n      mut ls := []\n      for _ in steppers {\n        mut ls.push(codegen.label(mut g, \"build.step\"))\n      }\n      mut cs := []\n      for (j, l) in enumerate(ls) {\n        mut cs.push(f\"i64 {j}, label %{l}\")\n      }\n      codegen.emit(\n        mut g,\n        f\"switch i64 {pick}, label %{next} [ {join(cs, \" \")} ]\",\n      )\n      for (j, (sk, at)) in enumerate(steppers) {\n        codegen.block(mut g, get(ls, j) ?? next)\n        codegen.push_scope(mut g)\n        match codegen.fn_of(g, sk) {\n          Some(f) => {\n            args := codegen.generated_args(mut g, f, at, \"build.x\")\n            call_e := ast.Call { callee: ast.Var(sk), args }\n            by_mut := match get(f.params, at) {\n              Some(p) => p.mutable,\n              None => false,\n            }\n            step := if by_mut {\n              ast.ExprStmt(call_e)\n            } else {\n              ast.Assign {\n                place: ast.Var(\"build.x\"),\n                value: call_e,\n              }\n            }\n            if f.pre == [] {\n              codegen.stmt(mut g, step)\n            } else {\n              // its `requires` first, on the value as its parameter: a\n              // rejected step is skipped\n              codegen.push_scope(mut g)\n              match (get(f.params, at), codegen.lookup(g, \"build.x\")) {\n                (Some(p), Some(l)) => codegen.local_owned(\n                  mut g,\n                  p.name,\n                  codegen.load(mut g, l),\n                ),\n                _ => (),\n              }\n              mut all := get(f.pre, 0) ?? ast.BoolLit(true)\n              for c in drop(f.pre, 1) {\n                all = ast.Binary { op: ast.And, left: all, right: c }\n              }\n              ok := codegen.expr(mut g, all)\n              codegen.pop_scope(mut g)\n              (go, skip) := (\n                codegen.label(mut g, \"build.go\"),\n                codegen.label(mut g, \"build.skip\"),\n              )\n              codegen.emit(\n                mut g,\n                f\"br i1 {ok.op}, label %{go}, label %{skip}\",\n              )\n              codegen.block(mut g, go)\n              codegen.stmt(mut g, step)\n              codegen.br(mut g, skip)\n              codegen.block(mut g, skip)\n            }\n          },\n          None => (),\n        }\n        codegen.pop_scope(mut g)\n        codegen.br(mut g, next)\n      }\n      codegen.block(mut g, next)\n    }\n  }\n  r := match codegen.lookup(g, \"build.x\") {\n    Some(l) => codegen.load(mut g, l),\n    None => codegen.V { ty, op: x },\n  }\n  codegen.dup_value(mut g, r)\n  codegen.drop_from(mut g, 0, \"\")\n  codegen.use_rt(mut g, \"strata_leave\")\n  codegen.emit(mut g, \"call void @strata_leave()\")\n  codegen.emit(mut g, if codegen.has_value(ty) {\n    f\"ret {codegen.ll(ty)} {r.op}\"\n  } else {\n    \"ret void\"\n  })\n  codegen.restore(mut g, saved, codegen.helper_text(\n    g,\n    f\"define {codegen.ll(ty)} {name}(i64 %depth)\",\n  ))\n  name\n}"},{"name":"codegen.table_kind","kind":"fn","old":"da9ff9cd56e9dbad","new":"12e2ee04dabe96ef","interface_changed":true,"affected":["codegen.method_call","codegen.expr_node","codegen.expr_want_node","codegen.expr","codegen.expr_want","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.try_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.compared","codegen.stmt_node","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.function","codegen.declare","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.fuzz_driver","codegen.wanted","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.binds","codegen.matching_v","codegen.assertion","codegen.invariants","codegen.tag_is","codegen.check_type","codegen.satisfies","codegen.holds_pred","codegen.entry","codegen.vtable","codegen.mock_table","codegen.mock_call","codegen.list_builtin","codegen.collection_builtin","codegen.produce","codegen.table_find","codegen.generate","codegen.construct","codegen.operands","codegen.if_expr","codegen.matching","codegen.try_expr","codegen.stmt","codegen.built_or_generated","codegen.get_field","codegen.compiled_alone","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.by_variant","codegen.list_literal","codegen.function_value","codegen.lambda","codegen.to_c","codegen.check_payload","codegen.dyn_ctor_is","codegen.has_field_check","codegen.check_field","codegen.assign_at","codegen.gen_data","codegen.check_union","codegen.check_member","codegen.to_dyn","codegen.dyn_table_is","codegen.mock_value","codegen.builtin","codegen.gen_list","codegen.gen_fn","codegen_with","core_rt_text","computed_value","repl_eval","codegen.session_capability","codegen.union_call","codegen.dyn_generic_call","codegen.iterate","codegen.decreases_start","codegen.decreases_entry","codegen.show","codegen.shown","codegen.string_builtin","codegen.dyn_wrapper","codegen.host","codegen.spawn_expr","codegen.method_value","codegen.foreign_call","codegen.generated","codegen.can_generate","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.session_entry","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","codegen.generated_args","codegen.makers","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.helper","codegen.debug_body","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.equal","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.read_back","eval_files","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// What `changes_as` calls a list (`\"List\"`), a dict (`\"Dict\"`) and a set\n/// (`\"Set\"`). `\"\"` for any other type.\nfn table_kind(t: check.Ty) -> String {\n  match t {\n    check.TList(_) => \"List\",\n    check.TNamed { name: \"Dict\", .. } => \"Dict\",\n    check.TNamed { name: \"Set\", .. } => \"Set\",\n    _ => \"\",\n  }\n}","old_text":"/// What `changes_as` calls a list (`\"List\"`), a dict (`\"Dict\"`) and a set\n/// (`\"Set\"`). `\"\"` for any other type.\nfn table_kind(t: Ty) -> String {\n  match t {\n    TList(_) => \"List\",\n    TNamed { name: \"Dict\", .. } => \"Dict\",\n    TNamed { name: \"Set\", .. } => \"Set\",\n    _ => \"\",\n  }\n}"},{"name":"codegen.session_entry","kind":"fn","old":"4c798d8a005142ab","new":"7d63f029e825d3c0","interface_changed":false,"affected":[],"module":"codegen","text":"/// A `strata repl` line, `strata.call.i`: calls function `key` on the\n/// session's values and hands its result over (`strata_ct_keep`) for the\n/// session to keep.\n/// - The values are compiler/c/jit.c's slots (`strata_repl_words`).\n/// Parameter `k` is slot `k`, borrowed.\n/// - A `mut` parameter is assigned through its slot, so the line's changes\n/// are kept even when a fault ends it.\n/// - A capability parameter is made here instead (`session_capability`).\n/// - A parameter named `strata_retired…` is a value the session let go of,\n/// dropped after the call.\nfn session_entry(mut g: codegen.Gen, i: Int, key: String) -> String {\n  f := match codegen.fn_of(g, key) {\n    Some(x) => x,\n    None => {\n      mut g.errs.push(\n        \"can't compile the call of `\" + key + \"`: no such function\",\n      )\n      return \"\"\n    },\n  }\n  saved := g\n  codegen.start_helper(mut g)\n  g.fname = key\n  codegen.use_rt(mut g, \"strata_ct_keep\")\n  codegen.use_rt(mut g, \"strata_repl_words\")\n  words := codegen.fresh(mut g, \"words\")\n  codegen.emit(mut g, f\"{words} = call ptr @strata_repl_words()\")\n  mut args := []\n  // scalars given to a `mut` parameter in their own slot, written back\n  // after the call\n  mut back := []\n  mut retired := []\n  for (k, p) in enumerate(f.params) {\n    t := codegen.lower(mut g, p.ty)\n    at := codegen.fresh(mut g, \"at\")\n    codegen.emit(\n      mut g,\n      f\"{at} = getelementptr i64, ptr {words}, i64 {k}\",\n    )\n    made := codegen.session_capability(mut g, t)\n    match made {\n      Some(v) => {\n        mut args.push(\n          if p.mutable {\n            slot := codegen.fresh(mut g, \"arg\")\n            mut g.allocas.push(f\"  {slot} = alloca {codegen.ll(v.ty)}\")\n            x := codegen.take_value(mut g, v)\n            codegen.store(mut g, x, slot)\n            codegen.own_slot(\n              mut g,\n              codegen.Local { slot, ty: v.ty },\n            )\n            codegen.V { ty: check.TStr, op: slot }\n          } else {\n            v\n          },\n        )\n        continue\n      },\n      None => (),\n    }\n    w := codegen.fresh(mut g, \"w\")\n    codegen.emit(mut g, f\"{w} = load i64, ptr {at}\")\n    v := codegen.from_slot(mut g, w, t)\n    if starts_with(p.name, \"strata_retired\") {\n      mut retired.push(v)\n    }\n    if !p.mutable {\n      mut args.push(v)\n    } else if codegen.ll(t) == \"i64\" || codegen.ll(t) == \"ptr\" {\n      mut args.push(codegen.V { ty: check.TStr, op: at })\n    } else {\n      slot := codegen.fresh(mut g, \"arg\")\n      mut g.allocas.push(f\"  {slot} = alloca {codegen.ll(t)}\")\n      codegen.store(mut g, v, slot)\n      mut back.push((slot, at, t))\n      mut args.push(codegen.V { ty: check.TStr, op: slot })\n    }\n  }\n  ret := codegen.lower(mut g, f.ret)\n  sym := codegen.instance(mut g, key, f, Dict[String, check.Ty] {})\n  r := codegen.call_at(mut g, ret, sym, args)\n  for (slot, at, t) in back {\n    x := codegen.load(mut g, codegen.Local { slot, ty: t })\n    s := codegen.to_slot(mut g, x)\n    codegen.emit(mut g, f\"store i64 {s}, ptr {at}\")\n  }\n  for v in retired {\n    codegen.drop_value(mut g, v)\n  }\n  v := codegen.take_value(mut g, r)\n  s := codegen.to_slot(mut g, v)\n  codegen.emit(mut g, f\"call void @strata_ct_keep(i64 {s})\")\n  codegen.drop_from(mut g, 0, \"\")\n  codegen.emit(mut g, \"ret void\")\n  codegen.restore(\n    mut g,\n    saved,\n    codegen.helper_text(g, f\"define void @\\\"strata.call.{i}\\\"()\"),\n  )\n  \"\"\n}","old_text":"/// A `strata repl` line, `strata.call.i`: calls function `key` on the\n/// session's values and hands its result over (`strata_ct_keep`) for the\n/// session to keep.\n/// - The values are compiler/c/jit.c's slots (`strata_repl_words`).\n/// Parameter `k` is slot `k`, borrowed.\n/// - A `mut` parameter is assigned through its slot, so the line's changes\n/// are kept even when a fault ends it.\n/// - A capability parameter is made here instead (`session_capability`).\n/// - A parameter named `strata_retired…` is a value the session let go of,\n/// dropped after the call.\nfn session_entry(mut g: codegen.Gen, i: Int, key: String) -> String {\n  f := match codegen.fn_of(g, key) {\n    Some(x) => x,\n    None => {\n      mut g.errs.push(\n        \"can't compile the call of `\" + key + \"`: no such function\",\n      )\n      return \"\"\n    },\n  }\n  saved := g\n  codegen.start_helper(mut g)\n  g.fname = key\n  codegen.use_rt(mut g, \"strata_ct_keep\")\n  codegen.use_rt(mut g, \"strata_repl_words\")\n  words := codegen.fresh(mut g, \"words\")\n  codegen.emit(mut g, f\"{words} = call ptr @strata_repl_words()\")\n  mut args := []\n  // scalars given to a `mut` parameter in their own slot, written back\n  // after the call\n  mut back := []\n  mut retired := []\n  for (k, p) in enumerate(f.params) {\n    t := codegen.lower(mut g, p.ty)\n    at := codegen.fresh(mut g, \"at\")\n    codegen.emit(\n      mut g,\n      f\"{at} = getelementptr i64, ptr {words}, i64 {k}\",\n    )\n    made := codegen.session_capability(mut g, t)\n    match made {\n      Some(v) => {\n        mut args.push(\n          if p.mutable {\n            slot := codegen.fresh(mut g, \"arg\")\n            mut g.allocas.push(f\"  {slot} = alloca {codegen.ll(v.ty)}\")\n            x := codegen.take_value(mut g, v)\n            codegen.store(mut g, x, slot)\n            codegen.own_slot(\n              mut g,\n              codegen.Local { slot, ty: v.ty },\n            )\n            codegen.V { ty: TStr, op: slot }\n          } else {\n            v\n          },\n        )\n        continue\n      },\n      None => (),\n    }\n    w := codegen.fresh(mut g, \"w\")\n    codegen.emit(mut g, f\"{w} = load i64, ptr {at}\")\n    v := codegen.from_slot(mut g, w, t)\n    if starts_with(p.name, \"strata_retired\") {\n      mut retired.push(v)\n    }\n    if !p.mutable {\n      mut args.push(v)\n    } else if codegen.ll(t) == \"i64\" || codegen.ll(t) == \"ptr\" {\n      mut args.push(codegen.V { ty: TStr, op: at })\n    } else {\n      slot := codegen.fresh(mut g, \"arg\")\n      mut g.allocas.push(f\"  {slot} = alloca {codegen.ll(t)}\")\n      codegen.store(mut g, v, slot)\n      mut back.push((slot, at, t))\n      mut args.push(codegen.V { ty: TStr, op: slot })\n    }\n  }\n  ret := codegen.lower(mut g, f.ret)\n  sym := codegen.instance(mut g, key, f, Dict[String, Ty] {})\n  r := codegen.call_at(mut g, ret, sym, args)\n  for (slot, at, t) in back {\n    x := codegen.load(mut g, codegen.Local { slot, ty: t })\n    s := codegen.to_slot(mut g, x)\n    codegen.emit(mut g, f\"store i64 {s}, ptr {at}\")\n  }\n  for v in retired {\n    codegen.drop_value(mut g, v)\n  }\n  v := codegen.take_value(mut g, r)\n  s := codegen.to_slot(mut g, v)\n  codegen.emit(mut g, f\"call void @strata_ct_keep(i64 {s})\")\n  codegen.drop_from(mut g, 0, \"\")\n  codegen.emit(mut g, \"ret void\")\n  codegen.restore(\n    mut g,\n    saved,\n    codegen.helper_text(g, f\"define void @\\\"strata.call.{i}\\\"()\"),\n  )\n  \"\"\n}"},{"name":"codegen.session_capability","kind":"fn","old":"2d8183e90cdbf5f9","new":"e93b8f6355c8abb8","interface_changed":true,"affected":["codegen.session_entry","codegen.generate","codegen_with","core_rt_text","computed_value","repl_eval","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.entry","codegen.new_gen","codegen.compiled_alone","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// What `strata repl` gives a line's parameter of type `t` that is not a\n/// session value:\n/// - a `Console`: the REPL's console (`std.io.ReplConsole`)\n/// - a `Files`, `Environment` or `Commands`: std's `Disk`, `Process` or\n/// `Launcher` (`strata repl --allow`)\n/// - another capability: an empty record\n/// Else `None`.\nfn session_capability(mut g: codegen.Gen, t: check.Ty) -> Option[codegen.V] {\n  match t {\n    check.TTrait(\"std.io.Console\") => {\n      c := codegen.construct(\n        mut g,\n        \"std.io.ReplConsole\",\n        ast.RecordArgs([]),\n      )\n      Some(codegen.to_dyn(mut g, c, \"std.io.Console\"))\n    },\n    // the real ones, given by `strata repl --allow`\n    check.TTrait(\"std.fs.Files\") => {\n      c := codegen.construct(mut g, \"std.fs.Disk\", ast.RecordArgs([]))\n      Some(codegen.to_dyn(mut g, c, \"std.fs.Files\"))\n    },\n    check.TTrait(\"std.process.Environment\") => {\n      c := codegen.construct(\n        mut g,\n        \"std.process.Process\",\n        ast.RecordArgs([]),\n      )\n      Some(codegen.to_dyn(mut g, c, \"std.process.Environment\"))\n    },\n    check.TTrait(\"std.process.Commands\") => {\n      c := codegen.construct(\n        mut g,\n        \"std.process.Launcher\",\n        ast.RecordArgs([]),\n      )\n      Some(codegen.to_dyn(mut g, c, \"std.process.Commands\"))\n    },\n    check.TNamed { name, args: [] } => match get(g.types.ctors, name) {\n      Some(sh) => if len(sh.fields) == 0 {\n        Some(codegen.construct(mut g, name, ast.RecordArgs([])))\n      } else {\n        None\n      },\n      None => None,\n    },\n    _ => None,\n  }\n}","old_text":"/// What `strata repl` gives a line's parameter of type `t` that is not a\n/// session value:\n/// - a `Console`: the REPL's console (`std.io.ReplConsole`)\n/// - a `Files`, `Environment` or `Commands`: std's `Disk`, `Process` or\n/// `Launcher` (`strata repl --allow`)\n/// - another capability: an empty record\n/// Else `None`.\nfn session_capability(mut g: codegen.Gen, t: Ty) -> Option[codegen.V] {\n  match t {\n    TTrait(\"std.io.Console\") => {\n      c := codegen.construct(\n        mut g,\n        \"std.io.ReplConsole\",\n        ast.RecordArgs([]),\n      )\n      Some(codegen.to_dyn(mut g, c, \"std.io.Console\"))\n    },\n    // the real ones, given by `strata repl --allow`\n    TTrait(\"std.fs.Files\") => {\n      c := codegen.construct(mut g, \"std.fs.Disk\", ast.RecordArgs([]))\n      Some(codegen.to_dyn(mut g, c, \"std.fs.Files\"))\n    },\n    TTrait(\"std.process.Environment\") => {\n      c := codegen.construct(\n        mut g,\n        \"std.process.Process\",\n        ast.RecordArgs([]),\n      )\n      Some(codegen.to_dyn(mut g, c, \"std.process.Environment\"))\n    },\n    TTrait(\"std.process.Commands\") => {\n      c := codegen.construct(\n        mut g,\n        \"std.process.Launcher\",\n        ast.RecordArgs([]),\n      )\n      Some(codegen.to_dyn(mut g, c, \"std.process.Commands\"))\n    },\n    TNamed { name, args: [] } => match get(g.types.ctors, name) {\n      Some(sh) => if len(sh.fields) == 0 {\n        Some(codegen.construct(mut g, name, ast.RecordArgs([])))\n      } else {\n        None\n      },\n      None => None,\n    },\n    _ => None,\n  }\n}"},{"name":"codegen.field_written","kind":"fn","old":"1137631a7b535a24","new":"c4aab260cefff482","interface_changed":true,"affected":["codegen.construct_want","codegen.check_field","codegen.place_written","codegen.construct","codegen.expr_w