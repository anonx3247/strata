uiltin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// The value of type `t` that trait value `v` holds, borrowed.\nfn dyn_value(mut g: codegen.Gen, v: codegen.V, t: check.Ty) -> codegen.V {\n  (sp, s) := (codegen.fresh(mut g, \"sp\"), codegen.fresh(mut g, \"s\"))\n  codegen.emit(\n    mut g,\n    f\"{sp} = getelementptr i64, ptr {v.op}, i64 1\",\n  )\n  codegen.emit(mut g, f\"{s} = load i64, ptr {sp}\")\n  codegen.from_slot(mut g, s, t)\n}","old_text":"/// The value of type `t` that trait value `v` holds, borrowed.\nfn dyn_value(mut g: codegen.Gen, v: codegen.V, t: Ty) -> codegen.V {\n  (sp, s) := (codegen.fresh(mut g, \"sp\"), codegen.fresh(mut g, \"s\"))\n  codegen.emit(\n    mut g,\n    f\"{sp} = getelementptr i64, ptr {v.op}, i64 1\",\n  )\n  codegen.emit(mut g, f\"{s} = load i64, ptr {sp}\")\n  codegen.from_slot(mut g, s, t)\n}"},{"name":"codegen.dyn_ctor_is","kind":"fn","old":"7dfd5c43c1914009","new":"8e98b786e9a5f7b4","interface_changed":false,"affected":[],"module":"codegen","text":"/// `v is C` for a trait value: its table is `C`'s type's, and for a sum\n/// variant, the held value is a `C`.\nfn dyn_ctor_is(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  tr: String,\n  c: String,\n) -> codegen.V {\n  t := match codegen.dyn_type_of(g, c) {\n    Some(x) => x,\n    None => return codegen.V { ty: check.TBool, op: \"false\" },\n  }\n  same := codegen.dyn_table_is(mut g, v, tr, t)\n  if codegen.ctors_of(g, t) == [c] {\n    return codegen.V { ty: check.TBool, op: same }\n  }\n  from := codegen.current(g)\n  (yes, end) := (codegen.label(mut g, \"dyn.is\"), codegen.label(mut g, \"dyn.isd\"))\n  codegen.emit(mut g, f\"br i1 {same}, label %{yes}, label %{end}\")\n  codegen.block(mut g, yes)\n  x := codegen.dyn_value(mut g, v, t)\n  hit := codegen.tag_is(mut g, x, c)\n  from_yes := codegen.current(g)\n  codegen.br(mut g, end)\n  codegen.block(mut g, end)\n  r := codegen.fresh(mut g, \"is\")\n  codegen.emit(\n    mut g,\n    f\"{r} = phi i1 [ false, %{from} ], [ {hit.op}, %{from_yes} ]\",\n  )\n  codegen.V { ty: check.TBool, op: r }\n}","old_text":"/// `v is C` for a trait value: its table is `C`'s type's, and for a sum\n/// variant, the held value is a `C`.\nfn dyn_ctor_is(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  tr: String,\n  c: String,\n) -> codegen.V {\n  t := match codegen.dyn_type_of(g, c) {\n    Some(x) => x,\n    None => return codegen.V { ty: TBool, op: \"false\" },\n  }\n  same := codegen.dyn_table_is(mut g, v, tr, t)\n  if codegen.ctors_of(g, t) == [c] {\n    return codegen.V { ty: TBool, op: same }\n  }\n  from := codegen.current(g)\n  (yes, end) := (codegen.label(mut g, \"dyn.is\"), codegen.label(mut g, \"dyn.isd\"))\n  codegen.emit(mut g, f\"br i1 {same}, label %{yes}, label %{end}\")\n  codegen.block(mut g, yes)\n  x := codegen.dyn_value(mut g, v, t)\n  hit := codegen.tag_is(mut g, x, c)\n  from_yes := codegen.current(g)\n  codegen.br(mut g, end)\n  codegen.block(mut g, end)\n  r := codegen.fresh(mut g, \"is\")\n  codegen.emit(\n    mut g,\n    f\"{r} = phi i1 [ false, %{from} ], [ {hit.op}, %{from_yes} ]\",\n  )\n  codegen.V { ty: TBool, op: r }\n}"},{"name":"codegen.whole_sums","kind":"fn","old":"40ba887c9f8cf39f","new":"4275e1020d2df152","interface_changed":true,"affected":["codegen.lower","codegen.entry","codegen.function","codegen.declare","codegen.destructure","codegen.scheme","codegen.method_call","codegen.vtable","codegen.dyn_call","codegen.add_type","codegen.generic_ty","codegen.main_arg","codegen.foreign_call","codegen.generated","codegen.gen_fn","codegen.gen_list","codegen.gen_data","codegen.mock_method","codegen.fuzz_driver","codegen.check_payload","codegen.check_union","codegen.check_member","codegen.declaration_of","codegen.precompilable","codegen.new_gen","codegen.read_back","codegen.self_want","codegen.m