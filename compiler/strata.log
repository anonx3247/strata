, giving a result of type `rt`. The first entries (show, debug,\n/// equality) are what `waits_of` calls `implicit`.\nfn dyn_entry(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  k: Int,\n  rt: check.Ty,\n  args: List[codegen.V],\n) -> codegen.V {\n  codegen.dyn_entry_at(mut g, v, k, rt, args, false, \"implicit\")\n}","old_text":"/// Calls entry `k` of a trait value's table with the value's slot and\n/// `args`, giving a result of type `rt`. The first entries (show, debug,\n/// equality) are what `waits_of` calls `implicit`.\nfn dyn_entry(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  k: Int,\n  rt: Ty,\n  args: List[codegen.V],\n) -> codegen.V {\n  codegen.dyn_entry_at(mut g, v, k, rt, args, false, \"implicit\")\n}"},{"name":"codegen.dyn_call","kind":"fn","old":"37da309b938742c4","new":"4e04b1e4b797caa1","interface_changed":false,"affected":[],"module":"codegen","text":"/// `v.name(args)` on a trait value, through its table.\nfn dyn_call(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  tr: String,\n  name: String,\n  args: List[ast.Expr],\n) -> codegen.V {\n  ms := codegen.dyn_methods(g, tr)\n  mut at := -1\n  for (k, m) in enumerate(ms) {\n    if m.decl.name == name && at < 0 {\n      at = k\n    }\n  }\n  m := match get(ms, at) {\n    Some(m) => m,\n    None => {\n      codegen.not_yet(mut g, \"`.\" + name + \"` on a `\" + tr + \"`\")\n      return codegen.never()\n    },\n  }\n  // `Self` nested in another type (`List[Self]`) is not supported: those\n  // values would be the type's, not the trait's\n  if (drop(m.decl.params, 1).map(p -> p.ty) + [m.decl.ret]).any(\n    t -> !codegen.is_self_type(t) && codegen.mentions_self(t),\n  ) {\n    codegen.not_yet(\n      mut g,\n      f\"calling `{name}` (it mentions `Self` inside another type) on a value of the trait type `{codegen.short(tr)}`\",\n    )\n    return codegen.never()\n  }\n  if m.decl.type_params != [] {\n    return codegen.dyn_generic_call(mut g, v, tr, name, args)\n  }\n  saved := g.sub\n  mut g.sub.insert(\"Self\", check.TTrait(tr))\n  mut ps := []\n  for p in drop(m.decl.params, 1) {\n    mut ps.push(codegen.lower(mut g, p.ty))\n  }\n  rt := codegen.lower(mut g, m.decl.ret)\n  g.sub = saved\n  // the arguments in order, but places given to `mut` parameters last,\n  // once the others have run (a slot holding the place's value, written\n  // back after the call)\n  mut got := Dict[Int, codegen.V] {}\n  mut backs := []\n  for (i, a) in enumerate(args) {\n    mutable := match get(m.decl.params, i + 1) {\n      Some(p) => p.mutable,\n      None => false,\n    }\n    if !mutable {\n      x := codegen.expr_want(mut g, a, get(ps, i) ?? check.TAny)\n      if x.ty is check.TAny {\n        return codegen.never()\n      }\n      mut got.insert(i, x)\n    }\n  }\n  for (i, a) in enumerate(args) {\n    mutable := match get(m.decl.params, i + 1) {\n      Some(p) => p.mutable,\n      None => false,\n    }\n    if mutable {\n      match codegen.place_of(a) {\n        Some((x, path)) => match codegen.lookup(g, x) {\n          Some(l) => {\n            root := codegen.load(mut g, l)\n            cur := codegen.get_path(mut g, root, path)\n            if cur.ty is check.TAny {\n              return codegen.never()\n            }\n            slot := codegen.fresh(mut g, \"mutarg\")\n            mut g.allocas.push(\n              f\"  {slot} = alloca {codegen.ll(cur.ty)}\",\n            )\n            held := codegen.take_value(mut g, cur)\n            codegen.store(mut g, held, slot)\n            mut backs.push((slot, x, path, cur.ty))\n            mut got.insert(i, codegen.V { ty: check.TStr, op: slot })\n          },\n          None => {\n            codegen.not_yet(\n              mut g,\n              \"a `mut` argument that isn't a variable or its field\",\n            )\n            return codegen.never()\n          },\n        },\n        None => {\n          codegen.not_yet(\n            mut g,\n            \"a `mut` argument that isn't a variable or its field\",\n          )\n          return codegen.never()\n        },\n      }\n    }\n  }\n  mut vs := []\n  for i in 0..len(args) {\n    mut vs.push(get(got, i) ?? codegen.unit())\n  }\n  r := codegen.dyn_entry_at(\n    mut g,\n    v,\n    5 + at,\n    rt,\n    vs,\n    codegen.mut_self_decl(m.decl),\n    \"i:\" + name,\n  )\n  for (slot, x, path, t) in backs {\n    match codegen.lookup(g, x) {\n      Some(l) => {\n        nb := codegen.fresh(mut g, \"back\")\n        codegen.emit(\n          mut g,\n          f\"{nb} = load {codegen.ll(t)}, ptr {slot}\",\n        )\n        nv := codegen.temp(mut g, codegen.V { ty: t, op: nb })\n        codegen.assign_at(mut g, l, x, path, nv, false)\n      },\n      None => (),\n    }\n  }\n  r\n}","old_text":"/// `v.name(args)` on a trait value, through its table.\nfn dyn_call(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  tr: String,\n  name: String,\n  args: List[ast.Expr],\n) -> codegen.V {\n  ms := codegen.dyn_methods(g, tr)\n  mut at := -1\n  for (k, m) in enumerate(ms) {\n    if m.decl.name == name && at < 0 {\n      at = k\n    }\n  }\n  m := match get(ms, at) {\n    Some(m) => m,\n    None => {\n      codegen.not_yet(mut g, \"`.\" + name + \"` on a `\" + tr + \"`\")\n      return codegen.never()\n    },\n  }\n  // `Self` nested in another type (`List[Self]`) is not supported: those\n  // values would be the type's, not the trait's\n  if (drop(m.decl.params, 1).map(p -> p.ty) + [m.decl.ret]).any(\n    t -> !codegen.is_self_type(t) && codegen.mentions_self(t),\n  ) {\n    codegen.not_yet(\n      mut g,\n      f\"calling `{name}` (it mentions `Self` inside another type) on a value of the trait type `{codegen.short(tr)}`\",\n    )\n    return codegen.never()\n  }\n  if m.decl.type_params != [] {\n    return codegen.dyn_generic_call(mut g, v, tr, name, args)\n  }\n  saved := g.sub\n  mut g.sub.insert(\"Self\", TTrait(tr))\n  mut ps := []\n  for p in drop(m.decl.params, 1) {\n    mut ps.push(codegen.lower(mut g, p.ty))\n  }\n  rt := codegen.lower(mut g, m.decl.ret)\n  g.sub = saved\n  // the arguments in order, but places given to `mut` parameters last,\n  // once the others have run (a slot holding the place's value, written\n  // back after the call)\n  mut got := Dict[Int, codegen.V] {}\n  mut backs := []\n  for (i, a) in enumerate(args) {\n    mutable := match get(m.decl.params, i + 1) {\n      Some(p) => p.mutable,\n      None => false,\n    }\n    if !mutable {\n      x := codegen.expr_want(mut g, a, get(ps, i) ?? TAny)\n      if x.ty is TAny {\n        return codegen.never()\n      }\n      mut got.insert(i, x)\n    }\n  }\n  for (i, a) in enumerate(args) {\n    mutable := match get(m.decl.params, i + 1) {\n      Some(p) => p.mutable,\n      None => false,\n    }\n    if mutable {\n      match codegen.place_of(a) {\n        Some((x, path)) => match codegen.lookup(g, x) {\n          Some(l) => {\n            root := codegen.load(mut g, l)\n            cur := codegen.get_path(mut g, root, path)\n            if cur.ty is TAny {\n              return codegen.never()\n            }\n            slot := codegen.fresh(mut g, \"mutarg\")\n            mut g.allocas.push(\n              f\"  {slot} = alloca {codegen.ll(cur.ty)}\",\n            )\n            held := codegen.take_value(mut g, cur)\n            codegen.store(mut g, held, slot)\n            mut backs.push((slot, x, path, cur.ty))\n            mut got.insert(i, codegen.V { ty: TStr, op: slot })\n          },\n          None => {\n            codegen.not_yet(\n              mut g,\n              \"a `mut` argument that isn't a variable or its field\",\n            )\n            return codegen.never()\n          },\n        },\n        None => {\n          codegen.not_yet(\n            mut g,\n            \"a `mut` argument that isn't a variable or its field\",\n          )\n          return codegen.never()\n        },\n      }\n    }\n  }\n  mut vs := []\n  for i in 0..len(args) {\n    mut vs.push(get(got, i) ?? codegen.unit())\n  }\n  r := codegen.dyn_entry_at(\n    mut g,\n    v,\n    5 + at,\n    rt,\n    vs,\n    codegen.mut_self_decl(m.decl),\n    \"i:\" + name,\n  )\n  for (slot, x, path, t) in backs {\n    match codegen.lookup(g, x) {\n      Some(l) => {\n        nb := codegen.fresh(mut g, \"back\")\n        codegen.emit(\n          mut g,\n          f\"{nb} = load {codegen.ll(t)}, ptr {slot}\",\n        )\n        nv := codegen.temp(mut g, codegen.V { ty: t, op: nb })\n        codegen.assign_at(mut g, l, x, path, nv, false)\n      },\n      None => (),\n    }\n  }\n  r\n}"},{"name":"codegen.dyn_equal","kind":"fn","old":"d86e40e1d82ae6e9","new":"c531a80a188a0bea","interface_changed":false,"affected":[],"module":"codegen","text":"/// Two trait values are equal when they have the same table (the same\n/// type) and equal values.\nfn dyn_equal(mut g: codegen.Gen, a: codegen.V, b: codegen.V) -> codegen.V {\n  (ra, rb, same) := (\n    codegen.fresh(mut g, \"va\"),\n    codegen.fresh(mut g, \"vb\"),\n    codegen.fresh(mut g, \"samet\"),\n  )\n  codegen.emit(mut g, f\"{ra} = load i64, ptr {a.op}\")\n  codegen.emit(mut g, f\"{rb} = load i64, ptr {b.op}\")\n  codegen.emit(mut g, f\"{same} = icmp eq i64 {ra}, {rb}\")\n  from := codegen.current(g)\n  (deep, end) := (codegen.label(mut g, \"dyn.eq\"), codegen.label(mut g, \"dyn.eqd\"))\n  codegen.emit(mut g, f\"br i1 {same}, label %{deep}, label %{end}\")\n  codegen.block(mut g, deep)\n  sp := codegen.fresh(mut g, \"sp\")\n  codegen.emit(\n    mut g,\n    f\"{sp} = getelementptr i64, ptr {b.op}, i64 1\",\n  )\n  sb := codegen.fresh(mut g, \"sb\")\n  codegen.emit(mut g, f\"{sb} = load i64, ptr {sp}\")\n  e := codegen.dyn_entry(\n    mut g,\n    a,\n    3,\n    check.TBool,\n    [codegen.V { ty: check.TInt, op: sb }],\n  )\n  from_deep := codegen.current(g)\n  codegen.br(mut g, end)\n  codegen.block(mut g, end)\n  r := codegen.fresh(mut g, \"eq\")\n  codegen.emit(\n    mut g,\n    f\"{r} = phi i1 [ false, %{from} ], [ {e.op}, %{from_deep} ]\",\n  )\n  codegen.V { ty: check.TBool, op: r }\n}","old_text":"/// Two trait values are equal when they have the same table (the same\n/// type) and equal values.\nfn dyn_equal(mut g: codegen.Gen, a: codegen.V, b: codegen.V) -> codegen.V {\n  (ra, rb, same) := (\n    codegen.fresh(mut g, \"va\"),\n    codegen.fresh(mut g, \"vb\"),\n    codegen.fresh(mut g, \"samet\"),\n  )\n  codegen.emit(mut g, f\"{ra} = load i64, ptr {a.op}\")\n  codegen.emit(mut g, f\"{rb} = load i64, ptr {b.op}\")\n  codegen.emit(mut g, f\"{same} = icmp eq i64 {ra}, {rb}\")\n  from := codegen.current(g)\n  (deep, end) := (codegen.label(mut g, \"dyn.eq\"), codegen.label(mut g, \"dyn.eqd\"))\n  codegen.emit(mut g, f\"br i1 {same}, label %{deep}, label %{end}\")\n  codegen.block(mut g, deep)\n  sp := codegen.fresh(mut g, \"sp\")\n  codegen.emit(\n    mut g,\n    f\"{sp} = getelementptr i64, ptr {b.op}, i64 1\",\n  )\n  sb := codegen.fresh(mut g, \"sb\")\n  codegen.emit(mut g, f\"{sb} = load i64, ptr {sp}\")\n  e := codegen.dyn_entry(\n    mut g,\n    a,\n    3,\n    TBool,\n    [codegen.V { ty: TInt, op: sb }],\n  )\n  from_deep := codegen.current(g)\n  codegen.br(mut g, end)\n  codegen.block(mut g, end)\n  r := codegen.fresh(mut g, \"eq\")\n  codegen.emit(\n    mut g,\n    f\"{r} = phi i1 [ false, %{from} ], [ {e.op}, %{from_deep} ]\",\n  )\n  codegen.V { ty: TBool, op: r }\n}"},{"name":"codegen.inner_of","kind":"fn","old":"e4e8bf41a22ee33a","new":"e52f446c7552d32d","interface_changed":true,"affected":["codegen.try_want","codegen.or_else","codegen.try_expr","codegen.expr_want_node","codegen.except_expr","codegen.expr_node","codegen.expr_want","codegen.expr","codegen.function","codegen.binary","codegen.declare","codegen.destructure","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.method_call","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.lambda_shown",