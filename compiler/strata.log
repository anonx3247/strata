, [ %next, %body ]\",\n    )\n    codegen.emit(mut g, \"%more = icmp slt i64 %i, %used\")\n    codegen.emit(mut g, \"br i1 %more, label %body, label %done\")\n    codegen.block(mut g, \"body\")\n    codegen.emit(\n      mut g,\n      \"%ep = getelementptr i64, ptr %data, i64 %i\",\n    )\n    codegen.emit(mut g, \"%eraw = load i64, ptr %ep\")\n    x := codegen.from_slot(mut g, \"%eraw\", et)\n    codegen.drop_value(mut g, x)\n    codegen.emit(mut g, \"%next = add i64 %i, 1\")\n    codegen.emit(mut g, \"br label %loop\")\n    codegen.block(mut g, \"done\")\n  }\n  codegen.emit(mut g, \"call void @strata_free(ptr %buf)\")\n  codegen.br(mut g, \"kept\")\n}","old_text":"/// `drop` of a list whose count already reached zero: frees the header and\n/// releases the buffer. On the buffer's last holder, its elements up to\n/// `used` are dropped and it is freed.\nfn drop_list(mut g: codegen.Gen, et: Ty) {\n  codegen.emit(mut g, \"%bp = getelementptr i8, ptr %a, i64 8\")\n  codegen.emit(mut g, \"%buf = load ptr, ptr %bp\")\n  codegen.emit(mut g, \"call void @strata_free(ptr %a)\")\n  codegen.emit(mut g, \"%blast = call i1 @strata.release(ptr %buf)\")\n  codegen.emit(mut g, \"br i1 %blast, label %elements, label %kept\")\n  codegen.block(mut g, \"elements\")\n  if codegen.counted(et) {\n    codegen.emit(mut g, \"%up = getelementptr i8, ptr %buf, i64 8\")\n    codegen.emit(mut g, \"%used = load i64, ptr %up\")\n    codegen.emit(\n      mut g,\n      \"%data = getelementptr i64, ptr %buf, i64 2\",\n    )\n    codegen.emit(mut g, \"br label %loop\")\n    codegen.block(mut g, \"loop\")\n    codegen.emit(\n      mut g,\n      \"%i = phi i64 [ 0, %elements ], [ %next, %body ]\",\n    )\n    codegen.emit(mut g, \"%more = icmp slt i64 %i, %used\")\n    codegen.emit(mut g, \"br i1 %more, label %body, label %done\")\n    codegen.block(mut g, \"body\")\n    codegen.emit(\n      mut g,\n      \"%ep = getelementptr i64, ptr %data, i64 %i\",\n    )\n    codegen.emit(mut g, \"%eraw = load i64, ptr %ep\")\n    x := codegen.from_slot(mut g, \"%eraw\", et)\n    codegen.drop_value(mut g, x)\n    codegen.emit(mut g, \"%next = add i64 %i, 1\")\n    codegen.emit(mut g, \"br label %loop\")\n    codegen.block(mut g, \"done\")\n  }\n  codegen.emit(mut g, \"call void @strata_free(ptr %buf)\")\n  codegen.br(mut g, \"kept\")\n}"},{"name":"codegen.builtin","kind":"fn","old":"cafd6d9670056a49","new":"5b951413de5e9d20","interface_changed":false,"affected":[],"module":"codegen","text":"/// A built-in compiled inline: on sets, dictionaries, strings, lists and\n/// numbers, and `print`, `to_string`, `debug`.\nfn builtin(mut g: codegen.Gen, name: String, vs: List[codegen.V]) -> codegen.V {\n  // a sized integer conversion\n  match codegen.conversion(mut g, name, vs) {\n    Some(v) => return v,\n    None => (),\n  }\n  if [\n    \"channel_send\",\n    \"channel_recv\",\n    \"channel_close\",\n    \"host_virtual_now\",\n    \"host_virtual_sleep\",\n  ].any(\n    x -> x == name,\n  ) {\n    return codegen.channel_op(mut g, name, vs)\n  }\n  // raw memory (core.mem): plain loads and stores on machine integers\n  match codegen.mem_builtin(mut g, name, vs) {\n    Some(v) => return v,\n    None => (),\n  }\n  if name == \"matches\" && len(vs) == 2 {\n    return codegen.regex_matches(mut g, vs)\n  }\n  if starts_with(name, \"host_\") {\n    return codegen.host(mut g, name, vs)\n  }\n  first := get(vs, 0) ?? codegen.unit()\n  // an iterator or another program type: its own method\n  k := codegen.own_builtin(mut g, name, first)\n  if k != \"\" {\n    return codegen.call_fn(mut g, k, vs, [])\n  }\n  match (name, len(vs)) {\n    (\"print\", 1) => {\n      sv := codegen.show(mut g, first)\n      return codegen.call(mut g, check.TUnit, \"strata_print\", [sv])\n    },\n    (\"to_string\", 1) => return codegen.show(mut g, first),\n    (\"debug\", 1) => return codegen.shown(mut g, first),\n    (\"compare\", 2) => return codegen.compare_values(\n      mut g,\n      first,\n      get(vs, 1) ?? codegen.unit(),\n    ),\n    _ => (),\n  }\n  if codegen.is_collection(first.ty)\n    || (name == \"set\" || name == \"dict\") && first.ty is check.TList {\n    return codegen.collection_builtin(mut g, name, vs)\n  }\n  if first.ty is check.TStr || name == \"chr\" {\n    return codegen.string_builtin(mut g, name, vs)\n  }\n  if codegen.is_list_builtin(name) {\n    return codegen.list_builtin(mut g, name, vs)\n  }\n  match (name, len(vs)) {\n    (\"print\", 1) => {\n      s := codegen.show(mut g, first)\n      codegen.call(mut g, check.TUnit, \"strata_print\", [s])\n    },\n    (\"to_string\", 1) => codegen.show(mut g, first),\n    (\"debug\", 1) => codegen.shown(mut g, first),\n    _ => codegen.number_builtin(mut g, name, vs),\n  }\n}","old_text":"/// A built-in compiled inline: on sets, dictionaries, strings, lists and\n/// numbers, and `print`, `to_string`, `debug`.\nfn builtin(mut g: codegen.Gen, name: String, vs: List[codegen.V]) -> codegen.V {\n  // a sized integer conversion\n  match codegen.conversion(mut g, name, vs) {\n    Some(v) => return v,\n    None => (),\n  }\n  if [\n    \"channel_send\",\n    \"channel_recv\",\n    \"channel_close\",\n    \"host_virtual_now\",\n    \"host_virtual_sleep\",\n  ].any(\n    x -> x == name,\n  ) {\n    return codegen.channel_op(mut g, name, vs)\n  }\n  // raw memory (core.mem): plain loads and stores on machine integers\n  match codegen.mem_builtin(mut g, name, vs) {\n    Some(v) => return v,\n    None => (),\n  }\n  if name == \"matches\" && len(vs) == 2 {\n    return codegen.regex_matches(mut g, vs)\n  }\n  if starts_with(name, \"host_\") {\n    return codegen.host(mut g, name, vs)\n  }\n  first := get(vs, 0) ?? codegen.unit()\n  // an iterator or another program type: its own method\n  k := codegen.own_builtin(mut g, name, first)\n  if k != \"\" {\n    return codegen.call_fn(mut g, k, vs, [])\n  }\n  match (name, len(vs)) {\n    (\"print\", 1) => {\n      sv := codegen.show(mut g, first)\n      return codegen.call(mut g, TUnit, \"strata_print\", [sv])\n    },\n    (\"to_string\", 1) => return codegen.show(mut g, first),\n    (\"debug\", 1) => return codegen.shown(mut g, first),\n    (\"compare\", 2) => return codegen.compare_values(\n      mut g,\n      first,\n      get(vs, 1) ?? codegen.unit(),\n    ),\n    _ => (),\n  }\n  if codegen.is_collection(first.ty)\n    || (name == \"set\" || name == \"dict\") && first.ty is TList {\n    return codegen.collection_builtin(mut g, name, vs)\n  }\n  if first.ty is TStr || name == \"chr\" {\n    return codegen.string_builtin(mut g, name, vs)\n  }\n  if codegen.is_list_builtin(name) {\n    return codegen.list_builtin(mut g, name, vs)\n  }\n  match (name, len(vs)) {\n    (\"print\", 1) => {\n      s := codegen.show(mut g, first)\n      codegen.call(mut g, TUnit, \"strata_print\", [s])\n    },\n    (\"to_string\", 1) => codegen.show(mut g, first),\n    (\"debug\", 1) => codegen.shown(mut g, first),\n    _ => codegen.number_builtin(mut g, name, vs),\n  }\n}"},{"name":"codegen.ground","kind":"fn","old":"9da969ebe1226524","new":"8516b15e7f732ca0","interface_changed":true,"affected":["codegen.call_fn_want","codegen.impl_args","codegen.construct_want","codegen.lambda_shown","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.bind_bounds","codegen.construct","codegen.expr_want_node","codegen.function_value","codegen.lambda","codegen.expr_node","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.builtin_call","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.main_arg","codegen.select_expr","codegen.session_capability","codegen.expr_want","codegen.spawn_expr","codegen.produce","codegen.method_value","codegen.expr","codegen.entry","codegen.interp","codegen.format_spec","codegen.union_text","codegen.destructure","codegen.deb