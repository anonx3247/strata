structors.\npub type Types = {\n  named: Dict[String, List[String]],\n  sums: Set[String],\n  ctors: Dict[String, check.Shape],\n  // what the program's aliases without type parameters stand for\n  // (`type Id = Int | String`, `type Small = Int where it < 10`)\n  aliases: Dict[String, ast.TypeExpr],\n  // the program's traits usable as types (`List[Shape]`)\n  traits: Set[String],\n  // each refined alias's base and predicate (`type Port = Int where …`)\n  refinements: Dict[String, (ast.TypeExpr, ast.Expr)] = Dict[String, (ast.TypeExpr, ast.Expr)] {},\n  // each function's result type as written (`-> Int where it == 5`)\n  rets: Dict[String, ast.TypeExpr] = Dict[String, ast.TypeExpr] {},\n  // each function's `mut` parameters' types as written (`None`: not `mut`)\n  mut_written: Dict[String, List[Option[ast.TypeExpr]]] = Dict[String, List[Option[ast.TypeExpr]]] {},\n  // each sum's constructors, in order\n  variants: Dict[String, List[String]] = Dict[String, List[String]] {},\n  // each function's parameters' names and what it says of its result: its\n  // result type's refinement and its `ensures` (`narrowed_result`)\n  narrows: Dict[String, (List[String], List[ast.Expr])] = Dict[String, (List[String], List[ast.Expr])] {},\n}","old_text":"/// The program's record and sum types the checker models (without\n/// refinements), with their type parameters, the sums among them, and their\n/// constructors.\npub type Types = {\n  named: Dict[String, List[String]],\n  sums: Set[String],\n  ctors: Dict[String, check.Shape],\n  // what the program's aliases without type parameters stand for\n  // (`type Id = Int | String`, `type Small = Int where it < 10`)\n  aliases: Dict[String, ast.TypeExpr],\n  // the program's traits usable as types (`List[Shape]`)\n  traits: Set[String],\n  // each refined alias's base and predicate (`type Port = Int where …`)\n  refinements: Dict[String, (ast.TypeExpr, ast.Expr)] = Dict[String, (ast.TypeExpr, ast.Expr)] {},\n  // each function's result type as written (`-> Int where it == 5`)\n  rets: Dict[String, ast.TypeExpr] = Dict[String, ast.TypeExpr] {},\n  // each function's `mut` parameters' types as written (`None`: not `mut`)\n  mut_written: Dict[String, List[Option[ast.TypeExpr]]] = Dict[String, List[Option[ast.TypeExpr]]] {},\n  // each sum's constructors, in order\n  variants: Dict[String, List[String]] = Dict[String, List[String]] {},\n}"},{"name":"check.infer_call","kind":"fn","old":"7ce6aee2298c2035","new":"85e35fc57c5fdc2f","interface_changed":false,"affected":[],"module":"check","text":"fn infer_call(\n  mut i: check.Inf,\n  callee: ast.Expr,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n) -> check.Ty {\n  // `remove(d, k)` stored as a method of a trait a module imports\n  // (`std.fs.remove`), on a list, dict or set: it is the built-in, which\n  // changes its argument, so it must be the method `mut d.remove(k)`\n  match (callee, args) {\n    (ast.Var(n), [first, ..]) => {\n      parts := split(n, \".\")\n      s := get(parts, len(parts) - 1) ?? n\n      if s != n\n        && builtins.changing(s)\n        && (first is ast.Var || first is ast.FieldOf) {\n        ft := check.res(i, check.infer(mut i, first, env, None))\n        if ft is check.TList || check.is_table(ft) {\n          check.error(mut i, \"`\"\n            + check.short_code(ast.Call { callee: ast.Var(s), args })\n            + \"`: `\"\n            + s\n            + \"` changes the list, dict or set it is called on: write `mut \"\n            + text.expr_text(first, 0)\n            + \".\"\n            + s\n            + \"(…)`\"\n            + check.new_value_hint(s))\n          check.infer_all(mut i, drop(args, 1), env)\n          return check.TAny\n        }\n      }\n    },\n    _ => (),\n  }\n  // a built-in function, unless a local or one of the program's\n  match callee {\n    ast.Var(n) => if !contains(env, n) && get(i.fns, n) is None {\n      match get(i.builtins, n) {\n        Some(bs) => {\n          // `take(it, 2)` on an iterator: the method of core's trait its type\n          // implements (`it.take(2)`). Only a variable or a constructor is looked\n          // at first, since inferring an expression twice would type its lambdas\n          // twice.\n          match args {\n            [first, ..rest] => if first is ast.Var || first is ast.CtorExpr {\n              match check.res(i, check.infer(mut i, first, env, None)) {\n                check.TNamed { name, .. } => if check.code_trait_method(i, name, n, check.TAny) is Some {\n                  return check.infer_method(\n                    mut i,\n                    first,\n                    n,\n                    rest,\n                    env,\n                    false,\n                  )\n                },\n                _ => (),\n              }\n            } else if first is ast.Call || first is ast.MethodCall {\n              // a call, as in `map(filter(it, f), g)` from a comprehension over an\n              // iterator: inferred once, then the method on what it gives, or the\n              // built-in given its type\n              t0 := check.listed_arg(\n                mut i,\n                n,\n                0,\n                first,\n                check.shown_as(n, check.TAny),\n                check.infer(mut i, first, env, None),\n                \"call to `\" + n + \"`\",\n              )\n              match check.iter_builtin(\n                mut i,\n                n,\n                check.res(i, t0),\n                rest,\n                env,\n              ) {\n                Some(t) => return t,\n                None => (),\n              }\n              match check.res(i, t0) {\n                check.TNamed { name, .. } => if check.code_trait_method(i, name, n, check.TAny) is Some {\n                  return check.infer_method(\n                    mut i,\n                    ast.Var(\"$first\"),\n                    n,\n                    rest,\n                    {\n                      mut copy := env\n                      mut copy.insert(\"$first\", t0)\n                      copy\n                    },\n                    false,\n                  )\n                },\n                _ => (),\n              }\n              return check.builtin_call(mut i, n, bs, [t0], rest, env)\n            },\n            [] => (),\n          }\n          // one that changes a list, dict or set is a method: `mut xs.push(x)`\n          if bs.any(b -> b.changes) {\n            check.error(mut i, \"`\"\n              + check.short_code(ast.Call { callee, args })\n              + \"`: `\"\n              + n\n              + \"` changes the \"\n              + \"list, dict or set it is called on: write `mut \"\n              + text.expr_text(\n                check.unmarked_arg(get(args, 0) ?? ast.UnitExpr),\n                0,\n              )\n              + \".\"\n              + n\n              + \"(…)`\"\n              + check.new_value_hint(n))\n            check.infer_all(mut i, args, env)\n            return check.TAny\n          }\n          // a built-in has no `mut` parameters\n          for a in args {\n            match a {\n              ast.MutExpr(x) => if !(x is ast.MethodCall) {\n                check.error(mut i, \"`\"\n                  + text.expr_text(a, 0)\n                  + \"`: `\"\n                  + n\n                  + \"` has no `mut` parameters\")\n              },\n              _ => (),\n            }\n          }\n          return check.builtin_call(mut i, n, bs, [], args, env)\n        },\n        None => (),\n      }\n    },\n    _ => (),\n  }\n  // one of the program's functions with bounds: its type parameters are\n  // kept, to check the bounds once the arguments are checked\n  (ct, vars, bounds) := match callee {\n    ast.Var(n) => if !contains(env, n) && len(get(i.methods.bounds, n) ?? []) > 0 {\n      match get(i.fns, n) {\n        Some(t) => {\n          m := check.fresh_for(\n            mut i,\n            to_list(check.gens(t, Set[String] {})),\n          )\n          (check.inst(t, m), m, get(i.methods.bounds, n) ?? [])\n        },\n        None => (\n          check.infer(mut i, callee, env, None),\n          Dict[String, check.Ty] {},\n          [],\n        ),\n      }\n    } else if !contains(env, n) && get(i.fns, n) is None {\n      // a method called as a function, `describe(x)`, is resolved by its\n      // argument; only a value of it is ambiguous\n      (\n        check.trait_fn_of(mut i, n, false),\n        Dict[String, check.Ty] {},\n        [],\n      )\n    } else {\n      (\n        check.infer(mut i, callee, env, None),\n        Dict[String, check.Ty] {},\n        [],\n      )\n    },\n    _ => (\n      check.infer(mut i, callee, env, None),\n      Dict[String, check.Ty] {},\n      [],\n    ),\n  }\n  what := match callee {\n    ast.Var(n) => \"call to `\" + n + \"`\",\n    _ => \"call\",\n  }\n  match check.res(i, ct) {\n    check.TFn { params, ret } => {\n      // a wrong number of arguments is reported by `expression_errors`\n      mut arg_types := []\n      if len(params) == len(args) {\n        for (k, a) in enumerate(args) {\n          p := get(params, k) ?? check.TAny\n          at := check.listed_arg(\n            mut i,\n            check.n_of(callee),\n            k,\n            a,\n            p,\n            check.infer(mut i, a, env, Some(p)),\n            what,\n          )\n          mut arg_types.push(at)\n          check.expect(\n            mut i,\n            p,\n            at,\n            what + \", argument \" + to_string(k + 1),\n          )\n          // a `mut` parameter takes its exact type: the function can put any value\n          // of it into the caller's variable\n          mp := get(\n            get(i.methods.mut_params, check.n_of(callee)) ?? [],\n            k,\n          ) ?? check.TAny\n          if !(check.res(i, at) is check.TVariants)\n            && !(mp is check.TTrait)\n            && check.exact_differs(mp, check.res(i, at)) {\n            match (check.shown(mp), check.shown(check.res(i, at))) {\n              (Some(w), Some(g)) => check.error(mut i, what\n                + \", argument \"\n                + to_string(k + 1)\n                + \": expected exactly `\"\n                + w\n                + \"`, found `\"\n                + g\n                + \"` (the parameter is `mut`, so the function can put any `\"\n                + w\n                + \"` into the caller's variable)\"),\n              _ => (),\n            }\n          } else if check.mut_narrower(i, check.n_of(callee), k, a) is Some {\n            // nor a value the variable's own refinement rules out\n            match check.mut_narrower(i, check.n_of(callee), k, a) {\n              Some((x, vw, pw)) => check.error(mut i, what\n                + \", argument \"\n                + to_string(k + 1)\n                + \": `\"\n                + x\n                + \"` is declared `\"\n                + text.type_text(vw)\n                + \"`, but the `mut` parameter is `\"\n                + text.type_text(pw)\n                + \"`: the function could store a value `\"\n                + x\n                + \"` must never hold\"),\n              None => (),\n            }\n          } else if !(mp is check.TAny)\n            && len(check.gens(mp, Set[String] {})) == 0 {\n            // a variable whose type isn't known yet (`mut xs := []`) takes the\n            // parameter's\n            _ := check.unify(mut i, mp, at, 100)\n          }\n        }\n        // each bound: the type the parameter stands for implements the trait\n        for b in bounds {\n          if contains(i.methods.checked, b.1) {\n            // a type nothing has determined yet: an obligation, reported at the end\n            // if nothing does\n            match check.res(i, get(vars, b.0) ?? check.TAny) {\n              check.TVar(_) => mut i.pending.push(\n                (\n                  get(vars, b.0) ?? check.TAny,\n                  b.1,\n                  check.n_of(callee),\n                ),\n              ),\n              _ => (),\n            }\n            match check.shown(check.res(i, get(vars, b.0) ?? check.TAny)) {\n              Some(x) => if !check.implements(\n                i,\n                check.res(i, get(vars, b.0) ?? check.TAny),\n                b.1,\n              ) {\n                check.error(mut i, \"calling `\"\n                  + check.n_of(callee)\n                  + \"`: `\"\n                  + x\n                  + \"` does not implement `\"\n                  + b.1\n                  + \"`\")\n              },\n              None => (),\n            }\n          }\n        }\n      }\n      // a program function's result, narrowed by what it says of it\n      match callee {\n        ast.Var(n) => if !contains(env, n) && len(arg_types) == len(args) {\n          check.narrowed_result(i, n, arg_types, ret)\n        } else {\n          ret\n        },\n        _ => ret,\n      }\n    },\n    // a value that is not a function (`n(2)` with `n: Int`)\n    other => {\n      match (callee, check.shown(other)) {\n        (ast.Var(_), Some(x)) => if !(other is check.TFn) {\n          check.error(\n            mut i,\n            what + \": `\" + x + \"` is not a function\",\n          )\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}","old_text":"fn infer_call(\n  mut i: check.Inf,\n  callee: ast.Expr,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n) -> check.Ty {\n  // `remove(d, k)` stored as a method of a trait a module imports\n  // (`std.fs.remove`), on a list, dict or set: it is the built-in, which\n  // changes its argument, so it must be the method `mut d.remove(k)`\n  match (callee, args) {\n    (ast.Var(n), [first, ..]) => {\n      parts := split(n, \".\")\n      s := get(parts, len(parts) - 1) ?? n\n      if s != n\n        && builtins.changing(s)\n        && (first is ast.Var || first is ast.FieldOf) {\n        ft := check.res(i, check.infer(mut i, first, env, None))\n        if ft is check.TList || check.is_table(ft) {\n          check.error(mut i, \"`\"\n            + check.short_code(ast.Call { callee: ast.Var(s), args })\n            + \"`: `\"\n            + s\n            + \"` changes the list, dict or set it is called on: write `mut \"\n            + text.expr_text(first, 0)\n            + \".\"\n            + s\n            + \"(…)`\"\n            + check.new_value_hint(s))\n          check.infer_all(mut i, drop(args, 1), env)\n          return check.TAny\n        }\n      }\n    },\n    _ => (),\n  }\n  // a built-in function, unless a local or one of the program's\n  match callee {\n    ast.Var(n) => if !contains(env, n) && get(i.fns, n) is None {\n      match get(i.builtins, n) {\n        Some(bs) => {\n          // `take(it, 2)` on an iterator: the method of core's trait its type\n          // implements (`it.take(2)`). Only a variable or a constructor is looked\n          // at first, since inferring an expression twice would type its lambdas\n          // twice.\n          match args {\n            [first, ..rest] => if first is ast.Var || first is ast.CtorExpr {\n              match check.res(i, check.infer(mut i, first, env, None)) {\n                check.TNamed { name, .. } => if check.code_trait_method(i, name, n, check.TAny) is Some {\n                  return check.infer_method(\n                    mut i,\n                    first,\n                    n,\n                    rest,\n                    env,\n                    false,\n                  )\n                },\n                _ => (),\n              }\n            } else if first is ast.Call || first is ast.MethodCall {\n              // a call, as in `map(filter(it, f), g)` from a comprehension over an\n              // iterator: inferred once, then the method on what it gives, or the\n              // built-in given its type\n              t0 := check.listed_arg(\n                mut i,\n                n,\n                0,\n                first,\n                check.shown_as(n, check.TAny),\n                check.infer(mut i, first, env, None),\n                \"call to `\" + n + \"`\",\n              )\n              match check.iter_builtin(\n                mut i,\n                n,\n                check.res(i, t0),\n                rest,\n                env,\n              ) {\n                Some(t) => return t,\n                None => (),\n              }\n              match check.res(i, t0) {\n                check.TNamed { name, .. } => if check.code_trait_method(i, name, n, check.TAny) is Some {\n                  return check.infer_method(\n                    mut i,\n                    ast.Var(\"$first\"),\n                    n,\n                    rest,\n                    {\n                      mut copy := env\n                      mut copy.insert(\"$first\", t0)\n                      copy\n                    },\n                    false,\n                  )\n                },\n                _ => (),\n              }\n              return check.builtin_call(mut i, n, bs, [t0], rest, env)\n            },\n            [] => (),\n          }\n          // one that changes a list, dict or set is a method: `mut xs.push(x)`\n          if bs.any(b -> b.changes) {\n            check.error(mut i, \"`\"\n              + check.short_code(ast.Call { callee, args })\n              + \"`: `\"\n              + n\n              + \"` changes the \"\n              + \"list, dict or set it is called on: write `mut \"\n              + text.expr_text(\n                check.unmarked_arg(get(args, 0) ?? ast.UnitExpr),\n                0,\n              )\n              + \".\"\n              + n\n              + \"(…)`\"\n              + check.new_value_hint(n))\n            check.infer_all(mut i, args, env)\n            return check.TAny\n          }\n          // a built-in has no `mut` parameters\n          for a in args {\n            match a {\n              ast.MutExpr(x) => if !(x is ast.MethodCall) {\n                check.error(mut i, \"`\"\n                  + text.expr_text(a, 0)\n                  + \"`: `\"\n                  + n\n                  + \"` has no `mut` parameters\")\n              },\n              _ => (),\n            }\n          }\n          return check.builtin_call(mut i, n, bs, [], args, env)\n        },\n        None => (),\n      }\n    },\n    _ => (),\n  }\n  // one of the program's functions with bounds: its type parameters are\n  // kept, to check the bounds once the arguments are checked\n  (ct, vars, bounds) := match callee {\n    ast.Var(n) => if !contains(env, n) && len(get(i.methods.bounds, n) ?? []) > 0 {\n      match get(i.fns, n) {\n        Some(t) => {\n          m := check.fresh_for(\n            mut i,\n            to_list(check.gens(t, Set[String] {})),\n          )\n          (check.inst(t, m), m, get(i.methods.bounds, n) ?? [])\n        },\n        None => (\n          check.infer(mut i, callee, env, None),\n          Dict[String, check.Ty] {},\n          [],\n        ),\n      }\n    } else if !contains(env, n) && get(i.fns, n) is None {\n      // a method called as a function, `describe(x)`, is resolved by its\n      // argument; only a value of it is ambiguous\n      (\n        check.trait_fn_of(mut i, n, false),\n        Dict[String, check.Ty] {},\n        [],\n      )\n    } else {\n      (\n        check.infer(mut i, callee, env, None),\n        Dict[String, check.Ty] {},\n        [],\n      )\n    },\n    _ => (\n      check.infer(mut i, callee, env, None),\n      Dict[String, check.Ty] {},\n      [],\n    ),\n  }\n  what := match callee {\n    ast.Var(n) => \"call to `\" + n + \"`\",\n    _ => \"call\",\n  }\n  match check.res(i, ct) {\n    check.TFn { params, ret } => {\n      // a wrong number of arguments is reported by `expression_errors`\n      if len(params) == len(args) {\n        for (k, a) in enumerate(args) {\n          p := get(params, k) ?? check.TAny\n          at := check.listed_arg(\n            mut i,\n            check.n_of(callee),\n            k,\n            a,\n            p,\n            check.infer(mut i, a, env, Some(p)),\n            what,\n          )\n          check.expect(\n            mut i,\n            p,\n            at,\n            what + \", argument \" + to_string(k + 1),\n          )\n          // a `mut` parameter takes its exact type: the function can put any value\n          // of it into the caller's variable\n          mp := get(\n            get(i.methods.mut_params, check.n_of(callee)) ?? [],\n            k,\n          ) ?? check.TAny\n          if !(check.res(i, at) is check.TVariants)\n            && !(mp is check.TTrait)\n            && check.exact_differs(mp, check.res(i, at)) {\n            match (check.shown(mp), check.shown(check.res(i, at))) {\n              (Some(w), Some(g)) => check.error(mut i, what\n                + \", argument \"\n                + to_string(k + 1)\n                + \": expected exactly `\"\n                + w\n                + \"`, found `\"\n                + g\n                + \"` (the parameter is `mut`, so the function can put any `\"\n                + w\n                + \"` into the caller's variable)\"),\n              _ => (),\n            }\n          } else if check.mut_narrower(i, check.n_of(callee), k, a) is Some {\n            // nor a value the variable's own refinement rules out\n            match check.mut_narrower(i, check.n_of(callee), k, a) {\n              Some((x, vw, pw)) => check.error(mut i, what\n                + \", argument \"\n                + to_string(k + 1)\n                + \": `\"\n                + x\n                + \"` is declared `\"\n                + text.type_text(vw)\n                + \"`, but the `mut` parameter is `\"\n                + text.type_text(pw)\n                + \"`: the function could store a value `\"\n                + x\n                + \"` must never hold\"),\n              None => (),\n            }\n          } else if !(mp is check.TAny)\n            && len(check.gens(mp, Set[String] {})) == 0 {\n            // a variable whose type isn't known yet (`mut xs := []`) takes the\n            // parameter's\n            _ := check.unify(mut i, mp, at, 100)\n          }\n        }\n        // each bound: the type the parameter stands for implements the trait\n        for b in bounds {\n          if contains(i.methods.checked, b.1) {\n            // a type nothing has determined yet: an obligation, reported at the end\n            // if nothing does\n            match check.res(i, get(vars, b.0) ?? check.TAny) {\n              check.TVar(_) => mut i.pending.push(\n                (\n                  get(vars, b.0) ?? check.TAny,\n                  b.1,\n                  check.n_of(callee),\n                ),\n              ),\n              _ => (),\n            }\n            match check.shown(check.res(i, get(vars, b.0) ?? check.TAny)) {\n              Some(x) => if !check.implements(\n                i,\n                check.res(i, get(vars, b.0) ?? check.TAny),\n                b.1,\n              ) {\n                check.error(mut i, \"calling `\"\n                  + check.n_of(callee)\n                  + \"`: `\"\n                  + x\n                  + \"` does not implement `\"\n                  + b.1\n                  + \"`\")\n              },\n              None => (),\n            }\n          }\n        }\n      }\n      ret\n    },\n    // a value that is not a function (`n(2)` with `n: Int`)\n    other => {\n      match (callee, check.shown(other)) {\n        (ast.Var(_), Some(x)) => if !(other is check.TFn) {\n          check.error(\n            mut i,\n            what + \": `\" + x + \"` is not a function\",\n          )\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}"},{"name":"check.types_of","kind":"fn","old":"3ecf29294cae402e","new":"86643f0534f2d5b3","interface_changed":false,"affected":[],"module":"check","text":"/// The program's record and sum types the checker models, by the names the\n/// stored form uses.\npub fn types_of(decls: List[ast.Decl]) -> check.Types {\n  // `Option` and `Result` come with the language\n  mut named := Dict[String, List[String]] { \"Option\": [\"T\"], \"Result\": [\"T\", \"E\"], \"Dict\": [\"K\", \"V\"], \"Set\": [\"A\"], \"Task\": [\"T\"], \"Sender\": [\"T\"], \"Receiver\": [\"T\"] }\n  mut sums := Set[String] { \"Option\", \"Result\" }\n  mut traits := Set[String] {}\n  for d in decls {\n    match d.kind {\n      // a capability's too, like `Console`: its methods' types are checked\n      ast.TraitDef(t) => if len(t.params) == 0 {\n        mut traits.insert(check.qualified(d.module, t.name))\n      },\n      _ => (),\n    }\n  }\n  mut aliases := Dict[String, ast.TypeExpr] {}\n  mut refinements := Dict[String, (ast.TypeExpr, ast.Expr)] {}\n  mut rets := Dict[String, ast.TypeExpr] {}\n  mut mut_written := Dict[String, List[Option[ast.TypeExpr]]] {}\n  mut narrows := Dict[String, (List[String], List[ast.Expr])] {}\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => if !t.distinct && len(t.params) == 0 {\n        match (t.body, t.refinement) {\n          (ast.Alias(a), Some(pred)) => mut refinements.insert(\n            check.qualified(d.module, t.name),\n            (a, pred),\n          ),\n          _ => (),\n        }\n      },\n      ast.FnDef(f) => {\n        mut rets.insert(check.qualified(d.module, f.name), f.ret)\n        facts := match f.ret {\n          ast.Refined { pred, .. } => [pred] + f.post,\n          _ => f.post,\n        }\n        if len(facts) > 0 && len(f.type_params) == 0 {\n          mut narrows.insert(\n            check.qualified(d.module, f.name),\n            (f.params.map(p -> p.name), facts),\n          )\n        }\n        mut mut_written.insert(\n          check.qualified(d.module, f.name),\n          f.params.map(\n            p -> if p.mutable {\n              Some(p.ty)\n            } else {\n              None\n            },\n          ),\n        )\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      // an alias, refined or not, is the type it stands for. A record or a sum,\n      // refined or not, is a type of its own; its refinement is verify's, and\n      // its fields are checked as an unrefined one's are.\n      ast.TypeDef(t) => if !t.distinct {\n        q := check.qualified(d.module, t.name)\n        match t.body {\n          ast.Alias(a) => if len(t.params) == 0 {\n            mut aliases.insert(q, a)\n          },\n          ast.RecordBody(_) => mut named.insert(q, t.params),\n          ast.SumBody(vs) => if !vs.any(v -> v.payload is ast.MemberType) {\n            mut named.insert(q, t.params)\n            mut sums.insert(q)\n          },\n        }\n      } else if t.distinct {\n        // a `distinct` type: a type of its own, made of one field, `value`\n        mut named.insert(check.qualified(d.module, t.name), t.params)\n      },\n      _ => (),\n    }\n  }\n  mut ctors := Dict[String, check.Shape] { \"Some\": check.Shape {\n    owner: \"Option\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"None\": check.Shape {\n    owner: \"Option\",\n    fields: [],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"Ok\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  }, \"Err\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"E\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  } }\n  partial := check.Types {\n    named,\n    sums,\n    ctors: Dict[String, check.Shape] {},\n    aliases,\n    traits,\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => {\n        q := check.qualified(d.module, t.name)\n        if contains(named, q) {\n          tps := set(t.params)\n          match t.body {\n            ast.RecordBody(fs) => mut ctors.insert(\n              q,\n              check.Shape {\n                owner: q,\n                fields: fs.map(\n                  f -> (f.name, check.lower(partial, tps, f.ty)),\n                ),\n                positional: false,\n                required: check.required(fs),\n                params: t.params,\n              },\n            ),\n            ast.SumBody(vs) => {\n              for v in vs {\n                sh := match v.payload {\n                  ast.Positional(ts) => check.Shape {\n                    owner: q,\n                    fields: ts.map(x -> (\"\", check.lower(partial, tps, x))),\n                    positional: true,\n                    required: [],\n                    params: t.params,\n                  },\n                  ast.RecordPayload(fs) => check.Shape {\n                    owner: q,\n                    fields: fs.map(\n                      f -> (f.name, check.lower(partial, tps, f.ty)),\n                    ),\n                    positional: false,\n                    required: check.required(fs),\n                    params: t.params,\n                  },\n                  _ => check.Shape {\n                    owner: q,\n                    fields: [],\n                    positional: true,\n                    required: [],\n                    params: t.params,\n                  },\n                }\n                mut ctors.insert(check.qualified(d.module, v.name), sh)\n              }\n            },\n            ast.Alias(a) => if t.distinct {\n              mut ctors.insert(\n                q,\n                check.Shape {\n                  owner: q,\n                  fields: [(\"value\", check.lower(partial, tps, a))],\n                  positional: true,\n                  required: [],\n                  params: t.params,\n                },\n              )\n            },\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  mut variants := Dict[String, List[String]] {}\n  for (c, sh) in ctors {\n    if contains(sums, sh.owner) {\n      mut variants.insert(\n        sh.owner,\n        (get(variants, sh.owner) ?? []) + [c],\n      )\n    }\n  }\n  check.Types {\n    named,\n    sums,\n    ctors,\n    aliases,\n    traits,\n    refinements,\n    rets,\n    mut_written,\n    variants,\n    narrows,\n  }\n}","old_text":"/// The program's record and sum types the checker models, by the names the\n/// stored form uses.\npub fn types_of(decls: List[ast.Decl]) -> check.Types {\n  // `Option` and `Result` come with the language\n  mut named := Dict[String, List[String]] { \"Option\": [\"T\"], \"Result\": [\"T\", \"E\"], \"Dict\": [\"K\", \"V\"], \"Set\": [\"A\"], \"Task\": [\"T\"], \"Sender\": [\"T\"], \"Receiver\": [\"T\"] }\n  mut sums := Set[String] { \"Option\", \"Result\" }\n  mut traits := Set[String] {}\n  for d in decls {\n    match d.kind {\n      // a capability's too, like `Console`: its methods' types are checked\n      ast.TraitDef(t) => if len(t.params) == 0 {\n        mut traits.insert(check.qualified(d.module, t.name))\n      },\n      _ => (),\n    }\n  }\n  mut aliases := Dict[String, ast.TypeExpr] {}\n  mut refinements := Dict[String, (ast.TypeExpr, ast.Expr)] {}\n  mut rets := Dict[String, ast.TypeExpr] {}\n  mut mut_written := Dict[String, List[Option[ast.TypeExpr]]] {}\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => if !t.distinct && len(t.params) == 0 {\n        match (t.body, t.refinement) {\n          (ast.Alias(a), Some(pred)) => mut refinements.insert(\n            check.qualified(d.module, t.name),\n            (a, pred),\n          ),\n          _ => (),\n        }\n      },\n      ast.FnDef(f) => {\n        mut rets.insert(check.qualified(d.module, f.name), f.ret)\n        mut mut_written.insert(\n          check.qualified(d.module, f.name),\n          f.params.map(\n            p -> if p.mutable {\n              Some(p.ty)\n            } else {\n              None\n            },\n          ),\n        )\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      // an alias, refined or not, is the type it stands for. A record or a sum,\n      // refined or not, is a type of its own; its refinement is verify's, and\n      // its fields are checked as an unrefined one's are.\n      ast.TypeDef(t) => if !t.distinct {\n        q := check.qualified(d.module, t.name)\n        match t.body {\n          ast.Alias(a) => if len(t.params) == 0 {\n            mut aliases.insert(q, a)\n          },\n          ast.RecordBody(_) => mut named.insert(q, t.params),\n          ast.SumBody(vs) => if !vs.any(v -> v.payload is ast.MemberType) {\n            mut named.insert(q, t.params)\n            mut sums.insert(q)\n          },\n        }\n      } else if t.distinct {\n        // a `distinct` type: a type of its own, made of one field, `value`\n        mut named.insert(check.qualified(d.module, t.name), t.params)\n      },\n      _ => (),\n    }\n  }\n  mut ctors := Dict[String, check.Shape] { \"Some\": check.Shape {\n    owner: \"Option\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"None\": check.Shape {\n    owner: \"Option\",\n    fields: [],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"Ok\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  }, \"Err\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"E\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  } }\n  partial := check.Types {\n    named,\n    sums,\n    ctors: Dict[String, check.Shape] {},\n    aliases,\n    traits,\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => {\n        q := check.qualified(d.module, t.name)\n        if contains(named, q) {\n          tps := set(t.params)\n          match t.body {\n            ast.RecordBody(fs) => mut ctors.insert(\n              q,\n              check.Shape {\n                owner: q,\n                fields: fs.map(\n                  f -> (f.name, check.lower(partial, tps, f.ty)),\n                ),\n                positional: false,\n                required: check.required(fs),\n                params: t.params,\n              },\n            ),\n            ast.SumBody(vs) => {\n              for v in vs {\n                sh := match v.payload {\n                  ast.Positional(ts) => check.Shape {\n                    owner: q,\n                    fields: ts.map(x -> (\"\", check.lower(partial, tps, x))),\n                    positional: true,\n                    required: [],\n                    params: t.params,\n                  },\n                  ast.RecordPayload(fs) => check.Shape {\n                    owner: q,\n                    fields: fs.map(\n                      f -> (f.name, check.lower(partial, tps, f.ty)),\n                    ),\n                    positional: false,\n                    required: check.required(fs),\n                    params: t.params,\n                  },\n                  _ => check.Shape {\n                    owner: q,\n                    fields: [],\n                    positional: true,\n                    required: [],\n                    params: t.params,\n                  },\n                }\n                mut ctors.insert(check.qualified(d.module, v.name), sh)\n              }\n            },\n            ast.Alias(a) => if t.distinct {\n              mut ctors.insert(\n                q,\n                check.Shape {\n                  owner: q,\n                  fields: [(\"value\", check.lower(partial, tps, a))],\n                  positional: true,\n                  required: [],\n                  params: t.params,\n                },\n              )\n            },\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  mut variants := Dict[String, List[String]] {}\n  for (c, sh) in ctors {\n    if contains(sums, sh.owner) {\n      mut variants.insert(\n        sh.owner,\n        (get(variants, sh.owner) ?? []) + [c],\n      )\n    }\n  }\n  check.Types {\n    named,\n    sums,\n    ctors,\n    aliases,\n    traits,\n    refinements,\n    rets,\n    mut_written,\n    variants,\n  }\n}"},{"name":"check.infer_untagged","kind":"fn","old":"d436cae315d6f48c","new":"91d723e72a0394ad","interface_changed":false,"affected":[],"module":"check","text":"/// The type of `e`, where `expected` is the type its place asks for. The\n/// mismatches found go to `i.errs`, in the order found.\nfn infer_untagged(\n  mut i: check.Inf,\n  e: ast.Expr,\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  match e {\n    ast.IntLit(_) => check.int_literal(mut i, e, expected),\n    ast.BigIntLit(_) => check.int_literal(mut i, e, expected),\n    ast.FloatLit(_) => check.TFloat,\n    ast.StrLit(_) => check.TStr,\n    ast.BoolLit(_) => check.TBool,\n    ast.UnitExpr => check.TUnit,\n    // `env` holds declared types; a narrowed variable reads as a place\n    ast.Var(x) => match get(env, x) {\n      Some(t) => {\n        // a closure or `spawn` can't hold a handle from outside it\n        if contains(i.captured, x) && check.holds_task(check.res(i, t)) {\n          check.error(mut i, \"a closure or `spawn` can't hold `\"\n            + x\n            + \"`, a task's handle: await it where it was spawned\")\n        }\n        check.var_type(i, x, t)\n      },\n      None => match get(i.fns, x) {\n        // a function's type parameters: fresh at each use\n        Some(t) => check.inst(t, check.fresh_for(\n          mut i,\n          to_list(check.gens(t, Set[String] {})),\n        )),\n        None => check.trait_fn(mut i, x),\n      },\n    },\n    ast.Interp(parts) => {\n      for p in parts {\n        match p {\n          ast.ValuePart { value, spec } => {\n            t := check.listed_arg(\n              mut i,\n              \"$interp\",\n              0,\n              value,\n              check.TList(check.TAny),\n              check.infer(mut i, value, env, None),\n              \"interpolation\",\n            )\n            match spec {\n              Some(f) => check.check_spec(mut i, f, t),\n              None => (),\n            }\n          },\n          ast.TextPart(_) => (),\n        }\n      }\n      check.TStr\n    },\n    ast.Binary { op, left, right } => check.binary(mut i, op, left, right, env, expected),\n    // a negative literal of a sized type (`-2^63`, beyond 64 bits once negated)\n    ast.Unary { op, operand } => if op == ast.Neg\n      && check.is_int_lit(operand)\n      && check.sized_expected(i, expected) is Some {\n      _ := check.infer(mut i, operand, env, None)\n      check.int_literal(mut i, e, expected)\n    } else {\n      t := check.infer(mut i, operand, env, None)\n      if op == ast.Neg && !check.is_int_lit(operand) {\n        mut i.arith.push((\"-\", t))\n      }\n      match op {\n        ast.Neg => {\n          match check.res(i, t) {\n            check.TInt | check.TFloat | check.TAny => (),\n            check.TNamed { name, args } => if !(len(args) == 0 && check.is_sized(name)) {\n              check.error(\n                mut i,\n                \"operand of `-` must be Int or Float, found `\"\n                  + (check.shown(check.res(i, t)) ?? name)\n                  + \"`\",\n              )\n            },\n            check.TVar(_) => check.expect(mut i, check.TInt, t, \"operand of `-`\"),\n            other => match check.shown(other) {\n              Some(s) => check.error(\n                mut i,\n                \"operand of `-` must be Int or Float, found `\"\n                  + s\n                  + \"`\",\n              ),\n              None => (),\n            },\n          }\n          t\n        },\n        ast.Not => {\n          check.expect(mut i, check.TBool, t, \"operand of `!`\")\n          check.TBool\n        },\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => check.infer_if(mut i, cond, then, otherwise, env, expected),\n    ast.Block { stmts, last } => check.infer_block(mut i, stmts, last, env, expected),\n    ast.Call { callee, args } => check.infer_call(mut i, callee, args, env),\n    ast.ListExpr(es) => check.infer_list(mut i, es, env, expected),\n    ast.MatchExpr { scrutinee, binding, arms } => check.infer_match(\n      mut i,\n      scrutinee,\n      binding,\n      arms,\n      env,\n      expected,\n    ),\n    ast.Lambda { params, body } => check.infer_lambda(mut i, params, body, env, expected),\n    ast.Return(x) => {\n      r := i.ret\n      if check.outside_fn(check.res(i, r)) {\n        check.error(mut i, \"`return` outside a function\")\n        _ := check.infer(mut i, x, env, None)\n      } else {\n        t := check.infer(mut i, x, env, Some(r))\n        check.expect(mut i, r, t, \"`return` value\")\n      }\n      check.TAny\n    },\n    ast.IsExpr { value, .. } => {\n      _ := check.infer(mut i, value, env, None)\n      check.TBool\n    },\n    ast.TupleExpr(es) => {\n      // each element with the expected tuple's element as its hint\n      hints := match expected {\n        Some(e) => match check.res(i, e) {\n          check.TNamed { name, args } => if name == \"Tuple\" && len(args) == len(es) {\n            args\n          } else {\n            []\n          },\n          _ => [],\n        },\n        None => [],\n      }\n      mut ts := []\n      for (k, x) in enumerate(es) {\n        mut ts.push(check.infer(mut i, x, env, get(hints, k)))\n      }\n      check.TNamed { name: \"Tuple\", args: ts }\n    },\n    ast.CtorExpr { name, args } => match get(i.types.ctors, name) {\n      Some(sh) => check.infer_ctor(mut i, name, sh, args, env, expected),\n      None => {\n        match args {\n          ast.PositionalArgs(es) => check.infer_all(mut i, es, env),\n          ast.RecordArgs(fs) => check.infer_all(mut i, fs.map(f -> f.1), env),\n          ast.UpdateArgs { base, fields } => check.infer_all(mut i, [base] + fields.map(f -> f.1), env),\n          ast.NoArgs => (),\n        }\n        check.TAny\n      },\n    },\n    ast.MethodCall { recv, name, args } => check.infer_method(mut i, recv, name, args, env, false),\n    ast.FieldOf { base, name: tagged } => {\n      // a tagged read, `sku#0.1`: its receiver's type is kept for `rename`\n      (name, tag) := match check.untag(tagged) {\n        Some(nk) => nk,\n        None => (tagged, \"\"),\n      }\n      bt := check.infer(mut i, base, env, None)\n      if tag != \"\" {\n        mut i.insts.insert(tag + \":field\", bt)\n      }\n      match check.res(i, bt) {\n        // a field of a value that has none\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => {\n          match check.shown(check.res(i, bt)) {\n            Some(x) => check.error(\n              mut i,\n              \"cannot access field `\" + name + \"` on `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          check.TAny\n        },\n        // `p.1`: a tuple's element\n        check.TNamed { name: \"Tuple\", args: targs } => match parse_int(name) {\n          Some(k) => match get(targs, k) {\n            Some(t) => check.place(i, t),\n            None => {\n              match check.shown(check.res(i, bt)) {\n                Some(x) => check.error(\n                  mut i,\n                  \"tuple `\" + x + \"` has no element \" + name,\n                ),\n                None => (),\n              }\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a field of the one variant a value is narrowed to\n        check.TVariants { names: [v], .. } => match get(i.types.ctors, v) {\n          Some(sh) => match check.field_of(sh, name) {\n            Some(ft) => check.place(i, ft),\n            None => {\n              check.error(\n                mut i,\n                \"variant `\" + v + \"` has no field `\" + name + \"`\",\n              )\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a field every variant a value is narrowed to has\n        check.TVariants { names, .. } => check.variants_field(\n          mut i,\n          names,\n          [],\n          name,\n          check.shown(check.res(i, bt)) ?? \"?\",\n        ),\n        // a field every member of a union has, with the same type\n        check.TUnion(ms) => {\n          mut out: Option[check.Ty] = None\n          for m in ms {\n            ft := match m {\n              check.TNamed { name: mn, .. } => match get(i.types.ctors, mn) {\n                Some(sh) => check.field_of(sh, name),\n                None => None,\n              },\n              _ => None,\n            }\n            match ft {\n              Some(x) => {\n                out = Some(x)\n              },\n              None => {\n                mt := check.shown(m) ?? \"?\"\n                ut := check.shown(check.res(i, bt)) ?? \"?\"\n                check.error(\n                  mut i,\n                  f\"`{mt}` has no field `{name}`, so not every `{ut}` does (match on it first)\",\n                )\n                return check.TAny\n              },\n            }\n          }\n          match out {\n            Some(x) => check.place(i, x),\n            None => check.TAny,\n          }\n        },\n        // a sum's field: one every variant has\n        check.TNamed { name: n, args: targs } => if contains(i.types.sums, n) && !contains(i.types.ctors, n) {\n          check.variants_field(\n            mut i,\n            get(i.types.variants, n) ?? [],\n            targs,\n            name,\n            check.shown(check.res(i, bt)) ?? n,\n          )\n        } else {\n          match get(i.types.ctors, n) {\n            // a record type; a sum's name is not a constructor\n            Some(sh) => match check.field_of(sh, name) {\n              Some(ft) => {\n                mut m := Dict[String, check.Ty] {}\n                for (k, p) in enumerate(sh.params) {\n                  mut m.insert(p, get(targs, k) ?? check.TAny)\n                }\n                check.place(i, check.inst(ft, m))\n              },\n              None => {\n                check.error(mut i, \"type `\"\n                  + n\n                  + \"` has no field `\"\n                  + name\n                  + \"` (match on variants to access their fields)\")\n                check.TAny\n              },\n            },\n            None => check.TAny,\n          }\n        },\n        _ => check.TAny,\n      }\n    },\n    // `mut q.claim(2)`: a call that changes its receiver\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => match check.untag(name) {\n      // a tagged call: its receiver's type is kept, as `infer` keeps it. A call\n      // spreading records, tagged by `spread_bound`, is written out.\n      Some(nk) => if starts_with(nk.1, \"s\") {\n        check.infer_spread(mut i, e, nk.1, env, expected)\n      } else {\n        rt := check.infer(mut i, recv, env, None)\n        mut i.insts.insert(nk.1 + \":recv\", rt)\n        t := check.infer_method(mut i, recv, nk.0, args, env, true)\n        mut i.insts.insert(nk.1, t)\n        t\n      },\n      None => check.infer_method(mut i, recv, name, args, env, true),\n    },\n    ast.MutExpr(x) => check.infer(mut i, x, env, expected),\n    // `r!`, `o?`: the value a `Result` or an `Option` holds\n    ast.Try { value, kind } => {\n      vt := check.infer(mut i, value, env, None)\n      want := if kind == ast.TryResult {\n        \"Result\"\n      } else {\n        \"Option\"\n      }\n      match check.res(i, vt) {\n        check.TNamed { name, args } => if name == want {\n          check.early_error(mut i, kind, if kind == ast.TryResult {\n            get(args, 1) ?? check.TAny\n          } else {\n            check.TAny\n          })\n          get(args, 0) ?? check.TAny\n        } else {\n          check.wrong_try(mut i, kind, check.res(i, vt))\n        },\n        check.TAny | check.TVar(_) => check.TAny,\n        other => check.wrong_try(mut i, kind, other),\n      }\n    },\n    // `r except e { fallback }`: the value, or the fallback (of the same\n    // type) with `e` the error\n    ast.Except { value, err, fallback } => {\n      vt := check.infer(mut i, value, env, None)\n      (ok, bad) := match check.res(i, vt) {\n        check.TNamed { name, args } => if name == \"Result\" && len(args) == 2 {\n          (get(args, 0) ?? check.TAny, get(args, 1) ?? check.TAny)\n        } else if name == \"Option\" {\n          check.error(\n            mut i,\n            \"`except` / `!!` handle a Result; an Option is handled with `or { … }` / `??`\",\n          )\n          (check.fresh(mut i), check.TAny)\n        } else {\n          check.not_result(mut i, check.res(i, vt))\n        },\n        check.TAny | check.TVar(_) => (check.TAny, check.TAny),\n        other => check.not_result(mut i, other),\n      }\n      inner := match err {\n        Some(n) => {\n          mut copy := env\n          mut copy.insert(n, bad)\n          copy\n        },\n        None => env,\n      }\n      ft := check.infer(mut i, fallback, inner, Some(ok))\n      check.expect(mut i, ok, ft, \"`except` fallback\")\n      ok\n    },\n    ast.Fallback { value, fallback } => {\n      vt := check.infer(mut i, value, env, None)\n      inner := match check.res(i, vt) {\n        check.TNamed { name, args } => if name == \"Option\" && len(args) == 1 {\n          get(args, 0) ?? check.TAny\n        } else if name == \"Result\" && len(args) == 2 {\n          check.error(\n            mut i,\n            \"`or` / `??` handle an Option; a Result is handled with `except { … }` / `!!`\",\n          )\n          get(args, 0) ?? check.TAny\n        } else {\n          match check.shown(check.res(i, vt)) {\n            Some(x) => check.error(\n              mut i,\n              \"`or` / `??` handle an Option, found `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          check.fresh(mut i)\n        },\n        check.TAny => check.TAny,\n        other => {\n          match check.shown(other) {\n            Some(x) => check.error(\n              mut i,\n              \"`or` / `??` handle an Option, found `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          // the fallback's type, so checking goes on\n          check.fresh(mut i)\n        },\n      }\n      ft := check.infer(mut i, fallback, env, Some(inner))\n      check.expect(mut i, inner, ft, \"`or` fallback\")\n      inner\n    },\n    ast.Index { base, index } => {\n      bt := check.infer(mut i, base, env, None)\n      match index {\n        // `xs[a..b]`: a slice, of the same type\n        ast.Range { lo, hi, .. } => {\n          for x in [lo, hi] {\n            match x {\n              Some(v) => check.infer(mut i, v, env, Some(check.TInt)),\n              None => check.TAny,\n            }\n          }\n          match check.res(i, bt) {\n            check.TList(_) => bt,\n            _ => check.TAny,\n          }\n        },\n        // `xs[k]`: the built-in `at(xs, k)`\n        _ => match check.res(i, bt) {\n          check.TList(_) => match get(i.builtins, \"at\") {\n            Some(bs) => check.builtin_call(mut i, \"at\", bs, [bt], [index], env),\n            None => {\n              _ := check.infer(mut i, index, env, None)\n              check.TAny\n            },\n          },\n          _ => {\n            _ := check.infer(mut i, index, env, None)\n            check.TAny\n          },\n        },\n      }\n    },\n    // `a..b`: the list of the integers from `a`\n    ast.Range { lo, hi, .. } => {\n      for x in [lo, hi] {\n        match x {\n          Some(v) => check.infer(mut i, v, env, Some(check.TInt)),\n          None => check.TAny,\n        }\n      }\n      check.TList(check.TInt)\n    },\n    ast.Comp { kind, elem, fors } => {\n      mut seen := env\n      // over an iterator, one of the program's types or core's, a comprehension\n      // is lazy: an iterator instead of a list\n      mut lazy := false\n      for f in fors {\n        it := check.infer(mut i, f.iter, seen, None)\n        match check.res(i, it) {\n          check.TNamed { name, .. } => if contains(i.methods.impls, \"Iterator for \" + name)\n            || contains(i.methods.impls, \"FiniteIterator for \" + name) {\n            lazy = true\n          },\n          _ => (),\n        }\n        seen = check.bind_typed(\n          mut i,\n          seen,\n          f.pat,\n          check.element_of(i, it),\n        )\n        match f.cond {\n          Some(c) => check.infer(mut i, c, seen, None),\n          None => (),\n        }\n      }\n      et := check.infer(mut i, elem, seen, None)\n      // a list comprehension is a list of its element's type\n      if kind == ast.ListComp && !lazy {\n        check.TList(et)\n      } else {\n        check.TAny\n      }\n    },\n    ast.DictExpr { entries, .. } => {\n      for kv in entries {\n        check.infer_all(mut i, [kv.0, kv.1], env)\n      }\n      check.TAny\n    },\n    ast.SetExpr { elems, .. } => {\n      check.infer_all(mut i, elems, env)\n      check.TAny\n    },\n    ast.Comptime(x) => {\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    // `old e`: `e`'s value where the function started, of `e`'s type\n    ast.Old(x) => check.infer(mut i, x, env, expected),\n    // `...x` where `spread_bound` found no call by name to fill\n    ast.Spread(x) => {\n      check.spread_error(\n        mut i,\n        \"`...\"\n          + text.expr_text(x, 0)\n          + \"`: a spread gives a record's fields to the parameters of a function or method called by name; it can't be used here\",\n      )\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    ast.Assumed(x) => check.infer(mut i, x, env, expected),\n    // a `scope`'s result can't hold one of its tasks' handles\n    ast.Scope(x) => {\n      held := i.outside\n      i.outside = Some(set(keys(env)))\n      // `scope { …; spawn e }`: the last task's handle isn't its value\n      t := if check.ends_in_spawn(x) {\n        _ := check.infer(mut i, x, env, None)\n        check.TUnit\n      } else {\n        check.infer(mut i, x, env, expected)\n      }\n      i.outside = held\n      if check.holds_task(check.res(i, t)) {\n        match check.shown(check.res(i, t)) {\n          Some(s) => check.error(\n            mut i,\n            \"a task's handle can't leave its `scope` (its result is `\"\n              + s\n              + \"`): await it inside\",\n          ),\n          None => (),\n        }\n      }\n      t\n    },\n    // `spawn e`: a handle to `e`'s value\n    ast.Spawn(x) => {\n      outer := i.ret\n      i.ret = check.TAny\n      held := i.captured\n      i.captured = set(keys(env))\n      t := check.infer(mut i, x, env, None)\n      i.captured = held\n      i.ret = outer\n      // a sender is captured on its own, never inside another value\n      for v in keys(env).sorted() {\n        vt := check.res(i, get(env, v) ?? check.TAny)\n        if !(vt is check.TNamed && check.type_name(vt) == \"Sender\")\n          && check.holds_sender(i, vt, 8)\n          && check.uses(x, v)\n          && !check.rebinds(x, v) {\n          check.error(\n            mut i,\n            \"a task (a `spawn`, a `race` arm) can capture a sender only on its own (a variable holding it): `\"\n              + v\n              + \"` holds one inside\",\n          )\n        }\n      }\n      check.TNamed { name: \"Task\", args: [t] }\n    },\n    // `select`: each arm's operation (`rx.recv()` an `Option`, `tx.send(v)`,\n    // `await h`, `clock.after(d)` with `clock` a clock and `d` a `Duration`),\n    // its name, and its body with the type wanted\n    ast.Select(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.MethodCall { recv, name, args } => if name == \"after\" && len(args) == 1 {\n            ct := check.res(i, check.infer(mut i, recv, env, None))\n            match ct {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(ct) {\n                Some(x) => check.error(\n                  mut i,\n                  \"an `after` arm waits on a clock: `\"\n                    + x\n                    + \"` doesn't implement `Clock` (std.time)\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            dt := check.res(i, check.infer(\n              mut i,\n              get(args, 0) ?? ast.UnitExpr,\n              env,\n              None,\n            ))\n            match dt {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(dt) {\n                Some(x) => check.error(\n                  mut i,\n                  \"the time an `after` arm waits: expected `std.time.Duration`, found `\"\n                    + x\n                    + \"`\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            check.TUnit\n          } else {\n            check.infer(mut i, a.op, env, None)\n          },\n          _ => check.infer(mut i, a.op, env, None),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `race`: each left side is a task's body (a supervised one's result is a\n    // `Result[T, Panic]`), then its name and its body\n    ast.Race(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.SupervisedSpawn(x) => check.TNamed { name: \"Result\", args: [\n            check.task_body(mut i, x, env),\n            check.TNamed { name: \"Panic\", args: [] },\n          ] },\n          op => check.task_body(mut i, op, env),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `supervised spawn e`: a handle to `e`'s value, or its panic\n    ast.SupervisedSpawn(x) => check.TNamed {\n      name: \"Task\",\n      args: [check.TNamed { name: \"Result\", args: [\n        check.task_body(mut i, x, env),\n        check.TNamed { name: \"Panic\", args: [] },\n      ] }],\n    },\n    // `await h`: the task's value, or each task's for a tuple or list of handles\n    ast.Await(x) => {\n      t := check.infer(mut i, x, env, None)\n      check.awaited(mut i, check.res(i, t))\n    },\n    ast.Hole(h) => {\n      t := expected ?? check.fresh(mut i)\n      mut i.holes.push((h, t, env))\n      t\n    },\n    _ => check.TAny,\n  }\n}","old_text":"/// The type of `e`, where `expected` is the type its place asks for. The\n/// mismatches found go to `i.errs`, in the order found.\nfn infer_untagged(\n  mut i: check.Inf,\n  e: ast.Expr,\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  match e {\n    ast.IntLit(_) => check.int_literal(mut i, e, expected),\n    ast.BigIntLit(_) => check.int_literal(mut i, e, expected),\n    ast.FloatLit(_) => check.TFloat,\n    ast.StrLit(_) => check.TStr,\n    ast.BoolLit(_) => check.TBool,\n    ast.UnitExpr => check.TUnit,\n    // `env` holds declared types; a narrowed variable reads as a place\n    ast.Var(x) => match get(env, x) {\n      Some(t) => {\n        // a closure or `spawn` can't hold a handle from outside it\n        if contains(i.captured, x) && check.holds_task(check.res(i, t)) {\n          check.error(mut i, \"a closure or `spawn` can't hold `\"\n            + x\n            + \"`, a task's handle: await it where it was spawned\")\n        }\n        check.var_type(i, x, t)\n      },\n      None => match get(i.fns, x) {\n        // a function's type parameters: fresh at each use\n        Some(t) => check.inst(t, check.fresh_for(\n          mut i,\n          to_list(check.gens(t, Set[String] {})),\n        )),\n        None => check.trait_fn(mut i, x),\n      },\n    },\n    ast.Interp(parts) => {\n      for p in parts {\n        match p {\n          ast.ValuePart { value, spec } => {\n            t := check.listed_arg(\n              mut i,\n              \"$interp\",\n              0,\n              value,\n              check.TList(check.TAny),\n              check.infer(mut i, value, env, None),\n              \"interpolation\",\n            )\n            match spec {\n              Some(f) => check.check_spec(mut i, f, t),\n              None => (),\n            }\n          },\n          ast.TextPart(_) => (),\n        }\n      }\n      check.TStr\n    },\n    ast.Binary { op, left, right } => check.binary(mut i, op, left, right, env, expected),\n    // a negative literal of a sized type (`-2^63`, beyond 64 bits once negated)\n    ast.Unary { op, operand } => if op == ast.Neg\n      && check.is_int_lit(operand)\n      && check.sized_expected(i, expected) is Some {\n      _ := check.infer(mut i, operand, env, None)\n      check.int_literal(mut i, e, expected)\n    } else {\n      t := check.infer(mut i, operand, env, None)\n      if op == ast.Neg && !check.is_int_lit(operand) {\n        mut i.arith.push((\"-\", t))\n      }\n      match op {\n        ast.Neg => {\n          match check.res(i, t) {\n            check.TInt | check.TFloat | check.TAny => (),\n            check.TNamed { name, args } => if !(len(args) == 0 && check.is_sized(name)) {\n              check.error(\n                mut i,\n                \"operand of `-` must be Int or Float, found `\"\n                  + (check.shown(check.res(i, t)) ?? name)\n                  + \"`\",\n              )\n            },\n            check.TVar(_) => check.expect(mut i, check.TInt, t, \"operand of `-`\"),\n            other => match check.shown(other) {\n              Some(s) => check.error(\n                mut i,\n                \"operand of `-` must be Int or Float, found `\"\n                  + s\n                  + \"`\",\n              ),\n              None => (),\n            },\n          }\n          t\n        },\n        ast.Not => {\n          check.expect(mut i, check.TBool, t, \"operand of `!`\")\n          check.TBool\n        },\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => check.infer_if(mut i, cond, then, otherwise, env, expected),\n    ast.Block { stmts, last } => check.infer_block(mut i, stmts, last, env, expected),\n    ast.Call { callee, args } => check.infer_call(mut i, callee, args, env),\n    ast.ListExpr(es) => check.infer_list(mut i, es, env, expected),\n    ast.MatchExpr { scrutinee, binding, arms } => check.infer_match(\n      mut i,\n      scrutinee,\n      binding,\n      arms,\n      env,\n      expected,\n    ),\n    ast.Lambda { params, body } => check.infer_lambda(mut i, params, body, env, expected),\n    ast.Return(x) => {\n      r := i.ret\n      if check.outside_fn(check.res(i, r)) {\n        check.error(mut i, \"`return` outside a function\")\n        _ := check.infer(mut i, x, env, None)\n      } else {\n        t := check.infer(mut i, x, env, Some(r))\n        check.expect(mut i, r, t, \"`return` value\")\n      }\n      check.TAny\n    },\n    ast.IsExpr { value, .. } => {\n      _ := check.infer(mut i, value, env, None)\n      check.TBool\n    },\n    ast.TupleExpr(es) => {\n      // each element with the expected tuple's element as its hint\n      hints := match expected {\n        Some(e) => match check.res(i, e) {\n          check.TNamed { name, args } => if name == \"Tuple\" && len(args) == len(es) {\n            args\n          } else {\n            []\n          },\n          _ => [],\n        },\n        None => [],\n      }\n      mut ts := []\n      for (k, x) in enumerate(es) {\n        mut ts.push(check.infer(mut i, x, env, get(hints, k)))\n      }\n      check.TNamed { name: \"Tuple\", args: ts }\n    },\n    ast.CtorExpr { name, args } => match get(i.types.ctors, name) {\n      Some(sh) => check.infer_ctor(mut i, name, sh, args, env, expected),\n      None => {\n        match args {\n          ast.PositionalArgs(es) => check.infer_all(mut i, es, env),\n          ast.RecordArgs(fs) => check.infer_all(mut i, fs.map(f -> f.1), env),\n          ast.UpdateArgs { base, fields } => check.infer_all(mut i, [base] + fields.map(f -> f.1), env),\n          ast.NoArgs => (),\n        }\n        check.TAny\n      },\n    },\n    ast.MethodCall { recv, name, args } => check.infer_method(mut i, recv, name, args, env, false),\n    ast.FieldOf { base, name: tagged } => {\n      // a tagged read, `sku#0.1`: its receiver's type is kept for `rename`\n      (name, tag) := match check.untag(tagged) {\n        Some(nk) => nk,\n        None => (tagged, \"\"),\n      }\n      bt := check.infer(mut i, base, env, None)\n      if tag != \"\" {\n        mut i.insts.insert(tag + \":field\", bt)\n      }\n      match check.res(i, bt) {\n        // a field of a value that has none\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => {\n          match check.shown(check.res(i, bt)) {\n            Some(x) => check.error(\n              mut i,\n              \"cannot access field `\" + name + \"` on `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          check.TAny\n        },\n        // `p.1`: a tuple's element\n        check.TNamed { name: \"Tuple\", args: targs } => match parse_int(name) {\n          Some(k) => match get(targs, k) {\n            Some(t) => check.place(i, t),\n            None => {\n              match check.shown(check.res(i, bt)) {\n                Some(x) => check.error(\n                  mut i,\n                  \"tuple `\" + x + \"` has no element \" + name,\n                ),\n                None => (),\n              }\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a field of the one variant a variable is narrowed to\n        check.TVariants { names: [v], .. } => match get(i.types.ctors, v) {\n          Some(sh) => match check.field_of(sh, name) {\n            Some(ft) => check.place(i, ft),\n            None => {\n              check.error(\n                mut i,\n                \"variant `\" + v + \"` has no field `\" + name + \"`\",\n              )\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a field every member of a union has, with the same type\n        check.TUnion(ms) => {\n          mut out: Option[check.Ty] = None\n          for m in ms {\n            ft := match m {\n              check.TNamed { name: mn, .. } => match get(i.types.ctors, mn) {\n                Some(sh) => check.field_of(sh, name),\n                None => None,\n              },\n              _ => None,\n            }\n            match ft {\n              Some(x) => {\n                out = Some(x)\n              },\n              None => {\n                mt := check.shown(m) ?? \"?\"\n                ut := check.shown(check.res(i, bt)) ?? \"?\"\n                check.error(\n                  mut i,\n                  f\"`{mt}` has no field `{name}`, so not every `{ut}` does (match on it first)\",\n                )\n                return check.TAny\n              },\n            }\n          }\n          match out {\n            Some(x) => check.place(i, x),\n            None => check.TAny,\n          }\n        },\n        check.TNamed { name: n, args: targs } => match get(i.types.ctors, n) {\n          // a record type; a sum's name is not a constructor\n          Some(sh) => match check.field_of(sh, name) {\n            Some(ft) => {\n              mut m := Dict[String, check.Ty] {}\n              for (k, p) in enumerate(sh.params) {\n                mut m.insert(p, get(targs, k) ?? check.TAny)\n              }\n              check.place(i, check.inst(ft, m))\n            },\n            None => {\n              check.error(mut i, \"type `\"\n                + n\n                + \"` has no field `\"\n                + name\n                + \"` (match on variants to access their fields)\")\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        _ => check.TAny,\n      }\n    },\n    // `mut q.claim(2)`: a call that changes its receiver\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => match check.untag(name) {\n      // a tagged call: its receiver's type is kept, as `infer` keeps it. A call\n      // spreading records, tagged by `spread_bound`, is written out.\n      Some(nk) => if starts_with(nk.1, \"s\") {\n        check.infer_spread(mut i, e, nk.1, env, expected)\n      } else {\n        rt := check.infer(mut i, recv, env, None)\n        mut i.insts.insert(nk.1 + \":recv\", rt)\n        t := check.infer_method(mut i, recv, nk.0, args, env, true)\n        mut i.insts.insert(nk.1, t)\n        t\n      },\n      None => check.infer_method(mut i, recv, name, args, env, true),\n    },\n    ast.MutExpr(x) => check.infer(mut i, x, env, expected),\n    // `r!`, `o?`: the value a `Result` or an `Option` holds\n    ast.Try { value, kind } => {\n      vt := check.infer(mut i, value, env, None)\n      want := if kind == ast.TryResult {\n        \"Result\"\n      } else {\n        \"Option\"\n      }\n      match check.res(i, vt) {\n        check.TNamed { name, args } => if name == want {\n          check.early_error(mut i, kind, if kind == ast.TryResult {\n            get(args, 1) ?? check.TAny\n          } else {\n            check.TAny\n          })\n          get(args, 0) ?? check.TAny\n        } else {\n          check.wrong_try(mut i, kind, check.res(i, vt))\n        },\n        check.TAny | check.TVar(_) => check.TAny,\n        other => check.wrong_try(mut i, kind, other),\n      }\n    },\n    // `r except e { fallback }`: the value, or the fallback (of the same\n    // type) with `e` the error\n    ast.Except { value, err, fallback } => {\n      vt := check.infer(mut i, value, env, None)\n      (ok, bad) := match check.res(i, vt) {\n        check.TNamed { name, args } => if name == \"Result\" && len(args) == 2 {\n          (get(args, 0) ?? check.TAny, get(args, 1) ?? check.TAny)\n        } else if name == \"Option\" {\n          check.error(\n            mut i,\n            \"`except` / `!!` handle a Result; an Option is handled with `or { … }` / `??`\",\n          )\n          (check.fresh(mut i), check.TAny)\n        } else {\n          check.not_result(mut i, check.res(i, vt))\n        },\n        check.TAny | check.TVar(_) => (check.TAny, check.TAny),\n        other => check.not_result(mut i, other),\n      }\n      inner := match err {\n        Some(n) => {\n          mut copy := env\n          mut copy.insert(n, bad)\n          copy\n        },\n        None => env,\n      }\n      ft := check.infer(mut i, fallback, inner, Some(ok))\n      check.expect(mut i, ok, ft, \"`except` fallback\")\n      ok\n    },\n    ast.Fallback { value, fallback } => {\n      vt := check.infer(mut i, value, env, None)\n      inner := match check.res(i, vt) {\n        check.TNamed { name, args } => if name == \"Option\" && len(args) == 1 {\n          get(args, 0) ?? check.TAny\n        } else if name == \"Result\" && len(args) == 2 {\n          check.error(\n            mut i,\n            \"`or` / `??` handle an Option; a Result is handled with `except { … }` / `!!`\",\n          )\n          get(args, 0) ?? check.TAny\n        } else {\n          match check.shown(check.res(i, vt)) {\n            Some(x) => check.error(\n              mut i,\n              \"`or` / `??` handle an Option, found `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          check.fresh(mut i)\n        },\n        check.TAny => check.TAny,\n        other => {\n          match check.shown(other) {\n            Some(x) => check.error(\n              mut i,\n              \"`or` / `??` handle an Option, found `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          // the fallback's type, so checking goes on\n          check.fresh(mut i)\n        },\n      }\n      ft := check.infer(mut i, fallback, env, Some(inner))\n      check.expect(mut i, inner, ft, \"`or` fallback\")\n      inner\n    },\n    ast.Index { base, index } => {\n      bt := check.infer(mut i, base, env, None)\n      match index {\n        // `xs[a..b]`: a slice, of the same type\n        ast.Range { lo, hi, .. } => {\n          for x in [lo, hi] {\n            match x {\n              Some(v) => check.infer(mut i, v, env, Some(check.TInt)),\n              None => check.TAny,\n            }\n          }\n          match check.res(i, bt) {\n            check.TList(_) => bt,\n            _ => check.TAny,\n          }\n        },\n        // `xs[k]`: the built-in `at(xs, k)`\n        _ => match check.res(i, bt) {\n          check.TList(_) => match get(i.builtins, \"at\") {\n            Some(bs) => check.builtin_call(mut i, \"at\", bs, [bt], [index], env),\n            None => {\n              _ := check.infer(mut i, index, env, None)\n              check.TAny\n            },\n          },\n          _ => {\n            _ := check.infer(mut i, index, env, None)\n            check.TAny\n          },\n        },\n      }\n    },\n    // `a..b`: the list of the integers from `a`\n    ast.Range { lo, hi, .. } => {\n      for x in [lo, hi] {\n        match x {\n          Some(v) => check.infer(mut i, v, env, Some(check.TInt)),\n          None => check.TAny,\n        }\n      }\n      check.TList(check.TInt)\n    },\n    ast.Comp { kind, elem, fors } => {\n      mut seen := env\n      // over an iterator, one of the program's types or core's, a comprehension\n      // is lazy: an iterator instead of a list\n      mut lazy := false\n      for f in fors {\n        it := check.infer(mut i, f.iter, seen, None)\n        match check.res(i, it) {\n          check.TNamed { name, .. } => if contains(i.methods.impls, \"Iterator for \" + name)\n            || contains(i.methods.impls, \"FiniteIterator for \" + name) {\n            lazy = true\n          },\n          _ => (),\n        }\n        seen = check.bind_typed(\n          mut i,\n          seen,\n          f.pat,\n          check.element_of(i, it),\n        )\n        match f.cond {\n          Some(c) => check.infer(mut i, c, seen, None),\n          None => (),\n        }\n      }\n      et := check.infer(mut i, elem, seen, None)\n      // a list comprehension is a list of its element's type\n      if kind == ast.ListComp && !lazy {\n        check.TList(et)\n      } else {\n        check.TAny\n      }\n    },\n    ast.DictExpr { entries, .. } => {\n      for kv in entries {\n        check.infer_all(mut i, [kv.0, kv.1], env)\n      }\n      check.TAny\n    },\n    ast.SetExpr { elems, .. } => {\n      check.infer_all(mut i, elems, env)\n      check.TAny\n    },\n    ast.Comptime(x) => {\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    // `old e`: `e`'s value where the function started, of `e`'s type\n    ast.Old(x) => check.infer(mut i, x, env, expected),\n    // `...x` where `spread_bound` found no call by name to fill\n    ast.Spread(x) => {\n      check.spread_error(\n        mut i,\n        \"`...\"\n          + text.expr_text(x, 0)\n          + \"`: a spread gives a record's fields to the parameters of a function or method called by name; it can't be used here\",\n      )\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    ast.Assumed(x) => check.infer(mut i, x, env, expected),\n    // a `scope`'s result can't hold one of its tasks' handles\n    ast.Scope(x) => {\n      held := i.outside\n      i.outside = Some(set(keys(env)))\n      // `scope { …; spawn e }`: the last task's handle isn't its value\n      t := if check.ends_in_spawn(x) {\n        _ := check.infer(mut i, x, env, None)\n        check.TUnit\n      } else {\n        check.infer(mut i, x, env, expected)\n      }\n      i.outside = held\n      if check.holds_task(check.res(i, t)) {\n        match check.shown(check.res(i, t)) {\n          Some(s) => check.error(\n            mut i,\n            \"a task's handle can't leave its `scope` (its result is `\"\n              + s\n              + \"`): await it inside\",\n          ),\n          None => (),\n        }\n      }\n      t\n    },\n    // `spawn e`: a handle to `e`'s value\n    ast.Spawn(x) => {\n      outer := i.ret\n      i.ret = check.TAny\n      held := i.captured\n      i.captured = set(keys(env))\n      t := check.infer(mut i, x, env, None)\n      i.captured = held\n      i.ret = outer\n      // a sender is captured on its own, never inside another value\n      for v in keys(env).sorted() {\n        vt := check.res(i, get(env, v) ?? check.TAny)\n        if !(vt is check.TNamed && check.type_name(vt) == \"Sender\")\n          && check.holds_sender(i, vt, 8)\n          && check.uses(x, v)\n          && !check.rebinds(x, v) {\n          check.error(\n            mut i,\n            \"a task (a `spawn`, a `race` arm) can capture a sender only on its own (a variable holding it): `\"\n              + v\n              + \"` holds one inside\",\n          )\n        }\n      }\n      check.TNamed { name: \"Task\", args: [t] }\n    },\n    // `select`: each arm's operation (`rx.recv()` an `Option`, `tx.send(v)`,\n    // `await h`, `clock.after(d)` with `clock` a clock and `d` a `Duration`),\n    // its name, and its body with the type wanted\n    ast.Select(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.MethodCall { recv, name, args } => if name == \"after\" && len(args) == 1 {\n            ct := check.res(i, check.infer(mut i, recv, env, None))\n            match ct {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(ct) {\n                Some(x) => check.error(\n                  mut i,\n                  \"an `after` arm waits on a clock: `\"\n                    + x\n                    + \"` doesn't implement `Clock` (std.time)\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            dt := check.res(i, check.infer(\n              mut i,\n              get(args, 0) ?? ast.UnitExpr,\n              env,\n              None,\n            ))\n            match dt {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(dt) {\n                Some(x) => check.error(\n                  mut i,\n                  \"the time an `after` arm waits: expected `std.time.Duration`, found `\"\n                    + x\n                    + \"`\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            check.TUnit\n          } else {\n            check.infer(mut i, a.op, env, None)\n          },\n          _ => check.infer(mut i, a.op, env, None),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `race`: each left side is a task's body (a supervised one's result is a\n    // `Result[T, Panic]`), then its name and its body\n    ast.Race(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.SupervisedSpawn(x) => check.TNamed { name: \"Result\", args: [\n            check.task_body(mut i, x, env),\n            check.TNamed { name: \"Panic\", args: [] },\n          ] },\n          op => check.task_body(mut i, op, env),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `supervised spawn e`: a handle to `e`'s value, or its panic\n    ast.SupervisedSpawn(x) => check.TNamed {\n      name: \"Task\",\n      args: [check.TNamed { name: \"Result\", args: [\n        check.task_body(mut i, x, env),\n        check.TNamed { name: \"Panic\", args: [] },\n      ] }],\n    },\n    // `await h`: the task's value, or each task's for a tuple or list of handles\n    ast.Await(x) => {\n      t := check.infer(mut i, x, env, None)\n      check.awaited(mut i, check.res(i, t))\n    },\n    ast.Hole(h) => {\n      t := expected ?? check.fresh(mut i)\n      mut i.holes.push((h, t, env))\n      t\n    },\n    _ => check.TAny,\n  }\n}"},{"name":"check.narrowed_result","kind":"fn","old":null,"new":"23a4d8dd4b77d047","interface_changed":true,"affected":[],"module":"check","text":"/// The variants of a sum that a call's result can be, from what the callee\n/// says of `it`: its result type's refinement (`-> Order where it is\n/// Shipped`) and its `ensures`, each conjunct `it is V` (or `!`, `||` of\n/// them), `A ==> it is V` and `(it is V) == A`, where the checker decides\n/// `A` from the arguments' types (`o is Paid` with `o` narrowed to `Paid`).\n/// `ret` unchanged when nothing narrows it (or the facts contradict). The\n/// callee's contract is taken as given: `verify` proves it, and while it\n/// isn't proven the callee checks it on return.\nfn narrowed_result(\n  i: check.Inf,\n  f: String,\n  args: List[check.Ty],\n  ret: check.Ty,\n) -> check.Ty {\n  (owner, all) := match check.res(i, ret) {\n    check.TNamed { name, args: [] } => if contains(i.types.sums, name) {\n      (name, get(i.types.variants, name) ?? [])\n    } else {\n      return ret\n    },\n    _ => return ret,\n  }\n  (params, facts) := match get(i.types.narrows, f) {\n    Some(x) => x,\n    None => return ret,\n  }\n  mut left := set(all)\n  for fact in facts {\n    for c in check.conjuncts(fact) {\n      left = check.narrow_by(i, c, params, args, owner, left)\n    }\n  }\n  if len(left) == 0 || len(left) == len(all) {\n    return ret\n  }\n  check.TVariants { owner, names: to_list(left).sorted() }\n}"},{"name":"check.conjuncts","kind":"fn","old":null,"new":"422c4d55bcf77120","interface_changed":true,"affected":[],"module":"check","text":"/// The conjuncts of `e` (`a && b && c`: `[a, b, c]`).\nfn conjuncts(e: ast.Expr) -> List[ast.Expr] {\n  match e {\n    ast.Binary { op: ast.And, left, right } => check.conjuncts(left) + check.conjuncts(right),\n    _ => [e],\n  }\n}"},{"name":"check.narrow_by","kind":"fn","old":null,"new":"376d3e5e6b9b8bb5","interface_changed":true,"affected":[],"module":"check","text":"/// The variants `left` keeps under fact `c` about the result `it`.\nfn narrow_by(\n  i: check.Inf,\n  c: ast.Expr,\n  params: List[String],\n  args: List[check.Ty],\n  owner: String,\n  left: Set[String],\n) -> Set[String] {\n  match c {\n    ast.Binary { op: ast.Implies, left: a, right: q } => match check.decide(i, a, params, args) {\n      Some(true) => check.narrow_by(i, q, params, args, owner, left),\n      _ => left,\n    },\n    // `(it is V) == A`: either way round\n    ast.Binary { op: ast.Equal, left: l, right: r } => match (\n      check.result_variants(i, l, owner),\n      check.result_variants(i, r, owner),\n    ) {\n      (Some(vs), None) => match check.decide(i, r, params, args) {\n        Some(true) => left.intersection(vs),\n        Some(false) => left.difference(vs),\n        None => left,\n      },\n      (None, Some(vs)) => match check.decide(i, l, params, args) {\n        Some(true) => left.intersection(vs),\n        Some(false) => left.difference(vs),\n        None => left,\n      },\n      _ => left,\n    },\n    _ => match check.result_variants(i, c, owner) {\n      Some(vs) => left.intersection(vs),\n      None => left,\n    },\n  }\n}"},{"name":"check.result_variants","kind":"fn","old":null,"new":"dd40eb6aa057e5b2","interface_changed":true,"affected":[],"module":"check","text":"/// The variants of sum `owner` for which `e`, a fact about `it` alone, holds\n/// (`it is Shipped`, `!(it is Pending)`, `it is A || it is B`), if it is one.\nfn result_variants(\n  i: check.Inf,\n  e: ast.Expr,\n  owner: String,\n) -> Option[Set[String]] {\n  all := set(get(i.types.variants, owner) ?? [])\n  match e {\n    ast.IsExpr { value: ast.Var(\"it\"), variant } => match check.variants_named(i, variant) {\n      Some((o, vs)) => if o == owner {\n        Some(vs)\n      } else {\n        None\n      },\n      None => None,\n    },\n    ast.Unary { op: ast.Not, operand } => match check.result_variants(i, operand, owner) {\n      Some(vs) => Some(all.difference(vs)),\n      None => None,\n    },\n    ast.Binary { op: ast.Or, left, right } => match (\n      check.result_variants(i, left, owner),\n      check.result_variants(i, right, owner),\n    ) {\n      (Some(a), Some(b)) => Some(a.union(b)),\n      _ => None,\n    },\n    ast.Binary { op: ast.And, left, right } => match (\n      check.result_variants(i, left, owner),\n      check.result_variants(i, right, owner),\n    ) {\n      (Some(a), Some(b)) => Some(a.intersection(b)),\n      _ => None,\n    },\n    _ => None,\n  }\n}"},{"name":"check.variants_named","kind":"fn","old":null,"new":"2458a45ea7f9eb52","interface_changed":true,"affected":[],"module":"check","text":"/// What `is V` tests, as a sum and the variants it accepts: one variant\n/// (`Shipped`) or the whole sum (`Order`). Only sums without type parameters,\n/// as `TVariants` models.\nfn variants_named(i: check.Inf, v: String) -> Option[(String, Set[String])] {\n  if contains(i.types.sums, v) {\n    return match get(i.types.variants, v) {\n      Some(vs) => Some((v, set(vs))),\n      None => None,\n    }\n  }\n  match get(i.types.ctors, v) {\n    Some(sh) => if sh.owner != v\n      && len(sh.params) == 0\n      && contains(i.types.sums, sh.owner) {\n      Some((sh.owner, set([v])))\n    } else {\n      None\n    },\n    None => None,\n  }\n}"},{"name":"check.decide","kind":"fn","old":null,"new":"5045e61c89761a6d","interface_changed":true,"affected":[],"module":"check","text":"/// Whether condition `a` on a call's arguments holds, when their types\n/// decide it: `p is V` where the argument for `p` is narrowed to variants\n/// all inside `V` (true) or all outside it (false); `!`, `&&`, `||` of such;\n/// `true`, `false`. `None`: the types don't say.\nfn decide(\n  i: check.Inf,\n  a: ast.Expr,\n  params: List[String],\n  args: List[check.Ty],\n) -> Option[Bool] {\n  match a {\n    ast.BoolLit(b) => Some(b),\n    ast.Unary { op: ast.Not, operand } => match check.decide(i, operand, params, args) {\n      Some(b) => Some(!b),\n      None => None,\n    },\n    ast.Binary { op: ast.And, left, right } => match (\n      check.decide(i, left, params, args),\n      check.decide(i, right, params, args),\n    ) {\n      (Some(false), _) => Some(false),\n      (_, Some(false)) => Some(false),\n      (Some(true), Some(true)) => Some(true),\n      _ => None,\n    },\n    ast.Binary { op: ast.Or, left, right } => match (\n      check.decide(i, left, params, args),\n      check.decide(i, right, params, args),\n    ) {\n      (Some(true), _) => Some(true),\n      (_, Some(true)) => Some(true),\n      (Some(false), Some(false)) => Some(false),\n      _ => None,\n    },\n    ast.IsExpr { value: ast.Var(p), variant } => {\n      mut k := -1\n      for (j, x) in enumerate(params) {\n        if x == p {\n          k = j\n        }\n      }\n      if k < 0 {\n        return None\n      }\n      (o, vs) := match check.variants_named(i, variant) {\n        Some(x) => x,\n        None => return None,\n      }\n      (ao, has) := match check.res(i, get(args, k) ?? check.TAny) {\n        check.TVariants { owner, names } => (owner, set(names)),\n        check.TNamed { name, args: [] } => (name, set(get(i.types.variants, name) ?? [])),\n        _ => return None,\n      }\n      if ao != o || len(has) == 0 {\n        None\n      } else if has.difference(vs).len() == 0 {\n        Some(true)\n      } else if has.intersection(vs).len() == 0 {\n        Some(false)\n      } else {\n        None\n      }\n    },\n    _ => None,\n  }\n}"},{"name":"check.variants_field","kind":"fn","old":null,"new":"3caae8ff5e3f4eb6","interface_changed":true,"affected":[],"module":"check","text":"/// Field `f` of a value that is one of `variants` (with the sum's type\n/// arguments `targs`): its type when every one of them has it, with the\n/// same type; else an error naming one that hasn't. `t`: the value's type,\n/// as shown.\nfn variants_field(\n  mut i: check.Inf,\n  variants: List[String],\n  targs: List[check.Ty],\n  f: String,\n  t: String,\n) -> check.Ty {\n  mut out: Option[check.Ty] = None\n  for v in variants {\n    match get(i.types.ctors, v) {\n      Some(sh) => match check.field_of(sh, f) {\n        Some(ft) => {\n          mut m := Dict[String, check.Ty] {}\n          for (k, p) in enumerate(sh.params) {\n            mut m.insert(p, get(targs, k) ?? check.TAny)\n          }\n          out = Some(check.inst(ft, m))\n        },\n        None => {\n          parts := split(v, \".\")\n          vn := get(parts, len(parts) - 1) ?? v\n          check.error(\n            mut i,\n            f\"`{vn}` has no field `{f}`, so not every `{t}` does (match on it first)\",\n          )\n          return check.TAny\n        },\n      },\n      None => return check.TAny,\n    }\n  }\n  match out {\n    Some(x) => check.place(i, x),\n    None => check.TAny,\n  }\n}"}]}
{"id":"fbee1b2c6a92a605","time":1795707437,"message":"edit","changes":[{"name":"check.infer_block","kind":"fn","old":"ced6b92c9851c5f8","new":"7f0c96d982741012","interface_changed":false,"affected":[],"module":"check","text":"/// The type of a block's statements and last expression. Any type when it\n/// ends in `break`, `continue` or `return`, since it never gives a value.\nfn infer_block(\n  mut i: check.Inf,\n  stmts: List[ast.Stmt],\n  last: ast.Expr,\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  mut seen := env\n  if len(stmts.filter(s -> s is ast.Decreases)) > 1 {\n    check.error(\n      mut i,\n      \"more than one `decreases` clause: write one, `decreases (a, b)` for measures compared in order\",\n    )\n  }\n  for s in stmts {\n    match s {\n      ast.Let { pat, ty, value } => {\n        ann := match ty {\n          Some(a) => Some(check.lower(i.types, i.tparams, a)),\n          None => None,\n        }\n        t := check.infer(mut i, value, seen, ann)\n        match ann {\n          Some(a) => check.expect(mut i, a, t, \"let annotation\"),\n          None => (),\n        }\n        if pat is ast.Wild {\n          mut i.dropped.push((value, t))\n        }\n        // any pattern's value: a tuple's, for codegen\n        mut i.lets.push(\n          (match pat {\n            ast.Bind(n) => n,\n            _ => \"\",\n          }, ann ?? t),\n        )\n        seen = match pat {\n          ast.Bind(n) => {\n            mut copy := seen\n            mut copy.insert(n, ann ?? t)\n            copy\n          },\n          _ => check.bind_typed(mut i, seen, pat, ann ?? t),\n        }\n      },\n      ast.VarDecl { name, ty, value } => {\n        ann := match ty {\n          Some(a) => Some(check.lower(i.types, i.tparams, a)),\n          None => None,\n        }\n        t0 := check.infer(mut i, value, seen, ann)\n        match ann {\n          Some(a) => check.expect(mut i, a, t0, \"let annotation\"),\n          None => (),\n        }\n        // a variable may later hold any variant: narrowed values (a narrowed\n        // variable's, a call's narrowed result) give it their sum\n        t := match check.res(i, t0) {\n          check.TVariants { owner, .. } => check.TNamed { name: owner, args: [] },\n          _ => t0,\n        }\n        mut i.lets.push((name, ann ?? t))\n        mut seen.insert(name, ann ?? t)\n        // a refined type written: what the variable may hold\n        match ty {\n          Some(w) => mut i.written.insert(name, w),\n          None => (),\n        }\n      },\n      ast.Assign { place, value } => {\n        // a variable declared outside the `scope` holding or getting a handle\n        root := check.root_var(place)\n        // a variable assigned has its declared type, even where a `match` narrows\n        // it: `best = match best { None => Some(x), .. }` says what\n        // `mut best := None` holds\n        pt := match place {\n          ast.Var(x) => match get(seen, x) {\n            Some(t) => t,\n            None => check.infer(mut i, place, seen, None),\n          },\n          _ => check.infer(mut i, place, seen, None),\n        }\n        if check.outside_scope(i, root)\n          && check.holds_task(\n            check.res(i, get(seen, root) ?? check.TAny),\n          ) {\n          check.error(\n            mut i,\n            \"`\"\n              + root\n              + \"` is declared outside the `scope`, so a task's handle can't be stored in it\",\n          )\n        }\n        // `xs[i] = v`: the element's type, said as written\n        et := if check.element_assigned(mut i, place, value, seen) {\n          pt\n        } else {\n          vt := check.infer(mut i, value, seen, Some(pt))\n          check.expect(mut i, pt, vt, \"assignment\")\n          vt\n        }\n        if check.outside_scope(i, root)\n          && check.holds_task(check.res(i, et)) {\n          check.error(\n            mut i,\n            \"`\"\n              + root\n              + \"` is declared outside the `scope`, so a task's handle can't be stored in it\",\n          )\n        }\n      },\n      ast.While { cond, body } => {\n        ct := check.infer(mut i, cond, seen, None)\n        check.expect(mut i, check.TBool, ct, \"while condition\")\n        check.infer(mut i, body, seen, None)\n      },\n      ast.For { pat, iter, body } => {\n        it := check.infer(mut i, iter, seen, None)\n        check.not_iterable(mut i, it)\n        mut i.iters.push(it)\n        // the loop's variable isn't in scope in its invariants: they hold between\n        // elements too\n        bound := check.pattern_binds(pat, Set[String] {})\n        invs := match body {\n          ast.Block { stmts, .. } => [x for s in stmts where s is ast.Invariant for x in match s {\n            ast.Invariant(x) => [x],\n            _ => [],\n          }],\n          _ => [],\n        }\n        if match body {\n          ast.Block { stmts, .. } => stmts.any(s -> s is ast.Decreases),\n          _ => false,\n        } {\n          check.error(\n            mut i,\n            \"a `for` loop has no `decreases` clause: it ends on its own (the clause is for `while` and `loop`)\",\n          )\n        }\n        mut named: Option[String] = None\n        for x in invs {\n          if named is None {\n            named = check.var_named(x, bound)\n          }\n        }\n        match named {\n          Some(v) => check.error(mut i, \"an invariant of `for \"\n            + text.pattern_text(pat)\n            + \" in …` can't name the loop's variable `\"\n            + v\n            + \"`: it holds before the first element and after the last too\"),\n          None => (),\n        }\n        inner := check.bind_typed(mut i, seen, pat, check.element_of(i, it))\n        check.infer(mut i, body, inner, None)\n      },\n      ast.ComptimeFor { pat, iter, body } => {\n        _ := check.infer(mut i, iter, seen, None)\n        check.infer(\n          mut i,\n          body,\n          check.bind_pattern(seen, pat),\n          None,\n        )\n      },\n      ast.Loop(b) => check.infer(mut i, b, seen, None),\n      ast.ExprStmt(x) => {\n        t := check.infer(mut i, x, seen, None)\n        first := match x {\n          ast.Call { args: [ast.Var(v), ..], .. } => get(seen, v),\n          _ => None,\n        }\n        mut i.discarded.push((x, t, first))\n      },\n      ast.Assert(x) => {\n        t := check.infer(mut i, x, seen, None)\n        check.expect(mut i, check.TBool, t, \"assert\")\n      },\n      ast.Invariant(x) => {\n        t := check.infer(mut i, x, seen, None)\n        check.expect(mut i, check.TBool, t, \"invariant\")\n      },\n      ast.AssertBy { cond, proof } => {\n        t := check.infer(mut i, cond, seen, None)\n        check.expect(mut i, check.TBool, t, \"assert\")\n        _ := check.infer(mut i, proof, seen, None)\n      },\n      ast.Calc(xs) => {\n        for x in ast.calc_steps(xs) {\n          t := check.infer(mut i, x, seen, None)\n          check.expect(mut i, check.TBool, t, \"calc\")\n        }\n      },\n      ast.Decreases(x) => {\n        parts := match x {\n          ast.TupleExpr(xs) => xs,\n          other => [other],\n        }\n        for p in parts {\n          t := check.infer(mut i, p, seen, None)\n          check.expect(mut i, check.TInt, t, \"decreases\")\n        }\n      },\n      _ => (),\n    }\n  }\n  t := check.infer(mut i, last, seen, expected)\n  if last is ast.UnitExpr && check.ends_in_jump(stmts) {\n    check.TAny\n  } else {\n    t\n  }\n}","old_text":"/// The type of a block's statements and last expression. Any type when it\n/// ends in `break`, `continue` or `return`, since it never gives a value.\nfn infer_block(\n  mut i: check.Inf,\n  stmts: List[ast.Stmt],\n  last: ast.Expr,\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  mut seen := env\n  if len(stmts.filter(s -> s is ast.Decreases)) > 1 {\n    check.error(\n      mut i,\n      \"more than one `decreases` clause: write one, `decreases (a, b)` for measures compared in order\",\n    )\n  }\n  for s in stmts {\n    match s {\n      ast.Let { pat, ty, value } => {\n        ann := match ty {\n          Some(a) => Some(check.lower(i.types, i.tparams, a)),\n          None => None,\n        }\n        t := check.infer(mut i, value, seen, ann)\n        match ann {\n          Some(a) => check.expect(mut i, a, t, \"let annotation\"),\n          None => (),\n        }\n        if pat is ast.Wild {\n          mut i.dropped.push((value, t))\n        }\n        // any pattern's value: a tuple's, for codegen\n        mut i.lets.push(\n          (match pat {\n            ast.Bind(n) => n,\n            _ => \"\",\n          }, ann ?? t),\n        )\n        seen = match pat {\n          ast.Bind(n) => {\n            mut copy := seen\n            mut copy.insert(n, ann ?? t)\n            copy\n          },\n          _ => check.bind_typed(mut i, seen, pat, ann ?? t),\n        }\n      },\n      ast.VarDecl { name, ty, value } => {\n        ann := match ty {\n          Some(a) => Some(check.lower(i.types, i.tparams, a)),\n          None => None,\n        }\n        t := check.infer(mut i, value, seen, ann)\n        match ann {\n          Some(a) => check.expect(mut i, a, t, \"let annotation\"),\n          None => (),\n        }\n        mut i.lets.push((name, ann ?? t))\n        mut seen.insert(name, ann ?? t)\n        // a refined type written: what the variable may hold\n        match ty {\n          Some(w) => mut i.written.insert(name, w),\n          None => (),\n        }\n      },\n      ast.Assign { place, value } => {\n        // a variable declared outside the `scope` holding or getting a handle\n        root := check.root_var(place)\n        // a variable assigned has its declared type, even where a `match` narrows\n        // it: `best = match best { None => Some(x), .. }` says what\n        // `mut best := None` holds\n        pt := match place {\n          ast.Var(x) => match get(seen, x) {\n            Some(t) => t,\n            None => check.infer(mut i, place, seen, None),\n          },\n          _ => check.infer(mut i, place, seen, None),\n        }\n        if check.outside_scope(i, root)\n          && check.holds_task(\n            check.res(i, get(seen, root) ?? check.TAny),\n          ) {\n          check.error(\n            mut i,\n            \"`\"\n              + root\n              + \"` is declared outside the `scope`, so a task's handle can't be stored in it\",\n          )\n        }\n        // `xs[i] = v`: the element's type, said as written\n        et := if check.element_assigned(mut i, place, value, seen) {\n          pt\n        } else {\n          vt := check.infer(mut i, value, seen, Some(pt))\n          check.expect(mut i, pt, vt, \"assignment\")\n          vt\n        }\n        if check.outside_scope(i, root)\n          && check.holds_task(check.res(i, et)) {\n          check.error(\n            mut i,\n            \"`\"\n              + root\n              + \"` is declared outside the `scope`, so a task's handle can't be stored in it\",\n          )\n        }\n      },\n      ast.While { cond, body } => {\n        ct := check.infer(mut i, cond, seen, None)\n        check.expect(mut i, check.TBool, ct, \"while condition\")\n        check.infer(mut i, body, seen, None)\n      },\n      ast.For { pat, iter, body } => {\n        it := check.infer(mut i, iter, seen, None)\n        check.not_iterable(mut i, it)\n        mut i.iters.push(it)\n        // the loop's variable isn't in scope in its invariants: they hold between\n        // elements too\n        bound := check.pattern_binds(pat, Set[String] {})\n        invs := match body {\n          ast.Block { stmts, .. } => [x for s in stmts where s is ast.Invariant for x in match s {\n            ast.Invariant(x) => [x],\n            _ => [],\n          }],\n          _ => [],\n        }\n        if match body {\n          ast.Block { stmts, .. } => stmts.any(s -> s is ast.Decreases),\n          _ => false,\n        } {\n          check.error(\n            mut i,\n            \"a `for` loop has no `decreases` clause: it ends on its own (the clause is for `while` and `loop`)\",\n          )\n        }\n        mut named: Option[String] = None\n        for x in invs {\n          if named is None {\n            named = check.var_named(x, bound)\n          }\n        }\n        match named {\n          Some(v) => check.error(mut i, \"an invariant of `for \"\n            + text.pattern_text(pat)\n            + \" in …` can't name the loop's variable `\"\n            + v\n            + \"`: it holds before the first element and after the last too\"),\n          None => (),\n        }\n        inner := check.bind_typed(mut i, seen, pat, check.element_of(i, it))\n        check.infer(mut i, body, inner, None)\n      },\n      ast.ComptimeFor { pat, iter, body } => {\n        _ := check.infer(mut i, iter, seen, None)\n        check.infer(\n          mut i,\n          body,\n          check.bind_pattern(seen, pat),\n          None,\n        )\n      },\n      ast.Loop(b) => check.infer(mut i, b, seen, None),\n      ast.ExprStmt(x) => {\n        t := check.infer(mut i, x, seen, None)\n        first := match x {\n          ast.Call { args: [ast.Var(v), ..], .. } => get(seen, v),\n          _ => None,\n        }\n        mut i.discarded.push((x, t, first))\n      },\n      ast.Assert(x) => {\n        t := check.infer(mut i, x, seen, None)\n        check.expect(mut i, check.TBool, t, \"assert\")\n      },\n      ast.Invariant(x) => {\n        t := check.infer(mut i, x, seen, None)\n        check.expect(mut i, check.TBool, t, \"invariant\")\n      },\n      ast.AssertBy { cond, proof } => {\n        t := check.infer(mut i, cond, seen, None)\n        check.expect(mut i, check.TBool, t, \"assert\")\n        _ := check.infer(mut i, proof, seen, None)\n      },\n      ast.Calc(xs) => {\n        for x in ast.calc_steps(xs) {\n          t := check.infer(mut i, x, seen, None)\n          check.expect(mut i, check.TBool, t, \"calc\")\n        }\n      },\n      ast.Decreases(x) => {\n        parts := match x {\n          ast.TupleExpr(xs) => xs,\n          other => [other],\n        }\n        for p in parts {\n          t := check.infer(mut i, p, seen, None)\n          check.expect(mut i, check.TInt, t, \"decreases\")\n        }\n      },\n      _ => (),\n    }\n  }\n  t := check.infer(mut i, last, seen, expected)\n  if last is ast.UnitExpr && check.ends_in_jump(stmts) {\n    check.TAny\n  } else {\n    t\n  }\n}"},{"name":"check.infer_match","kind":"fn","old":"f828751bb6efc437","new":"500d8c4977bd0846","interface_changed":false,"affected":[],"module":"check","text":"fn infer_match(\n  mut i: check.Inf,\n  scrutinee: ast.Expr,\n  binding: Option[String],\n  arms: List[ast.Arm],\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  st := check.infer(mut i, scrutinee, env, None)\n  // narrowing drops variants, never type arguments: patterns can use the\n  // matched variable's declared type\n  pt := match scrutinee {\n    ast.Var(x) => get(env, x) ?? st,\n    _ => st,\n  }\n  base := match binding {\n    Some(b) => {\n      mut copy := env\n      mut copy.insert(b, check.TAny)\n      copy\n    },\n    None => env,\n  }\n  // the variable an arm narrows: the `as` name, else the matched variable\n  target := match binding {\n    Some(b) => Some(b),\n    None => match scrutinee {\n      ast.Var(x) => Some(x),\n      _ => None,\n    },\n  }\n  for a in arms {\n    // an arm's own binding of the whole value has its declared type; a\n    // constructor's fields get their types\n    mut inner := check.bind_typed(mut i, base, a.pat, pt)\n    // in an arm naming variants, the matched variable is those variants,\n    // unless the arm assigns to it\n    match (target, check.arm_variants(i, a.pat)) {\n      (Some(x), Some(v)) => if !check.assigns_to(a.body, x) {\n        mut inner.insert(x, v)\n      },\n      // a union's members an arm names (`Int =>`): the variable is them\n      (Some(x), None) => match check.arm_members(i, get(env, x) ?? st, a.pat) {\n        Some(v) => if !check.assigns_to(a.body, x) {\n          mut inner.insert(x, v)\n        },\n        None => (),\n      },\n      _ => (),\n    }\n    // an arm naming a refinement (`Positive =>`): the variable is of it there\n    held := i.written\n    match (target, a.pat) {\n      (Some(x), ast.CtorPattern { name: rn, args: ast.NoPats }) => if !check.assigns_to(a.body, x)\n        && check.named_refinement(i, rn) is Some {\n        mut i.written.insert(x, ast.Named { name: rn, args: [] })\n      },\n      _ => (),\n    }\n    // an arm that assigns to the matched variable sees its declared type\n    outer := i.exempt\n    match target {\n      Some(x) => if check.assigns_to(a.body, x) {\n        mut i.exempt.insert(x)\n      },\n      None => (),\n    }\n    match expected {\n      Some(r) => {\n        bt := check.infer(mut i, a.body, inner, Some(r))\n        check.expect(mut i, r, bt, \"match arm\")\n      },\n      None => check.infer(mut i, a.body, inner, None),\n    }\n    i.exempt = outer\n    i.written = held\n  }\n  // every value covered and no arm unreachable, on integers, floats,\n  // strings, lists, tuples and unions; `exhaustive` checks sums\n  w := match scrutinee {\n    ast.Var(x) => get(i.written, x),\n    ast.Call { callee: ast.Var(fname), .. } => match get(i.types.rets, fname) {\n      Some(rt) => match rt {\n        ast.Refined { .. } => Some(rt),\n        ast.Named { args: [], .. } => Some(rt),\n        _ => None,\n      },\n      None => None,\n    },\n    _ => None,\n  }\n  check.check_coverage(mut i, check.res(i, pt), arms, w)\n  // a call whose callee says which variants its result is: covered here,\n  // with the variants left at this call (`exhaustive` leaves it out)\n  match scrutinee {\n    ast.Call { callee: ast.Var(f), .. } => if !contains(env, f) && contains(i.types.narrows, f) {\n      check.variants_covered(mut i, check.res(i, st), arms)\n    },\n    _ => (),\n  }\n  expected ?? check.TAny\n}","old_text":"fn infer_match(\n  mut i: check.Inf,\n  scrutinee: ast.Expr,\n  binding: Option[String],\n  arms: List[ast.Arm],\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  st := check.infer(mut i, scrutinee, env, None)\n  // narrowing drops variants, never type arguments: patterns can use the\n  // matched variable's declared type\n  pt := match scrutinee {\n    ast.Var(x) => get(env, x) ?? st,\n    _ => st,\n  }\n  base := match binding {\n    Some(b) => {\n      mut copy := env\n      mut copy.insert(b, check.TAny)\n      copy\n    },\n    None => env,\n  }\n  // the variable an arm narrows: the `as` name, else the matched variable\n  target := match binding {\n    Some(b) => Some(b),\n    None => match scrutinee {\n      ast.Var(x) => Some(x),\n      _ => None,\n    },\n  }\n  for a in arms {\n    // an arm's own binding of the whole value has its declared type; a\n    // constructor's fields get their types\n    mut inner := check.bind_typed(mut i, base, a.pat, pt)\n    // in an arm naming variants, the matched variable is those variants,\n    // unless the arm assigns to it\n    match (target, check.arm_variants(i, a.pat)) {\n      (Some(x), Some(v)) => if !check.assigns_to(a.body, x) {\n        mut inner.insert(x, v)\n      },\n      // a union's members an arm names (`Int =>`): the variable is them\n      (Some(x), None) => match check.arm_members(i, get(env, x) ?? st, a.pat) {\n        Some(v) => if !check.assigns_to(a.body, x) {\n          mut inner.insert(x, v)\n        },\n        None => (),\n      },\n      _ => (),\n    }\n    // an arm naming a refinement (`Positive =>`): the variable is of it there\n    held := i.written\n    match (target, a.pat) {\n      (Some(x), ast.CtorPattern { name: rn, args: ast.NoPats }) => if !check.assigns_to(a.body, x)\n        && check.named_refinement(i, rn) is Some {\n        mut i.written.insert(x, ast.Named { name: rn, args: [] })\n      },\n      _ => (),\n    }\n    // an arm that assigns to the matched variable sees its declared type\n    outer := i.exempt\n    match target {\n      Some(x) => if check.assigns_to(a.body, x) {\n        mut i.exempt.insert(x)\n      },\n      None => (),\n    }\n    match expected {\n      Some(r) => {\n        bt := check.infer(mut i, a.body, inner, Some(r))\n        check.expect(mut i, r, bt, \"match arm\")\n      },\n      None => check.infer(mut i, a.body, inner, None),\n    }\n    i.exempt = outer\n    i.written = held\n  }\n  // every value covered and no arm unreachable, on integers, floats,\n  // strings, lists, tuples and unions; `exhaustive` checks sums\n  w := match scrutinee {\n    ast.Var(x) => get(i.written, x),\n    ast.Call { callee: ast.Var(fname), .. } => match get(i.types.rets, fname) {\n      Some(rt) => match rt {\n        ast.Refined { .. } => Some(rt),\n        ast.Named { args: [], .. } => Some(rt),\n        _ => None,\n      },\n      None => None,\n    },\n    _ => None,\n  }\n  check.check_coverage(mut i, check.res(i, pt), arms, w)\n  expected ?? check.TAny\n}"},{"name":"check.types_of","kind":"fn","old":"86643f0534f2d5b3","new":"f50963562348633a","interface_changed":false,"affected":[],"module":"check","text":"/// The program's record and sum types the checker models, by the names the\n/// stored form uses.\npub fn types_of(decls: List[ast.Decl]) -> check.Types {\n  // `Option` and `Result` come with the language\n  mut named := Dict[String, List[String]] { \"Option\": [\"T\"], \"Result\": [\"T\", \"E\"], \"Dict\": [\"K\", \"V\"], \"Set\": [\"A\"], \"Task\": [\"T\"], \"Sender\": [\"T\"], \"Receiver\": [\"T\"] }\n  mut sums := Set[String] { \"Option\", \"Result\" }\n  mut traits := Set[String] {}\n  for d in decls {\n    match d.kind {\n      // a capability's too, like `Console`: its methods' types are checked\n      ast.TraitDef(t) => if len(t.params) == 0 {\n        mut traits.insert(check.qualified(d.module, t.name))\n      },\n      _ => (),\n    }\n  }\n  mut aliases := Dict[String, ast.TypeExpr] {}\n  mut refinements := Dict[String, (ast.TypeExpr, ast.Expr)] {}\n  mut rets := Dict[String, ast.TypeExpr] {}\n  mut mut_written := Dict[String, List[Option[ast.TypeExpr]]] {}\n  mut narrows := Dict[String, (List[String], List[ast.Expr])] {}\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => if !t.distinct && len(t.params) == 0 {\n        match (t.body, t.refinement) {\n          (ast.Alias(a), Some(pred)) => mut refinements.insert(\n            check.qualified(d.module, t.name),\n            (a, pred),\n          ),\n          _ => (),\n        }\n      },\n      ast.FnDef(f) => {\n        mut rets.insert(check.qualified(d.module, f.name), f.ret)\n        facts := match f.ret {\n          ast.Refined { pred, .. } => [pred] + f.post,\n          _ => f.post,\n        }\n        if check.says_variant_of_it(facts) && len(f.type_params) == 0 {\n          mut narrows.insert(\n            check.qualified(d.module, f.name),\n            (f.params.map(p -> p.name), facts),\n          )\n        }\n        mut mut_written.insert(\n          check.qualified(d.module, f.name),\n          f.params.map(\n            p -> if p.mutable {\n              Some(p.ty)\n            } else {\n              None\n            },\n          ),\n        )\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      // an alias, refined or not, is the type it stands for. A record or a sum,\n      // refined or not, is a type of its own; its refinement is verify's, and\n      // its fields are checked as an unrefined one's are.\n      ast.TypeDef(t) => if !t.distinct {\n        q := check.qualified(d.module, t.name)\n        match t.body {\n          ast.Alias(a) => if len(t.params) == 0 {\n            mut aliases.insert(q, a)\n          },\n          ast.RecordBody(_) => mut named.insert(q, t.params),\n          ast.SumBody(vs) => if !vs.any(v -> v.payload is ast.MemberType) {\n            mut named.insert(q, t.params)\n            mut sums.insert(q)\n          },\n        }\n      } else if t.distinct {\n        // a `distinct` type: a type of its own, made of one field, `value`\n        mut named.insert(check.qualified(d.module, t.name), t.params)\n      },\n      _ => (),\n    }\n  }\n  mut ctors := Dict[String, check.Shape] { \"Some\": check.Shape {\n    owner: \"Option\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"None\": check.Shape {\n    owner: \"Option\",\n    fields: [],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"Ok\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  }, \"Err\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"E\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  } }\n  partial := check.Types {\n    named,\n    sums,\n    ctors: Dict[String, check.Shape] {},\n    aliases,\n    traits,\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => {\n        q := check.qualified(d.module, t.name)\n        if contains(named, q) {\n          tps := set(t.params)\n          match t.body {\n            ast.RecordBody(fs) => mut ctors.insert(\n              q,\n              check.Shape {\n                owner: q,\n                fields: fs.map(\n                  f -> (f.name, check.lower(partial, tps, f.ty)),\n                ),\n                positional: false,\n                required: check.required(fs),\n                params: t.params,\n              },\n            ),\n            ast.SumBody(vs) => {\n              for v in vs {\n                sh := match v.payload {\n                  ast.Positional(ts) => check.Shape {\n                    owner: q,\n                    fields: ts.map(x -> (\"\", check.lower(partial, tps, x))),\n                    positional: true,\n                    required: [],\n                    params: t.params,\n                  },\n                  ast.RecordPayload(fs) => check.Shape {\n                    owner: q,\n                    fields: fs.map(\n                      f -> (f.name, check.lower(partial, tps, f.ty)),\n                    ),\n                    positional: false,\n                    required: check.required(fs),\n                    params: t.params,\n                  },\n                  _ => check.Shape {\n                    owner: q,\n                    fields: [],\n                    positional: true,\n                    required: [],\n                    params: t.params,\n                  },\n                }\n                mut ctors.insert(check.qualified(d.module, v.name), sh)\n              }\n            },\n            ast.Alias(a) => if t.distinct {\n              mut ctors.insert(\n                q,\n                check.Shape {\n                  owner: q,\n                  fields: [(\"value\", check.lower(partial, tps, a))],\n                  positional: true,\n                  required: [],\n                  params: t.params,\n                },\n              )\n            },\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  mut variants := Dict[String, List[String]] {}\n  for (c, sh) in ctors {\n    if contains(sums, sh.owner) {\n      mut variants.insert(\n        sh.owner,\n        (get(variants, sh.owner) ?? []) + [c],\n      )\n    }\n  }\n  check.Types {\n    named,\n    sums,\n    ctors,\n    aliases,\n    traits,\n    refinements,\n    rets,\n    mut_written,\n    variants,\n    narrows,\n  }\n}","old_text":"/// The program's record and sum types the checker models, by the names the\n/// stored form uses.\npub fn types_of(decls: List[ast.Decl]) -> check.Types {\n  // `Option` and `Result` come with the language\n  mut named := Dict[String, List[String]] { \"Option\": [\"T\"], \"Result\": [\"T\", \"E\"], \"Dict\": [\"K\", \"V\"], \"Set\": [\"A\"], \"Task\": [\"T\"], \"Sender\": [\"T\"], \"Receiver\": [\"T\"] }\n  mut sums := Set[String] { \"Option\", \"Result\" }\n  mut traits := Set[String] {}\n  for d in decls {\n    match d.kind {\n      // a capability's too, like `Console`: its methods' types are checked\n      ast.TraitDef(t) => if len(t.params) == 0 {\n        mut traits.insert(check.qualified(d.module, t.name))\n      },\n      _ => (),\n    }\n  }\n  mut aliases := Dict[String, ast.TypeExpr] {}\n  mut refinements := Dict[String, (ast.TypeExpr, ast.Expr)] {}\n  mut rets := Dict[String, ast.TypeExpr] {}\n  mut mut_written := Dict[String, List[Option[ast.TypeExpr]]] {}\n  mut narrows := Dict[String, (List[String], List[ast.Expr])] {}\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => if !t.distinct && len(t.params) == 0 {\n        match (t.body, t.refinement) {\n          (ast.Alias(a), Some(pred)) => mut refinements.insert(\n            check.qualified(d.module, t.name),\n            (a, pred),\n          ),\n          _ => (),\n        }\n      },\n      ast.FnDef(f) => {\n        mut rets.insert(check.qualified(d.module, f.name), f.ret)\n        facts := match f.ret {\n          ast.Refined { pred, .. } => [pred] + f.post,\n          _ => f.post,\n        }\n        if len(facts) > 0 && len(f.type_params) == 0 {\n          mut narrows.insert(\n            check.qualified(d.module, f.name),\n            (f.params.map(p -> p.name), facts),\n          )\n        }\n        mut mut_written.insert(\n          check.qualified(d.module, f.name),\n          f.params.map(\n            p -> if p.mutable {\n              Some(p.ty)\n            } else {\n              None\n            },\n          ),\n        )\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      // an alias, refined or not, is the type it stands for. A record or a sum,\n      // refined or not, is a type of its own; its refinement is verify's, and\n      // its fields are checked as an unrefined one's are.\n      ast.TypeDef(t) => if !t.distinct {\n        q := check.qualified(d.module, t.name)\n        match t.body {\n          ast.Alias(a) => if len(t.params) == 0 {\n            mut aliases.insert(q, a)\n          },\n          ast.RecordBody(_) => mut named.insert(q, t.params),\n          ast.SumBody(vs) => if !vs.any(v -> v.payload is ast.MemberType) {\n            mut named.insert(q, t.params)\n            mut sums.insert(q)\n          },\n        }\n      } else if t.distinct {\n        // a `distinct` type: a type of its own, made of one field, `value`\n        mut named.insert(check.qualified(d.module, t.name), t.params)\n      },\n      _ => (),\n    }\n  }\n  mut ctors := Dict[String, check.Shape] { \"Some\": check.Shape {\n    owner: \"Option\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"None\": check.Shape {\n    owner: \"Option\",\n    fields: [],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"Ok\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  }, \"Err\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"E\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  } }\n  partial := check.Types {\n    named,\n    sums,\n    ctors: Dict[String, check.Shape] {},\n    aliases,\n    traits,\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => {\n        q := check.qualified(d.module, t.name)\n        if contains(named, q) {\n          tps := set(t.params)\n          match t.body {\n            ast.RecordBody(fs) => mut ctors.insert(\n              q,\n              check.Shape {\n                owner: q,\n                fields: fs.map(\n                  f -> (f.name, check.lower(partial, tps, f.ty)),\n                ),\n                positional: false,\n                required: check.required(fs),\n                params: t.params,\n              },\n            ),\n            ast.SumBody(vs) => {\n              for v in vs {\n                sh := match v.payload {\n                  ast.Positional(ts) => check.Shape {\n                    owner: q,\n                    fields: ts.map(x -> (\"\", check.lower(partial, tps, x))),\n                    positional: true,\n                    required: [],\n                    params: t.params,\n                  },\n                  ast.RecordPayload(fs) => check.Shape {\n                    owner: q,\n                    fields: fs.map(\n                      f -> (f.name, check.lower(partial, tps, f.ty)),\n                    ),\n                    positional: false,\n                    required: check.required(fs),\n                    params: t.params,\n                  },\n                  _ => check.Shape {\n                    owner: q,\n                    fields: [],\n                    positional: true,\n                    required: [],\n                    params: t.params,\n                  },\n                }\n                mut ctors.insert(check.qualified(d.module, v.name), sh)\n              }\n            },\n            ast.Alias(a) => if t.distinct {\n              mut ctors.insert(\n                q,\n                check.Shape {\n                  owner: q,\n                  fields: [(\"value\", check.lower(partial, tps, a))],\n                  positional: true,\n                  required: [],\n                  params: t.params,\n                },\n              )\n            },\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  mut variants := Dict[String, List[String]] {}\n  for (c, sh) in ctors {\n    if contains(sums, sh.owner) {\n      mut variants.insert(\n        sh.owner,\n        (get(variants, sh.owner) ?? []) + [c],\n      )\n    }\n  }\n  check.Types {\n    named,\n    sums,\n    ctors,\n    aliases,\n    traits,\n    refinements,\n    rets,\n    mut_written,\n    variants,\n    narrows,\n  }\n}"},{"name":"check.says_variant_of_it","kind":"fn","old":null,"new":"71e1daf49df845dd","interface_changed":true,"affected":[],"module":"check","text":"/// Whether one of `facts` says which variant the result is (`it is V`\n/// anywhere in it). A call of a function that does is narrowed by\n/// `narrowed_result`, and its matches are covered by `variants_covered`.\npub fn says_variant_of_it(facts: List[ast.Expr]) -> Bool {\n  facts.any(f -> check.tests_it(f))\n}"},{"name":"check.tests_it","kind":"fn","old":null,"new":"de6f0eb91fb1cf96","interface_changed":true,"affected":[],"module":"check","text":"fn tests_it(e: ast.Expr) -> Bool {\n  match e {\n    ast.IsExpr { value: ast.Var(\"it\"), .. } => true,\n    _ => check.children(e).any(c -> check.tests_it(c)),\n  }\n}"},{"name":"check.variants_covered","kind":"fn","old":null,"new":"28d337eb8b01307f","interface_changed":true,"affected":[],"module":"check","text":"/// A match on a call's result of type `t`, a sum without type parameters\n/// or some of its variants (`narrowed_result`): an error for each arm the\n/// arms above leave nothing to, and for a variant no arm covers. Arms with\n/// conditions or nested patterns cover nothing here, and then nothing is\n/// reported missing (`verify` proves the match).\nfn variants_covered(mut i: check.Inf, t: check.Ty, arms: List[ast.Arm]) {\n  (owner, can) := match t {\n    check.TVariants { owner, names } => (owner, names),\n    check.TNamed { name, args: [] } => if contains(i.types.sums, name) {\n      (name, get(i.types.variants, name) ?? [])\n    } else {\n      return\n    },\n    _ => return,\n  }\n  all := get(i.types.variants, owner) ?? []\n  mut left := set(can)\n  mut partial := false\n  for a in arms {\n    text := text.pattern_text(a.pat)\n    match check.pattern_variants(i, a.pat, owner, all) {\n      Some(vs) => {\n        if vs.intersection(left).len() == 0 {\n          if vs.intersection(set(can)).len() == 0 {\n            check.error(\n              mut i,\n              f\"unreachable match arm `{text}`: the result is `{check.shown(t) ?? owner}` here (from what its function ensures)\",\n            )\n          } else {\n            check.error(\n              mut i,\n              f\"unreachable match arm `{text}`: the arms above already cover it\",\n            )\n          }\n        }\n        left = left.difference(vs)\n      },\n      None => {\n        partial = true\n      },\n    }\n  }\n  if !partial {\n    for v in can {\n      if contains(left, v) {\n        parts := split(v, \".\")\n        vn := get(parts, len(parts) - 1) ?? v\n        check.error(\n          mut i,\n          f\"non-exhaustive match on `{check.shown(t) ?? owner}`: `{vn}` is not covered\",\n        )\n        return\n      }\n    }\n  }\n}"},{"name":"check.pattern_variants","kind":"fn","old":null,"new":"cdf5ab8e6dd69701","interface_changed":true,"affected":[],"module":"check","text":"/// The variants of sum `owner` that pattern `p` matches whole (`Shipped`,\n/// `Paid { .. }`, `_`, `x`, `A | B`), or `None` when it matches some values\n/// of one only (a nested pattern, a condition).\nfn pattern_variants(\n  i: check.Inf,\n  p: ast.Pattern,\n  owner: String,\n  all: List[String],\n) -> Option[Set[String]] {\n  match p {\n    ast.Wild => Some(set(all)),\n    ast.Bind(_) => Some(set(all)),\n    ast.CtorPattern { name, args } => {\n      whole := match args {\n        ast.NoPats => true,\n        ast.PositionalPats(ps) => ps.all(q -> q is ast.Wild || q is ast.Bind),\n        ast.RecordPats { fields, .. } => fields.all(fp -> fp.1 is ast.Wild || fp.1 is ast.Bind),\n        ast.TypePats(_) => false,\n      }\n      if !whole {\n        return None\n      }\n      if name == owner {\n        return Some(set(all))\n      }\n      if all.contains(name) {\n        Some(set([name]))\n      } else {\n        None\n      }\n    },\n    ast.OrPat(ps) => {\n      mut out := Set[String] {}\n      for q in ps {\n        match check.pattern_variants(i, q, owner, all) {\n          Some(vs) => {\n            out = out.union(vs)\n          },\n          None => return None,\n        }\n      }\n      Some(out)\n    },\n    _ => None,\n  }\n}"}]}
{"id":"7be0825a19bb992d","time":1795707471,"message":"edit","changes":[{"name":"exhaustive.program_of","kind":"fn","old":"d3d48a9409acdb0f","new":"fe5d4a0effa7d856","interface_changed":false,"affected":[],"module":"exhaustive","text":"/// The program's types, sums and return types as module `m`'s code names\n/// them (as stored): its own by their names, another module's by full name\n/// (`ops.Op`, its variants `ops.Add`), the root module's only in the root.\nfn program_of(m: String, decls: List[ast.Decl]) -> exhaustive.Program {\n  mut known := set([\n    \"Int\",\n    \"Float\",\n    \"String\",\n    \"Bool\",\n    \"List\",\n    \"Option\",\n    \"Result\",\n    \"Dict\",\n    \"Set\",\n  ])\n  mut sums := Dict[String, List[String]] {}\n  mut returns := Dict[String, ast.TypeExpr] {}\n  mut ctors := set([\"Some\", \"None\", \"Ok\", \"Err\"])\n  for d in decls {\n    q := if d.module == m || d.module == \"\" {\n      \"\"\n    } else {\n      d.module + \".\"\n    }\n    match d.kind {\n      ast.TypeDef(t) => match t.body {\n        ast.RecordBody(_) => {\n          ctors = {\n            mut copy := {\n              mut copy := ctors\n              mut copy.insert(t.name)\n              copy\n            }\n            mut copy.insert(q + t.name)\n            copy\n          }\n        },\n        ast.SumBody(vs) => {\n          for v in vs {\n            ctors = {\n              mut copy := {\n                mut copy := ctors\n                mut copy.insert(v.name)\n                copy\n              }\n              mut copy.insert(q + v.name)\n              copy\n            }\n          }\n        },\n        ast.Alias(_) => {\n          ctors = {\n            mut copy := {\n              mut copy := ctors\n              mut copy.insert(t.name)\n              copy\n            }\n            mut copy.insert(q + t.name)\n            copy\n          }\n        },\n      },\n      _ => (),\n    }\n    if d.module != m && d.module == \"\" {\n      continue\n    }\n    match d.kind {\n      ast.TypeDef(t) => if !t.distinct && !t.mocked && t.refinement == None {\n        match t.body {\n          ast.RecordBody(_) => mut known.insert(q + t.name),\n          ast.SumBody(vs) => {\n            mut known.insert(q + t.name)\n            if !vs.any(v -> v.payload is ast.MemberType) {\n              mut sums.insert(q + t.name, vs.map(v -> q + v.name))\n            }\n          },\n          ast.Alias(_) => (),\n        }\n      },\n      // a function whose `ensures` say which variant its result is: its\n      // calls' matches are `strata check`'s (`check.variants_covered`)\n      ast.FnDef(f) => if len(f.type_params) == 0\n        && d.module == m\n        && !(check.says_variant_of_it(f.post)\n          && exhaustive.plain_named(f.ret)) {\n        mut returns.insert(f.name, f.ret)\n      },\n      _ => (),\n    }\n  }\n  exhaustive.Program { known, sums, returns, ctors }\n}","old_text":"/// The program's types, sums and return types as module `m`'s code names\n/// them (as stored): its own by their names, another module's by full name\n/// (`ops.Op`, its variants `ops.Add`), the root module's only in the root.\nfn program_of(m: String, decls: List[ast.Decl]) -> exhaustive.Program {\n  mut known := set([\n    \"Int\",\n    \"Float\",\n    \"String\",\n    \"Bool\",\n    \"List\",\n    \"Option\",\n    \"Result\",\n    \"Dict\",\n    \"Set\",\n  ])\n  mut sums := Dict[String, List[String]] {}\n  mut returns := Dict[String, ast.TypeExpr] {}\n  mut ctors := set([\"Some\", \"None\", \"Ok\", \"Err\"])\n  for d in decls {\n    q := if d.module == m || d.module == \"\" {\n      \"\"\n    } else {\n      d.module + \".\"\n    }\n    match d.kind {\n      ast.TypeDef(t) => match t.body {\n        ast.RecordBody(_) => {\n          ctors = {\n            mut copy := {\n              mut copy := ctors\n              mut copy.insert(t.name)\n              copy\n            }\n            mut copy.insert(q + t.name)\n            copy\n          }\n        },\n        ast.SumBody(vs) => {\n          for v in vs {\n            ctors = {\n              mut copy := {\n                mut copy := ctors\n                mut copy.insert(v.name)\n                copy\n              }\n              mut copy.insert(q + v.name)\n              copy\n            }\n          }\n        },\n        ast.Alias(_) => {\n          ctors = {\n            mut copy := {\n              mut copy := ctors\n              mut copy.insert(t.name)\n              copy\n            }\n            mut copy.insert(q + t.name)\n            copy\n          }\n        },\n      },\n      _ => (),\n    }\n    if d.module != m && d.module == \"\" {\n      continue\n    }\n    match d.kind {\n      ast.TypeDef(t) => if !t.distinct && !t.mocked && t.refinement == None {\n        match t.body {\n          ast.RecordBody(_) => mut known.insert(q + t.name),\n          ast.SumBody(vs) => {\n            mut known.insert(q + t.name)\n            if !vs.any(v -> v.payload is ast.MemberType) {\n              mut sums.insert(q + t.name, vs.map(v -> q + v.name))\n            }\n          },\n          ast.Alias(_) => (),\n        }\n      },\n      ast.FnDef(f) => if len(f.type_params) == 0 && d.module == m {\n        mut returns.insert(f.name, f.ret)\n      },\n      _ => (),\n    }\n  }\n  exhaustive.Program { known, sums, returns, ctors }\n}"},{"name":"exhaustive.use check","kind":"use","old":null,"new":"66b705410054eb45","interface_changed":true,"affected":[],"module":"exhaustive","text":"from check use says_variant_of_it"},{"name":"exhaustive.plain_named","kind":"fn","old":null,"new":"e5de6e1ada757ae0","interface_changed":true,"affected":[],"module":"exhaustive","text":"/// A named type without type arguments (`Order`).\nfn plain_named(t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Named { args, .. } => len(args) == 0,\n    _ => false,\n  }\n}"}]}
{"id":"9845763acf8d5774","time":1795707829,"message":"edit","changes":[{"name":"walk.use ast","kind":"use","old":"466b3062f6a4fcbf","new":"99079d416ecf1f42","interface_changed":true,"affected":[],"module":"walk","text":"// walk: rebuilding a tree one level at a time, for the passes that rewrite\n// it (`desugar`, `derive`). Each function applies `fe` and `ft` to the direct\n// children only, so a pass recurses where it wants: innermost first, or\n// stopping at a node it rewrites whole.\n\nfrom ast use DeriveFnDef, ModelDecl, ModelDef, Decl, DeclKind, TypeDecl, Field,\n  Variant, FnDecl, Param, Bound, TestDecl, TraitDecl, TraitMethod, Law,\n  ImplDecl, ExternDecl, CapabilityDecl, TypeExpr, Expr, LamParam, CompFor, Arm,\n  Stmt, Pattern, SelectArm, StrPart, CtorArgs, CtorPat, TypeDef, FnDef, TestDef,\n  TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, Alias, RecordBody,\n  SumBody, NoPayload, Positional, RecordPayload, MemberType, ExternFn,\n  ExternType, ExternStatic, ExternThreadStatic, Named, FnType, UnitType,\n  Refined, UnionType, TupleExpr, ListExpr, CtorExpr, Call, MethodCall, FieldOf,\n  Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr, MutExpr, Block, MockExpr,\n  Return, Try, Except, Interp, Range, Index, Comp, DictExpr, SetExpr, Fallback,\n  Comptime, Scope, Spawn, Await, Select, Race, SupervisedSpawn, Old, Assumed,\n  Spread, NoArgs, PositionalArgs, RecordArgs, UpdateArgs, TextPart, ValuePart,\n  Let, VarDecl, Assign, While, For, Loop, ExprStmt, Assert, ComptimeFor,\n  Invariant, Decreases, CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat,\n  NoPats, PositionalPats, RecordPats, TypePats, AssertBy, Calc, Var","old_text":"// walk: rebuilding a tree one level at a time, for the passes that rewrite\n// it (`desugar`, `derive`). Each function applies `fe` and `ft` to the direct\n// children only, so a pass recurses where it wants: innermost first, or\n// stopping at a node it rewrites whole.\n\nfrom ast use DeriveFnDef, ModelDecl, ModelDef, Decl, DeclKind, TypeDecl, Field,\n  Variant, FnDecl, Param, Bound, TestDecl, TraitDecl, TraitMethod, Law,\n  ImplDecl, ExternDecl, CapabilityDecl, TypeExpr, Expr, LamParam, CompFor, Arm,\n  Stmt, Pattern, SelectArm, StrPart, CtorArgs, CtorPat, TypeDef, FnDef, TestDef,\n  TraitDef, ImplDef, UseDef, ExternDef, CapabilityDef, Alias, RecordBody,\n  SumBody, NoPayload, Positional, RecordPayload, MemberType, ExternFn,\n  ExternType, ExternStatic, ExternThreadStatic, Named, FnType, UnitType,\n  Refined, UnionType, TupleExpr, ListExpr, CtorExpr, Call, MethodCall, FieldOf,\n  Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr, MutExpr, Block, MockExpr,\n  Return, Try, Except, Interp, Range, Index, Comp, DictExpr, SetExpr, Fallback,\n  Comptime, Scope, Spawn, Await, Select, Race, SupervisedSpawn, Old, Assumed,\n  Spread, NoArgs, PositionalArgs, RecordArgs, UpdateArgs, TextPart, ValuePart,\n  Let, VarDecl, Assign, While, For, Loop, ExprStmt, Assert, ComptimeFor,\n  Invariant, Decreases, CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat,\n  NoPats, PositionalPats, RecordPats, TypePats, AssertBy, Calc"},{"name":"walk.says_variant_of_it","kind":"fn","old":null,"new":"96c26e5cb79bc7b0","interface_changed":true,"affected":[],"module":"walk","text":"/// Whether one of `facts` (a function's `ensures`, its result type's\n/// refinement) says which variant the result is: `it is V` anywhere in it.\n/// `strata check` narrows such a function's calls (`check.narrowed_result`)\n/// and covers the matches on them (`check.variants_covered`); `verify`\n/// proves that some arm of such a match matches.\npub fn says_variant_of_it(facts: List[ast.Expr]) -> Bool {\n  facts.any(f -> walk.tests_it(f))\n}"},{"name":"walk.tests_it","kind":"fn","old":null,"new":"eefa412eb6c350c9","interface_changed":true,"affected":[],"module":"walk","text":"fn tests_it(e: ast.Expr) -> Bool {\n  match e {\n    ast.IsExpr { value: ast.Var(\"it\"), .. } => true,\n    _ => walk.kids(e).any(c -> walk.tests_it(c)),\n  }\n}"},{"name":"walk.result_facts","kind":"fn","old":null,"new":"e7f3756f626dac8f","interface_changed":true,"affected":[],"module":"walk","text":"/// What a function says of its result: its result type's refinement, then\n/// its `ensures`.\npub fn result_facts(f: ast.FnDecl) -> List[ast.Expr] {\n  match f.ret {\n    ast.Refined { pred, .. } => [pred] + f.post,\n    _ => f.post,\n  }\n}"}]}
{"id":"949bfc7e821c6c10","time":1795708004,"message":"edit","changes":[{"name":"exhaustive.Program","kind":"type","old":"1a41285525a7c051","new":"d3c3f47bdf56d15c","interface_changed":false,"affected":[],"module":"exhaustive","text":"/// What a script declares that matches are checked against.\ntype Program = {\n  /// the type names that a type shown in a message may use\n  known: Set[String],\n  /// each sum type's variants, in order\n  sums: Dict[String, List[String]],\n  /// each non-generic function's return type (a call's match is judged\n  /// here only when it is `Bool`: `check.variants_covered` judges sums)\n  returns: Dict[String, ast.TypeExpr],\n  /// every record type's and variant's name: what a pattern may name\n  ctors: Set[String],\n}","old_text":"/// What a script declares that matches are checked against.\ntype Program = {\n  /// the type names that a type shown in a message may use\n  known: Set[String],\n  /// each sum type's variants, in order\n  sums: Dict[String, List[String]],\n  /// each non-generic function's return type\n  returns: Dict[String, ast.TypeExpr],\n  /// every record type's and variant's name: what a pattern may name\n  ctors: Set[String],\n}"},{"name":"exhaustive.scrutinee_type","kind":"fn","old":"660fcb2bb9605551","new":"2b7599aa2a3ad71f","interface_changed":false,"affected":[],"module":"exhaustive","text":"/// The type of a matched expression, when the code says it: a parameter\n/// (not rebound, assigned, tested or narrowed), a call of a program\n/// function giving a `Bool`, a comparison.\nfn scrutinee_type(\n  s: ast.Expr,\n  params: Dict[String, ast.TypeExpr],\n  unsafe: Set[String],\n  hidden: Set[String],\n  p: exhaustive.Program,\n) -> Option[ast.TypeExpr] {\n  match s {\n    ast.Var(x) => if contains(unsafe, x) || contains(hidden, x) {\n      None\n    } else {\n      get(params, x)\n    },\n    ast.Call { callee, .. } => match callee {\n      ast.Var(f) => if contains(unsafe, f) || contains(params, f) {\n        None\n      } else {\n        match get(p.returns, f) {\n          Some(ast.Named { name: \"Bool\", args: [] }) => Some(ast.Named { name: \"Bool\", args: [] }),\n          _ => None,\n        }\n      },\n      _ => None,\n    },\n    ast.Binary { op, .. } => match op {\n      ast.Equal => Some(ast.Named { name: \"Bool\", args: [] }),\n      ast.NotEqual => Some(ast.Named { name: \"Bool\", args: [] }),\n      ast.Less => Some(ast.Named { name: \"Bool\", args: [] }),\n      ast.LessEq => Some(ast.Named { name: \"Bool\", args: [] }),\n      ast.Greater => Some(ast.Named { name: \"Bool\", args: [] }),\n      ast.GreaterEq => Some(ast.Named { name: \"Bool\", args: [] }),\n      ast.And => Some(ast.Named { name: \"Bool\", args: [] }),\n      ast.Or => Some(ast.Named { name: \"Bool\", args: [] }),\n      _ => None,\n    },\n    _ => None,\n  }\n}","old_text":"/// The type of a matched expression, when the code says it: a parameter\n/// (not rebound, assigned, tested or narrowed), a call of a program\n/// function, a comparison.\nfn scrutinee_type(\n  s: ast.Expr,\n  params: Dict[String, ast.TypeExpr],\n  unsafe: Set[String],\n  hidden: Set[String],\n  p: exhaustive.Program,\n) -> Option[ast.TypeExpr] {\n  match s {\n    ast.Var(x) => if contains(unsafe, x) || contains(hidden, x) {\n      None\n    } else {\n      get(params, x)\n    },\n    ast.Call { callee, .. } => match callee {\n      ast.Var(f) => if contains(unsafe, f) || contains(params, f) {\n        None\n      } else {\n        get(p.returns, f)\n      },\n      _ => None,\n    },\n    ast.Binary { op, .. } => match op {\n      ast.Equal => Some(ast.Named { name: \"Bool\", args: [] }),\n      ast.NotEqual => Some(ast.Named { name: \"Bool\", args: [] }),\n      ast.Less => Some(ast.Named { name: \"Bool\", args: [] }),\n      ast.LessEq => Some(ast.Named { name: \"Bool\", args: [] }),\n      ast.Greater => Some(ast.Named { name: \"Bool\", args: [] }),\n      ast.GreaterEq => Some(ast.Named { name: \"Bool\", args: [] }),\n      ast.And => Some(ast.Named { name: \"Bool\", args: [] }),\n      ast.Or => Some(ast.Named { name: \"Bool\", args: [] }),\n      _ => None,\n    },\n    _ => None,\n  }\n}"},{"name":"exhaustive.program_of","kind":"fn","old":"fe5d4a0effa7d856","new":"d3d48a9409acdb0f","interface_changed":false,"affected":[],"module":"exhaustive","text":"/// The program's types, sums and return types as module `m`'s code names\n/// them (as stored): its own by their names, another module's by full name\n/// (`ops.Op`, its variants `ops.Add`), the root module's only in the root.\nfn program_of(m: String, decls: List[ast.Decl]) -> exhaustive.Program {\n  mut known := set([\n    \"Int\",\n    \"Float\",\n    \"String\",\n    \"Bool\",\n    \"List\",\n    \"Option\",\n    \"Result\",\n    \"Dict\",\n    \"Set\",\n  ])\n  mut sums := Dict[String, List[String]] {}\n  mut returns := Dict[String, ast.TypeExpr] {}\n  mut ctors := set([\"Some\", \"None\", \"Ok\", \"Err\"])\n  for d in decls {\n    q := if d.module == m || d.module == \"\" {\n      \"\"\n    } else {\n      d.module + \".\"\n    }\n    match d.kind {\n      ast.TypeDef(t) => match t.body {\n        ast.RecordBody(_) => {\n          ctors = {\n            mut copy := {\n              mut copy := ctors\n              mut copy.insert(t.name)\n              copy\n            }\n            mut copy.insert(q + t.name)\n            copy\n          }\n        },\n        ast.SumBody(vs) => {\n          for v in vs {\n            ctors = {\n              mut copy := {\n                mut copy := ctors\n                mut copy.insert(v.name)\n                copy\n              }\n              mut copy.insert(q + v.name)\n              copy\n            }\n          }\n        },\n        ast.Alias(_) => {\n          ctors = {\n            mut copy := {\n              mut copy := ctors\n              mut copy.insert(t.name)\n              copy\n            }\n            mut copy.insert(q + t.name)\n            copy\n          }\n        },\n      },\n      _ => (),\n    }\n    if d.module != m && d.module == \"\" {\n      continue\n    }\n    match d.kind {\n      ast.TypeDef(t) => if !t.distinct && !t.mocked && t.refinement == None {\n        match t.body {\n          ast.RecordBody(_) => mut known.insert(q + t.name),\n          ast.SumBody(vs) => {\n            mut known.insert(q + t.name)\n            if !vs.any(v -> v.payload is ast.MemberType) {\n              mut sums.insert(q + t.name, vs.map(v -> q + v.name))\n            }\n          },\n          ast.Alias(_) => (),\n        }\n      },\n      ast.FnDef(f) => if len(f.type_params) == 0 && d.module == m {\n        mut returns.insert(f.name, f.ret)\n      },\n      _ => (),\n    }\n  }\n  exhaustive.Program { known, sums, returns, ctors }\n}","old_text":"/// The program's types, sums and return types as module `m`'s code names\n/// them (as stored): its own by their names, another module's by full name\n/// (`ops.Op`, its variants `ops.Add`), the root module's only in the root.\nfn program_of(m: String, decls: List[ast.Decl]) -> exhaustive.Program {\n  mut known := set([\n    \"Int\",\n    \"Float\",\n    \"String\",\n    \"Bool\",\n    \"List\",\n    \"Option\",\n    \"Result\",\n    \"Dict\",\n    \"Set\",\n  ])\n  mut sums := Dict[String, List[String]] {}\n  mut returns := Dict[String, ast.TypeExpr] {}\n  mut ctors := set([\"Some\", \"None\", \"Ok\", \"Err\"])\n  for d in decls {\n    q := if d.module == m || d.module == \"\" {\n      \"\"\n    } else {\n      d.module + \".\"\n    }\n    match d.kind {\n      ast.TypeDef(t) => match t.body {\n        ast.RecordBody(_) => {\n          ctors = {\n            mut copy := {\n              mut copy := ctors\n              mut copy.insert(t.name)\n              copy\n            }\n            mut copy.insert(q + t.name)\n            copy\n          }\n        },\n        ast.SumBody(vs) => {\n          for v in vs {\n            ctors = {\n              mut copy := {\n                mut copy := ctors\n                mut copy.insert(v.name)\n                copy\n              }\n              mut copy.insert(q + v.name)\n              copy\n            }\n          }\n        },\n        ast.Alias(_) => {\n          ctors = {\n            mut copy := {\n              mut copy := ctors\n              mut copy.insert(t.name)\n              copy\n            }\n            mut copy.insert(q + t.name)\n            copy\n          }\n        },\n      },\n      _ => (),\n    }\n    if d.module != m && d.module == \"\" {\n      continue\n    }\n    match d.kind {\n      ast.TypeDef(t) => if !t.distinct && !t.mocked && t.refinement == None {\n        match t.body {\n          ast.RecordBody(_) => mut known.insert(q + t.name),\n          ast.SumBody(vs) => {\n            mut known.insert(q + t.name)\n            if !vs.any(v -> v.payload is ast.MemberType) {\n              mut sums.insert(q + t.name, vs.map(v -> q + v.name))\n            }\n          },\n          ast.Alias(_) => (),\n        }\n      },\n      // a function whose `ensures` say which variant its result is: its\n      // calls' matches are `strata check`'s (`check.variants_covered`)\n      ast.FnDef(f) => if len(f.type_params) == 0\n        && d.module == m\n        && !(check.says_variant_of_it(f.post)\n          && exhaustive.plain_named(f.ret)) {\n        mut returns.insert(f.name, f.ret)\n      },\n      _ => (),\n    }\n  }\n  exhaustive.Program { known, sums, returns, ctors }\n}"},{"name":"exhaustive.match_errors","kind":"fn","old":"7a3d21d361af4d65","new":"a03228373a1aab13","interface_changed":false,"affected":[],"module":"exhaustive","text":"/// The matches in a script's functions that do not cover every value, as\n/// (function, message) worded as `strata check` words them. `lib` holds the\n/// other modules, whose types matches may be on and whose constructors\n/// patterns may name.\n/// A match is judged when the type of what it matches is known from the\n/// code (a parameter, a call of a program function giving a `Bool`, a\n/// comparison; `check.variants_covered` judges calls giving sums) and is a\n/// program sum type, `Option`, `Result` or `Bool`, and its arms are that\n/// type's constructor patterns (or `true`/`false`), `_` or a name. `where`\n/// arms, literals, lists and constructors partly covered by nested patterns\n/// are skipped: nothing is reported rather than a wrong error.\npub fn match_errors(\n  decls: List[ast.Decl],\n  lib: List[ast.Decl],\n) -> List[(String, String)] {\n  all := decls + lib\n  mut programs := Dict[String, exhaustive.Program] {}\n  mut out := []\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => {\n        p := match get(programs, d.module) {\n          Some(x) => x,\n          None => {\n            x := exhaustive.program_of(d.module, all)\n            mut programs.insert(d.module, x)\n            x\n          },\n        }\n        mut params := Dict[String, ast.TypeExpr] {}\n        for q in f.params {\n          if exhaustive.plain(q.ty, p.known, f.type_params) {\n            mut params.insert(q.name, q.ty)\n          }\n        }\n        seen := exhaustive.seen_in(f.body, Set[String] {}, [])\n        mut unsafe := Set[String] {}\n        for s in seen {\n          match s {\n            exhaustive.Bound(n) => mut unsafe.insert(n),\n            exhaustive.MatchAt { .. } => (),\n          }\n        }\n        for s in seen {\n          match s {\n            exhaustive.MatchAt { scrutinee, arms, hidden } => {\n              // the variants of the matched value's type, when known\n              vs_opt := match exhaustive.scrutinee_type(\n                scrutinee,\n                params,\n                unsafe,\n                hidden,\n                p,\n              ) {\n                Some(t) => if exhaustive.plain(t, p.known, f.type_params) {\n                  match exhaustive.variants_of(t, p) {\n                    Some(vs) => Some((t, vs)),\n                    None => None,\n                  }\n                } else {\n                  None\n                },\n                None => None,\n              }\n              // the arms that the arms above already cover\n              mut above := []\n              for a in arms {\n                if exhaustive.covered(above, a.pat, vs_opt) {\n                  mut out.push(\n                    (f.name, \"unreachable match arm `\"\n                      + text.pattern_text(a.pat)\n                      + \"`: the arms above already cover it\"),\n                  )\n                }\n                // on a sum value, a constructor no type has (reported as\n                // unknown) matches anything, as `strata check` takes it\n                above = exhaustive.alternatives(match a.pat {\n                  ast.CtorPattern { name, .. } => if vs_opt == None\n                    || contains(p.ctors, name)\n                    || contains(p.known, name)\n                    || len(split(name, \".\")) > 1 {\n                    a.pat\n                  } else {\n                    ast.Wild\n                  },\n                  _ => a.pat,\n                }, above)\n              }\n              match vs_opt {\n                Some((t, vs)) => match exhaustive.first_missing(vs, above) {\n                  Some(i) => {\n                    // another module's variant by its own name\n                    v := get(vs, i) ?? \"\"\n                    parts := split(v, \".\")\n                    mut out.push(\n                      (f.name, \"non-exhaustive match on `\"\n                        + text.type_text(t)\n                        + \"`: `\"\n                        + (get(parts, len(parts) - 1) ?? v)\n                        + \"` is not covered\"),\n                    )\n                  },\n                  None => (),\n                },\n                None => (),\n              }\n            },\n            exhaustive.Bound(_) => (),\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  out\n}","old_text":"/// The matches in a script's functions that do not cover every value, as\n/// (function, message) worded as `strata check` words them. `lib` holds the\n/// other modules, whose types matches may be on and whose constructors\n/// patterns may name.\n/// A match is judged when the type of what it matches is known from the\n/// code (a parameter, a call of a program function, a comparison) and is a\n/// program sum type, `Option`, `Result` or `Bool`, and its arms are that\n/// type's constructor patterns (or `true`/`false`), `_` or a name. `where`\n/// arms, literals, lists and constructors partly covered by nested patterns\n/// are skipped: nothing is reported rather than a wrong error.\npub fn match_errors(\n  decls: List[ast.Decl],\n  lib: List[ast.Decl],\n) -> List[(String, String)] {\n  all := decls + lib\n  mut programs := Dict[String, exhaustive.Program] {}\n  mut out := []\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => {\n        p := match get(programs, d.module) {\n          Some(x) => x,\n          None => {\n            x := exhaustive.program_of(d.module, all)\n            mut programs.insert(d.module, x)\n            x\n          },\n        }\n        mut params := Dict[String, ast.TypeExpr] {}\n        for q in f.params {\n          if exhaustive.plain(q.ty, p.known, f.type_params) {\n            mut params.insert(q.name, q.ty)\n          }\n        }\n        seen := exhaustive.seen_in(f.body, Set[String] {}, [])\n        mut unsafe := Set[String] {}\n        for s in seen {\n          match s {\n            exhaustive.Bound(n) => mut unsafe.insert(n),\n            exhaustive.MatchAt { .. } => (),\n          }\n        }\n        for s in seen {\n          match s {\n            exhaustive.MatchAt { scrutinee, arms, hidden } => {\n              // the variants of the matched value's type, when known\n              vs_opt := match exhaustive.scrutinee_type(\n                scrutinee,\n                params,\n                unsafe,\n                hidden,\n                p,\n              ) {\n                Some(t) => if exhaustive.plain(t, p.known, f.type_params) {\n                  match exhaustive.variants_of(t, p) {\n                    Some(vs) => Some((t, vs)),\n                    None => None,\n                  }\n                } else {\n                  None\n                },\n                None => None,\n              }\n              // the arms that the arms above already cover\n              mut above := []\n              for a in arms {\n                if exhaustive.covered(above, a.pat, vs_opt) {\n                  mut out.push(\n                    (f.name, \"unreachable match arm `\"\n                      + text.pattern_text(a.pat)\n                      + \"`: the arms above already cover it\"),\n                  )\n                }\n                // on a sum value, a constructor no type has (reported as\n                // unknown) matches anything, as `strata check` takes it\n                above = exhaustive.alternatives(match a.pat {\n                  ast.CtorPattern { name, .. } => if vs_opt == None\n                    || contains(p.ctors, name)\n                    || contains(p.known, name)\n                    || len(split(name, \".\")) > 1 {\n                    a.pat\n                  } else {\n                    ast.Wild\n                  },\n                  _ => a.pat,\n                }, above)\n              }\n              match vs_opt {\n                Some((t, vs)) => match exhaustive.first_missing(vs, above) {\n                  Some(i) => {\n                    // another module's variant by its own name\n                    v := get(vs, i) ?? \"\"\n                    parts := split(v, \".\")\n                    mut out.push(\n                      (f.name, \"non-exhaustive match on `\"\n                        + text.type_text(t)\n                        + \"`: `\"\n                        + (get(parts, len(parts) - 1) ?? v)\n                        + \"` is not covered\"),\n                    )\n                  },\n                  None => (),\n                },\n                None => (),\n              }\n            },\n            exhaustive.Bound(_) => (),\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"exhaustive.plain_named","kind":"fn","old":"e5de6e1ada757ae0","new":null,"interface_changed":true,"affected":[],"module":"exhaustive","old_text":"/// A named type without type arguments (`Order`).\nfn plain_named(t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Named { args, .. } => len(args) == 0,\n    _ => false,\n  }\n}"},{"name":"use check","kind":"use","old":"f2319e0871e070d9","new":null,"interface_changed":true,"affected":[],"module":"","old_text":"from check use instantiated, lambdas_typed, typed, own_methods_resolved"}]}
