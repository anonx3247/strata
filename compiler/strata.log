n.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// Field `f`'s written type in type or constructor `c`, with the arguments\n/// of `owner` (the value's type) substituted for `c`'s type parameters\n/// (`Box[String]`'s `table: Dict[Int, Entry[P]]` is a\n/// `Dict[Int, Entry[String]]`). A parameter whose argument is unknown stays\n/// as written.\nfn field_written(\n  g: codegen.Gen,\n  owner: check.Ty,\n  c: String,\n  f: String,\n) -> Option[ast.TypeExpr] {\n  ft := get(g.field_types, c + \".\" + f)?\n  ps := match get(g.types.ctors, c) {\n    Some(sh) => sh.params,\n    None => [],\n  }\n  args := match owner {\n    check.TNamed { args, .. } => args,\n    _ => [],\n  }\n  if ps == [] || len(ps) != len(args) {\n    return Some(ft)\n  }\n  mut known := []\n  mut written := []\n  for (k, p) in enumerate(ps) {\n    a := get(args, k) ?? check.TAny\n    if !(a is check.TAny) {\n      mut known.push(p)\n      mut written.push(codegen.written_of(a))\n    }\n  }\n  Some(codegen.written_in(ft, known, written))\n}","old_text":"/// Field `f`'s written type in type or constructor `c`, with the arguments\n/// of `owner` (the value's type) substituted for `c`'s type parameters\n/// (`Box[String]`'s `table: Dict[Int, Entry[P]]` is a\n/// `Dict[Int, Entry[String]]`). A parameter whose argument is unknown stays\n/// as written.\nfn field_written(\n  g: codegen.Gen,\n  owner: Ty,\n  c: String,\n  f: String,\n) -> Option[ast.TypeExpr] {\n  ft := get(g.field_types, c + \".\" + f)?\n  ps := match get(g.types.ctors, c) {\n    Some(sh) => sh.params,\n    None => [],\n  }\n  args := match owner {\n    TNamed { args, .. } => args,\n    _ => [],\n  }\n  if ps == [] || len(ps) != len(args) {\n    return Some(ft)\n  }\n  mut known := []\n  mut written := []\n  for (k, p) in enumerate(ps) {\n    a := get(args, k) ?? TAny\n    if !(a is TAny) {\n      mut known.push(p)\n      mut written.push(codegen.written_of(a))\n    }\n  }\n  Some(codegen.written_in(ft, known, written))\n}"},{"name":"codegen.push_in_place","kind":"fn","old":"0d0617d8b4092d27","new":"4121990a73d8f44b","interface_changed":false,"affected":[],"module":"codegen","text":"/// `x = push(x, e)` (`mut x.push(e)`), `x` a variable or a field of one:\n/// the old list is dead afterwards, so when nothing else holds it\n/// (`strata_list_pushable`: its header and buffer held once, the buffer\n/// all its own and, while an arena is open, the arena's; for a field, the\n/// record held once too) `e` goes after its elements in place, its header\n/// kept (`strata_list_push_owned`): no new header, nothing held again, and\n/// a full buffer grows where it is at its arena's top, else its elements\n/// move once into a buffer twice the size. Else as the built-in does (a new\n/// header). Either way the result is owned. `None` when `value` isn't\n/// such a call.\nfn push_in_place(\n  mut g: codegen.Gen,\n  place: ast.Expr,\n  target: ast.Expr,\n  rest: List[ast.Expr],\n) -> Option[codegen.V] {\n  match place {\n    ast.Var(_) | ast.FieldOf { base: ast.Var(_), .. } => (),\n    _ => return None,\n  }\n  // (the element may read the list, as it is worked out before the list\n  // changes; but not change it)\n  if target != place\n    || len(rest) != 1\n    || codegen.lookup(g, \"push\") is Some\n    || codegen.has_fn(g, \"push\")\n    || rest.any(\n      a -> walk.any_expr(a, e -> e is ast.MutExpr || e is ast.Block),\n    ) {\n    return None\n  }\n  cur := codegen.expr(mut g, target)\n  et := match cur.ty {\n    check.TList(e) => if codegen.holds_trait(e) {\n      return None\n    } else {\n      e\n    },\n    _ => return None,\n  }\n  x0 := codegen.expr_want(mut g, get(rest, 0) ?? ast.UnitExpr, check.TAny)\n  if x0.ty is check.TAny {\n    return Some(codegen.never())\n  }\n  // (an element that changes the list's type, as a union's member pushed\n  // onto a list of it does not: as the built-in does it)\n  if check.TList(codegen.better(et, x0.ty)) != cur.ty {\n    return Some(codegen.builtin(mut g, \"push\", [cur, x0]))\n  }\n  if g.copies {\n    codegen.note_extension(mut g, cur, \"1\")\n  }\n  // (the element held by the list either way; one already the union's,\n  // or not boxed, is `x1` itself)\n  x1 := codegen.take_value(mut g, x0)\n  x := if et is check.TUnion {\n    u := codegen.to_union(mut g, x1, et)\n    if u.op == x1.op {\n      u\n    } else {\n      codegen.take_value(mut g, u)\n    }\n  } else {\n    x1\n  }\n  sl := codegen.to_slot(mut g, x)\n  // a list proven owned is still checked against an open arena\n  // (`strata_list_arena_pushable`)\n  proven := codegen.proven_on(g, place)\n  owned := if proven && place is ast.Var {\n    o := codegen.held_test(mut g, \"strata_list_owned\", cur.op, true)\n    codegen.use_rt(mut g, \"strata_list_arena_pushable\")\n    a := codegen.fresh(mut g, \"arena\")\n    codegen.emit(\n      mut g,\n      f\"{a} = call i1 @strata_list_arena_pushable(ptr {cur.op})\",\n    )\n    if o == \"true\" {\n      a\n    } else {\n      both := codegen.fresh(mut g, \"owned\")\n      codegen.emit(mut g, f\"{both} = and i1 {o}, {a}\")\n      both\n    }\n  } else {\n    codegen.held_test(mut g, \"strata_list_pushable\", cur.op, false)\n  }\n  ok := match place {\n    ast.FieldOf { base, .. } => {\n      rv := codegen.expr(mut g, base)\n      u := codegen.held_test(mut g, \"strata_unique\", rv.op, proven)\n      both := codegen.fresh(mut g, \"owned\")\n      codegen.emit(mut g, f\"{both} = and i1 {owned}, {u}\")\n      both\n    },\n    _ => owned,\n  }\n  (here, copy, done) := (\n    codegen.label(mut g, \"push.here\"),\n    codegen.label(mut g, \"push.copy\"),\n    codegen.label(mut g, \"push.done\"),\n  )\n  codegen.emit(mut g, f\"br i1 {ok}, label %{here}, label %{copy}\")\n  codegen.block(mut g, here)\n  codegen.push_transparent(mut g)\n  codegen.use_rt(mut g, \"strata_list_push_owned\")\n  codegen.emit(\n    mut g,\n    f\"call void @strata_list_push_owned(ptr {cur.op}, i64 {sl})\",\n  )\n  codegen.dup_value(mut g, cur)\n  codegen.pop_scope(mut g)\n  from_here := codegen.current(g)\n  codegen.br(mut g, done)\n  // else a new header, as the built-in makes it\n  codegen.block(mut g, copy)\n  codegen.push_transparent(mut g)\n  made := codegen.call(mut g, cur.ty, \"strata_list_push\", [\n    cur,\n    codegen.V { ty: check.TInt, op: sl },\n    codegen.elements_kind(et),\n  ])\n  r := codegen.leave_branch(mut g, made)\n  from_copy := codegen.current(g)\n  codegen.br(mut g, done)\n  codegen.block(mut g, done)\n  p := codegen.fresh(mut g, \"updated\")\n  codegen.emit(\n    mut g,\n    f\"{p} = phi ptr [ {cur.op}, %{from_here} ], [ {r.op}, %{from_copy} ]\",\n  )\n  Some(codegen.temp(mut g, codegen.V { ty: cur.ty, op: p }))\n}","old_text":"/// `x = push(x, e)` (`mut x.push(e)`), `x` a variable or a field of one:\n/// the old list is dead afterwards, so when nothing else holds it\n/// (`strata_list_pushable`: its header and buffer held once, the buffer\n/// all its own and, while an arena is open, the arena's; for a field, the\n/// record held once too) `e` goes after its elements in place, its header\n/// kept (`strata_list_push_owned`): no new header, nothing held again, and\n/// a full buffer grows where it is at its arena's top, else its elements\n/// move once into a buffer twice the size. Else as the built-in does (a new\n/// header). Either way the result is owned. `None` when `value` isn't\n/// such a call.\nfn push_in_place(\n  mut g: codegen.Gen,\n  place: ast.Expr,\n  target: ast.Expr,\n  rest: List[ast.Expr],\n) -> Option[codegen.V] {\n  match place {\n    ast.Var(_) | ast.FieldOf { base: ast.Var(_), .. } => (),\n    _ => return None,\n  }\n  // (the element may read the list, as it is worked out before the list\n  // changes; but not change it)\n  if target != place\n    || len(rest) != 1\n    || codegen.lookup(g, \"push\") is Some\n    || codegen.has_fn(g, \"push\")\n    || rest.any(\n      a -> walk.any_expr(a, e -> e is ast.MutExpr || e is ast.Block),\n    ) {\n    return None\n  }\n  cur := codegen.expr(mut g, target)\n  et := match cur.ty {\n    TList(e) => if codegen.holds_trait(e) {\n      return None\n    } else {\n      e\n    },\n    _ => return None,\n  }\n  x0 := codegen.expr_want(mut g, get(rest, 0) ?? ast.UnitExpr, TAny)\n  if x0.ty is TAny {\n    return Some(codegen.never())\n  }\n  // (an element that changes the list's type, as a union's member pushed\n  // onto a list of it does not: as the built-in does it)\n  if TList(codegen.better(et, x0.ty)) != cur.ty {\n    return Some(codegen.builtin(mut g, \"push\", [cur, x0]))\n  }\n  if g.copies {\n    codegen.note_extension(mut g, cur, \"1\")\n  }\n  // (the element held by the list either way; one already the union's,\n  // or not boxed, is `x1` itself)\n  x1 := codegen.take_value(mut g, x0)\n  x := if et is TUnion {\n    u := codegen.to_union(mut g, x1, et)\n    if u.op == x1.op {\n      u\n    } else {\n      codegen.take_value(mut g, u)\n    }\n  } else {\n    x1\n  }\n  sl := codegen.to_slot(mut g, x)\n  // a list proven owned is still checked against an open arena\n  // (`strata_list_arena_pushable`)\n  proven := codegen.proven_on(g, place)\n  owned := if proven && place is ast.Var {\n    o := codegen.held_test(mut g, \"strata_list_owned\", cur.op, true)\n    codegen.use_rt(mut g, \"strata_list_arena_pushable\")\n    a := codegen.fresh(mut g, \"arena\")\n    codegen.emit(\n      mut g,\n      f\"{a} = call i1 @strata_list_arena_pushable(ptr {cur.op})\",\n    )\n    if o == \"true\" {\n      a\n    } else {\n      both := codegen.fresh(mut g, \"owned\")\n      codegen.emit(mut g, f\"{both} = and i1 {o}, {a}\")\n      both\n    }\n  } else {\n    codegen.held_test(mut g, \"strata_list_pushable\", cur.op, false)\n  }\n  ok := match place {\n    ast.FieldOf { base, .. } => {\n      rv := codegen.expr(mut g, base)\n      u := codegen.held_test(mut g, \"strata_unique\", rv.op, proven)\n      both := codegen.fresh(mut g, \"owned\")\n      codegen.emit(mut g, f\"{both} = and i1 {owned}, {u}\")\n      both\n    },\n    _ => owned,\n  }\n  (here, copy, done) := (\n    codegen.label(mut g, \"push.here\"),\n    codegen.label(mut g, \"push.copy\"),\n    codegen.label(mut g, \"push.done\"),\n  )\n  codegen.emit(mut g, f\"br i1 {ok}, label %{here}, label %{copy}\")\n  codegen.block(mut g, here)\n  codegen.push_transparent(mut g)\n  codegen.use_rt(mut g, \"strata_list_push_owned\")\n  codegen.emit(\n    mut g,\n    f\"call void @strata_list_push_owned(ptr {cur.op}, i64 {sl})\",\n  )\n  codegen.dup_value(mut g, cur)\n  codegen.pop_scope(mut g)\n  from_here := codegen.current(g)\n  codegen.br(mut g, done)\n  // else a new header, as the built-in makes it\n  codegen.block(mut g, copy)\n  codegen.push_transparent(mut g)\n  made := codegen.call(\n    mut g,\n    cur.ty,\n    \"strata_list_push\",\n    [cur, codegen.V { ty: TInt, op: sl }, codegen.elements_kind(et)],\n  )\n  r := codegen.leave_branch(mut g, made)\n  from_copy := codegen.current(g)\n  codegen.br(mut g, done)\n  codegen.block(mut g, done)\n  p := codegen.fresh(mut g, \"updated\")\n  codegen.emit(\n    mut g,\n    f\"{p} = phi ptr [ {cur.op}, %{from_here} ], [ {r.op}, %{from_copy} ]\",\n  )\n  Some(codegen.temp(mut g, codegen.V { ty: cur.ty, op: p }))\n}"},{"name":"codegen.crosses","kind":"fn","old":"23812ff6872da359","new":"91030beddb1d971d","interface_changed":true,"affected":["codegen.closure","codegen.await_one","codegen.share_value","codegen.share_fn","codegen.share_held","codegen.share_fields","codegen.order_closure","codegen.lambda_shown","codegen.await_expr","codegen.await_list","codegen.select_expr","codegen.race_expr","codegen.dyn_wrapper","codegen.spawn_expr","codegen.channel_op","codegen.tail_share","codegen.builtin_call","codegen.function_value","codegen.lambda","codegen.expr_node","codegen.vtable","codeg