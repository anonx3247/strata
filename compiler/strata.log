e":"codegen","text":"fn field(mut g: codegen.Gen, v: codegen.V, k: Int, t: check.Ty) -> codegen.V {\n  // a field of an unknown type (a variant never made, `Err` in\n  // `match Ok(()) { … }`): nothing to read\n  if t is check.TAny {\n    return codegen.unit()\n  }\n  at := codegen.fresh(mut g, \"at\")\n  codegen.emit(\n    mut g,\n    f\"{at} = getelementptr i64, ptr {v.op}, i64 {k + 1}\",\n  )\n  codegen.load_slot(mut g, at, t)\n}","old_text":"fn field(mut g: codegen.Gen, v: codegen.V, k: Int, t: Ty) -> codegen.V {\n  // a field of an unknown type (a variant never made, `Err` in\n  // `match Ok(()) { … }`): nothing to read\n  if t is TAny {\n    return codegen.unit()\n  }\n  at := codegen.fresh(mut g, \"at\")\n  codegen.emit(\n    mut g,\n    f\"{at} = getelementptr i64, ptr {v.op}, i64 {k + 1}\",\n  )\n  codegen.load_slot(mut g, at, t)\n}"},{"name":"codegen.tag_is","kind":"fn","old":"2b8276a3a73caf6d","new":"6ed306a6452c2a1a","interface_changed":false,"affected":[],"module":"codegen","text":"/// Whether `v` was made by constructor `c` (`true` when nothing else makes\n/// its type's values), or satisfies refined type `c` (`5 is Positive`).\nfn tag_is(mut g: codegen.Gen, v: codegen.V, c: String) -> codegen.V {\n  match v.ty {\n    check.TTrait(tr) => return codegen.dyn_ctor_is(mut g, v, tr, c),\n    _ => (),\n  }\n  cs := codegen.ctors_of(g, v.ty)\n  if cs == [c] {\n    return codegen.V { ty: check.TBool, op: \"true\" }\n  }\n  match get(g.tags, c) {\n    Some(n) => {\n      t := codegen.tag_of(mut g, v)\n      r := codegen.fresh(mut g, \"is\")\n      codegen.emit(mut g, f\"{r} = icmp eq i64 {t}, {n}\")\n      codegen.V { ty: check.TBool, op: r }\n    },\n    None => match get(g.refines, c) {\n      Some((_, pred)) => {\n        codegen.push_transparent(mut g)\n        ok := codegen.with_it(mut g, v, pred)\n        codegen.pop_scope(mut g)\n        ok\n      },\n      None => {\n        codegen.not_yet(mut g, \"`is \" + c + \"`\")\n        codegen.V { ty: check.TBool, op: \"false\" }\n      },\n    },\n  }\n}","old_text":"/// Whether `v` was made by constructor `c` (`true` when nothing else makes\n/// its type's values), or satisfies refined type `c` (`5 is Positive`).\nfn tag_is(mut g: codegen.Gen, v: codegen.V, c: String) -> codegen.V {\n  match v.ty {\n    TTrait(tr) => return codegen.dyn_ctor_is(mut g, v, tr, c),\n    _ => (),\n  }\n  cs := codegen.ctors_of(g, v.ty)\n  if cs == [c] {\n    return codegen.V { ty: TBool, op: \"true\" }\n  }\n  match get(g.tags, c) {\n    Some(n) => {\n      t := codegen.tag_of(mut g, v)\n      r := codegen.fresh(mut g, \"is\")\n      codegen.emit(mut g, f\"{r} = icmp eq i64 {t}, {n}\")\n      codegen.V { ty: TBool, op: r }\n    },\n    None => match get(g.refines, c) {\n      Some((_, pred)) => {\n        codegen.push_transparent(mut g)\n        ok := codegen.with_it(mut g, v, pred)\n        codegen.pop_scope(mut g)\n        ok\n      },\n      None => {\n        codegen.not_yet(mut g, \"`is \" + c + \"`\")\n        codegen.V { ty: TBool, op: \"false\" }\n      },\n    },\n  }\n}"},{"name":"codegen.construct","kind":"fn","old":"bd9c72224c39bf46","new":"1377153c41f001a2","interface_changed":false,"affected":[],"module":"codegen","text":"/// `C`, `C(a, b)`, `C { f: a }`, `C { ..base, f: a }`.\nfn construct(mut g: codegen.Gen, c: String, args: ast.CtorArgs) -> codegen.V {\n  codegen.construct_want(mut g, c, args, check.TAny)\n}","old_text":"/// `C`, `C(a, b)`, `C { f: a }`, `C { ..base, f: a }`.\nfn construct(mut g: codegen.Gen, c: String, args: ast.CtorArgs) -> codegen.V {\n  codegen.construct_want(mut g, c, args, TAny)\n}"},{"name":"codegen.get_field","kind":"fn","old":"154acd2901befea9","new":"b2a8ea969127e336","interface_changed":false,"affected":[],"module":"codegen","text":"/// `r.f`: a record's field or a tuple's element (`t.0`). Also a sum's\n/// field where the checker narrowed the value to variants that all have\n/// it (`Square => s.side`), read from wherever each has it.\nfn get_field(mut g: codegen.Gen, base: ast.Expr, f: String) -> codegen.V {\n  // (a call's result only read here: on the stack)\n  v := codegen.expr_on_stack(mut g, base, true)\n  if v.ty is check.TAny {\n    return v\n  }\n  match v.ty {\n    check.TNamed { name: \"Tuple\", args } => match parse_int(f) {\n      Some(k) => match get(args, k) {\n        Some(t) => return codegen.field(mut g, v, k, t),\n        None => (),\n      },\n      None => (),\n    },\n    check.TNamed { name, .. } => if !contains(g.types.sums, name) {\n      for (k, x) in enumerate(codegen.fields_of(g, name, v.ty)) {\n        if x.0 == f {\n          return codegen.field(mut g, v, k, x.1)\n        }\n      }\n    } else {\n      // a call's result whose function says which variant it gives: checked\n      // to be one with the field, unless `verify` proved it\n      if base is ast.Call || base is ast.MethodCall {\n        codegen.has_field_check(mut g, v, f)\n      }\n      return codegen.variant_field(mut g, v, f)\n    },\n    // a union of records or variants that all have the field\n    check.TUnion(ms) => if ms.all(\n      m ->\n        !codegen.boxed(g, m) && codegen.field_index(g, m, f).0 >= 0,\n    ) {\n      return codegen.union_field(mut g, v, ms, f)\n    },\n    _ => (),\n  }\n  codegen.not_yet(\n    mut g,\n    \"the field `\" + f + \"` of a `\" + codegen.key(v.ty) + \"`\",\n  )\n  codegen.never()\n}","old_text":"/// `r.f`: a record's field or a tuple's element (`t.0`). Also a sum's\n/// field where the checker narrowed the value to variants that all have\n/// it (`Square => s.side`), read from wherever each has it.\nfn get_field(mut g: codegen.Gen, base: ast.Expr, f: String) -> codegen.V {\n  // (a call's result only read here: on the stack)\n  v := codegen.expr_on_stack(mut g, base, true)\n  if v.ty is TAny {\n    return v\n  }\n  match v.ty {\n    TNamed { name: \"Tuple\", args } => match parse_int(f) {\n      Some(k) => match get(args, k) {\n        Some(t) => return codegen.field(mut g, v, k, t),\n        None => (),\n      },\n      None => (),\n    },\n    TNamed { name, .. } => if !contains(g.types.sums, name) {\n      for (k, x) in enumerate(codegen.fields_of(g, name, v.ty)) {\n        if x.0 == f {\n          return codegen.field(mut g, v, k, x.1)\n        }\n      }\n    } else {\n      // a call's result whose function says which variant it gives: checked\n      // to be one with the field, unless `verify` proved it\n      if base is ast.Call || base is ast.MethodCall {\n        codegen.has_field_check(mut g, v, f)\n      }\n      return codegen.variant_field(mut g, v, f)\n    },\n    // a union of records or variants that all have the field\n    TUnion(ms) => if ms.all(\n      m ->\n        !codegen.boxed(g, m) && codegen.field_index(g, m, f).0 >= 0,\n    ) {\n      return codegen.union_field(mut g, v, ms, f)\n    },\n    _ => (),\n  }\n  codegen.not_yet(\n    mut g,\n    \"the field `\" + f + \"` of a `\" + codegen.key(v.ty) + \"`\",\n  )\n  codegen.never()\n}"},{"name":"codegen.matching","kind":"fn","old":"f7ca8c5265268272","new":"b8a627b37ad9cd28","interface_changed":false,"affected":[],"module":"codegen","text":"/// `match`: tries each arm's pattern in order and runs the first that\n/// matches, with the names it binds. No match is a fault.\nfn matching(\n  mut g: codegen.Gen,\n  scrutinee: ast.Expr,\n  binding: Option[String],\n  arms: List[ast.Arm],\n) -> codegen.V {\n  codegen.matching_want(mut g, scrutinee, binding, arms, check.TAny)\n}","old_text":"/// `match`: tries each arm's pattern in order and runs the first that\n/// matches, with the names it binds. No match is a fault.\nfn matching(\n  mut g: codegen.Gen,\n  scrutinee: ast.Expr,\n  binding: Option[String],\n  arms: List[ast.Arm],\n) -> codegen.V {\n  codegen.matching_want(mut g, scrutinee, binding, arms, TAny)\n}"},{"name":"codegen.destructure","kind":"fn","old":"82434bc29884cbd0","new":"5bf10088c71676d3","interface_changed":false,"affected":[],"module":"codegen","text":"/// `pat := e` for a pattern that isn't a name.\nfn destructure(\n  mut g: codegen.Gen,\n  p: ast.Pattern,\n  ty: Option[ast.TypeExpr],\n  value: ast.Expr,\n) {\n  // `(a, b) := (x, y)` binds each name to its element without a tuple. All\n  // elements are made first (for `(a, b) := (b, a)`), and a borrowing one\n  // is held when a later one may assign.\n  match (p, value, ty) {\n    (ast.TuplePat(ps), ast.TupleExpr(es), None) => if len(ps) == len(es)\n      && ps.all(q -> q is ast.Wild || q is ast.Bind) {\n      mut vs := []\n      for (k, e) in enumerate(es) {\n        x := codegen.expr(mut g, e)\n        if x.ty is check.TAny {\n          return\n        }\n        mut vs.push(\n          if drop(es, k + 1).any(a -> codegen.assigns(a)) {\n            codegen.hold(mut g, x)\n          } else {\n            x\n          },\n        )\n      }\n      for (k, q) in enumerate(ps) {\n        match q {\n          ast.Bind(n) => codegen.let_owned(mut g, n, get(vs, k) ?? codegen.unit()),\n          _ => (),\n        }\n      }\n      return\n    },\n    _ => (),\n  }\n  // the value's type as the checker found it (`channel()`'s)\n  want := match ty {\n    Some(t) => codegen.lower(mut g, t),\n    None => check.TAny,\n  }\n  // (a call's result only taken apart: on the stack)\n  g.stack_call = !(want is check.TTrait)\n    && !(want is check.TUnion)\n    && !codegen.binds_whole(p)\n    && codegen.call_like(g, value)\n  v := codegen.expr_want(mut g, value, want)\n  g.stack_call = false\n  if v.ty is check.TAny {\n    return\n  }\n  fail := codegen.label(mut g, \"let.fail\")\n  from := len(g.lines)\n  codegen.matches(mut g, p, v, fail)\n  // an irrefutable pattern (`(a, b)`) has no fault branch\n  if codegen.jumps_to(g, from, fail) {\n    ok := codegen.label(mut g, \"let.ok\")\n    codegen.br(mut g, ok)\n    codegen.block(mut g, fail)\n    codegen.push_scope(mut g)\n    s := codegen.shown(mut g, v)\n    m := codegen.lit(mut g, \"let pattern did not match \")\n    codegen.fault(mut g, 4, [m, s])\n    codegen.discard_scope(mut g)\n    codegen.br(mut g, ok)\n    codegen.block(mut g, ok)\n  }\n  codegen.binds(mut g, p, v)\n}","old_text":"/// `pat := e` for a pattern that isn't a name.\nfn destructure(\n  mut g: codegen.Gen,\n  p: ast.Pattern,\n  ty: Option[ast.TypeExpr],\n  value: ast.Expr,\n) {\n  // `(a, b) := (x, y)` binds each name to its element without a tuple. All\n  // elements are made first (for `(a, b) := (b, a)`), and a borrowing one\n  // is held when a later one may assign.\n  match (p, value, ty) {\n    (ast.TuplePat(ps), ast.TupleExpr(es), None) => if len(ps) == len(es)\n      && ps.all(q -> q is ast.Wild || q is ast.Bind) {\n      mut vs := []\n      for (k, e) in enumerate(es) {\n        x := codegen.expr(mut g, e)\n        if x.ty is TAny {\n          return\n        }\n        mut vs.push(\n          if drop(es, k + 1).any(a -> codegen.assigns(a)) {\n            codegen.hold(mut g, x)\n          } else {\n            x\n          },\n        )\n      }\n      for (k, q) in enumerate(ps) {\n        match q {\n          ast.Bind(n) => codegen.let_owned(mut g, n, get(vs, k) ?? codegen.unit()),\n          _ => (),\n        }\n      }\n      return\n    },\n    _ => (),\n  }\n  // the value's type as the checker found it (`channel()`'s)\n  want := match ty {\n    Some(t) => codegen.lower(mut g, t),\n    None => TAny,\n  }\n  // (a call's result only taken apart: on the stack)\n  g.stack_call = !(want is TTrait)\n    && !(want is TUnion)\n    && !codegen.binds_whole(p)\n    && codegen.call_like(g, value)\n  v := codegen.expr_want(mut g, value, want)\n  g.stack_call = false\n  if v.ty is TAny {\n    return\n  }\n  fail := codegen.label(mut g, \"let.fail\")\n  from := len(g.lines)\n  codegen.matches(mut g, p, v, fail)\n  // an irrefutable pattern (`(a, b)`) has no fault branch\n  if codegen.jumps_to(g, from, fail) {\n    ok := codegen.label(mut g, \"let.ok\")\n    codegen.br(mut g, ok)\n    codegen.block(mut g, fail)\n    codegen.push_scope(mut g)\n    s := codegen.shown(mut g, v)\n    m := codegen.lit(mut g, \"let pattern did not match \")\n    codegen.fault(mut g, 4, [m, s])\n    codegen.discard_scope(mut g)\n    codegen.br(mut g, ok)\n    codegen.block(mut g, ok)\n  }\n  codegen.binds(mut g, p, v)\n}"},{"name":"codegen.helper","kind":"fn","old":"57ec0b5c03808293","new":"5f217fcf7d272a53","interface_changed":true,"affected":["codegen.show","codegen.shown","codegen.equal","codegen.entry","codegen.interp","codegen.builtin","codegen.string_builtin","codegen.format_spec","codegen.dyn_wrapper","codegen.union_text","codegen.destructure","codegen.debug_fields","codegen.for_loop","codegen.debug_list","codegen.checked","codegen.fail_unless","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.fuzz_driver","codegen.trace_enter","codegen.trace_leave","codegen.type_check","codegen.matching_v","codegen.index_check","codegen.checked_update","codegen.decreases_fault","codegen.apply","codegen.eq_fields","codegen.matches","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.generate","codegen.expr_node","codegen.call_named","codegen.builtin_call","codegen.push_in_place","codegen.vtable","codegen.stmt_node","codegen.debug_body","codegen.assertion","codegen.invariants","codegen.check_union","codegen.check_member","codegen.construct_want","codegen.has_field_check","codegen.function","codegen.declare","codegen.call_fn_want","codegen.check_payload","codegen.check_field","codegen.assign_at","codegen.lambda_shown","codegen.set_in_place","codegen.method_call","codegen.matching_want","codegen.list_builtin","codegen.decreases_pass","codegen.decreases_call","codegen.binary","codegen.number_builtin","codegen.eq_body","codegen.binds","codegen.match_got","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen_with","core_rt_text","computed_value","repl_eval","codegen.expr","codegen.expr_want_node","codegen.except_expr","codegen.update_in_place","codegen.to_dyn","code