contains\" => match (a, b) {\n      (ast.StrLit(s), ast.StrLit(p)) => Ok(ast.BoolLit(contains(s, p))),\n      (ast.DictExpr { entries, .. }, _) => Ok(ast.BoolLit(eval.dict_get(entries, b) is Some)),\n      _ => Ok(ast.BoolLit(contains(eval.collection_of(a)!, b))),\n    },\n    \"get\" => match a {\n      ast.DictExpr { entries, .. } => Ok(eval.option(eval.dict_get(entries, b))),\n      _ => Ok(eval.option(get(eval.list_of(a)!, eval.int_of(b)!))),\n    },\n    \"at\" => eval.at(eval.list_of(a)!, eval.int_of(b)!),\n    \"set_at\" => {\n      xs := eval.list_of(a)!\n      i := eval.int_of(b)!\n      _ := eval.at(xs, i)!\n      Ok(ast.ListExpr(take(xs, i) + [c] + drop(xs, i + 1)))\n    },\n    \"dict\" => Ok(eval.make_dict(w, eval.list_of(a)!.map(\n      x -> match x {\n        ast.TupleExpr([k, v]) => (k, v),\n        _ => (x, ast.UnitExpr),\n      },\n    ))),\n    \"insert\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.DictExpr {\n        types: [],\n        entries: eval.dict_put(w, entries, b, c),\n      }),\n      ast.SetExpr { elems, .. } => Ok(\n        ast.SetExpr { types: [], elems: eval.set_put(w, elems, b) },\n      ),\n      _ => Err(eval.runtime(\"insert into \" + eval.code(a))),\n    },\n    \"remove\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.DictExpr { types: [], entries: eval.swap_removed(\n        entries,\n        eval.index_where(entries.map(kv -> kv.0), b),\n      ) }),\n      ast.SetExpr { elems, .. } => Ok(ast.SetExpr {\n        types: [],\n        elems: eval.swap_removed(elems, eval.index_where(elems, b)),\n      }),\n      _ => Err(eval.runtime(\"remove from \" + eval.code(a))),\n    },\n    \"keys\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.ListExpr(entries.map(kv -> kv.0))),\n      _ => Err(eval.runtime(\"keys of \" + eval.code(a))),\n    },\n    \"values\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.ListExpr(entries.map(kv -> kv.1))),\n      _ => Err(eval.runtime(\"values of \" + eval.code(a))),\n    },\n    \"items\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.ListExpr(entries.map(kv -> eval.pair(kv.0, kv.1)))),\n      _ => Err(eval.runtime(\"items of \" + eval.code(a))),\n    },\n    \"map_values\" => match a {\n      ast.DictExpr { entries, .. } => {\n        mut out: List[(ast.Expr, ast.Expr)] = []\n        for kv in entries {\n          mut out.push((kv.0, eval.apply(mut st, w, b, [kv.1])!))\n        }\n        Ok(ast.DictExpr { types: [], entries: out })\n      },\n      _ => Err(eval.runtime(\"map_values of \" + eval.code(a))),\n    },\n    \"set\" => Ok(eval.make_set(w, eval.collection_of(a)!)),\n    \"to_list\" => Ok(ast.ListExpr(eval.collection_of(a)!)),\n    \"union\" => Ok(eval.make_set(\n      w,\n      eval.collection_of(a)! + eval.collection_of(b)!,\n    )),\n    \"intersection\" => {\n      ys := eval.collection_of(b)!\n      Ok(eval.make_set(\n        w,\n        eval.collection_of(a)!.filter(x -> contains(ys, x)),\n      ))\n    },\n    \"difference\" => {\n      ys := eval.collection_of(b)!\n      Ok(eval.make_set(\n        w,\n        eval.collection_of(a)!.filter(x -> !contains(ys, x)),\n      ))\n    },\n    \"zip\" => Ok(ast.ListExpr(zip(eval.list_of(a)!, eval.list_of(b)!).map(\n      p -> eval.pair(p.0, p.1),\n    ))),\n    \"enumerate\" => Ok(ast.ListExpr(\n      [eval.pair(ast.IntLit(i), x) for (i, x) in enumerate(eval.list_of(a)!)],\n    )),\n    \"sort\" => Ok(ast.ListExpr(\n      eval.merge_sort(mut st, w, eval.list_of(a)!.map(x -> (x, x))).map(\n        p -> p.1,\n      ),\n    )),\n    \"sort_by\" => {\n      mut keyed := []\n      for x in eval.list_of(a)! {\n        mut keyed.push((eval.apply(mut st, w, b, [x])!, x))\n      }\n      Ok(\n        ast.ListExpr(\n          eval.merge_sort(mut st, w, keyed).map(p -> p.1),\n        ),\n      )\n    },\n    \"reverse\" => match a {\n      ast.StrLit(s) => Ok(ast.StrLit(s.reversed())),\n      _ => Ok(ast.ListExpr(eval.list_of(a)!.reversed())),\n    },\n    \"join\" => Ok(\n      ast.StrLit(join(eval.strs(eval.list_of(a)!), eval.str_of(b)!)),\n    ),\n    \"split\" => Ok(eval.str_list(split(eval.str_of(a)!, eval.str_of(b)!))),\n    \"trim\" => Ok(ast.StrLit(trim(eval.str_of(a)!))),\n    \"lines\" => Ok(eval.str_list(lines(eval.str_of(a)!))),\n    \"parse_int\" => Ok(eval.option(match parse_int(eval.str_of(a)!) {\n      Some(n) => Some(ast.IntLit(n)),\n      None => None,\n    })),\n    \"parse_float\" => Ok(eval.option(match parse_float(eval.str_of(a)!) {\n      Some(f) => Some(ast.FloatLit(f)),\n      None => None,\n    })),\n    \"float\" => {\n      n := eval.int_of(a)!\n      // the Ints that round to a finite Float\n      big := (1 << 1024) - (1 << 970)\n      if n >= big || n <= -big {\n        return Err(\n          eval.runtime(to_string(n) + \" is too large for a Float\"),\n        )\n      }\n      Ok(ast.FloatLit(float(n)))\n    },\n    \"floor\" | \"ceil\" | \"round\" => {\n      f := eval.float_of(a)!\n      r := match name {\n        \"floor\" => checked_floor(f),\n        \"ceil\" => checked_ceil(f),\n        _ => checked_round(f),\n      }\n      match r {\n        Some(n) => Ok(ast.IntLit(n)),\n        None => Err(\n          eval.runtime(\n            text.plain_float(f) + \" is not a whole number\",\n          ),\n        ),\n      }\n    },\n    \"checked_add\" | \"checked_sub\" | \"checked_mul\" | \"checked_div\" | \"checked_rem\" => {\n      (x, y) := (eval.float_of(a)!, eval.float_of(b)!)\n      r := match name {\n        \"checked_add\" => checked_add(x, y),\n        \"checked_sub\" => checked_sub(x, y),\n        \"checked_mul\" => checked_mul(x, y),\n        \"checked_div\" => checked_div(x, y),\n        _ => checked_rem(x, y),\n      }\n      Ok(eval.option(match r {\n        Some(f) => Some(ast.FloatLit(f)),\n        None => None,\n      }))\n    },\n    \"checked_sqrt\" => Ok(eval.option(match checked_sqrt(eval.float_of(a)!) {\n      Some(f) => Some(ast.FloatLit(f)),\n      None => None,\n    })),\n    \"checked_floor\" | \"checked_ceil\" | \"checked_round\" => {\n      x := eval.float_of(a)!\n      r := match name {\n        \"checked_floor\" => checked_floor(x),\n        \"checked_ceil\" => checked_ceil(x),\n        _ => checked_round(x),\n      }\n      Ok(eval.option(match r {\n        Some(n) => Some(ast.IntLit(n)),\n        None => None,\n      }))\n    },\n    \"sqrt\" => {\n      f := eval.float_of(a)!\n      match checked_sqrt(f) {\n        Some(r) => Ok(ast.FloatLit(r)),\n        None => Err(eval.runtime(\n          \"sqrt of negative number \" + text.plain_float(f),\n        )),\n      }\n    },\n    \"map\" => {\n      mut out := []\n      for x in eval.list_of(a)! {\n        mut out.push(eval.apply(mut st, w, b, [x])!)\n      }\n      Ok(ast.ListExpr(out))\n    },\n    \"filter\" => {\n      mut out := []\n      for x in eval.list_of(a)! {\n        if eval.truth(eval.apply(mut st, w, b, [x])!)! {\n          mut out.push(x)\n        }\n      }\n      Ok(ast.ListExpr(out))\n    },\n    \"fold\" => {\n      mut acc := b\n      for x in eval.list_of(a)! {\n        acc = eval.apply(mut st, w, c, [acc, x])!\n      }\n      Ok(acc)\n    },\n    \"all\" => {\n      for x in eval.list_of(a)! {\n        if !eval.truth(eval.apply(mut st, w, b, [x])!)! {\n          return Ok(ast.BoolLit(false))\n        }\n      }\n      Ok(ast.BoolLit(true))\n    },\n    \"any\" => {\n      for x in eval.list_of(a)! {\n        if eval.truth(eval.apply(mut st, w, b, [x])!)! {\n          return Ok(ast.BoolLit(true))\n        }\n      }\n      Ok(ast.BoolLit(false))\n    },\n    \"find\" => {\n      for x in eval.list_of(a)! {\n        if eval.truth(eval.apply(mut st, w, b, [x])!)! {\n          return Ok(eval.some(x))\n        }\n      }\n      Ok(eval.none())\n    },\n    \"count\" => {\n      mut n := 0\n      for x in eval.list_of(a)! {\n        if eval.truth(eval.apply(mut st, w, b, [x])!)! {\n          n += 1\n        }\n      }\n      Ok(ast.IntLit(n))\n    },\n    \"push\" => Ok(ast.ListExpr(eval.list_of(a)! + [b])),\n    \"take\" => Ok(ast.ListExpr(take(eval.list_of(a)!, eval.int_of(b)!))),\n    \"drop\" => Ok(ast.ListExpr(drop(eval.list_of(a)!, eval.int_of(b)!))),\n    \"slice\" => Ok(ast.ListExpr(\n      eval.sliced(\n        eval.list_of(a)!,\n        eval.int_of(b)!,\n        eval.int_of(c)!,\n      ),\n    )),\n    \"sum\" => {\n      xs := eval.list_of(a)!\n      match get(xs, 0) {\n        Some(ast.FloatLit(_)) => {\n          mut t := 0.0\n          for x in xs {\n            f := eval.float_of(x)!\n            t = checked_add(t, f) or {\n              return Err(eval.not_finite(t, \"+\", f))\n            }\n          }\n          Ok(ast.FloatLit(t))\n        },\n        _ => {\n          mut t := 0\n          for x in xs {\n            t += eval.int_of(x)!\n          }\n          Ok(ast.IntLit(t))\n        },\n      }\n    },\n    \"range\" => Ok(ast.ListExpr(eval.ints(eval.int_of(a)!, eval.int_of(b)!))),\n    \"compare\" => Ok(ast.IntLit(eval.compare(w, a, b))),\n    \"abs\" => match a {\n      ast.FloatLit(f) => Ok(ast.FloatLit(abs(f))),\n      _ => Ok(ast.IntLit(abs(eval.int_of(a)!))),\n    },\n    \"min\" => Ok(if eval.compare(w, b, a) < 0 {\n      b\n    } else {\n      a\n    }),\n    \"max\" => Ok(if eval.compare(w, b, a) > 0 {\n      b\n    } else {\n      a\n    }),\n    // with std.regex's engine, as compiled code\n    \"matches\" => match std.regex.full_match(eval.str_of(a)!, eval.str_of(b)!) {\n      Ok(m) => Ok(ast.BoolLit(m)),\n      Err(e) => Err(eval.runtime(\"bad regex: \" + e)),\n    },\n    \"starts_with\" => Ok(ast.BoolLit(starts_with(eval.str_of(a)!, eval.str_of(b)!))),\n    \"ends_with\" => Ok(ast.BoolLit(ends_with(eval.str_of(a)!, eval.str_of(b)!))),\n    \"chars\" => Ok(eval.str_list(eval.str_of(a)!.chars())),\n    \"index_of\" => Ok(\n      eval.option(match index_of(eval.str_of(a)!, eval.str_of(b)!) {\n        Some(n) => Some(ast.IntLit(n)),\n        None => None,\n      }),\n    ),\n    \"byte_slice\" => Ok(ast.StrLit(\n      byte_slice(eval.str_of(a)!, eval.int_of(b)!, eval.int_of(c)!),\n    )),\n    \"replace\" => Ok(ast.StrLit(\n      replace(eval.str_of(a)!, eval.str_of(b)!, eval.str_of(c)!),\n    )),\n    \"repeat\" => Ok(ast.StrLit(repeat(eval.str_of(a)!, eval.int_of(b)!))),\n    \"to_upper\" => Ok(ast.StrLit(to_upper(eval.str_of(a)!))),\n    \"to_lower\" => Ok(ast.StrLit(to_lower(eval.str_of(a)!))),\n    \"is_digit\" => Ok(ast.BoolLit(is_digit(eval.str_of(a)!))),\n    \"is_alpha\" => Ok(ast.BoolLit(is_alpha(eval.str_of(a)!))),\n    \"is_space\" => Ok(ast.BoolLit(is_space(eval.str_of(a)!))),\n    \"byte_len\" => Ok(ast.IntLit(byte_len(eval.str_of(a)!))),\n    \"byte_at\" => {\n      s := eval.str_of(a)!\n      i := eval.int_of(b)!\n      if i < 0 || i >= byte_len(s) {\n        return Err(eval.runtime(\"byte \"\n          + to_string(i)\n          + \" out of range (length \"\n          + to_string(byte_len(s))\n          + \")\"))\n      }\n      Ok(ast.IntLit(byte_at(s, i)))\n    },\n    \"ord\" => {\n      s := eval.str_of(a)!\n      cps := s.code_points().to_list()\n      match cps {\n        [x] => Ok(ast.IntLit(x)),\n        _ => Err(eval.runtime(\n          \"ord needs a single character, got \" + eval.quoted(s),\n        )),\n      }\n    },\n    \"chr\" => {\n      n := eval.int_of(a)!\n      if n < 0 || n > 1114111 || n >= 55296 && n <= 57343 {\n        return Err(\n          eval.runtime(\n            \"chr: \" + to_string(n) + \" is not a character\",\n          ),\n        )\n      }\n      Ok(ast.StrLit(chr(n)))\n    },\n    _ => Err(eval.runtime(\n      \"the built-in `\" + name + \"` isn't run by this evaluator yet\",\n    )),\n  }\n}"},{"name":"eval.at","kind":"fn","old":"a119d3041143ab28","new":null,"interface_changed":true,"affected":[],"module":"eval","old_text":"fn at(xs: List[ast.Expr], i: Int) -> Result[ast.Expr, eval.Escape] {\n  match get(xs, i) {\n    Some(x) => Ok(x),\n    None => Err(eval.runtime(\"index \"\n      + to_string(i)\n      + \" out of range (length \"\n      + to_string(len(xs))\n      + \")\")),\n  }\n}"}],"renames":[{"from":"eval.at","to":"eval.element_at","kind":"function"}],"references":["eval.field","eval.set_path","eval.builtin"]}
{"id":"205a910bd1f87b45","time":1795719441,"message":"rename parallel.map → parallel.map_parallel","changes":[{"name":"check.typed","kind":"fn","old":"d6ab73b7f2341320","new":"d61f4b5750b4df33","interface_changed":false,"affected":[],"module":"check","text":"/// The program with the types the checker inferred written in, for the\n/// code generator. Each variable declared without a type (`x := e`,\n/// `mut x := e`) in a function or an `impl`'s method gets the type inferred\n/// for it when that is fully known. So does each lambda parameter written\n/// without one. Other types follow from what is declared (parameters,\n/// results, fields), and the code generator works them out itself.\npub fn typed(decls: List[ast.Decl], core: builtins.Core) -> List[ast.Decl] {\n  types := check.types_of(decls)\n  fns := check.fn_types(decls, types)\n  methods := check.methods_of(decls, types)\n  builtins := check.builtins_of(types, core)\n  // each definition on its own, inferred by the workers, in order\n  parallel.map_parallel(\n    decls,\n    d -> check.typed_one(d, types, fns, methods, builtins),\n  )\n}","old_text":"/// The program with the types the checker inferred written in, for the\n/// code generator. Each variable declared without a type (`x := e`,\n/// `mut x := e`) in a function or an `impl`'s method gets the type inferred\n/// for it when that is fully known. So does each lambda parameter written\n/// without one. Other types follow from what is declared (parameters,\n/// results, fields), and the code generator works them out itself.\npub fn typed(decls: List[ast.Decl], core: builtins.Core) -> List[ast.Decl] {\n  types := check.types_of(decls)\n  fns := check.fn_types(decls, types)\n  methods := check.methods_of(decls, types)\n  builtins := check.builtins_of(types, core)\n  // each definition on its own, inferred by the workers, in order\n  parallel.map(\n    decls,\n    d -> check.typed_one(d, types, fns, methods, builtins),\n  )\n}"},{"name":"check.type_errors_with","kind":"fn","old":"4d1b6faacaf9b9ae","new":"192063b5e44ad050","interface_changed":false,"affected":[],"module":"check","text":"/// `type_errors` with `lib`, the definitions of the modules the program\n/// imports (std's): their functions and types are known, and their errors\n/// are not reported.\npub fn type_errors_with(\n  decls: List[ast.Decl],\n  lib: List[ast.Decl],\n  core: builtins.Core,\n) -> List[(String, String)] {\n  all := decls + lib\n  // core's code (iterators, text, channels, tasks), with global names as a\n  // program sees them, for the methods of its traits\n  code := core.decls\n    .filter(d -> check.code_module(d.module))\n    .map(d -> ast.Decl { ..d, module: \"\" })\n  types := check.types_of(code + all)\n  fns := check.fn_types(all, types)\n  // an imported type's methods may come from modules not read, so only the\n  // file's own types get `unknown function`\n  mut local := Set[String] {}\n  mut own_traits := Set[String] {}\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => mut local.insert(check.qualified(d.module, t.name)),\n      // a script's only. In a package, names are qualified in ways the\n      // obligations don't follow.\n      ast.TraitDef(t) => if d.module == \"\" {\n        mut own_traits.insert(t.name)\n      },\n      _ => (),\n    }\n  }\n  methods := check.with_code(\n    check.Methods { ..check.methods_of(all, types), local, own_traits, noallocs: check.noalloc_methods(code + all) },\n    check.methods_of(code, types),\n  )\n  builtins := check.builtins_of(types, core)\n  mut out := []\n  // the generic functions that call methods on a type parameter\n  // (`T.empty()`), which can't be passed as values\n  mut on_type := Set[String] {}\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if len(f.type_params) > 0\n        && check.calls_on_type(f.body, set(f.type_params)) {\n        mut on_type.insert(check.qualified(d.module, f.name))\n      },\n      _ => (),\n    }\n  }\n  for e in check.unions_adding_nothing(decls, core) {\n    mut out.push(e)\n  }\n  for e in check.union_conflicts(decls) {\n    mut out.push(e)\n  }\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => {\n        locals := set(f.params.map(p -> p.name))\n        for n in check.value_uses(f.body) {\n          if contains(on_type, n) && !contains(locals, n) {\n            sn := get(split(n, \".\"), len(split(n, \".\")) - 1) ?? n\n            mut out.push(\n              (\n                f.name,\n                \"`\"\n                  + sn\n                  + \"` needs to know its type arguments when it runs (it calls methods on the type), so it can't be passed as a value: pass a lambda (`x -> \"\n                  + sn\n                  + \"(x)`)\",\n              ),\n            )\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  // each definition's errors on its own, by the workers, in order\n  for errs in parallel.map_parallel(\n    decls,\n    d -> check.decl_type_errors(d, types, fns, methods, builtins),\n  ) {\n    out += errs\n  }\n  out\n}","old_text":"/// `type_errors` with `lib`, the definitions of the modules the program\n/// imports (std's): their functions and types are known, and their errors\n/// are not reported.\npub fn type_errors_with(\n  decls: List[ast.Decl],\n  lib: List[ast.Decl],\n  core: builtins.Core,\n) -> List[(String, String)] {\n  all := decls + lib\n  // core's code (iterators, text, channels, tasks), with global names as a\n  // program sees them, for the methods of its traits\n  code := core.decls\n    .filter(d -> check.code_module(d.module))\n    .map(d -> ast.Decl { ..d, module: \"\" })\n  types := check.types_of(code + all)\n  fns := check.fn_types(all, types)\n  // an imported type's methods may come from modules not read, so only the\n  // file's own types get `unknown function`\n  mut local := Set[String] {}\n  mut own_traits := Set[String] {}\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => mut local.insert(check.qualified(d.module, t.name)),\n      // a script's only. In a package, names are qualified in ways the\n      // obligations don't follow.\n      ast.TraitDef(t) => if d.module == \"\" {\n        mut own_traits.insert(t.name)\n      },\n      _ => (),\n    }\n  }\n  methods := check.with_code(\n    check.Methods { ..check.methods_of(all, types), local, own_traits, noallocs: check.noalloc_methods(code + all) },\n    check.methods_of(code, types),\n  )\n  builtins := check.builtins_of(types, core)\n  mut out := []\n  // the generic functions that call methods on a type parameter\n  // (`T.empty()`), which can't be passed as values\n  mut on_type := Set[String] {}\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => if len(f.type_params) > 0\n        && check.calls_on_type(f.body, set(f.type_params)) {\n        mut on_type.insert(check.qualified(d.module, f.name))\n      },\n      _ => (),\n    }\n  }\n  for e in check.unions_adding_nothing(decls, core) {\n    mut out.push(e)\n  }\n  for e in check.union_conflicts(decls) {\n    mut out.push(e)\n  }\n  for d in decls {\n    match d.kind {\n      ast.FnDef(f) => {\n        locals := set(f.params.map(p -> p.name))\n        for n in check.value_uses(f.body) {\n          if contains(on_type, n) && !contains(locals, n) {\n            sn := get(split(n, \".\"), len(split(n, \".\")) - 1) ?? n\n            mut out.push(\n              (\n                f.name,\n                \"`\"\n                  + sn\n                  + \"` needs to know its type arguments when it runs (it calls methods on the type), so it can't be passed as a value: pass a lambda (`x -> \"\n                  + sn\n                  + \"(x)`)\",\n              ),\n            )\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  // each definition's errors on its own, by the workers, in order\n  for errs in parallel.map(\n    decls,\n    d -> check.decl_type_errors(d, types, fns, methods, builtins),\n  ) {\n    out += errs\n  }\n  out\n}"},{"name":"codegen.generate","kind":"fn","old":"1461597e38254cbb","new":"7591bcef7d823d65","interface_changed":false,"affected":[],"module":"codegen","text":"/// The program's `main` and what it calls as LLVM IR, or the constructs not\n/// compiled, each with its function. `assumed_clauses` also checks the\n/// assumed contract clauses (`--check-assumed`). Verify's fuzz drivers\n/// always check them. `regions` makes the values that die in the statement\n/// that makes them in the statement's region (`--regions`).\npub fn generate(\n  given: List[ast.Decl],\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  proofs: List[String],\n  tests: Option[List[(String, String)]],\n  fuzz: List[String],\n  fuzz_text: Bool,\n  calls: List[String],\n  trace: Bool,\n  library: List[String],\n  precompiled: List[String],\n  bare: Bool,\n  copies: Option[Dict[String, String]],\n  memory_sites: Option[Dict[String, String]],\n  assumed_clauses: Bool,\n  regions: Bool,\n) -> Result[String, List[String]] {\n  // unused variables with no effect are not compiled (`unread_dropped`),\n  // and assumed contract clauses are left out (`assumed_compiled`)\n  keep := assumed_clauses || fuzz != []\n  // lemmas and proofs (`assert … by`, `calc`) are for `verify` alone: never\n  // compiled\n  (start, main) := codegen.new_gen(\n    given\n      .filter(d -> !match d.kind {\n        ast.FnDef(f) => f.lemma,\n        _ => false,\n      })\n      .map(d -> walk.rewrite_decl(\n        codegen.assumed_compiled(d, keep),\n        x -> codegen.unread_dropped(codegen.proofs_dropped(x)),\n      )),\n    core,\n    prelude,\n    proofs,\n    tests,\n    fuzz,\n    fuzz_text,\n    calls,\n    trace,\n    library,\n    precompiled,\n  )!\n  // core.rt (`bare`): no call-stack frames, no cancel points\n  mut g := if bare {\n    codegen.Gen { ..start, bare: true, tasks: false, supervises: false }\n  } else {\n    start\n  }\n  // `--copies`: report copies with their locations\n  match copies {\n    Some(sites) => {\n      g.copies = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  // (`--memory-sites`: each counting operation counted, by site)\n  match memory_sites {\n    Some(sites) => {\n      g.memory_sites = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  mut bodies := match tests {\n    // each test as `strata test` runs it (`strata.test.N`), with its name\n    Some(ts) => enumerate(ts).map(x -> codegen.test_entry(x.0, x.1.0, x.1.1)),\n    None => if fuzz != [] || library != [] || calls != [] {\n      []\n    } else if main.name == \"\" {\n      // a library starts when it is loaded\n      [codegen.library_start(mut g)]\n    } else {\n      [codegen.entry(mut g, main)]\n    },\n  }\n  // std's library runs in any program, with tasks or without. It holds its\n  // functions by key and its `impl`s' methods (`library_methods`), except\n  // those `!KEY` excludes. Generic functions, those depending on the\n  // compile, and trait values are compiled per program instead.\n  mut roots := []\n  mut held := []\n  left_out := set(library\n    .filter(k -> starts_with(k, \"!\"))\n    .map(k -> byte_slice(k, 1, byte_len(k))))\n  mut wanted := library.filter(k -> !starts_with(k, \"!\"))\n  if library != [] {\n    wanted += codegen.library_methods(mut g).filter(\n      k -> !contains(left_out, k),\n    )\n  }\n  for k in wanted {\n    match codegen.fn_of(g, k) {\n      Some(f) => if codegen.precompilable(mut g, k, f) {\n        sym := codegen.instance(mut g, k, f, Dict[String, check.Ty] {})\n        mut roots.push(sym)\n        mut held.push(k)\n      },\n      None => (),\n    }\n  }\n  // verify's fuzz drivers (`strata.fuzz.N`)\n  for (i, k) in enumerate(fuzz) {\n    mut bodies.push(codegen.fuzz_driver(mut g, i, k))\n  }\n  // `strata run f ARGS` calls (`strata.call.N`). `session:KEY` is a\n  // `strata repl` line, with the session's arguments.\n  for (i, k) in enumerate(calls) {\n    mut bodies.push(\n      if starts_with(k, \"session:\") {\n        codegen.session_entry(\n          mut g,\n          i,\n          byte_slice(k, 8, byte_len(k)),\n        )\n      } else {\n        codegen.call_entry(mut g, i, k)\n      },\n    )\n  }\n  // the exports of `derive C for f`, each under its symbol\n  if fuzz == [] && library == [] && calls == [] && tests is None {\n    for (symbol, k) in codegen.exports_of(given) {\n      mut bodies.push(codegen.export_entry(mut g, symbol, k))\n    }\n  }\n  // the files they generate: the C header\n  parts := codegen.file_parts(given) except e { return Err([e]) }\n  // Each reachable function instance, once, in rounds. The workers compile\n  // each function of a round alone from the state the round began with.\n  // Their additions are then merged in queue order, so the output does not\n  // depend on thread timing.\n  if len(g.queue) > 0 && g.keeps is None {\n    g.keeps = Some(codegen.kept_by(g.fns))\n  }\n  // the updates in place proven to find their value held once, for builds\n  // and tests (not for verify's fuzzing, `strata run f` and compile-time\n  // code, which run once). Only a program's build sees every call of its\n  // functions (`closed`).\n  if len(g.queue) > 0 && !bare && fuzz == [] && calls == [] {\n    closed := library == []\n      && tests is None\n      && main.name != \"\"\n      && codegen.exports_of(given) == []\n    g.proven = unique.proven_sites(\n      g.fns,\n      codegen.keeps_of(mut g),\n      closed,\n      g.distincts,\n      g.traits,\n    )\n  }\n  // (`--regions`: the values made in statement regions)\n  if regions && !bare && len(g.queue) > 0 {\n    g.regions = true\n    g.region_sites = roots.scoped(g.fns, codegen.keeps_of(mut g), g.traits, g.proven)\n  }\n  // (`--memory-sites`: where scoped allocation would put each value)\n  if g.memory_sites && len(g.queue) > 0 {\n    g.roots = roots.verdicts(\n      g.fns,\n      codegen.keeps_of(mut g),\n      g.traits,\n      g.proven,\n    )\n  }\n  mut global_keys := set(g.globals.map(l -> codegen.global_key(l)))\n  mut def_keys := set(g.helper_defs.map(d -> codegen.def_key(d)))\n  while len(g.queue) > 0 {\n    round := g.queue\n    g.queue = []\n    base := g\n    for (body, d) in parallel.map_parallel(\n      round,\n      item -> codegen.compiled_alone(base, item.0, item.1, main),\n    ) {\n      mut bodies.push(body)\n      codegen.merge_alone(\n        mut g,\n        base,\n        d,\n        mut global_keys,\n        mut def_keys,\n      )\n    }\n  }\n  if len(g.errs) > 0 {\n    // std's library leaves out the functions that reach something not\n    // compiled\n    if library != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      out := wanted.filter(k -> contains(left, k))\n      if out != [] {\n        return Err(out.map(k -> \"leave out: \" + k))\n      }\n    }\n    // verify's fuzz drivers: each one reaching something not compiled is\n    // reported as `can't fuzz `KEY`: WHY`, so `verify` drops them all at\n    // once\n    if fuzz != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      callees := codegen.callees_of(g.callers)\n      return Err(g.errs\n        + fuzz\n          .filter(k -> contains(left, \"fuzz:\" + k))\n          .map(k -> \"can't fuzz `\"\n            + k\n            + \"`: \"\n            + join(\n              codegen.failures_of(callees, g.why, \"fuzz:\" + k),\n              \"; \",\n            )))\n    }\n    return Err(g.errs)\n  }\n  mut out := [\n    \"; Strata, compiled by compiler/codegen\",\n    f\"; checks left out {g.left_out}, kept {g.kept}\",\n    \"\",\n  ]\n  // std's library lists the functions it holds: `; precompiled NAME`\n  out += held.map(k -> \"; precompiled \" + k)\n  out += parts.map(p -> codegen.file_line(p.0, p.1))\n  // the symbols a library exports (`; export add`); the rest are hidden\n  out += if fuzz == [] && library == [] && calls == [] && tests is None {\n    codegen.exports_of(given).map(e -> \"; export \" + e.0)\n  } else {\n    []\n  }\n  out += g.globals\n  mut out.push(\"\")\n  // std's library exposes only its functions\n  out += if library != [] {\n    codegen.internal(bodies + g.helper_defs, set(roots))\n  } else {\n    bodies + g.helper_defs\n  }\n  for d in codegen.declarations() {\n    if contains(g.used, d.0) {\n      mut out.push(d.1)\n    }\n  }\n  ir_text := join(out, \"\\n\") + \"\\n\"\n  Ok(if g.memory_sites {\n    codegen.counted_sites(ir_text)\n  } else {\n    ir_text\n  })\n}","old_text":"/// The program's `main` and what it calls as LLVM IR, or the constructs not\n/// compiled, each with its function. `assumed_clauses` also checks the\n/// assumed contract clauses (`--check-assumed`). Verify's fuzz drivers\n/// always check them. `regions` makes the values that die in the statement\n/// that makes them in the statement's region (`--regions`).\npub fn generate(\n  given: List[ast.Decl],\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  proofs: List[String],\n  tests: Option[List[(String, String)]],\n  fuzz: List[String],\n  fuzz_text: Bool,\n  calls: List[String],\n  trace: Bool,\n  library: List[String],\n  precompiled: List[String],\n  bare: Bool,\n  copies: Option[Dict[String, String]],\n  memory_sites: Option[Dict[String, String]],\n  assumed_clauses: Bool,\n  regions: Bool,\n) -> Result[String, List[String]] {\n  // unused variables with no effect are not compiled (`unread_dropped`),\n  // and assumed contract clauses are left out (`assumed_compiled`)\n  keep := assumed_clauses || fuzz != []\n  // lemmas and proofs (`assert … by`, `calc`) are for `verify` alone: never\n  // compiled\n  (start, main) := codegen.new_gen(\n    given\n      .filter(d -> !match d.kind {\n        ast.FnDef(f) => f.lemma,\n        _ => false,\n      })\n      .map(d -> walk.rewrite_decl(\n        codegen.assumed_compiled(d, keep),\n        x -> codegen.unread_dropped(codegen.proofs_dropped(x)),\n      )),\n    core,\n    prelude,\n    proofs,\n    tests,\n    fuzz,\n    fuzz_text,\n    calls,\n    trace,\n    library,\n    precompiled,\n  )!\n  // core.rt (`bare`): no call-stack frames, no cancel points\n  mut g := if bare {\n    codegen.Gen { ..start, bare: true, tasks: false, supervises: false }\n  } else {\n    start\n  }\n  // `--copies`: report copies with their locations\n  match copies {\n    Some(sites) => {\n      g.copies = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  // (`--memory-sites`: each counting operation counted, by site)\n  match memory_sites {\n    Some(sites) => {\n      g.memory_sites = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  mut bodies := match tests {\n    // each test as `strata test` runs it (`strata.test.N`), with its name\n    Some(ts) => enumerate(ts).map(x -> codegen.test_entry(x.0, x.1.0, x.1.1)),\n    None => if fuzz != [] || library != [] || calls != [] {\n      []\n    } else if main.name == \"\" {\n      // a library starts when it is loaded\n      [codegen.library_start(mut g)]\n    } else {\n      [codegen.entry(mut g, main)]\n    },\n  }\n  // std's library runs in any program, with tasks or without. It holds its\n  // functions by key and its `impl`s' methods (`library_methods`), except\n  // those `!KEY` excludes. Generic functions, those depending on the\n  // compile, and trait values are compiled per program instead.\n  mut roots := []\n  mut held := []\n  left_out := set(library\n    .filter(k -> starts_with(k, \"!\"))\n    .map(k -> byte_slice(k, 1, byte_len(k))))\n  mut wanted := library.filter(k -> !starts_with(k, \"!\"))\n  if library != [] {\n    wanted += codegen.library_methods(mut g).filter(\n      k -> !contains(left_out, k),\n    )\n  }\n  for k in wanted {\n    match codegen.fn_of(g, k) {\n      Some(f) => if codegen.precompilable(mut g, k, f) {\n        sym := codegen.instance(mut g, k, f, Dict[String, check.Ty] {})\n        mut roots.push(sym)\n        mut held.push(k)\n      },\n      None => (),\n    }\n  }\n  // verify's fuzz drivers (`strata.fuzz.N`)\n  for (i, k) in enumerate(fuzz) {\n    mut bodies.push(codegen.fuzz_driver(mut g, i, k))\n  }\n  // `strata run f ARGS` calls (`strata.call.N`). `session:KEY` is a\n  // `strata repl` line, with the session's arguments.\n  for (i, k) in enumerate(calls) {\n    mut bodies.push(\n      if starts_with(k, \"session:\") {\n        codegen.session_entry(\n          mut g,\n          i,\n          byte_slice(k, 8, byte_len(k)),\n        )\n      } else {\n        codegen.call_entry(mut g, i, k)\n      },\n    )\n  }\n  // the exports of `derive C for f`, each under its symbol\n  if fuzz == [] && library == [] && calls == [] && tests is None {\n    for (symbol, k) in codegen.exports_of(given) {\n      mut bodies.push(codegen.export_entry(mut g, symbol, k))\n    }\n  }\n  // the files they generate: the C header\n  parts := codegen.file_parts(given) except e { return Err([e]) }\n  // Each reachable function instance, once, in rounds. The workers compile\n  // each function of a round alone from the state the round began with.\n  // Their additions are then merged in queue order, so the output does not\n  // depend on thread timing.\n  if len(g.queue) > 0 && g.keeps is None {\n    g.keeps = Some(codegen.kept_by(g.fns))\n  }\n  // the updates in place proven to find their value held once, for builds\n  // and tests (not for verify's fuzzing, `strata run f` and compile-time\n  // code, which run once). Only a program's build sees every call of its\n  // functions (`closed`).\n  if len(g.queue) > 0 && !bare && fuzz == [] && calls == [] {\n    closed := library == []\n      && tests is None\n      && main.name != \"\"\n      && codegen.exports_of(given) == []\n    g.proven = unique.proven_sites(\n      g.fns,\n      codegen.keeps_of(mut g),\n      closed,\n      g.distincts,\n      g.traits,\n    )\n  }\n  // (`--regions`: the values made in statement regions)\n  if regions && !bare && len(g.queue) > 0 {\n    g.regions = true\n    g.region_sites = roots.scoped(g.fns, codegen.keeps_of(mut g), g.traits, g.proven)\n  }\n  // (`--memory-sites`: where scoped allocation would put each value)\n  if g.memory_sites && len(g.queue) > 0 {\n    g.roots = roots.verdicts(\n      g.fns,\n      codegen.keeps_of(mut g),\n      g.traits,\n      g.proven,\n    )\n  }\n  mut global_keys := set(g.globals.map(l -> codegen.global_key(l)))\n  mut def_keys := set(g.helper_defs.map(d -> codegen.def_key(d)))\n  while len(g.queue) > 0 {\n    round := g.queue\n    g.queue = []\n    base := g\n    for (body, d) in parallel.map(\n      round,\n      item -> codegen.compiled_alone(base, item.0, item.1, main),\n    ) {\n      mut bodies.push(body)\n      codegen.merge_alone(\n        mut g,\n        base,\n        d,\n        mut global_keys,\n        mut def_keys,\n      )\n    }\n  }\n  if len(g.errs) > 0 {\n    // std's library leaves out the functions that reach something not\n    // compiled\n    if library != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      out := wanted.filter(k -> contains(left, k))\n      if out != [] {\n        return Err(out.map(k -> \"leave out: \" + k))\n      }\n    }\n    // verify's fuzz drivers: each one reaching something not compiled is\n    // reported as `can't fuzz `KEY`: WHY`, so `verify` drops them all at\n    // once\n    if fuzz != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      callees := codegen.callees_of(g.callers)\n      return Err(g.errs\n        + fuzz\n          .filter(k -> contains(left, \"fuzz:\" + k))\n          .map(k -> \"can't fuzz `\"\n            + k\n            + \"`: \"\n            + join(\n              codegen.failures_of(callees, g.why, \"fuzz:\" + k),\n              \"; \",\n            )))\n    }\n    return Err(g.errs)\n  }\n  mut out := [\n    \"; Strata, compiled by compiler/codegen\",\n    f\"; checks left out {g.left_out}, kept {g.kept}\",\n    \"\",\n  ]\n  // std's library lists the functions it holds: `; precompiled NAME`\n  out += held.map(k -> \"; precompiled \" + k)\n  out += parts.map(p -> codegen.file_line(p.0, p.1))\n  // the symbols a library exports (`; export add`); the rest are hidden\n  out += if fuzz == [] && library == [] && calls == [] && tests is None {\n    codegen.exports_of(given).map(e -> \"; export \" + e.0)\n  } else {\n    []\n  }\n  out += g.globals\n  mut out.push(\"\")\n  // std's library exposes only its functions\n  out += if library != [] {\n    codegen.internal(bodies + g.helper_defs, set(roots))\n  } else {\n    bodies + g.helper_defs\n  }\n  for d in codegen.declarations() {\n    if contains(g.used, d.0) {\n      mut out.push(d.1)\n    }\n  }\n  ir_text := join(out, \"\\n\") + \"\\n\"\n  Ok(if g.memory_sites {\n    codegen.counted_sites(ir_text)\n  } else {\n    ir_text\n  })\n}"},{"name":"decoded_files","kind":"fn","old":"68bb7f1a67837ba7","new":"59e70b7de6fa173a","interface_changed":false,"affected":[],"module":"","text":"/// Read one by one and decoded by the workers. One that can't be read or\n/// decoded has none, and says why.\nfn decoded_files(\n  disk: std.fs.Disk,\n  files: List[String],\n) -> List[List[ast.Decl]] {\n  mut read := []\n  for f in files {\n    mut read.push(disk.read_bytes(f))\n  }\n  decoded := timings.timed(\n    \"decode\",\n    () -> parallel.map_parallel(read, r -> match r {\n      Ok(bs) => Some(binary.read(bs)),\n      Err(_) => None,\n    }),\n  )\n  mut out := []\n  for d in decoded {\n    mut out.push(\n      match d {\n        // (a module file, or a bundle: its modules' definitions)\n        Some(Ok(img)) => img.decls,\n        Some(Err(e)) => {\n          print(e)\n          []\n        },\n        None => {\n          print(\"unreadable\")\n          []\n        },\n      },\n    )\n  }\n  out\n}","old_text":"/// Read one by one and decoded by the workers. One that can't be read or\n/// decoded has none, and says why.\nfn decoded_files(\n  disk: std.fs.Disk,\n  files: List[String],\n) -> List[List[ast.Decl]] {\n  mut read := []\n  for f in files {\n    mut read.push(disk.read_bytes(f))\n  }\n  decoded := timings.timed(\"decode\", () -> parallel.map(read, r -> match r {\n    Ok(bs) => Some(binary.read(bs)),\n    Err(_) => None,\n  }))\n  mut out := []\n  for d in decoded {\n    mut out.push(\n      match d {\n        // (a module file, or a bundle: its modules' definitions)\n        Some(Ok(img)) => img.decls,\n        Some(Err(e)) => {\n          print(e)\n          []\n        },\n        None => {\n          print(\"unreadable\")\n          []\n        },\n      },\n    )\n  }\n  out\n}"},{"name":"graph_answers_all","kind":"fn","old":"7be76501dc269897","new":"06ad199e337f31b7","interface_changed":false,"affected":[],"module":"","text":"/// The solver's answer to each obligation of each of `vcs`, as `solve`\n/// gives them (`proven …`, `refuted …`, `unknown …`), except that a model is\n/// enough for `refuted`: a move is possible when some values make it,\n/// whether or not they can be shown (a type parameter's can't).\n/// \n/// Each question is a script of its own, written on worker threads and run\n/// together (`run_scripts`), so no question waits for another. A batch\n/// would answer few of them: in one, the solver's state from earlier\n/// questions can make one cost several times what it costs alone\n/// (`cancel`'s `Pending -> Cancelled` in examples/orders.strata). A\n/// question whose script mixes sorts (`sorts.sort_error`) is unknown: the\n/// solver would reject it.\nfn graph_answers_all(\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  scratch: String,\n  solver: String,\n  vcs: List[smt.Vc],\n) -> List[List[String]] {\n  mut asked := []\n  for (k, vc) in enumerate(vcs) {\n    for i in 0..len(vc.obligations) {\n      mut asked.push((k, i, vc))\n    }\n  }\n  written := parallel.map_parallel(asked, x -> {\n    text := smt.single(x.2, x.1)\n    (text, sorts.sort_error(text) is Some)\n  })\n  outs := smt.run_scripts(\n    mut launcher,\n    mut disk,\n    scratch,\n    solver,\n    written.map(w -> (w.0, [\"-T:20\", \"rlimit=2000000\"])),\n  )\n  mut firsts := Dict[String, String] {}\n  for (j, x) in enumerate(asked) {\n    mixed := match get(written, j) {\n      Some(w) => w.1,\n      None => true,\n    }\n    mut firsts.insert(\n      f\"{x.0} {x.1}\",\n      if mixed {\n        \"mixed\"\n      } else {\n        trim(get(lines(get(get(outs, j) ?? [], 0) ?? \"\"), 0) ?? \"\")\n      },\n    )\n  }\n  mut all := []\n  for (k, vc) in enumerate(vcs) {\n    mut out := []\n    for (i, ob) in enumerate(vc.obligations) {\n      word := match get(firsts, f\"{k} {i}\") ?? \"\" {\n        \"unsat\" => \"proven\",\n        \"sat\" => \"refuted\",\n        _ => \"unknown\",\n      }\n      mut out.push(word + \" \" + ob.what)\n    }\n    mut all.push(out + vc.given.map(g -> \"proven \" + g))\n  }\n  all\n}","old_text":"/// The solver's answer to each obligation of each of `vcs`, as `solve`\n/// gives them (`proven …`, `refuted …`, `unknown …`), except that a model is\n/// enough for `refuted`: a move is possible when some values make it,\n/// whether or not they can be shown (a type parameter's can't).\n/// \n/// Each question is a script of its own, written on worker threads and run\n/// together (`run_scripts`), so no question waits for another. A batch\n/// would answer few of them: in one, the solver's state from earlier\n/// questions can make one cost several times what it costs alone\n/// (`cancel`'s `Pending -> Cancelled` in examples/orders.strata). A\n/// question whose script mixes sorts (`sorts.sort_error`) is unknown: the\n/// solver would reject it.\nfn graph_answers_all(\n  mut launcher: std.process.Launcher,\n  mut disk: std.fs.Disk,\n  scratch: String,\n  solver: String,\n  vcs: List[smt.Vc],\n) -> List[List[String]] {\n  mut asked := []\n  for (k, vc) in enumerate(vcs) {\n    for i in 0..len(vc.obligations) {\n      mut asked.push((k, i, vc))\n    }\n  }\n  written := parallel.map(asked, x -> {\n    text := smt.single(x.2, x.1)\n    (text, sorts.sort_error(text) is Some)\n  })\n  outs := smt.run_scripts(\n    mut launcher,\n    mut disk,\n    scratch,\n    solver,\n    written.map(w -> (w.0, [\"-T:20\", \"rlimit=2000000\"])),\n  )\n  mut firsts := Dict[String, String] {}\n  for (j, x) in enumerate(asked) {\n    mixed := match get(written, j) {\n      Some(w) => w.1,\n      None => true,\n    }\n    mut firsts.insert(\n      f\"{x.0} {x.1}\",\n      if mixed {\n        \"mixed\"\n      } else {\n        trim(get(lines(get(get(outs, j) ?? [], 0) ?? \"\"), 0) ?? \"\")\n      },\n    )\n  }\n  mut all := []\n  for (k, vc) in enumerate(vcs) {\n    mut out := []\n    for (i, ob) in enumerate(vc.obligations) {\n      word := match get(firsts, f\"{k} {i}\") ?? \"\" {\n        \"unsat\" => \"proven\",\n        \"sat\" => \"refuted\",\n        _ => \"unknown\",\n      }\n      mut out.push(word + \" \" + ob.what)\n    }\n    mut all.push(out + vc.given.map(g -> \"proven \" + g))\n  }\n  all\n}"},{"name":"parallel.map_parallel","kind":"fn","old":null,"new":"44b5b87db3ed136f","interface_changed":true,"affected":[],"module":"parallel","text":"/// The same list as `xs.map(f)`, computed on `workers()` threads. Each\n/// worker takes the next index from a shared counter, so a slow element\n/// doesn't hold up the ones after it.\n/// \n/// Objects made before the workers start are pinned while they run\n/// (`driver_keep_shared`). Objects the workers make are counted as usual.\n/// `f` may only read shared data: no timings, no files.\npub fn map_parallel[T, R](xs: List[T], f: (T) -> R) -> List[R] {\n  n := min(parallel.workers(), len(xs))\n  if n <= 1 {\n    return xs.map(f)\n  }\n  match parallel.driver_keep_shared(1).to_int() {\n    _ => (),\n  }\n  c := parallel.work_counter()\n  parts := scope {\n    mut hs := []\n    for _ in 0..n {\n      mut hs.push(spawn parallel.map_worker(xs, f, c))\n    }\n    await hs\n  }\n  match parallel.driver_keep_shared(0).to_int() {\n    _ => (),\n  }\n  mut at := Dict[Int, R] {}\n  for part in parts {\n    for (i, r) in part {\n      mut at.insert(i, r)\n    }\n  }\n  mut out := []\n  for i in 0..len(xs) {\n    match get(at, i) {\n      Some(r) => mut out.push(r),\n      None => (),\n    }\n  }\n  out\n}"},{"name":"smt.encode_answered","kind":"fn","old":"d8eb9ac610599169","new":"bba053aca112b2c5","interface_changed":false,"affected":[],"module":"smt","text":"/// `encode_all` with running solver processes. Each function is encoded\n/// once on worker threads (`parallel.map`), sending its questions to the\n/// solver as they come (`Vc.live`: the run waits for each answer while the\n/// other workers go on), so every function's questions are in flight at\n/// once. Gives the same encodings as `encode_rounds`. With `prefetch`, a\n/// function's obligations are queued as soon as it is encoded, as\n/// `answers_all` asks them. `None` when the solver turned out not to answer\n/// a command as it reads it, which turns pooling off.\nfn encode_answered(\n  solver: String,\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  sigs: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  fs: List[(ast.FnDecl, String)],\n  prefetch: Bool,\n) -> Option[List[smt.Vc]] {\n  vcs := parallel.map_parallel(fs, x -> {\n    mut vc := smt.new_vc(fns, types, sigs, methods)\n    vc.live = solver\n    smt.function(mut vc, x.0, x.1)\n    if prefetch && vc.gaps == [] && len(vc.obligations) > 0 {\n      _ := smt.solver_pool_prefetch(solver, \"-t:20000 rlimit=2000000\"\n        + chr(31)\n        + smt.with_replies(smt.batch(vc)))\n    }\n    smt.Vc { ..vc, live: \"\" }\n  })\n  if smt.pooled(solver) {\n    Some(vcs)\n  } else {\n    None\n  }\n}","old_text":"/// `encode_all` with running solver processes. Each function is encoded\n/// once on worker threads (`parallel.map`), sending its questions to the\n/// solver as they come (`Vc.live`: the run waits for each answer while the\n/// other workers go on), so every function's questions are in flight at\n/// once. Gives the same encodings as `encode_rounds`. With `prefetch`, a\n/// function's obligations are queued as soon as it is encoded, as\n/// `answers_all` asks them. `None` when the solver turned out not to answer\n/// a command as it reads it, which turns pooling off.\nfn encode_answered(\n  solver: String,\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  sigs: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  fs: List[(ast.FnDecl, String)],\n  prefetch: Bool,\n) -> Option[List[smt.Vc]] {\n  vcs := parallel.map(fs, x -> {\n    mut vc := smt.new_vc(fns, types, sigs, methods)\n    vc.live = solver\n    smt.function(mut vc, x.0, x.1)\n    if prefetch && vc.gaps == [] && len(vc.obligations) > 0 {\n      _ := smt.solver_pool_prefetch(solver, \"-t:20000 rlimit=2000000\"\n        + chr(31)\n        + smt.with_replies(smt.batch(vc)))\n    }\n    smt.Vc { ..vc, live: \"\" }\n  })\n  if smt.pooled(solver) {\n    Some(vcs)\n  } else {\n    None\n  }\n}"},{"name":"termination.analyze_with","kind":"fn","old":"52476f13f65c672a","new":"68590ff603af3890","interface_changed":false,"affected":[],"module":"termination","text":"/// `analyze`, reusing what earlier runs found: `known` gives a function's\n/// loops (how each ends or why one may not, and whether one is a `for` over\n/// an iterator), `known_measure` a recursive function's measure (`None`\n/// when none was found). Returns the analysis and the new loop and measure\n/// results. The graph work is linear: strongly connected components are found\n/// once.\n/// All solver questions (`while` bounds, measures) are asked together, each\n/// function's in its own order.\npub fn analyze_with(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  ctx: termination.Ctx,\n  roots: Option[Set[String]],\n  known: (String) -> Option[(Result[List[String], String], Bool)],\n  known_measure: (String) -> Option[Option[String]],\n) -> (termination.Analysis, Dict[String, (Result[List[String], String], Bool)], Dict[String, Option[String]]) {\n  mut nodes := Dict[String, termination.Node] {}\n  for (name, f) in items(ctx.fns) {\n    ps := f.params.map(p -> p.name)\n    mut calls := termination.calls_within(ctx, f.body, ps, \"\")\n    for c in f.pre + f.post {\n      calls = union(calls, termination.calls_within(ctx, c, ps, \"\"))\n    }\n    mut nodes.insert(\n      name,\n      termination.Node { decl: Some(f), calls, body: Some(f) },\n    )\n  }\n  // implementation methods by label; each trait method's node reaches\n  // every implementation of it\n  mut impl_decls := []\n  for imp in ctx.methods.impls {\n    match termination.trait_of(ctx, imp) {\n      Some(tr) => {\n        for tm in tr.methods {\n          own := get(imp.methods.filter(m -> m.name == tm.decl.name), 0)\n          decl := match own {\n            Some(d) => Some(d),\n            None => if tm.default {\n              Some(tm.decl)\n            } else {\n              None\n            },\n          }\n          match decl {\n            Some(d) => {\n              label := termination.impl_label(ctx, imp, tm.decl.name)\n              tn := termination.trait_node(tm.decl.name)\n              calls := termination.calls_within(\n                ctx,\n                d.body,\n                d.params.map(p -> p.name),\n                tn,\n              )\n              mut nodes.insert(\n                label,\n                termination.Node {\n                  decl: None,\n                  calls,\n                  body: Some(termination.for_impl(imp, d)),\n                },\n              )\n              t := get(nodes, tn) ?? termination.no_node()\n              mut nodes.insert(\n                tn,\n                termination.Node { ..t, calls: {\n                  mut copy := t.calls\n                  mut copy.insert(label)\n                  copy\n                } },\n              )\n              mut impl_decls.push((label, d))\n            },\n            None => (),\n          }\n        }\n      },\n      None => (),\n    }\n  }\n  // trait methods no implementation defines\n  for n in values(nodes) {\n    for c in to_list(n.calls) {\n      if !contains(nodes, c) {\n        mut nodes.insert(c, termination.no_node())\n      }\n    }\n  }\n  names := keys(nodes)\n  // a node reaches itself when it calls itself or shares its component\n  comp := termination.components(names, nodes)\n  mut sizes := Dict[Int, Int] {}\n  for n in names {\n    c := get(comp, n) ?? -1\n    mut sizes.insert(c, (get(sizes, c) ?? 0) + 1)\n  }\n  same := (a: String, b: String) -> get(comp, a) ?? -1 == get(comp, b) ?? -2\n  recursive := set(names.filter(\n    n -> contains((get(nodes, n) ?? termination.no_node()).calls, n)\n      || get(sizes, get(comp, n) ?? -1) ?? 0 > 1,\n  ))\n  // the nodes whose verdict is wanted: the roots, the helpers refinements\n  // call (seen through wherever a type is checked), and what they reach\n  needed := match roots {\n    None => None,\n    Some(rs) => {\n      mut preds := []\n      for td in values(ctx.types) {\n        match td.refinement {\n          Some(r) => mut preds.push(r),\n          None => (),\n        }\n        match td.body {\n          ast.Alias(a) => {\n            preds += termination.refinements_in(a)\n          },\n          ast.RecordBody(fs) => {\n            for f in fs {\n              preds += termination.refinements_in(f.ty)\n            }\n          },\n          ast.SumBody(vs) => {\n            for v in vs {\n              match v.payload {\n                ast.Positional(ts) => {\n                  for t in ts {\n                    preds += termination.refinements_in(t)\n                  }\n                },\n                ast.RecordPayload(fs) => {\n                  for f in fs {\n                    preds += termination.refinements_in(f.ty)\n                  }\n                },\n                ast.MemberType(t) => {\n                  preds += termination.refinements_in(t)\n                },\n                ast.NoPayload => (),\n              }\n            }\n          },\n        }\n      }\n      for f in values(ctx.fns) {\n        for p in f.params {\n          preds += termination.refinements_in(p.ty)\n        }\n        preds += termination.refinements_in(f.ret)\n      }\n      mut all := rs\n      for e in preds {\n        all = union(all, termination.calls_within(ctx, e, [\"it\"], \"\"))\n      }\n      starts := to_list(all).filter(r -> contains(nodes, r))\n      Some(\n        union(set(starts), termination.reached_from(starts, nodes)),\n      )\n    },\n  }\n  wanted := (n: String) -> match needed {\n    None => true,\n    Some(s) => contains(s, n),\n  }\n  skipped := \"not analysed (nothing being verified reaches it)\"\n  // the `while` loops' bounds of what is wanted and not known, encoded\n  // together so their solver questions are asked at once\n  mut whiles := []\n  mut had := Dict[String, (Result[List[String], String], Bool)] {}\n  for n in names {\n    match (get(nodes, n) ?? termination.no_node()).body {\n      Some(b) => if wanted(n) {\n        match known(n) {\n          Some(x) => mut had.insert(n, x),\n          None => if termination.has_while(b) {\n            mut whiles.push((b, n))\n          },\n        }\n      },\n      None => (),\n    }\n  }\n  mut learned := Dict[String, (Result[List[String], String], Bool)] {}\n  mut encoded := Dict[String, smt.Vc] {}\n  timings.begin(\"verify: termination: encode\")\n  // (with the loop invariants derived from the code: a loop whose bound\n  // isn't shown to go down with them alone is searched below)\n  quick := smt.Methods { ..ctx.methods, search: 0 }\n  encoded_all := smt.encode_all(\n    mut commands,\n    mut files,\n    ctx.scratch,\n    ctx.solver,\n    ctx.fns,\n    ctx.types,\n    ctx.sigs,\n    quick,\n    whiles,\n  )\n  timings.end(\"verify: termination: encode\")\n  for (i, vc) in enumerate(encoded_all) {\n    match get(whiles, i) {\n      Some((_, n)) => mut encoded.insert(n, vc),\n      None => (),\n    }\n  }\n  // the loops of what is wanted and not known: those that need no solver\n  // first, then all `while` bounds asked together, each function's in order\n  mut searched := []\n  mut searches := []\n  timings.begin(\"verify: termination: loops\")\n  // functions with a `for` loop and no `while`, run on the workers to find\n  // what their loops run over\n  mut fors := []\n  for n in names {\n    match (get(nodes, n) ?? termination.no_node()).body {\n      Some(b) => if wanted(n)\n        && !contains(had, n)\n        && !termination.has_while(b)\n        && termination.has_for(b) {\n        mut fors.push((b, n))\n      },\n      None => (),\n    }\n  }\n  for ((_, n), vc) in zip(fors, parallel.map_parallel(fors, x -> {\n    mut v := smt.new_vc(ctx.fns, ctx.types, ctx.sigs, quick)\n    smt.function(mut v, x.0, x.1)\n    v\n  })) {\n    mut encoded.insert(n, vc)\n  }\n  for n in names {\n    match (get(nodes, n) ?? termination.no_node()).body {\n      Some(b) => if wanted(n) && !contains(had, n) {\n        mut iterates := false\n        s := termination.loop_start(\n          mut commands,\n          mut files,\n          ctx,\n          b,\n          n,\n          encoded,\n          mut iterates,\n        )\n        mut searched.push((n, iterates))\n        mut searches.push(s)\n      },\n      None => (),\n    }\n  }\n  timings.end(\"verify: termination: loops\")\n  for ((n, iterates), r) in zip(\n    searched,\n    termination.loops_all(mut commands, mut files, ctx, searches),\n  ) {\n    mut learned.insert(n, (r, iterates))\n  }\n  // the functions with a loop whose bound isn't shown to go down, where\n  // a loop's invariant search was left out: encoded again with it\n  mut again := []\n  for (b, n) in whiles {\n    match (get(learned, n), get(encoded, n)) {\n      (Some((Err(m), _)), Some(vc)) => if vc.skipped != []\n        && contains(m, \"no bound was shown to go down\") {\n        mut again.push((b, n))\n      },\n      _ => (),\n    }\n  }\n  // (no search, `Methods.search` 0, as `verify` and `build` run: a loop\n  // whose bound isn't shown to go down says how to go on)\n  mut found_loops := Dict[String, List[smt.LoopFound]] {}\n  if ctx.methods.search == 0 {\n    for (_, n) in again {\n      match get(learned, n) {\n        Some((Err(m), it)) => mut learned.insert(\n          n,\n          (\n            Err(\n              m\n                + \"; write an `invariant` or a `decreases` for it, or run `strata fix \"\n                + n\n                + \"` to search for an invariant\",\n            ),\n            it,\n          ),\n        ),\n        _ => (),\n      }\n    }\n  }\n  if again != [] && ctx.methods.search > 0 {\n    timings.begin(\"verify: termination: searched\")\n    for (i, vc) in enumerate(smt.encode_all(\n      mut commands,\n      mut files,\n      ctx.scratch,\n      ctx.solver,\n      ctx.fns,\n      ctx.types,\n      ctx.sigs,\n      ctx.methods,\n      again,\n    )) {\n      match get(again, i) {\n        Some((_, n)) => {\n          mut encoded.insert(n, vc)\n          if vc.found_loops != [] {\n            mut found_loops.insert(n, vc.found_loops)\n          }\n        },\n        None => (),\n      }\n    }\n    mut searched_again := []\n    mut searches_again := []\n    for (b, n) in again {\n      mut iterates := false\n      s := termination.loop_start(\n        mut commands,\n        mut files,\n        ctx,\n        b,\n        n,\n        encoded,\n        mut iterates,\n      )\n      mut searched_again.push((n, iterates))\n      mut searches_again.push(s)\n    }\n    for ((n, iterates), r) in zip(searched_again, termination.loops_all(\n      mut commands,\n      mut files,\n      ctx,\n      searches_again,\n    )) {\n      mut learned.insert(n, (r, iterates))\n    }\n    timings.end(\"verify: termination: searched\")\n  }\n  mut loops_of := Dict[String, Result[List[String], String]] {}\n  mut iterating := Set[String] {}\n  for n in names {\n    node := get(nodes, n) ?? termination.no_node()\n    match node.body {\n      Some(_) => {\n        r := if wanted(n) {\n          (found, iterates) := get(had, n) ?? get(learned, n) ?? (Ok([]), false)\n          if iterates {\n            mut iterating.insert(n)\n          }\n          found\n        } else {\n          Err(skipped)\n        }\n        mut loops_of.insert(n, r)\n      },\n      None => (),\n    }\n  }\n  // a callee in its component reaches it\n  mutual := (n: String) -> get(\n    to_list((get(nodes, n) ?? termination.no_node()).calls).filter(\n      c -> c != n && same(c, n),\n    ),\n    0,\n  )\n  // the measures of functions that call only themselves without passing a\n  // smaller piece of a parameter, searched together, each in its order\n  mut measured_names := []\n  mut measure_searches := []\n  mut measures := Dict[String, Option[String]] {}\n  for n in names {\n    node := get(nodes, n) ?? termination.no_node()\n    if wanted(n) && contains(node.calls, n) && mutual(n) is None {\n      match (get(loops_of, n) ?? Ok([]), node.decl) {\n        (Ok(_), Some(f)) => if termination.structural(ctx, f, n) is None {\n          match known_measure(n) {\n            Some(m) => mut measures.insert(n, m),\n            None => {\n              mut measured_names.push(n)\n              mut measure_searches.push(\n                termination.measure_start(ctx, f, n),\n              )\n            },\n          }\n        },\n        _ => (),\n      }\n    }\n  }\n  mut measured := Dict[String, Option[String]] {}\n  for (n, s) in zip(measured_names, termination.measures_all(\n    mut commands,\n    mut files,\n    ctx,\n    measure_searches,\n  )) {\n    // a `decreases` clause's measure is the one tried\n    written := match (get(nodes, n) ?? termination.no_node()).decl {\n      Some(f) => text.decreases_text(f.body),\n      None => \"\",\n    }\n    m := match s.found {\n      Some(ms) => Some(if written != \"\" {\n        \"its `\" + written + \"` measure\"\n      } else {\n        termination.measure_shown(ms)\n      }),\n      None => None,\n    }\n    mut measures.insert(n, m)\n    mut measured.insert(n, m)\n  }\n  // each node's own verdict, ignoring its callees\n  mut own := Dict[String, Result[String, String]] {}\n  for n in names {\n    node := get(nodes, n) ?? termination.no_node()\n    if !wanted(n) {\n      mut own.insert(n, Err(skipped))\n      continue\n    }\n    r := match get(loops_of, n) ?? Ok([]) {\n      Err(e) => Err(e),\n      Ok(hows) => match mutual(n) {\n        Some(other) => Err(\"it is recursive through `\"\n          + termination.shown_node(other)\n          + \"`\"),\n        None => if contains(node.calls, n) {\n          match node.decl {\n            Some(f) => match termination.structural(ctx, f, n) {\n              Some(p) => Ok(\"each recursive call gets a smaller piece of `\"\n                + p\n                + \"`\"),\n              None => match get(measures, n) ?? None {\n                Some(m) => Ok(\n                  m\n                    + \" goes down on every recursive call and is never negative there\",\n                ),\n                None => Err(\n                  if text.decreases_text(f.body) != \"\" {\n                    \"its `\"\n                      + text.decreases_text(f.body)\n                      + \"` was not shown to go down on every recursive call (it is checked when the program runs)\"\n                  } else {\n                    \"it calls itself, and nothing was found that gets smaller on every call (a piece of a parameter, or a non-negative measure of the parameters)\"\n                  },\n                ),\n              },\n            },\n            None => Err(\n              \"it calls itself, and nothing was found that gets smaller on every call (a piece of a parameter, or a non-negative measure of the parameters)\",\n            ),\n          }\n        } else if len(hows) == 0 {\n          Ok(\"no recursion, and only `for` loops\")\n        } else {\n          Ok(join(hows, \"; \"))\n        },\n      },\n    }\n    mut own.insert(n, r)\n  }\n  mut marked := Set[String] {}\n  for (n, f) in items(ctx.fns) {\n    if f.terminating {\n      mut marked.insert(n)\n    }\n  }\n  for (label, d) in impl_decls {\n    if d.terminating {\n      mut marked.insert(label)\n    }\n  }\n  // combined with the callees, deepest first; cycles are already unknown\n  mut memo := Dict[String, termination.Termination] {}\n  for n in names {\n    termination.resolve(\n      nodes,\n      own,\n      marked,\n      mut memo,\n      n,\n      Set[String] {},\n    )\n  }\n  // transparent: finishes, and cannot fail (its callees transparent, or\n  // recursive functions a contract may unfold); recursive functions a\n  // contract may unfold (`compiler/smt`'s `def_call`): they call only\n  // themselves, finish, and fail nowhere else\n  mut transparent := Dict[String, Bool] {}\n  mut unfold := Set[String] {}\n  // (both: what a body seen through may call)\n  mut callable := Dict[String, Bool] {}\n  mut changed := true\n  while changed {\n    changed = false\n    for (name, f) in items(ctx.fns) {\n      if contains(unfold, name)\n        || !contains(recursive, name)\n        || get(sizes, get(comp, name) ?? -1) ?? 0 != 1 {\n        continue\n      }\n      ends := match get(memo, name) {\n        Some(termination.Proven(_)) | Some(termination.Assumed(_)) => true,\n        _ => false,\n      }\n      mut with_self := callable\n      mut with_self.insert(name, false)\n      if ends && termination.cannot_fail(ctx, f, with_self) {\n        mut unfold.insert(name)\n        mut callable.insert(name, false)\n        changed = true\n      }\n    }\n    for (name, f) in items(ctx.fns) {\n      if contains(transparent, name)\n        || contains(recursive, name)\n        || contains(iterating, name) {\n        continue\n      }\n      (ends, assumed) := match get(memo, name) {\n        Some(termination.Proven(_)) => (true, false),\n        Some(termination.Assumed(_)) => (true, true),\n        _ => (false, false),\n      }\n      if !ends {\n        continue\n      }\n      if termination.cannot_fail(ctx, f, callable) {\n        mut transparent.insert(name, assumed)\n        mut callable.insert(name, assumed)\n        changed = true\n      }\n    }\n    // implementation methods, by label\n    for imp in ctx.methods.impls {\n      for m in imp.methods {\n        label := termination.impl_label(ctx, imp, m.name)\n        if contains(transparent, label)\n          || contains(recursive, label)\n          || contains(iterating, label) {\n          continue\n        }\n        (ends, assumed) := match get(memo, label) {\n          Some(termination.Proven(_)) => (true, false),\n          Some(termination.Assumed(_)) => (true, true),\n          _ => (false, false),\n        }\n        if !ends {\n          continue\n        }\n        if termination.cannot_fail(\n          ctx,\n          termination.with_trait_contract(ctx, imp, m),\n          callable,\n        ) {\n          mut transparent.insert(label, assumed)\n          mut callable.insert(label, assumed)\n          changed = true\n        }\n      }\n    }\n  }\n  // (what a search cut short, the search budget used up, found is not kept)\n  mut learned_kept := Dict[String, (Result[List[String], String], Bool)] {}\n  for (n, x) in items(learned) {\n    match get(encoded, n) {\n      Some(vc) => if !vc.search_cut {\n        mut learned_kept.insert(n, x)\n      },\n      None => mut learned_kept.insert(n, x),\n    }\n  }\n  mut status := Dict[String, termination.Termination] {}\n  for (k, t) in items(memo) {\n    if !starts_with(k, \"trait method \") {\n      mut status.insert(k, t)\n    }\n  }\n  (termination.Analysis { status, recursive: set(\n    to_list(recursive).filter(k -> !starts_with(k, \"trait method \")),\n  ), transparent, unfold, found_loops }, learned_kept, measured)\n}","old_text":"/// `analyze`, reusing what earlier runs found: `known` gives a function's\n/// loops (how each ends or why one may not, and whether one is a `for` over\n/// an iterator), `known_measure` a recursive function's measure (`None`\n/// when none was found). Returns the analysis and the new loop and measure\n/// results. The graph work is linear: strongly connected components are found\n/// once.\n/// All solver questions (`while` bounds, measures) are asked together, each\n/// function's in its own order.\npub fn analyze_with(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  ctx: termination.Ctx,\n  roots: Option[Set[String]],\n  known: (String) -> Option[(Result[List[String], String], Bool)],\n  known_measure: (String) -> Option[Option[String]],\n) -> (termination.Analysis, Dict[String, (Result[List[String], String], Bool)], Dict[String, Option[String]]) {\n  mut nodes := Dict[String, termination.Node] {}\n  for (name, f) in items(ctx.fns) {\n    ps := f.params.map(p -> p.name)\n    mut calls := termination.calls_within(ctx, f.body, ps, \"\")\n    for c in f.pre + f.post {\n      calls = union(calls, termination.calls_within(ctx, c, ps, \"\"))\n    }\n    mut nodes.insert(\n      name,\n      termination.Node { decl: Some(f), calls, body: Some(f) },\n    )\n  }\n  // implementation methods by label; each trait method's node reaches\n  // every implementation of it\n  mut impl_decls := []\n  for imp in ctx.methods.impls {\n    match termination.trait_of(ctx, imp) {\n      Some(tr) => {\n        for tm in tr.methods {\n          own := get(imp.methods.filter(m -> m.name == tm.decl.name), 0)\n          decl := match own {\n            Some(d) => Some(d),\n            None => if tm.default {\n              Some(tm.decl)\n            } else {\n              None\n            },\n          }\n          match decl {\n            Some(d) => {\n              label := termination.impl_label(ctx, imp, tm.decl.name)\n              tn := termination.trait_node(tm.decl.name)\n              calls := termination.calls_within(\n                ctx,\n                d.body,\n                d.params.map(p -> p.name),\n                tn,\n              )\n              mut nodes.insert(\n                label,\n                termination.Node {\n                  decl: None,\n                  calls,\n                  body: Some(termination.for_impl(imp, d)),\n                },\n              )\n              t := get(nodes, tn) ?? termination.no_node()\n              mut nodes.insert(\n                tn,\n                termination.Node { ..t, calls: {\n                  mut copy := t.calls\n                  mut copy.insert(label)\n                  copy\n                } },\n              )\n              mut impl_decls.push((label, d))\n            },\n            None => (),\n          }\n        }\n      },\n      None => (),\n    }\n  }\n  // trait methods no implementation defines\n  for n in values(nodes) {\n    for c in to_list(n.calls) {\n      if !contains(nodes, c) {\n        mut nodes.insert(c, termination.no_node())\n      }\n    }\n  }\n  names := keys(nodes)\n  // a node reaches itself when it calls itself or shares its component\n  comp := termination.components(names, nodes)\n  mut sizes := Dict[Int, Int] {}\n  for n in names {\n    c := get(comp, n) ?? -1\n    mut sizes.insert(c, (get(sizes, c) ?? 0) + 1)\n  }\n  same := (a: String, b: String) -> get(comp, a) ?? -1 == get(comp, b) ?? -2\n  recursive := set(names.filter(\n    n -> contains((get(nodes, n) ?? termination.no_node()).calls, n)\n      || get(sizes, get(comp, n) ?? -1) ?? 0 > 1,\n  ))\n  // the nodes whose verdict is wanted: the roots, the helpers refinements\n  // call (seen through wherever a type is checked), and what they reach\n  needed := match roots {\n    None => None,\n    Some(rs) => {\n      mut preds := []\n      for td in values(ctx.types) {\n        match td.refinement {\n          Some(r) => mut preds.push(r),\n          None => (),\n        }\n        match td.body {\n          ast.Alias(a) => {\n            preds += termination.refinements_in(a)\n          },\n          ast.RecordBody(fs) => {\n            for f in fs {\n              preds += termination.refinements_in(f.ty)\n            }\n          },\n          ast.SumBody(vs) => {\n            for v in vs {\n              match v.payload {\n                ast.Positional(ts) => {\n                  for t in ts {\n                    preds += termination.refinements_in(t)\n                  }\n                },\n                ast.RecordPayload(fs) => {\n                  for f in fs {\n                    preds += termination.refinements_in(f.ty)\n                  }\n                },\n                ast.MemberType(t) => {\n                  preds += termination.refinements_in(t)\n                },\n                ast.NoPayload => (),\n              }\n            }\n          },\n        }\n      }\n      for f in values(ctx.fns) {\n        for p in f.params {\n          preds += termination.refinements_in(p.ty)\n        }\n        preds += termination.refinements_in(f.ret)\n      }\n      mut all := rs\n      for e in preds {\n        all = union(all, termination.calls_within(ctx, e, [\"it\"], \"\"))\n      }\n      starts := to_list(all).filter(r -> contains(nodes, r))\n      Some(\n        union(set(starts), termination.reached_from(starts, nodes)),\n      )\n    },\n  }\n  wanted := (n: String) -> match needed {\n    None => true,\n    Some(s) => contains(s, n),\n  }\n  skipped := \"not analysed (nothing being verified reaches it)\"\n  // the `while` loops' bounds of what is wanted and not known, encoded\n  // together so their solver questions are asked at once\n  mut whiles := []\n  mut had := Dict[String, (Result[List[String], String], Bool)] {}\n  for n in names {\n    match (get(nodes, n) ?? termination.no_node()).body {\n      Some(b) => if wanted(n) {\n        match known(n) {\n          Some(x) => mut had.insert(n, x),\n          None => if termination.has_while(b) {\n            mut whiles.push((b, n))\n          },\n        }\n      },\n      None => (),\n    }\n  }\n  mut learned := Dict[String, (Result[List[String], String], Bool)] {}\n  mut encoded := Dict[String, smt.Vc] {}\n  timings.begin(\"verify: termination: encode\")\n  // (with the loop invariants derived from the code: a loop whose bound\n  // isn't shown to go down with them alone is searched below)\n  quick := smt.Methods { ..ctx.methods, search: 0 }\n  encoded_all := smt.encode_all(\n    mut commands,\n    mut files,\n    ctx.scratch,\n    ctx.solver,\n    ctx.fns,\n    ctx.types,\n    ctx.sigs,\n    quick,\n    whiles,\n  )\n  timings.end(\"verify: termination: encode\")\n  for (i, vc) in enumerate(encoded_all) {\n    match get(whiles, i) {\n      Some((_, n)) => mut encoded.insert(n, vc),\n      None => (),\n    }\n  }\n  // the loops of what is wanted and not known: those that need no solver\n  // first, then all `while` bounds asked together, each function's in order\n  mut searched := []\n  mut searches := []\n  timings.begin(\"verify: termination: loops\")\n  // functions with a `for` loop and no `while`, run on the workers to find\n  // what their loops run over\n  mut fors := []\n  for n in names {\n    match (get(nodes, n) ?? termination.no_node()).body {\n      Some(b) => if wanted(n)\n        && !contains(had, n)\n        && !termination.has_while(b)\n        && termination.has_for(b) {\n        mut fors.push((b, n))\n      },\n      None => (),\n    }\n  }\n  for ((_, n), vc) in zip(fors, parallel.map(fors, x -> {\n    mut v := smt.new_vc(ctx.fns, ctx.types, ctx.sigs, quick)\n    smt.function(mut v, x.0, x.1)\n    v\n  })) {\n    mut encoded.insert(n, vc)\n  }\n  for n in names {\n    match (get(nodes, n) ?? termination.no_node()).body {\n      Some(b) => if wanted(n) && !contains(had, n) {\n        mut iterates := false\n        s := termination.loop_start(\n          mut commands,\n          mut files,\n          ctx,\n          b,\n          n,\n          encoded,\n          mut iterates,\n        )\n        mut searched.push((n, iterates))\n        mut searches.push(s)\n      },\n      None => (),\n    }\n  }\n  timings.end(\"verify: termination: loops\")\n  for ((n, iterates), r) in zip(\n    searched,\n    termination.loops_all(mut commands, mut files, ctx, searches),\n  ) {\n    mut learned.insert(n, (r, iterates))\n  }\n  // the functions with a loop whose bound isn't shown to go down, where\n  // a loop's invariant search was left out: encoded again with it\n  mut again := []\n  for (b, n) in whiles {\n    match (get(learned, n), get(encoded, n)) {\n      (Some((Err(m), _)), Some(vc)) => if vc.skipped != []\n        && contains(m, \"no bound was shown to go down\") {\n        mut again.push((b, n))\n      },\n      _ => (),\n    }\n  }\n  // (no search, `Methods.search` 0, as `verify` and `build` run: a loop\n  // whose bound isn't shown to go down says how to go on)\n  mut found_loops := Dict[String, List[smt.LoopFound]] {}\n  if ctx.methods.search == 0 {\n    for (_, n) in again {\n      match get(learned, n) {\n        Some((Err(m), it)) => mut learned.insert(\n          n,\n          (\n            Err(\n              m\n                + \"; write an `invariant` or a `decreases` for it, or run `strata fix \"\n                + n\n                + \"` to search for an invariant\",\n            ),\n            it,\n          ),\n        ),\n        _ => (),\n      }\n    }\n  }\n  if again != [] && ctx.methods.search > 0 {\n    timings.begin(\"verify: termination: searched\")\n    for (i, vc) in enumerate(smt.encode_all(\n      mut commands,\n      mut files,\n      ctx.scratch,\n      ctx.solver,\n      ctx.fns,\n      ctx.types,\n      ctx.sigs,\n      ctx.methods,\n      again,\n    )) {\n      match get(again, i) {\n        Some((_, n)) => {\n          mut encoded.insert(n, vc)\n          if vc.found_loops != [] {\n            mut found_loops.insert(n, vc.found_loops)\n          }\n        },\n        None => (),\n      }\n    }\n    mut searched_again := []\n    mut searches_again := []\n    for (b, n) in again {\n      mut iterates := false\n      s := termination.loop_start(\n        mut commands,\n        mut files,\n        ctx,\n        b,\n        n,\n        encoded,\n        mut iterates,\n      )\n      mut searched_again.push((n, iterates))\n      mut searches_again.push(s)\n    }\n    for ((n, iterates), r) in zip(searched_again, termination.loops_all(\n      mut commands,\n      mut files,\n      ctx,\n      searches_again,\n    )) {\n      mut learned.insert(n, (r, iterates))\n    }\n    timings.end(\"verify: termination: searched\")\n  }\n  mut loops_of := Dict[String, Result[List[String], String]] {}\n  mut iterating := Set[String] {}\n  for n in names {\n    node := get(nodes, n) ?? termination.no_node()\n    match node.body {\n      Some(_) => {\n        r := if wanted(n) {\n          (found, iterates) := get(had, n) ?? get(learned, n) ?? (Ok([]), false)\n          if iterates {\n            mut iterating.insert(n)\n          }\n          found\n        } else {\n          Err(skipped)\n        }\n        mut loops_of.insert(n, r)\n      },\n      None => (),\n    }\n  }\n  // a callee in its component reaches it\n  mutual := (n: String) -> get(\n    to_list((get(nodes, n) ?? termination.no_node()).calls).filter(\n      c -> c != n && same(c, n),\n    ),\n    0,\n  )\n  // the measures of functions that call only themselves without passing a\n  // smaller piece of a parameter, searched together, each in its order\n  mut measured_names := []\n  mut measure_searches := []\n  mut measures := Dict[String, Option[String]] {}\n  for n in names {\n    node := get(nodes, n) ?? termination.no_node()\n    if wanted(n) && contains(node.calls, n) && mutual(n) is None {\n      match (get(loops_of, n) ?? Ok([]), node.decl) {\n        (Ok(_), Some(f)) => if termination.structural(ctx, f, n) is None {\n          match known_measure(n) {\n            Some(m) => mut measures.insert(n, m),\n            None => {\n              mut measured_names.push(n)\n              mut measure_searches.push(\n                termination.measure_start(ctx, f, n),\n              )\n            },\n          }\n        },\n        _ => (),\n      }\n    }\n  }\n  mut measured := Dict[String, Option[String]] {}\n  for (n, s) in zip(measured_names, termination.measures_all(\n    mut commands,\n    mut files,\n    ctx,\n    measure_searches,\n  )) {\n    // a `decreases` clause's measure is the one tried\n    written := match (get(nodes, n) ?? termination.no_node()).decl {\n      Some(f) => text.decreases_text(f.body),\n      None => \"\",\n    }\n    m := match s.found {\n      Some(ms) => Some(if written != \"\" {\n        \"its `\" + written + \"` measure\"\n      } else {\n        termination.measure_shown(ms)\n      }),\n      None => None,\n    }\n    mut measures.insert(n, m)\n    mut measured.insert(n, m)\n  }\n  // each node's own verdict, ignoring its callees\n  mut own := Dict[String, Result[String, String]] {}\n  for n in names {\n    node := get(nodes, n) ?? termination.no_node()\n    if !wanted(n) {\n      mut own.insert(n, Err(skipped))\n      continue\n    }\n    r := match get(loops_of, n) ?? Ok([]) {\n      Err(e) => Err(e),\n      Ok(hows) => match mutual(n) {\n        Some(other) => Err(\"it is recursive through `\"\n          + termination.shown_node(other)\n          + \"`\"),\n        None => if contains(node.calls, n) {\n          match node.decl {\n            Some(f) => match termination.structural(ctx, f, n) {\n              Some(p) => Ok(\"each recursive call gets a smaller piece of `\"\n                + p\n                + \"`\"),\n              None => match get(measures, n) ?? None {\n                Some(m) => Ok(\n                  m\n                    + \" goes down on every recursive call and is never negative there\",\n                ),\n                None => Err(\n                  if text.decreases_text(f.body) != \"\" {\n                    \"its `\"\n                      + text.decreases_text(f.body)\n                      + \"` was not shown to go down on every recursive call (it is checked when the program runs)\"\n                  } else {\n                    \"it calls itself, and nothing was found that gets smaller on every call (a piece of a parameter, or a non-negative measure of the parameters)\"\n                  },\n                ),\n              },\n            },\n            None => Err(\n              \"it calls itself, and nothing was found that gets smaller on every call (a piece of a parameter, or a non-negative measure of the parameters)\",\n            ),\n          }\n        } else if len(hows) == 0 {\n          Ok(\"no recursion, and only `for` loops\")\n        } else {\n          Ok(join(hows, \"; \"))\n        },\n      },\n    }\n    mut own.insert(n, r)\n  }\n  mut marked := Set[String] {}\n  for (n, f) in items(ctx.fns) {\n    if f.terminating {\n      mut marked.insert(n)\n    }\n  }\n  for (label, d) in impl_decls {\n    if d.terminating {\n      mut marked.insert(label)\n    }\n  }\n  // combined with the callees, deepest first; cycles are already unknown\n  mut memo := Dict[String, termination.Termination] {}\n  for n in names {\n    termination.resolve(\n      nodes,\n      own,\n      marked,\n      mut memo,\n      n,\n      Set[String] {},\n    )\n  }\n  // transparent: finishes, and cannot fail (its callees transparent, or\n  // recursive functions a contract may unfold); recursive functions a\n  // contract may unfold (`compiler/smt`'s `def_call`): they call only\n  // themselves, finish, and fail nowhere else\n  mut transparent := Dict[String, Bool] {}\n  mut unfold := Set[String] {}\n  // (both: what a body seen through may call)\n  mut callable := Dict[String, Bool] {}\n  mut changed := true\n  while changed {\n    changed = false\n    for (name, f) in items(ctx.fns) {\n      if contains(unfold, name)\n        || !contains(recursive, name)\n        || get(sizes, get(comp, name) ?? -1) ?? 0 != 1 {\n        continue\n      }\n      ends := match get(memo, name) {\n        Some(termination.Proven(_)) | Some(termination.Assumed(_)) => true,\n        _ => false,\n      }\n      mut with_self := callable\n      mut with_self.insert(name, false)\n      if ends && termination.cannot_fail(ctx, f, with_self) {\n        mut unfold.insert(name)\n        mut callable.insert(name, false)\n        changed = true\n      }\n    }\n    for (name, f) in items(ctx.fns) {\n      if contains(transparent, name)\n        || contains(recursive, name)\n        || contains(iterating, name) {\n        continue\n      }\n      (ends, assumed) := match get(memo, name) {\n        Some(termination.Proven(_)) => (true, false),\n        Some(termination.Assumed(_)) => (true, true),\n        _ => (false, false),\n      }\n      if !ends {\n        continue\n      }\n      if termination.cannot_fail(ctx, f, callable) {\n        mut transparent.insert(name, assumed)\n        mut callable.insert(name, assumed)\n        changed = true\n      }\n    }\n    // implementation methods, by label\n    for imp in ctx.methods.impls {\n      for m in imp.methods {\n        label := termination.impl_label(ctx, imp, m.name)\n        if contains(transparent, label)\n          || contains(recursive, label)\n          || contains(iterating, label) {\n          continue\n        }\n        (ends, assumed) := match get(memo, label) {\n          Some(termination.Proven(_)) => (true, false),\n          Some(termination.Assumed(_)) => (true, true),\n          _ => (false, false),\n        }\n        if !ends {\n          continue\n        }\n        if termination.cannot_fail(\n          ctx,\n          termination.with_trait_contract(ctx, imp, m),\n          callable,\n        ) {\n          mut transparent.insert(label, assumed)\n          mut callable.insert(label, assumed)\n          changed = true\n        }\n      }\n    }\n  }\n  // (what a search cut short, the search budget used up, found is not kept)\n  mut learned_kept := Dict[String, (Result[List[String], String], Bool)] {}\n  for (n, x) in items(learned) {\n    match get(encoded, n) {\n      Some(vc) => if !vc.search_cut {\n        mut learned_kept.insert(n, x)\n      },\n      None => mut learned_kept.insert(n, x),\n    }\n  }\n  mut status := Dict[String, termination.Termination] {}\n  for (k, t) in items(memo) {\n    if !starts_with(k, \"trait method \") {\n      mut status.insert(k, t)\n    }\n  }\n  (termination.Analysis { status, recursive: set(\n    to_list(recursive).filter(k -> !starts_with(k, \"trait method \")),\n  ), transparent, unfold, found_loops }, learned_kept, measured)\n}"},{"name":"parallel.map","kind":"fn","old":"05e9f4174f2c8596","new":null,"interface_changed":true,"affected":[],"module":"parallel","old_text":"/// The same list as `xs.map(f)`, computed on `workers()` threads. Each\n/// worker takes the next index from a shared counter, so a slow element\n/// doesn't hold up the ones after it.\n/// \n/// Objects made before the workers start are pinned while they run\n/// (`driver_keep_shared`). Objects the workers make are counted as usual.\n/// `f` may only read shared data: no timings, no files.\npub fn map[T, R](xs: List[T], f: (T) -> R) -> List[R] {\n  n := min(parallel.workers(), len(xs))\n  if n <= 1 {\n    return xs.map(f)\n  }\n  match parallel.driver_keep_shared(1).to_int() {\n    _ => (),\n  }\n  c := parallel.work_counter()\n  parts := scope {\n    mut hs := []\n    for _ in 0..n {\n      mut hs.push(spawn parallel.map_worker(xs, f, c))\n    }\n    await hs\n  }\n  match parallel.driver_keep_shared(0).to_int() {\n    _ => (),\n  }\n  mut at := Dict[Int, R] {}\n  for part in parts {\n    for (i, r) in part {\n      mut at.insert(i, r)\n    }\n  }\n  mut out := []\n  for i in 0..len(xs) {\n    match get(at, i) {\n      Some(r) => mut out.push(r),\n      None => (),\n    }\n  }\n  out\n}"}],"renames":[{"from":"parallel.map","to":"parallel.map_parallel","kind":"function"}],"references":["check.typed","check.type_errors_with","codegen.generate","decoded_files","graph_answers_all","smt.encode_answered","termination.analyze_with"]}
{"id":"484e52f0d440d2ad","time":1795709835,"message":"edit","changes":[{"name":"strata_command","kind":"fn","old":"50eacf0f514446a3","new":"b5eb5eab7ef80e3f","interface_changed":false,"affected":[],"module":"","text":"/// The `strata` command `command`, its command line read into `line`:\n/// help, and the commands that compile, run and check programs. Exit code\n/// 2 for a mistake in the command (said on stderr), 1 when the program is\n/// rejected.\nfn strata_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  command: String,\n  line: driver.Args,\n) -> std.process.ExitCode {\n  if driver.given(line, \"--version\") || command == \"version\" {\n    print(\"strata \" + version())\n    return 0\n  }\n  if command == \"\" || command == \"help\" {\n    print(std.cli.styled_help(\n      driver.usage_text(),\n      console.paint(std.term.Output),\n    ))\n    return 0\n  }\n  // (`skill` is compiler/skill's: no home needed)\n  if command == \"skill\" {\n    rest := driver.words_without(process.args(), line.command_at)\n    return skill.skill_command(mut console, mut disk, process, rest)\n  }\n  // (`cache` works on the own cache, compiler/cache's: no home needed)\n  if command == \"cache\" {\n    return cache_command(mut console, mut disk, process, cache, line)\n  }\n  if contains([\"ui\", \"serve\", \"ast\"], command) {\n    return fail_with(\n      mut console,\n      f\"`{command}` is not part of this strata (the command written in Strata)\",\n    )\n  }\n  if !contains([\n    \"check\",\n    \"run\",\n    \"repl\",\n    \"build\",\n    \"test\",\n    \"verify\",\n    \"verify-alongside\",\n    \"live-edits\",\n    \"build-core\",\n    \"lex\",\n    \"parse\",\n    \"builtins\",\n    \"find\",\n    \"refs\",\n  ], command) {\n    return fail_with(\n      mut console,\n      f\"unknown command `{command}` (try `strata help`)\",\n    )\n  }\n  // the paths given are the current folder's. The compiler reads core/,\n  // std/ and the prelude from its home, which it enters.\n  cwd := process.current_dir()\n  home := match home_found(disk, process) {\n    Some(h) => h,\n    None => return fail_with(\n      mut console,\n      \"can't find Strata's home (a folder holding core/, std/ and runtime/prelude.strata, above this executable or the current folder): set STRATA_HOME\",\n    ),\n  }\n  // programs and tests are compiled unoptimized (several times faster to\n  // compile); `--release` optimizes as clang -O2 would\n  if command == \"run\" || command == \"test\" {\n    level := if driver.given(line, \"--release\") {\n      2\n    } else {\n      0\n    }\n    match jit_set_opt(level.wrap_i32()).to_int() {\n      _ => (),\n    }\n  }\n  // (`find` and `refs` are compiler/finding's)\n  if command == \"find\" || command == \"refs\" {\n    rest := driver.words_without(process.args(), line.command_at)\n    return if command == \"find\" {\n      finding.find_command(mut console, disk, process, rest)\n    } else {\n      finding.refs_command(mut console, disk, process, rest)\n    }\n  }\n  // `--profile`: every function compiled keeps its frame pointer, for\n  // `sample` (compiler/toolchain's `profiling`)\n  if driver.given(line, \"--profile\") {\n    toolchain.set_profile()\n  }\n  // `--timings`: each phase's time, on stderr when the command ends\n  // (compiler/timings)\n  if driver.given(line, \"--timings\") {\n    timings.enable()\n  }\n  if driver_chdir(home).to_int() != 0 {\n    return fail_with(mut console, f\"can't enter {home}\")\n  }\n  match command {\n    \"check\" => check_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    \"repl\" => repl_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      clock,\n      cache,\n      line,\n      cwd,\n    ),\n    \"run\" => run_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    \"build\" => build_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n      home,\n    ),\n    \"test\" => test_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    \"verify\" => verify_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    // (started by `run --live`: `start_live`)\n    \"live-edits\" => live_edits_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n    ),\n    // (started by `run`: `start_alongside`)\n    \"verify-alongside\" => alongside_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n    ),\n    \"build-core\" => build_core_command(mut console, mut disk, line, cwd),\n    \"lex\" | \"parse\" => front_command(mut console, disk, command, line, cwd),\n    _ => builtins_command(disk, line),\n  }\n}","old_text":"/// The `strata` command `command`, its command line read into `line`:\n/// help, and the commands that compile, run and check programs. Exit code\n/// 2 for a mistake in the command (said on stderr), 1 when the program is\n/// rejected.\nfn strata_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  command: String,\n  line: driver.Args,\n) -> std.process.ExitCode {\n  if driver.given(line, \"--version\") || command == \"version\" {\n    print(\"strata \" + version())\n    return 0\n  }\n  if command == \"\" || command == \"help\" {\n    print(std.cli.styled_help(\n      driver.usage_text(),\n      console.paint(std.term.Output),\n    ))\n    return 0\n  }\n  // (`skill` is compiler/skill's: no home needed)\n  if command == \"skill\" {\n    rest := driver.words_without(process.args(), line.command_at)\n    return skill.skill_command(mut console, mut disk, process, rest)\n  }\n  // (`cache` works on the own cache, compiler/cache's: no home needed)\n  if command == \"cache\" {\n    return cache_command(mut console, mut disk, process, cache, line)\n  }\n  if contains([\"ui\", \"serve\", \"ast\"], command) {\n    return fail_with(\n      mut console,\n      f\"`{command}` is not part of this strata (the command written in Strata)\",\n    )\n  }\n  if !contains([\n    \"check\",\n    \"run\",\n    \"repl\",\n    \"build\",\n    \"test\",\n    \"verify\",\n    \"verify-alongside\",\n    \"build-core\",\n    \"lex\",\n    \"parse\",\n    \"builtins\",\n    \"find\",\n    \"refs\",\n  ], command) {\n    return fail_with(\n      mut console,\n      f\"unknown command `{command}` (try `strata help`)\",\n    )\n  }\n  // the paths given are the current folder's. The compiler reads core/,\n  // std/ and the prelude from its home, which it enters.\n  cwd := process.current_dir()\n  home := match home_found(disk, process) {\n    Some(h) => h,\n    None => return fail_with(\n      mut console,\n      \"can't find Strata's home (a folder holding core/, std/ and runtime/prelude.strata, above this executable or the current folder): set STRATA_HOME\",\n    ),\n  }\n  // programs and tests are compiled unoptimized (several times faster to\n  // compile); `--release` optimizes as clang -O2 would\n  if command == \"run\" || command == \"test\" {\n    level := if driver.given(line, \"--release\") {\n      2\n    } else {\n      0\n    }\n    match jit_set_opt(level.wrap_i32()).to_int() {\n      _ => (),\n    }\n  }\n  // (`find` and `refs` are compiler/finding's)\n  if command == \"find\" || command == \"refs\" {\n    rest := driver.words_without(process.args(), line.command_at)\n    return if command == \"find\" {\n      finding.find_command(mut console, disk, process, rest)\n    } else {\n      finding.refs_command(mut console, disk, process, rest)\n    }\n  }\n  // `--profile`: every function compiled keeps its frame pointer, for\n  // `sample` (compiler/toolchain's `profiling`)\n  if driver.given(line, \"--profile\") {\n    toolchain.set_profile()\n  }\n  // `--timings`: each phase's time, on stderr when the command ends\n  // (compiler/timings)\n  if driver.given(line, \"--timings\") {\n    timings.enable()\n  }\n  if driver_chdir(home).to_int() != 0 {\n    return fail_with(mut console, f\"can't enter {home}\")\n  }\n  match command {\n    \"check\" => check_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    \"repl\" => repl_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      clock,\n      cache,\n      line,\n      cwd,\n    ),\n    \"run\" => run_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    \"build\" => build_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n      home,\n    ),\n    \"test\" => test_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    \"verify\" => verify_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    // (started by `run`: `start_alongside`)\n    \"verify-alongside\" => alongside_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n    ),\n    \"build-core\" => build_core_command(mut console, mut disk, line, cwd),\n    \"lex\" | \"parse\" => front_command(mut console, disk, command, line, cwd),\n    _ => builtins_command(disk, line),\n  }\n}"},{"name":"run_command","kind":"fn","old":"2e6b7bd6bf2fb7c3","new":"afea3ebcf2d960e0","interface_changed":false,"affected":[],"module":"","text":"/// `strata run [PATH] [--trace] [--all-checks] [--no-verify]\n/// [--wait-for-proofs] [--verify-alongside] [--live] [-- ARGS]`: checks the\n/// program\n/// (PATH, else `--file`, else the package here), compiles it with\n/// compiler/codegen without the checks `verify` proved, and runs it in the\n/// JIT in this process, in the current folder, with ARGS. The exit code is\n/// the program's.\n/// \n/// A program changed since it was last verified starts at once with the\n/// checks not proven yet, while it is verified alongside (`run_verifying`,\n/// `start_alongside`). The proven code is swapped in while it runs, and\n/// the next run starts with it.\n/// \n/// `--live`: while it runs, an edit of its files that checks and verifies\n/// is swapped in (`start_live`, `live_edits_command`); no verifier runs\n/// alongside.\nfn run_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n  cwd: String,\n) -> std.process.ExitCode {\n  // `strata run hello.strata`: the program's path in place of --file\n  first := get(line.pos, 1) ?? \"\"\n  named := first != \"\"\n    && (ends_with(first, \".strata\")\n      || disk.exists(driver.absolute_path(cwd, first) + \"/strata.toml\"))\n  path := if named {\n    driver.absolute_path(cwd, first)\n  } else {\n    match target_of(disk, line, cwd) {\n      Ok(f) => f,\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  if !disk.exists(path) {\n    return fail_with(mut console, missing(line, path))\n  }\n  match file_problem(disk, path) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  rest := drop(line.pos, if named {\n    2\n  } else {\n    1\n  })\n  lib := std_library(mut console, mut disk, process, cache)\n  sh := shared(disk, cache)\n  // (a package's settings, each one of its values: `[json] unknown_keys`)\n  match settings_error(disk, path) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  errors := warned(mut console, file_errors(\n    mut launcher,\n    mut disk,\n    cache,\n    \"std\",\n    path,\n    false,\n    sh.core,\n    sh,\n    std_loaded(lib),\n  ))\n  if errors != [] {\n    for e in errors {\n      mut console.eprint(error_text(e))\n    }\n    return 1\n  }\n  if rest != [] {\n    return call_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n      path,\n      lib,\n      rest,\n    )\n  }\n  // the checks the last `verify` proved are left out (`--all-checks` keeps\n  // them all). With `--wait-for-proofs`, what changed is verified first, as\n  // `build` does.\n  verifying := run_verifying(line)\n  facts := if driver.given(line, \"--all-checks\") {\n    []\n  } else {\n    build_proofs(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      lib,\n      path,\n      verifying is WaitForProofs,\n    )\n  }\n  scratch := scratch_of(mut disk, cache, \"run\")\n  proofs := scratch + \"/proofs.txt\"\n  not_covered := scratch + \"/errors.txt\"\n  match mut disk.write(proofs, join(facts, \"\\n\")) {\n    _ => (),\n  }\n  // (`--trace`: std's functions are compiled with the program, so their\n  // calls are traced too; `--memory-sites`: so their sites are counted)\n  traced := driver.given(line, \"--trace\")\n    || driver.given(line, \"--memory-sites\")\n  mut loads := match lib {\n    Some(l) => if traced {\n      []\n    } else {\n      [\"--load\", l.shared]\n    },\n    None => [],\n  }\n  // the package's C (`[native]`), for its `extern c` functions: a shared\n  // library loaded too\n  native := scratch + \"/native.dylib\"\n  match deps.native_library(\n    mut launcher,\n    mut disk,\n    toolchain.c_compiler(process),\n    path,\n    native,\n  ) {\n    Ok(true) => {\n      loads += [\"--load\", native]\n    },\n    Ok(false) => (),\n    Err(e) => {\n      match mut disk.remove_all(scratch) {\n        _ => (),\n      }\n      return fail_with(mut console, e)\n    },\n  }\n  pre := match lib {\n    Some(l) => if traced {\n      []\n    } else {\n      [\"--precompiled\", l.names]\n    },\n    None => [],\n  }\n  trace := if driver.given(line, \"--trace\") {\n    [\"--trace\"]\n  } else {\n    []\n  }\n  // (`--copies`: the copies the program makes are reported when it ends;\n  // `--memory-sites`: its counting operations, by site)\n  copies := [\"--copies\", \"--memory-sites\"].filter(f -> driver.given(line, f))\n  // (a program changed since it was last verified: verified alongside, and\n  // compiled swappable)\n  if driver.given(line, \"--live\") {\n    start_live(\n      mut console,\n      mut disk,\n      process,\n      cache,\n      path,\n      cwd,\n      pre + trace + copies + assumed_flag(line),\n    )\n  } else if verifying is VerifyAlongside\n    && !driver.given(line, \"--all-checks\") {\n    start_alongside(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      path,\n      facts,\n      cwd,\n      pre + trace + copies + assumed_flag(line),\n    )\n  }\n  code := jit_file(mut disk, cache, loads\n    + [\n      \"--name\",\n      program_name_of(disk, path),\n      \"--errors\",\n      not_covered,\n      \"--dir\",\n      cwd,\n      \"--scratch\",\n      scratch,\n      \"--proofs\",\n      proofs,\n    ]\n    + pre\n    + trace\n    + copies\n    + assumed_flag(line)\n    + [path, \"--\"]\n    + line.after)\n  // (when the program ran, `jit_file` ended the process with its exit code:\n  // here, it couldn't run)\n  uncovered := match disk.read(not_covered) {\n    Ok(t) => [l for l in lines(t) where starts_with(l, \"error:\")],\n    Err(_) => [],\n  }\n  match mut disk.remove_all(scratch) {\n    _ => (),\n  }\n  if code == 3 && uncovered == [\"error: no `main` function\"] {\n    return fail_with(\n      mut console,\n      \"no `main` function to run (the entry point is `fn main` in main.strata, or in the file you run)\",\n    )\n  }\n  match main_asks(uncovered) {\n    Some(e) => if code == 3 {\n      return fail_with(mut console, e)\n    },\n    None => (),\n  }\n  if code == 3 && uncovered != [] {\n    return fail_with(\n      mut console,\n      \"compiler/codegen doesn't cover this program yet:\\n\"\n        + placed(\n          disk,\n          process,\n          path,\n          uncovered,\n          console.paint(std.term.Errors),\n        ),\n    )\n  }\n  code\n}","old_text":"/// `strata run [PATH] [--trace] [--all-checks] [--no-verify]\n/// [--wait-for-proofs] [--verify-alongside] [-- ARGS]`: checks the program\n/// (PATH, else `--file`, else the package here), compiles it with\n/// compiler/codegen without the checks `verify` proved, and runs it in the\n/// JIT in this process, in the current folder, with ARGS. The exit code is\n/// the program's.\n/// \n/// A program changed since it was last verified starts at once with the\n/// checks not proven yet, while it is verified alongside (`run_verifying`,\n/// `start_alongside`). The proven code is swapped in while it runs, and\n/// the next run starts with it.\nfn run_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n  cwd: String,\n) -> std.process.ExitCode {\n  // `strata run hello.strata`: the program's path in place of --file\n  first := get(line.pos, 1) ?? \"\"\n  named := first != \"\"\n    && (ends_with(first, \".strata\")\n      || disk.exists(driver.absolute_path(cwd, first) + \"/strata.toml\"))\n  path := if named {\n    driver.absolute_path(cwd, first)\n  } else {\n    match target_of(disk, line, cwd) {\n      Ok(f) => f,\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  if !disk.exists(path) {\n    return fail_with(mut console, missing(line, path))\n  }\n  match file_problem(disk, path) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  rest := drop(line.pos, if named {\n    2\n  } else {\n    1\n  })\n  lib := std_library(mut console, mut disk, process, cache)\n  sh := shared(disk, cache)\n  // (a package's settings, each one of its values: `[json] unknown_keys`)\n  match settings_error(disk, path) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  errors := warned(mut console, file_errors(\n    mut launcher,\n    mut disk,\n    cache,\n    \"std\",\n    path,\n    false,\n    sh.core,\n    sh,\n    std_loaded(lib),\n  ))\n  if errors != [] {\n    for e in errors {\n      mut console.eprint(error_text(e))\n    }\n    return 1\n  }\n  if rest != [] {\n    return call_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n      path,\n      lib,\n      rest,\n    )\n  }\n  // the checks the last `verify` proved are left out (`--all-checks` keeps\n  // them all). With `--wait-for-proofs`, what changed is verified first, as\n  // `build` does.\n  verifying := run_verifying(line)\n  facts := if driver.given(line, \"--all-checks\") {\n    []\n  } else {\n    build_proofs(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      lib,\n      path,\n      verifying is WaitForProofs,\n    )\n  }\n  scratch := scratch_of(mut disk, cache, \"run\")\n  proofs := scratch + \"/proofs.txt\"\n  not_covered := scratch + \"/errors.txt\"\n  match mut disk.write(proofs, join(facts, \"\\n\")) {\n    _ => (),\n  }\n  // (`--trace`: std's functions are compiled with the program, so their\n  // calls are traced too; `--memory-sites`: so their sites are counted)\n  traced := driver.given(line, \"--trace\")\n    || driver.given(line, \"--memory-sites\")\n  mut loads := match lib {\n    Some(l) => if traced {\n      []\n    } else {\n      [\"--load\", l.shared]\n    },\n    None => [],\n  }\n  // the package's C (`[native]`), for its `extern c` functions: a shared\n  // library loaded too\n  native := scratch + \"/native.dylib\"\n  match deps.native_library(\n    mut launcher,\n    mut disk,\n    toolchain.c_compiler(process),\n    path,\n    native,\n  ) {\n    Ok(true) => {\n      loads += [\"--load\", native]\n    },\n    Ok(false) => (),\n    Err(e) => {\n      match mut disk.remove_all(scratch) {\n        _ => (),\n      }\n      return fail_with(mut console, e)\n    },\n  }\n  pre := match lib {\n    Some(l) => if traced {\n      []\n    } else {\n      [\"--precompiled\", l.names]\n    },\n    None => [],\n  }\n  trace := if driver.given(line, \"--trace\") {\n    [\"--trace\"]\n  } else {\n    []\n  }\n  // (`--copies`: the copies the program makes are reported when it ends;\n  // `--memory-sites`: its counting operations, by site)\n  copies := [\"--copies\", \"--memory-sites\"].filter(f -> driver.given(line, f))\n  // (a program changed since it was last verified: verified alongside, and\n  // compiled swappable)\n  if verifying is VerifyAlongside\n    && !driver.given(line, \"--all-checks\") {\n    start_alongside(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      path,\n      facts,\n      cwd,\n      pre + trace + copies + assumed_flag(line),\n    )\n  }\n  code := jit_file(mut disk, cache, loads\n    + [\n      \"--name\",\n      program_name_of(disk, path),\n      \"--errors\",\n      not_covered,\n      \"--dir\",\n      cwd,\n      \"--scratch\",\n      scratch,\n      \"--proofs\",\n      proofs,\n    ]\n    + pre\n    + trace\n    + copies\n    + assumed_flag(line)\n    + [path, \"--\"]\n    + line.after)\n  // (when the program ran, `jit_file` ended the process with its exit code:\n  // here, it couldn't run)\n  uncovered := match disk.read(not_covered) {\n    Ok(t) => [l for l in lines(t) where starts_with(l, \"error:\")],\n    Err(_) => [],\n  }\n  match mut disk.remove_all(scratch) {\n    _ => (),\n  }\n  if code == 3 && uncovered == [\"error: no `main` function\"] {\n    return fail_with(\n      mut console,\n      \"no `main` function to run (the entry point is `fn main` in main.strata, or in the file you run)\",\n    )\n  }\n  match main_asks(uncovered) {\n    Some(e) => if code == 3 {\n      return fail_with(mut console, e)\n    },\n    None => (),\n  }\n  if code == 3 && uncovered != [] {\n    return fail_with(\n      mut console,\n      \"compiler/codegen doesn't cover this program yet:\\n\"\n        + placed(\n          disk,\n          process,\n          path,\n          uncovered,\n          console.paint(std.term.Errors),\n        ),\n    )\n  }\n  code\n}"},{"name":"live_snapshot","kind":"fn","old":null,"new":"4cf3b9177ee8c5a0","interface_changed":true,"affected":[],"module":"","text":"/// The definitions of the program at `file`, as its module files' headers\n/// list them, keyed by module and name. Reads only the headers.\nfn live_snapshot(\n  disk: std.fs.Disk,\n  file: String,\n) -> Result[Dict[String, binary.Entry], String] {\n  mut out := Dict[String, binary.Entry] {}\n  for (path, m) in source_files(disk, file) {\n    bytes := match disk.read_bytes(path) {\n      Ok(b) => b,\n      Err(_) => return Err(f\"{path} can't be read\"),\n    }\n    h := match binary.read_header(bytes) {\n      Ok(h) => h,\n      Err(e) => return Err(f\"{path} can't be read: {e}\"),\n    }\n    for e in h.entries {\n      mut out.insert(m + \" \" + e.name, e)\n    }\n  }\n  Ok(out)\n}"},{"name":"live_changes","kind":"fn","old":null,"new":"e0ca8ca4215bdda9","interface_changed":true,"affected":[],"module":"","text":"/// What a live edit changes in the running program, from its definitions\n/// `before` to `after` (`live_snapshot`): the functions and impls whose\n/// bodies changed, by name, or why the edit can't be swapped in. Only\n/// bodies change in a running program:\n/// - a function's or impl's signature (its interface hash): the running\n/// callers were compiled for the old one;\n/// - `main`: its frame lasts the whole run, so new code would never run;\n/// - a type, trait, capability or `extern`: values the running program\n/// holds were made with the old definition.\n/// Added and removed definitions, tests and imports change nothing that\n/// runs.\nfn live_changes(\n  before: Dict[String, binary.Entry],\n  after: Dict[String, binary.Entry],\n) -> Result[List[String], String] {\n  mut names := []\n  for (k, e) in items(after) {\n    match get(before, k) {\n      Some(o) => if o.code_hash != e.code_hash\n        && e.kind != \"test\"\n        && e.kind != \"use\" {\n        if e.kind == \"fn\" && (k == \" main\" || k == \"main main\") {\n          return Err(\n            \"`main` changed, and its frame lasts the whole run: run the program again for it\",\n          )\n        }\n        if e.kind != \"fn\" && e.kind != \"impl\" {\n          return Err(\n            f\"`{e.name}` changed, and the running program holds values made with the old one: run the program again for it\",\n          )\n        }\n        if o.interface_hash != e.interface_hash {\n          return Err(\n            f\"the signature of `{e.name}` changed, and its callers in the running program were compiled for the old one: run the program again for it\",\n          )\n        }\n        mut names.push(e.name)\n      },\n      None => (),\n    }\n  }\n  Ok(names)\n}"},{"name":"start_live","kind":"fn","old":null,"new":"8ac4590bdbd13bf6","interface_changed":true,"affected":[],"module":"","text":"/// Starts the watcher of live edits beside the run of the program at\n/// `path` (`strata run --live`): `strata live-edits` in a process of its\n/// own (c/jit.c's `jit_live`, which compiles the program swappable). It is\n/// told how the run compiles the program (in `cwd`, with `codegen_flags`).\n/// A note says so on stderr.\nfn start_live(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  cache: cache.Cache,\n  path: String,\n  cwd: String,\n  codegen_flags: List[String],\n) {\n  dir := scratch_of(mut disk, cache, \"live\")\n  argv := [\n      process.var(\"STRATA_EXE\") ?? cache.self_exe(),\n      \"live-edits\",\n      dir,\n      to_string(driver_pid().to_int()),\n      path,\n      \"--\",\n      \"--code-root\",\n      cwd,\n      \"--proofs\",\n      dir + \"/proofs.txt\",\n    ]\n    + codegen_flags\n    + [path]\n  if jit_live(join(argv, \"\\n\"), dir).to_int() == 0 {\n    mut console.eprint(\n      \"note: live edits: when the program's files change, and they check and verify, the changed functions are swapped in\",\n    )\n  } else {\n    match mut disk.remove_all(dir) {\n      _ => (),\n    }\n    mut console.eprint(\n      \"note: live edits can't be watched for: the program runs as it is\",\n    )\n  }\n}"},{"name":"jit_live","kind":"extern","old":null,"new":"c75facf478848793","interface_changed":true,"affected":[],"module":"","text":"/// Starts the watcher of live edits (c/jit.c). `argv` is its arguments,\n/// separated by newlines, `dir` its folder. 0 when started.\nextern c fn jit_live(argv: String, dir: String) -> I32"},{"name":"jit_live_tell","kind":"extern","old":null,"new":"24f793c77be532e0","interface_changed":true,"affected":[],"module":"","text":"/// The watcher's side (c/jit.c): tells the run `line`. 0, else 1.\nextern c fn jit_live_tell(line: String) -> I32"},{"name":"jit_live_now","kind":"extern","old":null,"new":"49594ccfcd9096c7","interface_changed":true,"affected":[],"module":"","text":"/// Nanoseconds since an arbitrary start, the same in every process\n/// (c/jit.c).\nextern c fn jit_live_now() -> I64"},{"name":"jit_live_sleep","kind":"extern","old":null,"new":"e73dbd92efdd89ac","interface_changed":true,"affected":[],"module":"","text":"/// Waits `ms` milliseconds (c/jit.c).\nextern c fn jit_live_sleep(ms: I64) -> I32"},{"name":"live_edits_command","kind":"fn","old":null,"new":"4688a3922ba69aab","interface_changed":true,"affected":[],"module":"","text":"/// `strata live-edits DIR PARENT PATH -- CODEGEN_ARGS`, started by `strata\n/// run --live` (`start_live`). Watches the module files of the program at\n/// `PATH` (their bytes, every 100 ms) while the run (process `PARENT`) goes\n/// on. A change (the same bytes twice, 30 ms apart: a file being written\n/// isn't read half-way) is a live edit, numbered from 1:\n/// 1. what changed must be bodies only (`live_changes`);\n/// 2. the program must check;\n/// 3. `verify --quiet` must find no counterexample (a check it doesn't\n/// prove stays in the code, as in any run);\n/// 4. it is compiled without the checks proven (`codegen CODEGEN_ARGS`,\n/// whose `--proofs` is DIR/proofs.txt) into DIR/live-N.ll, and the run told\n/// `swap N T` (T: when the change was seen). The run swaps it in and\n/// answers in DIR/done-N.txt.\n/// An edit refused at a step leaves the running code as it was: the run\n/// is told `refused N`, why in DIR/note-N.txt. Its output (verify's lines)\n/// is DIR/log.\nfn live_edits_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n) -> std.process.ExitCode {\n  dir := get(line.pos, 1) ?? \"\"\n  parent := parse_int(get(line.pos, 2) ?? \"\") ?? 0\n  path := get(line.pos, 3) ?? \"\"\n  if dir == \"\" || path == \"\" {\n    return fail_with(\n      mut console,\n      \"usage: strata live-edits DIR PARENT PATH -- CODEGEN_ARGS\",\n    )\n  }\n  lib := std_library(mut console, mut disk, process, cache)\n  pre := std_loaded(lib)\n  solver := toolchain.solver(disk, process)\n  has_solver := toolchain.has_solver(mut launcher, solver)\n  mut running := match live_snapshot(disk, path) {\n    Ok(s) => s,\n    Err(_) => Dict[String, binary.Entry] {},\n  }\n  mut key := verified_key(disk, path)\n  mut n := 0\n  while jit_parent_alive(parent.wrap_i64()).to_int() == 1 {\n    match jit_live_sleep(100.wrap_i64()) {\n      _ => (),\n    }\n    now := verified_key(disk, path)\n    if now != key {\n      seen := jit_live_now().to_int()\n      match jit_live_sleep(30.wrap_i64()) {\n        _ => (),\n      }\n      if verified_key(disk, path) == now {\n        key = now\n        match live_edit(\n          mut console,\n          mut disk,\n          process,\n          mut launcher,\n          cache,\n          line,\n          lib,\n          pre,\n          if has_solver {\n            solver\n          } else {\n            \"\"\n          },\n          running,\n          n + 1,\n          seen,\n        ) {\n          LiveSkipped => (),\n          LiveRefused => {\n            n += 1\n          },\n          LiveSwapped(s) => {\n            n += 1\n            running = s\n          },\n        }\n      }\n    }\n  }\n  match mut disk.remove_all(dir) {\n    _ => (),\n  }\n  0\n}"},{"name":"LiveEdit","kind":"type","old":null,"new":"e1d20609673f7872","interface_changed":true,"affected":[],"module":"","text":"/// How a live edit went (`live_edit`).\ntype LiveEdit =\n  /// Nothing the running program runs changed (a test, a comment, an\n  /// import): nothing said.\n  | LiveSkipped\n  /// Refused, the run told why: its code stays as it was.\n  | LiveRefused\n  /// Swapped in: these are the definitions now running.\n  | LiveSwapped(Dict[String, binary.Entry])"},{"name":"live_edit","kind":"fn","old":null,"new":"6c2fd5fb7f7d4537","interface_changed":true,"affected":[],"module":"","text":"/// Live edit `n` of the program (`live_edits_command`), seen at `seen`\n/// (`jit_live_now`), against the definitions running (`running`).\n/// `solver` is \"\" when there is none: nothing is proven, every check\n/// stays.\nfn live_edit(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n  lib: Option[driver.StdLibrary],\n  pre: List[String],\n  solver: String,\n  running: Dict[String, binary.Entry],\n  n: Int,\n  seen: Int,\n) -> LiveEdit {\n  dir := get(line.pos, 1) ?? \"\"\n  path := get(line.pos, 3) ?? \"\"\n  after := match live_snapshot(disk, path) {\n    Ok(s) => s,\n    Err(e) => return live_refused(mut disk, dir, n, e),\n  }\n  names := match live_changes(running, after) {\n    Ok(ns) => ns,\n    Err(e) => return live_refused(mut disk, dir, n, e),\n  }\n  if names == [] {\n    return LiveSkipped\n  }\n  sh := shared(disk, cache)\n  errors := file_errors(\n    mut launcher,\n    mut disk,\n    cache,\n    \"std\",\n    path,\n    false,\n    sh.core,\n    sh,\n    pre,\n  ).filter(\n    e -> e.0 != \"$warning\",\n  )\n  if errors != [] {\n    return live_refused(mut disk, dir, n, \"it doesn't check:\\n\"\n      + join(errors.map(e -> \"  \" + error_text(e)), \"\\n\"))\n  }\n  // (verify's line is what it adds to the log)\n  log := dir + \"/log\"\n  logged := len(lines(text_or_empty(disk, log)))\n  if solver != \"\" {\n    code := verify_file(\n      mut console,\n      mut launcher,\n      mut disk,\n      cache,\n      solver,\n      toolchain.c_compiler(process),\n      [\"--quiet\"] + std_flags(lib) + [path],\n    )\n    said := join(drop(lines(text_or_empty(disk, log)), logged), \"; \")\n    if code == 1 {\n      return live_refused(mut disk, dir, n, if said == \"\" {\n        \"verify found a counterexample (see `strata verify`)\"\n      } else {\n        \"verify found a counterexample: \" + said\n      })\n    }\n  }\n  verdict := if solver == \"\" {\n    \"no solver: every check kept\"\n  } else {\n    said := join(drop(lines(text_or_empty(disk, log)), logged), \"; \")\n    if said == \"\" {\n      \"nothing new to verify\"\n    } else {\n      said\n    }\n  }\n  facts := proofs_kept(mut disk, cache, path)\n  match mut disk.write(dir + \"/proofs.txt\", join(facts, \"\\n\")) {\n    _ => (),\n  }\n  ir := codegen_text(disk, sh, line.after)\n  if starts_with(ir, \"error\") || contains(ir, \"\\nerror: \") {\n    return live_refused(mut disk, dir, n, \"it can't be compiled: \"\n      + join(lines(ir).filter(l -> starts_with(l, \"error\")), \"; \"))\n  }\n  match mut disk.write(dir + \"/live-\" + to_string(n) + \".ll\", ir) {\n    Ok(_) => (),\n    Err(_) => return live_refused(\n      mut disk,\n      dir,\n      n,\n      \"its code can't be written to \" + dir,\n    ),\n  }\n  match mut disk.write(dir + \"/note-\" + to_string(n) + \".txt\", verdict) {\n    _ => (),\n  }\n  if jit_live_tell(\"swap \" + to_string(n) + \" \" + to_string(seen)).to_int(\n  ) != 0 {\n    return LiveRefused\n  }\n  // (the run's answer: what runs now)\n  done := dir + \"/done-\" + to_string(n) + \".txt\"\n  mut waited := 0\n  while waited < 6000 && !disk.exists(done) {\n    match jit_live_sleep(10.wrap_i64()) {\n      _ => (),\n    }\n    waited += 1\n  }\n  answer := text_or_empty(disk, done)\n  match mut disk.remove(done) {\n    _ => (),\n  }\n  if answer == \"swapped\" {\n    LiveSwapped(after)\n  } else {\n    LiveRefused\n  }\n}"},{"name":"live_refused","kind":"fn","old":null,"new":"2c4da2bf29cc6761","interface_changed":true,"affected":[],"module":"","text":"/// Live edit `n` refused (`live_edit`): the run told why.\nfn live_refused(\n  mut disk: std.fs.Disk,\n  dir: String,\n  n: Int,\n  why: String,\n) -> LiveEdit {\n  match mut disk.write(dir + \"/note-\" + to_string(n) + \".txt\", why) {\n    _ => (),\n  }\n  match jit_live_tell(\"refused \" + to_string(n)).to_int() {\n    _ => (),\n  }\n  LiveRefused\n}"},{"name":"text_or_empty","kind":"fn","old":null,"new":"a0d654e5a912ed65","interface_changed":true,"affected":[],"module":"","text":"/// The file at `path`, or \"\" when it can't be read.\nfn text_or_empty(disk: std.fs.Disk, path: String) -> String {\n  match disk.read(path) {\n    Ok(t) => t,\n    Err(_) => \"\",\n  }\n}"}]}
{"id":"5ad54ed39db8983c","time":1795710618,"message":"edit","changes":[{"name":"strata_command","kind":"fn","old":"b5eb5eab7ef80e3f","new":"ce0bbedee1994d94","interface_changed":false,"affected":[],"module":"","text":"/// The `strata` command `command`, its command line read into `line`:\n/// help, and the commands that compile, run and check programs. Exit code\n/// 2 for a mistake in the command (said on stderr), 1 when the program is\n/// rejected.\nfn strata_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  command: String,\n  line: driver.Args,\n) -> std.process.ExitCode {\n  if driver.given(line, \"--version\") || command == \"version\" {\n    print(\"strata \" + version())\n    return 0\n  }\n  if command == \"\" || command == \"help\" {\n    print(std.cli.styled_help(\n      driver.usage_text(),\n      console.paint(std.term.Output),\n    ))\n    return 0\n  }\n  // (`skill` is compiler/skill's: no home needed)\n  if command == \"skill\" {\n    rest := driver.words_without(process.args(), line.command_at)\n    return skill.skill_command(mut console, mut disk, process, rest)\n  }\n  // (`cache` works on the own cache, compiler/cache's: no home needed)\n  if command == \"cache\" {\n    return cache_command(mut console, mut disk, process, cache, line)\n  }\n  if contains([\"ui\", \"serve\", \"ast\"], command) {\n    return fail_with(\n      mut console,\n      f\"`{command}` is not part of this strata (the command written in Strata)\",\n    )\n  }\n  if !contains([\n    \"check\",\n    \"run\",\n    \"repl\",\n    \"build\",\n    \"test\",\n    \"verify\",\n    \"verify-alongside\",\n    \"live-edits\",\n    \"live-edit\",\n    \"build-core\",\n    \"lex\",\n    \"parse\",\n    \"builtins\",\n    \"find\",\n    \"refs\",\n  ], command) {\n    return fail_with(\n      mut console,\n      f\"unknown command `{command}` (try `strata help`)\",\n    )\n  }\n  // the paths given are the current folder's. The compiler reads core/,\n  // std/ and the prelude from its home, which it enters.\n  cwd := process.current_dir()\n  home := match home_found(disk, process) {\n    Some(h) => h,\n    None => return fail_with(\n      mut console,\n      \"can't find Strata's home (a folder holding core/, std/ and runtime/prelude.strata, above this executable or the current folder): set STRATA_HOME\",\n    ),\n  }\n  // programs and tests are compiled unoptimized (several times faster to\n  // compile); `--release` optimizes as clang -O2 would\n  if command == \"run\" || command == \"test\" {\n    level := if driver.given(line, \"--release\") {\n      2\n    } else {\n      0\n    }\n    match jit_set_opt(level.wrap_i32()).to_int() {\n      _ => (),\n    }\n  }\n  // (`find` and `refs` are compiler/finding's)\n  if command == \"find\" || command == \"refs\" {\n    rest := driver.words_without(process.args(), line.command_at)\n    return if command == \"find\" {\n      finding.find_command(mut console, disk, process, rest)\n    } else {\n      finding.refs_command(mut console, disk, process, rest)\n    }\n  }\n  // `--profile`: every function compiled keeps its frame pointer, for\n  // `sample` (compiler/toolchain's `profiling`)\n  if driver.given(line, \"--profile\") {\n    toolchain.set_profile()\n  }\n  // `--timings`: each phase's time, on stderr when the command ends\n  // (compiler/timings)\n  if driver.given(line, \"--timings\") {\n    timings.enable()\n  }\n  if driver_chdir(home).to_int() != 0 {\n    return fail_with(mut console, f\"can't enter {home}\")\n  }\n  match command {\n    \"check\" => check_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    \"repl\" => repl_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      clock,\n      cache,\n      line,\n      cwd,\n    ),\n    \"run\" => run_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    \"build\" => build_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n      home,\n    ),\n    \"test\" => test_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    \"verify\" => verify_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    // (started by `live-edits`, once an edit)\n    \"live-edit\" => live_edit_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n    ),\n    // (started by `run --live`: `start_live`)\n    \"live-edits\" => live_edits_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n    ),\n    // (started by `run`: `start_alongside`)\n    \"verify-alongside\" => alongside_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n    ),\n    \"build-core\" => build_core_command(mut console, mut disk, line, cwd),\n    \"lex\" | \"parse\" => front_command(mut console, disk, command, line, cwd),\n    _ => builtins_command(disk, line),\n  }\n}","old_text":"/// The `strata` command `command`, its command line read into `line`:\n/// help, and the commands that compile, run and check programs. Exit code\n/// 2 for a mistake in the command (said on stderr), 1 when the program is\n/// rejected.\nfn strata_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  command: String,\n  line: driver.Args,\n) -> std.process.ExitCode {\n  if driver.given(line, \"--version\") || command == \"version\" {\n    print(\"strata \" + version())\n    return 0\n  }\n  if command == \"\" || command == \"help\" {\n    print(std.cli.styled_help(\n      driver.usage_text(),\n      console.paint(std.term.Output),\n    ))\n    return 0\n  }\n  // (`skill` is compiler/skill's: no home needed)\n  if command == \"skill\" {\n    rest := driver.words_without(process.args(), line.command_at)\n    return skill.skill_command(mut console, mut disk, process, rest)\n  }\n  // (`cache` works on the own cache, compiler/cache's: no home needed)\n  if command == \"cache\" {\n    return cache_command(mut console, mut disk, process, cache, line)\n  }\n  if contains([\"ui\", \"serve\", \"ast\"], command) {\n    return fail_with(\n      mut console,\n      f\"`{command}` is not part of this strata (the command written in Strata)\",\n    )\n  }\n  if !contains([\n    \"check\",\n    \"run\",\n    \"repl\",\n    \"build\",\n    \"test\",\n    \"verify\",\n    \"verify-alongside\",\n    \"live-edits\",\n    \"build-core\",\n    \"lex\",\n    \"parse\",\n    \"builtins\",\n    \"find\",\n    \"refs\",\n  ], command) {\n    return fail_with(\n      mut console,\n      f\"unknown command `{command}` (try `strata help`)\",\n    )\n  }\n  // the paths given are the current folder's. The compiler reads core/,\n  // std/ and the prelude from its home, which it enters.\n  cwd := process.current_dir()\n  home := match home_found(disk, process) {\n    Some(h) => h,\n    None => return fail_with(\n      mut console,\n      \"can't find Strata's home (a folder holding core/, std/ and runtime/prelude.strata, above this executable or the current folder): set STRATA_HOME\",\n    ),\n  }\n  // programs and tests are compiled unoptimized (several times faster to\n  // compile); `--release` optimizes as clang -O2 would\n  if command == \"run\" || command == \"test\" {\n    level := if driver.given(line, \"--release\") {\n      2\n    } else {\n      0\n    }\n    match jit_set_opt(level.wrap_i32()).to_int() {\n      _ => (),\n    }\n  }\n  // (`find` and `refs` are compiler/finding's)\n  if command == \"find\" || command == \"refs\" {\n    rest := driver.words_without(process.args(), line.command_at)\n    return if command == \"find\" {\n      finding.find_command(mut console, disk, process, rest)\n    } else {\n      finding.refs_command(mut console, disk, process, rest)\n    }\n  }\n  // `--profile`: every function compiled keeps its frame pointer, for\n  // `sample` (compiler/toolchain's `profiling`)\n  if driver.given(line, \"--profile\") {\n    toolchain.set_profile()\n  }\n  // `--timings`: each phase's time, on stderr when the command ends\n  // (compiler/timings)\n  if driver.given(line, \"--timings\") {\n    timings.enable()\n  }\n  if driver_chdir(home).to_int() != 0 {\n    return fail_with(mut console, f\"can't enter {home}\")\n  }\n  match command {\n    \"check\" => check_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    \"repl\" => repl_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      clock,\n      cache,\n      line,\n      cwd,\n    ),\n    \"run\" => run_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    \"build\" => build_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n      home,\n    ),\n    \"test\" => test_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    \"verify\" => verify_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n      cwd,\n    ),\n    // (started by `run --live`: `start_live`)\n    \"live-edits\" => live_edits_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n    ),\n    // (started by `run`: `start_alongside`)\n    \"verify-alongside\" => alongside_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      cache,\n      line,\n    ),\n    \"build-core\" => build_core_command(mut console, mut disk, line, cwd),\n    \"lex\" | \"parse\" => front_command(mut console, disk, command, line, cwd),\n    _ => builtins_command(disk, line),\n  }\n}"},{"name":"live_edits_command","kind":"fn","old":"4688a3922ba69aab","new":"196a8a86f4b933c8","interface_changed":true,"affected":["strata_command","command_line","main","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","live_edit_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","tour_graph","linked","expanded","comptime_runner","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","diff_command","tour_command","with_base","rename_command","move_command","fix_command","edit_in_editor"],"module":"","text":"/// `strata live-edits DIR PARENT PATH -- CODEGEN_ARGS`, started by `strata\n/// run --live` (`start_live`). Watches the module files of the program at\n/// `PATH` (their bytes, every 100 ms) while the run (process `PARENT`) goes\n/// on. A change (the same bytes twice, 30 ms apart: a file being written\n/// isn't read half-way) is a live edit, numbered from 1:\n/// 1. what changed must be bodies only (`live_changes`);\n/// 2. the program must check, and `verify --quiet` find no counterexample\n/// (a check it doesn't prove stays in the code, as in any run); then it is\n/// compiled without the checks proven, into DIR/live-N.ll\n/// (`live_edit_command`, a process of its own: nothing of an earlier\n/// edit's is left in it);\n/// 3. the run is told `swap N T` (T: when the change was seen), why in\n/// DIR/note-N.txt (the functions changed, a tab, verify's line). It swaps\n/// the code in and answers in DIR/done-N.txt.\n/// An edit refused at a step leaves the running code as it was: the run\n/// is told `refused N`, why in DIR/note-N.txt. Its output (verify's lines)\n/// is DIR/log.\nfn live_edits_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  _cache: cache.Cache,\n  line: driver.Args,\n) -> std.process.ExitCode {\n  dir := get(line.pos, 1) ?? \"\"\n  parent := parse_int(get(line.pos, 2) ?? \"\") ?? 0\n  path := get(line.pos, 3) ?? \"\"\n  if dir == \"\" || path == \"\" {\n    return fail_with(\n      mut console,\n      \"usage: strata live-edits DIR PARENT PATH -- CODEGEN_ARGS\",\n    )\n  }\n  mut running := match live_snapshot(disk, path) {\n    Ok(s) => s,\n    Err(_) => Dict[String, binary.Entry] {},\n  }\n  mut key := verified_key(disk, path)\n  mut n := 0\n  while jit_parent_alive(parent.wrap_i64()).to_int() == 1 {\n    match jit_live_sleep(100.wrap_i64()) {\n      _ => (),\n    }\n    now := verified_key(disk, path)\n    if now != key {\n      seen := jit_live_now().to_int()\n      match jit_live_sleep(30.wrap_i64()) {\n        _ => (),\n      }\n      if verified_key(disk, path) == now {\n        key = now\n        match live_edit(\n          mut disk,\n          process,\n          mut launcher,\n          line,\n          running,\n          n + 1,\n          seen,\n        ) {\n          LiveSkipped => (),\n          LiveRefused => {\n            n += 1\n          },\n          LiveSwapped(s) => {\n            n += 1\n            running = s\n          },\n        }\n      }\n    }\n  }\n  match mut disk.remove_all(dir) {\n    _ => (),\n  }\n  0\n}","old_text":"/// `strata live-edits DIR PARENT PATH -- CODEGEN_ARGS`, started by `strata\n/// run --live` (`start_live`). Watches the module files of the program at\n/// `PATH` (their bytes, every 100 ms) while the run (process `PARENT`) goes\n/// on. A change (the same bytes twice, 30 ms apart: a file being written\n/// isn't read half-way) is a live edit, numbered from 1:\n/// 1. what changed must be bodies only (`live_changes`);\n/// 2. the program must check;\n/// 3. `verify --quiet` must find no counterexample (a check it doesn't\n/// prove stays in the code, as in any run);\n/// 4. it is compiled without the checks proven (`codegen CODEGEN_ARGS`,\n/// whose `--proofs` is DIR/proofs.txt) into DIR/live-N.ll, and the run told\n/// `swap N T` (T: when the change was seen). The run swaps it in and\n/// answers in DIR/done-N.txt.\n/// An edit refused at a step leaves the running code as it was: the run\n/// is told `refused N`, why in DIR/note-N.txt. Its output (verify's lines)\n/// is DIR/log.\nfn live_edits_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n) -> std.process.ExitCode {\n  dir := get(line.pos, 1) ?? \"\"\n  parent := parse_int(get(line.pos, 2) ?? \"\") ?? 0\n  path := get(line.pos, 3) ?? \"\"\n  if dir == \"\" || path == \"\" {\n    return fail_with(\n      mut console,\n      \"usage: strata live-edits DIR PARENT PATH -- CODEGEN_ARGS\",\n    )\n  }\n  lib := std_library(mut console, mut disk, process, cache)\n  pre := std_loaded(lib)\n  solver := toolchain.solver(disk, process)\n  has_solver := toolchain.has_solver(mut launcher, solver)\n  mut running := match live_snapshot(disk, path) {\n    Ok(s) => s,\n    Err(_) => Dict[String, binary.Entry] {},\n  }\n  mut key := verified_key(disk, path)\n  mut n := 0\n  while jit_parent_alive(parent.wrap_i64()).to_int() == 1 {\n    match jit_live_sleep(100.wrap_i64()) {\n      _ => (),\n    }\n    now := verified_key(disk, path)\n    if now != key {\n      seen := jit_live_now().to_int()\n      match jit_live_sleep(30.wrap_i64()) {\n        _ => (),\n      }\n      if verified_key(disk, path) == now {\n        key = now\n        match live_edit(\n          mut console,\n          mut disk,\n          process,\n          mut launcher,\n          cache,\n          line,\n          lib,\n          pre,\n          if has_solver {\n            solver\n          } else {\n            \"\"\n          },\n          running,\n          n + 1,\n          seen,\n        ) {\n          LiveSkipped => (),\n          LiveRefused => {\n            n += 1\n          },\n          LiveSwapped(s) => {\n            n += 1\n            running = s\n          },\n        }\n      }\n    }\n  }\n  match mut disk.remove_all(dir) {\n    _ => (),\n  }\n  0\n}"},{"name":"live_edit","kind":"fn","old":"6c2fd5fb7f7d4537","new":"d70f36b801810886","interface_changed":true,"affected":["live_edits_command","strata_command","command_line","main","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","live_edit_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","tour_graph","linked","expanded","comptime_runner","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","diff_command","tour_command","with_base","rename_command","move_command","fix_command","edit_in_editor"],"module":"","text":"/// Live edit `n` of the program (`live_edits_command`), seen at `seen`\n/// (`jit_live_now`), against the definitions running (`running`). What it\n/// changed is checked here (`live_changes`); checking, verifying and\n/// compiling it are `strata live-edit`'s, a process of its own each time\n/// (`live_edit_command`).\nfn live_edit(\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  line: driver.Args,\n  running: Dict[String, binary.Entry],\n  n: Int,\n  seen: Int,\n) -> LiveEdit {\n  dir := get(line.pos, 1) ?? \"\"\n  path := get(line.pos, 3) ?? \"\"\n  after := match live_snapshot(disk, path) {\n    Ok(s) => s,\n    Err(e) => return live_refused(mut disk, dir, n, e),\n  }\n  names := match live_changes(running, after) {\n    Ok(ns) => ns,\n    Err(e) => return live_refused(mut disk, dir, n, e),\n  }\n  if names == [] {\n    return LiveSkipped\n  }\n  ran := mut launcher.run(\n    process.var(\"STRATA_EXE\") ?? cache.self_exe(),\n    [\"live-edit\", dir, to_string(n), path, \"--\"] + line.after,\n    \"\",\n  )\n  (code, said) := match ran {\n    Ok(f) => (f.code, lines(f.out + f.err).filter(\n      l -> l != \"\" && !starts_with(l, \"warning: \"),\n    )),\n    Err(e) => (2, [e]),\n  }\n  written := text_or_empty(disk, dir + \"/note-\" + to_string(n) + \".txt\")\n  changed := join(names.map(x -> \"`\" + x + \"`\"), \", \")\n  if code != 0 {\n    why := if written == \"\" {\n      join(said, \"\\n\")\n    } else if said == [] {\n      written\n    } else {\n      written + \": \" + join(said, \"; \")\n    }\n    return live_refused(mut disk, dir, n, why)\n  }\n  match mut disk.write(\n    dir + \"/note-\" + to_string(n) + \".txt\",\n    changed\n      + \"\\t\"\n      + if said == [] {\n        \"nothing new to verify\"\n      } else {\n        join(said, \"; \")\n      },\n  ) {\n    _ => (),\n  }\n  if jit_live_tell(\"swap \" + to_string(n) + \" \" + to_string(seen)).to_int(\n  ) != 0 {\n    return LiveRefused\n  }\n  // (the run's answer: what runs now)\n  done := dir + \"/done-\" + to_string(n) + \".txt\"\n  mut waited := 0\n  while waited < 6000 && !disk.exists(done) {\n    match jit_live_sleep(10.wrap_i64()) {\n      _ => (),\n    }\n    waited += 1\n  }\n  answer := text_or_empty(disk, done)\n  match mut disk.remove(done) {\n    _ => (),\n  }\n  if answer == \"swapped\" {\n    LiveSwapped(after)\n  } else {\n    LiveRefused\n  }\n}","old_text":"/// Live edit `n` of the program (`live_edits_command`), seen at `seen`\n/// (`jit_live_now`), against the definitions running (`running`).\n/// `solver` is \"\" when there is none: nothing is proven, every check\n/// stays.\nfn live_edit(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n  lib: Option[driver.StdLibrary],\n  pre: List[String],\n  solver: String,\n  running: Dict[String, binary.Entry],\n  n: Int,\n  seen: Int,\n) -> LiveEdit {\n  dir := get(line.pos, 1) ?? \"\"\n  path := get(line.pos, 3) ?? \"\"\n  after := match live_snapshot(disk, path) {\n    Ok(s) => s,\n    Err(e) => return live_refused(mut disk, dir, n, e),\n  }\n  names := match live_changes(running, after) {\n    Ok(ns) => ns,\n    Err(e) => return live_refused(mut disk, dir, n, e),\n  }\n  if names == [] {\n    return LiveSkipped\n  }\n  sh := shared(disk, cache)\n  errors := file_errors(\n    mut launcher,\n    mut disk,\n    cache,\n    \"std\",\n    path,\n    false,\n    sh.core,\n    sh,\n    pre,\n  ).filter(\n    e -> e.0 != \"$warning\",\n  )\n  if errors != [] {\n    return live_refused(mut disk, dir, n, \"it doesn't check:\\n\"\n      + join(errors.map(e -> \"  \" + error_text(e)), \"\\n\"))\n  }\n  // (verify's line is what it adds to the log)\n  log := dir + \"/log\"\n  logged := len(lines(text_or_empty(disk, log)))\n  if solver != \"\" {\n    code := verify_file(\n      mut console,\n      mut launcher,\n      mut disk,\n      cache,\n      solver,\n      toolchain.c_compiler(process),\n      [\"--quiet\"] + std_flags(lib) + [path],\n    )\n    said := join(drop(lines(text_or_empty(disk, log)), logged), \"; \")\n    if code == 1 {\n      return live_refused(mut disk, dir, n, if said == \"\" {\n        \"verify found a counterexample (see `strata verify`)\"\n      } else {\n        \"verify found a counterexample: \" + said\n      })\n    }\n  }\n  verdict := if solver == \"\" {\n    \"no solver: every check kept\"\n  } else {\n    said := join(drop(lines(text_or_empty(disk, log)), logged), \"; \")\n    if said == \"\" {\n      \"nothing new to verify\"\n    } else {\n      said\n    }\n  }\n  facts := proofs_kept(mut disk, cache, path)\n  match mut disk.write(dir + \"/proofs.txt\", join(facts, \"\\n\")) {\n    _ => (),\n  }\n  ir := codegen_text(disk, sh, line.after)\n  if starts_with(ir, \"error\") || contains(ir, \"\\nerror: \") {\n    return live_refused(mut disk, dir, n, \"it can't be compiled: \"\n      + join(lines(ir).filter(l -> starts_with(l, \"error\")), \"; \"))\n  }\n  match mut disk.write(dir + \"/live-\" + to_string(n) + \".ll\", ir) {\n    Ok(_) => (),\n    Err(_) => return live_refused(\n      mut disk,\n      dir,\n      n,\n      \"its code can't be written to \" + dir,\n    ),\n  }\n  match mut disk.write(dir + \"/note-\" + to_string(n) + \".txt\", verdict) {\n    _ => (),\n  }\n  if jit_live_tell(\"swap \" + to_string(n) + \" \" + to_string(seen)).to_int(\n  ) != 0 {\n    return LiveRefused\n  }\n  // (the run's answer: what runs now)\n  done := dir + \"/done-\" + to_string(n) + \".txt\"\n  mut waited := 0\n  while waited < 6000 && !disk.exists(done) {\n    match jit_live_sleep(10.wrap_i64()) {\n      _ => (),\n    }\n    waited += 1\n  }\n  answer := text_or_empty(disk, done)\n  match mut disk.remove(done) {\n    _ => (),\n  }\n  if answer == \"swapped\" {\n    LiveSwapped(after)\n  } else {\n    LiveRefused\n  }\n}"},{"name":"live_edit_command","kind":"fn","old":null,"new":"9d72c60493f8b379","interface_changed":true,"affected":[],"module":"","text":"/// `strata live-edit DIR N PATH -- CODEGEN_ARGS`, started by `strata\n/// live-edits` for its edit `N` (`live_edit`): checks the program at\n/// `PATH`, verifies it (`verify --quiet`, its lines on stdout and stderr),\n/// and compiles it without the checks proven (`codegen CODEGEN_ARGS`,\n/// whose `--proofs` is DIR/proofs.txt) into DIR/live-N.ll. Exit 0 when\n/// compiled; 1 when refused, why in DIR/note-N.txt (the program doesn't\n/// check, verify found a counterexample, or it can't be compiled). Without\n/// a solver nothing is proven: every check stays.\nfn live_edit_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  cache: cache.Cache,\n  line: driver.Args,\n) -> std.process.ExitCode {\n  dir := get(line.pos, 1) ?? \"\"\n  n := get(line.pos, 2) ?? \"\"\n  path := get(line.pos, 3) ?? \"\"\n  if dir == \"\" || n == \"\" || path == \"\" {\n    return fail_with(\n      mut console,\n      \"usage: strata live-edit DIR N PATH -- CODEGEN_ARGS\",\n    )\n  }\n  note := dir + \"/note-\" + n + \".txt\"\n  lib := std_library(mut console, mut disk, process, cache)\n  sh := shared(disk, cache)\n  errors := file_errors(\n    mut launcher,\n    mut disk,\n    cache,\n    \"std\",\n    path,\n    false,\n    sh.core,\n    sh,\n    std_loaded(lib),\n  ).filter(\n    e -> e.0 != \"$warning\",\n  )\n  if errors != [] {\n    match mut disk.write(\n      note,\n      \"it doesn't check:\\n\"\n        + join(errors.map(e -> \"  \" + error_text(e)), \"\\n\"),\n    ) {\n      _ => (),\n    }\n    return 1\n  }\n  solver := toolchain.solver(disk, process)\n  if toolchain.has_solver(mut launcher, solver) {\n    code := verify_file(\n      mut console,\n      mut launcher,\n      mut disk,\n      cache,\n      solver,\n      toolchain.c_compiler(process),\n      [\"--quiet\"] + std_flags(lib) + [path],\n    )\n    if code == 1 {\n      match mut disk.write(note, \"verify found a counterexample\") {\n        _ => (),\n      }\n      return 1\n    }\n  } else {\n    mut console.eprint(\"no SMT solver: every check kept\")\n  }\n  facts := proofs_kept(mut disk, cache, path)\n  match mut disk.write(dir + \"/proofs.txt\", join(facts, \"\\n\")) {\n    _ => (),\n  }\n  ir := codegen_text(disk, sh, line.after)\n  if starts_with(ir, \"error\") || contains(ir, \"\\nerror: \") {\n    match mut disk.write(\n      note,\n      \"it can't be compiled: \"\n        + join(lines(ir).filter(l -> starts_with(l, \"error\")), \"; \"),\n    ) {\n      _ => (),\n    }\n    return 1\n  }\n  match mut disk.write(dir + \"/live-\" + n + \".ll\", ir) {\n    Ok(_) => 0,\n    Err(_) => {\n      match mut disk.write(note, \"its code can't be written to \" + dir) {\n        _ => (),\n      }\n      1\n    },\n  }\n}"}]}
