e","codegen.for_loop","codegen.operands","codegen.wanted","codegen.table_find","codegen.after_builtin","codegen.cmp_helper","codegen.table_fns","codegen.try_expr","codegen.tail_share","codegen_with","core_rt_text","computed_value","repl_eval","codegen.matches","codegen.conversion","codegen.debug_fields","codegen.fail_unless","codegen.check_requires","codegen.check_ensures","codegen.index_check","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.list_slice","codegen.assertion","codegen.invariants","codegen.check_payload","codegen.check_field","codegen.decreases_pass","codegen.decreases_call","codegen.expr_want","codegen.matching","codegen.generated","codegen.can_generate","codegen.dyn_equal","codegen.method_value","codegen.loop_body","codegen.with_it","codegen.branch_value","codegen.tag_test","codegen.compared","codegen.expr_on_stack","codegen.assigned_call","codegen.decreases_start","codegen.decreases_entry","codegen.tag_is","codegen.satisfies","codegen.check_union","codegen.dyn_table_is","codegen.mock_table","codegen.raw_call","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.check_member","codegen.has_field_check","codegen.eq_body","codegen.makers","codegen.holds_pred","codegen.get_field","codegen.to_c","codegen.dyn_ctor_is","codegen.as_type","codegen.word_op","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"// ---- reference counting ----\n//\n// Conventions:\n// - A function borrows its arguments and returns a value its caller owns.\n// - Reading a variable or a field borrows.\n// - Storing a value (in a variable, a field, the result) holds it once\n//   more, unless it is a temporary of the innermost scope, which moves.\n// - A scope drops its temporaries and owned variables when it ends.\n//   `return`, `break` and `continue` drop what they leave.\n// - Each statement, branch and loop iteration is a scope, so a temporary\n//   is dropped in code its definition dominates.\n\n/// Whether values of the type are counted objects (an `Int` is when big).\nfn counted(t: check.Ty) -> Bool {\n  if codegen.sized(t) is Some {\n    return false\n  }\n  match t {\n    // a task handle: its scope holds the task and frees it\n    check.TNamed { name: \"Task\", .. } => false,\n    // a C handle: C frees it\n    check.TNamed { name, .. } => !starts_with(name, \"extern:\"),\n    check.TInt | check.TStr | check.TNamed { .. } | check.TList(_) | check.TFn { .. } | check.TTrait(_) | check.TUnion(_) => true,\n    _ => false,\n  }\n}","old_text":"// ---- reference counting ----\n//\n// Conventions:\n// - A function borrows its arguments and returns a value its caller owns.\n// - Reading a variable or a field borrows.\n// - Storing a value (in a variable, a field, the result) holds it once\n//   more, unless it is a temporary of the innermost scope, which moves.\n// - A scope drops its temporaries and owned variables when it ends.\n//   `return`, `break` and `continue` drop what they leave.\n// - Each statement, branch and loop iteration is a scope, so a temporary\n//   is dropped in code its definition dominates.\n\n/// Whether values of the type are counted objects (an `Int` is when big).\nfn counted(t: Ty) -> Bool {\n  if codegen.sized(t) is Some {\n    return false\n  }\n  match t {\n    // a task handle: its scope holds the task and frees it\n    TNamed { name: \"Task\", .. } => false,\n    // a C handle: C frees it\n    TNamed { name, .. } => !starts_with(name, \"extern:\"),\n    TInt | TStr | TNamed { .. } | TList(_) | TFn { .. } | TTrait(_) | TUnion(_) => true,\n    _ => false,\n  }\n}"},{"name":"codegen.leave_branch","kind":"fn","old":"d7f1a1eb2a31e3ab","new":"b4b7c73d737eb395","interface_changed":false,"affected":[],"module":"codegen","text":"/// A branch's value (an `if`'s, an arm's) taken out of its scope for the\n/// joining `phi`: held, then the scope ends. A variable of that scope, its\n/// only owner, moves out.\nfn leave_branch(mut g: codegen.Gen, v: codegen.V) -> codegen.V {\n  x := if v.ty is check.TAny {\n    v\n  } else if codegen.counted(v.ty)\n    && !codegen.constant(v.op)\n    && !codegen.is_temp(g, v.op) {\n    s := get(g.scopes, len(g.scopes) - 1) ?? codegen.no_scope()\n    match codegen.sole_owner(g, v.op) {\n      Some(slot) => if s.owned.any(l -> l.slot == slot) {\n        g.moved = slot\n        v\n      } else {\n        codegen.take_value(mut g, v)\n      },\n      None => codegen.take_value(mut g, v),\n    }\n  } else {\n    codegen.take_value(mut g, v)\n  }\n  codegen.pop_scope(mut g)\n  g.moved = \"\"\n  x\n}","old_text":"/// A branch's value (an `if`'s, an arm's) taken out of its scope for the\n/// joining `phi`: held, then the scope ends. A variable of that scope, its\n/// only owner, moves out.\nfn leave_branch(mut g: codegen.Gen, v: codegen.V) -> codegen.V {\n  x := if v.ty is TAny {\n    v\n  } else if codegen.counted(v.ty)\n    && !codegen.constant(v.op)\n    && !codegen.is_temp(g, v.op) {\n    s := get(g.scopes, len(g.scopes) - 1) ?? codegen.no_scope()\n    match codegen.sole_owner(g, v.op) {\n      Some(slot) => if s.owned.any(l -> l.slot == slot) {\n        g.moved = slot\n        v\n      } else {\n        codegen.take_value(mut g, v)\n      },\n      None => codegen.take_value(mut g, v),\n    }\n  } else {\n    codegen.take_value(mut g, v)\n  }\n  codegen.pop_scope(mut g)\n  g.moved = \"\"\n  x\n}"},{"name":"codegen.dup_value","kind":"fn","old":"85a1093a983f4da7","new":"5dbc74b0e1bc56ac","interface_changed":false,"affected":[],"module":"codegen","text":"/// One more holder of `v`.\nfn dup_value(mut g: codegen.Gen, v: codegen.V) {\n  codegen.use_counts(mut g)\n  if v.ty is check.TInt {\n    codegen.emit(mut g, f\"call void @strata.int_dup(i64 {v.op})\")\n  } else {\n    codegen.emit(mut g, f\"call void @strata.dup(ptr {v.op})\")\n  }\n}","old_text":"/// One more holder of `v`.\nfn dup_value(mut g: codegen.Gen, v: codegen.V) {\n  codegen.use_counts(mut g)\n  if v.ty is TInt {\n    codegen.emit(mut g, f\"call void @strata.int_dup(i64 {v.op})\")\n  } else {\n    codegen.emit(mut g, f\"call void @strata.dup(ptr {v.op})\")\n  }\n}"},{"name":"codegen.drop_value","kind":"fn","old":"b35b23e2f8e3321d","new":"71d14dcb5aa1d9f7","interface_changed":false,"affected":[],"module":"codegen","text":"/// One fewer holder of `v`. The last one frees it and drops what it holds.\nfn drop_value(mut g: codegen.Gen, v: codegen.V) {\n  if !codegen.counted(v.ty) || codegen.constant(v.op) {\n    return\n  }\n  if codegen.is_collection(v.ty) {\n    return codegen.drop_value(\n      mut g,\n      codegen.V { ..v, ty: codegen.repr(v.ty) },\n    )\n  }\n  match v.ty {\n    check.TUnion(_) => {\n      f := codegen.union_drop(mut g, v.ty)\n      codegen.use_counts(mut g)\n      codegen.emit(mut g, f\"call void {f}(ptr {v.op})\")\n      return\n    },\n    _ => (),\n  }\n  codegen.use_counts(mut g)\n  if v.ty is check.TInt {\n    codegen.emit(mut g, f\"call void @strata.int_drop(i64 {v.op})\")\n  } else {\n    f := codegen.drop_fn(mut g, v.ty)\n    codegen.emit(mut g, f\"call void {f}(ptr {v.op})\")\n  }\n}","old_text":"/// One fewer holder of `v`. The last one frees it and drops what it holds.\nfn drop_value(mut g: codegen.Gen, v: codegen.V) {\n  if !codegen.counted(v.ty) || codegen.constant(v.op) {\n    return\n  }\n  if codegen.is_collection(v.ty) {\n    return codegen.drop_value(\n      mut g,\n      codegen.V { ..v, ty: codegen.repr(v.ty) },\n    )\n  }\n  match v.ty {\n    TUnion(_) => {\n      f := codegen.union_drop(mut g, v.ty)\n      codegen.use_counts(mut g)\n      codegen.emit(mut g, f\"call void {f}(ptr {v.op})\")\n      return\n    },\n    _ => (),\n  }\n  codegen.use_counts(mut g)\n  if v.ty is TInt {\n    codegen.emit(mut g, f\"call void @strata.int_drop(i64 {v.op})\")\n  } else {\n    f := codegen.drop_fn(mut g, v.ty)\n    codegen.emit(mut g, f\"call void {f}(ptr {v.op})\")\n  }\n}"},{"name":"codegen.drop_scope","kind":"fn","old":"e30dbddf8f7500e7","new":"319cabd6d56dc157","interface_changed":false,"affected":[],"module":"codegen","text":"/// Drops what a scope holds: its temporaries except `keep`, then its owned\n/// variables' values.\nfn drop_scope(mut g: codegen.Gen, s: codegen.Scope, keep: String) {\n  if s.tasks != \"\" {\n    // every task of the scope finishes before it does\n    codegen.emit(\n      mut g,\n      f\"call void @strata_scope_end(ptr {s.tasks})\",\n    )\n  }\n  mut k := len(s.temps) - 1\n  while k >= 0 {\n    t := get(s.temps, k) ?? codegen.unit()\n    if t.op != keep {\n      if g.memory_sites {\n        codegen.root_drop(mut g, get(g.temp_codes, t.op) ?? 14)\n      }\n      match get(s.stacked, t.op) {\n        Some(tys) => codegen.drop_stacked(mut g, t, tys),\n        None => codegen.drop_held(mut g, t),\n      }\n    }\n    k -= 1\n  }\n  k = len(s.owned) - 1\n  while k >= 0 {\n    l := get(s.owned, k) ?? codegen.Local { slot: \"\", ty: check.TUnit }\n    // except the variable whose value leaves (`leave_with`)\n    if l.slot != g.moved {\n      if g.memory_sites {\n        codegen.root_drop(mut g, codegen.var_code(g, s, l.slot))\n      }\n      x := codegen.load(mut g, l)\n      match get(s.stacked, l.slot) {\n        Some(tys) => codegen.drop_stacked(mut g, x, tys),\n        None => codegen.drop_value(mut g, x),\n      }\n    }\n    k -= 1\n  }\n}","old_text":"/// Drops what a scope holds: its temporaries except `keep`, then its owned\n/// variables' values.\nfn drop_scope(mut g: codegen.Gen, s: codegen.Scope, keep: String) {\n  if s.tasks != \"\" {\n    // every task of the scope finishes before it does\n    codegen.emit(\n      mut g,\n      f\"call void @strata_scope_end(ptr {s.tasks})\",\n    )\n  }\n  mut k := len(s.temps) - 1\n  while k >= 0 {\n    t := get(s.temps, k) ?? codegen.unit()\n    if t.op != keep {\n      if g.memory_sites {\n        codegen.root_drop(mut g, get(g.temp_codes, t.op) ?? 14)\n      }\n      match get(s.stacked, t.op) {\n        Some(tys) => codegen.drop_stacked(mut g, t, tys),\n        None => codegen.drop_held(mut g, t),\n      }\n    }\n    k -= 1\n  }\n  k = len(s.owned) - 1\n  while k >= 0 {\n    l := get(s.owned, k) ?? codegen.Local { slot: \"\", ty: TUnit }\n    // except the variable whose value leaves (`leave_with`)\n    if l.slot != g.moved {\n      if g.memory_sites {\n        codegen.root_drop(mut g, codegen.var_code(g, s, l.slot))\n      }\n      x := codegen.load(mut g, l)\n      match get(s.stacked, l.slot) {\n        Some(tys) => codegen.drop_stacked(mut g, x, tys),\n        None => codegen.drop_value(mut g, x),\n      }\n    }\n    k -= 1\n  }\n}"},{"name":"codegen.drop_fn","kind":"fn","old":"43d5f654b551326d","new":"2362d965033fcb35","interface_changed":true,"affected":["codegen.drop_value","codegen.tail_drop","codegen.function","codegen.drop_scope","codegen.drop_fields","codegen.debug_list","codegen.drop_list","codegen.closure","codegen.collection_builtin","codegen.call_fn_want","codegen.builtin_call","codegen.dyn_wrapper","codegen.set_path","codegen.replace_var","codegen.union_drop","codegen.task_fns","codegen.await_list","codegen.slot_drop_fn","codegen.select_expr","codegen.foreign_call","codegen.tries