\"Percentage\") {\n        ast.Named { name: \"Float\", args: [] }\n      } else if len(args) == 0 && name == \"NonEmptyString\" {\n        ast.Named { name: \"String\", args: [] }\n      } else if name == \"NonEmpty\" && len(args) == 1 {\n        ast.Named { name: \"List\", args }\n      } else {\n        t\n      },\n    },\n    _ => t,\n  }\n}","old_text":"fn base_in(x: derive.X, t: ast.TypeExpr, depth: Int) -> ast.TypeExpr {\n  if depth > 50 {\n    return t\n  }\n  match t {\n    ast.Refined { base: b, .. } => derive.base_in(x, b, depth + 1),\n    ast.Named { name, args } => match get(x.ix.types, name) {\n      Some(td) => if td.distinct {\n        t\n      } else {\n        match td.body {\n          ast.Alias(a) => derive.base_in(\n            x,\n            derive.subst(a, derive.pairs(td.params, args)),\n            depth + 1,\n          ),\n          _ => t,\n        }\n      },\n      // core's refined types, when core isn't among the definitions seen\n      None => if len(args) == 0\n        && [\"Natural\", \"Positive\", \"Negative\", \"NonZero\"].any(\n          n -> n == name,\n        ) {\n        ast.Named { name: \"Int\", args: [] }\n      } else if len(args) == 0\n        && (name == \"Probability\" || name == \"Percentage\") {\n        ast.Named { name: \"Float\", args: [] }\n      } else if len(args) == 0 && name == \"NonEmptyString\" {\n        ast.Named { name: \"String\", args: [] }\n      } else if name == \"NonEmpty\" && len(args) == 1 {\n        ast.Named { name: \"List\", args }\n      } else {\n        t\n      },\n    },\n    _ => t,\n  }\n}"},{"name":"derive.eval_as","kind":"fn","old":"c5a890c02f802653","new":"25412960a70fe5c2","interface_changed":true,"affected":["derive.fold_comptime","derive.eval_here","derive.derive","derive.expr","derive.call_copy","derive.derive_fn","derive.folded_in","derive.block","derive.comprehension","derive.match_type","derive.derive_all","derive.children","derive.field_read","derive.type_method","derive.with_known","derive.expand_with","derive.expand_in","expanded","check_errors_in","derive.derived_in","derive.make","derive.call_fn","derive.expand","holes_command","check_summary","verified_decls","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","std_reached","eval_files","instantiated_files","with_extra","command_line","check_command","verified_with","static_graph","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","verify_file","repl_command","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","main","strata_command","verified_program","build_command","graph_command","graph_diff","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","graph_runs","replay","or_solver_inputs","verify_command","run_command","program_objects","build_proofs","package_errors","merge_file_command","merged_checks","core_rt_text","call_command","edit_command","check_files","rename_command","move_command","fix_command","edit_in_editor","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","smt_file","termination_file","diff_command","check_fn","linked","sync_command","build_core_command","computed_value","codegen.read_back","comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"/// Runs compile-time code. Data (a description, a known name, a field of\n/// one) is read directly. The rest is run by `eval` with the known values\n/// bound. Messages show `shown`, the code before known values were written\n/// in.\nfn eval_as(\n  mut x: derive.Expander,\n  e: ast.Expr,\n  shown: ast.Expr,\n) -> Result[ast.Expr, String] {\n  match derive.data(mut x, e) {\n    Some(v) => return Ok(v),\n    None => (),\n  }\n  mut stmts := []\n  for k in keys(x.known).sorted() {\n    if derive.is_known(x, k) {\n      mut stmts.push(\n        ast.Let {\n          pat: ast.Bind(k),\n          ty: None,\n          value: get(x.known, k) ?? ast.UnitExpr,\n        },\n      )\n    }\n  }\n  body := derive.with_self(mut x, e)\n  run := if len(stmts) == 0 {\n    body\n  } else {\n    ast.Block { stmts, last: body }\n  }\n  match eval.value_in(derive.world_with_copies(x), x.module, run) {\n    Ok(v) => Ok(v),\n    Err(m) => if contains(m, \"unknown variable\") {\n      Err(m)\n    } else if contains(m, \"too many steps\") {\n      Err(\"`comptime \"\n        + text.expr_text(shown, 0)\n        + \"` ran for more than 5000000 steps: compile-time code must finish\")\n    } else {\n      Err(\n        \"`comptime \" + text.expr_text(shown, 0) + \"` failed: \" + m,\n      )\n    },\n  }\n}","old_text":"/// Runs compile-time code. Data (a description, a known name, a field of\n/// one) is read directly. The rest is run by `eval` with the known values\n/// bound. Messages show `shown`, the code before known values were written\n/// in.\nfn eval_as(\n  mut x: derive.X,\n  e: ast.Expr,\n  shown: ast.Expr,\n) -> Result[ast.Expr, String] {\n  match derive.data(mut x, e) {\n    Some(v) => return Ok(v),\n    None => (),\n  }\n  mut stmts := []\n  for k in keys(x.known).sorted() {\n    if derive.is_known(x, k) {\n      mut stmts.push(\n        ast.Let {\n          pat: ast.Bind(k),\n          ty: None,\n          value: get(x.known, k) ?? ast.UnitExpr,\n        },\n      )\n    }\n  }\n  body := derive.with_self(mut x, e)\n  run := if len(stmts) == 0 {\n    body\n  } else {\n    ast.Block { stmts, last: body }\n  }\n  match eval.value_in(derive.world_with_copies(x), x.module, run) {\n    Ok(v) => Ok(v),\n    Err(m) => if contains(m, \"unknown variable\") {\n      Err(m)\n    } else if contains(m, \"too many steps\") {\n      Err(\"`comptime \"\n        + text.expr_text(shown, 0)\n        + \"` ran for more than 5000000 steps: compile-time code must finish\")\n    } else {\n      Err(\n        \"`comptime \" + text.expr_text(shown, 0) + \"` failed: \" + m,\n      )\n    },\n  }\n}"},{"name":"derive.eval_here","kind":"fn","old":"a24506928f78ebad","new":"6074ae1e9ffcc8ae","interface_changed":true,"affected":["derive.expr","derive.block","derive.comprehension","derive.match_type","derive.derive","derive.children","derive.field_read","derive.type_method","derive.with_known","derive.call_copy","derive.derive_fn","derive.derive_all","derive.make","derive.call_fn","derive.derived_in","derive.expand_with","derive.expand_in","std_reached","expanded","check_errors_in","derive.expand","holes_command","check_summary","verified_decls","verify_file","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","eval_files","instantiated_files","with_extra","command_line","check_command","verified_with","static_graph","verify_command","build_proofs","alongside_command","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","repl_command","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","main","strata_command","verified_program","build_command","graph_command","graph_diff","run_command","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","or_solver_inputs","program_objects","package_errors","merge_file_command","merged_checks","core_rt_text","call_command","edit_command","check_files","rename_command","move_command","fix_command","edit_in_editor","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","smt_file","termination_file","diff_command","check_fn","linked","sync_command","build_core_command","computed_value","codegen.read_back","comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"fn eval_here(mut x: derive.Expander, e: ast.Expr) -> Result[ast.Expr, String] {\n  derive.eval_as(mut x, e, e)\n}","old_text":"fn eval_here(mut x: derive.X, e: ast.Expr) -> Result[ast.Expr, String] {\n  derive.eval_as(mut x, e, e)\n}"},{"name":"derive.with_se