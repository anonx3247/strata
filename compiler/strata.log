d","codegen.lambda_shown","codegen.generated","codegen.can_generate","codegen.union_call","codegen.compared","codegen.if_want","codegen.scope_expr","codegen.channel_new","codegen.list_get_or","codegen.logic","codegen.loop_body","codegen.with_it","codegen.for_list","codegen.await_expr","codegen.race_expr","codegen.mock_method","codegen.call_entry","codegen.tag_test","codegen.keep_olds","codegen.expr_on_stack","codegen.assigned_call","smt.measure_check","smt.encode_all","smt.encode_solving","smt.part","codegen.built_or_generated","resolve.pats","codegen.session_entry","codegen.function_value","codegen.lambda","codegen.gen_data","codegen.generated_args","codegen.makers","codegen.if_expr","codegen.satisfies","codegen.holds_pred","codegen.mock_table","codegen.get_field","termination.measure_next","solved_with","codegen.spawn_expr","codegen.method_value","codegen.mock_value","termination.measures_all","solved_together","written_score","termination.find_measure"],"module":"ast","text":"/// `derive Trait for function`: a trait derivable over functions\n/// (`derivable(Function) trait C`) derived for one (`add`). `derive` turns\n/// it into what it makes, with `derived` false.\n/// - `exports`: each a symbol C calls and the function it runs,\n/// `(\"add\", \"add\")`.\n/// - `files`: each a file extension and the derived function whose value is\n/// this function's part of that file, `(\"h\", \"add.C.h\")`.\n/// - `clauses`: the derive's arguments: `derive Tool(bind: net) for search`\n/// has the clause `bind` with `[\"net\"]` (`Self.clauses` while deriving).\n/// - `values`: each a derived function giving a value that stands for the\n/// function where it is used as a value (`search.Tool.tool`, a `Tool`); its\n/// parameters are the `bind` names, given by `search.with(net)`.\npub type DeriveFnDecl = {\n  trait_name: String,\n  function: String,\n  derived: Bool,\n  exports: List[(String, String)],\n  files: List[(String, String)],\n  clauses: List[ast.DeriveClause] = [],\n  values: List[String] = [],\n}","old_text":"/// `derive Trait for function`: a trait derivable over functions\n/// (`derivable(Function) trait C`) derived for one (`add`). `derive` turns\n/// it into what it makes, with `derived` false.\n/// - `exports`: each a symbol C calls and the function it runs,\n/// `(\"add\", \"add\")`.\n/// - `files`: each a file extension and the derived function whose value is\n/// this function's part of that file, `(\"h\", \"add.C.h\")`.\npub type DeriveFnDecl = {\n  trait_name: String,\n  function: String,\n  derived: Bool,\n  exports: List[(String, String)],\n  files: List[(String, String)],\n}"}]}
{"id":"e2ccb6de69f595ca","time":1795721603,"message":"edit","changes":[{"name":"binary.decl","kind":"fn","old":"0ec012d927f7fc0d","new":"28734d4862865fa5","interface_changed":false,"affected":[],"module":"binary","text":"// ---------------- reading: the tree ----------------\n\nfn decl(mut r: binary.Reader) -> Result[ast.Decl, String] {\n  comments := binary.strs(mut r)!\n  doc := binary.strs(mut r)!\n  module := binary.str(mut r)!\n  public := binary.boolean(mut r)!\n  kind := match binary.tag(mut r, \"declaration\", 8)! {\n    0 => ast.TypeDef(binary.type_decl(mut r)!),\n    1 => ast.FnDef(binary.fn_decl(mut r)!),\n    2 => {\n      name := binary.str(mut r)!\n      ps := binary.params(mut r)!\n      body := binary.expr(mut r)!\n      ast.TestDef(ast.TestDecl { name, params: ps, body })\n    },\n    3 => ast.TraitDef(binary.trait_decl(mut r)!),\n    4 => ast.ImplDef(binary.impl_decl(mut r)!),\n    5 => {\n      path := binary.str(mut r)!\n      alias := binary.opt_str(mut r)!\n      items := if binary.present(mut r)! {\n        Some(binary.use_items(mut r)!)\n      } else {\n        None\n      }\n      ast.UseDef(ast.UseDecl { path, alias, items })\n    },\n    6 => {\n      lang := match binary.tag(mut r, \"Lang\", 2)! {\n        0 => ast.C,\n        1 => ast.Builtin,\n        _ => ast.Python(binary.str(mut r)!),\n      }\n      item := match binary.tag(mut r, \"extern item\", 4)! {\n        0 => ast.ExternFn(binary.fn_decl(mut r)!),\n        1 => ast.ExternType(binary.str(mut r)!, []),\n        2 => {\n          name := binary.str(mut r)!\n          ast.ExternType(name, binary.strs(mut r)!)\n        },\n        3 => {\n          name := binary.str(mut r)!\n          ast.ExternStatic(name, binary.int(mut r)!)\n        },\n        _ => {\n          name := binary.str(mut r)!\n          ast.ExternThreadStatic(name, binary.int(mut r)!)\n        },\n      }\n      ast.ExternDef(ast.ExternDecl { lang, item })\n    },\n    7 => {\n      name := binary.str(mut r)!\n      methods := binary.fn_decls(mut r)!\n      ast.CapabilityDef(ast.CapabilityDecl { name, methods })\n    },\n    _ => {\n      trait_name := binary.str(mut r)!\n      function := binary.str(mut r)!\n      // bit 0: `derive`; bit 1: its clauses follow (older files store a\n      // `bool`, which reads the same)\n      flags := binary.tag(mut r, \"derive flags\", 3)!\n      exports := binary.str_pairs(mut r)!\n      files := binary.str_pairs(mut r)!\n      mut clauses := []\n      if flags >= 2 {\n        n_clauses := binary.length(mut r)!\n        for _ in 0..n_clauses {\n          comments := binary.strs(mut r)!\n          clause_name := binary.str(mut r)!\n          names := binary.strs(mut r)!\n          mut clauses.push(\n            ast.DeriveClause { comments, name: clause_name, names },\n          )\n        }\n      }\n      ast.DeriveFnDef(ast.DeriveFnDecl {\n        trait_name,\n        function,\n        derived: flags % 2 == 1,\n        exports,\n        files,\n        clauses,\n      })\n    },\n  }\n  Ok(ast.Decl { comments, doc, module, public, kind })\n}","old_text":"// ---------------- reading: the tree ----------------\n\nfn decl(mut r: binary.Reader) -> Result[ast.Decl, String] {\n  comments := binary.strs(mut r)!\n  doc := binary.strs(mut r)!\n  module := binary.str(mut r)!\n  public := binary.boolean(mut r)!\n  kind := match binary.tag(mut r, \"declaration\", 8)! {\n    0 => ast.TypeDef(binary.type_decl(mut r)!),\n    1 => ast.FnDef(binary.fn_decl(mut r)!),\n    2 => {\n      name := binary.str(mut r)!\n      ps := binary.params(mut r)!\n      body := binary.expr(mut r)!\n      ast.TestDef(ast.TestDecl { name, params: ps, body })\n    },\n    3 => ast.TraitDef(binary.trait_decl(mut r)!),\n    4 => ast.ImplDef(binary.impl_decl(mut r)!),\n    5 => {\n      path := binary.str(mut r)!\n      alias := binary.opt_str(mut r)!\n      items := if binary.present(mut r)! {\n        Some(binary.use_items(mut r)!)\n      } else {\n        None\n      }\n      ast.UseDef(ast.UseDecl { path, alias, items })\n    },\n    6 => {\n      lang := match binary.tag(mut r, \"Lang\", 2)! {\n        0 => ast.C,\n        1 => ast.Builtin,\n        _ => ast.Python(binary.str(mut r)!),\n      }\n      item := match binary.tag(mut r, \"extern item\", 4)! {\n        0 => ast.ExternFn(binary.fn_decl(mut r)!),\n        1 => ast.ExternType(binary.str(mut r)!, []),\n        2 => {\n          name := binary.str(mut r)!\n          ast.ExternType(name, binary.strs(mut r)!)\n        },\n        3 => {\n          name := binary.str(mut r)!\n          ast.ExternStatic(name, binary.int(mut r)!)\n        },\n        _ => {\n          name := binary.str(mut r)!\n          ast.ExternThreadStatic(name, binary.int(mut r)!)\n        },\n      }\n      ast.ExternDef(ast.ExternDecl { lang, item })\n    },\n    7 => {\n      name := binary.str(mut r)!\n      methods := binary.fn_decls(mut r)!\n      ast.CapabilityDef(ast.CapabilityDecl { name, methods })\n    },\n    _ => {\n      trait_name := binary.str(mut r)!\n      function := binary.str(mut r)!\n      derived := binary.boolean(mut r)!\n      exports := binary.str_pairs(mut r)!\n      files := binary.str_pairs(mut r)!\n      ast.DeriveFnDef(ast.DeriveFnDecl {\n        trait_name,\n        function,\n        derived,\n        exports,\n        files,\n      })\n    },\n  }\n  Ok(ast.Decl { comments, doc, module, public, kind })\n}"}]}
{"id":"0edf7838db5039de","time":1795721608,"message":"edit","changes":[{"name":"binary.put_decl","kind":"fn","old":"1b6171fe7406011c","new":"f69ea4f02c1b74e6","interface_changed":false,"affected":[],"module":"binary","text":"fn put_decl(mut w: binary.Writer, d: ast.Decl) {\n  binary.w_strs(mut w, d.comments)\n  binary.w_strs(mut w, d.doc)\n  binary.w_str(mut w, d.module)\n  binary.w_bool(mut w, d.public)\n  binary.w_byte(mut w, binary.kind_tag(d.kind))\n  match d.kind {\n    ast.TypeDef(t) => {\n      binary.w_bool(mut w, t.distinct)\n      binary.w_str(mut w, t.name)\n      binary.w_strs(mut w, t.params)\n      match t.body {\n        ast.Alias(a) => {\n          binary.w_byte(mut w, 0)\n          binary.put_type(mut w, a)\n        },\n        ast.RecordBody(fs) => {\n          binary.w_byte(mut w, 1)\n          binary.w_fields(mut w, fs)\n        },\n        ast.SumBody(vs) => {\n          binary.w_byte(mut w, 2)\n          binary.w_uint(mut w, len(vs))\n          for v in vs {\n            binary.w_strs(mut w, v.comments)\n            binary.w_strs(mut w, v.doc)\n            binary.w_str(mut w, v.name)\n            match v.payload {\n              ast.NoPayload => binary.w_byte(mut w, 0),\n              ast.Positional(ts) => {\n                binary.w_byte(mut w, 1)\n                binary.w_types(mut w, ts)\n              },\n              ast.RecordPayload(fs) => {\n                binary.w_byte(mut w, 2)\n                binary.w_fields(mut w, fs)\n              },\n              ast.MemberType(t) => {\n                binary.w_byte(mut w, 3)\n                binary.put_type(mut w, t)\n              },\n            }\n          }\n        },\n      }\n      binary.w_opt_expr(mut w, t.refinement)\n      binary.w_bool(mut w, t.mocked)\n    },\n    ast.FnDef(f) => binary.put_fn(mut w, f),\n    ast.TestDef(t) => {\n      binary.w_str(mut w, t.name)\n      binary.w_params(mut w, t.params)\n      binary.put_expr(mut w, t.body)\n    },\n    ast.TraitDef(t) => {\n      binary.w_str(mut w, t.name)\n      binary.w_strs(mut w, t.params)\n      binary.w_types(mut w, t.supers)\n      binary.w_uint(mut w, len(t.methods))\n      for m in t.methods {\n        binary.w_strs(mut w, m.comments)\n        binary.w_strs(mut w, m.doc)\n        binary.put_fn(mut w, m.decl)\n        binary.w_bool(mut w, m.default)\n      }\n      binary.w_uint(mut w, len(t.laws))\n      for l in t.laws {\n        binary.w_strs(mut w, l.comments)\n        binary.w_strs(mut w, l.doc)\n        binary.w_str(mut w, l.name)\n        binary.w_params(mut w, l.params)\n        binary.put_expr(mut w, l.body)\n      }\n      match t.derivable {\n        Some(dv) => {\n          binary.w_byte(mut w, 1)\n          binary.put_type(mut w, dv.kind)\n          binary.w_exprs(mut w, dv.conditions)\n        },\n        None => binary.w_byte(mut w, 0),\n      }\n      has_models := t.models != [] || t.invariants != [] || t.post != []\n      binary.w_byte(mut w, if t.capability {\n          1\n        } else {\n          0\n        }\n        + if has_models {\n          2\n        } else {\n          0\n        }\n        + if t.shared {\n          4\n        } else {\n          0\n        })\n      if has_models {\n        binary.w_uint(mut w, len(t.models))\n        for m in t.models {\n          binary.w_strs(mut w, m.comments)\n          binary.w_strs(mut w, m.doc)\n          binary.w_str(mut w, m.name)\n          binary.put_type(mut w, m.ty)\n        }\n        binary.w_exprs(mut w, t.invariants)\n        binary.w_exprs(mut w, t.post)\n      }\n    },\n    ast.ImplDef(i) => {\n      binary.w_strs(mut w, i.type_params)\n      binary.w_bounds(mut w, i.bounds)\n      binary.w_str(mut w, i.trait_name)\n      binary.w_types(mut w, i.trait_args)\n      binary.put_type(mut w, i.for_type)\n      binary.w_fn_decls(mut w, i.methods)\n      binary.w_byte(mut w, if i.derived {\n          1\n        } else {\n          0\n        }\n        + if i.models != [] {\n          2\n        } else {\n          0\n        }\n        + if i.clauses != [] {\n          4\n        } else {\n          0\n        })\n      if i.models != [] {\n        binary.w_uint(mut w, len(i.models))\n        for m in i.models {\n          binary.w_strs(mut w, m.comments)\n          binary.w_str(mut w, m.name)\n          binary.put_expr(mut w, m.value)\n        }\n      }\n      if i.clauses != [] {\n        binary.w_uint(mut w, len(i.clauses))\n        for c in i.clauses {\n          binary.w_strs(mut w, c.comments)\n          binary.w_str(mut w, c.name)\n          binary.w_strs(mut w, c.names)\n        }\n      }\n    },\n    ast.UseDef(u) => {\n      binary.w_str(mut w, u.path)\n      binary.w_opt_str(mut w, u.alias)\n      match u.items {\n        Some(items) => {\n          binary.w_byte(mut w, 1)\n          binary.w_uint(mut w, len(items))\n          for i in items {\n            binary.w_str(mut w, i.name)\n            binary.w_opt_str(mut w, i.alias)\n          }\n        },\n        None => binary.w_byte(mut w, 0),\n      }\n    },\n    ast.ExternDef(x) => {\n      match x.lang {\n        ast.C => binary.w_byte(mut w, 0),\n        ast.Builtin => binary.w_byte(mut w, 1),\n        ast.Python(m) => {\n          binary.w_byte(mut w, 2)\n          binary.w_str(mut w, m)\n        },\n      }\n      match x.item {\n        ast.ExternFn(f) => {\n          binary.w_byte(mut w, 0)\n          binary.put_fn(mut w, f)\n        },\n        ast.ExternType(name, ps) => if len(ps) == 0 {\n          binary.w_byte(mut w, 1)\n          binary.w_str(mut w, name)\n        } else {\n          binary.w_byte(mut w, 2)\n          binary.w_str(mut w, name)\n          binary.w_strs(mut w, ps)\n        },\n        ast.ExternStatic(name, size) => {\n          binary.w_byte(mut w, 3)\n          binary.w_str(mut w, name)\n          binary.w_int(mut w, size)\n        },\n        ast.ExternThreadStatic(name, size) => {\n          binary.w_byte(mut w, 4)\n          binary.w_str(mut w, name)\n          binary.w_int(mut w, size)\n        },\n      }\n    },\n    ast.CapabilityDef(c) => {\n      binary.w_str(mut w, c.name)\n      binary.w_fn_decls(mut w, c.methods)\n    },\n    ast.DeriveFnDef(x) => {\n      binary.w_str(mut w, x.trait_name)\n      binary.w_str(mut w, x.function)\n      binary.w_byte(mut w, if x.derived {\n          1\n        } else {\n          0\n        }\n        + if x.clauses != [] {\n          2\n        } else {\n          0\n        })\n      binary.w_str_pairs(mut w, x.exports)\n      binary.w_str_pairs(mut w, x.files)\n      if x.clauses != [] {\n        binary.w_uint(mut w, len(x.clauses))\n        for c in x.clauses {\n          binary.w_strs(mut w, c.comments)\n          binary.w_str(mut w, c.name)\n          binary.w_strs(mut w, c.names)\n        }\n      }\n    },\n  }\n}","old_text":"fn put_decl(mut w: binary.Writer, d: ast.Decl) {\n  binary.w_strs(mut w, d.comments)\n  binary.w_strs(mut w, d.doc)\n  binary.w_str(mut w, d.module)\n  binary.w_bool(mut w, d.public)\n  binary.w_byte(mut w, binary.kind_tag(d.kind))\n  match d.kind {\n    ast.TypeDef(t) => {\n      binary.w_bool(mut w, t.distinct)\n      binary.w_str(mut w, t.name)\n      binary.w_strs(mut w, t.params)\n      match t.body {\n        ast.Alias(a) => {\n          binary.w_byte(mut w, 0)\n          binary.put_type(mut w, a)\n        },\n        ast.RecordBody(fs) => {\n          binary.w_byte(mut w, 1)\n          binary.w_fields(mut w, fs)\n        },\n        ast.SumBody(vs) => {\n          binary.w_byte(mut w, 2)\n          binary.w_uint(mut w, len(vs))\n          for v in vs {\n            binary.w_strs(mut w, v.comments)\n            binary.w_strs(mut w, v.doc)\n            binary.w_str(mut w, v.name)\n            match v.payload {\n              ast.NoPayload => binary.w_byte(mut w, 0),\n              ast.Positional(ts) => {\n                binary.w_byte(mut w, 1)\n                binary.w_types(mut w, ts)\n              },\n              ast.RecordPayload(fs) => {\n                binary.w_byte(mut w, 2)\n                binary.w_fields(mut w, fs)\n              },\n              ast.MemberType(t) => {\n                binary.w_byte(mut w, 3)\n                binary.put_type(mut w, t)\n              },\n            }\n          }\n        },\n      }\n      binary.w_opt_expr(mut w, t.refinement)\n      binary.w_bool(mut w, t.mocked)\n    },\n    ast.FnDef(f) => binary.put_fn(mut w, f),\n    ast.TestDef(t) => {\n      binary.w_str(mut w, t.name)\n      binary.w_params(mut w, t.params)\n      binary.put_expr(mut w, t.body)\n    },\n    ast.TraitDef(t) => {\n      binary.w_str(mut w, t.name)\n      binary.w_strs(mut w, t.params)\n      binary.w_types(mut w, t.supers)\n      binary.w_uint(mut w, len(t.methods))\n      for m in t.methods {\n        binary.w_strs(mut w, m.comments)\n        binary.w_strs(mut w, m.doc)\n        binary.put_fn(mut w, m.decl)\n        binary.w_bool(mut w, m.default)\n      }\n      binary.w_uint(mut w, len(t.laws))\n      for l in t.laws {\n        binary.w_strs(mut w, l.comments)\n        binary.w_strs(mut w, l.doc)\n        binary.w_str(mut w, l.name)\n        binary.w_params(mut w, l.params)\n        binary.put_expr(mut w, l.body)\n      }\n      match t.derivable {\n        Some(dv) => {\n          binary.w_byte(mut w, 1)\n          binary.put_type(mut w, dv.kind)\n          binary.w_exprs(mut w, dv.conditions)\n        },\n        None => binary.w_byte(mut w, 0),\n      }\n      has_models := t.models != [] || t.invariants != [] || t.post != []\n      binary.w_byte(mut w, if t.capability {\n          1\n        } else {\n          0\n        }\n        + if has_models {\n          2\n        } else {\n          0\n        }\n        + if t.shared {\n          4\n        } else {\n          0\n        })\n      if has_models {\n        binary.w_uint(mut w, len(t.models))\n        for m in t.models {\n          binary.w_strs(mut w, m.comments)\n          binary.w_strs(mut w, m.doc)\n          binary.w_str(mut w, m.name)\n          binary.put_type(mut w, m.ty)\n        }\n        binary.w_exprs(mut w, t.invariants)\n        binary.w_exprs(mut w, t.post)\n      }\n    },\n    ast.ImplDef(i) => {\n      binary.w_strs(mut w, i.type_params)\n      binary.w_bounds(mut w, i.bounds)\n      binary.w_str(mut w, i.trait_name)\n      binary.w_types(mut w, i.trait_args)\n      binary.put_type(mut w, i.for_type)\n      binary.w_fn_decls(mut w, i.methods)\n      binary.w_byte(mut w, if i.derived {\n          1\n        } else {\n          0\n        }\n        + if i.models != [] {\n          2\n        } else {\n          0\n        }\n        + if i.clauses != [] {\n          4\n        } else {\n          0\n        })\n      if i.models != [] {\n        binary.w_uint(mut w, len(i.models))\n        for m in i.models {\n          binary.w_strs(mut w, m.comments)\n          binary.w_str(mut w, m.name)\n          binary.put_expr(mut w, m.value)\n        }\n      }\n      if i.clauses != [] {\n        binary.w_uint(mut w, len(i.clauses))\n        for c in i.clauses {\n          binary.w_strs(mut w, c.comments)\n          binary.w_str(mut w, c.name)\n          binary.w_strs(mut w, c.names)\n        }\n      }\n    },\n    ast.UseDef(u) => {\n      binary.w_str(mut w, u.path)\n      binary.w_opt_str(mut w, u.alias)\n      match u.items {\n        Some(items) => {\n          binary.w_byte(mut w, 1)\n          binary.w_uint(mut w, len(items))\n          for i in items {\n            binary.w_str(mut w, i.name)\n            binary.w_opt_str(mut w, i.alias)\n          }\n        },\n        None => binary.w_byte(mut w, 0),\n      }\n    },\n    ast.ExternDef(x) => {\n      match x.lang {\n        ast.C => binary.w_byte(mut w, 0),\n        ast.Builtin => binary.w_byte(mut w, 1),\n        ast.Python(m) => {\n          binary.w_byte(mut w, 2)\n          binary.w_str(mut w, m)\n        },\n      }\n      match x.item {\n        ast.ExternFn(f) => {\n          binary.w_byte(mut w, 0)\n          binary.put_fn(mut w, f)\n        },\n        ast.ExternType(name, ps) => if len(ps) == 0 {\n          binary.w_byte(mut w, 1)\n          binary.w_str(mut w, name)\n        } else {\n          binary.w_byte(mut w, 2)\n          binary.w_str(mut w, name)\n          binary.w_strs(mut w, ps)\n        },\n        ast.ExternStatic(name, size) => {\n          binary.w_byte(mut w, 3)\n          binary.w_str(mut w, name)\n          binary.w_int(mut w, size)\n        },\n        ast.ExternThreadStatic(name, size) => {\n          binary.w_byte(mut w, 4)\n          binary.w_str(mut w, name)\n          binary.w_int(mut w, size)\n        },\n      }\n    },\n    ast.CapabilityDef(c) => {\n      binary.w_str(mut w, c.name)\n      binary.w_fn_decls(mut w, c.methods)\n    },\n    ast.DeriveFnDef(x) => {\n      binary.w_str(mut w, x.trait_name)\n      binary.w_str(mut w, x.function)\n      binary.w_bool(mut w, x.derived)\n      binary.w_str_pairs(mut w, x.exports)\n      binary.w_str_pairs(mut w, x.files)\n    },\n  }\n}"}]}
{"id":"be62edb7ed825dbb","time":1795721656,"message":"derive arguments","changes":[{"name":"parse.derive_fn","kind":"fn","old":"299b3ed678a197d2","new":"77e8dc258bb30df1","interface_changed":false,"affected":[],"module":"parse","text":"/// `derive Trait for function`, after `derive`: a trait derivable over\n/// functions. A lowercase name after `for` tells it from\n/// `derive Trait for Type`; for a type this gives `None` and reads nothing.\nfn derive_fn(mut p: parse.Parser) -> Result[Option[ast.DeriveFnDecl], String] {\n  start := p.pos\n  trait_name := parse.path(mut p)!\n  clauses := parse.derive_args(mut p)!\n  if parse.eat_kw(mut p, \"for\") && parse.is_ident_at(p, 0) {\n    function := parse.path(mut p)!\n    parts := split(function, \".\")\n    if !parse.is_upper(get(parts, len(parts) - 1) ?? \"\")\n      && !parse.is_sym(p, \"[\") {\n      if parse.is_sym(p, \"{\") {\n        return parse.fail(\n          p,\n          f\"`derive {trait_name} for {function}` derives everything: a derive for a function has no block\",\n        )\n      }\n      return Ok(Some(ast.DeriveFnDecl {\n        trait_name,\n        function,\n        derived: true,\n        exports: [],\n        files: [],\n        clauses,\n      }))\n    }\n  }\n  p.pos = start\n  Ok(None)\n}","old_text":"/// `derive Trait for function`, after `derive`: a trait derivable over\n/// functions. A lowercase name after `for` tells it from\n/// `derive Trait for Type`; for a type this gives `None` and reads nothing.\nfn derive_fn(mut p: parse.Parser) -> Result[Option[ast.DeriveFnDecl], String] {\n  start := p.pos\n  trait_name := parse.path(mut p)!\n  if parse.eat_kw(mut p, \"for\") && parse.is_ident_at(p, 0) {\n    function := parse.path(mut p)!\n    parts := split(function, \".\")\n    if !parse.is_upper(get(parts, len(parts) - 1) ?? \"\")\n      && !parse.is_sym(p, \"[\") {\n      if parse.is_sym(p, \"{\") {\n        return parse.fail(\n          p,\n          f\"`derive {trait_name} for {function}` derives everything: a derive for a function has no block\",\n        )\n      }\n      return Ok(Some(ast.DeriveFnDecl {\n        trait_name,\n        function,\n        derived: true,\n        exports: [],\n        files: [],\n      }))\n    }\n  }\n  p.pos = start\n  Ok(None)\n}"},{"name":"parse.function_derive","kind":"fn","old":"c52edba6d653ef60","new":"7741a01b03de4fea","interface_changed":true,"affected":["parse.derive_group","parse.decl_inner","parse.decl","parse.parse_module","diff.parsed","stored_package","edit_command","edit_file","edit_in_editor","merge_file_command","resolve_command","write_found","merge.merge","parse.parse_program","diff.apply","diff.undo","command_line","repl_command","find_invariants","parse_one","stored_one","parse_lines","stored_lines","repl_line","diff.log_steps","diff.states","main","strata_command","verify_file","parse_files","front_command","stored_files","diff.git_range","diff.log_range","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","verify_command","build_proofs","alongside_command","search_invariants","diff_command","tour.side_range","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","build_command","run_command","apply_edit","fix_loops","tour_graph","tour.package_changes","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","fix_command","tour_command","tour.prepare","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","or_solver_inputs","check_command","static_graph","program_objects","comptime_values","call_command","loaded_errors","file_errors","edit_errors","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","package_errors","check_files","apply_change","with_base","rename_command","move_command"],"module":"parse","text":"/// The derive of `trait_name` for the function (or `module`) `function`,\n/// with its arguments as clauses.\nfn function_derive(\n  trait_name: String,\n  clauses: List[ast.DeriveClause],\n  function: String,\n) -> ast.DeclKind {\n  ast.DeriveFnDef(ast.DeriveFnDecl {\n    trait_name,\n    function,\n    derived: true,\n    exports: [],\n    files: [],\n    clauses,\n  })\n}","old_text":"/// The derive of `trait_name` for the function (or `module`) `function`.\nfn function_derive(trait_name: String, function: String) -> ast.DeclKind {\n  ast.DeriveFnDef(ast.DeriveFnDecl {\n    trait_name,\n    function,\n    derived: true,\n    exports: [],\n    files: [],\n  })\n}"},{"name":"parse.derive_group","kind":"fn","old":"ad1a37cb50fd824e","new":"7a25ffc5729f2085","interface_changed":false,"affected":[],"module":"parse","text":"/// At `derive`, one of two forms, each giving a derive per trait:\n/// - `derive A, B for` written on the declaration after it (`fn` or `type`,\n/// `pub` and docs allowed), as `derive A for name` lines would.\n/// - `derive A, B for T`, with `T` a type, a function or `module`. The\n/// first derive stands in place of the definition.\n/// `None`, with nothing read, for a derive of one trait for a name.\nfn derive_group(\n  mut p: parse.Parser,\n  doc: List[String],\n  comments: List[String],\n) -> Result[Option[(ast.Decl, List[ast.Decl])], String] {\n  start := p.pos\n  parse.advance(mut p)\n  first_trait := parse.path(mut p)!\n  mut traits := [(first_trait, parse.derive_args(mut p)!)]\n  while parse.eat_sym(mut p, \",\") {\n    t := parse.path(mut p)!\n    mut traits.push((t, parse.derive_args(mut p)!))\n  }\n  if !parse.eat_kw(mut p, \"for\") {\n    if len(traits) > 1 {\n      return parse.fail(\n        p,\n        \"expected `for` after the traits a `derive` names\",\n      )\n    }\n    p.pos = start\n    return Ok(None)\n  }\n  if parse.declaration_ahead(p) {\n    // docs after the `derive` line, and comments, join the declaration's\n    more_doc := parse.docs(mut p)\n    more := parse.leading(mut p)\n    public := parse.eat_kw(mut p, \"pub\")\n    kind := parse.decl_kind(mut p)!\n    mut derives := []\n    match kind {\n      ast.FnDef(f) => {\n        for t in traits {\n          mut derives.push(\n            parse.derive_def(\n              parse.function_derive(t.0, t.1, f.name),\n            ),\n          )\n        }\n      },\n      ast.TypeDef(td) => {\n        for t in traits {\n          if t.1 != [] {\n            return parse.fail(\n              p,\n              \"a derive for a type takes its clauses in a block (`derive Table for Todo { key code }`), not in parentheses\",\n            )\n          }\n          mut derives.push(\n            parse.derive_def(parse.type_derive(\n              t.0,\n              ast.Named { name: td.name, args: [] },\n            )),\n          )\n        }\n      },\n      _ => return parse.fail(\n        p,\n        \"`derive … for` above a definition is written on a `fn` or a `type`\",\n      ),\n    }\n    d := ast.Decl {\n      comments: comments + more,\n      doc: doc + more_doc,\n      module: \"\",\n      public,\n      kind,\n    }\n    return Ok(Some((d, derives)))\n  }\n  if len(traits) == 1 {\n    p.pos = start\n    return Ok(None)\n  }\n  // `derive A, B for T`: a derive for each trait\n  at := p.pos\n  target := parse.path(mut p)!\n  parts := split(target, \".\")\n  kinds := if !parse.is_upper(get(parts, len(parts) - 1) ?? \"\")\n    && !parse.is_sym(p, \"[\") {\n    traits.map(t -> parse.function_derive(t.0, t.1, target))\n  } else {\n    p.pos = at\n    for_type := parse.type_expr_plain(mut p)!\n    traits.map(t -> parse.type_derive(t.0, for_type))\n  }\n  if parse.is_sym(p, \"{\") {\n    return parse.fail(\n      p,\n      \"a derive with methods written by hand names one trait: `derive Trait for Type { ... }`\",\n    )\n  }\n  first := ast.Decl { ..parse.derive_def(\n    get(kinds, 0) ?? parse.function_derive(\"\", [], target),\n  ), comments, doc }\n  Ok(Some((first, drop(kinds, 1).map(k -> parse.derive_def(k)))))\n}","old_text":"/// At `derive`, one of two forms, each giving a derive per trait:\n/// - `derive A, B for` written on the declaration after it (`fn` or `type`,\n/// `pub` and docs allowed), as `derive A for name` lines would.\n/// - `derive A, B for T`, with `T` a type, a function or `module`. The\n/// first derive stands in place of the definition.\n/// `None`, with nothing read, for a derive of one trait for a name.\nfn derive_group(\n  mut p: parse.Parser,\n  doc: List[String],\n  comments: List[String],\n) -> Result[Option[(ast.Decl, List[ast.Decl])], String] {\n  start := p.pos\n  parse.advance(mut p)\n  mut traits := [parse.path(mut p)!]\n  while parse.eat_sym(mut p, \",\") {\n    mut traits.push(parse.path(mut p)!)\n  }\n  if !parse.eat_kw(mut p, \"for\") {\n    if len(traits) > 1 {\n      return parse.fail(\n        p,\n        \"expected `for` after the traits a `derive` names\",\n      )\n    }\n    p.pos = start\n    return Ok(None)\n  }\n  if parse.declaration_ahead(p) {\n    // docs after the `derive` line, and comments, join the declaration's\n    more_doc := parse.docs(mut p)\n    more := parse.leading(mut p)\n    public := parse.eat_kw(mut p, \"pub\")\n    kind := parse.decl_kind(mut p)!\n    mut derives := []\n    match kind {\n      ast.FnDef(f) => {\n        for t in traits {\n          mut derives.push(\n            parse.derive_def(parse.function_derive(t, f.name)),\n          )\n        }\n      },\n      ast.TypeDef(td) => {\n        for t in traits {\n          mut derives.push(\n            parse.derive_def(parse.type_derive(\n              t,\n              ast.Named { name: td.name, args: [] },\n            )),\n          )\n        }\n      },\n      _ => return parse.fail(\n        p,\n        \"`derive … for` above a definition is written on a `fn` or a `type`\",\n      ),\n    }\n    d := ast.Decl {\n      comments: comments + more,\n      doc: doc + more_doc,\n      module: \"\",\n      public,\n      kind,\n    }\n    return Ok(Some((d, derives)))\n  }\n  if len(traits) == 1 {\n    p.pos = start\n    return Ok(None)\n  }\n  // `derive A, B for T`: a derive for each trait\n  at := p.pos\n  target := parse.path(mut p)!\n  parts := split(target, \".\")\n  kinds := if !parse.is_upper(get(parts, len(parts) - 1) ?? \"\")\n    && !parse.is_sym(p, \"[\") {\n    traits.map(t -> parse.function_derive(t, target))\n  } else {\n    p.pos = at\n    for_type := parse.type_expr_plain(mut p)!\n    traits.map(t -> parse.type_derive(t, for_type))\n  }\n  if parse.is_sym(p, \"{\") {\n    return parse.fail(\n      p,\n      \"a derive with methods written by hand names one trait: `derive Trait for Type { ... }`\",\n    )\n  }\n  first := ast.Decl { ..parse.derive_def(\n    get(kinds, 0) ?? parse.function_derive(\"\", target),\n  ), comments, doc }\n  Ok(Some((first, drop(kinds, 1).map(k -> parse.derive_def(k)))))\n}"},{"name":"parse.derive_args","kind":"fn","old":null,"new":"e48474f0dffe6512","interface_changed":true,"affected":[],"module":"parse","text":"/// A derive's arguments after its trait, `(bind: net, clock)`: each a word,\n/// a colon and names, `;` between them. None: `[]`.\nfn derive_args(mut p: parse.Parser) -> Result[List[ast.DeriveClause], String] {\n  mut out := []\n  if !parse.eat_sym(mut p, \"(\") {\n    return Ok(out)\n  }\n  loop {\n    name := parse.ident(mut p)!\n    parse.expect_sym(mut p, \":\")!\n    mut names := [parse.ident(mut p)!]\n    while parse.eat_sym(mut p, \",\") {\n      mut names.push(parse.ident(mut p)!)\n    }\n    mut out.push(ast.DeriveClause { comments: [], name, names })\n    if !parse.eat_sym(mut p, \";\") {\n      break\n    }\n  }\n  parse.expect_sym(mut p, \")\")!\n  Ok(out)\n}"},{"name":"text.decl_body_text","kind":"fn","old":"3d60edad65fbf75b","new":"d11da6c0800d9df0","interface_changed":false,"affected":[],"module":"text","text":"/// A definition without its comments and doc: `pub` and the definition\n/// itself.\npub fn decl_body_text(d: ast.Decl) -> String {\n  body := match d.kind {\n    ast.TypeDef(t) => text.type_decl_text(t),\n    ast.FnDef(f) => text.fn_decl_text(f),\n    ast.TestDef(t) => if len(t.params) == 0 {\n      \"test \"\n        + text.debug_quoted(t.name)\n        + \" \"\n        + text.block_text(t.body, 0)\n    } else {\n      \"test \"\n        + text.debug_quoted(t.name)\n        + \" (\"\n        + text.param_list(t.params)\n        + \") \"\n        + text.block_text(t.body, 0)\n    },\n    ast.CapabilityDef(c) => text.capability_decl_text(c),\n    ast.TraitDef(t) => text.trait_decl_text(t),\n    ast.ImplDef(i) => text.impl_decl_text(i),\n    ast.DeriveFnDef(x) => \"derive \"\n      + x.trait_name\n      + text.derive_args_text(x.clauses)\n      + \" for \"\n      + x.function,\n    ast.UseDef(u) => match u.items {\n      // the module, its names written `time.now()`\n      None => match u.alias {\n        Some(a) => \"use \" + u.path + \" as \" + a,\n        None => \"use \" + u.path,\n      },\n      Some(items) => text.use_list(\"from \" + u.path + \" use\", items.map(\n        i -> match i.alias {\n          Some(a) => i.name + \" as \" + a,\n          None => i.name,\n        },\n      ), if d.public {\n        4\n      } else {\n        0\n      }),\n    },\n    ast.ExternDef(x) => match (x.lang, x.item) {\n      (ast.Builtin, ast.ExternFn(f)) => \"builtin \" + text.fn_signature_text(f),\n      (ast.Builtin, ast.ExternType(t, ps)) => if len(ps) == 0 {\n        \"builtin type \" + t\n      } else {\n        \"builtin type \" + t + \"[\" + join(ps, \", \") + \"]\"\n      },\n      (ast.Python(m), ast.ExternFn(f)) => \"extern python \\\"\"\n        + text.escape(m)\n        + \"\\\" \"\n        + text.fn_signature_text(f),\n      (_, ast.ExternFn(f)) => \"extern c \" + text.fn_signature_text(f),\n      (_, ast.ExternType(t, _)) => \"extern c type \" + t,\n      (_, ast.ExternStatic(n, size)) => f\"builtin static {n}: {size}\",\n      (_, ast.ExternThreadStatic(n, size)) => f\"builtin thread static {n}: {size}\",\n    },\n  }\n  if d.public {\n      \"pub \"\n    } else {\n      \"\"\n    }\n    + body\n}","old_text":"/// A definition without its comments and doc: `pub` and the definition\n/// itself.\npub fn decl_body_text(d: ast.Decl) -> String {\n  body := match d.kind {\n    ast.TypeDef(t) => text.type_decl_text(t),\n    ast.FnDef(f) => text.fn_decl_text(f),\n    ast.TestDef(t) => if len(t.params) == 0 {\n      \"test \"\n        + text.debug_quoted(t.name)\n        + \" \"\n        + text.block_text(t.body, 0)\n    } else {\n      \"test \"\n        + text.debug_quoted(t.name)\n        + \" (\"\n        + text.param_list(t.params)\n        + \") \"\n        + text.block_text(t.body, 0)\n    },\n    ast.CapabilityDef(c) => text.capability_decl_text(c),\n    ast.TraitDef(t) => text.trait_decl_text(t),\n    ast.ImplDef(i) => text.impl_decl_text(i),\n    ast.DeriveFnDef(x) => \"derive \" + x.trait_name + \" for \" + x.function,\n    ast.UseDef(u) => match u.items {\n      // the module, its names written `time.now()`\n      None => match u.alias {\n        Some(a) => \"use \" + u.path + \" as \" + a,\n        None => \"use \" + u.path,\n      },\n      Some(items) => text.use_list(\"from \" + u.path + \" use\", items.map(\n        i -> match i.alias {\n          Some(a) => i.name + \" as \" + a,\n          None => i.name,\n        },\n      ), if d.public {\n        4\n      } else {\n        0\n      }),\n    },\n    ast.ExternDef(x) => match (x.lang, x.item) {\n      (ast.Builtin, ast.ExternFn(f)) => \"builtin \" + text.fn_signature_text(f),\n      (ast.Builtin, ast.ExternType(t, ps)) => if len(ps) == 0 {\n        \"builtin type \" + t\n      } else {\n        \"builtin type \" + t + \"[\" + join(ps, \", \") + \"]\"\n      },\n      (ast.Python(m), ast.ExternFn(f)) => \"extern python \\\"\"\n        + text.escape(m)\n        + \"\\\" \"\n        + text.fn_signature_text(f),\n      (_, ast.ExternFn(f)) => \"extern c \" + text.fn_signature_text(f),\n      (_, ast.ExternType(t, _)) => \"extern c type \" + t,\n      (_, ast.ExternStatic(n, size)) => f\"builtin static {n}: {size}\",\n      (_, ast.ExternThreadStatic(n, size)) => f\"builtin thread static {n}: {size}\",\n    },\n  }\n  if d.public {\n      \"pub \"\n    } else {\n      \"\"\n    }\n    + body\n}"},{"name":"text.simple_derive","kind":"fn","old":"bd9bfa5d6c3d3e70","new":"8d354670d75d38f6","interface_changed":false,"affected":[],"module":"text","text":"/// The trait a derive derives and the name of what it derives it for (and\n/// whether that is a type), when it can be written on that declaration\n/// (`derive Json for` above `type Options`): a derive with no block of\n/// hand-written methods or clauses, no type parameters or trait arguments,\n/// for a plain name, with no comments or doc of its own (they would have\n/// nowhere to go); `for module` never is.\nfn simple_derive(d: ast.Decl) -> Option[(String, String, Bool)] {\n  if d.comments != [] || d.doc != [] || d.public {\n    return None\n  }\n  match d.kind {\n    ast.ImplDef(i) => if i.derived\n      && i.trait_name != \"\"\n      && i.methods == []\n      && i.models == []\n      && i.clauses == []\n      && i.type_params == []\n      && i.trait_args == [] {\n      match i.for_type {\n        ast.Named { name, args } => if args == [] {\n          Some((i.trait_name, name, true))\n        } else {\n          None\n        },\n        _ => None,\n      }\n    } else {\n      None\n    },\n    ast.DeriveFnDef(x) => if x.function == \"module\" {\n      None\n    } else {\n      Some((\n        x.trait_name + text.derive_args_text(x.clauses),\n        x.function,\n        false,\n      ))\n    },\n    _ => None,\n  }\n}","old_text":"/// The trait a derive derives and the name of what it derives it for (and\n/// whether that is a type), when it can be written on that declaration\n/// (`derive Json for` above `type Options`): a derive with no block of\n/// hand-written methods or clauses, no type parameters or trait arguments,\n/// for a plain name, with no comments or doc of its own (they would have\n/// nowhere to go); `for module` never is.\nfn simple_derive(d: ast.Decl) -> Option[(String, String, Bool)] {\n  if d.comments != [] || d.doc != [] || d.public {\n    return None\n  }\n  match d.kind {\n    ast.ImplDef(i) => if i.derived\n      && i.trait_name != \"\"\n      && i.methods == []\n      && i.models == []\n      && i.clauses == []\n      && i.type_params == []\n      && i.trait_args == [] {\n      match i.for_type {\n        ast.Named { name, args } => if args == [] {\n          Some((i.trait_name, name, true))\n        } else {\n          None\n        },\n        _ => None,\n      }\n    } else {\n      None\n    },\n    ast.DeriveFnDef(x) => if x.function == \"module\" {\n      None\n    } else {\n      Some((x.trait_name, x.function, false))\n    },\n    _ => None,\n  }\n}"},{"name":"text.derive_args_text","kind":"fn","old":null,"new":"1af24ffa48bcb6e0","interface_changed":true,"affected":[],"module":"text","text":"/// A function derive's arguments as written: `(bind: net, clock)`, or `\"\"`.\nfn derive_args_text(cs: List[ast.DeriveClause]) -> String {\n  if cs == [] {\n    return \"\"\n  }\n  \"(\"\n    + join(cs.map(c -> c.name + \": \" + join(c.names, \", \")), \"; \")\n    + \")\"\n}"}]}
{"id":"88f4b0d76b05e278","time":1795721881,"message":"edit","changes":[{"name":"derive.Expander","kind":"type","old":"45c401eb51d2f704","new":"edcfb202a331380f","interface_changed":true,"affected":["derive.new_expander","derive.type_value","derive.remember","derive.type_value_in","derive.variant_decl","derive.variant_value","derive.field","derive.unwhere","derive.is_variant","derive.type_of","derive.full","derive.kind_of","derive.distinct_head","derive.is_hidden","derive.is_known","derive.type_named","derive.base","derive.base_in","derive.eval_as","derive.eval_here","derive.with_self","derive.data","derive.data_in","derive.ctor_data","derive.derive","derive.ty","derive.children","derive.expr","derive.last_arm","derive.field_read","derive.type_method","derive.with_known","derive.make","derive.block","derive.comprehension","derive.arm_pattern","derive.check_code","derive.match_type","derive.fits","derive.call_copy","derive.named_union","derive.world_with_copies","derive.derive_fn","derive.fn_value","derive.call_fn","derive.implements_trait","derive.clauses_of","derive.derive_all","derive.fold_comptime","derive.derived_in","derive.folded_in","derive.expand_with","derive.expand_in","std_reached","expanded","check_errors_in","derive.expand","holes_command","check_summary","verified_decls","verify_file","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","eval_files","instantiated_files","with_extra","command_line","check_command","verified_with","static_graph","verify_command","build_proofs","alongside_command","search_invariants","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","repl_command","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","main","strata_command","verified_program","build_command","graph_command","graph_diff","tour_graph","run_command","fix_loops","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","or_solver_inputs","program_objects","package_errors","merge_file_command","merged_checks","core_rt_text","call_command","edit_command","check_files","rename_command","move_command","fix_command","edit_in_editor","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","smt_file","termination_file","diff_command","tour_command","check_fn","linked","sync_command","build_core_command","computed_value","codegen.read_back","comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"/// The state of specializing code for one `derive` or one `comptime e`.\ntype Expander = {\n  ix: derive.Defs,\n  w: eval.World,\n  // the module the generated code goes in\n  module: String,\n  // values known at compile time, by name (a `comptime` parameter, a\n  // `comptime for` element)\n  known: Dict[String, ast.Expr],\n  // types known at compile time, by name (`f.type`, `x` of `Option[x] =>`)\n  types: Dict[String, ast.TypeExpr],\n  // the type behind each `Type` value made, by the value's text\n  written: Dict[String, ast.TypeExpr],\n  // the type derived for (`()` when none)\n  self_ty: ast.TypeExpr,\n  copies: List[ast.FnDecl],\n  made: Dict[String, String],\n  // a variant's constructor, by its `Type` value's text\n  ctors: Dict[String, String],\n  // names bound inside the code being specialized, which hide known ones\n  hidden: List[List[String]],\n  // the type parameters of the type derived for (`T` of `Pair[T]`)\n  params: List[String],\n  trait_name: String,\n  trait_methods: List[String],\n  // each field's default, by its `Field` value's text\n  defaults: Dict[String, ast.Expr],\n  // each type's `Type` value, by the type's text\n  type_values: Dict[String, ast.Expr],\n  // in a match comprehension arm: the matched expression (as text) and the\n  // names its variant's fields are bound to\n  arm_fields: List[(String, List[(String, String)])],\n  // the function derived for, qualified (`derive Python for add`), which\n  // `Self.call(..)` calls. `\"\"` for a type's derive.\n  self_fn: String = \"\",\n  // the clauses of the derive's block (`key code`): `Self.clauses`\n  clauses: List[ast.DeriveClause] = [],\n  // the parameters a derive for a function binds (`derive Tool(bind: net)`):\n  // `Self.call(..)` passes them as they are, from the value function's own\n  // parameters\n  bound: List[String] = [],\n}","old_text":"/// The state of specializing code for one `derive` or one `comptime e`.\ntype Expander = {\n  ix: derive.Defs,\n  w: eval.World,\n  // the module the generated code goes in\n  module: String,\n  // values known at compile time, by name (a `comptime` parameter, a\n  // `comptime for` element)\n  known: Dict[String, ast.Expr],\n  // types known at compile time, by name (`f.type`, `x` of `Option[x] =>`)\n  types: Dict[String, ast.TypeExpr],\n  // the type behind each `Type` value made, by the value's text\n  written: Dict[String, ast.TypeExpr],\n  // the type derived for (`()` when none)\n  self_ty: ast.TypeExpr,\n  copies: List[ast.FnDecl],\n  made: Dict[String, String],\n  // a variant's constructor, by its `Type` value's text\n  ctors: Dict[String, String],\n  // names bound inside the code being specialized, which hide known ones\n  hidden: List[List[String]],\n  // the type parameters of the type derived for (`T` of `Pair[T]`)\n  params: List[String],\n  trait_name: String,\n  trait_methods: List[String],\n  // each field's default, by its `Field` value's text\n  defaults: Dict[String, ast.Expr],\n  // each type's `Type` value, by the type's text\n  type_values: Dict[String, ast.Expr],\n  // in a match comprehension arm: the matched expression (as text) and the\n  // names its variant's fields are bound to\n  arm_fields: List[(String, List[(String, String)])],\n  // the function derived for, qualified (`derive Python for add`), which\n  // `Self.call(..)` calls. `\"\"` for a type's derive.\n  self_fn: String = \"\",\n  // the clauses of the derive's block (`key code`): `Self.clauses`\n  clauses: List[ast.DeriveClause] = [],\n}"},{"name":"derive.derive_all","kind":"fn","old":"d82c1f5276d418f1","new":"da58bbfe4fbe92f2","interface_changed":false,"affected":[],"module":"derive","text":"fn derive_all(\n  decls: List[ast.Decl],\n  context: List[ast.Decl],\n) -> (List[ast.Decl], List[(String, String)]) {\n  if !decls.any(d -> derive.is_derive(d)) {\n    return (decls, [])\n  }\n  ix := derive.defs_of(context + decls)\n  w := eval.world(context + decls)\n  mut out := []\n  mut extra := []\n  mut errors := []\n  for d in decls {\n    match d.kind {\n      ast.DeriveFnDef(f) => if f.derived {\n        for function in derive.derived_functions(\n          context + decls,\n          d.module,\n          f.function,\n          ix,\n        ) {\n          mut x := derive.new_expander(ix, w, d.module)\n          match derive.derive_fn(\n            mut x,\n            ast.DeriveFnDecl { ..f, function },\n          ) {\n            Ok((made, fns)) => {\n              mut out.push(\n                ast.Decl { ..d, kind: ast.DeriveFnDef(made) },\n              )\n              for g in fns {\n                mut extra.push(\n                  ast.Decl {\n                    comments: [],\n                    doc: [],\n                    module: d.module,\n                    public: false,\n                    kind: ast.FnDef(g),\n                  },\n                )\n              }\n            },\n            Err(msg) => mut errors.push((desugar.decl_name(d), msg)),\n          }\n        }\n      } else {\n        mut out.push(d)\n      },\n      ast.ImplDef(i) => if i.derived {\n        mut x := derive.new_expander(ix, w, d.module)\n        match derive.derive(mut x, i) {\n          Ok(imp) => {\n            mut out.push(ast.Decl { ..d, kind: ast.ImplDef(imp) })\n            for f in x.copies {\n              mut extra.push(\n                ast.Decl {\n                  comments: [],\n                  doc: [],\n                  module: d.module,\n                  public: false,\n                  kind: ast.FnDef(f),\n                },\n              )\n            }\n          },\n          Err(msg) => mut errors.push((desugar.decl_name(d), msg)),\n        }\n      } else {\n        mut out.push(d)\n      },\n      _ => mut out.push(d),\n    }\n  }\n  (all, wrong) := derive.value_uses(out + extra)\n  (all, errors + wrong)\n}","old_text":"fn derive_all(\n  decls: List[ast.Decl],\n  context: List[ast.Decl],\n) -> (List[ast.Decl], List[(String, String)]) {\n  if !decls.any(d -> derive.is_derive(d)) {\n    return (decls, [])\n  }\n  ix := derive.defs_of(context + decls)\n  w := eval.world(context + decls)\n  mut out := []\n  mut extra := []\n  mut errors := []\n  for d in decls {\n    match d.kind {\n      ast.DeriveFnDef(f) => if f.derived {\n        for function in derive.derived_functions(\n          context + decls,\n          d.module,\n          f.function,\n          ix,\n        ) {\n          mut x := derive.new_expander(ix, w, d.module)\n          match derive.derive_fn(\n            mut x,\n            ast.DeriveFnDecl { ..f, function },\n          ) {\n            Ok((made, fns)) => {\n              mut out.push(\n                ast.Decl { ..d, kind: ast.DeriveFnDef(made) },\n              )\n              for g in fns {\n                mut extra.push(\n                  ast.Decl {\n                    comments: [],\n                    doc: [],\n                    module: d.module,\n                    public: false,\n                    kind: ast.FnDef(g),\n                  },\n                )\n              }\n            },\n            Err(msg) => mut errors.push((desugar.decl_name(d), msg)),\n          }\n        }\n      } else {\n        mut out.push(d)\n      },\n      ast.ImplDef(i) => if i.derived {\n        mut x := derive.new_expander(ix, w, d.module)\n        match derive.derive(mut x, i) {\n          Ok(imp) => {\n            mut out.push(ast.Decl { ..d, kind: ast.ImplDef(imp) })\n            for f in x.copies {\n              mut extra.push(\n                ast.Decl {\n                  comments: [],\n                  doc: [],\n                  module: d.module,\n                  public: false,\n                  kind: ast.FnDef(f),\n                },\n              )\n            }\n          },\n          Err(msg) => mut errors.push((desugar.decl_name(d), msg)),\n        }\n      } else {\n        mut out.push(d)\n      },\n      _ => mut out.push(d),\n    }\n  }\n  (out + extra, errors)\n}"},{"name":"derive.derive_fn","kind":"fn","old":"72c94ca394aed5dd","new":"ff291fa003ec6e64","interface_changed":false,"affected":[],"module":"derive","text":"/// `derive C for add`: a trait derived over a function. `Self` is the\n/// function, described as a `Type` of kind `Function` with its name, doc\n/// and `parameters`. A function has no type to put an `impl` on, so the\n/// output is top-level. Each `derived fn` of the trait gives an export or\n/// part of a file, by its signature alone:\n/// - `derived fn export() -> Self = Self`: the function itself, exported\n/// under its own name (`(\"add\", \"add\")` in `exports`).\n/// - `derived fn h() -> String { ... }`: specialized into a top-level\n/// function of the derive's module (`add.C.h`). Its value, folded at\n/// compile time, is the function's part of the file `<name>.h` that a\n/// library build writes (`(\"h\", \"add.C.h\")` in `files`).\n/// - `derived fn json(args: String) -> String { ... }`, one with\n/// parameters: a wrapper, specialized into a top-level function\n/// (`add.Python.json`) exported as `NAME_METHOD` (`(\"add_json\",\n/// \"add.Python.json\")` in `exports`). Its parameters and result cross\n/// as `derive C`'s do.\n/// - `derived fn tool() -> Tool { ... }`, one without parameters giving\n/// another type: a value standing for the function, specialized into a\n/// top-level function (`add.Tool.tool`) taking the parameters the derive\n/// binds (`bind: net`), listed in `values`. `value_uses` puts its call where\n/// the function is used as a value.\n/// The second part of the result is the functions made.\nfn derive_fn(\n  mut x: derive.Expander,\n  given: ast.DeriveFnDecl,\n) -> Result[(ast.DeriveFnDecl, List[ast.FnDecl]), String] {\n  tr := match get(x.ix.traits, given.trait_name) {\n    Some(t) => t,\n    None => return Err(\"`\" + derive.short(given.trait_name) + \"` is not a trait\"),\n  }\n  fname := derive.short(given.function)\n  dv := match tr.derivable {\n    Some(d) => d,\n    None => return Err(\"`\"\n      + derive.short(tr.name)\n      + \"` can't be derived: only a `derivable` trait can\"),\n  }\n  f := match get(x.ix.fns, given.function) {\n    Some(f) => f,\n    None => return Err(\"`\" + fname + \"` is not a function defined in this program\"),\n  }\n  ks := match dv.kind {\n    ast.UnionType(ms) => ms,\n    k => [k],\n  }\n  if !ks.any(k -> derive.short(derive.type_head(k)) == \"Function\") {\n    names := join(\n      ks.map(k -> \"`\" + derive.short(derive.type_head(k)) + \"`\"),\n      \" or a \",\n    )\n    return Err(\"`\"\n      + derive.short(tr.name)\n      + \"` can only be derived for a \"\n      + names\n      + \", and `\"\n      + fname\n      + \"` is a function\")\n  }\n  if f.type_params != [] {\n    return Err(\"`\"\n      + fname\n      + \"` has type parameters: `\"\n      + derive.short(tr.name)\n      + \"` is derived for a function whose types are known (one calling `\"\n      + fname\n      + \"` with them)\")\n  }\n  bound := derive.bound_of(given.clauses)\n  for b in bound {\n    if !f.params.any(p -> p.name == b) {\n      return Err(\"`\" + fname + \"` has no parameter `\" + b + \"` to bind\")\n    }\n  }\n  x.clauses = given.clauses\n  x.bound = bound\n  self_ty := ast.FnType { params: f.params.map(p -> p.ty), ret: f.ret }\n  _ := derive.fn_value(mut x, given.function, f, self_ty)\n  x.self_ty = self_ty\n  x.trait_name = given.trait_name\n  x.self_fn = given.function\n  x.trait_methods = tr.methods.map(m -> m.decl.name)\n  for r in dv.conditions {\n    r2 := derive.expr(mut x, r)!\n    ok := match derive.eval_as(mut x, r2, r) {\n      Ok(v) => v,\n      Err(m) => return Err(\n        \"checking what `\"\n          + derive.short(tr.name)\n          + \"` requires: \"\n          + m,\n      ),\n    }\n    if ok != ast.BoolLit(true) {\n      return Err(\"`\"\n        + fname\n        + \"` doesn't meet what `\"\n        + derive.short(tr.name)\n        + \"` requires: \"\n        + text.expr_text(r, 0))\n    }\n  }\n  mut exports := []\n  mut files := []\n  mut made := []\n  mut values := []\n  for m in tr.methods {\n    if !m.decl.derived {\n      continue\n    }\n    shape := \"`\" + derive.short(tr.name) + \"`'s `\" + m.decl.name + \"`\"\n    if m.decl.params != [] {\n      // a wrapper of the function, exported as `NAME_METHOD`\n      body := match derive.expr(mut x, m.decl.body) {\n        Ok(b) => b,\n        Err(e) => return Err(\"deriving `\" + m.decl.name + \"`: \" + e),\n      }\n      name := fname + \".\" + derive.short(tr.name) + \".\" + m.decl.name\n      mut made.push(\n        ast.FnDecl { ..m.decl, name, derived: false, compile_time: false, body },\n      )\n      mut exports.push(\n        (fname + \"_\" + m.decl.name, derive.qualify(x.module, name)),\n      )\n      continue\n    }\n    if derive.type_head(m.decl.ret) == \"Self\" {\n      if !derive.is_self(m.decl.body) {\n        return Err(\n          shape\n            + \" exports something other than the function itself (`= Self`): not built yet\",\n        )\n      }\n      mut exports.push((fname, given.function))\n    } else if derive.type_head(m.decl.ret) == \"String\" {\n      body := match derive.expr(mut x, m.decl.body) {\n        Ok(b) => b,\n        Err(e) => return Err(\"deriving `\" + m.decl.name + \"`: \" + e),\n      }\n      name := fname + \".\" + derive.short(tr.name) + \".\" + m.decl.name\n      mut made.push(\n        ast.FnDecl { ..m.decl, name, derived: false, compile_time: false, body },\n      )\n      mut files.push((m.decl.name, derive.qualify(x.module, name)))\n    } else if m.decl.params == [] {\n      // a value standing for the function where it is used as one: a\n      // function taking the bound parameters (`search.with(net)`)\n      body := match derive.expr(mut x, m.decl.body) {\n        Ok(b) => b,\n        Err(e) => return Err(\"deriving `\" + m.decl.name + \"`: \" + e),\n      }\n      name := fname + \".\" + derive.short(tr.name) + \".\" + m.decl.name\n      mut made.push(\n        ast.FnDecl { ..m.decl, name, params: f.params.filter(p -> bound.contains(p.name)), derived: false, compile_time: false, body },\n      )\n      mut values.push(derive.qualify(x.module, name))\n    } else {\n      return Err(\n        shape\n          + \" gives a `\"\n          + text.type_text(m.decl.ret)\n          + \"`: a derive for a function makes exports (`-> Self = Self`, or a wrapper taking parameters) and parts of files (`-> String`)\",\n      )\n    }\n  }\n  Ok((\n    ast.DeriveFnDecl { ..given, derived: false, exports, files, values },\n    made + x.copies,\n  ))\n}","old_text":"/// `derive C for add`: a trait derived over a function. `Self` is the\n/// function, described as a `Type` of kind `Function` with its name, doc\n/// and `parameters`. A function has no type to put an `impl` on, so the\n/// output is top-level. Each `derived fn` of the trait gives an export or\n/// part of a file, by its signature alone:\n/// - `derived fn export() -> Self = Self`: the function itself, exported\n/// under its own name (`(\"add\", \"add\")` in `exports`).\n/// - `derived fn h() -> String { ... }`: specialized into a top-level\n/// function of the derive's module (`add.C.h`). Its value, folded at\n/// compile time, is the function's part of the file `<name>.h` that a\n/// library build writes (`(\"h\", \"add.C.h\")` in `files`).\n/// - `derived fn json(args: String) -> String { ... }`, one with\n/// parameters: a wrapper, specialized into a top-level function\n/// (`add.Python.json`) exported as `NAME_METHOD` (`(\"add_json\",\n/// \"add.Python.json\")` in `exports`). Its parameters and result cross\n/// as `derive C`'s do.\n/// The second part of the result is the functions made.\nfn derive_fn(\n  mut x: derive.Expander,\n  given: ast.DeriveFnDecl,\n) -> Result[(ast.DeriveFnDecl, List[ast.FnDecl]), String] {\n  tr := match get(x.ix.traits, given.trait_name) {\n    Some(t) => t,\n    None => return Err(\"`\" + derive.short(given.trait_name) + \"` is not a trait\"),\n  }\n  fname := derive.short(given.function)\n  dv := match tr.derivable {\n    Some(d) => d,\n    None => return Err(\"`\"\n      + derive.short(tr.name)\n      + \"` can't be derived: only a `derivable` trait can\"),\n  }\n  f := match get(x.ix.fns, given.function) {\n    Some(f) => f,\n    None => return Err(\"`\" + fname + \"` is not a function defined in this program\"),\n  }\n  ks := match dv.kind {\n    ast.UnionType(ms) => ms,\n    k => [k],\n  }\n  if !ks.any(k -> derive.short(derive.type_head(k)) == \"Function\") {\n    names := join(\n      ks.map(k -> \"`\" + derive.short(derive.type_head(k)) + \"`\"),\n      \" or a \",\n    )\n    return Err(\"`\"\n      + derive.short(tr.name)\n      + \"` can only be derived for a \"\n      + names\n      + \", and `\"\n      + fname\n      + \"` is a function\")\n  }\n  if f.type_params != [] {\n    return Err(\"`\"\n      + fname\n      + \"` has type parameters: `\"\n      + derive.short(tr.name)\n      + \"` is derived for a function whose types are known (one calling `\"\n      + fname\n      + \"` with them)\")\n  }\n  self_ty := ast.FnType { params: f.params.map(p -> p.ty), ret: f.ret }\n  _ := derive.fn_value(mut x, given.function, f, self_ty)\n  x.self_ty = self_ty\n  x.trait_name = given.trait_name\n  x.self_fn = given.function\n  x.trait_methods = tr.methods.map(m -> m.decl.name)\n  for r in dv.conditions {\n    r2 := derive.expr(mut x, r)!\n    ok := match derive.eval_as(mut x, r2, r) {\n      Ok(v) => v,\n      Err(m) => return Err(\n        \"checking what `\"\n          + derive.short(tr.name)\n          + \"` requires: \"\n          + m,\n      ),\n    }\n    if ok != ast.BoolLit(true) {\n      return Err(\"`\"\n        + fname\n        + \"` doesn't meet what `\"\n        + derive.short(tr.name)\n        + \"` requires: \"\n        + text.expr_text(r, 0))\n    }\n  }\n  mut exports := []\n  mut files := []\n  mut made := []\n  for m in tr.methods {\n    if !m.decl.derived {\n      continue\n    }\n    shape := \"`\" + derive.short(tr.name) + \"`'s `\" + m.decl.name + \"`\"\n    if m.decl.params != [] {\n      // a wrapper of the function, exported as `NAME_METHOD`\n      body := match derive.expr(mut x, m.decl.body) {\n        Ok(b) => b,\n        Err(e) => return Err(\"deriving `\" + m.decl.name + \"`: \" + e),\n      }\n      name := fname + \".\" + derive.short(tr.name) + \".\" + m.decl.name\n      mut made.push(\n        ast.FnDecl { ..m.decl, name, derived: false, compile_time: false, body },\n      )\n      mut exports.push(\n        (fname + \"_\" + m.decl.name, derive.qualify(x.module, name)),\n      )\n      continue\n    }\n    if derive.type_head(m.decl.ret) == \"Self\" {\n      if !derive.is_self(m.decl.body) {\n        return Err(\n          shape\n            + \" exports something other than the function itself (`= Self`): not built yet\",\n        )\n      }\n      mut exports.push((fname, given.function))\n    } else if derive.type_head(m.decl.ret) == \"String\" {\n      body := match derive.expr(mut x, m.decl.body) {\n        Ok(b) => b,\n        Err(e) => return Err(\"deriving `\" + m.decl.name + \"`: \" + e),\n      }\n      name := fname + \".\" + derive.short(tr.name) + \".\" + m.decl.name\n      mut made.push(\n        ast.FnDecl { ..m.decl, name, derived: false, compile_time: false, body },\n      )\n      mut files.push((m.decl.name, derive.qualify(x.module, name)))\n    } else {\n      return Err(\n        shape\n          + \" gives a `\"\n          + text.type_text(m.decl.ret)\n          + \"`: a derive for a function makes exports (`-> Self = Self`, or a wrapper taking parameters) and parts of files (`-> String`)\",\n      )\n    }\n  }\n  Ok((\n    ast.DeriveFnDecl { ..given, derived: false, exports, files },\n    made + x.copies,\n  ))\n}"},{"name":"derive.fn_value","kind":"fn","old":"674ec632edc62852","new":"0a9a085492fcd1bd","interface_changed":false,"affected":[],"module":"derive","text":"/// The function `name` as a `std.typing.Type` of kind `Function`: its\n/// type's value with its name, doc and parameters by name. It is `Self`\n/// while deriving for it.\nfn fn_value(\n  mut x: derive.Expander,\n  name: String,\n  f: ast.FnDecl,\n  t: ast.TypeExpr,\n) -> ast.Expr {\n  base := derive.type_value(mut x, t)\n  mut stack := []\n  mut ps := []\n  for p in f.params {\n    mut ps.push(derive.field(mut x, p.name, [], p.ty, None, mut stack))\n  }\n  mut v := derive.set_field(\n    derive.set_field(derive.set_field(\n      base,\n      \"name\",\n      derive.some(ast.StrLit(derive.short(name))),\n    ), \"doc\", derive.strs(get(x.ix.docs, name) ?? [])),\n    \"parameters\",\n    ast.ListExpr(ps),\n  )\n  v = derive.set_field(v, \"clauses\", derive.clause_values(x.clauses))\n  mut x.type_values.insert(text.type_text(t), v)\n  derive.remember(mut x, v, t)\n  v\n}","old_text":"/// The function `name` as a `std.typing.Type` of kind `Function`: its\n/// type's value with its name, doc and parameters by name. It is `Self`\n/// while deriving for it.\nfn fn_value(\n  mut x: derive.Expander,\n  name: String,\n  f: ast.FnDecl,\n  t: ast.TypeExpr,\n) -> ast.Expr {\n  base := derive.type_value(mut x, t)\n  mut stack := []\n  mut ps := []\n  for p in f.params {\n    mut ps.push(derive.field(mut x, p.name, [], p.ty, None, mut stack))\n  }\n  v := derive.set_field(\n    derive.set_field(derive.set_field(\n      base,\n      \"name\",\n      derive.some(ast.StrLit(derive.short(name))),\n    ), \"doc\", derive.strs(get(x.ix.docs, name) ?? [])),\n    \"parameters\",\n    ast.ListExpr(ps),\n  )\n  mut x.type_values.insert(text.type_text(t), v)\n  derive.remember(mut x, v, t)\n  v\n}"},{"name":"derive.call_fn","kind":"fn","old":"e9e32087302929fb","new":"a227849b1f0c26c3","interface_changed":false,"affected":[],"module":"derive","text":"/// `Self.call(p -> e)` or `Self.try_call(p -> e)` in a derive for a\n/// function described by `d`: a call of the function with `e` for each\n/// argument (`p` is that parameter, a `Field`; `p.type` its type).\n/// `try_call`: each argument is a `Result`; the first `Err` is the result,\n/// else `Ok` of the call's.\nfn call_fn(\n  mut x: derive.Expander,\n  d: ast.Expr,\n  fallible: Bool,\n  args: List[ast.Expr],\n) -> Result[ast.Expr, String] {\n  if derive.str_of(d, \"name\") != Some(derive.short(x.self_fn)) {\n    return Err(\n      \"`call` and `try_call` call the function the `derive` is for (`Self`)\",\n    )\n  }\n  params := match derive.get_field(d, \"parameters\") {\n    Some(ast.ListExpr(xs)) => xs,\n    _ => [],\n  }\n  mut vals := []\n  match args {\n    [ast.Lambda { params: [p], body }] => {\n      for f in params {\n        pname := derive.str_of(f, \"name\") ?? \"\"\n        if x.bound.contains(pname) {\n          // a bound parameter: the value function's own\n          mut vals.push(\n            if fallible {\n              ast.CtorExpr {\n                name: \"Ok\",\n                args: ast.PositionalArgs([ast.Var(pname)]),\n              }\n            } else {\n              ast.Var(pname)\n            },\n          )\n          continue\n        }\n        ft := match derive.get_field(f, \"type\") {\n          Some(tv) => match derive.type_of(x, tv) {\n            Ok(y) => Some((p.name + \".type\", y)),\n            Err(_) => None,\n          },\n          None => None,\n        }\n        mut vals.push(\n          derive.with_known(mut x, [(p.name, f, ft)], body)!,\n        )\n      }\n    },\n    [] => if params != [] {\n      return Err(\n        \"`call` takes a function giving each argument: `Self.call(p -> e)`\",\n      )\n    },\n    _ => return Err(\n      \"`call` takes a function giving each argument: `Self.call(p -> e)`\",\n    ),\n  }\n  if !fallible {\n    return Ok(ast.Call { callee: ast.Var(x.self_fn), args: vals })\n  }\n  // match a1 { Ok(v1) => match a2 { ... Ok(f(v1, ..)) }, Err(e) => Err(e) }\n  names := [f\"called.{k}\" for k in 0..len(vals)]\n  mut out := ast.CtorExpr { name: \"Ok\", args: ast.PositionalArgs([ast.Call {\n    callee: ast.Var(x.self_fn),\n    args: names.map(n -> ast.Var(n)),\n  }]) }\n  for k in 0..len(vals) {\n    j := len(vals) - 1 - k\n    out = ast.MatchExpr {\n      scrutinee: get(vals, j) ?? ast.UnitExpr,\n      binding: None,\n      arms: [ast.Arm { comments: [], pat: ast.CtorPattern {\n        name: \"Ok\",\n        args: ast.PositionalPats([ast.Bind(get(names, j) ?? \"\")]),\n      }, body: out }, ast.Arm { comments: [], pat: ast.CtorPattern {\n        name: \"Err\",\n        args: ast.PositionalPats([ast.Bind(\"called.err\")]),\n      }, body: ast.CtorExpr {\n        name: \"Err\",\n        args: ast.PositionalArgs([ast.Var(\"called.err\")]),\n      } }],\n    }\n  }\n  Ok(out)\n}","old_text":"/// `Self.call(p -> e)` or `Self.try_call(p -> e)` in a derive for a\n/// function described by `d`: a call of the function with `e` for each\n/// argument (`p` is that parameter, a `Field`; `p.type` its type).\n/// `try_call`: each argument is a `Result`; the first `Err` is the result,\n/// else `Ok` of the call's.\nfn call_fn(\n  mut x: derive.Expander,\n  d: ast.Expr,\n  fallible: Bool,\n  args: List[ast.Expr],\n) -> Result[ast.Expr, String] {\n  if derive.str_of(d, \"name\") != Some(derive.short(x.self_fn)) {\n    return Err(\n      \"`call` and `try_call` call the function the `derive` is for (`Self`)\",\n    )\n  }\n  params := match derive.get_field(d, \"parameters\") {\n    Some(ast.ListExpr(xs)) => xs,\n    _ => [],\n  }\n  mut vals := []\n  match args {\n    [ast.Lambda { params: [p], body }] => {\n      for f in params {\n        ft := match derive.get_field(f, \"type\") {\n          Some(tv) => match derive.type_of(x, tv) {\n            Ok(y) => Some((p.name + \".type\", y)),\n            Err(_) => None,\n          },\n          None => None,\n        }\n        mut vals.push(\n          derive.with_known(mut x, [(p.name, f, ft)], body)!,\n        )\n      }\n    },\n    [] => if params != [] {\n      return Err(\n        \"`call` takes a function giving each argument: `Self.call(p -> e)`\",\n      )\n    },\n    _ => return Err(\n      \"`call` takes a function giving each argument: `Self.call(p -> e)`\",\n    ),\n  }\n  if !fallible {\n    return Ok(ast.Call { callee: ast.Var(x.self_fn), args: vals })\n  }\n  // match a1 { Ok(v1) => match a2 { ... Ok(f(v1, ..)) }, Err(e) => Err(e) }\n  names := [f\"called.{k}\" for k in 0..len(vals)]\n  mut out := ast.CtorExpr { name: \"Ok\", args: ast.PositionalArgs([ast.Call {\n    callee: ast.Var(x.self_fn),\n    args: names.map(n -> ast.Var(n)),\n  }]) }\n  for k in 0..len(vals) {\n    j := len(vals) - 1 - k\n    out = ast.MatchExpr {\n      scrutinee: get(vals, j) ?? ast.UnitExpr,\n      binding: None,\n      arms: [ast.Arm { comments: [], pat: ast.CtorPattern {\n        name: \"Ok\",\n        args: ast.PositionalPats([ast.Bind(get(names, j) ?? \"\")]),\n      }, body: out }, ast.Arm { comments: [], pat: ast.CtorPattern {\n        name: \"Err\",\n        args: ast.PositionalPats([ast.Bind(\"called.err\")]),\n      }, body: ast.CtorExpr {\n        name: \"Err\",\n        args: ast.PositionalArgs([ast.Var(\"called.err\")]),\n      } }],\n    }\n  }\n  Ok(out)\n}"},{"name":"derive.clause_values","kind":"fn","old":null,"new":"3ae925f881cfc4c5","interface_changed":true,"affected":[],"module":"derive","text":"/// Clauses as `std.typing.Clause` values.\nfn clause_values(cs: List[ast.DeriveClause]) -> ast.Expr {\n  ast.ListExpr(cs.map(\n    c -> derive.record(\n      \"Clause\",\n      [\n        (\"name\", ast.StrLit(c.name)),\n        (\"names\", derive.strs(c.names)),\n      ],\n    ),\n  ))\n}"},{"name":"derive.value_uses","kind":"fn","old":null,"new":"0394c9bff0d1985e","interface_changed":true,"affected":[],"module":"derive","text":"/// Where a function with a derived value (`derive Tool for add`) is used as\n/// a value, not called: the value (`add.Tool.tool()`), or with its bound\n/// parameters given, `search.with(net)` (`search.Tool.tool(net)`). A\n/// function with bound parameters used without `.with` is an error.\nfn value_uses(\n  decls: List[ast.Decl],\n) -> (List[ast.Decl], List[(String, String)]) {\n  mut values := Dict[String, (String, List[String])] {}\n  for d in decls {\n    match d.kind {\n      ast.DeriveFnDef(f) => {\n        for v in f.values {\n          bound := derive.bound_of(f.clauses)\n          mut values.insert(f.function, (v, bound))\n        }\n      },\n      _ => (),\n    }\n  }\n  if len(values) == 0 {\n    return (decls, [])\n  }\n  mut out := []\n  mut errors := []\n  for d in decls {\n    r := walk.rewrite_decl(d, e -> derive.value_use(values, e))\n    mut out.push(r)\n    for name in keys(values) {\n      unbound := \"$unbound.\" + name\n      if walk.decl_exprs(r).any(\n        x -> walk.any_expr(x, e -> e == ast.Var(unbound)),\n      ) {\n        (_, bound) := get(values, name) ?? (\"\", [])\n        f := derive.short(name)\n        needs := join(bound, \"`, `\")\n        given := join(bound, \", \")\n        mut errors.push(\n          (\n            desugar.decl_name(d),\n            f\"`{f}` needs `{needs}`: write `{f}.with({given})`\",\n          ),\n        )\n      }\n    }\n  }\n  (out, errors)\n}"},{"name":"derive.value_use","kind":"fn","old":null,"new":"c87def7d06238e8d","interface_changed":true,"affected":[],"module":"derive","text":"/// One step of `value_uses`, innermost first: a name becomes its value (or\n/// a mark, `$unbound.NAME`, when it needs `.with`); a call of the value\n/// (the function called) and `.with(..)` on it are put back.\nfn value_use(\n  values: Dict[String, (String, List[String])],\n  e: ast.Expr,\n) -> ast.Expr {\n  match e {\n    ast.Var(name) => match get(values, name) {\n      Some((v, bound)) => if bound == [] {\n        ast.Call { callee: ast.Var(v), args: [] }\n      } else {\n        ast.Var(\"$unbound.\" + name)\n      },\n      None => e,\n    },\n    ast.Call { callee, args } => match derive.original(values, callee) {\n      Some(name) => ast.Call { callee: ast.Var(name), args },\n      None => e,\n    },\n    ast.MethodCall { recv, name, args } => if name == \"with\" {\n      match derive.original(values, recv) {\n        Some(f) => match get(values, f) {\n          Some((v, _)) => ast.Call { callee: ast.Var(v), args },\n          None => e,\n        },\n        None => e,\n      }\n    } else {\n      e\n    },\n    _ => e,\n  }\n}"},{"name":"derive.original","kind":"fn","old":null,"new":"9a06853998cf6460","interface_changed":true,"affected":[],"module":"derive","text":"/// The function a rewritten name stood for.\nfn original(\n  values: Dict[String, (String, List[String])],\n  e: ast.Expr,\n) -> Option[String] {\n  for (name, vb) in values {\n    if (e == ast.Var(\"$unbound.\" + name)\n      || e == ast.Call { callee: ast.Var(vb.0), args: [] }) {\n      return Some(name)\n    }\n  }\n  None\n}"},{"name":"derive.bound_of","kind":"fn","old":null,"new":"0f05e9872b54b8f5","interface_changed":true,"affected":[],"module":"derive","text":"/// The parameters a derive's `bind` clauses name.\nfn bound_of(cs: List[ast.DeriveClause]) -> List[String] {\n  mut out := []\n  for c in cs {\n    if c.name == \"bind\" {\n      out += c.names\n    }\n  }\n  out\n}"}]}
{"id":"548734b2115ebf03","time":1795722064,"message":"edit","changes":[{"name":"derive.value_uses","kind":"fn","old":"0394c9bff0d1985e","new":"633ea2a16e2b5de3","interface_changed":true,"affected":["derive.derive_all","derive.derived_in","derive.expand_with","derive.expand_in","std_reached","expanded","check_errors_in","derive.expand","holes_command","check_summary","verified_decls","verify_file","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","eval_files","instantiated_files","with_extra","command_line","check_command","verified_with","static_graph","verify_command","build_proofs","alongside_command","search_invariants","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","repl_command","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","main","strata_command","verified_program","build_command","graph_command","graph_diff","tour_graph","run_command","fix_loops","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","or_solver_inputs","program_objects","package_errors","merge_file_command","merged_checks","core_rt_text","call_command","edit_command","check_files","rename_command","move_command","fix_command","edit_in_editor","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","smt_file","termination_file","diff_command","tour_command","check_fn","linked","sync_command","build_core_command","computed_value","codegen.read_back","comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"/// Where a function with a derived value (`derive Tool for add`) is used as\n/// a value, not called: the value (`add.Tool.tool()`), or with its bound\n/// parameters given, `search.with(net)` (`search.Tool.tool(net)`). A\n/// function with bound parameters used without `.with` is an error.\npub fn value_uses(\n  decls: List[ast.Decl],\n) -> (List[ast.Decl], List[(String, String)]) {\n  mut values := Dict[String, (String, List[String])] {}\n  for d in decls {\n    match d.kind {\n      ast.DeriveFnDef(f) => {\n        for v in f.values {\n          bound := derive.bound_of(f.clauses)\n          mut values.insert(f.function, (v, bound))\n        }\n      },\n      _ => (),\n    }\n  }\n  if len(values) == 0 {\n    return (decls, [])\n  }\n  mut out := []\n  mut errors := []\n  for d in decls {\n    r := walk.rewrite_decl(d, e -> derive.value_use(values, e))\n    mut out.push(r)\n    for name in keys(values) {\n      unbound := \"$unbound.\" + name\n      if walk.decl_exprs(r).any(\n        x -> walk.any_expr(x, e -> e == ast.Var(unbound)),\n      ) {\n        (_, bound) := get(values, name) ?? (\"\", [])\n        f := derive.short(name)\n        needs := join(bound, \"`, `\")\n        given := join(bound, \", \")\n        mut errors.push(\n          (\n            desugar.decl_name(d),\n            f\"`{f}` needs `{needs}`: write `{f}.with({given})`\",\n          ),\n        )\n      }\n    }\n  }\n  (out, errors)\n}","old_text":"/// Where a function with a derived value (`derive Tool for add`) is used as\n/// a value, not called: the value (`add.Tool.tool()`), or with its bound\n/// parameters given, `search.with(net)` (`search.Tool.tool(net)`). A\n/// function with bound parameters used without `.with` is an error.\nfn value_uses(\n  decls: List[ast.Decl],\n) -> (List[ast.Decl], List[(String, String)]) {\n  mut values := Dict[String, (String, List[String])] {}\n  for d in decls {\n    match d.kind {\n      ast.DeriveFnDef(f) => {\n        for v in f.values {\n          bound := derive.bound_of(f.clauses)\n          mut values.insert(f.function, (v, bound))\n        }\n      },\n      _ => (),\n    }\n  }\n  if len(values) == 0 {\n    return (decls, [])\n  }\n  mut out := []\n  mut errors := []\n  for d in decls {\n    r := walk.rewrite_decl(d, e -> derive.value_use(values, e))\n    mut out.push(r)\n    for name in keys(values) {\n      unbound := \"$unbound.\" + name\n      if walk.decl_exprs(r).any(\n        x -> walk.any_expr(x, e -> e == ast.Var(unbound)),\n      ) {\n        (_, bound) := get(values, name) ?? (\"\", [])\n        f := derive.short(name)\n        needs := join(bound, \"`, `\")\n        given := join(bound, \", \")\n        mut errors.push(\n          (\n            desugar.decl_name(d),\n            f\"`{f}` needs `{needs}`: write `{f}.with({given})`\",\n          ),\n        )\n      }\n    }\n  }\n  (out, errors)\n}"}]}
{"id":"10a6c0b1428e845a","time":1795722072,"message":"edit","changes":[{"name":"expanded","kind":"fn","old":"00d4e3088721e89c","new":"a7499ab199c12f76","interface_changed":false,"affected":[],"module":"","text":"/// The program `own` as it runs (`codegen_with`): desugared, its `derive`s\n/// expanded and its `comptime e` folded, with the std modules it uses (read\n/// from `std/`, until what the expanded code names is there too) and core's\n/// code. Also returns its errors, and std as loaded.\n/// \n/// Each definition is desugared once: a round takes the std definitions\n/// that the code made by the last round names, with what was made before\n/// as context. The `derive`s are made again while std grows, since what\n/// they make depends on std's code. `comptime e` is folded once all of it\n/// is loaded (compiled with the whole program), then the std its values\n/// name, if any, is taken the same way.\nfn expanded(\n  disk: std.fs.Disk,\n  sh: Shared,\n  own: List[ast.Decl],\n) -> (List[ast.Decl], List[(String, String)], Loading) {\n  code := sh.code\n  // (`comptime e`: compiled and run by the JIT in this process, or read back\n  // from an earlier run. std's definitions are keyed by their code hashes,\n  // as std is loaded when they run: `lib_hashes`. A library's own\n  // compile-time code runs with only the libraries' definitions and core's:\n  // `lib_world`.)\n  run := (st: Loading) -> {\n    hashes := lib_hashes(st)\n    (ds: List[ast.Decl], m: String, es: List[ast.Expr]) -> {\n      (world, hs) := lib_world(st, code, hashes, ds, m)\n      timings.timed(\"comptime\", () -> comptime_values(\n        disk,\n        sh.core,\n        sh.prelude,\n        settings_stamp(sh),\n        sh.cache,\n        hs,\n        world,\n        m,\n        es,\n      ))\n    }\n  }\n  timings.begin(\"load std\")\n  mut st := std_loading(disk, own)\n  load(mut st, disk, std_roots(own))\n  timings.end(\"load std\")\n  // (core's types, for `derive` to read: `t.check(x)` of a `Positive`\n  // checks its refinement. Left out of the result: the prelude has them.)\n  core_types := sh.prelude.filter(\n    d -> starts_with(d.module, \"core\") && d.kind is ast.TypeDef,\n  )\n  // the definitions desugared: `comptime e` folded in the first `folded` of\n  // `plain`; the `derive`s, and what they made last\n  mut plain := []\n  mut folded := 0\n  mut derives := []\n  mut made := []\n  mut derive_errors := []\n  mut fold_errors := []\n  mut texts := []\n  mut new := own + st.out + code\n  for _ in 0..16 {\n    (sweet, _, more) := timings.timed(\n      \"desugar\",\n      () -> desugar.desugar_more(new, plain + derives, texts),\n    )\n    texts = more\n    given := derive.with_settings(sweet, sh.settings)\n    fresh := without_core_types(\n      derive.derived_in(given.filter(d -> !is_derive(d)), []).0,\n    )\n    plain += fresh\n    derives += given.filter(d -> is_derive(d))\n    n := len(st.out)\n    if len(derives) > 0 {\n      d := timings.timed(\n        \"derive\",\n        () -> derive.derived_in(derives, plain + core_types),\n      )\n      made = without_core_types(d.0)\n      derive_errors = d.1\n    }\n    timings.begin(\"load std\")\n    load(mut st, disk, std_roots(fresh + made))\n    timings.end(\"load std\")\n    if len(st.out) == n {\n      f := derive.folded_in(\n        plain[folded..] + made,\n        plain[..folded] + core_types,\n        run(st),\n      )\n      fold_errors += f.1\n      kept := len(plain) - folded\n      plain = plain[..folded] + f.0[..kept]\n      made = f.0[kept..]\n      folded = len(plain)\n      load(mut st, disk, std_roots(f.0))\n      if len(st.out) == n {\n        break\n      }\n    }\n    new = st.out[n..]\n  }\n  // a function with a derived value used as one (`derive Tool for add`)\n  (valued, value_errors) := derive.value_uses(plain + made)\n  // each call spreading records written out (`f(...x)` is `f(x.a, x.b)`)\n  (program, spread_errors) := timings.timed(\n    \"spreads\",\n    () -> check.spreads_resolved(valued, [], sh.core),\n  )\n  (\n    program,\n    derive_errors + fold_errors + value_errors + spread_errors,\n    st,\n  )\n}","old_text":"/// The program `own` as it runs (`codegen_with`): desugared, its `derive`s\n/// expanded and its `comptime e` folded, with the std modules it uses (read\n/// from `std/`, until what the expanded code names is there too) and core's\n/// code. Also returns its errors, and std as loaded.\n/// \n/// Each definition is desugared once: a round takes the std definitions\n/// that the code made by the last round names, with what was made before\n/// as context. The `derive`s are made again while std grows, since what\n/// they make depends on std's code. `comptime e` is folded once all of it\n/// is loaded (compiled with the whole program), then the std its values\n/// name, if any, is taken the same way.\nfn expanded(\n  disk: std.fs.Disk,\n  sh: Shared,\n  own: List[ast.Decl],\n) -> (List[ast.Decl], List[(String, String)], Loading) {\n  code := sh.code\n  // (`comptime e`: compiled and run by the JIT in this process, or read back\n  // from an earlier run. std's definitions are keyed by their code hashes,\n  // as std is loaded when they run: `lib_hashes`. A library's own\n  // compile-time code runs with only the libraries' definitions and core's:\n  // `lib_world`.)\n  run := (st: Loading) -> {\n    hashes := lib_hashes(st)\n    (ds: List[ast.Decl], m: String, es: List[ast.Expr]) -> {\n      (world, hs) := lib_world(st, code, hashes, ds, m)\n      timings.timed(\"comptime\", () -> comptime_values(\n        disk,\n        sh.core,\n        sh.prelude,\n        settings_stamp(sh),\n        sh.cache,\n        hs,\n        world,\n        m,\n        es,\n      ))\n    }\n  }\n  timings.begin(\"load std\")\n  mut st := std_loading(disk, own)\n  load(mut st, disk, std_roots(own))\n  timings.end(\"load std\")\n  // (core's types, for `derive` to read: `t.check(x)` of a `Positive`\n  // checks its refinement. Left out of the result: the prelude has them.)\n  core_types := sh.prelude.filter(\n    d -> starts_with(d.module, \"core\") && d.kind is ast.TypeDef,\n  )\n  // the definitions desugared: `comptime e` folded in the first `folded` of\n  // `plain`; the `derive`s, and what they made last\n  mut plain := []\n  mut folded := 0\n  mut derives := []\n  mut made := []\n  mut derive_errors := []\n  mut fold_errors := []\n  mut texts := []\n  mut new := own + st.out + code\n  for _ in 0..16 {\n    (sweet, _, more) := timings.timed(\n      \"desugar\",\n      () -> desugar.desugar_more(new, plain + derives, texts),\n    )\n    texts = more\n    given := derive.with_settings(sweet, sh.settings)\n    fresh := without_core_types(\n      derive.derived_in(given.filter(d -> !is_derive(d)), []).0,\n    )\n    plain += fresh\n    derives += given.filter(d -> is_derive(d))\n    n := len(st.out)\n    if len(derives) > 0 {\n      d := timings.timed(\n        \"derive\",\n        () -> derive.derived_in(derives, plain + core_types),\n      )\n      made = without_core_types(d.0)\n      derive_errors = d.1\n    }\n    timings.begin(\"load std\")\n    load(mut st, disk, std_roots(fresh + made))\n    timings.end(\"load std\")\n    if len(st.out) == n {\n      f := derive.folded_in(\n        plain[folded..] + made,\n        plain[..folded] + core_types,\n        run(st),\n      )\n      fold_errors += f.1\n      kept := len(plain) - folded\n      plain = plain[..folded] + f.0[..kept]\n      made = f.0[kept..]\n      folded = len(plain)\n      load(mut st, disk, std_roots(f.0))\n      if len(st.out) == n {\n        break\n      }\n    }\n    new = st.out[n..]\n  }\n  // each call spreading records written out (`f(...x)` is `f(x.a, x.b)`)\n  (program, spread_errors) := timings.timed(\n    \"spreads\",\n    () -> check.spreads_resolved(plain + made, [], sh.core),\n  )\n  (program, derive_errors + fold_errors + spread_errors, st)\n}"}]}
{"id":"be8f60439f135b39","time":1795722435,"message":"edit","changes":[{"name":"std_roots","kind":"fn","old":"0796a97cac5b9749","new":"c8205d375719758d","interface_changed":false,"affected":[],"module":"","text":"/// The names they use, those they import by name (a trait whose `impl`s\n/// they use), and the terminal when they use the console (`main` is given\n/// one).\nfn std_roots(ds: List[ast.Decl]) -> List[String] {\n  mut roots := []\n  for d in ds {\n    for s in binary.decl_strings(d) {\n      if starts_with(s, \"std.\") {\n        mut roots.push(s)\n        // (`Content$own`, the sum a union's own members make: the union's)\n        if ends_with(s, desugar.own_suffix()) {\n          mut roots.push(\n            byte_slice(\n              s,\n              0,\n              byte_len(s) - byte_len(desugar.own_suffix()),\n            ),\n          )\n        }\n      }\n      // (`matches`: std.regex's engine)\n      if s == \"matches\" {\n        roots += [\"std.regex.match_code\", \"std.regex.pattern_error\"]\n      }\n      // (`s.graphemes()`: std.unicode's)\n      if s == \"graphemes\" {\n        mut roots.push(\"std.unicode.GraphemeText\")\n      }\n    }\n    match d.kind {\n      ast.UseDef(u) => if starts_with(u.path, \"std.\") {\n        for it in u.items ?? [] {\n          mut roots.push(u.path + \".\" + it.name)\n        }\n      },\n      _ => (),\n    }\n  }\n  if roots.any(s -> s == \"std.io.Console\") {\n    mut roots.push(\"std.io.Terminal\")\n  }\n  roots\n}","old_text":"/// The names they use, those they import by name (a trait whose `impl`s\n/// they use), and the terminal when they use the console (`main` is given\n/// one).\nfn std_roots(ds: List[ast.Decl]) -> List[String] {\n  mut roots := []\n  for d in ds {\n    for s in binary.decl_strings(d) {\n      if starts_with(s, \"std.\") {\n        mut roots.push(s)\n      }\n      // (`matches`: std.regex's engine)\n      if s == \"matches\" {\n        roots += [\"std.regex.match_code\", \"std.regex.pattern_error\"]\n      }\n      // (`s.graphemes()`: std.unicode's)\n      if s == \"graphemes\" {\n        mut roots.push(\"std.unicode.GraphemeText\")\n      }\n    }\n    match d.kind {\n      ast.UseDef(u) => if starts_with(u.path, \"std.\") {\n        for it in u.items ?? [] {\n          mut roots.push(u.path + \".\" + it.name)\n        }\n      },\n      _ => (),\n    }\n  }\n  if roots.any(s -> s == \"std.io.Console\") {\n    mut roots.push(\"std.io.Terminal\")\n  }\n  roots\n}"}]}
{"id":"1c6144415ca3bcdf","time":1795722491,"message":"edit","changes":[{"name":"desugar.mixed_unions","kind":"fn","old":"53dd0a7fe5786b23","new":"63afe518c46b6e7a","interface_changed":false,"affected":[],"module":"desugar","text":"/// A union with members of both kinds (`Circle | Square { side: Float }`)\n/// becomes a sum `T$own` of the members it declares, and `T` the union of\n/// that sum with the others.\npub fn mixed_unions(decls: List[ast.Decl]) -> List[ast.Decl] {\n  mut made := []\n  mut out := []\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => match t.body {\n        ast.SumBody(vs) => if vs.any(v -> v.payload is ast.MemberType) {\n          own_name := t.name + desugar.own_suffix()\n          own := vs.filter(v -> !(v.payload is ast.MemberType))\n          mut members := []\n          for v in vs {\n            match v.payload {\n              ast.MemberType(x) => mut members.push(x),\n              _ => (),\n            }\n          }\n          // (by its qualified name: the members are resolved already)\n          mut members.push(\n            ast.Named { name: if d.module == \"\" {\n              own_name\n            } else {\n              d.module + \".\" + own_name\n            }, args: t.params.map(p -> ast.Named { name: p, args: [] }) },\n          )\n          mut made.push(\n            ast.Decl {\n              comments: [],\n              doc: [],\n              module: d.module,\n              public: d.public,\n              kind: ast.TypeDef(ast.TypeDecl {\n                distinct: false,\n                name: own_name,\n                params: t.params,\n                body: ast.SumBody(own),\n                refinement: None,\n                mocked: false,\n              }),\n            },\n          )\n          mut out.push(\n            ast.Decl { ..d, kind: ast.TypeDef(\n              ast.TypeDecl { ..t, body: ast.Alias(ast.UnionType(members)) },\n            ) },\n          )\n        } else {\n          mut out.push(d)\n        },\n        _ => mut out.push(d),\n      },\n      _ => mut out.push(d),\n    }\n  }\n  out + made\n}","old_text":"/// A union with members of both kinds (`Circle | Square { side: Float }`)\n/// becomes a sum `T$own` of the members it declares, and `T` the union of\n/// that sum with the others.\npub fn mixed_unions(decls: List[ast.Decl]) -> List[ast.Decl] {\n  mut made := []\n  mut out := []\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => match t.body {\n        ast.SumBody(vs) => if vs.any(v -> v.payload is ast.MemberType) {\n          own_name := t.name + desugar.own_suffix()\n          own := vs.filter(v -> !(v.payload is ast.MemberType))\n          mut members := []\n          for v in vs {\n            match v.payload {\n              ast.MemberType(x) => mut members.push(x),\n              _ => (),\n            }\n          }\n          mut members.push(\n            ast.Named {\n              name: own_name,\n              args: t.params.map(p -> ast.Named { name: p, args: [] }),\n            },\n          )\n          mut made.push(\n            ast.Decl {\n              comments: [],\n              doc: [],\n              module: d.module,\n              public: d.public,\n              kind: ast.TypeDef(ast.TypeDecl {\n                distinct: false,\n                name: own_name,\n                params: t.params,\n                body: ast.SumBody(own),\n                refinement: None,\n                mocked: false,\n              }),\n            },\n          )\n          mut out.push(\n            ast.Decl { ..d, kind: ast.TypeDef(\n              ast.TypeDecl { ..t, body: ast.Alias(ast.UnionType(members)) },\n            ) },\n          )\n        } else {\n          mut out.push(d)\n        },\n        _ => mut out.push(d),\n      },\n      _ => mut out.push(d),\n    }\n  }\n  out + made\n}"}]}
{"id":"315e04515f744937","time":1795722541,"message":"edit","changes":[{"name":"std_roots","kind":"fn","old":"c8205d375719758d","new":"0796a97cac5b9749","interface_changed":false,"affected":[],"module":"","text":"/// The names they use, those they import by name (a trait whose `impl`s\n/// they use), and the terminal when they use the console (`main` is given\n/// one).\nfn std_roots(ds: List[ast.Decl]) -> List[String] {\n  mut roots := []\n  for d in ds {\n    for s in binary.decl_strings(d) {\n      if starts_with(s, \"std.\") {\n        mut roots.push(s)\n      }\n      // (`matches`: std.regex's engine)\n      if s == \"matches\" {\n        roots += [\"std.regex.match_code\", \"std.regex.pattern_error\"]\n      }\n      // (`s.graphemes()`: std.unicode's)\n      if s == \"graphemes\" {\n        mut roots.push(\"std.unicode.GraphemeText\")\n      }\n    }\n    match d.kind {\n      ast.UseDef(u) => if starts_with(u.path, \"std.\") {\n        for it in u.items ?? [] {\n          mut roots.push(u.path + \".\" + it.name)\n        }\n      },\n      _ => (),\n    }\n  }\n  if roots.any(s -> s == \"std.io.Console\") {\n    mut roots.push(\"std.io.Terminal\")\n  }\n  roots\n}","old_text":"/// The names they use, those they import by name (a trait whose `impl`s\n/// they use), and the terminal when they use the console (`main` is given\n/// one).\nfn std_roots(ds: List[ast.Decl]) -> List[String] {\n  mut roots := []\n  for d in ds {\n    for s in binary.decl_strings(d) {\n      if starts_with(s, \"std.\") {\n        mut roots.push(s)\n        // (`Content$own`, the sum a union's own members make: the union's)\n        if ends_with(s, desugar.own_suffix()) {\n          mut roots.push(\n            byte_slice(\n              s,\n              0,\n              byte_len(s) - byte_len(desugar.own_suffix()),\n            ),\n          )\n        }\n      }\n      // (`matches`: std.regex's engine)\n      if s == \"matches\" {\n        roots += [\"std.regex.match_code\", \"std.regex.pattern_error\"]\n      }\n      // (`s.graphemes()`: std.unicode's)\n      if s == \"graphemes\" {\n        mut roots.push(\"std.unicode.GraphemeText\")\n      }\n    }\n    match d.kind {\n      ast.UseDef(u) => if starts_with(u.path, \"std.\") {\n        for it in u.items ?? [] {\n          mut roots.push(u.path + \".\" + it.name)\n        }\n      },\n      _ => (),\n    }\n  }\n  if roots.any(s -> s == \"std.io.Console\") {\n    mut roots.push(\"std.io.Terminal\")\n  }\n  roots\n}"}]}
{"id":"acb355f40498a22c","time":1795722914,"message":"edit","changes":[{"name":"codegen.matches","kind":"fn","old":"02b02f78ef183266","new":"4d9f78ce0f1cf40d","interface_changed":false,"affected":[],"module":"codegen","text":"/// Tests `v` against a pattern: jumps to `fail` on a mismatch, else goes on.\n/// `binds` binds the names afterwards, once nothing can fail.\nfn matches(mut g: codegen.Gen, p: ast.Pattern, v: codegen.V, fail: String) {\n  match v.ty {\n    check.TUnion(ms) => match codegen.pattern_member(g, ms, p) {\n      Some(m) => {\n        ok := codegen.holds_member(mut g, v, m)\n        codegen.go_on_if(mut g, ok, fail)\n        if !codegen.type_pattern(g, p, m) {\n          nx := codegen.narrow(mut g, v, m)\n          codegen.matches(mut g, p, nx, fail)\n        }\n        return\n      },\n      None => match p {\n        // a union of some of the members (`AgentError =>`): any of them\n        ast.CtorPattern { name, args: ast.NoPats } => if !contains(g.types.ctors, name) && !contains(g.refines, name) {\n          match codegen.lower(mut g, ast.Named { name, args: [] }) {\n            check.TUnion(sub) => {\n              mut any := codegen.V { ty: check.TBool, op: \"false\" }\n              for s in sub {\n                if ms.any(m -> codegen.key(m) == codegen.key(s)) {\n                  ok := codegen.holds_member(mut g, v, s)\n                  if any.op == \"false\" {\n                    any = ok\n                  } else {\n                    both := codegen.fresh(mut g, \"inunion\")\n                    codegen.emit(\n                      mut g,\n                      f\"{both} = or i1 {any.op}, {ok.op}\",\n                    )\n                    any = codegen.V { ty: check.TBool, op: both }\n                  }\n                }\n              }\n              codegen.go_on_if(mut g, any, fail)\n              return\n            },\n            _ => (),\n          }\n        },\n        _ => (),\n      },\n    },\n    _ => (),\n  }\n  match p {\n    ast.Wild | ast.Bind(_) => (),\n    ast.IntPat(n) => {\n      // a big literal is dropped before going on\n      codegen.push_transparent(mut g)\n      x := codegen.int_lit(mut g, n)\n      ok := codegen.equal(mut g, v, x)\n      codegen.pop_scope(mut g)\n      codegen.go_on_if(mut g, ok, fail)\n    },\n    ast.StrPat(s) => {\n      x := codegen.lit(mut g, s)\n      ok := codegen.equal(mut g, v, x)\n      codegen.go_on_if(mut g, ok, fail)\n    },\n    ast.BoolPat(b) => {\n      ok := codegen.equal(\n        mut g,\n        v,\n        codegen.V { ty: check.TBool, op: to_string(b) },\n      )\n      codegen.go_on_if(mut g, ok, fail)\n    },\n    ast.CtorPattern { name, args } => if contains(g.types.ctors, name) {\n      ok := codegen.tag_is(mut g, v, name)\n      codegen.go_on_if(mut g, ok, fail)\n      for (x, q) in codegen.sub_patterns(mut g, name, args, v, false) {\n        codegen.matches(mut g, q, x, fail)\n      }\n    } else {\n      // a refined type's name (`Positive =>`): the value satisfies it\n      match (get(g.refines, name), args) {\n        (Some((_, pred)), ast.NoPats) => {\n          codegen.push_transparent(mut g)\n          ok := codegen.with_it(mut g, v, pred)\n          codegen.pop_scope(mut g)\n          codegen.go_on_if(mut g, ok, fail)\n        },\n        _ => codegen.not_yet(\n          mut g,\n          \"the pattern `\" + text.pattern_text(p) + \"`\",\n        ),\n      }\n    },\n    ast.TuplePat(ps) => match v.ty {\n      check.TNamed { name: \"Tuple\", args } => {\n        for (k, q) in enumerate(ps) {\n          if codegen.sub_wanted(q, false) {\n            x := codegen.field(mut g, v, k, get(args, k) ?? check.TAny)\n            codegen.matches(mut g, q, x, fail)\n          }\n        }\n      },\n      _ => codegen.not_yet(\n        mut g,\n        \"the pattern `\" + text.pattern_text(p) + \"`\",\n      ),\n    },\n    ast.OrPat(ps) => {\n      matched := codegen.label(mut g, \"alt.matched\")\n      for (k, q) in enumerate(ps) {\n        if k + 1 == len(ps) {\n          codegen.matches(mut g, q, v, fail)\n        } else {\n          next := codegen.label(mut g, \"alt.next\")\n          codegen.matches(mut g, q, v, next)\n          codegen.br(mut g, matched)\n          codegen.block(mut g, next)\n        }\n      }\n      codegen.br(mut g, matched)\n      codegen.block(mut g, matched)\n    },\n    ast.CondPat(c) => {\n      // the condition sees `it` (borrowed), in its own scope\n      codegen.push_scope(mut g)\n      _ := codegen.local_value(mut g, \"it\", v)\n      ok := codegen.expr(mut g, c)\n      codegen.pop_scope(mut g)\n      if !(ok.ty is check.TAny) {\n        codegen.go_on_if(mut g, ok, fail)\n      }\n    },\n    ast.ListPat { items, rest } => match v.ty {\n      check.TList(et) => {\n        n := codegen.list_len(mut g, v)\n        ok := codegen.fresh(mut g, \"lenok\")\n        cmp := match rest {\n          Some(_) => \"sge\",\n          None => \"eq\",\n        }\n        codegen.emit(\n          mut g,\n          f\"{ok} = icmp {cmp} i64 {n.op}, {len(items)}\",\n        )\n        codegen.go_on_if(\n          mut g,\n          codegen.V { ty: check.TBool, op: ok },\n          fail,\n        )\n        for (k, q) in enumerate(items) {\n          x := codegen.list_at(mut g, v, to_string(k), et)\n          codegen.matches(mut g, q, x, fail)\n        }\n      },\n      _ => codegen.not_yet(\n        mut g,\n        \"the pattern `\" + text.pattern_text(p) + \"`\",\n      ),\n    },\n    _ => codegen.not_yet(\n      mut g,\n      \"the pattern `\" + text.pattern_text(p) + \"`\",\n    ),\n  }\n}","old_text":"/// Tests `v` against a pattern: jumps to `fail` on a mismatch, else goes on.\n/// `binds` binds the names afterwards, once nothing can fail.\nfn matches(mut g: codegen.Gen, p: ast.Pattern, v: codegen.V, fail: String) {\n  match v.ty {\n    check.TUnion(ms) => match codegen.pattern_member(g, ms, p) {\n      Some(m) => {\n        ok := codegen.holds_member(mut g, v, m)\n        codegen.go_on_if(mut g, ok, fail)\n        if !codegen.type_pattern(g, p, m) {\n          nx := codegen.narrow(mut g, v, m)\n          codegen.matches(mut g, p, nx, fail)\n        }\n        return\n      },\n      None => (),\n    },\n    _ => (),\n  }\n  match p {\n    ast.Wild | ast.Bind(_) => (),\n    ast.IntPat(n) => {\n      // a big literal is dropped before going on\n      codegen.push_transparent(mut g)\n      x := codegen.int_lit(mut g, n)\n      ok := codegen.equal(mut g, v, x)\n      codegen.pop_scope(mut g)\n      codegen.go_on_if(mut g, ok, fail)\n    },\n    ast.StrPat(s) => {\n      x := codegen.lit(mut g, s)\n      ok := codegen.equal(mut g, v, x)\n      codegen.go_on_if(mut g, ok, fail)\n    },\n    ast.BoolPat(b) => {\n      ok := codegen.equal(\n        mut g,\n        v,\n        codegen.V { ty: check.TBool, op: to_string(b) },\n      )\n      codegen.go_on_if(mut g, ok, fail)\n    },\n    ast.CtorPattern { name, args } => if contains(g.types.ctors, name) {\n      ok := codegen.tag_is(mut g, v, name)\n      codegen.go_on_if(mut g, ok, fail)\n      for (x, q) in codegen.sub_patterns(mut g, name, args, v, false) {\n        codegen.matches(mut g, q, x, fail)\n      }\n    } else {\n      // a refined type's name (`Positive =>`): the value satisfies it\n      match (get(g.refines, name), args) {\n        (Some((_, pred)), ast.NoPats) => {\n          codegen.push_transparent(mut g)\n          ok := codegen.with_it(mut g, v, pred)\n          codegen.pop_scope(mut g)\n          codegen.go_on_if(mut g, ok, fail)\n        },\n        _ => codegen.not_yet(\n          mut g,\n          \"the pattern `\" + text.pattern_text(p) + \"`\",\n        ),\n      }\n    },\n    ast.TuplePat(ps) => match v.ty {\n      check.TNamed { name: \"Tuple\", args } => {\n        for (k, q) in enumerate(ps) {\n          if codegen.sub_wanted(q, false) {\n            x := codegen.field(mut g, v, k, get(args, k) ?? check.TAny)\n            codegen.matches(mut g, q, x, fail)\n          }\n        }\n      },\n      _ => codegen.not_yet(\n        mut g,\n        \"the pattern `\" + text.pattern_text(p) + \"`\",\n      ),\n    },\n    ast.OrPat(ps) => {\n      matched := codegen.label(mut g, \"alt.matched\")\n      for (k, q) in enumerate(ps) {\n        if k + 1 == len(ps) {\n          codegen.matches(mut g, q, v, fail)\n        } else {\n          next := codegen.label(mut g, \"alt.next\")\n          codegen.matches(mut g, q, v, next)\n          codegen.br(mut g, matched)\n          codegen.block(mut g, next)\n        }\n      }\n      codegen.br(mut g, matched)\n      codegen.block(mut g, matched)\n    },\n    ast.CondPat(c) => {\n      // the condition sees `it` (borrowed), in its own scope\n      codegen.push_scope(mut g)\n      _ := codegen.local_value(mut g, \"it\", v)\n      ok := codegen.expr(mut g, c)\n      codegen.pop_scope(mut g)\n      if !(ok.ty is check.TAny) {\n        codegen.go_on_if(mut g, ok, fail)\n      }\n    },\n    ast.ListPat { items, rest } => match v.ty {\n      check.TList(et) => {\n        n := codegen.list_len(mut g, v)\n        ok := codegen.fresh(mut g, \"lenok\")\n        cmp := match rest {\n          Some(_) => \"sge\",\n          None => \"eq\",\n        }\n        codegen.emit(\n          mut g,\n          f\"{ok} = icmp {cmp} i64 {n.op}, {len(items)}\",\n        )\n        codegen.go_on_if(\n          mut g,\n          codegen.V { ty: check.TBool, op: ok },\n          fail,\n        )\n        for (k, q) in enumerate(items) {\n          x := codegen.list_at(mut g, v, to_string(k), et)\n          codegen.matches(mut g, q, x, fail)\n        }\n      },\n      _ => codegen.not_yet(\n        mut g,\n        \"the pattern `\" + text.pattern_text(p) + \"`\",\n      ),\n    },\n    _ => codegen.not_yet(\n      mut g,\n      \"the pattern `\" + text.pattern_text(p) + \"`\",\n    ),\n  }\n}"}]}
{"id":"1c8db9fcf642dc4d","time":1795724040,"message":"edit","changes":[{"name":"derive.derive_all","kind":"fn","old":"da58bbfe4fbe92f2","new":"820adcec287caa9c","interface_changed":false,"affected":[],"module":"derive","text":"fn derive_all(\n  decls: List[ast.Decl],\n  context: List[ast.Decl],\n) -> (List[ast.Decl], List[(String, String)]) {\n  if !decls.any(d -> derive.is_derive(d)) {\n    return (decls, [])\n  }\n  ix := derive.defs_of(context + decls)\n  w := eval.world(context + decls)\n  mut out := []\n  mut extra := []\n  mut errors := []\n  for d in decls {\n    match d.kind {\n      ast.DeriveFnDef(f) => if f.derived {\n        for function in derive.derived_functions(\n          context + decls,\n          d.module,\n          f.function,\n          ix,\n        ) {\n          mut x := derive.new_expander(ix, w, d.module)\n          match derive.derive_fn(\n            mut x,\n            ast.DeriveFnDecl { ..f, function },\n          ) {\n            Ok((made, fns, kinds)) => {\n              mut out.push(\n                ast.Decl { ..d, kind: ast.DeriveFnDef(made) },\n              )\n              for k in kinds {\n                mut extra.push(\n                  ast.Decl {\n                    comments: [],\n                    doc: [],\n                    module: d.module,\n                    public: true,\n                    kind: k,\n                  },\n                )\n              }\n              for g in fns {\n                mut extra.push(\n                  ast.Decl {\n                    comments: [],\n                    doc: [],\n                    module: d.module,\n                    public: false,\n                    kind: ast.FnDef(g),\n                  },\n                )\n              }\n            },\n            Err(msg) => mut errors.push((desugar.decl_name(d), msg)),\n          }\n        }\n      } else {\n        mut out.push(d)\n      },\n      ast.ImplDef(i) => if i.derived {\n        mut x := derive.new_expander(ix, w, d.module)\n        match derive.derive(mut x, i) {\n          Ok(imp) => {\n            mut out.push(ast.Decl { ..d, kind: ast.ImplDef(imp) })\n            for f in x.copies {\n              mut extra.push(\n                ast.Decl {\n                  comments: [],\n                  doc: [],\n                  module: d.module,\n                  public: false,\n                  kind: ast.FnDef(f),\n                },\n              )\n            }\n          },\n          Err(msg) => mut errors.push((desugar.decl_name(d), msg)),\n        }\n      } else {\n        mut out.push(d)\n      },\n      _ => mut out.push(d),\n    }\n  }\n  (all, wrong) := derive.value_uses(out + extra)\n  (all, errors + wrong)\n}","old_text":"fn derive_all(\n  decls: List[ast.Decl],\n  context: List[ast.Decl],\n) -> (List[ast.Decl], List[(String, String)]) {\n  if !decls.any(d -> derive.is_derive(d)) {\n    return (decls, [])\n  }\n  ix := derive.defs_of(context + decls)\n  w := eval.world(context + decls)\n  mut out := []\n  mut extra := []\n  mut errors := []\n  for d in decls {\n    match d.kind {\n      ast.DeriveFnDef(f) => if f.derived {\n        for function in derive.derived_functions(\n          context + decls,\n          d.module,\n          f.function,\n          ix,\n        ) {\n          mut x := derive.new_expander(ix, w, d.module)\n          match derive.derive_fn(\n            mut x,\n            ast.DeriveFnDecl { ..f, function },\n          ) {\n            Ok((made, fns)) => {\n              mut out.push(\n                ast.Decl { ..d, kind: ast.DeriveFnDef(made) },\n              )\n              for g in fns {\n                mut extra.push(\n                  ast.Decl {\n                    comments: [],\n                    doc: [],\n                    module: d.module,\n                    public: false,\n                    kind: ast.FnDef(g),\n                  },\n                )\n              }\n            },\n            Err(msg) => mut errors.push((desugar.decl_name(d), msg)),\n          }\n        }\n      } else {\n        mut out.push(d)\n      },\n      ast.ImplDef(i) => if i.derived {\n        mut x := derive.new_expander(ix, w, d.module)\n        match derive.derive(mut x, i) {\n          Ok(imp) => {\n            mut out.push(ast.Decl { ..d, kind: ast.ImplDef(imp) })\n            for f in x.copies {\n              mut extra.push(\n                ast.Decl {\n                  comments: [],\n                  doc: [],\n                  module: d.module,\n                  public: false,\n                  kind: ast.FnDef(f),\n                },\n              )\n            }\n          },\n          Err(msg) => mut errors.push((desugar.decl_name(d), msg)),\n        }\n      } else {\n        mut out.push(d)\n      },\n      _ => mut out.push(d),\n    }\n  }\n  (all, wrong) := derive.value_uses(out + extra)\n  (all, errors + wrong)\n}"},{"name":"derive.derive_fn","kind":"fn","old":"ff291fa003ec6e64","new":"e04f59222b0b68bb","interface_changed":true,"affected":["derive.derive_all","derive.derived_in","derive.expand_with","derive.expand_in","std_reached","expanded","check_errors_in","derive.expand","holes_command","check_summary","verified_decls","verify_file","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","eval_files","instantiated_files","with_extra","command_line","check_command","verified_with","static_graph","verify_command","build_proofs","alongside_command","search_invariants","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","repl_command","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","main","strata_command","verified_program","build_command","graph_command","graph_diff","tour_graph","run_command","fix_loops","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","or_solver_inputs","program_objects","package_errors","merge_file_command","merged_checks","core_rt_text","call_command","edit_command","check_files","rename_command","move_command","fix_command","edit_in_editor","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","smt_file","termination_file","diff_command","tour_command","check_fn","linked","sync_command","build_core_command","computed_value","codegen.read_back","comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"/// `derive C for add`: a trait derived over a function. `Self` is the\n/// function, described as a `Type` of kind `Function` with its name, doc\n/// and `parameters`. A function has no type to put an `impl` on, so the\n/// output is top-level. Each `derived fn` of the trait gives an export or\n/// part of a file, by its signature alone:\n/// - `derived fn export() -> Self = Self`: the function itself, exported\n/// under its own name (`(\"add\", \"add\")` in `exports`).\n/// - `derived fn h() -> String { ... }`: specialized into a top-level\n/// function of the derive's module (`add.C.h`). Its value, folded at\n/// compile time, is the function's part of the file `<name>.h` that a\n/// library build writes (`(\"h\", \"add.C.h\")` in `files`).\n/// - `derived fn json(args: String) -> String { ... }`, one with\n/// parameters: a wrapper, specialized into a top-level function\n/// (`add.Python.json`) exported as `NAME_METHOD` (`(\"add_json\",\n/// \"add.Python.json\")` in `exports`). Its parameters and result cross\n/// as `derive C`'s do.\n/// - `derived fn name(self) -> String { ... }`, one taking `self`: a method\n/// of a type made for the function (`Tool$add`, a record of the parameters\n/// the derive binds, `bind: net`), which implements the trait. A function\n/// making it (`add.Tool.value`, taking the bound parameters) is listed in\n/// `values`; `value_uses` puts its call where the function is used as a\n/// value, so `add` is a value of the trait (`search.with(net)` with bound\n/// parameters).\n/// The second part of the result is the functions made, the third the type\n/// and its `impl`.\nfn derive_fn(\n  mut x: derive.Expander,\n  given: ast.DeriveFnDecl,\n) -> Result[(ast.DeriveFnDecl, List[ast.FnDecl], List[ast.DeclKind]), String] {\n  tr := match get(x.ix.traits, given.trait_name) {\n    Some(t) => t,\n    None => return Err(\"`\" + derive.short(given.trait_name) + \"` is not a trait\"),\n  }\n  fname := derive.short(given.function)\n  dv := match tr.derivable {\n    Some(d) => d,\n    None => return Err(\"`\"\n      + derive.short(tr.name)\n      + \"` can't be derived: only a `derivable` trait can\"),\n  }\n  f := match get(x.ix.fns, given.function) {\n    Some(f) => f,\n    None => return Err(\"`\" + fname + \"` is not a function defined in this program\"),\n  }\n  ks := match dv.kind {\n    ast.UnionType(ms) => ms,\n    k => [k],\n  }\n  if !ks.any(k -> derive.short(derive.type_head(k)) == \"Function\") {\n    names := join(\n      ks.map(k -> \"`\" + derive.short(derive.type_head(k)) + \"`\"),\n      \" or a \",\n    )\n    return Err(\"`\"\n      + derive.short(tr.name)\n      + \"` can only be derived for a \"\n      + names\n      + \", and `\"\n      + fname\n      + \"` is a function\")\n  }\n  if f.type_params != [] {\n    return Err(\"`\"\n      + fname\n      + \"` has type parameters: `\"\n      + derive.short(tr.name)\n      + \"` is derived for a function whose types are known (one calling `\"\n      + fname\n      + \"` with them)\")\n  }\n  bound := derive.bound_of(given.clauses)\n  for b in bound {\n    if !f.params.any(p -> p.name == b) {\n      return Err(\"`\" + fname + \"` has no parameter `\" + b + \"` to bind\")\n    }\n  }\n  x.clauses = given.clauses\n  x.bound = bound\n  self_ty := ast.FnType { params: f.params.map(p -> p.ty), ret: f.ret }\n  _ := derive.fn_value(mut x, given.function, f, self_ty)\n  x.self_ty = self_ty\n  x.trait_name = given.trait_name\n  x.self_fn = given.function\n  x.trait_methods = tr.methods.map(m -> m.decl.name)\n  for r in dv.conditions {\n    r2 := derive.expr(mut x, r)!\n    ok := match derive.eval_as(mut x, r2, r) {\n      Ok(v) => v,\n      Err(m) => return Err(\n        \"checking what `\"\n          + derive.short(tr.name)\n          + \"` requires: \"\n          + m,\n      ),\n    }\n    if ok != ast.BoolLit(true) {\n      return Err(\"`\"\n        + fname\n        + \"` doesn't meet what `\"\n        + derive.short(tr.name)\n        + \"` requires: \"\n        + text.expr_text(r, 0))\n    }\n  }\n  mut exports := []\n  mut files := []\n  mut made := []\n  mut values := []\n  mut methods := []\n  for m in tr.methods {\n    if !m.decl.derived {\n      continue\n    }\n    shape := \"`\" + derive.short(tr.name) + \"`'s `\" + m.decl.name + \"`\"\n    takes_self := match m.decl.params {\n      [p, ..] => p.name == \"self\",\n      _ => false,\n    }\n    if takes_self {\n      // a method of the type made for the function\n      body := match derive.expr(mut x, m.decl.body) {\n        Ok(b) => b,\n        Err(e) => return Err(\"deriving `\" + m.decl.name + \"`: \" + e),\n      }\n      mut methods.push(\n        ast.FnDecl { ..m.decl, derived: false, compile_time: false, body },\n      )\n      continue\n    }\n    if m.decl.params != [] {\n      // a wrapper of the function, exported as `NAME_METHOD`\n      body := match derive.expr(mut x, m.decl.body) {\n        Ok(b) => b,\n        Err(e) => return Err(\"deriving `\" + m.decl.name + \"`: \" + e),\n      }\n      name := fname + \".\" + derive.short(tr.name) + \".\" + m.decl.name\n      mut made.push(\n        ast.FnDecl { ..m.decl, name, derived: false, compile_time: false, body },\n      )\n      mut exports.push(\n        (fname + \"_\" + m.decl.name, derive.qualify(x.module, name)),\n      )\n      continue\n    }\n    if derive.type_head(m.decl.ret) == \"Self\" {\n      if !derive.is_self(m.decl.body) {\n        return Err(\n          shape\n            + \" exports something other than the function itself (`= Self`): not built yet\",\n        )\n      }\n      mut exports.push((fname, given.function))\n    } else if derive.type_head(m.decl.ret) == \"String\" {\n      body := match derive.expr(mut x, m.decl.body) {\n        Ok(b) => b,\n        Err(e) => return Err(\"deriving `\" + m.decl.name + \"`: \" + e),\n      }\n      name := fname + \".\" + derive.short(tr.name) + \".\" + m.decl.name\n      mut made.push(\n        ast.FnDecl { ..m.decl, name, derived: false, compile_time: false, body },\n      )\n      mut files.push((m.decl.name, derive.qualify(x.module, name)))\n    } else {\n      return Err(\n        shape\n          + \" gives a `\"\n          + text.type_text(m.decl.ret)\n          + \"`: a derive for a function makes exports (`-> Self = Self`, or a wrapper taking parameters), parts of files (`-> String`) and methods (taking `self`)\",\n      )\n    }\n  }\n  mut kinds := []\n  if methods != [] {\n    // the type standing for the function: a record of the bound parameters\n    tname := derive.short(tr.name) + \"$\" + fname\n    q := derive.qualify(x.module, tname)\n    held := f.params.filter(p -> bound.contains(p.name))\n    mut kinds.push(\n      ast.TypeDef(ast.TypeDecl {\n        distinct: false,\n        name: tname,\n        params: [],\n        body: ast.RecordBody(held.map(\n          p -> ast.Field {\n            comments: [],\n            doc: [],\n            name: p.name,\n            ty: p.ty,\n            default: None,\n          },\n        )),\n        refinement: None,\n        mocked: false,\n      }),\n    )\n    mut kinds.push(\n      ast.ImplDef(ast.ImplDecl {\n        type_params: [],\n        bounds: [],\n        trait_name: given.trait_name,\n        trait_args: [],\n        for_type: ast.Named { name: q, args: [] },\n        methods,\n        derived: false,\n      }),\n    )\n    vname := fname + \".\" + derive.short(tr.name) + \".value\"\n    mut made.push(\n      ast.FnDecl {\n        doc: [],\n        comments: [],\n        name: vname,\n        type_params: [],\n        bounds: [],\n        params: held,\n        ret: ast.Named { name: q, args: [] },\n        pre: [],\n        post: [],\n        terminating: true,\n        body: ast.CtorExpr {\n          name: q,\n          args: ast.RecordArgs(held.map(p -> (p.name, ast.Var(p.name)))),\n        },\n        compile_time: false,\n        derived: false,\n      },\n    )\n    mut values.push(derive.qualify(x.module, vname))\n  }\n  Ok((\n    ast.DeriveFnDecl { ..given, derived: false, exports, files, values },\n    made + x.copies,\n    kinds,\n  ))\n}","old_text":"/// `derive C for add`: a trait derived over a function. `Self` is the\n/// function, described as a `Type` of kind `Function` with its name, doc\n/// and `parameters`. A function has no type to put an `impl` on, so the\n/// output is top-level. Each `derived fn` of the trait gives an export or\n/// part of a file, by its signature alone:\n/// - `derived fn export() -> Self = Self`: the function itself, exported\n/// under its own name (`(\"add\", \"add\")` in `exports`).\n/// - `derived fn h() -> String { ... }`: specialized into a top-level\n/// function of the derive's module (`add.C.h`). Its value, folded at\n/// compile time, is the function's part of the file `<name>.h` that a\n/// library build writes (`(\"h\", \"add.C.h\")` in `files`).\n/// - `derived fn json(args: String) -> String { ... }`, one with\n/// parameters: a wrapper, specialized into a top-level function\n/// (`add.Python.json`) exported as `NAME_METHOD` (`(\"add_json\",\n/// \"add.Python.json\")` in `exports`). Its parameters and result cross\n/// as `derive C`'s do.\n/// - `derived fn tool() -> Tool { ... }`, one without parameters giving\n/// another type: a value standing for the function, specialized into a\n/// top-level function (`add.Tool.tool`) taking the parameters the derive\n/// binds (`bind: net`), listed in `values`. `value_uses` puts its call where\n/// the function is used as a value.\n/// The second part of the result is the functions made.\nfn derive_fn(\n  mut x: derive.Expander,\n  given: ast.DeriveFnDecl,\n) -> Result[(ast.DeriveFnDecl, List[ast.FnDecl]), String] {\n  tr := match get(x.ix.traits, given.trait_name) {\n    Some(t) => t,\n    None => return Err(\"`\" + derive.short(given.trait_name) + \"` is not a trait\"),\n  }\n  fname := derive.short(given.function)\n  dv := match tr.derivable {\n    Some(d) => d,\n    None => return Err(\"`\"\n      + derive.short(tr.name)\n      + \"` can't be derived: only a `derivable` trait can\"),\n  }\n  f := match get(x.ix.fns, given.function) {\n    Some(f) => f,\n    None => return Err(\"`\" + fname + \"` is not a function defined in this program\"),\n  }\n  ks := match dv.kind {\n    ast.UnionType(ms) => ms,\n    k => [k],\n  }\n  if !ks.any(k -> derive.short(derive.type_head(k)) == \"Function\") {\n    names := join(\n      ks.map(k -> \"`\" + derive.short(derive.type_head(k)) + \"`\"),\n      \" or a \",\n    )\n    return Err(\"`\"\n      + derive.short(tr.name)\n      + \"` can only be derived for a \"\n      + names\n      + \", and `\"\n      + fname\n      + \"` is a function\")\n  }\n  if f.type_params != [] {\n    return Err(\"`\"\n      + fname\n      + \"` has type parameters: `\"\n      + derive.short(tr.name)\n      + \"` is derived for a function whose types are known (one calling `\"\n      + fname\n      + \"` with them)\")\n  }\n  bound := derive.bound_of(given.clauses)\n  for b in bound {\n    if !f.params.any(p -> p.name == b) {\n      return Err(\"`\" + fname + \"` has no parameter `\" + b + \"` to bind\")\n    }\n  }\n  x.clauses = given.clauses\n  x.bound = bound\n  self_ty := ast.FnType { params: f.params.map(p -> p.ty), ret: f.ret }\n  _ := derive.fn_value(mut x, given.function, f, self_ty)\n  x.self_ty = self_ty\n  x.trait_name = given.trait_name\n  x.self_fn = given.function\n  x.trait_methods = tr.methods.map(m -> m.decl.name)\n  for r in dv.conditions {\n    r2 := derive.expr(mut x, r)!\n    ok := match derive.eval_as(mut x, r2, r) {\n      Ok(v) => v,\n      Err(m) => return Err(\n        \"checking what `\"\n          + derive.short(tr.name)\n          + \"` requires: \"\n          + m,\n      ),\n    }\n    if ok != ast.BoolLit(true) {\n      return Err(\"`\"\n        + fname\n        + \"` doesn't meet what `\"\n        + derive.short(tr.name)\n        + \"` requires: \"\n        + text.expr_text(r, 0))\n    }\n  }\n  mut exports := []\n  mut files := []\n  mut made := []\n  mut values := []\n  for m in tr.methods {\n    if !m.decl.derived {\n      continue\n    }\n    shape := \"`\" + derive.short(tr.name) + \"`'s `\" + m.decl.name + \"`\"\n    if m.decl.params != [] {\n      // a wrapper of the function, exported as `NAME_METHOD`\n      body := match derive.expr(mut x, m.decl.body) {\n        Ok(b) => b,\n        Err(e) => return Err(\"deriving `\" + m.decl.name + \"`: \" + e),\n      }\n      name := fname + \".\" + derive.short(tr.name) + \".\" + m.decl.name\n      mut made.push(\n        ast.FnDecl { ..m.decl, name, derived: false, compile_time: false, body },\n      )\n      mut exports.push(\n        (fname + \"_\" + m.decl.name, derive.qualify(x.module, name)),\n      )\n      continue\n    }\n    if derive.type_head(m.decl.ret) == \"Self\" {\n      if !derive.is_self(m.decl.body) {\n        return Err(\n          shape\n            + \" exports something other than the function itself (`= Self`): not built yet\",\n        )\n      }\n      mut exports.push((fname, given.function))\n    } else if derive.type_head(m.decl.ret) == \"String\" {\n      body := match derive.expr(mut x, m.decl.body) {\n        Ok(b) => b,\n        Err(e) => return Err(\"deriving `\" + m.decl.name + \"`: \" + e),\n      }\n      name := fname + \".\" + derive.short(tr.name) + \".\" + m.decl.name\n      mut made.push(\n        ast.FnDecl { ..m.decl, name, derived: false, compile_time: false, body },\n      )\n      mut files.push((m.decl.name, derive.qualify(x.module, name)))\n    } else if m.decl.params == [] {\n      // a value standing for the function where it is used as one: a\n      // function taking the bound parameters (`search.with(net)`)\n      body := match derive.expr(mut x, m.decl.body) {\n        Ok(b) => b,\n        Err(e) => return Err(\"deriving `\" + m.decl.name + \"`: \" + e),\n      }\n      name := fname + \".\" + derive.short(tr.name) + \".\" + m.decl.name\n      mut made.push(\n        ast.FnDecl { ..m.decl, name, params: f.params.filter(p -> bound.contains(p.name)), derived: false, compile_time: false, body },\n      )\n      mut values.push(derive.qualify(x.module, name))\n    } else {\n      return Err(\n        shape\n          + \" gives a `\"\n          + text.type_text(m.decl.ret)\n          + \"`: a derive for a function makes exports (`-> Self = Self`, or a wrapper taking parameters) and parts of files (`-> String`)\",\n      )\n    }\n  }\n  Ok((\n    ast.DeriveFnDecl { ..given, derived: false, exports, files, values },\n    made + x.copies,\n  ))\n}"}]}
{"id":"cdf1473a0e32044e","time":1795724067,"message":"edit","changes":[{"name":"derive.call_fn","kind":"fn","old":"a227849b1f0c26c3","new":"f72a6bfe9a583652","interface_changed":false,"affected":[],"module":"derive","text":"/// `Self.call(p -> e)` or `Self.try_call(p -> e)` in a derive for a\n/// function described by `d`: a call of the function with `e` for each\n/// argument (`p` is that parameter, a `Field`; `p.type` its type).\n/// `try_call`: each argument is a `Result`; the first `Err` is the result,\n/// else `Ok` of the call's.\nfn call_fn(\n  mut x: derive.Expander,\n  d: ast.Expr,\n  fallible: Bool,\n  args: List[ast.Expr],\n) -> Result[ast.Expr, String] {\n  if derive.str_of(d, \"name\") != Some(derive.short(x.self_fn)) {\n    return Err(\n      \"`call` and `try_call` call the function the `derive` is for (`Self`)\",\n    )\n  }\n  params := match derive.get_field(d, \"parameters\") {\n    Some(ast.ListExpr(xs)) => xs,\n    _ => [],\n  }\n  mut vals := []\n  match args {\n    [ast.Lambda { params: [p], body }] => {\n      for f in params {\n        pname := derive.str_of(f, \"name\") ?? \"\"\n        if x.bound.contains(pname) {\n          // a bound parameter: a field of the type made for the function\n          mut vals.push(\n            if fallible {\n              ast.CtorExpr { name: \"Ok\", args: ast.PositionalArgs(\n                [ast.FieldOf { base: ast.Var(\"self\"), name: pname }],\n              ) }\n            } else {\n              ast.FieldOf { base: ast.Var(\"self\"), name: pname }\n            },\n          )\n          continue\n        }\n        ft := match derive.get_field(f, \"type\") {\n          Some(tv) => match derive.type_of(x, tv) {\n            Ok(y) => Some((p.name + \".type\", y)),\n            Err(_) => None,\n          },\n          None => None,\n        }\n        mut vals.push(\n          derive.with_known(mut x, [(p.name, f, ft)], body)!,\n        )\n      }\n    },\n    [] => if params != [] {\n      return Err(\n        \"`call` takes a function giving each argument: `Self.call(p -> e)`\",\n      )\n    },\n    _ => return Err(\n      \"`call` takes a function giving each argument: `Self.call(p -> e)`\",\n    ),\n  }\n  if !fallible {\n    return Ok(ast.Call { callee: ast.Var(x.self_fn), args: vals })\n  }\n  // match a1 { Ok(v1) => match a2 { ... Ok(f(v1, ..)) }, Err(e) => Err(e) }\n  names := [f\"called.{k}\" for k in 0..len(vals)]\n  mut out := ast.CtorExpr { name: \"Ok\", args: ast.PositionalArgs([ast.Call {\n    callee: ast.Var(x.self_fn),\n    args: names.map(n -> ast.Var(n)),\n  }]) }\n  for k in 0..len(vals) {\n    j := len(vals) - 1 - k\n    out = ast.MatchExpr {\n      scrutinee: get(vals, j) ?? ast.UnitExpr,\n      binding: None,\n      arms: [ast.Arm { comments: [], pat: ast.CtorPattern {\n        name: \"Ok\",\n        args: ast.PositionalPats([ast.Bind(get(names, j) ?? \"\")]),\n      }, body: out }, ast.Arm { comments: [], pat: ast.CtorPattern {\n        name: \"Err\",\n        args: ast.PositionalPats([ast.Bind(\"called.err\")]),\n      }, body: ast.CtorExpr {\n        name: \"Err\",\n        args: ast.PositionalArgs([ast.Var(\"called.err\")]),\n      } }],\n    }\n  }\n  Ok(out)\n}","old_text":"/// `Self.call(p -> e)` or `Self.try_call(p -> e)` in a derive for a\n/// function described by `d`: a call of the function with `e` for each\n/// argument (`p` is that parameter, a `Field`; `p.type` its type).\n/// `try_call`: each argument is a `Result`; the first `Err` is the result,\n/// else `Ok` of the call's.\nfn call_fn(\n  mut x: derive.Expander,\n  d: ast.Expr,\n  fallible: Bool,\n  args: List[ast.Expr],\n) -> Result[ast.Expr, String] {\n  if derive.str_of(d, \"name\") != Some(derive.short(x.self_fn)) {\n    return Err(\n      \"`call` and `try_call` call the function the `derive` is for (`Self`)\",\n    )\n  }\n  params := match derive.get_field(d, \"parameters\") {\n    Some(ast.ListExpr(xs)) => xs,\n    _ => [],\n  }\n  mut vals := []\n  match args {\n    [ast.Lambda { params: [p], body }] => {\n      for f in params {\n        pname := derive.str_of(f, \"name\") ?? \"\"\n        if x.bound.contains(pname) {\n          // a bound parameter: the value function's own\n          mut vals.push(\n            if fallible {\n              ast.CtorExpr {\n                name: \"Ok\",\n                args: ast.PositionalArgs([ast.Var(pname)]),\n              }\n            } else {\n              ast.Var(pname)\n            },\n          )\n          continue\n        }\n        ft := match derive.get_field(f, \"type\") {\n          Some(tv) => match derive.type_of(x, tv) {\n            Ok(y) => Some((p.name + \".type\", y)),\n            Err(_) => None,\n          },\n          None => None,\n        }\n        mut vals.push(\n          derive.with_known(mut x, [(p.name, f, ft)], body)!,\n        )\n      }\n    },\n    [] => if params != [] {\n      return Err(\n        \"`call` takes a function giving each argument: `Self.call(p -> e)`\",\n      )\n    },\n    _ => return Err(\n      \"`call` takes a function giving each argument: `Self.call(p -> e)`\",\n    ),\n  }\n  if !fallible {\n    return Ok(ast.Call { callee: ast.Var(x.self_fn), args: vals })\n  }\n  // match a1 { Ok(v1) => match a2 { ... Ok(f(v1, ..)) }, Err(e) => Err(e) }\n  names := [f\"called.{k}\" for k in 0..len(vals)]\n  mut out := ast.CtorExpr { name: \"Ok\", args: ast.PositionalArgs([ast.Call {\n    callee: ast.Var(x.self_fn),\n    args: names.map(n -> ast.Var(n)),\n  }]) }\n  for k in 0..len(vals) {\n    j := len(vals) - 1 - k\n    out = ast.MatchExpr {\n      scrutinee: get(vals, j) ?? ast.UnitExpr,\n      binding: None,\n      arms: [ast.Arm { comments: [], pat: ast.CtorPattern {\n        name: \"Ok\",\n        args: ast.PositionalPats([ast.Bind(get(names, j) ?? \"\")]),\n      }, body: out }, ast.Arm { comments: [], pat: ast.CtorPattern {\n        name: \"Err\",\n        args: ast.PositionalPats([ast.Bind(\"called.err\")]),\n      }, body: ast.CtorExpr {\n        name: \"Err\",\n        args: ast.PositionalArgs([ast.Var(\"called.err\")]),\n      } }],\n    }\n  }\n  Ok(out)\n}"}]}
{"id":"3fc0f7614336515f","time":1795724238,"message":"edit","changes":[{"name":"codegen.list_literal_of","kind":"fn","old":"e47107c7e2c2e971","new":"68f06f3cf6462902","interface_changed":false,"affected":[],"module":"codegen","text":"/// `[a, b, c]` with elements of type `want`, when known.\nfn list_literal_of(\n  mut g: codegen.Gen,\n  es: List[ast.Expr],\n  want: check.Ty,\n) -> codegen.V {\n  // each element is wanted like those before it, which types a lambda's\n  // parameters\n  mut et := want\n  mut vs := []\n  // an element that borrows is held when a later one may assign\n  // (`[xs, { xs = []; [] }]`)\n  mut later := es.map(_ -> false)\n  mut k := len(es) - 2\n  while k >= 0 {\n    later = take(later, k)\n      + [get(later, k + 1) ?? false\n        || codegen.assigns(get(es, k + 1) ?? ast.UnitExpr)]\n      + drop(later, k + 1)\n    k -= 1\n  }\n  for (i, x) in enumerate(es) {\n    got := codegen.expr_want(mut g, x, et)\n    if got.ty is check.TAny {\n      return codegen.never()\n    }\n    // a value of a trait wanted (`List[Tool]`): any element not one yet,\n    // such as a call's result, becomes one\n    v := if want is check.TTrait && !(got.ty is check.TTrait) {\n      codegen.converted(mut g, got, want)\n    } else {\n      got\n    }\n    et = codegen.better(et, v.ty)\n    mut vs.push(\n      if get(later, i) ?? false {\n        codegen.hold(mut g, v)\n      } else {\n        v\n      },\n    )\n  }\n  // elements of different types (`[\"a\", 1]`) make a list of their union\n  if want is check.TAny {\n    hs := vs.map(v -> codegen.head_of(v.ty))\n    first := get(hs, 0) ?? \"\"\n    if hs.any(h -> h != first) && !hs.any(h -> starts_with(h, \"?\")) {\n      et = codegen.union_ty(vs.map(v -> v.ty))\n      mut us := []\n      for v in vs {\n        mut us.push(codegen.converted(mut g, v, et))\n      }\n      vs = us\n    }\n  }\n  match codegen.constant_list(mut g, vs, et) {\n    Some(c) => return c,\n    None => (),\n  }\n  // (`--regions`: its header and buffer in the statement's region, which\n  // holds its elements)\n  own := codegen.region_own(g, g.here) && vs != []\n  l := codegen.routed(\n    mut g,\n    own,\n    check.TList(et),\n    \"strata_list_new\",\n    [codegen.V { ty: check.TInt, op: to_string(len(vs)) }],\n  )\n  // `[]`: a new empty list\n  if vs == [] {\n    return l\n  }\n  (bp, buf, data) := (\n    codegen.fresh(mut g, \"bufp\"),\n    codegen.fresh(mut g, \"buf\"),\n    codegen.fresh(mut g, \"data\"),\n  )\n  codegen.emit(mut g, f\"{bp} = getelementptr i8, ptr {l.op}, i64 8\")\n  codegen.emit(mut g, f\"{buf} = load ptr, ptr {bp}\")\n  codegen.emit(\n    mut g,\n    f\"{data} = getelementptr i64, ptr {buf}, i64 2\",\n  )\n  for (k, v) in enumerate(vs) {\n    x := codegen.take_value(mut g, v)\n    at := codegen.fresh(mut g, \"at\")\n    codegen.emit(\n      mut g,\n      f\"{at} = getelementptr i64, ptr {data}, i64 {k}\",\n    )\n    codegen.store_slot(mut g, x, at)\n    if own {\n      codegen.region_hold(mut g, x)\n    }\n  }\n  up := codegen.fresh(mut g, \"usedp\")\n  codegen.emit(mut g, f\"{up} = getelementptr i8, ptr {buf}, i64 8\")\n  codegen.emit(mut g, f\"store i64 {len(vs)}, ptr {up}\")\n  codegen.emit(mut g, f\"store i64 {len(vs)}, ptr {l.op}\")\n  l\n}","old_text":"/// `[a, b, c]` with elements of type `want`, when known.\nfn list_literal_of(\n  mut g: codegen.Gen,\n  es: List[ast.Expr],\n  want: check.Ty,\n) -> codegen.V {\n  // each element is wanted like those before it, which types a lambda's\n  // parameters\n  mut et := want\n  mut vs := []\n  // an element that borrows is held when a later one may assign\n  // (`[xs, { xs = []; [] }]`)\n  mut later := es.map(_ -> false)\n  mut k := len(es) - 2\n  while k >= 0 {\n    later = take(later, k)\n      + [get(later, k + 1) ?? false\n        || codegen.assigns(get(es, k + 1) ?? ast.UnitExpr)]\n      + drop(later, k + 1)\n    k -= 1\n  }\n  for (i, x) in enumerate(es) {\n    v := codegen.expr_want(mut g, x, et)\n    if v.ty is check.TAny {\n      return codegen.never()\n    }\n    et = codegen.better(et, v.ty)\n    mut vs.push(\n      if get(later, i) ?? false {\n        codegen.hold(mut g, v)\n      } else {\n        v\n      },\n    )\n  }\n  // elements of different types (`[\"a\", 1]`) make a list of their union\n  if want is check.TAny {\n    hs := vs.map(v -> codegen.head_of(v.ty))\n    first := get(hs, 0) ?? \"\"\n    if hs.any(h -> h != first) && !hs.any(h -> starts_with(h, \"?\")) {\n      et = codegen.union_ty(vs.map(v -> v.ty))\n      mut us := []\n      for v in vs {\n        mut us.push(codegen.converted(mut g, v, et))\n      }\n      vs = us\n    }\n  }\n  match codegen.constant_list(mut g, vs, et) {\n    Some(c) => return c,\n    None => (),\n  }\n  // (`--regions`: its header and buffer in the statement's region, which\n  // holds its elements)\n  own := codegen.region_own(g, g.here) && vs != []\n  l := codegen.routed(\n    mut g,\n    own,\n    check.TList(et),\n    \"strata_list_new\",\n    [codegen.V { ty: check.TInt, op: to_string(len(vs)) }],\n  )\n  // `[]`: a new empty list\n  if vs == [] {\n    return l\n  }\n  (bp, buf, data) := (\n    codegen.fresh(mut g, \"bufp\"),\n    codegen.fresh(mut g, \"buf\"),\n    codegen.fresh(mut g, \"data\"),\n  )\n  codegen.emit(mut g, f\"{bp} = getelementptr i8, ptr {l.op}, i64 8\")\n  codegen.emit(mut g, f\"{buf} = load ptr, ptr {bp}\")\n  codegen.emit(\n    mut g,\n    f\"{data} = getelementptr i64, ptr {buf}, i64 2\",\n  )\n  for (k, v) in enumerate(vs) {\n    x := codegen.take_value(mut g, v)\n    at := codegen.fresh(mut g, \"at\")\n    codegen.emit(\n      mut g,\n      f\"{at} = getelementptr i64, ptr {data}, i64 {k}\",\n    )\n    codegen.store_slot(mut g, x, at)\n    if own {\n      codegen.region_hold(mut g, x)\n    }\n  }\n  up := codegen.fresh(mut g, \"usedp\")\n  codegen.emit(mut g, f\"{up} = getelementptr i8, ptr {buf}, i64 8\")\n  codegen.emit(mut g, f\"store i64 {len(vs)}, ptr {up}\")\n  codegen.emit(mut g, f\"store i64 {len(vs)}, ptr {l.op}\")\n  l\n}"}]}
{"id":"75e39a324c562f88","time":1795724464,"message":"edit","changes":[{"name":"ast.DeriveFnDecl","kind":"type","old":"a3415a41ff62df88","new":"a3bfcd7170ac9791","interface_changed":false,"affected":[],"module":"ast","text":"/// `derive Trait for function`: a trait derivable over functions\n/// (`derivable(Function) trait C`) derived for one (`add`). `derive` turns\n/// it into what it makes, with `derived` false.\n/// - `exports`: each a symbol C calls and the function it runs,\n/// `(\"add\", \"add\")`.\n/// - `files`: each a file extension and the derived function whose value is\n/// this function's part of that file, `(\"h\", \"add.C.h\")`.\n/// - `clauses`: the derive's arguments: `derive Tool(bind: net) for search`\n/// has the clause `bind` with `[\"net\"]` (`Self.clauses` while deriving).\n/// - `values`: each a function made by the derive giving the value that\n/// stands for the function where it is used as a value (`search.Tool.value`,\n/// a `Tool$search`, which implements `Tool`); its parameters are the `bind`\n/// names, given by `search.with(net)`.\npub type DeriveFnDecl = {\n  trait_name: String,\n  function: String,\n  derived: Bool,\n  exports: List[(String, String)],\n  files: List[(String, String)],\n  clauses: List[ast.DeriveClause] = [],\n  values: List[String] = [],\n}","old_text":"/// `derive Trait for function`: a trait derivable over functions\n/// (`derivable(Function) trait C`) derived for one (`add`). `derive` turns\n/// it into what it makes, with `derived` false.\n/// - `exports`: each a symbol C calls and the function it runs,\n/// `(\"add\", \"add\")`.\n/// - `files`: each a file extension and the derived function whose value is\n/// this function's part of that file, `(\"h\", \"add.C.h\")`.\n/// - `clauses`: the derive's arguments: `derive Tool(bind: net) for search`\n/// has the clause `bind` with `[\"net\"]` (`Self.clauses` while deriving).\n/// - `values`: each a derived function giving a value that stands for the\n/// function where it is used as a value (`search.Tool.tool`, a `Tool`); its\n/// parameters are the `bind` names, given by `search.with(net)`.\npub type DeriveFnDecl = {\n  trait_name: String,\n  function: String,\n  derived: Bool,\n  exports: List[(String, String)],\n  files: List[(String, String)],\n  clauses: List[ast.DeriveClause] = [],\n  values: List[String] = [],\n}"}]}
{"id":"543a6596a5954fac","time":1795724466,"message":"edit","changes":[{"name":"derive.Expander","kind":"type","old":"edcfb202a331380f","new":"b76294272045895d","interface_changed":false,"affected":[],"module":"derive","text":"/// The state of specializing code for one `derive` or one `comptime e`.\ntype Expander = {\n  ix: derive.Defs,\n  w: eval.World,\n  // the module the generated code goes in\n  module: String,\n  // values known at compile time, by name (a `comptime` parameter, a\n  // `comptime for` element)\n  known: Dict[String, ast.Expr],\n  // types known at compile time, by name (`f.type`, `x` of `Option[x] =>`)\n  types: Dict[String, ast.TypeExpr],\n  // the type behind each `Type` value made, by the value's text\n  written: Dict[String, ast.TypeExpr],\n  // the type derived for (`()` when none)\n  self_ty: ast.TypeExpr,\n  copies: List[ast.FnDecl],\n  made: Dict[String, String],\n  // a variant's constructor, by its `Type` value's text\n  ctors: Dict[String, String],\n  // names bound inside the code being specialized, which hide known ones\n  hidden: List[List[String]],\n  // the type parameters of the type derived for (`T` of `Pair[T]`)\n  params: List[String],\n  trait_name: String,\n  trait_methods: List[String],\n  // each field's default, by its `Field` value's text\n  defaults: Dict[String, ast.Expr],\n  // each type's `Type` value, by the type's text\n  type_values: Dict[String, ast.Expr],\n  // in a match comprehension arm: the matched expression (as text) and the\n  // names its variant's fields are bound to\n  arm_fields: List[(String, List[(String, String)])],\n  // the function derived for, qualified (`derive Python for add`), which\n  // `Self.call(..)` calls. `\"\"` for a type's derive.\n  self_fn: String = \"\",\n  // the clauses of the derive's block (`key code`): `Self.clauses`\n  clauses: List[ast.DeriveClause] = [],\n  // the parameters a derive for a function binds (`derive Tool(bind: net)`):\n  // `Self.call(..)` passes them from the fields of the type made for the\n  // function (`self.net`)\n  bound: List[String] = [],\n}","old_text":"/// The state of specializing code for one `derive` or one `comptime e`.\ntype Expander = {\n  ix: derive.Defs,\n  w: eval.World,\n  // the module the generated code goes in\n  module: String,\n  // values known at compile time, by name (a `comptime` parameter, a\n  // `comptime for` element)\n  known: Dict[String, ast.Expr],\n  // types known at compile time, by name (`f.type`, `x` of `Option[x] =>`)\n  types: Dict[String, ast.TypeExpr],\n  // the type behind each `Type` value made, by the value's text\n  written: Dict[String, ast.TypeExpr],\n  // the type derived for (`()` when none)\n  self_ty: ast.TypeExpr,\n  copies: List[ast.FnDecl],\n  made: Dict[String, String],\n  // a variant's constructor, by its `Type` value's text\n  ctors: Dict[String, String],\n  // names bound inside the code being specialized, which hide known ones\n  hidden: List[List[String]],\n  // the type parameters of the type derived for (`T` of `Pair[T]`)\n  params: List[String],\n  trait_name: String,\n  trait_methods: List[String],\n  // each field's default, by its `Field` value's text\n  defaults: Dict[String, ast.Expr],\n  // each type's `Type` value, by the type's text\n  type_values: Dict[String, ast.Expr],\n  // in a match comprehension arm: the matched expression (as text) and the\n  // names its variant's fields are bound to\n  arm_fields: List[(String, List[(String, String)])],\n  // the function derived for, qualified (`derive Python for add`), which\n  // `Self.call(..)` calls. `\"\"` for a type's derive.\n  self_fn: String = \"\",\n  // the clauses of the derive's block (`key code`): `Self.clauses`\n  clauses: List[ast.DeriveClause] = [],\n  // the parameters a derive for a function binds (`derive Tool(bind: net)`):\n  // `Self.call(..)` passes them as they are, from the value function's own\n  // parameters\n  bound: List[String] = [],\n}"},{"name":"derive.value_uses","kind":"fn","old":"633ea2a16e2b5de3","new":"2d725f0d7cb3da2b","interface_changed":false,"affected":[],"module":"derive","text":"/// Where a function with a derived value (`derive Tool for add`) is used as\n/// a value, not called: the value (`add.Tool.value()`, a `Tool$add`), or\n/// with its bound parameters given, `search.with(net)`\n/// (`search.Tool.value(net)`). A function with bound parameters used\n/// without `.with` is an error.\npub fn value_uses(\n  decls: List[ast.Decl],\n) -> (List[ast.Decl], List[(String, String)]) {\n  mut values := Dict[String, (String, List[String])] {}\n  for d in decls {\n    match d.kind {\n      ast.DeriveFnDef(f) => {\n        for v in f.values {\n          bound := derive.bound_of(f.clauses)\n          mut values.insert(f.function, (v, bound))\n        }\n      },\n      _ => (),\n    }\n  }\n  if len(values) == 0 {\n    return (decls, [])\n  }\n  mut out := []\n  mut errors := []\n  for d in decls {\n    r := walk.rewrite_decl(d, e -> derive.value_use(values, e))\n    mut out.push(r)\n    for name in keys(values) {\n      unbound := \"$unbound.\" + name\n      if walk.decl_exprs(r).any(\n        x -> walk.any_expr(x, e -> e == ast.Var(unbound)),\n      ) {\n        (_, bound) := get(values, name) ?? (\"\", [])\n        f := derive.short(name)\n        needs := join(bound, \"`, `\")\n        given := join(bound, \", \")\n        mut errors.push(\n          (\n            desugar.decl_name(d),\n            f\"`{f}` needs `{needs}`: write `{f}.with({given})`\",\n          ),\n        )\n      }\n    }\n  }\n  (out, errors)\n}","old_text":"/// Where a function with a derived value (`derive Tool for add`) is used as\n/// a value, not called: the value (`add.Tool.tool()`), or with its bound\n/// parameters given, `search.with(net)` (`search.Tool.tool(net)`). A\n/// function with bound parameters used without `.with` is an error.\npub fn value_uses(\n  decls: List[ast.Decl],\n) -> (List[ast.Decl], List[(String, String)]) {\n  mut values := Dict[String, (String, List[String])] {}\n  for d in decls {\n    match d.kind {\n      ast.DeriveFnDef(f) => {\n        for v in f.values {\n          bound := derive.bound_of(f.clauses)\n          mut values.insert(f.function, (v, bound))\n        }\n      },\n      _ => (),\n    }\n  }\n  if len(values) == 0 {\n    return (decls, [])\n  }\n  mut out := []\n  mut errors := []\n  for d in decls {\n    r := walk.rewrite_decl(d, e -> derive.value_use(values, e))\n    mut out.push(r)\n    for name in keys(values) {\n      unbound := \"$unbound.\" + name\n      if walk.decl_exprs(r).any(\n        x -> walk.any_expr(x, e -> e == ast.Var(unbound)),\n      ) {\n        (_, bound) := get(values, name) ?? (\"\", [])\n        f := derive.short(name)\n        needs := join(bound, \"`, `\")\n        given := join(bound, \", \")\n        mut errors.push(\n          (\n            desugar.decl_name(d),\n            f\"`{f}` needs `{needs}`: write `{f}.with({given})`\",\n          ),\n        )\n      }\n    }\n  }\n  (out, errors)\n}"}]}
