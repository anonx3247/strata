n.shown","codegen.string_builtin","codegen.host","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.helper","codegen.debug_body","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.equal","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.read_back","eval_files","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// The function marking a value of type `t` shared between threads, with\n/// what it reaches (`share_value`). The block is marked first; only when it\n/// wasn't marked yet is what it holds walked: a record's or variant's\n/// fields (the last one by a tail call, so a long chain doesn't grow the\n/// stack), a list's buffer and every element the buffer has used (other\n/// lists sharing it may reach any of them), a closure's captures by the\n/// function in its block's fourth word, a trait value's by its table's last\n/// entry. A union's member is marked as its own type, a box first. A task's\n/// handle marks the task (`strata_task_share`), and its result when an\n/// `await` may hold it already.\nfn share_fn(mut g: codegen.Gen, t: check.Ty) -> String {\n  name := f\"@\\\"share:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  codegen.use_rt(mut g, \"strata_share\")\n  saved := g\n  codegen.start_helper(mut g)\n  a := codegen.V { ty: t, op: \"%a\" }\n  match t {\n    check.TUnion(ms) => {\n      labels := codegen.on_members(mut g, a, ms)\n      for (k, m) in enumerate(ms) {\n        codegen.block(mut g, get(labels, k) ?? \"\")\n        if codegen.boxed(g, m) {\n          (box, walk, done) := (\n            codegen.fresh(mut g, \"new\"),\n            codegen.label(mut g, \"walk\"),\n            codegen.label(mut g, \"done\"),\n          )\n          codegen.emit(\n            mut g,\n            f\"{box} = call i1 @strata_share(ptr %a)\",\n          )\n          codegen.emit(\n            mut g,\n            f\"br i1 {box}, label %{walk}, label %{done}\",\n          )\n          codegen.block(mut g, walk)\n          codegen.share_value(mut g, codegen.field(mut g, a, 0, m))\n          codegen.br(mut g, done)\n          codegen.block(mut g, done)\n        } else {\n          codegen.share_value(mut g, codegen.V { ..a, ty: m })\n        }\n        codegen.emit(mut g, \"ret void\")\n      }\n    },\n    check.TNamed { name: \"Task\", args: [rt] } => {\n      codegen.use_rt(mut g, \"strata_task_share\")\n      codegen.emit(\n        mut g,\n        \"%out = call ptr @strata_task_share(ptr %a)\",\n      )\n      if codegen.has_value(rt) && codegen.crosses(rt) {\n        codegen.use_rt(mut g, \"strata_results_lock\")\n        codegen.use_rt(mut g, \"strata_results_unlock\")\n        codegen.emit(mut g, \"%held = icmp ne ptr %out, null\")\n        codegen.emit(mut g, \"br i1 %held, label %walk, label %done\")\n        codegen.block(mut g, \"walk\")\n        codegen.emit(mut g, \"call void @strata_results_lock()\")\n        codegen.emit(mut g, f\"%r = load {codegen.ll(rt)}, ptr %out\")\n        codegen.share_value(mut g, codegen.V { ty: rt, op: \"%r\" })\n        codegen.emit(mut g, \"call void @strata_results_unlock()\")\n        codegen.br(mut g, \"done\")\n        codegen.block(mut g, \"done\")\n      }\n      codegen.emit(mut g, \"ret void\")\n    },\n    _ => {\n      codegen.emit(mut g, \"%new = call i1 @strata_share(ptr %a)\")\n      codegen.emit(mut g, \"br i1 %new, label %walk, label %done\")\n      codegen.block(mut g, \"walk\")\n      codegen.share_held(mut g, a)\n      codegen.block(mut g, \"done\")\n      codegen.emit(mut g, \"ret void\")\n    },\n  }\n  codegen.restore(\n    mut g,\n    saved,\n    codegen.helper_text(g, f\"define void {name}(ptr %a)\"),\n  )\n  name\n}","old_text":"/// The function marking a value of type `t` shared between threads, with\n/// what it reaches (`share_value`). The block is marked first; only when it\n/// wasn't marked yet is what it holds walked: a record's or variant's\n/// fields (the last one by a tail call, so a long chain doesn't grow the\n/// stack), a list's buffer and every element the buffer has used (other\n/// lists sharing it may reach any of them), a closure's captures by the\n/// function in its block's fourth word, a trait value's by its table's last\n/// entry. A union's member is marked as its own type, a box first. A task's\n/// handle marks the task (`strata_task_share`), and its result when an\n/// `await` may hold it already.\nfn share_fn(mut g: codegen.Gen, t: Ty) -> String {\n  name := f\"@\\\"share:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  codegen.use_rt(mut g, \"strata_share\")\n  saved := g\n  codegen.start_helper(mut g)\n  a := codegen.V { ty: t, op: \"%a\" }\n  match t {\n    TUnion(ms) => {\n      labels := codegen.on_members(mut g, a, ms)\n      for (k, m) in enumerate(ms) {\n        codegen.block(mut g, get(labels, k) ?? \"\")\n        if codegen.boxed(g, m) {\n          (box, walk, done) := (\n            codegen.fresh(mut g, \"new\"),\n            codegen.label(mut g, \"walk\"),\n            codegen.label(mut g, \"done\"),\n          )\n          codegen.emit(\n            mut g,\n            f\"{box} = call i1 @strata_share(ptr %a)\",\n          )\n          codegen.emit(\n            mut g,\n            f\"br i1 {box}, label %{walk}, label %{done}\",\n          )\n          codegen.block(mut g, walk)\n          codegen.share_value(mut g, codegen.field(mut g, a, 0, m))\n          codegen.br(mut g, done)\n          codegen.block(mut g, done)\n        } else {\n          codegen.share_value(mut g, codegen.V { ..a, ty: m })\n        }\n        codegen.emit(mut g, \"ret void\")\n      }\n    },\n    TNamed { name: \"Task\", args: [rt] } => {\n      codegen.use_rt(mut g, \"strata_task_share\")\n      codegen.emit(\n        mut g,\n        \"%out = call ptr @strata_task_share(ptr %a)\",\n      )\n      if codegen.has_value(rt) && codegen.crosses(rt) {\n        codegen.use_rt(mut g, \"strata_results_lock\")\n        codegen.use_rt(mut g, \"strata_results_unlock\")\n        codegen.emit(mut g, \"%held = icmp ne ptr %out, null\")\n        codegen.emit(mut g, \"br i1 %held, label %walk, label %done\")\n        codegen.block(mut g, \"walk\")\n        codegen.emit(mut g, \"call void @strata_results_lock()\")\n        codegen.emit(mut g, f\"%r = load {codegen.ll(rt)}, ptr %out\")\n        codegen.share_value(mut g, codegen.V { ty: rt, op: \"%r\" })\n        codegen.emit(mut g, \"call void @strata_results_unlock()\")\n        codegen.br(mut g, \"done\")\n        codegen.block(mut g, \"done\")\n      }\n      codegen.emit(mut g, \"ret void\")\n    },\n    _ => {\n      codegen.emit(mut g, \"%new = call i1 @strata_share(ptr %a)\")\n      codegen.emit(mut g, \"br i1 %new, label %walk, label %done\")\n      codegen.block(mut g, \"walk\")\n      codegen.share_held(mut g, a)\n      codegen.block(mut g, \"done\")\n      codegen.emit(mut g, \"ret void\")\n    },\n  }\n  codegen.restore(\n    mut g,\n    saved,\n    codegen.helper_text(g, f\"define void {name}(ptr %a)\"),\n  )\n  name\n}"},{"name":"codegen.share_held","kind":"fn","old":"06d8cda8ecfb1ffb","new":"ed501b8ce51c3e84","interface_changed":false,"affected":[],"module":"codegen","text":"/// What the block `a` (marked shared just now) holds, marked in turn; the\n/// code goes on at `%done`.\nfn share_held(mut g: codegen.Gen, a: codegen.V) {\n  match a.ty {\n    check.TList(et) => {\n      codegen.emit(mut g, \"%bp = getelementptr i8, ptr %a, i64 8\")\n      codegen.emit(mut g, \"%buf = load ptr, ptr %bp\")\n      codegen.emit(mut g, \"%bnew = call i1 @strata_share(ptr %buf)\")\n      if !codegen.crosses(et) {\n        return codegen.br(mut g, \"done\")\n      }\n      codegen.emit(\n        mut g,\n        \"br i1 %bnew, label %elements, label %done\",\n      )\n      codegen.block(mut g, \"elements\")\n      codegen.emit(mut g, \"%up = getelementptr i8, ptr %buf, i64 8\")\n      codegen.emit(mut g, \"%used = load i64, ptr %up\")\n      codegen.emit(\n        mut g,\n        \"%data = getelementptr i64, ptr %buf, i64 2\",\n      )\n      codegen.br(mut g, \"loop\")\n      codegen.block(mut g, \"loop\")\n      codegen.emit(\n        mut g,\n        \"%i = phi i64 [ 0, %elements ], [ %next, %each ]\",\n      )\n      codegen.emit(mut g, \"%more = icmp slt i64 %i, %used\")\n      codegen.emit(mut g, \"br i1 %more, label %each, label %done\")\n      codegen.block(mut g, \"each\")\n      codegen.emit(\n        mut g,\n        \"%ep = getelementptr i64, ptr %data, i64 %i\",\n      )\n      codegen.emit(mut g, \"%eraw = load i64, ptr %ep\")\n      codegen.share_value(\n        mut g,\n        codegen.from_slot(mut g, \"%eraw\", et),\n      )\n      codegen.emit(mut g, \"%next = add i64 %i, 1\")\n      codegen.br(mut g, \"loop\")\n    },\n    check.TFn { .. } => {\n      codegen.emit(mut g, \"%sp = getelementptr i64, ptr %a, i64 3\")\n      codegen.emit(mut g, \"%sraw = load i64, ptr %sp\")\n      codegen.emit(mut g, \"%sf = inttoptr i64 %sraw to ptr\")\n      codegen.emit(mut g, \"musttail call void %sf(ptr %a)\")\n      codegen.emit(mut g, \"ret void\")\n    },\n    check.TTrait(tr) => {\n      at := 5 + len(codegen.dyn_methods(g, tr))\n      codegen.emit(mut g, \"%vraw = load i64, ptr %a\")\n      codegen.emit(mut g, \"%vt = inttoptr i64 %vraw to ptr\")\n      codegen.emit(mut g, \"%slp = getelementptr i64, ptr %a, i64 1\")\n      codegen.emit(mut g, \"%sl = load i64, ptr %slp\")\n      codegen.emit(\n        mut g,\n        f\"%ep = getelementptr ptr, ptr %vt, i64 {at}\",\n      )\n      codegen.emit(mut g, \"%ef = load ptr, ptr %ep\")\n      codegen.emit(mut g, \"call void %ef(i64 %sl)\")\n      codegen.br(mut g, \"done\")\n    },\n    check.TNamed { name: \"Tuple\", args } => codegen.share_fields(mut g, a, args),\n    check.TNamed { .. } => {\n      cs := codegen.ctors_of(g, a.ty).filter(\n        c -> len(codegen.fields_of(g, c, a.ty)) > 0,\n      )\n      if len(cs) == 1 {\n        codegen.share_fields(\n          mut g,\n          a,\n          codegen.fields_of(g, get(cs, 0) ?? \"\", a.ty).map(f -> f.1),\n        )\n      } else if len(cs) > 1 {\n        labels := codegen.on_ctor(mut g, a, cs)\n        for (k, c) in enumerate(cs) {\n          codegen.block(mut g, get(labels, k) ?? \"\")\n          codegen.share_fields(\n            mut g,\n            a,\n            codegen.fields_of(g, c, a.ty).map(f -> f.1),\n          )\n        }\n      } else {\n        codegen.br(mut g, \"done\")\n      }\n    },\n    _ => codegen.br(mut g, \"done\"),\n  }\n}","old_text":"/// What the block `a` (marked shared just now) holds, marked in turn; the\n/// code goes on at `%done`.\nfn share_held(mut g: codegen.Gen, a: codegen.V) {\n  match a.ty {\n    TList(et) => {\n      codegen.emit(mut g, \"%bp = getelementptr i8, ptr %a, i64 8\")\n      codegen.emit(mut g, \"%buf = load ptr, ptr %bp\")\n      codegen.emit(mut g, \"%bnew = 