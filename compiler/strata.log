odule":"codegen","text":"// ---- strings and numbers ----\n\n/// `Some(v)` when `ok`, else `None`, as a temporary `Option` of type `t`.\nfn option_if(\n  mut g: codegen.Gen,\n  ok: String,\n  v: codegen.V,\n  t: check.Ty,\n) -> codegen.V {\n  (some, none, end) := (\n    codegen.label(mut g, \"some\"),\n    codegen.label(mut g, \"none\"),\n    codegen.label(mut g, \"opt\"),\n  )\n  codegen.emit(mut g, f\"br i1 {ok}, label %{some}, label %{none}\")\n  codegen.block(mut g, some)\n  b := codegen.block_of(mut g, get(g.tags, \"Some\") ?? 0, [v])\n  from := codegen.current(g)\n  codegen.br(mut g, end)\n  codegen.block(mut g, none)\n  n := codegen.nullary(mut g, \"None\")\n  codegen.br(mut g, end)\n  codegen.block(mut g, end)\n  r := codegen.fresh(mut g, \"o\")\n  codegen.emit(\n    mut g,\n    f\"{r} = phi ptr [ {b}, %{from} ], [ {n}, %{none} ]\",\n  )\n  codegen.temp(mut g, codegen.V { ty: t, op: r })\n}","old_text":"// ---- strings and numbers ----\n\n/// `Some(v)` when `ok`, else `None`, as a temporary `Option` of type `t`.\nfn option_if(mut g: codegen.Gen, ok: String, v: codegen.V, t: Ty) -> codegen.V {\n  (some, none, end) := (\n    codegen.label(mut g, \"some\"),\n    codegen.label(mut g, \"none\"),\n    codegen.label(mut g, \"opt\"),\n  )\n  codegen.emit(mut g, f\"br i1 {ok}, label %{some}, label %{none}\")\n  codegen.block(mut g, some)\n  b := codegen.block_of(mut g, get(g.tags, \"Some\") ?? 0, [v])\n  from := codegen.current(g)\n  codegen.br(mut g, end)\n  codegen.block(mut g, none)\n  n := codegen.nullary(mut g, \"None\")\n  codegen.br(mut g, end)\n  codegen.block(mut g, end)\n  r := codegen.fresh(mut g, \"o\")\n  codegen.emit(\n    mut g,\n    f\"{r} = phi ptr [ {b}, %{from} ], [ {n}, %{none} ]\",\n  )\n  codegen.temp(mut g, codegen.V { ty: t, op: r })\n}"},{"name":"codegen.option_of","kind":"fn","old":"a8c9d502028b8ea9","new":"ac10edb4ee87547a","interface_changed":true,"affected":["codegen.collection_builtin","codegen.string_builtin","codegen.number_builtin","c