  )\n    },\n  )\n}","old_text":"/// Compiles function `name`'s instance for `sub` alone, from the round's\n/// start state `base`, which it only reads.\n/// Returns its text, and the state after it: what it added beside the\n/// program's tables (`new_...`), and the globals, helpers, errors and queue\n/// it made. The names it makes (lambdas, tables, generators) start with its\n/// own name, so they cannot clash with another function's.\n/// It runs in the worker's own arena. Only the text and the additions are\n/// copied out.\nfn compiled_alone(\n  base: codegen.Gen,\n  name: String,\n  sub: Dict[String, Ty],\n  main: ast.FnDecl,\n) -> (String, codegen.Gen) {\n  std.memory.arena(\n    () -> {\n      f := codegen.fn_of(base, name) ?? main\n      sym := codegen.inst_sym(name, f, sub)\n      mut g := codegen.Gen { ..base, owner: byte_slice(sym, 2, byte_len(sym) - 1) + \".\", lambdas: 0, globals: [], helper_defs: [], errs: [], queue: [] }\n      body := codegen.function(mut g, f, name, sub)\n      // per-function state left by this function's code, not wanted after it\n      (\n        body,\n        codegen.Gen { ..g, lines: [], allocas: [], scopes: [], loops: [], declared: base.declared },\n      )\n    },\n  )\n}"},{"name":"codegen.result_phi","kind":"fn","old":"88b894a6364a927e","new":"c19ba675d5b0c180","interface_changed":true,"affected":["codegen.function","codegen.lambda_shown","codegen.compiled_alone","codegen.function_value","codegen.lambda","codegen.generate","codegen.expr_want_node","codegen.spawn_expr","codegen.produce","codegen.method_value","codegen.expr_node","codegen_with","core_rt_text","computed_value","repl_eval","codegen.expr_want","codegen.race_expr","codegen.gen_fn","codegen.expr","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.binary","codegen.declare","codegen.destructure","codegen.block_expr","code