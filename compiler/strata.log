degen.label(mut g, \"fld.end\")\n  mut incoming := []\n  for (j, x) in enumerate(fs) {\n    codegen.block(mut g, get(labels, j) ?? \"\")\n    r := codegen.field(mut g, v, x.0, x.1)\n    mut incoming.push((r, codegen.current(g)))\n    codegen.br(mut g, end)\n  }\n  codegen.block(mut g, end)\n  codegen.join_values(mut g, incoming)\n}"},{"name":"codegen.union_set","kind":"fn","old":"6026cbc3bf65365a","new":"19652308bb326dc4","interface_changed":true,"affected":["codegen.set_path","codegen.assign_at","codegen.set_field_in_place","codegen.call_fn_want","codegen.method_call","codegen.dyn_call","codegen.stmt_node","codegen.call_named","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.expr_node","codegen.expr_want_node","codegen.stmt","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.builtin_call","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.main_arg","codegen.select_expr","codegen.expr","codegen.expr_want","codegen.block_expr","codegen.iterate","codegen.decreases_start","codegen.decreases_pass","codegen.decreases_entry","codegen.decreases_call","codegen.build_fn","codegen.entry","codegen.interp","codegen.format_spec","codegen.union_text","codegen.destructure","codegen.debug_fields","codegen.for_loop","codegen.debug_list","codegen.checked","codegen.fail_unless","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.fuzz_driver","codegen.trace_enter","codegen.trace_leave","codegen.matching_v","codegen.index_check","codegen.checked_update","codegen.decreases_fault","codegen.push_in_place","codegen.gen_list","codegen.converted","codegen.update_in_place","codegen.except_expr","codegen.matching_want","codegen.vtable","codegen.binary","codegen.logic","codegen.loop_body","codegen.matches","codegen.with_it","codegen.for_list","codegen.await_expr","codegen.race_expr","co