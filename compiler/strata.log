{"id":"830d5da99516bb09","time":1795709965,"message":"edit","changes":[{"name":"diff.nodes_text","kind":"fn","old":"66785389f4ad3892","new":"5f354c4f9fb29e1d","interface_changed":false,"affected":[],"module":"diff","text":"/// `strata diff --nodes`: each changed definition as it was and as it is,\n/// with the nodes that changed marked (`^^^` under them), then each change\n/// by path. Added and removed definitions are one line each.\npub fn nodes_text(d: diff.Diff) -> String {\n  if len(d.items) == 0 {\n    return \"no changes\\n\"\n  }\n  mut out := \"\"\n  for it in d.items {\n    mk := if it.mk == \"add\" {\n      \"+\"\n    } else if it.mk == \"del\" {\n      \"-\"\n    } else if it.mk == \"ren\" {\n      \"↪\"\n    } else {\n      \"~\"\n    }\n    out += \"\\n\" + mk + \" \" + it.id + \"  (\" + join(it.what, \", \") + \")\\n\"\n    match (it.old_decl, it.new_decl) {\n      (Some(o), Some(n)) => {\n        olds := it.nodes\n          .filter(c -> c.kind != \"added\" && c.old != \"\")\n          .map(c -> c.old)\n        news := it.nodes\n          .filter(c -> c.kind != \"removed\" && c.new != \"\")\n          .map(c -> c.new)\n        if len(olds) > 0 {\n          out += \"  before:\\n\" + diff.indented(diff.marked(o, olds)) + \"\\n\"\n        }\n        if len(news) > 0 {\n          out += \"  after:\\n\" + diff.indented(diff.marked(n, news)) + \"\\n\"\n        }\n        for c in it.nodes {\n          out += \"  \"\n            + c.kind\n            + \" \"\n            + if c.old == \"\" && c.new == \"\" {\n              \"the definition itself (its name, doc, comments or flags)\"\n            } else if c.old == c.new {\n              c.old\n            } else if c.old == \"\" {\n              c.new\n            } else if c.new == \"\" {\n              c.old\n            } else {\n              c.old + \" → \" + c.new\n            }\n          out += if c.before != \"\"\n            && c.after != \"\"\n            && !contains(c.before, \"\\n\")\n            && !contains(c.after, \"\\n\") {\n            \": \" + c.before + \"  →  \" + c.after\n          } else {\n            \"\"\n          }\n          out += \"\\n\"\n        }\n      },\n      _ => (),\n    }\n  }\n  out\n}","old_text":"/// `strata diff --nodes`: each changed definition as it was and as it is,\n/// with the nodes that changed marked (`^^^` under them), then each change\n/// by path. Added and removed definitions are one line each.\npub fn nodes_text(d: diff.Diff) -> String {\n  if len(d.items) == 0 {\n    return \"no changes\\n\"\n  }\n  mut out := \"\"\n  for it in d.items {\n    mk := if it.mk == \"add\" {\n      \"+\"\n    } else if it.mk == \"del\" {\n      \"-\"\n    } else if it.mk == \"ren\" {\n      \"↪\"\n    } else {\n      \"~\"\n    }\n    out += \"\\n\" + mk + \" \" + it.id + \"  (\" + join(it.what, \", \") + \")\\n\"\n    match (it.old_decl, it.new_decl) {\n      (Some(o), Some(n)) => {\n        olds := it.nodes\n          .filter(c -> c.kind != \"added\" && c.old != \"\")\n          .map(c -> c.old)\n        news := it.nodes\n          .filter(c -> c.kind != \"removed\" && c.new != \"\")\n          .map(c -> c.new)\n        if len(olds) > 0 {\n          out += \"  before:\\n\" + diff.indented(diff.marked(o, olds)) + \"\\n\"\n        }\n        if len(news) > 0 {\n          out += \"  after:\\n\" + diff.indented(diff.marked(n, news)) + \"\\n\"\n        }\n        for c in it.nodes {\n          out += \"  \"\n            + c.kind\n            + \" \"\n            + if c.old == c.new {\n              c.old\n            } else if c.old == \"\" {\n              c.new\n            } else if c.new == \"\" {\n              c.old\n            } else {\n              c.old + \" → \" + c.new\n            }\n          out += if c.before != \"\"\n            && c.after != \"\"\n            && !contains(c.before, \"\\n\")\n            && !contains(c.after, \"\\n\") {\n            \": \" + c.before + \"  →  \" + c.after\n          } else {\n            \"\"\n          }\n          out += \"\\n\"\n        }\n      },\n      _ => (),\n    }\n  }\n  out\n}"}]}
