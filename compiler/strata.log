`--rm NAME`: a qualified name, or a short one naming one definition)\n  given_removes := removed_names(old, module, a.removes) except e {\n    return fail_with(mut console, e)\n  }\n  text := if cmd == \"add\" {\n    disk.read(a.module ?? \"\") !! \"\"\n  } else {\n    piped_input(\n      mut console,\n      len(given_removes) > 0,\n      \"strata --file F edit\",\n    ) except e { return fail_with(mut console, e) }\n  }\n  parsed := parse.parse_module(text, module) except e {\n    return fail_with(mut console, f\"parse error at {e}\")\n  }\n  // (text read back from a view: the proof material it hid is put back)\n  edits := if a.proofs || cmd == \"add\" {\n    parsed\n  } else {\n    (kept, notes) := views.proofs_kept(resolve.written(old, std, core), parsed)\n    for n in notes {\n      mut console.eprint(\"warning: \" + n)\n    }\n    kept\n  }\n  match both_given_and_removed(edits, given_removes) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  // (a declaration given drops its stored derives that are no longer on its\n  // `derive A, B for` line)\n  dropped := codebase.dropped_derives(old, edits).filter(\n    q -> !contains(given_removes, q),\n  )\n  removes := given_removes + dropped\n  // (a package's other modules, for its references)\n  others := match root {\n    Some(r) => (read_package(disk, r, \"\") except e {\n      return fail_with(mut console, e)\n    }).filter(\n      d -> d.module != module,\n    ),\n    None => [],\n  }\n  // (core's files keep their names as written: core's names are global)\n  of_core := in_core\n    || match root {\n      Some(r) => package_name(disk, r) == \"core\",\n      None => false,\n    }\n  new := if of_core {\n    codebase.merge_parsed(old, edits, removes)\n  } else {\n    codebase.merge(old, edits, removes, std + others, core)\n  }\n  if new == old && disk.exists(path) {\n    // every definition given is as stored: nothing written or checked\n    mut console.print(\n      f\"{f}: no changes: every definition given is as stored (nothing written or checked)\",\n    )\n    return 0\n  }\n  // checked before anything is written: an edit that doesn't check\n  // leaves every file as it was (core checks only as the runtime's\n  // compilation does, `strata build-core`; a module file of a package\n  // isn't checked alone, its neighbours may not be written yet)\n  alone := !of_core\n    && in_package is None\n    && (is_dir || new.all(d -> d.module == \"\"))\n  errors := if alone {\n    lib := std_imports(disk, std_dir, new)\n    sh := shared_at(disk, cache.caches_of(process), home_of_std(std_dir))\n    // (`comptime e` compiled, as `check` runs it, with its budget of steps: a\n    // runaway one is an error instead of a hang)\n    std_use_check(\n        disk,\n        std_dir,\n        new,\n        use_errors_of(new, lib, Set[String] {}, core),\n      )\n      + warned(mut console, check_errors_with(\n        new,\n        lib,\n        core,\n        is_dir && package_reads_values(disk, path),\n        comptime_runner(disk, sh),\n      ))\n      + literal_errors_of(disk, new, lib, core, path, sh, [])\n  } else {\n    []\n  }\n  n := len(errors)\n  if n > 0 && !a.as_given {\n    mut console.eprint(\n      f\"rejected: {f} doesn't check ({n} error{plural(n, \"\", \"s\")}; nothing was written; `--as-given` writes it all the same):\",\n    )\n    for l in errors {\n      mut console.eprint(\"  \" + error_text(l))\n    }\n    return 1\n  }\n  if is_dir {\n    match codebase.write_modules(mut disk, path, old, new, false) {\n      Err(e) => return fail_with(mut console, e),\n      Ok(_) => (),\n    }\n  } else {\n    if codebase.parent(path) != \"\" {\n      mut disk.make_dir(codebase.parent(path)) !! ()\n    }\n    // (the definitions that didn't change keep their stored bytes)\n    bytes := codebase.module_bytes(\n      disk.read_bytes(path) !! [],\n      module,\n      new,\n      old,\n      others + new,\n      false,\n      Dict[String, ast.Key] {},\n    )\n    match codebase.write_file(mut disk, path, bytes) {\n      Err(e) => return fail_with(mut console, e),\n      Ok(_) => (),\n    }\n  }\n  cs := codebase.changes(old, new, false)\n  mut console.print(\n    f\"{f}: {len(cs)} definition{plural(len(cs), \"\", \"s\")} changed, {len(new)} in all\",\n  )\n  for q in dropped.filter(q -> !new.any(d -> store.qname(d) == q)) {\n    mut console.print(dropped_warning(q))\n  }\n  for w in edit_warnings(new, cs.map(c -> c.name), core) {\n    mut console.print(w)\n  }\n  if !of_core {\n    roots := unused_setting(disk, root ?? path).0\n    for w in edit_unused(\n      old + others,\n      new + others,\n      cs.map(c -> c.name),\n      core,\n      roots,\n    ) {\n      mut console.print(w.2)\n    }\n  }\n  if n > 0 {\n    mut console.eprint(\n      f\"written as given: {f} doesn't check ({n} error{plural(n, \"\", \"s\")}):\",\n    )\n    for l in errors {\n      mut console.eprint(\"  \" + error_text(l))\n    }\n    return 1\n  }\n  // the loops of the functions changed: invariants searched for where\n  // those derived from the code don't prove their checks, and written\n  looped := loop_functions(new, cs.map(c -> c.name))\n  if a.search && looped != [] && !of_core {\n    _ := search_invariants(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      cache.caches_of(process),\n      path,\n      looped,\n      \"edit\",\n      false,\n    )\n  }\n  0\n}"},{"name":"search_invariants","kind":"fn","old":"e9d52347d8cd2541","new":"db4b04228692388a","interface_changed":false,"affected":[],"module":"","text":"/// The loops of the functions `names` (qualified) of the program at\n/// `path`: where the invariants derived from their code (and those\n/// written) don't prove a check after a loop, or a loop's end, invariants\n/// searched for, and what is found written into the code as `invariant`\n/// clauses, each with a line (`verify --find-invariants BY`, `by` being\n/// `edit` or `fix`); `logged`: logged and committed. Nothing without a\n/// solver, nor in core. Whether any was written. An edit's searches share\n/// `edit_search_budget`, `fix`'s `search_budget`: a loop left unsearched\n/// is reported, with `strata fix` to search on.\nfn search_invariants(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  cache: cache.Cache,\n  path: String,\n  names: List[String],\n  by: String,\n  logged: Bool,\n) -> Bool {\n  s := toolchain.solver(disk, process)\n  if names == [] || !toolchain.has_solver(mut launcher, s) {\n    return false\n  }\n  // (from Strata's home, where `verify` reads core/ and std/, as the\n  // commands that compile do: the program by its full path)\n  cwd := process.current_dir()\n  home := home_found(disk, process) or { return false }\n  at := if starts_with(path, \"/\") {\n    path\n  } else {\n    cwd + \"/\" + path\n  }\n  // (core's modules aren't verified as a package: `verify` reads each\n  // apart, and they may use raw memory)\n  if package_name(disk, at) == \"core\" {\n    return false\n  }\n  if driver_chdir(home).to_int() != 0 {\n    return false\n  }\n  options := VerifyOptions {\n    ..verify_defaults(),\n    finding: by,\n    selection: join(names, \",\"),\n    logged,\n    budget: if by == \"edit\" {\n      edit_search_budget()\n    } else {\n      search_budget()\n    },\n  }\n  mut wrote := false\n  timings.begin(by + \": invariant search\")\n  // (core: each of its module files, the names picked in each)\n  for unit in units_of(disk, at, \"\") {\n    code := verify_program(\n      mut console,\n      mut launcher,\n      mut disk,\n      cache,\n      s,\n      toolchain.c_compiler(process),\n      options,\n      unit,\n    )\n    if code == 0 {\n      wrote = true\n    }\n  }\n  timings.end(by + \": invariant search\")\n  _ := driver_chdir(cwd)\n  wrote\n}","old_text":"/// The loops of the functions `names` (qualified) of the program at\n/// `path`: where the invariants derived from their code (and those\n/// written) don't prove a check after a loop, or a loop's end, invariants\n/// searched for, and what is found written into the code as `invariant`\n/// clauses, each with a line (`verify --find-invariants BY`, `by` being\n/// `edit` or `fix`); `logged`: logged and committed. Nothing without a\n/// solver, nor in core. Whether any was written.\nfn search_invariants(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  cache: cache.Cache,\n  path: String,\n  names: List[String],\n  by: String,\n  logged: Bool,\n) -> Bool {\n  s := toolchain.solver(disk, process)\n  if names == [] || !toolchain.has_solver(mut launcher, s) {\n    return false\n  }\n  // (from Strata's home, where `verify` reads core/ and std/, as the\n  // commands that compile do: the program by its full path)\n  cwd := process.current_dir()\n  home := home_found(disk, process) or { return false }\n  at := if starts_with(path, \"/\") {\n    path\n  } else {\n    cwd + \"/\" + path\n  }\n  // (core's modules aren't verified as a package: `verify` reads each\n  // apart, and they may use raw memory)\n  if package_name(disk, at) == \"core\" {\n    return false\n  }\n  if driver_chdir(home).to_int() != 0 {\n    return false\n  }\n  options := VerifyOptions {\n    ..verify_defaults(),\n    finding: by,\n    selection: join(names, \",\"),\n    logged,\n  }\n  mut wrote := false\n  timings.begin(by + \": invariant search\")\n  // (core: each of its module files, the names picked in each)\n  for unit in units_of(disk, at, \"\") {\n    code := verify_program(\n      mut console,\n      mut launcher,\n      mut disk,\n      cache,\n      s,\n      toolchain.c_compiler(process),\n      options,\n      unit,\n    )\n    if code == 0 {\n      wrote = true\n    }\n  }\n  timings.end(by + \": invariant search\")\n  _ := driver_chdir(cwd)\n  wrote\n}"},{"name":"edit_search_budget","kind":"fn","old":null,"new":"b313563346fc1a41","interface_changed":true,"affected":[],"module":"","text":"/// The solver's resource units the loop-invariant searches of one `strata\n/// edit` may use together: two searches run to their limit.\nfn edit_search_budget() -> Int {\n  40000000\n}"}]}
