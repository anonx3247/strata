1 %r\"])\n    } else {\n      (\"i64\", [\"  ret i64 %c\"])\n    }\n    head := if codegen.has_value(t) {\n      [\n        f\"define {rt} {sym}(ptr %env, {codegen.ll(t)} %a, {codegen.ll(t)} %b) {{\",\n        \"entry:\",\n        f\"  %c = call i64 {cmp}({codegen.ll(t)} %a, {codegen.ll(t)} %b)\",\n      ]\n    } else {\n      [\n        f\"define {rt} {sym}(ptr %env) {{\",\n        \"entry:\",\n        \"  %c = add i64 0, 0\",\n      ]\n    }\n    mut g.helper_defs.push(join(head + tail + [\"}\\n\"], \"\\n\"))\n  }\n  p := codegen.closure(mut g, sym, [], \"<fn order>\")\n  rt := if what == \"less\" {\n    TBool\n  } else {\n    TInt\n  }\n  codegen.V { ty: TFn { params: [t, t], ret: rt }, op: p }\n}"},{"name":"codegen.cmp_helper","kind":"fn","old":"2ef527f108019f9d","new":"829ea62292024aa3","interface_changed":true,"affected":["codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.slot_fn","codegen.compare_values","codegen.builtin_call","codegen.equal","codegen.table_fns","codegen.hash_helper","codegen.builtin","codegen.call_named","codegen.method_call","codegen.except_expr","codegen.matching_want","codegen.apply","codegen.eq_fields","codegen.matches","codegen.eq_list","codegen.dyn_wrapper","codegen.union_eq","codegen.collection_builtin","codegen.update_in_place","codegen.table_from","codegen.hash_fields","codegen.push_in_place","codegen.expr_node","codegen.expr_want_node","codegen.matching","codegen.binary","codegen.number_builtin","codegen.checked","codegen.eq_body","codegen.destructure","codegen.binds","codegen.for_loop","codegen.matching_v","codegen.match_got","codegen.helper","codegen.vtable","codegen.gen_list","codegen.converted","codegen.stmt_node","codegen.expr","codegen.expr_want","codegen.assertion","codegen.invariants","codegen.show","codegen.shown","codegen.to_dyn","codegen.dyn_table_is","codegen.produce","codegen.list_builtin","codegen.list_literal_of","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.table_f