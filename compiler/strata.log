n      mut out.push(diff.Line { s: \" \", text: get(lb, j) ?? \"\" })\n      k += 1\n      continue\n    }\n    mut dels := []\n    mut ins := []\n    while k < len(ops) && (get(ops, k) ?? (0, 0, 0)).0 != 0 {\n      (x, a, b) := get(ops, k) ?? (0, 0, 0)\n      if x == 1 {\n        mut dels.push(a)\n      } else {\n        mut ins.push(b)\n      }\n      k += 1\n    }\n    line_a := (i: Int) -> get(la, i) ?? \"\"\n    line_b := (i: Int) -> get(lb, i) ?? \"\"\n    moved_only := (ss: List[(Int, Int, Int)]) ->\n      ss != [] && ss.all(s -> get(kinds, s.2) == Some(\"moved\"))\n    if rewritten {\n      out = out\n        + dels.map(d -> diff.Line { s: \"-\", text: line_a(d) })\n        + ins.map(i -> diff.Line { s: \"+\", text: line_b(i) })\n      continue\n    }\n    mut next := 0\n    for d in dels {\n      ds := get(sa, d) ?? []\n      changes_a := set(\n        ds.map(s -> s.2).filter(c -> get(kinds, c) != Some(\"moved\")),\n      )\n      mut found := -1\n      mut j2 := next\n      // first a line holding one of its changes, then a similar one\n      while j2 < len(ins) && found < 0 {\n        bs := get(sb, get(ins, j2) ?? 0) ?? []\n        if bs.any(s -> contains(changes_a, s.2)) {\n          found = j2\n        }\n        j2 += 1\n      }\n      j2 = next\n      while j2 < len(ins) && found < 0 {\n        bs := get(sb, get(ins, j2) ?? 0) ?? []\n        if ds == []\n          && bs == []\n          && diff.close(line_a(d), line_b(get(ins, j2) ?? 0)) {\n          found = j2\n        }\n        j2 += 1\n      }\n      if found >= 0 {\n        out += slice(ins, next, found).map(\n          i -> diff.Line {\n            s: \"+\",\n            text: line_b(i),\n            note: if moved_only(get(sb, i) ?? []) {\n              \"moved\"\n            } else {\n              \"\"\n            },\n          },\n        )\n        y := get(ins, found) ?? 0\n        segs := diff.line_segs(line_a(d), ds, line_b(y), get(sb, y) ?? [])\n        mut out.push(\n          if segs.all(s -> s.k == \"=\") {\n            diff.Line { s: \" \", text: line_b(y) }\n          } else {\n            diff.Line { s: \"~\", text: line_b(y), segs }\n          },\n        )\n        next = found + 1\n      } else {\n        mut out.push(\n          diff.Line {\n            s: \"-\",\n            text: line_a(d),\n            note: if moved_only(ds) {\n              \"moved\"\n            } else {\n              \"\"\n            },\n          },\n        )\n      }\n    }\n    out += slice(ins, next, len(ins)).map(\n      i -> diff.Line {\n        s: \"+\",\n        text: line_b(i),\n        note: if moved_only(get(sb, i) ?? []) {\n          \"moved\"\n        } else {\n          \"\"\n        },\n      },\n    )\n  }\n  Some((out, rewritten))\n}","old_text":"/// The lines of a change from `o` to `n`, from the nodes that changed\n/// (`cs`, `tree.changes`): each side is printed with its changed nodes\n/// placed. Lines are lined up by their text, without indentation, and by\n/// the changed nodes on them, so a line holding a changed node never\n/// counts as unchanged. A removed and an added line holding the same\n/// change are one line changed in place: the text around the nodes kept,\n/// each node's old and new text marked (an edited node word by word).\n/// Other removed and added lines are paired when they are similar, as\n/// `line_diff` does. The `Bool` is true when most lines changed; then\n/// nothing is paired. `None` when a side doesn't print with its nodes\n/// placed as it prints alone.\nfn node_lines(\n  o: ast.Decl,\n  n: ast.Decl,\n  cs: List[tree.Change],\n) -> Option[(List[diff.Line], Bool)] {\n  olds := [(c.old, k) for (k, c) in enumerate(cs) where c.kind != \"added\" && c.old != \"\"]\n  news := [(c.new, k) for (k, c) in enumerate(cs) where c.kind != \"removed\" && c.new != \"\"]\n  (la, sa) := diff.placed_code(o, olds)?\n  (lb, sb) := diff.placed_code(n, news)?\n  key := (l: String, ss: List[(Int, Int, Int)]) -> diff.trim_start(l)\n    + join(\n      ss.map(\n        s -> \"\\u{1}\" + diff.trim_start(byte_slice(l, s.0, s.1)),\n      ),\n      \"\",\n    )\n  ka := [key(l, get(sa, i) ?? []) for (i, l) in enumerate(la)]\n  kb := [key(l, get(sb, i) ?? []) for (i, l) in enumerate(lb)]\n  ops := diff.lcs(ka, kb)\n  changed := len(ops.filter(x -> x.0 != 0))\n  total := len(la) + len(lb)\n  rewritten := total > 8 && changed * 10 >= total * 6\n  kinds := cs.map(c -> c.kind)\n  mut out := []\n  mut k := 0\n  while k < len(ops) {\n    (op, _, j) := get(ops, k) ?? (0, 0, 0)\n    if op == 0 {\n      mut out.push(diff.Line { s: \" \", text: get(lb, j) ?? \"\" })\n      k += 1\n      continue\n    }\n    mut dels := []\n    mut ins := []\n    while k < len(ops) && (get(ops, k) ?? (0, 0, 0)).0 != 0 {\n      (x, a, b) := get(ops, k) ?? (0, 0, 0)\n      if x == 1 {\n        mut dels.push(a)\n      } else {\n        mut ins.push(b)\n      }\n      k += 1\n    }\n    line_a := (i: Int) -> get(la, i) ?? \"\"\n    line_b := (i: Int) -> get(lb, i) ?? \"\"\n    moved_only := (ss: List[(Int, Int, Int)]) ->\n      ss != [] && ss.all(s -> get(kinds, s.2) == Some(\"moved\"))\n    if rewritten {\n      out = out\n        + dels.map(d -> diff.Line { s: \"-\", text: line_a(d) })\n        + ins.map(i -> diff.Line { s: \"+\", text: line_b(i) })\n      continue\n    }\n    mut next := 0\n    for d in dels {\n      ds := get(sa, d) ?? []\n      changes_a := set(\n        ds.map(s -> s.2).filter(c -> get(kinds, c) != Some(\"moved\")),\n      )\n      mut found := -1\n      mut j2 := next\n      // first a line holding one of its changes, then a similar one\n      while j2 < len(ins) && found < 0 {\n        bs := get(sb, get(ins, j2) ?? 0) ?? []\n        if bs.any(s -> contains(changes_a, s.2)) {\n          found = j2\n        }\n        j2 += 1\n      }\n      j2 = next\n      while j2 < len(ins) && found < 0 {\n        bs := get(sb, get(ins, j2) ?? 0) ?? []\n        if ds == []\n          && bs == []\n          && diff.close(line_a(d), line_b(get(ins, j2) ?? 0)) {\n          found = j2\n        }\n        j2 += 1\n      }\n      if found >= 0 {\n        out += slice(ins, next, found).map(\n          i -> diff.Line {\n            s: \"+\",\n            text: line_b(i),\n            note: if moved_only(get(sb, i) ?? []) {\n              \"moved\"\n            } else {\n              \"\"\n            },\n          },\n        )\n        y := get(ins, found) ?? 0\n        segs := diff.line_segs(\n          line_a(d),\n          ds,\n          line_b(y),\n          get(sb, y) ?? [],\n          kinds,\n        )\n        mut out.push(\n          if segs.all(s -> s.k == \"=\") {\n            diff.Line { s: \" \", text: line_b(y) }\n          } else {\n            diff.Line { s: \"~\", text: line_b(y), segs }\n          },\n        )\n        next = found + 1\n      } else {\n        mut out.push(\n          diff.Line {\n            s: \"-\",\n            text: line_a(d),\n            note: if moved_only(ds) {\n              \"moved\"\n            } else {\n              \"\"\n            },\n          },\n        )\n      }\n    }\n    out += slice(ins, next, len(ins)).map(\n      i -> diff.Line {\n        s: \"+\",\n        text: line_b(i),\n        note: if moved_only(get(sb, i) ?? []) {\n          \"moved\"\n        } else {\n          \"\"\n        },\n      },\n    )\n  }\n  Some((out, rewritten))\n}"},{"name":"diff.line_segs","kind":"fn","old":"c536d3a91c108d61","new":"8a64bc8ad12fb824","interface_changed":true,"affected":["diff.node_lines","diff.diff","diff.range_diff","diff.range_text","diff_command","tour.package_changes","command_line","tour.prepare","main","tour_command","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","tour_graph","linked","expanded","comptime_runner","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","rename_command","move_command","fix_command","edit_in_editor"],"module":"diff","text":"/// The pieces of a line changed in place. When both lines hold the same\n/// changes in the same order, with the same text around them, the text\n/// around is kept and each changed node's old and new text are compared\n/// word by word, so nothing outside a changed node shows as changed.\n/// Otherwise the two lines are compared word by word.\nfn line_segs(\n  a: String,\n  sa: List[(Int, Int, Int)],\n  b: String,\n  sb: List[(Int, Int, Int)],\n) -> List[diff.Seg] {\n  pieces := (l: String, ss: List[(Int, Int, Int)]) -> {\n    mut out := []\n    mut at := 0\n    for s in ss {\n      mut out.push(byte_slice(l, at, s.0))\n      at = s.1\n    }\n    mut out.push(byte_slice(l, at, byte_len(l)))\n    out\n  }\n  pa := pieces(a, sa)\n  pb := pieces(b, sb)\n  same_around := len(sa) == len(sb)\n    && len(sa) > 0\n    && zip(sa, sb).all(p -> p.0.2 == p.1.2)\n    && zip(pa, pb).all(\n      p -> diff.trim_start(p.0) == diff.trim_start(p.1),\n    )\n  if !same_around {\n    return diff.segments(a, b)\n  }\n  mut out := []\n  for (i, s) in enumerate(sb) {\n    mut out.push(diff.Seg { k: \"=\", t: get(pb, i) ?? \"\" })\n    r := get(sa, i) ?? s\n    ta := byte_slice(a, r.0, r.1)\n    tb := byte_slice(b, s.0, s.1)\n    if ta == tb {\n      mut out.push(diff.Seg { k: \"=\", t: tb })\n    } else {\n      out += diff.segments(ta, tb)\n    }\n  }\n  mut out.push(diff.Seg { k: \"=\", t: get(pb, len(sb)) ?? \"\" })\n  // pieces next to each other of one kind are one piece\n  mut merged := []\n  for x in out.filter(x -> x.t != \"\") {\n    match get(merged, len(merged) - 1) {\n      Some(last) => if last.k == x.k {\n        merged = slice(merged, 0, len(merged) - 1)\n          + [diff.Seg { k: x.k, t: last.t + x.t }]\n      } else {\n        mut merged.push(x)\n      },\n      None => mut merged.push(x),\n    }\n  }\n  merged\n}","old_text":"/// The pieces of a line changed in place. When both lines hold the same\n/// changes in the same order, with the same text around them, the text\n/// around is kept and each change marked: an edited node word by word,\n/// another as its old text removed and its new text added. Otherwise\n/// the two lines are compared word by word.\nfn line_segs(\n  a: String,\n  sa: List[(Int, Int, Int)],\n  b: String,\n  sb: List[(Int, Int, Int)],\n  kinds: List[String],\n) -> List[diff.Seg] {\n  pieces := (l: String, ss: List[(Int, Int, Int)]) -> {\n    mut out := []\n    mut at := 0\n    for s in ss {\n      mut out.push(byte_slice(l, at, s.0))\n      at = s.1\n    }\n    mut out.push(byte_slice(l, at, byte_len(l)))\n    out\n  }\n  pa := pieces(a, sa)\n  pb := pieces(b, sb)\n  same_around := len(sa) == len(sb)\n    && len(sa) > 0\n    && zip(sa, sb).all(p -> p.0.2 == p.1.2)\n    && zip(pa, pb).all(\n      p -> diff.trim_start(p.0) == diff.trim_start(p.1),\n    )\n  if !same_around {\n    return diff.segments(a, b)\n  }\n  mut out := []\n  for (i, s) in enumerate(sb) {\n    mut out.push(diff.Seg { k: \"=\", t: get(pb, i) ?? \"\" })\n    r := get(sa, i) ?? s\n    ta := byte_slice(a, r.0, r.1)\n    tb := byte_slice(b, s.0, s.1)\n    if ta == tb {\n      mut out.push(diff.Seg { k: \"=\", t: tb })\n    } else if get(kinds, s.2) == Some(\"edited\") {\n      out += diff.segments(ta, tb)\n    } else {\n      out += [diff.Seg { k: \"-\", t: ta }, diff.Seg { k: \"+\", t: tb }]\n    }\n  }\n  mut out.push(diff.Seg { k: \"=\", t: get(pb, len(sb)) ?? \"\" })\n  // pieces next to each other of one kind are one piece\n  mut merged := []\n  for x in out.filter(x -> x.t != \"\") {\n    match get(merged, len(merged) - 1) {\n      Some(last) => if last.k == x.k {\n        merged = slice(merged, 0, len(merged) - 1)\n          + [diff.Seg { k: x.k, t: last.t + x.t }]\n      } else {\n        mut merged.push(x)\n      },\n      None => mut merged.push(x),\n    }\n  }\n  merged\n}"}]}
{"id":"c9a4181cfe040bd6","time":1795724139,"message":"merge-file merges stored forms","changes":[{"name":"use resolve","kind":"use","old":"b438712124fc0fa5","new":"3c5de1f1e4506d82","interface_changed":true,"affected":[],"module":"","text":"from resolve use stored, written, written_at, inline_members, errors,\n  errors_from, relocated","old_text":"from resolve use stored, written, inline_members, errors, errors_from, relocated"},{"name":"merge_file_command","kind":"fn","old":"cf4a2d17d732e445","new":"340e13d1a7248aa5","interface_changed":false,"affected":[],"module":"","text":"/// `strata merge-file BASE OURS THEIRS [PATH]` (git: `%O %A %B %P`):\n/// merges the three versions definition by definition, and inside a\n/// definition changed on both sides node by node (their stored forms, so\n/// an import that shortens names changes nothing), into OURS, then checks.\n/// A node in conflict is left in OURS as a hole, `?conflict_N(ours, base,\n/// theirs)` (`strata holes` lists them); a conflict outside every\n/// expression leaves OURS as text with conflict markers.\nfn merge_file_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  args: List[String],\n) -> std.process.ExitCode {\n  (o, a, b) := match args {\n    [o, a, b, ..] => (o, a, b),\n    _ => return fail_with(\n      mut console,\n      \"usage: strata merge-file BASE OURS THEIRS [PATH]  (git: `strata merge-file %O %A %B %P`)\",\n    ),\n  }\n  path := get(args, 3) ?? a\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  core := read_core_at(disk, home)\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  read := (f: String) -> match disk.read_bytes(f) {\n    Ok([]) => Ok([]),\n    Ok(bytes) => match binary.read(bytes) {\n      Ok(img) => Ok(img.decls),\n      Err(e) => Err(e),\n    },\n    Err(e) => Err(f\"{f}: {e}\"),\n  }\n  (base, ours, theirs) := match (read(o), read(a), read(b)) {\n    (Ok(x), Ok(y), Ok(z)) => (x, y, z),\n    (x, y, z) => {\n      es := [e for e in [x, y, z].map(\n        r -> match r {\n          Err(e) => e,\n          Ok(_) => \"\",\n        },\n      ) where e != \"\"]\n      mut console.eprint(\n        f\"strata: {path}: can't merge: {join(es, \"; \")}\",\n      )\n      return 1\n    },\n  }\n  // (the module as the sides store it. A package's own name for it can\n  // differ: core's `core.list` is the file `list.strata`. Else the module the\n  // file is in its package. A side stored as a script, `save`d or `--file`\n  // edited, has its definitions in no module.)\n  module := match [d.module for d in ours + theirs + base where d.module != \"\"] {\n    [m, ..] => m,\n    [] => match module_at(disk, path) {\n      Some((_, m)) => m,\n      None => \"\",\n    },\n  }\n  relabel := (ds: List[ast.Decl]) -> ds.map(d -> ast.Decl { ..d, module })\n  // (each side written against the package's other modules, as `render`\n  // shows it. A name a module imports stays short, `helper()`: written in\n  // full, `util.helper()`, a local named `util` would read it, once stored\n  // again, as that local's method.)\n  others := others_at_stored(disk, path, module, std, core)\n  side_text := (ds: List[ast.Decl]) ->\n    resolve.written(others + relabel(ds), std, core).filter(\n      d -> d.module == module,\n    )\n  text := (ds: List[ast.Decl]) -> text.module_text(side_text(ds))\n  tmp := (process.var(\"TMPDIR\") ?? \"/tmp\")\n    + \"/strata-merge-\"\n    + f\"{byte_len(path)}-{byte_len(o)}\"\n  // a definition merged from the stored forms, written as ours shows it,\n  // with the imports theirs added\n  added_uses := relabel(theirs).filter(\n    d -> match d.kind {\n      ast.UseDef(_) => !ours.any(x -> store.qname(x) == store.qname(d)),\n      _ => false,\n    },\n  )\n  write := (d: ast.Decl) -> {\n    mine := relabel(ours)\n    at := [i for (i, x) in enumerate(mine) where store.qname(x) == store.qname(d)]\n    match at {\n      [i] => {\n        ctx := others\n          + [if k == i {\n            ast.Decl { ..d, module }\n          } else {\n            x\n          } for (k, x) in enumerate(mine)]\n          + added_uses\n        get(\n          resolve.written_at(ctx, set([len(others) + i]), std, core),\n          0,\n        )\n      },\n      _ => None,\n    }\n  }\n  m := match merge.merge(\n    mut disk,\n    mut launcher,\n    tmp,\n    text(base),\n    text(ours),\n    text(theirs),\n    [relabel(base), relabel(ours), relabel(theirs)],\n    write,\n  ) {\n    Ok(m) => m,\n    Err(e) => return fail_with(mut console, e),\n  }\n  for n in m.notes {\n    mut console.eprint(f\"strata: {path}: {n}\")\n  }\n  if len(m.conflicts) > 0 {\n    mut disk.write(a, m.text) !! ()\n    for c in m.conflicts {\n      mut console.eprint(f\"strata: {path}: conflict in {c}\")\n    }\n    mut console.eprint(\n      f\"strata: {path} is left as text with conflict markers: fix it, then `strata resolve {path}` stores it\",\n    )\n    return 1\n  }\n  merged := match parse.parse_module(m.text, module) {\n    Ok(ds) => ds,\n    Err(e) => return fail_with(mut console, f\"{path}: the merge doesn't parse ({e})\"),\n  }\n  // a definition taken whole from one side keeps that side's stored form:\n  // read back from its text, a name it shows in full (`cache.caching()`)\n  // would be taken for a method of a local of the module's name\n  kept := (side: List[ast.Decl]) -> {\n    ws := side_text(side)\n    own := relabel(side)\n    if len(ws) == len(own) {\n      zip(ws.map(w -> text.decl_text(w)), own)\n    } else {\n      []\n    }\n  }\n  whole := kept(ours) + kept(theirs) + m.kept\n  final := kept_decls(disk, path, module, merged, whole, std, core)\n  match mut disk.write_bytes(\n    a,\n    binary.encode_module(final, module, store.graph(\n      others_at_stored(disk, path, module, std, core) + final,\n      false,\n    )),\n  ) {\n    Err(e) => return fail_with(mut console, f\"{a}: {e}\"),\n    Ok(_) => (),\n  }\n  if len(m.holes) > 0 {\n    for h in m.holes {\n      mut console.eprint(f\"strata: {path}: conflict in {h}\")\n    }\n    mut console.eprint(\n      f\"strata: {path}: each conflict is a hole `?conflict_N(ours, base, theirs)`: replace it with the code to keep (`strata edit`), then `git add {path}`\",\n    )\n    return 1\n  }\n  if process.var(\"STRATA_MERGE_BASE\") is Some {\n    return 0\n  }\n  // what doesn't check now that checked on both sides\n  others := match module_at(disk, path) {\n    Some((r, _)) => package_decls(disk, r, module_prefix(disk, r)).filter(\n      d -> d.module != module,\n    ),\n    None => [],\n  }\n  // (`[values] read = true`: the package may read compiled values back)\n  values := match module_at(disk, path) {\n    Some((r, _)) => package_reads_values(disk, r),\n    None => false,\n  }\n  errors_of := (side: List[ast.Decl]) -> {\n    all := resolve.stored(\n      others + side.map(d -> ast.Decl { ..d, module }),\n      std,\n      core,\n    )\n    lib := std_imports(disk, std_dir, all)\n    check_errors_of(all, lib, core, values).map(\n      e -> f\"{e.0}: {e.1}\",\n    )\n  }\n  known := errors_of(ours) + errors_of(theirs)\n  fresh := errors_of(final).filter(e -> !contains(known, e))\n  if len(fresh) > 0 {\n    mut console.eprint(\n      f\"strata: {path}: merged definition by definition, but the result doesn't check:\",\n    )\n    for e in fresh {\n      mut console.eprint(f\"    {e}\")\n    }\n    return 1\n  }\n  0\n}","old_text":"/// `strata merge-file BASE OURS THEIRS [PATH]` (git: `%O %A %B %P`):\n/// merges the three versions definition by definition, and inside a\n/// definition changed on both sides node by node, into OURS, then checks.\n/// A node in conflict is left in OURS as a hole, `?conflict_N(ours, base,\n/// theirs)` (`strata holes` lists them); a conflict outside every\n/// expression leaves OURS as text with conflict markers.\nfn merge_file_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  args: List[String],\n) -> std.process.ExitCode {\n  (o, a, b) := match args {\n    [o, a, b, ..] => (o, a, b),\n    _ => return fail_with(\n      mut console,\n      \"usage: strata merge-file BASE OURS THEIRS [PATH]  (git: `strata merge-file %O %A %B %P`)\",\n    ),\n  }\n  path := get(args, 3) ?? a\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  core := read_core_at(disk, home)\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  read := (f: String) -> match disk.read_bytes(f) {\n    Ok([]) => Ok([]),\n    Ok(bytes) => match binary.read(bytes) {\n      Ok(img) => Ok(img.decls),\n      Err(e) => Err(e),\n    },\n    Err(e) => Err(f\"{f}: {e}\"),\n  }\n  (base, ours, theirs) := match (read(o), read(a), read(b)) {\n    (Ok(x), Ok(y), Ok(z)) => (x, y, z),\n    (x, y, z) => {\n      es := [e for e in [x, y, z].map(\n        r -> match r {\n          Err(e) => e,\n          Ok(_) => \"\",\n        },\n      ) where e != \"\"]\n      mut console.eprint(\n        f\"strata: {path}: can't merge: {join(es, \"; \")}\",\n      )\n      return 1\n    },\n  }\n  // (the module as the sides store it. A package's own name for it can\n  // differ: core's `core.list` is the file `list.strata`. Else the module the\n  // file is in its package. A side stored as a script, `save`d or `--file`\n  // edited, has its definitions in no module.)\n  module := match [d.module for d in ours + theirs + base where d.module != \"\"] {\n    [m, ..] => m,\n    [] => match module_at(disk, path) {\n      Some((_, m)) => m,\n      None => \"\",\n    },\n  }\n  relabel := (ds: List[ast.Decl]) -> ds.map(d -> ast.Decl { ..d, module })\n  // (each side written against the package's other modules, as `render`\n  // shows it. A name a module imports stays short, `helper()`: written in\n  // full, `util.helper()`, a local named `util` would read it, once stored\n  // again, as that local's method.)\n  others := others_at_stored(disk, path, module, std, core)\n  side_text := (ds: List[ast.Decl]) ->\n    resolve.written(others + relabel(ds), std, core).filter(\n      d -> d.module == module,\n    )\n  text := (ds: List[ast.Decl]) -> text.module_text(side_text(ds))\n  tmp := (process.var(\"TMPDIR\") ?? \"/tmp\")\n    + \"/strata-merge-\"\n    + f\"{byte_len(path)}-{byte_len(o)}\"\n  m := match merge.merge(\n    mut disk,\n    mut launcher,\n    tmp,\n    text(base),\n    text(ours),\n    text(theirs),\n  ) {\n    Ok(m) => m,\n    Err(e) => return fail_with(mut console, e),\n  }\n  for n in m.notes {\n    mut console.eprint(f\"strata: {path}: {n}\")\n  }\n  if len(m.conflicts) > 0 {\n    mut disk.write(a, m.text) !! ()\n    for c in m.conflicts {\n      mut console.eprint(f\"strata: {path}: conflict in {c}\")\n    }\n    mut console.eprint(\n      f\"strata: {path} is left as text with conflict markers: fix it, then `strata resolve {path}` stores it\",\n    )\n    return 1\n  }\n  merged := match parse.parse_module(m.text, module) {\n    Ok(ds) => ds,\n    Err(e) => return fail_with(mut console, f\"{path}: the merge doesn't parse ({e})\"),\n  }\n  // a definition taken whole from one side keeps that side's stored form:\n  // read back from its text, a name it shows in full (`cache.caching()`)\n  // would be taken for a method of a local of the module's name\n  kept := (side: List[ast.Decl]) -> {\n    ws := side_text(side)\n    own := relabel(side)\n    if len(ws) == len(own) {\n      zip(ws.map(w -> text.decl_text(w)), own)\n    } else {\n      []\n    }\n  }\n  whole := kept(ours) + kept(theirs)\n  final := kept_decls(disk, path, module, merged, whole, std, core)\n  match mut disk.write_bytes(\n    a,\n    binary.encode_module(final, module, store.graph(\n      others_at_stored(disk, path, module, std, core) + final,\n      false,\n    )),\n  ) {\n    Err(e) => return fail_with(mut console, f\"{a}: {e}\"),\n    Ok(_) => (),\n  }\n  if len(m.holes) > 0 {\n    for h in m.holes {\n      mut console.eprint(f\"strata: {path}: conflict in {h}\")\n    }\n    mut console.eprint(\n      f\"strata: {path}: each conflict is a hole `?conflict_N(ours, base, theirs)`: replace it with the code to keep (`strata edit`), then `git add {path}`\",\n    )\n    return 1\n  }\n  if process.var(\"STRATA_MERGE_BASE\") is Some {\n    return 0\n  }\n  // what doesn't check now that checked on both sides\n  others := match module_at(disk, path) {\n    Some((r, _)) => package_decls(disk, r, module_prefix(disk, r)).filter(\n      d -> d.module != module,\n    ),\n    None => [],\n  }\n  // (`[values] read = true`: the package may read compiled values back)\n  values := match module_at(disk, path) {\n    Some((r, _)) => package_reads_values(disk, r),\n    None => false,\n  }\n  errors_of := (side: List[ast.Decl]) -> {\n    all := resolve.stored(\n      others + side.map(d -> ast.Decl { ..d, module }),\n      std,\n      core,\n    )\n    lib := std_imports(disk, std_dir, all)\n    check_errors_of(all, lib, core, values).map(\n      e -> f\"{e.0}: {e.1}\",\n    )\n  }\n  known := errors_of(ours) + errors_of(theirs)\n  fresh := errors_of(final).filter(e -> !contains(known, e))\n  if len(fresh) > 0 {\n    mut console.eprint(\n      f\"strata: {path}: merged definition by definition, but the result doesn't check:\",\n    )\n    for e in fresh {\n      mut console.eprint(f\"    {e}\")\n    }\n    return 1\n  }\n  0\n}"},{"name":"merge.Merged","kind":"type","old":"664d810083b628e8","new":"18264f794d545992","interface_changed":true,"affected":["merge.merge","merge_file_command","command_line","main","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","tour_graph","linked","expanded","comptime_runner","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","diff_command","tour_command","with_base","rename_command","move_command","fix_command","edit_in_editor"],"module":"merge","text":"/// The merged text, the definitions left in conflict as text, and what was\n/// done. `holes`: the nodes in conflict inside definitions that merged\n/// otherwise, each left as a hole `?conflict_N(ours, base, theirs)` in the\n/// merged code (`definition: ?conflict_N at PATH`).\npub type Merged = {\n  text: String,\n  conflicts: List[String],\n  notes: List[String],\n  holes: List[String] = [],\n  // definitions merged from the sides' stored forms: each one's merged text\n  // with the stored definition it stands for\n  kept: List[(String, ast.Decl)] = [],\n}","old_text":"/// The merged text, the definitions left in conflict as text, and what was\n/// done. `holes`: the nodes in conflict inside definitions that merged\n/// otherwise, each left as a hole `?conflict_N(ours, base, theirs)` in the\n/// merged code (`definition: ?conflict_N at PATH`).\npub type Merged = {\n  text: String,\n  conflicts: List[String],\n  notes: List[String],\n  holes: List[String] = [],\n}"},{"name":"merge.merge","kind":"fn","old":"092fd2476feebc57","new":"fc43919b95fb75a6","interface_changed":true,"affected":["merge_file_command","command_line","main","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","tour_graph","linked","expanded","comptime_runner","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","diff_command","tour_command","with_base","rename_command","move_command","fix_command","edit_in_editor"],"module":"merge","text":"/// `base`, `ours` and `theirs` are module texts. `stored` holds the same\n/// three sides as stored (qualified names, no imports' shortening): a\n/// definition changed on both sides is merged node by node from these,\n/// and `write` gives the merged one's written form (`None`: it can't be\n/// written, then the texts' definitions are merged instead).\npub fn merge[F: std.fs.Files, C: std.process.Commands](\n  mut files: F,\n  mut run: C,\n  tmp: String,\n  base: String,\n  ours: String,\n  theirs: String,\n  stored: List[List[ast.Decl]],\n  write: (ast.Decl) -> Option[ast.Decl],\n) -> Result[merge.Merged, String] {\n  mut o := match parse.parse_module(base, \"\") {\n    Ok(ds) => ds,\n    Err(e) => return Err(f\"base doesn't parse ({e})\"),\n  }\n  mut a := match parse.parse_module(ours, \"\") {\n    Ok(ds) => ds,\n    Err(e) => return Err(f\"ours doesn't parse ({e})\"),\n  }\n  mut b := match parse.parse_module(theirs, \"\") {\n    Ok(ds) => ds,\n    Err(e) => return Err(f\"theirs doesn't parse ({e})\"),\n  }\n  mut notes := []\n  mut conflicts := []\n  ra := merge.renames(o, a)\n  rb := merge.renames(o, b)\n  for (from, to) in ra {\n    mut skip := false\n    match rb.find(r -> r.0 == from) {\n      Some((_, t)) => if t == to {\n        mut notes.push(f\"both sides renamed {from} → {to}\")\n      } else {\n        mut conflicts.push(\n          f\"{from} (renamed to {to} in ours, {t} in theirs)\",\n        )\n        skip = true\n      },\n      None => (),\n    }\n    if skip {\n      continue\n    }\n    o = refactor.rename_all(o, [(from, refactor.short(to))]) !! o\n    if b.any(d -> store.qname(d) == from) {\n      match refactor.rename_all(b, [(from, refactor.short(to))]) {\n        Ok(r) => {\n          b = r\n          mut notes.push(\n            f\"ours renamed {from} → {to}; applied to theirs\",\n          )\n        },\n        Err(e) => mut notes.push(\n          f\"ours renamed {from} → {to}, but theirs can't follow it: {e}\",\n        ),\n      }\n    }\n  }\n  for (from, to) in rb {\n    if ra.any(r -> r.0 == from) {\n      continue\n    }\n    o = refactor.rename_all(o, [(from, refactor.short(to))]) !! o\n    if a.any(d -> store.qname(d) == from) {\n      match refactor.rename_all(a, [(from, refactor.short(to))]) {\n        Ok(r) => {\n          a = r\n          mut notes.push(\n            f\"theirs renamed {from} → {to}; applied to ours\",\n          )\n        },\n        Err(e) => mut notes.push(\n          f\"theirs renamed {from} → {to}, but ours can't follow it: {e}\",\n        ),\n      }\n    }\n  }\n  // ours' order, with each of theirs' new ones after its predecessor\n  mut order := a.map(d -> merge.key(d))\n  for (i, d) in enumerate(b) {\n    q := merge.key(d)\n    if contains(order, q) {\n      continue\n    }\n    mut at := 0\n    mut k := i - 1\n    while k >= 0 {\n      pq := merge.key(get(b, k) ?? d)\n      match [j for (j, n) in enumerate(order) where n == pq] {\n        [j, ..] => {\n          at = j + 1\n          k = -1\n        },\n        [] => {\n          k -= 1\n        },\n      }\n    }\n    order = [n for (j, n) in enumerate(order) where j < at]\n      + [q]\n      + [n for (j, n) in enumerate(order) where j >= at]\n  }\n  find := (ds: List[ast.Decl], q: String) -> ds.find(d -> merge.key(d) == q)\n  mut pieces := []\n  mut from_theirs := 0\n  mut by_line := 0\n  mut by_node := 0\n  mut next_hole := 1\n  mut holes := []\n  mut kept := []\n  nl := (t: String) -> if t == \"\" {\n    t\n  } else {\n    t + \"\\n\"\n  }\n  for q in order {\n    od := find(o, q)\n    ad := find(a, q)\n    bd := find(b, q)\n    match (od, ad, bd) {\n      (_, Some(x), Some(y)) => if merge.canon(x) == merge.canon(y) {\n        mut pieces.push(merge.Merged_decl(x))\n      } else if od is Some && merge.canon(od ?? x) == merge.canon(x) {\n        from_theirs += 1\n        mut pieces.push(merge.Merged_decl(y))\n      } else if od is Some && merge.canon(od ?? y) == merge.canon(y) {\n        mut pieces.push(merge.Merged_decl(x))\n      } else {\n        // node by node from the base; a conflict outside every expression\n        // falls back to the lines\n        mut done := false\n        match od {\n          Some(z) => {\n            // from the stored forms: an import that shortens names on one\n            // side changes no node there\n            from_stored := match (\n              merge.stored_named(get(stored, 0) ?? [], z),\n              merge.stored_named(get(stored, 1) ?? [], x),\n              merge.stored_named(get(stored, 2) ?? [], y),\n            ) {\n              (Some(sz), Some(sx), Some(sy)) => {\n                ts := tree.merge(sz, sx, sy, next_hole)\n                match ts.decl {\n                  Some(sd) => match write(sd) {\n                    Some(w) => Some((ts, w, sd)),\n                    None => None,\n                  },\n                  None => None,\n                }\n              },\n              _ => None,\n            }\n            t := match from_stored {\n              Some((ts, w, sd)) => {\n                mut kept.push((merge.canon(w), sd))\n                tree.DeclMerge {\n                  decl: Some(w),\n                  conflicts: ts.conflicts,\n                }\n              },\n              None => tree.merge(z, x, y, next_hole),\n            }\n            match t.decl {\n              Some(d) => {\n                next_hole += len(t.conflicts)\n                if len(t.conflicts) == 0 {\n                  by_node += 1\n                }\n                for c in t.conflicts {\n                  mut holes.push(f\"{q}: ?{c.name} at {c.path}\")\n                }\n                mut pieces.push(merge.Merged_decl(d))\n                done = true\n              },\n              None => (),\n            }\n          },\n          None => (),\n        }\n        if !done {\n          ot := match od {\n            Some(z) => merge.canon(z),\n            None => \"\",\n          }\n          (text, clean) := merge.line_merge(\n            mut files,\n            mut run,\n            tmp,\n            nl(ot),\n            nl(merge.canon(x)),\n            nl(merge.canon(y)),\n          )!\n          if clean {\n            match parse.parse_module(text, \"\") {\n              Ok([d]) => if merge.decl_name_of(d) == merge.decl_name_of(x) {\n                by_line += 1\n                mut pieces.push(\n                  merge.Merged_decl(\n                    ast.Decl { ..d, module: x.module, public: d.public || x.public && y.public },\n                  ),\n                )\n                done = true\n              },\n              _ => (),\n            }\n          }\n          if !done {\n            mut conflicts.push(q)\n            mut pieces.push(merge.Merged_text(merge.trim_end(text)))\n          }\n        }\n      },\n      (Some(z), Some(x), None) => if merge.canon(z) != merge.canon(x) {\n        mut conflicts.push(f\"{q} (changed in ours, deleted in theirs)\")\n        mut pieces.push(\n          merge.Merged_text(\n            f\"<<<<<<< ours\\n{nl(merge.canon(x))}||||||| base\\n{nl(merge.canon(z))}=======\\n>>>>>>> theirs (deleted)\",\n          ),\n        )\n      },\n      (Some(z), None, Some(y)) => if merge.canon(z) != merge.canon(y) {\n        mut conflicts.push(f\"{q} (deleted in ours, changed in theirs)\")\n        mut pieces.push(\n          merge.Merged_text(\n            f\"<<<<<<< ours (deleted)\\n||||||| base\\n{nl(merge.canon(z))}=======\\n{nl(merge.canon(y))}>>>>>>> theirs\",\n          ),\n        )\n      },\n      (None, Some(x), None) => mut pieces.push(merge.Merged_decl(x)),\n      (None, None, Some(y)) => {\n        from_theirs += 1\n        mut pieces.push(merge.Merged_decl(y))\n      },\n      _ => (),\n    }\n  }\n  if from_theirs > 0 {\n    mut notes.push(\n      f\"{from_theirs} definition{if from_theirs == 1 {\n  \"\"\n} else {\n  \"s\"\n}} from theirs\",\n    )\n  }\n  if by_node > 0 {\n    mut notes.push(\n      f\"{by_node} definition{if by_node == 1 {\n  \"\"\n} else {\n  \"s\"\n}} changed on both sides, merged node by node\",\n    )\n  }\n  if by_line > 0 {\n    mut notes.push(\n      f\"{by_line} definition{if by_line == 1 {\n  \"\"\n} else {\n  \"s\"\n}} changed on both sides, merged line by line\",\n    )\n  }\n  out := pieces.map(\n    p -> match p {\n      merge.Merged_decl(d) => merge.canon(d),\n      merge.Merged_text(t) => t,\n    },\n  )\n  Ok(merge.Merged { text: if len(out) == 0 {\n    \"\"\n  } else {\n    join(out, \"\\n\\n\") + \"\\n\"\n  }, conflicts, notes, holes, kept })\n}","old_text":"/// `base`, `ours` and `theirs` are module texts.\npub fn merge[F: std.fs.Files, C: std.process.Commands](\n  mut files: F,\n  mut run: C,\n  tmp: String,\n  base: String,\n  ours: String,\n  theirs: String,\n) -> Result[merge.Merged, String] {\n  mut o := match parse.parse_module(base, \"\") {\n    Ok(ds) => ds,\n    Err(e) => return Err(f\"base doesn't parse ({e})\"),\n  }\n  mut a := match parse.parse_module(ours, \"\") {\n    Ok(ds) => ds,\n    Err(e) => return Err(f\"ours doesn't parse ({e})\"),\n  }\n  mut b := match parse.parse_module(theirs, \"\") {\n    Ok(ds) => ds,\n    Err(e) => return Err(f\"theirs doesn't parse ({e})\"),\n  }\n  mut notes := []\n  mut conflicts := []\n  ra := merge.renames(o, a)\n  rb := merge.renames(o, b)\n  for (from, to) in ra {\n    mut skip := false\n    match rb.find(r -> r.0 == from) {\n      Some((_, t)) => if t == to {\n        mut notes.push(f\"both sides renamed {from} → {to}\")\n      } else {\n        mut conflicts.push(\n          f\"{from} (renamed to {to} in ours, {t} in theirs)\",\n        )\n        skip = true\n      },\n      None => (),\n    }\n    if skip {\n      continue\n    }\n    o = refactor.rename_all(o, [(from, refactor.short(to))]) !! o\n    if b.any(d -> store.qname(d) == from) {\n      match refactor.rename_all(b, [(from, refactor.short(to))]) {\n        Ok(r) => {\n          b = r\n          mut notes.push(\n            f\"ours renamed {from} → {to}; applied to theirs\",\n          )\n        },\n        Err(e) => mut notes.push(\n          f\"ours renamed {from} → {to}, but theirs can't follow it: {e}\",\n        ),\n      }\n    }\n  }\n  for (from, to) in rb {\n    if ra.any(r -> r.0 == from) {\n      continue\n    }\n    o = refactor.rename_all(o, [(from, refactor.short(to))]) !! o\n    if a.any(d -> store.qname(d) == from) {\n      match refactor.rename_all(a, [(from, refactor.short(to))]) {\n        Ok(r) => {\n          a = r\n          mut notes.push(\n            f\"theirs renamed {from} → {to}; applied to ours\",\n          )\n        },\n        Err(e) => mut notes.push(\n          f\"theirs renamed {from} → {to}, but ours can't follow it: {e}\",\n        ),\n      }\n    }\n  }\n  // ours' order, with each of theirs' new ones after its predecessor\n  mut order := a.map(d -> merge.key(d))\n  for (i, d) in enumerate(b) {\n    q := merge.key(d)\n    if contains(order, q) {\n      continue\n    }\n    mut at := 0\n    mut k := i - 1\n    while k >= 0 {\n      pq := merge.key(get(b, k) ?? d)\n      match [j for (j, n) in enumerate(order) where n == pq] {\n        [j, ..] => {\n          at = j + 1\n          k = -1\n        },\n        [] => {\n          k -= 1\n        },\n      }\n    }\n    order = [n for (j, n) in enumerate(order) where j < at]\n      + [q]\n      + [n for (j, n) in enumerate(order) where j >= at]\n  }\n  find := (ds: List[ast.Decl], q: String) -> ds.find(d -> merge.key(d) == q)\n  mut pieces := []\n  mut from_theirs := 0\n  mut by_line := 0\n  mut by_node := 0\n  mut next_hole := 1\n  mut holes := []\n  nl := (t: String) -> if t == \"\" {\n    t\n  } else {\n    t + \"\\n\"\n  }\n  for q in order {\n    od := find(o, q)\n    ad := find(a, q)\n    bd := find(b, q)\n    match (od, ad, bd) {\n      (_, Some(x), Some(y)) => if merge.canon(x) == merge.canon(y) {\n        mut pieces.push(merge.Merged_decl(x))\n      } else if od is Some && merge.canon(od ?? x) == merge.canon(x) {\n        from_theirs += 1\n        mut pieces.push(merge.Merged_decl(y))\n      } else if od is Some && merge.canon(od ?? y) == merge.canon(y) {\n        mut pieces.push(merge.Merged_decl(x))\n      } else {\n        // node by node from the base; a conflict outside every expression\n        // falls back to the lines\n        mut done := false\n        match od {\n          Some(z) => {\n            t := tree.merge(z, x, y, next_hole)\n            match t.decl {\n              Some(d) => {\n                next_hole += len(t.conflicts)\n                if len(t.conflicts) == 0 {\n                  by_node += 1\n                }\n                for c in t.conflicts {\n                  mut holes.push(f\"{q}: ?{c.name} at {c.path}\")\n                }\n                mut pieces.push(merge.Merged_decl(d))\n                done = true\n              },\n              None => (),\n            }\n          },\n          None => (),\n        }\n        if !done {\n          ot := match od {\n            Some(z) => merge.canon(z),\n            None => \"\",\n          }\n          (text, clean) := merge.line_merge(\n            mut files,\n            mut run,\n            tmp,\n            nl(ot),\n            nl(merge.canon(x)),\n            nl(merge.canon(y)),\n          )!\n          if clean {\n            match parse.parse_module(text, \"\") {\n              Ok([d]) => if merge.decl_name_of(d) == merge.decl_name_of(x) {\n                by_line += 1\n                mut pieces.push(\n                  merge.Merged_decl(\n                    ast.Decl { ..d, module: x.module, public: d.public || x.public && y.public },\n                  ),\n                )\n                done = true\n              },\n              _ => (),\n            }\n          }\n          if !done {\n            mut conflicts.push(q)\n            mut pieces.push(merge.Merged_text(merge.trim_end(text)))\n          }\n        }\n      },\n      (Some(z), Some(x), None) => if merge.canon(z) != merge.canon(x) {\n        mut conflicts.push(f\"{q} (changed in ours, deleted in theirs)\")\n        mut pieces.push(\n          merge.Merged_text(\n            f\"<<<<<<< ours\\n{nl(merge.canon(x))}||||||| base\\n{nl(merge.canon(z))}=======\\n>>>>>>> theirs (deleted)\",\n          ),\n        )\n      },\n      (Some(z), None, Some(y)) => if merge.canon(z) != merge.canon(y) {\n        mut conflicts.push(f\"{q} (deleted in ours, changed in theirs)\")\n        mut pieces.push(\n          merge.Merged_text(\n            f\"<<<<<<< ours (deleted)\\n||||||| base\\n{nl(merge.canon(z))}=======\\n{nl(merge.canon(y))}>>>>>>> theirs\",\n          ),\n        )\n      },\n      (None, Some(x), None) => mut pieces.push(merge.Merged_decl(x)),\n      (None, None, Some(y)) => {\n        from_theirs += 1\n        mut pieces.push(merge.Merged_decl(y))\n      },\n      _ => (),\n    }\n  }\n  if from_theirs > 0 {\n    mut notes.push(\n      f\"{from_theirs} definition{if from_theirs == 1 {\n  \"\"\n} else {\n  \"s\"\n}} from theirs\",\n    )\n  }\n  if by_node > 0 {\n    mut notes.push(\n      f\"{by_node} definition{if by_node == 1 {\n  \"\"\n} else {\n  \"s\"\n}} changed on both sides, merged node by node\",\n    )\n  }\n  if by_line > 0 {\n    mut notes.push(\n      f\"{by_line} definition{if by_line == 1 {\n  \"\"\n} else {\n  \"s\"\n}} changed on both sides, merged line by line\",\n    )\n  }\n  out := pieces.map(\n    p -> match p {\n      merge.Merged_decl(d) => merge.canon(d),\n      merge.Merged_text(t) => t,\n    },\n  )\n  Ok(merge.Merged { text: if len(out) == 0 {\n    \"\"\n  } else {\n    join(out, \"\\n\\n\") + \"\\n\"\n  }, conflicts, notes, holes })\n}"},{"name":"merge.stored_named","kind":"fn","old":null,"new":"3f416f67e83ab227","interface_changed":true,"affected":[],"module":"merge","text":"/// The definition of `ds` named as `d` is, when there is exactly one.\nfn stored_named(ds: List[ast.Decl], d: ast.Decl) -> Option[ast.Decl] {\n  match ds.filter(x -> merge.decl_name_of(x) == merge.decl_name_of(d)) {\n    [x] => Some(x),\n    _ => None,\n  }\n}"}]}
{"id":"6fac1b4298e77694","time":1795724397,"message":"edit","changes":[{"name":"diff.node_lines","kind":"fn","old":"6011b7cae7e82224","new":"9bfaa91c1078fd23","interface_changed":false,"affected":[],"module":"diff","text":"/// The lines of a change from `o` to `n`, from the nodes that changed\n/// (`cs`, `tree.changes`): each side is printed with its changed nodes\n/// placed. Lines are lined up by their text, without indentation, and by\n/// the changed nodes on them, so a line holding a changed node never\n/// counts as unchanged. A removed and an added line that are similar (as\n/// `line_diff` pairs them) and hold the same change, or no change at all,\n/// are one line changed in place: the text around the nodes kept, each\n/// node's old and new text compared word by word (`line_segs`). The `Bool` is\n/// true when most lines changed; then\n/// nothing is paired. `None` when a side doesn't print with its nodes\n/// placed as it prints alone.\nfn node_lines(\n  o: ast.Decl,\n  n: ast.Decl,\n  cs: List[tree.Change],\n) -> Option[(List[diff.Line], Bool)] {\n  olds := [(c.old, k) for (k, c) in enumerate(cs) where c.kind != \"added\" && c.old != \"\"]\n  news := [(c.new, k) for (k, c) in enumerate(cs) where c.kind != \"removed\" && c.new != \"\"]\n  (la, sa) := diff.placed_code(o, olds)?\n  (lb, sb) := diff.placed_code(n, news)?\n  key := (l: String, ss: List[(Int, Int, Int)]) -> diff.trim_start(l)\n    + join(\n      ss.map(\n        s -> \"\\u{1}\" + diff.trim_start(byte_slice(l, s.0, s.1)),\n      ),\n      \"\",\n    )\n  ka := [key(l, get(sa, i) ?? []) for (i, l) in enumerate(la)]\n  kb := [key(l, get(sb, i) ?? []) for (i, l) in enumerate(lb)]\n  ops := diff.lcs(ka, kb)\n  changed := len(ops.filter(x -> x.0 != 0))\n  total := len(la) + len(lb)\n  rewritten := total > 8 && changed * 10 >= total * 6\n  kinds := cs.map(c -> c.kind)\n  mut out := []\n  mut k := 0\n  while k < len(ops) {\n    (op, _, j) := get(ops, k) ?? (0, 0, 0)\n    if op == 0 {\n      mut out.push(diff.Line { s: \" \", text: get(lb, j) ?? \"\" })\n      k += 1\n      continue\n    }\n    mut dels := []\n    mut ins := []\n    while k < len(ops) && (get(ops, k) ?? (0, 0, 0)).0 != 0 {\n      (x, a, b) := get(ops, k) ?? (0, 0, 0)\n      if x == 1 {\n        mut dels.push(a)\n      } else {\n        mut ins.push(b)\n      }\n      k += 1\n    }\n    line_a := (i: Int) -> get(la, i) ?? \"\"\n    line_b := (i: Int) -> get(lb, i) ?? \"\"\n    moved_only := (ss: List[(Int, Int, Int)]) ->\n      ss != [] && ss.all(s -> get(kinds, s.2) == Some(\"moved\"))\n    if rewritten {\n      out = out\n        + dels.map(d -> diff.Line { s: \"-\", text: line_a(d) })\n        + ins.map(i -> diff.Line { s: \"+\", text: line_b(i) })\n      continue\n    }\n    mut next := 0\n    for d in dels {\n      ds := get(sa, d) ?? []\n      changes_a := set(\n        ds.map(s -> s.2).filter(c -> get(kinds, c) != Some(\"moved\")),\n      )\n      mut found := -1\n      mut j2 := next\n      // a similar line holding one of its changes, or with no change on\n      // either (a line only the text tells apart)\n      while j2 < len(ins) && found < 0 {\n        bs := get(sb, get(ins, j2) ?? 0) ?? []\n        if (bs.any(s -> contains(changes_a, s.2))\n            || ds == [] && bs == [])\n          && diff.close(line_a(d), line_b(get(ins, j2) ?? 0)) {\n          found = j2\n        }\n        j2 += 1\n      }\n      if found >= 0 {\n        out += slice(ins, next, found).map(\n          i -> diff.Line {\n            s: \"+\",\n            text: line_b(i),\n            note: if moved_only(get(sb, i) ?? []) {\n              \"moved\"\n            } else {\n              \"\"\n            },\n          },\n        )\n        y := get(ins, found) ?? 0\n        segs := diff.line_segs(line_a(d), ds, line_b(y), get(sb, y) ?? [])\n        mut out.push(\n          if segs.all(s -> s.k == \"=\") {\n            diff.Line { s: \" \", text: line_b(y) }\n          } else {\n            diff.Line { s: \"~\", text: line_b(y), segs }\n          },\n        )\n        next = found + 1\n      } else {\n        mut out.push(\n          diff.Line {\n            s: \"-\",\n            text: line_a(d),\n            note: if moved_only(ds) {\n              \"moved\"\n            } else {\n              \"\"\n            },\n          },\n        )\n      }\n    }\n    out += slice(ins, next, len(ins)).map(\n      i -> diff.Line {\n        s: \"+\",\n        text: line_b(i),\n        note: if moved_only(get(sb, i) ?? []) {\n          \"moved\"\n        } else {\n          \"\"\n        },\n      },\n    )\n  }\n  Some((out, rewritten))\n}","old_text":"/// The lines of a change from `o` to `n`, from the nodes that changed\n/// (`cs`, `tree.changes`): each side is printed with its changed nodes\n/// placed. Lines are lined up by their text, without indentation, and by\n/// the changed nodes on them, so a line holding a changed node never\n/// counts as unchanged. A removed and an added line holding the same\n/// change are one line changed in place: the text around the nodes kept,\n/// each node's old and new text compared word by word (`line_segs`).\n/// Other removed and added lines are paired when they are similar, as\n/// `line_diff` does. The `Bool` is true when most lines changed; then\n/// nothing is paired. `None` when a side doesn't print with its nodes\n/// placed as it prints alone.\nfn node_lines(\n  o: ast.Decl,\n  n: ast.Decl,\n  cs: List[tree.Change],\n) -> Option[(List[diff.Line], Bool)] {\n  olds := [(c.old, k) for (k, c) in enumerate(cs) where c.kind != \"added\" && c.old != \"\"]\n  news := [(c.new, k) for (k, c) in enumerate(cs) where c.kind != \"removed\" && c.new != \"\"]\n  (la, sa) := diff.placed_code(o, olds)?\n  (lb, sb) := diff.placed_code(n, news)?\n  key := (l: String, ss: List[(Int, Int, Int)]) -> diff.trim_start(l)\n    + join(\n      ss.map(\n        s -> \"\\u{1}\" + diff.trim_start(byte_slice(l, s.0, s.1)),\n      ),\n      \"\",\n    )\n  ka := [key(l, get(sa, i) ?? []) for (i, l) in enumerate(la)]\n  kb := [key(l, get(sb, i) ?? []) for (i, l) in enumerate(lb)]\n  ops := diff.lcs(ka, kb)\n  changed := len(ops.filter(x -> x.0 != 0))\n  total := len(la) + len(lb)\n  rewritten := total > 8 && changed * 10 >= total * 6\n  kinds := cs.map(c -> c.kind)\n  mut out := []\n  mut k := 0\n  while k < len(ops) {\n    (op, _, j) := get(ops, k) ?? (0, 0, 0)\n    if op == 0 {\n      mut out.push(diff.Line { s: \" \", text: get(lb, j) ?? \"\" })\n      k += 1\n      continue\n    }\n    mut dels := []\n    mut ins := []\n    while k < len(ops) && (get(ops, k) ?? (0, 0, 0)).0 != 0 {\n      (x, a, b) := get(ops, k) ?? (0, 0, 0)\n      if x == 1 {\n        mut dels.push(a)\n      } else {\n        mut ins.push(b)\n      }\n      k += 1\n    }\n    line_a := (i: Int) -> get(la, i) ?? \"\"\n    line_b := (i: Int) -> get(lb, i) ?? \"\"\n    moved_only := (ss: List[(Int, Int, Int)]) ->\n      ss != [] && ss.all(s -> get(kinds, s.2) == Some(\"moved\"))\n    if rewritten {\n      out = out\n        + dels.map(d -> diff.Line { s: \"-\", text: line_a(d) })\n        + ins.map(i -> diff.Line { s: \"+\", text: line_b(i) })\n      continue\n    }\n    mut next := 0\n    for d in dels {\n      ds := get(sa, d) ?? []\n      changes_a := set(\n        ds.map(s -> s.2).filter(c -> get(kinds, c) != Some(\"moved\")),\n      )\n      mut found := -1\n      mut j2 := next\n      // first a line holding one of its changes, then a similar one\n      while j2 < len(ins) && found < 0 {\n        bs := get(sb, get(ins, j2) ?? 0) ?? []\n        if bs.any(s -> contains(changes_a, s.2)) {\n          found = j2\n        }\n        j2 += 1\n      }\n      j2 = next\n      while j2 < len(ins) && found < 0 {\n        bs := get(sb, get(ins, j2) ?? 0) ?? []\n        if ds == []\n          && bs == []\n          && diff.close(line_a(d), line_b(get(ins, j2) ?? 0)) {\n          found = j2\n        }\n        j2 += 1\n      }\n      if found >= 0 {\n        out += slice(ins, next, found).map(\n          i -> diff.Line {\n            s: \"+\",\n            text: line_b(i),\n            note: if moved_only(get(sb, i) ?? []) {\n              \"moved\"\n            } else {\n              \"\"\n            },\n          },\n        )\n        y := get(ins, found) ?? 0\n        segs := diff.line_segs(line_a(d), ds, line_b(y), get(sb, y) ?? [])\n        mut out.push(\n          if segs.all(s -> s.k == \"=\") {\n            diff.Line { s: \" \", text: line_b(y) }\n          } else {\n            diff.Line { s: \"~\", text: line_b(y), segs }\n          },\n        )\n        next = found + 1\n      } else {\n        mut out.push(\n          diff.Line {\n            s: \"-\",\n            text: line_a(d),\n            note: if moved_only(ds) {\n              \"moved\"\n            } else {\n              \"\"\n            },\n          },\n        )\n      }\n    }\n    out += slice(ins, next, len(ins)).map(\n      i -> diff.Line {\n        s: \"+\",\n        text: line_b(i),\n        note: if moved_only(get(sb, i) ?? []) {\n          \"moved\"\n        } else {\n          \"\"\n        },\n      },\n    )\n  }\n  Some((out, rewritten))\n}"}]}
{"id":"780a7c75aef902da","time":1795724421,"message":"edit","changes":[{"name":"diff.node_lines","kind":"fn","old":"9bfaa91c1078fd23","new":"74a0506cea925847","interface_changed":false,"affected":[],"module":"diff","text":"/// The lines of a change from `o` to `n`, from the nodes that changed\n/// (`cs`, `tree.changes`): each side is printed with its changed nodes\n/// placed. Lines are lined up by their text, without indentation, and by\n/// the changed nodes on them, so a line holding a changed node never\n/// counts as unchanged. A removed and an added line that are similar (as\n/// `line_diff` pairs them), first those holding the same change, are one\n/// line changed in place: the text around the nodes kept, each\n/// node's old and new text compared word by word (`line_segs`). The `Bool` is\n/// true when most lines changed; then\n/// nothing is paired. `None` when a side doesn't print with its nodes\n/// placed as it prints alone.\nfn node_lines(\n  o: ast.Decl,\n  n: ast.Decl,\n  cs: List[tree.Change],\n) -> Option[(List[diff.Line], Bool)] {\n  olds := [(c.old, k) for (k, c) in enumerate(cs) where c.kind != \"added\" && c.old != \"\"]\n  news := [(c.new, k) for (k, c) in enumerate(cs) where c.kind != \"removed\" && c.new != \"\"]\n  (la, sa) := diff.placed_code(o, olds)?\n  (lb, sb) := diff.placed_code(n, news)?\n  key := (l: String, ss: List[(Int, Int, Int)]) -> diff.trim_start(l)\n    + join(\n      ss.map(\n        s -> \"\\u{1}\" + diff.trim_start(byte_slice(l, s.0, s.1)),\n      ),\n      \"\",\n    )\n  ka := [key(l, get(sa, i) ?? []) for (i, l) in enumerate(la)]\n  kb := [key(l, get(sb, i) ?? []) for (i, l) in enumerate(lb)]\n  ops := diff.lcs(ka, kb)\n  changed := len(ops.filter(x -> x.0 != 0))\n  total := len(la) + len(lb)\n  rewritten := total > 8 && changed * 10 >= total * 6\n  kinds := cs.map(c -> c.kind)\n  mut out := []\n  mut k := 0\n  while k < len(ops) {\n    (op, _, j) := get(ops, k) ?? (0, 0, 0)\n    if op == 0 {\n      mut out.push(diff.Line { s: \" \", text: get(lb, j) ?? \"\" })\n      k += 1\n      continue\n    }\n    mut dels := []\n    mut ins := []\n    while k < len(ops) && (get(ops, k) ?? (0, 0, 0)).0 != 0 {\n      (x, a, b) := get(ops, k) ?? (0, 0, 0)\n      if x == 1 {\n        mut dels.push(a)\n      } else {\n        mut ins.push(b)\n      }\n      k += 1\n    }\n    line_a := (i: Int) -> get(la, i) ?? \"\"\n    line_b := (i: Int) -> get(lb, i) ?? \"\"\n    moved_only := (ss: List[(Int, Int, Int)]) ->\n      ss != [] && ss.all(s -> get(kinds, s.2) == Some(\"moved\"))\n    if rewritten {\n      out = out\n        + dels.map(d -> diff.Line { s: \"-\", text: line_a(d) })\n        + ins.map(i -> diff.Line { s: \"+\", text: line_b(i) })\n      continue\n    }\n    mut next := 0\n    for d in dels {\n      ds := get(sa, d) ?? []\n      changes_a := set(\n        ds.map(s -> s.2).filter(c -> get(kinds, c) != Some(\"moved\")),\n      )\n      mut found := -1\n      mut j2 := next\n      // a similar line holding one of its changes, else any similar line\n      while j2 < len(ins) && found < 0 {\n        bs := get(sb, get(ins, j2) ?? 0) ?? []\n        if bs.any(s -> contains(changes_a, s.2))\n          && diff.close(line_a(d), line_b(get(ins, j2) ?? 0)) {\n          found = j2\n        }\n        j2 += 1\n      }\n      j2 = next\n      while j2 < len(ins) && found < 0 {\n        if diff.close(line_a(d), line_b(get(ins, j2) ?? 0)) {\n          found = j2\n        }\n        j2 += 1\n      }\n      if found >= 0 {\n        out += slice(ins, next, found).map(\n          i -> diff.Line {\n            s: \"+\",\n            text: line_b(i),\n            note: if moved_only(get(sb, i) ?? []) {\n              \"moved\"\n            } else {\n              \"\"\n            },\n          },\n        )\n        y := get(ins, found) ?? 0\n        segs := diff.line_segs(line_a(d), ds, line_b(y), get(sb, y) ?? [])\n        mut out.push(\n          if segs.all(s -> s.k == \"=\") {\n            diff.Line { s: \" \", text: line_b(y) }\n          } else {\n            diff.Line { s: \"~\", text: line_b(y), segs }\n          },\n        )\n        next = found + 1\n      } else {\n        mut out.push(\n          diff.Line {\n            s: \"-\",\n            text: line_a(d),\n            note: if moved_only(ds) {\n              \"moved\"\n            } else {\n              \"\"\n            },\n          },\n        )\n      }\n    }\n    out += slice(ins, next, len(ins)).map(\n      i -> diff.Line {\n        s: \"+\",\n        text: line_b(i),\n        note: if moved_only(get(sb, i) ?? []) {\n          \"moved\"\n        } else {\n          \"\"\n        },\n      },\n    )\n  }\n  Some((out, rewritten))\n}","old_text":"/// The lines of a change from `o` to `n`, from the nodes that changed\n/// (`cs`, `tree.changes`): each side is printed with its changed nodes\n/// placed. Lines are lined up by their text, without indentation, and by\n/// the changed nodes on them, so a line holding a changed node never\n/// counts as unchanged. A removed and an added line that are similar (as\n/// `line_diff` pairs them) and hold the same change, or no change at all,\n/// are one line changed in place: the text around the nodes kept, each\n/// node's old and new text compared word by word (`line_segs`). The `Bool` is\n/// true when most lines changed; then\n/// nothing is paired. `None` when a side doesn't print with its nodes\n/// placed as it prints alone.\nfn node_lines(\n  o: ast.Decl,\n  n: ast.Decl,\n  cs: List[tree.Change],\n) -> Option[(List[diff.Line], Bool)] {\n  olds := [(c.old, k) for (k, c) in enumerate(cs) where c.kind != \"added\" && c.old != \"\"]\n  news := [(c.new, k) for (k, c) in enumerate(cs) where c.kind != \"removed\" && c.new != \"\"]\n  (la, sa) := diff.placed_code(o, olds)?\n  (lb, sb) := diff.placed_code(n, news)?\n  key := (l: String, ss: List[(Int, Int, Int)]) -> diff.trim_start(l)\n    + join(\n      ss.map(\n        s -> \"\\u{1}\" + diff.trim_start(byte_slice(l, s.0, s.1)),\n      ),\n      \"\",\n    )\n  ka := [key(l, get(sa, i) ?? []) for (i, l) in enumerate(la)]\n  kb := [key(l, get(sb, i) ?? []) for (i, l) in enumerate(lb)]\n  ops := diff.lcs(ka, kb)\n  changed := len(ops.filter(x -> x.0 != 0))\n  total := len(la) + len(lb)\n  rewritten := total > 8 && changed * 10 >= total * 6\n  kinds := cs.map(c -> c.kind)\n  mut out := []\n  mut k := 0\n  while k < len(ops) {\n    (op, _, j) := get(ops, k) ?? (0, 0, 0)\n    if op == 0 {\n      mut out.push(diff.Line { s: \" \", text: get(lb, j) ?? \"\" })\n      k += 1\n      continue\n    }\n    mut dels := []\n    mut ins := []\n    while k < len(ops) && (get(ops, k) ?? (0, 0, 0)).0 != 0 {\n      (x, a, b) := get(ops, k) ?? (0, 0, 0)\n      if x == 1 {\n        mut dels.push(a)\n      } else {\n        mut ins.push(b)\n      }\n      k += 1\n    }\n    line_a := (i: Int) -> get(la, i) ?? \"\"\n    line_b := (i: Int) -> get(lb, i) ?? \"\"\n    moved_only := (ss: List[(Int, Int, Int)]) ->\n      ss != [] && ss.all(s -> get(kinds, s.2) == Some(\"moved\"))\n    if rewritten {\n      out = out\n        + dels.map(d -> diff.Line { s: \"-\", text: line_a(d) })\n        + ins.map(i -> diff.Line { s: \"+\", text: line_b(i) })\n      continue\n    }\n    mut next := 0\n    for d in dels {\n      ds := get(sa, d) ?? []\n      changes_a := set(\n        ds.map(s -> s.2).filter(c -> get(kinds, c) != Some(\"moved\")),\n      )\n      mut found := -1\n      mut j2 := next\n      // a similar line holding one of its changes, or with no change on\n      // either (a line only the text tells apart)\n      while j2 < len(ins) && found < 0 {\n        bs := get(sb, get(ins, j2) ?? 0) ?? []\n        if (bs.any(s -> contains(changes_a, s.2))\n            || ds == [] && bs == [])\n          && diff.close(line_a(d), line_b(get(ins, j2) ?? 0)) {\n          found = j2\n        }\n        j2 += 1\n      }\n      if found >= 0 {\n        out += slice(ins, next, found).map(\n          i -> diff.Line {\n            s: \"+\",\n            text: line_b(i),\n            note: if moved_only(get(sb, i) ?? []) {\n              \"moved\"\n            } else {\n              \"\"\n            },\n          },\n        )\n        y := get(ins, found) ?? 0\n        segs := diff.line_segs(line_a(d), ds, line_b(y), get(sb, y) ?? [])\n        mut out.push(\n          if segs.all(s -> s.k == \"=\") {\n            diff.Line { s: \" \", text: line_b(y) }\n          } else {\n            diff.Line { s: \"~\", text: line_b(y), segs }\n          },\n        )\n        next = found + 1\n      } else {\n        mut out.push(\n          diff.Line {\n            s: \"-\",\n            text: line_a(d),\n            note: if moved_only(ds) {\n              \"moved\"\n            } else {\n              \"\"\n            },\n          },\n        )\n      }\n    }\n    out += slice(ins, next, len(ins)).map(\n      i -> diff.Line {\n        s: \"+\",\n        text: line_b(i),\n        note: if moved_only(get(sb, i) ?? []) {\n          \"moved\"\n        } else {\n          \"\"\n        },\n      },\n    )\n  }\n  Some((out, rewritten))\n}"}]}
