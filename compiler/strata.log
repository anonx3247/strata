dict pairs.\nfn table_fns(mut g: codegen.Gen, t: check.Ty) -> List[codegen.V] {\n  (kt, dict) := match t {\n    check.TNamed { name: \"Dict\", args: [k, _] } => (k, \"1\"),\n    check.TNamed { name: \"Set\", args: [a] } => (a, \"0\"),\n    _ => (check.TAny, \"0\"),\n  }\n  [codegen.V {\n    ty: check.TStr,\n    op: codegen.slot_fn(mut g, \"hash\", kt),\n  }, codegen.V {\n    ty: check.TStr,\n    op: codegen.slot_fn(mut g, \"cmp\", kt),\n  }, codegen.V { ty: check.TInt, op: dict }]\n}","old_text":"/// What runtime.c searches a table of type `t` with: its keys' hash and\n/// order on slots (`slot_fn`), and whether its entries are dict pairs.\nfn table_fns(mut g: codegen.Gen, t: Ty) -> List[codegen.V] {\n  (kt, dict) := match t {\n    TNamed { name: \"Dict\", args: [k, _] } => (k, \"1\"),\n    TNamed { name: \"Set\", args: [a] } => (a, \"0\"),\n    _ => (TAny, \"0\"),\n  }\n  [\n    codegen.V { ty: TStr, op: codegen.slot_fn(mut g, \"hash\", kt) },\n    codegen.V { ty: TStr, op: codegen.slot_fn(mut g, \"cmp\", kt) },\n    codegen.V { ty: TInt, op: dict },\n  ]\n}"},{"name":"codegen.slot_fn","kind":"fn","old":"073af57d28533f5b","new":"3382f714d44e6f33","interface_changed":true,"affected":["codegen.equal","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.apply","codegen.eq_fields","codegen.matches","codegen.eq_list","codegen.dyn_wrapper","codegen.union_eq","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.collection_builtin","codegen.update_in_place","codegen.table_from","codegen.hash_fields","codegen.binary","codegen.number_builtin","codegen.checked","codegen.eq_body","codegen.destructure","codegen.binds","codegen.for_loop","codegen.matching_v","codegen.match_got","codegen.helper","codegen.vtable","codegen.builtin_call","codegen.builtin","codegen.gen_list","codegen.converted","codegen.stmt_node","codegen.expr_node","codegen.assertion","codegen.invariants","codegen.matching_want","codegen.show","codege