=> t,\n    },\n    _ => t,\n  }\n}"},{"name":"codegen.copy_out","kind":"fn","old":"89678f25a9a98cdb","new":"f25d41af219e82eb","interface_changed":false,"affected":[],"module":"codegen","text":"/// `v` out of arena `d` (already left): held, with what the arena made in\n/// it copied.\nfn copy_out(mut g: codegen.Gen, v: codegen.V, d: String) -> codegen.V {\n  if !codegen.counted(v.ty) || codegen.constant(v.op) {\n    return v\n  }\n  if codegen.is_collection(v.ty) {\n    c := codegen.copy_out(\n      mut g,\n      codegen.V { ..v, ty: codegen.repr(v.ty) },\n      d,\n    )\n    return codegen.V { ..c, ty: v.ty }\n  }\n  r := codegen.fresh(mut g, \"out\")\n  match v.ty {\n    check.TStr => {\n      codegen.use_rt(mut g, \"strata_arena_copy\")\n      codegen.emit(\n        mut g,\n        f\"{r} = call ptr @strata_arena_copy(ptr {v.op}, ptr {d})\",\n      )\n    },\n    check.TInt => {\n      codegen.use_rt(mut g, \"strata_arena_int\")\n      codegen.emit(\n        mut g,\n        f\"{r} = call i64 @strata_arena_int(i64 {v.op}, ptr {d})\",\n      )\n    },\n    check.TNamed { name: \"Task\", .. } | check.TNamed { name: \"Sender\", .. } | check.TNamed { name: \"Receiver\", .. } => {\n      codegen.not_yet(\n        mut g,\n        f\"a `{codegen.key(v.ty)}` leaving an arena\",\n      )\n      return v\n    },\n    check.TList(_) | check.TNamed { .. } | check.TUnion(_) => {\n      h := codegen.copy_fn(mut g, v.ty)\n      codegen.emit(\n        mut g,\n        f\"{r} = call ptr {h}(ptr {v.op}, ptr {d})\",\n      )\n    },\n    _ => {\n      codegen.not_yet(\n        mut g,\n        f\"a `{codegen.key(v.ty)}` leaving an arena (a function or trait value)\",\n      )\n      return v\n    },\n  }\n  codegen.V { ty: v.ty, op: r }\n}","old_text":"/// `v` out of arena `d` (already left): held, with what the arena made in\n/// it copied.\nfn copy_out(mut g: codegen.Gen, v: codegen.V, d: String) -> codegen.V {\n  if !codegen.counted(v.ty) || codegen.constant(v.op) {\n    return v\n  }\n  if codegen.is_collection(v.ty) {\n    c := codegen.copy_out(\n      mut g,\n      codegen.V { ..v, ty: codegen.repr(v.ty) },\n      d,\n    )\n    return codegen.V { ..c, ty: v.ty }\n  }\n  r := codegen.fresh(mut g, \"out\")\n  match v.ty {\n    TStr => {\n      codegen.use_rt(mut g, \"strata_arena_copy\")\n      codegen.emit(\n        mut g,\n        f\"{r} = call ptr @strata_arena_copy(ptr {v.op}, ptr {d})\",\n      )\n    },\n    TInt => {\n      codegen.use_rt(mut g, \"strata_arena_int\")\n      codegen.emit(\n        mut g,\n        f\"{r} = call i64 @strata_arena_int(i64 {v.op}, ptr {d})\",\n      )\n    },\n    TNamed { name: \"Task\", .. } | TNamed { name: \"Sender\", .. } | TNamed { name: \"Receiver\", .. } => {\n      codegen.not_yet(\n        mut g,\n        f\"a `{codegen.key(v.ty)}` leaving an arena\",\n      )\n      return v\n    },\n    TList(_) | TNamed { .. } | TUnion(_) => {\n      h := codegen.copy_fn(mut g, v.ty)\n      codegen.emit(\n        mut g,\n        f\"{r} = call ptr {h}(ptr {v.op}, ptr {d})\",\n      )\n    },\n    _ => {\n      codegen.not_yet(\n        mut g,\n        f\"a `{codegen.key(v.ty)}` leaving an arena (a function or trait value)\",\n      )\n      return v\n    },\n  }\n  codegen.V { ty: v.ty, op: r }\n}"},{"name":"codegen.copy_fn","kind":"fn","old":"54c39f4561a5ddac","new":"4890080493b14c90","interface_changed":true,"affected":["codegen.copy_out","codegen.arena_run","codegen.copy_fields","codegen.call_fn_want","codegen.copy_held","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.expr_node","codegen.expr_want_node","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.builtin_call","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.main_arg","codegen.select_expr","codegen.expr","codegen.expr_want