,"std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","live_edit_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","tour_graph","linked","expanded","comptime_runner","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","diff_command","tour_command","with_base","eval.run","rename_command","move_command","fix_command","edit_in_editor","eval_files"],"module":"codegen","text":"type Gen = {\n  // module-wide\n  strings: Dict[String, String],\n  globals: List[String],\n  used: Set[String],\n  fns: Dict[String, ast.FnDecl],\n  errs: List[String],\n  // the checker's records and sums, each constructor's tag, the types with\n  // constructors, the fields' defaults\n  types: check.Types,\n  tags: Dict[String, Int],\n  data: Set[String],\n  defaults: Dict[String, ast.Expr],\n  // traits, and `impl`s with their type's head\n  traits: Dict[String, ast.TraitDecl],\n  impls: List[codegen.ImplEntry],\n  // helper functions made (`@\"eq:T\"`, `@\"debug:T\"`, `@\"drop:T\"`) and their\n  // text\n  helpers: Set[String],\n  helper_defs: List[String],\n  // each boxed union member's tag, and each union's name, by type key\n  box_tags: Dict[String, Int],\n  union_names: Dict[String, String],\n  // aliases with type parameters (`type Many[T] = List[T] | Problem`):\n  // their parameters and body\n  generic_aliases: Dict[String, (List[String], ast.TypeExpr)],\n  // refined types (core's `Natural` too): base and predicate. Then the\n  // `distinct` types, each field's written type (`C.f`), and each typed\n  // variable's declared type by slot.\n  refines: Dict[String, (ast.TypeExpr, ast.Expr)],\n  // a generic refined type's parameters (`NonEmpty[T]`'s `T`)\n  refine_params: Dict[String, List[String]],\n  distincts: Set[String],\n  field_types: Dict[String, ast.TypeExpr],\n  // each variant's declaration index in its sum (generators pick by it)\n  variant_index: Dict[String, Int],\n  declared: Dict[String, ast.TypeExpr],\n  // function instances asked for (by symbol), those left to compile (name,\n  // type arguments), and the count of lambdas made\n  instances: Set[String],\n  queue: List[(String, Dict[String, check.Ty])],\n  lambdas: Int,\n  // per function\n  fname: String,\n  // its type arguments, and whether it is in the prelude\n  sub: Dict[String, check.Ty],\n  in_prelude: Bool,\n  lines: List[String],\n  allocas: List[String],\n  next: Int,\n  scopes: List[codegen.Scope],\n  // each loop: the `continue` and `break` labels, and the scope depth\n  // outside it\n  loops: List[(String, String, Int)],\n  ret: check.Ty,\n  // each exit's result and the block it leaves from: the exit `phi`\n  rets: List[(String, String)] = [],\n  // depth of `|` alternatives being bound: their names go in slots, which\n  // each alternative stores to\n  alts: Int = 0,\n  // a match arm's names are bound borrowed: the matched value outlives the\n  // arm unchanged\n  borrowing: Bool = false,\n  // the slot whose value leaves the function: scope drops skip it\n  // (`leave_with`)\n  moved: String = \"\",\n  // cancellation unwind blocks by scope depth: the signature of what the\n  // scopes up to it hold, and the block that drops it and falls through to\n  // the ones below. Cancel points with the same signature share a block.\n  unwind_chain: List[(String, String)] = [],\n  // what `verify` proved (`strata build --strata`), by function\n  // (`proofs_of`), and the function whose proofs apply (\"\" in helpers and\n  // lambdas). Proven checks are not emitted.\n  proofs: Dict[String, List[(String, String)]],\n  proving: String,\n  // `tasks`: the program starts tasks. `supervises`: it supervises one, so\n  // a wait, a call or a fault may leave a function (`cancel_point`).\n  // `can_unwind`: the current body may leave so. `unwinds`: it does, through\n  // its `unwound` exit.\n  tasks: Bool,\n  supervises: Bool,\n  can_unwind: Bool,\n  unwinds: Bool,\n  // `extern c` functions (by key) and types (`Counter`)\n  externs: Set[String],\n  handles: Set[String],\n  // core's `builtin static` blocks (core.rt's state) and their sizes\n  statics: Dict[String, Int],\n  // compiling core.rt (`bare`): no call-stack frames and no cancel points,\n  // since the allocator runs inside every allocation\n  bare: Bool,\n  // generators made (`gen_fn`), by type and hints\n  gens: Dict[String, String],\n  // compiling fuzz drivers: functions and loops count steps\n  fuzzing: Bool,\n  // fuzz drivers hand their arguments over as code (`strata_fuzz_arg`, for\n  // `verify`) instead of keeping them (`strata_fuzz_keep`)\n  fuzz_text: Bool,\n  // `--trace`: each call and return of the program's functions printed on\n  // stderr (`strata_trace_enter`, `strata_trace_leave`)\n  tracing: Bool,\n  // std functions taken from the precompiled library: declared, not\n  // compiled\n  precompiled: Set[String],\n  // compiling std's precompiled library (`codegen --library`): whatever\n  // depends on the codebase is left out\n  library_mode: Bool,\n  // `ret_w`: the function's result type as written, refined names kept\n  // (`List[Port]` where `ret` is `List[Int]`). `pending_w`: the written type\n  // arguments for the next call's type parameters (`T.from_json(…)` with\n  // `T` a `List[Port]`). They decide what `T.check(v)` checks in an\n  // instance (its sub's `$w:T`).\n  ret_w: check.Ty = check.TAny,\n  pending_w: Dict[String, check.Ty] = Dict[String, check.Ty] {},\n  // the function being compiled (its key), the callers of each function\n  // (by key), and the functions with something not compiled: std's\n  // library leaves these out\n  current: String,\n  callers: Dict[String, Set[String]],\n  failed: Set[String],\n  // `not_yet`'s errors for each of those, for verify's fuzz drivers to\n  // report\n  why: Dict[String, List[String]],\n  // parameters typed by a bounded type parameter (`x: T` with `T: Log`, or\n  // a trait's type compiled for a known type in `for_impls`), by slot, with\n  // their bounds. Their methods resolve to the bounds' methods, ahead of\n  // the type's own methods of the same name.\n  bound_slots: Dict[String, List[String]],\n  // checks of the program's own functions left out as proven, and those\n  // kept (`strata build` reports both)\n  left_out: Int,\n  kept: Int,\n  // `keeps`: which parameters each function may keep (`kept_by`), built on\n  // first use. `stack_next`: the constructor about to be compiled goes on the\n  // stack (a `let` whose value does not outlive its variable), and\n  // `stack_made` holds its field types.\n  keeps: Option[Dict[String, List[Bool]]],\n  stack_next: Bool,\n  stack_made: List[check.Ty],\n  // capabilities: field-less records shown by name alone (`Terminal`)\n  caps: Set[String] = Set[String] {},\n  // compiling one function alone on a worker (`compiled_alone`): its name\n  // prefixes the lambdas, tables and generators it makes (`lambdas` counts\n  // them). Its additions to the shared tables are kept apart, since workers\n  // only read those, and `merge_alone` adds them in order.\n  owner: String = \"\",\n  new_strings: Dict[String, String] = Dict[String, String] {},\n  new_helpers: Set[String] = Set[String] {},\n  // a list so that `merge_alone` can pair it with the queue in request\n  // order\n  new_instances: List[String] = [],\n  new_callers: List[(String, String)] = [],\n  new_failed: List[String] = [],\n  new_why: List[(String, String)] = [],\n  new_used: Set[String] = Set[String] {},\n  new_gens: Dict[String, String] = Dict[String, String] {},\n  new_unions: Dict[String, String] = Dict[String, String] {},\n  new_fns: Dict[String, ast.FnDecl] = Dict[String, ast.FnDecl] {},\n  // the calls after which a cancelled task may leave (`waits_of`): the call\n  // nodes that may reach a wait, and the functions and method names seen\n  // (`calls_wait`). `None` means every call (a supervising program, std's\n  // library).\n  waiting: Option[Set[String]] = None,\n  waits_known: Set[String] = Set[String] {},\n  // `--copies`: each copy made to change a value is reported\n  // (`strata_copied`) with its location. `sites` maps function and\n  // expression text to locations (`finding.copy_sites`), and `at` is the\n  // statement being compiled. `in_update`: compiling the copy an update\n  // falls back to, which reports it itself.\n  copies: Bool = false,\n  sites: Dict[String, String] = Dict[String, String] {},\n  // `--memory-sites`: each statement marked in the IR (`site_marker`) and\n  // each counting operation numbered and counted (`counted_sites`)\n  memory_sites: Bool = false,\n  // `--memory-sites`: the verdicts of `compiler/roots`, by function and\n  // expression text or variable (`roots.verdicts`); the codes of the\n  // expressions being compiled, innermost last; and the code of each\n  // temporary, by operand\n  roots: Dict[String, Int] = Dict[String, Int] {},\n  root_codes: List[Int] = [],\n  temp_codes: Dict[String, Int] = Dict[String, Int] {},\n  // (the hash of the statement being compiled, `roots.text_key`, and of\n  // the one each variable's slot was made in)\n  root_stmt: Int = 0,\n  slot_stmts: Dict[String, Int] = Dict[String, Int] {},\n  // (how many times each expression's key was looked up, `root_code`)\n  root_seen: Dict[String, Int] = Dict[String, Int] {},\n  at: ast.Expr = ast.UnitExpr,\n  in_update: Bool = false,\n  // the assignment being compiled already checked the elements it adds\n  // against the place's type (`checked_update`), so the whole value is not\n  // checked again\n  elements_checked: Bool = false,\n  // the expression being compiled, and the function's name as `strata\n  // check` shows it (`test \"NAME\"` for a test), for `not_yet`\n  here: ast.Expr = ast.UnitExpr,\n  shown_as: String = \"\",\n  // the `old e`s read by `ensures`: `e` as text, the name its entry value\n  // is held under, and that value\n  olds: List[(String, String, codegen.V)] = [],\n  // the updates in place proven to find their value held once\n  // (`unique.proven`), by site key. While a statement is compiled,\n  // `proven_root` is the variable its proven update changes (else \"\"), and\n  // `proven_put` the place a proven `mut p.m(…)` is about to assign.\n  proven: Set[String] = Set[String] {},\n  proven_root: String = \"\",\n  proven_put: String = \"\",\n  // small values (`small_words`): whether the function being compiled gives\n  // its result as words (`by_words`); whether the expression about to be\n  // compiled is in result position (its value is the result), and whether\n  // the call about to be compiled may leave its result on the stack (its\n  // value doesn't outlive the statement or the variable bound to it); the\n  // values in result position with the pointer each gives its caller\n  // (`result_words`: \"null\" for a block on the stack, whose words are\n  // given instead), and every block on the stack holding a small value,\n  // whose end drops its fields (`drop_stacked`)\n  by_words: Bool = false,\n  result_pos: Bool = false,\n  stack_call: Bool = false,\n  // whether the call about to be compiled is assigned to a `mut` variable\n  // (`assign_held`: its words may go into the variable's own block)\n  held_call: Bool = false,\n  rp_ptrs: Dict[String, String] = Dict[String, String] {},\n  stack_ops: Set[String] = Set[String] {},\n  // `--regions`: values that die in the statement that makes them go in\n  // the statement's region (`roots.scoped`: the sites and statements, by\n  // function and text). `region_stmt` is the hash of the statement being\n  // compiled when it took a mark (`region_open`), else -1.\n  regions: Bool = false,\n  region_sites: Set[String] = Set[String] {},\n  region_stmt: Int = -1,\n  // `--live` (`strata run --live`): nothing is taken from what the\n  // program's other functions do, since a frame running old code may call\n  // new code and the reverse. Every parameter may be kept (no argument on\n  // the stack), no update in place is proven (`unique`), no region, and an\n  // entry check stays even when every call proved it.\n  live: Bool = false,\n}","old_text":"type Gen = {\n  // module-wide\n  strings: Dict[String, String],\n  globals: List[String],\n  used: Set[String],\n  fns: Dict[String, ast.FnDecl],\n  errs: List[String],\n  // the checker's records and sums, each constructor's tag, the types with\n  // constructors, the fields' defaults\n  types: check.Types,\n  tags: Dict[String, Int],\n  data: Set[String],\n  defaults: Dict[String, ast.Expr],\n  // traits, and `impl`s with their type's head\n  traits: Dict[String, ast.TraitDecl],\n  impls: List[codegen.ImplEntry],\n  // helper functions made (`@\"eq:T\"`, `@\"debug:T\"`, `@\"drop:T\"`) and their\n  // text\n  helpers: Set[String],\n  helper_defs: List[String],\n  // each boxed union member's tag, and each union's name, by type key\n  box_tags: Dict[String, Int],\n  union_names: Dict[String, String],\n  // aliases with type parameters (`type Many[T] = List[T] | Problem`):\n  // their parameters and body\n  generic_aliases: Dict[String, (List[String], ast.TypeExpr)],\n  // refined types (core's `Natural` too): base and predicate. Then the\n  // `distinct` types, each field's written type (`C.f`), and each typed\n  // variable's declared type by slot.\n  refines: Dict[String, (ast.TypeExpr, ast.Expr)],\n  // a generic refined type's parameters (`NonEmpty[T]`'s `T`)\n  refine_params: Dict[String, List[String]],\n  distincts: Set[String],\n  field_types: Dict[String, ast.TypeExpr],\n  // each variant's declaration index in its sum (generators pick by it)\n  variant_index: Dict[String, Int],\n  declared: Dict[String, ast.TypeExpr],\n  // function instances asked for (by symbol), those left to compile (name,\n  // type arguments), and the count of lambdas made\n  instances: Set[String],\n  queue: List[(String, Dict[String, check.Ty])],\n  lambdas: Int,\n  // per function\n  fname: String,\n  // its type arguments, and whether it is in the prelude\n  sub: Dict[String, check.Ty],\n  in_prelude: Bool,\n  lines: List[String],\n  allocas: List[String],\n  next: Int,\n  scopes: List[codegen.Scope],\n  // each loop: the `continue` and `break` labels, and the scope depth\n  // outside it\n  loops: List[(String, String, Int)],\n  ret: check.Ty,\n  // each exit's result and the block it leaves from: the exit `phi`\n  rets: List[(String, String)] = [],\n  // depth of `|` alternatives being bound: their names go in slots, which\n  // each alternative stores to\n  alts: Int = 0,\n  // a match arm's names are bound borrowed: the matched value outlives the\n  // arm unchanged\n  borrowing: Bool = false,\n  // the slot whose value leaves the function: scope drops skip it\n  // (`leave_with`)\n  moved: String = \"\",\n  // cancellation unwind blocks by scope depth: the signature of what the\n  // scopes up to it hold, and the block that drops it and falls through to\n  // the ones below. Cancel points with the same signature share a block.\n  unwind_chain: List[(String, String)] = [],\n  // what `verify` proved (`strata build --strata`), by function\n  // (`proofs_of`), and the function whose proofs apply (\"\" in helpers and\n  // lambdas). Proven checks are not emitted.\n  proofs: Dict[String, List[(String, String)]],\n  proving: String,\n  // `tasks`: the program starts tasks. `supervises`: it supervises one, so\n  // a wait, a call or a fault may leave a function (`cancel_point`).\n  // `can_unwind`: the current body may leave so. `unwinds`: it does, through\n  // its `unwound` exit.\n  tasks: Bool,\n  supervises: Bool,\n  can_unwind: Bool,\n  unwinds: Bool,\n  // `extern c` functions (by key) and types (`Counter`)\n  externs: Set[String],\n  handles: Set[String],\n  // core's `builtin static` blocks (core.rt's state) and their sizes\n  statics: Dict[String, Int],\n  // compiling core.rt (`bare`): no call-stack frames and no cancel points,\n  // since the allocator runs inside every allocation\n  bare: Bool,\n  // generators made (`gen_fn`), by type and hints\n  gens: Dict[String, String],\n  // compiling fuzz drivers: functions and loops count steps\n  fuzzing: Bool,\n  // fuzz drivers hand their arguments over as code (`strata_fuzz_arg`, for\n  // `verify`) instead of keeping them (`strata_fuzz_keep`)\n  fuzz_text: Bool,\n  // `--trace`: each call and return of the program's functions printed on\n  // stderr (`strata_trace_enter`, `strata_trace_leave`)\n  tracing: Bool,\n  // std functions taken from the precompiled library: declared, not\n  // compiled\n  precompiled: Set[String],\n  // compiling std's precompiled library (`codegen --library`): whatever\n  // depends on the codebase is left out\n  library_mode: Bool,\n  // `ret_w`: the function's result type as written, refined names kept\n  // (`List[Port]` where `ret` is `List[Int]`). `pending_w`: the written type\n  // arguments for the next call's type parameters (`T.from_json(…)` with\n  // `T` a `List[Port]`). They decide what `T.check(v)` checks in an\n  // instance (its sub's `$w:T`).\n  ret_w: check.Ty = check.TAny,\n  pending_w: Dict[String, check.Ty] = Dict[String, check.Ty] {},\n  // the function being compiled (its key), the callers of each function\n  // (by key), and the functions with something not compiled: std's\n  // library leaves these out\n  current: String,\n  callers: Dict[String, Set[String]],\n  failed: Set[String],\n  // `not_yet`'s errors for each of those, for verify's fuzz drivers to\n  // report\n  why: Dict[String, List[String]],\n  // parameters typed by a bounded type parameter (`x: T` with `T: Log`, or\n  // a trait's type compiled for a known type in `for_impls`), by slot, with\n  // their bounds. Their methods resolve to the bounds' methods, ahead of\n  // the type's own methods of the same name.\n  bound_slots: Dict[String, List[String]],\n  // checks of the program's own functions left out as proven, and those\n  // kept (`strata build` reports both)\n  left_out: Int,\n  kept: Int,\n  // `keeps`: which parameters each function may keep (`kept_by`), built on\n  // first use. `stack_next`: the constructor about to be compiled goes on the\n  // stack (a `let` whose value does not outlive its variable), and\n  // `stack_made` holds its field types.\n  keeps: Option[Dict[String, List[Bool]]],\n  stack_next: Bool,\n  stack_made: List[check.Ty],\n  // capabilities: field-less records shown by name alone (`Terminal`)\n  caps: Set[String] = Set[String] {},\n  // compiling one function alone on a worker (`compiled_alone`): its name\n  // prefixes the lambdas, tables and generators it makes (`lambdas` counts\n  // them). Its additions to the shared tables are kept apart, since workers\n  // only read those, and `merge_alone` adds them in order.\n  owner: String = \"\",\n  new_strings: Dict[String, String] = Dict[String, String] {},\n  new_helpers: Set[String] = Set[String] {},\n  // a list so that `merge_alone` can pair it with the queue in request\n  // order\n  new_instances: List[String] = [],\n  new_callers: List[(String, String)] = [],\n  new_failed: List[String] = [],\n  new_why: List[(String, String)] = [],\n  new_used: Set[String] = Set[String] {},\n  new_gens: Dict[String, String] = Dict[String, String] {},\n  new_unions: Dict[String, String] = Dict[String, String] {},\n  new_fns: Dict[String, ast.FnDecl] = Dict[String, ast.FnDecl] {},\n  // the calls after which a cancelled task may leave (`waits_of`): the call\n  // nodes that may reach a wait, and the functions and method names seen\n  // (`calls_wait`). `None` means every call (a supervising program, std's\n  // library).\n  waiting: Option[Set[String]] = None,\n  waits_known: Set[String] = Set[String] {},\n  // `--copies`: each copy made to change a value is reported\n  // (`strata_copied`) with its location. `sites` maps function and\n  // expression text to locations (`finding.copy_sites`), and `at` is the\n  // statement being compiled. `in_update`: compiling the copy an update\n  // falls back to, which reports it itself.\n  copies: Bool = false,\n  sites: Dict[String, String] = Dict[String, String] {},\n  // `--memory-sites`: each statement marked in the IR (`site_marker`) and\n  // each counting operation numbered and counted (`counted_sites`)\n  memory_sites: Bool = false,\n  // `--memory-sites`: the verdicts of `compiler/roots`, by function and\n  // expression text or variable (`roots.verdicts`); the codes of the\n  // expressions being compiled, innermost last; and the code of each\n  // temporary, by operand\n  roots: Dict[String, Int] = Dict[String, Int] {},\n  root_codes: List[Int] = [],\n  temp_codes: Dict[String, Int] = Dict[String, Int] {},\n  // (the hash of the statement being compiled, `roots.text_key`, and of\n  // the one each variable's slot was made in)\n  root_stmt: Int = 0,\n  slot_stmts: Dict[String, Int] = Dict[String, Int] {},\n  // (how many times each expression's key was looked up, `root_code`)\n  root_seen: Dict[String, Int] = Dict[String, Int] {},\n  at: ast.Expr = ast.UnitExpr,\n  in_update: Bool = false,\n  // the assignment being compiled already checked the elements it adds\n  // against the place's type (`checked_update`), so the whole value is not\n  // checked again\n  elements_checked: Bool = false,\n  // the expression being compiled, and the function's name as `strata\n  // check` shows it (`test \"NAME\"` for a test), for `not_yet`\n  here: ast.Expr = ast.UnitExpr,\n  shown_as: String = \"\",\n  // the `old e`s read by `ensures`: `e` as text, the name its entry value\n  // is held under, and that value\n  olds: List[(String, String, codegen.V)] = [],\n  // the updates in place proven to find their value held once\n  // (`unique.proven`), by site key. While a statement is compiled,\n  // `proven_root` is the variable its proven update changes (else \"\"), and\n  // `proven_put` the place a proven `mut p.m(…)` is about to assign.\n  proven: Set[String] = Set[String] {},\n  proven_root: String = \"\",\n  proven_put: String = \"\",\n  // small values (`small_words`): whether the function being compiled gives\n  // its result as words (`by_words`); whether the expression about to be\n  // compiled is in result position (its value is the result), and whether\n  // the call about to be compiled may leave its result on the stack (its\n  // value doesn't outlive the statement or the variable bound to it); the\n  // values in result position with the pointer each gives its caller\n  // (`result_words`: \"null\" for a block on the stack, whose words are\n  // given instead), and every block on the stack holding a small value,\n  // whose end drops its fields (`drop_stacked`)\n  by_words: Bool = false,\n  result_pos: Bool = false,\n  stack_call: Bool = false,\n  // whether the call about to be compiled is assigned to a `mut` variable\n  // (`assign_held`: its words may go into the variable's own block)\n  held_call: Bool = false,\n  rp_ptrs: Dict[String, String] = Dict[String, String] {},\n  stack_ops: Set[String] = Set[String] {},\n  // `--regions`: values that die in the statement that makes them go in\n  // the statement's region (`roots.scoped`: the sites and statements, by\n  // function and text). `region_stmt` is the hash of the statement being\n  // compiled when it took a mark (`region_open`), else -1.\n  regions: Bool = false,\n  region_sites: Set[String] = Set[String] {},\n  region_stmt: Int = -1,\n}"},{"name":"codegen.proven_entry","kind":"fn","old":"2b7d9d8ef56a5d2f","new":"7dfa07ce04562a84","interface_changed":false,"affected":[],"module":"codegen","text":"/// Whether every call of the current function proves its entry check\n/// `what` (`argument P`, `requires I`), so it is left out.\nfn proven_entry(mut g: codegen.Gen, what: String) -> Bool {\n  if g.proving == \"\" || g.live {\n    return false\n  }\n  for (kind, e) in get(g.proofs, g.proving) ?? [] {\n    if kind == \"entry\" && e == what {\n      g.left_out += 1\n      return true\n    }\n  }\n  g.kept += 1\n  false\n}","old_text":"/// Whether every call of the current function proves its entry check\n/// `what` (`argument P`, `requires I`), so it is left out.\nfn proven_entry(mut g: codegen.Gen, what: String) -> Bool {\n  if g.proving == \"\" {\n    return false\n  }\n  for (kind, e) in get(g.proofs, g.proving) ?? [] {\n    if kind == \"entry\" && e == what {\n      g.left_out += 1\n      return true\n    }\n  }\n  g.kept += 1\n  false\n}"},{"name":"codegen.generate","kind":"fn","old":"6ab5dd1d077f9f87","new":"5715ecf7487cb129","interface_changed":true,"affected":["codegen_with","core_rt_text","computed_value","repl_eval","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","live_edit_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","tour_graph","linked","expanded","comptime_runner","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","diff_command","tour_command","with_base","codegen.entry","codegen.new_gen","codegen.compiled_alone","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// The program's `main` and what it calls as LLVM IR, or the constructs not\n/// compiled, each with its function. `assumed_clauses` also checks the\n/// assumed contract clauses (`--check-assumed`). Verify's fuzz drivers\n/// always check them. `regions` makes the values that die in the statement\n/// that makes them in the statement's region (`--regions`). `live`\n/// compiles each function from its own code only (`Gen.live`).\npub fn generate(\n  given: List[ast.Decl],\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  proofs: List[String],\n  tests: Option[List[(String, String)]],\n  fuzz: List[String],\n  fuzz_text: Bool,\n  calls: List[String],\n  trace: Bool,\n  library: List[String],\n  precompiled: List[String],\n  bare: Bool,\n  copies: Option[Dict[String, String]],\n  memory_sites: Option[Dict[String, String]],\n  assumed_clauses: Bool,\n  regions: Bool,\n  live: Bool,\n) -> Result[String, List[String]] {\n  // unused variables with no effect are not compiled (`unread_dropped`),\n  // and assumed contract clauses are left out (`assumed_compiled`)\n  keep := assumed_clauses || fuzz != []\n  // lemmas and proofs (`assert … by`, `calc`) are for `verify` alone: never\n  // compiled\n  (start, main) := match codegen.new_gen(\n    given\n      .filter(d -> !match d.kind {\n        ast.FnDef(f) => f.lemma,\n        _ => false,\n      })\n      .map(d -> walk.rewrite_decl(\n        codegen.assumed_compiled(d, keep),\n        x -> codegen.unread_dropped(codegen.proofs_dropped(x)),\n      )),\n    core,\n    prelude,\n    proofs,\n    tests,\n    fuzz,\n    fuzz_text,\n    calls,\n    trace,\n    library,\n    precompiled,\n  ) {\n    Ok(x) => x,\n    Err(es) => return Err(es),\n  }\n  // core.rt (`bare`): no call-stack frames, no cancel points\n  mut g := if bare {\n    codegen.Gen { ..start, bare: true, tasks: false, supervises: false }\n  } else {\n    start\n  }\n  if live {\n    g.live = true\n    // (no function's parameters known to be only borrowed)\n    g.keeps = Some(Dict[String, List[Bool]] {})\n  }\n  // `--copies`: report copies with their locations\n  match copies {\n    Some(sites) => {\n      g.copies = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  // (`--memory-sites`: each counting operation counted, by site)\n  match memory_sites {\n    Some(sites) => {\n      g.memory_sites = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  mut bodies := match tests {\n    // each test as `strata test` runs it (`strata.test.N`), with its name\n    Some(ts) => enumerate(ts).map(x -> codegen.test_entry(x.0, x.1.0, x.1.1)),\n    None => if fuzz != [] || library != [] || calls != [] {\n      []\n    } else if main.name == \"\" {\n      // a library starts when it is loaded\n      [codegen.library_start(mut g)]\n    } else {\n      [codegen.entry(mut g, main)]\n    },\n  }\n  // std's library runs in any program, with tasks or without. It holds its\n  // functions by key and its `impl`s' methods (`library_methods`), except\n  // those `!KEY` excludes. Generic functions, those depending on the\n  // compile, and trait values are compiled per program instead.\n  mut roots := []\n  mut held := []\n  left_out := set(library\n    .filter(k -> starts_with(k, \"!\"))\n    .map(k -> byte_slice(k, 1, byte_len(k))))\n  mut wanted := library.filter(k -> !starts_with(k, \"!\"))\n  if library != [] {\n    wanted += codegen.library_methods(mut g).filter(\n      k -> !contains(left_out, k),\n    )\n  }\n  for k in wanted {\n    match codegen.fn_of(g, k) {\n      Some(f) => if codegen.precompilable(mut g, k, f) {\n        sym := codegen.instance(mut g, k, f, Dict[String, check.Ty] {})\n        mut roots.push(sym)\n        mut held.push(k)\n      },\n      None => (),\n    }\n  }\n  // verify's fuzz drivers (`strata.fuzz.N`)\n  for (i, k) in enumerate(fuzz) {\n    mut bodies.push(codegen.fuzz_driver(mut g, i, k))\n  }\n  // `strata run f ARGS` calls (`strata.call.N`). `session:KEY` is a\n  // `strata repl` line, with the session's arguments.\n  for (i, k) in enumerate(calls) {\n    mut bodies.push(\n      if starts_with(k, \"session:\") {\n        codegen.session_entry(\n          mut g,\n          i,\n          byte_slice(k, 8, byte_len(k)),\n        )\n      } else {\n        codegen.call_entry(mut g, i, k)\n      },\n    )\n  }\n  // the exports of `derive C for f`, each under its symbol\n  if fuzz == [] && library == [] && calls == [] && tests is None {\n    for (symbol, k) in codegen.exports_of(given) {\n      mut bodies.push(codegen.export_entry(mut g, symbol, k))\n    }\n  }\n  // the files they generate: the C header\n  parts := match codegen.file_parts(given) {\n    Ok(ps) => ps,\n    Err(e) => return Err([e]),\n  }\n  // Each reachable function instance, once, in rounds. The workers compile\n  // each function of a round alone from the state the round began with.\n  // Their additions are then merged in queue order, so the output does not\n  // depend on thread timing.\n  if len(g.queue) > 0 && g.keeps is None {\n    g.keeps = Some(codegen.kept_by(g.fns))\n  }\n  // the updates in place proven to find their value held once, for builds\n  // and tests (not for verify's fuzzing, `strata run f` and compile-time\n  // code, which run once). Only a program's build sees every call of its\n  // functions (`closed`).\n  if len(g.queue) > 0 && !bare && !live && fuzz == [] && calls == [] {\n    closed := library == []\n      && tests is None\n      && main.name != \"\"\n      && codegen.exports_of(given) == []\n    g.proven = unique.proven_sites(\n      g.fns,\n      codegen.keeps_of(mut g),\n      closed,\n      g.distincts,\n      g.traits,\n    )\n  }\n  // (`--regions`: the values made in statement regions)\n  if regions && !bare && !live && len(g.queue) > 0 {\n    g.regions = true\n    g.region_sites = roots.scoped(g.fns, codegen.keeps_of(mut g), g.traits, g.proven)\n  }\n  // (`--memory-sites`: where scoped allocation would put each value)\n  if g.memory_sites && len(g.queue) > 0 {\n    g.roots = roots.verdicts(\n      g.fns,\n      codegen.keeps_of(mut g),\n      g.traits,\n      g.proven,\n    )\n  }\n  mut global_keys := set(g.globals.map(l -> codegen.global_key(l)))\n  mut def_keys := set(g.helper_defs.map(d -> codegen.def_key(d)))\n  while len(g.queue) > 0 {\n    round := g.queue\n    g.queue = []\n    base := g\n    for (body, d) in parallel.map(\n      round,\n      item -> codegen.compiled_alone(base, item.0, item.1, main),\n    ) {\n      mut bodies.push(body)\n      codegen.merge_alone(\n        mut g,\n        base,\n        d,\n        mut global_keys,\n        mut def_keys,\n      )\n    }\n  }\n  if len(g.errs) > 0 {\n    // std's library leaves out the functions that reach something not\n    // compiled\n    if library != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      out := wanted.filter(k -> contains(left, k))\n      if out != [] {\n        return Err(out.map(k -> \"leave out: \" + k))\n      }\n    }\n    // verify's fuzz drivers: each one reaching something not compiled is\n    // reported as `can't fuzz `KEY`: WHY`, so `verify` drops them all at\n    // once\n    if fuzz != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      callees := codegen.callees_of(g.callers)\n      return Err(g.errs\n        + fuzz\n          .filter(k -> contains(left, \"fuzz:\" + k))\n          .map(k -> \"can't fuzz `\"\n            + k\n            + \"`: \"\n            + join(\n              codegen.failures_of(callees, g.why, \"fuzz:\" + k),\n              \"; \",\n            )))\n    }\n    return Err(g.errs)\n  }\n  mut out := [\n    \"; Strata, compiled by compiler/codegen\",\n    f\"; checks left out {g.left_out}, kept {g.kept}\",\n    \"\",\n  ]\n  // std's library lists the functions it holds: `; precompiled NAME`\n  out += held.map(k -> \"; precompiled \" + k)\n  out += parts.map(p -> codegen.file_line(p.0, p.1))\n  // the symbols a library exports (`; export add`); the rest are hidden\n  out += if fuzz == [] && library == [] && calls == [] && tests is None {\n    codegen.exports_of(given).map(e -> \"; export \" + e.0)\n  } else {\n    []\n  }\n  out += g.globals\n  mut out.push(\"\")\n  // std's library exposes only its functions\n  out += if library != [] {\n    codegen.internal(bodies + g.helper_defs, set(roots))\n  } else {\n    bodies + g.helper_defs\n  }\n  for d in codegen.declarations() {\n    if contains(g.used, d.0) {\n      mut out.push(d.1)\n    }\n  }\n  ir_text := join(out, \"\\n\") + \"\\n\"\n  Ok(if g.memory_sites {\n    codegen.counted_sites(ir_text)\n  } else {\n    ir_text\n  })\n}","old_text":"/// The program's `main` and what it calls as LLVM IR, or the constructs not\n/// compiled, each with its function. `assumed_clauses` also checks the\n/// assumed contract clauses (`--check-assumed`). Verify's fuzz drivers\n/// always check them. `regions` makes the values that die in the statement\n/// that makes them in the statement's region (`--regions`).\npub fn generate(\n  given: List[ast.Decl],\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  proofs: List[String],\n  tests: Option[List[(String, String)]],\n  fuzz: List[String],\n  fuzz_text: Bool,\n  calls: List[String],\n  trace: Bool,\n  library: List[String],\n  precompiled: List[String],\n  bare: Bool,\n  copies: Option[Dict[String, String]],\n  memory_sites: Option[Dict[String, String]],\n  assumed_clauses: Bool,\n  regions: Bool,\n) -> Result[String, List[String]] {\n  // unused variables with no effect are not compiled (`unread_dropped`),\n  // and assumed contract clauses are left out (`assumed_compiled`)\n  keep := assumed_clauses || fuzz != []\n  // lemmas and proofs (`assert … by`, `calc`) are for `verify` alone: never\n  // compiled\n  (start, main) := match codegen.new_gen(\n    given\n      .filter(d -> !match d.kind {\n        ast.FnDef(f) => f.lemma,\n        _ => false,\n      })\n      .map(d -> walk.rewrite_decl(\n        codegen.assumed_compiled(d, keep),\n        x -> codegen.unread_dropped(codegen.proofs_dropped(x)),\n      )),\n    core,\n    prelude,\n    proofs,\n    tests,\n    fuzz,\n    fuzz_text,\n    calls,\n    trace,\n    library,\n    precompiled,\n  ) {\n    Ok(x) => x,\n    Err(es) => return Err(es),\n  }\n  // core.rt (`bare`): no call-stack frames, no cancel points\n  mut g := if bare {\n    codegen.Gen { ..start, bare: true, tasks: false, supervises: false }\n  } else {\n    start\n  }\n  // `--copies`: report copies with their locations\n  match copies {\n    Some(sites) => {\n      g.copies = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  // (`--memory-sites`: each counting operation counted, by site)\n  match memory_sites {\n    Some(sites) => {\n      g.memory_sites = true\n      g.sites = sites\n    },\n    None => (),\n  }\n  mut bodies := match tests {\n    // each test as `strata test` runs it (`strata.test.N`), with its name\n    Some(ts) => enumerate(ts).map(x -> codegen.test_entry(x.0, x.1.0, x.1.1)),\n    None => if fuzz != [] || library != [] || calls != [] {\n      []\n    } else if main.name == \"\" {\n      // a library starts when it is loaded\n      [codegen.library_start(mut g)]\n    } else {\n      [codegen.entry(mut g, main)]\n    },\n  }\n  // std's library runs in any program, with tasks or without. It holds its\n  // functions by key and its `impl`s' methods (`library_methods`), except\n  // those `!KEY` excludes. Generic functions, those depending on the\n  // compile, and trait values are compiled per program instead.\n  mut roots := []\n  mut held := []\n  left_out := set(library\n    .filter(k -> starts_with(k, \"!\"))\n    .map(k -> byte_slice(k, 1, byte_len(k))))\n  mut wanted := library.filter(k -> !starts_with(k, \"!\"))\n  if library != [] {\n    wanted += codegen.library_methods(mut g).filter(\n      k -> !contains(left_out, k),\n    )\n  }\n  for k in wanted {\n    match codegen.fn_of(g, k) {\n      Some(f) => if codegen.precompilable(mut g, k, f) {\n        sym := codegen.instance(mut g, k, f, Dict[String, check.Ty] {})\n        mut roots.push(sym)\n        mut held.push(k)\n      },\n      None => (),\n    }\n  }\n  // verify's fuzz drivers (`strata.fuzz.N`)\n  for (i, k) in enumerate(fuzz) {\n    mut bodies.push(codegen.fuzz_driver(mut g, i, k))\n  }\n  // `strata run f ARGS` calls (`strata.call.N`). `session:KEY` is a\n  // `strata repl` line, with the session's arguments.\n  for (i, k) in enumerate(calls) {\n    mut bodies.push(\n      if starts_with(k, \"session:\") {\n        codegen.session_entry(\n          mut g,\n          i,\n          byte_slice(k, 8, byte_len(k)),\n        )\n      } else {\n        codegen.call_entry(mut g, i, k)\n      },\n    )\n  }\n  // the exports of `derive C for f`, each under its symbol\n  if fuzz == [] && library == [] && calls == [] && tests is None {\n    for (symbol, k) in codegen.exports_of(given) {\n      mut bodies.push(codegen.export_entry(mut g, symbol, k))\n    }\n  }\n  // the files they generate: the C header\n  parts := match codegen.file_parts(given) {\n    Ok(ps) => ps,\n    Err(e) => return Err([e]),\n  }\n  // Each reachable function instance, once, in rounds. The workers compile\n  // each function of a round alone from the state the round began with.\n  // Their additions are then merged in queue order, so the output does not\n  // depend on thread timing.\n  if len(g.queue) > 0 && g.keeps is None {\n    g.keeps = Some(codegen.kept_by(g.fns))\n  }\n  // the updates in place proven to find their value held once, for builds\n  // and tests (not for verify's fuzzing, `strata run f` and compile-time\n  // code, which run once). Only a program's build sees every call of its\n  // functions (`closed`).\n  if len(g.queue) > 0 && !bare && fuzz == [] && calls == [] {\n    closed := library == []\n      && tests is None\n      && main.name != \"\"\n      && codegen.exports_of(given) == []\n    g.proven = unique.proven_sites(\n      g.fns,\n      codegen.keeps_of(mut g),\n      closed,\n      g.distincts,\n      g.traits,\n    )\n  }\n  // (`--regions`: the values made in statement regions)\n  if regions && !bare && len(g.queue) > 0 {\n    g.regions = true\n    g.region_sites = roots.scoped(g.fns, codegen.keeps_of(mut g), g.traits, g.proven)\n  }\n  // (`--memory-sites`: where scoped allocation would put each value)\n  if g.memory_sites && len(g.queue) > 0 {\n    g.roots = roots.verdicts(\n      g.fns,\n      codegen.keeps_of(mut g),\n      g.traits,\n      g.proven,\n    )\n  }\n  mut global_keys := set(g.globals.map(l -> codegen.global_key(l)))\n  mut def_keys := set(g.helper_defs.map(d -> codegen.def_key(d)))\n  while len(g.queue) > 0 {\n    round := g.queue\n    g.queue = []\n    base := g\n    for (body, d) in parallel.map(\n      round,\n      item -> codegen.compiled_alone(base, item.0, item.1, main),\n    ) {\n      mut bodies.push(body)\n      codegen.merge_alone(\n        mut g,\n        base,\n        d,\n        mut global_keys,\n        mut def_keys,\n      )\n    }\n  }\n  if len(g.errs) > 0 {\n    // std's library leaves out the functions that reach something not\n    // compiled\n    if library != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      out := wanted.filter(k -> contains(left, k))\n      if out != [] {\n        return Err(out.map(k -> \"leave out: \" + k))\n      }\n    }\n    // verify's fuzz drivers: each one reaching something not compiled is\n    // reported as `can't fuzz `KEY`: WHY`, so `verify` drops them all at\n    // once\n    if fuzz != [] {\n      left := codegen.reaching(g.callers, g.failed)\n      callees := codegen.callees_of(g.callers)\n      return Err(g.errs\n        + fuzz\n          .filter(k -> contains(left, \"fuzz:\" + k))\n          .map(k -> \"can't fuzz `\"\n            + k\n            + \"`: \"\n            + join(\n              codegen.failures_of(callees, g.why, \"fuzz:\" + k),\n              \"; \",\n            )))\n    }\n    return Err(g.errs)\n  }\n  mut out := [\n    \"; Strata, compiled by compiler/codegen\",\n    f\"; checks left out {g.left_out}, kept {g.kept}\",\n    \"\",\n  ]\n  // std's library lists the functions it holds: `; precompiled NAME`\n  out += held.map(k -> \"; precompiled \" + k)\n  out += parts.map(p -> codegen.file_line(p.0, p.1))\n  // the symbols a library exports (`; export add`); the rest are hidden\n  out += if fuzz == [] && library == [] && calls == [] && tests is None {\n    codegen.exports_of(given).map(e -> \"; export \" + e.0)\n  } else {\n    []\n  }\n  out += g.globals\n  mut out.push(\"\")\n  // std's library exposes only its functions\n  out += if library != [] {\n    codegen.internal(bodies + g.helper_defs, set(roots))\n  } else {\n    bodies + g.helper_defs\n  }\n  for d in codegen.declarations() {\n    if contains(g.used, d.0) {\n      mut out.push(d.1)\n    }\n  }\n  ir_text := join(out, \"\\n\") + \"\\n\"\n  Ok(if g.memory_sites {\n    codegen.counted_sites(ir_text)\n  } else {\n    ir_text\n  })\n}"},{"name":"codegen_with","kind":"fn","old":"65f808c544eae92c","new":"fce9880c1b8c91a7","interface_changed":false,"affected":[],"module":"","text":"/// `extra` definitions are added to the program's: the probes of\n/// `literal_errors`.\nfn codegen_with(\n  disk: std.fs.Disk,\n  sh: Shared,\n  args: List[String],\n  extra: List[ast.Decl],\n) -> String {\n  // `--core-rt`: core.rt, the runtime written in Strata, as a library\n  if get(args, 0) ?? \"\" == \"--core-rt\" {\n    return core_rt_text(disk)\n  }\n  mut out := []\n  // `--copies` (anywhere): each copy made to change a value is reported, at\n  // its location, when the program ends (`strata run --copies`)\n  copies := args.any(a -> a == \"--copies\")\n  // `--memory-sites` (anywhere): each counting operation counted, by site,\n  // and the sites reported when the program ends\n  memory_sites := args.any(a -> a == \"--memory-sites\")\n  // `--regions` (anywhere): the values that die in the statement that makes\n  // them go in the statement's region (`strata build --regions`)\n  regions := args.any(a -> a == \"--regions\")\n  // `--live` (anywhere): `strata run --live`'s code (codegen's `Gen.live`)\n  live := args.any(a -> a == \"--live\")\n  // `--lib` (anywhere): a library (`strata build --lib`): its exports are\n  // compiled instead of `main`\n  lib := args.any(a -> a == \"--lib\")\n  // `--check-assumed` (anywhere): the assumed contracts are checked too\n  assumed_clauses := args.any(a -> a == \"--check-assumed\")\n  mut files := args.filter(\n    a -> a != \"--copies\"\n      && a != \"--memory-sites\"\n      && a != \"--regions\"\n      && a != \"--live\"\n      && a != \"--lib\"\n      && a != \"--check-assumed\",\n  )\n  // `--code-root DIR`: `strata run`'s codebase (`std.code`'s `Codebase`),\n  // snapshotted for the program\n  mut code_root := \"\"\n  if get(files, 0) ?? \"\" == \"--code-root\" {\n    code_root = get(files, 1) ?? \"\"\n    files = drop(files, 2)\n  }\n  // `--proofs FILE`: what `verify` proved (`strata build --strata`); those\n  // checks are left out\n  mut proofs := []\n  if get(files, 0) ?? \"\" == \"--proofs\" {\n    file := get(files, 1) ?? \"\"\n    match disk.read(file) {\n      Ok(text) => {\n        proofs = split(text, \"\\n\")\n      },\n      Err(_) => mut out.push(\"error: unreadable: \" + file),\n    }\n    files = drop(files, 2)\n  }\n  // `--precompiled FILE`: std's functions found in its precompiled library\n  // (one name a line), declared instead of compiled\n  mut precompiled := []\n  if get(files, 0) ?? \"\" == \"--precompiled\" {\n    file := get(files, 1) ?? \"\"\n    match disk.read(file) {\n      Ok(text) => {\n        precompiled = split(text, \"\\n\").filter(x -> x != \"\")\n      },\n      Err(_) => mut out.push(\"error: unreadable: \" + file),\n    }\n    files = drop(files, 2)\n  }\n  // `--library`: std's library (its functions that compile once for every\n  // program) instead of a program; `leave out: F` for each function it\n  // can't hold\n  library := get(files, 0) ?? \"\" == \"--library\"\n  if library {\n    files = drop(files, 1)\n  }\n  // `--trace`: each call and return shown on stderr (`strata run --trace`)\n  trace := get(files, 0) ?? \"\" == \"--trace\"\n  if trace {\n    files = drop(files, 1)\n  }\n  // `--tests`: `strata test`'s tests instead of `main`\n  tests := get(files, 0) ?? \"\" == \"--tests\"\n  if tests {\n    files = drop(files, 1)\n  }\n  // `--fuzz F,G`: verify's fuzz drivers of those functions instead of `main`.\n  // `--fuzz-text F,G`: the drivers hand their arguments over as code, for\n  // the compiler's own `verify`.\n  mut fuzz := []\n  fuzz_text := get(files, 0) ?? \"\" == \"--fuzz-text\"\n  if get(files, 0) ?? \"\" == \"--fuzz\" || fuzz_text {\n    fuzz = split(get(files, 1) ?? \"\", \",\").filter(x -> x != \"\")\n    files = drop(files, 2)\n  }\n  // `--call FILE`: `strata run f ARGS`' call (`strata.call.0`) instead of\n  // `main`. The module file FILE holds the function that makes the call\n  // (in `f`'s module, with the arguments written in it); it is added to the\n  // program.\n  mut made := []\n  if get(files, 0) ?? \"\" == \"--call\" {\n    made = module_decls(disk, [get(files, 1) ?? \"\"])\n    files = drop(files, 2)\n  }\n  calls := fn_names(made)\n  // (with core's types: their refinements, `Natural` and the others)\n  prelude := sh.prelude\n  // the program as it runs: desugared, its `derive`s expanded, with the std\n  // modules it uses (read from `std/`, until what the expanded code names is\n  // there too) and core's code (iterators: only what it uses is compiled),\n  // its names global as core's types are. A script, or a package's folder\n  // with each module named by its path. `Base` holds the run's program,\n  // already expanded, when it is this one.\n  base := match sh.base {\n    Some(b) => if b.files == files && !library && !tests && made == [] {\n      Some(b)\n    } else {\n      None\n    },\n    None => None,\n  }\n  mut own := if library {\n    package_decls(disk, \"std\", \"std\")\n  } else {\n    []\n  }\n  own += match base {\n    Some(b) => b.own,\n    None => files_decls(disk, sh.cache.dir, sh.core, files),\n  }\n  own += extra + made\n  if lib {\n    own = own.filter(\n      d -> !(d.module == \"\"\n        && match d.kind {\n          ast.FnDef(f) => f.name == \"main\",\n          _ => false,\n        }),\n    )\n  }\n  // the tests, each a function of no parameters given what it asks for\n  mut test_fns := []\n  if tests {\n    mut kept := []\n    for d in own {\n      match d.kind {\n        // (not the runtime's modules' (core.rt …): they compile only together,\n        // into the runtime, `strata build-core`)\n        ast.TestDef(t) => if !builtins.runtime_module(d.module) {\n          fd := test_fn(t, \"test:\" + to_string(len(test_fns)))\n          // (named after its module outside the root one, as `core.mem: …`)\n          shown := if d.module == \"\" {\n            t.name\n          } else {\n            d.module + \": \" + t.name\n          }\n          // (its key as the code generator names it, qualified by its module: a key\n          // naming no function compiles `main` in its place)\n          mut test_fns.push((qualified_name(d.module, fd.name), shown))\n          mut kept.push(ast.Decl { ..d, kind: ast.FnDef(fd) })\n        },\n        _ => mut kept.push(d),\n      }\n    }\n    own = kept\n  }\n  core := sh.core\n  extended := match base {\n    Some(b) => with_extra(disk, sh, b, extra),\n    None => None,\n  }\n  (program, errors) := match extended {\n    Some(x) => x,\n    None => {\n      made_now := expanded(\n        disk,\n        Shared { ..sh, settings: settings_of_files(disk, files) },\n        own,\n      )\n      (made_now.0, made_now.1)\n    },\n  }\n  for e in errors {\n    mut out.push(\"error: in `\" + e.0 + \"`: \" + e.1)\n  }\n  // (the codebase, when the program reaches `std.code`)\n  program := if code_root != \"\" && program.any(d -> d.module == \"std.code\") {\n    program + code_snapshot_decls(disk, core, code_root)\n  } else {\n    program\n  }\n  // (std's library: each of std's functions except those reading a\n  // package's setting, `std.typing.setting`, which compile with each program)\n  mut roots := []\n  if library {\n    mut reads := Set[String] {}\n    for d in own {\n      match d.kind {\n        ast.FnDef(f) => if walk.any_expr(f.body, e -> match e {\n          ast.Call { callee: ast.Var(\"std.typing.setting\"), .. } => true,\n          _ => false,\n        }) {\n          mut reads.insert(d.module + \".\" + f.name)\n        },\n        _ => (),\n      }\n    }\n    for d in program {\n      match d.kind {\n        ast.FnDef(f) => if starts_with(d.module, \"std.\")\n          && !contains(reads, d.module + \".\" + f.name) {\n          mut roots.push(d.module + \".\" + f.name)\n        },\n        _ => (),\n      }\n    }\n  }\n  wanted := if tests {\n    Some(test_fns)\n  } else {\n    None\n  }\n  // (std's library: compiled again without the functions it can't hold,\n  // until it compiles; an `impl` method it can't hold is `!KEY`)\n  mut left_out := []\n  places := if copies || memory_sites {\n    finding.copy_sites(own)\n  } else {\n    Dict[String, String] {}\n  }\n  sites := if copies {\n    Some(places)\n  } else {\n    None\n  }\n  counted := if memory_sites {\n    Some(places)\n  } else {\n    None\n  }\n  for _ in 0..16 {\n    match timings.timed(\"codegen IR\", () -> codegen.generate(\n      program,\n      core,\n      prelude,\n      proofs,\n      wanted,\n      fuzz,\n      fuzz_text,\n      calls,\n      trace,\n      roots + left_out,\n      precompiled,\n      false,\n      sites,\n      counted,\n      assumed_clauses,\n      regions,\n      live,\n    )) {\n      Ok(ir) => {\n        mut out.push(ir)\n        break\n      },\n      Err(es) => if es.all(e -> starts_with(e, \"leave out: \")) && es != [] {\n        left := set(es.map(e -> byte_slice(e, 11, byte_len(e))))\n        roots = roots.filter(r -> !contains(left, r))\n        for k in left {\n          mut left_out.push(\"!\" + k)\n        }\n      } else {\n        for e in es {\n          mut out.push(\"error: \" + e)\n        }\n        break\n      },\n    }\n  }\n  join(out, \"\\n\")\n}","old_text":"/// `extra` definitions are added to the program's: the probes of\n/// `literal_errors`.\nfn codegen_with(\n  disk: std.fs.Disk,\n  sh: Shared,\n  args: List[String],\n  extra: List[ast.Decl],\n) -> String {\n  // `--core-rt`: core.rt, the runtime written in Strata, as a library\n  if get(args, 0) ?? \"\" == \"--core-rt\" {\n    return core_rt_text(disk)\n  }\n  mut out := []\n  // `--copies` (anywhere): each copy made to change a value is reported, at\n  // its location, when the program ends (`strata run --copies`)\n  copies := args.any(a -> a == \"--copies\")\n  // `--memory-sites` (anywhere): each counting operation counted, by site,\n  // and the sites reported when the program ends\n  memory_sites := args.any(a -> a == \"--memory-sites\")\n  // `--regions` (anywhere): the values that die in the statement that makes\n  // them go in the statement's region (`strata build --regions`)\n  regions := args.any(a -> a == \"--regions\")\n  // `--lib` (anywhere): a library (`strata build --lib`): its exports are\n  // compiled instead of `main`\n  lib := args.any(a -> a == \"--lib\")\n  // `--check-assumed` (anywhere): the assumed contracts are checked too\n  assumed_clauses := args.any(a -> a == \"--check-assumed\")\n  mut files := args.filter(\n    a -> a != \"--copies\"\n      && a != \"--memory-sites\"\n      && a != \"--regions\"\n      && a != \"--lib\"\n      && a != \"--check-assumed\",\n  )\n  // `--code-root DIR`: `strata run`'s codebase (`std.code`'s `Codebase`),\n  // snapshotted for the program\n  mut code_root := \"\"\n  if get(files, 0) ?? \"\" == \"--code-root\" {\n    code_root = get(files, 1) ?? \"\"\n    files = drop(files, 2)\n  }\n  