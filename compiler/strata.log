nsert into \" + eval.code(a))),\n    },\n    \"remove\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.DictExpr { types: [], entries: eval.swap_removed(\n        entries,\n        eval.index_where(entries.map(kv -> kv.0), b),\n      ) }),\n      ast.SetExpr { elems, .. } => Ok(ast.SetExpr {\n        types: [],\n        elems: eval.swap_removed(elems, eval.index_where(elems, b)),\n      }),\n      _ => Err(eval.runtime(\"remove from \" + eval.code(a))),\n    },\n    \"keys\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.ListExpr(entries.map(kv -> kv.0))),\n      _ => Err(eval.runtime(\"keys of \" + eval.code(a))),\n    },\n    \"values\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.ListExpr(entries.map(kv -> kv.1))),\n      _ => Err(eval.runtime(\"values of \" + eval.code(a))),\n    },\n    \"items\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.ListExpr(entries.map(kv -> eval.pair(kv.0, kv.1)))),\n      _ => Err(eval.runtime(\"items of \" + eval.code(a))),\n    },\n    \"map_values\" => match a {\n      ast.DictExpr { entries, .. } => {\n        mut out: List[(ast.Expr, ast.Expr)] = []\n        for kv in entries {\n          mut out.push((kv.0, eval.apply(mut st, w, b, [kv.1])!))\n        }\n        Ok(ast.DictExpr { types: [], entries: out })\n      },\n      _ => Err(eval.runtime(\"map_values of \" + eval.code(a))),\n    },\n    \"set\" => Ok(eval.make_set(w, eval.collection_of(a)!)),\n    \"to_list\" => Ok(ast.ListExpr(eval.collection_of(a)!)),\n    \"union\" => Ok(eval.make_set(\n      w,\n      eval.collection_of(a)! + eval.collection_of(b)!,\n    )),\n    \"intersection\" => {\n      ys := eval.collection_of(b)!\n      Ok(eval.make_set(\n        w,\n        eval.collection_of(a)!.filter(x -> contains(ys, x)),\n      ))\n    },\n    \"difference\" => {\n      ys := eval.collection_of(b)!\n      Ok(eval.make_set(\n        w,\n        eval.collection_of(a)!.filter(x -> !contains(ys, x)),\n      ))\n    },\n    \"zip\" => Ok(ast.ListExpr(zip(eval.list_of(a)!, eval.list_of(b)!).map(\n      p -> eval.pair(p.0, p.1),\n    ))),\n    \"enumerate\" => Ok(ast.ListExpr(\n      [eval.pair(ast.IntLit(i), x) for (i, x) in enumerate(eval.list_of(a)!)],\n    )),\n    \"sort\" => Ok(ast.ListExpr(\n      eval.merge_sort(mut st, w, eval.list_of(a)!.map(x -> (x, x))).map(\n        p -> p.1,\n      ),\n    )),\n    \"sort_by\" => {\n      mut keyed := []\n      for x in eval.list_of(a)! {\n        mut keyed.push((eval.apply(mut st, w, b, [x])!, x))\n      }\n      Ok(\n        ast.ListExpr(\n          eval.merge_sort(mut st, w, keyed).map(p -> p.1),\n        ),\n      )\n    },\n    \"reverse\" => match a {\n      ast.StrLit(s) => Ok(ast.StrLit(s.reversed())),\n      _ => Ok(ast.ListExpr(eval.list_of(a)!.reversed())),\n    },\n    \"join\" => Ok(\n      ast.StrLit(join(eval.strs(eval.list_of(a)!), eval.str_of(b)!)),\n    ),\n    \"split\" => Ok(eval.str_list(split(eval.str_of(a)!, eval.str_of(b)!))),\n    \"trim\" => Ok(ast.StrLit(trim(eval.str_of(a)!))),\n    \"lines\" => Ok(eval.str_list(lines(eval.str_of(a)!))),\n    \"parse_int\" => Ok(eval.option(match parse_int(eval.str_of(a)!) {\n      Some(n) => Some(ast.IntLit(n)),\n      None => None,\n    })),\n    \"parse_float\" => Ok(eval.option(match parse_float(eval.str_of(a)!) {\n      Some(f) => Some(ast.FloatLit(f)),\n      None => None,\n    })),\n    \"float\" => {\n      n := eval.int_of(a)!\n      // the Ints that round to a finite Float\n      big := (1 << 1024) - (1 << 970)\n      if n >= big || n <= -big {\n        return Err(\n          eval.runtime(to_string(n) + \" is too large for a Float\"),\n        )\n      }\n      Ok(ast.FloatLit(float(n)))\n    },\n    \"floor\" | \"ceil\" | \"round\" => {\n      f := eval.float_of(a)!\n      r := match name {\n        \"floor\" => checked_floor(f),\n        \"ceil\" => checked_ceil(f),\n        _ => checked_round(f),\n      }\n      match r {\n        Some(n) => Ok(ast.IntLit(n)),\n        None => Err(\n          eval.runtime(\n            text.plain_float(f) + \" is not a whole number\",\n          ),\n        ),\n      }\n    },\n    \"checked_add\" | \"checked_sub\" | \"checked_mul\" | \"checked_div\" | \"checked_rem\" => {\n      (x, y) := (eval.float_of(a)!, eval.float_of(b)!)\n      r := match name {\n        \"checked_add\" => checked_add(x, y),\n        \"checked_sub\" => checked_sub(x, y),\n        \"checked_mul\" => checked_mul(x, y),\n        \"checked_div\" => checked_div(x, y),\n        _ => checked_rem(x, y),\n      }\n      Ok(eval.option(match r {\n        Some(f) => Some(ast.FloatLit(f)),\n        None => None,\n      }))\n    },\n    \"checked_sqrt\" => Ok(eval.option(match checked_sqrt(eval.float_of(a)!) {\n      Some(f) => Some(ast.FloatLit(f)),\n      None => None,\n    })),\n    \"checked_floor\" | \"checked_ceil\" | \"checked_round\" => {\n      x := eval.float_of(a)!\n      r := match name {\n        \"checked_floor\" => checked_floor(x),\n        \"checked_ceil\" => checked_ceil(x),\n        _ => checked_round(x),\n      }\n      Ok(eval.option(match r {\n        Some(n) => Some(ast.IntLit(n)),\n        None => None,\n      }))\n    },\n    \"sqrt\" => {\n      f := eval.float_of(a)!\n      match checked_sqrt(f) {\n        Some(r) => Ok(ast.FloatLit(r)),\n        None => Err(eval.runtime(\n          \"sqrt of negative number \" + text.plain_float(f),\n        )),\n      }\n    },\n    \"map\" => {\n      mut out := []\n      for x in eval.list_of(a)! {\n        mut out.push(eval.apply(mut st, w, b, [x])!)\n      }\n      Ok(ast.ListExpr(out))\n    },\n    \"filter\" => {\n      mut out := []\n      for x in eval.list_of(a)! {\n        if eval.truth(eval.apply(mut st, w, b, [x])!)! {\n          mut out.push(x)\n        }\n      }\n      Ok(ast.ListExpr(out))\n    },\n    \"fold\" => {\n      mut acc := b\n      for x in eval.list_of(a)! {\n        acc = eval.apply(mut st, w, c, [acc, x])!\n      }\n      Ok(acc)\n    },\n    \"all\" => {\n      for x in eval.list_of(a)! {\n        if !eval.truth(eval.apply(mut st, w, b, [x])!)! {\n          return Ok(ast.BoolLit(false))\n        }\n      }\n      Ok(ast.BoolLit(true))\n    },\n    \"any\" => {\n      for x in eval.list_of(a)! {\n        if eval.truth(eval.apply(mut st, w, b, [x])!)! {\n          return Ok(ast.BoolLit(true))\n        }\n      }\n      Ok(ast.BoolLit(false))\n    },\n    \"find\" => {\n      for x in eval.list_of(a)! {\n        if eval.truth(eval.apply(mut st, w, b, [x])!)! {\n          return Ok(eval.some(x))\n        }\n      }\n      Ok(eval.none())\n    },\n    \"count\" => {\n      mut n := 0\n      for x in eval.list_of(a)! {\n        if eval.truth(eval.apply(mut st, w, b, [x])!)! {\n          n += 1\n        }\n      }\n      Ok(ast.IntLit(n))\n    },\n    \"push\" => Ok(ast.ListExpr(eval.list_of(a)! + [b])),\n    \"take\" => Ok(ast.ListExpr(take(eval.list_of(a)!, eval.int_of(b)!))),\n    \"drop\" => Ok(ast.ListExpr(drop(eval.list_of(a)!, eval.int_of(b)!))),\n    \"slice\" => Ok(ast.ListExpr(\n      eval.sliced(\n        eval.list_of(a)!,\n        eval.int_of(b)!,\n        eval.int_of(c)!,\n      ),\n    )),\n    \"sum\" => {\n      xs := eval.list_of(a)!\n      match get(xs, 0) {\n        Some(ast.FloatLit(_)) => {\n          mut t := 0.0\n          for x in xs {\n            f := eval.float_of(x)!\n            t = match checked_add(t, f) {\n              Some(r) => r,\n              None => return Err(eval.not_finite(t, \"+\", f)),\n            }\n          }\n          Ok(ast.FloatLit(t))\n        },\n        _ => {\n          mut t := 0\n          for x in xs {\n            t += eval.int_of(x)!\n          }\n          Ok(ast.IntLit(t))\n        },\n      }\n    },\n    \"range\" => Ok(ast.ListExpr(eval.ints(eval.int_of(a)!, eval.int_of(b)!))),\n    \"compare\" => Ok(ast.IntLit(eval.compare(w, a, b))),\n    \"abs\" => match a {\n      ast.FloatLit(f) => Ok(ast.FloatLit(abs(f))),\n      _ => Ok(ast.IntLit(abs(eval.int_of(a)!))),\n    },\n    \"min\" => Ok(if eval.compare(w, b, a) < 0 {\n      b\n    } else {\n      a\n    }),\n    \"max\" => Ok(if eval.compare(w, b, a) > 0 {\n      b\n    } else {\n      a\n    }),\n    // with std.regex's engine, as compiled code\n    \"matches\" => match std.regex.full_match(eval.str_of(a)!, eval.str_of(b)!) {\n      Ok(m) => Ok(ast.BoolLit(m)),\n      Err(e) => Err(eval.runtime(\"bad regex: \" + e)),\n    },\n    \"starts_with\" => Ok(ast.BoolLit(starts_with(eval.str_of(a)!, eval.str_of(b)!))),\n    \"ends_with\" => Ok(ast.BoolLit(ends_with(eval.str_of(a)!, eval.str_of(b)!))),\n    \"chars\" => Ok(eval.str_list(eval.str_of(a)!.chars())),\n    \"index_of\" => Ok(\n      eval.option(match index_of(eval.str_of(a)!, eval.str_of(b)!) {\n        Some(n) => Some(ast.IntLit(n)),\n        None => None,\n      }),\n    ),\n    \"byte_slice\" => Ok(ast.StrLit(\n      byte_slice(eval.str_of(a)!, eval.int_of(b)!, eval.int_of(c)!),\n    )),\n    \"replace\" => Ok(ast.StrLit(\n      replace(eval.str_of(a)!, eval.str_of(b)!, eval.str_of(c)!),\n    )),\n    \"repeat\" => Ok(ast.StrLit(repeat(eval.str_of(a)!, eval.int_of(b)!))),\n    \"to_upper\" => Ok(ast.StrLit(to_upper(eval.str_of(a)!))),\n    \"to_lower\" => Ok(ast.StrLit(to_lower(eval.str_of(a)!))),\n    \"is_digit\" => Ok(ast.BoolLit(is_digit(eval.str_of(a)!))),\n    \"is_alpha\" => Ok(ast.BoolLit(is_alpha(eval.str_of(a)!))),\n    \"is_space\" => Ok(ast.BoolLit(is_space(eval.str_of(a)!))),\n    \"byte_len\" => Ok(ast.IntLit(byte_len(eval.str_of(a)!))),\n    \"byte_at\" => {\n      s := eval.str_of(a)!\n      i := eval.int_of(b)!\n      if i < 0 || i >= byte_len(s) {\n        return Err(eval.runtime(\"byte \"\n          + to_string(i)\n          + \" out of range (length \"\n          + to_string(byte_len(s))\n          + \")\"))\n      }\n      Ok(ast.IntLit(byte_at(s, i)))\n    },\n    \"ord\" => {\n      s := eval.str_of(a)!\n      cps := s.code_points().to_list()\n      match cps {\n        [x] => Ok(ast.IntLit(x)),\n        _ => Err(eval.runtime(\n          \"ord needs a single character, got \" + eval.quoted(s),\n        )),\n      }\n    },\n    \"chr\" => {\n      n := eval.int_of(a)!\n      if n < 0 || n > 1114111 || n >= 55296 && n <= 57343 {\n        return Err(\n          eval.runtime(\n            \"chr: \" + to_string(n) + \" is not a character\",\n          ),\n        )\n      }\n      Ok(ast.StrLit(chr(n)))\n    },\n    _ => Err(eval.runtime(\n      \"the built-in `\" + name + \"` isn't run by this evaluator yet\",\n    )),\n  }\n}"},{"name":"eval.Cursor","kind":"type","old":"2a135a2d6bca618e","new":"b19e86ba0cec3f83","interface_changed":false,"affected":[],"module":"eval","text":"/// A `for` loop's position in what it runs over: a list's elements (a\n/// set's, a dict's entries as pairs), or an iterator, which gives them one\n/// at a time.\ntype Cursor =\n  | Items { items: List[ast.Expr], at: Int }\n  | Pulling(ast.Expr)","old_text":"/// Where a `for` loop is in what it runs over: a list's elements (a set's,\n/// a dict's entries as pairs), or an iterator, which gives them one at a\n/// time.\ntype Cursor =\n  | Items { items: List[ast.Expr], at: Int }\n  | Pulling(ast.Expr)"},{"name":"eval.variant_index","kind":"fn","old":"668db32c8faf0b17","new":"fb303de796502aa9","interface_changed":false,"affected":[],"module":"eval","text":"/// A variant's position in its sum (0 for a record's or a distinct type's\n/// constructor).\nfn variant_index(w: eval.World, name: String) -> Int {\n  match get(w.ctors, name) {\n    Some(t) => match get(w.types, t) {\n      Some(ast.TypeDecl { body: ast.SumBody(vs), .. }) => {\n        for (i, v) in enumerate(vs) {\n          if v.name == eval.short(name) {\n            return i\n          }\n        }\n        0\n      },\n      _ => 0,\n    },\n    None => 0,\n  }\n}","old_text":"/// A variant's position in its sum (0 for a record's or a distinct\n/// type's constructor).\nfn variant_index(w: eval.World, name: String) -> Int {\n  match get(w.ctors, name) {\n    Some(t) => match get(w.types, t) {\n      Some(ast.TypeDecl { body: ast.SumBody(vs), .. }) => {\n        for (i, v) in enumerate(vs) {\n          if v.name == eval.short(name) {\n            return i\n          }\n        }\n        0\n      },\n      _ => 0,\n    },\n    None => 0,\n  }\n}"},{"name":"eval.code","kind":"fn","old":"5b43245852c8235c","new":"38b59f1c48e7b35f","interface_changed":false,"affected":[],"module":"eval","text":"/// A value as code in messages (`Range { lo: 9, hi: 5 }`, `Some(\"a\")`):\n/// `debug`'s form, without a type's own `Debug`.\nfn code(v: ast.Expr) -> String {\n  if eval.word_type(v) is Some {\n    return eval.code(eval.plain(v))\n  }\n  match v {\n    ast.IntLit(n) => to_string(n),\n    ast.FloatLit(f) => eval.shown_float(f),\n    ast.StrLit(s) => eval.quoted(s),\n    ast.BoolLit(b) => to_string(b),\n    ast.UnitExpr => \"()\",\n    ast.TupleExpr(xs) => \"(\" + join(xs.map(x -> eval.code(x)), \", \") + \")\",\n    ast.ListExpr(xs) => \"[\" + join(xs.map(x -> eval.code(x)), \", \") + \"]\",\n    ast.SetExpr { elems, .. } => if len(elems) == 0 {\n      \"Set {}\"\n    } else {\n      \"Set { \" + join(elems.map(x -> eval.code(x)), \", \") + \" }\"\n    },\n    ast.DictExpr { entries, .. } => if len(entries) == 0 {\n      \"Dict {}\"\n    } else {\n      \"Dict { \"\n        + join(\n          entries.map(\n            kv -> eval.code(kv.0) + \": \" + eval.code(kv.1),\n          ),\n          \", \",\n        )\n        + \" }\"\n    },\n    ast.CtorExpr { name, args } => match args {\n      ast.NoArgs => eval.short(name),\n      ast.PositionalArgs(xs) => eval.short(name)\n        + \"(\"\n        + join(xs.map(x -> eval.code(x)), \", \")\n        + \")\",\n      ast.RecordArgs(fs) => if len(fs) == 0 {\n        eval.short(name) + \" {}\"\n      } else {\n        eval.short(name)\n          + \" { \"\n          + join(fs.map(f -> f.0 + \": \" + eval.code(f.1)), \", \")\n          + \" }\"\n      },\n      ast.UpdateArgs { .. } => eval.short(name),\n    },\n    _ => eval.closure_text(v),\n  }\n}","old_text":"/// A value as code, as messages show it (`Range { lo: 9, hi: 5 }`,\n/// `Some(\"a\")`): `debug`'s form, without a type's own `Debug`.\nfn code(v: ast.Expr) -> String {\n  if eval.word_type(v) is Some {\n    return eval.code(eval.plain(v))\n  }\n  match v {\n    ast.IntLit(n) => to_string(n),\n    ast.FloatLit(f) => eval.shown_float(f),\n    ast.StrLit(s) => eval.quoted(s),\n    ast.BoolLit(b) => to_string(b),\n    ast.UnitExpr => \"()\",\n    ast.TupleExpr(xs) => \"(\" + join(xs.map(x -> eval.code(x)), \", \") + \")\",\n    ast.ListExpr(xs) => \"[\" + join(xs.map(x -> eval.code(x)), \", \") + \"]\",\n    ast.SetExpr { elems, .. } => if len(elems) == 0 {\n      \"Set {}\"\n    } else {\n      \"Set { \" + join(elems.map(x -> eval.code(x)), \", \") + \" }\"\n    },\n    ast.DictExpr { entries, .. } => if len(entries) == 0 {\n      \"Dict {}\"\n    } else {\n      \"Dict { \"\n        + join(\n          entries.map(\n            kv -> eval.code(kv.0) + \": \" + eval.code(kv.1),\n          ),\n          \", \",\n        )\n        + \" }\"\n    },\n    ast.CtorExpr { name, args } => match args {\n      ast.NoArgs => eval.short(name),\n      ast.PositionalArgs(xs) => eval.short(name)\n        + \"(\"\n        + join(xs.map(x -> eval.code(x)), \", \")\n        + \")\",\n      ast.RecordArgs(fs) => if len(fs) == 0 {\n        eval.short(name) + \" {}\"\n      } else {\n        eval.short(name)\n          + \" { \"\n          + join(fs.map(f -> f.0 + \": \" + eval.code(f.1)), \", \")\n          + \" }\"\n      },\n      ast.UpdateArgs { .. } => eval.short(name),\n    },\n    _ => eval.closure_text(v),\n  }\n}"},{"name":"eval.power","kind":"fn","old":"fa2b8d4c46dfbde9","new":"e756a200f3d6a4c6","interface_changed":false,"affected":[],"module":"eval","text":"/// `b` to the power `k`, 1 when `k` isn't positive.\nfn power(b: Positive, k: Int) -> Positive {\n  mut r: Positive = 1\n  mut i := 0\n  while i < k {\n    r *= b\n    i += 1\n  }\n  r\n}","old_text":"/// `b` to the power `k` (1 when `k` isn't positive).\nfn power(b: Positive, k: Int) -> Positive {\n  mut r: Positive = 1\n  mut i := 0\n  while i < k {\n    r *= b\n    i += 1\n  }\n  r\n}"},{"name":"eval.not_finite","kind":"fn","old":"f2e72ec9b2da1ab3","new":"e4172949d97d422f","interface_changed":false,"affected":[],"module":"eval","text":"/// The fault of a float operation whose result isn't finite, worded as\n/// compiled code words it.\nfn not_finite(x: Float, op: String, y: Float) -> eval.Escape {\n  eval.runtime(text.plain_float(x)\n    + \" \"\n    + op\n    + \" \"\n    + text.plain_float(y)\n    + \" is not a finite number\")\n}","old_text":"/// The fault of a float operation whose result isn't a finite number, as\n/// compiled code words it.\nfn not_finite(x: Float, op: String, y: Float) -> eval.Escape {\n  eval.runtime(text.plain_float(x)\n    + \" \"\n    + op\n    + \" \"\n    + text.plain_float(y)\n    + \" is not a finite number\")\n}"},{"name":"eval.holds","kind":"fn","old":"964a83cf7f4f6972","new":"e985f6b3132ad178","interface_changed":false,"affected":[],"module":"eval","text":"/// A fault `what: x` unless `x` is true. A comparison shows both sides.\nfn holds(\n  mut st: eval.State,\n  w: eval.World,\n  x: ast.Expr,\n  what: String,\n) -> Result[(), eval.Escape] {\n  match x {\n    ast.Binary { op, left, right } => if op == ast.And || op == ast.Or || op == ast.Implies {\n      eval.asserted(\n        eval.truth(eval.eval(mut st, w, x)!)!,\n        what,\n        x,\n        \"\",\n      )\n    } else {\n      a := eval.eval(mut st, w, left)!\n      b := eval.eval(mut st, w, right)!\n      ok := eval.truth(eval.binary(w, op, a, b)!)!\n      eval.asserted(\n        ok,\n        what,\n        x,\n        \" (left: \" + eval.code(a) + \", right: \" + eval.code(b) + \")\",\n      )\n    },\n    _ => eval.asserted(\n      eval.truth(eval.eval(mut st, w, x)!)!,\n      what,\n      x,\n      \"\",\n    ),\n  }\n}","old_text":"/// A fault `what: x` unless `x` is true; a comparison shows both sides.\nfn holds(\n  mut st: eval.State,\n  w: eval.World,\n  x: ast.Expr,\n  what: String,\n) -> Result[(), eval.Escape] {\n  match x {\n    ast.Binary { op, left, right } => if op == ast.And || op == ast.Or || op == ast.Implies {\n      eval.asserted(\n        eval.truth(eval.eval(mut st, w, x)!)!,\n        what,\n        x,\n        \"\",\n      )\n    } else {\n      a := eval.eval(mut st, w, left)!\n      b := eval.eval(mut st, w, right)!\n      ok := eval.truth(eval.binary(w, op, a, b)!)!\n      eval.asserted(\n        ok,\n        what,\n        x,\n        \" (left: \" + eval.code(a) + \", right: \" + eval.code(b) + \")\",\n      )\n    },\n    _ => eval.asserted(\n      eval.truth(eval.eval(mut st, w, x)!)!,\n      what,\n      x,\n      \"\",\n    ),\n  }\n}"},{"name":"eval.invariants_hold","kind":"fn","old":"fb41c28864583870","new":"53ce965a961bbe3f","interface_changed":false,"affected":[],"module":"eval","text":"/// Checks a loop's `invariant`s at its head: on entry, after every pass\n/// and `continue`, and when it ends normally.\nfn invariants_hold(\n  mut st: eval.State,\n  w: eval.World,\n  body: ast.Expr,\n) -> Result[(), eval.Escape] {\n  for x in text.loop_invariants(body) {\n    eval.holds(mut st, w, x, \"invariant failed\")!\n  }\n  Ok(())\n}","old_text":"/// A loop's `invariant`s, checked at its head: on entry, after every pass\n/// and `continue`, and when it ends normally.\nfn invariants_hold(\n  mut st: eval.State,\n  w: eval.World,\n  body: ast.Expr,\n) -> Result[(), eval.Escape] {\n  for x in text.loop_invariants(body) {\n    eval.holds(mut st, w, x, \"invariant failed\")!\n  }\n  Ok(())\n}"},{"name":"eval.static_call","kind":"fn","old":"4146f0a67fd03fb2","new":"84f33a4995ec5da8","interface_changed":false,"affected":[],"module":"eval","text":"/// `t.name(args)` for a type `t`: its method, or `check` (`Ok(())` when a\n/// value meets the type's refinements, else `Err` with what it breaks).\nfn static_call(\n  mut st: eval.State,\n  w: eval.World,\n  t: ast.TypeExpr,\n  name: String,\n  args: List[ast.Expr],\n) -> Result[ast.Expr, eval.Escape] {\n  (vs, places) := eval.arguments(mut st, w, args)!\n  match eval.method_through(w, t, name, 0) {\n    Some(c) => {\n      r := eval.call(mut st, w, c, vs)!\n      eval.write_back(mut st, w, places, r.1)!\n      Ok(r.0)\n    },\n    None => match (name, vs) {\n      (\"check\", [v]) => match eval.check(mut st, w, t, v, \"\") {\n        Ok(_) => Ok(ast.CtorExpr {\n          name: \"Ok\",\n          args: ast.PositionalArgs([ast.UnitExpr]),\n        }),\n        Err(eval.Fault { kind: \"Refinement\", msg }) => Ok(ast.CtorExpr { name: \"Err\", args: ast.PositionalArgs(\n          [ast.StrLit(byte_slice(msg, 2, byte_len(msg)))],\n        ) }),\n        Err(x) => Err(x),\n      },\n      _ => Err(eval.runtime(\n        \"`\" + text.type_text(t) + \"` has no method `\" + name + \"`\",\n      )),\n    },\n  }\n}","old_text":"fn static_call(\n  mut st: eval.State,\n  w: eval.World,\n  t: ast.TypeExpr,\n  name: String,\n  args: List[ast.Expr],\n) -> Result[ast.Expr, eval.Escape] {\n  (vs, places) := eval.arguments(mut st, w, args)!\n  match eval.method_through(w, t, name, 0) {\n    Some(c) => {\n      r := eval.call(mut st, w, c, vs)!\n      eval.write_back(mut st, w, places, r.1)!\n      Ok(r.0)\n    },\n    None => match (name, vs) {\n      (\"check\", [v]) => match eval.check(mut st, w, t, v, \"\") {\n        Ok(_) => Ok(ast.CtorExpr {\n          name: \"Ok\",\n          args: ast.PositionalArgs([ast.UnitExpr]),\n        }),\n        Err(eval.Fault { kind: \"Refinement\", msg }) => Ok(ast.CtorExpr { name: \"Err\", args: ast.PositionalArgs(\n          [ast.StrLit(byte_slice(msg, 2, byte_len(msg)))],\n        ) }),\n        Err(x) => Err(x),\n      },\n      _ => Err(eval.runtime(\n        \"`\" + text.type_text(t) + \"` has no method `\" + name + \"`\",\n      )),\n    },\n  }\n}"},{"name":"eval.unknown_type","kind":"fn","old":"a1f81db7190e5c14","new":"e9e5b4c5a46eea14","interface_changed":false,"affected":[],"module":"eval","text":"/// The type of an unknown part of a value (an empty list's elements).\nfn unknown_type() -> ast.TypeExpr {\n  ast.Named { name: \"_\", args: [] }\n}","old_text":"/// A type not known from a value (an empty list's elements).\nfn unknown_type() -> ast.TypeExpr {\n  ast.Named { name: \"_\", args: [] }\n}"},{"name":"eval.value_type","kind":"fn","old":"87d25e66b3d7ccec","new":"d8cc27c4c429d6af","interface_changed":false,"affected":[],"module":"eval","text":"/// A value's type, as far as the value shows it. `_` where it doesn't: an\n/// empty list's elements, a `None`'s payload.\nfn value_type(w: eval.World, v: ast.Expr) -> ast.TypeExpr {\n  match v {\n    ast.IntLit(_) | ast.BigIntLit(_) => eval.named0(\"Int\"),\n    ast.FloatLit(_) => eval.named0(\"Float\"),\n    ast.StrLit(_) => eval.named0(\"String\"),\n    ast.BoolLit(_) => eval.named0(\"Bool\"),\n    ast.UnitExpr => ast.UnitType,\n    ast.ListExpr(xs) => ast.Named { name: \"List\", args: [match get(xs, 0) {\n      Some(x) => eval.value_type(w, x),\n      None => eval.unknown_type(),\n    }] },\n    ast.TupleExpr(xs) => ast.Named {\n      name: \"Tuple\",\n      args: xs.map(x -> eval.value_type(w, x)),\n    },\n    ast.SetExpr { elems, .. } => ast.Named { name: \"Set\", args: [match get(elems, 0) {\n      Some(x) => eval.value_type(w, x),\n      None => eval.unknown_type(),\n    }] },\n    ast.DictExpr { entries, .. } => match get(entries, 0) {\n      Some(kv) => ast.Named {\n        name: \"Dict\",\n        args: [eval.value_type(w, kv.0), eval.value_type(w, kv.1)],\n      },\n      None => ast.Named {\n        name: \"Dict\",\n        args: [eval.unknown_type(), eval.unknown_type()],\n      },\n    },\n    ast.CtorExpr { name, args } => {\n      h := get(w.ctors, name) ?? name\n      match get(w.types, h) {\n        Some(td) => if len(td.params) == 0 {\n          eval.named0(h)\n        } else {\n          mut sub := eval.no_types()\n          for fx in eval.fields_of(w, name, args) {\n            sub = eval.matched(\n              fx.1,\n              eval.value_type(w, fx.2),\n              td.params,\n              sub,\n            )\n          }\n          ast.Named {\n            name: h,\n            args: td.params.map(p -> get(sub, p) ?? eval.unknown_type()),\n          }\n        },\n        None => eval.named0(h),\n      }\n    },\n    _ => eval.unknown_type(),\n  }\n}","old_text":"/// A value's type, as far as the value shows it (`_` where it doesn't: an\n/// empty list's elements, a `None`'s).\nfn value_type(w: eval.World, v: ast.Expr) -> ast.TypeExpr {\n  match v {\n    ast.IntLit(_) | ast.BigIntLit(_) => eval.named0(\"Int\"),\n    ast.FloatLit(_) => eval.named0(\"Float\"),\n    ast.StrLit(_) => eval.named0(\"String\"),\n    ast.BoolLit(_) => eval.named0(\"Bool\"),\n    ast.UnitExpr => ast.UnitType,\n    ast.ListExpr(xs) => ast.Named { name: \"List\", args: [match get(xs, 0) {\n      Some(x) => eval.value_type(w, x),\n      None => eval.unknown_type(),\n    }] },\n    ast.TupleExpr(xs) => ast.Named {\n      name: \"Tuple\",\n      args: xs.map(x -> eval.value_type(w, x)),\n    },\n    ast.SetExpr { elems, .. } => ast.Named { name: \"Set\", args: [match get(elems, 0) {\n      Some(x) => eval.value_type(w, x),\n      None => eval.unknown_type(),\n    }] },\n    ast.DictExpr { entries, .. } => match get(entries, 0) {\n      Some(kv) => ast.Named {\n        name: \"Dict\",\n        args: [eval.value_type(w, kv.0), eval.value_type(w, kv.1)],\n      },\n      None => ast.Named {\n        name: \"Dict\",\n        args: [eval.unknown_type(), eval.unknown_type()],\n      },\n    },\n    ast.CtorExpr { name, args } => {\n      h := get(w.ctors, name) ?? name\n      match get(w.types, h) {\n        Some(td) => if len(td.params) == 0 {\n          eval.named0(h)\n        } else {\n          mut sub := eval.no_types()\n          for fx in eval.fields_of(w, name, args) {\n            sub = eval.matched(\n              fx.1,\n              eval.value_type(w, fx.2),\n              td.params,\n              sub,\n            )\n          }\n          ast.Named {\n            name: h,\n            args: td.params.map(p -> get(sub, p) ?? eval.unknown_type()),\n          }\n        },\n        None => eval.named0(h),\n      }\n    },\n    _ => eval.unknown_type(),\n  }\n}"},{"name":"eval.matched","kind":"fn","old":"504ae757b0c4fe49","new":"0083520c38600846","interface_changed":false,"affected":[],"module":"eval","text":"/// `sub` with each type parameter of `vars` that `pattern` names bound to\n/// the type `actual` has in its place, unless already bound or unknown.\nfn matched(\n  pattern: ast.TypeExpr,\n  actual: ast.TypeExpr,\n  vars: List[String],\n  sub: Dict[String, ast.TypeExpr],\n) -> Dict[String, ast.TypeExpr] {\n  match (pattern, actual) {\n    (ast.Named { name, args: [] }, _) => if contains(vars, name) {\n      if contains(sub, name) || eval.has_unknown(actual) {\n        sub\n      } else {\n        mut copy := sub\n        mut copy.insert(name, actual)\n        copy\n      }\n    } else {\n      sub\n    },\n    (ast.Named { name: a, args: xs }, ast.Named { name: b, args: ys }) => if a == b && len(xs) == len(ys) {\n      mut out := sub\n      for (x, y) in zip(xs, ys) {\n        out = eval.matched(x, y, vars, out)\n      }\n      out\n    } else {\n      sub\n    },\n    (ast.FnType { params: xs, ret: r }, ast.FnType { params: ys, ret: q }) => {\n      mut out := sub\n      for (x, y) in zip(xs, ys) {\n        out = eval.matched(x, y, vars, out)\n      }\n      eval.matched(r, q, vars, out)\n    },\n    (ast.Refined { base, .. }, _) => eval.matched(base, actual, vars, sub),\n    _ => sub,\n  }\n}","old_text":"/// `sub` with each of the type parameters `vars` that `pattern` names bound\n/// to the type `actual` has in its place (unless bound already or not known).\nfn matched(\n  pattern: ast.TypeExpr,\n  actual: ast.TypeExpr,\n  vars: List[String],\n  sub: Dict[String, ast.TypeExpr],\n) -> Dict[String, ast.TypeExpr] {\n  match (pattern, actual) {\n    (ast.Named { name, args: [] }, _) => if contains(vars, name) {\n      if contains(sub, name) || eval.has_unknown(actual) {\n        sub\n      } else {\n        mut copy := sub\n        mut copy.insert(name, actual)\n        copy\n      }\n    } else {\n      sub\n    },\n    (ast.Named { name: a, args: xs }, ast.Named { name: b, args: ys }) => if a == b && len(xs) == len(ys) {\n      mut out := sub\n      for (x, y) in zip(xs, ys) {\n        out = eval.matched(x, y, vars, out)\n      }\n      out\n    } else {\n      sub\n    },\n    (ast.FnType { params: xs, ret: r }, ast.FnType { params: ys, ret: q }) => {\n      mut out := sub\n      for (x, y) in zip(xs, ys) {\n        out = eval.matched(x, y, vars, out)\n      }\n      eval.matched(r, q, vars, out)\n    },\n    (ast.Refined { base, .. }, _) => eval.matched(base, actual, vars, sub),\n    _ => sub,\n  }\n}"},{"name":"eval.bound","kind":"fn","old":"b49cdde3501cf3e6","new":"481268ff9fe4a938","interface_changed":false,"affected":[],"module":"eval","text":"/// What an `impl`'s type parameters and `Self` stand for, called on a value\n/// of type `at`.\nfn bound(i: ast.ImplDecl, at: ast.TypeExpr) -> Dict[String, ast.TypeExpr] {\n  sub := eval.matched(i.for_type, at, i.type_params, eval.no_types())\n  if eval.has_unknown(at) || at == ast.UnitType {\n    sub\n  } else {\n    mut copy := sub\n    mut copy.insert(\"Self\", at)\n    copy\n  }\n}","old_text":"/// What an `impl`'s type parameters (and `Self`) stand for, called on a\n/// value of type `at`.\nfn bound(i: ast.ImplDecl, at: ast.TypeExpr) -> Dict[String, ast.TypeExpr] {\n  sub := eval.matched(i.for_type, at, i.type_params, eval.no_types())\n  if eval.has_unknown(at) || at == ast.UnitType {\n    sub\n  } else {\n    mut copy := sub\n    mut copy.insert(\"Self\", at)\n    copy\n  }\n}"},{"name":"eval.world","kind":"fn","old":"902f9c3b87a3b760","new":"d46cbb17ea0cee86","interface_changed":false,"affected":[],"module":"eval","text":"// ---------------- running ----------------\n\n/// The program's definitions, desugared, ready to run.\npub fn world(decls: List[ast.Decl]) -> eval.World {\n  eval.index(desugar.desugar(decls).0)\n}","old_text":"// ---------------- running ----------------\n\n/// The program's definitions, as code is run with them (without sugar).\npub fn world(decls: List[ast.Decl]) -> eval.World {\n  eval.index(desugar.desugar(decls).0)\n}"},{"name":"eval.value_in","kind":"fn","old":"b8c957b93a7b1395","new":"10f39e4d366b8f01","interface_changed":false,"affected":[],"module":"eval","text":"/// The value of `e` run in `module` with the program's definitions, or the\n/// fault that stopped it. Compile-time code: no capabilities, no\n/// arguments.\npub fn value_in(\n  w: eval.World,\n  module: String,\n  e: ast.Expr,\n) -> Result[ast.Expr, String] {\n  mut st := eval.State {\n    scopes: [eval.no_scope()],\n    module,\n    out: \"\",\n    err: \"\",\n    args: [],\n    depth: 0,\n    tenv: eval.no_types(),\n    expect: None,\n    receiver: None,\n    files: None,\n  }\n  match eval.eval(mut st, w, e) {\n    Ok(v) => Ok(v),\n    Err(eval.Returned(v)) => Ok(v),\n    Err(eval.Fault { msg, .. }) => Err(msg),\n    Err(_) => Err(\"`break` or `continue` outside a loop\"),\n  }\n}","old_text":"/// The value of `e`, run with the program's definitions in module\n/// `module` (compile-time code: no capabilities, no arguments), or the\n/// fault that stopped it.\npub fn value_in(\n  w: eval.World,\n  module: String,\n  e: ast.Expr,\n) -> Result[ast.Expr, String] {\n  mut st := eval.State {\n    scopes: [eval.no_scope()],\n    module,\n    out: \"\",\n    err: \"\",\n    args: [],\n    depth: 0,\n    tenv: eval.no_types(),\n    expect: None,\n    receiver: None,\n    files: None,\n  }\n  match eval.eval(mut st, w, e) {\n    Ok(v) => Ok(v),\n    Err(eval.Returned(v)) => Ok(v),\n    Err(eval.Fault { msg, .. }) => Err(msg),\n    Err(_) => Err(\"`break` or `continue` outside a loop\"),\n  }\n}"},{"name":"eval.expecting","kind":"fn","old":"35558bf68108f8da","new":"c2e4ee85ec4645ad","interface_changed":false,"affected":[],"module":"eval","text":"/// Runs the call `e` expecting a result of type `t`, which tells the callee\n/// what its type parameters stand for. The arguments are run first, so only\n/// the call itself sees `t`.\nfn expecting(\n  mut st: eval.State,\n  w: eval.World,\n  e: ast.Expr,\n  t: Option[ast.TypeExpr],\n  recv_type: Option[ast.TypeExpr],\n) -> Result[ast.Expr, eval.Escape] {\n  match e {\n    ast.Call { callee, args } => if args.any(a -> a is ast.MutExpr) {\n      eval.eval(mut st, w, e)\n    } else {\n      vs := eval.eval_all(mut st, w, args)!\n      st.expect = t\n      r := eval.call_expr(mut st, w, callee, vs)\n      st.expect = None\n      r\n    },\n    ast.MethodCall { recv, name, args } => if args.any(a -> a is ast.MutExpr) {\n      eval.eval(mut st, w, e)\n    } else {\n      r0 := if eval.is_place(recv) {\n        recv\n      } else {\n        match recv {\n          ast.CtorExpr { args: ast.NoArgs, .. } | ast.Block { .. } => recv,\n          _ => eval.eval(mut st, w, recv)!,\n        }\n      }\n      vs := eval.eval_all(mut st, w, args)!\n      st.expect = t\n      st.receiver = recv_type\n      r := eval.method_call(mut st, w, r0, name, vs)\n      st.expect = None\n      st.receiver = None\n      r\n    },\n    _ => eval.eval(mut st, w, e),\n  }\n}","old_text":"/// `e` (a call) run expecting its result to be of type `t`, which tells the\n/// callee what its type parameters stand for. The arguments are run first,\n/// so only the call itself sees `t`.\nfn expecting(\n  mut st: eval.State,\n  w: eval.World,\n  e: ast.Expr,\n  t: Option[ast.TypeExpr],\n  recv_type: Option[ast.TypeExpr],\n) -> Result[ast.Expr, eval.Escape] {\n  match e {\n    ast.Call { callee, args } => if args.any(a -> a is ast.MutExpr) {\n      eval.eval(mut st, w, e)\n    } else {\n      vs := eval.eval_all(mut st, w, args)!\n      st.expect = t\n      r := eval.call_expr(mut st, w, callee, vs)\n      st.expect = None\n      r\n    },\n    ast.MethodCall { recv, name, args } => if args.any(a -> a is ast.MutExpr) {\n      eval.eval(mut st, w, e)\n    } else {\n      r0 := if eval.is_place(recv) {\n        recv\n      } else {\n        match recv {\n          ast.CtorExpr { args: ast.NoArgs, .. } | ast.Block { .. } => recv,\n          _ => eval.eval(mut st, w, recv)!,\n        }\n      }\n      vs := eval.eval_all(mut st, w, args)!\n      st.expect = t\n      st.receiver = recv_type\n      r := eval.method_call(mut st, w, r0, name, vs)\n      st.expect = None\n      st.receiver = None\n      r\n    },\n    _ => eval.eval(mut st, w, e),\n  }\n}"},{"name":"eval.is_place","kind":"fn","old":"cb8afb00d4c57edd","new":"80813d132bca727d","interface_changed":false,"affected":[],"module":"eval","text":"/// Whether `e` names a place (a variable or a field of one), so running it\n/// runs no call.\nfn is_place(e: ast.Expr) -> Bool {\n  match e {\n    ast.Var(_) => true,\n    ast.FieldOf { base, .. } => eval.is_place(base),\n    ast.MutExpr(x) => eval.is_place(x),\n    _ => false,\n  }\n}","old_text":"/// Whether `e` names a place (a variable or a field of one): running it\n/// runs no call.\nfn is_place(e: ast.Expr) -> Bool {\n  match e {\n    ast.Var(_) => true,\n    ast.FieldOf { base, .. } => eval.is_place(base),\n    ast.MutExpr(x) => eval.is_place(x),\n    _ => false,\n  }\n}"},{"name":"eval.method_through","kind":"fn","old":"485bc1e9fc458e83","new":"fb250ccd7ba161c9","interface_changed":false,"affected":[],"module":"eval","text":"/// Method `name` of type `t`, or of the type alias `t` stands for\n/// (`Many[Int]` is a `List[Int]`), with `Self` kept as `t`.\nfn method_through(\n  w: eval.World,\n  t: ast.TypeExpr,\n  name: String,\n  depth: Int,\n) -> Option[eval.Callee] {\n  match eval.method_for(w, eval.type_head(t), name, t) {\n    Some(c) => Some(c),\n    None => if depth > 20 {\n      None\n    } else {\n      match t {\n        ast.Named { name: n, args } => match get(w.types, n) {\n          Some(td) => if td.distinct {\n            None\n          } else {\n            match td.body {\n              ast.Alias(a) => match eval.method_through(\n                w,\n                eval.substitute(a, dict(zip(td.params, args))),\n                name,\n                depth + 1,\n              ) {\n                Some(c) => Some(eval.self_as(c, t)),\n                None => None,\n              },\n              _ => None,\n            }\n          },\n          None => None,\n        },\n        _ => None,\n      }\n    },\n  }\n}","old_text":"/// `t.name(args)` for a type `t`: its method, or `check` (`Ok(())` when a\n/// value meets the type's refinements, else `Err` with what it breaks).\n/// Method `name` of type `t`, or of what `t` stands for if it is an alias\n/// (`Many[Int]` is a `List[Int]`): `Self` stays `t`.\nfn method_through(\n  w: eval.World,\n  t: ast.TypeExpr,\n  name: String,\n  depth: Int,\n) -> Option[eval.Callee] {\n  match eval.method_for(w, eval.type_head(t), name, t) {\n    Some(c) => Some(c),\n    None => if depth > 20 {\n      None\n    } else {\n      match t {\n        ast.Named { name: n, args } => match get(w.types, n) {\n          Some(td) => if td.distinct {\n            None\n          } else {\n            match td.body {\n              ast.Alias(a) => match eval.method_through(\n                w,\n                eval.substitute(a, dict(zip(td.params, args))),\n                name,\n                depth + 1,\n              ) {\n                Some(c) => Some(eval.self_as(c, t)),\n                None => None,\n              },\n              _ => None,\n            }\n          },\n          None => None,\n        },\n        _ => None,\n      }\n    },\n  }\n}"},{"name":"eval.self_as","kind":"fn","old":"96544d8ca0f4ec7d","new":"70745b98e901402c","interface_changed":false,"affected":[],"module":"eval","text":"/// `c` called on `t`, its `Self`.\nfn self_as(c: eval.Callee, t: ast.TypeExpr) -> eval.Callee {\n  eval.Callee { ..c, tenv: {\n    mut copy := c.tenv\n    mut copy.insert(\"Self\", t)\n    copy\n  } }\n}","old_text":"/// `c` called on `t` (its `Self`).\nfn self_as(c: eval.Callee, t: ast.TypeExpr) -> eval.Callee {\n  eval.Callee { ..c, tenv: {\n    mut copy := c.tenv\n    mut copy.insert(\"Self\", t)\n    copy\n  } }\n}"},{"name":"eval.method_typed","kind":"fn","old":"ac23f98e849aeed4","new":"a6821ba116f21a4f","interface_changed":false,"affected":[],"module":"eval","text":"/// `method_of`, with the value's type `at`.\nfn method_typed(\n  w: eval.World,\n  v: ast.Expr,\n  m: String,\n  at: ast.TypeExpr,\n) -> Option[eval.Callee] {\n  h := eval.head_of(w, v)\n  own := match v {\n    ast.CtorExpr { name, .. } => name,\n    _ => h,\n  }\n  match eval.method_for(w, own, m, at) {\n    Some(c) => Some(c),\n    None => if own != h {\n      eval.method_for(w, h, m, at)\n    } else {\n      None\n    },\n  }\n}","old_text":"/// `method_of`, the value's type being `at`.\nfn method_typed(\n  w: eval.World,\n  v: ast.Expr,\n  m: String,\n  at: ast.TypeExpr,\n) -> Option[eval.Callee] {\n  h := eval.head_of(w, v)\n  own := match v {\n    ast.CtorExpr { name, .. } => name,\n    _ => h,\n  }\n  match eval.method_for(w, own, m, at) {\n    Some(c) => Some(c),\n    None => if own != h {\n      eval.method_for(w, h, m, at)\n    } else {\n      None\n    },\n  }\n}"},{"name":"eval.annotated_call","kind":"fn","old":"df298fcbfecdac9f","new":"8375e9819e277009","interface_changed":false,"affected":[],"module":"eval","text":"/// The call `check.instantiated` wrapped with its types (`{ $recv: R := ();\n/// $result: T := call; $result }`): the call, its result type and its\n/// receiver type.\nfn annotated_call(\n  stmts: List[ast.Stmt],\n) -> Option[(ast.Expr, Option[ast.TypeExpr], Option[ast.TypeExpr])] {\n  match stmts {\n    [ast.Let { pat: ast.Bind(\"$result\"), ty, value }] => Some((value, ty, None)),\n    [ast.Let { pat: ast.Bind(\"$recv\"), ty: rt, .. }, ast.Let { pat: ast.Bind(\"$result\"), ty, value }] => Some((value, ty, rt)),\n    _ => None,\n  }\n}","old_text":"/// The call `check.instantiated` wrote its types around (`{ $recv: R := ();\n/// $result: T := call; $result }`): the call, its result's type and its\n/// receiver's.\nfn annotated_call(\n  stmts: List[ast.Stmt],\n) -> Option[(ast.Expr, Option[ast.TypeExpr], Option[ast.TypeExpr])] {\n  match stmts {\n    [ast.Let { pat: ast.Bind(\"$result\"), ty, value }] => Some((value, ty, None)),\n    [ast.Let { pat: ast.Bind(\"$recv\"), ty: rt, .. }, ast.Let { pat: ast.Bind(\"$result\"), ty, value }] => Some((value, ty, rt)),\n    _ => None,\n  }\n}"},{"name":"eval.options_error","kind":"fn","old":"34cbf5503c3fb723","new":"4bc3671df176e7e3","interface_changed":false,"affected":[],"module":"eval","text":"/// The run's end when the options couldn't be read (`e`, a `CliError`):\n/// help asked for goes to stdout (exit 0), a wrong argument to stderr\n/// (exit 2), as a compiled program ends.\nfn options_error(st: eval.State, e: ast.Expr) -> eval.Run {\n  (help, text) := match e {\n    ast.CtorExpr { name, args: ast.RecordArgs([(_, ast.StrLit(t))]) } => (eval.short(name) == \"ShowHelp\", t),\n    ast.CtorExpr { name, args: ast.PositionalArgs([ast.StrLit(t)]) } => (eval.short(name) == \"ShowHelp\", t),\n    _ => (false, \"the options couldn't be read\"),\n  }\n  if help {\n    eval.Run {\n      stdout: st.out\n        + std.cli.styled_help(\n          text,\n          std.term.Paint { on: st.colors.0 },\n        ),\n      stderr: st.err,\n      code: 0,\n    }\n  } else {\n    eval.Run { stdout: st.out, stderr: st.err\n      + std.cli.error_line(text, std.term.Paint { on: st.colors.1 })\n      + \"\\n\", code: 2 }\n  }\n}","old_text":"/// The options couldn't be read (`e`, a `CliError`): the help asked for, on\n/// standard output (exit 0), or what is wrong with the arguments, on\n/// standard error (exit 2), as a compiled program ends.\nfn options_error(st: eval.State, e: ast.Expr) -> eval.Run {\n  (help, text) := match e {\n    ast.CtorExpr { name, args: ast.RecordArgs([(_, ast.StrLit(t))]) } => (eval.short(name) == \"ShowHelp\", t),\n    ast.CtorExpr { name, args: ast.PositionalArgs([ast.StrLit(t)]) } => (eval.short(name) == \"ShowHelp\", t),\n    _ => (false, \"the options couldn't be read\"),\n  }\n  if help {\n    eval.Run {\n      stdout: st.out\n        + std.cli.styled_help(\n          text,\n          std.term.Paint { on: st.colors.0 },\n        ),\n      stderr: st.err,\n      code: 0,\n    }\n  } else {\n    eval.Run { stdout: st.out, stderr: st.err\n      + std.cli.error_line(text, std.term.Paint { on: st.colors.1 })\n      + \"\\n\", code: 2 }\n  }\n}"},{"name":"eval.host_files","kind":"fn","old":"ae253bfbff6c487f","new":"d7138889b95f923e","interface_changed":false,"affected":[],"module":"eval","text":"/// A file-reading built-in on `fs`, as the runtime gives it: `Ok(value)`,\n/// or the failure's kind and message (`std.fs.fs_error` makes the\n/// `FsError`).\nfn host_files(\n  fs: std.fs.Files,\n  name: String,\n  path: String,\n) -> Result[ast.Expr, eval.Escape] {\n  match name {\n    \"host_exists\" => Ok(ast.BoolLit(fs.exists(path))),\n    \"host_read_file\" => Ok(match fs.read(path) {\n      Ok(t) => eval.fs_result(Ok(ast.StrLit(t))),\n      Err(e) => eval.fs_result(Err(e)),\n    }),\n    \"host_read_bytes\" => Ok(match fs.read_bytes(path) {\n      Ok(bs) => eval.fs_result(Ok(ast.ListExpr(bs.map(b -> ast.IntLit(b))))),\n      Err(e) => eval.fs_result(Err(e)),\n    }),\n    _ => Ok(match fs.list(path) {\n      Ok(ns) => eval.fs_result(Ok(eval.str_list(ns))),\n      Err(e) => eval.fs_result(Err(e)),\n    }),\n  }\n}","old_text":"/// A reading built-in on `fs`, as the runtime gives it: `Ok(value)`, or the\n/// failure's kind and message (`std.fs.fs_error` makes the `FsError`).\nfn host_files(\n  fs: std.fs.Files,\n  name: String,\n  path: String,\n) -> Result[ast.Expr, eval.Escape] {\n  match name {\n    \"host_exists\" => Ok(ast.BoolLit(fs.exists(path))),\n    \"host_read_file\" => Ok(match fs.read(path) {\n      Ok(t) => eval.fs_result(Ok(ast.StrLit(t))),\n      Err(e) => eval.fs_result(Err(e)),\n    }),\n    \"host_read_bytes\" => Ok(match fs.read_bytes(path) {\n      Ok(bs) => eval.fs_result(Ok(ast.ListExpr(bs.map(b -> ast.IntLit(b))))),\n      Err(e) => eval.fs_result(Err(e)),\n    }),\n    _ => Ok(match fs.list(path) {\n      Ok(ns) => eval.fs_result(Ok(eval.str_list(ns))),\n      Err(e) => eval.fs_result(Err(e)),\n    }),\n  }\n}"},{"name":"eval.is_sized","kind":"fn","old":"ed702710da805358","new":"2fcdd76834b77af1","interface_changed":false,"affected":[],"module":"eval","text":"// ---------------- sized integers ----------------\n//\n// A value of a sized integer type (`I8` … `U64`) is `U32(5)`. It is made by\n// the conversions (`to_u32`, `wrap_u32`) and where a declared type says so\n// (a parameter, a result, an annotated variable, a field). An operation on\n// one is `Int`'s, then the result modulo 2^bits, as in compiled code.\n\nfn is_sized(n: String) -> Bool {\n  [\"I8\", \"I16\", \"I32\", \"I64\", \"U8\", \"U16\", \"U32\", \"U64\"].contains(n)\n}","old_text":"// ---------------- sized integers ----------------\n//\n// A value of a sized integer type (`I8` … `U64`) is `U32(5)`: made by the\n// conversions (`to_u32`, `wrap_u32`) and where a declared type says so (a\n// parameter, a result, an annotated variable, a field). An operation with one\n// is `Int`'s, then the result modulo 2^bits, as compiled code computes it.\n\nfn is_sized(n: String) -> Bool {\n  [\"I8\", \"I16\", \"I32\", \"I64\", \"U8\", \"U16\", \"U32\", \"U64\"].contains(n)\n}"},{"name":"eval.word","kind":"fn","old":"9b556d82e32bdcb1","new":"689c72196af57838","interface_changed":false,"affected":[],"module":"eval","text":"/// `n` modulo 2^bits as a value of the sized type `name`, two's complement\n/// for a signed one.\nfn word(name: String, n: Int) -> ast.Expr {\n  bits := eval.sized_bits(name)\n  m := n % (1 << bits)\n  v := if eval.sized_signed(name) && m >= 1 << bits - 1 {\n    m - (1 << bits)\n  } else {\n    m\n  }\n  ast.CtorExpr { name, args: ast.PositionalArgs([ast.IntLit(v)]) }\n}","old_text":"/// `n` modulo 2^bits, as a value of the sized type `name` (two's complement\n/// for a signed one).\nfn word(name: String, n: Int) -> ast.Expr {\n  bits := eval.sized_bits(name)\n  m := n % (1 << bits)\n  v := if eval.sized_signed(name) && m >= 1 << bits - 1 {\n    m - (1 << bits)\n  } else {\n    m\n  }\n  ast.CtorExpr { name, args: ast.PositionalArgs([ast.IntLit(v)]) }\n}"},{"name":"eval.typed","kind":"fn","old":"8788cde1eb4e3040","new":"bea28a41a50fd099","interface_changed":false,"affected":[],"module":"eval","text":"/// A value at a place of written type `t`. An integer where the type is\n/// sized becomes one, inside lists, options and tuples too.\nfn typed(t: ast.TypeExpr, v: ast.Expr) -> ast.Expr {\n  match t {\n    ast.Refined { base, .. } => eval.typed(base, v),\n    ast.Named { name, args } => match v {\n      ast.IntLit(n) => if eval.is_sized(name) && len(args) == 0 {\n        eval.word(name, n)\n      } else {\n        v\n      },\n      ast.ListExpr(xs) => if name == \"List\" && len(args) == 1 {\n        ast.ListExpr(\n          xs.map(x -> eval.typed(get(args, 0) ?? ast.UnitType, x)),\n        )\n      } else {\n        v\n      },\n      ast.TupleExpr(xs) => if name == \"Tuple\" && len(args) == len(xs) {\n        ast.TupleExpr(\n          [eval.typed(get(args, k) ?? ast.UnitType, x) for (k, x) in enumerate(xs)],\n        )\n      } else {\n        v\n      },\n      ast.CtorExpr { name: c, args: ast.PositionalArgs([x]) } => if name == \"Option\" && c == \"Some\" && len(args) == 1 {\n        ast.CtorExpr { name: c, args: ast.PositionalArgs(\n          [eval.typed(get(args, 0) ?? ast.UnitType, x)],\n        ) }\n      } else {\n        v\n      },\n      _ => v,\n    },\n    _ => v,\n  }\n}","old_text":"/// A value at a place of written type `t`: an integer there of a sized type\n/// becomes one, in lists, options and tuples too.\nfn typed(t: ast.TypeExpr, v: ast.Expr) -> ast.Expr {\n  match t {\n    ast.Refined { base, .. } => eval.typed(base, v),\n    ast.Named { name, args } => match v {\n      ast.IntLit(n) => if eval.is_sized(name) && len(args) == 0 {\n        eval.word(name, n)\n      } else {\n        v\n      },\n      ast.ListExpr(xs) => if name == \"List\" && len(args) == 1 {\n        ast.ListExpr(\n          xs.map(x -> eval.typed(get(args, 0) ?? ast.UnitType, x)),\n        )\n      } else {\n        v\n      },\n      ast.TupleExpr(xs) => if name == \"Tuple\" && len(args) == len(xs) {\n        ast.TupleExpr(\n          [eval.typed(get(args, k) ?? ast.UnitType, x) for (k, x) in enumerate(xs)],\n        )\n      } else {\n        v\n      },\n      ast.CtorExpr { name: c, args: ast.PositionalArgs([x]) } => if name == \"Option\" && c == \"Some\" && len(args) == 1 {\n        ast.CtorExpr { name: c, args: ast.PositionalArgs(\n          [eval.typed(get(args, 0) ?? ast.UnitType, x)],\n        ) }\n      } else {\n        v\n      },\n      _ => v,\n    },\n    _ => v,\n  }\n}"},{"name":"eval.conversion","kind":"fn","old":"2cfcda486b8b1192","new":"80716a7b9f3b1811","interface_changed":false,"affected":[],"module":"eval","text":"/// `to_int`, `to_u32` (`n` must fit), `wrap_u32` and the like. `None` for\n/// any other built-in.\nfn conversion(\n  name: String,\n  a: ast.Expr,\n) -> Option[Result[ast.Expr, eval.Escape]] {\n  if name == \"to_int\" && eval.word_type(a) is Some {\n    return Some(Ok(eval.plain(a)))\n  }\n  for t in [\"I8\", \"I16\", \"I32\", \"I64\", \"U8\", \"U16\", \"U32\", \"U64\"] {\n    if name == \"wrap_\" + to_lower(t) {\n      return Some(match a {\n        ast.IntLit(n) => Ok(eval.word(t, n)),\n        _ => Err(eval.runtime(\"expected an Int, got \" + eval.code(a))),\n      })\n    }\n    if name == \"to_\" + to_lower(t) {\n      return Some(match a {\n        ast.IntLit(n) => if eval.plain(eval.word(t, n)) == ast.IntLit(n) {\n          Ok(eval.word(t, n))\n        } else {\n          Err(eval.runtime(\n            \"`\" + to_string(n) + \"` doesn't fit in `\" + t + \"`\",\n          ))\n        },\n        _ => Err(eval.runtime(\"expected an Int, got \" + eval.code(a))),\n      })\n    }\n  }\n  None\n}","old_text":"/// `to_int`, `to_u32` (`n` must fit) and `wrap_u32` and the like; `None` for\n/// any other built-in.\nfn conversion(\n  name: String,\n  a: ast.Expr,\n) -> Option[Result[ast.Expr, eval.Escape]] {\n  if name == \"to_int\" && eval.word_type(a) is Some {\n    return Some(Ok(eval.plain(a)))\n  }\n  for t in [\"I8\", \"I16\", \"I32\", \"I64\", \"U8\", \"U16\", \"U32\", \"U64\"] {\n    if name == \"wrap_\" + to_lower(t) {\n      return Some(match a {\n        ast.IntLit(n) => Ok(eval.word(t, n)),\n        _ => Err(eval.runtime(\"expected an Int, got \" + eval.code(a))),\n      })\n    }\n    if name == \"to_\" + to_lower(t) {\n      return Some(match a {\n        ast.IntLit(n) => if eval.plain(eval.word(t, n)) == ast.IntLit(n) {\n          Ok(eval.word(t, n))\n        } else {\n          Err(eval.runtime(\n            \"`\" + to_string(n) + \"` doesn't fit in `\" + t + \"`\",\n          ))\n        },\n        _ => Err(eval.runtime(\"expected an Int, got \" + eval.code(a))),\n      })\n    }\n  }\n  None\n}"},{"name":"eval.stepped","kind":"fn","old":"d5aa3a3503d9ec55","new":"365eb763fade23d1","interface_changed":false,"affected":[],"module":"eval","text":"/// Counts a loop pass or a call. Past `step_budget` the run stops.\nfn stepped(mut st: eval.State) -> Result[(), eval.Escape] {\n  st.steps += 1\n  if st.steps > eval.step_budget() {\n    Err(eval.fault(\"Limit\", \"too many steps\"))\n  } else {\n    Ok(())\n  }\n}","old_text":"/// A loop pass or a call, counted: past `step_budget` the run stops.\nfn stepped(mut st: eval.State) -> Result[(), eval.Escape] {\n  st.steps += 1\n  if st.steps > eval.step_budget() {\n    Err(eval.fault(\"Limit\", \"too many steps\"))\n  } else {\n    Ok(())\n  }\n}"},{"name":"eval.step_budget","kind":"fn","old":"45f8c6c1fe3d2e19","new":"0e13e374a0bec85e","interface_changed":false,"affected":[],"module":"eval","text":"/// How many loop passes and calls a run may take, the same budget compiled\n/// compile-time code has.\nfn step_budget() -> Int {\n  5000000\n}","old_text":"/// How many loop passes and calls a run may take (compile-time code's\n/// budget, as `strata`'s compiled code has it).\nfn step_budget() -> Int {\n  5000000\n}"},{"name":"eval.set_put","kind":"fn","old":"44b5b4cc60323fb0","new":"eb9985376bb6c481","interface_changed":false,"affected":[],"module":"eval","text":"/// `xs` with `x` appended, unless it has it already (`compare` 0).\n/// Sets and dicts mirror compiled code's hash tables (runtime.c's\n/// `strata_tbl_…`) without hashing. Entries stay in insertion order with\n/// each key once: a set keeps the first of equal elements, a dict the last\n/// value of a key at the position where the key first came. A removal\n/// closes the gap. So iteration order depends only on what was done to the\n/// table, and matches compiled code.\nfn set_put(w: eval.World, xs: List[ast.Expr], x: ast.Expr) -> List[ast.Expr] {\n  if xs.any(y -> eval.compare(w, x, y) == 0) {\n    xs\n  } else {\n    xs + [x]\n  }\n}","old_text":"/// `xs` with `x` after the others, unless it has it (`compare` 0). Sets and\n/// dicts are hash tables in compiled code (runtime.c's `strata_tbl_…`):\n/// their entries in the order they came in, a key once (a set keeps the\n/// first of equal elements; a dict the last value of a key, where the key\n/// first came), a removal closing the gap. The evaluator keeps its entries\n/// the same way, so it shows them in the same order, with no hashing: the\n/// order depends only on what was done to the table.\nfn set_put(w: eval.World, xs: List[ast.Expr], x: ast.Expr) -> List[ast.Expr] {\n  if xs.any(y -> eval.compare(w, x, y) == 0) {\n    xs\n  } else {\n    xs + [x]\n  }\n}"},{"name":"eval.sorted_values","kind":"fn","old":"25998db6dc9a4aa5","new":"515b7a37ae2121eb","interface_changed":false,"affected":[],"module":"eval","text":"/// `xs` sorted by `compare`, stable.\nfn sorted_values(w: eval.World, xs: List[ast.Expr]) -> List[ast.Expr] {\n  n := len(xs)\n  if n < 2 {\n    return xs\n  }\n  mut l := eval.sorted_values(w, take(xs, n / 2))\n  mut r := eval.sorted_values(w, drop(xs, n / 2))\n  mut out := []\n  loop {\n    match (l, r) {\n      ([a, ..ls], [b, ..rs]) => if eval.compare(w, b, a) < 0 {\n        mut out.push(b)\n        r = rs\n      } else {\n        mut out.push(a)\n        l = ls\n      },\n      ([], _) => return out + r,\n      (_, []) => return out + l,\n    }\n  }\n  out\n}","old_text":"/// `xs` sorted by `compare` (stable).\nfn sorted_values(w: eval.World, xs: List[ast.Expr]) -> List[ast.Expr] {\n  n := len(xs)\n  if n < 2 {\n    return xs\n  }\n  mut l := eval.sorted_values(w, take(xs, n / 2))\n  mut r := eval.sorted_values(w, drop(xs, n / 2))\n  mut out := []\n  loop {\n    match (l, r) {\n      ([a, ..ls], [b, ..rs]) => if eval.compare(w, b, a) < 0 {\n        mut out.push(b)\n        r = rs\n      } else {\n        mut out.push(a)\n        l = ls\n      },\n      ([], _) => return out + r,\n      (_, []) => return out + l,\n    }\n  }\n  out\n}"},{"name":"eval.canonical","kind":"fn","old":"f35452da113562cf","new":"8fa7ebb660d0a6ad","interface_changed":false,"affected":[],"module":"eval","text":"/// `v` with every set's and dict's entries sorted by `compare`, nested ones\n/// too. This is what `==` compares, as a table's order is not part of its\n/// value.\nfn canonical(w: eval.World, v: ast.Expr) -> ast.Expr {\n  match v {\n    ast.SetExpr { types, elems } => ast.SetExpr {\n      types,\n      elems: eval.sorted_values(w, elems.map(x -> eval.canonical(w, x))),\n    },\n    ast.DictExpr { types, entries } => {\n      pairs := eval.sorted_values(w, entries.map(\n        kv ->\n          eval.pair(\n            eval.canonical(w, kv.0),\n            eval.canonical(w, kv.1),\n          ),\n      ))\n      ast.DictExpr { types, entries: pairs.map(\n        p -> match p {\n          ast.TupleExpr([k, x]) => (k, x),\n          _ => (p, ast.UnitExpr),\n        },\n      ) }\n    },\n    ast.ListExpr(xs) => ast.ListExpr(xs.map(x -> eval.canonical(w, x))),\n    ast.TupleExpr(xs) => ast.TupleExpr(xs.map(x -> eval.canonical(w, x))),\n    ast.CtorExpr { name, args: ast.PositionalArgs(xs) } => ast.CtorExpr {\n      name,\n      args: ast.PositionalArgs(xs.map(x -> eval.canonical(w, x))),\n    },\n    ast.CtorExpr { name, args: ast.RecordArgs(fs) } => ast.CtorExpr {\n      name,\n      args: ast.RecordArgs(fs.map(f -> (f.0, eval.canonical(w, f.1)))),\n    },\n    _ => v,\n  }\n}","old_text":"/// `v` with each set's and dict's entries sorted (`compare`), within it too:\n/// what `==` compares, as a table's order is no part of its value.\nfn canonical(w: eval.World, v: ast.Expr) -> ast.Expr {\n  match v {\n    ast.SetExpr { types, elems } => ast.SetExpr {\n      types,\n      elems: eval.sorted_values(w, elems.map(x -> eval.canonical(w, x))),\n    },\n    ast.DictExpr { types, entries } => {\n      pairs := eval.sorted_values(w, entries.map(\n        kv ->\n          eval.pair(\n            eval.canonical(w, kv.0),\n            eval.canonical(w, kv.1),\n          ),\n      ))\n      ast.DictExpr { types, entries: pairs.map(\n        p -> match p {\n          ast.TupleExpr([k, x]) => (k, x),\n          _ => (p, ast.UnitExpr),\n        },\n      ) }\n    },\n    ast.ListExpr(xs) => ast.ListExpr(xs.map(x -> eval.canonical(w, x))),\n    ast.TupleExpr(xs) => ast.TupleExpr(xs.map(x -> eval.canonical(w, x))),\n    ast.CtorExpr { name, args: ast.PositionalArgs(xs) } => ast.CtorExpr {\n      name,\n      args: ast.PositionalArgs(xs.map(x -> eval.canonical(w, x))),\n    },\n    ast.CtorExpr { name, args: ast.RecordArgs(fs) } => ast.CtorExpr {\n      name,\n      args: ast.RecordArgs(fs.map(f -> (f.0, eval.canonical(w, f.1)))),\n    },\n    _ => v,\n  }\n}"},{"name":"eval.index_where","kind":"fn","old":"da4b1dba7d1adbb9","new":"097682039f6d2937","interface_changed":false,"affected":[],"module":"eval","text":"/// The index of the first `x` in `xs`, or -1.\nfn index_where(xs: List[ast.Expr], x: ast.Expr) -> Int {\n  for (i, y) in enumerate(xs) {\n    if y == x {\n      return i\n    }\n  }\n  -1\n}","old_text":"/// Where `x` is in `xs` (the first), or -1.\nfn index_where(xs: List[ast.Expr], x: ast.Expr) -> Int {\n  for (i, y) in enumerate(xs) {\n    if y == x {\n      return i\n    }\n  }\n  -1\n}"},{"name":"eval.swap_removed","kind":"fn","old":"728466b888bda5e9","new":"35d9c9b88bc2661f","interface_changed":false,"affected":[],"module":"eval","text":"/// `xs` without element `i`, the last element moved into its place, as\n/// compiled code's table `remove` does (`strata_tbl_remove_at`). `xs` when\n/// `i` is -1.\nfn swap_removed[A](xs: List[A], i: Int) -> List[A] {\n  n := len(xs)\n  if i < 0 || i >= n {\n    return xs\n  }\n  if i == n - 1 {\n    return take(xs, i)\n  }\n  match get(xs, n - 1) {\n    Some(last) => take(xs, i) + [last] + slice(xs, i + 1, n - 1),\n    None => xs,\n  }\n}","old_text":"/// `xs` without element `i`, the last one in its place: a table's\n/// `remove`, as compiled code's (`strata_tbl_remove_at`) does it (`xs` when\n/// `i` is -1).\nfn swap_removed[A](xs: List[A], i: Int) -> List[A] {\n  n := len(xs)\n  if i < 0 || i >= n {\n    return xs\n  }\n  if i == n - 1 {\n    return take(xs, i)\n  }\n  match get(xs, n - 1) {\n    Some(last) => take(xs, i) + [last] + slice(xs, i + 1, n - 1),\n    None => xs,\n  }\n}"}]}
{"id":"e66a39ad36df1d05","time":1795634364,"message":"edit","changes":[{"name":"smt.use ast","kind":"use","old":"c333cc9f83ed9c22","new":"4c5e34ce1b09bae9","interface_changed":false,"affected":[],"module":"smt","text":"// smt: symbolic execution of a function into SMT-LIB queries for Z3: one\n// obligation per check, contract and refinement, plus termination's.\nfrom ast use Arm, CapabilityDef, TraitDef, ImplDef, TraitDecl, ImplDecl,\n  ExternDef, ExternDecl, Builtin, ExternFn, LamParam, Decl, FnDecl, TypeDecl,\n  TypeExpr, Expr, Stmt, Pattern, Param, StrPart, BinOp, FnDef, TypeDef, Named,\n  FnType, UnitType, Refined, UnionType, Alias, RecordBody, SumBody, NoPayload,\n  Positional, RecordPayload, MemberType, IntLit, BigIntLit, FloatLit, TupleExpr,\n  StrLit, BoolLit, UnitExpr, Var, Hole, ListExpr, CtorExpr, Call, MethodCall,\n  FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr, MutExpr, Block,\n  MockExpr, Return, Try, Except, Interp, Range, Index, Comp, DictExpr, SetExpr,\n  Fallback, Comptime, Scope, Spawn, Await, Select, Race, SupervisedSpawn,\n  ValuePart, TextPart, Add, Sub, Mul, Div, Mod, Equal, NotEqual, Less, LessEq,\n  Greater, GreaterEq, And, Or, Implies, BitAnd, BitOr, BitXor, Shl, Shr, Neg,\n  Not, Let, VarDecl, Assign, While, For, Loop, Break, Continue, ExprStmt,\n  Assert, Comment, ComptimeFor, Invariant, Decreases, Wild, Bind, IntPat,\n  StrPat, BoolPat, CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat,\n  CtorPat, NoPats, PositionalPats, RecordPats, TypePats, CtorArgs, NoArgs,\n  PositionalArgs, RecordArgs, UpdateArgs, TryResult, TryOption, unassumed","old_text":"from ast use Arm, CapabilityDef, TraitDef, ImplDef, TraitDecl, ImplDecl,\n  ExternDef, ExternDecl, Builtin, ExternFn, LamParam, Decl, FnDecl, TypeDecl,\n  TypeExpr, Expr, Stmt, Pattern, Param, StrPart, BinOp, FnDef, TypeDef, Named,\n  FnType, UnitType, Refined, UnionType, Alias, RecordBody, SumBody, NoPayload,\n  Positional, RecordPayload, MemberType, IntLit, BigIntLit, FloatLit, TupleExpr,\n  StrLit, BoolLit, UnitExpr, Var, Hole, ListExpr, CtorExpr, Call, MethodCall,\n  FieldOf, Lambda, Binary, Unary, IsExpr, IfExpr, MatchExpr, MutExpr, Block,\n  MockExpr, Return, Try, Except, Interp, Range, Index, Comp, DictExpr, SetExpr,\n  Fallback, Comptime, Scope, Spawn, Await, Select, Race, SupervisedSpawn,\n  ValuePart, TextPart, Add, Sub, Mul, Div, Mod, Equal, NotEqual, Less, LessEq,\n  Greater, GreaterEq, And, Or, Implies, BitAnd, BitOr, BitXor, Shl, Shr, Neg,\n  Not, Let, VarDecl, Assign, While, For, Loop, Break, Continue, ExprStmt,\n  Assert, Comment, ComptimeFor, Invariant, Decreases, Wild, Bind, IntPat,\n  StrPat, BoolPat, CtorPattern, ListPat, TuplePat, CondPat, OrPat, ForPat,\n  CtorPat, NoPats, PositionalPats, RecordPats, TypePats, CtorArgs, NoArgs,\n  PositionalArgs, RecordArgs, UpdateArgs, TryResult, TryOption, unassumed"},{"name":"smt.Val","kind":"type","old":"7d8cab093550693c","new":"d2deb72691f951f3","interface_changed":false,"affected":[],"module":"smt","text":"/// A value as the solver sees it: a term of its sort, a structure of\n/// terms, or something not modelled (`Opaque`, with the reason).\npub type Val =\n  | VInt(String)\n  | VBool(String)\n  | VStr(String)\n  | UnitVal\n  | Opaque(String)\n  | VTuple(List[smt.Val])\n  // a record: its type and its fields in declaration order\n  | VRec { name: String, fields: List[(String, smt.Val)] }\n  // a value of a sum type: the active constructor (`tag`, an index) and\n  // the payload of every constructor. Only the active one is meaningful.\n  | VSum { ty: String, args: List[ast.TypeExpr], tag: String, ctors: List[(String, List[smt.Val])] }\n  | VDistinct { name: String, inner: smt.Val }\n  // the payload of an inactive constructor\n  | Inactive\n  // a structured value as one term of its type's datatype, unfolded when read\n  | VData { ty: ast.TypeExpr, t: String }\n  // a list, or a dict or set by its size: its length, and `id`, the index\n  // in `Vc.lists` of how its elements are made and what holds of all\n  | VList { len: String, id: Int }\n  // a function value of a known type: its behaviour is unknown, but its\n  // result is a valid value of `ret`\n  | VFn { ret: ast.TypeExpr }\n  // a value of a union type (`Square | Circle`): its member shape (`tag`,\n  // an index into `slots`) and a value of each shape keyed by `val_key`\n  // (`Inactive` for a shape it can't have)\n  | VUnion { tag: String, slots: List[(String, smt.Val)] }","old_text":"/// A value as the solver sees it: a term of its sort, a structure of them,\n/// or something not modelled (with why).\npub type Val =\n  | VInt(String)\n  | VBool(String)\n  | VStr(String)\n  | UnitVal\n  | Opaque(String)\n  | VTuple(List[smt.Val])\n  // a record: its type and its fields in declaration order\n  | VRec { name: String, fields: List[(String, smt.Val)] }\n  // a value of a sum type: which constructor (`tag`, an index), and the\n  // payload of every constructor (only the active one means anything)\n  | VSum { ty: String, args: List[ast.TypeExpr], tag: String, ctors: List[(String, List[smt.Val])] }\n  | VDistinct { name: String, inner: smt.Val }\n  // the payload of a constructor that is not the active one\n  | Inactive\n  // a structured value as one term of its type's datatype, unfolded when read\n  | VData { ty: ast.TypeExpr, t: String }\n  // a list (a dict or a set too, by its size): its length, and `id`, which\n  // says how its elements are made and what is known of every one of them\n  // (`Vc.lists`)\n  | VList { len: String, id: Int }\n  // a function value of a known type: what it does is unknown, but what it\n  // returns is a valid value of `ret`\n  | VFn { ret: ast.TypeExpr }\n  // a value of a union type (`Square | Circle`): which member shape it has\n  // (`tag`, an index into `slots`), and a value of each shape, keyed by\n  // `val_key` (`Inactive` for a shape it can't have)\n  | VUnion { tag: String, slots: List[(String, smt.Val)] }"},{"name":"smt.Const","kind":"type","old":"9cf74ad06b48228e","new":"bd95c88c836c3238","interface_changed":false,"affected":[],"module":"smt","text":"/// A fresh unknown: its name, the number of positions it is a function of\n/// (0 for a constant), and its sort.\ntype Const = { name: String, args: Int, sort: String }","old_text":"/// A fresh unknown: its name, the number of positions it is a function of\n/// (0: a constant), and its sort.\ntype Const = { name: String, args: Int, sort: String }"},{"name":"smt.Obligation","kind":"type","old":"8a8eedeb819b7fb3","new":"b4477d4ee49212fb","interface_changed":false,"affected":[],"module":"smt","text":"/// A check to prove: `goal` on the path `pc`, given the first `facts`\n/// facts.\npub type Obligation = { what: String, goal: String, pc: List[String], facts: Int }","old_text":"/// What is to be proven, `goal`, on the path `pc`, knowing the first\n/// `facts` facts.\npub type Obligation = { what: String, goal: String, pc: List[String], facts: Int }"},{"name":"smt.Exit","kind":"type","old":"1eeca1cae68b51a1","new":"1d75dc7909580f9c","interface_changed":false,"affected":[],"module":"smt","text":"/// A way out of the function: the path, the result, and the `mut`\n/// parameters' values there (for its `ensures`).\ntype Exit = {\n  pc: List[String],\n  value: smt.Val,\n  state: List[(String, smt.Val)] = [],\n}","old_text":"/// A way out of the function: on the path `pc`, with `value`.\n/// A way out of the function: the path, the result, and the `mut`\n/// parameters' values there (for its `ensures`).\ntype Exit = {\n  pc: List[String],\n  value: smt.Val,\n  state: List[(String, smt.Val)] = [],\n}"},{"name":"smt.Vc","kind":"type","old":"f5c919d0c4686d25","new":"4629ce30f03930fd","interface_changed":false,"affected":[],"module":"smt","text":"/// The state of the symbolic run of one function.\npub type Vc = {\n  // the functions and types of the program, std and core, by the names\n  // code uses, and the builtins' signatures\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  builtins: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  // each sum type's variants, with the type's name\n  parents: Dict[String, String],\n  // each constructor, with its type's name\n  ctors: Dict[String, String],\n  consts: List[smt.Const],\n  next_var: Int,\n  facts: List[String],\n  // facts that hold on every path (what a term's type gives)\n  defs: List[String],\n  // why each unknown was made (something not modelled)\n  reasons: Dict[String, String],\n  reason: Option[String],\n  pc: List[String],\n  scopes: List[Dict[String, smt.Val]],\n  obligations: List[smt.Obligation],\n  // obligations true for all values: proven without a query\n  given: List[String],\n  // inside a contract or refinement: no obligations are made there\n  spec: Int,\n  proving: Int,\n  dead: Bool,\n  depth: Int,\n  returns: List[smt.Exit],\n  memo: Dict[String, smt.Val],\n  bit_terms: Dict[String, String],\n  // the types variables were declared with, which hold after each\n  // assignment\n  declared: Dict[String, List[ast.TypeExpr]],\n  params: List[(String, smt.Val)],\n  // the sorts, in the order met, by name\n  sorts: List[(String, smt.SortDef)],\n  sort_index: Dict[String, Int],\n  // the validity predicates (name, sort), by type and sort\n  valid: List[(String, String)],\n  valid_index: Dict[String, Int],\n  // the validity predicates defined, and the terms unfolded\n  defined: Set[String],\n  unfolded: Dict[String, smt.Val],\n  // strings read from datatype values, named in the queries\n  str_terms: List[String],\n  // the types being checked (a recursive one is checked to a fixed depth)\n  checking: List[String],\n  cutoffs: Dict[String, String],\n  // the lists, by id\n  lists: List[smt.ListInfo],\n  // open scopes (a quantified fact, a template): where the unknowns and\n  // facts made inside them start\n  regions: List[(Int, Int)],\n  // the positions new unknowns are functions of (a list's template)\n  indexing: Option[List[String]],\n  // the quantifier nesting, and the quantified variables made\n  binding: Int,\n  qvars: Int,\n  // the unknowns a quantifier binds\n  bound: Set[String],\n  // nesting depth of lists compared by position\n  eq_depth: Int,\n  // the functions passed to the call being made, by argument\n  fn_args: List[Option[smt.Func]],\n  // the `break`s and `continue`s of the loops being run, innermost last\n  breaks: List[List[smt.Jump]],\n  continues: List[List[smt.Jump]],\n  // inside a trial pass of a loop: inner loops infer nothing\n  trial: Int,\n  // in a trial pass, the values callees wrote back to `mut` arguments of a\n  // type without refinements: any value of the type, nothing known\n  wiped: List[smt.Val],\n  // candidate invariants: the `ensures` of the returned variable, and the\n  // `requires`\n  hints: List[(ast.Expr, String)],\n  requires_hints: List[ast.Expr],\n  // the solver's answers from earlier runs, by query, and the queries\n  // this run still needs\n  answers: Dict[String, String],\n  pending: List[String],\n  // the strings tested against regular expressions: the string, the\n  // pattern, its Bool, and whether it is approximated\n  matched: List[(String, String, String, Bool)],\n  // what this function uses that smt doesn't model\n  gaps: List[String],\n  // for the termination check: the function's own name (a call of it is\n  // recursion), its `while` loops, its recursive calls (path and\n  // arguments), their obligations (kept apart), and the type of each\n  // non-list value a `for` runs over (`\"\"` when not known)\n  self_name: String,\n  loops: List[smt.LoopInfo],\n  rec_sites: List[(List[String], List[smt.Val])],\n  term_obs: List[smt.Obligation],\n  iter_fors: List[String],\n  // for `verify`'s report: the loop invariants inferred, and the functions\n  // seen through whose finishing is only assumed (`terminates`)\n  invariants: List[String],\n  relied_on: Set[String],\n  // `verify`'s counterexamples (`Methods.examples`): each list parameter's\n  // first elements (`input_elems`). Their facts and terms are set aside for\n  // a second query when a model can't be shown without them.\n  examples: Bool,\n  example_facts: List[String],\n  example_leaves: List[String],\n  input_elems: Dict[Int, List[smt.Val]],\n  input_depth: Int,\n  // a running solver (c/solver.c) that `ask` sends each question to as it\n  // comes, waiting for the answer, so the function is run once. With `\"\"`\n  // the questions stay pending and the run is repeated once answered.\n  live: String,\n  // the function's own `while` loops (`while_loops`), to tell them from\n  // those of callees seen through\n  own_whiles: List[(ast.Expr, ast.Expr)],\n  // the cost of the loop-invariant searches (solver resource units and\n  // microseconds, from their answers), and whether one was refused because\n  // the run's search budget was used up\n  search_units: Int,\n  search_micros: Int,\n  search_cut: Bool,\n  // inside a loop with written invariants: inference asks only at a\n  // proof's limit, and gives up at the first unanswered question\n  cheap: Int,\n  // for `verify` to write: each own `while` loop's inferred invariants and\n  // their cost\n  found_loops: List[smt.LoopFound],\n  // the `mut` parameters of the function. Its `ensures` name their values\n  // at each exit; `old x` is the starting value.\n  mut_params: List[String] = [],\n  // in an `ensures`: what `old e` reads (the values at the function's\n  // start, or the arguments before a call)\n  olds: Option[Dict[String, smt.Val]] = None,\n  // after a call seen through its contract: the `mut` parameters' values\n  // it leaves (`write_after` writes them back)\n  after: List[smt.Val] = [],\n  // the dicts and sets among the lists, by id, with their types. An\n  // input's is shown as a dict or set (`literal_of`).\n  keyed: Dict[Int, ast.TypeExpr],\n  // dict and set entries by list id: an SMT array from each key to an\n  // `Option` of its value (dict) or a Bool (set). Its size is a function\n  // of the array (`map_sorts`).\n  arrays: Dict[Int, String],\n  // the type a `let` gives the dict or set literal bound to it, so `set`\n  // and `dict` make an array of that type\n  want: Option[(ast.Expr, ast.TypeExpr)],\n  // in a loop's written invariant: calls are seen through as in a contract\n  see: Int = 0,\n  // inside a fact made of two lists' elements known equal\n  in_same: Int = 0,\n  // comparing two lists the code compares (`binary`)\n  list_eq: Int = 0,\n  // the prefix-sum functions of lists (`prefix_sum`), by list and function\n  sum_fns: Dict[String, String] = Dict[String, String] {},\n  // the lengths of the lists whose first elements are in `input_elems`\n  input_lens: Dict[Int, String] = Dict[Int, String] {},\n  // the recursive functions unfolded in contracts, as SMT functions: by\n  // symbol, their argument sorts and result sort (`rec_call`)\n  rec_fns: Dict[String, (List[String], String)] = Dict[String, (List[String], String)] {},\n  // nesting depth of unfolding them\n  unfolding: Int = 0,\n  // nesting depth of comparing two datatype terms of different sorts\n  data_eq: Int = 0,\n  // uninterpreted functions of a receiver, standing for pure methods seen\n  // only through their contracts (a trait model, `self.total()`): name,\n  // receiver sort, result sort (`receiver_term`)\n  of_receiver: List[(String, String, String)] = [],\n  // the polarity of the Bool being made, read by `eval`:\n  // 1: only ever assumed true (a fact of every position, inside `all`);\n  // -1: only ever proven (inside `every`);\n  // 0: either.\n  // `all` makes only the direction it needs, so a quantifier is never\n  // nested in another (`all_of`).\n  polarity: Int = 0,\n  // the polarity of the call being made (`call`, `builtin` read it)\n  call_pol: Int = 0,\n  // how many seen-through bodies (in a contract) the run is in. There a\n  // refined constructor that may fail is a value only where it doesn't\n  // (`ctor`).\n  through: Int = 0,\n  // what holds of every entry of a dict (`all(d.items(), f)` assumed), the\n  // keys read in dicts' arrays, and whether such a fact is being stated\n  // (`map_instance` does not recurse)\n  map_alls: List[smt.MapAll] = [],\n  map_reads: List[smt.MapRead] = [],\n  map_inst: Int = 0,\n  // each array made by a store, with the array it was stored into\n  map_from: Dict[String, String] = Dict[String, String] {},\n  // the facts in `defs`, to make each once\n  def_set: Set[String] = Set[String] {},\n  // each `for`'s list, by the name its index loop binds it to (`for_loop`)\n  for_lists: Dict[String, ast.Expr] = Dict[String, ast.Expr] {},\n  // the variable the body ends with, and the result's type\n  returned: Option[(String, ast.TypeExpr)] = None,\n}","old_text":"/// The state of the symbolic run of one function.\npub type Vc = {\n  // the functions and types of the program, std and core, by the names\n  // code uses; the builtins' signatures\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  builtins: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  // the variants of the sum types, with their type's name\n  parents: Dict[String, String],\n  // each constructor, with its type's name\n  ctors: Dict[String, String],\n  consts: List[smt.Const],\n  next_var: Int,\n  facts: List[String],\n  // facts that hold on every path (what a term's type gives)\n  defs: List[String],\n  // why an unknown was made (something not modelled)\n  reasons: Dict[String, String],\n  reason: Option[String],\n  pc: List[String],\n  scopes: List[Dict[String, smt.Val]],\n  obligations: List[smt.Obligation],\n  // obligations true whatever the values: proven without a query\n  given: List[String],\n  // inside a contract or refinement (no obligations are made there)\n  spec: Int,\n  proving: Int,\n  dead: Bool,\n  depth: Int,\n  returns: List[smt.Exit],\n  memo: Dict[String, smt.Val],\n  bit_terms: Dict[String, String],\n  // the types variables were declared with: they hold after each assignment\n  declared: Dict[String, List[ast.TypeExpr]],\n  params: List[(String, smt.Val)],\n  // the sorts, in the order met, by name\n  sorts: List[(String, smt.SortDef)],\n  sort_index: Dict[String, Int],\n  // the validity predicates (name, sort), by type and sort\n  valid: List[(String, String)],\n  valid_index: Dict[String, Int],\n  // the validity predicates defined, the terms unfolded\n  defined: Set[String],\n  unfolded: Dict[String, smt.Val],\n  // strings read from datatype values (named in the queries)\n  str_terms: List[String],\n  // the types being checked (a recursive one, to a fixed depth)\n  checking: List[String],\n  cutoffs: Dict[String, String],\n  // the lists, by id\n  lists: List[smt.ListInfo],\n  // open scopes (a quantified fact, a template): where the unknowns and\n  // the facts made inside start\n  regions: List[(Int, Int)],\n  // the positions unknowns made now are functions of (a list's template)\n  indexing: Option[List[String]],\n  // inside a quantifier, and the quantified variables made\n  binding: Int,\n  qvars: Int,\n  // the unknowns a quantifier binds\n  bound: Set[String],\n  // lists compared by position, nested this deep\n  eq_depth: Int,\n  // the functions passed to the call being made, by argument\n  fn_args: List[Option[smt.Func]],\n  // the `break`s and `continue`s of the loops being run, innermost last\n  breaks: List[List[smt.Jump]],\n  continues: List[List[smt.Jump]],\n  // inside a trial pass of a loop (inner loops infer nothing)\n  trial: Int,\n  // in a trial pass, the values callees wrote back to `mut` arguments of\n  // a type without refinements: any value of it, nothing known\n  wiped: List[smt.Val],\n  // candidate invariants: the `ensures` of the variable returned, the\n  // `requires`\n  hints: List[(ast.Expr, String)],\n  requires_hints: List[ast.Expr],\n  // the solver's answers from the runs before this one, by query; the\n  // queries this run needs and lacks\n  answers: Dict[String, String],\n  pending: List[String],\n  // what this function uses that `compiler/smt` doesn't model\n  // the strings tested against regular expressions: the string, the\n  // pattern, its Bool, whether it is approximated\n  matched: List[(String, String, String, Bool)],\n  gaps: List[String],\n  // for the termination check: the function's own name (a call of it is\n  // recursion), its `while` loops, its recursive calls (the path and the\n  // arguments), the obligations about them (kept apart from the others),\n  // and the type of each value a `for` runs over that is no list (`\"\"`\n  // when not known)\n  self_name: String,\n  loops: List[smt.LoopInfo],\n  rec_sites: List[(List[String], List[smt.Val])],\n  term_obs: List[smt.Obligation],\n  iter_fors: List[String],\n  // for `verify`'s report: the loop invariants inferred, and the functions\n  // seen through whose finishing is only assumed (marked `terminates`)\n  invariants: List[String],\n  relied_on: Set[String],\n  // `verify`'s counterexamples (`Methods.examples`): each list parameter's\n  // first elements made (`input_elems`), their facts and terms set aside\n  // for a second query when a model can't be shown without them\n  examples: Bool,\n  example_facts: List[String],\n  example_leaves: List[String],\n  input_elems: Dict[Int, List[smt.Val]],\n  input_depth: Int,\n  // a solver kept running (c/solver.c) that `ask` puts its questions to\n  // as they come, waiting for each answer: the function is run once (`\"\"`:\n  // the questions are left pending, and the run is done again answered)\n  live: String,\n  // the function's own `while` loops (`while_loops`), to tell its loops\n  // from those of the callees seen through\n  own_whiles: List[(ast.Expr, ast.Expr)],\n  // what the loop-invariant searches took (the solver's resource units,\n  // and microseconds, as their answers say), and whether one was refused,\n  // the run's search budget used up\n  search_units: Int,\n  search_micros: Int,\n  search_cut: Bool,\n  // inside a loop with written invariants: its inference only asks at a\n  // proof's limit, and gives up at the first question not answered\n  cheap: Int,\n  // for `verify` to write: each own `while` loop's inferred invariants,\n  // with what finding them took\n  found_loops: List[smt.LoopFound],\n  // the `mut` parameters of the function run (their values at each exit\n  // are what its `ensures` name; `old x` is the value it started with)\n  mut_params: List[String] = [],\n  // in an `ensures`: what `old e` reads (the values where the function\n  // started, or the arguments before a call)\n  olds: Option[Dict[String, smt.Val]] = None,\n  // after a call seen through its contract: the `mut` parameters' values\n  // it leaves (`write_after` writes them back)\n  after: List[smt.Val] = [],\n  // the dicts and sets among the lists, by id, with their types: an\n  // input's is shown as a dict or set (`literal_of`)\n  keyed: Dict[Int, ast.TypeExpr],\n  // the dicts' and sets' entries, by list id: an SMT array from each key to\n  // an `Option` of its value (a dict's) or to whether it is in (a set's),\n  // whose size is a function of it (`map_sorts`)\n  arrays: Dict[Int, String],\n  // the type a `let` gives the dict or set literal it is bound to (`set`\n  // and `dict` make the array of that type)\n  want: Option[(ast.Expr, ast.TypeExpr)],\n  // in a loop's written invariant: calls are seen through as in a contract\n  see: Int = 0,\n  // inside a fact made of two lists' elements known equal\n  in_same: Int = 0,\n  // comparing two lists the code compares (`binary`)\n  list_eq: Int = 0,\n  // the prefix-sum functions of lists (`prefix_sum`), by list and function\n  sum_fns: Dict[String, String] = Dict[String, String] {},\n  // the lengths of the lists whose first elements are in `input_elems`\n  input_lens: Dict[Int, String] = Dict[Int, String] {},\n  // the recursive functions unfolded in contracts, as SMT functions: by\n  // symbol, their argument sorts and result sort (`rec_call`)\n  rec_fns: Dict[String, (List[String], String)] = Dict[String, (List[String], String)] {},\n  // unfolding one of them, nested this deep\n  unfolding: Int = 0,\n  // two datatype terms of different sorts compared, this many levels deep\n  data_eq: Int = 0,\n  // the uninterpreted functions of a receiver that pure methods seen only\n  // through their contracts are (a trait's model, `self.total()`): name,\n  // the receiver's sort, the result's sort (`receiver_term`)\n  of_receiver: List[(String, String, String)] = [],\n  // the polarity of the Bool being made (`eval` reads it for its\n  // expression): 1 when it is only ever known true (a fact of every\n  // position, inside `all`), -1 when it is only ever proven (inside\n  // `every`), 0 when either; `all` makes only the direction it needs, so\n  // that a quantifier is never nested in another (`all_of`)\n  polarity: Int = 0,\n  // the polarity of the call being made (`call`, `builtin` read it)\n  call_pol: Int = 0,\n  // how many bodies seen through (in a contract) the run is in: there a\n  // refined constructor that may fail is a value only where it doesn't\n  // (`ctor`)\n  through: Int = 0,\n  // what is known of every entry of a dict (`all(d.items(), f)` assumed),\n  // the keys read in dicts' arrays, and whether such a fact is being\n  // stated (`map_instance`: not again inside)\n  map_alls: List[smt.MapAll] = [],\n  map_reads: List[smt.MapRead] = [],\n  map_inst: Int = 0,\n  // each array made by a store, with the array it was stored into\n  map_from: Dict[String, String] = Dict[String, String] {},\n  // the facts in `defs`, to make each once\n  def_set: Set[String] = Set[String] {},\n  // each `for`'s list, by the name its index loop binds it to (`for_loop`)\n  for_lists: Dict[String, ast.Expr] = Dict[String, ast.Expr] {},\n  // the variable the body ends with, and the result's type\n  returned: Option[(String, ast.TypeExpr)] = None,\n}"},{"name":"smt.new_vc","kind":"fn","old":"9f120c16e15962b4","new":"bfa447f9ef61eb86","interface_changed":false,"affected":[],"module":"smt","text":"/// A new run over these functions, types and builtins.\npub fn new_vc(\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  builtins: List[smt.BuiltinSig],\n  methods: smt.Methods,\n) -> smt.Vc {\n  mut parents := Dict[String, String] {}\n  mut ctors := Dict[String, String] {}\n  for (n, td) in items(types) {\n    match td.body {\n      ast.SumBody(vs) => {\n        for v in vs {\n          // a variant named like its sum (`type E` with one variant `E`)\n          // is the sum itself, so it has no parent\n          if smt.qual(n, v.name) != n {\n            mut parents.insert(smt.qual(n, v.name), n)\n          }\n          mut ctors.insert(smt.qual(n, v.name), n)\n        }\n      },\n      ast.RecordBody(_) => mut ctors.insert(n, n),\n      ast.Alias(_) => if td.distinct {\n        mut ctors.insert(n, n)\n      },\n    }\n  }\n  smt.Vc {\n    fns,\n    types,\n    builtins,\n    methods,\n    parents,\n    ctors,\n    consts: [],\n    next_var: 0,\n    facts: [],\n    defs: [],\n    reasons: Dict[String, String] {},\n    reason: None,\n    pc: [],\n    scopes: [Dict[String, smt.Val] {}],\n    obligations: [],\n    given: [],\n    spec: 0,\n    proving: 0,\n    dead: false,\n    depth: 0,\n    returns: [],\n    memo: Dict[String, smt.Val] {},\n    bit_terms: Dict[String, String] {},\n    declared: Dict[String, List[ast.TypeExpr]] {},\n    params: [],\n    sorts: [],\n    sort_index: Dict[String, Int] {},\n    valid: [],\n    valid_index: Dict[String, Int] {},\n    defined: Set[String] {},\n    unfolded: Dict[String, smt.Val] {},\n    str_terms: [],\n    checking: [],\n    cutoffs: Dict[String, String] {},\n    lists: [],\n    regions: [],\n    indexing: None,\n    binding: 0,\n    qvars: 0,\n    bound: Set[String] {},\n    eq_depth: 0,\n    fn_args: [],\n    breaks: [],\n    continues: [],\n    trial: 0,\n    wiped: [],\n    hints: [],\n    requires_hints: [],\n    answers: Dict[String, String] {},\n    pending: [],\n    matched: [],\n    gaps: [],\n    self_name: \"\",\n    loops: [],\n    rec_sites: [],\n    term_obs: [],\n    iter_fors: [],\n    invariants: [],\n    relied_on: Set[String] {},\n    examples: methods.examples,\n    example_facts: [],\n    example_leaves: [],\n    input_elems: Dict[Int, List[smt.Val]] {},\n    input_depth: 3,\n    live: \"\",\n    own_whiles: [],\n    search_units: 0,\n    search_micros: 0,\n    search_cut: false,\n    cheap: 0,\n    found_loops: [],\n    keyed: Dict[Int, ast.TypeExpr] {},\n    arrays: Dict[Int, String] {},\n    want: None,\n  }\n}","old_text":"/// A new run over these functions, types and builtins.\npub fn new_vc(\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  builtins: List[smt.BuiltinSig],\n  methods: smt.Methods,\n) -> smt.Vc {\n  mut parents := Dict[String, String] {}\n  mut ctors := Dict[String, String] {}\n  for (n, td) in items(types) {\n    match td.body {\n      ast.SumBody(vs) => {\n        for v in vs {\n          // a variant named like its sum (`type E`, whose one variant is\n          // `E`) is the sum itself: no parent, or `E`'s would be `E`\n          if smt.qual(n, v.name) != n {\n            mut parents.insert(smt.qual(n, v.name), n)\n          }\n          mut ctors.insert(smt.qual(n, v.name), n)\n        }\n      },\n      ast.RecordBody(_) => mut ctors.insert(n, n),\n      ast.Alias(_) => if td.distinct {\n        mut ctors.insert(n, n)\n      },\n    }\n  }\n  smt.Vc {\n    fns,\n    types,\n    builtins,\n    methods,\n    parents,\n    ctors,\n    consts: [],\n    next_var: 0,\n    facts: [],\n    defs: [],\n    reasons: Dict[String, String] {},\n    reason: None,\n    pc: [],\n    scopes: [Dict[String, smt.Val] {}],\n    obligations: [],\n    given: [],\n    spec: 0,\n    proving: 0,\n    dead: false,\n    depth: 0,\n    returns: [],\n    memo: Dict[String, smt.Val] {},\n    bit_terms: Dict[String, String] {},\n    declared: Dict[String, List[ast.TypeExpr]] {},\n    params: [],\n    sorts: [],\n    sort_index: Dict[String, Int] {},\n    valid: [],\n    valid_index: Dict[String, Int] {},\n    defined: Set[String] {},\n    unfolded: Dict[String, smt.Val] {},\n    str_terms: [],\n    checking: [],\n    cutoffs: Dict[String, String] {},\n    lists: [],\n    regions: [],\n    indexing: None,\n    binding: 0,\n    qvars: 0,\n    bound: Set[String] {},\n    eq_depth: 0,\n    fn_args: [],\n    breaks: [],\n    continues: [],\n    trial: 0,\n    wiped: [],\n    hints: [],\n    requires_hints: [],\n    answers: Dict[String, String] {},\n    pending: [],\n    matched: [],\n    gaps: [],\n    self_name: \"\",\n    loops: [],\n    rec_sites: [],\n    term_obs: [],\n    iter_fors: [],\n    invariants: [],\n    relied_on: Set[String] {},\n    examples: methods.examples,\n    example_facts: [],\n    example_leaves: [],\n    input_elems: Dict[Int, List[smt.Val]] {},\n    input_depth: 3,\n    live: \"\",\n    own_whiles: [],\n    search_units: 0,\n    search_micros: 0,\n    search_cut: false,\n    cheap: 0,\n    found_loops: [],\n    keyed: Dict[Int, ast.TypeExpr] {},\n    arrays: Dict[Int, String] {},\n    want: None,\n  }\n}"},{"name":"smt.tables","kind":"fn","old":"67a4290ec7774d24","new":"4c3015217fdf3fa4","interface_changed":false,"affected":[],"module":"smt","text":"/// The functions and types of definitions by the names code uses: a\n/// script's own by bare name, a module's qualified (`std.utf8.encode`),\n/// core's types bare (`Option`, `Natural`).\npub fn tables(\n  decls: List[ast.Decl],\n) -> (Dict[String, ast.FnDecl], Dict[String, ast.TypeDecl]) {\n  mut fns := Dict[String, ast.FnDecl] {}\n  mut types := Dict[String, ast.TypeDecl] {}\n  for d in decls {\n    q := if d.module == \"\" {\n      \"\"\n    } else {\n      d.module + \".\"\n    }\n    match d.kind {\n      ast.FnDef(f) => mut fns.insert(q + f.name, f),\n      // a capability's functions (`clock.SystemClock.seconds`), seen\n      // through their contracts since the runtime implements them\n      ast.CapabilityDef(c) => {\n        for m in c.methods {\n          mut fns.insert(q + c.name + \".\" + m.name, m)\n        }\n      },\n      // a type's own methods by its name (`std.http.Router.handle`), as\n      // `check.own_methods_resolved` calls them\n      ast.ImplDef(im) => if im.trait_name == \"\" {\n        head := match im.for_type {\n          ast.Named { name, .. } => name,\n          _ => \"\",\n        }\n        tq := if contains(head, \".\") || starts_with(d.module, \"core.\") {\n          head\n        } else {\n          q + head\n        }\n        for f in im.methods {\n          mut fns.insert(\n            tq + \".\" + f.name,\n            ast.FnDecl { ..f, params: f.params.map(\n              p ->\n                ast.Param { ..p, ty: smt.self_written(p.ty, im.for_type) },\n            ), ret: smt.self_written(f.ret, im.for_type) },\n          )\n        }\n      },\n      ast.TypeDef(t) => mut types.insert(\n        if starts_with(d.module, \"core.\") {\n          t.name\n        } else {\n          q + t.name\n        },\n        t,\n      ),\n      _ => (),\n    }\n  }\n  (fns, types)\n}","old_text":"/// The functions and types of definitions, by the names code uses: a\n/// script's own by their names, a module's qualified (`std.utf8.encode`),\n/// core's types by their names alone (`Option`, `Natural`).\npub fn tables(\n  decls: List[ast.Decl],\n) -> (Dict[String, ast.FnDecl], Dict[String, ast.TypeDecl]) {\n  mut fns := Dict[String, ast.FnDecl] {}\n  mut types := Dict[String, ast.TypeDecl] {}\n  for d in decls {\n    q := if d.module == \"\" {\n      \"\"\n    } else {\n      d.module + \".\"\n    }\n    match d.kind {\n      ast.FnDef(f) => mut fns.insert(q + f.name, f),\n      // a capability's functions (`clock.SystemClock.seconds`), seen\n      // through their contracts: the runtime's code\n      ast.CapabilityDef(c) => {\n        for m in c.methods {\n          mut fns.insert(q + c.name + \".\" + m.name, m)\n        }\n      },\n      // a type's own methods, by its name (`std.http.Router.handle`), as\n      // `check.own_methods_resolved` calls them\n      ast.ImplDef(im) => if im.trait_name == \"\" {\n        head := match im.for_type {\n          ast.Named { name, .. } => name,\n          _ => \"\",\n        }\n        tq := if contains(head, \".\") || starts_with(d.module, \"core.\") {\n          head\n        } else {\n          q + head\n        }\n        for f in im.methods {\n          mut fns.insert(\n            tq + \".\" + f.name,\n            ast.FnDecl { ..f, params: f.params.map(\n              p ->\n                ast.Param { ..p, ty: smt.self_written(p.ty, im.for_type) },\n            ), ret: smt.self_written(f.ret, im.for_type) },\n          )\n        }\n      },\n      ast.TypeDef(t) => mut types.insert(\n        if starts_with(d.module, \"core.\") {\n          t.name\n        } else {\n          q + t.name\n        },\n        t,\n      ),\n      _ => (),\n    }\n  }\n  (fns, types)\n}"},{"name":"smt.and_all","kind":"fn","old":"7730eef9937412f6","new":"165a04a0ea556c7f","interface_changed":false,"affected":[],"module":"smt","text":"// ---- terms ----\n\n/// The conjunction of terms, each once, dropping `true`. A term's facts are\n/// made at each read, so without the dedup a quantifier body repeated them\n/// hundreds of times.\nfn and_all(ts: List[String]) -> String {\n  mut seen := Set[String] {}\n  mut kept := []\n  for t in ts {\n    if t != \"true\" && !contains(seen, t) {\n      mut seen.insert(t)\n      mut kept.push(t)\n    }\n  }\n  match kept {\n    [] => \"true\",\n    [t] => t,\n    _ => \"(and \" + join(kept, \" \") + \")\",\n  }\n}","old_text":"// ---- terms ----\n\n/// The conjunction of terms: each once, without those trivially true\n/// (`true`; a term's facts are made at each read of it, and a quantifier's\n/// body repeated them hundreds of times).\nfn and_all(ts: List[String]) -> String {\n  mut seen := Set[String] {}\n  mut kept := []\n  for t in ts {\n    if t != \"true\" && !contains(seen, t) {\n      mut seen.insert(t)\n      mut kept.push(t)\n    }\n  }\n  match kept {\n    [] => \"true\",\n    [t] => t,\n    _ => \"(and \" + join(kept, \" \") + \")\",\n  }\n}"},{"name":"smt.num","kind":"fn","old":"1dc6d1f1880185ef","new":"60cd6231fa40e512","interface_changed":false,"affected":[],"module":"smt","text":"/// An integer in SMT-LIB form (`(- 3)`).\nfn num(n: Int) -> String {\n  if n < 0 {\n    f\"(- {-n})\"\n  } else {\n    f\"{n}\"\n  }\n}","old_text":"/// An integer as SMT-LIB writes it (`(- 3)`).\nfn num(n: Int) -> String {\n  if n < 0 {\n    f\"(- {-n})\"\n  } else {\n    f\"{n}\"\n  }\n}"},{"name":"smt.smt_string","kind":"fn","old":"757fa7ba21bbb48a","new":"bece177a856f043e","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether an SMT string can hold `s`.\nfn smt_string(s: String) -> Bool {\n  chars(s).all(c -> ord(c) <= smt.max_char())\n}","old_text":"/// Can an SMT string hold `s`?\nfn smt_string(s: String) -> Bool {\n  chars(s).all(c -> ord(c) <= smt.max_char())\n}"},{"name":"smt.str_lit","kind":"fn","old":"3c8e528cf8a544cb","new":"9e00ff5051f46e03","interface_changed":false,"affected":[],"module":"smt","text":"/// An SMT-LIB string literal. Only for strings `smt_string` accepts.\npub fn str_lit(s: String) -> String {\n  mut out := \"\\\"\"\n  for c in chars(s) {\n    n := ord(c)\n    out += if c == \"\\\"\" {\n      \"\\\"\\\"\"\n    } else if n >= 32 && n <= 126 && c != \"\\\\\" {\n      c\n    } else {\n      \"\\u{\" + smt.lower_hex(n) + \"}\"\n    }\n  }\n  out + \"\\\"\"\n}","old_text":"/// An SMT-LIB string literal (only for strings `smt_string` accepts).\npub fn str_lit(s: String) -> String {\n  mut out := \"\\\"\"\n  for c in chars(s) {\n    n := ord(c)\n    out += if c == \"\\\"\" {\n      \"\\\"\\\"\"\n    } else if n >= 32 && n <= 126 && c != \"\\\\\" {\n      c\n    } else {\n      \"\\u{\" + smt.lower_hex(n) + \"}\"\n    }\n  }\n  out + \"\\\"\"\n}"},{"name":"smt.lower_hex","kind":"fn","old":"54e5cbfa1bdc0894","new":"da21480a23c64043","interface_changed":false,"affected":[],"module":"smt","text":"/// `n` (`n >= 0`) in lowercase hexadecimal, without leading zeros.\nfn lower_hex(n: Int) -> String {\n  if n <= 0 {\n    return \"0\"\n  }\n  mut out := \"\"\n  mut x := n\n  while x > 0 {\n    d := x % 16\n    out = byte_slice(\"0123456789abcdef\", d, d + 1) + out\n    x /= 16\n  }\n  out\n}","old_text":"/// `n` (0 <= n) in lowercase hexadecimal, without leading zeros.\nfn lower_hex(n: Int) -> String {\n  if n <= 0 {\n    return \"0\"\n  }\n  mut out := \"\"\n  mut x := n\n  while x > 0 {\n    d := x % 16\n    out = byte_slice(\"0123456789abcdef\", d, d + 1) + out\n    x /= 16\n  }\n  out\n}"},{"name":"smt.shown_name","kind":"fn","old":"8b140faff6cffdb9","new":"aeb51e17a22c6b9d","interface_changed":false,"affected":[],"module":"smt","text":"/// A name as messages show it: core's code modules (`core.iter`, ...)\n/// without the module.\nfn shown_name(name: String) -> String {\n  mut s := name\n  for m in [\n    \"core.iter.\",\n    \"core.channel.\",\n    \"core.text.\",\n    \"core.task.\",\n    \"core.keys.\",\n  ] {\n    s = replace(s, m, \"\")\n  }\n  s\n}","old_text":"/// A name as messages show it: core's code (`core.iter`, ...) without its\n/// module.\nfn shown_name(name: String) -> String {\n  mut s := name\n  for m in [\n    \"core.iter.\",\n    \"core.channel.\",\n    \"core.text.\",\n    \"core.task.\",\n    \"core.keys.\",\n  ] {\n    s = replace(s, m, \"\")\n  }\n  s\n}"},{"name":"smt.assume","kind":"fn","old":"cb02f56a6225988e","new":"23ba7a99a5c53a92","interface_changed":false,"affected":[],"module":"smt","text":"/// Assumes `t` from here on, on this path.\nfn assume(mut vc: smt.Vc, t: String) {\n  if t != \"true\" {\n    mut vc.facts.push(smt.implies(smt.and_all(vc.pc), t))\n  }\n}","old_text":"/// `t` holds from here on (on this path).\nfn assume(mut vc: smt.Vc, t: String) {\n  if t != \"true\" {\n    mut vc.facts.push(smt.implies(smt.and_all(vc.pc), t))\n  }\n}"},{"name":"smt.gap","kind":"fn","old":"a516ab4a2a87c0b8","new":"028db2ac045c5042","interface_changed":false,"affected":[],"module":"smt","text":"/// Records something smt doesn't model.\nfn gap(mut vc: smt.Vc, what: String) {\n  mut vc.gaps.push(what)\n}","old_text":"/// Something `compiler/smt` doesn't model.\nfn gap(mut vc: smt.Vc, what: String) {\n  mut vc.gaps.push(what)\n}"},{"name":"smt.start_goal","kind":"fn","old":"61252ac37c5c3420","new":"444f07960e1f927f","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether an obligation is made here (not inside a contract, nor on a\n/// dead path). If so, build its goal and pass it to `oblige`.\nfn start_goal(mut vc: smt.Vc) -> Bool {\n  if vc.spec > 0 || vc.dead {\n    return false\n  }\n  vc.spec += 1\n  vc.proving += 1\n  true\n}","old_text":"/// Whether an obligation is made here (not inside a contract, nor on a path\n/// that ended): its goal is then built, then given to `oblige`.\nfn start_goal(mut vc: smt.Vc) -> Bool {\n  if vc.spec > 0 || vc.dead {\n    return false\n  }\n  vc.spec += 1\n  vc.proving += 1\n  true\n}"},{"name":"smt.oblige","kind":"fn","old":"4bb71a6eb080dd6c","new":"b8172049f23930b4","interface_changed":false,"affected":[],"module":"smt","text":"/// Records the obligation `what` with goal `g`, after `start_goal`.\nfn oblige(mut vc: smt.Vc, what: String, g: String) {\n  vc.proving -= 1\n  vc.spec -= 1\n  shown := smt.shown_name(what)\n  if g == \"true\" {\n    // true for all values: no query, but proven\n    mut vc.given.push(shown)\n    return\n  }\n  mut vc.obligations.push(\n    smt.Obligation {\n      what: shown,\n      goal: g,\n      pc: vc.pc,\n      facts: len(vc.facts),\n    },\n  )\n  // past a check, execution continues only if it held\n  mut vc.pc.push(g)\n}","old_text":"/// The obligation `what`, whose goal `start_goal` let be built.\nfn oblige(mut vc: smt.Vc, what: String, g: String) {\n  vc.proving -= 1\n  vc.spec -= 1\n  shown := smt.shown_name(what)\n  if g == \"true\" {\n    // true whatever the values: no query, but proven all the same\n    mut vc.given.push(shown)\n    return\n  }\n  mut vc.obligations.push(\n    smt.Obligation {\n      what: shown,\n      goal: g,\n      pc: vc.pc,\n      facts: len(vc.facts),\n    },\n  )\n  // past a check, execution continues only if it held\n  mut vc.pc.push(g)\n}"},{"name":"smt.shape","kind":"fn","old":"4f92df5566e2336b","new":"9ead924627052c83","interface_changed":false,"affected":[],"module":"smt","text":"/// A value of type `t` made of fresh unknowns, nothing assumed. Its outer\n/// level is built now, its structured parts are datatype terms.\nfn shape(mut vc: smt.Vc, t: ast.TypeExpr) -> smt.Val {\n  match t {\n    ast.Named { name, .. } => if smt.width_of(name) != None {\n      x := smt.fresh(mut vc, \"Int\")\n      mut vc.facts.push(smt.word_range(name, x))\n      return smt.word(name, x)\n    },\n    _ => (),\n  }\n  match t {\n    ast.Refined { base, .. } => smt.shape(mut vc, base),\n    ast.UnitType => smt.UnitVal,\n    ast.FnType { ret, .. } => smt.VFn { ret },\n    ast.UnionType(_) => match smt.sort_of(mut vc, t) {\n      Some(s) => {\n        x := smt.fresh(mut vc, s)\n        smt.unfold(mut vc, t, x)\n      },\n      None => smt.Opaque(\n        \"values of this union type are not modelled (members of overlapping or unknown shapes)\",\n      ),\n    },\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => {\n        // a variant as a type: a value of its sum with that tag\n        v := smt.shape(mut vc, ast.Named { name: p, args })\n        match v {\n          smt.VSum { tag, ctors, .. } => match smt.position(ctors, name) {\n            Some(k) => mut vc.facts.push(f\"(= {tag} {k})\"),\n            None => (),\n          },\n          _ => (),\n        }\n        v\n      },\n      None => match name {\n        \"Int\" => smt.VInt(smt.fresh(mut vc, \"Int\")),\n        \"Bool\" => smt.VBool(smt.fresh(mut vc, \"Bool\")),\n        \"String\" => smt.VStr(smt.fresh(mut vc, \"String\")),\n        \"Float\" => smt.Opaque(\"floats are not modelled yet\"),\n        \"List\" => {\n          l := smt.fresh(mut vc, \"Int\")\n          mut vc.facts.push(f\"(>= {l} 0)\")\n          smt.new_list(mut vc, l, match get(args, 0) {\n            Some(a) => smt.GType(a),\n            None => smt.Untracked,\n          })\n        },\n        // dicts and sets: an array of their entries (`map_sorts`)\n        \"Dict\" | \"Set\" => smt.fresh_keyed(mut vc, t),\n        \"Tuple\" => {\n          mut xs := []\n          for a in args {\n            mut xs.push(smt.shape(mut vc, a))\n          }\n          smt.VTuple(xs)\n        },\n        \"Task\" => smt.shape(mut vc, get(args, 0) ?? ast.UnitType),\n        _ => match get(vc.types, name) {\n          // a type parameter's values: terms of an uninterpreted sort\n          None => match smt.sort_of(mut vc, t) {\n            Some(sort) => smt.VData { ty: t, t: smt.fresh_why(\n              mut vc,\n              sort,\n              f\"values of the generic type `{name}` are not known\",\n            ) },\n            None => smt.Opaque(\n              f\"values of the generic type `{name}` are not known\",\n            ),\n          },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              ) }\n            } else {\n              smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              )\n            },\n            ast.RecordBody(_) => {\n              rc := get(smt.variants_of(vc, name, args) ?? [], 0) ?? smt.Ctor { name, fields: None, types: [] }\n              mut fs := []\n              for (k, f) in enumerate(rc.fields ?? []) {\n                mut fs.push(\n                  (\n                    f,\n                    smt.part(\n                      mut vc,\n                      get(rc.types, k) ?? ast.UnitType,\n                    ),\n                  ),\n                )\n              }\n              smt.VRec { name, fields: fs }\n            },\n            ast.SumBody(_) => {\n              vs := smt.variants_of(vc, name, args) ?? []\n              tag := smt.fresh(mut vc, \"Int\")\n              mut vc.facts.push(\n                f\"(and (<= 0 {tag}) (< {tag} {len(vs)}))\",\n              )\n              mut ctors := []\n              for c in vs {\n                mut payload := []\n                for ft in c.types {\n                  mut payload.push(smt.part(mut vc, ft))\n                }\n                mut ctors.push((c.name, payload))\n              }\n              smt.VSum { ty: name, args, tag, ctors }\n            },\n          },\n        },\n      },\n    },\n  }\n}","old_text":"/// A value of type `t` with fresh unknowns, nothing assumed: its outer\n/// level made now, its structured parts terms of their datatypes.\nfn shape(mut vc: smt.Vc, t: ast.TypeExpr) -> smt.Val {\n  match t {\n    ast.Named { name, .. } => if smt.width_of(name) != None {\n      x := smt.fresh(mut vc, \"Int\")\n      mut vc.facts.push(smt.word_range(name, x))\n      return smt.word(name, x)\n    },\n    _ => (),\n  }\n  match t {\n    ast.Refined { base, .. } => smt.shape(mut vc, base),\n    ast.UnitType => smt.UnitVal,\n    ast.FnType { ret, .. } => smt.VFn { ret },\n    ast.UnionType(_) => match smt.sort_of(mut vc, t) {\n      Some(s) => {\n        x := smt.fresh(mut vc, s)\n        smt.unfold(mut vc, t, x)\n      },\n      None => smt.Opaque(\n        \"values of this union type are not modelled (members of overlapping or unknown shapes)\",\n      ),\n    },\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => {\n        // a variant as a type: a value of its sum with that tag\n        v := smt.shape(mut vc, ast.Named { name: p, args })\n        match v {\n          smt.VSum { tag, ctors, .. } => match smt.position(ctors, name) {\n            Some(k) => mut vc.facts.push(f\"(= {tag} {k})\"),\n            None => (),\n          },\n          _ => (),\n        }\n        v\n      },\n      None => match name {\n        \"Int\" => smt.VInt(smt.fresh(mut vc, \"Int\")),\n        \"Bool\" => smt.VBool(smt.fresh(mut vc, \"Bool\")),\n        \"String\" => smt.VStr(smt.fresh(mut vc, \"String\")),\n        \"Float\" => smt.Opaque(\"floats are not modelled yet\"),\n        \"List\" => {\n          l := smt.fresh(mut vc, \"Int\")\n          mut vc.facts.push(f\"(>= {l} 0)\")\n          smt.new_list(mut vc, l, match get(args, 0) {\n            Some(a) => smt.GType(a),\n            None => smt.Untracked,\n          })\n        },\n        // dicts and sets: an array of their entries (`map_sorts`)\n        \"Dict\" | \"Set\" => smt.fresh_keyed(mut vc, t),\n        \"Tuple\" => {\n          mut xs := []\n          for a in args {\n            mut xs.push(smt.shape(mut vc, a))\n          }\n          smt.VTuple(xs)\n        },\n        \"Task\" => smt.shape(mut vc, get(args, 0) ?? ast.UnitType),\n        _ => match get(vc.types, name) {\n          // a type parameter's values: terms of a sort nothing is known of\n          None => match smt.sort_of(mut vc, t) {\n            Some(sort) => smt.VData { ty: t, t: smt.fresh_why(\n              mut vc,\n              sort,\n              f\"values of the generic type `{name}` are not known\",\n            ) },\n            None => smt.Opaque(\n              f\"values of the generic type `{name}` are not known\",\n            ),\n          },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              ) }\n            } else {\n              smt.shape(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n              )\n            },\n            ast.RecordBody(_) => {\n              rc := get(smt.variants_of(vc, name, args) ?? [], 0) ?? smt.Ctor { name, fields: None, types: [] }\n              mut fs := []\n              for (k, f) in enumerate(rc.fields ?? []) {\n                mut fs.push(\n                  (\n                    f,\n                    smt.part(\n                      mut vc,\n                      get(rc.types, k) ?? ast.UnitType,\n                    ),\n                  ),\n                )\n              }\n              smt.VRec { name, fields: fs }\n            },\n            ast.SumBody(_) => {\n              vs := smt.variants_of(vc, name, args) ?? []\n              tag := smt.fresh(mut vc, \"Int\")\n              mut vc.facts.push(\n                f\"(and (<= 0 {tag}) (< {tag} {len(vs)}))\",\n              )\n              mut ctors := []\n              for c in vs {\n                mut payload := []\n                for ft in c.types {\n                  mut payload.push(smt.part(mut vc, ft))\n                }\n                mut ctors.push((c.name, payload))\n              }\n              smt.VSum { ty: name, args, tag, ctors }\n            },\n          },\n        },\n      },\n    },\n  }\n}"},{"name":"smt.refresh","kind":"fn","old":"5f827ea1a16ecc5a","new":"4ce2b2f4e516d335","interface_changed":false,"affected":[],"module":"smt","text":"/// A fresh value of the same kind as `v` (a callee's write-back), keeping\n/// what types guarantee.\nfn refresh(mut vc: smt.Vc, v: smt.Val) -> smt.Val {\n  match v {\n    smt.VInt(_) => smt.VInt(smt.fresh(mut vc, \"Int\")),\n    smt.VBool(_) => smt.VBool(smt.fresh(mut vc, \"Bool\")),\n    smt.VStr(_) => smt.VStr(smt.fresh(mut vc, \"String\")),\n    smt.VTuple(xs) => {\n      mut ys := []\n      for x in xs {\n        mut ys.push(smt.refresh(mut vc, x))\n      }\n      smt.VTuple(ys)\n    },\n    smt.VRec { name, .. } => smt.havoc(mut vc, smt.named(name)),\n    smt.VDistinct { name, .. } => smt.havoc(mut vc, smt.named(name)),\n    smt.VSum { ty, args, .. } => smt.havoc(mut vc, ast.Named { name: ty, args }),\n    smt.VData { ty, .. } => smt.havoc(mut vc, ty),\n    smt.VList { id, .. } => {\n      // any list: what a loop put in it is unknown. A dict or set stays\n      // one.\n      match get(vc.keyed, id) {\n        Some(t) => smt.fresh_keyed(mut vc, t),\n        None => {\n          l := smt.fresh(mut vc, \"Int\")\n          mut vc.facts.push(f\"(>= {l} 0)\")\n          smt.new_list(mut vc, l, smt.Untracked)\n        },\n      }\n    },\n    smt.VUnion { slots, .. } => {\n      tag := smt.fresh(mut vc, \"Int\")\n      mut live := []\n      for (i, s) in enumerate(slots) {\n        if !smt.is_absent(s.1) {\n          mut live.push(f\"(= {tag} {i})\")\n        }\n      }\n      mut vc.facts.push(smt.or_all(live))\n      mut fresh_slots := []\n      for (k, s) in slots {\n        mut fresh_slots.push((k, smt.refresh(mut vc, s)))\n      }\n      smt.VUnion { tag, slots: fresh_slots }\n    },\n    other => other,\n  }\n}","old_text":"/// A fresh value of the same kind as `v` (what a callee wrote back),\n/// keeping what types guarantee.\nfn refresh(mut vc: smt.Vc, v: smt.Val) -> smt.Val {\n  match v {\n    smt.VInt(_) => smt.VInt(smt.fresh(mut vc, \"Int\")),\n    smt.VBool(_) => smt.VBool(smt.fresh(mut vc, \"Bool\")),\n    smt.VStr(_) => smt.VStr(smt.fresh(mut vc, \"String\")),\n    smt.VTuple(xs) => {\n      mut ys := []\n      for x in xs {\n        mut ys.push(smt.refresh(mut vc, x))\n      }\n      smt.VTuple(ys)\n    },\n    smt.VRec { name, .. } => smt.havoc(mut vc, smt.named(name)),\n    smt.VDistinct { name, .. } => smt.havoc(mut vc, smt.named(name)),\n    smt.VSum { ty, args, .. } => smt.havoc(mut vc, ast.Named { name: ty, args }),\n    smt.VData { ty, .. } => smt.havoc(mut vc, ty),\n    smt.VList { id, .. } => {\n      // any list: what a loop put in it is not known (a dict or set stays\n      // one)\n      match get(vc.keyed, id) {\n        Some(t) => smt.fresh_keyed(mut vc, t),\n        None => {\n          l := smt.fresh(mut vc, \"Int\")\n          mut vc.facts.push(f\"(>= {l} 0)\")\n          smt.new_list(mut vc, l, smt.Untracked)\n        },\n      }\n    },\n    smt.VUnion { slots, .. } => {\n      tag := smt.fresh(mut vc, \"Int\")\n      mut live := []\n      for (i, s) in enumerate(slots) {\n        if !smt.is_absent(s.1) {\n          mut live.push(f\"(= {tag} {i})\")\n        }\n      }\n      mut vc.facts.push(smt.or_all(live))\n      mut fresh_slots := []\n      for (k, s) in slots {\n        mut fresh_slots.push((k, smt.refresh(mut vc, s)))\n      }\n      smt.VUnion { tag, slots: fresh_slots }\n    },\n    other => other,\n  }\n}"},{"name":"smt.refined","kind":"fn","old":"9c52dd900908d598","new":"0a2d87122bc728b3","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether checking a value against `t` involves any refinement, through\n/// any type it reaches (arguments, fields, payloads, a variant's sum). The\n/// program's types that reach one are found once\n/// (`Methods.refined_types`), so only `t` itself is walked.\nfn refined(vc: smt.Vc, t: ast.TypeExpr) -> Bool {\n  if smt.trait_invariants(vc, t) != [] {\n    return true\n  }\n  match vc.methods.refined_types {\n    Some(names) => smt.refined_by(names, t),\n    None => smt.refined_walk(vc, t),\n  }\n}","old_text":"/// Does checking a value against `t` involve any refinement? Each type it\n/// can reach (its arguments, the fields and payloads of its body, the sum\n/// of a variant) is looked at: with the program's types that reach one\n/// found once (`Methods.refined_types`), only `t` itself is walked.\nfn refined(vc: smt.Vc, t: ast.TypeExpr) -> Bool {\n  if smt.trait_invariants(vc, t) != [] {\n    return true\n  }\n  match vc.methods.refined_types {\n    Some(names) => smt.refined_by(names, t),\n    None => smt.refined_walk(vc, t),\n  }\n}"},{"name":"smt.check_type","kind":"fn","old":"fbcda5785dcc3fb2","new":"a96f99200c193e37","interface_changed":false,"affected":[],"module":"smt","text":"/// The condition for `v` to be a valid value of `t`. `extra` are the\n/// bindings an inline refinement sees (a function's parameters, for its\n/// result).\nfn check_type(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  v: smt.Val,\n  extra: List[(String, smt.Val)],\n) -> String {\n  // a value of a trait with invariants (`db: Db`): they hold of it, as a\n  // refinement of every implementing type (`Self where inv(it)`)\n  invs := smt.trait_invariants(vc, t)\n  if invs != [] {\n    mut cs := []\n    vc.spec += 1\n    for e in invs {\n      mut cs.push(smt.pred(mut vc, ast.unassumed(e), [(\"self\", v)]))\n    }\n    vc.spec -= 1\n    return smt.and_all(cs)\n  }\n  match v {\n    smt.VData { ty, t: x } => {\n      // a term is valid for its own type when its predicate holds\n      if !smt.refined(vc, t) {\n        return \"true\"\n      }\n      if ty == t || smt.erased(vc, ty) == smt.erased(vc, t) {\n        return smt.valid_term(mut vc, ty, x)\n      }\n      fv := smt.force(mut vc, v)\n      return smt.check_type(mut vc, t, fv, extra)\n    },\n    _ => (),\n  }\n  // a recursive type is checked to a fixed depth\n  match t {\n    ast.Named { name, .. } => if contains(vc.types, name)\n      && !smt.is_absent(v)\n      && smt.refined(vc, t) {\n      if vc.checking.count(m -> m == name) >= 2 {\n        key := text.type_text(smt.erased(vc, t)) + \" \" + debug(v)\n        match get(vc.cutoffs, key) {\n          Some(b) => return b,\n          None => (),\n        }\n        b := smt.unknown_bool(\n          mut vc,\n          f\"`{name}` is recursive; only its outer levels are checked\",\n        )\n        mut vc.cutoffs.insert(key, b)\n        return b\n      }\n      mut vc.checking.push(name)\n      c := smt.check_type_at(mut vc, t, v, extra)\n      vc.checking = take(vc.checking, len(vc.checking) - 1)\n      return c\n    },\n    _ => (),\n  }\n  smt.check_type_at(mut vc, t, v, extra)\n}","old_text":"/// The condition for `v` to be a valid value of `t`; `extra` are the\n/// bindings an inline refinement sees (a function's parameters, for its\n/// result).\nfn check_type(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  v: smt.Val,\n  extra: List[(String, smt.Val)],\n) -> String {\n  // a value of a trait with invariants (`db: Db`): they hold of it, as a\n  // refinement of every type implementing the trait (`Self where inv(it)`)\n  invs := smt.trait_invariants(vc, t)\n  if invs != [] {\n    mut cs := []\n    vc.spec += 1\n    for e in invs {\n      mut cs.push(smt.pred(mut vc, ast.unassumed(e), [(\"self\", v)]))\n    }\n    vc.spec -= 1\n    return smt.and_all(cs)\n  }\n  match v {\n    smt.VData { ty, t: x } => {\n      // a term is valid for its own type when its predicate holds\n      if !smt.refined(vc, t) {\n        return \"true\"\n      }\n      if ty == t || smt.erased(vc, ty) == smt.erased(vc, t) {\n        return smt.valid_term(mut vc, ty, x)\n      }\n      fv := smt.force(mut vc, v)\n      return smt.check_type(mut vc, t, fv, extra)\n    },\n    _ => (),\n  }\n  // a recursive type is checked to a fixed depth\n  match t {\n    ast.Named { name, .. } => if contains(vc.types, name)\n      && !smt.is_absent(v)\n      && smt.refined(vc, t) {\n      if vc.checking.count(m -> m == name) >= 2 {\n        key := text.type_text(smt.erased(vc, t)) + \" \" + debug(v)\n        match get(vc.cutoffs, key) {\n          Some(b) => return b,\n          None => (),\n        }\n        b := smt.unknown_bool(\n          mut vc,\n          f\"`{name}` is recursive; only its outer levels are checked\",\n        )\n        mut vc.cutoffs.insert(key, b)\n        return b\n      }\n      mut vc.checking.push(name)\n      c := smt.check_type_at(mut vc, t, v, extra)\n      vc.checking = take(vc.checking, len(vc.checking) - 1)\n      return c\n    },\n    _ => (),\n  }\n  smt.check_type_at(mut vc, t, v, extra)\n}"},{"name":"smt.early_return","kind":"fn","old":"da6c68fe28113848","new":"f2a9cf635b3b278a","interface_changed":false,"affected":[],"module":"smt","text":"/// Leaves the function early with `v` on the current path.\nfn early_return(mut vc: smt.Vc, v: smt.Val) {\n  if !vc.dead {\n    mut vc.returns.push(\n      smt.Exit { pc: vc.pc, value: v, state: smt.mut_state(vc) },\n    )\n  }\n  vc.dead = true\n}","old_text":"/// Leave the function early with `v` on the current path.\nfn early_return(mut vc: smt.Vc, v: smt.Val) {\n  if !vc.dead {\n    mut vc.returns.push(\n      smt.Exit { pc: vc.pc, value: v, state: smt.mut_state(vc) },\n    )\n  }\n  vc.dead = true\n}"},{"name":"smt.merge","kind":"fn","old":"5668d5eb45df8657","new":"75766d029c97d1d0","interface_changed":false,"affected":[],"module":"smt","text":"fn merge(mut vc: smt.Vc, c: String, a: smt.Val, b: smt.Val) -> smt.Val {\n  match (a, b) {\n    (smt.Inactive, x) | (x, smt.Inactive) => x,\n    (smt.VData { ty: ta, t: x }, smt.VData { ty: tb, t: y }) => if x == y && ta == tb {\n      a\n    } else {\n      match smt.merge_data(mut vc, c, ta, x, tb, y) {\n        Some(v) => v,\n        None => match (smt.sort_of(mut vc, ta), smt.sort_of(mut vc, tb)) {\n          // terms of two datatypes (`Tree[K]` and an uninstantiated\n          // generic callee's `Tree[T]`): no term is both, and taking them\n          // apart would recurse forever on a recursive type\n          (Some(sa), Some(sb)) => if sa != sb {\n            smt.Opaque(\n              \"values of two different datatypes were merged\",\n            )\n          } else {\n            fa := smt.force(mut vc, a)\n            fb := smt.force(mut vc, b)\n            smt.merge(mut vc, c, fa, fb)\n          },\n          _ => {\n            fa := smt.force(mut vc, a)\n            fb := smt.force(mut vc, b)\n            smt.merge(mut vc, c, fa, fb)\n          },\n        },\n      }\n    },\n    (smt.Opaque(r), smt.VData { .. }) | (smt.VData { .. }, smt.Opaque(r)) => smt.Opaque(r),\n    (smt.VData { .. }, _) | (_, smt.VData { .. }) => {\n      fa := smt.force(mut vc, a)\n      fb := smt.force(mut vc, b)\n      smt.merge(mut vc, c, fa, fb)\n    },\n    (smt.VInt(x), smt.VInt(y)) => smt.VInt(smt.ite(c, x, y)),\n    (smt.VBool(x), smt.VBool(y)) => smt.VBool(smt.ite(c, x, y)),\n    (smt.VStr(x), smt.VStr(y)) => smt.VStr(smt.ite(c, x, y)),\n    (smt.VInt(x), smt.Opaque(r)) => smt.VInt(smt.ite(c, x, smt.fresh_why(mut vc, \"Int\", r))),\n    (smt.Opaque(r), smt.VInt(y)) => smt.VInt(smt.ite(c, smt.fresh_why(mut vc, \"Int\", r), y)),\n    (smt.VBool(x), smt.Opaque(r)) => smt.VBool(smt.ite(c, x, smt.fresh_why(mut vc, \"Bool\", r))),\n    (smt.Opaque(r), smt.VBool(y)) => smt.VBool(smt.ite(c, smt.fresh_why(mut vc, \"Bool\", r), y)),\n    (smt.VStr(x), smt.Opaque(r)) => smt.VStr(smt.ite(c, x, smt.fresh_why(mut vc, \"String\", r))),\n    (smt.Opaque(r), smt.VStr(y)) => smt.VStr(smt.ite(c, smt.fresh_why(mut vc, \"String\", r), y)),\n    (smt.UnitVal, smt.UnitVal) => smt.UnitVal,\n    (smt.VTuple(xs), smt.VTuple(ys)) => if len(xs) == len(ys) {\n      mut out := []\n      for (i, x) in enumerate(xs) {\n        mut out.push(\n          smt.merge(mut vc, c, x, get(ys, i) ?? smt.Inactive),\n        )\n      }\n      smt.VTuple(out)\n    } else {\n      smt.different(mut vc, c, a, b)\n    },\n    (smt.VRec { name: n, fields: xs }, smt.VRec { name: m, fields: ys }) => if n == m {\n      mut out := []\n      for (i, x) in enumerate(xs) {\n        y := (get(ys, i) ?? (\"\", smt.Inactive)).1\n        mut out.push((x.0, smt.merge(mut vc, c, x.1, y)))\n      }\n      smt.VRec { name: n, fields: out }\n    } else {\n      smt.different(mut vc, c, a, b)\n    },\n    (smt.VSum { ty, args, tag: t1, ctors: c1 }, smt.VSum { ty: ty2, args: args2, tag: t2, ctors: c2 }) => if ty == ty2 {\n      mut ctors := []\n      for (k, x) in enumerate(c1) {\n        ys := (get(c2, k) ?? (\"\", [])).1\n        mut payload := []\n        for (i, p) in enumerate(x.1) {\n          mut payload.push(\n            smt.merge(mut vc, c, p, get(ys, i) ?? smt.Inactive),\n          )\n        }\n        mut ctors.push((x.0, payload))\n      }\n      smt.VSum { ty, args: if len(args) == 0 {\n        args2\n      } else {\n        args\n      }, tag: smt.ite(c, t1, t2), ctors }\n    } else {\n      smt.different(mut vc, c, a, b)\n    },\n    (smt.VList { len: l1, id: i1 }, smt.VList { len: l2, id: i2 }) => if i1 == i2 {\n      smt.VList {\n        len: smt.share(mut vc, \"Int\", smt.ite(c, l1, l2)),\n        id: i1,\n      }\n    } else {\n      match (smt.map_of(mut vc, a), smt.map_of(mut vc, b)) {\n        // dicts or sets: the array of either\n        (Some((x, t, m1)), Some((y, _, m2))) => if m1.arr == m2.arr {\n          return smt.keyed_array(\n            mut vc,\n            t,\n            m1,\n            smt.share(mut vc, m1.arr, smt.ite(c, x, y)),\n          )\n        },\n        _ => (),\n      }\n      sc := smt.share(mut vc, \"Bool\", c)\n      l := smt.share(mut vc, \"Int\", smt.ite(sc, l1, l2))\n      smt.new_list(mut vc, l, smt.GEither(sc, i1, i2))\n    },\n    (smt.VDistinct { name: n, inner: x }, smt.VDistinct { name: m, inner: y }) => if n == m {\n      smt.VDistinct { name: n, inner: smt.merge(mut vc, c, x, y) }\n    } else {\n      smt.different(mut vc, c, a, b)\n    },\n    (smt.Opaque(r), _) | (_, smt.Opaque(r)) => smt.Opaque(r),\n    _ => smt.different(mut vc, c, a, b),\n  }\n}","old_text":"fn merge(mut vc: smt.Vc, c: String, a: smt.Val, b: smt.Val) -> smt.Val {\n  match (a, b) {\n    (smt.Inactive, x) | (x, smt.Inactive) => x,\n    (smt.VData { ty: ta, t: x }, smt.VData { ty: tb, t: y }) => if x == y && ta == tb {\n      a\n    } else {\n      match smt.merge_data(mut vc, c, ta, x, tb, y) {\n        Some(v) => v,\n        None => match (smt.sort_of(mut vc, ta), smt.sort_of(mut vc, tb)) {\n          // terms of two datatypes (`Tree[K]` and a generic callee's\n          // `Tree[T]`, not instantiated): no term is either, and taking\n          // them apart would go down a recursive type forever\n          (Some(sa), Some(sb)) => if sa != sb {\n            smt.Opaque(\n              \"values of two different datatypes were merged\",\n            )\n          } else {\n            fa := smt.force(mut vc, a)\n            fb := smt.force(mut vc, b)\n            smt.merge(mut vc, c, fa, fb)\n          },\n          _ => {\n            fa := smt.force(mut vc, a)\n            fb := smt.force(mut vc, b)\n            smt.merge(mut vc, c, fa, fb)\n          },\n        },\n      }\n    },\n    (smt.Opaque(r), smt.VData { .. }) | (smt.VData { .. }, smt.Opaque(r)) => smt.Opaque(r),\n    (smt.VData { .. }, _) | (_, smt.VData { .. }) => {\n      fa := smt.force(mut vc, a)\n      fb := smt.force(mut vc, b)\n      smt.merge(mut vc, c, fa, fb)\n    },\n    (smt.VInt(x), smt.VInt(y)) => smt.VInt(smt.ite(c, x, y)),\n    (smt.VBool(x), smt.VBool(y)) => smt.VBool(smt.ite(c, x, y)),\n    (smt.VStr(x), smt.VStr(y)) => smt.VStr(smt.ite(c, x, y)),\n    (smt.VInt(x), smt.Opaque(r)) => smt.VInt(smt.ite(c, x, smt.fresh_why(mut vc, \"Int\", r))),\n    (smt.Opaque(r), smt.VInt(y)) => smt.VInt(smt.ite(c, smt.fresh_why(mut vc, \"Int\", r), y)),\n    (smt.VBool(x), smt.Opaque(r)) => smt.VBool(smt.ite(c, x, smt.fresh_why(mut vc, \"Bool\", r))),\n    (smt.Opaque(r), smt.VBool(y)) => smt.VBool(smt.ite(c, smt.fresh_why(mut vc, \"Bool\", r), y)),\n    (smt.VStr(x), smt.Opaque(r)) => smt.VStr(smt.ite(c, x, smt.fresh_why(mut vc, \"String\", r))),\n    (smt.Opaque(r), smt.VStr(y)) => smt.VStr(smt.ite(c, smt.fresh_why(mut vc, \"String\", r), y)),\n    (smt.UnitVal, smt.UnitVal) => smt.UnitVal,\n    (smt.VTuple(xs), smt.VTuple(ys)) => if len(xs) == len(ys) {\n      mut out := []\n      for (i, x) in enumerate(xs) {\n        mut out.push(\n          smt.merge(mut vc, c, x, get(ys, i) ?? smt.Inactive),\n        )\n      }\n      smt.VTuple(out)\n    } else {\n      smt.different(mut vc, c, a, b)\n    },\n    (smt.VRec { name: n, fields: xs }, smt.VRec { name: m, fields: ys }) => if n == m {\n      mut out := []\n      for (i, x) in enumerate(xs) {\n        y := (get(ys, i) ?? (\"\", smt.Inactive)).1\n        mut out.push((x.0, smt.merge(mut vc, c, x.1, y)))\n      }\n      smt.VRec { name: n, fields: out }\n    } else {\n      smt.different(mut vc, c, a, b)\n    },\n    (smt.VSum { ty, args, tag: t1, ctors: c1 }, smt.VSum { ty: ty2, args: args2, tag: t2, ctors: c2 }) => if ty == ty2 {\n      mut ctors := []\n      for (k, x) in enumerate(c1) {\n        ys := (get(c2, k) ?? (\"\", [])).1\n        mut payload := []\n        for (i, p) in enumerate(x.1) {\n          mut payload.push(\n            smt.merge(mut vc, c, p, get(ys, i) ?? smt.Inactive),\n          )\n        }\n        mut ctors.push((x.0, payload))\n      }\n      smt.VSum { ty, args: if len(args) == 0 {\n        args2\n      } else {\n        args\n      }, tag: smt.ite(c, t1, t2), ctors }\n    } else {\n      smt.different(mut vc, c, a, b)\n    },\n    (smt.VList { len: l1, id: i1 }, smt.VList { len: l2, id: i2 }) => if i1 == i2 {\n      smt.VList {\n        len: smt.share(mut vc, \"Int\", smt.ite(c, l1, l2)),\n        id: i1,\n      }\n    } else {\n      match (smt.map_of(mut vc, a), smt.map_of(mut vc, b)) {\n        // dicts or sets: the array of either\n        (Some((x, t, m1)), Some((y, _, m2))) => if m1.arr == m2.arr {\n          return smt.keyed_array(\n            mut vc,\n            t,\n            m1,\n            smt.share(mut vc, m1.arr, smt.ite(c, x, y)),\n          )\n        },\n        _ => (),\n      }\n      sc := smt.share(mut vc, \"Bool\", c)\n      l := smt.share(mut vc, \"Int\", smt.ite(sc, l1, l2))\n      smt.new_list(mut vc, l, smt.GEither(sc, i1, i2))\n    },\n    (smt.VDistinct { name: n, inner: x }, smt.VDistinct { name: m, inner: y }) => if n == m {\n      smt.VDistinct { name: n, inner: smt.merge(mut vc, c, x, y) }\n    } else {\n      smt.different(mut vc, c, a, b)\n    },\n    (smt.Opaque(r), _) | (_, smt.Opaque(r)) => smt.Opaque(r),\n    _ => smt.different(mut vc, c, a, b),\n  }\n}"},{"name":"smt.branches","kind":"fn","old":"ecbd7733ad6c22c4","new":"6ee5aeeefdfaf22b","interface_changed":false,"affected":[],"module":"smt","text":"/// Runs alternative branches (guard, bindings, body) and merges them.\nfn branches(\n  mut vc: smt.Vc,\n  arms: List[(String, List[(String, smt.Val)], ast.Expr)],\n) -> smt.Val {\n  smt.branches_narrowed(mut vc, arms, [])\n}","old_text":"/// Alternative branches (guard, bindings, body), run and merged.\nfn branches(\n  mut vc: smt.Vc,\n  arms: List[(String, List[(String, smt.Val)], ast.Expr)],\n) -> smt.Val {\n  smt.branches_narrowed(mut vc, arms, [])\n}"},{"name":"smt.eq","kind":"fn","old":"d6fef676722a2144","new":"3568e22020b82a79","interface_changed":false,"affected":[],"module":"smt","text":"fn eq(mut vc: smt.Vc, a: smt.Val, b: smt.Val) -> String {\n  match (a, b) {\n    // the payload of a constructor the value doesn't have is meaningless:\n    // each payload's equality is under its tag\n    (smt.Inactive, _) | (_, smt.Inactive) => \"true\",\n    (smt.VData { ty: ta, t: x }, smt.VData { ty: tb, t: y }) => if x == y {\n      \"true\"\n    } else {\n      sa := smt.sort_of(mut vc, ta)\n      sb := smt.sort_of(mut vc, tb)\n      if sa != None && sa == sb {\n        f\"(= {x} {y})\"\n      } else {\n        // two terms of different sorts (`Tree[T]` and `Tree[Int]`): taken\n        // apart at most 3 levels, since a recursive type has no end\n        if sa != None && sb != None && vc.data_eq >= 3 {\n          return smt.unknown_bool(\n            mut vc,\n            \"comparing values of different types\",\n          )\n        }\n        fa := smt.force(mut vc, a)\n        fb := smt.force(mut vc, b)\n        if fa == a && fb == b {\n          return smt.unknown_bool(\n            mut vc,\n            \"values of a generic type are not known\",\n          )\n        }\n        vc.data_eq += 1\n        r := smt.eq(mut vc, fa, fb)\n        vc.data_eq -= 1\n        r\n      }\n    },\n    (smt.Opaque(r), smt.VData { .. }) | (smt.VData { .. }, smt.Opaque(r)) => smt.unknown_bool(mut vc, r),\n    (smt.VData { .. }, _) | (_, smt.VData { .. }) => {\n      fa := smt.force(mut vc, a)\n      fb := smt.force(mut vc, b)\n      if fa == a && fb == b {\n        // a type parameter's value compared with a value of another\n        // shape: a term nothing more is known of\n        return smt.unknown_bool(\n          mut vc,\n          \"values of a generic type are not known\",\n        )\n      }\n      smt.eq(mut vc, fa, fb)\n    },\n    (smt.VInt(x), smt.VInt(y)) | (smt.VBool(x), smt.VBool(y)) | (smt.VStr(x), smt.VStr(y)) => f\"(= {x} {y})\",\n    (smt.VInt(x), smt.Opaque(_)) => f\"(= {x} {smt.as_int(mut vc, b)})\",\n    (smt.Opaque(_), smt.VInt(x)) => f\"(= {x} {smt.as_int(mut vc, a)})\",\n    (smt.VStr(x), smt.Opaque(_)) => f\"(= {x} {smt.as_str(mut vc, b)})\",\n    (smt.Opaque(_), smt.VStr(x)) => f\"(= {x} {smt.as_str(mut vc, a)})\",\n    (smt.VBool(x), smt.Opaque(_)) => f\"(= {x} {smt.as_bool(mut vc, b)})\",\n    (smt.Opaque(_), smt.VBool(x)) => f\"(= {x} {smt.as_bool(mut vc, a)})\",\n    (smt.UnitVal, smt.UnitVal) => \"true\",\n    (smt.VTuple(xs), smt.VTuple(ys)) => if len(xs) == len(ys) {\n      mut cs := []\n      for (i, x) in enumerate(xs) {\n        mut cs.push(smt.eq(mut vc, x, get(ys, i) ?? smt.Inactive))\n      }\n      smt.and_all(cs)\n    } else {\n      smt.unknown_bool(\n        mut vc,\n        \"comparing values of different shapes\",\n      )\n    },\n    (smt.VRec { name: n, fields: xs }, smt.VRec { name: m, fields: ys }) => if n == m {\n      mut cs := []\n      for (i, x) in enumerate(xs) {\n        mut cs.push(\n          smt.eq(mut vc, x.1, (get(ys, i) ?? (\"\", smt.Inactive)).1),\n        )\n      }\n      smt.and_all(cs)\n    } else {\n      smt.unknown_bool(\n        mut vc,\n        \"comparing values of different shapes\",\n      )\n    },\n    (smt.VDistinct { name: n, inner: x }, smt.VDistinct { name: m, inner: y }) => if n == m {\n      smt.eq(mut vc, x, y)\n    } else {\n      smt.unknown_bool(\n        mut vc,\n        \"comparing values of different shapes\",\n      )\n    },\n    (smt.VSum { ty, tag: t1, ctors: c1, .. }, smt.VSum { ty: ty2, tag: t2, ctors: c2, .. }) => if ty == ty2 {\n      mut cs := [f\"(= {t1} {t2})\"]\n      for (k, x) in enumerate(c1) {\n        ys := (get(c2, k) ?? (\"\", [])).1\n        mut fe := []\n        for (i, p) in enumerate(x.1) {\n          mut fe.push(smt.eq(mut vc, p, get(ys, i) ?? smt.Inactive))\n        }\n        all := smt.and_all(fe)\n        if all != \"true\" {\n          mut cs.push(smt.implies(f\"(= {t1} {k})\", all))\n        }\n      }\n      smt.and_all(cs)\n    } else {\n      smt.unknown_bool(\n        mut vc,\n        \"comparing values of different shapes\",\n      )\n    },\n    (smt.VList { len: l1, id: i1 }, smt.VList { len: l2, id: i2 }) => match (smt.map_of(mut vc, a), smt.map_of(mut vc, b)) {\n      // dicts or sets: the same entries (extensionality)\n      (Some((x, _, m1)), Some((y, _, m2))) => if m1.arr == m2.arr {\n        f\"(= {x} {y})\"\n      } else {\n        smt.eq_list_values(mut vc, l1, i1, l2, i2)\n      },\n      _ => smt.eq_list_values(mut vc, l1, i1, l2, i2),\n    },\n    (smt.Opaque(r), _) | (_, smt.Opaque(r)) => smt.unknown_bool(mut vc, r),\n    // union values are equal when they have the same shape and equal\n    // values of it\n    (smt.VUnion { .. }, _) | (_, smt.VUnion { .. }) => smt.eq_union(mut vc, a, b),\n    _ => smt.unknown_bool(mut vc, \"comparing values of different shapes\"),\n  }\n}","old_text":"fn eq(mut vc: smt.Vc, a: smt.Val, b: smt.Val) -> String {\n  match (a, b) {\n    // the payload of a constructor the value doesn't have: what it is\n    // means nothing (each payload's equality is under its tag)\n    (smt.Inactive, _) | (_, smt.Inactive) => \"true\",\n    (smt.VData { ty: ta, t: x }, smt.VData { ty: tb, t: y }) => if x == y {\n      \"true\"\n    } else {\n      sa := smt.sort_of(mut vc, ta)\n      sb := smt.sort_of(mut vc, tb)\n      if sa != None && sa == sb {\n        f\"(= {x} {y})\"\n      } else {\n        // two terms of different sorts (`Tree[T]` and `Tree[Int]`): taken\n        // apart a few levels, not forever (a recursive type has no end)\n        if sa != None && sb != None && vc.data_eq >= 3 {\n          return smt.unknown_bool(\n            mut vc,\n            \"comparing values of different types\",\n          )\n        }\n        fa := smt.force(mut vc, a)\n        fb := smt.force(mut vc, b)\n        if fa == a && fb == b {\n          return smt.unknown_bool(\n            mut vc,\n            \"values of a generic type are not known\",\n          )\n        }\n        vc.data_eq += 1\n        r := smt.eq(mut vc, fa, fb)\n        vc.data_eq -= 1\n        r\n      }\n    },\n    (smt.Opaque(r), smt.VData { .. }) | (smt.VData { .. }, smt.Opaque(r)) => smt.unknown_bool(mut vc, r),\n    (smt.VData { .. }, _) | (_, smt.VData { .. }) => {\n      fa := smt.force(mut vc, a)\n      fb := smt.force(mut vc, b)\n      if fa == a && fb == b {\n        // (a type parameter's value, compared with a value of another\n        // shape: a term nothing more is known of)\n        return smt.unknown_bool(\n          mut vc,\n          \"values of a generic type are not known\",\n        )\n      }\n      smt.eq(mut vc, fa, fb)\n    },\n    (smt.VInt(x), smt.VInt(y)) | (smt.VBool(x), smt.VBool(y)) | (smt.VStr(x), smt.VStr(y)) => f\"(= {x} {y})\",\n    (smt.VInt(x), smt.Opaque(_)) => f\"(= {x} {smt.as_int(mut vc, b)})\",\n    (smt.Opaque(_), smt.VInt(x)) => f\"(= {x} {smt.as_int(mut vc, a)})\",\n    (smt.VStr(x), smt.Opaque(_)) => f\"(= {x} {smt.as_str(mut vc, b)})\",\n    (smt.Opaque(_), smt.VStr(x)) => f\"(= {x} {smt.as_str(mut vc, a)})\",\n    (smt.VBool(x), smt.Opaque(_)) => f\"(= {x} {smt.as_bool(mut vc, b)})\",\n    (smt.Opaque(_), smt.VBool(x)) => f\"(= {x} {smt.as_bool(mut vc, a)})\",\n    (smt.UnitVal, smt.UnitVal) => \"true\",\n    (smt.VTuple(xs), smt.VTuple(ys)) => if len(xs) == len(ys) {\n      mut cs := []\n      for (i, x) in enumerate(xs) {\n        mut cs.push(smt.eq(mut vc, x, get(ys, i) ?? smt.Inactive))\n      }\n      smt.and_all(cs)\n    } else {\n      smt.unknown_bool(\n        mut vc,\n        \"comparing values of different shapes\",\n      )\n    },\n    (smt.VRec { name: n, fields: xs }, smt.VRec { name: m, fields: ys }) => if n == m {\n      mut cs := []\n      for (i, x) in enumerate(xs) {\n        mut cs.push(\n          smt.eq(mut vc, x.1, (get(ys, i) ?? (\"\", smt.Inactive)).1),\n        )\n      }\n      smt.and_all(cs)\n    } else {\n      smt.unknown_bool(\n        mut vc,\n        \"comparing values of different shapes\",\n      )\n    },\n    (smt.VDistinct { name: n, inner: x }, smt.VDistinct { name: m, inner: y }) => if n == m {\n      smt.eq(mut vc, x, y)\n    } else {\n      smt.unknown_bool(\n        mut vc,\n        \"comparing values of different shapes\",\n      )\n    },\n    (smt.VSum { ty, tag: t1, ctors: c1, .. }, smt.VSum { ty: ty2, tag: t2, ctors: c2, .. }) => if ty == ty2 {\n      mut cs := [f\"(= {t1} {t2})\"]\n      for (k, x) in enumerate(c1) {\n        ys := (get(c2, k) ?? (\"\", [])).1\n        mut fe := []\n        for (i, p) in enumerate(x.1) {\n          mut fe.push(smt.eq(mut vc, p, get(ys, i) ?? smt.Inactive))\n        }\n        all := smt.and_all(fe)\n        if all != \"true\" {\n          mut cs.push(smt.implies(f\"(= {t1} {k})\", all))\n        }\n      }\n      smt.and_all(cs)\n    } else {\n      smt.unknown_bool(\n        mut vc,\n        \"comparing values of different shapes\",\n      )\n    },\n    (smt.VList { len: l1, id: i1 }, smt.VList { len: l2, id: i2 }) => match (smt.map_of(mut vc, a), smt.map_of(mut vc, b)) {\n      // dicts or sets: the same entries (extensionality)\n      (Some((x, _, m1)), Some((y, _, m2))) => if m1.arr == m2.arr {\n        f\"(= {x} {y})\"\n      } else {\n        smt.eq_list_values(mut vc, l1, i1, l2, i2)\n      },\n      _ => smt.eq_list_values(mut vc, l1, i1, l2, i2),\n    },\n    (smt.Opaque(r), _) | (_, smt.Opaque(r)) => smt.unknown_bool(mut vc, r),\n    // union values are equal when they have the same shape and equal values\n    // of it\n    (smt.VUnion { .. }, _) | (_, smt.VUnion { .. }) => smt.eq_union(mut vc, a, b),\n    _ => smt.unknown_bool(mut vc, \"comparing values of different shapes\"),\n  }\n}"},{"name":"smt.arith","kind":"fn","old":"35ccc884aecf35b3","new":"449397917bea1ecd","interface_changed":false,"affected":[],"module":"smt","text":"fn arith(mut vc: smt.Vc, op: ast.BinOp, a: smt.Val, b: smt.Val) -> smt.Val {\n  if !smt.is_int(a) && !smt.is_int(b) {\n    r := smt.opaque_reason(a, b)\n    // float arithmetic faults on a non-finite result, and an unknown value\n    // may be an Int divided by zero: not known to hold\n    if smt.start_goal(mut vc) {\n      g := smt.unknown_bool(mut vc, r)\n      smt.oblige(\n        mut vc,\n        f\"`{text.op_text(op)}` gives a finite number\",\n        g,\n      )\n    }\n    return smt.Opaque(r)\n  }\n  x := smt.as_int(mut vc, a)\n  y := smt.as_int(mut vc, b)\n  smt.VInt(match op {\n    ast.Add => f\"(+ {x} {y})\",\n    ast.Sub => f\"(- {x} {y})\",\n    ast.Mul => f\"(* {x} {y})\",\n    _ => {\n      if parse_int(y) ?? 0 == 0 {\n        if smt.start_goal(mut vc) {\n          smt.oblige(\n            mut vc,\n            \"no division by zero\",\n            f\"(not (= {y} 0))\",\n          )\n        }\n      }\n      name := if op == ast.Div {\n        \"div\"\n      } else {\n        \"mod\"\n      }\n      f\"({name} {x} {y})\"\n    },\n  })\n}","old_text":"fn arith(mut vc: smt.Vc, op: ast.BinOp, a: smt.Val, b: smt.Val) -> smt.Val {\n  if !smt.is_int(a) && !smt.is_int(b) {\n    r := smt.opaque_reason(a, b)\n    // float arithmetic faults on a result that isn't finite (and an\n    // unknown value may be an Int divided by zero): not known to hold\n    if smt.start_goal(mut vc) {\n      g := smt.unknown_bool(mut vc, r)\n      smt.oblige(\n        mut vc,\n        f\"`{text.op_text(op)}` gives a finite number\",\n        g,\n      )\n    }\n    return smt.Opaque(r)\n  }\n  x := smt.as_int(mut vc, a)\n  y := smt.as_int(mut vc, b)\n  smt.VInt(match op {\n    ast.Add => f\"(+ {x} {y})\",\n    ast.Sub => f\"(- {x} {y})\",\n    ast.Mul => f\"(* {x} {y})\",\n    _ => {\n      if parse_int(y) ?? 0 == 0 {\n        if smt.start_goal(mut vc) {\n          smt.oblige(\n            mut vc,\n            \"no division by zero\",\n            f\"(not (= {y} 0))\",\n          )\n        }\n      }\n      name := if op == ast.Div {\n        \"div\"\n      } else {\n        \"mod\"\n      }\n      f\"({name} {x} {y})\"\n    },\n  })\n}"},{"name":"smt.pow2","kind":"fn","old":"d155ca8cfc1a7284","new":"30e9d002cb9edc9b","interface_changed":false,"affected":[],"module":"smt","text":"/// 2 to the power `k` (`k >= 0`).\nfn pow2(k: Int) -> Int {\n  if k <= 0 {\n    1\n  } else {\n    1 << k\n  }\n}","old_text":"/// 2 to the power `k` (0 <= k).\nfn pow2(k: Int) -> Int {\n  if k <= 0 {\n    1\n  } else {\n    1 << k\n  }\n}"},{"name":"smt.mask_bits","kind":"fn","old":"95bfe1f1d3a93630","new":"7b61403f811b86ce","interface_changed":false,"affected":[],"module":"smt","text":"/// `k` when `m` is `2^k - 1`, a mask of the low `k` bits (`m > 0`).\nfn mask_bits(m: Int) -> Option[Int] {\n  if m <= 0 || (m & m + 1) != 0 {\n    return None\n  }\n  mut k := 0\n  mut x := m + 1\n  while x > 1 && x % 2 == 0 {\n    x /= 2\n    k += 1\n  }\n  Some(k)\n}","old_text":"/// `k` when `m` is `2^k - 1` (a mask of the low `k` bits, `m > 0`).\nfn mask_bits(m: Int) -> Option[Int] {\n  if m <= 0 || (m & m + 1) != 0 {\n    return None\n  }\n  mut k := 0\n  mut x := m + 1\n  while x > 1 && x % 2 == 0 {\n    x /= 2\n    k += 1\n  }\n  Some(k)\n}"},{"name":"smt.bits","kind":"fn","old":"79f1779d3d950592","new":"05e453760d73cde8","interface_changed":false,"affected":[],"module":"smt","text":"/// `&`, `|`, `^`, `<<`, `>>`. Exact where SMT-LIB integers can express it:\n/// a shift by a literal is `*` or `div` by a power of two, `x & (2^k - 1)`\n/// is `x mod 2^k`, and two literals are computed. Otherwise a fresh integer\n/// with what holds for non-negative operands.\nfn bits(mut vc: smt.Vc, op: ast.BinOp, a: smt.Val, b: smt.Val) -> smt.Val {\n  if !smt.is_int(a) && !smt.is_int(b) {\n    return smt.Opaque(smt.opaque_reason(a, b))\n  }\n  x := smt.as_int(mut vc, a)\n  y := smt.as_int(mut vc, b)\n  if op == ast.Shl || op == ast.Shr {\n    k := parse_int(y)\n    if k ?? -1 < 0 {\n      if smt.start_goal(mut vc) {\n        smt.oblige(\n          mut vc,\n          f\"`{text.op_text(op)}` by a non-negative number of bits\",\n          f\"(>= {y} 0)\",\n        )\n      }\n    }\n    n := k ?? -1\n    if 0 <= n && n <= 4096 {\n      return smt.VInt(if op == ast.Shl {\n        f\"(* {x} {smt.pow2(n)})\"\n      } else {\n        f\"(div {x} {smt.pow2(n)})\"\n      })\n    }\n  } else {\n    match (parse_int(x), parse_int(y)) {\n      (Some(m), Some(n)) => return smt.VInt(smt.num(if op == ast.BitAnd {\n        m & n\n      } else if op == ast.BitOr {\n        m | n\n      } else {\n        m ^ n\n      })),\n      _ => (),\n    }\n    if op == ast.BitAnd {\n      match smt.mask_bits(parse_int(y) ?? 0) {\n        Some(k) => return smt.VInt(f\"(mod {x} {smt.pow2(k)})\"),\n        None => (),\n      }\n      match smt.mask_bits(parse_int(x) ?? 0) {\n        Some(k) => return smt.VInt(f\"(mod {y} {smt.pow2(k)})\"),\n        None => (),\n      }\n    }\n  }\n  // the same operation on the same operands is the same value\n  key := f\"{text.op_text(op)} {x} {y}\"\n  match get(vc.bit_terms, key) {\n    Some(r) => return smt.VInt(r),\n    None => (),\n  }\n  r := smt.fresh_why(\n    mut vc,\n    \"Int\",\n    f\"`{text.op_text(op)}` is only bounded, not modelled exactly\",\n  )\n  mut vc.bit_terms.insert(key, r)\n  nonneg := f\"(and (>= {x} 0) (>= {y} 0))\"\n  fact := match op {\n    ast.BitAnd => f\"(and (=> (>= {x} 0) (and (<= 0 {r}) (<= {r} {x}))) (=> (>= {y} 0) (and (<= 0 {r}) (<= {r} {y}))))\",\n    ast.BitOr => f\"(=> {nonneg} (and (>= {r} {x}) (>= {r} {y}) (<= {r} (+ {x} {y}))))\",\n    ast.BitXor => f\"(=> {nonneg} (and (>= {r} 0) (<= {r} (+ {x} {y}))))\",\n    ast.Shl => f\"(=> (>= {x} 0) (>= {r} {x}))\",\n    _ => f\"(=> (>= {x} 0) (and (<= 0 {r}) (<= {r} {x})))\",\n  }\n  mut vc.facts.push(fact)\n  smt.VInt(r)\n}","old_text":"/// `&`, `|`, `^`, `<<`, `>>`: exact where SMT-LIB's integers can say it (a\n/// shift by a literal is `*` or `div` by a power of two, `x & (2^k - 1)` is\n/// `x mod 2^k`, two literals are computed), else a fresh integer with what\n/// holds of non-negative operands.\nfn bits(mut vc: smt.Vc, op: ast.BinOp, a: smt.Val, b: smt.Val) -> smt.Val {\n  if !smt.is_int(a) && !smt.is_int(b) {\n    return smt.Opaque(smt.opaque_reason(a, b))\n  }\n  x := smt.as_int(mut vc, a)\n  y := smt.as_int(mut vc, b)\n  if op == ast.Shl || op == ast.Shr {\n    k := parse_int(y)\n    if k ?? -1 < 0 {\n      if smt.start_goal(mut vc) {\n        smt.oblige(\n          mut vc,\n          f\"`{text.op_text(op)}` by a non-negative number of bits\",\n          f\"(>= {y} 0)\",\n        )\n      }\n    }\n    n := k ?? -1\n    if 0 <= n && n <= 4096 {\n      return smt.VInt(if op == ast.Shl {\n        f\"(* {x} {smt.pow2(n)})\"\n      } else {\n        f\"(div {x} {smt.pow2(n)})\"\n      })\n    }\n  } else {\n    match (parse_int(x), parse_int(y)) {\n      (Some(m), Some(n)) => return smt.VInt(smt.num(if op == ast.BitAnd {\n        m & n\n      } else if op == ast.BitOr {\n        m | n\n      } else {\n        m ^ n\n      })),\n      _ => (),\n    }\n    if op == ast.BitAnd {\n      match smt.mask_bits(parse_int(y) ?? 0) {\n        Some(k) => return smt.VInt(f\"(mod {x} {smt.pow2(k)})\"),\n        None => (),\n      }\n      match smt.mask_bits(parse_int(x) ?? 0) {\n        Some(k) => return smt.VInt(f\"(mod {y} {smt.pow2(k)})\"),\n        None => (),\n      }\n    }\n  }\n  // the same operation on the same operands is the same value\n  key := f\"{text.op_text(op)} {x} {y}\"\n  match get(vc.bit_terms, key) {\n    Some(r) => return smt.VInt(r),\n    None => (),\n  }\n  r := smt.fresh_why(\n    mut vc,\n    \"Int\",\n    f\"`{text.op_text(op)}` is only bounded, not modelled exactly\",\n  )\n  mut vc.bit_terms.insert(key, r)\n  nonneg := f\"(and (>= {x} 0) (>= {y} 0))\"\n  fact := match op {\n    ast.BitAnd => f\"(and (=> (>= {x} 0) (and (<= 0 {r}) (<= {r} {x}))) (=> (>= {y} 0) (and (<= 0 {r}) (<= {r} {y}))))\",\n    ast.BitOr => f\"(=> {nonneg} (and (>= {r} {x}) (>= {r} {y}) (<= {r} (+ {x} {y}))))\",\n    ast.BitXor => f\"(=> {nonneg} (and (>= {r} 0) (<= {r} (+ {x} {y}))))\",\n    ast.Shl => f\"(=> (>= {x} 0) (>= {r} {x}))\",\n    _ => f\"(=> (>= {x} 0) (and (<= 0 {r}) (<= {r} {x})))\",\n  }\n  mut vc.facts.push(fact)\n  smt.VInt(r)\n}"},{"name":"smt.eval","kind":"fn","old":"fabb29f530ea1a17","new":"87af04206eed9cef","interface_changed":false,"affected":[],"module":"smt","text":"// ---- expressions ----\n\n/// The value of `e`, unfolded if it is a datatype term.\npub fn eval(mut vc: smt.Vc, e: ast.Expr) -> smt.Val {\n  // the polarity (`Vc.polarity`) is this expression's. Its parts get none\n  // unless `eval_expr` passes it on (`!`, `&&`, `||`, `==>`, branches, a\n  // block's value, a call seen through).\n  pol := vc.polarity\n  vc.polarity = 0\n  v := smt.eval_expr(mut vc, e, pol)\n  vc.polarity = pol\n  f := smt.force(mut vc, v)\n  // a type parameter's value stays a plain term. Equal terms are equal\n  // values, so a method's result on it is the same (`c.total()` before and\n  // after `mut c.incr()`).\n  match (v, f) {\n    (smt.VData { .. }, smt.Opaque(r)) => if starts_with(r, \"values of the generic type\") {\n      v\n    } else {\n      f\n    },\n    _ => f,\n  }\n}","old_text":"// ---- expressions ----\n\n/// The value of `e`, unfolded if it is a datatype term.\npub fn eval(mut vc: smt.Vc, e: ast.Expr) -> smt.Val {\n  // the polarity is this expression's (`Vc.polarity`): its parts are made\n  // with none, unless `eval_expr` passes it on (`!`, `&&`, `||`, `==>`,\n  // branches, a block's value, a call seen through)\n  pol := vc.polarity\n  vc.polarity = 0\n  v := smt.eval_expr(mut vc, e, pol)\n  vc.polarity = pol\n  f := smt.force(mut vc, v)\n  // (a type parameter's value stays the term it is, nothing more known of\n  // it: equal terms are equal values, so a method's result on it is the\n  // same, `c.total()` before and after `mut c.incr()`)\n  match (v, f) {\n    (smt.VData { .. }, smt.Opaque(r)) => if starts_with(r, \"values of the generic type\") {\n      v\n    } else {\n      f\n    },\n    _ => f,\n  }\n}"},{"name":"smt.not_modelled","kind":"fn","old":"452c46127c5442d3","new":"1369f1e66e2efb37","interface_changed":false,"affected":[],"module":"smt","text":"/// The name of an expression kind, for a message saying it is not\n/// modelled.\nfn not_modelled(e: ast.Expr) -> String {\n  match e {\n    ast.TupleExpr(_) => \"tuples\",\n    ast.ListExpr(_) => \"lists\",\n    ast.CtorExpr { .. } => \"constructors\",\n    ast.FieldOf { .. } => \"fields\",\n    ast.Lambda { .. } => \"lambdas\",\n    ast.IsExpr { .. } => \"`is`\",\n    ast.MatchExpr { .. } => \"`match`\",\n    ast.Try { .. } => \"`!` and `?`\",\n    ast.Except { .. } => \"`except`\",\n    ast.Fallback { .. } => \"`??`\",\n    _ => \"this expression\",\n  }\n}","old_text":"/// What step 1 doesn't model, by the kind of expression.\nfn not_modelled(e: ast.Expr) -> String {\n  match e {\n    ast.TupleExpr(_) => \"tuples\",\n    ast.ListExpr(_) => \"lists\",\n    ast.CtorExpr { .. } => \"constructors\",\n    ast.FieldOf { .. } => \"fields\",\n    ast.Lambda { .. } => \"lambdas\",\n    ast.IsExpr { .. } => \"`is`\",\n    ast.MatchExpr { .. } => \"`match`\",\n    ast.Try { .. } => \"`!` and `?`\",\n    ast.Except { .. } => \"`except`\",\n    ast.Fallback { .. } => \"`??`\",\n    _ => \"this expression\",\n  }\n}"},{"name":"smt.call_exprs","kind":"fn","old":"fbae418ee3d42885","new":"e0a5f8fc4ead8756","interface_changed":false,"affected":[],"module":"smt","text":"fn call_exprs(mut vc: smt.Vc, name: String, exprs: List[ast.Expr]) -> smt.Val {\n  // the call's polarity (`Vc.polarity`), kept from calls in its arguments\n  pol := vc.call_pol\n  vc.call_pol = 0\n  mut vals := []\n  for e in exprs {\n    mut vals.push(\n      if smt.is_fn(vc, e) {\n        None\n      } else {\n        match (name, smt.string_unit(e)) {\n          // `len(s.bytes())`: the units of a string, a prelude method's\n          // result that is not modelled, read through `s` by `call`\n          (\"len\", Some((_, s))) => {\n            _ := smt.eval(mut vc, s)\n            Some(smt.Opaque(\"a string's units\"))\n          },\n          _ => Some(smt.eval(mut vc, e)),\n        }\n      },\n    )\n  }\n  builtin := !contains(vc.fns, name)\n  for (i, e) in enumerate(exprs) {\n    if get(vals, i) ?? None == None && vc.spec > 0 {\n      // in a contract nothing is checked and the function isn't run; what\n      // it does is in `fn_args`\n      vals = take(vals, i)\n        + [Some(smt.Opaque(\"function values are not modelled\"))]\n        + drop(vals, i + 1)\n    } else if get(vals, i) ?? None == None {\n      // the function runs on the elements, if there are any, so its checks\n      // hold under that condition\n      mut exists := None\n      mut elem := None\n      match get(vals, 0) ?? None {\n        Some(smt.VList { len, id }) => if builtin && i > 0 {\n          ex := f\"(> {len} 0)\"\n          exists = Some(ex)\n          elem = Some(smt.element(mut vc, id, ex))\n        },\n        _ => (),\n      }\n      args := match elem {\n        Some(x) => if name == \"fold\" {\n          [smt.Opaque(\"the accumulator of `fold`\"), x]\n        } else {\n          [x]\n        },\n        // passed for a parameter of a function type: it is called with\n        // valid values of its parameter types\n        None => match get(vc.fns, name) {\n          Some(f) => match get(f.params, i) {\n            Some(p) => match p.ty {\n              ast.FnType { params, .. } => {\n                mut out := []\n                for t in params {\n                  old := vc.reason\n                  vc.reason = Some(\n                    \"an argument a function value is called with (only its type is known)\",\n                  )\n                  v := smt.shape(mut vc, t)\n                  vc.reason = old\n                  vc.spec += 1\n                  c := smt.check_type(mut vc, t, v, [])\n                  vc.spec -= 1\n                  smt.assume(mut vc, c)\n                  mut out.push(v)\n                }\n                out\n              },\n              _ => [],\n            },\n            None => [],\n          },\n          None => [],\n        },\n      }\n      n := len(vc.pc)\n      match exists {\n        Some(ex) => mut vc.pc.push(ex),\n        None => (),\n      }\n      (fv, _) := smt.fn_value(mut vc, e, args)\n      vc.pc = take(vc.pc, n)\n      vals = take(vals, i) + [Some(fv)] + drop(vals, i + 1)\n    }\n  }\n  given := vals.map(v -> v ?? smt.Opaque(\"a missing argument\"))\n  key := smt.call_key(vc, name, exprs, given)\n  mut funcs := []\n  for e in exprs {\n    mut funcs.push(\n      if smt.is_fn(vc, e) {\n        smt.func_of(vc, e)\n      } else {\n        None\n      },\n    )\n  }\n  saved := vc.fn_args\n  vc.fn_args = funcs\n  vc.call_pol = pol\n  r := smt.call(mut vc, name, exprs, given)\n  vc.fn_args = saved\n  smt.same_call(mut vc, key, r)\n  r\n}","old_text":"fn call_exprs(mut vc: smt.Vc, name: String, exprs: List[ast.Expr]) -> smt.Val {\n  // the call's polarity (`Vc.polarity`), kept from the calls in its\n  // arguments\n  pol := vc.call_pol\n  vc.call_pol = 0\n  mut vals := []\n  for e in exprs {\n    mut vals.push(\n      if smt.is_fn(vc, e) {\n        None\n      } else {\n        match (name, smt.string_unit(e)) {\n          // `len(s.bytes())`: the units of a string, a prelude method's\n          // result (not modelled), read through `s` by `call`\n          (\"len\", Some((_, s))) => {\n            _ := smt.eval(mut vc, s)\n            Some(smt.Opaque(\"a string's units\"))\n          },\n          _ => Some(smt.eval(mut vc, e)),\n        }\n      },\n    )\n  }\n  builtin := !contains(vc.fns, name)\n  for (i, e) in enumerate(exprs) {\n    if get(vals, i) ?? None == None && vc.spec > 0 {\n      // in a contract nothing is checked: the function isn't run (what\n      // it does is `fn_args`')\n      vals = take(vals, i)\n        + [Some(smt.Opaque(\"function values are not modelled\"))]\n        + drop(vals, i + 1)\n    } else if get(vals, i) ?? None == None {\n      // the function runs on the elements, if there are any: its checks\n      // hold under that\n      mut exists := None\n      mut elem := None\n      match get(vals, 0) ?? None {\n        Some(smt.VList { len, id }) => if builtin && i > 0 {\n          ex := f\"(> {len} 0)\"\n          exists = Some(ex)\n          elem = Some(smt.element(mut vc, id, ex))\n        },\n        _ => (),\n      }\n      args := match elem {\n        Some(x) => if name == \"fold\" {\n          [smt.Opaque(\"the accumulator of `fold`\"), x]\n        } else {\n          [x]\n        },\n        // passed for a parameter of a function type: it is called with\n        // valid values of its parameter types\n        None => match get(vc.fns, name) {\n          Some(f) => match get(f.params, i) {\n            Some(p) => match p.ty {\n              ast.FnType { params, .. } => {\n                mut out := []\n                for t in params {\n                  old := vc.reason\n                  vc.reason = Some(\n                    \"an argument a function value is called with (only its type is known)\",\n                  )\n                  v := smt.shape(mut vc, t)\n                  vc.reason = old\n                  vc.spec += 1\n                  c := smt.check_type(mut vc, t, v, [])\n                  vc.spec -= 1\n                  smt.assume(mut vc, c)\n                  mut out.push(v)\n                }\n                out\n              },\n              _ => [],\n            },\n            None => [],\n          },\n          None => [],\n        },\n      }\n      n := len(vc.pc)\n      match exists {\n        Some(ex) => mut vc.pc.push(ex),\n        None => (),\n      }\n      (fv, _) := smt.fn_value(mut vc, e, args)\n      vc.pc = take(vc.pc, n)\n      vals = take(vals, i) + [Some(fv)] + drop(vals, i + 1)\n    }\n  }\n  given := vals.map(v -> v ?? smt.Opaque(\"a missing argument\"))\n  key := smt.call_key(vc, name, exprs, given)\n  mut funcs := []\n  for e in exprs {\n    mut funcs.push(\n      if smt.is_fn(vc, e) {\n        smt.func_of(vc, e)\n      } else {\n        None\n      },\n    )\n  }\n  saved := vc.fn_args\n  vc.fn_args = funcs\n  vc.call_pol = pol\n  r := smt.call(mut vc, name, exprs, given)\n  vc.fn_args = saved\n  smt.same_call(mut vc, key, r)\n  r\n}"},{"name":"smt.call_key","kind":"fn","old":"be757ca62feb0660","new":"9bae1cc93bf5de1d","interface_changed":false,"affected":[],"module":"smt","text":"/// A call's identity: the callee and its arguments' values (for a lambda,\n/// its text and the values of the variables it uses). `None` when some\n/// argument is not known exactly.\nfn call_key(\n  vc: smt.Vc,\n  name: String,\n  exprs: List[ast.Expr],\n  vals: List[smt.Val],\n) -> Option[String] {\n  mut key := name + \"(\"\n  for (i, e) in enumerate(exprs) {\n    v := get(vals, i) ?? smt.Opaque(\"\")\n    match e {\n      ast.Lambda { params, body } => {\n        key += text.expr_text(e, 0)\n        for n in smt.var_names(body) {\n          if !params.any(p -> p.name == n) {\n            match smt.lookup(vc, n) {\n              Some(x) => {\n                key += \" \" + n + \"=\" + debug(x)\n              },\n              None => if !smt.is_fn(vc, ast.Var(n)) {\n                return None\n              },\n            }\n          }\n        }\n      },\n      ast.Var(n) => if smt.is_fn(vc, e) {\n        key += n\n      } else {\n        key += debug(v)\n      },\n      _ => {\n        key += debug(v)\n      },\n    }\n    key += \",\"\n  }\n  if contains(key, \"Opaque(\") {\n    None\n  } else {\n    Some(key)\n  }\n}","old_text":"/// What identifies a call: the callee and its arguments' values (for a\n/// lambda, its text and the values of the variables it uses). `None` when\n/// some argument is not known exactly.\nfn call_key(\n  vc: smt.Vc,\n  name: String,\n  exprs: List[ast.Expr],\n  vals: List[smt.Val],\n) -> Option[String] {\n  mut key := name + \"(\"\n  for (i, e) in enumerate(exprs) {\n    v := get(vals, i) ?? smt.Opaque(\"\")\n    match e {\n      ast.Lambda { params, body } => {\n        key += text.expr_text(e, 0)\n        for n in smt.var_names(body) {\n          if !params.any(p -> p.name == n) {\n            match smt.lookup(vc, n) {\n              Some(x) => {\n                key += \" \" + n + \"=\" + debug(x)\n              },\n              None => if !smt.is_fn(vc, ast.Var(n)) {\n                return None\n              },\n            }\n          }\n        }\n      },\n      ast.Var(n) => if smt.is_fn(vc, e) {\n        key += n\n      } else {\n        key += debug(v)\n      },\n      _ => {\n        key += debug(v)\n      },\n    }\n    key += \",\"\n  }\n  if contains(key, \"Opaque(\") {\n    None\n  } else {\n    Some(key)\n  }\n}"},{"name":"smt.call","kind":"fn","old":"5e150545e145cdbd","new":"a3349f214e879175","interface_changed":false,"affected":[],"module":"smt","text":"fn call(\n  mut vc: smt.Vc,\n  name: String,\n  arg_exprs: List[ast.Expr],\n  args: List[smt.Val],\n) -> smt.Val {\n  // the polarity of the call's result (`Vc.polarity`), for the body seen\n  // through or the builtin\n  pol := vc.call_pol\n  vc.call_pol = 0\n  // a `for`'s element (`for_loop`): at its position, which is in range\n  if name == \"$at\" {\n    match (get(args, 0), get(args, 1)) {\n      (Some(smt.VList { len, id }), Some(iv)) => {\n        i := smt.as_int(mut vc, iv)\n        inside := f\"(and (<= 0 {i}) (< {i} {len}))\"\n        return smt.element_at(mut vc, id, i, inside) ?? smt.element(mut vc, id, inside)\n      },\n      _ => return smt.Opaque(\"the elements of a list are not tracked\"),\n    }\n  }\n  // `len(s.code_points())` is the SMT string's length, `len(s.bytes())` its\n  // `byte_len`: both modelled on `s` itself\n  if name == \"len\" {\n    match get(arg_exprs, 0) {\n      Some(a) => match smt.string_unit(a) {\n        Some((unit, s)) => {\n          v := smt.eval(mut vc, s)\n          return if unit == \"code_points\" {\n            smt.VInt(\"(str.len \" + smt.as_str(mut vc, v) + \")\")\n          } else {\n            smt.builtin(mut vc, \"byte_len\", [s], [v])\n          }\n        },\n        None => (),\n      },\n      None => (),\n    }\n  }\n  // `len` of an iterator (a type implementing `FiniteIterator`) is its\n  // method\n  if name == \"len\" && len(args) == 1 {\n    match smt.implementation(vc, \"FiniteIterator::len\", args) {\n      Some(_) => match smt.method_call(\n        mut vc,\n        \"FiniteIterator::len\",\n        arg_exprs,\n        args,\n      ) {\n        Some(r) => return r,\n        None => (),\n      },\n      None => (),\n    }\n  }\n  match get(vc.fns, name) {\n    Some(f) => {\n      if (vc.spec > 0 || vc.see > 0) && vc.depth < 4 {\n        // in a contract or a loop's written invariant, a call is seen\n        // through to its body when it finishes and can't fail\n        if contains(vc.methods.unfold, name) {\n          match smt.rec_call(mut vc, name, f, args) {\n            Some(r) => return r,\n            None => (),\n          }\n        }\n        match get(vc.methods.seen, name) ?? smt.ContractOnly {\n          smt.SeeThrough => {\n            if contains(vc.methods.assumed, name) {\n              mut vc.relied_on.insert(name)\n            }\n            // the same call on the same values already made a list: reuse\n            // it instead of a second one said equal element by element\n            key := smt.call_key(vc, name, arg_exprs, args)\n            match key {\n              Some(k) => match get(vc.memo, k) {\n                Some(before) => match before {\n                  smt.VList { .. } => return before,\n                  _ => (),\n                },\n                None => (),\n              },\n              None => (),\n            }\n            binds := dict(zip(f.params.map(p -> p.name), args))\n            vc.depth += 1\n            vc.spec += 1\n            vc.through += 1\n            saved := vc.scopes\n            vc.scopes = [binds]\n            r := smt.eval_pol(mut vc, f.body, pol)\n            vc.scopes = saved\n            vc.through -= 1\n            vc.spec -= 1\n            vc.depth -= 1\n            // the same call in the code on the same values gave the same\n            // result: when its body is made both ways, `pol` 0\n            if pol == 0 {\n              smt.same_call(mut vc, key, r)\n            }\n            return r\n          },\n          smt.NotKnown => smt.gap(\n            mut vc,\n            f\"the call of `{name}` in a contract (whether it finishes needs a proof not ported)\",\n          ),\n          smt.ContractOnly => (),\n        }\n      }\n      r := smt.call_contract(mut vc, name, f, args)\n      smt.write_after(mut vc, f.params, arg_exprs)\n      // a function a contract sees through gives the same result on the\n      // same values, so what a contract says of its body holds of this call\n      if vc.spec == 0\n        && !f.params.any(p -> p.mutable)\n        && match get(vc.methods.seen, name) {\n          Some(smt.SeeThrough) => true,\n          _ => false,\n        } {\n        smt.same_call(\n          mut vc,\n          smt.call_key(vc, name, arg_exprs, args),\n          r,\n        )\n      }\n      r\n    },\n    None => if vc.builtins.any(b -> b.name == name) {\n      vc.call_pol = pol\n      smt.builtin(mut vc, name, arg_exprs, args)\n    } else {\n      match smt.method_call(mut vc, name, arg_exprs, args) {\n        Some(r) => r,\n        None => match keys(vc.fns).filter(k -> ends_with(k, \".\" + name)) {\n          // a module's function called as a method (`s.graphemes()` is\n          // `std.unicode.graphemes(s)`), as the resolver reads it\n          [q] => match get(vc.fns, q) {\n            // a capability's function called on one (`clock.seconds()`):\n            // the receiver isn't an argument\n            Some(f) => if len(f.params) + 1 == len(args) {\n              smt.call(mut vc, q, drop(arg_exprs, 1), drop(args, 1))\n            } else {\n              smt.call(mut vc, q, arg_exprs, args)\n            },\n            None => smt.call(mut vc, q, arg_exprs, args),\n          },\n          // a builtin stored under a module's name (`std.http.get`, where\n          // the module's type has a method `get`).\n          // `T.check(x)` on any type: whether `x` meets the type's\n          // refinements, an unconstrained `Result[(), String]`.\n          _ => if contains(name, \".\")\n            && vc.builtins.any(b -> b.name == smt.last_name(name)) {\n            smt.builtin(\n              mut vc,\n              smt.last_name(name),\n              arg_exprs,\n              args,\n            )\n          } else if name == \"check\" {\n            smt.shape(mut vc, ast.Named {\n              name: \"Result\",\n              args: [ast.UnitType, ast.Named { name: \"String\", args: [] }],\n            })\n          } else {\n            smt.gap(mut vc, f\"the method `{name}`\")\n            smt.Opaque(f\"the result of `{name}`\")\n          },\n        },\n      }\n    },\n  }\n}","old_text":"fn call(\n  mut vc: smt.Vc,\n  name: String,\n  arg_exprs: List[ast.Expr],\n  args: List[smt.Val],\n) -> smt.Val {\n  // the polarity of the call's result (`Vc.polarity`), for the body seen\n  // through or the built-in\n  pol := vc.call_pol\n  vc.call_pol = 0\n  // a `for`'s element (`for_loop`): at its position, which is in range\n  if name == \"$at\" {\n    match (get(args, 0), get(args, 1)) {\n      (Some(smt.VList { len, id }), Some(iv)) => {\n        i := smt.as_int(mut vc, iv)\n        inside := f\"(and (<= 0 {i}) (< {i} {len}))\"\n        return smt.element_at(mut vc, id, i, inside) ?? smt.element(mut vc, id, inside)\n      },\n      _ => return smt.Opaque(\"the elements of a list are not tracked\"),\n    }\n  }\n  // `len(s.code_points())` is the SMT string's length, and `len(s.bytes())`\n  // its `byte_len`: modelled on `s` itself\n  if name == \"len\" {\n    match get(arg_exprs, 0) {\n      Some(a) => match smt.string_unit(a) {\n        Some((unit, s)) => {\n          v := smt.eval(mut vc, s)\n          return if unit == \"code_points\" {\n            smt.VInt(\"(str.len \" + smt.as_str(mut vc, v) + \")\")\n          } else {\n            smt.builtin(mut vc, \"byte_len\", [s], [v])\n          }\n        },\n        None => (),\n      },\n      None => (),\n    }\n  }\n  // `len` of an iterator (a type implementing `FiniteIterator`) is its\n  // method, as Rust's checker lowers it\n  if name == \"len\" && len(args) == 1 {\n    match smt.implementation(vc, \"FiniteIterator::len\", args) {\n      Some(_) => match smt.method_call(\n        mut vc,\n        \"FiniteIterator::len\",\n        arg_exprs,\n        args,\n      ) {\n        Some(r) => return r,\n        None => (),\n      },\n      None => (),\n    }\n  }\n  match get(vc.fns, name) {\n    Some(f) => {\n      if (vc.spec > 0 || vc.see > 0) && vc.depth < 4 {\n        // in a contract (or a loop's written invariant) a call is seen\n        // through (its body), when it finishes and can't fail\n        if contains(vc.methods.unfold, name) {\n          match smt.rec_call(mut vc, name, f, args) {\n            Some(r) => return r,\n            None => (),\n          }\n        }\n        match get(vc.methods.seen, name) ?? smt.ContractOnly {\n          smt.SeeThrough => {\n            if contains(vc.methods.assumed, name) {\n              mut vc.relied_on.insert(name)\n            }\n            // (a list the same call made already, on the same values: that\n            // list, rather than a second one said equal element by element)\n            key := smt.call_key(vc, name, arg_exprs, args)\n            match key {\n              Some(k) => match get(vc.memo, k) {\n                Some(before) => match before {\n                  smt.VList { .. } => return before,\n                  _ => (),\n                },\n                None => (),\n              },\n              None => (),\n            }\n            binds := dict(zip(f.params.map(p -> p.name), args))\n            vc.depth += 1\n            vc.spec += 1\n            vc.through += 1\n            saved := vc.scopes\n            vc.scopes = [binds]\n            r := smt.eval_pol(mut vc, f.body, pol)\n            vc.scopes = saved\n            vc.through -= 1\n            vc.spec -= 1\n            vc.depth -= 1\n            // (the same call in the code, on the same values, gave the\n            // same result: when its body is made both ways, `pol` 0)\n            if pol == 0 {\n              smt.same_call(mut vc, key, r)\n            }\n            return r\n          },\n          smt.NotKnown => smt.gap(\n            mut vc,\n            f\"the call of `{name}` in a contract (whether it finishes needs a proof not ported)\",\n          ),\n          smt.ContractOnly => (),\n        }\n      }\n      r := smt.call_contract(mut vc, name, f, args)\n      smt.write_after(mut vc, f.params, arg_exprs)\n      // (a function a contract sees through gives the same result on the\n      // same values: what a contract says of its body is of this call)\n      if vc.spec == 0\n        && !f.params.any(p -> p.mutable)\n        && match get(vc.methods.seen, name) {\n          Some(smt.SeeThrough) => true,\n          _ => false,\n        } {\n        smt.same_call(\n          mut vc,\n          smt.call_key(vc, name, arg_exprs, args),\n          r,\n        )\n      }\n      r\n    },\n    None => if vc.builtins.any(b -> b.name == name) {\n      vc.call_pol = pol\n      smt.builtin(mut vc, name, arg_exprs, args)\n    } else {\n      match smt.method_call(mut vc, name, arg_exprs, args) {\n        Some(r) => r,\n        None => match keys(vc.fns).filter(k -> ends_with(k, \".\" + name)) {\n          // a module's function called as a method (`s.graphemes()` is\n          // `std.unicode.graphemes(s)`), as the resolver reads it\n          [q] => match get(vc.fns, q) {\n            // a capability's function called on one (`clock.seconds()`):\n            // the receiver isn't an argument\n            Some(f) => if len(f.params) + 1 == len(args) {\n              smt.call(mut vc, q, drop(arg_exprs, 1), drop(args, 1))\n            } else {\n              smt.call(mut vc, q, arg_exprs, args)\n            },\n            None => smt.call(mut vc, q, arg_exprs, args),\n          },\n          // `T.check(x)`, on every type: whether `x` meets the type's\n          // refinements, a `Result[(), String]` nothing is known of (as\n          // Rust's verifier has it)\n          // (a built-in stored under a module's name, `get` in a module\n          // whose type has a method `get`: `std.http.get`)\n          _ => if contains(name, \".\")\n            && vc.builtins.any(b -> b.name == smt.last_name(name)) {\n            smt.builtin(\n              mut vc,\n              smt.last_name(name),\n              arg_exprs,\n              args,\n            )\n          } else if name == \"check\" {\n            smt.shape(mut vc, ast.Named {\n              name: \"Result\",\n              args: [ast.UnitType, ast.Named { name: \"String\", args: [] }],\n            })\n          } else {\n            smt.gap(mut vc, f\"the method `{name}`\")\n            smt.Opaque(f\"the result of `{name}`\")\n          },\n        },\n      }\n    },\n  }\n}"},{"name":"smt.write_back","kind":"fn","old":"03f0e2058b6d11fe","new":"4ae766e61b8ced17","interface_changed":false,"affected":[],"module":"smt","text":"/// Gives the `mut` arguments new values, since the callee may have changed\n/// them.\nfn write_back(\n  mut vc: smt.Vc,\n  params: List[ast.Param],\n  arg_exprs: List[ast.Expr],\n  args: List[smt.Val],\n) {\n  for (i, p) in enumerate(params) {\n    if p.mutable {\n      match (get(arg_exprs, i), get(args, i)) {\n        (Some(e), Some(v)) => {\n          // any value of the parameter's type comes back, stored with the\n          // usual checks\n          nv := smt.refresh(mut vc, v)\n          c := smt.check_type(mut vc, p.ty, nv, [])\n          smt.assume(mut vc, c)\n          if vc.trial > 0 && !smt.refined(vc, p.ty) {\n            mut vc.wiped.push(nv)\n          }\n          smt.assign(mut vc, e, nv, \"writing back\")\n        },\n        _ => (),\n      }\n    }\n  }\n}","old_text":"/// `mut` parameters may have been changed by the callee.\nfn write_back(\n  mut vc: smt.Vc,\n  params: List[ast.Param],\n  arg_exprs: List[ast.Expr],\n  args: List[smt.Val],\n) {\n  for (i, p) in enumerate(params) {\n    if p.mutable {\n      match (get(arg_exprs, i), get(args, i)) {\n        (Some(e), Some(v)) => {\n          // any value of the parameter's type comes back, stored with the\n          // usual checks\n          nv := smt.refresh(mut vc, v)\n          c := smt.check_type(mut vc, p.ty, nv, [])\n          smt.assume(mut vc, c)\n          if vc.trial > 0 && !smt.refined(vc, p.ty) {\n            mut vc.wiped.push(nv)\n          }\n          smt.assign(mut vc, e, nv, \"writing back\")\n        },\n        _ => (),\n      }\n    }\n  }\n}"},{"name":"smt.call_contract","kind":"fn","old":"b192bb20164d5466","new":"56f0f0acf25e1f4a","interface_changed":false,"affected":[],"module":"smt","text":"/// A call seen through the callee's contract: its parameters' refinements\n/// and `requires` are checked, its result type and `ensures` assumed.\nfn call_contract(\n  mut vc: smt.Vc,\n  label: String,\n  f: ast.FnDecl,\n  args: List[smt.Val],\n) -> smt.Val {\n  if vc.depth > 4 {\n    return smt.Opaque(f\"calls to `{label}` nest too deeply\")\n  }\n  if label == vc.self_name && vc.spec == 0 && !vc.dead {\n    // a recursive call: kept, to check measures against\n    mut vc.rec_sites.push((vc.pc, args))\n    // a `decreases` clause: its measure goes down at each recursive call\n    ms := text.decreases_of(f.body)\n    if ms != [] && smt.start_goal(mut vc) {\n      (bs, as_) := smt.measures_at(mut vc, ms, args)\n      smt.oblige(mut vc, \"decreases `\"\n        + drop_bytes(text.decreases_text(f.body), 10)\n        + \"` at a call of `\"\n        + label\n        + \"`\", smt.lex_down(bs, as_))\n    }\n  }\n  mut binds := []\n  for (i, p) in enumerate(f.params) {\n    match get(args, i) {\n      Some(a) => mut binds.push((p.name, a)),\n      None => (),\n    }\n  }\n  for (i, p) in enumerate(f.params) {\n    match get(args, i) {\n      Some(a) => if smt.refined(vc, p.ty) {\n        if smt.start_goal(mut vc) {\n          g := smt.check_type(mut vc, p.ty, a, [])\n          smt.oblige(\n            mut vc,\n            f\"argument `{p.name}` of `{label}`: {text.type_text(p.ty)}\",\n            g,\n          )\n        }\n      },\n      None => (),\n    }\n  }\n  for r in f.pre {\n    if smt.start_goal(mut vc) {\n      g := smt.pred(mut vc, r, binds)\n      smt.oblige(\n        mut vc,\n        f\"precondition of `{label}`: requires {text.expr_text(r, 0)}\",\n        g,\n      )\n    }\n  }\n  old := vc.reason\n  vc.reason = Some(\n    f\"the result of `{smt.shown_name(label)}` (only its contract is known)\",\n  )\n  // a generic callee's result at the call's types (`Tree[K]`, not\n  // `Tree[T]`) when its arguments determine `T`\n  ret := match smt.type_args_at(vc, f, args) {\n    Some(sub) => smt.subst(f.ret, sub),\n    None => f.ret,\n  }\n  res := match smt.receiver_term(mut vc, label, f, args, ret) {\n    Some(v) => v,\n    None => smt.shape(mut vc, ret),\n  }\n  // the `mut` parameters come back as any values of their types. The\n  // `ensures` say what they are (`old x`: the argument before the call).\n  mut after := []\n  mut post := []\n  for (i, p) in enumerate(f.params) {\n    match get(args, i) {\n      Some(a) => if p.mutable {\n        nv := smt.refresh(mut vc, a)\n        smt.assume(mut vc, smt.check_type(mut vc, p.ty, nv, []))\n        // in a trial pass, with no refinement and no `ensures` naming it,\n        // nothing is known of it, so what names it is no invariant\n        if vc.trial > 0\n          && !smt.refined(vc, p.ty)\n          && !f.post.any(en -> smt.names_var(en, p.name)) {\n          mut vc.wiped.push(nv)\n        }\n        mut after.push(nv)\n        mut post.push((p.name, nv))\n      } else {\n        mut after.push(a)\n        mut post.push((p.name, a))\n      },\n      None => (),\n    }\n  }\n  vc.reason = old\n  vc.depth += 1\n  vc.spec += 1\n  c := smt.check_type(mut vc, ret, res, binds)\n  smt.assume(mut vc, c)\n  for en in f.post {\n    c2 := smt.pred_old(mut vc, en, post + [(\"it\", res)], Some(binds))\n    smt.assume(mut vc, c2)\n  }\n  vc.spec -= 1\n  vc.depth -= 1\n  vc.after = after\n  res\n}","old_text":"/// A call seen through the callee's contract: its parameters' refinements\n/// and `requires` checked, its result type and `ensures` assumed.\nfn call_contract(\n  mut vc: smt.Vc,\n  label: String,\n  f: ast.FnDecl,\n  args: List[smt.Val],\n) -> smt.Val {\n  if vc.depth > 4 {\n    return smt.Opaque(f\"calls to `{label}` nest too deeply\")\n  }\n  if label == vc.self_name && vc.spec == 0 && !vc.dead {\n    // a recursive call: remembered, to check measures against\n    mut vc.rec_sites.push((vc.pc, args))\n    // a `decreases` clause: its measure goes down at each recursive call\n    ms := text.decreases_of(f.body)\n    if ms != [] && smt.start_goal(mut vc) {\n      (bs, as_) := smt.measures_at(mut vc, ms, args)\n      smt.oblige(mut vc, \"decreases `\"\n        + drop_bytes(text.decreases_text(f.body), 10)\n        + \"` at a call of `\"\n        + label\n        + \"`\", smt.lex_down(bs, as_))\n    }\n  }\n  mut binds := []\n  for (i, p) in enumerate(f.params) {\n    match get(args, i) {\n      Some(a) => mut binds.push((p.name, a)),\n      None => (),\n    }\n  }\n  for (i, p) in enumerate(f.params) {\n    match get(args, i) {\n      Some(a) => if smt.refined(vc, p.ty) {\n        if smt.start_goal(mut vc) {\n          g := smt.check_type(mut vc, p.ty, a, [])\n          smt.oblige(\n            mut vc,\n            f\"argument `{p.name}` of `{label}`: {text.type_text(p.ty)}\",\n            g,\n          )\n        }\n      },\n      None => (),\n    }\n  }\n  for r in f.pre {\n    if smt.start_goal(mut vc) {\n      g := smt.pred(mut vc, r, binds)\n      smt.oblige(\n        mut vc,\n        f\"precondition of `{label}`: requires {text.expr_text(r, 0)}\",\n        g,\n      )\n    }\n  }\n  old := vc.reason\n  vc.reason = Some(\n    f\"the result of `{smt.shown_name(label)}` (only its contract is known)\",\n  )\n  // (a generic callee's result at the call's types: `Tree[K]`, not\n  // `Tree[T]`, when its arguments tell `T`)\n  ret := match smt.type_args_at(vc, f, args) {\n    Some(sub) => smt.subst(f.ret, sub),\n    None => f.ret,\n  }\n  res := match smt.receiver_term(mut vc, label, f, args, ret) {\n    Some(v) => v,\n    None => smt.shape(mut vc, ret),\n  }\n  // the `mut` parameters come back as any values of their types: the\n  // `ensures` say what they are (`old x`: the argument before the call)\n  mut after := []\n  mut post := []\n  for (i, p) in enumerate(f.params) {\n    match get(args, i) {\n      Some(a) => if p.mutable {\n        nv := smt.refresh(mut vc, a)\n        smt.assume(mut vc, smt.check_type(mut vc, p.ty, nv, []))\n        // (in a trial pass, with no refinement and no `ensures` naming\n        // it, nothing is known of it: what names it is no invariant)\n        if vc.trial > 0\n          && !smt.refined(vc, p.ty)\n          && !f.post.any(en -> smt.names_var(en, p.name)) {\n          mut vc.wiped.push(nv)\n        }\n        mut after.push(nv)\n        mut post.push((p.name, nv))\n      } else {\n        mut after.push(a)\n        mut post.push((p.name, a))\n      },\n      None => (),\n    }\n  }\n  vc.reason = old\n  vc.depth += 1\n  vc.spec += 1\n  c := smt.check_type(mut vc, ret, res, binds)\n  smt.assume(mut vc, c)\n  for en in f.post {\n    c2 := smt.pred_old(mut vc, en, post + [(\"it\", res)], Some(binds))\n    smt.assume(mut vc, c2)\n  }\n  vc.spec -= 1\n  vc.depth -= 1\n  vc.after = after\n  res\n}"},{"name":"smt.annotated","kind":"fn","old":"be2bd72f52eeefe4","new":"de6d3df051c711ef","interface_changed":false,"affected":[],"module":"smt","text":"/// Checks a value against the type its `let` is annotated with.\nfn annotated(mut vc: smt.Vc, ty: Option[ast.TypeExpr], v: smt.Val) {\n  match ty {\n    Some(t) => if smt.refined(vc, t) {\n      if smt.start_goal(mut vc) {\n        g := smt.check_type(mut vc, t, v, [])\n        smt.oblige(\n          mut vc,\n          \"`let` annotated `\" + text.type_text(t) + \"`\",\n          g,\n        )\n      }\n      // past the check, the elements are valid on this path\n      match (v, smt.expand_alias(vc, t)) {\n        (smt.VList { id, .. }, ast.Named { name: \"List\", args: [et] }) => smt.know_all(mut vc, id, smt.and_all(vc.pc), smt.FValid(et)),\n        _ => (),\n      }\n    },\n    None => (),\n  }\n}","old_text":"/// The check of a value against the type its `let` is annotated with.\nfn annotated(mut vc: smt.Vc, ty: Option[ast.TypeExpr], v: smt.Val) {\n  match ty {\n    Some(t) => if smt.refined(vc, t) {\n      if smt.start_goal(mut vc) {\n        g := smt.check_type(mut vc, t, v, [])\n        smt.oblige(\n          mut vc,\n          \"`let` annotated `\" + text.type_text(t) + \"`\",\n          g,\n        )\n      }\n      // past the check, the elements are valid (on this path)\n      match (v, smt.expand_alias(vc, t)) {\n        (smt.VList { id, .. }, ast.Named { name: \"List\", args: [et] }) => smt.know_all(mut vc, id, smt.and_all(vc.pc), smt.FValid(et)),\n        _ => (),\n      }\n    },\n    None => (),\n  }\n}"},{"name":"smt.declare","kind":"fn","old":"b0aabdadd6f52217","new":"3b4f26c1bb612cc4","interface_changed":false,"affected":[],"module":"smt","text":"/// Declares a variable with a type that holds after every assignment.\nfn declare(mut vc: smt.Vc, x: String, ty: Option[ast.TypeExpr]) {\n  match ty {\n    Some(t) => mut vc.declared.insert(x, (get(vc.declared, x) ?? []) + [t]),\n    None => (),\n  }\n}","old_text":"/// A variable declared with a type: it holds after every assignment.\nfn declare(mut vc: smt.Vc, x: String, ty: Option[ast.TypeExpr]) {\n  match ty {\n    Some(t) => mut vc.declared.insert(x, (get(vc.declared, x) ?? []) + [t]),\n    None => (),\n  }\n}"},{"name":"smt.assign","kind":"fn","old":"e7b156566332de92","new":"718388ff25ea5219","interface_changed":false,"affected":[],"module":"smt","text":"/// Stores `v` into `at` (`x`, `x.f.g`, possibly marked `mut`) with the\n/// checks the code makes: the variable's declared type, and the\n/// refinements of the record whose field changed.\nfn assign(mut vc: smt.Vc, at: ast.Expr, v: smt.Val, verb: String) {\n  place := match at {\n    ast.MutExpr(x) => x,\n    p => p,\n  }\n  mut path := []\n  mut root := place\n  mut walking := true\n  while walking {\n    match root {\n      ast.FieldOf { base, name } => {\n        path = [name] + path\n        root = base\n      },\n      _ => {\n        walking = false\n      },\n    }\n  }\n  x := match root {\n    ast.Var(x) => x,\n    _ => return,\n  }\n  base := match smt.lookup(vc, x) {\n    Some(b) => b,\n    None => return,\n  }\n  new := if len(path) == 0 {\n    v\n  } else {\n    smt.set_path(mut vc, base, path, v)\n  }\n  // the variable's declared type holds after every assignment\n  for t in get(vc.declared, x) ?? [] {\n    if smt.refined(vc, t) {\n      if smt.start_goal(mut vc) {\n        g := smt.check_type(mut vc, t, new, [])\n        smt.oblige(mut vc, verb\n          + \" `\"\n          + text.expr_text(place, 0)\n          + \"`: \"\n          + text.type_text(t), g)\n      }\n    }\n  }\n  if len(path) > 0 {\n    tn := match new {\n      smt.VRec { name, .. } => Some(name),\n      smt.VDistinct { name, .. } => Some(name),\n      smt.VSum { ty, .. } => Some(ty),\n      smt.Opaque(r) => {\n        // whatever the code checks here can't be proven\n        if smt.start_goal(mut vc) {\n          g := smt.unknown_bool(mut vc, r)\n          smt.oblige(\n            mut vc,\n            verb + \" `\" + text.expr_text(place, 0) + \"`\",\n            g,\n          )\n        }\n        None\n      },\n      _ => None,\n    }\n    match tn {\n      Some(n) => if smt.refined(vc, smt.named(n)) {\n        if smt.start_goal(mut vc) {\n          g := smt.check_type(mut vc, smt.named(n), new, [])\n          smt.oblige(\n            mut vc,\n            verb + \" `\" + text.expr_text(place, 0) + \"`\",\n            g,\n          )\n        }\n      },\n      None => (),\n    }\n  }\n  smt.set_var(mut vc, x, new)\n}","old_text":"/// Store `v` into `at` (`x`, `x.f.g`, possibly marked `mut`), with the\n/// checks the code makes: the variable's declared type, and the\n/// refinements of the record whose field changed.\nfn assign(mut vc: smt.Vc, at: ast.Expr, v: smt.Val, verb: String) {\n  place := match at {\n    ast.MutExpr(x) => x,\n    p => p,\n  }\n  mut path := []\n  mut root := place\n  mut walking := true\n  while walking {\n    match root {\n      ast.FieldOf { base, name } => {\n        path = [name] + path\n        root = base\n      },\n      _ => {\n        walking = false\n      },\n    }\n  }\n  x := match root {\n    ast.Var(x) => x,\n    _ => return,\n  }\n  base := match smt.lookup(vc, x) {\n    Some(b) => b,\n    None => return,\n  }\n  new := if len(path) == 0 {\n    v\n  } else {\n    smt.set_path(mut vc, base, path, v)\n  }\n  // the variable's declared type holds after every assignment\n  for t in get(vc.declared, x) ?? [] {\n    if smt.refined(vc, t) {\n      if smt.start_goal(mut vc) {\n        g := smt.check_type(mut vc, t, new, [])\n        smt.oblige(mut vc, verb\n          + \" `\"\n          + text.expr_text(place, 0)\n          + \"`: \"\n          + text.type_text(t), g)\n      }\n    }\n  }\n  if len(path) > 0 {\n    tn := match new {\n      smt.VRec { name, .. } => Some(name),\n      smt.VDistinct { name, .. } => Some(name),\n      smt.VSum { ty, .. } => Some(ty),\n      smt.Opaque(r) => {\n        // whatever the code checks here can't be proven\n        if smt.start_goal(mut vc) {\n          g := smt.unknown_bool(mut vc, r)\n          smt.oblige(\n            mut vc,\n            verb + \" `\" + text.expr_text(place, 0) + \"`\",\n            g,\n          )\n        }\n        None\n      },\n      _ => None,\n    }\n    match tn {\n      Some(n) => if smt.refined(vc, smt.named(n)) {\n        if smt.start_goal(mut vc) {\n          g := smt.check_type(mut vc, smt.named(n), new, [])\n          smt.oblige(\n            mut vc,\n            verb + \" `\" + text.expr_text(place, 0) + \"`\",\n            g,\n          )\n        }\n      },\n      None => (),\n    }\n  }\n  smt.set_var(mut vc, x, new)\n}"},{"name":"smt.function","kind":"fn","old":"e62e0a567cc23f3a","new":"13df70e0a637533d","interface_changed":false,"affected":[],"module":"smt","text":"/// Runs `f` symbolically, collecting its obligations and what it uses that\n/// smt doesn't model (`gaps`).\npub fn function(mut vc: smt.Vc, f: ast.FnDecl, label: String) {\n  vc.self_name = label\n  vc.own_whiles = smt.while_loops(f.body)\n  for p in f.params {\n    v := smt.havoc(mut vc, p.ty)\n    if p.mutable {\n      smt.declare(mut vc, p.name, Some(p.ty))\n      mut vc.mut_params.push(p.name)\n    }\n    mut vc.params.push((p.name, v))\n    smt.bind(mut vc, p.name, v)\n  }\n  // the lists' first elements, for a counterexample to show (their facts\n  // set aside): one level of nested lists, bounded in terms\n  if vc.examples {\n    nf := len(vc.facts)\n    mut lens := []\n    mut ls := []\n    vc.input_depth = 1\n    for (_, v) in vc.params {\n      smt.open_input(mut vc, v, 0, mut lens, mut ls)\n    }\n    vc.input_depth = 3\n    vc.example_facts = drop(vc.facts, nf)\n    vc.facts = take(vc.facts, nf)\n    vc.example_leaves = ls\n  }\n  binds := vc.params\n  for r in f.pre {\n    c := smt.pred(mut vc, r, binds)\n    mut vc.pc.push(c)\n  }\n  // what a loop may need to keep: the `ensures` of the returned variable\n  match f.body {\n    ast.Block { last: ast.Var(x), .. } => {\n      vc.hints = f.post.map(e -> (e, x))\n      vc.returned = Some((x, f.ret))\n    },\n    _ => (),\n  }\n  vc.requires_hints = f.pre\n  res := smt.eval(mut vc, f.body)\n  // the result is checked where the body ends and at every early return\n  mut exits := []\n  if !vc.dead {\n    mut exits.push((vc.pc, res, \"\", smt.mut_state(vc)))\n  }\n  for x in vc.returns {\n    mut exits.push((x.pc, x.value, \" (early return)\", x.state))\n  }\n  vc.returns = []\n  shown := smt.shown_name(label)\n  for (pc, value, how, state) in exits {\n    vc.pc = pc\n    vc.dead = false\n    // the `ensures` name the `mut` parameters as they are at this exit,\n    // `old x` as they were on entry\n    after := smt.rebound(binds, state)\n    if smt.refined(vc, f.ret) {\n      if smt.start_goal(mut vc) {\n        g := smt.check_type(mut vc, f.ret, value, binds)\n        smt.oblige(\n          mut vc,\n          f\"result of `{shown}`{how}: {text.type_text(f.ret)}\",\n          g,\n        )\n      }\n    }\n    for en in f.post {\n      n := len(vc.pc)\n      if smt.start_goal(mut vc) {\n        g := smt.pred_old(\n          mut vc,\n          en,\n          after + [(\"it\", value)],\n          Some(binds),\n        )\n        smt.oblige(\n          mut vc,\n          f\"ensures {text.expr_text(en, 0)}{how}\",\n          g,\n        )\n      }\n      vc.pc = take(vc.pc, n)\n    }\n  }\n}","old_text":"/// Run `f` symbolically: its obligations, and what it uses that step 1\n/// doesn't model (`gaps`).\npub fn function(mut vc: smt.Vc, f: ast.FnDecl, label: String) {\n  vc.self_name = label\n  vc.own_whiles = smt.while_loops(f.body)\n  for p in f.params {\n    v := smt.havoc(mut vc, p.ty)\n    if p.mutable {\n      smt.declare(mut vc, p.name, Some(p.ty))\n      mut vc.mut_params.push(p.name)\n    }\n    mut vc.params.push((p.name, v))\n    smt.bind(mut vc, p.name, v)\n  }\n  // the lists' first elements, for a counterexample to show (their facts\n  // set aside): one level of lists inside them, at most so many terms\n  if vc.examples {\n    nf := len(vc.facts)\n    mut lens := []\n    mut ls := []\n    vc.input_depth = 1\n    for (_, v) in vc.params {\n      smt.open_input(mut vc, v, 0, mut lens, mut ls)\n    }\n    vc.input_depth = 3\n    vc.example_facts = drop(vc.facts, nf)\n    vc.facts = take(vc.facts, nf)\n    vc.example_leaves = ls\n  }\n  binds := vc.params\n  for r in f.pre {\n    c := smt.pred(mut vc, r, binds)\n    mut vc.pc.push(c)\n  }\n  // what a loop may need to keep: the `ensures`, of the variable returned\n  match f.body {\n    ast.Block { last: ast.Var(x), .. } => {\n      vc.hints = f.post.map(e -> (e, x))\n      vc.returned = Some((x, f.ret))\n    },\n    _ => (),\n  }\n  vc.requires_hints = f.pre\n  res := smt.eval(mut vc, f.body)\n  // the result is checked where the body ends, and at every early return\n  mut exits := []\n  if !vc.dead {\n    mut exits.push((vc.pc, res, \"\", smt.mut_state(vc)))\n  }\n  for x in vc.returns {\n    mut exits.push((x.pc, x.value, \" (early return)\", x.state))\n  }\n  vc.returns = []\n  shown := smt.shown_name(label)\n  for (pc, value, how, state) in exits {\n    vc.pc = pc\n    vc.dead = false\n    // the `ensures` name the `mut` parameters as they are at this exit;\n    // `old x` as they were on entry\n    after := smt.rebound(binds, state)\n    if smt.refined(vc, f.ret) {\n      if smt.start_goal(mut vc) {\n        g := smt.check_type(mut vc, f.ret, value, binds)\n        smt.oblige(\n          mut vc,\n          f\"result of `{shown}`{how}: {text.type_text(f.ret)}\",\n          g,\n        )\n      }\n    }\n    for en in f.post {\n      n := len(vc.pc)\n      if smt.start_goal(mut vc) {\n        g := smt.pred_old(\n          mut vc,\n          en,\n          after + [(\"it\", value)],\n          Some(binds),\n        )\n        smt.oblige(\n          mut vc,\n          f\"ensures {text.expr_text(en, 0)}{how}\",\n          g,\n        )\n      }\n      vc.pc = take(vc.pc, n)\n    }\n  }\n}"},{"name":"smt.Outcome","kind":"type","old":"97c7935341829b32","new":"0f7ea5b588fb71e8","interface_changed":false,"affected":[],"module":"smt","text":"// ---- queries ----\n\n/// The solver's verdict on an obligation.\npub type Outcome =\n  | IsProven\n  | IsRefuted\n  | IsUnknown","old_text":"// ---- queries ----\n\n/// What the solver answered to an obligation.\npub type Outcome =\n  | IsProven\n  | IsRefuted\n  | IsUnknown"},{"name":"smt.words","kind":"fn","old":"707a61be31d12b40","new":"19985c88111f2521","interface_changed":false,"affected":[],"module":"smt","text":"/// The words of a term: its runs of letters, digits and `_`, plus `.` when\n/// `dots`.\nfn words(t: String, dots: Bool) -> List[String] {\n  mut out := []\n  mut start := 0\n  n := byte_len(t)\n  mut k := 0\n  while k < n {\n    b := byte_at(t, k)\n    word := b >= 128\n      || b >= 48 && b <= 57\n      || b >= 65 && b <= 90\n      || b >= 97 && b <= 122\n      || b == 95\n      || dots && b == 46\n    if !word {\n      if k > start {\n        mut out.push(byte_slice(t, start, k))\n      }\n      start = k + 1\n    }\n    k += 1\n  }\n  if n > start {\n    mut out.push(byte_slice(t, start, n))\n  }\n  out\n}","old_text":"/// The words of a term: its runs of letters, digits, `_` (and `.` when\n/// `dots`).\nfn words(t: String, dots: Bool) -> List[String] {\n  mut out := []\n  mut start := 0\n  n := byte_len(t)\n  mut k := 0\n  while k < n {\n    b := byte_at(t, k)\n    word := b >= 128\n      || b >= 48 && b <= 57\n      || b >= 65 && b <= 90\n      || b >= 97 && b <= 122\n      || b == 95\n      || dots && b == 46\n    if !word {\n      if k > start {\n        mut out.push(byte_slice(t, start, k))\n      }\n      start = k + 1\n    }\n    k += 1\n  }\n  if n > start {\n    mut out.push(byte_slice(t, start, n))\n  }\n  out\n}"},{"name":"smt.consts_in","kind":"fn","old":"11c284ff1b0c2e1e","new":"9c72399c73d78263","interface_changed":false,"affected":[],"module":"smt","text":"/// The unknowns of a term (`v12`) and the recursive functions it applies\n/// (`|rec:up(Int)|`). Their defining equations at constant arguments name\n/// no unknown, yet the goal depends on them.\nfn consts_in(t: String) -> List[String] {\n  mut out := smt.words(t, false).filter(w -> smt.is_const(w))\n  if contains(t, \"|rec:\") {\n    for (i, part) in enumerate(split(t, \"|\")) {\n      if i % 2 == 1\n        && starts_with(part, \"rec:\")\n        && !contains(out, part) {\n        mut out.push(part)\n      }\n    }\n  }\n  out\n}","old_text":"/// The unknowns of a term (`v12`), and the recursive functions it applies\n/// (`|rec:up(Int)|`: their defining equations at constant arguments name no\n/// unknown, yet the goal depends on them).\nfn consts_in(t: String) -> List[String] {\n  mut out := smt.words(t, false).filter(w -> smt.is_const(w))\n  if contains(t, \"|rec:\") {\n    for (i, part) in enumerate(split(t, \"|\")) {\n      if i % 2 == 1\n        && starts_with(part, \"rec:\")\n        && !contains(out, part) {\n        mut out.push(part)\n      }\n    }\n  }\n  out\n}"},{"name":"smt.header","kind":"fn","old":"dca6b6bbfe85a4e4","new":"e0c97fc619dab416","interface_changed":false,"affected":[],"module":"smt","text":"/// The start of every query of a function: the options and the sorts.\nfn header(vc: smt.Vc) -> String {\n  \"(set-option :produce-models true)\\n(set-logic ALL)\\n(declare-fun utf8_len (String) Int)\\n\"\n    + smt.declarations(vc)\n}","old_text":"/// What every query of a function starts with: the options and the sorts.\nfn header(vc: smt.Vc) -> String {\n  \"(set-option :produce-models true)\\n(set-logic ALL)\\n(declare-fun utf8_len (String) Int)\\n\"\n    + smt.declarations(vc)\n}"},{"name":"smt.body","kind":"fn","old":"c4ab9026d7d12cd4","new":"fe42e6658e424c41","interface_changed":false,"affected":[],"module":"smt","text":"/// An obligation's query after the header: what it depends on, the negated\n/// goal, `check-sat` and a `get-value` of `leaves`.\nfn body(vc: smt.Vc, ob: smt.Obligation, leaves: List[String]) -> String {\n  smt.body_with(vc, ob, leaves, [])\n}","old_text":"/// An obligation's query after the header: what it depends on, the negated\n/// goal, `check-sat` and the model's values of `leaves`.\nfn body(vc: smt.Vc, ob: smt.Obligation, leaves: List[String]) -> String {\n  smt.body_with(vc, ob, leaves, [])\n}"},{"name":"smt.str_len_terms","kind":"fn","old":"1e4c63ea3ca6d9dd","new":"e24da79bd8234a58","interface_changed":false,"affected":[],"module":"smt","text":"/// The `(str.len x)` terms of a script whose `x` has no quantified\n/// variable.\nfn str_len_terms(script: String) -> List[String] {\n  mut out := []\n  n := byte_len(script)\n  mut k := 0\n  while k + 9 <= n\n    invariant k >= 0 {\n    if byte_at(script, k) == 40\n      && byte_slice(script, k, k + 9) == \"(str.len \" {\n      mut depth := 0\n      mut end := n\n      mut i := k\n      mut open := true\n      while open && i < n\n        invariant i <= n\n        invariant depth <= i\n        invariant end <= n\n        invariant end >= 0\n        invariant i >= k\n        invariant i >= 0\n        invariant i >= depth {\n        b := byte_at(script, i)\n        if b == 40 {\n          depth += 1\n        } else if b == 41 {\n          depth -= 1\n          if depth == 0 {\n            end = i + 1\n            open = false\n          }\n        }\n        i += 1\n      }\n      term := byte_slice(script, k, end)\n      // a datatype's selectors, between bars, are functions like any other\n      plain := join(smt.every_other(split(term, \"|\")), \" \")\n      free := !contains(term, \"\\\"\")\n        && smt.words(plain, true).all(\n          w -> w == \"str.len\"\n            || starts_with(w, \"str\")\n              && smt.is_digits(byte_slice(w, 3, byte_len(w)))\n            || smt.is_const(w)\n            || smt.is_digits(w),\n        )\n      if free && !contains(out, term) {\n        mut out.push(term)\n      }\n    }\n    k += 1\n  }\n  out\n}","old_text":"/// The `(str.len x)` terms of a script whose `x` is free of quantified\n/// variables.\nfn str_len_terms(script: String) -> List[String] {\n  mut out := []\n  n := byte_len(script)\n  mut k := 0\n  while k + 9 <= n\n    invariant k >= 0 {\n    if byte_at(script, k) == 40\n      && byte_slice(script, k, k + 9) == \"(str.len \" {\n      mut depth := 0\n      mut end := n\n      mut i := k\n      mut open := true\n      while open && i < n\n        invariant i <= n\n        invariant depth <= i\n        invariant end <= n\n        invariant end >= 0\n        invariant i >= k\n        invariant i >= 0\n        invariant i >= depth {\n        b := byte_at(script, i)\n        if b == 40 {\n          depth += 1\n        } else if b == 41 {\n          depth -= 1\n          if depth == 0 {\n            end = i + 1\n            open = false\n          }\n        }\n        i += 1\n      }\n      term := byte_slice(script, k, end)\n      // (a datatype's selectors, between bars, are functions like any other)\n      plain := join(smt.every_other(split(term, \"|\")), \" \")\n      free := !contains(term, \"\\\"\")\n        && smt.words(plain, true).all(\n          w -> w == \"str.len\"\n            || starts_with(w, \"str\")\n              && smt.is_digits(byte_slice(w, 3, byte_len(w)))\n            || smt.is_const(w)\n            || smt.is_digits(w),\n        )\n      if free && !contains(out, term) {\n        mut out.push(term)\n      }\n    }\n    k += 1\n  }\n  out\n}"},{"name":"smt.batch","kind":"fn","old":"167b3c2872176552","new":"9ae3057550505110","interface_changed":false,"affected":[],"module":"smt","text":"/// A script solving every obligation in one solver process. Each sits\n/// between `push` and `pop`, followed by a marker, and asks why the solver\n/// gave up if it did (`gave_up`).\npub fn batch(vc: smt.Vc) -> String {\n  ls := smt.leaves(vc)\n  mut s := smt.header(vc)\n  for ob in vc.obligations {\n    s += \"(push)\\n\"\n      + smt.body(vc, ob, ls)\n      + \"(get-info :reason-unknown)\\n(pop)\\n(echo \\\"@@answered\\\")\\n\"\n  }\n  s\n}","old_text":"/// The script solving every obligation in one solver process: each\n/// between `push` and `pop`, followed by a marker; each asks why the solver\n/// gave up, if it did (`gave_up`).\npub fn batch(vc: smt.Vc) -> String {\n  ls := smt.leaves(vc)\n  mut s := smt.header(vc)\n  for ob in vc.obligations {\n    s += \"(push)\\n\"\n      + smt.body(vc, ob, ls)\n      + \"(get-info :reason-unknown)\\n(pop)\\n(echo \\\"@@answered\\\")\\n\"\n  }\n  s\n}"},{"name":"smt.answers","kind":"fn","old":"e9c773eacf217233","new":"5cdc2e121ef4fe12","interface_changed":false,"affected":[],"module":"smt","text":"/// The answers of a `batch` script, in order: one per finished query, each\n/// the solver's text.\npub fn answers(out: String) -> List[String] {\n  mut found := []\n  mut text := \"\"\n  for line in lines(out) {\n    l := trim(line)\n    if l == \"@@answered\" || l == \"\\\"@@answered\\\"\" {\n      mut found.push(text)\n      text = \"\"\n    } else {\n      text += line + \"\\n\"\n    }\n  }\n  found\n}","old_text":"/// The answers of a batch (`batch`), in order: as many as it finished,\n/// each the solver's text.\npub fn answers(out: String) -> List[String] {\n  mut found := []\n  mut text := \"\"\n  for line in lines(out) {\n    l := trim(line)\n    if l == \"@@answered\" || l == \"\\\"@@answered\\\"\" {\n      mut found.push(text)\n      text = \"\"\n    } else {\n      text += line + \"\\n\"\n    }\n  }\n  found\n}"},{"name":"smt.outcome","kind":"fn","old":"497eb0dea627d95c","new":"7b465fd1ec5a246b","interface_changed":false,"affected":[],"module":"smt","text":"/// What a solver's answer says of `vc`'s parameters. A model is a\n/// counterexample only when every parameter can be shown from it.\npub fn outcome(vc: smt.Vc, answer: String) -> smt.Outcome {\n  ls := lines(answer)\n  match trim(get(ls, 0) ?? \"\") {\n    \"unsat\" => smt.IsProven,\n    \"sat\" => {\n      m := smt.model_values(join(drop(ls, 1), \"\\n\"), smt.leaves(vc))\n      if vc.params.all(p -> smt.showable(vc, p.1, m)) {\n        smt.IsRefuted\n      } else {\n        smt.IsUnknown\n      }\n    },\n    _ => smt.IsUnknown,\n  }\n}","old_text":"/// What a solver's answer says of obligation-free `vc`'s parameters: a\n/// model is a counterexample only when every parameter can be shown from\n/// it (as Rust's `to_literal`).\npub fn outcome(vc: smt.Vc, answer: String) -> smt.Outcome {\n  ls := lines(answer)\n  match trim(get(ls, 0) ?? \"\") {\n    \"unsat\" => smt.IsProven,\n    \"sat\" => {\n      m := smt.model_values(join(drop(ls, 1), \"\\n\"), smt.leaves(vc))\n      if vc.params.all(p -> smt.showable(vc, p.1, m)) {\n        smt.IsRefuted\n      } else {\n        smt.IsUnknown\n      }\n    },\n    _ => smt.IsUnknown,\n  }\n}"},{"name":"smt.solve","kind":"fn","old":"0e9a37acd379b8e1","new":"c2d814d3a72d01bf","interface_changed":false,"affected":[],"module":"smt","text":"// ---- the solver ----\n\n/// The solver's answer to each obligation of `vc`: all in one solver\n/// process, then each unfinished one alone. Then the obligations true for\n/// all values.\npub fn solve(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  vc: smt.Vc,\n) -> List[String] {\n  n := len(vc.obligations)\n  mut outs := if n > 0 {\n    smt.run_script(\n      mut commands,\n      mut files,\n      scratch,\n      solver,\n      smt.batch(vc),\n      [\"-t:20000\", \"rlimit=2000000\"],\n    )\n  } else {\n    []\n  }\n  if n > 0 {\n    while len(outs) < n {\n      one := smt.run_script(\n        mut commands,\n        mut files,\n        scratch,\n        solver,\n        smt.single(vc, len(outs)),\n        [\"-T:20\", \"rlimit=2000000\"],\n      )\n      mut outs.push(get(one, 0) ?? \"\")\n    }\n  }\n  mut lines := []\n  for (i, ob) in enumerate(vc.obligations) {\n    mut lines.push(\n      smt.outcome_text(smt.outcome(vc, get(outs, i) ?? \"\"))\n        + \" \"\n        + ob.what,\n    )\n  }\n  lines + vc.given.map(g -> \"proven \" + g)\n}","old_text":"// ---- the solver ----\n\n/// The solver's answer to each obligation of `vc` (all in one solver\n/// process; those it didn't finish, each alone), then the obligations true\n/// whatever the values.\npub fn solve(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  vc: smt.Vc,\n) -> List[String] {\n  n := len(vc.obligations)\n  mut outs := if n > 0 {\n    smt.run_script(\n      mut commands,\n      mut files,\n      scratch,\n      solver,\n      smt.batch(vc),\n      [\"-t:20000\", \"rlimit=2000000\"],\n    )\n  } else {\n    []\n  }\n  if n > 0 {\n    while len(outs) < n {\n      one := smt.run_script(\n        mut commands,\n        mut files,\n        scratch,\n        solver,\n        smt.single(vc, len(outs)),\n        [\"-T:20\", \"rlimit=2000000\"],\n      )\n      mut outs.push(get(one, 0) ?? \"\")\n    }\n  }\n  mut lines := []\n  for (i, ob) in enumerate(vc.obligations) {\n    mut lines.push(\n      smt.outcome_text(smt.outcome(vc, get(outs, i) ?? \"\"))\n        + \" \"\n        + ob.what,\n    )\n  }\n  lines + vc.given.map(g -> \"proven \" + g)\n}"},{"name":"smt.run_script","kind":"fn","old":"32918339916e4abd","new":"4cf558128023306f","interface_changed":false,"affected":[],"module":"smt","text":"/// The solver's answers to a script, which is written to a file in\n/// `scratch` named by its hash. A batch gives each answer's text, a single\n/// query its whole output. A running solver (`pooled`) gets the script\n/// directly.\npub fn run_script(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  script: String,\n  flags: List[String],\n) -> List[String] {\n  if smt.pooled(solver) {\n    match smt.pool_run(solver, [(script, flags)]) {\n      Some(outs) => {\n        out := get(outs, 0) ?? \"\"\n        return if contains(script, \"@@answered\") {\n          smt.answers(out)\n        } else {\n          [out]\n        }\n      },\n      None => (),\n    }\n  }\n\n  path := f\"{scratch}/{smt.text_hash(script)}.smt2\"\n  match mut files.write(path, script) {\n    Ok(_) => (),\n    Err(_) => return [],\n  }\n  // the script goes on standard input\n  timings.begin(\"solver\")\n  ran := mut commands.run_with(\n    solver,\n    smt.solver_args(solver, flags),\n    \"\",\n    std.process.RunOptions { input: script },\n  )\n  timings.end(\"solver\")\n  match ran {\n    Ok(done) => if contains(script, \"@@answered\") {\n      smt.answers(done.out)\n    } else {\n      [done.out]\n    },\n    Err(_) => [],\n  }\n}","old_text":"/// The solver's answers to a script, written to a file of `scratch` named\n/// by its hash: of a batch, each answer's text; of a single query, its\n/// whole output. A solver kept running (`pooled`) is given the script\n/// without a file.\npub fn run_script(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  script: String,\n  flags: List[String],\n) -> List[String] {\n  if smt.pooled(solver) {\n    match smt.pool_run(solver, [(script, flags)]) {\n      Some(outs) => {\n        out := get(outs, 0) ?? \"\"\n        return if contains(script, \"@@answered\") {\n          smt.answers(out)\n        } else {\n          [out]\n        }\n      },\n      None => (),\n    }\n  }\n\n  path := f\"{scratch}/{smt.text_hash(script)}.smt2\"\n  match mut files.write(path, script) {\n    Ok(_) => (),\n    Err(_) => return [],\n  }\n  // (the script on standard input, as Rust's verify gives it)\n  timings.begin(\"solver\")\n  ran := mut commands.run_with(\n    solver,\n    smt.solver_args(solver, flags),\n    \"\",\n    std.process.RunOptions { input: script },\n  )\n  timings.end(\"solver\")\n  match ran {\n    Ok(done) => if contains(script, \"@@answered\") {\n      smt.answers(done.out)\n    } else {\n      [done.out]\n    },\n    Err(_) => [],\n  }\n}"},{"name":"smt.text_hash","kind":"fn","old":"53db9db7a8fcdce5","new":"e8ec94543dbbd79f","interface_changed":false,"affected":[],"module":"smt","text":"/// A hash of a text for a file name, in wrapping `U64` arithmetic to avoid\n/// big integers.\nfn text_hash(s: String) -> Int {\n  mut h := 7.wrap_u64()\n  for k in 0..byte_len(s) {\n    h = h * 131 + byte_at(s, k).wrap_u64()\n  }\n  h.to_int()\n}","old_text":"/// A hash of a text, for a file name (wrapping `U64` arithmetic, not big\n/// integers).\nfn text_hash(s: String) -> Int {\n  mut h := 7.wrap_u64()\n  for k in 0..byte_len(s) {\n    h = h * 131 + byte_at(s, k).wrap_u64()\n  }\n  h.to_int()\n}"},{"name":"smt.SortDef","kind":"type","old":"a87f47c9244e9aaf","new":"bbbc80f045b00d2d","interface_changed":false,"affected":[],"module":"smt","text":"/// A sort declared to the solver:\n/// - a datatype (its constructors and their field sorts);\n/// - an uninterpreted sort;\n/// - lists of a sort (length and items are functions of it);\n/// - the arrays of dicts and sets of a sort (size is a function of the\n/// array).\ntype SortDef =\n  | DataSort(List[(String, List[String])])\n  | OpaqueSort\n  | ListSort(String)\n  | MapSort(String)","old_text":"/// A sort the solver is told about: a datatype (its constructors, and the\n/// sorts of their fields), one nothing is known of, lists of items of a\n/// sort (a list's length and items are functions of it), or the arrays of\n/// dicts and sets of a sort (its size is a function of the array).\ntype SortDef =\n  | DataSort(List[(String, List[String])])\n  | OpaqueSort\n  | ListSort(String)\n  | MapSort(String)"},{"name":"smt.Ctor","kind":"type","old":"858e43fe7f43282f","new":"27314304ddd9f4a5","interface_changed":false,"affected":[],"module":"smt","text":"/// A type's constructor: its name, its field names (a record's), and their\n/// types.\ntype Ctor = {\n  name: String,\n  fields: Option[List[String]],\n  types: List[ast.TypeExpr],\n}","old_text":"/// A constructor of a type: its name, its fields' names (a record's), and\n/// their types.\ntype Ctor = {\n  name: String,\n  fields: Option[List[String]],\n  types: List[ast.TypeExpr],\n}"},{"name":"smt.define","kind":"fn","old":"4409dee6347a2c3a","new":"6dc4faa86d08b982","interface_changed":false,"affected":[],"module":"smt","text":"/// Records a fact about a term once, whatever the path. Inside a scope or\n/// with placeholders it stays with what is made there, unless it names\n/// nothing made in the scope and no position bound there. Hoisting matters:\n/// a refinement predicate's definition at a term read from a dict, made\n/// again in each quantifier body, used to be most of a query.\nfn define(mut vc: smt.Vc, fact: String, term: String) {\n  if fact == \"true\" || contains(vc.def_set, fact) {\n    return\n  }\n  local := contains(term, \"@@\")\n    || len(vc.regions) > 0\n      && {\n        start := (get(vc.regions, 0) ?? (len(vc.consts), 0)).0\n        made := set(drop(vc.consts, start).map(c -> c.name))\n        smt.words(fact, false).any(\n          w -> contains(made, w)\n            || starts_with(w, \"q\") && smt.is_digits(drop_bytes(w, 1)),\n        )\n      }\n  if local {\n    mut vc.facts.push(fact)\n  } else {\n    mut vc.defs.push(fact)\n    mut vc.def_set.insert(fact)\n  }\n}","old_text":"/// A fact that holds of a term whatever the path, once. Inside a scope, or\n/// with placeholders, it stays with what is made there, unless it names\n/// nothing made in the scope and no position bound there (the definition\n/// of a refinement's predicate at a term read from a dict: made again in\n/// each quantifier's body, it was most of a query).\nfn define(mut vc: smt.Vc, fact: String, term: String) {\n  if fact == \"true\" || contains(vc.def_set, fact) {\n    return\n  }\n  local := contains(term, \"@@\")\n    || len(vc.regions) > 0\n      && {\n        start := (get(vc.regions, 0) ?? (len(vc.consts), 0)).0\n        made := set(drop(vc.consts, start).map(c -> c.name))\n        smt.words(fact, false).any(\n          w -> contains(made, w)\n            || starts_with(w, \"q\") && smt.is_digits(drop_bytes(w, 1)),\n        )\n      }\n  if local {\n    mut vc.facts.push(fact)\n  } else {\n    mut vc.defs.push(fact)\n    mut vc.def_set.insert(fact)\n  }\n}"},{"name":"smt.expand_alias","kind":"fn","old":"2b7b1b02ffdbea7c","new":"e41c4e215945c5c0","interface_changed":false,"affected":[],"module":"smt","text":"/// Follows refinement aliases to the type they stand for.\nfn expand_alias(vc: smt.Vc, t: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Refined { base, .. } => smt.expand_alias(vc, base),\n    ast.Named { name, args } => match get(vc.types, name) {\n      Some(td) => match td.body {\n        ast.Alias(a) => if td.distinct {\n          t\n        } else {\n          smt.expand_alias(\n            vc,\n            smt.subst(a, smt.params_of(td, args)),\n          )\n        },\n        _ => t,\n      },\n      None => t,\n    },\n    _ => t,\n  }\n}","old_text":"/// Refinement aliases followed to the type they stand for.\nfn expand_alias(vc: smt.Vc, t: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Refined { base, .. } => smt.expand_alias(vc, base),\n    ast.Named { name, args } => match get(vc.types, name) {\n      Some(td) => match td.body {\n        ast.Alias(a) => if td.distinct {\n          t\n        } else {\n          smt.expand_alias(\n            vc,\n            smt.subst(a, smt.params_of(td, args)),\n          )\n        },\n        _ => t,\n      },\n      None => t,\n    },\n    _ => t,\n  }\n}"},{"name":"smt.structured","kind":"fn","old":"09966c93034f6d13","new":"c05cb44253554935","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether a value of `t` is more than one term (a record, sum or tuple).\nfn structured(vc: smt.Vc, t: ast.TypeExpr) -> Bool {\n  match smt.expand_alias(vc, t) {\n    ast.UnionType(_) => true,\n    ast.UnitType | ast.FnType { .. } | ast.Refined { .. } => false,\n    ast.Named { name, .. } => match name {\n      \"Int\" | \"Bool\" | \"String\" | \"Float\" | \"List\" | \"Dict\" | \"Set\" => false,\n      \"Tuple\" => true,\n      _ => contains(vc.parents, name) || contains(vc.types, name),\n    },\n  }\n}","old_text":"/// Is a value of `t` more than one term (a record, sum or tuple)?\nfn structured(vc: smt.Vc, t: ast.TypeExpr) -> Bool {\n  match smt.expand_alias(vc, t) {\n    ast.UnionType(_) => true,\n    ast.UnitType | ast.FnType { .. } | ast.Refined { .. } => false,\n    ast.Named { name, .. } => match name {\n      \"Int\" | \"Bool\" | \"String\" | \"Float\" | \"List\" | \"Dict\" | \"Set\" => false,\n      \"Tuple\" => true,\n      _ => contains(vc.parents, name) || contains(vc.types, name),\n    },\n  }\n}"},{"name":"smt.sort_type","kind":"fn","old":"9430e9daea1b6ca1","new":"5e45b8c721fd9609","interface_changed":false,"affected":[],"module":"smt","text":"// ---- sorts ----\n\n/// `t` as far as its sort is concerned: refinements, aliases (distinct\n/// ones too), variants (to their sum) and tasks (to their result) looked\n/// through.\nfn sort_type(vc: smt.Vc, t: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Refined { base, .. } => smt.sort_type(vc, base),\n    ast.UnionType(ms) => ast.UnionType(smt.flatten_all(vc, ms)),\n    ast.UnitType | ast.FnType { .. } => t,\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => smt.sort_type(vc, ast.Named { name: p, args }),\n      None => if name == \"Task\" && len(args) == 1 {\n        smt.sort_type(vc, get(args, 0) ?? ast.UnitType)\n      } else {\n        match get(vc.types, name) {\n          Some(td) => match td.body {\n            ast.Alias(a) => smt.sort_type(vc, smt.subst(a, smt.params_of(td, args))),\n            _ => ast.Named {\n              name,\n              args: args.map(a -> smt.sort_type(vc, a)),\n            },\n          },\n          None => ast.Named {\n            name,\n            args: args.map(a -> smt.sort_type(vc, a)),\n          },\n        }\n      },\n    },\n  }\n}","old_text":"// ---- operators ----\n\n// ---- sorts (src/smt/data.rs) ----\n\n/// `t` as far as its sort is concerned: refinements, aliases (distinct\n/// ones too), variants (their sum) and tasks (their result) looked through.\nfn sort_type(vc: smt.Vc, t: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Refined { base, .. } => smt.sort_type(vc, base),\n    ast.UnionType(ms) => ast.UnionType(smt.flatten_all(vc, ms)),\n    ast.UnitType | ast.FnType { .. } => t,\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => smt.sort_type(vc, ast.Named { name: p, args }),\n      None => if name == \"Task\" && len(args) == 1 {\n        smt.sort_type(vc, get(args, 0) ?? ast.UnitType)\n      } else {\n        match get(vc.types, name) {\n          Some(td) => match td.body {\n            ast.Alias(a) => smt.sort_type(vc, smt.subst(a, smt.params_of(td, args))),\n            _ => ast.Named {\n              name,\n              args: args.map(a -> smt.sort_type(vc, a)),\n            },\n          },\n          None => ast.Named {\n            name,\n            args: args.map(a -> smt.sort_type(vc, a)),\n          },\n        }\n      },\n    },\n  }\n}"},{"name":"smt.dt_name","kind":"fn","old":"f3b98fd920a40d11","new":"2cd12e24e81c1ec3","interface_changed":false,"affected":[],"module":"smt","text":"/// The name of the datatype of `t`, a sort type.\nfn dt_name(t: ast.TypeExpr) -> String {\n  \"T:\" + replace(replace(text.type_text(t), \"|\", \"\"), \"\\\\\", \"\")\n}","old_text":"/// The name of the datatype of `t` (a sort type).\nfn dt_name(t: ast.TypeExpr) -> String {\n  \"T:\" + replace(replace(text.type_text(t), \"|\", \"\"), \"\\\\\", \"\")\n}"},{"name":"smt.new_datatype","kind":"fn","old":"121ae11cd7d06463","new":"d86357ca5dac4e8d","interface_changed":false,"affected":[],"module":"smt","text":"/// Declares the datatype `name` if it is new and returns its index. It is a\n/// placeholder while its constructors are made, since they may use it.\nfn new_datatype(mut vc: smt.Vc, name: String) -> Option[Int] {\n  if contains(vc.sort_index, name) {\n    return None\n  }\n  i := len(vc.sorts)\n  mut vc.sort_index.insert(name, i)\n  mut vc.sorts.push((name, smt.DataSort([])))\n  Some(i)\n}","old_text":"/// Declare the datatype `name` if it is new (a placeholder while its\n/// constructors are made: they may be of this sort): its index then.\nfn new_datatype(mut vc: smt.Vc, name: String) -> Option[Int] {\n  if contains(vc.sort_index, name) {\n    return None\n  }\n  i := len(vc.sorts)\n  mut vc.sort_index.insert(name, i)\n  mut vc.sorts.push((name, smt.DataSort([])))\n  Some(i)\n}"},{"name":"smt.field_sort","kind":"fn","old":"1a21985db2b0f119","new":"101d90782d528264","interface_changed":false,"affected":[],"module":"smt","text":"/// The sort of a field of type `t`: its own, or an uninterpreted one.\nfn field_sort(mut vc: smt.Vc, t: ast.TypeExpr) -> String {\n  match smt.sort_of(mut vc, t) {\n    Some(s) => s,\n    None => smt.opaque_sort(mut vc, \"Unmodelled\"),\n  }\n}","old_text":"/// The sort of a field of type `t`: its own, or an opaque one.\nfn field_sort(mut vc: smt.Vc, t: ast.TypeExpr) -> String {\n  match smt.sort_of(mut vc, t) {\n    Some(s) => s,\n    None => smt.opaque_sort(mut vc, \"Unmodelled\"),\n  }\n}"},{"name":"smt.declarations","kind":"fn","old":"4323ab92df2b602e","new":"25971864365db7d5","interface_changed":false,"affected":[],"module":"smt","text":"/// The declarations of every sort and predicate. The datatypes form one\n/// group, since they may refer to each other.\nfn declarations(vc: smt.Vc) -> String {\n  mut s := \"\"\n  mut heads := []\n  mut bodies := []\n  for (n, d) in vc.sorts {\n    match d {\n      smt.OpaqueSort | smt.ListSort(_) => {\n        s += f\"(declare-sort {smt.sym(n)} 0)\\n\"\n      },\n      smt.MapSort(_) => (),\n      smt.DataSort(cs) => {\n        mut heads.push(f\"({smt.sym(n)} 0)\")\n        mut ctors := []\n        for (c, fs) in cs {\n          mut fields := \"\"\n          for (k, f) in enumerate(fs) {\n            fields += f\" ({smt.sym(c + \".\" + f\"{k}\")} {f})\"\n          }\n          mut ctors.push(\"(\" + smt.sym(c) + fields + \")\")\n        }\n        mut bodies.push(\"(\" + join(ctors, \" \") + \")\")\n      },\n    }\n  }\n  if len(heads) > 0 {\n    s += \"(declare-datatypes (\"\n      + join(heads, \" \")\n      + \") (\"\n      + join(bodies, \" \")\n      + \"))\\n\"\n  }\n  for (n, d) in vc.sorts {\n    match d {\n      smt.DataSort(cs) => {\n        last := len(cs) - 1\n        mut e := if last < 0 {\n          \"0\"\n        } else {\n          f\"{last}\"\n        }\n        mut k := last - 1\n        while k >= 0 {\n          c := (get(cs, k) ?? (\"\", [])).0\n          e = f\"(ite ((_ is {smt.sym(c)}) x) {k} {e})\"\n          k -= 1\n        }\n        s += f\"(define-fun {smt.sym(n + \".tag\")} ((x {smt.sym(n)})) Int {e})\\n\"\n      },\n      _ => (),\n    }\n  }\n  for (n, d) in vc.sorts {\n    match d {\n      smt.ListSort(item) => {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".len\")\n          + \" (\"\n          + smt.sym(n)\n          + \") Int)\\n(declare-fun \"\n          + smt.sym(n + \".at\")\n          + \" (\"\n          + smt.sym(n)\n          + \" Int) \"\n          + item\n          + \")\\n\"\n      },\n      smt.MapSort(arr) => {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".size\")\n          + \" (\"\n          + arr\n          + \") Int)\\n\"\n      },\n      _ => (),\n    }\n  }\n  for (v, sort) in vc.valid {\n    s += f\"(declare-fun {v} ({sort}) Bool)\\n\"\n  }\n  for (r, (args, ret)) in items(vc.rec_fns) {\n    s += \"(declare-fun \"\n      + smt.sym(r)\n      + \" (\"\n      + join(args, \" \")\n      + \") \"\n      + ret\n      + \")\\n\"\n  }\n  for (f, a, r) in vc.of_receiver {\n    s += f\"(declare-fun {f} ({a}) {r})\\n\"\n  }\n  s\n}","old_text":"/// The declarations of every sort and predicate (the datatypes as one\n/// group: they may refer to each other).\nfn declarations(vc: smt.Vc) -> String {\n  mut s := \"\"\n  mut heads := []\n  mut bodies := []\n  for (n, d) in vc.sorts {\n    match d {\n      smt.OpaqueSort | smt.ListSort(_) => {\n        s += f\"(declare-sort {smt.sym(n)} 0)\\n\"\n      },\n      smt.MapSort(_) => (),\n      smt.DataSort(cs) => {\n        mut heads.push(f\"({smt.sym(n)} 0)\")\n        mut ctors := []\n        for (c, fs) in cs {\n          mut fields := \"\"\n          for (k, f) in enumerate(fs) {\n            fields += f\" ({smt.sym(c + \".\" + f\"{k}\")} {f})\"\n          }\n          mut ctors.push(\"(\" + smt.sym(c) + fields + \")\")\n        }\n        mut bodies.push(\"(\" + join(ctors, \" \") + \")\")\n      },\n    }\n  }\n  if len(heads) > 0 {\n    s += \"(declare-datatypes (\"\n      + join(heads, \" \")\n      + \") (\"\n      + join(bodies, \" \")\n      + \"))\\n\"\n  }\n  for (n, d) in vc.sorts {\n    match d {\n      smt.DataSort(cs) => {\n        last := len(cs) - 1\n        mut e := if last < 0 {\n          \"0\"\n        } else {\n          f\"{last}\"\n        }\n        mut k := last - 1\n        while k >= 0 {\n          c := (get(cs, k) ?? (\"\", [])).0\n          e = f\"(ite ((_ is {smt.sym(c)}) x) {k} {e})\"\n          k -= 1\n        }\n        s += f\"(define-fun {smt.sym(n + \".tag\")} ((x {smt.sym(n)})) Int {e})\\n\"\n      },\n      _ => (),\n    }\n  }\n  for (n, d) in vc.sorts {\n    match d {\n      smt.ListSort(item) => {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".len\")\n          + \" (\"\n          + smt.sym(n)\n          + \") Int)\\n(declare-fun \"\n          + smt.sym(n + \".at\")\n          + \" (\"\n          + smt.sym(n)\n          + \" Int) \"\n          + item\n          + \")\\n\"\n      },\n      smt.MapSort(arr) => {\n        s += \"(declare-fun \"\n          + smt.sym(n + \".size\")\n          + \" (\"\n          + arr\n          + \") Int)\\n\"\n      },\n      _ => (),\n    }\n  }\n  for (v, sort) in vc.valid {\n    s += f\"(declare-fun {v} ({sort}) Bool)\\n\"\n  }\n  for (r, (args, ret)) in items(vc.rec_fns) {\n    s += \"(declare-fun \"\n      + smt.sym(r)\n      + \" (\"\n      + join(args, \" \")\n      + \") \"\n      + ret\n      + \")\\n\"\n  }\n  for (f, a, r) in vc.of_receiver {\n    s += f\"(declare-fun {f} ({a}) {r})\\n\"\n  }\n  s\n}"},{"name":"smt.from_term","kind":"fn","old":"1d75d0d11ee6067a","new":"eaf75d058dabdbd4","interface_changed":false,"affected":[],"module":"smt","text":"/// The value a term of type `ty` stands for: a plain value for `Int`,\n/// `Bool`, `String`, and a `VData` (unfolded when read) for a structured\n/// one.\nfn from_term(mut vc: smt.Vc, ty: ast.TypeExpr, t: String) -> smt.Val {\n  match ty {\n    ast.Named { name, .. } => if smt.width_of(name) != None {\n      mut vc.facts.push(smt.word_range(name, t))\n      return smt.word(name, t)\n    },\n    _ => (),\n  }\n  match ty {\n    ast.Refined { base, .. } => smt.from_term(mut vc, base, t),\n    ast.UnitType => smt.UnitVal,\n    ast.FnType { ret, .. } => smt.VFn { ret },\n    ast.UnionType(_) => match smt.sort_of(mut vc, ty) {\n      Some(_) => smt.VData { ty, t },\n      None => smt.Opaque(\n        \"values of this union type are not modelled (members of overlapping or unknown shapes)\",\n      ),\n    },\n    ast.Named { name, args } => match name {\n      \"Int\" => smt.VInt(t),\n      \"Bool\" => smt.VBool(t),\n      \"String\" => {\n        if !contains(vc.str_terms, t) {\n          mut vc.str_terms.push(t)\n        }\n        smt.VStr(t)\n      },\n      \"Float\" => smt.Opaque(\"floats are not modelled yet\"),\n      \"List\" => match get(args, 0) {\n        Some(a) => {\n          n := smt.bare(smt.sort_of(mut vc, ty) ?? \"\")\n          l := smt.seq_len(n, t)\n          smt.define(mut vc, f\"(>= {l} 0)\", t)\n          smt.new_list(mut vc, l, smt.GSeq(t, a, n))\n        },\n        None => smt.Opaque(\"a list of unknown elements\"),\n      },\n      \"Dict\" | \"Set\" => match smt.map_sorts(mut vc, ty) {\n        Some(ms) => smt.keyed_array(mut vc, ty, ms, t),\n        None => {\n          l := smt.fresh_why(\n            mut vc,\n            \"Int\",\n            \"dicts and sets of these types are not modelled\",\n          )\n          mut vc.facts.push(f\"(>= {l} 0)\")\n          smt.keyed_list(mut vc, l, ty)\n        },\n      },\n      \"Task\" => smt.from_term(mut vc, get(args, 0) ?? ast.UnitType, t),\n      \"Tuple\" => smt.VData { ty, t },\n      _ => if contains(vc.parents, name) {\n        smt.VData { ty, t }\n      } else {\n        match get(vc.types, name) {\n          None => smt.VData { ty, t },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              ) }\n            } else {\n              smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              )\n            },\n            _ => smt.VData { ty, t },\n          },\n        }\n      },\n    },\n  }\n}","old_text":"/// The value a term of type `ty` stands for: a plain value for `Int`,\n/// `Bool`, `String`; a `VData` for a structured value (unfolded when read).\nfn from_term(mut vc: smt.Vc, ty: ast.TypeExpr, t: String) -> smt.Val {\n  match ty {\n    ast.Named { name, .. } => if smt.width_of(name) != None {\n      mut vc.facts.push(smt.word_range(name, t))\n      return smt.word(name, t)\n    },\n    _ => (),\n  }\n  match ty {\n    ast.Refined { base, .. } => smt.from_term(mut vc, base, t),\n    ast.UnitType => smt.UnitVal,\n    ast.FnType { ret, .. } => smt.VFn { ret },\n    ast.UnionType(_) => match smt.sort_of(mut vc, ty) {\n      Some(_) => smt.VData { ty, t },\n      None => smt.Opaque(\n        \"values of this union type are not modelled (members of overlapping or unknown shapes)\",\n      ),\n    },\n    ast.Named { name, args } => match name {\n      \"Int\" => smt.VInt(t),\n      \"Bool\" => smt.VBool(t),\n      \"String\" => {\n        if !contains(vc.str_terms, t) {\n          mut vc.str_terms.push(t)\n        }\n        smt.VStr(t)\n      },\n      \"Float\" => smt.Opaque(\"floats are not modelled yet\"),\n      \"List\" => match get(args, 0) {\n        Some(a) => {\n          n := smt.bare(smt.sort_of(mut vc, ty) ?? \"\")\n          l := smt.seq_len(n, t)\n          smt.define(mut vc, f\"(>= {l} 0)\", t)\n          smt.new_list(mut vc, l, smt.GSeq(t, a, n))\n        },\n        None => smt.Opaque(\"a list of unknown elements\"),\n      },\n      \"Dict\" | \"Set\" => match smt.map_sorts(mut vc, ty) {\n        Some(ms) => smt.keyed_array(mut vc, ty, ms, t),\n        None => {\n          l := smt.fresh_why(\n            mut vc,\n            \"Int\",\n            \"dicts and sets of these types are not modelled\",\n          )\n          mut vc.facts.push(f\"(>= {l} 0)\")\n          smt.keyed_list(mut vc, l, ty)\n        },\n      },\n      \"Task\" => smt.from_term(mut vc, get(args, 0) ?? ast.UnitType, t),\n      \"Tuple\" => smt.VData { ty, t },\n      _ => if contains(vc.parents, name) {\n        smt.VData { ty, t }\n      } else {\n        match get(vc.types, name) {\n          None => smt.VData { ty, t },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              ) }\n            } else {\n              smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              )\n            },\n            _ => smt.VData { ty, t },\n          },\n        }\n      },\n    },\n  }\n}"},{"name":"smt.unfold","kind":"fn","old":"50bfb253bbe16d91","new":"f5e9b9245bd8888e","interface_changed":false,"affected":[],"module":"smt","text":"/// One level of term `t` of type `ty`: a record's fields, a sum's tag and\n/// payloads, a tuple's items, each a selector of `t`. Facts from its type\n/// (a variant's constructor, its validity's definition) are stated the\n/// first time.\nfn unfold(mut vc: smt.Vc, ty: ast.TypeExpr, t: String) -> smt.Val {\n  key := text.type_text(ty) + \" \" + t\n  global := len(vc.regions) == 0 && !contains(t, \"@@\")\n  if global {\n    match get(vc.unfolded, key) {\n      Some(v) => return v,\n      None => (),\n    }\n  }\n  sort := match smt.sort_of(mut vc, ty) {\n    Some(s) => s,\n    None => return smt.Opaque(\"values of this type are not modelled\"),\n  }\n  cs := smt.ctors_of(vc, sort)\n  tag := if len(cs) == 1 {\n    \"0\"\n  } else {\n    \"(\" + smt.sym(smt.bare(sort) + \".tag\") + \" \" + t + \")\"\n  }\n  mut facts := []\n  v := match ty {\n    ast.Refined { base, .. } => return smt.unfold(mut vc, base, t),\n    ast.UnitType | ast.FnType { .. } => return smt.from_term(mut vc, ty, t),\n    ast.UnionType(ms) => match smt.union_groups(vc, ms) {\n      None => return smt.Opaque(\"values of this union type are not modelled\"),\n      Some(gs) => {\n        mut slots := []\n        for (i, g) in enumerate(gs) {\n          s := smt.selector((get(cs, i) ?? (\"\", [])).0, 0, t)\n          match g.only {\n            // a sum's variants: the member's constructor is one of them\n            Some(only) => {\n              inner := smt.sort_of(mut vc, g.ty) ?? \"\"\n              iname := smt.bare(inner)\n              tests := smt.ctors_of(vc, inner)\n                .filter(ic -> only.any(o -> ic.0 == iname + \".\" + o))\n                .map(ic -> \"((_ is \" + smt.sym(ic.0) + \") \" + s + \")\")\n              mut facts.push(\n                smt.implies(f\"(= {tag} {i})\", smt.or_all(tests)),\n              )\n            },\n            None => (),\n          }\n          mut slots.push((g.key, smt.from_term(mut vc, g.ty, s)))\n        }\n        smt.VUnion { tag, slots }\n      },\n    },\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => {\n        pv := smt.unfold(mut vc, ast.Named { name: p, args }, t)\n        c := smt.bare(sort) + \".\" + name\n        if cs.any(x -> x.0 == c) {\n          mut facts.push(f\"((_ is {smt.sym(c)}) {t})\")\n        }\n        pv\n      },\n      None => if name == \"Tuple\" {\n        c := (get(cs, 0) ?? (\"\", [])).0\n        mut xs := []\n        for (k, a) in enumerate(args) {\n          mut xs.push(smt.from_term(mut vc, a, smt.selector(c, k, t)))\n        }\n        smt.VTuple(xs)\n      } else if name == \"Task\" {\n        return smt.unfold(mut vc, get(args, 0) ?? ast.UnitType, t)\n      } else {\n        match get(vc.types, name) {\n          // a type parameter's value: a term of an uninterpreted sort.\n          // Equal terms are the same value, so a method's result on it is\n          // the same (`Counter::total(c)`).\n          None => return smt.VData { ty: ast.Named { name, args }, t },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              ) }\n            } else {\n              return smt.unfold(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              )\n            },\n            ast.RecordBody(_) => {\n              c := (get(cs, 0) ?? (\"\", [])).0\n              rc := get(smt.variants_of(vc, name, args) ?? [], 0) ?? smt.Ctor { name, fields: None, types: [] }\n              mut fs := []\n              for (k, f) in enumerate(rc.fields ?? []) {\n                ft := get(rc.types, k) ?? ast.UnitType\n                mut fs.push(\n                  (\n                    f,\n                    smt.from_term(mut vc, ft, smt.selector(c, k, t)),\n                  ),\n                )\n              }\n              smt.VRec { name, fields: fs }\n            },\n            ast.SumBody(_) => {\n              mut ctors := []\n              for (i, v) in enumerate(smt.variants_of(vc, name, args) ?? []) {\n                c := (get(cs, i) ?? (\"\", [])).0\n                mut payload := []\n                for (k, ft) in enumerate(v.types) {\n                  mut payload.push(\n                    smt.from_term(mut vc, ft, smt.selector(c, k, t)),\n                  )\n                }\n                mut ctors.push((v.name, payload))\n              }\n              smt.VSum { ty: name, args, tag, ctors }\n            },\n          },\n        }\n      },\n    },\n  }\n  if global {\n    mut vc.unfolded.insert(key, v)\n  }\n  for f in facts {\n    smt.define(mut vc, f, t)\n  }\n  if smt.refined(vc, ty) {\n    // what \"valid\" means for this term: its level checked, its parts by\n    // their own predicates\n    vt := smt.valid_term(mut vc, ty, t)\n    if !global || !contains(vc.defined, vt) {\n      if global {\n        mut vc.defined.insert(vt)\n      }\n      pc := vc.pc\n      checking := vc.checking\n      proving := vc.proving\n      dead := vc.dead\n      vc.pc = []\n      vc.checking = []\n      vc.proving = 0\n      vc.dead = false\n      vc.spec += 1\n      // a definition: both directions\n      pol := vc.polarity\n      vc.polarity = 0\n      c := smt.check_type(mut vc, ty, v, [])\n      vc.polarity = pol\n      vc.spec -= 1\n      vc.dead = dead\n      vc.proving = proving\n      vc.checking = checking\n      vc.pc = pc\n      smt.define(mut vc, f\"(= {vt} {c})\", t)\n    }\n  }\n  v\n}","old_text":"/// One level of term `t` of type `ty`: a record's fields, a sum's tag and\n/// payloads, a tuple's items, each a selector of `t`. What its type gives\n/// (a variant's constructor, its validity's definition) is stated the\n/// first time.\nfn unfold(mut vc: smt.Vc, ty: ast.TypeExpr, t: String) -> smt.Val {\n  key := text.type_text(ty) + \" \" + t\n  global := len(vc.regions) == 0 && !contains(t, \"@@\")\n  if global {\n    match get(vc.unfolded, key) {\n      Some(v) => return v,\n      None => (),\n    }\n  }\n  sort := match smt.sort_of(mut vc, ty) {\n    Some(s) => s,\n    None => return smt.Opaque(\"values of this type are not modelled\"),\n  }\n  cs := smt.ctors_of(vc, sort)\n  tag := if len(cs) == 1 {\n    \"0\"\n  } else {\n    \"(\" + smt.sym(smt.bare(sort) + \".tag\") + \" \" + t + \")\"\n  }\n  mut facts := []\n  v := match ty {\n    ast.Refined { base, .. } => return smt.unfold(mut vc, base, t),\n    ast.UnitType | ast.FnType { .. } => return smt.from_term(mut vc, ty, t),\n    ast.UnionType(ms) => match smt.union_groups(vc, ms) {\n      None => return smt.Opaque(\"values of this union type are not modelled\"),\n      Some(gs) => {\n        mut slots := []\n        for (i, g) in enumerate(gs) {\n          s := smt.selector((get(cs, i) ?? (\"\", [])).0, 0, t)\n          match g.only {\n            // a sum's variants: the member's constructor is one of them\n            Some(only) => {\n              inner := smt.sort_of(mut vc, g.ty) ?? \"\"\n              iname := smt.bare(inner)\n              tests := smt.ctors_of(vc, inner)\n                .filter(ic -> only.any(o -> ic.0 == iname + \".\" + o))\n                .map(ic -> \"((_ is \" + smt.sym(ic.0) + \") \" + s + \")\")\n              mut facts.push(\n                smt.implies(f\"(= {tag} {i})\", smt.or_all(tests)),\n              )\n            },\n            None => (),\n          }\n          mut slots.push((g.key, smt.from_term(mut vc, g.ty, s)))\n        }\n        smt.VUnion { tag, slots }\n      },\n    },\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => {\n        pv := smt.unfold(mut vc, ast.Named { name: p, args }, t)\n        c := smt.bare(sort) + \".\" + name\n        if cs.any(x -> x.0 == c) {\n          mut facts.push(f\"((_ is {smt.sym(c)}) {t})\")\n        }\n        pv\n      },\n      None => if name == \"Tuple\" {\n        c := (get(cs, 0) ?? (\"\", [])).0\n        mut xs := []\n        for (k, a) in enumerate(args) {\n          mut xs.push(smt.from_term(mut vc, a, smt.selector(c, k, t)))\n        }\n        smt.VTuple(xs)\n      } else if name == \"Task\" {\n        return smt.unfold(mut vc, get(args, 0) ?? ast.UnitType, t)\n      } else {\n        match get(vc.types, name) {\n          // a type parameter's value: a term of a sort nothing is known\n          // of (equal terms are the same value: a method's result on it\n          // is the same, `Counter::total(c)`)\n          None => return smt.VData { ty: ast.Named { name, args }, t },\n          Some(td) => match td.body {\n            ast.Alias(a) => if td.distinct {\n              smt.VDistinct { name, inner: smt.from_term(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              ) }\n            } else {\n              return smt.unfold(\n                mut vc,\n                smt.subst(a, smt.params_of(td, args)),\n                t,\n              )\n            },\n            ast.RecordBody(_) => {\n              c := (get(cs, 0) ?? (\"\", [])).0\n              rc := get(smt.variants_of(vc, name, args) ?? [], 0) ?? smt.Ctor { name, fields: None, types: [] }\n              mut fs := []\n              for (k, f) in enumerate(rc.fields ?? []) {\n                ft := get(rc.types, k) ?? ast.UnitType\n                mut fs.push(\n                  (\n                    f,\n                    smt.from_term(mut vc, ft, smt.selector(c, k, t)),\n                  ),\n                )\n              }\n              smt.VRec { name, fields: fs }\n            },\n            ast.SumBody(_) => {\n              mut ctors := []\n              for (i, v) in enumerate(smt.variants_of(vc, name, args) ?? []) {\n                c := (get(cs, i) ?? (\"\", [])).0\n                mut payload := []\n                for (k, ft) in enumerate(v.types) {\n                  mut payload.push(\n                    smt.from_term(mut vc, ft, smt.selector(c, k, t)),\n                  )\n                }\n                mut ctors.push((v.name, payload))\n              }\n              smt.VSum { ty: name, args, tag, ctors }\n            },\n          },\n        }\n      },\n    },\n  }\n  if global {\n    mut vc.unfolded.insert(key, v)\n  }\n  for f in facts {\n    smt.define(mut vc, f, t)\n  }\n  if smt.refined(vc, ty) {\n    // what \"valid\" means for this term: its level checked, its parts by\n    // their own predicates\n    vt := smt.valid_term(mut vc, ty, t)\n    if !global || !contains(vc.defined, vt) {\n      if global {\n        mut vc.defined.insert(vt)\n      }\n      pc := vc.pc\n      checking := vc.checking\n      proving := vc.proving\n      dead := vc.dead\n      vc.pc = []\n      vc.checking = []\n      vc.proving = 0\n      vc.dead = false\n      vc.spec += 1\n      // (a definition: both ways)\n      pol := vc.polarity\n      vc.polarity = 0\n      c := smt.check_type(mut vc, ty, v, [])\n      vc.polarity = pol\n      vc.spec -= 1\n      vc.dead = dead\n      vc.proving = proving\n      vc.checking = checking\n      vc.pc = pc\n      smt.define(mut vc, f\"(= {vt} {c})\", t)\n    }\n  }\n  v\n}"},{"name":"smt.force","kind":"fn","old":"5fddc122595297fd","new":"3d6ed493198cdee8","interface_changed":false,"affected":[],"module":"smt","text":"/// `v`, unfolded one level if it is a datatype term.\nfn force(mut vc: smt.Vc, v: smt.Val) -> smt.Val {\n  match v {\n    smt.VData { ty, t } => {\n      u := smt.unfold(mut vc, ty, t)\n      match u {\n        // a type parameter's value: a term nothing more is known of\n        smt.VData { t: same, .. } => if same == t {\n          smt.Opaque(\n            f\"values of the generic type `{text.type_text(ty)}` are not known\",\n          )\n        } else {\n          u\n        },\n        _ => u,\n      }\n    },\n    other => other,\n  }\n}","old_text":"/// `v`, unfolded one level if it is a datatype term.\nfn force(mut vc: smt.Vc, v: smt.Val) -> smt.Val {\n  match v {\n    smt.VData { ty, t } => {\n      u := smt.unfold(mut vc, ty, t)\n      match u {\n        // (a type parameter's value: a term nothing more is known of)\n        smt.VData { t: same, .. } => if same == t {\n          smt.Opaque(\n            f\"values of the generic type `{text.type_text(ty)}` are not known\",\n          )\n        } else {\n          u\n        },\n        _ => u,\n      }\n    },\n    other => other,\n  }\n}"},{"name":"smt.merge_data","kind":"fn","old":"2b0037bf843f03cc","new":"0a5e6684c27dd79c","interface_changed":false,"affected":[],"module":"smt","text":"/// Two datatype terms merged: the term that is either, with either's\n/// validity.\nfn merge_data(\n  mut vc: smt.Vc,\n  c: String,\n  ta: ast.TypeExpr,\n  a: String,\n  tb: ast.TypeExpr,\n  b: String,\n) -> Option[smt.Val] {\n  same := smt.erased(vc, ta) == smt.erased(vc, tb)\n  sa := smt.sort_of(mut vc, ta)\n  sb := smt.sort_of(mut vc, tb)\n  if sa != sb || !same && sa == None {\n    return None\n  }\n  t := smt.ite(c, a, b)\n  if smt.refined(vc, ta) && t != a {\n    v := smt.valid_term(mut vc, ta, t)\n    va := smt.valid_term(mut vc, ta, a)\n    // of the same sort but checked differently (`Tree[K]` and a generic\n    // callee's `Tree[T]`): `b` is checked as a `ta`, to a fixed depth.\n    // Taking both apart instead would recurse forever on a recursive type.\n    vb := if same {\n      smt.valid_term(mut vc, ta, b)\n    } else {\n      vc.spec += 1\n      x := smt.check_type(mut vc, ta, smt.VData { ty: tb, t: b }, [])\n      vc.spec -= 1\n      x\n    }\n    smt.define(mut vc, f\"(= {v} {smt.ite(c, va, vb)})\", t)\n  }\n  Some(smt.VData { ty: ta, t })\n}","old_text":"/// Two datatype terms merged: the term that is either, and its validity,\n/// either's.\nfn merge_data(\n  mut vc: smt.Vc,\n  c: String,\n  ta: ast.TypeExpr,\n  a: String,\n  tb: ast.TypeExpr,\n  b: String,\n) -> Option[smt.Val] {\n  same := smt.erased(vc, ta) == smt.erased(vc, tb)\n  sa := smt.sort_of(mut vc, ta)\n  sb := smt.sort_of(mut vc, tb)\n  if sa != sb || !same && sa == None {\n    return None\n  }\n  t := smt.ite(c, a, b)\n  if smt.refined(vc, ta) && t != a {\n    v := smt.valid_term(mut vc, ta, t)\n    va := smt.valid_term(mut vc, ta, a)\n    // of the same sort but checked differently (`Tree[K]` and a generic\n    // callee's `Tree[T]`): `b` checked as a `ta`, to a fixed depth. Taking\n    // both apart instead would go down a recursive type forever.\n    vb := if same {\n      smt.valid_term(mut vc, ta, b)\n    } else {\n      vc.spec += 1\n      x := smt.check_type(mut vc, ta, smt.VData { ty: tb, t: b }, [])\n      vc.spec -= 1\n      x\n    }\n    smt.define(mut vc, f\"(= {v} {smt.ite(c, va, vb)})\", t)\n  }\n  Some(smt.VData { ty: ta, t })\n}"},{"name":"smt.position","kind":"fn","old":"972194b35a820905","new":"40d1cb51bfd2e108","interface_changed":false,"affected":[],"module":"smt","text":"/// The index of constructor `name` among a sum's.\nfn position(ctors: List[(String, List[smt.Val])], name: String) -> Option[Int] {\n  for (k, c) in enumerate(ctors) {\n    if c.0 == name {\n      return Some(k)\n    }\n  }\n  None\n}","old_text":"/// Where constructor `name` is among a sum's.\nfn position(ctors: List[(String, List[smt.Val])], name: String) -> Option[Int] {\n  for (k, c) in enumerate(ctors) {\n    if c.0 == name {\n      return Some(k)\n    }\n  }\n  None\n}"},{"name":"smt.part","kind":"fn","old":"313a52e1fdd5f038","new":"743efcf127e0f0df","interface_changed":false,"affected":[],"module":"smt","text":"/// A part of a value of type `t`: built now when it is a plain value, else\n/// a term of its datatype.\nfn part(mut vc: smt.Vc, t: ast.TypeExpr) -> smt.Val {\n  if !smt.structured(vc, t) {\n    return smt.shape(mut vc, t)\n  }\n  match smt.sort_of(mut vc, t) {\n    Some(s) => {\n      x := smt.fresh(mut vc, s)\n      smt.from_term(mut vc, t, x)\n    },\n    None => smt.Opaque(\"values of this type are not modelled\"),\n  }\n}","old_text":"/// A part of a value, of type `t`: made now when it is a plain value, else\n/// a term of its datatype.\nfn part(mut vc: smt.Vc, t: ast.TypeExpr) -> smt.Val {\n  if !smt.structured(vc, t) {\n    return smt.shape(mut vc, t)\n  }\n  match smt.sort_of(mut vc, t) {\n    Some(s) => {\n      x := smt.fresh(mut vc, s)\n      smt.from_term(mut vc, t, x)\n    },\n    None => smt.Opaque(\"values of this type are not modelled\"),\n  }\n}"},{"name":"smt.valid_by_construction","kind":"fn","old":"9d2d974b3336cb36","new":"3173dc9116ccbf7a","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether every value of `t` is valid: a record or sum type of the program\n/// with no refinement of its own and no type parameters.\nfn valid_by_construction(vc: smt.Vc, t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Named { name, args } => {\n      n := get(vc.parents, name) ?? name\n      len(args) == 0\n        && match get(vc.types, n) {\n          Some(td) => len(td.params) == 0\n            && td.refinement == None\n            && !td.distinct\n            && match td.body {\n              ast.RecordBody(_) | ast.SumBody(_) => true,\n              _ => false,\n            },\n          None => false,\n        }\n    },\n    _ => false,\n  }\n}","old_text":"/// A record or sum type of the program with no refinement of its own and\n/// no type parameters: every value of it is valid.\nfn valid_by_construction(vc: smt.Vc, t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Named { name, args } => {\n      n := get(vc.parents, name) ?? name\n      len(args) == 0\n        && match get(vc.types, n) {\n          Some(td) => len(td.params) == 0\n            && td.refinement == None\n            && !td.distinct\n            && match td.body {\n              ast.RecordBody(_) | ast.SumBody(_) => true,\n              _ => false,\n            },\n          None => false,\n        }\n    },\n    _ => false,\n  }\n}"},{"name":"smt.check_type_at","kind":"fn","old":"9b786a466d07610c","new":"187b7e6102fa532f","interface_changed":false,"affected":[],"module":"smt","text":"fn check_type_at(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  v: smt.Val,\n  extra: List[(String, smt.Val)],\n) -> String {\n  if smt.is_absent(v) || !smt.refined(vc, t) {\n    return \"true\"\n  }\n  match v {\n    smt.Opaque(r) => return smt.unknown_bool(mut vc, r),\n    // a union value against one type (a narrowed value passed on): its\n    // active member must be of that type\n    smt.VUnion { .. } => if !smt.union_or_refined(t) && !smt.is_alias(vc, t) {\n      return smt.in_type(mut vc, t, v, extra)\n    },\n    _ => (),\n  }\n  match t {\n    // valid for a union: a valid value of one of its members\n    ast.UnionType(ms) => {\n      mut cs := []\n      for m in ms {\n        mut cs.push(smt.in_type(mut vc, m, v, extra))\n      }\n      smt.or_all(cs)\n    },\n    ast.Refined { base, pred: p } => {\n      a := smt.check_type(mut vc, base, v, extra)\n      c := smt.pred(mut vc, p, extra + [(\"it\", v)])\n      smt.and_all([a, c])\n    },\n    ast.UnitType | ast.FnType { .. } => \"true\",\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => {\n        c := smt.check_type(\n          mut vc,\n          ast.Named { name: p, args },\n          v,\n          extra,\n        )\n        match v {\n          smt.VSum { tag, ctors, .. } => match smt.position(ctors, name) {\n            Some(k) => smt.and_all([f\"(= {tag} {k})\", c]),\n            None => \"false\",\n          },\n          _ => smt.unknown_bool(mut vc, \"a value of an unexpected shape\"),\n        }\n      },\n      None => match (name, v) {\n        (\"List\", smt.VList { len, id }) => match get(args, 0) {\n          None => \"true\",\n          Some(t) => match smt.list_info(vc, id).source {\n            // a sequence of a datatype value: its own predicate\n            smt.GSeq(s, et, _) => if smt.erased(vc, et) == smt.erased(vc, t) {\n              smt.valid_term(\n                mut vc,\n                ast.Named { name: \"List\", args: [et] },\n                s,\n              )\n            } else {\n              smt.list_valid(mut vc, len, id, t, v)\n            },\n            _ => smt.list_valid(mut vc, len, id, t, v),\n          },\n        },\n        (\"Tuple\", smt.VTuple(xs)) => {\n          mut cs := []\n          for (i, a) in enumerate(args) {\n            match get(xs, i) {\n              Some(x) => mut cs.push(smt.check_type(mut vc, a, x, [])),\n              None => (),\n            }\n          }\n          smt.and_all(cs)\n        },\n        // a dict's or set's array: its predicate, which each operation\n        // preserves (`map_valid`)\n        (\"Dict\", smt.VList { id, .. }) | (\"Set\", smt.VList { id, .. }) => match get(vc.arrays, id) {\n          Some(a) => smt.valid_term(mut vc, ast.Named { name, args }, a),\n          None => smt.unknown_bool(\n            mut vc,\n            \"a dict or set of types not modelled\",\n          ),\n        },\n        (\"Dict\", _) | (\"Set\", _) => smt.unknown_bool(\n          mut vc,\n          \"a dict or set of types not modelled\",\n        ),\n        _ => match get(vc.types, name) {\n          None => \"true\",\n          Some(td) => smt.check_named(mut vc, name, args, td, v),\n        },\n      },\n    },\n  }\n}","old_text":"fn check_type_at(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  v: smt.Val,\n  extra: List[(String, smt.Val)],\n) -> String {\n  if smt.is_absent(v) || !smt.refined(vc, t) {\n    return \"true\"\n  }\n  match v {\n    smt.Opaque(r) => return smt.unknown_bool(mut vc, r),\n    // a union value against one type (a narrowed value passed on): its\n    // active member must be of that type\n    smt.VUnion { .. } => if !smt.union_or_refined(t) && !smt.is_alias(vc, t) {\n      return smt.in_type(mut vc, t, v, extra)\n    },\n    _ => (),\n  }\n  match t {\n    // valid for a union: a valid value of one of its members\n    ast.UnionType(ms) => {\n      mut cs := []\n      for m in ms {\n        mut cs.push(smt.in_type(mut vc, m, v, extra))\n      }\n      smt.or_all(cs)\n    },\n    ast.Refined { base, pred: p } => {\n      a := smt.check_type(mut vc, base, v, extra)\n      c := smt.pred(mut vc, p, extra + [(\"it\", v)])\n      smt.and_all([a, c])\n    },\n    ast.UnitType | ast.FnType { .. } => \"true\",\n    ast.Named { name, args } => match get(vc.parents, name) {\n      Some(p) => {\n        c := smt.check_type(\n          mut vc,\n          ast.Named { name: p, args },\n          v,\n          extra,\n        )\n        match v {\n          smt.VSum { tag, ctors, .. } => match smt.position(ctors, name) {\n            Some(k) => smt.and_all([f\"(= {tag} {k})\", c]),\n            None => \"false\",\n          },\n          _ => smt.unknown_bool(mut vc, \"a value of an unexpected shape\"),\n        }\n      },\n      None => match (name, v) {\n        (\"List\", smt.VList { len, id }) => match get(args, 0) {\n          None => \"true\",\n          Some(t) => match smt.list_info(vc, id).source {\n            // a sequence of a datatype value: its own predicate\n            smt.GSeq(s, et, _) => if smt.erased(vc, et) == smt.erased(vc, t) {\n              smt.valid_term(\n                mut vc,\n                ast.Named { name: \"List\", args: [et] },\n                s,\n              )\n            } else {\n              smt.list_valid(mut vc, len, id, t, v)\n            },\n            _ => smt.list_valid(mut vc, len, id, t, v),\n          },\n        },\n        (\"Tuple\", smt.VTuple(xs)) => {\n          mut cs := []\n          for (i, a) in enumerate(args) {\n            match get(xs, i) {\n              Some(x) => mut cs.push(smt.check_type(mut vc, a, x, [])),\n              None => (),\n            }\n          }\n          smt.and_all(cs)\n        },\n        // a dict's or set's array: its predicate, which each operation\n        // carries over (`map_valid`)\n        (\"Dict\", smt.VList { id, .. }) | (\"Set\", smt.VList { id, .. }) => match get(vc.arrays, id) {\n          Some(a) => smt.valid_term(mut vc, ast.Named { name, args }, a),\n          None => smt.unknown_bool(\n            mut vc,\n            \"a dict or set of types not modelled\",\n          ),\n        },\n        (\"Dict\", _) | (\"Set\", _) => smt.unknown_bool(\n          mut vc,\n          \"a dict or set of types not modelled\",\n        ),\n        _ => match get(vc.types, name) {\n          None => \"true\",\n          Some(td) => smt.check_named(mut vc, name, args, td, v),\n        },\n      },\n    },\n  }\n}"},{"name":"smt.check_named","kind":"fn","old":"0f8cbaf2e8d02de7","new":"a9d6a6f63f537a39","interface_changed":false,"affected":[],"module":"smt","text":"/// `v` checked against the program's type `name` at `args`: its parts,\n/// then its own refinement.\nfn check_named(\n  mut vc: smt.Vc,\n  name: String,\n  given: List[ast.TypeExpr],\n  td: ast.TypeDecl,\n  v: smt.Val,\n) -> String {\n  // when proving, a type argument whose values are all valid needs no\n  // check where the type holds one. Assumed facts keep them.\n  args := if vc.proving > 0 {\n    given.map(\n      a -> if smt.valid_by_construction(vc, a) {\n        smt.named(\"_\")\n      } else {\n        a\n      },\n    )\n  } else {\n    given\n  }\n  sub := smt.params_of(td, args)\n  mut cs := []\n  it := match (td.body, v) {\n    (ast.Alias(a), smt.VDistinct { inner, .. }) => if td.distinct {\n      mut cs.push(smt.check_type(mut vc, smt.subst(a, sub), inner, []))\n      inner\n    } else {\n      mut cs.push(smt.check_type(mut vc, smt.subst(a, sub), v, []))\n      v\n    },\n    (ast.Alias(a), _) => if !td.distinct {\n      mut cs.push(smt.check_type(mut vc, smt.subst(a, sub), v, []))\n      v\n    } else {\n      return smt.unknown_bool(mut vc, \"a value of an unexpected shape\")\n    },\n    (ast.RecordBody(_), smt.VRec { fields, .. }) => {\n      rc := get(smt.variants_of(vc, name, args) ?? [], 0) ?? smt.Ctor { name, fields: None, types: [] }\n      for (k, ft) in enumerate(rc.types) {\n        match get(fields, k) {\n          Some(f) => mut cs.push(smt.check_type(mut vc, ft, f.1, [])),\n          None => (),\n        }\n      }\n      v\n    },\n    (ast.SumBody(_), smt.VSum { tag, ctors, .. }) => {\n      for (k, c) in enumerate(smt.variants_of(vc, name, args) ?? []) {\n        payload := (get(ctors, k) ?? (\"\", [])).1\n        mut fc := []\n        for (i, ft) in enumerate(c.types) {\n          match get(payload, i) {\n            Some(x) => mut fc.push(smt.check_type(mut vc, ft, x, [])),\n            None => (),\n          }\n        }\n        all := smt.and_all(fc)\n        if all != \"true\" {\n          mut cs.push(smt.implies(f\"(= {tag} {k})\", all))\n        }\n      }\n      v\n    },\n    _ => return smt.unknown_bool(mut vc, \"a value of an unexpected shape\"),\n  }\n  match td.refinement {\n    // a record's refinement names its fields too: `where\n    // all(table.items(), …)`\n    Some(r) => mut cs.push(\n      smt.pred(mut vc, r, [(\"it\", it)]\n        + match it {\n          smt.VRec { fields, .. } => fields,\n          _ => [],\n        }),\n    ),\n    None => (),\n  }\n  smt.and_all(cs)\n}","old_text":"/// `v` against the program's type `name` at `args`: its parts, then its\n/// own refinement.\nfn check_named(\n  mut vc: smt.Vc,\n  name: String,\n  given: List[ast.TypeExpr],\n  td: ast.TypeDecl,\n  v: smt.Val,\n) -> String {\n  // to prove: a type argument whose values are all valid has nothing to\n  // check where the type holds one; facts to assume keep them\n  args := if vc.proving > 0 {\n    given.map(\n      a -> if smt.valid_by_construction(vc, a) {\n        smt.named(\"_\")\n      } else {\n        a\n      },\n    )\n  } else {\n    given\n  }\n  sub := smt.params_of(td, args)\n  mut cs := []\n  it := match (td.body, v) {\n    (ast.Alias(a), smt.VDistinct { inner, .. }) => if td.distinct {\n      mut cs.push(smt.check_type(mut vc, smt.subst(a, sub), inner, []))\n      inner\n    } else {\n      mut cs.push(smt.check_type(mut vc, smt.subst(a, sub), v, []))\n      v\n    },\n    (ast.Alias(a), _) => if !td.distinct {\n      mut cs.push(smt.check_type(mut vc, smt.subst(a, sub), v, []))\n      v\n    } else {\n      return smt.unknown_bool(mut vc, \"a value of an unexpected shape\")\n    },\n    (ast.RecordBody(_), smt.VRec { fields, .. }) => {\n      rc := get(smt.variants_of(vc, name, args) ?? [], 0) ?? smt.Ctor { name, fields: None, types: [] }\n      for (k, ft) in enumerate(rc.types) {\n        match get(fields, k) {\n          Some(f) => mut cs.push(smt.check_type(mut vc, ft, f.1, [])),\n          None => (),\n        }\n      }\n      v\n    },\n    (ast.SumBody(_), smt.VSum { tag, ctors, .. }) => {\n      for (k, c) in enumerate(smt.variants_of(vc, name, args) ?? []) {\n        payload := (get(ctors, k) ?? (\"\", [])).1\n        mut fc := []\n        for (i, ft) in enumerate(c.types) {\n          match get(payload, i) {\n            Some(x) => mut fc.push(smt.check_type(mut vc, ft, x, [])),\n            None => (),\n          }\n        }\n        all := smt.and_all(fc)\n        if all != \"true\" {\n          mut cs.push(smt.implies(f\"(= {tag} {k})\", all))\n        }\n      }\n      v\n    },\n    _ => return smt.unknown_bool(mut vc, \"a value of an unexpected shape\"),\n  }\n  match td.refinement {\n    // (a record's refinement names its fields too: `where all(table.items(),\n    // …)`)\n    Some(r) => mut cs.push(\n      smt.pred(mut vc, r, [(\"it\", it)]\n        + match it {\n          smt.VRec { fields, .. } => fields,\n          _ => [],\n        }),\n    ),\n    None => (),\n  }\n  smt.and_all(cs)\n}"},{"name":"smt.different","kind":"fn","old":"6eb4418bbc6080d3","new":"4107e980e5f27326","interface_changed":false,"affected":[],"module":"smt","text":"/// Values of different shapes merged into a union.\nfn different(mut vc: smt.Vc, c: String, a: smt.Val, b: smt.Val) -> smt.Val {\n  smt.merge_union(mut vc, c, a, b) ?? smt.Opaque(\"values of different shapes were merged\")\n}","old_text":"/// Values of different shapes merged: a union.\nfn different(mut vc: smt.Vc, c: String, a: smt.Val, b: smt.Val) -> smt.Val {\n  smt.merge_union(mut vc, c, a, b) ?? smt.Opaque(\"values of different shapes were merged\")\n}"},{"name":"smt.field","kind":"fn","old":"c9787564a4665f6c","new":"2c908995ad06b352","interface_changed":false,"affected":[],"module":"smt","text":"// ---- fields, constructors, patterns ----\n\nfn field(mut vc: smt.Vc, v: smt.Val, f: String) -> smt.Val {\n  match v {\n    smt.VData { .. } => {\n      fv := smt.force(mut vc, v)\n      smt.field(mut vc, fv, f)\n    },\n    smt.VRec { fields, .. } => {\n      for x in fields {\n        if x.0 == f {\n          return x.1\n        }\n      }\n      smt.Opaque(f\"field `{f}`\")\n    },\n    smt.VDistinct { inner, .. } => if f == \"value\" {\n      inner\n    } else {\n      smt.Opaque(f\"field `{f}` of a value of an unexpected shape\")\n    },\n    smt.VTuple(xs) => match parse_int(f) {\n      Some(i) => get(xs, i) ?? smt.Opaque(f\"field `{f}`\"),\n      None => smt.Opaque(f\"field `{f}`\"),\n    },\n    smt.VSum { ty, args, tag, ctors } => {\n      // a field every variant that has it shares: the field of whichever\n      // constructor is active\n      mut found := []\n      for (k, c) in enumerate(smt.variants_of(vc, ty, args) ?? []) {\n        match c.fields {\n          Some(ns) => {\n            for (i, n) in enumerate(ns) {\n              if n == f {\n                match get((get(ctors, k) ?? (\"\", [])).1, i) {\n                  Some(x) => mut found.push((k, x)),\n                  None => (),\n                }\n              }\n            }\n          },\n          None => (),\n        }\n      }\n      if len(found) == 0 {\n        return smt.Opaque(f\"field `{f}`\")\n      }\n      mut r := (get(found, len(found) - 1) ?? (0, smt.Inactive)).1\n      mut k := len(found) - 2\n      while k >= 0 {\n        x := get(found, k) ?? (0, smt.Inactive)\n        r = smt.merge(mut vc, f\"(= {tag} {x.0})\", x.1, r)\n        k -= 1\n      }\n      r\n    },\n    // a union's field (every member has it, or the value was narrowed to\n    // members that do): the active member's field, or any value for a\n    // member without it\n    smt.VUnion { tag, slots } => {\n      mut r := smt.Opaque(f\"field `{f}` of a union member without it\")\n      mut i := len(slots) - 1\n      while i >= 0 {\n        s := (get(slots, i) ?? (\"\", smt.Inactive)).1\n        if !smt.is_absent(s) {\n          x := smt.field(mut vc, s, f)\n          r = smt.merge(mut vc, f\"(= {tag} {i})\", x, r)\n        }\n        i -= 1\n      }\n      r\n    },\n    smt.Opaque(r) => smt.Opaque(r),\n    _ => smt.Opaque(f\"field `{f}` of a value of an unexpected shape\"),\n  }\n}","old_text":"// ---- fields, constructors, patterns ----\n\nfn field(mut vc: smt.Vc, v: smt.Val, f: String) -> smt.Val {\n  match v {\n    smt.VData { .. } => {\n      fv := smt.force(mut vc, v)\n      smt.field(mut vc, fv, f)\n    },\n    smt.VRec { fields, .. } => {\n      for x in fields {\n        if x.0 == f {\n          return x.1\n        }\n      }\n      smt.Opaque(f\"field `{f}`\")\n    },\n    smt.VDistinct { inner, .. } => if f == \"value\" {\n      inner\n    } else {\n      smt.Opaque(f\"field `{f}` of a value of an unexpected shape\")\n    },\n    smt.VTuple(xs) => match parse_int(f) {\n      Some(i) => get(xs, i) ?? smt.Opaque(f\"field `{f}`\"),\n      None => smt.Opaque(f\"field `{f}`\"),\n    },\n    smt.VSum { ty, args, tag, ctors } => {\n      // a field every variant that has it shares: the field of whichever\n      // constructor is active\n      mut found := []\n      for (k, c) in enumerate(smt.variants_of(vc, ty, args) ?? []) {\n        match c.fields {\n          Some(ns) => {\n            for (i, n) in enumerate(ns) {\n              if n == f {\n                match get((get(ctors, k) ?? (\"\", [])).1, i) {\n                  Some(x) => mut found.push((k, x)),\n                  None => (),\n                }\n              }\n            }\n          },\n          None => (),\n        }\n      }\n      if len(found) == 0 {\n        return smt.Opaque(f\"field `{f}`\")\n      }\n      mut r := (get(found, len(found) - 1) ?? (0, smt.Inactive)).1\n      mut k := len(found) - 2\n      while k >= 0 {\n        x := get(found, k) ?? (0, smt.Inactive)\n        r = smt.merge(mut vc, f\"(= {tag} {x.0})\", x.1, r)\n        k -= 1\n      }\n      r\n    },\n    // a union's field (every member has it, or the value was narrowed to\n    // members that have it): the field of the active member; any value for\n    // a member that has no such field\n    smt.VUnion { tag, slots } => {\n      mut r := smt.Opaque(f\"field `{f}` of a union member without it\")\n      mut i := len(slots) - 1\n      while i >= 0 {\n        s := (get(slots, i) ?? (\"\", smt.Inactive)).1\n        if !smt.is_absent(s) {\n          x := smt.field(mut vc, s, f)\n          r = smt.merge(mut vc, f\"(= {tag} {i})\", x, r)\n        }\n        i -= 1\n      }\n      r\n    },\n    smt.Opaque(r) => smt.Opaque(r),\n    _ => smt.Opaque(f\"field `{f}` of a value of an unexpected shape\"),\n  }\n}"},{"name":"smt.ordered","kind":"fn","old":"fb90f7d687586221","new":"18583ac5f0f4756d","interface_changed":false,"affected":[],"module":"smt","text":"/// The values of a constructor's named fields, in declared order.\nfn ordered(\n  mut vc: smt.Vc,\n  names: Option[List[String]],\n  fs: List[(String, ast.Expr)],\n) -> List[smt.Val] {\n  mut vals := Dict[String, smt.Val] {}\n  for (n, e) in fs {\n    mut vals.insert(n, smt.eval(mut vc, e))\n  }\n  (names ?? []).map(n -> get(vals, n) ?? smt.Opaque(f\"field `{n}`\"))\n}","old_text":"/// The values of a constructor's named fields, in the order declared.\nfn ordered(\n  mut vc: smt.Vc,\n  names: Option[List[String]],\n  fs: List[(String, ast.Expr)],\n) -> List[smt.Val] {\n  mut vals := Dict[String, smt.Val] {}\n  for (n, e) in fs {\n    mut vals.insert(n, smt.eval(mut vc, e))\n  }\n  (names ?? []).map(n -> get(vals, n) ?? smt.Opaque(f\"field `{n}`\"))\n}"},{"name":"smt.ctor","kind":"fn","old":"8c3af831869c658b","new":"51667d2939fbe10d","interface_changed":false,"affected":[],"module":"smt","text":"fn ctor(mut vc: smt.Vc, c: String, args: ast.CtorArgs) -> smt.Val {\n  tn := get(vc.ctors, c) ?? \"\"\n  td := match get(vc.types, tn) {\n    Some(td) => td,\n    None => {\n      smt.gap(mut vc, f\"the constructor `{c}`\")\n      return smt.Opaque(f\"unknown constructor `{c}`\")\n    },\n  }\n  variants := smt.variants_of(vc, tn, []) ?? []\n  v := match (td.body, args) {\n    (ast.Alias(_), ast.PositionalArgs([x])) => if td.distinct {\n      smt.VDistinct { name: tn, inner: smt.eval(mut vc, x) }\n    } else {\n      smt.Opaque(f\"constructor `{c}`\")\n    },\n    (_, ast.UpdateArgs { base, fields }) => {\n      b := smt.eval(mut vc, base)\n      match b {\n        smt.VRec { name, fields: vals } => {\n          mut out := vals\n          for (f, fe) in fields {\n            nv := smt.eval(mut vc, fe)\n            out = out.map(\n              x -> if x.0 == f {\n                (f, nv)\n              } else {\n                x\n              },\n            )\n          }\n          smt.VRec { name, fields: out }\n        },\n        other => {\n          for (_, fe) in fields {\n            _ := smt.eval(mut vc, fe)\n          }\n          other\n        },\n      }\n    },\n    (ast.RecordBody(_), ast.RecordArgs(fs)) => {\n      names := (get(variants, 0) ?? smt.Ctor { name: tn, fields: None, types: [] }).fields\n      vals := smt.ordered(mut vc, names, fs)\n      smt.VRec { name: tn, fields: zip(names ?? [], vals) }\n    },\n    (ast.SumBody(_), _) => {\n      mut k := -1\n      for (i, x) in enumerate(variants) {\n        if x.name == c && k < 0 {\n          k = i\n        }\n      }\n      if k < 0 {\n        return smt.Opaque(f\"unknown constructor `{c}`\")\n      }\n      payload := match args {\n        ast.NoArgs => [],\n        ast.PositionalArgs(xs) => {\n          mut out := []\n          for x in xs {\n            mut out.push(smt.eval(mut vc, x))\n          }\n          out\n        },\n        ast.RecordArgs(fs) => smt.ordered(\n          mut vc,\n          (get(variants, k) ?? smt.Ctor { name: c, fields: None, types: [] }).fields,\n          fs,\n        ),\n        ast.UpdateArgs { .. } => [],\n      }\n      mut ctors := []\n      for (i, x) in enumerate(variants) {\n        mut ctors.push(\n          (x.name, if i == k {\n            payload\n          } else {\n            x.types.map(_ -> smt.Inactive)\n          }),\n        )\n      }\n      smt.VSum { ty: tn, args: [], tag: f\"{k}\", ctors }\n    },\n    _ => smt.Opaque(f\"constructor `{c}`\"),\n  }\n  t := smt.named(tn)\n  if smt.refined(vc, t) {\n    if smt.start_goal(mut vc) {\n      g := smt.check_type(mut vc, t, v, [])\n      smt.oblige(mut vc, f\"constructing `{c}`\", g)\n    } else if vc.through > 0 && !vc.dead {\n      // in a body seen through: the value where its refinement holds, else\n      // any value of the type. What a failing call would give there is not\n      // relied on.\n      ok := smt.check_type(mut vc, t, v, [])\n      if ok != \"true\" {\n        return smt.merge(mut vc, ok, v, smt.havoc(mut vc, t))\n      }\n    }\n  }\n  v\n}","old_text":"fn ctor(mut vc: smt.Vc, c: String, args: ast.CtorArgs) -> smt.Val {\n  tn := get(vc.ctors, c) ?? \"\"\n  td := match get(vc.types, tn) {\n    Some(td) => td,\n    None => {\n      smt.gap(mut vc, f\"the constructor `{c}`\")\n      return smt.Opaque(f\"unknown constructor `{c}`\")\n    },\n  }\n  variants := smt.variants_of(vc, tn, []) ?? []\n  v := match (td.body, args) {\n    (ast.Alias(_), ast.PositionalArgs([x])) => if td.distinct {\n      smt.VDistinct { name: tn, inner: smt.eval(mut vc, x) }\n    } else {\n      smt.Opaque(f\"constructor `{c}`\")\n    },\n    (_, ast.UpdateArgs { base, fields }) => {\n      b := smt.eval(mut vc, base)\n      match b {\n        smt.VRec { name, fields: vals } => {\n          mut out := vals\n          for (f, fe) in fields {\n            nv := smt.eval(mut vc, fe)\n            out = out.map(\n              x -> if x.0 == f {\n                (f, nv)\n              } else {\n                x\n              },\n            )\n          }\n          smt.VRec { name, fields: out }\n        },\n        other => {\n          for (_, fe) in fields {\n            _ := smt.eval(mut vc, fe)\n          }\n          other\n        },\n      }\n    },\n    (ast.RecordBody(_), ast.RecordArgs(fs)) => {\n      names := (get(variants, 0) ?? smt.Ctor { name: tn, fields: None, types: [] }).fields\n      vals := smt.ordered(mut vc, names, fs)\n      smt.VRec { name: tn, fields: zip(names ?? [], vals) }\n    },\n    (ast.SumBody(_), _) => {\n      mut k := -1\n      for (i, x) in enumerate(variants) {\n        if x.name == c && k < 0 {\n          k = i\n        }\n      }\n      if k < 0 {\n        return smt.Opaque(f\"unknown constructor `{c}`\")\n      }\n      payload := match args {\n        ast.NoArgs => [],\n        ast.PositionalArgs(xs) => {\n          mut out := []\n          for x in xs {\n            mut out.push(smt.eval(mut vc, x))\n          }\n          out\n        },\n        ast.RecordArgs(fs) => smt.ordered(\n          mut vc,\n          (get(variants, k) ?? smt.Ctor { name: c, fields: None, types: [] }).fields,\n          fs,\n        ),\n        ast.UpdateArgs { .. } => [],\n      }\n      mut ctors := []\n      for (i, x) in enumerate(variants) {\n        mut ctors.push(\n          (x.name, if i == k {\n            payload\n          } else {\n            x.types.map(_ -> smt.Inactive)\n          }),\n        )\n      }\n      smt.VSum { ty: tn, args: [], tag: f\"{k}\", ctors }\n    },\n    _ => smt.Opaque(f\"constructor `{c}`\"),\n  }\n  t := smt.named(tn)\n  if smt.refined(vc, t) {\n    if smt.start_goal(mut vc) {\n      g := smt.check_type(mut vc, t, v, [])\n      smt.oblige(mut vc, f\"constructing `{c}`\", g)\n    } else if vc.through > 0 && !vc.dead {\n      // in a body seen through, the value where its refinement holds,\n      // else any value of the type: what a call that would fail there\n      // gives is not relied on\n      ok := smt.check_type(mut vc, t, v, [])\n      if ok != \"true\" {\n        return smt.merge(mut vc, ok, v, smt.havoc(mut vc, t))\n      }\n    }\n  }\n  v\n}"},{"name":"smt.type_pattern","kind":"fn","old":"3e8524001616d6f4","new":"c83a360c40aaaa75","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether a pattern names a type (`Positive =>`) instead of a\n/// constructor.\nfn type_pattern(vc: smt.Vc, p: ast.Pattern) -> Bool {\n  match p {\n    ast.CtorPattern { name, args: ast.NoPats } => !contains(vc.ctors, name) && smt.is_type_name(vc, name),\n    ast.CtorPattern { name, args: ast.TypePats(_) } => smt.is_type_name(vc, name),\n    _ => false,\n  }\n}","old_text":"/// Whether a pattern names a type (`Positive =>`), not a constructor.\nfn type_pattern(vc: smt.Vc, p: ast.Pattern) -> Bool {\n  match p {\n    ast.CtorPattern { name, args: ast.NoPats } => !contains(vc.ctors, name) && smt.is_type_name(vc, name),\n    ast.CtorPattern { name, args: ast.TypePats(_) } => smt.is_type_name(vc, name),\n    _ => false,\n  }\n}"},{"name":"smt.pattern","kind":"fn","old":"c4a254b4cd88b130","new":"d433c439d4d52a39","interface_changed":false,"affected":[],"module":"smt","text":"// ---- calls ----\n\n/// The condition for `v` to match `p`. The bindings it makes are added to\n/// `binds`.\nfn pattern(\n  mut vc: smt.Vc,\n  p: ast.Pattern,\n  v: smt.Val,\n  mut binds: List[(String, smt.Val)],\n) -> String {\n  match (v, p) {\n    (smt.VData { .. }, ast.Bind(_)) | (smt.VData { .. }, ast.Wild) => (),\n    (smt.VData { .. }, _) => {\n      fv := smt.force(mut vc, v)\n      return smt.pattern(mut vc, p, fv, mut binds)\n    },\n    _ => (),\n  }\n  named_type := smt.pattern_type(vc, p)\n  match v {\n    smt.VUnion { tag, slots } => if named_type == None {\n      match smt.pattern_key(vc, p) {\n        // a literal, tuple, list or constructor pattern takes the member of\n        // its shape\n        Some(k) => {\n          i := smt.live_slot(slots, k)\n          if i < 0 {\n            // no member has that shape: it never matches, but its names are\n            // bound all the same\n            _ := smt.pattern(\n              mut vc,\n              p,\n              smt.Opaque(\"a pattern no member of the union matches\"),\n              mut binds,\n            )\n            return \"false\"\n          }\n          c := smt.pattern(\n            mut vc,\n            p,\n            (get(slots, i) ?? (\"\", smt.Inactive)).1,\n            mut binds,\n          )\n          return smt.and_all([f\"(= {tag} {i})\", c])\n        },\n        None => (),\n      }\n    },\n    _ => (),\n  }\n  match named_type {\n    // a pattern naming a type (`Positive =>`): the value is one of it\n    Some(t) => return smt.in_type(mut vc, t, v, []),\n    None => (),\n  }\n  match p {\n    ast.ForPat { .. } => \"false\",\n    ast.CondPat(c) => {\n      // `where …`: evaluated with `it` and what is in scope\n      mut vc.scopes.push(dict([(\"it\", v)]))\n      vc.spec += 1\n      b := smt.eval(mut vc, c)\n      vc.spec -= 1\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      smt.as_bool(mut vc, b)\n    },\n    ast.OrPat(alts) => {\n      // the first alternative that matches gives the bindings\n      mut conds := []\n      mut per := []\n      for a in alts {\n        mut b := []\n        mut conds.push(smt.pattern(mut vc, a, v, mut b))\n        mut per.push(b)\n      }\n      for (name, _) in get(per, 0) ?? [] {\n        mut val := smt.Inactive\n        mut first := true\n        mut k := len(conds) - 1\n        while k >= 0 {\n          here := match (get(per, k) ?? []).filter(x -> x.0 == name) {\n            [x, ..] => x.1,\n            _ => smt.Opaque(\"a binding of an or-pattern\"),\n          }\n          val = if first {\n            here\n          } else {\n            smt.merge(mut vc, get(conds, k) ?? \"true\", here, val)\n          }\n          first = false\n          k -= 1\n        }\n        mut binds.push((name, val))\n      }\n      smt.or_all(conds)\n    },\n    ast.Wild => \"true\",\n    ast.Bind(x) => {\n      mut binds.push((x, v))\n      \"true\"\n    },\n    ast.IntPat(n) => f\"(= {smt.as_int(mut vc, v)} {smt.num(n)})\",\n    ast.BoolPat(b) => {\n      t := smt.as_bool(mut vc, v)\n      if b {\n        t\n      } else {\n        smt.neg(t)\n      }\n    },\n    ast.StrPat(s) => if smt.smt_string(s) {\n      f\"(= {smt.as_str(mut vc, v)} {smt.str_lit(s)})\"\n    } else {\n      smt.unknown_bool(mut vc, smt.beyond())\n    },\n    ast.TuplePat(ps) => {\n      mut cs := []\n      match v {\n        smt.VTuple(xs) => if len(xs) == len(ps) {\n          for (i, q) in enumerate(ps) {\n            mut cs.push(\n              smt.pattern(\n                mut vc,\n                q,\n                get(xs, i) ?? smt.Inactive,\n                mut binds,\n              ),\n            )\n          }\n          return smt.and_all(cs)\n        },\n        _ => (),\n      }\n      for q in ps {\n        mut cs.push(\n          smt.pattern(\n            mut vc,\n            q,\n            smt.Opaque(\"a tuple of an unknown shape\"),\n            mut binds,\n          ),\n        )\n      }\n      smt.and_all(cs)\n    },\n    ast.ListPat { items, rest } => {\n      l := smt.list_len(mut vc, v)\n      id := smt.list_id(mut vc, v)\n      n := len(items)\n      mut cs := [match rest {\n        Some(_) => f\"(>= {l} {n})\",\n        None => f\"(= {l} {n})\",\n      }]\n      for (i, q) in enumerate(items) {\n        // the i-th element exists when the list is long enough\n        exists := f\"(> {l} {i})\"\n        x := smt.element_at(mut vc, id, f\"{i}\", exists) ?? smt.element(mut vc, id, exists)\n        mut cs.push(smt.pattern(mut vc, q, x, mut binds))\n      }\n      match rest {\n        Some(r) => mut binds.push(\n          (r, smt.new_list(\n            mut vc,\n            f\"(- {l} {n})\",\n            smt.GShift(id, f\"{n}\"),\n          )),\n        ),\n        None => (),\n      }\n      smt.and_all(cs)\n    },\n    ast.CtorPattern { name: c, args: cp } => smt.ctor_pattern(mut vc, c, cp, v, mut binds),\n  }\n}","old_text":"// ---- calls ----\n\n/// The condition for `v` to match `p`, the bindings it makes added to\n/// `binds`.\nfn pattern(\n  mut vc: smt.Vc,\n  p: ast.Pattern,\n  v: smt.Val,\n  mut binds: List[(String, smt.Val)],\n) -> String {\n  match (v, p) {\n    (smt.VData { .. }, ast.Bind(_)) | (smt.VData { .. }, ast.Wild) => (),\n    (smt.VData { .. }, _) => {\n      fv := smt.force(mut vc, v)\n      return smt.pattern(mut vc, p, fv, mut binds)\n    },\n    _ => (),\n  }\n  named_type := smt.pattern_type(vc, p)\n  match v {\n    smt.VUnion { tag, slots } => if named_type == None {\n      match smt.pattern_key(vc, p) {\n        // a literal, tuple, list or constructor pattern takes the member of\n        // its shape\n        Some(k) => {\n          i := smt.live_slot(slots, k)\n          if i < 0 {\n            // no member has that shape: it never matches (its names bound\n            // all the same)\n            _ := smt.pattern(\n              mut vc,\n              p,\n              smt.Opaque(\"a pattern no member of the union matches\"),\n              mut binds,\n            )\n            return \"false\"\n          }\n          c := smt.pattern(\n            mut vc,\n            p,\n            (get(slots, i) ?? (\"\", smt.Inactive)).1,\n            mut binds,\n          )\n          return smt.and_all([f\"(= {tag} {i})\", c])\n        },\n        None => (),\n      }\n    },\n    _ => (),\n  }\n  match named_type {\n    // a pattern naming a type (`Positive =>`): the value is one of it\n    Some(t) => return smt.in_type(mut vc, t, v, []),\n    None => (),\n  }\n  match p {\n    ast.ForPat { .. } => \"false\",\n    ast.CondPat(c) => {\n      // `where …`: evaluated with `it` and what is in scope\n      mut vc.scopes.push(dict([(\"it\", v)]))\n      vc.spec += 1\n      b := smt.eval(mut vc, c)\n      vc.spec -= 1\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      smt.as_bool(mut vc, b)\n    },\n    ast.OrPat(alts) => {\n      // the first alternative that matches gives the bindings\n      mut conds := []\n      mut per := []\n      for a in alts {\n        mut b := []\n        mut conds.push(smt.pattern(mut vc, a, v, mut b))\n        mut per.push(b)\n      }\n      for (name, _) in get(per, 0) ?? [] {\n        mut val := smt.Inactive\n        mut first := true\n        mut k := len(conds) - 1\n        while k >= 0 {\n          here := match (get(per, k) ?? []).filter(x -> x.0 == name) {\n            [x, ..] => x.1,\n            _ => smt.Opaque(\"a binding of an or-pattern\"),\n          }\n          val = if first {\n            here\n          } else {\n            smt.merge(mut vc, get(conds, k) ?? \"true\", here, val)\n          }\n          first = false\n          k -= 1\n        }\n        mut binds.push((name, val))\n      }\n      smt.or_all(conds)\n    },\n    ast.Wild => \"true\",\n    ast.Bind(x) => {\n      mut binds.push((x, v))\n      \"true\"\n    },\n    ast.IntPat(n) => f\"(= {smt.as_int(mut vc, v)} {smt.num(n)})\",\n    ast.BoolPat(b) => {\n      t := smt.as_bool(mut vc, v)\n      if b {\n        t\n      } else {\n        smt.neg(t)\n      }\n    },\n    ast.StrPat(s) => if smt.smt_string(s) {\n      f\"(= {smt.as_str(mut vc, v)} {smt.str_lit(s)})\"\n    } else {\n      smt.unknown_bool(mut vc, smt.beyond())\n    },\n    ast.TuplePat(ps) => {\n      mut cs := []\n      match v {\n        smt.VTuple(xs) => if len(xs) == len(ps) {\n          for (i, q) in enumerate(ps) {\n            mut cs.push(\n              smt.pattern(\n                mut vc,\n                q,\n                get(xs, i) ?? smt.Inactive,\n                mut binds,\n              ),\n            )\n          }\n          return smt.and_all(cs)\n        },\n        _ => (),\n      }\n      for q in ps {\n        mut cs.push(\n          smt.pattern(\n            mut vc,\n            q,\n            smt.Opaque(\"a tuple of an unknown shape\"),\n            mut binds,\n          ),\n        )\n      }\n      smt.and_all(cs)\n    },\n    ast.ListPat { items, rest } => {\n      l := smt.list_len(mut vc, v)\n      id := smt.list_id(mut vc, v)\n      n := len(items)\n      mut cs := [match rest {\n        Some(_) => f\"(>= {l} {n})\",\n        None => f\"(= {l} {n})\",\n      }]\n      for (i, q) in enumerate(items) {\n        // the i-th element exists when the list is long enough\n        exists := f\"(> {l} {i})\"\n        x := smt.element_at(mut vc, id, f\"{i}\", exists) ?? smt.element(mut vc, id, exists)\n        mut cs.push(smt.pattern(mut vc, q, x, mut binds))\n      }\n      match rest {\n        Some(r) => mut binds.push(\n          (r, smt.new_list(\n            mut vc,\n            f\"(- {l} {n})\",\n            smt.GShift(id, f\"{n}\"),\n          )),\n        ),\n        None => (),\n      }\n      smt.and_all(cs)\n    },\n    ast.CtorPattern { name: c, args: cp } => smt.ctor_pattern(mut vc, c, cp, v, mut binds),\n  }\n}"},{"name":"smt.eval_expr","kind":"fn","old":"31a36a066f8054de","new":"8061752780c70e91","interface_changed":false,"affected":[],"module":"smt","text":"fn eval_expr(mut vc: smt.Vc, e: ast.Expr, pol: Int) -> smt.Val {\n  if vc.dead {\n    return smt.UnitVal\n  }\n  match e {\n    ast.IntLit(n) => smt.VInt(smt.num(n)),\n    ast.BigIntLit(d) => smt.VInt(d),\n    ast.FloatLit(_) => smt.Opaque(\"floats are not modelled yet\"),\n    ast.StrLit(s) => if smt.smt_string(s) {\n      smt.VStr(smt.str_lit(s))\n    } else {\n      smt.Opaque(smt.beyond())\n    },\n    ast.BoolLit(b) => smt.VBool(if b {\n      \"true\"\n    } else {\n      \"false\"\n    }),\n    ast.UnitExpr => smt.UnitVal,\n    ast.TupleExpr(xs) => {\n      mut out := []\n      for x in xs {\n        mut out.push(smt.eval(mut vc, x))\n      }\n      smt.VTuple(out)\n    },\n    ast.Var(x) => match smt.lookup(vc, x) {\n      Some(v) => v,\n      None => smt.fn_name_value(mut vc, x),\n    },\n    ast.Hole(h) => smt.Opaque(f\"the hole `?{h}`\"),\n    ast.Range { .. } | ast.Index { .. } | ast.Comp { .. } | ast.DictExpr { .. } | ast.SetExpr { .. } => smt.Opaque(\"a range, slice or comprehension not desugared\"),\n    ast.MockExpr(t) => smt.Opaque(f\"`mock {text.type_text(t)}`\"),\n    ast.Spread(_) => smt.Opaque(\"a spread (`...x`) not written out\"),\n    ast.Select(_) => smt.Opaque(\"which arm of a `select` runs depends on timing\"),\n    ast.Race(_) => smt.Opaque(\"which arm of a `race` wins depends on timing\"),\n    // `mut xs.push(x)`: a builtin changing a list, dict or set\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => if builtins.changing(name) {\n      rv := smt.eval(mut vc, recv)\n      if smt.is_list(rv) {\n        smt.changed(mut vc, recv, rv, name, args)\n      } else {\n        smt.eval(mut vc, ast.MethodCall { recv, name, args })\n      }\n    } else {\n      smt.eval(mut vc, ast.MethodCall { recv, name, args })\n    },\n    ast.MutExpr(x) | ast.Comptime(x) | ast.Scope(x) | ast.Spawn(x) | ast.Await(x) | ast.Assumed(x) => smt.eval(mut vc, x),\n    // `old e`: `e` over the values before (at the function's start, or a\n    // callee's arguments before the call)\n    ast.Old(x) => match vc.olds {\n      Some(before) => {\n        saved := vc.scopes\n        vc.scopes = smt.old_scopes(before, saved)\n        vc.olds = None\n        v := smt.eval(mut vc, x)\n        vc.olds = Some(before)\n        vc.scopes = saved\n        v\n      },\n      None => {\n        smt.gap(mut vc, \"`old` outside an `ensures`\")\n        smt.Opaque(\"`old` outside an `ensures`\")\n      },\n    },\n    ast.SupervisedSpawn(_) => smt.Opaque(\"a supervised task's result (it may have panicked)\"),\n    ast.Interp(parts) => {\n      for part in parts {\n        match part {\n          ast.ValuePart { value, .. } => {\n            _ := smt.eval(mut vc, value)\n          },\n          ast.TextPart(_) => (),\n        }\n      }\n      smt.VStr(smt.fresh_why(\n        mut vc,\n        \"String\",\n        \"f-strings (only their parts are checked)\",\n      ))\n    },\n    ast.Return(x) => {\n      v := smt.eval(mut vc, x)\n      smt.early_return(mut vc, v)\n      smt.UnitVal\n    },\n    ast.Try { value, kind } => {\n      v := smt.eval(mut vc, value)\n      ok_name := match kind {\n        ast.TryResult => \"Ok\",\n        ast.TryOption => \"Some\",\n      }\n      match (v, smt.ctor_index(v, ok_name)) {\n        (smt.VSum { tag, ctors, .. }, Some(k)) => {\n          ok := f\"(= {tag} {k})\"\n          payload := get((get(ctors, k) ?? (\"\", [])).1, 0) ?? smt.Opaque(\"the payload of `Ok` / `Some`\")\n          // the error (or `None`) leaves the function as it is\n          n := len(vc.pc)\n          mut vc.pc.push(smt.neg(ok))\n          smt.early_return(mut vc, v)\n          vc.dead = false\n          vc.pc = take(vc.pc, n) + [ok]\n          payload\n        },\n        _ => {\n          n := len(vc.pc)\n          smt.early_return(\n            mut vc,\n            smt.Opaque(\"an early return through `!` / `?`\"),\n          )\n          vc.dead = false\n          vc.pc = take(vc.pc, n)\n          smt.Opaque(\"the value under `!` / `?`\")\n        },\n      }\n    },\n    ast.Except { value, err, fallback } => smt.fallback_value(mut vc, value, err, fallback),\n    ast.Fallback { value, fallback } => smt.fallback_value(mut vc, value, None, fallback),\n    ast.FieldOf { base, name } => {\n      v := smt.eval(mut vc, base)\n      smt.field(mut vc, v, name)\n    },\n    ast.Unary { op, operand } => {\n      v := match op {\n        ast.Not => smt.eval_pol(mut vc, operand, 0 - pol),\n        ast.Neg => smt.eval(mut vc, operand),\n      }\n      match op {\n        ast.Neg => match (v, smt.word_of(v)) {\n          (smt.VInt(t), _) => smt.VInt(f\"(- {t})\"),\n          (_, Some(w)) => {\n            t := smt.as_int(mut vc, v)\n            smt.word(w, smt.wrap_term(w, f\"(- {t})\"))\n          },\n          (other, _) => other,\n        },\n        ast.Not => smt.VBool(smt.neg(smt.as_bool(mut vc, v))),\n      }\n    },\n    ast.Binary { op, left, right } => smt.binary(mut vc, op, left, right, pol),\n    ast.IsExpr { value, variant } => {\n      v := smt.eval(mut vc, value)\n      if !contains(vc.ctors, variant) && smt.is_type_name(vc, variant) {\n        smt.VBool(smt.in_type(mut vc, smt.named(variant), v, []))\n      } else {\n        smt.VBool(smt.is_ctor(mut vc, v, variant))\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => {\n      cv := smt.eval(mut vc, cond)\n      c := smt.as_bool(mut vc, cv)\n      vc.polarity = pol\n      r := smt.branches(\n        mut vc,\n        [(c, [], then), (smt.neg(c), [], otherwise)],\n      )\n      vc.polarity = 0\n      r\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      v := smt.eval(mut vc, scrutinee)\n      mut prev := []\n      mut alts := []\n      mut narrow := []\n      for a in arms {\n        // a union narrowed to the one member the arm's pattern can match\n        member := match v {\n          smt.VUnion { slots, .. } => match smt.arm_slots(mut vc, a.pat, slots) {\n            [i] => Some((get(slots, i) ?? (\"\", smt.Inactive)).1),\n            _ => None,\n          },\n          _ => None,\n        }\n        mut narrow.push(\n          match (scrutinee, member) {\n            (ast.Var(x), Some(m)) => match smt.lookup(vc, x) {\n              Some(_) => [(x, m)],\n              None => [],\n            },\n            _ => [],\n          },\n        )\n        mut binds := match binding {\n          Some(n) => [(n, member ?? v)],\n          None => [],\n        }\n        n := len(vc.pc)\n        vc.pc += prev.map(p -> smt.neg(p))\n        cond := smt.pattern(mut vc, a.pat, v, mut binds)\n        vc.pc = take(vc.pc, n)\n        mut alts.push(\n          (\n            smt.and_all(prev.map(p -> smt.neg(p)) + [cond]),\n            binds,\n            a.body,\n          ),\n        )\n        mut prev.push(cond)\n      }\n      // arms with conditions the checker can't decide: some arm must match\n      // (else compiled code faults with `no match arm`)\n      if arms.any(a -> smt.undecided(vc, a.pat)) {\n        if smt.start_goal(mut vc) {\n          smt.oblige(\n            mut vc,\n            \"some arm of the `match` matches\",\n            smt.or_all(prev),\n          )\n        }\n      }\n      vc.polarity = pol\n      r := smt.branches_narrowed(mut vc, alts, narrow)\n      vc.polarity = 0\n      r\n    },\n    ast.Block { stmts, last } => {\n      mut vc.scopes.push(Dict[String, smt.Val] {})\n      for s in stmts {\n        smt.stmt(mut vc, s)\n        if vc.dead {\n          break\n        }\n      }\n      v := smt.eval_pol(mut vc, last, pol)\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      v\n    },\n    ast.CtorExpr { name, args } => smt.ctor(mut vc, name, args),\n    ast.Call { callee, args } => match callee {\n      ast.Var(name) => match smt.lookup(vc, name) {\n        None => {\n          vc.call_pol = pol\n          smt.call_exprs(mut vc, name, args)\n        },\n        Some(f) => smt.call_value(mut vc, f, args),\n      },\n      _ => {\n        smt.gap(mut vc, \"calling a function value\")\n        smt.Opaque(\"calling a function value\")\n      },\n    },\n    ast.MethodCall { recv, name, args } => {\n      // a method called on a type (`T.empty()`): a static method, the type\n      // only picking the implementation\n      on_type := match recv {\n        // a record's name is both its type's and its constructor's\n        ast.CtorExpr { name: t, args: ast.NoArgs } => !contains(vc.ctors, t) || contains(vc.types, t),\n        _ => false,\n      }\n      if on_type {\n        t := match recv {\n          ast.CtorExpr { name: n, .. } => n,\n          _ => \"\",\n        }\n        smt.static_call(mut vc, t, name, args)\n      } else if contains(vc.fns, name) && smt.own_method_of(vc, recv, name) {\n        // `k.bump()` where `k`'s type has its own method `bump`: that\n        // method, not the function of that name\n        rv := smt.eval(mut vc, recv)\n        mut vals := [rv]\n        for a in args {\n          mut vals.push(smt.eval(mut vc, a))\n        }\n        smt.method_call(mut vc, name, [recv] + args, vals) or {\n          smt.Opaque(\n            f\"the result of method `{name}` (it depends on the receiver's type)\",\n          )\n        }\n      } else {\n        vc.call_pol = pol\n        smt.call_exprs(mut vc, name, [recv] + args)\n      }\n    },\n    ast.ListExpr(xs) => {\n      mut vals := []\n      for x in xs {\n        mut vals.push(smt.eval(mut vc, x))\n      }\n      smt.new_list(mut vc, f\"{len(xs)}\", smt.GValues(vals))\n    },\n    ast.Lambda { .. } => smt.fn_value(mut vc, e, []).0,\n  }\n}","old_text":"fn eval_expr(mut vc: smt.Vc, e: ast.Expr, pol: Int) -> smt.Val {\n  if vc.dead {\n    return smt.UnitVal\n  }\n  match e {\n    ast.IntLit(n) => smt.VInt(smt.num(n)),\n    ast.BigIntLit(d) => smt.VInt(d),\n    ast.FloatLit(_) => smt.Opaque(\"floats are not modelled yet\"),\n    ast.StrLit(s) => if smt.smt_string(s) {\n      smt.VStr(smt.str_lit(s))\n    } else {\n      smt.Opaque(smt.beyond())\n    },\n    ast.BoolLit(b) => smt.VBool(if b {\n      \"true\"\n    } else {\n      \"false\"\n    }),\n    ast.UnitExpr => smt.UnitVal,\n    ast.TupleExpr(xs) => {\n      mut out := []\n      for x in xs {\n        mut out.push(smt.eval(mut vc, x))\n      }\n      smt.VTuple(out)\n    },\n    ast.Var(x) => match smt.lookup(vc, x) {\n      Some(v) => v,\n      None => smt.fn_name_value(mut vc, x),\n    },\n    ast.Hole(h) => smt.Opaque(f\"the hole `?{h}`\"),\n    ast.Range { .. } | ast.Index { .. } | ast.Comp { .. } | ast.DictExpr { .. } | ast.SetExpr { .. } => smt.Opaque(\"a range, slice or comprehension not desugared\"),\n    ast.MockExpr(t) => smt.Opaque(f\"`mock {text.type_text(t)}`\"),\n    ast.Spread(_) => smt.Opaque(\"a spread (`...x`) not written out\"),\n    ast.Select(_) => smt.Opaque(\"which arm of a `select` runs depends on timing\"),\n    ast.Race(_) => smt.Opaque(\"which arm of a `race` wins depends on timing\"),\n    // `mut xs.push(x)`: a built-in changing a list, dict or set\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => if builtins.changing(name) {\n      rv := smt.eval(mut vc, recv)\n      if smt.is_list(rv) {\n        smt.changed(mut vc, recv, rv, name, args)\n      } else {\n        smt.eval(mut vc, ast.MethodCall { recv, name, args })\n      }\n    } else {\n      smt.eval(mut vc, ast.MethodCall { recv, name, args })\n    },\n    ast.MutExpr(x) | ast.Comptime(x) | ast.Scope(x) | ast.Spawn(x) | ast.Await(x) | ast.Assumed(x) => smt.eval(mut vc, x),\n    // `old e`: `e` over the values before (where the function started,\n    // or a callee's arguments before the call)\n    ast.Old(x) => match vc.olds {\n      Some(before) => {\n        saved := vc.scopes\n        vc.scopes = smt.old_scopes(before, saved)\n        vc.olds = None\n        v := smt.eval(mut vc, x)\n        vc.olds = Some(before)\n        vc.scopes = saved\n        v\n      },\n      None => {\n        smt.gap(mut vc, \"`old` outside an `ensures`\")\n        smt.Opaque(\"`old` outside an `ensures`\")\n      },\n    },\n    ast.SupervisedSpawn(_) => smt.Opaque(\"a supervised task's result (it may have panicked)\"),\n    ast.Interp(parts) => {\n      for part in parts {\n        match part {\n          ast.ValuePart { value, .. } => {\n            _ := smt.eval(mut vc, value)\n          },\n          ast.TextPart(_) => (),\n        }\n      }\n      smt.VStr(smt.fresh_why(\n        mut vc,\n        \"String\",\n        \"f-strings (only their parts are checked)\",\n      ))\n    },\n    ast.Return(x) => {\n      v := smt.eval(mut vc, x)\n      smt.early_return(mut vc, v)\n      smt.UnitVal\n    },\n    ast.Try { value, kind } => {\n      v := smt.eval(mut vc, value)\n      ok_name := match kind {\n        ast.TryResult => \"Ok\",\n        ast.TryOption => \"Some\",\n      }\n      match (v, smt.ctor_index(v, ok_name)) {\n        (smt.VSum { tag, ctors, .. }, Some(k)) => {\n          ok := f\"(= {tag} {k})\"\n          payload := get((get(ctors, k) ?? (\"\", [])).1, 0) ?? smt.Opaque(\"the payload of `Ok` / `Some`\")\n          // the error (or `None`) leaves the function as it is\n          n := len(vc.pc)\n          mut vc.pc.push(smt.neg(ok))\n          smt.early_return(mut vc, v)\n          vc.dead = false\n          vc.pc = take(vc.pc, n) + [ok]\n          payload\n        },\n        _ => {\n          n := len(vc.pc)\n          smt.early_return(\n            mut vc,\n            smt.Opaque(\"an early return through `!` / `?`\"),\n          )\n          vc.dead = false\n          vc.pc = take(vc.pc, n)\n          smt.Opaque(\"the value under `!` / `?`\")\n        },\n      }\n    },\n    ast.Except { value, err, fallback } => smt.fallback_value(mut vc, value, err, fallback),\n    ast.Fallback { value, fallback } => smt.fallback_value(mut vc, value, None, fallback),\n    ast.FieldOf { base, name } => {\n      v := smt.eval(mut vc, base)\n      smt.field(mut vc, v, name)\n    },\n    ast.Unary { op, operand } => {\n      v := match op {\n        ast.Not => smt.eval_pol(mut vc, operand, 0 - pol),\n        ast.Neg => smt.eval(mut vc, operand),\n      }\n      match op {\n        ast.Neg => match (v, smt.word_of(v)) {\n          (smt.VInt(t), _) => smt.VInt(f\"(- {t})\"),\n          (_, Some(w)) => {\n            t := smt.as_int(mut vc, v)\n            smt.word(w, smt.wrap_term(w, f\"(- {t})\"))\n          },\n          (other, _) => other,\n        },\n        ast.Not => smt.VBool(smt.neg(smt.as_bool(mut vc, v))),\n      }\n    },\n    ast.Binary { op, left, right } => smt.binary(mut vc, op, left, right, pol),\n    ast.IsExpr { value, variant } => {\n      v := smt.eval(mut vc, value)\n      if !contains(vc.ctors, variant) && smt.is_type_name(vc, variant) {\n        smt.VBool(smt.in_type(mut vc, smt.named(variant), v, []))\n      } else {\n        smt.VBool(smt.is_ctor(mut vc, v, variant))\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => {\n      cv := smt.eval(mut vc, cond)\n      c := smt.as_bool(mut vc, cv)\n      vc.polarity = pol\n      r := smt.branches(\n        mut vc,\n        [(c, [], then), (smt.neg(c), [], otherwise)],\n      )\n      vc.polarity = 0\n      r\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      v := smt.eval(mut vc, scrutinee)\n      mut prev := []\n      mut alts := []\n      mut narrow := []\n      for a in arms {\n        // a union narrowed to the one member the arm's pattern can match\n        member := match v {\n          smt.VUnion { slots, .. } => match smt.arm_slots(mut vc, a.pat, slots) {\n            [i] => Some((get(slots, i) ?? (\"\", smt.Inactive)).1),\n            _ => None,\n          },\n          _ => None,\n        }\n        mut narrow.push(\n          match (scrutinee, member) {\n            (ast.Var(x), Some(m)) => match smt.lookup(vc, x) {\n              Some(_) => [(x, m)],\n              None => [],\n            },\n            _ => [],\n          },\n        )\n        mut binds := match binding {\n          Some(n) => [(n, member ?? v)],\n          None => [],\n        }\n        n := len(vc.pc)\n        vc.pc += prev.map(p -> smt.neg(p))\n        cond := smt.pattern(mut vc, a.pat, v, mut binds)\n        vc.pc = take(vc.pc, n)\n        mut alts.push(\n          (\n            smt.and_all(prev.map(p -> smt.neg(p)) + [cond]),\n            binds,\n            a.body,\n          ),\n        )\n        mut prev.push(cond)\n      }\n      // arms with conditions the checker can't decide: some arm matches\n      // (else the compiled code's `no match arm` fault)\n      if arms.any(a -> smt.undecided(vc, a.pat)) {\n        if smt.start_goal(mut vc) {\n          smt.oblige(\n            mut vc,\n            \"some arm of the `match` matches\",\n            smt.or_all(prev),\n          )\n        }\n      }\n      vc.polarity = pol\n      r := smt.branches_narrowed(mut vc, alts, narrow)\n      vc.polarity = 0\n      r\n    },\n    ast.Block { stmts, last } => {\n      mut vc.scopes.push(Dict[String, smt.Val] {})\n      for s in stmts {\n        smt.stmt(mut vc, s)\n        if vc.dead {\n          break\n        }\n      }\n      v := smt.eval_pol(mut vc, last, pol)\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      v\n    },\n    ast.CtorExpr { name, args } => smt.ctor(mut vc, name, args),\n    ast.Call { callee, args } => match callee {\n      ast.Var(name) => match smt.lookup(vc, name) {\n        None => {\n          vc.call_pol = pol\n          smt.call_exprs(mut vc, name, args)\n        },\n        Some(f) => smt.call_value(mut vc, f, args),\n      },\n      _ => {\n        smt.gap(mut vc, \"calling a function value\")\n        smt.Opaque(\"calling a function value\")\n      },\n    },\n    ast.MethodCall { recv, name, args } => {\n      // a method called on a type (`T.empty()`): a static method, the type\n      // only picking the implementation\n      on_type := match recv {\n        // (a record's name is its type's and its constructor's)\n        ast.CtorExpr { name: t, args: ast.NoArgs } => !contains(vc.ctors, t) || contains(vc.types, t),\n        _ => false,\n      }\n      if on_type {\n        t := match recv {\n          ast.CtorExpr { name: n, .. } => n,\n          _ => \"\",\n        }\n        smt.static_call(mut vc, t, name, args)\n      } else if contains(vc.fns, name) && smt.own_method_of(vc, recv, name) {\n        // `k.bump()` where `k`'s type has a method `bump` of its own: the\n        // method, not the function of that name\n        rv := smt.eval(mut vc, recv)\n        mut vals := [rv]\n        for a in args {\n          mut vals.push(smt.eval(mut vc, a))\n        }\n        smt.method_call(mut vc, name, [recv] + args, vals) or {\n          smt.Opaque(\n            f\"the result of method `{name}` (it depends on the receiver's type)\",\n          )\n        }\n      } else {\n        vc.call_pol = pol\n        smt.call_exprs(mut vc, name, [recv] + args)\n      }\n    },\n    ast.ListExpr(xs) => {\n      mut vals := []\n      for x in xs {\n        mut vals.push(smt.eval(mut vc, x))\n      }\n      smt.new_list(mut vc, f\"{len(xs)}\", smt.GValues(vals))\n    },\n    ast.Lambda { .. } => smt.fn_value(mut vc, e, []).0,\n  }\n}"},{"name":"smt.fallback_value","kind":"fn","old":"5ee7948f5ca55e58","new":"b249e9ff744d3c3e","interface_changed":false,"affected":[],"module":"smt","text":"/// `x except e => fallback` and `x ?? fallback`: the payload of `Ok` or\n/// `Some`, else the fallback (with the error bound to `e`).\nfn fallback_value(\n  mut vc: smt.Vc,\n  x: ast.Expr,\n  err: Option[String],\n  fb: ast.Expr,\n) -> smt.Val {\n  v := smt.eval(mut vc, x)\n  k_ok := match smt.ctor_index(v, \"Ok\") {\n    Some(k) => Some(k),\n    None => smt.ctor_index(v, \"Some\"),\n  }\n  match (v, k_ok) {\n    (smt.VSum { tag, ctors, .. }, Some(k)) => {\n      ok := f\"(= {tag} {k})\"\n      payload := get((get(ctors, k) ?? (\"\", [])).1, 0) ?? smt.Opaque(\"the payload of `Ok` / `Some`\")\n      mut err_binds := []\n      match (err, smt.ctor_index(v, \"Err\")) {\n        (Some(n), Some(ek)) => {\n          err_binds = [(\n            n,\n            get((get(ctors, ek) ?? (\"\", [])).1, 0) ?? smt.Opaque(\"the error\"),\n          )]\n        },\n        _ => (),\n      }\n      smt.branches(mut vc, [\n        (ok, [(\" ok\", payload)], ast.Var(\" ok\")),\n        (smt.neg(ok), err_binds, fb),\n      ])\n    },\n    _ => {\n      mut vc.scopes.push(\n        dict(match err {\n          Some(n) => [(n, smt.Opaque(\"the error\"))],\n          None => [],\n        }),\n      )\n      _ := smt.eval(mut vc, fb)\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      smt.Opaque(\"the value under `except`\")\n    },\n  }\n}","old_text":"/// `x except e => fallback` and `x ?? fallback`: the payload of `Ok` /\n/// `Some`, else the fallback (with the error bound to `e`).\nfn fallback_value(\n  mut vc: smt.Vc,\n  x: ast.Expr,\n  err: Option[String],\n  fb: ast.Expr,\n) -> smt.Val {\n  v := smt.eval(mut vc, x)\n  k_ok := match smt.ctor_index(v, \"Ok\") {\n    Some(k) => Some(k),\n    None => smt.ctor_index(v, \"Some\"),\n  }\n  match (v, k_ok) {\n    (smt.VSum { tag, ctors, .. }, Some(k)) => {\n      ok := f\"(= {tag} {k})\"\n      payload := get((get(ctors, k) ?? (\"\", [])).1, 0) ?? smt.Opaque(\"the payload of `Ok` / `Some`\")\n      mut err_binds := []\n      match (err, smt.ctor_index(v, \"Err\")) {\n        (Some(n), Some(ek)) => {\n          err_binds = [(\n            n,\n            get((get(ctors, ek) ?? (\"\", [])).1, 0) ?? smt.Opaque(\"the error\"),\n          )]\n        },\n        _ => (),\n      }\n      smt.branches(mut vc, [\n        (ok, [(\" ok\", payload)], ast.Var(\" ok\")),\n        (smt.neg(ok), err_binds, fb),\n      ])\n    },\n    _ => {\n      mut vc.scopes.push(\n        dict(match err {\n          Some(n) => [(n, smt.Opaque(\"the error\"))],\n          None => [],\n        }),\n      )\n      _ := smt.eval(mut vc, fb)\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      smt.Opaque(\"the value under `except`\")\n    },\n  }\n}"},{"name":"smt.leaves_of","kind":"fn","old":"21c393bf66a7b77b","new":"08473760e7008910","interface_changed":false,"affected":[],"module":"smt","text":"/// The terms a model must give a value for, to rebuild `v`.\nfn leaves_of(vc: smt.Vc, v: smt.Val) -> List[String] {\n  match v {\n    smt.VInt(t) | smt.VBool(t) | smt.VStr(t) => [t],\n    smt.VTuple(xs) => xs.fold([], (acc, x) -> acc + smt.leaves_of(vc, x)),\n    smt.VRec { fields, .. } => fields.fold([], (acc, f) -> acc + smt.leaves_of(vc, f.1)),\n    smt.VSum { tag, ctors, .. } => ctors.fold(\n      [tag],\n      (acc, c) ->\n        c.1.fold(acc, (a2, x) -> a2 + smt.leaves_of(vc, x)),\n    ),\n    smt.VDistinct { inner, .. } => smt.leaves_of(vc, inner),\n    smt.VUnion { tag, slots } => slots.fold([tag], (acc, s) -> acc + smt.leaves_of(vc, s.1)),\n    smt.VData { t, .. } => [t],\n    smt.VList { len, id } => match smt.list_info(vc, id).source {\n      // its first items, to show a short list\n      smt.GSeq(s, _, n) => [len]\n        + range(0, smt.input_len()).map(k -> smt.seq_at(n, s, f\"{k}\")),\n      _ => [len],\n    },\n    _ => [],\n  }\n}","old_text":"/// The terms a model must give a value for, to rebuild `v`.\nfn leaves_of(vc: smt.Vc, v: smt.Val) -> List[String] {\n  match v {\n    smt.VInt(t) | smt.VBool(t) | smt.VStr(t) => [t],\n    smt.VTuple(xs) => xs.fold([], (acc, x) -> acc + smt.leaves_of(vc, x)),\n    smt.VRec { fields, .. } => fields.fold([], (acc, f) -> acc + smt.leaves_of(vc, f.1)),\n    smt.VSum { tag, ctors, .. } => ctors.fold(\n      [tag],\n      (acc, c) ->\n        c.1.fold(acc, (a2, x) -> a2 + smt.leaves_of(vc, x)),\n    ),\n    smt.VDistinct { inner, .. } => smt.leaves_of(vc, inner),\n    smt.VUnion { tag, slots } => slots.fold([tag], (acc, s) -> acc + smt.leaves_of(vc, s.1)),\n    smt.VData { t, .. } => [t],\n    smt.VList { len, id } => match smt.list_info(vc, id).source {\n      // (its first items, to show a short list)\n      smt.GSeq(s, _, n) => [len]\n        + range(0, smt.input_len()).map(k -> smt.seq_at(n, s, f\"{k}\")),\n      _ => [len],\n    },\n    _ => [],\n  }\n}"},{"name":"smt.push_last","kind":"fn","old":"87a4ea83fd103542","new":"6d264ec003219d2f","interface_changed":false,"affected":[],"module":"smt","text":"/// `stack` with `x` added to its last list.\nfn push_last(stack: List[List[smt.Sx]], x: smt.Sx) -> List[List[smt.Sx]] {\n  n := len(stack)\n  take(stack, n - 1) + [(get(stack, n - 1) ?? []) + [x]]\n}","old_text":"/// `x` added to the last list of `stack`.\nfn push_last(stack: List[List[smt.Sx]], x: smt.Sx) -> List[List[smt.Sx]] {\n  n := len(stack)\n  take(stack, n - 1) + [(get(stack, n - 1) ?? []) + [x]]\n}"},{"name":"smt.expand","kind":"fn","old":"fce95b88002601d6","new":"eddc6e879fb9e5d5","interface_changed":false,"affected":[],"module":"smt","text":"/// `x` with `let`s replaced by what they name.\nfn expand(x: smt.Sx, env: List[(String, smt.Sx)]) -> smt.Sx {\n  match x {\n    smt.SAtom(a) => {\n      mut k := len(env) - 1\n      while k >= 0 {\n        e := get(env, k) ?? (\"\", x)\n        if e.0 == a {\n          return e.1\n        }\n        k -= 1\n      }\n      x\n    },\n    smt.SList([smt.SAtom(\"let\"), smt.SList(bs), body]) => {\n      mut more := env\n      for b in bs {\n        match b {\n          smt.SList([smt.SAtom(name), v]) => mut more.push((name, smt.expand(v, env))),\n          _ => (),\n        }\n      }\n      smt.expand(body, more)\n    },\n    smt.SList(xs) => smt.SList(xs.map(y -> smt.expand(y, env))),\n  }\n}","old_text":"/// `let`s replaced by what they name.\nfn expand(x: smt.Sx, env: List[(String, smt.Sx)]) -> smt.Sx {\n  match x {\n    smt.SAtom(a) => {\n      mut k := len(env) - 1\n      while k >= 0 {\n        e := get(env, k) ?? (\"\", x)\n        if e.0 == a {\n          return e.1\n        }\n        k -= 1\n      }\n      x\n    },\n    smt.SList([smt.SAtom(\"let\"), smt.SList(bs), body]) => {\n      mut more := env\n      for b in bs {\n        match b {\n          smt.SList([smt.SAtom(name), v]) => mut more.push((name, smt.expand(v, env))),\n          _ => (),\n        }\n      }\n      smt.expand(body, more)\n    },\n    smt.SList(xs) => smt.SList(xs.map(y -> smt.expand(y, env))),\n  }\n}"},{"name":"smt.model_values","kind":"fn","old":"ed893e2a687d957e","new":"876d15522cf567a7","interface_changed":false,"affected":[],"module":"smt","text":"/// The values of a `get-value` answer (`((t1 v1) (t2 v2) …)`), by the\n/// terms asked for, in order.\nfn model_values(out: String, asked: List[String]) -> Dict[String, smt.Sx] {\n  for x in smt.parse_sx(out) {\n    match x {\n      smt.SList(pairs) => if len(pairs) == len(asked)\n        && pairs.all(\n          p -> match p {\n            smt.SList([_, _]) => true,\n            _ => false,\n          },\n        ) {\n        mut m := Dict[String, smt.Sx] {}\n        for (i, p) in enumerate(pairs) {\n          match p {\n            smt.SList([_, v]) => mut m.insert(get(asked, i) ?? \"\", smt.expand(v, [])),\n            _ => (),\n          }\n        }\n        return m\n      },\n      smt.SAtom(_) => (),\n    }\n  }\n  Dict[String, smt.Sx] {}\n}","old_text":"/// The values of a `get-value` answer (`((t1 v1) (t2 v2) …)`), by the terms\n/// asked for, in order.\nfn model_values(out: String, asked: List[String]) -> Dict[String, smt.Sx] {\n  for x in smt.parse_sx(out) {\n    match x {\n      smt.SList(pairs) => if len(pairs) == len(asked)\n        && pairs.all(\n          p -> match p {\n            smt.SList([_, _]) => true,\n            _ => false,\n          },\n        ) {\n        mut m := Dict[String, smt.Sx] {}\n        for (i, p) in enumerate(pairs) {\n          match p {\n            smt.SList([_, v]) => mut m.insert(get(asked, i) ?? \"\", smt.expand(v, [])),\n            _ => (),\n          }\n        }\n        return m\n      },\n      smt.SAtom(_) => (),\n    }\n  }\n  Dict[String, smt.Sx] {}\n}"},{"name":"smt.str_text","kind":"fn","old":"02f1002abc9d1db5","new":"daa023d9426b5d36","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether `s` is a string literal as a model writes it, with code point\n/// escapes.\nfn str_text(s: String) -> Bool {\n  n := byte_len(s)\n  if n < 2 || !starts_with(s, \"\\\"\") || !ends_with(s, \"\\\"\") {\n    return false\n  }\n  mut rest := byte_slice(s, 1, n - 1)\n  mut ok := true\n  while ok && contains(rest, \"\\u{\") {\n    p := index_of(rest, \"\\u{\") ?? 0\n    after := byte_slice(rest, p + 3, byte_len(rest))\n    match index_of(after, \"}\") {\n      None => {\n        ok = false\n      },\n      Some(c) => {\n        hex := byte_slice(after, 0, c)\n        cp := smt.hex_value(hex)\n        ok = byte_len(hex) > 0\n          && cp >= 0\n          && cp <= 1114111\n          && !(cp >= 55296 && cp <= 57343)\n        rest = byte_slice(after, c + 1, byte_len(after))\n      },\n    }\n  }\n  ok\n}","old_text":"/// Whether `s` is a string literal as a model writes it, its escapes code\n/// points.\nfn str_text(s: String) -> Bool {\n  n := byte_len(s)\n  if n < 2 || !starts_with(s, \"\\\"\") || !ends_with(s, \"\\\"\") {\n    return false\n  }\n  mut rest := byte_slice(s, 1, n - 1)\n  mut ok := true\n  while ok && contains(rest, \"\\u{\") {\n    p := index_of(rest, \"\\u{\") ?? 0\n    after := byte_slice(rest, p + 3, byte_len(rest))\n    match index_of(after, \"}\") {\n      None => {\n        ok = false\n      },\n      Some(c) => {\n        hex := byte_slice(after, 0, c)\n        cp := smt.hex_value(hex)\n        ok = byte_len(hex) > 0\n          && cp >= 0\n          && cp <= 1114111\n          && !(cp >= 55296 && cp <= 57343)\n        rest = byte_slice(after, c + 1, byte_len(after))\n      },\n    }\n  }\n  ok\n}"},{"name":"smt.hex_value","kind":"fn","old":"3c8d94c957fc8b2b","new":"e985799bf52ee251","interface_changed":false,"affected":[],"module":"smt","text":"/// The value of hexadecimal digits, -1 for anything else.\nfn hex_value(h: String) -> Int {\n  mut v := 0\n  for k in 0..byte_len(h) {\n    b := byte_at(h, k)\n    d := if b >= 48 && b <= 57 {\n      b - 48\n    } else if b >= 97 && b <= 102 {\n      b - 87\n    } else if b >= 65 && b <= 70 {\n      b - 55\n    } else {\n      return -1\n    }\n    v = v * 16 + d\n  }\n  v\n}","old_text":"/// The value of hexadecimal digits (-1 for anything else).\nfn hex_value(h: String) -> Int {\n  mut v := 0\n  for k in 0..byte_len(h) {\n    b := byte_at(h, k)\n    d := if b >= 48 && b <= 57 {\n      b - 48\n    } else if b >= 97 && b <= 102 {\n      b - 87\n    } else if b >= 65 && b <= 70 {\n      b - 55\n    } else {\n      return -1\n    }\n    v = v * 16 + d\n  }\n  v\n}"},{"name":"smt.undecided","kind":"fn","old":"78e1291ed8d60b79","new":"d55d45649383af39","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether a pattern has a condition the checker can't decide, leaving its\n/// `match` to the prover: a `where`, or a refined type by name.\nfn undecided(vc: smt.Vc, p: ast.Pattern) -> Bool {\n  match p {\n    ast.CondPat(_) => true,\n    ast.CtorPattern { name, args } => {\n      named_refined := !contains(vc.ctors, name)\n        && match get(vc.types, name) {\n          Some(td) => td.refinement != None,\n          None => false,\n        }\n      named_refined\n        || match args {\n          ast.PositionalPats(ps) | ast.TypePats(ps) => ps.any(q -> smt.undecided(vc, q)),\n          ast.RecordPats { fields, .. } => fields.any(f -> smt.undecided(vc, f.1)),\n          ast.NoPats => false,\n        }\n    },\n    ast.ListPat { items, .. } => items.any(q -> smt.undecided(vc, q)),\n    ast.TuplePat(ps) | ast.OrPat(ps) => ps.any(q -> smt.undecided(vc, q)),\n    _ => false,\n  }\n}","old_text":"/// Whether a pattern has a condition the checker can't decide (its\n/// `match` is left to the prover): a `where`, or a refined type by name.\nfn undecided(vc: smt.Vc, p: ast.Pattern) -> Bool {\n  match p {\n    ast.CondPat(_) => true,\n    ast.CtorPattern { name, args } => {\n      named_refined := !contains(vc.ctors, name)\n        && match get(vc.types, name) {\n          Some(td) => td.refinement != None,\n          None => false,\n        }\n      named_refined\n        || match args {\n          ast.PositionalPats(ps) | ast.TypePats(ps) => ps.any(q -> smt.undecided(vc, q)),\n          ast.RecordPats { fields, .. } => fields.any(f -> smt.undecided(vc, f.1)),\n          ast.NoPats => false,\n        }\n    },\n    ast.ListPat { items, .. } => items.any(q -> smt.undecided(vc, q)),\n    ast.TuplePat(ps) | ast.OrPat(ps) => ps.any(q -> smt.undecided(vc, q)),\n    _ => false,\n  }\n}"},{"name":"smt.sized","kind":"fn","old":"83ac64e960c24dbd","new":"c6547af0a988e00f","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether `t` is a sized integer (`U8` … `I64`): an `Int` within its\n/// width's range, its operations wrapped (`word`, `wrap_term`).\nfn sized(mut vc: smt.Vc, t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Named { name, .. } => smt.width_of(name) != None,\n    _ => false,\n  }\n}","old_text":"/// Whether `t` is a sized integer (`U8`, ..., `I64`): an `Int` within\n/// its width's range, its operations wrapped (`word`, `wrap_term`).\nfn sized(mut vc: smt.Vc, t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Named { name, .. } => smt.width_of(name) != None,\n    _ => false,\n  }\n}"},{"name":"smt.Func","kind":"type","old":"62fe8106f7ddefb2","new":"e318ec749df5101d","interface_changed":false,"affected":[],"module":"smt","text":"/// A function applied to list elements (`map`, `filter`, `all`), kept to\n/// apply to any element later.\ntype Func =\n  // `x -> body`, with the variables in scope where it was written\n  | FLambda { param: String, body: ast.Expr, scopes: List[Dict[String, smt.Val]] }\n  // a named function\n  | FNamed(String)\n  // \"is a valid value of this type\"\n  | FValid(ast.TypeExpr)\n  // the negation of a function to Bool (`any(xs, f)` is `!all(xs, !f)`)\n  | FNot(smt.Func)","old_text":"/// A function applied to list elements (`map`, `filter`, `all`), kept so\n/// that it can be applied to any element later.\ntype Func =\n  // `x -> body`, with the variables in scope where it was written\n  | FLambda { param: String, body: ast.Expr, scopes: List[Dict[String, smt.Val]] }\n  // a named function\n  | FNamed(String)\n  // \"is a valid value of this type\"\n  | FValid(ast.TypeExpr)\n  // the negation of a function to Bool (`any(xs, f)` is `!all(xs, !f)`)\n  | FNot(smt.Func)"},{"name":"smt.Gen","kind":"type","old":"e20d3d2966168303","new":"29c37bf294fcf365","interface_changed":false,"affected":[],"module":"smt","text":"/// How an arbitrary element of a list is made, from where the list came\n/// from.\ntype Gen =\n  // nothing is known of the elements\n  | Untracked\n  // valid values of a type (a list that crossed a checked boundary)\n  | GType(ast.TypeExpr)\n  // one of these values (a list literal)\n  | GValues(List[smt.Val])\n  // an integer in `lo..hi` (`range`)\n  | GRange(String, String)\n  // an element of another list (`sort`, `set`)\n  | GSub(Int)\n  // an element of another list that satisfies a function (`filter`)\n  | GFilter(Int, smt.Func)\n  // a function of an element of another list (`map`)\n  | GMap(Int, smt.Func)\n  // two branches merged: the first list's element at a position when the\n  // term holds, else the second's at the same position\n  | GEither(String, Int, Int)\n  // another list from a position on: element `i` is the other's `off + i`\n  | GShift(Int, String)\n  // another list reversed, of this length\n  | GRev(Int, String)\n  // the first list then the second, the first of this length\n  | GConcat(Int, Int, String)\n  // a list inside a datatype value: a term of the list sort named last,\n  // whose length and items are functions of it, items of this type\n  | GSeq(String, ast.TypeExpr, String)\n  // `enumerate` of another list, of this length: element `i` is `(i, x)`\n  // with `x` the other list's element `i`\n  | GEnum(Int, String)\n  // `zip` of two lists, of this length: element `i` is `(x, y)` with `x`\n  // and `y` their elements `i`\n  | GZip(Int, Int, String)\n  // the entries of a dict (`(key, value)` tuples) or the items of a set:\n  // valid values of this type, not by position\n  | GItems(ast.TypeExpr)","old_text":"/// How an arbitrary element of a list is made: each list's elements are\n/// described by where the list came from.\ntype Gen =\n  // nothing is known of the elements\n  | Untracked\n  // valid values of a type (a list that crossed a checked boundary)\n  | GType(ast.TypeExpr)\n  // one of these values (a list literal)\n  | GValues(List[smt.Val])\n  // an integer in `lo..hi` (`range`)\n  | GRange(String, String)\n  // an element of another list (`sort`, `set`)\n  | GSub(Int)\n  // an element of another list that satisfies a function (`filter`)\n  | GFilter(Int, smt.Func)\n  // a function of an element of another list (`map`)\n  | GMap(Int, smt.Func)\n  // an element of the first list when the term holds, else of the second\n  // (two branches merged): the same position in either\n  | GEither(String, Int, Int)\n  // the elements of another list from a position on: element `i` is the\n  // other's `off + i`\n  | GShift(Int, String)\n  // another list backwards, of this length\n  | GRev(Int, String)\n  // the first list, then the second, the first of this length\n  | GConcat(Int, Int, String)\n  // a list inside a datatype value: a term of the list sort named last,\n  // whose length and items are functions of it; the items of this type\n  | GSeq(String, ast.TypeExpr, String)\n  // `enumerate` of another list, of this length: element `i` is `(i, x)`\n  // with `x` the other list's element `i`\n  | GEnum(Int, String)\n  // `zip` of two lists, of this length: element `i` is `(x, y)` with `x`\n  // and `y` their elements `i`\n  | GZip(Int, Int, String)\n  // the entries of a dict (`(key, value)` tuples) or the items of a set:\n  // valid values of this type, not by position\n  | GItems(ast.TypeExpr)"},{"name":"smt.Template","kind":"type","old":"eb0b6c0fc3410976","new":"fe5e46d5093d9af7","interface_changed":false,"affected":[],"module":"smt","text":"/// The element of a list of a checked type at the placeholder position\n/// (`@@i`), and the facts that hold for every element.\ntype Template = { val: smt.Val, facts: List[String] }","old_text":"/// The element of a list of a checked type at the placeholder position\n/// (`@@i`), and what is known of it: what holds for every element.\ntype Template = { val: smt.Val, facts: List[String] }"},{"name":"smt.ListInfo","kind":"type","old":"11fcd0fa99ae4067","new":"ef44f599dba1c1cf","interface_changed":false,"affected":[],"module":"smt","text":"/// What is known of one list.\ntype ListInfo = {\n  source: smt.Gen,\n  // whether its elements can be taken by position (`positional`). Found\n  // once when the list is made: lists share their sources, so finding it\n  // again at each use is exponential.\n  positional: Bool,\n  // facts about every element, each holding when its guard does\n  preds: List[(String, smt.Func)],\n  // elements made so far, with the condition under which each exists\n  seen: List[(String, smt.Val)],\n  // for a list of a checked type: its element at any position\n  template: Option[smt.Template],\n  // the positions this list is inside of. Its elements' unknowns are\n  // functions of these and of their own position.\n  outer: List[String],\n  // the list whose template this one shares\n  tpl_from: Option[Int],\n  // elements taken by position, with what was assumed of them\n  at: Dict[String, (smt.Val, List[String])],\n  // lists this one equals when the term holds (`q == lv.orders` assumed).\n  // Each element taken by position is the other's at that position, a fact\n  // made only at the positions the code takes, to avoid a quantifier.\n  same: List[(String, Int)] = [],\n}","old_text":"/// What is known of one list.\ntype ListInfo = {\n  source: smt.Gen,\n  // can its elements be taken by position (`positional`)? Worked out once,\n  // when the list is made: lists share their sources, so working it out\n  // again at each use is exponential\n  positional: Bool,\n  // facts about every element, each holding when its guard does\n  preds: List[(String, smt.Func)],\n  // elements made so far, with the condition under which each exists\n  seen: List[(String, smt.Val)],\n  // for a list of a checked type: its element at any position\n  template: Option[smt.Template],\n  // the positions this list is inside of (its elements' unknowns are\n  // functions of these and of their own position)\n  outer: List[String],\n  // the list whose template this one shares\n  tpl_from: Option[Int],\n  // elements taken by position, with what was assumed of them\n  at: Dict[String, (smt.Val, List[String])],\n  // lists this one equals when the term holds (`q == lv.orders` assumed):\n  // each element taken by position is the other's at that position, a fact\n  // made only at the positions the code takes (no quantifier)\n  same: List[(String, Int)] = [],\n}"},{"name":"smt.BuiltinSig","kind":"type","old":"07eeae461a6e30c1","new":"5718328ec99afd58","interface_changed":false,"affected":[],"module":"smt","text":"/// A builtin's signature (core's `builtin fn`): name, type parameters,\n/// result type, and whether it is total (no `requires`).\npub type BuiltinSig = {\n  name: String,\n  type_params: List[String],\n  ret: ast.TypeExpr,\n  total: Bool,\n}","old_text":"/// A builtin's signature (core's `builtin fn`): its name, type parameters,\n/// result type, and whether it is total (no `requires`).\npub type BuiltinSig = {\n  name: String,\n  type_params: List[String],\n  ret: ast.TypeExpr,\n  total: Bool,\n}"},{"name":"smt.builtins_of","kind":"fn","old":"c5e17afa30e6056d","new":"ecf9e83ca32a070f","interface_changed":false,"affected":[],"module":"smt","text":"/// The builtins' signatures among definitions (core's `builtin fn`s).\npub fn builtins_of(decls: List[ast.Decl]) -> List[smt.BuiltinSig] {\n  mut out := []\n  for d in decls {\n    match d.kind {\n      ast.ExternDef(ast.ExternDecl { lang: ast.Builtin, item: ast.ExternFn(f) }) => {\n        // raw memory (core.mem) is never total, since nothing checks an\n        // address. Neither are the builtins listed here, whose contracts\n        // aren't written.\n        mut out.push(\n          smt.BuiltinSig {\n            name: f.name,\n            type_params: f.type_params,\n            ret: f.ret,\n            total: len(f.pre) == 0\n              && d.module != \"core.mem\"\n              && !contains([\n                \"matches\",\n                \"channel_send\",\n                \"channel_recv\",\n                \"channel_close\",\n              ], f.name),\n          },\n        )\n      },\n      _ => (),\n    }\n  }\n  out\n}","old_text":"/// The builtins' signatures among definitions (core's `builtin fn`s).\npub fn builtins_of(decls: List[ast.Decl]) -> List[smt.BuiltinSig] {\n  mut out := []\n  for d in decls {\n    match d.kind {\n      ast.ExternDef(ast.ExternDecl { lang: ast.Builtin, item: ast.ExternFn(f) }) => {\n        // (raw memory is never total: nothing checks an address; nor are\n        // the builtins whose contracts aren't written yet)\n        mut out.push(\n          smt.BuiltinSig {\n            name: f.name,\n            type_params: f.type_params,\n            ret: f.ret,\n            total: len(f.pre) == 0\n              && d.module != \"core.mem\"\n              && !contains([\n                \"matches\",\n                \"channel_send\",\n                \"channel_recv\",\n                \"channel_close\",\n              ], f.name),\n          },\n        )\n      },\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"smt.enter","kind":"fn","old":"ebf4fa2c3b3b16e1","new":"b72d66f7ed3512a5","interface_changed":false,"affected":[],"module":"smt","text":"/// Opens a scope: where the unknowns and facts made in it start.\nfn enter(mut vc: smt.Vc) {\n  mut vc.regions.push((len(vc.consts), len(vc.facts)))\n}","old_text":"/// Open a scope: where the unknowns and facts made in it start.\nfn enter(mut vc: smt.Vc) {\n  mut vc.regions.push((len(vc.consts), len(vc.facts)))\n}"},{"name":"smt.leave","kind":"fn","old":"ea5bb536f0b65f55","new":"183d37ae29db71e1","interface_changed":false,"affected":[],"module":"smt","text":"/// Closes the last scope opened, returning where its unknowns and facts\n/// start.\nfn leave(mut vc: smt.Vc) -> (Int, Int) {\n  r := get(vc.regions, len(vc.regions) - 1) ?? (len(vc.consts), len(vc.facts))\n  vc.regions = take(vc.regions, len(vc.regions) - 1)\n  r\n}","old_text":"/// Close the scope opened last: where its unknowns and facts start.\nfn leave(mut vc: smt.Vc) -> (Int, Int) {\n  r := get(vc.regions, len(vc.regions) - 1) ?? (len(vc.consts), len(vc.facts))\n  vc.regions = take(vc.regions, len(vc.regions) - 1)\n  r\n}"},{"name":"smt.list_id","kind":"fn","old":"be371f9e7af3199a","new":"fb740b10bcc618a9","interface_changed":false,"affected":[],"module":"smt","text":"/// The list a value is, or an unknown list for a value that isn't one.\nfn list_id(mut vc: smt.Vc, v: smt.Val) -> Int {\n  match v {\n    smt.VList { id, .. } => id,\n    _ => {\n      mut vc.lists.push(\n        smt.ListInfo {\n          source: smt.Untracked,\n          positional: false,\n          preds: [],\n          seen: [],\n          template: None,\n          outer: [],\n          tpl_from: None,\n          at: Dict[String, (smt.Val, List[String])] {},\n        },\n      )\n      len(vc.lists) - 1\n    },\n  }\n}","old_text":"/// The list a value is (an unknown list for a value that isn't one).\nfn list_id(mut vc: smt.Vc, v: smt.Val) -> Int {\n  match v {\n    smt.VList { id, .. } => id,\n    _ => {\n      mut vc.lists.push(\n        smt.ListInfo {\n          source: smt.Untracked,\n          positional: false,\n          preds: [],\n          seen: [],\n          template: None,\n          outer: [],\n          tpl_from: None,\n          at: Dict[String, (smt.Val, List[String])] {},\n        },\n      )\n      len(vc.lists) - 1\n    },\n  }\n}"},{"name":"smt.elem_type","kind":"fn","old":"4b5514b2e0a27f90","new":"5f781dec91a16b75","interface_changed":false,"affected":[],"module":"smt","text":"/// The type every element of a list is known to have, if any.\nfn elem_type(vc: smt.Vc, id: Int) -> Option[ast.TypeExpr] {\n  match smt.list_info(vc, id).source {\n    smt.GType(t) | smt.GSeq(_, t, _) => Some(t),\n    smt.GSub(p) | smt.GFilter(p, _) | smt.GShift(p, _) | smt.GRev(p, _) => smt.elem_type(vc, p),\n    _ => None,\n  }\n}","old_text":"/// The type every element of a list is known to have, if one is.\nfn elem_type(vc: smt.Vc, id: Int) -> Option[ast.TypeExpr] {\n  match smt.list_info(vc, id).source {\n    smt.GType(t) | smt.GSeq(_, t, _) => Some(t),\n    smt.GSub(p) | smt.GFilter(p, _) | smt.GShift(p, _) | smt.GRev(p, _) => smt.elem_type(vc, p),\n    _ => None,\n  }\n}"},{"name":"smt.valid_known","kind":"fn","old":"0a83cff64c02d9c6","new":"3f9b5e128ba55aa7","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether every element of a list is unconditionally a valid `t`. Each\n/// source list is visited once: a list both branches of an `if` were made\n/// from (`xs = drop(xs, 1)` under an `if`) is shared, not followed once per\n/// path.\nfn valid_known(vc: smt.Vc, id: Int, t: ast.TypeExpr) -> Bool {\n  same := (t2: ast.TypeExpr) ->\n    t2 == t || smt.erased(vc, t2) == smt.erased(vc, t)\n  mut seen := Set[Int] {}\n  mut todo := [id]\n  while len(todo) > 0 {\n    at := get(todo, len(todo) - 1) ?? id\n    todo = todo[..len(todo) - 1]\n    if contains(seen, at) {\n      continue\n    }\n    mut seen.insert(at)\n    info := smt.list_info(vc, at)\n    if info.preds.any(\n      p -> p.0 == \"true\"\n        && match p.1 {\n          smt.FValid(t2) => same(t2),\n          _ => false,\n        },\n    ) {\n      continue\n    }\n    match info.source {\n      smt.GType(t2) => if !same(t2) {\n        return false\n      },\n      smt.GSub(p) | smt.GFilter(p, _) | smt.GShift(p, _) | smt.GRev(p, _) => mut todo.push(p),\n      smt.GEither(_, a, b) | smt.GConcat(a, b, _) => {\n        todo = todo + [b] + [a]\n      },\n      smt.GValues(vs) => if len(vs) != 0 {\n        return false\n      },\n      _ => return false,\n    }\n  }\n  true\n}","old_text":"/// Is every element of a list known (unconditionally) to be a valid `t`?\n/// Each list it is made of is looked at once: a list both branches of an\n/// `if` made from (`xs = drop(xs, 1)` under an `if`) is shared, not\n/// followed once per path.\nfn valid_known(vc: smt.Vc, id: Int, t: ast.TypeExpr) -> Bool {\n  same := (t2: ast.TypeExpr) ->\n    t2 == t || smt.erased(vc, t2) == smt.erased(vc, t)\n  mut seen := Set[Int] {}\n  mut todo := [id]\n  while len(todo) > 0 {\n    at := get(todo, len(todo) - 1) ?? id\n    todo = todo[..len(todo) - 1]\n    if contains(seen, at) {\n      continue\n    }\n    mut seen.insert(at)\n    info := smt.list_info(vc, at)\n    if info.preds.any(\n      p -> p.0 == \"true\"\n        && match p.1 {\n          smt.FValid(t2) => same(t2),\n          _ => false,\n        },\n    ) {\n      continue\n    }\n    match info.source {\n      smt.GType(t2) => if !same(t2) {\n        return false\n      },\n      smt.GSub(p) | smt.GFilter(p, _) | smt.GShift(p, _) | smt.GRev(p, _) => mut todo.push(p),\n      smt.GEither(_, a, b) | smt.GConcat(a, b, _) => {\n        todo = todo + [b] + [a]\n      },\n      smt.GValues(vs) => if len(vs) != 0 {\n        return false\n      },\n      _ => return false,\n    }\n  }\n  true\n}"},{"name":"smt.known_of","kind":"fn","old":"01dd1f5f2f383803","new":"9f28d5104102bac1","interface_changed":false,"affected":[],"module":"smt","text":"/// Assumes of `x` what is known of every element of list `id`, and records\n/// `x` as one of its elements on this path.\nfn known_of(mut vc: smt.Vc, id: Int, x: smt.Val) {\n  for (g, f) in smt.list_info(vc, id).preds {\n    pol := vc.polarity\n    vc.polarity = 1\n    pv := smt.apply(mut vc, f, x)\n    vc.polarity = pol\n    p := smt.as_bool(mut vc, pv)\n    smt.assume(mut vc, smt.implies(g, p))\n  }\n  if vc.binding == 0 {\n    info := smt.list_info(vc, id)\n    smt.set_list(\n      mut vc,\n      id,\n      smt.ListInfo { ..info, seen: info.seen + [(smt.and_all(vc.pc), x)] },\n    )\n  }\n}","old_text":"/// What is known of every element of list `id`, assumed of `x`; `x`\n/// remembered as one of its elements (on this path).\nfn known_of(mut vc: smt.Vc, id: Int, x: smt.Val) {\n  for (g, f) in smt.list_info(vc, id).preds {\n    pol := vc.polarity\n    vc.polarity = 1\n    pv := smt.apply(mut vc, f, x)\n    vc.polarity = pol\n    p := smt.as_bool(mut vc, pv)\n    smt.assume(mut vc, smt.implies(g, p))\n  }\n  if vc.binding == 0 {\n    info := smt.list_info(vc, id)\n    smt.set_list(\n      mut vc,\n      id,\n      smt.ListInfo { ..info, seen: info.seen + [(smt.and_all(vc.pc), x)] },\n    )\n  }\n}"},{"name":"smt.element_inner","kind":"fn","old":"a018ae3da83d036c","new":"e31e103482da3feb","interface_changed":false,"affected":[],"module":"smt","text":"fn element_inner(mut vc: smt.Vc, id: Int) -> smt.Val {\n  x := match smt.list_info(vc, id).source {\n    smt.Untracked => smt.Opaque(\"the elements of a list are not tracked\"),\n    smt.GType(t) => smt.havoc(mut vc, t),\n    // an item at some position\n    smt.GSeq(s, _, n) => {\n      k := smt.fresh(mut vc, \"Int\")\n      smt.assume(\n        mut vc,\n        f\"(and (<= 0 {k}) (< {k} {smt.seq_len(n, s)}))\",\n      )\n      return smt.element_at_inner(mut vc, id, k) ?? smt.Opaque(\"an element\")\n    },\n    smt.GValues(vs) => if len(vs) == 0 {\n      // a list literal `[]` has no element: this one doesn't exist\n      smt.assume(mut vc, \"false\")\n      smt.Opaque(\"an element of an empty list\")\n    } else {\n      k := smt.fresh(mut vc, \"Int\")\n      smt.assume(mut vc, f\"(and (<= 0 {k}) (< {k} {len(vs)}))\")\n      mut v := get(vs, len(vs) - 1) ?? smt.Inactive\n      mut i := len(vs) - 2\n      while i >= 0 {\n        v = smt.merge(\n          mut vc,\n          f\"(= {k} {i})\",\n          get(vs, i) ?? smt.Inactive,\n          v,\n        )\n        i -= 1\n      }\n      v\n    },\n    smt.GRange(lo, hi) => {\n      x := smt.fresh(mut vc, \"Int\")\n      smt.assume(mut vc, f\"(and (<= {lo} {x}) (< {x} {hi}))\")\n      smt.VInt(x)\n    },\n    smt.GItems(t) => smt.item_of(mut vc, id, t),\n    // `(k, x)`: some position `k` and an element, taken as any element\n    // instead of the one at `k`. By position, the facts every `for` over\n    // `enumerate` adds made the solver slow.\n    smt.GEnum(p, l) => {\n      k := smt.fresh(mut vc, \"Int\")\n      smt.assume(mut vc, f\"(and (<= 0 {k}) (< {k} {l}))\")\n      x := smt.element_inner(mut vc, p)\n      smt.VTuple([smt.VInt(k), x])\n    },\n    smt.GZip(a, b, _) => {\n      x := smt.element_inner(mut vc, a)\n      y := smt.element_inner(mut vc, b)\n      smt.VTuple([x, y])\n    },\n    smt.GSub(p) | smt.GShift(p, _) | smt.GRev(p, _) => smt.element_inner(mut vc, p),\n    // an element of `a + b` is one of `a`'s or one of `b`'s\n    smt.GConcat(a, b, _) => {\n      c := smt.fresh(mut vc, \"Bool\")\n      n := len(vc.pc)\n      mut vc.pc.push(c)\n      ea := smt.element_inner(mut vc, a)\n      vc.pc = take(vc.pc, n) + [smt.neg(c)]\n      eb := smt.element_inner(mut vc, b)\n      vc.pc = take(vc.pc, n)\n      smt.merge(mut vc, c, ea, eb)\n    },\n    smt.GFilter(p, f) => {\n      x := smt.element_inner(mut vc, p)\n      cv := smt.apply(mut vc, f, x)\n      c := smt.as_bool(mut vc, cv)\n      smt.assume(mut vc, c)\n      x\n    },\n    smt.GMap(p, f) => {\n      y := smt.element_inner(mut vc, p)\n      smt.apply(mut vc, f, y)\n    },\n    smt.GEither(c, a, b) => if smt.is_empty_literal(vc, a) {\n      // one side is `[]`: the element is from the other one\n      smt.assume(mut vc, smt.neg(c))\n      smt.element_inner(mut vc, b)\n    } else if smt.is_empty_literal(vc, b) {\n      smt.assume(mut vc, c)\n      smt.element_inner(mut vc, a)\n    } else {\n      n := len(vc.pc)\n      mut vc.pc.push(c)\n      ea := smt.element_inner(mut vc, a)\n      vc.pc = take(vc.pc, n) + [smt.neg(c)]\n      eb := smt.element_inner(mut vc, b)\n      vc.pc = take(vc.pc, n)\n      smt.merge(mut vc, c, ea, eb)\n    },\n  }\n  smt.known_of(mut vc, id, x)\n  x\n}","old_text":"fn element_inner(mut vc: smt.Vc, id: Int) -> smt.Val {\n  x := match smt.list_info(vc, id).source {\n    smt.Untracked => smt.Opaque(\"the elements of a list are not tracked\"),\n    smt.GType(t) => smt.havoc(mut vc, t),\n    // an item at some position\n    smt.GSeq(s, _, n) => {\n      k := smt.fresh(mut vc, \"Int\")\n      smt.assume(\n        mut vc,\n        f\"(and (<= 0 {k}) (< {k} {smt.seq_len(n, s)}))\",\n      )\n      return smt.element_at_inner(mut vc, id, k) ?? smt.Opaque(\"an element\")\n    },\n    smt.GValues(vs) => if len(vs) == 0 {\n      // a list literal `[]` has no element: this one doesn't exist\n      smt.assume(mut vc, \"false\")\n      smt.Opaque(\"an element of an empty list\")\n    } else {\n      k := smt.fresh(mut vc, \"Int\")\n      smt.assume(mut vc, f\"(and (<= 0 {k}) (< {k} {len(vs)}))\")\n      mut v := get(vs, len(vs) - 1) ?? smt.Inactive\n      mut i := len(vs) - 2\n      while i >= 0 {\n        v = smt.merge(\n          mut vc,\n          f\"(= {k} {i})\",\n          get(vs, i) ?? smt.Inactive,\n          v,\n        )\n        i -= 1\n      }\n      v\n    },\n    smt.GRange(lo, hi) => {\n      x := smt.fresh(mut vc, \"Int\")\n      smt.assume(mut vc, f\"(and (<= {lo} {x}) (< {x} {hi}))\")\n      smt.VInt(x)\n    },\n    smt.GItems(t) => smt.item_of(mut vc, id, t),\n    // `(k, x)`: some position `k` and an element (the one there, but taken\n    // as any element: by position, the facts every `for` over `enumerate`\n    // adds made the solver slow)\n    smt.GEnum(p, l) => {\n      k := smt.fresh(mut vc, \"Int\")\n      smt.assume(mut vc, f\"(and (<= 0 {k}) (< {k} {l}))\")\n      x := smt.element_inner(mut vc, p)\n      smt.VTuple([smt.VInt(k), x])\n    },\n    smt.GZip(a, b, _) => {\n      x := smt.element_inner(mut vc, a)\n      y := smt.element_inner(mut vc, b)\n      smt.VTuple([x, y])\n    },\n    smt.GSub(p) | smt.GShift(p, _) | smt.GRev(p, _) => smt.element_inner(mut vc, p),\n    // an element of `a + b` is one of `a`'s or one of `b`'s\n    smt.GConcat(a, b, _) => {\n      c := smt.fresh(mut vc, \"Bool\")\n      n := len(vc.pc)\n      mut vc.pc.push(c)\n      ea := smt.element_inner(mut vc, a)\n      vc.pc = take(vc.pc, n) + [smt.neg(c)]\n      eb := smt.element_inner(mut vc, b)\n      vc.pc = take(vc.pc, n)\n      smt.merge(mut vc, c, ea, eb)\n    },\n    smt.GFilter(p, f) => {\n      x := smt.element_inner(mut vc, p)\n      cv := smt.apply(mut vc, f, x)\n      c := smt.as_bool(mut vc, cv)\n      smt.assume(mut vc, c)\n      x\n    },\n    smt.GMap(p, f) => {\n      y := smt.element_inner(mut vc, p)\n      smt.apply(mut vc, f, y)\n    },\n    smt.GEither(c, a, b) => if smt.is_empty_literal(vc, a) {\n      // one side is `[]`: the element is from the other one\n      smt.assume(mut vc, smt.neg(c))\n      smt.element_inner(mut vc, b)\n    } else if smt.is_empty_literal(vc, b) {\n      smt.assume(mut vc, c)\n      smt.element_inner(mut vc, a)\n    } else {\n      n := len(vc.pc)\n      mut vc.pc.push(c)\n      ea := smt.element_inner(mut vc, a)\n      vc.pc = take(vc.pc, n) + [smt.neg(c)]\n      eb := smt.element_inner(mut vc, b)\n      vc.pc = take(vc.pc, n)\n      smt.merge(mut vc, c, ea, eb)\n    },\n  }\n  smt.known_of(mut vc, id, x)\n  x\n}"},{"name":"smt.element_at","kind":"fn","old":"95236f10e3bdea42","new":"1608d94795f2349f","interface_changed":false,"affected":[],"module":"smt","text":"/// The element at position `i` of list `id` when the list's positions are\n/// known. `None` for `filter`, `sort`, or a list nothing is known of.\nfn element_at(\n  mut vc: smt.Vc,\n  id: Int,\n  i: String,\n  exists: String,\n) -> Option[smt.Val] {\n  n := len(vc.pc)\n  mut vc.pc.push(exists)\n  x := smt.element_at_inner(mut vc, id, i)\n  vc.pc = take(vc.pc, n)\n  x\n}","old_text":"/// The element at position `i` of list `id`, when the list's positions\n/// are known (`None` for `filter`, `sort`, a list nothing is known of).\nfn element_at(\n  mut vc: smt.Vc,\n  id: Int,\n  i: String,\n  exists: String,\n) -> Option[smt.Val] {\n  n := len(vc.pc)\n  mut vc.pc.push(exists)\n  x := smt.element_at_inner(mut vc, id, i)\n  vc.pc = take(vc.pc, n)\n  x\n}"},{"name":"smt.positional","kind":"fn","old":"73ee9d208626d2b8","new":"216f38e24fe2c6f2","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether elements of list `id` can be taken by position.\nfn positional(vc: smt.Vc, id: Int) -> Bool {\n  smt.list_info(vc, id).positional\n}","old_text":"/// Can elements of list `id` be taken by position?\nfn positional(vc: smt.Vc, id: Int) -> Bool {\n  smt.list_info(vc, id).positional\n}"},{"name":"smt.positions_either","kind":"fn","old":"05283ba4e2cbc376","new":"daee4f67d20235b2","interface_changed":false,"affected":[],"module":"smt","text":"/// The element at position `ia` of list `a` when `c` holds, else at `ib`\n/// of `b`.\nfn positions_either(\n  mut vc: smt.Vc,\n  c: String,\n  a: Int,\n  ia: String,\n  b: Int,\n  ib: String,\n) -> Option[smt.Val] {\n  if smt.is_empty_literal(vc, a) {\n    smt.assume(mut vc, smt.neg(c))\n    return smt.element_at_inner(mut vc, b, ib)\n  }\n  if smt.is_empty_literal(vc, b) {\n    smt.assume(mut vc, c)\n    return smt.element_at_inner(mut vc, a, ia)\n  }\n  // both sides drop from the same list (`xs = drop(xs, 2)` under an `if`):\n  // one element of it at either position, so a chain of such `if`s is\n  // followed once instead of once per path\n  (ra, ja, sa) := smt.unshift(vc, a, ia)\n  (rb, jb, sb) := smt.unshift(vc, b, ib)\n  if ra == rb {\n    j := smt.share(mut vc, \"Int\", smt.ite(c, ja, jb))\n    x := smt.element_at_inner(mut vc, ra, j)?\n    // what the lists dropped from it know of their elements\n    smt.known_of_all(mut vc, sa, c, x)\n    smt.known_of_all(mut vc, sb, smt.neg(c), x)\n    return Some(x)\n  }\n  n := len(vc.pc)\n  mut vc.pc.push(c)\n  ea := smt.element_at_inner(mut vc, a, ia)\n  vc.pc = take(vc.pc, n) + [smt.neg(c)]\n  eb := smt.element_at_inner(mut vc, b, ib)\n  vc.pc = take(vc.pc, n)\n  match (ea, eb) {\n    (Some(x), Some(y)) => {\n      m := smt.merge(mut vc, c, x, y)\n      Some(smt.share_val(mut vc, m))\n    },\n    _ => None,\n  }\n}","old_text":"/// The element at position `ia` of list `a` when `c` holds, else at `ib`\n/// of `b`.\nfn positions_either(\n  mut vc: smt.Vc,\n  c: String,\n  a: Int,\n  ia: String,\n  b: Int,\n  ib: String,\n) -> Option[smt.Val] {\n  if smt.is_empty_literal(vc, a) {\n    smt.assume(mut vc, smt.neg(c))\n    return smt.element_at_inner(mut vc, b, ib)\n  }\n  if smt.is_empty_literal(vc, b) {\n    smt.assume(mut vc, c)\n    return smt.element_at_inner(mut vc, a, ia)\n  }\n  // both sides drop from the same list (`xs = drop(xs, 2)` under an `if`):\n  // one element of it, at either position, so that a chain of such `if`s\n  // is followed once, not once per path\n  (ra, ja, sa) := smt.unshift(vc, a, ia)\n  (rb, jb, sb) := smt.unshift(vc, b, ib)\n  if ra == rb {\n    j := smt.share(mut vc, \"Int\", smt.ite(c, ja, jb))\n    x := smt.element_at_inner(mut vc, ra, j)?\n    // what the lists dropped from it know of their elements\n    smt.known_of_all(mut vc, sa, c, x)\n    smt.known_of_all(mut vc, sb, smt.neg(c), x)\n    return Some(x)\n  }\n  n := len(vc.pc)\n  mut vc.pc.push(c)\n  ea := smt.element_at_inner(mut vc, a, ia)\n  vc.pc = take(vc.pc, n) + [smt.neg(c)]\n  eb := smt.element_at_inner(mut vc, b, ib)\n  vc.pc = take(vc.pc, n)\n  match (ea, eb) {\n    (Some(x), Some(y)) => {\n      m := smt.merge(mut vc, c, x, y)\n      Some(smt.share_val(mut vc, m))\n    },\n    _ => None,\n  }\n}"},{"name":"smt.template","kind":"fn","old":"08eaf887cb6f663f","new":"60c36b5e6f7bea99","interface_changed":false,"affected":[],"module":"smt","text":"/// The element of list `id` (of a checked type) at position `@@i`, inside\n/// the positions `@@o0`, …. Made once, for the list and its copies.\nfn template(mut vc: smt.Vc, id: Int) -> Option[smt.Template] {\n  root := smt.list_info(vc, id).tpl_from ?? id\n  info := smt.list_info(vc, root)\n  match info.template {\n    Some(t) => return Some(t),\n    None => (),\n  }\n  t := match info.source {\n    smt.GType(t) => t,\n    _ => return None,\n  }\n  mut args := []\n  for k in 0..len(info.outer) {\n    mut args.push(f\"@@o{k}\")\n  }\n  mut args.push(smt.idx())\n  if len(args) > smt.max_positions() {\n    return None\n  }\n  smt.enter(mut vc)\n  pc := vc.pc\n  vc.pc = []\n  indexing := vc.indexing\n  vc.indexing = Some(args)\n  vc.spec += 1\n  v := smt.shape(mut vc, t)\n  valid := smt.check_type(mut vc, t, v, [])\n  vc.spec -= 1\n  vc.indexing = indexing\n  vc.pc = pc\n  (_, nf) := smt.leave(mut vc)\n  facts := drop(vc.facts, nf) + [valid]\n  vc.facts = take(vc.facts, nf)\n  tpl := smt.Template { val: v, facts }\n  smt.set_list(\n    mut vc,\n    root,\n    smt.ListInfo { ..smt.list_info(vc, root), template: Some(tpl) },\n  )\n  Some(tpl)\n}","old_text":"/// The element of list `id` (of a checked type) at position `@@i`, inside\n/// the positions `@@o0`, … (made once, for the list and its copies).\nfn template(mut vc: smt.Vc, id: Int) -> Option[smt.Template] {\n  root := smt.list_info(vc, id).tpl_from ?? id\n  info := smt.list_info(vc, root)\n  match info.template {\n    Some(t) => return Some(t),\n    None => (),\n  }\n  t := match info.source {\n    smt.GType(t) => t,\n    _ => return None,\n  }\n  mut args := []\n  for k in 0..len(info.outer) {\n    mut args.push(f\"@@o{k}\")\n  }\n  mut args.push(smt.idx())\n  if len(args) > smt.max_positions() {\n    return None\n  }\n  smt.enter(mut vc)\n  pc := vc.pc\n  vc.pc = []\n  indexing := vc.indexing\n  vc.indexing = Some(args)\n  vc.spec += 1\n  v := smt.shape(mut vc, t)\n  valid := smt.check_type(mut vc, t, v, [])\n  vc.spec -= 1\n  vc.indexing = indexing\n  vc.pc = pc\n  (_, nf) := smt.leave(mut vc)\n  facts := drop(vc.facts, nf) + [valid]\n  vc.facts = take(vc.facts, nf)\n  tpl := smt.Template { val: v, facts }\n  smt.set_list(\n    mut vc,\n    root,\n    smt.ListInfo { ..smt.list_info(vc, root), template: Some(tpl) },\n  )\n  Some(tpl)\n}"},{"name":"smt.subst_val","kind":"fn","old":"7373cf04550c474a","new":"0af13f1fdbc0c9e9","interface_changed":false,"affected":[],"module":"smt","text":"// ---- operators ----\n\n/// `v` at position `i` inside `outer` (see `place`). Each list in it is a\n/// new list sharing the template of the one it copies.\nfn subst_val(\n  mut vc: smt.Vc,\n  v: smt.Val,\n  i: String,\n  outer: List[String],\n) -> smt.Val {\n  mut done := Dict[Int, Int] {}\n  smt.subst_val_in(mut vc, v, i, outer, mut done)\n}","old_text":"// ---- operators ----\n\n/// `v` at position `i` inside `outer` (see `place`); each list in it is a\n/// new list, sharing the template of the one it copies.\nfn subst_val(\n  mut vc: smt.Vc,\n  v: smt.Val,\n  i: String,\n  outer: List[String],\n) -> smt.Val {\n  mut done := Dict[Int, Int] {}\n  smt.subst_val_in(mut vc, v, i, outer, mut done)\n}"},{"name":"smt.pred_counts","kind":"fn","old":"7cf28a0b6bd7d990","new":"0d9c0a6c771ae416","interface_changed":false,"affected":[],"module":"smt","text":"/// How many facts about every element each list has.\nfn pred_counts(vc: smt.Vc) -> List[Int] {\n  vc.lists.map(l -> len(l.preds))\n}","old_text":"/// The lists' facts about every element, as many as each had.\nfn pred_counts(vc: smt.Vc) -> List[Int] {\n  vc.lists.map(l -> len(l.preds))\n}"},{"name":"smt.cut_preds","kind":"fn","old":"f26f0e41abd350d9","new":"c14a6f1abcd67bd6","interface_changed":false,"affected":[],"module":"smt","text":"/// Cuts each list's facts about every element back to `counts`.\nfn cut_preds(mut vc: smt.Vc, counts: List[Int]) {\n  mut out := []\n  for (k, l) in enumerate(vc.lists) {\n    mut out.push(\n      match get(counts, k) {\n        Some(n) => smt.ListInfo { ..l, preds: take(l.preds, n) },\n        None => l,\n      },\n    )\n  }\n  vc.lists = out\n}","old_text":"/// Each list's facts about every element cut back to `counts`.\nfn cut_preds(mut vc: smt.Vc, counts: List[Int]) {\n  mut out := []\n  for (k, l) in enumerate(vc.lists) {\n    mut out.push(\n      match get(counts, k) {\n        Some(n) => smt.ListInfo { ..l, preds: take(l.preds, n) },\n        None => l,\n      },\n    )\n  }\n  vc.lists = out\n}"},{"name":"smt.free_constant","kind":"fn","old":"3907681a0e65a3f7","new":"11ee526953934f1c","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether an unknown made from `nd` on is a constant not bound by a\n/// quantifier, so the same for every position.\nfn free_constant(vc: smt.Vc, nd: Int) -> Bool {\n  drop(vc.consts, nd).any(\n    c -> c.args == 0 && !contains(vc.bound, c.name),\n  )\n}","old_text":"/// Whether an unknown made from `nd` on is a constant not bound by a\n/// quantifier (it would be the same for every position).\nfn free_constant(vc: smt.Vc, nd: Int) -> Bool {\n  drop(vc.consts, nd).any(\n    c -> c.args == 0 && !contains(vc.bound, c.name),\n  )\n}"},{"name":"smt.forall_positions","kind":"fn","old":"6c3e89ff93cba613","new":"7626e8268d73ade9","interface_changed":false,"affected":[],"module":"smt","text":"/// `f` of the element at every position of list `id` (of length `len`), as\n/// one quantified fact, so it reaches the elements the code takes by\n/// position. `None` when `f` of an element made unknowns of its own.\nfn forall_positions(\n  mut vc: smt.Vc,\n  id: Int,\n  ln: String,\n  f: smt.Func,\n) -> Option[String] {\n  if !smt.positional(vc, id) {\n    return None\n  }\n  vc.qvars += 1\n  j := f\"q{vc.qvars}\"\n  smt.enter(mut vc)\n  nm := len(vc.matched)\n  inside := f\"(and (<= 0 {j}) (< {j} {ln}))\"\n  pc := vc.pc\n  vc.pc = []\n  // what is learnt in here is about position `j`, so it stays inside\n  counts := smt.pred_counts(vc)\n  memo := vc.memo\n  cutoffs := vc.cutoffs\n  indexing := vc.indexing\n  vc.indexing = Some([j])\n  vc.binding += 1\n  vc.spec += 1\n  p := match smt.element_at(mut vc, id, j, inside) {\n    Some(x) => {\n      // known of every element: what it needs known, never proven\n      pol := vc.polarity\n      vc.polarity = 1\n      pv := smt.apply(mut vc, f, x)\n      vc.polarity = pol\n      Some(smt.as_bool(mut vc, pv))\n    },\n    None => None,\n  }\n  vc.spec -= 1\n  vc.binding -= 1\n  vc.indexing = indexing\n  vc.pc = pc\n  (nd, nf) := smt.leave(mut vc)\n  vc.memo = memo\n  vc.cutoffs = cutoffs\n  smt.cut_preds(mut vc, counts)\n  vc.matched = take(vc.matched, nm)\n  known := drop(vc.facts, nf)\n  vc.facts = take(vc.facts, nf)\n  body := p?\n  if smt.free_constant(vc, nd) {\n    return None\n  }\n  Some(\n    f\"(forall (({j} Int)) (=> {inside} {smt.and_all(known + [body])}))\",\n  )\n}","old_text":"/// `f` of the element at every position of list `id` (of length `len`), as\n/// one quantified fact, so that it reaches the elements the code takes by\n/// position. `None` when `f` of an element made unknowns of its own.\nfn forall_positions(\n  mut vc: smt.Vc,\n  id: Int,\n  ln: String,\n  f: smt.Func,\n) -> Option[String] {\n  if !smt.positional(vc, id) {\n    return None\n  }\n  vc.qvars += 1\n  j := f\"q{vc.qvars}\"\n  smt.enter(mut vc)\n  nm := len(vc.matched)\n  inside := f\"(and (<= 0 {j}) (< {j} {ln}))\"\n  pc := vc.pc\n  vc.pc = []\n  // what is learnt in here is about position `j`: it stays inside\n  counts := smt.pred_counts(vc)\n  memo := vc.memo\n  cutoffs := vc.cutoffs\n  indexing := vc.indexing\n  vc.indexing = Some([j])\n  vc.binding += 1\n  vc.spec += 1\n  p := match smt.element_at(mut vc, id, j, inside) {\n    Some(x) => {\n      // known of every element: what it needs known, never proven\n      pol := vc.polarity\n      vc.polarity = 1\n      pv := smt.apply(mut vc, f, x)\n      vc.polarity = pol\n      Some(smt.as_bool(mut vc, pv))\n    },\n    None => None,\n  }\n  vc.spec -= 1\n  vc.binding -= 1\n  vc.indexing = indexing\n  vc.pc = pc\n  (nd, nf) := smt.leave(mut vc)\n  vc.memo = memo\n  vc.cutoffs = cutoffs\n  smt.cut_preds(mut vc, counts)\n  vc.matched = take(vc.matched, nm)\n  known := drop(vc.facts, nf)\n  vc.facts = take(vc.facts, nf)\n  body := p?\n  if smt.free_constant(vc, nd) {\n    return None\n  }\n  Some(\n    f\"(forall (({j} Int)) (=> {inside} {smt.and_all(known + [body])}))\",\n  )\n}"},{"name":"smt.know_all","kind":"fn","old":"19ba0dd6114417a4","new":"b9e54fcfd28b9dc0","interface_changed":false,"affected":[],"module":"smt","text":"/// From here on, `f` holds for every element of list `id` when `guard`\n/// does, both for the elements made so far and those made later.\nfn know_all(mut vc: smt.Vc, id: Int, guard: String, f: smt.Func) {\n  for (exists, x) in smt.list_info(vc, id).seen {\n    pol := vc.polarity\n    vc.polarity = 1\n    pv := smt.apply(mut vc, f, x)\n    vc.polarity = pol\n    p := smt.as_bool(mut vc, pv)\n    mut vc.facts.push(smt.implies(smt.and_all([exists, guard]), p))\n  }\n  info := smt.list_info(vc, id)\n  smt.set_list(\n    mut vc,\n    id,\n    smt.ListInfo { ..info, preds: info.preds + [(guard, f)] },\n  )\n}","old_text":"/// From now on, `f` holds for every element of list `id` when `guard`\n/// does: for the elements made so far, and for every one made later.\nfn know_all(mut vc: smt.Vc, id: Int, guard: String, f: smt.Func) {\n  for (exists, x) in smt.list_info(vc, id).seen {\n    pol := vc.polarity\n    vc.polarity = 1\n    pv := smt.apply(mut vc, f, x)\n    vc.polarity = pol\n    p := smt.as_bool(mut vc, pv)\n    mut vc.facts.push(smt.implies(smt.and_all([exists, guard]), p))\n  }\n  info := smt.list_info(vc, id)\n  smt.set_list(\n    mut vc,\n    id,\n    smt.ListInfo { ..info, preds: info.preds + [(guard, f)] },\n  )\n}"},{"name":"smt.every","kind":"fn","old":"240b60a7b0b2ece7","new":"486d98b5e03c8548","interface_changed":false,"affected":[],"module":"smt","text":"/// \"Every element of the list satisfies `f`\" as a formula: it holds for any\n/// value made the way the list's elements are. `f == None` means \"is a\n/// non-negative Int\", for `sum`. `None` when it gives up on the element.\n/// The flag says whether the element was an Int (for `sum`).\nfn every(\n  mut vc: smt.Vc,\n  id: Int,\n  ln: String,\n  f: Option[smt.Func],\n) -> (Option[String], Bool) {\n  smt.enter(mut vc)\n  nm := len(vc.matched)\n  indexing := vc.indexing\n  vc.indexing = None\n  vc.binding += 1\n  vc.spec += 1\n  // by position when the list has positions, so facts about positions reach it\n  x := if smt.positional(vc, id) {\n    k := smt.fresh(mut vc, \"Int\")\n    inside := f\"(and (<= 0 {k}) (< {k} {ln}))\"\n    smt.assume(mut vc, inside)\n    smt.element_at(mut vc, id, k, inside) ?? smt.Opaque(\"an element\")\n  } else {\n    smt.element(mut vc, id, \"true\")\n  }\n  mut ints := true\n  p := match f {\n    Some(g) => {\n      // proven of the element: what it needs proven, never known\n      pol := vc.polarity\n      vc.polarity = -1\n      pv := smt.apply(mut vc, g, x)\n      vc.polarity = pol\n      Some(smt.as_bool(mut vc, pv))\n    },\n    None => match x {\n      smt.VInt(t) => Some(f\"(>= {t} 0)\"),\n      _ => {\n        ints = false\n        None\n      },\n    },\n  }\n  vc.spec -= 1\n  vc.binding -= 1\n  vc.indexing = indexing\n  (nd, nf) := smt.leave(mut vc)\n  vc.matched = take(vc.matched, nm)\n  ant := smt.and_all(drop(vc.facts, nf))\n  vc.facts = take(vc.facts, nf)\n  match p {\n    None => (None, ints),\n    Some(q) => {\n      body := smt.implies(ant, q)\n      // outside any scope, the element is a witness constant instead of a\n      // bound variable: every caller uses the formula only as a premise\n      if len(vc.regions) == 0\n        && vc.indexing == None\n        && !contains(body, \"@@\") {\n        return (Some(body), ints)\n      }\n      made := drop(vc.consts, nd).filter(c -> c.args == 0)\n      for c in made {\n        mut vc.bound.insert(c.name)\n      }\n      (Some(if len(made) == 0 {\n        body\n      } else {\n        \"(forall (\"\n          + join(\n            made.map(c -> \"(\" + c.name + \" \" + c.sort + \")\"),\n            \" \",\n          )\n          + \") \"\n          + body\n          + \")\"\n      }), ints)\n    },\n  }\n}","old_text":"/// \"Every element of the list satisfies `f`\" (`None`: \"is a non-negative\n/// Int\", for `sum`), as a formula: for any value made the way the list's\n/// elements are, it holds. `None` when it gives up on the element; the\n/// flag says whether the element was an Int (for `sum`).\nfn every(\n  mut vc: smt.Vc,\n  id: Int,\n  ln: String,\n  f: Option[smt.Func],\n) -> (Option[String], Bool) {\n  smt.enter(mut vc)\n  nm := len(vc.matched)\n  indexing := vc.indexing\n  vc.indexing = None\n  vc.binding += 1\n  vc.spec += 1\n  // by position when the list has them, so that facts about positions reach it\n  x := if smt.positional(vc, id) {\n    k := smt.fresh(mut vc, \"Int\")\n    inside := f\"(and (<= 0 {k}) (< {k} {ln}))\"\n    smt.assume(mut vc, inside)\n    smt.element_at(mut vc, id, k, inside) ?? smt.Opaque(\"an element\")\n  } else {\n    smt.element(mut vc, id, \"true\")\n  }\n  mut ints := true\n  p := match f {\n    Some(g) => {\n      // proven of the element: what it needs proven, never known\n      pol := vc.polarity\n      vc.polarity = -1\n      pv := smt.apply(mut vc, g, x)\n      vc.polarity = pol\n      Some(smt.as_bool(mut vc, pv))\n    },\n    None => match x {\n      smt.VInt(t) => Some(f\"(>= {t} 0)\"),\n      _ => {\n        ints = false\n        None\n      },\n    },\n  }\n  vc.spec -= 1\n  vc.binding -= 1\n  vc.indexing = indexing\n  (nd, nf) := smt.leave(mut vc)\n  vc.matched = take(vc.matched, nm)\n  ant := smt.and_all(drop(vc.facts, nf))\n  vc.facts = take(vc.facts, nf)\n  match p {\n    None => (None, ints),\n    Some(q) => {\n      body := smt.implies(ant, q)\n      // outside any scope, the element is a witness constant rather than\n      // a bound variable: every caller uses the formula only as a premise\n      if len(vc.regions) == 0\n        && vc.indexing == None\n        && !contains(body, \"@@\") {\n        return (Some(body), ints)\n      }\n      made := drop(vc.consts, nd).filter(c -> c.args == 0)\n      for c in made {\n        mut vc.bound.insert(c.name)\n      }\n      (Some(if len(made) == 0 {\n        body\n      } else {\n        \"(forall (\"\n          + join(\n            made.map(c -> \"(\" + c.name + \" \" + c.sort + \")\"),\n            \" \",\n          )\n          + \") \"\n          + body\n          + \")\"\n      }), ints)\n    },\n  }\n}"},{"name":"smt.all_of","kind":"fn","old":"6ee18181eb6f13b5","new":"34b42202ed3352e0","interface_changed":false,"affected":[],"module":"smt","text":"/// `all(list, f)`: a Bool that is true when every element satisfies `f`\n/// (proven through `every`). Once known, it gives `f` to every element the\n/// code looks at (for a dict's entries: at every key it reads).\nfn all_of(mut vc: smt.Vc, list: smt.Val, f: smt.Func, pol: Int) -> String {\n  id := smt.list_id(mut vc, list)\n  len := smt.list_len(mut vc, list)\n  b := smt.fresh(mut vc, \"Bool\")\n  mut vc.facts.push(f\"(=> (= {len} 0) {b})\")\n  // polarity (`Vc.polarity`): a Bool only ever proven needs only what\n  // proves it, one only ever known only what it gives\n  if pol <= 0 {\n    match smt.every(mut vc, id, len, Some(f)).0 {\n      Some(q) => mut vc.facts.push(smt.implies(q, b)),\n      None => (),\n    }\n  }\n  if pol >= 0 {\n    match smt.forall_positions(mut vc, id, len, f) {\n      Some(q) => mut vc.facts.push(smt.implies(b, q)),\n      None => (),\n    }\n    smt.know_all(mut vc, id, b, f)\n    smt.know_map_all(mut vc, id, b, f)\n  }\n  b\n}","old_text":"/// `all(list, f)`: a Bool that is true when every element satisfies `f`\n/// (proven through `every`), and that, once known, gives `f` to every\n/// element the code looks at (a dict's entries: at every key it reads).\nfn all_of(mut vc: smt.Vc, list: smt.Val, f: smt.Func, pol: Int) -> String {\n  id := smt.list_id(mut vc, list)\n  len := smt.list_len(mut vc, list)\n  b := smt.fresh(mut vc, \"Bool\")\n  mut vc.facts.push(f\"(=> (= {len} 0) {b})\")\n  // polarity (`Vc.polarity`): a Bool only ever proven needs only what\n  // proves it, one only ever known only what it gives\n  if pol <= 0 {\n    match smt.every(mut vc, id, len, Some(f)).0 {\n      Some(q) => mut vc.facts.push(smt.implies(q, b)),\n      None => (),\n    }\n  }\n  if pol >= 0 {\n    match smt.forall_positions(mut vc, id, len, f) {\n      Some(q) => mut vc.facts.push(smt.implies(b, q)),\n      None => (),\n    }\n    smt.know_all(mut vc, id, b, f)\n    smt.know_map_all(mut vc, id, b, f)\n  }\n  b\n}"},{"name":"smt.is_fn","kind":"fn","old":"f58d3e012684f634","new":"a20235d3255b4827","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether `e` is a function value (a lambda, or the name of a function).\nfn is_fn(vc: smt.Vc, e: ast.Expr) -> Bool {\n  match e {\n    ast.Lambda { .. } => true,\n    ast.Var(x) => smt.lookup(vc, x) == None\n      && (contains(vc.fns, x)\n        || smt.method_decls(vc, x).0 != []\n        || smt.method_decls(vc, x).1),\n    _ => false,\n  }\n}","old_text":"/// Is `e` a function value (a lambda, or the name of a function)?\nfn is_fn(vc: smt.Vc, e: ast.Expr) -> Bool {\n  match e {\n    ast.Lambda { .. } => true,\n    ast.Var(x) => smt.lookup(vc, x) == None\n      && (contains(vc.fns, x)\n        || smt.method_decls(vc, x).0 != []\n        || smt.method_decls(vc, x).1),\n    _ => false,\n  }\n}"},{"name":"smt.func_of","kind":"fn","old":"8a494db9efba6195","new":"7b9a3ad2dcce8d8c","interface_changed":false,"affected":[],"module":"smt","text":"/// The function an argument expression denotes, if it can be kept. A\n/// lambda of several parameters takes one tuple matched against their\n/// pattern (`(id, e) -> …` over a dict's entries).\nfn func_of(vc: smt.Vc, e: ast.Expr) -> Option[smt.Func] {\n  match e {\n    ast.Lambda { params, body } => match params {\n      [p] => Some(smt.FLambda { param: p.name, body, scopes: vc.scopes }),\n      [] => None,\n      _ => Some(smt.FLambda { param: \"$tuple\", body: ast.MatchExpr {\n        scrutinee: ast.Var(\"$tuple\"),\n        binding: None,\n        arms: [ast.Arm { comments: [], pat: ast.TuplePat(params.map(\n          p -> if p.name == \"_\" {\n            ast.Wild\n          } else {\n            ast.Bind(p.name)\n          },\n        )), body }],\n      }, scopes: vc.scopes }),\n    },\n    ast.Var(n) => if smt.is_fn(vc, e) {\n      Some(smt.FNamed(n))\n    } else {\n      None\n    },\n    _ => None,\n  }\n}","old_text":"/// The function an argument expression denotes, if it can be kept. A\n/// lambda of several parameters takes a tuple (`(id, e) -> …` over a\n/// dict's entries): one parameter, matched against their pattern.\nfn func_of(vc: smt.Vc, e: ast.Expr) -> Option[smt.Func] {\n  match e {\n    ast.Lambda { params, body } => match params {\n      [p] => Some(smt.FLambda { param: p.name, body, scopes: vc.scopes }),\n      [] => None,\n      _ => Some(smt.FLambda { param: \"$tuple\", body: ast.MatchExpr {\n        scrutinee: ast.Var(\"$tuple\"),\n        binding: None,\n        arms: [ast.Arm { comments: [], pat: ast.TuplePat(params.map(\n          p -> if p.name == \"_\" {\n            ast.Wild\n          } else {\n            ast.Bind(p.name)\n          },\n        )), body }],\n      }, scopes: vc.scopes }),\n    },\n    ast.Var(n) => if smt.is_fn(vc, e) {\n      Some(smt.FNamed(n))\n    } else {\n      None\n    },\n    _ => None,\n  }\n}"},{"name":"smt.fn_value","kind":"fn","old":"4def5cab81414fa8","new":"6d8bf93a9d6e87dd","interface_changed":false,"affected":[],"module":"smt","text":"/// A function passed as an argument, run on `args` (its checks hold on\n/// every call): its value (not modelled), and its result.\nfn fn_value(\n  mut vc: smt.Vc,\n  e: ast.Expr,\n  args: List[smt.Val],\n) -> (smt.Val, smt.Val) {\n  unknown := \"the arguments of a function value are not known\"\n  match e {\n    ast.Lambda { params, body } => {\n      mut vals := []\n      for (i, p) in enumerate(params) {\n        v := match (get(args, i), p.ty) {\n          (Some(v), _) => v,\n          (None, Some(t)) => {\n            old := vc.reason\n            vc.reason = Some(unknown)\n            sv := smt.shape(mut vc, t)\n            vc.reason = old\n            sv\n          },\n          (None, None) => smt.Opaque(unknown),\n        }\n        mut vals.push((p.name, v))\n      }\n      mut vc.scopes.push(dict(vals))\n      returns := vc.returns\n      vc.returns = []\n      dead := vc.dead\n      r := smt.eval(mut vc, body)\n      vc.returns = returns\n      vc.dead = dead\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      (smt.Opaque(\"function values are not modelled\"), r)\n    },\n    ast.Var(name) => match get(vc.fns, name) {\n      Some(f) => {\n        mut given := []\n        for i in 0..len(f.params) {\n          mut given.push(get(args, i) ?? smt.Opaque(unknown))\n        }\n        r := smt.call_contract(mut vc, name, f, given)\n        (smt.Opaque(\"function values are not modelled\"), r)\n      },\n      None => (\n        smt.Opaque(f\"`{name}` used as a value\"),\n        smt.Opaque(f\"`{name}`\"),\n      ),\n    },\n    _ => (\n      smt.Opaque(\"function values are not modelled\"),\n      smt.Opaque(\"calling a function value\"),\n    ),\n  }\n}","old_text":"/// A function passed as an argument, run on `args` (its checks hold on\n/// every call): its value (not modelled), and what it gives.\nfn fn_value(\n  mut vc: smt.Vc,\n  e: ast.Expr,\n  args: List[smt.Val],\n) -> (smt.Val, smt.Val) {\n  unknown := \"the arguments of a function value are not known\"\n  match e {\n    ast.Lambda { params, body } => {\n      mut vals := []\n      for (i, p) in enumerate(params) {\n        v := match (get(args, i), p.ty) {\n          (Some(v), _) => v,\n          (None, Some(t)) => {\n            old := vc.reason\n            vc.reason = Some(unknown)\n            sv := smt.shape(mut vc, t)\n            vc.reason = old\n            sv\n          },\n          (None, None) => smt.Opaque(unknown),\n        }\n        mut vals.push((p.name, v))\n      }\n      mut vc.scopes.push(dict(vals))\n      returns := vc.returns\n      vc.returns = []\n      dead := vc.dead\n      r := smt.eval(mut vc, body)\n      vc.returns = returns\n      vc.dead = dead\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      (smt.Opaque(\"function values are not modelled\"), r)\n    },\n    ast.Var(name) => match get(vc.fns, name) {\n      Some(f) => {\n        mut given := []\n        for i in 0..len(f.params) {\n          mut given.push(get(args, i) ?? smt.Opaque(unknown))\n        }\n        r := smt.call_contract(mut vc, name, f, given)\n        (smt.Opaque(\"function values are not modelled\"), r)\n      },\n      None => (\n        smt.Opaque(f\"`{name}` used as a value\"),\n        smt.Opaque(f\"`{name}`\"),\n      ),\n    },\n    _ => (\n      smt.Opaque(\"function values are not modelled\"),\n      smt.Opaque(\"calling a function value\"),\n    ),\n  }\n}"},{"name":"smt.var_names","kind":"fn","old":"0afe29657669d99c","new":"4ff8c095b3aeee9e","interface_changed":false,"affected":[],"module":"smt","text":"/// The variables an expression reads, each once, in order.\nfn var_names(e: ast.Expr) -> List[String] {\n  mut out := Set[String] {}\n  mut todo := [e]\n  while len(todo) > 0 {\n    x := get(todo, len(todo) - 1) ?? ast.UnitExpr\n    todo = take(todo, len(todo) - 1)\n    match x {\n      ast.Var(n) => mut out.insert(n),\n      _ => (),\n    }\n    todo += walk.kids(x)\n  }\n  to_list(out)\n}","old_text":"/// The names an expression reads (variables), each once, in order.\nfn var_names(e: ast.Expr) -> List[String] {\n  mut out := Set[String] {}\n  mut todo := [e]\n  while len(todo) > 0 {\n    x := get(todo, len(todo) - 1) ?? ast.UnitExpr\n    todo = take(todo, len(todo) - 1)\n    match x {\n      ast.Var(n) => mut out.insert(n),\n      _ => (),\n    }\n    todo += walk.kids(x)\n  }\n  to_list(out)\n}"},{"name":"smt.string_unit","kind":"fn","old":"c37f02d7ad29e680","new":"106f546ce9e12105","interface_changed":false,"affected":[],"module":"smt","text":"/// `len(s.code_points())` or `len(s.bytes())`: the unit and the string.\nfn string_unit(e: ast.Expr) -> Option[(String, ast.Expr)] {\n  (name, recv) := match e {\n    ast.MethodCall { recv, name, args } => if len(args) == 0 {\n      (name, recv)\n    } else {\n      return None\n    },\n    ast.Call { callee, args } => match (callee, get(args, 0)) {\n      (ast.Var(n), Some(x)) => if len(args) == 1 {\n        (n, x)\n      } else {\n        return None\n      },\n      _ => return None,\n    },\n    _ => return None,\n  }\n  short := match split(name, \".\") {\n    [] => name,\n    parts => get(parts, len(parts) - 1) ?? name,\n  }\n  if short == \"code_points\" || short == \"bytes\" {\n    Some((short, recv))\n  } else {\n    None\n  }\n}","old_text":"/// `len(s.code_points())` / `len(s.bytes())`: the unit and the string.\nfn string_unit(e: ast.Expr) -> Option[(String, ast.Expr)] {\n  (name, recv) := match e {\n    ast.MethodCall { recv, name, args } => if len(args) == 0 {\n      (name, recv)\n    } else {\n      return None\n    },\n    ast.Call { callee, args } => match (callee, get(args, 0)) {\n      (ast.Var(n), Some(x)) => if len(args) == 1 {\n        (n, x)\n      } else {\n        return None\n      },\n      _ => return None,\n    },\n    _ => return None,\n  }\n  short := match split(name, \".\") {\n    [] => name,\n    parts => get(parts, len(parts) - 1) ?? name,\n  }\n  if short == \"code_points\" || short == \"bytes\" {\n    Some((short, recv))\n  } else {\n    None\n  }\n}"},{"name":"smt.ascii","kind":"fn","old":"e3d7f2997d0004e8","new":"0a705e21590a23b5","interface_changed":false,"affected":[],"module":"smt","text":"// ---- builtins ----\n\n/// \"`s` is ASCII\".\nfn ascii(s: String) -> String {\n  \"(str.in_re \" + s + \" (re.* (re.range \\\"\\u{0}\\\" \\\"\\u{7f}\\\")))\"\n}","old_text":"// ---- builtins ----\n\n/// A string is ASCII.\nfn ascii(s: String) -> String {\n  \"(str.in_re \" + s + \" (re.* (re.range \\\"\\u{0}\\\" \\\"\\u{7f}\\\")))\"\n}"},{"name":"smt.option","kind":"fn","old":"b6095f26c83e8d9e","new":"d7434111af8a1e9b","interface_changed":false,"affected":[],"module":"smt","text":"/// `Some(payload)` when `some` holds, else `None`, as an `Option[t]`.\nfn option(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  some: String,\n  payload: smt.Val,\n) -> smt.Val {\n  vs := smt.variants_of(vc, \"Option\", [t]) ?? []\n  mut ks := -1\n  mut kn := -1\n  for (k, v) in enumerate(vs) {\n    if v.name == \"Some\" {\n      ks = k\n    }\n    if v.name == \"None\" {\n      kn = k\n    }\n  }\n  if ks < 0 || kn < 0 {\n    return smt.Opaque(\"`Option` is not the prelude's\")\n  }\n  smt.VSum {\n    ty: \"Option\",\n    args: [t],\n    tag: smt.ite(some, f\"{ks}\", f\"{kn}\"),\n    ctors: vs.map(\n      v -> (v.name, if v.name == \"Some\" {\n        [payload]\n      } else {\n        []\n      }),\n    ),\n  }\n}","old_text":"/// `Some(payload)` when `some` holds, else `None` (an `Option[t]`).\nfn option(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  some: String,\n  payload: smt.Val,\n) -> smt.Val {\n  vs := smt.variants_of(vc, \"Option\", [t]) ?? []\n  mut ks := -1\n  mut kn := -1\n  for (k, v) in enumerate(vs) {\n    if v.name == \"Some\" {\n      ks = k\n    }\n    if v.name == \"None\" {\n      kn = k\n    }\n  }\n  if ks < 0 || kn < 0 {\n    return smt.Opaque(\"`Option` is not the prelude's\")\n  }\n  smt.VSum {\n    ty: \"Option\",\n    args: [t],\n    tag: smt.ite(some, f\"{ks}\", f\"{kn}\"),\n    ctors: vs.map(\n      v -> (v.name, if v.name == \"Some\" {\n        [payload]\n      } else {\n        []\n      }),\n    ),\n  }\n}"},{"name":"smt.one_char","kind":"fn","old":"26833bdbf1bfc07a","new":"8a8582c1359da0fb","interface_changed":false,"affected":[],"module":"smt","text":"/// `String where len(it) == 1`, the elements of `chars`.\nfn one_char() -> ast.TypeExpr {\n  ast.Refined { base: smt.named(\"String\"), pred: ast.Binary {\n    op: ast.Equal,\n    left: ast.Call { callee: ast.Var(\"len\"), args: [ast.Var(\"it\")] },\n    right: ast.IntLit(1),\n  } }\n}","old_text":"/// `String where len(it) == 1` (`chars`' elements).\nfn one_char() -> ast.TypeExpr {\n  ast.Refined { base: smt.named(\"String\"), pred: ast.Binary {\n    op: ast.Equal,\n    left: ast.Call { callee: ast.Var(\"len\"), args: [ast.Var(\"it\")] },\n    right: ast.IntLit(1),\n  } }\n}"},{"name":"smt.builtin","kind":"fn","old":"a2af094762f8c18f","new":"90caff46ae248164","interface_changed":false,"affected":[],"module":"smt","text":"fn builtin(\n  mut vc: smt.Vc,\n  given: String,\n  arg_exprs: List[ast.Expr],\n  a: List[smt.Val],\n) -> smt.Val {\n  pol := vc.call_pol\n  vc.call_pol = 0\n  // `xs.sorted()` is the builtin `sort`, returning a new list\n  name := builtins.internal_name(given)\n  arg := (i: Int) -> get(a, i) ?? smt.Opaque(\"a missing argument\")\n  not_modelled := f\"`{name}` is not modelled\"\n  smt.builtin_faults(mut vc, name, a)\n  n := len(a)\n  // dicts and sets: their arrays\n  match smt.map_op(mut vc, name, a) {\n    Some(v) => return v,\n    None => (),\n  }\n  if (name == \"set\" || name == \"dict\") && n == 1 {\n    match smt.map_literal(mut vc, name, get(arg_exprs, 0), arg(0)) {\n      Some(v) => return v,\n      None => (),\n    }\n  }\n  // sized integers: `to_int` is the integer; `to_u8` must fit, `wrap_u8`\n  // wraps\n  if name == \"to_int\" && n == 1 && smt.word_of(arg(0)) != None {\n    return smt.VInt(smt.as_int(mut vc, arg(0)))\n  }\n  match (smt.conversion(name), n) {\n    (Some((w, wraps)), 1) => {\n      x := smt.as_int(mut vc, arg(0))\n      if wraps {\n        return smt.word(w, smt.wrap_term(w, x))\n      }\n      if smt.start_goal(mut vc) {\n        smt.oblige(\n          mut vc,\n          f\"`{name}` of an Int that fits in `{w}`\",\n          smt.word_range(w, x),\n        )\n      }\n      return smt.word(w, x)\n    },\n    _ => (),\n  }\n  if (name == \"len\" || name == \"str_len\") && n == 1 {\n    return match arg(0) {\n      smt.VStr(s) => smt.VInt(f\"(str.len {s})\"),\n      v => smt.VInt(smt.list_len(mut vc, v)),\n    }\n  }\n  if name == \"abs\" && n == 1 {\n    return match arg(0) {\n      smt.VInt(x) => smt.VInt(f\"(ite (< {x} 0) (- {x}) {x})\"),\n      smt.VUnion { .. } => smt.Opaque(not_modelled),\n      v => v,\n    }\n  }\n  if (name == \"min\" || name == \"max\") && n == 2 {\n    x0 := arg(0)\n    y0 := arg(1)\n    if !smt.is_int(x0) && !smt.is_int(y0) {\n      return smt.Opaque(not_modelled)\n    }\n    x := smt.as_int(mut vc, x0)\n    y := smt.as_int(mut vc, y0)\n    op := if name == \"min\" {\n      \"<=\"\n    } else {\n      \">=\"\n    }\n    return smt.VInt(f\"(ite ({op} {x} {y}) {x} {y})\")\n  }\n  if name == \"matches\" && n == 2 {\n    s := smt.as_str(mut vc, arg(0))\n    return smt.VBool(match get(arg_exprs, 1) {\n      Some(ast.StrLit(re)) => smt.regex_match(mut vc, s, re),\n      _ => smt.unknown_bool(\n        mut vc,\n        \"`matches` with a pattern that is not a literal\",\n      ),\n    })\n  }\n  if name == \"starts_with\" && n == 2 {\n    s := smt.as_str(mut vc, arg(0))\n    p := smt.as_str(mut vc, arg(1))\n    return smt.VBool(f\"(str.prefixof {p} {s})\")\n  }\n  if name == \"contains\" && n == 2 && smt.is_str(arg(0)) {\n    s := smt.as_str(mut vc, arg(0))\n    p := smt.as_str(mut vc, arg(1))\n    return smt.VBool(f\"(str.contains {s} {p})\")\n  }\n  // an element of a list (not of a dict or set): some element equals it\n  if name == \"contains\" && n == 2 && smt.is_list(arg(0)) {\n    match arg(0) {\n      smt.VList { id, .. } => if !contains(vc.keyed, id) {\n        return smt.VBool(smt.neg(smt.all_of(\n          mut vc,\n          arg(0),\n          smt.FNot(smt.member_of(vc, arg(1))),\n          0 - pol,\n        )))\n      },\n      _ => (),\n    }\n  }\n  // the values' order: exact on integers, else -1, 0 or 1\n  if name == \"compare\" && n == 2 {\n    if smt.is_int(arg(0)) && smt.is_int(arg(1)) {\n      x := smt.as_int(mut vc, arg(0))\n      y := smt.as_int(mut vc, arg(1))\n      return smt.VInt(f\"(ite (< {x} {y}) (- 1) (ite (= {x} {y}) 0 1))\")\n    }\n    c := smt.fresh_why(\n      mut vc,\n      \"Int\",\n      \"`compare` (only on integers is the order modelled)\",\n    )\n    mut vc.facts.push(f\"(and (<= (- 1) {c}) (<= {c} 1))\")\n    return smt.VInt(c)\n  }\n  if name == \"push\" && n == 2 {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    // the list's elements, then the new one\n    one := smt.new_list(mut vc, \"1\", smt.GValues([arg(1)]))\n    oid := smt.list_id(mut vc, one)\n    return smt.new_list(mut vc, f\"(+ {l} 1)\", smt.GConcat(id, oid, l))\n  }\n  if (name == \"take\" || name == \"drop\") && n == 2 {\n    l := smt.list_len(mut vc, arg(0))\n    k0 := smt.as_int(mut vc, arg(1))\n    k := f\"(ite (< {k0} 0) 0 (ite (< {k0} {l}) {k0} {l}))\"\n    id := smt.list_id(mut vc, arg(0))\n    return if name == \"take\" {\n      smt.new_list(mut vc, k, smt.GShift(id, \"0\"))\n    } else {\n      smt.new_list(mut vc, f\"(- {l} {k})\", smt.GShift(id, k))\n    }\n  }\n  // elements start..end of a list, both clamped to 0..len\n  if name == \"slice\" && n == 3 && smt.is_list(arg(0)) {\n    l := smt.list_len(mut vc, arg(0))\n    a0 := smt.as_int(mut vc, arg(1))\n    b0 := smt.as_int(mut vc, arg(2))\n    ca := f\"(ite (< {a0} 0) 0 (ite (> {a0} {l}) {l} {a0}))\"\n    cb := f\"(ite (< {b0} 0) 0 (ite (> {b0} {l}) {l} {b0}))\"\n    id := smt.list_id(mut vc, arg(0))\n    return smt.new_list(\n      mut vc,\n      f\"(ite (< {ca} {cb}) (- {cb} {ca}) 0)\",\n      smt.GShift(id, ca),\n    )\n  }\n  if name == \"reverse\" && !smt.is_str(arg(0)) {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    return smt.new_list(mut vc, l, smt.GRev(id, l))\n  }\n  if (name == \"sort\" || name == \"sort_by\") && !smt.is_str(arg(0)) {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    return smt.new_list(mut vc, l, smt.GSub(id))\n  }\n  if name == \"map\" && n == 2 {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    g := match smt.fn_arg(vc, 1) {\n      Some(f) => smt.GMap(id, f),\n      None => smt.Untracked,\n    }\n    return smt.new_list(mut vc, l, g)\n  }\n  if name == \"enumerate\" {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    return smt.new_list(mut vc, l, smt.GEnum(id, l))\n  }\n  if name == \"filter\" && n == 2 {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    k := smt.fresh_why(\n      mut vc,\n      \"Int\",\n      \"`filter` (only the length bound is modelled)\",\n    )\n    mut vc.facts.push(f\"(and (<= 0 {k}) (<= {k} {l}))\")\n    g := match smt.fn_arg(vc, 1) {\n      Some(f) => {\n        // empty: no element passes (`GFilter` describes the elements of a\n        // non-empty one)\n        none := smt.all_of(mut vc, arg(0), smt.FNot(f), 1)\n        mut vc.facts.push(f\"(=> (= {k} 0) {none})\")\n        smt.GFilter(id, f)\n      },\n      None => smt.GSub(id),\n    }\n    return smt.new_list(mut vc, k, g)\n  }\n  if name == \"find\"\n    && n == 2\n    && smt.is_list(arg(0))\n    && smt.fn_arg(vc, 1) != None {\n    // `Some(x)`: an element of the list that satisfies the function\n    f := smt.fn_arg(vc, 1) ?? smt.FValid(ast.UnitType)\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    found := smt.fresh_why(\n      mut vc,\n      \"Bool\",\n      \"`find` (whether an element is found is not modelled)\",\n    )\n    mut vc.facts.push(f\"(=> (= {l} 0) (not {found}))\")\n    x := smt.element(mut vc, id, found)\n    pn := len(vc.pc)\n    mut vc.pc.push(found)\n    pv := smt.apply(mut vc, f, x)\n    p := smt.as_bool(mut vc, pv)\n    smt.assume(mut vc, p)\n    vc.pc = take(vc.pc, pn)\n    t := smt.elem_type(vc, id) ?? smt.named(\"_\")\n    return smt.option(mut vc, t, found, x)\n  }\n  // `xs[i] = x` (`set_at(xs, i, x)`): the elements before `i`, then `x`,\n  // then those after, so each element is known by its position\n  if name == \"set_at\" && n == 3 {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    i := smt.as_int(mut vc, arg(1))\n    inside := f\"(and (<= 0 {i}) (< {i} {l}))\"\n    if smt.start_goal(mut vc) {\n      smt.oblige(mut vc, \"index in range\", inside)\n    }\n    if !smt.is_list(arg(0)) {\n      return smt.new_list(mut vc, l, smt.Untracked)\n    }\n    front := smt.new_list(mut vc, i, smt.GShift(id, \"0\"))\n    one := smt.new_list(mut vc, \"1\", smt.GValues([arg(2)]))\n    back := smt.new_list(\n      mut vc,\n      f\"(- {l} {i} 1)\",\n      smt.GShift(id, f\"(+ {i} 1)\"),\n    )\n    tail := smt.new_list(mut vc, f\"(- {l} {i})\", smt.GConcat(\n      smt.list_id(mut vc, one),\n      smt.list_id(mut vc, back),\n      \"1\",\n    ))\n    return smt.new_list(mut vc, l, smt.GConcat(\n      smt.list_id(mut vc, front),\n      smt.list_id(mut vc, tail),\n      i,\n    ))\n  }\n  if name == \"at\" && n == 2 && smt.is_list(arg(0)) {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    i := smt.as_int(mut vc, arg(1))\n    inside := f\"(and (<= 0 {i}) (< {i} {l}))\"\n    if smt.start_goal(mut vc) {\n      smt.oblige(mut vc, \"index in range\", inside)\n    }\n    return smt.element_at(mut vc, id, i, inside) ?? smt.element(mut vc, id, inside)\n  }\n  if name == \"at\" && n == 2 && smt.is_str(arg(0)) {\n    s := smt.as_str(mut vc, arg(0))\n    i := smt.as_int(mut vc, arg(1))\n    if smt.start_goal(mut vc) {\n      smt.oblige(\n        mut vc,\n        \"index in range\",\n        f\"(and (<= 0 {i}) (< {i} (str.len {s})))\",\n      )\n    }\n    return smt.VStr(f\"(str.at {s} {i})\")\n  }\n  // an index into a list of another shape: checked against its length all\n  // the same\n  if name == \"at\" && n == 2 {\n    l := smt.list_len(mut vc, arg(0))\n    i := smt.as_int(mut vc, arg(1))\n    if smt.start_goal(mut vc) {\n      smt.oblige(\n        mut vc,\n        \"index in range\",\n        f\"(and (<= 0 {i}) (< {i} {l}))\",\n      )\n    }\n    return smt.Opaque(not_modelled)\n  }\n  if name == \"get\" && n == 2 && smt.is_list(arg(0)) {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    i := smt.as_int(mut vc, arg(1))\n    inside := f\"(and (<= 0 {i}) (< {i} {l}))\"\n    x := smt.element_at(mut vc, id, i, inside) ?? smt.element(mut vc, id, inside)\n    t := smt.elem_type(vc, id) ?? smt.named(\"_\")\n    return smt.option(mut vc, t, inside, x)\n  }\n  if name == \"count\" && n == 2 {\n    l := smt.list_len(mut vc, arg(0))\n    k := smt.fresh_why(\n      mut vc,\n      \"Int\",\n      \"`count` (only the bounds are modelled)\",\n    )\n    mut vc.facts.push(f\"(and (<= 0 {k}) (<= {k} {l}))\")\n    return smt.VInt(k)\n  }\n  if name == \"zip\" && n == 2 {\n    x := smt.list_len(mut vc, arg(0))\n    y := smt.list_len(mut vc, arg(1))\n    l := f\"(ite (<= {x} {y}) {x} {y})\"\n    a := smt.list_id(mut vc, arg(0))\n    b := smt.list_id(mut vc, arg(1))\n    return smt.new_list(mut vc, l, smt.GZip(a, b, l))\n  }\n  if name == \"range\" && n == 2 {\n    lo := smt.as_int(mut vc, arg(0))\n    hi := smt.as_int(mut vc, arg(1))\n    return smt.new_list(\n      mut vc,\n      f\"(ite (> {hi} {lo}) (- {hi} {lo}) 0)\",\n      smt.GRange(lo, hi),\n    )\n  }\n  if name == \"set\" && n == 1 {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    k := smt.fresh_why(\n      mut vc,\n      \"Int\",\n      \"`set` (only its size bounds are modelled)\",\n    )\n    mut vc.facts.push(\n      f\"(and (<= 0 {k}) (<= {k} {l}) (= (= {k} 0) (= {l} 0)))\",\n    )\n    // a set of a list's elements has only elements of the list\n    return smt.new_list(mut vc, k, smt.GSub(id))\n  }\n  if name == \"to_list\" && n == 1 && smt.is_list(arg(0)) {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    return smt.new_list(mut vc, l, smt.GSub(id))\n  }\n  if (name == \"keys\"\n      || name == \"values\"\n      || name == \"items\"\n      || name == \"to_list\")\n    && n == 1 {\n    l := smt.list_len(mut vc, arg(0))\n    return smt.new_list(mut vc, l, smt.Untracked)\n  }\n  if name == \"all\" && n == 2 && smt.fn_arg(vc, 1) != None {\n    return smt.VBool(smt.all_of(\n      mut vc,\n      arg(0),\n      smt.fn_arg(vc, 1) ?? smt.FValid(ast.UnitType),\n      pol,\n    ))\n  }\n  // some element satisfies `f`: not every element fails it\n  if name == \"any\" && n == 2 && smt.fn_arg(vc, 1) != None {\n    return smt.VBool(smt.neg(smt.all_of(\n      mut vc,\n      arg(0),\n      smt.FNot(smt.fn_arg(vc, 1) ?? smt.FValid(ast.UnitType)),\n      0 - pol,\n    )))\n  }\n  if (name == \"all\" || name == \"any\") && n == 2 {\n    // otherwise only the empty case is modelled\n    l := smt.list_len(mut vc, arg(0))\n    b := smt.fresh_why(mut vc, \"Bool\", not_modelled)\n    mut vc.facts.push(\n      f\"(=> (= {l} 0) \"\n        + if name == \"all\" {\n          b\n        } else {\n          smt.neg(b)\n        }\n        + \")\",\n    )\n    return smt.VBool(b)\n  }\n  if name == \"sum\" && n == 1 {\n    // an Int list (a Float list's elements are unknown values): its sum by\n    // its source (`list_sum`)\n    return match smt.list_sum(mut vc, arg(0), None) {\n      Some(t) => smt.VInt(t),\n      None => smt.Opaque(not_modelled),\n    }\n  }\n  // `fold(xs, init, (acc, x) -> acc + e)`: `init` plus the sum of `e` over\n  // the elements\n  if name == \"fold\" && n == 3 {\n    match (arg(1), get(arg_exprs, 2)) {\n      (smt.VInt(init), Some(ast.Lambda { params: [pa, px], body })) => match smt.added_to(body, pa.name) {\n        Some(e) => match smt.list_sum(mut vc, arg(0), Some(\n          smt.FLambda { param: px.name, body: e, scopes: vc.scopes },\n        )) {\n          Some(t) => return smt.VInt(f\"(+ {init} {t})\"),\n          None => (),\n        },\n        None => (),\n      },\n      _ => (),\n    }\n  }\n  if name == \"ends_with\" && n == 2 {\n    s := smt.as_str(mut vc, arg(0))\n    p := smt.as_str(mut vc, arg(1))\n    return smt.VBool(f\"(str.suffixof {p} {s})\")\n  }\n  // string positions are byte offsets, SMT string positions code points.\n  // On an ASCII string they agree; on others only bounds are known.\n  if name == \"byte_len\" && n == 1 {\n    s := smt.as_str(mut vc, arg(0))\n    return smt.VInt(smt.utf8_len(mut vc, s))\n  }\n  // a byte (0 to 255): on an ASCII string, the character's code\n  if name == \"byte_at\" && n == 2 {\n    s := smt.as_str(mut vc, arg(0))\n    i := smt.as_int(mut vc, arg(1))\n    b := smt.fresh_why(\n      mut vc,\n      \"Int\",\n      \"`byte_at` of a string that may not be ASCII\",\n    )\n    mut vc.facts.push(\n      f\"(and (<= 0 {b}) (<= {b} 255) (=> (and {smt.ascii(s)} (<= 0 {i}) (< {i} (str.len {s}))) (= {b} (str.to_code (str.at {s} {i})))))\",\n    )\n    return smt.VInt(b)\n  }\n  if name == \"byte_slice\" && n == 3 {\n    s := smt.as_str(mut vc, arg(0))\n    a0 := smt.as_int(mut vc, arg(1))\n    b0 := smt.as_int(mut vc, arg(2))\n    bn := smt.utf8_len(mut vc, s)\n    ca := f\"(ite (< {a0} 0) 0 (ite (> {a0} {bn}) {bn} {a0}))\"\n    cb := f\"(ite (< {b0} 0) 0 (ite (> {b0} {bn}) {bn} {b0}))\"\n    other := smt.fresh_why(\n      mut vc,\n      \"String\",\n      \"`byte_slice` of a string that may not be ASCII\",\n    )\n    r := f\"(ite {smt.ascii(s)} (str.substr {s} {ca} (- {cb} {ca})) {other})\"\n    rn := smt.utf8_len(mut vc, r)\n    // a >= b: nothing (moving back keeps the order)\n    mut vc.facts.push(f\"(=> (>= {ca} {cb}) (= {r} \\\"\\\"))\")\n    mut vc.facts.push(\n      f\"(and (>= {rn} 0) (<= {rn} {cb}) (<= {rn} (+ (- {cb} {ca}) 3)) (=> {smt.ascii(s)} (= {rn} (ite (< {ca} {cb}) (- {cb} {ca}) 0))))\",\n    )\n    return smt.VStr(r)\n  }\n  if name == \"chars\" && n == 1 {\n    s := smt.as_str(mut vc, arg(0))\n    // each element is one character\n    return smt.new_list(\n      mut vc,\n      f\"(str.len {s})\",\n      smt.GType(smt.one_char()),\n    )\n  }\n  // the first match's byte offset (its code-point offset on an ASCII\n  // string, never less elsewhere). \"\" is found at 0.\n  if name == \"index_of\" && n == 2 {\n    s := smt.as_str(mut vc, arg(0))\n    p := smt.as_str(mut vc, arg(1))\n    i := f\"(str.indexof {s} {p} 0)\"\n    b := smt.fresh_why(\n      mut vc,\n      \"Int\",\n      \"`index_of` in a string that may not be ASCII\",\n    )\n    sn := smt.utf8_len(mut vc, s)\n    pn := smt.utf8_len(mut vc, p)\n    // a match ends inside the string\n    mut vc.facts.push(\n      f\"(and (=> {smt.ascii(s)} (= {b} {i})) (=> (= {i} 0) (= {b} 0)) (=> (>= {i} 0) (and (>= {b} {i}) (<= (+ {b} {pn}) {sn}))))\",\n    )\n    return smt.option(mut vc, smt.named(\"Int\"), f\"(>= {i} 0)\", smt.VInt(b))\n  }\n  // every non-overlapping match, left to right. An empty pattern, found\n  // around every character, is not modelled.\n  if name == \"replace\" && n == 3 {\n    s := smt.as_str(mut vc, arg(0))\n    from := smt.as_str(mut vc, arg(1))\n    to := smt.as_str(mut vc, arg(2))\n    around := smt.fresh_why(\n      mut vc,\n      \"String\",\n      \"`replace` with an empty pattern\",\n    )\n    return smt.VStr(\n      f\"(ite (= {from} \\\"\\\") {around} (str.replace_all {s} {from} {to}))\",\n    )\n  }\n  if name == \"to_string\" && n == 1 {\n    return match arg(0) {\n      smt.VStr(s) => smt.VStr(s),\n      smt.VBool(b) => smt.VStr(f\"(ite {b} \\\"true\\\" \\\"false\\\")\"),\n      // `str.from_int` is \"\" for negative numbers\n      smt.VInt(x) => smt.VStr(\n        f\"(ite (>= {x} 0) (str.from_int {x}) (str.++ \\\"-\\\" (str.from_int (- {x}))))\",\n      ),\n      _ => smt.VStr(smt.fresh_why(mut vc, \"String\", not_modelled)),\n    }\n  }\n  // only the forms whose result is certain: digits, `-` and digits, and\n  // strings without an ASCII digit (never a number)\n  if name == \"parse_int\" && n == 1 {\n    s := smt.as_str(mut vc, arg(0))\n    digits := \"(re.+ (re.range \\\"0\\\" \\\"9\\\"))\"\n    pos := f\"(str.in_re {s} {digits})\"\n    rest := f\"(str.substr {s} 1 (- (str.len {s}) 1))\"\n    negative := f\"(and (str.prefixof \\\"-\\\" {s}) (str.in_re {rest} {digits}))\"\n    none := f\"(not (str.in_re {s} (re.++ re.all (re.range \\\"0\\\" \\\"9\\\") re.all)))\"\n    // true by the definition of `str.to_int`, but Z3 does not find it alone\n    for x in [s, rest] {\n      mut vc.facts.push(\n        f\"(= (>= (str.to_int {x}) 0) (str.in_re {x} {digits}))\",\n      )\n    }\n    k := smt.fresh_why(\n      mut vc,\n      \"Int\",\n      \"`parse_int` of a string with whitespace, `+` or `_`\",\n    )\n    payload := f\"(ite {pos} (str.to_int {s}) (ite {negative} (- (str.to_int {rest})) {k}))\"\n    some := smt.fresh_why(\n      mut vc,\n      \"Bool\",\n      \"`parse_int` of a string with whitespace, `+` or `_`\",\n    )\n    return smt.option(\n      mut vc,\n      smt.named(\"Int\"),\n      f\"(or {pos} {negative} (and (not {none}) {some}))\",\n      smt.VInt(payload),\n    )\n  }\n  if name == \"chr\" && n == 1 && smt.is_int(arg(0)) {\n    x := smt.as_int(mut vc, arg(0))\n    c := smt.fresh_why(\n      mut vc,\n      \"String\",\n      \"`chr` of a code point past U+2FFFF\",\n    )\n    mut vc.facts.push(f\"(= (str.len {c}) 1)\")\n    mut vc.facts.push(\n      f\"(=> (<= {x} {smt.max_char()}) (= {c} (str.from_code {x})))\",\n    )\n    return smt.VStr(c)\n  }\n  if name == \"ord\" && n == 1 {\n    s := smt.as_str(mut vc, arg(0))\n    return smt.VInt(f\"(str.to_code {s})\")\n  }\n  // ASCII digits only, and not empty\n  if name == \"is_digit\" && n == 1 {\n    s := smt.as_str(mut vc, arg(0))\n    return smt.VBool(f\"(str.in_re {s} (re.+ (re.range \\\"0\\\" \\\"9\\\")))\")\n  }\n  if name == \"trim\" && n == 1 {\n    s := smt.as_str(mut vc, arg(0))\n    r := smt.fresh_why(\n      mut vc,\n      \"String\",\n      \"`trim` (only its length bound is modelled)\",\n    )\n    mut vc.facts.push(f\"(<= (str.len {r}) (str.len {s}))\")\n    return smt.VStr(r)\n  }\n  // anything else: a fresh value of the builtin's result type, when every\n  // version of it returns the same type, free of type variables\n  sigs := vc.builtins.filter(b -> b.name == name)\n  rets := sigs\n    .filter(b -> !b.type_params.any(\n      p -> contains(smt.words(text.type_text(b.ret), false), p),\n    ))\n    .map(b -> b.ret)\n  match rets {\n    [ret, ..] => if len(rets) == len(sigs) && rets.all(r -> r == ret) {\n      old := vc.reason\n      vc.reason = Some(not_modelled)\n      v := smt.shape(mut vc, ret)\n      vc.reason = old\n      v\n    } else {\n      smt.Opaque(not_modelled)\n    },\n    [] => smt.Opaque(not_modelled),\n  }\n}","old_text":"fn builtin(\n  mut vc: smt.Vc,\n  given: String,\n  arg_exprs: List[ast.Expr],\n  a: List[smt.Val],\n) -> smt.Val {\n  pol := vc.call_pol\n  vc.call_pol = 0\n  // (`xs.sorted()` is what `sort` was: a new list)\n  name := builtins.internal_name(given)\n  arg := (i: Int) -> get(a, i) ?? smt.Opaque(\"a missing argument\")\n  not_modelled := f\"`{name}` is not modelled\"\n  smt.builtin_faults(mut vc, name, a)\n  n := len(a)\n  // dicts and sets: their arrays\n  match smt.map_op(mut vc, name, a) {\n    Some(v) => return v,\n    None => (),\n  }\n  if (name == \"set\" || name == \"dict\") && n == 1 {\n    match smt.map_literal(mut vc, name, get(arg_exprs, 0), arg(0)) {\n      Some(v) => return v,\n      None => (),\n    }\n  }\n  // sized integers: `to_int` is the integer; `to_u8` must fit, `wrap_u8`\n  // wraps\n  if name == \"to_int\" && n == 1 && smt.word_of(arg(0)) != None {\n    return smt.VInt(smt.as_int(mut vc, arg(0)))\n  }\n  match (smt.conversion(name), n) {\n    (Some((w, wraps)), 1) => {\n      x := smt.as_int(mut vc, arg(0))\n      if wraps {\n        return smt.word(w, smt.wrap_term(w, x))\n      }\n      if smt.start_goal(mut vc) {\n        smt.oblige(\n          mut vc,\n          f\"`{name}` of an Int that fits in `{w}`\",\n          smt.word_range(w, x),\n        )\n      }\n      return smt.word(w, x)\n    },\n    _ => (),\n  }\n  if (name == \"len\" || name == \"str_len\") && n == 1 {\n    return match arg(0) {\n      smt.VStr(s) => smt.VInt(f\"(str.len {s})\"),\n      v => smt.VInt(smt.list_len(mut vc, v)),\n    }\n  }\n  if name == \"abs\" && n == 1 {\n    return match arg(0) {\n      smt.VInt(x) => smt.VInt(f\"(ite (< {x} 0) (- {x}) {x})\"),\n      smt.VUnion { .. } => smt.Opaque(not_modelled),\n      v => v,\n    }\n  }\n  if (name == \"min\" || name == \"max\") && n == 2 {\n    x0 := arg(0)\n    y0 := arg(1)\n    if !smt.is_int(x0) && !smt.is_int(y0) {\n      return smt.Opaque(not_modelled)\n    }\n    x := smt.as_int(mut vc, x0)\n    y := smt.as_int(mut vc, y0)\n    op := if name == \"min\" {\n      \"<=\"\n    } else {\n      \">=\"\n    }\n    return smt.VInt(f\"(ite ({op} {x} {y}) {x} {y})\")\n  }\n  if name == \"matches\" && n == 2 {\n    s := smt.as_str(mut vc, arg(0))\n    return smt.VBool(match get(arg_exprs, 1) {\n      Some(ast.StrLit(re)) => smt.regex_match(mut vc, s, re),\n      _ => smt.unknown_bool(\n        mut vc,\n        \"`matches` with a pattern that is not a literal\",\n      ),\n    })\n  }\n  if name == \"starts_with\" && n == 2 {\n    s := smt.as_str(mut vc, arg(0))\n    p := smt.as_str(mut vc, arg(1))\n    return smt.VBool(f\"(str.prefixof {p} {s})\")\n  }\n  if name == \"contains\" && n == 2 && smt.is_str(arg(0)) {\n    s := smt.as_str(mut vc, arg(0))\n    p := smt.as_str(mut vc, arg(1))\n    return smt.VBool(f\"(str.contains {s} {p})\")\n  }\n  // an element of a list (not of a dict or set): some element equals it\n  if name == \"contains\" && n == 2 && smt.is_list(arg(0)) {\n    match arg(0) {\n      smt.VList { id, .. } => if !contains(vc.keyed, id) {\n        return smt.VBool(smt.neg(smt.all_of(\n          mut vc,\n          arg(0),\n          smt.FNot(smt.member_of(vc, arg(1))),\n          0 - pol,\n        )))\n      },\n      _ => (),\n    }\n  }\n  // the values' order: exactly on integers, else -1, 0 or 1\n  if name == \"compare\" && n == 2 {\n    if smt.is_int(arg(0)) && smt.is_int(arg(1)) {\n      x := smt.as_int(mut vc, arg(0))\n      y := smt.as_int(mut vc, arg(1))\n      return smt.VInt(f\"(ite (< {x} {y}) (- 1) (ite (= {x} {y}) 0 1))\")\n    }\n    c := smt.fresh_why(\n      mut vc,\n      \"Int\",\n      \"`compare` (only on integers is the order modelled)\",\n    )\n    mut vc.facts.push(f\"(and (<= (- 1) {c}) (<= {c} 1))\")\n    return smt.VInt(c)\n  }\n  if name == \"push\" && n == 2 {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    // the list's elements, then the new one\n    one := smt.new_list(mut vc, \"1\", smt.GValues([arg(1)]))\n    oid := smt.list_id(mut vc, one)\n    return smt.new_list(mut vc, f\"(+ {l} 1)\", smt.GConcat(id, oid, l))\n  }\n  if (name == \"take\" || name == \"drop\") && n == 2 {\n    l := smt.list_len(mut vc, arg(0))\n    k0 := smt.as_int(mut vc, arg(1))\n    k := f\"(ite (< {k0} 0) 0 (ite (< {k0} {l}) {k0} {l}))\"\n    id := smt.list_id(mut vc, arg(0))\n    return if name == \"take\" {\n      smt.new_list(mut vc, k, smt.GShift(id, \"0\"))\n    } else {\n      smt.new_list(mut vc, f\"(- {l} {k})\", smt.GShift(id, k))\n    }\n  }\n  // elements start..end of a list, both clamped to 0..len\n  if name == \"slice\" && n == 3 && smt.is_list(arg(0)) {\n    l := smt.list_len(mut vc, arg(0))\n    a0 := smt.as_int(mut vc, arg(1))\n    b0 := smt.as_int(mut vc, arg(2))\n    ca := f\"(ite (< {a0} 0) 0 (ite (> {a0} {l}) {l} {a0}))\"\n    cb := f\"(ite (< {b0} 0) 0 (ite (> {b0} {l}) {l} {b0}))\"\n    id := smt.list_id(mut vc, arg(0))\n    return smt.new_list(\n      mut vc,\n      f\"(ite (< {ca} {cb}) (- {cb} {ca}) 0)\",\n      smt.GShift(id, ca),\n    )\n  }\n  if name == \"reverse\" && !smt.is_str(arg(0)) {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    return smt.new_list(mut vc, l, smt.GRev(id, l))\n  }\n  if (name == \"sort\" || name == \"sort_by\") && !smt.is_str(arg(0)) {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    return smt.new_list(mut vc, l, smt.GSub(id))\n  }\n  if name == \"map\" && n == 2 {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    g := match smt.fn_arg(vc, 1) {\n      Some(f) => smt.GMap(id, f),\n      None => smt.Untracked,\n    }\n    return smt.new_list(mut vc, l, g)\n  }\n  if name == \"enumerate\" {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    return smt.new_list(mut vc, l, smt.GEnum(id, l))\n  }\n  if name == \"filter\" && n == 2 {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    k := smt.fresh_why(\n      mut vc,\n      \"Int\",\n      \"`filter` (only the length bound is modelled)\",\n    )\n    mut vc.facts.push(f\"(and (<= 0 {k}) (<= {k} {l}))\")\n    g := match smt.fn_arg(vc, 1) {\n      Some(f) => {\n        // empty: no element passes (what the elements of a non-empty\n        // one are, `GFilter`, says the rest)\n        none := smt.all_of(mut vc, arg(0), smt.FNot(f), 1)\n        mut vc.facts.push(f\"(=> (= {k} 0) {none})\")\n        smt.GFilter(id, f)\n      },\n      None => smt.GSub(id),\n    }\n    return smt.new_list(mut vc, k, g)\n  }\n  if name == \"find\"\n    && n == 2\n    && smt.is_list(arg(0))\n    && smt.fn_arg(vc, 1) != None {\n    // `Some(x)`: an element of the list that satisfies the function\n    f := smt.fn_arg(vc, 1) ?? smt.FValid(ast.UnitType)\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    found := smt.fresh_why(\n      mut vc,\n      \"Bool\",\n      \"`find` (whether an element is found is not modelled)\",\n    )\n    mut vc.facts.push(f\"(=> (= {l} 0) (not {found}))\")\n    x := smt.element(mut vc, id, found)\n    pn := len(vc.pc)\n    mut vc.pc.push(found)\n    pv := smt.apply(mut vc, f, x)\n    p := smt.as_bool(mut vc, pv)\n    smt.assume(mut vc, p)\n    vc.pc = take(vc.pc, pn)\n    t := smt.elem_type(vc, id) ?? smt.named(\"_\")\n    return smt.option(mut vc, t, found, x)\n  }\n  // `xs[i] = x` (`set_at(xs, i, x)`): the elements before `i`, then `x`,\n  // then those after, so each element is known by its position\n  if name == \"set_at\" && n == 3 {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    i := smt.as_int(mut vc, arg(1))\n    inside := f\"(and (<= 0 {i}) (< {i} {l}))\"\n    if smt.start_goal(mut vc) {\n      smt.oblige(mut vc, \"index in range\", inside)\n    }\n    if !smt.is_list(arg(0)) {\n      return smt.new_list(mut vc, l, smt.Untracked)\n    }\n    front := smt.new_list(mut vc, i, smt.GShift(id, \"0\"))\n    one := smt.new_list(mut vc, \"1\", smt.GValues([arg(2)]))\n    back := smt.new_list(\n      mut vc,\n      f\"(- {l} {i} 1)\",\n      smt.GShift(id, f\"(+ {i} 1)\"),\n    )\n    tail := smt.new_list(mut vc, f\"(- {l} {i})\", smt.GConcat(\n      smt.list_id(mut vc, one),\n      smt.list_id(mut vc, back),\n      \"1\",\n    ))\n    return smt.new_list(mut vc, l, smt.GConcat(\n      smt.list_id(mut vc, front),\n      smt.list_id(mut vc, tail),\n      i,\n    ))\n  }\n  if name == \"at\" && n == 2 && smt.is_list(arg(0)) {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    i := smt.as_int(mut vc, arg(1))\n    inside := f\"(and (<= 0 {i}) (< {i} {l}))\"\n    if smt.start_goal(mut vc) {\n      smt.oblige(mut vc, \"index in range\", inside)\n    }\n    return smt.element_at(mut vc, id, i, inside) ?? smt.element(mut vc, id, inside)\n  }\n  if name == \"at\" && n == 2 && smt.is_str(arg(0)) {\n    s := smt.as_str(mut vc, arg(0))\n    i := smt.as_int(mut vc, arg(1))\n    if smt.start_goal(mut vc) {\n      smt.oblige(\n        mut vc,\n        \"index in range\",\n        f\"(and (<= 0 {i}) (< {i} (str.len {s})))\",\n      )\n    }\n    return smt.VStr(f\"(str.at {s} {i})\")\n  }\n  // an index into a list of another shape: checked against its length all\n  // the same\n  if name == \"at\" && n == 2 {\n    l := smt.list_len(mut vc, arg(0))\n    i := smt.as_int(mut vc, arg(1))\n    if smt.start_goal(mut vc) {\n      smt.oblige(\n        mut vc,\n        \"index in range\",\n        f\"(and (<= 0 {i}) (< {i} {l}))\",\n      )\n    }\n    return smt.Opaque(not_modelled)\n  }\n  if name == \"get\" && n == 2 && smt.is_list(arg(0)) {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    i := smt.as_int(mut vc, arg(1))\n    inside := f\"(and (<= 0 {i}) (< {i} {l}))\"\n    x := smt.element_at(mut vc, id, i, inside) ?? smt.element(mut vc, id, inside)\n    t := smt.elem_type(vc, id) ?? smt.named(\"_\")\n    return smt.option(mut vc, t, inside, x)\n  }\n  if name == \"count\" && n == 2 {\n    l := smt.list_len(mut vc, arg(0))\n    k := smt.fresh_why(\n      mut vc,\n      \"Int\",\n      \"`count` (only the bounds are modelled)\",\n    )\n    mut vc.facts.push(f\"(and (<= 0 {k}) (<= {k} {l}))\")\n    return smt.VInt(k)\n  }\n  if name == \"zip\" && n == 2 {\n    x := smt.list_len(mut vc, arg(0))\n    y := smt.list_len(mut vc, arg(1))\n    l := f\"(ite (<= {x} {y}) {x} {y})\"\n    a := smt.list_id(mut vc, arg(0))\n    b := smt.list_id(mut vc, arg(1))\n    return smt.new_list(mut vc, l, smt.GZip(a, b, l))\n  }\n  if name == \"range\" && n == 2 {\n    lo := smt.as_int(mut vc, arg(0))\n    hi := smt.as_int(mut vc, arg(1))\n    return smt.new_list(\n      mut vc,\n      f\"(ite (> {hi} {lo}) (- {hi} {lo}) 0)\",\n      smt.GRange(lo, hi),\n    )\n  }\n  if name == \"set\" && n == 1 {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    k := smt.fresh_why(\n      mut vc,\n      \"Int\",\n      \"`set` (only its size bounds are modelled)\",\n    )\n    mut vc.facts.push(\n      f\"(and (<= 0 {k}) (<= {k} {l}) (= (= {k} 0) (= {l} 0)))\",\n    )\n    // a set of a list's elements has only elements of the list\n    return smt.new_list(mut vc, k, smt.GSub(id))\n  }\n  if name == \"to_list\" && n == 1 && smt.is_list(arg(0)) {\n    l := smt.list_len(mut vc, arg(0))\n    id := smt.list_id(mut vc, arg(0))\n    return smt.new_list(mut vc, l, smt.GSub(id))\n  }\n  if (name == \"keys\"\n      || name == \"values\"\n      || name == \"items\"\n      || name == \"to_list\")\n    && n == 1 {\n    l := smt.list_len(mut vc, arg(0))\n    return smt.new_list(mut vc, l, smt.Untracked)\n  }\n  if name == \"all\" && n == 2 && smt.fn_arg(vc, 1) != None {\n    return smt.VBool(smt.all_of(\n      mut vc,\n      arg(0),\n      smt.fn_arg(vc, 1) ?? smt.FValid(ast.UnitType),\n      pol,\n    ))\n  }\n  // some element satisfies `f`: not every element fails it\n  if name == \"any\" && n == 2 && smt.fn_arg(vc, 1) != None {\n    return smt.VBool(smt.neg(smt.all_of(\n      mut vc,\n      arg(0),\n      smt.FNot(smt.fn_arg(vc, 1) ?? smt.FValid(ast.UnitType)),\n      0 - pol,\n    )))\n  }\n  if (name == \"all\" || name == \"any\") && n == 2 {\n    // otherwise only the empty case is modelled\n    l := smt.list_len(mut vc, arg(0))\n    b := smt.fresh_why(mut vc, \"Bool\", not_modelled)\n    mut vc.facts.push(\n      f\"(=> (= {l} 0) \"\n        + if name == \"all\" {\n          b\n        } else {\n          smt.neg(b)\n        }\n        + \")\",\n    )\n    return smt.VBool(b)\n  }\n  if name == \"sum\" && n == 1 {\n    // an Int list (a Float list's elements are unknown values): its sum\n    // by how it was made (`list_sum`)\n    return match smt.list_sum(mut vc, arg(0), None) {\n      Some(t) => smt.VInt(t),\n      None => smt.Opaque(not_modelled),\n    }\n  }\n  // `fold(xs, init, (acc, x) -> acc + e)`: `init` plus the sum of `e` over\n  // the elements\n  if name == \"fold\" && n == 3 {\n    match (arg(1), get(arg_exprs, 2)) {\n      (smt.VInt(init), Some(ast.Lambda { params: [pa, px], body })) => match smt.added_to(body, pa.name) {\n        Some(e) => match smt.list_sum(mut vc, arg(0), Some(\n          smt.FLambda { param: px.name, body: e, scopes: vc.scopes },\n        )) {\n          Some(t) => return smt.VInt(f\"(+ {init} {t})\"),\n          None => (),\n        },\n        None => (),\n      },\n      _ => (),\n    }\n  }\n  if name == \"ends_with\" && n == 2 {\n    s := smt.as_str(mut vc, arg(0))\n    p := smt.as_str(mut vc, arg(1))\n    return smt.VBool(f\"(str.suffixof {p} {s})\")\n  }\n  // positions in strings are byte offsets; SMT strings are code points: on\n  // an ASCII string the two are the same, on others only bounds are known\n  if name == \"byte_len\" && n == 1 {\n    s := smt.as_str(mut vc, arg(0))\n    return smt.VInt(smt.utf8_len(mut vc, s))\n  }\n  // a byte (0 to 255): on an ASCII string, the character's code\n  if name == \"byte_at\" && n == 2 {\n    s := smt.as_str(mut vc, arg(0))\n    i := smt.as_int(mut vc, arg(1))\n    b := smt.fresh_why(\n      mut vc,\n      \"Int\",\n      \"`byte_at` of a string that may not be ASCII\",\n    )\n    mut vc.facts.push(\n      f\"(and (<= 0 {b}) (<= {b} 255) (=> (and {smt.ascii(s)} (<= 0 {i}) (< {i} (str.len {s}))) (= {b} (str.to_code (str.at {s} {i})))))\",\n    )\n    return smt.VInt(b)\n  }\n  if name == \"byte_slice\" && n == 3 {\n    s := smt.as_str(mut vc, arg(0))\n    a0 := smt.as_int(mut vc, arg(1))\n    b0 := smt.as_int(mut vc, arg(2))\n    bn := smt.utf8_len(mut vc, s)\n    ca := f\"(ite (< {a0} 0) 0 (ite (> {a0} {bn}) {bn} {a0}))\"\n    cb := f\"(ite (< {b0} 0) 0 (ite (> {b0} {bn}) {bn} {b0}))\"\n    other := smt.fresh_why(\n      mut vc,\n      \"String\",\n      \"`byte_slice` of a string that may not be ASCII\",\n    )\n    r := f\"(ite {smt.ascii(s)} (str.substr {s} {ca} (- {cb} {ca})) {other})\"\n    rn := smt.utf8_len(mut vc, r)\n    // a >= b: nothing (moving back keeps the order)\n    mut vc.facts.push(f\"(=> (>= {ca} {cb}) (= {r} \\\"\\\"))\")\n    mut vc.facts.push(\n      f\"(and (>= {rn} 0) (<= {rn} {cb}) (<= {rn} (+ (- {cb} {ca}) 3)) (=> {smt.ascii(s)} (= {rn} (ite (< {ca} {cb}) (- {cb} {ca}) 0))))\",\n    )\n    return smt.VStr(r)\n  }\n  if name == \"chars\" && n == 1 {\n    s := smt.as_str(mut vc, arg(0))\n    // each element is one character\n    return smt.new_list(\n      mut vc,\n      f\"(str.len {s})\",\n      smt.GType(smt.one_char()),\n    )\n  }\n  // the first match's byte offset (its code-point offset on an ASCII\n  // string, never less elsewhere); \"\" is found at 0\n  if name == \"index_of\" && n == 2 {\n    s := smt.as_str(mut vc, arg(0))\n    p := smt.as_str(mut vc, arg(1))\n    i := f\"(str.indexof {s} {p} 0)\"\n    b := smt.fresh_why(\n      mut vc,\n      \"Int\",\n      \"`index_of` in a string that may not be ASCII\",\n    )\n    sn := smt.utf8_len(mut vc, s)\n    pn := smt.utf8_len(mut vc, p)\n    // a match ends inside the string\n    mut vc.facts.push(\n      f\"(and (=> {smt.ascii(s)} (= {b} {i})) (=> (= {i} 0) (= {b} 0)) (=> (>= {i} 0) (and (>= {b} {i}) (<= (+ {b} {pn}) {sn}))))\",\n    )\n    return smt.option(mut vc, smt.named(\"Int\"), f\"(>= {i} 0)\", smt.VInt(b))\n  }\n  // every non-overlapping match, left to right; an empty pattern is found\n  // around every character (not modelled)\n  if name == \"replace\" && n == 3 {\n    s := smt.as_str(mut vc, arg(0))\n    from := smt.as_str(mut vc, arg(1))\n    to := smt.as_str(mut vc, arg(2))\n    around := smt.fresh_why(\n      mut vc,\n      \"String\",\n      \"`replace` with an empty pattern\",\n    )\n    return smt.VStr(\n      f\"(ite (= {from} \\\"\\\") {around} (str.replace_all {s} {from} {to}))\",\n    )\n  }\n  if name == \"to_string\" && n == 1 {\n    return match arg(0) {\n      smt.VStr(s) => smt.VStr(s),\n      smt.VBool(b) => smt.VStr(f\"(ite {b} \\\"true\\\" \\\"false\\\")\"),\n      // `str.from_int` is \"\" for negative numbers\n      smt.VInt(x) => smt.VStr(\n        f\"(ite (>= {x} 0) (str.from_int {x}) (str.++ \\\"-\\\" (str.from_int (- {x}))))\",\n      ),\n      _ => smt.VStr(smt.fresh_why(mut vc, \"String\", not_modelled)),\n    }\n  }\n  // only the forms whose result is certain: digits, `-` and digits, and\n  // strings without an ASCII digit (never a number)\n  if name == \"parse_int\" && n == 1 {\n    s := smt.as_str(mut vc, arg(0))\n    digits := \"(re.+ (re.range \\\"0\\\" \\\"9\\\"))\"\n    pos := f\"(str.in_re {s} {digits})\"\n    rest := f\"(str.substr {s} 1 (- (str.len {s}) 1))\"\n    negative := f\"(and (str.prefixof \\\"-\\\" {s}) (str.in_re {rest} {digits}))\"\n    none := f\"(not (str.in_re {s} (re.++ re.all (re.range \\\"0\\\" \\\"9\\\") re.all)))\"\n    // true by the definition of `str.to_int`, which Z3 does not find alone\n    for x in [s, rest] {\n      mut vc.facts.push(\n        f\"(= (>= (str.to_int {x}) 0) (str.in_re {x} {digits}))\",\n      )\n    }\n    k := smt.fresh_why(\n      mut vc,\n      \"Int\",\n      \"`parse_int` of a string with whitespace, `+` or `_`\",\n    )\n    payload := f\"(ite {pos} (str.to_int {s}) (ite {negative} (- (str.to_int {rest})) {k}))\"\n    some := smt.fresh_why(\n      mut vc,\n      \"Bool\",\n      \"`parse_int` of a string with whitespace, `+` or `_`\",\n    )\n    return smt.option(\n      mut vc,\n      smt.named(\"Int\"),\n      f\"(or {pos} {negative} (and (not {none}) {some}))\",\n      smt.VInt(payload),\n    )\n  }\n  if name == \"chr\" && n == 1 && smt.is_int(arg(0)) {\n    x := smt.as_int(mut vc, arg(0))\n    c := smt.fresh_why(\n      mut vc,\n      \"String\",\n      \"`chr` of a code point past U+2FFFF\",\n    )\n    mut vc.facts.push(f\"(= (str.len {c}) 1)\")\n    mut vc.facts.push(\n      f\"(=> (<= {x} {smt.max_char()}) (= {c} (str.from_code {x})))\",\n    )\n    return smt.VStr(c)\n  }\n  if name == \"ord\" && n == 1 {\n    s := smt.as_str(mut vc, arg(0))\n    return smt.VInt(f\"(str.to_code {s})\")\n  }\n  // ASCII digits only, and not empty\n  if name == \"is_digit\" && n == 1 {\n    s := smt.as_str(mut vc, arg(0))\n    return smt.VBool(f\"(str.in_re {s} (re.+ (re.range \\\"0\\\" \\\"9\\\")))\")\n  }\n  if name == \"trim\" && n == 1 {\n    s := smt.as_str(mut vc, arg(0))\n    r := smt.fresh_why(\n      mut vc,\n      \"String\",\n      \"`trim` (only its length bound is modelled)\",\n    )\n    mut vc.facts.push(f\"(<= (str.len {r}) (str.len {s}))\")\n    return smt.VStr(r)\n  }\n  // anything else: a fresh value of the builtin's result type, when every\n  // version of it returns the same type, free of type variables\n  sigs := vc.builtins.filter(b -> b.name == name)\n  rets := sigs\n    .filter(b -> !b.type_params.any(\n      p -> contains(smt.words(text.type_text(b.ret), false), p),\n    ))\n    .map(b -> b.ret)\n  match rets {\n    [ret, ..] => if len(rets) == len(sigs) && rets.all(r -> r == ret) {\n      old := vc.reason\n      vc.reason = Some(not_modelled)\n      v := smt.shape(mut vc, ret)\n      vc.reason = old\n      v\n    } else {\n      smt.Opaque(not_modelled)\n    },\n    [] => smt.Opaque(not_modelled),\n  }\n}"},{"name":"smt.eq_list_values","kind":"fn","old":"12663e7dfb6973fa","new":"0a1475625e7fcdd1","interface_changed":false,"affected":[],"module":"smt","text":"// ---- operators ----\n\n/// Two lists equal: as sequences of a datatype (equal terms), by position\n/// in a goal where both are known so, else only their lengths.\nfn eq_list_values(\n  mut vc: smt.Vc,\n  l1: String,\n  i1: Int,\n  l2: String,\n  i2: Int,\n) -> String {\n  match (smt.list_info(vc, i1).source, smt.list_info(vc, i2).source) {\n    (smt.GSeq(x, _, n), smt.GSeq(y, _, m)) => return if n != m {\n      smt.unknown_bool(mut vc, \"comparing lists of different types\")\n    } else {\n      f\"(= {x} {y})\"\n    },\n    _ => (),\n  }\n  if i1 == i2 {\n    return f\"(= {l1} {l2})\"\n  }\n  // by position, where both are known so: only in a goal, and not inside a\n  // quantified fact\n  if vc.proving > 0\n    && vc.eq_depth < 2\n    && vc.indexing == None\n    && len(vc.regions) == 0 {\n    vc.eq_depth += 1\n    e := smt.eq_lists(mut vc, i1, l1, i2, l2)\n    vc.eq_depth -= 1\n    match e {\n      Some(x) => return x,\n      None => (),\n    }\n  }\n  // equal lists have equal lengths and, when both are known by position,\n  // equal elements at the positions the code takes (`ListInfo.same`)\n  if vc.list_eq > 0\n    && vc.in_same == 0\n    && vc.binding == 0\n    && len(vc.regions) == 0\n    && smt.positional(vc, i1)\n    && smt.positional(vc, i2) {\n    b := smt.unknown_bool(\n      mut vc,\n      \"comparing lists (their elements are equal only where taken)\",\n    )\n    mut vc.facts.push(f\"(=> {b} (= {l1} {l2}))\")\n    smt.same_lists(mut vc, b, i1, i2)\n    smt.same_lists(mut vc, b, i2, i1)\n    return b\n  }\n  b := smt.unknown_bool(mut vc, \"the elements of a list are not tracked\")\n  mut vc.facts.push(f\"(=> {b} (= {l1} {l2}))\")\n  b\n}","old_text":"// ---- operators ----\n\n/// Two lists equal: as sequences of a datatype (equal terms), by position\n/// in a goal where both are known so, else only their lengths.\nfn eq_list_values(\n  mut vc: smt.Vc,\n  l1: String,\n  i1: Int,\n  l2: String,\n  i2: Int,\n) -> String {\n  match (smt.list_info(vc, i1).source, smt.list_info(vc, i2).source) {\n    (smt.GSeq(x, _, n), smt.GSeq(y, _, m)) => return if n != m {\n      smt.unknown_bool(mut vc, \"comparing lists of different types\")\n    } else {\n      f\"(= {x} {y})\"\n    },\n    _ => (),\n  }\n  if i1 == i2 {\n    return f\"(= {l1} {l2})\"\n  }\n  // by position, where both are known so: only in a goal, and not inside a\n  // quantified fact\n  if vc.proving > 0\n    && vc.eq_depth < 2\n    && vc.indexing == None\n    && len(vc.regions) == 0 {\n    vc.eq_depth += 1\n    e := smt.eq_lists(mut vc, i1, l1, i2, l2)\n    vc.eq_depth -= 1\n    match e {\n      Some(x) => return x,\n      None => (),\n    }\n  }\n  // equal lists have equal lengths, and, when both are known by position,\n  // equal elements at the positions the code takes (`ListInfo.same`)\n  if vc.list_eq > 0\n    && vc.in_same == 0\n    && vc.binding == 0\n    && len(vc.regions) == 0\n    && smt.positional(vc, i1)\n    && smt.positional(vc, i2) {\n    b := smt.unknown_bool(\n      mut vc,\n      \"comparing lists (their elements are equal only where taken)\",\n    )\n    mut vc.facts.push(f\"(=> {b} (= {l1} {l2}))\")\n    smt.same_lists(mut vc, b, i1, i2)\n    smt.same_lists(mut vc, b, i2, i1)\n    return b\n  }\n  b := smt.unknown_bool(mut vc, \"the elements of a list are not tracked\")\n  mut vc.facts.push(f\"(=> {b} (= {l1} {l2}))\")\n  b\n}"},{"name":"smt.list_valid","kind":"fn","old":"b8a7e8b70c55fa95","new":"fcb503d001487056","interface_changed":false,"affected":[],"module":"smt","text":"/// \"Every element of list `id` is a valid `t`\": proven on an arbitrary\n/// element, and known from then on.\nfn list_valid(\n  mut vc: smt.Vc,\n  len: String,\n  id: Int,\n  t: ast.TypeExpr,\n  v: smt.Val,\n) -> String {\n  if len == \"0\" || smt.valid_known(vc, id, t) {\n    \"true\"\n  } else {\n    smt.all_of(mut vc, v, smt.FValid(t), vc.polarity)\n  }\n}","old_text":"/// Every element of list `id` a valid `t`: proven on an arbitrary\n/// element, and known from then on.\nfn list_valid(\n  mut vc: smt.Vc,\n  len: String,\n  id: Int,\n  t: ast.TypeExpr,\n  v: smt.Val,\n) -> String {\n  if len == \"0\" || smt.valid_known(vc, id, t) {\n    \"true\"\n  } else {\n    smt.all_of(mut vc, v, smt.FValid(t), vc.polarity)\n  }\n}"},{"name":"smt.Jump","kind":"type","old":"fbbd5cc1dd6972d8","new":"7d6303d7e81fb10f","interface_changed":false,"affected":[],"module":"smt","text":"/// Where a path left a loop pass (a `break` or `continue`): its path\n/// condition and the variables then.\ntype Jump = { pc: List[String], scopes: List[Dict[String, smt.Val]] }","old_text":"/// Where a path left a loop's pass (a `break` or `continue`): its path\n/// condition and the variables then.\ntype Jump = { pc: List[String], scopes: List[Dict[String, smt.Val]] }"},{"name":"smt.PassEnd","kind":"type","old":"ed8445f8b1d909da","new":"8ddff97c5a5a4f19","interface_changed":false,"affected":[],"module":"smt","text":"/// Where a loop pass ends: the body's end or a `continue` (`again`).\ntype PassEnd = {\n  pc: List[String],\n  scopes: List[Dict[String, smt.Val]],\n  again: Bool,\n}","old_text":"/// Where a pass of a loop ends: the body's end or a `continue` (`again`).\ntype PassEnd = {\n  pc: List[String],\n  scopes: List[Dict[String, smt.Val]],\n  again: Bool,\n}"},{"name":"smt.changed_vars","kind":"fn","old":"14c636fa216e3c10","new":"f3ea3a96a9a2166b","interface_changed":false,"affected":[],"module":"smt","text":"/// The variables an expression may change: assigned ones, those passed to\n/// `mut` parameters, and those changed by a method (`mut x.f.insert(k,\n/// v)`). Lambdas are not looked into.\npub fn changed_vars(vc: smt.Vc, e: ast.Expr) -> Set[String] {\n  mut out := Set[String] {}\n  mut todo := [e]\n  while len(todo) > 0 {\n    x := get(todo, len(todo) - 1) ?? ast.UnitExpr\n    todo = take(todo, len(todo) - 1)\n    match x {\n      ast.Lambda { .. } => (),\n      // `mut x.f.insert(k, v)`: a method changing a place\n      ast.MutExpr(ast.MethodCall { recv, .. }) => match smt.place_root(recv) {\n        Some(r) => mut out.insert(r),\n        None => (),\n      },\n      ast.Call { callee, args } => match callee {\n        ast.Var(n) => {\n          for r in smt.passed_mut(vc, n, args) {\n            mut out.insert(r)\n          }\n        },\n        _ => (),\n      },\n      ast.MethodCall { recv, name, args } => {\n        for r in smt.passed_mut(vc, name, [recv] + args) {\n          mut out.insert(r)\n        }\n      },\n      ast.Block { stmts, .. } => {\n        for s in stmts {\n          match s {\n            ast.Assign { place, .. } => match smt.place_root(place) {\n              Some(r) => mut out.insert(r),\n              None => (),\n            },\n            _ => (),\n          }\n        }\n      },\n      _ => (),\n    }\n    match x {\n      ast.Lambda { .. } => (),\n      _ => {\n        todo += walk.kids(x)\n      },\n    }\n  }\n  out\n}","old_text":"/// The variables an expression may change: assigned ones, and those passed\n/// to `mut` parameters or changed by a method (`mut x.f.insert(k, v)`),\n/// not inside lambdas.\npub fn changed_vars(vc: smt.Vc, e: ast.Expr) -> Set[String] {\n  mut out := Set[String] {}\n  mut todo := [e]\n  while len(todo) > 0 {\n    x := get(todo, len(todo) - 1) ?? ast.UnitExpr\n    todo = take(todo, len(todo) - 1)\n    match x {\n      ast.Lambda { .. } => (),\n      // `mut x.f.insert(k, v)`: a method changing a place\n      ast.MutExpr(ast.MethodCall { recv, .. }) => match smt.place_root(recv) {\n        Some(r) => mut out.insert(r),\n        None => (),\n      },\n      ast.Call { callee, args } => match callee {\n        ast.Var(n) => {\n          for r in smt.passed_mut(vc, n, args) {\n            mut out.insert(r)\n          }\n        },\n        _ => (),\n      },\n      ast.MethodCall { recv, name, args } => {\n        for r in smt.passed_mut(vc, name, [recv] + args) {\n          mut out.insert(r)\n        }\n      },\n      ast.Block { stmts, .. } => {\n        for s in stmts {\n          match s {\n            ast.Assign { place, .. } => match smt.place_root(place) {\n              Some(r) => mut out.insert(r),\n              None => (),\n            },\n            _ => (),\n          }\n        }\n      },\n      _ => (),\n    }\n    match x {\n      ast.Lambda { .. } => (),\n      _ => {\n        todo += walk.kids(x)\n      },\n    }\n  }\n  out\n}"},{"name":"smt.pass_ends","kind":"fn","old":"224fd290fc6c3390","new":"c1a062503f8d3d48","interface_changed":false,"affected":[],"module":"smt","text":"/// The ends of a loop pass: the body's end (if reached), then each\n/// `continue`, their scopes cut to `depth`.\nfn pass_ends(mut vc: smt.Vc, depth: Int) -> List[smt.PassEnd] {\n  mut ends := []\n  if !vc.dead {\n    mut ends.push(\n      smt.PassEnd {\n        pc: vc.pc,\n        scopes: take(vc.scopes, depth),\n        again: false,\n      },\n    )\n  }\n  for j in get(vc.continues, len(vc.continues) - 1) ?? [] {\n    mut ends.push(\n      smt.PassEnd {\n        pc: j.pc,\n        scopes: take(j.scopes, depth),\n        again: true,\n      },\n    )\n  }\n  vc.continues = take(vc.continues, len(vc.continues) - 1)\n  ends\n}","old_text":"/// The ends of a loop's pass: the body's end (if reached), then each\n/// `continue`, their scopes cut to `depth`.\nfn pass_ends(mut vc: smt.Vc, depth: Int) -> List[smt.PassEnd] {\n  mut ends := []\n  if !vc.dead {\n    mut ends.push(\n      smt.PassEnd {\n        pc: vc.pc,\n        scopes: take(vc.scopes, depth),\n        again: false,\n      },\n    )\n  }\n  for j in get(vc.continues, len(vc.continues) - 1) ?? [] {\n    mut ends.push(\n      smt.PassEnd {\n        pc: j.pc,\n        scopes: take(j.scopes, depth),\n        again: true,\n      },\n    )\n  }\n  vc.continues = take(vc.continues, len(vc.continues) - 1)\n  ends\n}"},{"name":"smt.written_on_entry","kind":"fn","old":"1c46349d89b63a55","new":"ec4846849a134fb6","interface_changed":false,"affected":[],"module":"smt","text":"/// Checks that a loop's written invariants hold before it.\nfn written_on_entry(mut vc: smt.Vc, written: List[ast.Expr], head: String) {\n  for x in written {\n    vc.see += 1\n    v := smt.eval(mut vc, x)\n    vc.see -= 1\n    b := smt.as_bool(mut vc, v)\n    if smt.start_goal(mut vc) {\n      smt.oblige(mut vc, \"invariant `\"\n        + text.expr_text(x, 0)\n        + \"` on entry to `\"\n        + head\n        + \"`\", b)\n    }\n  }\n}","old_text":"/// A loop's written invariants hold before it.\nfn written_on_entry(mut vc: smt.Vc, written: List[ast.Expr], head: String) {\n  for x in written {\n    vc.see += 1\n    v := smt.eval(mut vc, x)\n    vc.see -= 1\n    b := smt.as_bool(mut vc, v)\n    if smt.start_goal(mut vc) {\n      smt.oblige(mut vc, \"invariant `\"\n        + text.expr_text(x, 0)\n        + \"` on entry to `\"\n        + head\n        + \"`\", b)\n    }\n  }\n}"},{"name":"smt.assume_written","kind":"fn","old":"e6750c4b07078b58","new":"769161d9a4a23f04","interface_changed":false,"affected":[],"module":"smt","text":"/// Assumes a loop's written invariants at its head.\nfn assume_written(mut vc: smt.Vc, written: List[ast.Expr]) {\n  for x in written {\n    vc.spec += 1\n    v := smt.eval(mut vc, x)\n    vc.spec -= 1\n    b := smt.as_bool(mut vc, v)\n    smt.assume(mut vc, b)\n  }\n}","old_text":"/// At the loop's head: its written invariants hold.\nfn assume_written(mut vc: smt.Vc, written: List[ast.Expr]) {\n  for x in written {\n    vc.spec += 1\n    v := smt.eval(mut vc, x)\n    vc.spec -= 1\n    b := smt.as_bool(mut vc, v)\n    smt.assume(mut vc, b)\n  }\n}"},{"name":"smt.written_kept","kind":"fn","old":"3486e167d2a11d9b","new":"7e258110d2d8a585","interface_changed":false,"affected":[],"module":"smt","text":"/// Checks that a loop's written invariants hold where each pass ends.\nfn written_kept(\n  mut vc: smt.Vc,\n  written: List[ast.Expr],\n  head: String,\n  ends: List[smt.PassEnd],\n) {\n  if len(written) == 0 {\n    return\n  }\n  pc := vc.pc\n  scopes := vc.scopes\n  dead := vc.dead\n  for e in ends {\n    vc.pc = e.pc\n    vc.scopes = e.scopes\n    vc.dead = false\n    for x in written {\n      vc.see += 1\n      v := smt.eval(mut vc, x)\n      vc.see -= 1\n      b := smt.as_bool(mut vc, v)\n      at := if e.again {\n        \"at a `continue` in\"\n      } else {\n        \"after a pass of\"\n      }\n      if smt.start_goal(mut vc) {\n        smt.oblige(mut vc, \"invariant `\"\n          + text.expr_text(x, 0)\n          + \"` \"\n          + at\n          + \" `\"\n          + head\n          + \"`\", b)\n      }\n    }\n  }\n  vc.pc = pc\n  vc.scopes = scopes\n  vc.dead = dead\n}","old_text":"/// A loop's written invariants hold where each pass ends.\nfn written_kept(\n  mut vc: smt.Vc,\n  written: List[ast.Expr],\n  head: String,\n  ends: List[smt.PassEnd],\n) {\n  if len(written) == 0 {\n    return\n  }\n  pc := vc.pc\n  scopes := vc.scopes\n  dead := vc.dead\n  for e in ends {\n    vc.pc = e.pc\n    vc.scopes = e.scopes\n    vc.dead = false\n    for x in written {\n      vc.see += 1\n      v := smt.eval(mut vc, x)\n      vc.see -= 1\n      b := smt.as_bool(mut vc, v)\n      at := if e.again {\n        \"at a `continue` in\"\n      } else {\n        \"after a pass of\"\n      }\n      if smt.start_goal(mut vc) {\n        smt.oblige(mut vc, \"invariant `\"\n          + text.expr_text(x, 0)\n          + \"` \"\n          + at\n          + \" `\"\n          + head\n          + \"`\", b)\n      }\n    }\n  }\n  vc.pc = pc\n  vc.scopes = scopes\n  vc.dead = dead\n}"},{"name":"smt.entry_values","kind":"fn","old":"807af7a82a547d1b","new":"18c228e2263559cc","interface_changed":false,"affected":[],"module":"smt","text":"/// The variables a loop changes, with their values before it, bound as\n/// `$entry_x` in candidates.\nfn entry_values(\n  vc: smt.Vc,\n  body: ast.Expr,\n  c: ast.Expr,\n) -> List[(String, String, smt.Val)] {\n  mut names := smt.changed_vars(vc, body)\n  for x in smt.changed_vars(vc, c) {\n    mut names.insert(x)\n  }\n  mut out := []\n  for x in to_list(names).sorted() {\n    match smt.lookup(vc, x) {\n      Some(v) => mut out.push((x, \"$entry_\" + x, v)),\n      None => (),\n    }\n  }\n  out\n}","old_text":"/// The variables a loop changes, with their values before it: bound as\n/// `$entry_x` in candidates.\nfn entry_values(\n  vc: smt.Vc,\n  body: ast.Expr,\n  c: ast.Expr,\n) -> List[(String, String, smt.Val)] {\n  mut names := smt.changed_vars(vc, body)\n  for x in smt.changed_vars(vc, c) {\n    mut names.insert(x)\n  }\n  mut out := []\n  for x in to_list(names).sorted() {\n    match smt.lookup(vc, x) {\n      Some(v) => mut out.push((x, \"$entry_\" + x, v)),\n      None => (),\n    }\n  }\n  out\n}"},{"name":"smt.havoc_loop","kind":"fn","old":"30408f9adfe1b0b2","new":"656c4593d07c728e","interface_changed":false,"affected":[],"module":"smt","text":"/// Before a loop: every variable the loop may change takes any value.\nfn havoc_loop(mut vc: smt.Vc, body: ast.Expr, cond: Option[ast.Expr]) {\n  mut names := smt.changed_vars(vc, body)\n  match cond {\n    Some(c) => {\n      for x in smt.changed_vars(vc, c) {\n        mut names.insert(x)\n      }\n    },\n    None => (),\n  }\n  for x in names {\n    match smt.lookup(vc, x) {\n      Some(v) => {\n        ts := get(vc.declared, x) ?? []\n        // a list of a declared type: any valid one, its elements made by\n        // position (`refresh` would know nothing of them). The returned\n        // variable, if not annotated, has the result's type: `mut got :=\n        // []` is a list whose elements are then known.\n        shaped := match get(ts, 0) {\n          Some(t) => Some(t),\n          None => match vc.returned {\n            Some((r, t)) => if r == x {\n              Some(smt.unrefined(vc, t))\n            } else {\n              None\n            },\n            None => None,\n          },\n        }\n        nv := match (v, shaped) {\n          (smt.VList { id, .. }, Some(t)) => if contains(vc.keyed, id) {\n            smt.refresh(mut vc, v)\n          } else {\n            smt.shape(mut vc, t)\n          },\n          _ => smt.refresh(mut vc, v),\n        }\n        // whatever the loop does, a declared type still holds\n        for t in ts {\n          c := smt.check_type(mut vc, t, nv, [])\n          smt.assume(mut vc, c)\n        }\n        smt.set_var(mut vc, x, nv)\n      },\n      None => (),\n    }\n  }\n}","old_text":"/// Before a loop: every variable the loop may change takes any value.\nfn havoc_loop(mut vc: smt.Vc, body: ast.Expr, cond: Option[ast.Expr]) {\n  mut names := smt.changed_vars(vc, body)\n  match cond {\n    Some(c) => {\n      for x in smt.changed_vars(vc, c) {\n        mut names.insert(x)\n      }\n    },\n    None => (),\n  }\n  for x in names {\n    match smt.lookup(vc, x) {\n      Some(v) => {\n        ts := get(vc.declared, x) ?? []\n        // a list of a declared type: any valid one, its elements made by\n        // position (`refresh` would know nothing of them)\n        // (the variable returned, not annotated: of the result's type,\n        // `mut got := []` a list whose elements are then known)\n        shaped := match get(ts, 0) {\n          Some(t) => Some(t),\n          None => match vc.returned {\n            Some((r, t)) => if r == x {\n              Some(smt.unrefined(vc, t))\n            } else {\n              None\n            },\n            None => None,\n          },\n        }\n        nv := match (v, shaped) {\n          (smt.VList { id, .. }, Some(t)) => if contains(vc.keyed, id) {\n            smt.refresh(mut vc, v)\n          } else {\n            smt.shape(mut vc, t)\n          },\n          _ => smt.refresh(mut vc, v),\n        }\n        // whatever the loop does, a declared type still holds\n        for t in ts {\n          c := smt.check_type(mut vc, t, nv, [])\n          smt.assume(mut vc, c)\n        }\n        smt.set_var(mut vc, x, nv)\n      },\n      None => (),\n    }\n  }\n}"},{"name":"smt.bounds","kind":"fn","old":"79a55cc710557066","new":"6e80cfe692d24055","interface_changed":false,"affected":[],"module":"smt","text":"/// Candidate bounds of a loop: for each comparison in its condition, how\n/// far it is from becoming false. With `||`, each side's: one of them, or\n/// a pair compared in order, may be what goes down.\nfn bounds(c: ast.Expr) -> List[ast.Expr] {\n  sub := (a: ast.Expr, b: ast.Expr) -> smt.bin(ast.Sub, a, b)\n  plus1 := (e: ast.Expr) -> smt.bin(ast.Add, e, ast.IntLit(1))\n  match c {\n    ast.Binary { op, left, right } => match op {\n      ast.And | ast.Or => smt.bounds(left) + smt.bounds(right),\n      ast.Less => [sub(right, left)],\n      ast.LessEq => [plus1(sub(right, left))],\n      ast.Greater => [sub(left, right)],\n      ast.GreaterEq => [plus1(sub(left, right))],\n      ast.NotEqual => [sub(left, right), sub(right, left)],\n      _ => [],\n    },\n    _ => [],\n  }\n}","old_text":"/// Candidate bounds of a loop: for each comparison in its condition, how\n/// far it is from becoming false (with `||`, each side's: one of them, or a\n/// pair of them compared in order, may be what goes down).\nfn bounds(c: ast.Expr) -> List[ast.Expr] {\n  sub := (a: ast.Expr, b: ast.Expr) -> smt.bin(ast.Sub, a, b)\n  plus1 := (e: ast.Expr) -> smt.bin(ast.Add, e, ast.IntLit(1))\n  match c {\n    ast.Binary { op, left, right } => match op {\n      ast.And | ast.Or => smt.bounds(left) + smt.bounds(right),\n      ast.Less => [sub(right, left)],\n      ast.LessEq => [plus1(sub(right, left))],\n      ast.Greater => [sub(left, right)],\n      ast.GreaterEq => [plus1(sub(left, right))],\n      ast.NotEqual => [sub(left, right), sub(right, left)],\n      _ => [],\n    },\n    _ => [],\n  }\n}"},{"name":"smt.candidate_key","kind":"fn","old":"c6d686813752ed97","new":"4ccc56cbaf5f8336","interface_changed":false,"affected":[],"module":"smt","text":"/// A candidate's text, which also tells candidates apart.\nfn candidate_key(k: smt.Candidate) -> String {\n  match k.it {\n    Some(x) => text.expr_text(k.e, 0) + \" (it = \" + x + \")\",\n    None => text.expr_text(k.e, 0),\n  }\n}","old_text":"/// How a candidate is shown (and told apart).\nfn candidate_key(k: smt.Candidate) -> String {\n  match k.it {\n    Some(x) => text.expr_text(k.e, 0) + \" (it = \" + x + \")\",\n    None => text.expr_text(k.e, 0),\n  }\n}"},{"name":"smt.invariant_candidates","kind":"fn","old":"8699221464f89236","new":"788975f2404a7e88","interface_changed":false,"affected":[],"module":"smt","text":"/// The candidates for `while c`'s invariants: the condition's comparisons\n/// made non-strict, the `ensures` of the returned variable, the\n/// `requires`, and each integer the loop changes compared with its entry\n/// value, 0, the integer parameters and the other integers it changes.\nfn invariant_candidates(\n  vc: smt.Vc,\n  c: ast.Expr,\n  entry: List[(String, String, smt.Val)],\n) -> List[smt.Candidate] {\n  plain := (e: ast.Expr) -> smt.Candidate { e, it: None }\n  mut out := []\n  for a in smt.comparisons(c) {\n    match a {\n      ast.Binary { op, left, right } => match op {\n        ast.Less | ast.LessEq => mut out.push(plain(smt.bin(ast.LessEq, left, right))),\n        ast.Greater | ast.GreaterEq => mut out.push(plain(smt.bin(ast.GreaterEq, left, right))),\n        ast.NotEqual => {\n          out += [\n            plain(smt.bin(ast.LessEq, left, right)),\n            plain(smt.bin(ast.GreaterEq, left, right)),\n          ]\n        },\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  changed := entry.map(x -> x.0)\n  // a `for` over a list (`for_loop`): each `ensures` of the returned\n  // variable over the elements visited so far, with `take($xs, $i)` in\n  // place of the list (and of `it`, when the list is what is returned)\n  match c {\n    ast.Binary { op: ast.Less, left: ast.Var(i), right: ast.Call { args: [ast.Var(xs)], .. } } => match get(vc.for_lists, xs) {\n      Some(list) => {\n        visited := ast.Call {\n          callee: ast.Var(\"take\"),\n          args: [ast.Var(xs), ast.Var(i)],\n        }\n        for (e, x) in vc.hints {\n          if contains(changed, x) || list == ast.Var(x) {\n            k := walk.rewrite_expr(e, y ->\n              if y == list || list == ast.Var(x) && y == ast.Var(\"it\") {\n                visited\n              } else {\n                y\n              })\n            if k != e {\n              mut out.push(\n                smt.Candidate { e: k, it: if list == ast.Var(x) {\n                  None\n                } else {\n                  Some(x)\n                } },\n              )\n            }\n          }\n        }\n      },\n      None => (),\n    },\n    _ => (),\n  }\n  for (e, x) in vc.hints {\n    if contains(changed, x) {\n      mut out.push(smt.Candidate { e, it: Some(x) })\n    }\n  }\n  for r in vc.requires_hints {\n    mut out.push(plain(r))\n  }\n  ints := entry.filter(\n    x -> match x.2 {\n      smt.VInt(_) => true,\n      _ => false,\n    },\n  )\n  params := vc.params\n    .filter(p -> match p.1 {\n      smt.VInt(_) => !contains(changed, p.0),\n      _ => false,\n    })\n    .map(p -> p.0)\n  for (x, ex, _) in ints {\n    out += [\n      plain(smt.bin(ast.GreaterEq, ast.Var(x), ast.Var(ex))),\n      plain(smt.bin(ast.LessEq, ast.Var(x), ast.Var(ex))),\n      plain(smt.bin(ast.GreaterEq, ast.Var(x), ast.IntLit(0))),\n    ]\n    for y in params + ints.map(i -> i.0).filter(y -> y != x) {\n      out += [\n        plain(smt.bin(ast.LessEq, ast.Var(x), ast.Var(y))),\n        plain(smt.bin(ast.GreaterEq, ast.Var(x), ast.Var(y))),\n      ]\n    }\n  }\n  mut seen := Set[String] {}\n  mut kept := []\n  for k in out {\n    key := smt.candidate_key(k)\n    if !contains(seen, key) {\n      mut seen.insert(key)\n      mut kept.push(k)\n    }\n  }\n  take(kept, smt.max_candidates())\n}","old_text":"/// The candidates for `while c`'s invariants: the condition's comparisons\n/// made non-strict, the `ensures` of the variable returned, the\n/// `requires`, and each integer the loop changes against its value on\n/// entry, 0, the integer parameters and the other integers it changes.\nfn invariant_candidates(\n  vc: smt.Vc,\n  c: ast.Expr,\n  entry: List[(String, String, smt.Val)],\n) -> List[smt.Candidate] {\n  plain := (e: ast.Expr) -> smt.Candidate { e, it: None }\n  mut out := []\n  for a in smt.comparisons(c) {\n    match a {\n      ast.Binary { op, left, right } => match op {\n        ast.Less | ast.LessEq => mut out.push(plain(smt.bin(ast.LessEq, left, right))),\n        ast.Greater | ast.GreaterEq => mut out.push(plain(smt.bin(ast.GreaterEq, left, right))),\n        ast.NotEqual => {\n          out += [\n            plain(smt.bin(ast.LessEq, left, right)),\n            plain(smt.bin(ast.GreaterEq, left, right)),\n          ]\n        },\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  changed := entry.map(x -> x.0)\n  // a `for` over a list (`for_loop`): each `ensures` of the variable\n  // returned over the elements visited so far, `take($xs, $i)` in place of\n  // the list (and of `it`, when the list is what is returned)\n  match c {\n    ast.Binary { op: ast.Less, left: ast.Var(i), right: ast.Call { args: [ast.Var(xs)], .. } } => match get(vc.for_lists, xs) {\n      Some(list) => {\n        visited := ast.Call {\n          callee: ast.Var(\"take\"),\n          args: [ast.Var(xs), ast.Var(i)],\n        }\n        for (e, x) in vc.hints {\n          if contains(changed, x) || list == ast.Var(x) {\n            k := walk.rewrite_expr(e, y ->\n              if y == list || list == ast.Var(x) && y == ast.Var(\"it\") {\n                visited\n              } else {\n                y\n              })\n            if k != e {\n              mut out.push(\n                smt.Candidate { e: k, it: if list == ast.Var(x) {\n                  None\n                } else {\n                  Some(x)\n                } },\n              )\n            }\n          }\n        }\n      },\n      None => (),\n    },\n    _ => (),\n  }\n  for (e, x) in vc.hints {\n    if contains(changed, x) {\n      mut out.push(smt.Candidate { e, it: Some(x) })\n    }\n  }\n  for r in vc.requires_hints {\n    mut out.push(plain(r))\n  }\n  ints := entry.filter(\n    x -> match x.2 {\n      smt.VInt(_) => true,\n      _ => false,\n    },\n  )\n  params := vc.params\n    .filter(p -> match p.1 {\n      smt.VInt(_) => !contains(changed, p.0),\n      _ => false,\n    })\n    .map(p -> p.0)\n  for (x, ex, _) in ints {\n    out += [\n      plain(smt.bin(ast.GreaterEq, ast.Var(x), ast.Var(ex))),\n      plain(smt.bin(ast.LessEq, ast.Var(x), ast.Var(ex))),\n      plain(smt.bin(ast.GreaterEq, ast.Var(x), ast.IntLit(0))),\n    ]\n    for y in params + ints.map(i -> i.0).filter(y -> y != x) {\n      out += [\n        plain(smt.bin(ast.LessEq, ast.Var(x), ast.Var(y))),\n        plain(smt.bin(ast.GreaterEq, ast.Var(x), ast.Var(y))),\n      ]\n    }\n  }\n  mut seen := Set[String] {}\n  mut kept := []\n  for k in out {\n    key := smt.candidate_key(k)\n    if !contains(seen, key) {\n      mut seen.insert(key)\n      mut kept.push(k)\n    }\n  }\n  take(kept, smt.max_candidates())\n}"},{"name":"smt.candidate_value","kind":"fn","old":"2be0d8438f36f7c0","new":"a68cd697a2f7914f","interface_changed":false,"affected":[],"module":"smt","text":"/// A candidate's value in the current state (`$entry_x` as before the\n/// loop, `old x` as at the function's start). `None` when it isn't a known\n/// Bool.\nfn candidate_value(\n  mut vc: smt.Vc,\n  k: smt.Candidate,\n  entry: List[(String, String, smt.Val)],\n) -> Option[String] {\n  mut layer := dict(entry.map(x -> (x.1, x.2)))\n  match k.it {\n    Some(x) => mut layer.insert(\"it\", smt.lookup(vc, x)?),\n    None => (),\n  }\n  mut vc.scopes.push(layer)\n  olds := vc.olds\n  match olds {\n    None => {\n      vc.olds = Some(dict(vc.params))\n    },\n    Some(_) => (),\n  }\n  vc.spec += 1\n  v := smt.eval(mut vc, k.e)\n  vc.spec -= 1\n  vc.olds = olds\n  vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n  match v {\n    smt.VBool(t) => Some(t),\n    _ => None,\n  }\n}","old_text":"/// A candidate's value in the current state (`$entry_x` as before the\n/// loop, `old x` as where the function started). `None` when it isn't a\n/// known Bool.\nfn candidate_value(\n  mut vc: smt.Vc,\n  k: smt.Candidate,\n  entry: List[(String, String, smt.Val)],\n) -> Option[String] {\n  mut layer := dict(entry.map(x -> (x.1, x.2)))\n  match k.it {\n    Some(x) => mut layer.insert(\"it\", smt.lookup(vc, x)?),\n    None => (),\n  }\n  mut vc.scopes.push(layer)\n  olds := vc.olds\n  match olds {\n    None => {\n      vc.olds = Some(dict(vc.params))\n    },\n    Some(_) => (),\n  }\n  vc.spec += 1\n  v := smt.eval(mut vc, k.e)\n  vc.spec -= 1\n  vc.olds = olds\n  vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n  match v {\n    smt.VBool(t) => Some(t),\n    _ => None,\n  }\n}"},{"name":"smt.ask","kind":"fn","old":"9d9ce4dc2cbb24b8","new":"9e915e8c5563dfee","interface_changed":false,"affected":[],"module":"smt","text":"/// The solver's answer to `script`. It comes from an earlier run, or from\n/// a running solver (`Vc.live`) that is asked now while the run waits.\n/// Otherwise the script is recorded as needed and the run is repeated once\n/// it is answered.\nfn ask(mut vc: smt.Vc, script: String) -> Option[String] {\n  answer := match get(vc.answers, script) {\n    Some(out) => Some(out),\n    None => if vc.live != \"\" {\n      out := smt.question_answer(\n        script,\n        smt.solver_pool_run(vc.live, smt.question_job(script)),\n      )\n      mut vc.answers.insert(script, out)\n      Some(out)\n    } else {\n      if !contains(vc.pending, script) {\n        mut vc.pending.push(script)\n      }\n      None\n    },\n  }\n  match answer {\n    Some(out) => if smt.is_search(script) {\n      vc.search_units += smt.info_number(out, \"(:rlimit \")\n      vc.search_micros += smt.info_number(out, \"(:strata-micros \")\n      if starts_with(out, \"budget\") {\n        vc.search_cut = true\n      }\n    },\n    None => (),\n  }\n  answer\n}","old_text":"/// The solver's answer to `script`, when a run before this one asked it,\n/// or, with a solver kept running (`Vc.live`), once it answers (asked\n/// now, the run waiting); else the script is asked for (the run is then\n/// done again, answered).\nfn ask(mut vc: smt.Vc, script: String) -> Option[String] {\n  answer := match get(vc.answers, script) {\n    Some(out) => Some(out),\n    None => if vc.live != \"\" {\n      out := smt.question_answer(\n        script,\n        smt.solver_pool_run(vc.live, smt.question_job(script)),\n      )\n      mut vc.answers.insert(script, out)\n      Some(out)\n    } else {\n      if !contains(vc.pending, script) {\n        mut vc.pending.push(script)\n      }\n      None\n    },\n  }\n  match answer {\n    Some(out) => if smt.is_search(script) {\n      vc.search_units += smt.info_number(out, \"(:rlimit \")\n      vc.search_micros += smt.info_number(out, \"(:strata-micros \")\n      if starts_with(out, \"budget\") {\n        vc.search_cut = true\n      }\n    },\n    None => (),\n  }\n  answer\n}"},{"name":"smt.drop_falsifiable","kind":"fn","old":"8529f67442729fa3","new":"822e20398e1ee6d1","interface_changed":false,"affected":[],"module":"smt","text":"/// Drops (in `alive`) each term that can be false under `pc`; a `None` term\n/// is dropped. Returns whether any was dropped. An unanswered query drops\n/// them all, and the run is repeated with its answer.\nfn drop_falsifiable(\n  mut vc: smt.Vc,\n  pc: List[String],\n  terms: List[Option[String]],\n  mut alive: List[Bool],\n) -> Bool {\n  mut dropped := false\n  for (k, t) in enumerate(terms) {\n    if get(alive, k) ?? false && t == None {\n      alive = take(alive, k) + [false] + drop(alive, k + 1)\n      dropped = true\n    }\n  }\n  while true {\n    live := range(0, len(terms)).filter(k -> get(alive, k) ?? false)\n    if len(live) == 0 {\n      return dropped\n    }\n    goal := smt.and_all(live.map(k -> (get(terms, k) ?? None) ?? \"\"))\n    ob := smt.Obligation {\n      what: \"invariant\",\n      goal,\n      pc,\n      facts: len(vc.facts),\n    }\n    script := smt.header(vc) + smt.body(vc, ob, [])\n    head := index_of(script, \"(check-sat)\") ?? byte_len(script)\n    mut defs := \"\"\n    mut names := []\n    for (j, k) in enumerate(live) {\n      defs += f\"(declare-const inv{j} Bool)\\n(assert (= inv{j} \"\n        + ((get(terms, k) ?? None) ?? \"true\")\n        + \"))\\n\"\n      mut names.push(f\"inv{j}\")\n    }\n    q := byte_slice(script, 0, head)\n      + defs\n      + \"(check-sat)\\n(get-value (\"\n      + join(names, \" \")\n      + \"))\\n\"\n    out := match smt.ask(mut vc, smt.search_question(vc, q)) {\n      Some(o) => o,\n      None => {\n        alive = alive.map(_ -> false)\n        return true\n      },\n    }\n    ls := lines(out)\n    first := trim(get(ls, 0) ?? \"\")\n    if first != \"unsat\"\n      && first != \"sat\"\n      && (vc.cheap > 0 || first == \"budget\") {\n      // no answer, and no more searching: at a proof's limit, or the\n      // search budget used up\n      alive = alive.map(_ -> false)\n      return true\n    }\n    if first == \"unsat\" {\n      return dropped\n    } else if first == \"sat\" {\n      vals := smt.values_of(join(drop(ls, 1), \"\\n\"))\n      mut any := false\n      for (j, k) in enumerate(live) {\n        if trim(get(vals, f\"inv{j}\") ?? \"\") != \"true\" {\n          alive = take(alive, k) + [false] + drop(alive, k + 1)\n          any = true\n        }\n      }\n      if !any {\n        // a model that falsifies none: give up on them all\n        for k in live {\n          alive = take(alive, k) + [false] + drop(alive, k + 1)\n        }\n      }\n      dropped = true\n    } else {\n      // the solver gave up on them together: each on its own, kept if\n      // proven\n      for k in live {\n        one := smt.Obligation {\n          what: \"invariant\",\n          goal: (get(terms, k) ?? None) ?? \"\",\n          pc,\n          facts: len(vc.facts),\n        }\n        o := smt.ask(mut vc, smt.search_question(\n          vc,\n          smt.header(vc) + smt.body(vc, one, []),\n        )) ?? \"\"\n        if trim(get(lines(o), 0) ?? \"\") != \"unsat\" {\n          alive = take(alive, k) + [false] + drop(alive, k + 1)\n        }\n      }\n      return true\n    }\n  }\n  dropped\n}","old_text":"/// Drop (in `alive`) each term that can be false under `pc`; a term that\n/// is `None` is dropped. Whether any was dropped. (A query not answered\n/// yet drops them all: the run is done again with its answer.)\nfn drop_falsifiable(\n  mut vc: smt.Vc,\n  pc: List[String],\n  terms: List[Option[String]],\n  mut alive: List[Bool],\n) -> Bool {\n  mut dropped := false\n  for (k, t) in enumerate(terms) {\n    if get(alive, k) ?? false && t == None {\n      alive = take(alive, k) + [false] + drop(alive, k + 1)\n      dropped = true\n    }\n  }\n  while true {\n    live := range(0, len(terms)).filter(k -> get(alive, k) ?? false)\n    if len(live) == 0 {\n      return dropped\n    }\n    goal := smt.and_all(live.map(k -> (get(terms, k) ?? None) ?? \"\"))\n    ob := smt.Obligation {\n      what: \"invariant\",\n      goal,\n      pc,\n      facts: len(vc.facts),\n    }\n    script := smt.header(vc) + smt.body(vc, ob, [])\n    head := index_of(script, \"(check-sat)\") ?? byte_len(script)\n    mut defs := \"\"\n    mut names := []\n    for (j, k) in enumerate(live) {\n      defs += f\"(declare-const inv{j} Bool)\\n(assert (= inv{j} \"\n        + ((get(terms, k) ?? None) ?? \"true\")\n        + \"))\\n\"\n      mut names.push(f\"inv{j}\")\n    }\n    q := byte_slice(script, 0, head)\n      + defs\n      + \"(check-sat)\\n(get-value (\"\n      + join(names, \" \")\n      + \"))\\n\"\n    out := match smt.ask(mut vc, smt.search_question(vc, q)) {\n      Some(o) => o,\n      None => {\n        alive = alive.map(_ -> false)\n        return true\n      },\n    }\n    ls := lines(out)\n    first := trim(get(ls, 0) ?? \"\")\n    if first != \"unsat\"\n      && first != \"sat\"\n      && (vc.cheap > 0 || first == \"budget\") {\n      // (no answer, and no more searching: at a proof's limit, or the\n      // search budget used up)\n      alive = alive.map(_ -> false)\n      return true\n    }\n    if first == \"unsat\" {\n      return dropped\n    } else if first == \"sat\" {\n      vals := smt.values_of(join(drop(ls, 1), \"\\n\"))\n      mut any := false\n      for (j, k) in enumerate(live) {\n        if trim(get(vals, f\"inv{j}\") ?? \"\") != \"true\" {\n          alive = take(alive, k) + [false] + drop(alive, k + 1)\n          any = true\n        }\n      }\n      if !any {\n        // (a model that falsifies none: give up on them all)\n        for k in live {\n          alive = take(alive, k) + [false] + drop(alive, k + 1)\n        }\n      }\n      dropped = true\n    } else {\n      // the solver gave up on them together: each on its own, kept if\n      // proven\n      for k in live {\n        one := smt.Obligation {\n          what: \"invariant\",\n          goal: (get(terms, k) ?? None) ?? \"\",\n          pc,\n          facts: len(vc.facts),\n        }\n        o := smt.ask(mut vc, smt.search_question(\n          vc,\n          smt.header(vc) + smt.body(vc, one, []),\n        )) ?? \"\"\n        if trim(get(lines(o), 0) ?? \"\") != \"unsat\" {\n          alive = take(alive, k) + [false] + drop(alive, k + 1)\n        }\n      }\n      return true\n    }\n  }\n  dropped\n}"},{"name":"smt.infer_invariants","kind":"fn","old":"c392bdcf14114a21","new":"d8ae2e2e501b944b","interface_changed":false,"affected":[],"module":"smt","text":"/// The facts every pass of `while c { body }` keeps, from a list of\n/// candidates (Houdini): drop those that can be false on entry; then, from\n/// any state where the rest and the condition hold, run one pass and drop\n/// those that can be false after it, until a pass drops nothing.\nfn infer_invariants(\n  mut vc: smt.Vc,\n  c: ast.Expr,\n  body: ast.Expr,\n  entry: List[(String, String, smt.Val)],\n  written: List[ast.Expr],\n) -> List[smt.Candidate] {\n  // inner loops of a trial infer nothing\n  if vc.trial > 0 || vc.spec > 0 || vc.dead {\n    return []\n  }\n  cands := smt.invariant_candidates(vc, c, entry)\n  if len(cands) == 0 {\n    return []\n  }\n  // on entry\n  mut at_entry := []\n  for k in cands {\n    mut at_entry.push(smt.candidate_value(mut vc, k, entry))\n  }\n  mut alive := at_entry.map(t -> t != None)\n  pc0 := vc.pc\n  _ := smt.drop_falsifiable(mut vc, pc0, at_entry, mut alive)\n  // after a pass, from the head\n  for _ in 0..len(cands) + 1 {\n    if !alive.any(a -> a) {\n      break\n    }\n    scopes := vc.scopes\n    n_pc := len(vc.pc)\n    dead := vc.dead\n    n_ob := len(vc.obligations)\n    n_loops := len(vc.loops)\n    n_rec := len(vc.rec_sites)\n    n_term := len(vc.term_obs)\n    returns := vc.returns\n    vc.returns = []\n    vc.trial += 1\n    vc.spec += 1\n    smt.havoc_loop(mut vc, body, Some(c))\n    // the written invariants are proven on their own with these, so\n    // together they hold\n    for x in written {\n      v := smt.eval(mut vc, x)\n      b := smt.as_bool(mut vc, v)\n      mut vc.pc.push(b)\n    }\n    for (k, cand) in enumerate(cands) {\n      if get(alive, k) ?? false {\n        match smt.candidate_value(mut vc, cand, entry) {\n          Some(t) => mut vc.pc.push(t),\n          None => (),\n        }\n      }\n    }\n    cv := smt.eval(mut vc, c)\n    cb := smt.as_bool(mut vc, cv)\n    mut vc.pc.push(cb)\n    base := len(vc.pc)\n    depth := len(vc.scopes)\n    mut vc.breaks.push([])\n    mut vc.continues.push([])\n    wiped0 := vc.wiped\n    vc.wiped = []\n    _ := smt.eval(mut vc, body)\n    vc.breaks = take(vc.breaks, len(vc.breaks) - 1)\n    // kept where every pass ends\n    ends := smt.pass_ends(mut vc, depth)\n    // a candidate naming a variable that ends a pass as a callee's\n    // write-back (any value of its type) is dropped without asking\n    if vc.wiped != [] {\n      for e in ends {\n        for (k, cand) in enumerate(cands) {\n          if get(alive, k) ?? false\n            && smt.candidate_roots(cand).any(\n              x -> match smt.scope_value(e.scopes, x) {\n                Some(v) => contains(vc.wiped, v),\n                None => false,\n              },\n            ) {\n            alive = take(alive, k) + [false] + drop(alive, k + 1)\n          }\n        }\n      }\n    }\n    vc.wiped = wiped0\n    pc_after := take(vc.pc, base)\n    mut after := cands.map(_ -> Some(\"true\"))\n    for e in ends {\n      vc.pc = e.pc\n      vc.scopes = e.scopes\n      for (k, cand) in enumerate(cands) {\n        v := if get(alive, k) ?? false {\n          smt.candidate_value(mut vc, cand, entry)\n        } else {\n          None\n        }\n        after = take(after, k)\n          + [match (get(after, k) ?? None, v) {\n            (Some(acc), Some(x)) => Some(smt.and_all(\n              [acc, smt.implies(smt.and_all(drop(e.pc, base)), x)],\n            )),\n            _ => None,\n          }]\n          + drop(after, k + 1)\n      }\n    }\n    vc.pc = pc_after\n    vc.spec -= 1\n    vc.trial -= 1\n    vc.returns = returns\n    vc.scopes = scopes\n    vc.pc = take(vc.pc, n_pc)\n    vc.dead = dead\n    vc.obligations = take(vc.obligations, n_ob)\n    vc.loops = take(vc.loops, n_loops)\n    vc.rec_sites = take(vc.rec_sites, n_rec)\n    vc.term_obs = take(vc.term_obs, n_term)\n    if !smt.drop_falsifiable(mut vc, pc_after, after, mut alive) {\n      break\n    }\n  }\n  mut out := []\n  for (k, cand) in enumerate(cands) {\n    if get(alive, k) ?? false {\n      mut out.push(cand)\n    }\n  }\n  out\n}","old_text":"/// Facts every pass of `while c { body }` keeps, from a list of candidates\n/// (Houdini): those that can be false on entry are dropped, then, from any\n/// state where the others and the condition hold, one pass runs and those\n/// that can be false after it are dropped, until a pass drops nothing.\nfn infer_invariants(\n  mut vc: smt.Vc,\n  c: ast.Expr,\n  body: ast.Expr,\n  entry: List[(String, String, smt.Val)],\n  written: List[ast.Expr],\n) -> List[smt.Candidate] {\n  // (inner loops of a trial infer nothing)\n  if vc.trial > 0 || vc.spec > 0 || vc.dead {\n    return []\n  }\n  cands := smt.invariant_candidates(vc, c, entry)\n  if len(cands) == 0 {\n    return []\n  }\n  // on entry\n  mut at_entry := []\n  for k in cands {\n    mut at_entry.push(smt.candidate_value(mut vc, k, entry))\n  }\n  mut alive := at_entry.map(t -> t != None)\n  pc0 := vc.pc\n  _ := smt.drop_falsifiable(mut vc, pc0, at_entry, mut alive)\n  // after a pass, from the head\n  for _ in 0..len(cands) + 1 {\n    if !alive.any(a -> a) {\n      break\n    }\n    scopes := vc.scopes\n    n_pc := len(vc.pc)\n    dead := vc.dead\n    n_ob := len(vc.obligations)\n    n_loops := len(vc.loops)\n    n_rec := len(vc.rec_sites)\n    n_term := len(vc.term_obs)\n    returns := vc.returns\n    vc.returns = []\n    vc.trial += 1\n    vc.spec += 1\n    smt.havoc_loop(mut vc, body, Some(c))\n    // (the written invariants are proven on their own, with these:\n    // together they hold)\n    for x in written {\n      v := smt.eval(mut vc, x)\n      b := smt.as_bool(mut vc, v)\n      mut vc.pc.push(b)\n    }\n    for (k, cand) in enumerate(cands) {\n      if get(alive, k) ?? false {\n        match smt.candidate_value(mut vc, cand, entry) {\n          Some(t) => mut vc.pc.push(t),\n          None => (),\n        }\n      }\n    }\n    cv := smt.eval(mut vc, c)\n    cb := smt.as_bool(mut vc, cv)\n    mut vc.pc.push(cb)\n    base := len(vc.pc)\n    depth := len(vc.scopes)\n    mut vc.breaks.push([])\n    mut vc.continues.push([])\n    wiped0 := vc.wiped\n    vc.wiped = []\n    _ := smt.eval(mut vc, body)\n    vc.breaks = take(vc.breaks, len(vc.breaks) - 1)\n    // kept where every pass ends\n    ends := smt.pass_ends(mut vc, depth)\n    // a candidate naming a variable that ends a pass as what a callee wrote\n    // back (any value of its type) is dropped without asking the solver\n    if vc.wiped != [] {\n      for e in ends {\n        for (k, cand) in enumerate(cands) {\n          if get(alive, k) ?? false\n            && smt.candidate_roots(cand).any(\n              x -> match smt.scope_value(e.scopes, x) {\n                Some(v) => contains(vc.wiped, v),\n                None => false,\n              },\n            ) {\n            alive = take(alive, k) + [false] + drop(alive, k + 1)\n          }\n        }\n      }\n    }\n    vc.wiped = wiped0\n    pc_after := take(vc.pc, base)\n    mut after := cands.map(_ -> Some(\"true\"))\n    for e in ends {\n      vc.pc = e.pc\n      vc.scopes = e.scopes\n      for (k, cand) in enumerate(cands) {\n        v := if get(alive, k) ?? false {\n          smt.candidate_value(mut vc, cand, entry)\n        } else {\n          None\n        }\n        after = take(after, k)\n          + [match (get(after, k) ?? None, v) {\n            (Some(acc), Some(x)) => Some(smt.and_all(\n              [acc, smt.implies(smt.and_all(drop(e.pc, base)), x)],\n            )),\n            _ => None,\n          }]\n          + drop(after, k + 1)\n      }\n    }\n    vc.pc = pc_after\n    vc.spec -= 1\n    vc.trial -= 1\n    vc.returns = returns\n    vc.scopes = scopes\n    vc.pc = take(vc.pc, n_pc)\n    vc.dead = dead\n    vc.obligations = take(vc.obligations, n_ob)\n    vc.loops = take(vc.loops, n_loops)\n    vc.rec_sites = take(vc.rec_sites, n_rec)\n    vc.term_obs = take(vc.term_obs, n_term)\n    if !smt.drop_falsifiable(mut vc, pc_after, after, mut alive) {\n      break\n    }\n  }\n  mut out := []\n  for (k, cand) in enumerate(cands) {\n    if get(alive, k) ?? false {\n      mut out.push(cand)\n    }\n  }\n  out\n}"},{"name":"smt.while_loop","kind":"fn","old":"f927d4aab2499376","new":"8830e46d0ee3e825","interface_changed":false,"affected":[],"module":"smt","text":"fn while_loop(mut vc: smt.Vc, c: ast.Expr, body: ast.Expr) {\n  head := \"while \" + text.expr_text(c, 0)\n  over_list := starts_with(head, \"while $for_i\")\n  written := text.loop_invariants(body)\n  smt.written_on_entry(mut vc, written, head)\n  entry := smt.entry_values(vc, body, c)\n  // the cost of this loop's search, for `verify` to report. With written\n  // invariants it only asks at a proof's limit.\n  infers := vc.trial == 0 && vc.spec == 0 && !vc.dead\n  units0 := vc.search_units\n  micros0 := vc.search_micros\n  cut0 := vc.search_cut\n  vc.search_cut = false\n  // a `for`'s index loop too: its candidates quantify over the elements\n  // visited, each question at most a probe's units\n  if written != [] || over_list {\n    vc.cheap += 1\n  }\n  invariants := smt.infer_invariants(mut vc, c, body, entry, written)\n  smt.havoc_loop(mut vc, body, Some(c))\n  smt.assume_written(mut vc, written)\n  // what every pass keeps holds at the head, minus what the declared types\n  // already say there\n  mut terms := []\n  for cand in invariants {\n    mut terms.push(smt.candidate_value(mut vc, cand, entry))\n  }\n  mut implied := terms.map(_ -> true)\n  pc0 := vc.pc\n  _ := smt.drop_falsifiable(mut vc, pc0, terms, mut implied)\n  mut kept := []\n  for (k, t) in enumerate(terms) {\n    match t {\n      Some(x) => if !(get(implied, k) ?? true) {\n        smt.assume(mut vc, x)\n        match get(invariants, k) {\n          Some(cand) => {\n            mut kept.push(cand)\n            mut vc.invariants.push(\n              \"invariant of `\"\n                + head\n                + \"`: \"\n                + smt.candidate_shown(cand)\n                + \" (inferred)\",\n            )\n          },\n          None => (),\n        }\n      },\n      None => (),\n    }\n  }\n  if written != [] || over_list {\n    vc.cheap -= 1\n  }\n  cut := vc.search_cut\n  vc.search_cut = cut0 || cut\n  if infers {\n    match smt.loop_index(vc.own_whiles, c, body) {\n      Some(at) => mut vc.found_loops.push(\n        smt.LoopFound {\n          at,\n          head,\n          shown: kept.map(k -> smt.candidate_shown(k)),\n          code: kept.map(k -> smt.candidate_code(k)),\n          units: vc.search_units - units0,\n          micros: vc.search_micros - micros0,\n          cut,\n          changed: entry.map(x -> x.0),\n        },\n      ),\n      None => (),\n    }\n  }\n  mut vc.breaks.push([])\n  mut vc.continues.push([])\n  cv := smt.eval(mut vc, c)\n  cb := smt.as_bool(mut vc, cv)\n  saved := vc.scopes\n  n := len(vc.pc)\n  mut vc.pc.push(cb)\n  // the candidate bounds before the pass, for termination (evaluated even\n  // with `--obligations`, which leaves them out): a `decreases` clause's\n  // measure, else the condition's bounds and the body's tested ones, singly\n  // and then in pairs compared in order\n  written_dec := text.decreases_text(body)\n  measures := if over_list {\n    []\n  } else if written_dec != \"\" {\n    text.decreases_of(body)\n  } else {\n    smt.loop_measures(vc, c, body)\n  }\n  tries := if written_dec != \"\" {\n    [range(0, len(measures))]\n  } else {\n    range(0, len(measures)).map(i -> [i])\n      + [[i, j] for i in 0..len(measures) for j in 0..len(measures) where i != j]\n  }\n  mut before := []\n  for m in measures {\n    vc.spec += 1\n    mv := smt.eval(mut vc, m)\n    vc.spec -= 1\n    mut before.push(smt.as_int(mut vc, mv))\n  }\n  _ := smt.eval(mut vc, body)\n  ends := smt.pass_ends(mut vc, len(saved))\n  smt.written_kept(mut vc, written, head, ends)\n  mut info := smt.LoopInfo {\n    what: head,\n    candidates: [],\n    always_exits: len(ends) == 0,\n    singles: if written_dec != \"\" {\n      0\n    } else {\n      len(measures)\n    },\n    written: written_dec,\n  }\n  if len(ends) > 0 {\n    // after every pass (the body's end, each `continue`): either the loop\n    // is over, or the bound went down\n    obs := smt.pass_measures(\n      mut vc,\n      Some(c),\n      measures,\n      before,\n      tries,\n      ends,\n      n + 1,\n      written_dec,\n      head,\n    )\n    info.candidates = [x for x in zip(tries.map(\n      t -> if written_dec != \"\" {\n        smt.try_shown(measures, t)\n      } else {\n        smt.candidate_text(measures, t)\n      },\n    ), obs)]\n  }\n  if !over_list {\n    mut vc.loops.push(info)\n  }\n  vc.pc = take(vc.pc, n)\n  vc.dead = false\n  vc.scopes = saved\n  // left when the condition is false, or at a `break`\n  breaks := get(vc.breaks, len(vc.breaks) - 1) ?? []\n  vc.breaks = take(vc.breaks, len(vc.breaks) - 1)\n  smt.leave_loop(mut vc, n, Some(smt.neg(cb)), breaks)\n}","old_text":"fn while_loop(mut vc: smt.Vc, c: ast.Expr, body: ast.Expr) {\n  head := \"while \" + text.expr_text(c, 0)\n  over_list := starts_with(head, \"while $for_i\")\n  written := text.loop_invariants(body)\n  smt.written_on_entry(mut vc, written, head)\n  entry := smt.entry_values(vc, body, c)\n  // (what this loop's search takes, for `verify` to tell; with written\n  // invariants it only asks at a proof's limit)\n  infers := vc.trial == 0 && vc.spec == 0 && !vc.dead\n  units0 := vc.search_units\n  micros0 := vc.search_micros\n  cut0 := vc.search_cut\n  vc.search_cut = false\n  // (a `for`'s index loop too: its candidates quantify over the elements\n  // visited, each question at most a probe's units)\n  if written != [] || over_list {\n    vc.cheap += 1\n  }\n  invariants := smt.infer_invariants(mut vc, c, body, entry, written)\n  smt.havoc_loop(mut vc, body, Some(c))\n  smt.assume_written(mut vc, written)\n  // what every pass keeps holds at the head; what the declared types\n  // already say there is left out\n  mut terms := []\n  for cand in invariants {\n    mut terms.push(smt.candidate_value(mut vc, cand, entry))\n  }\n  mut implied := terms.map(_ -> true)\n  pc0 := vc.pc\n  _ := smt.drop_falsifiable(mut vc, pc0, terms, mut implied)\n  mut kept := []\n  for (k, t) in enumerate(terms) {\n    match t {\n      Some(x) => if !(get(implied, k) ?? true) {\n        smt.assume(mut vc, x)\n        match get(invariants, k) {\n          Some(cand) => {\n            mut kept.push(cand)\n            mut vc.invariants.push(\n              \"invariant of `\"\n                + head\n                + \"`: \"\n                + smt.candidate_shown(cand)\n                + \" (inferred)\",\n            )\n          },\n          None => (),\n        }\n      },\n      None => (),\n    }\n  }\n  if written != [] || over_list {\n    vc.cheap -= 1\n  }\n  cut := vc.search_cut\n  vc.search_cut = cut0 || cut\n  if infers {\n    match smt.loop_index(vc.own_whiles, c, body) {\n      Some(at) => mut vc.found_loops.push(\n        smt.LoopFound {\n          at,\n          head,\n          shown: kept.map(k -> smt.candidate_shown(k)),\n          code: kept.map(k -> smt.candidate_code(k)),\n          units: vc.search_units - units0,\n          micros: vc.search_micros - micros0,\n          cut,\n          changed: entry.map(x -> x.0),\n        },\n      ),\n      None => (),\n    }\n  }\n  mut vc.breaks.push([])\n  mut vc.continues.push([])\n  cv := smt.eval(mut vc, c)\n  cb := smt.as_bool(mut vc, cv)\n  saved := vc.scopes\n  n := len(vc.pc)\n  mut vc.pc.push(cb)\n  // the candidate bounds, before the pass (for termination, which\n  // `--obligations` leaves out: evaluated all the same, as Rust does): a\n  // `decreases` clause's measure, else the condition's bounds and the\n  // body's tested ones, singly, then in pairs compared in order\n  written_dec := text.decreases_text(body)\n  measures := if over_list {\n    []\n  } else if written_dec != \"\" {\n    text.decreases_of(body)\n  } else {\n    smt.loop_measures(vc, c, body)\n  }\n  tries := if written_dec != \"\" {\n    [range(0, len(measures))]\n  } else {\n    range(0, len(measures)).map(i -> [i])\n      + [[i, j] for i in 0..len(measures) for j in 0..len(measures) where i != j]\n  }\n  mut before := []\n  for m in measures {\n    vc.spec += 1\n    mv := smt.eval(mut vc, m)\n    vc.spec -= 1\n    mut before.push(smt.as_int(mut vc, mv))\n  }\n  _ := smt.eval(mut vc, body)\n  ends := smt.pass_ends(mut vc, len(saved))\n  smt.written_kept(mut vc, written, head, ends)\n  mut info := smt.LoopInfo {\n    what: head,\n    candidates: [],\n    always_exits: len(ends) == 0,\n    singles: if written_dec != \"\" {\n      0\n    } else {\n      len(measures)\n    },\n    written: written_dec,\n  }\n  if len(ends) > 0 {\n    // after every pass (the body's end, each `continue`): either the loop\n    // is over, or the bound went down\n    obs := smt.pass_measures(\n      mut vc,\n      Some(c),\n      measures,\n      before,\n      tries,\n      ends,\n      n + 1,\n      written_dec,\n      head,\n    )\n    info.candidates = [x for x in zip(tries.map(\n      t -> if written_dec != \"\" {\n        smt.try_shown(measures, t)\n      } else {\n        smt.candidate_text(measures, t)\n      },\n    ), obs)]\n  }\n  if !over_list {\n    mut vc.loops.push(info)\n  }\n  vc.pc = take(vc.pc, n)\n  vc.dead = false\n  vc.scopes = saved\n  // left when the condition is false, or at a `break`\n  breaks := get(vc.breaks, len(vc.breaks) - 1) ?? []\n  vc.breaks = take(vc.breaks, len(vc.breaks) - 1)\n  smt.leave_loop(mut vc, n, Some(smt.neg(cb)), breaks)\n}"},{"name":"smt.for_loop","kind":"fn","old":"3ede144145952cd6","new":"0cc45346e95340b1","interface_changed":false,"affected":[],"module":"smt","text":"fn for_loop(mut vc: smt.Vc, p: ast.Pattern, xs: ast.Expr, body: ast.Expr) {\n  xv := smt.eval(mut vc, xs)\n  match xv {\n    smt.VList { .. } => (),\n    // over an iterator: `{ mut $iter := xs; loop { match mut $iter.next()\n    // { Some(p) => body, None => break } } }`\n    _ => {\n      mut vc.iter_fors.push(smt.head_of(vc, xv) ?? \"\")\n      it := f\"$iter_{vc.next_var}\"\n      mut vc.scopes.push(Dict[String, smt.Val] {})\n      smt.bind(mut vc, it, xv)\n      step := ast.MatchExpr { scrutinee: ast.MethodCall {\n        recv: ast.MutExpr(ast.Var(it)),\n        name: \"next\",\n        args: [],\n      }, binding: None, arms: [ast.Arm { comments: [], pat: ast.CtorPattern {\n        name: \"Some\",\n        args: ast.PositionalPats([p]),\n      }, body }, ast.Arm {\n        comments: [],\n        pat: ast.CtorPattern { name: \"None\", args: ast.NoPats },\n        body: ast.Block { stmts: [ast.Break], last: ast.UnitExpr },\n      }] }\n      smt.plain_loop(\n        mut vc,\n        ast.Block {\n          stmts: [ast.ExprStmt(step)],\n          last: ast.UnitExpr,\n        },\n      )\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      return\n    },\n  }\n  // over a list whose elements the `ensures` of what the loop changes are\n  // about: an index loop, whose invariants are inferred\n  if smt.infers_over_list(vc, body) {\n    // over a list: `while $i < len($xs) { p := $xs[$i]; $i += 1; body }`,\n    // so what a pass keeps is inferred as for a `while`, with the elements\n    // visited so far (`take($xs, $i)`) in place of the list\n    n := vc.next_var\n    vc.next_var += 1\n    xs_name := f\"$for_xs{n}\"\n    i_name := f\"$for_i{n}\"\n    mut vc.for_lists.insert(xs_name, xs)\n    mut vc.scopes.push(Dict[String, smt.Val] {})\n    smt.bind(mut vc, xs_name, xv)\n    smt.bind(mut vc, i_name, smt.VInt(\"0\"))\n    // the written invariants and `decreases` stay first, where loops look\n    clauses := match body {\n      ast.Block { stmts, .. } => stmts.filter(\n        s -> match s {\n          ast.Invariant(_) | ast.Decreases(_) => true,\n          _ => false,\n        },\n      ),\n      _ => [],\n    }\n    step := ast.Block { stmts: clauses\n      + [ast.Let { pat: p, ty: None, value: ast.Call {\n        callee: ast.Var(\"$at\"),\n        args: [ast.Var(xs_name), ast.Var(i_name)],\n      } }, ast.Assign { place: ast.Var(i_name), value: ast.Binary {\n        op: ast.Add,\n        left: ast.Var(i_name),\n        right: ast.IntLit(1),\n      } }, ast.ExprStmt(body)], last: ast.UnitExpr }\n    cond := ast.Binary {\n      op: ast.Less,\n      left: ast.Var(i_name),\n      right: ast.Call { callee: ast.Var(\"len\"), args: [ast.Var(xs_name)] },\n    }\n    smt.while_loop(mut vc, cond, step)\n    vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n    return\n  }\n  written := text.loop_invariants(body)\n  head := \"for \" + text.pattern_text(p) + \" in \" + text.expr_text(xs, 0)\n  smt.written_on_entry(mut vc, written, head)\n  smt.havoc_loop(mut vc, body, None)\n  smt.assume_written(mut vc, written)\n  mut vc.breaks.push([])\n  mut vc.continues.push([])\n  saved := vc.scopes\n  n := len(vc.pc)\n  x := match xv {\n    smt.VList { len, id } => {\n      mut vc.pc.push(f\"(> {len} 0)\")\n      smt.element(mut vc, id, \"true\")\n    },\n    _ => smt.Opaque(\"the elements of a list are not tracked\"),\n  }\n  mut vc.scopes.push(Dict[String, smt.Val] {})\n  mut binds := []\n  c := smt.pattern(mut vc, p, x, mut binds)\n  mut vc.pc.push(c)\n  for (name, b) in binds {\n    smt.bind(mut vc, name, b)\n  }\n  _ := smt.eval(mut vc, body)\n  ends := smt.pass_ends(mut vc, len(saved))\n  smt.written_kept(mut vc, written, head, ends)\n  vc.pc = take(vc.pc, n)\n  vc.dead = false\n  vc.scopes = saved\n  // after the last element the loop's variables are any values of their\n  // types and invariants, which covers a `break` too. If invariants were\n  // assumed, they are made afresh.\n  breaks := get(vc.breaks, len(vc.breaks) - 1) ?? []\n  vc.breaks = take(vc.breaks, len(vc.breaks) - 1)\n  if len(breaks) > 0 && len(written) > 0 {\n    smt.havoc_loop(mut vc, body, None)\n  }\n}","old_text":"fn for_loop(mut vc: smt.Vc, p: ast.Pattern, xs: ast.Expr, body: ast.Expr) {\n  xv := smt.eval(mut vc, xs)\n  match xv {\n    smt.VList { .. } => (),\n    // over an iterator, as Rust's checker lowers it: `{ mut $iter := xs;\n    // loop { match mut $iter.next() { Some(p) => body, None => break } } }`\n    _ => {\n      mut vc.iter_fors.push(smt.head_of(vc, xv) ?? \"\")\n      it := f\"$iter_{vc.next_var}\"\n      mut vc.scopes.push(Dict[String, smt.Val] {})\n      smt.bind(mut vc, it, xv)\n      step := ast.MatchExpr { scrutinee: ast.MethodCall {\n        recv: ast.MutExpr(ast.Var(it)),\n        name: \"next\",\n        args: [],\n      }, binding: None, arms: [ast.Arm { comments: [], pat: ast.CtorPattern {\n        name: \"Some\",\n        args: ast.PositionalPats([p]),\n      }, body }, ast.Arm {\n        comments: [],\n        pat: ast.CtorPattern { name: \"None\", args: ast.NoPats },\n        body: ast.Block { stmts: [ast.Break], last: ast.UnitExpr },\n      }] }\n      smt.plain_loop(\n        mut vc,\n        ast.Block {\n          stmts: [ast.ExprStmt(step)],\n          last: ast.UnitExpr,\n        },\n      )\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      return\n    },\n  }\n  // over a list whose elements the `ensures` of what the loop changes are\n  // about: an index loop, whose invariants are inferred\n  if smt.infers_over_list(vc, body) {\n    // over a list: `while $i < len($xs) { p := $xs[$i]; $i += 1; body }`,\n    // so that what a pass keeps is inferred as for a `while` (with the\n    // elements visited so far, `take($xs, $i)`, in place of the list)\n    n := vc.next_var\n    vc.next_var += 1\n    xs_name := f\"$for_xs{n}\"\n    i_name := f\"$for_i{n}\"\n    mut vc.for_lists.insert(xs_name, xs)\n    mut vc.scopes.push(Dict[String, smt.Val] {})\n    smt.bind(mut vc, xs_name, xv)\n    smt.bind(mut vc, i_name, smt.VInt(\"0\"))\n    // (the written invariants and `decreases` stay first, where loops look)\n    clauses := match body {\n      ast.Block { stmts, .. } => stmts.filter(\n        s -> match s {\n          ast.Invariant(_) | ast.Decreases(_) => true,\n          _ => false,\n        },\n      ),\n      _ => [],\n    }\n    step := ast.Block { stmts: clauses\n      + [ast.Let { pat: p, ty: None, value: ast.Call {\n        callee: ast.Var(\"$at\"),\n        args: [ast.Var(xs_name), ast.Var(i_name)],\n      } }, ast.Assign { place: ast.Var(i_name), value: ast.Binary {\n        op: ast.Add,\n        left: ast.Var(i_name),\n        right: ast.IntLit(1),\n      } }, ast.ExprStmt(body)], last: ast.UnitExpr }\n    cond := ast.Binary {\n      op: ast.Less,\n      left: ast.Var(i_name),\n      right: ast.Call { callee: ast.Var(\"len\"), args: [ast.Var(xs_name)] },\n    }\n    smt.while_loop(mut vc, cond, step)\n    vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n    return\n  }\n  written := text.loop_invariants(body)\n  head := \"for \" + text.pattern_text(p) + \" in \" + text.expr_text(xs, 0)\n  smt.written_on_entry(mut vc, written, head)\n  smt.havoc_loop(mut vc, body, None)\n  smt.assume_written(mut vc, written)\n  mut vc.breaks.push([])\n  mut vc.continues.push([])\n  saved := vc.scopes\n  n := len(vc.pc)\n  x := match xv {\n    smt.VList { len, id } => {\n      mut vc.pc.push(f\"(> {len} 0)\")\n      smt.element(mut vc, id, \"true\")\n    },\n    _ => smt.Opaque(\"the elements of a list are not tracked\"),\n  }\n  mut vc.scopes.push(Dict[String, smt.Val] {})\n  mut binds := []\n  c := smt.pattern(mut vc, p, x, mut binds)\n  mut vc.pc.push(c)\n  for (name, b) in binds {\n    smt.bind(mut vc, name, b)\n  }\n  _ := smt.eval(mut vc, body)\n  ends := smt.pass_ends(mut vc, len(saved))\n  smt.written_kept(mut vc, written, head, ends)\n  vc.pc = take(vc.pc, n)\n  vc.dead = false\n  vc.scopes = saved\n  // after the last element the loop's variables are any values of their\n  // types (and invariants), which covers a `break` too, unless invariants\n  // were assumed: then afresh\n  breaks := get(vc.breaks, len(vc.breaks) - 1) ?? []\n  vc.breaks = take(vc.breaks, len(vc.breaks) - 1)\n  if len(breaks) > 0 && len(written) > 0 {\n    smt.havoc_loop(mut vc, body, None)\n  }\n}"},{"name":"smt.jump","kind":"fn","old":"acd778c84e90529c","new":"43f494409685f671","interface_changed":false,"affected":[],"module":"smt","text":"/// A `break` or `continue`: records the path and the variables for the\n/// loop.\nfn jump(mut vc: smt.Vc, is_break: Bool) {\n  if !vc.dead {\n    j := smt.Jump { pc: vc.pc, scopes: vc.scopes }\n    if is_break {\n      match get(vc.breaks, len(vc.breaks) - 1) {\n        Some(frame) => {\n          vc.breaks = take(vc.breaks, len(vc.breaks) - 1) + [frame + [j]]\n        },\n        None => (),\n      }\n    } else {\n      match get(vc.continues, len(vc.continues) - 1) {\n        Some(frame) => {\n          vc.continues = take(vc.continues, len(vc.continues) - 1) + [frame + [j]]\n        },\n        None => (),\n      }\n    }\n  }\n  vc.dead = true\n}","old_text":"/// A `break` or `continue`: the path and the variables, for the loop.\nfn jump(mut vc: smt.Vc, is_break: Bool) {\n  if !vc.dead {\n    j := smt.Jump { pc: vc.pc, scopes: vc.scopes }\n    if is_break {\n      match get(vc.breaks, len(vc.breaks) - 1) {\n        Some(frame) => {\n          vc.breaks = take(vc.breaks, len(vc.breaks) - 1) + [frame + [j]]\n        },\n        None => (),\n      }\n    } else {\n      match get(vc.continues, len(vc.continues) - 1) {\n        Some(frame) => {\n          vc.continues = take(vc.continues, len(vc.continues) - 1) + [frame + [j]]\n        },\n        None => (),\n      }\n    }\n  }\n  vc.dead = true\n}"},{"name":"smt.encode","kind":"fn","old":"91c2881ed1729857","new":"d9810a3cc1f1bebc","interface_changed":false,"affected":[],"module":"smt","text":"/// Runs `f` symbolically, asking the solver what the encoding needs (loop\n/// invariant inference), and runs it again with each new answer until no\n/// answer is missing.\npub fn encode(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  sigs: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  f: ast.FnDecl,\n  label: String,\n) -> smt.Vc {\n  mut answers := Dict[String, String] {}\n  while true {\n    mut vc := smt.new_vc(fns, types, sigs, methods)\n    vc.answers = answers\n    smt.function(mut vc, f, label)\n    if len(vc.pending) == 0 || len(vc.gaps) > 0 {\n      return vc\n    }\n    for q in vc.pending {\n      flags := smt.question_flags(q)\n      script := byte_slice(q, index_of(q, \"\\n\") ?? 0, byte_len(q))\n      out := get(smt.run_script(\n        mut commands,\n        mut files,\n        scratch,\n        solver,\n        script,\n        flags,\n      ), 0) ?? \"\"\n      mut answers.insert(q, out)\n    }\n  }\n  smt.new_vc(fns, types, sigs, methods)\n}","old_text":"/// `f` run symbolically, the solver asked what the encoding needs (loop\n/// invariants' inference), the run done again with each new answer until\n/// it needs none it lacks.\npub fn encode(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  sigs: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  f: ast.FnDecl,\n  label: String,\n) -> smt.Vc {\n  mut answers := Dict[String, String] {}\n  while true {\n    mut vc := smt.new_vc(fns, types, sigs, methods)\n    vc.answers = answers\n    smt.function(mut vc, f, label)\n    if len(vc.pending) == 0 || len(vc.gaps) > 0 {\n      return vc\n    }\n    for q in vc.pending {\n      flags := smt.question_flags(q)\n      script := byte_slice(q, index_of(q, \"\\n\") ?? 0, byte_len(q))\n      out := get(smt.run_script(\n        mut commands,\n        mut files,\n        scratch,\n        solver,\n        script,\n        flags,\n      ), 0) ?? \"\"\n      mut answers.insert(q, out)\n    }\n  }\n  smt.new_vc(fns, types, sigs, methods)\n}"},{"name":"smt.Methods","kind":"type","old":"ab6a20034f6bf6a4","new":"74cdaf080d43817a","interface_changed":false,"affected":[],"module":"smt","text":"/// The traits and the types' own methods in scope, for method calls, and\n/// which functions a contract may see through.\npub type Methods = {\n  traits: List[ast.TraitDecl],\n  own: List[ast.FnDecl],\n  // the implementations of traits\n  impls: List[ast.ImplDecl],\n  // core's traits, whose methods are shown without the trait's name\n  core_traits: Set[String],\n  seen: Dict[String, smt.Seen],\n  // the types' own methods: (type name, method name)\n  own_types: List[(String, String)],\n  // the traits of core's code modules (`core.iter`, `core.channel`,\n  // `core.text`, `core.task`). Termination treats their methods as\n  // builtins.\n  code_traits: Set[String],\n  // implementations' methods a contract may see through, by `Trait::m@Type`,\n  // from termination. Absent ones are judged by `impl_seen`'s rule.\n  impl_seen: Dict[String, smt.Seen],\n  // what is seen through only by assuming it finishes (`terminates`):\n  // functions by name, implementations' methods by `Trait::m@Type` with\n  // their labels\n  assumed: Set[String],\n  assumed_impls: Dict[String, String],\n  // whether `verify` asks for counterexamples it can show (`Vc.examples`)\n  examples: Bool,\n  // the types whose declaration reaches a refinement (`refined_types`),\n  // found once for the given types. With `None`, each `refined` walks the\n  // types it reaches.\n  refined_types: Option[Set[String]],\n  // the recursive functions a contract may unfold (`rec_call`)\n  unfold: Set[String] = Set[String] {},\n}","old_text":"/// The traits and the types' own methods in scope, for method calls; which\n/// functions a contract may see through.\npub type Methods = {\n  traits: List[ast.TraitDecl],\n  own: List[ast.FnDecl],\n  // the implementations of traits\n  impls: List[ast.ImplDecl],\n  // core's traits (their methods are shown without the trait's name)\n  core_traits: Set[String],\n  seen: Dict[String, smt.Seen],\n  // the types' own methods: (the type's name, the method's)\n  own_types: List[(String, String)],\n  // the traits of core's code modules (`core.iter`, `core.channel`,\n  // `core.text`, `core.task`): their methods are the builtins' to Rust's\n  // termination analysis\n  code_traits: Set[String],\n  // implementations' methods a contract may see through, by `Trait::m@Type`\n  // (from compiler/termination; else each is judged by `impl_seen`'s rule)\n  impl_seen: Dict[String, smt.Seen],\n  // what is seen through only assuming it finishes (marked `terminates`):\n  // functions by name, implementations' methods by `Trait::m@Type` with\n  // their labels\n  assumed: Set[String],\n  assumed_impls: Dict[String, String],\n  // (an option of the runs: `verify` asks for counterexamples it can show,\n  // `Vc.examples`)\n  examples: Bool,\n  // the types whose declaration reaches a refinement (`refined_types`),\n  // found once for the types the runs are given; `None`: each `refined`\n  // walks the types it reaches\n  refined_types: Option[Set[String]],\n  // the recursive functions a contract may unfold (`rec_call`)\n  unfold: Set[String] = Set[String] {},\n}"},{"name":"smt.methods_of","kind":"fn","old":"f90430940ce44ca4","new":"cc13bd360443488a","interface_changed":false,"affected":[],"module":"smt","text":"/// The traits of definitions, the types' own methods (an `impl` of no\n/// trait), and which functions a contract may see through.\npub fn methods_of(decls: List[ast.Decl]) -> smt.Methods {\n  mut traits := []\n  mut own := []\n  mut impls := []\n  mut core_traits := Set[String] {}\n  mut own_types := []\n  mut code_traits := Set[String] {}\n  for d in decls {\n    match d.kind {\n      ast.TraitDef(t) => {\n        mut traits.push(t)\n        if starts_with(d.module, \"core.\") {\n          mut core_traits.insert(t.name)\n        }\n        if contains(\n          [\"core.iter\", \"core.channel\", \"core.text\", \"core.task\"],\n          d.module,\n        ) {\n          mut code_traits.insert(t.name)\n        }\n      },\n      ast.ImplDef(i) => if i.trait_name == \"\" {\n        own += i.methods\n        tn := match i.for_type {\n          ast.Named { name, .. } => name,\n          _ => \"\",\n        }\n        own_types += i.methods.map(m -> (tn, m.name))\n      } else {\n        mut impls.push(i)\n      },\n      _ => (),\n    }\n  }\n  (fns, types) := smt.tables(decls)\n  sigs := smt.builtins_of(decls)\n  m := smt.Methods {\n    traits,\n    own,\n    impls,\n    core_traits,\n    seen: Dict[String, smt.Seen] {},\n    own_types,\n    code_traits,\n    impl_seen: Dict[String, smt.Seen] {},\n    assumed: Set[String] {},\n    assumed_impls: Dict[String, String] {},\n    examples: false,\n    refined_types: Some(smt.refined_types(types)),\n  }\n  smt.Methods { ..m, seen: smt.transparency(smt.new_vc(fns, types, sigs, m)) }\n}","old_text":"/// The traits of definitions, the methods types have of their own (an\n/// `impl` of no trait), and which functions a contract may see through.\npub fn methods_of(decls: List[ast.Decl]) -> smt.Methods {\n  mut traits := []\n  mut own := []\n  mut impls := []\n  mut core_traits := Set[String] {}\n  mut own_types := []\n  mut code_traits := Set[String] {}\n  for d in decls {\n    match d.kind {\n      ast.TraitDef(t) => {\n        mut traits.push(t)\n        if starts_with(d.module, \"core.\") {\n          mut core_traits.insert(t.name)\n        }\n        if contains(\n          [\"core.iter\", \"core.channel\", \"core.text\", \"core.task\"],\n          d.module,\n        ) {\n          mut code_traits.insert(t.name)\n        }\n      },\n      ast.ImplDef(i) => if i.trait_name == \"\" {\n        own += i.methods\n        tn := match i.for_type {\n          ast.Named { name, .. } => name,\n          _ => \"\",\n        }\n        own_types += i.methods.map(m -> (tn, m.name))\n      } else {\n        mut impls.push(i)\n      },\n      _ => (),\n    }\n  }\n  (fns, types) := smt.tables(decls)\n  sigs := smt.builtins_of(decls)\n  m := smt.Methods {\n    traits,\n    own,\n    impls,\n    core_traits,\n    seen: Dict[String, smt.Seen] {},\n    own_types,\n    code_traits,\n    impl_seen: Dict[String, smt.Seen] {},\n    assumed: Set[String] {},\n    assumed_impls: Dict[String, String] {},\n    examples: false,\n    refined_types: Some(smt.refined_types(types)),\n  }\n  smt.Methods { ..m, seen: smt.transparency(smt.new_vc(fns, types, sigs, m)) }\n}"},{"name":"smt.method_contract","kind":"fn","old":"2a98467fb0fbea01","new":"aa3bea4b6a60dda5","interface_changed":false,"affected":[],"module":"smt","text":"/// Method `name`'s contract when it means the same on every type: declared\n/// by exactly one trait and by no type itself.\nfn method_contract(vc: smt.Vc, name: String) -> Option[ast.FnDecl] {\n  // `Trait::m`: that trait's method\n  match split(name, \"::\") {\n    [tr, m] => return match vc.methods.traits.filter(t -> t.name == tr) {\n      [t, ..] => match t.methods.filter(x -> x.decl.name == m) {\n        [x, ..] => Some(x.decl),\n        [] => None,\n      },\n      [] => None,\n    },\n    _ => (),\n  }\n  (decls, own) := smt.method_decls(vc, name)\n  match decls {\n    [d] => if own {\n      None\n    } else {\n      Some(d)\n    },\n    _ => None,\n  }\n}","old_text":"/// Method `name`'s contract when it means the same thing on every type:\n/// declared by exactly one trait and by no type itself.\nfn method_contract(vc: smt.Vc, name: String) -> Option[ast.FnDecl] {\n  // `Trait::m`: that trait's method\n  match split(name, \"::\") {\n    [tr, m] => return match vc.methods.traits.filter(t -> t.name == tr) {\n      [t, ..] => match t.methods.filter(x -> x.decl.name == m) {\n        [x, ..] => Some(x.decl),\n        [] => None,\n      },\n      [] => None,\n    },\n    _ => (),\n  }\n  (decls, own) := smt.method_decls(vc, name)\n  match decls {\n    [d] => if own {\n      None\n    } else {\n      Some(d)\n    },\n    _ => None,\n  }\n}"},{"name":"smt.method_call","kind":"fn","old":"6c5db80e757bd59c","new":"60a8a856c6d41dfa","interface_changed":false,"affected":[],"module":"smt","text":"/// A method call: through its contract when it has one (see\n/// `method_contract`), else a value of its result type, since it depends on\n/// the receiver's type. `mut` arguments are written back.\nfn method_call(\n  mut vc: smt.Vc,\n  name: String,\n  arg_exprs: List[ast.Expr],\n  args: List[smt.Val],\n) -> Option[smt.Val] {\n  match smt.method_contract(vc, name) {\n    Some(d) => {\n      // in a contract, a call resolved to a trait (`Trait::m`) is seen\n      // through the receiver's implementation when that is transparent\n      if vc.spec > 0 && vc.depth < 4 && contains(name, \"::\") {\n        match smt.implementation(vc, name, args) {\n          Some(m) => match smt.impl_seen(vc, name\n            + \"@\"\n            + (smt.head_of(vc, get(args, 0) ?? smt.UnitVal) ?? \"\"), m) {\n            smt.SeeThrough => {\n              match get(vc.methods.assumed_impls, name\n                + \"@\"\n                + (smt.head_of(vc, get(args, 0) ?? smt.UnitVal) ?? \"\")) {\n                Some(label) => mut vc.relied_on.insert(label),\n                None => (),\n              }\n              binds := dict(zip(m.params.map(p -> p.name), args))\n              vc.depth += 1\n              vc.through += 1\n              saved := vc.scopes\n              vc.scopes = [binds]\n              r := smt.eval(mut vc, m.body)\n              vc.scopes = saved\n              vc.through -= 1\n              vc.depth -= 1\n              return Some(r)\n            },\n            smt.NotKnown => smt.gap(\n              mut vc,\n              f\"the call of `{name}` in a contract (whether it finishes needs a proof not ported)\",\n            ),\n            smt.ContractOnly => (),\n          },\n          None => (),\n        }\n      }\n      label := if contains(name, \"::\") {\n        name\n      } else {\n        smt.contract_label(vc, name)\n      }\n      // a `shared` trait's value: another worker may have acted on it since\n      // this code's last call, so the call starts from any value its\n      // trait's invariants allow\n      given := smt.shared_receiver(mut vc, name, d, arg_exprs, args)\n      r := smt.call_contract(mut vc, label, d, given)\n      smt.write_after(mut vc, d.params, arg_exprs)\n      // a method seen through its contract (`Counter::total`) gives the\n      // same result on the same receiver and arguments, so what a `mut\n      // self` method's `ensures` says before and after relates the calls\n      if !d.params.any(p -> p.mutable) {\n        smt.same_call(\n          mut vc,\n          smt.call_key(vc, label, arg_exprs, given),\n          r,\n        )\n      }\n      return Some(r)\n    },\n    None => (),\n  }\n  (decls, own) := smt.method_decls(vc, name)\n  params := match decls {\n    [d, ..] => Some(d.params),\n    [] => if own {\n      match vc.methods.own.filter(\n        f -> f.name == name && smt.takes_self(f),\n      ) {\n        [f, ..] => Some(f.params),\n        [] => None,\n      }\n    } else {\n      None\n    },\n  }\n  match params {\n    Some(ps) => {\n      smt.write_back(mut vc, ps, arg_exprs, args)\n      Some(smt.Opaque(\n        f\"the result of method `{name}` (it depends on the receiver's type)\",\n      ))\n    },\n    None => None,\n  }\n}","old_text":"/// A method call: through its contract when it has one (see\n/// `method_contract`), else a value of its result (it depends on the\n/// receiver's type), `mut` arguments written back.\nfn method_call(\n  mut vc: smt.Vc,\n  name: String,\n  arg_exprs: List[ast.Expr],\n  args: List[smt.Val],\n) -> Option[smt.Val] {\n  match smt.method_contract(vc, name) {\n    Some(d) => {\n      // in a contract, a call resolved to a trait (`Trait::m`) is seen\n      // through the receiver's implementation when that is transparent\n      if vc.spec > 0 && vc.depth < 4 && contains(name, \"::\") {\n        match smt.implementation(vc, name, args) {\n          Some(m) => match smt.impl_seen(vc, name\n            + \"@\"\n            + (smt.head_of(vc, get(args, 0) ?? smt.UnitVal) ?? \"\"), m) {\n            smt.SeeThrough => {\n              match get(vc.methods.assumed_impls, name\n                + \"@\"\n                + (smt.head_of(vc, get(args, 0) ?? smt.UnitVal) ?? \"\")) {\n                Some(label) => mut vc.relied_on.insert(label),\n                None => (),\n              }\n              binds := dict(zip(m.params.map(p -> p.name), args))\n              vc.depth += 1\n              vc.through += 1\n              saved := vc.scopes\n              vc.scopes = [binds]\n              r := smt.eval(mut vc, m.body)\n              vc.scopes = saved\n              vc.through -= 1\n              vc.depth -= 1\n              return Some(r)\n            },\n            smt.NotKnown => smt.gap(\n              mut vc,\n              f\"the call of `{name}` in a contract (whether it finishes needs a proof not ported)\",\n            ),\n            smt.ContractOnly => (),\n          },\n          None => (),\n        }\n      }\n      label := if contains(name, \"::\") {\n        name\n      } else {\n        smt.contract_label(vc, name)\n      }\n      // (a `shared` trait's value: another worker may have acted on it\n      // since this code's last call, so the call starts from any value its\n      // trait's invariants allow)\n      given := smt.shared_receiver(mut vc, name, d, arg_exprs, args)\n      r := smt.call_contract(mut vc, label, d, given)\n      smt.write_after(mut vc, d.params, arg_exprs)\n      // (a method seen through its contract, `Counter::total`, gives the\n      // same result on the same receiver and arguments: what a `mut self`\n      // method's `ensures` says of it before and after relates the calls)\n      if !d.params.any(p -> p.mutable) {\n        smt.same_call(\n          mut vc,\n          smt.call_key(vc, label, arg_exprs, given),\n          r,\n        )\n      }\n      return Some(r)\n    },\n    None => (),\n  }\n  (decls, own) := smt.method_decls(vc, name)\n  params := match decls {\n    [d, ..] => Some(d.params),\n    [] => if own {\n      match vc.methods.own.filter(\n        f -> f.name == name && smt.takes_self(f),\n      ) {\n        [f, ..] => Some(f.params),\n        [] => None,\n      }\n    } else {\n      None\n    },\n  }\n  match params {\n    Some(ps) => {\n      smt.write_back(mut vc, ps, arg_exprs, args)\n      Some(smt.Opaque(\n        f\"the result of method `{name}` (it depends on the receiver's type)\",\n      ))\n    },\n    None => None,\n  }\n}"},{"name":"smt.fn_name_value","kind":"fn","old":"638fb21188c27047","new":"fd5eb376b1f6375d","interface_changed":false,"affected":[],"module":"smt","text":"/// A function's name used as a value: its contract run on unknown\n/// arguments, so its checks hold on every call. The value isn't modelled.\nfn fn_name_value(mut vc: smt.Vc, x: String) -> smt.Val {\n  f := match get(vc.fns, x) {\n    Some(f) => Some(f),\n    None => smt.method_contract(vc, x),\n  }\n  match f {\n    Some(g) => {\n      _ := smt.call_contract(mut vc, x, g, g.params.map(\n        _ -> smt.Opaque(\n          \"the arguments of a function value are not known\",\n        ),\n      ))\n      smt.Opaque(\"function values are not modelled\")\n    },\n    None => smt.Opaque(f\"`{x}` used as a value\"),\n  }\n}","old_text":"/// A function's name used as a value: its contract run on unknown\n/// arguments (its checks hold on every call); the value isn't modelled.\nfn fn_name_value(mut vc: smt.Vc, x: String) -> smt.Val {\n  f := match get(vc.fns, x) {\n    Some(f) => Some(f),\n    None => smt.method_contract(vc, x),\n  }\n  match f {\n    Some(g) => {\n      _ := smt.call_contract(mut vc, x, g, g.params.map(\n        _ -> smt.Opaque(\n          \"the arguments of a function value are not known\",\n        ),\n      ))\n      smt.Opaque(\"function values are not modelled\")\n    },\n    None => smt.Opaque(f\"`{x}` used as a value\"),\n  }\n}"},{"name":"smt.Seen","kind":"type","old":"1ad769145bc32205","new":"ae7d73af094b8a4d","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether a call in a contract may be seen through (its body unfolded):\n/// when the function finishes and cannot fail. `NotKnown`: finishing needs\n/// a termination proof (a loop's bound, a recursion's measure), which\n/// `transparency` doesn't attempt.\npub type Seen =\n  | SeeThrough\n  | ContractOnly\n  | NotKnown","old_text":"/// Whether a call in a contract may be seen through (its body unfolded):\n/// when the function finishes and cannot fail (Rust's termination\n/// analysis, `transparent`). `NotKnown`: Rust's answer depends on a proof\n/// of termination (a loop's bound, a recursion's measure) not ported yet.\npub type Seen =\n  | SeeThrough\n  | ContractOnly\n  | NotKnown"},{"name":"smt.calls_of","kind":"fn","old":"450ef284228a65f0","new":"bafb81b11efd4522","interface_changed":false,"affected":[],"module":"smt","text":"/// The program functions an expression calls or names, and its method\n/// calls (`method m`).\nfn calls_of(vc: smt.Vc, e: ast.Expr) -> List[String] {\n  mut out := []\n  mut todo := [e]\n  while len(todo) > 0 {\n    x := get(todo, len(todo) - 1) ?? ast.UnitExpr\n    todo = take(todo, len(todo) - 1)\n    match x {\n      ast.Call { callee, .. } => match callee {\n        ast.Var(n) => if contains(vc.fns, n) {\n          mut out.push(n)\n        } else if !vc.builtins.any(b -> b.name == n) {\n          mut out.push(\"method \" + n)\n        },\n        _ => (),\n      },\n      ast.MethodCall { name, .. } => if contains(vc.fns, name) {\n        mut out.push(name)\n      } else if !vc.builtins.any(b -> b.name == name) {\n        mut out.push(\"method \" + name)\n      },\n      ast.Var(n) => if contains(vc.fns, n) {\n        mut out.push(n)\n      },\n      _ => (),\n    }\n    todo += walk.kids(x)\n  }\n  out\n}","old_text":"/// The program functions an expression calls or names, and its calls of\n/// methods (`method m`).\nfn calls_of(vc: smt.Vc, e: ast.Expr) -> List[String] {\n  mut out := []\n  mut todo := [e]\n  while len(todo) > 0 {\n    x := get(todo, len(todo) - 1) ?? ast.UnitExpr\n    todo = take(todo, len(todo) - 1)\n    match x {\n      ast.Call { callee, .. } => match callee {\n        ast.Var(n) => if contains(vc.fns, n) {\n          mut out.push(n)\n        } else if !vc.builtins.any(b -> b.name == n) {\n          mut out.push(\"method \" + n)\n        },\n        _ => (),\n      },\n      ast.MethodCall { name, .. } => if contains(vc.fns, name) {\n        mut out.push(name)\n      } else if !vc.builtins.any(b -> b.name == name) {\n        mut out.push(\"method \" + name)\n      },\n      ast.Var(n) => if contains(vc.fns, n) {\n        mut out.push(n)\n      },\n      _ => (),\n    }\n    todo += walk.kids(x)\n  }\n  out\n}"},{"name":"smt.has_loop","kind":"fn","old":"947f24a7e1120f78","new":"2a8845cb9c6250d9","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether an expression has a `while` or `loop`, whose end needs a solver\n/// proof.\nfn has_loop(e: ast.Expr) -> Bool {\n  mut todo := [e]\n  while len(todo) > 0 {\n    x := get(todo, len(todo) - 1) ?? ast.UnitExpr\n    todo = take(todo, len(todo) - 1)\n    match x {\n      ast.Block { stmts, .. } => if stmts.any(\n        s -> match s {\n          ast.While { .. } | ast.Loop(_) => true,\n          _ => false,\n        },\n      ) {\n        return true\n      },\n      _ => (),\n    }\n    todo += walk.kids(x)\n  }\n  false\n}","old_text":"/// Whether an expression has a `while` or `loop` (whose end Rust proves\n/// with the solver).\nfn has_loop(e: ast.Expr) -> Bool {\n  mut todo := [e]\n  while len(todo) > 0 {\n    x := get(todo, len(todo) - 1) ?? ast.UnitExpr\n    todo = take(todo, len(todo) - 1)\n    match x {\n      ast.Block { stmts, .. } => if stmts.any(\n        s -> match s {\n          ast.While { .. } | ast.Loop(_) => true,\n          _ => false,\n        },\n      ) {\n        return true\n      },\n      _ => (),\n    }\n    todo += walk.kids(x)\n  }\n  false\n}"},{"name":"smt.total_builtin","kind":"fn","old":"96f3e08087aa59ec","new":"608d4ee3c67750ca","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether the builtin `n` is total: no version has a `requires`.\nfn total_builtin(vc: smt.Vc, n: String) -> Bool {\n  sigs := vc.builtins.filter(b -> b.name == n)\n  len(sigs) > 0 && sigs.all(b -> b.total)\n}","old_text":"/// Whether the builtin `n` is total (no version has a `requires`).\nfn total_builtin(vc: smt.Vc, n: String) -> Bool {\n  sigs := vc.builtins.filter(b -> b.name == n)\n  len(sigs) > 0 && sigs.all(b -> b.total)\n}"},{"name":"smt.worse","kind":"fn","old":"99571b19f4c948e3","new":"ec1982d58969379e","interface_changed":false,"affected":[],"module":"smt","text":"/// The worse of two answers: `ContractOnly`, then `NotKnown`, then\n/// `SeeThrough`.\nfn worse(a: smt.Seen, b: smt.Seen) -> smt.Seen {\n  match (a, b) {\n    (smt.ContractOnly, _) | (_, smt.ContractOnly) => smt.ContractOnly,\n    (smt.NotKnown, _) | (_, smt.NotKnown) => smt.NotKnown,\n    _ => smt.SeeThrough,\n  }\n}","old_text":"/// The worse of two answers (`ContractOnly` over `NotKnown` over\n/// `SeeThrough`).\nfn worse(a: smt.Seen, b: smt.Seen) -> smt.Seen {\n  match (a, b) {\n    (smt.ContractOnly, _) | (_, smt.ContractOnly) => smt.ContractOnly,\n    (smt.NotKnown, _) | (_, smt.NotKnown) => smt.NotKnown,\n    _ => smt.SeeThrough,\n  }\n}"},{"name":"smt.cannot_fail","kind":"fn","old":"f875ba64333096f3","new":"0fe09f5002433523","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether evaluating `f`'s body cannot fail (no runtime check, no hole).\n/// Calls are fine when the callee may be seen through.\nfn cannot_fail(\n  vc: smt.Vc,\n  f: ast.FnDecl,\n  seen: Dict[String, smt.Seen],\n) -> smt.Seen {\n  if len(f.pre) > 0 || f.params.any(p -> p.mutable) {\n    return smt.ContractOnly\n  }\n  mut r := smt.SeeThrough\n  mut todo := [f.body]\n  while len(todo) > 0 {\n    x := get(todo, len(todo) - 1) ?? ast.UnitExpr\n    todo = take(todo, len(todo) - 1)\n    here := match x {\n      ast.Hole(_) | ast.MockExpr(_) | ast.Return(_) | ast.Try { .. } => smt.ContractOnly,\n      ast.Binary { op, right, .. } => if op == ast.Div || op == ast.Mod {\n        match right {\n          ast.IntLit(n) => if n != 0 {\n            smt.SeeThrough\n          } else {\n            smt.ContractOnly\n          },\n          _ => smt.ContractOnly,\n        }\n      } else {\n        smt.SeeThrough\n      },\n      // a refined constructor may fail: seen through, it is the value only\n      // where its refinement holds (`ctor`)\n      ast.CtorExpr { .. } => smt.SeeThrough,\n      ast.Call { callee: ast.Var(n), .. } => smt.callee_seen(vc, n, seen),\n      ast.MethodCall { name, .. } => smt.callee_seen(vc, name, seen),\n      ast.Block { stmts, .. } => if stmts.any(\n        s -> match s {\n          ast.Assert(_) => true,\n          _ => false,\n        },\n      ) {\n        smt.ContractOnly\n      } else {\n        smt.SeeThrough\n      },\n      _ => smt.SeeThrough,\n    }\n    r = smt.worse(r, here)\n    todo += walk.kids(x)\n  }\n  r\n}","old_text":"/// Can evaluating `f`'s body fail (a runtime check, a hole)? Calls of other\n/// functions are fine when those may be seen through.\nfn cannot_fail(\n  vc: smt.Vc,\n  f: ast.FnDecl,\n  seen: Dict[String, smt.Seen],\n) -> smt.Seen {\n  if len(f.pre) > 0 || f.params.any(p -> p.mutable) {\n    return smt.ContractOnly\n  }\n  mut r := smt.SeeThrough\n  mut todo := [f.body]\n  while len(todo) > 0 {\n    x := get(todo, len(todo) - 1) ?? ast.UnitExpr\n    todo = take(todo, len(todo) - 1)\n    here := match x {\n      ast.Hole(_) | ast.MockExpr(_) | ast.Return(_) | ast.Try { .. } => smt.ContractOnly,\n      ast.Binary { op, right, .. } => if op == ast.Div || op == ast.Mod {\n        match right {\n          ast.IntLit(n) => if n != 0 {\n            smt.SeeThrough\n          } else {\n            smt.ContractOnly\n          },\n          _ => smt.ContractOnly,\n        }\n      } else {\n        smt.SeeThrough\n      },\n      // (a refined constructor that may fail: seen through, it is the value\n      // only where its refinement holds, `ctor`)\n      ast.CtorExpr { .. } => smt.SeeThrough,\n      ast.Call { callee: ast.Var(n), .. } => smt.callee_seen(vc, n, seen),\n      ast.MethodCall { name, .. } => smt.callee_seen(vc, name, seen),\n      ast.Block { stmts, .. } => if stmts.any(\n        s -> match s {\n          ast.Assert(_) => true,\n          _ => false,\n        },\n      ) {\n        smt.ContractOnly\n      } else {\n        smt.SeeThrough\n      },\n      _ => smt.SeeThrough,\n    }\n    r = smt.worse(r, here)\n    todo += walk.kids(x)\n  }\n  r\n}"},{"name":"smt.callee_seen","kind":"fn","old":"f6b5c9ba1ce22a4d","new":"c54b2074e8947754","interface_changed":false,"affected":[],"module":"smt","text":"/// What a call of `n` in a body seen through gives: a function's own\n/// answer, yes for a total builtin, no for a method or partial builtin.\nfn callee_seen(\n  vc: smt.Vc,\n  n: String,\n  seen: Dict[String, smt.Seen],\n) -> smt.Seen {\n  if contains(vc.fns, n) {\n    get(seen, n) ?? smt.ContractOnly\n  } else if smt.method_decls(vc, n).0 != [] || smt.method_decls(vc, n).1 {\n    smt.ContractOnly\n  } else if smt.total_builtin(vc, n) {\n    smt.SeeThrough\n  } else {\n    smt.ContractOnly\n  }\n}","old_text":"/// What a call of `n` in a body seen through gives: a function's own\n/// answer, a total builtin's yes, a method's or a partial builtin's no.\nfn callee_seen(\n  vc: smt.Vc,\n  n: String,\n  seen: Dict[String, smt.Seen],\n) -> smt.Seen {\n  if contains(vc.fns, n) {\n    get(seen, n) ?? smt.ContractOnly\n  } else if smt.method_decls(vc, n).0 != [] || smt.method_decls(vc, n).1 {\n    smt.ContractOnly\n  } else if smt.total_builtin(vc, n) {\n    smt.SeeThrough\n  } else {\n    smt.ContractOnly\n  }\n}"},{"name":"smt.transparency","kind":"fn","old":"f24f9ba5fd70df55","new":"8f41f8b036386ab7","interface_changed":false,"affected":[],"module":"smt","text":"/// Which functions a contract may see through: those that finish and\n/// cannot fail, callees first. Used when termination's results are absent.\nfn transparency(vc: smt.Vc) -> Dict[String, smt.Seen] {\n  names := keys(vc.fns)\n  mut calls := Dict[String, List[String]] {}\n  for n in names {\n    mut calls.insert(\n      n,\n      smt.calls_of(vc, (get(vc.fns, n) ?? smt.dummy_fn()).body),\n    )\n  }\n  // recursive: reachable from its own callees\n  mut recursive := Set[String] {}\n  for n in names {\n    mut seen := Set[String] {}\n    mut todo := get(calls, n) ?? []\n    while len(todo) > 0 {\n      c := get(todo, len(todo) - 1) ?? \"\"\n      todo = take(todo, len(todo) - 1)\n      if c == n {\n        mut recursive.insert(n)\n        todo = []\n      } else if contains(vc.fns, c) && !contains(seen, c) {\n        mut seen.insert(c)\n        todo += get(calls, c) ?? []\n      }\n    }\n  }\n  // the answers, a function's after its callees'. The rest are recursive.\n  mut out := Dict[String, smt.Seen] {}\n  mut changed := true\n  while changed {\n    changed = false\n    for n in names {\n      if contains(out, n) {\n        continue\n      }\n      f := get(vc.fns, n) ?? smt.dummy_fn()\n      cs := (get(calls, n) ?? []).filter(\n        c -> c != n && contains(vc.fns, c),\n      )\n      if contains(recursive, n) {\n        mut out.insert(n, smt.ContractOnly)\n        changed = true\n      } else if cs.all(c -> contains(out, c)) {\n        // finishes: no loop to prove (unless marked `terminates`), callees\n        // that finish, and no method whose end isn't known\n        ends := if smt.has_loop(f.body) && !f.terminating\n          || (get(calls, n) ?? []).any(c -> starts_with(c, \"method \"))\n          || cs.any(\n            c -> contains(recursive, c)\n              && !(get(vc.fns, c) ?? f).terminating,\n          ) {\n          smt.NotKnown\n        } else {\n          smt.SeeThrough\n        }\n        mut out.insert(n, smt.worse(ends, smt.cannot_fail(vc, f, out)))\n        changed = true\n      }\n    }\n  }\n  out\n}","old_text":"/// Which functions a contract may see through: those that finish and\n/// cannot fail, callees first.\nfn transparency(vc: smt.Vc) -> Dict[String, smt.Seen] {\n  names := keys(vc.fns)\n  mut calls := Dict[String, List[String]] {}\n  for n in names {\n    mut calls.insert(\n      n,\n      smt.calls_of(vc, (get(vc.fns, n) ?? smt.dummy_fn()).body),\n    )\n  }\n  // recursive: reachable from its own callees\n  mut recursive := Set[String] {}\n  for n in names {\n    mut seen := Set[String] {}\n    mut todo := get(calls, n) ?? []\n    while len(todo) > 0 {\n      c := get(todo, len(todo) - 1) ?? \"\"\n      todo = take(todo, len(todo) - 1)\n      if c == n {\n        mut recursive.insert(n)\n        todo = []\n      } else if contains(vc.fns, c) && !contains(seen, c) {\n        mut seen.insert(c)\n        todo += get(calls, c) ?? []\n      }\n    }\n  }\n  // the answers, a function's after its callees' (the others are recursive)\n  mut out := Dict[String, smt.Seen] {}\n  mut changed := true\n  while changed {\n    changed = false\n    for n in names {\n      if contains(out, n) {\n        continue\n      }\n      f := get(vc.fns, n) ?? smt.dummy_fn()\n      cs := (get(calls, n) ?? []).filter(\n        c -> c != n && contains(vc.fns, c),\n      )\n      if contains(recursive, n) {\n        mut out.insert(n, smt.ContractOnly)\n        changed = true\n      } else if cs.all(c -> contains(out, c)) {\n        // finishes: no loop to prove (unless marked `terminates`), callees\n        // that finish, and no method whose end isn't known\n        ends := if smt.has_loop(f.body) && !f.terminating\n          || (get(calls, n) ?? []).any(c -> starts_with(c, \"method \"))\n          || cs.any(\n            c -> contains(recursive, c)\n              && !(get(vc.fns, c) ?? f).terminating,\n          ) {\n          smt.NotKnown\n        } else {\n          smt.SeeThrough\n        }\n        mut out.insert(n, smt.worse(ends, smt.cannot_fail(vc, f, out)))\n        changed = true\n      }\n    }\n  }\n  out\n}"},{"name":"smt.regex_match","kind":"fn","old":"e7ab4f6c7b8ed9ae","new":"fd69b89ea4c0ad83","interface_changed":false,"affected":[],"module":"smt","text":"// ---- regular expressions ----\n\n/// `matches(s, re)` for a literal pattern: membership in its SMT regular\n/// expression (exact, or bounded from both sides for a large Unicode\n/// class), plus what the patterns' languages say about each other for the\n/// same string.\nfn regex_match(mut vc: smt.Vc, s: String, re: String) -> String {\n  match std.regex.smt_model(re) {\n    None => smt.unknown_bool(mut vc, \"the regular expression \\\"\"\n      + re\n      + \"\\\" uses features not modelled yet\"),\n    Some(model) => {\n      (b, approx) := match model {\n        std.regex.ExactModel(r) => (\"(str.in_re \" + s + \" \" + r + \")\", false),\n        std.regex.Between(under, over) => {\n          x := smt.fresh_why(mut vc, \"Bool\", \"the regular expression \\\"\"\n            + re\n            + \"\\\" has a large Unicode class (approximated from both sides)\")\n          mut vc.facts.push(\n            \"(=> (str.in_re \" + s + \" \" + under + \") \" + x + \")\",\n          )\n          mut vc.facts.push(\n            \"(=> \" + x + \" (str.in_re \" + s + \" \" + over + \"))\",\n          )\n          (x, true)\n        },\n      }\n      for (s2, re2, b2, approx2) in vc.matched {\n        if s2 == s && re2 != re && (approx || approx2) {\n          (sub, sup, disjoint) := std.regex.relations(re, re2)\n          if sub {\n            mut vc.facts.push(smt.implies(b, b2))\n          }\n          if sup {\n            mut vc.facts.push(smt.implies(b2, b))\n          }\n          if disjoint {\n            mut vc.facts.push(smt.neg(smt.and_all([b, b2])))\n          }\n        }\n      }\n      mut vc.matched.push((s, re, b, approx))\n      b\n    },\n  }\n}","old_text":"// ---- operators ----\n\n/// `matches(s, re)` for a literal pattern: membership in its SMT regular\n/// expression (exact, or bounded from both sides for a large Unicode\n/// class), with what the patterns' languages say about each other for the\n/// same string.\nfn regex_match(mut vc: smt.Vc, s: String, re: String) -> String {\n  match std.regex.smt_model(re) {\n    None => smt.unknown_bool(mut vc, \"the regular expression \\\"\"\n      + re\n      + \"\\\" uses features not modelled yet\"),\n    Some(model) => {\n      (b, approx) := match model {\n        std.regex.ExactModel(r) => (\"(str.in_re \" + s + \" \" + r + \")\", false),\n        std.regex.Between(under, over) => {\n          x := smt.fresh_why(mut vc, \"Bool\", \"the regular expression \\\"\"\n            + re\n            + \"\\\" has a large Unicode class (approximated from both sides)\")\n          mut vc.facts.push(\n            \"(=> (str.in_re \" + s + \" \" + under + \") \" + x + \")\",\n          )\n          mut vc.facts.push(\n            \"(=> \" + x + \" (str.in_re \" + s + \" \" + over + \"))\",\n          )\n          (x, true)\n        },\n      }\n      for (s2, re2, b2, approx2) in vc.matched {\n        if s2 == s && re2 != re && (approx || approx2) {\n          (sub, sup, disjoint) := std.regex.relations(re, re2)\n          if sub {\n            mut vc.facts.push(smt.implies(b, b2))\n          }\n          if sup {\n            mut vc.facts.push(smt.implies(b2, b))\n          }\n          if disjoint {\n            mut vc.facts.push(smt.neg(smt.and_all([b, b2])))\n          }\n        }\n      }\n      mut vc.matched.push((s, re, b, approx))\n      b\n    },\n  }\n}"},{"name":"smt.contract_label","kind":"fn","old":"f7058aca501dd16c","new":"0ebdb7ade0521489","interface_changed":false,"affected":[],"module":"smt","text":"/// How a call through a trait method is named in messages: `Db::load`, or\n/// a core trait's method by its name alone.\nfn contract_label(vc: smt.Vc, name: String) -> String {\n  match vc.methods.traits.filter(\n    t -> t.methods.any(m -> m.decl.name == name),\n  ) {\n    [t] => if contains(vc.methods.core_traits, t.name) {\n      name\n    } else {\n      t.name + \"::\" + name\n    },\n    _ => name,\n  }\n}","old_text":"/// How a call through a trait's method is named in messages: `Db::load`,\n/// as Rust's checker resolves it; a core trait's method by its name alone.\nfn contract_label(vc: smt.Vc, name: String) -> String {\n  match vc.methods.traits.filter(\n    t -> t.methods.any(m -> m.decl.name == name),\n  ) {\n    [t] => if contains(vc.methods.core_traits, t.name) {\n      name\n    } else {\n      t.name + \"::\" + name\n    },\n    _ => name,\n  }\n}"},{"name":"smt.qual","kind":"fn","old":"87874cea172be6a0","new":"38a40430a70154d1","interface_changed":false,"affected":[],"module":"smt","text":"/// A variant's name as code names it, in its type's module\n/// (`std.json.Integer` for `std.json.JsonValue`'s `Integer`).\nfn qual(type_name: String, v: String) -> String {\n  parts := split(type_name, \".\")\n  if len(parts) <= 1 {\n    v\n  } else {\n    join(take(parts, len(parts) - 1), \".\") + \".\" + v\n  }\n}","old_text":"/// A variant's name as code names it: in its type's module (`std.json.\n/// Integer` for `std.json.JsonValue`'s `Integer`).\nfn qual(type_name: String, v: String) -> String {\n  parts := split(type_name, \".\")\n  if len(parts) <= 1 {\n    v\n  } else {\n    join(take(parts, len(parts) - 1), \".\") + \".\" + v\n  }\n}"},{"name":"smt.call_value","kind":"fn","old":"aed42fd751303902","new":"adeb097e9f44d9ff","interface_changed":false,"affected":[],"module":"smt","text":"/// A call of a function value: its arguments evaluated. For a known type,\n/// some valid value of its result type.\nfn call_value(mut vc: smt.Vc, f: smt.Val, args: List[ast.Expr]) -> smt.Val {\n  for a in args {\n    _ := smt.eval(mut vc, a)\n  }\n  match f {\n    smt.VFn { ret } => {\n      old := vc.reason\n      vc.reason = Some(\n        \"the result of calling a function value (only its type is known)\",\n      )\n      res := smt.shape(mut vc, ret)\n      vc.reason = old\n      vc.spec += 1\n      c := smt.check_type(mut vc, ret, res, [])\n      vc.spec -= 1\n      smt.assume(mut vc, c)\n      res\n    },\n    _ => smt.Opaque(\"calling a function value\"),\n  }\n}","old_text":"/// A call of a function value: its arguments evaluated; of a known type,\n/// some valid value of its result type.\nfn call_value(mut vc: smt.Vc, f: smt.Val, args: List[ast.Expr]) -> smt.Val {\n  for a in args {\n    _ := smt.eval(mut vc, a)\n  }\n  match f {\n    smt.VFn { ret } => {\n      old := vc.reason\n      vc.reason = Some(\n        \"the result of calling a function value (only its type is known)\",\n      )\n      res := smt.shape(mut vc, ret)\n      vc.reason = old\n      vc.spec += 1\n      c := smt.check_type(mut vc, ret, res, [])\n      vc.spec -= 1\n      smt.assume(mut vc, c)\n      res\n    },\n    _ => smt.Opaque(\"calling a function value\"),\n  }\n}"},{"name":"smt.head_of","kind":"fn","old":"a060607bee15f08b","new":"c38a9b184ef4e4ca","interface_changed":false,"affected":[],"module":"smt","text":"/// A value's type head (`Box`, `List`), when its shape tells.\nfn head_of(vc: smt.Vc, v: smt.Val) -> Option[String] {\n  match v {\n    smt.VInt(_) => Some(\"Int\"),\n    smt.VBool(_) => Some(\"Bool\"),\n    smt.VStr(_) => Some(\"String\"),\n    smt.VRec { name, .. } => Some(name),\n    smt.VDistinct { name, .. } => Some(name),\n    smt.VSum { ty, .. } => Some(ty),\n    smt.VList { .. } => Some(\"List\"),\n    smt.VData { ty, .. } => match smt.sort_type(vc, ty) {\n      ast.Named { name, .. } => Some(name),\n      _ => None,\n    },\n    _ => None,\n  }\n}","old_text":"/// The type a value has, by its head (`Box`, `List`), when its shape says.\nfn head_of(vc: smt.Vc, v: smt.Val) -> Option[String] {\n  match v {\n    smt.VInt(_) => Some(\"Int\"),\n    smt.VBool(_) => Some(\"Bool\"),\n    smt.VStr(_) => Some(\"String\"),\n    smt.VRec { name, .. } => Some(name),\n    smt.VDistinct { name, .. } => Some(name),\n    smt.VSum { ty, .. } => Some(ty),\n    smt.VList { .. } => Some(\"List\"),\n    smt.VData { ty, .. } => match smt.sort_type(vc, ty) {\n      ast.Named { name, .. } => Some(name),\n      _ => None,\n    },\n    _ => None,\n  }\n}"},{"name":"smt.impl_seen","kind":"fn","old":"3fa01052ed35320c","new":"11d2b142f0ca68da","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether an implementation's method (`key`: `Trait::m@Type`) may be seen\n/// through: as termination found, else when it finishes (no loop to prove)\n/// and cannot fail.\nfn impl_seen(vc: smt.Vc, key: String, m: ast.FnDecl) -> smt.Seen {\n  match get(vc.methods.impl_seen, key) {\n    Some(s) => return s,\n    None => (),\n  }\n  ends := if smt.has_loop(m.body) && !m.terminating {\n    smt.NotKnown\n  } else {\n    smt.SeeThrough\n  }\n  smt.worse(ends, smt.cannot_fail(vc, m, vc.methods.seen))\n}","old_text":"/// Whether an implementation's method (`key`: `Trait::m@Type`) may be seen\n/// through: as compiler/termination found, else when it finishes (no loop\n/// to prove) and cannot fail.\nfn impl_seen(vc: smt.Vc, key: String, m: ast.FnDecl) -> smt.Seen {\n  match get(vc.methods.impl_seen, key) {\n    Some(s) => return s,\n    None => (),\n  }\n  ends := if smt.has_loop(m.body) && !m.terminating {\n    smt.NotKnown\n  } else {\n    smt.SeeThrough\n  }\n  smt.worse(ends, smt.cannot_fail(vc, m, vc.methods.seen))\n}"},{"name":"smt.elaborated","kind":"fn","old":"2b66b77978c31968","new":"f077293588bf7148","interface_changed":false,"affected":[],"module":"smt","text":"/// The program with each method call resolved: `Trait::m` when one trait\n/// outside core declares `m`, and no function, builtin or type's own method\n/// has that name.\npub fn elaborated(\n  decls: List[ast.Decl],\n  methods: smt.Methods,\n  fns: Dict[String, ast.FnDecl],\n  sigs: List[smt.BuiltinSig],\n) -> List[ast.Decl] {\n  decls.map(\n    d -> walk.rewrite_decl(\n      d,\n      e -> smt.elaborate_call(e, methods, fns, sigs),\n    ),\n  )\n}","old_text":"/// The program with each method call written as Rust's checker resolves\n/// it: `Trait::m` when one trait outside core declares `m`, and no\n/// function, builtin or type's own method has that name.\npub fn elaborated(\n  decls: List[ast.Decl],\n  methods: smt.Methods,\n  fns: Dict[String, ast.FnDecl],\n  sigs: List[smt.BuiltinSig],\n) -> List[ast.Decl] {\n  decls.map(\n    d -> walk.rewrite_decl(\n      d,\n      e -> smt.elaborate_call(e, methods, fns, sigs),\n    ),\n  )\n}"},{"name":"smt.Group","kind":"type","old":"e1ca90f9f4372e72","new":"c280562997456d16","interface_changed":false,"affected":[],"module":"smt","text":"/// The members of a union of one shape: their key (`val_key`), the type of\n/// their slot, and for a sum's variants the constructors they allow.\ntype Group = { key: String, ty: ast.TypeExpr, only: Option[List[String]] }","old_text":"/// The members of a union of one shape: their key (`val_key`), the type of\n/// their slot, and (for a sum's variants) the constructors they allow.\ntype Group = { key: String, ty: ast.TypeExpr, only: Option[List[String]] }"},{"name":"smt.val_key","kind":"fn","old":"cb9494c9801ea9bf","new":"71baa41761a1385c","interface_changed":false,"affected":[],"module":"smt","text":"/// The run-time shape of a value, as far as it decides membership in a\n/// union. Values with different keys have different shapes. `List*` is any\n/// collection. `None` when the shape is not known.\nfn val_key(v: smt.Val) -> Option[String] {\n  match v {\n    smt.VInt(_) => Some(\"Int\"),\n    smt.VBool(_) => Some(\"Bool\"),\n    smt.VStr(_) => Some(\"String\"),\n    smt.UnitVal => Some(\"Unit\"),\n    smt.VTuple(xs) => Some(f\"Tuple/{len(xs)}\"),\n    smt.VRec { name, .. } => Some(\"rec:\" + name),\n    smt.VDistinct { name, .. } => Some(\"distinct:\" + name),\n    smt.VSum { ty, .. } => Some(\"sum:\" + ty),\n    smt.VList { .. } => Some(\"List*\"),\n    _ => None,\n  }\n}","old_text":"/// The runtime shape of a value, as far as it decides membership in a\n/// union: two values with different keys have different shapes. `List*`\n/// is any collection. `None` when the shape is not known.\nfn val_key(v: smt.Val) -> Option[String] {\n  match v {\n    smt.VInt(_) => Some(\"Int\"),\n    smt.VBool(_) => Some(\"Bool\"),\n    smt.VStr(_) => Some(\"String\"),\n    smt.UnitVal => Some(\"Unit\"),\n    smt.VTuple(xs) => Some(f\"Tuple/{len(xs)}\"),\n    smt.VRec { name, .. } => Some(\"rec:\" + name),\n    smt.VDistinct { name, .. } => Some(\"distinct:\" + name),\n    smt.VSum { ty, .. } => Some(\"sum:\" + ty),\n    smt.VList { .. } => Some(\"List*\"),\n    _ => None,\n  }\n}"},{"name":"smt.slots_of","kind":"fn","old":"9073e22c82a040eb","new":"9dd525ab031ba23d","interface_changed":false,"affected":[],"module":"smt","text":"/// A value as a union: its tag and slots. A plain value is a one-slot\n/// union.\nfn slots_of(v: smt.Val) -> Option[(String, List[(String, smt.Val)])] {\n  match v {\n    smt.VUnion { tag, slots } => Some((tag, slots)),\n    _ => match smt.val_key(v) {\n      Some(k) => Some((\"0\", [(k, v)])),\n      None => None,\n    },\n  }\n}","old_text":"/// A value as a union: its tag and slots (a plain value is a one-slot\n/// union).\nfn slots_of(v: smt.Val) -> Option[(String, List[(String, smt.Val)])] {\n  match v {\n    smt.VUnion { tag, slots } => Some((tag, slots)),\n    _ => match smt.val_key(v) {\n      Some(k) => Some((\"0\", [(k, v)])),\n      None => None,\n    },\n  }\n}"},{"name":"smt.slot_value","kind":"fn","old":"31ac41572e4fd9ba","new":"a40f2f59e69c1cec","interface_changed":false,"affected":[],"module":"smt","text":"/// The value in slot `k`, `Inactive` when there is none.\nfn slot_value(slots: List[(String, smt.Val)], k: String) -> smt.Val {\n  for s in slots {\n    if s.0 == k {\n      return s.1\n    }\n  }\n  smt.Inactive\n}","old_text":"/// The value in slot `k` (`Inactive` when there is none).\nfn slot_value(slots: List[(String, smt.Val)], k: String) -> smt.Val {\n  for s in slots {\n    if s.0 == k {\n      return s.1\n    }\n  }\n  smt.Inactive\n}"},{"name":"smt.key_index","kind":"fn","old":"e9f6e7ef442adee1","new":"bf07ee08de5ca9d3","interface_changed":false,"affected":[],"module":"smt","text":"/// The index of `k` in `keys`, 0 when absent.\nfn key_index(keys: List[String], k: String) -> Int {\n  for (i, x) in enumerate(keys) {\n    if x == k {\n      return i\n    }\n  }\n  0\n}","old_text":"/// Where `k` is in `keys` (0 when it isn't).\nfn key_index(keys: List[String], k: String) -> Int {\n  for (i, x) in enumerate(keys) {\n    if x == k {\n      return i\n    }\n  }\n  0\n}"},{"name":"smt.union_as","kind":"fn","old":"fab698c7e1ec8e95","new":"e7652bf533724ef5","interface_changed":false,"affected":[],"module":"smt","text":"/// A union value used as an `Int` (or `Bool`, `String`, a list's length,\n/// `Len`): its member of that shape when that member is active, any value\n/// otherwise.\nfn union_as(\n  mut vc: smt.Vc,\n  v: smt.Val,\n  key: String,\n  sort: String,\n) -> Option[String] {\n  match v {\n    smt.VUnion { tag, slots } => {\n      i := smt.live_slot(slots, key)\n      if i < 0 {\n        return None\n      }\n      inner := match ((get(slots, i) ?? (\"\", smt.Inactive)).1, sort) {\n        (smt.VInt(t), \"Int\") | (smt.VBool(t), \"Bool\") | (smt.VStr(t), \"String\") => t,\n        (smt.VList { len: l, .. }, \"Len\") => l,\n        _ => return None,\n      }\n      other := smt.fresh_why(mut vc, if sort == \"Len\" {\n        \"Int\"\n      } else {\n        sort\n      }, \"a union value used as one of its members\")\n      Some(smt.ite(f\"(= {tag} {i})\", inner, other))\n    },\n    _ => None,\n  }\n}","old_text":"/// A union value used as an `Int` (`Bool`, `String`, a list's length,\n/// `Len`): its member of that shape when that member is the active one,\n/// any value otherwise.\nfn union_as(\n  mut vc: smt.Vc,\n  v: smt.Val,\n  key: String,\n  sort: String,\n) -> Option[String] {\n  match v {\n    smt.VUnion { tag, slots } => {\n      i := smt.live_slot(slots, key)\n      if i < 0 {\n        return None\n      }\n      inner := match ((get(slots, i) ?? (\"\", smt.Inactive)).1, sort) {\n        (smt.VInt(t), \"Int\") | (smt.VBool(t), \"Bool\") | (smt.VStr(t), \"String\") => t,\n        (smt.VList { len: l, .. }, \"Len\") => l,\n        _ => return None,\n      }\n      other := smt.fresh_why(mut vc, if sort == \"Len\" {\n        \"Int\"\n      } else {\n        sort\n      }, \"a union value used as one of its members\")\n      Some(smt.ite(f\"(= {tag} {i})\", inner, other))\n    },\n    _ => None,\n  }\n}"},{"name":"smt.type_key","kind":"fn","old":"e7041aafc02fd80f","new":"b2ffac4f1bc79182","interface_changed":false,"affected":[],"module":"smt","text":"/// The shape key of a type (see `val_key`), refinements ignored. `None` for\n/// unions, functions, floats, type parameters and traits.\nfn type_key(vc: smt.Vc, t: ast.TypeExpr) -> Option[String] {\n  match smt.expand_alias(vc, t) {\n    ast.UnitType => Some(\"Unit\"),\n    ast.Named { name, args } => match name {\n      \"Int\" | \"Bool\" | \"String\" | \"Unit\" => Some(name),\n      \"List\" | \"Dict\" | \"Set\" => Some(\"List*\"),\n      \"Tuple\" => Some(f\"Tuple/{len(args)}\"),\n      _ => match get(vc.parents, name) {\n        Some(p) => Some(\"sum:\" + p),\n        None => {\n          td := get(vc.types, name)?\n          match td.body {\n            ast.Alias(_) => if td.distinct {\n              Some(\"distinct:\" + name)\n            } else {\n              None\n            },\n            ast.RecordBody(_) => Some(\"rec:\" + name),\n            ast.SumBody(_) => Some(\"sum:\" + name),\n          }\n        },\n      },\n    },\n    _ => None,\n  }\n}","old_text":"/// The shape key of a type (see `val_key`), refinements ignored; `None`\n/// for unions, functions, floats, type parameters and traits.\nfn type_key(vc: smt.Vc, t: ast.TypeExpr) -> Option[String] {\n  match smt.expand_alias(vc, t) {\n    ast.UnitType => Some(\"Unit\"),\n    ast.Named { name, args } => match name {\n      \"Int\" | \"Bool\" | \"String\" | \"Unit\" => Some(name),\n      \"List\" | \"Dict\" | \"Set\" => Some(\"List*\"),\n      \"Tuple\" => Some(f\"Tuple/{len(args)}\"),\n      _ => match get(vc.parents, name) {\n        Some(p) => Some(\"sum:\" + p),\n        None => {\n          td := get(vc.types, name)?\n          match td.body {\n            ast.Alias(_) => if td.distinct {\n              Some(\"distinct:\" + name)\n            } else {\n              None\n            },\n            ast.RecordBody(_) => Some(\"rec:\" + name),\n            ast.SumBody(_) => Some(\"sum:\" + name),\n          }\n        },\n      },\n    },\n    _ => None,\n  }\n}"},{"name":"smt.flatten_union","kind":"fn","old":"077fbe6184add2da","new":"d84d459b6c71caca","interface_changed":false,"affected":[],"module":"smt","text":"/// The members of a union, through unrefined aliases of unions (`Shape |\n/// Int` with `type Shape = Square | Circle`).\nfn flatten_union(vc: smt.Vc, t: ast.TypeExpr) -> List[ast.TypeExpr] {\n  match t {\n    ast.UnionType(ms) => smt.flatten_all(vc, ms),\n    ast.Named { name, args } => match get(vc.types, name) {\n      Some(td) => match td.body {\n        ast.Alias(ast.UnionType(ms)) => if !td.distinct && td.refinement == None {\n          smt.flatten_union(\n            vc,\n            smt.subst(ast.UnionType(ms), smt.params_of(td, args)),\n          )\n        } else {\n          [t]\n        },\n        _ => [t],\n      },\n      None => [t],\n    },\n    _ => [t],\n  }\n}","old_text":"/// The members of a union, looking through unrefined aliases of unions\n/// (`Shape | Int` with `type Shape = Square | Circle`).\nfn flatten_union(vc: smt.Vc, t: ast.TypeExpr) -> List[ast.TypeExpr] {\n  match t {\n    ast.UnionType(ms) => smt.flatten_all(vc, ms),\n    ast.Named { name, args } => match get(vc.types, name) {\n      Some(td) => match td.body {\n        ast.Alias(ast.UnionType(ms)) => if !td.distinct && td.refinement == None {\n          smt.flatten_union(\n            vc,\n            smt.subst(ast.UnionType(ms), smt.params_of(td, args)),\n          )\n        } else {\n          [t]\n        },\n        _ => [t],\n      },\n      None => [t],\n    },\n    _ => [t],\n  }\n}"},{"name":"smt.union_groups","kind":"fn","old":"a730ccd3b768d67a","new":"7bd86e5688e276f8","interface_changed":false,"affected":[],"module":"smt","text":"/// The members of a union grouped by shape. `None` when two members could\n/// have the same shape in a way the slots can't tell apart (`List[Int] |\n/// List[String]`), or a member's shape is not known.\nfn union_groups(vc: smt.Vc, ms: List[ast.TypeExpr]) -> Option[List[smt.Group]] {\n  mut keys := []\n  mut members := []\n  for m in smt.flatten_all(vc, ms) {\n    k := smt.type_key(vc, m)?\n    if contains(keys, k) {\n      i := smt.key_index(keys, k)\n      members = take(members, i)\n        + [(get(members, i) ?? []) + [m]]\n        + drop(members, i + 1)\n    } else {\n      mut keys.push(k)\n      mut members.push([m])\n    }\n  }\n  mut out := []\n  for (i, k) in enumerate(keys) {\n    gm := get(members, i) ?? []\n    if starts_with(k, \"sum:\") {\n      // the sum itself or some of its variants: a value of the sum whose\n      // constructor is one of those variants\n      sum := byte_slice(k, 4, byte_len(k))\n      mut sum_args := []\n      mut first := true\n      mut whole := false\n      mut only := []\n      for m in gm {\n        match smt.expand_alias(vc, m) {\n          ast.Named { name, args } => {\n            if first {\n              sum_args = args\n              first = false\n            } else if sum_args != args {\n              return None\n            }\n            if name == sum {\n              whole = true\n            } else {\n              mut only.push(name)\n            }\n          },\n          _ => return None,\n        }\n      }\n      mut out.push(\n        smt.Group {\n          key: k,\n          ty: ast.Named { name: sum, args: sum_args },\n          only: if whole {\n            None\n          } else {\n            Some(only)\n          },\n        },\n      )\n    } else if len(gm) == 1 {\n      mut out.push(\n        smt.Group {\n          key: k,\n          ty: get(gm, 0) ?? ast.UnitType,\n          only: None,\n        },\n      )\n    } else if contains([\"Int\", \"Bool\", \"String\", \"Unit\"], k) {\n      // `Positive | Negative`: both are integers\n      mut out.push(smt.Group { key: k, ty: smt.named(k), only: None })\n    } else {\n      return None\n    }\n  }\n  Some(out)\n}","old_text":"/// The members of a union grouped by shape. `None` when two members could\n/// have the same shape in a way the slots can't tell apart\n/// (`List[Int] | List[String]`), or a member's shape is not known.\nfn union_groups(vc: smt.Vc, ms: List[ast.TypeExpr]) -> Option[List[smt.Group]] {\n  mut keys := []\n  mut members := []\n  for m in smt.flatten_all(vc, ms) {\n    k := smt.type_key(vc, m)?\n    if contains(keys, k) {\n      i := smt.key_index(keys, k)\n      members = take(members, i)\n        + [(get(members, i) ?? []) + [m]]\n        + drop(members, i + 1)\n    } else {\n      mut keys.push(k)\n      mut members.push([m])\n    }\n  }\n  mut out := []\n  for (i, k) in enumerate(keys) {\n    gm := get(members, i) ?? []\n    if starts_with(k, \"sum:\") {\n      // the sum itself or some of its variants: a value of the sum, whose\n      // constructor is one of those variants\n      sum := byte_slice(k, 4, byte_len(k))\n      mut sum_args := []\n      mut first := true\n      mut whole := false\n      mut only := []\n      for m in gm {\n        match smt.expand_alias(vc, m) {\n          ast.Named { name, args } => {\n            if first {\n              sum_args = args\n              first = false\n            } else if sum_args != args {\n              return None\n            }\n            if name == sum {\n              whole = true\n            } else {\n              mut only.push(name)\n            }\n          },\n          _ => return None,\n        }\n      }\n      mut out.push(\n        smt.Group {\n          key: k,\n          ty: ast.Named { name: sum, args: sum_args },\n          only: if whole {\n            None\n          } else {\n            Some(only)\n          },\n        },\n      )\n    } else if len(gm) == 1 {\n      mut out.push(\n        smt.Group {\n          key: k,\n          ty: get(gm, 0) ?? ast.UnitType,\n          only: None,\n        },\n      )\n    } else if contains([\"Int\", \"Bool\", \"String\", \"Unit\"], k) {\n      // `Positive | Negative`: both are integers\n      mut out.push(smt.Group { key: k, ty: smt.named(k), only: None })\n    } else {\n      return None\n    }\n  }\n  Some(out)\n}"},{"name":"smt.shape_test","kind":"fn","old":"9df833e3667985a5","new":"913581955f700790","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether `v` has the shape of `t`, refinements ignored. Exact where the\n/// shapes are known, else unknown.\nfn shape_test(mut vc: smt.Vc, t: ast.TypeExpr, v: smt.Val) -> String {\n  match v {\n    smt.VData { .. } => {\n      fv := smt.force(mut vc, v)\n      return smt.shape_test(mut vc, t, fv)\n    },\n    smt.Opaque(r) => return smt.unknown_bool(mut vc, r),\n    smt.Inactive => return \"false\",\n    smt.VUnion { tag, slots } => {\n      mut cs := []\n      for (i, s) in enumerate(slots) {\n        if !smt.is_absent(s.1) {\n          x := smt.shape_test(mut vc, t, s.1)\n          mut cs.push(smt.and_all([f\"(= {tag} {i})\", x]))\n        }\n      }\n      return smt.or_all(cs)\n    },\n    _ => (),\n  }\n  te := smt.expand_alias(vc, t)\n  match te {\n    ast.UnionType(ms) => {\n      mut cs := []\n      for m in ms {\n        mut cs.push(smt.shape_test(mut vc, m, v))\n      }\n      smt.or_all(cs)\n    },\n    ast.Named { name, args } => match (name, v) {\n      (\"List\", smt.VList { len: l, id }) => if len(args) == 0 || smt.elem_type(vc, id) == get(args, 0) {\n        \"true\"\n      } else {\n        u := smt.unknown_bool(\n          mut vc,\n          \"the elements of a list are not tracked\",\n        )\n        f\"(or (= {l} 0) {u})\"\n      },\n      (\"Dict\", smt.VList { .. }) | (\"Set\", smt.VList { .. }) => smt.unknown_bool(\n        mut vc,\n        \"dicts and sets are not modelled yet\",\n      ),\n      (\"Tuple\", smt.VTuple(xs)) => if len(xs) == len(args) {\n        mut cs := []\n        for (i, a) in enumerate(args) {\n          mut cs.push(\n            smt.shape_test(mut vc, a, get(xs, i) ?? smt.Inactive),\n          )\n        }\n        smt.and_all(cs)\n      } else {\n        smt.key_test(mut vc, te, name, v)\n      },\n      _ => smt.key_test(mut vc, te, name, v),\n    },\n    ast.UnitType => match smt.val_key(v) {\n      Some(k) => if k == \"Unit\" {\n        \"true\"\n      } else {\n        \"false\"\n      },\n      None => smt.unknown_bool(mut vc, \"a value of an unknown shape\"),\n    },\n    _ => smt.unknown_bool(mut vc, \"a type test that is not modelled\"),\n  }\n}","old_text":"/// Does `v` have the shape of `t` (refinements ignored)? Exact where the\n/// shapes are known, else unknown.\nfn shape_test(mut vc: smt.Vc, t: ast.TypeExpr, v: smt.Val) -> String {\n  match v {\n    smt.VData { .. } => {\n      fv := smt.force(mut vc, v)\n      return smt.shape_test(mut vc, t, fv)\n    },\n    smt.Opaque(r) => return smt.unknown_bool(mut vc, r),\n    smt.Inactive => return \"false\",\n    smt.VUnion { tag, slots } => {\n      mut cs := []\n      for (i, s) in enumerate(slots) {\n        if !smt.is_absent(s.1) {\n          x := smt.shape_test(mut vc, t, s.1)\n          mut cs.push(smt.and_all([f\"(= {tag} {i})\", x]))\n        }\n      }\n      return smt.or_all(cs)\n    },\n    _ => (),\n  }\n  te := smt.expand_alias(vc, t)\n  match te {\n    ast.UnionType(ms) => {\n      mut cs := []\n      for m in ms {\n        mut cs.push(smt.shape_test(mut vc, m, v))\n      }\n      smt.or_all(cs)\n    },\n    ast.Named { name, args } => match (name, v) {\n      (\"List\", smt.VList { len: l, id }) => if len(args) == 0 || smt.elem_type(vc, id) == get(args, 0) {\n        \"true\"\n      } else {\n        u := smt.unknown_bool(\n          mut vc,\n          \"the elements of a list are not tracked\",\n        )\n        f\"(or (= {l} 0) {u})\"\n      },\n      (\"Dict\", smt.VList { .. }) | (\"Set\", smt.VList { .. }) => smt.unknown_bool(\n        mut vc,\n        \"dicts and sets are not modelled yet\",\n      ),\n      (\"Tuple\", smt.VTuple(xs)) => if len(xs) == len(args) {\n        mut cs := []\n        for (i, a) in enumerate(args) {\n          mut cs.push(\n            smt.shape_test(mut vc, a, get(xs, i) ?? smt.Inactive),\n          )\n        }\n        smt.and_all(cs)\n      } else {\n        smt.key_test(mut vc, te, name, v)\n      },\n      _ => smt.key_test(mut vc, te, name, v),\n    },\n    ast.UnitType => match smt.val_key(v) {\n      Some(k) => if k == \"Unit\" {\n        \"true\"\n      } else {\n        \"false\"\n      },\n      None => smt.unknown_bool(mut vc, \"a value of an unknown shape\"),\n    },\n    _ => smt.unknown_bool(mut vc, \"a type test that is not modelled\"),\n  }\n}"},{"name":"smt.key_test","kind":"fn","old":"02dcb60befdfdf82","new":"01be48b0abb22346","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether `v` has the shape of the named type `te`, by their keys.\nfn key_test(\n  mut vc: smt.Vc,\n  te: ast.TypeExpr,\n  name: String,\n  v: smt.Val,\n) -> String {\n  match (smt.type_key(vc, te), smt.val_key(v)) {\n    (Some(a), Some(b)) => if a != b {\n      \"false\"\n    } else {\n      match (get(vc.parents, name), v) {\n        (Some(_), smt.VSum { tag, ctors, .. }) => match smt.position(ctors, name) {\n          Some(k) => f\"(= {tag} {k})\",\n          None => \"false\",\n        },\n        (Some(_), _) => smt.unknown_bool(mut vc, \"a value of an unexpected shape\"),\n        (None, _) => \"true\",\n      }\n    },\n    _ => smt.unknown_bool(mut vc, \"a type test that is not modelled\"),\n  }\n}","old_text":"/// Does `v` have the shape of the named type `te`, by their keys?\nfn key_test(\n  mut vc: smt.Vc,\n  te: ast.TypeExpr,\n  name: String,\n  v: smt.Val,\n) -> String {\n  match (smt.type_key(vc, te), smt.val_key(v)) {\n    (Some(a), Some(b)) => if a != b {\n      \"false\"\n    } else {\n      match (get(vc.parents, name), v) {\n        (Some(_), smt.VSum { tag, ctors, .. }) => match smt.position(ctors, name) {\n          Some(k) => f\"(= {tag} {k})\",\n          None => \"false\",\n        },\n        (Some(_), _) => smt.unknown_bool(mut vc, \"a value of an unexpected shape\"),\n        (None, _) => \"true\",\n      }\n    },\n    _ => smt.unknown_bool(mut vc, \"a type test that is not modelled\"),\n  }\n}"},{"name":"smt.in_type","kind":"fn","old":"76a390430a31f669","new":"4ed59548cb830666","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether `v` is a value of `t`: its shape fits and every refinement\n/// holds. Used by type patterns, `is`, and union validity.\nfn in_type(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  v: smt.Val,\n  extra: List[(String, smt.Val)],\n) -> String {\n  match v {\n    smt.VData { .. } => {\n      fv := smt.force(mut vc, v)\n      smt.in_type(mut vc, t, fv, extra)\n    },\n    smt.Opaque(r) => smt.unknown_bool(mut vc, r),\n    smt.Inactive => \"false\",\n    smt.VUnion { tag, slots } => {\n      mut cs := []\n      for (i, s) in enumerate(slots) {\n        if !smt.is_absent(s.1) {\n          c := smt.in_type(mut vc, t, s.1, extra)\n          mut cs.push(smt.and_all([f\"(= {tag} {i})\", c]))\n        }\n      }\n      smt.or_all(cs)\n    },\n    _ => {\n      s := smt.shape_test(mut vc, t, v)\n      if s == \"false\" {\n        return s\n      }\n      whole := match smt.expand_alias(vc, t) {\n        ast.UnionType(_) => true,\n        _ => false,\n      }\n      if s != \"true\"\n        && !whole\n        && (smt.type_key(vc, t) == None || smt.val_key(v) == None) {\n        // the shape is unknown: the refinements can't be evaluated on it\n        return s\n      }\n      c := smt.check_type(mut vc, t, v, extra)\n      smt.and_all([s, c])\n    },\n  }\n}","old_text":"/// Is `v` a value of `t` (its shape fits and every refinement holds)? What\n/// a type pattern and `is` test, and what makes a value valid for a union.\nfn in_type(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  v: smt.Val,\n  extra: List[(String, smt.Val)],\n) -> String {\n  match v {\n    smt.VData { .. } => {\n      fv := smt.force(mut vc, v)\n      smt.in_type(mut vc, t, fv, extra)\n    },\n    smt.Opaque(r) => smt.unknown_bool(mut vc, r),\n    smt.Inactive => \"false\",\n    smt.VUnion { tag, slots } => {\n      mut cs := []\n      for (i, s) in enumerate(slots) {\n        if !smt.is_absent(s.1) {\n          c := smt.in_type(mut vc, t, s.1, extra)\n          mut cs.push(smt.and_all([f\"(= {tag} {i})\", c]))\n        }\n      }\n      smt.or_all(cs)\n    },\n    _ => {\n      s := smt.shape_test(mut vc, t, v)\n      if s == \"false\" {\n        return s\n      }\n      whole := match smt.expand_alias(vc, t) {\n        ast.UnionType(_) => true,\n        _ => false,\n      }\n      if s != \"true\"\n        && !whole\n        && (smt.type_key(vc, t) == None || smt.val_key(v) == None) {\n        // the shape is unknown: the refinements can't be evaluated on it\n        return s\n      }\n      c := smt.check_type(mut vc, t, v, extra)\n      smt.and_all([s, c])\n    },\n  }\n}"},{"name":"smt.is_alias","kind":"fn","old":"45331f0ae4ee1d32","new":"18ea0d5f1cabd914","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether `t` names another type (a non-distinct alias).\nfn is_alias(vc: smt.Vc, t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Named { name, .. } => match get(vc.types, name) {\n      Some(td) => !td.distinct\n        && match td.body {\n          ast.Alias(_) => true,\n          _ => false,\n        },\n      None => false,\n    },\n    _ => false,\n  }\n}","old_text":"/// Is `t` a name for another type (a non-distinct alias)?\nfn is_alias(vc: smt.Vc, t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Named { name, .. } => match get(vc.types, name) {\n      Some(td) => !td.distinct\n        && match td.body {\n          ast.Alias(_) => true,\n          _ => false,\n        },\n      None => false,\n    },\n    _ => false,\n  }\n}"},{"name":"smt.union_or_refined","kind":"fn","old":"01aa50e3be253ccb","new":"3fb0a9eb10aea743","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether `t` is a union or a refined type.\nfn union_or_refined(t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.UnionType(_) | ast.Refined { .. } => true,\n    _ => false,\n  }\n}","old_text":"/// Is `t` a union or a refined type?\nfn union_or_refined(t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.UnionType(_) | ast.Refined { .. } => true,\n    _ => false,\n  }\n}"},{"name":"smt.pattern_key","kind":"fn","old":"299eab96987034c7","new":"72034a075f4083b0","interface_changed":false,"affected":[],"module":"smt","text":"/// The shape a literal, tuple, list or constructor pattern needs. Other\n/// patterns test the value as a whole.\nfn pattern_key(vc: smt.Vc, p: ast.Pattern) -> Option[String] {\n  match p {\n    ast.IntPat(_) => Some(\"Int\"),\n    ast.BoolPat(_) => Some(\"Bool\"),\n    ast.StrPat(_) => Some(\"String\"),\n    ast.TuplePat(ps) => Some(f\"Tuple/{len(ps)}\"),\n    ast.ListPat { .. } => Some(\"List*\"),\n    ast.CtorPattern { name, .. } => {\n      tn := get(vc.ctors, name)?\n      td := get(vc.types, tn)?\n      match td.body {\n        ast.Alias(_) => if td.distinct {\n          Some(\"distinct:\" + tn)\n        } else {\n          None\n        },\n        ast.RecordBody(_) => Some(\"rec:\" + tn),\n        ast.SumBody(_) => Some(\"sum:\" + tn),\n      }\n    },\n    _ => None,\n  }\n}","old_text":"/// The shape a pattern needs, when it is a literal, tuple, list or\n/// constructor pattern (others test the value as a whole).\nfn pattern_key(vc: smt.Vc, p: ast.Pattern) -> Option[String] {\n  match p {\n    ast.IntPat(_) => Some(\"Int\"),\n    ast.BoolPat(_) => Some(\"Bool\"),\n    ast.StrPat(_) => Some(\"String\"),\n    ast.TuplePat(ps) => Some(f\"Tuple/{len(ps)}\"),\n    ast.ListPat { .. } => Some(\"List*\"),\n    ast.CtorPattern { name, .. } => {\n      tn := get(vc.ctors, name)?\n      td := get(vc.types, tn)?\n      match td.body {\n        ast.Alias(_) => if td.distinct {\n          Some(\"distinct:\" + tn)\n        } else {\n          None\n        },\n        ast.RecordBody(_) => Some(\"rec:\" + tn),\n        ast.SumBody(_) => Some(\"sum:\" + tn),\n      }\n    },\n    _ => None,\n  }\n}"},{"name":"smt.pattern_type","kind":"fn","old":"32e1218cfa687934","new":"2f6e1b560315df49","interface_changed":false,"affected":[],"module":"smt","text":"/// The type a pattern names (`Positive =>`, `List[Int] =>`), if it names a\n/// type instead of a constructor.\nfn pattern_type(vc: smt.Vc, p: ast.Pattern) -> Option[ast.TypeExpr] {\n  match p {\n    ast.CtorPattern { name, args: ast.NoPats } => if !contains(vc.ctors, name) && smt.is_type_name(vc, name) {\n      Some(smt.named(name))\n    } else {\n      None\n    },\n    ast.CtorPattern { name, args: ast.TypePats(ps) } => if smt.is_type_name(vc, name) {\n      mut ts := []\n      for q in ps {\n        mut ts.push(smt.pattern_type(vc, q)?)\n      }\n      Some(ast.Named { name, args: ts })\n    } else {\n      None\n    },\n    _ => None,\n  }\n}","old_text":"/// The type a pattern names (`Positive =>`, `List[Int] =>`), if it names\n/// one rather than a constructor.\nfn pattern_type(vc: smt.Vc, p: ast.Pattern) -> Option[ast.TypeExpr] {\n  match p {\n    ast.CtorPattern { name, args: ast.NoPats } => if !contains(vc.ctors, name) && smt.is_type_name(vc, name) {\n      Some(smt.named(name))\n    } else {\n      None\n    },\n    ast.CtorPattern { name, args: ast.TypePats(ps) } => if smt.is_type_name(vc, name) {\n      mut ts := []\n      for q in ps {\n        mut ts.push(smt.pattern_type(vc, q)?)\n      }\n      Some(ast.Named { name, args: ts })\n    } else {\n      None\n    },\n    _ => None,\n  }\n}"},{"name":"smt.arm_slots","kind":"fn","old":"c62406198d14b80c","new":"30095db93dd7f6e5","interface_changed":false,"affected":[],"module":"smt","text":"/// The slots of a union value a pattern can match. The others make its\n/// condition `false`, so the arm's guard rules them out.\nfn arm_slots(\n  mut vc: smt.Vc,\n  p: ast.Pattern,\n  slots: List[(String, smt.Val)],\n) -> List[Int] {\n  mut out := []\n  match p {\n    ast.OrPat(alts) => {\n      for a in alts {\n        for i in smt.arm_slots(mut vc, a, slots) {\n          if !contains(out, i) {\n            mut out.push(i)\n          }\n        }\n      }\n    },\n    _ => match smt.pattern_type(vc, p) {\n      Some(t) => {\n        for (i, s) in enumerate(slots) {\n          if !smt.is_absent(s.1)\n            && smt.shape_test(mut vc, t, s.1) != \"false\" {\n            mut out.push(i)\n          }\n        }\n      },\n      None => {\n        k := smt.pattern_key(vc, p)\n        for (i, s) in enumerate(slots) {\n          if !smt.is_absent(s.1) && (k == None || k == Some(s.0)) {\n            mut out.push(i)\n          }\n        }\n      },\n    },\n  }\n  out\n}","old_text":"/// The slots of a union value a pattern can match (the others make its\n/// condition `false`, so the arm's guard rules them out).\nfn arm_slots(\n  mut vc: smt.Vc,\n  p: ast.Pattern,\n  slots: List[(String, smt.Val)],\n) -> List[Int] {\n  mut out := []\n  match p {\n    ast.OrPat(alts) => {\n      for a in alts {\n        for i in smt.arm_slots(mut vc, a, slots) {\n          if !contains(out, i) {\n            mut out.push(i)\n          }\n        }\n      }\n    },\n    _ => match smt.pattern_type(vc, p) {\n      Some(t) => {\n        for (i, s) in enumerate(slots) {\n          if !smt.is_absent(s.1)\n            && smt.shape_test(mut vc, t, s.1) != \"false\" {\n            mut out.push(i)\n          }\n        }\n      },\n      None => {\n        k := smt.pattern_key(vc, p)\n        for (i, s) in enumerate(slots) {\n          if !smt.is_absent(s.1) && (k == None || k == Some(s.0)) {\n            mut out.push(i)\n          }\n        }\n      },\n    },\n  }\n  out\n}"},{"name":"smt.LoopInfo","kind":"type","old":"20d0e750ae9f3810","new":"917ab7c62c915a0b","interface_changed":false,"affected":[],"module":"smt","text":"/// One `while` loop, or a `loop` with a `decreases` clause, for the\n/// termination check:\n/// - `head`: as written;\n/// - the candidate bounds with their obligations (\"goes down on every\n/// pass\", indices in `Vc.term_obs`). The first `singles` are one measure\n/// each, the rest pairs of them compared in order;\n/// - whether every pass leaves the loop;\n/// - `written`: the `decreases` clause as written (`decreases (a, b)`),\n/// whose measure is then the only candidate.\npub type LoopInfo = {\n  what: String,\n  candidates: List[(String, Int)],\n  always_exits: Bool,\n  singles: Int,\n  written: String,\n}","old_text":"/// One `while` loop (or a `loop` with a `decreases` clause), for the\n/// termination check: its head as written, the candidate bounds with their\n/// obligations (indices in `Vc.term_obs`: \"goes down on every pass\"), and\n/// whether every pass leaves the loop. The first `singles` candidates are\n/// one measure each; the others pairs of them compared in order. With a\n/// `decreases` clause (`written`, as written: `decreases (a, b)`), its\n/// measure is the one candidate.\npub type LoopInfo = {\n  what: String,\n  candidates: List[(String, Int)],\n  always_exits: Bool,\n  singles: Int,\n  written: String,\n}"},{"name":"smt.int_of","kind":"fn","old":"fdbf8ebc32e088c2","new":"84cc214dc7fec75a","interface_changed":false,"affected":[],"module":"smt","text":"// ---- termination ----\n\n/// An integer expression over the parameters, evaluated with `binds`.\nfn int_of(\n  mut vc: smt.Vc,\n  e: ast.Expr,\n  binds: List[(String, smt.Val)],\n) -> String {\n  saved := vc.scopes\n  vc.scopes = [dict(binds)]\n  vc.spec += 1\n  v := smt.eval(mut vc, e)\n  vc.spec -= 1\n  vc.scopes = saved\n  smt.as_int(mut vc, v)\n}","old_text":"// ---- termination (compiler/termination) ----\n\n/// An integer expression over the parameters, evaluated with `binds`.\nfn int_of(\n  mut vc: smt.Vc,\n  e: ast.Expr,\n  binds: List[(String, smt.Val)],\n) -> String {\n  saved := vc.scopes\n  vc.scopes = [dict(binds)]\n  vc.spec += 1\n  v := smt.eval(mut vc, e)\n  vc.spec -= 1\n  vc.scopes = saved\n  smt.as_int(mut vc, v)\n}"},{"name":"smt.measure_check","kind":"fn","old":"e89a79165e5d786a","new":"f8e7351358770142","interface_changed":false,"affected":[],"module":"smt","text":"/// The obligation that the measure goes down at recursive call `site`: the\n/// measures `ms` compared lexicographically, each non-negative where it\n/// decides. Returns its index in `Vc.term_obs`.\npub fn measure_check(mut vc: smt.Vc, site: Int, ms: List[ast.Expr]) -> Int {\n  (pc, args) := get(vc.rec_sites, site) ?? ([], [])\n  (bs, as_) := smt.measures_at(mut vc, ms, args)\n  shown := join(ms.map(m -> text.expr_text(m, 0)), \", \")\n  mut vc.term_obs.push(\n    smt.Obligation {\n      what: f\"measure ({shown}) goes down\",\n      goal: smt.lex_down(bs, as_),\n      pc,\n      facts: len(vc.facts),\n    },\n  )\n  len(vc.term_obs) - 1\n}","old_text":"/// The obligation that, at recursive call `site`, the measure goes down:\n/// the measures `ms` compared in order (lexicographically), each never\n/// negative where it decides. Its index in `Vc.term_obs`.\npub fn measure_check(mut vc: smt.Vc, site: Int, ms: List[ast.Expr]) -> Int {\n  (pc, args) := get(vc.rec_sites, site) ?? ([], [])\n  (bs, as_) := smt.measures_at(mut vc, ms, args)\n  shown := join(ms.map(m -> text.expr_text(m, 0)), \", \")\n  mut vc.term_obs.push(\n    smt.Obligation {\n      what: f\"measure ({shown}) goes down\",\n      goal: smt.lex_down(bs, as_),\n      pc,\n      facts: len(vc.facts),\n    },\n  )\n  len(vc.term_obs) - 1\n}"},{"name":"smt.refined_ctor","kind":"fn","old":"1c2897c0c4e5955c","new":"07d2021dfb0ca705","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether constructing with `name` checks its type's refinement.\npub fn refined_ctor(vc: smt.Vc, name: String) -> Bool {\n  smt.refined(vc, smt.named(get(vc.ctors, name) ?? \"\"))\n}","old_text":"/// Whether constructing with `name` checks a refinement (its type's).\npub fn refined_ctor(vc: smt.Vc, name: String) -> Bool {\n  smt.refined(vc, smt.named(get(vc.ctors, name) ?? \"\"))\n}"},{"name":"smt.candidate_shown","kind":"fn","old":"269655099a99df27","new":"b0613fa0ebea0b1d","interface_changed":false,"affected":[],"module":"smt","text":"// ---- verify: answers with their counterexamples ----\n\n/// A candidate invariant as shown: `$entry_x` written `x₀`, plus `(it = x)`\n/// for one about the returned variable.\nfn candidate_shown(c: smt.Candidate) -> String {\n  mut out := \"\"\n  mut rest := text.expr_text(c.e, 0)\n  while contains(rest, \"$entry_\") {\n    k := index_of(rest, \"$entry_\") ?? 0\n    out += byte_slice(rest, 0, k)\n    after := byte_slice(rest, k + 7, byte_len(rest))\n    mut n := 0\n    while n < byte_len(after) && smt.is_word_byte(byte_at(after, n))\n      invariant n <= byte_len(after)\n      invariant n >= 0 {\n      n += 1\n    }\n    out += byte_slice(after, 0, n) + \"₀\"\n    rest = byte_slice(after, n, byte_len(after))\n  }\n  out += rest\n  match c.it {\n    Some(x) => out + \" (it = \" + x + \")\",\n    None => out,\n  }\n}","old_text":"// ---- verify: answers with their counterexamples (compiler `verify`) ----\n\n/// A candidate invariant as shown: `$entry_x` written `x₀`, with `(it =\n/// x)` for one about the returned variable.\nfn candidate_shown(c: smt.Candidate) -> String {\n  mut out := \"\"\n  mut rest := text.expr_text(c.e, 0)\n  while contains(rest, \"$entry_\") {\n    k := index_of(rest, \"$entry_\") ?? 0\n    out += byte_slice(rest, 0, k)\n    after := byte_slice(rest, k + 7, byte_len(rest))\n    mut n := 0\n    while n < byte_len(after) && smt.is_word_byte(byte_at(after, n))\n      invariant n <= byte_len(after)\n      invariant n >= 0 {\n      n += 1\n    }\n    out += byte_slice(after, 0, n) + \"₀\"\n    rest = byte_slice(after, n, byte_len(after))\n  }\n  out += rest\n  match c.it {\n    Some(x) => out + \" (it = \" + x + \")\",\n    None => out,\n  }\n}"},{"name":"smt.Answer","kind":"type","old":"a611fab41e746274","new":"938fe5a92d00820f","interface_changed":false,"affected":[],"module":"smt","text":"/// The solver's answer to an obligation, for `verify`: `proven`, `refuted`\n/// (with a value for each parameter, as code) or `unknown`, with a message.\npub type Answer = {\n  outcome: String,\n  what: String,\n  message: String,\n  args: List[(String, ast.Expr)],\n}","old_text":"/// The solver's answer to an obligation, for `verify`: `proven`,\n/// `refuted` (with a value for each parameter, as code) or `unknown`; with\n/// Rust's message.\npub type Answer = {\n  outcome: String,\n  what: String,\n  message: String,\n  args: List[(String, ast.Expr)],\n}"},{"name":"smt.int_literal","kind":"fn","old":"0d03b77800d88fd7","new":"248020d157112777","interface_changed":false,"affected":[],"module":"smt","text":"/// A model's integer (`5`, `(- 3)`) as code.\nfn int_literal(s: String) -> Option[ast.Expr] {\n  t := trim(s)\n  (neg, digits) := if starts_with(t, \"(-\") && ends_with(t, \")\") {\n    (true, trim(byte_slice(t, 2, byte_len(t) - 1)))\n  } else if starts_with(t, \"-\") {\n    (true, byte_slice(t, 1, byte_len(t)))\n  } else {\n    (false, t)\n  }\n  if !smt.is_digits(digits) {\n    return None\n  }\n  if byte_len(digits) > 18 {\n    return Some(if neg {\n      ast.Unary { op: ast.Neg, operand: ast.BigIntLit(digits) }\n    } else {\n      ast.BigIntLit(digits)\n    })\n  }\n  n := parse_int(digits)?\n  Some(ast.IntLit(if neg {\n    0 - n\n  } else {\n    n\n  }))\n}","old_text":"/// An integer of a model (`5`, `(- 3)`), as code.\nfn int_literal(s: String) -> Option[ast.Expr] {\n  t := trim(s)\n  (neg, digits) := if starts_with(t, \"(-\") && ends_with(t, \")\") {\n    (true, trim(byte_slice(t, 2, byte_len(t) - 1)))\n  } else if starts_with(t, \"-\") {\n    (true, byte_slice(t, 1, byte_len(t)))\n  } else {\n    (false, t)\n  }\n  if !smt.is_digits(digits) {\n    return None\n  }\n  if byte_len(digits) > 18 {\n    return Some(if neg {\n      ast.Unary { op: ast.Neg, operand: ast.BigIntLit(digits) }\n    } else {\n      ast.BigIntLit(digits)\n    })\n  }\n  n := parse_int(digits)?\n  Some(ast.IntLit(if neg {\n    0 - n\n  } else {\n    n\n  }))\n}"},{"name":"smt.str_value","kind":"fn","old":"7cb2f7ed0b742211","new":"8617c22db1c260c0","interface_changed":false,"affected":[],"module":"smt","text":"/// A model's string (`\"a\"\"b\\u{e9}\"`) as its text.\nfn str_value(s: String) -> Option[String] {\n  if !smt.str_text(s) {\n    return None\n  }\n  inner := replace(byte_slice(s, 1, byte_len(s) - 1), \"\\\"\\\"\", \"\\\"\")\n  mut out := \"\"\n  mut rest := inner\n  while contains(rest, \"\\u{\") {\n    p := index_of(rest, \"\\u{\") ?? 0\n    out += byte_slice(rest, 0, p)\n    after := byte_slice(rest, p + 3, byte_len(rest))\n    c := index_of(after, \"}\")?\n    out += chr(smt.hex_value(byte_slice(after, 0, c)))\n    rest = byte_slice(after, c + 1, byte_len(after))\n  }\n  Some(out + rest)\n}","old_text":"/// A string of a model (`\"a\"\"b\\u{e9}\"`), as its text.\nfn str_value(s: String) -> Option[String] {\n  if !smt.str_text(s) {\n    return None\n  }\n  inner := replace(byte_slice(s, 1, byte_len(s) - 1), \"\\\"\\\"\", \"\\\"\")\n  mut out := \"\"\n  mut rest := inner\n  while contains(rest, \"\\u{\") {\n    p := index_of(rest, \"\\u{\") ?? 0\n    out += byte_slice(rest, 0, p)\n    after := byte_slice(rest, p + 3, byte_len(rest))\n    c := index_of(after, \"}\")?\n    out += chr(smt.hex_value(byte_slice(after, 0, c)))\n    rest = byte_slice(after, c + 1, byte_len(after))\n  }\n  Some(out + rest)\n}"},{"name":"smt.literal_of","kind":"fn","old":"95a31acb01fa5445","new":"a092acc65c05d279","interface_changed":false,"affected":[],"module":"smt","text":"/// A model's value of `v` as code. `None` when part of it can't be shown.\npub fn literal_of(\n  vc: smt.Vc,\n  v: smt.Val,\n  m: Dict[String, smt.Sx],\n) -> Option[ast.Expr] {\n  match v {\n    smt.VData { ty, t } => smt.sx_literal(vc, ty, get(m, t)?),\n    smt.VInt(t) => smt.int_literal(smt.sx_text(get(m, t)?)),\n    smt.VBool(t) => Some(ast.BoolLit(smt.sx_text(get(m, t)?) == \"true\")),\n    smt.VStr(t) => Some(ast.StrLit(smt.str_value(smt.sx_text(get(m, t)?))?)),\n    smt.UnitVal => Some(ast.UnitExpr),\n    smt.VTuple(xs) => Some(ast.TupleExpr(\n      smt.all_some(xs.map(x -> smt.literal_of(vc, x, m)))?,\n    )),\n    smt.VRec { name, fields } => {\n      mut fs := []\n      for (f, x) in fields {\n        mut fs.push((f, smt.literal_of(vc, x, m)?))\n      }\n      Some(ast.CtorExpr { name, args: ast.RecordArgs(fs) })\n    },\n    smt.VDistinct { name, inner } => if contains(\n      [\"I8\", \"I16\", \"I32\", \"I64\", \"U8\", \"U16\", \"U32\", \"U64\"],\n      name,\n    ) {\n      smt.literal_of(vc, inner, m)\n    } else {\n      Some(ast.CtorExpr {\n        name,\n        args: ast.PositionalArgs([smt.literal_of(vc, inner, m)?]),\n      })\n    },\n    smt.VList { len: lt, id } => {\n      k := parse_int(trim(smt.sx_text(get(m, lt)?)))?\n      source := smt.list_info(vc, id).source\n      match get(vc.keyed, id) {\n        // a dict or set: its first entries (`open_map`), when it has no\n        // more\n        Some(ast.Named { name, args }) => {\n          elems := if k == 0 {\n            []\n          } else {\n            get(vc.input_elems, id)?\n          }\n          if k > len(elems) {\n            return None\n          }\n          xs := smt.all_some(\n            elems[..k].map(x -> smt.literal_of(vc, x, m)),\n          )?\n          return if name == \"Dict\" {\n            mut entries := []\n            for x in xs {\n              match x {\n                ast.TupleExpr([a, b]) => mut entries.push((a, b)),\n                _ => return None,\n              }\n            }\n            Some(ast.DictExpr { types: args, entries })\n          } else {\n            Some(ast.SetExpr { types: args, elems: xs })\n          }\n        },\n        Some(_) => return None,\n        None => (),\n      }\n      if k == 0 {\n        return Some(ast.ListExpr([]))\n      }\n      match source {\n        smt.GSeq(s, t, n) => if k <= smt.input_len() && !contains(vc.input_elems, id) {\n          mut xs := []\n          for i in 0..k {\n            mut xs.push(\n              smt.sx_literal(\n                vc,\n                t,\n                get(m, smt.seq_at(n, s, f\"{i}\"))?,\n              )?,\n            )\n          }\n          return Some(ast.ListExpr(xs))\n        },\n        _ => (),\n      }\n      elems := get(vc.input_elems, id)?\n      if k > len(elems) {\n        return None\n      }\n      Some(ast.ListExpr(\n        smt.all_some(elems[..k].map(x -> smt.literal_of(vc, x, m)))?,\n      ))\n    },\n    smt.VSum { ty, args, tag, ctors } => {\n      k := parse_int(trim(smt.sx_text(get(m, tag)?)))?\n      c := get(ctors, k)?\n      vs := smt.variants_of(vc, ty, args)?\n      v0 := get(vs, k)?\n      fields := smt.all_some(c.1.map(y -> smt.literal_of(vc, y, m)))?\n      Some(ast.CtorExpr {\n        name: c.0,\n        args: smt.ctor_args(v0.fields, fields),\n      })\n    },\n    // a union value is its active member's value\n    smt.VUnion { tag, slots } => {\n      k := parse_int(trim(smt.sx_text(get(m, tag)?)))?\n      smt.literal_of(vc, get(slots, k)?.1, m)\n    },\n    _ => None,\n  }\n}","old_text":"/// A model's value of `v` as code (Rust's `to_literal`): `None` when part\n/// of it can't be shown.\npub fn literal_of(\n  vc: smt.Vc,\n  v: smt.Val,\n  m: Dict[String, smt.Sx],\n) -> Option[ast.Expr] {\n  match v {\n    smt.VData { ty, t } => smt.sx_literal(vc, ty, get(m, t)?),\n    smt.VInt(t) => smt.int_literal(smt.sx_text(get(m, t)?)),\n    smt.VBool(t) => Some(ast.BoolLit(smt.sx_text(get(m, t)?) == \"true\")),\n    smt.VStr(t) => Some(ast.StrLit(smt.str_value(smt.sx_text(get(m, t)?))?)),\n    smt.UnitVal => Some(ast.UnitExpr),\n    smt.VTuple(xs) => Some(ast.TupleExpr(\n      smt.all_some(xs.map(x -> smt.literal_of(vc, x, m)))?,\n    )),\n    smt.VRec { name, fields } => {\n      mut fs := []\n      for (f, x) in fields {\n        mut fs.push((f, smt.literal_of(vc, x, m)?))\n      }\n      Some(ast.CtorExpr { name, args: ast.RecordArgs(fs) })\n    },\n    smt.VDistinct { name, inner } => if contains(\n      [\"I8\", \"I16\", \"I32\", \"I64\", \"U8\", \"U16\", \"U32\", \"U64\"],\n      name,\n    ) {\n      smt.literal_of(vc, inner, m)\n    } else {\n      Some(ast.CtorExpr {\n        name,\n        args: ast.PositionalArgs([smt.literal_of(vc, inner, m)?]),\n      })\n    },\n    smt.VList { len: lt, id } => {\n      k := parse_int(trim(smt.sx_text(get(m, lt)?)))?\n      source := smt.list_info(vc, id).source\n      match get(vc.keyed, id) {\n        // a dict or set: its first entries (`open_map`), when it has no\n        // more\n        Some(ast.Named { name, args }) => {\n          elems := if k == 0 {\n            []\n          } else {\n            get(vc.input_elems, id)?\n          }\n          if k > len(elems) {\n            return None\n          }\n          xs := smt.all_some(\n            elems[..k].map(x -> smt.literal_of(vc, x, m)),\n          )?\n          return if name == \"Dict\" {\n            mut entries := []\n            for x in xs {\n              match x {\n                ast.TupleExpr([a, b]) => mut entries.push((a, b)),\n                _ => return None,\n              }\n            }\n            Some(ast.DictExpr { types: args, entries })\n          } else {\n            Some(ast.SetExpr { types: args, elems: xs })\n          }\n        },\n        Some(_) => return None,\n        None => (),\n      }\n      if k == 0 {\n        return Some(ast.ListExpr([]))\n      }\n      match source {\n        smt.GSeq(s, t, n) => if k <= smt.input_len() && !contains(vc.input_elems, id) {\n          mut xs := []\n          for i in 0..k {\n            mut xs.push(\n              smt.sx_literal(\n                vc,\n                t,\n                get(m, smt.seq_at(n, s, f\"{i}\"))?,\n              )?,\n            )\n          }\n          return Some(ast.ListExpr(xs))\n        },\n        _ => (),\n      }\n      elems := get(vc.input_elems, id)?\n      if k > len(elems) {\n        return None\n      }\n      Some(ast.ListExpr(\n        smt.all_some(elems[..k].map(x -> smt.literal_of(vc, x, m)))?,\n      ))\n    },\n    smt.VSum { ty, args, tag, ctors } => {\n      k := parse_int(trim(smt.sx_text(get(m, tag)?)))?\n      c := get(ctors, k)?\n      vs := smt.variants_of(vc, ty, args)?\n      v0 := get(vs, k)?\n      fields := smt.all_some(c.1.map(y -> smt.literal_of(vc, y, m)))?\n      Some(ast.CtorExpr {\n        name: c.0,\n        args: smt.ctor_args(v0.fields, fields),\n      })\n    },\n    // a union value is its active member's value\n    smt.VUnion { tag, slots } => {\n      k := parse_int(trim(smt.sx_text(get(m, tag)?)))?\n      smt.literal_of(vc, get(slots, k)?.1, m)\n    },\n    _ => None,\n  }\n}"},{"name":"smt.sx_literal","kind":"fn","old":"98cbf01a0a8e5d0e","new":"4fce42a15aacb27d","interface_changed":false,"affected":[],"module":"smt","text":"/// A model's term of type `ty` as code.\nfn sx_literal(vc: smt.Vc, ty: ast.TypeExpr, x0: smt.Sx) -> Option[ast.Expr] {\n  x := match x0 {\n    smt.SList([smt.SAtom(\"as\"), y, _]) => y,\n    _ => x0,\n  }\n  match ty {\n    ast.Refined { base, .. } => smt.sx_literal(vc, base, x),\n    ast.UnitType => Some(ast.UnitExpr),\n    ast.FnType { .. } => None,\n    ast.UnionType(ms) => {\n      gs := smt.union_groups(vc, ms)?\n      (c, xs) := smt.sx_call(x)?\n      k := parse_int(smt.after_dot(c))?\n      smt.sx_literal(vc, get(gs, k)?.ty, get(xs, 0)?)\n    },\n    ast.Named { name, args } => if name == \"Int\"\n      || contains(\n        [\"I8\", \"I16\", \"I32\", \"I64\", \"U8\", \"U16\", \"U32\", \"U64\"],\n        name,\n      ) {\n      smt.int_literal(smt.sx_text(x))\n    } else if name == \"Bool\" {\n      match x {\n        smt.SAtom(a) => Some(ast.BoolLit(a == \"true\")),\n        _ => None,\n      }\n    } else if name == \"String\" {\n      Some(ast.StrLit(smt.str_value(smt.sx_text(x))?))\n    } else if name == \"List\" {\n      mut out := []\n      if smt.seq_items(vc, get(args, 0)?, x, mut out) {\n        Some(ast.ListExpr(out))\n      } else {\n        None\n      }\n    } else if name == \"Tuple\" {\n      (_, xs) := smt.sx_call(x)?\n      mut out := []\n      for (i, a) in enumerate(args) {\n        mut out.push(smt.sx_literal(vc, a, get(xs, i)?)?)\n      }\n      Some(ast.TupleExpr(out))\n    } else if name == \"Task\" {\n      smt.sx_literal(vc, get(args, 0)?, x)\n    } else if name == \"Float\" || name == \"Dict\" || name == \"Set\" {\n      None\n    } else {\n      match get(vc.parents, name) {\n        Some(p) => smt.sx_literal(vc, ast.Named { name: p, args }, x),\n        None => {\n          td := get(vc.types, name)?\n          match td.body {\n            ast.Alias(a) => if td.distinct {\n              Some(ast.CtorExpr {\n                name,\n                args: ast.PositionalArgs([smt.sx_literal(\n                  vc,\n                  smt.subst(a, smt.params_of(td, args)),\n                  x,\n                )?]),\n              })\n            } else {\n              smt.sx_literal(\n                vc,\n                smt.subst(a, smt.params_of(td, args)),\n                x,\n              )\n            },\n            _ => {\n              (c, xs) := smt.sx_call(x)?\n              prefix := smt.dt_name(smt.sort_type(vc, ty)) + \".\"\n              if !starts_with(c, prefix) {\n                return None\n              }\n              cname := byte_slice(c, byte_len(prefix), byte_len(c))\n              v := get(smt.variants_of(vc, name, args)?.filter(\n                y -> y.name == cname,\n              ), 0)?\n              mut fields := []\n              for (i, ft) in enumerate(v.types) {\n                mut fields.push(smt.sx_literal(vc, ft, get(xs, i)?)?)\n              }\n              Some(ast.CtorExpr {\n                name: v.name,\n                args: smt.ctor_args(v.fields, fields),\n              })\n            },\n          }\n        },\n      }\n    },\n  }\n}","old_text":"/// A model's term of type `ty` as code (Rust's `sx_literal`).\nfn sx_literal(vc: smt.Vc, ty: ast.TypeExpr, x0: smt.Sx) -> Option[ast.Expr] {\n  x := match x0 {\n    smt.SList([smt.SAtom(\"as\"), y, _]) => y,\n    _ => x0,\n  }\n  match ty {\n    ast.Refined { base, .. } => smt.sx_literal(vc, base, x),\n    ast.UnitType => Some(ast.UnitExpr),\n    ast.FnType { .. } => None,\n    ast.UnionType(ms) => {\n      gs := smt.union_groups(vc, ms)?\n      (c, xs) := smt.sx_call(x)?\n      k := parse_int(smt.after_dot(c))?\n      smt.sx_literal(vc, get(gs, k)?.ty, get(xs, 0)?)\n    },\n    ast.Named { name, args } => if name == \"Int\"\n      || contains(\n        [\"I8\", \"I16\", \"I32\", \"I64\", \"U8\", \"U16\", \"U32\", \"U64\"],\n        name,\n      ) {\n      smt.int_literal(smt.sx_text(x))\n    } else if name == \"Bool\" {\n      match x {\n        smt.SAtom(a) => Some(ast.BoolLit(a == \"true\")),\n        _ => None,\n      }\n    } else if name == \"String\" {\n      Some(ast.StrLit(smt.str_value(smt.sx_text(x))?))\n    } else if name == \"List\" {\n      mut out := []\n      if smt.seq_items(vc, get(args, 0)?, x, mut out) {\n        Some(ast.ListExpr(out))\n      } else {\n        None\n      }\n    } else if name == \"Tuple\" {\n      (_, xs) := smt.sx_call(x)?\n      mut out := []\n      for (i, a) in enumerate(args) {\n        mut out.push(smt.sx_literal(vc, a, get(xs, i)?)?)\n      }\n      Some(ast.TupleExpr(out))\n    } else if name == \"Task\" {\n      smt.sx_literal(vc, get(args, 0)?, x)\n    } else if name == \"Float\" || name == \"Dict\" || name == \"Set\" {\n      None\n    } else {\n      match get(vc.parents, name) {\n        Some(p) => smt.sx_literal(vc, ast.Named { name: p, args }, x),\n        None => {\n          td := get(vc.types, name)?\n          match td.body {\n            ast.Alias(a) => if td.distinct {\n              Some(ast.CtorExpr {\n                name,\n                args: ast.PositionalArgs([smt.sx_literal(\n                  vc,\n                  smt.subst(a, smt.params_of(td, args)),\n                  x,\n                )?]),\n              })\n            } else {\n              smt.sx_literal(\n                vc,\n                smt.subst(a, smt.params_of(td, args)),\n                x,\n              )\n            },\n            _ => {\n              (c, xs) := smt.sx_call(x)?\n              prefix := smt.dt_name(smt.sort_type(vc, ty)) + \".\"\n              if !starts_with(c, prefix) {\n                return None\n              }\n              cname := byte_slice(c, byte_len(prefix), byte_len(c))\n              v := get(smt.variants_of(vc, name, args)?.filter(\n                y -> y.name == cname,\n              ), 0)?\n              mut fields := []\n              for (i, ft) in enumerate(v.types) {\n                mut fields.push(smt.sx_literal(vc, ft, get(xs, i)?)?)\n              }\n              Some(ast.CtorExpr {\n                name: v.name,\n                args: smt.ctor_args(v.fields, fields),\n              })\n            },\n          }\n        },\n      }\n    },\n  }\n}"},{"name":"smt.obligation_answers","kind":"fn","old":"1b791614294304ad","new":"21a2aa673cb2b680","interface_changed":false,"affected":[],"module":"smt","text":"/// The solver's answer to each obligation of `vc`, as `verify` uses them:\n/// one process, then each unfinished obligation alone.\npub fn obligation_answers(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  vc: smt.Vc,\n) -> List[smt.Answer] {\n  n := len(vc.obligations)\n  if n == 0 {\n    return []\n  }\n  mut outs := smt.run_script(\n    mut commands,\n    mut files,\n    scratch,\n    solver,\n    smt.batch(vc),\n    [\"-t:20000\", \"rlimit=2000000\"],\n  )\n  while len(outs) < n {\n    one := smt.run_script(\n      mut commands,\n      mut files,\n      scratch,\n      solver,\n      smt.single(vc, len(outs)),\n      [\"-T:20\", \"rlimit=2000000\"],\n    )\n    mut outs.push(get(one, 0) ?? \"\")\n  }\n  mut out := []\n  for (i, ob) in enumerate(vc.obligations) {\n    a := smt.answer_of(vc, ob, smt.leaves(vc), get(outs, i) ?? \"\")\n    // a model it couldn't show: asked again with the lists' first elements\n    mut out.push(\n      if a.outcome == \"unknown\"\n        && starts_with(\n          a.message,\n          \"the solver found a possible counterexample it could not express\",\n        )\n        && vc.example_leaves != [] {\n        ls := smt.leaves(vc) + vc.example_leaves\n        again := get(smt.run_script(\n          mut commands,\n          mut files,\n          scratch,\n          solver,\n          smt.header(vc)\n            + smt.body_with(vc, ob, ls, vc.example_facts),\n          [\"-T:20\", \"rlimit=2000000\"],\n        ), 0) ?? \"\"\n        b := smt.answer_of(vc, ob, ls, again)\n        if b.outcome == \"refuted\" {\n          b\n        } else {\n          a\n        }\n      } else {\n        a\n      },\n    )\n  }\n  out\n}","old_text":"/// The solver's answer to each obligation of `vc` (one process; those it\n/// didn't finish, each alone), as `verify` uses them.\npub fn obligation_answers(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  vc: smt.Vc,\n) -> List[smt.Answer] {\n  n := len(vc.obligations)\n  if n == 0 {\n    return []\n  }\n  mut outs := smt.run_script(\n    mut commands,\n    mut files,\n    scratch,\n    solver,\n    smt.batch(vc),\n    [\"-t:20000\", \"rlimit=2000000\"],\n  )\n  while len(outs) < n {\n    one := smt.run_script(\n      mut commands,\n      mut files,\n      scratch,\n      solver,\n      smt.single(vc, len(outs)),\n      [\"-T:20\", \"rlimit=2000000\"],\n    )\n    mut outs.push(get(one, 0) ?? \"\")\n  }\n  mut out := []\n  for (i, ob) in enumerate(vc.obligations) {\n    a := smt.answer_of(vc, ob, smt.leaves(vc), get(outs, i) ?? \"\")\n    // a model it couldn't show: asked again with the lists' first elements\n    mut out.push(\n      if a.outcome == \"unknown\"\n        && starts_with(\n          a.message,\n          \"the solver found a possible counterexample it could not express\",\n        )\n        && vc.example_leaves != [] {\n        ls := smt.leaves(vc) + vc.example_leaves\n        again := get(smt.run_script(\n          mut commands,\n          mut files,\n          scratch,\n          solver,\n          smt.header(vc)\n            + smt.body_with(vc, ob, ls, vc.example_facts),\n          [\"-T:20\", \"rlimit=2000000\"],\n        ), 0) ?? \"\"\n        b := smt.answer_of(vc, ob, ls, again)\n        if b.outcome == \"refuted\" {\n          b\n        } else {\n          a\n        }\n      } else {\n        a\n      },\n    )\n  }\n  out\n}"},{"name":"smt.body_with","kind":"fn","old":"ed3c35d4a933bf9c","new":"08e0d03a1828070e","interface_changed":false,"affected":[],"module":"smt","text":"/// `body`, with `extra` facts.\nfn body_with(\n  vc: smt.Vc,\n  ob: smt.Obligation,\n  leaves: List[String],\n  extra: List[String],\n) -> String {\n  (facts, consts) := smt.cone_with(vc, ob, leaves, extra)\n  mut s := \"\"\n  for c in vc.consts {\n    if contains(consts, c.name) {\n      s += if c.args == 0 {\n        f\"(declare-const {c.name} {c.sort})\\n\"\n      } else {\n        \"(declare-fun \"\n          + c.name\n          + \" (\"\n          + join(range(0, c.args).map(_ -> \"Int\"), \" \")\n          + \") \"\n          + c.sort\n          + \")\\n\"\n      }\n    }\n  }\n  mut asserts := \"\"\n  for f in facts {\n    asserts += f\"(assert {f})\\n\"\n  }\n  for p in ob.pc {\n    asserts += f\"(assert {p})\\n\"\n  }\n  asserts += f\"(assert (not {ob.goal}))\\n\"\n  // name each string read from a datatype value: Z3's string solver gives\n  // up on a selector term where it decides a constant at once. The\n  // script's words are read once, which rules out most terms without\n  // searching the script for each.\n  mut wanted := []\n  for t in vc.str_terms {\n    wanted += smt.occurrence_keys(t)\n  }\n  in_asserts := if vc.str_terms == [] {\n    Set[String] {}\n  } else {\n    smt.keys_in(asserts, set(wanted))\n  }\n  // terms that are one parenthesized term each are found in one pass\n  // (`found_terms`), any other by itself\n  maybe := vc.str_terms.filter(\n    t -> smt.occurrence_keys(t).all(k -> contains(in_asserts, k)),\n  )\n  found := smt.found_terms(asserts, maybe.filter(t -> smt.plain_term(t)))\n  // a bare name is a constant already. Replacing it as text would change\n  // the names it starts (`v1` in `v14`).\n  mut named_strs := maybe.filter(\n    t -> if smt.plain_term(t) {\n        contains(found, t)\n      } else {\n        contains(asserts, t)\n      }\n      && !contains(t, \"@@\")\n      && contains(t, \"(\")\n      && !smt.words(t, false).any(\n        w -> contains(vc.bound, w)\n          || starts_with(w, \"q\")\n            && smt.is_digits(byte_slice(w, 1, byte_len(w))),\n      ),\n  )\n  mut named_strs.sort_by(t -> -byte_len(t))\n  // each replaced by its name, longest first. One pass suffices when each\n  // is one parenthesized term, which can then only overlap another by\n  // containing it.\n  one_pass := named_strs.all(t -> smt.plain_term(t))\n  if one_pass {\n    asserts = smt.replace_terms(\n      asserts,\n      dict(enumerate(named_strs).map(p -> (p.1, f\"str{p.0}\"))),\n    )\n  }\n  mut eqs := \"\"\n  for (i, t) in enumerate(named_strs) {\n    n := f\"str{i}\"\n    if !one_pass {\n      asserts = replace(asserts, t, n)\n    }\n    s += f\"(declare-const {n} String)\\n\"\n    eqs += f\"(assert (= {n} {t}))\\n\"\n  }\n  s += asserts + eqs\n  // no string is longer than memory: without this bound Z3 tries to build\n  // a string of 10^308 characters to refute `len(s) < 10^308`\n  for t in smt.str_len_terms(s) {\n    s += f\"(assert (< {t} 18446744073709551616))\\n\"\n  }\n  s += \"(check-sat)\\n\"\n  if len(leaves) > 0 {\n    s += \"(get-value (\" + join(leaves, \" \") + \"))\\n\"\n  }\n  s\n}","old_text":"/// `body`, with `extra` facts.\nfn body_with(\n  vc: smt.Vc,\n  ob: smt.Obligation,\n  leaves: List[String],\n  extra: List[String],\n) -> String {\n  (facts, consts) := smt.cone_with(vc, ob, leaves, extra)\n  mut s := \"\"\n  for c in vc.consts {\n    if contains(consts, c.name) {\n      s += if c.args == 0 {\n        f\"(declare-const {c.name} {c.sort})\\n\"\n      } else {\n        \"(declare-fun \"\n          + c.name\n          + \" (\"\n          + join(range(0, c.args).map(_ -> \"Int\"), \" \")\n          + \") \"\n          + c.sort\n          + \")\\n\"\n      }\n    }\n  }\n  mut asserts := \"\"\n  for f in facts {\n    asserts += f\"(assert {f})\\n\"\n  }\n  for p in ob.pc {\n    asserts += f\"(assert {p})\\n\"\n  }\n  asserts += f\"(assert (not {ob.goal}))\\n\"\n  // a string read from a datatype value, named: Z3's string solver gives\n  // up on a selector term where it decides a constant at once (the\n  // script's words read once: most terms are ruled out by them, without\n  // searching the script for each)\n  mut wanted := []\n  for t in vc.str_terms {\n    wanted += smt.occurrence_keys(t)\n  }\n  in_asserts := if vc.str_terms == [] {\n    Set[String] {}\n  } else {\n    smt.keys_in(asserts, set(wanted))\n  }\n  // (terms that are one parenthesized term each are looked for in one\n  // pass, `found_terms`; any other, by itself)\n  maybe := vc.str_terms.filter(\n    t -> smt.occurrence_keys(t).all(k -> contains(in_asserts, k)),\n  )\n  found := smt.found_terms(asserts, maybe.filter(t -> smt.plain_term(t)))\n  // (a bare name is a constant already: replacing it as text would change\n  // the names it starts, `v1` in `v14`)\n  mut named_strs := maybe.filter(\n    t -> if smt.plain_term(t) {\n        contains(found, t)\n      } else {\n        contains(asserts, t)\n      }\n      && !contains(t, \"@@\")\n      && contains(t, \"(\")\n      && !smt.words(t, false).any(\n        w -> contains(vc.bound, w)\n          || starts_with(w, \"q\")\n            && smt.is_digits(byte_slice(w, 1, byte_len(w))),\n      ),\n  )\n  mut named_strs.sort_by(t -> -byte_len(t))\n  // (each replaced by its name, the longest first: in one pass when each\n  // is one parenthesized term, which then can't overlap another but by\n  // holding it)\n  one_pass := named_strs.all(t -> smt.plain_term(t))\n  if one_pass {\n    asserts = smt.replace_terms(\n      asserts,\n      dict(enumerate(named_strs).map(p -> (p.1, f\"str{p.0}\"))),\n    )\n  }\n  mut eqs := \"\"\n  for (i, t) in enumerate(named_strs) {\n    n := f\"str{i}\"\n    if !one_pass {\n      asserts = replace(asserts, t, n)\n    }\n    s += f\"(declare-const {n} String)\\n\"\n    eqs += f\"(assert (= {n} {t}))\\n\"\n  }\n  s += asserts + eqs\n  // no string is longer than memory: without this bound Z3 tries to build\n  // a string of 10^308 characters to refute `len(s) < 10^308`\n  for t in smt.str_len_terms(s) {\n    s += f\"(assert (< {t} 18446744073709551616))\\n\"\n  }\n  s += \"(check-sat)\\n\"\n  if len(leaves) > 0 {\n    s += \"(get-value (\" + join(leaves, \" \") + \"))\\n\"\n  }\n  s\n}"},{"name":"smt.open_input","kind":"fn","old":"658f04a4e3d6ac1e","new":"f623ec9bf44ba0ae","interface_changed":false,"affected":[],"module":"smt","text":"/// Makes the parts an input is shown with: lazy parts, and each list's\n/// first elements (kept in `input_elems`), down to `input_depth` levels.\n/// Collects the lists' lengths and every leaf.\nfn open_input(\n  mut vc: smt.Vc,\n  v0: smt.Val,\n  depth: Int,\n  mut lens: List[String],\n  mut leaves: List[String],\n) {\n  if depth > vc.input_depth || len(leaves) > 400 {\n    return\n  }\n  v := smt.force(mut vc, v0)\n  match v {\n    smt.VInt(t) | smt.VBool(t) | smt.VStr(t) => mut leaves.push(t),\n    smt.VTuple(xs) => {\n      for x in xs {\n        smt.open_input(mut vc, x, depth, mut lens, mut leaves)\n      }\n    },\n    smt.VRec { fields, .. } => {\n      for (_, x) in fields {\n        smt.open_input(mut vc, x, depth, mut lens, mut leaves)\n      }\n    },\n    smt.VDistinct { inner, .. } => smt.open_input(mut vc, inner, depth, mut lens, mut leaves),\n    smt.VSum { tag, ctors, .. } => {\n      mut leaves.push(tag)\n      for c in ctors {\n        for x in c.1 {\n          smt.open_input(mut vc, x, depth + 1, mut lens, mut leaves)\n        }\n      }\n    },\n    smt.VUnion { tag, slots } => {\n      mut leaves.push(tag)\n      for (_, x) in slots {\n        smt.open_input(mut vc, x, depth, mut lens, mut leaves)\n      }\n    },\n    smt.VList { len: n, id } => {\n      mut leaves.push(n)\n      mut lens.push(n)\n      if contains(vc.input_elems, id) {\n        return\n      }\n      match smt.map_of(mut vc, v) {\n        Some((a, _, ms)) => {\n          smt.open_map(\n            mut vc,\n            id,\n            n,\n            a,\n            ms,\n            depth,\n            mut lens,\n            mut leaves,\n          )\n          return\n        },\n        None => (),\n      }\n      if !smt.positional(vc, id) {\n        return\n      }\n      mut xs := []\n      for k in 0..smt.input_len() {\n        match smt.element_at(mut vc, id, to_string(k), f\"(> {n} {k})\") {\n          Some(x) => mut xs.push(x),\n          None => (),\n        }\n      }\n      if len(xs) < smt.input_len() {\n        return\n      }\n      mut forced := []\n      for x in xs {\n        fx := smt.force(mut vc, x)\n        mut forced.push(fx)\n      }\n      mut vc.input_elems.insert(id, forced)\n      mut vc.input_lens.insert(id, n)\n      for x in forced {\n        smt.open_input(mut vc, x, depth + 1, mut lens, mut leaves)\n      }\n    },\n    _ => (),\n  }\n}","old_text":"/// Make the parts of `v` an input is shown with: lazy parts, and each\n/// list's first elements (kept in `input_elems`), down to `input_depth`\n/// levels; collect the lists' lengths and every leaf.\nfn open_input(\n  mut vc: smt.Vc,\n  v0: smt.Val,\n  depth: Int,\n  mut lens: List[String],\n  mut leaves: List[String],\n) {\n  if depth > vc.input_depth || len(leaves) > 400 {\n    return\n  }\n  v := smt.force(mut vc, v0)\n  match v {\n    smt.VInt(t) | smt.VBool(t) | smt.VStr(t) => mut leaves.push(t),\n    smt.VTuple(xs) => {\n      for x in xs {\n        smt.open_input(mut vc, x, depth, mut lens, mut leaves)\n      }\n    },\n    smt.VRec { fields, .. } => {\n      for (_, x) in fields {\n        smt.open_input(mut vc, x, depth, mut lens, mut leaves)\n      }\n    },\n    smt.VDistinct { inner, .. } => smt.open_input(mut vc, inner, depth, mut lens, mut leaves),\n    smt.VSum { tag, ctors, .. } => {\n      mut leaves.push(tag)\n      for c in ctors {\n        for x in c.1 {\n          smt.open_input(mut vc, x, depth + 1, mut lens, mut leaves)\n        }\n      }\n    },\n    smt.VUnion { tag, slots } => {\n      mut leaves.push(tag)\n      for (_, x) in slots {\n        smt.open_input(mut vc, x, depth, mut lens, mut leaves)\n      }\n    },\n    smt.VList { len: n, id } => {\n      mut leaves.push(n)\n      mut lens.push(n)\n      if contains(vc.input_elems, id) {\n        return\n      }\n      match smt.map_of(mut vc, v) {\n        Some((a, _, ms)) => {\n          smt.open_map(\n            mut vc,\n            id,\n            n,\n            a,\n            ms,\n            depth,\n            mut lens,\n            mut leaves,\n          )\n          return\n        },\n        None => (),\n      }\n      if !smt.positional(vc, id) {\n        return\n      }\n      mut xs := []\n      for k in 0..smt.input_len() {\n        match smt.element_at(mut vc, id, to_string(k), f\"(> {n} {k})\") {\n          Some(x) => mut xs.push(x),\n          None => (),\n        }\n      }\n      if len(xs) < smt.input_len() {\n        return\n      }\n      mut forced := []\n      for x in xs {\n        fx := smt.force(mut vc, x)\n        mut forced.push(fx)\n      }\n      mut vc.input_elems.insert(id, forced)\n      mut vc.input_lens.insert(id, n)\n      for x in forced {\n        smt.open_input(mut vc, x, depth + 1, mut lens, mut leaves)\n      }\n    },\n    _ => (),\n  }\n}"},{"name":"smt.static_call","kind":"fn","old":"8110298642e8f1d2","new":"522523bab9393c5f","interface_changed":false,"affected":[],"module":"smt","text":"/// A static method called on a type (`Money.empty()`). In a contract it is\n/// seen through that type's implementation when allowed (the type is a\n/// hidden argument), else through the trait's contract.\nfn static_call(\n  mut vc: smt.Vc,\n  t: String,\n  name: String,\n  args: List[ast.Expr],\n) -> smt.Val {\n  if vc.spec > 0 && vc.depth < 4 && contains(name, \"::\") {\n    match smt.static_impl(vc, name, t) {\n      Some(m) => {\n        key := name + \"@\" + t\n        match smt.impl_seen(vc, key, m) {\n          smt.SeeThrough => {\n            match get(vc.methods.assumed_impls, key) {\n              Some(label) => mut vc.relied_on.insert(label),\n              None => (),\n            }\n            mut vals := []\n            for a in args {\n              mut vals.push(smt.eval(mut vc, a))\n            }\n            binds := dict(zip(m.params.map(p -> p.name), vals))\n            vc.depth += 1\n            vc.through += 1\n            saved := vc.scopes\n            vc.scopes = [binds]\n            r := smt.eval(mut vc, m.body)\n            vc.scopes = saved\n            vc.through -= 1\n            vc.depth -= 1\n            return r\n          },\n          _ => (),\n        }\n      },\n      None => (),\n    }\n  }\n  smt.call_exprs(mut vc, name, args)\n}","old_text":"/// A static method called on a type (`Money.empty()`): in a contract, seen\n/// through that type's implementation when it may be (Rust's checker passes\n/// the type as a hidden argument); else through the trait's contract.\nfn static_call(\n  mut vc: smt.Vc,\n  t: String,\n  name: String,\n  args: List[ast.Expr],\n) -> smt.Val {\n  if vc.spec > 0 && vc.depth < 4 && contains(name, \"::\") {\n    match smt.static_impl(vc, name, t) {\n      Some(m) => {\n        key := name + \"@\" + t\n        match smt.impl_seen(vc, key, m) {\n          smt.SeeThrough => {\n            match get(vc.methods.assumed_impls, key) {\n              Some(label) => mut vc.relied_on.insert(label),\n              None => (),\n            }\n            mut vals := []\n            for a in args {\n              mut vals.push(smt.eval(mut vc, a))\n            }\n            binds := dict(zip(m.params.map(p -> p.name), vals))\n            vc.depth += 1\n            vc.through += 1\n            saved := vc.scopes\n            vc.scopes = [binds]\n            r := smt.eval(mut vc, m.body)\n            vc.scopes = saved\n            vc.through -= 1\n            vc.depth -= 1\n            return r\n          },\n          _ => (),\n        }\n      },\n      None => (),\n    }\n  }\n  smt.call_exprs(mut vc, name, args)\n}"},{"name":"smt.word_range","kind":"fn","old":"73d61a8e621d96c1","new":"628161a36d0553d0","interface_changed":false,"affected":[],"module":"smt","text":"/// What a sized integer `x` of type `w` always is: within its range.\nfn word_range(w: String, x: String) -> String {\n  (lo, hi) := smt.word_bounds(w)\n  f\"(and (<= {smt.num(lo)} {x}) (<= {x} {smt.num(hi)}))\"\n}","old_text":"/// What a sized integer `x` of type `w` always is: within its range\n/// (Rust's `word_range`).\nfn word_range(w: String, x: String) -> String {\n  (lo, hi) := smt.word_bounds(w)\n  f\"(and (<= {smt.num(lo)} {x}) (<= {x} {smt.num(hi)}))\"\n}"},{"name":"smt.wrap_term","kind":"fn","old":"ef5d4d92f647e463","new":"d2e1fd76b09bc271","interface_changed":false,"affected":[],"module":"smt","text":"/// `x` modulo 2^bits as a value of the sized type `w`, two's complement for\n/// a signed one. The result of an operation on sized integers.\nfn wrap_term(w: String, x: String) -> String {\n  (bits, signed) := smt.width_of(w) ?? (64, true)\n  m := smt.two_to(bits)\n  h := smt.two_to(bits - 1)\n  match parse_int(x) {\n    Some(n) => {\n      r := (n % m + m) % m\n      smt.num(if signed && r >= h {\n        r - m\n      } else {\n        r\n      })\n    },\n    None => if signed {\n      f\"(- (mod (+ {x} {h}) {m}) {h})\"\n    } else {\n      f\"(mod {x} {m})\"\n    },\n  }\n}","old_text":"/// `x` modulo 2^bits, as a value of the sized type `w` (two's complement\n/// for a signed one): what an operation on sized integers gives (Rust's\n/// `wrap_term`).\nfn wrap_term(w: String, x: String) -> String {\n  (bits, signed) := smt.width_of(w) ?? (64, true)\n  m := smt.two_to(bits)\n  h := smt.two_to(bits - 1)\n  match parse_int(x) {\n    Some(n) => {\n      r := (n % m + m) % m\n      smt.num(if signed && r >= h {\n        r - m\n      } else {\n        r\n      })\n    },\n    None => if signed {\n      f\"(- (mod (+ {x} {h}) {m}) {h})\"\n    } else {\n      f\"(mod {x} {m})\"\n    },\n  }\n}"},{"name":"smt.conversion","kind":"fn","old":"6514c1ee578cc100","new":"e18cd84ff9b6f9c1","interface_changed":false,"affected":[],"module":"smt","text":"/// A conversion of an `Int` to a sized type: `to_u8` (it must fit) or\n/// `wrap_u8` (modulo 2^bits). Returns the type and whether it wraps.\nfn conversion(f: String) -> Option[(String, Bool)] {\n  (wraps, rest) := if starts_with(f, \"to_\") {\n    (false, byte_slice(f, 3, byte_len(f)))\n  } else if starts_with(f, \"wrap_\") {\n    (true, byte_slice(f, 5, byte_len(f)))\n  } else {\n    return None\n  }\n  w := to_upper(rest)\n  if rest == to_lower(rest) && smt.width_of(w) != None {\n    Some((w, wraps))\n  } else {\n    None\n  }\n}","old_text":"/// A conversion of an `Int` to a sized type: `to_u8` (it must fit) or\n/// `wrap_u8` (modulo 2^bits): the type, and whether it wraps.\nfn conversion(f: String) -> Option[(String, Bool)] {\n  (wraps, rest) := if starts_with(f, \"to_\") {\n    (false, byte_slice(f, 3, byte_len(f)))\n  } else if starts_with(f, \"wrap_\") {\n    (true, byte_slice(f, 5, byte_len(f)))\n  } else {\n    return None\n  }\n  w := to_upper(rest)\n  if rest == to_lower(rest) && smt.width_of(w) != None {\n    Some((w, wraps))\n  } else {\n    None\n  }\n}"},{"name":"smt.shared_term","kind":"fn","old":"697dc4ca5798751c","new":"4429a0d78a75700f","interface_changed":false,"affected":[],"module":"smt","text":"/// The longest term `share` writes out inline.\nfn shared_term() -> Int {\n  64\n}","old_text":"/// The longest term `share` writes out where it is used.\nfn shared_term() -> Int {\n  64\n}"},{"name":"smt.share","kind":"fn","old":"cbd11743f9e979ac","new":"0dbaa1141acf6665","interface_changed":false,"affected":[],"module":"smt","text":"/// `t` itself when small, else a new unknown equal to it, so a term met\n/// again (a list's length or an element merged at each join) is written\n/// once. Without it, `xs = drop(xs, 2)` under `if`s doubles the terms at\n/// each one.\nfn share(mut vc: smt.Vc, sort: String, t: String) -> String {\n  // not inside a quantified element, where a new unknown would be one more\n  // bound variable\n  if byte_len(t) <= smt.shared_term() || vc.binding > 0 {\n    return t\n  }\n  k := smt.fresh(mut vc, sort)\n  mut vc.facts.push(f\"(= {k} {t})\")\n  k\n}","old_text":"/// `t` itself when small, else a new unknown equal to it: a term met again\n/// (a list's length or an element merged at each join) is written once.\n/// Without it, `xs = drop(xs, 2)` under `if`s doubles the terms at each one.\nfn share(mut vc: smt.Vc, sort: String, t: String) -> String {\n  // (not inside a quantified element, where a new unknown would be one\n  // more bound variable)\n  if byte_len(t) <= smt.shared_term() || vc.binding > 0 {\n    return t\n  }\n  k := smt.fresh(mut vc, sort)\n  mut vc.facts.push(f\"(= {k} {t})\")\n  k\n}"},{"name":"smt.unshift","kind":"fn","old":"abf347ffca5569cc","new":"9ec64d688e5f6e68","interface_changed":false,"affected":[],"module":"smt","text":"/// List `id` without its `drop`s: the list it drops from, position `i`'s\n/// place in it, and the dropping lists passed.\nfn unshift(vc: smt.Vc, id: Int, i: String) -> (Int, String, List[Int]) {\n  match smt.list_info(vc, id).source {\n    // a list drops from one made before it\n    smt.GShift(p, off) => if 0 <= p && p < id {\n      (r, j, passed) := smt.unshift(vc, p, f\"(+ {off} {i})\")\n      (r, j, [id] + passed)\n    } else {\n      (id, i, [])\n    },\n    _ => (id, i, []),\n  }\n}","old_text":"/// List `id` without its `drop`s: the list it drops from, position `i`'s\n/// place in it, and the dropping lists passed.\nfn unshift(vc: smt.Vc, id: Int, i: String) -> (Int, String, List[Int]) {\n  match smt.list_info(vc, id).source {\n    // (a list drops from one made before it)\n    smt.GShift(p, off) => if 0 <= p && p < id {\n      (r, j, passed) := smt.unshift(vc, p, f\"(+ {off} {i})\")\n      (r, j, [id] + passed)\n    } else {\n      (id, i, [])\n    },\n    _ => (id, i, []),\n  }\n}"},{"name":"smt.run_scripts","kind":"fn","old":"753a7ec4e6a7b0f3","new":"f89a34a597d4b6a5","interface_changed":false,"affected":[],"module":"smt","text":"/// The solver's answers to many scripts (each with its flags), in order, as\n/// `run_script` gives them. Either the running solver processes\n/// (`pooled`), or separate processes, as many at once as there are cores\n/// (`xargs -P` through `sh`), each writing its output to a file in\n/// `scratch`. The same script with the same flags runs once. What can't be\n/// run answers `[]`.\npub fn run_scripts(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  jobs: List[(String, List[String])],\n) -> List[List[String]] {\n  if len(jobs) == 0 {\n    return []\n  }\n  if len(jobs) == 1 {\n    j := get(jobs, 0) ?? (\"\", [])\n    return [smt.run_script(\n      mut commands,\n      mut files,\n      scratch,\n      solver,\n      j.0,\n      j.1,\n    )]\n  }\n  // a running solver: each distinct job once, on its processes\n  if smt.pooled(solver) {\n    mut unique := []\n    mut at := Dict[String, Int] {}\n    mut which := []\n    for (script, flags) in jobs {\n      name := join(flags, \" \") + \"\\n\" + script\n      match get(at, name) {\n        Some(k) => mut which.push(k),\n        None => {\n          mut at.insert(name, len(unique))\n          mut which.push(len(unique))\n          mut unique.push((script, flags))\n        },\n      }\n    }\n    match smt.pool_run(solver, unique) {\n      Some(outs) => {\n        mut results := []\n        for (k, (script, _)) in enumerate(jobs) {\n          out := get(outs, get(which, k) ?? 0) ?? \"\"\n          mut results.push(\n            if contains(script, \"@@answered\") {\n              smt.answers(out)\n            } else {\n              [out]\n            },\n          )\n        }\n        return results\n      },\n      None => (),\n    }\n  }\n  // each job's output file, and each distinct job's runner (a script for `sh`)\n  mut outs := []\n  mut runners := []\n  mut seen := Set[String] {}\n  for (script, flags) in jobs {\n    name := to_string(smt.text_hash(join(flags, \" \") + \"\\n\" + script))\n    out := f\"{scratch}/{name}.out\"\n    mut outs.push(out)\n    if !contains(seen, name) {\n      mut seen.insert(name)\n      path := f\"{scratch}/{smt.text_hash(script)}.smt2\"\n      runner := f\"{scratch}/{name}.sh\"\n      line := smt.shell_quoted(solver)\n        + \" \"\n        + join(\n          smt.solver_args(solver, flags).map(\n            x -> smt.shell_quoted(x),\n          ),\n          \" \",\n        )\n        + \" < \"\n        + smt.shell_quoted(path)\n        + \" > \"\n        + smt.shell_quoted(out)\n        + \".$$\"\n        + \" 2>/dev/null; mv -f \"\n        + smt.shell_quoted(out)\n        + \".$$\"\n        + \" \"\n        + smt.shell_quoted(out)\n        + \"\\n\"\n      match mut files.remove(out) {\n        _ => (),\n      }\n      match mut files.write(path, script) {\n        Ok(_) => match mut files.write(runner, line) {\n          Ok(_) => mut runners.push(runner),\n          Err(_) => (),\n        },\n        Err(_) => (),\n      }\n    }\n  }\n  // one `sh` per runner, `-P` of them at a time\n  all := \"n=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4); printf '%s\\0' \\\"$@\\\" | xargs -0 -n 1 -P \\\"$n\\\" sh\"\n  timings.begin(\"solver\")\n  match mut commands.run(\"/bin/sh\", [\"-c\", all, \"sh\"] + runners, \"\") {\n    _ => (),\n  }\n  timings.end(\"solver\")\n  mut results := []\n  for (k, (script, _)) in enumerate(jobs) {\n    out := get(outs, k) ?? \"\"\n    mut results.push(\n      match files.read(out) {\n        Ok(text) => if contains(script, \"@@answered\") {\n          smt.answers(text)\n        } else {\n          [text]\n        },\n        Err(_) => [],\n      },\n    )\n  }\n  for r in runners {\n    match mut files.remove(r) {\n      _ => (),\n    }\n  }\n  for out in set(outs) {\n    match mut files.remove(out) {\n      _ => (),\n    }\n  }\n  results\n}","old_text":"/// The solver's answers to many scripts (each with its flags), each as\n/// `run_script` gives them, in order: separate solver processes run at the\n/// same time, as many at once as there are cores (`xargs -P`, through `sh`),\n/// each writing its output to a file of `scratch`; or the processes kept\n/// running (`pooled`). The same script with the same flags is run once.\n/// What can't be run answers `[]`.\npub fn run_scripts(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  jobs: List[(String, List[String])],\n) -> List[List[String]] {\n  if len(jobs) == 0 {\n    return []\n  }\n  if len(jobs) == 1 {\n    j := get(jobs, 0) ?? (\"\", [])\n    return [smt.run_script(\n      mut commands,\n      mut files,\n      scratch,\n      solver,\n      j.0,\n      j.1,\n    )]\n  }\n  // a solver kept running: each different job once, on its processes\n  if smt.pooled(solver) {\n    mut unique := []\n    mut at := Dict[String, Int] {}\n    mut which := []\n    for (script, flags) in jobs {\n      name := join(flags, \" \") + \"\\n\" + script\n      match get(at, name) {\n        Some(k) => mut which.push(k),\n        None => {\n          mut at.insert(name, len(unique))\n          mut which.push(len(unique))\n          mut unique.push((script, flags))\n        },\n      }\n    }\n    match smt.pool_run(solver, unique) {\n      Some(outs) => {\n        mut results := []\n        for (k, (script, _)) in enumerate(jobs) {\n          out := get(outs, get(which, k) ?? 0) ?? \"\"\n          mut results.push(\n            if contains(script, \"@@answered\") {\n              smt.answers(out)\n            } else {\n              [out]\n            },\n          )\n        }\n        return results\n      },\n      None => (),\n    }\n  }\n  // each job's output file; each different job's runner (a script for `sh`)\n  mut outs := []\n  mut runners := []\n  mut seen := Set[String] {}\n  for (script, flags) in jobs {\n    name := to_string(smt.text_hash(join(flags, \" \") + \"\\n\" + script))\n    out := f\"{scratch}/{name}.out\"\n    mut outs.push(out)\n    if !contains(seen, name) {\n      mut seen.insert(name)\n      path := f\"{scratch}/{smt.text_hash(script)}.smt2\"\n      runner := f\"{scratch}/{name}.sh\"\n      line := smt.shell_quoted(solver)\n        + \" \"\n        + join(\n          smt.solver_args(solver, flags).map(\n            x -> smt.shell_quoted(x),\n          ),\n          \" \",\n        )\n        + \" < \"\n        + smt.shell_quoted(path)\n        + \" > \"\n        + smt.shell_quoted(out)\n        + \".$$\"\n        + \" 2>/dev/null; mv -f \"\n        + smt.shell_quoted(out)\n        + \".$$\"\n        + \" \"\n        + smt.shell_quoted(out)\n        + \"\\n\"\n      match mut files.remove(out) {\n        _ => (),\n      }\n      match mut files.write(path, script) {\n        Ok(_) => match mut files.write(runner, line) {\n          Ok(_) => mut runners.push(runner),\n          Err(_) => (),\n        },\n        Err(_) => (),\n      }\n    }\n  }\n  // (one `sh` per runner, `-P` of them at a time)\n  all := \"n=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4); printf '%s\\0' \\\"$@\\\" | xargs -0 -n 1 -P \\\"$n\\\" sh\"\n  timings.begin(\"solver\")\n  match mut commands.run(\"/bin/sh\", [\"-c\", all, \"sh\"] + runners, \"\") {\n    _ => (),\n  }\n  timings.end(\"solver\")\n  mut results := []\n  for (k, (script, _)) in enumerate(jobs) {\n    out := get(outs, k) ?? \"\"\n    mut results.push(\n      match files.read(out) {\n        Ok(text) => if contains(script, \"@@answered\") {\n          smt.answers(text)\n        } else {\n          [text]\n        },\n        Err(_) => [],\n      },\n    )\n  }\n  for r in runners {\n    match mut files.remove(r) {\n      _ => (),\n    }\n  }\n  for out in set(outs) {\n    match mut files.remove(out) {\n      _ => (),\n    }\n  }\n  results\n}"},{"name":"smt.shell_quoted","kind":"fn","old":"00c458d33c23b20a","new":"a33cda3e696dcea3","interface_changed":false,"affected":[],"module":"smt","text":"/// `s` single-quoted as one word for `sh`.\nfn shell_quoted(s: String) -> String {\n  \"'\" + replace(s, \"'\", \"'\\''\") + \"'\"\n}","old_text":"/// `s` as one word for `sh`: in single quotes.\nfn shell_quoted(s: String) -> String {\n  \"'\" + replace(s, \"'\", \"'\\''\") + \"'\"\n}"},{"name":"smt.encode_all","kind":"fn","old":"b1905ed8f6c706ad","new":"1f3b93a850462541","interface_changed":false,"affected":[],"module":"smt","text":"/// `encode` of each of `fs` (each with its label), in order. With a running\n/// solver, each function is encoded again as soon as its questions are\n/// answered (`encode_answered`). Otherwise the questions they all ask in a\n/// round are asked together (`encode_rounds`). Both give the same\n/// encodings as one by one, since an answer doesn't depend on who asks or\n/// when.\npub fn encode_all(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  sigs: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  fs: List[(ast.FnDecl, String)],\n) -> List[smt.Vc] {\n  if len(fs) > 1 && smt.pooled(solver) {\n    match smt.encode_answered(\n      solver,\n      fns,\n      types,\n      sigs,\n      methods,\n      fs,\n      false,\n    ) {\n      Some(vcs) => return vcs,\n      None => (),\n    }\n  }\n  smt.encode_rounds(\n    mut commands,\n    mut files,\n    scratch,\n    solver,\n    fns,\n    types,\n    sigs,\n    methods,\n    fs,\n  )\n}","old_text":"/// `encode` of each of `fs` (each with its label), in order: with a solver\n/// kept running, each function encoded again as soon as the questions it\n/// asked are answered (`encode_answered`); else the questions they all ask\n/// in a round asked together (`encode_rounds`). The same encodings as one\n/// by one (a question's answer doesn't depend on who asks it, nor when).\npub fn encode_all(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  sigs: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  fs: List[(ast.FnDecl, String)],\n) -> List[smt.Vc] {\n  if len(fs) > 1 && smt.pooled(solver) {\n    match smt.encode_answered(\n      solver,\n      fns,\n      types,\n      sigs,\n      methods,\n      fs,\n      false,\n    ) {\n      Some(vcs) => return vcs,\n      None => (),\n    }\n  }\n  smt.encode_rounds(\n    mut commands,\n    mut files,\n    scratch,\n    solver,\n    fns,\n    types,\n    sigs,\n    methods,\n    fs,\n  )\n}"},{"name":"smt.answers_all","kind":"fn","old":"2b4a4b1e2acfb4a7","new":"003d4f5f89c34610","interface_changed":false,"affected":[],"module":"smt","text":"/// `obligation_answers` of each of `vcs`, in order, with all solver runs\n/// made together (`run_scripts`): the batches, then each obligation a batch\n/// didn't finish alone, then those asked again with the lists' first\n/// elements.\npub fn answers_all(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  vcs: List[smt.Vc],\n) -> List[List[smt.Answer]] {\n  batches := smt.run_scripts(mut commands, mut files, scratch, solver, vcs\n    .filter(vc -> len(vc.obligations) > 0)\n    .map(vc -> (smt.batch(vc), [\"-t:20000\", \"rlimit=2000000\"])))\n  // each one's outputs by obligation: the batch's, then the singles'\n  mut outs_of := []\n  mut singles := []\n  mut k := 0\n  for vc in vcs {\n    n := len(vc.obligations)\n    got := if n > 0 {\n      k += 1\n      get(batches, k - 1) ?? []\n    } else {\n      []\n    }\n    mut outs_of.push(got)\n    for i in len(got)..n {\n      mut singles.push((smt.single(vc, i), [\"-T:20\", \"rlimit=2000000\"]))\n    }\n  }\n  single_outs := smt.run_scripts(mut commands, mut files, scratch, solver, singles)\n  mut s := 0\n  mut firsts := []\n  mut agains := []\n  mut out := []\n  for (v, vc) in enumerate(vcs) {\n    mut outs := get(outs_of, v) ?? []\n    while len(outs) < len(vc.obligations) {\n      mut outs.push(get(get(single_outs, s) ?? [], 0) ?? \"\")\n      s += 1\n    }\n    mut answers := []\n    for (i, ob) in enumerate(vc.obligations) {\n      a := smt.answer_of(vc, ob, smt.leaves(vc), get(outs, i) ?? \"\")\n      mut answers.push((ob, a))\n      if a.outcome == \"unknown\"\n        && starts_with(\n          a.message,\n          \"the solver found a possible counterexample it could not express\",\n        )\n        && vc.example_leaves != [] {\n        ls := smt.leaves(vc) + vc.example_leaves\n        mut firsts.push((v, i))\n        mut agains.push(\n          (\n            smt.header(vc)\n              + smt.body_with(vc, ob, ls, vc.example_facts),\n            [\"-T:20\", \"rlimit=2000000\"],\n          ),\n        )\n      }\n    }\n    mut out.push(answers)\n  }\n  again_outs := smt.run_scripts(mut commands, mut files, scratch, solver, agains)\n  mut final := []\n  for (v, vc) in enumerate(vcs) {\n    mut done := []\n    for (i, (ob, a)) in enumerate(get(out, v) ?? []) {\n      mut b := a\n      for (j, at) in enumerate(firsts) {\n        if at == (v, i) {\n          c := smt.answer_of(\n            vc,\n            ob,\n            smt.leaves(vc) + vc.example_leaves,\n            get(get(again_outs, j) ?? [], 0) ?? \"\",\n          )\n          if c.outcome == \"refuted\" {\n            b = c\n          }\n        }\n      }\n      mut done.push(b)\n    }\n    mut final.push(done)\n  }\n  final\n}","old_text":"/// `obligation_answers` of each of `vcs`, in order, the solver's runs of\n/// all of them made together (`run_scripts`): the batches, then the\n/// obligations a batch didn't finish, each alone, then those asked again\n/// with the lists' first elements.\npub fn answers_all(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  vcs: List[smt.Vc],\n) -> List[List[smt.Answer]] {\n  batches := smt.run_scripts(mut commands, mut files, scratch, solver, vcs\n    .filter(vc -> len(vc.obligations) > 0)\n    .map(vc -> (smt.batch(vc), [\"-t:20000\", \"rlimit=2000000\"])))\n  // each one's outputs, by obligation: the batch's, then the singles'\n  mut outs_of := []\n  mut singles := []\n  mut k := 0\n  for vc in vcs {\n    n := len(vc.obligations)\n    got := if n > 0 {\n      k += 1\n      get(batches, k - 1) ?? []\n    } else {\n      []\n    }\n    mut outs_of.push(got)\n    for i in len(got)..n {\n      mut singles.push((smt.single(vc, i), [\"-T:20\", \"rlimit=2000000\"]))\n    }\n  }\n  single_outs := smt.run_scripts(mut commands, mut files, scratch, solver, singles)\n  mut s := 0\n  mut firsts := []\n  mut agains := []\n  mut out := []\n  for (v, vc) in enumerate(vcs) {\n    mut outs := get(outs_of, v) ?? []\n    while len(outs) < len(vc.obligations) {\n      mut outs.push(get(get(single_outs, s) ?? [], 0) ?? \"\")\n      s += 1\n    }\n    mut answers := []\n    for (i, ob) in enumerate(vc.obligations) {\n      a := smt.answer_of(vc, ob, smt.leaves(vc), get(outs, i) ?? \"\")\n      mut answers.push((ob, a))\n      if a.outcome == \"unknown\"\n        && starts_with(\n          a.message,\n          \"the solver found a possible counterexample it could not express\",\n        )\n        && vc.example_leaves != [] {\n        ls := smt.leaves(vc) + vc.example_leaves\n        mut firsts.push((v, i))\n        mut agains.push(\n          (\n            smt.header(vc)\n              + smt.body_with(vc, ob, ls, vc.example_facts),\n            [\"-T:20\", \"rlimit=2000000\"],\n          ),\n        )\n      }\n    }\n    mut out.push(answers)\n  }\n  again_outs := smt.run_scripts(mut commands, mut files, scratch, solver, agains)\n  mut final := []\n  for (v, vc) in enumerate(vcs) {\n    mut done := []\n    for (i, (ob, a)) in enumerate(get(out, v) ?? []) {\n      mut b := a\n      for (j, at) in enumerate(firsts) {\n        if at == (v, i) {\n          c := smt.answer_of(\n            vc,\n            ob,\n            smt.leaves(vc) + vc.example_leaves,\n            get(get(again_outs, j) ?? [], 0) ?? \"\",\n          )\n          if c.outcome == \"refuted\" {\n            b = c\n          }\n        }\n      }\n      mut done.push(b)\n    }\n    mut final.push(done)\n  }\n  final\n}"},{"name":"smt.inputs","kind":"fn","old":"46f483daaae9aef6","new":"3dba0604ed753d19","interface_changed":false,"affected":[],"module":"smt","text":"/// Up to `n` values of `f`'s parameters meeting their types and its\n/// `requires`, made by the solver, each different from the ones before.\n/// Lists have at most `input_len()` elements. For refinements random\n/// values rarely meet (`all(1..len(it), i -> it[i - 1] <= it[i])`, a\n/// record whose fields depend on each other).\npub fn inputs(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  sigs: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  f: ast.FnDecl,\n  n: Int,\n  seed: Int,\n) -> List[List[ast.Expr]] {\n  mut vc := smt.new_vc(fns, types, sigs, methods)\n  vc.self_name = f.name\n  for p in f.params {\n    v := smt.havoc(mut vc, p.ty)\n    mut vc.params.push((p.name, v))\n    smt.bind(mut vc, p.name, v)\n  }\n  binds := vc.params\n  for r in f.pre {\n    c := smt.pred(mut vc, r, binds)\n    mut vc.pc.push(c)\n  }\n  // every part a value is shown with: its lazy parts, and its lists' first\n  // elements\n  mut lens := []\n  mut found_leaves := []\n  for (_, v) in vc.params {\n    smt.open_input(mut vc, v, 0, mut lens, mut found_leaves)\n  }\n  if len(vc.gaps) > 0 || len(vc.pending) > 0 {\n    return []\n  }\n  mut ls := []\n  for t in found_leaves {\n    if !contains(ls, t) {\n      mut ls.push(t)\n    }\n  }\n  ob := smt.Obligation {\n    what: \"inputs\",\n    goal: \"false\",\n    pc: vc.pc,\n    facts: len(vc.facts),\n  }\n  script := smt.header(vc) + smt.body_with(vc, ob, ls, [])\n  head := match index_of(script, \"(check-sat)\") {\n    Some(h) => h,\n    None => return [],\n  }\n  mut defs := \"\"\n  for l in lens {\n    defs += f\"(assert (<= {l} {smt.input_len()}))\\n\"\n  }\n  mut found := []\n  mut blocked := \"\"\n  for k in 0..n {\n    s := (seed + k) % 1000000\n    q := f\"(set-option :smt.random_seed {s})\\n(set-option :sat.random_seed {s})\\n\"\n      + byte_slice(script, 0, head)\n      + defs\n      + blocked\n      + \"(check-sat)\\n(get-value (\"\n      + join(ls, \" \")\n      + \"))\\n\"\n    out := get(smt.run_script(\n      mut commands,\n      mut files,\n      scratch,\n      solver,\n      q,\n      [\"-T:20\", \"rlimit=20000000\"],\n    ), 0) ?? \"\"\n    out_lines := lines(out)\n    if trim(get(out_lines, 0) ?? \"\") != \"sat\" {\n      break\n    }\n    m := smt.model_values(join(drop(out_lines, 1), \"\\n\"), ls)\n    // the next model differs from this one (a value of an uninterpreted\n    // sort can't be written)\n    mut same := []\n    for t in ls {\n      match get(m, t) {\n        Some(v) => {\n          vt := smt.sx_text(v)\n          if !contains(vt, \"!val!\") {\n            mut same.push(f\"(= {t} {vt})\")\n          }\n        },\n        None => (),\n      }\n    }\n    if same == [] {\n      break\n    }\n    blocked += \"(assert (not (and \" + join(same, \" \") + \")))\\n\"\n    match smt.all_some(vc.params.map(p -> smt.literal_of(vc, p.1, m))) {\n      Some(args) => mut found.push(args),\n      None => (),\n    }\n  }\n  found\n}","old_text":"/// Values of `f`'s parameters that meet their types and its `requires`,\n/// made by the solver (Rust's `Vc::inputs`): up to `n` of them, each\n/// different from the ones before. Lists have at most `input_len()`\n/// elements. For the refinements random values rarely meet\n/// (`all(1..len(it), i -> it[i - 1] <= it[i])`, a record whose fields\n/// depend on each other).\npub fn inputs(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  sigs: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  f: ast.FnDecl,\n  n: Int,\n  seed: Int,\n) -> List[List[ast.Expr]] {\n  mut vc := smt.new_vc(fns, types, sigs, methods)\n  vc.self_name = f.name\n  for p in f.params {\n    v := smt.havoc(mut vc, p.ty)\n    mut vc.params.push((p.name, v))\n    smt.bind(mut vc, p.name, v)\n  }\n  binds := vc.params\n  for r in f.pre {\n    c := smt.pred(mut vc, r, binds)\n    mut vc.pc.push(c)\n  }\n  // every part a value is shown with: its lazy parts, its lists' first\n  // elements\n  mut lens := []\n  mut found_leaves := []\n  for (_, v) in vc.params {\n    smt.open_input(mut vc, v, 0, mut lens, mut found_leaves)\n  }\n  if len(vc.gaps) > 0 || len(vc.pending) > 0 {\n    return []\n  }\n  mut ls := []\n  for t in found_leaves {\n    if !contains(ls, t) {\n      mut ls.push(t)\n    }\n  }\n  ob := smt.Obligation {\n    what: \"inputs\",\n    goal: \"false\",\n    pc: vc.pc,\n    facts: len(vc.facts),\n  }\n  script := smt.header(vc) + smt.body_with(vc, ob, ls, [])\n  head := match index_of(script, \"(check-sat)\") {\n    Some(h) => h,\n    None => return [],\n  }\n  mut defs := \"\"\n  for l in lens {\n    defs += f\"(assert (<= {l} {smt.input_len()}))\\n\"\n  }\n  mut found := []\n  mut blocked := \"\"\n  for k in 0..n {\n    s := (seed + k) % 1000000\n    q := f\"(set-option :smt.random_seed {s})\\n(set-option :sat.random_seed {s})\\n\"\n      + byte_slice(script, 0, head)\n      + defs\n      + blocked\n      + \"(check-sat)\\n(get-value (\"\n      + join(ls, \" \")\n      + \"))\\n\"\n    out := get(smt.run_script(\n      mut commands,\n      mut files,\n      scratch,\n      solver,\n      q,\n      [\"-T:20\", \"rlimit=20000000\"],\n    ), 0) ?? \"\"\n    out_lines := lines(out)\n    if trim(get(out_lines, 0) ?? \"\") != \"sat\" {\n      break\n    }\n    m := smt.model_values(join(drop(out_lines, 1), \"\\n\"), ls)\n    // the next model differs from this one (a value of a sort nothing is\n    // known of can't be written)\n    mut same := []\n    for t in ls {\n      match get(m, t) {\n        Some(v) => {\n          vt := smt.sx_text(v)\n          if !contains(vt, \"!val!\") {\n            mut same.push(f\"(= {t} {vt})\")\n          }\n        },\n        None => (),\n      }\n    }\n    if same == [] {\n      break\n    }\n    blocked += \"(assert (not (and \" + join(same, \" \") + \")))\\n\"\n    match smt.all_some(vc.params.map(p -> smt.literal_of(vc, p.1, m))) {\n      Some(args) => mut found.push(args),\n      None => (),\n    }\n  }\n  found\n}"},{"name":"smt.query_text","kind":"fn","old":"e263e3fcbee0176d","new":"54edab7f9b6afcca","interface_changed":false,"affected":[],"module":"smt","text":"/// The query of obligation `i` as `--queries` shows it, without asking for\n/// the parameters' values.\npub fn query_text(vc: smt.Vc, i: Int) -> String {\n  match get(vc.obligations, i) {\n    Some(ob) => smt.header(vc) + smt.body(vc, ob, []),\n    None => \"\",\n  }\n}","old_text":"/// The query of obligation `i` as `--queries` shows it (Rust's `smtlib`):\n/// without asking for the parameters' values.\npub fn query_text(vc: smt.Vc, i: Int) -> String {\n  match get(vc.obligations, i) {\n    Some(ob) => smt.header(vc) + smt.body(vc, ob, []),\n    None => \"\",\n  }\n}"},{"name":"smt.term_query_text","kind":"fn","old":"6e811bb427597a07","new":"217265984b1d9889","interface_changed":false,"affected":[],"module":"smt","text":"/// The query of termination obligation `i` (`Vc.term_obs`) as `--queries`\n/// shows it, without asking for the parameters' values.\npub fn term_query_text(vc: smt.Vc, i: Int) -> String {\n  match get(vc.term_obs, i) {\n    Some(ob) => smt.header(vc) + smt.body(vc, ob, []),\n    None => \"\",\n  }\n}","old_text":"/// The query of termination obligation `i` (`Vc.term_obs`) as `--queries`\n/// shows it: without asking for the parameters' values.\npub fn term_query_text(vc: smt.Vc, i: Int) -> String {\n  match get(vc.term_obs, i) {\n    Some(ob) => smt.header(vc) + smt.body(vc, ob, []),\n    None => \"\",\n  }\n}"},{"name":"smt.word_spans","kind":"fn","old":"b7d56eda21d3c192","new":"d6878b3a7619c132","interface_changed":false,"affected":[],"module":"smt","text":"/// The start and end of each word of `s`, as `words` finds them without\n/// dots.\nfn word_spans(s: String) -> List[(Int, Int)] {\n  mut out := []\n  mut start := 0\n  n := byte_len(s)\n  mut k := 0\n  while k < n {\n    b := byte_at(s, k)\n    word := b >= 128\n      || b >= 48 && b <= 57\n      || b >= 65 && b <= 90\n      || b >= 97 && b <= 122\n      || b == 95\n    if !word {\n      if k > start {\n        mut out.push((start, k))\n      }\n      start = k + 1\n    }\n    k += 1\n  }\n  if n > start {\n    mut out.push((start, n))\n  }\n  out\n}","old_text":"/// Where each word of `s` (as `words` finds them, without dots) starts\n/// and ends.\nfn word_spans(s: String) -> List[(Int, Int)] {\n  mut out := []\n  mut start := 0\n  n := byte_len(s)\n  mut k := 0\n  while k < n {\n    b := byte_at(s, k)\n    word := b >= 128\n      || b >= 48 && b <= 57\n      || b >= 65 && b <= 90\n      || b >= 97 && b <= 122\n      || b == 95\n    if !word {\n      if k > start {\n        mut out.push((start, k))\n      }\n      start = k + 1\n    }\n    k += 1\n  }\n  if n > start {\n    mut out.push((start, n))\n  }\n  out\n}"},{"name":"smt.occurrence_keys","kind":"fn","old":"013045ba380d3fef","new":"05bbef77075e0a04","interface_changed":false,"affected":[],"module":"smt","text":"/// What any text containing `t` contains wherever `t` occurs: each word of\n/// `t` bounded on both sides (within `t`) by a non-word byte is a whole\n/// word of the text there, and two such words in a row are two words in a\n/// row of the text (`x (f`, with what is between them).\nfn occurrence_keys(t: String) -> List[String] {\n  n := byte_len(t)\n  spans := smt.word_spans(t)\n  mut out := []\n  for (i, w) in enumerate(spans) {\n    if w.0 > 0 && w.1 < n {\n      mut out.push(byte_slice(t, w.0, w.1))\n      match get(spans, i + 1) {\n        Some(next) => if next.1 < n {\n          mut out.push(byte_slice(t, w.0, next.1))\n        },\n        None => (),\n      }\n    }\n  }\n  out\n}","old_text":"/// What a text holding `t` holds wherever `t` is in it: each word of `t`\n/// with a byte that isn't a word's on both sides (within `t`) is a whole\n/// word of the text there, and two such words in a row are two words in a\n/// row of the text (`x (f`, with what is between them).\nfn occurrence_keys(t: String) -> List[String] {\n  n := byte_len(t)\n  spans := smt.word_spans(t)\n  mut out := []\n  for (i, w) in enumerate(spans) {\n    if w.0 > 0 && w.1 < n {\n      mut out.push(byte_slice(t, w.0, w.1))\n      match get(spans, i + 1) {\n        Some(next) => if next.1 < n {\n          mut out.push(byte_slice(t, w.0, next.1))\n        },\n        None => (),\n      }\n    }\n  }\n  out\n}"},{"name":"smt.keys_in","kind":"fn","old":"320770fc69b08383","new":"8c20c9eae902d3f9","interface_changed":false,"affected":[],"module":"smt","text":"/// Which of `wanted` (`occurrence_keys`) the text `s` contains as a word or\n/// two words in a row. `s` is read once, so terms it can't contain are\n/// ruled out without searching it for each.\nfn keys_in(s: String, wanted: Set[String]) -> Set[String] {\n  spans := smt.word_spans(s)\n  mut found := []\n  for (i, w) in enumerate(spans) {\n    word := byte_slice(s, w.0, w.1)\n    if contains(wanted, word) {\n      mut found.push(word)\n      match get(spans, i + 1) {\n        Some(next) => {\n          pair := byte_slice(s, w.0, next.1)\n          if contains(wanted, pair) {\n            mut found.push(pair)\n          }\n        },\n        None => (),\n      }\n    }\n  }\n  set(found)\n}","old_text":"/// Which of `wanted` (`occurrence_keys`) the text `s` holds as a word or\n/// two words in a row: read once, so terms it can't hold are ruled out\n/// without searching it for each.\nfn keys_in(s: String, wanted: Set[String]) -> Set[String] {\n  spans := smt.word_spans(s)\n  mut found := []\n  for (i, w) in enumerate(spans) {\n    word := byte_slice(s, w.0, w.1)\n    if contains(wanted, word) {\n      mut found.push(word)\n      match get(spans, i + 1) {\n        Some(next) => {\n          pair := byte_slice(s, w.0, next.1)\n          if contains(wanted, pair) {\n            mut found.push(pair)\n          }\n        },\n        None => (),\n      }\n    }\n  }\n  set(found)\n}"},{"name":"smt.solver_args","kind":"fn","old":"7e42f4154361746a","new":"86585eb9bfa1a26f","interface_changed":false,"affected":[],"module":"smt","text":"/// The solver's command line for `flags`, reading the script from standard\n/// input. For Z3 (`-in` first): `-t:MS` a time limit per query of a batch,\n/// `-T:S` for the whole run, `rlimit=N`. For cvc5 (when the solver's file\n/// is named for it): `--lang smt2`, its resource and time limits per\n/// query, and `--incremental` for a batch.\npub fn solver_args(solver: String, flags: List[String]) -> List[String] {\n  parts := split(solver, \"/\")\n  if !contains(get(parts, len(parts) - 1) ?? solver, \"cvc5\") {\n    return [\"-in\"] + flags\n  }\n  base := [\n    \"--lang\",\n    \"smt2\",\n    \"--produce-models\",\n    \"--dt-nested-rec\",\n    \"--rlimit-per=5000000\",\n    \"--tlimit-per=20000\",\n  ]\n  if flags.any(f -> starts_with(f, \"-t:\")) {\n    base + [\"--incremental\"]\n  } else {\n    base\n  }\n}","old_text":"/// The solver's command line for `flags` (Z3's: `-t:MS` a time limit per\n/// query of a batch, `-T:S` for the whole run, `rlimit=N`), reading the\n/// script from standard input: Z3's own (`-in` first), or cvc5's\n/// (`--lang smt2`, its resource and time limits per query, `--incremental`\n/// for a batch) when the solver's file is named for cvc5.\npub fn solver_args(solver: String, flags: List[String]) -> List[String] {\n  parts := split(solver, \"/\")\n  if !contains(get(parts, len(parts) - 1) ?? solver, \"cvc5\") {\n    return [\"-in\"] + flags\n  }\n  base := [\n    \"--lang\",\n    \"smt2\",\n    \"--produce-models\",\n    \"--dt-nested-rec\",\n    \"--rlimit-per=5000000\",\n    \"--tlimit-per=20000\",\n  ]\n  if flags.any(f -> starts_with(f, \"-t:\")) {\n    base + [\"--incremental\"]\n  } else {\n    base\n  }\n}"},{"name":"smt.own_method_of","kind":"fn","old":"d66fcb118ce1866b","new":"60259773a8217d5d","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether `recv` (a variable or a field of one) is of a type with its own\n/// method `m` (`impl Counter { fn bump(mut self) }`).\nfn own_method_of(vc: smt.Vc, recv: ast.Expr, m: String) -> Bool {\n  if !(recv is ast.Var || recv is ast.FieldOf) {\n    return false\n  }\n  ty := match recv {\n    ast.Var(n) => match smt.lookup(vc, n) {\n      Some(v) => smt.head_of(vc, v) ?? \"\",\n      None => \"\",\n    },\n    _ => \"\",\n  }\n  last := (q: String) -> get(split(q, \".\"), len(split(q, \".\")) - 1) ?? q\n  ty != \"\"\n    && vc.methods.own_types.any(t -> t.1 == m && last(t.0) == last(ty))\n}","old_text":"/// Whether `recv` (a variable or a field of one) is of a type with a method\n/// `m` of its own (`impl Counter { fn bump(mut self) }`).\nfn own_method_of(vc: smt.Vc, recv: ast.Expr, m: String) -> Bool {\n  if !(recv is ast.Var || recv is ast.FieldOf) {\n    return false\n  }\n  ty := match recv {\n    ast.Var(n) => match smt.lookup(vc, n) {\n      Some(v) => smt.head_of(vc, v) ?? \"\",\n      None => \"\",\n    },\n    _ => \"\",\n  }\n  last := (q: String) -> get(split(q, \".\"), len(split(q, \".\")) - 1) ?? q\n  ty != \"\"\n    && vc.methods.own_types.any(t -> t.1 == m && last(t.0) == last(ty))\n}"},{"name":"smt.last_name","kind":"fn","old":"dc3f4e9bb19ffa6d","new":"6788fc2b5847262f","interface_changed":false,"affected":[],"module":"smt","text":"/// The last part of a dotted name: `get` for `std.http.get`.\nfn last_name(n: String) -> String {\n  parts := split(n, \".\")\n  get(parts, len(parts) - 1) ?? n\n}","old_text":"/// The last part of a dotted name (`get` of `std.http.get`).\nfn last_name(n: String) -> String {\n  parts := split(n, \".\")\n  get(parts, len(parts) - 1) ?? n\n}"},{"name":"smt.self_written","kind":"fn","old":"fb090e185903fb7a","new":"8f48e6d4c74adac6","interface_changed":false,"affected":[],"module":"smt","text":"/// `t` with `Self` replaced by `for_type`.\nfn self_written(t: ast.TypeExpr, for_type: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Named { name: \"Self\", args: [] } => for_type,\n    ast.Named { name, args } => ast.Named {\n      name,\n      args: args.map(a -> smt.self_written(a, for_type)),\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> smt.self_written(a, for_type)),\n      ret: smt.self_written(ret, for_type),\n    },\n    ast.Refined { base, pred } => ast.Refined { base: smt.self_written(base, for_type), pred },\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> smt.self_written(a, for_type))),\n    ast.UnitType => ast.UnitType,\n  }\n}","old_text":"/// `t` with `Self` the type `for_type`.\nfn self_written(t: ast.TypeExpr, for_type: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Named { name: \"Self\", args: [] } => for_type,\n    ast.Named { name, args } => ast.Named {\n      name,\n      args: args.map(a -> smt.self_written(a, for_type)),\n    },\n    ast.FnType { params, ret } => ast.FnType {\n      params: params.map(a -> smt.self_written(a, for_type)),\n      ret: smt.self_written(ret, for_type),\n    },\n    ast.Refined { base, pred } => ast.Refined { base: smt.self_written(base, for_type), pred },\n    ast.UnionType(ms) => ast.UnionType(ms.map(a -> smt.self_written(a, for_type))),\n    ast.UnitType => ast.UnitType,\n  }\n}"},{"name":"smt.solver_pool_usable","kind":"extern","old":"dede0f3dd234e887","new":"20d4f3770d6deec0","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether `solver` is kept running between scripts (c/solver.c): Z3,\n/// unless STRATA_SOLVER_POOL=0.\nextern c fn solver_pool_usable(solver: String) -> I32","old_text":"/// Whether `solver` is kept running between scripts (c/solver.c): Z3, unless\n/// STRATA_SOLVER_POOL=0.\nextern c fn solver_pool_usable(solver: String) -> I32"},{"name":"smt.solver_pool_run","kind":"extern","old":"4b1980d3ff69fcfc","new":"8ddf5734e7f291a9","interface_changed":false,"affected":[],"module":"smt","text":"/// The answers to scripts given as `FLAGS 0x1f SCRIPT` separated by 0x1e,\n/// in order and separated by 0x1e, from running processes, one per core\n/// (c/solver.c).\nextern c fn solver_pool_run(solver: String, jobs: String) -> String","old_text":"/// The answers to scripts, each `FLAGS 0x1f SCRIPT`, separated by 0x1e: in\n/// order, separated by 0x1e, from processes kept running, one per core\n/// (c/solver.c).\nextern c fn solver_pool_run(solver: String, jobs: String) -> String"},{"name":"smt.pool_run","kind":"fn","old":"67830e33343eccf3","new":"7d382e04004e65d7","interface_changed":false,"affected":[],"module":"smt","text":"/// Each script's output (with its flags), in order, from the running\n/// solver processes (c/solver.c), as a process of its own would give it.\n/// `None` when the solver turned out not to answer a command as it reads\n/// it, which turns pooling off.\nfn pool_run(\n  solver: String,\n  jobs: List[(String, List[String])],\n) -> Option[List[String]] {\n  text := join(jobs.map(j -> join(j.1, \" \") + chr(31) + j.0), chr(30))\n  timings.begin(\"solver\")\n  out := smt.solver_pool_run(solver, text)\n  timings.end(\"solver\")\n  if smt.pooled(solver) {\n    Some(split(out, chr(30)))\n  } else {\n    None\n  }\n}","old_text":"/// Each script's output (with its flags), in order, from solver processes\n/// kept running (c/solver.c): the answers a process of its own gives.\n/// `None`: the solver turned out not to answer a command as it reads it\n/// (it isn't `pooled` any more).\nfn pool_run(\n  solver: String,\n  jobs: List[(String, List[String])],\n) -> Option[List[String]] {\n  text := join(jobs.map(j -> join(j.1, \" \") + chr(31) + j.0), chr(30))\n  timings.begin(\"solver\")\n  out := smt.solver_pool_run(solver, text)\n  timings.end(\"solver\")\n  if smt.pooled(solver) {\n    Some(split(out, chr(30)))\n  } else {\n    None\n  }\n}"},{"name":"smt.plain_term","kind":"fn","old":"dd6e4c537aff2526","new":"d9ce209920962549","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether `t` is one parenthesized term as `body_with` names terms: `(`\n/// to its matching `)`, with no string literal or parenthesis between bars,\n/// and nothing a `body_with` name (`str0`) could produce. Two occurrences\n/// of such terms are disjoint or nested, so replacing them one after\n/// another, longest first, equals replacing each where it starts, longest\n/// first, in one pass (`replace_terms`).\nfn plain_term(t: String) -> Bool {\n  n := byte_len(t)\n  if n < 2 || byte_at(t, 0) != 40 || byte_at(t, n - 1) != 41 {\n    return false\n  }\n  mut depth := 0\n  mut bar := false\n  for k in 0..n {\n    b := byte_at(t, k)\n    if b == 34 {\n      return false\n    }\n    if b == 124 {\n      bar = !bar\n    } else if b == 40 || b == 41 {\n      if bar {\n        return false\n      }\n      depth += if b == 40 {\n        1\n      } else {\n        -1\n      }\n      if depth <= 0 && k < n - 1 {\n        return false\n      }\n    } else if b == 115\n      && k + 3 < n\n      && byte_at(t, k + 1) == 116\n      && byte_at(t, k + 2) == 114\n      && byte_at(t, k + 3) >= 48\n      && byte_at(t, k + 3) <= 57 {\n      return false\n    }\n  }\n  depth == 0 && !bar\n}","old_text":"/// Whether `t` is one parenthesized term, as `body_with` names terms: `(`\n/// to its own `)` (no string literal, no parenthesis between bars), and\n/// nothing a name `body_with` gives (`str0`) could make. Two occurrences of\n/// such terms in a text are apart, or one holds the other: so replacing\n/// them, the longest first, one after another, is replacing each where it\n/// starts, the longest first, in one pass (`replace_terms`).\nfn plain_term(t: String) -> Bool {\n  n := byte_len(t)\n  if n < 2 || byte_at(t, 0) != 40 || byte_at(t, n - 1) != 41 {\n    return false\n  }\n  mut depth := 0\n  mut bar := false\n  for k in 0..n {\n    b := byte_at(t, k)\n    if b == 34 {\n      return false\n    }\n    if b == 124 {\n      bar = !bar\n    } else if b == 40 || b == 41 {\n      if bar {\n        return false\n      }\n      depth += if b == 40 {\n        1\n      } else {\n        -1\n      }\n      if depth <= 0 && k < n - 1 {\n        return false\n      }\n    } else if b == 115\n      && k + 3 < n\n      && byte_at(t, k + 1) == 116\n      && byte_at(t, k + 2) == 114\n      && byte_at(t, k + 3) >= 48\n      && byte_at(t, k + 3) <= 57 {\n      return false\n    }\n  }\n  depth == 0 && !bar\n}"},{"name":"smt.term_end","kind":"fn","old":"94f48ef7e9b76db4","new":"0a5b5da6671d6dc2","interface_changed":false,"affected":[],"module":"smt","text":"/// The end of the term starting at byte `i` of `s` (a `(`): the byte after\n/// its `)`, counting parentheses. -1 past `limit` bytes.\nfn term_end(s: String, i: Int where it >= 0, limit: Int) -> Int {\n  n := min(byte_len(s), i + limit)\n  mut depth := 0\n  mut k := i\n  while k < n {\n    b := byte_at(s, k)\n    if b == 40 {\n      depth += 1\n    } else if b == 41 {\n      depth -= 1\n      if depth == 0 {\n        return k + 1\n      }\n    }\n    k += 1\n  }\n  -1\n}","old_text":"/// Where the term starting at byte `i` of `s` (a `(`) ends: the byte after\n/// its `)`, counting parentheses; -1 past `limit` bytes.\nfn term_end(s: String, i: Int where it >= 0, limit: Int) -> Int {\n  n := min(byte_len(s), i + limit)\n  mut depth := 0\n  mut k := i\n  while k < n {\n    b := byte_at(s, k)\n    if b == 40 {\n      depth += 1\n    } else if b == 41 {\n      depth -= 1\n      if depth == 0 {\n        return k + 1\n      }\n    }\n    k += 1\n  }\n  -1\n}"},{"name":"smt.term_heads","kind":"fn","old":"ebbc3cb20198db7b","new":"7bf1f0336efaede2","interface_changed":false,"affected":[],"module":"smt","text":"/// The length of the shortest of `ts`, and each one's first bytes of that\n/// length.\nfn term_heads(ts: List[String]) -> (Int, Set[String], Int) {\n  mut k := 0\n  mut most := 0\n  for (i, t) in enumerate(ts) {\n    n := byte_len(t)\n    if i == 0 || n < k {\n      k = n\n    }\n    if n > most {\n      most = n\n    }\n  }\n  (k, set(ts.map(t -> byte_slice(t, 0, k))), most)\n}","old_text":"/// The first bytes every one of `ts` has as many of (their shortest\n/// length), and those bytes of each.\nfn term_heads(ts: List[String]) -> (Int, Set[String], Int) {\n  mut k := 0\n  mut most := 0\n  for (i, t) in enumerate(ts) {\n    n := byte_len(t)\n    if i == 0 || n < k {\n      k = n\n    }\n    if n > most {\n      most = n\n    }\n  }\n  (k, set(ts.map(t -> byte_slice(t, 0, k))), most)\n}"},{"name":"smt.found_terms","kind":"fn","old":"8788b8967c2f9c31","new":"79164e93599a1cb7","interface_changed":false,"affected":[],"module":"smt","text":"/// Which of `ts` (each a `plain_term`) occur in `s`, in one pass: each `(`\n/// whose first bytes match one of them is read to its `)`.\nfn found_terms(s: String, ts: List[String]) -> Set[String] {\n  if ts == [] {\n    return Set[String] {}\n  }\n  wanted := set(ts)\n  (k, heads, most) := smt.term_heads(ts)\n  n := byte_len(s)\n  mut out := []\n  for i in 0..n {\n    if byte_at(s, i) == 40\n      && i + k <= n\n      && contains(heads, byte_slice(s, i, i + k)) {\n      e := smt.term_end(s, i, most)\n      if e > 0 {\n        x := byte_slice(s, i, e)\n        if contains(wanted, x) {\n          mut out.push(x)\n        }\n      }\n    }\n  }\n  set(out)\n}","old_text":"/// Which of `ts` (each a `plain_term`) are in `s`: in one pass, each `(`\n/// whose first bytes are one of theirs read to its `)`.\nfn found_terms(s: String, ts: List[String]) -> Set[String] {\n  if ts == [] {\n    return Set[String] {}\n  }\n  wanted := set(ts)\n  (k, heads, most) := smt.term_heads(ts)\n  n := byte_len(s)\n  mut out := []\n  for i in 0..n {\n    if byte_at(s, i) == 40\n      && i + k <= n\n      && contains(heads, byte_slice(s, i, i + k)) {\n      e := smt.term_end(s, i, most)\n      if e > 0 {\n        x := byte_slice(s, i, e)\n        if contains(wanted, x) {\n          mut out.push(x)\n        }\n      }\n    }\n  }\n  set(out)\n}"},{"name":"smt.replace_terms","kind":"fn","old":"85f83900d56b6900","new":"fb822ee449c24f7b","interface_changed":false,"affected":[],"module":"smt","text":"/// `s` with each term in `names` (each a `plain_term`) replaced by its\n/// name, where it starts, left to right. `plain_term` says why this equals\n/// replacing them one after another, longest first.\nfn replace_terms(s: String, names: Dict[String, String]) -> String {\n  if len(names) == 0 {\n    return s\n  }\n  (k, heads, most) := smt.term_heads(keys(names))\n  n := byte_len(s)\n  mut parts := []\n  mut last := 0\n  mut i := 0\n  while i < n\n    invariant i >= 0\n    invariant i >= last\n    invariant last >= 0\n    invariant last <= i {\n    mut next := i + 1\n    if byte_at(s, i) == 40\n      && i + k <= n\n      && contains(heads, byte_slice(s, i, i + k)) {\n      e := smt.term_end(s, i, most)\n      if e > i {\n        match get(names, byte_slice(s, i, e)) {\n          Some(name) => {\n            mut parts.push(byte_slice(s, last, i))\n            mut parts.push(name)\n            last = e\n            next = e\n          },\n          None => (),\n        }\n      }\n    }\n    i = max(next, i + 1)\n  }\n  mut parts.push(byte_slice(s, last, n))\n  join(parts, \"\")\n}","old_text":"/// `s` with each of the terms `names` has (each a `plain_term`) replaced\n/// by its name, where it starts, left to right (`plain_term` says why that\n/// is replacing them one after another, the longest first).\nfn replace_terms(s: String, names: Dict[String, String]) -> String {\n  if len(names) == 0 {\n    return s\n  }\n  (k, heads, most) := smt.term_heads(keys(names))\n  n := byte_len(s)\n  mut parts := []\n  mut last := 0\n  mut i := 0\n  while i < n\n    invariant i >= 0\n    invariant i >= last\n    invariant last >= 0\n    invariant last <= i {\n    mut next := i + 1\n    if byte_at(s, i) == 40\n      && i + k <= n\n      && contains(heads, byte_slice(s, i, i + k)) {\n      e := smt.term_end(s, i, most)\n      if e > i {\n        match get(names, byte_slice(s, i, e)) {\n          Some(name) => {\n            mut parts.push(byte_slice(s, last, i))\n            mut parts.push(name)\n            last = e\n            next = e\n          },\n          None => (),\n        }\n      }\n    }\n    i = max(next, i + 1)\n  }\n  mut parts.push(byte_slice(s, last, n))\n  join(parts, \"\")\n}"},{"name":"smt.question_job","kind":"fn","old":"c4351e7573885505","new":"87995fa2c72844c3","interface_changed":false,"affected":[],"module":"smt","text":"/// A question the encoder asks (`ask`: `search`, `probe` or `check`, a\n/// line, then the script) as a job for the solver processes: its flags,\n/// 0x1f, the script. A search's flags include `budget`, so it draws on the\n/// run's search budget (c/solver.c's `solver_budget`).\nfn question_job(q: String) -> String {\n  join(smt.question_flags(q), \" \")\n    + if smt.is_search(q) {\n      \" budget\"\n    } else {\n      \"\"\n    }\n    + chr(31)\n    + byte_slice(q, index_of(q, \"\\n\") ?? 0, byte_len(q))\n}","old_text":"/// A question the encoder asks (`ask`: `search`, `probe` or `check`, a\n/// line, then the script) as a job for the solver's processes: its flags,\n/// 0x1f, the script. A search's flags say `budget`: it draws on the run's\n/// search budget (c/solver.c's `solver_budget`).\nfn question_job(q: String) -> String {\n  join(smt.question_flags(q), \" \")\n    + if smt.is_search(q) {\n      \" budget\"\n    } else {\n      \"\"\n    }\n    + chr(31)\n    + byte_slice(q, index_of(q, \"\\n\") ?? 0, byte_len(q))\n}"},{"name":"smt.question_answer","kind":"fn","old":"b0c75ea6ff0b2a87","new":"d5fbac0f24c214f8","interface_changed":false,"affected":[],"module":"smt","text":"/// The answer to a question from its job's output (as `run_scripts` gives\n/// it): a batch's first answer.\nfn question_answer(q: String, out: String) -> String {\n  if contains(q, \"@@answered\") {\n    get(smt.answers(out), 0) ?? \"\"\n  } else {\n    out\n  }\n}","old_text":"/// The answer to a question, from its job's output (as `run_scripts` gives\n/// it: a batch's first answer).\nfn question_answer(q: String, out: String) -> String {\n  if contains(q, \"@@answered\") {\n    get(smt.answers(out), 0) ?? \"\"\n  } else {\n    out\n  }\n}"},{"name":"smt.encode_answered","kind":"fn","old":"5e7fed2621d04108","new":"819039eef3cf43ae","interface_changed":false,"affected":[],"module":"smt","text":"/// `encode_all` with running solver processes. Each function is encoded\n/// once on worker threads (`parallel.map`), sending its questions to the\n/// solver as they come (`Vc.live`: the run waits for each answer while the\n/// other workers go on), so every function's questions are in flight at\n/// once. Gives the same encodings as `encode_rounds`. With `prefetch`, a\n/// function's obligations are queued as soon as it is encoded, as\n/// `answers_all` asks them. `None` when the solver turned out not to answer\n/// a command as it reads it, which turns pooling off.\nfn encode_answered(\n  solver: String,\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  sigs: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  fs: List[(ast.FnDecl, String)],\n  prefetch: Bool,\n) -> Option[List[smt.Vc]] {\n  vcs := parallel.map(fs, x -> {\n    mut vc := smt.new_vc(fns, types, sigs, methods)\n    vc.live = solver\n    smt.function(mut vc, x.0, x.1)\n    if prefetch && vc.gaps == [] && len(vc.obligations) > 0 {\n      _ := smt.solver_pool_prefetch(\n        solver,\n        \"-t:20000 rlimit=2000000\" + chr(31) + smt.batch(vc),\n      )\n    }\n    smt.Vc { ..vc, live: \"\" }\n  })\n  if smt.pooled(solver) {\n    Some(vcs)\n  } else {\n    None\n  }\n}","old_text":"/// `encode_all` with the solver's processes kept running: each function\n/// encoded once, on worker threads (`parallel.map`), its questions put to\n/// the solver as they come (`Vc.live`: the run waits for each answer while\n/// the other workers go on), so the questions of every function are in\n/// flight at once across the solver's processes. The same encodings as\n/// `encode_rounds` (a question's answer doesn't depend on who asks it, nor\n/// when). With `prefetch`, a function's obligations are queued as soon as\n/// it is encoded, as `answers_all` asks them. `None`: the solver turned\n/// out not to answer a command as it reads it (it isn't `pooled` any\n/// more).\nfn encode_answered(\n  solver: String,\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  sigs: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  fs: List[(ast.FnDecl, String)],\n  prefetch: Bool,\n) -> Option[List[smt.Vc]] {\n  vcs := parallel.map(fs, x -> {\n    mut vc := smt.new_vc(fns, types, sigs, methods)\n    vc.live = solver\n    smt.function(mut vc, x.0, x.1)\n    if prefetch && vc.gaps == [] && len(vc.obligations) > 0 {\n      _ := smt.solver_pool_prefetch(\n        solver,\n        \"-t:20000 rlimit=2000000\" + chr(31) + smt.batch(vc),\n      )\n    }\n    smt.Vc { ..vc, live: \"\" }\n  })\n  if smt.pooled(solver) {\n    Some(vcs)\n  } else {\n    None\n  }\n}"},{"name":"smt.encode_rounds","kind":"fn","old":"eeab048c468e8d75","new":"d71c3b56027e05fe","interface_changed":false,"affected":[],"module":"smt","text":"/// `encode` of each of `fs` (each with its label), in order. The questions\n/// they all ask in a round are asked together (`run_scripts`), each\n/// distinct one once. Gives the same encodings as one by one.\nfn encode_rounds(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  sigs: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  fs: List[(ast.FnDecl, String)],\n) -> List[smt.Vc] {\n  mut answers := Dict[String, String] {}\n  mut done: List[Option[smt.Vc]] = fs.map(x -> None)\n  while true {\n    mut now: List[Option[smt.Vc]] = []\n    mut asked := []\n    for (i, (f, label)) in enumerate(fs) {\n      match get(done, i) ?? None {\n        Some(v) => mut now.push(Some(v)),\n        None => {\n          mut vc := smt.new_vc(fns, types, sigs, methods)\n          vc.answers = answers\n          smt.function(mut vc, f, label)\n          if len(vc.pending) == 0 || len(vc.gaps) > 0 {\n            mut now.push(Some(vc))\n          } else {\n            mut now.push(None)\n            for q in vc.pending {\n              if !contains(asked, q) {\n                mut asked.push(q)\n              }\n            }\n          }\n        },\n      }\n    }\n    done = now\n    if asked == [] {\n      break\n    }\n    timings.begin(\"smt: a round of questions\")\n    outs := smt.run_scripts(\n      mut commands,\n      mut files,\n      scratch,\n      solver,\n      asked.map(\n        q -> (\n          byte_slice(q, index_of(q, \"\\n\") ?? 0, byte_len(q)),\n          smt.question_flags(q),\n        ),\n      ),\n    )\n    timings.end(\"smt: a round of questions\")\n    for (k, q) in enumerate(asked) {\n      mut answers.insert(q, get(get(outs, k) ?? [], 0) ?? \"\")\n    }\n  }\n  done.map(v -> v ?? smt.new_vc(fns, types, sigs, methods))\n}","old_text":"/// `encode` of each of `fs` (each with its label), in order: the\n/// questions they all ask in a round asked together (`run_scripts`), the\n/// same question once. The same encodings as one by one (a question's\n/// answer doesn't depend on who asks it).\nfn encode_rounds(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  sigs: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  fs: List[(ast.FnDecl, String)],\n) -> List[smt.Vc] {\n  mut answers := Dict[String, String] {}\n  mut done: List[Option[smt.Vc]] = fs.map(x -> None)\n  while true {\n    mut now: List[Option[smt.Vc]] = []\n    mut asked := []\n    for (i, (f, label)) in enumerate(fs) {\n      match get(done, i) ?? None {\n        Some(v) => mut now.push(Some(v)),\n        None => {\n          mut vc := smt.new_vc(fns, types, sigs, methods)\n          vc.answers = answers\n          smt.function(mut vc, f, label)\n          if len(vc.pending) == 0 || len(vc.gaps) > 0 {\n            mut now.push(Some(vc))\n          } else {\n            mut now.push(None)\n            for q in vc.pending {\n              if !contains(asked, q) {\n                mut asked.push(q)\n              }\n            }\n          }\n        },\n      }\n    }\n    done = now\n    if asked == [] {\n      break\n    }\n    timings.begin(\"smt: a round of questions\")\n    outs := smt.run_scripts(\n      mut commands,\n      mut files,\n      scratch,\n      solver,\n      asked.map(\n        q -> (\n          byte_slice(q, index_of(q, \"\\n\") ?? 0, byte_len(q)),\n          smt.question_flags(q),\n        ),\n      ),\n    )\n    timings.end(\"smt: a round of questions\")\n    for (k, q) in enumerate(asked) {\n      mut answers.insert(q, get(get(outs, k) ?? [], 0) ?? \"\")\n    }\n  }\n  done.map(v -> v ?? smt.new_vc(fns, types, sigs, methods))\n}"},{"name":"smt.refined_by","kind":"fn","old":"66af67252fbb743d","new":"38e5106031abc76f","interface_changed":false,"affected":[],"module":"smt","text":"/// `refined`, given the types that reach a refinement (`refined_types`). A\n/// type reaches what its declaration reaches, whatever its arguments, plus\n/// what its arguments reach.\nfn refined_by(names: Set[String], t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Refined { .. } => true,\n    ast.UnitType | ast.FnType { .. } => false,\n    ast.UnionType(ms) => ms.any(m -> smt.refined_by(names, m)),\n    ast.Named { name, args } => contains(names, name) || args.any(a -> smt.refined_by(names, a)),\n  }\n}","old_text":"/// `refined`, given the types that reach a refinement (`refined_types`):\n/// what a type reaches is what its declaration reaches (whatever its\n/// arguments) and what its arguments reach.\nfn refined_by(names: Set[String], t: ast.TypeExpr) -> Bool {\n  match t {\n    ast.Refined { .. } => true,\n    ast.UnitType | ast.FnType { .. } => false,\n    ast.UnionType(ms) => ms.any(m -> smt.refined_by(names, m)),\n    ast.Named { name, args } => contains(names, name) || args.any(a -> smt.refined_by(names, a)),\n  }\n}"},{"name":"smt.refined_types","kind":"fn","old":"2fa1cc15280227ef","new":"48e7c7e661f12a6b","interface_changed":false,"affected":[],"module":"smt","text":"/// The names of `types` (and of their sums' variants) whose declaration\n/// reaches a refinement, walked as `refined_walk` does: a variant through\n/// its sum; any other type through its own refinement and the fields and\n/// payloads of its body (the types they name, their arguments, a union's\n/// members, but not a function type's parts). Found backwards from the\n/// types that hold one, each type once.\npub fn refined_types(types: Dict[String, ast.TypeDecl]) -> Set[String] {\n  // who names whom: `by[m]` lists the types whose declaration names `m`\n  mut by := Dict[String, List[String]] {}\n  mut holding := []\n  mut parents := Set[String] {}\n  for (n, td) in items(types) {\n    match td.body {\n      ast.SumBody(vs) => {\n        for v in vs {\n          q := smt.qual(n, v.name)\n          mut parents.insert(q)\n          mut by.insert(n, (get(by, n) ?? []) + [q])\n        }\n      },\n      _ => (),\n    }\n  }\n  for (n, td) in items(types) {\n    if contains(parents, n) {\n      continue\n    }\n    mut todo := match td.body {\n      ast.Alias(a) => [a],\n      ast.RecordBody(fs) => fs.map(f -> f.ty),\n      ast.SumBody(vs) => [t for v in vs for t in match v.payload {\n        ast.NoPayload => [],\n        ast.Positional(ts) => ts,\n        ast.RecordPayload(fs) => fs.map(f -> f.ty),\n        ast.MemberType(m) => [m],\n      }],\n    }\n    mut holds := td.refinement != None\n    while len(todo) > 0 && !holds {\n      x := get(todo, len(todo) - 1) ?? ast.UnitType\n      todo = take(todo, len(todo) - 1)\n      match x {\n        ast.Refined { .. } => {\n          holds = true\n        },\n        ast.UnitType | ast.FnType { .. } => (),\n        ast.UnionType(ms) => {\n          todo += ms\n        },\n        ast.Named { name, args } => {\n          mut by.insert(name, (get(by, name) ?? []) + [n])\n          todo += args\n        },\n      }\n    }\n    if holds {\n      mut holding.push(n)\n    }\n  }\n  mut out := Set[String] {}\n  mut stack := holding\n  while len(stack) > 0 {\n    n := get(stack, len(stack) - 1) ?? \"\"\n    stack = take(stack, len(stack) - 1)\n    if !contains(out, n) {\n      mut out.insert(n)\n      stack += get(by, n) ?? []\n    }\n  }\n  out\n}","old_text":"/// The names of `types` (and of their sums' variants) whose declaration\n/// reaches a refinement, as `refined_walk` walks it: a variant through its\n/// sum; any other type through its own refinement, and the fields and\n/// payloads of its body (the types they name, their arguments, a union's\n/// members; not a function type's parts). Found backwards from the types\n/// that hold one, each type once.\npub fn refined_types(types: Dict[String, ast.TypeDecl]) -> Set[String] {\n  // who names whom: `by[m]`, the types whose declaration names `m`\n  mut by := Dict[String, List[String]] {}\n  mut holding := []\n  mut parents := Set[String] {}\n  for (n, td) in items(types) {\n    match td.body {\n      ast.SumBody(vs) => {\n        for v in vs {\n          q := smt.qual(n, v.name)\n          mut parents.insert(q)\n          mut by.insert(n, (get(by, n) ?? []) + [q])\n        }\n      },\n      _ => (),\n    }\n  }\n  for (n, td) in items(types) {\n    if contains(parents, n) {\n      continue\n    }\n    mut todo := match td.body {\n      ast.Alias(a) => [a],\n      ast.RecordBody(fs) => fs.map(f -> f.ty),\n      ast.SumBody(vs) => [t for v in vs for t in match v.payload {\n        ast.NoPayload => [],\n        ast.Positional(ts) => ts,\n        ast.RecordPayload(fs) => fs.map(f -> f.ty),\n        ast.MemberType(m) => [m],\n      }],\n    }\n    mut holds := td.refinement != None\n    while len(todo) > 0 && !holds {\n      x := get(todo, len(todo) - 1) ?? ast.UnitType\n      todo = take(todo, len(todo) - 1)\n      match x {\n        ast.Refined { .. } => {\n          holds = true\n        },\n        ast.UnitType | ast.FnType { .. } => (),\n        ast.UnionType(ms) => {\n          todo += ms\n        },\n        ast.Named { name, args } => {\n          mut by.insert(name, (get(by, name) ?? []) + [n])\n          todo += args\n        },\n      }\n    }\n    if holds {\n      mut holding.push(n)\n    }\n  }\n  mut out := Set[String] {}\n  mut stack := holding\n  while len(stack) > 0 {\n    n := get(stack, len(stack) - 1) ?? \"\"\n    stack = take(stack, len(stack) - 1)\n    if !contains(out, n) {\n      mut out.insert(n)\n      stack += get(by, n) ?? []\n    }\n  }\n  out\n}"},{"name":"smt.refined_walk","kind":"fn","old":"10e269643b2bc1f3","new":"f18cdd57ede92a76","interface_changed":false,"affected":[],"module":"smt","text":"/// `refined` by walking every type `t` can reach (its arguments, the\n/// fields and payloads of its body, a variant's sum), each once.\nfn refined_walk(vc: smt.Vc, t: ast.TypeExpr) -> Bool {\n  mut seen := []\n  mut todo := [t]\n  while len(todo) > 0 {\n    x := get(todo, len(todo) - 1) ?? ast.UnitType\n    todo = take(todo, len(todo) - 1)\n    if contains(seen, x) {\n      continue\n    }\n    mut seen.push(x)\n    match x {\n      ast.Refined { .. } => return true,\n      ast.UnitType | ast.FnType { .. } => (),\n      ast.UnionType(ms) => {\n        todo += ms\n      },\n      ast.Named { name, args } => match get(vc.parents, name) {\n        Some(p) => mut todo.push(ast.Named { name: p, args }),\n        None => {\n          todo += args\n          match get(vc.types, name) {\n            Some(td) => {\n              if td.refinement != None {\n                return true\n              }\n              match td.body {\n                ast.Alias(a) => mut todo.push(a),\n                ast.RecordBody(fs) => {\n                  todo += fs.map(f -> f.ty)\n                },\n                ast.SumBody(vs) => {\n                  for v in vs {\n                    match v.payload {\n                      ast.NoPayload => (),\n                      ast.Positional(ts) => {\n                        todo += ts\n                      },\n                      ast.RecordPayload(fs) => {\n                        todo += fs.map(f -> f.ty)\n                      },\n                      ast.MemberType(m) => mut todo.push(m),\n                    }\n                  }\n                },\n              }\n            },\n            None => (),\n          }\n        },\n      },\n    }\n  }\n  false\n}","old_text":"/// `refined` by walking every type `t` can reach (its arguments, the\n/// fields and payloads of its body, the sum of a variant), each once.\nfn refined_walk(vc: smt.Vc, t: ast.TypeExpr) -> Bool {\n  mut seen := []\n  mut todo := [t]\n  while len(todo) > 0 {\n    x := get(todo, len(todo) - 1) ?? ast.UnitType\n    todo = take(todo, len(todo) - 1)\n    if contains(seen, x) {\n      continue\n    }\n    mut seen.push(x)\n    match x {\n      ast.Refined { .. } => return true,\n      ast.UnitType | ast.FnType { .. } => (),\n      ast.UnionType(ms) => {\n        todo += ms\n      },\n      ast.Named { name, args } => match get(vc.parents, name) {\n        Some(p) => mut todo.push(ast.Named { name: p, args }),\n        None => {\n          todo += args\n          match get(vc.types, name) {\n            Some(td) => {\n              if td.refinement != None {\n                return true\n              }\n              match td.body {\n                ast.Alias(a) => mut todo.push(a),\n                ast.RecordBody(fs) => {\n                  todo += fs.map(f -> f.ty)\n                },\n                ast.SumBody(vs) => {\n                  for v in vs {\n                    match v.payload {\n                      ast.NoPayload => (),\n                      ast.Positional(ts) => {\n                        todo += ts\n                      },\n                      ast.RecordPayload(fs) => {\n                        todo += fs.map(f -> f.ty)\n                      },\n                      ast.MemberType(m) => mut todo.push(m),\n                    }\n                  }\n                },\n              }\n            },\n            None => (),\n          }\n        },\n      },\n    }\n  }\n  false\n}"},{"name":"smt.encode_solving","kind":"fn","old":"454bd7bf37d2918e","new":"ceb078aaa3d853aa","interface_changed":false,"affected":[],"module":"smt","text":"/// `encode_all`, queueing each function's obligations for the solver as\n/// soon as it is encoded, as `answers_all` asks them\n/// (`solver_pool_prefetch`). They run while the others are encoded, and\n/// `answers_all` gets their answers or waits for those still running.\npub fn encode_solving(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  sigs: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  fs: List[(ast.FnDecl, String)],\n) -> List[smt.Vc] {\n  if smt.pooled(solver) {\n    match smt.encode_answered(solver, fns, types, sigs, methods, fs, true) {\n      Some(vcs) => return vcs,\n      None => (),\n    }\n  }\n  smt.encode_rounds(\n    mut commands,\n    mut files,\n    scratch,\n    solver,\n    fns,\n    types,\n    sigs,\n    methods,\n    fs,\n  )\n}","old_text":"/// `encode_all`, the obligations of each function encoded queued for the\n/// solver at once, as `answers_all` asks them (`solver_pool_prefetch`):\n/// they run while the others are encoded, and `answers_all` gets their\n/// answers (or waits for those still running).\npub fn encode_solving(\n  mut commands: std.process.Commands,\n  mut files: std.fs.Files,\n  scratch: String,\n  solver: String,\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  sigs: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  fs: List[(ast.FnDecl, String)],\n) -> List[smt.Vc] {\n  if smt.pooled(solver) {\n    match smt.encode_answered(solver, fns, types, sigs, methods, fs, true) {\n      Some(vcs) => return vcs,\n      None => (),\n    }\n  }\n  smt.encode_rounds(\n    mut commands,\n    mut files,\n    scratch,\n    solver,\n    fns,\n    types,\n    sigs,\n    methods,\n    fs,\n  )\n}"},{"name":"smt.solver_pool_prefetch","kind":"extern","old":"49aeddca51ea5cd5","new":"fb6d0161ff86cba6","interface_changed":false,"affected":[],"module":"smt","text":"/// Queues jobs (as `solver_pool_submit` takes them) on the running solver\n/// processes, to run when nothing else waits. Only their answers are kept:\n/// the same job run later gets its answer or waits for it (c/solver.c).\nextern c fn solver_pool_prefetch(solver: String, jobs: String) -> I32","old_text":"/// Jobs queued for the solver's processes kept running (as\n/// `solver_pool_submit` takes them) to run when nothing else waits, only\n/// their answers kept: the same job run later gets its answer, or waits\n/// for it (c/solver.c).\nextern c fn solver_pool_prefetch(solver: String, jobs: String) -> I32"},{"name":"smt.LoopFound","kind":"type","old":"8f7dea26cd98b04e","new":"e7d81cc423a2ba27","interface_changed":false,"affected":[],"module":"smt","text":"/// What inference found for one of the function's own `while` loops:\n/// - `at`: its index in `while_loops` of the body;\n/// - the invariants it added to what the types say, as shown and as code\n/// (a value before the loop is `$entry_x`, which `verify` renames before\n/// writing them);\n/// - the search cost (resource units, microseconds) and whether the search\n/// budget cut it short;\n/// - the variables the loop changes.\npub type LoopFound = {\n  at: Int,\n  head: String,\n  shown: List[String],\n  code: List[ast.Expr],\n  units: Int,\n  micros: Int,\n  cut: Bool,\n  changed: List[String],\n}","old_text":"/// What inference found for one of the function's own `while` loops: the\n/// loop (`at`, its place in `while_loops` of the body), the invariants it\n/// added to what the types say (as shown, and as code, where a value\n/// before the loop is `$entry_x`: `verify` names it in code before writing\n/// them), what the search took (resource units, microseconds), whether it\n/// was cut short (the search budget used up), and the variables the loop\n/// changes.\npub type LoopFound = {\n  at: Int,\n  head: String,\n  shown: List[String],\n  code: List[ast.Expr],\n  units: Int,\n  micros: Int,\n  cut: Bool,\n  changed: List[String],\n}"},{"name":"smt.while_loops","kind":"fn","old":"cacf247f71b9d21e","new":"07859ceb2347253f","interface_changed":false,"affected":[],"module":"smt","text":"/// The `while` loops of `e` by condition and body, in `statements` order:\n/// each block's statements, outermost blocks first.\npub fn while_loops(e: ast.Expr) -> List[(ast.Expr, ast.Expr)] {\n  mut out := []\n  mut todo := [e]\n  while len(todo) > 0 {\n    x := get(todo, len(todo) - 1) ?? e\n    todo = take(todo, len(todo) - 1)\n    match x {\n      ast.Block { stmts, .. } => {\n        for s in stmts {\n          match s {\n            ast.While { cond, body } => mut out.push((cond, body)),\n            _ => (),\n          }\n        }\n      },\n      _ => (),\n    }\n    todo += walk.kids(x).reversed()\n  }\n  out\n}","old_text":"/// The `while` loops of `e`, by their condition and body, in the order of\n/// `statements`: each block's statements, the blocks outermost first.\npub fn while_loops(e: ast.Expr) -> List[(ast.Expr, ast.Expr)] {\n  mut out := []\n  mut todo := [e]\n  while len(todo) > 0 {\n    x := get(todo, len(todo) - 1) ?? e\n    todo = take(todo, len(todo) - 1)\n    match x {\n      ast.Block { stmts, .. } => {\n        for s in stmts {\n          match s {\n            ast.While { cond, body } => mut out.push((cond, body)),\n            _ => (),\n          }\n        }\n      },\n      _ => (),\n    }\n    todo += walk.kids(x).reversed()\n  }\n  out\n}"},{"name":"smt.candidate_code","kind":"fn","old":"6f8565c7880e52a7","new":"8db0217599614961","interface_changed":false,"affected":[],"module":"smt","text":"/// A candidate invariant as code, `it` replaced by the variable it names.\n/// A value before the loop stays `$entry_x`.\nfn candidate_code(c: smt.Candidate) -> ast.Expr {\n  match c.it {\n    Some(x) => walk.rewrite_expr(c.e, e -> match e {\n      ast.Var(n) => if n == \"it\" {\n        ast.Var(x)\n      } else {\n        e\n      },\n      _ => e,\n    }),\n    None => c.e,\n  }\n}","old_text":"/// A candidate invariant as code: `it` the variable it names; a value\n/// before the loop stays `$entry_x`.\nfn candidate_code(c: smt.Candidate) -> ast.Expr {\n  match c.it {\n    Some(x) => walk.rewrite_expr(c.e, e -> match e {\n      ast.Var(n) => if n == \"it\" {\n        ast.Var(x)\n      } else {\n        e\n      },\n      _ => e,\n    }),\n    None => c.e,\n  }\n}"},{"name":"smt.is_search","kind":"fn","old":"c49bfbe343215567","new":"d360a9ca5ac897c7","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether a question is a loop-invariant search (`search`, or `probe` at\n/// a proof's limit), whose job draws on the run's search budget.\nfn is_search(q: String) -> Bool {\n  starts_with(q, \"search\\n\") || starts_with(q, \"probe\\n\")\n}","old_text":"/// Whether a question is a loop-invariant search (`search`, or `probe`\n/// at a proof's limit): its job draws on the run's search budget.\nfn is_search(q: String) -> Bool {\n  starts_with(q, \"search\\n\") || starts_with(q, \"probe\\n\")\n}"},{"name":"smt.search_question","kind":"fn","old":"d3e80c6079b006cd","new":"4be058c4fe8f08fd","interface_changed":false,"affected":[],"module":"smt","text":"/// A loop-invariant search's question: `search`, or `probe` inside a loop\n/// with written invariants (limits in `question_flags`). It asks what it\n/// used (`(get-info :rlimit)`) for the search budget.\nfn search_question(vc: smt.Vc, script: String) -> String {\n  if vc.cheap > 0 {\n      \"probe\\n\"\n    } else {\n      \"search\\n\"\n    }\n    + script\n    + \"(get-info :rlimit)\\n\"\n}","old_text":"/// A loop-invariant search's question: `search` (up to 20M resource\n/// units), or `probe` (2M) inside a loop with written invariants; it asks\n/// what it used (`(get-info :rlimit)`, for the search budget).\nfn search_question(vc: smt.Vc, script: String) -> String {\n  if vc.cheap > 0 {\n      \"probe\\n\"\n    } else {\n      \"search\\n\"\n    }\n    + script\n    + \"(get-info :rlimit)\\n\"\n}"},{"name":"smt.loop_index","kind":"fn","old":"5a7bf4d5c49502ae","new":"0783abdd34bd16a8","interface_changed":false,"affected":[],"module":"smt","text":"/// The index of the loop `while c { body }` in `whiles` (`while_loops`).\nfn loop_index(\n  whiles: List[(ast.Expr, ast.Expr)],\n  c: ast.Expr,\n  body: ast.Expr,\n) -> Option[Int] {\n  for (k, w) in enumerate(whiles) {\n    if w.0 == c && w.1 == body {\n      return Some(k)\n    }\n  }\n  None\n}","old_text":"/// Where the loop `while c { body }` is among `whiles` (`while_loops`).\nfn loop_index(\n  whiles: List[(ast.Expr, ast.Expr)],\n  c: ast.Expr,\n  body: ast.Expr,\n) -> Option[Int] {\n  for (k, w) in enumerate(whiles) {\n    if w.0 == c && w.1 == body {\n      return Some(k)\n    }\n  }\n  None\n}"},{"name":"smt.solver_budget","kind":"extern","old":"60801e53c1f88cc9","new":"4002c370a35ef0a3","interface_changed":false,"affected":[],"module":"smt","text":"/// Sets the run's search budget: the solver resource units all\n/// loop-invariant searches may use from now on (`units < 0`: no limit),\n/// none used yet (c/solver.c).\nextern c fn solver_budget(units: I64) -> I64","old_text":"/// The run's search budget from now on: the solver's resource units all\n/// loop-invariant searches may use (`units` < 0: no limit), none used yet\n/// (c/solver.c).\nextern c fn solver_budget(units: I64) -> I64"},{"name":"smt.solver_budget_refused","kind":"extern","old":"58fc7ceeb537c15e","new":"46726451e6820dcd","interface_changed":false,"affected":[],"module":"smt","text":"/// How many searches were refused because the search budget was used up.\nextern c fn solver_budget_refused() -> I64","old_text":"/// How many searches were refused, the search budget used up.\nextern c fn solver_budget_refused() -> I64"},{"name":"smt.set_search_budget","kind":"fn","old":"cd5b8b8635278ecf","new":"c11b92d82a4e3116","interface_changed":false,"affected":[],"module":"smt","text":"/// Sets the run's search budget from now on (`units < 0`: no limit).\npub fn set_search_budget(units: Int) {\n  n := if units < 0 {\n    -1\n  } else {\n    min(units, 4611686018427387904)\n  }\n  _ := smt.solver_budget(to_i64(n))\n}","old_text":"/// The run's search budget from now on (`units` < 0: no limit).\npub fn set_search_budget(units: Int) {\n  n := if units < 0 {\n    -1\n  } else {\n    min(units, 4611686018427387904)\n  }\n  _ := smt.solver_budget(to_i64(n))\n}"},{"name":"smt.search_spent","kind":"fn","old":"9db03324855dc214","new":"2e00ab8cabdf73b3","interface_changed":false,"affected":[],"module":"smt","text":"/// The resource units the run's searches used, and how many were refused.\npub fn search_spent() -> (Int, Int) {\n  (\n    smt.solver_budget_used().to_int(),\n    smt.solver_budget_refused().to_int(),\n  )\n}","old_text":"/// What the run's searches used (resource units), and how many were\n/// refused.\npub fn search_spent() -> (Int, Int) {\n  (\n    smt.solver_budget_used().to_int(),\n    smt.solver_budget_refused().to_int(),\n  )\n}"},{"name":"smt.question_flags","kind":"fn","old":"1b5a40dffbf9b2c1","new":"74628373f2f7f60c","interface_changed":false,"affected":[],"module":"smt","text":"/// A question's solver flags, each with a 20 s time limit:\n/// - `search` (a loop-invariant search): 20M resource units;\n/// - `probe` (about a loop with written invariants): 0.5M, as much as any\n/// proof has taken, since its candidates are only proven and what holds\n/// at once is kept;\n/// - a check: 2M, the proof limit.\nfn question_flags(q: String) -> List[String] {\n  if starts_with(q, \"search\\n\") {\n    [\"-T:20\", \"rlimit=20000000\"]\n  } else if starts_with(q, \"probe\\n\") {\n    [\"-T:20\", \"rlimit=500000\"]\n  } else {\n    [\"-T:20\", \"rlimit=2000000\"]\n  }\n}","old_text":"/// A question's limits: a loop-invariant search (`search`) up to 20M of the\n/// solver's resource units; one about a loop with written invariants\n/// (`probe`) 0.5M, as much as any proof has taken (they are only proven,\n/// and what else holds at once kept); a check 2M (`Limit::Proof`).\nfn question_flags(q: String) -> List[String] {\n  if starts_with(q, \"search\\n\") {\n    [\"-T:20\", \"rlimit=20000000\"]\n  } else if starts_with(q, \"probe\\n\") {\n    [\"-T:20\", \"rlimit=500000\"]\n  } else {\n    [\"-T:20\", \"rlimit=2000000\"]\n  }\n}"},{"name":"smt.subst_val_in","kind":"fn","old":"61b288a343c0bc00","new":"1b6ac23d339ed6ca","interface_changed":false,"affected":[],"module":"smt","text":"/// `subst_val` with the lists already copied: `done` maps each to its copy.\n/// A list's facts can hold the list itself (`where all(it.xs, …)`: the\n/// lambda keeps `it`, whose `xs` is the list), so each is copied once.\nfn subst_val_in(\n  mut vc: smt.Vc,\n  v: smt.Val,\n  i: String,\n  outer: List[String],\n  mut done: Dict[Int, Int],\n) -> smt.Val {\n  match v {\n    smt.VInt(x) => smt.VInt(smt.place(x, i, outer)),\n    smt.VBool(x) => smt.VBool(smt.place(x, i, outer)),\n    smt.VStr(x) => smt.VStr(smt.place(x, i, outer)),\n    smt.VTuple(xs) => {\n      mut out := []\n      for x in xs {\n        mut out.push(smt.subst_val_in(mut vc, x, i, outer, mut done))\n      }\n      smt.VTuple(out)\n    },\n    smt.VRec { name, fields } => {\n      mut out := []\n      for (f, x) in fields {\n        mut out.push(\n          (f, smt.subst_val_in(mut vc, x, i, outer, mut done)),\n        )\n      }\n      smt.VRec { name, fields: out }\n    },\n    smt.VSum { ty, args, tag, ctors } => {\n      mut out := []\n      for (c, xs) in ctors {\n        mut ys := []\n        for x in xs {\n          mut ys.push(smt.subst_val_in(mut vc, x, i, outer, mut done))\n        }\n        mut out.push((c, ys))\n      }\n      smt.VSum {\n        ty,\n        args,\n        tag: smt.place(tag, i, outer),\n        ctors: out,\n      }\n    },\n    smt.VDistinct { name, inner } => smt.VDistinct {\n      name,\n      inner: smt.subst_val_in(mut vc, inner, i, outer, mut done),\n    },\n    smt.VUnion { tag, slots } => {\n      mut out := []\n      for (k, x) in slots {\n        mut out.push(\n          (k, smt.subst_val_in(mut vc, x, i, outer, mut done)),\n        )\n      }\n      smt.VUnion { tag: smt.place(tag, i, outer), slots: out }\n    },\n    smt.VList { len: l0, id } => match get(done, id) {\n      Some(n) => smt.VList { len: smt.place(l0, i, outer), id: n },\n      None => {\n        info := smt.list_info(vc, id)\n        // its place first, for the facts that hold the list itself\n        n := len(vc.lists)\n        mut vc.lists.push(info)\n        mut done.insert(id, n)\n        // a dict or set: its array there\n        match (get(vc.keyed, id), get(vc.arrays, id)) {\n          (Some(t), Some(a)) => {\n            mut vc.keyed.insert(n, t)\n            mut vc.arrays.insert(n, smt.place(a, i, outer))\n          },\n          _ => (),\n        }\n        mut preds := []\n        for (g, f) in info.preds {\n          mut preds.push(\n            (\n              smt.place(g, i, outer),\n              smt.subst_func(mut vc, f, i, outer, mut done),\n            ),\n          )\n        }\n        mut seen := []\n        for (g, x) in info.seen {\n          mut seen.push(\n            (\n              smt.place(g, i, outer),\n              smt.subst_val_in(mut vc, x, i, outer, mut done),\n            ),\n          )\n        }\n        source := match info.source {\n          smt.GRange(a, b) => smt.GRange(smt.place(a, i, outer), smt.place(b, i, outer)),\n          smt.GSeq(x, ty, n) => smt.GSeq(smt.place(x, i, outer), ty, n),\n          smt.GEnum(p, l) => smt.GEnum(p, smt.place(l, i, outer)),\n          smt.GZip(a, b, l) => smt.GZip(a, b, smt.place(l, i, outer)),\n          smt.GValues(vs) => {\n            mut ws := []\n            for x in vs {\n              mut ws.push(\n                smt.subst_val_in(mut vc, x, i, outer, mut done),\n              )\n            }\n            smt.GValues(ws)\n          },\n          // a checked type: the lists of a template are only made by `shape`\n          g => g,\n        }\n        smt.set_list(mut vc, n, smt.ListInfo {\n          source,\n          positional: info.positional,\n          preds,\n          seen,\n          template: None,\n          outer: info.outer.map(o -> smt.place(o, i, outer)),\n          tpl_from: Some(info.tpl_from ?? id),\n          at: Dict[String, (smt.Val, List[String])] {},\n        })\n        smt.VList { len: smt.place(l0, i, outer), id: n }\n      },\n    },\n    // a term with placeholders: the same term at this position\n    smt.VData { ty, t } => smt.VData { ty, t: smt.place(t, i, outer) },\n    other => other,\n  }\n}","old_text":"/// `subst_val`, with the lists already copied: `done` maps each to its\n/// copy. A list's facts can hold the list itself (`where all(it.xs, …)`:\n/// the lambda keeps `it`, whose `xs` is the list), so each is copied once.\nfn subst_val_in(\n  mut vc: smt.Vc,\n  v: smt.Val,\n  i: String,\n  outer: List[String],\n  mut done: Dict[Int, Int],\n) -> smt.Val {\n  match v {\n    smt.VInt(x) => smt.VInt(smt.place(x, i, outer)),\n    smt.VBool(x) => smt.VBool(smt.place(x, i, outer)),\n    smt.VStr(x) => smt.VStr(smt.place(x, i, outer)),\n    smt.VTuple(xs) => {\n      mut out := []\n      for x in xs {\n        mut out.push(smt.subst_val_in(mut vc, x, i, outer, mut done))\n      }\n      smt.VTuple(out)\n    },\n    smt.VRec { name, fields } => {\n      mut out := []\n      for (f, x) in fields {\n        mut out.push(\n          (f, smt.subst_val_in(mut vc, x, i, outer, mut done)),\n        )\n      }\n      smt.VRec { name, fields: out }\n    },\n    smt.VSum { ty, args, tag, ctors } => {\n      mut out := []\n      for (c, xs) in ctors {\n        mut ys := []\n        for x in xs {\n          mut ys.push(smt.subst_val_in(mut vc, x, i, outer, mut done))\n        }\n        mut out.push((c, ys))\n      }\n      smt.VSum {\n        ty,\n        args,\n        tag: smt.place(tag, i, outer),\n        ctors: out,\n      }\n    },\n    smt.VDistinct { name, inner } => smt.VDistinct {\n      name,\n      inner: smt.subst_val_in(mut vc, inner, i, outer, mut done),\n    },\n    smt.VUnion { tag, slots } => {\n      mut out := []\n      for (k, x) in slots {\n        mut out.push(\n          (k, smt.subst_val_in(mut vc, x, i, outer, mut done)),\n        )\n      }\n      smt.VUnion { tag: smt.place(tag, i, outer), slots: out }\n    },\n    smt.VList { len: l0, id } => match get(done, id) {\n      Some(n) => smt.VList { len: smt.place(l0, i, outer), id: n },\n      None => {\n        info := smt.list_info(vc, id)\n        // its place first, for the facts that hold the list itself\n        n := len(vc.lists)\n        mut vc.lists.push(info)\n        mut done.insert(id, n)\n        // (a dict or set: its array there)\n        match (get(vc.keyed, id), get(vc.arrays, id)) {\n          (Some(t), Some(a)) => {\n            mut vc.keyed.insert(n, t)\n            mut vc.arrays.insert(n, smt.place(a, i, outer))\n          },\n          _ => (),\n        }\n        mut preds := []\n        for (g, f) in info.preds {\n          mut preds.push(\n            (\n              smt.place(g, i, outer),\n              smt.subst_func(mut vc, f, i, outer, mut done),\n            ),\n          )\n        }\n        mut seen := []\n        for (g, x) in info.seen {\n          mut seen.push(\n            (\n              smt.place(g, i, outer),\n              smt.subst_val_in(mut vc, x, i, outer, mut done),\n            ),\n          )\n        }\n        source := match info.source {\n          smt.GRange(a, b) => smt.GRange(smt.place(a, i, outer), smt.place(b, i, outer)),\n          smt.GSeq(x, ty, n) => smt.GSeq(smt.place(x, i, outer), ty, n),\n          smt.GEnum(p, l) => smt.GEnum(p, smt.place(l, i, outer)),\n          smt.GZip(a, b, l) => smt.GZip(a, b, smt.place(l, i, outer)),\n          smt.GValues(vs) => {\n            mut ws := []\n            for x in vs {\n              mut ws.push(\n                smt.subst_val_in(mut vc, x, i, outer, mut done),\n              )\n            }\n            smt.GValues(ws)\n          },\n          // a checked type: the lists of a template are only made by `shape`\n          g => g,\n        }\n        smt.set_list(mut vc, n, smt.ListInfo {\n          source,\n          positional: info.positional,\n          preds,\n          seen,\n          template: None,\n          outer: info.outer.map(o -> smt.place(o, i, outer)),\n          tpl_from: Some(info.tpl_from ?? id),\n          at: Dict[String, (smt.Val, List[String])] {},\n        })\n        smt.VList { len: smt.place(l0, i, outer), id: n }\n      },\n    },\n    // a term with placeholders: the same term at this position\n    smt.VData { ty, t } => smt.VData { ty, t: smt.place(t, i, outer) },\n    other => other,\n  }\n}"},{"name":"smt.max_bounds","kind":"fn","old":"49c612e5ed20b275","new":"1ba37e9030c2b99d","interface_changed":false,"affected":[],"module":"smt","text":"/// The most candidate bounds a loop's termination tries, singly and then in\n/// pairs compared in order: at most 4 + 12 questions.\nfn max_bounds() -> Int {\n  4\n}","old_text":"/// The most candidate bounds a loop's termination tries (singly, then in\n/// pairs compared in order: at most 4 + 12 questions).\nfn max_bounds() -> Int {\n  4\n}"},{"name":"smt.loop_measures","kind":"fn","old":"cfe7c622766a5239","new":"ba187a8221db8ced","interface_changed":false,"affected":[],"module":"smt","text":"/// A `while c` loop's candidate bounds: its condition's (`bounds`), then\n/// those of the comparisons its body tests (`if` and inner `while`\n/// conditions) over what is known before the loop. Each once, at most\n/// `max_bounds`.\nfn loop_measures(vc: smt.Vc, c: ast.Expr, body: ast.Expr) -> List[ast.Expr] {\n  mut tested := []\n  mut todo := [body]\n  while todo != [] {\n    x := get(todo, len(todo) - 1) ?? ast.UnitExpr\n    todo = take(todo, len(todo) - 1)\n    match x {\n      ast.IfExpr { cond, .. } => {\n        tested += smt.bounds(cond)\n      },\n      ast.Block { stmts, .. } => {\n        for s in stmts {\n          match s {\n            ast.While { cond, .. } => {\n              tested += smt.bounds(cond)\n            },\n            _ => (),\n          }\n        }\n      },\n      _ => (),\n    }\n    todo += walk.kids(x)\n  }\n  known := (m: ast.Expr) -> smt.var_names(m).all(\n    v -> smt.lookup(vc, v) != None\n      || contains(vc.fns, v)\n      || vc.builtins.any(b -> b.name == v),\n  )\n  mut out := []\n  mut seen := Set[String] {}\n  for m in smt.bounds(c) + tested.filter(known) {\n    k := text.expr_text(m, 0)\n    if !contains(seen, k) && len(out) < smt.max_bounds() {\n      mut seen.insert(k)\n      mut out.push(m)\n    }\n  }\n  out\n}","old_text":"/// A `while c` loop's candidate bounds: its condition's (`bounds`), then\n/// those of the comparisons its body tests (`if` and inner `while`\n/// conditions) over what is known before the loop, each once, at most\n/// `max_bounds`.\nfn loop_measures(vc: smt.Vc, c: ast.Expr, body: ast.Expr) -> List[ast.Expr] {\n  mut tested := []\n  mut todo := [body]\n  while todo != [] {\n    x := get(todo, len(todo) - 1) ?? ast.UnitExpr\n    todo = take(todo, len(todo) - 1)\n    match x {\n      ast.IfExpr { cond, .. } => {\n        tested += smt.bounds(cond)\n      },\n      ast.Block { stmts, .. } => {\n        for s in stmts {\n          match s {\n            ast.While { cond, .. } => {\n              tested += smt.bounds(cond)\n            },\n            _ => (),\n          }\n        }\n      },\n      _ => (),\n    }\n    todo += walk.kids(x)\n  }\n  known := (m: ast.Expr) -> smt.var_names(m).all(\n    v -> smt.lookup(vc, v) != None\n      || contains(vc.fns, v)\n      || vc.builtins.any(b -> b.name == v),\n  )\n  mut out := []\n  mut seen := Set[String] {}\n  for m in smt.bounds(c) + tested.filter(known) {\n    k := text.expr_text(m, 0)\n    if !contains(seen, k) && len(out) < smt.max_bounds() {\n      mut seen.insert(k)\n      mut out.push(m)\n    }\n  }\n  out\n}"},{"name":"smt.lex_down","kind":"fn","old":"f82affd06f2c96da","new":"1b6e68f8e895f3e2","interface_changed":false,"affected":[],"module":"smt","text":"/// \"Measures compared in order went down from `before` to `after`\": one\n/// went down from a non-negative value and those before it stayed the same.\n/// Lexicographic order on non-negative values has no infinite descent.\nfn lex_down(before: List[String], after: List[String]) -> String {\n  mut alts := []\n  mut equal_so_far := []\n  for (b, a) in zip(before, after) {\n    mut alts.push(\n      smt.and_all(equal_so_far + [f\"(>= {b} 0)\", f\"(< {a} {b})\"]),\n    )\n    mut equal_so_far.push(f\"(= {a} {b})\")\n  }\n  smt.or_all(alts)\n}","old_text":"/// That measures compared in order went down from `before` to `after`:\n/// some one went down from a value never negative, those before it the\n/// same (lexicographic order, which has no infinite descent).\nfn lex_down(before: List[String], after: List[String]) -> String {\n  mut alts := []\n  mut equal_so_far := []\n  for (b, a) in zip(before, after) {\n    mut alts.push(\n      smt.and_all(equal_so_far + [f\"(>= {b} 0)\", f\"(< {a} {b})\"]),\n    )\n    mut equal_so_far.push(f\"(= {a} {b})\")\n  }\n  smt.or_all(alts)\n}"},{"name":"smt.pass_measures","kind":"fn","old":"724dccc4da10f290","new":"9067990c7bf76ef0","interface_changed":false,"affected":[],"module":"smt","text":"/// The termination obligations at each end of a loop pass (`ends`; the\n/// path before the pass is `base` long). For each candidate of `tries`\n/// (indices in `measures`, compared in order, `before` their values at the\n/// pass's start): the loop is over (`c` false; a `loop` never is) or the\n/// candidate went down. Added to `vc.term_obs`, their indices returned.\n/// With a `decreases` clause (`written`), each pass end also checks it.\nfn pass_measures(\n  mut vc: smt.Vc,\n  c: Option[ast.Expr],\n  measures: List[ast.Expr],\n  before: List[String],\n  tries: List[List[Int]],\n  ends: List[smt.PassEnd],\n  base: Int,\n  written: String,\n  head: String,\n) -> List[Int] {\n  pc := vc.pc\n  scopes := vc.scopes\n  dead := vc.dead\n  mut goals := tries.map(_ -> [])\n  for e in ends {\n    vc.pc = e.pc\n    vc.scopes = e.scopes\n    vc.spec += 1\n    a0 := match c {\n      Some(x) => {\n        again := smt.eval(mut vc, x)\n        smt.as_bool(mut vc, again)\n      },\n      None => \"true\",\n    }\n    mut after := []\n    for m in measures {\n      mv := smt.eval(mut vc, m)\n      mut after.push(smt.as_int(mut vc, mv))\n    }\n    vc.spec -= 1\n    over_or := (down: String) -> if a0 == \"true\" {\n      down\n    } else {\n      f\"(or (not {a0}) {down})\"\n    }\n    mut next := []\n    for (k, t) in enumerate(tries) {\n      down := smt.lex_down(\n        t.map(i -> get(before, i) ?? \"0\"),\n        t.map(i -> get(after, i) ?? \"0\"),\n      )\n      g := smt.implies(smt.and_all(drop(e.pc, base)), over_or(down))\n      mut next.push((get(goals, k) ?? []) + [g])\n    }\n    goals = next\n    if written != \"\" {\n      vc.dead = false\n      at := if e.again {\n        \"at a `continue` in\"\n      } else {\n        \"after a pass of\"\n      }\n      if smt.start_goal(mut vc) {\n        smt.oblige(mut vc, \"decreases `\"\n          + drop_bytes(written, 10)\n          + \"` \"\n          + at\n          + \" `\"\n          + head\n          + \"`\", over_or(smt.lex_down(before, after)))\n      }\n    }\n  }\n  vc.pc = take(pc, base)\n  vc.scopes = scopes\n  vc.dead = dead\n  mut out := []\n  for (k, t) in enumerate(tries) {\n    mut vc.term_obs.push(\n      smt.Obligation {\n        what: \"loop bound `\" + smt.try_shown(measures, t) + \"`\",\n        goal: smt.and_all(get(goals, k) ?? []),\n        pc: vc.pc,\n        facts: len(vc.facts),\n      },\n    )\n    mut out.push(len(vc.term_obs) - 1)\n  }\n  out\n}","old_text":"/// Where each pass of a loop ends (`ends`; the path before the pass is\n/// `base` long): for each candidate of `tries` (indices in `measures`,\n/// compared in order; `before` their values at the pass's start), the\n/// termination obligation that the loop is over (`c` false; a `loop` is\n/// never over there) or the candidate went down, added to `vc.term_obs`\n/// (their indices returned). With a `decreases` clause (`written`, as\n/// written), each pass end is also a check of it.\nfn pass_measures(\n  mut vc: smt.Vc,\n  c: Option[ast.Expr],\n  measures: List[ast.Expr],\n  before: List[String],\n  tries: List[List[Int]],\n  ends: List[smt.PassEnd],\n  base: Int,\n  written: String,\n  head: String,\n) -> List[Int] {\n  pc := vc.pc\n  scopes := vc.scopes\n  dead := vc.dead\n  mut goals := tries.map(_ -> [])\n  for e in ends {\n    vc.pc = e.pc\n    vc.scopes = e.scopes\n    vc.spec += 1\n    a0 := match c {\n      Some(x) => {\n        again := smt.eval(mut vc, x)\n        smt.as_bool(mut vc, again)\n      },\n      None => \"true\",\n    }\n    mut after := []\n    for m in measures {\n      mv := smt.eval(mut vc, m)\n      mut after.push(smt.as_int(mut vc, mv))\n    }\n    vc.spec -= 1\n    over_or := (down: String) -> if a0 == \"true\" {\n      down\n    } else {\n      f\"(or (not {a0}) {down})\"\n    }\n    mut next := []\n    for (k, t) in enumerate(tries) {\n      down := smt.lex_down(\n        t.map(i -> get(before, i) ?? \"0\"),\n        t.map(i -> get(after, i) ?? \"0\"),\n      )\n      g := smt.implies(smt.and_all(drop(e.pc, base)), over_or(down))\n      mut next.push((get(goals, k) ?? []) + [g])\n    }\n    goals = next\n    if written != \"\" {\n      vc.dead = false\n      at := if e.again {\n        \"at a `continue` in\"\n      } else {\n        \"after a pass of\"\n      }\n      if smt.start_goal(mut vc) {\n        smt.oblige(mut vc, \"decreases `\"\n          + drop_bytes(written, 10)\n          + \"` \"\n          + at\n          + \" `\"\n          + head\n          + \"`\", over_or(smt.lex_down(before, after)))\n      }\n    }\n  }\n  vc.pc = take(pc, base)\n  vc.scopes = scopes\n  vc.dead = dead\n  mut out := []\n  for (k, t) in enumerate(tries) {\n    mut vc.term_obs.push(\n      smt.Obligation {\n        what: \"loop bound `\" + smt.try_shown(measures, t) + \"`\",\n        goal: smt.and_all(get(goals, k) ?? []),\n        pc: vc.pc,\n        facts: len(vc.facts),\n      },\n    )\n    mut out.push(len(vc.term_obs) - 1)\n  }\n  out\n}"},{"name":"smt.candidate_text","kind":"fn","old":"c2f715272ca53fbb","new":"16b76fb30c6aa162","interface_changed":false,"affected":[],"module":"smt","text":"/// How a loop's candidate is shown in `LoopInfo.candidates`: one measure as\n/// written, a pair as `the pair (`a`, `b`), compared in order,`.\nfn candidate_text(measures: List[ast.Expr], t: List[Int]) -> String {\n  shown := t.map(i -> text.expr_text(get(measures, i) ?? ast.UnitExpr, 0))\n  if len(shown) == 1 {\n    get(shown, 0) ?? \"\"\n  } else {\n    \"the pair (\"\n      + join(shown.map(s -> \"`\" + s + \"`\"), \", \")\n      + \"), compared in order,\"\n  }\n}","old_text":"/// How a loop's candidate is shown in `LoopInfo.candidates`: a single\n/// measure as written, a pair as `the pair (`a`, `b`), compared in order,`.\nfn candidate_text(measures: List[ast.Expr], t: List[Int]) -> String {\n  shown := t.map(i -> text.expr_text(get(measures, i) ?? ast.UnitExpr, 0))\n  if len(shown) == 1 {\n    get(shown, 0) ?? \"\"\n  } else {\n    \"the pair (\"\n      + join(shown.map(s -> \"`\" + s + \"`\"), \", \")\n      + \"), compared in order,\"\n  }\n}"},{"name":"smt.item_at","kind":"fn","old":"b8449d68c6a4660b","new":"ddc1b6f2b4c032fc","interface_changed":false,"affected":[],"module":"smt","text":"/// The element at position `i` of list `id` when its positions are known,\n/// else an arbitrary element.\nfn item_at(mut vc: smt.Vc, id: Int, i: String) -> smt.Val {\n  match smt.element_at_inner(mut vc, id, i) {\n    Some(x) => x,\n    None => smt.element_inner(mut vc, id),\n  }\n}","old_text":"/// The element at position `i` of list `id` when its positions are known,\n/// else an arbitrary element of it.\nfn item_at(mut vc: smt.Vc, id: Int, i: String) -> smt.Val {\n  match smt.element_at_inner(mut vc, id, i) {\n    Some(x) => x,\n    None => smt.element_inner(mut vc, id),\n  }\n}"},{"name":"smt.keyed_list","kind":"fn","old":"77ba5772e001fc3e","new":"b9af8657727a5b59","interface_changed":false,"affected":[],"module":"smt","text":"/// A dict or set of type `t` (`Dict[K, V]`, `Set[K]`) of length `l`: a list\n/// of its items (`items_of`), marked as a dict or set (`Vc.keyed`).\nfn keyed_list(mut vc: smt.Vc, l: String, t: ast.TypeExpr) -> smt.Val {\n  (name, args) := match t {\n    ast.Named { name, args } => (name, args),\n    _ => (\"\", []),\n  }\n  v := smt.new_list(mut vc, l, smt.items_of(name, args))\n  match v {\n    smt.VList { id, .. } => mut vc.keyed.insert(id, t),\n    _ => (),\n  }\n  v\n}","old_text":"/// A dict or set of type `t` (`Dict[K, V]`, `Set[K]`), of length `l`: a\n/// list of its items (`items_of`), kept as a dict or set (`Vc.keyed`).\nfn keyed_list(mut vc: smt.Vc, l: String, t: ast.TypeExpr) -> smt.Val {\n  (name, args) := match t {\n    ast.Named { name, args } => (name, args),\n    _ => (\"\", []),\n  }\n  v := smt.new_list(mut vc, l, smt.items_of(name, args))\n  match v {\n    smt.VList { id, .. } => mut vc.keyed.insert(id, t),\n    _ => (),\n  }\n  v\n}"},{"name":"smt.items_of","kind":"fn","old":"9dd3553db8914c07","new":"5c5e8ba604bab09a","interface_changed":false,"affected":[],"module":"smt","text":"/// How the elements of a `Dict[K, V]` (its `(K, V)` entries) or a `Set[K]`\n/// are made, as a `for` takes them.\nfn items_of(name: String, args: List[ast.TypeExpr]) -> smt.Gen {\n  match (name, args) {\n    (\"Dict\", [k, v]) => smt.GItems(ast.Named { name: \"Tuple\", args: [k, v] }),\n    (\"Set\", [k]) => smt.GItems(k),\n    _ => smt.Untracked,\n  }\n}","old_text":"/// How the elements of a `Dict[K, V]` (its entries, `(K, V)`) or a `Set[K]`\n/// are made, as a `for` takes them.\nfn items_of(name: String, args: List[ast.TypeExpr]) -> smt.Gen {\n  match (name, args) {\n    (\"Dict\", [k, v]) => smt.GItems(ast.Named { name: \"Tuple\", args: [k, v] }),\n    (\"Set\", [k]) => smt.GItems(k),\n    _ => smt.Untracked,\n  }\n}"},{"name":"smt.candidate_roots","kind":"fn","old":"2a1922421da86f3b","new":"1df7b9d712bf0558","interface_changed":false,"affected":[],"module":"smt","text":"/// The variables a candidate invariant names: its expression's, and the\n/// returned variable `it` stands for.\nfn candidate_roots(k: smt.Candidate) -> List[String] {\n  mut out := match k.it {\n    Some(x) => [x],\n    None => [],\n  }\n  mut todo := [k.e]\n  while len(todo) > 0 {\n    x := get(todo, len(todo) - 1) ?? ast.UnitExpr\n    todo = take(todo, len(todo) - 1)\n    match x {\n      ast.Var(n) => if !contains(out, n) {\n        mut out.push(n)\n      },\n      _ => (),\n    }\n    todo += walk.kids(x)\n  }\n  out\n}","old_text":"/// The variables a candidate invariant names (its expression's, and the\n/// returned variable `it` stands for).\nfn candidate_roots(k: smt.Candidate) -> List[String] {\n  mut out := match k.it {\n    Some(x) => [x],\n    None => [],\n  }\n  mut todo := [k.e]\n  while len(todo) > 0 {\n    x := get(todo, len(todo) - 1) ?? ast.UnitExpr\n    todo = take(todo, len(todo) - 1)\n    match x {\n      ast.Var(n) => if !contains(out, n) {\n        mut out.push(n)\n      },\n      _ => (),\n    }\n    todo += walk.kids(x)\n  }\n  out\n}"},{"name":"smt.gave_up","kind":"fn","old":"25b41bdfd74e4681","new":"10ecb2812d3c718e","interface_changed":false,"affected":[],"module":"smt","text":"/// Why a solver answered neither `sat` nor `unsat`:\n/// - it gave up within its resource limit, or found the query beyond it\n/// (`the solver gave up`). It would answer so again, so the verdict is\n/// kept.\n/// - it ran out of time. A less busy machine may finish, so it is not kept.\n/// - it gave no reason (a stand-in solver) or no answer. Not kept.\nfn gave_up(out: String) -> String {\n  first := trim(get(lines(out), 0) ?? \"\")\n  reason := match index_of(out, \"(:reason-unknown \") {\n    Some(k) => trim(get(lines(byte_slice(out, k, byte_len(out))), 0) ?? \"\"),\n    None => \"\",\n  }\n  if first == \"timeout\" || contains(reason, \"timeout\") {\n    \"the solver ran out of time\"\n  } else if first == \"unknown\" && reason != \"\" {\n    \"the solver gave up\"\n  } else if first == \"unknown\" {\n    \"the solver gave up (it said nothing of why)\"\n  } else {\n    \"the solver gave no answer\"\n  }\n}","old_text":"/// Why a solver answered neither `sat` nor `unsat`, from its answer: it\n/// gave up within its resource limit or found the query beyond it (`the\n/// solver gave up`: an answer it gives again, so the verdict is kept), it\n/// ran out of time (on a busy machine it may not: not kept), or it said\n/// nothing of why (a stand-in solver) or nothing at all (not kept).\nfn gave_up(out: String) -> String {\n  first := trim(get(lines(out), 0) ?? \"\")\n  reason := match index_of(out, \"(:reason-unknown \") {\n    Some(k) => trim(get(lines(byte_slice(out, k, byte_len(out))), 0) ?? \"\"),\n    None => \"\",\n  }\n  if first == \"timeout\" || contains(reason, \"timeout\") {\n    \"the solver ran out of time\"\n  } else if first == \"unknown\" && reason != \"\" {\n    \"the solver gave up\"\n  } else if first == \"unknown\" {\n    \"the solver gave up (it said nothing of why)\"\n  } else {\n    \"the solver gave no answer\"\n  }\n}"},{"name":"smt.type_args_at","kind":"fn","old":"6ee197e93089271b","new":"56dcbaefa969e6d3","interface_changed":false,"affected":[],"module":"smt","text":"/// A generic function's type parameters at a call, matching each\n/// parameter's type with its argument's (`val_type`). `None` when it has\n/// none, none is determined, or two arguments disagree.\nfn type_args_at(\n  vc: smt.Vc,\n  f: ast.FnDecl,\n  args: List[smt.Val],\n) -> Option[Dict[String, ast.TypeExpr]] {\n  if f.type_params == [] {\n    return None\n  }\n  mut found := Dict[String, ast.TypeExpr] {}\n  for (i, p) in enumerate(f.params) {\n    match get(args, i) {\n      Some(a) => match smt.val_type(vc, a) {\n        Some(t) => if !smt.match_type(f.type_params, p.ty, t, mut found) {\n          return None\n        },\n        None => (),\n      },\n      None => (),\n    }\n  }\n  if len(found) == 0 {\n    None\n  } else {\n    Some(found)\n  }\n}","old_text":"/// A generic function's type parameters at a call, from its arguments:\n/// each parameter's type matched with its argument's (`val_type`). `None`\n/// when it has none, none is told, or two arguments disagree.\nfn type_args_at(\n  vc: smt.Vc,\n  f: ast.FnDecl,\n  args: List[smt.Val],\n) -> Option[Dict[String, ast.TypeExpr]] {\n  if f.type_params == [] {\n    return None\n  }\n  mut found := Dict[String, ast.TypeExpr] {}\n  for (i, p) in enumerate(f.params) {\n    match get(args, i) {\n      Some(a) => match smt.val_type(vc, a) {\n        Some(t) => if !smt.match_type(f.type_params, p.ty, t, mut found) {\n          return None\n        },\n        None => (),\n      },\n      None => (),\n    }\n  }\n  if len(found) == 0 {\n    None\n  } else {\n    Some(found)\n  }\n}"},{"name":"smt.match_type","kind":"fn","old":"b0b8e56caa1abd41","new":"6fdadf78a5a662d9","interface_changed":false,"affected":[],"module":"smt","text":"/// Matches type `pt`, written with type parameters `ps`, against `at`,\n/// adding each parameter's type to `found`. False when one is found twice\n/// with different types.\nfn match_type(\n  ps: List[String],\n  pt: ast.TypeExpr,\n  at: ast.TypeExpr,\n  mut found: Dict[String, ast.TypeExpr],\n) -> Bool {\n  match pt {\n    ast.Named { name, args } => if args == [] && contains(ps, name) {\n      match get(found, name) {\n        Some(t) => t == at,\n        None => {\n          mut found.insert(name, at)\n          true\n        },\n      }\n    } else {\n      match at {\n        ast.Named { name: n2, args: a2 } => if n2 == name && len(a2) == len(args) {\n          for (x, y) in zip(args, a2) {\n            if !smt.match_type(ps, x, y, mut found) {\n              return false\n            }\n          }\n          true\n        } else {\n          true\n        },\n        _ => true,\n      }\n    },\n    _ => true,\n  }\n}","old_text":"/// Match type `pt`, written with type parameters `ps`, with `at`, adding\n/// what each parameter is to `found`: `false` when one is found twice,\n/// differently.\nfn match_type(\n  ps: List[String],\n  pt: ast.TypeExpr,\n  at: ast.TypeExpr,\n  mut found: Dict[String, ast.TypeExpr],\n) -> Bool {\n  match pt {\n    ast.Named { name, args } => if args == [] && contains(ps, name) {\n      match get(found, name) {\n        Some(t) => t == at,\n        None => {\n          mut found.insert(name, at)\n          true\n        },\n      }\n    } else {\n      match at {\n        ast.Named { name: n2, args: a2 } => if n2 == name && len(a2) == len(args) {\n          for (x, y) in zip(args, a2) {\n            if !smt.match_type(ps, x, y, mut found) {\n              return false\n            }\n          }\n          true\n        } else {\n          true\n        },\n        _ => true,\n      }\n    },\n    _ => true,\n  }\n}"},{"name":"smt.val_type","kind":"fn","old":"45600006ec44f345","new":"b094586b3ac518fe","interface_changed":false,"affected":[],"module":"smt","text":"/// The type of a value, as far as the value tells: a scalar's, a sum's or\n/// datatype's with its type arguments, a list's when its elements' type is\n/// known, a dict's or set's. Else `None`.\nfn val_type(vc: smt.Vc, v: smt.Val) -> Option[ast.TypeExpr] {\n  match v {\n    smt.VInt(_) => Some(ast.Named { name: \"Int\", args: [] }),\n    smt.VBool(_) => Some(ast.Named { name: \"Bool\", args: [] }),\n    smt.VStr(_) => Some(ast.Named { name: \"String\", args: [] }),\n    smt.VSum { ty, args, .. } => Some(ast.Named { name: ty, args }),\n    smt.VData { ty, .. } => Some(ty),\n    smt.VList { id, .. } => match get(vc.keyed, id) {\n      Some(t) => Some(t),\n      None => match smt.elem_type(vc, id) {\n        Some(t) => Some(ast.Named { name: \"List\", args: [t] }),\n        None => None,\n      },\n    },\n    _ => None,\n  }\n}","old_text":"/// The type of a value, as far as the value tells it: a scalar's, a sum's\n/// or datatype's with its type arguments, a list's when its elements' type\n/// is known, a dict's or set's; else `None`.\nfn val_type(vc: smt.Vc, v: smt.Val) -> Option[ast.TypeExpr] {\n  match v {\n    smt.VInt(_) => Some(ast.Named { name: \"Int\", args: [] }),\n    smt.VBool(_) => Some(ast.Named { name: \"Bool\", args: [] }),\n    smt.VStr(_) => Some(ast.Named { name: \"String\", args: [] }),\n    smt.VSum { ty, args, .. } => Some(ast.Named { name: ty, args }),\n    smt.VData { ty, .. } => Some(ty),\n    smt.VList { id, .. } => match get(vc.keyed, id) {\n      Some(t) => Some(t),\n      None => match smt.elem_type(vc, id) {\n        Some(t) => Some(ast.Named { name: \"List\", args: [t] }),\n        None => None,\n      },\n    },\n    _ => None,\n  }\n}"},{"name":"smt.pred_old","kind":"fn","old":"c9d8bc6c3c5a298e","new":"e4dc07b1f1672b20","interface_changed":false,"affected":[],"module":"smt","text":"/// `pred` with `old e` reading `olds`, the values before (an `ensures`).\nfn pred_old(\n  mut vc: smt.Vc,\n  e: ast.Expr,\n  binds: List[(String, smt.Val)],\n  olds: Option[List[(String, smt.Val)]],\n) -> String {\n  if vc.depth > 4 {\n    return smt.unknown_bool(mut vc, \"contracts nest too deeply\")\n  }\n  vc.depth += 1\n  saved := vc.scopes\n  vc.scopes = [dict(binds)]\n  saved_olds := vc.olds\n  vc.olds = match olds {\n    Some(o) => Some(dict(o)),\n    None => None,\n  }\n  dead := vc.dead\n  vc.dead = false\n  returns := vc.returns\n  vc.returns = []\n  vc.spec += 1\n  v := smt.eval(mut vc, e)\n  vc.spec -= 1\n  vc.returns = returns\n  vc.dead = dead\n  vc.scopes = saved\n  vc.olds = saved_olds\n  vc.depth -= 1\n  smt.as_bool(mut vc, v)\n}","old_text":"/// `pred`, with `old e` reading `olds` (an `ensures`: the values before).\nfn pred_old(\n  mut vc: smt.Vc,\n  e: ast.Expr,\n  binds: List[(String, smt.Val)],\n  olds: Option[List[(String, smt.Val)]],\n) -> String {\n  if vc.depth > 4 {\n    return smt.unknown_bool(mut vc, \"contracts nest too deeply\")\n  }\n  vc.depth += 1\n  saved := vc.scopes\n  vc.scopes = [dict(binds)]\n  saved_olds := vc.olds\n  vc.olds = match olds {\n    Some(o) => Some(dict(o)),\n    None => None,\n  }\n  dead := vc.dead\n  vc.dead = false\n  returns := vc.returns\n  vc.returns = []\n  vc.spec += 1\n  v := smt.eval(mut vc, e)\n  vc.spec -= 1\n  vc.returns = returns\n  vc.dead = dead\n  vc.scopes = saved\n  vc.olds = saved_olds\n  vc.depth -= 1\n  smt.as_bool(mut vc, v)\n}"},{"name":"smt.mut_state","kind":"fn","old":"42df7f75c605c0fa","new":"8f2d98c76df8c7bf","interface_changed":false,"affected":[],"module":"smt","text":"/// The `mut` parameters' current values.\nfn mut_state(vc: smt.Vc) -> List[(String, smt.Val)] {\n  mut out := []\n  for x in vc.mut_params {\n    match smt.lookup(vc, x) {\n      Some(v) => mut out.push((x, v)),\n      None => (),\n    }\n  }\n  out\n}","old_text":"/// The `mut` parameters' values now.\nfn mut_state(vc: smt.Vc) -> List[(String, smt.Val)] {\n  mut out := []\n  for x in vc.mut_params {\n    match smt.lookup(vc, x) {\n      Some(v) => mut out.push((x, v)),\n      None => (),\n    }\n  }\n  out\n}"},{"name":"smt.write_after","kind":"fn","old":"95367ae58de16ff4","new":"6d44c059cdd08566","interface_changed":false,"affected":[],"module":"smt","text":"/// After a call seen through its contract: writes the values its `mut`\n/// parameters come back with (left in `vc.after` by `call_contract`) to\n/// the arguments' places.\nfn write_after(\n  mut vc: smt.Vc,\n  params: List[ast.Param],\n  arg_exprs: List[ast.Expr],\n) {\n  after := vc.after\n  for (i, p) in enumerate(params) {\n    if p.mutable {\n      match (get(arg_exprs, i), get(after, i)) {\n        (Some(e), Some(v)) => smt.assign(mut vc, e, v, \"writing back\"),\n        _ => (),\n      }\n    }\n  }\n}","old_text":"/// After a call seen through its contract (`call_contract`, which leaves\n/// in `vc.after` the values its `mut` parameters come back with): those\n/// values, written to the arguments' places.\nfn write_after(\n  mut vc: smt.Vc,\n  params: List[ast.Param],\n  arg_exprs: List[ast.Expr],\n) {\n  after := vc.after\n  for (i, p) in enumerate(params) {\n    if p.mutable {\n      match (get(arg_exprs, i), get(after, i)) {\n        (Some(e), Some(v)) => smt.assign(mut vc, e, v, \"writing back\"),\n        _ => (),\n      }\n    }\n  }\n}"},{"name":"smt.same_call","kind":"fn","old":"c4116acb7b04ed57","new":"bfe917e2297f5533","interface_changed":false,"affected":[],"module":"smt","text":"/// The same call on the same values gives the same result: `r` is the\n/// result recorded under `key`, or is recorded.\nfn same_call(mut vc: smt.Vc, key: Option[String], r: smt.Val) {\n  match key {\n    Some(k) => match get(vc.memo, k) {\n      Some(before) => {\n        e := smt.eq(mut vc, r, before)\n        mut vc.facts.push(e)\n      },\n      None => mut vc.memo.insert(k, r),\n    },\n    None => (),\n  }\n}","old_text":"/// The same call on the same values gives the same result: `r` is the\n/// result remembered under `key`, or is remembered.\nfn same_call(mut vc: smt.Vc, key: Option[String], r: smt.Val) {\n  match key {\n    Some(k) => match get(vc.memo, k) {\n      Some(before) => {\n        e := smt.eq(mut vc, r, before)\n        mut vc.facts.push(e)\n      },\n      None => mut vc.memo.insert(k, r),\n    },\n    None => (),\n  }\n}"},{"name":"smt.MapSorts","kind":"type","old":"3951806303330071","new":"51c7c2f8cb1f2854","interface_changed":false,"affected":[],"module":"smt","text":"// ---- dicts and sets ----\n\n/// The SMT sorts of a dict's or set's array: from each key to an `Option`\n/// of its value (dict) or a Bool (set), and the size, a function of the\n/// array, so equal arrays have equal sizes.\ntype MapSorts = {\n  key: ast.TypeExpr,\n  // a dict's value type (`None` for a set)\n  val: Option[ast.TypeExpr],\n  ksort: String,\n  // the array's range: an `Option` of the values, or `Bool`\n  rsort: String,\n  arr: String,\n  // the size function\n  size: String,\n}","old_text":"// ---- dicts and sets ----\n\n/// The SMT sorts of the array of a dict or set: an array from each key to\n/// an `Option` of its value (a dict's) or to whether it is in (a set's),\n/// and its size, a function of the array (so equal arrays have equal\n/// sizes).\ntype MapSorts = {\n  key: ast.TypeExpr,\n  // a dict's value type (`None`: a set)\n  val: Option[ast.TypeExpr],\n  ksort: String,\n  // the array's range: an `Option` of the values, or `Bool`\n  rsort: String,\n  arr: String,\n  // the size function\n  size: String,\n}"},{"name":"smt.map_of","kind":"fn","old":"1db6d0eebb936f83","new":"4c3e74b92340cbf5","interface_changed":false,"affected":[],"module":"smt","text":"/// The array of a dict or set, with its type and sorts, if it has one.\nfn map_of(\n  mut vc: smt.Vc,\n  v: smt.Val,\n) -> Option[(String, ast.TypeExpr, smt.MapSorts)] {\n  match v {\n    smt.VList { id, .. } => {\n      a := get(vc.arrays, id)?\n      t := get(vc.keyed, id)?\n      ms := smt.map_sorts(mut vc, t)?\n      Some((a, t, ms))\n    },\n    smt.VData { .. } => {\n      fv := smt.force(mut vc, v)\n      match fv {\n        smt.VList { .. } => smt.map_of(mut vc, fv),\n        _ => None,\n      }\n    },\n    _ => None,\n  }\n}","old_text":"/// The array of a dict or set, its type and sorts, if it has one.\nfn map_of(\n  mut vc: smt.Vc,\n  v: smt.Val,\n) -> Option[(String, ast.TypeExpr, smt.MapSorts)] {\n  match v {\n    smt.VList { id, .. } => {\n      a := get(vc.arrays, id)?\n      t := get(vc.keyed, id)?\n      ms := smt.map_sorts(mut vc, t)?\n      Some((a, t, ms))\n    },\n    smt.VData { .. } => {\n      fv := smt.force(mut vc, v)\n      match fv {\n        smt.VList { .. } => smt.map_of(mut vc, fv),\n        _ => None,\n      }\n    },\n    _ => None,\n  }\n}"},{"name":"smt.term_of","kind":"fn","old":"54f75cff50fb25a2","new":"076fff3f8c7a0dc9","interface_changed":false,"affected":[],"module":"smt","text":"/// Value `v` of type `ty` as one term of its sort, to store in an array:\n/// its own term, or a new unknown equal to it.\nfn term_of(mut vc: smt.Vc, ty: ast.TypeExpr, v: smt.Val) -> String {\n  s := smt.field_sort(mut vc, ty)\n  plain := s == \"Int\" || s == \"Bool\" || s == \"String\"\n  match v {\n    smt.VInt(t) | smt.VBool(t) | smt.VStr(t) => if plain {\n      return t\n    },\n    smt.VDistinct { inner, .. } => match inner {\n      smt.VInt(t) => if s == \"Int\" {\n        return t\n      },\n      _ => (),\n    },\n    smt.VData { ty: vt, t } => if smt.sort_of(mut vc, vt) == Some(s) {\n      return t\n    },\n    smt.VList { id, .. } => match (get(vc.arrays, id), get(vc.keyed, id)) {\n      (Some(a), Some(kt)) => if smt.field_sort(mut vc, kt) == s {\n        return a\n      },\n      _ => (),\n    },\n    _ => (),\n  }\n  x := smt.fresh(mut vc, s)\n  u0 := smt.from_term(mut vc, ty, x)\n  u := smt.force(mut vc, u0)\n  smt.alias_lists(mut vc, u, v, 0)\n  e := smt.eq(mut vc, u, v)\n  smt.assume(mut vc, e)\n  x\n}","old_text":"/// Value `v` of type `ty` as one term of its sort (to store in an array):\n/// its own term, or a new unknown equal to it.\nfn term_of(mut vc: smt.Vc, ty: ast.TypeExpr, v: smt.Val) -> String {\n  s := smt.field_sort(mut vc, ty)\n  plain := s == \"Int\" || s == \"Bool\" || s == \"String\"\n  match v {\n    smt.VInt(t) | smt.VBool(t) | smt.VStr(t) => if plain {\n      return t\n    },\n    smt.VDistinct { inner, .. } => match inner {\n      smt.VInt(t) => if s == \"Int\" {\n        return t\n      },\n      _ => (),\n    },\n    smt.VData { ty: vt, t } => if smt.sort_of(mut vc, vt) == Some(s) {\n      return t\n    },\n    smt.VList { id, .. } => match (get(vc.arrays, id), get(vc.keyed, id)) {\n      (Some(a), Some(kt)) => if smt.field_sort(mut vc, kt) == s {\n        return a\n      },\n      _ => (),\n    },\n    _ => (),\n  }\n  x := smt.fresh(mut vc, s)\n  u0 := smt.from_term(mut vc, ty, x)\n  u := smt.force(mut vc, u0)\n  smt.alias_lists(mut vc, u, v, 0)\n  e := smt.eq(mut vc, u, v)\n  smt.assume(mut vc, e)\n  x\n}"},{"name":"smt.has_term","kind":"fn","old":"04973ba5b151081c","new":"0a768ed95bd25974","interface_changed":false,"affected":[],"module":"smt","text":"/// \"Key `k` is in array `a` of sorts `ms`\".\nfn has_term(vc: smt.Vc, ms: smt.MapSorts, a: String, k: String) -> String {\n  match ms.val {\n    Some(_) => \"((_ is \"\n      + smt.sym(smt.opt_ctor(vc, ms.rsort, \"Some\"))\n      + f\") (select {a} {k}))\",\n    None => f\"(select {a} {k})\",\n  }\n}","old_text":"/// Whether key `k` is in array `a` of sorts `ms`.\nfn has_term(vc: smt.Vc, ms: smt.MapSorts, a: String, k: String) -> String {\n  match ms.val {\n    Some(_) => \"((_ is \"\n      + smt.sym(smt.opt_ctor(vc, ms.rsort, \"Some\"))\n      + f\") (select {a} {k}))\",\n    None => f\"(select {a} {k})\",\n  }\n}"},{"name":"smt.map_store","kind":"fn","old":"480144e87f3dfb77","new":"b7a7ba7a5bd498a3","interface_changed":false,"affected":[],"module":"smt","text":"/// Array `a` with key `k` set to `entry`, and its size from `a`'s.\n/// `present`: whether the key is in after; `h`: whether it was before.\n/// Valid when `a` is and `extra` (the new key and value are valid) holds.\nfn map_store(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  ms: smt.MapSorts,\n  a: String,\n  k: String,\n  h: String,\n  entry: String,\n  present: Bool,\n  extra: List[String],\n) -> String {\n  a2 := smt.share(mut vc, ms.arr, f\"(store {a} {k} {entry})\")\n  // a key read in `a2` is read in `a` too: what holds of `a`'s entries\n  if a2 != a {\n    mut vc.map_from.insert(a2, a)\n  }\n  d := if present {\n    f\"(ite {h} 0 1)\"\n  } else {\n    f\"(ite {h} (- 1) 0)\"\n  }\n  mut vc.facts.push(f\"(= ({ms.size} {a2}) (+ ({ms.size} {a}) {d}))\")\n  if smt.refined(vc, t) {\n    before := smt.valid_term(mut vc, t, a)\n    after := smt.valid_term(mut vc, t, a2)\n    mut vc.facts.push(smt.implies(smt.and_all([before] + extra), after))\n  }\n  a2\n}","old_text":"/// Array `a` with key `k` set to `entry` (`present`: whether the key is in\n/// after; `h`: whether it was before), and its size from `a`'s; valid when\n/// `a` is and `extra` holds (the new key and value are).\nfn map_store(\n  mut vc: smt.Vc,\n  t: ast.TypeExpr,\n  ms: smt.MapSorts,\n  a: String,\n  k: String,\n  h: String,\n  entry: String,\n  present: Bool,\n  extra: List[String],\n) -> String {\n  a2 := smt.share(mut vc, ms.arr, f\"(store {a} {k} {entry})\")\n  // (a key read in `a2` is read in `a` too: what holds of `a`'s entries)\n  if a2 != a {\n    mut vc.map_from.insert(a2, a)\n  }\n  d := if present {\n    f\"(ite {h} 0 1)\"\n  } else {\n    f\"(ite {h} (- 1) 0)\"\n  }\n  mut vc.facts.push(f\"(= ({ms.size} {a2}) (+ ({ms.size} {a}) {d}))\")\n  if smt.refined(vc, t) {\n    before := smt.valid_term(mut vc, t, a)\n    after := smt.valid_term(mut vc, t, a2)\n    mut vc.facts.push(smt.implies(smt.and_all([before] + extra), after))\n  }\n  a2\n}"},{"name":"smt.map_entry","kind":"fn","old":"9b2dcdda50eef28b","new":"9bb6e4289854177b","interface_changed":false,"affected":[],"module":"smt","text":"/// The entry of a dict's array for value `x` (`Some(x)`), or `true` for a\n/// set, and whether the value is valid.\nfn map_entry(\n  mut vc: smt.Vc,\n  ms: smt.MapSorts,\n  x: Option[smt.Val],\n) -> (String, String) {\n  match (ms.val, x) {\n    (Some(vt), Some(v)) => {\n      xt := smt.term_of(mut vc, vt, v)\n      ok := if smt.refined(vc, vt) {\n        smt.check_type(mut vc, vt, v, [])\n      } else {\n        \"true\"\n      }\n      (\"(\"\n        + smt.sym(smt.opt_ctor(vc, ms.rsort, \"Some\"))\n        + \" \"\n        + xt\n        + \")\", ok)\n    },\n    _ => (\"true\", \"true\"),\n  }\n}","old_text":"/// The entry of a dict's array for value `x` (`Some(x)`), or `true` (a\n/// set's), and whether the value is valid.\nfn map_entry(\n  mut vc: smt.Vc,\n  ms: smt.MapSorts,\n  x: Option[smt.Val],\n) -> (String, String) {\n  match (ms.val, x) {\n    (Some(vt), Some(v)) => {\n      xt := smt.term_of(mut vc, vt, v)\n      ok := if smt.refined(vc, vt) {\n        smt.check_type(mut vc, vt, v, [])\n      } else {\n        \"true\"\n      }\n      (\"(\"\n        + smt.sym(smt.opt_ctor(vc, ms.rsort, \"Some\"))\n        + \" \"\n        + xt\n        + \")\", ok)\n    },\n    _ => (\"true\", \"true\"),\n  }\n}"},{"name":"smt.map_empty","kind":"fn","old":"e5c9933d0e2d6108","new":"174511b656278e56","interface_changed":false,"affected":[],"module":"smt","text":"/// The empty array of sorts `ms`: of size 0, valid.\nfn map_empty(mut vc: smt.Vc, t: ast.TypeExpr, ms: smt.MapSorts) -> String {\n  gone := match ms.val {\n    Some(_) => smt.sym(smt.opt_ctor(vc, ms.rsort, \"None\")),\n    None => \"false\",\n  }\n  // an unknown equal to it: the facts about it reach a query through the\n  // unknowns they name\n  e := smt.fresh(mut vc, ms.arr)\n  mut vc.facts.push(f\"(= {e} ((as const {ms.arr}) {gone}))\")\n  mut vc.facts.push(f\"(= ({ms.size} {e}) 0)\")\n  if smt.refined(vc, t) {\n    mut vc.facts.push(smt.valid_term(mut vc, t, e))\n  }\n  e\n}","old_text":"/// The empty array of sorts `ms`: of size 0, valid.\nfn map_empty(mut vc: smt.Vc, t: ast.TypeExpr, ms: smt.MapSorts) -> String {\n  gone := match ms.val {\n    Some(_) => smt.sym(smt.opt_ctor(vc, ms.rsort, \"None\")),\n    None => \"false\",\n  }\n  // (an unknown equal to it: the facts about it reach a query through\n  // the unknowns they name)\n  e := smt.fresh(mut vc, ms.arr)\n  mut vc.facts.push(f\"(= {e} ((as const {ms.arr}) {gone}))\")\n  mut vc.facts.push(f\"(= ({ms.size} {e}) 0)\")\n  if smt.refined(vc, t) {\n    mut vc.facts.push(smt.valid_term(mut vc, t, e))\n  }\n  e\n}"},{"name":"smt.literal_type","kind":"fn","old":"69620773948fcc49","new":"62fc8dc27b2613db","interface_changed":false,"affected":[],"module":"smt","text":"/// The type of the dict or set a `set` or `dict` call makes: the one its\n/// `let` gives (`Vc.want`), else its elements'.\nfn literal_type(\n  vc: smt.Vc,\n  name: String,\n  arg0: Option[ast.Expr],\n  xs: smt.Val,\n) -> Option[ast.TypeExpr] {\n  kind := if name == \"set\" {\n    \"Set\"\n  } else {\n    \"Dict\"\n  }\n  match vc.want {\n    Some((e, ast.Named { name: w, args })) => if Some(e) == arg0 && w == kind {\n      return Some(ast.Named { name: w, args })\n    },\n    _ => (),\n  }\n  id := match xs {\n    smt.VList { id, .. } => id,\n    _ => return None,\n  }\n  et := match smt.elem_type(vc, id) {\n    Some(t) => t,\n    None => match smt.list_info(vc, id).source {\n      smt.GValues(vs) => smt.val_type(vc, get(vs, 0)?)?,\n      _ => return None,\n    },\n  }\n  if kind == \"Set\" {\n    return Some(ast.Named { name: \"Set\", args: [et] })\n  }\n  match et {\n    ast.Named { name: \"Tuple\", args: [k, v] } => Some(ast.Named { name: \"Dict\", args: [k, v] }),\n    _ => None,\n  }\n}","old_text":"/// The type of the dict or set a `set` or `dict` call makes: the one the\n/// `let` it is bound to says (`Vc.want`), else its elements'.\nfn literal_type(\n  vc: smt.Vc,\n  name: String,\n  arg0: Option[ast.Expr],\n  xs: smt.Val,\n) -> Option[ast.TypeExpr] {\n  kind := if name == \"set\" {\n    \"Set\"\n  } else {\n    \"Dict\"\n  }\n  match vc.want {\n    Some((e, ast.Named { name: w, args })) => if Some(e) == arg0 && w == kind {\n      return Some(ast.Named { name: w, args })\n    },\n    _ => (),\n  }\n  id := match xs {\n    smt.VList { id, .. } => id,\n    _ => return None,\n  }\n  et := match smt.elem_type(vc, id) {\n    Some(t) => t,\n    None => match smt.list_info(vc, id).source {\n      smt.GValues(vs) => smt.val_type(vc, get(vs, 0)?)?,\n      _ => return None,\n    },\n  }\n  if kind == \"Set\" {\n    return Some(ast.Named { name: \"Set\", args: [et] })\n  }\n  match et {\n    ast.Named { name: \"Tuple\", args: [k, v] } => Some(ast.Named { name: \"Dict\", args: [k, v] }),\n    _ => None,\n  }\n}"},{"name":"smt.map_literal","kind":"fn","old":"61ccaec94ebefe49","new":"2bae7bec85714642","interface_changed":false,"affected":[],"module":"smt","text":"/// `set(xs)` and `dict(pairs)`. From a list literal, the array of its\n/// items. From another list, an array of at most its length (empty when\n/// the list is), whose items are the list's.\nfn map_literal(\n  mut vc: smt.Vc,\n  name: String,\n  arg0: Option[ast.Expr],\n  xs: smt.Val,\n) -> Option[smt.Val] {\n  t := smt.literal_type(vc, name, arg0, xs)?\n  ms := smt.map_sorts(mut vc, t)?\n  id := match xs {\n    smt.VList { id, .. } => id,\n    _ => return None,\n  }\n  match smt.list_info(vc, id).source {\n    smt.GValues(vs) => {\n      mut a := smt.map_empty(mut vc, t, ms)\n      for v in vs {\n        if ms.val == None {\n          a = smt.map_insert(mut vc, t, ms, a, v, None)\n        } else {\n          match smt.force(mut vc, v) {\n            smt.VTuple([k, x]) => {\n              a = smt.map_insert(mut vc, t, ms, a, k, Some(x))\n            },\n            _ => return None,\n          }\n        }\n      }\n      Some(smt.keyed_array(mut vc, t, ms, a))\n    },\n    _ => {\n      l := smt.list_len(mut vc, xs)\n      a := smt.fresh_why(\n        mut vc,\n        ms.arr,\n        f\"`{name}` of a list that is not a literal (only its size bounds are modelled)\",\n      )\n      size := f\"({ms.size} {a})\"\n      mut vc.facts.push(\n        f\"(and (<= 0 {size}) (<= {size} {l}) (= (= {size} 0) (= {l} 0)))\",\n      )\n      // its items are the list's\n      r := smt.new_list(mut vc, size, smt.GSub(id))\n      match r {\n        smt.VList { id: n, .. } => {\n          mut vc.keyed.insert(n, t)\n          mut vc.arrays.insert(n, a)\n        },\n        _ => (),\n      }\n      Some(r)\n    },\n  }\n}","old_text":"/// `set(xs)` and `dict(pairs)`: from a list literal, the array of its\n/// items; from another list, an array of at most its length (empty when it\n/// is), whose items are the list's.\nfn map_literal(\n  mut vc: smt.Vc,\n  name: String,\n  arg0: Option[ast.Expr],\n  xs: smt.Val,\n) -> Option[smt.Val] {\n  t := smt.literal_type(vc, name, arg0, xs)?\n  ms := smt.map_sorts(mut vc, t)?\n  id := match xs {\n    smt.VList { id, .. } => id,\n    _ => return None,\n  }\n  match smt.list_info(vc, id).source {\n    smt.GValues(vs) => {\n      mut a := smt.map_empty(mut vc, t, ms)\n      for v in vs {\n        if ms.val == None {\n          a = smt.map_insert(mut vc, t, ms, a, v, None)\n        } else {\n          match smt.force(mut vc, v) {\n            smt.VTuple([k, x]) => {\n              a = smt.map_insert(mut vc, t, ms, a, k, Some(x))\n            },\n            _ => return None,\n          }\n        }\n      }\n      Some(smt.keyed_array(mut vc, t, ms, a))\n    },\n    _ => {\n      l := smt.list_len(mut vc, xs)\n      a := smt.fresh_why(\n        mut vc,\n        ms.arr,\n        f\"`{name}` of a list that is not a literal (only its size bounds are modelled)\",\n      )\n      size := f\"({ms.size} {a})\"\n      mut vc.facts.push(\n        f\"(and (<= 0 {size}) (<= {size} {l}) (= (= {size} 0) (= {l} 0)))\",\n      )\n      // its items are the list's\n      r := smt.new_list(mut vc, size, smt.GSub(id))\n      match r {\n        smt.VList { id: n, .. } => {\n          mut vc.keyed.insert(n, t)\n          mut vc.arrays.insert(n, a)\n        },\n        _ => (),\n      }\n      Some(r)\n    },\n  }\n}"},{"name":"smt.map_op","kind":"fn","old":"2e3025efebcd2413","new":"adc44f041d513ec7","interface_changed":false,"affected":[],"module":"smt","text":"/// The builtins on a dict or set with an array (`map_sorts`): `len`,\n/// `contains`, `get`, `insert`, `remove`, `items`, `union`,\n/// `intersection`, `difference`. `None` for another call.\nfn map_op(mut vc: smt.Vc, name: String, a: List[smt.Val]) -> Option[smt.Val] {\n  n := len(a)\n  (arr, t, ms) := smt.map_of(mut vc, get(a, 0)?)?\n  size := f\"({ms.size} {arr})\"\n  is_dict := ms.val != None\n  if name == \"len\" && n == 1 {\n    return Some(smt.VInt(size))\n  }\n  if name == \"contains\" && n == 2 {\n    (kt, h) := smt.map_key(mut vc, ms, arr, get(a, 1)?)\n    smt.map_read(mut vc, arr, t, kt)\n    return Some(smt.VBool(h))\n  }\n  if name == \"get\" && n == 2 && is_dict {\n    vt := ms.val?\n    (kt, h) := smt.map_key(mut vc, ms, arr, get(a, 1)?)\n    smt.map_read(mut vc, arr, t, kt)\n    sel := f\"(select {arr} {kt})\"\n    if smt.refined(vc, t) && smt.refined(vc, vt) {\n      x := smt.from_term(\n        mut vc,\n        vt,\n        smt.selector(smt.opt_ctor(vc, ms.rsort, \"Some\"), 0, sel),\n      )\n      ok := smt.check_type(mut vc, vt, x, [])\n      valid := smt.valid_term(mut vc, t, arr)\n      fact := smt.implies(smt.and_all([valid, h]), ok)\n      smt.define(mut vc, fact, fact)\n    }\n    return Some(smt.from_term(\n      mut vc,\n      ast.Named { name: \"Option\", args: [vt] },\n      sel,\n    ))\n  }\n  if name == \"insert\" && (is_dict && n == 3 || !is_dict && n == 2) {\n    x := if is_dict {\n      get(a, 2)\n    } else {\n      None\n    }\n    a2 := smt.map_insert(mut vc, t, ms, arr, get(a, 1)?, x)\n    return Some(smt.keyed_array(mut vc, t, ms, a2))\n  }\n  if name == \"remove\" && n == 2 {\n    (kt, h) := smt.map_key(mut vc, ms, arr, get(a, 1)?)\n    gone := if is_dict {\n      smt.sym(smt.opt_ctor(vc, ms.rsort, \"None\"))\n    } else {\n      \"false\"\n    }\n    a2 := smt.map_store(mut vc, t, ms, arr, kt, h, gone, false, [])\n    return Some(smt.keyed_array(mut vc, t, ms, a2))\n  }\n  if (name == \"items\" && is_dict || name == \"to_list\" && !is_dict)\n    && n == 1 {\n    // the dict's entries\n    match get(a, 0)? {\n      smt.VList { id, .. } => return Some(smt.new_list(mut vc, size, smt.GSub(id))),\n      _ => (),\n    }\n  }\n  if (name == \"union\"\n      || name == \"intersection\"\n      || name == \"difference\")\n    && n == 2\n    && !is_dict {\n    (b, _, ms2) := smt.map_of(mut vc, get(a, 1)?)?\n    if ms2.arr != ms.arr {\n      return None\n    }\n    sb := f\"({ms.size} {b})\"\n    (c, bounds) := if name == \"union\" {\n      (\n        f\"((_ map or) {arr} {b})\",\n        [\n          f\"(>= @ {size})\",\n          f\"(>= @ {sb})\",\n          f\"(<= @ (+ {size} {sb}))\",\n        ],\n      )\n    } else if name == \"intersection\" {\n      (\n        f\"((_ map and) {arr} {b})\",\n        [f\"(<= @ {size})\", f\"(<= @ {sb})\"],\n      )\n    } else {\n      (\n        f\"((_ map and) {arr} ((_ map not) {b}))\",\n        [f\"(<= @ {size})\", f\"(>= @ (- {size} {sb}))\"],\n      )\n    }\n    a2 := smt.share(mut vc, ms.arr, c)\n    s2 := f\"({ms.size} {a2})\"\n    for f in bounds {\n      mut vc.facts.push(replace(f, \"@\", s2))\n    }\n    if smt.refined(vc, t) {\n      mut vc.facts.push(\n        smt.implies(smt.and_all([\n          smt.valid_term(mut vc, t, arr),\n          smt.valid_term(mut vc, t, b),\n        ]), smt.valid_term(mut vc, t, a2)),\n      )\n    }\n    return Some(smt.keyed_array(mut vc, t, ms, a2))\n  }\n  None\n}","old_text":"/// The builtins on a dict or set with an array (`map_sorts`): `len`,\n/// `contains`, `get`, `insert`, `remove`, `items`, `union`, `intersection`,\n/// `difference`; `None` for another call.\nfn map_op(mut vc: smt.Vc, name: String, a: List[smt.Val]) -> Option[smt.Val] {\n  n := len(a)\n  (arr, t, ms) := smt.map_of(mut vc, get(a, 0)?)?\n  size := f\"({ms.size} {arr})\"\n  is_dict := ms.val != None\n  if name == \"len\" && n == 1 {\n    return Some(smt.VInt(size))\n  }\n  if name == \"contains\" && n == 2 {\n    (kt, h) := smt.map_key(mut vc, ms, arr, get(a, 1)?)\n    smt.map_read(mut vc, arr, t, kt)\n    return Some(smt.VBool(h))\n  }\n  if name == \"get\" && n == 2 && is_dict {\n    vt := ms.val?\n    (kt, h) := smt.map_key(mut vc, ms, arr, get(a, 1)?)\n    smt.map_read(mut vc, arr, t, kt)\n    sel := f\"(select {arr} {kt})\"\n    if smt.refined(vc, t) && smt.refined(vc, vt) {\n      x := smt.from_term(\n        mut vc,\n        vt,\n        smt.selector(smt.opt_ctor(vc, ms.rsort, \"Some\"), 0, sel),\n      )\n      ok := smt.check_type(mut vc, vt, x, [])\n      valid := smt.valid_term(mut vc, t, arr)\n      fact := smt.implies(smt.and_all([valid, h]), ok)\n      smt.define(mut vc, fact, fact)\n    }\n    return Some(smt.from_term(\n      mut vc,\n      ast.Named { name: \"Option\", args: [vt] },\n      sel,\n    ))\n  }\n  if name == \"insert\" && (is_dict && n == 3 || !is_dict && n == 2) {\n    x := if is_dict {\n      get(a, 2)\n    } else {\n      None\n    }\n    a2 := smt.map_insert(mut vc, t, ms, arr, get(a, 1)?, x)\n    return Some(smt.keyed_array(mut vc, t, ms, a2))\n  }\n  if name == \"remove\" && n == 2 {\n    (kt, h) := smt.map_key(mut vc, ms, arr, get(a, 1)?)\n    gone := if is_dict {\n      smt.sym(smt.opt_ctor(vc, ms.rsort, \"None\"))\n    } else {\n      \"false\"\n    }\n    a2 := smt.map_store(mut vc, t, ms, arr, kt, h, gone, false, [])\n    return Some(smt.keyed_array(mut vc, t, ms, a2))\n  }\n  if (name == \"items\" && is_dict || name == \"to_list\" && !is_dict)\n    && n == 1 {\n    // the dict's entries\n    match get(a, 0)? {\n      smt.VList { id, .. } => return Some(smt.new_list(mut vc, size, smt.GSub(id))),\n      _ => (),\n    }\n  }\n  if (name == \"union\"\n      || name == \"intersection\"\n      || name == \"difference\")\n    && n == 2\n    && !is_dict {\n    (b, _, ms2) := smt.map_of(mut vc, get(a, 1)?)?\n    if ms2.arr != ms.arr {\n      return None\n    }\n    sb := f\"({ms.size} {b})\"\n    (c, bounds) := if name == \"union\" {\n      (\n        f\"((_ map or) {arr} {b})\",\n        [\n          f\"(>= @ {size})\",\n          f\"(>= @ {sb})\",\n          f\"(<= @ (+ {size} {sb}))\",\n        ],\n      )\n    } else if name == \"intersection\" {\n      (\n        f\"((_ map and) {arr} {b})\",\n        [f\"(<= @ {size})\", f\"(<= @ {sb})\"],\n      )\n    } else {\n      (\n        f\"((_ map and) {arr} ((_ map not) {b}))\",\n        [f\"(<= @ {size})\", f\"(>= @ (- {size} {sb}))\"],\n      )\n    }\n    a2 := smt.share(mut vc, ms.arr, c)\n    s2 := f\"({ms.size} {a2})\"\n    for f in bounds {\n      mut vc.facts.push(replace(f, \"@\", s2))\n    }\n    if smt.refined(vc, t) {\n      mut vc.facts.push(\n        smt.implies(smt.and_all([\n          smt.valid_term(mut vc, t, arr),\n          smt.valid_term(mut vc, t, b),\n        ]), smt.valid_term(mut vc, t, a2)),\n      )\n    }\n    return Some(smt.keyed_array(mut vc, t, ms, a2))\n  }\n  None\n}"},{"name":"smt.open_map","kind":"fn","old":"edee9661257a4933","new":"601666afcda78f06","interface_changed":false,"affected":[],"module":"smt","text":"/// `open_input` of a dict or set (list `id`, of size `n`, array `a`): its\n/// first entries, and that it is made of them when it has no more (a store\n/// of each on the empty array, with distinct keys).\nfn open_map(\n  mut vc: smt.Vc,\n  id: Int,\n  n: String,\n  a: String,\n  ms: smt.MapSorts,\n  depth: Int,\n  mut lens: List[String],\n  mut leaves: List[String],\n) {\n  gone := match ms.val {\n    Some(_) => smt.sym(smt.opt_ctor(vc, ms.rsort, \"None\")),\n    None => \"false\",\n  }\n  mut chain := f\"((as const {ms.arr}) {gone})\"\n  mut keys := []\n  mut xs := []\n  for k in 0..smt.input_len() {\n    if k > 0 {\n      mut vc.facts.push(f\"(=> (= {n} {k}) (= {a} {chain}))\")\n    }\n    key := smt.havoc(mut vc, ms.key)\n    kt := smt.term_of(mut vc, ms.key, key)\n    for other in keys {\n      mut vc.facts.push(f\"(=> (> {n} {k}) (not (= {kt} {other})))\")\n    }\n    mut keys.push(kt)\n    (entry, x) := match ms.val {\n      Some(vt) => {\n        v := smt.havoc(mut vc, vt)\n        (e, _) := smt.map_entry(mut vc, ms, Some(v))\n        (e, smt.VTuple([key, v]))\n      },\n      None => (\"true\", key),\n    }\n    chain = f\"(store {chain} {kt} {entry})\"\n    mut xs.push(x)\n  }\n  mut vc.facts.push(f\"(=> (= {n} {smt.input_len()}) (= {a} {chain}))\")\n  mut vc.input_elems.insert(id, xs)\n  for x in xs {\n    fx := smt.force(mut vc, x)\n    smt.open_input(mut vc, fx, depth + 1, mut lens, mut leaves)\n  }\n}","old_text":"/// `open_input` of a dict or set (list `id`, of size `n`, array `a`): its\n/// first entries, and that it is made of them when it has no more (a store\n/// of each on the empty array; distinct keys).\nfn open_map(\n  mut vc: smt.Vc,\n  id: Int,\n  n: String,\n  a: String,\n  ms: smt.MapSorts,\n  depth: Int,\n  mut lens: List[String],\n  mut leaves: List[String],\n) {\n  gone := match ms.val {\n    Some(_) => smt.sym(smt.opt_ctor(vc, ms.rsort, \"None\")),\n    None => \"false\",\n  }\n  mut chain := f\"((as const {ms.arr}) {gone})\"\n  mut keys := []\n  mut xs := []\n  for k in 0..smt.input_len() {\n    if k > 0 {\n      mut vc.facts.push(f\"(=> (= {n} {k}) (= {a} {chain}))\")\n    }\n    key := smt.havoc(mut vc, ms.key)\n    kt := smt.term_of(mut vc, ms.key, key)\n    for other in keys {\n      mut vc.facts.push(f\"(=> (> {n} {k}) (not (= {kt} {other})))\")\n    }\n    mut keys.push(kt)\n    (entry, x) := match ms.val {\n      Some(vt) => {\n        v := smt.havoc(mut vc, vt)\n        (e, _) := smt.map_entry(mut vc, ms, Some(v))\n        (e, smt.VTuple([key, v]))\n      },\n      None => (\"true\", key),\n    }\n    chain = f\"(store {chain} {kt} {entry})\"\n    mut xs.push(x)\n  }\n  mut vc.facts.push(f\"(=> (= {n} {smt.input_len()}) (= {a} {chain}))\")\n  mut vc.input_elems.insert(id, xs)\n  for x in xs {\n    fx := smt.force(mut vc, x)\n    smt.open_input(mut vc, fx, depth + 1, mut lens, mut leaves)\n  }\n}"},{"name":"smt.changed","kind":"fn","old":"0820536cf31ae10a","new":"878a90b43d1bbd7c","interface_changed":false,"affected":[],"module":"smt","text":"/// `mut p.m(args)` with `m` a builtin changing the list, dict or set `p`\n/// (value `pv`). The new value, made by the matching builtin\n/// (`changes_as`), is assigned to `p`. Returns the call's result.\nfn changed(\n  mut vc: smt.Vc,\n  p: ast.Expr,\n  pv: smt.Val,\n  m: String,\n  args: List[ast.Expr],\n) -> smt.Val {\n  kind := match smt.val_type(vc, pv) {\n    Some(ast.Named { name: \"Dict\", .. }) => \"Dict\",\n    Some(ast.Named { name: \"Set\", .. }) => \"Set\",\n    Some(_) => \"List\",\n    // only lists have these\n    None => if [\"push\", \"pop\", \"sort\", \"sort_by\", \"reverse\"].contains(m) {\n      \"List\"\n    } else {\n      \"\"\n    },\n  }\n  match builtins.changes_as(kind, p, m, args) {\n    Some(b) => smt.eval(mut vc, b),\n    None => {\n      for a in args {\n        _ := smt.eval(mut vc, a)\n      }\n      what := f\"`{m}` on a value whose type (list, dict or set) is not known\"\n      smt.gap(mut vc, what)\n      smt.assign(mut vc, p, smt.Opaque(what), \"changing\")\n      smt.Opaque(what)\n    },\n  }\n}","old_text":"/// `mut p.m(args)`, `m` a built-in changing the list, dict or set `p`\n/// (its value `pv`): the new value, made by the built-ins making new values\n/// (`changes_as`), assigned to `p`; the call's result.\nfn changed(\n  mut vc: smt.Vc,\n  p: ast.Expr,\n  pv: smt.Val,\n  m: String,\n  args: List[ast.Expr],\n) -> smt.Val {\n  kind := match smt.val_type(vc, pv) {\n    Some(ast.Named { name: \"Dict\", .. }) => \"Dict\",\n    Some(ast.Named { name: \"Set\", .. }) => \"Set\",\n    Some(_) => \"List\",\n    // (only lists have these)\n    None => if [\"push\", \"pop\", \"sort\", \"sort_by\", \"reverse\"].contains(m) {\n      \"List\"\n    } else {\n      \"\"\n    },\n  }\n  match builtins.changes_as(kind, p, m, args) {\n    Some(b) => smt.eval(mut vc, b),\n    None => {\n      for a in args {\n        _ := smt.eval(mut vc, a)\n      }\n      what := f\"`{m}` on a value whose type (list, dict or set) is not known\"\n      smt.gap(mut vc, what)\n      smt.assign(mut vc, p, smt.Opaque(what), \"changing\")\n      smt.Opaque(what)\n    },\n  }\n}"},{"name":"smt.receiver_term","kind":"fn","old":"b8c8b03816c3257f","new":"e9df83b04e3ff07b","interface_changed":false,"affected":[],"module":"smt","text":"/// A method of its receiver alone that doesn't change it (a trait model,\n/// `self.orders`; `self.total()`), seen through its contract on a receiver\n/// that is a term (a trait's value, a type parameter's). Its result is an\n/// uninterpreted function of that term, so the same receiver gives the\n/// same result however it was reached (the branches of an `if` joined,\n/// `old self` and `self` when nothing changed it). `None` for any other\n/// call.\nfn receiver_term(\n  mut vc: smt.Vc,\n  label: String,\n  f: ast.FnDecl,\n  args: List[smt.Val],\n  ret: ast.TypeExpr,\n) -> Option[smt.Val] {\n  (p, ty, t) := match (f.params, args) {\n    ([p], [smt.VData { ty, t }]) => (p, ty, t),\n    _ => return None,\n  }\n  if p.name != \"self\" || p.mutable || ret == ast.UnitType {\n    return None\n  }\n  a := smt.sort_of(mut vc, ty)?\n  r := smt.sort_of(mut vc, ret)?\n  n := smt.sym(\"of:\" + label + \"(\" + smt.bare(a) + \")\" + smt.bare(r))\n  if !vc.of_receiver.any(x -> x.0 == n) {\n    mut vc.of_receiver.push((n, a, r))\n  }\n  Some(smt.from_term(mut vc, ret, f\"({n} {t})\"))\n}","old_text":"/// A method of its receiver alone, which doesn't change it (a trait's\n/// model, `self.orders`; `self.total()`), seen through its contract on a\n/// receiver that is a term (a trait's value, a type parameter's): its\n/// result as an uninterpreted function of that term, so the same receiver\n/// gives the same result however it was reached (the branches of an `if`\n/// joined, `old self` and `self` when nothing changed it). `None` for any\n/// other call.\nfn receiver_term(\n  mut vc: smt.Vc,\n  label: String,\n  f: ast.FnDecl,\n  args: List[smt.Val],\n  ret: ast.TypeExpr,\n) -> Option[smt.Val] {\n  (p, ty, t) := match (f.params, args) {\n    ([p], [smt.VData { ty, t }]) => (p, ty, t),\n    _ => return None,\n  }\n  if p.name != \"self\" || p.mutable || ret == ast.UnitType {\n    return None\n  }\n  a := smt.sort_of(mut vc, ty)?\n  r := smt.sort_of(mut vc, ret)?\n  n := smt.sym(\"of:\" + label + \"(\" + smt.bare(a) + \")\" + smt.bare(r))\n  if !vc.of_receiver.any(x -> x.0 == n) {\n    mut vc.of_receiver.push((n, a, r))\n  }\n  Some(smt.from_term(mut vc, ret, f\"({n} {t})\"))\n}"},{"name":"smt.trait_invariants","kind":"fn","old":"38f9ab7c75d5a952","new":"d34e9a405f7fc3d9","interface_changed":false,"affected":[],"module":"smt","text":"/// The invariants of trait `t` (as a type: `Db`, `orders.Db`), if it is a\n/// trait that has some.\nfn trait_invariants(vc: smt.Vc, t: ast.TypeExpr) -> List[ast.Expr] {\n  name := match t {\n    ast.Named { name, args: [] } => name,\n    _ => return [],\n  }\n  if contains(vc.types, name) {\n    return []\n  }\n  parts := split(name, \".\")\n  last := get(parts, len(parts) - 1) ?? name\n  match vc.methods.traits.filter(x -> x.name == name || x.name == last) {\n    // its models read as its methods (`self.Db::orders()`), as\n    // `elaborate_call` reads calls\n    [tr, ..] => tr.invariants.map(\n      e ->\n        walk.rewrite_expr(\n          e,\n          x ->\n            match x {\n              ast.MethodCall { recv, name: m, args: [] } => if tr.models.any(d -> d.name == m) {\n                ast.MethodCall {\n                  recv,\n                  name: tr.name + \"::\" + m,\n                  args: [],\n                }\n              } else {\n                x\n              },\n              _ => x,\n            },\n        ),\n    ),\n    [] => [],\n  }\n}","old_text":"/// The invariants of trait `t` (as a type: `Db`, `orders.Db`), if it is\n/// one that has some.\nfn trait_invariants(vc: smt.Vc, t: ast.TypeExpr) -> List[ast.Expr] {\n  name := match t {\n    ast.Named { name, args: [] } => name,\n    _ => return [],\n  }\n  if contains(vc.types, name) {\n    return []\n  }\n  parts := split(name, \".\")\n  last := get(parts, len(parts) - 1) ?? name\n  match vc.methods.traits.filter(x -> x.name == name || x.name == last) {\n    // (its models read as its methods, `self.Db::orders()`, as\n    // `elaborate_call` reads calls)\n    [tr, ..] => tr.invariants.map(\n      e ->\n        walk.rewrite_expr(\n          e,\n          x ->\n            match x {\n              ast.MethodCall { recv, name: m, args: [] } => if tr.models.any(d -> d.name == m) {\n                ast.MethodCall {\n                  recv,\n                  name: tr.name + \"::\" + m,\n                  args: [],\n                }\n              } else {\n                x\n              },\n              _ => x,\n            },\n        ),\n    ),\n    [] => [],\n  }\n}"},{"name":"smt.same_lists","kind":"fn","old":"e289bedb0c985e6f","new":"df85310cfe5ab945","interface_changed":false,"affected":[],"module":"smt","text":"/// From here on, list `a`'s element at each position the code takes is\n/// list `b`'s there when `g` holds, including those already taken.\nfn same_lists(mut vc: smt.Vc, g: String, a: Int, b: Int) {\n  info := smt.list_info(vc, a)\n  smt.set_list(\n    mut vc,\n    a,\n    smt.ListInfo { ..info, same: info.same + [(g, b)] },\n  )\n  vc.in_same += 1\n  for (i, (x, _)) in items(info.at) {\n    if smt.has_qvar(i) {\n      // taken inside a quantified fact, at its variable\n      continue\n    }\n    match smt.element_at_inner(mut vc, b, i) {\n      Some(y) => {\n        e := smt.eq(mut vc, x, y)\n        mut vc.facts.push(smt.implies(g, e))\n      },\n      None => (),\n    }\n  }\n  vc.in_same -= 1\n}","old_text":"/// From now on, list `a`'s element at each position the code takes is list\n/// `b`'s there when `g` holds (and so for those already taken).\nfn same_lists(mut vc: smt.Vc, g: String, a: Int, b: Int) {\n  info := smt.list_info(vc, a)\n  smt.set_list(\n    mut vc,\n    a,\n    smt.ListInfo { ..info, same: info.same + [(g, b)] },\n  )\n  vc.in_same += 1\n  for (i, (x, _)) in items(info.at) {\n    if smt.has_qvar(i) {\n      // taken inside a quantified fact, at its variable\n      continue\n    }\n    match smt.element_at_inner(mut vc, b, i) {\n      Some(y) => {\n        e := smt.eq(mut vc, x, y)\n        mut vc.facts.push(smt.implies(g, e))\n      },\n      None => (),\n    }\n  }\n  vc.in_same -= 1\n}"},{"name":"smt.func_key","kind":"fn","old":"69f42df421fc4229","new":"14134a2948128f74","interface_changed":false,"affected":[],"module":"smt","text":"/// What identifies a function applied to a list's elements, to share a\n/// prefix-sum function between sums of the same mapping. `None`: nothing\n/// is shared.\nfn func_key(f: smt.Func) -> Option[String] {\n  match f {\n    smt.FNamed(n) => Some(n),\n    smt.FLambda { param, body, scopes } => {\n      mut key := param + \" -> \" + text.expr_text(body, 0)\n      for n in smt.var_names(body) {\n        if n != param {\n          mut found := false\n          mut k := len(scopes) - 1\n          while k >= 0 && !found {\n            match get(get(scopes, k) ?? Dict[String, smt.Val] {}, n) {\n              Some(v) => {\n                key += \" \" + n + \"=\" + debug(v)\n                found = true\n              },\n              None => (),\n            }\n            k -= 1\n          }\n        }\n      }\n      if contains(key, \"Opaque(\") {\n        None\n      } else {\n        Some(key)\n      }\n    },\n    _ => None,\n  }\n}","old_text":"/// What identifies a function applied to a list's elements, for sharing a\n/// prefix-sum function between sums of the same mapping (`None`: nothing\n/// is shared).\nfn func_key(f: smt.Func) -> Option[String] {\n  match f {\n    smt.FNamed(n) => Some(n),\n    smt.FLambda { param, body, scopes } => {\n      mut key := param + \" -> \" + text.expr_text(body, 0)\n      for n in smt.var_names(body) {\n        if n != param {\n          mut found := false\n          mut k := len(scopes) - 1\n          while k >= 0 && !found {\n            match get(get(scopes, k) ?? Dict[String, smt.Val] {}, n) {\n              Some(v) => {\n                key += \" \" + n + \"=\" + debug(v)\n                found = true\n              },\n              None => (),\n            }\n            k -= 1\n          }\n        }\n      }\n      if contains(key, \"Opaque(\") {\n        None\n      } else {\n        Some(key)\n      }\n    },\n    _ => None,\n  }\n}"},{"name":"smt.prefix_sum","kind":"fn","old":"d7d2e1d6f7aebd37","new":"2c552b2c602eedee","interface_changed":false,"affected":[],"module":"smt","text":"/// The sum of the first `k` elements of list `id`, each passed through `f`\n/// when given, as an Int term. It follows how the list was made:\n/// - a literal: its own elements;\n/// - a concatenation: the two parts, so a pushed element adds to the sum\n/// before;\n/// - a slice: the positions it takes in the list it is cut from\n/// (`sum(xs[..k]) + sum(xs[k..]) == sum(xs)`);\n/// - a `map`: its function; a merge: either branch's list;\n/// - any other list: a prefix-sum function of its own, 0 at 0. A sum is\n/// the difference of two of its values, so no quantifier is needed.\n/// `None` when an element isn't an Int.\nfn prefix_sum(\n  mut vc: smt.Vc,\n  id: Int,\n  k: String,\n  f: Option[smt.Func],\n) -> Option[String] {\n  info := smt.list_info(vc, id)\n  match info.source {\n    smt.GMap(p, g) => match f {\n      None => return smt.prefix_sum(mut vc, p, k, Some(g)),\n      Some(_) => (),\n    },\n    smt.GShift(p, off) => {\n      a := smt.prefix_sum(mut vc, p, f\"(+ {off} {k})\", f)?\n      b := smt.prefix_sum(mut vc, p, off, f)?\n      return Some(f\"(- {a} {b})\")\n    },\n    smt.GConcat(a, b, la) => {\n      x := smt.prefix_sum(mut vc, a, f\"(ite (< {k} {la}) {k} {la})\", f)?\n      y := smt.prefix_sum(\n        mut vc,\n        b,\n        f\"(ite (> {k} {la}) (- {k} {la}) 0)\",\n        f,\n      )?\n      return Some(f\"(+ {x} {y})\")\n    },\n    smt.GEither(c, a, b) => {\n      x := smt.prefix_sum(mut vc, a, k, f)?\n      y := smt.prefix_sum(mut vc, b, k, f)?\n      return Some(smt.ite(c, x, y))\n    },\n    smt.GValues(vs) => if len(vs) <= 16 {\n      mut parts := [\"0\"]\n      for (t, v) in enumerate(vs) {\n        e := match f {\n          Some(g) => smt.apply(mut vc, g, v),\n          None => v,\n        }\n        x := match e {\n          smt.VInt(x) => x,\n          _ => return None,\n        }\n        mut parts.push(f\"(ite (< {t} {k}) {x} 0)\")\n      }\n      return Some(\"(+ \" + join(parts, \" \") + \")\")\n    },\n    _ => (),\n  }\n  // a list of its own: its prefix-sum function. Not for a list inside an\n  // element, whose sums would be functions of the outer positions too.\n  if len(info.outer) > 0 {\n    return None\n  }\n  key := match f {\n    None => Some(f\"{id}\"),\n    Some(g) => match smt.func_key(g) {\n      Some(fk) => Some(f\"{id}|{fk}\"),\n      None => None,\n    },\n  }\n  ps := match key {\n    Some(kk) => match get(vc.sum_fns, kk) {\n      Some(ps) => ps,\n      None => {\n        ps := smt.new_sum_fn(mut vc)\n        if len(vc.regions) == 0 {\n          mut vc.sum_fns.insert(kk, ps)\n        }\n        ps\n      },\n    },\n    None => smt.new_sum_fn(mut vc),\n  }\n  // a parameter's first elements, for a counterexample to show: their sums\n  // (set aside with them in `example_facts`)\n  match (get(vc.input_elems, id), get(vc.input_lens, id)) {\n    (Some(xs), Some(n)) => if vc.examples {\n      nf := len(vc.facts)\n      mut steps := []\n      for (t, x) in enumerate(xs) {\n        e := match f {\n          Some(g) => smt.apply(mut vc, g, x),\n          None => x,\n        }\n        match e {\n          smt.VInt(et) => mut steps.push(\n            f\"(=> (> {n} {t}) (= ({ps} {t + 1}) (+ ({ps} {t}) {et})))\",\n          ),\n          _ => (),\n        }\n      }\n      vc.example_facts = vc.example_facts + drop(vc.facts, nf) + steps\n      vc.facts = take(vc.facts, nf)\n    },\n    _ => (),\n  }\n  Some(f\"({ps} {k})\")\n}","old_text":"/// The sum of the first `k` elements of list `id`, each passed through `f`\n/// first when one is given, as an Int term. It follows how the list was\n/// made: a literal's own elements, the two parts of a concatenation (so a\n/// pushed element is added to the sum before), the positions a slice takes\n/// in the list it is cut from (`sum(xs[..k]) + sum(xs[k..]) == sum(xs)`),\n/// a `map`'s function, either branch's list; any other list has a\n/// prefix-sum function of its own, 0 at 0 (no quantifier: a sum is the\n/// difference of two of its values). `None` when an element isn't an Int.\nfn prefix_sum(\n  mut vc: smt.Vc,\n  id: Int,\n  k: String,\n  f: Option[smt.Func],\n) -> Option[String] {\n  info := smt.list_info(vc, id)\n  match info.source {\n    smt.GMap(p, g) => match f {\n      None => return smt.prefix_sum(mut vc, p, k, Some(g)),\n      Some(_) => (),\n    },\n    smt.GShift(p, off) => {\n      a := smt.prefix_sum(mut vc, p, f\"(+ {off} {k})\", f)?\n      b := smt.prefix_sum(mut vc, p, off, f)?\n      return Some(f\"(- {a} {b})\")\n    },\n    smt.GConcat(a, b, la) => {\n      x := smt.prefix_sum(mut vc, a, f\"(ite (< {k} {la}) {k} {la})\", f)?\n      y := smt.prefix_sum(\n        mut vc,\n        b,\n        f\"(ite (> {k} {la}) (- {k} {la}) 0)\",\n        f,\n      )?\n      return Some(f\"(+ {x} {y})\")\n    },\n    smt.GEither(c, a, b) => {\n      x := smt.prefix_sum(mut vc, a, k, f)?\n      y := smt.prefix_sum(mut vc, b, k, f)?\n      return Some(smt.ite(c, x, y))\n    },\n    smt.GValues(vs) => if len(vs) <= 16 {\n      mut parts := [\"0\"]\n      for (t, v) in enumerate(vs) {\n        e := match f {\n          Some(g) => smt.apply(mut vc, g, v),\n          None => v,\n        }\n        x := match e {\n          smt.VInt(x) => x,\n          _ => return None,\n        }\n        mut parts.push(f\"(ite (< {t} {k}) {x} 0)\")\n      }\n      return Some(\"(+ \" + join(parts, \" \") + \")\")\n    },\n    _ => (),\n  }\n  // a list of its own: its prefix-sum function (not for a list inside an\n  // element, whose sums would be functions of the outer positions too)\n  if len(info.outer) > 0 {\n    return None\n  }\n  key := match f {\n    None => Some(f\"{id}\"),\n    Some(g) => match smt.func_key(g) {\n      Some(fk) => Some(f\"{id}|{fk}\"),\n      None => None,\n    },\n  }\n  ps := match key {\n    Some(kk) => match get(vc.sum_fns, kk) {\n      Some(ps) => ps,\n      None => {\n        ps := smt.new_sum_fn(mut vc)\n        if len(vc.regions) == 0 {\n          mut vc.sum_fns.insert(kk, ps)\n        }\n        ps\n      },\n    },\n    None => smt.new_sum_fn(mut vc),\n  }\n  // a parameter's first elements, for a counterexample to show: the sums\n  // of theirs (set aside with them, `example_facts`)\n  match (get(vc.input_elems, id), get(vc.input_lens, id)) {\n    (Some(xs), Some(n)) => if vc.examples {\n      nf := len(vc.facts)\n      mut steps := []\n      for (t, x) in enumerate(xs) {\n        e := match f {\n          Some(g) => smt.apply(mut vc, g, x),\n          None => x,\n        }\n        match e {\n          smt.VInt(et) => mut steps.push(\n            f\"(=> (> {n} {t}) (= ({ps} {t + 1}) (+ ({ps} {t}) {et})))\",\n          ),\n          _ => (),\n        }\n      }\n      vc.example_facts = vc.example_facts + drop(vc.facts, nf) + steps\n      vc.facts = take(vc.facts, nf)\n    },\n    _ => (),\n  }\n  Some(f\"({ps} {k})\")\n}"},{"name":"smt.added_to","kind":"fn","old":"0b7e15c5c39e7f9a","new":"8573e98ea4cb36c7","interface_changed":false,"affected":[],"module":"smt","text":"/// `body` without `+ acc` (`acc + e` or `e + acc`, `acc` not in `e`): the\n/// term a `fold` adds up.\nfn added_to(body: ast.Expr, acc: String) -> Option[ast.Expr] {\n  match body {\n    ast.Binary { op: ast.Add, left, right } => match (left, right) {\n      (ast.Var(a), r) => if a == acc && !contains(smt.var_names(r), acc) {\n        Some(r)\n      } else {\n        match r {\n          ast.Var(b) => if b == acc && !contains(smt.var_names(left), acc) {\n            Some(left)\n          } else {\n            None\n          },\n          _ => None,\n        }\n      },\n      (l, ast.Var(b)) => if b == acc && !contains(smt.var_names(l), acc) {\n        Some(l)\n      } else {\n        None\n      },\n      _ => None,\n    },\n    ast.Block { stmts: [], last } => smt.added_to(last, acc),\n    _ => None,\n  }\n}","old_text":"/// `e` once `+ acc` is taken off (`acc + e` or `e + acc`, `acc` not in\n/// `e`): the term a `fold` adds up.\nfn added_to(body: ast.Expr, acc: String) -> Option[ast.Expr] {\n  match body {\n    ast.Binary { op: ast.Add, left, right } => match (left, right) {\n      (ast.Var(a), r) => if a == acc && !contains(smt.var_names(r), acc) {\n        Some(r)\n      } else {\n        match r {\n          ast.Var(b) => if b == acc && !contains(smt.var_names(left), acc) {\n            Some(left)\n          } else {\n            None\n          },\n          _ => None,\n        }\n      },\n      (l, ast.Var(b)) => if b == acc && !contains(smt.var_names(l), acc) {\n        Some(l)\n      } else {\n        None\n      },\n      _ => None,\n    },\n    ast.Block { stmts: [], last } => smt.added_to(last, acc),\n    _ => None,\n  }\n}"},{"name":"smt.list_sum","kind":"fn","old":"3c0bc5f2173c56d3","new":"2a831527dbea7795","interface_changed":false,"affected":[],"module":"smt","text":"/// The sum of list `v`'s elements (each through `f` when given), with what\n/// bounds on them give: 0 for an empty list, at least 0 when no element is\n/// negative, at least its length when each is at least 1, and at most its\n/// length times `m` when a fact about every element bounds each by `m`\n/// (likewise for a lower bound). `None` when an element isn't an Int.\nfn list_sum(mut vc: smt.Vc, v: smt.Val, f: Option[smt.Func]) -> Option[String] {\n  (id, ln) := match v {\n    smt.VList { id, len } => (id, len),\n    _ => return None,\n  }\n  if contains(vc.keyed, id) {\n    return None\n  }\n  s := smt.prefix_sum(mut vc, id, ln, f)?\n  total := smt.share(mut vc, \"Int\", s)\n  mut vc.facts.push(f\"(=> (= {ln} 0) (= {total} 0))\")\n  // the elements' signs, as `every` proves them of any element\n  for (lo, bound) in [(0, \"0\"), (1, ln)] {\n    atleast := smt.FLambda {\n      param: \"$e\",\n      body: ast.Binary { op: ast.GreaterEq, left: match f {\n        Some(smt.FLambda { param, body, .. }) => ast.Block { stmts: [ast.Let {\n          pat: ast.Bind(param),\n          ty: None,\n          value: ast.Var(\"$e\"),\n        }], last: body },\n        _ => ast.Var(\"$e\"),\n      }, right: ast.IntLit(lo) },\n      scopes: match f {\n        Some(smt.FLambda { scopes, .. }) => scopes,\n        _ => vc.scopes,\n      },\n    }\n    match f {\n      Some(smt.FNamed(_)) | Some(smt.FValid(_)) | Some(smt.FNot(_)) => (),\n      _ => match smt.every(mut vc, id, ln, Some(atleast)).0 {\n        Some(q) => mut vc.facts.push(f\"(=> {q} (>= {total} {bound}))\"),\n        None => (),\n      },\n    }\n  }\n  // what is known of every element (`all(xs, x -> x <= m)`): `m` for each\n  plain := match f {\n    None => true,\n    _ => false,\n  }\n  if plain {\n    for (g, p) in smt.list_info(vc, id).preds {\n      match p {\n        smt.FLambda { param, body: ast.Binary { op, left: ast.Var(x), right }, scopes } => if x == param\n          && !contains(smt.var_names(right), param)\n          && (op == ast.LessEq || op == ast.GreaterEq) {\n          saved := vc.scopes\n          vc.scopes = scopes\n          vc.spec += 1\n          mv := smt.eval(mut vc, right)\n          vc.spec -= 1\n          vc.scopes = saved\n          match mv {\n            smt.VInt(m) => {\n              cmp := if op == ast.LessEq {\n                \"<=\"\n              } else {\n                \">=\"\n              }\n              mut vc.facts.push(\n                f\"(=> {g} ({cmp} {total} (* {ln} {m})))\",\n              )\n            },\n            _ => (),\n          }\n        },\n        _ => (),\n      }\n    }\n  }\n  Some(total)\n}","old_text":"/// The sum of list `v`'s elements (each passed through `f` when given),\n/// with what bounds on them give: 0 for an empty list, at least 0 when no\n/// element is negative, at least its length when each is at least 1, at\n/// most its length times `m` when a fact about every element says each is\n/// at most `m` (and at least, for at least). `None` when an element isn't\n/// an Int.\nfn list_sum(mut vc: smt.Vc, v: smt.Val, f: Option[smt.Func]) -> Option[String] {\n  (id, ln) := match v {\n    smt.VList { id, len } => (id, len),\n    _ => return None,\n  }\n  if contains(vc.keyed, id) {\n    return None\n  }\n  s := smt.prefix_sum(mut vc, id, ln, f)?\n  total := smt.share(mut vc, \"Int\", s)\n  mut vc.facts.push(f\"(=> (= {ln} 0) (= {total} 0))\")\n  // the elements' signs, as `every` proves them of any element\n  for (lo, bound) in [(0, \"0\"), (1, ln)] {\n    atleast := smt.FLambda {\n      param: \"$e\",\n      body: ast.Binary { op: ast.GreaterEq, left: match f {\n        Some(smt.FLambda { param, body, .. }) => ast.Block { stmts: [ast.Let {\n          pat: ast.Bind(param),\n          ty: None,\n          value: ast.Var(\"$e\"),\n        }], last: body },\n        _ => ast.Var(\"$e\"),\n      }, right: ast.IntLit(lo) },\n      scopes: match f {\n        Some(smt.FLambda { scopes, .. }) => scopes,\n        _ => vc.scopes,\n      },\n    }\n    match f {\n      Some(smt.FNamed(_)) | Some(smt.FValid(_)) | Some(smt.FNot(_)) => (),\n      _ => match smt.every(mut vc, id, ln, Some(atleast)).0 {\n        Some(q) => mut vc.facts.push(f\"(=> {q} (>= {total} {bound}))\"),\n        None => (),\n      },\n    }\n  }\n  // what is known of every element (`all(xs, x -> x <= m)`): `m` for each\n  plain := match f {\n    None => true,\n    _ => false,\n  }\n  if plain {\n    for (g, p) in smt.list_info(vc, id).preds {\n      match p {\n        smt.FLambda { param, body: ast.Binary { op, left: ast.Var(x), right }, scopes } => if x == param\n          && !contains(smt.var_names(right), param)\n          && (op == ast.LessEq || op == ast.GreaterEq) {\n          saved := vc.scopes\n          vc.scopes = scopes\n          vc.spec += 1\n          mv := smt.eval(mut vc, right)\n          vc.spec -= 1\n          vc.scopes = saved\n          match mv {\n            smt.VInt(m) => {\n              cmp := if op == ast.LessEq {\n                \"<=\"\n              } else {\n                \">=\"\n              }\n              mut vc.facts.push(\n                f\"(=> {g} ({cmp} {total} (* {ln} {m})))\",\n              )\n            },\n            _ => (),\n          }\n        },\n        _ => (),\n      }\n    }\n  }\n  Some(total)\n}"},{"name":"smt.rec_call","kind":"fn","old":"106a1510bdf1b997","new":"78d1b465014822b5","interface_changed":false,"affected":[],"module":"smt","text":"/// A call, in a contract, of a recursive function that calls only itself,\n/// finishes and can't otherwise fail. It becomes an SMT function of its\n/// arguments (one per function and sorts). Its defining equation (the\n/// body, recursive calls as applications of the same function, unfolded\n/// to `max_unfolding` levels) and its contract are stated at this use. The\n/// same arguments give the same result wherever it is called.\nfn rec_call(\n  mut vc: smt.Vc,\n  name: String,\n  f: ast.FnDecl,\n  args: List[smt.Val],\n) -> Option[smt.Val] {\n  sub := smt.type_args_at(vc, f, args)\n  at_types := (t: ast.TypeExpr) -> match sub {\n    Some(s) => smt.subst(t, s),\n    None => t,\n  }\n  ret := at_types(f.ret)\n  mut terms := []\n  mut sorts := []\n  for (i, p) in enumerate(f.params) {\n    a := get(args, i)?\n    pt := at_types(p.ty)\n    s := smt.field_sort(mut vc, pt)\n    // a term of another sort (an uninstantiated generic callee's result):\n    // by its contract only\n    match a {\n      smt.VData { ty: vt, .. } => if smt.sort_of(mut vc, vt) != Some(s) {\n        return None\n      },\n      _ => (),\n    }\n    mut sorts.push(s)\n    mut terms.push(smt.term_of(mut vc, pt, a))\n  }\n  rs := smt.field_sort(mut vc, ret)\n  r := \"rec:\" + name + \"(\" + replace(join(sorts, \",\"), \"|\", \"\") + \")\"\n  mut vc.rec_fns.insert(r, (sorts, rs))\n  app := if len(terms) == 0 {\n    smt.sym(r)\n  } else {\n    \"(\" + smt.sym(r) + \" \" + join(terms, \" \") + \")\"\n  }\n  // unfolded no further: the call gives its contract (and what the\n  // unfoldings above said of the function), a reason a proof may fail\n  cut := vc.unfolding >= smt.max_unfolding()\n  res := if cut {\n    k := smt.fresh_why(\n      mut vc,\n      rs,\n      f\"the result of `{smt.shown_name(name)}` (only its contract is known)\",\n    )\n    mut vc.facts.push(f\"(= {k} {app})\")\n    smt.from_term(mut vc, ret, k)\n  } else {\n    smt.from_term(mut vc, ret, app)\n  }\n  binds := zip(f.params.map(p -> p.name), args)\n  if !cut {\n    vc.unfolding += 1\n    vc.depth += 1\n    vc.spec += 1\n    saved := vc.scopes\n    vc.scopes = [dict(binds)]\n    dead := vc.dead\n    returns := vc.returns\n    vc.returns = []\n    body := smt.eval(mut vc, f.body)\n    vc.returns = returns\n    vc.dead = dead\n    vc.scopes = saved\n    e := smt.eq(mut vc, res, body)\n    smt.assume(mut vc, e)\n    vc.spec -= 1\n    vc.depth -= 1\n    vc.unfolding -= 1\n  }\n  // its result type and `ensures` hold of it\n  vc.depth += 1\n  vc.spec += 1\n  c := smt.check_type(mut vc, ret, res, binds)\n  smt.assume(mut vc, c)\n  for en in f.post {\n    c2 := smt.pred_old(mut vc, en, binds + [(\"it\", res)], Some(binds))\n    smt.assume(mut vc, c2)\n  }\n  vc.spec -= 1\n  vc.depth -= 1\n  Some(res)\n}","old_text":"/// A call, in a contract, of a recursive function that calls only itself,\n/// finishes and can't otherwise fail: an SMT function of its arguments\n/// (one per function and sorts), whose defining equation (its body, with\n/// the recursive calls in it applications of the same function, unfolded\n/// in turn to `max_unfolding` levels) and contract are stated at this use;\n/// the same arguments give the same result wherever it is called.\nfn rec_call(\n  mut vc: smt.Vc,\n  name: String,\n  f: ast.FnDecl,\n  args: List[smt.Val],\n) -> Option[smt.Val] {\n  sub := smt.type_args_at(vc, f, args)\n  at_types := (t: ast.TypeExpr) -> match sub {\n    Some(s) => smt.subst(t, s),\n    None => t,\n  }\n  ret := at_types(f.ret)\n  mut terms := []\n  mut sorts := []\n  for (i, p) in enumerate(f.params) {\n    a := get(args, i)?\n    pt := at_types(p.ty)\n    s := smt.field_sort(mut vc, pt)\n    // a term of another sort (a generic callee's result not instantiated):\n    // by its contract only\n    match a {\n      smt.VData { ty: vt, .. } => if smt.sort_of(mut vc, vt) != Some(s) {\n        return None\n      },\n      _ => (),\n    }\n    mut sorts.push(s)\n    mut terms.push(smt.term_of(mut vc, pt, a))\n  }\n  rs := smt.field_sort(mut vc, ret)\n  r := \"rec:\" + name + \"(\" + replace(join(sorts, \",\"), \"|\", \"\") + \")\"\n  mut vc.rec_fns.insert(r, (sorts, rs))\n  app := if len(terms) == 0 {\n    smt.sym(r)\n  } else {\n    \"(\" + smt.sym(r) + \" \" + join(terms, \" \") + \")\"\n  }\n  // unfolded no further: what the call gives is its contract (and what the\n  // unfoldings above said of the function), the reason a proof may lack\n  cut := vc.unfolding >= smt.max_unfolding()\n  res := if cut {\n    k := smt.fresh_why(\n      mut vc,\n      rs,\n      f\"the result of `{smt.shown_name(name)}` (only its contract is known)\",\n    )\n    mut vc.facts.push(f\"(= {k} {app})\")\n    smt.from_term(mut vc, ret, k)\n  } else {\n    smt.from_term(mut vc, ret, app)\n  }\n  binds := zip(f.params.map(p -> p.name), args)\n  if !cut {\n    vc.unfolding += 1\n    vc.depth += 1\n    vc.spec += 1\n    saved := vc.scopes\n    vc.scopes = [dict(binds)]\n    dead := vc.dead\n    returns := vc.returns\n    vc.returns = []\n    body := smt.eval(mut vc, f.body)\n    vc.returns = returns\n    vc.dead = dead\n    vc.scopes = saved\n    e := smt.eq(mut vc, res, body)\n    smt.assume(mut vc, e)\n    vc.spec -= 1\n    vc.depth -= 1\n    vc.unfolding -= 1\n  }\n  // its result type and `ensures` hold of it\n  vc.depth += 1\n  vc.spec += 1\n  c := smt.check_type(mut vc, ret, res, binds)\n  smt.assume(mut vc, c)\n  for en in f.post {\n    c2 := smt.pred_old(mut vc, en, binds + [(\"it\", res)], Some(binds))\n    smt.assume(mut vc, c2)\n  }\n  vc.spec -= 1\n  vc.depth -= 1\n  Some(res)\n}"},{"name":"smt.shared_receiver","kind":"fn","old":"e427df6e6e539d2d","new":"41fd32ebb468b3c4","interface_changed":false,"affected":[],"module":"smt","text":"/// The arguments of a call of method `d` (`name` as called) on a value of a\n/// `shared` trait (`q: Queue`, used by many workers at once). The receiver\n/// is any value the trait's invariants allow, written back to where it was\n/// read (`q`), since another worker may have acted on it since this code\n/// last did. So what a call's `ensures` say of its models lasts only until\n/// the next call on it; its result keeps its facts. Unchanged for any\n/// other call: in a contract, on a value of a type implementing the trait\n/// (whose code runs alone), or on an implementation's own field (`self.db`,\n/// whose method is one step, see `shared_race`).\nfn shared_receiver(\n  mut vc: smt.Vc,\n  name: String,\n  d: ast.FnDecl,\n  arg_exprs: List[ast.Expr],\n  args: List[smt.Val],\n) -> List[smt.Val] {\n  if vc.spec > 0 || !smt.takes_self(d) {\n    return args\n  }\n  tr := match split(name, \"::\") {\n    [t, _] => t,\n    _ => match vc.methods.traits.filter(\n      t -> t.methods.any(x -> x.decl.name == d.name),\n    ) {\n      [t] => t.name,\n      _ => return args,\n    },\n  }\n  shared := vc.methods.traits.any(\n    t -> t.shared && (t.name == tr || ends_with(tr, \".\" + t.name)),\n  )\n  if !shared {\n    return args\n  }\n  a := match get(args, 0) {\n    Some(smt.VData { .. }) => get(args, 0) ?? smt.UnitVal,\n    _ => return args,\n  }\n  if smt.implementation(vc, tr + \"::\" + d.name, args) is Some {\n    return args\n  }\n  recv := match get(arg_exprs, 0) {\n    Some(ast.MutExpr(x)) => x,\n    Some(x) => x,\n    None => return args,\n  }\n  match recv {\n    ast.FieldOf { base: ast.Var(\"self\"), .. } => return args,\n    _ => (),\n  }\n  saved := vc.reason\n  vc.reason = Some(\n    f\"`{text.expr_text(recv, 0)}` when `{d.name}` is called: `{smt.last_part_of(tr)}` is shared, so another worker may have changed it since the last call (only the trait's invariants are known)\",\n  )\n  nv := smt.refresh(mut vc, a)\n  vc.reason = saved\n  c := smt.check_type(mut vc, ast.Named { name: tr, args: [] }, nv, [])\n  smt.assume(mut vc, c)\n  smt.assign(mut vc, recv, nv, \"another worker's call\")\n  [nv] + drop(args, 1)\n}","old_text":"/// The arguments of a call of method `d` (`name` as called) on a value of a\n/// `shared` trait (`q: Queue`, many workers using it at once): the receiver\n/// is any value the trait's invariants allow, written back to where it was\n/// read (`q`), since another worker may have acted on it since this code\n/// last did. So what a call's `ensures` say of its models lasts only until\n/// the next call on it; its result keeps its facts. Unchanged for any other\n/// call, in a contract, on a value of a type that implements the trait\n/// (whose code runs alone), and for an implementation's own field\n/// (`self.db`: its method is one step, see `shared_race`).\nfn shared_receiver(\n  mut vc: smt.Vc,\n  name: String,\n  d: ast.FnDecl,\n  arg_exprs: List[ast.Expr],\n  args: List[smt.Val],\n) -> List[smt.Val] {\n  if vc.spec > 0 || !smt.takes_self(d) {\n    return args\n  }\n  tr := match split(name, \"::\") {\n    [t, _] => t,\n    _ => match vc.methods.traits.filter(\n      t -> t.methods.any(x -> x.decl.name == d.name),\n    ) {\n      [t] => t.name,\n      _ => return args,\n    },\n  }\n  shared := vc.methods.traits.any(\n    t -> t.shared && (t.name == tr || ends_with(tr, \".\" + t.name)),\n  )\n  if !shared {\n    return args\n  }\n  a := match get(args, 0) {\n    Some(smt.VData { .. }) => get(args, 0) ?? smt.UnitVal,\n    _ => return args,\n  }\n  if smt.implementation(vc, tr + \"::\" + d.name, args) is Some {\n    return args\n  }\n  recv := match get(arg_exprs, 0) {\n    Some(ast.MutExpr(x)) => x,\n    Some(x) => x,\n    None => return args,\n  }\n  match recv {\n    ast.FieldOf { base: ast.Var(\"self\"), .. } => return args,\n    _ => (),\n  }\n  saved := vc.reason\n  vc.reason = Some(\n    f\"`{text.expr_text(recv, 0)}` when `{d.name}` is called: `{smt.last_part_of(tr)}` is shared, so another worker may have changed it since the last call (only the trait's invariants are known)\",\n  )\n  nv := smt.refresh(mut vc, a)\n  vc.reason = saved\n  c := smt.check_type(mut vc, ast.Named { name: tr, args: [] }, nv, [])\n  smt.assume(mut vc, c)\n  smt.assign(mut vc, recv, nv, \"another worker's call\")\n  [nv] + drop(args, 1)\n}"},{"name":"smt.last_part_of","kind":"fn","old":"af7637e160e0fa20","new":"39f5a641cce4fcea","interface_changed":false,"affected":[],"module":"smt","text":"/// The last part of a dotted name: `Db` for `orders.Db`.\nfn last_part_of(name: String) -> String {\n  parts := split(name, \".\")\n  get(parts, len(parts) - 1) ?? name\n}","old_text":"/// The last part of a dotted name (`orders.Db` is `Db`).\nfn last_part_of(name: String) -> String {\n  parts := split(name, \".\")\n  get(parts, len(parts) - 1) ?? name\n}"},{"name":"smt.alias_lists","kind":"fn","old":"8e3278e4d7969975","new":"8c270c0fdb281a8c","interface_changed":false,"affected":[],"module":"smt","text":"/// Makes the lists inside `v` (made of their type's values, a parameter's)\n/// the sequences of `u`, the term `v` was made into, with the elements\n/// taken by position so far equal to theirs. A value read back (from a\n/// dict, or a datatype holding it) is then the same list, not merely one\n/// of the same length.\nfn alias_lists(mut vc: smt.Vc, u: smt.Val, v: smt.Val, depth: Int) {\n  if depth > 3 {\n    return\n  }\n  match (u, v) {\n    (smt.VList { len: lu, id: iu }, smt.VList { len: lv, id: iv }) => match smt.list_info(vc, iu).source {\n      smt.GSeq(s, t, n) => {\n        info := smt.list_info(vc, iv)\n        typed := match info.source {\n          smt.GType(_) => true,\n          _ => false,\n        }\n        blank := match info.source {\n          smt.GType(_) | smt.Untracked => true,\n          _ => false,\n        }\n        if blank\n          && iv != iu\n          && get(vc.arrays, iv) == None\n          && get(vc.keyed, iv) == None {\n          smt.set_list(\n            mut vc,\n            iv,\n            smt.ListInfo { ..info, source: smt.GSeq(s, t, n), positional: true },\n          )\n          smt.assume(mut vc, f\"(= {lv} {lu})\")\n          if typed {\n            ok := smt.valid_term(\n              mut vc,\n              ast.Named { name: \"List\", args: [t] },\n              s,\n            )\n            smt.assume(mut vc, ok)\n          }\n          // the elements already taken by position are the sequence's\n          for (k, (x, _)) in items(info.at) {\n            y := smt.from_term(mut vc, t, smt.seq_at(n, s, k))\n            e := smt.eq(mut vc, x, y)\n            smt.assume(mut vc, smt.implies(f\"(< {k} {lv})\", e))\n          }\n        }\n      },\n      _ => (),\n    },\n    (smt.VData { .. }, _) => {\n      fu := smt.force(mut vc, u)\n      if fu != u {\n        smt.alias_lists(mut vc, fu, v, depth + 1)\n      }\n    },\n    (smt.VRec { fields: xs, .. }, smt.VRec { fields: ys, .. }) => {\n      for (i, x) in enumerate(xs) {\n        smt.alias_lists(\n          mut vc,\n          x.1,\n          (get(ys, i) ?? (\"\", smt.Inactive)).1,\n          depth,\n        )\n      }\n    },\n    (smt.VTuple(xs), smt.VTuple(ys)) => {\n      for (i, x) in enumerate(xs) {\n        smt.alias_lists(\n          mut vc,\n          x,\n          get(ys, i) ?? smt.Inactive,\n          depth,\n        )\n      }\n    },\n    (smt.VDistinct { inner: x, .. }, smt.VDistinct { inner: y, .. }) => smt.alias_lists(mut vc, x, y, depth),\n    (smt.VSum { ctors: c1, .. }, smt.VSum { ctors: c2, .. }) => {\n      for (k, c) in enumerate(c1) {\n        ys := (get(c2, k) ?? (\"\", [])).1\n        for (i, p) in enumerate(c.1) {\n          smt.alias_lists(\n            mut vc,\n            p,\n            get(ys, i) ?? smt.Inactive,\n            depth,\n          )\n        }\n      }\n    },\n    _ => (),\n  }\n}","old_text":"/// The lists inside `v`, a value made into a term whose value is `u`, made\n/// of their type's values (a parameter's) become `u`'s sequences, the\n/// elements taken by position so far equal to theirs: the value read back\n/// (from a dict, or a datatype holding it) is then the same list, not one\n/// only as long.\nfn alias_lists(mut vc: smt.Vc, u: smt.Val, v: smt.Val, depth: Int) {\n  if depth > 3 {\n    return\n  }\n  match (u, v) {\n    (smt.VList { len: lu, id: iu }, smt.VList { len: lv, id: iv }) => match smt.list_info(vc, iu).source {\n      smt.GSeq(s, t, n) => {\n        info := smt.list_info(vc, iv)\n        typed := match info.source {\n          smt.GType(_) => true,\n          _ => false,\n        }\n        blank := match info.source {\n          smt.GType(_) | smt.Untracked => true,\n          _ => false,\n        }\n        if blank\n          && iv != iu\n          && get(vc.arrays, iv) == None\n          && get(vc.keyed, iv) == None {\n          smt.set_list(\n            mut vc,\n            iv,\n            smt.ListInfo { ..info, source: smt.GSeq(s, t, n), positional: true },\n          )\n          smt.assume(mut vc, f\"(= {lv} {lu})\")\n          if typed {\n            ok := smt.valid_term(\n              mut vc,\n              ast.Named { name: \"List\", args: [t] },\n              s,\n            )\n            smt.assume(mut vc, ok)\n          }\n          // the elements already taken by position are the sequence's\n          for (k, (x, _)) in items(info.at) {\n            y := smt.from_term(mut vc, t, smt.seq_at(n, s, k))\n            e := smt.eq(mut vc, x, y)\n            smt.assume(mut vc, smt.implies(f\"(< {k} {lv})\", e))\n          }\n        }\n      },\n      _ => (),\n    },\n    (smt.VData { .. }, _) => {\n      fu := smt.force(mut vc, u)\n      if fu != u {\n        smt.alias_lists(mut vc, fu, v, depth + 1)\n      }\n    },\n    (smt.VRec { fields: xs, .. }, smt.VRec { fields: ys, .. }) => {\n      for (i, x) in enumerate(xs) {\n        smt.alias_lists(\n          mut vc,\n          x.1,\n          (get(ys, i) ?? (\"\", smt.Inactive)).1,\n          depth,\n        )\n      }\n    },\n    (smt.VTuple(xs), smt.VTuple(ys)) => {\n      for (i, x) in enumerate(xs) {\n        smt.alias_lists(\n          mut vc,\n          x,\n          get(ys, i) ?? smt.Inactive,\n          depth,\n        )\n      }\n    },\n    (smt.VDistinct { inner: x, .. }, smt.VDistinct { inner: y, .. }) => smt.alias_lists(mut vc, x, y, depth),\n    (smt.VSum { ctors: c1, .. }, smt.VSum { ctors: c2, .. }) => {\n      for (k, c) in enumerate(c1) {\n        ys := (get(c2, k) ?? (\"\", [])).1\n        for (i, p) in enumerate(c.1) {\n          smt.alias_lists(\n            mut vc,\n            p,\n            get(ys, i) ?? smt.Inactive,\n            depth,\n          )\n        }\n      }\n    },\n    _ => (),\n  }\n}"},{"name":"smt.same_def","kind":"fn","old":"78d8ad0706b28639","new":"aecceac97038be13","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether two names of a definition name the same one, one perhaps\n/// qualified by its module (`Queue`, `model.Queue`). A package's impls\n/// name their trait and type qualified, a call elaborated as `Trait::m`\n/// doesn't.\nfn same_def(a: String, b: String) -> Bool {\n  a == b || ends_with(a, \".\" + b) || ends_with(b, \".\" + a)\n}","old_text":"/// Whether two names of a definition name the same one, one of them\n/// perhaps qualified by its module (`Queue`, `model.Queue`): a package's\n/// impls name their trait and type qualified, a call elaborated as\n/// `Trait::m` doesn't.\nfn same_def(a: String, b: String) -> Bool {\n  a == b || ends_with(a, \".\" + b) || ends_with(b, \".\" + a)\n}"},{"name":"smt.MapAll","kind":"type","old":"102c169bca751a56","new":"44f74e6bbec13172","interface_changed":false,"affected":[],"module":"smt","text":"/// A fact about every entry of a dict (or item of a set) when `guard`\n/// holds: `all(d.items(), f)` assumed. It is stated at each key the code\n/// reads in the dict's array (`map_read`), before or after: a quantifier\n/// over the keys, instantiated where used and never written.\ntype MapAll = { arr: String, guard: String, f: smt.Func, ty: ast.TypeExpr }","old_text":"/// A fact about every entry of a dict (or item of a set), known when\n/// `guard` holds: `all(d.items(), f)` assumed. It is stated at each key the\n/// code reads in the dict's array (`map_read`), before or after: a\n/// quantifier over the keys, instantiated where it is used, never written.\ntype MapAll = { arr: String, guard: String, f: smt.Func, ty: ast.TypeExpr }"},{"name":"smt.MapRead","kind":"type","old":"3a49143de6e70165","new":"86f280dcf50fb15a","interface_changed":false,"affected":[],"module":"smt","text":"/// A key read in a dict's or set's array (`get`, `contains`) outside any\n/// quantifier: where the facts about every entry are stated.\ntype MapRead = { arr: String, key: String, ty: ast.TypeExpr }","old_text":"/// A key read in a dict's or set's array (`get`, `contains`), outside any\n/// quantifier: where the facts about every entry are stated.\ntype MapRead = { arr: String, key: String, ty: ast.TypeExpr }"},{"name":"smt.know_map_all","kind":"fn","old":"38e1bb22710bff55","new":"5f9a2f095c5d90c5","interface_changed":false,"affected":[],"module":"smt","text":"/// `f` of every entry of the dict list `id` holds when `guard` does. When\n/// `id` is a dict's `items` (or a set's `to_list`), it is stated at every\n/// key read in its array, both those read so far and those read later.\nfn know_map_all(mut vc: smt.Vc, id: Int, guard: String, f: smt.Func) {\n  if vc.binding > 0 || vc.map_inst > 0 {\n    return\n  }\n  src := match smt.list_info(vc, id).source {\n    smt.GSub(s) => s,\n    _ => return,\n  }\n  arr := match get(vc.arrays, src) {\n    Some(a) => a,\n    None => return,\n  }\n  ty := match get(vc.keyed, src) {\n    Some(t) => t,\n    None => return,\n  }\n  mut vc.map_alls.push(smt.MapAll { arr, guard, f, ty })\n  for r in vc.map_reads {\n    if r.arr == arr {\n      smt.map_instance(mut vc, r.arr, r.ty, r.key, guard, f)\n    }\n  }\n}","old_text":"/// `f` of every entry of the dict list `id` holds when `guard` does: when\n/// `id` is a dict's `items` (or a set's `to_list`), stated at every key read\n/// in its array, those read so far and those read later.\nfn know_map_all(mut vc: smt.Vc, id: Int, guard: String, f: smt.Func) {\n  if vc.binding > 0 || vc.map_inst > 0 {\n    return\n  }\n  src := match smt.list_info(vc, id).source {\n    smt.GSub(s) => s,\n    _ => return,\n  }\n  arr := match get(vc.arrays, src) {\n    Some(a) => a,\n    None => return,\n  }\n  ty := match get(vc.keyed, src) {\n    Some(t) => t,\n    None => return,\n  }\n  mut vc.map_alls.push(smt.MapAll { arr, guard, f, ty })\n  for r in vc.map_reads {\n    if r.arr == arr {\n      smt.map_instance(mut vc, r.arr, r.ty, r.key, guard, f)\n    }\n  }\n}"},{"name":"smt.map_read","kind":"fn","old":"d056570a8349ffd1","new":"3d5004c5ec530bdc","interface_changed":false,"affected":[],"module":"smt","text":"/// Key `key` read in array `arr` of a dict or set of type `ty`: states what\n/// is known of every entry for this one.\nfn map_read(mut vc: smt.Vc, arr: String, ty: ast.TypeExpr, key: String) {\n  if vc.map_inst > 0 {\n    return\n  }\n  if vc.binding == 0 {\n    mut vc.map_reads.push(smt.MapRead { arr, key, ty })\n  }\n  for m in vc.map_alls {\n    if m.arr == arr {\n      smt.map_instance(mut vc, arr, ty, key, m.guard, m.f)\n    }\n  }\n  // and in the array it was stored from: the same key's entry there, which\n  // is this one's unless it is the key stored\n  match get(vc.map_from, arr) {\n    Some(base) => smt.map_read(mut vc, base, ty, key),\n    None => (),\n  }\n}","old_text":"/// Key `key` read in array `arr` of a dict or set of type `ty`: what is\n/// known of every entry, stated of this one.\nfn map_read(mut vc: smt.Vc, arr: String, ty: ast.TypeExpr, key: String) {\n  if vc.map_inst > 0 {\n    return\n  }\n  if vc.binding == 0 {\n    mut vc.map_reads.push(smt.MapRead { arr, key, ty })\n  }\n  for m in vc.map_alls {\n    if m.arr == arr {\n      smt.map_instance(mut vc, arr, ty, key, m.guard, m.f)\n    }\n  }\n  // (and in the array it was stored from: the same key's entry there,\n  // which is this one's unless it is the key stored)\n  match get(vc.map_from, arr) {\n    Some(base) => smt.map_read(mut vc, base, ty, key),\n    None => (),\n  }\n}"},{"name":"smt.map_instance","kind":"fn","old":"bf6bde08d3081509","new":"65f8bd2065a6cf0b","interface_changed":false,"affected":[],"module":"smt","text":"/// \"`guard` and key `key` in array `arr` imply `f` of its entry\".\nfn map_instance(\n  mut vc: smt.Vc,\n  arr: String,\n  ty: ast.TypeExpr,\n  key: String,\n  guard: String,\n  f: smt.Func,\n) {\n  ms := match smt.map_sorts(mut vc, ty) {\n    Some(ms) => ms,\n    None => return,\n  }\n  vc.map_inst += 1\n  k := match ms.ksort {\n    \"Int\" => smt.VInt(key),\n    \"String\" => smt.VStr(key),\n    \"Bool\" => smt.VBool(key),\n    _ => smt.from_term(mut vc, ms.key, key),\n  }\n  x := match ms.val {\n    Some(vt) => smt.VTuple([k, smt.from_term(mut vc, vt, smt.selector(\n      smt.opt_ctor(vc, ms.rsort, \"Some\"),\n      0,\n      f\"(select {arr} {key})\",\n    ))]),\n    None => k,\n  }\n  pol := vc.polarity\n  vc.polarity = 1\n  pv := smt.apply(mut vc, f, x)\n  vc.polarity = pol\n  p := smt.as_bool(mut vc, pv)\n  vc.map_inst -= 1\n  h := smt.has_term(vc, ms, arr, key)\n  mut vc.facts.push(smt.implies(smt.and_all([guard, h]), p))\n}","old_text":"/// `guard` and key `key` in array `arr` imply `f` of its entry.\nfn map_instance(\n  mut vc: smt.Vc,\n  arr: String,\n  ty: ast.TypeExpr,\n  key: String,\n  guard: String,\n  f: smt.Func,\n) {\n  ms := match smt.map_sorts(mut vc, ty) {\n    Some(ms) => ms,\n    None => return,\n  }\n  vc.map_inst += 1\n  k := match ms.ksort {\n    \"Int\" => smt.VInt(key),\n    \"String\" => smt.VStr(key),\n    \"Bool\" => smt.VBool(key),\n    _ => smt.from_term(mut vc, ms.key, key),\n  }\n  x := match ms.val {\n    Some(vt) => smt.VTuple([k, smt.from_term(mut vc, vt, smt.selector(\n      smt.opt_ctor(vc, ms.rsort, \"Some\"),\n      0,\n      f\"(select {arr} {key})\",\n    ))]),\n    None => k,\n  }\n  pol := vc.polarity\n  vc.polarity = 1\n  pv := smt.apply(mut vc, f, x)\n  vc.polarity = pol\n  p := smt.as_bool(mut vc, pv)\n  vc.map_inst -= 1\n  h := smt.has_term(vc, ms, arr, key)\n  mut vc.facts.push(smt.implies(smt.and_all([guard, h]), p))\n}"},{"name":"smt.old_scopes","kind":"fn","old":"822a509e34bae1c3","new":"b0584687349cb088","interface_changed":false,"affected":[],"module":"smt","text":"/// The scopes `old e` is evaluated in: the values before (`before`), plus\n/// what the contract itself bound (`Some(j) => old self.jobs.with(id, j)`:\n/// a name of `saved` that is not one of them).\nfn old_scopes(\n  before: Dict[String, smt.Val],\n  saved: List[Dict[String, smt.Val]],\n) -> List[Dict[String, smt.Val]] {\n  mut own := Dict[String, smt.Val] {}\n  for s in saved {\n    for (k, v) in items(s) {\n      if !contains(before, k) && k != \"it\" {\n        mut own.insert(k, v)\n      }\n    }\n  }\n  [before, own]\n}","old_text":"/// The scopes `old e` is evaluated in: the values before (`before`), and\n/// what the contract itself bound (`Some(j) => old self.jobs.with(id, j)`:\n/// a name of `saved` that is not one of them).\nfn old_scopes(\n  before: Dict[String, smt.Val],\n  saved: List[Dict[String, smt.Val]],\n) -> List[Dict[String, smt.Val]] {\n  mut own := Dict[String, smt.Val] {}\n  for s in saved {\n    for (k, v) in items(s) {\n      if !contains(before, k) && k != \"it\" {\n        mut own.insert(k, v)\n      }\n    }\n  }\n  [before, own]\n}"},{"name":"smt.member_of","kind":"fn","old":"ad749a9295926ce5","new":"eedb4f9a2027d7b8","interface_changed":false,"affected":[],"module":"smt","text":"/// \"Equals `x`\" as a function of a list element (`contains(xs, x)` is\n/// `any(xs, y -> y == x)`).\nfn member_of(vc: smt.Vc, x: smt.Val) -> smt.Func {\n  smt.FLambda { param: \"contains_y\", body: ast.Binary {\n    op: ast.Equal,\n    left: ast.Var(\"contains_y\"),\n    right: ast.Var(\"contains_x\"),\n  }, scopes: vc.scopes + [dict([(\"contains_x\", x)])] }\n}","old_text":"/// \"Equals `x`\", as a function of a list's element (`contains(xs, x)` is\n/// `any(xs, y -> y == x)`).\nfn member_of(vc: smt.Vc, x: smt.Val) -> smt.Func {\n  smt.FLambda { param: \"contains_y\", body: ast.Binary {\n    op: ast.Equal,\n    left: ast.Var(\"contains_y\"),\n    right: ast.Var(\"contains_x\"),\n  }, scopes: vc.scopes + [dict([(\"contains_x\", x)])] }\n}"},{"name":"smt.unrefined","kind":"fn","old":"a21d8154a259df23","new":"d52bb9551f4138cb","interface_changed":false,"affected":[],"module":"smt","text":"/// A list type without its refinements (`List[T]` of a refined `List[T]\n/// where …` or of a named alias of one). Any other type as it is.\nfn unrefined(vc: smt.Vc, t: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Refined { base, .. } => smt.unrefined(vc, base),\n    ast.Named { name, args } => if name == \"List\" {\n      t\n    } else {\n      match get(vc.types, name) {\n        Some(td) => match td.body {\n          ast.Alias(a) => if td.distinct {\n            t\n          } else {\n            smt.unrefined(vc, smt.subst(a, smt.params_of(td, args)))\n          },\n          _ => t,\n        },\n        None => t,\n      }\n    },\n    _ => t,\n  }\n}","old_text":"/// A type without its refinements, when it is a list (`List[T]` of a\n/// refined `List[T] where …` or of a named alias of one); else itself.\nfn unrefined(vc: smt.Vc, t: ast.TypeExpr) -> ast.TypeExpr {\n  match t {\n    ast.Refined { base, .. } => smt.unrefined(vc, base),\n    ast.Named { name, args } => if name == \"List\" {\n      t\n    } else {\n      match get(vc.types, name) {\n        Some(td) => match td.body {\n          ast.Alias(a) => if td.distinct {\n            t\n          } else {\n            smt.unrefined(vc, smt.subst(a, smt.params_of(td, args)))\n          },\n          _ => t,\n        },\n        None => t,\n      }\n    },\n    _ => t,\n  }\n}"},{"name":"smt.infers_over_list","kind":"fn","old":"e782f54a0efbf307","new":"c8f31c0d492d0d19","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether a `for` over a list runs as an index loop with inferred\n/// invariants: when an `ensures` names the returned variable, the loop\n/// changes it, and no invariant is written. Otherwise what the loop changes\n/// is any value of its type, plus its written invariants.\nfn infers_over_list(vc: smt.Vc, body: ast.Expr) -> Bool {\n  if vc.trial > 0\n    || vc.spec > 0\n    || vc.dead\n    || text.loop_invariants(body) != [] {\n    return false\n  }\n  changed := smt.changed_vars(vc, body)\n  // not when an `ensures` calls a function: its body is copied into every\n  // candidate and every pass, which made the search take minutes on\n  // examples/tasks\n  vc.hints.any(h -> contains(changed, h.1))\n    && vc.hints.all(h -> smt.calls_of(vc, h.0) == [])\n}","old_text":"/// Whether a `for` over a list is run as an index loop whose invariants are\n/// inferred: when an `ensures` names the variable returned and the loop\n/// changes it, and no invariant is written (else, as before, what it changes\n/// is any value of its type, and its written invariants).\nfn infers_over_list(vc: smt.Vc, body: ast.Expr) -> Bool {\n  if vc.trial > 0\n    || vc.spec > 0\n    || vc.dead\n    || text.loop_invariants(body) != [] {\n    return false\n  }\n  changed := smt.changed_vars(vc, body)\n  // (not yet when an `ensures` calls a function: its body is copied into\n  // every candidate and every pass, which made the search take minutes on\n  // examples/tasks; once helpers are stated once per query, they can be)\n  vc.hints.any(h -> contains(changed, h.1))\n    && vc.hints.all(h -> smt.calls_of(vc, h.0) == [])\n}"}]}
{"id":"d3ea9fc44dae61c0","time":1795634388,"message":"edit","changes":[{"name":"smt.pattern","kind":"fn","old":"d433c439d4d52a39","new":"14d8a23d907148a8","interface_changed":false,"affected":[],"module":"smt","text":"// ---- patterns ----\n\n/// The condition for `v` to match `p`. The bindings it makes are added to\n/// `binds`.\nfn pattern(\n  mut vc: smt.Vc,\n  p: ast.Pattern,\n  v: smt.Val,\n  mut binds: List[(String, smt.Val)],\n) -> String {\n  match (v, p) {\n    (smt.VData { .. }, ast.Bind(_)) | (smt.VData { .. }, ast.Wild) => (),\n    (smt.VData { .. }, _) => {\n      fv := smt.force(mut vc, v)\n      return smt.pattern(mut vc, p, fv, mut binds)\n    },\n    _ => (),\n  }\n  named_type := smt.pattern_type(vc, p)\n  match v {\n    smt.VUnion { tag, slots } => if named_type == None {\n      match smt.pattern_key(vc, p) {\n        // a literal, tuple, list or constructor pattern takes the member of\n        // its shape\n        Some(k) => {\n          i := smt.live_slot(slots, k)\n          if i < 0 {\n            // no member has that shape: it never matches, but its names are\n            // bound all the same\n            _ := smt.pattern(\n              mut vc,\n              p,\n              smt.Opaque(\"a pattern no member of the union matches\"),\n              mut binds,\n            )\n            return \"false\"\n          }\n          c := smt.pattern(\n            mut vc,\n            p,\n            (get(slots, i) ?? (\"\", smt.Inactive)).1,\n            mut binds,\n          )\n          return smt.and_all([f\"(= {tag} {i})\", c])\n        },\n        None => (),\n      }\n    },\n    _ => (),\n  }\n  match named_type {\n    // a pattern naming a type (`Positive =>`): the value is one of it\n    Some(t) => return smt.in_type(mut vc, t, v, []),\n    None => (),\n  }\n  match p {\n    ast.ForPat { .. } => \"false\",\n    ast.CondPat(c) => {\n      // `where …`: evaluated with `it` and what is in scope\n      mut vc.scopes.push(dict([(\"it\", v)]))\n      vc.spec += 1\n      b := smt.eval(mut vc, c)\n      vc.spec -= 1\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      smt.as_bool(mut vc, b)\n    },\n    ast.OrPat(alts) => {\n      // the first alternative that matches gives the bindings\n      mut conds := []\n      mut per := []\n      for a in alts {\n        mut b := []\n        mut conds.push(smt.pattern(mut vc, a, v, mut b))\n        mut per.push(b)\n      }\n      for (name, _) in get(per, 0) ?? [] {\n        mut val := smt.Inactive\n        mut first := true\n        mut k := len(conds) - 1\n        while k >= 0 {\n          here := match (get(per, k) ?? []).filter(x -> x.0 == name) {\n            [x, ..] => x.1,\n            _ => smt.Opaque(\"a binding of an or-pattern\"),\n          }\n          val = if first {\n            here\n          } else {\n            smt.merge(mut vc, get(conds, k) ?? \"true\", here, val)\n          }\n          first = false\n          k -= 1\n        }\n        mut binds.push((name, val))\n      }\n      smt.or_all(conds)\n    },\n    ast.Wild => \"true\",\n    ast.Bind(x) => {\n      mut binds.push((x, v))\n      \"true\"\n    },\n    ast.IntPat(n) => f\"(= {smt.as_int(mut vc, v)} {smt.num(n)})\",\n    ast.BoolPat(b) => {\n      t := smt.as_bool(mut vc, v)\n      if b {\n        t\n      } else {\n        smt.neg(t)\n      }\n    },\n    ast.StrPat(s) => if smt.smt_string(s) {\n      f\"(= {smt.as_str(mut vc, v)} {smt.str_lit(s)})\"\n    } else {\n      smt.unknown_bool(mut vc, smt.beyond())\n    },\n    ast.TuplePat(ps) => {\n      mut cs := []\n      match v {\n        smt.VTuple(xs) => if len(xs) == len(ps) {\n          for (i, q) in enumerate(ps) {\n            mut cs.push(\n              smt.pattern(\n                mut vc,\n                q,\n                get(xs, i) ?? smt.Inactive,\n                mut binds,\n              ),\n            )\n          }\n          return smt.and_all(cs)\n        },\n        _ => (),\n      }\n      for q in ps {\n        mut cs.push(\n          smt.pattern(\n            mut vc,\n            q,\n            smt.Opaque(\"a tuple of an unknown shape\"),\n            mut binds,\n          ),\n        )\n      }\n      smt.and_all(cs)\n    },\n    ast.ListPat { items, rest } => {\n      l := smt.list_len(mut vc, v)\n      id := smt.list_id(mut vc, v)\n      n := len(items)\n      mut cs := [match rest {\n        Some(_) => f\"(>= {l} {n})\",\n        None => f\"(= {l} {n})\",\n      }]\n      for (i, q) in enumerate(items) {\n        // the i-th element exists when the list is long enough\n        exists := f\"(> {l} {i})\"\n        x := smt.element_at(mut vc, id, f\"{i}\", exists) ?? smt.element(mut vc, id, exists)\n        mut cs.push(smt.pattern(mut vc, q, x, mut binds))\n      }\n      match rest {\n        Some(r) => mut binds.push(\n          (r, smt.new_list(\n            mut vc,\n            f\"(- {l} {n})\",\n            smt.GShift(id, f\"{n}\"),\n          )),\n        ),\n        None => (),\n      }\n      smt.and_all(cs)\n    },\n    ast.CtorPattern { name: c, args: cp } => smt.ctor_pattern(mut vc, c, cp, v, mut binds),\n  }\n}","old_text":"// ---- calls ----\n\n/// The condition for `v` to match `p`. The bindings it makes are added to\n/// `binds`.\nfn pattern(\n  mut vc: smt.Vc,\n  p: ast.Pattern,\n  v: smt.Val,\n  mut binds: List[(String, smt.Val)],\n) -> String {\n  match (v, p) {\n    (smt.VData { .. }, ast.Bind(_)) | (smt.VData { .. }, ast.Wild) => (),\n    (smt.VData { .. }, _) => {\n      fv := smt.force(mut vc, v)\n      return smt.pattern(mut vc, p, fv, mut binds)\n    },\n    _ => (),\n  }\n  named_type := smt.pattern_type(vc, p)\n  match v {\n    smt.VUnion { tag, slots } => if named_type == None {\n      match smt.pattern_key(vc, p) {\n        // a literal, tuple, list or constructor pattern takes the member of\n        // its shape\n        Some(k) => {\n          i := smt.live_slot(slots, k)\n          if i < 0 {\n            // no member has that shape: it never matches, but its names are\n            // bound all the same\n            _ := smt.pattern(\n              mut vc,\n              p,\n              smt.Opaque(\"a pattern no member of the union matches\"),\n              mut binds,\n            )\n            return \"false\"\n          }\n          c := smt.pattern(\n            mut vc,\n            p,\n            (get(slots, i) ?? (\"\", smt.Inactive)).1,\n            mut binds,\n          )\n          return smt.and_all([f\"(= {tag} {i})\", c])\n        },\n        None => (),\n      }\n    },\n    _ => (),\n  }\n  match named_type {\n    // a pattern naming a type (`Positive =>`): the value is one of it\n    Some(t) => return smt.in_type(mut vc, t, v, []),\n    None => (),\n  }\n  match p {\n    ast.ForPat { .. } => \"false\",\n    ast.CondPat(c) => {\n      // `where …`: evaluated with `it` and what is in scope\n      mut vc.scopes.push(dict([(\"it\", v)]))\n      vc.spec += 1\n      b := smt.eval(mut vc, c)\n      vc.spec -= 1\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      smt.as_bool(mut vc, b)\n    },\n    ast.OrPat(alts) => {\n      // the first alternative that matches gives the bindings\n      mut conds := []\n      mut per := []\n      for a in alts {\n        mut b := []\n        mut conds.push(smt.pattern(mut vc, a, v, mut b))\n        mut per.push(b)\n      }\n      for (name, _) in get(per, 0) ?? [] {\n        mut val := smt.Inactive\n        mut first := true\n        mut k := len(conds) - 1\n        while k >= 0 {\n          here := match (get(per, k) ?? []).filter(x -> x.0 == name) {\n            [x, ..] => x.1,\n            _ => smt.Opaque(\"a binding of an or-pattern\"),\n          }\n          val = if first {\n            here\n          } else {\n            smt.merge(mut vc, get(conds, k) ?? \"true\", here, val)\n          }\n          first = false\n          k -= 1\n        }\n        mut binds.push((name, val))\n      }\n      smt.or_all(conds)\n    },\n    ast.Wild => \"true\",\n    ast.Bind(x) => {\n      mut binds.push((x, v))\n      \"true\"\n    },\n    ast.IntPat(n) => f\"(= {smt.as_int(mut vc, v)} {smt.num(n)})\",\n    ast.BoolPat(b) => {\n      t := smt.as_bool(mut vc, v)\n      if b {\n        t\n      } else {\n        smt.neg(t)\n      }\n    },\n    ast.StrPat(s) => if smt.smt_string(s) {\n      f\"(= {smt.as_str(mut vc, v)} {smt.str_lit(s)})\"\n    } else {\n      smt.unknown_bool(mut vc, smt.beyond())\n    },\n    ast.TuplePat(ps) => {\n      mut cs := []\n      match v {\n        smt.VTuple(xs) => if len(xs) == len(ps) {\n          for (i, q) in enumerate(ps) {\n            mut cs.push(\n              smt.pattern(\n                mut vc,\n                q,\n                get(xs, i) ?? smt.Inactive,\n                mut binds,\n              ),\n            )\n          }\n          return smt.and_all(cs)\n        },\n        _ => (),\n      }\n      for q in ps {\n        mut cs.push(\n          smt.pattern(\n            mut vc,\n            q,\n            smt.Opaque(\"a tuple of an unknown shape\"),\n            mut binds,\n          ),\n        )\n      }\n      smt.and_all(cs)\n    },\n    ast.ListPat { items, rest } => {\n      l := smt.list_len(mut vc, v)\n      id := smt.list_id(mut vc, v)\n      n := len(items)\n      mut cs := [match rest {\n        Some(_) => f\"(>= {l} {n})\",\n        None => f\"(= {l} {n})\",\n      }]\n      for (i, q) in enumerate(items) {\n        // the i-th element exists when the list is long enough\n        exists := f\"(> {l} {i})\"\n        x := smt.element_at(mut vc, id, f\"{i}\", exists) ?? smt.element(mut vc, id, exists)\n        mut cs.push(smt.pattern(mut vc, q, x, mut binds))\n      }\n      match rest {\n        Some(r) => mut binds.push(\n          (r, smt.new_list(\n            mut vc,\n            f\"(- {l} {n})\",\n            smt.GShift(id, f\"{n}\"),\n          )),\n        ),\n        None => (),\n      }\n      smt.and_all(cs)\n    },\n    ast.CtorPattern { name: c, args: cp } => smt.ctor_pattern(mut vc, c, cp, v, mut binds),\n  }\n}"},{"name":"smt.showable","kind":"fn","old":"8eec62915238e9fa","new":"8a7d5c8fbbccac8c","interface_changed":false,"affected":[],"module":"smt","text":"// ---- reading models ----\n\n/// Whether a parameter's value can be shown from model `m`.\nfn showable(vc: smt.Vc, v: smt.Val, m: Dict[String, smt.Sx]) -> Bool {\n  match v {\n    smt.VData { ty, t } => match get(m, t) {\n      Some(x) => smt.sx_ok(vc, ty, x),\n      None => false,\n    },\n    smt.VInt(t) => match get(m, t) {\n      Some(x) => smt.int_text(smt.sx_text(x)),\n      None => false,\n    },\n    smt.VBool(t) => contains(m, t),\n    smt.VStr(t) => match get(m, t) {\n      Some(x) => smt.str_text(smt.sx_text(x)),\n      None => false,\n    },\n    smt.UnitVal => true,\n    smt.VTuple(xs) => xs.all(x -> smt.showable(vc, x, m)),\n    smt.VRec { fields, .. } => fields.all(f -> smt.showable(vc, f.1, m)),\n    smt.VDistinct { inner, .. } => smt.showable(vc, inner, m),\n    smt.VList { len, id } => match get(m, len) {\n      None => false,\n      Some(x) => match parse_int(trim(smt.sx_text(x))) {\n        Some(0) => true,\n        Some(k) => match smt.list_info(vc, id).source {\n          smt.GSeq(s, t, n) => k <= smt.input_len()\n            && range(0, k).all(\n              i -> match get(m, smt.seq_at(n, s, f\"{i}\")) {\n                Some(y) => smt.sx_ok(vc, t, y),\n                None => false,\n              },\n            ),\n          _ => false,\n        },\n        None => false,\n      },\n    },\n    smt.VSum { tag, ctors, .. } => match get(m, tag) {\n      Some(x) => match parse_int(trim(smt.sx_text(x))) {\n        Some(k) => match get(ctors, k) {\n          Some(c) => c.1.all(y -> smt.showable(vc, y, m)),\n          None => false,\n        },\n        None => false,\n      },\n      None => false,\n    },\n    // a union value is its active member's value\n    smt.VUnion { tag, slots } => match get(m, tag) {\n      Some(x) => match parse_int(trim(smt.sx_text(x))) {\n        Some(k) => match get(slots, k) {\n          Some(s) => smt.showable(vc, s.1, m),\n          None => false,\n        },\n        None => false,\n      },\n      None => false,\n    },\n    _ => false,\n  }\n}","old_text":"// ---- models ----\n\n/// Whether a parameter's value can be shown from model `m`.\nfn showable(vc: smt.Vc, v: smt.Val, m: Dict[String, smt.Sx]) -> Bool {\n  match v {\n    smt.VData { ty, t } => match get(m, t) {\n      Some(x) => smt.sx_ok(vc, ty, x),\n      None => false,\n    },\n    smt.VInt(t) => match get(m, t) {\n      Some(x) => smt.int_text(smt.sx_text(x)),\n      None => false,\n    },\n    smt.VBool(t) => contains(m, t),\n    smt.VStr(t) => match get(m, t) {\n      Some(x) => smt.str_text(smt.sx_text(x)),\n      None => false,\n    },\n    smt.UnitVal => true,\n    smt.VTuple(xs) => xs.all(x -> smt.showable(vc, x, m)),\n    smt.VRec { fields, .. } => fields.all(f -> smt.showable(vc, f.1, m)),\n    smt.VDistinct { inner, .. } => smt.showable(vc, inner, m),\n    smt.VList { len, id } => match get(m, len) {\n      None => false,\n      Some(x) => match parse_int(trim(smt.sx_text(x))) {\n        Some(0) => true,\n        Some(k) => match smt.list_info(vc, id).source {\n          smt.GSeq(s, t, n) => k <= smt.input_len()\n            && range(0, k).all(\n              i -> match get(m, smt.seq_at(n, s, f\"{i}\")) {\n                Some(y) => smt.sx_ok(vc, t, y),\n                None => false,\n              },\n            ),\n          _ => false,\n        },\n        None => false,\n      },\n    },\n    smt.VSum { tag, ctors, .. } => match get(m, tag) {\n      Some(x) => match parse_int(trim(smt.sx_text(x))) {\n        Some(k) => match get(ctors, k) {\n          Some(c) => c.1.all(y -> smt.showable(vc, y, m)),\n          None => false,\n        },\n        None => false,\n      },\n      None => false,\n    },\n    // a union value is its active member's value\n    smt.VUnion { tag, slots } => match get(m, tag) {\n      Some(x) => match parse_int(trim(smt.sx_text(x))) {\n        Some(k) => match get(slots, k) {\n          Some(s) => smt.showable(vc, s.1, m),\n          None => false,\n        },\n        None => false,\n      },\n      None => false,\n    },\n    _ => false,\n  }\n}"},{"name":"smt.subst_val","kind":"fn","old":"0af13f1fdbc0c9e9","new":"55f437648aabf607","interface_changed":false,"affected":[],"module":"smt","text":"// ---- templates and quantified facts ----\n\n/// `v` at position `i` inside `outer` (see `place`). Each list in it is a\n/// new list sharing the template of the one it copies.\nfn subst_val(\n  mut vc: smt.Vc,\n  v: smt.Val,\n  i: String,\n  outer: List[String],\n) -> smt.Val {\n  mut done := Dict[Int, Int] {}\n  smt.subst_val_in(mut vc, v, i, outer, mut done)\n}","old_text":"// ---- operators ----\n\n/// `v` at position `i` inside `outer` (see `place`). Each list in it is a\n/// new list sharing the template of the one it copies.\nfn subst_val(\n  mut vc: smt.Vc,\n  v: smt.Val,\n  i: String,\n  outer: List[String],\n) -> smt.Val {\n  mut done := Dict[Int, Int] {}\n  smt.subst_val_in(mut vc, v, i, outer, mut done)\n}"},{"name":"smt.eq_list_values","kind":"fn","old":"0a1475625e7fcdd1","new":"70b6d3fb7902c596","interface_changed":false,"affected":[],"module":"smt","text":"// ---- list equality ----\n\n/// Two lists equal: as sequences of a datatype (equal terms), by position\n/// in a goal where both are known so, else only their lengths.\nfn eq_list_values(\n  mut vc: smt.Vc,\n  l1: String,\n  i1: Int,\n  l2: String,\n  i2: Int,\n) -> String {\n  match (smt.list_info(vc, i1).source, smt.list_info(vc, i2).source) {\n    (smt.GSeq(x, _, n), smt.GSeq(y, _, m)) => return if n != m {\n      smt.unknown_bool(mut vc, \"comparing lists of different types\")\n    } else {\n      f\"(= {x} {y})\"\n    },\n    _ => (),\n  }\n  if i1 == i2 {\n    return f\"(= {l1} {l2})\"\n  }\n  // by position, where both are known so: only in a goal, and not inside a\n  // quantified fact\n  if vc.proving > 0\n    && vc.eq_depth < 2\n    && vc.indexing == None\n    && len(vc.regions) == 0 {\n    vc.eq_depth += 1\n    e := smt.eq_lists(mut vc, i1, l1, i2, l2)\n    vc.eq_depth -= 1\n    match e {\n      Some(x) => return x,\n      None => (),\n    }\n  }\n  // equal lists have equal lengths and, when both are known by position,\n  // equal elements at the positions the code takes (`ListInfo.same`)\n  if vc.list_eq > 0\n    && vc.in_same == 0\n    && vc.binding == 0\n    && len(vc.regions) == 0\n    && smt.positional(vc, i1)\n    && smt.positional(vc, i2) {\n    b := smt.unknown_bool(\n      mut vc,\n      \"comparing lists (their elements are equal only where taken)\",\n    )\n    mut vc.facts.push(f\"(=> {b} (= {l1} {l2}))\")\n    smt.same_lists(mut vc, b, i1, i2)\n    smt.same_lists(mut vc, b, i2, i1)\n    return b\n  }\n  b := smt.unknown_bool(mut vc, \"the elements of a list are not tracked\")\n  mut vc.facts.push(f\"(=> {b} (= {l1} {l2}))\")\n  b\n}","old_text":"// ---- operators ----\n\n/// Two lists equal: as sequences of a datatype (equal terms), by position\n/// in a goal where both are known so, else only their lengths.\nfn eq_list_values(\n  mut vc: smt.Vc,\n  l1: String,\n  i1: Int,\n  l2: String,\n  i2: Int,\n) -> String {\n  match (smt.list_info(vc, i1).source, smt.list_info(vc, i2).source) {\n    (smt.GSeq(x, _, n), smt.GSeq(y, _, m)) => return if n != m {\n      smt.unknown_bool(mut vc, \"comparing lists of different types\")\n    } else {\n      f\"(= {x} {y})\"\n    },\n    _ => (),\n  }\n  if i1 == i2 {\n    return f\"(= {l1} {l2})\"\n  }\n  // by position, where both are known so: only in a goal, and not inside a\n  // quantified fact\n  if vc.proving > 0\n    && vc.eq_depth < 2\n    && vc.indexing == None\n    && len(vc.regions) == 0 {\n    vc.eq_depth += 1\n    e := smt.eq_lists(mut vc, i1, l1, i2, l2)\n    vc.eq_depth -= 1\n    match e {\n      Some(x) => return x,\n      None => (),\n    }\n  }\n  // equal lists have equal lengths and, when both are known by position,\n  // equal elements at the positions the code takes (`ListInfo.same`)\n  if vc.list_eq > 0\n    && vc.in_same == 0\n    && vc.binding == 0\n    && len(vc.regions) == 0\n    && smt.positional(vc, i1)\n    && smt.positional(vc, i2) {\n    b := smt.unknown_bool(\n      mut vc,\n      \"comparing lists (their elements are equal only where taken)\",\n    )\n    mut vc.facts.push(f\"(=> {b} (= {l1} {l2}))\")\n    smt.same_lists(mut vc, b, i1, i2)\n    smt.same_lists(mut vc, b, i2, i1)\n    return b\n  }\n  b := smt.unknown_bool(mut vc, \"the elements of a list are not tracked\")\n  mut vc.facts.push(f\"(=> {b} (= {l1} {l2}))\")\n  b\n}"}]}
{"id":"f5b482965d54ebac","time":1795634397,"message":"edit","changes":[{"name":"smt.field","kind":"fn","old":"2c908995ad06b352","new":"f851a9abfb51fd72","interface_changed":false,"affected":[],"module":"smt","text":"// ---- fields and constructors ----\n\nfn field(mut vc: smt.Vc, v: smt.Val, f: String) -> smt.Val {\n  match v {\n    smt.VData { .. } => {\n      fv := smt.force(mut vc, v)\n      smt.field(mut vc, fv, f)\n    },\n    smt.VRec { fields, .. } => {\n      for x in fields {\n        if x.0 == f {\n          return x.1\n        }\n      }\n      smt.Opaque(f\"field `{f}`\")\n    },\n    smt.VDistinct { inner, .. } => if f == \"value\" {\n      inner\n    } else {\n      smt.Opaque(f\"field `{f}` of a value of an unexpected shape\")\n    },\n    smt.VTuple(xs) => match parse_int(f) {\n      Some(i) => get(xs, i) ?? smt.Opaque(f\"field `{f}`\"),\n      None => smt.Opaque(f\"field `{f}`\"),\n    },\n    smt.VSum { ty, args, tag, ctors } => {\n      // a field every variant that has it shares: the field of whichever\n      // constructor is active\n      mut found := []\n      for (k, c) in enumerate(smt.variants_of(vc, ty, args) ?? []) {\n        match c.fields {\n          Some(ns) => {\n            for (i, n) in enumerate(ns) {\n              if n == f {\n                match get((get(ctors, k) ?? (\"\", [])).1, i) {\n                  Some(x) => mut found.push((k, x)),\n                  None => (),\n                }\n              }\n            }\n          },\n          None => (),\n        }\n      }\n      if len(found) == 0 {\n        return smt.Opaque(f\"field `{f}`\")\n      }\n      mut r := (get(found, len(found) - 1) ?? (0, smt.Inactive)).1\n      mut k := len(found) - 2\n      while k >= 0 {\n        x := get(found, k) ?? (0, smt.Inactive)\n        r = smt.merge(mut vc, f\"(= {tag} {x.0})\", x.1, r)\n        k -= 1\n      }\n      r\n    },\n    // a union's field (every member has it, or the value was narrowed to\n    // members that do): the active member's field, or any value for a\n    // member without it\n    smt.VUnion { tag, slots } => {\n      mut r := smt.Opaque(f\"field `{f}` of a union member without it\")\n      mut i := len(slots) - 1\n      while i >= 0 {\n        s := (get(slots, i) ?? (\"\", smt.Inactive)).1\n        if !smt.is_absent(s) {\n          x := smt.field(mut vc, s, f)\n          r = smt.merge(mut vc, f\"(= {tag} {i})\", x, r)\n        }\n        i -= 1\n      }\n      r\n    },\n    smt.Opaque(r) => smt.Opaque(r),\n    _ => smt.Opaque(f\"field `{f}` of a value of an unexpected shape\"),\n  }\n}","old_text":"// ---- fields, constructors, patterns ----\n\nfn field(mut vc: smt.Vc, v: smt.Val, f: String) -> smt.Val {\n  match v {\n    smt.VData { .. } => {\n      fv := smt.force(mut vc, v)\n      smt.field(mut vc, fv, f)\n    },\n    smt.VRec { fields, .. } => {\n      for x in fields {\n        if x.0 == f {\n          return x.1\n        }\n      }\n      smt.Opaque(f\"field `{f}`\")\n    },\n    smt.VDistinct { inner, .. } => if f == \"value\" {\n      inner\n    } else {\n      smt.Opaque(f\"field `{f}` of a value of an unexpected shape\")\n    },\n    smt.VTuple(xs) => match parse_int(f) {\n      Some(i) => get(xs, i) ?? smt.Opaque(f\"field `{f}`\"),\n      None => smt.Opaque(f\"field `{f}`\"),\n    },\n    smt.VSum { ty, args, tag, ctors } => {\n      // a field every variant that has it shares: the field of whichever\n      // constructor is active\n      mut found := []\n      for (k, c) in enumerate(smt.variants_of(vc, ty, args) ?? []) {\n        match c.fields {\n          Some(ns) => {\n            for (i, n) in enumerate(ns) {\n              if n == f {\n                match get((get(ctors, k) ?? (\"\", [])).1, i) {\n                  Some(x) => mut found.push((k, x)),\n                  None => (),\n                }\n              }\n            }\n          },\n          None => (),\n        }\n      }\n      if len(found) == 0 {\n        return smt.Opaque(f\"field `{f}`\")\n      }\n      mut r := (get(found, len(found) - 1) ?? (0, smt.Inactive)).1\n      mut k := len(found) - 2\n      while k >= 0 {\n        x := get(found, k) ?? (0, smt.Inactive)\n        r = smt.merge(mut vc, f\"(= {tag} {x.0})\", x.1, r)\n        k -= 1\n      }\n      r\n    },\n    // a union's field (every member has it, or the value was narrowed to\n    // members that do): the active member's field, or any value for a\n    // member without it\n    smt.VUnion { tag, slots } => {\n      mut r := smt.Opaque(f\"field `{f}` of a union member without it\")\n      mut i := len(slots) - 1\n      while i >= 0 {\n        s := (get(slots, i) ?? (\"\", smt.Inactive)).1\n        if !smt.is_absent(s) {\n          x := smt.field(mut vc, s, f)\n          r = smt.merge(mut vc, f\"(= {tag} {i})\", x, r)\n        }\n        i -= 1\n      }\n      r\n    },\n    smt.Opaque(r) => smt.Opaque(r),\n    _ => smt.Opaque(f\"field `{f}` of a value of an unexpected shape\"),\n  }\n}"}]}
{"id":"777d5964b5c8cd31","time":1795634420,"message":"rename derive.X → derive.Expander, derive.new_x → derive.new_expander","changes":[{"name":"derive.Expander","kind":"type","old":null,"new":"c97fc45bb138b316","interface_changed":true,"affected":[],"module":"derive","text":"/// The state of specializing code for one `derive` or one `comptime e`.\ntype Expander = {\n  ix: derive.Defs,\n  w: eval.World,\n  // the module the generated code goes in\n  module: String,\n  // values known at compile time, by name (a `comptime` parameter, a\n  // `comptime for` element)\n  known: Dict[String, ast.Expr],\n  // types known at compile time, by name (`f.type`, `x` of `Option[x] =>`)\n  types: Dict[String, ast.TypeExpr],\n  // the type behind each `Type` value made, by the value's text\n  written: Dict[String, ast.TypeExpr],\n  // the type derived for (`()` when none)\n  self_ty: ast.TypeExpr,\n  copies: List[ast.FnDecl],\n  made: Dict[String, String],\n  // a variant's constructor, by its `Type` value's text\n  ctors: Dict[String, String],\n  // names bound inside the code being specialized, which hide known ones\n  hidden: List[List[String]],\n  // the type parameters of the type derived for (`T` of `Pair[T]`)\n  params: List[String],\n  trait_name: String,\n  trait_methods: List[String],\n  // each field's default, by its `Field` value's text\n  defaults: Dict[String, ast.Expr],\n  // each type's `Type` value, by the type's text\n  type_values: Dict[String, ast.Expr],\n  // in a match comprehension arm: the matched expression (as text) and the\n  // names its variant's fields are bound to\n  arm_fields: List[(String, List[(String, String)])],\n  // the function derived for, qualified (`derive Python for add`), which\n  // `Self.call(..)` calls. `\"\"` for a type's derive.\n  self_fn: String = \"\",\n}"},{"name":"derive.new_expander","kind":"fn","old":null,"new":"d8924d60f06d528d","interface_changed":true,"affected":[],"module":"derive","text":"fn new_expander(\n  ix: derive.Defs,\n  w: eval.World,\n  module: String,\n) -> derive.Expander {\n  derive.Expander {\n    ix,\n    w,\n    module,\n    known: Dict[String, ast.Expr] {},\n    types: Dict[String, ast.TypeExpr] {},\n    written: Dict[String, ast.TypeExpr] {},\n    self_ty: ast.UnitType,\n    copies: [],\n    made: Dict[String, String] {},\n    ctors: Dict[String, String] {},\n    hidden: [],\n    params: [],\n    trait_name: \"\",\n    trait_methods: [],\n    defaults: Dict[String, ast.Expr] {},\n    type_values: Dict[String, ast.Expr] {},\n    arm_fields: [],\n  }\n}"},{"name":"derive.derive_all","kind":"fn","old":"bf61c95572fcbe64","new":"d82c1f5276d418f1","interface_changed":false,"affected":[],"module":"derive","text":"fn derive_all(\n  decls: List[ast.Decl],\n  context: List[ast.Decl],\n) -> (List[ast.Decl], List[(String, String)]) {\n  if !decls.any(d -> derive.is_derive(d)) {\n    return (decls, [])\n  }\n  ix := derive.defs_of(context + decls)\n  w := eval.world(context + decls)\n  mut out := []\n  mut extra := []\n  mut errors := []\n  for d in decls {\n    match d.kind {\n      ast.DeriveFnDef(f) => if f.derived {\n        for function in derive.derived_functions(\n          context + decls,\n          d.module,\n          f.function,\n          ix,\n        ) {\n          mut x := derive.new_expander(ix, w, d.module)\n          match derive.derive_fn(\n            mut x,\n            ast.DeriveFnDecl { ..f, function },\n          ) {\n            Ok((made, fns)) => {\n              mut out.push(\n                ast.Decl { ..d, kind: ast.DeriveFnDef(made) },\n              )\n              for g in fns {\n                mut extra.push(\n                  ast.Decl {\n                    comments: [],\n                    doc: [],\n                    module: d.module,\n                    public: false,\n                    kind: ast.FnDef(g),\n                  },\n                )\n              }\n            },\n            Err(msg) => mut errors.push((desugar.decl_name(d), msg)),\n          }\n        }\n      } else {\n        mut out.push(d)\n      },\n      ast.ImplDef(i) => if i.derived {\n        mut x := derive.new_expander(ix, w, d.module)\n        match derive.derive(mut x, i) {\n          Ok(imp) => {\n            mut out.push(ast.Decl { ..d, kind: ast.ImplDef(imp) })\n            for f in x.copies {\n              mut extra.push(\n                ast.Decl {\n                  comments: [],\n                  doc: [],\n                  module: d.module,\n                  public: false,\n                  kind: ast.FnDef(f),\n                },\n              )\n            }\n          },\n          Err(msg) => mut errors.push((desugar.decl_name(d), msg)),\n        }\n      } else {\n        mut out.push(d)\n      },\n      _ => mut out.push(d),\n    }\n  }\n  (out + extra, errors)\n}","old_text":"fn derive_all(\n  decls: List[ast.Decl],\n  context: List[ast.Decl],\n) -> (List[ast.Decl], List[(String, String)]) {\n  if !decls.any(d -> derive.is_derive(d)) {\n    return (decls, [])\n  }\n  ix := derive.defs_of(context + decls)\n  w := eval.world(context + decls)\n  mut out := []\n  mut extra := []\n  mut errors := []\n  for d in decls {\n    match d.kind {\n      ast.DeriveFnDef(f) => if f.derived {\n        for function in derive.derived_functions(\n          context + decls,\n          d.module,\n          f.function,\n          ix,\n        ) {\n          mut x := derive.new_x(ix, w, d.module)\n          match derive.derive_fn(\n            mut x,\n            ast.DeriveFnDecl { ..f, function },\n          ) {\n            Ok((made, fns)) => {\n              mut out.push(\n                ast.Decl { ..d, kind: ast.DeriveFnDef(made) },\n              )\n              for g in fns {\n                mut extra.push(\n                  ast.Decl {\n                    comments: [],\n                    doc: [],\n                    module: d.module,\n                    public: false,\n                    kind: ast.FnDef(g),\n                  },\n                )\n              }\n            },\n            Err(msg) => mut errors.push((desugar.decl_name(d), msg)),\n          }\n        }\n      } else {\n        mut out.push(d)\n      },\n      ast.ImplDef(i) => if i.derived {\n        mut x := derive.new_x(ix, w, d.module)\n        match derive.derive(mut x, i) {\n          Ok(imp) => {\n            mut out.push(ast.Decl { ..d, kind: ast.ImplDef(imp) })\n            for f in x.copies {\n              mut extra.push(\n                ast.Decl {\n                  comments: [],\n                  doc: [],\n                  module: d.module,\n                  public: false,\n                  kind: ast.FnDef(f),\n                },\n              )\n            }\n          },\n          Err(msg) => mut errors.push((desugar.decl_name(d), msg)),\n        }\n      } else {\n        mut out.push(d)\n      },\n      _ => mut out.push(d),\n    }\n  }\n  (out + extra, errors)\n}"},{"name":"derive.fold_comptime","kind":"fn","old":"2e79b73167e39dfd","new":"447f466b5fcb68ce","interface_changed":false,"affected":[],"module":"derive","text":"/// Folds `comptime e` in ordinary code into a literal of its value, run by\n/// `run` (compiled) or by `eval`. `e` may use definitions, not the\n/// variables around it. One definition's values are asked of `run`\n/// together, since they reach much the same code. `context`: the rest of\n/// the program, which the code may use.\nfn fold_comptime(\n  decls: List[ast.Decl],\n  context: List[ast.Decl],\n  run: (List[ast.Decl], String, List[ast.Expr]) -> List[Result[ast.Expr, String]],\n) -> (List[ast.Decl], List[(String, String)]) {\n  wanted := decls.filter(d -> derive.holds_comptime(d))\n  if len(wanted) == 0 {\n    return (decls, [])\n  }\n  program := context + decls\n  ix := derive.defs_of(program)\n  w := eval.world(program)\n  mut out := []\n  mut errors := []\n  for d in decls {\n    if !derive.holds_comptime(d) {\n      mut out.push(d)\n      continue\n    }\n    mut done := []\n    // data is read directly; the rest is compiled and run, or run by `eval`\n    // where it can't be compiled\n    mut asked := []\n    for e in walk.decl_exprs(d) {\n      match e {\n        ast.Comptime(inner) => {\n          mut x := derive.new_expander(ix, w, d.module)\n          if derive.data(mut x, inner) is None {\n            mut asked.push(inner)\n          }\n        },\n        _ => (),\n      }\n    }\n    ran := if asked == [] {\n      []\n    } else {\n      run(program, d.module, asked)\n    }\n    mut k := 0\n    for e in walk.decl_exprs(d) {\n      match e {\n        ast.Comptime(inner) => {\n          mut x := derive.new_expander(ix, w, d.module)\n          got := match derive.data(mut x, inner) {\n            Some(v) => Ok(v),\n            None => {\n              r := get(ran, k) ?? Err(derive.not_compiled())\n              k += 1\n              match r {\n                Err(m) => if starts_with(m, derive.not_compiled()) {\n                  derive.eval_as(mut x, inner, inner)\n                } else if starts_with(m, \"ran for \") {\n                  Err(\n                    \"`comptime \"\n                      + text.expr_text(inner, 0)\n                      + \"` \"\n                      + m,\n                  )\n                } else {\n                  Err(\"`comptime \"\n                    + text.expr_text(inner, 0)\n                    + \"` failed: \"\n                    + m)\n                },\n                ok => ok,\n              }\n            },\n          }\n          match got {\n            Ok(v) => mut done.push((e, derive.as_code(v))),\n            Err(m) => mut errors.push(\n              (\n                desugar.decl_name(d),\n                if contains(m, \"unknown variable\") {\n                  m\n                    + \": compile-time code can use definitions, not the variables around it\"\n                } else {\n                  m\n                },\n              ),\n            ),\n          }\n        },\n        _ => (),\n      }\n    }\n    mut out.push(\n      walk.rewrite_decl(d, e -> match e {\n        ast.Comptime(_) => derive.found(done, e) ?? e,\n        _ => e,\n      }),\n    )\n  }\n  (out, errors)\n}","old_text":"/// Folds `comptime e` in ordinary code into a literal of its value, run by\n/// `run` (compiled) or by `eval`. `e` may use definitions, not the\n/// variables around it. One definition's values are asked of `run`\n/// together, since they reach much the same code. `context`: the rest of\n/// the program, which the code may use.\nfn fold_comptime(\n  decls: List[ast.Decl],\n  context: List[ast.Decl],\n  run: (List[ast.Decl], String, List[ast.Expr]) -> List[Result[ast.Expr, String]],\n) -> (List[ast.Decl], List[(String, String)]) {\n  wanted := decls.filter(d -> derive.holds_comptime(d))\n  if len(wanted) == 0 {\n    return (decls, [])\n  }\n  program := context + decls\n  ix := derive.defs_of(program)\n  w := eval.world(program)\n  mut out := []\n  mut errors := []\n  for d in decls {\n    if !derive.holds_comptime(d) {\n      mut out.push(d)\n      continue\n    }\n    mut done := []\n    // data is read directly; the rest is compiled and run, or run by `eval`\n    // where it can't be compiled\n    mut asked := []\n    for e in walk.decl_exprs(d) {\n      match e {\n        ast.Comptime(inner) => {\n          mut x := derive.new_x(ix, w, d.module)\n          if derive.data(mut x, inner) is None {\n            mut asked.push(inner)\n          }\n        },\n        _ => (),\n      }\n    }\n    ran := if asked == [] {\n      []\n    } else {\n      run(program, d.module, asked)\n    }\n    mut k := 0\n    for e in walk.decl_exprs(d) {\n      match e {\n        ast.Comptime(inner) => {\n          mut x := derive.new_x(ix, w, d.module)\n          got := match derive.data(mut x, inner) {\n            Some(v) => Ok(v),\n            None => {\n              r := get(ran, k) ?? Err(derive.not_compiled())\n              k += 1\n              match r {\n                Err(m) => if starts_with(m, derive.not_compiled()) {\n                  derive.eval_as(mut x, inner, inner)\n                } else if starts_with(m, \"ran for \") {\n                  Err(\n                    \"`comptime \"\n                      + text.expr_text(inner, 0)\n                      + \"` \"\n                      + m,\n                  )\n                } else {\n                  Err(\"`comptime \"\n                    + text.expr_text(inner, 0)\n                    + \"` failed: \"\n                    + m)\n                },\n                ok => ok,\n              }\n            },\n          }\n          match got {\n            Ok(v) => mut done.push((e, derive.as_code(v))),\n            Err(m) => mut errors.push(\n              (\n                desugar.decl_name(d),\n                if contains(m, \"unknown variable\") {\n                  m\n                    + \": compile-time code can use definitions, not the variables around it\"\n                } else {\n                  m\n                },\n              ),\n            ),\n          }\n        },\n        _ => (),\n      }\n    }\n    mut out.push(\n      walk.rewrite_decl(d, e -> match e {\n        ast.Comptime(_) => derive.found(done, e) ?? e,\n        _ => e,\n      }),\n    )\n  }\n  (out, errors)\n}"},{"name":"derive.type_value","kind":"fn","old":"c6481ef8864abebf","new":"d6ade9bd1dfacc8c","interface_changed":true,"affected":["derive.full","derive.with_self","derive.data_in","derive.derive","derive.match_type","derive.fn_value","derive.type_value_in","derive.make","derive.arm_pattern","derive.eval_as","derive.data","derive.ctor_data","derive.derive_all","derive.expr","derive.derive_fn","derive.variant_value","derive.field","derive.comprehension","derive.fold_comptime","derive.eval_here","derive.call_copy","derive.derived_in","derive.children","derive.field_read","derive.type_method","derive.with_known","derive.block","derive.folded_in","derive.expand_with","derive.expand_in","std_reached","expanded","check_errors_in","derive.call_fn","derive.expand","holes_command","check_summary","verified_decls","verify_file","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","eval_files","instantiated_files","with_extra","command_line","check_command","verified_with","static_graph","verify_command","build_proofs","alongside_command","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","repl_command","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","main","strata_command","verified_program","build_command","graph_command","graph_diff","run_command","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","or_solver_inputs","program_objects","package_errors","merge_file_command","merged_checks","core_rt_text","call_command","edit_command","check_files","rename_command","move_command","fix_command","edit_in_editor","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","smt_file","termination_file","diff_command","check_fn","linked","sync_command","build_core_command","computed_value","codegen.read_back","comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"// ---- describing types ----\n\n/// A type as a `std.typing.Type` value. Records which type the value\n/// stands for.\nfn type_value(mut x: derive.Expander, t: ast.TypeExpr) -> ast.Expr {\n  k := text.type_text(t)\n  match get(x.type_values, k) {\n    Some(v) => return v,\n    None => (),\n  }\n  mut stack := []\n  v := derive.type_value_in(mut x, t, mut stack)\n  mut x.type_values.insert(k, v)\n  v\n}","old_text":"// ---- describing types ----\n\n/// A type as a `std.typing.Type` value. Records which type the value\n/// stands for.\nfn type_value(mut x: derive.X, t: ast.TypeExpr) -> ast.Expr {\n  k := text.type_text(t)\n  match get(x.type_values, k) {\n    Some(v) => return v,\n    None => (),\n  }\n  mut stack := []\n  v := derive.type_value_in(mut x, t, mut stack)\n  mut x.type_values.insert(k, v)\n  v\n}"},{"name":"derive.remember","kind":"fn","old":"4c00d50a0e5f92a5","new":"3c2e79a9ff48828b","interface_changed":true,"affected":["derive.type_value_in","derive.variant_value","derive.fn_value","derive.type_value","derive.field","derive.derive_fn","derive.full","derive.with_self","derive.data_in","derive.derive","derive.match_type","derive.derive_all","derive.make","derive.arm_pattern","derive.eval_as","derive.data","derive.ctor_data","derive.expr","derive.derived_in","derive.comprehension","derive.fold_comptime","derive.eval_here","derive.call_copy","derive.children","derive.field_read","derive.type_method","derive.with_known","derive.block","derive.expand_with","derive.expand_in","std_reached","expanded","check_errors_in","derive.folded_in","derive.call_fn","derive.expand","holes_command","check_summary","verified_decls","verify_file","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","eval_files","instantiated_files","with_extra","command_line","check_command","verified_with","static_graph","verify_command","build_proofs","alongside_command","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","repl_command","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","main","strata_command","verified_program","build_command","graph_command","graph_diff","run_command","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","or_solver_inputs","program_objects","package_errors","merge_file_command","merged_checks","core_rt_text","call_command","edit_command","check_files","rename_command","move_command","fix_command","edit_in_editor","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","smt_file","termination_file","diff_command","check_fn","linked","sync_command","build_core_command","computed_value","codegen.read_back","comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"fn remember(mut x: derive.Expander, v: ast.Expr, t: ast.TypeExpr) {\n  mut x.written.insert(derive.key(v), t)\n}","old_text":"fn remember(mut x: derive.X, v: ast.Expr, t: ast.TypeExpr) {\n  mut x.written.insert(derive.key(v), t)\n}"},{"name":"derive.type_value_in","kind":"fn","old":"476f566e1491c271","new":"5712163f702a99bf","interface_changed":true,"affected":["derive.type_value","derive.variant_value","derive.field","derive.full","derive.with_self","derive.data_in","derive.derive","derive.match_type","derive.fn_value","derive.make","derive.arm_pattern","derive.eval_as","derive.data","derive.ctor_data","derive.derive_all","derive.expr","derive.derive_fn","derive.comprehension","derive.fold_comptime","derive.eval_here","derive.call_copy","derive.derived_in","derive.children","derive.field_read","derive.type_method","derive.with_known","derive.block","derive.folded_in","derive.expand_with","derive.expand_in","std_reached","expanded","check_errors_in","derive.call_fn","derive.expand","holes_command","check_summary","verified_decls","verify_file","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","eval_files","instantiated_files","with_extra","command_line","check_command","verified_with","static_graph","verify_command","build_proofs","alongside_command","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","repl_command","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","main","strata_command","verified_program","build_command","graph_command","graph_diff","run_command","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","or_solver_inputs","program_objects","package_errors","merge_file_command","merged_checks","core_rt_text","call_command","edit_command","check_files","rename_command","move_command","fix_command","edit_in_editor","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","smt_file","termination_file","diff_command","check_fn","linked","sync_command","build_core_command","computed_value","codegen.read_back","comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"fn type_value_in(\n  mut x: derive.Expander,\n  t: ast.TypeExpr,\n  mut stack: List[ast.TypeExpr],\n) -> ast.Expr {\n  mut name := derive.none()\n  mut doc := []\n  mut args := []\n  mut fields := []\n  mut elements := []\n  mut members := []\n  mut params := []\n  mut result := derive.none()\n  // a record's or sum's own refinement (an alias has its base's)\n  mut condition := derive.none()\n  kind := match t {\n    // a refinement: its base, with the condition\n    ast.Refined { base, pred } => {\n      mut v := derive.type_value_in(mut x, base, mut stack)\n      cond := text.expr_text(pred, 0)\n      both := match derive.str_of(v, \"condition\") {\n        Some(c) => c + \" && \" + cond,\n        None => cond,\n      }\n      v = derive.set_field(\n        v,\n        \"condition\",\n        derive.some(ast.StrLit(both)),\n      )\n      v = derive.set_field(v, \"written\", ast.StrLit(text.type_text(t)))\n      derive.remember(mut x, v, t)\n      return v\n    },\n    ast.UnitType => \"Unit\",\n    ast.FnType { params: ps, ret } => {\n      for a in ps {\n        mut params.push(derive.type_value_in(mut x, a, mut stack))\n      }\n      result = derive.some(derive.type_value_in(mut x, ret, mut stack))\n      \"Function\"\n    },\n    // a union's members as written, and each member a union declares\n    // itself (its `$own` sum)\n    ast.UnionType(ms) => {\n      for a in ms {\n        m := derive.type_value_in(mut x, a, mut stack)\n        own := match a {\n          ast.Named { name: n, .. } => contains(n, desugar.own_suffix()),\n          _ => false,\n        }\n        if own && derive.kind_name(m) == Some(\"Union\") {\n          match derive.full(mut x, m, \"members\") {\n            Some(ast.ListExpr(xs)) => {\n              members += xs\n            },\n            _ => mut members.push(m),\n          }\n        } else {\n          mut members.push(m)\n        }\n      }\n      \"Union\"\n    },\n    ast.Named { name: n, args: targs } => {\n      name = derive.some(ast.StrLit(derive.short(n)))\n      for a in targs {\n        mut args.push(derive.type_value_in(mut x, a, mut stack))\n      }\n      // written out once on the way down, at most 4 levels deep\n      shallow := derive.in_stack(stack, t) || len(stack) >= 4\n      mut stack.push(t)\n      k := if n == \"Tuple\" {\n        elements = args\n        \"Tuple\"\n      } else {\n        match get(x.ix.types, n) {\n          Some(td) => {\n            doc = get(x.ix.docs, n) ?? []\n            match td.refinement {\n              Some(r) => {\n                condition = derive.some(ast.StrLit(text.expr_text(r, 0)))\n              },\n              None => (),\n            }\n            sub := derive.pairs(td.params, targs)\n            match td.body {\n              ast.RecordBody(fs) => {\n                if !shallow {\n                  for f in fs {\n                    mut fields.push(\n                      derive.field(\n                        mut x,\n                        f.name,\n                        f.doc,\n                        derive.subst(f.ty, sub),\n                        f.default,\n                        mut stack,\n                      ),\n                    )\n                  }\n                }\n                \"Record\"\n              },\n              // a sum: a union of the members it declares\n              ast.SumBody(vs) => {\n                if !shallow {\n                  for v in vs {\n                    mut members.push(\n                      derive.variant_value(\n                        mut x,\n                        n,\n                        v,\n                        targs,\n                        sub,\n                        mut stack,\n                      ),\n                    )\n                  }\n                }\n                \"Union\"\n              },\n              // an alias or a `distinct` type: what it stands for, under\n              // its own name\n              ast.Alias(a) => {\n                whole := match td.refinement {\n                  Some(r) => ast.Refined {\n                    base: derive.subst(a, sub),\n                    pred: r,\n                  },\n                  None => derive.subst(a, sub),\n                }\n                mut v := derive.type_value_in(mut x, whole, mut stack)\n                stack = take(stack, len(stack) - 1)\n                // `base`: what it stands for, under that type's name (`Int`)\n                v = derive.set_field(v, \"base\", derive.some(v))\n                v = derive.set_field(\n                  v,\n                  \"name\",\n                  derive.some(ast.StrLit(derive.short(n))),\n                )\n                v = derive.set_field(v, \"doc\", derive.strs(doc))\n                v = derive.set_field(v, \"args\", ast.ListExpr(args))\n                v = derive.set_field(\n                  v,\n                  \"written\",\n                  ast.StrLit(text.type_text(t)),\n                )\n                derive.remember(mut x, v, t)\n                return v\n              },\n            }\n          },\n          None => match get(x.ix.ctors, n) {\n            // a variant used as a type (`TooBig`)\n            Some(sum) => {\n              stack = take(stack, len(stack) - 1)\n              match derive.variant_decl(x, n) {\n                Some(v) => {\n                  sub := derive.pairs(\n                    (get(x.ix.types, sum) ?? derive.unknown_decl()).params,\n                    targs,\n                  )\n                  return derive.variant_value(\n                    mut x,\n                    sum,\n                    v,\n                    targs,\n                    sub,\n                    mut stack,\n                  )\n                },\n                None => \"Param\",\n              }\n            },\n            None => if contains(derive.builtin_types(), n) {\n              \"Builtin\"\n            } else {\n              \"Param\"\n            },\n          },\n        }\n      }\n      stack = take(stack, len(stack) - 1)\n      k\n    },\n  }\n  v := derive.record(\"Type\", [\n    (\"name\", name),\n    (\"doc\", derive.strs(doc)),\n    (\"kind\", derive.atom(derive.q(kind))),\n    (\"args\", ast.ListExpr(args)),\n    (\"written\", ast.StrLit(text.type_text(t))),\n    (\"condition\", condition),\n    (\"fields\", ast.ListExpr(fields)),\n    (\"elements\", ast.ListExpr(elements)),\n    (\"members\", ast.ListExpr(members)),\n    (\"params\", ast.ListExpr(params)),\n    (\"result\", result),\n    (\"parameters\", ast.ListExpr([])),\n    (\"base\", derive.none()),\n  ])\n  derive.remember(mut x, v, t)\n  v\n}","old_text":"fn type_value_in(\n  mut x: derive.X,\n  t: ast.TypeExpr,\n  mut stack: List[ast.TypeExpr],\n) -> ast.Expr {\n  mut name := derive.none()\n  mut doc := []\n  mut args := []\n  mut fields := []\n  mut elements := []\n  mut members := []\n  mut params := []\n  mut result := derive.none()\n  // a record's or sum's own refinement (an alias has its base's)\n  mut condition := derive.none()\n  kind := match t {\n    // a refinement: its base, with the condition\n    ast.Refined { base, pred } => {\n      mut v := derive.type_value_in(mut x, base, mut stack)\n      cond := text.expr_text(pred, 0)\n      both := match derive.str_of(v, \"condition\") {\n        Some(c) => c + \" && \" + cond,\n        None => cond,\n      }\n      v = derive.set_field(\n        v,\n        \"condition\",\n        derive.some(ast.StrLit(both)),\n      )\n      v = derive.set_field(v, \"written\", ast.StrLit(text.type_text(t)))\n      derive.remember(mut x, v, t)\n      return v\n    },\n    ast.UnitType => \"Unit\",\n    ast.FnType { params: ps, ret } => {\n      for a in ps {\n        mut params.push(derive.type_value_in(mut x, a, mut stack))\n      }\n      result = derive.some(derive.type_value_in(mut x, ret, mut stack))\n      \"Function\"\n    },\n    // a union's members as written, and each member a union declares\n    // itself (its `$own` sum)\n    ast.UnionType(ms) => {\n      for a in ms {\n        m := derive.type_value_in(mut x, a, mut stack)\n        own := match a {\n          ast.Named { name: n, .. } => contains(n, desugar.own_suffix()),\n          _ => false,\n        }\n        if own && derive.kind_name(m) == Some(\"Union\") {\n          match derive.full(mut x, m, \"members\") {\n            Some(ast.ListExpr(xs)) => {\n              members += xs\n            },\n            _ => mut members.push(m),\n          }\n        } else {\n          mut members.push(m)\n        }\n      }\n      \"Union\"\n    },\n    ast.Named { name: n, args: targs } => {\n      name = derive.some(ast.StrLit(derive.short(n)))\n      for a in targs {\n        mut args.push(derive.type_value_in(mut x, a, mut stack))\n      }\n      // written out once on the way down, at most 4 levels deep\n      shallow := derive.in_stack(stack, t) || len(stack) >= 4\n      mut stack.push(t)\n      k := if n == \"Tuple\" {\n        elements = args\n        \"Tuple\"\n      } else {\n        match get(x.ix.types, n) {\n          Some(td) => {\n            doc = get(x.ix.docs, n) ?? []\n            match td.refinement {\n              Some(r) => {\n                condition = derive.some(ast.StrLit(text.expr_text(r, 0)))\n              },\n              None => (),\n            }\n            sub := derive.pairs(td.params, targs)\n            match td.body {\n              ast.RecordBody(fs) => {\n                if !shallow {\n                  for f in fs {\n                    mut fields.push(\n                      derive.field(\n                        mut x,\n                        f.name,\n                        f.doc,\n                        derive.subst(f.ty, sub),\n                        f.default,\n                        mut stack,\n                      ),\n                    )\n                  }\n                }\n                \"Record\"\n              },\n              // a sum: a union of the members it declares\n              ast.SumBody(vs) => {\n                if !shallow {\n                  for v in vs {\n                    mut members.push(\n                      derive.variant_value(\n                        mut x,\n                        n,\n                        v,\n                        targs,\n                        sub,\n                        mut stack,\n                      ),\n                    )\n                  }\n                }\n                \"Union\"\n              },\n              // an alias or a `distinct` type: what it stands for, under\n              // its own name\n              ast.Alias(a) => {\n                whole := match td.refinement {\n                  Some(r) => ast.Refined {\n                    base: derive.subst(a, sub),\n                    pred: r,\n                  },\n                  None => derive.subst(a, sub),\n                }\n                mut v := derive.type_value_in(mut x, whole, mut stack)\n                stack = take(stack, len(stack) - 1)\n                // `base`: what it stands for, under that type's name (`Int`)\n                v = derive.set_field(v, \"base\", derive.some(v))\n                v = derive.set_field(\n                  v,\n                  \"name\",\n                  derive.some(ast.StrLit(derive.short(n))),\n                )\n                v = derive.set_field(v, \"doc\", derive.strs(doc))\n                v = derive.set_field(v, \"args\", ast.ListExpr(args))\n                v = derive.set_field(\n                  v,\n                  \"written\",\n                  ast.StrLit(text.type_text(t)),\n                )\n                derive.remember(mut x, v, t)\n                return v\n              },\n            }\n          },\n          None => match get(x.ix.ctors, n) {\n            // a variant used as a type (`TooBig`)\n            Some(sum) => {\n              stack = take(stack, len(stack) - 1)\n              match derive.variant_decl(x, n) {\n                Some(v) => {\n                  sub := derive.pairs(\n                    (get(x.ix.types, sum) ?? derive.unknown_decl()).params,\n                    targs,\n                  )\n                  return derive.variant_value(\n                    mut x,\n                    sum,\n                    v,\n                    targs,\n                    sub,\n                    mut stack,\n                  )\n                },\n                None => \"Param\",\n              }\n            },\n            None => if contains(derive.builtin_types(), n) {\n              \"Builtin\"\n            } else {\n              \"Param\"\n            },\n          },\n        }\n      }\n      stack = take(stack, len(stack) - 1)\n      k\n    },\n  }\n  v := derive.record(\"Type\", [\n    (\"name\", name),\n    (\"doc\", derive.strs(doc)),\n    (\"kind\", derive.atom(derive.q(kind))),\n    (\"args\", ast.ListExpr(args)),\n    (\"written\", ast.StrLit(text.type_text(t))),\n    (\"condition\", condition),\n    (\"fields\", ast.ListExpr(fields)),\n    (\"elements\", ast.ListExpr(elements)),\n    (\"members\", ast.ListExpr(members)),\n    (\"params\", ast.ListExpr(params)),\n    (\"result\", result),\n    (\"parameters\", ast.ListExpr([])),\n    (\"base\", derive.none()),\n  ])\n  derive.remember(mut x, v, t)\n  v\n}"},{"name":"derive.variant_decl","kind":"fn","old":"a4c4afea4a2b11c1","new":"64a0cea73ec014ee","interface_changed":true,"affected":["derive.type_va