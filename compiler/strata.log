`.\nfn opaque_name(t: check.Ty) -> String {\n  k := codegen.short(codegen.key(t))\n  if starts_with(k, \"extern:\") {\n    codegen.short(byte_slice(k, 7, byte_len(k)))\n  } else {\n    k\n  }\n}","old_text":"/// How a handle or a channel end shows: `Counter`, `Sender[Int]`.\nfn opaque_name(t: Ty) -> String {\n  k := codegen.short(codegen.key(t))\n  if starts_with(k, \"extern:\") {\n    codegen.short(byte_slice(k, 7, byte_len(k)))\n  } else {\n    k\n  }\n}"},{"name":"codegen.test_entry","kind":"fn","old":"8e683040b2a5d4b9","new":"282cbf8939bcbab6","interface_changed":false,"affected":[],"module":"codegen","text":"/// Test `i` (function `key`) as `strata test` runs it: `strata.test.i`,\n/// after a line naming it.\nfn test_entry(i: Int, key: String, name: String) -> String {\n  sym := codegen.inst_sym(key, codegen.no_fn(), Dict[String, check.Ty] {})\n  f\"; test {i}: {name}\\ndefine void @\\\"strata.test.{i}\\\"() {{\\nentry:\\n  call void {sym}()\\n  ret void\\n}}\\n\"\n}","old_text":"/// Test `i` (function `key`) as `strata test` runs it: `strata.test.i`,\n/// after a line naming it.\nfn test_entry(i: Int, key: String, name: String) -> String {\n  sym := codegen.inst_sym(key, codegen.no_fn(), Dict[String, Ty] {})\n  f\"; test {i}: {name}\\ndefine void @\\\"strata.test.{i}\\\"() {{\\nentry:\\n  call void {sym}()\\n  ret void\\n}}\\n\"\n}"},{"name":"codegen.generated","kind":"fn","old":"a2f13accdc2a56b0","new":"b1adaae557a77225","interface_changed":false,"affected":[],"module":"codegen","text":"/// A value of written type `t` at `depth`, owned (not a temporary).\nfn generated(\n  mut g: codegen.Gen,\n  t: ast.TypeExpr,\n  h: codegen.Hints,\n  depth: String,\n) -> codegen.V {\n  f := codegen.gen_fn(mut g, t, h)\n  ty := codegen.lower(mut g, t)\n  codegen.call_bare(\n    mut g,\n    ty,\n    f,\n    [codegen.V { ty: check.TInt, op: depth }],\n  )\n}","old_text":"/// A value of written type `t` at `depth`, owned (not a temporary).\nfn generated(\n  mut g: codegen.Gen,\n  t: ast.TypeExpr,\n  h: codegen.Hints,\n  depth: String,\n) -> codegen.V {\n  f := codegen.gen_fn(mut g, t, h)\n  ty := codegen.lower(mut g, t)\n  codegen.call_bare(\n    mut g,\n    ty,\n    f,\n    [codegen.V { ty: TInt, op: depth }],\n  )\n}"},{"name":"codegen.produce","kind":"fn","old":"6decec758fdbfb81","new":"75c6b1226a59fe5a","interface_changed":true,"affected":["codegen.gen_fn","codegen.generated","codegen.can_generate","codegen.gen_list","codegen.gen_data","codegen.mock_method","codegen.fuzz_driver","codegen.built_or_generated","codegen.generated_args","codegen.makers","codegen.vtable","codegen.mock_table","codegen.mock_call","codegen.generate","codegen.build_fn","codegen.to_dyn","codegen.dyn_table_is","codegen.mock_value","codegen.method_call","codegen_with","core_rt_text","computed_value","repl_eval","codegen.dyn_wrapper","codegen.main_arg","codegen.converted","codegen.session_capability","codegen.dyn_ctor_is","codegen.dyn_generic_call","codegen.matching_v","codegen.expr_node","codegen.expr_want_node","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.entry","codegen.list_builtin","codegen.collection_builtin","codegen.list_literal_of","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.update_in_place","codegen.table_find","codegen.set_in_place","codegen.take_in_place","codegen.stmt_node","codegen.session_entry","codegen.tag_is","codegen.dyn_call","codegen.matching_want","codegen.expr","codegen.expr_want","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.builtin","codegen.list_literal","codegen.construct","codegen.operands","codegen.binary","codegen.builtin_call","codegen.branch_value","codegen.stmt","codegen.matches","codegen.options","codegen.to_c","codegen.check_payload","codegen.try_want","codegen.or_else","codegen.has_field_check","codegen.call_named","codegen.clock_now","codegen.matching","codegen.interp","codegen.logic","codegen.destructure","codegen.loop_body","codegen.for_loop","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.call_entry","codegen.type_check","codegen.if_want","codegen.tag_test","codegen.compared","codegen.decreases_pass","codegen.decreases_call","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.function","codegen.declare","codegen.block_expr","codegen.call_fn_want","codegen.scope_expr","codegen.channel_new","codegen.lambda_shown","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.union_call","codegen.iterate","codegen.decreases_start","codegen.decreases_entry","codegen.binds","codegen.foreign_call","codegen.check_type","codegen.try_expr","codegen.get_field","codegen.assertion","codegen.invariants","codegen.satisfies","codegen.holds_pred","codegen.if_expr","codegen.compiled_alone","codegen.call_fn","codegen.regex_matches","codegen.by_variant","codegen.function_value","codegen.lambda","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.check_field","codegen.assign_at","codegen.check_union","codegen.check_member","codegen.show","codegen.shown","codegen.string_builtin","codegen.host","codegen.spawn_expr","codegen.method_value","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","codegen.read_back","eval_files","codegen.helper","codegen.debug_body","codegen.equal","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// A generator's body: an owned value of `t` (of type `ty`) at `%depth`.\nfn produce(\n  mut g: codegen.Gen,\n  t: ast.TypeExpr,\n  ty: check.Ty,\n  h: codegen.Hints,\n) -> codegen.V {\n  match t {\n    ast.UnitType => return codegen.unit(),\n    // a union: a member picked at run time\n    ast.UnionType(ms) => {\n      codegen.use_rt(mut g, \"strata_random\")\n      which := codegen.fresh(mut g, \"which\")\n      codegen.emit(\n        mut g,\n        f\"{which} = call i64 @strata_random(i64 0, i64 {len(ms) - 1})\",\n      )\n      slot := codegen.fresh(mut g, \"u\")\n      mut g.allocas.push(f\"  {slot} = alloca {codegen.ll(ty)}\")\n      end := codegen.label(mut g, \"u.end\")\n      mut labels := []\n      for _ in ms {\n        mut labels.push(codegen.label(mut g, \"u.member\"))\n      }\n      mut cases := []\n      for (k, l) in enumerate(labels) {\n        mut cases.push(f\"i64 {k}, label %{l}\")\n      }\n      codegen.emit(\n        mut g,\n        f\"switch i64 {which}, label %{get(labels, 0) ?? end} [ {join(cases, \" \")} ]\",\n      )\n      for (k, m) in enumerate(ms) {\n        codegen.block(mut g, get(labels, k) ?? end)\n        codegen.push_scope(mut g)\n        v := codegen.generated(mut g, m, codegen.no_hints(), \"%depth\")\n        x := codegen.temp(mut g, v)\n        u := codegen.converted(mut g, x, ty)\n        held := codegen.take_value(mut g, u)\n        codegen.pop_scope(mut g)\n        codegen.emit(\n          mut g,\n          f\"store {codegen.ll(ty)} {held.op}, ptr {slot}\",\n        )\n        codegen.br(mut g, end)\n      }\n      codegen.block(mut g, end)\n      r := codegen.fresh(mut g, \"uv\")\n      codegen.emit(\n        mut g,\n        f\"{r} = load {codegen.ll(ty)}, ptr {slot}\",\n      )\n      return codegen.V { ty, op: r }\n    },\n    // a function: returns a value generated on the first call per\n    // arguments, since a function always gives the same result for the same\n    // arguments\n    ast.FnType { params, ret } => {\n      codegen.push_scope(mut g)\n      d := codegen.deeper(mut g)\n      r := codegen.generated(mut g, ret, codegen.no_hints(), d)\n      codegen.local_owned(mut g, \"gen.result\", r)\n      mut ps := []\n      for (k, p) in enumerate(params) {\n        mut ps.push(ast.LamParam { name: f\"gen.p{k}\", ty: Some(p) })\n      }\n      f := codegen.lambda(mut g, ps, ast.Var(\"gen.result\"), ty)\n      x := codegen.take_value(mut g, f)\n      codegen.pop_scope(mut g)\n      return x\n    },\n    ast.Refined { base, pred } => {\n      h2 := codegen.hints_and(h, pred)\n      (head, fail) := codegen.tries_start(mut g, 300)\n      v := codegen.generated(mut g, base, h2, \"%depth\")\n      x := codegen.V { ty, op: v.op }\n      ok := codegen.satisfies(mut g, t, x)\n      codegen.tries_end(\n        mut g,\n        x,\n        ok,\n        head,\n        fail,\n        f\"could not generate a value satisfying `{text.type_text(t)}` after 300 attempts\",\n      )\n      return x\n    },\n    _ => (),\n  }\n  (n, args) := match t {\n    ast.Named { name, args } => (name, args),\n    _ => {\n      codegen.not_yet(\n        mut g,\n        \"generating a value of `\" + text.type_text(t) + \"`\",\n      )\n      return codegen.never()\n    },\n  }\n  match codegen.sized(ty) {\n    Some(_) => {\n      (tbl, k) := codegen.pairs_table(mut g, codegen.bounded(h.ints, 1000, 100))\n      codegen.use_rt(mut g, \"strata_gen_int\")\n      r := codegen.fresh(mut g, \"i\")\n      codegen.emit(\n        mut g,\n        f\"{r} = call i64 @strata_gen_int(ptr {tbl}, i64 {k})\",\n      )\n      return codegen.as_type(\n        mut g,\n        codegen.V { ty: check.TInt, op: r },\n        ty,\n      )\n    },\n    None => (),\n  }\n  if n == \"Int\" || n == \"Float\" {\n    (tbl, k) := codegen.pairs_table(mut g, codegen.bounded(h.ints, 1000, 100))\n    r := codegen.fresh(mut g, \"i\")\n    if n == \"Int\" {\n      codegen.use_rt(mut g, \"strata_gen_int\")\n      codegen.emit(\n        mut g,\n        f\"{r} = call i64 @strata_gen_int(ptr {tbl}, i64 {k})\",\n      )\n      return codegen.V { ty: check.TInt, op: r }\n    }\n    (rt, rk) := codegen.pairs_table(mut g, h.ints)\n    codegen.use_rt(mut g, \"strata_gen_float\")\n    codegen.emit(\n      mut g,\n      f\"{r} = call double @strata_gen_float(ptr {tbl}, i64 {k}, ptr {rt}, i64 {rk})\",\n    )\n    return codegen.V { ty: check.TFloat, op: r }\n  }\n  if n == \"Bool\" {\n    codegen.use_rt(mut g, \"strata_random\")\n    (x, r) := (codegen.fresh(mut g, \"b\"), codegen.fresh(mut g, \"b\"))\n    codegen.emit(\n      mut g,\n      f\"{x} = call i64 @strata_random(i64 0, i64 1)\",\n    )\n    codegen.emit(mut g, f\"{r} = trunc i64 {x} to i1\")\n    return codegen.V { ty: check.TBool, op: r }\n  }\n  if n == \"String\" {\n    match h.regex {\n      // strings matching the refinement's regex, made at compile time (the\n      // same every run), one picked at run time\n      Some(re) => match std.regex.samples(re, 32, 7) {\n        Ok(xs) => if xs != [] {\n          mut consts := []\n          for x in xs {\n            mut consts.push(\"ptr \" + codegen.string(mut g, x))\n          }\n          g.lambdas += 1\n          name := f\"@\\\"samples.{g.owner}{g.lambdas}\\\"\"\n          codegen.add_helper(mut g, name)\n          mut g.globals.push(\n            f\"{name} = private unnamed_addr constant [{len(consts)} x ptr] [{join(consts, \", \")}], align 8\",\n          )\n          codegen.use_rt(mut g, \"strata_random\")\n          (i, at, r) := (\n            codegen.fresh(mut g, \"which\"),\n            codegen.fresh(mut g, \"at\"),\n            codegen.fresh(mut g, \"s\"),\n          )\n          codegen.emit(\n            mut g,\n            f\"{i} = call i64 @strata_random(i64 0, i64 {len(consts) - 1})\",\n          )\n          codegen.emit(\n            mut g,\n            f\"{at} = getelementptr ptr, ptr {name}, i64 {i}\",\n          )\n          codegen.emit(mut g, f\"{r} = load ptr, ptr {at}\")\n          return codegen.V { ty: check.TStr, op: r }\n        } else {\n          codegen.not_yet(\n            mut g,\n            f\"strings matching {debug(re)}: it has no samples\",\n          )\n          return codegen.never()\n        },\n        Err(m) => {\n          codegen.not_yet(\n            mut g,\n            f\"strings matching {debug(re)}: {m}\",\n          )\n          return codegen.never()\n        },\n      },\n      None => (),\n    }\n    (tbl, k) := codegen.pairs_table(mut g, codegen.bounded(h.lens, 0, 8))\n    codegen.use_rt(mut g, \"strata_gen_len\")\n    codegen.use_rt(mut g, \"strata_gen_string\")\n    (l, r) := (codegen.fresh(mut g, \"len\"), codegen.fresh(mut g, \"s\"))\n    codegen.emit(\n      mut g,\n      f\"{l} = call i64 @strata_gen_len(ptr {tbl}, i64 {k})\",\n    )\n    codegen.emit(\n      mut g,\n      f\"{r} = call ptr @strata_gen_string(i64 {l})\",\n    )\n    return codegen.V { ty: check.TStr, op: r }\n  }\n  if n == \"Tuple\" {\n    codegen.push_scope(mut g)\n    d := codegen.deeper(mut g)\n    mut vs := []\n    for a in args {\n      v := codegen.generated(mut g, a, codegen.no_hints(), d)\n      mut vs.push(codegen.temp(mut g, v))\n    }\n    b := codegen.block_of(mut g, 0, vs)\n    codegen.pop_scope(mut g)\n    return codegen.V { ty, op: b }\n  }\n  if n == \"List\" || n == \"Set\" || n == \"Dict\" {\n    return codegen.gen_list(mut g, n, args, ty, h)\n  }\n  match ty {\n    check.TTrait(_) => {\n      v := codegen.mock_value(mut g, ty)\n      return codegen.take_value(mut g, v)\n    },\n    _ => (),\n  }\n  // A refined alias (`type Score = Int where …`): its base within the\n  // predicate's intervals, until it holds. A plain alias: its body. A\n  // `distinct` type is a block holding its value, made by `gen_data`.\n  match get(g.refines, n) {\n    Some((base0, pred)) => {\n      itself := ast.Named { name: n, args: [] }\n      // a generic one's arguments substituted: `NonEmpty[Line]` is a\n      // `List[Line]`\n      ps := get(g.refine_params, n) ?? []\n      base := if ps != [] && len(ps) == len(args) {\n        codegen.written_in(base0, ps, args)\n      } else {\n        base0\n      }\n      if base != itself && !contains(g.distincts, n) {\n        (head, fail) := codegen.tries_start(mut g, 300)\n        v := codegen.generated(\n          mut g,\n          base,\n          codegen.hints_and(codegen.no_hints(), pred),\n          \"%depth\",\n        )\n        x := codegen.V { ty, op: v.op }\n        ok := codegen.satisfies(mut g, t, x)\n        codegen.tries_end(\n          mut g,\n          x,\n          ok,\n          head,\n          fail,\n          f\"could not generate a value satisfying `{text.type_text(t)}` after 300 attempts\",\n        )\n        return x\n      }\n    },\n    None => (),\n  }\n  match get(g.types.aliases, n) {\n    Some(a) => {\n      v := codegen.generated(mut g, a, h, \"%depth\")\n      return codegen.V { ty, op: v.op }\n    },\n    None => (),\n  }\n  codegen.gen_data(mut g, t, n, args, ty)\n}","old_text":"/// A generator's body: an owned value of `t` (of type `ty`) at `%depth`.\nfn produce(\n  mut g: codegen.Gen,\n  t: ast.TypeExpr,\n  ty: Ty,\n  h: codegen.Hints,\n) -> codegen.V {\n  match t {\n    ast.UnitType => return codegen.unit(),\n    // a union: a member picked at run time\n    ast.UnionType(ms) => {\n      codegen.use_rt(mut g, \"strata_random\")\n      which := codegen.fresh(mut g, \"which\")\n      codegen.emit(\n        mut g,\n        f\"{which} = call i64 @strata_random(i64 0, i64 {len(ms) - 1})\",\n      )\n      slot := codegen.fresh(mut g, \"u\")\n      mut g.allocas.push(f\"  {slot} = alloca {codegen.ll(ty)}\")\n      end := codegen.label(mut g, \"u.end\")\n      mut labels := []\n      for _ in ms {\n        mut labels.push(codegen.label(mut g, \"u.member\"))\n      }\n      mut cases := []\n      for (k, l) in enumerate(labels) {\n        mut cases.push(f\"i64 {k}, label %{l}\")\n      }\n      codegen.emit(\n        mut g,\n        f\"switch i64 {which}, label %{get(labels, 0) ?? end} [ {join(cases, \" \")} ]\",\n      )\n      for (k, m) in enumerate(ms) {\n        codegen.block(mut g, get(labels, k) ?? end)\n        codegen.push_scope(mut g)\n        v := codegen.generated(mut g, m, codegen.no_hints(), \"%depth\")\n        x := codegen.temp(mut g, v)\n        u := codegen.converted(mut g, x, ty)\n        held := codegen.take_value(mut g, u)\n        codegen.pop_scope(mut g)\n        codegen.emit(\n          mut g,\n          f\"store {codegen.ll(ty)} {held.op}, ptr {slot}\",\n        )\n        codegen.br(mut g, end)\n      }\n      codegen.block(mut g, end)\n      r := codegen.fresh(mut g, \"uv\")\n      codegen.emit(\n        mut g,\n        f\"{r} = load {codegen.ll(ty)}, ptr {slot}\",\n      )\n      return codegen.V { ty, op: r }\n    },\n    // a function: returns a value generated on the first call per\n    // arguments, since a function always gives the same result for the same\n    // arguments\n    ast.FnType { params, ret } => {\n      codegen.push_scope(mut g)\n      d := codegen.deeper(mut g)\n      r := codegen.generated(mut g, ret, codegen.no_hints(), d)\n      codegen.local_owned(mut g, \"gen.result\", r)\n      mut ps := []\n      for (k, p) in enumerate(params) {\n        mut ps.push(ast.LamParam { name: f\"gen.p{k}\", ty: Some(p) })\n      }\n      f := codegen.lambda(mut g, ps, ast.Var(\"gen.result\"), ty)\n      x := codegen.take_value(mut g, f)\n      codegen.pop_scope(mut g)\n      return x\n    },\n    ast.Refined { base, pred } => {\n      h2 := codegen.hints_and(h, pred)\n      (head, fail) := codegen.tries_start(mut g, 300)\n      v := codegen.generated(mut g, base, h2, \"%depth\")\n      x := codegen.V { ty, op: v.op }\n      ok := codegen.satisfies(mut g, t, x)\n      codegen.tries_end(\n        mut g,\n        x,\n        ok,\n        head,\n        fail,\n        f\"could not generate a value satisfying `{text.type_text(t)}` after 300 attempts\",\n      )\n      return x\n    },\n    _ => (),\n  }\n  (n, args) := match t {\n    ast.Named { name, args } => (name, args),\n    _ => {\n      codegen.not_yet(\n        mut g,\n        \"generating a value of `\" + text.type_text(t) + \"`\",\n      )\n      return codegen.never()\n    },\n  }\n  match codegen.sized(ty) {\n    Some(_) => {\n      (tbl, k) := codegen.pairs_table(mut g, codegen.bounded(h.ints, 1000, 100))\n      codegen.use_rt(mut g, \"strata_gen_int\")\n      r := codegen.fresh(mut g, \"i\")\n      codegen.emit(\n        mut g,\n        f\"{r} = call i64 @strata_gen_int(ptr {tbl}, i64 {k})\",\n      )\n      return codegen.as_type(mut g, codegen.V { ty: TInt, op: r }, ty)\n    },\n    None => (),\n  }\n  if n == \"Int\" || n == \"Float\" {\n    (tbl, k) := codegen.pairs_table(mut g, codegen.bounded(h.ints, 1000, 100))\n    r := codegen.fresh(mut g, \"i\")\n    if n == \"Int\" {\n      codegen.use_rt(mut g, \"strata_gen_int\")\n      codegen.emit(\n        mut g,\n        f\"{r} = call i64 @strata_gen_int(ptr {tbl}, i64 {k})\",\n      )\n      return codegen.V { ty: TInt, op: r }\n    }\n    (rt, rk) := codegen.pairs_table(mut g, h.ints)\n    codegen.use_rt(mut g, \"strata_gen_float\")\n    codegen.emit(\n      mut g,\n      f\"{r} = call double @strata_gen_float(ptr {tbl}, i64 {k}, ptr {rt}, i64 {rk})\",\n    )\n    return codegen.V { ty: TFloat, op: r }\n  }\n  if n == \"Bool\" {\n    codegen.use_rt(mut g, \"strata_random\")\n    (x, r) := (codegen.fresh(mut g, \"b\"), codegen.fresh(mut g, \"b\"))\n    codegen.emit(\n      mut g,\n      f\"{x} = call i64 @strata_random(i64 0, i64 1)\",\n    )\n    codegen.emit(mut g, f\"{r} = trunc i64 {x} to i1\")\n    return codegen.V { ty: TBool, op: r }\n  }\n  if n == \"String\" {\n    match h.regex {\n      // strings matching the refinement's regex, made at compile time (the\n      // same every run), one picked at run time\n      Some(re) => match std.regex.samples(re, 32, 7) {\n        Ok(xs) => if xs != [] {\n          mut consts := []\n          for x in xs {\n            mut consts.push(\"ptr \" + codegen.string(mut g, x))\n          }\n          g.lambdas += 1\n          name := f\"@\\\"samples.{g.owner}{g.lambdas}\\\"\"\n          codegen.add_helper(mut g, name)\n          mut g.globals.push(\n            f\"{name} = private unnamed_addr constant [{len(consts)} x ptr] [{join(consts, \", \")}], align 8\",\n          )\n          codegen.use_rt(mut g, \"strata_random\")\n          (i, at, r) := (\n            codegen.fresh(mut g, \"which\"),\n            codegen.fresh(mut g, \"at\"),\n            codegen.fresh(mut g, \"s\"),\n          )\n          codegen.emit(\n            mut g,\n            f\"{i} = call i64 @strata_random(i64 0, i64 {len(consts) - 1})\",\n          )\n          codegen.emit(\n            mut g,\n            f\"{at} = getelementptr ptr, ptr {name}, i64 {i}\",\n          )\n          codegen.emit(mut g, f\"{r} = load ptr, ptr {at}\")\n          return codegen.V { ty: TStr, op: r }\n        } else {\n          codegen.not_yet(\n            mut g,\n            f\"strings matching {debug(re)}: it has no samples\",\n          )\n          return codegen.never()\n        },\n        Err(m) => {\n          codegen.not_yet(\n            mut g,\n            f\"strings matching {debug(re)}: {m}\",\n          )\n          return codegen.never()\n        },\n      },\n      None => (),\n    }\n    (tbl, k) := codegen.pairs_table(mut g, codegen.bounded(h.lens, 0, 8))\n    codegen.use_rt(mut g, \"strata_gen_len\")\n    codegen.use_rt(mut g, \"strata_gen_string\")\n    (l, r) := (codegen.fresh(mut g, \"len\"), codegen.fresh(mut g, \"s\"))\n    codegen.emit(\n      mut g,\n      f\"{l} = call i64 @strata_gen_len(ptr {tbl}, i64 {k})\",\n    )\n    codegen.emit(\n      mut g,\n      f\"{r} = call ptr @strata_gen_string(i64 {l})\",\n    )\n    return codegen.V { ty: TStr, op: r }\n  }\n  if n == \"Tuple\" {\n    codegen.push_scope(mut g)\n    d := codegen.deeper(mut g)\n    mut vs := []\n    for a in args {\n      v := codegen.generated(mut g, a, codegen.no_hints(), d)\n      mut vs.push(codegen.temp(mut g, v))\n    }\n    b := codegen.block_of(mut g, 0, vs)\n    codegen.pop_scope(mut g)\n    return codegen.V { ty, op: b }\n  }\n  if n == \"List\" || n == \"Set\" || n == \"Dict\" {\n    return codegen.gen_list(mut g, n, args, ty, h)\n  }\n  match ty {\n    TTrait(_) => {\n      v := codegen.mock_value(mut g, ty)\n      return codegen.take_value(mut g, v)\n    },\n    _ => (),\n  }\n  // A refined alias (`type Score = Int where …`): its base within the\n  // predicate's intervals, until it holds. A plain alias: its body. A\n  // `distinct` type is a block holding its value, made by `gen_data`.\n  match get(g.refines, n) {\n    Some((base0, pred)) => {\n      itself := ast.Named { name: n, args: [] }\n      // a generic one's arguments substituted: `NonEmpty[Line]` is a\n      // `List[Line]`\n      ps := get(g.refine_params, n) ?? []\n      base := if ps != [] && len(ps) == len(args) {\n        codegen.written_in(base0, ps, args)\n      } else {\n        base0\n      }\n      if base != itself && !contains(g.distincts, n) {\n        (head, fail) := codegen.tries_start(mut g, 300)\n        v := codegen.generated(\n          mut g,\n          base,\n          codegen.hints_and(codegen.no_hints(), pred),\n          \"%depth\",\n        )\n        x := codegen.V { ty, op: v.op }\n        ok := codegen.satisfies(mut g, t, x)\n        codegen.tries_end(\n          mut g,\n          x,\n          ok,\n          head,\n          fail,\n          f\"could not generate a value satisfying `{text.type_text(t)}` after 300 attempts\",\n        )\n        return x\n      }\n    },\n    None => (),\n  }\n  match get(g.types.aliases, n) {\n    Some(a) => {\n      v := codegen.generated(mut g, a, h, \"%depth\")\n      return codegen.V { ty, op: v.op }\n    },\n    None => (),\n  }\n  codegen.gen_data(mut g, t, n, args, ty)\n}"},{"name":"codegen.gen_list","kind":"fn","old":"44d8395d1c1a8646","new":"89ffbae43b295f8a","interface_changed":true,"affected":["codegen.produce","codegen.gen_fn","codegen.generated","codegen.can_generate","codegen.gen_data","codegen.mock_method","codegen.fuzz_driver","codegen.built_or_generated","codegen.generated_args","codegen.makers","codegen.vtable","codegen.mock_table","codegen.mock_call","codegen.generate","codegen.build_fn","codegen.to_dyn","codegen.dyn_table_is","codegen.mock_value","codegen.method_call","codegen_with","core_rt_text","computed_value","repl_eval","codegen.dyn_wrapper","codegen.main_arg","codegen.converted","codegen.session_capability","codegen.dyn_ctor_is","codegen.dyn_generic_call","codegen.matching_v","codegen.expr_node","codegen.expr_want_node","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.entry","codegen.list_builtin","codegen.collection_builtin","codegen.list_literal_of","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.update_in_place","codegen.table_find","codegen.set_in_place","codegen.take_in_place","codegen.stmt_node","codegen.session_entry","codegen.tag_is","codegen.dyn_call","codegen.matching_want","codegen.expr","codegen.expr_w