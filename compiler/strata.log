)] {\n      mut w.fns.insert(n, f)\n      mut w.modules.insert(n, get(x.w.modules, template) ?? x.module)\n    }\n  }\n  w\n}","old_text":"/// The program's definitions for `eval`, plus the copies made so far of\n/// functions with `comptime` parameters (`std.cli.count_commands.for.T.1`),\n/// which compile-time code calls once specialized.\nfn world_with_copies(x: derive.X) -> eval.World {\n  mut w := x.w\n  for f in x.copies {\n    template := match index_of(f.name, \".for.\") {\n      Some(k) => byte_slice(f.name, 0, k),\n      None => f.name,\n    }\n    // also by the name its calls use: qualified by the derive's module\n    for n in [f.name, derive.qualify(x.module, f.name)] {\n      mut w.fns.insert(n, f)\n      mut w.modules.insert(n, get(x.w.modules, template) ?? x.module)\n    }\n  }\n  w\n}"},{"name":"derive.derive_fn","kind":"fn","old":"f971950a26327e5f","new":"72c94ca394aed5dd","interface_changed":true,"affected":["derive.derive_all","derive.derived_in","derive.expand_with","derive.expand_in","std_reached","expanded","check_errors_in","derive.expand","holes_command","check_summary","verified_decls","verify_file","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","eval_files","instantiated_files","with_extra","command_line","check_command","verified_with","static_graph","verify_command","build_proofs","alongside_command","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","repl_command","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","main","strata_command","verified_program","build_command","graph_command","graph_diff","run_command","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","or_solver_inputs","program_objects","package_errors","merge_file_command","merged_checks","core_rt_text","call_command","edit_command","check_files","rename_command","move_command","fix_command","edit_in_editor","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","smt_file","termination_file","diff_command","check_fn","linked","sync_command","build_core_command","computed_value","codegen.read_back","comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"/// `derive C for add`: a trait derived over a function. `Self` is the\n/// function, described as a `Type` of kind `Function` with its name, doc\n/// and `parameters`. A function has no type to put an `impl` on, so the\n/// output is top-level. Each `derived fn` of the trait gives an export or\n/// part of a file, by its signature alone:\n/// - `derived fn export() -> Self = Self`: the function itself, exported\n/// under its own name (`(\"add\", \"add\")` in `exports`).\n/// - `derived fn h() -> String { ... }`: specialized into a top-level\n/// function of the derive's module (`add.C.h`). Its value, folded at\n/// compile time, is the function's part of the file `<name>.h` that a\n/// library build writes (`(\"h\", \"add.C.h\")` in `files`).\n/// - `derived fn json(args: String) -> String { ... }`, one with\n/// parameters: a wrapper, specialized into a top-level function\n/// (`add.Python.json`) exported as `NAME_METHOD` (`(\"add_json\",\n/// \"add.Python.json\")` in `exports`). Its parameters and result cross\n/// as `derive C`'s do.\n/// The second part of the result is the functions made.\nfn derive_fn(\n  mut x: derive.Expander,\n  given: ast.DeriveFnDecl,\n) -> Result[(ast.DeriveFnDecl, List[ast.FnDecl]), String] {\n  tr := match get(x.ix.traits, given.trait_name) {\n    Some(t) => t,\n    None => return Err(\"`\" + derive.short(given.trait_name) + \"` is not a trait\"),\n  }\n  fname := derive.short(given.function)\n  dv := match tr.derivable {\n    Some(d) => d,\n    None => return Err(\"`\"\n      + derive.short(tr.name)\n      + \"` can't be derived: only a `derivable` trait can\"),\n  }\n  f := match get(x.ix.fns, given.function) {\n    Some(f) => f,\n    None => return Err(\"`\" + fname + \"` is not a function defined in this program\"),\n  }\n  ks := match dv.kind {\n    ast.UnionType(ms) => ms,\n    k => [k],\n  }\n  if !ks.any(k -> derive.short(derive.type_head(k)) == \"Function\") {\n    names := join(\n      ks.map(k -> \"`\" + derive.short(derive.type_head(k)) + \"`\"),\n      \" or a \",\n    )\n    return Err(\"`\"\n      + derive.short(tr.name)\n      + \"` can only be derived for a \"\n      + names\n      + \", and `\"\n      + fname\n      + \"` is a function\")\n  }\n  if f.type_params != [] {\n    return Err(\"`\"\n      + fname\n      + \"` has type parameters: `\"\n      + derive.short(tr.name)\n      + \"` is derived for a function whose types are known (one calling `\"\n      + fname\n      + \"` with them)\")\n  }\n  self_ty := ast.FnType { params: f.params.map(p -> p.ty), ret: f.ret }\n  _ := derive.fn_value(mut x, given.function, f, self_ty)\n  x.self_ty = self_ty\n  x.trait_name = given.trait_name\n  x.self_fn = given.function\n  x.trait_methods = tr.methods.map(m -> m.decl.name)\n  for r in dv.conditions {\n    r2 := derive.expr(mut x, r)!\n    ok := match derive.eval_as(mut x, r2, r) {\n      Ok(v) => v,\n      Err(m) => return Err(\n        \"checking what `\"\n          + derive.short(tr.name)\n          + \"` requires: \"\n          + m,\n      ),\n    }\n    if ok != ast.BoolLit(true) {\n      return Err(\"`\"\n        + fname\n        + \"` doesn't meet what `\"\n        + derive.short(tr.name)\n        + \"` requires: \"\n        + text.expr_text(r, 0))\n    }\n  }\n  mut exports := []\n  mut files := []\n  mut made := []\n  for m in tr.methods {\n    if !m.decl.derived {\n      continue\n    }\n    shape := \"`\" + derive.short(tr.name) + \"`'s `\" + m.decl.name + \"`\"\n    if m.decl.params != [] {\n      // a wrapper of the function, exported as `NAME_METHOD`\n      body := match derive.expr(mut x, m.decl.body) {\n        Ok(b) => b,\n        Err(e) => return Err(\"deriving `\" + m.decl.name + \"`: \" + e),\n      }\n      name := fname + \".\" + derive.short(tr.name) + \".\" + m.decl.name\n      mut made.push(\n        ast.FnDecl { ..m.decl, name, derived: false, compile_time: false, body },\n      )\n      mut exports.push(\n        (fname + \"_\" + m.decl.name, derive.qualify(x.module, name)),\n      )\n      continue\n    }\n    if derive.type_head(m.decl.ret) == \"Self\" {\n      if !derive.is_self(m.decl.body) {\n        return Err(\n          shape\n            + \" exports something other than the function itself (`= Self`): not built yet\",\n        )\n      }\n      mut exports.push((fname, given.function))\n    } else if derive.type_head(m.decl.ret) == \"String\" {\n      body := match derive.expr(mut x, m.decl.body) {\n        Ok(b) => b,\n        Err(e) => return Err(\"deriving `\" + m.decl.name + \"`: \" + e),\n      }\n      name := fname + \".\" + derive.short(tr.name) + \".\" + m.decl.name\n      mut made.push(\n        ast.FnDecl { ..m.decl, name, derived: false, compile_time: false, body },\n      )\n      mut files.push((m.decl.name, derive.qualify(x.module, name)))\n    } else {\n      return Err(\n        shape\n          + \" gives a `\"\n          + text.type_text(m.decl.ret)\n          + \"`: a derive for a function makes exports (`-> Self = Self`, or a wrapper taking parameters) and parts of files (`-> String`)\",\n      )\n    }\n  }\n  Ok((\n    ast.DeriveFnDecl { ..given, derived: false, exports, files },\n    made + x.copies,\n  ))\n}","old_text":"/// `derive C for add`: a trait derived over a function. `Self` is the\n/// function, described as a `Type` of kind `Function` with its name, doc\n/// and `parameters`. A function has no type to put an `impl` on, so the\n/// output is top-level. Each `derived fn` of the trait gives an export or\n/// part of a file, by its signature alone:\n/// - `derived fn export() -> Self = Self`: the function itself, exported\n/// under its own name (`(\"add\", \"add\")` in `exports`).\n/// - `derived fn h() -> String { ... }`: specialized into a top-level\n/// function of the derive's module (`add.C.h`). Its value, folded at\n/// compile time, is the function's part of the file `<name>.h` that a\n/// library build writes (`(\"h\", \"add.C.h\")` in `files`).\n/// - `derived fn json(args: String) -> String { ... }`, one with\n/// parameters: a wrapper, specialized into a top-level function\n/// (`add.Python.json`) exported as `NAME_METHOD` (`(\"add_json\",\n/// \"add.Python.json\")` in `exports`). Its parameters and result cross\n/// as `derive C`'s do.\n/// The second part of the result is the functions made.\nfn derive_fn(\n  mut x: derive.X,\n  given: ast.DeriveFnDecl,\n) -> Result[(ast.DeriveFnDecl, List[ast.FnDecl]), String] {\n  tr := match get(x.ix.traits, given.trait_name) {\n    Some(t) => t,\n    None => return Err(\"`\" + derive.short(given.trait_name) + \"` is not a trait\"),\n  }\n  fname := derive.short(given.function)\n  dv := match tr.derivable {\n    Some(d) => d,\n    None => return Err(\"`\"\n      + derive.short(tr.name)\n      + \"` can't be derived: only a `derivable` trait can\"),\n  }\n  f := match get(x.ix.fns, given.function) {\n    Some(f) => f,\n    None => return Err(\"`\" + fname + \"` is not a function defined in this program\"),\n  }\n  ks := match dv.kind {\n    ast.UnionType(ms) => ms,\n    k => [k],\n  }\n  if !ks.any(k -> derive.short(derive.type_head(k)) == \"Function\") {\n    names := join(\n      ks.map(k -> \"`\" + derive.short(derive.type_head(k)) + \"`\"),\n      \" or a \",\n    )\n    return Err(\"`\"\n      + derive.short(tr.name)\n      + \"` can only be derived for a \"\n      + names\n      + \", and `\"\n      + fname\n      + \"` is a function\")\n  }\n  if f.type_params != [] {\n    return Err(\"`\"\n      + fname\n      + \"` has type parameters: `\"\n      + derive.short(tr.name)\n      + \"` is derived for a function whose types are known (one calling `\"\n      + fname\n      + \"` with them)\")\n  }\n  self_ty := ast.FnType { params: f.params.map(p -> p.ty), ret: f.ret }\n  _ := derive.fn_value(mut x, given.function, f, self_ty)\n  x.self_ty = self_ty\n  x.trait_name = given.trait_name\n  x.self_fn = given.function\n  x.trait_methods = tr.methods.map(m -> m.decl.name)\n  for r in dv.conditions {\n    r2 := derive.expr(mut x, r)!\n    ok := match derive.eval_as(mut x, r2, r) {\n      Ok(v) => v,\n      Err(m) => return Err(\n        \"checking what `\"\n          + derive.short(tr.name)\n          + \"` requires: \"\n          + m,\n      ),\n    }\n    if ok != ast.BoolLit(true) {\n      return Err(\"`\"\n        + fname\n        + \"` doesn't meet what `\"\n        + derive.short(tr.name)\n        + \"` requires: \"\n        + text.expr_text(r, 0))\n    }\n  }\n  mut exports := []\n  mut files := []\n  mut made := []\n  for m in tr.methods {\n    if !m.decl.derived {\n      continue\n    }\n    shape := \"`\" + derive.short(tr.name) + \"`'s `\" + m.decl.name + \"`\"\n    if m.decl.params != [] {\n      // a wrapper of the function, exported as `NAME_METHOD`\n      body := match derive.expr(mut x, m.decl.body) {\n        Ok(b) => b,\n        Err(e) => return Err(\"deriving `\" + m.decl.name + \"`: \" + e),\n      }\n      name := fname + \".\" + derive.short(tr.name) + \".\" + m.decl.name\n      mut made.push(\n        ast.FnDecl { ..m.decl, name, derived: false, compile_time: false, body },\n      )\n      mut exports.push(\n        (fname + \"_\" + m.decl.name, derive.qualify(x.module, name)),\n      )\n      continue\n    }\n    if derive.type_head(m.decl.ret) == \"Self\" {\n      if !derive.is_self(m.decl.body) {\n        return Err(\n          shape\n            + \" exports something other than the function itself (`= Self`): not built yet\",\n        )\n      }\n      mut exports.push((fname, given.function))\n    } else if derive.type_head(m.decl.ret) == \"String\" {\n      body := match derive.expr(mut x, m.decl.body) {\n        Ok(b) => b,\n        Err(e) => return Err(\"deriving `\" + m.decl.name + \"`: \" + e),\n      }\n      name := fname + \".\" + derive.short(tr.name) + \".\" + m.decl.name\n      mut made.push(\n        ast.FnDecl { ..m.decl, name, derived: false, compile_time: false, body },\n      )\n      mut files.push((m.decl.name, derive.qualify(x.module, name)))\n    } else {\n      return Err(\n        shape\n          + \" gives a `\"\n          + text.type_text(m.decl.ret)\n          + \"`: a derive for a function makes exports (`-> Self = Self`, or a wrapper taking parameters) and parts of files (`-> String`)\",\n      )\n    }\n  }\n  Ok((\n    ast.DeriveFnDecl { ..given, derived: false, exports, files },\n    made + x.copies,\n  ))\n}"},{"name":"derive.fn_value","kind":"fn","old":"1b0c8904754af05f","new":"674ec632edc62852","interface_changed":true,"affected":["derive.derive_fn","derive.derive_all","derive.derived_in","derive.expand_with","derive.expand_in","std_reached","expanded","check_errors_in","derive.expand","holes_command","check_summary","verified_decls","verify_file","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","eval_files","instantiated_files","with_extra","command_line","check_command","verified_with","static_graph","verify_command","build_proofs","alongside_command","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","repl_command","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","main","strata_command","verified_program","build_command","graph_command","graph_diff","run_command","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","or_solver_inputs","program_objects","package_errors","merge_file_command","merged_checks","core_rt_text","call_command","edit_command","check_files","rename_command","move_command","fix_command","edit_in_editor","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","smt_file","termination_file","diff_command","check_fn","linked","sync_command","build_core_command","computed_value","codegen.read_back","comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"/// The function `name` as a `std.typing.Type` of kind `Function`: its\n/// type's value with its name, doc and parameters by name. It is `Self`\n/// while deriving for it.\nfn fn_value(\n  mut x: derive.Expander,\n  name: String,\n  f: ast.FnDecl,\n  t: ast.TypeExpr,\n) -> ast.Expr {\n  base := derive.type_value(mut x, t)\n  mut stack := []\n  mut ps := []\n  for p in f.params {\n    mut ps.push(derive.field(mut x, p.name, [], p.ty, None, mut stack))\n  }\n  v := derive.set_field(\n    derive.set_field(derive.set_field(\n      base,\n      \"name\",\n      derive.some(ast.StrLit(derive.short(name))),\n    ), \"doc\", derive.strs(get(x.ix.docs, name) ?? [])),\n    \"parameters\",\n    ast.ListExpr(ps),\n  )\n  mut x.type_values.insert(text.type_text(t), v)\n  derive.remember(mut x, v, t)\n  v\n}","old_text":"/// The function `name` as a `std.typing.Type` of kind `Function`: its\n/// type's value with its name, doc and parameters by name. It is `Self`\n/// while deriving for it.\nfn fn_value(\n  mut x: derive.X,\n  name: String,\n  f: ast.FnDecl,\n  t: ast.TypeExpr,\n) -> ast.Expr {\n  base := derive.type_value(mut x, t)\n  mut stack := []\n  mut ps := []\n  for p in f.params {\n    mut ps.push(derive.field(mut x, p.name, [], p.ty, None, mut stack))\n  }\n  v := derive.set_field(\n    derive.set_field(derive.set_field(\n      base,\n      \"name\",\n      derive.some(ast.StrLit(derive.short(name))),\n    ), \"doc\", derive.strs(get(x.ix.docs, name) ?? [])),\n    \"parameters\",\n    ast.ListExpr(ps),\n  )\n  mut x.type_values.insert(text.type_text(t), v)\n  derive.remember(mut x, v, t)\n  v\n}"},{"name":"derive.call_fn","kind":"fn","old":"0449064ebbae2b91","new":"e9e32087302929fb","interface_changed":true,"affected":["derive.expr","derive.derive","derive.children","derive.field_read","derive.type_method","derive.with_known","derive.block","derive.comprehension","derive.call_copy","derive.derive_fn","derive.derive_all","derive.make","derive.match_type","derive.derived_in","derive.expand_with","derive.expand_in","std_reached","expanded","check_errors_in","derive.expand","holes_command","check_summary","verified_decls","verify_file","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","eval_files","instantiated_files","with_extra","command_line","check_command","verified_with","static_graph","verify_command","build_proofs","alongside_command","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","repl_command","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","main","strata_command","verified_program","build_command","graph_command","graph_diff","run_command","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","or_solver_inputs","program_objects","package_errors","merge_file_command","merged_checks","core_rt_text","call_command","edit_command","check_files","rename_command","move_command","fix_command","edit_in_editor","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","smt_file","termination_file","diff_command","check_fn","linked","sync_command","build_core_command","computed_value","codegen.read_back","comptime_value","comptime_values","comptime_runner"],"module":"derive","text":"/// `Self.call(p -> e)` or `Self.try_call(p -> e)` in a derive for a\n/// function described by `d`: a call of the function with `e` for each\n/// argument (`p` is that parameter, a `Field`; `p.type` its type).\n/// `try_call`: each argument is a `Result`; the first `Err` is the result,\n/// else `Ok` of the call's.\nfn call_fn(\n  mut x: derive.Expander,\n  d: ast.Expr,\n  fallible: Bool,\n  args: List[ast.Expr],\n) -> Result[ast.Expr, String] {\n  if derive.str_of(d, \"name\") != Some(derive.short(x.self_fn)) {\n    return Err(\n      \"`call` and `try_call` call the function the `derive` is for (`Self`)\",\n    )\n  }\n  params := match derive.get_field(d, \"parameters\") {\n    Some(ast.ListExpr(xs)) => xs,\n    _ => [],\n  }\n  mut vals := []\n  match args {\n    [ast.Lambda { params: [p], body }] => {\n      for f in params {\n        ft := match derive.get_field(f, \"type\") {\n          Some(tv) => match derive.type_of(x, tv) {\n            Ok(y) => Some((p.name + \".type\", y)),\n            Err(_) => None,\n          },\n          None => None,\n        }\n        mut vals.push(\n          derive.with_known(mut x, [(p.name, f, ft)], body)!,\n        )\n      }\n    },\n    [] => if params != [] {\n      return Err(\n        \"`call` takes a function giving each argument: `Self.call(p -> e)`\",\n      )\n    },\n    _ => return Err(\n      \"`call` takes a function giving each argument: `Self.call(p -> e)`\",\n    ),\n  }\n  if !fallible {\n    return Ok(ast.Call { callee: ast.Var(x.self_fn), args: vals })\n  }\n  // match a1 { Ok(v1) => match a2 { ... Ok(f(v1, ..)) }, Err(e) => Err(e) }\n  names := [f\"called.{k}\" for k in 0..len(vals)]\n  mut out := ast.CtorExpr { name: \"Ok\", args: ast.PositionalArgs([ast.Call {\n    callee: ast.Var(x.self_fn),\n    args: names.map(n -> ast.Var(n)),\n  }]) }\n  for k in 0..len(vals) {\n    j := len(vals) - 1 - k\n    out = ast.MatchExpr {\n      scrutinee: get(vals, j) ?? ast.UnitExpr,\n      binding: None,\n      arms: [ast.Arm { comments: [], pat: ast.CtorPattern {\n        name: \"Ok\",\n        args: ast.PositionalPats([ast.Bind(get(names, j) ?? \"\")]),\n      }, body: out }, ast.Arm { comments: [], pat: ast.CtorPattern {\n        name: \"Err\",\n        args: ast.PositionalPats([ast.Bind(\"called.err\")]),\n      }, body: ast.CtorExpr {\n        name: \"Err\",\n        args: ast.PositionalArgs([ast.Var(\"called.err\")]),\n      } }],\n    }\n  }\n  Ok(out)\n}","old_text":"/// `Self.call(p -> e)` or `Self.try_call(p -> e)` in a derive for a\n/// function described by `d`: a call of the function with `e` for each\n/// argument (`p` is that parameter, a `Field`; `p.type` its type).\n/// `try_call`: each argument is a `Result`; the first `Err` is the result,\n/// else `Ok` of the call's.\nfn call_fn(\n  mut x: derive.X,\n  d: ast.Expr,\n  fallible: Bool,\n  args: List[ast.Expr],\n) -> Result[ast.Expr, String] {\n  if derive.str_of(d, \"name\") != Some(derive.short(x.self_fn)) {\n    return Err(\n      \"`call` and `try_call` call the function the `derive` is for (`Self`)\",\n    )\n  }\n  params := match derive.get_field(d, \"parameters\") {\n    Some(ast.ListExpr(xs)) => xs,\n    _ => [],\n  }\n  mut vals := []\n  match args {\n    [ast.Lambda { params: [p], body }] => {\n      for f in params {\n        ft := match derive.get_field(f, \"type\") {\n          Some(tv) => match derive.type_of(x, tv) {\n            Ok(y) => Some((p.name + \".type\", y)),\n            Err(_) => None,\n          },\n          None => None,\n        }\n        mut vals.push(\n          derive.with_known(mut x, [(p.name, f, ft)], body)!,\n        )\n      }\n    },\n    [] => if params != [] {\n      return Err(\n        \"`call` takes a function giving each argument: `Self.call(p -> e)`\",\n      )\n    },\n    _ => return Err(\n      \"`call` takes a function giving each argument: `Self.call(p -> e)`\",\n    ),\n  }\n  if !fallible {\n    return Ok(ast.Call { callee: ast.Var(x.self_fn), args: vals })\n  }\n  // match a1 { Ok(v1) => match a2 { ... Ok(f(v1, ..)) }, Err(e) => Err(e) }\n  names := [f\"called.{k}\" for k in 0..len(vals)]\n  mut out := ast.CtorExpr { name: \"Ok\", args: ast.PositionalArgs([ast.Call {\n    callee: ast.Var(x.self_fn),\n    args: names.map(n -> ast.Var(n)),\n  }]) }\n  for k in 0..len(vals) {\n    j := len(vals) - 1 - k\n    out = ast.MatchExpr {\n      scrutinee: get(vals, j) ?? ast.UnitExpr,\n      binding: None,\n      arms: [ast.Arm { comments: [], pat: ast.CtorPattern {\n        name: \"Ok\",\n        args: ast.PositionalPats([ast.Bind(get(names, j) ?? \"\")]),\n      }, body: out }, ast.Arm { comments: [], pat: ast.CtorPattern {\n        name: \"Err\",\n        args: ast.PositionalPats([ast.Bind(\"called.err\")]),\n      }, body: ast.CtorExpr {\n        name: \"Err\",\n        args: ast.PositionalArgs([ast.Var(\"called.err\")]),\n      } }],\n    }\n  }\n  Ok(out)\n}"},{"name":"derive.X","kind":"type","old":"f48c533da4524b5c","new":null,"interface_changed":true,"affected":[],"module":"derive","old_text":"/// The state of specializing code for one `derive` or one `comptime e`.\ntype X = {\n  ix: derive.Defs,\n  w: eval.World,\n  // the module the generated code goes in\n  module: String,\n  // values known at compile time, by name (a `comptime` parameter, a\n  // `comptime for` element)\n  known: Dict[String, ast.Expr],\n  // types known at compile time, by name (`f.type`, `x` of `Option[x] =>`)\n  types: Dict[String, ast.TypeExpr],\n  // the type behind each `Type` value made, by the value's text\n  written: Dict[String, ast.TypeExpr],\n  // the type derived for (`()` when none)\n  self_ty: ast.TypeExpr,\n  copies: List[ast.FnDecl],\n  made: Dict[String, String],\n  // a variant's constructor, by its `Type` value's text\n  ctors: Dict[String, String],\n  // names bound inside the code being specialized, which hide known ones\n  hidden: List[List[String]],\n  // the type parameters of the type derived for (`T` of `Pair[T]`)\n  params: List[String],\n  trait_name: String,\n  trait_methods: List[String],\n  // each field's default, by its `Field` value's text\n  defaults: Dict[String, ast.Expr],\n  // each type's `Type` value, by the type's text\n  type_values: Dict[String, ast.Expr],\n  // in a match comprehension arm: the matched expression (as text) and the\n  // names its variant's fields are bound to\n  arm_fields: List[(String, List[(String, String)])],\n  // the function derived for, qualified (`derive Python for add`), which\n  // `Self.call(..)` calls. `\"\"` for a type's derive.\n  self_fn: String = \"\",\n}"},{"name":"derive.new_x","kind":"fn","old":"ee89cb0ae6278ef2","new":null,"interface_changed":true,"affected":[],"module":"derive","old_text":"fn new_x(ix: derive.Defs, w: eval.World, module: String) -> derive.X {\n  derive.X {\n    ix,\n    w,\n    module,\n    known: Dict[String, ast.Expr] {},\n    types: Dict[String, ast.TypeExpr] {},\n    written: Dict[String, ast.TypeExpr] {},\n    self_ty: ast.UnitType,\n    copies: [],\n    made: Dict[String, String] {},\n    ctors: Dict[String, String] {},\n    hidden: [],\n    params: [],\n    trait_name: \"\",\n    trait_methods: [],\n    defaults: Dict[String, ast.Expr] {},\n    type_values: Dict[String, ast.Expr] {},\n    arm_fields: [],\n  }\n}"}],"renames":[{"from":"derive.X","to":"derive.Expander","kind":"type"},{"from":"derive.new_x","to":"derive.new_expander","kind":"function"}],"references":["derive.derive_all","derive.fold_comptime","derive.type_value","derive.remember","derive.type_value_in","derive.variant_decl","derive.variant_value","derive.field","derive.unwhere","derive.is_variant","derive.type_of","derive.full","derive.kind_of","derive.distinct_head","derive.is_hidden","derive.is_known","derive.type_named","derive.base","derive.base_in","derive.eval_as","derive.eval_here","derive.with_self","derive.data","derive.data_in","derive.ctor_data","derive.derive","derive.ty","derive.children","derive.expr","derive.last_arm","derive.field_read","derive.type_method","derive.with_known","derive.make","derive.block","derive.comprehension","derive.arm_pattern","derive.check_code","derive.match_type","derive.fits","derive.call_copy","derive.named_union","derive.world_with_copies","derive.derive_fn","derive.fn_value","derive.call_fn"]}
{"id":"2445ca40cba5fb7f","time":1795651564,"message":"edit","changes":[{"name":"smt.methods_of","kind":"fn","old":"cc13bd360443488a","new":"ba41c954fb3f1c93","interface_changed":false,"affected":[],"module":"smt","text":"/// The traits of definitions, the types' own methods (an `impl` of no\n/// trait), and which functions a contract may see through.\npub fn methods_of(decls: List[ast.Decl]) -> smt.Methods {\n  mut traits := []\n  mut own := []\n  mut impls := []\n  mut core_traits := Set[String] {}\n  mut own_types := []\n  mut code_traits := Set[String] {}\n  for d in decls {\n    match d.kind {\n      ast.TraitDef(t) => {\n        mut traits.push(smt.models_qualified(t))\n        if starts_with(d.module, \"core.\") {\n          mut core_traits.insert(t.name)\n        }\n        if contains(\n          [\"core.iter\", \"core.channel\", \"core.text\", \"core.task\"],\n          d.module,\n        ) {\n          mut code_traits.insert(t.name)\n        }\n      },\n      ast.ImplDef(i) => if i.trait_name == \"\" {\n        own += i.methods\n        tn := match i.for_type {\n          ast.Named { name, .. } => name,\n          _ => \"\",\n        }\n        own_types += i.methods.map(m -> (tn, m.name))\n      } else {\n        mut impls.push(i)\n      },\n      _ => (),\n    }\n  }\n  (fns, types) := smt.tables(decls)\n  sigs := smt.builtins_of(decls)\n  m := smt.Methods {\n    traits,\n    own,\n    impls,\n    core_traits,\n    seen: Dict[String, smt.Seen] {},\n    own_types,\n    code_traits,\n    impl_seen: Dict[String, smt.Seen] {},\n    assumed: Set[String] {},\n    assumed_impls: Dict[String, String] {},\n    examples: false,\n    refined_types: Some(smt.refined_types(types)),\n  }\n  smt.Methods { ..m, seen: smt.transparency(smt.new_vc(fns, types, sigs, m)) }\n}","old_text":"/// The traits of definitions, the types' own methods (an `impl` of no\n/// trait), and which functions a contract may see through.\npub fn methods_of(decls: List[ast.Decl]) -> smt.Methods {\n  mut traits := []\n  mut own := []\n  mut impls := []\n  mut core_traits := Set[String] {}\n  mut own_types := []\n  mut code_traits := Set[String] {}\n  for d in decls {\n    match d.kind {\n      ast.TraitDef(t) => {\n        mut traits.push(t)\n        if starts_with(d.module, \"core.\") {\n          mut core_traits.insert(t.name)\n        }\n        if contains(\n          [\"core.iter\", \"core.channel\", \"core.text\", \"core.task\"],\n          d.module,\n        ) {\n          mut code_traits.insert(t.name)\n        }\n      },\n      ast.ImplDef(i) => if i.trait_name == \"\" {\n        own += i.methods\n        tn := match i.for_type {\n          ast.Named { name, .. } => name,\n          _ => \"\",\n        }\n        own_types += i.methods.map(m -> (tn, m.name))\n      } else {\n        mut impls.push(i)\n      },\n      _ => (),\n    }\n  }\n  (fns, types) := smt.tables(decls)\n  sigs := smt.builtins_of(decls)\n  m := smt.Methods {\n    traits,\n    own,\n    impls,\n    core_traits,\n    seen: Dict[String, smt.Seen] {},\n    own_types,\n    code_traits,\n    impl_seen: Dict[String, smt.Seen] {},\n    assumed: Set[String] {},\n    assumed_impls: Dict[String, String] {},\n    examples: false,\n    refined_types: Some(smt.refined_types(types)),\n  }\n  smt.Methods { ..m, seen: smt.transparency(smt.new_vc(fns, types, sigs, m)) }\n}"},{"name":"smt.models_qualified","kind":"fn","old":null,"new":"20c9cd771a6c072f","interface_changed":true,"affected":[],"module":"smt","text":"/// Trait `t` with its methods' contracts reading its models as its own\n/// (`self.items` is `self.Bounded::items()`), as `elaborate_call` reads the\n/// program's calls: a model may have a builtin's name (`items`, `keys`).\nfn models_qualified(t: ast.TraitDecl) -> ast.TraitDecl {\n  if len(t.models) == 0 {\n    return t\n  }\n  q := (e: ast.Expr) ->\n    walk.rewrite_expr(\n      e,\n      x ->\n        match x {\n          ast.MethodCall { recv, name: m, args: [] } => if t.models.any(d -> d.name == m) {\n            ast.MethodCall {\n              recv,\n              name: t.name + \"::\" + m,\n              args: [],\n            }\n          } else {\n            x\n          },\n          _ => x,\n        },\n    )\n  ast.TraitDecl { ..t, methods: t.methods.map(\n    tm ->\n      ast.TraitMethod { ..tm, decl: ast.FnDecl { ..tm.decl, pre: tm.decl.pre.map(q), post: tm.decl.post.map(q) } },\n  ) }\n}"}]}
{"id":"fc07ec6d76f8fbee","time":1795651632,"message":"edit","changes":[{"name":"smt.eval_expr","kind":"fn","old":"8061752780c70e91","new":"516e06e5bcae4890","interface_changed":false,"affected":[],"module":"smt","text":"fn eval_expr(mut vc: smt.Vc, e: ast.Expr, pol: Int) -> smt.Val {\n  if vc.dead {\n    return smt.UnitVal\n  }\n  match e {\n    ast.IntLit(n) => smt.VInt(smt.num(n)),\n    ast.BigIntLit(d) => smt.VInt(d),\n    ast.FloatLit(_) => smt.Opaque(\"floats are not modelled yet\"),\n    ast.StrLit(s) => if smt.smt_string(s) {\n      smt.VStr(smt.str_lit(s))\n    } else {\n      smt.Opaque(smt.beyond())\n    },\n    ast.BoolLit(b) => smt.VBool(if b {\n      \"true\"\n    } else {\n      \"false\"\n    }),\n    ast.UnitExpr => smt.UnitVal,\n    ast.TupleExpr(xs) => {\n      mut out := []\n      for x in xs {\n        mut out.push(smt.eval(mut vc, x))\n      }\n      smt.VTuple(out)\n    },\n    ast.Var(x) => match smt.lookup(vc, x) {\n      Some(v) => v,\n      None => smt.fn_name_value(mut vc, x),\n    },\n    ast.Hole(h) => smt.Opaque(f\"the hole `?{h}`\"),\n    ast.Range { .. } | ast.Index { .. } | ast.Comp { .. } | ast.DictExpr { .. } | ast.SetExpr { .. } => smt.Opaque(\"a range, slice or comprehension not desugared\"),\n    ast.MockExpr(t) => smt.Opaque(f\"`mock {text.type_text(t)}`\"),\n    ast.Spread(_) => smt.Opaque(\"a spread (`...x`) not written out\"),\n    ast.Select(_) => smt.Opaque(\"which arm of a `select` runs depends on timing\"),\n    ast.Race(_) => smt.Opaque(\"which arm of a `race` wins depends on timing\"),\n    // `mut xs.push(x)`: a builtin changing a list, dict or set\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => if builtins.changing(name) {\n      rv := smt.eval(mut vc, recv)\n      if smt.is_list(rv) {\n        smt.changed(mut vc, recv, rv, name, args)\n      } else {\n        smt.eval(mut vc, ast.MethodCall { recv, name, args })\n      }\n    } else {\n      smt.eval(mut vc, ast.MethodCall { recv, name, args })\n    },\n    ast.MutExpr(x) | ast.Comptime(x) | ast.Scope(x) | ast.Spawn(x) | ast.Await(x) | ast.Assumed(x) => smt.eval(mut vc, x),\n    // `old e`: `e` over the values before (at the function's start, or a\n    // callee's arguments before the call)\n    ast.Old(x) => match vc.olds {\n      Some(before) => {\n        saved := vc.scopes\n        vc.scopes = smt.old_scopes(before, saved)\n        vc.olds = None\n        v := smt.eval(mut vc, x)\n        vc.olds = Some(before)\n        vc.scopes = saved\n        v\n      },\n      None => {\n        smt.gap(mut vc, \"`old` outside an `ensures`\")\n        smt.Opaque(\"`old` outside an `ensures`\")\n      },\n    },\n    ast.SupervisedSpawn(_) => smt.Opaque(\"a supervised task's result (it may have panicked)\"),\n    ast.Interp(parts) => smt.interpolated(mut vc, parts),\n    ast.Return(x) => {\n      v := smt.eval(mut vc, x)\n      smt.early_return(mut vc, v)\n      smt.UnitVal\n    },\n    ast.Try { value, kind } => {\n      v := smt.eval(mut vc, value)\n      ok_name := match kind {\n        ast.TryResult => \"Ok\",\n        ast.TryOption => \"Some\",\n      }\n      match (v, smt.ctor_index(v, ok_name)) {\n        (smt.VSum { tag, ctors, .. }, Some(k)) => {\n          ok := f\"(= {tag} {k})\"\n          payload := get((get(ctors, k) ?? (\"\", [])).1, 0) ?? smt.Opaque(\"the payload of `Ok` / `Some`\")\n          // the error (or `None`) leaves the function as it is\n          n := len(vc.pc)\n          mut vc.pc.push(smt.neg(ok))\n          smt.early_return(mut vc, v)\n          vc.dead = false\n          vc.pc = take(vc.pc, n) + [ok]\n          payload\n        },\n        _ => {\n          n := len(vc.pc)\n          smt.early_return(\n            mut vc,\n            smt.Opaque(\"an early return through `!` / `?`\"),\n          )\n          vc.dead = false\n          vc.pc = take(vc.pc, n)\n          smt.Opaque(\"the value under `!` / `?`\")\n        },\n      }\n    },\n    ast.Except { value, err, fallback } => smt.fallback_value(mut vc, value, err, fallback),\n    ast.Fallback { value, fallback } => smt.fallback_value(mut vc, value, None, fallback),\n    ast.FieldOf { base, name } => {\n      v := smt.eval(mut vc, base)\n      smt.field(mut vc, v, name)\n    },\n    ast.Unary { op, operand } => {\n      v := match op {\n        ast.Not => smt.eval_pol(mut vc, operand, 0 - pol),\n        ast.Neg => smt.eval(mut vc, operand),\n      }\n      match op {\n        ast.Neg => match (v, smt.word_of(v)) {\n          (smt.VInt(t), _) => smt.VInt(f\"(- {t})\"),\n          (_, Some(w)) => {\n            t := smt.as_int(mut vc, v)\n            smt.word(w, smt.wrap_term(w, f\"(- {t})\"))\n          },\n          (other, _) => other,\n        },\n        ast.Not => smt.VBool(smt.neg(smt.as_bool(mut vc, v))),\n      }\n    },\n    ast.Binary { op, left, right } => smt.binary(mut vc, op, left, right, pol),\n    ast.IsExpr { value, variant } => {\n      v := smt.eval(mut vc, value)\n      if !contains(vc.ctors, variant) && smt.is_type_name(vc, variant) {\n        smt.VBool(smt.in_type(mut vc, smt.named(variant), v, []))\n      } else {\n        smt.VBool(smt.is_ctor(mut vc, v, variant))\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => {\n      cv := smt.eval(mut vc, cond)\n      c := smt.as_bool(mut vc, cv)\n      vc.polarity = pol\n      r := smt.branches(\n        mut vc,\n        [(c, [], then), (smt.neg(c), [], otherwise)],\n      )\n      vc.polarity = 0\n      r\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      v := smt.eval(mut vc, scrutinee)\n      mut prev := []\n      mut alts := []\n      mut narrow := []\n      for a in arms {\n        // a union narrowed to the one member the arm's pattern can match\n        member := match v {\n          smt.VUnion { slots, .. } => match smt.arm_slots(mut vc, a.pat, slots) {\n            [i] => Some((get(slots, i) ?? (\"\", smt.Inactive)).1),\n            _ => None,\n          },\n          _ => None,\n        }\n        mut narrow.push(\n          match (scrutinee, member) {\n            (ast.Var(x), Some(m)) => match smt.lookup(vc, x) {\n              Some(_) => [(x, m)],\n              None => [],\n            },\n            _ => [],\n          },\n        )\n        mut binds := match binding {\n          Some(n) => [(n, member ?? v)],\n          None => [],\n        }\n        n := len(vc.pc)\n        vc.pc += prev.map(p -> smt.neg(p))\n        cond := smt.pattern(mut vc, a.pat, v, mut binds)\n        vc.pc = take(vc.pc, n)\n        mut alts.push(\n          (\n            smt.and_all(prev.map(p -> smt.neg(p)) + [cond]),\n            binds,\n            a.body,\n          ),\n        )\n        mut prev.push(cond)\n      }\n      // arms with conditions the checker can't decide: some arm must match\n      // (else compiled code faults with `no match arm`)\n      if arms.any(a -> smt.undecided(vc, a.pat)) {\n        if smt.start_goal(mut vc) {\n          smt.oblige(\n            mut vc,\n            \"some arm of the `match` matches\",\n            smt.or_all(prev),\n          )\n        }\n      }\n      vc.polarity = pol\n      r := smt.branches_narrowed(mut vc, alts, narrow)\n      vc.polarity = 0\n      r\n    },\n    ast.Block { stmts, last } => {\n      mut vc.scopes.push(Dict[String, smt.Val] {})\n      for s in stmts {\n        smt.stmt(mut vc, s)\n        if vc.dead {\n          break\n        }\n      }\n      v := smt.eval_pol(mut vc, last, pol)\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      v\n    },\n    ast.CtorExpr { name, args } => smt.ctor(mut vc, name, args),\n    ast.Call { callee, args } => match callee {\n      ast.Var(name) => match smt.lookup(vc, name) {\n        None => {\n          vc.call_pol = pol\n          smt.call_exprs(mut vc, name, args)\n        },\n        Some(f) => smt.call_value(mut vc, f, args),\n      },\n      _ => {\n        smt.gap(mut vc, \"calling a function value\")\n        smt.Opaque(\"calling a function value\")\n      },\n    },\n    ast.MethodCall { recv, name, args } => {\n      // a method called on a type (`T.empty()`): a static method, the type\n      // only picking the implementation\n      on_type := match recv {\n        // a record's name is both its type's and its constructor's\n        ast.CtorExpr { name: t, args: ast.NoArgs } => !contains(vc.ctors, t) || contains(vc.types, t),\n        _ => false,\n      }\n      if on_type {\n        t := match recv {\n          ast.CtorExpr { name: n, .. } => n,\n          _ => \"\",\n        }\n        smt.static_call(mut vc, t, name, args)\n      } else if contains(vc.fns, name) && smt.own_method_of(vc, recv, name) {\n        // `k.bump()` where `k`'s type has its own method `bump`: that\n        // method, not the function of that name\n        rv := smt.eval(mut vc, recv)\n        mut vals := [rv]\n        for a in args {\n          mut vals.push(smt.eval(mut vc, a))\n        }\n        smt.method_call(mut vc, name, [recv] + args, vals) or {\n          smt.Opaque(\n            f\"the result of method `{name}` (it depends on the receiver's type)\",\n          )\n        }\n      } else {\n        vc.call_pol = pol\n        smt.call_exprs(mut vc, name, [recv] + args)\n      }\n    },\n    ast.ListExpr(xs) => {\n      mut vals := []\n      for x in xs {\n        mut vals.push(smt.eval(mut vc, x))\n      }\n      smt.new_list(mut vc, f\"{len(xs)}\", smt.GValues(vals))\n    },\n    ast.Lambda { .. } => smt.fn_value(mut vc, e, []).0,\n  }\n}","old_text":"fn eval_expr(mut vc: smt.Vc, e: ast.Expr, pol: Int) -> smt.Val {\n  if vc.dead {\n    return smt.UnitVal\n  }\n  match e {\n    ast.IntLit(n) => smt.VInt(smt.num(n)),\n    ast.BigIntLit(d) => smt.VInt(d),\n    ast.FloatLit(_) => smt.Opaque(\"floats are not modelled yet\"),\n    ast.StrLit(s) => if smt.smt_string(s) {\n      smt.VStr(smt.str_lit(s))\n    } else {\n      smt.Opaque(smt.beyond())\n    },\n    ast.BoolLit(b) => smt.VBool(if b {\n      \"true\"\n    } else {\n      \"false\"\n    }),\n    ast.UnitExpr => smt.UnitVal,\n    ast.TupleExpr(xs) => {\n      mut out := []\n      for x in xs {\n        mut out.push(smt.eval(mut vc, x))\n      }\n      smt.VTuple(out)\n    },\n    ast.Var(x) => match smt.lookup(vc, x) {\n      Some(v) => v,\n      None => smt.fn_name_value(mut vc, x),\n    },\n    ast.Hole(h) => smt.Opaque(f\"the hole `?{h}`\"),\n    ast.Range { .. } | ast.Index { .. } | ast.Comp { .. } | ast.DictExpr { .. } | ast.SetExpr { .. } => smt.Opaque(\"a range, slice or comprehension not desugared\"),\n    ast.MockExpr(t) => smt.Opaque(f\"`mock {text.type_text(t)}`\"),\n    ast.Spread(_) => smt.Opaque(\"a spread (`...x`) not written out\"),\n    ast.Select(_) => smt.Opaque(\"which arm of a `select` runs depends on timing\"),\n    ast.Race(_) => smt.Opaque(\"which arm of a `race` wins depends on timing\"),\n    // `mut xs.push(x)`: a builtin changing a list, dict or set\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => if builtins.changing(name) {\n      rv := smt.eval(mut vc, recv)\n      if smt.is_list(rv) {\n        smt.changed(mut vc, recv, rv, name, args)\n      } else {\n        smt.eval(mut vc, ast.MethodCall { recv, name, args })\n      }\n    } else {\n      smt.eval(mut vc, ast.MethodCall { recv, name, args })\n    },\n    ast.MutExpr(x) | ast.Comptime(x) | ast.Scope(x) | ast.Spawn(x) | ast.Await(x) | ast.Assumed(x) => smt.eval(mut vc, x),\n    // `old e`: `e` over the values before (at the function's start, or a\n    // callee's arguments before the call)\n    ast.Old(x) => match vc.olds {\n      Some(before) => {\n        saved := vc.scopes\n        vc.scopes = smt.old_scopes(before, saved)\n        vc.olds = None\n        v := smt.eval(mut vc, x)\n        vc.olds = Some(before)\n        vc.scopes = saved\n        v\n      },\n      None => {\n        smt.gap(mut vc, \"`old` outside an `ensures`\")\n        smt.Opaque(\"`old` outside an `ensures`\")\n      },\n    },\n    ast.SupervisedSpawn(_) => smt.Opaque(\"a supervised task's result (it may have panicked)\"),\n    ast.Interp(parts) => {\n      for part in parts {\n        match part {\n          ast.ValuePart { value, .. } => {\n            _ := smt.eval(mut vc, value)\n          },\n          ast.TextPart(_) => (),\n        }\n      }\n      smt.VStr(smt.fresh_why(\n        mut vc,\n        \"String\",\n        \"f-strings (only their parts are checked)\",\n      ))\n    },\n    ast.Return(x) => {\n      v := smt.eval(mut vc, x)\n      smt.early_return(mut vc, v)\n      smt.UnitVal\n    },\n    ast.Try { value, kind } => {\n      v := smt.eval(mut vc, value)\n      ok_name := match kind {\n        ast.TryResult => \"Ok\",\n        ast.TryOption => \"Some\",\n      }\n      match (v, smt.ctor_index(v, ok_name)) {\n        (smt.VSum { tag, ctors, .. }, Some(k)) => {\n          ok := f\"(= {tag} {k})\"\n          payload := get((get(ctors, k) ?? (\"\", [])).1, 0) ?? smt.Opaque(\"the payload of `Ok` / `Some`\")\n          // the error (or `None`) leaves the function as it is\n          n := len(vc.pc)\n          mut vc.pc.push(smt.neg(ok))\n          smt.early_return(mut vc, v)\n          vc.dead = false\n          vc.pc = take(vc.pc, n) + [ok]\n          payload\n        },\n        _ => {\n          n := len(vc.pc)\n          smt.early_return(\n            mut vc,\n            smt.Opaque(\"an early return through `!` / `?`\"),\n          )\n          vc.dead = false\n          vc.pc = take(vc.pc, n)\n          smt.Opaque(\"the value under `!` / `?`\")\n        },\n      }\n    },\n    ast.Except { value, err, fallback } => smt.fallback_value(mut vc, value, err, fallback),\n    ast.Fallback { value, fallback } => smt.fallback_value(mut vc, value, None, fallback),\n    ast.FieldOf { base, name } => {\n      v := smt.eval(mut vc, base)\n      smt.field(mut vc, v, name)\n    },\n    ast.Unary { op, operand } => {\n      v := match op {\n        ast.Not => smt.eval_pol(mut vc, operand, 0 - pol),\n        ast.Neg => smt.eval(mut vc, operand),\n      }\n      match op {\n        ast.Neg => match (v, smt.word_of(v)) {\n          (smt.VInt(t), _) => smt.VInt(f\"(- {t})\"),\n          (_, Some(w)) => {\n            t := smt.as_int(mut vc, v)\n            smt.word(w, smt.wrap_term(w, f\"(- {t})\"))\n          },\n          (other, _) => other,\n        },\n        ast.Not => smt.VBool(smt.neg(smt.as_bool(mut vc, v))),\n      }\n    },\n    ast.Binary { op, left, right } => smt.binary(mut vc, op, left, right, pol),\n    ast.IsExpr { value, variant } => {\n      v := smt.eval(mut vc, value)\n      if !contains(vc.ctors, variant) && smt.is_type_name(vc, variant) {\n        smt.VBool(smt.in_type(mut vc, smt.named(variant), v, []))\n      } else {\n        smt.VBool(smt.is_ctor(mut vc, v, variant))\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => {\n      cv := smt.eval(mut vc, cond)\n      c := smt.as_bool(mut vc, cv)\n      vc.polarity = pol\n      r := smt.branches(\n        mut vc,\n        [(c, [], then), (smt.neg(c), [], otherwise)],\n      )\n      vc.polarity = 0\n      r\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      v := smt.eval(mut vc, scrutinee)\n      mut prev := []\n      mut alts := []\n      mut narrow := []\n      for a in arms {\n        // a union narrowed to the one member the arm's pattern can match\n        member := match v {\n          smt.VUnion { slots, .. } => match smt.arm_slots(mut vc, a.pat, slots) {\n            [i] => Some((get(slots, i) ?? (\"\", smt.Inactive)).1),\n            _ => None,\n          },\n          _ => None,\n        }\n        mut narrow.push(\n          match (scrutinee, member) {\n            (ast.Var(x), Some(m)) => match smt.lookup(vc, x) {\n              Some(_) => [(x, m)],\n              None => [],\n            },\n            _ => [],\n          },\n        )\n        mut binds := match binding {\n          Some(n) => [(n, member ?? v)],\n          None => [],\n        }\n        n := len(vc.pc)\n        vc.pc += prev.map(p -> smt.neg(p))\n        cond := smt.pattern(mut vc, a.pat, v, mut binds)\n        vc.pc = take(vc.pc, n)\n        mut alts.push(\n          (\n            smt.and_all(prev.map(p -> smt.neg(p)) + [cond]),\n            binds,\n            a.body,\n          ),\n        )\n        mut prev.push(cond)\n      }\n      // arms with conditions the checker can't decide: some arm must match\n      // (else compiled code faults with `no match arm`)\n      if arms.any(a -> smt.undecided(vc, a.pat)) {\n        if smt.start_goal(mut vc) {\n          smt.oblige(\n            mut vc,\n            \"some arm of the `match` matches\",\n            smt.or_all(prev),\n          )\n        }\n      }\n      vc.polarity = pol\n      r := smt.branches_narrowed(mut vc, alts, narrow)\n      vc.polarity = 0\n      r\n    },\n    ast.Block { stmts, last } => {\n      mut vc.scopes.push(Dict[String, smt.Val] {})\n      for s in stmts {\n        smt.stmt(mut vc, s)\n        if vc.dead {\n          break\n        }\n      }\n      v := smt.eval_pol(mut vc, last, pol)\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      v\n    },\n    ast.CtorExpr { name, args } => smt.ctor(mut vc, name, args),\n    ast.Call { callee, args } => match callee {\n      ast.Var(name) => match smt.lookup(vc, name) {\n        None => {\n          vc.call_pol = pol\n          smt.call_exprs(mut vc, name, args)\n        },\n        Some(f) => smt.call_value(mut vc, f, args),\n      },\n      _ => {\n        smt.gap(mut vc, \"calling a function value\")\n        smt.Opaque(\"calling a function value\")\n      },\n    },\n    ast.MethodCall { recv, name, args } => {\n      // a method called on a type (`T.empty()`): a static method, the type\n      // only picking the implementation\n      on_type := match recv {\n        // a record's name is both its type's and its constructor's\n        ast.CtorExpr { name: t, args: ast.NoArgs } => !contains(vc.ctors, t) || contains(vc.types, t),\n        _ => false,\n      }\n      if on_type {\n        t := match recv {\n          ast.CtorExpr { name: n, .. } => n,\n          _ => \"\",\n        }\n        smt.static_call(mut vc, t, name, args)\n      } else if contains(vc.fns, name) && smt.own_method_of(vc, recv, name) {\n        // `k.bump()` where `k`'s type has its own method `bump`: that\n        // method, not the function of that name\n        rv := smt.eval(mut vc, recv)\n        mut vals := [rv]\n        for a in args {\n          mut vals.push(smt.eval(mut vc, a))\n        }\n        smt.method_call(mut vc, name, [recv] + args, vals) or {\n          smt.Opaque(\n            f\"the result of method `{name}` (it depends on the receiver's type)\",\n          )\n        }\n      } else {\n        vc.call_pol = pol\n        smt.call_exprs(mut vc, name, [recv] + args)\n      }\n    },\n    ast.ListExpr(xs) => {\n      mut vals := []\n      for x in xs {\n        mut vals.push(smt.eval(mut vc, x))\n      }\n      smt.new_list(mut vc, f\"{len(xs)}\", smt.GValues(vals))\n    },\n    ast.Lambda { .. } => smt.fn_value(mut vc, e, []).0,\n  }\n}"},{"name":"smt.interpolated","kind":"fn","old":null,"new":"efe33cc9e0f86819","interface_changed":true,"affected":[],"module":"smt","text":"/// An f-string: its text parts and each value's text joined. A `String`\n/// value without a format spec is its own text. Any other value's text is\n/// an unknown string.\nfn interpolated(mut vc: smt.Vc, parts: List[ast.StrPart]) -> smt.Val {\n  mut pieces := []\n  for part in parts {\n    match part {\n      ast.ValuePart { value, spec } => {\n        v := smt.eval(mut vc, value)\n        mut pieces.push(\n          match (v, spec) {\n            (smt.VStr(t), None) => t,\n            _ => smt.fresh_why(\n              mut vc,\n              \"String\",\n              \"f-strings (only the text of their `String` parts is known)\",\n            ),\n          },\n        )\n      },\n      ast.TextPart(s) => mut pieces.push(\n        if smt.smt_string(s) {\n          smt.str_lit(s)\n        } else {\n          smt.fresh_why(\n            mut vc,\n            \"String\",\n            \"f-strings (only the text of their `String` parts is known)\",\n          )\n        },\n      ),\n    }\n  }\n  match pieces {\n    [] => smt.VStr(\"\\\"\\\"\"),\n    [one] => smt.VStr(one),\n    _ => smt.VStr(\"(str.++ \" + join(pieces, \" \") + \")\"),\n  }\n}"}]}
{"id":"0362d89142d00205","time":1795652019,"message":"edit","changes":[{"name":"skill.skill_text","kind":"fn","old":"517d6a191af32bb7","new":"177ea51faaa8a233","interface_changed":false,"affected":[],"module":"skill","text":"/// The text of `SKILL.md`.\npub fn skill_text() -> String {\n  join(\n    [\n      \"---\",\n      \"name: strata\",\n      \"description: Read, change, check and verify Strata code (.strata files, strata.toml packages) through the `strata` command. Use whenever a task touches Strata code.\",\n      \"---\",\n      \"\",\n      \"# Strata\",\n      \"\",\n      \"Strata code is stored as its syntax tree: `.strata` files are binary. Never read or\",\n      \"write them directly (no cat, grep, sed or file-editing tools on them): go through\",\n      \"`strata`, which shows code as text and takes text back, checked. `strata help` lists\",\n      \"every command and its options; this is only a map.\",\n      \"\",\n      \"In a package (a folder with `strata.toml`) commands work on the package; for a\",\n      \"single file or another folder, put `--file PATH` before the command.\",\n      \"\",\n      \"## Reading\",\n      \"\",\n      \"- `strata view`: the package's map, one line per definition.\",\n      \"- `strata view NAME --level 2`: definitions as source (`NAME`: a name, `prefix*`,\",\n      \"  `module:M`, `a,b`); `--level 1` their interfaces. `strata view MODULE`: a module as text.\",\n      \"- `strata find NAME`: where it is defined. `strata refs NAME`: where it is used.\",\n      \"- Builtins and std too: `strata view Dict`, `strata view insert` (every overload),\",\n      \"  `strata view std.json.parse` show their docs and signatures, also outside a package.\",\n      \"  A builtin's doc ends with its cost (`Cost: O(1) amortized, in place when ...`): read\",\n      \"  it instead of benchmarking. Where a value is copied instead of changed in place:\",\n      \"  the language docs' \\\"Values and copying\\\", and the `--copies` option (`strata help`).\",\n      \"\",\n      \"## Changing\",\n      \"\",\n      \"- `strata edit MODULE <<'EOF' … EOF`: replaces or adds the definitions given, by name\",\n      \"  (always pipe them in: with nothing on stdin it opens $EDITOR and waits). Give a\",\n      \"  definition with its `///` doc lines, or they are dropped; `--rm NAME`\",\n      \"  deletes one. It is applied only if the whole codebase still checks.\",\n      \"- `strata rename OLD NEW`, `strata move NAME MODULE`: with every reference.\",\n      \"- `strata fix [NAME]`: makes the changes `check` and `edit` warn about (a contract\",\n      \"  that is a refinement: what one value is goes in its type, contracts relate values).\",\n      \"- An edit that breaks other code opens a pending change with holes (`?pending_N`):\",\n      \"  `strata status`, `strata holes`, then `strata done` or `strata abort`.\",\n      \"\",\n      \"## Checking\",\n      \"\",\n      \"- `strata check`: types, exhaustive matches, refinements.\",\n      \"- `strata verify [SELECTOR]`: proves contracts (`requires`, `ensures`, `where`\",\n      \"  refinements, trait laws) with an SMT solver, runs counterexamples, fuzzes the rest.\",\n      \"  Verify what you changed, by name (`strata verify 'shop.total'`), not everything.\",\n      \"- `strata test [FILTER]`: the `test \\\"…\\\" { … }` blocks. `strata run [-- ARGS]`,\",\n      \"  `strata run FN ARGS`: run the program or one function. `strata build`: an executable\",\n      \"  (it verifies first: `--no-verify` for a throwaway build, such as a benchmark).\",\n      \"\",\n      \"## The language, roughly\",\n      \"\",\n      \"```\",\n      \"type Port = Int where it > 0 && it < 65536\",\n      \"type Shape = | Square(Int) | Rect { w: Int, h: Int }\",\n      \"\",\n      \"fn area(s: Shape) -> Int {\",\n      \"  match s {\",\n      \"    Square(side) => side * side,\",\n      \"    Rect { w, h } => w * h,\",\n      \"  }\",\n      \"}\",\n      \"\",\n      \"fn get(xs: List[Int], i: Int) -> Int requires i >= 0 && i < len(xs) = xs[i]\",\n      \"```\",\n      \"\",\n      \"`x := e` names a value, `mut x := e` a variable. Failures are values: a `Result` or\",\n      \"`Option`, passed up with `!` / `?` (no exceptions). What touches the outside world\",\n      \"(`Console`, `Disk`, `Process`) is a capability passed as a parameter, starting from\",\n      \"`main`'s. Prefer contracts and refinements proven by `verify` to example tests.\",\n      \"\",\n      \"## Contracts: say what things mean\",\n      \"\",\n      \"A fact about one value is its type (`price: Cents where it >= 100`, `-> Natural`);\",\n      \"a contract (`requires`, `ensures`) relates values. For state behind a trait, give the\",\n      \"trait a `model` and write its contracts over it, instead of piling facts on each\",\n      \"function's inputs and outputs:\",\n      \"\",\n      \"```\",\n      \"trait Bounded {\",\n      \"  model items: List[Int]\",\n      \"  model room: Positive\",\n      \"  invariant len(self.items) <= self.room   // every value; each method keeps it\",\n      \"  ensures self.room == old self.room       // after every `mut self` method\",\n      \"\",\n      \"  fn size(self) -> Natural  ensures it == len(self.items)\",\n      \"  fn put(mut self, x: Int) -> Bool\",\n      \"    ensures it == (old len(self.items) < self.room)\",\n      \"    ensures self.items == if it { old self.items + [x] } else { old self.items }\",\n      \"}\",\n      \"\",\n      \"impl Bounded for Slots {\",\n      \"  model items = self.held\",\n      \"  model room = self.limit\",\n      \"  ...\",\n      \"}\",\n      \"```\",\n      \"\",\n      \"`verify` proves each `impl` against the model, and code taking a `Bounded` through\",\n      \"the model alone. Also: `law`s (a block of calls ending in a `Bool`), named results\",\n      \"(`-> (q: Natural, r: Natural)`), `shared trait` for state many workers use, and\",\n      \"`assumed` for a contract too costly to check at run time. Examples:\",\n      \"`examples/traits.strata`, `bank.strata`, `orders.strata` and `tasks/` at\",\n      \"github.com/anonx3247/strata.\",\n      \"\",\n    ],\n    \"\\n\",\n  )\n}","old_text":"/// The text of `SKILL.md`.\npub fn skill_text() -> String {\n  join(\n    [\n      \"---\",\n      \"name: strata\",\n      \"description: Read, change, check and verify Strata code (.strata files, strata.toml packages) through the `strata` command. Use whenever a task touches Strata code.\",\n      \"---\",\n      \"\",\n      \"# Strata\",\n      \"\",\n      \"Strata code is stored as its syntax tree: `.strata` files are binary. Never read or\",\n      \"write them directly (no cat, grep, sed or file-editing tools on them): go through\",\n      \"`strata`, which shows code as text and takes text back, checked. `strata help` lists\",\n      \"every command and its options; this is only a map.\",\n      \"\",\n      \"In a package (a folder with `strata.toml`) commands work on the package; for a\",\n      \"single file or another folder, put `--file PATH` before the command.\",\n      \"\",\n      \"## Reading\",\n      \"\",\n      \"- `strata view`: the package's map, one line per definition.\",\n      \"- `strata view NAME --level 2`: definitions as source (`NAME`: a name, `prefix*`,\",\n      \"  `module:M`, `a,b`); `--level 1` their interfaces. `strata view MODULE`: a module as text.\",\n      \"- `strata find NAME`: where it is defined. `strata refs NAME`: where it is used.\",\n      \"- Builtins and std too: `strata view Dict`, `strata view insert` (every overload),\",\n      \"  `strata view std.json.parse` show their docs and signatures, also outside a package.\",\n      \"  A builtin's doc ends with its cost (`Cost: O(1) amortized, in place when ...`): read\",\n      \"  it instead of benchmarking. Where a value is copied instead of changed in place:\",\n      \"  the language docs' \\\"Values and copying\\\", and the `--copies` option (`strata help`).\",\n      \"\",\n      \"## Changing\",\n      \"\",\n      \"- `strata edit MODULE <<'EOF' … EOF`: replaces or adds the definitions given, by name\",\n      \"  (always pipe them in: with nothing on stdin it opens $EDITOR and waits). Give a\",\n      \"  definition with its `///` doc lines, or they are dropped; `--rm NAME`\",\n      \"  deletes one. It is applied only if the whole codebase still checks.\",\n      \"- `strata rename OLD NEW`, `strata move NAME MODULE`: with every reference.\",\n      \"- `strata fix [NAME]`: makes the changes `check` and `edit` warn about (a contract\",\n      \"  that is a refinement: what one value is goes in its type, contracts relate values).\",\n      \"- An edit that breaks other code opens a pending change with holes (`?pending_N`):\",\n      \"  `strata status`, `strata holes`, then `strata done` or `strata abort`.\",\n      \"\",\n      \"## Checking\",\n      \"\",\n      \"- `strata check`: types, exhaustive matches, refinements.\",\n      \"- `strata verify [SELECTOR]`: proves contracts (`requires`, `ensures`, `where`\",\n      \"  refinements, trait laws) with an SMT solver, runs counterexamples, fuzzes the rest.\",\n      \"  Verify what you changed, by name (`strata verify 'shop.total'`), not everything.\",\n      \"- `strata test [FILTER]`: the `test \\\"…\\\" { … }` blocks. `strata run [-- ARGS]`,\",\n      \"  `strata run FN ARGS`: run the program or one function. `strata build`: an executable\",\n      \"  (it verifies first: `--no-verify` for a throwaway build, such as a benchmark).\",\n      \"\",\n      \"## The language, roughly\",\n      \"\",\n      \"```\",\n      \"type Port = Int where it > 0 && it < 65536\",\n      \"type Shape = | Square(Int) | Rect { w: Int, h: Int }\",\n      \"\",\n      \"fn area(s: Shape) -> Int {\",\n      \"  match s {\",\n      \"    Square(side) => side * side,\",\n      \"    Rect { w, h } => w * h,\",\n      \"  }\",\n      \"}\",\n      \"\",\n      \"fn get(xs: List[Int], i: Int) -> Int requires i >= 0 && i < len(xs) = xs[i]\",\n      \"```\",\n      \"\",\n      \"`x := e` names a value, `mut x := e` a variable. Failures are values: a `Result` or\",\n      \"`Option`, passed up with `!` / `?` (no exceptions). What touches the outside world\",\n      \"(`Console`, `Disk`, `Process`) is a capability passed as a parameter, starting from\",\n      \"`main`'s. Prefer contracts and refinements proven by `verify` to example tests.\",\n      \"\",\n    ],\n    \"\\n\",\n  )\n}"}]}
