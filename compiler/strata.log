alue","codegen.lambda","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.check_field","codegen.assign_at","codegen.check_union","codegen.check_member","codegen.show","codegen.shown","codegen.string_builtin","codegen.host","codegen.spawn_expr","codegen.method_value","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","codegen.read_back","eval_files","codegen.helper","codegen.debug_body","codegen.equal","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// A list of generated elements (pairs for a dict), then the set or dict\n/// made from it.\nfn gen_list(\n  mut g: codegen.Gen,\n  n: String,\n  args: List[ast.TypeExpr],\n  ty: check.Ty,\n  h: codegen.Hints,\n) -> codegen.V {\n  el := if n == \"Dict\" {\n    ast.Named { name: \"Tuple\", args }\n  } else {\n    get(args, 0) ?? ast.UnitType\n  }\n  et := codegen.lower(mut g, el)\n  lt := check.TList(et)\n  deep := codegen.too_deep(mut g)\n  l := codegen.fresh(mut g, \"len\")\n  any := codegen.fresh(mut g, \"len\")\n  if n == \"List\" {\n    (tbl, k) := codegen.pairs_table(mut g, codegen.bounded(h.lens, 0, 4))\n    shortest := match get(h.lens, 0) {\n      Some((lo, _)) => if lo > 0 {\n        lo\n      } else {\n        0\n      },\n      None => 0,\n    }\n    codegen.use_rt(mut g, \"strata_gen_len\")\n    codegen.emit(\n      mut g,\n      f\"{any} = call i64 @strata_gen_len(ptr {tbl}, i64 {k})\",\n    )\n    codegen.emit(\n      mut g,\n      f\"{l} = select i1 {deep}, i64 {shortest}, i64 {any}\",\n    )\n  } else {\n    codegen.use_rt(mut g, \"strata_random\")\n    codegen.emit(\n      mut g,\n      f\"{any} = call i64 @strata_random(i64 0, i64 4)\",\n    )\n    codegen.emit(mut g, f\"{l} = select i1 {deep}, i64 0, i64 {any}\")\n  }\n  d := codegen.deeper(mut g)\n  codegen.use_rt(mut g, \"strata_list_new\")\n  codegen.use_rt(mut g, \"strata_list_push\")\n  acc := codegen.fresh(mut g, \"acc\")\n  mut g.allocas.push(f\"  {acc} = alloca ptr\")\n  l0 := codegen.call_bare(\n    mut g,\n    lt,\n    \"@strata_list_new\",\n    [codegen.V { ty: check.TInt, op: l }],\n  )\n  codegen.emit(mut g, f\"store ptr {l0.op}, ptr {acc}\")\n  counter := codegen.fresh(mut g, \"k\")\n  mut g.allocas.push(f\"  {counter} = alloca i64\")\n  codegen.emit(mut g, f\"store i64 0, ptr {counter}\")\n  (head, body, end) := (\n    codegen.label(mut g, \"gen.each\"),\n    codegen.label(mut g, \"gen.el\"),\n    codegen.label(mut g, \"gen.done\"),\n  )\n  codegen.br(mut g, head)\n  codegen.block(mut g, head)\n  (i, more, i1) := (\n    codegen.fresh(mut g, \"i\"),\n    codegen.fresh(mut g, \"more\"),\n    codegen.fresh(mut g, \"i\"),\n  )\n  codegen.emit(mut g, f\"{i} = load i64, ptr {counter}\")\n  codegen.emit(mut g, f\"{more} = icmp slt i64 {i}, {l}\")\n  codegen.emit(mut g, f\"br i1 {more}, label %{body}, label %{end}\")\n  codegen.block(mut g, body)\n  x := codegen.generated(mut g, el, codegen.no_hints(), d)\n  s := codegen.to_slot(mut g, x)\n  cur := codegen.fresh(mut g, \"cur\")\n  codegen.emit(mut g, f\"{cur} = load ptr, ptr {acc}\")\n  nx := codegen.call_bare(mut g, lt, \"@strata_list_push\", [\n    codegen.V { ty: lt, op: cur },\n    codegen.V { ty: check.TInt, op: s },\n    codegen.elements_kind(et),\n  ])\n  codegen.drop_value(mut g, codegen.V { ty: lt, op: cur })\n  codegen.emit(mut g, f\"store ptr {nx.op}, ptr {acc}\")\n  codegen.emit(mut g, f\"{i1} = add i64 {i}, 1\")\n  codegen.emit(mut g, f\"store i64 {i1}, ptr {counter}\")\n  codegen.br(mut g, head)\n  codegen.block(mut g, end)\n  r := codegen.fresh(mut g, \"l\")\n  codegen.emit(mut g, f\"{r} = load ptr, ptr {acc}\")\n  if n == \"List\" {\n    return codegen.V { ty, op: r }\n  }\n  codegen.push_scope(mut g)\n  lv := codegen.temp(mut g, codegen.V { ty: lt, op: r })\n  made := codegen.collection_builtin(mut g, if n == \"Set\" {\n    \"set\"\n  } else {\n    \"dict\"\n  }, [lv])\n  x2 := codegen.take_value(mut g, made)\n  codegen.pop_scope(mut g)\n  codegen.V { ty, op: x2.op }\n}","old_text":"/// A list of generated elements (pairs for a dict), then the set or dict\n/// made from it.\nfn gen_list(\n  mut g: codegen.Gen,\n  n: String,\n  args: List[ast.TypeExpr],\n  ty: Ty,\n  h: codegen.Hints,\n) -> codegen.V {\n  el := if n == \"Dict\" {\n    ast.Named { name: \"Tuple\", args }\n  } else {\n    get(args, 0) ?? ast.UnitType\n  }\n  et := codegen.lower(mut g, el)\n  lt := TList(et)\n  deep := codegen.too_deep(mut g)\n  l := codegen.fresh(mut g, \"len\")\n  any := codegen.fresh(mut g, \"len\")\n  if n == \"List\" {\n    (tbl, k) := codegen.pairs_table(mut g, codegen.bounded(h.lens, 0, 4))\n    shortest := match get(h.lens, 0) {\n      Some((lo, _)) => if lo > 0 {\n        lo\n      } else {\n        0\n      },\n      None => 0,\n    }\n    codegen.use_rt(mut g, \"strata_gen_len\")\n    codegen.emit(\n      mut g,\n      f\"{any} = call i64 @strata_gen_len(ptr {tbl}, i64 {k})\",\n    )\n    codegen.emit(\n      mut g,\n      f\"{l} = select i1 {deep}, i64 {shortest}, i64 {any}\",\n    )\n  } else {\n    codegen.use_rt(mut g, \"strata_random\")\n    codegen.emit(\n      mut g,\n      f\"{any} = call i64 @strata_random(i64 0, i64 4)\",\n    )\n    codegen.emit(mut g, f\"{l} = select i1 {deep}, i64 0, i64 {any}\")\n  }\n  d := codegen.deeper(mut g)\n  codegen.use_rt(mut g, \"strata_list_new\")\n  codegen.use_rt(mut g, \"strata_list_push\")\n  acc := codegen.fresh(mut g, \"acc\")\n  mut g.allocas.push(f\"  {acc} 