match get(sub, name) {\n        Some(x) => x,\n        None => if contains(g.refines, name) {\n          TNamed { name, args: [] }\n        } else {\n          codegen.written_plain(name)\n        },\n      },\n    },\n    ast.Named { name: \"List\", args: [a] } => TList(codegen.written_ty(a, sub, g)),\n    ast.Named { name, args } => TNamed {\n      name,\n      args: args.map(a -> codegen.written_ty(a, sub, g)),\n    },\n    _ => TAny,\n  }\n}"},{"name":"codegen.written_plain","kind":"fn","old":"5e5ca4d00c8891d5","new":"be6e3c715b1ddce8","interface_changed":true,"affected":["codegen.written_ty","codegen.function","codegen.written_args","codegen.impl_written","codegen.unfold_written","codegen.compiled_alone","codegen.call_fn_want","codegen.method_call","codegen.type_check","codegen.generate","codegen.call_named","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.by_variant","codegen.expr_node","codegen.expr_want_node","codegen_with","core_rt_text","computed_value","repl_eval","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.builtin_call","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.main_arg","codegen.select_expr","codegen.expr","codegen.expr_want","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.entry","codegen.interp","codegen.format_spec","codegen.union_text","codegen.destructure","codegen.debug_fields","codegen.for_loop","codegen.debug_list","codegen.checked","codegen.fail_unless","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.fuzz_driver","codegen.trace_enter","codegen.trace_leave","codegen.matching_v","codegen.index_check","codegen.checked_update","codegen.decreases_fault","codegen.push_in_place","codegen.gen_list","codegen.converted","co