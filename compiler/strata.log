rce of each `{expr}`\n  | FStrTok(List[lex.FPart])\n  | Ident(String)\n  // `?name`\n  | HoleTok(String)\n  | DocTok(String)\n  | Sym(String)\n  // markup: `<tag` (`<` alone for `<>`), an attribute's name, the `>` that\n  // ends a start tag, `/>`, text between tags (as JSX reads it: see\n  // `markup_text`), and `</tag>` (`</>`)\n  | MarkupOpen(String)\n  | MarkupAttr(String)\n  | MarkupTagEnd\n  | MarkupSelfClose\n  | MarkupText(String)\n  | MarkupClose(String)\n  | Eof","old_text":"pub type Tok =\n  | IntTok(Int)\n  // an integer literal too large for 64 bits, its digits as written\n  | BigIntTok(String)\n  | FloatTok(Float)\n  | StrTok(String)\n  // `f\"...\"`: literal text and the source of each `{expr}`\n  | FStrTok(List[lex.FPart])\n  | Ident(String)\n  // `?name`\n  | HoleTok(String)\n  | DocTok(String)\n  | Sym(String)\n  | Eof"},{"name":"lex.Lexer","kind":"type","old":"f645a5a50df110cc","new":"ab7272523f92fcca","interface_changed":true,"affected":["lex.char_at","lex.text_of","lex.push_token","lex.lex","lex.number","lex.fstring","lex.string","lex.mode","lex.push_mode","lex.pop_mode","lex.set_mode","lex.code_brace","lex.markup_starts","lex.markup_open","lex.markup_tag","lex.markup_children","lex_one","lex_lines","parse.parser","lex_files","front_command","parse.parse_module","parse.parse_expr","parse.fstring_part","command_line","strata_command","diff.parsed","stored_package","edit_command","edit_file","edit_in_editor","merge_file_command","resolve_command","write_found","merge.merge","parse.parse_program","graph.trace_graph","call_command","kept_invariants","parse.primary_inner","main","diff.apply","diff.undo","repl_command","find_invariants","parse_one","stored_one","parse_lines","stored_lines","repl_line","graph_command","run_command","build_command","parse.primary","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","diff.log_steps","diff.states","verify_file","parse_files","stored_files","parse.postfix","parse.ident_primary","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","diff.git_range","diff.log_range","verify_command","build_proofs","alongside_command","search_invariants","parse.unary","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","diff_command","tour.side_range","apply_edit","fix_loops","parse.binary","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","or_solver_inputs","check_command","static_graph","program_objects","comptime_values","tour_graph","tour.package_changes","fix_command","parse.expr","parse.index","loaded_errors","file_errors","edit_errors","check_fn","graph_diff","linked","expanded","comptime_runner","tour_command","tour.prepare","parse.trait_decl","parse.impl_rest","parse.type_decl","parse.fields","parse.fn_rest","parse.expr_ns","parse.args","parse.expr_list","parse.sym_primary","parse.comp_fors","parse.entry","parse.statement","parse.ident_pattern","parse.markup_code","parse.postfix_from","package_errors","check_files","apply_change","with_base","parse.decl_kind","parse.payload","parse.capability_decl","parse.fn_decl","parse.type_expr","parse.loop_body","parse.marked","parse.collection_body","parse.block","parse.pattern_one","parse.markup_children","parse.markup_attr","rename_command","move_command","parse.decl_inner","parse.derive_group","parse.member","parse.type_list","parse.type_expr_plain","parse.result_type","parse.params_bound","parse.collection","parse.pattern","parse.markup","parse.decl","parse.bounded_params","parse.type_union","parse.params","parse.binding_pattern","parse.pattern_list","parse.param_pattern","parse.type_params"],"module":"lex","text":"type Lexer = {\n  chars: List[String],\n  at: Int,\n  line: Int,\n  col: Int,\n  nl: Bool,\n  tokens: List[lex.Token],\n  comments: List[lex.Comment],\n  // where the lexer is inside markup, innermost last\n  modes: List[lex.Mode],\n}","old_text":"type Lexer = {\n  chars: List[String],\n  at: Int,\n  line: Int,\n  col: Int,\n  nl: Bool,\n  tokens: List[lex.Token],\n  comments: List[lex.Comment],\n}"},{"name":"lex.lex","kind":"fn","old":"8fff7b481fd7a1ed","new":"ae41d2f1cd3bc8c0","interface_changed":false,"affected":[],"module":"lex","text":"/// The last token is `Eof`.\npub fn lex(src: String) -> Result[(List[lex.Token], List[lex.Comment]), String] {\n  mut lx := lex.Lexer {\n    chars: src.chars(),\n    at: 0,\n    line: 1,\n    col: 1,\n    nl: true,\n    tokens: [],\n    comments: [],\n    modes: [],\n  }\n  n := len(lx.chars)\n  while lx.at < n {\n    if lex.mode(lx) == Some(lex.InChildren) {\n      lex.markup_children(mut lx)!\n      continue\n    }\n    c := lex.char_at(lx, lx.at)\n    if c == \"\\n\" {\n      lx.nl = true\n      lx.at += 1\n      lx.line += 1\n      lx.col = 1\n      continue\n    }\n    if lex.is_white(c) {\n      lx.at += 1\n      lx.col += 1\n      continue\n    }\n    (sl, sc) := (lx.line, lx.col)\n    space := lx.at == 0 || lex.is_white(lex.char_at(lx, lx.at - 1))\n    if lex.mode(lx) == Some(lex.InTag) {\n      lex.markup_tag(mut lx, sl, sc, space)!\n      continue\n    }\n    if c == \"/\" && lex.char_at(lx, lx.at + 1) == \"/\" {\n      start := lx.at\n      while lx.at < n && lex.char_at(lx, lx.at) != \"\\n\"\n        invariant lx.at <= n {\n        lx.at += 1\n      }\n      t := lex.text_of(lx, start, lx.at)\n      if starts_with(t, \"///\") {\n        lex.push_token(\n          mut lx,\n          lex.DocTok(trim(byte_slice(t, 3, byte_len(t)))),\n          sl,\n          sc,\n          space,\n        )\n      } else {\n        mut lx.comments.push(\n          lex.Comment {\n            line: sl,\n            col: sc,\n            text: lex.trim_end(t),\n            trailing: !lx.nl,\n          },\n        )\n      }\n      lx.col += lx.at - start\n      continue\n    }\n    if lex.is_ascii_digit(c) {\n      lex.number(mut lx, sl, sc, space)!\n      continue\n    }\n    if c == \"f\" && lex.char_at(lx, lx.at + 1) == \"\\\"\" {\n      lex.fstring(mut lx, sl, sc, space)!\n      continue\n    }\n    if lex.is_letter(c)\n      || c == \"_\"\n      || c == \"?\" && lex.is_letter(lex.char_at(lx, lx.at + 1)) {\n      hole := c == \"?\"\n      start := if hole {\n        lx.at + 1\n      } else {\n        lx.at\n      }\n      lx.at = start\n      while lx.at < n && lex.is_word(lex.char_at(lx, lx.at)) {\n        lx.at += 1\n      }\n      s := lex.text_of(lx, start, lx.at)\n      lx.col += lx.at - start\n        + if hole {\n          1\n        } else {\n          0\n        }\n      lex.push_token(mut lx, if hole {\n        lex.HoleTok(s)\n      } else {\n        lex.Ident(s)\n      }, sl, sc, space)\n      continue\n    }\n    if c == \"\\\"\" {\n      lex.string(mut lx, sl, sc, space)!\n      continue\n    }\n    if c == \"<\" && lex.markup_starts(lx) {\n      lex.markup_open(mut lx, sl, sc, space)\n      continue\n    }\n    rest := lex.text_of(lx, lx.at, lx.at + 3)\n    match lex.symbols().find(y -> starts_with(rest, y)) {\n      Some(y) => {\n        k := len(y.chars())\n        lx.at += k\n        lx.col += k\n        lex.push_token(mut lx, lex.Sym(y), sl, sc, space)\n        lex.code_brace(mut lx, y)\n      },\n      None => {\n        (l, cc) := (lx.line, lx.col)\n        return Err(f\"{l}:{cc}: unexpected character {lex.debug_char(c)}\")\n      },\n    }\n  }\n  if len(lx.modes) > 0 {\n    (l, cc) := (lx.line, lx.col)\n    return Err(\n      f\"{l}:{cc}: markup not closed: an element needs its `</tag>`, or `/>`\",\n    )\n  }\n  mut lx.tokens.push(\n    lex.Token {\n      tok: lex.Eof,\n      line: lx.line,\n      col: lx.col,\n      nl_before: true,\n      space_before: true,\n    },\n  )\n  Ok((lx.tokens, lx.comments))\n}","old_text":"/// The last token is `Eof`.\npub fn lex(src: String) -> Result[(List[lex.Token], List[lex.Comment]), String] {\n  mut lx := lex.Lexer {\n    chars: src.chars(),\n    at: 0,\n    line: 1,\n    col: 1,\n    nl: true,\n    tokens: [],\n    comments: [],\n  }\n  n := len(lx.chars)\n  while lx.at < n {\n    c := lex.char_at(lx, lx.at)\n    if c == \"\\n\" {\n      lx.nl = true\n      lx.at += 1\n      lx.line += 1\n      lx.col = 1\n      continue\n    }\n    if lex.is_white(c) {\n      lx.at += 1\n      lx.col += 1\n      continue\n    }\n    (sl, sc) := (lx.line, lx.col)\n    space := lx.at == 0 || lex.is_white(lex.char_at(lx, lx.at - 1))\n    if c == \"/\" && lex.char_at(lx, lx.at + 1) == \"/\" {\n      start := lx.at\n      while lx.at < n && lex.char_at(lx, lx.at) != \"\\n\"\n        invariant lx.at <= n {\n        lx.at += 1\n      }\n      t := lex.text_of(lx, start, lx.at)\n      if starts_with(t, \"///\") {\n        lex.push_token(\n          mut lx,\n          lex.DocTok(trim(byte_slice(t, 3, byte_len(t)))),\n          sl,\n          sc,\n          space,\n        )\n      } else {\n        mut lx.comments.push(\n          lex.Comment {\n            line: sl,\n            col: sc,\n            text: lex.trim_end(t),\n            trailing: !lx.nl,\n          },\n        )\n      }\n      lx.col += lx.at - start\n      continue\n    }\n    if lex.is_ascii_digit(c) {\n      lex.number(mut lx, sl, sc, space)!\n      continue\n    }\n    if c == \"f\" && lex.char_at(lx, lx.at + 1) == \"\\\"\" {\n      lex.fstring(mut lx, sl, sc, space)!\n      continue\n    }\n    if lex.is_letter(c)\n      || c == \"_\"\n      || c == \"?\" && lex.is_letter(lex.char_at(lx, lx.at + 1)) {\n      hole := c == \"?\"\n      start := if hole {\n        lx.at + 1\n      } else {\n        lx.at\n      }\n      lx.at = start\n      while lx.at < n && lex.is_word(lex.char_at(lx, lx.at)) {\n        lx.at += 1\n      }\n      s := lex.text_of(lx, start, lx.at)\n      lx.col += lx.at - start\n        + if hole {\n          1\n        } else {\n          0\n        }\n      lex.push_token(mut lx, if hole {\n        lex.HoleTok(s)\n      } else {\n        lex.Ident(s)\n      }, sl, sc, space)\n      continue\n    }\n    if c == \"\\\"\" {\n      lx.at += 1\n      mut s := \"\"\n      while lx.at < n && lex.char_at(lx, lx.at) != \"\\\"\"\n        invariant lx.at <= n {\n        ch := lex.char_at(lx, lx.at)\n        if ch == \"\\\\\" && lx.at + 1 < n {\n          lx.at += 1\n          s += lex.escaped(lex.char_at(lx, lx.at))\n        } else {\n          if ch == \"\\n\" {\n            lx.line += 1\n          }\n          s += ch\n        }\n        lx.at += 1\n      }\n      if lx.at >= n {\n        return Err(f\"{sl}:{sc}: unterminated string\")\n      }\n      lx.at += 1\n      lx.col += 2 + byte_len(s)\n      lex.push_token(mut lx, lex.StrTok(s), sl, sc, space)\n      continue\n    }\n    rest := lex.text_of(lx, lx.at, lx.at + 3)\n    match lex.symbols().find(y -> starts_with(rest, y)) {\n      Some(y) => {\n        k := len(y.chars())\n        lx.at += k\n        lx.col += k\n        lex.push_token(mut lx, lex.Sym(y), sl, sc, space)\n      },\n      None => {\n        (l, cc) := (lx.line, lx.col)\n        return Err(f\"{l}:{cc}: unexpected character {lex.debug_char(c)}\")\n      },\n    }\n  }\n  mut lx.tokens.push(\n    lex.Token {\n      tok: lex.Eof,\n      line: lx.line,\n      col: lx.col,\n      nl_before: true,\n      space_before: true,\n    },\n  )\n  Ok((lx.tokens, lx.comments))\n}"},{"name":"lex.token_text","kind":"fn","old":"22ade8398cdd96fb","new":"59023a6cb98e9c7e","interface_changed":false,"affected":[],"module":"lex","text":"/// A token as `strata lex` prints it: `3:5 nl sp Ident(name)`. `nl` and\n/// `sp` mark a newline or a space before it. A float prints as its bits, so\n/// it is exact.\npub fn token_text(t: lex.Token) -> String {\n  what := match t.tok {\n    lex.IntTok(v) => \"Int(\" + to_string(v) + \")\",\n    lex.BigIntTok(s) => \"BigInt(\" + s + \")\",\n    lex.FloatTok(f) => \"Float(\" + to_string(float_bits(f)) + \")\",\n    lex.StrTok(s) => \"Str(\" + lex.quote(s) + \")\",\n    lex.FStrTok(ps) => \"FStr(\"\n      + join(ps.map(\n        p -> match p {\n          lex.LitPart(s) => lex.quote(s),\n          lex.CodePart { code, line, col } => \"{\"\n            + lex.quote(code)\n            + \"@\"\n            + to_string(line)\n            + \":\"\n            + to_string(col)\n            + \"}\",\n        },\n      ), \", \")\n      + \")\",\n    lex.Ident(s) => \"Ident(\" + s + \")\",\n    lex.HoleTok(s) => \"Hole(\" + s + \")\",\n    lex.DocTok(s) => \"Doc(\" + lex.quote(s) + \")\",\n    lex.Sym(s) => \"Sym(\" + s + \")\",\n    lex.MarkupOpen(s) => \"MarkupOpen(\" + s + \")\",\n    lex.MarkupAttr(s) => \"MarkupAttr(\" + s + \")\",\n    lex.MarkupTagEnd => \"MarkupTagEnd\",\n    lex.MarkupSelfClose => \"MarkupSelfClose\",\n    lex.MarkupText(s) => \"MarkupText(\" + lex.quote(s) + \")\",\n    lex.MarkupClose(s) => \"MarkupClose(\" + s + \")\",\n    lex.Eof => \"Eof\",\n  }\n  to_string(t.line)\n    + \":\"\n    + to_string(t.col)\n    + if t.nl_before {\n      \" nl\"\n    } else {\n      \"\"\n    }\n    + if t.space_before {\n      \" sp\"\n    } else {\n      \"\"\n    }\n    + \" \"\n    + what\n}","old_text":"/// A token as `strata lex` prints it: `3:5 nl sp Ident(name)`. `nl` and\n/// `sp` mark a newline or a space before it. A float prints as its bits, so\n/// it is exact.\npub fn token_text(t: lex.Token) -> String {\n  what := match t.tok {\n    lex.IntTok(v) => \"Int(\" + to_string(v) + \")\",\n    lex.BigIntTok(s) => \"BigInt(\" + s + \")\",\n    lex.FloatTok(f) => \"Float(\" + to_string(float_bits(f)) + \")\",\n    lex.StrTok(s) => \"Str(\" + lex.quote(s) + \")\",\n    lex.FStrTok(ps) => \"FStr(\"\n      + join(ps.map(\n        p -> match p {\n          lex.LitPart(s) => lex.quote(s),\n          lex.CodePart { code, line, col } => \"{\"\n            + lex.quote(code)\n            + \"@\"\n            + to_string(line)\n            + \":\"\n            + to_string(col)\n            + \"}\",\n        },\n      ), \", \")\n      + \")\",\n    lex.Ident(s) => \"Ident(\" + s + \")\",\n    lex.HoleTok(s) => \"Hole(\" + s + \")\",\n    lex.DocTok(s) => \"Doc(\" + lex.quote(s) + \")\",\n    lex.Sym(s) => \"Sym(\" + s + \")\",\n    lex.Eof => \"Eof\",\n  }\n  to_string(t.line)\n    + \":\"\n    + to_string(t.col)\n    + if t.nl_before {\n      \" nl\"\n    } else {\n      \"\"\n    }\n    + if t.space_before {\n      \" sp\"\n    } else {\n      \"\"\n    }\n    + \" \"\n    + what\n}"},{"name":"lex.Mode","kind":"type","old":null,"new":"50ab8b9a704c0f71","interface_changed":true,"affected":[],"module":"lex","text":"/// Where the lexer is inside markup (`<p class=\"x\">{name}</p>`).\ntype Mode =\n  // between `<tag` and its `>` or `/>`: attributes\n  | InTag\n  // between an element's tags: text, `{…}` and elements\n  | InChildren\n  // inside a `{…}` of markup: code, with the number of braces open in it\n  | InCode(Int)"},{"name":"lex.string","kind":"fn","old":null,"new":"4de7f410ba437c71","interface_changed":true,"affected":[],"module":"lex","text":"/// A string literal: `\"a\\n\"`.\nfn string(\n  mut lx: lex.Lexer,\n  sl: Int,\n  sc: Int,\n  space: Bool,\n) -> Result[(), String] {\n  n := len(lx.chars)\n  lx.at += 1\n  mut s := \"\"\n  while lx.at < n && lex.char_at(lx, lx.at) != \"\\\"\"\n    invariant lx.at <= n {\n    ch := lex.char_at(lx, lx.at)\n    if ch == \"\\\\\" && lx.at + 1 < n {\n      lx.at += 1\n      s += lex.escaped(lex.char_at(lx, lx.at))\n    } else {\n      if ch == \"\\n\" {\n        lx.line += 1\n      }\n      s += ch\n    }\n    lx.at += 1\n  }\n  if lx.at >= n {\n    return Err(f\"{sl}:{sc}: unterminated string\")\n  }\n  lx.at += 1\n  lx.col += 2 + byte_len(s)\n  lex.push_token(mut lx, lex.StrTok(s), sl, sc, space)\n  Ok(())\n}"},{"name":"lex.mode","kind":"fn","old":null,"new":"7916718bfeca932f","interface_changed":true,"affected":[],"module":"lex","text":"/// The innermost markup mode, or `None` in plain code.\nfn mode(lx: lex.Lexer) -> Option[lex.Mode] {\n  get(lx.modes, len(lx.modes) - 1)\n}"},{"name":"lex.push_mode","kind":"fn","old":null,"new":"616a515ad5aebfac","interface_changed":true,"affected":[],"module":"lex","text":"fn push_mode(mut lx: lex.Lexer, m: lex.Mode) {\n  mut lx.modes.push(m)\n}"},{"name":"lex.pop_mode","kind":"fn","old":null,"new":"24a88b7fafc165b2","interface_changed":true,"affected":[],"module":"lex","text":"fn pop_mode(mut lx: lex.Lexer) {\n  lx.modes = take(lx.modes, len(lx.modes) - 1)\n}"},{"name":"lex.set_mode","kind":"fn","old":null,"new":"ed1fbac725781c12","interface_changed":true,"affected":[],"module":"lex","text":"fn set_mode(mut lx: lex.Lexer, m: lex.Mode) {\n  lex.pop_mode(mut lx)\n  lex.push_mode(mut lx, m)\n}"},{"name":"lex.code_brace","kind":"fn","old":null,"new":"6816fd6a041327a5","interface_changed":true,"affected":[],"module":"lex","text":"/// Counts the braces of a markup `{…}`: its last `}` goes back to the\n/// element's children.\nfn code_brace(mut lx: lex.Lexer, sym: String) {\n  match lex.mode(lx) {\n    Some(lex.InCode(k)) => if sym == \"{\" {\n      lex.set_mode(mut lx, lex.InCode(k + 1))\n    } else if sym == \"}\" {\n      if k == 0 {\n        lex.pop_mode(mut lx)\n      } else {\n        lex.set_mode(mut lx, lex.InCode(k - 1))\n      }\n    },\n    _ => (),\n  }\n}"},{"name":"lex.markup_starts","kind":"fn","old":null,"new":"850a21f05da14c65","interface_changed":true,"affected":[],"module":"lex","text":"/// Whether the `<` at `lx.at` starts markup: a letter or `>` follows it\n/// right away, and it is where an operand goes (first on its line, or after\n/// a token that can't end one). `a <b` is a comparison, `x := <b>` markup.\nfn markup_starts(lx: lex.Lexer) -> Bool {\n  next := lex.char_at(lx, lx.at + 1)\n  if !(lex.is_ascii_letter(next) || next == \">\") {\n    return false\n  }\n  if lx.nl {\n    return true\n  }\n  match get(lx.tokens, len(lx.tokens) - 1) {\n    Some(t) => !lex.ends_operand(t.tok),\n    None => true,\n  }\n}"},{"name":"lex.ends_operand","kind":"fn","old":null,"new":"eba9825239097514","interface_changed":true,"affected":[],"module":"lex","text":"/// Whether a token can end an operand, so a `<` after it compares.\nfn ends_operand(t: lex.Tok) -> Bool {\n  match t {\n    lex.IntTok(_) | lex.BigIntTok(_) | lex.FloatTok(_) | lex.StrTok(_) | lex.FStrTok(_) => true,\n    lex.HoleTok(_) | lex.MarkupClose(_) | lex.MarkupSelfClose => true,\n    lex.Ident(s) => !(s == \"return\" || s == \"in\" || s == \"assert\"),\n    lex.Sym(s) => s == \")\" || s == \"]\" || s == \"}\",\n    _ => false,\n  }\n}"},{"name":"lex.is_ascii_letter","kind":"fn","old":null,"new":"e5e472a9c7590296","interface_changed":true,"affected":[],"module":"lex","text":"fn is_ascii_letter(c: String) -> Bool {\n  c != \"\"\n    && contains(\n      \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\",\n      c,\n    )\n}"},{"name":"lex.is_tag_char","kind":"fn","old":null,"new":"98df966e93a63124","interface_changed":true,"affected":[],"module":"lex","text":"/// Letters, digits and dashes: a tag's name as written.\nfn is_tag_char(c: String) -> Bool {\n  lex.is_ascii_letter(c) || lex.is_ascii_digit(c) || c == \"-\"\n}"},{"name":"lex.markup_open","kind":"fn","old":null,"new":"aabc24776289a45d","interface_changed":true,"affected":[],"module":"lex","text":"/// `<tag` or `<>`, at a `<` that starts markup.\nfn markup_open(mut lx: lex.Lexer, sl: Int, sc: Int, space: Bool) {\n  lx.at += 1\n  lx.col += 1\n  if lex.char_at(lx, lx.at) == \">\" {\n    lx.at += 1\n    lx.col += 1\n    lex.push_token(mut lx, lex.MarkupOpen(\"\"), sl, sc, space)\n    lex.push_token(mut lx, lex.MarkupTagEnd, sl, sc + 1, false)\n    lex.push_mode(mut lx, lex.InChildren)\n    return\n  }\n  start := lx.at\n  while lx.at < len(lx.chars) && lex.is_tag_char(lex.char_at(lx, lx.at)) {\n    lx.at += 1\n  }\n  lx.col += lx.at - start\n  lex.push_token(\n    mut lx,\n    lex.MarkupOpen(lex.text_of(lx, start, lx.at)),\n    sl,\n    sc,\n    space,\n  )\n  lex.push_mode(mut lx, lex.InTag)\n}"},{"name":"lex.markup_tag","kind":"fn","old":null,"new":"2fb28b6c30ac4fe9","interface_changed":true,"affected":[],"module":"lex","text":"/// One token of a start tag: an attribute's name, `=`, a string, `{`, `>`\n/// or `/>`.\nfn markup_tag(\n  mut lx: lex.Lexer,\n  sl: Int,\n  sc: Int,\n  space: Bool,\n) -> Result[(), String] {\n  c := lex.char_at(lx, lx.at)\n  next := lex.char_at(lx, lx.at + 1)\n  if c == \">\" {\n    lx.at += 1\n    lx.col += 1\n    lex.push_token(mut lx, lex.MarkupTagEnd, sl, sc, space)\n    lex.set_mode(mut lx, lex.InChildren)\n    return Ok(())\n  }\n  if c == \"/\" && next == \">\" {\n    lx.at += 2\n    lx.col += 2\n    lex.push_token(mut lx, lex.MarkupSelfClose, sl, sc, space)\n    lex.pop_mode(mut lx)\n    return Ok(())\n  }\n  if c == \"{\" || c == \"=\" {\n    lx.at += 1\n    lx.col += 1\n    lex.push_token(mut lx, lex.Sym(c), sl, sc, space)\n    if c == \"{\" {\n      lex.push_mode(mut lx, lex.InCode(0))\n    }\n    return Ok(())\n  }\n  if c == \"\\\"\" {\n    return lex.string(mut lx, sl, sc, space)\n  }\n  if lex.is_ascii_letter(c) || c == \"_\" {\n    start := lx.at\n    while lx.at < len(lx.chars)\n      && (lex.is_tag_char(lex.char_at(lx, lx.at))\n        || contains(\"_:.\", lex.char_at(lx, lx.at))) {\n      lx.at += 1\n    }\n    lx.col += lx.at - start\n    lex.push_token(\n      mut lx,\n      lex.MarkupAttr(lex.text_of(lx, start, lx.at)),\n      sl,\n      sc,\n      space,\n    )\n    return Ok(())\n  }\n  Err(\n    f\"{sl}:{sc}: unexpected character {lex.debug_char(c)} in a tag\",\n  )\n}"},{"name":"lex.markup_children","kind":"fn","old":null,"new":"6f8cde360cca458b","interface_changed":true,"affected":[],"module":"lex","text":"/// What follows an element's `>`: text up to the next `<` or `{`, then\n/// that `{`, element or `</tag>`.\nfn markup_children(mut lx: lex.Lexer) -> Result[(), String] {\n  n := len(lx.chars)\n  (sl, sc) := (lx.line, lx.col)\n  space := lx.at > 0 && lex.is_white(lex.char_at(lx, lx.at - 1))\n  start := lx.at\n  while lx.at < n\n    && lex.char_at(lx, lx.at) != \"<\"\n    && lex.char_at(lx, lx.at) != \"{\" {\n    ch := lex.char_at(lx, lx.at)\n    if ch == \"}\" {\n      (l, cc) := (lx.line, lx.col)\n      return Err(f\"{l}:{cc}: a `}}` in markup text: write `{{\\\"}}\\\"}}`\")\n    }\n    if ch == \"\\n\" {\n      lx.line += 1\n      lx.col = 1\n    } else {\n      lx.col += 1\n    }\n    lx.at += 1\n  }\n  t := lex.markup_text(lex.text_of(lx, start, lx.at))\n  if t != \"\" {\n    lex.push_token(mut lx, lex.MarkupText(t), sl, sc, space)\n  }\n  if lx.at >= n {\n    return Err(\n      f\"{sl}:{sc}: markup not closed: an element needs its `</tag>`\",\n    )\n  }\n  (l, c) := (lx.line, lx.col)\n  if lex.char_at(lx, lx.at) == \"{\" {\n    lx.at += 1\n    lx.col += 1\n    lex.push_token(mut lx, lex.Sym(\"{\"), l, c, false)\n    lex.push_mode(mut lx, lex.InCode(0))\n    return Ok(())\n  }\n  next := lex.char_at(lx, lx.at + 1)\n  if next == \"/\" {\n    lx.at += 2\n    lx.col += 2\n    name_at := lx.at\n    while lx.at < n && lex.is_tag_char(lex.char_at(lx, lx.at)) {\n      lx.at += 1\n    }\n    name := lex.text_of(lx, name_at, lx.at)\n    lx.col += lx.at - name_at\n    if lex.char_at(lx, lx.at) != \">\" {\n      return Err(f\"{l}:{c}: expected `>` after `</{name}`\")\n    }\n    lx.at += 1\n    lx.col += 1\n    lex.push_token(mut lx, lex.MarkupClose(name), l, c, false)\n    lex.pop_mode(mut lx)\n    return Ok(())\n  }\n  if lex.is_ascii_letter(next) || next == \">\" {\n    lex.markup_open(mut lx, l, c, false)\n    return Ok(())\n  }\n  Err(f\"{l}:{c}: a `<` in markup text: write `{{\\\"<\\\"}}`\")\n}"},{"name":"lex.markup_text","kind":"fn","old":null,"new":"31ae1e82955ec307","interface_changed":true,"affected":[],"module":"lex","text":"/// Text between tags as JSX reads it: where a line breaks, the spaces next\n/// to the break go, lines left blank go, and the rest are joined by a\n/// space. Text on one line is kept as it is.\npub fn markup_text(raw: String) -> String {\n  lines := split(raw, \"\\n\")\n  if len(lines) == 1 {\n    return raw\n  }\n  mut kept := []\n  for (i, l) in enumerate(lines) {\n    mut s := l\n    if i > 0 {\n      s = lex.trim_start(s)\n    }\n    if i < len(lines) - 1 {\n      s = lex.trim_end(s)\n    }\n    if s != \"\" {\n      mut kept.push(s)\n    }\n  }\n  join(kept, \" \")\n}"},{"name":"lex.trim_start","kind":"fn","old":null,"new":"90ea1099c869d08d","interface_changed":true,"affected":[],"module":"lex","text":"fn trim_start(s: String) -> String {\n  cs := s.chars()\n  mut k := 0\n  while k < len(cs) && lex.is_white(get(cs, k) ?? \"\") {\n    k += 1\n  }\n  join(drop(cs, k), \"\")\n}"},{"name":"parse.primary_inner","kind":"fn","old":"d5552a362da420f9","new":"df5127415ce973dd","interface_changed":false,"affected":[],"module":"parse","text":"fn primary_inner(mut p: parse.Parser) -> Result[ast.Expr, String] {\n  match parse.peek(p) {\n    lex.IntTok(n) => {\n      parse.advance(mut p)\n      Ok(ast.IntLit(n))\n    },\n    lex.BigIntTok(s) => {\n      parse.advance(mut p)\n      Ok(ast.BigIntLit(s))\n    },\n    lex.FloatTok(f) => {\n      parse.advance(mut p)\n      Ok(ast.FloatLit(f))\n    },\n    lex.StrTok(s) => {\n      parse.advance(mut p)\n      Ok(ast.StrLit(s))\n    },\n    lex.HoleTok(h) => {\n      parse.advance(mut p)\n      Ok(ast.Hole(h))\n    },\n    lex.FStrTok(parts) => {\n      parse.advance(mut p)\n      mut out := []\n      for part in parts {\n        mut out.push(\n          match part {\n            lex.LitPart(s) => ast.TextPart(s),\n            lex.CodePart { code, line, col } => parse.fstring_part(code, line, col)!,\n          },\n        )\n      }\n      Ok(ast.Interp(out))\n    },\n    lex.Sym(s) => parse.sym_primary(mut p, s),\n    lex.Ident(name) => parse.ident_primary(mut p, name),\n    lex.MarkupOpen(_) => parse.markup(mut p),\n    _ => parse.fail(p, \"expected expression\"),\n  }\n}","old_text":"fn primary_inner(mut p: parse.Parser) -> Result[ast.Expr, String] {\n  match parse.peek(p) {\n    lex.IntTok(n) => {\n      parse.advance(mut p)\n      Ok(ast.IntLit(n))\n    },\n    lex.BigIntTok(s) => {\n      parse.advance(mut p)\n      Ok(ast.BigIntLit(s))\n    },\n    lex.FloatTok(f) => {\n      parse.advance(mut p)\n      Ok(ast.FloatLit(f))\n    },\n    lex.StrTok(s) => {\n      parse.advance(mut p)\n      Ok(ast.StrLit(s))\n    },\n    lex.HoleTok(h) => {\n      parse.advance(mut p)\n      Ok(ast.Hole(h))\n    },\n    lex.FStrTok(parts) => {\n      parse.advance(mut p)\n      mut out := []\n      for part in parts {\n        mut out.push(\n          match part {\n            lex.LitPart(s) => ast.TextPart(s),\n            lex.CodePart { code, line, col } => parse.fstring_part(code, line, col)!,\n          },\n        )\n      }\n      Ok(ast.Interp(out))\n    },\n    lex.Sym(s) => parse.sym_primary(mut p, s),\n    lex.Ident(name) => parse.ident_primary(mut p, name),\n    _ => parse.fail(p, \"expected expression\"),\n  }\n}"},{"name":"parse.tok_shown","kind":"fn","old":"62acb5c78cf78782","new":"ec1f9423616faee7","interface_changed":false,"affected":[],"module":"parse","text":"/// A token as written, for messages: `` `)` ``, `` `pub` ``, `` `3` ``, a\n/// string's text quoted.\nfn tok_shown(t: lex.Tok) -> String {\n  match t {\n    lex.IntTok(v) => \"`\" + to_string(v) + \"`\",\n    lex.BigIntTok(s) => \"`\" + s + \"`\",\n    lex.FloatTok(f) => \"`\" + to_string(f) + \"`\",\n    lex.StrTok(s) => \"`\" + parse.debug_quoted(s) + \"`\",\n    lex.FStrTok(_) => \"an f-string\",\n    lex.Ident(s) => \"`\" + s + \"`\",\n    lex.HoleTok(s) => \"`?\" + s + \"`\",\n    lex.DocTok(_) => \"a doc comment (`///`)\",\n    lex.Sym(s) => \"`\" + s + \"`\",\n    lex.MarkupOpen(s) => \"`<\" + s + \"`\",\n    lex.MarkupAttr(s) => \"the attribute `\" + s + \"`\",\n    lex.MarkupTagEnd => \"`>`\",\n    lex.MarkupSelfClose => \"`/>`\",\n    lex.MarkupText(s) => \"the text `\" + s + \"`\",\n    lex.MarkupClose(s) => \"`</\" + s + \">`\",\n    lex.Eof => \"the end\",\n  }\n}","old_text":"/// A token as written, for messages: `` `)` ``, `` `pub` ``, `` `3` ``, a\n/// string as its literal, or \"the end of the text\".\nfn tok_shown(t: lex.Tok) -> String {\n  match t {\n    lex.IntTok(v) => \"`\" + to_string(v) + \"`\",\n    lex.BigIntTok(s) => \"`\" + s + \"`\",\n    lex.FloatTok(f) => \"`\" + to_string(f) + \"`\",\n    lex.StrTok(s) => \"`\" + parse.debug_quoted(s) + \"`\",\n    lex.FStrTok(_) => \"an f-string\",\n    lex.Ident(s) => \"`\" + s + \"`\",\n    lex.HoleTok(s) => \"`?\" + s + \"`\",\n    lex.DocTok(_) => \"a doc comment (`///`)\",\n    lex.Sym(s) => \"`\" + s + \"`\",\n    lex.Eof => \"the end\",\n  }\n}"},{"name":"parse.markup","kind":"fn","old":null,"new":"fb9086ba0df8c057","interface_changed":true,"affected":[],"module":"parse","text":"/// Markup, as calls to `std.web` (so the module needs `use std.web`):\n/// `<p class=\"x\">Hi {name}</p>` is\n/// `web.element(\"p\", [web.attr(\"class\", \"x\")], web.children([\"Hi \", name]))`,\n/// and `<>…</>` is `web.children([…])`. `text.markup_view` shows those calls\n/// as markup again.\nfn markup(mut p: parse.Parser) -> Result[ast.Expr, String] {\n  tag := match parse.peek(p) {\n    lex.MarkupOpen(t) => t,\n    _ => return parse.fail(p, \"expected markup\"),\n  }\n  parse.advance(mut p)\n  if tag == \"\" {\n    parse.advance(mut p)\n    items := parse.markup_children(mut p, \"\")!\n    return Ok(parse.web_call(\"children\", [ast.ListExpr(items)]))\n  }\n  if !matches(tag, \"[a-z][a-z0-9]*(-[a-z0-9]+)*\") {\n    return parse.fail(\n      p,\n      f\"`<{tag}>`: a tag is lowercase letters, digits and dashes (`div`, `my-card`); a component is a function, called in braces: `{{card(x)}}`\",\n    )\n  }\n  mut attrs := []\n  loop {\n    match parse.peek(p) {\n      lex.MarkupAttr(name) => {\n        parse.advance(mut p)\n        mut attrs.push(parse.markup_attr(mut p, name)!)\n      },\n      lex.MarkupSelfClose => {\n        parse.advance(mut p)\n        return Ok(parse.web_call(\n          \"element\",\n          [ast.StrLit(tag), ast.ListExpr(attrs), ast.ListExpr([])],\n        ))\n      },\n      lex.MarkupTagEnd => {\n        if parse.void_tag(tag) {\n          return parse.fail(\n            p,\n            f\"`<{tag}>` has no children and no end tag: write `<{tag} … />`\",\n          )\n        }\n        parse.advance(mut p)\n        break\n      },\n      _ => return parse.fail(\n        p,\n        f\"expected an attribute, `>` or `/>` in `<{tag}>`\",\n      ),\n    }\n  }\n  items := parse.markup_children(mut p, tag)!\n  kids := if len(items) == 0 {\n    ast.ListExpr([])\n  } else {\n    parse.web_call(\"children\", [ast.ListExpr(items)])\n  }\n  Ok(parse.web_call(\n    \"element\",\n    [ast.StrLit(tag), ast.ListExpr(attrs), kids],\n  ))\n}"},{"name":"parse.void_tag","kind":"fn","old":null,"new":"eab99bd9374acc26","interface_changed":true,"affected":[],"module":"parse","text":"/// Elements that have no children and no end tag, as `std.web.is_void`.\nfn void_tag(tag: String) -> Bool {\n  matches(\n    tag,\n    \"area|base|br|col|embed|hr|img|input|link|meta|source|track|wbr\",\n  )\n}"},{"name":"parse.web_call","kind":"fn","old":null,"new":"806798c60142f6b4","interface_changed":true,"affected":[],"module":"parse","text":"/// `web.NAME(args)`.\nfn web_call(name: String, args: List[ast.Expr]) -> ast.Expr {\n  ast.MethodCall { recv: ast.Var(\"web\"), name, args }\n}"},{"name":"parse.markup_children","kind":"fn","old":null,"new":"9e139014fe74a44d","interface_changed":true,"affected":[],"module":"parse","text":"/// An element's children up to `</tag>`: text as string literals, `{e}` as\n/// `e`, elements as their calls.\nfn markup_children(\n  mut p: parse.Parser,\n  tag: String,\n) -> Result[List[ast.Expr], String] {\n  mut items := []\n  loop {\n    match parse.peek(p) {\n      lex.MarkupText(s) => {\n        parse.advance(mut p)\n        mut items.push(ast.StrLit(s))\n      },\n      lex.MarkupOpen(_) => mut items.push(parse.markup(mut p)!),\n      lex.MarkupClose(t) => {\n        if t != tag {\n          return parse.fail(p, f\"expected `</{tag}>`\")\n        }\n        parse.advance(mut p)\n        return Ok(items)\n      },\n      lex.Sym(\"{\") => {\n        parse.advance(mut p)\n        mut items.push(parse.markup_code(mut p)!)\n      },\n      _ => return parse.fail(\n        p,\n        f\"expected text, `{{`, an element or `</{tag}>`\",\n      ),\n    }\n  }\n  Ok(items)\n}"},{"name":"parse.markup_code","kind":"fn","old":null,"new":"069715e704067cd9","interface_changed":true,"affected":[],"module":"parse","text":"/// The expression of a markup `{e}`, after its `{`, and its `}`.\nfn markup_code(mut p: parse.Parser) -> Result[ast.Expr, String] {\n  (ns, np) := (p.no_struct, p.no_pipe)\n  p.no_struct = false\n  p.no_pipe = false\n  e := parse.expr(mut p)!\n  p.no_struct = ns\n  p.no_pipe = np\n  parse.expect_sym(mut p, \"}\")!\n  Ok(e)\n}"},{"name":"parse.markup_attr","kind":"fn","old":null,"new":"ca32110fe655f8fb","interface_changed":true,"affected":[],"module":"parse","text":"/// An attribute after its name: `class=\"x\"` (`web.attr`), `class={e}`\n/// (`web.attribute`), `disabled` (`web.flag`), or an event, `on_click={m}`\n/// (`web.on_click(m)`).\nfn markup_attr(mut p: parse.Parser, name: String) -> Result[ast.Expr, String] {\n  if starts_with(name, \"on_\") {\n    if !(parse.eat_sym(mut p, \"=\") && parse.eat_sym(mut p, \"{\")) {\n      return parse.fail(\n        p,\n        f\"`{name}` is an event: write `{name}={{message}}`\",\n      )\n    }\n    return Ok(parse.web_call(name, [parse.markup_code(mut p)!]))\n  }\n  if matches(name, \"[oO][nN].*\") {\n    return parse.fail(\n      p,\n      f\"`{name}`: attributes starting with `on` are inline scripts, which pages can't hold; an event is written `on_click={{message}}`\",\n    )\n  }\n  if !parse.eat_sym(mut p, \"=\") {\n    return Ok(parse.web_call(\"flag\", [ast.StrLit(name)]))\n  }\n  match parse.peek(p) {\n    lex.StrTok(s) => {\n      parse.advance(mut p)\n      Ok(parse.web_call(\"attr\", [ast.StrLit(name), ast.StrLit(s)]))\n    },\n    lex.Sym(\"{\") => {\n      parse.advance(mut p)\n      Ok(parse.web_call(\n        \"attribute\",\n        [ast.StrLit(name), parse.markup_code(mut p)!],\n      ))\n    },\n    _ => parse.fail(p, f\"expected a string or `{{` after `{name}=`\"),\n  }\n}"}]}
{"id":"47e192c40e0685f7","time":1795711939,"message":"edit","changes":[{"name":"text.expr_text","kind":"fn","old":"f58810d7f0da8692","new":"ce63f804e3089424","interface_changed":false,"affected":[],"module":"text","text":"/// An expression at depth `d`, broken across lines where it would be too\n/// long:\n/// - a chain of method calls: one call per line.\n/// - a call's arguments or a literal's items: one per line.\n/// - a long lambda's body: on a line of its own.\n/// - `&&`, `||` and `+`: one operand per line.\npub fn expr_text(e: ast.Expr, d: Int) -> String {\n  // markup made by the parser (`web.element(…)`) is shown as markup\n  match text.markup_view(e, d) {\n    Some(s) => return s,\n    None => (),\n  }\n  one := text.inline(e, d)\n  // a chain whose parts had to break is laid out one item per line\n  chain := match e {\n    ast.MethodCall { .. } | ast.Binary { op: ast.And | ast.Or | ast.Add, .. } => true,\n    _ => false,\n  }\n  if !text.too_long(one, d) && !(chain && contains(one, \"\\n\")) {\n    return one\n  }\n  match e {\n    // a.b().c().d()  ->  one call per line\n    ast.MethodCall { .. } => {\n      mut calls := []\n      mut cur: ast.Expr = e\n      loop {\n        match cur {\n          ast.MethodCall { recv, name, args } => {\n            mut calls.push((name, args))\n            cur = recv\n          },\n          _ => {\n            break\n          },\n        }\n      }\n      if len(calls) < 2 {\n        c := get(calls, 0) ?? (\"\", [])\n        return text.wrap(cur, 12, d)\n          + \".\"\n          + c.0\n          + text.broken(\n            \"(\",\n            c.1.map(a -> text.expr_text(a, d + 1)),\n            \")\",\n            d,\n          )\n      }\n      mut s := text.wrap(cur, 12, d)\n      for c in calls.reversed() {\n        s += \"\\n\"\n          + text.ind(d + 1)\n          + \".\"\n          + c.0\n          + \"(\"\n          + text.args_text(c.1, d + 1)\n          + \")\"\n      }\n      s\n    },\n    ast.Call { callee, args } => if len(args) > 0 {\n      text.callee_text(callee, d)\n        + text.broken(\n          \"(\",\n          args.map(a -> text.expr_text(a, d + 1)),\n          \")\",\n          d,\n        )\n    } else {\n      one\n    },\n    ast.ListExpr(es) => if len(es) > 0 {\n      text.broken(\n        \"[\",\n        es.map(a -> text.expr_text(a, d + 1)),\n        \"]\",\n        d,\n      )\n    } else {\n      one\n    },\n    ast.TupleExpr(es) => text.broken(\"(\", es.map(a -> text.expr_text(a, d + 1)), \")\", d),\n    ast.CtorExpr { name, args: ast.RecordArgs(fs) } => text.broken(name + \" {\", text.named_parts(fs, d + 1), \"}\", d),\n    ast.CtorExpr { name, args: ast.PositionalArgs(es) } => name\n      + text.broken(\n        \"(\",\n        es.map(a -> text.expr_text(a, d + 1)),\n        \")\",\n        d,\n      ),\n    // x -> long body  ->  body on its own line (a block body breaks by itself)\n    ast.Lambda { params, body } => match text.lambda_view(params, body) {\n      (_, ast.Block { .. }) => one,\n      (ps, b) => text.lambda_params(ps)\n        + \" ->\\n\"\n        + text.ind(d + 1)\n        + text.expr_text(b, d + 1),\n    },\n    // a && b && c, \"x\" + y + \"z\"  ->  one operand per line\n    ast.Binary { op, .. } => if op == ast.And || op == ast.Or || op == ast.Add {\n      mut parts := []\n      mut cur: ast.Expr = e\n      loop {\n        match cur {\n          ast.Binary { op: o, left, right } => if o == op {\n            mut parts.push(right)\n            cur = left\n          } else {\n            break\n          },\n          _ => {\n            break\n          },\n        }\n      }\n      p := text.prec(e)\n      mut s := text.wrap(cur, p, d + 1)\n      for x in parts.reversed() {\n        s += \"\\n\"\n          + text.ind(d + 1)\n          + text.symbol(op)\n          + \" \"\n          + text.wrap(x, p + 1, d + 1)\n      }\n      s\n    } else {\n      one\n    },\n    _ => one,\n  }\n}","old_text":"/// An expression at depth `d`, broken across lines where it would be too\n/// long:\n/// - a chain of method calls: one call per line.\n/// - a call's arguments or a literal's items: one per line.\n/// - a long lambda's body: on a line of its own.\n/// - `&&`, `||` and `+`: one operand per line.\npub fn expr_text(e: ast.Expr, d: Int) -> String {\n  one := text.inline(e, d)\n  // a chain whose parts had to break is laid out one item per line\n  chain := match e {\n    ast.MethodCall { .. } | ast.Binary { op: ast.And | ast.Or | ast.Add, .. } => true,\n    _ => false,\n  }\n  if !text.too_long(one, d) && !(chain && contains(one, \"\\n\")) {\n    return one\n  }\n  match e {\n    // a.b().c().d()  ->  one call per line\n    ast.MethodCall { .. } => {\n      mut calls := []\n      mut cur: ast.Expr = e\n      loop {\n        match cur {\n          ast.MethodCall { recv, name, args } => {\n            mut calls.push((name, args))\n            cur = recv\n          },\n          _ => {\n            break\n          },\n        }\n      }\n      if len(calls) < 2 {\n        c := get(calls, 0) ?? (\"\", [])\n        return text.wrap(cur, 12, d)\n          + \".\"\n          + c.0\n          + text.broken(\n            \"(\",\n            c.1.map(a -> text.expr_text(a, d + 1)),\n            \")\",\n            d,\n          )\n      }\n      mut s := text.wrap(cur, 12, d)\n      for c in calls.reversed() {\n        s += \"\\n\"\n          + text.ind(d + 1)\n          + \".\"\n          + c.0\n          + \"(\"\n          + text.args_text(c.1, d + 1)\n          + \")\"\n      }\n      s\n    },\n    ast.Call { callee, args } => if len(args) > 0 {\n      text.callee_text(callee, d)\n        + text.broken(\n          \"(\",\n          args.map(a -> text.expr_text(a, d + 1)),\n          \")\",\n          d,\n        )\n    } else {\n      one\n    },\n    ast.ListExpr(es) => if len(es) > 0 {\n      text.broken(\n        \"[\",\n        es.map(a -> text.expr_text(a, d + 1)),\n        \"]\",\n        d,\n      )\n    } else {\n      one\n    },\n    ast.TupleExpr(es) => text.broken(\"(\", es.map(a -> text.expr_text(a, d + 1)), \")\", d),\n    ast.CtorExpr { name, args: ast.RecordArgs(fs) } => text.broken(name + \" {\", text.named_parts(fs, d + 1), \"}\", d),\n    ast.CtorExpr { name, args: ast.PositionalArgs(es) } => name\n      + text.broken(\n        \"(\",\n        es.map(a -> text.expr_text(a, d + 1)),\n        \")\",\n        d,\n      ),\n    // x -> long body  ->  body on its own line (a block body breaks by itself)\n    ast.Lambda { params, body } => match text.lambda_view(params, body) {\n      (_, ast.Block { .. }) => one,\n      (ps, b) => text.lambda_params(ps)\n        + \" ->\\n\"\n        + text.ind(d + 1)\n        + text.expr_text(b, d + 1),\n    },\n    // a && b && c, \"x\" + y + \"z\"  ->  one operand per line\n    ast.Binary { op, .. } => if op == ast.And || op == ast.Or || op == ast.Add {\n      mut parts := []\n      mut cur: ast.Expr = e\n      loop {\n        match cur {\n          ast.Binary { op: o, left, right } => if o == op {\n            mut parts.push(right)\n            cur = left\n          } else {\n            break\n          },\n          _ => {\n            break\n          },\n        }\n      }\n      p := text.prec(e)\n      mut s := text.wrap(cur, p, d + 1)\n      for x in parts.reversed() {\n        s += \"\\n\"\n          + text.ind(d + 1)\n          + text.symbol(op)\n          + \" \"\n          + text.wrap(x, p + 1, d + 1)\n      }\n      s\n    } else {\n      one\n    },\n    _ => one,\n  }\n}"},{"name":"text.markup_view","kind":"fn","old":null,"new":"b6a124d210f64cd8","interface_changed":true,"affected":[],"module":"text","text":"/// Calls the parser made from markup, shown as markup: `<p class=\"x\">Hi\n/// {name}</p>` for `web.element(\"p\", [web.attr(\"class\", \"x\")],\n/// web.children([\"Hi \", name]))`, `<>…</>` for `web.children([…])`. `None`\n/// for anything else, and for calls that markup can't write the same way\n/// (an attribute that isn't one of `web.attr`, `web.attribute`, `web.flag`\n/// or an `on_` event, a void element with children), which are shown as\n/// calls. On one line when it fits, else each child on its own line.\nfn markup_view(e: ast.Expr, d: Int) -> Option[String] {\n  one := text.markup_line(e, d)?\n  if !text.too_long(one, d) && !contains(one, \"\\n\") {\n    return Some(one)\n  }\n  (open, items, close) := text.markup_parts(e, d + 1, true)?\n  if len(items) == 0 {\n    return Some(open)\n  }\n  Some(open\n    + join(items.map(i -> \"\\n\" + text.ind(d + 1) + i), \"\")\n    + \"\\n\"\n    + text.ind(d)\n    + close)\n}"},{"name":"text.markup_line","kind":"fn","old":null,"new":"1225988563ceab9c","interface_changed":true,"affected":[],"module":"text","text":"/// Markup on one line, or `None` if `e` isn't markup.\nfn markup_line(e: ast.Expr, d: Int) -> Option[String] {\n  (open, items, close) := text.markup_parts(e, d, false)?\n  Some(open + join(items, \"\") + close)\n}"},{"name":"text.markup_parts","kind":"fn","old":null,"new":"0a9b4640d648537a","interface_changed":true,"affected":[],"module":"text","text":"/// An element's start tag (the whole element when it has no children),\n/// its children as shown, and its end tag. `broken`: each child goes on its\n/// own line, so text with spaces at an end is written `{\"…\"}`.\nfn markup_parts(\n  e: ast.Expr,\n  d: Int,\n  broken: Bool,\n) -> Option[(String, List[String], String)] {\n  (tag, attrs, items) := match e {\n    ast.MethodCall { recv: ast.Var(\"web\"), name: \"element\", args } => {\n      if len(args) != 3 {\n        return None\n      }\n      tag := match get(args, 0) {\n        Some(ast.StrLit(t)) => t,\n        _ => return None,\n      }\n      if !matches(tag, \"[a-z][a-z0-9]*(-[a-z0-9]+)*\") {\n        return None\n      }\n      attrs := match get(args, 1) {\n        Some(ast.ListExpr(xs)) => xs,\n        _ => return None,\n      }\n      items := match get(args, 2) {\n        Some(ast.ListExpr(xs)) => if len(xs) == 0 {\n          None\n        } else {\n          return None\n        },\n        Some(ast.MethodCall { recv: ast.Var(\"web\"), name: \"children\", args: cs }) => match cs {\n          [ast.ListExpr(xs)] => if len(xs) > 0 && !text.is_void_tag(tag) {\n            Some(xs)\n          } else {\n            return None\n          },\n          _ => return None,\n        },\n        _ => return None,\n      }\n      (tag, attrs, items)\n    },\n    ast.MethodCall { recv: ast.Var(\"web\"), name: \"children\", args } => match args {\n      [ast.ListExpr(xs)] => (\"\", [], Some(xs)),\n      _ => return None,\n    },\n    _ => return None,\n  }\n  mut shown := []\n  for a in attrs {\n    mut shown.push(text.markup_attr_view(a, d)?)\n  }\n  head := \"<\" + tag + join(shown.map(s -> \" \" + s), \"\")\n  match items {\n    None => Some((head + \" />\", [], \"\")),\n    Some(xs) => {\n      mut out := []\n      mut after_text := false\n      for x in xs {\n        (s, bare) := text.markup_child(x, d, broken, after_text)\n        mut out.push(s)\n        after_text = bare\n      }\n      Some((head + \">\", out, \"</\" + tag + \">\"))\n    },\n  }\n}"},{"name":"text.markup_child","kind":"fn","old":null,"new":"1f9d3073ab7f979f","interface_changed":true,"affected":[],"module":"text","text":"/// A child as markup, and whether it is bare text. Text is bare unless\n/// reading it back would change it: it holds `<`, `{`, `}` or a line break,\n/// follows bare text (the two would read as one), or, on a line of its own,\n/// starts or ends with a space.\nfn markup_child(\n  x: ast.Expr,\n  d: Int,\n  broken: Bool,\n  after_text: Bool,\n) -> (String, Bool) {\n  match x {\n    ast.StrLit(s) => {\n      edges := starts_with(s, \" \")\n        || ends_with(s, \" \")\n        || starts_with(s, \"\\t\")\n        || ends_with(s, \"\\t\")\n      plain := s != \"\"\n        && !after_text\n        && !contains(s, \"<\")\n        && !contains(s, \"{\")\n        && !contains(s, \"}\")\n        && !contains(s, \"\\n\")\n        && !contains(s, \"\\r\")\n        && !(broken && edges)\n      if plain {\n        (s, true)\n      } else {\n        (\"{\" + text.expr_text(x, d) + \"}\", false)\n      }\n    },\n    _ => match text.markup_line(x, d) {\n      Some(_) => if broken {\n        (text.expr_text(x, d), false)\n      } else {\n        (text.markup_line(x, d) ?? \"\", false)\n      },\n      None => (\"{\" + text.expr_text(x, d) + \"}\", false),\n    },\n  }\n}"},{"name":"text.markup_attr_view","kind":"fn","old":null,"new":"555237f49a3817db","interface_changed":true,"affected":[],"module":"text","text":"/// An attribute as markup: `class=\"x\"`, `class={e}`, `disabled`,\n/// `on_click={m}`. `None` for any other call.\nfn markup_attr_view(a: ast.Expr, d: Int) -> Option[String] {\n  match a {\n    ast.MethodCall { recv: ast.Var(\"web\"), name, args } => {\n      if starts_with(name, \"on_\") && matches(name, \"[a-z_]+\") {\n        return match args {\n          [x] => Some(name + \"={\" + text.expr_text(x, d) + \"}\"),\n          _ => None,\n        }\n      }\n      n := match get(args, 0) {\n        Some(ast.StrLit(n)) => n,\n        _ => return None,\n      }\n      if !matches(n, \"[a-zA-Z_][-a-zA-Z0-9_:.]*\")\n        || matches(n, \"[oO][nN].*\") {\n        return None\n      }\n      match (name, args) {\n        (\"attr\", [_, ast.StrLit(v)]) => Some(n + \"=\\\"\" + text.escape(v) + \"\\\"\"),\n        (\"attribute\", [_, v]) => Some(n + \"={\" + text.expr_text(v, d) + \"}\"),\n        (\"flag\", [_]) => Some(n),\n        _ => None,\n      }\n    },\n    _ => None,\n  }\n}"},{"name":"text.is_void_tag","kind":"fn","old":null,"new":"51108d0acdbe4b4f","interface_changed":true,"affected":[],"module":"text","text":"/// Elements that have no children and no end tag, as `std.web.is_void`.\nfn is_void_tag(tag: String) -> Bool {\n  matches(\n    tag,\n    \"area|base|br|col|embed|hr|img|input|link|meta|source|track|wbr\",\n  )\n}"}]}
{"id":"7106c6ac5c9432a3","time":1795711967,"message":"edit","changes":[{"name":"text.markup_child","kind":"fn","old":"1f9d3073ab7f979f","new":"5e0239a81f545cba","interface_changed":false,"affected":[],"module":"text","text":"/// A child as markup, and whether it is bare text. Text is bare unless\n/// reading it back would change it: it holds `<`, `{`, `}` or a line break,\n/// follows bare text (the two would read as one), or, on a line of its own,\n/// starts or ends with a space. Other code is in braces, unless it is\n/// markup itself (only markup's text starts with `<`).\nfn markup_child(\n  x: ast.Expr,\n  d: Int,\n  broken: Bool,\n  after_text: Bool,\n) -> (String, Bool) {\n  match x {\n    ast.StrLit(s) => {\n      edges := starts_with(s, \" \")\n        || ends_with(s, \" \")\n        || starts_with(s, \"\\t\")\n        || ends_with(s, \"\\t\")\n      plain := s != \"\"\n        && !after_text\n        && !contains(s, \"<\")\n        && !contains(s, \"{\")\n        && !contains(s, \"}\")\n        && !contains(s, \"\\n\")\n        && !contains(s, \"\\r\")\n        && !(broken && edges)\n      if plain {\n        (s, true)\n      } else {\n        (\"{\" + text.expr_text(x, d) + \"}\", false)\n      }\n    },\n    _ => {\n      s := if broken {\n        text.expr_text(x, d)\n      } else {\n        text.markup_line(x, d) ?? \"\"\n      }\n      if starts_with(s, \"<\") {\n        (s, false)\n      } else {\n        (\"{\" + text.expr_text(x, d) + \"}\", false)\n      }\n    },\n  }\n}","old_text":"/// A child as markup, and whether it is bare text. Text is bare unless\n/// reading it back would change it: it holds `<`, `{`, `}` or a line break,\n/// follows bare text (the two would read as one), or, on a line of its own,\n/// starts or ends with a space.\nfn markup_child(\n  x: ast.Expr,\n  d: Int,\n  broken: Bool,\n  after_text: Bool,\n) -> (String, Bool) {\n  match x {\n    ast.StrLit(s) => {\n      edges := starts_with(s, \" \")\n        || ends_with(s, \" \")\n        || starts_with(s, \"\\t\")\n        || ends_with(s, \"\\t\")\n      plain := s != \"\"\n        && !after_text\n        && !contains(s, \"<\")\n        && !contains(s, \"{\")\n        && !contains(s, \"}\")\n        && !contains(s, \"\\n\")\n        && !contains(s, \"\\r\")\n        && !(broken && edges)\n      if plain {\n        (s, true)\n      } else {\n        (\"{\" + text.expr_text(x, d) + \"}\", false)\n      }\n    },\n    _ => match text.markup_line(x, d) {\n      Some(_) => if broken {\n        (text.expr_text(x, d), false)\n      } else {\n        (text.markup_line(x, d) ?? \"\", false)\n      },\n      None => (\"{\" + text.expr_text(x, d) + \"}\", false),\n    },\n  }\n}"}]}
{"id":"a2d07805c0987420","time":1795712069,"message":"edit","changes":[{"name":"parse.markup","kind":"fn","old":"fb9086ba0df8c057","new":"4afb5b49e64f12a3","interface_changed":false,"affected":[],"module":"parse","text":"/// Markup, as calls to `std.web` (so the module needs an import from\n/// `std.web`, such as `from std.web use Html`): `<p class=\"x\">Hi {name}</p>`\n/// is `std.web.element(\"p\", [std.web.attr(\"class\", \"x\")],\n/// std.web.children([\"Hi \", name]))`, and `<>…</>` is\n/// `std.web.children([…])`. `text.markup_view` shows those calls as markup\n/// again.\nfn markup(mut p: parse.Parser) -> Result[ast.Expr, String] {\n  tag := match parse.peek(p) {\n    lex.MarkupOpen(t) => t,\n    _ => return parse.fail(p, \"expected markup\"),\n  }\n  parse.advance(mut p)\n  if tag == \"\" {\n    parse.advance(mut p)\n    items := parse.markup_children(mut p, \"\")!\n    return Ok(parse.web_call(\"children\", [ast.ListExpr(items)]))\n  }\n  if !matches(tag, \"[a-z][a-z0-9]*(-[a-z0-9]+)*\") {\n    return parse.fail(\n      p,\n      f\"`<{tag}>`: a tag is lowercase letters, digits and dashes (`div`, `my-card`); a component is a function, called in braces: `{{card(x)}}`\",\n    )\n  }\n  mut attrs := []\n  loop {\n    match parse.peek(p) {\n      lex.MarkupAttr(name) => {\n        parse.advance(mut p)\n        mut attrs.push(parse.markup_attr(mut p, name)!)\n      },\n      lex.MarkupSelfClose => {\n        parse.advance(mut p)\n        return Ok(parse.web_call(\n          \"element\",\n          [ast.StrLit(tag), ast.ListExpr(attrs), ast.ListExpr([])],\n        ))\n      },\n      lex.MarkupTagEnd => {\n        if parse.void_tag(tag) {\n          return parse.fail(\n            p,\n            f\"`<{tag}>` has no children and no end tag: write `<{tag} … />`\",\n          )\n        }\n        parse.advance(mut p)\n        break\n      },\n      _ => return parse.fail(\n        p,\n        f\"expected an attribute, `>` or `/>` in `<{tag}>`\",\n      ),\n    }\n  }\n  items := parse.markup_children(mut p, tag)!\n  kids := if len(items) == 0 {\n    ast.ListExpr([])\n  } else {\n    parse.web_call(\"children\", [ast.ListExpr(items)])\n  }\n  Ok(parse.web_call(\n    \"element\",\n    [ast.StrLit(tag), ast.ListExpr(attrs), kids],\n  ))\n}","old_text":"/// Markup, as calls to `std.web` (so the module needs `use std.web`):\n/// `<p class=\"x\">Hi {name}</p>` is\n/// `web.element(\"p\", [web.attr(\"class\", \"x\")], web.children([\"Hi \", name]))`,\n/// and `<>…</>` is `web.children([…])`. `text.markup_view` shows those calls\n/// as markup again.\nfn markup(mut p: parse.Parser) -> Result[ast.Expr, String] {\n  tag := match parse.peek(p) {\n    lex.MarkupOpen(t) => t,\n    _ => return parse.fail(p, \"expected markup\"),\n  }\n  parse.advance(mut p)\n  if tag == \"\" {\n    parse.advance(mut p)\n    items := parse.markup_children(mut p, \"\")!\n    return Ok(parse.web_call(\"children\", [ast.ListExpr(items)]))\n  }\n  if !matches(tag, \"[a-z][a-z0-9]*(-[a-z0-9]+)*\") {\n    return parse.fail(\n      p,\n      f\"`<{tag}>`: a tag is lowercase letters, digits and dashes (`div`, `my-card`); a component is a function, called in braces: `{{card(x)}}`\",\n    )\n  }\n  mut attrs := []\n  loop {\n    match parse.peek(p) {\n      lex.MarkupAttr(name) => {\n        parse.advance(mut p)\n        mut attrs.push(parse.markup_attr(mut p, name)!)\n      },\n      lex.MarkupSelfClose => {\n        parse.advance(mut p)\n        return Ok(parse.web_call(\n          \"element\",\n          [ast.StrLit(tag), ast.ListExpr(attrs), ast.ListExpr([])],\n        ))\n      },\n      lex.MarkupTagEnd => {\n        if parse.void_tag(tag) {\n          return parse.fail(\n            p,\n            f\"`<{tag}>` has no children and no end tag: write `<{tag} … />`\",\n          )\n        }\n        parse.advance(mut p)\n        break\n      },\n      _ => return parse.fail(\n        p,\n        f\"expected an attribute, `>` or `/>` in `<{tag}>`\",\n      ),\n    }\n  }\n  items := parse.markup_children(mut p, tag)!\n  kids := if len(items) == 0 {\n    ast.ListExpr([])\n  } else {\n    parse.web_call(\"children\", [ast.ListExpr(items)])\n  }\n  Ok(parse.web_call(\n    \"element\",\n    [ast.StrLit(tag), ast.ListExpr(attrs), kids],\n  ))\n}"},{"name":"parse.web_call","kind":"fn","old":"806798c60142f6b4","new":"91ab1e9e556c46a3","interface_changed":false,"affected":[],"module":"parse","text":"/// `std.web.NAME(args)`, as the parser reads that text. The module needs an\n/// import from `std.web` (as for any `std.web.NAME`).\nfn web_call(name: String, args: List[ast.Expr]) -> ast.Expr {\n  ast.MethodCall {\n    recv: ast.FieldOf { base: ast.Var(\"std\"), name: \"web\" },\n    name,\n    args,\n  }\n}","old_text":"/// `web.NAME(args)`.\nfn web_call(name: String, args: List[ast.Expr]) -> ast.Expr {\n  ast.MethodCall { recv: ast.Var(\"web\"), name, args }\n}"}]}
{"id":"cec25cb786af38e2","time":1795712096,"message":"edit","changes":[{"name":"text.markup_parts","kind":"fn","old":"0a9b4640d648537a","new":"75bcccba8f9c0d99","interface_changed":false,"affected":[],"module":"text","text":"/// An element's start tag (the whole element when it has no children),\n/// its children as shown, and its end tag. `broken`: each child goes on its\n/// own line, so text with spaces at an end is written `{\"…\"}`.\nfn markup_parts(\n  e: ast.Expr,\n  d: Int,\n  broken: Bool,\n) -> Option[(String, List[String], String)] {\n  (f, args) := text.web_fn(e)?\n  (tag, attrs, items) := if f == \"element\" && len(args) == 3 {\n    tag := match get(args, 0) {\n      Some(ast.StrLit(t)) => t,\n      _ => return None,\n    }\n    if !matches(tag, \"[a-z][a-z0-9]*(-[a-z0-9]+)*\") {\n      return None\n    }\n    attrs := match get(args, 1) {\n      Some(ast.ListExpr(xs)) => xs,\n      _ => return None,\n    }\n    kids := get(args, 2) ?? ast.UnitExpr\n    items := match kids {\n      ast.ListExpr(xs) => if len(xs) == 0 {\n        None\n      } else {\n        return None\n      },\n      _ => match text.web_fn(kids) {\n        Some((\"children\", [ast.ListExpr(xs)])) => if len(xs) > 0 && !text.is_void_tag(tag) {\n          Some(xs)\n        } else {\n          return None\n        },\n        _ => return None,\n      },\n    }\n    (tag, attrs, items)\n  } else if f == \"children\" {\n    match args {\n      [ast.ListExpr(xs)] => (\"\", [], Some(xs)),\n      _ => return None,\n    }\n  } else {\n    return None\n  }\n  mut shown := []\n  for a in attrs {\n    mut shown.push(text.markup_attr_view(a, d)?)\n  }\n  head := \"<\" + tag + join(shown.map(s -> \" \" + s), \"\")\n  match items {\n    None => Some((head + \" />\", [], \"\")),\n    Some(xs) => {\n      mut out := []\n      mut after_text := false\n      for x in xs {\n        (s, bare) := text.markup_child(x, d, broken, after_text)\n        mut out.push(s)\n        after_text = bare\n      }\n      Some((head + \">\", out, \"</\" + tag + \">\"))\n    },\n  }\n}","old_text":"/// An element's start tag (the whole element when it has no children),\n/// its children as shown, and its end tag. `broken`: each child goes on its\n/// own line, so text with spaces at an end is written `{\"…\"}`.\nfn markup_parts(\n  e: ast.Expr,\n  d: Int,\n  broken: Bool,\n) -> Option[(String, List[String], String)] {\n  (tag, attrs, items) := match e {\n    ast.MethodCall { recv: ast.Var(\"web\"), name: \"element\", args } => {\n      if len(args) != 3 {\n        return None\n      }\n      tag := match get(args, 0) {\n        Some(ast.StrLit(t)) => t,\n        _ => return None,\n      }\n      if !matches(tag, \"[a-z][a-z0-9]*(-[a-z0-9]+)*\") {\n        return None\n      }\n      attrs := match get(args, 1) {\n        Some(ast.ListExpr(xs)) => xs,\n        _ => return None,\n      }\n      items := match get(args, 2) {\n        Some(ast.ListExpr(xs)) => if len(xs) == 0 {\n          None\n        } else {\n          return None\n        },\n        Some(ast.MethodCall { recv: ast.Var(\"web\"), name: \"children\", args: cs }) => match cs {\n          [ast.ListExpr(xs)] => if len(xs) > 0 && !text.is_void_tag(tag) {\n            Some(xs)\n          } else {\n            return None\n          },\n          _ => return None,\n        },\n        _ => return None,\n      }\n      (tag, attrs, items)\n    },\n    ast.MethodCall { recv: ast.Var(\"web\"), name: \"children\", args } => match args {\n      [ast.ListExpr(xs)] => (\"\", [], Some(xs)),\n      _ => return None,\n    },\n    _ => return None,\n  }\n  mut shown := []\n  for a in attrs {\n    mut shown.push(text.markup_attr_view(a, d)?)\n  }\n  head := \"<\" + tag + join(shown.map(s -> \" \" + s), \"\")\n  match items {\n    None => Some((head + \" />\", [], \"\")),\n    Some(xs) => {\n      mut out := []\n      mut after_text := false\n      for x in xs {\n        (s, bare) := text.markup_child(x, d, broken, after_text)\n        mut out.push(s)\n        after_text = bare\n      }\n      Some((head + \">\", out, \"</\" + tag + \">\"))\n    },\n  }\n}"},{"name":"text.markup_attr_view","kind":"fn","old":"555237f49a3817db","new":"ba7f59c48672fed8","interface_changed":false,"affected":[],"module":"text","text":"/// An attribute as markup: `class=\"x\"`, `class={e}`, `disabled`,\n/// `on_click={m}`. `None` for any other call.\nfn markup_attr_view(a: ast.Expr, d: Int) -> Option[String] {\n  (name, args) := text.web_fn(a)?\n  if starts_with(name, \"on_\") && matches(name, \"[a-z_]+\") {\n    return match args {\n      [x] => Some(name + \"={\" + text.expr_text(x, d) + \"}\"),\n      _ => None,\n    }\n  }\n  n := match get(args, 0) {\n    Some(ast.StrLit(n)) => n,\n    _ => return None,\n  }\n  if !matches(n, \"[a-zA-Z_][-a-zA-Z0-9_:.]*\")\n    || matches(n, \"[oO][nN].*\") {\n    return None\n  }\n  match (name, args) {\n    (\"attr\", [_, ast.StrLit(v)]) => Some(n + \"=\\\"\" + text.escape(v) + \"\\\"\"),\n    (\"attribute\", [_, v]) => Some(n + \"={\" + text.expr_text(v, d) + \"}\"),\n    (\"flag\", [_]) => Some(n),\n    _ => None,\n  }\n}","old_text":"/// An attribute as markup: `class=\"x\"`, `class={e}`, `disabled`,\n/// `on_click={m}`. `None` for any other call.\nfn markup_attr_view(a: ast.Expr, d: Int) -> Option[String] {\n  match a {\n    ast.MethodCall { recv: ast.Var(\"web\"), name, args } => {\n      if starts_with(name, \"on_\") && matches(name, \"[a-z_]+\") {\n        return match args {\n          [x] => Some(name + \"={\" + text.expr_text(x, d) + \"}\"),\n          _ => None,\n        }\n      }\n      n := match get(args, 0) {\n        Some(ast.StrLit(n)) => n,\n        _ => return None,\n      }\n      if !matches(n, \"[a-zA-Z_][-a-zA-Z0-9_:.]*\")\n        || matches(n, \"[oO][nN].*\") {\n        return None\n      }\n      match (name, args) {\n        (\"attr\", [_, ast.StrLit(v)]) => Some(n + \"=\\\"\" + text.escape(v) + \"\\\"\"),\n        (\"attribute\", [_, v]) => Some(n + \"={\" + text.expr_text(v, d) + \"}\"),\n        (\"flag\", [_]) => Some(n),\n        _ => None,\n      }\n    },\n    _ => None,\n  }\n}"},{"name":"text.web_fn","kind":"fn","old":null,"new":"376f74529159d488","interface_changed":true,"affected":[],"module":"text","text":"/// A call of a `std.web` function, as stored (`std.web.element(…)`), written\n/// after `use std.web` (`web.element(…)`), or as the parser reads either:\n/// the function's name and the arguments.\nfn web_fn(e: ast.Expr) -> Option[(String, List[ast.Expr])] {\n  match e {\n    ast.Call { callee: ast.Var(v), args } => if starts_with(v, \"std.web.\") {\n      Some((byte_slice(v, 8, byte_len(v)), args))\n    } else if starts_with(v, \"web.\") {\n      Some((byte_slice(v, 4, byte_len(v)), args))\n    } else {\n      None\n    },\n    ast.MethodCall { recv: ast.Var(\"web\"), name, args } => Some((name, args)),\n    ast.MethodCall { recv: ast.FieldOf { base: ast.Var(\"std\"), name: \"web\" }, name, args } => Some((name, args)),\n    _ => None,\n  }\n}"}]}
{"id":"40aaa114f98c7be9","time":1795712206,"message":"edit","changes":[{"name":"lex.string","kind":"fn","old":"4de7f410ba437c71","new":"7f4c22c9a971f5fd","interface_changed":true,"affected":["lex.lex","lex.markup_tag","lex_one","lex_lines","parse.parser","lex_files","front_command","parse.parse_module","parse.parse_expr","parse.fstring_part","command_line","strata_command","diff.parsed","stored_package","edit_command","edit_file","edit_in_editor","merge_file_command","resolve_command","write_found","merge.merge","parse.parse_program","graph.trace_graph","call_command","kept_invariants","parse.primary_inner","main","diff.apply","diff.undo","repl_command","find_invariants","parse_one","stored_one","parse_lines","stored_lines","repl_line","graph_command","run_command","build_command","parse.primary","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","diff.log_steps","diff.states","verify_file","parse_files","stored_files","parse.postfix","parse.ident_primary","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","diff.git_range","diff.log_range","verify_command","build_proofs","alongside_command","search_invariants","parse.unary","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","diff_command","tour.side_range","apply_edit","fix_loops","parse.binary","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","or_solver_inputs","check_command","static_graph","program_objects","comptime_values","tour_graph","tour.package_changes","fix_command","parse.expr","parse.index","loaded_errors","file_errors","edit_errors","check_fn","graph_diff","linked","expanded","comptime_runner","tour_command","tour.prepare","parse.trait_decl","parse.impl_rest","parse.type_decl","parse.fields","parse.fn_rest","parse.expr_ns","parse.args","parse.expr_list","parse.sym_primary","parse.comp_fors","parse.entry","parse.statement","parse.ident_pattern","parse.markup_code","parse.postfix_from","package_errors","check_files","apply_change","with_base","parse.decl_kind","parse.payload","parse.capability_decl","parse.fn_decl","parse.type_expr","parse.loop_body","parse.marked","parse.collection_body","parse.block","parse.pattern_one","parse.markup_children","parse.markup_attr","rename_command","move_command","parse.decl_inner","parse.derive_group","parse.member","parse.type_list","parse.type_expr_plain","parse.result_type","parse.params_bound","parse.collection","parse.pattern","parse.markup","parse.decl","parse.bounded_params","parse.type_union","parse.params","parse.binding_pattern","parse.pattern_list","parse.param_pattern","parse.type_params"],"module":"lex","text":"/// A string literal: `\"a\\n\"`, at its `\"`.\nfn string(\n  mut lx: lex.Lexer,\n  sl: Int,\n  sc: Int,\n  space: Bool,\n) -> Result[(), String]\n  requires lx.at < len(lx.chars) {\n  n := len(lx.chars)\n  lx.at += 1\n  mut s := \"\"\n  while lx.at < n && lex.char_at(lx, lx.at) != \"\\\"\"\n    invariant lx.at <= n {\n    ch := lex.char_at(lx, lx.at)\n    if ch == \"\\\\\" && lx.at + 1 < n {\n      lx.at += 1\n      s += lex.escaped(lex.char_at(lx, lx.at))\n    } else {\n      if ch == \"\\n\" {\n        lx.line += 1\n      }\n      s += ch\n    }\n    lx.at += 1\n  }\n  if lx.at >= n {\n    return Err(f\"{sl}:{sc}: unterminated string\")\n  }\n  lx.at += 1\n  lx.col += 2 + byte_len(s)\n  lex.push_token(mut lx, lex.StrTok(s), sl, sc, space)\n  Ok(())\n}","old_text":"/// A string literal: `\"a\\n\"`.\nfn string(\n  mut lx: lex.Lexer,\n  sl: Int,\n  sc: Int,\n  space: Bool,\n) -> Result[(), String] {\n  n := len(lx.chars)\n  lx.at += 1\n  mut s := \"\"\n  while lx.at < n && lex.char_at(lx, lx.at) != \"\\\"\"\n    invariant lx.at <= n {\n    ch := lex.char_at(lx, lx.at)\n    if ch == \"\\\\\" && lx.at + 1 < n {\n      lx.at += 1\n      s += lex.escaped(lex.char_at(lx, lx.at))\n    } else {\n      if ch == \"\\n\" {\n        lx.line += 1\n      }\n      s += ch\n    }\n    lx.at += 1\n  }\n  if lx.at >= n {\n    return Err(f\"{sl}:{sc}: unterminated string\")\n  }\n  lx.at += 1\n  lx.col += 2 + byte_len(s)\n  lex.push_token(mut lx, lex.StrTok(s), sl, sc, space)\n  Ok(())\n}"}]}
{"id":"b5c56145c5a682f7","time":1795712250,"message":"edit","changes":[{"name":"lex.markup_tag","kind":"fn","old":"2fb28b6c30ac4fe9","new":"a7a1bcfd9b00a4d0","interface_changed":false,"affected":[],"module":"lex","text":"/// One token of a start tag: an attribute's name, `=`, a string, `{`, `>`\n/// or `/>`.\nfn markup_tag(\n  mut lx: lex.Lexer,\n  sl: Int,\n  sc: Int,\n  space: Bool,\n) -> Result[(), String] {\n  c := lex.char_at(lx, lx.at)\n  next := lex.char_at(lx, lx.at + 1)\n  if c == \">\" {\n    lx.at += 1\n    lx.col += 1\n    lex.push_token(mut lx, lex.MarkupTagEnd, sl, sc, space)\n    lex.set_mode(mut lx, lex.InChildren)\n    return Ok(())\n  }\n  if c == \"/\" && next == \">\" {\n    lx.at += 2\n    lx.col += 2\n    lex.push_token(mut lx, lex.MarkupSelfClose, sl, sc, space)\n    lex.pop_mode(mut lx)\n    return Ok(())\n  }\n  if c == \"{\" || c == \"=\" {\n    lx.at += 1\n    lx.col += 1\n    lex.push_token(mut lx, lex.Sym(c), sl, sc, space)\n    if c == \"{\" {\n      lex.push_mode(mut lx, lex.InCode(0))\n    }\n    return Ok(())\n  }\n  if c == \"\\\"\" && lx.at < len(lx.chars) {\n    return lex.string(mut lx, sl, sc, space)\n  }\n  if lex.is_ascii_letter(c) || c == \"_\" {\n    start := lx.at\n    while lx.at < len(lx.chars)\n      && (lex.is_tag_char(lex.char_at(lx, lx.at))\n        || contains(\"_:.\", lex.char_at(lx, lx.at))) {\n      lx.at += 1\n    }\n    lx.col += lx.at - start\n    lex.push_token(\n      mut lx,\n      lex.MarkupAttr(lex.text_of(lx, start, lx.at)),\n      sl,\n      sc,\n      space,\n    )\n    return Ok(())\n  }\n  Err(\n    f\"{sl}:{sc}: unexpected character {lex.debug_char(c)} in a tag\",\n  )\n}","old_text":"/// One token of a start tag: an attribute's name, `=`, a string, `{`, `>`\n/// or `/>`.\nfn markup_tag(\n  mut lx: lex.Lexer,\n  sl: Int,\n  sc: Int,\n  space: Bool,\n) -> Result[(), String] {\n  c := lex.char_at(lx, lx.at)\n  next := lex.char_at(lx, lx.at + 1)\n  if c == \">\" {\n    lx.at += 1\n    lx.col += 1\n    lex.push_token(mut lx, lex.MarkupTagEnd, sl, sc, space)\n    lex.set_mode(mut lx, lex.InChildren)\n    return Ok(())\n  }\n  if c == \"/\" && next == \">\" {\n    lx.at += 2\n    lx.col += 2\n    lex.push_token(mut lx, lex.MarkupSelfClose, sl, sc, space)\n    lex.pop_mode(mut lx)\n    return Ok(())\n  }\n  if c == \"{\" || c == \"=\" {\n    lx.at += 1\n    lx.col += 1\n    lex.push_token(mut lx, lex.Sym(c), sl, sc, space)\n    if c == \"{\" {\n      lex.push_mode(mut lx, lex.InCode(0))\n    }\n    return Ok(())\n  }\n  if c == \"\\\"\" {\n    return lex.string(mut lx, sl, sc, space)\n  }\n  if lex.is_ascii_letter(c) || c == \"_\" {\n    start := lx.at\n    while lx.at < len(lx.chars)\n      && (lex.is_tag_char(lex.char_at(lx, lx.at))\n        || contains(\"_:.\", lex.char_at(lx, lx.at))) {\n      lx.at += 1\n    }\n    lx.col += lx.at - start\n    lex.push_token(\n      mut lx,\n      lex.MarkupAttr(lex.text_of(lx, start, lx.at)),\n      sl,\n      sc,\n      space,\n    )\n    return Ok(())\n  }\n  Err(\n    f\"{sl}:{sc}: unexpected character {lex.debug_char(c)} in a tag\",\n  )\n}"}]}
{"id":"fa144285f65bc797","time":1795712559,"message":"edit","changes":[{"name":"codegen.member_tags","kind":"fn","old":"4f30c8658a919296","new":"4b41077e29104410","interface_changed":true,"affected":["codegen.holds_member","codegen.read_slot","codegen.matches","codegen.on_members","codegen.union_eq","codegen.check_union","codegen.expr_node","codegen.read_back","codegen.read_all","codegen.read_ctor","codegen.destructure","codegen.binds","codegen.for_loop","codegen.matching_v","codegen.match_got","codegen.union_text","codegen.union_cmp","codegen.union_drop","codegen.union_call","codegen.union_field","codegen.union_set","codegen.copy_fn","codegen.share_fn","codegen.helper","codegen.check_type","codegen.expr","computed_value","repl_eval","codegen.stmt_node","codegen.matching_want","codegen.cmp_helper","codegen.drop_value","codegen.tail_drop","codegen.region_drop_fn","codegen.method_call","codegen.get_field","codegen.set_path","codegen.copy_out","codegen.share_value","codegen.tail_share","codegen.show","codegen.shown","codegen.equal","codegen.function","codegen.declare","codegen.call_fn_want","codegen.check_payload","codegen.construct_want","codegen.check_field","codegen.assign_at","codegen.lambda_shown","codegen.set_in_place","codegen.checked_update","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.loop_body","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.operands_want","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.try_want","codegen.tag_test","codegen.update_in_place","codegen.take_in_place","codegen.expr_want_node","codegen.compared","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_