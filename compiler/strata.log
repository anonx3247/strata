.V { ty: TBool, op: acc }\n}"},{"name":"codegen.to_union","kind":"fn","old":"87c2d062754a6d28","new":"3f84463bf3ce434f","interface_changed":true,"affected":["codegen.list_builtin","codegen.converted","codegen.push_in_place","codegen.builtin","codegen.take_in_place","codegen.collection_builtin","codegen.list_literal_of","codegen.produce","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.update_in_place","codegen.table_find","codegen.set_in_place","codegen.expr_want_node","codegen.stmt_node","codegen.call_named","codegen.builtin_call","codegen.gen_list","codegen.list_literal","codegen.gen_fn","codegen.construct","codegen.operands","codegen.binary","codegen.branch_value","codegen.mock_call","codegen.expr_want","codegen.stmt","codegen.expr_node","codegen.method_call","codegen.except_expr","codegen.matching_want","codegen.generated","codegen.can_generate","codegen.main_arg","codegen.session_capability","codegen.for_loop","codegen.union_call","codegen.dyn_generic_call","codegen.compared","codegen.if_want","codegen.matching_v","codegen.match_got","codegen.function","codegen.declare","codegen.destructure","codegen.block_expr","codegen.call_fn_want","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.try_want","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.checked_update","codegen.appended","codegen.build_fn","codegen.iterate","codegen.decreases_start","codegen.decreases_pass","codegen.decreases_entry","codegen.decreases_call","codegen.expr","codegen.matching","codegen.gen_data","codegen.mock_method","codegen.built_or_generated","codegen.generated_args","codegen.makers","codegen.entry","codegen.session_entry","codegen.checked","codegen.if_expr","codegen.compiled_alone","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.generate","codegen.try_expr","codegen.function_value","codegen.lamb