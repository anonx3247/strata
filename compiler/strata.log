"name":"codegen.push_scope","kind":"fn","old":"e97e81552d4777fd","new":"913c811ef680c06b","interface_changed":false,"affected":[],"module":"codegen","text":"fn push_scope(mut g: codegen.Gen) {\n  mut g.scopes.push(\n    codegen.Scope {\n      vars: Dict[String, codegen.Local] {},\n      owned: [],\n      temps: [],\n      transparent: false,\n      tasks: \"\",\n      stacked: Dict[String, List[check.Ty]] {},\n    },\n  )\n}","old_text":"fn push_scope(mut g: codegen.Gen) {\n  mut g.scopes.push(\n    codegen.Scope {\n      vars: Dict[String, codegen.Local] {},\n      owned: [],\n      temps: [],\n      transparent: false,\n      tasks: \"\",\n      stacked: Dict[String, List[Ty]] {},\n    },\n  )\n}"},{"name":"codegen.local","kind":"fn","old":"dc148af6917d1135","new":"682c226a5db5cdd5","interface_changed":true,"affected":["codegen.bind","codegen.local_owned","codegen.iterate","codegen.mock_method","codegen.narrowed_var","codegen.binds","codegen.declare","codegen.builtin_call","codegen.select_expr","codegen.race_expr","codegen.produce","codegen.fuzz_driver","codegen.converted","codegen.or_else","codegen.checked_update","codegen.build_fn","codegen.generated_args","codegen.export_entry","codegen.for_list","codegen.vtable","codegen.mock_table","codegen.mock_call","codegen.if_want","codegen.matching_v","codegen.destructure","codegen.for_loop","codegen.match_got","codegen.stmt_node","codegen.call_named","codegen.method_call","codegen.except_expr","codegen.matching_want","codegen.expr_node","codegen.gen_fn","codegen.generate","codegen.list_builtin","codegen.collection_builtin","codegen.list_literal_of","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.update_in_place","codegen.table_find","codegen.set_in_place","codegen.take_in_place","codegen.expr_want_node","codegen.built_or_generated","codegen.to_dyn","codegen.dyn_table_is","codegen.mock_value","codegen.if_expr","codegen.stmt","codegen.matching","codegen.expr","codegen.generated","codegen.can_gen