n, t: check.Ty) -> (String, String, String) {\n  k := codegen.key(t)\n  res := check.TNamed { name: \"Result\", args: [t, codegen.panic_ty()] }\n  (_, drop) := codegen.task_fns(mut g, res)\n  (run, fail) := (f\"@\\\"task.srun:{k}\\\"\", f\"@\\\"task.sfail:{k}\\\"\")\n  if !codegen.has_helper(g, run) {\n    codegen.add_helper(mut g, run)\n    codegen.use_rt(mut g, \"strata_was_unwound\")\n    saved := g\n    codegen.start_helper(mut g)\n    codegen.emit(mut g, \"%raw = load i64, ptr %c\")\n    codegen.emit(mut g, \"%f = inttoptr i64 %raw to ptr\")\n    v := codegen.call_bare(\n      mut g,\n      t,\n      \"%f\",\n      [codegen.V { ty: check.TStr, op: \"%c\" }],\n    )\n    codegen.emit(mut g, \"%unwound = call i1 @strata_was_unwound()\")\n    codegen.emit(mut g, \"br i1 %unwound, label %none, label %some\")\n    codegen.block(mut g, \"some\")\n    // owned: moved into the block\n    held := codegen.temp(mut g, v)\n    b := codegen.block_of(mut g, get(g.tags, \"Ok\") ?? 0, [held])\n    codegen.emit(mut g, f\"store ptr {b}, ptr %out\")\n    codegen.emit(mut g, \"ret void\")\n    codegen.block(mut g, \"none\")\n    codegen.emit(mut g, \"ret void\")\n    codegen.restore(\n      mut g,\n      saved,\n      codegen.helper_text(g, f\"define void {run}(ptr %c, ptr %out)\"),\n    )\n  }\n  if !codegen.has_helper(g, fail) {\n    codegen.add_helper(mut g, fail)\n    saved := g\n    codegen.start_helper(mut g)\n    // the strings are owned: moved into the record, and the record into\n    // `Err`\n    mut fields := []\n    for s in [\"%kind\", \"%msg\", \"%stack\"] {\n      mut fields.push(\n        codegen.temp(mut g, codegen.V { ty: check.TStr, op: s }),\n      )\n    }\n    p := codegen.block_of(mut g, get(g.tags, \"Panic\") ?? 0, fields)\n    pv := codegen.temp(mut g, codegen.V { ty: codegen.panic_ty(), op: p })\n    b := codegen.block_of(mut g, get(g.tags, \"Err\") ?? 0, [pv])\n    codegen.emit(mut g, f\"store ptr {b}, ptr %out\")\n    codegen.emit(mut g, \"ret void\")\n    head := f\"define void {fail}(ptr %out, ptr %kind, ptr %msg, ptr %stack)\"\n    codegen.restore(mut g, saved, codegen.helper_text(g, head))\n  }\n  (run, drop, fail)\n}","old_text":"/// For a supervised task whose closure gives a `t`, three functions:\n/// - one running it and storing `Ok(v)`, or nothing if cancelled\n/// - one dropping a stored `Result[t, Panic]`\n/// - one storing `Err(Panic { kind, message, stack })` after a panic, from\n/// the runtime's strings, which it takes\nfn supervised_fns(mut g: codegen.Gen, t: Ty) -> (String, String, String) {\n  k := codegen.key(t)\n  res := TNamed { name: \"Result\", args: [t, codegen.panic_ty()] }\n  (_, drop) := codegen.task_fns(mut g, res)\n  (run, fail) := (f\"@\\\"task.srun:{k}\\\"\", f\"@\\\"task.sfail:{k}\\\"\")\n  if !codegen.has_helper(g, run) {\n    codegen.add_helper(mut g, run)\n    codegen.use_rt(mut g, \"strata_was_unwound\")\n    saved := g\n    codegen.start_helper(mut g)\n    codegen.emit(mut g, \"%raw = load i64, ptr %c\")\n    codegen.emit(mut g, \"%f = inttoptr i64 %raw to ptr\")\n    v := codegen.call_bare(\n      mut g,\n      t,\n      \"%f\",\n      [codegen.V { ty: TStr, op: \"%c\" }],\n    )\n    codegen.emit(mut g, \"%unwound = call i1 @strata_was_unwound()\")\n    codegen.emit(mut g, \"br i1 %unwound, label %none, label %some\")\n    codegen.block(mut g, \"some\")\n    // owned: moved into the block\n    held := codegen.temp(mut g, v)\n    b := codegen.block_of(mut g, get(g.tags, \"Ok\") ?? 0, [held])\n    codegen.emit(mut g, f\"store ptr {b}, ptr %out\")\n    codegen.emit(mut g, \"ret void\")\n    codegen.block(mut g, \"none\")\n    codegen.emit(mut g, \"ret void\")\n    codegen.restore(\n      mut g,\n      saved,\n      codegen.helper_text(g, f\"define void {run}(ptr %c, ptr %out)\"),\n    )\n  }\n  if !codegen.has_helper(g, fail) {\n    codegen.add_helper(mut g, fail)\n    saved := g\n    codegen.start_helper(mut g)\n    // the strings are owned: moved into the record, and the record into\n    // `Err`\n    mut fields := []\n    for s in [\"%kind\", \"%msg\", \"%stack\"] {\n      mut fields.push(\n        codegen.temp(mut g, codegen.V { ty: TStr, op: s }),\n      )\n    }\n    p := codegen.block_of(mut g, get(g.tags, \"Panic\") ?? 0, fields)\n    pv := codegen.temp(mut g, codegen.V { ty: codegen.panic_ty(), op: p })\n    b := codegen.block_of(mut g, get(g.tags, \"Err\") ?? 0, [pv])\n    codegen.emit(mut g, f\"store ptr {b}, ptr %out\")\n    codegen.emit(mut g, \"ret void\")\n    head := f\"define void {fail}(ptr %out, ptr %kind, ptr %msg, ptr %stack)\"\n    codegen.restore(mut g, saved, codegen.helper_text(g, head))\n  }\n  (run, drop, fail)\n}"},{"name":"codegen.await_expr","kind":"fn","old":"c9bd4cedd5e9acfc","new":"ad7f09a99cb72267","interface_changed":false,"affected":[],"module":"codegen","text":"/// `await h`: a handle's result, or the results of a tuple or list of them.\nfn await_expr(mut g: codegen.Gen, h: ast.Expr) -> codegen.V {\n  v := codegen.expr(mut g, h)\n  match v.ty {\n    check.TAny => v,\n    check.TNamed { name: \"Task\", args: [rt] } => codegen.await_one(mut g, v, rt),\n    check.TNamed { name: \"Tuple\", args: hs } => {\n      mut vs := []\n      for (i, ht) in enumerate(hs) {\n        x := codegen.field(mut g, v, i, ht)\n        rt := match ht {\n          check.TNamed { name: \"Task\", args: [r] } => r,\n          _ => check.TAny,\n        }\n        mut vs.push(codegen.await_one(mut g, x, rt))\n      }\n      b := codegen.block_of(mut g, 0, vs)\n      t := check.TNamed { name: \"Tuple\", args: vs.map(x -> x.ty) }\n      codegen.temp(mut g, codegen.V { ty: t, op: b })\n    },\n    check.TList(check.TNamed { name: \"Task\", args: [rt] }) => codegen.await_list(mut g, v, rt),\n    _ => {\n      codegen.not_yet(\n        mut g,\n        \"`await` of a `\" + codegen.key(v.ty) + \"`\",\n      )\n      codegen.never()\n    },\n  }\n}","old_text":"/// `await h`: a handle's result, or the results of a tuple or list of them.\nfn await_expr(mut g: codegen.Gen, h: ast.Expr) -> codegen.V {\n  v := codegen.expr(mut g, h)\n  match v.ty {\n    TAny => v,\n    TNamed { name: \"Task\", args: [rt] } => codegen.await_one(mut g, v, rt),\n    TNamed { name: \"Tuple\", args: hs } => {\n      mut vs := []\n      for (i, ht) in enumerate(hs) {\n        x := codegen.field(mut g, v, i, ht)\n        rt := match ht {\n          TNamed { name: \"Task\", args: [r] } => r,\n          _ => TAny,\n        }\n        mut vs.push(codegen.await_one(mut g, x, rt))\n      }\n      b := codegen.block_of(mut g, 0, vs)\n      t := TNamed { name: \"Tuple\", args: vs.map(x -> x.ty) }\n      codegen.temp(mut g, codegen.V { ty: t, op: b })\n    },\n    TList(TNamed { name: \"Task\", args: [rt] }) => codegen.await_list(mut g, v, rt),\n    _ => {\n      codegen.not_yet(\n        mut g,\n        \"`await` of a `\" + codegen.key(v.ty) + \"`\",\n      )\n      codegen.never()\n    },\n  }\n}"},{"name":"codegen.await_one","kind":"fn","old":"f9919cb69a014b5e","new":"c709b80d127db32b","interface_changed":true,"affected":["codegen.await_expr","codegen.await_list","codegen.select_expr","codegen.race_expr","codegen.expr_node","codegen.expr","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.method_call","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.try_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.expr_want_node","codegen.compared","codegen.stmt_node","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.