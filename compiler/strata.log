en.emit(mut g, f\"br label %{end}\")\n  codegen.block(mut g, end)\n  r := codegen.fresh(mut g, \"o\")\n  codegen.emit(\n    mut g,\n    f\"{r} = phi ptr [ {b}, %{some} ], [ {n}, %{none} ]\",\n  )\n  codegen.temp(mut g, codegen.V { ty: t, op: r })\n}","old_text":"/// `Some(v)` when pointer `v` is not NULL, else `None`. `Some` takes `v`;\n/// NULL has nothing to drop.\nfn optional(mut g: codegen.Gen, v: codegen.V, t: Ty) -> codegen.V {\n  isnull := codegen.fresh(mut g, \"null\")\n  codegen.emit(mut g, f\"{isnull} = icmp eq ptr {v.op}, null\")\n  (some, none, end) := (\n    codegen.label(mut g, \"some\"),\n    codegen.label(mut g, \"none\"),\n    codegen.label(mut g, \"opt\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"br i1 {isnull}, label %{none}, label %{some}\",\n  )\n  codegen.block(mut g, some)\n  b := codegen.block_of(mut g, get(g.tags, \"Some\") ?? 0, [v])\n  codegen.emit(mut g, f\"br label %{end}\")\n  codegen.block(mut g, none)\n  n := codegen.nullary(mut g, \"None\")\n  codegen.emit(mut g, f\"br label %{end}\")\n  codegen.block(mut g, end)\n  r := codegen.fresh(mut g, \"o\")\n  codegen.emit(\n    mut g,\n    f\"{r} = phi ptr [ {b}, %{some} ], [ {n}, %{none} ]\",\n  )\n  codegen.temp(mut g, codegen.V { ty: t, op: r })\n}"},{"name":"codegen.outcome","kind":"fn","old":"5bf0e80102aaf88f","new":"74377553cf7352db","interface_changed":true,"affected":["codegen.host","codegen.builtin","codegen.call_named","codegen.builtin_call","codegen.push_in_place","codegen.expr_node","codegen.expr_want_node","codegen.method_call","codegen.except_expr","codegen.matching_want","codegen.update_in_place","codegen.expr","codegen.expr_want","codegen.matching","codegen.stmt_node","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_exp