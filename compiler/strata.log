codegen.push_scope(mut g)\n  mut incoming := []\n  codegen.block(mut g, some)\n  x := codegen.list_at(mut g, xs, i.op, et)\n  for a in arms {\n    p := match a.pat {\n      ast.CtorPattern { name: \"Some\", args: ast.PositionalPats([q]) } => q,\n      _ => ast.Wild,\n    }\n    if !codegen.none_pat(a.pat) {\n      next := codegen.label(mut g, \"arm\")\n      codegen.push_scope(mut g)\n      codegen.matches(mut g, p, x, next)\n      codegen.binds(mut g, p, x)\n      r0 := codegen.branch_value(mut g, a.body, want)\n      r := codegen.leave_branch(mut g, r0)\n      mut incoming.push((r, codegen.current(g)))\n      codegen.br(mut g, end)\n      codegen.block(mut g, next)\n      if a.pat is ast.Wild {\n        break\n      }\n    }\n  }\n  codegen.emit(mut g, \"unreachable\")\n  codegen.block(mut g, none)\n  match arms.find(a -> !codegen.some_pat(a.pat)) {\n    Some(a) => {\n      codegen.push_scope(mut g)\n      r0 := codegen.branch_value(mut g, a.body, want)\n      r := codegen.leave_branch(mut g, r0)\n      mut incoming.push((r, codegen.current(g)))\n      codegen.br(mut g, end)\n    },\n    None => codegen.emit(mut g, \"unreachable\"),\n  }\n  codegen.block(mut g, end)\n  r := codegen.join_values(mut g, incoming)\n  // each arm's value is held: the match's scope holds the one that came\n  r1 := codegen.temp(mut g, r)\n  y := codegen.leave_branch(mut g, r1)\n  codegen.temp(mut g, y)\n}","old_text":"/// `match get(xs, i) { … }` on list `xs` (elements `et`) with arms\n/// `Some(p)`, `None` or `_`. In bounds, element `i` (borrowed) is matched\n/// against each `Some` arm's pattern. Else the first `None` or `_` arm runs.\nfn match_got(\n  mut g: codegen.Gen,\n  xs0: codegen.V,\n  index: ast.Expr,\n  et: Ty,\n  arms: List[ast.Arm],\n  want: Ty,\n) -> codegen.V {\n  // the list is held when the index may assign to it\n  held := if codegen.assigns(index) {\n    codegen.hold(mut g, xs0)\n  } else {\n    xs0\n  }\n  i := codegen.expr_want(mut g, index, TInt)\n  if i.ty is TAny