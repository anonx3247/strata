es","move_command","fix_command","edit_in_editor","codegen_file","jit_file","fuzz_file","graph_runs","replay","or_solver_inputs","program_objects","sync_command","check_fn","linked"],"module":"check","text":"/// The variants `left` keeps under fact `c` about the result `it`, and\n/// whether `c` speaks of `it`'s variant under a condition the arguments'\n/// types don't decide.\nfn narrow_by(\n  i: check.Inf,\n  c: ast.Expr,\n  params: List[String],\n  args: List[check.Ty],\n  owner: String,\n  left: Set[String],\n) -> (Set[String], Bool) {\n  about := walk.says_variant_of_it([c])\n  match c {\n    ast.Binary { op: ast.Implies, left: a, right: q } => match check.decide(i, a, params, args) {\n      Some(true) => check.narrow_by(i, q, params, args, owner, left),\n      Some(false) => (left, false),\n      None => (left, about),\n    },\n    // `(it is V) == A`: either way round\n    ast.Binary { op: ast.Equal, left: l, right: r } => match (\n      check.result_variants(i, l, owner),\n      check.result_variants(i, r, owner),\n    ) {\n      (Some(vs), None) => match check.decide(i, r, params, args) {\n        Some(true) => (left.intersection(vs), false),\n        Some(false) => (left.difference(vs), false),\n        None => (left, true),\n      },\n      (None, Some(vs)) => match check.decide(i, l, params, args) {\n        Some(true) => (left.intersection(vs), false),\n        Some(false) => (left.difference(vs), false),\n        None => (left, true),\n      },\n      _ => (left, about),\n    },\n    _ => match check.result_variants(i, c, owner) {\n      Some(vs) => (left.intersection(vs), false),\n      None => (left, about),\n    },\n  }\n}","old_text":"/// The variants `left` keeps under fact `c` about the result `it`, and\n/// whether `c` speaks of `it`'s variant under a condition the arguments'\n/// types don't decide.\nfn narrow_by(\n  i: check.Inf,\n  c: ast.Expr,\n  params: List[String],\n  args: List[check.Ty],\n  owner: String,\n  left: Set[String],\n) -> (Set[String], Bool)\n  ensures it.0.difference(left).len() == 0 {\n  about := walk.says_variant_of_it([c])\n  match c {\n    ast.Binary { op: ast.Implies, left: a, right: q } => match check.decide(i, a, params, args) {\n      Some(true) => check.narrow_by(i, q, params, args, owner, left),\n      Some(false) => (left, false),\n      None => (left, about),\n    },\n    // `(it is V) == A`: either way round\n    ast.Binary { op: ast.Equal, left: l, right: r } => match (\n      check.result_variants(i, l, owner),\n      check.result_variants(i, r, owner),\n    ) {\n      (Some(vs), None) => match check.decide(i, r, params, args) {\n        Some(true) => (left.intersection(vs), false),\n        Some(false) => (left.difference(vs), false),\n        None => (left, true),\n      },\n      (None, Some(vs)) => match check.decide(i, l, params, args) {\n        Some(true) => (left.intersection(vs), false),\n        Some(false) => (left.difference(vs), false),\n        None => (left, true),\n      },\n      _ => (left, about),\n    },\n    _ => match check.result_variants(i, c, owner) {\n      Some(vs) => (left.intersection(vs), false),\n      None => (left, about),\n    },\n  }\n}"},{"name":"check.decide","kind":"fn","old":"c2288adc0b9b6ad0","new":"1623cbe62cad8797","interface_changed":true,"affected":["check.narrow_by","check.narrowed_at","check.infer_call","check.infer_method","check.narrowed_result","check.infer_untagged","check.infer","check.infer_spread","check.infer_all","check.binary","check.infer_block","check.infer_if","check.infer_list","check.infer_match","check.infer_ctor","check.infer_lambda","check.builtin_call","check.static_call","check.fn_inferred","check.task_body","check.default_errors","check.element_assigned","check.spread_method_params","check.spread_filled","check.iter_builtin","check.fn_errors","check.instantiated","check.fn_lambdas_typed","check.holes_of","check.mark_field_reads","check.own_methods_resolved","check.typed_one","check.decl_type_errors","check.spread_body","check.field_reads","eval_files","instantiated_files","check.lambdas_typed","holes_command","check_summary","finding.uses_of","rename_command","verified_decls","check.typed","check.type_errors_with","check.spreads_resolved","unused.members","command_line","check_command","finding.uses_from","finding.used_by_tree","finding.refs_command","verified_with","static_graph","codegen.new_gen","computed_value","repl_eval","check.type_errors","check_errors_in","literal_errors","expanded","unused.findings","main","strata_command","finding.uses_tree","verified_program","verify_file","build_command","graph_command","graph_diff","tour_graph","codegen.generate","codegen.read_back","comptime_value","repl_command","check_errors_with","edit_errors","literal_errors_of","codegen_with","with_base","unused_of","edit_unused","core_unused","codegen.entry","codegen.compiled_alone","eval.run","smt_file","termination_file","verify_command","build_proofs","alongside_command","search_invariants","diff_command","tour_command","core_rt_text","comptime_values","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","codegen_text","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","run_command","fix_loops","build_core_command","comptime_runner","package_errors","merge_file_command","merged_checks","call_command","edit_command","check_files","move_command","fix_command","edit_in_editor","codegen_file","jit_file","fuzz_file","graph_runs","replay","or_solver_inputs","program_objects","sync_command","check_fn","linked"],"module":"check","text":"/// Whether condition `a` on a call's arguments holds, when their types\n/// decide it: `p is V` where the argument for `p` is narrowed to variants\n/// all inside `V` (true) or all outside it (false); `!`, `&&`, `||` of such;\n/// `true`, `false`. `None`: the types don't say.\nfn decide(\n  i: check.Inf,\n  a: ast.Expr,\n  params: List[String],\n  args: List[check.Ty],\n) -> Option[Bool]\n  ensures a is ast.BoolLit ==> it is Some {\n  match a {\n    ast.BoolLit(b) => Some(b),\n    ast.Unary { op: ast.Not, operand } => match check.decide(i, operand, params, args) {\n      Some(b) => Some(!b),\n      None => None,\n    },\n    ast.Binary { op: ast.And, left, right } => match (\n      check.decide(i, left, params, args),\n      check.decide(i, right, params, args),\n    ) {\n      (Some(false), _) => Some(false),\n      (_, Some(false)) => Some(false),\n      (Some(true), Some(true)) => Some(true),\n      _ => None,\n    },\n    ast.Binary { op: ast.Or, left, right } => match (\n      check.decide(i, left, params, args),\n      check.decide(i, right, params, args),\n    ) {\n      (Some(true), _) => Some(true),\n      (_, Some(true)) => Some(true),\n      (Some(false), Some(false)) => Some(false),\n      _ => None,\n    },\n    ast.IsExpr { value: ast.Var(p), variant } => {\n      mut k := -1\n      for (j, x) in enumerate(params) {\n        if x == p {\n          k = j\n        }\n      }\n      if k < 0 {\n        return None\n      }\n      (o, vs) := match check.variants_named(i, variant) {\n        Some(x) => x,\n        None => return None,\n      }\n      (ao, _, has) := match check.sum_variants(i, get(args, k) ?? check.TAny) {\n        Some(x) => x,\n        None => return None,\n      }\n      if ao != o || len(has) == 0 {\n        None\n      } else if has.difference(vs).len() == 0 {\n        Some(true)\n      } else if has.intersection(vs).len() == 0 {\n        Some(false)\n      } else {\n        None\n      }\n    },\n    _ => None,\n  }\n}","old_text":"/// Whether condition `a` on a call's arguments holds, when their types\n/// decide it: `p is V` where the argument for `p` is narrowed to variants\n/// all inside `V` (true) or all outside it (false); `!`, `&&`, `||` of such;\n/// `true`, `false`. `None`: the types don't say.\nfn decide(\n  i: check.Inf,\n  a: ast.Expr,\n  params: List[String],\n  args: List[check.Ty],\n) -> Option[Bool] {\n  match a {\n    ast.BoolLit(b) => Some(b),\n    ast.Unary { op: ast.Not, operand } => match check.decide(i, operand, params, args) {\n      Some(b) => Some(!b),\n      None => None,\n    },\n    ast.Binary { op: ast.And, left, right } => match (\n      check.decide(i, left, params, args),\n      check.decide(i, right, params, args),\n    ) {\n      (Some(false), _) => Some(false),\n      (_, Some(false)) => Some(false),\n      (Some(true), Some(true)) => Some(true),\n      _ => None,\n    },\n    ast.Binary { op: ast.Or, left, right } => match (\n      check.decide(i, left, params, args),\n      check.decide(i, right, params, args),\n    ) {\n      (Some(true), _) => Some(true),\n      (_, Some(true)) => Some(true),\n      (Some(false), Some(false)) => Some(false),\n      _ => None,\n    },\n    ast.IsExpr { value: ast.Var(p), variant } => {\n      mut k := -1\n      for (j, x) in enumerate(params) {\n        if x == p {\n          k = j\n        }\n      }\n      if k < 0 {\n        return None\n      }\n      (o, vs) := match check.variants_named(i, variant) {\n        Some(x) => x,\n        None => return None,\n      }\n      (ao, _, has) := match check.sum_variants(i, get(args, k) ?? check.TAny) {\n        Some(x) => x,\n        None => return None,\n      }\n      if ao != o || len(has) == 0 {\n        None\n      } else if has.difference(vs).len() == 0 {\n        Some(true)\n      } else if has.intersection(vs).len() == 0 {\n        Some(false)\n      } else {\n        None\n      }\n    },\n    _ => None,\n  }\n}"},{"name":"check.pattern_variants","kind":"fn","old":"681603f175c1a3c0","new":"6167711010df7c15","interface_changed":true,"affected":["check.variants_covered","check.infer_match","check.infer_untagged","check.infer","check.infer_spread","check.infer_all","check.binary","check.infer_block","check.infer_call","check.infer_if","check.infer_list","check.infer_ctor","check.infer_lambda","check.infer_method","check.builtin_call","check.static_call","check.fn_inferred","check.task_body","check.default_errors","check.element_assigned","check.spread_method_params","check.spread_filled","check.iter_builtin","check.fn_errors","check.instantiated","check.fn_lambdas_typed","check.holes_of","check.mark_field_reads","check.own_methods_resolved","check.typed_one","check.decl_type_errors","check.spread_body","check.field_reads","eval_files","instantiated_files","check.lambdas_typed","holes_command","check_summary","finding.uses_of","rename_command","verified_decls","check.typed","check.type_errors_with","check.spreads_resolved","unused.members","command_line","check_command","finding.uses_from","finding.used_by_tree","finding.refs_command","verified_with","static_graph","codegen.new_gen","computed_value","repl_eval","check.type_errors","check_errors_in","literal_errors","expanded","unused.findings","main","strata_command","finding.uses_tree","verified_program","verify_file","build_command","graph_command","graph_diff","tour_graph","codegen.generate","codegen.read_back","comptime_value","repl_command","check_errors_with","edit_errors","literal_errors_of","codegen_with","with_base","unused_of","edit_unused","core_unused","codegen.entry","codegen.compiled_alone","eval.run","smt_file","termination_file","verify_command","build_proofs","alongside_command","search_invariants","diff_command","tour_command","core_rt_text","comptime_values","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","codegen_text","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","run_command","fix_loops","build_core_command","comptime_runner","package_errors","merge_file_command","merged_checks","call_command","edit_command","check_files","move_command","fix_command","edit_in_editor","codegen_file","jit_file","fuzz_file","graph_runs","replay","or_solver_inputs","program_objects","sync_command","check_fn","linked"],"module":"check","text":"/// The variants of sum `owner` that pattern `p` matches whole (`Shipped`,\n/// `Paid { .. }`, `Some(x)`, `_`, `x`, `A | B`), or `None` when it matches\n/// some values of one only (a nested pattern, a condition).\nfn pattern_variants(\n  p: ast.Pattern,\n  owner: String,\n  all: List[String],\n) -> Option[Set[String]] {\n  match p {\n    ast.Wild => Some(set(all)),\n    ast.Bind(_) => Some(set(all)),\n    ast.CtorPattern { name, args } => {\n      whole := match args {\n        ast.NoPats => true,\n        ast.PositionalPats(ps) => ps.all(q -> q is ast.Wild || q is ast.Bind),\n        ast.RecordPats { fields, .. } => fields.all(fp -> fp.1 is ast.Wild || fp.1 is ast.Bind),\n        ast.TypePats(_) => false,\n      }\n      if !whole {\n        None\n      } else if name == owner {\n        Some(set(all))\n      } else if all.contains(name) {\n        Some(set([name]))\n      } else {\n        None\n      }\n    },\n    ast.OrPat(ps) => {\n      mut out := Set[String] {}\n      for q in ps {\n        match check.pattern_variants(q, owner, all) {\n          Some(vs) => {\n            out = out.union(vs)\n          },\n          None => return None,\n        }\n      }\n      Some(out)\n    },\n    _ => None,\n  }\n}","old_text":"/// The variants of sum `owner` that pattern `p` matches whole (`Shipped`,\n/// `Paid { .. }`, `Some(x)`, `_`, `x`, `A | B`), or `None` when it matches\n/// some values of one only (a nested pattern, a condition).\nfn pattern_variants(\n  p: ast.Pattern,\n  owner: String,\n  all: List[String],\n) -> Option[Set[String]]\n  ensures match it {\n    Some(vs) => vs.difference(set(all)).len() == 0,\n    None => true,\n  } {\n  match p {\n    ast.Wild => Some(set(all)),\n    ast.Bind(_) => Some(set(all)),\n    ast.CtorPattern { name, args } => {\n      whole := match args {\n        ast.NoPats => true,\n        ast.PositionalPats(ps) => ps.all(q -> q is ast.Wild || q is ast.Bind),\n        ast.RecordPats { fields, .. } => fields.all(fp -> fp.1 is ast.Wild || fp.1 is ast.Bind),\n        ast.TypePats(_) => false,\n      }\n      if !whole {\n        None\n      } else if name == owner {\n        Some(set(all))\n      } else if all.contains(name) {\n        Some(set([name]))\n      } else {\n        None\n      }\n    },\n    ast.OrPat(ps) => {\n      mut out := Set[String] {}\n      for q in ps {\n        match check.pattern_variants(q, owner, all) {\n          Some(vs) => {\n            out = out.union(vs)\n          },\n          None => return None,\n        }\n      }\n      Some(out)\n    },\n    _ => None,\n  }\n}"}]}
{"id":"78e28eed738623b7","time":1795722509,"message":"edit","changes":[{"name":"check.narrowed_result","kind":"fn","old":"23447e08a59d639e","new":"9f45e965c77076f7","interface_changed":true,"affected":["check.infer_call","check.infer_method","check.infer_untagged","check.infer","check.infer_spread","check.infer_all","check.binary","check.infer_block","check.infer_if","check.infer_list","check.infer_match","check.infer_ctor","check.infer_lambda","check.builtin_call","check.static_call","check.fn_inferred","check.task_body","check.default_errors","check.element_assigned","check.spread_method_params","check.spread_filled","check.iter_builtin","check.fn_errors","check.instantiated","check.fn_lambdas_typed","check.holes_of","check.mark_field_reads","check.own_methods_resolved","check.typed_one","check.decl_type_errors","check.spread_body","check.field_reads","eval_files","instantiated_files","check.lambdas_typed","holes_command","check_summary","finding.uses_of","rename_command","verified_decls","check.typed","check.type_errors_with","check.spreads_resolved","unused.members","command_line","check_command","finding.uses_from","finding.used_by_tree","finding.refs_command","verified_with","static_graph","codegen.new_gen","computed_value","repl_eval","check.type_errors","check_errors_in","literal_errors","expanded","unused.findings","main","strata_command","finding.uses_tree","verified_program","verify_file","build_command","graph_command","graph_diff","tour_graph","codegen.generate","codegen.read_back","comptime_value","repl_command","check_errors_with","edit_errors","literal_errors_of","codegen_with","with_base","unused_of","edit_unused","core_unused","codegen.entry","codegen.compiled_alone","eval.run","smt_file","termination_file","verify_command","build_proofs","alongside_command","search_invariants","diff_command","tour_command","core_rt_text","comptime_values","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","codegen_text","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","run_command","fix_loops","build_core_command","comptime_runner","package_errors","merge_file_command","merged_checks","call_command","edit_command","check_files","move_command","fix_command","edit_in_editor","codegen_file","jit_file","fuzz_file","graph_runs","replay","or_solver_inputs","program_objects","sync_command","check_fn","linked"],"module":"check","text":"/// A call's result type, narrowed to the variants `narrowed_at` leaves,\n/// with the sum's type arguments. `ret` itself when nothing is left out\n/// (or the facts contradict).\nfn narrowed_result(\n  i: check.Inf,\n  f: String,\n  args: List[check.Ty],\n  ret: check.Ty,\n) -> check.Ty\n  ensures it == ret || it is check.TVariants {\n  match (check.res(i, ret), check.narrowed_at(i, f, args, ret)) {\n    (check.TNamed { args: targs, .. }, Some((owner, all, left, _))) => {\n      names := to_list(left).sorted()\n      if len(names) == 0 || len(left) == len(all) {\n        ret\n      } else {\n        check.TVariants { owner, names, args: targs }\n      }\n    },\n    _ => ret,\n  }\n}","old_text":"/// A call's result type, narrowed to the variants `narrowed_at` leaves,\n/// with the sum's type arguments. `ret` itself when nothing is left out\n/// (or the facts contradict).\nfn narrowed_result(\n  i: check.Inf,\n  f: String,\n  args: List[check.Ty],\n  ret: check.Ty,\n) -> check.Ty\n  ensures it == ret\n    || match it {\n      check.TVariants { names, .. } => len(names) > 0,\n      _ => false,\n    } {\n  match (check.res(i, ret), check.narrowed_at(i, f, args, ret)) {\n    (check.TNamed { args: targs, .. }, Some((owner, all, left, _))) => {\n      names := to_list(left).sorted()\n      if len(names) == 0 || len(left) == len(all) {\n        ret\n      } else {\n        check.TVariants { owner, names, args: targs }\n      }\n    },\n    _ => ret,\n  }\n}"}]}
{"id":"918b2045b8f767d8","time":1795722912,"message":"edit","changes":[{"name":"check.unify","kind":"fn","old":"619a5c9a8a3be96d","new":"7b2d9c955e1d2962","interface_changed":false,"affected":[],"module":"check","text":"/// Makes `a` and `b` the same type, binding type variables. False if they\n/// can't be.\nfn unify(mut i: check.Inf, a: check.Ty, b: check.Ty, fuel: Int) -> Bool {\n  if fuel <= 0 {\n    return true\n  }\n  // a narrowed value is of its sum's type\n  ra := check.widened(check.res(i, a))\n  rb := check.widened(check.res(i, b))\n  if ra is check.TAny || rb is check.TAny {\n    return true\n  }\n  match ra {\n    check.TVar(x) => {\n      if rb != ra {\n        mut i.subst.insert(x, check.widened(rb))\n      }\n      return true\n    },\n    _ => (),\n  }\n  match rb {\n    check.TVar(y) => {\n      mut i.subst.insert(y, check.widened(ra))\n      return true\n    },\n    _ => (),\n  }\n  match ra {\n    check.TList(x) => match rb {\n      check.TList(y) => check.unify(mut i, x, y, fuel - 1),\n      _ => false,\n    },\n    check.TFn { params: ps, ret: r } => match rb {\n      check.TFn { params: qs, ret: s } => {\n        if len(ps) != len(qs) {\n          return false\n        }\n        mut ok := true\n        for (k, p) in enumerate(ps) {\n          if !check.unify(mut i, p, get(qs, k) ?? check.TAny, fuel - 1) {\n            ok = false\n          }\n        }\n        ok && check.unify(mut i, r, s, fuel - 1)\n      },\n      _ => false,\n    },\n    check.TNamed { name: n, args: xs } => match rb {\n      check.TNamed { name: m, args: ys } => {\n        if n != m || len(xs) != len(ys) {\n          return false\n        }\n        mut ok := true\n        for (k, x) in enumerate(xs) {\n          if !check.unify(mut i, x, get(ys, k) ?? check.TAny, fuel - 1) {\n            ok = false\n          }\n        }\n        ok\n      },\n      _ => false,\n    },\n    _ => ra == rb,\n  }\n}","old_text":"/// Makes `a` and `b` the same type, binding type variables. False if they\n/// can't be.\nfn unify(mut i: check.Inf, a: check.Ty, b: check.Ty, fuel: Int) -> Bool {\n  if fuel <= 0 {\n    return true\n  }\n  ra := check.res(i, a)\n  rb := check.res(i, b)\n  if ra is check.TAny || rb is check.TAny {\n    return true\n  }\n  match ra {\n    check.TVar(x) => {\n      if rb != ra {\n        mut i.subst.insert(x, check.widened(rb))\n      }\n      return true\n    },\n    _ => (),\n  }\n  match rb {\n    check.TVar(y) => {\n      mut i.subst.insert(y, check.widened(ra))\n      return true\n    },\n    _ => (),\n  }\n  match ra {\n    check.TList(x) => match rb {\n      check.TList(y) => check.unify(mut i, x, y, fuel - 1),\n      _ => false,\n    },\n    check.TFn { params: ps, ret: r } => match rb {\n      check.TFn { params: qs, ret: s } => {\n        if len(ps) != len(qs) {\n          return false\n        }\n        mut ok := true\n        for (k, p) in enumerate(ps) {\n          if !check.unify(mut i, p, get(qs, k) ?? check.TAny, fuel - 1) {\n            ok = false\n          }\n        }\n        ok && check.unify(mut i, r, s, fuel - 1)\n      },\n      _ => false,\n    },\n    check.TNamed { name: n, args: xs } => match rb {\n      check.TNamed { name: m, args: ys } => {\n        if n != m || len(xs) != len(ys) {\n          return false\n        }\n        mut ok := true\n        for (k, x) in enumerate(xs) {\n          if !check.unify(mut i, x, get(ys, k) ?? check.TAny, fuel - 1) {\n            ok = false\n          }\n        }\n        ok\n      },\n      _ => false,\n    },\n    _ => ra == rb,\n  }\n}"},{"name":"check.dropped_results","kind":"fn","old":"e5f072c8b53088d4","new":"4073f38c4bbcd4c1","interface_changed":false,"affected":[],"module":"check","text":"/// A warning for each `Result` thrown away with `_ := e`. It is allowed,\n/// since the program may not care, but an error it holds is lost, so each\n/// one is reported. Marked `$warning ` among a function's errors\n/// (`labelled`). None while the body has errors of its own.\nfn dropped_results(i: check.Inf) -> List[String] {\n  if i.errs != [] {\n    return []\n  }\n  mut out: List[String] = []\n  for d in i.dropped {\n    (x, t) := d\n    match check.widened(check.res(i, t)) {\n      check.TNamed { name: \"Result\", .. } => mut out.push(\n        f\"$warning `_ := {check.short_code(x)}` throws away a `Result`: an error from it is ignored\",\n      ),\n      _ => (),\n    }\n  }\n  out\n}","old_text":"/// A warning for each `Result` thrown away with `_ := e`. It is allowed,\n/// since the program may not care, but an error it holds is lost, so each\n/// one is reported. Marked `$warning ` among a function's errors\n/// (`labelled`). None while the body has errors of its own.\nfn dropped_results(i: check.Inf) -> List[String] {\n  if i.errs != [] {\n    return []\n  }\n  mut out: List[String] = []\n  for d in i.dropped {\n    (x, t) := d\n    match check.res(i, t) {\n      check.TNamed { name: \"Result\", .. } => mut out.push(\n        f\"$warning `_ := {check.short_code(x)}` throws away a `Result`: an error from it is ignored\",\n      ),\n      _ => (),\n    }\n  }\n  out\n}"}]}
{"id":"6a324292586067f0","time":1795723667,"message":"edit","changes":[{"name":"smt.infer_invariants","kind":"fn","old":"0269def284303440","new":"247b43cfc89cc57a","interface_changed":false,"affected":[],"module":"smt","text":"/// Facts every pass of `while c { body }` keeps, from the candidates\n/// `tried` (Houdini): those that can be false on entry are dropped, then,\n/// from any\n/// state where the others and the condition hold, one pass runs and those\n/// that can be false after it are dropped, until a pass drops nothing.\n/// The facts `given` (derived from the code, `derived_facts`) hold at the\n/// head: they are assumed in each pass, and not searched for again. With\n/// `Methods.search` 1, only the candidates naming the variables the\n/// function's failing checks name (`Methods.relevant`) are tried.\nfn infer_invariants(\n  mut vc: smt.Vc,\n  c: ast.Expr,\n  body: ast.Expr,\n  entry: List[(String, String, smt.Val)],\n  written: List[ast.Expr],\n  given: List[smt.Candidate],\n  tried: List[smt.Candidate],\n) -> List[smt.Candidate] {\n  // inner loops of a trial infer nothing\n  if vc.trial > 0 || vc.spec > 0 || vc.dead {\n    return []\n  }\n  known := given.map(k -> smt.candidate_key(k))\n  cands := tried.filter(\n    k ->\n      !contains(known, smt.candidate_key(k))\n        && smt.relevant(vc, c, k),\n  )\n  if len(cands) == 0 {\n    return []\n  }\n  // on entry\n  mut at_entry := []\n  for k in cands {\n    mut at_entry.push(smt.candidate_value(mut vc, k, entry))\n  }\n  mut alive := at_entry.map(t -> t != None)\n  pc0 := vc.pc\n  _ := smt.drop_falsifiable(mut vc, pc0, at_entry, mut alive)\n  // after a pass, from the head\n  for _ in 0..len(cands) + 1 {\n    if !alive.any(a -> a) {\n      break\n    }\n    scopes := vc.scopes\n    n_pc := len(vc.pc)\n    dead := vc.dead\n    n_ob := len(vc.obligations)\n    n_loops := len(vc.loops)\n    n_rec := len(vc.rec_sites)\n    n_term := len(vc.term_obs)\n    returns := vc.returns\n    vc.returns = []\n    vc.trial += 1\n    vc.spec += 1\n    smt.havoc_loop(mut vc, body, Some(c))\n    // the written invariants are proven on their own with these, so\n    // together they hold\n    for x in written {\n      v := smt.eval(mut vc, x)\n      b := smt.as_bool(mut vc, v)\n      mut vc.pc.push(b)\n    }\n    for g in given {\n      match smt.candidate_value(mut vc, g, entry) {\n        Some(t) => mut vc.pc.push(t),\n        None => (),\n      }\n    }\n    for (k, cand) in enumerate(cands) {\n      if get(alive, k) ?? false {\n        match smt.candidate_value(mut vc, cand, entry) {\n          Some(t) => mut vc.pc.push(t),\n          None => (),\n        }\n      }\n    }\n    cv := smt.eval(mut vc, c)\n    cb := smt.as_bool(mut vc, cv)\n    mut vc.pc.push(cb)\n    base := len(vc.pc)\n    depth := len(vc.scopes)\n    mut vc.breaks.push([])\n    mut vc.continues.push([])\n    wiped0 := vc.wiped\n    vc.wiped = []\n    _ := smt.eval(mut vc, body)\n    vc.breaks = take(vc.breaks, len(vc.breaks) - 1)\n    // kept where every pass ends\n    ends := smt.pass_ends(mut vc, depth)\n    // a candidate naming a variable that ends a pass as a callee's\n    // write-back (any value of its type) is dropped without asking\n    if vc.wiped != [] {\n      for e in ends {\n        for (k, cand) in enumerate(cands) {\n          if get(alive, k) ?? false\n            && smt.candidate_roots(cand).any(\n              x -> match smt.scope_value(e.scopes, x) {\n                Some(v) => contains(vc.wiped, v),\n                None => false,\n              },\n            ) {\n            alive = take(alive, k) + [false] + drop(alive, k + 1)\n          }\n        }\n      }\n    }\n    vc.wiped = wiped0\n    pc_after := take(vc.pc, base)\n    mut after := cands.map(_ -> Some(\"true\"))\n    for e in ends {\n      vc.pc = e.pc\n      vc.scopes = e.scopes\n      for (k, cand) in enumerate(cands) {\n        v := if get(alive, k) ?? false {\n          smt.candidate_value(mut vc, cand, entry)\n        } else {\n          None\n        }\n        after = take(after, k)\n          + [match (get(after, k) ?? None, v) {\n            (Some(acc), Some(x)) => Some(smt.and_all(\n              [acc, smt.implies(smt.and_all(drop(e.pc, base)), x)],\n            )),\n            _ => None,\n          }]\n          + drop(after, k + 1)\n      }\n    }\n    vc.pc = pc_after\n    vc.spec -= 1\n    vc.trial -= 1\n    vc.returns = returns\n    vc.scopes = scopes\n    vc.pc = take(vc.pc, n_pc)\n    vc.dead = dead\n    vc.obligations = take(vc.obligations, n_ob)\n    vc.loops = take(vc.loops, n_loops)\n    vc.rec_sites = take(vc.rec_sites, n_rec)\n    vc.term_obs = take(vc.term_obs, n_term)\n    if !smt.drop_falsifiable(mut vc, pc_after, after, mut alive) {\n      break\n    }\n  }\n  mut out := []\n  for (k, cand) in enumerate(cands) {\n    if get(alive, k) ?? false {\n      mut out.push(cand)\n    }\n  }\n  out\n}","old_text":"/// Facts every pass of `while c { body }` keeps, from the candidates\n/// `tried` (Houdini): those that can be false on entry are dropped, then,\n/// from any\n/// state where the others and the condition hold, one pass runs and those\n/// that can be false after it are dropped, until a pass drops nothing.\n/// The facts `given` (derived from the code, `derived_facts`) hold at the\n/// head: they are assumed in each pass, and not searched for again. With\n/// `Methods.search` 1, only the candidates naming the variables the\n/// function's failing checks name (`Methods.relevant`) are tried.\nfn infer_invariants(\n  mut vc: smt.Vc,\n  c: ast.Expr,\n  body: ast.Expr,\n  entry: List[(String, String, smt.Val)],\n  written: List[ast.Expr],\n  given: List[smt.Candidate],\n  tried: List[smt.Candidate],\n) -> List[smt.Candidate] {\n  // inner loops of a trial infer nothing\n  if vc.trial > 0 || vc.spec > 0 || vc.dead {\n    return []\n  }\n  known := given.map(k -> smt.candidate_key(k))\n  cands := tried.filter(\n    k ->\n      !contains(known, smt.candidate_key(k))\n        && smt.relevant(vc, c, k),\n  )\n  if len(cands) == 0 {\n    return []\n  }\n  // on entry\n  mut at_entry := []\n  for k in cands {\n    mut at_entry.push(smt.candidate_value(mut vc, k, entry))\n  }\n  mut alive := at_entry.map(t -> t != None)\n  pc0 := vc.pc\n  _ := smt.drop_falsifiable(mut vc, pc0, at_entry, mut alive)\n  // after a pass, from the head\n  for _ in 0..len(cands) + 1 {\n    if !alive.any(a -> a) {\n      break\n    }\n    scopes := vc.scopes\n    n_pc := len(vc.pc)\n    dead := vc.dead\n    n_ob := len(vc.obligations)\n    n_loops := len(vc.loops)\n    n_rec := len(vc.rec_sites)\n    n_term := len(vc.term_obs)\n    returns := vc.returns\n    vc.returns = []\n    vc.trial += 1\n    vc.spec += 1\n    smt.havoc_loop(mut vc, body, Some(c))\n    // the written invariants are proven on their own with these, so\n    // together they hold\n    for x in written {\n      v := smt.eval(mut vc, x)\n      b := smt.as_bool(mut vc, v)\n      mut vc.pc.push(b)\n    }\n    for g in given {\n      match smt.candidate_value(mut vc, g, entry) {\n        Some(t) => mut vc.pc.push(t),\n        None => (),\n      }\n    }\n    for (k, cand) in enumerate(cands) {\n      if get(alive, k) ?? false {\n        match smt.candidate_value(mut vc, cand, entry) {\n          Some(t) => mut vc.pc.push(t),\n          None => (),\n        }\n      }\n    }\n    cv := smt.eval(mut vc, c)\n    cb := smt.as_bool(mut vc, cv)\n    mut vc.pc.push(cb)\n    base := len(vc.pc)\n    depth := len(vc.scopes)\n    mut vc.breaks.push([])\n    mut vc.continues.push([])\n    wiped0 := vc.wiped\n    vc.wiped = []\n    _ := smt.eval(mut vc, body)\n    vc.breaks = take(vc.breaks, len(vc.breaks) - 1)\n    // kept where every pass ends\n    ends := smt.pass_ends(mut vc, depth)\n    // a candidate naming a variable that ends a pass as a callee's\n    // write-back (any value of its type) is dropped without asking\n    if vc.wiped != [] {\n      for e in ends {\n        for (k, cand) in enumerate(cands) {\n          if get(alive, k) ?? false\n            && smt.candidate_roots(cand).any(\n              x -> match smt.scope_value(e.scopes, x) {\n                Some(v) => contains(vc.wiped, v),\n                None => false,\n              },\n            ) {\n            alive = take(alive, k) + [false] + drop(alive, k + 1)\n          }\n        }\n      }\n    }\n    vc.wiped = wiped0\n    pc_after := take(vc.pc, base)\n    mut after := cands.map(_ -> Some(\"true\"))\n    for e in ends {\n      vc.pc = e.pc\n      vc.scopes = e.scopes\n      for (k, cand) in enumerate(cands) {\n        v := if get(alive, k) ?? false {\n          smt.candidate_value(mut vc, cand, entry)\n        } else {\n          None\n        }\n        after = take(after, k)\n          + [match (get(after, k) ?? None, v) {\n            (Some(acc), Some(x)) => Some(smt.and_all(\n              [acc, smt.implies(smt.and_all(drop(e.pc, base)), x)],\n            )),\n            _ => None,\n          }]\n          + drop(after, k + 1)\n      }\n    }\n    vc.pc = pc_after\n    vc.spec -= 1\n    vc.trial -= 1\n    vc.returns = returns\n    vc.scopes = scopes\n    vc.pc = take(vc.pc, n_pc)\n    vc.dead = dead\n    vc.obligations = take(vc.obligations, n_ob)\n    vc.loops = take(vc.loops, n_loops)\n    vc.rec_sites = take(vc.rec_sites, n_rec)\n    vc.term_obs = take(vc.term_obs, n_term)\n    if !smt.drop_falsifiable(mut vc, pc_after, after, mut alive) {\n      break\n    }\n  }\n  mut out := []\n  for (k, cand) in enumerate(cands) {\n    if get(alive, k) ?? false {\n      mut out.push(cand)\n    }\n  }\n  out\n}"}]}
