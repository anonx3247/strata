","codegen.iterate","codegen.decreases_start","codegen.decreases_entry","codegen.scope_expr","codegen.leave_branch","codegen.fault","codegen.ret_owned","codegen.leave_with","codegen.call_closure","codegen.cancel_point","codegen.dyn_entry_at","codegen.table_from","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.mock_table","codegen.built_or_generated","codegen.number_builtin","codegen.generated","codegen.can_generate","codegen.call_at","codegen.from_c","codegen.call","codegen.after_builtin","codegen.dyn_entry","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.mock_value","codegen.generated_args","codegen.makers","codegen.int_lit","codegen.concat","codegen.finite","codegen.slice_raw","codegen.word_to_int","codegen.mem_builtin","codegen.set_copy","codegen.raw_call","codegen.dyn_equal","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.conversion","codegen.list_slice","codegen.as_type","codegen.word_op","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// The value of type `t` in the 64-bit slot at `at`, as `from_slot` reads\n/// it. A pointer, an `Int` or a `Float` is loaded as is.\nfn load_slot(mut g: codegen.Gen, at: String, t: check.Ty) -> codegen.V {\n  if codegen.sized(t) is None {\n    match t {\n      check.TInt => {\n        r := codegen.fresh(mut g, \"fld\")\n        codegen.emit(mut g, f\"{r} = load i64, ptr {at}\")\n        return codegen.V { ty: t, op: r }\n      },\n      check.TFloat => {\n        r := codegen.fresh(mut g, \"f\")\n        codegen.emit(mut g, f\"{r} = load double, ptr {at}\")\n        return codegen.V { ty: t, op: r }\n      },\n      check.TStr | check.TNamed { .. } | check.TList(_) | check.TFn { .. } | check.TTrait(_) | check.TUnion(_) => {\n        r := codegen.fresh(mut g, \"p\")\n        codegen.emit(mut g, f\"{r} = load ptr, ptr {at}\")\n        return codegen.V { ty: t, op: r }\n      },\n      check.TUnit => return codegen.unit(),\n      _ => (),\n    }\n  }\n  s := codegen.fresh(mut g, \"fld\")\n  codegen.emit(mut g, f\"{s} = load i64, ptr {at}\")\n  codegen.from_slot(mut g, s, t)\n}","old_text":"/// The value of type `t` in the 64-bit slot at `at`, as `from_slot` reads\n/// it. A pointer, an `Int` or a `Float` is loaded as is.\nfn load_slot(mut g: codegen.Gen, at: String, t: Ty) -> codegen.V {\n  if codegen.sized(t) is None {\n    match t {\n      TInt => {\n        r := codegen.fresh(mut g, \"fld\")\n        codegen.emit(mut g, f\"{r} = load i64, ptr {at}\")\n        return codegen.V { ty: t, op: r }\n      },\n      TFloat => {\n        r := codegen.fresh(mut g, \"f\")\n        codegen.emit(mut g, f\"{r} = load double, ptr {at}\")\n        return codegen.V { ty: t, op: r }\n      },\n      TStr | TNamed { .. } | TList(_) | TFn { .. } | TTrait(_) | TUnion(_) => {\n        r := codegen.fresh(mut g, \"p\")\n        codegen.emit(mut g, f\"{r} = load ptr, ptr {at}\")\n        return codegen.V { ty: t, op: r }\n      },\n      TUnit => return codegen.unit(),\n      _ => (),\n    }\n  }\n  s := codegen.fresh(mut g, \"fld\")\n  codegen.emit(mut g, f\"{s} = load i64, ptr {at}\")\n  codegen.from_slot(mut g, s, t)\n}"},{"name":"codegen.set_in_place","kind":"fn","old":"245e71420cd4369e","new":"aa5612c52582149d","interface_changed":false,"affected":[],"module":"codegen","text":"/// `x = set_at(x, i, v)` (`xs[i] = v`), also nested (`grid[r][c] = v` is\n/// `grid = set_at(grid, r, set_at(grid[r], c, v))`), with `x` a variable or\n/// a field of one (`s.xs[i] = v`).\n/// - The indices are checked.\n/// - When nothing else holds the list (nor its record), the element is\n/// replaced in place in O(1). At each deeper level the inner list is\n/// changed in place too when only its list holds it, else a copy goes in\n/// its slot.\n/// - When something else holds the list, it is copied\n/// (`strata_list_set`), as `set_at` does.\n/// `each` is the refined element type `v` is checked against\n/// (`element_check`).\n/// The result is owned either way. In place, the list is held once more,\n/// given back when the old value is dropped. `None` when `value` is not\n/// such a call.\nfn set_in_place(\n  mut g: codegen.Gen,\n  place: ast.Expr,\n  value: ast.Expr,\n  each: Option[ast.TypeExpr],\n) -> Option[codegen.V] {\n  root := match place {\n    ast.Var(x) => x,\n    ast.FieldOf { base: ast.Var(x), .. } => x,\n    _ => return None,\n  }\n  if codegen.lookup(g, \"set_at\") is Some\n    || codegen.has_fn(g, \"set_at\")\n    || codegen.lookup(g, \"at\") is Some\n    || codegen.has_fn(g, \"at\") {\n    return None\n  }\n  // the indices, outermost first, and the value put in\n  mut indexes := []\n  mut target := place\n  mut v := value\n  mut walking := true\n  while walking {\n    match v {\n      ast.Call { callee: ast.Var(\"set_at\"), args: [t, i, x] } => if t == target {\n        mut indexes.push(i)\n        target = ast.Call { callee: ast.Var(\"at\"), args: [target, i] }\n        v = x\n      } else {\n        walking = false\n      },\n      _ => {\n        walking = false\n      },\n    }\n  }\n  if len(indexes) == 0\n    || ([v] + indexes).any(e -> codegen.may_change(e, root)) {\n    return None\n  }\n  cur := codegen.expr(mut g, place)\n  if cur.ty is check.TAny {\n    return Some(cur)\n  }\n  // the lists on the path (each an element of the one before, borrowed)\n  // and their element types\n  mut ixs := []\n  for e in indexes {\n    iv := codegen.expr(mut g, e)\n    if iv.ty is check.TAny {\n      return Some(codegen.never())\n    }\n    mut ixs.push(iv)\n  }\n  x0 := codegen.expr(mut g, v)\n  if x0.ty is check.TAny {\n    return Some(codegen.never())\n  }\n  mut lists := [cur]\n  mut ets := []\n  for (k, i) in enumerate(ixs) {\n    l := get(lists, k) ?? cur\n    et := match l.ty {\n      check.TList(t) => t,\n      _ => {\n        codegen.not_yet(\n          mut g,\n          \"an element of a `\" + codegen.key(l.ty) + \"` assigned\",\n        )\n        return Some(codegen.never())\n      },\n    }\n    mut ets.push(et)\n    codegen.index_check(mut g, l, i)\n    if k + 1 < len(ixs) {\n      mut lists.push(codegen.list_at(mut g, l, i.op, et))\n    }\n  }\n  x := codegen.converted(mut g, x0, get(ets, len(ets) - 1) ?? check.TAny)\n  match each {\n    Some(t) => codegen.check_type(mut g, t, x, \"assigning `\" + root + \"`\", []),\n    None => (),\n  }\n  // held once: the list, and the record holding it\n  proven := codegen.proven_on(g, place)\n  owned := codegen.held_test(\n    mut g,\n    \"strata_list_owned\",\n    cur.op,\n    proven && place is ast.Var,\n  )\n  ok := match place {\n    ast.FieldOf { base, .. } => {\n      rv := codegen.expr(mut g, base)\n      u := codegen.held_test(mut g, \"strata_unique\", rv.op, proven)\n      both := codegen.fresh(mut g, \"owned\")\n      codegen.emit(mut g, f\"{both} = and i1 {owned}, {u}\")\n      both\n    },\n    _ => owned,\n  }\n  (here, copy, done) := (\n    codegen.label(mut g, \"set.here\"),\n    codegen.label(mut g, \"set.copy\"),\n    codegen.label(mut g, \"set.done\"),\n  )\n  codegen.emit(mut g, f\"br i1 {ok}, label %{here}, label %{copy}\")\n  codegen.block(mut g, here)\n  codegen.push_transparent(mut g)\n  codegen.put_in(mut g, lists, ets, ixs, 0, x)\n  codegen.dup_value(mut g, cur)\n  codegen.pop_scope(mut g)\n  from_here := codegen.current(g)\n  codegen.br(mut g, done)\n  // else a new list, as `set_at` makes it\n  codegen.block(mut g, copy)\n  codegen.push_transparent(mut g)\n  made := codegen.set_copy(mut g, lists, ets, ixs, 0, x)\n  r := codegen.leave_branch(mut g, made)\n  from_copy := codegen.current(g)\n  codegen.br(mut g, done)\n  codegen.block(mut g, done)\n  p := codegen.fresh(mut g, \"updated\")\n  codegen.emit(\n    mut g,\n    f\"{p} = phi ptr [ {cur.op}, %{from_here} ], [ {r.op}, %{from_copy} ]\",\n  )\n  Some(codegen.temp(mut g, codegen.V { ty: cur.ty, op: p }))\n}","old_text":"/// `x = set_at(x, i, v)` (`xs[i] = v`), also nested (`grid[r][c] = v` is\n/// `grid = set_at(grid, r, set_at(grid[r], c, v))`), with `x` a variable or\n/// a field of one (`s.xs[i] = v`).\n/// - The indices are checked.\n/// - When nothing else holds the list (nor its record), the element is\n/// replaced in place in O(1). At each deeper level the inner list is\n/// changed in place too when only its list holds it, else a copy goes in\n/// its slot.\n/// - When something else holds the list, it is copied\n/// (`strata_list_set`), as `set_at` does.\n/// `each` is the refined element type `v` is checked against\n/// (`element_check`).\n/// The result is owned either way. In place, the list is held once more,\n/// given back when the old value is dropped. `None` when `value` is not\n/// such a call.\nfn set_in_place(\n  mut g: codegen.Gen,\n  place: ast.Expr,\n  value: ast.Expr,\n  each: Option[ast.TypeExpr],\n) -> Option[codegen.V] {\n  root := match place {\n    ast.Var(x) => x,\n    ast.FieldOf { base: ast.Var(x), .. } => x,\n    _ => return None,\n  }\n  if codegen.lookup(g, \"set_at\") is Some\n    || codegen.has_fn(g, \"set_at\")\n    || codegen.lookup(g, \"at\") is Some\n    || codegen.has_fn(g, \"at\") {\n    return None\n  }\n  // the indices, outermost first, and the value put in\n  mut indexes := []\n  mut target := place\n  mut v := value\n  mut walking := true\n  while walking {\n    match v {\n      ast.Call { callee: ast.Var(\"set_at\"), args: [t, i, x] } => if t == target {\n        mut indexes.push(i)\n        target = ast.Call { callee: ast.Var(\"at\"), args: [target, i] }\n        v = x\n      } else {\n        walking = false\n      },\n      _ => {\n        walking = false\n      },\n    }\n  }\n  if len(indexes) == 0\n    || ([v] + indexes).any(e -> codegen.may_change(e, root)) {\n    return None\n  }\n  cur := codegen.expr(mut g, place)\n  if cur.ty is TAny {\n    return Some(cur)\n  }\n  // the lists on the path (each an element of the one before, borrowed)\n  // and their element types\n  mut ixs := []\n  for e in indexes {\n    iv := codegen.expr(mut g, e)\n    if iv.ty is TAny {\n      return Some(codegen.never())\n    }\n    mut ixs.push(iv)\n  }\n  x0 := codegen.expr(mut g, v)\n  if x0.ty is TAny {\n    return Some(codegen.never())\n  }\n  mut lists := [cur]\n  mut ets := []\n  for (k, i) in enumerate(ixs) {\n    l := get(lists, k) ?? cur\n    et := match l.ty {\n      TList(t) => t,\n      _ => {\n        codegen.not_yet(\n          mut g,\n          \"an element of a `\" + codegen.key(l.ty) + \"` assigned\",\n        )\n        return Some(codegen.never())\n      },\n    }\n    mut ets.push(et)\n    codegen.index_check(mut g, l, i)\n    if k + 1 < len(ixs) {\n      mut lists.push(codegen.list_at(mut g, l, i.op, et))\n    }\n  }\n  x := codegen.converted(mut g, x0, get(ets, len(ets) - 1) ?? TAny)\n  match each {\n    Some(t) => codegen.check_type(mut g, t, x, \"assigning `\" + root + \"`\", []),\n    None => (),\n  }\n  // held once: the list, and the record holding it\n  proven := codegen.proven_on(g, place)\n  owned := codegen.held_test(\n    mut g,\n    \"strata_list_owned\",\n    cur.op,\n    proven && place is ast.Var,\n  )\n  ok := match place {\n    ast.FieldOf { base, .. } => {\n      rv := codegen.expr(mut g, base)\n      u := codegen.held_test(mut g, \"strata_unique\", rv.op, proven)\n      both := codegen.fresh(mut g, \"owned\")\n      codegen.emit(mut g, f\"{both} = and i1 {owned}, {u}\")\n      both\n    },\n    _ => owned,\n  }\n  (here, copy, done) := (\n    codegen.label(mut g, \"set.here\"),\n    codegen.label(mut g, \"set.copy\"),\n    codegen.label(mut g, \"set.done\"),\n  )\n  codegen.emit(mut g, f\"br i1 {ok}, label %{here}, label %{copy}\")\n  codegen.block(mut g, here)\n  codegen.push_transparent(mut g)\n  codegen.put_in(mut g, lists, ets, ixs, 0, x)\n  codegen.dup_value(mut g, cur)\n  codegen.pop_scope(mut g)\n  from_here := codegen.current(g)\n  codegen.br(mut g, done)\n  // else a new list, as `set_at` makes it\n  codegen.block(mut g, copy)\n  codegen.push_transparent(mut g)\n  made := codegen.set_copy(mut g, lists, ets, ixs, 0, x)\n  r := codegen.leave_branch(mut g, made)\n  from_copy := codegen.current(g)\n  codegen.br(mut g, done)\n  codegen.block(mut g, done)\n  p := codegen.fresh(mut g, \"updated\")\n  codegen.emit(\n    mut g,\n    f\"{p} = phi ptr [ {cur.op}, %{from_here} ], [ {r.op}, %{from_copy} ]\",\n  )\n  Some(codegen.temp(mut g, codegen.V { ty: cur.ty, op: p }))\n}"},{"name":"codegen.put_in","kind":"fn","old":"62ea7a24a09c7ce1","new":"870f8775b7ef2f9e","interface_changed":true,"affected":["codegen.set_in_place","codegen.update_in_place","codegen.stmt_node","codegen.builtin_call","codegen.stmt","codegen.call_named","codegen.method_call","codegen.except_expr","codegen.matching_want","codegen.block_expr","codegen.iterate","codegen.decreases_start","codegen.decreases_pass","codegen.decreases_entry","codegen.decreases_call","codegen.build_fn","codegen.expr_node","codegen.expr_want_node","codegen.matching","codegen.for_list","codegen.function","codegen.call_fn_want","codegen.built_or_generated","codegen.expr","codegen.expr_want","codegen.for_loop","codegen.compiled_alone","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.fuzz_driver","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.if_want","codegen.branch_value","codegen.try_want","codegen.tag_test","codegen.take_in_place","codegen.compared","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.declare","codegen.list_literal_of","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.wanted","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.generate","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.binds","codegen.matching_v","codegen.assertion","codegen.invariants","codegen.tag_is","codegen.check_type","codegen.satisfies","codegen.holds_pred","codegen.entry","codegen.vtable","codegen.mock_table","codegen.mock_call","codegen.list_builtin","codegen.produce","codegen.table_find","codegen.construct","codegen.operands","codegen.if_expr","codegen.try_expr","codegen.get_field","codegen.list_literal","codegen.function_value","codegen.lambda","codegen_with","core_rt_text","computed_value","repl_eval","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","codegen.gen_list","codegen.to_c","codegen.check_payload","codegen.dyn_ctor_is","codegen.has_field_check","codegen.check_field","codegen.assign_at","codegen.gen_data","codegen.check_union","codegen.check_member","codegen.to_dyn","codegen.dyn_table_is","codegen.mock_value","codegen.gen_fn","codegen.session_capability","codegen.spawn_expr","codegen.method_value","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.helper","codegen.debug_body","codegen.foreign_call","codegen.generated","codegen.can_generate","codegen.session_entry","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.equal","codegen.generated_args","codegen.makers","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","codegen.read_back","eval_files"],"module":"codegen","text":"/// In `set_in_place`, with list `k` of `lists` held only by its holder:\n/// puts `x` at `ixs[k]` (dropping the old element), or deeper into the\n/// element there. The element is changed in place when only its list holds\n/// it, else a copy of it goes in its slot.\nfn put_in(\n  mut g: codegen.Gen,\n  lists: List[codegen.V],\n  ets: List[check.Ty],\n  ixs: List[codegen.V],\n  k: Int,\n  x: codegen.V,\n) {\n  l := get(lists, k) ?? codegen.unit()\n  i := get(ixs, k) ?? codegen.unit()\n  et := get(ets, k) ?? check.TAny\n  if k + 1 == len(ixs) {\n    if codegen.counted(x.ty) && !codegen.constant(x.op) {\n      codegen.dup_value(mut g, x)\n    }\n    codegen.swap_in(mut g, l, i, codegen.to_slot(mut g, x), et)\n    return\n  }\n  e := get(lists, k + 1) ?? codegen.unit()\n  codegen.use_rt(mut g, \"strata_list_owned\")\n  owned := codegen.fresh(mut g, \"owned\")\n  codegen.emit(\n    mut g,\n    f\"{owned} = call i1 @strata_list_owned(ptr {e.op})\",\n  )\n  (here, copy, done) := (\n    codegen.label(mut g, \"set.here\"),\n    codegen.label(mut g, \"set.copy\"),\n    codegen.label(mut g, \"set.done\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"br i1 {owned}, label %{here}, label %{copy}\",\n  )\n  codegen.block(mut g, here)\n  codegen.put_in(mut g, lists, ets, ixs, k + 1, x)\n  codegen.br(mut g, done)\n  codegen.block(mut g, copy)\n  codegen.push_transparent(mut g)\n  made := codegen.take_value(\n    mut g,\n    codegen.set_copy(mut g, lists, ets, ixs, k + 1, x),\n  )\n  codegen.swap_in(mut g, l, i, codegen.to_slot(mut g, made), et)\n  codegen.pop_scope(mut g)\n  codegen.br(mut g, done)\n  codegen.block(mut g, done)\n}","old_text":"/// In `set_in_place`, with list `k` of `lists` held only by its holder:\n/// puts `x` at `ixs[k]` (dropping the old element), or deeper into the\n/// element there. The element is changed in place when only its list holds\n/// it, else a copy of it goes in its slot.\nfn put_in(\n  mut g: codegen.Gen,\n  lists: List[codegen.V],\n  ets: List[Ty],\n  ixs: List[codegen.V],\n  k: Int,\n  x: codegen.V,\n) {\n  l := get(lists, k) ?? codegen.unit()\n  i := get(ixs, k) ?? codegen.unit()\n  et := get(ets, k) ?? TAny\n  if k + 1 == len(ixs) {\n    if codegen.counted(x.ty) && !codegen.constant(x.op) {\n      codegen.dup_value(mut g, x)\n    }\n    codegen.swap_in(mut g, l, i, codegen.to_slot(mut g, x), et)\n    return\n  }\n  e := get(lists, k + 1) ?? codegen.unit()\n  codegen.use_rt(mut g, \"strata_list_owned\")\n  owned := codegen.fresh(mut g, \"owned\")\n  codegen.emit(\n    mut g,\n    f\"{owned} = call i1 @strata_list_owned(ptr {e.op})\",\n  )\n  (here, copy, done) := (\n    codegen.label(mut g, \"set.here\"),\n    codegen.label(mut g, \"set.copy\"),\n    codegen.label(mut g, \"set.done\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"br i1 {owned}, label %{here}, label %{copy}\",\n  )\n  codegen.block(mut g, here)\n  codegen.put_in(mut g, lists, ets, ixs, k + 1, x)\n  codegen.br(mut g, done)\n  codegen.block(mut g, copy)\n  codegen.push_transparent(mut g)\n  made := codegen.take_value(\n    mut g,\n    codegen.set_copy(mut g, lists, ets, ixs, k + 1, x),\n  )\n  codegen.swap_in(mut g, l, i, codegen.to_slot(mut g, made), et)\n  codegen.pop_scope(mut g)\n  codegen.br(mut g, done)\n  codegen.block(mut g, done)\n}"},{"name":"codegen.swap_in","kind":"fn","old":"0e4bb54f138069ff","new":"fd9869c3af6c450f","interface_changed":true,"affected":["codegen.put_in","codegen.set_in_place","codegen.update_in_place","codegen.stmt_node","codegen.builtin_call","codegen.stmt","codegen.call_named","codegen.method_call","codegen.except_expr","codegen.matching_want","codegen.block_expr","codegen.iterate","codegen.decreases_start","codegen.decreases_pass","codegen.decreases_entry","codegen.decreases_call","codegen.build_fn","codegen.expr_node","codegen.expr_want_node","codegen.matching","codegen.for_list","codegen.function","codegen.call_fn_want","codegen.built_or_generated","codegen.expr","codegen.expr_want","codegen.for_loop","codegen.compiled_alone","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.fuzz_driver","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.if_want","codegen.branch_value","codegen.try_want","codegen.tag_test","codegen.take_in_place","codegen.compared","c