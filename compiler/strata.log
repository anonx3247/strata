eory","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel","text":"/// `⊢ (a < b) = (a + 1 <= b)`\npub fn less_is_successor_at_most(\n  a: kernel.Integer,\n  b: kernel.Integer,\n) -> kernel.Theorem {\n  kernel.axiom_theorem(\n    \"less_is_successor_at_most\",\n    kernel.equality_term(\n      kernel.less(a, b),\n      kernel.at_most(kernel.plus(a, kernel.numeral(\"1\")), b),\n    ),\n  )\n}","old_text":"/// `⊢ (a < b) = (a + 1 <= b)`\npub fn less_is_successor_at_most(\n  a: kernel.Integer,\n  b: kernel.Integer,\n) -> kernel.Theorem {\n  kernel.axiom_theorem(kernel.equality_term(\n    kernel.less(a, b),\n    kernel.at_most(kernel.plus(a, kernel.numeral(\"1\")), b),\n  ))\n}"},{"name":"kernel.Step","kind":"type","old":null,"new":"c204db01e843d9a7","interface_changed":true,"affected":[],"module":"kernel","text":"/// How a theorem was made: the rule, the theorems it was made from, and\n/// what the rule was given. Data only: what a theorem says is fixed by the\n/// rules, never read back from its step.\npub type Step = {\n  rule: String,\n  premises: List[kernel.Theorem],\n  terms: List[kernel.Term] = [],\n  substitution: List[(kernel.Term, kernel.Term)] = [],\n  types: List[(String, kernel.Type)] = [],\n  specs: List[kernel.DatatypeSpec] = [],\n  indices: List[Int] = [],\n}"},{"name":"kernel.step_of","kind":"fn","old":null,"new":"dd56cd9fb50dcbd2","interface_changed":true,"affected":[],"module":"kernel","text":"pub fn step_of(th: kernel.Theorem) -> kernel.Step {\n  match th.value {\n    kernel.Sealed(p) => p.step,\n  }\n}"},{"name":"kernel.named","kind":"fn","old":null,"new":"953d0e4012a5a5d1","interface_changed":true,"affected":[],"module":"kernel","text":"/// `th` under the name `name` (what it says unchanged).\npub fn named(name: String, th: kernel.Theorem) -> kernel.Theorem {\n  kernel.make_theorem(\n    kernel.assumptions(th),\n    kernel.conclusion(th),\n    kernel.depends_on(th),\n    kernel.Step { rule: \"named:\" + name, premises: [th] },\n  )\n}"}]}
