(\"str_repeat\"),\n      vs,\n      [],\n    ),\n    (\"trim\", 1) => codegen.call(mut g, check.TStr, \"strata_str_trim\", vs),\n    (\"to_upper\", 1) | (\"to_lower\", 1) => {\n      (table, n) := codegen.unicode_table(mut g, if name == \"to_upper\" {\n        \"upper\"\n      } else {\n        \"lower\"\n      })\n      (cased, m) := codegen.unicode_table(mut g, \"cased\")\n      codegen.call(mut g, check.TStr, \"strata_str_case\", [\n        get(vs, 0) ?? codegen.unit(),\n        codegen.V { ty: check.TStr, op: table },\n        codegen.V { ty: check.TInt, op: to_string(n) },\n        codegen.V { ty: check.TStr, op: cased },\n        codegen.V { ty: check.TInt, op: to_string(m) },\n        codegen.V {\n          ty: check.TBool,\n          op: to_string(name == \"to_lower\"),\n        },\n      ])\n    },\n    (\"is_digit\", 1) | (\"is_alpha\", 1) | (\"is_space\", 1) => {\n      (ranges, n) := codegen.unicode_table(mut g, \"alpha\")\n      class := match name {\n        \"is_digit\" => \"0\",\n        \"is_alpha\" => \"1\",\n        _ => \"2\",\n      }\n      codegen.call(mut g, check.TBool, \"strata_str_is\", [\n        get(vs, 0) ?? codegen.unit(),\n        codegen.V { ty: check.TInt, op: class },\n        codegen.V { ty: check.TStr, op: ranges },\n        codegen.V { ty: check.TInt, op: to_string(n) },\n      ])\n    },\n    (\"len\", 1) => codegen.call(mut g, check.TInt, \"strata_str_len\", vs),\n    (\"get\", 2) => {\n      c := codegen.call(mut g, check.TStr, \"strata_str_at\", vs)\n      ok := codegen.fresh(mut g, \"found\")\n      codegen.emit(mut g, f\"{ok} = icmp ne ptr {c.op}, null\")\n      codegen.option_if(mut g, ok, c, codegen.option_of(check.TStr))\n    },\n    (\"at\", 2) => codegen.call(mut g, check.TStr, \"strata_str_at_or_fault\", vs),\n    (\"slice\", 3) => codegen.call(mut g, check.TStr, \"strata_str_slice\", vs),\n    (\"ord\", 1) => codegen.call(mut g, check.TInt, \"strata_str_ord\", vs),\n    (\"byte_len\", 1) => codegen.call(mut g, check.TInt, \"strata_str_byte_len\", vs),\n    (\"byte_at\", 2) => codegen.call(mut g, check.TInt, \"strata_str_byte_at\", vs),\n    (\"byte_slice\", 3) => codegen.call(mut g, check.TStr, \"strata_str_byte_slice\", vs),\n    (\"chr\", 1) => codegen.call(mut g, check.TStr, \"strata_str_chr\", vs),\n    (\"parse_int\", 1) | (\"parse_float\", 1) => {\n      t := if name == \"parse_int\" {\n        check.TInt\n      } else {\n        check.TFloat\n      }\n      slot := codegen.fresh(mut g, \"parsed\")\n      mut g.allocas.push(f\"  {slot} = alloca {codegen.ll(t)}\")\n      zero := if name == \"parse_int\" {\n        \"0\"\n      } else {\n        \"0.0\"\n      }\n      codegen.emit(\n        mut g,\n        f\"store {codegen.ll(t)} {zero}, ptr {slot}\",\n      )\n      ok := codegen.call(mut g, check.TBool, \"strata_\" + name, [\n        get(vs, 0) ?? codegen.unit(),\n        codegen.V { ty: check.TStr, op: slot },\n      ])\n      x := codegen.fresh(mut g, \"x\")\n      codegen.emit(mut g, f\"{x} = load {codegen.ll(t)}, ptr {slot}\")\n      // the parsed number is new: a big one is an object, moved into the option\n      xv := codegen.temp(mut g, codegen.V { ty: t, op: x })\n      codegen.option_if(mut g, ok.op, xv, codegen.option_of(t))\n    },\n    (\"to_string\", 1) => codegen.show(mut g, get(vs, 0) ?? codegen.unit()),\n    (\"debug\", 1) => codegen.shown(mut g, get(vs, 0) ?? codegen.unit()),\n    (\"print\", 1) => codegen.call(mut g, check.TUnit, \"strata_print\", vs),\n    _ => {\n      codegen.not_yet(\n        mut g,\n        \"the built-in `\" + name + \"` on a `String`\",\n      )\n      codegen.never()\n    },\n  }\n}","old_text":"/// String built-ins: runtime.c's, or the prelude's `str_…`.\nfn string_builtin(\n  mut g: codegen.Gen,\n  name: String,\n  vs: List[codegen.V],\n) -> codegen.V {\n  match (name, len(vs)) {\n    (\"split\", 2) => codegen.call_fn(\n      mut g,\n      codegen.prelude_name(\"str_split\"),\n      vs,\n      [],\n    ),\n    (\"contains\", 2) => codegen.call_fn(\n      mut g,\n      codegen.prelude_name(\"str_contains\"),\n      vs,\n      [],\n    ),\n    (\"starts_with\", 2) => codegen.call_fn(\n      mut g,\n      codegen.prelude_name(\"str_starts_with\"),\n      vs,\n      [],\n    ),\n    (\"ends_with\", 2) => codegen.call_fn(\n      mut g,\n      codegen.prelude_name(\"str_ends_with\"),\n      vs,\n      [],\n    ),\n    (\"reverse\", 1) => codegen.call_fn(\n      mut g,\n      codegen.prelude_name(\"str_reverse\"),\n      vs,\n      [],\n    ),\n    (\"chars\", 1) => codegen.call_fn(\n      mut g,\n      codegen.prelude_name(\"str_chars\"),\n      vs,\n      [],\n    ),\n    (\"lines\", 1) => codegen.call_fn(mut g, codegen.prelude_name(\"lines\"), vs, []),\n    (\"index_of\", 2) => codegen.call_fn(\n      mut g,\n      codegen.prelude_name(\"str_index_of\"),\n      vs,\n      [],\n    ),\n    (\"replace\", 3) => codegen.call_fn(\n      mut g,\n      codegen.prelude_name(\"str_replace\"),\n      vs,\n      [],\n    ),\n    (\"repeat\", 2) => codegen.call_fn(\n      mut g,\n      codegen.prelude_name(\"str_repeat\"),\n      vs,\n      [],\n    ),\n    (\"trim\", 1) => codegen.call(mut g, TStr, \"strata_str_trim\", vs),\n    (\"to_upper\", 1) | (\"to_lower\", 1) => {\n      (table, n) := codegen.unicode_table(mut g, if name == \"to_upper\" {\n        \"upper\"\n      } else {\n        \"lower\"\n      })\n      (cased, m) := codegen.unicode_table(mut g, \"cased\")\n      codegen.call(mut g, TStr, \"strata_str_case\", [\n        get(vs, 0) ?? codegen.unit(),\n        codegen.V { ty: TStr, op: table },\n        codegen.V { ty: TInt, op: to_string(n) },\n        codegen.V { ty: TStr, op: cased },\n        codegen.V { ty: TInt, op: to_string(m) },\n        codegen.V { ty: TBool, op: to_string(name == \"to_lower\") },\n      ])\n    },\n    (\"is_digit\", 1) | (\"is_alpha\", 1) | (\"is_space\", 1) => {\n      (ranges, n) := codegen.unicode_table(mut g, \"alpha\")\n      class := match name {\n        \"is_digit\" => \"0\",\n        \"is_alpha\" => \"1\",\n        _ => \"2\",\n      }\n      codegen.call(mut g, TBool, \"strata_str_is\", [\n        get(vs, 0) ?? codegen.unit(),\n        codegen.V { ty: TInt, op: class },\n        codegen.V { ty: TStr, op: ranges },\n        codegen.V { ty: TInt, op: to_string(n) },\n      ])\n    },\n    (\"len\", 1) => codegen.call(mut g, TInt, \"strata_str_len\", vs),\n    (\"get\", 2) => {\n      c := codegen.call(mut g, TStr, \"strata_str_at\", vs)\n      ok := codegen.fresh(mut g, \"found\")\n      codegen.emit(mut g, f\"{ok} = icmp ne ptr {c.op}, null\")\n      codegen.option_if(mut g, ok, c, codegen.option_of(TStr))\n    },\n    (\"at\", 2) => codegen.call(mut g, TStr, \"strata_str_at_or_fault\", vs),\n    (\"slice\", 3) => codegen.call(mut g, TStr, \"strata_str_slice\", vs),\n    (\"ord\", 1) => codegen.call(mut g, TInt, \"strata_str_ord\", vs),\n    (\"byte_len\", 1) => codegen.call(mut g, TInt, \"strata_str_byte_len\", vs),\n    (\"byte_at\", 2) => codegen.call(mut g, TInt, \"strata_str_byte_at\", vs),\n    (\"byte_slice\", 3) => codegen.call(mut g, TStr, \"strata_str_byte_slice\", vs),\n    (\"chr\", 1) => codegen.call(mut g, TStr, \"strata_str_chr\", vs),\n    (\"parse_int\", 1) | (\"parse_float\", 1) => {\n      t := if name == \"parse_int\" {\n        TInt\n      } else {\n        TFloat\n      }\n      slot := codegen.fresh(mut g, \"parsed\")\n      mut g.allocas.push(f\"  {slot} = alloca {codegen.ll(t)}\")\n      zero := if name == \"parse_int\" {\n        \"0\"\n      } else {\n        \"0.0\"\n      }\n      codegen.emit(\n        mut g,\n        f\"store {codegen.ll(t)} {zero}, ptr {slot}\",\n      )\n      ok := codegen.call(mut g, TBool, \"strata_\" + name, [\n        get(vs, 0) ?? codegen.unit(),\n        codegen.V { ty: TStr, op: slot },\n      ])\n      x := codegen.fresh(mut g, \"x\")\n      codegen.emit(mut g, f\"{x} = load {codegen.ll(t)}, ptr {slot}\")\n      // the parsed number is new: a big one is an object, moved into the option\n      xv := codegen.temp(mut g, codegen.V { ty: t, op: x })\n      codegen.option_if(mut g, ok.op, xv, codegen.option_of(t))\n    },\n    (\"to_string\", 1) => codegen.show(mut g, get(vs, 0) ?? codegen.unit()),\n    (\"debug\", 1) => codegen.shown(mut g, get(vs, 0) ?? codegen.unit()),\n    (\"print\", 1) => codegen.call(mut g, TUnit, \"strata_print\", vs),\n    _ => {\n      codegen.not_yet(\n        mut g,\n        \"the built-in `\" + name + \"` on a `String`\",\n      )\n      codegen.never()\n    },\n  }\n}"},{"name":"codegen.number_builtin","kind":"fn","old":"a1570d571180be54","new":"dd8ed208f6f3813e","interface_changed":false,"affected":[],"module":"codegen","text":"fn number_builtin(\n  mut g: codegen.Gen,\n  name: String,\n  vs: List[codegen.V],\n) -> codegen.V {\n  x := get(vs, 0) ?? codegen.unit()\n  y := get(vs, 1) ?? codegen.unit()\n  match (name, x.ty, len(vs)) {\n    (\"abs\", check.TInt, 1) => {\n      // |n| of a small n is small, except for -2^62\n      neg := codegen.int_op(\n        mut g,\n        \"ssub\",\n        codegen.V { ty: check.TInt, op: \"0\" },\n        x,\n      )\n      lt := codegen.int_compare(\n        mut g,\n        \"slt\",\n        x,\n        codegen.V { ty: check.TInt, op: \"0\" },\n      )\n      r := codegen.fresh(mut g, \"abs\")\n      codegen.emit(\n        mut g,\n        f\"{r} = select i1 {lt.op}, i64 {neg.op}, i64 {x.op}\",\n      )\n      codegen.V { ty: check.TInt, op: r }\n    },\n    (\"abs\", check.TFloat, 1) => codegen.call(mut g, check.TFloat, \"llvm.fabs.f64\", vs),\n    (\"min\", _, 2) | (\"max\", _, 2) => {\n      lt := codegen.apply(mut g, ast.Less, x, y)\n      (a, b) := if name == \"min\" {\n        (x, y)\n      } else {\n        (y, x)\n      }\n      r := codegen.fresh(mut g, \"sel\")\n      codegen.emit(\n        mut g,\n        f\"{r} = select i1 {lt.op}, {codegen.ll(x.ty)} {a.op}, {codegen.ll(x.ty)} {b.op}\",\n      )\n      codegen.V { ty: x.ty, op: r }\n    },\n    (\"float\", check.TInt, 1) => codegen.call(mut g, check.TFloat, \"strata_int_to_float\", vs),\n    (\"float_bits\", check.TFloat, 1) => {\n      b := codegen.fresh(mut g, \"bits\")\n      codegen.emit(mut g, f\"{b} = bitcast double {x.op} to i64\")\n      codegen.call(\n        mut g,\n        check.TInt,\n        \"strata_int_from_u64\",\n        [codegen.V { ty: check.TInt, op: b }],\n      )\n    },\n    (\"float_from_bits\", check.TInt, 1) => {\n      // the low 64 bits; a NaN is not a `Float`\n      codegen.use_rt(mut g, \"strata_int_bits\")\n      b := codegen.fresh(mut g, \"b\")\n      codegen.emit(\n        mut g,\n        f\"{b} = call i64 @strata_int_bits(i64 {x.op})\",\n      )\n      f := codegen.fresh(mut g, \"f\")\n      codegen.emit(mut g, f\"{f} = bitcast i64 {b} to double\")\n      ok := codegen.fresh(mut g, \"num\")\n      codegen.emit(mut g, f\"{ok} = fcmp ord double {f}, 0.0\")\n      codegen.option_if(\n        mut g,\n        ok,\n        codegen.V { ty: check.TFloat, op: f },\n        codegen.option_of(check.TFloat),\n      )\n    },\n    (\"sqrt\", check.TFloat, 1) => codegen.call(mut g, check.TFloat, \"strata_sqrt\", vs),\n    (\"checked_add\", check.TFloat, 2) | (\"checked_sub\", check.TFloat, 2) | (\"checked_mul\", check.TFloat, 2) | (\"checked_div\", check.TFloat, 2) | (\"checked_rem\", check.TFloat, 2) => {\n      r := if name == \"checked_rem\" {\n        codegen.call(mut g, check.TFloat, \"strata_fmod\", vs)\n      } else {\n        ins := match name {\n          \"checked_add\" => \"fadd\",\n          \"checked_sub\" => \"fsub\",\n          \"checked_mul\" => \"fmul\",\n          _ => \"fdiv\",\n        }\n        o := codegen.fresh(mut g, \"f\")\n        codegen.emit(mut g, f\"{o} = {ins} double {x.op}, {y.op}\")\n        codegen.V { ty: check.TFloat, op: o }\n      }\n      ok := codegen.finite_test(mut g, r.op)\n      codegen.option_if(\n        mut g,\n        ok,\n        r,\n        codegen.option_of(check.TFloat),\n      )\n    },\n    (\"checked_sqrt\", check.TFloat, 1) => {\n      ok := codegen.fresh(mut g, \"nonneg\")\n      codegen.emit(mut g, f\"{ok} = fcmp oge double {x.op}, 0.0\")\n      r := codegen.fresh(mut g, \"f\")\n      codegen.use_rt(mut g, \"llvm.sqrt.f64\")\n      codegen.emit(\n        mut g,\n        f\"{r} = call double @llvm.sqrt.f64(double {x.op})\",\n      )\n      codegen.option_if(\n        mut g,\n        ok,\n        codegen.V { ty: check.TFloat, op: r },\n        codegen.option_of(check.TFloat),\n      )\n    },\n    (\"checked_floor\", check.TFloat, 1) | (\"checked_ceil\", check.TFloat, 1) | (\"checked_round\", check.TFloat, 1) => {\n      // 0.0 replaces a non-finite value, so nothing faults\n      ok := codegen.finite_test(mut g, x.op)\n      z := codegen.fresh(mut g, \"x\")\n      codegen.emit(\n        mut g,\n        f\"{z} = select i1 {ok}, double {x.op}, double 0.0\",\n      )\n      op := byte_slice(name, 8, byte_len(name))\n      r := codegen.call(\n        mut g,\n        check.TFloat,\n        f\"llvm.{op}.f64\",\n        [codegen.V { ty: check.TFloat, op: z }],\n      )\n      n := codegen.call(\n        mut g,\n        check.TInt,\n        \"strata_float_to_int\",\n        [r, codegen.V { ty: check.TFloat, op: z }],\n      )\n      codegen.option_if(mut g, ok, n, codegen.option_of(check.TInt))\n    },\n    (\"floor\", check.TFloat, 1) | (\"ceil\", check.TFloat, 1) | (\"round\", check.TFloat, 1) => {\n      r := codegen.call(mut g, check.TFloat, f\"llvm.{name}.f64\", vs)\n      codegen.call(mut g, check.TInt, \"strata_float_to_int\", [r, x])\n    },\n    _ => {\n      codegen.not_yet(mut g, \"the built-in `\"\n        + name\n        + \"` on (\"\n        + join(vs.map(v -> codegen.key(v.ty)), \", \")\n        + \")\")\n      codegen.never()\n    },\n  }\n}","old_text":"fn number_builtin(\n  mut g: codegen.Gen,\n  name: String,\n  vs: List[codegen.V],\n) -> codegen.V {\n  x := get(vs, 0) ?? codegen.unit()\n  y := get(vs, 1) ?? codegen.unit()\n  match (name, x.ty, len(vs)) {\n    (\"abs\", TInt, 1) => {\n      // |n| of a small n is small, except for -2^62\n      neg := codegen.int_op(\n        mut g,\n        \"ssub\",\n        codegen.V { ty: TInt, op: \"0\" },\n        x,\n      )\n      lt := codegen.int_compare(\n        mut g,\n        \"slt\",\n        x,\n        codegen.V { ty: TInt, op: \"0\" },\n      )\n      r := codegen.fresh(mut g, \"abs\")\n      codegen.emit(\n        mut g,\n        f\"{r} = select i1 {lt.op}, i64 {neg.op}, i64 {x.op}\",\n      )\n      codegen.V { ty: TInt, op: r }\n    },\n    (\"abs\", TFloat, 1) => codegen.call(mut g, TFloat, \"llvm.fabs.f64\", vs),\n    (\"min\", _, 2) | (\"max\", _, 2) => {\n      lt := codegen.apply(mut g, ast.Less, x, y)\n      (a, b) := if name == \"min\" {\n        (x, y)\n      } else {\n        (y, x)\n      }\n      r := codegen.fresh(mut g, \"sel\")\n      codegen.emit(\n        mut g,\n        f\"{r} = select i1 {lt.op}, {codegen.ll(x.ty)} {a.op}, {codegen.ll(x.ty)} {b.op}\",\n      )\n      codegen.V { ty: x.ty, op: r }\n    },\n    (\"float\", TInt, 1) => codegen.call(mut g, TFloat, \"strata_int_to_float\", vs),\n    (\"float_bits\", TFloat, 1) => {\n      b := codegen.fresh(mut g, \"bits\")\n      codegen.emit(mut g, f\"{b} = bitcast double {x.op} to i64\")\n      codegen.call(\n        mut g,\n        TInt,\n        \"strata_int_from_u64\",\n        [codegen.V { ty: TInt, op: b }],\n      )\n    },\n    (\"float_from_bits\", TInt, 1) => {\n      // the low 64 bits; a NaN is not a `Float`\n      codegen.use_rt(mut g, \"strata_int_bits\")\n      b := codegen.fresh(mut g, \"b\")\n      codegen.emit(\n        mut g,\n        f\"{b} = call i64 @strata_int_bits(i64 {x.op})\",\n      )\n      f := codegen.fresh(mut g, \"f\")\n      codegen.emit(mut g, f\"{f} = bitcast i64 {b} to double\")\n      ok := codegen.fresh(mut g, \"num\")\n      codegen.emit(mut g, f\"{ok} = fcmp ord double {f}, 0.0\")\n      codegen.option_if(\n        mut g,\n        ok,\n        codegen.V { ty: TFloat, op: f },\n        codegen.option_of(TFloat),\n      )\n    },\n    (\"sqrt\", TFloat, 1) => codegen.call(mut g, TFloat, \"strata_sqrt\", vs),\n    (\"checked_add\", TFloat, 2) | (\"checked_sub\", TFloat, 2) | (\"checked_mul\", TFloat, 2) | (\"checked_div\", TFloat, 2) | (\"checked_rem\", TFloat, 2) => {\n      r := if name == \"checked_rem\" {\n        codegen.call(mut g, TFloat, \"strata_fmod\", vs)\n      } else {\n        ins := match name {\n          \"checked_add\" => \"fadd\",\n          \"checked_sub\" => \"fsub\",\n          \"checked_mul\" => \"fmul\",\n          _ => \"fdiv\",\n        }\n        o := codegen.fresh(mut g, \"f\")\n        codegen.emit(mut g, f\"{o} = {ins} double {x.op}, {y.op}\")\n        codegen.V { ty: TFloat, op: o }\n      }\n      ok := codegen.finite_test(mut g, r.op)\n      codegen.option_if(mut g, ok, r, codegen.option_of(TFloat))\n    },\n    (\"checked_sqrt\", TFloat, 1) => {\n      ok := codegen.fresh(mut g, \"nonneg\")\n      codegen.emit(mut g, f\"{ok} = fcmp oge double {x.op}, 0.0\")\n      r := codegen.fresh(mut g, \"f\")\n      codegen.use_rt(mut g, \"llvm.sqrt.f64\")\n      codegen.emit(\n        mut g,\n        f\"{r} = call double @llvm.sqrt.f64(double {x.op})\",\n      )\n      codegen.option_if(\n        mut g,\n        ok,\n        codegen.V { ty: TFloat, op: r },\n        codegen.option_of(TFloat),\n      )\n    },\n    (\"checked_floor\", TFloat, 1) | (\"checked_ceil\", TFloat, 1) | (\"checked_round\", TFloat, 1) => {\n      // 0.0 replaces a non-finite value, so nothing faults\n      ok := codegen.finite_test(mut g, x.op)\n      z := codegen.fresh(mut g, \"x\")\n      codegen.emit(\n        mut g,\n        f\"{z} = select i1 {ok}, double {x.op}, double 0.0\",\n      )\n      op := byte_slice(name, 8, byte_len(name))\n      r := codegen.call(\n        mut g,\n        TFloat,\n        f\"llvm.{op}.f64\",\n        [codegen.V { ty: TFloat, op: z }],\n      )\n      n := codegen.call(\n        mut g,\n        TInt,\n        \"strata_float_to_int\",\n        [r, codegen.V { ty: TFloat, op: z }],\n      )\n      codegen.option_if(mut g, ok, n, codegen.option_of(TInt))\n    },\n    (\"floor\", TFloat, 1) | (\"ceil\", TFloat, 1) | (\"round\", TFloat, 1) => {\n      r := codegen.call(mut g, TFloat, f\"llvm.{name}.f64\", vs)\n      codegen.call(mut g, TInt, \"strata_float_to_int\", [r, x])\n    },\n    _ => {\n      codegen.not_yet(mut g, \"the built-in `\"\n        + name\n        + \"` on (\"\n        + join(vs.map(v -> codegen.key(v.ty)), \", \")\n        + \")\")\n      codegen.never()\n    },\n  }\n}"},{"name":"codegen.format_spec","kind":"fn","old":"535903f5fda74d58","new":"58343abba3ea3659","interface_changed":false,"affected":[],"module":"codegen","text":"/// An f-string part with a format spec (`{x:.2}`, `{n:>5}`, `{n:05}`), by\n/// runtime.c's `strata_format`.\nfn format_spec(mut g: codegen.Gen, v: codegen.V, f: ast.FmtSpec) -> codegen.V {\n  numeric := v.ty is check.TInt || v.ty is check.TFloat\n  if (f.plus || f.zero) && !numeric {\n    codegen.push_scope(mut g)\n    sv := codegen.shown(mut g, v)\n    m := codegen.lit(mut g, \"format spec `\"\n      + text.spec_text(f)\n      + \"`: `+` and `0` apply to numbers, not \")\n    codegen.fault(mut g, 4, [m, sv])\n    codegen.discard_scope(mut g)\n    return codegen.lit(mut g, \"\")\n  }\n  body := match (v.ty, f.precision) {\n    (check.TFloat, Some(p)) => codegen.call(\n      mut g,\n      check.TStr,\n      \"strata_show_float_fixed\",\n      [v, codegen.V { ty: check.TInt, op: to_string(p) }],\n    ),\n    (check.TStr, Some(p)) => codegen.call(mut g, check.TStr, \"strata_str_slice\", [\n      v,\n      codegen.V { ty: check.TInt, op: \"0\" },\n      codegen.V { ty: check.TInt, op: to_string(p) },\n    ]),\n    (_, Some(_)) => {\n      codegen.push_scope(mut g)\n      sv := codegen.shown(mut g, v)\n      m := codegen.lit(mut g, \"format spec `\"\n        + text.spec_text(f)\n        + \"`: `.N` applies to a Float or a String, not \")\n      codegen.fault(mut g, 4, [m, sv])\n      codegen.discard_scope(mut g)\n      return codegen.lit(mut g, \"\")\n    },\n    _ => codegen.show(mut g, v),\n  }\n  align := match f.align {\n    Some(c) => codegen.first_code(c, 0),\n    None => 0,\n  }\n  // the body is handed over: the runtime drops it or returns it\n  given := codegen.take_value(mut g, body)\n  r := codegen.fresh(mut g, \"fmt\")\n  codegen.use_rt(mut g, \"strata_format\")\n  codegen.emit(\n    mut g,\n    f\"{r} = call ptr @strata_format(ptr {given.op}, i1 {numeric}, i32 {codegen.first_code(f.fill, 32)}, i32 {align}, i1 {f.plus}, i1 {f.zero}, i64 {f.width})\",\n  )\n  codegen.temp(mut g, codegen.V { ty: check.TStr, op: r })\n}","old_text":"/// An f-string part with a format spec (`{x:.2}`, `{n:>5}`, `{n:05}`), by\n/// runtime.c's `strata_format`.\nfn format_spec(mut g: codegen.Gen, v: codegen.V, f: ast.FmtSpec) -> codegen.V {\n  numeric := v.ty is TInt || v.ty is TFloat\n  if (f.plus || f.zero) && !numeric {\n    codegen.push_scope(mut g)\n    sv := codegen.shown(mut g, v)\n    m := codegen.lit(mut g, \"format spec `\"\n      + text.spec_text(f)\n      + \"`: `+` and `0` apply to numbers, not \")\n    codegen.fault(mut g, 4, [m, sv])\n    codegen.discard_scope(mut g)\n    return codegen.lit(mut g, \"\")\n  }\n  body := match (v.ty, f.precision) {\n    (TFloat, Some(p)) => codegen.call(\n      mut g,\n      TStr,\n      \"strata_show_float_fixed\",\n      [v, codegen.V { ty: TInt, op: to_string(p) }],\n    ),\n    (TStr, Some(p)) => codegen.call(mut g, TStr, \"strata_str_slice\", [\n      v,\n      codegen.V { ty: TInt, op: \"0\" },\n      codegen.V { ty: TInt, op: to_string(p) },\n    ]),\n    (_, Some(_)) => {\n      codegen.push_scope(mut g)\n      sv := codegen.shown(mut g, v)\n      m := codegen.lit(mut g, \"format spec `\"\n        + text.spec_text(f)\n        + \"`: `.N` applies to a Float or a String, not \")\n      codegen.fault(mut g, 4, [m, sv])\n      codegen.discard_scope(mut g)\n      return codegen.lit(mut g, \"\")\n    },\n    _ => codegen.show(mut g, v),\n  }\n  align := match f.align {\n    Some(c) => codegen.first_code(c, 0),\n    None => 0,\n  }\n  // the body is handed over: the runtime drops it or returns it\n  given := codegen.take_value(mut g, body)\n  r := codegen.fresh(mut g, \"fmt\")\n  codegen.use_rt(mut g, \"strata_format\")\n  codegen.emit(\n    mut g,\n    f\"{r} = call ptr @strata_format(ptr {given.op}, i1 {numeric}, i32 {codegen.first_code(f.fill, 32)}, i32 {align}, i1 {f.plus}, i1 {f.zero}, i64 {f.width})\",\n  )\n  codegen.temp(mut g, codegen.V { ty: TStr, op: r })\n}"},{"name":"codegen.call_fn_want","kind":"fn","old":"a236fcbca15b3ac3","new":"fc0fcb65fa1d873f","interface_changed":true,"affected":["codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.expr_node","codegen.expr_want_node","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.builtin_call","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.main_arg","codegen.select_expr","codegen.expr","codegen.expr_want","codegen.entry","codegen.interp","codegen.format_spec","codegen.union_text","codegen.destructure","codegen.debug_fields","codegen.for_loop","codegen.debug_list","codegen.checked","codegen.fail_unless","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.fuzz_driver","codegen.trace_enter","codegen.trace_leave","codegen.matching_v","codegen.index_check","codegen.checked_update","codegen.decreases_fault","codegen.push_in_place","codegen.gen_list","codegen.converted","codegen.update_in_place","codegen.except_expr","codegen.matching_want","codegen.vtable","codegen.dyn_call","codegen.binary","codegen.logic","codegen.loop_body","codegen.matches","codegen.with_it","codegen.for_list"