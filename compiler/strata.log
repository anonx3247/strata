{"id":"6de6d387a81c7e5c","time":1795849714,"message":"edit","changes":[{"name":"kernel_dependent.new_name","kind":"fn","old":"879469147ca6a5ab","new":"1a77d902a05333fd","interface_changed":true,"affected":["kernel_dependent.define","kernel_dependent.declare","kernel_dependent.add_inductive","kernel_dependent_patch.base","kernel_dependent_patch.define_generic","kernel_dependent_patch.add_schema","kernel_dependent_patch.instances","kernel_dependent_patch.refusals","kernel_dependent_tactics.prove","kernel_dependent_patch.core_type","kernel_cli.dependent","kernel_dependent_patch.definitions","kernel_dependent_patch.records","kernel_dependent_patch.timed","kernel_cli.command","kernel_dependent_patch.laws","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent","text":"// ---- extending the environment ----\n\n/// `name` new, and `terms` closed: a free variable in a term to be checked\n/// would be taken for one the checker opens.\nfn new_name(\n  env: kernel_dependent.Environment,\n  name: String,\n  terms: List[kernel_dependent.Term],\n) -> Result[(), String] {\n  if terms.any(t -> kernel_dependent.has_free(t)) {\n    return Err(\"`\" + name + \"`: a free variable\")\n  }\n  if kernel_dependent.is_built_in(name)\n    || kernel_dependent.lookup(env, name) != None\n    || kernel_dependent.contents(env).inductives.any(\n      i -> i.name + \".rec\" == name,\n    )\n    || ends_with(name, \".rec\")\n    || starts_with(name, \"#\") {\n    Err(\"`\" + name + \"` is taken\")\n  } else {\n    Ok(())\n  }\n}","old_text":"// ---- extending the environment ----\n\nfn new_name(\n  env: kernel_dependent.Environment,\n  name: String,\n) -> Result[(), String] {\n  if kernel_dependent.is_built_in(name)\n    || kernel_dependent.lookup(env, name) != None\n    || kernel_dependent.contents(env).inductives.any(\n      i -> i.name + \".rec\" == name,\n    )\n    || ends_with(name, \".rec\")\n    || starts_with(name, \"#\") {\n    Err(\"`\" + name + \"` is taken\")\n  } else {\n    Ok(())\n  }\n}"},{"name":"kernel_dependent.define","kind":"fn","old":"ef54baa8a5b92b23","new":"534f65895543e0df","interface_changed":false,"affected":["kernel_dependent_patch.base","kernel_dependent_patch.define_generic","kernel_dependent_patch.add_schema","kernel_dependent_patch.instances","kernel_dependent_patch.refusals","kernel_dependent_tactics.prove","kernel_cli.dependent","kernel_dependent_patch.definitions","kernel_dependent_patch.records","kernel_dependent_patch.timed","kernel_cli.command","kernel_dependent_patch.laws","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent","text":"/// The environment with `name := value : ty`: `ty` a type and `value` of\n/// type `ty`, both closed. A law is a definition whose type is its\n/// statement, and its value the proof.\npub fn define(\n  env: kernel_dependent.Environment,\n  name: String,\n  ty: kernel_dependent.Term,\n  value: kernel_dependent.Term,\n) -> Result[kernel_dependent.Environment, String] {\n  kernel_dependent.new_name(env, name, [ty, value])!\n  _ := kernel_dependent.sort_of(env, [], ty)!\n  match kernel_dependent.has_type(env, [], value, ty) {\n    Ok(_) => (),\n    Err(m) => return Err(\"`\" + name + \"`: \" + m),\n  }\n  Ok(kernel_dependent.extended(env, [kernel_dependent.Entry {\n    name,\n    ty,\n    value: Some(value),\n    axiom: false,\n  }], []))\n}","old_text":"/// The environment with `name := value : ty`: `ty` a type and `value` of\n/// type `ty`, both closed. A law is a definition whose type is its\n/// statement, and its value the proof.\npub fn define(\n  env: kernel_dependent.Environment,\n  name: String,\n  ty: kernel_dependent.Term,\n  value: kernel_dependent.Term,\n) -> Result[kernel_dependent.Environment, String] {\n  kernel_dependent.new_name(env, name)!\n  _ := kernel_dependent.sort_of(env, [], ty)!\n  match kernel_dependent.has_type(env, [], value, ty) {\n    Ok(_) => (),\n    Err(m) => return Err(\"`\" + name + \"`: \" + m),\n  }\n  Ok(kernel_dependent.extended(env, [kernel_dependent.Entry {\n    name,\n    ty,\n    value: Some(value),\n    axiom: false,\n  }], []))\n}"},{"name":"kernel_dependent.declare","kind":"fn","old":"654970df339f85c9","new":"85dce9c3ba496c6c","interface_changed":false,"affected":["kernel_dependent_patch.core_type","kernel_dependent_patch.records","kernel_cli.dependent","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent","text":"/// The environment with an axiom `name : ty` (`ty` a closed type).\npub fn declare(\n  env: kernel_dependent.Environment,\n  name: String,\n  ty: kernel_dependent.Term,\n) -> Result[kernel_dependent.Environment, String] {\n  kernel_dependent.new_name(env, name, [ty])!\n  _ := kernel_dependent.sort_of(env, [], ty)!\n  Ok(kernel_dependent.extended(\n    env,\n    [kernel_dependent.Entry { name, ty, value: None, axiom: true }],\n    [],\n  ))\n}","old_text":"/// The environment with an axiom `name : ty` (`ty` a closed type).\npub fn declare(\n  env: kernel_dependent.Environment,\n  name: String,\n  ty: kernel_dependent.Term,\n) -> Result[kernel_dependent.Environment, String] {\n  kernel_dependent.new_name(env, name)!\n  _ := kernel_dependent.sort_of(env, [], ty)!\n  Ok(kernel_dependent.extended(\n    env,\n    [kernel_dependent.Entry { name, ty, value: None, axiom: true }],\n    [],\n  ))\n}"},{"name":"kernel_dependent.add_inductive","kind":"fn","old":"3ecd40c85652ea0a","new":"386f4a15056fb7ed","interface_changed":false,"affected":["kernel_dependent_patch.base","kernel_dependent_patch.add_schema","kernel_dependent_patch.refusals","kernel_cli.dependent","kernel_dependent_patch.records","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent","text":"/// The environment with the inductive type `name : ty` (`Π params. Sort l`,\n/// no indices) and its constructors: each `Π params. Π args. name params`,\n/// with the type's parameters, and each argument either `name params`\n/// (recursive) or a type not mentioning `name`, at a level at most `l`.\n/// Its recursor is `name.rec`.\npub fn add_inductive(\n  env: kernel_dependent.Environment,\n  name: String,\n  ty: kernel_dependent.Term,\n  params: Int,\n  constructors: List[(String, kernel_dependent.Term)],\n) -> Result[kernel_dependent.Environment, String] {\n  kernel_dependent.new_name(\n    env,\n    name,\n    [ty] + constructors.map(c -> c.1),\n  )!\n  _ := kernel_dependent.sort_of(env, [], ty)!\n  (ps, result) := kernel_dependent.peel(ty, params, \"#p\")\n  level := match result {\n    kernel_dependent.Sort(l) => if len(ps) == params {\n      l\n    } else {\n      return Err(\"`\" + name + \"`: fewer parameters than said\")\n    },\n    _ => return Err(\"`\"\n      + name\n      + \"`: not `Π params. Sort l` (indices aren't supported)\"),\n  }\n  with_type := kernel_dependent.extended(\n    env,\n    [kernel_dependent.Entry { name, ty, value: None, axiom: false }],\n    [],\n  )\n  self := kernel_dependent.applied(\n    kernel_dependent.Constant { name, levels: [] },\n    ps.map(p -> kernel_dependent.Free(p.0)),\n  )\n  mut cs := []\n  mut seen := [name + \".rec\"]\n  for (c, cty) in constructors {\n    kernel_dependent.new_name(with_type, c, [])!\n    if contains(seen, c) {\n      return Err(\"constructor `\" + c + \"` repeated\")\n    }\n    mut seen.push(c)\n    _ := kernel_dependent.sort_of(with_type, [], cty)!\n    (cps, rest) := kernel_dependent.peel(cty, params, \"#p\")\n    if cps != ps {\n      return Err(\"constructor `\" + c + \"`: not the type's parameters\")\n    }\n    (args, out) := kernel_dependent.peel(rest, -1, \"#a\")\n    if out != self {\n      return Err(\"constructor `\"\n        + c\n        + \"`: its result isn't the type at its parameters\")\n    }\n    mut ctx := ps.reversed()\n    mut recursive := []\n    for (a, d) in args {\n      if d == self {\n        mut recursive.push(true)\n      } else if kernel_dependent.mentions(d, name) {\n        return Err(\"constructor `\"\n          + c\n          + \"`: an argument mentions the type other than as itself\")\n      } else {\n        if kernel_dependent.sort_of(with_type, ctx, d)! > level {\n          return Err(\"constructor `\"\n            + c\n            + \"`: an argument in a larger universe than the type\")\n        }\n        mut recursive.push(false)\n      }\n      ctx = [(a, d)] + ctx\n    }\n    mut cs.push(\n      kernel_dependent.Constructor { name: c, ty: cty, recursive },\n    )\n  }\n  Ok(kernel_dependent.extended(\n    env,\n    [\n        kernel_dependent.Entry {\n          name,\n          ty,\n          value: None,\n          axiom: false,\n        },\n      ]\n      + cs.map(\n        c -> kernel_dependent.Entry {\n          name: c.name,\n          ty: c.ty,\n          value: None,\n          axiom: false,\n        },\n      ),\n    [kernel_dependent.Inductive {\n      name,\n      params,\n      level,\n      ty,\n      constructors: cs,\n    }],\n  ))\n}","old_text":"/// The environment with the inductive type `name : ty` (`Π params. Sort l`,\n/// no indices) and its constructors: each `Π params. Π args. name params`,\n/// with the type's parameters, and each argument either `name params`\n/// (recursive) or a type not mentioning `name`, at a level at most `l`.\n/// Its recursor is `name.rec`.\npub fn add_inductive(\n  env: kernel_dependent.Environment,\n  name: String,\n  ty: kernel_dependent.Term,\n  params: Int,\n  constructors: List[(String, kernel_dependent.Term)],\n) -> Result[kernel_dependent.Environment, String] {\n  kernel_dependent.new_name(env, name)!\n  _ := kernel_dependent.sort_of(env, [], ty)!\n  (ps, result) := kernel_dependent.peel(ty, params, \"#p\")\n  level := match result {\n    kernel_dependent.Sort(l) => if len(ps) == params {\n      l\n    } else {\n      return Err(\"`\" + name + \"`: fewer parameters than said\")\n    },\n    _ => return Err(\"`\"\n      + name\n      + \"`: not `Π params. Sort l` (indices aren't supported)\"),\n  }\n  with_type := kernel_dependent.extended(\n    env,\n    [kernel_dependent.Entry { name, ty, value: None, axiom: false }],\n    [],\n  )\n  self := kernel_dependent.applied(\n    kernel_dependent.Constant { name, levels: [] },\n    ps.map(p -> kernel_dependent.Free(p.0)),\n  )\n  mut cs := []\n  mut seen := [name + \".rec\"]\n  for (c, cty) in constructors {\n    kernel_dependent.new_name(with_type, c)!\n    if contains(seen, c) {\n      return Err(\"constructor `\" + c + \"` repeated\")\n    }\n    mut seen.push(c)\n    _ := kernel_dependent.sort_of(with_type, [], cty)!\n    (cps, rest) := kernel_dependent.peel(cty, params, \"#p\")\n    if cps != ps {\n      return Err(\"constructor `\" + c + \"`: not the type's parameters\")\n    }\n    (args, out) := kernel_dependent.peel(rest, -1, \"#a\")\n    if out != self {\n      return Err(\"constructor `\"\n        + c\n        + \"`: its result isn't the type at its parameters\")\n    }\n    mut ctx := ps.reversed()\n    mut recursive := []\n    for (a, d) in args {\n      if d == self {\n        mut recursive.push(true)\n      } else if kernel_dependent.mentions(d, name) {\n        return Err(\"constructor `\"\n          + c\n          + \"`: an argument mentions the type other than as itself\")\n      } else {\n        if kernel_dependent.sort_of(with_type, ctx, d)! > level {\n          return Err(\"constructor `\"\n            + c\n            + \"`: an argument in a larger universe than the type\")\n        }\n        mut recursive.push(false)\n      }\n      ctx = [(a, d)] + ctx\n    }\n    mut cs.push(\n      kernel_dependent.Constructor { name: c, ty: cty, recursive },\n    )\n  }\n  Ok(kernel_dependent.extended(\n    env,\n    [\n        kernel_dependent.Entry {\n          name,\n          ty,\n          value: None,\n          axiom: false,\n        },\n      ]\n      + cs.map(\n        c -> kernel_dependent.Entry {\n          name: c.name,\n          ty: c.ty,\n          value: None,\n          axiom: false,\n        },\n      ),\n    [kernel_dependent.Inductive {\n      name,\n      params,\n      level,\n      ty,\n      constructors: cs,\n    }],\n  ))\n}"},{"name":"kernel_dependent.has_free","kind":"fn","old":null,"new":"b93f767a1a47eeae","interface_changed":true,"affected":[],"module":"kernel_dependent","text":"fn has_free(t: kernel_dependent.Term) -> Bool {\n  match t {\n    kernel_dependent.Free(_) => true,\n    kernel_dependent.Pi { domain, body, .. } => kernel_dependent.has_free(domain)\n      || kernel_dependent.has_free(body),\n    kernel_dependent.Lambda { domain, body, .. } => kernel_dependent.has_free(domain)\n      || kernel_dependent.has_free(body),\n    kernel_dependent.Apply { function, argument } => kernel_dependent.has_free(function)\n      || kernel_dependent.has_free(argument),\n    _ => false,\n  }\n}"}]}
{"id":"19309543f6a52d3f","time":1795849735,"message":"edit","changes":[{"name":"kernel_dependent_patch.refusals","kind":"fn","old":"6df3ea7b225321e1","new":"3e3ab7fb2a8d9249","interface_changed":false,"affected":["kernel_cli.dependent","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","literal_errors_of","expanded","comptime_runner","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","loaded_check","file_errors","edit_file","edit_errors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent_patch","text":"/// What the kernel must refuse, each with its error: `Type : Type`, a\n/// proof of `Empty`, a non-positive inductive type, a constructor\n/// argument in a larger universe, a `refl` that isn't one, and a proof\n/// of a law that is false (a kept field set to `v`), and a free variable\n/// posing as a bound one. An empty error is a soundness bug.\npub fn refusals(env: kernel_dependent.Environment) -> List[(String, String)] {\n  t := kernel_dependent.Sort(0)\n  r := kernel_dependent_patch.record()\n  kept_set := kernel_dependent_patch.pis(kernel_dependent_patch.schema()\n    + [\n      (\"fs\", kernel_dependent_patch.fields()),\n      (\"x\", r),\n      (\"p\", kernel_dependent_patch.s(\"Patch\")),\n      (\"f\", kernel_dependent_patch.v(\"F\")),\n      (\n        \"v\",\n        kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n      ),\n    ], kernel_dependent_patch.eq0(\n    kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n    kernel_dependent.Apply {\n      function: kernel_dependent_patch.at(\n        kernel_dependent_patch.s(\"patched\"),\n        [\n          kernel_dependent_patch.v(\"fs\"),\n          kernel_dependent_patch.v(\"x\"),\n          kernel_dependent_patch.v(\"p\"),\n        ],\n      ),\n      argument: kernel_dependent_patch.v(\"f\"),\n    },\n    kernel_dependent_patch.v(\"v\"),\n  ))\n  [(\"Type : Type\", kernel_dependent_patch.refused(\n    kernel_dependent.define(env, \"bad\", t, t),\n  )), (\n    \"Empty proven by star\",\n    kernel_dependent_patch.refused(kernel_dependent.define(\n      env,\n      \"bad\",\n      kernel_dependent_patch.c(\"Empty\"),\n      kernel_dependent_patch.c(\"star\"),\n    )),\n  ), (\"Bad = mk (Bad → Empty)\", kernel_dependent_patch.refused(\n    kernel_dependent.add_inductive(env, \"Bad\", t, 0, [(\n      \"bad.mk\",\n      kernel_dependent_patch.arrow(kernel_dependent_patch.arrow(\n        kernel_dependent_patch.c(\"Bad\"),\n        kernel_dependent_patch.c(\"Empty\"),\n      ), kernel_dependent_patch.c(\"Bad\")),\n    )]),\n  )), (\"Box : Type = mk Type\", kernel_dependent_patch.refused(\n    kernel_dependent.add_inductive(env, \"Box\", t, 0, [(\n      \"box.mk\",\n      kernel_dependent_patch.arrow(\n        t,\n        kernel_dependent_patch.c(\"Box\"),\n      ),\n    )]),\n  )), (\n    \"λ b. #0, a free variable posing as `b`\",\n    kernel_dependent_patch.refused(kernel_dependent.define(\n      env,\n      \"bad\",\n      kernel_dependent_patch.arrow(\n        kernel_dependent_patch.c(\"Bool\"),\n        kernel_dependent_patch.c(\"Bool\"),\n      ),\n      kernel_dependent.Lambda {\n        name: \"b\",\n        domain: kernel_dependent_patch.c(\"Bool\"),\n        body: kernel_dependent_patch.v(\"#0\"),\n      },\n    )),\n  ), (\"true = false by refl\", kernel_dependent_patch.refused(\n    kernel_dependent.define(env, \"bad\", kernel_dependent_patch.eq0(\n      kernel_dependent_patch.c(\"Bool\"),\n      kernel_dependent_patch.c(\"true\"),\n      kernel_dependent_patch.c(\"false\"),\n    ), kernel_dependent.reflexivity(\n      0,\n      kernel_dependent_patch.c(\"Bool\"),\n      kernel_dependent_patch.c(\"true\"),\n    )),\n  )), (\n    \"any field patched is v, by refl\",\n    kernel_dependent_patch.refused(kernel_dependent.define(\n      env,\n      \"bad\",\n      kept_set,\n      kernel_dependent_patch.lambdas(kernel_dependent_patch.schema()\n        + [\n          (\"fs\", kernel_dependent_patch.fields()),\n          (\"x\", r),\n          (\"p\", kernel_dependent_patch.s(\"Patch\")),\n          (\"f\", kernel_dependent_patch.v(\"F\")),\n          (\n            \"v\",\n            kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n          ),\n        ], kernel_dependent.reflexivity(\n        0,\n        kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n        kernel_dependent_patch.v(\"v\"),\n      )),\n    )),\n  )]\n}","old_text":"/// What the kernel must refuse, each with its error: `Type : Type`, a\n/// proof of `Empty`, a non-positive inductive type, a constructor\n/// argument in a larger universe, a `refl` that isn't one, and a proof\n/// of a law that is false (a kept field set to `v`). An empty error is a\n/// soundness bug.\npub fn refusals(env: kernel_dependent.Environment) -> List[(String, String)] {\n  t := kernel_dependent.Sort(0)\n  r := kernel_dependent_patch.record()\n  kept_set := kernel_dependent_patch.pis(kernel_dependent_patch.schema()\n    + [\n      (\"fs\", kernel_dependent_patch.fields()),\n      (\"x\", r),\n      (\"p\", kernel_dependent_patch.s(\"Patch\")),\n      (\"f\", kernel_dependent_patch.v(\"F\")),\n      (\n        \"v\",\n        kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n      ),\n    ], kernel_dependent_patch.eq0(\n    kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n    kernel_dependent.Apply {\n      function: kernel_dependent_patch.at(\n        kernel_dependent_patch.s(\"patched\"),\n        [\n          kernel_dependent_patch.v(\"fs\"),\n          kernel_dependent_patch.v(\"x\"),\n          kernel_dependent_patch.v(\"p\"),\n        ],\n      ),\n      argument: kernel_dependent_patch.v(\"f\"),\n    },\n    kernel_dependent_patch.v(\"v\"),\n  ))\n  [(\"Type : Type\", kernel_dependent_patch.refused(\n    kernel_dependent.define(env, \"bad\", t, t),\n  )), (\n    \"Empty proven by star\",\n    kernel_dependent_patch.refused(kernel_dependent.define(\n      env,\n      \"bad\",\n      kernel_dependent_patch.c(\"Empty\"),\n      kernel_dependent_patch.c(\"star\"),\n    )),\n  ), (\"Bad = mk (Bad → Empty)\", kernel_dependent_patch.refused(\n    kernel_dependent.add_inductive(env, \"Bad\", t, 0, [(\n      \"bad.mk\",\n      kernel_dependent_patch.arrow(kernel_dependent_patch.arrow(\n        kernel_dependent_patch.c(\"Bad\"),\n        kernel_dependent_patch.c(\"Empty\"),\n      ), kernel_dependent_patch.c(\"Bad\")),\n    )]),\n  )), (\"Box : Type = mk Type\", kernel_dependent_patch.refused(\n    kernel_dependent.add_inductive(env, \"Box\", t, 0, [(\n      \"box.mk\",\n      kernel_dependent_patch.arrow(\n        t,\n        kernel_dependent_patch.c(\"Box\"),\n      ),\n    )]),\n  )), (\"true = false by refl\", kernel_dependent_patch.refused(\n    kernel_dependent.define(env, \"bad\", kernel_dependent_patch.eq0(\n      kernel_dependent_patch.c(\"Bool\"),\n      kernel_dependent_patch.c(\"true\"),\n      kernel_dependent_patch.c(\"false\"),\n    ), kernel_dependent.reflexivity(\n      0,\n      kernel_dependent_patch.c(\"Bool\"),\n      kernel_dependent_patch.c(\"true\"),\n    )),\n  )), (\n    \"any field patched is v, by refl\",\n    kernel_dependent_patch.refused(kernel_dependent.define(\n      env,\n      \"bad\",\n      kept_set,\n      kernel_dependent_patch.lambdas(kernel_dependent_patch.schema()\n        + [\n          (\"fs\", kernel_dependent_patch.fields()),\n          (\"x\", r),\n          (\"p\", kernel_dependent_patch.s(\"Patch\")),\n          (\"f\", kernel_dependent_patch.v(\"F\")),\n          (\n            \"v\",\n            kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n          ),\n        ], kernel_dependent.reflexivity(\n        0,\n        kernel_dependent_patch.ty(kernel_dependent_patch.v(\"f\")),\n        kernel_dependent_patch.v(\"v\"),\n      )),\n    )),\n  )]\n}"}]}
{"id":"091e81c8d3ccbb3a","time":1795849740,"message":"edit","changes":[{"name":"kernel_cli.dependent","kind":"fn","old":"720a85d092fb4ee0","new":"88cb5f72376fc32c","interface_changed":false,"affected":[],"module":"kernel_cli","text":"/// `strata kernel dependent [FILE.strata…]`: Patch's laws proven once, for\n/// every record, in the dependently typed kernel (kernel_dependent), each\n/// with the time its proof took to build and check; then each file's\n/// records as schemas, with the laws' instances at them.\nfn dependent(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  home: String,\n  paths: List[String],\n) -> std.process.ExitCode {\n  t0 := clock.now().value\n  mut checked := []\n  built := match kernel_dependent_patch.base(kernel_dependent.empty_environment()) {\n    Ok(e) => match kernel_dependent_patch.definitions(e) {\n      Ok(e2) => kernel_dependent_patch.laws(clock, mut checked, e2),\n      Err(m) => Err(m),\n    },\n    Err(m) => Err(m),\n  }\n  t1 := clock.now().value\n  env := built except m {\n    mut console.write(\"failed: \" + m + \"\\n\")\n    return 1\n  }\n  for k in checked {\n    mut console.write(\n      \"proven \"\n        + k.name\n        + \" (\"\n        + kernel_cli.milliseconds(k.ns)\n        + \")\\n\",\n    )\n  }\n  mut console.write(\n    f\"{len(checked)} laws proven for every record ({kernel_cli.milliseconds(t1 - t0)} with the base and definitions); axiom: funext (built in)\\n\",\n  )\n  for k in checked {\n    uses := match kernel_dependent.lookup(env, k.name) {\n      Some(kernel_dependent.Entry { value: Some(p), .. }) => kernel_dependent.mentions(p, \"funext\"),\n      _ => false,\n    }\n    if uses {\n      mut console.write(\"  \" + k.name + \" uses funext\\n\")\n    }\n  }\n  mut code := 0\n  for (what, m) in kernel_dependent_patch.refusals(env) {\n    if m == \"\" {\n      mut console.write(\"ACCEPTED (unsound): \" + what + \"\\n\")\n      code = 1\n    } else {\n      mut console.write(\"refused: \" + what + \" (\" + m + \")\\n\")\n    }\n  }\n  for path in paths {\n    t2 := clock.now().value\n    decls := match files.read_bytes(path) {\n      Ok(bytes) => match binary.read(bytes) {\n        Ok(img) => kernel_cli.made_in(\n          img.decls,\n          kernel_cli.typing_decls(files, home),\n        ),\n        Err(m) => Err(m),\n      },\n      Err(_) => Err(\"can't read it\"),\n    }\n    result := match decls {\n      Ok(ds) => kernel_dependent_patch.records(env, ds),\n      Err(m) => Err(m),\n    }\n    match result {\n      Ok(r) => {\n        mut console.write(\n          \"== \"\n            + path\n            + f\" ({kernel_cli.milliseconds(clock.now().value - t2)})\\n\",\n        )\n        for (n, s) in r.statements {\n          mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n        }\n        mut console.write(\n          \"opaque types: \"\n            + join(kernel_dependent.axioms(r.env), \", \")\n            + \"\\n\",\n        )\n      },\n      Err(m) => {\n        mut console.write(path + \": \" + m + \"\\n\")\n        code = 1\n      },\n    }\n  }\n  code\n}","old_text":"/// `strata kernel dependent [FILE.strata…]`: Patch's laws proven once, for\n/// every record, in the dependently typed kernel (kernel_dependent), each\n/// with the time its proof took to build and check; then each file's\n/// records as schemas, with the laws' instances at them.\nfn dependent(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  home: String,\n  paths: List[String],\n) -> std.process.ExitCode {\n  t0 := clock.now().value\n  mut checked := []\n  built := match kernel_dependent_patch.base(kernel_dependent.empty_environment()) {\n    Ok(e) => match kernel_dependent_patch.definitions(e) {\n      Ok(e2) => kernel_dependent_patch.laws(clock, mut checked, e2),\n      Err(m) => Err(m),\n    },\n    Err(m) => Err(m),\n  }\n  t1 := clock.now().value\n  env := built except m {\n    mut console.write(\"failed: \" + m + \"\\n\")\n    return 1\n  }\n  for k in checked {\n    mut console.write(\n      \"proven \"\n        + k.name\n        + \" (\"\n        + kernel_cli.milliseconds(k.ns)\n        + \")\\n\",\n    )\n  }\n  mut console.write(\n    f\"{len(checked)} laws proven for every record ({kernel_cli.milliseconds(t1 - t0)} with the base and definitions); axioms: \"\n      + join(kernel_dependent.axioms(env), \", \")\n      + \"\\n\",\n  )\n  for k in checked {\n    uses := match kernel_dependent.lookup(env, k.name) {\n      Some(kernel_dependent.Entry { value: Some(p), .. }) => kernel_dependent.mentions(p, \"funext\"),\n      _ => false,\n    }\n    if uses {\n      mut console.write(\"  \" + k.name + \" uses funext\\n\")\n    }\n  }\n  mut code := 0\n  for (what, m) in kernel_dependent_patch.refusals(env) {\n    if m == \"\" {\n      mut console.write(\"ACCEPTED (unsound): \" + what + \"\\n\")\n      code = 1\n    } else {\n      mut console.write(\"refused: \" + what + \" (\" + m + \")\\n\")\n    }\n  }\n  for path in paths {\n    t2 := clock.now().value\n    decls := match files.read_bytes(path) {\n      Ok(bytes) => match binary.read(bytes) {\n        Ok(img) => kernel_cli.made_in(\n          img.decls,\n          kernel_cli.typing_decls(files, home),\n        ),\n        Err(m) => Err(m),\n      },\n      Err(_) => Err(\"can't read it\"),\n    }\n    result := match decls {\n      Ok(ds) => kernel_dependent_patch.records(env, ds),\n      Err(m) => Err(m),\n    }\n    match result {\n      Ok(r) => {\n        mut console.write(\n          \"== \"\n            + path\n            + f\" ({kernel_cli.milliseconds(clock.now().value - t2)})\\n\",\n        )\n        for (n, s) in r.statements {\n          mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n        }\n      },\n      Err(m) => {\n        mut console.write(path + \": \" + m + \"\\n\")\n        code = 1\n      },\n    }\n  }\n  code\n}"}]}
{"id":"e20a264867027c35","time":1795849835,"message":"edit","changes":[{"name":"kernel_cli.dependent","kind":"fn","old":"88cb5f72376fc32c","new":"2b3b24c75d60bd06","interface_changed":false,"affected":[],"module":"kernel_cli","text":"/// `strata kernel dependent [FILE.strata…]`: Patch's laws proven once, for\n/// every record, in the dependently typed kernel (kernel_dependent), each\n/// with the time its proof took to build and check; then each file's\n/// records as schemas, with the laws' instances at them.\nfn dependent(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  home: String,\n  paths: List[String],\n) -> std.process.ExitCode {\n  t0 := clock.now().value\n  mut checked := []\n  built := match kernel_dependent_patch.base(kernel_dependent.empty_environment()) {\n    Ok(e) => match kernel_dependent_patch.definitions(e) {\n      Ok(e2) => kernel_dependent_patch.laws(clock, mut checked, e2),\n      Err(m) => Err(m),\n    },\n    Err(m) => Err(m),\n  }\n  t1 := clock.now().value\n  env := built except m {\n    mut console.write(\"failed: \" + m + \"\\n\")\n    return 1\n  }\n  for k in checked {\n    mut console.write(\n      \"proven \"\n        + k.name\n        + \" (tactics \"\n        + kernel_cli.milliseconds(k.tactic_ns)\n        + \", kernel \"\n        + kernel_cli.milliseconds(k.kernel_ns)\n        + f\", a term of {k.size} nodes)\\n\",\n    )\n  }\n  mut console.write(\n    f\"{len(checked)} laws proven for every record ({kernel_cli.milliseconds(t1 - t0)} with the base and definitions); axiom: funext (built in)\\n\",\n  )\n  for k in checked {\n    uses := match kernel_dependent.lookup(env, k.name) {\n      Some(kernel_dependent.Entry { value: Some(p), .. }) => kernel_dependent.mentions(p, \"funext\"),\n      _ => false,\n    }\n    if uses {\n      mut console.write(\"  \" + k.name + \" uses funext\\n\")\n    }\n  }\n  mut code := 0\n  for (what, m) in kernel_dependent_patch.refusals(env) {\n    if m == \"\" {\n      mut console.write(\"ACCEPTED (unsound): \" + what + \"\\n\")\n      code = 1\n    } else {\n      mut console.write(\"refused: \" + what + \" (\" + m + \")\\n\")\n    }\n  }\n  for path in paths {\n    t2 := clock.now().value\n    decls := match files.read_bytes(path) {\n      Ok(bytes) => match binary.read(bytes) {\n        Ok(img) => kernel_cli.made_in(\n          img.decls,\n          kernel_cli.typing_decls(files, home),\n        ),\n        Err(m) => Err(m),\n      },\n      Err(_) => Err(\"can't read it\"),\n    }\n    result := match decls {\n      Ok(ds) => kernel_dependent_patch.records(env, ds),\n      Err(m) => Err(m),\n    }\n    match result {\n      Ok(r) => {\n        mut console.write(\n          \"== \"\n            + path\n            + f\" ({kernel_cli.milliseconds(clock.now().value - t2)})\\n\",\n        )\n        for (n, s) in r.statements {\n          mut console.write(\"instance \" + n + \" : \" + s + \"\\n\")\n        }\n        mut console.write(\n          \"opaque types: \"\n            + join(kernel_dependent.axioms(r.env), \", \")\n            + \"\\n\",\n        )\n      },\n      Err(m) => {\n        mut console.write(path + \": \" + m + \"\\n\")\n        code = 1\n      },\n    }\n  }\n  code\n}","old_text":"/// `strata kernel dependent [FILE.strata…]`: Patch's laws proven once, for\n/// every record, in the dependently typed kernel (kernel_dependent), each\n/// with the time its proof took to build and check; then each file's\n/// records as schemas, with the laws' instances at them.\nfn dependent(\n  mut console: std.io.Console,\n  files: std.fs.Files,\n  clock: std.time.SystemClock,\n  home: String,\n  paths: List[String],\n) -> std.process.ExitCode {\n  t0 := clock.now().value\n  mut checked := []\n  built := match kernel_dependent_patch.base(kernel_dependent.empty_environment()) {\n    Ok(e) => match kernel_dependent_patch.definitions(e) {\n      Ok(e2) => kernel_dependent_patch.laws(clock, mut checked, e2),\n      Err