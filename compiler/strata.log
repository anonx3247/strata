"diff.log_range","diff.git_range","check_errors_with","check.type_errors","finding.uses_of","unused.members","unused_of","edit_unused","file_problem","diff.closure_hash","lib_world","reach_key","smt.obligation_keys","codegen.dyn_equal","derive.implements_trait","diff.diff_text","runtime_contracts","merge.similarity","pending.changed_names","smt.force","smt.valid_known","smt.merge_union","smt.pure_term","smt.congruent","decls_of","check.infer_handler","codegen.held_test","codegen.host_snapshot","codegen.outcome","codegen.word_op","codegen.from_c","smt.shape","smt.instance","smt.merge","smt.refresh","smt.map_literal","smt.write_after","termination.measures_all","solved_together","written_score","smt.term_of","smt.alias_lists","smt.eq_union","smt.arg_eq","smt.same_call","codegen.table_from","codegen.hash_fields","tour.side_range","check_errors_of","finding.uses_from","finding.used_by_tree","derive.expr","diff.close","pending.holeify","smt.as_int","smt.as_bool","smt.shape_test","smt.list_len","smt.map_of","smt.as_real","smt.as_str","smt.set_path","smt.field","smt.is_ctor","smt.different","smt.ctor_terms","store_check","check.infer_untagged","codegen.held_once_on","smt.part","smt.refresh_as","smt.leave_loop","termination.find_measure","smt.map_key","finding.uses_tree","derive.derive_fn","derive.with_known","derive.field_read","derive.type_method","derive.block","derive.children","derive.comprehension","derive.call_copy","derive.derive","diff.node_lines","diff.line_diff","smt.bits","smt.builtin_faults","smt.compare","smt.arith","smt.arm_slots","smt.concat","smt.lists_alike","smt.float_builtin","check.infer","check.infer_spread","codegen.set_field_in_place","derive.derive_all","derive.call_fn","derive.make","derive.match_type","check.fn_inferred","check.spread_method_params","check.binary","check.infer_if","check.infer_block","check.element_assigned","check.infer_call","check.infer_all","check.infer_method","check.static_call","check.builtin_call","check.infer_list","check.infer_match","check.infer_lambda","check.infer_update","check.infer_ctor","check.task_body","check.spread_filled","check.default_errors","derive.derived_in","check.decl_type_errors","check.fn_errors","check.fn_lambdas_typed","check.typed_one","check.op_fn","check.spread_body","check.field_reads","check.iter_builtin","derive.expand_with","derive.expand_in","derive.expand"],"module":"","text":"/// Read one by one and decoded by the workers: each file's definitions, or\n/// why it can't be read or decoded.\nfn decoded_files(\n  disk: std.fs.Disk,\n  files: List[String],\n) -> List[Result[List[ast.Decl], String]] {\n  mut read := []\n  for f in files {\n    mut read.push(disk.read_bytes(f))\n  }\n  // a reference is read as the module that has its id names it, which can\n  // differ from the name the referring file has for it when the files were\n  // written apart (a merge)\n  mut owners := Dict[ast.Key, String] {}\n  mut named := Set[String] {}\n  for r in read {\n    match r {\n      Ok(bs) => match binary.read_header(bs) {\n        Ok(h) => {\n          for (k, q) in binary.owned(h) {\n            mut owners.insert(k, q)\n            mut named.insert(q)\n          }\n        },\n        Err(_) => (),\n      },\n      Err(_) => (),\n    }\n  }\n  decoded := timings.timed(\n    \"decode\",\n    () -> parallel.map_parallel(read, r -> match r {\n      Ok(bs) => Some(\n        binary.read_named(bs, binary.owner_names(bs, owners, named)),\n      ),\n      Err(_) => None,\n    }),\n  )\n  mut out := []\n  for (k, d) in enumerate(decoded) {\n    f := get(files, k) ?? \"\"\n    mut out.push(\n      match d {\n        // (a module file, or a bundle: its modules' definitions)\n        Some(Ok(img)) => Ok(img.decls),\n        Some(Err(e)) => Err(f\"{f}: {e}\"),\n        None => Err(f\"{f}: can't be read\"),\n      },\n    )\n  }\n  out\n}","old_text":"/// Read one by one and decoded by the workers. One that can't be read or\n/// decoded has none, and says why.\nfn decoded_files(\n  disk: std.fs.Disk,\n  files: List[String],\n) -> List[List[ast.Decl]] {\n  mut read := []\n  for f in files {\n    mut read.push(disk.read_bytes(f))\n  }\n  // a reference is read as the module that has its id names it, which can\n  // differ from the name the referring file has for it when the files were\n  // written apart (a merge)\n  mut owners := Dict[ast.Key, String] {}\n  mut named := Set[String] {}\n  for r in read {\n    match r {\n      Ok(bs) => match binary.read_header(bs) {\n        Ok(h) => {\n          for (k, q) in binary.owned(h) {\n            mut owners.insert(k, q)\n            mut named.insert(q)\n          }\n        },\n        Err(_) => (),\n      },\n      Err(_) => (),\n    }\n  }\n  decoded := timings.timed(\n    \"decode\",\n    () -> parallel.map_parallel(read, r -> match r {\n      Ok(bs) => Some(\n        binary.read_named(bs, binary.owner_names(bs, owners, named)),\n      ),\n      Err(_) => None,\n    }),\n  )\n  mut out := []\n  for d in decoded {\n    mut out.push(\n      match d {\n        // (a module file, or a bundle: its modules' definitions)\n        Some(Ok(img)) => img.decls,\n        Some(Err(e)) => {\n          print(e)\n          []\n        },\n        None => {\n          print(\"unreadable\")\n          []\n        },\n      },\n    )\n  }\n  out\n}"},{"name":"module_decls","kind":"fn","old":"9d94ba8abd30892f","new":"b3a0133f5e50b76a","interface_changed":false,"affected":[],"module":"","text":"/// Module files or bundles, in order.\nfn module_decls(disk: std.fs.Disk, files: List[String]) -> List[ast.Decl] {\n  mut out := []\n  for r in decoded_files(disk, files) {\n    match r {\n      Ok(ds) => {\n        out += ds\n      },\n      Err(e) => print(f\"error: {e}\"),\n    }\n  }\n  out\n}","old_text":"/// Module files or bundles, in order.\nfn module_decls(disk: std.fs.Disk, files: List[String]) -> List[ast.Decl] {\n  mut out := []\n  for ds in decoded_files(disk, files) {\n    out += ds\n  }\n  out\n}"},{"name":"load_given","kind":"fn","old":"ad32308cde117ee5","new":"2a71f17049364546","interface_changed":false,"affected":[],"module":"","text":"/// `load_found` with the package's definitions `given` (else read from its\n/// files) and the names they reach outside it, `roots` (else found in them\n/// by `package_roots`).\nfn load_given(\n  disk: std.fs.Disk,\n  std_dir: String,\n  dir: String,\n  with_deps: Bool,\n  core: builtins.Core,\n  found: List[deps.Found],\n  given: Option[List[ast.Decl]],\n  roots: Option[List[String]],\n) -> Result[Loaded, String] {\n  // std itself (its strata.toml names it `std`): its modules are `std.…`,\n  // as their headers name them, and it is no library of its own\n  own_name := match disk.read(dir + \"/strata.toml\") {\n    Ok(text) => match deps.manifest(text) {\n      Ok(mf) => mf.name,\n      Err(_) => \"\",\n    },\n    Err(_) => \"\",\n  }\n  is_std := own_name == \"std\"\n  prefix := if is_std {\n    \"std\"\n  } else {\n    \"\"\n  }\n  for f in found {\n    if contains(reserved_packages(), f.name) {\n      return Err(\n        f\"the dependency `{f.name}` is named like the built-in package `{f.name}`: rename it\",\n      )\n    }\n  }\n  mut own := Set[String] {}\n  // (the modules of the definitions given too: an edit checked before it\n  // is written may add a module that has no file yet)\n  mut names := deps.module_files(disk, dir).map(\n    rel -> deps.module_name(prefix, rel),\n  )\n  for d in given ?? [] {\n    if !contains(names, d.module) {\n      mut names.push(d.module)\n    }\n  }\n  for m in names {\n    // `core` and `std` are the language's own packages: no other package\n    // names a module like them (theirs are `core.…` and `std.…`)\n    if !contains(reserved_packages(), own_name) {\n      for r in reserved_packages() {\n        if m == r || starts_with(m, r + \".\") {\n          return Err(\n            f\"module `{m}` is named like the built-in package `{r}`, whose modules are `{r}` and `{r}.…`: rename the module\",\n          )\n        }\n      }\n    }\n    for f in found {\n      if m == f.name || starts_with(m, f.name + \".\") {\n        return Err(\n          f\"module `{m}` is named like the dependency `{f.name}`, whose modules are `{f.name}` and `{f.name}.…`: rename the module\",\n        )\n      }\n    }\n    mut own.insert(m)\n  }\n  mut libs := if is_std {\n    []\n  } else {\n    [lib_of(disk, \"std\", std_dir, false, None)]\n  }\n  for f in found {\n    mut libs.push(lib_of(disk, f.name, f.dir, true, f.exports))\n  }\n  // (the definitions given, as package_decls reads them: the functions of\n  // the modules its strata.toml declares `noalloc` are marked so)\n  ds := match given {\n    Some(g) => deps.noalloc_marked(\n      g,\n      prefix,\n      deps.noalloc_modules(disk.read(dir + \"/strata.toml\") !! \"\"),\n    ),\n    None => read_package(disk, dir, prefix)!,\n  }\n  has_deps := len(found) > 0\n  mut st := loading(libs, own)\n  load(\n    mut st,\n    disk,\n    (roots ?? package_roots(ds, st.modules, has_deps))\n      + if is_std {\n        []\n      } else {\n        derived_trait_roots(disk, std_dir, ds)\n      },\n  )\n  if with_deps {\n    tests := dep_tests(mut st, disk)\n    load(mut st, disk, tests)\n  }\n  // (the package's settings, `std.typing.setting(\"json.integers\")`, written\n  // where std's code reads them)\n  settings := match disk.read(dir + \"/strata.toml\") {\n    Ok(text) => deps.package_settings(text),\n    Err(_) => Dict[String, String] {},\n  }\n  context := derive.with_settings(filter(st.out, d -> !is_test(d)), settings)\n  Ok(Loaded {\n    written: ds,\n    own: if has_deps {\n      resolve.stored(ds, context, core)\n    } else {\n      ds\n    },\n    context,\n    tests: derive.with_settings(filter(st.out, d -> is_test(d)), settings),\n    deps: has_deps,\n    unexported: st.unexported,\n    std_uses: std_uses(mut st, disk, ds),\n  })\n}","old_text":"/// `load_found` with the package's definitions `given` (else read from its\n/// files) and the names they reach outside it, `roots` (else found in them\n/// by `package_roots`).\nfn load_given(\n  disk: std.fs.Disk,\n  std_dir: String,\n  dir: String,\n  with_deps: Bool,\n  core: builtins.Core,\n  found: List[deps.Found],\n  given: Option[List[ast.Decl]],\n  roots: Option[List[String]],\n) -> Result[Loaded, String] {\n  // std itself (its strata.toml names it `std`): its modules are `std.…`,\n  // as their headers name them, and it is no library of its own\n  own_name := match disk.read(dir + \"/strata.toml\") {\n    Ok(text) => match deps.manifest(text) {\n      Ok(mf) => mf.name,\n      Err(_) => \"\",\n    },\n    Err(_) => \"\",\n  }\n  is_std := own_name == \"std\"\n  prefix := if is_std {\n    \"std\"\n  } else {\n    \"\"\n  }\n  for f in found {\n    if contains(reserved_packages(), f.name) {\n      return Err(\n        f\"the dependency `{f.name}` is named like the built-in package `{f.name}`: rename it\",\n      )\n    }\n  }\n  mut own := Set[String] {}\n  // (the modules of the definitions given too: an edit checked before it\n  // is written may add a module that has no file yet)\n  mut names := deps.module_files(disk, dir).map(\n    rel -> deps.module_name(prefix, rel),\n  )\n  for d in given ?? [] {\n    if !contains(names, d.module) {\n      mut names.push(d.module)\n    }\n  }\n  for m in names {\n    // `core` and `std` are the language's own packages: no other package\n    // names a module like them (theirs are `core.…` and `std.…`)\n    if !contains(reserved_packages(), own_name) {\n      for r in reserved_packages() {\n        if m == r || starts_with(m, r + \".\") {\n          return Err(\n            f\"module `{m}` is named like the built-in package `{r}`, whose modules are `{r}` and `{r}.…`: rename the module\",\n          )\n        }\n      }\n    }\n    for f in found {\n      if m == f.name || starts_with(m, f.name + \".\") {\n        return Err(\n          f\"module `{m}` is named like the dependency `{f.name}`, whose modules are `{f.name}` and `{f.name}.…`: rename the module\",\n        )\n      }\n    }\n    mut own.insert(m)\n  }\n  mut libs := if is_std {\n    []\n  } else {\n    [lib_of(disk, \"std\", std_dir, false, None)]\n  }\n  for f in found {\n    mut libs.push(lib_of(disk, f.name, f.dir, true, f.exports))\n  }\n  // (the definitions given, as package_decls reads them: the functions of\n  // the modules its strata.toml declares `noalloc` are marked so)\n  ds := match given {\n    Some(g) => deps.noalloc_marked(\n      g,\n      prefix,\n      deps.noalloc_modules(disk.read(dir + \"/strata.toml\") !! \"\"),\n    ),\n    None => package_decls(disk, dir, prefix),\n  }\n  has_deps := len(found) > 0\n  mut st := loading(libs, own)\n  load(\n    mut st,\n    disk,\n    (roots ?? package_roots(ds, st.modules, has_deps))\n      + if is_std {\n        []\n      } else {\n        derived_trait_roots(disk, std_dir, ds)\n      },\n  )\n  if with_deps {\n    tests := dep_tests(mut st, disk)\n    load(mut st, disk, tests)\n  }\n  // (the package's settings, `std.typing.setting(\"json.integers\")`, written\n  // where std's code reads them)\n  settings := match disk.read(dir + \"/strata.toml\") {\n    Ok(text) => deps.package_settings(text),\n    Err(_) => Dict[String, String] {},\n  }\n  context := derive.with_settings(filter(st.out, d -> !is_test(d)), settings)\n  Ok(Loaded {\n    written: ds,\n    own: if has_deps {\n      resolve.stored(ds, context, core)\n    } else {\n      ds\n    },\n    context,\n    tests: derive.with_settings(filter(st.out, d -> is_test(d)), settings),\n    deps: has_deps,\n    unexported: st.unexported,\n    std_uses: std_uses(mut st, disk, ds),\n  })\n}"},{"name":"own_decls","kind":"fn","old":"f14496745e30a343","new":"f8b24addc21f289e","interface_changed":false,"affected":[],"module":"","text":"/// Each in its module.\nfn own_decls(\n  disk: std.fs.Disk,\n  sources: List[(String, String)],\n) -> List[ast.Decl] {\n  mut out := []\n  // (the files decoded at once, by the workers)\n  for (i, r) in enumerate(decoded_files(disk, sources.map(s -> s.0))) {\n    m := (get(sources, i) ?? (\"\", \"\")).1\n    match r {\n      Ok(ds) => {\n        for d in ds {\n          mut out.push(ast.Decl { ..d, module: m })\n        }\n      },\n      Err(e) => print(f\"error: {e}\"),\n    }\n  }\n  out\n}","old_text":"/// Each in its module.\nfn own_decls(\n  disk: std.fs.Disk,\n  sources: List[(String, String)],\n) -> List[ast.Decl] {\n  mut out := []\n  // (the files decoded at once, by the workers)\n  for (i, ds) in enumerate(decoded_files(disk, sources.map(s -> s.0))) {\n    m := (get(sources, i) ?? (\"\", \"\")).1\n    for d in ds {\n      mut out.push(ast.Decl { ..d, module: m })\n    }\n  }\n  out\n}"},{"name":"code_definitions","kind":"fn","old":"7cf396138ffff69e","new":"24c9ec4c718dbe15","interface_changed":false,"affected":[],"module":"","text":"/// As a snapshot has them. An error when a file doesn't decode.\nfn code_definitions(\n  disk: std.fs.Disk,\n  core: builtins.Core,\n  root: String,\n  files: List[String],\n) -> Result[List[CodeDef], String] {\n  // (each file decodes, or the snapshot is an error naming it)\n  for rel in files {\n    match disk.read_bytes(root + \"/\" + rel) {\n      Ok(bytes) => match binary.decode_module(bytes) {\n        Ok(_) => (),\n        Err(e) => return Err(f\"{rel}: {e}\"),\n      },\n      Err(e) => return Err(f\"{rel}: {e}\"),\n    }\n  }\n  stored := read_package(disk, root, \"\")!\n  written_ds := resolve.written(stored, [], core)\n  g := store.graph(stored, false)\n  // an `impl` is how its type implements its trait: no dependency of\n  // either, nor a reference to them\n  mut impl_of := Dict[String, (String, String)] {}\n  for d in stored {\n    match d.kind {\n      ast.ImplDef(i) => mut impl_of.insert(\n        store.qname(d),\n        (i.trait_name, type_head_text(i.for_type)),\n      ),\n      _ => (),\n    }\n  }\n  mut referrers := Dict[String, List[String]] {}\n  for (n, ds) in g {\n    for dep in ds {\n      mut referrers.insert(dep, (get(referrers, dep) ?? []) + [n])\n    }\n  }\n  mut out := []\n  for (k, d) in enumerate(stored) {\n    name := store.qname(d)\n    sd := get(written_ds, k) ?? d\n    own := get(impl_of, name)\n    deps := (get(g, name) ?? []).filter(\n      n -> match own {\n        Some((tr, ty)) => n != tr && n != ty,\n        None => true,\n      },\n    )\n    is_own_impl := (n: String) -> match get(impl_of, n) {\n      Some((tr, ty)) => tr == name || ty == name,\n      None => false,\n    }\n    refs := (get(referrers, name) ?? [])\n      .filter(n -> !is_own_impl(n))\n      .sorted()\n    impls := keys(impl_of).filter(n -> is_own_impl(n)).sorted()\n    label := match d.kind {\n      ast.TestDef(t) => t.name,\n      _ => last_segment(name),\n    }\n    mut out.push(\n      CodeDef {\n        name,\n        module: d.module,\n        label,\n        kind: decl_kind_word(d),\n        public: d.public,\n        doc: join(d.doc, \"\\n\"),\n        hash: bytes_hex(binary.code_hash(d)),\n        interface: without_doc(views.view_decl(sd, d, 1, g)),\n        source: without_doc(views.view_decl(sd, d, 2, g)),\n        deps,\n        refs,\n        impls,\n      },\n    )\n  }\n  Ok(out)\n}","old_text":"/// As a snapshot has them. An error when a file doesn't decode.\nfn code_definitions(\n  disk: std.fs.Disk,\n  core: builtins.Core,\n  root: String,\n  files: List[String],\n) -> Result[List[CodeDef], String] {\n  // (each file decodes, or the snapshot is an error naming it)\n  for rel in files {\n    match disk.read_bytes(root + \"/\" + rel) {\n      Ok(bytes) => match binary.decode_module(bytes) {\n        Ok(_) => (),\n        Err(e) => return Err(f\"{rel}: {e}\"),\n      },\n      Err(e) => return Err(f\"{rel}: {e}\"),\n    }\n  }\n  stored := package_decls(disk, root, \"\")\n  written_ds := resolve.written(stored, [], core)\n  g := store.graph(stored, false)\n  // an `impl` is how its type implements its trait: no dependency of\n  // either, nor a reference to them\n  mut impl_of := Dict[String, (String, String)] {}\n  for d in stored {\n    match d.kind {\n      ast.ImplDef(i) => mut impl_of.insert(\n        store.qname(d),\n        (i.trait_name, type_head_text(i.for_type)),\n      ),\n      _ => (),\n    }\n  }\n  mut referrers := Dict[String, List[String]] {}\n  for (n, ds) in g {\n    for dep in ds {\n      mut referrers.insert(dep, (get(referrers, dep) ?? []) + [n])\n    }\n  }\n  mut out := []\n  for (k, d) in enumerate(stored) {\n    name := store.qname(d)\n    sd := get(written_ds, k) ?? d\n    own := get(impl_of, name)\n    deps := (get(g, name) ?? []).filter(\n      n -> match own {\n        Some((tr, ty)) => n != tr && n != ty,\n        None => true,\n      },\n    )\n    is_own_impl := (n: String) -> match get(impl_of, n) {\n      Some((tr, ty)) => tr == name || ty == name,\n      None => false,\n    }\n    refs := (get(referrers, name) ?? [])\n      .filter(n -> !is_own_impl(n))\n      .sorted()\n    impls := keys(impl_of).filter(n -> is_own_impl(n)).sorted()\n    label := match d.kind {\n      ast.TestDef(t) => t.name,\n      _ => last_segment(name),\n    }\n    mut out.push(\n      CodeDef {\n        name,\n        module: d.module,\n        label,\n        kind: decl_kind_word(d),\n        public: d.public,\n        doc: join(d.doc, \"\\n\"),\n        hash: bytes_hex(binary.code_hash(d)),\n        interface: without_doc(views.view_decl(sd, d, 1, g)),\n        source: without_doc(views.view_decl(sd, d, 2, g)),\n        deps,\n        refs,\n        impls,\n      },\n    )\n  }\n  Ok(out)\n}"},{"name":"decls_of","kind":"fn","old":"1dc107ff8aad3ee3","new":"7385eee3c7ffd409","interface_changed":false,"affected":[],"module":"","text":"/// `read_module`'s definitions, or none with an error printed.\nfn decls_of(disk: std.fs.Disk, f: String) -> List[ast.Decl] {\n  read_module(disk, f) except e {\n    print(f\"error: {e}\")\n    []\n  }\n}","old_text":"fn decls_of(disk: std.fs.Disk, f: String) -> List[ast.Decl] {\n  match disk.read_bytes(f) {\n    Ok(bytes) => match binary.read(bytes) {\n      Ok(img) => img.decls,\n      Err(e) => {\n        print(f\"error: {f}: {e}\")\n        []\n      },\n    },\n    Err(e) => {\n      print(f\"error: {f}: {e}\")\n      []\n    },\n  }\n}"},{"name":"edit_command","kind":"fn","old":"07391f35b1e07adf","new":"282beef3a61d5ce1","interface_changed":false,"affected":[],"module":"","text":"/// `strata edit [MODULE] [-m MSG] [--rm NAME].. [--no-commit] [--no-search]`\n/// and `strata\n/// add FILE [MODULE]`: definitions from standard input (or the file, or the\n/// editor) replace or join the package's of the same names in MODULE\n/// (default the root module). Recorded only if the whole package checks.\nfn edit_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  args: List[String],\n  cmd: String,\n) -> std.process.ExitCode {\n  if contains(args, \"--help\") || contains(args, \"-h\") {\n    mut console.write(command_usage(cmd))\n    return 0\n  }\n  // `--file F`: a script or a folder, outside any log. std's folder is\n  // edited as a package is, checked and atomic (it is built into strata).\n  mut line := args\n  mut opened: Option[Result[Opened, String]] = None\n  match [k for (k, x) in enumerate(args) where x == \"--file\"] {\n    [k, ..] => {\n      f := get(args, k + 1) ?? \"\"\n      rest := [x for (i, x) in enumerate(args) where i != k && i != k + 1]\n      if disk.is_dir(f) && package_name(disk, f) == \"std\" {\n        opened = Some(open_package_at(disk, process, f, cmd))\n        line = rest\n      } else {\n        return edit_file(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          f,\n          rest,\n          cmd,\n        )\n      }\n    },\n    [] => (),\n  }\n  timings.begin(\"edit: open\")\n  o := (opened ?? open_package(disk, process, cmd)) except {\n    return fail_with(\n      mut console,\n      \"no package here (no strata.toml in this folder or above: run `strata init`, or pass --file)\",\n    )\n  }\n  timings.end(\"edit: open\")\n  // (`--file std`: outside any log, as `--file` is: written and checked,\n  // never committed to git)\n  given_args := match edit_args(line) {\n    Ok(g) => EditArgs { ..g, commit: g.commit && opened is None },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // (`--rm NAME`: a qualified name, or a short one naming one definition,\n  // in MODULE first)\n  a := match removed_names(o.decls, if cmd == \"add\" {\n    \"\"\n  } else {\n    package_module(o.name, edit_module(given_args.module ?? \"\"))\n  }, given_args.removes) {\n    Ok(rs) => EditArgs { ..given_args, removes: rs },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // `add FILE [MODULE]`: the file's text, into MODULE. For a module file or\n  // a folder of them: its definitions, in their modules.\n  if cmd == \"add\" {\n    f := a.module ?? \"\"\n    stored_defs := if disk.is_dir(f) {\n      Some(read_package(disk, f, \"\") except e {\n        return fail_with(mut console, e)\n      })\n    } else {\n      match disk.read_bytes(f) {\n        Ok(bytes) => match binary.read(bytes) {\n          Ok(img) => Some(img.decls),\n          Err(_) => None,\n        },\n        Err(e) => return fail_with(mut console, f\"{f}: {e}\"),\n      }\n    }\n    match stored_defs {\n      Some(ds) => {\n        message := if a.message == \"edit\" {\n          \"import\"\n        } else {\n          a.message\n        }\n        return match apply_edit(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          clock,\n          cache,\n          o,\n          ds,\n          a.removes,\n          message,\n          a.commit,\n          cmd,\n          contains(line, \"--json\"),\n          [],\n          a.search,\n          true,\n        ) {\n          Ok(_) => 0,\n          Err(_) => 1,\n        }\n      },\n      None => (),\n    }\n  }\n  (text, module_arg, message) := if cmd == \"add\" {\n    f := a.module ?? \"\"\n    t := disk.read(f) except e {\n      return fail_with(mut console, f\"{f}: {e}\")\n    }\n    (t, a.extra ?? \"\", if a.message == \"edit\" {\n      \"import\"\n    } else {\n      a.message\n    })\n  } else if contains(line, \"--editor\")\n    || console.interactive()\n      && driver_terminal(1).to_int() == 1\n      && len(a.removes) == 0 {\n    // (an editor only for someone at the terminal: standard input and output\n    // both on it, and nothing to remove)\n    return edit_in_editor(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      clock,\n      cache,\n      o,\n      a,\n    )\n  } else {\n    match piped_input(\n      mut console,\n      len(a.removes) > 0,\n      \"strata edit [MODULE]\",\n    ) {\n      Ok(t) => (t, a.module ?? \"\", a.message),\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  // (std's modules as stored: `io` is `std.io`)\n  timings.begin(\"edit: parse\")\n  edits := parse.parse_module(\n    text,\n    package_module(o.name, edit_module(module_arg)),\n  ) except e {\n    code := fail_with(mut console, f\"parse error at {e}\")\n    if cmd == \"edit\" {\n      say_kept(\n        mut console,\n        keep_rejected(mut disk, o.root, [(module_arg, text)]),\n      )\n    }\n    return code\n  }\n  timings.end(\"edit: parse\")\n  match apply_edit(\n    mut console,\n    mut disk,\n    mut launcher,\n    process,\n    clock,\n    cache,\n    o,\n    edits,\n    a.removes,\n    message,\n    a.commit,\n    cmd,\n    contains(line, \"--json\"),\n    if cmd == \"edit\" {\n      [(module_arg, text)]\n    } else {\n      []\n    },\n    a.search,\n    a.proofs || cmd == \"add\",\n  ) {\n    Ok(_) => 0,\n    Err(_) => 1,\n  }\n}","old_text":"/// `strata edit [MODULE] [-m MSG] [--rm NAME].. [--no-commit] [--no-search]`\n/// and `strata\n/// add FILE [MODULE]`: definitions from standard input (or the file, or the\n/// editor) replace or join the package's of the same names in MODULE\n/// (default the root module). Recorded only if the whole package checks.\nfn edit_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  args: List[String],\n  cmd: String,\n) -> std.process.ExitCode {\n  if contains(args, \"--help\") || contains(args, \"-h\") {\n    mut console.write(command_usage(cmd))\n    return 0\n  }\n  // `--file F`: a script or a folder, outside any log. std's folder is\n  // edited as a package is, checked and atomic (it is built into strata).\n  mut line := args\n  mut opened: Option[Result[Opened, String]] = None\n  match [k for (k, x) in enumerate(args) where x == \"--file\"] {\n    [k, ..] => {\n      f := get(args, k + 1) ?? \"\"\n      rest := [x for (i, x) in enumerate(args) where i != k && i != k + 1]\n      if disk.is_dir(f) && package_name(disk, f) == \"std\" {\n        opened = Some(open_package_at(disk, process, f, cmd))\n        line = rest\n      } else {\n        return edit_file(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          f,\n          rest,\n          cmd,\n        )\n      }\n    },\n    [] => (),\n  }\n  timings.begin(\"edit: open\")\n  o := (opened ?? open_package(disk, process, cmd)) except {\n    return fail_with(\n      mut console,\n      \"no package here (no strata.toml in this folder or above: run `strata init`, or pass --file)\",\n    )\n  }\n  timings.end(\"edit: open\")\n  // (`--file std`: outside any log, as `--file` is: written and checked,\n  // never committed to git)\n  given_args := match edit_args(line) {\n    Ok(g) => EditArgs { ..g, commit: g.commit && opened is None },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // (`--rm NAME`: a qualified name, or a short one naming one definition,\n  // in MODULE first)\n  a := match removed_names(o.decls, if cmd == \"add\" {\n    \"\"\n  } else {\n    package_module(o.name, edit_module(given_args.module ?? \"\"))\n  }, given_args.removes) {\n    Ok(rs) => EditArgs { ..given_args, removes: rs },\n    Err(e) => return fail_with(mut console, e),\n  }\n  // `add FILE [MODULE]`: the file's text, into MODULE. For a module file or\n  // a folder of them: its definitions, in their modules.\n  if cmd == \"add\" {\n    f := a.module ?? \"\"\n    stored_defs := if disk.is_dir(f) {\n      Some(package_decls(disk, f, \"\"))\n    } else {\n      match disk.read_bytes(f) {\n        Ok(bytes) => match binary.read(bytes) {\n          Ok(img) => Some(img.decls),\n          Err(_) => None,\n        },\n        Err(e) => return fail_with(mut console, f\"{f}: {e}\"),\n      }\n    }\n    match stored_defs {\n      Some(ds) => {\n        message := if a.message == \"edit\" {\n          \"import\"\n        } else {\n          a.message\n        }\n        return match apply_edit(\n          mut console,\n          mut disk,\n          mut launcher,\n          process,\n          clock,\n          cache,\n          o,\n          ds,\n          a.removes,\n          message,\n          a.commit,\n          cmd,\n          contains(line, \"--json\"),\n          [],\n          a.search,\n          true,\n        ) {\n          Ok(_) => 0,\n          Err(_) => 1,\n        }\n      },\n      None => (),\n    }\n  }\n  (text, module_arg, message) := if cmd == \"add\" {\n    f := a.module ?? \"\"\n    t := disk.read(f) except e {\n      return fail_with(mut console, f\"{f}: {e}\")\n    }\n    (t, a.extra ?? \"\", if a.message == \"edit\" {\n      \"import\"\n    } else {\n      a.message\n    })\n  } else if contains(line, \"--editor\")\n    || console.interactive()\n      && driver_terminal(1).to_int() == 1\n      && len(a.removes) == 0 {\n    // (an editor only for someone at the terminal: standard input and output\n    // both on it, and nothing to remove)\n    return edit_in_editor(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      clock,\n      cache,\n      o,\n      a,\n    )\n  } else {\n    match piped_input(\n      mut console,\n      len(a.removes) > 0,\n      \"strata edit [MODULE]\",\n    ) {\n      Ok(t) => (t, a.module ?? \"\", a.message),\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  // (std's modules as stored: `io` is `std.io`)\n  timings.begin(\"edit: parse\")\n  edits := parse.parse_module(\n    text,\n    package_module(o.name, edit_module(module_arg)),\n  ) except e {\n    code := fail_with(mut console, f\"parse error at {e}\")\n    if cmd == \"edit\" {\n      say_kept(\n        mut console,\n        keep_rejected(mut disk, o.root, [(module_arg, text)]),\n      )\n    }\n    return code\n  }\n  timings.end(\"edit: parse\")\n  match apply_edit(\n    mut console,\n    mut disk,\n    mut launcher,\n    process,\n    clock,\n    cache,\n    o,\n    edits,\n    a.removes,\n    message,\n    a.commit,\n    cmd,\n    contains(line, \"--json\"),\n    if cmd == \"edit\" {\n      [(module_arg, text)]\n    } else {\n      []\n    },\n    a.search,\n    a.proofs || cmd == \"add\",\n  ) {\n    Ok(_) => 0,\n    Err(_) => 1,\n  }\n}"},{"name":"open_package_at","kind":"fn","old":"b5f4d90e350226c6","new":"bacbffb002887b88","interface_changed":false,"affected":[],"module":"","text":"/// `open_package` of the package around `dir`. std's modules are named as\n/// stored, `std.io` (its file `io.strata`), and std is its own context.\nfn open_package_at(\n  disk: std.fs.Disk,\n  process: std.process.Process,\n  dir: String,\n  what: String,\n) -> Result[Opened, String] {\n  root := codebase.find_root(disk, dir) or {\n    return Err(f\"`{what}` needs a package (it commits the change)\")\n  }\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  name := package_name(disk, root)\n  Ok(Opened {\n    root,\n    name,\n    decls: read_package(disk, root, if name == \"std\" {\n      \"std\"\n    } else {\n      \"\"\n    })!,\n    std: if name == \"std\" {\n      []\n    } else {\n      module_decls(disk, deps.module_files(disk, std_dir).map(\n        rel -> std_dir + \"/\" + rel,\n      ))\n    },\n    std_dir,\n    core: read_core_at(disk, home),\n    open: pending.parse_pending(disk.read(pending.file_of(root)) !! \"\"),\n  })\n}","old_text":"/// `open_package` of the package around `dir`. std's modules are named as\n/// stored, `std.io` (its file `io.strata`), and std is its own context.\nfn open_package_at(\n  disk: std.fs.Disk,\n  process: std.process.Process,\n  dir: String,\n  what: String,\n) -> Result[Opened, String] {\n  root := codebase.find_root(disk, dir) or {\n    return Err(f\"`{what}` needs a package (it commits the change)\")\n  }\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  name := package_name(disk, root)\n  Ok(Opened {\n    root,\n    name,\n    decls: package_decls(disk, root, if name == \"std\" {\n      \"std\"\n    } else {\n      \"\"\n    }),\n    std: if name == \"std\" {\n      []\n    } else {\n      module_decls(disk, deps.module_files(disk, std_dir).map(\n        rel -> std_dir + \"/\" + rel,\n      ))\n    },\n    std_dir,\n    core: read_core_at(disk, home),\n    open: pending.parse_pending(disk.read(pending.file_of(root)) !! \"\"),\n  })\n}"},{"name":"edit_file","kind":"fn","old":"2e6b8cf2c67be760","new":"7583bbf29ebc15d6","interface_changed":false,"affected":[],"module":"","text":"/// `strata --file F edit [MODULE]` (or `add`): a script, or a folder's\n/// module, changed outside any log (created if new). The result is checked,\n/// then written, each file in one step (`codebase.write_file`): what\n/// doesn't check is rejected with its errors and exit code 1, and no file\n/// changes (with `--as-given`, for a script written in steps: written all\n/// the same, with its errors and exit code 1). A module file of a package\n/// isn't checked alone. The functions changed that have loops then get the\n/// invariants\n/// a search finds, as `apply_edit` does.\nfn edit_file(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  f: String,\n  args: List[String],\n  cmd: String,\n) -> std.process.ExitCode {\n  a := edit_args(args) except e { return fail_with(mut console, e) }\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  core := read_core_at(disk, home)\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  is_dir := disk.is_dir(f) || ends_with(f, \"/\")\n  path := if ends_with(f, \"/\") {\n    byte_slice(f, 0, byte_len(f) - 1)\n  } else {\n    f\n  }\n  // a module file in a package is the module its path names\n  root := if is_dir {\n    None\n  } else {\n    codebase.find_root(disk, if codebase.parent(path) == \"\" {\n      \".\"\n    } else {\n      codebase.parent(path)\n    })\n  }\n  in_package := match root {\n    Some(r) => {\n      prefix := r + \"/\"\n      rel := if starts_with(path, prefix) {\n        byte_slice(path, byte_len(prefix), byte_len(path))\n      } else {\n        path\n      }\n      Some(deps.module_name(module_prefix(disk, r), rel))\n    },\n    None => None,\n  }\n  // core's folder: its modules by their names (`core.gen`), its files by\n  // theirs (`gen.strata`)\n  in_core := is_dir && disk.exists(path) && package_name(disk, path) == \"core\"\n  old := if !disk.exists(path) {\n    []\n  } else if is_dir {\n    read_package(disk, path, if in_core {\n      \"core\"\n    } else {\n      \"\"\n    }) except e { return fail_with(mut console, e) }\n  } else {\n    read_module(disk, path) except e {\n      return fail_with(mut console, e)\n    }\n  }\n  module := in_package or {\n    if in_core {\n      m := edit_module(a.module ?? \"\")\n      if starts_with(m, \"core.\") || m == \"\" {\n        m\n      } else {\n        \"core.\" + m\n      }\n    } else if is_dir {\n      edit_module(a.module ?? \"\")\n    } else {\n      match old {\n        [d, ..] => d.module,\n        [] => \"\",\n      }\n    }\n  }\n  // (`--rm NAME`: a qualified name, or a short one naming one definition)\n  given_removes := removed_names(old, module, a.removes) except e {\n    return fail_with(mut console, e)\n  }\n  text := if cmd == \"add\" {\n    disk.read(a.module ?? \"\") !! \"\"\n  } else {\n    piped_input(\n      mut console,\n      len(given_removes) > 0,\n      \"strata --file F edit\",\n    ) except e { return fail_with(mut console, e) }\n  }\n  parsed := parse.parse_module(text, module) except e {\n    return fail_with(mut console, f\"parse error at {e}\")\n  }\n  // (text read back from a view: the proof material it hid is put back)\n  edits := if a.proofs || cmd == \"add\" {\n    parsed\n  } else {\n    (kept, notes) := views.proofs_kept(resolve.written(old, std, core), parsed)\n    for n in notes {\n      mut console.eprint(\"warning: \" + n)\n    }\n    kept\n  }\n  match both_given_and_removed(edits, given_removes) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  // (a declaration given drops its stored derives that are no longer on its\n  // `derive A, B for` line)\n  dropped := codebase.dropped_derives(old, edits).filter(\n    q -> !contains(given_removes, q),\n  )\n  removes := given_removes + dropped\n  // (a package's other modules, for its references)\n  others := match root {\n    Some(r) => (read_package(disk, r, \"\") except e {\n      return fail_with(mut console, e)\n    }).filter(\n      d -> d.module != module,\n    ),\n    None => [],\n  }\n  // (core's files keep their names as written: core's names are global)\n  of_core := in_core\n    || match root {\n      Some(r) => package_name(disk, r) == \"core\",\n      None => false,\n    }\n  new := if of_core {\n    codebase.merge_parsed(old, edits, removes)\n  } else {\n    codebase.merge(old, edits, removes, std + others, core)\n  }\n  if new == old && disk.exists(path) {\n    // every definition given is as stored: nothing written or checked\n    mut console.print(\n      f\"{f}: no changes: every definition given is as stored (nothing written or checked)\",\n    )\n    return 0\n  }\n  // checked before anything is written: an edit that doesn't check\n  // leaves every file as it was (core checks only as the runtime's\n  // compilation does, `strata build-core`; a module file of a package\n  // isn't checked alone, its neighbours may not be written yet)\n  alone := !of_core\n    && in_package is None\n    && (is_dir || new.all(d -> d.module == \"\"))\n  errors := if alone {\n    lib := std_imports(disk, std_dir, new)\n    sh := shared_at(disk, cache.caches_of(process), home_of_std(std_dir))\n    // (`comptime e` compiled, as `check` runs it, with its budget of steps: a\n    // runaway one is an error instead of a hang)\n    std_use_check(\n        disk,\n        std_dir,\n        new,\n        use_errors_of(new, lib, Set[String] {}, core),\n      )\n      + warned(mut console, check_errors_with(\n        new,\n        lib,\n        core,\n        is_dir && package_reads_values(disk, path),\n        comptime_runner(disk, sh),\n      ))\n      + literal_errors_of(disk, new, lib, core, path, sh, [])\n  } else {\n    []\n  }\n  n := len(errors)\n  if n > 0 && !a.as_given {\n    mut console.eprint(\n      f\"rejected: {f} doesn't check ({n} error{plural(n, \"\", \"s\")}; nothing was written; `--as-given` writes it all the same):\",\n    )\n    for l in errors {\n      mut console.eprint(\"  \" + error_text(l))\n    }\n    return 1\n  }\n  if is_dir {\n    match codebase.write_modules(mut disk, path, old, new, false) {\n      Err(e) => return fail_with(mut console, e),\n      Ok(_) => (),\n    }\n  } else {\n    if codebase.parent(path) != \"\" {\n      mut disk.make_dir(codebase.parent(path)) !! ()\n    }\n    // (the definitions that didn't change keep their stored bytes)\n    bytes := codebase.module_bytes(\n      disk.read_bytes(path) !! [],\n      module,\n      new,\n      old,\n      others + new,\n      false,\n      Dict[String, ast.Key] {},\n    )\n    match codebase.write_file(mut disk, path, bytes) {\n      Err(e) => return fail_with(mut console, e),\n      Ok(_) => (),\n    }\n  }\n  cs := codebase.changes(old, new, false)\n  mut console.print(\n    f\"{f}: {len(cs)} definition{plural(len(cs), \"\", \"s\")} changed, {len(new)} in all\",\n  )\n  for q in dropped.filter(q -> !new.any(d -> store.qname(d) == q)) {\n    mut console.print(dropped_warning(q))\n  }\n  for w in edit_warnings(new, cs.map(c -> c.name), core) {\n    mut console.print(w)\n  }\n  if !of_core {\n    roots := unused_setting(disk, root ?? path).0\n    for w in edit_unused(\n      old + others,\n      new + others,\n      cs.map(c -> c.name),\n      core,\n      roots,\n    ) {\n      mut console.print(w.2)\n    }\n  }\n  if n > 0 {\n    mut console.eprint(\n      f\"written as given: {f} doesn't check ({n} error{plural(n, \"\", \"s\")}):\",\n    )\n    for l in errors {\n      mut console.eprint(\"  \" + error_text(l))\n    }\n    return 1\n  }\n  // the loops of the functions changed: invariants searched for where\n  // those derived from the code don't prove their checks, and written\n  looped := loop_functions(new, cs.map(c -> c.name))\n  if a.search && looped != [] && !of_core {\n    _ := search_invariants(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      cache.caches_of(process),\n      path,\n      looped,\n      \"edit\",\n      false,\n    )\n  }\n  0\n}","old_text":"/// `strata --file F edit [MODULE]` (or `add`): a script, or 