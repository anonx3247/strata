"/// The type a constructor makes, its type parameters unknown, if it is one.\nfn dyn_type_of(g: codegen.Gen, c: String) -> Option[Ty] {\n  match get(g.types.ctors, c) {\n    Some(sh) => Some(TNamed { name: sh.owner, args: sh.params.map(_ -> TAny) }),\n    None => None,\n  }\n}"},{"name":"codegen.dyn_table_is","kind":"fn","old":"8e1d5683cf9a0639","new":"55c86a095cc575e1","interface_changed":true,"affected":["codegen.dyn_ctor_is","codegen.dyn_generic_call","codegen.matching_v","codegen.tag_is","codegen.dyn_call","codegen.matching_want","codegen.entry","codegen.matches","codegen.options","codegen.to_c","codegen.check_payload","codegen.try_want","codegen.or_else","codegen.expr_node","codegen.has_field_check","codegen.call_named","codegen.method_call","codegen.clock_now","codegen.matching","codegen.expr_want_node","codegen.generate","codegen.destructure","codegen.binds","codegen.for_loop","codegen.match_got","codegen.main_arg","codegen.foreign_call","codegen.export_entry","codegen.check_type","codegen.try_expr","codegen.except_expr","codegen.expr","codegen.get_field","codegen.select_expr","codegen.expr_want","codegen_with","core_rt_text","computed_value","repl_eval","codegen.stmt_node","codegen.function","codegen.declare","codegen.call_fn_want","codegen.construct_want","codegen.check_field","codegen.assign_at","codegen.lambda_shown","codegen.set_in_place","codegen.checked_update","codegen.interp","codegen.binary","codegen.logic","codegen.loop_body","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.await_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.operands_want","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.tag_test","codegen.update_in_place","codegen.take_in_place","codegen.compared","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.push_in_place","codegen.expr_on_stack","codegen.ass