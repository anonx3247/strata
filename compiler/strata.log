ommand","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// A type in IR. `()` is `void`: it has no value.\nfn ll(t: check.Ty) -> String {\n  match codegen.sized(t) {\n    Some(w) => return \"i\" + to_string(codegen.word_bits(w)),\n    None => (),\n  }\n  match t {\n    check.TInt => \"i64\",\n    check.TFloat => \"double\",\n    check.TBool => \"i1\",\n    check.TStr | check.TNamed { .. } | check.TList(_) | check.TFn { .. } | check.TTrait(_) | check.TUnion(_) => \"ptr\",\n    _ => \"void\",\n  }\n}","old_text":"/// A type in IR. `()` is `void`: it has no value.\nfn ll(t: Ty) -> String {\n  match codegen.sized(t) {\n    Some(w) => return \"i\" + to_string(codegen.word_bits(w)),\n    None => (),\n  }\n  match t {\n    TInt => \"i64\",\n    TFloat => \"double\",\n    TBool => \"i1\",\n    TStr | TNamed { .. } | TList(_) | TFn { .. } | TTrait(_) | TUnion(_) => \"ptr\",\n    _ => \"void\",\n  }\n}"},{"name":"codegen.has_value","kind":"fn","old":"f3d9729b968a03b8","new":"29de1b4e61966e32","interface_changed":true,"affected":["codegen.local","codegen.store","codegen.load","codegen.function","codegen.join_values","codegen.call_at","codegen.call_closure","codegen.order_closure","codegen.cmp_helper","codegen.differ","codegen.call_fn_want","codegen.dyn_wrapper","codegen.union_cmp","codegen.unwound_exit","codegen.call_bare","codegen.await_one","codegen.race_expr","codegen.gen_fn","codegen.mock_method","codegen.trace_enter","codegen.trace_leave","codegen.declaration_of","codegen.lambda_shown","codegen.args_of","codegen.hash_helper","codegen.local_value","codegen.give_result","codegen.result_phi","codegen.compare_values","codegen.build_fn","codegen.share_fn","codegen.call_words","codegen.bind","codegen.local_owned","codegen.iterate","codegen.narrowed_var","codegen.entry","codegen.dyn_call","codegen.store_var","codegen.built_or_generated","codegen.session_entry","codegen.call_named","codegen.drop_scope","codegen.method_ca