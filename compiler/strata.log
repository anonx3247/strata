 := if g.by_words {\n    codegen.words_ll(codegen.small_words(g, t))\n  } else {\n    codegen.ll(t)\n  }\n  if g.rets == [] {\n    codegen.emit(mut g, f\"%result = freeze {lt} poison\")\n  } else {\n    ins := join(g.rets.map(r -> f\"[ {r.0}, %{r.1} ]\"), \", \")\n    codegen.emit(mut g, f\"%result = phi {lt} {ins}\")\n  }\n  codegen.V { ty: t, op: \"%result\" }\n}","old_text":"/// `%result` in the exit block: the result each exit gave. With no exit\n/// reaching it, the block is unreachable. In a function giving words\n/// (`by_words`), the words.\nfn result_phi(mut g: codegen.Gen, t: Ty) -> codegen.V {\n  if !codegen.has_value(t) {\n    return codegen.V { ty: t, op: \"\" }\n  }\n  lt := if g.by_words {\n    codegen.words_ll(codegen.small_words(g, t))\n  } else {\n    codegen.ll(t)\n  }\n  if g.rets == [] {\n    codegen.emit(mut g, f\"%result = freeze {lt} poison\")\n  } else {\n    ins := join(g.rets.map(r -> f\"[ {r.0}, %{r.1} ]\"), \", \")\n    codegen.emit(mut g, f\"%result = phi {lt} {ins}\")\n  }\n  codegen.V { ty: t, op: \"%result\" }\n}"},{"name":"codegen.clone_fn","kind":"fn","old":"e97fe4b303a3d2a7","new":"cc65442ec5b6051e","interface_changed":true,"affected":["codegen.set_path","codegen.union_set","codegen.assign_at","codegen.set_field_in_place","codegen.call_fn_want","codegen.method_call","codegen.dyn_call","codegen.stmt_node","codegen.call_named","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.expr_node","codegen.expr_want_node","codegen.stmt","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.builtin_call","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.main_arg","codegen.select_expr","codegen.expr","codegen.expr_want","codegen.block_expr","codegen.iterate","codegen.decreases_start","codegen.decreases_pass","codegen.decreases_entry","codegen.decreases_call","codege