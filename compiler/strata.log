                 for f in fs {\n                    mut fields.push(\n                      derive.field(\n                        mut x,\n                        f.name,\n                        f.doc,\n                        derive.subst(f.ty, sub),\n                        f.default,\n                        mut stack,\n                      ),\n                    )\n                  }\n                }\n                \"Record\"\n              },\n              // a sum: a union of the members it declares\n              ast.SumBody(vs) => {\n                if !shallow {\n                  for v in vs {\n                    mut members.push(\n                      derive.variant_value(\n                        mut x,\n                        n,\n                        v,\n                        targs,\n                        sub,\n                        mut stack,\n                      ),\n                    )\n                  }\n                }\n                \"Union\"\n              },\n              // an alias or a `distinct` type: what it stands for, under\n              // its own name\n              ast.Alias(a) => {\n                whole := match td.refinement {\n                  Some(r) => ast.Refined {\n                    base: derive.subst(a, sub),\n                    pred: r,\n                  },\n                  None => derive.subst(a, sub),\n                }\n                mut v := derive.type_value_in(mut x, whole, mut stack)\n                stack = take(stack, len(stack) - 1)\n                // `base`: what it stands for, under that type's name (`Int`)\n                v = derive.set_field(v, \"base\", derive.some(v))\n                v = derive.set_field(\n                  v,\n                  \"name\",\n                  derive.some(ast.StrLit(derive.short(n))),\n                )\n                v = derive.set_field(v, \"doc\", derive.strs(doc))\n                v = derive.set_field(v, \"args\", ast.ListExpr(arg