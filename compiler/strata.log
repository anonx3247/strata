answered","strata_command","build_command","run_command","main","apply_edit","edit_file","fix_loops","graph_command","graph_diff","verified_decls","termination_file","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","edit_command","edit_in_editor","repl_command","fix_command","diff_command","verified_with","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","verified_program","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","check_command","program_objects","comptime_values","call_command","loaded_errors","file_errors","edit_errors","linked","expanded","comptime_runner","package_errors","check_files","apply_change","with_base","rename_command","move_command"],"module":"smt","text":"/// The state of the symbolic run of one function.\npub type Vc = {\n  // the functions and types of the program, std and core, by the names\n  // code uses, and the builtins' signatures\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  builtins: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  // each sum type's variants, with the type's name\n  parents: Dict[String, String],\n  // each constructor, with its type's name\n  ctors: Dict[String, String],\n  consts: List[smt.Const],\n  next_var: Int,\n  facts: List[String],\n  // facts that hold on every path (what a term's type gives)\n  defs: List[String],\n  // why each unknown was made (something not modelled)\n  reasons: Dict[String, String],\n  reason: Option[String],\n  pc: List[String],\n  scopes: List[Dict[String, smt.Val]],\n  obligations: List[smt.Obligation],\n  // obligations true for all values: proven without a query\n  given: List[String],\n  // inside a contract or refinement: no obligations are made there\n  spec: Int,\n  proving: Int,\n  dead: Bool,\n  depth: Int,\n  returns: List[smt.Exit],\n  memo: Dict[String, smt.Val],\n  bit_terms: Dict[String, String],\n  // the types variables were declared with, which hold after each\n  // assignment\n  declared: Dict[String, List[ast.TypeExpr]],\n  params: List[(String, smt.Val)],\n  // the sorts, in the order met, by name\n  sorts: List[(String, smt.SortDef)],\n  sort_index: Dict[String, Int],\n  // the validity predicates (name, sort), by type and sort\n  valid: List[(String, String)],\n  valid_index: Dict[String, Int],\n  // the validity predicates defined, and the terms unfolded\n  defined: Set[String],\n  unfolded: Dict[String, smt.Val],\n  // strings read from datatype values, named in the queries\n  str_terms: List[String],\n  // the types being checked (a recursive one is checked to a fixed depth)\n  checking: List[String],\n  cutoffs: Dict[String, String],\n  // the lists, by id\n  lists: List[smt.ListInfo],\n  // open scopes (a quantified fact, a template): where the unknowns and\n  // facts made inside them start\n  regions: List[(Int, Int)],\n  // the positions new unknowns are functions of (a list's template)\n  indexing: Option[List[String]],\n  // the quantifier nesting, and the quantified variables made\n  binding: Int,\n  qvars: Int,\n  // the unknowns a quantifier binds\n  bound: Set[String],\n  // nesting depth of lists compared by position\n  eq_depth: Int,\n  // the functions passed to the call being made, by argument\n  fn_args: List[Option[smt.Func]],\n  // the `break`s and `continue`s of the loops being run, innermost last\n  breaks: List[List[smt.Jump]],\n  continues: List[List[smt.Jump]],\n  // inside a trial pass of a loop: inner loops infer nothing\n  trial: Int,\n  // in a trial pass, the values callees wrote back to `mut` arguments of a\n  // type without refinements: any value of the type, nothing known\n  wiped: List[smt.Val],\n  // candidate invariants: the `ensures` of the returned variable, and the\n  // `requires`\n  hints: List[(ast.Expr, String)],\n  requires_hints: List[ast.Expr],\n  // the solver's answers from earlier runs, by query, and the queries\n  // this run still needs\n  answers: Dict[String, String],\n  pending: List[String],\n  // the strings tested against regular expressions: the string, the\n  // pattern, its Bool, and whether it is approximated\n  matched: List[(String, String, String, Bool)],\n  // what this function uses that smt doesn't model\n  gaps: List[String],\n  // for the termination check: the function's own name (a call of it is\n  // recursion), its `while` loops, its recursive calls (path and\n  // arguments), their obligations (kept apart), and the type of each\n  // non-list value a `for` runs over (`\"\"` when not known)\n  self_name: String,\n  loops: List[smt.LoopInfo],\n  rec_sites: List[(List[String], List[smt.Val])],\n  term_obs: List[smt.Obligation],\n  iter_fors: List[String],\n  // for `verify`'s report: the loop invariants inferred, and the functions\n  // seen through whose finishing is only assumed (`terminates`)\n  invariants: List[String],\n  relied_on: Set[String],\n  // `verify`'s counterexamples (`Methods.examples`): each list parameter's\n  // first elements (`input_elems`). Their facts and terms are set aside for\n  // a second query when a model can't be shown without them.\n  examples: Bool,\n  example_facts: List[String],\n  example_leaves: List[String],\n  input_elems: Dict[Int, List[smt.Val]],\n  input_depth: Int,\n  // a running solver (c/solver.c) that `ask` sends each question to as it\n  // comes, waiting for the answer, so the function is run once. With `\"\"`\n  // the questions stay pending and the run is repeated once answered.\n  live: String,\n  // the function's own `while` loops (`while_loops`), to tell them from\n  // those of callees seen through\n  own_whiles: List[(ast.Expr, ast.Expr)],\n  // the cost of the loop-invariant searches (solver resource units and\n  // microseconds, from their answers), and whether one was refused because\n  // the run's search budget was used up\n  search_units: Int,\n  search_micros: Int,\n  search_cut: Bool,\n  // inside a loop with written invariants: inference asks only at a\n  // proof's limit, and gives up at the first unanswered question\n  cheap: Int,\n  // for `verify` to write: each own `while` loop's inferred invariants and\n  // their cost\n  found_loops: List[smt.LoopFound],\n  // the `mut` parameters of the function. Its `ensures` name their values\n  // at each exit; `old x` is the starting value.\n  mut_params: List[String] = [],\n  // in an `ensures`: what `old e` reads (the values at the function's\n  // start, or the arguments before a call)\n  olds: Option[Dict[String, smt.Val]] = None,\n  // after a call seen through its contract: the `mut` parameters' values\n  // it leaves (`write_after` writes them back)\n  after: List[smt.Val] = [],\n  // the dicts and sets among the lists, by id, with their types. An\n  // input's is shown as a dict or set (`literal_of`).\n  keyed: Dict[Int, ast.TypeExpr],\n  // dict and set entries by list id: an SMT array from each key to an\n  // `Option` of its value (dict) or a Bool (set). Its size is a function\n  // of the array (`map_sorts`).\n  arrays: Dict[Int, String],\n  // the type a `let` gives the dict or set literal bound to it, so `set`\n  // and `dict` make an array of that type\n  want: Option[(ast.Expr, ast.TypeExpr)],\n  // in a loop's written invariant: calls are seen through as in a contract\n  see: Int = 0,\n  // inside a contract or refinement (`pred_old`)\n  contract: Int = 0,\n  // inside a fact made of two lists' elements known equal\n  in_same: Int = 0,\n  // the lists whose facts about every element are being given to one of\n  // them (`known_of`): a fact about a list's elements that takes another\n  // element of it (`!contains(xs, x)`) is not given again to that one\n  knowing: List[Int] = [],\n  // comparing two lists the code compares (`binary`)\n  list_eq: Int = 0,\n  // the prefix-sum functions of lists (`prefix_sum`), by list and function\n  sum_fns: Dict[String, String] = Dict[String, String] {},\n  // those of `sum_fns` of a list through a function: the list, the\n  // function and the prefix-sum function (for `for_element`)\n  mapped_sums: List[(Int, smt.Func, String)] = [],\n  // the lengths of the lists whose first elements are in `input_elems`\n  input_lens: Dict[Int, String] = Dict[Int, String] {},\n  // the recursive functions unfolded in contracts, as SMT functions: by\n  // symbol, their argument sorts and result sort (`rec_call`)\n  rec_fns: Dict[String, (List[String], String)] = Dict[String, (List[String], String)] {},\n  // nesting depth of unfolding them\n  unfolding: Int = 0,\n  // making a definition (`define_fn`): no unknown may be made\n  defining: Int = 0,\n  // the orders of values of a sort `compare` uses (the order unknown: a\n  // function of the two values), with their sorts\n  orders: List[(String, String)] = [],\n  // the functions contracts see through, each defined once (`def_call`):\n  // its symbol and its `define-fun` (or `define-fun-rec`), each after those\n  // it uses; by function and argument sorts, its symbol (`\"\"`: it has no\n  // definition, its body not being one term of its parameters)\n  fun_defs: List[(String, String)] = [],\n  def_index: Dict[String, String] = Dict[String, String] {},\n  // the definitions' parameters and recursive calls, by key (`def_call`);\n  // in a definition being made, the recursive calls met; the uses of\n  // recursive functions stated, by levels and application (`rec_use`)\n  def_info: Dict[String, smt.DefInfo] = Dict[String, smt.DefInfo] {},\n  calls: List[(String, List[String])] = [],\n  rec_stated: Set[String] = Set[String] {},\n  // nesting depth of comparing two datatype terms of different sorts\n  data_eq: Int = 0,\n  // uninterpreted functions of a receiver, standing for pure methods seen\n  // only through their contracts (a trait model, `self.total()`): name,\n  // receiver sort, result sort (`receiver_term`)\n  of_receiver: List[(String, String, String)] = [],\n  // the polarity of the Bool being made, read by `eval`:\n  // 1: only ever assumed true (a fact of every position, inside `all`);\n  // -1: only ever proven (inside `every`);\n  // 0: either.\n  // `all` makes only the direction it needs, so a quantifier is never\n  // nested in another (`all_of`).\n  polarity: Int = 0,\n  // the polarity of the call being made (`call`, `builtin` read it)\n  call_pol: Int = 0,\n  // how many seen-through bodies (in a contract) the run is in. There a\n  // refined constructor that may fail is a value only where it doesn't\n  // (`ctor`).\n  through: Int = 0,\n  // what holds of every entry of a dict (`all(d.items(), f)` assumed), the\n  // keys read in dicts' arrays, and whether such a fact is being stated\n  // (`map_instance` does not recurse)\n  map_alls: List[smt.MapAll] = [],\n  map_reads: List[smt.MapRead] = [],\n  map_inst: Int = 0,\n  // each array made by a store, with the array it was stored into\n  map_from: Dict[String, String] = Dict[String, String] {},\n  // the facts in `defs`, to make each once\n  def_set: Set[String] = Set[String] {},\n  // each `for`'s list, by the name its index loop binds it to (`for_loop`)\n  for_lists: Dict[String, ast.Expr] = Dict[String, ast.Expr] {},\n  // the variable the body ends with, and the result's type\n  returned: Option[(String, ast.TypeExpr)] = None,\n  // the obligations made before each loop whose invariant search was left\n  // out (`Methods.search` 0): a check failing after one of them asks for\n  // the search (compiler `verify`)\n  skipped: List[Int] = [],\n  // `unique` of each list asked, by its id: the same list, the same answer\n  uniques: Dict[Int, String] = Dict[Int, String] {},\n  // those loops, with where their checks are (for `verify` to say which\n  // loop a check failing after one of them may need an invariant of)\n  skipped_loops: List[smt.SkippedLoop] = [],\n  // the expression the body ends with, as shown (what its `ensures` are\n  // about, for `verify` to name)\n  result_text: String = \"\",\n}","old_text":"/// The state of the symbolic run of one function.\npub type Vc = {\n  // the functions and types of the program, std and core, by the names\n  // code uses, and the builtins' signatures\n  fns: Dict[String, ast.FnDecl],\n  types: Dict[String, ast.TypeDecl],\n  builtins: List[smt.BuiltinSig],\n  methods: smt.Methods,\n  // each sum type's variants, with the type's name\n  parents: Dict[String, String],\n  // each constructor, with its type's name\n  ctors: Dict[String, String],\n  consts: List[smt.Const],\n  next_var: Int,\n  facts: List[String],\n  // facts that hold on every path (what a term's type gives)\n  defs: List[String],\n  // why each unknown was made (something not modelled)\n  reasons: Dict[String, String],\n  reason: Option[String],\n  pc: List[String],\n  scopes: List[Dict[String, smt.Val]],\n  obligations: List[smt.Obligation],\n  // obligations true for all values: proven without a query\n  given: List[String],\n  // inside a contract or refinement: no obligations are made there\n  spec: Int,\n  proving: Int,\n  dead: Bool,\n  depth: Int,\n  returns: List[smt.Exit],\n  memo: Dict[String, smt.Val],\n  bit_terms: Dict[String, String],\n  // the types variables were declared with, which hold after each\n  // assignment\n  declared: Dict[String, List[ast.TypeExpr]],\n  params: List[(String, smt.Val)],\n  // the sorts, in the order met, by name\n  sorts: List[(String, smt.SortDef)],\n  sort_index: Dict[String, Int],\n  // the validity predicates (name, sort), by type and sort\n  valid: List[(String, String)],\n  valid_index: Dict[String, Int],\n  // the validity predicates defined, and the terms unfolded\n  defined: Set[String],\n  unfolded: Dict[String, smt.Val],\n  // strings read from datatype values, named in the queries\n  str_terms: List[String],\n  // the types being checked (a recursive one is checked to a fixed depth)\n  checking: List[String],\n  cutoffs: Dict[String, String],\n  // the lists, by id\n  lists: List[smt.ListInfo],\n  // open scopes (a quantified fact, a template): where the unknowns and\n  // facts made inside them start\n  regions: List[(Int, Int)],\n  // the positions new unknowns are functions of (a list's template)\n  indexing: Option[List[String]],\n  // the quantifier nesting, and the quantified variables made\n  binding: Int,\n  qvars: Int,\n  // the unknowns a quantifier binds\n  bound: Set[String],\n  // nesting depth of lists compared by position\n  eq_depth: Int,\n  // the functions passed to the call being made, by argument\n  fn_args: List[Option[smt.Func]],\n  // the `break`s and `continue`s of the loops being run, innermost last\n  breaks: List[List[smt.Jump]],\n  continues: List[List[smt.Jump]],\n  // inside a trial pass of a loop: inner loops infer nothing\n  trial: Int,\n  // in a trial pass, the values callees wrote back to `mut` arguments of a\n  // type without refinements: any value of the type, nothing known\n  wiped: List[smt.Val],\n  // candidate invariants: the `ensures` of the returned variable, and the\n  // `requires`\n  hints: List[(ast.Expr, String)],\n  requires_hints: List[ast.Expr],\n  // the solver's answers from earlier runs, by query, and the queries\n  // this run still needs\n  answers: Dict[String, String],\n  pending: List[String],\n  // the strings tested against regular expressions: the string, the\n  // pattern, its Bool, and whether it is approximated\n  matched: List[(String, String, String, Bool)],\n  // what this function uses that smt doesn't model\n  gaps: List[String],\n  // for the termination check: the function's own name (a call of it is\n  // recursion), its `while` loops, its recursive calls (path and\n  // arguments), their obligations (kept apart), and the type of each\n  // non-list value a `for` runs over (`\"\"` when not known)\n  self_name: String,\n  loops: List[smt.LoopInfo],\n  rec_sites: List[(List[String], List[smt.Val])],\n  term_obs: List[smt.Obligation],\n  iter_fors: List[String],\n  // for `verify`'s report: the loop invariants inferred, and the functions\n  // seen through whose finishing is only assumed (`terminates`)\n  invariants: List[String],\n  relied_on: Set[String],\n  // `verify`'s counterexamples (`Methods.examples`): each list parameter's\n  // first elements (`input_elems`). Their facts and terms are set aside for\n  // a second query when a model can't be shown without them.\n  examples: Bool,\n  example_facts: List[String],\n  example_leaves: List[String],\n  input_elems: Dict[Int, List[smt.Val]],\n  input_depth: Int,\n  // a running solver (c/solver.c) that `ask` sends each question to as it\n  // comes, waiting for the answer, so the function is run once. With `\"\"`\n  // the questions stay pending and the run is repeated once answered.\n  live: String,\n  // the function's own `while` loops (`while_loops`), to tell them from\n  // those of callees seen through\n  own_whiles: List[(ast.Expr, ast.Expr)],\n  // the cost of the loop-invariant searches (solver resource units and\n  // microseconds, from their answers), and whether one was refused because\n  // the run's search budget was used up\n  search_units: Int,\n  search_micros: Int,\n  search_cut: Bool,\n  // inside a loop with written invariants: inference asks only at a\n  // proof's limit, and gives up at the first unanswered question\n  cheap: Int,\n  // for `verify` to write: each own `while` loop's inferred invariants and\n  // their cost\n  found_loops: List[smt.LoopFound],\n  // the `mut` parameters of the function. Its `ensures` name their values\n  // at each exit; `old x` is the starting value.\n  mut_params: List[String] = [],\n  // in an `ensures`: what `old e` reads (the values at the function's\n  // start, or the arguments before a call)\n  olds: Option[Dict[String, smt.Val]] = None,\n  // after a call seen through its contract: the `mut` parameters' values\n  // it leaves (`write_after` writes them back)\n  after: List[smt.Val] = [],\n  // the dicts and sets among the lists, by id, with their types. An\n  // input's is shown as a dict or set (`literal_of`).\n  keyed: Dict[Int, ast.TypeExpr],\n  // dict and set entries by list id: an SMT array from each key to an\n  // `Option` of its value (dict) or a Bool (set). Its size is a function\n  // of the array (`map_sorts`).\n  arrays: Dict[Int, String],\n  // the type a `let` gives the dict or set literal bound to it, so `set`\n  // and `dict` make an array of that type\n  want: Option[(ast.Expr, ast.TypeExpr)],\n  // in a loop's written invariant: calls are seen through as in a contract\n  see: Int = 0,\n  // inside a fact made of two lists' elements known equal\n  in_same: Int = 0,\n  // the lists whose facts about every element are being given to one of\n  // them (`known_of`): a fact about a list's elements that takes another\n  // element of it (`!contains(xs, x)`) is not given again to that one\n  knowing: List[Int] = [],\n  // comparing two lists the code compares (`binary`)\n  list_eq: Int = 0,\n  // the prefix-sum functions of lists (`prefix_sum`), by list and function\n  sum_fns: Dict[String, String] = Dict[String, String] {},\n  // those of `sum_fns` of a list through a function: the list, the\n  // function and the prefix-sum function (for `for_element`)\n  mapped_sums: List[(Int, smt.Func, String)] = [],\n  // the lengths of the lists whose first elements are in `input_elems`\n  input_lens: Dict[Int, String] = Dict[Int, String] {},\n  // the recursive functions unfolded in contracts, as SMT functions: by\n  // symbol, their argument sorts and result sort (`rec_call`)\n  rec_fns: Dict[String, (List[String], String)] = Dict[String, (List[String], String)] {},\n  // nesting depth of unfolding them\n  unfolding: Int = 0,\n  // making a definition (`define_fn`): no unknown may be made\n  defining: Int = 0,\n  // the orders of values of a sort `compare` uses (the order unknown: a\n  // function of the two values), with their sorts\n  orders: List[(String, String)] = [],\n  // the functions contracts see through, each defined once (`def_call`):\n  // its symbol and its `define-fun` (or `define-fun-rec`), each after those\n  // it uses; by function and argument sorts, its symbol (`\"\"`: it has no\n  // definition, its body not being one term of its parameters)\n  fun_defs: List[(String, String)] = [],\n  def_index: Dict[String, String] = Dict[String, String] {},\n  // the definitions' parameters and recursive calls, by key (`def_call`);\n  // in a definition being made, the recursive calls met; the uses of\n  // recursive functions stated, by levels and application (`rec_use`)\n  def_info: Dict[String, smt.DefInfo] = Dict[String, smt.DefInfo] {},\n  calls: List[(String, List[String])] = [],\n  rec_stated: Set[String] = Set[String] {},\n  // nesting depth of comparing two datatype terms of different sorts\n  data_eq: Int = 0,\n  // uninterpreted functions of a receiver, standing for pure methods seen\n  // only through their contracts (a trait model, `self.total()`): name,\n  // receiver sort, result sort (`receiver_term`)\n  of_receiver: List[(String, String, String)] = [],\n  // the polarity of the Bool being made, read by `eval`:\n  // 1: only ever assumed true (a fact of every position, inside `all`);\n  // -1: only ever proven (inside `every`);\n  // 0: either.\n  // `all` makes only the direction it needs, so a quantifier is never\n  // nested in another (`all_of`).\n  polarity: Int = 0,\n  // the polarity of the call being made (`call`, `builtin` read it)\n  call_pol: Int = 0,\n  // how many seen-through bodies (in a contract) the run is in. There a\n  // refined constructor that may fail is a value only where it doesn't\n  // (`ctor`).\n  through: Int = 0,\n  // what holds of every entry of a dict (`all(d.items(), f)` assumed), the\n  // keys read in dicts' arrays, and whether such a fact is being stated\n  // (`map_instance` does not recurse)\n  map_alls: List[smt.MapAll] = [],\n  map_reads: List[smt.MapRead] = [],\n  map_inst: Int = 0,\n  // each array made by a store, with the array it was stored into\n  map_from: Dict[String, String] = Dict[String, String] {},\n  // the facts in `defs`, to make each once\n  def_set: Set[String] = Set[String] {},\n  // each `for`'s list, by the name its index loop binds it to (`for_loop`)\n  for_lists: Dict[String, ast.Expr] = Dict[String, ast.Expr] {},\n  // the variable the body ends with, and the result's type\n  returned: Option[(String, ast.TypeExpr)] = None,\n  // the obligations made before each loop whose invariant search was left\n  // out (`Methods.search` 0): a check failing after one of them asks for\n  // the search (compiler `verify`)\n  skipped: List[Int] = [],\n  // `unique` of each list asked, by its id: the same list, the same answer\n  uniques: Dict[Int, String] = Dict[Int, String] {},\n  // those loops, with where their checks are (for `verify` to say which\n  // loop a check failing after one of them may need an invariant of)\n  skipped_loops: List[smt.SkippedLoop] = [],\n  // the expression the body ends with, as shown (what its `ensures` are\n  // about, for `verify` to name)\n  result_text: String = \"\",\n}"},{"name":"smt.call","kind":"fn","old":"f2b5d62872e893a4","new":"13c9493e64219b9b","interface_changed":false,"affected":[],"module":"smt","text":"fn call(\n  mut vc: smt.Vc,\n  name: String,\n  arg_exprs: List[ast.Expr],\n  args: List[smt.Val],\n) -> smt.Val {\n  // the polarity of the call's result (`Vc.polarity`), for the body seen\n  // through or the builtin\n  pol := vc.call_pol\n  vc.call_pol = 0\n  // a `for`'s element (`for_loop`): at its position, which is in range\n  if name == \"$at\" {\n    return smt.for_element(mut vc, args)\n  }\n  // `len(s.code_points())` is the SMT string's length, `len(s.bytes())` its\n  // `byte_len`: both modelled on `s` itself\n  if name == \"len\" {\n    match get(arg_exprs, 0) {\n      Some(a) => match smt.string_unit(a) {\n        Some((unit, s)) => {\n          v := smt.eval(mut vc, s)\n          return if unit == \"code_points\" {\n            smt.VInt(\"(str.len \" + smt.as_str(mut vc, v) + \")\")\n          } else {\n            smt.builtin(mut vc, \"byte_len\", [s], [v])\n          }\n        },\n        None => (),\n      },\n      None => (),\n    }\n  }\n  // `len` of an iterator (a type implementing `FiniteIterator`) is its\n  // method\n  if name == \"len\" && len(args) == 1 {\n    match smt.implementation(vc, \"FiniteIterator::len\", args) {\n      Some(_) => match smt.method_call(\n        mut vc,\n        \"FiniteIterator::len\",\n        arg_exprs,\n        args,\n      ) {\n        Some(r) => return r,\n        None => (),\n      },\n      None => (),\n    }\n  }\n  match get(vc.fns, name) {\n    Some(f) => {\n      // a call of the function being checked in a function its code passes\n      // (`xs.all(x -> f(x))`), not in a contract nor a body seen through:\n      // by its contract, as a recursive call in the code is. Its body seen\n      // through there is seen through again at each element it is applied\n      // to, nested (`contracts.refn`'s queries were 15 MB)\n      own := name == vc.self_name\n        && vc.contract == 0\n        && vc.see == 0\n        && vc.through == 0\n        && vc.unfolding == 0\n      if (vc.spec > 0 || vc.see > 0) && vc.depth < 4 && !own {\n        // in a contract or a loop's written invariant, a call is seen\n        // through to its body when it finishes and can't fail\n        if contains(vc.methods.unfold, name) {\n          match smt.def_call(mut vc, name, f, arg_exprs, args, true) {\n            Some(r) => return r,\n            None => (),\n          }\n          match smt.rec_call(mut vc, name, f, args) {\n            Some(r) => return r,\n            None => (),\n          }\n        }\n        match get(vc.methods.seen, name) ?? smt.ContractOnly {\n          smt.SeeThrough => {\n            if contains(vc.methods.assumed, name) {\n              mut vc.relied_on.insert(name)\n            }\n            match smt.def_call(mut vc, name, f, arg_exprs, args, false) {\n              Some(r) => return r,\n              None => (),\n            }\n            // the same call on the same values already made a list: reuse\n            // it instead of a second one said equal element by element\n            key := smt.call_key(vc, name, arg_exprs, args)\n            match key {\n              Some(k) => match get(vc.memo, k) {\n                Some(before) => match before {\n                  smt.VList { .. } => return before,\n                  _ => (),\n                },\n                None => (),\n              },\n              None => (),\n            }\n            binds := dict(zip(f.params.map(p -> p.name), args))\n            vc.depth += 1\n            vc.spec += 1\n            vc.through += 1\n            saved := vc.scopes\n            vc.scopes = [binds]\n            r := smt.eval_pol(mut vc, f.body, pol)\n            vc.scopes = saved\n            vc.through -= 1\n            vc.spec -= 1\n            vc.depth -= 1\n            // the same call in the code on the same values gave the same\n            // result: when its body is made both ways, `pol` 0\n            if pol == 0 {\n              smt.same_call(mut vc, key, r)\n            }\n            return r\n          },\n          smt.NotKnown => smt.gap(\n            mut vc,\n            f\"the call of `{name}` in a contract (whether it finishes needs a proof not ported)\",\n          ),\n          smt.ContractOnly => (),\n        }\n      }\n      r := smt.call_contract(mut vc, name, f, args)\n      smt.write_after(mut vc, f.params, arg_exprs)\n      // a function a contract sees through gives the same result on the\n      // same values, so what a contract says of its body holds of this call\n      if vc.spec == 0\n        && !f.params.any(p -> p.mutable)\n        && match get(vc.methods.seen, name) {\n          Some(smt.SeeThrough) => true,\n          _ => false,\n        } {\n        smt.same_call(\n          mut vc,\n          smt.call_key(vc, name, arg_exprs, args),\n          r,\n        )\n      }\n      r\n    },\n    // (a builtin's name called on a value of a program's type, `todo.\n    // insert(mut db)`: a trait's method, never the builtin)\n    None => if vc.builtins.any(b -> b.name == name)\n      && !(match smt.head_of(vc, get(args, 0) ?? smt.UnitVal) {\n          Some(h) => contains(vc.types, h),\n          None => false,\n        }\n        && smt.method_contract(vc, name) is Some) {\n      vc.call_pol = pol\n      smt.builtin(mut vc, name, arg_exprs, args)\n    } else {\n      match smt.method_call(mut vc, name, arg_exprs, args) {\n        Some(r) => r,\n        None => match keys(vc.fns).filter(k -> ends_with(k, \".\" + name)) {\n          // a module's function called as a method (`s.graphemes()` is\n          // `std.unicode.graphemes(s)`), as the resolver reads it\n          [q] => match get(vc.fns, q) {\n            // a capability's function called on one (`clock.seconds()`):\n            // the receiver isn't an argument\n            Some(f) => if len(f.params) + 1 == len(args) {\n              smt.call(mut vc, q, drop(arg_exprs, 1), drop(args, 1))\n            } else {\n              smt.call(mut vc, q, arg_exprs, args)\n            },\n            None => smt.call(mut vc, q, arg_exprs, args),\n          },\n          // a builtin stored under a module's name (`std.http.get`, where\n          // the module's type has a method `get`).\n          // `T.check(x)` on any type: whether `x` meets the type's\n          // refinements, an unconstrained `Result[(), String]`.\n          _ => if contains(name, \".\")\n            && vc.builtins.any(b -> b.name == smt.last_name(name)) {\n            smt.builtin(\n              mut vc,\n              smt.last_name(name),\n              arg_exprs,\n              args,\n            )\n          } else if name == \"check\" {\n            smt.shape(mut vc, ast.Named {\n              name: \"Result\",\n              args: [ast.UnitType, ast.Named { name: \"String\", args: [] }],\n            })\n          } else {\n            smt.gap(mut vc, f\"the method `{name}`\")\n            smt.Opaque(f\"the result of `{name}`\")\n          },\n        },\n      }\n    },\n  }\n}","old_text":"fn call(\n  mut vc: smt.Vc,\n  name: String,\n  arg_exprs: List[ast.Expr],\n  args: List[smt.Val],\n) -> smt.Val {\n  // the polarity of the call's result (`Vc.polarity`), for the body seen\n  // through or the builtin\n  pol := vc.call_pol\n  vc.call_pol = 0\n  // a `for`'s element (`for_loop`): at its position, which is in range\n  if name == \"$at\" {\n    return smt.for_element(mut vc, args)\n  }\n  // `len(s.code_points())` is the SMT string's length, `len(s.bytes())` its\n  // `byte_len`: both modelled on `s` itself\n  if name == \"len\" {\n    match get(arg_exprs, 0) {\n      Some(a) => match smt.string_unit(a) {\n        Some((unit, s)) => {\n          v := smt.eval(mut vc, s)\n          return if unit == \"code_points\" {\n            smt.VInt(\"(str.len \" + smt.as_str(mut vc, v) + \")\")\n          } else {\n            smt.builtin(mut vc, \"byte_len\", [s], [v])\n          }\n        },\n        None => (),\n      },\n      None => (),\n    }\n  }\n  // `len` of an iterator (a type implementing `FiniteIterator`) is its\n  // method\n  if name == \"len\" && len(args) == 1 {\n    match smt.implementation(vc, \"FiniteIterator::len\", args) {\n      Some(_) => match smt.method_call(\n        mut vc,\n        \"FiniteIterator::len\",\n        arg_exprs,\n        args,\n      ) {\n        Some(r) => return r,\n        None => (),\n      },\n      None => (),\n    }\n  }\n  match get(vc.fns, name) {\n    Some(f) => {\n      if (vc.spec > 0 || vc.see > 0) && vc.depth < 4 {\n        // in a contract or a loop's written invariant, a call is seen\n        // through to its body when it finishes and can't fail\n        if contains(vc.methods.unfold, name) {\n          match smt.def_call(mut vc, name, f, arg_exprs, args, true) {\n            Some(r) => return r,\n            None => (),\n          }\n          match smt.rec_call(mut vc, name, f, args) {\n            Some(r) => return r,\n            None => (),\n          }\n        }\n        match get(vc.methods.seen, name) ?? smt.ContractOnly {\n          smt.SeeThrough => {\n            if contains(vc.methods.assumed, name) {\n              mut vc.relied_on.insert(name)\n            }\n            match smt.def_call(mut vc, name, f, arg_exprs, args, false) {\n              Some(r) => return r,\n              None => (),\n            }\n            // the same call on the same values already made a list: reuse\n            // it instead of a second one said equal element by element\n            key := smt.call_key(vc, name, arg_exprs, args)\n            match key {\n              Some(k) => match get(vc.memo, k) {\n                Some(before) => match before {\n                  smt.VList { .. } => return before,\n                  _ => (),\n                },\n                None => (),\n              },\n              None => (),\n            }\n            binds := dict(zip(f.params.map(p -> p.name), args))\n            vc.depth += 1\n            vc.spec += 1\n            vc.through += 1\n            saved := vc.scopes\n            vc.scopes = [binds]\n            r := smt.eval_pol(mut vc, f.body, pol)\n            vc.scopes = saved\n            vc.through -= 1\n            vc.spec -= 1\n            vc.depth -= 1\n            // the same call in the code on the same values gave the same\n            // result: when its body is made both ways, `pol` 0\n            if pol == 0 {\n              smt.same_call(mut vc, key, r)\n            }\n            return r\n          },\n          smt.NotKnown => smt.gap(\n            mut vc,\n            f\"the call of `{name}` in a contract (whether it finishes needs a proof not ported)\",\n          ),\n          smt.ContractOnly => (),\n        }\n      }\n      r := smt.call_contract(mut vc, name, f, args)\n      smt.write_after(mut vc, f.params, arg_exprs)\n      // a function a contract sees through gives the same result on the\n      // same values, so what a contract says of its body holds of this call\n      if vc.spec == 0\n        && !f.params.any(p -> p.mutable)\n        && match get(vc.methods.seen, name) {\n          Some(smt.SeeThrough) => true,\n          _ => false,\n        } {\n        smt.same_call(\n          mut vc,\n          smt.call_key(vc, name, arg_exprs, args),\n          r,\n        )\n      }\n      r\n    },\n    // (a builtin's name called on a value of a program's type, `todo.\n    // insert(mut db)`: a trait's method, never the builtin)\n    None => if vc.builtins.any(b -> b.name == name)\n      && !(match smt.head_of(vc, get(args, 0) ?? smt.UnitVal) {\n          Some(h) => contains(vc.types, h),\n          None => false,\n        }\n        && smt.method_contract(vc, name) is Some) {\n      vc.call_pol = pol\n      smt.builtin(mut vc, name, arg_exprs, args)\n    } else {\n      match smt.method_call(mut vc, name, arg_exprs, args) {\n        Some(r) => r,\n        None => match keys(vc.fns).filter(k -> ends_with(k, \".\" + name)) {\n          // a module's function called as a method (`s.graphemes()` is\n          // `std.unicode.graphemes(s)`), as the resolver reads it\n          [q] => match get(vc.fns, q) {\n            // a capability's function called on one (`clock.seconds()`):\n            // the receiver isn't an argument\n            Some(f) => if len(f.params) + 1 == len(args) {\n              smt.call(mut vc, q, drop(arg_exprs, 1), drop(args, 1))\n            } else {\n              smt.call(mut vc, q, arg_exprs, args)\n            },\n            None => smt.call(mut vc, q, arg_exprs, args),\n          },\n          // a builtin stored under a module's name (`std.http.get`, where\n          // the module's type has a method `get`).\n          // `T.check(x)` on any type: whether `x` meets the type's\n          // refinements, an unconstrained `Result[(), String]`.\n          _ => if contains(name, \".\")\n            && vc.builtins.any(b -> b.name == smt.last_name(name)) {\n            smt.builtin(\n              mut vc,\n              smt.last_name(name),\n              arg_exprs,\n              args,\n            )\n          } else if name == \"check\" {\n            smt.shape(mut vc, ast.Named {\n              name: \"Result\",\n              args: [ast.UnitType, ast.Named { name: \"String\", args: [] }],\n            })\n          } else {\n            smt.gap(mut vc, f\"the method `{name}`\")\n            smt.Opaque(f\"the result of `{name}`\")\n          },\n        },\n      }\n    },\n  }\n}"},{"name":"smt.pred_old","kind":"fn","old":"e4dc07b1f1672b20","new":"ef90c000c93e8ad3","interface_changed":false,"affected":[],"module":"smt","text":"/// `pred` with `old e` reading `olds`, the values before (an `ensures`).\nfn pred_old(\n  mut vc: smt.Vc,\n  e: ast.Expr,\n  binds: List[(String, smt.Val)],\n  olds: Option[List[(String, smt.Val)]],\n) -> String {\n  if vc.depth > 4 {\n    return smt.unknown_bool(mut vc, \"contracts nest too deeply\")\n  }\n  vc.depth += 1\n  saved := vc.scopes\n  vc.scopes = [dict(binds)]\n  saved_olds := vc.olds\n  vc.olds = match olds {\n    Some(o) => Some(dict(o)),\n    None => None,\n  }\n  dead := vc.dead\n  vc.dead = false\n  returns := vc.returns\n  vc.returns = []\n  vc.spec += 1\n  vc.contract += 1\n  v := smt.eval(mut vc, e)\n  vc.contract -= 1\n  vc.spec -= 1\n  vc.returns = returns\n  vc.dead = dead\n  vc.scopes = saved\n  vc.olds = saved_olds\n  vc.depth -= 1\n  smt.as_bool(mut vc, v)\n}","old_text":"/// `pred` with `old e` reading `olds`, the values before (an `ensures`).\nfn pred_old(\n  mut vc: smt.Vc,\n  e: ast.Expr,\n  binds: List[(String, smt.Val)],\n  olds: Option[List[(String, smt.Val)]],\n) -> String {\n  if vc.depth > 4 {\n    return smt.unknown_bool(mut vc, \"contracts nest too deeply\")\n  }\n  vc.depth += 1\n  saved := vc.scopes\n  vc.scopes = [dict(binds)]\n  saved_olds := vc.olds\n  vc.olds = match olds {\n    Some(o) => Some(dict(o)),\n    None => None,\n  }\n  dead := vc.dead\n  vc.dead = false\n  returns := vc.returns\n  vc.returns = []\n  vc.spec += 1\n  v := smt.eval(mut vc, e)\n  vc.spec -= 1\n  vc.returns = returns\n  vc.dead = dead\n  vc.scopes = saved\n  vc.olds = saved_olds\n  vc.depth -= 1\n  smt.as_bool(mut vc, v)\n}"}]}
