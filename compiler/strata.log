elds"],"module":"codegen","text":"/// An instance's symbol: `@\"strata:f\"`, `@\"strata:f[Int, String]\"`.\nfn inst_sym(k: String, f: ast.FnDecl, sub: Dict[String, check.Ty]) -> String {\n  if len(f.type_params) == 0 {\n    f\"@\\\"strata:{k}\\\"\"\n  } else {\n    args := join(\n      f.type_params.map(p -> codegen.key(get(sub, p) ?? check.TAny)),\n      \", \",\n    )\n    // refined type arguments as written get their own instance\n    ws := (f.type_params + [\"$self\"])\n      .filter(p -> contains(sub, \"$w:\" + p))\n      .map(p -> p + \"=\" + codegen.key(get(sub, \"$w:\" + p) ?? check.TAny))\n    w := if ws == [] {\n      \"\"\n    } else {\n      \"{\" + join(ws, \", \") + \"}\"\n    }\n    f\"@\\\"strata:{k}[{args}]{w}\\\"\"\n  }\n}","old_text":"/// An instance's symbol: `@\"strata:f\"`, `@\"strata:f[Int, String]\"`.\nfn inst_sym(k: String, f: ast.FnDecl, sub: Dict[String, Ty]) -> String {\n  if len(f.type_params) == 0 {\n    f\"@\\\"strata:{k}\\\"\"\n  } else {\n    args := join(\n      f.type_params.map(p -> codegen.key(get(sub, p) ?? TAny)),\n      \", \",\n    )\n    // refined type arguments as written get their own instance\n    ws := (f.type_params + [\"$self\"])\n      .filter(p -> contains(sub, \"$w:\" + p))\n      .map(p -> p + \"=\" + codegen.key(get(sub, \"$w:\" + p) ?? TAny))\n    w := if ws == [] {\n      \"\"\n    } else {\n      \"{\" + join(ws, \", \") + \"}\"\n    }\n    f\"@\\\"strata:{k}[{args}]{w}\\\"\"\n  }\n}"},{"name":"codegen.is_collection","kind":"fn","old":"6693a345318af216","new":"cfcbe0c538c19107","interface_changed":true,"affected":["codegen.drop_value","codegen.builtin","codegen.repr","codegen.own_builtin","codegen.retype_temp","codegen.tail_drop","codegen.copy_out","codegen.list_view","codegen.share_value","codegen.tail_share","codegen.function","codegen.drop_scope","codegen.drop_fields","codegen.debug_list","codegen.drop_list","codegen.closure","codegen.collection_builtin","codegen.call_fn_want","codegen.builtin_call","codeg