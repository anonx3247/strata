t g, \"err\"),\n    codegen.label(mut g, \"res\"),\n  )\n  codegen.emit(mut g, f\"br i1 {ok}, label %{good}, label %{bad}\")\n  codegen.block(mut g, good)\n  okb := codegen.block_of(mut g, get(g.tags, \"Ok\") ?? 0, [v])\n  codegen.emit(mut g, f\"br label %{end}\")\n  codegen.block(mut g, bad)\n  (k, m) := (codegen.fresh(mut g, \"k\"), codegen.fresh(mut g, \"m\"))\n  codegen.emit(mut g, f\"{k} = load ptr, ptr {ks}\")\n  codegen.emit(mut g, f\"{m} = load ptr, ptr {ms}\")\n  // owned: the blocks take them\n  kv := codegen.temp(mut g, codegen.V { ty: check.TStr, op: k })\n  mv := codegen.temp(mut g, codegen.V { ty: check.TStr, op: m })\n  pair := codegen.block_of(mut g, 0, [kv, mv])\n  pt := check.TNamed { name: \"Tuple\", args: [check.TStr, check.TStr] }\n  pv := codegen.temp(mut g, codegen.V { ty: pt, op: pair })\n  errb := codegen.block_of(mut g, get(g.tags, \"Err\") ?? 0, [pv])\n  codegen.emit(mut g, f\"br label %{end}\")\n  codegen.block(mut g, end)\n  r := codegen.fresh(mut g, \"r\")\n  codegen.emit(\n    mut g,\n    f\"{r} = phi ptr [ {okb}, %{good} ], [ {errb}, %{bad} ]\",\n  )\n  codegen.temp(mut g, codegen.V { ty: t, op: r })\n}","old_text":"/// `Ok(v)` when `ok` holds, else `Err((kind, message))` from the slots the\n/// runtime filled.\nfn outcome(\n  mut g: codegen.Gen,\n  ok: String,\n  v: codegen.V,\n  ks: String,\n  ms: String,\n  t: Ty,\n) -> codegen.V {\n  (good, bad, end) := (\n    codegen.label(mut g, \"ok\"),\n    codegen.label(mut g, \"err\"),\n    codegen.label(mut g, \"res\"),\n  )\n  codegen.emit(mut g, f\"br i1 {ok}, label %{good}, label %{bad}\")\n  codegen.block(mut g, good)\n  okb := codegen.block_of(mut g, get(g.tags, \"Ok\") ?? 0, [v])\n  codegen.emit(mut g, f\"br label %{end}\")\n  codegen.block(mut g, bad)\n  (k, m) := (codegen.fresh(mut g, \"k\"), codegen.fresh(mut g, \"m\"))\n  codegen.emit(mut g, f\"{k} = load ptr, ptr {ks}\")\n  codegen.emit(mut g, f\"{m} = load ptr, ptr {ms}\")\n  // owned: the blocks take them\n  kv := codegen.temp(mut g, codegen.V { ty: TStr, op: k })\n  mv := codegen.temp(mut g, codegen.V { ty: TStr, op: m })\n  pair := codegen.block_of(mut g, 0, [kv, mv])\n  pt := TNamed { name: \"Tuple\", args: [TStr, TStr] }\n  pv := codegen.temp(mut g, codegen.V { ty: pt, op: pair })\n  errb := codegen.block_of(mut g, get(g.tags, \"Err\") ?? 0, [pv])\n  codegen.emit(mut g, f\"br label %{end}\")\n  codegen.block(mut g, end)\n  r := codegen.fresh(mut g, \"r\")\n  codegen.emit(\n    mut g,\n    f\"{r} = phi ptr [ {okb}, %{good} ], [ {errb}, %{bad} ]\",\n  )\n  codegen.temp(mut g, codegen.V { ty: t, op: r })\n}"},{"name":"codegen.for_impls","kind":"fn","old":"6b3cea9015c3001c","new":"451cedd7f24778b8","interface_changed":true,"affected":["codegen.call_fn_want","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.expr_node","codegen.expr_want_node","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.builtin_call","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.main_arg","codegen.select_expr","codegen.expr","codegen.expr_want","codegen.entry","codegen.interp","codegen.format_spec","codegen.union_text","codegen.destructure","codegen.debug_fields","codegen.for_loop","codegen.debug_list","codegen.checked","codegen.fail_unless","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.fuzz_driver","codegen.trace_enter","codegen.trace_leave","codegen.matching_v","codegen.index_check","codegen.checked_update","codegen.decreases_fault","codegen.push_in_place","codegen.gen_list","codegen.converted","codegen.update_in_place","codegen.except_expr","codegen.matching_want","codegen.vtable","codegen.dyn_call","codegen.binary","codegen.logic","codegen.loop_body","codegen.matches","codegen.with_it","codegen.for_list","codegen.await_expr","codegen.race_expr","codege