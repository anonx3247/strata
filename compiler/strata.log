e: \"Tuple\", args } => len(args),\n    check.TNamed { name, .. } => len(codegen.fields_of(g, name, t)),\n    _ => 0,\n  }\n}","old_text":"/// The number of fields of a record or tuple of type `t`.\nfn block_fields(g: codegen.Gen, t: Ty) -> Int {\n  match t {\n    TNamed { name: \"Tuple\", args } => len(args),\n    TNamed { name, .. } => len(codegen.fields_of(g, name, t)),\n    _ => 0,\n  }\n}"},{"name":"codegen.compare_values","kind":"fn","old":"72c16cbbf10cad9b","new":"7e5942a3666af7b0","interface_changed":false,"affected":[],"module":"codegen","text":"/// `compare(a, b)`: the values' order (-1, 0 or 1) by their type's `cmp`\n/// helper, the order `sort` uses.\nfn compare_values(\n  mut g: codegen.Gen,\n  a0: codegen.V,\n  b0: codegen.V,\n) -> codegen.V {\n  a := codegen.as_type(mut g, a0, b0.ty)\n  b := codegen.as_type(mut g, b0, a0.ty)\n  if !codegen.has_value(a.ty) {\n    return codegen.V { ty: check.TInt, op: \"0\" }\n  }\n  f := codegen.cmp_helper(mut g, a.ty)\n  c := codegen.fresh(mut g, \"order\")\n  codegen.emit(\n    mut g,\n    f\"{c} = call i64 {f}({codegen.args_of([a, b])})\",\n  )\n  codegen.V { ty: check.TInt, op: c }\n}","old_text":"/// `compare(a, b)`: the values' order (-1, 0 or 1) by their type's `cmp`\n/// helper, the order `sort` uses.\nfn compare_values(\n  mut g: codegen.Gen,\n  a0: codegen.V,\n  b0: codegen.V,\n) -> codegen.V {\n  a := codegen.as_type(mut g, a0, b0.ty)\n  b := codegen.as_type(mut g, b0, a0.ty)\n  if !codegen.has_value(a.ty) {\n    return codegen.V { ty: TInt, op: \"0\" }\n  }\n  f := codegen.cmp_helper(mut g, a.ty)\n  c := codegen.fresh(mut g, \"order\")\n  codegen.emit(\n    mut g,\n    f\"{c} = call i64 {f}({codegen.args_of([a, b])})\",\n  )\n  codegen.V { ty: TInt, op: c }\n}"},{"name":"codegen.take_in_place","kind":"fn","old":"823b74646960519b","new":"9b6e08fecc9ae665","interface_changed":false,"affected":[],"module":"codegen","text":"/// `xs = take(xs, n)` (or on `x.f`) on a list. The old list is dead\n/// afterwards. When nothing else holds it (header and buffer held once, the\n/// buffer all its own, and for a field the record too), the elements from\n/// `n` on are removed from the end and dropped in place, so a later `push`\n/// is in place too. Else the built-in makes a slice sharing the buffer.\n/// The result is owned either way. `None` when `value` is not such a call.\nfn take_in_place(\n  mut g: codegen.Gen,\n  place: ast.Expr,\n  target: ast.Expr,\n  rest: List[ast.Expr],\n) -> Option[codegen.V] {\n  match place {\n    ast.Var(_) | ast.FieldOf { base: ast.Var(_), .. } => (),\n    _ => return None,\n  }\n  // the count may read the list, since it is computed before the list\n  // changes, but may not change it\n  if target != place\n    || len(rest) != 1\n    || codegen.lookup(g, \"take\") is Some\n    || codegen.has_fn(g, \"take\")\n    || rest.any(\n      a -> walk.any_expr(a, e -> e is ast.MutExpr || e is ast.Block),\n    ) {\n    return None\n  }\n  cur := codegen.expr(mut g, target)\n  et := match cur.ty {\n    check.TList(e) => e,\n    _ => return None,\n  }\n  vs0 := match codegen.operands(mut g, rest) {\n    Some(vs) => vs,\n    None => return Some(codegen.never()),\n  }\n  vs := [codegen.converted(\n    mut g,\n    get(vs0, 0) ?? codegen.unit(),\n    check.TInt,\n  )]\n  proven := codegen.proven_on(g, place)\n  owned := codegen.held_test(\n    mut g,\n    \"strata_list_owned\",\n    cur.op,\n    proven && place is ast.Var,\n  )\n  ok := match place {\n    ast.FieldOf { base, .. } => {\n      rv := codegen.expr(mut g, base)\n      u := codegen.held_test(mut g, \"strata_unique\", rv.op, proven)\n      both := codegen.fresh(mut g, \"owned\")\n      codegen.emit(mut g, f\"{both} = and i1 {owned}, {u}\")\n      both\n    },\n    _ => owned,\n  }\n  (here, copy, done) := (\n    codegen.label(mut g, \"update.here\"),\n    codegen.label(mut g, \"update.copy\"),\n    codegen.label(mut g, \"update.done\"),\n  )\n  codegen.emit(mut g, f\"br i1 {ok}, label %{here}, label %{copy}\")\n  codegen.block(mut g, here)\n  codegen.push_transparent(mut g)\n  // the elements from `n` on removed from the end, each dropped\n  n := codegen.list_len(mut g, cur)\n  k := codegen.clamp(mut g, (get(vs, 0) ?? codegen.unit()).op, n.op)\n  (head, body, end) := (\n    codegen.label(mut g, \"truncate\"),\n    codegen.label(mut g, \"truncate.body\"),\n    codegen.label(mut g, \"truncate.end\"),\n  )\n  codegen.br(mut g, head)\n  codegen.block(mut g, head)\n  m := codegen.list_len(mut g, cur)\n  more := codegen.fresh(mut g, \"more\")\n  codegen.emit(mut g, f\"{more} = icmp sgt i64 {m.op}, {k}\")\n  codegen.emit(mut g, f\"br i1 {more}, label %{body}, label %{end}\")\n  codegen.block(mut g, body)\n  last := codegen.fresh(mut g, \"last\")\n  codegen.emit(mut g, f\"{last} = sub i64 {m.op}, 1\")\n  codegen.use_rt(mut g, \"strata_list_remove_at\")\n  old := codegen.fresh(mut g, \"old\")\n  codegen.emit(\n    mut g,\n    f\"{old} = call i64 @strata_list_remove_at(ptr {cur.op}, i64 {last})\",\n  )\n  codegen.drop_value(mut g, codegen.from_slot(mut g, old, et))\n  codegen.br(mut g, head)\n  codegen.block(mut g, end)\n  codegen.dup_value(mut g, cur)\n  codegen.pop_scope(mut g)\n  from_here := codegen.current(g)\n  codegen.br(mut g, done)\n  // else a new one, as the built-in makes it\n  codegen.block(mut g, copy)\n  codegen.push_transparent(mut g)\n  made := codegen.list_builtin(mut g, \"take\", [cur] + vs)\n  r := codegen.leave_branch(mut g, made)\n  from_copy := codegen.current(g)\n  codegen.br(mut g, done)\n  codegen.block(mut g, done)\n  p := codegen.fresh(mut g, \"updated\")\n  codegen.emit(\n    mut g,\n    f\"{p} = phi ptr [ {cur.op}, %{from_here} ], [ {r.op}, %{from_copy} ]\",\n  )\n  Some(codegen.temp(mut g, codegen.V { ty: cur.ty, op: p }))\n}","old_text":"/// `xs = take(xs, n)` (or on `x.f`) on a list. The old list is dead\n/// afterwards. When nothing else holds it (header and buffer held once, the\n/// buffer all its own, and for a field the record too), the elements from\n/// `n` on are removed from the end and dropped in place, so a later `push`\n/// is in place too. Else the built-in makes a slice sharing the buffer.\n/// The result is owned either way. `None` when `value` is not such a call.\nfn take_in_place(\n  mut g: codegen.Gen,\n  place: ast.Expr,\n  target: ast.Expr,\n  rest: List[ast.Expr],\n) -> Option[codegen.V] {\n  match place {\n    ast.Var(_) | ast.FieldOf { base: ast.Var(_), .. } => (),\n    _ => return None,\n  }\n  // the count may read the list, since it is computed before the list\n  // changes, but may not change it\n  if target != place\n    || len(rest) != 1\n    || codegen.lookup(g, \"take\") is Some\n    || codegen.has_fn(g, \"take\")\n    || rest.any(\n      a -> walk.any_expr(a, e -> e is ast.MutExpr || e is ast.Block),\n    ) {\n    return None\n  }\n  cur := codegen.expr(mut g, target)\n  et := match cur.ty {\n    TList(e) => e,\n    _ => return None,\n  }\n  vs0 := match codegen.operands(mut g, rest) {\n    Some(vs) => vs,\n    None => return Some(codegen.never()),\n  }\n  vs := [codegen.converted(mut g, get(vs0, 0) ?? codegen.unit(), TInt)]\n  proven := codegen.proven_on(g, place)\n  owned := codegen.held_test(\n    mut g,\n    \"strata_list_owned\",\n    cur.op,\n    proven && place is ast.Var,\n  )\n  ok := match place {\n    ast.FieldOf { base, .. } => {\n      rv := codegen.expr(mut g, base)\n      u := codegen.held_test(mut g, \"strata_unique\", rv.op, proven)\n      both := codegen.fresh(mut g, \"owned\")\n      codegen.emit(mut g, f\"{both} = and i1 {owned}, {u}\")\n      both\n    },\n    _ => owned,\n  }\n  (here, copy, done) := (\n    codegen.label(mut g, \"update.here\"),\n    codegen.label(mut g, \"update.copy\"),\n    codegen.label(mut g, \"update.done\"),\n  )\n  codegen.emit(mut g, f\"br i1 {ok}, label %{here}, label %{copy}\")\n  codegen.block(mut g, here)\n  codegen.push_transparent(mut g)\n  // the elements from `n` on removed from the end, each dropped\n  n := codegen.list_len(mut g, cur)\n  k := codegen.clamp(mut g, (get(vs, 0) ?? codegen.unit()).op, n.op)\n  (head, body, end) := (\n    codegen.label(mut g, \"truncate\"),\n    codegen.label(mut g, \"truncate.body\"),\n    codegen.label(mut g, \"truncate.end\"),\n  )\n  codegen.br(mut g, head)\n  codegen.block(mut g, head)\n  m := codegen.list_len(mut g, cur)\n  more := codegen.fresh(mut g, \"more\")\n  codegen.emit(mut g, f\"{more} = icmp sgt i64 {m.op}, {k}\")\n  codegen.emit(mut g, f\"br i1 {more}, label %{body}, label %{end}\")\n  codegen.block(mut g, body)\n  last := codegen.fresh(mut g, \"last\")\n  codegen.emit(mut g, f\"{last} = sub i64 {m.op}, 1\")\n  codegen.use_rt(mut g, \"strata_list_remove_at\")\n  old := codegen.fresh(mut g, \"old\")\n  codegen.emit(\n    mut g,\n    f\"{old} = call i64 @strata_list_remove_at(ptr {cur.op}, i64 {last})\",\n  )\n  codegen.drop_value(mut g, codegen.from_slot(mut g, old, et))\n  codegen.br(mut g, head)\n  codegen.block(mut g, end)\n  codegen.dup_value(mut g, cur)\n  codegen.pop_scope(mut g)\n  from_here := codegen.current(g)\n  codegen.br(mut g, done)\n  // else a new one, as the built-in makes it\n  codegen.block(mut g, copy)\n  codegen.push_transparent(mut g)\n  made := codegen.list_builtin(mut g, \"take\", [cur] + vs)\n  r := codegen.leave_branch(mut g, made)\n  from_copy := codegen.current(g)\n  codegen.br(mut g, done)\n  codegen.block(mut g, done)\n  p := codegen.fresh(mut g, \"updated\")\n  codegen.emit(\n    mut g,\n    f\"{p} = phi ptr [ {cur.op}, %{from_here} ], [ {r.op}, %{from_copy} ]\",\n  )\n  Some(codegen.temp(mut g, codegen.V { ty: cur.ty, op: p }))\n}"},{"name":"codegen.holds_fn","kind":"fn","old":"5bff03c499350801","new":"41e00f918317d09d","interface_changed":true,"affected":["codegen.construct_want","codegen.construct","codegen.expr_want_node","codegen.main_arg","codegen.expr_node","codegen.session_capability","codegen.expr_want","codegen.entry","codegen.expr","codegen.session_entry","codegen.function","codegen.binary