t g, \"llvm.memmove.p0.p0.i64\")\n  saved := g\n  codegen.start_helper(mut g)\n  size := 8 * (len(tys) + 1)\n  codegen.emit(mut g, f\"%n = call ptr @strata_alloc(i64 {size})\")\n  codegen.emit(\n    mut g,\n    f\"call void @llvm.memmove.p0.p0.i64(ptr %n, ptr %a, i64 {size}, i1 false)\",\n  )\n  n := codegen.V { ty: t, op: \"%n\" }\n  for (k, ft) in enumerate(tys) {\n    if codegen.counted(ft) {\n      x := codegen.field(mut g, n, k, ft)\n      codegen.dup_value(mut g, x)\n    }\n  }\n  codegen.emit(mut g, \"ret ptr %n\")\n  def := codegen.helper_text(g, f\"define ptr {name}(ptr %a)\")\n  codegen.restore(mut g, saved, def)\n  name\n}","old_text":"/// The function copying a block of type `t` (fields `tys`): a new block\n/// with the same tag and fields, each counted field held once more.\nfn clone_fn(mut g: codegen.Gen, t: Ty, tys: List[Ty]) -> String {\n  name := f\"@\\\"clone:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  codegen.use_rt(mut g, \"strata_alloc\")\n  codegen.use_rt(mut g, \"llvm.memmove.p0.p0.i64\")\n  saved := g\n  codegen.start_helper(mut g)\n  size := 8 * (len(tys) + 1)\n  codegen.emit(mut g, f\"%n = call ptr @strata_alloc(i64 {size})\")\n  codegen.emit(\n    mut g,\n    f\"call void @llvm.memmove.p0.p0.i64(ptr %n, ptr %a, i64 {size}, i1 false)\",\n  )\n  n := codegen.V { ty: t, op: \"%n\" }\n  for (k, ft) in enumerate(tys) {\n    if codegen.counted(ft) {\n      x := codegen.field(mut g, n, k, ft)\n      codegen.dup_value(mut g, x)\n    }\n  }\n  codegen.emit(mut g, \"ret ptr %n\")\n  def := codegen.helper_text(g, f\"define ptr {name}(ptr %a)\")\n  codegen.restore(mut g, saved, def)\n  name\n}"},{"name":"codegen.store_slot","kind":"fn","old":"fa2dd840af208c8b","new":"7127de7b830d982e","interface_changed":false,"affected":[],"module":"codegen","text":"/// Writes `v` into the 64-bit slot at `at`, as `to_slot` makes it. A\n/// pointer, an `Int` or a `Float` is stored as is.\nfn store_slot(mut g: codegen.Gen, v: codegen.V, at: String) {\n  if codegen.sized(v.ty) is Some {\n    s := codegen.to_slot(mut g, v)\n    return codegen.emit(mut g, f\"store i64 {s}, ptr {at}\")\n  }\n  match v.ty {\n    check.TInt => codegen.emit(mut g, f\"store i64 {v.op}, ptr {at}\"),\n    check.TFloat => codegen.emit(mut g, f\"store double {v.op}, ptr {at}\"),\n    check.TStr | check.TNamed { .. } | check.TList(_) | check.TFn { .. } | check.TTrait(_) | check.TUnion(_) => codegen.emit(mut g, f\"store ptr {v.op}, ptr {at}\"),\n    _ => {\n      s := codegen.to_slot(mut g, v)\n      codegen.emit(mut g, f\"store i64 {s}, ptr {at}\")\n    },\n  }\n}","old_text":"/// Writes `v` into the 64-bit slot at `at`, as `to_slot` makes it. A\n/// pointer, an `Int` or a `Float` is stored as is.\nfn store_slot(mut g: codegen.Gen, v: codegen.V, at: String) {\n  if codegen.sized(v.ty) is Some {\n    s := codegen.to_slot(mut g, v)\n    return codegen.emit(mut g, f\"store i64 {s}, ptr {at}\")\n  }\n  match v.ty {\n    TInt => codegen.emit(mut g, f\"store i64 {v.op}, ptr {at}\"),\n    TFloat => codegen.emit(mut g, f\"store double {v.op}, ptr {at}\"),\n    TStr | TNamed { .. } | TList(_) | TFn { .. } | TTrait(_) | TUnion(_) => codegen.emit(mut g, f\"store ptr {v.op}, ptr {at}\"),\n    _ => {\n      s := codegen.to_slot(mut g, v)\n      codegen.emit(mut g, f\"store i64 {s}, ptr {at}\")\n    },\n  }\n}"},{"name":"codegen.load_slot","kind":"fn","old":"af4fe6c8279d864d","new":"c2a8f4bd341a51a6","interface_changed":true,"affected":["codegen.field","codegen.list_at","codegen.set_path","codegen.option_from","codegen.entry","codegen.show","codegen.get_field","codegen.eq_fields","codegen.debug_fields","codegen.drop_fields","codegen.matches","codegen.binds","codegen.sub_patterns","codegen.debug_list","codegen.closure","codegen.collection_builtin","codegen.cmp_fields","codegen.narrow","codegen.field_named","codegen.union_drop","codegen.with_it","codegen.check_type","codegen.options","codegen.await_ex