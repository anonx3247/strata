"edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","codegen.read_back","eval_files"],"module":"codegen","text":"/// `v` as a value of union `ut`, boxed when its type is.\nfn to_union(mut g: codegen.Gen, v: codegen.V, ut: check.Ty) -> codegen.V {\n  match v.ty {\n    check.TUnion(_) => codegen.V { ..v, ty: ut },\n    _ => if codegen.boxed(g, v.ty) {\n      // a value whose type is partly unknown (`[]`) takes the member of\n      // its kind (`List[Int]`)\n      m := if codegen.has_any(v.ty) {\n        match ut {\n          check.TUnion(ms) => find(ms, x -> codegen.head_of(x) == codegen.head_of(v.ty)) ?? v.ty,\n          _ => v.ty,\n        }\n      } else {\n        v.ty\n      }\n      tag := codegen.box_tag(mut g, m)\n      p := codegen.block_tagged(mut g, to_string(tag), [v])\n      codegen.temp(mut g, codegen.V { ty: ut, op: p })\n    } else {\n      codegen.V { ..v, ty: ut }\n    },\n  }\n}","old_text":"/// `v` as a value of union `ut`, boxed when its type is.\nfn to_union(mut g: codegen.Gen, v: codegen.V, ut: Ty) -> codegen.V {\n  match v.ty {\n    TUnion(_) => codegen.V { ..v, ty: ut },\n    _ => if codegen.boxed(g, v.ty) {\n      // a value whose type is partly unknown (`[]`) takes the member of\n      // its kind (`List[Int]`)\n      m := if codegen.has_any(v.ty) {\n        match ut {\n          TUnion(ms) => find(ms, x -> codegen.head_of(x) == codegen.head_of(v.ty)) ?? v.ty,\n          _ => v.ty,\n        }\n      } else {\n        v.ty\n      }\n      tag := codegen.box_tag(mut g, m)\n      p := codegen.block_tagged(mut g, to_string(tag), [v])\n      codegen.temp(mut g, codegen.V { ty: ut, op: p })\n    } else {\n      codegen.V { ..v, ty: ut }\n    },\n  }\n}"},{"name":"codegen.member_named","kind":"fn","old":"ca498f32de290d4f","new":"6a0c72c98d7155af","interface_changed":true,"affected":["codegen.pattern_member","codegen.if_want","codegen.expr_node","codegen.matches","codegen.binds","codegen.matching_v","codegen.if_expr","codegen.expr_want_node","codegen.expr","codegen.destructure","codegen.for_loop","codegen.match_got","codegen.matching_want","codegen.expr_want","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.loop_body","codegen.method_call","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_check","codegen.branch_value","codegen.try_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.compared","codegen.stmt_node","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.matching","codegen.function","codegen.declare","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.fuzz_driver","codegen.wanted","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.checked_update","codegen.appended","codegen.assertion","codegen.invariants","codegen.tag_is","codegen.check_type","codegen.satisfies","codegen.holds_pred","codegen.entry","codegen.vtable","codegen.mock_table","codegen.mock_call","codegen.list_builtin","codegen.collection_builtin","codegen.produce","codegen.table_find","codegen.generate","codegen.construct","codegen.operands","codegen.try_exp