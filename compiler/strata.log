 {\n  outer := g.here\n  g.here = e\n  codegen.flags_for(mut g, e)\n  opened := g.memory_sites && codegen.root_open(mut g, e)\n  v := codegen.expr_want_node(mut g, e, want)\n  codegen.root_close(mut g, opened)\n  g.here = outer\n  v\n}"},{"name":"codegen.block_expr","kind":"fn","old":"6c02ab692d7e566f","new":"1b0b43e5f6fdc0c8","interface_changed":true,"affected":["codegen.expr_node","codegen.expr_want_node","codegen.expr","codegen.expr_want","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.method_call","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.try_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.compared","codegen.stmt_node","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.function","codegen.declare","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.fuzz_driver","codegen.wanted","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.binds","codegen.matching_v","codegen.assertion","codegen.invariants","codegen.tag_is","codegen.check_type","codegen.satisfies","codegen.holds_pred","codegen.entry","codegen.vtable","codegen.mock_table","codegen.mock_call","codegen.list_builtin","codegen.collection_builtin","codegen.produce","cod