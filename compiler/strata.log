d with its value dropped.\nfn union_drop(mut g: codegen.Gen, t: check.Ty) -> String {\n  name := f\"@\\\"drop:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  ms := match t {\n    check.TUnion(ms) => ms,\n    _ => [],\n  }\n  saved := g\n  g.lines = []\n  g.proving = \"\"\n  g.can_unwind = false\n  g.unwinds = false\n  g.unwind_chain = []\n  g.allocas = []\n  g.next = 0\n  g.scopes = [codegen.no_scope()]\n  g.loops = []\n  codegen.block(mut g, \"start\")\n  a := codegen.V { ty: t, op: \"%a\" }\n  labels := codegen.on_members(mut g, a, ms)\n  for (k, m) in enumerate(ms) {\n    codegen.block(mut g, get(labels, k) ?? \"\")\n    if codegen.boxed(g, m) {\n      (gone, last, kept) := (\n        codegen.fresh(mut g, \"gone\"),\n        codegen.label(mut g, \"last\"),\n        codegen.label(mut g, \"kept\"),\n      )\n      codegen.use_counts(mut g)\n      codegen.use_rt(mut g, \"strata_free\")\n      codegen.emit(\n        mut g,\n        f\"{gone} = call i1 @strata.release(ptr %a)\",\n      )\n      codegen.emit(\n        mut g,\n        f\"br i1 {gone}, label %{last}, label %{kept}\",\n      )\n      codegen.block(mut g, last)\n      x := codegen.field(mut g, a, 0, m)\n      codegen.emit(mut g, \"call void @strata_free(ptr %a)\")\n      codegen.drop_value(mut g, x)\n      codegen.emit(mut g, \"ret void\")\n      codegen.block(mut g, kept)\n      codegen.emit(mut g, \"ret void\")\n    } else {\n      codegen.drop_value(mut g, codegen.V { ..a, ty: m })\n      codegen.emit(mut g, \"ret void\")\n    }\n  }\n  def := join([f\"define void {name}(ptr %a) {{\"]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, def)\n  name\n}","old_text":"/// The drop of a union value. A member block uses its own drop. A box is\n/// released, and on the last holder freed with its value dropped.\nfn union_drop(mut g: codegen.Gen, t: Ty) -> String {\n  name := f\"@\\\"drop:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  ms := match t {\n    TUnion(ms) => ms,\n    _ => [],\n  }\n  saved := g\n  g.lines = []\n  g.proving = \"\"\n  g.can_unwind = false\n  g.unwinds = false\n  g.unwind_chain = []\n  g.allocas = []\n  g.next = 0\n  g.scopes = [codegen.no_scope()]\n  g.loops = []\n  codegen.block(mut g, \"start\")\n  a := codegen.V { ty: t, op: \"%a\" }\n  labels := codegen.on_members(mut g, a, ms)\n  for (k, m) in enumerate(ms) {\n    codegen.block(mut g, get(labels, k) ?? \"\")\n    if codegen.boxed(g, m) {\n      (gone, last, kept) := (\n        codegen.fresh(mut g, \"gone\"),\n        codegen.label(mut g, \"last\"),\n        codegen.label(mut g, \"kept\"),\n      )\n      codegen.use_counts(mut g)\n      codegen.use_rt(mut g, \"strata_free\")\n      codegen.emit(\n        mut g,\n        f\"{gone} = call i1 @strata.release(ptr %a)\",\n      )\n      codegen.emit(\n        mut g,\n        f\"br i1 {gone}, label %{last}, label %{kept}\",\n      )\n      codegen.block(mut g, last)\n      x := codegen.field(mut g, a, 0, m)\n      codegen.emit(mut g, \"call void @strata_free(ptr %a)\")\n      codegen.drop_value(mut g, x)\n      codegen.emit(mut g, \"ret void\")\n      codegen.block(mut g, kept)\n      codegen.emit(mut g, \"ret void\")\n    } else {\n      codegen.drop_value(mut g, codegen.V { ..a, ty: m })\n      codegen.emit(mut g, \"ret void\")\n    }\n  }\n  def := join([f\"define void {name}(ptr %a) {{\"]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, def)\n  name\n}"},{"name":"codegen.union_call","kind":"fn","old":"08fdca4c73558ee0","new":"e57756acfe6be473","interface_changed":true,"affected":["codegen.method_call","codegen.expr_node","codegen.expr_want_node","codegen.expr","codegen.expr_want","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen