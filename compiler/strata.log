 {\n    return []\n  }\n  codegen.use_rt(mut g, \"strata_unwound\")\n  mut out := [\"unwound:\", \"  call void @strata_unwound()\"]\n  if framed {\n    codegen.use_rt(mut g, \"strata_leave\")\n    mut out.push(\"  call void @strata_leave()\")\n  }\n  lt := if g.by_words {\n    codegen.words_ll(codegen.small_words(g, ret))\n  } else {\n    codegen.ll(ret)\n  }\n  out\n    + [if codegen.has_value(ret) {\n      f\"  ret {lt} zeroinitializer\"\n    } else {\n      \"  ret void\"\n    }]\n}"},{"name":"codegen.call_bare","kind":"fn","old":"ae7783ee6af0758e","new":"dfd7c3e877f877b8","interface_changed":true,"affected":["codegen.call","codegen.equal","codegen.call_closure","codegen.call_fn_want","codegen.supervised_fns","codegen.await_list","codegen.generated","codegen.gen_list","codegen.dyn_entry_at","codegen.table_find","codegen.built_or_generated","codegen.entry","codegen.function","codegen.int_lit","codegen.show","codegen.shown","codegen.concat","codegen.apply","codegen.finite","codegen.fault","codegen.slice_raw","codegen.list_builtin","codegen.debug_list","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.number_builtin","codegen.format_spec","codegen.word_to_int","codegen.list_literal_of","codegen.checked","codegen.check_type","codegen.options","codegen.host","codegen.channel_op","codegen.regex_matches","codegen.trace_enter","codegen.trace_leave","codegen.mem_builtin","codegen.table_from","codegen.set_copy","codegen.checked_update","codegen.appended","codegen.expr_node","codegen.decreases_fault","codegen.build_fn","codegen.push_in_place","codegen.eq_fields","codegen.matches","codegen.eq_list","codegen.dyn_wrapper","codegen.union_eq","codegen.slot_fn","codegen.call_named","codegen.arena_run","codegen.call_fn","codegen.method_call","codegen.clock_now","codegen.type_check","codegen.by_variant","codegen.spawn_expr","codegen.await_expr","codegen.produce","codegen.gen_data","codegen.mock_method","codegen.fuzz_driver","codegen.generated_args","c