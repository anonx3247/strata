dle\",\n    kernel.or_term(p, kernel.negation(p)),\n  )\n}","old_text":"/// `⊢ p ∨ ¬p`\npub fn excluded_middle(p: kernel.Statement) -> kernel.Theorem {\n  kernel.axiom_theorem(kernel.or_term(p, kernel.negation(p)))\n}"},{"name":"kernel.exists_from_witness","kind":"fn","old":"b6922af3235dc908","new":"84f76c0a32258a39","interface_changed":false,"affected":[],"module":"kernel","text":"/// `⊢ predicate x ⇒ ∃ predicate`\npub fn exists_from_witness(\n  predicate: kernel.Term,\n  x: kernel.Term,\n) -> kernel.Theorem\n  requires kernel.accepts(predicate, x) {\n  kernel.axiom_theorem(\"exists_from_witness\", kernel.implication(\n    kernel.Application { function: predicate, argument: x },\n    kernel.exists_of(predicate),\n  ))\n}","old_text":"/// `⊢ predicate x ⇒ ∃ predicate`\npub fn exists_from_witness(\n  predicate: kernel.Term,\n  x: kernel.Term,\n) -> kernel.Theorem\n  requires kernel.accepts(predicate, x) {\n  kernel.axiom_theorem(kernel.implication(\n    kernel.Application { function: predicate, argument: x },\n    kernel.exists_of(predicate),\n  ))\n}"},{"name":"kernel.exists_elimination","kind":"fn","old":"142d8fd482ef5f8d","new":"a60f6942a5ba75ca","interface_changed":false,"affected":[],"module":"kernel","text":"/// `⊢ ∃ predicate ⇒ (∀x. predicate x ⇒ q) ⇒ q`\npub fn exists_elimination(\n  predicate: kernel.Term,\n  q: kernel.Statement,\n) -> kernel.Theorem\n  requires kernel.is_predicate(predicate) {\n  a := match kernel.type_of(predicate) {\n    Ok(pt) => match kernel.split_function_type(pt) {\n      Some((d, _)) => d,\n      None => kernel.boolean_type(),\n    },\n    Err(_) => kernel.boolean_type(),\n  }\n  x := kernel.fresh_variable_for([predicate, q], a)\n  every := kernel.binder(\n    \"forall\",\n    kernel.variable_name(x),\n    a,\n    kernel.implication(\n      kernel.Application { function: predicate, argument: x },\n      q,\n    ),\n  )\n  kernel.axiom_theorem(\"exists_elimination\", kernel.implication(\n    kernel.exists_of(predicate),\n    kernel.implication(every, q),\n  ))\n}","old_text":"/// `⊢ ∃ predicate ⇒ (∀x. predicate x ⇒ q) ⇒ q`\npub fn exists_elimination(\n  predicate: kernel.Term,\n  q: kernel.Statement,\n) -> kernel.Theorem\n  requires kernel.is_predicate(predicate) {\n  a := match kernel.type_of(predicate) {\n    Ok(pt) => match kernel.split_function_type(pt) {\n      Some((d, _)) => d,\n      None => kernel.boolean_type(),\n    },\n    Err(_) => kernel.boolean_type(),\n  }\n  x := kernel.fresh_variable_for([predicate, q], a)\n  every := kernel.binder(\n    \"forall\",\n    kernel.variable_name(x),\n    a,\n    kernel.implication(\n      kernel.Application { function: predicate, argument: x },\n      q,\n    ),\n  )\n  kernel.axiom_theorem(kernel.implication(\n    kernel.exists_of(predicate),\n    kernel.implication(every, q),\n  ))\n}"},{"name":"kernel.eta","kind":"fn","old":"eebca0cb75011aac","new":"5a7c7dcabd50b114","interface_changed":false,"affected":[],"module":"kernel","text":"/// `⊢ (λx. f x) = f`\npub fn eta(f: kernel.Term) -> kernel.Theorem\n  requires kernel.is_function(f) {\n  a := match kernel.type_of(f) {\n    Ok(ft) => match kernel.split_function_type(ft) {\n      Some((d, _)) => d,\n      None => kernel.boolean_type(),\n    },\n    Err(_) => kernel.boolean_type(),\n  }\n  kernel.axiom_theorem(\"eta\", kernel.equality_term(kernel.Lambda {\n    parameter_name: \"x\",\n    parameter_type: a,\n    body: kernel.Application {\n      function: f,\n      argument: kernel.LambdaParameter(0),\n    },\n  }, f))\n}","old_text":"/// `⊢ (λx. f x) = f`\npub fn eta(f: kernel.Term) -> kernel.Theorem\n  requires kernel.is_function(f) {\n  a := match kernel.type_of(f) {\n    Ok(ft) => match kernel.split_function_type(ft) {\n      Some((d, _)) => d,\n      None => kernel.boolean_type(),\n    },\n    Err(_) => kernel.boolean_type(),\n  }\n  kernel.axiom_theorem(kernel.equality_term(kernel.Lambda {\n    parameter_name: \"x\",\n    parameter_type: a,\n    body: kernel.Application {\n      function: f,\n      argument: kernel.LambdaParameter(0),\n    },\n  }, f))\n}"},{"name":"kernel.if_true","kind":"fn","old":"c5c46eefbdaa5f8b","new":"caf31575c6428daa","interface_changed":false,"affected":[],"module":"kernel","text":"/// `⊢ ite T a b = a`\npub fn if_true(a: kernel.Term, b: kernel.Term) -> kernel.Theorem\n  requires kernel.same_type(a, b) {\n  kernel.axiom_theorem(\n    \"if_true\",\n    kernel.equality_term(\n      kernel.if_term(kernel.true_term(), a, b),\n      a,\n    ),\n  )\n}","old_text":"/// `⊢ ite T a b = a`\npub fn if_true(a: kernel.Term, b: kernel.Term) -> kernel.Theorem\n  requires kernel.same_type(a, b) {\n  kernel.axiom_theorem(\n    kernel.equality_term(\n      kernel.if_term(kernel.true_term(), a, b),\n      a,\n    ),\n  )\n}"},{"name":"kernel.if_false","kind":"fn","old":"bed9a8863159d73d","new":"fc2a71b6614fcf7c","interface_changed":false,"affected":[],"module":"kernel","text":"/// `⊢ ite F a b = b`\npub fn if_false(a: kernel.Term, b: kernel.Term) -> kernel.Theorem\n  requires kernel.same_type(a, b) {\n  kernel.axiom_theorem(\n    \"if_false\",\n    kernel.equality_term(\n      kernel.if_term(kernel.false_term(), a, b),\n      b,\n    ),\n  )\n}","old_text":"/// `⊢ ite F a b = b`\npub fn if_false(a: kernel.Term, b: kernel.Term) -> kernel.Theorem\n  requires kernel.same_type(a, b) {\n  kernel.axiom_theorem(\n    kernel.equality_term(\n      kernel.if_term(kernel.false_term(), a, b),\n      b,\n    ),\n  )\n}"},{"name":"kernel.add_commutes","kind":"fn","old":"8c5be07814bde83d","new":"1a8b352a1de39261","interface_changed":false,"affected":["kernel.integer_axioms","kernel_cli.base_theory","kernel_cli.command","command_line","main","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","core_rt_text","computed_value","repl_eval","codegen_given","codegen.read_back","eval_files","build_core_command","comptime_value","repl_command","codegen_with","literal_errors","strata_command","comptime_values","std_library","compiled_d