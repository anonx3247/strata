fn(mut g: codegen.Gen, t: check.Ty) -> String {\n  name := f\"@\\\"copy:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  codegen.use_rt(mut g, \"strata_arena_copy\")\n  codegen.use_rt(mut g, \"strata_arena_list\")\n  saved := g\n  g.lines = []\n  g.proving = \"\"\n  g.can_unwind = false\n  g.unwinds = false\n  g.unwind_chain = []\n  g.allocas = []\n  g.next = 0\n  g.scopes = [codegen.no_scope()]\n  g.loops = []\n  codegen.block(mut g, \"start\")\n  b := codegen.V { ty: t, op: \"%b\" }\n  match t {\n    check.TList(et) => {\n      codegen.emit(\n        mut g,\n        \"%b = call ptr @strata_arena_list(ptr %a, ptr %d)\",\n      )\n      if codegen.counted(et) {\n        codegen.emit(mut g, \"%same = icmp eq ptr %b, %a\")\n        codegen.emit(mut g, \"br i1 %same, label %done, label %fix\")\n        codegen.block(mut g, \"fix\")\n        codegen.emit(mut g, \"%n = load i64, ptr %b\")\n        codegen.emit(\n          mut g,\n          \"%bufp = getelementptr i8, ptr %b, i64 8\",\n        )\n        codegen.emit(mut g, \"%buf = load ptr, ptr %bufp\")\n        codegen.emit(\n          mut g,\n          \"%data = getelementptr i64, ptr %buf, i64 2\",\n        )\n        codegen.br(mut g, \"loop\")\n        codegen.block(mut g, \"loop\")\n        codegen.emit(\n          mut g,\n          \"%i = phi i64 [ 0, %fix ], [ %next, %each ]\",\n        )\n        codegen.emit(mut g, \"%more = icmp slt i64 %i, %n\")\n        codegen.emit(mut g, \"br i1 %more, label %each, label %done\")\n        codegen.block(mut g, \"each\")\n        codegen.emit(\n          mut g,\n          \"%elp = getelementptr i64, ptr %data, i64 %i\",\n        )\n        codegen.emit(mut g, \"%el = load i64, ptr %elp\")\n        x := codegen.from_slot(mut g, \"%el\", et)\n        y := codegen.copy_out(mut g, x, \"%d\")\n        s := codegen.to_slot(mut g, y)\n        codegen.emit(mut g, f\"store i64 {s}, ptr %elp\")\n        codegen.emit(mut g, \"%next = add i64 %i, 1\")\n        codegen.br(mut g, \"loop\")\n      } else {\n        codegen.br(mut g, \"done\")\n      }\n    },\n    check.TUnion(ms) => {\n      codegen.emit(\n        mut g,\n        \"%b = call ptr @strata_arena_copy(ptr %a, ptr %d)\",\n      )\n      codegen.emit(mut g, \"%same = icmp eq ptr %b, %a\")\n      codegen.emit(mut g, \"br i1 %same, label %done, label %fix\")\n      codegen.block(mut g, \"fix\")\n      // a member's own block, already copied, or a box\n      labels := codegen.on_members(mut g, b, ms)\n      for (k, m) in enumerate(ms) {\n        codegen.block(mut g, get(labels, k) ?? \"\")\n        if codegen.boxed(g, m) {\n          codegen.copy_fields(mut g, b, [m])\n        } else {\n          codegen.copy_held(mut g, codegen.V { ..b, ty: m })\n        }\n        codegen.br(mut g, \"done\")\n      }\n    },\n    _ => {\n      codegen.emit(\n        mut g,\n        \"%b = call ptr @strata_arena_copy(ptr %a, ptr %d)\",\n      )\n      codegen.emit(mut g, \"%same = icmp eq ptr %b, %a\")\n      codegen.emit(mut g, \"br i1 %same, label %done, label %fix\")\n      codegen.block(mut g, \"fix\")\n      codegen.copy_held(mut g, b)\n      codegen.br(mut g, \"done\")\n    },\n  }\n  codegen.block(mut g, \"done\")\n  codegen.emit(mut g, \"ret ptr %b\")\n  def := join([f\"define ptr {name}(ptr %a, ptr %d) {{\"]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, def)\n  name\n}","old_text":"/// The function copying a value of type `t` out of arena `%d`: the block\n/// itself (`strata_arena_copy`, `strata_arena_list`), then, when the arena\n/// made it, what it holds, recursively.\nfn copy_fn(mut g: codegen.Gen, t: Ty) -> String {\n  name := f\"@\\\"copy:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  codegen.use_rt(mut g, \"strata_arena_copy\")\n  codegen.use_rt(mut g, \"strata_arena_list\")\n  saved := g\n  g.lines = []\n  g.proving = \"\"\n  g.can_unwind = false\n  g.unwinds = false\n  g.unwind_chain = []\n  g.allocas = []\n  g.next = 0\n  g.scopes = [codegen.no_scope()]\n  g.loops = []\n  codegen.block(mut g, \"start\")\n  b := codegen.V { ty: t, op: \"%b\" }\n  match t {\n    TList(et) => {\n      codegen.emit(\n        mut g,\n        \"%b = call ptr @strata_arena_list(ptr %a, ptr %d)\",\n      )\n      if codegen.counted(et) {\n        codegen.emit(mut g, \"%same = icmp eq ptr %b, %a\")\n        codegen.emit(mut g, \"br i1 %same, label %done, label %fix\")\n        codegen.block(mut g, \"fix\")\n        codegen.emit(mut g, \"%n = load i64, ptr %b\")\n        codegen.emit(\n          mut g,\n          \"%bufp = getelementptr i8, ptr %b, i64 8\",\n        )\n        codegen.emit(mut g, \"%buf = load ptr, ptr %bufp\")\n        codegen.emit(\n          mut g,\n          \"%data = getelementptr i64, ptr %buf, i64 2\",\n        )\n        codegen.br(mut g, \"loop\")\n        codegen.block(mut g, \"loop\")\n        codegen.emit(\n          mut g,\n          \"%i = phi i64 [ 0, %fix ], [ %next, %each ]\",\n        )\n        codegen.emit(mut g, \"%more = icmp slt i64 %i, %n\")\n        codegen.emit(mut g, \"br i1 %more, label %each, label %done\")\n        codegen.block(mut g, \"each\")\n        codegen.emit(\n          mut g,\n          \"%elp = getelementptr i64, ptr %data, i64 %i\",\n        )\n        codegen.emit(mut g, \"%el = load i64, ptr %elp\")\n        x := codegen.from_slot(mut g, \"%el\", et)\n        y := codegen.copy_out(mut g, x, \"%d\")\n        s := codegen.to_slot(mut g, y)\n        codegen.emit(mut g, f\"store i64 {s}, ptr %elp\")\n        codegen.emit(mut g, \"%next = add i64 %i, 1\")\n        codegen.br(mut g, \"loop\")\n      } else {\n        codegen.br(mut g, \"done\")\n      }\n    },\n    TUnion(ms) => {\n      codegen.emit(\n        mut g,\n        \"%b = call ptr @strata_arena_copy(ptr %a, ptr %d)\",\n      )\n      codegen.emit(mut g, \"%same = icmp eq ptr %b, %a\")\n      codegen.emit(mut g, \"br i1 %same, label %done, label %fix\")\n      codegen.block(mut g, \"fix\")\n      // a member's own block, already copied, or a box\n      labels := codegen.on_members(mut g, b, ms)\n      for (k, m) in enumerate(ms) {\n        codegen.block(mut g, get(labels, k) ?? \"\")\n        if codegen.boxed(g, m) {\n          codegen.copy_fields(mut g, b, [m])\n        } else {\n          codegen.copy_held(mut g, codegen.V { ..b, ty: m })\n        }\n        codegen.br(mut g, \"done\")\n      }\n    },\n    _ => {\n      codegen.emit(\n        mut g,\n        \"%b = call ptr @strata_arena_copy(ptr %a, ptr %d)\",\n      )\n      codegen.emit(mut g, \"%same = icmp eq ptr %b, %a\")\n      codegen.emit(mut g, \"br i1 %same, label %done, label %fix\")\n      codegen.block(mut g, \"fix\")\n      codegen.copy_held(mut g, b)\n      codegen.br(mut g, \"done\")\n    },\n  }\n  codegen.block(mut g, \"done\")\n  codegen.emit(mut g, \"ret ptr %b\")\n  def := join([f\"define ptr {name}(ptr %a, ptr %d) {{\"]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, def)\n  name\n}"},{"name":"codegen.copy_held","kind":"fn","old":"9bb4173b8016b78e","new":"221b7f924df7c03e","interface_changed":false,"affected":[],"module":"codegen","text":"/// Copies out of arena `%d` what block `b` holds (a record's, variant's or\n/// tuple's, itself already copied). The code continues after it.\nfn copy_held(mut g: codegen.Gen, b: codegen.V) {\n  match b.ty {\n    check.TNamed { name: \"Tuple\", args } => codegen.copy_fields(mut g, b, args),\n    check.TNamed { .. } => {\n      cs := codegen.ctors_of(g, b.ty).filter(\n        c -> len(codegen.fields_of(g, c, b.ty)) > 0,\n      )\n      if len(cs) == 1 {\n        codegen.copy_fields(\n          mut g,\n          b,\n          codegen.fields_of(g, get(cs, 0) ?? \"\", b.ty).map(f -> f.1),\n        )\n      } else if len(cs) > 1 {\n        after := codegen.label(mut g, \"copied\")\n        labels := codegen.on_ctor(mut g, b, cs)\n        for (k, c) in enumerate(cs) {\n          codegen.block(mut g, get(labels, k) ?? \"\")\n          codegen.copy_fields(\n            mut g,\n            b,\n            codegen.fields_of(g, c, b.ty).map(f -> f.1),\n          )\n          codegen.br(mut g, after)\n        }\n        codegen.block(mut g, after)\n      }\n    },\n    _ => (),\n  }\n}","old_text":"/// Copies out of arena `%d` what block `b` holds (a record's, variant's or\n/// tuple's, itself already copied). The code continues after it.\nfn copy_held(mut g: codegen.Gen, b: codegen.V) {\n  match b.ty {\n    TNamed { name: \"Tuple\", args } => codegen.copy_fields(mut g, b, args),\n    TNamed { .. } => {\n      cs := codegen.ctors_of(g, b.ty).filter(\n        c -> len(codegen.fields_of(g, c, b.ty)) > 0,\n      )\n      if len(cs) == 1 {\n        codegen.copy_fields(\n          mut g,\n          b,\n          codegen.fields_of(g, get(cs, 0) ?? \"\", b.ty).map(f -> f.1),\n        )\n      } else if len(cs) > 1 {\n        after := codegen.label(mut g, \"copied\")\n        labels := codegen.on_ctor(mut g, b, cs)\n        for (k, c) in enumerate(cs) {\n          codegen.block(mut g, get(labels, k) ?? \"\")\n          codegen.copy_fields(\n            mut g,\n            b,\n            codegen.fields_of(g, c, b.ty).map(f -> f.1),\n          )\n          codegen.br(mut g, after)\n        }\n        codegen.block(mut g, after)\n      }\n    },\n    _ => (),\n  }\n}"},{"name":"codegen.copy_fields","kind":"fn","old":"2adaf21625428ec3","new":"8109a81c530cf6d4","interface_changed":true,"affected":["codegen.copy_fn","codegen.copy_held","codegen.copy_out","codegen.arena_run","codegen.call_fn_want","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.expr_node","codegen.expr_want_node",