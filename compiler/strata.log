me_command","move_command"],"module":"kernel","text":"/// `A ⊢ a = b` and `B ⊢ b = c` give `A ∪ B ⊢ a = c`.\npub fn chain_equalities(\n  ab: kernel.Theorem,\n  bc: kernel.Theorem,\n) -> Result[kernel.Theorem, String] {\n  match (\n    kernel.split_equation(kernel.conclusion(ab)),\n    kernel.split_equation(kernel.conclusion(bc)),\n  ) {\n    (Some((a, b)), Some((b2, c))) => if kernel.same_term(b, b2) {\n      Ok(kernel.make_theorem(kernel.union_of_terms(\n        kernel.assumptions(ab),\n        kernel.assumptions(bc),\n      ), kernel.equation(a, c)!, kernel.joined_dependencies(\n        kernel.depends_on(ab),\n        kernel.depends_on(bc),\n      )!, kernel.Step { rule: \"trans\", premises: [ab, bc] }))\n    } else {\n      Err(\"trans: the middle terms differ\")\n    },\n    _ => Err(\"trans: not equations\"),\n  }\n}","old_text":"/// `A ⊢ a = b` and `B ⊢ b = c` give `A ∪ B ⊢ a = c`.\npub fn chain_equalities(\n  ab: kernel.Theorem,\n  bc: kernel.Theorem,\n) -> Result[kernel.Theorem, String] {\n  match (\n    kernel.split_equation(kernel.conclusion(ab)),\n    kernel.split_equation(kernel.conclusion(bc)),\n  ) {\n    (Some((a, b)), Some((b2, c))) => if kernel.same_term(b, b2) {\n      Ok(kernel.make_theorem(kernel.union_of_terms(\n        kernel.assumptions(ab),\n        kernel.assumptions(bc),\n      ), kernel.equation(a, c)!, kernel.joined_dependencies(\n        kernel.depends_on(ab),\n        kernel.depends_on(bc),\n      )!))\n    } else {\n      Err(\"trans: the middle terms differ\")\n    },\n    _ => Err(\"trans: not equations\"),\n  }\n}"},{"name":"kernel.apply_equal_to_equal","kind":"fn","old":"fcfd91322ef4c3d3","new":"403fc871f3574516","interface_changed":false,"affected":["kernel_arith.linear_form","kernel_arith.merge","kernel_arith.scale","kernel_logic.swap_sides","kernel_logic.apply_function_to_equal","kernel_logic.apply_equal_functions","kernel_logic.normal_form","kernel_tactics.rewrite_all","kernel_arith.simp_step","kernel_arith.refute","kernel_arit