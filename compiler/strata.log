mand","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.foreign_call","codegen.equal","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","codegen.read_back","eval_files"],"module":"codegen","text":"/// `v` converted to type `want`: a trait value, a union, a sized integer\n/// for an integer literal, or the empty table for an empty list where a set\n/// or dict is wanted (`verify`'s counterexamples write those).\nfn converted(mut g: codegen.Gen, v: codegen.V, want: check.Ty) -> codegen.V {\n  x := codegen.as_type(mut g, v, want)\n  match (want, x.ty) {\n    (check.TTrait(tr), check.TTrait(_)) => x,\n    (check.TTrait(tr), _) => codegen.to_dyn(mut g, x, tr),\n    (check.TUnion(_), _) => codegen.to_union(mut g, x, want),\n    (check.TNamed { name: \"Set\", .. }, check.TList(check.TAny)) | (check.TNamed { name: \"Dict\", .. }, check.TList(check.TAny)) => {\n      e := codegen.collection_builtin(mut g, if codegen.is_set(want) {\n        \"set\"\n      } else {\n        \"dict\"\n      }, [x])\n      codegen.retype_temp(\n        mut g,\n        codegen.V { ..e, ty: codegen.better(e.ty, want) },\n        want,\n      )\n    },\n    // a finite iterator where a list is wanted (a `List` parameter, field\n    // or annotation): its list, as `to_list` gives it\n    (check.TList(_), check.TNamed { name, .. }) => if codegen.finite_iterator(g, name) {\n      codegen.local_owned(mut g, \"$listed\", x)\n      codegen.expr(mut g, ast.Call {\n        callee: ast.Var(\"to_list\"),\n        args: [ast.Var(\"$listed\")],\n      })\n    } else {\n      codegen.retype_temp(\n        mut g,\n        codegen.V { ..x, ty: codegen.better(x.ty, want) },\n        want,\n      )\n    },\n    _ => codegen.retype_temp(\n      mut g,\n      codegen.V { ..x, ty: codegen.better(x.ty, want) },\n      want,\n    ),\n  }\n}","old_text":"/// `v` converted to type `want`: a trait value, a union, a sized integer\n/// for an integer literal, or the empty table for an empty list where a set\n/// or dict is wanted (`verify`'s counterexamples write those).\nfn converted(mut g: codegen.Gen, v: codegen.V, want: Ty) -> codegen.V {\n  x := codegen.as_type(mut g, v, want)\n  match (want, x.ty) {\n    (TTrait(tr), TTrait(_)) => x,\n    (TTrait(tr), _) => codegen.to_dyn(mut g, x, tr),\n    (TUnion(_), _) => codegen.to_union(mut g, x, want),\n    (TNamed { name: \"Set\", .. }, TList(TAny)) | (TNamed { name: \"Dict\", .. }, TList(TAny)) => {\n      e := codegen.collection_builtin(mut g, if codegen.is_set(want) {\n        \"set\"\n      } else {\n        \"dict\"\n      }, [x])\n      codegen.retype_temp(\n        mut g,\n        codegen.V { ..e, ty: codegen.better(e.ty, want) },\n        want,\n      )\n    },\n    // a finite iterator where a list is wanted (a `List` parameter, field\n    // or annotation): its list, as `to_list` gives it\n    (TList(_), TNamed { name, .. }) => if codegen.finite_iterator(g, name) {\n      codegen.local_owned(mut g, \"$listed\", x)\n      codegen.expr(mut g, ast.Call {\n        callee: ast.Var(\"to_list\"),\n        args: [ast.Var(\"$listed\")],\n      })\n    } else {\n      codegen.retype_temp(\n        mut g,\n        codegen.V { ..x, ty: codegen.better(x.ty, want) },\n        want,\n      )\n    },\n    _ => codegen.retype_temp(\n      mut g,\n      codegen.V { ..x, ty: codegen.better(x.ty, want) },\n      want,\n    ),\n  }\n}"},{"name":"codegen.trace_enter","kind":"fn","old":"4f86c389b801ccea","new":"e4a1b6c6dc4fb340","interface_changed":false,"affected":[],"module":"codegen","text":"/// `--trace`: the call about to run, its arguments shown as code\n/// (`→ total([1, 2])`).\nfn trace_enter(mut g: codegen.Gen, f: ast.FnDecl) {\n  if codegen.probe(f.name) {\n    return\n  }\n  codegen.push_scope(mut g)\n  mut parts := []\n  for p in f.params {\n    match codegen.lookup(g, p.name) {\n      Some(l) => if codegen.has_value(l.ty) {\n        pv := codegen.load(mut g, l)\n        if parts != [] {\n          sep := codegen.lit(mut g, \", \")\n          mut parts.push(sep)\n        }\n        sv := codegen.shown(mut g, pv)\n        mut parts.push(sv)\n      },\n      None => (),\n    }\n  }\n  args := codegen.concat(mut g, parts)\n  name := codegen.lit(mut g, f.name)\n  _ := codegen.call(\n    mut g,\n    check.TUnit,\n    \"strata_trace_enter\",\n    [name, args],\n  )\n  codegen.pop_scope(mut g)\n}","old_text":"/// `--trace`: the call about to run, its arguments shown as code\n/// (`→ total([1, 2])`).\nfn trace_enter(mut g: codegen.Gen, f: ast.FnDecl) {\n  if codegen.probe(f.name) {\n    return\n  }\n  codegen.push_scope(mut g)\n  mut parts := []\n  for p in f.params {\n    match codegen.lookup(g, p.name) {\n      Some(l) => if codegen.has_value(l.ty) {\n        pv := codegen.load(mut g, l)\n        if parts != [] {\n          sep := codegen.lit(mut g, \", \")\n          mut parts.push(sep)\n        }\n        sv := codegen.shown(mut g, pv)\n        mut parts.push(sv)\n      },\n      None => (),\n    }\n  }\n  args := codegen.concat(mut g, parts)\n  name := codegen.lit(mut g, f.name)\n  _ := codegen.call(mut g, TUnit, \"strata_trace_enter\", [name, args])\n  codegen.pop_scope(mut g)\n}"},{"name":"codegen.trace_leave","kind":"fn","old":"cec088f8ca8772fa","new":"43df8902ee3109c4","interface_changed":false,"affected":[],"module":"codegen","text":"/// `--trace`: the call's return and its value (`← total: 3`).\nfn trace_leave(mut g: codegen.Gen, name: String, result: codegen.V) {\n  if codegen.probe(name) {\n    return\n  }\n  codegen.push_scope(mut g)\n  n := codegen.lit(mut g, name)\n  sv := if codegen.has_value(result.ty) {\n    codegen.shown(mut g, result)\n  } else {\n    codegen.V { ty: check.TStr, op: \"null\" }\n  }\n  _ := codegen.call(mut g, check.TUnit, \"strata_trace_leave\", [n, sv])\n  codegen.pop_scope(mut g)\n}","old_text":"/// `--trace`: the call's return and its value (`← total: 3`).\nfn trace_leave(mut g: codegen.Gen, name: String, result: codegen.V) {\n  if codegen.probe(name) {\n    return\n  }\n  codegen.push_scope(mut g)\n  n := codegen.lit(mut g, name)\n  sv := if codegen.has_value(result.ty) {\n    codegen.shown(mut g, result)\n  } else {\n    codegen.V { ty: TStr, op: \"null\" }\n  }\n  _ := codegen.call(mut g, TUnit, \"strata_trace_leave\", [n, sv])\n  codegen.pop_scope(mut g)\n}"},{"name":"codegen.declaration_of","kind":"fn","old":"198321181065a93b","new":"f08886f4f73524c6","interface_changed":false,"affected":[],"module":"codegen","text":"/// A precompiled function's declaration, matching what `function` defines.\nfn declaration_of(mut g: codegen.Gen, sym: String, f: ast.FnDecl) -> String {\n  saved := g.sub\n  g.sub = Dict[String, check.Ty] {}\n  ret := codegen.lower(mut g, f.ret)\n  mut params := []\n  for p in f.params {\n    t := codegen.lower(mut g, p.ty)\n    if p.mutable {\n      mut params.push(\"ptr\")\n    } else if codegen.has_value(t) {\n      mut params.push(codegen.ll(t))\n    }\n  }\n  g.sub = saved\n  ps := join(params, \", \")\n  f\"declare {codegen.result_ll(g, sym, ret)} {sym}({ps})\"\n}","old_text":"/// A precompiled function's declaration, matching what `function` defines.\nfn declaration_of(mut g: codegen.Gen, sym: String, f: ast.FnDecl) -> String {\n  saved := g.sub\n  g.sub = Dict[String, Ty] {}\n  ret := codegen.lower(mut g, f.ret)\n  mut params := []\n  for p in f.params {\n    t := codegen.lower(mut g, p.ty)\n    if p.mutable {\n      mut params.push(\"ptr\")\n    } else if codegen.has_value(t) {\n      mut params.push(codegen.ll(t))\n    }\n  }\n  g.sub = saved\n  ps := join(params, \", \")\n  f\"declare {codegen.result_ll(g, sym, ret)} {sym}({ps})\"\n}"},{"name":"codegen.precompilable","kind":"fn","old":"96498f5f08d78a49","new":"b028370b2a9c9ef2","interface_changed":false,"affected":[],"module":"codegen","text":"/// Whether std's function `k` can go in the precompiled library: not\n/// generic, no compile-time parameter, no trait value in or out (those are\n/// compiled per implementation), not foreign.\nfn precompilable(mut g: codegen.Gen, k: String, f: ast.FnDecl) -> Bool {\n  if len(f.type_params) > 0\n    || f.params.any(p -> p.compile_time)\n    || contains(g.externs, k) {\n    return false\n  }\n  saved := g.sub\n  g.sub = Dict[String, check.Ty] {}\n  mut ok := !(codegen.lower(mut g, f.ret) is check.TTrait)\n  for p in f.params {\n    if codegen.lower(mut g, p.ty) is check.TTrait {\n      ok = false\n    }\n  }\n  g.sub = saved\n  ok\n}","old_text":"/// Whether std's function `k` can go in the precompiled library: not\n/// generic, no compile-time parameter, no trait value in or out (those are\n/// compiled per implementation), not foreign.\nfn precompilable(mut g: codegen.Gen, k: String, f: ast.FnDecl) -> Bool {\n  if len(f.type_params) > 0\n    || f.params.any(p -> p.compile_time)\n    || contains(g.externs, k) {\n    return false\n  }\n  saved := g.sub\n  g.sub = Dict[String, Ty] {}\n  mut ok := !(codegen.lower(mut g, f.ret) is TTrait)\n  for p in f.params {\n    if codegen.lower(mut g, p.ty) is TTrait {\n      ok = false\n    }\n  }\n  g.sub = saved\n  ok\n}"},{"name":"codegen.new_gen","kind":"fn","old":"8e5dddf14d866c4d","new":"241d7d8fa74bd0c1","interface_changed":false,"affected":[],"module":"codegen","text":"/// The code generator's state for the program `given`: its types,\n/// constructor tags, traits and implementations, refinements and\n/// `distinct` types, and the instances to compile first. Also the program's\n/// `main`, or a stand-in when no program is compiled (tests, fuzz drivers,\n/// calls, std's library).\nfn new_gen(\n  given: List[ast.Decl],\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  proofs: List[String],\n  tests: Option[List[(String, String)]],\n  fuzz: List[String],\n  fuzz_text: Bool,\n  calls: List[String],\n  trace: Bool,\n  library: List[String],\n  precompiled: List[String],\n) -> Result[(codegen.Gen, ast.FnDecl), List[String]] {\n  // desugared: `compiler/desugar` made mixed unions into sums and unions.\n  // A capability is a record with no fields.\n  mut decls := []\n  for d in given {\n    decls += codegen.capability_types(d)\n  }\n  mut fns := Dict[String, ast.FnDecl] {}\n  // the list built-ins written in Strata, by qualified name\n  for d in check.typed(prelude, core) {\n    match d.kind {\n      ast.FnDef(f) => mut fns.insert(codegen.prelude_name(f.name), f),\n      _ => (),\n    }\n  }\n  mut defaults := Dict[String, ast.Expr] {}\n  // with the checker's inferred types written into functions and `impl`\n  // methods\n  typed_decls := timings.timed(\"check\", () -> check.typed(decls, core))\n  for d in typed_decls {\n    match d.kind {\n      ast.FnDef(f) => {\n        // by its qualified name, as calls name it: `std.json.parse`\n        q := codegen.qualified(d.module, f.name)\n        mut fns.insert(q, ast.FnDecl { ..f, name: q })\n      },\n      // a C function: its body is the foreign call\n      ast.ExternDef(ast.ExternDecl { lang: ast.C, item: ast.ExternFn(f) }) => {\n        q := codegen.qualified(d.module, f.name)\n        mut fns.insert(q, ast.FnDecl { ..f, name: q })\n      },\n      ast.TypeDef(t) => {\n        mut fields := match t.body {\n          ast.RecordBody(fs) => fs.map(f -> (t.name, f)),\n          _ => [],\n        }\n        match t.body {\n          ast.SumBody(vs) => {\n            for v in vs {\n              match v.payload {\n                ast.RecordPayload(fs) => {\n                  fields += fs.map(f -> (v.name, f))\n                },\n                _ => (),\n              }\n            }\n          },\n          _ => (),\n        }\n        for (c, f) in fields {\n          match f.default {\n            Some(x) => mut defaults.insert(\n              codegen.qualified(d.module, c) + \".\" + f.name,\n              x,\n            ),\n            None => (),\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  // a capability trait (`Files`) is a trait here: its values are those of\n  // its implementations, `MemFiles` too\n  types := check.types_of(\n    decls.map(\n      d ->\n        match d.kind {\n          ast.TraitDef(t) => ast.Decl { ..d, kind: ast.TraitDef(ast.TraitDecl { ..t, capability: false }) },\n          _ => d,\n        },\n    ),\n  )\n  mut traits := Dict[String, ast.TraitDecl] {}\n  for d in decls {\n    match d.kind {\n      ast.TraitDef(t) => mut traits.insert(codegen.qualified(d.module, t.name), t),\n      _ => (),\n    }\n  }\n  // an `impl` of a trait from its own module names it as written there\n  // (`Toml` in std.toml): qualify it as `traits` does\n  mut impls := []\n  for d in typed_decls {\n    match d.kind {\n      ast.ImplDef(im) => {\n        h := codegen.texpr_head(im.for_type)\n        // core's types (`KeyPath`) are named bare everywhere\n        head := if contains(h, \".\")\n          || codegen.builtin_head(h)\n          || contains(types.named, h)\n            && !contains(types.named, codegen.qualified(d.module, h)) {\n          h\n        } else {\n          codegen.qualified(d.module, h)\n        }\n        tq := codegen.qualified(d.module, im.trait_name)\n        tn := if im.trait_name != \"\"\n          && !contains(traits, im.trait_name)\n          && contains(traits, tq) {\n          tq\n        } else {\n          im.trait_name\n        }\n        mut impls.push(\n          codegen.ImplEntry {\n            head,\n            decl: ast.ImplDecl { ..im, trait_name: tn },\n          },\n        )\n      },\n      _ => (),\n    }\n  }\n  // constructor order: `Option`'s and `Result`'s first, then as declared\n  mut order := [\"None\", \"Some\", \"Ok\", \"Err\"]\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => match t.body {\n        ast.RecordBody(_) => mut order.push(codegen.qualified(d.module, t.name)),\n        ast.SumBody(vs) => {\n          order += vs.map(v -> codegen.qualified(d.module, v.name))\n        },\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  // tags from the type's name and the constructor's index: the same in\n  // every program, so std's precompiled code and the program agree\n  mut tags := Dict[String, Int] {}\n  mut placed := Dict[String, Int] {}\n  for c in order + keys(types.ctors) {\n    if contains(types.ctors, c) && !contains(tags, c) {\n      owner := (get(types.ctors, c) ?? codegen.no_shape()).owner\n      i := get(placed, owner) ?? 0\n      mut placed.insert(owner, i + 1)\n      mut tags.insert(c, codegen.stable_tag(owner, i))\n    }\n  }\n  mut data := Set[String] { \"Tuple\" }\n  for c in keys(types.ctors) {\n    mut data.insert((get(types.ctors, c) ?? codegen.no_shape()).owner)\n    // a variant is a type too: its values are blocks, never boxed\n    mut data.insert(c)\n  }\n  // `strata test`: each test is a function with no parameters\n  main := match (get(fns, \"main\"), tests) {\n    (Some(f), _) => f,\n    (None, Some(ts)) => get(fns, (get(ts, 0) ?? (\"\", \"\")).0) ?? codegen.no_fn(),\n    // a library (`strata build --lib`): its exports, no `main`\n    (None, None) => if fuzz != []\n      || library != []\n      || calls != []\n      || codegen.exports_of(given) != [] {\n      codegen.no_fn()\n    } else {\n      return Err([\"no `main` function\"])\n    },\n  }\n  // `main` compiled from (and all it reaches) only for a program: never for\n  // fuzz drivers, calls or std's library, even when the package has one\n  // (verify's probes of the compiler would compile all of it)\n  program := main.name != \"\" && fuzz == [] && library == [] && calls == []\n  mut g := codegen.Gen {\n    caps: set(\n      [codegen.qualified(d.module, c.name) for d in given where d.kind is ast.CapabilityDef for c in match d.kind {\n        ast.CapabilityDef(c) => [c],\n        _ => [],\n      }],\n    ),\n    strings: Dict[String, String] {},\n    globals: [],\n    used: Set[String] {},\n    fns,\n    errs: [],\n    types,\n    tags,\n    data,\n    defaults,\n    traits,\n    impls,\n    helpers: Set[String] {},\n    helper_defs: [],\n    box_tags: Dict[String, Int] {},\n    union_names: Dict[String, String] {},\n    generic_aliases: codegen.generic_aliases_of(decls),\n    refines: Dict[String, (ast.TypeExpr, ast.Expr)] {},\n    refine_params: Dict[String, List[String]] {},\n    distincts: Set[String] {},\n    field_types: Dict[String, ast.TypeExpr] {},\n    variant_index: Dict[String, Int] {},\n    declared: Dict[String, ast.TypeExpr] {},\n    bound_slots: Dict[String, List[String]] {},\n    left_out: 0,\n    kept: 0,\n    keeps: None,\n    stack_next: false,\n    stack_made: [],\n    instances: match tests {\n      Some(ts) => set(ts.map(\n        t -> codegen.inst_sym(\n          t.0,\n          codegen.no_fn(),\n          Dict[String, check.Ty] {},\n        ),\n      )),\n      None => if !program {\n        Set[String] {}\n      } else {\n        Set[String] { \"@\\\"strata:main\\\"\" }\n      },\n    },\n    queue: match tests {\n      Some(ts) => ts.map(t -> (t.0, Dict[String, check.Ty] {})),\n      None => if !program {\n        []\n      } else {\n        [(\"main\", Dict[String, check.Ty] {})]\n      },\n    },\n    lambdas: 0,\n    fname: \"\",\n    sub: Dict[String, check.Ty] {},\n    in_prelude: false,\n    lines: [],\n    allocas: [],\n    next: 0,\n    scopes: [],\n    loops: [],\n    ret: check.TUnit,\n    proofs: codegen.proofs_of(proofs),\n    proving: \"\",\n    tasks: library != []\n      || codegen.starts_tasks(decls, false)\n        && (tests is Some\n          || fuzz != []\n          || calls != []\n          || codegen.cancels(decls)),\n    supervises: library != [] || codegen.starts_tasks(decls, true),\n    can_unwind: false,\n    unwinds: false,\n    externs: codegen.foreign_fns(decls),\n    handles: codegen.foreign_types(decls),\n    statics: codegen.statics_of(decls),\n    bare: false,\n    gens: Dict[String, String] {},\n    fuzzing: fuzz != [] || calls != [],\n    sandboxed: fuzz != [],\n    fuzz_text,\n    tracing: trace,\n    precompiled: set(precompiled),\n    library_mode: library != [],\n    current: \"\",\n    callers: Dict[String, Set[String]] {},\n    failed: Set[String] {},\n    why: Dict[String, List[String]] {},\n  }\n  // `distinct` types: a one-field block, `value`, shown as `D(x)`\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => if t.distinct {\n        q := codegen.qualified(d.module, t.name)\n        under := match t.body {\n          ast.Alias(a) => a,\n          _ => ast.UnitType,\n        }\n        saved := g.sub\n        mut sub := Dict[String, check.Ty] {}\n        for p in t.params {\n          mut sub.insert(p, check.TGen(p))\n        }\n        g.sub = sub\n        u := codegen.lower(mut g, under)\n        g.sub = saved\n        g.types = check.Types { ..g.types, named: {\n          mut copy := g.types.named\n          mut copy.insert(q, t.params)\n          copy\n        }, ctors: {\n          mut copy := g.types.ctors\n          mut copy.insert(\n            q,\n            check.Shape {\n              owner: q,\n              fields: [(\"value\", u)],\n              positional: true,\n              required: [],\n              params: t.params,\n            },\n          )\n          copy\n        } }\n        mut g.data.insert(q)\n        mut g.tags.insert(q, codegen.stable_tag(q, 0))\n      },\n      _ => (),\n    }\n  }\n  // refinements: core's (`Natural`, ...), then the program's. Refined\n  // records and sums are compiled like the others; the checker leaves them\n  // out of its model.\n  mut later: List[(String, String, ast.TypeDecl)] = []\n  for d in prelude + decls {\n    match d.kind {\n      ast.TypeDef(t) => {\n        q := codegen.qualified(d.module, t.name)\n        if t.distinct {\n          mut g.distincts.insert(q)\n        }\n        match t.body {\n          ast.RecordBody(fs) => {\n            for f in fs {\n              mut g.field_types.insert(q + \".\" + f.name, f.ty)\n            }\n          },\n          ast.SumBody(vs) => {\n            for (k, v) in enumerate(vs) {\n              vq := codegen.qualified(d.module, v.name)\n              mut g.variant_index.insert(vq, k)\n              // core's names are global: `Some`\n              if starts_with(d.module, \"core\") {\n                mut g.variant_index.insert(v.name, k)\n              }\n              match v.payload {\n                ast.RecordPayload(fs) => {\n                  for f in fs {\n                    mut g.field_types.insert(vq + \".\" + f.name, f.ty)\n                  }\n                },\n                ast.Positional(ts) => {\n                  for (i, ft) in enumerate(ts) {\n                    mut g.field_types.insert(\n                      vq + \".\" + to_string(i),\n                      ft,\n                    )\n                    if starts_with(d.module, \"core\") {\n                      mut g.field_types.insert(\n                        v.name + \".\" + to_string(i),\n                        ft,\n                      )\n                    }\n                  }\n                },\n                _ => (),\n              }\n            }\n          },\n          _ => (),\n        }\n        match t.refinement {\n          Some(pred) => {\n            base := match t.body {\n              ast.Alias(a) => a,\n              _ => ast.Named { name: q, args: [] },\n            }\n            mut g.refines.insert(q, (base, pred))\n            mut g.refine_params.insert(q, t.params)\n            // core's names are global: `Natural`\n            if starts_with(d.module, \"core\") {\n              mut g.refines.insert(t.name, (base, pred))\n              mut g.refine_params.insert(t.name, t.params)\n            }\n            if !t.distinct\n              && !(t.body is ast.Alias)\n              && !contains(g.types.named, q) {\n              mut later.push((q, d.module, t))\n            }\n          },\n          None => (),\n        }\n      },\n      _ => (),\n    }\n  }\n  // Refined records and sums are added so that the refined types their\n  // fields hold come first, whatever the module order: a generic\n  // `MemQueue[P, E]`'s `Dict[TaskId, Entry[P]]` needs `Entry`. One that\n  // still cannot be added is added as is, its errors kept.\n  mut left := later\n  for _ in later {\n    if left == [] {\n      break\n    }\n    mut still := []\n    for (q, m, t) in left {\n      before := g\n      codegen.add_type(mut g, q, m, t)\n      if len(g.errs) > len(before.errs) {\n        g = before\n        mut still.push((q, m, t))\n      }\n    }\n    if len(still) == len(left) {\n      break\n    }\n    left = still\n  }\n  for (q, m, t) in left {\n    codegen.add_type(mut g, q, m, t)\n  }\n  // records and sums with fields of types outside the checker's model (a\n  // `distinct` type's, `user: UserId`; a refined record's, `p: Pos`), now\n  // that those are known\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => if !t.distinct && t.refinement is None {\n        q := codegen.qualified(d.module, t.name)\n        open := codegen.ctors_of(g, check.TNamed { name: q, args: [] }).any(\n          c ->\n            (get(g.types.ctors, c) ?? codegen.no_shape()).fields.any(\n              f -> codegen.has_any(f.1),\n            ),\n        )\n        if open && (t.body is ast.RecordBody || t.body is ast.SumBody) {\n          before := g\n          codegen.add_type(mut g, q, d.module, t)\n          if len(g.errs) > len(before.errs) {\n            g = before\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  // the calls a cancelled task may leave at: in a program whose panics do\n  // not leave functions, those reaching a wait. Under `--trace`, every call.\n  if g.tasks && !g.supervises && !trace {\n    (ws, known) := codegen.waits_of(fns, impls, traits, decls)\n    g.waiting = ws\n    g.waits_known = known\n  }\n  Ok((g, main))\n}","old_text":"/// The code generator's state for the program `given`: its types,\n/// constructor tags, traits and implementations, refinements and\n/// `distinct` types, and the instances to compile first. Also the program's\n/// `main`, or a stand-in when no program is compiled (tests, fuzz drivers,\n/// calls, std's library).\nfn new_gen(\n  given: List[ast.Decl],\n  core: builtins.Core,\n  prelude: List[ast.Decl],\n  proofs: List[String],\n  tests: Option[List[(String, String)]],\n  fuzz: List[String],\n  fuzz_text: Bool,\n  calls: List[String],\n  trace: Bool,\n  library: List[String],\n  precompiled: List[String],\n) -> Result[(codegen.Gen, ast.FnDecl), List[String]] {\n  // desugared: `compiler/desugar` made mixed unions into sums and unions.\n  // A capability is a record with no fields.\n  mut decls := []\n  for d in given {\n    decls += codegen.capability_types(d)\n  }\n  mut fns := Dict[String, ast.FnDecl] {}\n  // the list built-ins written in Strata, by qualified name\n  for d in typed(prelude, core) {\n    match d.kind {\n      ast.FnDef(f) => mut fns.insert(codegen.prelude_name(f.name), f),\n      _ => (),\n    }\n  }\n  mut defaults := Dict[String, ast.Expr] {}\n  // with the checker's inferred types written into functions and `impl`\n  // methods\n  typed_decls := timings.timed(\"check\", () -> typed(decls, core))\n  for d in typed_decls {\n    match d.kind {\n      ast.FnDef(f) => {\n        // by its qualified name, as calls name it: `std.json.parse`\n        q := codegen.qualified(d.module, f.name)\n        mut fns.insert(q, ast.FnDecl { ..f, name: q })\n      },\n      // a C function: its body is the foreign call\n      ast.ExternDef(ast.ExternDecl { lang: ast.C, item: ast.ExternFn(f) }) => {\n        q := codegen.qualified(d.module, f.name)\n        mut fns.insert(q, ast.FnDecl { ..f, name: q })\n      },\n      ast.TypeDef(t) => {\n        mut fields := match t.body {\n          ast.RecordBody(fs) => fs.map(f -> (t.name, f)),\n          _ => [],\n        }\n        match t.body {\n          ast.SumBody(vs) => {\n            for v in vs {\n              match v.payload {\n                ast.RecordPayload(fs) => {\n                  fields += fs.map(f -> (v.name, f))\n                },\n                _ => (),\n              }\n            }\n          },\n          _ => (),\n        }\n        for (c, f) in fields {\n          match f.default {\n            Some(x) => mut defaults.insert(\n              codegen.qualified(d.module, c) + \".\" + f.name,\n              x,\n            ),\n            None => (),\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  // a capability trait (`Files`) is a trait here: its values are those of\n  // its implementations, `MemFiles` too\n  types := types_of(\n    decls.map(\n      d ->\n        match d.kind {\n          ast.TraitDef(t) => ast.Decl { ..d, kind: ast.TraitDef(ast.TraitDecl { ..t, capability: false }) },\n          _ => d,\n        },\n    ),\n  )\n  mut traits := Dict[String, ast.TraitDecl] {}\n  for d in decls {\n    match d.kind {\n      ast.TraitDef(t) => mut traits.insert(codegen.qualified(d.module, t.name), t),\n      _ => (),\n    }\n  }\n  // an `impl` of a trait from its own module names it as written there\n  // (`Toml` in std.toml): qualify it as `traits` does\n  mut impls := []\n  for d in typed_decls {\n    match d.kind {\n      ast.ImplDef(im) => {\n        h := codegen.texpr_head(im.for_type)\n        // core's types (`KeyPath`) are named bare everywhere\n        head := if contains(h, \".\")\n          || codegen.builtin_head(h)\n          || contains(types.named, h)\n            && !contains(types.named, codegen.qualified(d.module, h)) {\n          h\n        } else {\n          codegen.qualified(d.module, h)\n        }\n        tq := codegen.qualified(d.module, im.trait_name)\n        tn := if im.trait_name != \"\"\n          && !contains(traits, im.trait_name)\n          && contains(traits, tq) {\n          tq\n        } else {\n          im.trait_name\n        }\n        mut impls.push(\n          codegen.ImplEntry {\n            head,\n            decl: ast.ImplDecl { ..im, trait_name: tn },\n          },\n        )\n      },\n      _ => (),\n    }\n  }\n  // constructor order: `Option`'s and `Result`'s first, then as declared\n  mut order := [\"None\", \"Some\", \"Ok\", \"Err\"]\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => match t.body {\n        ast.RecordBody(_) => mut order.push(codegen.qualified(d.module, t.name)),\n        ast.SumBody(vs) => {\n          order += vs.map(v -> codegen.qualified(d.module, v.name))\n        },\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  // tags from the type's name and the constructor's index: the same in\n  // every program, so std's precompiled code and the program agree\n  mut tags := Dict[String, Int] {}\n  mut placed := Dict[String, Int] {}\n  for c in order + keys(types.ctors) {\n    if contains(types.ctors, c) && !contains(tags, c) {\n      owner := (get(types.ctors, c) ?? codegen.no_shape()).owner\n      i := get(placed, owner) ?? 0\n      mut placed.insert(owner, i + 1)\n      mut tags.insert(c, codegen.stable_tag(owner, i))\n    }\n  }\n  mut data := Set[String] { \"Tuple\" }\n  for c in keys(types.ctors) {\n    mut data.insert((get(types.ctors, c) ?? codegen.no_shape()).owner)\n    // a variant is a type too: its values are blocks, never boxed\n    mut data.insert(c)\n  }\n  // `strata test`: each test is a function with no parameters\n  main := match (get(fns, \"main\"), tests) {\n    (Some(f), _) => f,\n    (None, Some(ts)) => get(fns, (get(ts, 0) ?? (\"\", \"\")).0) ?? codegen.no_fn(),\n    // a library (`strata build --lib`): its exports, no `main`\n    (None, None) => if fuzz != []\n      || library != []\n      || calls != []\n      || codegen.exports_of(given) != [] {\n      codegen.no_fn()\n    } else {\n      return Err([\"no `main` function\"])\n    },\n  }\n  // `main` compiled from (and all it reaches) only for a program: never for\n  // fuzz drivers, calls or std's library, even when the package has one\n  // (verify's probes of the compiler would compile all of it)\n  program := main.name != \"\" && fuzz == [] && library == [] && calls == []\n  mut g := codegen.Gen {\n    caps: set(\n      [codegen.qualified(d.module, c.name) for d in given where d.kind is ast.CapabilityDef for c in match d.kind {\n        ast.CapabilityDef(c) => [c],\n        _ => [],\n      }],\n    ),\n    strings: Dict[String, String] {},\n    globals: [],\n    used: Set[String] {},\n    fns,\n    errs: [],\n    types,\n    tags,\n    data,\n    defaults,\n    traits,\n    impls,\n    helpers: Set[String] {},\n    helper_defs: [],\n    box_tags: Dict[String, Int] {},\n    union_names: Dict[String, String] {},\n    generic_aliases: codegen.generic_aliases_of(decls),\n    refines: Dict[String, (ast.TypeExpr, ast.Expr)] {},\n    refine_params: Dict[String, List[String]] {},\n    distincts: Set[String] {},\n    field_types: Dict[String, ast.TypeExpr] {},\n    variant_index: Dict[String, Int] {},\n    declared: Dict[String, ast.TypeExpr] {},\n    bound_slots: Dict[String, List[String]] {},\n    left_out: 0,\n    kept: 0,\n    keeps: None,\n    stack_next: false,\n    stack_made: [],\n    instances: match tests {\n      Some(ts) => set(ts.map(\n        t ->\n          codegen.inst_sym(\n            t.0,\n            codegen.no_fn(),\n            Dict[String, Ty] {},\n          ),\n      )),\n      None => if !program {\n        Set[String] {}\n      } else {\n        Set[String] { \"@\\\"strata:main\\\"\" }\n      },\n    },\n    queue: match tests {\n      Some(ts) => ts.map(t -> (t.0, Dict[String, Ty] {})),\n      None => if !program {\n        []\n      } else {\n        [(\"main\", Dict[String, Ty] {})]\n      },\n    },\n    lambdas: 0,\n    fname: \"\",\n    sub: Dict[String, Ty] {},\n    in_prelude: false,\n    lines: [],\n    allocas: [],\n    next: 0,\n    scopes: [],\n    loops: [],\n    ret: TUnit,\n    proofs: codegen.proofs_of(proofs),\n    proving: \"\",\n    tasks: library != []\n      || codegen.starts_tasks(decls, false)\n        && (tests is Some\n          || fuzz != []\n          || calls != []\n          || codegen.cancels(decls)),\n    supervises: library != [] || codegen.starts_tasks(decls, true),\n    can_unwind: false,\n    unwinds: false,\n    externs: codegen.foreign_fns(decls),\n    handles: codegen.foreign_types(decls),\n    statics: codegen.statics_of(decls),\n    bare: false,\n    gens: Dict[String, String] {},\n    fuzzing: fuzz != [] || calls != [],\n    sandboxed: fuzz != [],\n    fuzz_text,\n    tracing: trace,\n    precompiled: set(precompiled),\n    library_mode: library != [],\n    current: \"\",\n    callers: Dict[String, Set[String]] {},\n    failed: Set[String] {},\n    why: Dict[String, List[String]] {},\n  }\n  // `distinct` types: a one-field block, `value`, shown as `D(x)`\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => if t.distinct {\n        q := codegen.qualified(d.module, t.name)\n        under := match t.body {\n          ast.Alias(a) => a,\n          _ => ast.UnitType,\n        }\n        saved := g.sub\n        mut sub := Dict[String, Ty] {}\n        for p in t.params {\n          mut sub.insert(p, TGen(p))\n        }\n        g.sub = sub\n        u := codegen.lower(mut g, under)\n        g.sub = saved\n        g.types = Types { ..g.types, named: {\n          mut copy := g.types.named\n          mut copy.insert(q, t.params)\n          copy\n        }, ctors: {\n          mut copy := g.types.ctors\n          mut copy.insert(\n            q,\n            Shape {\n              owner: q,\n              fields: [(\"value\", u)],\n              positional: true,\n              required: [],\n              params: t.params,\n            },\n          )\n          copy\n        } }\n        mut g.data.insert(q)\n        mut g.tags.insert(q, codegen.stable_tag(q, 0))\n      },\n      _ => (),\n    }\n  }\n  // refinements: core's (`Natural`, ...), then the program's. Refined\n  // records and sums are compiled like the others; the checker leaves them\n  // out of its model.\n  mut later: List[(String, String, ast.TypeDecl)] = []\n  for d in prelude + decls {\n    match d.kind {\n      ast.TypeDef(t) => {\n        q := codegen.qualified(d.module, t.name)\n        if t.distinct {\n          mut g.distincts.insert(q)\n        }\n        match t.body {\n          ast.RecordBody(fs) => {\n            for f in fs {\n              mut g.field_types.insert(q + \".\" + f.name, f.ty)\n            }\n          },\n          ast.SumBody(vs) => {\n            for (k, v) in enumerate(vs) {\n              vq := codegen.qualified(d.module, v.name)\n              mut g.variant_index.insert(vq, k)\n              // core's names are global: `Some`\n              if starts_with(d.module, \"core\") {\n                mut g.variant_index.insert(v.name, k)\n              }\n              match v.payload {\n                ast.RecordPayload(fs) => {\n                  for f in fs {\n                    mut g.field_types.insert(vq + \".\" + f.name, f.ty)\n                  }\n                },\n                ast.Positional(ts) => {\n                  for (i, ft) in enumerate(ts) {\n                    mut g.field_types.insert(\n                      vq + \".\" + to_string(i),\n                      ft,\n                    )\n                    if starts_with(d.module, \"core\") {\n                      mut g.field_types.insert(\n                        v.name + \".\" + to_string(i),\n                        ft,\n                      )\n                    }\n                  }\n                },\n                _ => (),\n              }\n            }\n          },\n          _ => (),\n        }\n        match t.refinement {\n          Some(pred) => {\n            base := match t.body {\n              ast.Alias(a) => a,\n              _ => ast.Named { name: q, args: [] },\n            }\n            mut g.refines.insert(q, (base, pred))\n            mut g.refine_params.insert(q, t.params)\n            // core's names are global: `Natural`\n            if starts_with(d.module, \"core\") {\n              mut g.refines.insert(t.name, (base, pred))\n              mut g.refine_params.insert(t.name, t.params)\n            }\n            if !t.distinct\n              && !(t.body is ast.Alias)\n              && !contains(g.types.named, q) {\n              mut later.push((q, d.module, t))\n            }\n          },\n          None => (),\n        }\n      },\n      _ => (),\n    }\n  }\n  // Refined records and sums are added so that the refined types their\n  // fields hold come first, whatever the module order: a generic\n  // `MemQueue[P, E]`'s `Dict[TaskId, Entry[P]]` needs `Entry`. One that\n  // still cannot be added is added as is, its errors kept.\n  mut left := later\n  for _ in later {\n    if left == [] {\n      break\n    }\n    mut still := []\n    for (q, m, t) in left {\n      before := g\n      codegen.add_type(mut g, q, m, t)\n      if len(g.errs) > len(before.errs) {\n        g = before\n        mut still.push((q, m, t))\n      }\n    }\n    if len(still) == len(left) {\n      break\n    }\n    left = still\n  }\n  for (q, m, t) in left {\n    codegen.add_type(mut g, q, m, t)\n  }\n  // records and sums with fields of types outside the checker's model (a\n  // `distinct` type's, `user: UserId`; a refined record's, `p: Pos`), now\n  // that those are known\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => if !t.distinct && t.refinement is None {\n        q := codegen.qualified(d.module, t.name)\n        open := codegen.ctors_of(g, TNamed { name: q, args: [] }).any(\n          c ->\n            (get(g.types.ctors, c) ?? codegen.no_shape()).fields.any(\n              f -> codegen.has_any(f.1),\n            ),\n        )\n        if open && (t.body is ast.RecordBody || t.body is ast.SumBody) {\n          before := g\n          codegen.add_type(mut g, q, d.module, t)\n          if len(g.errs) > len(before.errs) {\n            g = before\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  // the calls a cancelled task may leave at: in a program whose panics do\n  // not leave functions, those reaching a wait. Under `--trace`, every call.\n  if g.tasks && !g.supervises && !trace {\n    (ws, known) := codegen.waits_of(fns, impls, traits, decls)\n    g.waiting = ws\n    g.waits_known = known\n  }\n  Ok((g, main))\n}"},{"name":"codegen.read_slot","kind":"fn","old":"3820f952b767c9f3","new":"0c5cba58ac74f158","interface_changed":true,"affected":["codegen.read_back","codegen.read_all","codegen.read_ctor","computed_value","repl_eval","comptime_value","repl_command","comptime_values","strata_command","expanded","comptime_runner","command_line","codegen_with","with_base","loaded_errors","edit_file","file_errors","edit_errors","main","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","verify_file","package_errors","edit_command","check_files","check_command","build_command","run_command","apply_change","apply_edit","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","graph_runs","replay","or_solver_inputs","verify_command","static_graph","program_objects","build_proofs","search_invariants","rename_command","move_command","fix_command","edit_in_editor","core_rt_text","eval_files","call_command","check_fn","graph_command","graph_diff","linked","fix_loops","build_core_command"],"module":"codegen","text":"/// The value of type `t` in the slot at `slot`: the slot itself for a\n/// number, an address for the rest.\n/// Typed `Raw`, not `I64`, so `verify` never runs it: a random word would\n/// be read as an address.\nfn read_slot(\n  mut g: codegen.Gen,\n  t: check.Ty,\n  slot: Raw,\n) -> Result[ast.Expr, String] {\n  w := slot.address\n  match codegen.sized(t) {\n    Some(n) => return Ok(codegen.word_literal(n, w.to_int())),\n    None => (),\n  }\n  r := slot\n  match t {\n    check.TInt => Ok(codegen.int_literal(slot)),\n    check.TFloat => {\n      bits := w.to_int()\n      match float_from_bits(if bits < 0 {\n        bits + 18446744073709551616\n      } else {\n        bits\n      }) {\n        Some(f) => Ok(ast.FloatLit(f)),\n        None => Err(\"a float that isn't a number\"),\n      }\n    },\n    check.TBool => Ok(ast.BoolLit(w.to_int() % 2 != 0)),\n    check.TUnit => Ok(ast.UnitExpr),\n    check.TStr => match codegen.text_at(r) {\n      Some(s) => Ok(ast.StrLit(s)),\n      None => Err(\"a string that isn't UTF-8\"),\n    },\n    check.TList(et) => match codegen.read_all(mut g, et, codegen.elements_at(r)) {\n      Ok(xs) => Ok(ast.ListExpr(xs)),\n      Err(e) => Err(e),\n    },\n    // a table: its entries are the tuple's first field\n    check.TNamed { name: \"Set\", args: [et] } => match codegen.read_all(mut g, et, codegen.elements_at(r.at(1))) {\n      Ok(xs) => Ok(ast.SetExpr { types: [], elems: xs }),\n      Err(e) => Err(e),\n    },\n    check.TNamed { name: \"Dict\", args: [kt, vt] } => {\n      mut entries := []\n      for pair in codegen.elements_at(r.at(1)) {\n        k := codegen.read_slot(mut g, kt, pair.at(1))!\n        v := codegen.read_slot(mut g, vt, pair.at(2))!\n        mut entries.push((k, v))\n      }\n      Ok(ast.DictExpr { types: [], entries })\n    },\n    check.TNamed { name: \"Tuple\", args } => {\n      mut xs := []\n      for (i, a) in enumerate(args) {\n        x := codegen.read_slot(mut g, a, r.at(to_i64(i + 1)))!\n        mut xs.push(x)\n      }\n      Ok(ast.TupleExpr(xs))\n    },\n    check.TNamed { name, args } => if contains(g.data, name) {\n      codegen.read_ctor(mut g, name, args, r)\n    } else {\n      Err(\n        \"a value of type `\"\n          + codegen.key(t)\n          + \"` can't be read back\",\n      )\n    },\n    check.TUnion(ms) => {\n      tag := r.word(0).to_int()\n      for m in ms {\n        if codegen.boxed(g, m) {\n          if codegen.box_tag(mut g, m) == tag {\n            return codegen.read_slot(mut g, m, r.at(1))\n          }\n        } else if codegen.member_tags(mut g, m).contains(tag) {\n          return codegen.read_slot(mut g, m, slot)\n        }\n      }\n      Err(\"a union value with tag \" + to_string(tag))\n    },\n    _ => Err(\n      \"a value of type `\" + codegen.key(t) + \"` can't be read back\",\n    ),\n  }\n}","old_text":"/// The value of type `t` in the slot at `slot`: the slot itself for a\n/// number, an address for the rest.\n/// Typed `Raw`, not `I64`, so `verify` never runs it: a random word would\n/// be read as an address.\nfn read_slot(mut g: codegen.Gen, t: Ty, slot: Raw) -> Result[ast.Expr, String] {\n  w := slot.address\n  match codegen.sized(t) {\n    Some(n) => return Ok(codegen.word_literal(n, w.to_int())),\n    None => (),\n  }\n  r := slot\n  match t {\n    TInt => Ok(codegen.int_literal(slot)),\n    TFloat => {\n      bits := w.to_int()\n      match float_from_bits(if bits < 0 {\n        bits + 18446744073709551616\n      } else {\n        bits\n      }) {\n        Some(f) => Ok(ast.FloatLit(f)),\n        None => Err(\"a float that isn't a number\"),\n      }\n    },\n    TBool => Ok(ast.BoolLit(w.to_int() % 2 != 0)),\n    TUnit => Ok(ast.UnitExpr),\n    TStr => match codegen.text_at(r) {\n      Some(s) => Ok(ast.StrLit(s)),\n      None => Err(\"a string that isn't UTF-8\"),\n    },\n    TList(et) => match codegen.read_all(mut g, et, codegen.elements_at(r)) {\n      Ok(xs) => Ok(ast.ListExpr(xs)),\n      Err(e) => Err(e),\n    },\n    // a table: its entries are the tuple's first field\n    TNamed { name: \"Set\", args: [et] } => match codegen.read_all(mut g, et, codegen.elements_at(r.at(1))) {\n      Ok(xs) => Ok(ast.SetExpr { types: [], elems: xs }),\n      Err(e) => Err(e),\n    },\n    TNamed { name: \"Dict\", args: [kt, vt] } => {\n      mut entries := []\n      for pair in codegen.elements_at(r.at(1)) {\n        k := codegen.read_slot(mut g, kt, pair.at(1))!\n        v := codegen.read_slot(mut g, vt, pair.at(2))!\n        mut entries.push((k, v))\n      }\n      Ok(ast.DictExpr { types: [], entries })\n    },\n    TNamed { name: \"Tuple\", args } => {\n      mut xs := []\n      for (i, a) in enumerate(args) {\n        x := codegen.read_slot(mut g, a, r.at(to_i64(i + 1)))!\n        mut xs.push(x)\n      }\n      Ok(ast.TupleExpr(xs))\n    },\n    TNamed { name, args } => if contains(g.data, name) {\n      codegen.read_ctor(mut g, name, args, r)\n    } else {\n      Err(\n        \"a value of type `\"\n          + codegen.key(t)\n          + \"` can't be read back\",\n      )\n    },\n    TUnion(ms) => {\n      tag := r.word(0).to_int()\n      for m in ms {\n        if codegen.boxed(g, m) {\n          if codegen.box_tag(mut g, m) == tag {\n            return codegen.read_slot(mut g, m, r.at(1))\n          }\n        } else if codegen.member_tags(mut g, m).contains(tag) {\n          return codegen.read_slot(mut g, m, slot)\n        }\n      }\n      Err(\"a union value with tag \" + to_string(tag))\n    },\n    _ => Err(\n      \"a value of type `\" + codegen.key(t) + \"` can't be read back\",\n    ),\n  }\n}"},{"name":"codegen.read_all","kind":"fn","old":"964927600a472a5e","new":"0d7ad8ec2d0791bb","interface_changed":true,"affected":["codegen.read_slot","codegen.read_back","codegen.read_ctor","computed_value","repl_eval","comptime_value","repl_command","comptime_values","strata_command","expanded","comptime_runner","command_line","codegen_with","with_base","loaded_errors","edit_file","file_errors","edit_errors","main","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","verify_file","package_errors","edit_command","check_files","check_command","build_command","run_command","apply_change","apply_edit","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","graph_runs","replay","or_solver_inputs","verify_command","static_graph","program_objects","build_proofs","search_invariants","rename_command","move_command","fix_command","edit_in_editor","core_rt_text","eval_files","call_command","check_fn","graph_command","graph_diff","linked","fix_loops","build_core_command"],"module":"codegen","text":"/// Values of type `t` from their slots, each a `Raw`.\nfn read_all(\n  mut g: codegen.Gen,\n  t: check.Ty,\n  ws: List[Raw],\n) -> Result[List[ast.Expr], String] {\n  mut out := []\n  for w in ws {\n    x := codegen.read_slot(mut g, t, w)!\n    mut out.push(x)\n  }\n  Ok(out)\n}","old_text":"/// Values of type `t` from their slots, each a `Raw`.\nfn read_all(\n  mut g: codegen.Gen,\n  t: Ty,\n  ws: List[Raw],\n) -> Result[List[ast.Expr], String] {\n  mut out := []\n  for w in ws {\n    x := codegen.read_slot(mut g, t, w)!\n    mut out.push(x)\n  }\n  Ok(out)\n}"},{"name":"codegen.read_ctor","kind":"fn","old":"e793a5a0dad25895","new":"3002f3699946b923","interface_changed":true,"affected":["codegen.read_slot","codegen.read_back","codegen.read_all","computed_value","repl_eval","comptime_value","repl_command","comptime_values","strata_command","expanded","comptime_runner","command_line","codegen_with","with_base","loaded_errors","edit_file","file_errors","edit_errors","main","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","verify_file","package_errors","edit_command","check_files","check_command","build_command","run_command","apply_change","apply_edit","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","graph_runs","replay","or_solver_inputs","verify_command","static_graph","program_objects","build_proofs","search_invariants","rename_command","move_command","fix_command","edit_in_editor","core_rt_text","eval_files","call_command","check_fn","graph_command","graph_diff","linked","fix_loops","build_core_command"],"module":"codegen","text":"/// A record, variant or `distinct` value of type `name[args]`: the\n/// constructor from the tag in its first slot, then its fields.\nfn read_ctor(\n  mut g: codegen.Gen,\n  name: String,\n  args: List[check.Ty],\n  r: Raw,\n) -> Result[ast.Expr, String] {\n  tag := r.word(0).to_int()\n  for c in keys(g.types.ctors) {\n    sh := get(g.types.ctors, c) ?? codegen.no_shape()\n    if sh.owner == name && get(g.tags, c) ?? -1 == tag {\n      sub := check.pairs(sh.params, args)\n      mut vals := []\n      for (i, f) in enumerate(sh.fields) {\n        x := codegen.read_slot(\n          mut g,\n          check.inst(f.1, sub),\n          r.at(to_i64(i + 1)),\n        )!\n        mut vals.push((f.0, x))\n      }\n      return Ok(ast.CtorExpr {\n        name: c,\n        args: if len(sh.fields) == 0 && c != name {\n          ast.NoArgs\n        } else if sh.positional {\n          ast.PositionalArgs(vals.map(v -> v.1))\n        } else {\n          ast.RecordArgs(vals)\n        },\n      })\n    }\n  }\n  Err(\"a `\" + name + \"` with tag \" + to_string(tag))\n}","old_text":"/// A record, variant or `distinct` value of type `name[args]`: the\n/// constructor from the tag in its first slot, then its fields.\nfn read_ctor(\n  mut g: codegen.Gen,\n  name: String,\n  args: List[Ty],\n  r: Raw,\n) -> Result[ast.Expr, String] {\n  tag := r.word(0).to_int()\n  for c in keys(g.types.ctors) {\n    sh := get(g.types.ctors, c) ?? codegen.no_shape()\n    if sh.owner == name && get(g.tags, c) ?? -1 == tag {\n      sub := pairs(sh.params, args)\n      mut vals := []\n      for (i, f) in enumerate(sh.fields) {\n        x := codegen.read_slot(\n          mut g,\n          inst(f.1, sub),\n          r.at(to_i64(i + 1)),\n        )!\n        mut vals.push((f.0, x))\n      }\n      return Ok(ast.CtorExpr {\n        name: c,\n        args: if len(sh.fields) == 0 && c != name {\n          ast.NoArgs\n        } else if sh.positional {\n          ast.PositionalArgs(vals.map(v -> v.1))\n        } else {\n          ast.RecordArgs(vals)\n        },\n      })\n    }\n  }\n  Err(\"a `\" + name + \"` with tag \" + to_string(tag))\n}"},{"name":"codegen.mem_builtin","kind":"fn","old":"6b8f554f32e88524","new":"83b98f866a19ca03","interface_changed":false,"affected":[],"module":"codegen","text":"/// core.mem's builtins: raw blocks from the runtime, addresses, byte copies\n/// and comparisons, machine word conversions and divisions, faults, and\n/// plain or atomic loads and stores of words and bytes at an offset.\n/// `None` for any other name.\nfn mem_builtin(\n  mut g: codegen.Gen,\n  name: String,\n  vs: List[codegen.V],\n) -> Option[codegen.V] {\n  ptr_t := check.TNamed { name: \"extern:Ptr\", args: [] }\n  i64_t := check.TNamed { name: \"I64\", args: [] }\n  arg := (i: Int) -> (get(vs, i) ?? codegen.unit()).op\n  n := len(vs)\n  if name == \"raw_alloc\" && n == 1 {\n    return Some(codegen.call(mut g, ptr_t, \"strata_raw_alloc\", vs))\n  }\n  if name == \"raw_reserve\" && n == 1 {\n    return Some(codegen.call(mut g, ptr_t, \"strata_raw_reserve\", vs))\n  }\n  if name == \"raw_size\" && n == 1 {\n    return Some(codegen.call(mut g, i64_t, \"strata_raw_size\", vs))\n  }\n  if name == \"raw_free\" && n == 1 {\n    codegen.use_rt(mut g, \"free\")\n    codegen.emit(mut g, \"call void @free(ptr \" + arg(0) + \")\")\n    return Some(codegen.unit())\n  }\n  if name == \"raw_fail\" && n == 1 {\n    codegen.use_rt(mut g, \"strata_raw_fail\")\n    codegen.emit(\n      mut g,\n      \"call void @strata_raw_fail(ptr \" + arg(0) + \")\",\n    )\n    return Some(codegen.unit())\n  }\n  if name == \"raw_fill\" && n == 3 {\n    codegen.use_rt(mut g, \"llvm.memset.p0.i64\")\n    codegen.emit(\n      mut g,\n      f\"call void @llvm.memset.p0.i64(ptr {arg(0)}, i8 {arg(1)}, i64 {arg(2)}, i1 false)\",\n    )\n    return Some(codegen.unit())\n  }\n  if name == \"raw_copy\" && n == 3 {\n    codegen.use_rt(mut g, \"llvm.memmove.p0.p0.i64\")\n    codegen.emit(\n      mut g,\n      f\"call void @llvm.memmove.p0.p0.i64(ptr {arg(0)}, ptr {arg(1)}, i64 {arg(2)}, i1 false)\",\n    )\n    return Some(codegen.unit())\n  }\n  if name == \"raw_compare\" && n == 3 {\n    codegen.use_rt(mut g, \"memcmp\")\n    c := codegen.fresh(mut g, \"cmp\")\n    r := codegen.fresh(mut g, \"cmp\")\n    codegen.emit(\n      mut g,\n      f\"{c} = call i32 @memcmp(ptr {arg(0)}, ptr {arg(1)}, i64 {arg(2)})\",\n    )\n    codegen.emit(mut g, f\"{r} = sext i32 {c} to i64\")\n    return Some(codegen.V { ty: i64_t, op: r })\n  }\n  if name == \"raw_fault\" && n == 2 {\n    codegen.use_rt(mut g, \"strata_soft_fault\")\n    r := codegen.fresh(mut g, \"contained\")\n    codegen.emit(\n      mut g,\n      f\"{r} = call zeroext i1 @strata_soft_fault(i64 {arg(0)}, ptr {arg(1)})\",\n    )\n    return Some(codegen.V { ty: check.TBool, op: r })\n  }\n  if name == \"str_block\" && n == 1 {\n    return Some(codegen.V { ty: ptr_t, op: arg(0) })\n  }\n  if (name == \"f64_bits\" || name == \"f64_from_bits\") && n == 1 {\n    r := codegen.fresh(mut g, \"bits\")\n    if name == \"f64_bits\" {\n      codegen.emit(mut g, f\"{r} = bitcast double {arg(0)} to i64\")\n      return Some(codegen.V { ty: i64_t, op: r })\n    }\n    codegen.emit(mut g, f\"{r} = bitcast i64 {arg(0)} to double\")\n    return Some(codegen.V { ty: check.TFloat, op: r })\n  }\n  if name == \"f64_of_i64\" && n == 1 {\n    r := codegen.fresh(mut g, \"f\")\n    codegen.emit(mut g, f\"{r} = sitofp i64 {arg(0)} to double\")\n    return Some(codegen.V { ty: check.TFloat, op: r })\n  }\n  if name == \"f64_to_i64\" && n == 1 {\n    r := codegen.fresh(mut g, \"w\")\n    codegen.emit(mut g, f\"{r} = fptosi double {arg(0)} to i64\")\n    return Some(codegen.V { ty: i64_t, op: r })\n  }\n  if name == \"f64_sqrt\" && n == 1 {\n    codegen.use_rt(mut g, \"llvm.sqrt.f64\")\n    r := codegen.fresh(mut g, \"f\")\n    codegen.emit(\n      mut g,\n      f\"{r} = call double @llvm.sqrt.f64(double {arg(0)})\",\n    )\n    return Some(codegen.V { ty: check.TFloat, op: r })\n  }\n  if name == \"f64_rem\" && n == 2 {\n    r := codegen.fresh(mut g, \"f\")\n    codegen.emit(mut g, f\"{r} = frem double {arg(0)}, {arg(1)}\")\n    return Some(codegen.V { ty: check.TFloat, op: r })\n  }\n  // core.mem's calls into the C runtime (the parts that stay in C while\n  // tasks and output are its own)\n  match codegen.c_hook(name) {\n    Some((sym, ret)) => return Some(codegen.call(mut g, if ret == \"ptr\" {\n      ptr_t\n    } else if ret == \"void\" {\n      check.TUnit\n    } else {\n      i64_t\n    }, sym, vs)),\n    None => (),\n  }\n  if name == \"narrow_i32\" && n == 1 {\n    r := codegen.fresh(mut g, \"w\")\n    codegen.emit(mut g, f\"{r} = trunc i64 {arg(0)} to i32\")\n    return Some(\n      codegen.V {\n        ty: check.TNamed { name: \"I32\", args: [] },\n        op: r,\n      },\n    )\n  }\n  if name == \"widen_i32\" && n == 1 {\n    r := codegen.fresh(mut g, \"w\")\n    codegen.emit(mut g, f\"{r} = sext i32 {arg(0)} to i64\")\n    return Some(codegen.V { ty: i64_t, op: r })\n  }\n  if name == \"widen_u8\" && n == 1 {\n    r := codegen.fresh(mut g, \"w\")\n    codegen.emit(mut g, f\"{r} = zext i8 {arg(0)} to i64\")\n    return Some(codegen.V { ty: i64_t, op: r })\n  }\n  if name == \"low_u8\" && n == 1 {\n    r := codegen.fresh(mut g, \"b\")\n    codegen.emit(mut g, f\"{r} = trunc i64 {arg(0)} to i8\")\n    return Some(\n      codegen.V { ty: check.TNamed { name: \"U8\", args: [] }, op: r },\n    )\n  }\n  if n == 2 {\n    ins := match name {\n      \"div_trunc\" => \"sdiv\",\n      \"rem_trunc\" => \"srem\",\n      \"div_unsigned\" => \"udiv\",\n      \"rem_unsigned\" => \"urem\",\n      _ => \"\",\n    }\n    if ins != \"\" {\n      r := codegen.fresh(mut g, \"q\")\n      codegen.emit(mut g, f\"{r} = {ins} i64 {arg(0)}, {arg(1)}\")\n      return Some(codegen.V { ty: i64_t, op: r })\n    }\n  }\n  if name == \"load_u32\" && n == 2 {\n    a := codegen.fresh(mut g, \"at\")\n    w := codegen.fresh(mut g, \"w\")\n    r := codegen.fresh(mut g, \"w\")\n    codegen.emit(\n      mut g,\n      f\"{a} = getelementptr i8, ptr {arg(0)}, i64 {arg(1)}\",\n    )\n    codegen.emit(mut g, f\"{w} = load i32, ptr {a}, align 4\")\n    codegen.emit(mut g, f\"{r} = zext i32 {w} to i64\")\n    return Some(codegen.V { ty: i64_t, op: r })\n  }\n  if name == \"store_u32\" && n == 3 {\n    a := codegen.fresh(mut g, \"at\")\n    w := codegen.fresh(mut g, \"w\")\n    codegen.emit(\n      mut g,\n      f\"{a} = getelementptr i8, ptr {arg(0)}, i64 {arg(1)}\",\n    )\n    codegen.emit(mut g, f\"{w} = trunc i64 {arg(2)} to i32\")\n    codegen.emit(mut g, f\"store i32 {w}, ptr {a}, align 4\")\n    return Some(codegen.unit())\n  }\n  if name == \"ptr_offset\" && n == 2 {\n    r := codegen.fresh(mut g, \"at\")\n    codegen.emit(\n      mut g,\n      f\"{r} = getelementptr i8, ptr {arg(0)}, i64 {arg(1)}\",\n    )\n    return Some(codegen.V { ty: ptr_t, op: r })\n  }\n  if name == \"address\" && n == 1 {\n    r := codegen.fresh(mut g, \"addr\")\n    codegen.emit(mut g, f\"{r} = ptrtoint ptr {arg(0)} to i64\")\n    return Some(codegen.V { ty: i64_t, op: r })\n  }\n  if name == \"ptr_at\" && n == 1 {\n    r := codegen.fresh(mut g, \"ptr\")\n    codegen.emit(mut g, f\"{r} = inttoptr i64 {arg(0)} to ptr\")\n    return Some(codegen.V { ty: ptr_t, op: r })\n  }\n  if ![\n      \"load_i64\",\n      \"load_u8\",\n      \"store_i64\",\n      \"store_u8\",\n      \"atomic_load_i64\",\n      \"atomic_store_i64\",\n      \"atomic_add_i64\",\n      \"atomic_swap_i64\",\n    ].any(\n      x -> x == name,\n    )\n    || n < 2 {\n    return None\n  }\n  a := codegen.fresh(mut g, \"at\")\n  codegen.emit(\n    mut g,\n    f\"{a} = getelementptr i8, ptr {arg(0)}, i64 {arg(1)}\",\n  )\n  w := codegen.fresh(mut g, \"w\")\n  Some(match name {\n    \"load_i64\" => {\n      codegen.emit(mut g, f\"{w} = load i64, ptr {a}, align 8\")\n      codegen.V { ty: i64_t, op: w }\n    },\n    \"atomic_load_i64\" => {\n      codegen.emit(\n        mut g,\n        f\"{w} = load atomic i64, ptr {a} acquire, align 8\",\n      )\n      codegen.V { ty: i64_t, op: w }\n    },\n    \"load_u8\" => {\n      codegen.emit(mut g, f\"{w} = load i8, ptr {a}\")\n      codegen.V { ty: check.TNamed { name: \"U8\", args: [] }, op: w }\n    },\n    \"store_i64\" => {\n      codegen.emit(mut g, f\"store i64 {arg(2)}, ptr {a}, align 8\")\n      codegen.unit()\n    },\n    \"atomic_store_i64\" => {\n      codegen.emit(\n        mut g,\n        f\"store atomic i64 {arg(2)}, ptr {a} release, align 8\",\n      )\n      codegen.unit()\n    },\n    \"store_u8\" => {\n      codegen.emit(mut g, f\"store i8 {arg(2)}, ptr {a}\")\n      codegen.unit()\n    },\n    \"atomic_add_i64\" => {\n      codegen.emit(\n        mut g,\n        f\"{w} = atomicrmw add ptr {a}, i64 {arg(2)} acq_rel, align 8\",\n      )\n      codegen.V { ty: i64_t, op: w }\n    },\n    _ => {\n      codegen.emit(\n        mut g,\n        f\"{w} = atomicrmw xchg ptr {a}, i64 {arg(2)} acquire, align 8\",\n      )\n      codegen.V { ty: i64_t, op: w }\n    },\n  })\n}","old_text":"/// core.mem's builtins: raw blocks from the runtime, addresses, byte copies\n/// and comparisons, machine word conversions and divisions, faults, and\n/// plain or atomic loads and stores of words and bytes at an offset.\n/// `None` for any other name.\nfn mem_builtin(\n  mut g: codegen.Gen,\n  name: String,\n  vs: List[codegen.V],\n) -> Option[codegen.V] {\n  ptr_t := TNamed { name: \"extern:Ptr\", args: [] }\n  i64_t := TNamed { name: \"I64\", args: [] }\n  arg := (i: Int) -> (get(vs, i) ?? codegen.unit()).op\n  n := len(vs)\n  if name == \"raw_alloc\" && n == 1 {\n    return Some(codegen.call(mut g, ptr_t, \"strata_raw_alloc\", vs))\n  }\n  if name == \"raw_reserve\" && n == 1 {\n    return Some(codegen.call(mut g, ptr_t, \"strata_raw_reserve\", vs))\n  }\n  if name == \"raw_size\" && n == 1 {\n    return Some(codegen.call(mut g, i64_t, \"strata_raw_size\", vs))\n  }\n  if name == \"raw_free\" && n == 1 {\n    codegen.use_rt(mut g, \"free\")\n    codegen.emit(mut g, \"call void @free(ptr \" + arg(0) + \")\")\n    return Some(codegen.unit())\n  }\n  if name == \"raw_fail\" && n == 1 {\n    codegen.use_rt(mut g, \"strata_raw_fail\")\n    codegen.emit(\n      mut g,\n      \"call void @strata_raw_fail(ptr \" + arg(0) + \")\",\n    )\n    return Some(codegen.unit())\n  }\n  if name == \"raw_fill\" && n == 3 {\n    codegen.use_rt(mut g, \"llvm.memset.p0.i64\")\n    codegen.emit(\n      mut g,\n      f\"call void @llvm.memset.p0.i64(ptr {arg(0)}, i8 {arg(1)}, i64 {arg(2)}, i1 false)\",\n    )\n    return Some(codegen.unit())\n  }\n  if name == \"raw_copy\" && n == 3 {\n    codegen.use_rt(mut g, \"llvm.memmove.p0.p0.i64\")\n    codegen.emit(\n      mut g,\n      f\"call void @llvm.memmove.p0.p0.i64(ptr {arg(0)}, ptr {arg(1)}, i64 {arg(2)}, i1 false)\",\n    )\n    return Some(codegen.unit())\n  }\n  if name == \"raw_compare\" && n == 3 {\n    codegen.use_rt(mut g, \"memcmp\")\n    c := codegen.fresh(mut g, \"cmp\")\n    r := codegen.fresh(mut g, \"cmp\")\n    codegen.emit(\n      mut g,\n      f\"{c} = call i32 @memcmp(ptr {arg(0)}, ptr {arg(1)}, i64 {arg(2)})\",\n    )\n    codegen.emit(mut g, f\"{r} = sext i32 {c} to i64\")\n    return Some(codegen.V { ty: i64_t, op: r })\n  }\n  if name == \"raw_fault\" && n == 2 {\n    codegen.use_rt(mut g, \"strata_soft_fault\")\n    r := codegen.fresh(mut g, \"contained\")\n    codegen.emit(\n      mut g,\n      f\"{r} = call zeroext i1 @strata_soft_fault(i64 {arg(0)}, ptr {arg(1)})\",\n    )\n    return Some(codegen.V { ty: TBool, op: r })\n  }\n  if name == \"str_block\" && n == 1 {\n    return Some(codegen.V { ty: ptr_t, op: arg(0) })\n  }\n  if (name == \"f64_bits\" || name == \"f64_from_bits\") && n == 1 {\n    r := codegen.fresh(mut g, \"bits\")\n    if name == \"f64_bits\" {\n      codegen.emit(mut g, f\"{r} = bitcast double {arg(0)} to i64\")\n      return Some(codegen.V { ty: i64_t, op: r })\n    }\n    codegen.emit(mut g, f\"{r} = bitcast i64 {arg(0)} to double\")\n    return Some(codegen.V { ty: TFloat, op: r })\n  }\n  if name == \"f64_of_i64\" && n == 1 {\n    r := codegen.fresh(mut g, \"f\")\n    codegen.emit(mut g, f\"{r} = sitofp i64 {arg(0)} to double\")\n    return Some(codegen.V { ty: TFloat, op: r })\n  }\n  if name == \"f64_to_i64\" && n == 1 {\n    r := codegen.fresh(mut g, \"w\")\n    codegen.emit(mut g, f\"{r} = fptosi double {arg(0)} to i64\")\n    return Some(codegen.V { ty: i64_t, op: r })\n  }\n  if name == \"f64_sqrt\" && n == 1 {\n    codegen.use_rt(mut g, \"llvm.sqrt.f64\")\n    r := codegen.fresh(mut g, \"f\")\n    codegen.emit(\n      mut g,\n      f\"{r} = call double @llvm.sqrt.f64(double {arg(0)})\",\n    )\n    return Some(codegen.V { ty: TFloat, op: r })\n  }\n  if name == \"f64_rem\" && n == 2 {\n    r := codegen.fresh(mut g, \"f\")\n    codegen.emit(mut g, f\"{r} = frem double {arg(0)}, {arg(1)}\")\n    return Some(codegen.V { ty: TFloat, op: r })\n  }\n  // core.mem's calls into the C runtime (the parts that stay in C while\n  // tasks and output are its own)\n  match codegen.c_hook(name) {\n    Some((sym, ret)) => return Some(codegen.call(mut g, if ret == \"ptr\" {\n      ptr_t\n    } else if ret == \"void\" {\n      TUnit\n    } else {\n      i64_t\n    }, sym, vs)),\n    None => (),\n  }\n  if name == \"narrow_i32\" && n == 1 {\n    r := codegen.fresh(mut g, \"w\")\n    codegen.emit(mut g, f\"{r} = trunc i64 {arg(0)} to i32\")\n    return Some(codegen.V { ty: TNamed { name: \"I32\", args: [] }, op: r })\n  }\n  if name == \"widen_i32\" && n == 1 {\n    r := codegen.fresh(mut g, \"w\")\n    codegen.emit(mut g, f\"{r} = sext i32 {arg(0)} to i64\")\n    return Some(codegen.V { ty: i64_t, op: r })\n  }\n  if name == \"widen_u8\" && n == 1 {\n    r := codegen.fresh(mut g, \"w\")\n    codegen.emit(mut g, f\"{r} = zext i8 {arg(0)} to i64\")\n    return Some(codegen.V { ty: i64_t, op: r })\n  }\n  if name == \"low_u8\" && n == 1 {\n    r := codegen.fresh(mut g, \"b\")\n    codegen.emit(mut g, f\"{r} = trunc i64 {arg(0)} to i8\")\n    return Some(codegen.V { ty: TNamed { name: \"U8\", args: [] }, op: r })\n  }\n  if n == 2 {\n    ins := match name {\n      \"div_trunc\" => \"sdiv\",\n      \"rem_trunc\" => \"srem\",\n      \"div_unsigned\" => \"udiv\",\n      \"rem_unsigned\" => \"urem\",\n      _ => \"\",\n    }\n    if ins != \"\" {\n      r := codegen.fresh(mut g, \"q\")\n      codegen.emit(mut g, f\"{r} = {ins} i64 {arg(0)}, {arg(1)}\")\n      return Some(codegen.V { ty: i64_t, op: r })\n    }\n  }\n  if name == \"load_u32\" && n == 2 {\n    a := codegen.fresh(mut g, \"at\")\n    w := codegen.fresh(mut g, \"w\")\n    r := codegen.fresh(mut g, \"w\")\n    codegen.emit(\n      mut g,\n      f\"{a} = getelementptr i8, ptr {arg(0)}, i64 {arg(1)}\",\n    )\n    codegen.emit(mut g, f\"{w} = load i32, ptr {a}, align 4\")\n    codegen.emit(mut g, f\"{r} = zext i32 {w} to i64\")\n    return Some(codegen.V { ty: i64_t, op: r })\n  }\n  if name == \"store_u32\" && n == 3 {\n    a := codegen.fresh(mut g, \"at\")\n    w := codegen.fresh(mut g, \"w\")\n    codegen.emit(\n      mut g,\n      f\"{a} = getelementptr i8, ptr {arg(0)}, i64 {arg(1)}\",\n    )\n    codegen.emit(mut g, f\"{w} = trunc i64 {arg(2)} to i32\")\n    codegen.emit(mut g, f\"store i32 {w}, ptr {a}, align 4\")\n    return Some(codegen.unit())\n  }\n  if name == \"ptr_offset\" && n == 2 {\n    r := codegen.fresh(mut g, \"at\")\n    codegen.emit(\n      mut g,\n      f\"{r} = getelementptr i8, ptr {arg(0)}, i64 {arg(1)}\",\n    )\n    return Some(codegen.V { ty: ptr_t, op: r })\n  }\n  if name == \"address\" && n == 1 {\n    r := codegen.fresh(mut g, \"addr\")\n    codegen.emit(mut g, f\"{r} = ptrtoint ptr {arg(0)} to i64\")\n    return Some(codegen.V { ty: i64_t, op: r })\n  }\n  if name == \"ptr_at\" && n == 1 {\n    r := codegen.fresh(mut g, \"ptr\")\n    codegen.emit(mut g, f\"{r} = inttoptr i64 {arg(0)} to ptr\")\n    return Some(codegen.V { ty: ptr_t, op: r })\n  }\n  if ![\n      \"load_i64\",\n      \"load_u8\",\n      \"store_i64\",\n      \"store_u8\",\n      \"atomic_load_i64\",\n      \"atomic_store_i64\",\n      \"atomic_add_i64\",\n      \"atomic_swap_i64\",\n    ].any(\n      x -> x == name,\n    )\n    || n < 2 {\n    return None\n  }\n  a := codegen.fresh(mut g, \"at\")\n  codegen.emit(\n    mut g,\n    f\"{a} = getelementptr i8, ptr {arg(0)}, i64 {arg(1)}\",\n  )\n  w := codegen.fresh(mut g, \"w\")\n  Some(match name {\n    \"load_i64\" => {\n      codegen.emit(mut g, f\"{w} = load i64, ptr {a}, align 8\")\n      codegen.V { ty: i64_t, op: w }\n    },\n    \"atomic_load_i64\" => {\n      codegen.emit(\n        mut g,\n        f\"{w} = load atomic i64, ptr {a} acquire, align 8\",\n      )\n      codegen.V { ty: i64_t, op: w }\n    },\n    \"load_u8\" => {\n      codegen.emit(mut g, f\"{w} = load i8, ptr {a}\")\n      codegen.V { ty: TNamed { name: \"U8\", args: [] }, op: w }\n    },\n    \"store_i64\" => {\n      codegen.emit(mut g, f\"store i64 {arg(2)}, ptr {a}, align 8\")\n      codegen.unit()\n    },\n    \"atomic_store_i64\" => {\n      codegen.emit(\n        mut g,\n        f\"store atomic i64 {arg(2)}, ptr {a} release, align 8\",\n      )\n      codegen.unit()\n    },\n    \"store_u8\" => {\n      codegen.emit(mut g, f\"store i8 {arg(2)}, ptr {a}\")\n      codegen.unit()\n    },\n    \"atomic_add_i64\" => {\n      codegen.emit(\n        mut g,\n        f\"{w} = atomicrmw add ptr {a}, i64 {arg(2)} acq_rel, align 8\",\n      )\n      codegen.V { ty: i64_t, op: w }\n    },\n    _ => {\n      codegen.emit(\n        mut g,\n        f\"{w} = atomicrmw xchg ptr {a}, i64 {arg(2)} acquire, align 8\",\n      )\n      codegen.V { ty: i64_t, op: w }\n    },\n  })\n}"},{"name":"codegen.static_block","kind":"fn","old":"ca0e9804b6276734","new":"b90f874a2e432359","interface_changed":false,"affected":[],"module":"codegen","text":"/// A `builtin static` block (core.rt's state): a zeroed global, one per\n/// program, made on first use. Its value is its address.\nfn static_block(mut g: codegen.Gen, x: String) -> codegen.V {\n  given := get(g.statics, x) ?? 0\n  // a `builtin thread static` has a negative size: one block per thread\n  (size, kind) := if given < 0 {\n    (0 - given, \"thread_local global [\")\n  } else {\n    (given, \"global [\")\n  }\n  sym := \"@\\\"static:\" + x + \"\\\"\"\n  line := sym\n    + \" = internal \"\n    + kind\n    + to_string(size)\n    + \" x i8] zeroinitializer, align 16\"\n  if !g.globals.any(l -> l == line) {\n    mut g.globals.push(line)\n  }\n  codegen.V {\n    ty: check.TNamed { name: \"extern:Ptr\", args: [] },\n    op: sym,\n  }\n}","old_text":"/// A `builtin static` block (core.rt's state): a zeroed global, one per\n/// program, made on first use. Its value is its address.\nfn static_block(mut g: codegen.Gen, x: String) -> codegen.V {\n  given := get(g.statics, x) ?? 0\n  // a `builtin thread static` has a negative size: one block per thread\n  (size, kind) := if given < 0 {\n    (0 - given, \"thread_local global [\")\n  } else {\n    (given, \"global [\")\n  }\n  sym := \"@\\\"static:\" + x + \"\\\"\"\n  line := sym\n    + \" = internal \"\n    + kind\n    + to_string(size)\n    + \" x i8] zeroinitializer, align 16\"\n  if !g.globals.any(l -> l == line) {\n    mut g.globals.push(line)\n  }\n  codegen.V { ty: TNamed { name: \"extern:Ptr\", args: [] }, op: sym }\n}"},{"name":"codegen.holds_pred","kind":"fn","old":"19b927c7c66e88fd","new":"acbe335ee2c00322","interface_changed":false,"affected":[],"module":"codegen","text":"/// Whether `x`, a value of union member `w`, satisfies `w`'s refinement\n/// `p`. A `distinct` value is a one-field block, and its refinement is\n/// about that field (`it`), as construction checks it.\nfn holds_pred(\n  mut g: codegen.Gen,\n  w: ast.TypeExpr,\n  x: codegen.V,\n  p: ast.Expr,\n) -> String {\n  match w {\n    ast.Named { name, args: [] } => if contains(g.distincts, name) {\n      match (x.ty, get(codegen.fields_of(g, name, x.ty), 0)) {\n        (check.TNamed { name: vn, .. }, Some((_, ft))) => if vn == name {\n          f := codegen.field(mut g, x, 0, ft)\n          return codegen.with_it(mut g, f, p).op\n        },\n        _ => (),\n      }\n    },\n    _ => (),\n  }\n  codegen.with_it(mut g, x, p).op\n}","old_text":"/// Whether `x`, a value of union member `w`, satisfies `w`'s refinement\n/// `p`. A `distinct` value is a one-field block, and its refinement is\n/// about that field (`it`), as construction checks it.\nfn holds_pred(\n  mut g: codegen.Gen,\n  w: ast.TypeExpr,\n  x: codegen.V,\n  p: ast.Expr,\n) -> String {\n  match w {\n    ast.Named { name, args: [] } => if contains(g.distincts, name) {\n      match (x.ty, get(codegen.fields_of(g, name, x.ty), 0)) {\n        (TNamed { name: vn, .. }, Some((_, ft))) => if vn == name {\n          f := codegen.field(mut g, x, 0, ft)\n          return codegen.with_it(mut g, f, p).op\n        },\n        _ => (),\n      }\n    },\n    _ => (),\n  }\n  codegen.with_it(mut g, x, p).op\n}"},{"name":"codegen.construct_want","kind":"fn","old":"b40ffa7bdc7cd37b","new":"8d942bfb9ee5226d","interface_changed":true,"affected":["codegen.construct","codegen.expr_want_node","codegen.main_arg","codegen.expr_node","codegen.session_capability","codegen.expr_want","codegen.entry","codegen.expr","codegen.session_entry","codegen.function","codegen.binary","codegen.declare","codegen.destructure","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.method_call","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.operands_want","codegen.wanted","codegen.try_want","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.compared","codegen.stmt_node","codegen.build_fn","codegen.push_in_place","codegen.generate","codegen.call_named","codegen.interp","codegen.logic","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.await_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.decreases_pass","codegen.decreases_call","codegen.keep_olds","codegen.export_entry","codegen.expr_on_stack","codegen.assigned_call","codegen.compiled_alone","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.by_variant","codegen.list_literal","codegen.operands","codegen.mock_call","codegen.try_expr","codegen.function_value","codegen.lambda","codegen.stmt","codegen.built_or_generated","codegen_with","core_rt_text","computed_value","repl_eval","codegen.binds","codegen.matching_v","codegen.assertion","codegen.invariants","codegen.tag_is","codegen.check_type","codegen.satisfies","codegen.holds_pred","codegen.vtable","codegen.mock_table","codegen.list_builtin","codegen.collection_builtin","codegen.produce","codegen.table_find","codegen.if_expr","codegen.matching","codegen.get_field","codegen.show","codegen.shown","codegen.builtin","codegen.string_builtin","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.spawn_expr","codegen.method_value","codegen.iterate","codegen.decreases_start","codegen.decreases_entry","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.to_c","codegen.check_payload","codegen.dyn_ctor_is","codegen.has_field_check","codegen.check_field","codegen.assign_at","codegen.gen_data","codegen.check_union","codegen.check_member","codegen.to_dyn","codegen.dyn_table_is","codegen.mock_value","codegen.gen_list","codegen.gen_fn","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.foreign_call","codegen.generated","codegen.can_generate","codegen.helper","codegen.debug_body","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.generated_args","codegen.makers","codegen.equal","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.read_back","eval_files","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// `construct` with a wanted type.\nfn construct_want(\n  mut g: codegen.Gen,\n  c: String,\n  args: ast.CtorArgs,\n  want: check.Ty,\n) -> codegen.V {\n  // on the stack: this constructor only, not those of its fields\n  on_stack := g.stack_next\n  g.stack_next = false\n  // (in result position: on the stack, its words the result)\n  rp := g.result_pos\n  g.result_pos = false\n  sh := match get(g.types.ctors, c) {\n    Some(s) => s,\n    None => {\n      codegen.not_yet(mut g, \"the constructor `\" + c + \"`\")\n      return codegen.never()\n    },\n  }\n  if codegen.refuse_capability(mut g, sh.owner) {\n    return codegen.never()\n  }\n  // each field's value is made as the wanted type says when that holds a\n  // trait value (`Some(mem_files(…))` for an `Option[Files]`), a union, or\n  // a function (lambda parameter types: `Some((a, b) -> …)` for an\n  // `Option[(Int, Int) -> Int]`)\n  wm := match want {\n    check.TNamed { name, args: wa } => if name == sh.owner {\n      check.pairs(sh.params, wa)\n    } else {\n      Dict[String, check.Ty] {}\n    },\n    _ => Dict[String, check.Ty] {},\n  }\n  mut wants := []\n  for f in sh.fields {\n    w := codegen.ground(check.inst(f.1, wm))\n    // a list too: a finite iterator given for one is converted (`converted`)\n    mut wants.push(\n      if codegen.holds_trait(w)\n        || codegen.holds_union(w)\n        || codegen.holds_fn(w)\n        || w is check.TList {\n        w\n      } else {\n        check.TAny\n      },\n    )\n  }\n  vs := match args {\n    ast.NoArgs => if len(sh.fields) == 0 {\n      return codegen.V { ty: check.TNamed {\n        name: sh.owner,\n        args: sh.params.map(_ -> check.TAny),\n      }, op: codegen.nullary(mut g, c) }\n    } else {\n      codegen.not_yet(mut g, \"`\" + c + \"` without its fields\")\n      return codegen.never()\n    },\n    ast.PositionalArgs(es) => codegen.operands_want(mut g, es, wants),\n    ast.RecordArgs(given) => {\n      // in declaration order; a field not given takes its default\n      mut out := []\n      for f in sh.fields {\n        x := match find(given, a -> a.0 == f.0) {\n          Some(a) => a.1,\n          None => match get(g.defaults, c + \".\" + f.0) {\n            Some(d) => d,\n            None => {\n              codegen.not_yet(\n                mut g,\n                \"`\" + c + \"` without its field `\" + f.0 + \"`\",\n              )\n              return codegen.never()\n            },\n          },\n        }\n        w := get(wants, len(out)) ?? check.TAny\n        v := if w is check.TAny {\n          codegen.expr(mut g, x)\n        } else {\n          y := codegen.expr_want(mut g, x, w)\n          if y.ty is check.TAny {\n            y\n          } else {\n            codegen.converted(mut g, y, w)\n          }\n        }\n        if v.ty is check.TAny {\n          return v\n        }\n        mut out.push(v)\n      }\n      Some(out)\n    },\n    ast.UpdateArgs { base, fields } => {\n      b0 := codegen.expr(mut g, base)\n      if b0.ty is check.TAny {\n        return b0\n      }\n      // held when a field's value may assign: `P { ..p, n: { p = q; 2 } }`\n      b := if fields.any(a -> codegen.assigns(a.1)) {\n        codegen.hold(mut g, b0)\n      } else {\n        b0\n      }\n      fs := codegen.fields_of(g, c, b.ty)\n      mut out := []\n      for (k, f) in enumerate(fs) {\n        v := match find(fields, a -> a.0 == f.0) {\n          Some(a) => codegen.expr(mut g, a.1),\n          None => codegen.field(mut g, b, k, f.1),\n        }\n        if v.ty is check.TAny {\n          return v\n        }\n        mut out.push(v)\n      }\n      Some(out)\n    },\n  }\n  match vs {\n    Some(given) => {\n      // each field's value of its declared type (a literal of a sized one)\n      mut xs := []\n      for (k, x) in enumerate(given) {\n        ft := match get(sh.fields, k) {\n          Some(f) => f.1,\n          None => check.TAny,\n        }\n        mut xs.push(codegen.as_type(mut g, x, ft))\n      }\n      // the type's parameters, from the values given\n      mut m := Dict[String, check.Ty] {}\n      for (k, f) in enumerate(sh.fields) {\n        m = codegen.bind_gen(f.1, (get(xs, k) ?? codegen.unit()).ty, m)\n      }\n      t := check.TNamed {\n        name: sh.owner,\n        args: sh.params.map(p -> get(m, p) ?? check.TAny),\n      }\n      ctx := f\"constructing `{codegen.short(c)}`\"\n      if contains(g.distincts, c) {\n        // a `distinct` type: its value, as is, against its refinement\n        match (get(g.refines, c), get(xs, 0)) {\n          (Some((_, pred)), Some(x0)) => if !codegen.proven(mut g, ctx, \"same\") {\n            ok := codegen.with_it(mut g, x0, pred)\n            codegen.fail_unless(\n              mut g,\n              ok,\n              ctx,\n              [],\n              x0,\n              f\"does not satisfy `{codegen.short(c)}` (where {text.expr_text(pred, 0)})\",\n            )\n          },\n          _ => (),\n        }\n      } else {\n        for (k, f) in enumerate(sh.fields) {\n          match codegen.field_written(g, t, c, f.0) {\n            Some(ft) => if codegen.needs_check(g, ft) {\n              fv := get(xs, k) ?? codegen.unit()\n              codegen.check_type(\n                mut g,\n                ft,\n                fv,\n                ctx + \": \" + codegen.short(c) + \".\" + f.0,\n                [],\n              )\n            },\n            None => (),\n          }\n        }\n      }\n      in_rp := codegen.in_result(g, rp, t)\n      stacked := !in_rp\n        && on_stack\n        && (want is check.TAny || want == t)\n        && !codegen.boxed(g, t)\n      p := if in_rp {\n        codegen.result_block(mut g, get(g.tags, c) ?? 0, xs)\n      } else if stacked {\n        g.stack_made = xs.map(x -> x.ty)\n        codegen.stack_block(mut g, get(g.tags, c) ?? 0, xs)\n      } else {\n        codegen.block_of(mut g, get(g.tags, c) ?? 0, xs)\n      }\n      // a result block: of the result's type, its parameters known\n      made := codegen.temp(mut g, codegen.V { ty: if in_rp {\n        codegen.better(t, g.ret)\n      } else {\n        t\n      }, op: p })\n      // a temporary on the stack: its end drops only its fields\n      if stacked {\n        k := len(g.scopes) - 1\n        s := get(g.scopes, k) ?? codegen.no_scope()\n        codegen.set_scope(mut g, k, codegen.Scope { ..s, stacked: {\n          mut copy := s.stacked\n          mut copy.insert(p, xs.map(x -> x.ty))\n          copy\n        } })\n      }\n      if !contains(g.distincts, c) {\n        match get(g.refines, sh.owner) {\n          Some((_, pred)) => if !codegen.proven(mut g, ctx, \"same\") {\n            ok := codegen.with_it(mut g, made, pred)\n            codegen.fail_unless(\n              mut g,\n              ok,\n              ctx,\n              [],\n              made,\n              f\"does not satisfy `{codegen.short(sh.owner)}` (where {text.expr_text(pred, 0)})\",\n            )\n          },\n          None => (),\n        }\n      }\n      made\n    },\n    None => codegen.never(),\n  }\n}","old_text":"/// `construct` with a wanted type.\nfn construct_want(\n  mut g: codegen.Gen,\n  c: String,\n  args: ast.CtorArgs,\n  want: Ty,\n) -> codegen.V {\n  // on the stack: this constructor only, not those of its fields\n  on_stack := g.stack_next\n  g.stack_next = false\n  // (in result position: on the stack, its words the result)\n  rp := g.result_pos\n  g.result_pos = false\n  sh := match get(g.types.ctors, c) {\n    Some(s) => s,\n    None => {\n      codegen.not_yet(mut g, \"the constructor `\" + c + \"`\")\n      return codegen.never()\n    },\n  }\n  if codegen.refuse_capability(mut g, sh.owner) {\n    return codegen.never()\n  }\n  // each field's value is made as the wanted type says when that holds a\n  // trait value (`Some(mem_files(…))` for an `Option[Files]`), a union, or\n  // a function (lambda parameter types: `Some((a, b) -> …)` for an\n  // `Option[(Int, Int) -> Int]`)\n  wm := match want {\n    TNamed { name, args: wa } => if name == sh.owner {\n      pairs(sh.params, wa)\n    } else {\n      Dict[String, Ty] {}\n    },\n    _ => Dict[String, Ty] {},\n  }\n  mut wants := []\n  for f in sh.fields {\n    w := codegen.ground(inst(f.1, wm))\n    // a list too: a finite iterator given for one is converted (`converted`)\n    mut wants.push(\n      if codegen.holds_trait(w)\n        || codegen.holds_union(w)\n        || codegen.holds_fn(w)\n        || w is TList {\n        w\n      } else {\n        TAny\n      },\n    )\n  }\n  vs := match args {\n    ast.NoArgs => if len(sh.fields) == 0 {\n      return codegen.V {\n        ty: TNamed { name: sh.owner, args: sh.params.map(_ -> TAny) },\n        op: codegen.nullary(mut g, c),\n      }\n    } else {\n      codegen.not_yet(mut g, \"`\" + c + \"` without its fields\")\n      return codegen.never()\n    },\n    ast.PositionalArgs(es) => codegen.operands_want(mut g, es, wants),\n    ast.RecordArgs(given) => {\n      // in declaration order; a field not given takes its default\n      mut out := []\n      for f in sh.fields {\n        x := match find(given, a -> a.0 == f.0) {\n          Some(a) => a.1,\n          None => match get(g.defaults, c + \".\" + f.0) {\n            Some(d) => d,\n            None => {\n              codegen.not_yet(\n                mut g,\n                \"`\" + c + \"` without its field `\" + f.0 + \"`\",\n              )\n              return codegen.never()\n            },\n          },\n        }\n        w := get(wants, len(out)) ?? TAny\n        v := if w is TAny {\n          codegen.expr(mut g, x)\n        } else {\n          y := codegen.expr_want(mut g, x, w)\n          if y.ty is TAny {\n            y\n          } else {\n            codegen.converted(mut g, y, w)\n          }\n        }\n        if v.ty is TAny {\n          return v\n        }\n        mut out.push(v)\n      }\n      Some(out)\n    },\n    ast.UpdateArgs { base, fields } => {\n      b0 := codegen.expr(mut g, base)\n      if b0.ty is TAny {\n        return b0\n      }\n      // held when a field's value may assign: `P { ..p, n: { p = q; 2 } }`\n      b := if fields.any(a -> codegen.assigns(a.1)) {\n        codegen.hold(mut g, b0)\n      } else {\n        b0\n      }\n      fs := codegen.fields_of(g, c, b.ty)\n      mut out := []\n      for (k, f) in enumerate(fs) {\n        v := match find(fields, a -> a.0 == f.0) {\n          Some(a) => codegen.expr(mut g, a.1),\n          None => codegen.field(mut g, b, k, f.1),\n        }\n        if v.ty is TAny {\n          return v\n        }\n        mut out.push(v)\n      }\n      Some(out)\n    },\n  }\n  match vs {\n    Some(given) => {\n      // each field's value of its declared type (a literal of a sized one)\n      mut xs := []\n      for (k, x) in enumerate(given) {\n        ft := match get(sh.fields, k) {\n          Some(f) => f.1,\n          None => TAny,\n        }\n        mut xs.push(codegen.as_type(mut g, x, ft))\n      }\n      // the type's parameters, from the values given\n      mut m := Dict[String, Ty] {}\n      for (k, f) in enumerate(sh.fields) {\n        m = codegen.bind_gen(f.1, (get(xs, k) ?? codegen.unit()).ty, m)\n      }\n      t := TNamed {\n        name: sh.owner,\n        args: sh.params.map(p -> get(m, p) ?? TAny),\n      }\n      ctx := f\"constructing `{codegen.short(c)}`\"\n      if contains(g.distincts, c) {\n        // a `distinct` type: its value, as is, against its refinement\n        match (get(g.refines, c), get(xs, 0)) {\n          (Some((_, pred)), Some(x0)) => if !codegen.proven(mut g, ctx, \"same\") {\n            ok := codegen.with_it(mut g, x0, pred)\n            codegen.fail_unless(\n              mut g,\n              ok,\n              ctx,\n              [],\n              x0,\n              f\"does not satisfy `{codegen.short(c)}` (where {text.expr_text(pred, 0)})\",\n            )\n          },\n          _ => (),\n        }\n      } else {\n        for (k, f) in enumerate(sh.fields) {\n          match codegen.field_written(g, t, c, f.0) {\n            Some(ft) => if codegen.needs_check(g, ft) {\n              fv := get(xs, k) ?? codegen.unit()\n              codegen.check_type(\n                mut g,\n                ft,\n                fv,\n                ctx + \": \" + codegen.short(c) + \".\" + f.0,\n                [],\n              )\n            },\n            None => (),\n          }\n        }\n      }\n      in_rp := codegen.in_result(g, rp, t)\n      stacked := !in_rp\n        && on_stack\n        && (want is TAny || want == t)\n        && !codegen.boxed(g, t)\n      p := if in_rp {\n        codegen.result_block(mut g, get(g.tags, c) ?? 0, xs)\n      } else if stacked {\n        g.stack_made = xs.map(x -> x.ty)\n        codegen.stack_block(mut g, get(g.tags, c) ?? 0, xs)\n      } else {\n        codegen.block_of(mut g, get(g.tags, c) ?? 0, xs)\n      }\n      // a result block: of the result's type, its parameters known\n      made := codegen.temp(mut g, codegen.V { ty: if in_rp {\n        codegen.better(t, g.ret)\n      } else {\n        t\n      }, op: p })\n      // a temporary on the stack: its end drops only its fields\n      if stacked {\n        k := len(g.scopes) - 1\n        s := get(g.scopes, k) ?? codegen.no_scope()\n        codegen.set_scope(mut g, k, codegen.Scope { ..s, stacked: {\n          mut copy := s.stacked\n          mut copy.insert(p, xs.map(x -> x.ty))\n          copy\n        } })\n      }\n      if !contains(g.distincts, c) {\n        match get(g.refines, sh.owner) {\n          Some((_, pred)) => if !codegen.proven(mut g, ctx, \"same\") {\n            ok := codegen.with_it(mut g, made, pred)\n            codegen.fail_unless(\n              mut g,\n              ok,\n              ctx,\n              [],\n              made,\n              f\"does not satisfy `{codegen.short(sh.owner)}` (where {text.expr_text(pred, 0)})\",\n            )\n          },\n          None => (),\n        }\n      }\n      made\n    },\n    None => codegen.never(),\n  }\n}"},{"name":"codegen.holds_trait","kind":"fn","old":"281d50530f37180f","new":"87c6a67ca4500a26","interface_changed":true,"affected":["codegen.binary","codegen.call_fn_want","codegen.builtin_call","codegen.construct_want","codegen.if_want","codegen.branch_value","codegen.push_in_place","codegen.expr_node","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.except_expr","codegen.matching_want","codegen.construct","codegen.expr_want_node","codegen.if_expr","codegen.matching_v","codegen.match_got","codegen.update_in_place","codegen.expr","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.main_arg","codegen.select_expr","codegen.matching","codegen.session_capability","codegen.expr_want","codegen.stmt_node","codegen.interp","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.await_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.operands_want","codegen.try_want","codegen.tag_test","codegen.set_in_place","codegen.take_in_place","codegen.compared","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.expr_on_stack","codegen.assigne