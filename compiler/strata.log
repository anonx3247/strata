:= Dict[String, check.Ty] {}\n  for t in ts {\n    match t {\n      check.TUnion(ms) => {\n        for m in ms {\n          mut by_key.insert(codegen.key(m), m)\n        }\n      },\n      _ => mut by_key.insert(codegen.key(t), t),\n    }\n  }\n  ks := keys(by_key).sorted()\n  if len(ks) == 1 {\n    return get(by_key, get(ks, 0) ?? \"\") ?? check.TAny\n  }\n  check.TUnion(ks.map(k -> get(by_key, k) ?? check.TAny))\n}","old_text":"// ---- unions ----\n//\n// A union's value is one of its members' values.\n// - A record or variant member is its own block, and its tag says which.\n// - Any other member is boxed: a block `{ box tag, value }`, with box tags\n//   beyond the constructors' tags.\n// - Members are in the checker's order, the order they are written in.\n\n/// The union of types: nested unions flattened, each member once, ordered\n/// by key. A single type is itself.\nfn union_ty(ts: List[Ty]) -> Ty {\n  mut by_key := Dict[String, Ty] {}\n  for t in ts {\n    match t {\n      TUnion(ms) => {\n        for m in ms {\n          mut by_key.insert(codegen.key(m), m)\n        }\n      },\n      _ => mut by_key.insert(codegen.key(t), t),\n    }\n  }\n  ks := keys(by_key).sorted()\n  if len(ks) == 1 {\n    return get(by_key, get(ks, 0) ?? \"\") ?? TAny\n  }\n  TUnion(ks.map(k -> get(by_key, k) ?? TAny))\n}"},{"name":"codegen.boxed","kind":"fn","old":"8104b58d76ba6f74","new":"cdf200ab67a5230e","interface_changed":true,"affected":["codegen.get_field","codegen.narrow","codegen.set_path","codegen.member_tags","codegen.to_union","codegen.member_named","codegen.type_pattern","codegen.union_drop","codegen.read_slot","codegen.construct_want","codegen.copy_fn","codegen.in_place_path","codegen.walkable","codegen.share_fn","codegen.expr_node","codegen.matches","codegen.binds","codegen.union_text","codegen.union_eq","codegen.union_cmp","codegen.union_call","codegen.check_union","codegen.if_want","codegen.matching_v","codegen.union_set","codegen.assign_at","codegen.set_field_in_p