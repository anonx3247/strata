egen.Gen,\n  es: List[ast.Expr],\n  wants: List[check.Ty],\n) -> Option[List[codegen.V]] {\n  mut later := es.map(_ -> false)\n  mut k := len(es) - 2\n  while k >= 0 {\n    later = take(later, k)\n      + [get(later, k + 1) ?? false\n        || codegen.assigns(get(es, k + 1) ?? ast.UnitExpr)]\n      + drop(later, k + 1)\n    k -= 1\n  }\n  mut out := []\n  for (i, x) in enumerate(es) {\n    w := get(wants, i) ?? check.TAny\n    v := if w is check.TAny {\n      codegen.expr(mut g, x)\n    } else {\n      y := codegen.expr_want(mut g, x, w)\n      if y.ty is check.TAny {\n        y\n      } else {\n        codegen.converted(mut g, y, w)\n      }\n    }\n    if v.ty is check.TAny {\n      return None\n    }\n    mut out.push(\n      if get(later, i) ?? false {\n        codegen.hold(mut g, v)\n      } else {\n        v\n      },\n    )\n  }\n  Some(out)\n}","old_text":"/// `operands`, each as `wants` says (`TAny`: as it comes).\nfn operands_want(\n  mut g: codegen.Gen,\n  es: List[ast.Expr],\n  wants: List[Ty],\n) -> Option[List[codegen.V]] {\n  mut later := es.map(_ -> false)\n  mut k := len(es) - 2\n  while k >= 0 {\n    later = take(later, k)\n      + [get(later, k + 1) ?? false\n        || codegen.assigns(get(es, k + 1) ?? ast.UnitExpr)]\n      + drop(later, k + 1)\n    k -= 1\n  }\n  mut out := []\n  for (i, x) in enumerate(es) {\n    w := get(wants, i) ?? TAny\n    v := if w is TAny {\n      codegen.expr(mut g, x)\n    } else {\n      y := codegen.expr_want(mut g, x, w)\n      if y.ty is TAny {\n        y\n      } else {\n        codegen.converted(mut g, y, w)\n      }\n    }\n    if v.ty is TAny {\n      return None\n    }\n    mut out.push(\n      if get(later, i) ?? false {\n        codegen.hold(mut g, v)\n      } else {\n        v\n      },\n    )\n  }\n  Some(out)\n}"},{"name":"codegen.type_check","kind":"fn","old":"9bf5ba5046d0d4ae","new":"6c8dd3fa10b982ea","interface_changed":false,"affected":[],"module":"codegen","text":"/// `T.check(x)`, with `T` a type name or a type parameter: `Ok(())` when\n/// `x` meets the refinement of the type's name (a `distinct` type's on its\n/// field), else `Err` saying why. A refined alias given as a type argument\n/// is its base type here, so only named refinements are checked.\nfn type_check(mut g: codegen.Gen, tn: String, x: ast.Expr) -> codegen.V {\n  v := codegen.expr(mut g, x)\n  if v.ty is check.TAny {\n    return v\n  }\n  n := match get(g.sub, \"$w:\" + tn) {\n    // a refined type argument: its refinement\n    Some(check.TNamed { name, .. }) => name,\n    _ => match get(g.sub, tn) {\n      Some(check.TNamed { name, .. }) => name,\n      Some(_) => \"\",\n      // `Self.check` in an instance for a refined `Self` (`Many[Int]`)\n      None => match get(g.sub, \"$w:$self\") {\n        Some(sw) => match sw {\n          check.TNamed { name, .. } => if codegen.head_of(codegen.unfold_written(g, sw)) == tn {\n            name\n          } else {\n            tn\n          },\n          _ => tn,\n        },\n        None => tn,\n      },\n    },\n  }\n  (ok, why) := match get(g.refines, n) {\n    Some((_, p)) => (codegen.V {\n      ty: check.TBool,\n      op: codegen.holds_pred(\n        mut g,\n        ast.Named { name: n, args: [] },\n        v,\n        p,\n      ),\n    }, if starts_with(n, \"$where\") {\n      // a refinement written as a type argument: as written\n      base := match get(g.refines, n) {\n        Some((b, _)) => text.type_text(b),\n        None => \"_\",\n      }\n      f\"does not satisfy `{base} where {text.expr_text(p, 0)}`\"\n    } else {\n      f\"does not satisfy `{codegen.short(n)}` (where {text.expr_text(p, 0)})\"\n    }),\n    None => (\n      codegen.V { ty: check.TBool, op: \"true\" },\n      f\"does not satisfy `{codegen.key(v.ty)}`\",\n    ),\n  }\n  s := codegen.shown(mut g, v)\n  st := codegen.temp(mut g, s)\n  w := codegen.V { ty: check.TStr, op: codegen.string(mut g, why) }\n  codegen.call_fn_want(\n    mut g,\n    codegen.prelude_name(\"check_result\"),\n    [ok, st, w],\n    [],\n    check.TAny,\n  )\n}","old_text":"/// `T.check(x)`, with `T` a type name or a type parameter: `Ok(())` when\n/// `x` meets the refinement of the type's name (a `distinct` type's on its\n/// field), else `Err` saying why. A refined alias given as a type argument\n/// is its base type here, so only named refinements are checked.\nfn type_check(mut g: codegen.Gen, tn: String, x: ast.Expr) -> codegen.V {\n  v := codegen.expr(mut g, x)\n  if v.ty is TAny {\n    return v\n  }\n  n := match get(g.sub, \"$w:\" + tn) {\n    // a refined type argument: its refinement\n    Some(TNamed { name, .. }) => name,\n    _ => match get(g.sub, tn) {\n      Some(TNamed { name, .. }) => name,\n      Some(_) => \"\",\n      // `Self.check` in an instance for a refined `Self` (`Many[Int]`)\n      None => match get(g.sub, \"$w:$self\") {\n        Some(sw) => match sw {\n          TNamed { name, .. } => if codegen.head_of(codegen.unfold_written(g, sw)) == tn {\n            name\n          } else {\n            tn\n          },\n          _ => tn,\n        },\n        None => tn,\n      },\n    },\n  }\n  (ok, why) := match get(g.refines, n) {\n    Some((_, p)) => (codegen.V {\n      ty: TBool,\n      op: codegen.holds_pred(\n        mut g,\n        ast.Named { name: n, args: [] },\n        v,\n        p,\n      ),\n    }, if starts_with(n, \"$where\") {\n      // a refinement written as a type argument: as written\n      base := match get(g.refines, n) {\n        Some((b, _)) => text.type_text(b),\n        None => \"_\",\n      }\n      f\"does not satisfy `{base} where {text.expr_text(p, 0)}`\"\n    } else {\n      f\"does not satisfy `{codegen.short(n)}` (where {text.expr_text(p, 0)})\"\n    }),\n    None => (\n      codegen.V { ty: TBool, op: \"true\" },\n      f\"does not satisfy `{codegen.key(v.ty)}`\",\n    ),\n  }\n  s := codegen.shown(mut g, v)\n  st := codegen.temp(mut g, s)\n  w := codegen.V { ty: TStr, op: codegen.string(mut g, why) }\n  codegen.call_fn_want(\n    mut g,\n    codegen.prelude_name(\"check_result\"),\n    [ok, st, w],\n    [],\n    TAny,\n  )\n}"},{"name":"codegen.dyn_entry_at","kind":"fn","old":"70b0de16b46c6d38","new":"c5711e2d0f770eab","interface_changed":true,"affected":["codegen.dyn_entry","codegen.dyn_call","codegen.show","codegen.shown","codegen.dyn_equal","codegen.call_named","codegen.method_call","codegen.clock_now","codegen.entry","codegen.interp","codegen.builtin","codegen.string_builtin","codegen.format_spec","codegen.dyn_wrapper","codegen.union_text","codegen.destructure","codegen.debug_fields","codegen.for_loop","codegen.debug_list","codegen.checked","codegen.fail_unless","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.fuzz_driver","codegen.trace_enter","codegen.trace_leave","codegen.type_check","codegen.matching_v","codegen.index_check","codegen.checked_update","codegen.decreases_fault","codegen.equal","codegen.expr_node","codegen.expr_want_node","codegen.select_expr","codegen.generate","codegen.builtin_call","codegen.push_in_place","codegen.vtable","codegen.helper","codegen.stmt_node","codegen.debug_body","codegen.assertion","codegen.invariants","codegen.check_union","codegen.check_member","codegen.construct_want","codegen.has_field_check","codegen.function","codegen.declare","codegen.call_fn_want","codegen.check_payload","codegen.check_field","codegen.assign_at","codegen.lambda_shown","codegen.set_in_place","codegen.matching_want","codegen.list_builtin","codegen.decreases_pass","codegen.decreases_call","codegen.apply","codegen.eq_fields","codegen.matches","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.expr","codegen.expr_want","codegen_with","core_rt_text","computed_value","repl_eval","codegen.except_expr","codegen.update_in_place","codegen.to_dyn","codegen.dyn_table_is","codegen.stmt","codegen.construct","codegen.get_field","codegen.compiled_alone","codegen.call_fn","codegen.options","codegen.regex_matches","codegen.by_varia