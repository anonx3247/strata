degen.to_dyn(mut g, term, \"std.io.Console\")\n    },\n    // `Tracing` under `--trace`\n    check.TNamed { name: \"std.process.RunMode\", .. } => return codegen.expr(mut g, ast.CtorExpr { name: if g.tracing {\n      \"std.process.Tracing\"\n    } else {\n      \"std.process.Running\"\n    }, args: ast.NoArgs }),\n    check.TNamed { name, args: [] } => {\n      if codegen.trait_method_key(\n        mut g,\n        \"std.cli.CommandLine\",\n        name,\n        \"from_args\",\n      ) != \"\" {\n        return codegen.options(mut g, name, t)\n      }\n      match get(g.types.ctors, name) {\n        Some(sh) => if len(sh.fields) == 0 {\n          return codegen.construct(mut g, name, ast.RecordArgs([]))\n        },\n        None => (),\n      }\n    },\n    _ => (),\n  }\n  // any other type is an error\n  instead := match t {\n    check.TTrait(\"std.fs.Files\") => \" Name the capability instead, `disk: Disk` (std.fs), and pass it where `Files` is wanted.\",\n    check.TTrait(\"std.process.Environment\") => \" Name the capability instead, `process: Process` (std.process), and pass it where `Environment` is wanted.\",\n    check.TTrait(\"std.process.Commands\") => \" Name the capability instead, `mut launcher: Launcher` (std.process), and pass it where `Commands` is wanted.\",\n    _ => \"\",\n  }\n  e := \"`\"\n    + g.fname\n    + \"` can ask for `Console` (std.io), capabilities (`Disk` from std.fs, `Process` or `Launcher` from std.process, or the program's own `capability ...`), and options: a record that implements `CommandLine` (std.cli).\"\n    + instead\n    + f\" Its parameter `{p.name}` is a `{text.type_text(p.ty)}`\"\n  mut g.errs.push(e)\n  codegen.add_failed(mut g, g.current)\n  codegen.never()\n}","old_text":"/// A value for `main`'s parameter `p`, as `strata run` provides it: the\n/// options (`derive CommandLine`) parsed from the arguments, a capability\n/// (an empty record), the console (the terminal), or the run mode\n/// (`Running`).\nfn main_arg(mut g: codegen.Gen, p: ast.Param) -> codegen.V {\n  t := codegen.lower(mut g, p.ty)\n  match t {\n    TTrait(\"std.io.Console\") => {\n      term := codegen.construct(\n        mut g,\n        \"std.io.Terminal\",\n        ast.RecordArgs([]),\n      )\n      return codegen.to_dyn(mut g, term, \"std.io.Console\")\n    },\n    // `Tracing` under `--trace`\n    TNamed { name: \"std.process.RunMode\", .. } => return codegen.expr(mut g, ast.CtorExpr { name: if g.tracing {\n      \"std.process.Tracing\"\n    } else {\n      \"std.process.Running\"\n    }, args: ast.NoArgs }),\n    TNamed { name, args: [] } => {\n      if codegen.trait_method_key(\n        mut g,\n        \"std.cli.CommandLine\",\n        name,\n        \"from_args\",\n      ) != \"\" {\n        return codegen.options(mut g, name, t)\n      }\n      match get(g.types.ctors, name) {\n        Some(sh) => if len(sh.fields) == 0 {\n          return codegen.construct(mut g, name, ast.RecordArgs([]))\n        },\n        None => (),\n      }\n    },\n    _ => (),\n  }\n  // any other type is an error\n  instead := match t {\n    TTrait(\"std.fs.Files\") => \" Name the capability instead, `disk: Disk` (std.fs), and pass it where `Files` is wanted.\",\n    TTrait(\"std.process.Environment\") => \" Name the capability instead, `process: Process` (std.process), and pass it where `Environment` is wanted.\",\n    TTrait(\"std.process.Commands\") => \" Name the capability instead, `mut launcher: Launcher` (std.process), and pass it where `Commands` is wanted.\",\n    _ => \"\",\n  }\n  e := \"`\"\n    + g.fname\n    + \"` can ask for `Console` (std.io), capabilities (`Disk` from std.fs, `Process` or `Launcher` from std.process, or the program's own `capability ...`), and options: a record that implements `CommandLine` (std.cli).\"\n    + instead\n    + f\" Its parameter `{p.name}` is a `{text.type_text(p.ty)}`\"\n  mut g.errs.push(e)\n  codegen.add_failed(mut g, g.current)\n  codegen.never()\n}"},{"name":"codegen.options","kind":"fn","old":"54aac5821d380c41","new":"7b1a61342bceb876","interface_changed":true,"affected":["codegen.main_arg","codegen.entry","codegen.generate","codegen_with","core_rt_text","computed_value","repl_eval","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.new_gen","codegen.compiled_alone","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// `main`'s options from the program's arguments (`from_args`). Help (exit\n/// 0) or an argument error (exit 2) ends the program.\nfn options(mut g: codegen.Gen, name: String, t: check.Ty) -> codegen.V {\n  k := codegen.trait_method_key(\n    mut g,\n    \"std.cli.CommandLine\",\n    name,\n    \"from_args\",\n  )\n  prog := codegen.call(mut g, check.TStr, \"strata_prog_name\", [])\n  argv := codegen.call(\n    mut g,\n    check.TList(check.TStr),\n    \"strata_host_args\",\n    [],\n  )\n  err := check.TNamed { name: \"std.cli.CliError\", args: [] }\n  res := check.TNamed { name: \"Result\", args: [t, err] }\n  r0 := codegen.call_fn_want(mut g, k, [prog, argv], [], res)\n  r := codegen.V { ..r0, ty: res }\n  is_ok := codegen.tag_is(mut g, r, \"Ok\")\n  (ok, bad) := (\n    codegen.label(mut g, \"opts.ok\"),\n    codegen.label(mut g, \"opts.err\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"br i1 {is_ok.op}, label %{ok}, label %{bad}\",\n  )\n  codegen.block(mut g, bad)\n  e := codegen.field(mut g, r, 0, err)\n  help := codegen.tag_is(mut g, e, \"std.cli.ShowHelp\")\n  (yes, no) := (\n    codegen.label(mut g, \"opts.help\"),\n    codegen.label(mut g, \"opts.bad\"),\n  )\n  codegen.emit(mut g, f\"br i1 {help.op}, label %{yes}, label %{no}\")\n  for (l, code) in [(yes, 0), (no, 2)] {\n    codegen.block(mut g, l)\n    text := codegen.field(mut g, e, 0, check.TStr)\n    flag := if code == 0 {\n      \"true\"\n    } else {\n      \"false\"\n    }\n    codegen.use_rt(mut g, \"strata_options_error\")\n    codegen.emit(\n      mut g,\n      f\"call void @strata_options_error(i1 {flag}, ptr {text.op})\",\n    )\n    codegen.drop_from(mut g, 0, \"\")\n    codegen.emit(mut g, f\"ret i32 {code}\")\n  }\n  codegen.block(mut g, ok)\n  codegen.field(mut g, r, 0, t)\n}","old_text":"/// `main`'s options from the program's arguments (`from_args`). Help (exit\n/// 0) or an argument error (exit 2) ends the program.\nfn options(mut g: codegen.Gen, name: String, t: Ty) -> codegen.V {\n  k := codegen.trait_method_key(\n    mut g,\n    \"std.cli.CommandLine\",\n    name,\n    \"from_args\",\n  )\n  prog := codegen.call(mut g, TStr, \"strata_prog_name\", [])\n  argv := codegen.call(mut g, TList(TStr), \"strata_host_args\", [])\n  err := TNamed { name: \"std.cli.CliError\", args: [] }\n  res := TNamed { name: \"Result\", args: [t, err] }\n  r0 := codegen.call_fn_want(mut g, k, [prog, argv], [], res)\n  r := codegen.V { ..r0, ty: res }\n  is_ok := codegen.tag_is(mut g, r, \"Ok\")\n  (ok, bad) := (\n    codegen.label(mut g, \"opts.ok\"),\n    codegen.label(mut g, \"opts.err\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"br i1 {is_ok.op}, label %{ok}, label %{bad}\",\n  )\n  codegen.block(mut g, bad)\n  e := codegen.field(mut g, r, 0, err)\n  help := codegen.tag_is(mut g, e, \"std.cli.ShowHelp\")\n  (yes, no) := (\n    codegen.label(mut g, \"opts.help\"),\n    codegen.label(mut g, \"opts.bad\"),\n  )\n  codegen.emit(mut g, f\"br i1 {help.op}, label %{yes}, label %{no}\")\n  for (l, code) in [(yes, 0), (no, 2)] {\n    codegen.block(mut g, l)\n    text := codegen.field(mut g, e, 0, TStr)\n    flag := if code == 0 {\n      \"true\"\n    } else {\n      \"false\"\n    }\n    codegen.use_rt(mut g, \"strata_options_error\")\n    codegen.emit(\n      mut g,\n      f\"call void @strata_options_error(i1 {flag}, ptr {text.op})\",\n    )\n    codegen.drop_from(mut g, 0, \"\")\n    codegen.emit(mut g, f\"ret i32 {code}\")\n  }\n  codegen.block(mut g, ok)\n  codegen.field(mut g, r, 0, t)\n}"},{"name":"codegen.host","kind":"fn","old":"3f4377796a2be519","new":"53d29d548fd63cdc","interface_changed":false,"affected":[],"module":"codegen","text":"/// std's native operations (`host_*`) from the runtime. Their results are\n/// wrapped into an `Option` or `Result` here, since only compiled code\n/// knows the tags.\nfn host(mut g: codegen.Gen, name: String, vs: List[codegen.V]) -> codegen.V {\n  pair := check.TNamed { name: \"Tuple\", args: [check.TStr, check.TStr] }\n  strs := check.TList(check.TStr)\n  if name == \"host_write\" {\n    return codegen.call(mut g, check.TUnit, \"strata_host_write\", vs)\n  }\n  if name == \"host_exists\"\n    || name == \"host_is_dir\"\n    || name == \"host_terminal\" {\n    return codegen.call(mut g, check.TBool, \"strata_\" + name, vs)\n  }\n  if name == \"host_read_stdin\" || name == \"host_current_dir\" {\n    return codegen.call(mut g, check.TStr, \"strata_\" + name, [])\n  }\n  if name == \"host_now\" {\n    return codegen.call(mut g, check.TInt, \"strata_host_now\", [])\n  }\n  if name == \"host_wall_now\" {\n    return codegen.call(mut g, check.TInt, \"strata_host_wall_now\", [])\n  }\n  if name == \"host_sleep\" {\n    _ := codegen.call(mut g, check.TUnit, \"strata_host_sleep\", vs)\n    // a wait: a cancelled task stops here\n    codegen.cancel_point(mut g)\n    return codegen.unit()\n  }\n  if name == \"host_args\" {\n    return codegen.call(mut g, strs, \"strata_host_args\", [])\n  }\n  // the codebase (`std.code`): under `strata run`, the snapshot made for\n  // the run (`$code_snapshot`, `$code_version`, from compiler/main's\n  // `code_snapshot_decls`). Elsewhere the runtime has none: a fault.\n  if (name == \"host_code_version\" || name == \"host_code_snapshot\")\n    && g.library_mode {\n    codegen.not_yet(\n      mut g,\n      \"the codebase in std's library (each run's own)\",\n    )\n    return codegen.never()\n  }\n  if name == \"host_code_version\" {\n    if codegen.has_fn(g, \"$code_version\") {\n      return codegen.call_fn(mut g, \"$code_version\", [], [])\n    }\n    return codegen.call(mut g, check.TStr, \"strata_host_code_version\", [])\n  }\n  if name == \"host_code_snapshot\" {\n    if codegen.has_fn(g, \"$code_snapshot\") {\n      return codegen.call_fn(mut g, \"$code_snapshot\", [], [])\n    }\n    return codegen.host_snapshot(mut g)\n  }\n  if name == \"host_env_var\" || name == \"host_read_line\" {\n    r := codegen.call(mut g, check.TStr, \"strata_\" + name, vs)\n    o := codegen.optional(\n      mut g,\n      r,\n      check.TNamed { name: \"Option\", args: [check.TStr] },\n    )\n    // a wait for input: a cancelled task gives up once it holds the line\n    codegen.cancel_point(mut g)\n    return o\n  }\n  ok := if name == \"host_read_file\" || name == \"host_absolute\" {\n    check.TStr\n  } else if name == \"host_read_bytes\" {\n    check.TList(check.TInt)\n  } else if name == \"host_list_dir\" || name == \"host_run\" {\n    strs\n  } else {\n    check.TUnit\n  }\n  res := check.TNamed { name: \"Result\", args: [ok, pair] }\n  if ![\n    \"host_read_file\",\n    \"host_read_bytes\",\n    \"host_list_dir\",\n    \"host_run\",\n    \"host_write_file\",\n    \"host_make_dir\",\n    \"host_remove\",\n    \"host_absolute\",\n    \"host_write_bytes\",\n    \"host_rename\",\n    \"host_remove_all\",\n  ].any(\n    x -> x == name,\n  ) {\n    codegen.not_yet(mut g, \"`\" + name + \"`\")\n    return codegen.never()\n  }\n  // a value (or true), or NULL (false) with the failure's kind and message\n  (ks, ms) := (codegen.fresh(mut g, \"kind\"), codegen.fresh(mut g, \"msg\"))\n  mut g.allocas.push(f\"  {ks} = alloca ptr\")\n  mut g.allocas.push(f\"  {ms} = alloca ptr\")\n  slots := [\n    codegen.V { ty: check.TStr, op: ks },\n    codegen.V { ty: check.TStr, op: ms },\n  ]\n  if ok is check.TUnit {\n    done := codegen.call(mut g, check.TBool, \"strata_\" + name, vs + slots)\n    codegen.outcome(mut g, done.op, codegen.unit(), ks, ms, res)\n  } else {\n    r := codegen.call(mut g, ok, \"strata_\" + name, vs + slots)\n    got := codegen.fresh(mut g, \"ok\")\n    codegen.emit(mut g, f\"{got} = icmp ne ptr {r.op}, null\")\n    codegen.outcome(mut g, got, r, ks, ms, res)\n  }\n}","old_text":"/// std's native operations (`host_*`) from the runtime. Their results are\n/// wrapped into an `Option` or `Result` here, since only compiled code\n/// knows the tags.\nfn host(mut g: codegen.Gen, name: String, vs: List[codegen.V]) -> codegen.V {\n  pair := TNamed { name: \"Tuple\", args: [TStr, TStr] }\n  strs := TList(TStr)\n  if name == \"host_write\" {\n    return codegen.call(mut g, TUnit, \"strata_host_write\", vs)\n  }\n  if name == \"host_exists\"\n    || name == \"host_is_dir\"\n    || name == \"host_terminal\" {\n    return codegen.call(mut g, TBool, \"strata_\" + name, vs)\n  }\n  if name == \"host_read_stdin\" || name == \"host_current_dir\" {\n    return codegen.call(mut g, TStr, \"strata_\" + name, [])\n  }\n  if name == \"host_now\" {\n    return codegen.call(mut g, TInt, \"strata_host_now\", [])\n  }\n  if name == \"host_wall_now\" {\n    return codegen.call(mut g, TInt, \"strata_host_wall_now\", [])\n  }\n  if name == \"host_sleep\" {\n    _ := codegen.call(mut g, TUnit, \"strata_host_sleep\", vs)\n    // a wait: a cancelled task stops here\n    codegen.cancel_point(mut g)\n    return codegen.unit()\n  }\n  if name == \"host_args\" {\n    return codegen.call(mut g, strs, \"strata_host_args\", [])\n  }\n  // the codebase (`std.code`): under `strata run`, the snapshot made for\n  // the run (`$code_snapshot`, `$code_version`, from compiler/main's\n  // `code_snapshot_decls`). Elsewhere the runtime has none: a fault.\n  if (name == \"host_code_version\" || name == \"host_code_snapshot\")\n    && g.library_mode {\n    codegen.not_yet(\n      mut g,\n      \"the codebase in std's library (each run's own)\",\n    )\n    return codegen.never()\n  }\n  if name == \"host_code_version\" {\n    if codegen.has_fn(g, \"$code_version\") {\n      return codegen.call_fn(mut g, \"$code_version\", [], [])\n    }\n    return codegen.call(mut g, TStr, \"strata_host_code_version\", [])\n  }\n  if name == \"host_code_snapshot\" {\n    if codegen.has_fn(g, \"$code_snapshot\") {\n      return codegen.call_fn(mut g, \"$code_snapshot\", [], [])\n    }\n    return codegen.host_snapshot(mut g)\n  }\n  if name == \"host_env_var\" || name == \"host_read_line\" {\n    r := codegen.call(mut g, TStr, \"strata_\" + name, vs)\n    o := codegen.optional(\n      mut g,\n      r,\n      TNamed { name: \"Option\", args: [TStr] },\n    )\n    // a wait for input: a cancelled task gives up once it holds the line\n    codegen.cancel_point(mut g)\n    return o\n  }\n  ok := if name == \"host_read_file\" || name == \"host_absolute\" {\n    TStr\n  } else if name == \"host_read_bytes\" {\n    TList(TInt)\n  } else if name == \"host_list_dir\" || name == \"host_run\" {\n    strs\n  } else {\n    TUnit\n  }\n  res := TNamed { name: \"Result\", args: [ok, pair] }\n  if ![\n    \"host_read_file\",\n    \"host_read_bytes\",\n    \"host_list_dir\",\n    \"host_run\",\n    \"host_write_file\",\n    \"host_make_dir\",\n    \"host_remove\",\n    \"host_absolute\",\n    \"host_write_bytes\",\n    \"host_rename\",\n    \"host_remove_all\",\n  ].any(\n    x -> x == name,\n  ) {\n    codegen.not_yet(mut g, \"`\" + name + \"`\")\n    return codegen.never()\n  }\n  // a value (or true), or NULL (false) with the failure's kind and message\n  (ks, ms) := (codegen.fresh(mut g, \"kind\"), codegen.fresh(mut g, \"msg\"))\n  mut g.allocas.push(f\"  {ks} = alloca ptr\")\n  mut g.allocas.push(f\"  {ms} = alloca ptr\")\n  slots := [codegen.V { ty: TStr, op: ks }, codegen.V { ty: TStr, op: ms }]\n  if ok is TUnit {\n    done := codegen.call(mut g, TBool, \"strata_\" + name, vs + slots)\n    codegen.outcome(mut g, done.op, codegen.unit(), ks, ms, res)\n  } else {\n    r := codegen.call(mut g, ok, \"strata_\" + name, vs + slots)\n    got := codegen.fresh(mut g, \"ok\")\n    codegen.emit(mut g, f\"{got} = icmp ne ptr {r.op}, null\")\n    codegen.outcome(mut g, got, r, ks, ms, res)\n  }\n}"},{"name":"codegen.optional","kind":"fn","old":"5bedb36142136a45","new":"8cd719bf073438cb","interface_changed":true,"affected":["codegen.host","codegen.from_c","codegen.builtin","codegen.foreign_call","codegen.export_entry","codegen.call_named","codegen.builtin_call","codegen.push_in_place","codegen.function","codegen.generate","codegen.expr_node","codegen.expr_want_node","codegen.method_call","codegen.except_expr","codegen.matching_want","codegen.update_in_place","codegen.compiled_alone","codegen_with","core_rt_text","computed_value","repl_eval","codegen.expr","codegen.expr_want","codegen.matching","codegen.stmt_node","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.c