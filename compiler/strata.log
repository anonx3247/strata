c","codegen.gen_data","codegen.mock_value","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.generated","codegen.can_generate","codegen.foreign_call","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.generated_args","codegen.makers","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// `dyn_entry`, with options:\n/// - `by_cell`: passes the address of the value's cell instead of the\n/// value (a `mut self` method)\n/// - `node`: `waits_of`'s name for the methods the entry may be, which\n/// decides whether a cancelled task may leave there\nfn dyn_entry_at(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  k: Int,\n  rt: check.Ty,\n  args: List[codegen.V],\n  by_cell: Bool,\n  node: String,\n) -> codegen.V {\n  (raw, vt, fp, f, sp, s) := (\n    codegen.fresh(mut g, \"vraw\"),\n    codegen.fresh(mut g, \"vt\"),\n    codegen.fresh(mut g, \"fp\"),\n    codegen.fresh(mut g, \"f\"),\n    codegen.fresh(mut g, \"sp\"),\n    codegen.fresh(mut g, \"s\"),\n  )\n  codegen.emit(mut g, f\"{raw} = load i64, ptr {v.op}\")\n  codegen.emit(mut g, f\"{vt} = inttoptr i64 {raw} to ptr\")\n  codegen.emit(\n    mut g,\n    f\"{fp} = getelementptr ptr, ptr {vt}, i64 {k}\",\n  )\n  codegen.emit(mut g, f\"{f} = load ptr, ptr {fp}\")\n  codegen.emit(\n    mut g,\n    f\"{sp} = getelementptr i64, ptr {v.op}, i64 1\",\n  )\n  if by_cell {\n    codegen.emit(mut g, f\"{s} = ptrtoint ptr {sp} to i64\")\n  } else {\n    codegen.emit(mut g, f\"{s} = load i64, ptr {sp}\")\n  }\n  r := codegen.call_bare(\n    mut g,\n    rt,\n    f,\n    [codegen.V { ty: check.TInt, op: s }] + args,\n  )\n  if codegen.may_wait(g, node) {\n    codegen.cancel_point_after(mut g, r)\n  }\n  codegen.temp(mut g, r)\n}","old_text":"/// `dyn_entry`, with options:\n/// - `by_cell`: passes the address of the value's cell instead of the\n/// value (a `mut self` method)\n/// - `node`: `waits_of`'s name for the methods the entry may be, which\n/// decides whether a cancelled task may leave there\nfn dyn_entry_at(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  k: Int,\n  rt: Ty,\n  args: List[codegen.V],\n  by_cell: Bool,\n  node: String,\n) -> codegen.V {\n  (raw, vt, fp, f, sp, s) := (\n    codegen.fresh(mut g, \"vraw\"),\n    codegen.fresh(mut g, \"vt\"),\n    codegen.fresh(mut g, \"fp\"),\n    codegen.fresh(mut g, \"f\"),\n    codegen.fresh(mut g, \"sp\"),\n    codegen.fresh(mut g, \"s\"),\n  )\n  codegen.emit(mut g, f\"{raw} = load i64, ptr {v.op}\")\n  codegen.emit(mut g, f\"{vt} = inttoptr i64 {raw} to ptr\")\n  codegen.emit(\n    mut g,\n    f\"{fp} = getelementptr ptr, ptr {vt}, i64 {k}\",\n  )\n  codegen.emit(mut g, f\"{f} = load ptr, ptr {fp}\")\n  codegen.emit(\n    mut g,\n    f\"{sp} = getelementptr i64, ptr {v.op}, i64 1\",\n  )\n  if by_cell {\n    codegen.emit(mut g, f\"{s} = ptrtoint ptr {sp} to i64\")\n  } else {\n    codegen.emit(mut g, f\"{s} = load i64, ptr {sp}\")\n  }\n  r := codegen.call_bare(\n    mut g,\n    rt,\n    f,\n    [codegen.V { ty: TInt, op: s }] + args,\n  )\n  if codegen.may_wait(g, node) {\n    codegen.cancel_point_after(mut g, r)\n  }\n  codegen.temp(mut g, r)\n}"},{"name":"codegen.if_want","kind":"fn","old":"dd0cb3cb7481cbf0","new":"87b83663a0d50a5a","interface_changed":true,"affected":["codegen.if_expr","codegen.expr_want_node","codegen.expr_node","codegen.expr_want","codegen.expr","codegen.function","codegen.binary","codegen.declare","codegen.destructure","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.method_call","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.construct_want","codegen.operands_want","codegen.wanted","co