= codegen.from_slot(mut g, old, et)\n  codegen.drop_value(mut g, ov)\n}"},{"name":"codegen.set_copy","kind":"fn","old":"71ebcd0ed75a3a47","new":"fd8f61f67a99a719","interface_changed":true,"affected":["codegen.set_in_place","codegen.put_in","codegen.update_in_place","codegen.stmt_node","codegen.builtin_call","codegen.stmt","codegen.call_named","codegen.method_call","codegen.except_expr","codegen.matching_want","codegen.block_expr","codegen.iterate","codegen.decreases_start","codegen.decreases_pass","codegen.decreases_entry","codegen.decreases_call","codegen.build_fn","codegen.expr_node","codegen.expr_want_node","codegen.matching","codegen.for_list","codegen.function","codegen.call_fn_want","codegen.built_or_generated","codegen.expr","codegen.expr_want","codegen.for_loop","codegen.compiled_alone","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.fuzz_driver","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.if_want","codegen.branch_value","codegen.try_want","codegen.tag_test","codegen.take_in_place","codegen.compared","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.declare","codegen.list_literal_of","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.wanted","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.generate","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.dyn_wrapper","codegen.union_call","codegen.