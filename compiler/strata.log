nge","apply_edit","fix_loops","with_base","codegen.generated","codegen.can_generate","codegen.to_c","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.generated_args","codegen.makers","codegen.read_back","eval_files"],"module":"codegen","text":"/// The value a call gave as `w` (`words_ll`) seen as a block: its own\n/// block when it gave one, else its words in a block on the stack. Which\n/// one is known at run time only: `rp_ptrs` keeps the pointer it gave, for\n/// its drop (`drop_held`) and its result (`result_words`). A few stores and\n/// a `select`.\nfn held_words(mut g: codegen.Gen, t: check.Ty, w: String) -> String {\n  n := codegen.small_words(g, t)\n  (ptr, none, b) := (\n    codegen.fresh(mut g, \"given\"),\n    codegen.fresh(mut g, \"none\"),\n    codegen.fresh(mut g, \"held\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"{ptr} = extractvalue {codegen.words_ll(n)} {w}, 0\",\n  )\n  p := codegen.stack_words(mut g, t, w)\n  codegen.emit(mut g, f\"{none} = icmp eq ptr {ptr}, null\")\n  codegen.emit(mut g, f\"{b} = select i1 {none}, ptr {p}, ptr {ptr}\")\n  mut g.rp_ptrs.insert(b, ptr)\n  b\n}","old_text":"/// The value a call gave as `w` (`words_ll`) seen as a block: its own\n/// block when it gave one, else its words in a block on the stack. Which\n/// one is known at run time only: `rp_ptrs` keeps the pointer it gave, for\n/// its drop (`drop_held`) and its result (`result_words`). A few stores and\n/// a `select`.\nfn held_words(mut g: codegen.Gen, t: Ty, w: String) -> String {\n  n := codegen.small_words(g, t)\n  (ptr, none, b) := (\n    codegen.fresh(mut g, \"given\"),\n    codegen.fresh(mut g, \"none\"),\n    codegen.fresh(mut g, \"held\"),\n  )\n  codegen.emit(\n    mut g,\n    f\"{ptr} = extractvalue {codegen.words_ll(n)} {w}, 0\",\n  )\n  p := codegen.stack_words(mut g, t, w)\n  codegen.emit(mut g, f\"{none} = icmp eq ptr {ptr}, null\")\n  codegen.emit(mut g, f\"{b} = select i1 {none}, ptr {p}, ptr {ptr}\")\n  mut g.rp_ptrs.insert(b, ptr)\n  b\n}"},{"name":"codegen.drop_held","kind":"fn","old":"528ba7b0237b6bfb","new":"8f541635e5e28ab2","interface_changed":false,"affected":[],"module":"codegen","text":"/// A value going away (a scope's temporary, what a cancelled task held):\n/// a small value whose block is on the stack (`stack_ops`, or `rp_ptrs`\n/// with a null pointer) drops only its fields; one whose block is known\n/// at run time only (`held_words`) is tested; any other is dropped.\nfn drop_held(mut g: codegen.Gen, v: codegen.V) {\n  match get(g.rp_ptrs, v.op) {\n    Some(\"null\") => codegen.drop_stacked(mut g, v, [check.TAny]),\n    Some(p) => if p == v.op {\n      codegen.drop_value(mut g, v)\n    } else {\n      (none, on, by, done) := (\n        codegen.fresh(mut g, \"none\"),\n        codegen.label(mut g, \"drop.on\"),\n        codegen.label(mut g, \"drop.by\"),\n        codegen.label(mut g, \"drop.done\"),\n      )\n      codegen.emit(mut g, f\"{none} = icmp eq ptr {p}, null\")\n      codegen.emit(mut g, f\"br i1 {none}, label %{on}, label %{by}\")\n      codegen.block(mut g, on)\n      codegen.drop_stacked(mut g, v, [check.TAny])\n      codegen.br(mut g, done)\n      codegen.block(mut g, by)\n      codegen.drop_value(mut g, v)\n      codegen.br(mut g, done)\n      codegen.block(mut g, done)\n    },\n    None => if contains(g.stack_ops, v.op) {\n      codegen.drop_stacked(mut g, v, [check.TAny])\n    } else {\n      codegen.drop_value(mut g, v)\n    },\n  }\n}","old_text":"/// A value going away (a scope's temporary, what a cancelled task held):\n/// a small value whose block is on the stack (`stack_ops`, or `rp_ptrs`\n/// with a null pointer) drops only its fields; one whose block is known\n/// at run time only (`held_words`) is tested; any other is dropped.\nfn drop_held(mut g: codegen.Gen, v: codegen.V) {\n  match get(g.rp_ptrs, v.op) {\n    Some(\"null\") => codegen.drop_stacked(mut g, v, [TAny]),\n    Some(p) => if p == v.op {\n      codegen.drop_value(mut g, v)\n    } else {\n      (none, on, by, done) := (\n        codegen.fresh(mut g, \"none\"),\n        codegen.label(mut g, \"drop.on\"),\n        codegen.label(mut g, \"drop.by\"),\n        codegen.label(mut g, \"drop.done\"),\n      )\n      codegen.emit(mut g, f\"{none} = icmp eq ptr {p}, null\")\n      codegen.emit(mut g, f\"br i1 {none}, label %{on}, label %{by}\")\n      codegen.block(mut g, on)\n      codegen.drop_stacked(mut g, v, [TAny])\n      codegen.br(mut g, done)\n      codegen.block(mut g, by)\n      codegen.drop_value(mut g, v)\n      codegen.br(mut g, done)\n      codegen.block(mut g, done)\n    },\n    None => if contains(g.stack_ops, v.op) {\n      codegen.drop_stacked(mut g, v, [TAny])\n    } else {\n      codegen.drop_value(mut g, v)\n    },\n  }\n}"},{"name":"codegen.unbox_fn","kind":"fn","old":"ca772fb4ddd8e6d1","new":"dae9e18967be8fcd","interface_changed":true,"affected":["codegen.words_value","codegen.call_at","codegen.call_fn_want","codegen.call","codegen.entry","codegen.show","codegen.shown","codegen.equal","codegen.mock_call","codegen.session_entry","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.function","codegen.int_lit","codegen.concat","codegen.apply","codegen.finite","codegen.fault","codegen.slice_raw","codegen.list_builtin","codegen.debug_list","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.number_builtin","codegen.format_spec","codegen.word_to_int","codegen.list_literal_of","codegen.checked","codegen.check_type","codegen.host","codegen.channel_op","codegen.trace_enter","codegen.trace_leave","codegen.mem_builtin","codegen.table_from","codegen.set_copy","codegen.checked_update","codegen.appended","codegen.expr_node","codegen.decreases_fault","codegen.build_fn","codegen.push_in_place","codegen.generate","codegen.interp","codegen.dyn_wrapper","codegen.union_text","codegen.destructure","codegen.debug_fields","codegen.for_loop","codegen.fail_unless","codegen.check_requires","codegen.check_ensures","codegen.fuzz_driver","codegen.matching_v","codegen.index_check","codegen.eq_fields","codegen.matches","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.expr_want_node","codegen.builtin_call","codegen.union_call","codegen.dyn_generic_call","codegen.main_arg","codegen.select_expr","codegen.compiled_alone","codegen.conversion","codegen.debug_body","codegen.binary","codegen.from_c","codegen.tries_end","codegen.mock_method","codegen.binds","codegen.list_slice","codegen.take_in_place","codegen.helper","codegen.gen_list","codegen.converted","codegen.update_in_place","codegen.list_literal","codegen.assertion","codegen.invariants","codegen.declare","codegen.check_payload","codegen.construct_want","codegen.check_field","codegen.assign_at","codegen.lambda_shown","codegen.set_in_place","codegen.stmt_node","codegen.put_in","codegen.expr","codegen.decreases_pass","codegen.decreases_call","codegen.built_or_generated","codegen_with","core_rt_text","computed_value","repl_eval","codegen.vtable","codegen.check_union","codegen.check_member","codegen.has_field_check","codegen.matching_want","codegen.eq_body","codegen.match_got","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.expr_want","codegen.except_expr","codegen.dyn_call","codegen.foreign_call","codegen.export_entry","codegen.produce","codegen.gen_data","codegen.mock_table","codegen.operands_want","codegen.wanted","codegen.table_find","codegen.construct","codegen.function_value","codegen.lambda","codegen.stmt","codegen.logic","codegen.loop_body","codegen.with_it","codegen.for_list","codegen.await_expr","codegen.race_expr","codegen.call_entry","codegen.if_want","codegen.branch_value","codegen.try_want","codegen.tag_test","codegen.compared","codegen.keep_olds","codegen.expr_on_stack","codegen.assigned_call","codegen_text","literal_errors","compiled_drivers","comp