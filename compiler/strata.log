l_files","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.hash_fields"],"module":"codegen","text":"/// What the runtime's list functions do with copied elements: 0 nothing,\n/// 1 hold each (objects), 2 hold the big ones (`Int`).\nfn elements_kind(et: check.Ty) -> codegen.V {\n  codegen.V { ty: check.TInt, op: if et is check.TInt {\n    \"2\"\n  } else if codegen.counted(et) {\n    \"1\"\n  } else {\n    \"0\"\n  } }\n}","old_text":"/// What the runtime's list functions do with copied elements: 0 nothing,\n/// 1 hold each (objects), 2 hold the big ones (`Int`).\nfn elements_kind(et: Ty) -> codegen.V {\n  codegen.V { ty: TInt, op: if et is TInt {\n    \"2\"\n  } else if codegen.counted(et) {\n    \"1\"\n  } else {\n    \"0\"\n  } }\n}"},{"name":"codegen.list_len","kind":"fn","old":"a962562f4f405f64","new":"17a56df2d03801ef","interface_changed":false,"affected":[],"module":"codegen","text":"fn list_len(mut g: codegen.Gen, v: codegen.V) -> codegen.V {\n  r := codegen.fresh(mut g, \"len\")\n  codegen.emit(mut g, f\"{r} = load i64, ptr {v.op}\")\n  codegen.V { ty: check.TInt, op: r }\n}","old_text":"fn list_len(mut g: codegen.Gen, v: codegen.V) -> codegen.V {\n  r := codegen.fresh(mut g, \"len\")\n  codegen.emit(mut g, f\"{r} = load i64, ptr {v.op}\")\n  codegen.V { ty: TInt, op: r }\n}"},{"name":"codegen.list_at","kind":"fn","old":"227c860cd70a2bc7","new":"2e61778e0d7f2ef0","interface_changed":true,"affected":["codegen.matches","codegen.binds","codegen.list_builtin","codegen.for_loop","codegen.eq_list","codegen.debug_list","codegen.collection_builtin","codegen.cmp_helper","codegen.check_type","codegen.await_list","codegen.list_get_or","codegen.match_got","codegen.set_in_place","codegen.destructure","codegen.matching_v","codegen.builtin","codegen.take_in_place","codegen.stmt_node","codegen.helper","codegen.gen_list","codegen.converted","codegen.update_in_place","codegen.order_closure","codegen.cmp_fields","codegen.union_c