. The\n/// block itself is the frame's.\nfn fields_drop_fn(mut g: codegen.Gen, t: check.Ty) -> String {\n  name := f\"@\\\"drop.fields:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  (multi, cs) := codegen.small_layout(g, t)\n  saved := g\n  codegen.start_helper(mut g)\n  a := codegen.V { ty: t, op: \"%a\" }\n  holding := cs.filter(c -> c.1.any(ft -> codegen.counted(ft)))\n  if !multi {\n    codegen.drop_counted(mut g, a, (get(cs, 0) ?? (\"\", [])).1)\n    codegen.emit(mut g, \"ret void\")\n  } else {\n    tg := codegen.tag_of(mut g, a)\n    mut cases := []\n    mut labels := []\n    for c in holding {\n      l := codegen.label(mut g, \"case.\" + codegen.short(c.0))\n      mut labels.push(l)\n      mut cases.push(f\"i64 {codegen.tag_word(g, c.0)}, label %{l}\")\n    }\n    codegen.emit(\n      mut g,\n      f\"switch i64 {tg}, label %done [ {join(cases, \" \")} ]\",\n    )\n    for (j, c) in enumerate(holding) {\n      codegen.block(mut g, get(labels, j) ?? \"\")\n      codegen.drop_counted(mut g, a, c.1)\n      codegen.br(mut g, \"done\")\n    }\n    codegen.block(mut g, \"done\")\n    codegen.emit(mut g, \"ret void\")\n  }\n  codegen.restore(\n    mut g,\n    saved,\n    codegen.helper_text(g, f\"define internal void {name}(ptr %a)\"),\n  )\n  name\n}","old_text":"/// The function dropping what a block on the stack of small type `t`\n/// holds (`@\"drop.fields:T\"`): the counted fields of its constructor. The\n/// block itself is the frame's.\nfn fields_drop_fn(mut g: codegen.Gen, t: Ty) -> String {\n  name := f\"@\\\"drop.fields:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  (multi, cs) := codegen.small_layout(g, t)\n  saved := g\n  codegen.start_helper(mut g)\n  a := codegen.V { ty: t, op: \"%a\" }\n  holding := cs.filter(c -> c.1.any(ft -> codegen.counted(ft)))\n  if !multi {\n    codegen.drop_counted(mut g, a, (get(cs, 0) ?? (\"\", [])).1)\n    codegen.emit(mut g, \"ret void\")\n  } else {\n    tg := codegen.tag_of(mut g, a)\n    mut cases := []\n    mut labels := []\n    for c in holding {\n      l := codegen.label(mut g, \"case.\" + codegen.short(c.0))\n      mut labels.push(l)\n      mut cases.push(f\"i64 {codegen.tag_word(g, c.0)}, label %{l}\")\n    }\n    codegen.emit(\n      mut g,\n      f\"switch i64 {tg}, label %done [ {join(cases, \" \")} ]\",\n    )\n    for (j, c) in enumerate(holding) {\n      codegen.block(mut g, get(labels, j) ?? \"\")\n      codegen.drop_counted(mut g, a, c.1)\n      codegen.br(mut g, \"done\")\n    }\n    codegen.block(mut g, \"done\")\n    codegen.emit(mut g, \"ret void\")\n  }\n  codegen.restore(\n    mut g,\n    saved,\n    codegen.helper_text(g, f\"define internal void {name}(ptr %a)\"),\n  )\n  name\n}"},{"name":"codegen.drop_counted","kind":"fn","old":"27503958fc3fd55a","new":"24e009271542c53a","interface_changed":true,"affected":["codegen.fields_drop_fn","codegen.drop_stacked","codegen.assign_held","codegen.drop_scope","codegen.unwind_all","codegen.drop_held","codegen.stmt_node","codegen.pop_scope","codegen.drop_from","codegen.unwind_here","codegen.cancel_point_after","codegen.stmt","codegen.tag_is","codegen.leave_branch","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.debug_list","codegen.block_expr","codegen.call_fn_want","codegen.with_it","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.invariants","codegen.iterate","codegen.await_list","codegen.select_expr","codegen.race_expr","codegen.satisfies","codegen.produce","codegen.gen_list","codegen.gen_data","codegen.mock_method","codegen.check_payload","codegen.check_union","codegen.trace_enter","codegen.trace_leave","codegen.update_in_place","codegen.set_in_place","codegen.put_in","codegen.take_in_place","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.push_in_place","codegen.entry","codegen.fau