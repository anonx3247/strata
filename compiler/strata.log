{"id":"600bc14a30cd423d","time":1795633863,"message":"rename parse.rust_quoted → parse.debug_quoted","changes":[{"name":"parse.debug_quoted","kind":"fn","old":null,"new":"d0100485f6af55d1","interface_changed":true,"affected":[],"module":"parse","text":"/// A string as Rust's `{:?}` writes it.\nfn debug_quoted(s: String) -> String {\n  \"\\\"\"\n    + replace(replace(replace(\n      replace(replace(s, \"\\\\\", \"\\\\\\\\\"), \"\\\"\", \"\\\\\\\"\"),\n      \"\\n\",\n      \"\\\\n\",\n    ), \"\\t\", \"\\\\t\"), \"\\r\", \"\\r\")\n    + \"\\\"\"\n}"},{"name":"parse.tok_shown","kind":"fn","old":"5eb40b9488e39591","new":"0e4a3ee5193232bc","interface_changed":false,"affected":[],"module":"parse","text":"/// A token as it is written, in messages: `` `)` ``, `` `pub` ``, `` `3` ``,\n/// a string as its literal; the end of the text.\nfn tok_shown(t: lex.Tok) -> String {\n  match t {\n    lex.IntTok(v) => \"`\" + to_string(v) + \"`\",\n    lex.BigIntTok(s) => \"`\" + s + \"`\",\n    lex.FloatTok(f) => \"`\" + to_string(f) + \"`\",\n    lex.StrTok(s) => \"`\" + parse.debug_quoted(s) + \"`\",\n    lex.FStrTok(_) => \"an f-string\",\n    lex.Ident(s) => \"`\" + s + \"`\",\n    lex.HoleTok(s) => \"`?\" + s + \"`\",\n    lex.DocTok(_) => \"a doc comment (`///`)\",\n    lex.Sym(s) => \"`\" + s + \"`\",\n    lex.Eof => \"the end\",\n  }\n}","old_text":"/// A token as it is written, in messages: `` `)` ``, `` `pub` ``, `` `3` ``,\n/// a string as its literal; the end of the text.\nfn tok_shown(t: lex.Tok) -> String {\n  match t {\n    lex.IntTok(v) => \"`\" + to_string(v) + \"`\",\n    lex.BigIntTok(s) => \"`\" + s + \"`\",\n    lex.FloatTok(f) => \"`\" + to_string(f) + \"`\",\n    lex.StrTok(s) => \"`\" + parse.rust_quoted(s) + \"`\",\n    lex.FStrTok(_) => \"an f-string\",\n    lex.Ident(s) => \"`\" + s + \"`\",\n    lex.HoleTok(s) => \"`?\" + s + \"`\",\n    lex.DocTok(_) => \"a doc comment (`///`)\",\n    lex.Sym(s) => \"`\" + s + \"`\",\n    lex.Eof => \"the end\",\n  }\n}"},{"name":"parse.rust_quoted","kind":"fn","old":"d2b5ee275429cfb3","new":null,"interface_changed":true,"affected":[],"module":"parse","old_text":"/// A string as Rust's `{:?}` writes it.\nfn rust_quoted(s: String) -> String {\n  \"\\\"\"\n    + replace(replace(replace(\n      replace(replace(s, \"\\\\\", \"\\\\\\\\\"), \"\\\"\", \"\\\\\\\"\"),\n      \"\\n\",\n      \"\\\\n\",\n    ), \"\\t\", \"\\\\t\"), \"\\r\", \"\\r\")\n    + \"\\\"\"\n}"}],"renames":[{"from":"parse.rust_quoted","to":"parse.debug_quoted","kind":"function"}],"references":["parse.tok_shown"]}
{"id":"fbc4f0684f354c83","time":1795634364,"message":"rename desugar.sweet → desugar.unsugared","changes":[{"name":"desugar.unsugared","kind":"fn","old":null,"new":"13e681b3f3434961","interface_changed":true,"affected":[],"module":"desugar","text":"/// `e` without sugar, innermost first (so what is rebuilt holds none).\nfn unsugared(e: ast.Expr) -> ast.Expr {\n  match e {\n    // a slice's range stays a range until the slice is rewritten\n    ast.Index { base, index: ast.Range { lo, hi, inclusive } } => desugar.sliced(desugar.unsugared(base), match lo {\n      Some(x) => desugar.unsugared(x),\n      None => ast.IntLit(0),\n    }, match hi {\n      Some(x) => Some(desugar.unsugared(x)),\n      None => None,\n    }, inclusive),\n    // an element assigned (`xs[i] = v`): the list's place assigned a new\n    // list, before the rest is rewritten\n    ast.Block { stmts, last } => if stmts.any(s -> desugar.element_assign(s)) {\n      desugar.unsugared(ast.Block {\n        stmts: stmts.map(s -> desugar.elements_assigned(s)),\n        last,\n      })\n    } else {\n      desugar.sugar(walk.expr_children(\n        e,\n        x -> desugar.unsugared(x),\n        t -> desugar.sweet_type(t),\n      ))\n    },\n    _ => desugar.sugar(walk.expr_children(\n      e,\n      x -> desugar.unsugared(x),\n      t -> desugar.sweet_type(t),\n    )),\n  }\n}"},{"name":"desugar.sweet_type","kind":"fn","old":"d7a335684d7cc157","new":"700d58d2046ab9ff","interface_changed":false,"affected":[],"module":"desugar","text":"fn sweet_type(t: ast.TypeExpr) -> ast.TypeExpr {\n  walk.type_children(\n    t,\n    x -> desugar.unsugared(x),\n    u -> desugar.sweet_type(u),\n  )\n}","old_text":"fn sweet_type(t: ast.TypeExpr) -> ast.TypeExpr {\n  walk.type_children(\n    t,\n    x -> desugar.sweet(x),\n    u -> desugar.sweet_type(u),\n  )\n}"},{"name":"desugar.desugar_more","kind":"fn","old":"ed8b834873a21e06","new":"753a829d82bf4136","interface_changed":false,"affected":[],"module":"desugar","text":"/// `desugar` of definitions added to a program already without its sugar\n/// (`context`, not returned), each definition of the program desugared once:\n/// `new` without sugar, with the aliases made for refinements no definition\n/// of the program had yet; the errors; and the refinements given an alias so\n/// far (`texts`, then the new ones: `$where_k` is the `k`th).\npub fn desugar_more(\n  new: List[ast.Decl],\n  context: List[ast.Decl],\n  texts: List[String],\n) -> (List[ast.Decl], List[(String, String)], List[String]) {\n  mut errors := []\n  mut out := []\n  for d0 in desugar.with_models(new, context) {\n    // (an `extern python` function: the call of the Python worker)\n    d := desugar.python_lowered(d0)\n    for e in walk.decl_kids(d).1 {\n      for _ in 0..desugar.open_ranges(e) {\n        mut errors.push(\n          (\n            desugar.decl_name(d),\n            \"a range needs both ends (`a..b`), except in a slice: `xs[a..]`, `xs[..b]`\",\n          ),\n        )\n      }\n    }\n    mut out.push(\n      desugar.named_results(walk.decl_parts(\n        d,\n        x -> desugar.unsugared(x),\n        t -> desugar.sweet_type(t),\n      )),\n    )\n  }\n  (refined, all) := desugar.inline_refinements(\n    desugar.key_paths(desugar.defaults(out, context), context),\n    texts,\n  )\n  (desugar.mixed_unions(refined), errors, all)\n}","old_text":"/// `desugar` of definitions added to a program already without its sugar\n/// (`context`, not returned), each definition of the program desugared once:\n/// `new` without sugar, with the aliases made for refinements no definition\n/// of the program had yet; the errors; and the refinements given an alias so\n/// far (`texts`, then the new ones: `$where_k` is the `k`th).\npub fn desugar_more(\n  new: List[ast.Decl],\n  context: List[ast.Decl],\n  texts: List[String],\n) -> (List[ast.Decl], List[(String, String)], List[String]) {\n  mut errors := []\n  mut out := []\n  for d0 in desugar.with_models(new, context) {\n    // (an `extern python` function: the call of the Python worker)\n    d := desugar.python_lowered(d0)\n    for e in walk.decl_kids(d).1 {\n      for _ in 0..desugar.open_ranges(e) {\n        mut errors.push(\n          (\n            desugar.decl_name(d),\n            \"a range needs both ends (`a..b`), except in a slice: `xs[a..]`, `xs[..b]`\",\n          ),\n        )\n      }\n    }\n    mut out.push(\n      desugar.named_results(walk.decl_parts(\n        d,\n        x -> desugar.sweet(x),\n        t -> desugar.sweet_type(t),\n      )),\n    )\n  }\n  (refined, all) := desugar.inline_refinements(\n    desugar.key_paths(desugar.defaults(out, context), context),\n    texts,\n  )\n  (desugar.mixed_unions(refined), errors, all)\n}"},{"name":"desugar.sweet","kind":"fn","old":"1d8ec2a78c57786b","new":null,"interface_changed":true,"affected":[],"module":"desugar","old_text":"/// `e` without sugar, innermost first (so what is rebuilt holds none).\nfn sweet(e: ast.Expr) -> ast.Expr {\n  match e {\n    // a slice's range stays a range until the slice is rewritten\n    ast.Index { base, index: ast.Range { lo, hi, inclusive } } => desugar.sliced(desugar.sweet(base), match lo {\n      Some(x) => desugar.sweet(x),\n      None => ast.IntLit(0),\n    }, match hi {\n      Some(x) => Some(desugar.sweet(x)),\n      None => None,\n    }, inclusive),\n    // an element assigned (`xs[i] = v`): the list's place assigned a new\n    // list, before the rest is rewritten\n    ast.Block { stmts, last } => if stmts.any(s -> desugar.element_assign(s)) {\n      desugar.sweet(ast.Block {\n        stmts: stmts.map(s -> desugar.elements_assigned(s)),\n        last,\n      })\n    } else {\n      desugar.sugar(walk.expr_children(\n        e,\n        x -> desugar.sweet(x),\n        t -> desugar.sweet_type(t),\n      ))\n    },\n    _ => desugar.sugar(walk.expr_children(\n      e,\n      x -> desugar.sweet(x),\n      t -> desugar.sweet_type(t),\n    )),\n  }\n}"}],"renames":[{"from":"desugar.sweet","to":"desugar.unsugared","kind":"function"}],"references":["desugar.sweet_type","desugar.desugar_more"]}
