.race_expr","codegen.mock_method","codegen.call_entry","codegen.operands_want","codegen.if_want","codegen.branch_value","codegen.try_want","codegen.tag_test","codegen.compared","codegen.keep_olds","codegen.export_entry","codegen.expr_on_stack","codegen.assigned_call","codegen.built_or_generated","codegen.list_literal_of","codegen.scope_expr","codegen.channel_new","codegen.wanted","codegen.or_else","codegen.list_get_or","codegen.appended","codegen.table_find","codegen.session_entry","codegen.tag_is","codegen.gen_fn","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.satisfies","codegen.holds_pred","codegen.mock_table","codegen.mock_call","codegen.operands","codegen.if_expr","codegen.try_expr","codegen.list_literal","codegen.to_c","codegen.generated","codegen.can_generate","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.gen_data","codegen.mock_value","codegen.foreign_call","codegen.generated_args","codegen.makers","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// A channel end or a task handle: shown as `<Sender[Int]>`, compared by\n/// identity.\nfn opaque(t: check.Ty) -> Bool {\n  match t {\n    check.TNamed { name: \"Sender\", .. } | check.TNamed { name: \"Receiver\", .. } | check.TNamed { name: \"Task\", .. } => true,\n    check.TNamed { name, .. } => starts_with(name, \"extern:\"),\n    _ => false,\n  }\n}","old_text":"/// A channel end or a task handle: shown as `<Sender[Int]>`, compared by\n/// identity.\nfn opaque(t: Ty) -> Bool {\n  match t {\n    TNamed { name: \"Sender\", .. } | TNamed { name: \"Receiver\", .. } | TNamed { name: \"Task\", .. } => true,\n    TNamed { name, .. } => starts_with(name, \"extern:\"),\n    _ => false,\n  }\n}"},{"name":"codegen.number_of","kind":"fn","old":"b71049ee3d15fd3a","new":"31f5032df04dceda","interface_changed":false,"affected":[],"module":"codegen","text":"/// The number inside a `distinct` value over a number (a `Duration`, an\n/// `Instant`), or the number itself.\nfn number_of(mut g: codegen.Gen, v: codegen.V) -> codegen.V {\n  match v.ty {\n    check.TNamed { name, .. } => if contains(g.distincts, name) {\n      codegen.field(mut g, v, 0, check.TInt)\n    } else {\n      v\n    },\n    _ => v,\n  }\n}","old_text":"/// The number inside a `distinct` value over a number (a `Duration`, an\n/// `Instant`), or the number itself.\nfn number_of(mut g: codegen.Gen, v: codegen.V) -> codegen.V {\n  match v.ty {\n    TNamed { name, .. } => if contains(g.distincts, name) {\n      codegen.field(mut g, v, 0, TInt)\n    } else {\n      v\n    },\n    _ => v,\n  }\n}"},{"name":"codegen.clock_now","kind":"fn","old":"a23495aefed1f92f","new":"b4e35a64e4054f36","interface_changed":false,"affected":[],"module":"codegen","text":"/// A clock's current time (`clock.now()`) as a number.\nfn clock_now(mut g: codegen.Gen, c: codegen.V) -> codegen.V {\n  t := match c.ty {\n    check.TTrait(tr) => codegen.dyn_call(mut g, c, tr, \"now\", []),\n    _ => {\n      k := codegen.method_key(mut g, codegen.head_of(c.ty), \"now\")\n      codegen.call_fn_want(mut g, k, [c], [], check.TAny)\n    },\n  }\n  codegen.number_of(mut g, t)\n}","old_text":"/// A clock's current time (`clock.now()`) as a number.\nfn clock_now(mut g: codegen.Gen, c: codegen.V) -> codegen.V {\n  t := match c.ty {\n    TTrait(tr) => codegen.dyn_call(mut g, c, tr, \"now\", []),\n    _ => {\n      k := codegen.method_key(mut g, codegen.head_of(c.ty), \"now\")\n      codegen.call_fn_want(mut g, k, [c], [], TAny)\n    },\n  }\n  codegen.number_of(mut g, t)\n}"},{"name":"codegen.select_expr","kind":"fn","old":"4bc65547198dc1da","new":"607f5b3f9a9c8228","interface_changed":false,"affected":[],"module":"codegen","text":"/// `select { … }`: describes each arm's operation to `strata_select`, which\n/// performs the first that can happen, then runs that arm.\n/// Each operation is 32 bytes:\n/// - kind: 0 recv, 1 send, 2 await, 3 the system clock's timer, 4 another\n/// clock's, 5 a virtual clock's\n/// - the channel or task\n/// - the slot: a value sent, a deadline\n/// - whether a value came\nfn select_expr(mut g: codegen.Gen, arms: List[ast.SelectArm]) -> codegen.V {\n  n := len(arms)\n  ops := codegen.fresh(mut g, \"ops\")\n  mut g.allocas.push(f\"  {ops} = alloca [{4 * n} x i64]\")\n  // what each arm waits on. A send's value is taken: the channel, or the\n  // losing arm, drops it.\n  mut sent := []\n  mut targets := []\n  // another clock's timers: (arm, clock, deadline)\n  mut clocks := []\n  for (i, a) in enumerate(arms) {\n    mut kind := 0\n    mut target := codegen.V { ty: check.TUnit, op: \"null\" }\n    mut value := codegen.unit()\n    mut sends := false\n    match a.op {\n      ast.MethodCall { recv, args: [], .. } => {\n        target = codegen.expr(mut g, recv)\n      },\n      // `clock.after(d)`: a timer `d` after now in that clock's time\n      ast.MethodCall { recv: c, name: \"after\", args: [d] } => {\n        cv := codegen.expr(mut g, c)\n        d0 := codegen.expr(mut g, d)\n        dv := codegen.number_of(mut g, d0)\n        p := codegen.fresh(mut g, \"op\")\n        codegen.emit(\n          mut g,\n          f\"{p} = getelementptr i64, ptr {ops}, i64 {4 * i + 2}\",\n        )\n        deadline := codegen.fresh(mut g, \"deadline\")\n        match cv.ty {\n          check.TNamed { name: \"std.time.VirtualClock\", .. } => {\n            // the run's virtual time: advancing it wakes the select\n            codegen.use_rt(mut g, \"strata_virtual_timeline\")\n            codegen.use_rt(mut g, \"strata_virtual_now\")\n            (tl, now) := (\n              codegen.fresh(mut g, \"vtime\"),\n              codegen.fresh(mut g, \"now\"),\n            )\n            codegen.emit(\n              mut g,\n              f\"{tl} = call ptr @strata_virtual_timeline()\",\n            )\n            codegen.emit(\n              mut g,\n              f\"{now} = call i64 @strata_virtual_now()\",\n            )\n            codegen.emit(\n              mut g,\n              f\"{deadline} = add i64 {now}, {dv.op}\",\n            )\n            codegen.emit(mut g, f\"store i64 {deadline}, ptr {p}\")\n            kind = 5\n            target = codegen.V { ty: check.TStr, op: tl }\n          },\n          check.TNamed { name: \"std.time.SystemClock\", .. } => {\n            codegen.use_rt(mut g, \"strata_host_now\")\n            now := codegen.fresh(mut g, \"now\")\n            codegen.emit(\n              mut g,\n              f\"{now} = call i64 @strata_host_now()\",\n            )\n            codegen.emit(\n              mut g,\n              f\"{deadline} = add i64 {now}, {dv.op}\",\n            )\n            codegen.emit(mut g, f\"store i64 {deadline}, ptr {p}\")\n            kind = 3\n          },\n          _ => {\n            t0 := codegen.clock_now(mut g, cv)\n            codegen.emit(\n              mut g,\n              f\"{deadline} = add i64 {t0.op}, {dv.op}\",\n            )\n            codegen.emit(mut g, f\"store i64 0, ptr {p}\")\n            mut clocks.push((i, cv, deadline))\n            kind = 4\n          },\n        }\n      },\n      ast.MethodCall { recv: s, args: [x], .. } => {\n        tx := codegen.expr(mut g, s)\n        et := codegen.end_elem(tx.ty)\n        v0 := codegen.expr_want(mut g, x, et)\n        v1 := codegen.as_type(mut g, v0, et)\n        value = codegen.take_value(\n          mut g,\n          codegen.V { ..v1, ty: codegen.better(et, v1.ty) },\n        )\n        codegen.share_value(mut g, value)\n        sends = true\n        kind = 1\n        target = tx\n      },\n      ast.Await(h) => {\n        target = codegen.expr(mut g, h)\n        kind = 2\n      },\n      _ => {\n        codegen.not_yet(\n          mut g,\n          \"a `select` arm that isn't `recv`, `send`, `await` or a timer\",\n        )\n        return codegen.never()\n      },\n    }\n    p := codegen.fresh(mut g, \"op\")\n    codegen.emit(\n      mut g,\n      f\"{p} = getelementptr i64, ptr {ops}, i64 {4 * i}\",\n    )\n    codegen.emit(mut g, f\"store i64 {kind}, ptr {p}\")\n    q := codegen.fresh(mut g, \"op\")\n    codegen.emit(\n      mut g,\n      f\"{q} = getelementptr i64, ptr {ops}, i64 {4 * i + 1}\",\n    )\n    codegen.emit(mut g, f\"store ptr {target.op}, ptr {q}\")\n    if sends {\n      s := codegen.to_slot(mut g, value)\n      r := codegen.fresh(mut g, \"op\")\n      codegen.emit(\n        mut g,\n        f\"{r} = getelementptr i64, ptr {ops}, i64 {4 * i + 2}\",\n      )\n      codegen.emit(mut g, f\"store i64 {s}, ptr {r}\")\n    }\n    mut sent.push((sends, value))\n    mut targets.push(target)\n  }\n  // another clock's timers: ask its time, then poll, again while\n  // `strata_select` gives -2\n  poll := codegen.label(mut g, \"sel.poll\")\n  if len(clocks) > 0 {\n    codegen.br(mut g, poll)\n    codegen.block(mut g, poll)\n    codegen.push_scope(mut g)\n    for (i, cv, deadline) in clocks {\n      now := codegen.clock_now(mut g, cv)\n      (ready, flag, p) := (\n        codegen.fresh(mut g, \"ready\"),\n        codegen.fresh(mut g, \"flag\"),\n        codegen.fresh(mut g, \"op\"),\n      )\n      codegen.emit(\n        mut g,\n        f\"{ready} = icmp sge i64 {now.op}, {deadline}\",\n      )\n      codegen.emit(mut g, f\"{flag} = zext i1 {ready} to i64\")\n      codegen.emit(\n        mut g,\n        f\"{p} = getelementptr i64, ptr {ops}, i64 {4 * i + 2}\",\n      )\n      codegen.emit(mut g, f\"store i64 {flag}, ptr {p}\")\n    }\n    codegen.pop_scope(mut g)\n  }\n  codegen.use_rt(mut g, \"strata_select\")\n  k := codegen.fresh(mut g, \"chosen\")\n  codegen.emit(\n    mut g,\n    f\"{k} = call i64 @strata_select(ptr {ops}, i64 {n})\",\n  )\n  if len(clocks) > 0 {\n    (again, go) := (codegen.fresh(mut g, \"again\"), codegen.label(mut g, \"sel.go\"))\n    codegen.emit(mut g, f\"{again} = icmp eq i64 {k}, -2\")\n    codegen.emit(\n      mut g,\n      f\"br i1 {again}, label %{poll}, label %{go}\",\n    )\n    codegen.block(mut g, go)\n  }\n  mut labels := []\n  for _ in arms {\n    mut labels.push(codegen.label(mut g, \"sel.arm\"))\n  }\n  (none, end) := (\n    codegen.label(mut g, \"sel.none\"),\n    codegen.label(mut g, \"sel.end\"),\n  )\n  cases := join(enumerate(labels).map(x -> f\"i64 {x.0}, label %{x.1}\"), \" \")\n  codegen.emit(mut g, f\"switch i64 {k}, label %{none} [ {cases} ]\")\n  mut incoming := []\n  for (i, a) in enumerate(arms) {\n    codegen.block(mut g, get(labels, i) ?? \"\")\n    codegen.push_scope(mut g)\n    // the values the other arms would have sent\n    for (j, s) in enumerate(sent) {\n      if s.0 && j != i {\n        codegen.drop_value(mut g, s.1)\n      }\n    }\n    target := get(targets, i) ?? codegen.unit()\n    got := match a.op {\n      ast.MethodCall { args: [], .. } => {\n        (okp, okw, ok, slot) := (\n          codegen.fresh(mut g, \"okp\"),\n          codegen.fresh(mut g, \"okw\"),\n          codegen.fresh(mut g, \"ok\"),\n          codegen.fresh(mut g, \"slotp\"),\n        )\n        codegen.emit(\n          mut g,\n          f\"{okp} = getelementptr i64, ptr {ops}, i64 {4 * i + 3}\",\n        )\n        codegen.emit(mut g, f\"{okw} = load i64, ptr {okp}\")\n        codegen.emit(mut g, f\"{ok} = icmp ne i64 {okw}, 0\")\n        codegen.emit(\n          mut g,\n          f\"{slot} = getelementptr i64, ptr {ops}, i64 {4 * i + 2}\",\n        )\n        codegen.option_from(\n          mut g,\n          ok,\n          slot,\n          codegen.end_elem(target.ty),\n        )\n      },\n      ast.Await(_) => match target.ty {\n        check.TNamed { name: \"Task\", args: [rt] } => codegen.await_one(mut g, target, rt),\n        _ => codegen.never(),\n      },\n      _ => codegen.unit(),\n    }\n    match a.name {\n      Some(x) => if !(got.ty is check.TUnit) {\n        codegen.local_owned(mut g, x, got)\n      },\n      None => (),\n    }\n    v0 := codegen.expr(mut g, a.body)\n    v := codegen.leave_branch(mut g, v0)\n    from := codegen.current(g)\n    codegen.br(mut g, end)\n    mut incoming.push((v, from))\n  }\n  // -1: this task was cancelled while it waited\n  codegen.block(mut g, none)\n  codegen.unwind_here(mut g)\n  codegen.block(mut g, end)\n  r := codegen.join_values(mut g, incoming)\n  codegen.temp(mut g, r)\n}","old_text":"/// `select { … }`: describes each arm's operation to `strata_select`, which\n/// performs the first that can happen, then runs that arm.\n/// Each operation is 32 bytes:\n/// - kind: 0 recv, 1 send, 2 await, 3 the system clock's timer, 4 another\n/// clock's, 5 a virtual clock's\n/// - the channel or task\n/// - the slot: a value sent, a deadline\n/// - whether a value came\nfn select_expr(mut g: codegen.Gen, arms: List[ast.SelectArm]) -> codegen.V {\n  n := len(arms)\n  ops := codegen.fresh(mut g, \"ops\")\n  mut g.allocas.push(f\"  {ops} = alloca [{4 * n} x i64]\")\n  // what each arm waits on. A send's value is taken: the channel, or the\n  // losing arm, drops it.\n  mut sent := []\n  mut targets := []\n  // another clock's timers: (arm, clock, deadline)\n  mut clocks := []\n  for (i, a) in enumerate(arms) {\n    mut kind := 0\n    mut target := codegen.V { ty: TUnit, op: \"null\" }\n    mut value := codegen.unit()\n    mut sends := false\n    match a.op {\n      ast.MethodCall { recv, args: [], .. } => {\n        target = codegen.expr(mut g, recv)\n      },\n      // `clock.after(d)`: a timer `d` after now in that clock's time\n      ast.MethodCall { recv: c, name: \"after\", args: [d] } => {\n        cv := codegen.expr(mut g, c)\n        d0 := codegen.expr(mut g, d)\n        dv := codegen.number_of(mut g, d0)\n        p := codegen.fresh(mut g, \"op\")\n        codegen.emit(\n          mut g,\n          f\"{p} = getelementptr i64, ptr {ops}, i64 {4 * i + 2}\",\n        )\n        deadline := codegen.fresh(mut g, \"deadline\")\n        match cv.ty {\n          TNamed { name: \"std.time.VirtualClock\", .. } => {\n            // the run's virtual time: advancing it wakes the select\n            codegen.use_rt(mut g, \"strata_virtual_timeline\")\n            codegen.use_rt(mut g, \"strata_virtual_now\")\n            (tl, now) := (\n              codegen.fresh(mut g, \"vtime\"),\n              codegen.fresh(mut g, \"now\"),\n            )\n            codegen.emit(\n              mut g,\n              f\"{tl} = call ptr @strata_virtual_timeline()\",\n            )\n            codegen.emit(\n              mut g,\n              f\"{now} = call i64 @strata_virtual_now()\",\n            )\n            codegen.emit(\n              mut g,\n              f\"{deadline} = add i64 {now}, {dv.op}\",\n            )\n            codegen.emit(mut g, f\"store i64 {deadline}, ptr {p}\")\n            kind = 5\n            target = codegen.V { ty: TStr, op: tl }\n          },\n          TNamed { name: \"std.time.SystemClock\", .. } => {\n            codegen.use_rt(mut g, \"strata_host_now\")\n            now := codegen.fresh(mut g, \"now\")\n            codegen.emit(\n              mut g,\n              f\"{now} = call i64 @strata_host_now()\",\n            )\n            codegen.emit(\n              mut g,\n              f\"{deadline} = add i64 {now}, {dv.op}\",\n            )\n            codegen.emit(mut g, f\"store i64 {deadline}, ptr {p}\")\n            kind = 3\n          },\n          _ => {\n            t0 := codegen.clock_now(mut g, cv)\n            codegen.emit(\n              mut g,\n              f\"{deadline} = add i64 {t0.op}, {dv.op}\",\n            )\n            codegen.emit(mut g, f\"store i64 0, ptr {p}\")\n            mut clocks.push((i, cv, deadline))\n            kind = 4\n          },\n        }\n      },\n      ast.MethodCall { recv: s, args: [x], .. } => {\n        tx := codegen.expr(mut g, s)\n        et := codegen.end_elem(tx.ty)\n        v0 := codegen.expr_want(mut g, x, et)\n        v1 := codegen.as_type(mut g, v0, et)\n        value = codegen.take_value(\n          mut g,\n          codegen.V { ..v1, ty: codegen.better(et, v1.ty) },\n        )\n        codegen.share_value(mut g, value)\n        sends = true\n        kind = 1\n        target = tx\n      },\n      ast.Await(h) => {\n        target = codegen.expr(mut g, h)\n        kind = 2\n      },\n      _ => {\n        codegen.not_yet(\n          mut g,\n          \"a `select` arm that isn't `recv`, `send`, `await` or a timer\",\n        )\n        return codegen.never()\n      },\n    }\n    p := codegen.fresh(mut g, \"op\")\n    codegen.emit(\n      mut g,\n      f\"{p} = getelementptr i64, ptr {ops}, i64 {4 * i}\",\n    )\n    codegen.emit(mut g, f\"store i64 {kind}, ptr {p}\")\n    q := codegen.fresh(mut g, \"op\")\n    codegen.emit(\n      mut g,\n      f\"{q} = getelementptr i64, ptr {ops}, i64 {4 * i + 1}\",\n    )\n    codegen.emit(mut g, f\"store ptr {target.op}, ptr {q}\")\n    if sends {\n      s := codegen.to_slot(mut g, value)\n      r := codegen.fresh(mut g, \"op\")\n      codegen.emit(\n        mut g,\n        f\"{r} = getelementptr i64, ptr {ops}, i64 {4 * i + 2}\",\n      )\n      codegen.emit(mut g, f\"store i64 {s}, ptr {r}\")\n    }\n    mut sent.push((sends, value))\n    mut targets.push(target)\n  }\n  // another clock's timers: ask its time, then poll, again while\n  // `strata_select` gives -2\n  poll := codegen.label(mut g, \"sel.poll\")\n  if len(clocks) > 0 {\n    codegen.br(mut g, poll)\n    codegen.block(mut g, poll)\n    codegen.push_scope(mut g)\n    for (i, cv, deadline) in clocks {\n      now := codegen.clock_now(mut g, cv)\n      (ready, flag, p) := (\n        codegen.fresh(mut g, \"ready\"),\n        codegen.fresh(mut g, \"flag\"),\n        codegen.fresh(mut g, \"op\"),\n      )\n      codegen.emit(\n        mut g,\n        f\"{ready} = icmp sge i64 {now.op}, {deadline}\",\n      )\n      codegen.emit(mut g, f\"{flag} = zext i1 {ready} to i64\")\n      codegen.emit(\n        mut g,\n        f\"{p} = getelementptr i64, ptr {ops}, i64 {4 * i + 2}\",\n      )\n      codegen.emit(mut g, f\"store i64 {flag}, ptr {p}\")\n    }\n    codegen.pop_scope(mut g)\n  }\n  codegen.use_rt(mut g, \"strata_select\")\n  k := codegen.fresh(mut g, \"chosen\")\n  codegen.emit(\n    mut g,\n    f\"{k} = call i64 @strata_select(ptr {ops}, i64 {n})\",\n  )\n  if len(clocks) > 0 {\n    (again, go) := (codegen.fresh(mut g, \"again\"), codegen.label(mut g, \"sel.go\"))\n    codegen.emit(mut g, f\"{again} = icmp eq i64 {k}, -2\")\n    codegen.emit(\n      mut g,\n      f\"br i1 {again}, label %{poll}, label %{go}\",\n    )\n    codegen.block(mut g, go)\n  }\n  mut labels := []\n  for _ in arms {\n    mut labels.push(codegen.label(mut g, \"sel.arm\"))\n  }\n  (none, end) := (\n    codegen.label(mut g, \"sel.none\"),\n    codegen.label(mut g, \"sel.end\"),\n  )\n  cases := join(enumerate(labels).map(x -> f\"i64 {x.0}, label %{x.1}\"), \" \")\n  codegen.emit(mut g, f\"switch i64 {k}, label %{none} [ {cases} ]\")\n  mut incoming := []\n  for (i, a) in enumerate(arms) {\n    codegen.block(mut g, get(labels, i) ?? \"\")\n    codegen.push_scope(mut g)\n    // the values the other arms would have sent\n    for (j, s) in enumerate(sent) {\n      if s.0 && j != i {\n        codegen.drop_value(mut g, s.1)\n      }\n    }\n    target := get(targets, i) ?? codegen.unit()\n    got := match a.op {\n      ast.MethodCall { args: [], .. } => {\n        (okp, okw, ok, slot) := (\n          codegen.fresh(mut g, \"okp\"),\n          codegen.fresh(mut g, \"okw\"),\n          codegen.fresh(mut g, \"ok\"),\n          codegen.fresh(mut g, \"slotp\"),\n        )\n        codegen.emit(\n          mut g,\n          f\"{okp} = getelementptr i64, ptr {ops}, i64 {4 * i + 3}\",\n        )\n        codegen.emit(mut g, f\"{okw} = load i64, ptr {okp}\")\n        codegen.emit(mut g, f\"{ok} = icmp ne i64 {okw}, 0\")\n        codegen.emit(\n          mut g,\n          f\"{slot} = getelementptr i64, ptr {ops}, i64 {4 * i + 2}\",\n        )\n        codegen.option_from(\n          mut g,\n          ok,\n          slot,\n          codegen.end_elem(target.ty),\n        )\n      },\n      ast.Await(_) => match target.ty {\n        TNamed { name: \"Task\", args: [rt] } => codegen.await_one(mut g, target, rt),\n        _ => codegen.never(),\n      },\n      _ => codegen.unit(),\n    }\n    match a.name {\n      Some(x) => if !(got.ty is TUnit) {\n        codegen.local_owned(mut g, x, got)\n      },\n      None => (),\n    }\n    v0 := codegen.expr(mut g, a.body)\n    v := codegen.leave_branch(mut g, v0)\n    from := codegen.current(g)\n    codegen.br(mut g, end)\n    mut incoming.push((v, from))\n  }\n  // -1: this task was cancelled while it waited\n  codegen.block(mut g, none)\n  codegen.unwind_here(mut g)\n  codegen.block(mut g, end)\n  r := codegen.join_values(mut g, incoming)\n  codegen.temp(mut g, r)\n}"},{"name":"codegen.race_expr","kind":"fn","old":"a677981f4958a0ea","new":"b760b74be3a83618","interface_changed":false,"affected":[],"module":"codegen","text":"/// `race { e as x => body, … }`:\n/// - each `e` starts as a task of the race's own scope\n/// - `strata_select` waits for the first to finish\n/// - the others are cancelled and stop at their next wait\n/// - the winner's result moves out of its task, and the scope ends after\n/// the others stop\n/// - the winner's arm runs\nfn race_expr(mut g: codegen.Gen, arms: List[ast.SelectArm]) -> codegen.V {\n  n := len(arms)\n  codegen.use_rt(mut g, \"strata_scope_begin\")\n  codegen.use_rt(mut g, \"strata_scope_end\")\n  codegen.use_rt(mut g, \"strata_scope_cancel\")\n  codegen.use_rt(mut g, \"strata_select\")\n  tasks := codegen.fresh(mut g, \"tasks\")\n  codegen.emit(mut g, f\"{tasks} = call ptr @strata_scope_begin()\")\n  codegen.push_scope(mut g)\n  kk := len(g.scopes) - 1\n  sc := get(g.scopes, kk) ?? codegen.no_scope()\n  codegen.set_scope(mut g, kk, codegen.Scope { ..sc, tasks })\n  ops := codegen.fresh(mut g, \"ops\")\n  mut g.allocas.push(f\"  {ops} = alloca [{4 * n} x i64]\")\n  mut handles := []\n  for (i, a) in enumerate(arms) {\n    h := match a.op {\n      ast.SupervisedSpawn(x) => codegen.spawn_expr(mut g, x, true),\n      op => codegen.spawn_expr(mut g, op, false),\n    }\n    (p, q) := (codegen.fresh(mut g, \"op\"), codegen.fresh(mut g, \"op\"))\n    codegen.emit(\n      mut g,\n      f\"{p} = getelementptr i64, ptr {ops}, i64 {4 * i}\",\n    )\n    codegen.emit(mut g, f\"store i64 2, ptr {p}\")\n    codegen.emit(\n      mut g,\n      f\"{q} = getelementptr i64, ptr {ops}, i64 {4 * i + 1}\",\n    )\n    codegen.emit(mut g, f\"store ptr {h.op}, ptr {q}\")\n    mut handles.push(h)\n  }\n  rts := handles.map(\n    h -> match h.ty {\n      check.TNamed { name: \"Task\", args: [rt] } => rt,\n      _ => check.TAny,\n    },\n  )\n  mut slots := []\n  for rt in rts {\n    mut slots.push(\n      if codegen.has_value(rt) {\n        s := codegen.fresh(mut g, \"won\")\n        mut g.allocas.push(f\"  {s} = alloca {codegen.ll(rt)}\")\n        s\n      } else {\n        \"\"\n      },\n    )\n  }\n  k := codegen.fresh(mut g, \"winner\")\n  codegen.emit(\n    mut g,\n    f\"{k} = call i64 @strata_select(ptr {ops}, i64 {n})\",\n  )\n  codegen.emit(\n    mut g,\n    f\"call void @strata_scope_cancel(ptr {tasks})\",\n  )\n  // the winner's result, held here. Its task keeps its own until the scope\n  // ends.\n  mut won := []\n  for _ in arms {\n    mut won.push(codegen.label(mut g, \"race.won\"))\n  }\n  (none, got) := (\n    codegen.label(mut g, \"race.none\"),\n    codegen.label(mut g, \"race.got\"),\n  )\n  cases := join(enumerate(won).map(x -> f\"i64 {x.0}, label %{x.1}\"), \" \")\n  codegen.emit(mut g, f\"switch i64 {k}, label %{none} [ {cases} ]\")\n  for (i, h) in enumerate(handles) {\n    codegen.block(mut g, get(won, i) ?? \"\")\n    slot := get(slots, i) ?? \"\"\n    if slot != \"\" {\n      rt := get(rts, i) ?? check.TAny\n      codegen.push_scope(mut g)\n      v := codegen.await_one(mut g, h, rt)\n      x := codegen.take_value(mut g, v)\n      codegen.emit(\n        mut g,\n        f\"store {codegen.ll(rt)} {x.op}, ptr {slot}\",\n      )\n      codegen.pop_scope(mut g)\n    }\n    codegen.br(mut g, got)\n  }\n  // -1: the race itself was cancelled while it waited\n  codegen.block(mut g, none)\n  codegen.unwind_here(mut g)\n  codegen.block(mut g, got)\n  codegen.pop_scope(mut g)\n  // the winner's arm, with its result\n  mut labels := []\n  for _ in arms {\n    mut labels.push(codegen.label(mut g, \"race.arm\"))\n  }\n  (none2, end) := (\n    codegen.label(mut g, \"race.none\"),\n    codegen.label(mut g, \"race.end\"),\n  )\n  cases2 := join(enumerate(labels).map(x -> f\"i64 {x.0}, label %{x.1}\"), \" \")\n  codegen.emit(\n    mut g,\n    f\"switch i64 {k}, label %{none2} [ {cases2} ]\",\n  )\n  mut incoming := []\n  for (i, a) in enumerate(arms) {\n    codegen.block(mut g, get(labels, i) ?? \"\")\n    codegen.push_scope(mut g)\n    rt := get(rts, i) ?? check.TAny\n    slot := get(slots, i) ?? \"\"\n    result := if slot != \"\" {\n      r := codegen.fresh(mut g, \"result\")\n      codegen.emit(\n        mut g,\n        f\"{r} = load {codegen.ll(rt)}, ptr {slot}\",\n      )\n      codegen.temp(mut g, codegen.V { ty: rt, op: r })\n    } else {\n      codegen.V { ty: rt, op: \"\" }\n    }\n    match a.name {\n      Some(x) => codegen.local_owned(mut g, x, result),\n      None => (),\n    }\n    v0 := codegen.expr(mut g, a.body)\n    v := codegen.leave_branch(mut g, v0)\n    from := codegen.current(g)\n    codegen.br(mut g, end)\n    mut incoming.push((v, from))\n  }\n  codegen.block(mut g, none2)\n  codegen.emit(mut g, \"unreachable\")\n  codegen.block(mut g, end)\n  r := codegen.join_values(mut g, incoming)\n  codegen.temp(mut g, r)\n}","old_text":"/// `race { e as x => body, … }`:\n/// - each `e` starts as a task of the race's own scope\n/// - `strata_select` waits for the first to finish\n/// - the others are cancelled and stop at their next wait\n/// - the winner's result moves out of its task, and the scope ends after\n/// the others stop\n/// - the winner's arm runs\nfn race_expr(mut g: codegen.Gen, arms: List[ast.SelectArm]) -> codegen.V {\n  n := len(arms)\n  codegen.use_rt(mut g, \"strata_scope_begin\")\n  codegen.use_rt(mut g, \"strata_scope_end\")\n  codegen.use_rt(mut g, \"strata_scope_cancel\")\n  codegen.use_rt(mut g, \"strata_select\")\n  tasks := codegen.fresh(mut g, \"tasks\")\n  codegen.emit(mut g, f\"{tasks} = call ptr @strata_scope_begin()\")\n  codegen.push_scope(mut g)\n  kk := len(g.scopes) - 1\n  sc := get(g.scopes, kk) ?? codegen.no_scope()\n  codegen.set_scope(mut g, kk, codegen.Scope { ..sc, tasks })\n  ops := codegen.fresh(mut g, \"ops\")\n  mut g.allocas.push(f\"  {ops} = alloca [{4 * n} x i64]\")\n  mut handles := []\n  for (i, a) in enumerate(arms) {\n    h := match a.op {\n      ast.SupervisedSpawn(x) => codegen.spawn_expr(mut g, x, true),\n      op => codegen.spawn_expr(mut g, op, false),\n    }\n    (p, q) := (codegen.fresh(mut g, \"op\"), codegen.fresh(mut g, \"op\"))\n    codegen.emit(\n      mut g,\n      f\"{p} = getelementptr i64, ptr {ops}, i64 {4 * i}\",\n    )\n    codegen.emit(mut g, f\"store i64 2, ptr {p}\")\n    codegen.emit(\n      mut g,\n      f\"{q} = getelementptr i64, ptr {ops}, i64 {4 * i + 1}\",\n    )\n    codegen.emit(mut g, f\"store ptr {h.op}, ptr {q}\")\n    mut handles.push(h)\n  }\n  rts := handles.map(\n    h -> match h.ty {\n      TNamed { name: \"Task\", args: [rt] } => rt,\n      _ => TAny,\n    },\n  )\n  mut slots := []\n  for rt in rts {\n    mut slots.push(\n      if codegen.has_value(rt) {\n        s := codegen.fresh(mut g, \"won\")\n        mut g.allocas.push(f\"  {s} = alloca {codegen.ll(rt)}\")\n        s\n      } else {\n        \"\"\n      },\n    )\n  }\n  k := codegen.fresh(mut g, \"winner\")\n  codegen.emit(\n    mut g,\n    f\"{k} = call i64 @strata_select(ptr {ops}, i64 {n})\",\n  )\n  codegen.emit(\n    mut g,\n    f\"call void @strata_scope_cancel(ptr {tasks})\",\n  )\n  // the winner's result, held here. Its task keeps its own until the scope\n  // ends.\n  mut won := []\n  for _ in arms {\n    mut won.push(codegen.label(mut g, \"race.won\"))\n  }\n  (none, got) := (\n    codegen.label(mut g, \"race.none\"),\n    codegen.label(mut g, \"race.got\"),\n  )\n  cases := join(enumerate(won).map(x -> f\"i64 {x.0}, label %{x.1}\"), \" \")\n  codegen.emit(mut g, f\"switch i64 {k}, label %{none} [ {cases} ]\")\n  for (i, h) in enumerate(handles) {\n    codegen.block(mut g, get(won, i) ?? \"\")\n    slot := get(slots, i) ?? \"\"\n    if slot != \"\" {\n      rt := get(rts, i) ?? TAny\n      codegen.push_scope(mut g)\n      v := codegen.await_one(mut g, h, rt)\n      x := codegen.take_value(mut g, v)\n      codegen.emit(\n        mut g,\n        f\"store {codegen.ll(rt)} {x.op}, ptr {slot}\",\n      )\n      codegen.pop_scope(mut g)\n    }\n    codegen.br(mut g, got)\n  }\n  // -1: the race itself was cancelled while it waited\n  codegen.block(mut g, none)\n  codegen.unwind_here(mut g)\n  codegen.block(mut g, got)\n  codegen.pop_scope(mut g)\n  // the winner's arm, with its result\n  mut labels := []\n  for _ in arms {\n    mut labels.push(codegen.label(mut g, \"race.arm\"))\n  }\n  (none2, end) := (\n    codegen.label(mut g, \"race.none\"),\n    codegen.label(mut g, \"race.end\"),\n  )\n  cases2 := join(enumerate(labels).map(x -> f\"i64 {x.0}, label %{x.1}\"), \" \")\n  codegen.emit(\n    mut g,\n    f\"switch i64 {k}, label %{none2} [ {cases2} ]\",\n  )\n  mut incoming := []\n  for (i, a) in enumerate(arms) {\n    codegen.block(mut g, get(labels, i) ?? \"\")\n    codegen.push_scope(mut g)\n    rt := get(rts, i) ?? TAny\n    slot := get(slots, i) ?? \"\"\n    result := if slot != \"\" {\n      r := codegen.fresh(mut g, \"result\")\n      codegen.emit(\n        mut g,\n        f\"{r} = load {codegen.ll(rt)}, ptr {slot}\",\n      )\n      codegen.temp(mut g, codegen.V { ty: rt, op: r })\n    } else {\n      codegen.V { ty: rt, op: \"\" }\n    }\n    match a.name {\n      Some(x) => codegen.local_owned(mut g, x, result),\n      None => (),\n    }\n    v0 := codegen.expr(mut g, a.body)\n    v := codegen.leave_branch(mut g, v0)\n    from := codegen.current(g)\n    codegen.br(mut g, end)\n    mut incoming.push((v, from))\n  }\n  codegen.block(mut g, none2)\n  codegen.emit(mut g, \"unreachable\")\n  codegen.block(mut g, end)\n  r := codegen.join_values(mut g, incoming)\n  codegen.temp(mut g, r)\n}"},{"name":"codegen.retype","kind":"fn","old":"ce27c8cd4e191dd9","new":"fc8211cc2df5f0e5","interface_changed":true,"affected":["codegen.stmt_node","codegen.stmt","codegen.block_expr","codegen.iterate","codegen.decreases_start","codegen.decreases_pass","codegen.decreases_entry","codegen.decreases_call","codegen.build_fn","codegen.expr_node","codegen.expr_want_node","codegen.for_list","codegen.function","codegen.call_fn_want","codegen.built_or_generated","codegen.expr","codegen.expr_want","codegen.for_loop","codegen.compiled_alone","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.fuzz_driver","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.