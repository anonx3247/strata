file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.generated_args","codegen.makers","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// The written type arguments of a call of `k` (`f` its declaration): the\n/// pending ones (`impl_written`), those its result gives when the caller\n/// returns it (`read(text)` for a `Result[List[Port], String]`), and for\n/// another method of the same type's `impl`s, the caller's own.\nfn written_args(\n  g: codegen.Gen,\n  k: String,\n  f: ast.FnDecl,\n  want: check.Ty,\n  pending: Dict[String, check.Ty],\n) -> Dict[String, check.Ty] {\n  mut out := pending\n  if len(f.type_params) == 0 {\n    return Dict[String, check.Ty] {}\n  }\n  if codegen.key(want) == codegen.key(g.ret)\n    && codegen.has_refined(g, g.ret_w) {\n    mut gen := Dict[String, check.Ty] {}\n    for p in f.type_params {\n      mut gen.insert(p, check.TGen(p))\n    }\n    pat := codegen.written_ty(f.ret, gen, g)\n    for (p, w) in codegen.bind_gen(pat, g.ret_w, Dict[String, check.Ty] {}) {\n      if codegen.has_refined(g, w) && !contains(out, p) {\n        mut out.insert(p, w)\n      }\n    }\n  }\n  // `List.from_json` calling `List.from_json_at`: the same `T`\n  hk := get(split(k, \".\"), 0) ?? k\n  hc := get(split(g.current, \".\"), 0) ?? g.current\n  if hk == hc {\n    for p in f.type_params + [\"$self\"] {\n      match get(g.sub, \"$w:\" + p) {\n        Some(w) => if !contains(out, p) {\n          mut out.insert(p, w)\n        },\n        None => (),\n      }\n    }\n  }\n  mut kept := Dict[String, check.Ty] {}\n  for (p, w) in out {\n    if f.type_params.contains(p) || p == \"$self\" {\n      mut kept.insert(p, w)\n    }\n  }\n  kept\n}","old_text":"/// The written type arguments of a call of `k` (`f` its declaration): the\n/// pending ones (`impl_written`), those its result gives when the caller\n/// returns it (`read(text)` for a `Result[List[Port], String]`), and for\n/// another method of the same type's `impl`s, the caller's own.\nfn written_args(\n  g: codegen.Gen,\n  k: String,\n  f: ast.FnDecl,\n  want: Ty,\n  pending: Dict[String, Ty],\n) -> Dict[String, Ty] {\n  mut out := pending\n  if len(f.type_params) == 0 {\n    return Dict[String, Ty] {}\n  }\n  if codegen.key(want) == codegen.key(g.ret)\n    && codegen.has_refined(g, g.ret_w) {\n    mut gen := Dict[String, Ty] {}\n    for p in f.type_params {\n      mut gen.insert(p, TGen(p))\n    }\n    pat := codegen.written_ty(f.ret, gen, g)\n    for (p, w) in codegen.bind_gen(pat, g.ret_w, Dict[String, Ty] {}) {\n      if codegen.has_refined(g, w) && !contains(out, p) {\n        mut out.insert(p, w)\n      }\n    }\n  }\n  // `List.from_json` calling `List.from_json_at`: the same `T`\n  hk := get(split(k, \".\"), 0) ?? k\n  hc := get(split(g.current, \".\"), 0) ?? g.current\n  if hk == hc {\n    for p in f.type_params + [\"$self\"] {\n      match get(g.sub, \"$w:\" + p) {\n        Some(w) => if !contains(out, p) {\n          mut out.insert(p, w)\n        },\n        None => (),\n      }\n    }\n  }\n  mut kept := Dict[String, Ty] {}\n  for (p, w) in out {\n    if f.type_params.contains(p) || p == \"$self\" {\n      mut kept.insert(p, w)\n    }\n  }\n  kept\n}"},{"name":"codegen.impl_written","kind":"fn","old":"0dabf438fef49d7e","new":"dcaaeee24d5d3fe2","interface_changed":true,"affected":["codegen.method_call","codegen.expr_node","codegen.expr_want_node","codegen.expr","codegen.expr_want","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.try_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.compared","codegen.stmt_node","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.function","codegen.declare","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.fuzz_driver","codegen.wanted","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.binds","codegen.matching_v","codegen.assertion","codegen.invariants","codegen.tag_is","codegen.check_type","codegen.satisfies","codegen.holds_pred","codegen.entry","codegen.vtable","codegen.mock_table","codegen.mock_call","codegen.list_builtin","codegen.collection_builtin","codegen.produce","codegen.table_find","codegen.generate","codegen.construct","codegen.operands","codegen.if_expr","codegen.matching","codegen.try_expr","codegen.stmt","codegen.built_or_generated","codegen.