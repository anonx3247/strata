of its sum (`args`:\n/// the sum's type arguments, as `TNamed`'s).\n/// - `TAny`: a type the checker doesn't model. It fits anything, so it\n/// hides errors and never invents them.\npub type Ty =\n  | TInt\n  | TFloat\n  | TBool\n  | TStr\n  | TUnit\n  | TList(check.Ty)\n  | TFn { params: List[check.Ty], ret: check.Ty }\n  | TNamed { name: String, args: List[check.Ty] }\n  | TGen(String)\n  | TVariants { owner: String, names: List[String], args: List[check.Ty] = [] }\n  | TUnion(List[check.Ty])\n  | TTrait(String)\n  | TVar(Int)\n  | TAny","old_text":"/// A type as the checker infers it.\n/// - `TNamed`: one of the program's record or sum types, `Option` or\n/// `Result`.\n/// - `TGen`: a type parameter of the function being checked.\n/// - `TVariants`: a variable narrowed to some variants of its sum.\n/// - `TAny`: a type the checker doesn't model. It fits anything, so it\n/// hides errors and never invents them.\npub type Ty =\n  | TInt\n  | TFloat\n  | TBool\n  | TStr\n  | TUnit\n  | TList(check.Ty)\n  | TFn { params: List[check.Ty], ret: check.Ty }\n  | TNamed { name: String, args: List[check.Ty] }\n  | TGen(String)\n  | TVariants { owner: String, names: List[String] }\n  | TUnion(List[check.Ty])\n  | TTrait(String)\n  | TVar(Int)\n  | TAny"},{"name":"check.Inf","kind":"type","old":"30107196989adb99","new":"5ee17f220c0e5e1f","interface_changed":true,"affected":["check.fresh","check.resolve","check.res","check.unify","check.error","check.expect","check.join_union","check.numeric","check.fresh_for","check.place","check.bind_typed","check.infer_all","check.binary","check.infer_block","check.infer_call","check.infer_if","check.infer_list","check.infer_match","check.infer_ctor","check.infer_lambda","check.infer","check.infer_method","check.var_type","check.is_sum","check.fresh_scheme","check.builtin_call","check.fits_all","check.element_of","check.fits","check.arm_variants","check.implements","check.bound_method","check.program_type","check.static_call","check.arm_members","check.as_trait","check.trait_method","check.fn_inferred","check.annotated","check.next_let","check.fill","check.wrong_try","check.not_result","check.not_iterable","check.check_spec","check.early_error","check.awaited","check.not_awaitable","check.outside_scope","check.own_trait_of","check.trait_fn","check.reaches","check.solve_pending","check.holds_sender","check.written_calls","check.infer_untagged","check.sized_expected","check.int_literal","check.sized_operands","check.task_body","check.fill_arms","check.lam_unmarked","check.holes_found","check.code_trait_method","check.default_errors","check.owned_reads","check.traits_declaring","check.implements_trait","check.ambiguity","check.self_args","check.named_refinement","check.excluded_by","check.ctor_fields","check.member_for","check.cover_of","check.atoms","check.covers","check.missing","check.useful","check.check_coverage","check.type_of_column","check.mut_narrower","check.written_cover","check.refinement_within","check.code_method_problem","check.unmet_bound","check.iter_builtin","check.own_calls","check.trait_fn_of","check.element_assigned","check.listed_arg","check.as_listed","check.listed_args","check.string_method","check.tuple_taken_apart","check.lam_written","check.unused_values","check.changing_call","check.allocating_arith","check.noalloc_typed","check.spread_calls","check.spread_error","check.infer_spread","check.spread_fn_params","check.spread_method_params","check.spread_method_of","check.spread_filled","check.dropped_results","check.trait_with_method","check.provided_method","check.read_owners","check.named_types","check.narrowed_result","check.narrow_by","check.result_variants","check.variants_named","check.decide","check.variants_field","check.variants_covered","check.narrowed_at","check.is_narrowed","check.variable_is","check.sum_variants","check.with_field","check.method_facts_key","check.fn_errors","check.instantiated","check.fn_lambdas_typed","check.holes_of","check.mark_field_reads","check.own_methods_resolved","check.typed_one","check.decl_type_errors","check.spread_body","check.field_reads","eval_files","instantiated_files","check.lambdas_typed","holes_command","check_summary","finding.uses_of","rename_command","verified_decls","check.typed","check.type_errors_with","check.spreads_resolved","unused.members","command_line","check_command","finding.uses_from","finding.used_by_tree","finding.refs_command","verified_with","static_graph","codegen.new_gen","computed_value","repl_eval","check.type_errors","check_errors_in","literal_errors","expanded","unused.findings","main","strata_command","finding.uses_tree","verified_program","verify_file","build_command","graph_command","graph_diff","tour_graph","codegen.generate","codegen.read_back","comptime_value","repl_command","check_errors_with","edit_errors","literal_errors_of","codegen_with","with_base","unused_of","edit_unused","core_unused","codegen.entry","codegen.compiled_alone","eval.run","smt_file","termination_file","verify_command","build_proofs","alongside_command","search_invariants","diff_command","tour_command","core_rt_text","comptime_values","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","codegen_text","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","run_command","fix_loops","build_core_command","comptime_runner","package_errors","merge_file_command","merged_checks","call_command","edit_command","check_files","move_command","fix_command","edit_in_editor","codegen_file","jit_file","fuzz_file","graph_runs","replay","or_solver_inputs","program_objects","sync_command","check_fn","linked"],"module":"check","text":"/// The inference's state: what type variables stand for, the next fresh\n/// one, the errors found, the program's functions, and the return type of\n/// the function being checked.\ntype Inf = {\n  subst: Dict[Int, check.Ty],\n  next: Int,\n  errs: List[String],\n  fns: Dict[String, check.Ty],\n  ret: check.Ty,\n  types: check.Types,\n  tparams: Set[String],\n  // the traits each type parameter in scope is bound by\n  tbounds: Dict[String, List[String]],\n  methods: check.Methods,\n  narrowed: Set[String],\n  // the variables an arm assigns to: their declared types there\n  exempt: Set[String],\n  // the variables declared outside the innermost `scope` (None: in none)\n  outside: Option[Set[String]],\n  // the variables from outside the closure or `spawn` being checked\n  captured: Set[String],\n  builtins: Dict[String, List[check.Builtin]],\n  // each variable declared (`x := e`, `mut x := e`) and the type it got, in\n  // the order met; `typed` writes them into the tree\n  lets: List[(String, check.Ty)],\n  // each lambda parameter marked by `lambdas_typed` (`$lam…`) and the type\n  // it got\n  lambdas: Dict[String, check.Ty],\n  // the trait obligations met (a trait's method used as a function: its\n  // `Self`, the trait, the method), solved once the body is checked\n  pending: List[(check.Ty, String, String)],\n  // the type of each call tagged by `instantiated` (`f#3(..)`, `x.m#4(..)`)\n  insts: Dict[String, check.Ty],\n  // each arithmetic operation met (`+`, `-`, ...) and its type. On `Int`,\n  // `String` or `List` it allocates, which `noalloc` code can't do.\n  arith: List[(String, check.Ty)],\n  // each hole met (`?name`): the type it must have, and the variables in\n  // scope there with their types (`strata holes`)\n  holes: List[(String, check.Ty, Dict[String, check.Ty])] = [],\n  // each variable's type as written, when refined (`n: Positive`, or the\n  // refinement an arm named: `Positive => …`); a match on it may leave out\n  // what the refinement excludes\n  written: Dict[String, ast.TypeExpr] = Dict[String, ast.TypeExpr] {},\n  // each argument that is a finite iterator where its parameter is a `List`\n  // (the callee's name, the argument's index, the argument); `as_listed`\n  // converts them with `to_list`\n  as_lists: List[(String, Int, ast.Expr)] = [],\n  // each expression statement met, its type, and the type of the variable\n  // its call's first argument names (`xs` in `push(xs, 1)`), if any. A\n  // value other than `()` is an error once the body is solved (`unused_values`).\n  discarded: List[(ast.Expr, check.Ty, Option[check.Ty])] = [],\n  // each call spreading records (`f(...x)`, tagged `f#s0_1` by\n  // `spread_bound`), written out (`f(x.a, x.b)`), by its tag\n  spreads: Dict[String, ast.Expr] = Dict[String, ast.Expr] {},\n  // the errors of calls spreading records, also in `errs`\n  spread_errs: List[String] = [],\n  // the type of what each `for` runs over; a `noalloc` function can't run\n  // over what needs a list made (`noalloc_typed`)\n  iters: List[check.Ty] = [],\n  // each method called and its receiver's type, for `noalloc_typed`\n  recvs: List[(String, check.Ty)] = [],\n  // each `_ := e` met and the type of `e`; a `Result` thrown away this way\n  // is a warning (`dropped_results`)\n  dropped: List[(ast.Expr, check.Ty)] = [],\n  // calls of the program's functions and methods begun so far; each takes\n  // the next number when it starts\n  call_seq: Int = 0,\n  // the last such call checked: its number, its function (`f`, or `T.m` for\n  // a method), the variants its result can be there (`narrowed_at`; none:\n  // not narrowed), and whether what its function says of them rests on\n  // conditions left to `verify`. A match on the call, or a field read of\n  // it, reads it when the number is the one the call took (so it is that\n  // call's, not one inside it).\n  last_call: (Int, String, List[String], Bool) = (-1, \"\", [], false),\n}","old_text":"/// The inference's state: what type variables stand for, the next fresh\n/// one, the errors found, the program's functions, and the return type of\n/// the function being checked.\ntype Inf = {\n  subst: Dict[Int, check.Ty],\n  next: Int,\n  errs: List[String],\n  fns: Dict[String, check.Ty],\n  ret: check.Ty,\n  types: check.Types,\n  tparams: Set[String],\n  // the traits each type parameter in scope is bound by\n  tbounds: Dict[String, List[String]],\n  methods: check.Methods,\n  narrowed: Set[String],\n  // the variables an arm assigns to: their declared types there\n  exempt: Set[String],\n  // the variables declared outside the innermost `scope` (None: in none)\n  outside: Option[Set[String]],\n  // the variables from outside the closure or `spawn` being checked\n  captured: Set[String],\n  builtins: Dict[String, List[check.Builtin]],\n  // each variable declared (`x := e`, `mut x := e`) and the type it got, in\n  // the order met; `typed` writes them into the tree\n  lets: List[(String, check.Ty)],\n  // each lambda parameter marked by `lambdas_typed` (`$lam…`) and the type\n  // it got\n  lambdas: Dict[String, check.Ty],\n  // the trait obligations met (a trait's method used as a function: its\n  // `Self`, the trait, the method), solved once the body is checked\n  pending: List[(check.Ty, String, String)],\n  // the type of each call tagged by `instantiated` (`f#3(..)`, `x.m#4(..)`)\n  insts: Dict[String, check.Ty],\n  // each arithmetic operation met (`+`, `-`, ...) and its type. On `Int`,\n  // `String` or `List` it allocates, which `noalloc` code can't do.\n  arith: List[(String, check.Ty)],\n  // each hole met (`?name`): the type it must have, and the variables in\n  // scope there with their types (`strata holes`)\n  holes: List[(String, check.Ty, Dict[String, check.Ty])] = [],\n  // each variable's type as written, when refined (`n: Positive`, or the\n  // refinement an arm named: `Positive => …`); a match on it may leave out\n  // what the refinement excludes\n  written: Dict[String, ast.TypeExpr] = Dict[String, ast.TypeExpr] {},\n  // each argument that is a finite iterator where its parameter is a `List`\n  // (the callee's name, the argument's index, the argument); `as_listed`\n  // converts them with `to_list`\n  as_lists: List[(String, Int, ast.Expr)] = [],\n  // each expression statement met, its type, and the type of the variable\n  // its call's first argument names (`xs` in `push(xs, 1)`), if any. A\n  // value other than `()` is an error once the body is solved (`unused_values`).\n  discarded: List[(ast.Expr, check.Ty, Option[check.Ty])] = [],\n  // each call spreading records (`f(...x)`, tagged `f#s0_1` by\n  // `spread_bound`), written out (`f(x.a, x.b)`), by its tag\n  spreads: Dict[String, ast.Expr] = Dict[String, ast.Expr] {},\n  // the errors of calls spreading records, also in `errs`\n  spread_errs: List[String] = [],\n  // the type of what each `for` runs over; a `noalloc` function can't run\n  // over what needs a list made (`noalloc_typed`)\n  iters: List[check.Ty] = [],\n  // each method called and its receiver's type, for `noalloc_typed`\n  recvs: List[(String, check.Ty)] = [],\n  // each `_ := e` met and the type of `e`; a `Result` thrown away this way\n  // is a warning (`dropped_results`)\n  dropped: List[(ast.Expr, check.Ty)] = [],\n  // the last call of one of the program's functions checked: its name, the\n  // variants its result can be there (`narrowed_at`; none: not narrowed),\n  // and whether what its function says of them rests on conditions left to\n  // `verify`. A match on the call reads it (`variants_covered`).\n  last_call: (String, List[String], Bool) = (\"\", [], false),\n}"},{"name":"check.bind_typed","kind":"fn","old":"abd0de0e70a5c2e0","new":"8e413261367f7ee5","interface_changed":false,"affected":[],"module":"check","text":"/// `env` with the names bound by a pattern matching a value of type `t`.\n/// A constructor pattern's fields get the field's type.\nfn bind_typed(\n  mut i: check.Inf,\n  env: Dict[String, check.Ty],\n  p: ast.Pattern,\n  t: check.Ty,\n) -> Dict[String, check.Ty] {\n  match p {\n    ast.Bind(n) => {\n      mut copy := env\n      mut copy.insert(n, t)\n      copy\n    },\n    ast.CtorPattern { name, args } => match get(i.types.ctors, name) {\n      Some(given) => {\n        // a variant of a sum against a value of another type\n        if contains(i.types.sums, given.owner) {\n          wrong := match check.res(i, t) {\n            check.TInt | check.TFloat | check.TBool | check.TStr | check.TList(_) => true,\n            check.TNamed { name: tn, .. } => tn != given.owner\n              && tn != \"Tuple\"\n              && contains(i.types.sums, tn),\n            _ => false,\n          }\n          if wrong {\n            match check.shown(check.res(i, t)) {\n              Some(x) => check.error(mut i, \"pattern `\"\n                + name\n                + \"`: expected `\"\n                + x\n                + \"`, found `\"\n                + check.last_part(name)\n                + \"`\"),\n              None => (),\n            }\n          }\n        }\n        // the field types, with the matched value's type arguments\n        m := match check.res(i, t) {\n          check.TNamed { name: tn, args: targs } | check.TVariants { owner: tn, args: targs, .. } => if tn == given.owner {\n            check.pairs(given.params, targs)\n          } else {\n            Dict[String, check.Ty] {}\n          },\n          _ => Dict[String, check.Ty] {},\n        }\n        sh := check.Shape { ..given, fields: given.fields.map(f -> (f.0, check.inst(f.1, m))) }\n        match args {\n          ast.PositionalPats(ps) => {\n            mut out := env\n            for (k, q) in enumerate(ps) {\n              ft := match get(sh.fields, k) {\n                Some(f) => check.inst(f.1, Dict[String, check.Ty] {}),\n                None => check.TAny,\n              }\n              out = check.bind_typed(mut i, out, q, ft)\n            }\n            out\n          },\n          ast.RecordPats { fields, .. } => {\n            mut out := env\n            for f in fields {\n              out = check.bind_typed(mut i, out, f.1, check.inst(\n                check.field_of(sh, f.0) ?? check.TAny,\n                Dict[String, check.Ty] {},\n              ))\n            }\n            out\n          },\n          _ => check.bind_pattern(env, p),\n        }\n      },\n      None => check.bind_pattern(env, p),\n    },\n    // `(a, b)`: each name gets its element's type; a value of a type not\n    // known yet is a tuple of as many\n    ast.TuplePat(ps) => match check.res(i, t) {\n      check.TVar(_) => {\n        mut elems := []\n        for _ in ps {\n          mut elems.push(check.fresh(mut i))\n        }\n        _ := check.unify(\n          mut i,\n          t,\n          check.TNamed { name: \"Tuple\", args: elems },\n          100,\n        )\n        mut out := env\n        for (k, q) in enumerate(ps) {\n          out = check.bind_typed(\n            mut i,\n            out,\n            q,\n            get(elems, k) ?? check.TAny,\n          )\n        }\n        out\n      },\n      check.TNamed { name, args } => if name == \"Tuple\" && len(args) == len(ps) {\n        mut out := env\n        for (k, q) in enumerate(ps) {\n          out = check.bind_typed(\n            mut i,\n            out,\n            q,\n            get(args, k) ?? check.TAny,\n          )\n        }\n        out\n      } else {\n        check.bind_pattern(env, p)\n      },\n      _ => check.bind_pattern(env, p),\n    },\n    _ => check.bind_pattern(env, p),\n  }\n}","old_text":"/// `env` with the names bound by a pattern matching a value of type `t`.\n/// A constructor pattern's fields get the field's type.\nfn bind_typed(\n  mut i: check.Inf,\n  env: Dict[String, check.Ty],\n  p: ast.Pattern,\n  t: check.Ty,\n) -> Dict[String, check.Ty] {\n  match p {\n    ast.Bind(n) => {\n      mut copy := env\n      mut copy.insert(n, t)\n      copy\n    },\n    ast.CtorPattern { name, args } => match get(i.types.ctors, name) {\n      Some(given) => {\n        // a variant of a sum against a value of another type\n        if contains(i.types.sums, given.owner) {\n          wrong := match check.res(i, t) {\n            check.TInt | check.TFloat | check.TBool | check.TStr | check.TList(_) => true,\n            check.TNamed { name: tn, .. } => tn != given.owner\n              && tn != \"Tuple\"\n              && contains(i.types.sums, tn),\n            _ => false,\n          }\n          if wrong {\n            match check.shown(check.res(i, t)) {\n              Some(x) => check.error(mut i, \"pattern `\"\n                + name\n                + \"`: expected `\"\n                + x\n                + \"`, found `\"\n                + check.last_part(name)\n                + \"`\"),\n              None => (),\n            }\n          }\n        }\n        // the field types, with the matched value's type arguments\n        m := match check.res(i, t) {\n          check.TNamed { name: tn, args: targs } => if tn == given.owner {\n            check.pairs(given.params, targs)\n          } else {\n            Dict[String, check.Ty] {}\n          },\n          _ => Dict[String, check.Ty] {},\n        }\n        sh := check.Shape { ..given, fields: given.fields.map(f -> (f.0, check.inst(f.1, m))) }\n        match args {\n          ast.PositionalPats(ps) => {\n            mut out := env\n            for (k, q) in enumerate(ps) {\n              ft := match get(sh.fields, k) {\n                Some(f) => check.inst(f.1, Dict[String, check.Ty] {}),\n                None => check.TAny,\n              }\n              out = check.bind_typed(mut i, out, q, ft)\n            }\n            out\n          },\n          ast.RecordPats { fields, .. } => {\n            mut out := env\n            for f in fields {\n              out = check.bind_typed(mut i, out, f.1, check.inst(\n                check.field_of(sh, f.0) ?? check.TAny,\n                Dict[String, check.Ty] {},\n              ))\n            }\n            out\n          },\n          _ => check.bind_pattern(env, p),\n        }\n      },\n      None => check.bind_pattern(env, p),\n    },\n    // `(a, b)`: each name gets its element's type; a value of a type not\n    // known yet is a tuple of as many\n    ast.TuplePat(ps) => match check.res(i, t) {\n      check.TVar(_) => {\n        mut elems := []\n        for _ in ps {\n          mut elems.push(check.fresh(mut i))\n        }\n        _ := check.unify(\n          mut i,\n          t,\n          check.TNamed { name: \"Tuple\", args: elems },\n          100,\n        )\n        mut out := env\n        for (k, q) in enumerate(ps) {\n          out = check.bind_typed(\n            mut i,\n            out,\n            q,\n            get(elems, k) ?? check.TAny,\n          )\n        }\n        out\n      },\n      check.TNamed { name, args } => if name == \"Tuple\" && len(args) == len(ps) {\n        mut out := env\n        for (k, q) in enumerate(ps) {\n          out = check.bind_typed(\n            mut i,\n            out,\n            q,\n            get(args, k) ?? check.TAny,\n          )\n        }\n        out\n      } else {\n        check.bind_pattern(env, p)\n      },\n      _ => check.bind_pattern(env, p),\n    },\n    _ => check.bind_pattern(env, p),\n  }\n}"},{"name":"check.infer_call","kind":"fn","old":"c14ebac5a5a90d00","new":"21a435659fecda39","interface_changed":false,"affected":[],"module":"check","text":"fn infer_call(\n  mut i: check.Inf,\n  callee: ast.Expr,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n) -> check.Ty {\n  seq := i.call_seq\n  i.call_seq += 1\n  // `remove(d, k)` stored as a method of a trait a module imports\n  // (`std.fs.remove`), on a list, dict or set: it is the built-in, which\n  // changes its argument, so it must be the method `mut d.remove(k)`\n  match (callee, args) {\n    (ast.Var(n), [first, ..]) => {\n      parts := split(n, \".\")\n      s := get(parts, len(parts) - 1) ?? n\n      if s != n\n        && builtins.changing(s)\n        && (first is ast.Var || first is ast.FieldOf) {\n        ft := check.res(i, check.infer(mut i, first, env, None))\n        if ft is check.TList || check.is_table(ft) {\n          check.error(mut i, \"`\"\n            + check.short_code(ast.Call { callee: ast.Var(s), args })\n            + \"`: `\"\n            + s\n            + \"` changes the list, dict or set it is called on: write `mut \"\n            + text.expr_text(first, 0)\n            + \".\"\n            + s\n            + \"(…)`\"\n            + check.new_value_hint(s))\n          check.infer_all(mut i, drop(args, 1), env)\n          return check.TAny\n        }\n      }\n    },\n    _ => (),\n  }\n  // a built-in function, unless a local or one of the program's\n  match callee {\n    ast.Var(n) => if !contains(env, n) && get(i.fns, n) is None {\n      match get(i.builtins, n) {\n        Some(bs) => {\n          // `take(it, 2)` on an iterator: the method of core's trait its type\n          // implements (`it.take(2)`). Only a variable or a constructor is looked\n          // at first, since inferring an expression twice would type its lambdas\n          // twice.\n          match args {\n            [first, ..rest] => if first is ast.Var || first is ast.CtorExpr {\n              match check.res(i, check.infer(mut i, first, env, None)) {\n                check.TNamed { name, .. } => if check.code_trait_method(i, name, n, check.TAny) is Some {\n                  return check.infer_method(\n                    mut i,\n                    first,\n                    n,\n                    rest,\n                    env,\n                    false,\n                  )\n                },\n                _ => (),\n              }\n            } else if first is ast.Call || first is ast.MethodCall {\n              // a call, as in `map(filter(it, f), g)` from a comprehension over an\n              // iterator: inferred once, then the method on what it gives, or the\n              // built-in given its type\n              t0 := check.listed_arg(\n                mut i,\n                n,\n                0,\n                first,\n                check.shown_as(n, check.TAny),\n                check.infer(mut i, first, env, None),\n                \"call to `\" + n + \"`\",\n              )\n              match check.iter_builtin(\n                mut i,\n                n,\n                check.res(i, t0),\n                rest,\n                env,\n              ) {\n                Some(t) => return t,\n                None => (),\n              }\n              match check.res(i, t0) {\n                check.TNamed { name, .. } => if check.code_trait_method(i, name, n, check.TAny) is Some {\n                  return check.infer_method(\n                    mut i,\n                    ast.Var(\"$first\"),\n                    n,\n                    rest,\n                    {\n                      mut copy := env\n                      mut copy.insert(\"$first\", t0)\n                      copy\n                    },\n                    false,\n                  )\n                },\n                _ => (),\n              }\n              return check.builtin_call(mut i, n, bs, [t0], rest, env)\n            },\n            [] => (),\n          }\n          // one that changes a list, dict or set is a method: `mut xs.push(x)`\n          if bs.any(b -> b.changes) {\n            check.error(mut i, \"`\"\n              + check.short_code(ast.Call { callee, args })\n              + \"`: `\"\n              + n\n              + \"` changes the \"\n              + \"list, dict or set it is called on: write `mut \"\n              + text.expr_text(\n                check.unmarked_arg(get(args, 0) ?? ast.UnitExpr),\n                0,\n              )\n              + \".\"\n              + n\n              + \"(…)`\"\n              + check.new_value_hint(n))\n            check.infer_all(mut i, args, env)\n            return check.TAny\n          }\n          // a built-in has no `mut` parameters\n          for a in args {\n            match a {\n              ast.MutExpr(x) => if !(x is ast.MethodCall) {\n                check.error(mut i, \"`\"\n                  + text.expr_text(a, 0)\n                  + \"`: `\"\n                  + n\n                  + \"` has no `mut` parameters\")\n              },\n              _ => (),\n            }\n          }\n          return check.builtin_call(mut i, n, bs, [], args, env)\n        },\n        None => (),\n      }\n    },\n    _ => (),\n  }\n  // one of the program's functions with bounds: its type parameters are\n  // kept, to check the bounds once the arguments are checked\n  (ct, vars, bounds) := match callee {\n    ast.Var(n) => if !contains(env, n) && len(get(i.methods.bounds, n) ?? []) > 0 {\n      match get(i.fns, n) {\n        Some(t) => {\n          m := check.fresh_for(\n            mut i,\n            to_list(check.gens(t, Set[String] {})),\n          )\n          (check.inst(t, m), m, get(i.methods.bounds, n) ?? [])\n        },\n        None => (\n          check.infer(mut i, callee, env, None),\n          Dict[String, check.Ty] {},\n          [],\n        ),\n      }\n    } else if !contains(env, n) && get(i.fns, n) is None {\n      // a method called as a function, `describe(x)`, is resolved by its\n      // argument; only a value of it is ambiguous\n      (\n        check.trait_fn_of(mut i, n, false),\n        Dict[String, check.Ty] {},\n        [],\n      )\n    } else {\n      (\n        check.infer(mut i, callee, env, None),\n        Dict[String, check.Ty] {},\n        [],\n      )\n    },\n    _ => (\n      check.infer(mut i, callee, env, None),\n      Dict[String, check.Ty] {},\n      [],\n    ),\n  }\n  what := match callee {\n    ast.Var(n) => \"call to `\" + n + \"`\",\n    _ => \"call\",\n  }\n  match check.res(i, ct) {\n    check.TFn { params, ret } => {\n      // a wrong number of arguments is reported by `expression_errors`\n      mut arg_types := []\n      if len(params) == len(args) {\n        for (k, a) in enumerate(args) {\n          p := get(params, k) ?? check.TAny\n          at := check.listed_arg(\n            mut i,\n            check.n_of(callee),\n            k,\n            a,\n            p,\n            check.infer(mut i, a, env, Some(p)),\n            what,\n          )\n          mut arg_types.push(at)\n          check.expect(\n            mut i,\n            p,\n            at,\n            what + \", argument \" + to_string(k + 1),\n          )\n          // a `mut` parameter takes its exact type: the function can put any value\n          // of it into the caller's variable\n          mp := get(\n            get(i.methods.mut_params, check.n_of(callee)) ?? [],\n            k,\n          ) ?? check.TAny\n          if !(check.res(i, at) is check.TVariants)\n            && !(mp is check.TTrait)\n            && check.exact_differs(mp, check.res(i, at)) {\n            match (check.shown(mp), check.shown(check.res(i, at))) {\n              (Some(w), Some(g)) => check.error(mut i, what\n                + \", argument \"\n                + to_string(k + 1)\n                + \": expected exactly `\"\n                + w\n                + \"`, found `\"\n                + g\n                + \"` (the parameter is `mut`, so the function can put any `\"\n                + w\n                + \"` into the caller's variable)\"),\n              _ => (),\n            }\n          } else if check.mut_narrower(i, check.n_of(callee), k, a) is Some {\n            // nor a value the variable's own refinement rules out\n            match check.mut_narrower(i, check.n_of(callee), k, a) {\n              Some((x, vw, pw)) => check.error(mut i, what\n                + \", argument \"\n                + to_string(k + 1)\n                + \": `\"\n                + x\n                + \"` is declared `\"\n                + text.type_text(vw)\n                + \"`, but the `mut` parameter is `\"\n                + text.type_text(pw)\n                + \"`: the function could store a value `\"\n                + x\n                + \"` must never hold\"),\n              None => (),\n            }\n          } else if !(mp is check.TAny)\n            && len(check.gens(mp, Set[String] {})) == 0 {\n            // a variable whose type isn't known yet (`mut xs := []`) takes the\n            // parameter's\n            _ := check.unify(mut i, mp, at, 100)\n          }\n        }\n        // each bound: the type the parameter stands for implements the trait\n        for b in bounds {\n          if contains(i.methods.checked, b.1) {\n            // a type nothing has determined yet: an obligation, reported at the end\n            // if nothing does\n            match check.res(i, get(vars, b.0) ?? check.TAny) {\n              check.TVar(_) => mut i.pending.push(\n                (\n                  get(vars, b.0) ?? check.TAny,\n                  b.1,\n                  check.n_of(callee),\n                ),\n              ),\n              _ => (),\n            }\n            match check.shown(check.res(i, get(vars, b.0) ?? check.TAny)) {\n              Some(x) => if !check.implements(\n                i,\n                check.res(i, get(vars, b.0) ?? check.TAny),\n                b.1,\n              ) {\n                check.error(mut i, \"calling `\"\n                  + check.n_of(callee)\n                  + \"`: `\"\n                  + x\n                  + \"` does not implement `\"\n                  + b.1\n                  + \"`\")\n              },\n              None => (),\n            }\n          }\n        }\n      }\n      // a program function's result, narrowed by what it says of it\n      match callee {\n        ast.Var(n) => if !contains(env, n) && len(arg_types) == len(args) {\n          i.last_call = match check.narrowed_at(i, n, arg_types, ret) {\n            Some((_, _, left, u)) => (seq, n, to_list(left).sorted(), u),\n            None => (seq, n, [], false),\n          }\n          check.narrowed_result(i, n, arg_types, ret)\n        } else {\n          ret\n        },\n        _ => ret,\n      }\n    },\n    // a value that is not a function (`n(2)` with `n: Int`)\n    other => {\n      match (callee, check.shown(other)) {\n        (ast.Var(_), Some(x)) => if !(other is check.TFn) {\n          check.error(\n            mut i,\n            what + \": `\" + x + \"` is not a function\",\n          )\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}","old_text":"fn infer_call(\n  mut i: check.Inf,\n  callee: ast.Expr,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n) -> check.Ty {\n  // `remove(d, k)` stored as a method of a trait a module imports\n  // (`std.fs.remove`), on a list, dict or set: it is the built-in, which\n  // changes its argument, so it must be the method `mut d.remove(k)`\n  match (callee, args) {\n    (ast.Var(n), [first, ..]) => {\n      parts := split(n, \".\")\n      s := get(parts, len(parts) - 1) ?? n\n      if s != n\n        && builtins.changing(s)\n        && (first is ast.Var || first is ast.FieldOf) {\n        ft := check.res(i, check.infer(mut i, first, env, None))\n        if ft is check.TList || check.is_table(ft) {\n          check.error(mut i, \"`\"\n            + check.short_code(ast.Call { callee: ast.Var(s), args })\n            + \"`: `\"\n            + s\n            + \"` changes the list, dict or set it is called on: write `mut \"\n            + text.expr_text(first, 0)\n            + \".\"\n            + s\n            + \"(…)`\"\n            + check.new_value_hint(s))\n          check.infer_all(mut i, drop(args, 1), env)\n          return check.TAny\n        }\n      }\n    },\n    _ => (),\n  }\n  // a built-in function, unless a local or one of the program's\n  match callee {\n    ast.Var(n) => if !contains(env, n) && get(i.fns, n) is None {\n      match get(i.builtins, n) {\n        Some(bs) => {\n          // `take(it, 2)` on an iterator: the method of core's trait its type\n          // implements (`it.take(2)`). Only a variable or a constructor is looked\n          // at first, since inferring an expression twice would type its lambdas\n          // twice.\n          match args {\n            [first, ..rest] => if first is ast.Var || first is ast.CtorExpr {\n              match check.res(i, check.infer(mut i, first, env, None)) {\n                check.TNamed { name, .. } => if check.code_trait_method(i, name, n, check.TAny) is Some {\n                  return check.infer_method(\n                    mut i,\n                    first,\n                    n,\n                    rest,\n                    env,\n                    false,\n                  )\n                },\n                _ => (),\n              }\n            } else if first is ast.Call || first is ast.MethodCall {\n              // a call, as in `map(filter(it, f), g)` from a comprehension over an\n              // iterator: inferred once, then the method on what it gives, or the\n              // built-in given its type\n              t0 := check.listed_arg(\n                mut i,\n                n,\n                0,\n                first,\n                check.shown_as(n, check.TAny),\n                check.infer(mut i, first, env, None),\n                \"call to `\" + n + \"`\",\n              )\n              match check.iter_builtin(\n                mut i,\n                n,\n                check.res(i, t0),\n                rest,\n                env,\n              ) {\n                Some(t) => return t,\n                None => (),\n              }\n              match check.res(i, t0) {\n                check.TNamed { name, .. } => if check.code_trait_method(i, name, n, check.TAny) is Some {\n                  return check.infer_method(\n                    mut i,\n                    ast.Var(\"$first\"),\n                    n,\n                    rest,\n                    {\n                      mut copy := env\n                      mut copy.insert(\"$first\", t0)\n                      copy\n                    },\n                    false,\n                  )\n                },\n                _ => (),\n              }\n              return check.builtin_call(mut i, n, bs, [t0], rest, env)\n            },\n            [] => (),\n          }\n          // one that changes a list, dict or set is a method: `mut xs.push(x)`\n          if bs.any(b -> b.changes) {\n            check.error(mut i, \"`\"\n              + check.short_code(ast.Call { callee, args })\n              + \"`: `\"\n              + n\n              + \"` changes the \"\n              + \"list, dict or set it is called on: write `mut \"\n              + text.expr_text(\n                check.unmarked_arg(get(args, 0) ?? ast.UnitExpr),\n                0,\n              )\n              + \".\"\n              + n\n              + \"(…)`\"\n              + check.new_value_hint(n))\n            check.infer_all(mut i, args, env)\n            return check.TAny\n          }\n          // a built-in has no `mut` parameters\n          for a in args {\n            match a {\n              ast.MutExpr(x) => if !(x is ast.MethodCall) {\n                check.error(mut i, \"`\"\n                  + text.expr_text(a, 0)\n                  + \"`: `\"\n                  + n\n                  + \"` has no `mut` parameters\")\n              },\n              _ => (),\n            }\n          }\n          return check.builtin_call(mut i, n, bs, [], args, env)\n        },\n        None => (),\n      }\n    },\n    _ => (),\n  }\n  // one of the program's functions with bounds: its type parameters are\n  // kept, to check the bounds once the arguments are checked\n  (ct, vars, bounds) := match callee {\n    ast.Var(n) => if !contains(env, n) && len(get(i.methods.bounds, n) ?? []) > 0 {\n      match get(i.fns, n) {\n        Some(t) => {\n          m := check.fresh_for(\n            mut i,\n            to_list(check.gens(t, Set[String] {})),\n          )\n          (check.inst(t, m), m, get(i.methods.bounds, n) ?? [])\n        },\n        None => (\n          check.infer(mut i, callee, env, None),\n          Dict[String, check.Ty] {},\n          [],\n        ),\n      }\n    } else if !contains(env, n) && get(i.fns, n) is None {\n      // a method called as a function, `describe(x)`, is resolved by its\n      // argument; only a value of it is ambiguous\n      (\n        check.trait_fn_of(mut i, n, false),\n        Dict[String, check.Ty] {},\n        [],\n      )\n    } else {\n      (\n        check.infer(mut i, callee, env, None),\n        Dict[String, check.Ty] {},\n        [],\n      )\n    },\n    _ => (\n      check.infer(mut i, callee, env, None),\n      Dict[String, check.Ty] {},\n      [],\n    ),\n  }\n  what := match callee {\n    ast.Var(n) => \"call to `\" + n + \"`\",\n    _ => \"call\",\n  }\n  match check.res(i, ct) {\n    check.TFn { params, ret } => {\n      // a wrong number of arguments is reported by `expression_errors`\n      mut arg_types := []\n      if len(params) == len(args) {\n        for (k, a) in enumerate(args) {\n          p := get(params, k) ?? check.TAny\n          at := check.listed_arg(\n            mut i,\n            check.n_of(callee),\n            k,\n            a,\n            p,\n            check.infer(mut i, a, env, Some(p)),\n            what,\n          )\n          mut arg_types.push(at)\n          check.expect(\n            mut i,\n            p,\n            at,\n            what + \", argument \" + to_string(k + 1),\n          )\n          // a `mut` parameter takes its exact type: the function can put any value\n          // of it into the caller's variable\n          mp := get(\n            get(i.methods.mut_params, check.n_of(callee)) ?? [],\n            k,\n          ) ?? check.TAny\n          if !(check.res(i, at) is check.TVariants)\n            && !(mp is check.TTrait)\n            && check.exact_differs(mp, check.res(i, at)) {\n            match (check.shown(mp), check.shown(check.res(i, at))) {\n              (Some(w), Some(g)) => check.error(mut i, what\n                + \", argument \"\n                + to_string(k + 1)\n                + \": expected exactly `\"\n                + w\n                + \"`, found `\"\n                + g\n                + \"` (the parameter is `mut`, so the function can put any `\"\n                + w\n                + \"` into the caller's variable)\"),\n              _ => (),\n            }\n          } else if check.mut_narrower(i, check.n_of(callee), k, a) is Some {\n            // nor a value the variable's own refinement rules out\n            match check.mut_narrower(i, check.n_of(callee), k, a) {\n              Some((x, vw, pw)) => check.error(mut i, what\n                + \", argument \"\n                + to_string(k + 1)\n                + \": `\"\n                + x\n                + \"` is declared `\"\n                + text.type_text(vw)\n                + \"`, but the `mut` parameter is `\"\n                + text.type_text(pw)\n                + \"`: the function could store a value `\"\n                + x\n                + \"` must never hold\"),\n              None => (),\n            }\n          } else if !(mp is check.TAny)\n            && len(check.gens(mp, Set[String] {})) == 0 {\n            // a variable whose type isn't known yet (`mut xs := []`) takes the\n            // parameter's\n            _ := check.unify(mut i, mp, at, 100)\n          }\n        }\n        // each bound: the type the parameter stands for implements the trait\n        for b in bounds {\n          if contains(i.methods.checked, b.1) {\n            // a type nothing has determined yet: an obligation, reported at the end\n            // if nothing does\n            match check.res(i, get(vars, b.0) ?? check.TAny) {\n              check.TVar(_) => mut i.pending.push(\n                (\n                  get(vars, b.0) ?? check.TAny,\n                  b.1,\n                  check.n_of(callee),\n                ),\n              ),\n              _ => (),\n            }\n            match check.shown(check.res(i, get(vars, b.0) ?? check.TAny)) {\n              Some(x) => if !check.implements(\n                i,\n                check.res(i, get(vars, b.0) ?? check.TAny),\n                b.1,\n              ) {\n                check.error(mut i, \"calling `\"\n                  + check.n_of(callee)\n                  + \"`: `\"\n                  + x\n                  + \"` does not implement `\"\n                  + b.1\n                  + \"`\")\n              },\n              None => (),\n            }\n          }\n        }\n      }\n      // a program function's result, narrowed by what it says of it\n      match callee {\n        ast.Var(n) => if !contains(env, n) && len(arg_types) == len(args) {\n          i.last_call = match check.narrowed_at(i, n, arg_types, ret) {\n            Some((_, _, left, u)) => (n, to_list(left).sorted(), u),\n            None => (n, [], false),\n          }\n          check.narrowed_result(i, n, arg_types, ret)\n        } else {\n          ret\n        },\n        _ => ret,\n      }\n    },\n    // a value that is not a function (`n(2)` with `n: Int`)\n    other => {\n      match (callee, check.shown(other)) {\n        (ast.Var(_), Some(x)) => if !(other is check.TFn) {\n          check.error(\n            mut i,\n            what + \": `\" + x + \"` is not a function\",\n          )\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}"},{"name":"check.infer_match","kind":"fn","old":"82e002287ba23ba5","new":"987deec2d4889ac2","interface_changed":false,"affected":[],"module":"check","text":"fn infer_match(\n  mut i: check.Inf,\n  scrutinee: ast.Expr,\n  binding: Option[String],\n  arms: List[ast.Arm],\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  seq := i.call_seq\n  st := check.infer(mut i, scrutinee, env, None)\n  // what the call matched on can give, read before the arms make calls:\n  // `last_call` is this call's when it took the number `seq`\n  (this_call, can_at) := match i.last_call {\n    (ls, _, vs, u) => if ls == seq\n      && (scrutinee is ast.Call || scrutinee is ast.MethodCall) {\n      (true, if len(vs) > 0 {\n        Some((vs, u))\n      } else {\n        None\n      })\n    } else {\n      (false, None)\n    },\n  }\n  // narrowing drops variants, never type arguments: patterns can use the\n  // matched variable's declared type\n  pt := match scrutinee {\n    ast.Var(x) => get(env, x) ?? st,\n    _ => st,\n  }\n  base := match binding {\n    Some(b) => {\n      mut copy := env\n      mut copy.insert(b, check.TAny)\n      copy\n    },\n    None => env,\n  }\n  // the variable an arm narrows: the `as` name, else the matched variable\n  target := match binding {\n    Some(b) => Some(b),\n    None => match scrutinee {\n      ast.Var(x) => Some(x),\n      _ => None,\n    },\n  }\n  for a in arms {\n    // an arm's own binding of the whole value has its declared type; a\n    // constructor's fields get their types\n    mut inner := check.bind_typed(mut i, base, a.pat, pt)\n    // in an arm naming variants, the matched variable is those variants,\n    // unless the arm assigns to it\n    match (target, check.arm_variants(i, a.pat, pt)) {\n      (Some(x), Some(v)) => if !check.assigns_to(a.body, x) {\n        mut inner.insert(x, v)\n      },\n      // a union's members an arm names (`Int =>`): the variable is them\n      (Some(x), None) => match check.arm_members(i, get(env, x) ?? st, a.pat) {\n        Some(v) => if !check.assigns_to(a.body, x) {\n          mut inner.insert(x, v)\n        },\n        None => (),\n      },\n      _ => (),\n    }\n    // an arm naming a refinement (`Positive =>`): the variable is of it there\n    held := i.written\n    match (target, a.pat) {\n      (Some(x), ast.CtorPattern { name: rn, args: ast.NoPats }) => if !check.assigns_to(a.body, x)\n        && check.named_refinement(i, rn) is Some {\n        mut i.written.insert(x, ast.Named { name: rn, args: [] })\n      },\n      _ => (),\n    }\n    // an arm that assigns to the matched variable sees its declared type\n    outer := i.exempt\n    match target {\n      Some(x) => if check.assigns_to(a.body, x) {\n        mut i.exempt.insert(x)\n      },\n      None => (),\n    }\n    match expected {\n      Some(r) => {\n        bt := check.infer(mut i, a.body, inner, Some(r))\n        check.expect(mut i, r, bt, \"match arm\")\n      },\n      None => check.infer(mut i, a.body, inner, None),\n    }\n    i.exempt = outer\n    i.written = held\n  }\n  // every value covered and no arm unreachable, on integers, floats,\n  // strings, lists, tuples and unions; `exhaustive` checks sums\n  w := match scrutinee {\n    ast.Var(x) => get(i.written, x),\n    ast.Call { callee: ast.Var(fname), .. } => match get(i.types.rets, fname) {\n      Some(rt) => match rt {\n        ast.Refined { .. } => Some(rt),\n        ast.Named { args: [], .. } => Some(rt),\n        _ => None,\n      },\n      None => None,\n    },\n    _ => None,\n  }\n  check.check_coverage(mut i, check.res(i, pt), arms, w)\n  // a call of one of the program's functions or methods giving a sum:\n  // covered here, with the variants it can give at this call\n  if this_call {\n    check.variants_covered(mut i, check.res(i, st), can_at, arms)\n  }\n  expected ?? check.TAny\n}","old_text":"fn infer_match(\n  mut i: check.Inf,\n  scrutinee: ast.Expr,\n  binding: Option[String],\n  arms: List[ast.Arm],\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  st := check.infer(mut i, scrutinee, env, None)\n  // what the call matched on can give, read before the arms make calls\n  can_at := match (scrutinee, i.last_call) {\n    (ast.Call { callee: ast.Var(f), .. }, (lf, vs, u)) => if lf == f && len(vs) > 0 {\n      Some((vs, u))\n    } else {\n      None\n    },\n    _ => None,\n  }\n  // narrowing drops variants, never type arguments: patterns can use the\n  // matched variable's declared type\n  pt := match scrutinee {\n    ast.Var(x) => get(env, x) ?? st,\n    _ => st,\n  }\n  base := match binding {\n    Some(b) => {\n      mut copy := env\n      mut copy.insert(b, check.TAny)\n      copy\n    },\n    None => env,\n  }\n  // the variable an arm narrows: the `as` name, else the matched variable\n  target := match binding {\n    Some(b) => Some(b),\n    None => match scrutinee {\n      ast.Var(x) => Some(x),\n      _ => None,\n    },\n  }\n  for a in arms {\n    // an arm's own binding of the whole value has its declared type; a\n    // constructor's fields get their types\n    mut inner := check.bind_typed(mut i, base, a.pat, pt)\n    // in an arm naming variants, the matched variable is those variants,\n    // unless the arm assigns to it\n    match (target, check.arm_variants(i, a.pat)) {\n      (Some(x), Some(v)) => if !check.assigns_to(a.body, x) {\n        mut inner.insert(x, v)\n      },\n      // a union's members an arm names (`Int =>`): the variable is them\n      (Some(x), None) => match check.arm_members(i, get(env, x) ?? st, a.pat) {\n        Some(v) => if !check.assigns_to(a.body, x) {\n          mut inner.insert(x, v)\n        },\n        None => (),\n      },\n      _ => (),\n    }\n    // an arm naming a refinement (`Positive =>`): the variable is of it there\n    held := i.written\n    match (target, a.pat) {\n      (Some(x), ast.CtorPattern { name: rn, args: ast.NoPats }) => if !check.assigns_to(a.body, x)\n        && check.named_refinement(i, rn) is Some {\n        mut i.written.insert(x, ast.Named { name: rn, args: [] })\n      },\n      _ => (),\n    }\n    // an arm that assigns to the matched variable sees its declared type\n    outer := i.exempt\n    match target {\n      Some(x) => if check.assigns_to(a.body, x) {\n        mut i.exempt.insert(x)\n      },\n      None => (),\n    }\n    match expected {\n      Some(r) => {\n        bt := check.infer(mut i, a.body, inner, Some(r))\n        check.expect(mut i, r, bt, \"match arm\")\n      },\n      None => check.infer(mut i, a.body, inner, None),\n    }\n    i.exempt = outer\n    i.written = held\n  }\n  // every value covered and no arm unreachable, on integers, floats,\n  // strings, lists, tuples and unions; `exhaustive` checks sums\n  w := match scrutinee {\n    ast.Var(x) => get(i.written, x),\n    ast.Call { callee: ast.Var(fname), .. } => match get(i.types.rets, fname) {\n      Some(rt) => match rt {\n        ast.Refined { .. } => Some(rt),\n        ast.Named { args: [], .. } => Some(rt),\n        _ => None,\n      },\n      None => None,\n    },\n    _ => None,\n  }\n  check.check_coverage(mut i, check.res(i, pt), arms, w)\n  // a call of one of the program's functions giving a sum: covered here,\n  // with the variants it can give at this call\n  match scrutinee {\n    ast.Call { callee: ast.Var(f), .. } => if !contains(env, f) && get(i.fns, f) is Some {\n      check.variants_covered(mut i, check.res(i, st), can_at, arms)\n    },\n    _ => (),\n  }\n  expected ?? check.TAny\n}"},{"name":"check.types_of","kind":"fn","old":"fcdf0bbc32ff2dc6","new":"1456b11ae0836fc7","interface_changed":false,"affected":[],"module":"check","text":"/// The program's record and sum types the checker models, by the names the\n/// stored form uses.\npub fn types_of(decls: List[ast.Decl]) -> check.Types {\n  // `Option` and `Result` come with the language\n  mut named := Dict[String, List[String]] { \"Option\": [\"T\"], \"Result\": [\"T\", \"E\"], \"Dict\": [\"K\", \"V\"], \"Set\": [\"A\"], \"Task\": [\"T\"], \"Sender\": [\"T\"], \"Receiver\": [\"T\"] }\n  mut sums := Set[String] { \"Option\", \"Result\" }\n  mut traits := Set[String] {}\n  for d in decls {\n    match d.kind {\n      // a capability's too, like `Console`: its methods' types are checked\n      ast.TraitDef(t) => if len(t.params) == 0 {\n        mut traits.insert(check.qualified(d.module, t.name))\n      },\n      _ => (),\n    }\n  }\n  mut aliases := Dict[String, ast.TypeExpr] {}\n  mut refinements := Dict[String, (ast.TypeExpr, ast.Expr)] {}\n  mut rets := Dict[String, ast.TypeExpr] {}\n  mut mut_written := Dict[String, List[Option[ast.TypeExpr]]] {}\n  mut narrows := Dict[String, (List[String], List[ast.Expr])] {}\n  // a trait's methods' facts, which hold of every implementation\n  mut trait_facts := Dict[String, List[ast.Expr]] {}\n  for d in decls {\n    match d.kind {\n      ast.TraitDef(t) => {\n        for tm in t.methods {\n          facts := walk.result_facts(tm.decl)\n          if walk.says_variant_of_it(facts) {\n            k := check.qualified(d.module, t.name) + \".\" + tm.decl.name\n            mut trait_facts.insert(k, facts)\n            mut narrows.insert(\n              k,\n              (tm.decl.params.map(p -> p.name), facts),\n            )\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      // an `impl`'s methods, by `Type.m` as the checker finds them, with\n      // their trait's facts\n      ast.ImplDef(im) => {\n        head := check.type_head(im.for_type)\n        q := if contains(head, \".\") {\n          head\n        } else {\n          check.qualified(d.module, head)\n        }\n        for f in im.methods {\n          inherited := if im.trait_name == \"\" {\n            []\n          } else {\n            get(trait_facts, im.trait_name + \".\" + f.name) or {\n              get(\n                trait_facts,\n                check.qualified(d.module, im.trait_name)\n                  + \".\"\n                  + f.name,\n              ) ?? []\n            }\n          }\n          facts := walk.result_facts(f) + inherited\n          if walk.says_variant_of_it(facts) {\n            mut narrows.insert(\n              q + \".\" + f.name,\n              (f.params.map(p -> p.name), facts),\n            )\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => if !t.distinct && len(t.params) == 0 {\n        match (t.body, t.refinement) {\n          (ast.Alias(a), Some(pred)) => mut refinements.insert(\n            check.qualified(d.module, t.name),\n            (a, pred),\n          ),\n          _ => (),\n        }\n      },\n      ast.FnDef(f) => {\n        mut rets.insert(check.qualified(d.module, f.name), f.ret)\n        facts := walk.result_facts(f)\n        if walk.says_variant_of_it(facts) {\n          mut narrows.insert(\n            check.qualified(d.module, f.name),\n            (f.params.map(p -> p.name), facts),\n          )\n        }\n        mut mut_written.insert(\n          check.qualified(d.module, f.name),\n          f.params.map(\n            p -> if p.mutable {\n              Some(p.ty)\n            } else {\n              None\n            },\n          ),\n        )\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      // an alias, refined or not, is the type it stands for. A record or a sum,\n      // refined or not, is a type of its own; its refinement is verify's, and\n      // its fields are checked as an unrefined one's are.\n      ast.TypeDef(t) => if !t.distinct {\n        q := check.qualified(d.module, t.name)\n        match t.body {\n          ast.Alias(a) => if len(t.params) == 0 {\n            mut aliases.insert(q, a)\n          },\n          ast.RecordBody(_) => mut named.insert(q, t.params),\n          ast.SumBody(vs) => if !vs.any(v -> v.payload is ast.MemberType) {\n            mut named.insert(q, t.params)\n            mut sums.insert(q)\n          },\n        }\n      } else if t.distinct {\n        // a `distinct` type: a type of its own, made of one field, `value`\n        mut named.insert(check.qualified(d.module, t.name), t.params)\n      },\n      _ => (),\n    }\n  }\n  mut ctors := Dict[String, check.Shape] { \"Some\": check.Shape {\n    owner: \"Option\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"None\": check.Shape {\n    owner: \"Option\",\n    fields: [],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"Ok\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  }, \"Err\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"E\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  } }\n  partial := check.Types {\n    named,\n    sums,\n    ctors: Dict[String, check.Shape] {},\n    aliases,\n    traits,\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => {\n        q := check.qualified(d.module, t.name)\n        if contains(named, q) {\n          tps := set(t.params)\n          match t.body {\n            ast.RecordBody(fs) => mut ctors.insert(\n              q,\n              check.Shape {\n                owner: q,\n                fields: fs.map(\n                  f -> (f.name, check.lower(partial, tps, f.ty)),\n                ),\n                positional: false,\n                required: check.required(fs),\n                params: t.params,\n              },\n            ),\n            ast.SumBody(vs) => {\n              for v in vs {\n                sh := match v.payload {\n                  ast.Positional(ts) => check.Shape {\n                    owner: q,\n                    fields: ts.map(x -> (\"\", check.lower(partial, tps, x))),\n                    positional: true,\n                    required: [],\n                    params: t.params,\n                  },\n                  ast.RecordPayload(fs) => check.Shape {\n                    owner: q,\n                    fields: fs.map(\n                      f -> (f.name, check.lower(partial, tps, f.ty)),\n                    ),\n                    positional: false,\n                    required: check.required(fs),\n                    params: t.params,\n                  },\n                  _ => check.Shape {\n                    owner: q,\n                    fields: [],\n                    positional: true,\n                    required: [],\n                    params: t.params,\n                  },\n                }\n                mut ctors.insert(check.qualified(d.module, v.name), sh)\n              }\n            },\n            ast.Alias(a) => if t.distinct {\n              mut ctors.insert(\n                q,\n                check.Shape {\n                  owner: q,\n                  fields: [(\"value\", check.lower(partial, tps, a))],\n                  positional: true,\n                  required: [],\n                  params: t.params,\n                },\n              )\n            },\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  mut variants := Dict[String, List[String]] {}\n  for (c, sh) in ctors {\n    if contains(sums, sh.owner) {\n      mut variants.insert(\n        sh.owner,\n        (get(variants, sh.owner) ?? []) + [c],\n      )\n    }\n  }\n  check.Types {\n    named,\n    sums,\n    ctors,\n    aliases,\n    traits,\n    refinements,\n    rets,\n    mut_written,\n    variants,\n    narrows,\n  }\n}","old_text":"/// The program's record and sum types the checker models, by the names the\n/// stored form uses.\npub fn types_of(decls: List[ast.Decl]) -> check.Types {\n  // `Option` and `Result` come with the language\n  mut named := Dict[String, List[String]] { \"Option\": [\"T\"], \"Result\": [\"T\", \"E\"], \"Dict\": [\"K\", \"V\"], \"Set\": [\"A\"], \"Task\": [\"T\"], \"Sender\": [\"T\"], \"Receiver\": [\"T\"] }\n  mut sums := Set[String] { \"Option\", \"Result\" }\n  mut traits := Set[String] {}\n  for d in decls {\n    match d.kind {\n      // a capability's too, like `Console`: its methods' types are checked\n      ast.TraitDef(t) => if len(t.params) == 0 {\n        mut traits.insert(check.qualified(d.module, t.name))\n      },\n      _ => (),\n    }\n  }\n  mut aliases := Dict[String, ast.TypeExpr] {}\n  mut refinements := Dict[String, (ast.TypeExpr, ast.Expr)] {}\n  mut rets := Dict[String, ast.TypeExpr] {}\n  mut mut_written := Dict[String, List[Option[ast.TypeExpr]]] {}\n  mut narrows := Dict[String, (List[String], List[ast.Expr])] {}\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => if !t.distinct && len(t.params) == 0 {\n        match (t.body, t.refinement) {\n          (ast.Alias(a), Some(pred)) => mut refinements.insert(\n            check.qualified(d.module, t.name),\n            (a, pred),\n          ),\n          _ => (),\n        }\n      },\n      ast.FnDef(f) => {\n        mut rets.insert(check.qualified(d.module, f.name), f.ret)\n        facts := walk.result_facts(f)\n        if walk.says_variant_of_it(facts) {\n          mut narrows.insert(\n            check.qualified(d.module, f.name),\n            (f.params.map(p -> p.name), facts),\n          )\n        }\n        mut mut_written.insert(\n          check.qualified(d.module, f.name),\n          f.params.map(\n            p -> if p.mutable {\n              Some(p.ty)\n            } else {\n              None\n            },\n          ),\n        )\n      },\n      _ => (),\n    }\n  }\n  for d in decls {\n    match d.kind {\n      // an alias, refined or not, is the type it stands for. A record or a sum,\n      // refined or not, is a type of its own; its refinement is verify's, and\n      // its fields are checked as an unrefined one's are.\n      ast.TypeDef(t) => if !t.distinct {\n        q := check.qualified(d.module, t.name)\n        match t.body {\n          ast.Alias(a) => if len(t.params) == 0 {\n            mut aliases.insert(q, a)\n          },\n          ast.RecordBody(_) => mut named.insert(q, t.params),\n          ast.SumBody(vs) => if !vs.any(v -> v.payload is ast.MemberType) {\n            mut named.insert(q, t.params)\n            mut sums.insert(q)\n          },\n        }\n      } else if t.distinct {\n        // a `distinct` type: a type of its own, made of one field, `value`\n        mut named.insert(check.qualified(d.module, t.name), t.params)\n      },\n      _ => (),\n    }\n  }\n  mut ctors := Dict[String, check.Shape] { \"Some\": check.Shape {\n    owner: \"Option\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"None\": check.Shape {\n    owner: \"Option\",\n    fields: [],\n    positional: true,\n    required: [],\n    params: [\"T\"],\n  }, \"Ok\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"T\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  }, \"Err\": check.Shape {\n    owner: \"Result\",\n    fields: [(\"\", check.TGen(\"E\"))],\n    positional: true,\n    required: [],\n    params: [\"T\", \"E\"],\n  } }\n  partial := check.Types {\n    named,\n    sums,\n    ctors: Dict[String, check.Shape] {},\n    aliases,\n    traits,\n  }\n  for d in decls {\n    match d.kind {\n      ast.TypeDef(t) => {\n        q := check.qualified(d.module, t.name)\n        if contains(named, q) {\n          tps := set(t.params)\n          match t.body {\n            ast.RecordBody(fs) => mut ctors.insert(\n              q,\n              check.Shape {\n                owner: q,\n                fields: fs.map(\n                  f -> (f.name, check.lower(partial, tps, f.ty)),\n                ),\n                positional: false,\n                required: check.required(fs),\n                params: t.params,\n              },\n            ),\n            ast.SumBody(vs) => {\n              for v in vs {\n                sh := match v.payload {\n                  ast.Positional(ts) => check.Shape {\n                    owner: q,\n                    fields: ts.map(x -> (\"\", check.lower(partial, tps, x))),\n                    positional: true,\n                    required: [],\n                    params: t.params,\n                  },\n                  ast.RecordPayload(fs) => check.Shape {\n                    owner: q,\n                    fields: fs.map(\n                      f -> (f.name, check.lower(partial, tps, f.ty)),\n                    ),\n                    positional: false,\n                    required: check.required(fs),\n                    params: t.params,\n                  },\n                  _ => check.Shape {\n                    owner: q,\n                    fields: [],\n                    positional: true,\n                    required: [],\n                    params: t.params,\n                  },\n                }\n                mut ctors.insert(check.qualified(d.module, v.name), sh)\n              }\n            },\n            ast.Alias(a) => if t.distinct {\n              mut ctors.insert(\n                q,\n                check.Shape {\n                  owner: q,\n                  fields: [(\"value\", check.lower(partial, tps, a))],\n                  positional: true,\n                  required: [],\n                  params: t.params,\n                },\n              )\n            },\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  mut variants := Dict[String, List[String]] {}\n  for (c, sh) in ctors {\n    if contains(sums, sh.owner) {\n      mut variants.insert(\n        sh.owner,\n        (get(variants, sh.owner) ?? []) + [c],\n      )\n    }\n  }\n  check.Types {\n    named,\n    sums,\n    ctors,\n    aliases,\n    traits,\n    refinements,\n    rets,\n    mut_written,\n    variants,\n    narrows,\n  }\n}"},{"name":"check.infer_method","kind":"fn","old":"88c143c2c71080cf","new":"4007a6094f848df1","interface_changed":false,"affected":[],"module":"check","text":"/// A call `recv.m(args)`: a method of the receiver's type, or one of the\n/// program's functions or a built-in with the receiver as its first\n/// argument. Other calls (std's methods, closures) are not modelled.\n/// `marked`: written `mut recv.m(..)`.\nfn infer_method(\n  mut i: check.Inf,\n  recv: ast.Expr,\n  m: String,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n  marked: Bool,\n) -> check.Ty {\n  seq := i.call_seq\n  i.call_seq += 1\n  // `Item.new(..)`, `T.zero()`: a method called on a type\n  match recv {\n    ast.CtorExpr { name: tn, args: ast.NoArgs } => if contains(i.types.named, tn)\n      || contains(i.tparams, tn)\n      || [\"Int\", \"Float\", \"Bool\", \"String\"].contains(tn) {\n      mut i.recvs.push((m, check.TNamed { name: tn, args: [] }))\n      return check.static_call(mut i, tn, m, args, env)\n    },\n    // a type with its arguments as the receiver, as `derive` writes it:\n    // `{ $type: List[Int] := (); $type }.from_json_at(..)`\n    ast.Block { stmts: [ast.Let { pat: ast.Bind(\"$type\"), ty: Some(t), value: ast.UnitExpr }], last: ast.Var(\"$type\") } => return check.static_call(mut i, check.type_head(t), m, args, env),\n    _ => (),\n  }\n  rt := check.infer(mut i, recv, env, None)\n  mut i.recvs.push((m, rt))\n  // two traits with `m`, and nothing to choose between them\n  match check.ambiguity(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `s.bigger(t)` with `bigger(self, other: Self)` on a trait value\n  check.self_args(mut i, recv, check.res(i, rt), m, args)\n  // a code trait's method on a type that isn't one (`fold` of an iterator\n  // that may not end), or whose `impl` asks more of its arguments\n  match check.code_method_problem(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `xs.to_list()` of what is a list already (`s.code_points()`, a\n  // comprehension over one) is itself\n  match check.res(i, rt) {\n    check.TList(_) => if m == \"to_list\" && len(args) == 0 {\n      return rt\n    },\n    _ => (),\n  }\n  // a value narrowed to some variants has its sum's methods\n  rt_whole := check.widened(check.res(i, rt))\n  own := match rt_whole {\n    // a generic `impl`'s parameters are the receiver's type arguments\n    check.TNamed { name, args } => match get(i.methods.of, name + \".\" + m) {\n      Some(t) => Some(check.inst(\n        t,\n        check.pairs(\n          get(i.methods.params, name + \".\" + m) ?? [],\n          args,\n        ),\n      )),\n      None => match check.code_trait_method(i, name, m, rt_whole) {\n        Some(t) => Some(t),\n        // a method a trait it implements provides (`to_json` of a type deriving\n        // `Json`)\n        None => check.provided_method(i, name, m, rt_whole),\n      },\n    },\n    // `xs.iter()`: a list's method of core's code traits\n    check.TList(_) => check.code_trait_method(i, \"List\", m, check.res(i, rt)),\n    // `s.bytes()`, `s.graphemes()`: a string's methods of code traits\n    check.TStr => check.string_method(i, m),\n    // `x.m()` with `x: T` and `T: Tr`: the trait's method, `Self` being `T`\n    check.TGen(p) => check.bound_method(i, p, m),\n    // a trait value: the trait's method\n    check.TTrait(tr) => check.trait_method(i, tr, m, check.TTrait(tr), 8),\n    _ => None,\n  }\n  // a method of one of the program's types that changes its receiver\n  // (`mut self`) is called `mut recv.m(..)`, and only such a method is\n  // called so\n  match check.res(i, rt) {\n    check.TNamed { name, .. } => if check.program_type(i, name)\n      && contains(i.methods.self_methods, name + \".\" + m) {\n      changes := contains(i.methods.mut_self, name + \".\" + m)\n      shown := text.expr_text(recv, 0)\n      if changes && !marked {\n        check.error(mut i, \"`\"\n          + m\n          + \"` changes its receiver (`mut self`): write `mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)` to show that `\"\n          + shown\n          + \"` may change\")\n      } else if marked && !changes {\n        check.error(mut i, \"`mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)`: `\"\n          + m\n          + \"` doesn't change its receiver (it doesn't take `mut self`)\")\n      }\n    },\n    _ => (),\n  }\n  // `.to_list()` of what the checker types as a list (a comprehension or a\n  // built-in over a string's code points) is the list\n  if m == \"to_list\"\n    && len(args) == 0\n    && check.res(i, rt) is check.TList {\n    return check.res(i, rt)\n  }\n  // `x.f(..)` with `f` a built-in function is `f(x, ..)`, on a list even\n  // when a trait has a method of that name (`xs.map(f)`)\n  if own is None\n    && check.known(check.res(i, rt))\n    && !contains(env, m)\n    && (!contains(i.methods.names, m)\n      || check.res(i, rt) is check.TList\n      || check.is_table(check.res(i, rt)))\n    && get(i.fns, m) is None {\n    match get(i.builtins, m) {\n      Some(bs) => {\n        check.changing_call(mut i, recv, m, bs, marked)\n        return check.builtin_call(mut i, m, bs, [rt], args, env)\n      },\n      None => (),\n    }\n  }\n  sig := match own {\n    Some(t) => Some(t),\n    // a receiver of a type not known may have a method of that name, such as\n    // one of std's types\n    None => if !check.known(check.res(i, rt))\n      || contains(env, m)\n      || contains(i.methods.names, m)\n      || contains(i.builtins, m) {\n      None\n    } else {\n      get(i.fns, m)\n    },\n  }\n  match sig {\n    Some(t) => {\n      ft := check.inst(\n        t,\n        check.fresh_for(\n          mut i,\n          to_list(check.gens(t, Set[String] {})),\n        ),\n      )\n      match ft {\n        check.TFn { params, ret } => {\n          what := \"call to `\" + m + \"`\"\n          if len(params) != len(args) + 1 {\n            check.error(mut i, what\n              + \": expects \"\n              + to_string(len(params))\n              + \" arguments, got \"\n              + to_string(len(args) + 1))\n            return ret\n          }\n          check.expect(\n            mut i,\n            get(params, 0) ?? check.TAny,\n            rt,\n            what + \", argument 1\",\n          )\n          mut arg_types := [rt]\n          for (k, a) in enumerate(args) {\n            p := get(params, k + 1) ?? check.TAny\n            at := check.listed_arg(\n              mut i,\n              m,\n              k,\n              a,\n              p,\n              check.infer(mut i, a, env, Some(p)),\n              what,\n            )\n            mut arg_types.push(at)\n            check.expect(\n              mut i,\n              p,\n              at,\n              what + \", argument \" + to_string(k + 2),\n            )\n          }\n          // a method's result, narrowed by what it (or its trait) says of it\n          key := check.method_facts_key(i, check.res(i, rt), m)\n          i.last_call = match check.narrowed_at(i, key, arg_types, ret) {\n            Some((_, _, left, u)) => (seq, key, to_list(left).sorted(), u),\n            None => (seq, key, [], false),\n          }\n          check.narrowed_result(i, key, arg_types, ret)\n        },\n        _ => check.TAny,\n      }\n    },\n    None => {\n      // a method no `impl`, trait or function has, on one of the program's\n      // types the checker sees every method of\n      match check.res(i, rt) {\n        check.TNamed { name, .. } => if check.program_type(i, name)\n          && !contains(i.methods.foreign, name)\n          && !contains(env, m)\n          && !contains(i.methods.names, m)\n          && get(i.fns, m) is None\n          && get(i.builtins, m) is None {\n          check.error(mut i, \"unknown function `\" + m + \"`\")\n        },\n        _ => (),\n      }\n      // `true.price()`: a method of one of the file's traits, on a value of a\n      // basic or program type, which must implement it\n      match check.res(i, rt) {\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TNamed { .. } => if !contains(env, m) {\n          match check.own_trait_of(i, m) {\n            Some(tr) => mut i.pending.push((rt, tr, m)),\n            None => (),\n          }\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}","old_text":"/// A call `recv.m(args)`: a method of the receiver's type, or one of the\n/// program's functions or a built-in with the receiver as its first\n/// argument. Other calls (std's methods, closures) are not modelled.\n/// `marked`: written `mut recv.m(..)`.\nfn infer_method(\n  mut i: check.Inf,\n  recv: ast.Expr,\n  m: String,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n  marked: Bool,\n) -> check.Ty {\n  // `Item.new(..)`, `T.zero()`: a method called on a type\n  match recv {\n    ast.CtorExpr { name: tn, args: ast.NoArgs } => if contains(i.types.named, tn)\n      || contains(i.tparams, tn)\n      || [\"Int\", \"Float\", \"Bool\", \"String\"].contains(tn) {\n      mut i.recvs.push((m, check.TNamed { name: tn, args: [] }))\n      return check.static_call(mut i, tn, m, args, env)\n    },\n    // a type with its arguments as the receiver, as `derive` writes it:\n    // `{ $type: List[Int] := (); $type }.from_json_at(..)`\n    ast.Block { stmts: [ast.Let { pat: ast.Bind(\"$type\"), ty: Some(t), value: ast.UnitExpr }], last: ast.Var(\"$type\") } => return check.static_call(mut i, check.type_head(t), m, args, env),\n    _ => (),\n  }\n  rt := check.infer(mut i, recv, env, None)\n  mut i.recvs.push((m, rt))\n  // two traits with `m`, and nothing to choose between them\n  match check.ambiguity(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `s.bigger(t)` with `bigger(self, other: Self)` on a trait value\n  check.self_args(mut i, recv, check.res(i, rt), m, args)\n  // a code trait's method on a type that isn't one (`fold` of an iterator\n  // that may not end), or whose `impl` asks more of its arguments\n  match check.code_method_problem(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `xs.to_list()` of what is a list already (`s.code_points()`, a\n  // comprehension over one) is itself\n  match check.res(i, rt) {\n    check.TList(_) => if m == \"to_list\" && len(args) == 0 {\n      return rt\n    },\n    _ => (),\n  }\n  own := match check.res(i, rt) {\n    // a generic `impl`'s parameters are the receiver's type arguments\n    check.TNamed { name, args } => match get(i.methods.of, name + \".\" + m) {\n      Some(t) => Some(check.inst(\n        t,\n        check.pairs(\n          get(i.methods.params, name + \".\" + m) ?? [],\n          args,\n        ),\n      )),\n      None => match check.code_trait_method(i, name, m, check.res(i, rt)) {\n        Some(t) => Some(t),\n        // a method a trait it implements provides (`to_json` of a type deriving\n        // `Json`)\n        None => check.provided_method(i, name, m, check.res(i, rt)),\n      },\n    },\n    // `xs.iter()`: a list's method of core's code traits\n    check.TList(_) => check.code_trait_method(i, \"List\", m, check.res(i, rt)),\n    // `s.bytes()`, `s.graphemes()`: a string's methods of code traits\n    check.TStr => check.string_method(i, m),\n    // `x.m()` with `x: T` and `T: Tr`: the trait's method, `Self` being `T`\n    check.TGen(p) => check.bound_method(i, p, m),\n    // a trait value: the trait's method\n    check.TTrait(tr) => check.trait_method(i, tr, m, check.TTrait(tr), 8),\n    _ => None,\n  }\n  // a method of one of the program's types that changes its receiver\n  // (`mut self`) is called `mut recv.m(..)`, and only such a method is\n  // called so\n  match check.res(i, rt) {\n    check.TNamed { name, .. } => if check.program_type(i, name)\n      && contains(i.methods.self_methods, name + \".\" + m) {\n      changes := contains(i.methods.mut_self, name + \".\" + m)\n      shown := text.expr_text(recv, 0)\n      if changes && !marked {\n        check.error(mut i, \"`\"\n          + m\n          + \"` changes its receiver (`mut self`): write `mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)` to show that `\"\n          + shown\n          + \"` may change\")\n      } else if marked && !changes {\n        check.error(mut i, \"`mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)`: `\"\n          + m\n          + \"` doesn't change its receiver (it doesn't take `mut self`)\")\n      }\n    },\n    _ => (),\n  }\n  // `.to_list()` of what the checker types as a list (a comprehension or a\n  // built-in over a string's code points) is the list\n  if m == \"to_list\"\n    && len(args) == 0\n    && check.res(i, rt) is check.TList {\n    return check.res(i, rt)\n  }\n  // `x.f(..)` with `f` a built-in function is `f(x, ..)`, on a list even\n  // when a trait has a method of that name (`xs.map(f)`)\n  if own is None\n    && check.known(check.res(i, rt))\n    && !contains(env, m)\n    && (!contains(i.methods.names, m)\n      || check.res(i, rt) is check.TList\n      || check.is_table(check.res(i, rt)))\n    && get(i.fns, m) is None {\n    match get(i.builtins, m) {\n      Some(bs) => {\n        check.changing_call(mut i, recv, m, bs, marked)\n        return check.builtin_call(mut i, m, bs, [rt], args, env)\n      },\n      None => (),\n    }\n  }\n  sig := match own {\n    Some(t) => Some(t),\n    // a receiver of a type not known may have a method of that name, such as\n    // one of std's types\n    None => if !check.known(check.res(i, rt))\n      || contains(env, m)\n      || contains(i.methods.names, m)\n      || contains(i.builtins, m) {\n      None\n    } else {\n      get(i.fns, m)\n    },\n  }\n  match sig {\n    Some(t) => {\n      ft := check.inst(\n        t,\n        check.fresh_for(\n          mut i,\n          to_list(check.gens(t, Set[String] {})),\n        ),\n      )\n      match ft {\n        check.TFn { params, ret } => {\n          what := \"call to `\" + m + \"`\"\n          if len(params) != len(args) + 1 {\n            check.error(mut i, what\n              + \": expects \"\n              + to_string(len(params))\n              + \" arguments, got \"\n              + to_string(len(args) + 1))\n            return ret\n          }\n          check.expect(\n            mut i,\n            get(params, 0) ?? check.TAny,\n            rt,\n            what + \", argument 1\",\n          )\n          for (k, a) in enumerate(args) {\n            p := get(params, k + 1) ?? check.TAny\n            at := check.listed_arg(\n              mut i,\n              m,\n              k,\n              a,\n              p,\n              check.infer(mut i, a, env, Some(p)),\n              what,\n            )\n            check.expect(\n              mut i,\n              p,\n              at,\n              what + \", argument \" + to_string(k + 2),\n            )\n          }\n          ret\n        },\n        _ => check.TAny,\n      }\n    },\n    None => {\n      // a method no `impl`, trait or function has, on one of the program's\n      // types the checker sees every method of\n      match check.res(i, rt) {\n        check.TNamed { name, .. } => if check.program_type(i, name)\n          && !contains(i.methods.foreign, name)\n          && !contains(env, m)\n          && !contains(i.methods.names, m)\n          && get(i.fns, m) is None\n          && get(i.builtins, m) is None {\n          check.error(mut i, \"unknown function `\" + m + \"`\")\n        },\n        _ => (),\n      }\n      // `true.price()`: a method of one of the file's traits, on a value of a\n      // basic or program type, which must implement it\n      match check.res(i, rt) {\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TNamed { .. } => if !contains(env, m) {\n          match check.own_trait_of(i, m) {\n            Some(tr) => mut i.pending.push((rt, tr, m)),\n            None => (),\n          }\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}"},{"name":"check.fits","kind":"fn","old":"a9b18c2990425ce1","new":"50fe08521cd269e3","interface_changed":false,"affected":[],"module":"check","text":"/// A value of type `got` can go where `want` is asked for: the same type\n/// (binding type variables), or variants of the sum asked for.\nfn fits(mut i: check.Inf, want: check.Ty, got: check.Ty) -> Bool {\n  match (check.res(i, want), check.res(i, got)) {\n    (check.TNamed { name: w, args: wa }, check.TVariants { owner, args: ga, .. }) => w == owner\n      && check.fits(\n        mut i,\n        check.TNamed { name: w, args: wa },\n        check.TNamed { name: owner, args: ga },\n      ),\n    (check.TVariants { owner: w, names: ws, args: wa }, check.TVariants { owner, names, args: ga }) => w == owner\n      && names.all(n -> ws.contains(n))\n      && check.fits(\n        mut i,\n        check.TNamed { name: w, args: wa },\n        check.TNamed { name: owner, args: ga },\n      ),\n    // a union holds its members, and the members of a smaller union\n    (check.TUnion(ws), check.TUnion(gs)) => gs.all(g -> check.member_of(ws, g)),\n    (check.TUnion(ws), g) => check.member_of(ws, g),\n    // values are never shared, so a `List[Circle]` reads as a `List[Shape]`:\n    // type arguments fit member-wise (`call` holds a `mut` parameter to the\n    // exact type)\n    (check.TList(w), check.TList(g)) => check.fits(mut i, w, g),\n    // a finite iterator where a list is wanted (a field, an annotation, a\n    // result) is the list it holds (codegen's `converted` calls `to_list`)\n    (check.TList(_), check.TNamed { .. }) => if check.implements(i, check.res(i, got), \"FiniteIterator\") {\n      match check.trait_method(\n        i,\n        \"FiniteIterator\",\n        \"to_list\",\n        check.res(i, got),\n        8,\n      ) {\n        Some(check.TFn { ret, .. }) => check.fits(mut i, want, ret),\n        _ => false,\n      }\n    } else {\n      check.unify(mut i, want, got, 100)\n    },\n    (check.TNamed { name: n, args: was }, check.TNamed { name: m, args: gas }) => if n == m && len(was) == len(gas) && len(was) > 0 {\n      mut ok := true\n      mut k := 0\n      while k < len(was) {\n        ok = ok && check.fits(mut i, was[k], gas[k])\n        k += 1\n      }\n      ok\n    } else {\n      check.unify(mut i, want, got, 100)\n    },\n    _ => check.unify(mut i, want, got, 100),\n  }\n}","old_text":"/// A value of type `got` can go where `want` is asked for: the same type\n/// (binding type variables), or variants of the sum asked for.\nfn fits(mut i: check.Inf, want: check.Ty, got: check.Ty) -> Bool {\n  match (check.res(i, want), check.res(i, got)) {\n    (check.TNamed { name: w, .. }, check.TVariants { owner, .. }) => w == owner,\n    (check.TVariants { owner: w, names: ws }, check.TVariants { owner, names }) => w == owner && names.all(n -> ws.contains(n)),\n    // a union holds its members, and the members of a smaller union\n    (check.TUnion(ws), check.TUnion(gs)) => gs.all(g -> check.member_of(ws, g)),\n    (check.TUnion(ws), g) => check.member_of(ws, g),\n    // values are never shared, so a `List[Circle]` reads as a `List[Shape]`:\n    // type arguments fit member-wise (`call` holds a `mut` parameter to the\n    // exact type)\n    (check.TList(w), check.TList(g)) => check.fits(mut i, w, g),\n    // a finite iterator where a list is wanted (a field, an annotation, a\n    // result) is the list it holds (codegen's `converted` calls `to_list`)\n    (check.TList(_), check.TNamed { .. }) => if check.implements(i, check.res(i, got), \"FiniteIterator\") {\n      match check.trait_method(\n        i,\n        \"FiniteIterator\",\n        \"to_list\",\n        check.res(i, got),\n        8,\n      ) {\n        Some(check.TFn { ret, .. }) => check.fits(mut i, want, ret),\n        _ => false,\n      }\n    } else {\n      check.unify(mut i, want, got, 100)\n    },\n    (check.TNamed { name: n, args: was }, check.TNamed { name: m, args: gas }) => if n == m && len(was) == len(gas) && len(was) > 0 {\n      mut ok := true\n      mut k := 0\n      while k < len(was) {\n        ok = ok && check.fits(mut i, was[k], gas[k])\n        k += 1\n      }\n      ok\n    } else {\n      check.unify(mut i, want, got, 100)\n    },\n    _ => check.unify(mut i, want, got, 100),\n  }\n}"},{"name":"check.arm_variants","kind":"fn","old":"275d03c219856b26","new":"322865ebbc66e4b2","interface_changed":true,"affected":["check.infer_match","check.infer_untagged","check.infer","check.infer_spread","check.infer_all","check.binary","check.infer_block","check.infer_call","check.infer_if","check.infer_list","check.infer_ctor","check.infer_lambda","check.infer_method","check.builtin_call","check.static_call","check.fn_inferred","check.task_body","check.default_errors","check.element_assigned","check.spread_method_params","check.spread_filled","check.iter_builtin","check.fn_errors","check.instantiated","check.fn_lambdas_typed","check.holes_of","check.mark_field_reads","check.own_methods_resolved","check.typed_one","check.decl_type_errors","check.spread_body","check.field_reads","eval_files","instantiated_files","check.lambdas_typed","holes_command","check_summary","finding.uses_of","rename_command","verified_decls","check.typed","check.type_errors_with","check.spreads_resolved","unused.members","command_line","check_command","finding.uses_from","finding.used_by_tree","finding.refs_command","verified_with","static_graph","codegen.new_gen","computed_value","repl_eval","check.type_errors","check_errors_in","literal_errors","expanded","unused.findings","main","strata_command","finding.uses_tree","verified_program","verify_file","build_command","graph_command","graph_diff","tour_graph","codegen.generate","codegen.read_back","comptime_value","repl_command","check_errors_with","edit_errors","literal_errors_of","codegen_with","with_base","unused_of","edit_unused","core_unused","codegen.entry","codegen.compiled_alone","eval.run","smt_file","termination_file","verify_command","build_proofs","alongside_command","search_invariants","diff_command","tour_command","core_rt_text","comptime_values","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","codegen_text","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","run_command","fix_loops","build_core_command","comptime_runner","package_errors","merge_file_command","merged_checks","call_command","edit_command","check_files","move_command","fix_command","edit_in_editor","codegen_file","jit_file","fuzz_file","graph_runs","replay","or_solver_inputs","program_objects","sync_command","check_fn","linked"],"module":"check","text":"/// The variants an arm's pattern names (`Sq(_)`, `Sq(_) | Dot`, `Some(x)`),\n/// all of one sum, with the type arguments of `t`, the matched value's\n/// type.\nfn arm_variants(i: check.Inf, p: ast.Pattern, t: check.Ty) -> Option[check.Ty] {\n  pats := match p {\n    ast.OrPat(ps) => ps,\n    _ => [p],\n  }\n  mut owner := \"\"\n  mut names := []\n  for q in pats {\n    match q {\n      ast.CtorPattern { name, .. } => match get(i.types.ctors, name) {\n        Some(sh) => {\n          if sh.owner == name\n            || !contains(i.types.sums, sh.owner)\n            || owner != \"\" && owner != sh.owner {\n            return None\n          }\n          owner = sh.owner\n          if !names.contains(name) {\n            mut names.push(name)\n          }\n        },\n        None => return None,\n      },\n      _ => return None,\n    }\n  }\n  if owner == \"\" {\n    return None\n  }\n  // the matched value's type arguments: the arm's variants keep them\n  targs := match check.sum_variants(i, t) {\n    Some((o, a, _)) => if o == owner {\n      a\n    } else {\n      return None\n    },\n    // a generic sum's arms without its arguments: not narrowed\n    None => match get(i.types.ctors, get(names, 0) ?? \"\") {\n      Some(sh) => if len(sh.params) > 0 {\n        return None\n      } else {\n        []\n      },\n      None => [],\n    },\n  }\n  Some(\n    check.TVariants { owner, names: names.sorted(), args: targs },\n  )\n}","old_text":"/// The variants an arm's pattern names (`Sq(_)`, `Sq(_) | Dot`), all of one\n/// sum without type parameters.\nfn arm_variants(i: check.Inf, p: ast.Pattern) -> Option[check.Ty] {\n  pats := match p {\n    ast.OrPat(ps) => ps,\n    _ => [p],\n  }\n  mut owner := \"\"\n  mut names := []\n  for q in pats {\n    match q {\n      ast.CtorPattern { name, .. } => match get(i.types.ctors, name) {\n        Some(sh) => {\n          if sh.owner == name\n            || len(sh.params) > 0\n            || !contains(i.types.sums, sh.owner)\n            || owner != \"\" && owner != sh.owner {\n            return None\n          }\n          owner = sh.owner\n          if !names.contains(name) {\n            mut names.push(name)\n          }\n        },\n        None => return None,\n      },\n      _ => return None,\n    }\n  }\n  if owner == \"\" {\n    return None\n  }\n  Some(check.TVariants { owner, names: names.sorted() })\n}"},{"name":"check.infer_untagged","kind":"fn","old":"91d723e72a0394ad","new":"31bc6adaebc2865e","interface_changed":false,"affected":[],"module":"check","text":"/// The type of `e`, where `expected` is the type its place asks for. The\n/// mismatches found go to `i.errs`, in the order found.\nfn infer_untagged(\n  mut i: check.Inf,\n  e: ast.Expr,\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  match e {\n    ast.IntLit(_) => check.int_literal(mut i, e, expected),\n    ast.BigIntLit(_) => check.int_literal(mut i, e, expected),\n    ast.FloatLit(_) => check.TFloat,\n    ast.StrLit(_) => check.TStr,\n    ast.BoolLit(_) => check.TBool,\n    ast.UnitExpr => check.TUnit,\n    // `env` holds declared types; a narrowed variable reads as a place\n    ast.Var(x) => match get(env, x) {\n      Some(t) => {\n        // a closure or `spawn` can't hold a handle from outside it\n        if contains(i.captured, x) && check.holds_task(check.res(i, t)) {\n          check.error(mut i, \"a closure or `spawn` can't hold `\"\n            + x\n            + \"`, a task's handle: await it where it was spawned\")\n        }\n        check.var_type(i, x, t)\n      },\n      None => match get(i.fns, x) {\n        // a function's type parameters: fresh at each use\n        Some(t) => check.inst(t, check.fresh_for(\n          mut i,\n          to_list(check.gens(t, Set[String] {})),\n        )),\n        None => check.trait_fn(mut i, x),\n      },\n    },\n    ast.Interp(parts) => {\n      for p in parts {\n        match p {\n          ast.ValuePart { value, spec } => {\n            t := check.listed_arg(\n              mut i,\n              \"$interp\",\n              0,\n              value,\n              check.TList(check.TAny),\n              check.infer(mut i, value, env, None),\n              \"interpolation\",\n            )\n            match spec {\n              Some(f) => check.check_spec(mut i, f, t),\n              None => (),\n            }\n          },\n          ast.TextPart(_) => (),\n        }\n      }\n      check.TStr\n    },\n    ast.Binary { op, left, right } => check.binary(mut i, op, left, right, env, expected),\n    // a negative literal of a sized type (`-2^63`, beyond 64 bits once negated)\n    ast.Unary { op, operand } => if op == ast.Neg\n      && check.is_int_lit(operand)\n      && check.sized_expected(i, expected) is Some {\n      _ := check.infer(mut i, operand, env, None)\n      check.int_literal(mut i, e, expected)\n    } else {\n      t := check.infer(mut i, operand, env, None)\n      if op == ast.Neg && !check.is_int_lit(operand) {\n        mut i.arith.push((\"-\", t))\n      }\n      match op {\n        ast.Neg => {\n          match check.res(i, t) {\n            check.TInt | check.TFloat | check.TAny => (),\n            check.TNamed { name, args } => if !(len(args) == 0 && check.is_sized(name)) {\n              check.error(\n                mut i,\n                \"operand of `-` must be Int or Float, found `\"\n                  + (check.shown(check.res(i, t)) ?? name)\n                  + \"`\",\n              )\n            },\n            check.TVar(_) => check.expect(mut i, check.TInt, t, \"operand of `-`\"),\n            other => match check.shown(other) {\n              Some(s) => check.error(\n                mut i,\n                \"operand of `-` must be Int or Float, found `\"\n                  + s\n                  + \"`\",\n              ),\n              None => (),\n            },\n          }\n          t\n        },\n        ast.Not => {\n          check.expect(mut i, check.TBool, t, \"operand of `!`\")\n          check.TBool\n        },\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => check.infer_if(mut i, cond, then, otherwise, env, expected),\n    ast.Block { stmts, last } => check.infer_block(mut i, stmts, last, env, expected),\n    ast.Call { callee, args } => check.infer_call(mut i, callee, args, env),\n    ast.ListExpr(es) => check.infer_list(mut i, es, env, expected),\n    ast.MatchExpr { scrutinee, binding, arms } => check.infer_match(\n      mut i,\n      scrutinee,\n      binding,\n      arms,\n      env,\n      expected,\n    ),\n    ast.Lambda { params, body } => check.infer_lambda(mut i, params, body, env, expected),\n    ast.Return(x) => {\n      r := i.ret\n      if check.outside_fn(check.res(i, r)) {\n        check.error(mut i, \"`return` outside a function\")\n        _ := check.infer(mut i, x, env, None)\n      } else {\n        t := check.infer(mut i, x, env, Some(r))\n        check.expect(mut i, r, t, \"`return` value\")\n      }\n      check.TAny\n    },\n    ast.IsExpr { value, .. } => {\n      _ := check.infer(mut i, value, env, None)\n      check.TBool\n    },\n    ast.TupleExpr(es) => {\n      // each element with the expected tuple's element as its hint\n      hints := match expected {\n        Some(e) => match check.res(i, e) {\n          check.TNamed { name, args } => if name == \"Tuple\" && len(args) == len(es) {\n            args\n          } else {\n            []\n          },\n          _ => [],\n        },\n        None => [],\n      }\n      mut ts := []\n      for (k, x) in enumerate(es) {\n        mut ts.push(check.infer(mut i, x, env, get(hints, k)))\n      }\n      check.TNamed { name: \"Tuple\", args: ts }\n    },\n    ast.CtorExpr { name, args } => match get(i.types.ctors, name) {\n      Some(sh) => check.infer_ctor(mut i, name, sh, args, env, expected),\n      None => {\n        match args {\n          ast.PositionalArgs(es) => check.infer_all(mut i, es, env),\n          ast.RecordArgs(fs) => check.infer_all(mut i, fs.map(f -> f.1), env),\n          ast.UpdateArgs { base, fields } => check.infer_all(mut i, [base] + fields.map(f -> f.1), env),\n          ast.NoArgs => (),\n        }\n        check.TAny\n      },\n    },\n    ast.MethodCall { recv, name, args } => check.infer_method(mut i, recv, name, args, env, false),\n    ast.FieldOf { base, name: tagged } => {\n      // a tagged read, `sku#0.1`: its receiver's type is kept for `rename`\n      (name, tag) := match check.untag(tagged) {\n        Some(nk) => nk,\n        None => (tagged, \"\"),\n      }\n      seq := i.call_seq\n      bt := check.infer(mut i, base, env, None)\n      if tag != \"\" {\n        mut i.insts.insert(tag + \":field\", bt)\n      }\n      // a call whose function speaks of its variant under a condition only\n      // `verify` decides: the field of the variants left that have it, which\n      // `verify` proves the result is one of (else it faults when it runs)\n      match (i.last_call, check.sum_variants(i, bt)) {\n        ((ls, _, vs, true), Some((_, targs, _))) => if ls == seq\n          && (base is ast.Call || base is ast.MethodCall)\n          && len(check.with_field(i, vs, name)) > 0 {\n          return check.variants_field(\n            mut i,\n            check.with_field(i, vs, name),\n            targs,\n            name,\n            check.shown(check.widened(check.res(i, bt))) ?? \"?\",\n          )\n        },\n        _ => (),\n      }\n      match check.res(i, bt) {\n        // a field of a value that has none\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => {\n          match check.shown(check.res(i, bt)) {\n            Some(x) => check.error(\n              mut i,\n              \"cannot access field `\" + name + \"` on `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          check.TAny\n        },\n        // `p.1`: a tuple's element\n        check.TNamed { name: \"Tuple\", args: targs } => match parse_int(name) {\n          Some(k) => match get(targs, k) {\n            Some(t) => check.place(i, t),\n            None => {\n              match check.shown(check.res(i, bt)) {\n                Some(x) => check.error(\n                  mut i,\n                  \"tuple `\" + x + \"` has no element \" + name,\n                ),\n                None => (),\n              }\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a field of the one variant a value is narrowed to\n        check.TVariants { names: [v], args: targs, .. } => match get(i.types.ctors, v) {\n          Some(sh) => match check.field_of(sh, name) {\n            Some(ft) => check.place(\n              i,\n              check.inst(ft, check.pairs(sh.params, targs)),\n            ),\n            None => {\n              check.error(\n                mut i,\n                \"variant `\" + v + \"` has no field `\" + name + \"`\",\n              )\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a field every variant a value is narrowed to has\n        check.TVariants { names, args: targs, .. } => check.variants_field(\n          mut i,\n          names,\n          targs,\n          name,\n          check.shown(check.res(i, bt)) ?? \"?\",\n        ),\n        // a field every member of a union has, with the same type\n        check.TUnion(ms) => {\n          mut out: Option[check.Ty] = None\n          for m in ms {\n            ft := match m {\n              check.TNamed { name: mn, .. } => match get(i.types.ctors, mn) {\n                Some(sh) => check.field_of(sh, name),\n                None => None,\n              },\n              _ => None,\n            }\n            match ft {\n              Some(x) => {\n                out = Some(x)\n              },\n              None => {\n                mt := check.shown(m) ?? \"?\"\n                ut := check.shown(check.res(i, bt)) ?? \"?\"\n                check.error(\n                  mut i,\n                  f\"`{mt}` has no field `{name}`, so not every `{ut}` does (match on it first)\",\n                )\n                return check.TAny\n              },\n            }\n          }\n          match out {\n            Some(x) => check.place(i, x),\n            None => check.TAny,\n          }\n        },\n        // a sum's field: one every variant has\n        check.TNamed { name: n, args: targs } => if contains(i.types.sums, n) && !contains(i.types.ctors, n) {\n          check.variants_field(\n            mut i,\n            get(i.types.variants, n) ?? [],\n            targs,\n            name,\n            check.shown(check.res(i, bt)) ?? n,\n          )\n        } else {\n          match get(i.types.ctors, n) {\n            // a record type; a sum's name is not a constructor\n            Some(sh) => match check.field_of(sh, name) {\n              Some(ft) => {\n                mut m := Dict[String, check.Ty] {}\n                for (k, p) in enumerate(sh.params) {\n                  mut m.insert(p, get(targs, k) ?? check.TAny)\n                }\n                check.place(i, check.inst(ft, m))\n              },\n              None => {\n                check.error(mut i, \"type `\"\n                  + n\n                  + \"` has no field `\"\n                  + name\n                  + \"` (match on variants to access their fields)\")\n                check.TAny\n              },\n            },\n            None => check.TAny,\n          }\n        },\n        _ => check.TAny,\n      }\n    },\n    // `mut q.claim(2)`: a call that changes its receiver\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => match check.untag(name) {\n      // a tagged call: its receiver's type is kept, as `infer` keeps it. A call\n      // spreading records, tagged by `spread_bound`, is written out.\n      Some(nk) => if starts_with(nk.1, \"s\") {\n        check.infer_spread(mut i, e, nk.1, env, expected)\n      } else {\n        rt := check.infer(mut i, recv, env, None)\n        mut i.insts.insert(nk.1 + \":recv\", rt)\n        t := check.infer_method(mut i, recv, nk.0, args, env, true)\n        mut i.insts.insert(nk.1, t)\n        t\n      },\n      None => check.infer_method(mut i, recv, name, args, env, true),\n    },\n    ast.MutExpr(x) => check.infer(mut i, x, env, expected),\n    // `r!`, `o?`: the value a `Result` or an `Option` holds\n    ast.Try { value, kind } => {\n      vt := check.infer(mut i, value, env, None)\n      want := if kind == ast.TryResult {\n        \"Result\"\n      } else {\n        \"Option\"\n      }\n      match check.res(i, vt) {\n        check.TNamed { name, args } => if name == want {\n          check.early_error(mut i, kind, if kind == ast.TryResult {\n            get(args, 1) ?? check.TAny\n          } else {\n            check.TAny\n          })\n          get(args, 0) ?? check.TAny\n        } else {\n          check.wrong_try(mut i, kind, check.res(i, vt))\n        },\n        check.TAny | check.TVar(_) => check.TAny,\n        other => check.wrong_try(mut i, kind, other),\n      }\n    },\n    // `r except e { fallback }`: the value, or the fallback (of the same\n    // type) with `e` the error\n    ast.Except { value, err, fallback } => {\n      vt := check.infer(mut i, value, env, None)\n      (ok, bad) := match check.res(i, vt) {\n        check.TNamed { name, args } => if name == \"Result\" && len(args) == 2 {\n          (get(args, 0) ?? check.TAny, get(args, 1) ?? check.TAny)\n        } else if name == \"Option\" {\n          check.error(\n            mut i,\n            \"`except` / `!!` handle a Result; an Option is handled with `or { … }` / `??`\",\n          )\n          (check.fresh(mut i), check.TAny)\n        } else {\n          check.not_result(mut i, check.res(i, vt))\n        },\n        check.TAny | check.TVar(_) => (check.TAny, check.TAny),\n        other => check.not_result(mut i, other),\n      }\n      inner := match err {\n        Some(n) => {\n          mut copy := env\n          mut copy.insert(n, bad)\n          copy\n        },\n        None => env,\n      }\n      ft := check.infer(mut i, fallback, inner, Some(ok))\n      check.expect(mut i, ok, ft, \"`except` fallback\")\n      ok\n    },\n    ast.Fallback { value, fallback } => {\n      vt := check.infer(mut i, value, env, None)\n      inner := match check.res(i, vt) {\n        check.TNamed { name, args } => if name == \"Option\" && len(args) == 1 {\n          get(args, 0) ?? check.TAny\n        } else if name == \"Result\" && len(args) == 2 {\n          check.error(\n            mut i,\n            \"`or` / `??` handle an Option; a Result is handled with `except { … }` / `!!`\",\n          )\n          get(args, 0) ?? check.TAny\n        } else {\n          match check.shown(check.res(i, vt)) {\n            Some(x) => check.error(\n              mut i,\n              \"`or` / `??` handle an Option, found `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          check.fresh(mut i)\n        },\n        check.TAny => check.TAny,\n        other => {\n          match check.shown(other) {\n            Some(x) => check.error(\n              mut i,\n              \"`or` / `??` handle an Option, found `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          // the fallback's type, so checking goes on\n          check.fresh(mut i)\n        },\n      }\n      ft := check.infer(mut i, fallback, env, Some(inner))\n      check.expect(mut i, inner, ft, \"`or` fallback\")\n      inner\n    },\n    ast.Index { base, index } => {\n      bt := check.infer(mut i, base, env, None)\n      match index {\n        // `xs[a..b]`: a slice, of the same type\n        ast.Range { lo, hi, .. } => {\n          for x in [lo, hi] {\n            match x {\n              Some(v) => check.infer(mut i, v, env, Some(check.TInt)),\n              None => check.TAny,\n            }\n          }\n          match check.res(i, bt) {\n            check.TList(_) => bt,\n            _ => check.TAny,\n          }\n        },\n        // `xs[k]`: the built-in `at(xs, k)`\n        _ => match check.res(i, bt) {\n          check.TList(_) => match get(i.builtins, \"at\") {\n            Some(bs) => check.builtin_call(mut i, \"at\", bs, [bt], [index], env),\n            None => {\n              _ := check.infer(mut i, index, env, None)\n              check.TAny\n            },\n          },\n          _ => {\n            _ := check.infer(mut i, index, env, None)\n            check.TAny\n          },\n        },\n      }\n    },\n    // `a..b`: the list of the integers from `a`\n    ast.Range { lo, hi, .. } => {\n      for x in [lo, hi] {\n        match x {\n          Some(v) => check.infer(mut i, v, env, Some(check.TInt)),\n          None => check.TAny,\n        }\n      }\n      check.TList(check.TInt)\n    },\n    ast.Comp { kind, elem, fors } => {\n      mut seen := env\n      // over an iterator, one of the program's types or core's, a comprehension\n      // is lazy: an iterator instead of a list\n      mut lazy := false\n      for f in fors {\n        it := check.infer(mut i, f.iter, seen, None)\n        match check.res(i, it) {\n          check.TNamed { name, .. } => if contains(i.methods.impls, \"Iterator for \" + name)\n            || contains(i.methods.impls, \"FiniteIterator for \" + name) {\n            lazy = true\n          },\n          _ => (),\n        }\n        seen = check.bind_typed(\n          mut i,\n          seen,\n          f.pat,\n          check.element_of(i, it),\n        )\n        match f.cond {\n          Some(c) => check.infer(mut i, c, seen, None),\n          None => (),\n        }\n      }\n      et := check.infer(mut i, elem, seen, None)\n      // a list comprehension is a list of its element's type\n      if kind == ast.ListComp && !lazy {\n        check.TList(et)\n      } else {\n        check.TAny\n      }\n    },\n    ast.DictExpr { entries, .. } => {\n      for kv in entries {\n        check.infer_all(mut i, [kv.0, kv.1], env)\n      }\n      check.TAny\n    },\n    ast.SetExpr { elems, .. } => {\n      check.infer_all(mut i, elems, env)\n      check.TAny\n    },\n    ast.Comptime(x) => {\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    // `old e`: `e`'s value where the function started, of `e`'s type\n    ast.Old(x) => check.infer(mut i, x, env, expected),\n    // `...x` where `spread_bound` found no call by name to fill\n    ast.Spread(x) => {\n      check.spread_error(\n        mut i,\n        \"`...\"\n          + text.expr_text(x, 0)\n          + \"`: a spread gives a record's fields to the parameters of a function or method called by name; it can't be used here\",\n      )\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    ast.Assumed(x) => check.infer(mut i, x, env, expected),\n    // a `scope`'s result can't hold one of its tasks' handles\n    ast.Scope(x) => {\n      held := i.outside\n      i.outside = Some(set(keys(env)))\n      // `scope { …; spawn e }`: the last task's handle isn't its value\n      t := if check.ends_in_spawn(x) {\n        _ := check.infer(mut i, x, env, None)\n        check.TUnit\n      } else {\n        check.infer(mut i, x, env, expected)\n      }\n      i.outside = held\n      if check.holds_task(check.res(i, t)) {\n        match check.shown(check.res(i, t)) {\n          Some(s) => check.error(\n            mut i,\n            \"a task's handle can't leave its `scope` (its result is `\"\n              + s\n              + \"`): await it inside\",\n          ),\n          None => (),\n        }\n      }\n      t\n    },\n    // `spawn e`: a handle to `e`'s value\n    ast.Spawn(x) => {\n      outer := i.ret\n      i.ret = check.TAny\n      held := i.captured\n      i.captured = set(keys(env))\n      t := check.infer(mut i, x, env, None)\n      i.captured = held\n      i.ret = outer\n      // a sender is captured on its own, never inside another value\n      for v in keys(env).sorted() {\n        vt := check.res(i, get(env, v) ?? check.TAny)\n        if !(vt is check.TNamed && check.type_name(vt) == \"Sender\")\n          && check.holds_sender(i, vt, 8)\n          && check.uses(x, v)\n          && !check.rebinds(x, v) {\n          check.error(\n            mut i,\n            \"a task (a `spawn`, a `race` arm) can capture a sender only on its own (a variable holding it): `\"\n              + v\n              + \"` holds one inside\",\n          )\n        }\n      }\n      check.TNamed { name: \"Task\", args: [t] }\n    },\n    // `select`: each arm's operation (`rx.recv()` an `Option`, `tx.send(v)`,\n    // `await h`, `clock.after(d)` with `clock` a clock and `d` a `Duration`),\n    // its name, and its body with the type wanted\n    ast.Select(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.MethodCall { recv, name, args } => if name == \"after\" && len(args) == 1 {\n            ct := check.res(i, check.infer(mut i, recv, env, None))\n            match ct {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(ct) {\n                Some(x) => check.error(\n                  mut i,\n                  \"an `after` arm waits on a clock: `\"\n                    + x\n                    + \"` doesn't implement `Clock` (std.time)\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            dt := check.res(i, check.infer(\n              mut i,\n              get(args, 0) ?? ast.UnitExpr,\n              env,\n              None,\n            ))\n            match dt {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(dt) {\n                Some(x) => check.error(\n                  mut i,\n                  \"the time an `after` arm waits: expected `std.time.Duration`, found `\"\n                    + x\n                    + \"`\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            check.TUnit\n          } else {\n            check.infer(mut i, a.op, env, None)\n          },\n          _ => check.infer(mut i, a.op, env, None),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `race`: each left side is a task's body (a supervised one's result is a\n    // `Result[T, Panic]`), then its name and its body\n    ast.Race(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.SupervisedSpawn(x) => check.TNamed { name: \"Result\", args: [\n            check.task_body(mut i, x, env),\n            check.TNamed { name: \"Panic\", args: [] },\n          ] },\n          op => check.task_body(mut i, op, env),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `supervised spawn e`: a handle to `e`'s value, or its panic\n    ast.SupervisedSpawn(x) => check.TNamed {\n      name: \"Task\",\n      args: [check.TNamed { name: \"Result\", args: [\n        check.task_body(mut i, x, env),\n        check.TNamed { name: \"Panic\", args: [] },\n      ] }],\n    },\n    // `await h`: the task's value, or each task's for a tuple or list of handles\n    ast.Await(x) => {\n      t := check.infer(mut i, x, env, None)\n      check.awaited(mut i, check.res(i, t))\n    },\n    ast.Hole(h) => {\n      t := expected ?? check.fresh(mut i)\n      mut i.holes.push((h, t, env))\n      t\n    },\n    _ => check.TAny,\n  }\n}","old_text":"/// The type of `e`, where `expected` is the type its place asks for. The\n/// mismatches found go to `i.errs`, in the order found.\nfn infer_untagged(\n  mut i: check.Inf,\n  e: ast.Expr,\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  match e {\n    ast.IntLit(_) => check.int_literal(mut i, e, expected),\n    ast.BigIntLit(_) => check.int_literal(mut i, e, expected),\n    ast.FloatLit(_) => check.TFloat,\n    ast.StrLit(_) => check.TStr,\n    ast.BoolLit(_) => check.TBool,\n    ast.UnitExpr => check.TUnit,\n    // `env` holds declared types; a narrowed variable reads as a place\n    ast.Var(x) => match get(env, x) {\n      Some(t) => {\n        // a closure or `spawn` can't hold a handle from outside it\n        if contains(i.captured, x) && check.holds_task(check.res(i, t)) {\n          check.error(mut i, \"a closure or `spawn` can't hold `\"\n            + x\n            + \"`, a task's handle: await it where it was spawned\")\n        }\n        check.var_type(i, x, t)\n      },\n      None => match get(i.fns, x) {\n        // a function's type parameters: fresh at each use\n        Some(t) => check.inst(t, check.fresh_for(\n          mut i,\n          to_list(check.gens(t, Set[String] {})),\n        )),\n        None => check.trait_fn(mut i, x),\n      },\n    },\n    ast.Interp(parts) => {\n      for p in parts {\n        match p {\n          ast.ValuePart { value, spec } => {\n            t := check.listed_arg(\n              mut i,\n              \"$interp\",\n              0,\n              value,\n              check.TList(check.TAny),\n              check.infer(mut i, value, env, None),\n              \"interpolation\",\n            )\n            match spec {\n              Some(f) => check.check_spec(mut i, f, t),\n              None => (),\n            }\n          },\n          ast.TextPart(_) => (),\n        }\n      }\n      check.TStr\n    },\n    ast.Binary { op, left, right } => check.binary(mut i, op, left, right, env, expected),\n    // a negative literal of a sized type (`-2^63`, beyond 64 bits once negated)\n    ast.Unary { op, operand } => if op == ast.Neg\n      && check.is_int_lit(operand)\n      && check.sized_expected(i, expected) is Some {\n      _ := check.infer(mut i, operand, env, None)\n      check.int_literal(mut i, e, expected)\n    } else {\n      t := check.infer(mut i, operand, env, None)\n      if op == ast.Neg && !check.is_int_lit(operand) {\n        mut i.arith.push((\"-\", t))\n      }\n      match op {\n        ast.Neg => {\n          match check.res(i, t) {\n            check.TInt | check.TFloat | check.TAny => (),\n            check.TNamed { name, args } => if !(len(args) == 0 && check.is_sized(name)) {\n              check.error(\n                mut i,\n                \"operand of `-` must be Int or Float, found `\"\n                  + (check.shown(check.res(i, t)) ?? name)\n                  + \"`\",\n              )\n            },\n            check.TVar(_) => check.expect(mut i, check.TInt, t, \"operand of `-`\"),\n            other => match check.shown(other) {\n              Some(s) => check.error(\n                mut i,\n                \"operand of `-` must be Int or Float, found `\"\n                  + s\n                  + \"`\",\n              ),\n              None => (),\n            },\n          }\n          t\n        },\n        ast.Not => {\n          check.expect(mut i, check.TBool, t, \"operand of `!`\")\n          check.TBool\n        },\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => check.infer_if(mut i, cond, then, otherwise, env, expected),\n    ast.Block { stmts, last } => check.infer_block(mut i, stmts, last, env, expected),\n    ast.Call { callee, args } => check.infer_call(mut i, callee, args, env),\n    ast.ListExpr(es) => check.infer_list(mut i, es, env, expected),\n    ast.MatchExpr { scrutinee, binding, arms } => check.infer_match(\n      mut i,\n      scrutinee,\n      binding,\n      arms,\n      env,\n      expected,\n    ),\n    ast.Lambda { params, body } => check.infer_lambda(mut i, params, body, env, expected),\n    ast.Return(x) => {\n      r := i.ret\n      if check.outside_fn(check.res(i, r)) {\n        check.error(mut i, \"`return` outside a function\")\n        _ := check.infer(mut i, x, env, None)\n      } else {\n        t := check.infer(mut i, x, env, Some(r))\n        check.expect(mut i, r, t, \"`return` value\")\n      }\n      check.TAny\n    },\n    ast.IsExpr { value, .. } => {\n      _ := check.infer(mut i, value, env, None)\n      check.TBool\n    },\n    ast.TupleExpr(es) => {\n      // each element with the expected tuple's element as its hint\n      hints := match expected {\n        Some(e) => match check.res(i, e) {\n          check.TNamed { name, args } => if name == \"Tuple\" && len(args) == len(es) {\n            args\n          } else {\n            []\n          },\n          _ => [],\n        },\n        None => [],\n      }\n      mut ts := []\n      for (k, x) in enumerate(es) {\n        mut ts.push(check.infer(mut i, x, env, get(hints, k)))\n      }\n      check.TNamed { name: \"Tuple\", args: ts }\n    },\n    ast.CtorExpr { name, args } => match get(i.types.ctors, name) {\n      Some(sh) => check.infer_ctor(mut i, name, sh, args, env, expected),\n      None => {\n        match args {\n          ast.PositionalArgs(es) => check.infer_all(mut i, es, env),\n          ast.RecordArgs(fs) => check.infer_all(mut i, fs.map(f -> f.1), env),\n          ast.UpdateArgs { base, fields } => check.infer_all(mut i, [base] + fields.map(f -> f.1), env),\n          ast.NoArgs => (),\n        }\n        check.TAny\n      },\n    },\n    ast.MethodCall { recv, name, args } => check.infer_method(mut i, recv, name, args, env, false),\n    ast.FieldOf { base, name: tagged } => {\n      // a tagged read, `sku#0.1`: its receiver's type is kept for `rename`\n      (name, tag) := match check.untag(tagged) {\n        Some(nk) => nk,\n        None => (tagged, \"\"),\n      }\n      bt := check.infer(mut i, base, env, None)\n      if tag != \"\" {\n        mut i.insts.insert(tag + \":field\", bt)\n      }\n      match check.res(i, bt) {\n        // a field of a value that has none\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => {\n          match check.shown(check.res(i, bt)) {\n            Some(x) => check.error(\n              mut i,\n              \"cannot access field `\" + name + \"` on `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          check.TAny\n        },\n        // `p.1`: a tuple's element\n        check.TNamed { name: \"Tuple\", args: targs } => match parse_int(name) {\n          Some(k) => match get(targs, k) {\n            Some(t) => check.place(i, t),\n            None => {\n              match check.shown(check.res(i, bt)) {\n                Some(x) => check.error(\n                  mut i,\n                  \"tuple `\" + x + \"` has no element \" + name,\n                ),\n                None => (),\n              }\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a field of the one variant a value is narrowed to\n        check.TVariants { names: [v], .. } => match get(i.types.ctors, v) {\n          Some(sh) => match check.field_of(sh, name) {\n            Some(ft) => check.place(i, ft),\n            None => {\n              check.error(\n                mut i,\n                \"variant `\" + v + \"` has no field `\" + name + \"`\",\n              )\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a field every variant a value is narrowed to has\n        check.TVariants { names, .. } => check.variants_field(\n          mut i,\n          names,\n          [],\n          name,\n          check.shown(check.res(i, bt)) ?? \"?\",\n        ),\n        // a field every member of a union has, with the same type\n        check.TUnion(ms) => {\n          mut out: Option[check.Ty] = None\n          for m in ms {\n            ft := match m {\n              check.TNamed { name: mn, .. } => match get(i.types.ctors, mn) {\n                Some(sh) => check.field_of(sh, name),\n                None => None,\n              },\n              _ => None,\n            }\n            match ft {\n              Some(x) => {\n                out = Some(x)\n              },\n              None => {\n                mt := check.shown(m) ?? \"?\"\n                ut := check.shown(check.res(i, bt)) ?? \"?\"\n                check.error(\n                  mut i,\n                  f\"`{mt}` has no field `{name}`, so not every `{ut}` does (match on it first)\",\n                )\n                return check.TAny\n              },\n            }\n          }\n          match out {\n            Some(x) => check.place(i, x),\n            None => check.TAny,\n          }\n        },\n        // a sum's field: one every variant has\n        check.TNamed { name: n, args: targs } => if contains(i.types.sums, n) && !contains(i.types.ctors, n) {\n          check.variants_field(\n            mut i,\n            get(i.types.variants, n) ?? [],\n            targs,\n            name,\n            check.shown(check.res(i, bt)) ?? n,\n          )\n        } else {\n          match get(i.types.ctors, n) {\n            // a record type; a sum's name is not a constructor\n            Some(sh) => match check.field_of(sh, name) {\n              Some(ft) => {\n                mut m := Dict[String, check.Ty] {}\n                for (k, p) in enumerate(sh.params) {\n                  mut m.insert(p, get(targs, k) ?? check.TAny)\n                }\n                check.place(i, check.inst(ft, m))\n              },\n              None => {\n                check.error(mut i, \"type `\"\n                  + n\n                  + \"` has no field `\"\n                  + name\n                  + \"` (match on variants to access their fields)\")\n                check.TAny\n              },\n            },\n            None => check.TAny,\n          }\n        },\n        _ => check.TAny,\n      }\n    },\n    // `mut q.claim(2)`: a call that changes its receiver\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => match check.untag(name) {\n      // a tagged call: its receiver's type is kept, as `infer` keeps it. A call\n      // spreading records, tagged by `spread_bound`, is written out.\n      Some(nk) => if starts_with(nk.1, \"s\") {\n        check.infer_spread(mut i, e, nk.1, env, expected)\n      } else {\n        rt := check.infer(mut i, recv, env, None)\n        mut i.insts.insert(nk.1 + \":recv\", rt)\n        t := check.infer_method(mut i, recv, nk.0, args, env, true)\n        mut i.insts.insert(nk.1, t)\n        t\n      },\n      None => check.infer_method(mut i, recv, name, args, env, true),\n    },\n    ast.MutExpr(x) => check.infer(mut i, x, env, expected),\n    // `r!`, `o?`: the value a `Result` or an `Option` holds\n    ast.Try { value, kind } => {\n      vt := check.infer(mut i, value, env, None)\n      want := if kind == ast.TryResult {\n        \"Result\"\n      } else {\n        \"Option\"\n      }\n      match check.res(i, vt) {\n        check.TNamed { name, args } => if name == want {\n          check.early_error(mut i, kind, if kind == ast.TryResult {\n            get(args, 1) ?? check.TAny\n          } else {\n            check.TAny\n          })\n          get(args, 0) ?? check.TAny\n        } else {\n          check.wrong_try(mut i, kind, check.res(i, vt))\n        },\n        check.TAny | check.TVar(_) => check.TAny,\n        other => check.wrong_try(mut i, kind, other),\n      }\n    },\n    // `r except e { fallback }`: the value, or the fallback (of the same\n    // type) with `e` the error\n    ast.Except { value, err, fallback } => {\n      vt := check.infer(mut i, value, env, None)\n      (ok, bad) := match check.res(i, vt) {\n        check.TNamed { name, args } => if name == \"Result\" && len(args) == 2 {\n          (get(args, 0) ?? check.TAny, get(args, 1) ?? check.TAny)\n        } else if name == \"Option\" {\n          check.error(\n            mut i,\n            \"`except` / `!!` handle a Result; an Option is handled with `or { … }` / `??`\",\n          )\n          (check.fresh(mut i), check.TAny)\n        } else {\n          check.not_result(mut i, check.res(i, vt))\n        },\n        check.TAny | check.TVar(_) => (check.TAny, check.TAny),\n        other => check.not_result(mut i, other),\n      }\n      inner := match err {\n        Some(n) => {\n          mut copy := env\n          mut copy.insert(n, bad)\n          copy\n        },\n        None => env,\n      }\n      ft := check.infer(mut i, fallback, inner, Some(ok))\n      check.expect(mut i, ok, ft, \"`except` fallback\")\n      ok\n    },\n    ast.Fallback { value, fallback } => {\n      vt := check.infer(mut i, value, env, None)\n      inner := match check.res(i, vt) {\n        check.TNamed { name, args } => if name == \"Option\" && len(args) == 1 {\n          get(args, 0) ?? check.TAny\n        } else if name == \"Result\" && len(args) == 2 {\n          check.error(\n            mut i,\n            \"`or` / `??` handle an Option; a Result is handled with `except { … }` / `!!`\",\n          )\n          get(args, 0) ?? check.TAny\n        } else {\n          match check.shown(check.res(i, vt)) {\n            Some(x) => check.error(\n              mut i,\n              \"`or` / `??` handle an Option, found `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          check.fresh(mut i)\n        },\n        check.TAny => check.TAny,\n        other => {\n          match check.shown(other) {\n            Some(x) => check.error(\n              mut i,\n              \"`or` / `??` handle an Option, found `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          // the fallback's type, so checking goes on\n          check.fresh(mut i)\n        },\n      }\n      ft := check.infer(mut i, fallback, env, Some(inner))\n      check.expect(mut i, inner, ft, \"`or` fallback\")\n      inner\n    },\n    ast.Index { base, index } => {\n      bt := check.infer(mut i, base, env, None)\n      match index {\n        // `xs[a..b]`: a slice, of the same type\n        ast.Range { lo, hi, .. } => {\n          for x in [lo, hi] {\n            match x {\n              Some(v) => check.infer(mut i, v, env, Some(check.TInt)),\n              None => check.TAny,\n            }\n          }\n          match check.res(i, bt) {\n            check.TList(_) => bt,\n            _ => check.TAny,\n          }\n        },\n        // `xs[k]`: the built-in `at(xs, k)`\n        _ => match check.res(i, bt) {\n          check.TList(_) => match get(i.builtins, \"at\") {\n            Some(bs) => check.builtin_call(mut i, \"at\", bs, [bt], [index], env),\n            None => {\n              _ := check.infer(mut i, index, env, None)\n              check.TAny\n            },\n          },\n          _ => {\n            _ := check.infer(mut i, index, env, None)\n            check.TAny\n          },\n        },\n      }\n    },\n    // `a..b`: the list of the integers from `a`\n    ast.Range { lo, hi, .. } => {\n      for x in [lo, hi] {\n        match x {\n          Some(v) => check.infer(mut i, v, env, Some(check.TInt)),\n          None => check.TAny,\n        }\n      }\n      check.TList(check.TInt)\n    },\n    ast.Comp { kind, elem, fors } => {\n      mut seen := env\n      // over an iterator, one of the program's types or core's, a comprehension\n      // is lazy: an iterator instead of a list\n      mut lazy := false\n      for f in fors {\n        it := check.infer(mut i, f.iter, seen, None)\n        match check.res(i, it) {\n          check.TNamed { name, .. } => if contains(i.methods.impls, \"Iterator for \" + name)\n            || contains(i.methods.impls, \"FiniteIterator for \" + name) {\n            lazy = true\n          },\n          _ => (),\n        }\n        seen = check.bind_typed(\n          mut i,\n          seen,\n          f.pat,\n          check.element_of(i, it),\n        )\n        match f.cond {\n          Some(c) => check.infer(mut i, c, seen, None),\n          None => (),\n        }\n      }\n      et := check.infer(mut i, elem, seen, None)\n      // a list comprehension is a list of its element's type\n      if kind == ast.ListComp && !lazy {\n        check.TList(et)\n      } else {\n        check.TAny\n      }\n    },\n    ast.DictExpr { entries, .. } => {\n      for kv in entries {\n        check.infer_all(mut i, [kv.0, kv.1], env)\n      }\n      check.TAny\n    },\n    ast.SetExpr { elems, .. } => {\n      check.infer_all(mut i, elems, env)\n      check.TAny\n    },\n    ast.Comptime(x) => {\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    // `old e`: `e`'s value where the function started, of `e`'s type\n    ast.Old(x) => check.infer(mut i, x, env, expected),\n    // `...x` where `spread_bound` found no call by name to fill\n    ast.Spread(x) => {\n      check.spread_error(\n        mut i,\n        \"`...\"\n          + text.expr_text(x, 0)\n          + \"`: a spread gives a record's fields to the parameters of a function or method called by name; it can't be used here\",\n      )\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    ast.Assumed(x) => check.infer(mut i, x, env, expected),\n    // a `scope`'s result can't hold one of its tasks' handles\n    ast.Scope(x) => {\n      held := i.outside\n      i.outside = Some(set(keys(env)))\n      // `scope { …; spawn e }`: the last task's handle isn't its value\n      t := if check.ends_in_spawn(x) {\n        _ := check.infer(mut i, x, env, None)\n        check.TUnit\n      } else {\n        check.infer(mut i, x, env, expected)\n      }\n      i.outside = held\n      if check.holds_task(check.res(i, t)) {\n        match check.shown(check.res(i, t)) {\n          Some(s) => check.error(\n            mut i,\n            \"a task's handle can't leave its `scope` (its result is `\"\n              + s\n              + \"`): await it inside\",\n          ),\n          None => (),\n        }\n      }\n      t\n    },\n    // `spawn e`: a handle to `e`'s value\n    ast.Spawn(x) => {\n      outer := i.ret\n      i.ret = check.TAny\n      held := i.captured\n      i.captured = set(keys(env))\n      t := check.infer(mut i, x, env, None)\n      i.captured = held\n      i.ret = outer\n      // a sender is captured on its own, never inside another value\n      for v in keys(env).sorted() {\n        vt := check.res(i, get(env, v) ?? check.TAny)\n        if !(vt is check.TNamed && check.type_name(vt) == \"Sender\")\n          && check.holds_sender(i, vt, 8)\n          && check.uses(x, v)\n          && !check.rebinds(x, v) {\n          check.error(\n            mut i,\n            \"a task (a `spawn`, a `race` arm) can capture a sender only on its own (a variable holding it): `\"\n              + v\n              + \"` holds one inside\",\n          )\n        }\n      }\n      check.TNamed { name: \"Task\", args: [t] }\n    },\n    // `select`: each arm's operation (`rx.recv()` an `Option`, `tx.send(v)`,\n    // `await h`, `clock.after(d)` with `clock` a clock and `d` a `Duration`),\n    // its name, and its body with the type wanted\n    ast.Select(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.MethodCall { recv, name, args } => if name == \"after\" && len(args) == 1 {\n            ct := check.res(i, check.infer(mut i, recv, env, None))\n            match ct {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(ct) {\n                Some(x) => check.error(\n                  mut i,\n                  \"an `after` arm waits on a clock: `\"\n                    + x\n                    + \"` doesn't implement `Clock` (std.time)\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            dt := check.res(i, check.infer(\n              mut i,\n              get(args, 0) ?? ast.UnitExpr,\n              env,\n              None,\n            ))\n            match dt {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(dt) {\n                Some(x) => check.error(\n                  mut i,\n                  \"the time an `after` arm waits: expected `std.time.Duration`, found `\"\n                    + x\n                    + \"`\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            check.TUnit\n          } else {\n            check.infer(mut i, a.op, env, None)\n          },\n          _ => check.infer(mut i, a.op, env, None),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `race`: each left side is a task's body (a supervised one's result is a\n    // `Result[T, Panic]`), then its name and its body\n    ast.Race(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.SupervisedSpawn(x) => check.TNamed { name: \"Result\", args: [\n            check.task_body(mut i, x, env),\n            check.TNamed { name: \"Panic\", args: [] },\n          ] },\n          op => check.task_body(mut i, op, env),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `supervised spawn e`: a handle to `e`'s value, or its panic\n    ast.SupervisedSpawn(x) => check.TNamed {\n      name: \"Task\",\n      args: [check.TNamed { name: \"Result\", args: [\n        check.task_body(mut i, x, env),\n        check.TNamed { name: \"Panic\", args: [] },\n      ] }],\n    },\n    // `await h`: the task's value, or each task's for a tuple or list of handles\n    ast.Await(x) => {\n      t := check.infer(mut i, x, env, None)\n      check.awaited(mut i, check.res(i, t))\n    },\n    ast.Hole(h) => {\n      t := expected ?? check.fresh(mut i)\n      mut i.holes.push((h, t, env))\n      t\n    },\n    _ => check.TAny,\n  }\n}"},{"name":"check.ty_text","kind":"fn","old":"aa7fe040fc7569fc","new":"8787b84cd19a33c2","interface_changed":false,"affected":[],"module":"check","text":"/// A type as `strata holes` writes it, with `_` for what isn't worked out.\npub fn ty_text(t: check.Ty) -> String {\n  match t {\n    check.TInt => \"Int\",\n    check.TFloat => \"Float\",\n    check.TBool => \"Bool\",\n    check.TStr => \"String\",\n    check.TUnit => \"()\",\n    check.TList(a) => \"List[\" + check.ty_text(a) + \"]\",\n    check.TFn { params, ret } => \"(\"\n      + join(params.map(p -> check.ty_text(p)), \", \")\n      + \") -> \"\n      + check.ty_text(ret),\n    check.TNamed { name, args } => if len(args) == 0 {\n      name\n    } else if name == \"Tuple\" {\n      \"(\" + join(args.map(a -> check.ty_text(a)), \", \") + \")\"\n    } else {\n      name + \"[\" + join(args.map(a -> check.ty_text(a)), \", \") + \"]\"\n    },\n    check.TGen(n) => n,\n    check.TVariants { owner, args, .. } => check.ty_text(check.TNamed { name: owner, args }),\n    check.TUnion(ms) => join(ms.map(\n      m -> match m {\n        check.TFn { .. } => \"(\" + check.ty_text(m) + \")\",\n        _ => check.ty_text(m),\n      },\n    ), \" | \"),\n    check.TTrait(n) => n,\n    check.TVar(_) => \"_\",\n    check.TAny => \"_\",\n  }\n}","old_text":"/// A type as `strata holes` writes it, with `_` for what isn't worked out.\npub fn ty_text(t: check.Ty) -> String {\n  match t {\n    check.TInt => \"Int\",\n    check.TFloat => \"Float\",\n    check.TBool => \"Bool\",\n    check.TStr => \"String\",\n    check.TUnit => \"()\",\n    check.TList(a) => \"List[\" + check.ty_text(a) + \"]\",\n    check.TFn { params, ret } => \"(\"\n      + join(params.map(p -> check.ty_text(p)), \", \")\n      + \") -> \"\n      + check.ty_text(ret),\n    check.TNamed { name, args } => if len(args) == 0 {\n      name\n    } else if name == \"Tuple\" {\n      \"(\" + join(args.map(a -> check.ty_text(a)), \", \") + \")\"\n    } else {\n      name + \"[\" + join(args.map(a -> check.ty_text(a)), \", \") + \"]\"\n    },\n    check.TGen(n) => n,\n    check.TVariants { owner, .. } => owner,\n    check.TUnion(ms) => join(ms.map(\n      m -> match m {\n        check.TFn { .. } => \"(\" + check.ty_text(m) + \")\",\n        _ => check.ty_text(m),\n      },\n    ), \" | \"),\n    check.TTrait(n) => n,\n    check.TVar(_) => \"_\",\n    check.TAny => \"_\",\n  }\n}"},{"name":"check.narrowed_result","kind":"fn","old":"2c2c23cd153c77b3","new":"c6eeb9372d0b3ca7","interface_changed":false,"affected":[],"module":"check","text":"/// A call's result type, narrowed to the variants `narrowed_at` leaves,\n/// with the sum's type arguments. `ret` itself when nothing is left out\n/// (or the facts contradict).\nfn narrowed_result(\n  i: check.Inf,\n  f: String,\n  args: List[check.Ty],\n  ret: check.Ty,\n) -> check.Ty {\n  match (check.res(i, ret), check.narrowed_at(i, f, args, ret)) {\n    (check.TNamed { args: targs, .. }, Some((owner, all, left, _))) => if len(left) == 0 || len(left) == len(all) {\n      ret\n    } else {\n      check.TVariants {\n        owner,\n        names: to_list(left).sorted(),\n        args: targs,\n      }\n    },\n    _ => ret,\n  }\n}","old_text":"/// A call's result type, narrowed to the variants `narrowed_at` leaves,\n/// for a sum without type parameters (what `TVariants` models). `ret`\n/// itself when nothing is left out (or the facts contradict).\nfn narrowed_result(\n  i: check.Inf,\n  f: String,\n  args: List[check.Ty],\n  ret: check.Ty,\n) -> check.Ty {\n  match (check.res(i, ret), check.narrowed_at(i, f, args, ret)) {\n    (check.TNamed { args: [], .. }, Some((owner, all, left, _))) => if len(left) == 0 || len(left) == len(all) {\n      ret\n    } else {\n      check.TVariants { owner, names: to_list(left).sorted() }\n    },\n    _ => ret,\n  }\n}"},{"name":"check.variants_named","kind":"fn","old":"2458a45ea7f9eb52","new":"6572c09f5c4ebd54","interface_changed":false,"affected":[],"module":"check","text":"/// What `is V` tests, as a sum and the variants it accepts: one variant\n/// (`Shipped`, `Some`) or the whole sum (`Order`).\nfn variants_named(i: check.Inf, v: String) -> Option[(String, Set[String])] {\n  if contains(i.types.sums, v) {\n    return match get(i.types.variants, v) {\n      Some(vs) => Some((v, set(vs))),\n      None => None,\n    }\n  }\n  match get(i.types.ctors, v) {\n    Some(sh) => if sh.owner != v && contains(i.types.sums, sh.owner) {\n      Some((sh.owner, set([v])))\n    } else {\n      None\n    },\n    None => None,\n  }\n}","old_text":"/// What `is V` tests, as a sum and the variants it accepts: one variant\n/// (`Shipped`) or the whole sum (`Order`). Only sums without type parameters,\n/// as `TVariants` models.\nfn variants_named(i: check.Inf, v: String) -> Option[(String, Set[String])] {\n  if contains(i.types.sums, v) {\n    return match get(i.types.variants, v) {\n      Some(vs) => Some((v, set(vs))),\n      None => None,\n    }\n  }\n  match get(i.types.ctors, v) {\n    Some(sh) => if sh.owner != v\n      && len(sh.params) == 0\n      && contains(i.types.sums, sh.owner) {\n      Some((sh.owner, set([v])))\n    } else {\n      None\n    },\n    None => None,\n  }\n}"},{"name":"check.decide","kind":"fn","old":"5045e61c89761a6d","new":"c2288adc0b9b6ad0","interface_changed":false,"affected":[],"module":"check","text":"/// Whether condition `a` on a call's arguments holds, when their types\n/// decide it: `p is V` where the argument for `p` is narrowed to variants\n/// all inside `V` (true) or all outside it (false); `!`, `&&`, `||` of such;\n/// `true`, `false`. `None`: the types don't say.\nfn decide(\n  i: check.Inf,\n  a: ast.Expr,\n  params: List[String],\n  args: List[check.Ty],\n) -> Option[Bool] {\n  match a {\n    ast.BoolLit(b) => Some(b),\n    ast.Unary { op: ast.Not, operand } => match check.decide(i, operand, params, args) {\n      Some(b) => Some(!b),\n      None => None,\n    },\n    ast.Binary { op: ast.And, left, right } => match (\n      check.decide(i, left, params, args),\n      check.decide(i, right, params, args),\n    ) {\n      (Some(false), _) => Some(false),\n      (_, Some(false)) => Some(false),\n      (Some(true), Some(true)) => Some(true),\n      _ => None,\n    },\n    ast.Binary { op: ast.Or, left, right } => match (\n      check.decide(i, left, params, args),\n      check.decide(i, right, params, args),\n    ) {\n      (Some(true), _) => Some(true),\n      (_, Some(true)) => Some(true),\n      (Some(false), Some(false)) => Some(false),\n      _ => None,\n    },\n    ast.IsExpr { value: ast.Var(p), variant } => {\n      mut k := -1\n      for (j, x) in enumerate(params) {\n        if x == p {\n          k = j\n        }\n      }\n      if k < 0 {\n        return None\n      }\n      (o, vs) := match check.variants_named(i, variant) {\n        Some(x) => x,\n        None => return None,\n      }\n      (ao, _, has) := match check.sum_variants(i, get(args, k) ?? check.TAny) {\n        Some(x) => x,\n        None => return None,\n      }\n      if ao != o || len(has) == 0 {\n        None\n      } else if has.difference(vs).len() == 0 {\n        Some(true)\n      } else if has.intersection(vs).len() == 0 {\n        Some(false)\n      } else {\n        None\n      }\n    },\n    _ => None,\n  }\n}","old_text":"/// Whether condition `a` on a call's arguments holds, when their types\n/// decide it: `p is V` where the argument for `p` is narrowed to variants\n/// all inside `V` (true) or all outside it (false); `!`, `&&`, `||` of such;\n/// `true`, `false`. `None`: the types don't say.\nfn decide(\n  i: check.Inf,\n  a: ast.Expr,\n  params: List[String],\n  args: List[check.Ty],\n) -> Option[Bool] {\n  match a {\n    ast.BoolLit(b) => Some(b),\n    ast.Unary { op: ast.Not, operand } => match check.decide(i, operand, params, args) {\n      Some(b) => Some(!b),\n      None => None,\n    },\n    ast.Binary { op: ast.And, left, right } => match (\n      check.decide(i, left, params, args),\n      check.decide(i, right, params, args),\n    ) {\n      (Some(false), _) => Some(false),\n      (_, Some(false)) => Some(false),\n      (Some(true), Some(true)) => Some(true),\n      _ => None,\n    },\n    ast.Binary { op: ast.Or, left, right } => match (\n      check.decide(i, left, params, args),\n      check.decide(i, right, params, args),\n    ) {\n      (Some(true), _) => Some(true),\n      (_, Some(true)) => Some(true),\n      (Some(false), Some(false)) => Some(false),\n      _ => None,\n    },\n    ast.IsExpr { value: ast.Var(p), variant } => {\n      mut k := -1\n      for (j, x) in enumerate(params) {\n        if x == p {\n          k = j\n        }\n      }\n      if k < 0 {\n        return None\n      }\n      (o, vs) := match check.variants_named(i, variant) {\n        Some(x) => x,\n        None => return None,\n      }\n      (ao, has) := match check.res(i, get(args, k) ?? check.TAny) {\n        check.TVariants { owner, names } => (owner, set(names)),\n        check.TNamed { name, args: [] } => (name, set(get(i.types.variants, name) ?? [])),\n        _ => return None,\n      }\n      if ao != o || len(has) == 0 {\n        None\n      } else if has.difference(vs).len() == 0 {\n        Some(true)\n      } else if has.intersection(vs).len() == 0 {\n        Some(false)\n      } else {\n        None\n      }\n    },\n    _ => None,\n  }\n}"},{"name":"check.variants_covered","kind":"fn","old":"fff04113aa67e355","new":"578a3fbe4c9e1628","interface_changed":false,"affected":[],"module":"check","text":"/// A match on a call of one of the program's functions, whose result is\n/// a sum (`t`, or some of its variants: `narrowed_result`): an error for\n/// each arm the arms above leave nothing to, and for a variant no arm\n/// covers. `can`: the variants the call can give, `undecided`: whether\n/// that rests on conditions left to `verify`; then a variant not covered\n/// is `verify`'s to rule out (\"some arm of the `match` matches\"). Arms with\n/// conditions or nested patterns cover nothing here, and then nothing is\n/// reported missing.\nfn variants_covered(\n  mut i: check.Inf,\n  t: check.Ty,\n  can_at: Option[(List[String], Bool)],\n  arms: List[ast.Arm],\n) {\n  owner := match t {\n    check.TVariants { owner, .. } => owner,\n    check.TNamed { name, .. } => if contains(i.types.sums, name) {\n      name\n    } else {\n      return\n    },\n    _ => return,\n  }\n  all := get(i.types.variants, owner) ?? []\n  (can, undecided) := match can_at {\n    Some((c, u)) => (c, u),\n    None => match t {\n      check.TVariants { names, .. } => (names, false),\n      _ => (all, false),\n    },\n  }\n  shown_t := if len(can) < len(all) {\n    join(can.map(v -> check.last_part(v)), \" | \")\n  } else {\n    match t {\n      check.TNamed { name, args: [] } => check.last_part(name),\n      _ => check.shown(check.widened(t)) ?? owner,\n    }\n  }\n  mut left := set(can)\n  mut partial := false\n  for a in arms {\n    text := text.pattern_text(a.pat)\n    match check.pattern_variants(a.pat, owner, all) {\n      Some(vs) => {\n        if vs.intersection(left).len() == 0 {\n          if vs.intersection(set(can)).len() == 0\n            && len(can) < len(all) {\n            check.error(\n              mut i,\n              f\"unreachable match arm `{text}`: the result is `{shown_t}` here (from what its function ensures)\",\n            )\n          } else {\n            check.error(\n              mut i,\n              f\"unreachable match arm `{text}`: the arms above already cover it\",\n            )\n          }\n        }\n        left = left.difference(vs)\n      },\n      None => {\n        partial = true\n      },\n    }\n  }\n  if partial || undecided {\n    return\n  }\n  for v in can {\n    if contains(left, v) {\n      check.error(\n        mut i,\n        f\"non-exhaustive match on `{shown_t}`: `{check.last_part(v)}` is not covered\",\n      )\n      return\n    }\n  }\n}","old_text":"/// A match on a call of one of the program's functions, whose result is\n/// a sum (`t`, or some of its variants: `narrowed_result`): an error for\n/// each arm the arms above leave nothing to, and for a variant no arm\n/// covers. `can`: the variants the call can give, `undecided`: whether\n/// that rests on conditions left to `verify`; then a variant not covered\n/// is `verify`'s to rule out (\"some arm of the `match` matches\"). Arms with\n/// conditions or nested patterns cover nothing here, and then nothing is\n/// reported missing.\nfn variants_covered(\n  mut i: check.Inf,\n  t: check.Ty,\n  can_at: Option[(List[String], Bool)],\n  arms: List[ast.Arm],\n) {\n  owner := match t {\n    check.TVariants { owner, .. } => owner,\n    check.TNamed { name, .. } => if contains(i.types.sums, name) {\n      name\n    } else {\n      return\n    },\n    _ => return,\n  }\n  all := get(i.types.variants, owner) ?? []\n  (can, undecided) := match can_at {\n    Some((c, u)) => (c, u),\n    None => match t {\n      check.TVariants { names, .. } => (names, false),\n      _ => (all, false),\n    },\n  }\n  shown_t := if len(can) < len(all) {\n    join(can.map(v -> check.last_part(v)), \" | \")\n  } else {\n    match t {\n      check.TNamed { name, args: [] } => check.last_part(name),\n      _ => check.shown(t) ?? owner,\n    }\n  }\n  mut left := set(can)\n  mut partial := false\n  for a in arms {\n    text := text.pattern_text(a.pat)\n    match check.pattern_variants(a.pat, owner, all) {\n      Some(vs) => {\n        if vs.intersection(left).len() == 0 {\n          if vs.intersection(set(can)).len() == 0\n            && len(can) < len(all) {\n            check.error(\n              mut i,\n              f\"unreachable match arm `{text}`: the result is `{shown_t}` here (from what its function ensures)\",\n            )\n          } else {\n            check.error(\n              mut i,\n              f\"unreachable match arm `{text}`: the arms above already cover it\",\n            )\n          }\n        }\n        left = left.difference(vs)\n      },\n      None => {\n        partial = true\n      },\n    }\n  }\n  if partial || undecided {\n    return\n  }\n  for v in can {\n    if contains(left, v) {\n      check.error(\n        mut i,\n        f\"non-exhaustive match on `{shown_t}`: `{check.last_part(v)}` is not covered\",\n      )\n      return\n    }\n  }\n}"},{"name":"check.is_narrowed","kind":"fn","old":"6d82f28d88b02706","new":"6970941a705c118e","interface_changed":false,"affected":[],"module":"check","text":"/// What condition `c` says of variables of sum types, when it holds and\n/// when it doesn't: each `x is V` conjunct narrows `x` to `V`'s variants\n/// where it holds; a lone `x is V` narrows `x` to the others where it\n/// doesn't.\nfn is_narrowed(\n  i: check.Inf,\n  c: ast.Expr,\n  env: Dict[String, check.Ty],\n) -> (Dict[String, check.Ty], Dict[String, check.Ty]) {\n  mut yes := Dict[String, check.Ty] {}\n  for part in check.conjuncts(c) {\n    match check.variable_is(i, part, env) {\n      Some((x, owner, targs, has, vs)) => {\n        kept := has.intersection(vs)\n        if len(kept) > 0 {\n          mut yes.insert(\n            x,\n            check.TVariants {\n              owner,\n              names: to_list(kept).sorted(),\n              args: targs,\n            },\n          )\n        }\n      },\n      None => (),\n    }\n  }\n  mut no := Dict[String, check.Ty] {}\n  match check.variable_is(i, c, env) {\n    Some((x, owner, targs, has, vs)) => {\n      kept := has.difference(vs)\n      if len(kept) > 0 {\n        mut no.insert(\n          x,\n          check.TVariants {\n            owner,\n            names: to_list(kept).sorted(),\n            args: targs,\n          },\n        )\n      }\n    },\n    None => (),\n  }\n  (yes, no)\n}","old_text":"/// What condition `c` says of variables of sum types, when it holds and\n/// when it doesn't: each `x is V` conjunct narrows `x` to `V`'s variants\n/// where it holds; a lone `x is V` narrows `x` to the others where it\n/// doesn't. Only for sums without type parameters (`TVariants`).\nfn is_narrowed(\n  i: check.Inf,\n  c: ast.Expr,\n  env: Dict[String, check.Ty],\n) -> (Dict[String, check.Ty], Dict[String, check.Ty]) {\n  mut yes := Dict[String, check.Ty] {}\n  for part in check.conjuncts(c) {\n    match check.variable_is(i, part, env) {\n      Some((x, owner, has, vs)) => {\n        kept := has.intersection(vs)\n        if len(kept) > 0 {\n          mut yes.insert(\n            x,\n            check.TVariants { owner, names: to_list(kept).sorted() },\n          )\n        }\n      },\n      None => (),\n    }\n  }\n  mut no := Dict[String, check.Ty] {}\n  match check.variable_is(i, c, env) {\n    Some((x, owner, has, vs)) => {\n      kept := has.difference(vs)\n      if len(kept) > 0 {\n        mut no.insert(\n          x,\n          check.TVariants { owner, names: to_list(kept).sorted() },\n        )\n      }\n    },\n    None => (),\n  }\n  (yes, no)\n}"},{"name":"check.variable_is","kind":"fn","old":"92b8d2c51e5fea44","new":"0d5657794fccca33","interface_changed":true,"affected":["check.is_narrowed","check.infer_if","check.infer_untagged","check.infer","check.infer_spread","check.infer_all","check.binary","check.infer_block","check.infer_call","check.infer_list","check.infer_match","check.infer_ctor","check.infer_lambda","check.infer_method","check.builtin_call","check.static_call","check.fn_inferred","check.task_body","check.default_errors","check.element_assigned","check.spread_method_params","check.spread_filled","check.iter_builtin","check.fn_errors","check.instantiated","check.fn_lambdas_typed","check.holes_of","check.mark_field_reads","check.own_methods_resolved","check.typed_one","check.decl_type_errors","check.spread_body","check.field_reads","eval_files","instantiated_files","check.lambdas_typed","holes_command","check_summary","finding.uses_of","rename_command","verified_decls","check.typed","check.type_errors_with","check.spreads_resolved","unused.members","command_line","check_command","finding.uses_from","finding.used_by_tree","finding.refs_command","verified_with","static_graph","codegen.new_gen","computed_value","repl_eval","check.type_errors","check_errors_in","literal_errors","expanded","unused.findings","main","strata_command","finding.uses_tree","verified_program","verify_file","build_command","graph_command","graph_diff","tour_graph","codegen.generate","codegen.read_back","comptime_value","repl_command","check_errors_with","edit_errors","literal_errors_of","codegen_with","with_base","unused_of","edit_unused","core_unused","codegen.entry","codegen.compiled_alone","eval.run","smt_file","termination_file","verify_command","build_proofs","alongside_command","search_invariants","diff_command","tour_command","core_rt_text","comptime_values","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","codegen_text","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","run_command","fix_loops","build_core_command","comptime_runner","package_errors","merge_file_command","merged_checks","call_command","edit_command","check_files","move_command","fix_command","edit_in_editor","codegen_file","jit_file","fuzz_file","graph_runs","replay","or_solver_inputs","program_objects","sync_command","check_fn","linked"],"module":"check","text":"/// `x is V` on a variable of a sum: the variable, the sum, its type\n/// arguments, the variants it can be now, and those `V` accepts.\nfn variable_is(\n  i: check.Inf,\n  c: ast.Expr,\n  env: Dict[String, check.Ty],\n) -> Option[(String, String, List[check.Ty], Set[String], Set[String])] {\n  match c {\n    ast.IsExpr { value: ast.Var(x), variant } => {\n      (o, vs) := check.variants_named(i, variant)?\n      (owner, targs, has) := check.sum_variants(i, get(env, x) ?? check.TAny)?\n      if owner != o {\n        return None\n      }\n      Some((x, owner, targs, has, vs))\n    },\n    _ => None,\n  }\n}","old_text":"/// `x is V` on a variable of a sum: the variable, the sum, the variants\n/// it can be now, and those `V` accepts.\nfn variable_is(\n  i: check.Inf,\n  c: ast.Expr,\n  env: Dict[String, check.Ty],\n) -> Option[(String, String, Set[String], Set[String])] {\n  match c {\n    ast.IsExpr { value: ast.Var(x), variant } => {\n      (o, vs) := check.variants_named(i, variant)?\n      (owner, has) := match check.res(i, get(env, x) ?? check.TAny) {\n        check.TVariants { owner, names } => (owner, set(names)),\n        check.TNamed { name, args: [] } => (name, set(get(i.types.variants, name) ?? [])),\n        _ => return None,\n      }\n      if owner != o {\n        return None\n      }\n      Some((x, owner, has, vs))\n    },\n    _ => None,\n  }\n}"},{"name":"check.widened","kind":"fn","old":"e59ab7f26aa6df8d","new":"3fe412fb6210a3ea","interface_changed":true,"affected":["check.unify","check.infer_method","check.infer_untagged","check.variants_covered","check.method_facts_key","check.bind_typed","check.binary","check.infer_call","check.infer_ctor","check.builtin_call","check.fits_all","check.fits","check.tuple_taken_apart","check.infer","check.infer_spread","check.infer_match","check.infer_block","check.expect","check.join_union","check.infer_lambda","check.infer_all","check.infer_if","check.infer_list","check.static_call","check.fn_inferred","check.task_body","check.default_errors","check.element_assigned","check.spread_method_params","check.spread_filled","check.numeric","check.sized_operands","check.iter_builtin","check.fn_errors","check.instantiated","check.fn_lambdas_typed","check.holes_of","check.mark_field_reads","check.own_methods_resolved","check.typed_one","check.decl_type_errors","check.spread_body","check.field_reads","eval_files","instantiated_files","check.lambdas_typed","holes_command","check_summary","finding.uses_of","rename_command","verified_decls","check.typed","check.type_errors_with","check.spreads_resolved","unused.members","command_line","check_command","finding.uses_from","finding.used_by_tree","finding.refs_command","verified_with","static_graph","codegen.new_gen","computed_value","repl_eval","check.type_errors","check_errors_in","literal_errors","expanded","unused.findings","main","strata_command","finding.uses_tree","verified_program","verify_file","build_command","graph_command","graph_diff","tour_graph","codegen.generate","codegen.read_back","comptime_value","repl_command","check_errors_with","edit_errors","literal_errors_of","codegen_with","with_base","unused_of","edit_unused","core_unused","codegen.entry","codegen.compiled_alone","eval.run","smt_file","termination_file","verify_command","build_proofs","alongside_command","search_invariants","diff_command","tour_command","core_rt_text","comptime_values","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","codegen_text","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","run_command","fix_loops","build_core_command","comptime_runner","package_errors","merge_file_command","merged_checks","call_command","edit_command","check_files","move_command","fix_command","edit_in_editor","codegen_file","jit_file","fuzz_file","graph_runs","replay","or_solver_inputs","program_objects","sync_command","check_fn","linked"],"module":"check","text":"/// A type a type variable can stand for: a narrowed value's sum, since what\n/// the variable types (a list's elements, a variable) may later hold any\n/// variant.\nfn widened(t: check.Ty) -> check.Ty where !(it is check.TVariants) {\n  match t {\n    check.TVariants { owner, args, .. } => check.TNamed { name: owner, args },\n    _ => t,\n  }\n}","old_text":"/// A type a type variable can stand for: a narrowed value's sum, since what\n/// the variable types (a list's elements, a variable) may later hold any\n/// variant.\nfn widened(t: check.Ty) -> check.Ty {\n  match t {\n    check.TVariants { owner, .. } => check.TNamed { name: owner, args: [] },\n    _ => t,\n  }\n}"},{"name":"check.sum_variants","kind":"fn","old":null,"new":"96239a27e19c68df","interface_changed":true,"affected":[],"module":"check","text":"/// A value of a sum, as the sum, its type arguments and the variants it\n/// can be (some, when narrowed). `None`: not a sum.\nfn sum_variants(\n  i: check.Inf,\n  t: check.Ty,\n) -> Option[(String, List[check.Ty], Set[String])] {\n  match check.res(i, t) {\n    check.TVariants { owner, names, args } => Some((owner, args, set(names))),\n    check.TNamed { name, args } => if contains(i.types.sums, name) {\n      Some((name, args, set(get(i.types.variants, name) ?? [])))\n    } else {\n      None\n    },\n    _ => None,\n  }\n}"},{"name":"check.with_field","kind":"fn","old":null,"new":"2c3e22978cb94fea","interface_changed":true,"affected":[],"module":"check","text":"/// The variants of `vs` whose payload has field `f`.\nfn with_field(i: check.Inf, vs: List[String], f: String) -> List[String] {\n  vs.filter(\n    v -> match get(i.types.ctors, v) {\n      Some(sh) => check.field_of(sh, f) is Some,\n      None => false,\n    },\n  )\n}"},{"name":"check.method_facts_key","kind":"fn","old":null,"new":"fd1143ad4a60cc2d","interface_changed":true,"affected":[],"module":"check","text":"/// The name a method's facts are kept under (`Types.narrows`): `T.m` for\n/// a receiver of type `T` (or narrowed to some of its variants), `Tr.m`\n/// for a trait value or a type parameter bound by trait `Tr`.\nfn method_facts_key(i: check.Inf, rt: check.Ty, m: String) -> String {\n  match check.widened(rt) {\n    check.TNamed { name, .. } => name + \".\" + m,\n    check.TTrait(tr) => tr + \".\" + m,\n    check.TGen(p) => {\n      for tr in get(i.tbounds, p) ?? [] {\n        if contains(i.types.narrows, tr + \".\" + m) {\n          return tr + \".\" + m\n        }\n      }\n      \"\"\n    },\n    _ => \"\",\n  }\n}"}]}
{"id":"3bdaed508b2f9964","time":1795722144,"message":"edit","changes":[{"name":"smt.eval_expr","kind":"fn","old":"ba91c4e8a65d0e3b","new":"466a00e81a256e75","interface_changed":false,"affected":[],"module":"smt","text":"fn eval_expr(mut vc: smt.Vc, e: ast.Expr, pol: Int) -> smt.Val {\n  if vc.dead {\n    return smt.UnitVal\n  }\n  match e {\n    ast.IntLit(n) => smt.VInt(smt.num(n)),\n    ast.BigIntLit(d) => smt.VInt(d),\n    ast.FloatLit(_) => smt.Opaque(\"floats are not modelled yet\"),\n    ast.StrLit(s) => if smt.smt_string(s) {\n      smt.VStr(smt.str_lit(s))\n    } else {\n      smt.Opaque(smt.beyond())\n    },\n    ast.BoolLit(b) => smt.VBool(if b {\n      \"true\"\n    } else {\n      \"false\"\n    }),\n    ast.UnitExpr => smt.UnitVal,\n    ast.TupleExpr(xs) => {\n      mut out := []\n      for x in xs {\n        mut out.push(smt.eval(mut vc, x))\n      }\n      smt.VTuple(out)\n    },\n    ast.Var(x) => match smt.lookup(vc, x) {\n      Some(v) => v,\n      None => smt.fn_name_value(mut vc, x),\n    },\n    ast.Hole(h) => smt.Opaque(f\"the hole `?{h}`\"),\n    ast.Range { .. } | ast.Index { .. } | ast.Comp { .. } | ast.DictExpr { .. } | ast.SetExpr { .. } => smt.Opaque(\"a range, slice or comprehension not desugared\"),\n    ast.MockExpr(t) => smt.Opaque(f\"`mock {text.type_text(t)}`\"),\n    ast.Spread(_) => smt.Opaque(\"a spread (`...x`) not written out\"),\n    ast.Select(_) => smt.Opaque(\"which arm of a `select` runs depends on timing\"),\n    ast.Race(_) => smt.Opaque(\"which arm of a `race` wins depends on timing\"),\n    // `mut xs.push(x)`: a builtin changing a list, dict or set\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => if builtins.changing(name) {\n      rv := smt.eval(mut vc, recv)\n      if smt.is_list(rv) {\n        smt.changed(mut vc, recv, rv, name, args)\n      } else {\n        smt.eval(mut vc, ast.MethodCall { recv, name, args })\n      }\n    } else {\n      smt.eval(mut vc, ast.MethodCall { recv, name, args })\n    },\n    ast.MutExpr(x) | ast.Comptime(x) | ast.Scope(x) | ast.Spawn(x) | ast.Await(x) | ast.Assumed(x) => smt.eval(mut vc, x),\n    // `old e`: `e` over the values before (at the function's start, or a\n    // callee's arguments before the call)\n    ast.Old(x) => match vc.olds {\n      Some(before) => {\n        saved := vc.scopes\n        vc.scopes = smt.old_scopes(before, saved)\n        vc.olds = None\n        v := smt.eval(mut vc, x)\n        vc.olds = Some(before)\n        vc.scopes = saved\n        v\n      },\n      None => {\n        smt.gap(mut vc, \"`old` outside an `ensures`\")\n        smt.Opaque(\"`old` outside an `ensures`\")\n      },\n    },\n    ast.SupervisedSpawn(_) => smt.Opaque(\"a supervised task's result (it may have panicked)\"),\n    ast.Interp(parts) => smt.interpolated(mut vc, parts),\n    ast.Return(x) => {\n      v := smt.eval(mut vc, x)\n      smt.early_return(mut vc, v)\n      smt.UnitVal\n    },\n    ast.Try { value, kind } => {\n      v := smt.eval(mut vc, value)\n      ok_name := match kind {\n        ast.TryResult => \"Ok\",\n        ast.TryOption => \"Some\",\n      }\n      match (v, smt.ctor_index(v, ok_name)) {\n        (smt.VSum { tag, ctors, .. }, Some(k)) => {\n          ok := f\"(= {tag} {k})\"\n          payload := get((get(ctors, k) ?? (\"\", [])).1, 0) ?? smt.Opaque(\"the payload of `Ok` / `Some`\")\n          // the error (or `None`) leaves the function as it is\n          n := len(vc.pc)\n          mut vc.pc.push(smt.neg(ok))\n          smt.early_return(mut vc, v)\n          vc.dead = false\n          vc.pc = take(vc.pc, n) + [ok]\n          payload\n        },\n        _ => {\n          n := len(vc.pc)\n          smt.early_return(\n            mut vc,\n            smt.Opaque(\"an early return through `!` / `?`\"),\n          )\n          vc.dead = false\n          vc.pc = take(vc.pc, n)\n          smt.Opaque(\"the value under `!` / `?`\")\n        },\n      }\n    },\n    ast.Except { value, err, fallback } => smt.fallback_value(mut vc, value, err, fallback),\n    ast.Fallback { value, fallback } => smt.fallback_value(mut vc, value, None, fallback),\n    ast.FieldOf { base, name } => {\n      v := smt.eval(mut vc, base)\n      // a field of a call whose function says which variant it gives: the\n      // result is one of the variants with it (`strata check` lets such a\n      // read through when the condition is this proof's)\n      fv := if smt.gives_said_variant(vc, base) {\n        smt.force(mut vc, v)\n      } else {\n        v\n      }\n      smt.has_field(mut vc, fv, name)\n      smt.field(mut vc, fv, name)\n    },\n    ast.Unary { op, operand } => {\n      v := match op {\n        ast.Not => smt.eval_pol(mut vc, operand, 0 - pol),\n        ast.Neg => smt.eval(mut vc, operand),\n      }\n      match op {\n        ast.Neg => match (v, smt.word_of(v)) {\n          (smt.VInt(t), _) => smt.VInt(f\"(- {t})\"),\n          (_, Some(w)) => {\n            t := smt.as_int(mut vc, v)\n            smt.word(w, smt.wrap_term(w, f\"(- {t})\"))\n          },\n          (other, _) => other,\n        },\n        ast.Not => smt.VBool(smt.neg(smt.as_bool(mut vc, v))),\n      }\n    },\n    ast.Binary { op, left, right } => smt.binary(mut vc, op, left, right, pol),\n    ast.IsExpr { value, variant } => {\n      v := smt.eval(mut vc, value)\n      if !contains(vc.ctors, variant) && smt.is_type_name(vc, variant) {\n        smt.VBool(smt.in_type(mut vc, smt.named(variant), v, []))\n      } else {\n        smt.VBool(smt.is_ctor(mut vc, v, variant))\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => {\n      cv := smt.eval(mut vc, cond)\n      c := smt.as_bool(mut vc, cv)\n      vc.polarity = pol\n      r := smt.branches(\n        mut vc,\n        [(c, [], then), (smt.neg(c), [], otherwise)],\n      )\n      vc.polarity = 0\n      r\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      v := smt.eval(mut vc, scrutinee)\n      mut prev := []\n      mut alts := []\n      mut narrow := []\n      for a in arms {\n        // a union narrowed to the one member the arm's pattern can match\n        member := match v {\n          smt.VUnion { slots, .. } => match smt.arm_slots(mut vc, a.pat, slots) {\n            [i] => Some((get(slots, i) ?? (\"\", smt.Inactive)).1),\n            _ => None,\n          },\n          _ => None,\n        }\n        mut narrow.push(\n          match (scrutinee, member) {\n            (ast.Var(x), Some(m)) => match smt.lookup(vc, x) {\n              Some(_) => [(x, m)],\n              None => [],\n            },\n            _ => [],\n          },\n        )\n        mut binds := match binding {\n          Some(n) => [(n, member ?? v)],\n          None => [],\n        }\n        n := len(vc.pc)\n        vc.pc += prev.map(p -> smt.neg(p))\n        cond := smt.pattern(mut vc, a.pat, v, mut binds)\n        vc.pc = take(vc.pc, n)\n        mut alts.push(\n          (\n            smt.and_all(prev.map(p -> smt.neg(p)) + [cond]),\n            binds,\n            a.body,\n          ),\n        )\n        mut prev.push(cond)\n      }\n      // arms with conditions the checker can't decide: some arm must match\n      // (else compiled code faults with `no match arm`)\n      // or on a call whose function says which variant it gives: the checker\n      // leaves the variants that rest on conditions to this proof\n      if arms.any(a -> smt.undecided(vc, a.pat))\n        || smt.gives_said_variant(vc, scrutinee) {\n        if smt.start_goal(mut vc) {\n          smt.oblige(\n            mut vc,\n            \"some arm of the `match` matches\",\n            smt.or_all(prev),\n          )\n        }\n      }\n      vc.polarity = pol\n      r := smt.branches_narrowed(mut vc, alts, narrow)\n      vc.polarity = 0\n      r\n    },\n    ast.Block { stmts, last } => {\n      mut vc.scopes.push(Dict[String, smt.Val] {})\n      for s in stmts {\n        smt.stmt(mut vc, s)\n        if vc.dead {\n          break\n        }\n      }\n      v := smt.eval_pol(mut vc, last, pol)\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      v\n    },\n    ast.CtorExpr { name, args } => smt.ctor(mut vc, name, args),\n    ast.Call { callee, args } => match callee {\n      ast.Var(name) => match smt.lookup(vc, name) {\n        None => {\n          vc.call_pol = pol\n          smt.call_exprs(mut vc, name, args)\n        },\n        Some(f) => smt.call_value(mut vc, f, args),\n      },\n      _ => {\n        smt.gap(mut vc, \"calling a function value\")\n        smt.Opaque(\"calling a function value\")\n      },\n    },\n    ast.MethodCall { recv, name, args } => {\n      // a method called on a type (`T.empty()`): a static method, the type\n      // only picking the implementation\n      on_type := match recv {\n        // a record's name is both its type's and its constructor's\n        ast.CtorExpr { name: t, args: ast.NoArgs } => !contains(vc.ctors, t) || contains(vc.types, t),\n        _ => false,\n      }\n      if on_type {\n        t := match recv {\n          ast.CtorExpr { name: n, .. } => n,\n          _ => \"\",\n        }\n        smt.static_call(mut vc, t, name, args)\n      } else if contains(vc.fns, name) && smt.own_method_of(vc, recv, name) {\n        // `k.bump()` where `k`'s type has its own method `bump`: that\n        // method, not the function of that name\n        rv := smt.eval(mut vc, recv)\n        mut vals := [rv]\n        for a in args {\n          mut vals.push(smt.eval(mut vc, a))\n        }\n        smt.method_call(mut vc, name, [recv] + args, vals) or {\n          smt.Opaque(\n            f\"the result of method `{name}` (it depends on the receiver's type)\",\n          )\n        }\n      } else {\n        vc.call_pol = pol\n        smt.call_exprs(mut vc, name, [recv] + args)\n      }\n    },\n    ast.ListExpr(xs) => {\n      mut vals := []\n      for x in xs {\n        mut vals.push(smt.eval(mut vc, x))\n      }\n      smt.new_list(mut vc, f\"{len(xs)}\", smt.GValues(vals))\n    },\n    ast.Lambda { .. } => smt.fn_value(mut vc, e, []).0,\n  }\n}","old_text":"fn eval_expr(mut vc: smt.Vc, e: ast.Expr, pol: Int) -> smt.Val {\n  if vc.dead {\n    return smt.UnitVal\n  }\n  match e {\n    ast.IntLit(n) => smt.VInt(smt.num(n)),\n    ast.BigIntLit(d) => smt.VInt(d),\n    ast.FloatLit(_) => smt.Opaque(\"floats are not modelled yet\"),\n    ast.StrLit(s) => if smt.smt_string(s) {\n      smt.VStr(smt.str_lit(s))\n    } else {\n      smt.Opaque(smt.beyond())\n    },\n    ast.BoolLit(b) => smt.VBool(if b {\n      \"true\"\n    } else {\n      \"false\"\n    }),\n    ast.UnitExpr => smt.UnitVal,\n    ast.TupleExpr(xs) => {\n      mut out := []\n      for x in xs {\n        mut out.push(smt.eval(mut vc, x))\n      }\n      smt.VTuple(out)\n    },\n    ast.Var(x) => match smt.lookup(vc, x) {\n      Some(v) => v,\n      None => smt.fn_name_value(mut vc, x),\n    },\n    ast.Hole(h) => smt.Opaque(f\"the hole `?{h}`\"),\n    ast.Range { .. } | ast.Index { .. } | ast.Comp { .. } | ast.DictExpr { .. } | ast.SetExpr { .. } => smt.Opaque(\"a range, slice or comprehension not desugared\"),\n    ast.MockExpr(t) => smt.Opaque(f\"`mock {text.type_text(t)}`\"),\n    ast.Spread(_) => smt.Opaque(\"a spread (`...x`) not written out\"),\n    ast.Select(_) => smt.Opaque(\"which arm of a `select` runs depends on timing\"),\n    ast.Race(_) => smt.Opaque(\"which arm of a `race` wins depends on timing\"),\n    // `mut xs.push(x)`: a builtin changing a list, dict or set\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => if builtins.changing(name) {\n      rv := smt.eval(mut vc, recv)\n      if smt.is_list(rv) {\n        smt.changed(mut vc, recv, rv, name, args)\n      } else {\n        smt.eval(mut vc, ast.MethodCall { recv, name, args })\n      }\n    } else {\n      smt.eval(mut vc, ast.MethodCall { recv, name, args })\n    },\n    ast.MutExpr(x) | ast.Comptime(x) | ast.Scope(x) | ast.Spawn(x) | ast.Await(x) | ast.Assumed(x) => smt.eval(mut vc, x),\n    // `old e`: `e` over the values before (at the function's start, or a\n    // callee's arguments before the call)\n    ast.Old(x) => match vc.olds {\n      Some(before) => {\n        saved := vc.scopes\n        vc.scopes = smt.old_scopes(before, saved)\n        vc.olds = None\n        v := smt.eval(mut vc, x)\n        vc.olds = Some(before)\n        vc.scopes = saved\n        v\n      },\n      None => {\n        smt.gap(mut vc, \"`old` outside an `ensures`\")\n        smt.Opaque(\"`old` outside an `ensures`\")\n      },\n    },\n    ast.SupervisedSpawn(_) => smt.Opaque(\"a supervised task's result (it may have panicked)\"),\n    ast.Interp(parts) => smt.interpolated(mut vc, parts),\n    ast.Return(x) => {\n      v := smt.eval(mut vc, x)\n      smt.early_return(mut vc, v)\n      smt.UnitVal\n    },\n    ast.Try { value, kind } => {\n      v := smt.eval(mut vc, value)\n      ok_name := match kind {\n        ast.TryResult => \"Ok\",\n        ast.TryOption => \"Some\",\n      }\n      match (v, smt.ctor_index(v, ok_name)) {\n        (smt.VSum { tag, ctors, .. }, Some(k)) => {\n          ok := f\"(= {tag} {k})\"\n          payload := get((get(ctors, k) ?? (\"\", [])).1, 0) ?? smt.Opaque(\"the payload of `Ok` / `Some`\")\n          // the error (or `None`) leaves the function as it is\n          n := len(vc.pc)\n          mut vc.pc.push(smt.neg(ok))\n          smt.early_return(mut vc, v)\n          vc.dead = false\n          vc.pc = take(vc.pc, n) + [ok]\n          payload\n        },\n        _ => {\n          n := len(vc.pc)\n          smt.early_return(\n            mut vc,\n            smt.Opaque(\"an early return through `!` / `?`\"),\n          )\n          vc.dead = false\n          vc.pc = take(vc.pc, n)\n          smt.Opaque(\"the value under `!` / `?`\")\n        },\n      }\n    },\n    ast.Except { value, err, fallback } => smt.fallback_value(mut vc, value, err, fallback),\n    ast.Fallback { value, fallback } => smt.fallback_value(mut vc, value, None, fallback),\n    ast.FieldOf { base, name } => {\n      v := smt.eval(mut vc, base)\n      smt.field(mut vc, v, name)\n    },\n    ast.Unary { op, operand } => {\n      v := match op {\n        ast.Not => smt.eval_pol(mut vc, operand, 0 - pol),\n        ast.Neg => smt.eval(mut vc, operand),\n      }\n      match op {\n        ast.Neg => match (v, smt.word_of(v)) {\n          (smt.VInt(t), _) => smt.VInt(f\"(- {t})\"),\n          (_, Some(w)) => {\n            t := smt.as_int(mut vc, v)\n            smt.word(w, smt.wrap_term(w, f\"(- {t})\"))\n          },\n          (other, _) => other,\n        },\n        ast.Not => smt.VBool(smt.neg(smt.as_bool(mut vc, v))),\n      }\n    },\n    ast.Binary { op, left, right } => smt.binary(mut vc, op, left, right, pol),\n    ast.IsExpr { value, variant } => {\n      v := smt.eval(mut vc, value)\n      if !contains(vc.ctors, variant) && smt.is_type_name(vc, variant) {\n        smt.VBool(smt.in_type(mut vc, smt.named(variant), v, []))\n      } else {\n        smt.VBool(smt.is_ctor(mut vc, v, variant))\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => {\n      cv := smt.eval(mut vc, cond)\n      c := smt.as_bool(mut vc, cv)\n      vc.polarity = pol\n      r := smt.branches(\n        mut vc,\n        [(c, [], then), (smt.neg(c), [], otherwise)],\n      )\n      vc.polarity = 0\n      r\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      v := smt.eval(mut vc, scrutinee)\n      mut prev := []\n      mut alts := []\n      mut narrow := []\n      for a in arms {\n        // a union narrowed to the one member the arm's pattern can match\n        member := match v {\n          smt.VUnion { slots, .. } => match smt.arm_slots(mut vc, a.pat, slots) {\n            [i] => Some((get(slots, i) ?? (\"\", smt.Inactive)).1),\n            _ => None,\n          },\n          _ => None,\n        }\n        mut narrow.push(\n          match (scrutinee, member) {\n            (ast.Var(x), Some(m)) => match smt.lookup(vc, x) {\n              Some(_) => [(x, m)],\n              None => [],\n            },\n            _ => [],\n          },\n        )\n        mut binds := match binding {\n          Some(n) => [(n, member ?? v)],\n          None => [],\n        }\n        n := len(vc.pc)\n        vc.pc += prev.map(p -> smt.neg(p))\n        cond := smt.pattern(mut vc, a.pat, v, mut binds)\n        vc.pc = take(vc.pc, n)\n        mut alts.push(\n          (\n            smt.and_all(prev.map(p -> smt.neg(p)) + [cond]),\n            binds,\n            a.body,\n          ),\n        )\n        mut prev.push(cond)\n      }\n      // arms with conditions the checker can't decide: some arm must match\n      // (else compiled code faults with `no match arm`)\n      // or on a call whose function says which variant it gives: the checker\n      // leaves the variants that rest on conditions to this proof\n      if arms.any(a -> smt.undecided(vc, a.pat))\n        || smt.gives_said_variant(vc, scrutinee) {\n        if smt.start_goal(mut vc) {\n          smt.oblige(\n            mut vc,\n            \"some arm of the `match` matches\",\n            smt.or_all(prev),\n          )\n        }\n      }\n      vc.polarity = pol\n      r := smt.branches_narrowed(mut vc, alts, narrow)\n      vc.polarity = 0\n      r\n    },\n    ast.Block { stmts, last } => {\n      mut vc.scopes.push(Dict[String, smt.Val] {})\n      for s in stmts {\n        smt.stmt(mut vc, s)\n        if vc.dead {\n          break\n        }\n      }\n      v := smt.eval_pol(mut vc, last, pol)\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      v\n    },\n    ast.CtorExpr { name, args } => smt.ctor(mut vc, name, args),\n    ast.Call { callee, args } => match callee {\n      ast.Var(name) => match smt.lookup(vc, name) {\n        None => {\n          vc.call_pol = pol\n          smt.call_exprs(mut vc, name, args)\n        },\n        Some(f) => smt.call_value(mut vc, f, args),\n      },\n      _ => {\n        smt.gap(mut vc, \"calling a function value\")\n        smt.Opaque(\"calling a function value\")\n      },\n    },\n    ast.MethodCall { recv, name, args } => {\n      // a method called on a type (`T.empty()`): a static method, the type\n      // only picking the implementation\n      on_type := match recv {\n        // a record's name is both its type's and its constructor's\n        ast.CtorExpr { name: t, args: ast.NoArgs } => !contains(vc.ctors, t) || contains(vc.types, t),\n        _ => false,\n      }\n      if on_type {\n        t := match recv {\n          ast.CtorExpr { name: n, .. } => n,\n          _ => \"\",\n        }\n        smt.static_call(mut vc, t, name, args)\n      } else if contains(vc.fns, name) && smt.own_method_of(vc, recv, name) {\n        // `k.bump()` where `k`'s type has its own method `bump`: that\n        // method, not the function of that name\n        rv := smt.eval(mut vc, recv)\n        mut vals := [rv]\n        for a in args {\n          mut vals.push(smt.eval(mut vc, a))\n        }\n        smt.method_call(mut vc, name, [recv] + args, vals) or {\n          smt.Opaque(\n            f\"the result of method `{name}` (it depends on the receiver's type)\",\n          )\n        }\n      } else {\n        vc.call_pol = pol\n        smt.call_exprs(mut vc, name, [recv] + args)\n      }\n    },\n    ast.ListExpr(xs) => {\n      mut vals := []\n      for x in xs {\n        mut vals.push(smt.eval(mut vc, x))\n      }\n      smt.new_list(mut vc, f\"{len(xs)}\", smt.GValues(vals))\n    },\n    ast.Lambda { .. } => smt.fn_value(mut vc, e, []).0,\n  }\n}"},{"name":"smt.gives_said_variant","kind":"fn","old":"c8abad8dc0d4c244","new":"4331cb86c66fc261","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether `e` is a call of a function that says which variant its result\n/// is (`walk.says_variant_of_it`): a match on it is proven to cover the\n/// variants left (`check.variants_covered`).\nfn gives_said_variant(vc: smt.Vc, e: ast.Expr) -> Bool {\n  match e {\n    ast.Call { callee: ast.Var(f), .. } => match get(vc.fns, f) {\n      Some(fd) => walk.says_variant_of_it(walk.result_facts(fd)),\n      None => false,\n    },\n    // a method: any declaration of that name (a trait's, a type's own)\n    ast.MethodCall { name, .. } => {\n      (decls, _) := smt.method_decls(vc, name)\n      decls.any(\n          d -> walk.says_variant_of_it(walk.result_facts(d)),\n        )\n        || vc.methods.own.any(\n          d -> d.name == name\n            && walk.says_variant_of_it(walk.result_facts(d)),\n        )\n    },\n    _ => false,\n  }\n}","old_text":"/// Whether `e` is a call of a function that says which variant its result\n/// is (`walk.says_variant_of_it`): a match on it is proven to cover the\n/// variants left (`check.variants_covered`).\nfn gives_said_variant(vc: smt.Vc, e: ast.Expr) -> Bool {\n  match e {\n    ast.Call { callee: ast.Var(f), .. } => match get(vc.fns, f) {\n      Some(fd) => walk.says_variant_of_it(walk.result_facts(fd)),\n      None => false,\n    },\n    _ => false,\n  }\n}"},{"name":"smt.has_field","kind":"fn","old":null,"new":"157d7fdd3498b5bf","interface_changed":true,"affected":[],"module":"smt","text":"/// For a value `v` of a sum read for field `f`: proves its variant is one\n/// with the field, when not all have it (\"field `f` of a call's result\";\n/// compiled code checks it until proven).\nfn has_field(mut vc: smt.Vc, v: smt.Val, f: String) {\n  match v {\n    smt.VSum { ty, args, tag, .. } => {\n      cs := smt.variants_of(vc, ty, args) ?? []\n      mut ks := []\n      for (k, c) in enumerate(cs) {\n        if (c.fields ?? []).contains(f) {\n          mut ks.push(f\"(= {tag} {k})\")\n        }\n      }\n      if len(ks) > 0 && len(ks) < len(cs) && smt.start_goal(mut vc) {\n        smt.oblige(\n          mut vc,\n          f\"field `{f}` of a call's result\",\n          smt.or_all(ks),\n        )\n      }\n    },\n    _ => (),\n  }\n}"}]}
{"id":"1cbd8fba442c48fe","time":1795722191,"message":"edit","changes":[{"name":"smt.eval_expr","kind":"fn","old":"466a00e81a256e75","new":"7c8578e4a7dbf228","interface_changed":false,"affected":[],"module":"smt","text":"fn eval_expr(mut vc: smt.Vc, e: ast.Expr, pol: Int) -> smt.Val {\n  if vc.dead {\n    return smt.UnitVal\n  }\n  match e {\n    ast.IntLit(n) => smt.VInt(smt.num(n)),\n    ast.BigIntLit(d) => smt.VInt(d),\n    ast.FloatLit(_) => smt.Opaque(\"floats are not modelled yet\"),\n    ast.StrLit(s) => if smt.smt_string(s) {\n      smt.VStr(smt.str_lit(s))\n    } else {\n      smt.Opaque(smt.beyond())\n    },\n    ast.BoolLit(b) => smt.VBool(if b {\n      \"true\"\n    } else {\n      \"false\"\n    }),\n    ast.UnitExpr => smt.UnitVal,\n    ast.TupleExpr(xs) => {\n      mut out := []\n      for x in xs {\n        mut out.push(smt.eval(mut vc, x))\n      }\n      smt.VTuple(out)\n    },\n    ast.Var(x) => match smt.lookup(vc, x) {\n      Some(v) => v,\n      None => smt.fn_name_value(mut vc, x),\n    },\n    ast.Hole(h) => smt.Opaque(f\"the hole `?{h}`\"),\n    ast.Range { .. } | ast.Index { .. } | ast.Comp { .. } | ast.DictExpr { .. } | ast.SetExpr { .. } => smt.Opaque(\"a range, slice or comprehension not desugared\"),\n    ast.MockExpr(t) => smt.Opaque(f\"`mock {text.type_text(t)}`\"),\n    ast.Spread(_) => smt.Opaque(\"a spread (`...x`) not written out\"),\n    ast.Select(_) => smt.Opaque(\"which arm of a `select` runs depends on timing\"),\n    ast.Race(_) => smt.Opaque(\"which arm of a `race` wins depends on timing\"),\n    // `mut xs.push(x)`: a builtin changing a list, dict or set\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => if builtins.changing(name) {\n      rv := smt.eval(mut vc, recv)\n      if smt.is_list(rv) {\n        smt.changed(mut vc, recv, rv, name, args)\n      } else {\n        smt.eval(mut vc, ast.MethodCall { recv, name, args })\n      }\n    } else {\n      smt.eval(mut vc, ast.MethodCall { recv, name, args })\n    },\n    ast.MutExpr(x) | ast.Comptime(x) | ast.Scope(x) | ast.Spawn(x) | ast.Await(x) | ast.Assumed(x) => smt.eval(mut vc, x),\n    // `old e`: `e` over the values before (at the function's start, or a\n    // callee's arguments before the call)\n    ast.Old(x) => match vc.olds {\n      Some(before) => {\n        saved := vc.scopes\n        vc.scopes = smt.old_scopes(before, saved)\n        vc.olds = None\n        v := smt.eval(mut vc, x)\n        vc.olds = Some(before)\n        vc.scopes = saved\n        v\n      },\n      None => {\n        smt.gap(mut vc, \"`old` outside an `ensures`\")\n        smt.Opaque(\"`old` outside an `ensures`\")\n      },\n    },\n    ast.SupervisedSpawn(_) => smt.Opaque(\"a supervised task's result (it may have panicked)\"),\n    ast.Interp(parts) => smt.interpolated(mut vc, parts),\n    ast.Return(x) => {\n      v := smt.eval(mut vc, x)\n      smt.early_return(mut vc, v)\n      smt.UnitVal\n    },\n    ast.Try { value, kind } => {\n      v := smt.eval(mut vc, value)\n      ok_name := match kind {\n        ast.TryResult => \"Ok\",\n        ast.TryOption => \"Some\",\n      }\n      match (v, smt.ctor_index(v, ok_name)) {\n        (smt.VSum { tag, ctors, .. }, Some(k)) => {\n          ok := f\"(= {tag} {k})\"\n          payload := get((get(ctors, k) ?? (\"\", [])).1, 0) ?? smt.Opaque(\"the payload of `Ok` / `Some`\")\n          // the error (or `None`) leaves the function as it is\n          n := len(vc.pc)\n          mut vc.pc.push(smt.neg(ok))\n          smt.early_return(mut vc, v)\n          vc.dead = false\n          vc.pc = take(vc.pc, n) + [ok]\n          payload\n        },\n        _ => {\n          n := len(vc.pc)\n          smt.early_return(\n            mut vc,\n            smt.Opaque(\"an early return through `!` / `?`\"),\n          )\n          vc.dead = false\n          vc.pc = take(vc.pc, n)\n          smt.Opaque(\"the value under `!` / `?`\")\n        },\n      }\n    },\n    ast.Except { value, err, fallback } => smt.fallback_value(mut vc, value, err, fallback),\n    ast.Fallback { value, fallback } => smt.fallback_value(mut vc, value, None, fallback),\n    ast.FieldOf { base, name } => {\n      v := smt.eval(mut vc, base)\n      // a field of a call whose function says which variant it gives: the\n      // result is one of the variants with it (`strata check` lets such a\n      // read through when the condition is this proof's)\n      if smt.gives_said_variant(vc, base) {\n        fv := smt.force(mut vc, v)\n        smt.has_field(mut vc, fv, name)\n        smt.field(mut vc, fv, name)\n      } else {\n        smt.field(mut vc, v, name)\n      }\n    },\n    ast.Unary { op, operand } => {\n      v := match op {\n        ast.Not => smt.eval_pol(mut vc, operand, 0 - pol),\n        ast.Neg => smt.eval(mut vc, operand),\n      }\n      match op {\n        ast.Neg => match (v, smt.word_of(v)) {\n          (smt.VInt(t), _) => smt.VInt(f\"(- {t})\"),\n          (_, Some(w)) => {\n            t := smt.as_int(mut vc, v)\n            smt.word(w, smt.wrap_term(w, f\"(- {t})\"))\n          },\n          (other, _) => other,\n        },\n        ast.Not => smt.VBool(smt.neg(smt.as_bool(mut vc, v))),\n      }\n    },\n    ast.Binary { op, left, right } => smt.binary(mut vc, op, left, right, pol),\n    ast.IsExpr { value, variant } => {\n      v := smt.eval(mut vc, value)\n      if !contains(vc.ctors, variant) && smt.is_type_name(vc, variant) {\n        smt.VBool(smt.in_type(mut vc, smt.named(variant), v, []))\n      } else {\n        smt.VBool(smt.is_ctor(mut vc, v, variant))\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => {\n      cv := smt.eval(mut vc, cond)\n      c := smt.as_bool(mut vc, cv)\n      vc.polarity = pol\n      r := smt.branches(\n        mut vc,\n        [(c, [], then), (smt.neg(c), [], otherwise)],\n      )\n      vc.polarity = 0\n      r\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      v := smt.eval(mut vc, scrutinee)\n      mut prev := []\n      mut alts := []\n      mut narrow := []\n      for a in arms {\n        // a union narrowed to the one member the arm's pattern can match\n        member := match v {\n          smt.VUnion { slots, .. } => match smt.arm_slots(mut vc, a.pat, slots) {\n            [i] => Some((get(slots, i) ?? (\"\", smt.Inactive)).1),\n            _ => None,\n          },\n          _ => None,\n        }\n        mut narrow.push(\n          match (scrutinee, member) {\n            (ast.Var(x), Some(m)) => match smt.lookup(vc, x) {\n              Some(_) => [(x, m)],\n              None => [],\n            },\n            _ => [],\n          },\n        )\n        mut binds := match binding {\n          Some(n) => [(n, member ?? v)],\n          None => [],\n        }\n        n := len(vc.pc)\n        vc.pc += prev.map(p -> smt.neg(p))\n        cond := smt.pattern(mut vc, a.pat, v, mut binds)\n        vc.pc = take(vc.pc, n)\n        mut alts.push(\n          (\n            smt.and_all(prev.map(p -> smt.neg(p)) + [cond]),\n            binds,\n            a.body,\n          ),\n        )\n        mut prev.push(cond)\n      }\n      // arms with conditions the checker can't decide: some arm must match\n      // (else compiled code faults with `no match arm`)\n      // or on a call whose function says which variant it gives: the checker\n      // leaves the variants that rest on conditions to this proof\n      if arms.any(a -> smt.undecided(vc, a.pat))\n        || smt.gives_said_variant(vc, scrutinee) {\n        if smt.start_goal(mut vc) {\n          smt.oblige(\n            mut vc,\n            \"some arm of the `match` matches\",\n            smt.or_all(prev),\n          )\n        }\n      }\n      vc.polarity = pol\n      r := smt.branches_narrowed(mut vc, alts, narrow)\n      vc.polarity = 0\n      r\n    },\n    ast.Block { stmts, last } => {\n      mut vc.scopes.push(Dict[String, smt.Val] {})\n      for s in stmts {\n        smt.stmt(mut vc, s)\n        if vc.dead {\n          break\n        }\n      }\n      v := smt.eval_pol(mut vc, last, pol)\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      v\n    },\n    ast.CtorExpr { name, args } => smt.ctor(mut vc, name, args),\n    ast.Call { callee, args } => match callee {\n      ast.Var(name) => match smt.lookup(vc, name) {\n        None => {\n          vc.call_pol = pol\n          smt.call_exprs(mut vc, name, args)\n        },\n        Some(f) => smt.call_value(mut vc, f, args),\n      },\n      _ => {\n        smt.gap(mut vc, \"calling a function value\")\n        smt.Opaque(\"calling a function value\")\n      },\n    },\n    ast.MethodCall { recv, name, args } => {\n      // a method called on a type (`T.empty()`): a static method, the type\n      // only picking the implementation\n      on_type := match recv {\n        // a record's name is both its type's and its constructor's\n        ast.CtorExpr { name: t, args: ast.NoArgs } => !contains(vc.ctors, t) || contains(vc.types, t),\n        _ => false,\n      }\n      if on_type {\n        t := match recv {\n          ast.CtorExpr { name: n, .. } => n,\n          _ => \"\",\n        }\n        smt.static_call(mut vc, t, name, args)\n      } else if contains(vc.fns, name) && smt.own_method_of(vc, recv, name) {\n        // `k.bump()` where `k`'s type has its own method `bump`: that\n        // method, not the function of that name\n        rv := smt.eval(mut vc, recv)\n        mut vals := [rv]\n        for a in args {\n          mut vals.push(smt.eval(mut vc, a))\n        }\n        smt.method_call(mut vc, name, [recv] + args, vals) or {\n          smt.Opaque(\n            f\"the result of method `{name}` (it depends on the receiver's type)\",\n          )\n        }\n      } else {\n        vc.call_pol = pol\n        smt.call_exprs(mut vc, name, [recv] + args)\n      }\n    },\n    ast.ListExpr(xs) => {\n      mut vals := []\n      for x in xs {\n        mut vals.push(smt.eval(mut vc, x))\n      }\n      smt.new_list(mut vc, f\"{len(xs)}\", smt.GValues(vals))\n    },\n    ast.Lambda { .. } => smt.fn_value(mut vc, e, []).0,\n  }\n}","old_text":"fn eval_expr(mut vc: smt.Vc, e: ast.Expr, pol: Int) -> smt.Val {\n  if vc.dead {\n    return smt.UnitVal\n  }\n  match e {\n    ast.IntLit(n) => smt.VInt(smt.num(n)),\n    ast.BigIntLit(d) => smt.VInt(d),\n    ast.FloatLit(_) => smt.Opaque(\"floats are not modelled yet\"),\n    ast.StrLit(s) => if smt.smt_string(s) {\n      smt.VStr(smt.str_lit(s))\n    } else {\n      smt.Opaque(smt.beyond())\n    },\n    ast.BoolLit(b) => smt.VBool(if b {\n      \"true\"\n    } else {\n      \"false\"\n    }),\n    ast.UnitExpr => smt.UnitVal,\n    ast.TupleExpr(xs) => {\n      mut out := []\n      for x in xs {\n        mut out.push(smt.eval(mut vc, x))\n      }\n      smt.VTuple(out)\n    },\n    ast.Var(x) => match smt.lookup(vc, x) {\n      Some(v) => v,\n      None => smt.fn_name_value(mut vc, x),\n    },\n    ast.Hole(h) => smt.Opaque(f\"the hole `?{h}`\"),\n    ast.Range { .. } | ast.Index { .. } | ast.Comp { .. } | ast.DictExpr { .. } | ast.SetExpr { .. } => smt.Opaque(\"a range, slice or comprehension not desugared\"),\n    ast.MockExpr(t) => smt.Opaque(f\"`mock {text.type_text(t)}`\"),\n    ast.Spread(_) => smt.Opaque(\"a spread (`...x`) not written out\"),\n    ast.Select(_) => smt.Opaque(\"which arm of a `select` runs depends on timing\"),\n    ast.Race(_) => smt.Opaque(\"which arm of a `race` wins depends on timing\"),\n    // `mut xs.push(x)`: a builtin changing a list, dict or set\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => if builtins.changing(name) {\n      rv := smt.eval(mut vc, recv)\n      if smt.is_list(rv) {\n        smt.changed(mut vc, recv, rv, name, args)\n      } else {\n        smt.eval(mut vc, ast.MethodCall { recv, name, args })\n      }\n    } else {\n      smt.eval(mut vc, ast.MethodCall { recv, name, args })\n    },\n    ast.MutExpr(x) | ast.Comptime(x) | ast.Scope(x) | ast.Spawn(x) | ast.Await(x) | ast.Assumed(x) => smt.eval(mut vc, x),\n    // `old e`: `e` over the values before (at the function's start, or a\n    // callee's arguments before the call)\n    ast.Old(x) => match vc.olds {\n      Some(before) => {\n        saved := vc.scopes\n        vc.scopes = smt.old_scopes(before, saved)\n        vc.olds = None\n        v := smt.eval(mut vc, x)\n        vc.olds = Some(before)\n        vc.scopes = saved\n        v\n      },\n      None => {\n        smt.gap(mut vc, \"`old` outside an `ensures`\")\n        smt.Opaque(\"`old` outside an `ensures`\")\n      },\n    },\n    ast.SupervisedSpawn(_) => smt.Opaque(\"a supervised task's result (it may have panicked)\"),\n    ast.Interp(parts) => smt.interpolated(mut vc, parts),\n    ast.Return(x) => {\n      v := smt.eval(mut vc, x)\n      smt.early_return(mut vc, v)\n      smt.UnitVal\n    },\n    ast.Try { value, kind } => {\n      v := smt.eval(mut vc, value)\n      ok_name := match kind {\n        ast.TryResult => \"Ok\",\n        ast.TryOption => \"Some\",\n      }\n      match (v, smt.ctor_index(v, ok_name)) {\n        (smt.VSum { tag, ctors, .. }, Some(k)) => {\n          ok := f\"(= {tag} {k})\"\n          payload := get((get(ctors, k) ?? (\"\", [])).1, 0) ?? smt.Opaque(\"the payload of `Ok` / `Some`\")\n          // the error (or `None`) leaves the function as it is\n          n := len(vc.pc)\n          mut vc.pc.push(smt.neg(ok))\n          smt.early_return(mut vc, v)\n          vc.dead = false\n          vc.pc = take(vc.pc, n) + [ok]\n          payload\n        },\n        _ => {\n          n := len(vc.pc)\n          smt.early_return(\n            mut vc,\n            smt.Opaque(\"an early return through `!` / `?`\"),\n          )\n          vc.dead = false\n          vc.pc = take(vc.pc, n)\n          smt.Opaque(\"the value under `!` / `?`\")\n        },\n      }\n    },\n    ast.Except { value, err, fallback } => smt.fallback_value(mut vc, value, err, fallback),\n    ast.Fallback { value, fallback } => smt.fallback_value(mut vc, value, None, fallback),\n    ast.FieldOf { base, name } => {\n      v := smt.eval(mut vc, base)\n      // a field of a call whose function says which variant it gives: the\n      // result is one of the variants with it (`strata check` lets such a\n      // read through when the condition is this proof's)\n      fv := if smt.gives_said_variant(vc, base) {\n        smt.force(mut vc, v)\n      } else {\n        v\n      }\n      smt.has_field(mut vc, fv, name)\n      smt.field(mut vc, fv, name)\n    },\n    ast.Unary { op, operand } => {\n      v := match op {\n        ast.Not => smt.eval_pol(mut vc, operand, 0 - pol),\n        ast.Neg => smt.eval(mut vc, operand),\n      }\n      match op {\n        ast.Neg => match (v, smt.word_of(v)) {\n          (smt.VInt(t), _) => smt.VInt(f\"(- {t})\"),\n          (_, Some(w)) => {\n            t := smt.as_int(mut vc, v)\n            smt.word(w, smt.wrap_term(w, f\"(- {t})\"))\n          },\n          (other, _) => other,\n        },\n        ast.Not => smt.VBool(smt.neg(smt.as_bool(mut vc, v))),\n      }\n    },\n    ast.Binary { op, left, right } => smt.binary(mut vc, op, left, right, pol),\n    ast.IsExpr { value, variant } => {\n      v := smt.eval(mut vc, value)\n      if !contains(vc.ctors, variant) && smt.is_type_name(vc, variant) {\n        smt.VBool(smt.in_type(mut vc, smt.named(variant), v, []))\n      } else {\n        smt.VBool(smt.is_ctor(mut vc, v, variant))\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => {\n      cv := smt.eval(mut vc, cond)\n      c := smt.as_bool(mut vc, cv)\n      vc.polarity = pol\n      r := smt.branches(\n        mut vc,\n        [(c, [], then), (smt.neg(c), [], otherwise)],\n      )\n      vc.polarity = 0\n      r\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      v := smt.eval(mut vc, scrutinee)\n      mut prev := []\n      mut alts := []\n      mut narrow := []\n      for a in arms {\n        // a union narrowed to the one member the arm's pattern can match\n        member := match v {\n          smt.VUnion { slots, .. } => match smt.arm_slots(mut vc, a.pat, slots) {\n            [i] => Some((get(slots, i) ?? (\"\", smt.Inactive)).1),\n            _ => None,\n          },\n          _ => None,\n        }\n        mut narrow.push(\n          match (scrutinee, member) {\n            (ast.Var(x), Some(m)) => match smt.lookup(vc, x) {\n              Some(_) => [(x, m)],\n              None => [],\n            },\n            _ => [],\n          },\n        )\n        mut binds := match binding {\n          Some(n) => [(n, member ?? v)],\n          None => [],\n        }\n        n := len(vc.pc)\n        vc.pc += prev.map(p -> smt.neg(p))\n        cond := smt.pattern(mut vc, a.pat, v, mut binds)\n        vc.pc = take(vc.pc, n)\n        mut alts.push(\n          (\n            smt.and_all(prev.map(p -> smt.neg(p)) + [cond]),\n            binds,\n            a.body,\n          ),\n        )\n        mut prev.push(cond)\n      }\n      // arms with conditions the checker can't decide: some arm must match\n      // (else compiled code faults with `no match arm`)\n      // or on a call whose function says which variant it gives: the checker\n      // leaves the variants that rest on conditions to this proof\n      if arms.any(a -> smt.undecided(vc, a.pat))\n        || smt.gives_said_variant(vc, scrutinee) {\n        if smt.start_goal(mut vc) {\n          smt.oblige(\n            mut vc,\n            \"some arm of the `match` matches\",\n            smt.or_all(prev),\n          )\n        }\n      }\n      vc.polarity = pol\n      r := smt.branches_narrowed(mut vc, alts, narrow)\n      vc.polarity = 0\n      r\n    },\n    ast.Block { stmts, last } => {\n      mut vc.scopes.push(Dict[String, smt.Val] {})\n      for s in stmts {\n        smt.stmt(mut vc, s)\n        if vc.dead {\n          break\n        }\n      }\n      v := smt.eval_pol(mut vc, last, pol)\n      vc.scopes = take(vc.scopes, len(vc.scopes) - 1)\n      v\n    },\n    ast.CtorExpr { name, args } => smt.ctor(mut vc, name, args),\n    ast.Call { callee, args } => match callee {\n      ast.Var(name) => match smt.lookup(vc, name) {\n        None => {\n          vc.call_pol = pol\n          smt.call_exprs(mut vc, name, args)\n        },\n        Some(f) => smt.call_value(mut vc, f, args),\n      },\n      _ => {\n        smt.gap(mut vc, \"calling a function value\")\n        smt.Opaque(\"calling a function value\")\n      },\n    },\n    ast.MethodCall { recv, name, args } => {\n      // a method called on a type (`T.empty()`): a static method, the type\n      // only picking the implementation\n      on_type := match recv {\n        // a record's name is both its type's and its constructor's\n        ast.CtorExpr { name: t, args: ast.NoArgs } => !contains(vc.ctors, t) || contains(vc.types, t),\n        _ => false,\n      }\n      if on_type {\n        t := match recv {\n          ast.CtorExpr { name: n, .. } => n,\n          _ => \"\",\n        }\n        smt.static_call(mut vc, t, name, args)\n      } else if contains(vc.fns, name) && smt.own_method_of(vc, recv, name) {\n        // `k.bump()` where `k`'s type has its own method `bump`: that\n        // method, not the function of that name\n        rv := smt.eval(mut vc, recv)\n        mut vals := [rv]\n        for a in args {\n          mut vals.push(smt.eval(mut vc, a))\n        }\n        smt.method_call(mut vc, name, [recv] + args, vals) or {\n          smt.Opaque(\n            f\"the result of method `{name}` (it depends on the receiver's type)\",\n          )\n        }\n      } else {\n        vc.call_pol = pol\n        smt.call_exprs(mut vc, name, [recv] + args)\n      }\n    },\n    ast.ListExpr(xs) => {\n      mut vals := []\n      for x in xs {\n        mut vals.push(smt.eval(mut vc, x))\n      }\n      smt.new_list(mut vc, f\"{len(xs)}\", smt.GValues(vals))\n    },\n    ast.Lambda { .. } => smt.fn_value(mut vc, e, []).0,\n  }\n}"}]}
{"id":"bd10915bcecc70a3","time":1795722239,"message":"edit","changes":[{"name":"codegen.get_field","kind":"fn","old":"e3fd91cce66801a4","new":"b2a8ea969127e336","interface_changed":false,"affected":[],"module":"codegen","text":"/// `r.f`: a record's field or a tuple's element (`t.0`). Also a sum's\n/// field where the checker narrowed the value to variants that all have\n/// it (`Square => s.side`), read from wherever each has it.\nfn get_field(mut g: codegen.Gen, base: ast.Expr, f: String) -> codegen.V {\n  // (a call's result only read here: on the stack)\n  v := codegen.expr_on_stack(mut g, base, true)\n  if v.ty is check.TAny {\n    return v\n  }\n  match v.ty {\n    check.TNamed { name: \"Tuple\", args } => match parse_int(f) {\n      Some(k) => match get(args, k) {\n        Some(t) => return codegen.field(mut g, v, k, t),\n        None => (),\n      },\n      None => (),\n    },\n    check.TNamed { name, .. } => if !contains(g.types.sums, name) {\n      for (k, x) in enumerate(codegen.fields_of(g, name, v.ty)) {\n        if x.0 == f {\n          return codegen.field(mut g, v, k, x.1)\n        }\n      }\n    } else {\n      // a call's result whose function says which variant it gives: checked\n      // to be one with the field, unless `verify` proved it\n      if base is ast.Call || base is ast.MethodCall {\n        codegen.has_field_check(mut g, v, f)\n      }\n      return codegen.variant_field(mut g, v, f)\n    },\n    // a union of records or variants that all have the field\n    check.TUnion(ms) => if ms.all(\n      m ->\n        !codegen.boxed(g, m) && codegen.field_index(g, m, f).0 >= 0,\n    ) {\n      return codegen.union_field(mut g, v, ms, f)\n    },\n    _ => (),\n  }\n  codegen.not_yet(\n    mut g,\n    \"the field `\" + f + \"` of a `\" + codegen.key(v.ty) + \"`\",\n  )\n  codegen.never()\n}","old_text":"/// `r.f`: a record's field or a tuple's element (`t.0`). Also a sum's\n/// field where the checker narrowed the value to variants that all have\n/// it (`Square => s.side`), read from wherever each has it.\nfn get_field(mut g: codegen.Gen, base: ast.Expr, f: String) -> codegen.V {\n  // (a call's result only read here: on the stack)\n  v := codegen.expr_on_stack(mut g, base, true)\n  if v.ty is check.TAny {\n    return v\n  }\n  match v.ty {\n    check.TNamed { name: \"Tuple\", args } => match parse_int(f) {\n      Some(k) => match get(args, k) {\n        Some(t) => return codegen.field(mut g, v, k, t),\n        None => (),\n      },\n      None => (),\n    },\n    check.TNamed { name, .. } => if !contains(g.types.sums, name) {\n      for (k, x) in enumerate(codegen.fields_of(g, name, v.ty)) {\n        if x.0 == f {\n          return codegen.field(mut g, v, k, x.1)\n        }\n      }\n    } else {\n      return codegen.variant_field(mut g, v, f)\n    },\n    // a union of records or variants that all have the field\n    check.TUnion(ms) => if ms.all(\n      m ->\n        !codegen.boxed(g, m) && codegen.field_index(g, m, f).0 >= 0,\n    ) {\n      return codegen.union_field(mut g, v, ms, f)\n    },\n    _ => (),\n  }\n  codegen.not_yet(\n    mut g,\n    \"the field `\" + f + \"` of a `\" + codegen.key(v.ty) + \"`\",\n  )\n  codegen.never()\n}"},{"name":"codegen.has_field_check","kind":"fn","old":null,"new":"853cdc88ac8453ba","interface_changed":true,"affected":[],"module":"codegen","text":"/// Faults unless sum value `v` is a variant with field `f`, when some\n/// variants of its type lack it and `verify` didn't prove it (\"field `f`\n/// of a call's result\").\nfn has_field_check(mut g: codegen.Gen, v: codegen.V, f: String) {\n  cs := codegen.ctors_of(g, v.ty)\n  having := cs.filter(c -> codegen.fields_of(g, c, v.ty).any(x -> x.0 == f))\n  if len(having) == 0 || len(having) == len(cs) {\n    return\n  }\n  what := f\"field `{f}` of a call's result\"\n  if codegen.proven(mut g, what, \"exact\") {\n    return\n  }\n  mut ok := codegen.tag_is(mut g, v, get(having, 0) ?? \"\")\n  for c in drop(having, 1) {\n    b := codegen.tag_is(mut g, v, c)\n    r := codegen.fresh(mut g, \"or\")\n    codegen.emit(mut g, f\"{r} = or i1 {ok.op}, {b.op}\")\n    ok = codegen.V { ty: check.TBool, op: r }\n  }\n  codegen.fail_unless(mut g, ok, what, [], v, \"has no such field\")\n}"}]}
{"id":"d691fda51589bbff","time":1795722380,"message":"edit","changes":[{"name":"smt.gives_said_variant","kind":"fn","old":"4331cb86c66fc261","new":"338f7c0b7e4e3089","interface_changed":false,"affected":[],"module":"smt","text":"/// Whether `e` is a call of a function that says which variant its result\n/// is (`walk.says_variant_of_it`): a match on it is proven to cover the\n/// variants left (`check.variants_covered`).\nfn gives_said_variant(vc: smt.Vc, e: ast.Expr) -> Bool {\n  match e {\n    ast.Call { callee: ast.Var(f), .. } => match get(vc.fns, f) {\n      Some(fd) => walk.says_variant_of_it(walk.result_facts(fd)),\n      None => false,\n    },\n    // a method: any declaration of that name (a trait's, a type's own)\n    ast.MethodCall { name, .. } => {\n      // by its short name (`ship` of `Ship::ship` or `Order.ship`)\n      parts := split(name, \"::\")\n      tail := get(parts, len(parts) - 1) ?? name\n      dots := split(tail, \".\")\n      short := get(dots, len(dots) - 1) ?? tail\n      (decls, _) := smt.method_decls(vc, short)\n      decls.any(\n          d -> walk.says_variant_of_it(walk.result_facts(d)),\n        )\n        || vc.methods.own.any(\n          d -> (d.name == short || ends_with(d.name, \".\" + short))\n            && walk.says_variant_of_it(walk.result_facts(d)),\n        )\n    },\n    _ => false,\n  }\n}","old_text":"/// Whether `e` is a call of a function that says which variant its result\n/// is (`walk.says_variant_of_it`): a match on it is proven to cover the\n/// variants left (`check.variants_covered`).\nfn gives_said_variant(vc: smt.Vc, e: ast.Expr) -> Bool {\n  match e {\n    ast.Call { callee: ast.Var(f), .. } => match get(vc.fns, f) {\n      Some(fd) => walk.says_variant_of_it(walk.result_facts(fd)),\n      None => false,\n    },\n    // a method: any declaration of that name (a trait's, a type's own)\n    ast.MethodCall { name, .. } => {\n      (decls, _) := smt.method_decls(vc, name)\n      decls.any(\n          d -> walk.says_variant_of_it(walk.result_facts(d)),\n        )\n        || vc.methods.own.any(\n          d -> d.name == name\n            && walk.says_variant_of_it(walk.result_facts(d)),\n        )\n    },\n    _ => false,\n  }\n}"}]}
{"id":"2ba91543874babe7","time":1795722420,"message":"edit","changes":[{"name":"check.narrowed_result","kind":"fn","old":"c6eeb9372d0b3ca7","new":"9db67dbad513a7b5","interface_changed":true,"affected":["check.infer_call","check.infer_method","check.infer_untagged","check.infer","check.infer_spread","check.infer_all","check.binary","check.infer_block","check.infer_if","check.infer_list","check.infer_match","check.infer_ctor","check.infer_lambda","check.builtin_call","check.static_call","check.fn_inferred","check.task_body","check.default_errors","check.element_assigned","check.spread_method_params","check.spread_filled","check.iter_builtin","check.fn_errors","check.instantiated","check.fn_lambdas_typed","check.holes_of","check.mark_field_reads","check.own_methods_resolved","check.typed_one","check.decl_type_errors","check.spread_body","check.field_reads","eval_files","instantiated_files","check.lambdas_typed","holes_command","check_summary","finding.uses_of","rename_command","verified_decls","check.typed","check.type_errors_with","check.spreads_resolved","unused.members","command_line","check_command","finding.uses_from","finding.used_by_tree","finding.refs_command","verified_with","static_graph","codegen.new_gen","computed_value","repl_eval","check.type_errors","check_errors_in","literal_errors","expanded","unused.findings","main","strata_command","finding.uses_tree","verified_program","verify_file","build_command","graph_command","graph_diff","tour_graph","codegen.generate","codegen.read_back","comptime_value","repl_command","check_errors_with","edit_errors","literal_errors_of","codegen_with","with_base","unused_of","edit_unused","core_unused","codegen.entry","codegen.compiled_alone","eval.run","smt_file","termination_file","verify_command","build_proofs","alongside_command","search_invariants","diff_command","tour_command","core_rt_text","comptime_values","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","codegen_text","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","run_command","fix_loops","build_core_command","comptime_runner","package_errors","merge_file_command","merged_checks","call_command","edit_command","check_files","move_command","fix_command","edit_in_editor","codegen_file","jit_file","fuzz_file","graph_runs","replay","or_solver_inputs","program_objects","sync_command","check_fn","linked"],"module":"check","text":"/// A call's result type, narrowed to the variants `narrowed_at` leaves,\n/// with the sum's type arguments. `ret` itself when nothing is left out\n/// (or the facts contradict).\nfn narrowed_result(\n  i: check.Inf,\n  f: String,\n  args: List[check.Ty],\n  ret: check.Ty,\n) -> check.Ty\n  ensures it == ret\n    || match it {\n      check.TVariants { names, .. } => len(names) > 0,\n      _ => false,\n    } {\n  match (check.res(i, ret), check.narrowed_at(i, f, args, ret)) {\n    (check.TNamed { args: targs, .. }, Some((owner, all, left, _))) => if len(left) == 0 || len(left) == len(all) {\n      ret\n    } else {\n      check.TVariants {\n        owner,\n        names: to_list(left).sorted(),\n        args: targs,\n      }\n    },\n    _ => ret,\n  }\n}","old_text":"/// A call's result type, narrowed to the variants `narrowed_at` leaves,\n/// with the sum's type arguments. `ret` itself when nothing is left out\n/// (or the facts contradict).\nfn narrowed_result(\n  i: check.Inf,\n  f: String,\n  args: List[check.Ty],\n  ret: check.Ty,\n) -> check.Ty {\n  match (check.res(i, ret), check.narrowed_at(i, f, args, ret)) {\n    (check.TNamed { args: targs, .. }, Some((owner, all, left, _))) => if len(left) == 0 || len(left) == len(all) {\n      ret\n    } else {\n      check.TVariants {\n        owner,\n        names: to_list(left).sorted(),\n        args: targs,\n      }\n    },\n    _ => ret,\n  }\n}"},{"name":"check.narrow_by","kind":"fn","old":"748a6ad80135144e","new":"18ef4c1a853ef8f5","interface_changed":true,"affected":["check.narrowed_at","check.infer_call","check.infer_method","check.narrowed_result","check.infer_untagged","check.infer","check.infer_spread","check.infer_all","check.binary","check.infer_block","check.infer_if","check.infer_list","check.infer_match","check.infer_ctor","check.infer_lambda","check.builtin_call","check.static_call","check.fn_inferred","check.task_body","check.default_errors","check.element_assigned","check.spread_method_params","check.spread_filled","check.iter_builtin","check.fn_errors","check.instantiated","check.fn_lambdas_typed","check.holes_of","check.mark_field_reads","check.own_methods_resolved","check.typed_one","check.decl_type_errors","check.spread_body","check.field_reads","eval_files","instantiated_files","check.lambdas_typed","holes_command","check_summary","finding.uses_of","rename_command","verified_decls","check.typed","check.type_errors_with","check.spreads_resolved","unused.members","command_line","check_command","finding.uses_from","finding.used_by_tree","finding.refs_command","verified_with","static_graph","codegen.new_gen","computed_value","repl_eval","check.type_errors","check_errors_in","literal_errors","expanded","unused.findings","main","strata_command","finding.uses_tree","verified_program","verify_file","build_command","graph_command","graph_diff","tour_graph","codegen.generate","codegen.read_back","comptime_value","repl_command","check_errors_with","edit_errors","literal_errors_of","codegen_with","with_base","unused_of","edit_unused","core_unused","codegen.entry","codegen.compiled_alone","eval.run","smt_file","termination_file","verify_command","build_proofs","alongside_command","search_invariants","diff_command","tour_command","core_rt_text","comptime_values","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","codegen_text","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","run_command","fix_loops","build_core_command","comptime_runner","package_errors","merge_file_command","merged_checks","call_command","edit_command","check_files","move_command","fix_command","edit_in_editor","codegen_file","jit_file","fuzz_file","graph_runs","replay","or_solver_inputs","program_objects","sync_command","check_fn","linked"],"module":"check","text":"/// The variants `left` keeps under fact `c` about the result `it`, and\n/// whether `c` speaks of `it`'s variant under a condition the arguments'\n/// types don't decide.\nfn narrow_by(\n  i: check.Inf,\n  c: ast.Expr,\n  params: List[String],\n  args: List[check.Ty],\n  owner: String,\n  left: Set[String],\n) -> (Set[String], Bool)\n  ensures it.0.difference(left).len() == 0 {\n  about := walk.says_variant_of_it([c])\n  match c {\n    ast.Binary { op: ast.Implies, left: a, right: q } => match check.decide(i, a, params, args) {\n      Some(true) => check.narrow_by(i, q, params, args, owner, left),\n      Some(false) => (left, false),\n      None => (left, about),\n    },\n    // `(it is V) == A`: either way round\n    ast.Binary { op: ast.Equal, left: l, right: r } => match (\n      check.result_variants(i, l, owner),\n      check.result_variants(i, r, owner),\n    ) {\n      (Some(vs), None) => match check.decide(i, r, params, args) {\n        Some(true) => (left.intersection(vs), false),\n        Some(false) => (left.difference(vs), false),\n        None => (left, true),\n      },\n      (None, Some(vs)) => match check.decide(i, l, params, args) {\n        Some(true) => (left.intersection(vs), false),\n        Some(false) => (left.difference(vs), false),\n        None => (left, true),\n      },\n      _ => (left, about),\n    },\n    _ => match check.result_variants(i, c, owner) {\n      Some(vs) => (left.intersection(vs), false),\n      None => (left, about),\n    },\n  }\n}","old_text":"/// The variants `left` keeps under fact `c` about the result `it`, and\n/// whether `c` speaks of `it`'s variant under a condition the arguments'\n/// types don't decide.\nfn narrow_by(\n  i: check.Inf,\n  c: ast.Expr,\n  params: List[String],\n  args: List[check.Ty],\n  owner: String,\n  left: Set[String],\n) -> (Set[String], Bool) {\n  about := walk.says_variant_of_it([c])\n  match c {\n    ast.Binary { op: ast.Implies, left: a, right: q } => match check.decide(i, a, params, args) {\n      Some(true) => check.narrow_by(i, q, params, args, owner, left),\n      Some(false) => (left, false),\n      None => (left, about),\n    },\n    // `(it is V) == A`: either way round\n    ast.Binary { op: ast.Equal, left: l, right: r } => match (\n      check.result_variants(i, l, owner),\n      check.result_variants(i, r, owner),\n    ) {\n      (Some(vs), None) => match check.decide(i, r, params, args) {\n        Some(true) => (left.intersection(vs), false),\n        Some(false) => (left.difference(vs), false),\n        None => (left, true),\n      },\n      (None, Some(vs)) => match check.decide(i, l, params, args) {\n        Some(true) => (left.intersection(vs), false),\n        Some(false) => (left.difference(vs), false),\n        None => (left, true),\n      },\n      _ => (left, about),\n    },\n    _ => match check.result_variants(i, c, owner) {\n      Some(vs) => (left.intersection(vs), false),\n      None => (left, about),\n    },\n  }\n}"},{"name":"check.pattern_variants","kind":"fn","old":"6167711010df7c15","new":"681603f175c1a3c0","interface_changed":true,"affected":["check.variants_covered","check.infer_match","check.infer_untagged","check.infer","check.infer_spread","check.infer_all","check.binary","check.infer_block","check.infer_call","check.infer_if","check.infer_list","check.infer_ctor","check.infer_lambda","check.infer_method","check.builtin_call","check.static_call","check.fn_inferred","check.task_body","check.default_errors","check.element_assigned","check.spread_method_params","check.spread_filled","check.iter_builtin","check.fn_errors","check.instantiated","check.fn_lambdas_typed","check.holes_of","check.mark_field_reads","check.own_methods_resolved","check.typed_one","check.decl_type_errors","check.spread_body","check.field_reads","eval_files","instantiated_files","check.lambdas_typed","holes_command","check_summary","finding.uses_of","rename_command","verified_decls","check.typed","check.type_errors_with","check.spreads_resolved","unused.members","command_line","check_command","finding.uses_from","finding.used_by_tree","finding.refs_command","verified_with","static_graph","codegen.new_gen","computed_value","repl_eval","check.type_errors","check_errors_in","literal_errors","expanded","unused.findings","main","strata_command","finding.uses_tree","verified_program","verify_file","build_command","graph_command","graph_diff","tour_graph","codegen.generate","codegen.read_back","comptime_value","repl_command","check_errors_with","edit_errors","literal_errors_of","codegen_with","with_base","unused_of","edit_unused","core_unused","codegen.entry","codegen.compiled_alone","eval.run","smt_file","termination_file","verify_command","build_proofs","alongside_command","search_invariants","diff_command","tour_command","core_rt_text","comptime_values","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","codegen_text","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","run_command","fix_loops","build_core_command","comptime_runner","package_errors","merge_file_command","merged_checks","call_command","edit_command","check_files","move_command","fix_command","edit_in_editor","codegen_file","jit_file","fuzz_file","graph_runs","replay","or_solver_inputs","program_objects","sync_command","check_fn","linked"],"module":"check","text":"/// The variants of sum `owner` that pattern `p` matches whole (`Shipped`,\n/// `Paid { .. }`, `Some(x)`, `_`, `x`, `A | B`), or `None` when it matches\n/// some values of one only (a nested pattern, a condition).\nfn pattern_variants(\n  p: ast.Pattern,\n  owner: String,\n  all: List[String],\n) -> Option[Set[String]]\n  ensures match it {\n    Some(vs) => vs.difference(set(all)).len() == 0,\n    None => true,\n  } {\n  match p {\n    ast.Wild => Some(set(all)),\n    ast.Bind(_) => Some(set(all)),\n    ast.CtorPattern { name, args } => {\n      whole := match args {\n        ast.NoPats => true,\n        ast.PositionalPats(ps) => ps.all(q -> q is ast.Wild || q is ast.Bind),\n        ast.RecordPats { fields, .. } => fields.all(fp -> fp.1 is ast.Wild || fp.1 is ast.Bind),\n        ast.TypePats(_) => false,\n      }\n      if !whole {\n        None\n      } else if name == owner {\n        Some(set(all))\n      } else if all.contains(name) {\n        Some(set([name]))\n      } else {\n        None\n      }\n    },\n    ast.OrPat(ps) => {\n      mut out := Set[String] {}\n      for q in ps {\n        match check.pattern_variants(q, owner, all) {\n          Some(vs) => {\n            out = out.union(vs)\n          },\n          None => return None,\n        }\n      }\n      Some(out)\n    },\n    _ => None,\n  }\n}","old_text":"/// The variants of sum `owner` that pattern `p` matches whole (`Shipped`,\n/// `Paid { .. }`, `Some(x)`, `_`, `x`, `A | B`), or `None` when it matches\n/// some values of one only (a nested pattern, a condition).\nfn pattern_variants(\n  p: ast.Pattern,\n  owner: String,\n  all: List[String],\n) -> Option[Set[String]] {\n  match p {\n    ast.Wild => Some(set(all)),\n    ast.Bind(_) => Some(set(all)),\n    ast.CtorPattern { name, args } => {\n      whole := match args {\n        ast.NoPats => true,\n        ast.PositionalPats(ps) => ps.all(q -> q is ast.Wild || q is ast.Bind),\n        ast.RecordPats { fields, .. } => fields.all(fp -> fp.1 is ast.Wild || fp.1 is ast.Bind),\n        ast.TypePats(_) => false,\n      }\n      if !whole {\n        None\n      } else if name == owner {\n        Some(set(all))\n      } else if all.contains(name) {\n        Some(set([name]))\n      } else {\n        None\n      }\n    },\n    ast.OrPat(ps) => {\n      mut out := Set[String] {}\n      for q in ps {\n        match check.pattern_variants(q, owner, all) {\n          Some(vs) => {\n            out = out.union(vs)\n          },\n          None => return None,\n        }\n      }\n      Some(out)\n    },\n    _ => None,\n  }\n}"},{"name":"check.with_field","kind":"fn","old":"2c3e22978cb94fea","new":"9aed030a85bb8c0e","interface_changed":true,"affected":["check.infer_untagged","check.infer","check.infer_spread","check.infer_all","check.binary","check.infer_block","check.infer_call","check.infer_if","check.infer_list","check.infer_match","check.infer_ctor","check.infer_lambda","check.infer_method","check.builtin_call","check.static_call","check.fn_inferred","check.task_body","check.default_errors","check.element_assigned","check.spread_method_params","check.spread_filled","check.iter_builtin","check.fn_errors","check.instantiated","check.fn_lambdas_typed","check.holes_of","check.mark_field_reads","check.own_methods_resolved","check.typed_one","check.decl_type_errors","check.spread_body","check.field_reads","eval_files","instantiated_files","check.lambdas_typed","holes_command","check_summary","finding.uses_of","rename_command","verified_decls","check.typed","check.type_errors_with","check.spreads_resolved","unused.members","command_line","check_command","finding.uses_from","finding.used_by_tree","finding.refs_command","verified_with","static_graph","codegen.new_gen","computed_value","repl_eval","check.type_errors","check_errors_in","literal_errors","expanded","unused.findings","main","strata_command","finding.uses_tree","verified_program","verify_file","build_command","graph_command","graph_diff","tour_graph","codegen.generate","codegen.read_back","comptime_value","repl_command","check_errors_with","edit_errors","literal_errors_of","codegen_with","with_base","unused_of","edit_unused","core_unused","codegen.entry","codegen.compiled_alone","eval.run","smt_file","termination_file","verify_command","build_proofs","alongside_command","search_invariants","diff_command","tour_command","core_rt_text","comptime_values","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","codegen_text","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","run_command","fix_loops","build_core_command","comptime_runner","package_errors","merge_file_command","merged_checks","call_command","edit_command","check_files","move_command","fix_command","edit_in_editor","codegen_file","jit_file","fuzz_file","graph_runs","replay","or_solver_inputs","program_objects","sync_command","check_fn","linked"],"module":"check","text":"/// The variants of `vs` whose payload has field `f`.\nfn with_field(i: check.Inf, vs: List[String], f: String) -> List[String]\n  ensures len(it) <= len(vs) {\n  vs.filter(\n    v -> match get(i.types.ctors, v) {\n      Some(sh) => check.field_of(sh, f) is Some,\n      None => false,\n    },\n  )\n}","old_text":"/// The variants of `vs` whose payload has field `f`.\nfn with_field(i: check.Inf, vs: List[String], f: String) -> List[String] {\n  vs.filter(\n    v -> match get(i.types.ctors, v) {\n      Some(sh) => check.field_of(sh, f) is Some,\n      None => false,\n    },\n  )\n}"}]}
{"id":"874b43b93b22c39c","time":1795722478,"message":"edit","changes":[{"name":"check.narrowed_result","kind":"fn","old":"9db67dbad513a7b5","new":"23447e08a59d639e","interface_changed":false,"affected":[],"module":"check","text":"/// A call's result type, narrowed to the variants `narrowed_at` leaves,\n/// with the sum's type arguments. `ret` itself when nothing is left out\n/// (or the facts contradict).\nfn narrowed_result(\n  i: check.Inf,\n  f: String,\n  args: List[check.Ty],\n  ret: check.Ty,\n) -> check.Ty\n  ensures it == ret\n    || match it {\n      check.TVariants { names, .. } => len(names) > 0,\n      _ => false,\n    } {\n  match (check.res(i, ret), check.narrowed_at(i, f, args, ret)) {\n    (check.TNamed { args: targs, .. }, Some((owner, all, left, _))) => {\n      names := to_list(left).sorted()\n      if len(names) == 0 || len(left) == len(all) {\n        ret\n      } else {\n        check.TVariants { owner, names, args: targs }\n      }\n    },\n    _ => ret,\n  }\n}","old_text":"/// A call's result type, narrowed to the variants `narrowed_at` leaves,\n/// with the sum's type arguments. `ret` itself when nothing is left out\n/// (or the facts contradict).\nfn narrowed_result(\n  i: check.Inf,\n  f: String,\n  args: List[check.Ty],\n  ret: check.Ty,\n) -> check.Ty\n  ensures it == ret\n    || match it {\n      check.TVariants { names, .. } => len(names) > 0,\n      _ => false,\n    } {\n  match (check.res(i, ret), check.narrowed_at(i, f, args, ret)) {\n    (check.TNamed { args: targs, .. }, Some((owner, all, left, _))) => if len(left) == 0 || len(left) == len(all) {\n      ret\n    } else {\n      check.TVariants {\n        owner,\n        names: to_list(left).sorted(),\n        args: targs,\n      }\n    },\n    _ => ret,\n  }\n}"},{"name":"check.narrow_by","kind":"fn","old":"18ef4c1a853ef8f5","new":"748a6ad80135144e","interface_changed":true,"affected":["check.narrowed_at","check.infer_call","check.infer_method","check.narrowed_result","check.infe