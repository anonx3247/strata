ps.any(x -> x.op == v.op && codegen.has_any(x.ty)) {\n      temps := s.temps.map(\n        x ->\n          if x.op == v.op && codegen.has_any(x.ty) {\n            codegen.V { ..x, ty: codegen.better(x.ty, if codegen.is_collection(x.ty) {\n              want\n            } else {\n              codegen.repr(want)\n            }) }\n          } else {\n            x\n          },\n      )\n      codegen.set_scope(mut g, k, codegen.Scope { ..s, temps })\n    }\n    k += 1\n  }\n  v\n}","old_text":"/// `v`, a temporary whose type is now known better (`List[_]` of `dict([])`\n/// made where a `Dict[String, Int]` is wanted). Retyped in its scope too,\n/// so its drop drops its contents.\nfn retype_temp(mut g: codegen.Gen, v: codegen.V, want: Ty) -> codegen.V {\n  if !codegen.counted(v.ty) || codegen.constant(v.op) {\n    return v\n  }\n  mut k := 0\n  while k < len(g.scopes) {\n    s := get(g.scopes, k) ?? codegen.no_scope()\n    if s.temps.any(x -> x.op == v.op && codegen.has_any(x.ty)) {\n      temps := s.temps.map(\n        x ->\n          if x.op == v.op && codegen.has_any(x.ty) {\n            codegen.V { ..x, ty: codegen.better(x.ty, if codegen.is_collection(x.ty) {\n              want\n            } else {\n              codegen.repr(want)\n            }) }\n          } else {\n            x\n          },\n      )\n      codegen.set_scope(mut g, k, codegen.Scope { ..s, temps })\n    }\n    k += 1\n  }\n  v\n}"},{"name":"codegen.by_variant","kind":"fn","old":"9ce66265578a6822","new":"cc617b1a3cedea35","interface_changed":true,"affected":["codegen.method_call","codegen.expr_node","codegen.expr_want_node","codegen.expr","codegen.expr_want","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_exp