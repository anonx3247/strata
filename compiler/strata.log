n.has_any(a)) || codegen.has_any(ret),\n    _ => false,\n  }\n}","old_text":"/// Whether a type has an unknown part (`TAny`).\nfn has_any(t: Ty) -> Bool {\n  match t {\n    TAny => true,\n    TList(a) => codegen.has_any(a),\n    TNamed { args, .. } => args.any(a -> codegen.has_any(a)),\n    TFn { params, ret } => params.any(a -> codegen.has_any(a)) || codegen.has_any(ret),\n    _ => false,\n  }\n}"},{"name":"codegen.to_c","kind":"fn","old":"f7339f270bb3a028","new":"cd7be0763bb95dd0","interface_changed":false,"affected":[],"module":"codegen","text":"/// A value as C takes it. A `String` is a copy to free after the call.\nfn to_c(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  ct: codegen.CType,\n  callee: String,\n) -> String {\n  if ct.kind == \"str\" {\n    codegen.use_rt(mut g, \"strata_cstr\")\n    r := codegen.fresh(mut g, \"toc\")\n    codegen.emit(\n      mut g,\n      f\"{r} = call ptr @strata_cstr(ptr {v.op}, ptr {callee})\",\n    )\n    return r\n  }\n  if ct.kind != \"opt\" {\n    return v.op\n  }\n  // `Some(h)` is `h`, `None` is NULL\n  h := match v.ty {\n    check.TNamed { args: [x], .. } => x,\n    _ => check.TAny,\n  }\n  some := codegen.tag_is(mut g, v, \"Some\")\n  (yes, no, end) := (\n    codegen.label(mut g, \"c.some\"),\n    codegen.label(mut g, \"c.none\"),\n    codegen.label(mut g, \"c.opt\"),\n  )\n  codegen.emit(mut g, f\"br i1 {some.op}, label %{yes}, label %{no}\")\n  codegen.block(mut g, yes)\n  x := codegen.field(mut g, v, 0, h)\n  from := codegen.current(g)\n  codegen.br(mut g, end)\n  codegen.block(mut g, no)\n  codegen.br(mut g, end)\n  codegen.block(mut g, end)\n  r := codegen.fresh(mut g, \"toc\")\n  codegen.emit(\n    mut g,\n    f\"{r} = phi ptr [ {x.op}, %{from} ], [ null, %{no} ]\",\n  )\n  r\n}","old_text":"/// A value as C takes it. A `String` is a copy to free after the call.\nfn to_c(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  ct: codegen.CType,\n  callee: String,\n) -> String {\n  if ct.kind == \"str\" {\n    codegen.use_rt(mut g, \"strata_cstr\")\n    r := codegen.fresh(mut g, \"toc\")\n    codegen.emit(\n      mut g,\n      f\"{r} = call ptr @strata_cstr(ptr {v.op}, ptr {callee})\",\n    )\n    return r\n  }\n  if ct.kind != \"opt\" {\n    return v.op\n  }\n  // `Some(h)` is `h`, `None` is NULL\n  h := match v.ty {\n    TNamed { args: [x], .. } => x,\n    _ => TAny,\n  }\n  some := codegen.tag_is(mut g, v, \"Some\")\n  (yes, no, end) := (\n    codegen.label(mut g, \"c.some\"),\n    codegen.label(mut g, \"c.none\"),\n    codegen.label(mut g, \"c.opt\"),\n  )\n  codegen.emit(mut g, f\"br i1 {some.op}, label %{yes}, label %{no}\")\n  codegen.block(mut g, yes)\n  x := codegen.field(mut g, v, 0, h)\n  from := codegen.current(g)\n  codegen.br(mut g, end)\n  codegen.block(mut g, no)\n  codegen.br(mut g, end)\n  codegen.block(mut g, end)\n  r := codegen.fresh(mut g, \"toc\")\n  codegen.emit(\n    mut g,\n    f\"{r} = phi ptr [ {x.op}, %{from} ], [ null, %{no} ]\",\n  )\n  r\n}"},{"name":"codegen.from_c","kind":"fn","old":"4b0054ced436229c","new":"d2ae3b48052cf453","interface_changed":true,"affected":["codegen.foreign_call","codegen.export_entry","codegen.function","codegen.generate","codegen.compiled_alone","codegen_with","core_rt_text","computed_value","repl_eval","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.entry","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// A value C returned as a value of type `t`. A string is owned.\nfn from_c(\n  mut g: codegen.Gen,\n  raw: String,\n  ct: codegen.CType,\n  t: check.Ty,\n  callee: String,\n  symbol: String,\n) -> codegen.V {\n  if ct.kind == \"str\" {\n    codegen.use_rt(mut g, \"strata_str_from_c\")\n    r := codegen.fresh(mut g, \"fromc\")\n    codegen.emit(\n      mut g,\n      f\"{r} = call ptr @strata_str_from_c(ptr {raw}, ptr {callee})\",\n    )\n    codegen.after_builtin(mut g, \"strata_str_from_c\")\n    return codegen.V { ty: t, op: r }\n  }\n  if ct.kind == \"handle\" {\n    // NULL is no handle: such a result is declared `Option[...]`\n    isnull := codegen.fresh(mut g, \"null\")\n    (bad, good) := (\n      codegen.label(mut g, \"c.null\"),\n      codegen.label(mut g, \"c.handle\"),\n    )\n    codegen.emit(mut g, f\"{isnull} = icmp eq ptr {raw}, null\")\n    codegen.emit(\n      mut g,\n      f\"br i1 {isnull}, label %{bad}, label %{good}\",\n    )\n    codegen.block(mut g, bad)\n    codegen.push_scope(mut g)\n    shown := codegen.opaque_name(t)\n    m := codegen.lit(\n      mut g,\n      f\"`{symbol}` gave NULL for a `{shown}` (declare it `Option[{shown}]` if it can be NULL)\",\n    )\n    codegen.fault(mut g, 4, [m])\n    codegen.discard_scope(mut g)\n    codegen.br(mut g, good)\n    codegen.block(mut g, good)\n    return codegen.V { ty: t, op: raw }\n  }\n  if ct.kind == \"opt\" {\n    h := match t {\n      check.TNamed { args: [x], .. } => x,\n      _ => check.TAny,\n    }\n    o := codegen.optional(mut g, codegen.V { ty: h, op: raw }, t)\n    return codegen.take_value(mut g, o)\n  }\n  codegen.V { ty: t, op: raw }\n}","old_text":"/// A value C returned as a value of type `t`. A string is owned.\nfn from_c(\n  mut g: codegen.Gen,\n  raw: String,\n  ct: codegen.CType,\n  t: Ty,\n  callee: String,\n  symbol: String,\n) -> codegen.V {\n  if ct.kind == \"str\" {\n    codegen.use_rt(mut g, \"strata_str_from_c\")\n    r := codegen.fresh(mut g, \"fromc\")\n    codegen.emit(\n      mut g,\n      f\"{r} = call ptr @strata_str_from_c(ptr {raw}, ptr {callee})\",\n    )\n    codegen.after_builtin(mut g, \"strata_str_from_c\")\n    return codegen.V { ty: t, op: r }\n  }\n  if ct.kind == \"handle\" {\n    // NULL is no handle: such a result is declared `Option[...]`\n    isnull := codegen.fresh(mut g, \"null\")\n    (bad, good) := (\n      codegen.label(mut g, \"c.null\"),\n      codegen.label(mut g, \"c.handle\"),\n    )\n    codegen.emit(mut g, f\"{isnull} = icmp eq ptr {raw}, null\")\n    codegen.emit(\n      mut g,\n      f\"br i1 {isnull}, label %{bad}, label %{good}\",\n    )\n    codegen.block(mut g, bad)\n    codegen.push_scope(mut g)\n    shown := codegen.opaque_name(t)\n    m := codegen.lit(\n      mut g,\n      f\"`{symbol}` gave NULL for a `{shown}` (declare it `Option[{shown}]` if it can be NULL)\",\n    )\n    codegen.fault(mut g, 4, [m])\n    codegen.discard_scope(mut g)\n    codegen.br(mut g, good)\n    codegen.block(mut g, good)\n    return codegen.V { ty: t, op: raw }\n  }\n  if ct.kind == \"opt\" {\n    h := match t {\n      TNamed { args: [x], .. } => x,\n      _ => TAny,\n    }\n    o := codegen.optional(mut g, codegen.V { ty: h, op: raw }, t)\n    return codegen.take_value(mut g, o)\n  }\n  codegen.V { ty: t, op: raw }\n}"},{"name":"codegen.opaque_name","kind":"fn","old":"a38fabff9b0cae5d","new":"80ac539f919b1302","interface_changed":true,"affected":["codegen.shown","codegen.from_c","codegen.show","codegen.destructure","codegen.debug_fields","codegen.for_loop","codegen.debug_list","codegen.builtin","codegen.string_builtin","codegen.format_spec","codegen.dyn_wrapper","codegen.union_text","codegen.checked","codegen.fail_unless","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.fuzz_driver","codegen.trace_enter","c