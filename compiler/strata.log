gen.words_ll(n)\n  (multi, cs) := codegen.small_layout(g, t)\n  saved := g\n  codegen.start_helper(mut g)\n  codegen.emit(mut g, f\"%w0 = insertvalue {ty} undef, ptr null, 0\")\n  if !multi {\n    w := codegen.read_fields(\n      mut g,\n      \"%w0\",\n      (get(cs, 0) ?? (\"\", [])).1,\n      1,\n      n,\n    )\n    codegen.emit(mut g, f\"ret {ty} {w}\")\n  } else {\n    a := codegen.V { ty: t, op: \"%a\" }\n    tg := codegen.tag_of(mut g, a)\n    first := codegen.fresh(mut g, \"words\")\n    codegen.emit(\n      mut g,\n      f\"{first} = insertvalue {ty} %w0, i64 {tg}, 1\",\n    )\n    from := codegen.current(g)\n    with_fields := cs.filter(c -> len(c.1) > 0)\n    mut cases := []\n    mut labels := []\n    for c in with_fields {\n      l := codegen.label(mut g, \"case.\" + codegen.short(c.0))\n      mut labels.push(l)\n      mut cases.push(f\"i64 {codegen.tag_word(g, c.0)}, label %{l}\")\n    }\n    codegen.emit(\n      mut g,\n      f\"switch i64 {tg}, label %done [ {join(cases, \" \")} ]\",\n    )\n    mut incoming := [(first, from)]\n    for (j, c) in enumerate(with_fields) {\n      codegen.block(mut g, get(labels, j) ?? \"\")\n      w := codegen.read_fields(mut g, first, c.1, 2, n)\n      mut incoming.push((w, codegen.current(g)))\n      codegen.br(mut g, \"done\")\n    }\n    codegen.block(mut g, \"done\")\n    r := codegen.fresh(mut g, \"words\")\n    ins := join(incoming.map(x -> f\"[ {x.0}, %{x.1} ]\"), \", \")\n    codegen.emit(mut g, f\"{r} = phi {ty} {ins}\")\n    codegen.emit(mut g, f\"ret {ty} {r}\")\n  }\n  codegen.restore(\n    mut g,\n    saved,\n    codegen.helper_text(g, f\"define internal {ty} {name}(ptr %a)\"),\n  )\n  name\n}","old_text":"/// The function giving the words of a block of small type `t`\n/// (`@\"words:T\"`, behind a null pointer): a copy of the value, each\n/// counted field held once more, the block left to its holders. It reads\n/// only the fields of the block's constructor (a constant `None` has\n/// none).\nfn words_fn(mut g: codegen.Gen, t: Ty) -> String {\n  name := f\"@\\\"words:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  codegen.use_counts(mut g)\n  n := codegen.small_words(g, t)\n  ty := codegen.words_ll(n)\n  (multi, cs) := codegen.small_layout(g, t)\n  saved := g\n  codegen.start_helper(mut g)\n  codegen.emit(mut g, f\"%w0 = insertvalue {ty} undef, ptr null, 0\")\n  if !multi {\n    w := codegen.read_fields(\n      mut g,\n      \"%w0\",\n      (get(cs, 0) ?? (\"\", [])).1,\n      1,\n      n,\n    )\n    codegen.emit(mut g, f\"ret {ty} {w}\")\n  } else {\n    a := codegen.V { ty: t, op: \"%a\" }\n    tg := codegen.tag_of(mut g, a)\n    first := codegen.fresh(mut g, \"words\")\n    codegen.emit(\n      mut g,\n      f\"{first} = insertvalue {ty} %w0, i64 {tg}, 1\",\n    )\n    from := codegen.current(g)\n    with_fields := cs.filter(c -> len(c.1) > 0)\n    mut cases := []\n    mut labels := []\n    for c in with_fields {\n      l := codegen.label(mut g, \"case.\" + codegen.short(c.0))\n      mut labels.push(l)\n      mut cases.push(f\"i64 {codegen.tag_word(g, c.0)}, label %{l}\")\n    }\n    codegen.emit(\n      mut g,\n      f\"switch i64 {tg}, label %done [ {join(cases, \" \")} ]\",\n    )\n    mut incoming := [(first, from)]\n    for (j, c) in enumerate(with_fields) {\n      codegen.block(mut g, get(labels, j) ?? \"\")\n      w := codegen.read_fields(mut g, first, c.1, 2, n)\n      mut incoming.push((w, codegen.current(g)))\n      codegen.br(mut g, \"done\")\n    }\n    codegen.block(mut g, \"done\")\n    r := codegen.fresh(mut g, \"words\")\n    ins := join(incoming.map(x -> f\"[ {x.0}, %{x.1} ]\"), \", \")\n    codegen.emit(mut g, f\"{r} = phi {ty} {ins}\")\n    codegen.emit(mut g, f\"ret {ty} {r}\")\n  }\n  codegen.restore(\n    mut g,\n    saved,\n    codegen.helper_text(g, f\"define internal {ty} {name}(ptr %a)\"),\n  )\n  name\n}"},{"name":"codegen.read_fields","kind":"fn","old":"112ee00102