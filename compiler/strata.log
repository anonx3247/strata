       v\n      },\n    )\n  }\n  for i in 0..len(rest) {\n    mut vs.push(get(got, i) ?? codegen.unit())\n    mut tys.push(get(got_ty, i) ?? TAny)\n  }\n  // the bounds bind more (`I: FiniteIterator[T]` with `I` known)\n  m = codegen.bind_bounds(mut g, f, m)\n  // the wanted result binds what the arguments leave open\n  for (p, x) in codegen.bind_gen(rt, want, Dict[String, Ty] {}) {\n    mut m.insert(p, codegen.better(get(m, p) ?? TAny, x))\n  }\n  // trait parameters given values of known types: an instance for them\n  (fk, ff) := codegen.for_impls(mut g, k, f, pts, tys)\n  for (i, t) in enumerate(tys) {\n    if contains(ff.type_params, \"impl.\" + to_string(i)) {\n      mut m.insert(\"impl.\" + to_string(i), t)\n    }\n  }\n  mut sub := Dict[String, Ty] {}\n  // the written type arguments, refined ones kept (`T` a `List[Port]`)\n  for (p, w) in codegen.written_args(g, k, ff, want, pending) {\n    mut sub.insert(\"$w:\" + p, w)\n  }\n  for p in ff.type_params {\n    // a copy `derive` made for a generic type (`decode_as.for.Pair.5`) is\n    // generic in the type's parameters. Its caller, made for the same type,\n    // knows them when the arguments don't.\n    x := get(m, p) ?? TAny\n    t := if x is TAny && contains(k, \".for.\") {\n      get(g.sub, p) ?? TAny\n    } else {\n      x\n    }\n    mut m.insert(p, t)\n    mut sub.insert(p, codegen.ground(t))\n  }\n  // std.memory's arenas: `f` runs with its allocations in an arena. Their\n  // Strata body, `f()`, is the fallback without arenas.\n  if (k == \"std.memory.arena\" || k == \"std.memory.arena_kept\")\n    && len(vs) == 1 {\n    rt0 := codegen.ground(inst(rt, m))\n    f0 := get(vs, 0) ?? codegen.unit()\n    if on_stack {\n      g.stack_made = []\n    }\n    return codegen.arena_run(\n      mut g,\n      codegen.V { ..f0, ty: TFn { params: [], ret: rt0 } },\n      k == \"std.memory.arena_kept\",\n    )\n  }\n  sym := codegen.instance(mut g, fk, ff, sub)\n  // std's precompiled code leaves argument checks to