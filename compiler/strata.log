h(codegen.shown(mut g, x))\n  }\n  parts\n}","old_text":"/// The parts showing each field: `name: value, …`, or `value, …` unnamed.\nfn debug_fields(\n  mut g: codegen.Gen,\n  a: codegen.V,\n  fs: List[(String, Ty)],\n) -> List[codegen.V] {\n  mut parts := []\n  for (k, f) in enumerate(fs) {\n    if k > 0 {\n      mut parts.push(codegen.lit(mut g, \", \"))\n    }\n    if f.0 != \"\" {\n      mut parts.push(codegen.lit(mut g, f.0 + \": \"))\n    }\n    x := codegen.field(mut g, a, k, f.1)\n    mut parts.push(codegen.shown(mut g, x))\n  }\n  parts\n}"},{"name":"codegen.Scope","kind":"type","old":"ba487e37beb47374","new":"ddc9327319f23518","interface_changed":true,"affected":["codegen.Gen","codegen.push_scope","codegen.local","codegen.function","codegen.push_transparent","codegen.no_scope","codegen.set_scope","codegen.own_slot","codegen.temp","codegen.take_value","codegen.drop_scope","codegen.local_at","codegen.scope_expr","codegen.race_expr","codegen.retype","codegen.construct_want","codegen.retype_temp","codegen.mark_stacked","codegen.local_value","codegen.untemp","codegen.var_code","codegen.lower","codegen.not_yet","codegen.emit","codegen.fresh","codegen.label","codegen.block","codegen.br","codegen.dead","codegen.current","codegen.use_rt","codegen.call","codegen.string","codegen.pop_scope","codegen.lookup","codegen.store","codegen.load","codegen.entry","codegen.expr","codegen.int_lit","codegen.operands","codegen.call_named","codegen.show","codegen.shown","codegen.concat","codegen.interp","codegen.if_expr","codegen.join_values","codegen.binary","codegen.logic","codegen.apply","codegen.bad_op","codegen.finite","codegen.compare","codegen.equal","codegen.int_op","codegen.bit_op","codegen.int_compare","codegen.stmt","codegen.declare","codegen.assertion","codegen.fields_of","codegen.ctors_of","codegen.call_at","codegen.fault","codegen.lit","codegen.to_slot","codegen.from_slot","codegen.block_of","codegen.field","codegen.tag_of","codegen.tag_is","codegen.nullary","codegen.