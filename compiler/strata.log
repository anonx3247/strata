as = []\n  g.next = 0\n  g.scopes = [codegen.no_scope()]\n  g.loops = []\n  codegen.block(mut g, \"start\")\n  codegen.emit(mut g, \"%gone = call i1 @strata.release(ptr %a)\")\n  codegen.emit(mut g, \"br i1 %gone, label %last, label %kept\")\n  codegen.block(mut g, \"last\")\n  a := codegen.V { ty: t, op: \"%a\" }\n  match t {\n    check.TList(et) => codegen.drop_list(mut g, et),\n    check.TTrait(_) => {\n      // the value by its table's drop, then the pair\n      codegen.emit(mut g, \"%vraw = load i64, ptr %a\")\n      codegen.emit(mut g, \"%vt = inttoptr i64 %vraw to ptr\")\n      codegen.emit(mut g, \"%sp = getelementptr i64, ptr %a, i64 1\")\n      codegen.emit(mut g, \"%s = load i64, ptr %sp\")\n      codegen.emit(mut g, \"%dropp = load ptr, ptr %vt\")\n      codegen.emit(mut g, \"call void @strata_free(ptr %a)\")\n      codegen.emit(mut g, \"call void %dropp(i64 %s)\")\n      codegen.br(mut g, \"kept\")\n    },\n    check.TFn { .. } => {\n      // the closure's own drop: its captures, then itself\n      codegen.emit(mut g, \"%dp = getelementptr i64, ptr %a, i64 1\")\n      codegen.emit(mut g, \"%draw = load i64, ptr %dp\")\n      codegen.emit(mut g, \"%d = inttoptr i64 %draw to ptr\")\n      codegen.emit(mut g, \"call void %d(ptr %a)\")\n      codegen.br(mut g, \"kept\")\n    },\n    check.TNamed { name: \"Tuple\", args } => codegen.drop_fields(mut g, a, args),\n    check.TNamed { .. } => {\n      cs := codegen.ctors_of(g, t).filter(\n        c -> len(codegen.fields_of(g, c, t)) > 0,\n      )\n      if len(cs) == 1 {\n        codegen.drop_fields(\n          mut g,\n          a,\n          codegen.fields_of(g, get(cs, 0) ?? \"\", t).map(f -> f.1),\n        )\n      } else if len(cs) > 1 {\n        labels := codegen.on_ctor(mut g, a, cs)\n        for (k, c) in enumerate(cs) {\n          codegen.block(mut g, get(labels, k) ?? \"\")\n          codegen.drop_fields(\n            mut g,\n            a,\n            codegen.fields_of(g, c, t).map(f -> f.1),\n          )\n        }\n      } else {\n        // only constants here: never the last holder\n        codegen.emit(mut g, \"call void @strata_free(ptr %a)\")\n        codegen.br(mut g, \"kept\")\n      }\n    },\n    _ => {\n      codegen.emit(mut g, \"call void @strata_free(ptr %a)\")\n      codegen.br(mut g, \"kept\")\n    },\n  }\n  codegen.block(mut g, \"kept\")\n  codegen.emit(mut g, \"ret void\")\n  def := join([f\"define void {name}(ptr %a) {{\"]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, def)\n  name\n}","old_text":"/// The function dropping a value of type `t`: one fewer holder, and on the\n/// last, the block freed and what it held dropped.\nfn drop_fn(mut g: codegen.Gen, t: Ty) -> String {\n  name := f\"@\\\"drop:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  // a channel end: a runtime object\n  match t {\n    TNamed { name: \"Sender\", .. } | TNamed { name: \"Receiver\", .. } => {\n      codegen.use_rt(mut g, \"strata_channel_drop\")\n      mut g.helper_defs.push(\n        f\"define void {name}(ptr %a) {{\\nstart:\\n  tail call void @strata_channel_drop(ptr %a)\\n  ret void\\n}}\\n\",\n      )\n      return name\n    },\n    _ => (),\n  }\n  codegen.use_counts(mut g)\n  codegen.use_rt(mut g, \"strata_free\")\n  saved := g\n  g.lines = []\n  g.proving = \"\"\n  g.can_unwind = false\n  g.unwinds = false\n  g.unwind_chain = []\n  g.allocas = []\n  g.next = 0\n  g.scopes = [codegen.no_scope()]\n  g.loops = []\n  codegen.block(mut g, \"start\")\n  codegen.emit(mut g, \"%gone = call i1 @strata.release(ptr %a)\")\n  codegen.emit(mut g, \"br i1 %gone, label %last, label %kept\")\n  codegen.block(mut g, \"last\")\n  a := codegen.V { ty: t, op: \"%a\" }\n  match t {\n    TList(et) => codegen.drop_list(mut g, et),\n    TTrait(_) => {\n      // the value by its table's drop, then the pair\n      codegen.emit(mut g, \"%vraw = load i64, ptr %a\")\n      codegen.emit(mut g, \"%vt = inttoptr i64 %vraw to ptr\")\n      codegen.emit(mut g, \"%sp = getelementptr i64, ptr %a, i64 1\")\n      codegen.emit(mut g, \"%s = load i64, ptr %sp\")\n      codegen.emit(mut g, \"%dropp = load ptr, ptr %vt\")\n      codegen.emit(mut g, \"call void @strata_free(ptr %a)\")\n      codegen.emit(mut g, \"call void %dropp(i64 %s)\")\n      codegen.br(mut g, \"kept\")\n    },\n    TFn { .. } => {\n      // the closure's own drop: its captures, then itself\n      codegen.emit(mut g, \"%dp = getelementptr i64, ptr %a, i64 1\")\n      codegen.emit(mut g, \"%draw = load i64, ptr %dp\")\n      codegen.emit(mut g, \"%d = inttoptr i64 %draw to ptr\")\n      codegen.emit(mut g, \"call void %d(ptr %a)\")\n      codegen.br(mut g, \"kept\")\n    },\n    TNamed { name: \"Tuple\", args } => codegen.drop_fields(mut g, a, args),\n    TNamed { .. } => {\n      cs := codegen.ctors_of(g, t).filter(\n        c -> len(codegen.fields_of(g, c, t)) > 0,\n      )\n      if len(cs) == 1 {\n        codegen.drop_fields(\n          mut g,\n          a,\n          codegen.fields_of(g, get(cs, 0) ?? \"\", t).map(f -> f.1),\n        )\n      } else if len(cs) > 1 {\n        labels := codegen.on_ctor(mut g, a, cs)\n        for (k, c) in enumerate(cs) {\n          codegen.block(mut g, get(labels, k) ?? \"\")\n          codegen.drop_fields(\n            mut g,\n            a,\n            codegen.fields_of(g, c, t).map(f -> f.1),\n          )\n        }\n      } else {\n        // only constants here: never the last holder\n        codegen.emit(mut g, \"call void @strata_free(ptr %a)\")\n        codegen.br(mut g, \"kept\")\n      }\n    },\n    _ => {\n      codegen.emit(mut g, \"call void @strata_free(ptr %a)\")\n      codegen.br(mut g, \"kept\")\n    },\n  }\n  codegen.block(mut g, \"kept\")\n  codegen.emit(mut g, \"ret void\")\n  def := join([f\"define void {name}(ptr %a) {{\"]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, def)\n  name\n}"},{"name":"codegen.drop_fields","kind":"fn","old":"1b18de4495855632","new":"45e84f7bc85ddd89","interface_changed":true,"affected":["codegen.drop_fn","codegen.drop_value","codegen.tail_drop","codegen.function","codegen.drop_scope","codegen.debug_list","codegen.drop_list","codegen.closure","codegen.collection_builtin","codegen.call_fn_want","codegen.builtin_call","codegen.dyn_wrapper","codegen.set_path","codegen.replace_var","codegen.union_drop","codegen.task_fns","codegen.await_list","codegen.slot_drop_fn","codegen.select_expr","codegen.foreign_call","codegen.tries_end","codegen.gen_list","codegen.drop_stacked","codegen.set_field_in_place","codegen.update_in_place","codegen.arena_run","codegen.unwind_all","codegen.swap_in","codegen.take_in_place","codegen.stmt_node","codegen.session_entry","codegen.drop_counted","codegen.drop_held","codegen.unbox_fn","codegen.assign_held","codegen.compiled_alone","codegen.pop_scope","codegen.drop_from","codegen.helper","codegen.order_closure","codegen.lambda_shown","codegen.builtin","codegen.converted","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.except_expr","codegen.matching_want","codegen.vtable","codegen.union_set","codegen.assign_at","codegen.spawn_expr","codegen.supervised_fns","codegen.await_expr","codegen.channel_new","codegen.expr_node","codegen.produce","codegen.gen_data","codegen.mock_method","codegen.unwind_here","codegen.cancel_point_after","codegen.put_in","codegen.stmt","codegen.generate","codegen.fields_drop_fn","codegen.words_value","codegen.tag_is","codegen.leave_branch","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.block_expr","codegen.with_it","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.invariants","codegen.iterate","codegen.race_expr","codegen.satisfies"