en.V {\n  n := match want {\n    TFn { params, .. } => len(params),\n    _ => 1,\n  }\n  mut ps := []\n  for k in 0..n {\n    mut ps.push(f\"$p{k}\")\n  }\n  body := ast.MethodCall {\n    recv: ast.Var(\"$p0\"),\n    name,\n    args: drop(ps, 1).map(p -> ast.Var(p)),\n  }\n  codegen.lambda(\n    mut g,\n    ps.map(p -> ast.LamParam { name: p, ty: None }),\n    body,\n    want,\n  )\n}"},{"name":"codegen.self_want","kind":"fn","old":"6b6b3fa29a33d3b8","new":"9e2a6a8362cecf59","interface_changed":true,"affected":["codegen.method_call","codegen.expr_node","codegen.expr_want_node","codegen.expr","codegen.expr_want","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.try_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.compared","codegen.stmt_node","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.function","codegen.declare","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.fuzz_driver","codegen.wanted","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.binds","codegen.matching_v","codegen.assertion","codegen.invariants","codegen.tag_is","codegen.check_type","codegen.satisfie