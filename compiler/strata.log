osure","codegen.cmp_fields","codegen.union_cmp","codegen.hash_fields","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// Ends a stack block: only what it holds is dropped. A small value's block\n/// (`stack_ops`) drops the fields of its constructor (`fields_drop_fn`).\nfn drop_stacked(mut g: codegen.Gen, v: codegen.V, tys: List[check.Ty]) {\n  if contains(g.stack_ops, v.op) || tys == [check.TAny] {\n    codegen.use_counts(mut g)\n    f := codegen.fields_drop_fn(mut g, v.ty)\n    codegen.emit(mut g, f\"call void {f}(ptr {v.op})\")\n    return\n  }\n  for (k, ft) in enumerate(tys) {\n    if codegen.counted(ft) {\n      f := codegen.field(mut g, v, k, ft)\n      codegen.drop_value(mut g, f)\n    }\n  }\n}","old_text":"/// Ends a stack block: only what it holds is dropped. A small value's block\n/// (`stack_ops`) drops the fields of its constructor (`fields_drop_fn`).\nfn drop_stacked(mut g: codegen.Gen, v: codegen.V, tys: List[Ty]) {\n  if contains(g.stack_ops, v.op) || tys == [TAny] {\n    codegen.use_counts(mut g)\n    f := codegen.fields_drop_fn(mut g, v.ty)\n    codegen.emit(mut g, f\"call void {f}(ptr {v.op})\")\n    return\n  }\n  for (k, ft) in enumerate(tys) {\n    if codegen.counted(ft) {\n      f := codegen.field(mut g, v, k, ft)\n      codegen.drop_value(mut g, f)\n    }\n  }\n}"},{"name":"codegen.update_in_place","kind":"fn","old":"3f97a93704485e9d","new":"d12284be9c11b74c","interface_changed":false,"affected":[],"module":"codegen","text":"/// `x = insert(x, …)` and `x.f = remove(x.f, …)` on a dict or set, where\n/// `value` is the assigned value and `place` the assigned place.\n/// The old value is dead afterwards. When nothing else holds it (the\n/// table, its lists and their buffers held once, and for a field, the\n/// record too), the element goes in or out in place without a copy. Else\n/// the built-in runs.\n/// The result is owned either way. In place, the table is held once more,\n/// given back when the old value is dropped. `None` when `value` is not\n/// such a call. `xs = take(xs, n)` and `xs = xs[..n]` go to `take_in_place`.\nfn update_in_place(\n  mut g: codegen.Gen,\n  place: ast.Expr,\n  value: ast.Expr,\n) -> Option[codegen.V] {\n  match value {\n    ast.Call { callee: ast.Var(\"set_at\"), .. } => return codegen.set_in_place(mut g, place, value, None),\n    _ => (),\n  }\n  (name, target, rest) := match value {\n    ast.Call { callee: ast.Var(n), args } => match args {\n      [t, ..more] => (n, t, more),\n      [] => return None,\n    },\n    ast.MethodCall { recv, name: n, args } => (n, recv, args),\n    _ => return None,\n  }\n  if name == \"take\" {\n    return codegen.take_in_place(mut g, place, target, rest)\n  }\n  // `xs = xs[..n]` (`slice(xs, 0, n)`) is `take(xs, n)`\n  if name == \"slice\"\n    && codegen.lookup(g, \"slice\") is None\n    && !codegen.has_fn(g, \"slice\") {\n    match rest {\n      [ast.IntLit(0), n] => return codegen.take_in_place(mut g, place, target, [n]),\n      _ => (),\n    }\n  }\n  if name == \"push\" {\n    return codegen.push_in_place(mut g, place, target, rest)\n  }\n  if name != \"insert\" && name != \"remove\" {\n    return None\n  }\n  removing := name == \"remove\"\n  (root, path) := match codegen.place_of(place) {\n    Some(p) => p,\n    None => return None,\n  }\n  rl := match codegen.lookup(g, root) {\n    Some(l) => l,\n    None => return None,\n  }\n  if !codegen.walkable(g, rl.ty, path) {\n    return None\n  }\n  // The built-in runs on the place itself, with the other arguments read\n  // first as they are: if one were the place's variable or a part of it,\n  // it would be put inside itself. A value made from the place holds it\n  // (`push(get(d, k) ?? [], x)` reads `d`), which the count check below sees.\n  if target != place\n    || codegen.lookup(g, name) is Some\n    || codegen.has_fn(g, name)\n    || rest.any(\n      a -> match codegen.place_of(a) {\n        Some((x, _)) => x == root,\n        None => false,\n      },\n    ) {\n    return None\n  }\n  cur := codegen.expr(mut g, target)\n  (kind, targs) := match cur.ty {\n    check.TNamed { name: n, args } => if n == \"Set\" || n == \"Dict\" {\n      (n, args)\n    } else {\n      return None\n    },\n    _ => return None,\n  }\n  if len(rest) != if kind == \"Set\" || removing {\n    1\n  } else {\n    2\n  } {\n    return None\n  }\n  vs0 := match codegen.operands(mut g, rest) {\n    Some(vs) => vs,\n    None => return Some(codegen.never()),\n  }\n  mut vs := []\n  for (i, v) in enumerate(vs0) {\n    mut vs.push(\n      codegen.converted(mut g, v, get(targs, i) ?? check.TAny),\n    )\n  }\n  et := codegen.entry_ty(cur.ty)\n  k0 := get(targs, 0) ?? check.TAny\n  // held once: the table, and the record holding it\n  proven := g.proven_root == root\n  owned := codegen.held_test(\n    mut g,\n    \"strata_tbl_owned\",\n    cur.op,\n    proven && path == [],\n  )\n  ok := if path == [] {\n    owned\n  } else {\n    u := codegen.held_once_on(\n      mut g,\n      codegen.load(mut g, rl),\n      path,\n      proven,\n    )\n    both := codegen.fresh(mut g, \"owned\")\n    codegen.emit(mut g, f\"{both} = and i1 {owned}, {u}\")\n    both\n  }\n  (here, copy, done) := (\n    codegen.label(mut g, \"update.here\"),\n    codegen.label(mut g, \"update.copy\"),\n    codegen.label(mut g, \"update.done\"),\n  )\n  codegen.emit(mut g, f\"br i1 {ok}, label %{here}, label %{copy}\")\n  codegen.block(mut g, here)\n  codegen.push_transparent(mut g)\n  fs := codegen.table_fns(mut g, cur.ty)\n  (h, dict) := (\n    (get(fs, 0) ?? codegen.unit()).op,\n    (get(fs, 2) ?? codegen.unit()).op,\n  )\n  at := codegen.table_find(\n    mut g,\n    cur,\n    get(vs, 0) ?? codegen.unit(),\n    k0,\n    fs,\n  )\n  found := codegen.fresh(mut g, \"found\")\n  codegen.emit(mut g, f\"{found} = icmp sge i64 {at.op}, 0\")\n  if removing {\n    // out of place: the element or key's pair found, then dropped\n    (out, kept) := (\n      codegen.label(mut g, \"remove.out\"),\n      codegen.label(mut g, \"remove.kept\"),\n    )\n    codegen.emit(\n      mut g,\n      f\"br i1 {found}, label %{out}, label %{kept}\",\n    )\n    codegen.block(mut g, out)\n    codegen.use_rt(mut g, \"strata_tbl_remove_at\")\n    old := codegen.fresh(mut g, \"old\")\n    codegen.emit(\n      mut g,\n      f\"{old} = call i64 @strata_tbl_remove_at(ptr {cur.op}, i64 {at.op}, ptr {h}, i64 {dict})\",\n    )\n    ov := codegen.from_slot(mut g, old, et)\n    codegen.drop_value(mut g, ov)\n    codegen.br(mut g, kept)\n    codegen.block(mut g, kept)\n  } else {\n    // in: the element, in its key's place or after the others. The values\n    // are held once more: the statement's end drops them as on the copy\n    // path.\n    for v in vs {\n      if codegen.counted(v.ty) && !codegen.constant(v.op) {\n        codegen.dup_value(mut g, v)\n      }\n    }\n    mut slots := []\n    for v in vs {\n      mut slots.push(codegen.to_slot(mut g, v))\n    }\n    elem := if kind == \"Set\" {\n      get(slots, 0) ?? \"0\"\n    } else {\n      codegen.use_rt(mut g, \"strata_alloc\")\n      (p, a, b, s) := (\n        codegen.fresh(mut g, \"pair\"),\n        codegen.fresh(mut g, \"at\"),\n        codegen.fresh(mut g, \"at\"),\n        codegen.fresh(mut g, \"slot\"),\n      )\n      codegen.emit(mut g, f\"{p} = call ptr @strata_alloc(i64 24)\")\n      codegen.emit(mut g, f\"store i64 0, ptr {p}\")\n      codegen.emit(\n        mut g,\n        f\"{a} = getelementptr i64, ptr {p}, i64 1\",\n      )\n      codegen.emit(\n        mut g,\n        f\"store i64 {get(slots, 0) ?? \"0\"}, ptr {a}\",\n      )\n      codegen.emit(\n        mut g,\n        f\"{b} = getelementptr i64, ptr {p}, i64 2\",\n      )\n      codegen.emit(\n        mut g,\n        f\"store i64 {get(slots, 1) ?? \"0\"}, ptr {b}\",\n      )\n      codegen.emit(mut g, f\"{s} = ptrtoint ptr {p} to i64\")\n      s\n    }\n    (put, add, placed) := (\n      codegen.label(mut g, \"insert.put\"),\n      codegen.label(mut g, \"insert.add\"),\n      codegen.label(mut g, \"insert.placed\"),\n    )\n    codegen.emit(\n      mut g,\n      f\"br i1 {found}, label %{put}, label %{add}\",\n    )\n    codegen.block(mut g, put)\n    if kind == \"Set\" {\n      // an element already there is kept, and the new one dropped\n      xv := codegen.from_slot(mut g, elem, et)\n      codegen.drop_value(mut g, xv)\n    } else {\n      es := codegen.list_view(mut g, cur)\n      codegen.use_rt(mut g, \"strata_list_put\")\n      old := codegen.fresh(mut g, \"old\")\n      codegen.emit(\n        mut g,\n        f\"{old} = call i64 @strata_list_put(ptr {es.op}, i64 {at.op}, i64 {elem})\",\n      )\n      ov := codegen.from_slot(mut g, old, et)\n      codegen.drop_value(mut g, ov)\n    }\n    codegen.br(mut g, placed)\n    codegen.block(mut g, add)\n    codegen.use_rt(mut g, \"strata_tbl_add\")\n    codegen.emit(\n      mut g,\n      f\"call void @strata_tbl_add(ptr {cur.op}, i64 {elem}, ptr {h}, i64 {dict})\",\n    )\n    codegen.br(mut g, placed)\n    codegen.block(mut g, placed)\n  }\n  codegen.dup_value(mut g, cur)\n  codegen.pop_scope(mut g)\n  from_here := codegen.current(g)\n  codegen.br(mut g, done)\n  // else a new one, as the built-in makes it\n  codegen.block(mut g, copy)\n  codegen.push_transparent(mut g)\n  if g.copies {\n    codegen.note_copy(mut g, 1, cur, 0, \"\")\n  }\n  g.in_update = true\n  made := codegen.collection_builtin(mut g, name, [cur] + vs)\n  g.in_update = false\n  r := codegen.leave_branch(mut g, made)\n  from_copy := codegen.current(g)\n  codegen.br(mut g, done)\n  codegen.block(mut g, done)\n  p := codegen.fresh(mut g, \"updated\")\n  codegen.emit(\n    mut g,\n    f\"{p} = phi ptr [ {cur.op}, %{from_here} ], [ {r.op}, %{from_copy} ]\",\n  )\n  Some(codegen.temp(mut g, codegen.V { ty: cur.ty, op: p }))\n}","old_text":"/// `x = insert(x, …)` and `x.f = remove(x.f, …)` on a dict or set, where\n/// `value` is the assigned value and `place` the assigned place.\n/// The old value is dead afterwards. When nothing else holds it (the\n/// table, its lists and their buffers held once, and for a field, the\n/// record too), the element goes in or out in place without a copy. Else\n/// the built-in runs.\n/// The result is owned either way. In place, the table is held once more,\n/// given back when the old value is dropped. `None` when `value` is not\n/// such a call. `xs = take(xs, n)` and `xs = xs[..n]` go to `take_in_place`.\nfn update_in_place(\n  mut g: codegen.Gen,\n  place: ast.Expr,\n  value: ast.Expr,\n) -> Option[codegen.V] {\n  match value {\n    ast.Call { callee: ast.Var(\"set_at\"), .. } => return codegen.set_in_place(mut g, place, value, None),\n    _ => (),\n  }\n  (name, target, rest) := match value {\n    ast.Call { callee: ast.Var(n), args } => match args {\n      [t, ..more] => (n, t, more),\n      [] => return None,\n    },\n    ast.MethodCall { recv, name: n, args } => (n, recv, args),\n    _ => return None,\n  }\n  if name == \"take\" {\n    return codegen.take_in_place(mut g, place, target, rest)\n  }\n  // `xs = xs[..n]` (`slice(xs, 0, n)`) is `take(xs, n)`\n  if name == \"slice\"\n    && codegen.lookup(g, \"slice\") is None\n    && !codegen.has_fn(g, \"slice\") {\n    match rest {\n      [ast.IntLit(0), n] => return codegen.take_in_place(mut g, place, target, [n]),\n      _ => (),\n    }\n  }\n  if name == \"push\" {\n    return codegen.push_in_place(mut g, place, target, rest)\n  }\n  if name != \"insert\" && name != \"remove\" {\n    return None\n  }\n  removing := name == \"remove\"\n  (root, path) := match codegen.place_of(place) {\n    Some(p) => p,\n    None => return None,\n  }\n  rl := match codegen.lookup(g, root) {\n    Some(l) => l,\n    None => return None,\n  }\n  if !codegen.walkable(g, rl.ty, path) {\n    return None\n  }\n  // The built-in runs on the place itself, with the other arguments read\n  // first as they are: if one were the place's variable or a part of it,\n  // it would be put inside itself. A value made from the place holds it\n  // (`push(get(d, k) ?? [], x)` reads `d`), which the count check below sees.\n  if target != place\n    || codegen.lookup(g, name) is Some\n    || codegen.has_fn(g, name)\n    || rest.any(\n      a -> match codegen.place_of(a) {\n        Some((x, _)) => x == root,\n        None => false,\n      },\n    ) {\n    return None\n  }\n  cur := codegen.expr(mut g, target)\n  (kind, targs) := match cur.ty {\n    TNamed { name: n, args } => if n == \"Set\" || n == \"Dict\" {\n      (n, args)\n    } else {\n      return None\n    },\n    _ => return None,\n  }\n  if len(rest) != if kind == \"Set\" || removing {\n    1\n  } else {\n    2\n  } {\n    return None\n  }\n  vs0 := match codegen.operands(mut g, rest) {\n    Some(vs) => vs,\n    None => return Some(codegen.never()),\n  }\n  mut vs := []\n  for (i, v) in enumerate(vs0) {\n    mut vs.push(codegen.converted(mut g, v, get(targs, i) ?? TAny))\n  }\n  et := codegen.entry_ty(cur.ty)\n  k0 := get(targs, 0) ?? TAny\n  // held once: the table, and the record holding it\n  proven := g.proven_root == root\n  owned := codegen.held_test(\n    mut g,\n    \"strata_tbl_owned\",\n    cur.op,\n    proven && path == [],\n  )\n  ok := if path == [] {\n    owned\n  } else {\n    u := codegen.held_once_on(\n      mut g,\n      codegen.load(mut g, rl),\n      path,\n      proven,\n    )\n    both := codegen.fresh(mut g, \"owned\")\n    codegen.emit(mut g, f\"{both} = and i1 {owned}, {u}\")\n    both\n  }\n  (here, copy, done) := (\n    codegen.label(mut g, \"update.here\"),\n    codegen.label(mut g, \"update.copy\"),\n    codegen.label(mut g, \"update.done\"),\n  )\n  codegen.emit(mut g, f\"br i1 {ok}, label %{here}, label %{copy}\")\n  codegen.block(mut g, here)\n  codegen.push_transparent(mut g)\n  fs := codegen.table_fns(mut g, cur.ty)\n  (h, dict) := (\n    (get(fs, 0) ?? codegen.unit()).op,\n    (get(fs, 2) ?? codegen.unit()).op,\n  )\n  at := codegen.table_find(\n    mut g,\n    cur,\n    get(vs, 0) ?? codegen.unit(),\n    k0,\n    fs,\n  )\n  found := codegen.fresh(mut g, \"found\")\n  codegen.emit(mut g, f\"{found} = icmp sge i64 {at.op}, 0\")\n  if removing {\n    // out of place: the element or key's pair found, then dropped\n    (out, kept) := (\n      codegen.label(mut g, \"remove.out\"),\n      codegen.label(mut g, \"remove.kept\"),\n    )\n    codegen.emit(\n      mut g,\n      f\"br i1 {found}, label %{out}, label %{kept}\",\n    )\n    codegen.block(mut g, out)\n    codegen.use_rt(mut g, \"strata_tbl_remove_at\")\n    old := codegen.fresh(mut g, \"old\")\n    codegen.emit(\n      mut g,\n      f\"{old} = call i64 @strata_tbl_remove_at(ptr {cur.op}, i64 {at.op}, ptr {h}, i64 {dict})\",\n    )\n    ov := codegen.from_slot(mut g, old, et)\n    codegen.drop_value(mut g, ov)\n    codegen.br(mut g, kept)\n    codegen.block(mut g, kept)\n  } else {\n    // in: the element, in its key's place or after the others. The values\n    // are held once more: the statement's end drops them as on the copy\n    // path.\n    for v in vs {\n      if codegen.counted(v.ty) && !codegen.constant(v.op) {\n        codegen.dup_value(mut g, v)\n      }\n    }\n    mut slots := []\n    for v in vs {\n      mut slots.push(codegen.to_slot(mut g, v))\n    }\n    elem := if kind == \"Set\" {\n      get(slots, 0) ?? \"0\"\n    } else {\n      codegen.use_rt(mut g, \"strata_alloc\")\n      (p, a, b, s) := (\n        codegen.fresh(mut g, \"pair\"),\n        codegen.fresh(mut g, \"at\"),\n        codegen.fresh(mut g, \"at\"),\n        codegen.fresh(mut g, \"slot\"),\n      )\n      codegen.emit(mut g, f\"{p} = call ptr @strata_alloc(i64 24)\")\n      codegen.emit(mut g, f\"store i64 0, ptr {p}\")\n      codegen.emit(\n        mut g,\n        f\"{a} = getelementptr i64, ptr {p}, i64 1\",\n      )\n      codegen.emit(\n        mut g,\n        f\"store i64 {get(slots, 0) ?? \"0\"}, ptr {a}\",\n      )\n      codegen.emit(\n        mut g,\n        f\"{b} = getelementptr i64, ptr {p}, i64 2\",\n      )\n      codegen.emit(\n        mut g,\n        f\"store i64 {get(slots, 1) ?? \"0\"}, ptr {b}\",\n      )\n      codegen.emit(mut g, f\"{s} = ptrtoint ptr {p} to i64\")\n      s\n    }\n    (put, add, placed) := (\n      codegen.label(mut g, \"insert.put\"),\n      codegen.label(mut g, \"insert.add\"),\n      codegen.label(mut g, \"insert.placed\"),\n    )\n    codegen.emit(\n      mut g,\n      f\"br i1 {found}, label %{put}, label %{add}\",\n    )\n    codegen.block(mut g, put)\n    if kind == \"Set\" {\n      // an element already there is kept, and the new one dropped\n      xv := codegen.from_slot(mut g, elem, et)\n      codegen.drop_value(mut g, xv)\n    } else {\n      es := codegen.list_view(mut g, cur)\n      codegen.use_rt(mut g, \"strata_list_put\")\n      old := codegen.fresh(mut g, \"old\")\n      codegen.emit(\n        mut g,\n        f\"{old} = call i64 @strata_list_put(ptr {es.op}, i64 {at.op}, i64 {elem})\",\n      )\n      ov := codegen.from_slot(mut g, old, et)\n      codegen.drop_value(mut g, ov)\n    }\n    codegen.br(mut g, placed)\n    codegen.block(mut g, add)\n    codegen.use_rt(mut g, \"strata_tbl_add\")\n    codegen.emit(\n      mut g,\n      f\"call void @strata_tbl_add(ptr {cur.op}, i64 {elem}, ptr {h}, i64 {dict})\",\n    )\n    codegen.br(mut g, placed)\n    codegen.block(mut g, placed)\n  }\n  codegen.dup_value(mut g, cur)\n  codegen.pop_scope(mut g)\n  from_here := codegen.current(g)\n  codegen.br(mut g, done)\n  // else a new one, as the built-in makes it\n  codegen.block(mut g, copy)\n  codegen.push_transparent(mut g)\n  if g.copies {\n    codegen.note_copy(mut g, 1, cur, 0, \"\")\n  }\n  g.in_update = true\n  made := codegen.collection_builtin(mut g, name, [cur] + vs)\n  g.in_update = false\n  r := codegen.leave_branch(mut g, made)\n  from_copy := codegen.current(g)\n  codegen.br(mut g, done)\n  codegen.block(mut g, done)\n  p := codegen.fresh(mut g, \"updated\")\n  codegen.emit(\n    mut g,\n    f\"{p} = phi ptr [ {cur.op}, %{from_here} ], [ {r.op}, %{from_copy} ]\",\n  )\n  Some(codegen.temp(mut g, codegen.V { ty: cur.ty, op: p }))\n}"},{"name":"codegen.tail_drop","kind":"fn","old":"20ef70bbd7bcabec","new":"1dd9999b12266f68","interface_changed":false,"affected":[],"module":"codegen","text":"/// `drop_value` of an object as the function's last act: a `musttail` call\n/// of its drop function, then `ret void` (all drop functions take one\n/// `ptr`). False, emitting nothing, when it is not such a call.\nfn tail_drop(mut g: codegen.Gen, v: codegen.V) -> Bool {\n  if !codegen.counted(v.ty)\n    || codegen.constant(v.op)\n    || v.ty is check.TInt {\n    return false\n  }\n  if codegen.is_collection(v.ty) {\n    return codegen.tail_drop(\n      mut g,\n      codegen.V { ..v, ty: codegen.repr(v.ty) },\n    )\n  }\n  f := match v.ty {\n    check.TUnion(_) => codegen.union_drop(mut g, v.ty),\n    _ => codegen.drop_fn(mut g, v.ty),\n  }\n  codegen.use_counts(mut g)\n  codegen.emit(mut g, f\"musttail call void {f}(ptr {v.op})\")\n  codegen.emit(mut g, \"ret void\")\n  true\n}","old_text":"/// `drop_value` of an object as the function's last act: a `musttail` call\n/// of its drop function, then `ret void` (all drop functions take one\n/// `ptr`). False, emitting nothing, when it is not such a call.\nfn tail_drop(mut g: codegen.Gen, v: codegen.V) -> Bool {\n  if !codegen.counted(v.ty) || codegen.constant(v.op) || v.ty is TInt {\n    return false\n  }\n  if codegen.is_collection(v.ty) {\n    return codegen.tail_drop(\n      mut g,\n      codegen.V { ..v, ty: codegen.repr(v.ty) },\n    )\n  }\n  f := match v.ty {\n    TUnion(_) => codegen.union_drop(mut g, v.ty),\n    _ => codegen.drop_fn(mut g, v.ty),\n  }\n  codegen.use_counts(mut g)\n  codegen.emit(mut g, f\"musttail call void {f}(ptr {v.op})\")\n  codegen.emit(mut g, \"ret void\")\n  true\n}"},{"name":"codegen.written_ty","kind":"fn","old":"d3ec81234444d30f","new":"b49d06caeea359d4","interface_changed":true,"affected":["codegen.function","codegen.written_args","codegen.impl_written","codegen.unfold_written","codegen.compiled_alone","codegen.call_fn_want","codegen.method_call","codegen.type_check","codegen.generate","codegen.call_named","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.by_variant","codegen.expr_node","codegen.expr_want_node","codegen_with","core_rt_text","computed_value","repl_eval","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.builtin_call","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.main_arg","codegen.select_expr","codegen.expr","codegen.expr_want","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.entry","codegen.interp","codegen.format_spec","codegen.union_text","codegen.destructure","codegen.debug_fields","codegen.for_loop","codegen.debug_list","codegen.checked","codegen.fail_unless","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.fuzz_driver","codegen.trace_enter","codegen.trace_leave","codegen.matching_v","codegen.index_check","codegen.checked_update","codegen.decreases_fault","codegen.push_in_place","codegen.gen_list","codegen.converted","codegen.update_in_place","codegen.except_expr","codegen.matching_want","codegen.vtable","codegen.dyn_call","codegen.binary","codegen.logic","codegen.loop_body","codegen.matches","codegen.with_it","codegen.for_list","codegen.await_expr","codege