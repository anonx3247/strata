n  n := codegen.small_words(g, t)\n  ty := codegen.words_ll(n)\n  f := codegen.words_fn(mut g, t)\n  saved := g\n  codegen.start_helper(mut g)\n  codegen.emit(mut g, f\"%given = extractvalue {ty} %w, 0\")\n  codegen.emit(mut g, \"%none = icmp eq ptr %given, null\")\n  codegen.emit(mut g, \"br i1 %none, label %words, label %block\")\n  codegen.block(mut g, \"words\")\n  codegen.emit(mut g, f\"ret {ty} %w\")\n  codegen.block(mut g, \"block\")\n  codegen.emit(mut g, f\"%copy = call {ty} {f}(ptr %given)\")\n  codegen.drop_value(mut g, codegen.V { ty: t, op: \"%given\" })\n  codegen.emit(mut g, f\"ret {ty} %copy\")\n  codegen.restore(\n    mut g,\n    saved,\n    codegen.helper_text(g, f\"define internal {ty} {name}({ty} %w)\"),\n  )\n  name\n}","old_text":"/// The function making what a call gave (`words_ll`) words of a value of\n/// small type `t` (`@\"unbox:T\"`): the words given, or a block given copied\n/// (`words_fn`: each counted field held once more) and let go. No\n/// allocation.\nfn unbox_fn(mut g: codegen.Gen, t: Ty) -> String {\n  name := f\"@\\\"unbox:{codegen.key(t)}\\\"\"\n  if codegen.has_helper(g, name) {\n    return name\n  }\n  codegen.add_helper(mut g, name)\n  n := codegen.small_words(g, t)\n  ty := codegen.words_ll(n)\n  f := codegen.words_fn(mut g, t)\n  saved := g\n  codegen.start_helper(mut g)\n  codegen.emit(mut g, f\"%given = extractvalue {ty} %w, 0\")\n  codegen.emit(mut g, \"%none = icmp eq ptr %given, null\")\n  codegen.emit(mut g, \"br i1 %none, label %words, label %block\")\n  codegen.block(mut g, \"words\")\n  codegen.emit(mut g, f\"ret {ty} %w\")\n  codegen.block(mut g, \"block\")\n  codegen.emit(mut g, f\"%copy = call {ty} {f}(ptr %given)\")\n  codegen.drop_value(mut g, codegen.V { ty: t, op: \"%given\" })\n  codegen.emit(mut g, f\"ret {ty} %copy\")\n  codegen.restore(\n    mut g,\n    saved,\n    codegen.helper_text(g, f\"define internal {ty} {name}({ty} %w)\"),\n  )\n  name\n}"},{"name":"codegen.reusable","kind":"fn","old":"94d90df9