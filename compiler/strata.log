rrors","with_base","graph_command","graph_diff","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","package_errors","edit_in_editor","new_command","fix_command","rename_command","move_command"],"module":"kernel_dependent","text":"/// `t` with `u` (no loose bound variables) for the variable bound by the\n/// binder `depth` levels up.\npub fn instantiate(\n  t: kernel_dependent.Term,\n  u: kernel_dependent.Term,\n  depth: Int,\n) -> kernel_dependent.Term {\n  match t {\n    kernel_dependent.Bound(i) => if i == depth {\n      u\n    } else {\n      t\n    },\n    kernel_dependent.Pi { name, domain, body } => kernel_dependent.Pi {\n      name,\n      domain: kernel_dependent.instantiate(domain, u, depth),\n      body: kernel_dependent.instantiate(body, u, depth + 1),\n    },\n    kernel_dependent.Lambda { name, domain, body } => kernel_dependent.Lambda {\n      name,\n      domain: kernel_dependent.instantiate(domain, u, depth),\n      body: kernel_dependent.instantiate(body, u, depth + 1),\n    },\n    kernel_dependent.Apply { function, argument } => kernel_dependent.Apply {\n      function: kernel_dependent.instantiate(function, u, depth),\n      argument: kernel_dependent.instantiate(argument, u, depth),\n    },\n    _ => t,\n  }\n}","old_text":"/// `t` with `u` (no loose bound variables) for the variable bound by the\n/// binder `depth` levels up.\npub fn instantiate(\n  t: kernel_dependent.Term,\n  u: kernel_dependent.Term,\n  depth: Int,\n) -> kernel_dependent.Term {\n  kernel_dependent.instantiated(t, u, depth) ?? t\n}"},{"name":"kernel_dependent.abstracted","kind":"fn","old":"dfe9e00e3657b79b","new":null,"interface_changed":true,"affected":[],"module":"kernel_dependent","old_text":"fn abstracted(\n  t: kernel_dependent.Term,\n  x: String,\n  depth: Int,\n) -> Option[kernel_dependent.Term] {\n  match t {\n    kernel_dependent.Free(y) => if y == x {\n      Some(kernel_dependent.Bound(depth))\n    } else {\n      None\n    },\n    kernel_dependent.Pi { domain, body, .. } => kernel_dependent.rebuilt(\n      t,\n      kernel_dependent.abstracted(domain, x, depth),\n      kernel_dependent.abstracted(body, x, depth + 1),\n    ),\n    kernel_dependent.Lambda { domain, body, .. } => kernel_dependent.rebuilt(\n      t,\n      kernel_dependent.abstracted(domain, x, depth),\n      kernel_dependent.abstracted(body, x, depth + 1),\n    ),\n    kernel_dependent.Apply { function, argument } => kernel_dependent.rebuilt(\n      t,\n      kernel_dependent.abstracted(function, x, depth),\n      kernel_dependent.abstracted(argument, x, depth),\n    ),\n    _ => None,\n  }\n}"},{"name":"kernel_dependent.instantiated","kind":"fn","old":"82bfc8a1adcf13f0","new":null,"interface_changed":true,"affected":[],"module":"kernel_dependent","old_text":"fn instantiated(\n  t: kernel_dependent.Term,\n  u: kernel_dependent.Term,\n  depth: Int,\n) -> Option[kernel_dependent.Term] {\n  match t {\n    kernel_dependent.Bound(i) => if i == depth {\n      Some(u)\n    } else {\n      None\n    },\n    kernel_dependent.Pi { domain, body, .. } => kernel_dependent.rebuilt(\n      t,\n      kernel_dependent.instantiated(domain, u, depth),\n      kernel_dependent.instantiated(body, u, depth + 1),\n    ),\n    kernel_dependent.Lambda { domain, body, .. } => kernel_dependent.rebuilt(\n      t,\n      kernel_dependent.instantiated(domain, u, depth),\n      kernel_dependent.instantiated(body, u, depth + 1),\n    ),\n    kernel_dependent.Apply { function, argument } => kernel_dependent.rebuilt(\n      t,\n      kernel_dependent.instantiated(function, u, depth),\n      kernel_dependent.instantiated(argument, u, depth),\n    ),\n    _ => None,\n  }\n}"},{"name":"kernel_dependent.rebuilt","kind":"fn","old":"d055bab39227252e","new":null,"interface_changed":true,"affected":[],"module":"kernel_dependent","old_text":"/// `t` (a binder or an application) with its two parts changed where `a`\n/// or `b` gives a new one; `None` when neither does, so an unchanged term\n/// is kept, not copied.\nfn rebuilt(\n  t: kernel_dependent.Term,\n  a: Option[kernel_dependent.Term],\n  b: Option[kernel_dependent.Term],\n) -> Option[kernel_dependent.Term] {\n  if a is None && b is None {\n    return None\n  }\n  match t {\n    kernel_dependent.Pi { name, domain, body } => Some(kernel_dependent.Pi {\n      name,\n      domain: a ?? domain,\n      body: b ?? body,\n    }),\n    kernel_dependent.Lambda { name, domain, body } => Some(kernel_dependent.Lambda {\n      name,\n      domain: a ?? domain,\n      body: b ?? body,\n    }),\n    kernel_dependent.Apply { function, argument } => Some(kernel_dependent.Apply {\n      function: a ?? function,\n      argument: b ?? argument,\n    }),\n    _ => None,\n  }\n}"}]}
