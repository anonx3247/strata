r meets them. `in_loop`: inside\n/// a loop body, and not inside a closure's.\nfn body_errors(\n  sc: declarations.Names,\n  e: ast.Expr,\n  in_loop: Bool,\n  out: List[String],\n) -> List[String] {\n  match e {\n    ast.Block { stmts, last } => {\n      mut acc := out\n      for st in stmts {\n        acc = match st {\n          ast.Break => if in_loop {\n            acc\n          } else {\n            acc + [\"`break` outside a loop\"]\n          },\n          ast.Continue => if in_loop {\n            acc\n          } else {\n            acc + [\"`continue` outside a loop\"]\n          },\n          ast.Let { pat, value, .. } => declarations.pattern_errors(\n            sc,\n            pat,\n            declarations.body_errors(sc, value, in_loop, acc),\n          ),\n          ast.VarDecl { value, .. } => declarations.body_errors(sc, value, in_loop, acc),\n          ast.Assign { place, value } => declarations.body_errors(\n            sc,\n            value,\n            in_loop,\n            declarations.body_errors(sc, place, in_loop, acc),\n          ),\n          ast.While { cond, body } => declarations.body_errors(\n            sc,\n            body,\n            true,\n            declarations.body_errors(sc, cond, in_loop, acc),\n          ),\n          ast.For { pat, iter, body } => declarations.body_errors(\n            sc,\n            body,\n            true,\n            declarations.pattern_errors(\n              sc,\n              pat,\n              declarations.body_errors(sc, iter, in_loop, acc),\n            ),\n          ),\n          ast.ComptimeFor { iter, body, .. } => declarations.body_errors(\n            sc,\n            body,\n            true,\n            declarations.body_errors(sc, iter, in_loop, acc),\n          ),\n          ast.Loop(b) => declarations.body_errors(sc, b, true, acc),\n          ast.ExprStmt(x) => declarations.body_errors(sc, x, in_loop, acc),\n          ast.Assert(x) => declarations.body_errors(sc, x, in_loop, acc),\n          _ => acc,\n        }\n      }\n      declarations.body_errors(sc, last, in_loop, acc)\n    },\n    // a closure's body is in no loop\n    ast.Lambda { params, body } => {\n      mut acc := out\n      for n in declarations.twice(params.map(p -> p.name)) {\n        mut acc.push(\"two parameters of a lambda are named `\" + n + \"`\")\n      }\n      declarations.body_errors(sc, body, false, acc)\n    },\n    ast.MatchExpr { scrutinee, arms, .. } => {\n      mut acc := declarations.body_errors(sc, scrutinee, in_loop, out)\n      for a in arms {\n        acc = declarations.body_errors(\n          sc,\n          a.body,\n          in_loop,\n          declarations.pattern_errors(sc, a.pat, acc),\n        )\n      }\n      acc\n    },\n    ast.CtorExpr { name, args } => {\n      mut acc := out\n      if !contains(sc.ctors, name)\n        && !contains(sc.types, name)\n        && !starts_with(name, \"$rec:\")\n        && name != \"\"\n        && !contains(name, \".\")\n        && !sc.open\n        && !sc.imports {\n        mut acc.push(\"unknown constructor `\" + name + \"`\")\n      } else if contains(sc.externs, name) && !contains(sc.ctors, name) {\n        mut acc.push(\"unknown constructor `\" + name + \"`\")\n      }\n      given := match args {\n        ast.RecordArgs(fs) => fs.map(f -> f.0),\n        ast.UpdateArgs { fields, .. } => fields.map(f -> f.0),\n        _ => [],\n      }\n      for n in declarations.twice(given) {\n        mut acc.push(\n          \"field `\"\n            + n\n            + \"` is given twice in `\"\n            + name\n            + \" { .. }`\",\n        )\n      }\n      for x in declarations.ctor_parts(args) {\n        acc = declarations.body_errors(sc, x, in_loop, acc)\n      }\n      acc\n    },\n    // `Item.new(..)`: called on a type\n    ast.MethodCall { recv: ast.CtorExpr { args: ast.NoArgs, .. }, args, .. } => {\n      mut acc := out\n      for x in args {\n        acc = declarations.body_errors(sc, x, in_loop, acc)\n      }\n      acc\n    },\n    _ => {\n      mut acc := out\n      for x in declarations.children(e) {\n        acc = declarations.body_errors(sc, x, in_loop, acc)\n      }\n      acc\n    },\n  }\n}","old_text":"/// A body's errors, in the order the checker meets them. `in_loop`: inside\n/// a loop body, and not inside a closure's.\nfn body_errors(\n  sc: declarations.Names,\n  e: ast.Expr,\n  in_loop: Bool,\n  out: List[String],\n) -> List[String] {\n  match e {\n    ast.Block { stmts, last } => {\n      mut acc := out\n      for st in stmts {\n        acc = match st {\n          ast.Break => if in_loop {\n            acc\n          } else {\n            acc + [\"`break` outside a loop\"]\n          },\n          ast.Continue => if in_loop {\n            acc\n          } else {\n            acc + [\"`continue` outside a loop\"]\n          },\n          ast.Let { pat, value, .. } => declarations.pattern_errors(\n            sc,\n            pat,\n            declarations.body_errors(sc, value, in_loop, acc),\n          ),\n          ast.VarDecl { value, .. } => declarations.body_errors(sc, value, in_loop, acc),\n          ast.Assign { place, value } => declarations.body_errors(\n            sc,\n            value,\n            in_loop,\n            declarations.body_errors(sc, place, in_loop, acc),\n          ),\n          ast.While { cond, body } => declarations.body_errors(\n            sc,\n            body,\n            true,\n            declarations.body_errors(sc, cond, in_loop, acc),\n          ),\n          ast.For { pat, iter, body } => declarations.body_errors(\n            sc,\n            body,\n            true,\n            declarations.pattern_errors(\n              sc,\n              pat,\n              declarations.body_errors(sc, iter, in_loop, acc),\n            ),\n          ),\n          ast.ComptimeFor { iter, body, .. } => declarations.body_errors(\n            sc,\n            body,\n            true,\n            declarations.body_errors(sc, iter, in_loop, acc),\n          ),\n          ast.Loop(b) => declarations.body_errors(sc, b, true, acc),\n          ast.ExprStmt(x) => declarations.body_errors(sc, x, in_loop, acc),\n          ast.Assert(x) => declarations.body_errors(sc, x, in_loop, acc),\n          _ => acc,\n        }\n      }\n      declarations.body_errors(sc, last, in_loop, acc)\n    },\n    // a closure's body is in no loop\n    ast.Lambda { params, body } => {\n      mut acc := out\n      for n in declarations.twice(params.map(p -> p.name)) {\n        mut acc.push(\"two parameters of a lambda are named `\" + n + \"`\")\n      }\n      declarations.body_errors(sc, body, false, acc)\n    },\n    ast.MatchExpr { scrutinee, arms, .. } => {\n      mut acc := declarations.body_errors(sc, scrutinee, in_loop, out)\n      for a in arms {\n        acc = declarations.body_errors(\n          sc,\n          a.body,\n          in_loop,\n          declarations.pattern_errors(sc, a.pat, acc),\n        )\n      }\n      acc\n    },\n    ast.CtorExpr { name, args } => {\n      mut acc := out\n      if !contains(sc.ctors, name)\n        && !contains(sc.types, name)\n        && !starts_with(name, \"$rec:\")\n        && !contains(name, \".\")\n        && !sc.open\n        && !sc.imports {\n        mut acc.push(\"unknown constructor `\" + name + \"`\")\n      } else if contains(sc.externs, name) && !contains(sc.ctors, name) {\n        mut acc.push(\"unknown constructor `\" + name + \"`\")\n      }\n      given := match args {\n        ast.RecordArgs(fs) => fs.map(f -> f.0),\n        ast.UpdateArgs { fields, .. } => fields.map(f -> f.0),\n        _ => [],\n      }\n      for n in declarations.twice(given) {\n        mut acc.push(\n          \"field `\"\n            + n\n            + \"` is given twice in `\"\n            + name\n            + \" { .. }`\",\n        )\n      }\n      for x in declarations.ctor_parts(args) {\n        acc = declarations.body_errors(sc, x, in_loop, acc)\n      }\n      acc\n    },\n    // `Item.new(..)`: called on a type\n    ast.MethodCall { recv: ast.CtorExpr { args: ast.NoArgs, .. }, args, .. } => {\n      mut acc := out\n      for x in args {\n        acc = declarations.body_errors(sc, x, in_loop, acc)\n      }\n      acc\n    },\n    _ => {\n      mut acc := out\n      for x in declarations.children(e) {\n        acc = declarations.body_errors(sc, x, in_loop, acc)\n      }\n      acc\n    },\n  }\n}"},{"name":"desugar.use ast","kind":"use","old":"92fe8870817ed9b3","new":"e3d5cff62dd3d68e","interface_changed":true,"affected":[],"module":"desugar","text":"// desugar: rewrites ranges, indexing, slices, comprehensions, defaults and\n// mixed unions into plain calls and types after a program is read. The tree\n// keeps them as written, so they render back the same. Names it makes start\n// with `$`, which no program can write.\n\nfrom ast use DeriveFnDef, Decl, DeclKind, TypeDecl, Field, Variant, FnDecl,\n  TypeExpr, Expr, LamParam, CompFor, Stmt, Pattern, TypeDef, FnDef, TestDef,\n  TraitDef, ImplDef, RecordBody, SumBody, Alias, RecordPayload, MemberType,\n  Named, Refined, UnionType, UpdateArgs, Bound, RowType, IntLit, TupleExpr, Var,\n  ListExpr, CtorExpr, Call, FieldOf, Lambda, Binary, Block, Range, Index, Comp,\n  DictExpr, SetExpr, RecordArgs, ListComp, SetComp, DictComp, Add, Let, Bind,\n  UnitExpr, Assign, VarDecl, ExprStmt, ImplDecl, TraitDecl, TraitMethod,\n  ModelDecl, ModelDef, MethodCall, Old, Param, MockExpr, StrLit, BoolLit,\n  NoArgs, Equal, And, FnType, UnitType, Assumed, is_assumed, unassumed,\n  ExternDef, ExternDecl, ExternFn, Python","old_text":"// desugar: rewrites ranges, indexing, slices, comprehensions, defaults and\n// mixed unions into plain calls and types after a program is read. The tree\n// keeps them as written, so they render back the same. Names it makes start\n// with `$`, which no program can write.\n\nfrom ast use DeriveFnDef, Decl, DeclKind, TypeDecl, Field, Variant, FnDecl,\n  TypeExpr, Expr, LamParam, CompFor, Stmt, Pattern, TypeDef, FnDef, TestDef,\n  TraitDef, ImplDef, RecordBody, SumBody, Alias, RecordPayload, MemberType,\n  Named, Refined, UnionType, Bound, RowType, IntLit, TupleExpr, Var, ListExpr,\n  CtorExpr, Call, FieldOf, Lambda, Binary, Block, Range, Index, Comp, DictExpr,\n  SetExpr, RecordArgs, ListComp, SetComp, DictComp, Add, Let, Bind, UnitExpr,\n  Assign, VarDecl, ExprStmt, ImplDecl, TraitDecl, TraitMethod, ModelDecl,\n  ModelDef, MethodCall, Old, Param, MockExpr, StrLit, BoolLit, NoArgs, Equal,\n  And, FnType, UnitType, Assumed, is_assumed, unassumed, ExternDef, ExternDecl,\n  ExternFn, Python"},{"name":"desugar.desugar_more","kind":"fn","old":"8d03dc355d58dae9","new":"5667e9a9bba166e3","interface_changed":false,"affected":[],"module":"desugar","text":"/// `desugar` of definitions added to a program already without its sugar\n/// (`context`, not returned). Each definition is desugared once. Returns\n/// `new` without sugar, with the aliases made for refinements the program\n/// had no alias for yet; the errors; and all refinements named so far\n/// (`texts`, then the new ones; `$where_k` is the `k`th).\npub fn desugar_more(\n  new: List[ast.Decl],\n  context: List[ast.Decl],\n  texts: List[String],\n) -> (List[ast.Decl], List[(String, String)], List[String]) {\n  mut errors := []\n  mut out := []\n  for d0 in desugar.with_models(new, context) {\n    // an `extern python` function becomes the call of the Python worker\n    d := desugar.python_lowered(d0)\n    for e in walk.decl_kids(d).1 {\n      for _ in 0..desugar.open_ranges(e) {\n        mut errors.push(\n          (\n            desugar.decl_name(d),\n            \"a range needs both ends (`a..b`), except in a slice: `xs[a..]`, `xs[..b]`\",\n          ),\n        )\n      }\n    }\n    lifted := desugar.rows_lifted(d)\n    for e in desugar.row_errors(lifted) {\n      mut errors.push((desugar.decl_name(d), e))\n    }\n    mut out.push(\n      desugar.named_results(walk.decl_parts(\n        walk.rewrite_decl(lifted, x -> desugar.updates_assigned(x)),\n        x -> desugar.unsugared(x),\n        t -> desugar.unsugared_type(t),\n      )),\n    )\n  }\n  out += desugar.anon_types(out, context)\n  (refined, all) := desugar.inline_refinements(\n    desugar.key_paths(desugar.defaults(out, context), context),\n    texts,\n  )\n  (desugar.mixed_unions(refined), errors, all)\n}","old_text":"/// `desugar` of definitions added to a program already without its sugar\n/// (`context`, not returned). Each definition is desugared once. Returns\n/// `new` without sugar, with the aliases made for refinements the program\n/// had no alias for yet; the errors; and all refinements named so far\n/// (`texts`, then the new ones; `$where_k` is the `k`th).\npub fn desugar_more(\n  new: List[ast.Decl],\n  context: List[ast.Decl],\n  texts: List[String],\n) -> (List[ast.Decl], List[(String, String)], List[String]) {\n  mut errors := []\n  mut out := []\n  for d0 in desugar.with_models(new, context) {\n    // an `extern python` function becomes the call of the Python worker\n    d := desugar.python_lowered(d0)\n    for e in walk.decl_kids(d).1 {\n      for _ in 0..desugar.open_ranges(e) {\n        mut errors.push(\n          (\n            desugar.decl_name(d),\n            \"a range needs both ends (`a..b`), except in a slice: `xs[a..]`, `xs[..b]`\",\n          ),\n        )\n      }\n    }\n    lifted := desugar.rows_lifted(d)\n    for e in desugar.row_errors(lifted) {\n      mut errors.push((desugar.decl_name(d), e))\n    }\n    mut out.push(\n      desugar.named_results(walk.decl_parts(\n        lifted,\n        x -> desugar.unsugared(x),\n        t -> desugar.unsugared_type(t),\n      )),\n    )\n  }\n  out += desugar.anon_types(out, context)\n  (refined, all) := desugar.inline_refinements(\n    desugar.key_paths(desugar.defaults(out, context), context),\n    texts,\n  )\n  (desugar.mixed_unions(refined), errors, all)\n}"},{"name":"parse.sym_primary","kind":"fn","old":"44372e15da94dc63","new":"8f7ffaa473782afc","interface_changed":false,"affected":[],"module":"parse","text":"/// A lambda, `()`, a parenthesized expression, a tuple, a list, a list\n/// comprehension or a block.\nfn sym_primary(mut p: parse.Parser, s: String) -> Result[ast.Expr, String] {\n  if s == \"(\" && parse.lambda_ahead(p) {\n    parse.advance(mut p)\n    mut ps := []\n    mut binds := []\n    while !parse.is_sym(p, \")\") {\n      name := match parse.param_pattern(mut p)! {\n        Some(pat) => {\n          n := f\"$p{len(ps)}\"\n          mut binds.push(ast.Let { pat, ty: None, value: ast.Var(n) })\n          n\n        },\n        None => parse.ident(mut p)!,\n      }\n      ty := if parse.eat_sym(mut p, \":\") {\n        Some(parse.type_expr(mut p)!)\n      } else {\n        None\n      }\n      mut ps.push(ast.LamParam { name, ty })\n      if !parse.eat_sym(mut p, \",\") {\n        break\n      }\n    }\n    parse.expect_sym(mut p, \")\")!\n    parse.expect_sym(mut p, \"->\")!\n    return Ok(ast.Lambda {\n      params: ps,\n      body: parse.bind_params(binds, parse.expr(mut p)!),\n    })\n  }\n  if s == \"(\" {\n    parse.advance(mut p)\n    if parse.eat_sym(mut p, \")\") {\n      return Ok(ast.UnitExpr)\n    }\n    (ns, np) := (p.no_struct, p.no_pipe)\n    p.no_struct = false\n    p.no_pipe = false\n    e := parse.expr(mut p)!\n    if parse.eat_sym(mut p, \",\") {\n      rest := parse.expr_list(mut p, \")\")!\n      p.no_struct = ns\n      p.no_pipe = np\n      return Ok(ast.TupleExpr([e] + rest))\n    }\n    p.no_struct = ns\n    p.no_pipe = np\n    parse.expect_sym(mut p, \")\")!\n    return Ok(e)\n  }\n  if s == \"[\" {\n    parse.advance(mut p)\n    if parse.eat_sym(mut p, \"]\") {\n      return Ok(ast.ListExpr([]))\n    }\n    (ns, np) := (p.no_struct, p.no_pipe)\n    p.no_struct = false\n    p.no_pipe = false\n    first := parse.expr(mut p)!\n    // `[e for x in xs where c for y in ys]`\n    if parse.is_kw(p, \"for\") {\n      fors := parse.comp_fors(mut p, \"]\")!\n      p.no_struct = ns\n      p.no_pipe = np\n      return Ok(ast.Comp { kind: ast.ListComp, elem: first, fors })\n    }\n    mut items := [first]\n    if parse.eat_sym(mut p, \",\") {\n      items += parse.expr_list(mut p, \"]\")!\n    } else {\n      parse.expect_sym(mut p, \"]\")!\n    }\n    p.no_struct = ns\n    p.no_pipe = np\n    return Ok(ast.ListExpr(items))\n  }\n  if s == \"{\" {\n    // `{ id: 1, .. }`: a field's name and a `:`, which no statement starts with\n    return match (parse.peek_at(p, 1), parse.peek_at(p, 2)) {\n      (lex.Ident(_), lex.Sym(\":\")) => parse.anon_record(mut p),\n      (lex.Sym(\"..\"), _) => parse.nameless_update(mut p),\n      _ => parse.block(mut p),\n    }\n  }\n  if s == \"|\" || s == \"||\" {\n    return parse.fail(\n      p,\n      \"lambdas are written `x -> body`, `(a, b) -> body` or `() -> body`\",\n    )\n  }\n  parse.fail(p, \"expected expression\")\n}","old_text":"/// A lambda, `()`, a parenthesized expression, a tuple, a list, a list\n/// comprehension or a block.\nfn sym_primary(mut p: parse.Parser, s: String) -> Result[ast.Expr, String] {\n  if s == \"(\" && parse.lambda_ahead(p) {\n    parse.advance(mut p)\n    mut ps := []\n    mut binds := []\n    while !parse.is_sym(p, \")\") {\n      name := match parse.param_pattern(mut p)! {\n        Some(pat) => {\n          n := f\"$p{len(ps)}\"\n          mut binds.push(ast.Let { pat, ty: None, value: ast.Var(n) })\n          n\n        },\n        None => parse.ident(mut p)!,\n      }\n      ty := if parse.eat_sym(mut p, \":\") {\n        Some(parse.type_expr(mut p)!)\n      } else {\n        None\n      }\n      mut ps.push(ast.LamParam { name, ty })\n      if !parse.eat_sym(mut p, \",\") {\n        break\n      }\n    }\n    parse.expect_sym(mut p, \")\")!\n    parse.expect_sym(mut p, \"->\")!\n    return Ok(ast.Lambda {\n      params: ps,\n      body: parse.bind_params(binds, parse.expr(mut p)!),\n    })\n  }\n  if s == \"(\" {\n    parse.advance(mut p)\n    if parse.eat_sym(mut p, \")\") {\n      return Ok(ast.UnitExpr)\n    }\n    (ns, np) := (p.no_struct, p.no_pipe)\n    p.no_struct = false\n    p.no_pipe = false\n    e := parse.expr(mut p)!\n    if parse.eat_sym(mut p, \",\") {\n      rest := parse.expr_list(mut p, \")\")!\n      p.no_struct = ns\n      p.no_pipe = np\n      return Ok(ast.TupleExpr([e] + rest))\n    }\n    p.no_struct = ns\n    p.no_pipe = np\n    parse.expect_sym(mut p, \")\")!\n    return Ok(e)\n  }\n  if s == \"[\" {\n    parse.advance(mut p)\n    if parse.eat_sym(mut p, \"]\") {\n      return Ok(ast.ListExpr([]))\n    }\n    (ns, np) := (p.no_struct, p.no_pipe)\n    p.no_struct = false\n    p.no_pipe = false\n    first := parse.expr(mut p)!\n    // `[e for x in xs where c for y in ys]`\n    if parse.is_kw(p, \"for\") {\n      fors := parse.comp_fors(mut p, \"]\")!\n      p.no_struct = ns\n      p.no_pipe = np\n      return Ok(ast.Comp { kind: ast.ListComp, elem: first, fors })\n    }\n    mut items := [first]\n    if parse.eat_sym(mut p, \",\") {\n      items += parse.expr_list(mut p, \"]\")!\n    } else {\n      parse.expect_sym(mut p, \"]\")!\n    }\n    p.no_struct = ns\n    p.no_pipe = np\n    return Ok(ast.ListExpr(items))\n  }\n  if s == \"{\" {\n    // `{ id: 1, .. }`: a field's name and a `:`, which no statement starts with\n    return match (parse.peek_at(p, 1), parse.peek_at(p, 2)) {\n      (lex.Ident(_), lex.Sym(\":\")) => parse.anon_record(mut p),\n      _ => parse.block(mut p),\n    }\n  }\n  if s == \"|\" || s == \"||\" {\n    return parse.fail(\n      p,\n      \"lambdas are written `x -> body`, `(a, b) -> body` or `() -> body`\",\n    )\n  }\n  parse.fail(p, \"expected expression\")\n}"},{"name":"text.inline","kind":"fn","old":"aa5d6124dc7f3ff1","new":"e40430eff08135f4","interface_changed":false,"affected":[],"module":"text","text":"/// An expression on one line, except for the blocks inside it (laid out at\n/// depth `d`) and for what its parts break.\nfn inline(e: ast.Expr, d: Int) -> String {\n  match e {\n    ast.IntLit(n) => to_string(n),\n    ast.BigIntLit(digits) => digits,\n    ast.FloatLit(f) => text.float_text(f),\n    ast.TupleExpr(es) => \"(\" + text.args_text(es, d) + \")\",\n    ast.StrLit(s) => \"\\\"\" + text.escape(s) + \"\\\"\",\n    ast.BoolLit(b) => to_string(b),\n    ast.UnitExpr => \"()\",\n    ast.Var(v) => v,\n    ast.Hole(h) => \"?\" + h,\n    ast.ListExpr(es) => \"[\" + text.args_text(es, d) + \"]\",\n    ast.CtorExpr { name, args } => match args {\n      ast.NoArgs => name,\n      ast.PositionalArgs(es) => name + \"(\" + text.args_text(es, d) + \")\",\n      ast.RecordArgs(fs) => if len(fs) == 0 {\n        name + \" {}\"\n      } else {\n        text.ctor_open(name)\n          + \" \"\n          + join(text.named_parts(fs, d), \", \")\n          + \" }\"\n      },\n      ast.UpdateArgs { base, fields } => if name == \"\" {\n          \"{ \"\n        } else {\n          name + \" { \"\n        }\n        + join([\"..\", text.expr_text(base, d)], \"\")\n        + if len(fields) == 0 {\n          \"\"\n        } else {\n          \", \" + join(text.named_parts(fields, d), \", \")\n        }\n        + \" }\",\n    },\n    ast.Call { callee, args } => text.callee_text(callee, d)\n      + \"(\"\n      + text.args_text(args, d)\n      + \")\",\n    ast.MethodCall { recv, name, args } => text.wrap(recv, 12, d)\n      + \".\"\n      + name\n      + \"(\"\n      + text.args_text(args, d)\n      + \")\",\n    ast.FieldOf { base, name } => text.wrap(base, 12, d) + \".\" + name,\n    ast.Lambda { params, body } => {\n      (ps, b) := text.lambda_view(params, body)\n      text.lambda_params(ps) + \" -> \" + text.expr_text(b, d)\n    },\n    ast.Binary { op, left, right } => {\n      p := text.prec(e)\n      match op {\n        ast.Implies => text.wrap(left, p + 1, d) + \" ==> \" + text.wrap(right, p, d),\n        ast.Equal | ast.NotEqual | ast.Less | ast.LessEq | ast.Greater | ast.GreaterEq => {\n          // `(x & 255) == x`: a bit operation compared is shown in parentheses,\n          // since C and its readers put `==` before `&`, `|`, `^`\n          l := if text.bitwise(left) {\n            \"(\" + text.expr_text(left, d) + \")\"\n          } else {\n            text.wrap(left, p, d)\n          }\n          r := if text.bitwise(right) {\n            \"(\" + text.expr_text(right, d) + \")\"\n          } else {\n            text.wrap(right, p + 1, d)\n          }\n          l + \" \" + text.symbol(op) + \" \" + r\n        },\n        _ => text.wrap(left, p, d)\n          + \" \"\n          + text.symbol(op)\n          + \" \"\n          + text.wrap(right, p + 1, d),\n      }\n    },\n    ast.Unary { op, operand } => match op {\n      ast.Neg => \"-\" + text.wrap(operand, 11, d),\n      ast.Not => \"!\" + text.wrap(operand, 11, d),\n    },\n    ast.IsExpr { value, variant } => text.wrap(value, 4, d) + \" is \" + variant,\n    ast.IfExpr { cond, then, otherwise } => {\n      s := \"if \" + text.head(cond, d) + \" \" + text.block_text(then, d)\n      match otherwise {\n        ast.UnitExpr => s,\n        ast.IfExpr { .. } => s + \" else \" + text.expr_text(otherwise, d),\n        _ => s + \" else \" + text.block_text(otherwise, d),\n      }\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      as_name := match binding {\n        Some(n) => \" as \" + n,\n        None => \"\",\n      }\n      mut out := \"match \" + text.head(scrutinee, d) + as_name + \" {\\n\"\n      for a in arms {\n        out += text.comments_text(a.comments, d + 1)\n        each := match a.pat {\n          ast.ForPat { each, list, .. } => \" for \"\n            + text.pattern_text(each)\n            + \" in \"\n            + text.head(list, d + 1),\n          _ => \"\",\n        }\n        out += text.ind(d + 1)\n          + text.pattern_text(a.pat)\n          + \" => \"\n          + text.expr_text(a.body, d + 1)\n          + each\n          + \",\\n\"\n      }\n      out + text.ind(d) + \"}\"\n    },\n    ast.Block { .. } => text.block_text(e, d),\n    ast.MockExpr(t) => \"mock \" + text.type_text(t),\n    ast.MutExpr(x) => \"mut \" + text.expr_text(x, d),\n    // `comptime` takes a unary expression: `comptime (a ?? b)`\n    ast.Comptime(x) => \"comptime \" + text.wrap(x, 11, d),\n    // `assumed` is written before the contract's keyword\n    ast.Assumed(x) => text.inline(x, d),\n    // `old` takes a unary expression without a sign: `old (-x)`, `old (a + b)`\n    ast.Old(x) => {\n      s := text.wrap(x, 11, d)\n      if starts_with(s, \"-\") || starts_with(s, \"!\") {\n        \"old (\" + s + \")\"\n      } else {\n        \"old \" + s\n      }\n    },\n    // a call's argument: `f(...x)`\n    ast.Spread(x) => \"...\" + text.expr_text(x, d),\n    ast.Spawn(x) => \"spawn \" + text.expr_text(x, d),\n    ast.SupervisedSpawn(x) => \"supervised spawn \" + text.expr_text(x, d),\n    // a handler on the operand's chain needs parentheses: `await (a!)`, since\n    // `await a!` is `(await a)!`\n    ast.Await(x) => if text.handler_on_spine(x) {\n      \"await (\" + text.expr_text(x, d) + \")\"\n    } else {\n      \"await \" + text.wrap(x, 11, d)\n    },\n    ast.Scope(b) => \"scope \" + text.block_text(b, d),\n    ast.Select(arms) | ast.Race(arms) => {\n      mut out := match e {\n        ast.Race(_) => \"race {\\n\",\n        _ => \"select {\\n\",\n      }\n      for a in arms {\n        as_name := match a.name {\n          Some(n) => \" as \" + n,\n          None => \"\",\n        }\n        // a supervised race arm is `supervised e`\n        op := match (e, a.op) {\n          (ast.Race(_), ast.SupervisedSpawn(x)) => \"supervised \" + text.expr_text(x, d + 1),\n          _ => text.expr_text(a.op, d + 1),\n        }\n        out += text.ind(d + 1)\n          + op\n          + as_name\n          + \" => \"\n          + text.expr_text(a.body, d + 1)\n          + \",\\n\"\n      }\n      out + text.ind(d) + \"}\"\n    },\n    ast.Interp(parts) => {\n      mut s := \"f\\\"\"\n      for p in parts {\n        s += match p {\n          // a lone `\\` before a brace is written `\\\\`: `\\{{` would read as `\\{`\n          // then `{`\n          ast.TextPart(l) => replace(replace(replace(\n            replace(text.escape(l), \"\\{\", \"\\\\\\{\"),\n            \"\\}\",\n            \"\\\\\\}\",\n          ), \"{\", \"{{\"), \"}\", \"}}\"),\n          ast.ValuePart { value, spec } => \"{\"\n            + text.inline(value, 0)\n            + match spec {\n              Some(f) => \":\" + text.spec_text(f),\n              None => \"\",\n            }\n            + \"}\",\n        }\n      }\n      s + \"\\\"\"\n    },\n    ast.Range { lo, hi, inclusive } => match lo {\n        Some(x) => text.wrap(x, 1, d),\n        None => \"\",\n      }\n      + if inclusive {\n        \"..=\"\n      } else {\n        \"..\"\n      }\n      + match hi {\n        Some(x) => text.wrap(x, 1, d),\n        None => \"\",\n      },\n    ast.Index { base, index } => text.wrap(base, 12, d) + \"[\" + text.expr_text(index, d) + \"]\",\n    ast.Comp { kind, elem, fors } => {\n      (open, close) := match kind {\n        ast.ListComp => (\"[\", \"]\"),\n        ast.SetComp => (\"Set { \", \" }\"),\n        ast.DictComp => (\"Dict { \", \" }\"),\n      }\n      mut s := open\n        + match (kind, elem) {\n          (ast.DictComp, ast.TupleExpr([k, v])) => text.expr_text(k, d) + \": \" + text.expr_text(v, d),\n          _ => text.expr_text(elem, d),\n        }\n      for g in fors {\n        s += \" for \"\n          + text.pattern_text(g.pat)\n          + \" in \"\n          + text.expr_text(g.iter, d)\n        match g.cond {\n          Some(c) => {\n            s += \" where \" + text.expr_text(c, d)\n          },\n          None => (),\n        }\n      }\n      s + close\n    },\n    ast.DictExpr { types, entries } => text.collection(\"Dict\", types, entries.map(\n      kv -> text.expr_text(kv.0, d) + \": \" + text.expr_text(kv.1, d),\n    )),\n    ast.SetExpr { types, elems } => text.collection(\n      \"Set\",\n      types,\n      elems.map(x -> text.expr_text(x, d)),\n    ),\n    ast.Return(ast.UnitExpr) => \"return\",\n    ast.Return(x) => \"return \" + text.expr_text(x, d),\n    ast.Try { value, kind } => text.handled(value, d)\n      + match kind {\n        ast.TryResult => \"!\",\n        ast.TryOption => \"?\",\n      },\n    ast.Except { value, err, fallback } => if text.shorthand(e) {\n      text.wrap(value, 5, d) + \" !! \" + text.wrap(fallback, 4, d)\n    } else {\n      keyword := match err {\n        Some(n) => \"except \" + n,\n        None => \"except\",\n      }\n      text.fallback_text(\n        text.handled(value, d) + \" \" + keyword,\n        fallback,\n        d,\n      )\n    },\n    ast.Fallback { value, fallback } => if text.shorthand(e) {\n      text.wrap(value, 5, d) + \" ?? \" + text.wrap(fallback, 4, d)\n    } else {\n      text.fallback_text(\n        text.handled(value, d) + \" or\",\n        fallback,\n        d,\n      )\n    },\n  }\n}","old_text":"/// An expression on one line, except for the blocks inside it (laid out at\n/// depth `d`) and for what its parts break.\nfn inline(e: ast.Expr, d: Int) -> String {\n  match e {\n    ast.IntLit(n) => to_string(n),\n    ast.BigIntLit(digits) => digits,\n    ast.FloatLit(f) => text.float_text(f),\n    ast.TupleExpr(es) => \"(\" + text.args_text(es, d) + \")\",\n    ast.StrLit(s) => \"\\\"\" + text.escape(s) + \"\\\"\",\n    ast.BoolLit(b) => to_string(b),\n    ast.UnitExpr => \"()\",\n    ast.Var(v) => v,\n    ast.Hole(h) => \"?\" + h,\n    ast.ListExpr(es) => \"[\" + text.args_text(es, d) + \"]\",\n    ast.CtorExpr { name, args } => match args {\n      ast.NoArgs => name,\n      ast.PositionalArgs(es) => name + \"(\" + text.args_text(es, d) + \")\",\n      ast.RecordArgs(fs) => if len(fs) == 0 {\n        name + \" {}\"\n      } else {\n        text.ctor_open(name)\n          + \" \"\n          + join(text.named_parts(fs, d), \", \")\n          + \" }\"\n      },\n      ast.UpdateArgs { base, fields } => name\n        + \" { \"\n        + join([\"..\", text.expr_text(base, d)], \"\")\n        + if len(fields) == 0 {\n          \"\"\n        } else {\n          \", \" + join(text.named_parts(fields, d), \", \")\n        }\n        + \" }\",\n    },\n    ast.Call { callee, args } => text.callee_text(callee, d)\n      + \"(\"\n      + text.args_text(args, d)\n      + \")\",\n    ast.MethodCall { recv, name, args } => text.wrap(recv, 12, d)\n      + \".\"\n      + name\n      + \"(\"\n      + text.args_text(args, d)\n      + \")\",\n    ast.FieldOf { base, name } => text.wrap(base, 12, d) + \".\" + name,\n    ast.Lambda { params, body } => {\n      (ps, b) := text.lambda_view(params, body)\n      text.lambda_params(ps) + \" -> \" + text.expr_text(b, d)\n    },\n    ast.Binary { op, left, right } => {\n      p := text.prec(e)\n      match op {\n        ast.Implies => text.wrap(left, p + 1, d) + \" ==> \" + text.wrap(right, p, d),\n        ast.Equal | ast.NotEqual | ast.Less | ast.LessEq | ast.Greater | ast.GreaterEq => {\n          // `(x & 255) == x`: a bit operation compared is shown in parentheses,\n          // since C and its readers put `==` before `&`, `|`, `^`\n          l := if text.bitwise(left) {\n            \"(\" + text.expr_text(left, d) + \")\"\n          } else {\n            text.wrap(left, p, d)\n          }\n          r := if text.bitwise(right) {\n            \"(\" + text.expr_text(right, d) + \")\"\n          } else {\n            text.wrap(right, p + 1, d)\n          }\n          l + \" \" + text.symbol(op) + \" \" + r\n        },\n        _ => text.wrap(left, p, d)\n          + \" \"\n          + text.symbol(op)\n          + \" \"\n          + text.wrap(right, p + 1, d),\n      }\n    },\n    ast.Unary { op, operand } => match op {\n      ast.Neg => \"-\" + text.wrap(operand, 11, d),\n      ast.Not => \"!\" + text.wrap(operand, 11, d),\n    },\n    ast.IsExpr { value, variant } => text.wrap(value, 4, d) + \" is \" + variant,\n    ast.IfExpr { cond, then, otherwise } => {\n      s := \"if \" + text.head(cond, d) + \" \" + text.block_text(then, d)\n      match otherwise {\n        ast.UnitExpr => s,\n        ast.IfExpr { .. } => s + \" else \" + text.expr_text(otherwise, d),\n        _ => s + \" else \" + text.block_text(otherwise, d),\n      }\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      as_name := match binding {\n        Some(n) => \" as \" + n,\n        None => \"\",\n      }\n      mut out := \"match \" + text.head(scrutinee, d) + as_name + \" {\\n\"\n      for a in arms {\n        out += text.comments_text(a.comments, d + 1)\n        each := match a.pat {\n          ast.ForPat { each, list, .. } => \" for \"\n            + text.pattern_text(each)\n            + \" in \"\n            + text.head(list, d + 1),\n          _ => \"\",\n        }\n        out += text.ind(d + 1)\n          + text.pattern_text(a.pat)\n          + \" => \"\n          + text.expr_text(a.body, d + 1)\n          + each\n          + \",\\n\"\n      }\n      out + text.ind(d) + \"}\"\n    },\n    ast.Block { .. } => text.block_text(e, d),\n    ast.MockExpr(t) => \"mock \" + text.type_text(t),\n    ast.MutExpr(x) => \"mut \" + text.expr_text(x, d),\n    // `comptime` takes a unary expression: `comptime (a ?? b)`\n    ast.Comptime(x) => \"comptime \" + text.wrap(x, 11, d),\n    // `assumed` is written before the contract's keyword\n    ast.Assumed(x) => text.inline(x, d),\n    // `old` takes a unary expression without a sign: `old (-x)`, `old (a + b)`\n    ast.Old(x) => {\n      s := text.wrap(x, 11, d)\n      if starts_with(s, \"-\") || starts_with(s, \"!\") {\n        \"old (\" + s + \")\"\n      } else {\n        \"old \" + s\n      }\n    },\n    // a call's argument: `f(...x)`\n    ast.Spread(x) => \"...\" + text.expr_text(x, d),\n    ast.Spawn(x) => \"spawn \" + text.expr_text(x, d),\n    ast.SupervisedSpawn(x) => \"supervised spawn \" + text.expr_text(x, d),\n    // a handler on the operand's chain needs parentheses: `await (a!)`, since\n    // `await a!` is `(await a)!`\n    ast.Await(x) => if text.handler_on_spine(x) {\n      \"await (\" + text.expr_text(x, d) + \")\"\n    } else {\n      \"await \" + text.wrap(x, 11, d)\n    },\n    ast.Scope(b) => \"scope \" + text.block_text(b, d),\n    ast.Select(arms) | ast.Race(arms) => {\n      mut out := match e {\n        ast.Race(_) => \"race {\\n\",\n        _ => \"select {\\n\",\n      }\n      for a in arms {\n        as_name := match a.name {\n          Some(n) => \" as \" + n,\n          None => \"\",\n        }\n        // a supervised race arm is `supervised e`\n        op := match (e, a.op) {\n          (ast.Race(_), ast.SupervisedSpawn(x)) => \"supervised \" + text.expr_text(x, d + 1),\n          _ => text.expr_text(a.op, d + 1),\n        }\n        out += text.ind(d + 1)\n          + op\n          + as_name\n          + \" => \"\n          + text.expr_text(a.body, d + 1)\n          + \",\\n\"\n      }\n      out + text.ind(d) + \"}\"\n    },\n    ast.Interp(parts) => {\n      mut s := \"f\\\"\"\n      for p in parts {\n        s += match p {\n          // a lone `\\` before a brace is written `\\\\`: `\\{{` would read as `\\{`\n          // then `{`\n          ast.TextPart(l) => replace(replace(replace(\n            replace(text.escape(l), \"\\{\", \"\\\\\\{\"),\n            \"\\}\",\n            \"\\\\\\}\",\n          ), \"{\", \"{{\"), \"}\", \"}}\"),\n          ast.ValuePart { value, spec } => \"{\"\n            + text.inline(value, 0)\n            + match spec {\n              Some(f) => \":\" + text.spec_text(f),\n              None => \"\",\n            }\n            + \"}\",\n        }\n      }\n      s + \"\\\"\"\n    },\n    ast.Range { lo, hi, inclusive } => match lo {\n        Some(x) => text.wrap(x, 1, d),\n        None => \"\",\n      }\n      + if inclusive {\n        \"..=\"\n      } else {\n        \"..\"\n      }\n      + match hi {\n        Some(x) => text.wrap(x, 1, d),\n        None => \"\",\n      },\n    ast.Index { base, index } => text.wrap(base, 12, d) + \"[\" + text.expr_text(index, d) + \"]\",\n    ast.Comp { kind, elem, fors } => {\n      (open, close) := match kind {\n        ast.ListComp => (\"[\", \"]\"),\n        ast.SetComp => (\"Set { \", \" }\"),\n        ast.DictComp => (\"Dict { \", \" }\"),\n      }\n      mut s := open\n        + match (kind, elem) {\n          (ast.DictComp, ast.TupleExpr([k, v])) => text.expr_text(k, d) + \": \" + text.expr_text(v, d),\n          _ => text.expr_text(elem, d),\n        }\n      for g in fors {\n        s += \" for \"\n          + text.pattern_text(g.pat)\n          + \" in \"\n          + text.expr_text(g.iter, d)\n        match g.cond {\n          Some(c) => {\n            s += \" where \" + text.expr_text(c, d)\n          },\n          None => (),\n        }\n      }\n      s + close\n    },\n    ast.DictExpr { types, entries } => text.collection(\"Dict\", types, entries.map(\n      kv -> text.expr_text(kv.0, d) + \": \" + text.expr_text(kv.1, d),\n    )),\n    ast.SetExpr { types, elems } => text.collection(\n      \"Set\",\n      types,\n      elems.map(x -> text.expr_text(x, d)),\n    ),\n    ast.Return(ast.UnitExpr) => \"return\",\n    ast.Return(x) => \"return \" + text.expr_text(x, d),\n    ast.Try { value, kind } => text.handled(value, d)\n      + match kind {\n        ast.TryResult => \"!\",\n        ast.TryOption => \"?\",\n      },\n    ast.Except { value, err, fallback } => if text.shorthand(e) {\n      text.wrap(value, 5, d) + \" !! \" + text.wrap(fallback, 4, d)\n    } else {\n      keyword := match err {\n        Some(n) => \"except \" + n,\n        None => \"except\",\n      }\n      text.fallback_text(\n        text.handled(value, d) + \" \" + keyword,\n        fallback,\n        d,\n      )\n    },\n    ast.Fallback { value, fallback } => if text.shorthand(e) {\n      text.wrap(value, 5, d) + \" ?? \" + text.wrap(fallback, 4, d)\n    } else {\n      text.fallback_text(\n        text.handled(value, d) + \" or\",\n        fallback,\n        d,\n      )\n    },\n  }\n}"},{"name":"text.ctor_open","kind":"fn","old":"628836085ac5f958","new":"9af88f3535b2100a","interface_changed":false,"affected":[],"module":"text","text":"/// A record literal's opening: `Order {`, or `{` for an anonymous record.\nfn ctor_open(name: String) -> String {\n  if starts_with(name, \"$rec:\") || name == \"\" {\n    \"{\"\n  } else {\n    name + \" {\"\n  }\n}","old_text":"/// A record literal's opening: `Order {`, or `{` for an anonymous record.\nfn ctor_open(name: String) -> String {\n  if starts_with(name, \"$rec:\") {\n    \"{\"\n  } else {\n    name + \" {\"\n  }\n}"},{"name":"check.ctor_name","kind":"fn","old":null,"new":"0e715443d907480b","interface_changed":true,"affected":[],"module":"check","text":"fn ctor_name(e: ast.Expr) -> String {\n  match e {\n    ast.CtorExpr { name, .. } => name,\n    _ => \"?\",\n  }\n}"},{"name":"check.updates_named","kind":"fn","old":null,"new":"3aad4494989392b6","interface_changed":true,"affected":[],"module":"check","text":"/// `e` with each nameless update (`{ ..x, f: v }`, tagged `$upd:PATH` by\n/// `spread_bound`) named by the type its base got: a record's name, or a\n/// type parameter's, which codegen and verify read as the record it stands\n/// for.\nfn updates_named(i: check.Inf, e: ast.Expr) -> ast.Expr {\n  walk.rewrite_expr(e, x -> match x {\n    ast.CtorExpr { name, args } => if starts_with(name, \"$upd:\") {\n      ast.CtorExpr {\n        name: match check.res(i, get(i.insts, name) ?? check.TAny) {\n          check.TNamed { name: n, .. } => n,\n          check.TGen(p) => p,\n          _ => \"\",\n        },\n        args,\n      }\n    } else {\n      x\n    },\n    _ => x,\n  })\n}"},{"name":"check.infer_update","kind":"fn","old":null,"new":"19b587de95d24de0","interface_changed":true,"affected":[],"module":"check","text":"/// `{ ..x, f: v }`: of `x`'s type, which has each field given, of a type\n/// that fits.\nfn infer_update(\n  mut i: check.Inf,\n  tag: String,\n  base: ast.Expr,\n  fields: List[(String, ast.Expr)],\n  env: Dict[String, check.Ty],\n) -> check.Ty {\n  bt := check.infer(mut i, base, env, None)\n  mut i.insts.insert(tag, bt)\n  shown_b := check.shown(check.res(i, bt)) ?? \"?\"\n  for f in fields {\n    want := match check.res(i, bt) {\n      check.TGen(p) => match get(i.trows, p) {\n        Some(fs) => match fs.filter(x -> x.0 == f.0) {\n          [x, ..] => Some(x.1),\n          _ => None,\n        },\n        None => None,\n      },\n      check.TNamed { name, args } => match get(i.types.ctors, name) {\n        Some(sh) => if sh.positional || sh.owner != name {\n          None\n        } else {\n          match check.field_of(sh, f.0) {\n            Some(ft) => Some(check.inst(ft, check.pairs(sh.params, args))),\n            None => None,\n          }\n        },\n        None => None,\n      },\n      _ => Some(check.TAny),\n    }\n    match want {\n      Some(w) => {\n        got := check.infer(mut i, f.1, env, Some(w))\n        if !check.fits(mut i, w, got) {\n          mut i.spread_errs.push(\n            f\"`{{ ..{text.expr_text(base, 0)}, {f.0}: … }}`: field `{f.0}` of `{shown_b}` is `{check.shown(check.res(i, w)) ?? \"?\"}`, not `{check.shown(check.res(i, got)) ?? \"?\"}`\",\n          )\n        }\n      },\n      None => mut i.spread_errs.push(\n        f\"`{{ ..{text.expr_text(base, 0)}, {f.0}: … }}`: `{shown_b}` has no field `{f.0}`\",\n      ),\n    }\n  }\n  bt\n}"},{"name":"desugar.updates_assigned","kind":"fn","old":null,"new":"152de5b2992667bf","interface_changed":true,"affected":[],"module":"desugar","text":"/// `e` with each `x = T { ..x, f: v }` (or `{ ..x, f: v }`) in a block,\n/// the place assigned the update's base, written as assignments to its\n/// fields: `{ $upd_f := v; x.f = $upd_f }`. The values are computed first,\n/// from `x` as it was. So the two forms are one program: the same code (a\n/// field assigned in place when `x` is held once) and the same proof.\nfn updates_assigned(e: ast.Expr) -> ast.Expr {\n  match e {\n    ast.Block { stmts, last } => if stmts.any(s -> desugar.self_update(s) is Some) {\n      mut out := []\n      for s in stmts {\n        match desugar.self_update(s) {\n          Some((place, fields)) => {\n            mut inner := []\n            for f in fields {\n              mut inner.push(\n                ast.Let {\n                  pat: ast.Bind(\"$upd_\" + f.0),\n                  ty: None,\n                  value: f.1,\n                },\n              )\n            }\n            for f in fields {\n              mut inner.push(\n                ast.Assign {\n                  place: ast.FieldOf { base: place, name: f.0 },\n                  value: ast.Var(\"$upd_\" + f.0),\n                },\n              )\n            }\n            mut out.push(\n              ast.ExprStmt(\n                ast.Block { stmts: inner, last: ast.UnitExpr },\n              ),\n            )\n          },\n          None => mut out.push(s),\n        }\n      }\n      ast.Block { stmts: out, last }\n    } else {\n      e\n    },\n    _ => e,\n  }\n}"},{"name":"desugar.self_update","kind":"fn","old":null,"new":"0a3825d9195c9bec","interface_changed":true,"affected":[],"module":"desugar","text":"/// The place and fields of `x = T { ..x, f: v }`, when `s` is one.\nfn self_update(s: ast.Stmt) -> Option[(ast.Expr, List[(String, ast.Expr)])] {\n  match s {\n    ast.Assign { place, value: ast.CtorExpr { args: ast.UpdateArgs { base, fields }, .. } } => if base == place && (place is ast.Var || place is ast.FieldOf) {\n      Some((place, fields))\n    } else {\n      None\n    },\n    _ => None,\n  }\n}"},{"name":"parse.nameless_update","kind":"fn","old":null,"new":"591093f8e5b19606","interface_changed":true,"affected":[],"module":"parse","text":"/// `{ ..x, total: 0 }` at its `{`: `x` with those fields changed, of `x`'s\n/// type (a record, a structural or an anonymous one). The checker writes\n/// the type's name in (`check.updates_named`).\nfn nameless_update(mut p: parse.Parser) -> Result[ast.Expr, String] {\n  parse.expect_sym(mut p, \"{\")!\n  (ns, np) := (p.no_struct, p.no_pipe)\n  p.no_struct = false\n  p.no_pipe = false\n  parse.expect_sym(mut p, \"..\")!\n  base := parse.expr(mut p)!\n  mut fs := []\n  while parse.eat_sym(mut p, \",\") {\n    if parse.is_sym(p, \"}\") {\n      break\n    }\n    n := parse.ident(mut p)!\n    if fs.any(f -> f.0 == n) {\n      return parse.fail(p, f\"field `{n}` is given twice\")\n    }\n    parse.expect_sym(mut p, \":\")!\n    mut fs.push((n, parse.expr(mut p)!))\n  }\n  parse.expect_sym(mut p, \"}\")!\n  p.no_struct = ns\n  p.no_pipe = np\n  Ok(ast.CtorExpr {\n    name: \"\",\n    args: ast.UpdateArgs { base, fields: fs },\n  })\n}"}]}
{"id":"91c5abe621ec39c5","time":1795734514,"message":"edit","changes":[{"name":"desugar.use walk","kind":"use","old":"fa173cdeda1dbcb2","new":"6dc183781246315f","interface_changed":true,"affected":[],"module":"desugar","text":"from walk use expr_children, type_children, decl_parts, kids, kid_types,\n  type_kids, decl_kids, decl_types, decl_exprs, rewrite_expr, rewrite_decl,\n  any_expr","old_text":"from walk use expr_children, type_children, decl_parts, kids, kid_types,\n  type_kids, decl_kids, decl_types, rewrite_expr, rewrite_decl, any_expr"},{"name":"desugar.anon_types","kind":"fn","old":"47a8ff7f106f9cb0","new":"53d382ad02243c6e","interface_changed":false,"affected":[],"module":"desugar","text":"/// The record types the anonymous records and their types name\n/// (`$rec:id:total`) and neither `ds` nor `context` declares: one per set\n/// of field names, generic in each field's type, its fields in order of\n/// name, in the root module. `{ id: 1, total: 0 }` is a\n/// `$rec:id:total[Int, Int]`.\nfn anon_types(ds: List[ast.Decl], context: List[ast.Decl]) -> List[ast.Decl] {\n  mut have := Set[String] {}\n  for d in ds + context {\n    match d.kind {\n      ast.TypeDef(t) => if starts_with(t.name, \"$rec:\") {\n        mut have.insert(t.name)\n      },\n      _ => (),\n    }\n  }\n  mut want := Set[String] {}\n  for d in ds {\n    for t in walk.decl_types(d) {\n      match t {\n        ast.Named { name, .. } => if starts_with(name, \"$rec:\") {\n          mut want.insert(name)\n        },\n        _ => (),\n      }\n    }\n    for e in walk.decl_exprs(d) {\n      match e {\n        ast.CtorExpr { name, .. } => if starts_with(name, \"$rec:\") {\n          mut want.insert(name)\n        },\n        _ => (),\n      }\n    }\n  }\n  mut out := []\n  for n in to_list(want).sorted() {\n    if !contains(have, n) {\n      fs := drop(split(n, \":\"), 1)\n      mut out.push(\n        ast.Decl {\n          comments: [],\n          doc: [],\n          module: \"\",\n          public: true,\n          kind: ast.TypeDef(ast.TypeDecl {\n            distinct: false,\n            name: n,\n            params: fs.map(f -> \"$\" + f),\n            body: ast.RecordBody(fs.map(\n              f -> ast.Field {\n                comments: [],\n                doc: [],\n                name: f,\n                ty: ast.Named { name: \"$\" + f, args: [] },\n                default: None,\n              },\n            )),\n            refinement: None,\n            mocked: false,\n          }),\n        },\n      )\n    }\n  }\n  out\n}","old_text":"/// The record types the anonymous records and their types name\n/// (`$rec:id:total`) and neither `ds` nor `context` declares: one per set\n/// of field names, generic in each field's type, its fields in order of\n/// name, in the root module. `{ id: 1, total: 0 }` is a\n/// `$rec:id:total[Int, Int]`.\nfn anon_types(ds: List[ast.Decl], context: List[ast.Decl]) -> List[ast.Decl] {\n  mut have := Set[String] {}\n  for d in ds + context {\n    match d.kind {\n      ast.TypeDef(t) => if starts_with(t.name, \"$rec:\") {\n        mut have.insert(t.name)\n      },\n      _ => (),\n    }\n  }\n  mut want := Set[String] {}\n  for d in ds {\n    for t in walk.decl_types(d) {\n      match t {\n        ast.Named { name, .. } => if starts_with(name, \"$rec:\") {\n          mut want.insert(name)\n        },\n        _ => (),\n      }\n    }\n    for e in decl_exprs(d) {\n      match e {\n        ast.CtorExpr { name, .. } => if starts_with(name, \"$rec:\") {\n          mut want.insert(name)\n        },\n        _ => (),\n      }\n    }\n  }\n  mut out := []\n  for n in to_list(want).sorted() {\n    if !contains(have, n) {\n      fs := drop(split(n, \":\"), 1)\n      mut out.push(\n        ast.Decl {\n          comments: [],\n          doc: [],\n          module: \"\",\n          public: true,\n          kind: ast.TypeDef(ast.TypeDecl {\n            distinct: false,\n            name: n,\n            params: fs.map(f -> \"$\" + f),\n            body: ast.RecordBody(fs.map(\n              f -> ast.Field {\n                comments: [],\n                doc: [],\n                name: f,\n                ty: ast.Named { name: \"$\" + f, args: [] },\n                default: None,\n              },\n            )),\n            refinement: None,\n            mocked: false,\n          }),\n        },\n      )\n    }\n  }\n  out\n}"}]}
{"id":"b17e15f8398a42f7","time":1795734613,"message":"edit","changes":[{"name":"check.spread_filled","kind":"fn","old":"27c3922e1d65c820","new":"7a9f45fde83b06a2","interface_changed":false,"affected":[],"module":"check","text":"/// The arguments of a call spreading records, written out. Positional\n/// arguments before the spreads give the first parameters, those after\n/// them the last, and each parameter left is the field of that name of the\n/// one record that has it. `None`, with the errors reported, if that can't\n/// be done.\nfn spread_filled(\n  mut i: check.Inf,\n  shown_call: String,\n  fname: String,\n  ps: List[ast.Param],\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n) -> Option[List[ast.Expr]] {\n  mut first := 0\n  while first < len(args) && !(args[first] is ast.Spread) {\n    first += 1\n  }\n  mut past := first\n  while past < len(args) && args[past] is ast.Spread {\n    past += 1\n  }\n  before := args[..first]\n  spreads := args[first..past]\n  after := args[past..]\n  if after.any(a -> a is ast.Spread) {\n    check.spread_error(\n      mut i,\n      \"`\"\n        + shown_call\n        + \"`: a positional argument between spreads: write positional arguments before the spreads (they give the first parameters) or after them (the last)\",\n    )\n    return None\n  }\n  given := len(before) + len(after)\n  if given > len(ps) {\n    check.spread_error(mut i, \"`\"\n      + shown_call\n      + \"`: \"\n      + to_string(given)\n      + \" positional arguments, but `\"\n      + fname\n      + \"` takes \"\n      + to_string(len(ps)))\n    return None\n  }\n  // each record spread: its code, its type, its fields\n  mut recs: List[(ast.Expr, String, List[String])] = []\n  mut ok := true\n  for s in spreads {\n    v := match s {\n      ast.Spread(x) => x,\n      _ => s,\n    }\n    t := check.res(i, check.infer(mut i, v, env, None))\n    fields := match t {\n      check.TNamed { name, .. } => match get(i.types.ctors, name) {\n        Some(sh) => if !sh.positional && sh.owner == name {\n          Some(sh.fields.map(f -> f.0))\n        } else {\n          None\n        },\n        None => None,\n      },\n      _ => None,\n    }\n    match fields {\n      Some(fs) => mut recs.push((v, check.shown(t) ?? \"?\", fs)),\n      None => {\n        ok = false\n        // a type not known after an error of a spread inside it: already reported\n        if check.shown(t) is Some || i.spread_errs == [] {\n          check.spread_error(mut i, \"`...\"\n            + text.expr_text(v, 0)\n            + \"`: \"\n            + match check.shown(t) {\n              Some(x) => \"`\"\n                + text.expr_text(v, 0)\n                + \"` is `\"\n                + x\n                + \"`, not a record\",\n              None => \"the type of `\"\n                + text.expr_text(v, 0)\n                + \"` isn't known here (give it one)\",\n            }\n            + \": a spread gives a record's fields\")\n        }\n      },\n    }\n  }\n  if !ok {\n    return None\n  }\n  mut filled := []\n  mut used := Set[Int] {}\n  for p in ps[len(before)..len(ps) - len(after)] {\n    givers := [j for (j, r) in enumerate(recs) where r.2.contains(p.name)]\n    match givers {\n      // a structural parameter no field names: the record spread itself,\n      // which the call then checks against the bound\n      [] => if len(recs) == 1 && check.structural_param(i, fname, p) {\n        mut used.insert(0)\n        mut filled.push(recs[0].0)\n      } else {\n        ok = false\n        check.spread_error(mut i, \"`\"\n          + shown_call\n          + \"`: no argument for parameter `\"\n          + p.name\n          + \"` of `\"\n          + fname\n          + \"`: \"\n          + if len(recs) == 1 {\n            \"`\"\n          } else {\n            \"none of `\"\n          }\n          + join(recs.map(\n            r -> text.expr_text(r.0, 0) + \"` (`\" + r.1 + \"`)\",\n          ), \", `\")\n          + if len(recs) == 1 {\n            \" has no field `\"\n          } else {\n            \" has a field `\"\n          }\n          + p.name\n          + \"`\")\n      },\n      [j] => {\n        r := recs[j]\n        mut used.insert(j)\n        if p.mutable {\n          ok = false\n          check.spread_error(\n            mut i,\n            \"`\"\n              + shown_call\n              + \"`: parameter `\"\n              + p.name\n              + \"` of `\"\n              + fname\n              + \"` is `mut`: pass it as a positional argument (`mut …`), as a spread only reads `\"\n              + text.expr_text(r.0, 0)\n              + \"`\",\n          )\n        } else {\n          mut filled.push(ast.FieldOf { base: r.0, name: p.name })\n        }\n      },\n      _ => {\n        ok = false\n        for j in givers {\n          mut used.insert(j)\n        }\n        check.spread_error(mut i, \"`\"\n          + shown_call\n          + \"`: parameter `\"\n          + p.name\n          + \"` of `\"\n          + fname\n          + \"` is given by both `...\"\n          + join(\n            givers.map(j -> text.expr_text(recs[j].0, 0)),\n            \"` and `...\",\n          )\n          + \"` (each has a field `\"\n          + p.name\n          + \"`)\")\n      },\n    }\n  }\n  // a record that gives nothing, once the rest is right\n  for (j, r) in enumerate(recs) {\n    if ok && !contains(used, j) {\n      ok = false\n      check.spread_error(mut i, \"`\"\n        + shown_call\n        + \"`: `...\"\n        + text.expr_text(r.0, 0)\n        + \"` gives no parameter of `\"\n        + fname\n        + \"` (`\"\n        + r.1\n        + \"` has no field named like a parameter left to fill)\")\n    }\n  }\n  if ok {\n    Some(before + filled + after)\n  } else {\n    None\n  }\n}","old_text":"/// The arguments of a call spreading records, written out. Positional\n/// arguments before the spreads give the first parameters, those after\n/// them the last, and each parameter left is the field of that name of the\n/// one record that has it. `None`, with the errors reported, if that can't\n/// be done.\nfn spread_filled(\n  mut i: check.Inf,\n  shown_call: String,\n  fname: String,\n  ps: List[ast.Param],\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n) -> Option[List[ast.Expr]] {\n  mut first := 0\n  while first < len(args) && !(args[first] is ast.Spread) {\n    first += 1\n  }\n  mut past := first\n  while past < len(args) && args[past] is ast.Spread {\n    past += 1\n  }\n  before := args[..first]\n  spreads := args[first..past]\n  after := args[past..]\n  if after.any(a -> a is ast.Spread) {\n    check.spread_error(\n      mut i,\n      \"`\"\n        + shown_call\n        + \"`: a positional argument between spreads: write positional arguments before the spreads (they give the first parameters) or after them (the last)\",\n    )\n    return None\n  }\n  given := len(before) + len(after)\n  if given > len(ps) {\n    check.spread_error(mut i, \"`\"\n      + shown_call\n      + \"`: \"\n      + to_string(given)\n      + \" positional arguments, but `\"\n      + fname\n      + \"` takes \"\n      + to_string(len(ps)))\n    return None\n  }\n  // each record spread: its code, its type, its fields\n  mut recs: List[(ast.Expr, String, List[String])] = []\n  mut ok := true\n  for s in spreads {\n    v := match s {\n      ast.Spread(x) => x,\n      _ => s,\n    }\n    t := check.res(i, check.infer(mut i, v, env, None))\n    fields := match t {\n      check.TNamed { name, .. } => match get(i.types.ctors, name) {\n        Some(sh) => if !sh.positional && sh.owner == name {\n          Some(sh.fields.map(f -> f.0))\n        } else {\n          None\n        },\n        None => None,\n      },\n      _ => None,\n    }\n    match fields {\n      Some(fs) => mut recs.push((v, check.shown(t) ?? \"?\", fs)),\n      None => {\n        ok = false\n        // a type not known after an error of a spread inside it: already reported\n        if check.shown(t) is Some || i.spread_errs == [] {\n          check.spread_error(mut i, \"`...\"\n            + text.expr_text(v, 0)\n            + \"`: \"\n            + match check.shown(t) {\n              Some(x) => \"`\"\n                + text.expr_text(v, 0)\n                + \"` is `\"\n                + x\n                + \"`, not a record\",\n              None => \"the type of `\"\n                + text.expr_text(v, 0)\n                + \"` isn't known here (give it one)\",\n            }\n            + \": a spread gives a record's fields\")\n        }\n      },\n    }\n  }\n  if !ok {\n    return None\n  }\n  mut filled := []\n  mut used := Set[Int] {}\n  for p in ps[len(before)..len(ps) - len(after)] {\n    givers := [j for (j, r) in enumerate(recs) where r.2.contains(p.name)]\n    match givers {\n      [] => {\n        ok = false\n        check.spread_error(mut i, \"`\"\n          + shown_call\n          + \"`: no argument for parameter `\"\n          + p.name\n          + \"` of `\"\n          + fname\n          + \"`: \"\n          + if len(recs) == 1 {\n            \"`\"\n          } else {\n            \"none of `\"\n          }\n          + join(recs.map(\n            r -> text.expr_text(r.0, 0) + \"` (`\" + r.1 + \"`)\",\n          ), \", `\")\n          + if len(recs) == 1 {\n            \" has no field `\"\n          } else {\n            \" has a field `\"\n          }\n          + p.name\n          + \"`\")\n      },\n      [j] => {\n        r := recs[j]\n        mut used.insert(j)\n        if p.mutable {\n          ok = false\n          check.spread_error(\n            mut i,\n            \"`\"\n              + shown_call\n              + \"`: parameter `\"\n              + p.name\n              + \"` of `\"\n              + fname\n              + \"` is `mut`: pass it as a positional argument (`mut …`), as a spread only reads `\"\n              + text.expr_text(r.0, 0)\n              + \"`\",\n          )\n        } else {\n          mut filled.push(ast.FieldOf { base: r.0, name: p.name })\n        }\n      },\n      _ => {\n        ok = false\n        for j in givers {\n          mut used.insert(j)\n        }\n        check.spread_error(mut i, \"`\"\n          + shown_call\n          + \"`: parameter `\"\n          + p.name\n          + \"` of `\"\n          + fname\n          + \"` is given by both `...\"\n          + join(\n            givers.map(j -> text.expr_text(recs[j].0, 0)),\n            \"` and `...\",\n          )\n          + \"` (each has a field `\"\n          + p.name\n          + \"`)\")\n      },\n    }\n  }\n  // a record that gives nothing, once the rest is right\n  for (j, r) in enumerate(recs) {\n    if ok && !contains(used, j) {\n      ok = false\n      check.spread_error(mut i, \"`\"\n        + shown_call\n        + \"`: `...\"\n        + text.expr_text(r.0, 0)\n        + \"` gives no parameter of `\"\n        + fname\n        + \"` (`\"\n        + r.1\n        + \"` has no field named like a parameter left to fill)\")\n    }\n  }\n  if ok {\n    Some(before + filled + after)\n  } else {\n    None\n  }\n}"},{"name":"check.structural_param","kind":"fn","old":null,"new":"ce9f507493e203f3","interface_changed":true,"affected":[],"module":"check","text":"/// A parameter of `fname` whose type is a type parameter with a structural\n/// bound (`x: { id: Int, .. }`, lifted to `$x`, or `x: T` with\n/// `[T: { id: Int, .. }]`).\nfn structural_param(i: check.Inf, fname: String, p: ast.Param) -> Bool {\n  match p.ty {\n    ast.Named { name, args: [] } => starts_with(name, \"$\")\n      || match get(i.methods.rows, fname) {\n        Some(rs) => contains(rs, name),\n        None => false,\n      },\n    _ => false,\n  }\n}"}]}
{"id":"54ab28ceb75a7a96","time":1795734698,"message":"edit","changes":[{"name":"check.infer_method","kind":"fn","old":"702e67635dfa398d","new":"09f33ad3efb1c335","interface_changed":false,"affected":[],"module":"check","text":"/// A call `recv.m(args)`: a method of the receiver's type, or one of the\n/// program's functions or a built-in with the receiver as its first\n/// argument. Other calls (std's methods, closures) are not modelled.\n/// `marked`: written `mut recv.m(..)`.\nfn infer_method(\n  mut i: check.Inf,\n  recv: ast.Expr,\n  m: String,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n  marked: Bool,\n) -> check.Ty {\n  seq := i.call_seq\n  i.call_seq += 1\n  // `Item.new(..)`, `T.zero()`: a method called on a type\n  match recv {\n    ast.CtorExpr { name: tn, args: ast.NoArgs } => if contains(i.types.named, tn)\n      || contains(i.tparams, tn)\n      || [\"Int\", \"Float\", \"Bool\", \"String\"].contains(tn) {\n      mut i.recvs.push((m, check.TNamed { name: tn, args: [] }))\n      return check.static_call(mut i, tn, m, args, env)\n    },\n    // a type with its arguments as the receiver, as `derive` writes it:\n    // `{ $type: List[Int] := (); $type }.from_json_at(..)`\n    ast.Block { stmts: [ast.Let { pat: ast.Bind(\"$type\"), ty: Some(t), value: ast.UnitExpr }], last: ast.Var(\"$type\") } => return check.static_call(mut i, check.type_head(t), m, args, env),\n    _ => (),\n  }\n  rt := check.infer(mut i, recv, env, None)\n  mut i.recvs.push((m, rt))\n  // two traits with `m`, and nothing to choose between them\n  match check.ambiguity(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `s.bigger(t)` with `bigger(self, other: Self)` on a trait value\n  check.self_args(mut i, recv, check.res(i, rt), m, args)\n  // a code trait's method on a type that isn't one (`fold` of an iterator\n  // that may not end), or whose `impl` asks more of its arguments\n  match check.code_method_problem(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `xs.to_list()` of what is a list already (`s.code_points()`, a\n  // comprehension over one) is itself\n  match check.res(i, rt) {\n    check.TList(_) => if m == \"to_list\" && len(args) == 0 {\n      return rt\n    },\n    _ => (),\n  }\n  // a value narrowed to some variants has its sum's methods\n  rt_whole := check.widened(check.res(i, rt))\n  own := match rt_whole {\n    // a generic `impl`'s parameters are the receiver's type arguments\n    check.TNamed { name, args } => match get(i.methods.of, name + \".\" + m) {\n      Some(t) => Some(check.inst(\n        t,\n        check.pairs(\n          get(i.methods.params, name + \".\" + m) ?? [],\n          args,\n        ),\n      )),\n      None => match check.code_trait_method(i, name, m, rt_whole) {\n        Some(t) => Some(t),\n        // a method a trait it implements provides (`to_json` of a type deriving\n        // `Json`)\n        None => check.provided_method(i, name, m, rt_whole),\n      },\n    },\n    // `xs.iter()`: a list's method of core's code traits\n    check.TList(_) => check.code_trait_method(i, \"List\", m, check.res(i, rt)),\n    // `s.bytes()`, `s.graphemes()`: a string's methods of code traits\n    check.TStr => check.string_method(i, m),\n    // `x.m()` with `x: T` and `T: Tr`: the trait's method, `Self` being `T`\n    check.TGen(p) => check.bound_method(i, p, m),\n    // a trait value: the trait's method\n    check.TTrait(tr) => check.trait_method(i, tr, m, check.TTrait(tr), 8),\n    _ => None,\n  }\n  // a method of one of the program's types that changes its receiver\n  // (`mut self`) is called `mut recv.m(..)`, and only such a method is\n  // called so\n  match check.res(i, rt) {\n    check.TNamed { name, .. } => if check.program_type(i, name)\n      && contains(i.methods.self_methods, name + \".\" + m) {\n      changes := contains(i.methods.mut_self, name + \".\" + m)\n      shown := text.expr_text(recv, 0)\n      if changes && !marked {\n        check.error(mut i, \"`\"\n          + m\n          + \"` changes its receiver (`mut self`): write `mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)` to show that `\"\n          + shown\n          + \"` may change\")\n      } else if marked && !changes {\n        check.error(mut i, \"`mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)`: `\"\n          + m\n          + \"` doesn't change its receiver (it doesn't take `mut self`)\")\n      }\n    },\n    _ => (),\n  }\n  // `.to_list()` of what the checker types as a list (a comprehension or a\n  // built-in over a string's code points) is the list\n  if m == \"to_list\"\n    && len(args) == 0\n    && check.res(i, rt) is check.TList {\n    return check.res(i, rt)\n  }\n  // `x.f(..)` with `f` a built-in function is `f(x, ..)`, on a list even\n  // when a trait has a method of that name (`xs.map(f)`)\n  if own is None\n    && check.known(check.res(i, rt))\n    && !contains(env, m)\n    && (!contains(i.methods.names, m)\n      || check.res(i, rt) is check.TList\n      || check.is_table(check.res(i, rt)))\n    && get(i.fns, m) is None {\n    match get(i.builtins, m) {\n      Some(bs) => {\n        check.changing_call(mut i, recv, m, bs, marked)\n        return check.builtin_call(mut i, m, bs, [rt], args, env)\n      },\n      None => (),\n    }\n  }\n  sig := match own {\n    Some(t) => Some(t),\n    // a receiver of a type not known may have a method of that name, such as\n    // one of std's types\n    None => if !check.known(check.res(i, rt))\n      || contains(env, m)\n      || contains(i.methods.names, m)\n      || contains(i.builtins, m) {\n      None\n    } else {\n      get(i.fns, m)\n    },\n  }\n  match sig {\n    Some(t) => {\n      vars := check.fresh_for(mut i, to_list(check.gens(t, Set[String] {})))\n      ft := check.inst(t, vars)\n      match ft {\n        check.TFn { params, ret } => {\n          what := \"call to `\" + m + \"`\"\n          if len(params) != len(args) + 1 {\n            check.error(mut i, what\n              + \": expects \"\n              + to_string(len(params))\n              + \" arguments, got \"\n              + to_string(len(args) + 1))\n            return ret\n          }\n          check.expect(\n            mut i,\n            get(params, 0) ?? check.TAny,\n            rt,\n            what + \", argument 1\",\n          )\n          mut ats := []\n          mut arg_types := [rt]\n          for (k, a) in enumerate(args) {\n            p := get(params, k + 1) ?? check.TAny\n            at := check.listed_arg(\n              mut i,\n              m,\n              k,\n              a,\n              p,\n              check.infer(mut i, a, env, Some(p)),\n              what,\n            )\n            mut arg_types.push(at)\n            check.expect(\n              mut i,\n              p,\n              at,\n              what + \", argument \" + to_string(k + 2),\n            )\n            mut ats.push(at)\n          }\n          // a method with structural bounds, a type's own or a trait's (through\n          // a trait value or a bound): each one met by the type an argument\n          // gives its type parameter (`own` has the method's type parameters\n          // as `TAny`), a generic `impl`'s parameters being the receiver's\n          // type arguments\n          match check.method_rows_at(i, own is Some, check.res(i, rt), m) {\n            Some((key, rs, raw, sub)) => {\n              for (q, fs) in rs {\n                mut met := false\n                for (k, at) in enumerate(ats) {\n                  if !met {\n                    match check.given_for(\n                      i,\n                      get(raw, k + 1) ?? check.TAny,\n                      at,\n                      q,\n                    ) {\n                      Some(g) => {\n                        met = true\n                        check.row_met(mut i, key, fs, sub, g)\n                      },\n                      None => (),\n                    }\n                  }\n                }\n              }\n            },\n            None => (),\n          }\n          // a method's result, narrowed by what it (or its trait) says of it\n          key := check.method_facts_key(i, check.res(i, rt), m)\n          i.last_call = match check.narrowed_at(i, key, arg_types, ret) {\n            Some((_, _, left, u)) => (seq, key, to_list(left).sorted(), u),\n            None => (seq, key, [], false),\n          }\n          check.narrowed_result(i, key, arg_types, ret)\n        },\n        _ => check.TAny,\n      }\n    },\n    None => {\n      // a method no `impl`, trait or function has, on one of the program's\n      // types the checker sees every method of\n      match check.res(i, rt) {\n        check.TNamed { name, .. } => if check.program_type(i, name)\n          && !contains(i.methods.foreign, name)\n          && !contains(env, m)\n          && !contains(i.methods.names, m)\n          && get(i.fns, m) is None\n          && get(i.builtins, m) is None {\n          check.error(mut i, \"unknown function `\" + m + \"`\")\n        },\n        _ => (),\n      }\n      // `true.price()`: a method of one of the file's traits, on a value of a\n      // basic or program type, which must implement it\n      match check.res(i, rt) {\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TNamed { .. } => if !contains(env, m) {\n          match check.own_trait_of(i, m) {\n            Some(tr) => mut i.pending.push((rt, tr, m)),\n            None => (),\n          }\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}","old_text":"/// A call `recv.m(args)`: a method of the receiver's type, or one of the\n/// program's functions or a built-in with the receiver as its first\n/// argument. Other calls (std's methods, closures) are not modelled.\n/// `marked`: written `mut recv.m(..)`.\nfn infer_method(\n  mut i: check.Inf,\n  recv: ast.Expr,\n  m: String,\n  args: List[ast.Expr],\n  env: Dict[String, check.Ty],\n  marked: Bool,\n) -> check.Ty {\n  seq := i.call_seq\n  i.call_seq += 1\n  // `Item.new(..)`, `T.zero()`: a method called on a type\n  match recv {\n    ast.CtorExpr { name: tn, args: ast.NoArgs } => if contains(i.types.named, tn)\n      || contains(i.tparams, tn)\n      || [\"Int\", \"Float\", \"Bool\", \"String\"].contains(tn) {\n      mut i.recvs.push((m, check.TNamed { name: tn, args: [] }))\n      return check.static_call(mut i, tn, m, args, env)\n    },\n    // a type with its arguments as the receiver, as `derive` writes it:\n    // `{ $type: List[Int] := (); $type }.from_json_at(..)`\n    ast.Block { stmts: [ast.Let { pat: ast.Bind(\"$type\"), ty: Some(t), value: ast.UnitExpr }], last: ast.Var(\"$type\") } => return check.static_call(mut i, check.type_head(t), m, args, env),\n    _ => (),\n  }\n  rt := check.infer(mut i, recv, env, None)\n  mut i.recvs.push((m, rt))\n  // two traits with `m`, and nothing to choose between them\n  match check.ambiguity(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `s.bigger(t)` with `bigger(self, other: Self)` on a trait value\n  check.self_args(mut i, recv, check.res(i, rt), m, args)\n  // a code trait's method on a type that isn't one (`fold` of an iterator\n  // that may not end), or whose `impl` asks more of its arguments\n  match check.code_method_problem(i, check.res(i, rt), m) {\n    Some(msg) => {\n      check.error(mut i, msg)\n      check.infer_all(mut i, args, env)\n      return check.TAny\n    },\n    None => (),\n  }\n  // `xs.to_list()` of what is a list already (`s.code_points()`, a\n  // comprehension over one) is itself\n  match check.res(i, rt) {\n    check.TList(_) => if m == \"to_list\" && len(args) == 0 {\n      return rt\n    },\n    _ => (),\n  }\n  // a value narrowed to some variants has its sum's methods\n  rt_whole := check.widened(check.res(i, rt))\n  own := match rt_whole {\n    // a generic `impl`'s parameters are the receiver's type arguments\n    check.TNamed { name, args } => match get(i.methods.of, name + \".\" + m) {\n      Some(t) => Some(check.inst(\n        t,\n        check.pairs(\n          get(i.methods.params, name + \".\" + m) ?? [],\n          args,\n        ),\n      )),\n      None => match check.code_trait_method(i, name, m, rt_whole) {\n        Some(t) => Some(t),\n        // a method a trait it implements provides (`to_json` of a type deriving\n        // `Json`)\n        None => check.provided_method(i, name, m, rt_whole),\n      },\n    },\n    // `xs.iter()`: a list's method of core's code traits\n    check.TList(_) => check.code_trait_method(i, \"List\", m, check.res(i, rt)),\n    // `s.bytes()`, `s.graphemes()`: a string's methods of code traits\n    check.TStr => check.string_method(i, m),\n    // `x.m()` with `x: T` and `T: Tr`: the trait's method, `Self` being `T`\n    check.TGen(p) => check.bound_method(i, p, m),\n    // a trait value: the trait's method\n    check.TTrait(tr) => check.trait_method(i, tr, m, check.TTrait(tr), 8),\n    _ => None,\n  }\n  // a method of one of the program's types that changes its receiver\n  // (`mut self`) is called `mut recv.m(..)`, and only such a method is\n  // called so\n  match check.res(i, rt) {\n    check.TNamed { name, .. } => if check.program_type(i, name)\n      && contains(i.methods.self_methods, name + \".\" + m) {\n      changes := contains(i.methods.mut_self, name + \".\" + m)\n      shown := text.expr_text(recv, 0)\n      if changes && !marked {\n        check.error(mut i, \"`\"\n          + m\n          + \"` changes its receiver (`mut self`): write `mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)` to show that `\"\n          + shown\n          + \"` may change\")\n      } else if marked && !changes {\n        check.error(mut i, \"`mut \"\n          + shown\n          + \".\"\n          + m\n          + \"(…)`: `\"\n          + m\n          + \"` doesn't change its receiver (it doesn't take `mut self`)\")\n      }\n    },\n    _ => (),\n  }\n  // `.to_list()` of what the checker types as a list (a comprehension or a\n  // built-in over a string's code points) is the list\n  if m == \"to_list\"\n    && len(args) == 0\n    && check.res(i, rt) is check.TList {\n    return check.res(i, rt)\n  }\n  // `x.f(..)` with `f` a built-in function is `f(x, ..)`, on a list even\n  // when a trait has a method of that name (`xs.map(f)`)\n  if own is None\n    && check.known(check.res(i, rt))\n    && !contains(env, m)\n    && (!contains(i.methods.names, m)\n      || check.res(i, rt) is check.TList\n      || check.is_table(check.res(i, rt)))\n    && get(i.fns, m) is None {\n    match get(i.builtins, m) {\n      Some(bs) => {\n        check.changing_call(mut i, recv, m, bs, marked)\n        return check.builtin_call(mut i, m, bs, [rt], args, env)\n      },\n      None => (),\n    }\n  }\n  sig := match own {\n    Some(t) => Some(t),\n    // a receiver of a type not known may have a method of that name, such as\n    // one of std's types\n    None => if !check.known(check.res(i, rt))\n      || contains(env, m)\n      || contains(i.methods.names, m)\n      || contains(i.builtins, m) {\n      None\n    } else {\n      get(i.fns, m)\n    },\n  }\n  match sig {\n    Some(t) => {\n      vars := check.fresh_for(mut i, to_list(check.gens(t, Set[String] {})))\n      ft := check.inst(t, vars)\n      match ft {\n        check.TFn { params, ret } => {\n          what := \"call to `\" + m + \"`\"\n          if len(params) != len(args) + 1 {\n            check.error(mut i, what\n              + \": expects \"\n              + to_string(len(params))\n              + \" arguments, got \"\n              + to_string(len(args) + 1))\n            return ret\n          }\n          check.expect(\n            mut i,\n            get(params, 0) ?? check.TAny,\n            rt,\n            what + \", argument 1\",\n          )\n          mut ats := []\n          mut arg_types := [rt]\n          for (k, a) in enumerate(args) {\n            p := get(params, k + 1) ?? check.TAny\n            at := check.listed_arg(\n              mut i,\n              m,\n              k,\n              a,\n              p,\n              check.infer(mut i, a, env, Some(p)),\n              what,\n            )\n            mut arg_types.push(at)\n            check.expect(\n              mut i,\n              p,\n              at,\n              what + \", argument \" + to_string(k + 2),\n            )\n            mut ats.push(at)\n          }\n          // a type's own method with structural bounds: each one met by the\n          // type an argument gives its type parameter (`own` has the method's\n          // type parameters as `TAny`)\n          match (own, check.res(i, rt)) {\n            (Some(_), check.TNamed { name, .. }) => match (\n              get(i.methods.rows, name + \".\" + m),\n              get(i.methods.of, name + \".\" + m),\n            ) {\n              (Some(rs), Some(check.TFn { params: raw, .. })) => {\n                for (q, fs) in rs {\n                  mut met := false\n                  for (k, at) in enumerate(ats) {\n                    if !met {\n                      match check.given_for(\n                        i,\n                        get(raw, k + 1) ?? check.TAny,\n                        at,\n                        q,\n                      ) {\n                        Some(g) => {\n                          met = true\n                          check.row_met(\n                            mut i,\n                            name + \".\" + m,\n                            fs,\n                            vars,\n                            g,\n                          )\n                        },\n                        None => (),\n                      }\n                    }\n                  }\n                }\n              },\n              _ => (),\n            },\n            _ => (),\n          }\n          // a method's result, narrowed by what it (or its trait) says of it\n          key := check.method_facts_key(i, check.res(i, rt), m)\n          i.last_call = match check.narrowed_at(i, key, arg_types, ret) {\n            Some((_, _, left, u)) => (seq, key, to_list(left).sorted(), u),\n            None => (seq, key, [], false),\n          }\n          check.narrowed_result(i, key, arg_types, ret)\n        },\n        _ => check.TAny,\n      }\n    },\n    None => {\n      // a method no `impl`, trait or function has, on one of the program's\n      // types the checker sees every method of\n      match check.res(i, rt) {\n        check.TNamed { name, .. } => if check.program_type(i, name)\n          && !contains(i.methods.foreign, name)\n          && !contains(env, m)\n          && !contains(i.methods.names, m)\n          && get(i.fns, m) is None\n          && get(i.builtins, m) is None {\n          check.error(mut i, \"unknown function `\" + m + \"`\")\n        },\n        _ => (),\n      }\n      // `true.price()`: a method of one of the file's traits, on a value of a\n      // basic or program type, which must implement it\n      match check.res(i, rt) {\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TNamed { .. } => if !contains(env, m) {\n          match check.own_trait_of(i, m) {\n            Some(tr) => mut i.pending.push((rt, tr, m)),\n            None => (),\n          }\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}"},{"name":"check.methods_of","kind":"fn","old":"c9ab7524e1e4472a","new":"427e791e8690b872","interface_changed":false,"affected":[],"module":"check","text":"/// The program's methods: `impl`s without type parameters, on a type\n/// modelled without type parameters.\nfn methods_of(decls: List[ast.Decl], types: check.Types) -> check.Methods {\n  mut supers := Dict[String, List[String]] {}\n  mut pairs_seen := []\n  mut declared := Set[String] {}\n  mut of := Dict[String, check.Ty] {}\n  mut names := Set[String] {}\n  mut names_other := Set[String] {}\n  mut own_recv := Dict[String, Bool] {}\n  mut trait_recv := Dict[String, Bool] {}\n  mut mut_params := Dict[String, List[check.Ty]] {}\n  mut params := Dict[String, List[String]] {}\n  mut traits := Dict[String, check.Ty] {}\n  mut impls := Set[String] {}\n  mut checked := Set[String] {}\n  mut blanket := Set[String] {}\n  mut bounds := Dict[String, List[(String, String)]] {}\n  mut own_methods := Set[String] {}\n  mut impl_bounds := Dict[String, List[(Int, String)]] {}\n  mut trait_tparams := Dict[String, List[String]] {}\n  mut impl_args := Dict[String, (List[check.Ty], List[String])] {}\n  mut trait_params := Dict[String, List[String]] {}\n  mut spread_params := Dict[String, List[ast.Param]] {}\n  mut rows := Dict[String, Dict[String, List[(String, check.Ty, ast.TypeExpr)]]] {}\n  for d in decls {\n    match d.kind {\n      ast.ImplDef(im) => {\n        head := check.type_head(im.for_type)\n        // core's code's types, like `KeyPath`, are named bare everywhere: an\n        // `impl` of another module's on one is on that type\n        q := if contains(head, \".\")\n          || check.core_code_type(types, head)\n            && !contains(types.named, check.qualified(d.module, head)) {\n          head\n        } else {\n          check.qualified(d.module, head)\n        }\n        if im.trait_name != \"\" {\n          mut impls.insert(im.trait_name + \" for \" + q)\n          if im.trait_args != [] {\n            itps := set(im.type_params)\n            mut impl_args.insert(\n              im.trait_name + \" for \" + q,\n              (\n                im.trait_args.map(a -> check.lower(types, itps, a)),\n                match im.for_type {\n                  ast.Named { args: targs, .. } => targs.map(a -> check.type_head(a)),\n                  _ => [],\n                },\n              ),\n            )\n          }\n          // the bounds on the type's arguments, by their position\n          match im.for_type {\n            ast.Named { args: targs, .. } => {\n              mut bs := []\n              for (k, a) in enumerate(targs) {\n                for b in im.bounds {\n                  if check.type_head(a) == b.param {\n                    for tr in b.traits {\n                      mut bs.push((k, check.type_head(tr)))\n                    }\n                  }\n                }\n              }\n              if bs != [] {\n                mut impl_bounds.insert(im.trait_name + \" for \" + q, bs)\n              }\n            },\n            _ => (),\n          }\n          mut pairs_seen.push((im.trait_name, q))\n          // `impl[T] Tr for T`: every type\n          if im.type_params.contains(head) {\n            mut blanket.insert(im.trait_name)\n          }\n        }\n        // a generic `impl` on its type's own parameters, in order\n        own_params := match im.for_type {\n          ast.Named { args, .. } => args.map(a -> check.type_head(a)) == im.type_params,\n          _ => false,\n        }\n        usable := get(types.named, q) ?? [\"?\"] == im.type_params\n          && (len(im.type_params) == 0 || own_params)\n        for f in im.methods {\n          mut names.insert(f.name)\n          mut spread_params.insert(q + \".\" + f.name, f.params)\n          if im.trait_name == \"\" {\n            mut names_other.insert(f.name)\n            mut own_methods.insert(q + \".\" + f.name)\n          }\n          if usable {\n            g := check.method_of(f, im.for_type)\n            tps := set(im.type_params + g.type_params)\n            key := q + \".\" + f.name\n            mut of.insert(\n              key,\n              check.TFn {\n                params: g.params.map(p -> check.param_type(types, tps, p)),\n                ret: check.lower(types, tps, g.ret),\n              },\n            )\n            mut params.insert(key, im.type_params)\n            fr := check.rows_by_param(types, tps, g.bounds)\n            if len(fr) > 0 {\n              mut rows.insert(key, fr)\n            }\n            // whether it takes `mut self`; a type's own method comes before a trait's\n            // of the same name, as calls find them\n            match get(f.params, 0) {\n              Some(sp) => if sp.name == \"self\" {\n                if im.trait_name == \"\" {\n                  mut own_recv.insert(key, sp.mutable)\n                } else {\n                  mut trait_recv.insert(key, sp.mutable)\n                }\n              },\n              None => (),\n            }\n          }\n        }\n      },\n      ast.TraitDef(t) => {\n        mut declared.insert(t.name)\n        mut supers.insert(t.name, t.supers.map(x -> check.type_head(x)))\n        mut trait_tparams.insert(t.name, t.params)\n        if t.derivable is None && !t.capability && len(t.params) == 0 {\n          mut checked.insert(t.name)\n        }\n        for tm in t.methods {\n          mut names.insert(tm.decl.name)\n          tps := set([\"Self\"] + t.params + tm.decl.type_params)\n          mut trait_params.insert(\n            t.name + \".\" + tm.decl.name,\n            tm.decl.params.map(p -> p.name),\n          )\n          mut spread_params.insert(\n            t.name + \".\" + tm.decl.name,\n            tm.decl.params,\n          )\n          mut spread_params.insert(\n            check.qualified(d.module, t.name) + \".\" + tm.decl.name,\n            tm.decl.params,\n          )\n          mut traits.insert(\n            t.name + \".\" + tm.decl.name,\n            check.TFn {\n              params: tm.decl.params.map(\n                p -> check.param_type(types, tps, p),\n              ),\n              ret: check.lower(types, tps, tm.decl.ret),\n            },\n          )\n          tr := check.rows_by_param(types, tps, tm.decl.bounds)\n          if len(tr) > 0 {\n            mut rows.insert(t.name + \".\" + tm.decl.name, tr)\n          }\n        }\n      },\n      ast.FnDef(f) => {\n        mut spread_params.insert(\n          check.qualified(d.module, f.name),\n          f.params,\n        )\n        mut bs := []\n        for b in f.bounds {\n          for tr in b.traits {\n            if !(tr is ast.RowType) {\n              mut bs.push((b.param, check.type_head(tr)))\n            }\n          }\n        }\n        fr := check.rows_by_param(types, set(f.type_params), f.bounds)\n        if len(fr) > 0 {\n          mut rows.insert(check.qualified(d.module, f.name), fr)\n        }\n        mut bounds.insert(check.qualified(d.module, f.name), bs)\n        mut mut_params.insert(\n          check.qualified(d.module, f.name),\n          f.params.map(\n            p -> if p.mutable && len(f.type_params) == 0 {\n              check.lower(types, Set[String] {}, p.ty)\n            } else {\n              check.TAny\n            },\n          ),\n        )\n      },\n      ast.ExternDef(x) => match x.item {\n        ast.ExternFn(f) => mut spread_params.insert(\n          check.qualified(d.module, f.name),\n          f.params,\n        ),\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  mut foreign := Set[String] {}\n  for tq in pairs_seen {\n    if !contains(declared, tq.0) {\n      mut foreign.insert(tq.1)\n    }\n  }\n  mut self_methods := Set[String] {}\n  mut mut_self := Set[String] {}\n  for key in keys(trait_recv) + keys(own_recv) {\n    mut self_methods.insert(key)\n    if get(own_recv, key) ?? get(trait_recv, key) ?? false {\n      mut mut_self.insert(key)\n    }\n  }\n  mut kept := Set[String] {}\n  for c in checked {\n    if !contains(blanket, c) {\n      mut kept.insert(c)\n    }\n  }\n  check.Methods {\n    of,\n    names,\n    params,\n    traits,\n    impls,\n    checked: kept,\n    bounds,\n    foreign,\n    code_traits: Set[String] {},\n    supers,\n    local: Set[String] {},\n    own_traits: Set[String] {},\n    names_other,\n    self_methods,\n    mut_self,\n    mut_params,\n    own_methods,\n    trait_params,\n    impl_bounds,\n    trait_tparams,\n    impl_args,\n    spread_params,\n    rows,\n  }\n}","old_text":"/// The program's methods: `impl`s without type parameters, on a type\n/// modelled without type parameters.\nfn methods_of(decls: List[ast.Decl], types: check.Types) -> check.Methods {\n  mut supers := Dict[String, List[String]] {}\n  mut pairs_seen := []\n  mut declared := Set[String] {}\n  mut of := Dict[String, check.Ty] {}\n  mut names := Set[String] {}\n  mut names_other := Set[String] {}\n  mut own_recv := Dict[String, Bool] {}\n  mut trait_recv := Dict[String, Bool] {}\n  mut mut_params := Dict[String, List[check.Ty]] {}\n  mut params := Dict[String, List[String]] {}\n  mut traits := Dict[String, check.Ty] {}\n  mut impls := Set[String] {}\n  mut checked := Set[String] {}\n  mut blanket := Set[String] {}\n  mut bounds := Dict[String, List[(String, String)]] {}\n  mut own_methods := Set[String] {}\n  mut impl_bounds := Dict[String, List[(Int, String)]] {}\n  mut trait_tparams := Dict[String, List[String]] {}\n  mut impl_args := Dict[String, (List[check.Ty], List[String])] {}\n  mut trait_params := Dict[String, List[String]] {}\n  mut spread_params := Dict[String, List[ast.Param]] {}\n  mut rows := Dict[String, Dict[String, List[(String, check.Ty, ast.TypeExpr)]]] {}\n  for d in decls {\n    match d.kind {\n      ast.ImplDef(im) => {\n        head := check.type_head(im.for_type)\n        // core's code's types, like `KeyPath`, are named bare everywhere: an\n        // `impl` of another module's on one is on that type\n        q := if contains(head, \".\")\n          || check.core_code_type(types, head)\n            && !contains(types.named, check.qualified(d.module, head)) {\n          head\n        } else {\n          check.qualified(d.module, head)\n        }\n        if im.trait_name != \"\" {\n          mut impls.insert(im.trait_name + \" for \" + q)\n          if im.trait_args != [] {\n            itps := set(im.type_params)\n            mut impl_args.insert(\n              im.trait_name + \" for \" + q,\n              (\n                im.trait_args.map(a -> check.lower(types, itps, a)),\n                match im.for_type {\n                  ast.Named { args: targs, .. } => targs.map(a -> check.type_head(a)),\n                  _ => [],\n                },\n              ),\n            )\n          }\n          // the bounds on the type's arguments, by their position\n          match im.for_type {\n            ast.Named { args: targs, .. } => {\n              mut bs := []\n              for (k, a) in enumerate(targs) {\n                for b in im.bounds {\n                  if check.type_head(a) == b.param {\n                    for tr in b.traits {\n                      mut bs.push((k, check.type_head(tr)))\n                    }\n                  }\n                }\n              }\n              if bs != [] {\n                mut impl_bounds.insert(im.trait_name + \" for \" + q, bs)\n              }\n            },\n            _ => (),\n          }\n          mut pairs_seen.push((im.trait_name, q))\n          // `impl[T] Tr for T`: every type\n          if im.type_params.contains(head) {\n            mut blanket.insert(im.trait_name)\n          }\n        }\n        // a generic `impl` on its type's own parameters, in order\n        own_params := match im.for_type {\n          ast.Named { args, .. } => args.map(a -> check.type_head(a)) == im.type_params,\n          _ => false,\n        }\n        usable := get(types.named, q) ?? [\"?\"] == im.type_params\n          && (len(im.type_params) == 0 || own_params)\n        for f in im.methods {\n          mut names.insert(f.name)\n          mut spread_params.insert(q + \".\" + f.name, f.params)\n          if im.trait_name == \"\" {\n            mut names_other.insert(f.name)\n            mut own_methods.insert(q + \".\" + f.name)\n          }\n          if usable {\n            g := check.method_of(f, im.for_type)\n            tps := set(im.type_params + g.type_params)\n            key := q + \".\" + f.name\n            mut of.insert(\n              key,\n              check.TFn {\n                params: g.params.map(p -> check.param_type(types, tps, p)),\n                ret: check.lower(types, tps, g.ret),\n              },\n            )\n            mut params.insert(key, im.type_params)\n            fr := check.rows_by_param(types, tps, g.bounds)\n            if len(fr) > 0 {\n              mut rows.insert(key, fr)\n            }\n            // whether it takes `mut self`; a type's own method comes before a trait's\n            // of the same name, as calls find them\n            match get(f.params, 0) {\n              Some(sp) => if sp.name == \"self\" {\n                if im.trait_name == \"\" {\n                  mut own_recv.insert(key, sp.mutable)\n                } else {\n                  mut trait_recv.insert(key, sp.mutable)\n                }\n              },\n              None => (),\n            }\n          }\n        }\n      },\n      ast.TraitDef(t) => {\n        mut declared.insert(t.name)\n        mut supers.insert(t.name, t.supers.map(x -> check.type_head(x)))\n        mut trait_tparams.insert(t.name, t.params)\n        if t.derivable is None && !t.capability && len(t.params) == 0 {\n          mut checked.insert(t.name)\n        }\n        for tm in t.methods {\n          mut names.insert(tm.decl.name)\n          tps := set([\"Self\"] + t.params + tm.decl.type_params)\n          mut trait_params.insert(\n            t.name + \".\" + tm.decl.name,\n            tm.decl.params.map(p -> p.name),\n          )\n          mut spread_params.insert(\n            t.name + \".\" + tm.decl.name,\n            tm.decl.params,\n          )\n          mut spread_params.insert(\n            check.qualified(d.module, t.name) + \".\" + tm.decl.name,\n            tm.decl.params,\n          )\n          mut traits.insert(\n            t.name + \".\" + tm.decl.name,\n            check.TFn {\n              params: tm.decl.params.map(\n                p -> check.param_type(types, tps, p),\n              ),\n              ret: check.lower(types, tps, tm.decl.ret),\n            },\n          )\n        }\n      },\n      ast.FnDef(f) => {\n        mut spread_params.insert(\n          check.qualified(d.module, f.name),\n          f.params,\n        )\n        mut bs := []\n        for b in f.bounds {\n          for tr in b.traits {\n            if !(tr is ast.RowType) {\n              mut bs.push((b.param, check.type_head(tr)))\n            }\n          }\n        }\n        fr := check.rows_by_param(types, set(f.type_params), f.bounds)\n        if len(fr) > 0 {\n          mut rows.insert(check.qualified(d.module, f.name), fr)\n        }\n        mut bounds.insert(check.qualified(d.module, f.name), bs)\n        mut mut_params.insert(\n          check.qualified(d.module, f.name),\n          f.params.map(\n            p -> if p.mutable && len(f.type_params) == 0 {\n              check.lower(types, Set[String] {}, p.ty)\n            } else {\n              check.TAny\n            },\n          ),\n        )\n      },\n      ast.ExternDef(x) => match x.item {\n        ast.ExternFn(f) => mut spread_params.insert(\n          check.qualified(d.module, f.name),\n          f.params,\n        ),\n        _ => (),\n      },\n      _ => (),\n    }\n  }\n  mut foreign := Set[String] {}\n  for tq in pairs_seen {\n    if !contains(declared, tq.0) {\n      mut foreign.insert(tq.1)\n    }\n  }\n  mut self_methods := Set[String] {}\n  mut mut_self := Set[String] {}\n  for key in keys(trait_recv) + keys(own_recv) {\n    mut self_methods.insert(key)\n    if get(own_recv, key) ?? get(trait_recv, key) ?? false {\n      mut mut_self.insert(key)\n    }\n  }\n  mut kept := Set[String] {}\n  for c in checked {\n    if !contains(blanket, c) {\n      mut kept.insert(c)\n    }\n  }\n  check.Methods {\n    of,\n    names,\n    params,\n    traits,\n    impls,\n    checked: kept,\n    bounds,\n    foreign,\n    code_traits: Set[String] {},\n    supers,\n    local: Set[String] {},\n    own_traits: Set[String] {},\n    names_other,\n    self_methods,\n    mut_self,\n    mut_params,\n    own_methods,\n    trait_params,\n    impl_bounds,\n    trait_tparams,\n    impl_args,\n    spread_params,\n    rows,\n  }\n}"},{"name":"check.method_rows_at","kind":"fn","old":null,"new":"e32adc017c0222f2","interface_changed":true,"affected":[],"module":"check","text":"/// The structural bounds of method `m` called on a value of type `rt`, if\n/// it has some: its key (`Shop.line`, `Liner.line`), the bounds, its\n/// parameters' types as declared, and what a generic `impl`'s type\n/// parameters are for this receiver.\nfn method_rows_at(\n  i: check.Inf,\n  found: Bool,\n  rt: check.Ty,\n  m: String,\n) -> Option[(String, Dict[String, List[(String, check.Ty, ast.TypeExpr)]], List[check.Ty], Dict[String, check.Ty])] {\n  if !found {\n    return None\n  }\n  (key, sub) := match check.widened(rt) {\n    check.TNamed { name, args } => (\n      name + \".\" + m,\n      check.pairs(get(i.methods.params, name + \".\" + m) ?? [], args),\n    ),\n    check.TTrait(tr) => (tr + \".\" + m, Dict[String, check.Ty] {}),\n    check.TGen(p) => match (get(i.tbounds, p) ?? []).filter(\n      tr -> contains(i.methods.rows, tr + \".\" + m),\n    ) {\n      [tr, ..] => (tr + \".\" + m, Dict[String, check.Ty] {}),\n      _ => return None,\n    },\n    _ => return None,\n  }\n  raw := match get(i.methods.of, key) {\n    Some(check.TFn { params, .. }) => params,\n    _ => match get(i.methods.traits, key) {\n      Some(check.TFn { params, .. }) => params,\n      _ => [],\n    },\n  }\n  match get(i.methods.rows, key) {\n    Some(rs) => Some((key, rs, raw, sub)),\n    None => None,\n  }\n}"}]}
{"id":"fe551096b0738739","time":1795734854,"message":"edit","changes":[{"name":"desugar.anon_types","kind":"fn","old":"53d382ad02243c6e","new":"c963b00f4ccfcf72","interface_changed":false,"affected":[],"module":"desugar","text":"/// The record types the anonymous records and their types name\n/// (`$rec:id:total`) and neither `ds` nor `context` declares: one per set\n/// of field names, generic in each field's type, its fields in order of\n/// name, in the root module. `{ id: 1, total: 0 }` is a\n/// `$rec:id:total[Int, Int]`.\nfn anon_types(ds: List[ast.Decl], context: List[ast.Decl]) -> List[ast.Decl] {\n  mut have := Set[String] {}\n  for d in ds + context {\n    match d.kind {\n      ast.TypeDef(t) => if starts_with(t.name, \"$rec:\") {\n        mut have.insert(t.name)\n      },\n      _ => (),\n    }\n  }\n  mut want := Set[String] {}\n  for d in ds {\n    for t in walk.decl_types(d) {\n      match t {\n        ast.Named { name, .. } => if starts_with(name, \"$rec:\") {\n          mut want.insert(name)\n        },\n        _ => (),\n      }\n    }\n    for e in walk.decl_exprs(d) {\n      match e {\n        ast.CtorExpr { name, .. } => if starts_with(name, \"$rec:\") {\n          mut want.insert(name)\n        },\n        _ => (),\n      }\n    }\n  }\n  // a trait derived for a type holding anonymous records (`derive Json for\n  // Report`, `Report`'s `best: { id: Int, total: Int }`) is derived for\n  // them too, each type parameter bound by it (`derive Json for\n  // $rec:id:total`)\n  mut derives := Dict[String, Set[String]] {}\n  for d in ds + context {\n    match d.kind {\n      ast.ImplDef(im) => if im.derived\n        && !starts_with(text.type_text(im.for_type), \"$rec:\") {\n        for d2 in ds + context {\n          match d2.kind {\n            ast.TypeDef(t) => if t.name == text.type_text(im.for_type)\n              || d2.module + \".\" + t.name == text.type_text(im.for_type) {\n              for x in walk.decl_types(d2) {\n                match x {\n                  ast.Named { name, .. } => if starts_with(name, \"$rec:\") {\n                    mut ts := get(derives, name) ?? Set[String] {}\n                    mut ts.insert(im.trait_name)\n                    mut derives.insert(name, ts)\n                  },\n                  _ => (),\n                }\n              }\n            },\n            _ => (),\n          }\n        }\n      },\n      ast.TypeDef(t) => if starts_with(t.name, \"$rec:\") {\n        ()\n      },\n      _ => (),\n    }\n  }\n  mut done := Set[String] {}\n  for d in ds + context {\n    match d.kind {\n      ast.ImplDef(im) => if im.derived\n        && starts_with(text.type_text(im.for_type), \"$rec:\") {\n        mut done.insert(\n          text.type_text(im.for_type) + \" \" + im.trait_name,\n        )\n      },\n      _ => (),\n    }\n  }\n  mut out := []\n  for (n, trs) in items(derives) {\n    for tr in trs {\n      if !contains(done, n + \" \" + tr) {\n        mut out.push(\n          ast.Decl {\n            comments: [],\n            doc: [],\n            module: \"\",\n            public: true,\n            kind: ast.ImplDef(ast.ImplDecl {\n              type_params: [],\n              bounds: [],\n              trait_name: tr,\n              trait_args: [],\n              for_type: ast.Named { name: n, args: [] },\n              methods: [],\n              derived: true,\n            }),\n          },\n        )\n      }\n    }\n  }\n  for n in to_list(want).sorted() {\n    if !contains(have, n) {\n      fs := drop(split(n, \":\"), 1)\n      mut out.push(\n        ast.Decl {\n          comments: [],\n          doc: [],\n          module: \"\",\n          public: true,\n          kind: ast.TypeDef(ast.TypeDecl {\n            distinct: false,\n            name: n,\n            params: fs.map(f -> \"$\" + f),\n            body: ast.RecordBody(fs.map(\n              f -> ast.Field {\n                comments: [],\n                doc: [],\n                name: f,\n                ty: ast.Named { name: \"$\" + f, args: [] },\n                default: None,\n              },\n            )),\n            refinement: None,\n            mocked: false,\n          }),\n        },\n      )\n    }\n  }\n  out\n}","old_text":"/// The record types the anonymous records and their types name\n/// (`$rec:id:total`) and neither `ds` nor `context` declares: one per set\n/// of field names, generic in each field's type, its fields in order of\n/// name, in the root module. `{ id: 1, total: 0 }` is a\n/// `$rec:id:total[Int, Int]`.\nfn anon_types(ds: List[ast.Decl], context: List[ast.Decl]) -> List[ast.Decl] {\n  mut have := Set[String] {}\n  for d in ds + context {\n    match d.kind {\n      ast.TypeDef(t) => if starts_with(t.name, \"$rec:\") {\n        mut have.insert(t.name)\n      },\n      _ => (),\n    }\n  }\n  mut want := Set[String] {}\n  for d in ds {\n    for t in walk.decl_types(d) {\n      match t {\n        ast.Named { name, .. } => if starts_with(name, \"$rec:\") {\n          mut want.insert(name)\n        },\n        _ => (),\n      }\n    }\n    for e in walk.decl_exprs(d) {\n      match e {\n        ast.CtorExpr { name, .. } => if starts_with(name, \"$rec:\") {\n          mut want.insert(name)\n        },\n        _ => (),\n      }\n    }\n  }\n  mut out := []\n  for n in to_list(want).sorted() {\n    if !contains(have, n) {\n      fs := drop(split(n, \":\"), 1)\n      mut out.push(\n        ast.Decl {\n          comments: [],\n          doc: [],\n          module: \"\",\n          public: true,\n          kind: ast.TypeDef(ast.TypeDecl {\n            distinct: false,\n            name: n,\n            params: fs.map(f -> \"$\" + f),\n            body: ast.RecordBody(fs.map(\n              f -> ast.Field {\n                comments: [],\n                doc: [],\n                name: f,\n                ty: ast.Named { name: \"$\" + f, args: [] },\n                default: None,\n              },\n            )),\n            refinement: None,\n            mocked: false,\n          }),\n        },\n      )\n    }\n  }\n  out\n}"}]}
{"id":"cbc42df2204f9ccb","time":1795734911,"message":"edit","changes":[{"name":"desugar.anon_types","kind":"fn","old":"c963b00f4ccfcf72","new":"21ea7dcc632fe4b9","interface_changed":false,"affected":[],"module":"desugar","text":"/// The record types the anonymous records and their types name\n/// (`$rec:id:total`) and neither `ds` nor `context` declares: one per set\n/// of field names, generic in each field's type, its fields in order of\n/// name, in the root module. `{ id: 1, total: 0 }` is a\n/// `$rec:id:total[Int, Int]`.\nfn anon_types(ds: List[ast.Decl], context: List[ast.Decl]) -> List[ast.Decl] {\n  mut have := Set[String] {}\n  for d in ds + context {\n    match d.kind {\n      ast.TypeDef(t) => if starts_with(t.name, \"$rec:\") {\n        mut have.insert(t.name)\n      },\n      _ => (),\n    }\n  }\n  mut want := Set[String] {}\n  for d in ds {\n    for t in walk.decl_types(d) {\n      match t {\n        ast.Named { name, .. } => if starts_with(name, \"$rec:\") {\n          mut want.insert(name)\n        },\n        _ => (),\n      }\n    }\n    for e in walk.decl_exprs(d) {\n      match e {\n        ast.CtorExpr { name, .. } => if starts_with(name, \"$rec:\") {\n          mut want.insert(name)\n        },\n        _ => (),\n      }\n    }\n  }\n  // a trait derived for a type holding anonymous records (`derive Json for\n  // Report`, `Report`'s `best: { id: Int, total: Int }`) is derived for\n  // them too, each type parameter bound by it (`derive Json for\n  // $rec:id:total`)\n  mut derives := Dict[String, Set[String]] {}\n  for d in ds + context {\n    match d.kind {\n      ast.ImplDef(im) => if im.derived\n        && !starts_with(desugar.head_name(im.for_type), \"$rec:\") {\n        for d2 in ds + context {\n          match d2.kind {\n            ast.TypeDef(t) => if t.name == desugar.head_name(im.for_type)\n              || d2.module + \".\" + t.name == desugar.head_name(im.for_type) {\n              for x in walk.decl_types(d2) {\n                match x {\n                  ast.Named { name, .. } => if starts_with(name, \"$rec:\") {\n                    mut ts := get(derives, name) ?? Set[String] {}\n                    mut ts.insert(im.trait_name)\n                    mut derives.insert(name, ts)\n                  },\n                  _ => (),\n                }\n              }\n            },\n            _ => (),\n          }\n        }\n      },\n      _ => (),\n    }\n  }\n  mut done := Set[String] {}\n  for d in ds + context {\n    match d.kind {\n      ast.ImplDef(im) => if im.derived\n        && starts_with(desugar.head_name(im.for_type), \"$rec:\") {\n        mut done.insert(\n          desugar.head_name(im.for_type) + \" \" + im.trait_name,\n        )\n      },\n      _ => (),\n    }\n  }\n  mut out := []\n  for (n, trs) in items(derives) {\n    for tr in trs {\n      if !contains(done, n + \" \" + tr) {\n        mut out.push(\n          ast.Decl {\n            comments: [],\n            doc: [],\n            module: \"\",\n            public: true,\n            kind: ast.ImplDef(ast.ImplDecl {\n              type_params: [],\n              bounds: [],\n              trait_name: tr,\n              trait_args: [],\n              for_type: ast.Named { name: n, args: [] },\n              methods: [],\n              derived: true,\n            }),\n          },\n        )\n      }\n    }\n  }\n  for n in to_list(want).sorted() {\n    if !contains(have, n) {\n      fs := drop(split(n, \":\"), 1)\n      mut out.push(\n        ast.Decl {\n          comments: [],\n          doc: [],\n          module: \"\",\n          public: true,\n          kind: ast.TypeDef(ast.TypeDecl {\n            distinct: false,\n            name: n,\n            params: fs.map(f -> \"$\" + f),\n            body: ast.RecordBody(fs.map(\n              f -> ast.Field {\n                comments: [],\n                doc: [],\n                name: f,\n                ty: ast.Named { name: \"$\" + f, args: [] },\n                default: None,\n              },\n            )),\n            refinement: None,\n            mocked: false,\n          }),\n        },\n      )\n    }\n  }\n  out\n}","old_text":"/// The record types the anonymous records and their types name\n/// (`$rec:id:total`) and neither `ds` nor `context` declares: one per set\n/// of field names, generic in each field's type, its fields in order of\n/// name, in the root module. `{ id: 1, total: 0 }` is a\n/// `$rec:id:total[Int, Int]`.\nfn anon_types(ds: List[ast.Decl], context: List[ast.Decl]) -> List[ast.Decl] {\n  mut have := Set[String] {}\n  for d in ds + context {\n    match d.kind {\n      ast.TypeDef(t) => if starts_with(t.name, \"$rec:\") {\n        mut have.insert(t.name)\n      },\n      _ => (),\n    }\n  }\n  mut want := Set[String] {}\n  for d in ds {\n    for t in walk.decl_types(d) {\n      match t {\n        ast.Named { name, .. } => if starts_with(name, \"$rec:\") {\n          mut want.insert(name)\n        },\n        _ => (),\n      }\n    }\n    for e in walk.decl_exprs(d) {\n      match e {\n        ast.CtorExpr { name, .. } => if starts_with(name, \"$rec:\") {\n          mut want.insert(name)\n        },\n        _ => (),\n      }\n    }\n  }\n  // a trait derived for a type holding anonymous records (`derive Json for\n  // Report`, `Report`'s `best: { id: Int, total: Int }`) is derived for\n  // them too, each type parameter bound by it (`derive Json for\n  // $rec:id:total`)\n  mut derives := Dict[String, Set[String]] {}\n  for d in ds + context {\n    match d.kind {\n      ast.ImplDef(im) => if im.derived\n        && !starts_with(text.type_text(im.for_type), \"$rec:\") {\n        for d2 in ds + context {\n          match d2.kind {\n            ast.TypeDef(t) => if t.name == text.type_text(im.for_type)\n              || d2.module + \".\" + t.name == text.type_text(im.for_type) {\n              for x in walk.decl_types(d2) {\n                match x {\n                  ast.Named { name, .. } => if starts_with(name, \"$rec:\") {\n                    mut ts := get(derives, name) ?? Set[String] {}\n                    mut ts.insert(im.trait_name)\n                    mut derives.insert(name, ts)\n                  },\n                  _ => (),\n                }\n              }\n            },\n            _ => (),\n          }\n        }\n      },\n      ast.TypeDef(t) => if starts_with(t.name, \"$rec:\") {\n        ()\n      },\n      _ => (),\n    }\n  }\n  mut done := Set[String] {}\n  for d in ds + context {\n    match d.kind {\n      ast.ImplDef(im) => if im.derived\n        && starts_with(text.type_text(im.for_type), \"$rec:\") {\n        mut done.insert(\n          text.type_text(im.for_type) + \" \" + im.trait_name,\n        )\n      },\n      _ => (),\n    }\n  }\n  mut out := []\n  for (n, trs) in items(derives) {\n    for tr in trs {\n      if !contains(done, n + \" \" + tr) {\n        mut out.push(\n          ast.Decl {\n            comments: [],\n            doc: [],\n            module: \"\",\n            public: true,\n            kind: ast.ImplDef(ast.ImplDecl {\n              type_params: [],\n              bounds: [],\n              trait_name: tr,\n              trait_args: [],\n              for_type: ast.Named { name: n, args: [] },\n              methods: [],\n              derived: true,\n            }),\n          },\n        )\n      }\n    }\n  }\n  for n in to_list(want).sorted() {\n    if !contains(have, n) {\n      fs := drop(split(n, \":\"), 1)\n      mut out.push(\n        ast.Decl {\n          comments: [],\n          doc: [],\n          module: \"\",\n          public: true,\n          kind: ast.TypeDef(ast.TypeDecl {\n            distinct: false,\n            name: n,\n            params: fs.map(f -> \"$\" + f),\n            body: ast.RecordBody(fs.map(\n              f -> ast.Field {\n                comments: [],\n                doc: [],\n                name: f,\n                ty: ast.Named { name: \"$\" + f, args: [] },\n                default: None,\n              },\n            )),\n            refinement: None,\n            mocked: false,\n          }),\n        },\n      )\n    }\n  }\n  out\n}"},{"name":"desugar.head_name","kind":"fn","old":null,"new":"ee48fd96d43a596f","interface_changed":true,"affected":[],"module":"desugar","text":"/// The name of a type written as one (`Report`, `Box[T]`), else \"\".\nfn head_name(t: ast.TypeExpr) -> String {\n  match t {\n    ast.Named { name, .. } => name,\n    _ => \"\",\n  }\n}"}]}
{"id":"72e81f7e58b06f36","time":1795739012,"message":"codegen: a variable a closure or a task captures escapes (no block on the stack)","changes":[{"name":"codegen.escapes","kind":"fn","old":"c7411e3958de5373","new":"bfc3aeea53b2134f","interface_changed":false,"affected":[],"module":"codegen","text":"/// Whether variable `x` may escape `e`. A closure or a task mentioning\n/// `x` counts as escaping.\nfn escapes(e: ast.Expr, x: String, kept: Dict[String, List[Bool]]) -> Bool {\n  match e {\n    ast.Var(v) => v == x,\n    // captured by a closure or a task: the capture may outlive the frame,\n    // or cross to another thread, which passes a count of 0 (a block on\n    // the stack) as it is, without crossing what the block holds\n    ast.Lambda { body, .. } => codegen.mentions_var(body, x),\n    ast.Spawn(b) | ast.SupervisedSpawn(b) => codegen.mentions_var(b, x),\n    // reads\n    ast.FieldOf { base: ast.Var(_), .. } => false,\n    ast.IsExpr { value: ast.Var(_), .. } => false,\n    ast.Binary { op, left, right } => if op == ast.And || op == ast.Or || op == ast.Implies {\n      codegen.escapes(left, x, kept)\n        || codegen.escapes(right, x, kept)\n    } else {\n      left != ast.Var(x) && codegen.escapes(left, x, kept)\n        || right != ast.Var(x) && codegen.escapes(right, x, kept)\n    },\n    // an argument of a function that borrows it\n    ast.Call { callee: ast.Var(name), args } => {\n      for (i, a) in enumerate(args) {\n        if !(a == ast.Var(x) && !codegen.keeps_arg(kept, name, i))\n          && codegen.escapes(a, x, kept) {\n          return true\n        }\n      }\n      false\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => if scrutinee == ast.Var(x) {\n      binding is Some\n        || arms.any(a -> codegen.binds_whole(a.pat))\n        || arms.any(\n          a -> walk.pattern_kids(a.pat).any(\n              p -> codegen.escapes(p, x, kept),\n            )\n            || codegen.escapes(a.body, x, kept),\n        )\n    } else {\n      walk.kids(e).any(k -> codegen.escapes(k, x, kept))\n    },\n    _ => walk.kids(e).any(k -> codegen.escapes(k, x, kept)),\n  }\n}","old_text":"/// Whether variable `x` may escape `e`.\nfn escapes(e: ast.Expr, x: String, kept: Dict[String, List[Bool]]) -> Bool {\n  match e {\n    ast.Var(v) => v == x,\n    // reads\n    ast.FieldOf { base: ast.Var(_), .. } => false,\n    ast.IsExpr { value: ast.Var(_), .. } => false,\n    ast.Binary { op, left, right } => if op == ast.And || op == ast.Or || op == ast.Implies {\n      codegen.escapes(left, x, kept)\n        || codegen.escapes(right, x, kept)\n    } else {\n      left != ast.Var(x) && codegen.escapes(left, x, kept)\n        || right != ast.Var(x) && codegen.escapes(right, x, kept)\n    },\n    // an argument of a function that borrows it\n    ast.Call { callee: ast.Var(name), args } => {\n      for (i, a) in enumerate(args) {\n        if !(a == ast.Var(x) && !codegen.keeps_arg(kept, name, i))\n          && codegen.escapes(a, x, kept) {\n          return true\n        }\n      }\n      false\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => if scrutinee == ast.Var(x) {\n      binding is Some\n        || arms.any(a -> codegen.binds_whole(a.pat))\n        || arms.any(\n          a -> walk.pattern_kids(a.pat).any(\n              p -> codegen.escapes(p, x, kept),\n            )\n            || codegen.escapes(a.body, x, kept),\n        )\n    } else {\n      walk.kids(e).any(k -> codegen.escapes(k, x, kept))\n    },\n    _ => walk.kids(e).any(k -> codegen.escapes(k, x, kept)),\n  }\n}"}]}
{"id":"b918f4ab002b21d6","time":1795821242,"message":"edit","changes":[{"name":"check.mark_method_calls","kind":"fn","old":null,"new":"3e4b1770584c8320","interface_changed":true,"affected":[],"module":"check","text":"/// Each call of `method` (`x.method(..)`) in `own`, tagged with what the\n/// checker resolves it to: `method#Tr` for the method of trait `trait_q`\n/// (through an `impl` of it, a bound, a trait value or `Self` in the\n/// trait), `method#` for any other method of that name. For `rename`. A\n/// call whose receiver isn't known stays as it is.\npub fn mark_method_calls(\n  own: List[ast.Decl],\n  lib: List[ast.Decl],\n  core: builtins.Core,\n  method: String,\n  trait_q: String,\n) -> List[ast.Decl] {\n  all := own + lib\n  types := check.types_of(all)\n  fns := check.fn_types(all, types)\n  methods := check.methods_of(all, types)\n  builtins := check.builtins_of(types, core)\n  tags := check.Tags { fns: Set[String] {}, methods: Set { method } }\n  marked := (f: ast.FnDecl, tps: Set[String]) -> {\n    g := ast.FnDecl { ..f, body: check.tag(tags, f.body, \"0\") }\n    i := check.fn_inferred(g, tps, types, fns, methods, builtins)\n    check.resolved_calls(i, g.body, trait_q)\n  }\n  self_t := ast.Named { name: \"Self\", args: [] }\n  in_trait := (d: ast.Decl, t: ast.TraitDecl, f: ast.FnDecl) -> {\n    g := ast.FnDecl {\n      ..check.method_of(f, self_t),\n      bounds: [ast.Bound { param: \"Self\", traits: [ast.Named {\n          name: check.qualified(d.module, t.name),\n          args: [],\n        }] }]\n        + f.bounds,\n    }\n    ast.FnDecl {\n      ..f,\n      body: marked(g, set([\"Self\"] + t.params + f.type_params)),\n    }\n  }\n  own.map(\n    d -> match d.kind {\n      ast.FnDef(f) => ast.Decl { ..d, kind: ast.FnDef(\n        ast.FnDecl { ..f, body: marked(f, set(f.type_params)) },\n      ) },\n      ast.ImplDef(im) => ast.Decl {\n        ..d,\n        kind: ast.ImplDef(ast.ImplDecl { ..im, methods: im.methods.map(\n          m -> {\n            g := ast.FnDecl {\n              ..check.method_of(m, im.for_type),\n              bounds: im.bounds + m.bounds,\n            }\n            ast.FnDecl {\n              ..m,\n              body: marked(g, set(im.type_params + g.type_params)),\n            }\n          },\n        ) }),\n      },\n      ast.TraitDef(t) => ast.Decl {\n        ..d,\n        kind: ast.TraitDef(ast.TraitDecl { ..t, methods: t.methods.map(\n          tm -> if tm.default {\n            ast.TraitMethod { ..tm, decl: in_trait(d, t, tm.decl) }\n          } else {\n            tm\n          },\n        ), laws: t.laws.map(\n          l -> ast.Law { ..l, body: in_trait(d, t, ast.FnDecl {\n            doc: [],\n            comments: [],\n            name: l.name,\n            type_params: [],\n            bounds: [],\n            params: l.params,\n            ret: ast.Named { name: \"Bool\", args: [] },\n            pre: [],\n            post: [],\n            terminating: false,\n            body: l.body,\n            compile_time: false,\n            derived: false,\n          }).body },\n        ) }),\n      },\n      ast.TestDef(t) => {\n        g := ast.FnDecl {\n          doc: [],\n          comments: [],\n          name: \"test\",\n          type_params: [],\n          bounds: [],\n          params: t.params,\n          ret: ast.Named { name: \"$outside\", args: [] },\n          pre: [],\n          post: [],\n          terminating: false,\n          body: t.body,\n          compile_time: false,\n          derived: false,\n        }\n        ast.Decl { ..d, kind: ast.TestDef(\n          ast.TestDecl { ..t, body: marked(g, Set[String] {}) },\n        ) }\n      },\n      _ => d,\n    },\n  )\n}"},{"name":"check.resolved_calls","kind":"fn","old":null,"new":"c5ae96026ff60a3a","interface_changed":true,"affected":[],"module":"check","text":"/// `e` with each tagged call's tag replaced by `trait_q` when its receiver's\n/// type resolves the call to that trait's method, by nothing when it\n/// resolves it to another, and taken off when its type isn't known.\nfn resolved_calls(i: check.Inf, e: ast.Expr, trait_q: String) -> ast.Expr {\n  inner := walk.expr_children(\n    e,\n    c -> check.resolved_calls(i, c, trait_q),\n    t -> t,\n  )\n  match inner {\n    ast.MethodCall { recv, name, args } => match check.untag(name) {\n      Some((m, k)) => {\n        rt := match get(i.insts, k + \":recv\") {\n          Some(t) => check.res(i, t),\n          None => check.TAny,\n        }\n        tagged := if rt is check.TAny || rt is check.TVar {\n          m\n        } else if check.call_trait(i, rt, m) == Some(trait_q) {\n          m + \"#\" + trait_q\n        } else {\n          m + \"#\"\n        }\n        ast.MethodCall { recv, name: tagged, args }\n      },\n      None => inner,\n    },\n    _ => inner,\n  }\n}"},{"name":"check.call_trait","kind":"fn","old":null,"new":"f063da5fe3901594","interface_changed":true,"affected":[],"module":"check","text":"/// The trait whose method `m` a call `x.m(..)` with `x` of type `t` calls,\n/// if a trait's: a type's own method comes first.\nfn call_trait(i: check.Inf, t: check.Ty, m: String) -> Option[String] {\n  match check.widened(t) {\n    check.TNamed { name, .. } => if contains(i.methods.own_methods, name + \".\" + m) {\n      None\n    } else {\n      check.trait_with_method(i, name, m)\n    },\n    check.TGen(p) => {\n      for tr in get(i.tbounds, p) ?? [] {\n        match check.declaring_trait(i, tr, m, 8) {\n          Some(x) => return Some(x),\n          None => (),\n        }\n      }\n      None\n    },\n    check.TTrait(tr) => check.declaring_trait(i, tr, m, 8),\n    _ => None,\n  }\n}"},{"name":"check.declaring_trait","kind":"fn","old":null,"new":"5e65444d49054ac4","interface_changed":true,"affected":[],"module":"check","text":"/// `tr0` or the supertrait of it that declares `m`, as the method table\n/// names it.\nfn declaring_trait(\n  i: check.Inf,\n  tr0: String,\n  m: String,\n  fuel: Int,\n) -> Option[String] {\n  if fuel <= 0 {\n    return None\n  }\n  tr := if !contains(i.methods.traits, tr0 + \".\" + m)\n    && contains(i.methods.traits, check.last_part(tr0) + \".\" + m) {\n    check.last_part(tr0)\n  } else {\n    tr0\n  }\n  if contains(i.methods.traits, tr + \".\" + m) {\n    return Some(tr)\n  }\n  for sup in get(i.methods.supers, tr) ?? [] {\n    match check.declaring_trait(i, sup, m, fuel - 1) {\n      Some(x) => return Some(x),\n      None => (),\n    }\n  }\n  None\n}"}]}
{"id":"fc21646d8e28a246","time":1795821250,"message":"edit","changes":[{"name":"refactor.rename_all","kind":"fn","old":"0b97edbe16f94f9b","new":"dd84747db88b1463","interface_changed":false,"affected":[],"module":"refactor","text":"/// Applied one after the other. Each `old` is qualified.\npub fn rename_all(\n  ds: List[ast.Decl],\n  pairs: List[(String, String)],\n) -> Result[List[ast.Decl], String] {\n  // a field read from a union of records (`field#A,B`, tagged by\n  // `mark_field_reads`): every record's field gets the same new name\n  new_of := (q: String) -> pairs.find(p -> p.0 == q)\n  for d in ds {\n    for (f, owners) in refactor.field_reads(d) {\n      renamed := owners.filter(o -> new_of(o + \".\" + f) is Some)\n      if renamed != [] && len(owners) > 1 {\n        match owners.find(o -> new_of(o + \".\" + f) is None) {\n          Some(other) => return Err(\n            f\"in `{store.qname(d)}`, `.{f}` is read from a union that also has `{refactor.short(other)}.{f}` (rename it too, in the same command)\",\n          ),\n          None => (),\n        }\n        if len(\n          set(renamed.map(o -> (new_of(o + \".\" + f) ?? (\"\", \"\")).1)),\n        ) > 1 {\n          return Err(\n            f\"`.{f}` is read from a union whose records would get different names\",\n          )\n        }\n      }\n    }\n  }\n  mut out := ds\n  for (old, new) in pairs {\n    out = refactor.rename_one(out, old, new)!\n  }\n  // (the tags off)\n  Ok(\n    out.map(\n      d ->\n        walk.rewrite_decl(\n          d,\n          e ->\n            match e {\n              ast.FieldOf { base, name } => ast.FieldOf { base, name: refactor.untagged(name) },\n              ast.MethodCall { recv, name, args } => ast.MethodCall {\n                recv,\n                name: refactor.untagged(name),\n                args,\n              },\n              _ => e,\n            },\n        ),\n    ),\n  )\n}","old_text":"/// Applied one after the other. Each `old` is qualified.\npub fn rename_all(\n  ds: List[ast.Decl],\n  pairs: List[(String, String)],\n) -> Result[List[ast.Decl], String] {\n  // a field read from a union of records (`field#A,B`, tagged by\n  // `mark_field_reads`): every record's field gets the same new name\n  new_of := (q: String) -> pairs.find(p -> p.0 == q)\n  for d in ds {\n    for (f, owners) in refactor.field_reads(d) {\n      renamed := owners.filter(o -> new_of(o + \".\" + f) is Some)\n      if renamed != [] && len(owners) > 1 {\n        match owners.find(o -> new_of(o + \".\" + f) is None) {\n          Some(other) => return Err(\n            f\"in `{store.qname(d)}`, `.{f}` is read from a union that also has `{refactor.short(other)}.{f}` (rename it too, in the same command)\",\n          ),\n          None => (),\n        }\n        if len(\n          set(renamed.map(o -> (new_of(o + \".\" + f) ?? (\"\", \"\")).1)),\n        ) > 1 {\n          return Err(\n            f\"`.{f}` is read from a union whose records would get different names\",\n          )\n        }\n      }\n    }\n  }\n  mut out := ds\n  for (old, new) in pairs {\n    out = refactor.rename_one(out, old, new)!\n  }\n  // (the tags off)\n  Ok(\n    out.map(\n      d ->\n        walk.rewrite_decl(\n          d,\n          e ->\n            match e {\n              ast.FieldOf { base, name } => ast.FieldOf { base, name: refactor.untagged(name) },\n              _ => e,\n            },\n        ),\n    ),\n  )\n}"},{"name":"refactor.rename_one","kind":"fn","old":"c379b44252863dad","new":"651e5696ef44fd74","interface_changed":false,"affected":[],"module":"refactor","text":"/// Renames `old` (a qualified function, type, trait, variant or trait\n/// method) to the short name `new`, and every reference to it.\nfn rename_one(\n  ds: List[ast.Decl],\n  old: String,\n  new: String,\n) -> Result[List[ast.Decl], String] {\n  (kind, module) := refactor.member(ds, old) or {\n    return Err(f\"no definition, variant, trait method or field `{old}`\")\n  }\n  if ds.any(\n    d -> store.qname(d) == old\n      && match d.kind {\n        ast.ExternDef(x) => x.item is ast.ExternFn,\n        _ => false,\n      },\n  ) {\n    return Err(\n      f\"`{old}` is a foreign function: its name is the symbol it is linked to, so it can't be renamed (wrap it in a function with the name you want)\",\n    )\n  }\n  if !refactor.is_name(new) {\n    return Err(\n      f\"`{new}` is not a name (give the new short name, without the module)\",\n    )\n  }\n  s := refactor.short(old)\n  if refactor.is_upper(s) != refactor.is_upper(new) {\n    want := if refactor.is_upper(new) {\n      \"a lowercase letter\"\n    } else {\n      \"an uppercase letter\"\n    }\n    return Err(f\"`{new}` must start with {want} like `{s}`\")\n  }\n  if kind == \"field\" {\n    return refactor.rename_field(ds, module, s, new)\n  }\n  if kind == \"method\" {\n    return refactor.rename_method(ds, old, module, s, new)\n  }\n  new_q := refactor.qualify(module, new)\n  if contains(refactor.defined(ds), new_q) {\n    return Err(f\"`{new_q}` already exists\")\n  }\n  renames := Dict[String, String] { old: new_q }\n  Ok(ds.map(\n    d -> refactor.renamed_decl(d, old, s, new, kind, renames, \"\", 0),\n  ))\n}","old_text":"/// Renames `old` (a qualified function, type, trait, variant or trait\n/// method) to the short name `new`, and every reference to it.\nfn rename_one(\n  ds: List[ast.Decl],\n  old: String,\n  new: String,\n) -> Result[List[ast.Decl], String] {\n  (kind, module) := refactor.member(ds, old) or {\n    return Err(f\"no definition, variant, trait method or field `{old}`\")\n  }\n  if ds.any(\n    d -> store.qname(d) == old\n      && match d.kind {\n        ast.ExternDef(x) => x.item is ast.ExternFn,\n        _ => false,\n      },\n  ) {\n    return Err(\n      f\"`{old}` is a foreign function: its name is the symbol it is linked to, so it can't be renamed (wrap it in a function with the name you want)\",\n    )\n  }\n  if !refactor.is_name(new) {\n    return Err(\n      f\"`{new}` is not a name (give the new short name, without the module)\",\n    )\n  }\n  s := refactor.short(old)\n  if refactor.is_upper(s) != refactor.is_upper(new) {\n    want := if refactor.is_upper(new) {\n      \"a lowercase letter\"\n    } else {\n      \"an uppercase letter\"\n    }\n    return Err(f\"`{new}` must start with {want} like `{s}`\")\n  }\n  if kind == \"field\" {\n    return refactor.rename_field(ds, module, s, new)\n  }\n  new_q := refactor.qualify(module, new)\n  if contains(refactor.defined(ds), new_q) {\n    return Err(f\"`{new_q}` already exists\")\n  }\n  renames := Dict[String, String] { old: new_q }\n  Ok(\n    ds.map(\n      d -> refactor.renamed_decl(d, old, s, new, kind, renames),\n    ),\n  )\n}"},{"name":"refactor.member","kind":"fn","old":"e885e25d84f078fe","new":"20c482b215bd7801","interface_changed":false,"affected":[],"module":"refactor","text":"/// The kind of `q` (`function`, `type`, `trait`, `variant`, `method`, or\n/// `field` for `Owner.field`) and its module (for a field, its owner). A\n/// trait method is `module.m`, or `module.Trait.m`.\npub fn member(ds: List[ast.Decl], q: String) -> Option[(String, String)] {\n  for d in ds {\n    if store.qname(d) == q {\n      kind := match d.kind {\n        ast.FnDef(_) => \"function\",\n        ast.TypeDef(_) => \"type\",\n        ast.TraitDef(_) => \"trait\",\n        ast.ExternDef(x) => match x.item {\n          ast.ExternType(_, _) => \"type\",\n          _ => \"function\",\n        },\n        ast.CapabilityDef(_) => \"type\",\n        _ => \"\",\n      }\n      if kind == \"\" {\n        return None\n      }\n      return Some((kind, d.module))\n    }\n    match d.kind {\n      ast.TypeDef(t) => match t.body {\n        ast.SumBody(vs) => if vs.any(v -> refactor.qualify(d.module, v.name) == q) {\n          return Some((\"variant\", d.module))\n        },\n        _ => (),\n      },\n      ast.TraitDef(t) => if t.methods.any(\n        m -> refactor.qualify(d.module, m.decl.name) == q\n          || refactor.qualify(d.module, t.name + \".\" + m.decl.name) == q,\n      ) {\n        return Some((\"method\", d.module))\n      },\n      _ => (),\n    }\n  }\n  owner := refactor.module_of(q)\n  field := refactor.short(q)\n  if owner != \"\" && refactor.fields_of(ds, owner).any(f -> f == field) {\n    Some((\"field\", owner))\n  } else {\n    None\n  }\n}","old_text":"/// The kind of `q` (`function`, `type`, `trait`, `variant`, `method`, or\n/// `field` for `Owner.field`) and its module (for a field, its owner).\npub fn member(ds: List[ast.Decl], q: String) -> Option[(String, String)] {\n  for d in ds {\n    if store.qname(d) == q {\n      kind := match d.kind {\n        ast.FnDef(_) => \"function\",\n        ast.TypeDef(_) => \"type\",\n        ast.TraitDef(_) => \"trait\",\n        ast.ExternDef(x) => match x.item {\n          ast.ExternType(_, _) => \"type\",\n          _ => \"function\",\n        },\n        ast.CapabilityDef(_) => \"type\",\n        _ => \"\",\n      }\n      if kind == \"\" {\n        return None\n      }\n      return Some((kind, d.module))\n    }\n    match d.kind {\n      ast.TypeDef(t) => match t.body {\n        ast.SumBody(vs) => if vs.any(v -> refactor.qualify(d.module, v.name) == q) {\n          return Some((\"variant\", d.module))\n        },\n        _ => (),\n      },\n      ast.TraitDef(t) => if t.methods.any(\n        m -> refactor.qualify(d.module, m.decl.name) == q,\n      ) {\n        return Some((\"method\", d.module))\n      },\n      _ => (),\n    }\n  }\n  owner := refactor.module_of(q)\n  field := refactor.short(q)\n  if owner != \"\" && refactor.fields_of(ds, owner).any(f -> f == field) {\n    Some((\"field\", owner))\n  } else {\n    None\n  }\n}"},{"name":"refactor.owner","kind":"fn","old":"baf12c5dbd3f6dc6","new":"7f29cad7765e5cfc","interface_changed":false,"affected":[],"module":"refactor","text":"/// `q` itself, the type of a variant or field, or the trait of a method.\npub fn owner(ds: List[ast.Decl], q: String) -> Option[String] {\n  match refactor.member(ds, q) {\n    None => None,\n    Some((kind, of)) => {\n      target := if kind == \"field\" {\n        of\n      } else {\n        q\n      }\n      match ds.find(\n        d -> store.qname(d) == target\n          || match d.kind {\n            ast.TypeDef(t) => match t.body {\n              ast.SumBody(vs) => vs.any(\n                v -> refactor.qualify(d.module, v.name) == target,\n              ),\n              _ => false,\n            },\n            ast.TraitDef(t) => t.methods.any(\n              m -> refactor.qualify(d.module, m.decl.name) == target\n                || refactor.qualify(\n                  d.module,\n                  t.name + \".\" + m.decl.name,\n                ) == target,\n            ),\n            _ => false,\n          },\n      ) {\n        Some(d) => Some(store.qname(d)),\n        None => None,\n      }\n    },\n  }\n}","old_text":"/// `q` itself, the type of a variant or field, or the trait of a method.\npub fn owner(ds: List[ast.Decl], q: String) -> Option[String] {\n  match refactor.member(ds, q) {\n    None => None,\n    Some((kind, of)) => {\n      target := if kind == \"field\" {\n        of\n      } else {\n        q\n      }\n      match ds.find(\n        d -> store.qname(d) == target\n          || match d.kind {\n            ast.TypeDef(t) => match t.body {\n              ast.SumBody(vs) => vs.any(\n                v -> refactor.qualify(d.module, v.name) == target,\n              ),\n              _ => false,\n            },\n            ast.TraitDef(t) => t.methods.any(\n              m -> refactor.qualify(d.module, m.decl.name) == target,\n            ),\n            _ => false,\n          },\n      ) {\n        Some(d) => Some(store.qname(d)),\n        None => None,\n      }\n    },\n  }\n}"},{"name":"refactor.renamed_decl","kind":"fn","old":"40882ea9bdd6941b","new":"54d4580928ab4668","interface_changed":true,"affected":["refactor.rename_one","refactor.rename_method","refactor.rename_all","diff.diff","rename_command","merge.follow_rename","diff.range_diff","history.change_diff","command_line","follow_renames","diff.range_text","diff_command","tour.package_changes","history.change_text","history.change_words","main","sync_command","tour.prepare","history_command","revert_command","codegen.generate","codegen.new_gen","codegen.entry","codegen.compiled_alone","eval.run","tour_command","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","std_library","literal_errors","compiled_drivers","compiling","replay_all","codegen_text","built_ir","wasm_built","core_rt_object","test_command","build_core_command","comptime_value","repl_command","check_command","run_command","build_command","verify_command","live_edit_command","alongside_command","static_graph","literal_errors_of","verify_program","graph_runs","replay","or_solver_inputs","jit_file","fuzz_file","codegen_file","program_objects","strata_command","comptime_values","graph_command","graph_diff","loaded_check","file_errors","edit_file","edit_errors","search_invariants","build_proofs","verify_file","check_fn","call_command","linked","expanded","comptime_runner","package_checked","loaded_errors","check_files","edit_command","apply_edit","apply_change","fix_loops","std_proofs","with_base","package_errors","edit_in_editor","fix_command","move_command"],"module":"refactor","text":"/// Renames `old` (short name `s`) to `new` in one definition: its own name\n/// or member's, its references and its `use` items. A method is\n/// `trait_q`'s, and `others` methods elsewhere have its name.\nfn renamed_decl(\n  d: ast.Decl,\n  old: String,\n  s: String,\n  new: String,\n  kind: String,\n  renames: Dict[String, String],\n  trait_q: String,\n  others: Int,\n) -> ast.Decl {\n  d1 := refactor.substituted(d, renames)\n  own := kind != \"method\" && store.qname(d) == old\n  k := match d1.kind {\n    ast.TypeDef(t) => ast.TypeDef(ast.TypeDecl { ..t, name: if own {\n      new\n    } else {\n      t.name\n    }, body: match t.body {\n      ast.SumBody(vs) => ast.SumBody(vs.map(\n        v -> if kind == \"variant\"\n          && refactor.qualify(d.module, v.name) == old {\n          ast.Variant { ..v, name: new }\n        } else {\n          v\n        },\n      )),\n      _ => t.body,\n    } }),\n    ast.FnDef(f) => ast.FnDef(if own {\n      ast.FnDecl { ..f, name: new }\n    } else {\n      f\n    }),\n    ast.TraitDef(t) => ast.TraitDef(ast.TraitDecl { ..t, name: if own {\n      new\n    } else {\n      t.name\n    }, methods: t.methods.map(\n      m -> if kind == \"method\"\n        && refactor.qualify(d.module, t.name) == trait_q\n        && m.decl.name == s {\n        ast.TraitMethod {\n          ..m,\n          decl: ast.FnDecl { ..m.decl, name: new },\n        }\n      } else {\n        m\n      },\n    ) }),\n    ast.ImplDef(i) => ast.ImplDef(ast.ImplDecl {\n      ..i,\n      trait_name: get(renames, i.trait_name) ?? i.trait_name,\n      methods: i.methods.map(\n        f -> if kind == \"method\"\n          && refactor.is_trait(d.module, i.trait_name, trait_q)\n          && f.name == s {\n          ast.FnDecl { ..f, name: new }\n        } else {\n          f\n        },\n      ),\n    }),\n    ast.UseDef(u) => ast.UseDef(ast.UseDecl { ..u, items: match u.items {\n      Some(items) => Some(items.map(\n        it -> if refactor.qualify(u.path, it.name) == old {\n          ast.UseItem { ..it, name: new }\n        } else {\n          it\n        },\n      )),\n      None => None,\n    } }),\n    ast.ExternDef(x) => ast.ExternDef(ast.ExternDecl { ..x, item: match x.item {\n      ast.ExternType(n, ps) => ast.ExternType(if own {\n        new\n      } else {\n        n\n      }, ps),\n      ast.ExternStatic(n, size) => ast.ExternStatic(if own {\n        new\n      } else {\n        n\n      }, size),\n      ast.ExternThreadStatic(n, size) => ast.ExternThreadStatic(if own {\n        new\n      } else {\n        n\n      }, size),\n      _ => x.item,\n    } }),\n    ast.CapabilityDef(c) => ast.CapabilityDef(if own {\n      ast.CapabilityDecl { ..c, name: new }\n    } else {\n      c\n    }),\n    _ => d1.kind,\n  }\n  d2 := ast.Decl { ..d1, kind: k }\n  if kind == \"method\" {\n    walk.rewrite_decl(d2, e -> match e {\n      ast.MethodCall { recv, name, args } => if old != s && name == old {\n        ast.MethodCall {\n          recv,\n          name: refactor.qualify(refactor.module_of(old), new),\n          args,\n        }\n      } else if name == s && others == 0 || name == s + \"#\" + trait_q {\n        ast.MethodCall { recv, name: new, args }\n      } else {\n        e\n      },\n      _ => e,\n    })\n  } else {\n    d2\n  }\n}","old_text":"/// Renames `old` (short name `s`) to `new` in one definition: its own name\n/// or member's, its references and its `use` items.\nfn renamed_decl(\n  d: ast.Decl,\n  old: String,\n  s: String,\n  new: String,\n  kind: String,\n  renames: Dict[String, String],\n) -> ast.Decl {\n  d1 := refactor.substituted(d, renames)\n  own := store.qname(d) == old\n  k := match d1.kind {\n    ast.TypeDef(t) => ast.TypeDef(ast.TypeDecl { ..t, name: if own {\n      new\n    } else {\n      t.name\n    }, body: match t.body {\n      ast.SumBody(vs) => ast.SumBody(vs.map(\n        v -> if kind == \"variant\"\n          && refactor.qualify(d.module, v.name) == old {\n          ast.Variant { ..v, name: new }\n        } else {\n          v\n        },\n      )),\n      _ => t.body,\n    } }),\n    ast.FnDef(f) => ast.FnDef(if own {\n      ast.FnDecl { ..f, name: new }\n    } else {\n      f\n    }),\n    ast.TraitDef(t) => ast.TraitDef(ast.TraitDecl { ..t, name: if own {\n      new\n    } else {\n      t.name\n    }, methods: t.methods.map(\n      m -> if kind == \"method\"\n        && refactor.qualify(d.module, m.decl.name) == old {\n        ast.TraitMethod {\n          ..m,\n          decl: ast.FnDecl { ..m.decl, name: new },\n        }\n      } else {\n        m\n      },\n    ) }),\n    ast.ImplDef(i) => ast.ImplDef(ast.ImplDecl {\n      ..i,\n      trait_name: get(renames, i.trait_name) ?? i.trait_name,\n      methods: i.methods.map(\n        f -> if kind == \"method\" && f.name == s {\n          ast.FnDecl { ..f, name: new }\n        } else {\n          f\n        },\n      ),\n    }),\n    ast.UseDef(u) => ast.UseDef(ast.UseDecl { ..u, items: match u.items {\n      Some(items) => Some(items.map(\n        it -> if refactor.qualify(u.path, it.name) == old {\n          ast.UseItem { ..it, name: new }\n        } else {\n          it\n        },\n      )),\n      None => None,\n    } }),\n    ast.ExternDef(x) => ast.ExternDef(ast.ExternDecl { ..x, item: match x.item {\n      ast.ExternType(n, ps) => ast.ExternType(if own {\n        new\n      } else {\n        n\n      }, ps),\n      ast.ExternStatic(n, size) => ast.ExternStatic(if own {\n        new\n      } else {\n        n\n      }, size),\n      ast.ExternThreadStatic(n, size) => ast.ExternThreadStatic(if own {\n        new\n      } else {\n        n\n      }, size),\n      _ => x.item,\n    } }),\n    ast.CapabilityDef(c) => ast.CapabilityDef(if own {\n      ast.CapabilityDecl { ..c, name: new }\n    } else {\n      c\n    }),\n    _ => d1.kind,\n  }\n  d2 := ast.Decl { ..d1, kind: k }\n  if kind == \"method\" {\n    walk.rewrite_decl(d2, e -> match e {\n      ast.MethodCall { recv, name, args } => if name == s || name == old {\n        ast.MethodCall { recv, name: if name == old {\n          refactor.qualify(refactor.module_of(old), new)\n        } else {\n          new\n        }, args }\n      } else {\n        e\n      },\n      _ => e,\n    })\n  } else {\n    d2\n  }\n}"},{"name":"refactor.untagged","kind":"fn","old":"701743f98aa884a8","new":"75948035137dc2ee","interface_changed":false,"affected":[],"module":"refactor","text":"/// `sku` of `sku#Line`, `size` of `size#Sized`.\nfn untagged(n: String) -> String {\n  match index_of(n, \"#\") {\n    Some(k) => byte_slice(n, 0, k),\n    None => n,\n  }\n}","old_text":"/// `sku` of `sku#Line`.\nfn untagged(n: String) -> String {\n  match index_of(n, \"#\") {\n    Some(k) => byte_slice(n, 0, k),\n    None => n,\n  }\n}"},{"name":"refactor.rename_method","kind":"fn","old":null,"new":"f73ea3de7aa46c0e","interface_changed":true,"affected":[],"module":"refactor","text":"/// Renames trait method `old` (`module.m` or `module.Trait.m`, short name\n/// `s`) to `new`: the trait's method, the methods of its `impl`s and the\n/// calls tagged as calling it (`mark_method_calls`). An untagged call is\n/// renamed only when no other method has that name.\nfn rename_method(\n  ds: List[ast.Decl],\n  old: String,\n  module: String,\n  s: String,\n  new: String,\n) -> Result[List[ast.Decl], String] {\n  traits := refactor.method_traits(ds, old)\n  if len(traits) > 1 {\n    named := join(traits.map(t -> t + \".\" + s), \", \")\n    return Err(\n      f\"`{s}` is a method of {len(traits)} traits: name the one to rename ({named})\",\n    )\n  }\n  trait_q := get(traits, 0) ?? \"\"\n  if refactor.trait_methods(ds, trait_q).contains(new) {\n    return Err(f\"`{trait_q}` already has a method `{new}`\")\n  }\n  canon := refactor.qualify(module, s)\n  renames := if ds.any(d -> store.qname(d) == canon) {\n    Dict[String, String] {}\n  } else {\n    Dict[String, String] { canon: refactor.qualify(module, new) }\n  }\n  others := len(refactor.same_named_methods(ds, s, trait_q))\n  Ok(ds.map(\n    d -> refactor.renamed_decl(\n      d,\n      canon,\n      s,\n      new,\n      \"method\",\n      renames,\n      trait_q,\n      others,\n    ),\n  ))\n}"},{"name":"refactor.method_traits","kind":"fn","old":null,"new":"f731f71eb031ef09","interface_changed":true,"affected":[],"module":"refactor","text":"/// The traits, qualified, that have the method `q` names (`module.m`, or\n/// `module.Trait.m`).\npub fn method_traits(ds: List[ast.Decl], q: String) -> List[String] {\n  mut out := []\n  for d in ds {\n    match d.kind {\n      ast.TraitDef(t) => if t.methods.any(\n        m -> refactor.qualify(d.module, m.decl.name) == q\n          || refactor.qualify(d.module, t.name + \".\" + m.decl.name) == q,\n      ) {\n        mut out.push(refactor.qualify(d.module, t.name))\n      },\n      _ => (),\n    }\n  }\n  out\n}"},{"name":"refactor.trait_methods","kind":"fn","old":null,"new":"b394b6ec17518c4c","interface_changed":true,"affected":[],"module":"refactor","text":"/// The names of the methods of trait `trait_q`.\nfn trait_methods(ds: List[ast.Decl], trait_q: String) -> List[String] {\n  for d in ds {\n    match d.kind {\n      ast.TraitDef(t) => if refactor.qualify(d.module, t.name) == trait_q {\n        return t.methods.map(m -> m.decl.name)\n      },\n      _ => (),\n    }\n  }\n  []\n}"},{"name":"refactor.is_trait","kind":"fn","old":null,"new":"1c764a593c30babe","interface_changed":true,"affected":[],"module":"refactor","text":"/// Whether `impl` trait name `written`, in module `module`, is `trait_q`.\nfn is_trait(module: String, written: String, trait_q: String) -> Bool {\n  written != \"\"\n    && (written == trait_q\n      || refactor.qualify(module, written) == trait_q)\n}"},{"name":"refactor.same_named_methods","kind":"fn","old":null,"new":"8d5265171c0b17cb","interface_changed":true,"affected":[],"module":"refactor","text":"/// Where a method named `s` is defined other than in trait `trait_q` and\n/// its `impl`s: other traits, other `impl`s.\nfn same_named_methods(\n  ds: List[ast.Decl],\n  s: String,\n  trait_q: String,\n) -> List[String] {\n  mut out := []\n  for d in ds {\n    match d.kind {\n      ast.TraitDef(t) => if refactor.qualify(d.module, t.name) != trait_q\n        && t.methods.any(m -> m.decl.name == s) {\n        mut out.push(refactor.qualify(d.module, t.name))\n      },\n      ast.ImplDef(i) => if !refactor.is_trait(d.module, i.trait_name, trait_q)\n        && i.methods.any(m -> m.name == s) {\n        mut out.push(store.qname(d))\n      },\n      _ => (),\n    }\n  }\n  out\n}"}]}
{"id":"0f2f97bbc7ac12cd","time":1795821263,"message":"edit","changes":[{"name":"rename_command","kind":"fn","old":"b4fe806abdad3f72","new":"3226f9fcac1260bc","interface_changed":false,"affected":[],"module":"","text":"/// `strata rename <old> <new> [<old> <new>]... [-m MSG]`.\nfn rename_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  args: List[String],\n) -> std.process.ExitCode {\n  o := open_package(disk, process, \"rename\") except e {\n    return fail_with(mut console, e)\n  }\n  (msg, commit, words0) := message_and_rest(args)\n  json := contains(words0, \"--json\")\n  words := words0.filter(w -> w != \"--json\")\n  if len(words) == 0 || len(words) % 2 != 0 {\n    return fail_with(\n      mut console,\n      \"usage: strata rename <old> <new> [<old> <new>]...  (several renames are one step)\",\n    )\n  }\n  mut mods := []\n  for d in o.decls {\n    if !contains(mods, d.module) {\n      mut mods.push(d.module)\n    }\n  }\n  mods = to_list(set(mods))\n  mut pairs := []\n  mut i := 0\n  while i + 1 < len(words) {\n    old := get(words, i) ?? \"\"\n    new := get(words, i + 1) ?? \"\"\n    i += 2\n    (old_q, kind) := match refactor.member(o.decls, old) {\n      Some((k, _)) => (old, k),\n      None => {\n        found := [(\n          refactor.qualify(m, old),\n          (refactor.member(o.decls, refactor.qualify(m, old)) ?? (\"\", \"\")).0,\n        ) for m in mods where refactor.member(o.decls, refactor.qualify(m, old)) is Some]\n        match found {\n          [one] => one,\n          [] => return fail_with(\n            mut console,\n            f\"no definition, variant, trait method or field `{old}`\",\n          ),\n          many => return fail_with(\n            mut console,\n            f\"`{old}` is ambiguous: {join(many.map(x -> x.0), \", \")}\",\n          ),\n        }\n      },\n    }\n    mut pairs.push((old_q, new, kind))\n  }\n  mut marked := o.decls\n  for p in pairs.filter(p -> p.2 == \"method\") {\n    match refactor.method_traits(o.decls, p.0) {\n      [tr] => {\n        marked = check.mark_method_calls(\n          marked,\n          o.std,\n          o.core,\n          refactor.short(p.0),\n          tr,\n        )\n      },\n      _ => (),\n    }\n  }\n  // each read of a renamed field tagged with the records it reads from, as\n  // the checker types its receiver\n  for f in (Set { refactor.short(p.0) for p in pairs where p.2 == \"field\" }) {\n    marked = check.mark_field_reads(marked, o.std, o.core, f)\n  }\n  renamed := refactor.rename_all(marked, pairs.map(p -> (p.0, p.1))) except e {\n    return fail_with(mut console, e)\n  }\n  news := pairs.map(p -> refactor.qualify(refactor.module_of(p.0), p.1))\n  mut owners := []\n  for p in pairs {\n    match refactor.owner(o.decls, p.0) {\n      Some(x) => mut owners.push(x),\n      None => (),\n    }\n  }\n  mut before := Dict[String, String] {}\n  for d in o.decls {\n    mut before.insert(\n      store.qname(d),\n      codebase.short_hex(binary.hash(d)),\n    )\n  }\n  shown := written_names(renamed, o.std, o.core)\n  updated := [get(shown, store.qname(d)) ?? store.qname(d) for d in renamed where !(d.kind is ast.UseDef)\n    && !contains(news, store.qname(d))\n    && !contains(owners, store.qname(d))\n    && match get(before, store.qname(d)) {\n      Some(h) => h != codebase.short_hex(binary.hash(d)),\n      None => false,\n    }]\n  shorts := pairs.map(p -> refactor.short(p.0))\n  mentions := [get(shown, store.qname(d)) ?? store.qname(d) for d in renamed where (d.doc + d.comments).any(l -> mentions_word(l, shorts))]\n  arrows := [f\"{p.0} → {get(news, k) ?? \"\"}\" for (k, p) in enumerate(pairs)]\n  message := msg ?? f\"rename {join(arrows, \", \")}\"\n  entries := [f\"{{\\\"from\\\":{codebase.json_string(p.0)},\\\"to\\\":{codebase.json_string(get(news, k) ?? \"\")},\\\"kind\\\":{codebase.json_string(p.2)}}}\" for (k, p) in enumerate(pairs)]\n  extra := [(\"renames\", \"[\" + join(entries, \",\") + \"]\"), (\n    \"references\",\n    \"[\" + join(updated.map(u -> codebase.json_string(u)), \",\") + \"]\",\n  )]\n  if !apply_change(\n    mut console,\n    mut disk,\n    mut launcher,\n    clock,\n    cache,\n    o,\n    renamed,\n    message,\n    extra,\n    entries,\n    commit,\n  ) {\n    return 1\n  }\n  if json {\n    refs := \"[\" + join(updated.map(u -> codebase.json_string(u)), \",\") + \"]\"\n    ms := \"[\"\n      + join(mentions.map(u -> codebase.json_string(u)), \",\")\n      + \"]\"\n    mut console.print(\n      \"{\\\"renames\\\":[\"\n        + join(entries, \",\")\n        + \"],\\\"references\\\":\"\n        + refs\n        + \",\\\"mentions\\\":\"\n        + ms\n        + \"}\",\n    )\n    return 0\n  }\n  mut console.print(f\"renamed {join(arrows, \", \")}\")\n  it := plural(len(pairs), \"it\", \"them\")\n  match len(updated) {\n    0 => mut console.print(f\"no other definition refers to {it}\"),\n    n => mut console.print(\n      f\"updated {n} definition{plural(n, \"\", \"s\")} that refer{plural(n, \"s\", \"\")} to {it}: {join(updated, \", \")}\",\n    ),\n  }\n  if len(mentions) > 0 {\n    mut console.print(\n      f\"docs or comments still mention {join(shorts.map(s -> f\"`{s}`\"), \" or \")} in: {join(mentions, \", \")}\",\n    )\n  }\n  0\n}","old_text":"/// `strata rename <old> <new> [<old> <new>]... [-m MSG]`.\nfn rename_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  args: List[String],\n) -> std.process.ExitCode {\n  o := open_package(disk, process, \"rename\") except e {\n    return fail_with(mut console, e)\n  }\n  (msg, commit, words0) := message_and_rest(args)\n  json := contains(words0, \"--json\")\n  words := words0.filter(w -> w != \"--json\")\n  if len(words) == 0 || len(words) % 2 != 0 {\n    return fail_with(\n      mut console,\n      \"usage: strata rename <old> <new> [<old> <new>]...  (several renames are one step)\",\n    )\n  }\n  mut mods := []\n  for d in o.decls {\n    if !contains(mods, d.module) {\n      mut mods.push(d.module)\n    }\n  }\n  mods = to_list(set(mods))\n  mut pairs := []\n  mut i := 0\n  while i + 1 < len(words) {\n    old := get(words, i) ?? \"\"\n    new := get(words, i + 1) ?? \"\"\n    i += 2\n    (old_q, kind) := match refactor.member(o.decls, old) {\n      Some((k, _)) => (old, k),\n      None => {\n        found := [(\n          refactor.qualify(m, old),\n          (refactor.member(o.decls, refactor.qualify(m, old)) ?? (\"\", \"\")).0,\n        ) for m in mods where refactor.member(o.decls, refactor.qualify(m, old)) is Some]\n        match found {\n          [one] => one,\n          [] => return fail_with(\n            mut console,\n            f\"no definition, variant, trait method or field `{old}`\",\n          ),\n          many => return fail_with(\n            mut console,\n            f\"`{old}` is ambiguous: {join(many.map(x -> x.0), \", \")}\",\n          ),\n        }\n      },\n    }\n    mut pairs.push((old_q, new, kind))\n  }\n  // each read of a renamed field tagged with the records it reads from, as\n  // the checker types its receiver\n  mut marked := o.decls\n  for f in (Set { refactor.short(p.0) for p in pairs where p.2 == \"field\" }) {\n    marked = check.mark_field_reads(marked, o.std, o.core, f)\n  }\n  renamed := refactor.rename_all(marked, pairs.map(p -> (p.0, p.1))) except e {\n    return fail_with(mut console, e)\n  }\n  news := pairs.map(p -> refactor.qualify(refactor.module_of(p.0), p.1))\n  mut owners := []\n  for p in pairs {\n    match refactor.owner(o.decls, p.0) {\n      Some(x) => mut owners.push(x),\n      None => (),\n    }\n  }\n  mut before := Dict[String, String] {}\n  for d in o.decls {\n    mut before.insert(\n      store.qname(d),\n      codebase.short_hex(binary.hash(d)),\n    )\n  }\n  shown := written_names(renamed, o.std, o.core)\n  updated := [get(shown, store.qname(d)) ?? store.qname(d) for d in renamed where !(d.kind is ast.UseDef)\n    && !contains(news, store.qname(d))\n    && !contains(owners, store.qname(d))\n    && match get(before, store.qname(d)) {\n      Some(h) => h != codebase.short_hex(binary.hash(d)),\n      None => false,\n    }]\n  shorts := pairs.map(p -> refactor.short(p.0))\n  mentions := [get(shown, store.qname(d)) ?? store.qname(d) for d in renamed where (d.doc + d.comments).any(l -> mentions_word(l, shorts))]\n  arrows := [f\"{p.0} → {get(news, k) ?? \"\"}\" for (k, p) in enumerate(pairs)]\n  message := msg ?? f\"rename {join(arrows, \", \")}\"\n  entries := [f\"{{\\\"from\\\":{codebase.json_string(p.0)},\\\"to\\\":{codebase.json_string(get(news, k) ?? \"\")},\\\"kind\\\":{codebase.json_string(p.2)}}}\" for (k, p) in enumerate(pairs)]\n  extra := [(\"renames\", \"[\" + join(entries, \",\") + \"]\"), (\n    \"references\",\n    \"[\" + join(updated.map(u -> codebase.json_string(u)), \",\") + \"]\",\n  )]\n  if !apply_change(\n    mut console,\n    mut disk,\n    mut launcher,\n    clock,\n    cache,\n    o,\n    renamed,\n    message,\n    extra,\n    entries,\n    commit,\n  ) {\n    return 1\n  }\n  if json {\n    refs := \"[\" + join(updated.map(u -> codebase.json_string(u)), \",\") + \"]\"\n    ms := \"[\"\n      + join(mentions.map(u -> codebase.json_string(u)), \",\")\n      + \"]\"\n    mut console.print(\n      \"{\\\"renames\\\":[\"\n        + join(entries, \",\")\n        + \"],\\\"references\\\":\"\n        + refs\n        + \",\\\"mentions\\\":\"\n        + ms\n        + \"}\",\n    )\n    return 0\n  }\n  mut console.print(f\"renamed {join(arrows, \", \")}\")\n  it := plural(len(pairs), \"it\", \"them\")\n  match len(updated) {\n    0 => mut console.print(f\"no other definition refers to {it}\"),\n    n => mut console.print(\n      f\"updated {n} definition{plural(n, \"\", \"s\")} that refer{plural(n, \"s\", \"\")} to {it}: {join(updated, \", \")}\",\n    ),\n  }\n  if len(mentions) > 0 {\n    mut console.print(\n      f\"docs or comments still mention {join(shorts.map(s -> f\"`{s}`\"), \" or \")} in: {join(mentions, \", \")}\",\n    )\n  }\n  0\n}"}]}
{"id":"064a4c19019e2ca3","time":1795821364,"message":"edit","changes":[{"name":"check.resolved_calls","kind":"fn","old":"c5ae96026ff60a3a","new":"cf566a95722fbfbd","interface_changed":false,"affected":[],"module":"check","text":"/// `e` with each tagged call's tag replaced by `trait_q` when its receiver's\n/// type resolves the call to that trait's method, by nothing when it\n/// resolves it to another, and taken off when its type isn't known.\nfn resolved_calls(i: check.Inf, e: ast.Expr, trait_q: String) -> ast.Expr {\n  inner := walk.expr_children(\n    e,\n    c -> check.resolved_calls(i, c, trait_q),\n    t -> t,\n  )\n  match inner {\n    ast.MethodCall { recv, name, args } => match check.untag(name) {\n      Some((m, k)) => {\n        rt := match get(i.insts, k + \":recv\") {\n          Some(t) => check.res(i, t),\n          None => check.TAny,\n        }\n        print(\n          f\"DEBUG {m} {check.shown(rt) ?? \"?\"} {check.call_trait(i, rt, m) ?? \"-\"} {join(to_list(i.methods.impls), \";\")}\",\n        )\n        tagged := if rt is check.TAny || rt is check.TVar {\n          m\n        } else if check.call_trait(i, rt, m) == Some(trait_q) {\n          m + \"#\" + trait_q\n        } else {\n          m + \"#\"\n        }\n        ast.MethodCall { recv, name: tagged, args }\n      },\n      None => inner,\n    },\n    _ => inner,\n  }\n}","old_text":"/// `e` with each tagged call's tag replaced by `trait_q` when its receiver's\n/// type resolves the call to that trait's method, by nothing when it\n/// resolves it to another, and taken off when its type isn't known.\nfn resolved_calls(i: check.Inf, e: ast.Expr, trait_q: String) -> ast.Expr {\n  inner := walk.expr_children(\n    e,\n    c -> check.resolved_calls(i, c, trait_q),\n    t -> t,\n  )\n  match inner {\n    ast.MethodCall { recv, name, args } => match check.untag(name) {\n      Some((m, k)) => {\n        rt := match get(i.insts, k + \":recv\") {\n          Some(t) => check.res(i, t),\n          None => check.TAny,\n        }\n        tagged := if rt is check.TAny || rt is check.TVar {\n          m\n        } else if check.call_trait(i, rt, m) == Some(trait_q) {\n          m + \"#\" + trait_q\n        } else {\n          m + \"#\"\n        }\n        ast.MethodCall { recv, name: tagged, args }\n      },\n      None => inner,\n    },\n    _ => inner,\n  }\n}"}]}
{"id":"5b44a11c0182eac7","time":1795821415,"message":"edit","changes":[{"name":"check.mark_method_calls","kind":"fn","old":"3e4b1770584c8320","new":"03fd90fcf9220d76","interface_changed":false,"affected":[],"module":"check","text":"/// Each call of `method` (`x.method(..)`) in `own`, tagged with what the\n/// checker resolves it to: `method#Tr` for the method of trait `trait_q`\n/// (through an `impl` of it, a bound, a trait value or `Self` in the\n/// trait; the checker names traits by their short names), `method#` for any\n/// other method of that name. For `rename`. A\n/// call whose receiver isn't known stays as it is.\npub fn mark_method_calls(\n  own: List[ast.Decl],\n  lib: List[ast.Decl],\n  core: builtins.Core,\n  method: String,\n  trait_q: String,\n) -> List[ast.Decl] {\n  all := own + lib\n  types := check.types_of(all)\n  fns := check.fn_types(all, types)\n  methods := check.methods_of(all, types)\n  builtins := check.builtins_of(types, core)\n  tags := check.Tags { fns: Set[String] {}, methods: Set { method } }\n  marked := (f: ast.FnDecl, tps: Set[String]) -> {\n    g := ast.FnDecl { ..f, body: check.tag(tags, f.body, \"0\") }\n    i := check.fn_inferred(g, tps, types, fns, methods, builtins)\n    check.resolved_calls(i, g.body, trait_q)\n  }\n  self_t := ast.Named { name: \"Self\", args: [] }\n  in_trait := (d: ast.Decl, t: ast.TraitDecl, f: ast.FnDecl) -> {\n    g := ast.FnDecl {\n      ..check.method_of(f, self_t),\n      bounds: [ast.Bound { param: \"Self\", traits: [ast.Named {\n          name: check.qualified(d.module, t.name),\n          args: [],\n        }] }]\n        + f.bounds,\n    }\n    ast.FnDecl {\n      ..f,\n      body: marked(g, set([\"Self\"] + t.params + f.type_params)),\n    }\n  }\n  own.map(\n    d -> match d.kind {\n      ast.FnDef(f) => ast.Decl { ..d, kind: ast.FnDef(\n        ast.FnDecl { ..f, body: marked(f, set(f.type_params)) },\n      ) },\n      ast.ImplDef(im) => ast.Decl {\n        ..d,\n        kind: ast.ImplDef(ast.ImplDecl { ..im, methods: im.methods.map(\n          m -> {\n            g := ast.FnDecl {\n              ..check.method_of(m, im.for_type),\n              bounds: im.bounds + m.bounds,\n            }\n            ast.FnDecl {\n              ..m,\n              body: marked(g, set(im.type_params + g.type_params)),\n            }\n          },\n        ) }),\n      },\n      ast.TraitDef(t) => ast.Decl {\n        ..d,\n        kind: ast.TraitDef(ast.TraitDecl { ..t, methods: t.methods.map(\n          tm -> if tm.default {\n            ast.TraitMethod { ..tm, decl: in_trait(d, t, tm.decl) }\n          } else {\n            tm\n          },\n        ), laws: t.laws.map(\n          l -> ast.Law { ..l, body: in_trait(d, t, ast.FnDecl {\n            doc: [],\n            comments: [],\n            name: l.name,\n            type_params: [],\n            bounds: [],\n            params: l.params,\n            ret: ast.Named { name: \"Bool\", args: [] },\n            pre: [],\n            post: [],\n            terminating: false,\n            body: l.body,\n            compile_time: false,\n            derived: false,\n          }).body },\n        ) }),\n      },\n      ast.TestDef(t) => {\n        g := ast.FnDecl {\n          doc: [],\n          comments: [],\n          name: \"test\",\n          type_params: [],\n          bounds: [],\n          params: t.params,\n          ret: ast.Named { name: \"$outside\", args: [] },\n          pre: [],\n          post: [],\n          terminating: false,\n          body: t.body,\n          compile_time: false,\n          derived: false,\n        }\n        ast.Decl { ..d, kind: ast.TestDef(\n          ast.TestDecl { ..t, body: marked(g, Set[String] {}) },\n        ) }\n      },\n      _ => d,\n    },\n  )\n}","old_text":"/// Each call of `method` (`x.method(..)`) in `own`, tagged with what the\n/// checker resolves it to: `method#Tr` for the method of trait `trait_q`\n/// (through an `impl` of it, a bound, a trait value or `Self` in the\n/// trait), `method#` for any other method of that name. For `rename`. A\n/// call whose receiver isn't known stays as it is.\npub fn mark_method_calls(\n  own: List[ast.Decl],\n  lib: List[ast.Decl],\n  core: builtins.Core,\n  method: String,\n  trait_q: String,\n) -> List[ast.Decl] {\n  all := own + lib\n  types := check.types_of(all)\n  fns := check.fn_types(all, types)\n  methods := check.methods_of(all, types)\n  builtins := check.builtins_of(types, core)\n  tags := check.Tags { fns: Set[String] {}, methods: Set { method } }\n  marked := (f: ast.FnDecl, tps: Set[String]) -> {\n    g := ast.FnDecl { ..f, body: check.tag(tags, f.body, \"0\") }\n    i := check.fn_inferred(g, tps, types, fns, methods, builtins)\n    check.resolved_calls(i, g.body, trait_q)\n  }\n  self_t := ast.Named { name: \"Self\", args: [] }\n  in_trait := (d: ast.Decl, t: ast.TraitDecl, f: ast.FnDecl) -> {\n    g := ast.FnDecl {\n      ..check.method_of(f, self_t),\n      bounds: [ast.Bound { param: \"Self\", traits: [ast.Named {\n          name: check.qualified(d.module, t.name),\n          args: [],\n        }] }]\n        + f.bounds,\n    }\n    ast.FnDecl {\n      ..f,\n      body: marked(g, set([\"Self\"] + t.params + f.type_params)),\n    }\n  }\n  own.map(\n    d -> match d.kind {\n      ast.FnDef(f) => ast.Decl { ..d, kind: ast.FnDef(\n        ast.FnDecl { ..f, body: marked(f, set(f.type_params)) },\n      ) },\n      ast.ImplDef(im) => ast.Decl {\n        ..d,\n        kind: ast.ImplDef(ast.ImplDecl { ..im, methods: im.methods.map(\n          m -> {\n            g := ast.FnDecl {\n              ..check.method_of(m, im.for_type),\n              bounds: im.bounds + m.bounds,\n            }\n            ast.FnDecl {\n              ..m,\n              body: marked(g, set(im.type_params + g.type_params)),\n            }\n          },\n        ) }),\n      },\n      ast.TraitDef(t) => ast.Decl {\n        ..d,\n        kind: ast.TraitDef(ast.TraitDecl { ..t, methods: t.methods.map(\n          tm -> if tm.default {\n            ast.TraitMethod { ..tm, decl: in_trait(d, t, tm.decl) }\n          } else {\n            tm\n          },\n        ), laws: t.laws.map(\n          l -> ast.Law { ..l, body: in_trait(d, t, ast.FnDecl {\n            doc: [],\n            comments: [],\n            name: l.name,\n            type_params: [],\n            bounds: [],\n            params: l.params,\n            ret: ast.Named { name: \"Bool\", args: [] },\n            pre: [],\n            post: [],\n            terminating: false,\n            body: l.body,\n            compile_time: false,\n            derived: false,\n          }).body },\n        ) }),\n      },\n      ast.TestDef(t) => {\n        g := ast.FnDecl {\n          doc: [],\n          comments: [],\n          name: \"test\",\n          type_params: [],\n          bounds: [],\n          params: t.params,\n          ret: ast.Named { name: \"$outside\", args: [] },\n          pre: [],\n          post: [],\n          terminating: false,\n          body: t.body,\n          compile_time: false,\n          derived: false,\n        }\n        ast.Decl { ..d, kind: ast.TestDef(\n          ast.TestDecl { ..t, body: marked(g, Set[String] {}) },\n        ) }\n      },\n      _ => d,\n    },\n  )\n}"},{"name":"check.resolved_calls","kind":"fn","old":"cf566a95722fbfbd","new":"027aba87768da5c1","interface_changed":false,"affected":[],"module":"check","text":"/// `e` with each tagged call's tag replaced by `trait_q` when its receiver's\n/// type resolves the call to that trait's method, by nothing when it\n/// resolves it to another, and taken off when its type isn't known.\nfn resolved_calls(i: check.Inf, e: ast.Expr, trait_q: String) -> ast.Expr {\n  inner := walk.expr_children(\n    e,\n    c -> check.resolved_calls(i, c, trait_q),\n    t -> t,\n  )\n  match inner {\n    ast.MethodCall { recv, name, args } => match check.untag(name) {\n      Some((m, k)) => {\n        rt := match get(i.insts, k + \":recv\") {\n          Some(t) => check.res(i, t),\n          None => check.TAny,\n        }\n        tagged := if rt is check.TAny || rt is check.TVar {\n          m\n        } else if check.call_trait(i, rt, m) ?? \"\" != \"\"\n          && check.last_part(check.call_trait(i, rt, m) ?? \"\") == check.last_part(trait_q) {\n          m + \"#\" + trait_q\n        } else {\n          m + \"#\"\n        }\n        ast.MethodCall { recv, name: tagged, args }\n      },\n      None => inner,\n    },\n    _ => inner,\n  }\n}","old_text":"/// `e` with each tagged call's tag replaced by `trait_q` when its receiver's\n/// type resolves the call to that trait's method, by nothing when it\n/// resolves it to another, and taken off when its type isn't known.\nfn resolved_calls(i: check.Inf, e: ast.Expr, trait_q: String) -> ast.Expr {\n  inner := walk.expr_children(\n    e,\n    c -> check.resolved_calls(i, c, trait_q),\n    t -> t,\n  )\n  match inner {\n    ast.MethodCall { recv, name, args } => match check.untag(name) {\n      Some((m, k)) => {\n        rt := match get(i.insts, k + \":recv\") {\n          Some(t) => check.res(i, t),\n          None => check.TAny,\n        }\n        print(\n          f\"DEBUG {m} {check.shown(rt) ?? \"?\"} {check.call_trait(i, rt, m) ?? \"-\"} {join(to_list(i.methods.impls), \";\")}\",\n        )\n        tagged := if rt is check.TAny || rt is check.TVar {\n          m\n        } else if check.call_trait(i, rt, m) == Some(trait_q) {\n          m + \"#\" + trait_q\n        } else {\n          m + \"#\"\n        }\n        ast.MethodCall { recv, name: tagged, args }\n      },\n      None => inner,\n    },\n    _ => inner,\n  }\n}"}]}
{"id":"196eae2af72b3105","time":1795821503,"message":"edit","changes":[{"name":"views.proofs_kept","kind":"fn","old":"e989caadf67d027f","new":"f73636a6eb676dc2","interface_changed":false,"affected":[],"module":"views","text":"/// The definitions `edits` (text read back from a view) with the proof\n/// material views hide (`proofs_hidden`) put back from their stored\n/// versions in `old`, where the text has none of its own there, and the\n/// markers dropped: in functions, `impl` and capability methods, trait\n/// methods and laws, and tests. With notes on the parts that couldn't be\n/// placed (their place changed or is gone).\npub fn proofs_kept(\n  old: List[ast.Decl],\n  edits: List[ast.Decl],\n) -> (List[ast.Decl], List[String]) {\n  mut notes := []\n  mut out := []\n  for d in edits {\n    q := store.qname(d)\n    stored := old.filter(o -> store.qname(o) == q)\n    kept := match (d.kind, stored) {\n      (ast.FnDef(f), [ast.Decl { kind: ast.FnDef(of), .. }, ..]) => {\n        (nf, ns) := views.fn_kept(of, f, q)\n        notes += ns\n        ast.Decl { ..d, kind: ast.FnDef(nf) }\n      },\n      (ast.ImplDef(im), [ast.Decl { kind: ast.ImplDef(oi), .. }, ..]) => {\n        (ms, ns) := views.methods_kept(oi.methods, im.methods, q)\n        notes += ns\n        ast.Decl {\n          ..d,\n          kind: ast.ImplDef(ast.ImplDecl { ..im, methods: ms }),\n        }\n      },\n      (ast.CapabilityDef(c), [ast.Decl { kind: ast.CapabilityDef(oc), .. }, ..]) => {\n        (ms, ns) := views.methods_kept(oc.methods, c.methods, q)\n        notes += ns\n        ast.Decl {\n          ..d,\n          kind: ast.CapabilityDef(ast.CapabilityDecl { ..c, methods: ms }),\n        }\n      },\n      (ast.TraitDef(t), [ast.Decl { kind: ast.TraitDef(ot), .. }, ..]) => {\n        (ms, ns) := views.methods_kept(\n          ot.methods.map(m -> m.decl),\n          t.methods.map(m -> m.decl),\n          q,\n        )\n        notes += ns\n        mut laws := []\n        for l in t.laws {\n          match ot.laws.filter(x -> x.name == l.name) {\n            [ol, ..] => {\n              (body, lns) := views.body_kept(ol.body, l.body, q + \".\" + l.name)\n              notes += lns\n              mut laws.push(ast.Law { ..l, body })\n            },\n            [] => mut laws.push(\n              ast.Law { ..l, body: views.markers_dropped(l.body) },\n            ),\n          }\n        }\n        walk.rewrite_decl(\n          ast.Decl {\n            ..d,\n            kind: ast.TraitDef(\n              ast.TraitDecl {\n                ..t,\n                methods: [ast.TraitMethod { ..m, decl: get(ms, k) ?? m.decl } for (k, m) in enumerate(t.methods)],\n                laws,\n              },\n            ),\n          },\n          e -> views.markers_dropped_here(e),\n        )\n      },\n      (ast.TestDef(t), [ast.Decl { kind: ast.TestDef(ot), .. }, ..]) => {\n        (body, ns) := views.body_kept(ot.body, t.body, q)\n        notes += ns\n        ast.Decl {\n          ..d,\n          kind: ast.TestDef(ast.TestDecl { ..t, body }),\n        }\n      },\n      _ => walk.rewrite_decl(d, e -> views.markers_dropped_here(e)),\n    }\n    mut out.push(kept)\n  }\n  (out, notes)\n}","old_text":"/// The definitions `edits` (text read back from a view) with the proof\n/// material views hide (`proofs_hidden`) put back from their stored\n/// versions in `old`, where the text has none of its own there, and the\n/// markers dropped. With notes on the parts that couldn't be placed (their\n/// place changed or is gone).\npub fn proofs_kept(\n  old: List[ast.Decl],\n  edits: List[ast.Decl],\n) -> (List[ast.Decl], List[String]) {\n  mut notes := []\n  mut out := []\n  for d in edits {\n    q := store.qname(d)\n    stored := old.filter(o -> store.qname(o) == q)\n    kept := match (d.kind, stored) {\n      (ast.FnDef(f), [ast.Decl { kind: ast.FnDef(of), .. }, ..]) => {\n        (nf, ns) := views.fn_kept(of, f, q)\n        notes += ns\n        ast.Decl { ..d, kind: ast.FnDef(nf) }\n      },\n      (ast.ImplDef(im), [ast.Decl { kind: ast.ImplDef(oi), .. }, ..]) => {\n        mut ms := []\n        for m in im.methods {\n          match oi.methods.filter(x -> x.name == m.name) {\n            [om, ..] => {\n              (nm, ns) := views.fn_kept(om, m, q + \".\" + m.name)\n              notes += ns\n              mut ms.push(nm)\n            },\n            [] => mut ms.push(\n              ast.FnDecl {\n                ..m,\n                body: views.markers_dropped(m.body),\n              },\n            ),\n          }\n        }\n        ast.Decl {\n          ..d,\n          kind: ast.ImplDef(ast.ImplDecl { ..im, methods: ms }),\n        }\n      },\n      _ => walk.rewrite_decl(d, e -> views.markers_dropped_here(e)),\n    }\n    mut out.push(kept)\n  }\n  (out, notes)\n}"},{"name":"views.methods_kept","kind":"fn","old":null,"new":"cbf119220dcee370","interface_changed":true,"affected":[],"module":"views","text":"/// `given` methods with what `proofs_kept` puts back from the stored\n/// method of the same name in `stored`, in the same order.\nfn methods_kept(\n  stored: List[ast.FnDecl],\n  given: List[ast.FnDecl],\n  q: String,\n) -> (List[ast.FnDecl], List[String]) {\n  mut notes := []\n  mut ms := []\n  for m in given {\n    match stored.filter(x -> x.name == m.name) {\n      [om, ..] => {\n        (nm, ns) := views.fn_kept(om, m, q + \".\" + m.name)\n        notes += ns\n        mut ms.push(nm)\n      },\n      [] => mut ms.push(\n        ast.FnDecl { ..m, body: views.markers_dropped(m.body) },\n      ),\n    }\n  }\n  (ms, notes)\n}"}]}
{"id":"fdc47a1ca62e1147","time":1795821730,"message":"edit","changes":[{"name":"package_decls","kind":"fn","old":"a6d4697dd056ef4a","new":"e7090e7d34664ed0","interface_changed":false,"affected":[],"module":"","text":"/// Each in its module. The functions of the modules its strata.toml\n/// declares `noalloc` are marked so (`deps.noalloc_marked`). A file that\n/// can't be read or decoded has none, and an error says so: commands that\n/// write read the package with `read_package`.\nfn package_decls(\n  disk: std.fs.Disk,\n  dir: String,\n  package: String,\n) -> List[ast.Decl] {\n  rels := deps.module_files(disk, dir)\n  mut out := []\n  for (i, r) in enumerate(decoded_files(disk, rels.map(rel -> dir + \"/\" + rel))) {\n    m := deps.module_name(package, get(rels, i) ?? \"\")\n    match r {\n      Ok(decls) => {\n        for d in decls {\n          mut out.push(ast.Decl { ..d, module: m })\n        }\n      },\n      Err(e) => print(f\"error: {e}\"),\n    }\n  }\n  deps.noalloc_marked(\n    out,\n    package,\n    deps.noalloc_modules(disk.read(dir + \"/strata.toml\") !! \"\"),\n  )\n}","old_text":"/// Each in its module. The functions of the modules its strata.toml\n/// declares `noalloc` are marked so (`deps.noalloc_marked`).\nfn package_decls(\n  disk: std.fs.Disk,\n  dir: String,\n  package: String,\n) -> List[ast.Decl] {\n  rels := deps.module_files(disk, dir)\n  mut out := []\n  for (i, decls) in enumerate(decoded_files(disk, rels.map(rel -> dir + \"/\" + rel))) {\n    m := deps.module_name(package, get(rels, i) ?? \"\")\n    for d in decls {\n      mut out.push(ast.Decl { ..d, module: m })\n    }\n  }\n  deps.noalloc_marked(\n    out,\n    package,\n    deps.noalloc_modules(disk.read(dir + \"/strata.toml\") !! \"\"),\n  )\n}"},{"name":"decoded_files","kind":"fn","old":"a8f59b9167c9cfef","new":"83392101bdfac26e","interface_changed":true,"affected":["package_decls","module_decls","own_decls","read_package","core_unused","core_scope","settings_error","codegen_wi