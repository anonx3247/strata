nion","codegen.check_member","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.show","codegen.shown","codegen.string_builtin","codegen.host","codegen.spawn_expr","codegen.method_value","codegen.foreign_call","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.helper","codegen.debug_body","codegen.read_back","eval_files","codegen.equal","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// A new borrowed variable (nothing drops it) in the variable scope.\n/// Returns its slot.\nfn local(mut g: codegen.Gen, name: String, t: check.Ty) -> String {\n  slot := codegen.fresh(mut g, \"v.\" + name)\n  if g.memory_sites {\n    mut g.slot_stmts.insert(slot, g.root_stmt)\n  }\n  if codegen.has_value(t) {\n    mut g.allocas.push(f\"  {slot} = alloca {codegen.ll(t)}\")\n  }\n  k := codegen.var_scope(g)\n  s := get(g.scopes, k) ?? codegen.no_scope()\n  codegen.set_scope(mut g, k, codegen.Scope { ..s, vars: {\n    mut copy := s.vars\n    mut copy.insert(name, codegen.Local { slot, ty: t })\n    copy\n  } })\n  slot\n}","old_text":"/// A new borrowed variable (nothing drops it) in the variable scope.\n/// Returns its slot.\nfn local(mut g: codegen.Gen, name: String, t: Ty) -> String {\n  slot := codegen.fresh(mut g, \"v.\" + name)\n  if g.memory_sites {\n    mut g.slot_stmts.insert(slot, g.root_stmt)\n  }\n  if codegen.has_value(t) {\n    mut g.allocas.push(f\"  {slot} = alloca {codegen.ll(t)}\")\n  }\n  k := codegen.var_scope(g)\n  s := get(g.scopes, k) ?? codegen.no_scope()\n  codegen.set_scope(mut g, k, codegen.Scope { ..s, vars: {\n    mut copy := s.vars\n    mut copy.insert(name, codegen.Local { slot, ty: t })\n    copy\n  } })\n  slot\n}"},{"name":"codegen.entry","kind":"fn","old":"a5a68b68a253bc08","new":"c303a7df56b1f575","interface_changed":false,"affected":[],"module":"codegen","text":"// ---- functions ----\n\n/// `define i32 @main`: sets up the runtime and calls the program's `main`.\n/// Exit code: 0 for `()`, the value for an `Int`. For a `Result`, `Err` is\n/// printed as `error: …` with code 1.\nfn entry(mut g: codegen.Gen, main: ast.FnDecl) -> String {\n  g.fname = \"main\"\n  codegen.use_rt(mut g, \"strata_init\")\n  ret := codegen.lower(mut g, main.ret)\n  saved := g\n  g.lines = []\n  g.proving = \"\"\n  g.can_unwind = false\n  g.unwinds = false\n  g.unwind_chain = []\n  g.allocas = []\n  g.next = 0\n  g.scopes = [codegen.no_scope()]\n  g.loops = []\n  codegen.block(mut g, \"start\")\n  codegen.emit(\n    mut g,\n    \"call void @strata_init(i32 %argc, ptr %argv)\",\n  )\n  if g.copies {\n    codegen.use_rt(mut g, \"strata_copies_start\")\n    codegen.emit(mut g, \"call void @strata_copies_start()\")\n  }\n  if g.memory_sites {\n    codegen.use_rt(mut g, \"strata_sites_start\")\n    codegen.emit(\n      mut g,\n      \"call void @strata_sites_start(ptr @strata.sites.text)\",\n    )\n  }\n  // `main`'s parameters, filled as `strata run` gives them\n  mut args := []\n  for p in main.params {\n    v := codegen.main_arg(mut g, p)\n    if v.ty is check.TAny {\n      continue\n    }\n    mut args.push(\n      if p.mutable {\n        // a `mut` parameter: its own slot, dropped at the end\n        slot := codegen.fresh(mut g, \"arg\")\n        mut g.allocas.push(f\"  {slot} = alloca {codegen.ll(v.ty)}\")\n        x := codegen.take_value(mut g, v)\n        codegen.store(mut g, x, slot)\n        codegen.own_slot(mut g, codegen.Local { slot, ty: v.ty })\n        codegen.V { ty: check.TStr, op: slot }\n      } else {\n        v\n      },\n    )\n  }\n  r := codegen.call_at(mut g, ret, \"@\\\"strata:main\\\"\", args)\n  match ret {\n    check.TUnit => {\n      codegen.drop_from(mut g, 0, \"\")\n      codegen.emit(mut g, \"ret i32 0\")\n    },\n    check.TInt => {\n      c := codegen.fresh(mut g, \"code\")\n      codegen.emit(mut g, f\"{c} = trunc i64 {r.op} to i32\")\n      codegen.drop_from(mut g, 0, \"\")\n      codegen.emit(mut g, f\"ret i32 {c}\")\n    },\n    check.TNamed { name: \"Result\", args: [ok, err] } => {\n      is_ok := codegen.tag_is(mut g, r, \"Ok\")\n      codegen.emit(\n        mut g,\n        f\"br i1 {is_ok.op}, label %ok, label %err\",\n      )\n      codegen.block(mut g, \"ok\")\n      if ok is check.TInt {\n        v := codegen.field(mut g, r, 0, check.TInt)\n        c := codegen.fresh(mut g, \"code\")\n        codegen.emit(mut g, f\"{c} = trunc i64 {v.op} to i32\")\n        codegen.drop_from(mut g, 0, \"\")\n        codegen.emit(mut g, f\"ret i32 {c}\")\n      } else {\n        codegen.drop_from(mut g, 0, \"\")\n        codegen.emit(mut g, \"ret i32 0\")\n      }\n      codegen.block(mut g, \"err\")\n      e := codegen.field(mut g, r, 0, err)\n      sh := codegen.show(mut g, e)\n      _ := codegen.call(mut g, check.TUnit, \"strata_main_error\", [sh])\n      codegen.drop_from(mut g, 0, \"\")\n      codegen.emit(mut g, \"ret i32 1\")\n    },\n    _ => codegen.not_yet(\n      mut g,\n      \"a `main` that returns a `\" + codegen.key(ret) + \"`\",\n    ),\n  }\n  def := join([\"define i32 @main(i32 %argc, ptr %argv) {\"]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, \"\")\n  def\n}","old_text":"// ---- functions ----\n\n/// `define i32 @main`: sets up the runtime and calls the program's `main`.\n/// Exit code: 0 for `()`, the value for an `Int`. For a `Result`, `Err` is\n/// printed as `error: …` with code 1.\nfn entry(mut g: codegen.Gen, main: ast.FnDecl) -> String {\n  g.fname = \"main\"\n  codegen.use_rt(mut g, \"strata_init\")\n  ret := codegen.lower(mut g, main.ret)\n  saved := g\n  g.lines = []\n  g.proving = \"\"\n  g.can_unwind = false\n  g.unwinds = false\n  g.unwind_chain = []\n  g.allocas = []\n  g.next = 0\n  g.scopes = [codegen.no_scope()]\n  g.loops = []\n  codegen.block(mut g, \"start\")\n  codegen.emit(\n    mut g,\n    \"call void @strata_init(i32 %argc, ptr %argv)\",\n  )\n  if g.copies {\n    codegen.use_rt(mut g, \"strata_copies_start\")\n    codegen.emit(mut g, \"call void @strata_copies_start()\")\n  }\n  if g.memory_sites {\n    codegen.use_rt(mut g, \"strata_sites_start\")\n    codegen.emit(\n      mut g,\n      \"call void @strata_sites_start(ptr @strata.sites.text)\",\n    )\n  }\n  // `main`'s parameters, filled as `strata run` gives them\n  mut args := []\n  for p in main.params {\n    v := codegen.main_arg(mut g, p)\n    if v.ty is TAny {\n      continue\n    }\n    mut args.push(\n      if p.mutable {\n        // a `mut` parameter: its own slot, dropped at the end\n        slot := codegen.fresh(mut g, \"arg\")\n        mut g.allocas.push(f\"  {slot} = alloca {codegen.ll(v.ty)}\")\n        x := codegen.take_value(mut g, v)\n        codegen.store(mut g, x, slot)\n        codegen.own_slot(mut g, codegen.Local { slot, ty: v.ty })\n        codegen.V { ty: TStr, op: slot }\n      } else {\n        v\n      },\n    )\n  }\n  r := codegen.call_at(mut g, ret, \"@\\\"strata:main\\\"\", args)\n  match ret {\n    TUnit => {\n      codegen.drop_from(mut g, 0, \"\")\n      codegen.emit(mut g, \"ret i32 0\")\n    },\n    TInt => {\n      c := codegen.fresh(mut g, \"code\")\n      codegen.emit(mut g, f\"{c} = trunc i64 {r.op} to i32\")\n      codegen.drop_from(mut g, 0, \"\")\n      codegen.emit(mut g, f\"ret i32 {c}\")\n    },\n    TNamed { name: \"Result\", args: [ok, err] } => {\n      is_ok := codegen.tag_is(mut g, r, \"Ok\")\n      codegen.emit(\n        mut g,\n        f\"br i1 {is_ok.op}, label %ok, label %err\",\n      )\n      codegen.block(mut g, \"ok\")\n      if ok is TInt {\n        v := codegen.field(mut g, r, 0, TInt)\n        c := codegen.fresh(mut g, \"code\")\n        codegen.emit(mut g, f\"{c} = trunc i64 {v.op} to i32\")\n        codegen.drop_from(mut g, 0, \"\")\n        codegen.emit(mut g, f\"ret i32 {c}\")\n      } else {\n        codegen.drop_from(mut g, 0, \"\")\n        codegen.emit(mut g, \"ret i32 0\")\n      }\n      codegen.block(mut g, \"err\")\n      e := codegen.field(mut g, r, 0, err)\n      sh := codegen.show(mut g, e)\n      _ := codegen.call(mut g, TUnit, \"strata_main_error\", [sh])\n      codegen.drop_from(mut g, 0, \"\")\n      codegen.emit(mut g, \"ret i32 1\")\n    },\n    _ => codegen.not_yet(\n      mut g,\n      \"a `main` that returns a `\" + codegen.key(ret) + \"`\",\n    ),\n  }\n  def := join([\"define i32 @main(i32 %argc, ptr %argv) {\"]\n    + codegen.entry_block(g.allocas, \"start\")\n    + g.lines\n    + [\"}\\n\"], \"\\n\")\n  codegen.restore(mut g, saved, \"\")\n  def\n}"},{"name":"codegen.function","kind":"fn","old":"e1085d4dc08ca2eb","new":"600813561e84e11a","interface_changed":true,"affected":["codegen.compiled_alone","codegen.generate","codegen_with","core_rt_text","computed_value","repl_eval","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.entry","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// A function's definition `@\"strata:NAME\"`: enters its frame (for the\n/// call stack a fault shows), puts the parameters in slots (borrowed),\n/// compiles the body, and leaves through one exit.\nfn function(\n  mut g: codegen.Gen,\n  f: ast.FnDecl,\n  fkey: String,\n  sub: Dict[String, check.Ty],\n) -> String {\n  g.fname = f.name\n  // a test is shown by its name, which `test_fn` puts first in its doc\n  g.shown_as = if starts_with(f.name, \"test:\") || contains(f.name, \".test:\") {\n    get(f.doc, 0) ?? \"\"\n  } else {\n    \"\"\n  }\n  g.current = fkey\n  g.sub = sub\n  g.in_prelude = starts_with(fkey, \"strata.compiled.\")\n  // prelude functions and tests have no call-stack frame\n  framed := !g.in_prelude && !g.bare && !codegen.is_test_key(fkey)\n  g.lines = []\n  g.proving = \"\"\n  g.allocas = []\n  g.next = 0\n  g.scopes = []\n  g.loops = []\n  // the program's own functions are named as `verify` names them\n  g.proving = if g.in_prelude || fkey != f.name {\n    \"\"\n  } else {\n    f.name\n  }\n  g.can_unwind = true\n  g.unwinds = false\n  g.unwind_chain = []\n  codegen.push_scope(mut g)\n  ret := codegen.lower(mut g, f.ret)\n  g.ret = ret\n  g.ret_w = codegen.written_ty(f.ret, sub, g)\n  g.rets = []\n  // (a small result: given as its words, `by_words`)\n  g.by_words = codegen.by_words(g, codegen.inst_sym(fkey, f, sub), ret)\n  g.rp_ptrs = Dict[String, String] {}\n  g.stack_ops = Set[String] {}\n  mut params := []\n  for p in f.params {\n    t := codegen.lower(mut g, p.ty)\n    if p.mutable {\n      // the caller's slot, written back after the call: read and assigned\n      // through, and dropped here only when an assignment replaces it\n      codegen.local_at(mut g, p.name, t, \"%p.\" + p.name)\n      mut params.push(f\"ptr %p.{p.name}\")\n      // its refinement is checked on each assignment\n      if codegen.needs_check(g, p.ty) {\n        mut g.declared.insert(\"%p.\" + p.name, p.ty)\n      }\n      continue\n    }\n    // the argument itself: never assigned, no slot\n    _ := codegen.local_value(\n      mut g,\n      p.name,\n      codegen.V { ty: t, op: \"%p.\" + p.name },\n    )\n    if codegen.has_value(t) {\n      mut params.push(f\"{codegen.ll(t)} %p.{p.name}\")\n    }\n  }\n  g.bound_slots = Dict[String, List[String]] {}\n  for p in f.params {\n    match p.ty {\n      ast.Named { name: tp, args: [] } => if contains(f.type_params, tp) {\n        mut trs := []\n        for b in f.bounds {\n          if b.param == tp {\n            trs += b.traits.map(t -> codegen.texpr_head(t))\n          }\n        }\n        match codegen.lookup(g, p.name) {\n          Some(l) => if len(trs) > 0 {\n            mut g.bound_slots.insert(l.slot, trs)\n          },\n          None => (),\n        }\n      },\n      _ => (),\n    }\n  }\n  codegen.block(mut g, \"body\")\n  if framed {\n    name := codegen.string(mut g, f.name)\n    _ := codegen.call(\n      mut g,\n      check.TUnit,\n      \"strata_enter\",\n      [codegen.V { ty: check.TStr, op: name }],\n    )\n  }\n  // A step past the budget faults inside the frame just entered.\n  if g.fuzzing && !g.in_prelude {\n    // each call counts against the run's budget\n    codegen.use_rt(mut g, \"strata_step\")\n    codegen.emit(mut g, \"call void @strata_step()\")\n  }\n  if g.tracing && framed {\n    codegen.trace_enter(mut g, f)\n  }\n  // the arguments' refinements, then the preconditions\n  for p in f.params {\n    if codegen.needs_check(g, p.ty)\n      && !codegen.proven_entry(mut g, \"argument \" + p.name) {\n      match codegen.lookup(g, p.name) {\n        Some(l) => {\n          pv := codegen.load(mut g, l)\n          codegen.check_type(\n            mut g,\n            p.ty,\n            pv,\n            f\"argument `{p.name}` of `{f.name}`\",\n            [],\n          )\n        },\n        None => (),\n      }\n    }\n  }\n  for (i, r) in enumerate(f.pre) {\n    if !codegen.proven_entry(mut g, \"requires \" + to_string(i)) {\n      codegen.check_requires(mut g, f, r)\n    }\n  }\n  // values read with `old` by `ensures`, taken on entry\n  codegen.keep_olds(mut g, f)\n  // the `decreases` measure that recursive calls are checked against\n  codegen.decreases_entry(mut g, f)\n  v := if contains(g.externs, fkey) {\n    codegen.foreign_call(mut g, f)\n  } else {\n    g.result_pos = g.by_words\n    codegen.expr_want(mut g, f.body, ret)\n  }\n  if !(v.ty is check.TAny) {\n    codegen.leave_with(mut g, v)\n    codegen.give_result(mut g, codegen.V { ..v, ty: ret })\n  } else {\n    // an unreachable end still jumps to the exit\n    codegen.give_result(mut g, codegen.V { ty: ret, op: \"poison\" })\n  }\n  codegen.br(mut g, \"exit\")\n  codegen.block(mut g, \"exit\")\n  // at the exit: the result's type, then the postconditions\n  words := codegen.result_phi(mut g, ret)\n  // the result as a block, for its checks: the block given, or the words\n  // on the stack\n  result := if g.by_words\n    && (codegen.needs_check(g, f.ret)\n      || len(f.post) > 0\n      || g.tracing && framed) {\n    codegen.V {\n      ty: ret,\n      op: codegen.held_words(mut g, ret, words.op),\n    }\n  } else {\n    words\n  }\n  // the parameters stay visible to the postconditions; nothing is dropped\n  g.scopes = [\n    codegen.Scope { ..get(g.scopes, 0) ?? codegen.no_scope(), owned: [], temps: [], tasks: \"\" },\n  ]\n  if codegen.needs_check(g, f.ret) {\n    codegen.check_type(\n      mut g,\n      f.ret,\n      result,\n      f\"result of `{f.name}`\",\n      [],\n    )\n  }\n  if len(f.post) > 0 {\n    codegen.push_scope(mut g)\n    _ := codegen.local_value(mut g, \"it\", result)\n    // `result` names it for the postconditions\n    _ := codegen.local_value(mut g, \"result\", result)\n    for en in f.post {\n      if !codegen.proven(\n        mut g,\n        \"ensures \" + text.expr_text(en, 0),\n        \"same\",\n      ) {\n        codegen.check_ensures(mut g, f, en, result)\n      }\n    }\n    codegen.discard_scope(mut g)\n  }\n  // release the values held for `old`\n  for o in g.olds {\n    codegen.drop_value(mut g, o.2)\n  }\n  g.olds = []\n  if g.tracing && framed {\n    codegen.trace_leave(mut g, f.name, result)\n  }\n  mut tail := []\n  if framed {\n    codegen.use_rt(mut g, \"strata_leave\")\n    mut tail.push(\"  call void @strata_leave()\")\n  }\n  mut tail.push(\n    if codegen.has_value(ret) {\n      f\"  ret {codegen.result_ll(g, codegen.inst_sym(fkey, f, sub), ret)} %result\"\n    } else {\n      \"  ret void\"\n    },\n  )\n  tail += codegen.unwound_exit(mut g, ret, framed)\n  ps := join(params, \", \")\n  // Very long functions (tables like `std.unicode_tables`) are compiled at\n  // -O0: LLVM's instruction selection at -O2 takes minutes on them.\n  attrs := if len(g.lines) > 1000 {\n    \" noinline optnone\"\n  } else {\n    \"\"\n  }\n  head := f\"define {codegen.result_ll(g, codegen.inst_sym(fkey, f, sub), ret)} {codegen.inst_sym(fkey, f, sub)}({ps}){attrs} {{\"\n  g.by_words = false\n  join([head]\n    + codegen.entry_block(g.allocas, \"body\")\n    + g.lines\n    + tail\n    + [\"}\\n\"], \"\\n\")\n}","old_text":"/// A function's definition `@\"strata:NAME\"`: enters its frame (for the\n/// call stack a fault shows), puts the parameters in slots (borrowed),\n/// compiles the body, and leaves through one exit.\nfn function(\n  mut g: codegen.Gen,\n  f: ast.FnDecl,\n  fkey: String,\n  sub: Dict[String, Ty],\n) -> String {\n  g.fname = f.name\n  // a test is shown by its name, which `test_fn` puts first in its doc\n  g.shown_as =