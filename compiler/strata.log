n      f := eval.float_of(a)!\n      r := match name {\n        \"floor\" => checked_floor(f),\n        \"ceil\" => checked_ceil(f),\n        _ => checked_round(f),\n      }\n      match r {\n        Some(n) => Ok(ast.IntLit(n)),\n        None => Err(\n          eval.runtime(\n            text.plain_float(f) + \" is not a whole number\",\n          ),\n        ),\n      }\n    },\n    \"checked_add\" | \"checked_sub\" | \"checked_mul\" | \"checked_div\" | \"checked_rem\" => {\n      (x, y) := (eval.float_of(a)!, eval.float_of(b)!)\n      r := match name {\n        \"checked_add\" => checked_add(x, y),\n        \"checked_sub\" => checked_sub(x, y),\n        \"checked_mul\" => checked_mul(x, y),\n        \"checked_div\" => checked_div(x, y),\n        _ => checked_rem(x, y),\n      }\n      Ok(eval.option(match r {\n        Some(f) => Some(ast.FloatLit(f)),\n        None => None,\n      }))\n    },\n    \"checked_sqrt\" => Ok(eval.option(match checked_sqrt(eval.float_of(a)!) {\n      Some(f) => Some(ast.FloatLit(f)),\n      None => None,\n    })),\n    \"checked_floor\" | \"checked_ceil\" | \"checked_round\" => {\n      x := eval.float_of(a)!\n      r := match name {\n        \"checked_floor\" => checked_floor(x),\n        \"checked_ceil\" => checked_ceil(x),\n        _ => checked_round(x),\n      }\n      Ok(eval.option(match r {\n        Some(n) => Some(ast.IntLit(n)),\n        None => None,\n      }))\n    },\n    \"sqrt\" => {\n      f := eval.float_of(a)!\n      match checked_sqrt(f) {\n        Some(r) => Ok(ast.FloatLit(r)),\n        None => Err(eval.runtime(\n          \"sqrt of negative number \" + text.plain_float(f),\n        )),\n      }\n    },\n    \"map\" => {\n      mut out := []\n      for x in eval.list_of(a)! {\n        mut out.push(eval.apply(mut st, w, b, [x])!)\n      }\n      Ok(ast.ListExpr(out))\n    },\n    \"filter\" => {\n      mut out := []\n      for x in eval.list_of(a)! {\n        if eval.truth(eval.apply(mut st, w, b, [x])!)! {\n          mut out.push(x)\n        }\n      }\n      Ok(ast.ListExpr(out))\n    },\n    \"fold\" => {\n      mut acc := b\n      for x in eval.list_of(a)! {\n        acc = eval.apply(mut st, w, c, [acc, x])!\n      }\n      Ok(acc)\n    },\n    \"all\" => {\n      for x in eval.list_of(a)! {\n        if !eval.truth(eval.apply(mut st, w, b, [x])!)! {\n          return Ok(ast.BoolLit(false))\n        }\n      }\n      Ok(ast.BoolLit(true))\n    },\n    \"any\" => {\n      for x in eval.list_of(a)! {\n        if eval.truth(eval.apply(mut st, w, b, [x])!)! {\n          return Ok(ast.BoolLit(true))\n        }\n      }\n      Ok(ast.BoolLit(false))\n    },\n    \"find\" => {\n      for x in eval.list_of(a)! {\n        if eval.truth(eval.apply(mut st, w, b, [x])!)! {\n          return Ok(eval.some(x))\n        }\n      }\n      Ok(eval.none())\n    },\n    \"count\" => {\n      mut n := 0\n      for x in eval.list_of(a)! {\n        if eval.truth(eval.apply(mut st, w, b, [x])!)! {\n          n += 1\n        }\n      }\n      Ok(ast.IntLit(n))\n    },\n    \"push\" => Ok(ast.ListExpr(eval.list_of(a)! + [b])),\n    \"take\" => Ok(ast.ListExpr(take(eval.list_of(a)!, eval.int_of(b)!))),\n    \"drop\" => Ok(ast.ListExpr(drop(eval.list_of(a)!, eval.int_of(b)!))),\n    \"slice\" => Ok(ast.ListExpr(\n      eval.sliced(\n        eval.list_of(a)!,\n        eval.int_of(b)!,\n        eval.int_of(c)!,\n      ),\n    )),\n    \"sum\" => {\n      xs := eval.list_of(a)!\n      match get(xs, 0) {\n        Some(ast.FloatLit(_)) => {\n          mut t := 0.0\n          for x in xs {\n            f := eval.float_of(x)!\n            t = match checked_add(t, f) {\n              Some(r) => r,\n              None => return Err(eval.not_finite(t, \"+\", f)),\n            }\n          }\n          Ok(ast.FloatLit(t))\n        },\n        _ => {\n          mut t := 0\n          for x in xs {\n            t += eval.int_of(x)!\n          }\n          Ok(ast.IntLit(t))\n        },\n      }\n    },\n    \"range\" => Ok(ast.ListExpr(eval.ints(eval.int_of(a)!, eval.int_of(b)!))),\n    \"compare\" => Ok(ast.IntLit(eval.compare(w, a, b))),\n    \"abs\" => match a {\n      ast.FloatLit(f) => Ok(ast.FloatLit(abs(f))),\n      _ => Ok(ast.IntLit(abs(eval.int_of(a)!))),\n    },\n    \"min\" => Ok(if eval.compare(w, b, a) < 0 {\n      b\n    } else {\n      a\n    }),\n    \"max\" => Ok(if eval.compare(w, b, a) > 0 {\n      b\n    } else {\n      a\n    }),\n    // with std.regex's engine, as compiled code\n    \"matches\" => match std.regex.full_match(eval.str_of(a)!, eval.str_of(b)!) {\n      Ok(m) => Ok(ast.BoolLit(m)),\n      Err(e) => Err(eval.runtime(\"bad regex: \" + e)),\n    },\n    \"starts_with\" => Ok(ast.BoolLit(starts_with(eval.str_of(a)!, eval.str_of(b)!))),\n    \"ends_with\" => Ok(ast.BoolLit(ends_with(eval.str_of(a)!, eval.str_of(b)!))),\n    \"chars\" => Ok(eval.str_list(eval.str_of(a)!.chars())),\n    \"index_of\" => Ok(\n      eval.option(match index_of(eval.str_of(a)!, eval.str_of(b)!) {\n        Some(n) => Some(ast.IntLit(n)),\n        None => None,\n      }),\n    ),\n    \"byte_slice\" => Ok(ast.StrLit(\n      byte_slice(eval.str_of(a)!, eval.int_of(b)!, eval.int_of(c)!),\n    )),\n    \"replace\" => Ok(ast.StrLit(\n      replace(eval.str_of(a)!, eval.str_of(b)!, eval.str_of(c)!),\n    )),\n    \"repeat\" => Ok(ast.StrLit(repeat(eval.str_of(a)!, eval.int_of(b)!))),\n    \"to_upper\" => Ok(ast.StrLit(to_upper(eval.str_of(a)!))),\n    \"to_lower\" => Ok(ast.StrLit(to_lower(eval.str_of(a)!))),\n    \"is_digit\" => Ok(ast.BoolLit(is_digit(eval.str_of(a)!))),\n    \"is_alpha\" => Ok(ast.BoolLit(is_alpha(eval.str_of(a)!))),\n    \"is_space\" => Ok(ast.BoolLit(is_space(eval.str_of(a)!))),\n    \"byte_len\" => Ok(ast.IntLit(byte_len(eval.str_of(a)!))),\n    \"byte_at\" => {\n      s := eval.str_of(a)!\n      i := eval.int_of(b)!\n      if i < 0 || i >= byte_len(s) {\n        return Err(eval.runtime(\"byte \"\n          + to_string(i)\n          + \" out of range (length \"\n          + to_string(byte_len(s))\n          + \")\"))\n      }\n      Ok(ast.IntLit(byte_at(s, i)))\n    },\n    \"ord\" => {\n      s := eval.str_of(a)!\n      cps := s.code_points().to_list()\n      match cps {\n        [x] => Ok(ast.IntLit(x)),\n        _ => Err(eval.runtime(\n          \"ord needs a single character, got \" + eval.quoted(s),\n        )),\n      }\n    },\n    \"chr\" => {\n      n := eval.int_of(a)!\n      if n < 0 || n > 1114111 || n >= 55296 && n <= 57343 {\n        return Err(\n          eval.runtime(\n            \"chr: \" + to_string(n) + \" is not a character\",\n          ),\n        )\n      }\n      Ok(ast.StrLit(chr(n)))\n    },\n    _ => Err(eval.runtime(\n      \"the built-in `\" + name + \"` isn't run by this evaluator yet\",\n    )),\n  }\n}","old_text":"fn builtin(\n  mut st: eval.State,\n  w: eval.World,\n  given: String,\n  vs: List[ast.Expr],\n) -> Result[ast.Expr, eval.Escape] {\n  // (`xs.sorted()` is what `sort` was: a new list)\n  name := builtins.internal_name(given)\n  // an iterator where a list is wanted: its elements (`join(s.graphemes(), \"\")`)\n  a := match eval.arg(vs, 0) {\n    ast.CtorExpr { .. } => if eval.method_of(w, eval.arg(vs, 0), \"next\") is Some\n      && !(name == \"to_string\" || name == \"debug\" || name == \"print\") {\n      ast.ListExpr(eval.elements(mut st, w, eval.arg(vs, 0))!)\n    } else {\n      eval.arg(vs, 0)\n    },\n    x => x,\n  }\n  b := eval.arg(vs, 1)\n  c := eval.arg(vs, 2)\n  match eval.conversion(name, a) {\n    Some(r) => return r,\n    None => (),\n  }\n  match name {\n    \"print\" => {\n      st.out += eval.display(mut st, w, a)! + \"\\n\"\n      Ok(ast.UnitExpr)\n    },\n    // what std reaches the system through: the run's own output and arguments\n    \"host_write\" => {\n      if a == ast.IntLit(2) {\n        st.err += eval.str_of(b)!\n      } else {\n        st.out += eval.str_of(b)!\n      }\n      Ok(ast.UnitExpr)\n    },\n    \"host_args\" => Ok(eval.str_list(