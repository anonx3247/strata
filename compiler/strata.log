s) {\n    l := codegen.label(mut g, \"member\")\n    mut labels.push(l)\n    if k + 1 < len(ms) {\n      next := codegen.label(mut g, \"member.next\")\n      ok := codegen.holds_member(mut g, v, m)\n      codegen.emit(\n        mut g,\n        f\"br i1 {ok.op}, label %{l}, label %{next}\",\n      )\n      codegen.block(mut g, next)\n    } else {\n      codegen.br(mut g, l)\n    }\n  }\n  labels\n}"},{"name":"codegen.union_text","kind":"fn","old":"1116a03ba6895562","new":"8f000d84a3bb2102","interface_changed":true,"affected":["codegen.helper","codegen.show","codegen.shown","codegen.equal","codegen.entry","codegen.interp","codegen.builtin","codegen.string_builtin","codegen.format_spec","codegen.dyn_wrapper","codegen.destructure","codegen.debug_fields","codegen.for_loop","codegen.debug_list","codegen.checked","codegen.fail_unless","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.fuzz_driver","codegen.trace_enter","codegen.trace_leave","codegen.type_check","codegen.matching_v","codegen.index_check","codegen.checked_update","codegen.decreases_fault","codegen.apply","codegen.eq_fields","codegen.matches","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.generate","codegen.expr_node","codegen.call_named","codegen.builtin_call","codegen.push_in_place","codegen.vtable","codegen.stmt_node","codegen.debug_body","codegen.assertion","codegen.invariants","codegen.check_union","codegen.check_member","codegen.construct_want","codegen.has_field_check","codegen.function","codegen.declare","codegen.call_fn_want","codegen.check_payload","codegen.check_field","codegen.assign_at","codegen.lambda_shown","codegen.set_in_place","codegen.method_call","codegen.matching_want","codegen.list_builtin","codegen.decreases_pass","codegen.decreases_call","codegen.binary","codegen.number_builtin","codegen.eq_body","codegen.binds","codegen.match_got","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen_with","core_rt_text","computed_value","