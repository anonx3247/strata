ly_change","apply_edit","fix_loops","with_base","codegen.foreign_call","codegen.generated_args","codegen.makers","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// `eq` of two union values: the same member and equal values.\nfn union_eq(\n  mut g: codegen.Gen,\n  a: codegen.V,\n  b: codegen.V,\n  ms: List[check.Ty],\n) {\n  labels := codegen.on_members(mut g, a, ms)\n  for (k, m) in enumerate(ms) {\n    codegen.block(mut g, get(labels, k) ?? \"\")\n    ok := codegen.holds_member(mut g, b, m)\n    (yes, no) := (codegen.label(mut g, \"same\"), codegen.label(mut g, \"other\"))\n    codegen.emit(mut g, f\"br i1 {ok.op}, label %{yes}, label %{no}\")\n    codegen.block(mut g, no)\n    codegen.emit(mut g, \"ret i1 false\")\n    codegen.block(mut g, yes)\n    (xa, xb) := (codegen.narrow(mut g, a, m), codegen.narrow(mut g, b, m))\n    e := codegen.equal(mut g, xa, xb)\n    codegen.emit(mut g, f\"ret i1 {e.op}\")\n  }\n}","old_text":"/// `eq` of two union values: the same member and equal values.\nfn union_eq(mut g: codegen.Gen, a: codegen.V, b: codegen.V, ms: List[Ty]) {\n  labels := codegen.on_members(mut g, a, ms)\n  for (k, m) in enumerate(ms) {\n    codegen.block(mut g, get(labels, k) ?? \"\")\n    ok := codegen.holds_member(mut g, b, m)\n    (yes, no) := (codegen.label(mut g, \"same\"), codegen.label(mut g, \"other\"))\n    codegen.emit(mut g, f\"br i1 {ok.op}, label %{yes}, label %{no}\")\n    codegen.block(mut g, no)\n    codegen.emit(mut g, \"ret i1 false\")\n    codegen.block(mut g, yes)\n    (xa, xb) := (codegen.narrow(mut g, a, m), codegen.narrow(mut g, b, m))\n    e := codegen.equal(mut g, xa, xb)\n    codegen.emit(mut g, f\"ret i1 {e.op}\")\n  }\n}"},{"name":"codegen.union_cmp","kind":"fn","old":"e3c0f5d69a1f4962","new":"2eaece3427ed6b25","interface_changed":true,"affected":["codegen.cmp_helper","codegen.order_closure","codegen.cmp_fields","codegen.slot_fn",