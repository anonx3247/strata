package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","rename_command","move_command","fix_command","edit_in_editor"],"module":"toolchain","text":"/// Links with lld. What the library calls of the runtime is found in the\n/// process that loads it.\npub fn shared_library(\n  objects: List[String],\n  out: String,\n  system: String,\n  install_name: String,\n) -> Result[(), String] {\n  if toolchain.toolchain_link(join(toolchain.lld_base(system)\n    + [\n      \"-dylib\",\n      \"-undefined\",\n      \"dynamic_lookup\",\n      \"-install_name\",\n      install_name,\n      \"-o\",\n      out,\n    ]\n    + objects, \"\\n\")).to_int(\n  ) == 0 {\n    Ok(())\n  } else {\n    Err(\"the linker (lld) failed on \" + out)\n  }\n}","old_text":"/// Links with lld. What the library calls of the runtime is found in the\n/// process that loads it.\npub fn shared_library(\n  mut files: std.fs.Files,\n  objects: List[String],\n  out: String,\n  system: String,\n  install_name: String,\n) -> Result[(), String] {\n  if toolchain.toolchain_link(join(toolchain.lld_base(system)\n    + [\n      \"-dylib\",\n      \"-undefined\",\n      \"dynamic_lookup\",\n      \"-install_name\",\n      install_name,\n      \"-o\",\n      out,\n    ]\n    + objects, \"\\n\")).to_int(\n  ) == 0 {\n    Ok(())\n  } else {\n    Err(\"the linker (lld) failed on \" + out)\n  }\n}"},{"name":"toolchain.lld","kind":"fn","old":"043565cc5529f80d","new":"8770ff7b168ba4ff","interface_changed":true,"affected":["link_command","command_line","main","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","diff_command","with_base","rename_command","move_command","fix_command","edit_in_editor"],"module":"toolchain","text":"/// lld's Mach-O linker on `args` (`compiler link ARG...`).\npub fn lld(args: List[String]) -> Result[(), String] {\n  if toolchain.toolchain_link(join([\"ld64.lld\"] + args, \"\\n\")).to_int() == 0 {\n    Ok(())\n  } else {\n    Err(toolchain.toolchain_error())\n  }\n}","old_text":"/// lld's Mach-O linker on `args` (`compiler link ARG...`).\npub fn lld(mut files: std.fs.Files, args: List[String]) -> Result[(), String] {\n  if toolchain.toolchain_link(join([\"ld64.lld\"] + args, \"\\n\")).to_int() == 0 {\n    Ok(())\n  } else {\n    Err(toolchain.toolchain_error())\n  }\n}"},{"name":"toolchain.objects","kind":"fn","old":"60b1db9c10f6e5a6","new":"949f8a9519c81137","interface_changed":true,"affected":["program_objects","linked","build_command","strata_command","command_line","main","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","check_command","verify_command","run_command","static_graph","comptime_values","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","expanded","comptime_runner","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","diff_command","with_base","rename_command","move_command","fix_command","edit_in_editor"],"module":"toolchain","text":"/// Compiles in this process at `opt` (0-3). The IR is cut into parts (runs\n/// of whole functions, each with what it needs of the rest), compiled in\n/// parallel, one thread a core. Each part's object is kept in `cache` under\n/// the SHA-256 of its text, so an unchanged part isn't compiled again. With\n/// `cache` \"\", nothing is kept and the objects go in `scratch`. The objects\n/// come in the parts' order however the threads finish, so the same IR\n/// makes the same executable.\npub fn objects(\n  ir: String,\n  scratch: String,\n  cache: String,\n  opt: Int,\n) -> Result[toolchain.Objects, String] {\n  n := toolchain.toolchain_objects(\n    ir,\n    scratch,\n    cache,\n    opt.wrap_i32(),\n    0.wrap_i32(),\n  ).to_int(\n  )\n  if n < 0 {\n    Err(toolchain.toolchain_error())\n  } else {\n    Ok(toolchain.Objects {\n      files: lines(toolchain.toolchain_objects_list()).filter(x -> x != \"\"),\n      compiled: toolchain.toolchain_objects_compiled().to_int(),\n    })\n  }\n}","old_text":"/// Compiles in this process at `opt` (0-3). The IR is cut into parts (runs\n/// of whole functions, each with what it needs of the rest), compiled in\n/// parallel, one thread a core. Each part's object is kept in `cache` under\n/// the SHA-256 of its text, so an unchanged part isn't compiled again. With\n/// `cache` \"\", nothing is kept and the objects go in `scratch`. The objects\n/// come in the parts' order however the threads finish, so the same IR\n/// makes the same executable.\npub fn objects(\n  mut files: std.fs.Files,\n  ir: String,\n  scratch: String,\n  cache: String,\n  opt: Int,\n) -> Result[toolchain.Objects, String] {\n  n := toolchain.toolchain_objects(\n    ir,\n    scratch,\n    cache,\n    opt.wrap_i32(),\n    0.wrap_i32(),\n  ).to_int(\n  )\n  if n < 0 {\n    Err(toolchain.toolchain_error())\n  } else {\n    Ok(toolchain.Objects {\n      files: lines(toolchain.toolchain_objects_list()).filter(x -> x != \"\"),\n      compiled: toolchain.toolchain_objects_compiled().to_int(),\n    })\n  }\n}"}]}
{"id":"472a53082b152c43","time":1795657440,"message":"remove unused parameters (second round)","changes":[{"name":"diff.diff","kind":"fn","old":"1a2d198c485a8d49","new":"d2f9a4f11c8f6a9b","interface_changed":false,"affected":[],"module":"diff","text":"pub fn diff[F: std.fs.Files](\n  files: F,\n  verdicts: diff.Verdicts,\n  old: List[ast.Decl],\n  new: List[ast.Decl],\n  recorded: List[(String, String)],\n  steps: List[(Int, List[String])],\n  std: List[ast.Decl],\n  core: builtins.Core,\n) -> diff.Diff {\n  // each side's dependency graph and code hashes, only if there are\n  // verdicts to look up\n  looking := verdicts.root is Some\n  hashes := (p: List[ast.Decl]) -> dict(p.map(\n    d -> (diff.qname(d), codebase.short_hex(binary.code_hash(d))),\n  ))\n  old_graph := if looking {\n    store.graph(resolve.stored(old, std, core), false)\n  } else {\n    Dict[String, List[String]] {}\n  }\n  // what refers to what, from each side as stored; as written, a name an\n  // import shortens is not qualified\n  new_graph := store.graph(resolve.stored(new, std, core), false)\n  old_hashes := if looking {\n    hashes(old)\n  } else {\n    Dict[String, String] {}\n  }\n  new_hashes := if looking {\n    hashes(new)\n  } else {\n    Dict[String, String] {}\n  }\n  closure_old := (n: String) -> if looking {\n    diff.closure_hash(old_graph, old_hashes, n)\n  } else {\n    \"\"\n  }\n  closure_new := (n: String) -> if looking {\n    diff.closure_hash(new_graph, new_hashes, n)\n  } else {\n    \"\"\n  }\n  // renames of a variant, trait method or field: (from, to, kind, owning definition)\n  mut members := []\n  for (f, t) in recorded {\n    match refactor.member(old, f) {\n      Some((k, _)) => if (k == \"variant\" || k == \"method\" || k == \"field\")\n        && refactor.member(new, t) is Some {\n        match refactor.owner(old, f) {\n          Some(o) => mut members.push((f, t, k, o)),\n          None => (),\n        }\n      },\n      None => (),\n    }\n  }\n  owners := set(members.map(m -> m.3))\n  renames := diff.effective_renames(old, new, recorded)\n  // code that only follows a rename: definitions' and members' short names\n  substitutions := renames + members.map(m -> (m.0, m.1))\n  om := dict(old.map(d -> (diff.qname(d), d)))\n  nm := dict(new.map(d -> (diff.qname(d), d)))\n  renamed_to := dict(renames.map(r -> (r.1, r.0)))\n  renamed_from := set(renames.map(r -> r.0))\n  // pairs (old, new) in the new program's order, then removals\n  mut pairs := []\n  for d in new {\n    q := diff.qname(d)\n    match get(om, q) {\n      Some(o) => if binary.hash(o) != binary.hash(d) {\n        mut pairs.push((Some(o), Some(d), d))\n      },\n      None => match get(renamed_to, q) {\n        Some(f) => mut pairs.push((get(om, f), Some(d), d)),\n        None => mut pairs.push((None, Some(d), d)),\n      },\n    }\n  }\n  for d in old {\n    if !contains(nm, diff.qname(d))\n      && !contains(renamed_from, diff.qname(d)) {\n      mut pairs.push((Some(d), None, d))\n    }\n  }\n  // definitions that only follow a rename are folded into it\n  mut refs_of := Dict[String, List[String]] {}\n  mut ref_only := Set[String] {}\n  if len(substitutions) > 0 {\n    for (po, pn, _) in pairs {\n      match (po, pn) {\n        (Some(o), Some(n)) => {\n          // the type or trait that declares a renamed member is shown, not folded\n          if diff.qname(o) != diff.qname(n)\n            || diff.prose(o) != diff.prose(n)\n            || contains(owners, diff.qname(o)) {\n            continue\n          }\n          oc := diff.code(o)\n          nc := diff.code(n)\n          ot := merge.tokens(oc)\n          nt := merge.tokens(nc)\n          for (f, t) in substitutions {\n            if contains(ot, refactor.short(f))\n              && contains(nt, refactor.short(t)) {\n              mut refs_of.insert(\n                t,\n                (get(refs_of, t) ?? []) + [diff.qname(n)],\n              )\n            }\n          }\n          if diff.substitute(oc, substitutions) == nc {\n            mut ref_only.insert(diff.qname(n))\n          }\n        },\n        _ => (),\n      }\n    }\n  }\n  mut items := []\n  mut added := 0\n  mut removed := 0\n  mut renamed := 0\n  mut changed := 0\n  mut iface := 0\n  for (po, pn, d) in pairs {\n    p := (po, pn)\n    q := diff.qname(d)\n    if contains(ref_only, q) {\n      continue\n    }\n    kind := diff.kind_str(d)\n    mut mk := \"\"\n    mut what := []\n    mut shown := []\n    mut interface_changed := true\n    mut rewritten := false\n    match p {\n      (None, Some(n)) => {\n        added += 1\n        mk = \"add\"\n        what = [\"added\"]\n        shown = lines(diff.code(n)).map(l -> diff.Line { s: \"+\", text: l })\n      },\n      (Some(o), None) => {\n        removed += 1\n        mk = \"del\"\n        what = [\"removed\"]\n        shown = lines(diff.code(o)).map(l -> diff.Line { s: \"-\", text: l })\n      },\n      (Some(o), Some(n)) => {\n        is_rename := diff.qname(o) != diff.qname(n)\n        interface_changed = is_rename\n          || binary.interface_hash(o) != binary.interface_hash(n)\n        oc := diff.code(o)\n        nc := diff.code(n)\n        (ls, rw) := diff.line_diff(oc, nc)\n        rewritten = rw\n        ls2 := diff.annotate(ls, oc, kind, if is_rename {\n          []\n        } else {\n          renames\n        })\n        // a move keeps the short name and changes the module\n        moved := is_rename\n          && refactor.short(diff.qname(o)) == refactor.short(diff.qname(n))\n        what = if moved {\n          [\"moved from `\"\n            + if o.module == \"\" {\n              \"main\"\n            } else {\n              o.module\n            }\n            + \"`\"]\n        } else if is_rename {\n          [\"renamed from `\" + refactor.short(diff.qname(o)) + \"`\"]\n        } else {\n          []\n        }\n        // a rename alone changes only the name\n        mut rest := if is_rename {\n          diff.substitute(oc, renames) != nc\n            || diff.prose(o) != diff.prose(n)\n        } else {\n          true\n        }\n        // a renamed member: say so, then whatever else changed, compared with the\n        // old definition with the rename applied\n        if !is_rename {\n          for (f, t, k, ow) in members {\n            if ow != q {\n              continue\n            }\n            mut what.push(\n              k\n                + \" `\"\n                + refactor.short(f)\n                + \"` renamed to `\"\n                + refactor.short(t)\n                + \"`\",\n            )\n            o2 := match refactor.rename_all(old, [(f, refactor.short(t))]) {\n              Ok(r) => r.find(x -> diff.qname(x) == q),\n              Err(_) => None,\n            }\n            match o2 {\n              Some(x) => if !(diff.code(x) == nc && diff.prose(x) == diff.prose(n)) {\n                what += diff.change_words(x, n)\n              },\n              None => {\n                what += diff.change_words(o, n)\n              },\n            }\n            rest = false\n          }\n        }\n        if rest {\n          ws := diff.change_words(o, n)\n          if !(is_rename\n            && ws == [\"signature changed\"]\n            && diff.substitute(oc, renames) == nc) {\n            what += ws\n          }\n        }\n        if is_rename {\n          renamed += 1\n        } else {\n          changed += 1\n        }\n        if interface_changed {\n          iface += 1\n        }\n        mk = if is_rename {\n          \"ren\"\n        } else {\n          \"chg\"\n        }\n        shown = diff.fold_lines(ls2, kind)\n      },\n      _ => (),\n    }\n    // for the reader: what uses it directly, and how much depends on it in all\n    users := keys(new_graph)\n      .filter(x -> x != q && contains(get(new_graph, x) ?? [], q))\n      .sorted()\n    total := len(codebase.dependents(new_graph, q))\n    mut detail := []\n    if rewritten {\n      mut detail.push(\n        \"most of it changed, so it is shown as a line diff\",\n      )\n    }\n    only_renamed := mk == \"ren\" && len(what) == 1\n    member_only := contains(owners, q)\n      && what.all(w -> contains(w, \"` renamed to `\"))\n    if member_only {\n      r := sum(members\n        .filter(m -> m.3 == q)\n        .map(m -> len(get(refs_of, m.1) ?? [])))\n      mut detail.push(\n        f\"only a name changed · {r} reference{diff.plural(r)} updated\",\n      )\n    } else if only_renamed {\n      r := len(get(refs_of, q) ?? [])\n      what_changed := if starts_with(get(what, 0) ?? \"\", \"moved\") {\n        \"its module\"\n      } else {\n        \"the name\"\n      }\n      mut detail.push(\n        f\"only {what_changed} changed · {r} reference{diff.plural(r)} updated\",\n      )\n    } else if what == [\"doc changed\"] || what == [\"comments changed\"] {\n      mut detail.push(\n        \"only the \"\n          + if what == [\"doc changed\"] {\n            \"doc\"\n          } else {\n            \"comments\"\n          }\n          + \" changed · interface unchanged\",\n      )\n    } else if mk == \"chg\" && kind == \"impl\" {\n      match d.kind {\n        ast.ImplDef(i) => mut detail.push(\n          if i.trait_name == \"\" {\n            \"methods of `\"\n              + refactor.short(diff.type_head(i.for_type))\n              + \"` · checked against the contracts of the traits they serve\"\n          } else {\n            \"implementation of `\"\n              + refactor.short(i.trait_name)\n              + \"` · checked against its contracts\"\n          },\n        ),\n        _ => (),\n      }\n    } else if mk == \"chg\" || mk == \"ren\" {\n      if kind == \"trait\"\n        && what.any(\n          w -> contains(w, \"added\") || contains(w, \"stronger\"),\n        ) {\n        impls := len(new.filter(\n          x -> match x.kind {\n            ast.ImplDef(i) => refactor.short(i.trait_name) == refactor.short(q),\n            _ => false,\n          },\n        ))\n        mut detail.push(\n          f\"every implementation must follow · {impls} in the codebase\",\n        )\n      } else if interface_changed && kind != \"test\" {\n        mut detail.push(\n          if len(users) == 0 {\n            \"interface changed · nothing uses it\"\n          } else {\n            \"interface changed · used by \"\n              + f\"{len(users)}\"\n              + if total > len(users) {\n                f\", {total} depend on it in all\"\n              } else {\n                \"\"\n              }\n          },\n        )\n      } else if kind != \"test\" {\n        mut detail.push(\n          \"implementation only · nothing else needs re-checking\",\n        )\n      }\n    }\n    if mk == \"add\" {\n      match p {\n        (_, Some(n)) => if len(n.doc) > 0 {\n          mut detail.push(diff.prose(n))\n        },\n        _ => (),\n      }\n    }\n    doc_diff := match p {\n      (Some(o), Some(n)) => if diff.prose(o) != diff.prose(n) {\n        Some(diff.segments(diff.prose(o), diff.prose(n)))\n      } else {\n        None\n      },\n      _ => None,\n    }\n    owned := [diff.qname(x) for x in [p.0, p.1] where x is Some for x in [x ?? d]]\n    affected := if interface_changed\n      && p.0 is Some\n      && p.1 is Some\n      && kind != \"impl\" {\n      users.map(\n        x -> (x, pairs.any(\n          y -> match y.1 {\n            Some(nn) => diff.qname(nn) == x,\n            None => false,\n          },\n        )),\n      )\n    } else {\n      []\n    }\n    mut items.push(\n      diff.Item {\n        section: diff.section(kind, mk, interface_changed),\n        id: q,\n        mk,\n        what,\n        detail,\n        doc_diff,\n        lines: shown,\n        refs: get(refs_of, q) ?? [],\n        old_id: match p.0 {\n          Some(o) => Some(diff.qname(o)),\n          None => None,\n        },\n        label: match p {\n          (Some(o), Some(n)) => if diff.qname(o) != diff.qname(n) {\n            diff.label_of(o) + \" → \" + diff.label_of(n)\n          } else {\n            diff.label_of(d)\n          },\n          _ => diff.label_of(d),\n        },\n        kind,\n        module: d.module,\n        doc: match p.1 {\n          Some(n) => Some(diff.prose(n)),\n          None => None,\n        },\n        rewritten,\n        interface_changed,\n        affected,\n        affected_total: if affected == [] {\n          0\n        } else {\n          total\n        },\n        refs_folded: (get(refs_of, q) ?? []).filter(x -> contains(ref_only, x)),\n        steps: [s.0 for s in steps where s.1.any(x -> owned.contains(x))],\n        verdict_before: match p.0 {\n          Some(o) => Some(diff.verdict_word(diff.verdict_of(\n            files,\n            verdicts,\n            closure_old(diff.qname(o)),\n          ))),\n          None => None,\n        },\n        verdict_after: match p.1 {\n          Some(n) => Some(diff.verdict_word(diff.verdict_of(\n            files,\n            verdicts,\n            closure_new(diff.qname(n)),\n          ))),\n          None => None,\n        },\n      },\n    )\n  }\n  // verification before and after: what changed, and dependents whose result changed\n  mut checks := []\n  mut rechecked_same := 0\n  for d in new {\n    q := diff.qname(d)\n    oq := get(renamed_to, q) ?? q\n    before_hash := if contains(om, oq) {\n      Some(closure_old(oq))\n    } else {\n      None\n    }\n    after_hash := closure_new(q)\n    if before_hash == Some(after_hash) {\n      continue\n    }\n    b := match before_hash {\n      Some(h) => diff.verdict_of(files, verdicts, h),\n      None => None,\n    }\n    a := diff.verdict_of(files, verdicts, after_hash)\n    is_fn := match d.kind {\n      ast.FnDef(_) => true,\n      _ => false,\n    }\n    if b is None && a is None && !(before_hash is None && is_fn) {\n      continue\n    }\n    changed_here := pairs.any(\n      p -> match p.1 {\n        Some(n) => diff.qname(n) == q,\n        None => false,\n      },\n    )\n    // a dependent gets a row only if both results are known and differ\n    if before_hash is Some && !changed_here {\n      known := match (b, a) {\n        (Some(x), Some(y)) => if x.status == y.status {\n          1\n        } else {\n          2\n        },\n        _ => 0,\n      }\n      if known == 1 {\n        rechecked_same += 1\n      }\n      if known != 2 {\n        continue\n      }\n    }\n    why := if before_hash is None {\n      \"new definition\"\n    } else if changed_here {\n      \"changed\"\n    } else {\n      \"something it depends on changed\"\n    }\n    after := if a is None && before_hash is Some {\n      \"not verified yet\"\n    } else {\n      diff.verdict_word(a)\n    }\n    mut checks.push(\n      diff.Check { name: q, before: match before_hash {\n        Some(_) => Some(diff.verdict_word(b)),\n        None => None,\n      }, after, why },\n    )\n  }\n  diff.Diff {\n    added,\n    removed,\n    renamed,\n    changed,\n    interface_changes: iface,\n    items,\n    checks,\n    rechecked_same,\n    follow_renames: len(to_list(ref_only)),\n  }\n}","old_text":"pub fn diff[F: std.fs.Files](\n  files: F,\n  verdicts: diff.Verdicts,\n  old: List[ast.Decl],\n  new: List[ast.Decl],\n  recorded: List[(String, String)],\n  steps: List[(Int, List[String])],\n  std: List[ast.Decl],\n  core: builtins.Core,\n) -> diff.Diff {\n  // each side's dependency graph and code hashes, only if there are\n  // verdicts to look up\n  looking := verdicts.root is Some\n  hashes := (p: List[ast.Decl]) -> dict(p.map(\n    d -> (diff.qname(d), codebase.short_hex(binary.code_hash(d))),\n  ))\n  old_graph := if looking {\n    store.graph(resolve.stored(old, std, core), false)\n  } else {\n    Dict[String, List[String]] {}\n  }\n  // what refers to what, from each side as stored; as written, a name an\n  // import shortens is not qualified\n  new_graph := store.graph(resolve.stored(new, std, core), false)\n  old_hashes := if looking {\n    hashes(old)\n  } else {\n    Dict[String, String] {}\n  }\n  new_hashes := if looking {\n    hashes(new)\n  } else {\n    Dict[String, String] {}\n  }\n  closure_old := (n: String) -> if looking {\n    diff.closure_hash(old_graph, old_hashes, n)\n  } else {\n    \"\"\n  }\n  closure_new := (n: String) -> if looking {\n    diff.closure_hash(new_graph, new_hashes, n)\n  } else {\n    \"\"\n  }\n  // renames of a variant, trait method or field: (from, to, kind, owning definition)\n  mut members := []\n  for (f, t) in recorded {\n    match refactor.member(old, f) {\n      Some((k, _)) => if (k == \"variant\" || k == \"method\" || k == \"field\")\n        && refactor.member(new, t) is Some {\n        match refactor.owner(old, f) {\n          Some(o) => mut members.push((f, t, k, o)),\n          None => (),\n        }\n      },\n      None => (),\n    }\n  }\n  owners := set(members.map(m -> m.3))\n  renames := diff.effective_renames(old, new, recorded)\n  // code that only follows a rename: definitions' and members' short names\n  substitutions := renames + members.map(m -> (m.0, m.1))\n  om := dict(old.map(d -> (diff.qname(d), d)))\n  nm := dict(new.map(d -> (diff.qname(d), d)))\n  renamed_to := dict(renames.map(r -> (r.1, r.0)))\n  renamed_from := set(renames.map(r -> r.0))\n  // pairs (old, new) in the new program's order, then removals\n  mut pairs := []\n  for d in new {\n    q := diff.qname(d)\n    match get(om, q) {\n      Some(o) => if binary.hash(o) != binary.hash(d) {\n        mut pairs.push((Some(o), Some(d), d))\n      },\n      None => match get(renamed_to, q) {\n        Some(f) => mut pairs.push((get(om, f), Some(d), d)),\n        None => mut pairs.push((None, Some(d), d)),\n      },\n    }\n  }\n  for d in old {\n    if !contains(nm, diff.qname(d))\n      && !contains(renamed_from, diff.qname(d)) {\n      mut pairs.push((Some(d), None, d))\n    }\n  }\n  // definitions that only follow a rename are folded into it\n  mut refs_of := Dict[String, List[String]] {}\n  mut ref_only := Set[String] {}\n  if len(substitutions) > 0 {\n    for (po, pn, _) in pairs {\n      match (po, pn) {\n        (Some(o), Some(n)) => {\n          // the type or trait that declares a renamed member is shown, not folded\n          if diff.qname(o) != diff.qname(n)\n            || diff.prose(o) != diff.prose(n)\n            || contains(owners, diff.qname(o)) {\n            continue\n          }\n          oc := diff.code(o)\n          nc := diff.code(n)\n          ot := merge.tokens(oc)\n          nt := merge.tokens(nc)\n          for (f, t) in substitutions {\n            if contains(ot, refactor.short(f))\n              && contains(nt, refactor.short(t)) {\n              mut refs_of.insert(\n                t,\n                (get(refs_of, t) ?? []) + [diff.qname(n)],\n              )\n            }\n          }\n          if diff.substitute(oc, substitutions) == nc {\n            mut ref_only.insert(diff.qname(n))\n          }\n        },\n        _ => (),\n      }\n    }\n  }\n  mut items := []\n  mut added := 0\n  mut removed := 0\n  mut renamed := 0\n  mut changed := 0\n  mut iface := 0\n  for (po, pn, d) in pairs {\n    p := (po, pn)\n    q := diff.qname(d)\n    if contains(ref_only, q) {\n      continue\n    }\n    kind := diff.kind_str(d)\n    mut mk := \"\"\n    mut what := []\n    mut shown := []\n    mut interface_changed := true\n    mut rewritten := false\n    match p {\n      (None, Some(n)) => {\n        added += 1\n        mk = \"add\"\n        what = [\"added\"]\n        shown = lines(diff.code(n)).map(l -> diff.Line { s: \"+\", text: l })\n      },\n      (Some(o), None) => {\n        removed += 1\n        mk = \"del\"\n        what = [\"removed\"]\n        shown = lines(diff.code(o)).map(l -> diff.Line { s: \"-\", text: l })\n      },\n      (Some(o), Some(n)) => {\n        is_rename := diff.qname(o) != diff.qname(n)\n        interface_changed = is_rename\n          || binary.interface_hash(o) != binary.interface_hash(n)\n        oc := diff.code(o)\n        nc := diff.code(n)\n        (ls, rw) := diff.line_diff(oc, nc)\n        rewritten = rw\n        ls2 := diff.annotate(ls, oc, kind, if is_rename {\n          []\n        } else {\n          renames\n        })\n        // a move keeps the short name and changes the module\n        moved := is_rename\n          && refactor.short(diff.qname(o)) == refactor.short(diff.qname(n))\n        what = if moved {\n          [\"moved from `\"\n            + if o.module == \"\" {\n              \"main\"\n            } else {\n              o.module\n            }\n            + \"`\"]\n        } else if is_rename {\n          [\"renamed from `\" + refactor.short(diff.qname(o)) + \"`\"]\n        } else {\n          []\n        }\n        // a rename alone changes only the name\n        mut rest := if is_rename {\n          diff.substitute(oc, renames) != nc\n            || diff.prose(o) != diff.prose(n)\n        } else {\n          true\n        }\n        // a renamed member: say so, then whatever else changed, compared with the\n        // old definition with the rename applied\n        if !is_rename {\n          for (f, t, k, ow) in members {\n            if ow != q {\n              continue\n            }\n            mut what.push(\n              k\n                + \" `\"\n                + refactor.short(f)\n                + \"` renamed to `\"\n                + refactor.short(t)\n                + \"`\",\n            )\n            o2 := match refactor.rename_all(\n              old,\n              [(f, refactor.short(t))],\n              Set[String] {},\n            ) {\n              Ok(r) => r.find(x -> diff.qname(x) == q),\n              Err(_) => None,\n            }\n            match o2 {\n              Some(x) => if !(diff.code(x) == nc && diff.prose(x) == diff.prose(n)) {\n                what += diff.change_words(x, n)\n              },\n              None => {\n                what += diff.change_words(o, n)\n              },\n            }\n            rest = false\n          }\n        }\n        if rest {\n          ws := diff.change_words(o, n)\n          if !(is_rename\n            && ws == [\"signature changed\"]\n            && diff.substitute(oc, renames) == nc) {\n            what += ws\n          }\n        }\n        if is_rename {\n          renamed += 1\n        } else {\n          changed += 1\n        }\n        if interface_changed {\n          iface += 1\n        }\n        mk = if is_rename {\n          \"ren\"\n        } else {\n          \"chg\"\n        }\n        shown = diff.fold_lines(ls2, kind)\n      },\n      _ => (),\n    }\n    // for the reader: what uses it directly, and how much depends on it in all\n    users := keys(new_graph)\n      .filter(x -> x != q && contains(get(new_graph, x) ?? [], q))\n      .sorted()\n    total := len(codebase.dependents(new_graph, q))\n    mut detail := []\n    if rewritten {\n      mut detail.push(\n        \"most of it changed, so it is shown as a line diff\",\n      )\n    }\n    only_renamed := mk == \"ren\" && len(what) == 1\n    member_only := contains(owners, q)\n      && what.all(w -> contains(w, \"` renamed to `\"))\n    if member_only {\n      r := sum(members\n        .filter(m -> m.3 == q)\n        .map(m -> len(get(refs_of, m.1) ?? [])))\n      mut detail.push(\n        f\"only a name changed · {r} reference{diff.plural(r)} updated\",\n      )\n    } else if only_renamed {\n      r := len(get(refs_of, q) ?? [])\n      what_changed := if starts_with(get(what, 0) ?? \"\", \"moved\") {\n        \"its module\"\n      } else {\n        \"the name\"\n      }\n      mut detail.push(\n        f\"only {what_changed} changed · {r} reference{diff.plural(r)} updated\",\n      )\n    } else if what == [\"doc changed\"] || what == [\"comments changed\"] {\n      mut detail.push(\n        \"only the \"\n          + if what == [\"doc changed\"] {\n            \"doc\"\n          } else {\n            \"comments\"\n          }\n          + \" changed · interface unchanged\",\n      )\n    } else if mk == \"chg\" && kind == \"impl\" {\n      match d.kind {\n        ast.ImplDef(i) => mut detail.push(\n          if i.trait_name == \"\" {\n            \"methods of `\"\n              + refactor.short(diff.type_head(i.for_type))\n              + \"` · checked against the contracts of the traits they serve\"\n          } else {\n            \"implementation of `\"\n              + refactor.short(i.trait_name)\n              + \"` · checked against its contracts\"\n          },\n        ),\n        _ => (),\n      }\n    } else if mk == \"chg\" || mk == \"ren\" {\n      if kind == \"trait\"\n        && what.any(\n          w -> contains(w, \"added\") || contains(w, \"stronger\"),\n        ) {\n        impls := len(new.filter(\n          x -> match x.kind {\n            ast.ImplDef(i) => refactor.short(i.trait_name) == refactor.short(q),\n            _ => false,\n          },\n        ))\n        mut detail.push(\n          f\"every implementation must follow · {impls} in the codebase\",\n        )\n      } else if interface_changed && kind != \"test\" {\n        mut detail.push(\n          if len(users) == 0 {\n            \"interface changed · nothing uses it\"\n          } else {\n            \"interface changed · used by \"\n              + f\"{len(users)}\"\n              + if total > len(users) {\n                f\", {total} depend on it in all\"\n              } else {\n                \"\"\n              }\n          },\n        )\n      } else if kind != \"test\" {\n        mut detail.push(\n          \"implementation only · nothing else needs re-checking\",\n        )\n      }\n    }\n    if mk == \"add\" {\n      match p {\n        (_, Some(n)) => if len(n.doc) > 0 {\n          mut detail.push(diff.prose(n))\n        },\n        _ => (),\n      }\n    }\n    doc_diff := match p {\n      (Some(o), Some(n)) => if diff.prose(o) != diff.prose(n) {\n        Some(diff.segments(diff.prose(o), diff.prose(n)))\n      } else {\n        None\n      },\n      _ => None,\n    }\n    owned := [diff.qname(x) for x in [p.0, p.1] where x is Some for x in [x ?? d]]\n    affected := if interface_changed\n      && p.0 is Some\n      && p.1 is Some\n      && kind != \"impl\" {\n      users.map(\n        x -> (x, pairs.any(\n          y -> match y.1 {\n            Some(nn) => diff.qname(nn) == x,\n            None => false,\n          },\n        )),\n      )\n    } else {\n      []\n    }\n    mut items.push(\n      diff.Item {\n        section: diff.section(kind, mk, interface_changed),\n        id: q,\n        mk,\n        what,\n        detail,\n        doc_diff,\n        lines: shown,\n        refs: get(refs_of, q) ?? [],\n        old_id: match p.0 {\n          Some(o) => Some(diff.qname(o)),\n          None => None,\n        },\n        label: match p {\n          (Some(o), Some(n)) => if diff.qname(o) != diff.qname(n) {\n            diff.label_of(o) + \" → \" + diff.label_of(n)\n          } else {\n            diff.label_of(d)\n          },\n          _ => diff.label_of(d),\n        },\n        kind,\n        module: d.module,\n        doc: match p.1 {\n          Some(n) => Some(diff.prose(n)),\n          None => None,\n        },\n        rewritten,\n        interface_changed,\n        affected,\n        affected_total: if affected == [] {\n          0\n        } else {\n          total\n        },\n        refs_folded: (get(refs_of, q) ?? []).filter(x -> contains(ref_only, x)),\n        steps: [s.0 for s in steps where s.1.any(x -> owned.contains(x))],\n        verdict_before: match p.0 {\n          Some(o) => Some(diff.verdict_word(diff.verdict_of(\n            files,\n            verdicts,\n            closure_old(diff.qname(o)),\n          ))),\n          None => None,\n        },\n        verdict_after: match p.1 {\n          Some(n) => Some(diff.verdict_word(diff.verdict_of(\n            files,\n            verdicts,\n            closure_new(diff.qname(n)),\n          ))),\n          None => None,\n        },\n      },\n    )\n  }\n  // verification before and after: what changed, and dependents whose result changed\n  mut checks := []\n  mut rechecked_same := 0\n  for d in new {\n    q := diff.qname(d)\n    oq := get(renamed_to, q) ?? q\n    before_hash := if contains(om, oq) {\n      Some(closure_old(oq))\n    } else {\n      None\n    }\n    after_hash := closure_new(q)\n    if before_hash == Some(after_hash) {\n      continue\n    }\n    b := match before_hash {\n      Some(h) => diff.verdict_of(files, verdicts, h),\n      None => None,\n    }\n    a := diff.verdict_of(files, verdicts, after_hash)\n    is_fn := match d.kind {\n      ast.FnDef(_) => true,\n      _ => false,\n    }\n    if b is None && a is None && !(before_hash is None && is_fn) {\n      continue\n    }\n    changed_here := pairs.any(\n      p -> match p.1 {\n        Some(n) => diff.qname(n) == q,\n        None => false,\n      },\n    )\n    // a dependent gets a row only if both results are known and differ\n    if before_hash is Some && !changed_here {\n      known := match (b, a) {\n        (Some(x), Some(y)) => if x.status == y.status {\n          1\n        } else {\n          2\n        },\n        _ => 0,\n      }\n      if known == 1 {\n        rechecked_same += 1\n      }\n      if known != 2 {\n        continue\n      }\n    }\n    why := if before_hash is None {\n      \"new definition\"\n    } else if changed_here {\n      \"changed\"\n    } else {\n      \"something it depends on changed\"\n    }\n    after := if a is None && before_hash is Some {\n      \"not verified yet\"\n    } else {\n      diff.verdict_word(a)\n    }\n    mut checks.push(\n      diff.Check { name: q, before: match before_hash {\n        Some(_) => Some(diff.verdict_word(b)),\n        None => None,\n      }, after, why },\n    )\n  }\n  diff.Diff {\n    added,\n    removed,\n    renamed,\n    changed,\n    interface_changes: iface,\n    items,\n    checks,\n    rechecked_same,\n    follow_renames: len(to_list(ref_only)),\n  }\n}"},{"name":"rename_command","kind":"fn","old":"39b86e8bd280f6bf","new":"cc4372cb44071a00","interface_changed":false,"affected":[],"module":"","text":"/// `strata rename <old> <new> [<old> <new>]... [-m MSG]`.\nfn rename_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  args: List[String],\n) -> std.process.ExitCode {\n  o := match open_package(disk, process, \"rename\") {\n    Ok(o) => o,\n    Err(e) => return fail_with(mut console, e),\n  }\n  (msg, commit, words0) := message_and_rest(args)\n  json := contains(words0, \"--json\")\n  words := words0.filter(w -> w != \"--json\")\n  if len(words) == 0 || len(words) % 2 != 0 {\n    return fail_with(\n      mut console,\n      \"usage: strata rename <old> <new> [<old> <new>]...  (several renames are one step)\",\n    )\n  }\n  mut mods := []\n  for d in o.decls {\n    if !contains(mods, d.module) {\n      mut mods.push(d.module)\n    }\n  }\n  mods = to_list(set(mods))\n  mut pairs := []\n  mut i := 0\n  while i + 1 < len(words) {\n    old := get(words, i) ?? \"\"\n    new := get(words, i + 1) ?? \"\"\n    i += 2\n    (old_q, kind) := match refactor.member(o.decls, old) {\n      Some((k, _)) => (old, k),\n      None => {\n        found := [(\n          refactor.qualify(m, old),\n          (refactor.member(o.decls, refactor.qualify(m, old)) ?? (\"\", \"\")).0,\n        ) for m in mods where refactor.member(o.decls, refactor.qualify(m, old)) is Some]\n        match found {\n          [one] => one,\n          [] => return fail_with(\n            mut console,\n            f\"no definition, variant, trait method or field `{old}`\",\n          ),\n          many => return fail_with(\n            mut console,\n            f\"`{old}` is ambiguous: {join(many.map(x -> x.0), \", \")}\",\n          ),\n        }\n      },\n    }\n    mut pairs.push((old_q, new, kind))\n  }\n  // each read of a renamed field tagged with the records it reads from, as\n  // the checker types its receiver\n  mut marked := o.decls\n  for f in set([refactor.short(p.0) for p in pairs where p.2 == \"field\"]) {\n    marked = check.mark_field_reads(marked, o.std, o.core, f)\n  }\n  renamed := match refactor.rename_all(marked, pairs.map(p -> (p.0, p.1))) {\n    Ok(r) => r,\n    Err(e) => return fail_with(mut console, e),\n  }\n  news := pairs.map(p -> refactor.qualify(refactor.module_of(p.0), p.1))\n  mut owners := []\n  for p in pairs {\n    match refactor.owner(o.decls, p.0) {\n      Some(x) => mut owners.push(x),\n      None => (),\n    }\n  }\n  mut before := Dict[String, String] {}\n  for d in o.decls {\n    mut before.insert(\n      store.qname(d),\n      codebase.short_hex(binary.hash(d)),\n    )\n  }\n  shown := written_names(renamed, o.std, o.core)\n  updated := [get(shown, store.qname(d)) ?? store.qname(d) for d in renamed where !(d.kind is ast.UseDef)\n    && !contains(news, store.qname(d))\n    && !contains(owners, store.qname(d))\n    && match get(before, store.qname(d)) {\n      Some(h) => h != codebase.short_hex(binary.hash(d)),\n      None => false,\n    }]\n  shorts := pairs.map(p -> refactor.short(p.0))\n  mentions := [get(shown, store.qname(d)) ?? store.qname(d) for d in renamed where (d.doc + d.comments).any(l -> mentions_word(l, shorts))]\n  arrows := [f\"{p.0} → {get(news, k) ?? \"\"}\" for (k, p) in enumerate(pairs)]\n  message := msg ?? f\"rename {join(arrows, \", \")}\"\n  entries := [f\"{{\\\"from\\\":{codebase.json_string(p.0)},\\\"to\\\":{codebase.json_string(get(news, k) ?? \"\")},\\\"kind\\\":{codebase.json_string(p.2)}}}\" for (k, p) in enumerate(pairs)]\n  extra := [(\"renames\", \"[\" + join(entries, \",\") + \"]\"), (\n    \"references\",\n    \"[\" + join(updated.map(u -> codebase.json_string(u)), \",\") + \"]\",\n  )]\n  if !apply_change(\n    mut console,\n    mut disk,\n    mut launcher,\n    clock,\n    cache,\n    o,\n    renamed,\n    message,\n    extra,\n    entries,\n    commit,\n  ) {\n    return 1\n  }\n  if json {\n    refs := \"[\" + join(updated.map(u -> codebase.json_string(u)), \",\") + \"]\"\n    ms := \"[\"\n      + join(mentions.map(u -> codebase.json_string(u)), \",\")\n      + \"]\"\n    mut console.print(\n      \"{\\\"renames\\\":[\"\n        + join(entries, \",\")\n        + \"],\\\"references\\\":\"\n        + refs\n        + \",\\\"mentions\\\":\"\n        + ms\n        + \"}\",\n    )\n    return 0\n  }\n  mut console.print(f\"renamed {join(arrows, \", \")}\")\n  it := plural(len(pairs), \"it\", \"them\")\n  match len(updated) {\n    0 => mut console.print(f\"no other definition refers to {it}\"),\n    n => mut console.print(\n      f\"updated {n} definition{plural(n, \"\", \"s\")} that refer{plural(n, \"s\", \"\")} to {it}: {join(updated, \", \")}\",\n    ),\n  }\n  if len(mentions) > 0 {\n    mut console.print(\n      f\"docs or comments still mention {join(shorts.map(s -> f\"`{s}`\"), \" or \")} in: {join(mentions, \", \")}\",\n    )\n  }\n  0\n}","old_text":"/// `strata rename <old> <new> [<old> <new>]... [-m MSG]`.\nfn rename_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n  args: List[String],\n) -> std.process.ExitCode {\n  o := match open_package(disk, process, \"rename\") {\n    Ok(o) => o,\n    Err(e) => return fail_with(mut console, e),\n  }\n  (msg, commit, words0) := message_and_rest(args)\n  json := contains(words0, \"--json\")\n  words := words0.filter(w -> w != \"--json\")\n  if len(words) == 0 || len(words) % 2 != 0 {\n    return fail_with(\n      mut console,\n      \"usage: strata rename <old> <new> [<old> <new>]...  (several renames are one step)\",\n    )\n  }\n  mut mods := []\n  for d in o.decls {\n    if !contains(mods, d.module) {\n      mut mods.push(d.module)\n    }\n  }\n  mods = to_list(set(mods))\n  mut pairs := []\n  mut i := 0\n  while i + 1 < len(words) {\n    old := get(words, i) ?? \"\"\n    new := get(words, i + 1) ?? \"\"\n    i += 2\n    (old_q, kind) := match refactor.member(o.decls, old) {\n      Some((k, _)) => (old, k),\n      None => {\n        found := [(\n          refactor.qualify(m, old),\n          (refactor.member(o.decls, refactor.qualify(m, old)) ?? (\"\", \"\")).0,\n        ) for m in mods where refactor.member(o.decls, refactor.qualify(m, old)) is Some]\n        match found {\n          [one] => one,\n          [] => return fail_with(\n            mut console,\n            f\"no definition, variant, trait method or field `{old}`\",\n          ),\n          many => return fail_with(\n            mut console,\n            f\"`{old}` is ambiguous: {join(many.map(x -> x.0), \", \")}\",\n          ),\n        }\n      },\n    }\n    mut pairs.push((old_q, new, kind))\n  }\n  // each read of a renamed field tagged with the records it reads from, as\n  // the checker types its receiver\n  mut marked := o.decls\n  for f in set([refactor.short(p.0) for p in pairs where p.2 == \"field\"]) {\n    marked = check.mark_field_reads(marked, o.std, o.core, f)\n  }\n  renamed := match refactor.rename_all(\n    marked,\n    pairs.map(p -> (p.0, p.1)),\n    builtin_names(o.core),\n  ) {\n    Ok(r) => r,\n    Err(e) => return fail_with(mut console, e),\n  }\n  news := pairs.map(p -> refactor.qualify(refactor.module_of(p.0), p.1))\n  mut owners := []\n  for p in pairs {\n    match refactor.owner(o.decls, p.0) {\n      Some(x) => mut owners.push(x),\n      None => (),\n    }\n  }\n  mut before := Dict[String, String] {}\n  for d in o.decls {\n    mut before.insert(\n      store.qname(d),\n      codebase.short_hex(binary.hash(d)),\n    )\n  }\n  shown := written_names(renamed, o.std, o.core)\n  updated := [get(shown, store.qname(d)) ?? store.qname(d) for d in renamed where !(d.kind is ast.UseDef)\n    && !contains(news, store.qname(d))\n    && !contains(owners, store.qname(d))\n    && match get(before, store.qname(d)) {\n      Some(h) => h != codebase.short_hex(binary.hash(d)),\n      None => false,\n    }]\n  shorts := pairs.map(p -> refactor.short(p.0))\n  mentions := [get(shown, store.qname(d)) ?? store.qname(d) for d in renamed where (d.doc + d.comments).any(l -> mentions_word(l, shorts))]\n  arrows := [f\"{p.0} → {get(news, k) ?? \"\"}\" for (k, p) in enumerate(pairs)]\n  message := msg ?? f\"rename {join(arrows, \", \")}\"\n  entries := [f\"{{\\\"from\\\":{codebase.json_string(p.0)},\\\"to\\\":{codebase.json_string(get(news, k) ?? \"\")},\\\"kind\\\":{codebase.json_string(p.2)}}}\" for (k, p) in enumerate(pairs)]\n  extra := [(\"renames\", \"[\" + join(entries, \",\") + \"]\"), (\n    \"references\",\n    \"[\" + join(updated.map(u -> codebase.json_string(u)), \",\") + \"]\",\n  )]\n  if !apply_change(\n    mut console,\n    mut disk,\n    mut launcher,\n    clock,\n    cache,\n    o,\n    renamed,\n    message,\n    extra,\n    entries,\n    commit,\n  ) {\n    return 1\n  }\n  if json {\n    refs := \"[\" + join(updated.map(u -> codebase.json_string(u)), \",\") + \"]\"\n    ms := \"[\"\n      + join(mentions.map(u -> codebase.json_string(u)), \",\")\n      + \"]\"\n    mut console.print(\n      \"{\\\"renames\\\":[\"\n        + join(entries, \",\")\n        + \"],\\\"references\\\":\"\n        + refs\n        + \",\\\"mentions\\\":\"\n        + ms\n        + \"}\",\n    )\n    return 0\n  }\n  mut console.print(f\"renamed {join(arrows, \", \")}\")\n  it := plural(len(pairs), \"it\", \"them\")\n  match len(updated) {\n    0 => mut console.print(f\"no other definition refers to {it}\"),\n    n => mut console.print(\n      f\"updated {n} definition{plural(n, \"\", \"s\")} that refer{plural(n, \"s\", \"\")} to {it}: {join(updated, \", \")}\",\n    ),\n  }\n  if len(mentions) > 0 {\n    mut console.print(\n      f\"docs or comments still mention {join(shorts.map(s -> f\"`{s}`\"), \" or \")} in: {join(mentions, \", \")}\",\n    )\n  }\n  0\n}"},{"name":"link_command","kind":"fn","old":"01a4898d461ad954","new":"d8ca06f03c324f61","interface_changed":true,"affected":["command_line","main","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","diff_command","with_base","rename_command","move_command","fix_command","edit_in_editor"],"module":"","text":"/// `compiler link ARG...`: lld's Mach-O linker on these arguments\n/// (compiler/toolchain's `lld`).\nfn link_command(mut console: std.io.Console, args: List[String]) -> Int {\n  match toolchain.lld(args) {\n    Ok(_) => 0,\n    Err(e) => {\n      mut console.eprint(\"error: \" + e)\n      1\n    },\n  }\n}","old_text":"/// `compiler link ARG...`: lld's Mach-O linker on these arguments\n/// (compiler/toolchain's `lld`).\nfn link_command(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  args: List[String],\n) -> Int {\n  match toolchain.lld(args) {\n    Ok(_) => 0,\n    Err(e) => {\n      mut console.eprint(\"error: \" + e)\n      1\n    },\n  }\n}"},{"name":"command_line","kind":"fn","old":"cd8b77e539f06b41","new":"23cbf717e0e59dc0","interface_changed":false,"affected":[],"module":"","text":"/// Runs what the command line asks, with the caches `cache`.\nfn command_line(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  process: std.process.Process,\n  mut launcher: std.process.Launcher,\n  clock: std.time.SystemClock,\n  cache: cache.Cache,\n) -> std.process.ExitCode {\n  args := without_no_pager(process.args())\n  // the `strata` command line (compiler/driver). The internal steps the test\n  // cases run (`lex FILE...`, `codegen FILE`, `verify FILE`) come first,\n  // under their names, with their arguments as given.\n  line := driver.read_command_line(args)\n  first := get(args, 0) ?? \"\"\n  low := line.command_at == 0\n    && low_level(disk, first, line, process.current_dir())\n  command := if low {\n    first\n  } else {\n    get(line.pos, 0) ?? \"\"\n  }\n  rest := if low {\n    drop(args, 1)\n  } else {\n    driver.words_without(args, line.command_at)\n  }\n  // std's C libraries, for the JIT's compile-time code (`derive Table`\n  // runs std.orm's, which reaches std.sqlite's) and programs\n  match driver.find_home(disk, process.var(\"STRATA_HOME\"), [\n    toolchain.exe_dir() + \"/../lib/strata\",\n    toolchain.exe_dir(),\n    process.current_dir(),\n  ]) {\n    Some(h) => load_std_native_in(disk, h),\n    None => (),\n  }\n  if !low && !contains(codebase_commands(), command) {\n    return strata_command(\n      mut console,\n      mut disk,\n      process,\n      mut launcher,\n      clock,\n      cache,\n      command,\n      line,\n    )\n  }\n  // (the codebase's commands find std through `STRATA_HOME`)\n  if !low {\n    _ := home_found(disk, process)\n  }\n  mut code := 0\n  match command {\n    \"tree\" | \"same\" | \"hashes\" | \"text\" | \"bad\" => binary_files(disk, command, rest),\n    \"lex\" => lex_files(disk, rest),\n    \"parse\" => parse_files(disk, rest),\n    \"stored\" => stored_files(disk, rest),\n    \"stored-package\" => stored_package(disk, rest),\n    \"written\" => written_file(disk, rest),\n    \"use-errors\" => use_errors(disk, rest),\n    \"check\" => check_files(mut launcher, mut disk, cache, rest),\n    // `STRATA_COLORS` (set by `strata run`): whether its standard output\n    // and error show colors, `out,err`\n    \"eval\" => eval_files(mut console, disk, rest, (\n      index_of(process.var(\"STRATA_COLORS\") ?? \"\", \"out\") is Some,\n      index_of(process.var(\"STRATA_COLORS\") ?? \"\", \"err\") is Some,\n    )),\n    \"instantiated\" => instantiated_files(disk, rest),\n    \"builtins\" => print_builtins(read_core(disk)),\n    \"codegen\" => codegen_file(disk, cache, rest),\n    \"jit\" => {\n      _ := jit_file(mut disk, cache, rest)\n    },\n    \"smt\" => smt_file(\n      mut launcher,\n      mut disk,\n      cache,\n      toolchain.solver(disk, process),\n      rest,\n    ),\n    \"termination\" => termination_file(\n      mut launcher,\n      mut disk,\n      cache,\n      toolchain.solver(disk, process),\n      rest,\n    ),\n    \"fuzz\" => fuzz_file(disk, cache, rest),\n    \"verify\" => {\n      code = verify_file(\n        mut console,\n        mut launcher,\n        mut disk,\n        cache,\n        toolchain.solver(disk, process),\n        toolchain.c_compiler(process),\n        rest,\n      )\n    },\n    \"proofs\" => proofs_command(mut disk, cache, rest),\n    \"verdicts\" => verdicts_command(disk, cache, rest),\n    \"package\" => package_files(mut launcher, mut disk, cache, rest),\n    \"store-check\" => store_check(disk, rest),\n    \"init\" => {\n      code = init_command(mut console, mut disk, process.current_dir())\n    },\n    \"edit\" => {\n      code = edit_command(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        clock,\n        cache,\n        rest,\n        \"edit\",\n      )\n    },\n    \"add\" => {\n      code = edit_command(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        clock,\n        cache,\n        rest,\n        \"add\",\n      )\n    },\n    \"status\" => {\n      code = status_command(mut console, disk, process.current_dir())\n    },\n    \"done\" => {\n      code = done_command(\n        mut console,\n        mut disk,\n        mut launcher,\n        clock,\n        process.current_dir(),\n        rest,\n      )\n    },\n    \"abort\" => {\n      code = abort_command(mut console, mut disk, process.current_dir())\n    },\n    \"fix\" => {\n      code = fix_command(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        clock,\n        cache,\n        rest,\n      )\n    },\n    \"rename\" => {\n      code = rename_command(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        clock,\n        cache,\n        rest,\n      )\n    },\n    \"move\" => {\n      code = move_command(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        clock,\n        cache,\n        rest,\n      )\n    },\n    \"header\" => {\n      code = header_command(mut console, disk, rest)\n    },\n    \"interface\" => {\n      code = interface_command(mut console, mut disk, process, rest)\n    },\n    \"doc\" => {\n      code = doc_command(mut console, mut disk, process, rest)\n    },\n    \"docgen\" => {\n      code = docgen_command(mut console, mut disk, process, rest)\n    },\n    \"merge-file\" => {\n      code = merge_file_command(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        rest,\n      )\n    },\n    \"resolve\" => {\n      code = resolve_command(mut console, mut disk, process, rest)\n    },\n    \"setup-git\" => {\n      code = setup_git_command(\n        mut console,\n        mut launcher,\n        disk,\n        process.var(\"STRATA_EXE\") ?? cache.self_exe(),\n      )\n    },\n    \"diff\" => {\n      code = diff_command(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        cache,\n        rest,\n      )\n    },\n    \"pack\" => {\n      code = pack_command(mut console, mut disk, process, rest)\n    },\n    \"upgrade\" => {\n      code = upgrade_command(mut console, mut disk, mut launcher, process)\n    },\n    \"sync\" => {\n      code = sync_command(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        clock,\n        rest,\n      )\n    },\n    \"holes\" => {\n      code = holes_command(\n        mut console,\n        mut disk,\n        mut launcher,\n        process,\n        cache,\n        rest,\n      )\n    },\n    \"view\" => {\n      code = if contains(rest, \"--graph\") {\n        graph_command(\n          mut console,\n          mut disk,\n          process,\n          mut launcher,\n          cache,\n          rest,\n        )\n      } else {\n        view_command(mut console, mut disk, process, rest)\n      }\n    },\n    \"log\" => {\n      code = log_command(mut console, disk, process.current_dir(), rest)\n    },\n    \"object\" => {\n      code = object_command(mut console, mut disk, rest)\n    },\n    \"link\" => {\n      code = link_command(mut console, rest)\n    },\n    \"--version\" | \"version\" => print(\"strata \" + version()),\n    \"update\" => update_deps(mut launcher, mut disk, cache, rest),\n    _ => print(\n      \"usage: strata --file compiler run -- (tree | same | hashes | text | bad | lex | parse) FILE... | check [--std DIR] [--with-deps] FILE... | (stored | stored-package | written | use-errors | eval) BASE... -- FILE... | builtins | codegen [--proofs FILE] FILE | smt [--std DIR] FILE | termination [--std DIR] FILE | fuzz [--cases N] [--seed S] FILE F,G | verify [--cases N] [--seed S] [--cross-check N] [--require R] [--checks] [--only SELECTION] [--quiet] FILE | proofs FILE | verdicts FILE | package [--std DIR] DIR | update DIR [NAME...]\",\n    ),\n  }\n  code\n}","old_text":"/// Runs what the command line asks, with the caches `cache`.\nfn command_line(\n  mut conso