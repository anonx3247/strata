gen.generated","codegen.can_generate","codegen.session_entry","codegen.foreign_call","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.generated_args","codegen.makers","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// `call_fn` with a wanted result type, which fills in the type parameters\n/// the arguments leave open.\nfn call_fn_want(\n  mut g: codegen.Gen,\n  k: String,\n  done: List[codegen.V],\n  rest: List[ast.Expr],\n  want: check.Ty,\n) -> codegen.V {\n  // the written type arguments for this call, taken before its arguments\n  // make calls of their own\n  pending := g.pending_w\n  g.pending_w = Dict[String, check.Ty] {}\n  // (whether its result, given as words, may stay on the stack, is in\n  // result position, or is assigned to a variable: read before the arguments make calls of their own)\n  on_stack := g.stack_call\n  g.stack_call = false\n  rp := g.result_pos\n  g.result_pos = false\n  assigned := g.held_call\n  g.held_call = false\n  f := match codegen.fn_of(g, k) {\n    Some(f) => f,\n    None => return codegen.never(),\n  }\n  (pts, rt) := codegen.scheme(mut g, f)\n  // The wanted result binds the type parameters first, so the arguments\n  // are made to match (`fold(ws, Dict {}, f)` for a `Dict[String, Int]`).\n  // Skipped when it holds a trait or union value: the result is only\n  // convertible into those.\n  mut m := if codegen.holds_trait(want) || codegen.holds_union(want) {\n    Dict[String, check.Ty] {}\n  } else {\n    codegen.bind_gen(rt, want, Dict[String, check.Ty] {})\n  }\n  mut vs := []\n  // each argument's own type: a trait parameter given a value of a known\n  // type is compiled for that type\n  mut tys := []\n  for v in done {\n    m = codegen.bind_gen(get(pts, len(vs)) ?? check.TAny, v.ty, m)\n    mut vs.push(v)\n    mut tys.push(v.ty)\n  }\n  // an operand that borrows is held when a later one may assign\n  mut later := rest.map(_ -> false)\n  mut j := len(rest) - 2\n  while j >= 0 {\n    later = take(later, j)\n      + [get(later, j + 1) ?? false\n        || codegen.assigns(get(rest, j + 1) ?? ast.UnitExpr)]\n      + drop(later, j + 1)\n    j -= 1\n  }\n  mut backs := []\n  // Evaluation order: the arguments in order, but lambdas after the others\n  // (making a closure has no effect, and the others type its parameters),\n  // and places given to `mut` parameters last. In `f(mut g, h(mut g))`, `f`\n  // gets `g` as `h` left it.\n  base := len(vs)\n  is_mut := (i: Int) -> match get(f.params, base + i) {\n    Some(p) => p.mutable,\n    None => false,\n  }\n  mut order := []\n  for (i, a) in enumerate(rest) {\n    if !(a is ast.Lambda) && !is_mut(i) {\n      mut order.push(i)\n    }\n  }\n  for (i, a) in enumerate(rest) {\n    if a is ast.Lambda && !is_mut(i) {\n      mut order.push(i)\n    }\n  }\n  for (i, _) in enumerate(rest) {\n    if is_mut(i) {\n      mut order.push(i)\n    }\n  }\n  mut got := Dict[Int, codegen.V] {}\n  mut got_ty := Dict[Int, check.Ty] {}\n  for i in order {\n    a := get(rest, i) ?? ast.UnitExpr\n    pt := get(pts, base + i) ?? check.TAny\n    want := if pt is check.TTrait {\n      check.TAny\n    } else {\n      codegen.ground(check.inst(pt, m))\n    }\n    mutable := match get(f.params, base + i) {\n      Some(p) => p.mutable,\n      None => false,\n    }\n    if mutable {\n      // a slot holding the place's value, written back after the call\n      match codegen.place_of(a) {\n        Some((x, path)) => match codegen.lookup(g, x) {\n          Some(l) => {\n            // a whole variable with a slot, read by no other argument: its\n            // own slot, assigned through\n            if len(path) == 0\n              && l.op == \"\"\n              && codegen.has_value(l.ty)\n              && done.all(\n                d ->\n                  codegen.constant(d.op) || codegen.is_temp(g, d.op),\n              )\n              && !codegen.others_name(rest, i, x) {\n              m = codegen.bind_gen(\n                get(pts, base + i) ?? check.TAny,\n                l.ty,\n                m,\n              )\n              mut got.insert(\n                i,\n                codegen.V { ty: check.TStr, op: l.slot },\n              )\n              mut got_ty.insert(i, l.ty)\n              continue\n            }\n            root := codegen.load(mut g, l)\n            cur := codegen.get_path(mut g, root, path)\n            if cur.ty is check.TAny {\n              return codegen.never()\n            }\n            m = codegen.bind_gen(\n              get(pts, base + i) ?? check.TAny,\n              cur.ty,\n              m,\n            )\n            slot := codegen.fresh(mut g, \"mutarg\")\n            mut g.allocas.push(\n              f\"  {slot} = alloca {codegen.ll(cur.ty)}\",\n            )\n            held := codegen.take_value(mut g, cur)\n            codegen.store(mut g, held, slot)\n            mut backs.push((slot, x, path, cur.ty))\n            mut got.insert(i, codegen.V { ty: check.TStr, op: slot })\n            mut got_ty.insert(i, cur.ty)\n            continue\n          },\n          None => (),\n        },\n        None => (),\n      }\n      codegen.not_yet(\n        mut g,\n        \"a `mut` argument that isn't a variable or its field\",\n      )\n      return codegen.never()\n    }\n    // `f(C { … })` where `f` does not keep that argument: on the stack, when\n    // of the parameter's own type so the call does not box it\n    g.stack_next = codegen.stack_arg(mut g, k, f, base + i, a)\n    // (`f(g(…))`, `f` not keeping that argument: `g`'s result too, when\n    // it isn't made a trait's or a union's value)\n    g.stack_call = !(want is check.TTrait)\n      && !(want is check.TUnion)\n      && codegen.borrowed_arg(mut g, k, f, base + i)\n      && codegen.direct_call(g, a)\n    v := codegen.expr_want(mut g, a, want)\n    g.stack_next = false\n    g.stack_call = false\n    if v.ty is check.TAny {\n      return codegen.never()\n    }\n    m = codegen.bind_gen(get(pts, base + i) ?? check.TAny, v.ty, m)\n    mut got_ty.insert(i, v.ty)\n    mut got.insert(\n      i,\n      if get(later, i) ?? false {\n        codegen.hold(mut g, v)\n      } else {\n        v\n      },\n    )\n  }\n  for i in 0..len(rest) {\n    mut vs.push(get(got, i) ?? codegen.unit())\n    mut tys.push(get(got_ty, i) ?? check.TAny)\n  }\n  // the bounds bind more (`I: FiniteIterator[T]` with `I` known)\n  m = codegen.bind_bounds(mut g, f, m)\n  // the wanted result binds what the arguments leave open\n  for (p, x) in codegen.bind_gen(rt, want, Dict[String, check.Ty] {}) {\n    mut m.insert(p, codegen.better(get(m, p) ?? check.TAny, x))\n  }\n  // trait parameters given values of known types: an instance for them\n  (fk, ff) := codegen.for_impls(mut g, k, f, pts, tys)\n  for (i, t) in enumerate(tys) {\n    if contains(ff.type_params, \"impl.\" + to_string(i)) {\n      mut m.insert(\"impl.\" + to_string(i), t)\n    }\n  }\n  mut sub := Dict[String, check.Ty] {}\n  // the written type arguments, refined ones kept (`T` a `List[Port]`)\n  for (p, w) in codegen.written_args(g, k, ff, want, pending) {\n    mut sub.insert(\"$w:\" + p, w)\n  }\n  for p in ff.type_params {\n    // a copy `derive` made for a generic type (`decode_as.for.Pair.5`) is\n    // generic in the type's parameters. Its caller, made for the same type,\n    // knows them when the arguments don't.\n    x := get(m, p) ?? check.TAny\n    t := if x is check.TAny && contains(k, \".for.\") {\n      get(g.sub, p) ?? check.TAny\n    } else {\n      x\n    }\n    mut m.insert(p, t)\n    mut sub.insert(p, codegen.ground(t))\n  }\n  // std.memory's arenas: `f` runs with its allocations in an arena. Their\n  // Strata body, `f()`, is the fallback without arenas.\n  if (k == \"std.memory.arena\" || k == \"std.memory.arena_kept\")\n    && len(vs) == 1 {\n    rt0 := codegen.ground(check.inst(rt, m))\n    f0 := get(vs, 0) ?? codegen.unit()\n    if on_stack {\n      g.stack_made = []\n    }\n    return codegen.arena_run(\n      mut g,\n      codegen.V { ..f0, ty: check.TFn { params: [], ret: rt0 } },\n      k == \"std.memory.arena_kept\",\n    )\n  }\n  sym := codegen.instance(mut g, fk, ff, sub)\n  // std's precompiled code leaves argument checks to its callers\n  // (`proven_integer(x)` with `x` an `Int` where a `SafeInt` is wanted)\n  if contains(g.precompiled, fk) && len(ff.type_params) == 0 {\n    for (i, p) in enumerate(ff.params) {\n      if !p.mutable && codegen.needs_check(g, p.ty) {\n        match get(vs, i) {\n          Some(a) => codegen.check_type(\n            mut g,\n            p.ty,\n            a,\n            f\"argument `{p.name}` of `{fk}`\",\n            [],\n          ),\n          None => (),\n        }\n      }\n    }\n  }\n  // a recursive call: its `decreases` check\n  if fk == g.current {\n    codegen.decreases_call(mut g, ff, vs)\n  }\n  ret := codegen.ground(check.inst(rt, m))\n  // A field passed to a `mut` parameter, when only its variable holds the\n  // records on its path and no other argument names the variable: the\n  // field gives up its hold for the call, so the callee may change it in\n  // place. It is put back after.\n  mut lent := Dict[String, String] {}\n  for (slot, x, path, t) in backs {\n    match codegen.lookup(g, x) {\n      Some(l) => if codegen.counted(t)\n        && codegen.in_place_path(g, l, l.ty, path)\n        && !rest.any(\n          a -> codegen.mentions_var(a, x)\n            && codegen.place_of(a) != Some((x, path)),\n        ) {\n        root := codegen.load(mut g, l)\n        u := codegen.held_once_on(mut g, root, path, false)\n        (give, keep, given) := (\n          codegen.label(mut g, \"lend\"),\n          codegen.label(mut g, \"lend.not\"),\n          codegen.label(mut g, \"lend.done\"),\n        )\n        codegen.emit(\n          mut g,\n          f\"br i1 {u}, label %{give}, label %{keep}\",\n        )\n        codegen.block(mut g, give)\n        cur := codegen.get_path(mut g, root, path)\n        codegen.drop_value(mut g, cur)\n        codegen.br(mut g, given)\n        codegen.block(mut g, keep)\n        codegen.br(mut g, given)\n        codegen.block(mut g, given)\n        mut lent.insert(slot, u)\n      },\n      None => (),\n    }\n  }\n  words := codegen.by_words(g, sym, ret)\n  r0 := if words {\n    codegen.V {\n      ty: ret,\n      op: codegen.call_words(mut g, ret, sym, vs),\n    }\n  } else {\n    codegen.call_bare(mut g, ret, sym, vs)\n  }\n  // each `mut` argument's slot (its value owned) written back to its place\n  for (slot, x, path, t) in backs {\n    match codegen.lookup(g, x) {\n      Some(l) => match get(lent, slot) {\n        Some(u) => {\n          (put, assign, done) := (\n            codegen.label(mut g, \"back.lent\"),\n            codegen.label(mut g, \"back.assign\"),\n            codegen.label(mut g, \"back.done\"),\n          )\n          codegen.emit(\n            mut g,\n            f\"br i1 {u}, label %{put}, label %{assign}\",\n          )\n          // lent: the returned value is stored in the field, which held\n          // nothing during the call\n          codegen.block(mut g, put)\n          codegen.push_transparent(mut g)\n          nb := codegen.fresh(mut g, \"back\")\n          codegen.emit(\n            mut g,\n            f\"{nb} = load {codegen.ll(t)}, ptr {slot}\",\n          )\n          nv := codegen.V { ty: t, op: nb }\n          codegen.check_field(mut g, l.ty, x, path, nv)\n          root := codegen.load(mut g, l)\n          n := len(path)\n          last := codegen.get_path(mut g, root, take(path, n - 1))\n          (k, _) := codegen.field_index(g, last.ty, get(path, n - 1) ?? \"\")\n          at := codegen.fresh(mut g, \"at\")\n          codegen.emit(\n            mut g,\n            f\"{at} = getelementptr i64, ptr {last.op}, i64 {k + 1}\",\n          )\n          codegen.store_slot(mut g, nv, at)\n          codegen.pop_scope(mut g)\n          codegen.br(mut g, done)\n          codegen.block(mut g, assign)\n          codegen.push_transparent(mut g)\n          nb2 := codegen.fresh(mut g, \"back\")\n          codegen.emit(\n            mut g,\n            f\"{nb2} = load {codegen.ll(t)}, ptr {slot}\",\n          )\n          codegen.assign_at(\n            mut g,\n            l,\n            x,\n            path,\n            codegen.temp(mut g, codegen.V { ty: t, op: nb2 }),\n            false,\n          )\n          codegen.pop_scope(mut g)\n          codegen.br(mut g, done)\n          codegen.block(mut g, done)\n        },\n        None => {\n          nb := codegen.fresh(mut g, \"back\")\n          codegen.emit(\n            mut g,\n            f\"{nb} = load {codegen.ll(t)}, ptr {slot}\",\n          )\n          nv := codegen.temp(mut g, codegen.V { ty: t, op: nb })\n          codegen.assign_at(mut g, l, x, path, nv, false)\n        },\n      },\n      None => (),\n    }\n  }\n  if words {\n    return codegen.words_value(\n      mut g,\n      fk,\n      ret,\n      r0.op,\n      on_stack,\n      rp,\n      assigned,\n    )\n  }\n  // a result that isn't words stays where it is: the variable it is bound\n  // to holds no block on the stack\n  if on_stack {\n    g.stack_made = []\n  }\n  // a callee that unwound makes this function leave too. Only callees that\n  // may wait can.\n  if codegen.calls_wait(g, fk) {\n    codegen.cancel_point_after(mut g, r0)\n  }\n  r := codegen.temp(mut g, r0)\n  if codegen.has_value(ret) || ret is check.TUnit {\n    r\n  } else {\n    codegen.never()\n  }\n}","old_text":"/// `call_fn` with a wanted result type, which fills in the type parameters\n/// the arguments leave open.\nfn call_fn_want(\n  mut g: codegen.Gen,\n  k: String,\n  done: List[codegen.V],\n  rest: List[ast.Expr],\n  want: Ty,\n) -> codegen.V {\n  // the written type arguments for this call, taken before its arguments\n  // make calls of their own\n  pending := g.pending_w\n  g.pending_w = Dict[String, Ty] {}\n  // (whether its result, given as words, may stay on the stack, is in\n  // result position, or is assigned to a variable: read before the arguments make calls of their own)\n  on_stack := g.stack_call\n  g.stack_call = false\n  rp := g.result_pos\n  g.result_pos = false\n  assigned := g.held_call\n  g.held_call = false\n  f := match codegen.fn_of(g, k) {\n    Some(f) => f,\n    None => return codegen.never(),\n  }\n  (pts, rt) := codegen.scheme(mut g, f)\n  // The wanted result binds the type parameters first, so the arguments\n  // are made to match (`fold(ws, Dict {}, f)` for a `Dict[String, Int]`).\n  // Skipped when it holds a trait or union value: the result is only\n  // convertible into those.\n  mut m := if codegen.holds_trait(want) || codegen.holds_union(want) {\n    Dict[String, Ty] {}\n  } else {\n    codegen.bind_gen(rt, want, Dict[String, Ty] {})\n  }\n  mut vs := []\n  // each argument's own type: a trait parameter given a value of a known\n  // type is compiled for that type\n  mut tys := []\n  for v in done {\n    m = codegen.bind_gen(get(pts, len(vs)) ?? TAny, v.ty, m)\n    mut vs.push(v)\n    mut tys.push(v.ty)\n  }\n  // an operand that borrows is held when a later one may assign\n  mut later := rest.map(_ -> false)\n  mut j := len(rest) - 2\n  while j >= 0 {\n    later = take(later, j)\n      + [get(later, j + 1) ?? false\n        || codegen.assigns(get(rest, j + 1) ?? ast.UnitExpr)]\n      + drop(later, j + 1)\n    j -= 1\n  }\n  mut backs := []\n  // Evaluation order: the arguments in order, but lambdas after the others\n  // (making a closure has no effect, and the others type its parameters),\n  // and places given to `mut` parameters last. In `f(mut g, h(mut g))`, `f`\n  // gets `g` as `h` left it.\n  base := len(vs)\n  is_mut := (i: Int) -> match get(f.params, base + i) {\n    Some(p) => p.mutable,\n    None => false,\n  }\n  mut order := []\n  for (i, a) in enumerate(rest) {\n    if !(a is ast.Lambda) && !is_mut(i) {\n      mut order.push(i)\n    }\n  }\n  for (i, a) in enumerate(rest) {\n    if a is ast.Lambda && !is_mut(i) {\n      mut order.push(i)\n    }\n  }\n  for (i, _) in enumerate(rest) {\n    if is_mut(i) {\n      mut order.push(i)\n    }\n  }\n  mut got := Dict[Int, codegen.V] {}\n  mut got_ty := Dict[Int, Ty] {}\n  for i in order {\n    a := get(rest, i) ?? ast.UnitExpr\n    pt := get(pts, base + i) ?? TAny\n    want := if pt is TTrait {\n      TAny\n    } else {\n      codegen.ground(inst(pt, m))\n    }\n    mutable := match get(f.params, base + i) {\n      Some(p) => p.mutable,\n      None => false,\n    }\n    if mutable {\n      // a slot holding the place's value, written back after the call\n      match codegen.place_of(a) {\n        Some((x, path)) => match codegen.lookup(g, x) {\n          Some(l) => {\n            // a whole variable with a slot, read by no other argument: its\n            // own slot, assigned through\n            if len(path) == 0\n              && l.op == \"\"\n              && codegen.has_value(l.ty)\n              && done.all(\n                d ->\n                  codegen.constant(d.op) || codegen.is_temp(g, d.op),\n              )\n              && !codegen.others_name(rest, i, x) {\n          