(c.after) {\n            \": \" + c.after\n          } else if c.kind == \"removed\" && one_line(c.before) {\n            \": \" + c.before\n          } else if c.kind != \"moved\"\n            && one_line(c.before)\n            && one_line(c.after) {\n            \": \" + c.before + \"  →  \" + c.after\n          } else {\n            \"\"\n          }\n          out += \"\\n\"\n        }\n      },\n      _ => (),\n    }\n  }\n  out\n}","old_text":"/// `strata diff --nodes`: each changed definition as it was and as it is,\n/// with the nodes that changed marked (`^^^` under them), then each change\n/// by path. Added and removed definitions are one line each.\npub fn nodes_text(d: diff.Diff) -> String {\n  if len(d.items) == 0 {\n    return \"no changes\\n\"\n  }\n  mut out := \"\"\n  for it in d.items {\n    mk := if it.mk == \"add\" {\n      \"+\"\n    } else if it.mk == \"del\" {\n      \"-\"\n    } else if it.mk == \"ren\" {\n      \"↪\"\n    } else {\n      \"~\"\n    }\n    out += \"\\n\" + mk + \" \" + it.id + \"  (\" + join(it.what, \", \") + \")\\n\"\n    match (it.old_decl, it.new_decl) {\n      (Some(o), Some(n)) => {\n        olds := it.nodes\n          .filter(c -> c.kind != \"added\" && c.old != \"\")\n          .map(c -> c.old)\n        news := it.nodes\n          .filter(c -> c.kind != \"removed\" && c.new != \"\")\n          .map(c -> c.new)\n        if len(olds) > 0 {\n          out += \"  before:\\n\" + diff.indented(diff.marked(o, olds)) + \"\\n\"\n        }\n        if len(news) > 0 {\n          out += \"  after:\\n\" + diff.indented(diff.marked(n, news)) + \"\\n\"\n        }\n        for c in it.nodes {\n          out += \"  \"\n            + c.kind\n            + \" \"\n            + if c.old == \"\" && c.new == \"\" {\n              \"the definition itself (its name, doc, comments or flags)\"\n            } else if c.old == c.new {\n              c.old\n            } else if c.old == \"\" {\n              c.new\n            } else if c.new == \"\" {\n              c.old\n            } else {\n              c.old + \" → \" + c.new\n            }\n          out += if c.before != \"\"\n            && c.after != \"\"\n            && !contains(c.before, \"\\n\")\n            && !contains(c.after, \"\\n\") {\n            \": \" + c.before + \"  →  \" + c.after\n          } else {\n            \"\"\n          }\n          out += \"\\n\"\n        }\n      },\n      _ => (),\n    }\n  }\n  out\n}"}]}
{"id":"450290e7fd5347d9","time":1795723836,"message":"edit","changes":[{"name":"diff.diff","kind":"fn","old":"069b061ebd505be9","new":"9d777f1c46967361","interface_changed":false,"affected":[],"module":"diff","text":"pub fn diff[F: std.fs.Files](\n  files: F,\n  verdicts: diff.Verdicts,\n  old: diff.Version,\n  new: diff.Version,\n  recorded: List[(String, String)],\n  steps: List[(Int, List[String])],\n  std: List[ast.Decl],\n  core: builtins.Core,\n) -> diff.Diff {\n  // each side's dependency graph and code hashes, only if there are\n  // verdicts to look up\n  looking := verdicts.root is Some\n  hashes := (p: List[ast.Decl]) -> dict(p.map(\n    d -> (diff.qname(d), codebase.short_hex(binary.code_hash(d))),\n  ))\n  old_graph := if looking {\n    store.graph(old.decls, false)\n  } else {\n    Dict[String, List[String]] {}\n  }\n  // what refers to what, from each side as stored; as written, a name an\n  // import shortens is not qualified\n  new_graph := store.graph(new.decls, false)\n  // what uses each definition directly, worked out once\n  users_of := diff.users_by(new_graph)\n  old_hashes := if looking {\n    hashes(old.decls)\n  } else {\n    Dict[String, String] {}\n  }\n  new_hashes := if looking {\n    hashes(new.decls)\n  } else {\n    Dict[String, String] {}\n  }\n  closure_old := (n: String) -> if looking {\n    diff.closure_hash(old_graph, old_hashes, n)\n  } else {\n    \"\"\n  }\n  closure_new := (n: String) -> if looking {\n    diff.closure_hash(new_graph, new_hashes, n)\n  } else {\n    \"\"\n  }\n  // renames of a variant, trait method or field: (from, to, kind, owning definition)\n  mut members := []\n  for (f, t) in recorded {\n    match refactor.member(old.decls, f) {\n      Some((k, _)) => if (k == \"variant\" || k == \"method\" || k == \"field\")\n        && refactor.member(new.decls, t) is Some {\n        match refactor.owner(old.decls, f) {\n          Some(o) => mut members.push((f, t, k, o)),\n          None => (),\n        }\n      },\n      None => (),\n    }\n  }\n  owners := set(members.map(m -> m.3))\n  renames := diff.effective_renames(old.decls, new.decls, recorded)\n  // code that only follows a rename: definitions' and members' short names\n  substitutions := renames + members.map(m -> (m.0, m.1))\n  // the definitions that differ, written out as `strata render` shows them\n  om := diff.written_changes(old, new, std, core)\n  nm := diff.written_changes(new, old, std, core)\n  renamed_to := dict(renames.map(r -> (r.1, r.0)))\n  renamed_from := set(renames.map(r -> r.0))\n  // pairs (old, new) in the new program's order, then removals\n  mut pairs := []\n  for s in new.decls {\n    q := diff.qname(s)\n    match get(nm, q) {\n      Some(d) => if contains(old.hashes, q) {\n        mut pairs.push((get(om, q), Some(d), d))\n      } else {\n        match get(renamed_to, q) {\n          Some(f) => mut pairs.push((get(om, f), Some(d), d)),\n          None => mut pairs.push((None, Some(d), d)),\n        }\n      },\n      None => (),\n    }\n  }\n  for s in old.decls {\n    q := diff.qname(s)\n    if !contains(new.hashes, q) && !contains(renamed_from, q) {\n      match get(om, q) {\n        Some(d) => mut pairs.push((Some(d), None, d)),\n        None => (),\n      }\n    }\n  }\n  // the new side's names among the changes\n  paired := set(\n    [diff.qname(n) for p in pairs where p.1 is Some for n in [p.1 ?? p.2]],\n  )\n  // definitions that only follow a rename are folded into it\n  mut refs_of := Dict[String, List[String]] {}\n  mut ref_only := Set[String] {}\n  if len(substitutions) > 0 {\n    for (po, pn, _) in pairs {\n      match (po, pn) {\n        (Some(o), Some(n)) => {\n          // the type or trait that declares a renamed member is shown, not folded\n          if diff.qname(o) != diff.qname(n)\n            || diff.prose(o) != diff.prose(n)\n            || contains(owners, diff.qname(o)) {\n            continue\n          }\n          oc := diff.code(o)\n          nc := diff.code(n)\n          ot := merge.tokens(oc)\n          nt := merge.tokens(nc)\n          for (f, t) in substitutions {\n            if contains(ot, refactor.short(f))\n              && contains(nt, refactor.short(t)) {\n              mut refs_of.insert(\n                t,\n                (get(refs_of, t) ?? []) + [diff.qname(n)],\n              )\n            }\n          }\n          if diff.substitute(oc, substitutions) == nc {\n            mut ref_only.insert(diff.qname(n))\n          }\n        },\n        _ => (),\n      }\n    }\n  }\n  mut items := []\n  mut added := 0\n  mut removed := 0\n  mut renamed := 0\n  mut changed := 0\n  mut iface := 0\n  for (po, pn, d) in pairs {\n    p := (po, pn)\n    q := diff.qname(d)\n    if contains(ref_only, q) {\n      continue\n    }\n    kind := diff.kind_str(d)\n    mut mk := \"\"\n    mut what := []\n    mut shown := []\n    mut interface_changed := true\n    mut rewritten := false\n    mut node_cs := []\n    match p {\n      (None, Some(n)) => {\n        added += 1\n        mk = \"add\"\n        what = [\"added\"]\n        shown = lines(diff.code(n)).map(l -> diff.Line { s: \"+\", text: l })\n      },\n      (Some(o), None) => {\n        removed += 1\n        mk = \"del\"\n        what = [\"removed\"]\n        shown = lines(diff.code(o)).map(l -> diff.Line { s: \"-\", text: l })\n      },\n      (Some(o), Some(n)) => {\n        is_rename := diff.qname(o) != diff.qname(n)\n        interface_changed = is_rename\n          || binary.interface_hash(o) != binary.interface_hash(n)\n        oc := diff.code(o)\n        nc := diff.code(n)\n        // the lines from the nodes that changed; from the text when a side\n        // doesn't print with its nodes placed\n        node_cs = timings.timed(\"diff nodes\", () -> tree.changes(o, n))\n        (ls, rw) := match diff.node_lines(o, n, node_cs) {\n          Some(r) => r,\n          None => diff.line_diff(oc, nc),\n        }\n        rewritten = rw\n        ls2 := diff.annotate(ls, oc, kind, if is_rename {\n          []\n        } else {\n          renames\n        })\n        // a move keeps the short name and changes the module\n        moved := is_rename\n          && refactor.short(diff.qname(o)) == refactor.short(diff.qname(n))\n        what = if moved {\n          [\"moved from `\"\n            + if o.module == \"\" {\n              \"main\"\n            } else {\n              o.module\n            }\n            + \"`\"]\n        } else if is_rename {\n          [\"renamed from `\" + refactor.short(diff.qname(o)) + \"`\"]\n        } else {\n          []\n        }\n        // a rename alone changes only the name\n        mut rest := if is_rename {\n          diff.substitute(oc, renames) != nc\n            || diff.prose(o) != diff.prose(n)\n        } else {\n          true\n        }\n        // a renamed member: say so, then whatever else changed, compared with the\n        // old definition with the rename applied\n        if !is_rename {\n          for (f, t, k, ow) in members {\n            if ow != q {\n              continue\n            }\n            mut what.push(\n              k\n                + \" `\"\n                + refactor.short(f)\n                + \"` renamed to `\"\n                + refactor.short(t)\n                + \"`\",\n            )\n            o2 := match refactor.rename_all(old.decls, [(f, refactor.short(t))]) {\n              Ok(r) => match diff.index_of_decl(r, q) {\n                Some(i) => get(resolve.written_at(r, set([i]), std, core), 0),\n                None => None,\n              },\n              Err(_) => None,\n            }\n            match o2 {\n              Some(x) => if !(diff.code(x) == nc && diff.prose(x) == diff.prose(n)) {\n                what += diff.change_words(x, n)\n              },\n              None => {\n                what += diff.change_words(o, n)\n              },\n            }\n            rest = false\n          }\n        }\n        if rest {\n          ws := diff.change_words(o, n)\n          if !(is_rename\n            && ws == [\"signature changed\"]\n            && diff.substitute(oc, renames) == nc) {\n            what += ws\n          }\n        }\n        if is_rename {\n          renamed += 1\n        } else {\n          changed += 1\n        }\n        if interface_changed {\n          iface += 1\n        }\n        mk = if is_rename {\n          \"ren\"\n        } else {\n          \"chg\"\n        }\n        shown = diff.fold_lines(ls2, kind)\n      },\n      _ => (),\n    }\n    // for the reader: what uses it directly, and how much depends on it in all\n    users := get(users_of, q) ?? []\n    total := diff.dependents_count(users_of, q)\n    mut detail := []\n    if rewritten {\n      mut detail.push(\n        \"most of it changed, so it is shown as a line diff\",\n      )\n    }\n    only_renamed := mk == \"ren\" && len(what) == 1\n    member_only := contains(owners, q)\n      && what.all(w -> contains(w, \"` renamed to `\"))\n    if member_only {\n      r := sum(members\n        .filter(m -> m.3 == q)\n        .map(m -> len(get(refs_of, m.1) ?? [])))\n      mut detail.push(\n        f\"only a name changed · {r} reference{diff.plural(r)} updated\",\n      )\n    } else if only_renamed {\n      r := len(get(refs_of, q) ?? [])\n      what_changed := if starts_with(get(what, 0) ?? \"\", \"moved\") {\n        \"its module\"\n      } else {\n        \"the name\"\n      }\n      mut detail.push(\n        f\"only {what_changed} changed · {r} reference{diff.plural(r)} updated\",\n      )\n    } else if what == [\"doc changed\"] || what == [\"comments changed\"] {\n      mut detail.push(\n        \"only the \"\n          + if what == [\"doc changed\"] {\n            \"doc\"\n          } else {\n            \"comments\"\n          }\n          + \" changed · interface unchanged\",\n      )\n    } else if mk == \"chg\" && kind == \"impl\" {\n      match d.kind {\n        ast.ImplDef(i) => mut detail.push(\n          if i.trait_name == \"\" {\n            \"methods of `\"\n              + refactor.short(diff.type_head(i.for_type))\n              + \"` · checked against the contracts of the traits they serve\"\n          } else {\n            \"implementation of `\"\n              + refactor.short(i.trait_name)\n              + \"` · checked against its contracts\"\n          },\n        ),\n        _ => (),\n      }\n    } else if mk == \"chg\" || mk == \"ren\" {\n      if kind == \"trait\"\n        && what.any(\n          w -> contains(w, \"added\") || contains(w, \"stronger\"),\n        ) {\n        impls := len(new.decls.filter(\n          x -> match x.kind {\n            ast.ImplDef(i) => refactor.short(i.trait_name) == refactor.short(q),\n            _ => false,\n          },\n        ))\n        mut detail.push(\n          f\"every implementation must follow · {impls} in the codebase\",\n        )\n      } else if interface_changed && kind != \"test\" {\n        mut detail.push(\n          if len(users) == 0 {\n            \"interface changed · nothing uses it\"\n          } else {\n            \"interface changed · used by \"\n              + f\"{len(users)}\"\n              + if total > len(users) {\n                f\", {total} depend on it in all\"\n              } else {\n                \"\"\n              }\n          },\n        )\n      } else if kind != \"test\" {\n        mut detail.push(\n          \"implementation only · nothing else needs re-checking\",\n        )\n      }\n    }\n    if mk == \"add\" {\n      match p {\n        (_, Some(n)) => if len(n.doc) > 0 {\n          mut detail.push(diff.prose(n))\n        },\n        _ => (),\n      }\n    }\n    doc_diff := match p {\n      (Some(o), Some(n)) => if diff.prose(o) != diff.prose(n) {\n        Some(diff.segments(diff.prose(o), diff.prose(n)))\n      } else {\n        None\n      },\n      _ => None,\n    }\n    owned := [diff.qname(x) for x in [p.0, p.1] where x is Some for x in [x ?? d]]\n    affected := if interface_changed\n      && p.0 is Some\n      && p.1 is Some\n      && kind != \"impl\" {\n      users.map(x -> (x, contains(paired, x)))\n    } else {\n      []\n    }\n    mut items.push(\n      diff.Item {\n        section: diff.section(kind, mk, interface_changed),\n        id: q,\n        mk,\n        what,\n        detail,\n        doc_diff,\n        lines: shown,\n        refs: get(refs_of, q) ?? [],\n        old_id: match p.0 {\n          Some(o) => Some(diff.qname(o)),\n          None => None,\n        },\n        label: match p {\n          (Some(o), Some(n)) => if diff.qname(o) != diff.qname(n) {\n            diff.label_of(o) + \" → \" + diff.label_of(n)\n          } else {\n            diff.label_of(d)\n          },\n          _ => diff.label_of(d),\n        },\n        kind,\n        module: d.module,\n        doc: match p.1 {\n          Some(n) => Some(diff.prose(n)),\n          None => None,\n        },\n        rewritten,\n        interface_changed,\n        affected,\n        affected_total: if affected == [] {\n          0\n        } else {\n          total\n        },\n        refs_folded: (get(refs_of, q) ?? []).filter(x -> contains(ref_only, x)),\n        steps: [s.0 for s in steps where s.1.any(x -> owned.contains(x))],\n        verdict_before: match p.0 {\n          Some(o) => Some(diff.verdict_word(diff.verdict_of(\n            files,\n            verdicts,\n            closure_old(diff.qname(o)),\n          ))),\n          None => None,\n        },\n        verdict_after: match p.1 {\n          Some(n) => Some(diff.verdict_word(diff.verdict_of(\n            files,\n            verdicts,\n            closure_new(diff.qname(n)),\n          ))),\n          None => None,\n        },\n        nodes: match p {\n          (Some(o), Some(n)) => diff.node_changes(o, n, node_cs),\n          _ => [],\n        },\n        old_decl: p.0,\n        new_decl: p.1,\n      },\n    )\n  }\n  // verification before and after: what changed, and dependents whose result changed\n  mut checks := []\n  mut rechecked_same := 0\n  // only a change, or what depends on one, can have a new verdict\n  // (and what used a definition that went)\n  gone := [diff.qname(o) for p in pairs where p.0 is Some for o in [p.0 ?? p.2]]\n  rechecked := union(\n    diff.dependents_of_all(users_of, to_list(paired)),\n    if looking {\n      diff.dependents_of_all(diff.users_by(old_graph), gone)\n    } else {\n      Set[String] {}\n    },\n  )\n  for d in new.decls {\n    q := diff.qname(d)\n    if !contains(rechecked, q) {\n      continue\n    }\n    oq := get(renamed_to, q) ?? q\n    before_hash := if contains(old.hashes, oq) {\n      Some(closure_old(oq))\n    } else {\n      None\n    }\n    after_hash := closure_new(q)\n    if before_hash == Some(after_hash) {\n      continue\n    }\n    b := match before_hash {\n      Some(h) => diff.verdict_of(files, verdicts, h),\n      None => None,\n    }\n    a := diff.verdict_of(files, verdicts, after_hash)\n    is_fn := match d.kind {\n      ast.FnDef(_) => true,\n      _ => false,\n    }\n    if b is None && a is None && !(before_hash is None && is_fn) {\n      continue\n    }\n    changed_here := contains(paired, q)\n    // a dependent gets a row only if both results are known and differ\n    if before_hash is Some && !changed_here {\n      known := match (b, a) {\n        (Some(x), Some(y)) => if x.status == y.status {\n          1\n        } else {\n          2\n        },\n        _ => 0,\n      }\n      if known == 1 {\n        rechecked_same += 1\n      }\n      if known != 2 {\n        continue\n      }\n    }\n    why := if before_hash is None {\n      \"new definition\"\n    } else if changed_here {\n      \"changed\"\n    } else {\n      \"something it depends on changed\"\n    }\n    after := if a is None && before_hash is Some {\n      \"not verified yet\"\n    } else {\n      diff.verdict_word(a)\n    }\n    mut checks.push(\n      diff.Check { name: q, before: match before_hash {\n        Some(_) => Some(diff.verdict_word(b)),\n        None => None,\n      }, after, why },\n    )\n  }\n  diff.Diff {\n    added,\n    removed,\n    renamed,\n    changed,\n    interface_changes: iface,\n    items,\n    checks,\n    rechecked_same,\n    follow_renames: len(to_list(ref_only)),\n  }\n}","old_text":"pub fn diff[F: std.fs.Files](\n  files: F,\n  verdicts: diff.Verdicts,\n  old: diff.Version,\n  new: diff.Version,\n  recorded: List[(String, String)],\n  steps: List[(Int, List[String])],\n  std: List[ast.Decl],\n  core: builtins.Core,\n) -> diff.Diff {\n  // each side's dependency graph and code hashes, only if there are\n  // verdicts to look up\n  looking := verdicts.root is Some\n  hashes := (p: List[ast.Decl]) -> dict(p.map(\n    d -> (diff.qname(d), codebase.short_hex(binary.code_hash(d))),\n  ))\n  old_graph := if looking {\n    store.graph(old.decls, false)\n  } else {\n    Dict[String, List[String]] {}\n  }\n  // what refers to what, from each side as stored; as written, a name an\n  // import shortens is not qualified\n  new_graph := store.graph(new.decls, false)\n  // what uses each definition directly, worked out once\n  users_of := diff.users_by(new_graph)\n  old_hashes := if looking {\n    hashes(old.decls)\n  } else {\n    Dict[String, String] {}\n  }\n  new_hashes := if looking {\n    hashes(new.decls)\n  } else {\n    Dict[String, String] {}\n  }\n  closure_old := (n: String) -> if looking {\n    diff.closure_hash(old_graph, old_hashes, n)\n  } else {\n    \"\"\n  }\n  closure_new := (n: String) -> if looking {\n    diff.closure_hash(new_graph, new_hashes, n)\n  } else {\n    \"\"\n  }\n  // renames of a variant, trait method or field: (from, to, kind, owning definition)\n  mut members := []\n  for (f, t) in recorded {\n    match refactor.member(old.decls, f) {\n      Some((k, _)) => if (k == \"variant\" || k == \"method\" || k == \"field\")\n        && refactor.member(new.decls, t) is Some {\n        match refactor.owner(old.decls, f) {\n          Some(o) => mut members.push((f, t, k, o)),\n          None => (),\n        }\n      },\n      None => (),\n    }\n  }\n  owners := set(members.map(m -> m.3))\n  renames := diff.effective_renames(old.decls, new.decls, recorded)\n  // code that only follows a rename: definitions' and members' short names\n  substitutions := renames + members.map(m -> (m.0, m.1))\n  // the definitions that differ, written out as `strata render` shows them\n  om := diff.written_changes(old, new, std, core)\n  nm := diff.written_changes(new, old, std, core)\n  renamed_to := dict(renames.map(r -> (r.1, r.0)))\n  renamed_from := set(renames.map(r -> r.0))\n  // pairs (old, new) in the new program's order, then removals\n  mut pairs := []\n  for s in new.decls {\n    q := diff.qname(s)\n    match get(nm, q) {\n      Some(d) => if contains(old.hashes, q) {\n        mut pairs.push((get(om, q), Some(d), d))\n      } else {\n        match get(renamed_to, q) {\n          Some(f) => mut pairs.push((get(om, f), Some(d), d)),\n          None => mut pairs.push((None, Some(d), d)),\n        }\n      },\n      None => (),\n    }\n  }\n  for s in old.decls {\n    q := diff.qname(s)\n    if !contains(new.hashes, q) && !contains(renamed_from, q) {\n      match get(om, q) {\n        Some(d) => mut pairs.push((Some(d), None, d)),\n        None => (),\n      }\n    }\n  }\n  // the new side's names among the changes\n  paired := set(\n    [diff.qname(n) for p in pairs where p.1 is Some for n in [p.1 ?? p.2]],\n  )\n  // definitions that only follow a rename are folded into it\n  mut refs_of := Dict[String, List[String]] {}\n  mut ref_only := Set[String] {}\n  if len(substitutions) > 0 {\n    for (po, pn, _) in pairs {\n      match (po, pn) {\n        (Some(o), Some(n)) => {\n          // the type or trait that declares a renamed member is shown, not folded\n          if diff.qname(o) != diff.qname(n)\n            || diff.prose(o) != diff.prose(n)\n            || contains(owners, diff.qname(o)) {\n            continue\n          }\n          oc := diff.code(o)\n          nc := diff.code(n)\n          ot := merge.tokens(oc)\n          nt := merge.tokens(nc)\n          for (f, t) in substitutions {\n            if contains(ot, refactor.short(f))\n              && contains(nt, refactor.short(t)) {\n              mut refs_of.insert(\n                t,\n                (get(refs_of, t) ?? []) + [diff.qname(n)],\n              )\n            }\n          }\n          if diff.substitute(oc, substitutions) == nc {\n            mut ref_only.insert(diff.qname(n))\n          }\n        },\n        _ => (),\n      }\n    }\n  }\n  mut items := []\n  mut added := 0\n  mut removed := 0\n  mut renamed := 0\n  mut changed := 0\n  mut iface := 0\n  for (po, pn, d) in pairs {\n    p := (po, pn)\n    q := diff.qname(d)\n    if contains(ref_only, q) {\n      continue\n    }\n    kind := diff.kind_str(d)\n    mut mk := \"\"\n    mut what := []\n    mut shown := []\n    mut interface_changed := true\n    mut rewritten := false\n    match p {\n      (None, Some(n)) => {\n        added += 1\n        mk = \"add\"\n        what = [\"added\"]\n        shown = lines(diff.code(n)).map(l -> diff.Line { s: \"+\", text: l })\n      },\n      (Some(o), None) => {\n        removed += 1\n        mk = \"del\"\n        what = [\"removed\"]\n        shown = lines(diff.code(o)).map(l -> diff.Line { s: \"-\", text: l })\n      },\n      (Some(o), Some(n)) => {\n        is_rename := diff.qname(o) != diff.qname(n)\n        interface_changed = is_rename\n          || binary.interface_hash(o) != binary.interface_hash(n)\n        oc := diff.code(o)\n        nc := diff.code(n)\n        (ls, rw) := diff.line_diff(oc, nc)\n        rewritten = rw\n        ls2 := diff.annotate(ls, oc, kind, if is_rename {\n          []\n        } else {\n          renames\n        })\n        // a move keeps the short name and changes the module\n        moved := is_rename\n          && refactor.short(diff.qname(o)) == refactor.short(diff.qname(n))\n        what = if moved {\n          [\"moved from `\"\n            + if o.module == \"\" {\n              \"main\"\n            } else {\n              o.module\n            }\n            + \"`\"]\n        } else if is_rename {\n          [\"renamed from `\" + refactor.short(diff.qname(o)) + \"`\"]\n        } else {\n          []\n        }\n        // a rename alone changes only the name\n        mut rest := if is_rename {\n          diff.substitute(oc, renames) != nc\n            || diff.prose(o) != diff.prose(n)\n        } else {\n          true\n        }\n        // a renamed member: say so, then whatever else changed, compared with the\n        // old definition with the rename applied\n        if !is_rename {\n          for (f, t, k, ow) in members {\n            if ow != q {\n              continue\n            }\n            mut what.push(\n              k\n                + \" `\"\n                + refactor.short(f)\n                + \"` renamed to `\"\n                + refactor.short(t)\n                + \"`\",\n            )\n            o2 := match refactor.rename_all(old.decls, [(f, refactor.short(t))]) {\n              Ok(r) => match diff.index_of_decl(r, q) {\n                Some(i) => get(resolve.written_at(r, set([i]), std, core), 0),\n                None => None,\n              },\n              Err(_) => None,\n            }\n            match o2 {\n              Some(x) => if !(diff.code(x) == nc && diff.prose(x) == diff.prose(n)) {\n                what += diff.change_words(x, n)\n              },\n              None => {\n                what += diff.change_words(o, n)\n              },\n            }\n            rest = false\n          }\n        }\n        if rest {\n          ws := diff.change_words(o, n)\n          if !(is_rename\n            && ws == [\"signature changed\"]\n            && diff.substitute(oc, renames) == nc) {\n            what += ws\n          }\n        }\n        if is_rename {\n          renamed += 1\n        } else {\n          changed += 1\n        }\n        if interface_changed {\n          iface += 1\n        }\n        mk = if is_rename {\n          \"ren\"\n        } else {\n          \"chg\"\n        }\n        shown = diff.fold_lines(ls2, kind)\n      },\n      _ => (),\n    }\n    // for the reader: what uses it directly, and how much depends on it in all\n    users := get(users_of, q) ?? []\n    total := diff.dependents_count(users_of, q)\n    mut detail := []\n    if rewritten {\n      mut detail.push(\n        \"most of it changed, so it is shown as a line diff\",\n      )\n    }\n    only_renamed := mk == \"ren\" && len(what) == 1\n    member_only := contains(owners, q)\n      && what.all(w -> contains(w, \"` renamed to `\"))\n    if member_only {\n      r := sum(members\n        .filter(m -> m.3 == q)\n        .map(m -> len(get(refs_of, m.1) ?? [])))\n      mut detail.push(\n        f\"only a name changed · {r} reference{diff.plural(r)} updated\",\n      )\n    } else if only_renamed {\n      r := len(get(refs_of, q) ?? [])\n      what_changed := if starts_with(get(what, 0) ?? \"\", \"moved\") {\n        \"its module\"\n      } else {\n        \"the name\"\n      }\n      mut detail.push(\n        f\"only {what_changed} changed · {r} reference{diff.plural(r)} updated\",\n      )\n    } else if what == [\"doc changed\"] || what == [\"comments changed\"] {\n      mut detail.push(\n        \"only the \"\n          + if what == [\"doc changed\"] {\n            \"doc\"\n          } else {\n            \"comments\"\n          }\n          + \" changed · interface unchanged\",\n      )\n    } else if mk == \"chg\" && kind == \"impl\" {\n      match d.kind {\n        ast.ImplDef(i) => mut detail.push(\n          if i.trait_name == \"\" {\n            \"methods of `\"\n              + refactor.short(diff.type_head(i.for_type))\n              + \"` · checked against the contracts of the traits they serve\"\n          } else {\n            \"implementation of `\"\n              + refactor.short(i.trait_name)\n              + \"` · checked against its contracts\"\n          },\n        ),\n        _ => (),\n      }\n    } else if mk == \"chg\" || mk == \"ren\" {\n      if kind == \"trait\"\n        && what.any(\n          w -> contains(w, \"added\") || contains(w, \"stronger\"),\n        ) {\n        impls := len(new.decls.filter(\n          x -> match x.kind {\n            ast.ImplDef(i) => refactor.short(i.trait_name) == refactor.short(q),\n            _ => false,\n          },\n        ))\n        mut detail.push(\n          f\"every implementation must follow · {impls} in the codebase\",\n        )\n      } else if interface_changed && kind != \"test\" {\n        mut detail.push(\n          if len(users) == 0 {\n            \"interface changed · nothing uses it\"\n          } else {\n            \"interface changed · used by \"\n              + f\"{len(users)}\"\n              + if total > len(users) {\n                f\", {total} depend on it in all\"\n              } else {\n                \"\"\n              }\n          },\n        )\n      } else if kind != \"test\" {\n        mut detail.push(\n          \"implementation only · nothing else needs re-checking\",\n        )\n      }\n    }\n    if mk == \"add\" {\n      match p {\n        (_, Some(n)) => if len(n.doc) > 0 {\n          mut detail.push(diff.prose(n))\n        },\n        _ => (),\n      }\n    }\n    doc_diff := match p {\n      (Some(o), Some(n)) => if diff.prose(o) != diff.prose(n) {\n        Some(diff.segments(diff.prose(o), diff.prose(n)))\n      } else {\n        None\n      },\n      _ => None,\n    }\n    owned := [diff.qname(x) for x in [p.0, p.1] where x is Some for x in [x ?? d]]\n    affected := if interface_changed\n      && p.0 is Some\n      && p.1 is Some\n      && kind != \"impl\" {\n      users.map(x -> (x, contains(paired, x)))\n    } else {\n      []\n    }\n    mut items.push(\n      diff.Item {\n        section: diff.section(kind, mk, interface_changed),\n        id: q,\n        mk,\n        what,\n        detail,\n        doc_diff,\n        lines: shown,\n        refs: get(refs_of, q) ?? [],\n        old_id: match p.0 {\n          Some(o) => Some(diff.qname(o)),\n          None => None,\n        },\n        label: match p {\n          (Some(o), Some(n)) => if diff.qname(o) != diff.qname(n) {\n            diff.label_of(o) + \" → \" + diff.label_of(n)\n          } else {\n            diff.label_of(d)\n          },\n          _ => diff.label_of(d),\n        },\n        kind,\n        module: d.module,\n        doc: match p.1 {\n          Some(n) => Some(diff.prose(n)),\n          None => None,\n        },\n        rewritten,\n        interface_changed,\n        affected,\n        affected_total: if affected == [] {\n          0\n        } else {\n          total\n        },\n        refs_folded: (get(refs_of, q) ?? []).filter(x -> contains(ref_only, x)),\n        steps: [s.0 for s in steps where s.1.any(x -> owned.contains(x))],\n        verdict_before: match p.0 {\n          Some(o) => Some(diff.verdict_word(diff.verdict_of(\n            files,\n            verdicts,\n            closure_old(diff.qname(o)),\n          ))),\n          None => None,\n        },\n        verdict_after: match p.1 {\n          Some(n) => Some(diff.verdict_word(diff.verdict_of(\n            files,\n            verdicts,\n            closure_new(diff.qname(n)),\n          ))),\n          None => None,\n        },\n        nodes: match p {\n          (Some(o), Some(n)) => diff.node_changes(o, n),\n          _ => [],\n        },\n        old_decl: p.0,\n        new_decl: p.1,\n      },\n    )\n  }\n  // verification before and after: what changed, and dependents whose result changed\n  mut checks := []\n  mut rechecked_same := 0\n  // only a change, or what depends on one, can have a new verdict\n  // (and what used a definition that went)\n  gone := [diff.qname(o) for p in pairs where p.0 is Some for o in [p.0 ?? p.2]]\n  rechecked := union(\n    diff.dependents_of_all(users_of, to_list(paired)),\n    if looking {\n      diff.dependents_of_all(diff.users_by(old_graph), gone)\n    } else {\n      Set[String] {}\n    },\n  )\n  for d in new.decls {\n    q := diff.qname(d)\n    if !contains(rechecked, q) {\n      continue\n    }\n    oq := get(renamed_to, q) ?? q\n    before_hash := if contains(old.hashes, oq) {\n      Some(closure_old(oq))\n    } else {\n      None\n    }\n    after_hash := closure_new(q)\n    if before_hash == Some(after_hash) {\n      continue\n    }\n    b := match before_hash {\n      Some(h) => diff.verdict_of(files, verdicts, h),\n      None => None,\n    }\n    a := diff.verdict_of(files, verdicts, after_hash)\n    is_fn := match d.kind {\n      ast.FnDef(_) => true,\n      _ => false,\n    }\n    if b is None && a is None && !(before_hash is None && is_fn) {\n      continue\n    }\n    changed_here := contains(paired, q)\n    // a dependent gets a row only if both results are known and differ\n    if before_hash is Some && !changed_here {\n      known := match (b, a) {\n        (Some(x), Some(y)) => if x.status == y.status {\n          1\n        } else {\n          2\n        },\n        _ => 0,\n      }\n      if known == 1 {\n        rechecked_same += 1\n      }\n      if known != 2 {\n        continue\n      }\n    }\n    why := if before_hash is None {\n      \"new definition\"\n    } else if changed_here {\n      \"changed\"\n    } else {\n      \"something it depends on changed\"\n    }\n    after := if a is None && before_hash is Some {\n      \"not verified yet\"\n    } else {\n      diff.verdict_word(a)\n    }\n    mut checks.push(\n      diff.Check { name: q, before: match before_hash {\n        Some(_) => Some(diff.verdict_word(b)),\n        None => None,\n      }, after, why },\n    )\n  }\n  diff.Diff {\n    added,\n    removed,\n    renamed,\n    changed,\n    interface_changes: iface,\n    items,\n    checks,\n    rechecked_same,\n    follow_renames: len(to_list(ref_only)),\n  }\n}"},{"name":"diff.node_changes","kind":"fn","old":"8c8891f9ee93d209","new":"0ed68563a17493c2","interface_changed":true,"affected":["diff.diff","diff.range_diff","diff.range_text","diff_command","tour.package_changes","command_line","tour.prepare","main","tour_command","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","tour_graph","linked","expanded","comptime_runner","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","rename_command","move_command","fix_command","edit_in_editor"],"module":"diff","text":"/// The nodes that changed from `o` to `n` (`cs`), with their text on each\n/// side.\nfn node_changes(\n  o: ast.Decl,\n  n: ast.Decl,\n  cs: List[tree.Change],\n) -> List[diff.NodeChange] {\n  cs.map(\n    c -> diff.NodeChange {\n      kind: c.kind,\n      old: c.old,\n      new: c.new,\n      before: diff.node_text_at(o, c.old),\n      after: diff.node_text_at(n, c.new),\n    },\n  )\n}","old_text":"/// The nodes that changed from `o` to `n`, with their text on each side.\n/// Costs one walk of both trees, down the parts that differ.\nfn node_changes(o: ast.Decl, n: ast.Decl) -> List[diff.NodeChange] {\n  timings.begin(\"diff nodes\")\n  out := tree.changes(o, n).map(\n    c -> diff.NodeChange {\n      kind: c.kind,\n      old: c.old,\n      new: c.new,\n      before: diff.node_text_at(o, c.old),\n      after: diff.node_text_at(n, c.new),\n    },\n  )\n  timings.end(\"diff nodes\")\n  out\n}"},{"name":"diff.placed_code","kind":"fn","old":null,"new":"4f9e3880e4ac195d","interface_changed":true,"affected":[],"module":"diff","text":"/// A definition's code (as `code` shows it) with the nodes at `paths`\n/// placed: for each line, the spans of those nodes on it, as byte columns\n/// `(from, to)` with the index of the change each belongs to. `None` when\n/// the code with the nodes marked doesn't print as `code(d)` does.\nfn placed_code(\n  d: ast.Decl,\n  paths: List[(String, Int)],\n) -> Option[(List[String], List[List[(Int, Int, Int)]])] {\n  // the locate paths to mark, outermost only, each with its change\n  mut wanted := []\n  for (p, k) in paths {\n    for x in tree.marked_paths(d, p) {\n      mut wanted.push((x, k))\n    }\n  }\n  outer := wanted.filter(\n    w -> !wanted.any(v -> v.0 != w.0 && starts_with(w.0, v.0 + \"/\")),\n  )\n  mut seen := Set[String] {}\n  mut ps := []\n  mut change_of := Dict[String, Int] {}\n  for (p, k) in outer {\n    if !contains(seen, p) {\n      mut seen.insert(p)\n      mut ps.push(p)\n      mut change_of.insert(p, k)\n    }\n  }\n  m := locate.marking(d, d, ps)\n  // each stand-in's change\n  mut by_name := Dict[String, Int] {}\n  for (p, name) in m.names.items() {\n    mut by_name.insert(name, get(change_of, p) ?? -1)\n  }\n  marked := locate.with_stand_ins(d, m.names)\n  text := text.comments_text(d.comments, 0) + text.decl_body_text(marked)\n  (out, spans) := diff.spans_back(text, m.subs, by_name)\n  if out != diff.code(d) {\n    return None\n  }\n  Some((lines(out), spans))\n}"},{"name":"diff.spans_back","kind":"fn","old":null,"new":"6013cd1d71597505","interface_changed":true,"affected":[],"module":"diff","text":"/// `text` with each stand-in of `subs` replaced by its node's text, and\n/// for each line the spans the nodes cover on it (a node over several\n/// lines covers the rest of its first line, its middle lines whole, and\n/// its last line up to its end).\nfn spans_back(\n  text: String,\n  subs: List[(String, locate.Node)],\n  change: Dict[String, Int],\n) -> (String, List[List[(Int, Int, Int)]]) {\n  mut out_lines := []\n  mut spans := []\n  // spans of the line being built\n  mut cur := []\n  ordered := subs.sorted_by(s -> 0 - byte_len(s.0))\n  for line in lines(text) {\n    mut rest := line\n    mut done := \"\"\n    mut more := true\n    while more {\n      mut best: Option[(Int, String, locate.Node)] = None\n      for s in ordered {\n        match index_of(rest, s.0) {\n          Some(i) => {\n            better := match best {\n              Some(b) => i < b.0,\n              None => true,\n            }\n            if better {\n              best = Some((i, s.0, s.1))\n            }\n          },\n          None => (),\n        }\n      }\n      match best {\n        Some((i, name, node)) => {\n          k := get(change, name) ?? -1\n          before := done + byte_slice(rest, 0, i)\n          shown := locate.node_text(node, diff.indent_of_line(line) / 2)\n          parts := split(shown, \"\\n\")\n          first := get(parts, 0) ?? \"\"\n          after := byte_slice(rest, i + byte_len(name), byte_len(rest))\n          if len(parts) == 1 {\n            mut cur.push(\n              (\n                byte_len(before),\n                byte_len(before) + byte_len(first),\n                k,\n              ),\n            )\n            done = before + first\n            rest = after\n          } else {\n            mut cur.push(\n              (\n                byte_len(before),\n                byte_len(before) + byte_len(first),\n                k,\n              ),\n            )\n            mut out_lines.push(before + first)\n            mut spans.push(cur)\n            cur = []\n            for p in slice(parts, 1, len(parts) - 1) {\n              mut out_lines.push(p)\n              mut spans.push([(0, byte_len(p), k)])\n            }\n            last := get(parts, len(parts) - 1) ?? \"\"\n            mut cur.push((0, byte_len(last), k))\n            done = last\n            rest = after\n          }\n        },\n        None => {\n          more = false\n        },\n      }\n    }\n    mut out_lines.push(done + rest)\n    mut spans.push(cur)\n    cur = []\n  }\n  (join(out_lines, \"\\n\"), spans)\n}"},{"name":"diff.indent_of_line","kind":"fn","old":null,"new":"e6fe7ef5f2668f11","interface_changed":true,"affected":[],"module":"diff","text":"fn indent_of_line(l: String) -> Int {\n  byte_len(l) - byte_len(diff.trim_start(l))\n}"},{"name":"diff.node_lines","kind":"fn","old":null,"new":"233eb74b91cb1b2c","interface_changed":true,"affected":[],"module":"diff","text":"/// The lines of a change from `o` to `n`, from the nodes that changed\n/// (`cs`, `tree.changes`): each side is printed with its changed nodes\n/// placed. Lines are lined up by their text, without indentation, and by\n/// the changed nodes on them, so a line holding a changed node never\n/// counts as unchanged. A removed and an added line holding the same\n/// change are one line changed in place: the text around the nodes kept,\n/// each node's old and new text marked (an edited node word by word).\n/// Other removed and added lines are paired when they are similar, as\n/// `line_diff` does. The `Bool` is true when most lines changed; then\n/// nothing is paired. `None` when a side doesn't print with its nodes\n/// placed as it prints alone.\nfn node_lines(\n  o: ast.Decl,\n  n: ast.Decl,\n  cs: List[tree.Change],\n) -> Option[(List[diff.Line], Bool)] {\n  olds := [(c.old, k) for (k, c) in enumerate(cs) where c.kind != \"added\" && c.old != \"\"]\n  news := [(c.new, k) for (k, c) in enumerate(cs) where c.kind != \"removed\" && c.new != \"\"]\n  (la, sa) := diff.placed_code(o, olds)?\n  (lb, sb) := diff.placed_code(n, news)?\n  key := (l: String, ss: List[(Int, Int, Int)]) -> diff.trim_start(l)\n    + join(ss.map(s -> \"\\u{1}\" + byte_slice(l, s.0, s.1)), \"\")\n  ka := [key(l, get(sa, i) ?? []) for (i, l) in enumerate(la)]\n  kb := [key(l, get(sb, i) ?? []) for (i, l) in enumerate(lb)]\n  ops := diff.lcs(ka, kb)\n  changed := len(ops.filter(x -> x.0 != 0))\n  total := len(la) + len(lb)\n  rewritten := total > 8 && changed * 10 >= total * 6\n  kinds := cs.map(c -> c.kind)\n  mut out := []\n  mut k := 0\n  while k < len(ops) {\n    (op, _, j) := get(ops, k) ?? (0, 0, 0)\n    if op == 0 {\n      mut out.push(diff.Line { s: \" \", text: get(lb, j) ?? \"\" })\n      k += 1\n      continue\n    }\n    mut dels := []\n    mut ins := []\n    while k < len(ops) && (get(ops, k) ?? (0, 0, 0)).0 != 0 {\n      (x, a, b) := get(ops, k) ?? (0, 0, 0)\n      if x == 1 {\n        mut dels.push(a)\n      } else {\n        mut ins.push(b)\n      }\n      k += 1\n    }\n    line_a := (i: Int) -> get(la, i) ?? \"\"\n    line_b := (i: Int) -> get(lb, i) ?? \"\"\n    moved_only := (ss: List[(Int, Int, Int)]) ->\n      ss != [] && ss.all(s -> get(kinds, s.2) == Some(\"moved\"))\n    if rewritten {\n      out = out\n        + dels.map(d -> diff.Line { s: \"-\", text: line_a(d) })\n        + ins.map(i -> diff.Line { s: \"+\", text: line_b(i) })\n      continue\n    }\n    mut next := 0\n    for d in dels {\n      ds := get(sa, d) ?? []\n      changes_a := set(\n        ds.map(s -> s.2).filter(c -> get(kinds, c) != Some(\"moved\")),\n      )\n      mut found := -1\n      mut j2 := next\n      // first a line holding one of its changes, then a similar one\n      while j2 < len(ins) && found < 0 {\n        bs := get(sb, get(ins, j2) ?? 0) ?? []\n        if bs.any(s -> contains(changes_a, s.2)) {\n          found = j2\n        }\n        j2 += 1\n      }\n      j2 = next\n      while j2 < len(ins) && found < 0 {\n        bs := get(sb, get(ins, j2) ?? 0) ?? []\n        if ds == []\n          && bs == []\n          && diff.close(line_a(d), line_b(get(ins, j2) ?? 0)) {\n          found = j2\n        }\n        j2 += 1\n      }\n      if found >= 0 {\n        out += slice(ins, next, found).map(\n          i -> diff.Line {\n            s: \"+\",\n            text: line_b(i),\n            note: if moved_only(get(sb, i) ?? []) {\n              \"moved\"\n            } else {\n              \"\"\n            },\n          },\n        )\n        y := get(ins, found) ?? 0\n        segs := diff.line_segs(\n          line_a(d),\n          ds,\n          line_b(y),\n          get(sb, y) ?? [],\n          kinds,\n        )\n        mut out.push(\n          if segs.all(s -> s.k == \"=\") {\n            diff.Line { s: \" \", text: line_b(y) }\n          } else {\n            diff.Line { s: \"~\", text: line_b(y), segs }\n          },\n        )\n        next = found + 1\n      } else {\n        mut out.push(\n          diff.Line {\n            s: \"-\",\n            text: line_a(d),\n            note: if moved_only(ds) {\n              \"moved\"\n            } else {\n              \"\"\n            },\n          },\n        )\n      }\n    }\n    out += slice(ins, next, len(ins)).map(\n      i -> diff.Line {\n        s: \"+\",\n        text: line_b(i),\n        note: if moved_only(get(sb, i) ?? []) {\n          \"moved\"\n        } else {\n          \"\"\n        },\n      },\n    )\n  }\n  Some((out, rewritten))\n}"},{"name":"diff.line_segs","kind":"fn","old":null,"new":"c536d3a91c108d61","interface_changed":true,"affected":[],"module":"diff","text":"/// The pieces of a line changed in place. When both lines hold the same\n/// changes in the same order, with the same text around them, the text\n/// around is kept and each change marked: an edited node word by word,\n/// another as its old text removed and its new text added. Otherwise\n/// the two lines are compared word by word.\nfn line_segs(\n  a: String,\n  sa: List[(Int, Int, Int)],\n  b: String,\n  sb: List[(Int, Int, Int)],\n  kinds: List[String],\n) -> List[diff.Seg] {\n  pieces := (l: String, ss: List[(Int, Int, Int)]) -> {\n    mut out := []\n    mut at := 0\n    for s in ss {\n      mut out.push(byte_slice(l, at, s.0))\n      at = s.1\n    }\n    mut out.push(byte_slice(l, at, byte_len(l)))\n    out\n  }\n  pa := pieces(a, sa)\n  pb := pieces(b, sb)\n  same_around := len(sa) == len(sb)\n    && len(sa) > 0\n    && zip(sa, sb).all(p -> p.0.2 == p.1.2)\n    && zip(pa, pb).all(\n      p -> diff.trim_start(p.0) == diff.trim_start(p.1),\n    )\n  if !same_around {\n    return diff.segments(a, b)\n  }\n  mut out := []\n  for (i, s) in enumerate(sb) {\n    mut out.push(diff.Seg { k: \"=\", t: get(pb, i) ?? \"\" })\n    r := get(sa, i) ?? s\n    ta := byte_slice(a, r.0, r.1)\n    tb := byte_slice(b, s.0, s.1)\n    if ta == tb {\n      mut out.push(diff.Seg { k: \"=\", t: tb })\n    } else if get(kinds, s.2) == Some(\"edited\") {\n      out += diff.segments(ta, tb)\n    } else {\n      out += [diff.Seg { k: \"-\", t: ta }, diff.Seg { k: \"+\", t: tb }]\n    }\n  }\n  mut out.push(diff.Seg { k: \"=\", t: get(pb, len(sb)) ?? \"\" })\n  // pieces next to each other of one kind are one piece\n  mut merged := []\n  for x in out.filter(x -> x.t != \"\") {\n    match get(merged, len(merged) - 1) {\n      Some(last) => if last.k == x.k {\n        merged = slice(merged, 0, len(merged) - 1)\n          + [diff.Seg { k: x.k, t: last.t + x.t }]\n      } else {\n        mut merged.push(x)\n      },\n      None => mut merged.push(x),\n    }\n  }\n  merged\n}"}]}
