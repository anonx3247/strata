n.equal","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.read_back","eval_files","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// For a task whose result has type `t`: the function running its closure\n/// and storing the result, and the one dropping a stored result (`null`\n/// when there is nothing to drop).\nfn task_fns(mut g: codegen.Gen, t: check.Ty) -> (String, String) {\n  k := codegen.key(t)\n  run := f\"@\\\"task.run:{k}\\\"\"\n  drop := if codegen.counted(t) {\n    f\"@\\\"task.drop:{k}\\\"\"\n  } else {\n    \"null\"\n  }\n  if !codegen.has_helper(g, run) {\n    codegen.add_helper(mut g, run)\n    l := codegen.ll(t)\n    calls := if l == \"void\" {\n      \"  call void %f(ptr %c)\\n\"\n    } else {\n      f\"  %r = call {l} %f(ptr %c)\\n  store {l} %r, ptr %out\\n\"\n    }\n    head := f\"define void {run}(ptr %c, ptr %out) {{\\nstart:\\n\"\n    body := \"  %raw = load i64, ptr %c\\n  %f = inttoptr i64 %raw to ptr\\n\"\n    mut g.helper_defs.push(head + body + calls + \"  ret void\\n}\\n\")\n  }\n  if drop != \"null\" && !codegen.has_helper(g, drop) {\n    codegen.add_helper(mut g, drop)\n    saved := g\n    codegen.start_helper(mut g)\n    codegen.emit(mut g, f\"%v = load {codegen.ll(t)}, ptr %out\")\n    codegen.drop_value(mut g, codegen.V { ty: t, op: \"%v\" })\n    codegen.emit(mut g, \"ret void\")\n    codegen.restore(\n      mut g,\n      saved,\n      codegen.helper_text(g, f\"define void {drop}(ptr %out)\"),\n    )\n  }\n  (run, drop)\n}","old_text":"/// For a task whose result has type `t`: the function running its closure\n/// and storing the result, and the one dropping a stored result (`null`\n/// when there is nothing to drop).\nfn task_fns(mut g: codegen.Gen, t: Ty) -> (String, String) {\n  k := codegen.key(t)\n  run := f\"@\\\"task.run:{k}\\\"\"\n  drop := if codegen.counted(t) {\n    f\"@\\\"task.drop:{k}\\\"\"\n  } else {\n    \"null\"\n  }\n  if !codegen.has_helper(g, run) {\n    codegen.add_helper(mut g, run)\n    l := codegen.ll(t)\n    calls := if l == \"void\" {\n      \"  call void %f(ptr %c)\\n\"\n    } else {\n      f\"  %r = call {l} %f(ptr %c)\\n  store {l} %r, ptr %out\\n\"\n    }\n    head := f\"define void {run}(ptr %c, ptr %out) {{\\nstart:\\n\"\n    body := \"  %raw = load i64, ptr %c\\n  %f = inttoptr i64 %raw to ptr\\n\"\n    mut g.helper_defs.push(head + body + calls + \"  ret void\\n}\\n\")\n  }\n  if drop != \"null\" && !codegen.has_helper(g, drop) {\n    codegen.add_helper(mut g, drop)\n    saved := g\n    codegen.start_helper(mut g)\n    codegen.emit(mut g, f\"%v = load {codegen.ll(t)}, ptr %out\")\n    codegen.drop_value(mut g, codegen.V { ty: t, op: \"%v\" })\n    codegen.emit(mut g, \"ret void\")\n    codegen.restore(\n      mut g,\n      saved,\n      codegen.helper_text(g, f\"define void {drop}(ptr %out)\"),\n    )\n  }\n  (run, drop)\n}"},{"name":"codegen.supervised_fns","kind":"fn","old":"492ae90d3bbf59bd","new":"c68cbbf379571488","interface_changed":true,"affected":["codegen.spawn_expr","codegen.race_expr","codegen.expr_node","codegen.expr","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.method_call","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.try_want","cod