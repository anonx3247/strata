en.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.read_back","eval_files","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// The written type arguments an `impl` of type `head` gets from the\n/// written type `tw` (`List[T]` for a `List[Port]` gives `T` a `Port`).\nfn impl_written(\n  mut g: codegen.Gen,\n  head: String,\n  tw0: check.Ty,\n) -> Dict[String, check.Ty] {\n  // a refined alias with arguments (`Many[Int]`): its base `List[Int]`, and\n  // the type itself for `Self.check`\n  tw := codegen.unfold_written(g, tw0)\n  mut own := Dict[String, check.Ty] {}\n  match tw0 {\n    check.TNamed { name, .. } => if contains(g.refines, name) {\n      mut own.insert(\"$self\", tw0)\n    },\n    _ => (),\n  }\n  for im in g.impls {\n    if im.head == head {\n      mut gen := Dict[String, check.Ty] {}\n      for p in im.decl.type_params {\n        mut gen.insert(p, check.TGen(p))\n      }\n      pat := codegen.written_ty(im.decl.for_type, gen, g)\n      mut out := Dict[String, check.Ty] {}\n      for (p, w) in codegen.bind_gen(pat, tw, Dict[String, check.Ty] {}) {\n        if codegen.has_refined(g, w) {\n          mut out.insert(p, w)\n        }\n      }\n      if len(out) > 0 {\n        for (p, w) in own {\n          mut out.insert(p, w)\n        }\n        return out\n      }\n    }\n  }\n  own\n}","old_text":"/// The written type arguments an `impl` of type `head` gets from the\n/// written type `tw` (`List[T]` for a `List[Port]` gives `T` a `Port`).\nfn impl_written(mut g: codegen.Gen, head: String, tw0: Ty) -> Dict[String, Ty] {\n  // a refined alias with arguments (`Many[Int]`): its base `List[Int]`, and\n  // the type itself for `Self.check`\n  tw := codegen.unfold_written(g, tw0)\n  mut own := Dict[String, Ty] {}\n  match tw0 {\n    TNamed { name, .. } => if contains(g.refines, name) {\n      mut own.insert(\"$self\", tw0)\n    },\n    _ => (),\n  }\n  for im in g.impls {\n    if im.head == head {\n      mut gen := Dict[String, Ty] {}\n      for p in im.decl.type_params {\n        mut gen.insert(p, TGen(p))\n      }\n      pat := codegen.written_ty(im.decl.for_type, gen, g)\n      mut out := Dict[String, Ty] {}\n      for (p, w) in codegen.bind_gen(pat, tw, Dict[String, Ty] {}) {\n        if codegen.has_refined(g, w) {\n          mut out.insert(p, w)\n        }\n      }\n      if len(out) > 0 {\n        for (p, w) in own {\n          mut out.insert(p, w)\n        }\n        return out\n      }\n    }\n  }\n  own\n}"},{"name":"codegen.unfold_written","kind":"fn","old":"4f3f2ef0dc7fcf47","new":"3ae0b4d1a1ca5c98","interface_changed":true,"affected":["codegen.type_check","codegen.impl_written","codegen.method_call","codegen.expr_node","codegen.expr_want_node","codegen.expr","codegen.expr_want","codegen.call_named","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.select_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.try_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.compared","codegen.stmt_node","codegen.decreases_pass","codegen.decreases_call","codegen.build_fn","codegen.keep_olds","codegen.export_entry","codegen.push_in_place","codegen.expr_on_stack","codegen.assigned_call","codegen.function","codegen.declar