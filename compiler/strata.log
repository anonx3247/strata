ack","eval_files"],"module":"codegen","text":"/// `eq` of lists: the same length and equal elements.\nfn eq_list(mut g: codegen.Gen, a: codegen.V, b: codegen.V, et: check.Ty) {\n  (na, nb) := (codegen.list_len(mut g, a), codegen.list_len(mut g, b))\n  same := codegen.fresh(mut g, \"samelen\")\n  codegen.emit(mut g, f\"{same} = icmp eq i64 {na.op}, {nb.op}\")\n  codegen.emit(mut g, f\"br i1 {same}, label %elements, label %no\")\n  codegen.block(mut g, \"elements\")\n  at := codegen.each_start(mut g, a)\n  x := codegen.list_at(mut g, a, at.1, et)\n  y := codegen.list_at(mut g, b, at.1, et)\n  e := codegen.equal(mut g, x, y)\n  next := codegen.label(mut g, \"next\")\n  codegen.emit(mut g, f\"br i1 {e.op}, label %{next}, label %no\")\n  codegen.block(mut g, next)\n  codegen.each_next(mut g, at)\n  codegen.emit(mut g, \"ret i1 true\")\n  codegen.block(mut g, \"no\")\n  codegen.emit(mut g, \"ret i1 false\")\n}","old_text":"/// `eq` of lists: the same length and equal elements.\nfn eq_list(mut g: codegen.Gen, a: codegen.V, b: codegen.V, et: Ty) {\n  (na, nb) := (codegen.list_len(mut g, a), codegen.list_len(mut g, b))\n  same := codegen.fresh(mut g, \"samelen\")\n  codegen.emit(mut g, f\"{same} = icmp eq i64 {na.op}, {nb.op}\")\n  codegen.emit(mut g, f\"br i1 {same}, label %elements, label %no\")\n  codegen.block(mut g, \"elements\")\n  at := codegen.each_start(mut g, a)\n  x := codegen.list_at(mut g, a, at.1, et)\n  y := codegen.list_at(mut g, b, at.1, et)\n  e := codegen.equal(mut g, x, y)\n  next := codegen.label(mut g, \"next\")\n  codegen.emit(mut g, f\"br i1 {e.op}, label %{next}, label %no\")\n  codegen.block(mut g, next)\n  codegen.each_next(mut g, at)\n  codegen.emit(mut g, \"ret i1 true\")\n  codegen.block(mut g, \"no\")\n  codegen.emit(mut g, \"ret i1 false\")\n}"},{"name":"codegen.debug_list","kind":"fn","old":"875daaeed0f07e0b","new":"622e954ba15d9fe2","interface_changed":true,"affected":["codegen.helper","codegen.show","codegen.shown","codegen.equal","codegen.