nfn ground(t: Ty) -> Ty {\n  match t {\n    TGen(_) => TAny,\n    TList(a) => TList(codegen.ground(a)),\n    TNamed { name, args } => TNamed { name, args: args.map(a -> codegen.ground(a)) },\n    TFn { params, ret } => TFn {\n      params: params.map(a -> codegen.ground(a)),\n      ret: codegen.ground(ret),\n    },\n    _ => t,\n  }\n}"},{"name":"codegen.scheme","kind":"fn","old":"28974e62c6b21d3d","new":"27d27d666704f6b7","interface_changed":true,"affected":["codegen.function_value","codegen.call_fn_want","codegen.expr_want_node","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.expr_want","codegen.expr_node","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.builtin_call","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.main_arg","codegen.select_expr","codegen.function","codegen.binary","codegen.declare","codegen.destructure","codegen.block_expr","codegen.list_literal_of","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.fuzz_driver","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.try_want","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.compared","codegen.stmt_node","codegen.build_fn","codegen.push_in_place","codegen.expr","codegen.entry","codegen.interp","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.for_loop","codegen.debug_list","codegen.checked","codegen.fail_unless","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.trace_enter","codegen.trace_leave","codegen.matching_v","codegen.index_check","codegen.decreases_fault","codegen.gen_list","codegen.converted","codegen.update_in_place","codegen.except_expr","codegen.matching_want","codegen.vtable",