   },\n    _ => (),\n  }\n  // `.to_list()` of what the checker types as a list (a comprehension or a\n  // built-in over a string's code points) is the list\n  if m == \"to_list\"\n    && len(args) == 0\n    && check.res(i, rt) is check.TList {\n    return check.res(i, rt)\n  }\n  // `x.f(..)` with `f` a built-in function is `f(x, ..)`, on a list even\n  // when a trait has a method of that name (`xs.map(f)`)\n  if own is None\n    && check.known(check.res(i, rt))\n    && !contains(env, m)\n    && (!contains(i.methods.names, m)\n      || check.res(i, rt) is check.TList\n      || check.is_table(check.res(i, rt)))\n    && get(i.fns, m) is None {\n    match get(i.builtins, m) {\n      Some(bs) => {\n        check.changing_call(mut i, recv, m, bs, marked)\n        return check.builtin_call(mut i, m, bs, [rt], args, env)\n      },\n      None => (),\n    }\n  }\n  sig := match own {\n    Some(t) => Some(t),\n    // a receiver of a type not known may have a method of that name, such as\n    // one of std's types\n    None => if !check.known(check.res(i, rt))\n      || contains(env, m)\n      || contains(i.methods.names, m)\n      || contains(i.builtins, m) {\n      None\n    } else {\n      get(i.fns, m)\n    },\n  }\n  match sig {\n    Some(t) => {\n      vars := check.fresh_for(mut i, to_list(check.gens(t, Set[String] {})))\n      ft := check.inst(t, vars)\n      match ft {\n        check.TFn { params, ret } => {\n          what := \"call to `\" + m + \"`\"\n          if len(params) != len(args) + 1 {\n            check.error(mut i, what\n              + \": expects \"\n              + to_string(len(params))\n              + \" arguments, got \"\n              + to_string(len(args) + 1))\n            return ret\n          }\n          check.expect(\n            mut i,\n            get(params, 0) ?? check.TAny,\n            rt,\n            what + \", argument 1\",\n          )\n          for (k, a) in enumerate(args) {\n            p := get(params, k + 1) ?? check.TAny\n            at := check.listed_arg(\n              mut i,\n              m,\n              k,\n              a,\n              p,\n              check.infer(mut i, a, env, Some(p)),\n              what,\n            )\n            check.expect(\n              mut i,\n              p,\n              at,\n              what + \", argument \" + to_string(k + 2),\n            )\n          }\n          // a type's own method with structural bounds: each one met\n          check.error(mut i, \"DEBUG \"\n            + m\n            + \" own=\"\n            + to_string(own is Some)\n            + \" rt=\"\n            + (check.shown(check.res(i, rt)) ?? \"?\")\n            + \" vars=\"\n            + join(keys(vars), \",\")\n            + \" rows=\"\n            + join(keys(i.methods.rows), \",\"))\n          match (own, check.res(i, rt)) {\n            (Some(_), check.TNamed { name, .. }) => match get(i.methods.rows, name + \".\" + m) {\n              Some(rs) => {\n                for (p, fs) in rs {\n                  check.row_met(\n                    mut i,\n                    name + \".\" + m,\n                    fs,\n                    vars,\n                    get(vars, p) ?? check.TAny,\n                  )\n                }\n              },\n              None => (),\n            },\n            _ => (),\n          }\n          ret\n        },\n        _ => check.TAny,\n      }\n    },\n    None => {\n      // a method no `impl`, trait or function has, on one of the program's\n      // types the checker sees every method of\n      match check.res(i, rt) {\n        check.TNamed { name, .. } => if check.program_type(i, name)\n          && !contains(i.methods.foreign, name)\n          && !contains(env, m)\n          && !contains(i.methods.names, m)\n          && get(i.fns, m) is None\n          && get(i.builtins, m) is None {\n          check.error(mut i, \"unknown function `\" + m + \"`\")\n        },\n        _ => (),\n      }\n      // `true.price()`: a method of one of the file's traits, on a value of a\n      // basic or program type, which must implement it\n      match check.res(i, rt) {\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TNamed { .. } => if !contains(env, m) {\n          match check.own_trait_of(i, m) {\n            Some(tr) => mut i.pending.push((rt, tr, m)),\n            None => (),\n          }\n        },\n        _ => (),\n      }\n      check.infer_all(mut i, args, env)\n      check.TAny\n    },\n  }\n}"},{"name":"check.given_for","kind":"fn","old":null,"new":"0d0212e35530be4b","interface_changed":true,"affected":[],"module":"check","text":"/// The type `a`, an argument's, gives type parameter `q` where the\n/// parameter's type `p` names it (`T`, `List[T]`).\nfn given_for(\n  i: check.Inf,\n  p: check.Ty,\n  a: check.Ty,\n  q: String,\n) -> Option[check.Ty] {\n  match (p, check.res(i, a)) {\n    (check.TGen(n), x) => if n == q {\n      Some(x)\n    } else {\n      None\n    },\n    (check.TList(x), check.TList(y)) => check.given_for(i, x, y, q),\n    _ => None,\n  }\n}"}]}
{"id":"d7944a1de1b6d7e4","time":1795719433,"message":"rename eval.at → eval.element_at","changes":[{"name":"eval.element_at","kind":"fn","old":null,"new":"024ca304aeb15024","interface_changed":true,"affected":[],"module":"eval","text":"fn element_at(xs: List[ast.Expr], i: Int) -> Result[ast.Expr, eval.Escape] {\n  match get(xs, i) {\n    Some(x) => Ok(x),\n    None => Err(eval.runtime(\"index \"\n      + to_string(i)\n      + \" out of range (length \"\n      + to_string(len(xs))\n      + \")\")),\n  }\n}"},{"name":"eval.field","kind":"fn","old":"952d4967712fd315","new":"51acfb9a1be91676","interface_changed":false,"affected":[],"module":"eval","text":"/// A field of a value: a record's or variant's by name, a tuple's or\n/// positional variant's by position, a distinct value's `value`.\nfn field(\n  w: eval.World,\n  v: ast.Expr,\n  name: String,\n) -> Result[ast.Expr, eval.Escape] {\n  match v {\n    ast.CtorExpr { args: ast.RecordArgs(fs), .. } => {\n      for f in fs {\n        if f.0 == name {\n          return Ok(f.1)\n        }\n      }\n    },\n    ast.CtorExpr { name: c, args: ast.PositionalArgs(xs) } => {\n      if eval.is_distinct(w, c) && name == \"value\" {\n        return Ok(get(xs, 0) ?? ast.UnitExpr)\n      }\n      match parse_int(name) {\n        Some(i) => return eval.element_at(xs, i),\n        None => (),\n      }\n    },\n    ast.TupleExpr(xs) => match parse_int(name) {\n      Some(i) => return eval.element_at(xs, i),\n      None => (),\n    },\n    _ => (),\n  }\n  Err(eval.runtime(eval.code(v) + \" has no field `\" + name + \"`\"))\n}","old_text":"/// A field of a value: a record's or variant's by name, a tuple's or\n/// positional variant's by position, a distinct value's `value`.\nfn field(\n  w: eval.World,\n  v: ast.Expr,\n  name: String,\n) -> Result[ast.Expr, eval.Escape] {\n  match v {\n    ast.CtorExpr { args: ast.RecordArgs(fs), .. } => {\n      for f in fs {\n        if f.0 == name {\n          return Ok(f.1)\n        }\n      }\n    },\n    ast.CtorExpr { name: c, args: ast.PositionalArgs(xs) } => {\n      if eval.is_distinct(w, c) && name == \"value\" {\n        return Ok(get(xs, 0) ?? ast.UnitExpr)\n      }\n      match parse_int(name) {\n        Some(i) => return eval.at(xs, i),\n        None => (),\n      }\n    },\n    ast.TupleExpr(xs) => match parse_int(name) {\n      Some(i) => return eval.at(xs, i),\n      None => (),\n    },\n    _ => (),\n  }\n  Err(eval.runtime(eval.code(v) + \" has no field `\" + name + \"`\"))\n}"},{"name":"eval.set_path","kind":"fn","old":"34f9082c8f1ec8b8","new":"b1b7b386860284d3","interface_changed":false,"affected":[],"module":"eval","text":"/// The value with the field at `path` set to `x`.\nfn set_path(\n  w: eval.World,\n  v: ast.Expr,\n  path: List[String],\n  x: ast.Expr,\n) -> Result[ast.Expr, eval.Escape] {\n  if len(path) == 0 {\n    return Ok(x)\n  }\n  name := get(path, 0) ?? \"\"\n  rest := drop(path, 1)\n  match v {\n    ast.CtorExpr { name: c, args: ast.RecordArgs(fs) } => {\n      mut out := []\n      mut found := false\n      for f in fs {\n        if f.0 == name {\n          found = true\n          mut out.push((f.0, eval.set_path(w, f.1, rest, x)!))\n        } else {\n          mut out.push(f)\n        }\n      }\n      if found {\n        return Ok(ast.CtorExpr { name: c, args: ast.RecordArgs(out) })\n      }\n    },\n    ast.CtorExpr { name: c, args: ast.PositionalArgs(xs) } => match parse_int(name) {\n      Some(i) => {\n        old := eval.element_at(xs, i)!\n        return Ok(\n          ast.CtorExpr {\n            name: c,\n            args: ast.PositionalArgs(take(xs, i)\n              + [eval.set_path(w, old, rest, x)!]\n              + drop(xs, i + 1)),\n          },\n        )\n      },\n      None => (),\n    },\n    ast.TupleExpr(xs) => match parse_int(name) {\n      Some(i) => {\n        old := eval.element_at(xs, i)!\n        return Ok(ast.TupleExpr(take(xs, i)\n          + [eval.set_path(w, old, rest, x)!]\n          + drop(xs, i + 1)))\n      },\n      None => (),\n    },\n    ast.ListExpr(xs) => match parse_int(name) {\n      Some(i) => {\n        old := eval.element_at(xs, i)!\n        return Ok(ast.ListExpr(take(xs, i)\n          + [eval.set_path(w, old, rest, x)!]\n          + drop(xs, i + 1)))\n      },\n      None => (),\n    },\n    _ => (),\n  }\n  Err(eval.runtime(eval.code(v) + \" has no field `\" + name + \"`\"))\n}","old_text":"/// The value with the field at `path` set to `x`.\nfn set_path(\n  w: eval.World,\n  v: ast.Expr,\n  path: List[String],\n  x: ast.Expr,\n) -> Result[ast.Expr, eval.Escape] {\n  if len(path) == 0 {\n    return Ok(x)\n  }\n  name := get(path, 0) ?? \"\"\n  rest := drop(path, 1)\n  match v {\n    ast.CtorExpr { name: c, args: ast.RecordArgs(fs) } => {\n      mut out := []\n      mut found := false\n      for f in fs {\n        if f.0 == name {\n          found = true\n          mut out.push((f.0, eval.set_path(w, f.1, rest, x)!))\n        } else {\n          mut out.push(f)\n        }\n      }\n      if found {\n        return Ok(ast.CtorExpr { name: c, args: ast.RecordArgs(out) })\n      }\n    },\n    ast.CtorExpr { name: c, args: ast.PositionalArgs(xs) } => match parse_int(name) {\n      Some(i) => {\n        old := eval.at(xs, i)!\n        return Ok(\n          ast.CtorExpr {\n            name: c,\n            args: ast.PositionalArgs(take(xs, i)\n              + [eval.set_path(w, old, rest, x)!]\n              + drop(xs, i + 1)),\n          },\n        )\n      },\n      None => (),\n    },\n    ast.TupleExpr(xs) => match parse_int(name) {\n      Some(i) => {\n        old := eval.at(xs, i)!\n        return Ok(ast.TupleExpr(take(xs, i)\n          + [eval.set_path(w, old, rest, x)!]\n          + drop(xs, i + 1)))\n      },\n      None => (),\n    },\n    ast.ListExpr(xs) => match parse_int(name) {\n      Some(i) => {\n        old := eval.at(xs, i)!\n        return Ok(ast.ListExpr(take(xs, i)\n          + [eval.set_path(w, old, rest, x)!]\n          + drop(xs, i + 1)))\n      },\n      None => (),\n    },\n    _ => (),\n  }\n  Err(eval.runtime(eval.code(v) + \" has no field `\" + name + \"`\"))\n}"},{"name":"eval.builtin","kind":"fn","old":"676413e6983b1cd8","new":"05f653715f33ef0c","interface_changed":false,"affected":[],"module":"eval","text":"fn builtin(\n  mut st: eval.State,\n  w: eval.World,\n  given: String,\n  vs: List[ast.Expr],\n) -> Result[ast.Expr, eval.Escape] {\n  // `xs.sorted()` is the built-in `sort`, returning a new list\n  name := builtins.internal_name(given)\n  // an iterator where a list is wanted: its elements (`join(s.graphemes(), \"\")`)\n  a := match eval.arg(vs, 0) {\n    ast.CtorExpr { .. } => if eval.method_of(w, eval.arg(vs, 0), \"next\") is Some\n      && !(name == \"to_string\" || name == \"debug\" || name == \"print\") {\n      ast.ListExpr(eval.elements(mut st, w, eval.arg(vs, 0))!)\n    } else {\n      eval.arg(vs, 0)\n    },\n    x => x,\n  }\n  b := eval.arg(vs, 1)\n  c := eval.arg(vs, 2)\n  match eval.conversion(name, a) {\n    Some(r) => return r,\n    None => (),\n  }\n  match name {\n    \"print\" => {\n      st.out += eval.display(mut st, w, a)! + \"\\n\"\n      Ok(ast.UnitExpr)\n    },\n    // what std reaches the system through: the run's own output and arguments\n    \"host_write\" => {\n      if a == ast.IntLit(2) {\n        st.err += eval.str_of(b)!\n      } else {\n        st.out += eval.str_of(b)!\n      }\n      Ok(ast.UnitExpr)\n    },\n    \"host_args\" => Ok(eval.str_list(st.args)),\n    // reading files through the run's `Files`. Writing files is not\n    // supported.\n    \"host_read_file\" | \"host_read_bytes\" | \"host_exists\" | \"host_list_dir\" => match st.files {\n      Some(fs) => eval.host_files(fs, name, eval.str_of(a)!),\n      None => Err(eval.runtime(\"the built-in `\"\n        + name\n        + \"` reads files, which compile-time code can't\")),\n    },\n    \"host_env_var\" | \"host_read_line\" => Ok(eval.none()),\n    \"to_string\" => Ok(ast.StrLit(eval.display(mut st, w, a)!)),\n    \"debug\" => Ok(ast.StrLit(eval.show(mut st, w, a)!)),\n    \"len\" => match a {\n      ast.StrLit(_) => Err(eval.runtime(\"a String has no `len`: name the unit\")),\n      _ => Ok(ast.IntLit(len(eval.collection_of(a)!))),\n    },\n    \"contains\" => match (a, b) {\n      (ast.StrLit(s), ast.StrLit(p)) => Ok(ast.BoolLit(contains(s, p))),\n      (ast.DictExpr { entries, .. }, _) => Ok(ast.BoolLit(eval.dict_get(entries, b) is Some)),\n      _ => Ok(ast.BoolLit(contains(eval.collection_of(a)!, b))),\n    },\n    \"get\" => match a {\n      ast.DictExpr { entries, .. } => Ok(eval.option(eval.dict_get(entries, b))),\n      _ => Ok(eval.option(get(eval.list_of(a)!, eval.int_of(b)!))),\n    },\n    \"at\" => eval.element_at(eval.list_of(a)!, eval.int_of(b)!),\n    \"set_at\" => {\n      xs := eval.list_of(a)!\n      i := eval.int_of(b)!\n      _ := eval.element_at(xs, i)!\n      Ok(ast.ListExpr(take(xs, i) + [c] + drop(xs, i + 1)))\n    },\n    \"dict\" => Ok(eval.make_dict(w, eval.list_of(a)!.map(\n      x -> match x {\n        ast.TupleExpr([k, v]) => (k, v),\n        _ => (x, ast.UnitExpr),\n      },\n    ))),\n    \"insert\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.DictExpr {\n        types: [],\n        entries: eval.dict_put(w, entries, b, c),\n      }),\n      ast.SetExpr { elems, .. } => Ok(\n        ast.SetExpr { types: [], elems: eval.set_put(w, elems, b) },\n      ),\n      _ => Err(eval.runtime(\"insert into \" + eval.code(a))),\n    },\n    \"remove\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.DictExpr { types: [], entries: eval.swap_removed(\n        entries,\n        eval.index_where(entries.map(kv -> kv.0), b),\n      ) }),\n      ast.SetExpr { elems, .. } => Ok(ast.SetExpr {\n        types: [],\n        elems: eval.swap_removed(elems, eval.index_where(elems, b)),\n      }),\n      _ => Err(eval.runtime(\"remove from \" + eval.code(a))),\n    },\n    \"keys\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.ListExpr(entries.map(kv -> kv.0))),\n      _ => Err(eval.runtime(\"keys of \" + eval.code(a))),\n    },\n    \"values\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.ListExpr(entries.map(kv -> kv.1))),\n      _ => Err(eval.runtime(\"values of \" + eval.code(a))),\n    },\n    \"items\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.ListExpr(entries.map(kv -> eval.pair(kv.0, kv.1)))),\n      _ => Err(eval.runtime(\"items of \" + eval.code(a))),\n    },\n    \"map_values\" => match a {\n      ast.DictExpr { entries, .. } => {\n        mut out: List[(ast.Expr, ast.Expr)] = []\n        for kv in entries {\n          mut out.push((kv.0, eval.apply(mut st, w, b, [kv.1])!))\n        }\n        Ok(ast.DictExpr { types: [], entries: out })\n      },\n      _ => Err(eval.runtime(\"map_values of \" + eval.code(a))),\n    },\n    \"set\" => Ok(eval.make_set(w, eval.collection_of(a)!)),\n    \"to_list\" => Ok(ast.ListExpr(eval.collection_of(a)!)),\n    \"union\" => Ok(eval.make_set(\n      w,\n      eval.collection_of(a)! + eval.collection_of(b)!,\n    )),\n    \"intersection\" => {\n      ys := eval.collection_of(b)!\n      Ok(eval.make_set(\n        w,\n        eval.collection_of(a)!.filter(x -> contains(ys, x)),\n      ))\n    },\n    \"difference\" => {\n      ys := eval.collection_of(b)!\n      Ok(eval.make_set(\n        w,\n        eval.collection_of(a)!.filter(x -> !contains(ys, x)),\n      ))\n    },\n    \"zip\" => Ok(ast.ListExpr(zip(eval.list_of(a)!, eval.list_of(b)!).map(\n      p -> eval.pair(p.0, p.1),\n    ))),\n    \"enumerate\" => Ok(ast.ListExpr(\n      [eval.pair(ast.IntLit(i), x) for (i, x) in enumerate(eval.list_of(a)!)],\n    )),\n    \"sort\" => Ok(ast.ListExpr(\n      eval.merge_sort(mut st, w, eval.list_of(a)!.map(x -> (x, x))).map(\n        p -> p.1,\n      ),\n    )),\n    \"sort_by\" => {\n      mut keyed := []\n      for x in eval.list_of(a)! {\n        mut keyed.push((eval.apply(mut st, w, b, [x])!, x))\n      }\n      Ok(\n        ast.ListExpr(\n          eval.merge_sort(mut st, w, keyed).map(p -> p.1),\n        ),\n      )\n    },\n    \"reverse\" => match a {\n      ast.StrLit(s) => Ok(ast.StrLit(s.reversed())),\n      _ => Ok(ast.ListExpr(eval.list_of(a)!.reversed())),\n    },\n    \"join\" => Ok(\n      ast.StrLit(join(eval.strs(eval.list_of(a)!), eval.str_of(b)!)),\n    ),\n    \"split\" => Ok(eval.str_list(split(eval.str_of(a)!, eval.str_of(b)!))),\n    \"trim\" => Ok(ast.StrLit(trim(eval.str_of(a)!))),\n    \"lines\" => Ok(eval.str_list(lines(eval.str_of(a)!))),\n    \"parse_int\" => Ok(eval.option(match parse_int(eval.str_of(a)!) {\n      Some(n) => Some(ast.IntLit(n)),\n      None => None,\n    })),\n    \"parse_float\" => Ok(eval.option(match parse_float(eval.str_of(a)!) {\n      Some(f) => Some(ast.FloatLit(f)),\n      None => None,\n    })),\n    \"float\" => {\n      n := eval.int_of(a)!\n      // the Ints that round to a finite Float\n      big := (1 << 1024) - (1 << 970)\n      if n >= big || n <= -big {\n        return Err(\n          eval.runtime(to_string(n) + \" is too large for a Float\"),\n        )\n      }\n      Ok(ast.FloatLit(float(n)))\n    },\n    \"floor\" | \"ceil\" | \"round\" => {\n      f := eval.float_of(a)!\n      r := match name {\n        \"floor\" => checked_floor(f),\n        \"ceil\" => checked_ceil(f),\n        _ => checked_round(f),\n      }\n      match r {\n        Some(n) => Ok(ast.IntLit(n)),\n        None => Err(\n          eval.runtime(\n            text.plain_float(f) + \" is not a whole number\",\n          ),\n        ),\n      }\n    },\n    \"checked_add\" | \"checked_sub\" | \"checked_mul\" | \"checked_div\" | \"checked_rem\" => {\n      (x, y) := (eval.float_of(a)!, eval.float_of(b)!)\n      r := match name {\n        \"checked_add\" => checked_add(x, y),\n        \"checked_sub\" => checked_sub(x, y),\n        \"checked_mul\" => checked_mul(x, y),\n        \"checked_div\" => checked_div(x, y),\n        _ => checked_rem(x, y),\n      }\n      Ok(eval.option(match r {\n        Some(f) => Some(ast.FloatLit(f)),\n        None => None,\n      }))\n    },\n    \"checked_sqrt\" => Ok(eval.option(match checked_sqrt(eval.float_of(a)!) {\n      Some(f) => Some(ast.FloatLit(f)),\n      None => None,\n    })),\n    \"checked_floor\" | \"checked_ceil\" | \"checked_round\" => {\n      x := eval.float_of(a)!\n      r := match name {\n        \"checked_floor\" => checked_floor(x),\n        \"checked_ceil\" => checked_ceil(x),\n        _ => checked_round(x),\n      }\n      Ok(eval.option(match r {\n        Some(n) => Some(ast.IntLit(n)),\n        None => None,\n      }))\n    },\n    \"sqrt\" => {\n      f := eval.float_of(a)!\n      match checked_sqrt(f) {\n        Some(r) => Ok(ast.FloatLit(r)),\n        None => Err(eval.runtime(\n          \"sqrt of negative number \" + text.plain_float(f),\n        )),\n      }\n    },\n    \"map\" => {\n      mut out := []\n      for x in eval.list_of(a)! {\n        mut out.push(eval.apply(mut st, w, b, [x])!)\n      }\n      Ok(ast.ListExpr(out))\n    },\n    \"filter\" => {\n      mut out := []\n      for x in eval.list_of(a)! {\n        if eval.truth(eval.apply(mut st, w, b, [x])!)! {\n          mut out.push(x)\n        }\n      }\n      Ok(ast.ListExpr(out))\n    },\n    \"fold\" => {\n      mut acc := b\n      for x in eval.list_of(a)! {\n        acc = eval.apply(mut st, w, c, [acc, x])!\n      }\n      Ok(acc)\n    },\n    \"all\" => {\n      for x in eval.list_of(a)! {\n        if !eval.truth(eval.apply(mut st, w, b, [x])!)! {\n          return Ok(ast.BoolLit(false))\n        }\n      }\n      Ok(ast.BoolLit(true))\n    },\n    \"any\" => {\n      for x in eval.list_of(a)! {\n        if eval.truth(eval.apply(mut st, w, b, [x])!)! {\n          return Ok(ast.BoolLit(true))\n        }\n      }\n      Ok(ast.BoolLit(false))\n    },\n    \"find\" => {\n      for x in eval.list_of(a)! {\n        if eval.truth(eval.apply(mut st, w,