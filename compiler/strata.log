oops","with_base","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","codegen.read_back","eval_files"],"module":"codegen","text":"/// Whether a value of small type `t` can take another's words in its own\n/// block (`assign_held`): every constructor with fields has as many, so\n/// any block of the type has room for any value of it.\nfn reusable(g: codegen.Gen, t: check.Ty) -> Bool {\n  (_, cs) := codegen.small_layout(g, t)\n  sizes := cs.filter(c -> len(c.1) > 0).map(c -> len(c.1))\n  codegen.small_words(g, t) > 0\n    && sizes.all(s -> s == get(sizes, 0) ?? 0)\n}","old_text":"/// Whether a value of small type `t` can take another's words in its own\n/// block (`assign_held`): every constructor with fields has as many, so\n/// any block of the type has room for any value of it.\nfn reusable(g: codegen.Gen, t: Ty) -> Bool {\n  (_, cs) := codegen.small_layout(g, t)\n  sizes := cs.filter(c -> len(c.1) > 0).map(c -> len(c.1))\n  codegen.small_words(g, t) > 0\n    && sizes.all(s -> s == get(sizes, 0) ?? 0)\n}"},{"name":"codegen.has_field_check","kind":"fn","old":"c224c125491e5e82","new":"853cdc88ac8453ba","interface_changed":false,"affected":[],"module":"codegen","text":"/// Faults unless sum value `v` is a variant with field `f`, when some\n/// variants of its type lack it and `verify` didn't prove it (\"field `f`\n/// of a call's result\").\nfn has_field_check(mut g: codegen.Gen, v: codegen.V, f: String) {\n  cs := codegen.ctors_of(g, v.ty)\n  having := cs.filter(c -> codegen.fields_of(g, c, v.ty).any(x -> x.0 == f))\n  if len(having) == 0 || len(having) == len(cs) {\n    return\n  }\n  what := f\"field `{f}` of a call's result\"\n  if codegen.proven(mut g, what, \"exact\") {\n    return\n  }\n  mut ok := codegen.tag_is(mut g, v, get(having, 0) ?? \"\")\n  for c in drop(having, 1) {\n    b := codegen.tag_is(mut g, v, c)\n    r := codegen.fresh(mut g, \"or\")\n    codegen.emit(mut g, f\"{r} = or i1 {ok.op}, {b.op}\")\n    ok = codegen.V { ty: check.TBool, op: r }\n  }\n  codegen.fail_unless(mut g, ok, what, [], v, \"has no such field\")\n}","old_text":"/// Faults unless sum value `v` is a variant with field `f`, when some\n/// variants of its type lack it and `verify` didn't prove it (\"field `f`\n/// of a call's result\").\nfn has_field_check(mut g: codegen.Gen, v: codegen.V, f: String) {\n  cs := codegen.ctors_of(g, v.ty)\n  having := cs.filter(c -> codegen.fields_of(g, c, v.ty).any(x -> x.0 == f))\n  if len(having) == 0 || len(having) == len(cs) {\n    return\n  }\n  what := f\"field `{f}` of a call's result\"\n  if codegen.proven(mut g, what, \"exact\") {\n    return\n  }\n  mut ok := codegen.tag_is(mut g, v, get(having, 0) ?? \"\")\n  for c in drop(having, 1) {\n    b := codegen.tag_is(mut g, v, c)\n    r := codegen.fresh(mut g, \"or\")\n    codegen.emit(mut g, f\"{r} = or i1 {ok.op}, {b.op}\")\n    ok = codegen.V { ty: TBool, op: r }\n  }\n  codegen.fail_unless(mut g, ok, what, [], v, \"has no such field\")\n}"},{"name":"diff.node_lines","kind":"fn","old":"74a0506cea925847","new":"caf29e5630617fe0","interface_changed":false,"affected":[],"module":"diff","text":"/// The lines of a change from `o` to `n`, from the nodes that changed\n/// (`cs`, `tree.changes`): each side is printed with its changed nodes\n/// placed. Lines are lined up by their text, without indentation, and by\n/// the changed nodes on them, so a line holding a changed node never\n/// counts as unchanged. A removed and an added line that are similar (as\n/// `line_diff` pairs them), first those holding the same change, are one\n/// line changed in place: the text around the nodes kept, each\n/// node's old and new text compared word by word (`line_segs`). The `Bool` is\n/// true when most lines changed; then\n/// nothing is paired. `None` when a side doesn't print with its nodes\n/// placed as it prints alone.\nfn node_lines(\n  o: ast.Decl,\n  n: ast.Decl,\n  cs: List[tree.Change],\n) -> Option[(List[diff.Line], Bool)] {\n  olds := [(c.old, k) for (k, c) in enumerate(cs) where c.kind != \"added\" && c.old != \"\"]\n  news := [(c.new, k) for (k, c) in enumerate(cs) where c.kind != \"removed\" && c.new != \"\"]\n  (la, sa) := diff.placed_code(o, olds)?\n  (lb, sb) := diff.placed_code(n, news)?\n  key := (l: String, ss: List[(Int, Int, Int)]) -> diff.trim_start(l)\n    + join(\n      ss.map(\n        s -> \"\\u{1}\" + diff.trim_start(byte_slice(l, s.0, s.1)),\n      ),\n      \"\",\n    )\n  ka := [key(l, get(sa, i) ?? []) for (i, l) in enumerate(la)]\n  kb := [key(l, get(sb, i) ?? []) for (i, l) in enumerate(lb)]\n  ops := diff.lcs(ka, kb)\n  changed := len(ops.filter(x -> x.0 != 0))\n  total := len(la) + len(lb)\n  rewritten := total > 8 && changed * 10 >= total * 6\n  kinds := cs.map(c -> c.kind)\n  mut out := []\n  mut k := 0\n  while k < len(ops) {\n    (op, _, j) := get(ops, k) ?? (0, 0, 0)\n    if op == 0 {\n      mut out.push(diff.Line { s: \" \", text: get(lb, j) ?? \"\" })\n      k += 1\n      continue\n    }\n    mut dels := []\n    mut ins := []\n    while k < len(ops) && (get(ops, k) ?? (0, 0, 0)).0 != 0 {\n      (x, a, b) := get(ops, k) ?? (0, 0, 0)\n      if x == 1 {\n        mut dels.push(a)\n      } else {\n        mut ins.push(b)\n      }\n      k += 1\n    }\n    line_a := (i: Int) -> get(la, i) ?? \"\"\n    line_b := (i: Int) -> get(lb, i) ?? \"\"\n    moved_only := (ss: List[(Int, Int, Int)]) ->\n      ss != [] && ss.all(s -> get(kinds, s.2) == Some(\"moved\"))\n    if rewritten {\n      out = out\n        + dels.map(d -> diff.Line { s: \"-\", text: line_a(d) })\n        + ins.map(i -> diff.Line { s: \"+\", text: line_b(i) })\n      continue\n    }\n    mut next := 0\n    for d in dels {\n      ds := get(sa, d) ?? []\n      changes_a := set(\n        ds.map(s -> s.2).filter(c -> get(kinds, c) != Some(\"moved\")),\n      )\n      mut found := -1\n      mut j2 := next\n      // a similar line holding one of its changes, else any similar line\n      while j2 < len(ins) && found < 0 {\n        bs := get(sb, get(ins, j2) ?? 0) ?? []\n        if bs.any(s -> contains(changes_a, s.2))\n          && diff.close(line_a(d), line_b(get(ins, j2) ?? 0)) {\n          found = j2\n        }\n        j2 += 1\n      }\n      j2 = next\n      while j2 < len(ins) && found < 0 {\n        if diff.close(line_a(d), line_b(get(ins, j2) ?? 0)) {\n          found = j2\n        }\n        j2 += 1\n      }\n      if found >= 0 {\n        out += slice(ins, next, found).map(\n          i -> diff.Line {\n            s: \"+\",\n            text: line_b(i),\n            note: if moved_only(get(sb, i) ?? []) {\n              \"moved\"\n            } else {\n              \"\"\n            },\n          },\n        )\n        y := get(ins, found) ?? 0\n        segs := diff.line_segs(line_a(d), ds, line_b(y), get(sb, y) ?? [])\n        mut out.push(\n          if segs.all(s -> s.k == \"=\") {\n            diff.Line { s: \" \", text: line_b(y) }\n          } else {\n            diff.Line { s: \"~\", text: line_b(y), segs }\n          },\n        )\n        next = found + 1\n      } else {\n        mut out.push(\n          diff.Line {\n            s: \"-\",\n            text: line_a(d),\n            note: if moved_only(ds) {\n              \"moved\"\n            } else {\n              \"\"\n            },\n          },\n        )\n      }\n    }\n    out += slice(ins, next, len(ins)).map(\n      i -> diff.Line {\n        s: \"+\",\n        text: line_b(i),\n        note: if moved_only(get(sb, i) ?? []) {\n          \"moved\"\n        } else {\n          \"\"\n        },\n      },\n    )\n  }\n  Some((out, rewritten))\n}","old_text":"/// The lines of a change from `o` to `n`, from the nodes that changed\n/// (`cs`, `tree.changes`): each side is printed with its changed nodes\n/// placed. Lines are lined up by their text, without indentation, and by\n/// the changed nodes on them, so a line holding a changed node never\n/// counts as unchanged. A removed and an added line that are similar (as\n/// `line_diff` pairs them), first those holding the same change, are one\n/// line changed in place: the text around the nodes kept, each\n/// node's old and new text compared word by word (`line_segs`). The `Bool` is\n/// true when most lines changed; then\n/// nothing is paired. `None` when a side doesn't print with its nodes\n/// placed as it prints alone.\nfn node_lines(\n  o: ast.Decl,\n  n: ast.Decl,\n  cs: List[tree.Change],\n) -> Option[(List[diff.Line], Bool)] {\n  olds := [(c.old, k) for (k, c) in enumerate(cs) where c.kind != \"added\" && c.old != \"\"]\n  news := [(c.new, k) for (k, c) in enumerate(cs) where c.kind != \"removed\" && c.new != \"\"]\n  (la, sa) := diff.placed_code(o, olds)?\n  (lb, sb) := diff.placed_code(n, news)?\n  key := (l: String, ss: List[(Int, Int, Int)]) -> diff.trim_start(l)\n    + join(\n      ss.map(\n        s -> \"\\u{1}\" + diff.trim_start(byte_slice(l, s.0, s.1)),\n      ),\n      \"\",\n    )\n  ka := [key(l, get(sa, i) ?? []) for (i, l) in enumerate(la)]\n  kb := [key(l, get(sb, i) ?? []) for (i, l) in enumerate(lb)]\n  ops := diff.lcs(ka, kb)\n  changed := len(ops.filter(x -> x.0 != 0))\n  total := len(la) + len(lb)\n  rewritten := total > 8 && changed * 10 >= total * 6\n  kinds := cs.map(c -> c.kind)\n  mut out := []\n  mut k := 0\n  while k < len(ops) {\n    (op, _, j) := get(ops, k) ?? (0, 0, 0)\n    if op == 0 {\n      mut out.push(diff.Line { s: \" \", text: get(lb, j) ?? \"\" })\n      k += 1\n      continue\n    }\n    mut dels := []\n    mut ins := []\n    while k < len(ops) && (get(ops, k) ?? (0, 0, 0)).0 != 0 {\n      (x, a, b) := get(ops, k) ?? (0, 0, 0)\n      if x == 1 {\n        mut dels.push(a)\n      } else {\n        mut ins.push(b)\n      }\n      k += 1\n    }\n    line_a := (i: Int) -> get(la, i) ?? \"\"\n    line_b := (i: Int) -> get(lb, i) ?? \"\"\n    moved_only := (ss: List[(Int, Int, Int)]) ->\n      ss != [] && ss.all(s -> get(kinds, s.2) == Some(\"moved\"))\n    if rewritten {\n      out = out\n        + dels.map(d -> diff.Line { s: \"-\", text: line_a(d) })\n        + ins.map(i -> diff.Line { s: \"+\", text: line_b(i) })\n      continue\n    }\n    mut next := 0\n    for d in dels {\n      ds := get(sa, d) ?? []\n      changes_a := set(\n        ds.map(s -> s.2).filter(c -> get(kinds, c) != Some(\"moved\")),\n      )\n      mut found := -1\n      mut j2 := next\n      // a similar line holding one of its changes, else any similar line\n      while j2 < len(ins) && found < 0 {\n        bs := get(sb, get(ins, j2) ?? 0) ?? []\n        if bs.any(s -> contains(changes_a, s.2))\n          && diff.close(line_a(d), line_b(get(ins, j2) ?? 0)) {\n          found = j2\n        }\n        j2 += 1\n      }\n      j2 = next\n      while j2 < len(ins) && found < 0 {\n        if diff.close(line_a(d), line_b(get(ins, j2) ?? 0)) {\n          found = j2\n        }\n        j2 += 1\n      }\n      if found >= 0 {\n        out += slice(ins, next, found).map(\n          i -> diff.Line {\n            s: \"+\",\n            text: line_b(i),\n            note: if moved_only(get(sb, i) ?? []) {\n              \"moved\"\n            } else {\n              \"\"\n            },\n          },\n        )\n        y := get(ins, found) ?? 0\n        segs := diff.line_segs(line_a(d), ds, line_b(y), get(sb, y) ?? [])\n        mut out.push(\n          if segs.all(s -> s.k == \"=\") {\n            diff.Line { s: \" \", text: line_b(y) }\n          } else {\n            diff.Line { s: \"~\", text: line_b(y), segs }\n          },\n        )\n        next = found + 1\n      } else {\n        mut out.push(\n          diff.Line {\n            s: \"-\",\n            text: line_a(d),\n            note: if moved_only(ds) {\n              \"moved\"\n            } else {\n              \"\"\n            },\n          },\n        )\n      }\n    }\n    out += slice(ins, next, len(ins)).map(\n      i -> diff.Line {\n        s: \"+\",\n        text: line_b(i),\n        note: if moved_only(get(sb, i) ?? []) {\n          \"moved\"\n        } else {\n          \"\"\n        },\n      },\n    )\n  }\n  Some((out, rewritten))\n}"},{"name":"edit_file","kind":"fn","old":"ebe6872724e993be","new":"f83937dd614fc773","interface_changed":false,"affected":[],"module":"","text":"/// `strata --file F edit [MODULE]` (or `add`): a script, or a folder's\n/// module, changed outside any log (created if new). The result is checked,\n/// then written, each file in one step (`codebase.write_file`): what\n/// doesn't check is rejected with its errors and exit code 1, and no file\n/// changes (with `--as-given`, for a script written in steps: written all\n/// the same, with its errors and exit code 1). A module file of a package\n/// isn't checked alone. The functions changed that have loops then get the\n/// invariants\n/// a search finds, as `apply_edit` does.\nfn edit_file(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  f: String,\n  args: List[String],\n  cmd: String,\n) -> std.process.ExitCode {\n  a := match edit_args(args) {\n    Ok(a) => a,\n    Err(e) => return fail_with(mut console, e),\n  }\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  core := read_core_at(disk, home)\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  is_dir := disk.is_dir(f) || ends_with(f, \"/\")\n  path := if ends_with(f, \"/\") {\n    byte_slice(f, 0, byte_len(f) - 1)\n  } else {\n    f\n  }\n  // a module file in a package is the module its path names\n  root := if is_dir {\n    None\n  } else {\n    codebase.find_root(disk, if codebase.parent(path) == \"\" {\n      \".\"\n    } else {\n      codebase.parent(path)\n    })\n  }\n  in_package := match root {\n    Some(r) => {\n      prefix := r + \"/\"\n      rel := if starts_with(path, prefix) {\n        byte_slice(path, byte_len(prefix), byte_len(path))\n      } else {\n        path\n      }\n      Some(deps.module_name(module_prefix(disk, r), rel))\n    },\n    None => None,\n  }\n  // core's folder: its modules by their names (`core.gen`), its files by\n  // theirs (`gen.strata`)\n  in_core := is_dir && disk.exists(path) && package_name(disk, path) == \"core\"\n  old := if !disk.exists(path) {\n    []\n  } else if is_dir {\n    package_decls(disk, path, if in_core {\n      \"core\"\n    } else {\n      \"\"\n    })\n  } else {\n    decls_of(disk, path)\n  }\n  module := match in_package {\n    Some(m) => m,\n    None => if in_core {\n      m := edit_module(a.module ?? \"\")\n      if starts_with(m, \"core.\") || m == \"\" {\n        m\n      } else {\n        \"core.\" + m\n      }\n    } else if is_dir {\n      edit_module(a.module ?? \"\")\n    } else {\n      match old {\n        [d, ..] => d.module,\n        [] => \"\",\n      }\n    },\n  }\n  // (`--rm NAME`: a qualified name, or a short one naming one definition)\n  given_removes := match removed_names(old, module, a.removes) {\n    Ok(rs) => rs,\n    Err(e) => return fail_with(mut console, e),\n  }\n  text := if cmd == \"add\" {\n    disk.read(a.module ?? \"\") !! \"\"\n  } else {\n    match piped_input(\n      mut console,\n      len(given_removes) > 0,\n      \"strata --file F edit\",\n    ) {\n      Ok(t) => t,\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  parsed := match parse.parse_module(text, module) {\n    Ok(ds) => ds,\n    Err(e) => return fail_with(mut console, f\"parse error at {e}\"),\n  }\n  // (text read back from a view: the proof material it hid is put back)\n  edits := if a.proofs || cmd == \"add\" {\n    parsed\n  } else {\n    (kept, notes) := views.proofs_kept(resolve.written(old, std, core), parsed)\n    for n in notes {\n      mut console.eprint(\"warning: \" + n)\n    }\n    kept\n  }\n  match both_given_and_removed(edits, given_removes) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  // (a declaration given drops its stored derives that are no longer on its\n  // `derive A, B for` line)\n  dropped := codebase.dropped_derives(old, edits).filter(\n    q -> !contains(given_removes, q),\n  )\n  removes := given_removes + dropped\n  // (a package's other modules, for its references)\n  others := match root {\n    Some(r) => package_decls(disk, r, \"\").filter(d -> d.module != module),\n    None => [],\n  }\n  // (core's files keep their names as written: core's names are global)\n  of_core := in_core\n    || match root {\n      Some(r) => package_name(disk, r) == \"core\",\n      None => false,\n    }\n  new := if of_core {\n    codebase.merge_parsed(old, edits, removes)\n  } else {\n    codebase.merge(old, edits, removes, std + others, core)\n  }\n  if new == old && disk.exists(path) {\n    // every definition given is as stored: nothing written or checked\n    mut console.print(\n      f\"{f}: no changes: every definition given is as stored (nothing written or checked)\",\n    )\n    return 0\n  }\n  // checked before anything is written: an edit that doesn't check\n  // leaves every file as it was (core checks only as the runtime's\n  // compilation does, `strata build-core`; a module file of a package\n  // isn't checked alone, its neighbours may not be written yet)\n  alone := !of_core\n    && in_package is None\n    && (is_dir || new.all(d -> d.module == \"\"))\n  errors := if alone {\n    lib := std_imports(disk, std_dir, new)\n    sh := shared_at(disk, cache.caches_of(process), home_of_std(std_dir))\n    // (`comptime e` compiled, as `check` runs it, with its budget of steps: a\n    // runaway one is an error instead of a hang)\n    std_use_check(\n        disk,\n        std_dir,\n        new,\n        use_errors_of(new, lib, Set[String] {}, core),\n      )\n      + warned(mut console, check_errors_with(\n        new,\n        lib,\n        core,\n        is_dir && package_reads_values(disk, path),\n        comptime_runner(disk, sh),\n      ))\n      + literal_errors_of(disk, new, lib, core, path, sh, [])\n  } else {\n    []\n  }\n  n := len(errors)\n  if n > 0 && !a.as_given {\n    mut console.eprint(\n      f\"rejected: {f} doesn't check ({n} error{plural(n, \"\", \"s\")}; nothing was written; `--as-given` writes it all the same):\",\n    )\n    for l in errors {\n      mut console.eprint(\"  \" + error_text(l))\n    }\n    return 1\n  }\n  if is_dir {\n    match codebase.write_modules(mut disk, path, old, new, false) {\n      Err(e) => return fail_with(mut console, e),\n      Ok(_) => (),\n    }\n  } else {\n    if codebase.parent(path) != \"\" {\n      mut disk.make_dir(codebase.parent(path)) !! ()\n    }\n    // (the definitions that didn't change keep their stored bytes)\n    bytes := codebase.module_bytes(\n      disk.read_bytes(path) !! [],\n      module,\n      new,\n      old,\n      others + new,\n      false,\n    )\n    match codebase.write_file(mut disk, path, bytes) {\n      Err(e) => return fail_with(mut console, e),\n      Ok(_) => (),\n    }\n  }\n  cs := codebase.changes(old, new, false)\n  mut console.print(\n    f\"{f}: {len(cs)} definition{plural(len(cs), \"\", \"s\")} changed, {len(new)} in all\",\n  )\n  for q in dropped.filter(q -> !new.any(d -> store.qname(d) == q)) {\n    mut console.print(dropped_warning(q))\n  }\n  for w in edit_warnings(new, cs.map(c -> c.name), core) {\n    mut console.print(w)\n  }\n  if !of_core {\n    roots := unused_setting(disk, root ?? path).0\n    for w in edit_unused(\n      old + others,\n      new + others,\n      cs.map(c -> c.name),\n      core,\n      roots,\n    ) {\n      mut console.print(w.2)\n    }\n  }\n  if n > 0 {\n    mut console.eprint(\n      f\"written as given: {f} doesn't check ({n} error{plural(n, \"\", \"s\")}):\",\n    )\n    for l in errors {\n      mut console.eprint(\"  \" + error_text(l))\n    }\n    return 1\n  }\n  // the loops of the functions changed: invariants searched for where\n  // those derived from the code don't prove their checks, and written\n  looped := loop_functions(new, cs.map(c -> c.name))\n  if a.search && looped != [] && !of_core {\n    _ := search_invariants(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      cache.caches_of(process),\n      path,\n      looped,\n      \"edit\",\n      false,\n    )\n  }\n  0\n}","old_text":"/// `strata --file F edit [MODULE]` (or `add`): a script, or a folder's\n/// module, changed outside any log (created if new). The result is checked,\n/// then written, each file in one step (`codebase.write_file`): what\n/// doesn't check is rejected with its errors and exit code 1, and no file\n/// changes (with `--as-given`, for a script written in steps: written all\n/// the same, with its errors and exit code 1). A module file of a package\n/// isn't checked alone. The functions changed that have loops then get the\n/// invariants\n/// a search finds, as `apply_edit` does.\nfn edit_file(\n  mut console: std.io.Console,\n  mut disk: std.fs.Disk,\n  mut launcher: std.process.Launcher,\n  process: std.process.Process,\n  f: String,\n  args: List[String],\n  cmd: String,\n) -> std.process.ExitCode {\n  a := match edit_args(args) {\n    Ok(a) => a,\n    Err(e) => return fail_with(mut console, e),\n  }\n  home := process.var(\"STRATA_HOME\") ?? \"\"\n  std_dir := if home == \"\" {\n    \"std\"\n  } else {\n    home + \"/std\"\n  }\n  core := read_core_at(disk, home)\n  std := module_decls(\n    disk,\n    deps.module_files(disk, std_dir).map(rel -> std_dir + \"/\" + rel),\n  )\n  is_dir := disk.is_dir(f) || ends_with(f, \"/\")\n  path := if ends_with(f, \"/\") {\n    byte_slice(f, 0, byte_len(f) - 1)\n  } else {\n    f\n  }\n  // a module file in a package is the module its path names\n  root := if is_dir {\n    None\n  } else {\n    codebase.find_root(disk, if codebase.parent(path) == \"\" {\n      \".\"\n    } else {\n      codebase.parent(path)\n    })\n  }\n  in_package := match root {\n    Some(r) => {\n      prefix := r + \"/\"\n      rel := if starts_with(path, prefix) {\n        byte_slice(path, byte_len(prefix), byte_len(path))\n      } else {\n        path\n      }\n      Some(deps.module_name(module_prefix(disk, r), rel))\n    },\n    None => None,\n  }\n  // core's folder: its modules by their names (`core.gen`), its files by\n  // theirs (`gen.strata`)\n  in_core := is_dir && disk.exists(path) && package_name(disk, path) == \"core\"\n  old := if !disk.exists(path) {\n    []\n  } else if is_dir {\n    package_decls(disk, path, if in_core {\n      \"core\"\n    } else {\n      \"\"\n    })\n  } else {\n    decls_of(disk, path)\n  }\n  module := match in_package {\n    Some(m) => m,\n    None => if in_core {\n      m := edit_module(a.module ?? \"\")\n      if starts_with(m, \"core.\") || m == \"\" {\n        m\n      } else {\n        \"core.\" + m\n      }\n    } else if is_dir {\n      edit_module(a.module ?? \"\")\n    } else {\n      match old {\n        [d, ..] => d.module,\n        [] => \"\",\n      }\n    },\n  }\n  // (`--rm NAME`: a qualified name, or a short one naming one definition)\n  given_removes := match removed_names(old, module, a.removes) {\n    Ok(rs) => rs,\n    Err(e) => return fail_with(mut console, e),\n  }\n  text := if cmd == \"add\" {\n    disk.read(a.module ?? \"\") !! \"\"\n  } else {\n    match piped_input(\n      mut console,\n      len(given_removes) > 0,\n      \"strata --file F edit\",\n    ) {\n      Ok(t) => t,\n      Err(e) => return fail_with(mut console, e),\n    }\n  }\n  parsed := match parse.parse_module(text, module) {\n    Ok(ds) => ds,\n    Err(e) => return fail_with(mut console, f\"parse error at {e}\"),\n  }\n  // (text read back from a view: the proof material it hid is put back)\n  edits := if a.proofs || cmd == \"add\" {\n    parsed\n  } else {\n    (kept, notes) := views.proofs_kept(resolve.written(old, std, core), parsed)\n    for n in notes {\n      mut console.eprint(\"warning: \" + n)\n    }\n    kept\n  }\n  match both_given_and_removed(edits, given_removes) {\n    Some(e) => return fail_with(mut console, e),\n    None => (),\n  }\n  // (a declaration given drops its stored derives that are no longer on its\n  // `derive A, B for` line)\n  dropped := codebase.dropped_derives(old, edits).filter(\n    q -> !contains(given_removes, q),\n  )\n  removes := given_removes + dropped\n  // (a package's other modules, for its references)\n  others := match root {\n    Some(r) => package_decls(disk, r, \"\").filter(d -> d.module != module),\n    None => [],\n  }\n  // (core's files keep their names as written: core's names are global)\n  of_core := in_core\n    || match root {\n      Some(r) => package_name(disk, r) == \"core\",\n      None => false,\n    }\n  new := if of_core {\n    codebase.merge_parsed(old, edits, removes)\n  } else {\n    codebase.merge(old, edits, removes, std + others, core)\n  }\n  if new == old && disk.exists(path) {\n    // every definition given is as stored: nothing written or checked\n    mut console.print(\n      f\"{f}: no changes: every definition given is as stored (nothing written or checked)\",\n    )\n    return 0\n  }\n  // checked before anything is written: an edit that doesn't check\n  // leaves every file as it was (core checks only as the runtime's\n  // compilation does, `strata build-core`; a module file of a package\n  // isn't checked alone, its neighbours may not be written yet)\n  alone := !of_core\n    && in_package is None\n    && (is_dir || new.all(d -> d.module == \"\"))\n  errors := if alone {\n    lib := std_imports(disk, std_dir, new)\n    sh := shared_at(disk, cache.caches_of(process), home_of_std(std_dir))\n    // (`comptime e` compiled, as `check` runs it, with its budget of steps: a\n    // runaway one is an error instead of a hang)\n    std_use_check(\n        disk,\n        std_dir,\n        new,\n        use_errors_of(new, lib, Set[String] {}, core),\n      )\n      + warned(mut console, check_errors_with(\n        new,\n        lib,\n        core,\n        is_dir && package_reads_values(disk, path),\n        comptime_runner(disk, sh),\n      ))\n      + literal_errors_of(disk, new, lib, core, path, sh, [])\n  } else {\n    []\n  }\n  n := len(errors)\n  if n > 0 && !a.as_given {\n    mut console.eprint(\n      f\"rejected: {f} doesn't check ({n} error{plural(n, \"\", \"s\")}; nothing was written; `--as-given` writes it all the same):\",\n    )\n    for l in errors {\n      mut console.eprint(\"  \" + error_text(l))\n    }\n    return 1\n  }\n  if is_dir {\n    match codebase.write_modules(mut disk, path, old, new, false) {\n      Err(e) => return fail_with(mut console, e),\n      Ok(_) => (),\n    }\n  } else {\n    if codebase.parent(path) != \"\" {\n      mut disk.make_dir(codebase.parent(path)) !! ()\n    }\n    // (the definitions that didn't change keep their stored bytes)\n    bytes := codebase.module_bytes(\n      disk.read_bytes(path) !! [],\n      module,\n      new,\n      old,\n      others + new,\n      false,\n    )\n    match codebase.write_file(mut disk, path, bytes) {\n      Err(e) => return fail_with(mut console, e),\n      Ok(_) => (),\n    }\n  }\n  cs := codebase.changes(old, new, false)\n  mut console.print(\n    f\"{f}: {len(cs)} definition{plural(len(cs), \"\", \"s\")} changed, {len(new)} in all\",\n  )\n  for q in dropped.filter(q -> !new.any(d -> store.qname(d) == q)) {\n    mut console.print(dropped_warning(q))\n  }\n  for w in edit_warnings(new, cs.map(c -> c.name), core) {\n    mut console.print(w)\n  }\n  if !of_core {\n    roots := unused_setting(disk, root ?? path).0\n    for w in edit_unused(\n      old + others,\n      new + others,\n      cs.map(c -> c.name),\n      core,\n      roots,\n    ) {\n      mut console.print(w.2)\n    }\n  }\n  if n > 0 {\n    mut console.eprint(\n      f\"written as given: {f} doesn't check ({n} error{plural(n, \"\", \"s\")}):\",\n    )\n    for l in errors {\n      mut console.eprint(\"  \" + error_text(l))\n    }\n    return 1\n  }\n  // the loops of the functions changed: invariants searched for where\n  // those derived from the code don't prove their checks, and written\n  looped := loop_functions(new, cs.map(c -> c.name))\n  if a.search && looped != [] && !of_core {\n    _ := search_invariants(\n      mut console,\n      mut disk,\n      mut launcher,\n      process,\n      cache.caches_of(process),\n      path,\n      looped,\n      \"edit\",\n      false,\n    )\n  }\n  0\n}"},{"name":"tour.Names","kind":"type","old":"c82d6494ad0056ac","new":"5175876ae04c4d85","interface_changed":false,"affected":[],"module":"tour","text":"/// Every name a tour gives, by block: `strata-diff`, routine lines (as\n/// written: globs too), `strata`, `strata-refs` and `strata-also` lines (as\n/// written).\npub type Names = {\n  diffs: List[String],\n  routine: List[String],\n  code: List[String],\n  refs: List[String],\n  also: List[String],\n}","old_text":"/// Every name a tour gives, by block: `strata-diff`, routine lines (as\n/// written: globs too), `strata`, `strata-refs` and `strata-also` lines (as\n/// written).\npub type Names = {\n  diffs: List[String],\n  routine: List[String],\n  code: List[String],\n  refs: List[String],\n  also: List[String],\n}"},{"name":"tree.type_slots","kind":"fn","old":"00b3f7b8a553a203","new":"316ef37a5e782f4c","interface_changed":false,"affected":[],"module":"tree","text":"fn type_slots(t: ast.TypeExpr) -> List[tree.Slot] {\n  match t {\n    ast.Named { args, .. } => [tree.many(\"args\", 4, tree.ts(args))],\n    ast.FnType { params, ret } => [\n      tree.many(\"params\", 4, tree.ts(params)),\n      tree.one(\"ret\", tree.TN(ret)),\n    ],\n    ast.Refined { base, pred } => [\n      tree.one(\"base\", tree.TN(base)),\n      tree.one(\"pred\", tree.EN(pred)),\n    ],\n    ast.UnionType(xs) => [tree.many(\"\", 4, tree.ts(xs))],\n    ast.RowType(fs) => [tree.many(\"\", 4, tree.ts(fs.map(f -> f.1)))],\n    ast.UnitType => [],\n  }\n}","old_text":"fn type_slots(t: ast.TypeExpr) -> List[tree.Slot] {\n  match t {\n    ast.Named { args, .. } => [tree.many(\"args\", 4, tree.ts(args))],\n    ast.FnType { params, ret } => [\n      tree.many(\"params\", 4, tree.ts(params)),\n      tree.one(\"ret\", tree.TN(ret)),\n    ],\n    ast.Refined { base, pred } => [\n      tree.one(\"base\", tree.TN(base)),\n      tree.one(\"pred\", tree.EN(pred)),\n    ],\n    ast.UnionType(xs) => [tree.many(\"\", 4, tree.ts(xs))],\n    ast.UnitType => [],\n  }\n}"},{"name":"tree.type_rebuilt","kind":"fn","old":"a6f3a334599745d1","new":"de370689e1ea5dab","interface_changed":false,"affected":[],"module":"tree","text":"fn type_rebuilt(t: ast.TypeExpr, ks: List[List[tree.Node]]) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, .. } => ast.Named { name, args: tree.types(ks, 0) },\n    ast.FnType { .. } => ast.FnType { params: tree.types(ks, 0), ret: tree.type1(ks, 1) },\n    ast.Refined { .. } => ast.Refined { base: tree.type1(ks, 0), pred: tree.expr1(ks, 1) },\n    ast.UnionType(_) => ast.UnionType(tree.types(ks, 0)),\n    ast.RowType(fs) => ast.RowType([(f.0, x) for (f, x) in zip(fs, tree.types(ks, 0))]),\n    ast.UnitType => ast.UnitType,\n  }\n}","old_text":"fn type_rebuilt(t: ast.TypeExpr, ks: List[List[tree.Node]]) -> ast.TypeExpr {\n  match t {\n    ast.Named { name, .. } => ast.Named { name, args: tree.types(ks, 0) },\n    ast.FnType { .. } => ast.FnType { params: tree.types(ks, 0), ret: tree.type1(ks, 1) },\n    ast.Refined { .. } => ast.Refined { base: tree.type1(ks, 0), pred: tree.expr1(ks, 1) },\n    ast.UnionType(_) => ast.UnionType(tree.types(ks, 0)),\n    ast.UnitType => ast.UnitType,\n  }\n}"}]}
{"id":"9c99adf6f658efc5","time":1795731330,"message":"edit","changes":[{"name":"check.shown","kind":"fn","old":"fe7809da67adbaba","new":"8db1588c32146bea","interface_changed":false,"affected":[],"module":"check","text":"/// A type as the checker's messages write it, if it is fully known.\nfn shown(t: check.Ty) -> Option[String] {\n  match t {\n    check.TInt => Some(\"Int\"),\n    check.TFloat => Some(\"Float\"),\n    check.TBool => Some(\"Bool\"),\n    check.TStr => Some(\"String\"),\n    check.TUnit => Some(\"()\"),\n    check.TGen(n) => Some(n),\n    // a trait as a type: any of its implementations\n    check.TTrait(n) => Some(n),\n    // a variable narrowed to some variants of its sum: `Dot | Sq`\n    check.TVariants { names, .. } => Some(join(names, \" | \")),\n    // `Int | String`: members are fully known (`union_of`)\n    check.TUnion(ms) => {\n      mut parts := []\n      for m in ms {\n        match check.shown(m) {\n          Some(x) => mut parts.push(x),\n          None => return None,\n        }\n      }\n      Some(join(parts, \" | \"))\n    },\n    check.TNamed { name, args } => {\n      if len(args) == 0 {\n        return Some(name)\n      }\n      mut parts := []\n      for a in args {\n        match check.shown(a) {\n          Some(x) => mut parts.push(x),\n          None => return None,\n        }\n      }\n      // a tuple is written `(A, B)`, an anonymous record `{ id: Int }`\n      Some(if name == \"Tuple\" {\n        \"(\" + join(parts, \", \") + \")\"\n      } else if starts_with(name, \"$rec:\") {\n        fs := drop(split(name, \":\"), 1)\n        \"{ \"\n          + join([f + \": \" + x for (f, x) in zip(fs, parts)], \", \")\n          + \" }\"\n      } else {\n        name + \"[\" + join(parts, \", \") + \"]\"\n      })\n    },\n    check.TList(a) => match check.shown(a) {\n      Some(s) => Some(\"List[\" + s + \"]\"),\n      None => None,\n    },\n    _ => None,\n  }\n}","old_text":"/// A type as the checker's messages write it, if it is fully known.\nfn shown(t: check.Ty) -> Option[String] {\n  match t {\n    check.TInt => Some(\"Int\"),\n    check.TFloat => Some(\"Float\"),\n    check.TBool => Some(\"Bool\"),\n    check.TStr => Some(\"String\"),\n    check.TUnit => Some(\"()\"),\n    check.TGen(n) => Some(n),\n    // a trait as a type: any of its implementations\n    check.TTrait(n) => Some(n),\n    // a variable narrowed to some variants of its sum: `Dot | Sq`\n    check.TVariants { names, .. } => Some(join(names, \" | \")),\n    // `Int | String`: members are fully known (`union_of`)\n    check.TUnion(ms) => {\n      mut parts := []\n      for m in ms {\n        match check.shown(m) {\n          Some(x) => mut parts.push(x),\n          None => return None,\n        }\n      }\n      Some(join(parts, \" | \"))\n    },\n    check.TNamed { name, args } => {\n      if len(args) == 0 {\n        return Some(name)\n      }\n      mut parts := []\n      for a in args {\n        match check.shown(a) {\n          Some(x) => mut parts.push(x),\n          None => return None,\n        }\n      }\n      // a tuple is written `(A, B)`\n      Some(if name == \"Tuple\" {\n        \"(\" + join(parts, \", \") + \")\"\n      } else {\n        name + \"[\" + join(parts, \", \") + \"]\"\n      })\n    },\n    check.TList(a) => match check.shown(a) {\n      Some(s) => Some(\"List[\" + s + \"]\"),\n      None => None,\n    },\n    _ => None,\n  }\n}"},{"name":"codegen.debug_body","kind":"fn","old":"2a0575743f5fa6fb","new":"4ab018fe4de1946c","interface_changed":false,"affected":[],"module":"codegen","text":"/// `debug`: as code writes it: `(a, b)`, `Name { f: v }`, `Name(a, b)`,\n/// `Name`, `Name {}`. The caller owns the string returned.\nfn debug_body(mut g: codegen.Gen, a: codegen.V) {\n  match a.ty {\n    check.TNamed { name: \"Tuple\", args } => {\n      codegen.push_scope(mut g)\n      mut parts := [codegen.lit(mut g, \"(\")]\n      parts += codegen.debug_fields(mut g, a, args.map(t -> (\"\", t)))\n      mut parts.push(codegen.lit(mut g, \")\"))\n      s := codegen.concat(mut g, parts)\n      codegen.ret_owned(mut g, s)\n    },\n    _ => {\n      cs := codegen.ctors_of(g, a.ty)\n      labels := if len(cs) == 1 {\n        [codegen.current(g)]\n      } else {\n        codegen.on_ctor(mut g, a, cs)\n      }\n      for (k, c) in enumerate(cs) {\n        if len(cs) > 1 {\n          codegen.block(mut g, get(labels, k) ?? \"\")\n        }\n        codegen.push_scope(mut g)\n        fs := codegen.fields_of(g, c, a.ty)\n        sh := get(g.types.ctors, c) ?? codegen.no_shape()\n        record := !contains(g.types.sums, sh.owner)\n        mut parts := []\n        if len(fs) == 0 {\n          parts = [codegen.lit(mut g, if record && !contains(g.caps, c) {\n            codegen.short(c) + \" {}\"\n          } else {\n            codegen.short(c)\n          })]\n        } else if sh.positional {\n          mut parts.push(codegen.lit(mut g, codegen.short(c) + \"(\"))\n          // positional, no names (a `distinct` type's `value` too)\n          parts += codegen.debug_fields(mut g, a, fs.map(f -> (\"\", f.1)))\n          mut parts.push(codegen.lit(mut g, \")\"))\n        } else {\n          mut parts.push(\n            codegen.lit(mut g, if starts_with(c, \"$rec:\") {\n              \"{ \"\n            } else {\n              codegen.short(c) + \" { \"\n            }),\n          )\n          parts += codegen.debug_fields(mut g, a, fs)\n          mut parts.push(codegen.lit(mut g, \" }\"))\n        }\n        s := codegen.concat(mut g, parts)\n        codegen.ret_owned(mut g, s)\n      }\n    },\n  }\n}","old_text":"/// `debug`: as code writes it: `(a, b)`, `Name { f: v }`, `Name(a, b)`,\n/// `Name`, `Name {}`. The caller owns the string returned.\nfn debug_body(mut g: codegen.Gen, a: codegen.V) {\n  match a.ty {\n    check.TNamed { name: \"Tuple\", args } => {\n      codegen.push_scope(mut g)\n      mut parts := [codegen.lit(mut g, \"(\")]\n      parts += codegen.debug_fields(mut g, a, args.map(t -> (\"\", t)))\n      mut parts.push(codegen.lit(mut g, \")\"))\n      s := codegen.concat(mut g, parts)\n      codegen.ret_owned(mut g, s)\n    },\n    _ => {\n      cs := codegen.ctors_of(g, a.ty)\n      labels := if len(cs) == 1 {\n        [codegen.current(g)]\n      } else {\n        codegen.on_ctor(mut g, a, cs)\n      }\n      for (k, c) in enumerate(cs) {\n        if len(cs) > 1 {\n          codegen.block(mut g, get(labels, k) ?? \"\")\n        }\n        codegen.push_scope(mut g)\n        fs := codegen.fields_of(g, c, a.ty)\n        sh := get(g.types.ctors, c) ?? codegen.no_shape()\n        record := !contains(g.types.sums, sh.owner)\n        mut parts := []\n        if len(fs) == 0 {\n          parts = [codegen.lit(mut g, if record && !contains(g.caps, c) {\n            codegen.short(c) + \" {}\"\n          } else {\n            codegen.short(c)\n          })]\n        } else if sh.positional {\n          mut parts.push(codegen.lit(mut g, codegen.short(c) + \"(\"))\n          // positional, no names (a `distinct` type's `value` too)\n          parts += codegen.debug_fields(mut g, a, fs.map(f -> (\"\", f.1)))\n          mut parts.push(codegen.lit(mut g, \")\"))\n        } else {\n          mut parts.push(codegen.lit(mut g, codegen.short(c) + \" { \"))\n          parts += codegen.debug_fields(mut g, a, fs)\n          mut parts.push(codegen.lit(mut g, \" }\"))\n        }\n        s := codegen.concat(mut g, parts)\n        codegen.ret_owned(mut g, s)\n      }\n    },\n  }\n}"},{"name":"declarations.type_errors_in","kind":"fn","old":"28653bdd05ac5527","new":"f432e775291486b5","interface_changed":false,"affected":[],"module":"declarations","text":"/// The errors of a written type. `tps` are the type parameters in scope,\n/// and `self_ok` is true inside a trait or an impl.\nfn type_errors_in(\n  sc: declarations.Names,\n  t: ast.TypeExpr,\n  tps: Set[String],\n  self_ok: Bool,\n  out: List[String],\n) -> List[String] {\n  match t {\n    ast.Named { name, args } => {\n      mut acc := out\n      if name == \"Self\" && len(args) == 0 {\n        if !self_ok {\n          mut acc.push(\n            \"`Self` only means something inside a trait or an impl\",\n          )\n        }\n      } else if contains(tps, name)\n        || contains(name, \".\")\n        || starts_with(name, \"$rec:\") {\n        ()\n      } else {\n        match get(sc.types, name) {\n          Some(k) => if k >= 0 && k != len(args) {\n            mut acc.push(\n              \"type `\"\n                + name\n                + \"` expects \"\n                + to_string(k)\n                + \" type arguments, got \"\n                + to_string(len(args)),\n            )\n          },\n          None => if !sc.open {\n            mut acc.push(\"unknown type `\" + name + \"`\")\n          },\n        }\n      }\n      for a in args {\n        acc = declarations.type_errors_in(sc, a, tps, self_ok, acc)\n      }\n      acc\n    },\n    ast.FnType { params, ret } => {\n      mut acc := out\n      for a in params {\n        acc = declarations.type_errors_in(sc, a, tps, self_ok, acc)\n      }\n      declarations.type_errors_in(sc, ret, tps, self_ok, acc)\n    },\n    ast.Refined { base, .. } => declarations.type_errors_in(sc, base, tps, self_ok, out),\n    ast.RowType(fs) => {\n      mut acc := out\n      for f in fs {\n        acc = declarations.type_errors_in(sc, f.1, tps, self_ok, acc)\n      }\n      acc\n    },\n    ast.UnionType(ms) => {\n      mut acc := out\n      for a in ms {\n        acc = declarations.type_errors_in(sc, a, tps, self_ok, acc)\n      }\n      acc\n    },\n    ast.UnitType => out,\n  }\n}","old_text":"/// The errors of a written type. `tps` are the type parameters in scope,\n/// and `self_ok` is true inside a trait or an impl.\nfn type_errors_in(\n  sc: declarations.Names,\n  t: ast.TypeExpr,\n  tps: Set[String],\n  self_ok: Bool,\n  out: List[String],\n) -> List[String] {\n  match t {\n    ast.Named { name, args } => {\n      mut acc := out\n      if name == \"Self\" && len(args) == 0 {\n        if !self_ok {\n          mut acc.push(\n            \"`Self` only means something inside a trait or an impl\",\n          )\n        }\n      } else if contains(tps, name) || contains(name, \".\") {\n        ()\n      } else {\n        match get(sc.types, name) {\n          Some(k) => if k >= 0 && k != len(args) {\n            mut acc.push(\n              \"type `\"\n                + name\n                + \"` expects \"\n                + to_string(k)\n                + \" type arguments, got \"\n                + to_string(len(args)),\n            )\n          },\n          None => if !sc.open {\n            mut acc.push(\"unknown type `\" + name + \"`\")\n          },\n        }\n      }\n      for a in args {\n        acc = declarations.type_errors_in(sc, a, tps, self_ok, acc)\n      }\n      acc\n    },\n    ast.FnType { params, ret } => {\n      mut acc := out\n      for a in params {\n        acc = declarations.type_errors_in(sc, a, tps, self_ok, acc)\n      }\n      declarations.type_errors_in(sc, ret, tps, self_ok, acc)\n    },\n    ast.Refined { base, .. } => declarations.type_errors_in(sc, base, tps, self_ok, out),\n    ast.RowType(fs) => {\n      mut acc := out\n      for f in fs {\n        acc = declarations.type_errors_in(sc, f.1, tps, self_ok, acc)\n      }\n      acc\n    },\n    ast.UnionType(ms) => {\n      mut acc := out\n      for a in ms {\n        acc = declarations.type_errors_in(sc, a, tps, self_ok, acc)\n      }\n      acc\n    },\n    ast.UnitType => out,\n  }\n}"},{"name":"declarations.body_errors","kind":"fn","old":"a05916f1fa854281","new":"efdac98405a13b7f","interface_changed":false,"affected":[],"module":"declarations","text":"/// A body's errors, in the order the checker meets them. `in_loop`: inside\n/// a loop body, and not inside a closure's.\nfn body_errors(\n  sc: declarations.Names,\n  e: ast.Expr,\n  in_loop: Bool,\n  out: List[String],\n) -> List[String] {\n  match e {\n    ast.Block { stmts, last } => {\n      mut acc := out\n      for st in stmts {\n        acc = match st {\n          ast.Break => if in_loop {\n            acc\n          } else {\n            acc + [\"`break` outside a loop\"]\n          },\n          ast.Continue => if in_loop {\n            acc\n          } else {\n            acc + [\"`continue` outside a loop\"]\n          },\n          ast.Let { pat, value, .. } => declarations.pattern_errors(\n            sc,\n            pat,\n            declarations.body_errors(sc, value, in_loop, acc),\n          ),\n          ast.VarDecl { value, .. } => declarations.body_errors(sc, value, in_loop, acc),\n          ast.Assign { place, value } => declarations.body_errors(\n            sc,\n            value,\n            in_loop,\n            declarations.body_errors(sc, place, in_loop, acc),\n          ),\n          ast.While { cond, body } => declarations.body_errors(\n            sc,\n            body,\n            true,\n            declarations.body_errors(sc, cond, in_loop, acc),\n          ),\n          ast.For { pat, iter, body } => declarations.body_errors(\n            sc,\n            body,\n            true,\n            declarations.pattern_errors(\n              sc,\n              pat,\n              declarations.body_errors(sc, iter, in_loop, acc),\n            ),\n          ),\n          ast.ComptimeFor { iter, body, .. } => declarations.body_errors(\n            sc,\n            body,\n            true,\n            declarations.body_errors(sc, iter, in_loop, acc),\n          ),\n          ast.Loop(b) => declarations.body_errors(sc, b, true, acc),\n          ast.ExprStmt(x) => declarations.body_errors(sc, x, in_loop, acc),\n          ast.Assert(x) => declarations.body_errors(sc, x, in_loop, acc),\n          _ => acc,\n        }\n      }\n      declarations.body_errors(sc, last, in_loop, acc)\n    },\n    // a closure's body is in no loop\n    ast.Lambda { params, body } => {\n      mut acc := out\n      for n in declarations.twice(params.map(p -> p.name)) {\n        mut acc.push(\"two parameters of a lambda are named `\" + n + \"`\")\n      }\n      declarations.body_errors(sc, body, false, acc)\n    },\n    ast.MatchExpr { scrutinee, arms, .. } => {\n      mut acc := declarations.body_errors(sc, scrutinee, in_loop, out)\n      for a in arms {\n        acc = declarations.body_errors(\n          sc,\n          a.body,\n          in_loop,\n          declarations.pattern_errors(sc, a.pat, acc),\n        )\n      }\n      acc\n    },\n    ast.CtorExpr { name, args } => {\n      mut acc := out\n      if !contains(sc.ctors, name)\n        && !contains(sc.types, name)\n        && !starts_with(name, \"$rec:\")\n        && !contains(name, \".\")\n        && !sc.open\n        && !sc.imports {\n        mut acc.push(\"unknown constructor `\" + name + \"`\")\n      } else if contains(sc.externs, name) && !contains(sc.ctors, name) {\n        mut acc.push(\"unknown constructor `\" + name + \"`\")\n      }\n      given := match args {\n        ast.RecordArgs(fs) => fs.map(f -> f.0),\n        ast.UpdateArgs { fields, .. } => fields.map(f -> f.0),\n        _ => [],\n      }\n      for n in declarations.twice(given) {\n        mut acc.push(\n          \"field `\"\n            + n\n            + \"` is given twice in `\"\n            + name\n            + \" { .. }`\",\n        )\n      }\n      for x in declarations.ctor_parts(args) {\n        acc = declarations.body_errors(sc, x, in_loop, acc)\n      }\n      acc\n    },\n    // `Item.new(..)`: called on a type\n    ast.MethodCall { recv: ast.CtorExpr { args: ast.NoArgs, .. }, args, .. } => {\n      mut acc := out\n      for x in args {\n        acc = declarations.body_errors(sc, x, in_loop, acc)\n      }\n      acc\n    },\n    _ => {\n      mut acc := out\n      for x in declarations.children(e) {\n        acc = declarations.body_errors(sc, x, in_loop, acc)\n      }\n      acc\n    },\n  }\n}","old_text":"/// A body's errors, in the order the checker meets them. `in_loop`: inside\n/// a loop body, and not inside a closure's.\nfn body_errors(\n  sc: declarations.Names,\n  e: ast.Expr,\n  in_loop: Bool,\n  out: List[String],\n) -> List[String] {\n  match e {\n    ast.Block { stmts, last } => {\n      mut acc := out\n      for st in stmts {\n        acc = match st {\n          ast.Break => if in_loop {\n            acc\n          } else {\n            acc + [\"`break` outside a loop\"]\n          },\n          ast.Continue => if in_loop {\n            acc\n          } else {\n            acc + [\"`continue` outside a loop\"]\n          },\n          ast.Let { pat, value, .. } => declarations.pattern_errors(\n            sc,\n            pat,\n            declarations.body_errors(sc, value, in_loop, acc),\n          ),\n          ast.VarDecl { value, .. } => declarations.body_errors(sc, value, in_loop, acc),\n          ast.Assign { place, value } => declarations.body_errors(\n            sc,\n            value,\n            in_loop,\n            declarations.body_errors(sc, place, in_loop, acc),\n          ),\n          ast.While { cond, body } => declarations.body_errors(\n            sc,\n            body,\n            true,\n            declarations.body_errors(sc, cond, in_loop, acc),\n          ),\n          ast.For { pat, iter, body } => declarations.body_errors(\n            sc,\n            body,\n            true,\n            declarations.pattern_errors(\n              sc,\n              pat,\n              declarations.body_errors(sc, iter, in_loop, acc),\n            ),\n          ),\n          ast.ComptimeFor { iter, body, .. } => declarations.body_errors(\n            sc,\n            body,\n            true,\n            declarations.body_errors(sc, iter, in_loop, acc),\n          ),\n          ast.Loop(b) => declarations.body_errors(sc, b, true, acc),\n          ast.ExprStmt(x) => declarations.body_errors(sc, x, in_loop, acc),\n          ast.Assert(x) => declarations.body_errors(sc, x, in_loop, acc),\n          _ => acc,\n        }\n      }\n      declarations.body_errors(sc, last, in_loop, acc)\n    },\n    // a closure's body is in no loop\n    ast.Lambda { params, body } => {\n      mut acc := out\n      for n in declarations.twice(params.map(p -> p.name)) {\n        mut acc.push(\"two parameters of a lambda are named `\" + n + \"`\")\n      }\n      declarations.body_errors(sc, body, false, acc)\n    },\n    ast.MatchExpr { scrutinee, arms, .. } => {\n      mut acc := declarations.body_errors(sc, scrutinee, in_loop, out)\n      for a in arms {\n        acc = declarations.body_errors(\n          sc,\n          a.body,\n          in_loop,\n          declarations.pattern_errors(sc, a.pat, acc),\n        )\n      }\n      acc\n    },\n    ast.CtorExpr { name, args } => {\n      mut acc := out\n      if !contains(sc.ctors, name)\n        && !contains(sc.types, name)\n        && !contains(name, \".\")\n        && !sc.open\n        && !sc.imports {\n        mut acc.push(\"unknown constructor `\" + name + \"`\")\n      } else if contains(sc.externs, name) && !contains(sc.ctors, name) {\n        mut acc.push(\"unknown constructor `\" + name + \"`\")\n      }\n      given := match args {\n        ast.RecordArgs(fs) => fs.map(f -> f.0),\n        ast.UpdateArgs { fields, .. } => fields.map(f -> f.0),\n        _ => [],\n      }\n      for n in declarations.twice(given) {\n        mut acc.push(\n          \"field `\"\n            + n\n            + \"` is given twice in `\"\n            + name\n            + \" { .. }`\",\n        )\n      }\n      for x in declarations.ctor_parts(args) {\n        acc = declarations.body_errors(sc, x, in_loop, acc)\n      }\n      acc\n    },\n    // `Item.new(..)`: called on a type\n    ast.MethodCall { recv: ast.CtorExpr { args: ast.NoArgs, .. }, args, .. } => {\n      mut acc := out\n      for x in args {\n        acc = declarations.body_errors(sc, x, in_loop, acc)\n      }\n      acc\n    },\n    _ => {\n      mut acc := out\n      for x in declarations.children(e) {\n        acc = declarations.body_errors(sc, x, in_loop, acc)\n      }\n      acc\n    },\n  }\n}"},{"name":"desugar.desugar_more","kind":"fn","old":"177bc47b56ea9c82","new":"8d03dc355d58dae9","interface_changed":false,"affected":[],"module":"desugar","text":"/// `desugar` of definitions added to a program already without its sugar\n/// (`context`, not returned). Each definition is desugared once. Returns\n/// `new` without sugar, with the aliases made for refinements the program\n/// had no alias for yet; the errors; and all refinements named so far\n/// (`texts`, then the new ones; `$where_k` is the `k`th).\npub fn desugar_more(\n  new: List[ast.Decl],\n  context: List[ast.Decl],\n  texts: List[String],\n) -> (List[ast.Decl], List[(String, String)], List[String]) {\n  mut errors := []\n  mut out := []\n  for d0 in desugar.with_models(new, context) {\n    // an `extern python` function becomes the call of the Python worker\n    d := desugar.python_lowered(d0)\n    for e in walk.decl_kids(d).1 {\n      for _ in 0..desugar.open_ranges(e) {\n        mut errors.push(\n          (\n            desugar.decl_name(d),\n            \"a range needs both ends (`a..b`), except in a slice: `xs[a..]`, `xs[..b]`\",\n          ),\n        )\n      }\n    }\n    lifted := desugar.rows_lifted(d)\n    for e in desugar.row_errors(lifted) {\n      mut errors.push((desugar.decl_name(d), e))\n    }\n    mut out.push(\n      desugar.named_results(walk.decl_parts(\n        lifted,\n        x -> desugar.unsugared(x),\n        t -> desugar.unsugared_type(t),\n      )),\n    )\n  }\n  out += desugar.anon_types(out, context)\n  (refined, all) := desugar.inline_refinements(\n    desugar.key_paths(desugar.defaults(out, context), context),\n    texts,\n  )\n  (desugar.mixed_unions(refined), errors, all)\n}","old_text":"/// `desugar` of definitions added to a program already without its sugar\n/// (`context`, not returned). Each definition is desugared once. Returns\n/// `new` without sugar, with the aliases made for refinements the program\n/// had no alias for yet; the errors; and all refinements named so far\n/// (`texts`, then the new ones; `$where_k` is the `k`th).\npub fn desugar_more(\n  new: List[ast.Decl],\n  context: List[ast.Decl],\n  texts: List[String],\n) -> (List[ast.Decl], List[(String, String)], List[String]) {\n  mut errors := []\n  mut out := []\n  for d0 in desugar.with_models(new, context) {\n    // an `extern python` function becomes the call of the Python worker\n    d := desugar.python_lowered(d0)\n    for e in walk.decl_kids(d).1 {\n      for _ in 0..desugar.open_ranges(e) {\n        mut errors.push(\n          (\n            desugar.decl_name(d),\n            \"a range needs both ends (`a..b`), except in a slice: `xs[a..]`, `xs[..b]`\",\n          ),\n        )\n      }\n    }\n    lifted := desugar.rows_lifted(d)\n    for e in desugar.row_errors(lifted) {\n      mut errors.push((desugar.decl_name(d), e))\n    }\n    mut out.push(\n      desugar.named_results(walk.decl_parts(\n        lifted,\n        x -> desugar.unsugared(x),\n        t -> desugar.unsugared_type(t),\n      )),\n    )\n  }\n  (refined, all) := desugar.inline_refinements(\n    desugar.key_paths(desugar.defaults(out, context), context),\n    texts,\n  )\n  (desugar.mixed_unions(refined), errors, all)\n}"},{"name":"parse.sym_primary","kind":"fn","old":"e04618328cff94ae","new":"44372e15da94dc63","interface_changed":false,"affected":[],"module":"parse","text":"/// A lambda, `()`, a parenthesized expression, a tuple, a list, a list\n/// comprehension or a block.\nfn sym_primary(mut p: parse.Parser, s: String) -> Result[ast.Expr, String] {\n  if s == \"(\" && parse.lambda_ahead(p) {\n    parse.advance(mut p)\n    mut ps := []\n    mut binds := []\n    while !parse.is_sym(p, \")\") {\n      name := match parse.param_pattern(mut p)! {\n        Some(pat) => {\n          n := f\"$p{len(ps)}\"\n          mut binds.push(ast.Let { pat, ty: None, value: ast.Var(n) })\n          n\n        },\n        None => parse.ident(mut p)!,\n      }\n      ty := if parse.eat_sym(mut p, \":\") {\n        Some(parse.type_expr(mut p)!)\n      } else {\n        None\n      }\n      mut ps.push(ast.LamParam { name, ty })\n      if !parse.eat_sym(mut p, \",\") {\n        break\n      }\n    }\n    parse.expect_sym(mut p, \")\")!\n    parse.expect_sym(mut p, \"->\")!\n    return Ok(ast.Lambda {\n      params: ps,\n      body: parse.bind_params(binds, parse.expr(mut p)!),\n    })\n  }\n  if s == \"(\" {\n    parse.advance(mut p)\n    if parse.eat_sym(mut p, \")\") {\n      return Ok(ast.UnitExpr)\n    }\n    (ns, np) := (p.no_struct, p.no_pipe)\n    p.no_struct = false\n    p.no_pipe = false\n    e := parse.expr(mut p)!\n    if parse.eat_sym(mut p, \",\") {\n      rest := parse.expr_list(mut p, \")\")!\n      p.no_struct = ns\n      p.no_pipe = np\n      return Ok(ast.TupleExpr([e] + rest))\n    }\n    p.no_struct = ns\n    p.no_pipe = np\n    parse.expect_sym(mut p, \")\")!\n    return Ok(e)\n  }\n  if s == \"[\" {\n    parse.advance(mut p)\n    if parse.eat_sym(mut p, \"]\") {\n      return Ok(ast.ListExpr([]))\n    }\n    (ns, np) := (p.no_struct, p.no_pipe)\n    p.no_struct = false\n    p.no_pipe = false\n    first := parse.expr(mut p)!\n    // `[e for x in xs where c for y in ys]`\n    if parse.is_kw(p, \"for\") {\n      fors := parse.comp_fors(mut p, \"]\")!\n      p.no_struct = ns\n      p.no_pipe = np\n      return Ok(ast.Comp { kind: ast.ListComp, elem: first, fors })\n    }\n    mut items := [first]\n    if parse.eat_sym(mut p, \",\") {\n      items += parse.expr_list(mut p, \"]\")!\n    } else {\n      parse.expect_sym(mut p, \"]\")!\n    }\n    p.no_struct = ns\n    p.no_pipe = np\n    return Ok(ast.ListExpr(items))\n  }\n  if s == \"{\" {\n    // `{ id: 1, .. }`: a field's name and a `:`, which no statement starts with\n    return match (parse.peek_at(p, 1), parse.peek_at(p, 2)) {\n      (lex.Ident(_), lex.Sym(\":\")) => parse.anon_record(mut p),\n      _ => parse.block(mut p),\n    }\n  }\n  if s == \"|\" || s == \"||\" {\n    return parse.fail(\n      p,\n      \"lambdas are written `x -> body`, `(a, b) -> body` or `() -> body`\",\n    )\n  }\n  parse.fail(p, \"expected expression\")\n}","old_text":"/// A lambda, `()`, a parenthesized expression, a tuple, a list, a list\n/// comprehension or a block.\nfn sym_primary(mut p: parse.Parser, s: String) -> Result[ast.Expr, String] {\n  if s == \"(\" && parse.lambda_ahead(p) {\n    parse.advance(mut p)\n    mut ps := []\n    mut binds := []\n    while !parse.is_sym(p, \")\") {\n      name := match parse.param_pattern(mut p)! {\n        Some(pat) => {\n          n := f\"$p{len(ps)}\"\n          mut binds.push(ast.Let { pat, ty: None, value: ast.Var(n) })\n          n\n        },\n        None => parse.ident(mut p)!,\n      }\n      ty := if parse.eat_sym(mut p, \":\") {\n        Some(parse.type_expr(mut p)!)\n      } else {\n        None\n      }\n      mut ps.push(ast.LamParam { name, ty })\n      if !parse.eat_sym(mut p, \",\") {\n        break\n      }\n    }\n    parse.expect_sym(mut p, \")\")!\n    parse.expect_sym(mut p, \"->\")!\n    return Ok(ast.Lambda {\n      params: ps,\n      body: parse.bind_params(binds, parse.expr(mut p)!),\n    })\n  }\n  if s == \"(\" {\n    parse.advance(mut p)\n    if parse.eat_sym(mut p, \")\") {\n      return Ok(ast.UnitExpr)\n    }\n    (ns, np) := (p.no_struct, p.no_pipe)\n    p.no_struct = false\n    p.no_pipe = false\n    e := parse.expr(mut p)!\n    if parse.eat_sym(mut p, \",\") {\n      rest := parse.expr_list(mut p, \")\")!\n      p.no_struct = ns\n      p.no_pipe = np\n      return Ok(ast.TupleExpr([e] + rest))\n    }\n    p.no_struct = ns\n    p.no_pipe = np\n    parse.expect_sym(mut p, \")\")!\n    return Ok(e)\n  }\n  if s == \"[\" {\n    parse.advance(mut p)\n    if parse.eat_sym(mut p, \"]\") {\n      return Ok(ast.ListExpr([]))\n    }\n    (ns, np) := (p.no_struct, p.no_pipe)\n    p.no_struct = false\n    p.no_pipe = false\n    first := parse.expr(mut p)!\n    // `[e for x in xs where c for y in ys]`\n    if parse.is_kw(p, \"for\") {\n      fors := parse.comp_fors(mut p, \"]\")!\n      p.no_struct = ns\n      p.no_pipe = np\n      return Ok(ast.Comp { kind: ast.ListComp, elem: first, fors })\n    }\n    mut items := [first]\n    if parse.eat_sym(mut p, \",\") {\n      items += parse.expr_list(mut p, \"]\")!\n    } else {\n      parse.expect_sym(mut p, \"]\")!\n    }\n    p.no_struct = ns\n    p.no_pipe = np\n    return Ok(ast.ListExpr(items))\n  }\n  if s == \"{\" {\n    return parse.block(mut p)\n  }\n  if s == \"|\" || s == \"||\" {\n    return parse.fail(\n      p,\n      \"lambdas are written `x -> body`, `(a, b) -> body` or `() -> body`\",\n    )\n  }\n  parse.fail(p, \"expected expression\")\n}"},{"name":"parse.row_type","kind":"fn","old":"c58a60752716b702","new":"7797b3b8c885b102","interface_changed":false,"affected":[],"module":"parse","text":"/// `{ id: OrderId, total: Cents, .. }` after its `{`: the fields a record\n/// must have, then `..` (it may have others).\nfn row_type(mut p: parse.Parser) -> Result[ast.TypeExpr, String] {\n  // no `..` after the first field: an anonymous record's type\n  if !parse.is_sym(p, \"..\")\n    && parse.is_sym_at(p, 1, \":\")\n    && !parse.row_open(p) {\n    return parse.closed_row(mut p)\n  }\n  mut fs := []\n  while !parse.is_sym(p, \"..\") {\n    if parse.is_sym(p, \"}\") || parse.peek(p) == lex.Eof {\n      return parse.fail(\n        p,\n        \"a structural type ends with `..`, for the other fields a record may have: `{ id: Int, .. }`\",\n      )\n    }\n    n := parse.ident(mut p)!\n    if fs.any(f -> f.0 == n) {\n      return parse.fail(p, f\"field `{n}` is named twice\")\n    }\n    parse.expect_sym(mut p, \":\")!\n    mut fs.push((n, parse.type_expr(mut p)!))\n    if !parse.eat_sym(mut p, \",\") && !parse.is_sym(p, \"..\") {\n      return parse.fail(\n        p,\n        \"a structural type ends with `..`, for the other fields a record may have: `{ id: Int, .. }`\",\n      )\n    }\n  }\n  parse.expect_sym(mut p, \"..\")!\n  _ := parse.eat_sym(mut p, \",\")\n  parse.expect_sym(mut p, \"}\")!\n  if fs == [] {\n    return parse.fail(\n      p,\n      \"a structural type names the fields it needs: `{ id: Int, .. }`\",\n    )\n  }\n  Ok(ast.RowType(fs))\n}","old_text":"/// `{ id: OrderId, total: Cents, .. }` after its `{`: the fields a record\n/// must have, then `..` (it may have others).\nfn row_type(mut p: parse.Parser) -> Result[ast.TypeExpr, String] {\n  mut fs := []\n  while !parse.is_sym(p, \"..\") {\n    if parse.is_sym(p, \"}\") || parse.peek(p) == lex.Eof {\n      return parse.fail(\n        p,\n        \"a structural type ends with `..`, for the other fields a record may have: `{ id: Int, .. }`\",\n      )\n    }\n    n := parse.ident(mut p)!\n    if fs.any(f -> f.0 == n) {\n      return parse.fail(p, f\"field `{n}` is named twice\")\n    }\n    parse.expect_sym(mut p, \":\")!\n    mut fs.push((n, parse.type_expr(mut p)!))\n    if !parse.eat_sym(mut p, \",\") && !parse.is_sym(p, \"..\") {\n      return parse.fail(\n        p,\n        \"a structural type ends with `..`, for the other fields a record may have: `{ id: Int, .. }`\",\n      )\n    }\n  }\n  parse.expect_sym(mut p, \"..\")!\n  _ := parse.eat_sym(mut p, \",\")\n  parse.expect_sym(mut p, \"}\")!\n  if fs == [] {\n    return parse.fail(\n      p,\n      \"a structural type names the fields it needs: `{ id: Int, .. }`\",\n    )\n  }\n  Ok(ast.RowType(fs))\n}"},{"name":"smt.literal_of","kind":"fn","old":"a092acc65c05d279","new":"fad1a29b63df3f61","interface_changed":false,"affected":[],"module":"smt","text":"/// A model's value of `v` as code. `None` when part of it can't be shown.\npub fn literal_of(\n  vc: smt.Vc,\n  v: smt.Val,\n  m: Dict[String, smt.Sx],\n) -> Option[ast.Expr] {\n  match v {\n    smt.VData { ty, t } => smt.sx_literal(vc, ty, get(m, t)?),\n    smt.VInt(t) => smt.int_literal(smt.sx_text(get(m, t)?)),\n    smt.VBool(t) => Some(ast.BoolLit(smt.sx_text(get(m, t)?) == \"true\")),\n    smt.VStr(t) => Some(ast.StrLit(smt.str_value(smt.sx_text(get(m, t)?))?)),\n    smt.UnitVal => Some(ast.UnitExpr),\n    smt.VTuple(xs) => Some(ast.TupleExpr(\n      smt.all_some(xs.map(x -> smt.literal_of(vc, x, m)))?,\n    )),\n    smt.VRec { name, fields } => {\n      mut fs := []\n      for (f, x) in fields {\n        mut fs.push((f, smt.literal_of(vc, x, m)?))\n      }\n      // (a structural parameter's record, `$x`, is written as an anonymous one)\n      Some(ast.CtorExpr {\n        name: if starts_with(name, \"$\") && !starts_with(name, \"$rec:\") {\n          \"$rec:\" + join(fs.map(f -> f.0).sorted(), \":\")\n        } else {\n          name\n        },\n        args: ast.RecordArgs(fs),\n      })\n    },\n    smt.VDistinct { name, inner } => if contains(\n      [\"I8\", \"I16\", \"I32\", \"I64\", \"U8\", \"U16\", \"U32\", \"U64\"],\n      name,\n    ) {\n      smt.literal_of(vc, inner, m)\n    } else {\n      Some(ast.CtorExpr {\n        name,\n        args: ast.PositionalArgs([smt.literal_of(vc, inner, m)?]),\n      })\n    },\n    smt.VList { len: lt, id } => {\n      k := parse_int(trim(smt.sx_text(get(m, lt)?)))?\n      source := smt.list_info(vc, id).source\n      match get(vc.keyed, id) {\n        // a dict or set: its first entries (`open_map`), when it has no\n        // more\n        Some(ast.Named { name, args }) => {\n          elems := if k == 0 {\n            []\n          } else {\n            get(vc.input_elems, id)?\n          }\n          if k > len(elems) {\n            return None\n          }\n          xs := smt.all_some(\n            elems[..k].map(x -> smt.literal_of(vc, x, m)),\n          )?\n          return if name == \"Dict\" {\n            mut entries := []\n            for x in xs {\n              match x {\n                ast.TupleExpr([a, b]) => mut entries.push((a, b)),\n                _ => return None,\n              }\n            }\n            Some(ast.DictExpr { types: args, entries })\n          } else {\n            Some(ast.SetExpr { types: args, elems: xs })\n          }\n        },\n        Some(_) => return None,\n        None => (),\n      }\n      if k == 0 {\n        return Some(ast.ListExpr([]))\n      }\n      match source {\n        smt.GSeq(s, t, n) => if k <= smt.input_len() && !contains(vc.input_elems, id) {\n          mut xs := []\n          for i in 0..k {\n            mut xs.push(\n              smt.sx_literal(\n                vc,\n                t,\n                get(m, smt.seq_at(n, s, f\"{i}\"))?,\n              )?,\n            )\n          }\n          return Some(ast.ListExpr(xs))\n        },\n        _ => (),\n      }\n      elems := get(vc.input_elems, id)?\n      if k > len(elems) {\n        return None\n      }\n      Some(ast.ListExpr(\n        smt.all_some(elems[..k].map(x -> smt.literal_of(vc, x, m)))?,\n      ))\n    },\n    smt.VSum { ty, args, tag, ctors } => {\n      k := parse_int(trim(smt.sx_text(get(m, tag)?)))?\n      c := get(ctors, k)?\n      vs := smt.variants_of(vc, ty, args)?\n      v0 := get(vs, k)?\n      fields := smt.all_some(c.1.map(y -> smt.literal_of(vc, y, m)))?\n      Some(ast.CtorExpr {\n        name: c.0,\n        args: smt.ctor_args(v0.fields, fields),\n      })\n    },\n    // a union value is its active member's value\n    smt.VUnion { tag, slots } => {\n      k := parse_int(trim(smt.sx_text(get(m, tag)?)))?\n      smt.literal_of(vc, get(slots, k)?.1, m)\n    },\n    _ => None,\n  }\n}","old_text":"/// A model's value of `v` as code. `None` when part of it can't be shown.\npub fn literal_of(\n  vc: smt.Vc,\n  v: smt.Val,\n  m: Dict[String, smt.Sx],\n) -> Option[ast.Expr] {\n  match v {\n    smt.VData { ty, t } => smt.sx_literal(vc, ty, get(m, t)?),\n    smt.VInt(t) => smt.int_literal(smt.sx_text(get(m, t)?)),\n    smt.VBool(t) => Some(ast.BoolLit(smt.sx_text(get(m, t)?) == \"true\")),\n    smt.VStr(t) => Some(ast.StrLit(smt.str_value(smt.sx_text(get(m, t)?))?)),\n    smt.UnitVal => Some(ast.UnitExpr),\n    smt.VTuple(xs) => Some(ast.TupleExpr(\n      smt.all_some(xs.map(x -> smt.literal_of(vc, x, m)))?,\n    )),\n    smt.VRec { name, fields } => {\n      mut fs := []\n      for (f, x) in fields {\n        mut fs.push((f, smt.literal_of(vc, x, m)?))\n      }\n      Some(ast.CtorExpr { name, args: ast.RecordArgs(fs) })\n    },\n    smt.VDistinct { name, inner } => if contains(\n      [\"I8\", \"I16\", \"I32\", \"I64\", \"U8\", \"U16\", \"U32\", \"U64\"],\n      name,\n    ) {\n      smt.literal_of(vc, inner, m)\n    } else {\n      Some(ast.CtorExpr {\n        name,\n        args: ast.PositionalArgs([smt.literal_of(vc, inner, m)?]),\n      })\n    },\n    smt.VList { len: lt, id } => {\n      k := parse_int(trim(smt.sx_text(get(m, lt)?)))?\n      source := smt.list_info(vc, id).source\n      match get(vc.keyed, id) {\n        // a dict or set: its first entries (`open_map`), when it has no\n        // more\n        Some(ast.Named { name, args }) => {\n          elems := if k == 0 {\n            []\n          } else {\n            get(vc.input_elems, id)?\n          }\n          if k > len(elems) {\n            return None\n          }\n          xs := smt.all_some(\n            elems[..k].map(x -> smt.literal_of(vc, x, m)),\n          )?\n          return if name == \"Dict\" {\n            mut entries := []\n            for x in xs {\n              match x {\n                ast.TupleExpr([a, b]) => mut entries.push((a, b)),\n                _ => return None,\n              }\n            }\n            Some(ast.DictExpr { types: args, entries })\n          } else {\n            Some(ast.SetExpr { types: args, elems: xs })\n          }\n        },\n        Some(_) => return None,\n        None => (),\n      }\n      if k == 0 {\n        return Some(ast.ListExpr([]))\n      }\n      match source {\n        smt.GSeq(s, t, n) => if k <= smt.input_len() && !contains(vc.input_elems, id) {\n          mut xs := []\n          for i in 0..k {\n            mut xs.push(\n              smt.sx_literal(\n                vc,\n                t,\n                get(m, smt.seq_at(n, s, f\"{i}\"))?,\n              )?,\n            )\n          }\n          return Some(ast.ListExpr(xs))\n        },\n        _ => (),\n      }\n      elems := get(vc.input_elems, id)?\n      if k > len(elems) {\n        return None\n      }\n      Some(ast.ListExpr(\n        smt.all_some(elems[..k].map(x -> smt.literal_of(vc, x, m)))?,\n      ))\n    },\n    smt.VSum { ty, args, tag, ctors } => {\n      k := parse_int(trim(smt.sx_text(get(m, tag)?)))?\n      c := get(ctors, k)?\n      vs := smt.variants_of(vc, ty, args)?\n      v0 := get(vs, k)?\n      fields := smt.all_some(c.1.map(y -> smt.literal_of(vc, y, m)))?\n      Some(ast.CtorExpr {\n        name: c.0,\n        args: smt.ctor_args(v0.fields, fields),\n      })\n    },\n    // a union value is its active member's value\n    smt.VUnion { tag, slots } => {\n      k := parse_int(trim(smt.sx_text(get(m, tag)?)))?\n      smt.literal_of(vc, get(slots, k)?.1, m)\n    },\n    _ => None,\n  }\n}"},{"name":"text.type_text","kind":"fn","old":"d82dd9c0d1556e9c","new":"9d63837162fcb55a","interface_changed":false,"affected":[],"module":"text","text":"/// `List[Int]`, `(Int, String)`, `(A) -> B`, `Int where it > 0`, `A | B`.\npub fn type_text(t: ast.TypeExpr) -> String {\n  match t {\n    ast.UnitType => \"()\",\n    // an anonymous record's type, by its fields: `{ id: Int, total: Cents }`\n    ast.Named { name, args } => if starts_with(name, \"$rec:\") {\n      fs := drop(split(name, \":\"), 1)\n      \"{ \"\n        + join(\n          [f + \": \" + text.type_text(a) for (f, a) in zip(fs, args)],\n          \", \",\n        )\n        + \" }\"\n    } else if name == \"Tuple\" {\n      \"(\" + join(args.map(a -> text.type_text(a)), \", \") + \")\"\n    } else if len(args) == 0 {\n      name\n    } else {\n      name\n        + \"[\"\n        + join(args.map(a -> text.type_text(a)), \", \")\n        + \"]\"\n    },\n    ast.FnType { params, ret } => \"(\"\n      + join(params.map(p -> text.type_text(p)), \", \")\n      + \") -> \"\n      + text.type_text(ret),\n    ast.Refined { base, pred } => text.type_text(base)\n      + \" where \"\n      + text.unpiped(text.head(pred, 0)),\n    // a refined or function member needs parentheses, or `where` / `->` would take in the rest\n    ast.RowType(fs) => \"{ \"\n      + join(\n        fs.map(f -> f.0 + \": \" + text.type_text(f.1)) + [\"..\"],\n        \", \",\n      )\n      + \" }\",\n    ast.UnionType(ms) => join(\n      ms.map(\n        m ->\n          match m {\n            ast.Refined { .. } | ast.FnType { .. } | ast.UnionType(_) => \"(\" + text.type_text(m) + \")\",\n            _ => text.type_text(m),\n          },\n      ),\n      \" | \",\n    ),\n  }\n}","old_text":"/// `List[Int]`, `(Int, String)`, `(A) -> B`, `Int where it > 0`, `A | B`.\npub fn type_text(t: ast.TypeExpr) -> String {\n  match t {\n    ast.UnitType => \"()\",\n    ast.Named { name, args } => if name == \"Tuple\" {\n      \"(\" + join(args.map(a -> text.type_text(a)), \", \") + \")\"\n    } else if len(args) == 0 {\n      name\n    } else {\n      name\n        + \"[\"\n        + join(args.map(a -> text.type_text(a)), \", \")\n        + \"]\"\n    },\n    ast.FnType { params, ret } => \"(\"\n      + join(params.map(p -> text.type_text(p)), \", \")\n      + \") -> \"\n      + text.type_text(ret),\n    ast.Refined { base, pred } => text.type_text(base)\n      + \" where \"\n      + text.unpiped(text.head(pred, 0)),\n    // a refined or function member needs parentheses, or `where` / `->` would take in the rest\n    ast.RowType(fs) => \"{ \"\n      + join(\n        fs.map(f -> f.0 + \": \" + text.type_text(f.1)) + [\"..\"],\n        \", \",\n      )\n      + \" }\",\n    ast.UnionType(ms) => join(\n      ms.map(\n        m ->\n          match m {\n            ast.Refined { .. } | ast.FnType { .. } | ast.UnionType(_) => \"(\" + text.type_text(m) + \")\",\n            _ => text.type_text(m),\n          },\n      ),\n      \" | \",\n    ),\n  }\n}"},{"name":"text.named_parts","kind":"fn","old":"45f770508a520d7d","new":"6dba8bbbbccde647","interface_changed":false,"affected":[],"module":"text","text":"fn named_parts(fs: List[(String, ast.Expr)], d: Int) -> List[String] {\n  fs.map(\n    f -> match f.1 {\n      ast.Var(v) => if v == f.0 {\n        f.0\n      } else {\n        f.0 + \": \" + v\n      },\n      x => f.0 + \": \" + text.expr_text(x, d),\n    },\n  )\n}","old_text":"/// A record literal's fields (`sku`, `qty: 1`), each as `show` gives a value.\nfn named_parts(fs: List[(String, ast.Expr)], d: Int) -> List[String] {\n  fs.map(\n    f -> match f.1 {\n      ast.Var(v) => if v == f.0 {\n        f.0\n      } else {\n        f.0 + \": \" + v\n      },\n      x => f.0 + \": \" + text.expr_text(x, d),\n    },\n  )\n}"},{"name":"text.expr_text","kind":"fn","old":"f58810d7f0da8692","new":"cac34f47292db0c7","interface_changed":false,"affected":[],"module":"text","text":"/// An expression at depth `d`, broken across lines where it would be too\n/// long:\n/// - a chain of method calls: one call per line.\n/// - a call's arguments or a literal's items: one per line.\n/// - a long lambda's body: on a line of its own.\n/// - `&&`, `||` and `+`: one operand per line.\npub fn expr_text(e: ast.Expr, d: Int) -> String {\n  one := text.inline(e, d)\n  // a chain whose parts had to break is laid out one item per line\n  chain := match e {\n    ast.MethodCall { .. } | ast.Binary { op: ast.And | ast.Or | ast.Add, .. } => true,\n    _ => false,\n  }\n  if !text.too_long(one, d) && !(chain && contains(one, \"\\n\")) {\n    return one\n  }\n  match e {\n    // a.b().c().d()  ->  one call per line\n    ast.MethodCall { .. } => {\n      mut calls := []\n      mut cur: ast.Expr = e\n      loop {\n        match cur {\n          ast.MethodCall { recv, name, args } => {\n            mut calls.push((name, args))\n            cur = recv\n          },\n          _ => {\n            break\n          },\n        }\n      }\n      if len(calls) < 2 {\n        c := get(calls, 0) ?? (\"\", [])\n        return text.wrap(cur, 12, d)\n          + \".\"\n          + c.0\n          + text.broken(\n            \"(\",\n            c.1.map(a -> text.expr_text(a, d + 1)),\n            \")\",\n            d,\n          )\n      }\n      mut s := text.wrap(cur, 12, d)\n      for c in calls.reversed() {\n        s += \"\\n\"\n          + text.ind(d + 1)\n          + \".\"\n          + c.0\n          + \"(\"\n          + text.args_text(c.1, d + 1)\n          + \")\"\n      }\n      s\n    },\n    ast.Call { callee, args } => if len(args) > 0 {\n      text.callee_text(callee, d)\n        + text.broken(\n          \"(\",\n          args.map(a -> text.expr_text(a, d + 1)),\n          \")\",\n          d,\n        )\n    } else {\n      one\n    },\n    ast.ListExpr(es) => if len(es) > 0 {\n      text.broken(\n        \"[\",\n        es.map(a -> text.expr_text(a, d + 1)),\n        \"]\",\n        d,\n      )\n    } else {\n      one\n    },\n    ast.TupleExpr(es) => text.broken(\"(\", es.map(a -> text.expr_text(a, d + 1)), \")\", d),\n    ast.CtorExpr { name, args: ast.RecordArgs(fs) } => text.broken(\n      text.ctor_open(name),\n      text.named_parts(fs, d + 1),\n      \"}\",\n      d,\n    ),\n    ast.CtorExpr { name, args: ast.PositionalArgs(es) } => name\n      + text.broken(\n        \"(\",\n        es.map(a -> text.expr_text(a, d + 1)),\n        \")\",\n        d,\n      ),\n    // x -> long body  ->  body on its own line (a block body breaks by itself)\n    ast.Lambda { params, body } => match text.lambda_view(params, body) {\n      (_, ast.Block { .. }) => one,\n      (ps, b) => text.lambda_params(ps)\n        + \" ->\\n\"\n        + text.ind(d + 1)\n        + text.expr_text(b, d + 1),\n    },\n    // a && b && c, \"x\" + y + \"z\"  ->  one operand per line\n    ast.Binary { op, .. } => if op == ast.And || op == ast.Or || op == ast.Add {\n      mut parts := []\n      mut cur: ast.Expr = e\n      loop {\n        match cur {\n          ast.Binary { op: o, left, right } => if o == op {\n            mut parts.push(right)\n            cur = left\n          } else {\n            break\n          },\n          _ => {\n            break\n          },\n        }\n      }\n      p := text.prec(e)\n      mut s := text.wrap(cur, p, d + 1)\n      for x in parts.reversed() {\n        s += \"\\n\"\n          + text.ind(d + 1)\n          + text.symbol(op)\n          + \" \"\n          + text.wrap(x, p + 1, d + 1)\n      }\n      s\n    } else {\n      one\n    },\n    _ => one,\n  }\n}","old_text":"/// An expression at depth `d`, broken across lines where it would be too\n/// long:\n/// - a chain of method calls: one call per line.\n/// - a call's arguments or a literal's items: one per line.\n/// - a long lambda's body: on a line of its own.\n/// - `&&`, `||` and `+`: one operand per line.\npub fn expr_text(e: ast.Expr, d: Int) -> String {\n  one := text.inline(e, d)\n  // a chain whose parts had to break is laid out one item per line\n  chain := match e {\n    ast.MethodCall { .. } | ast.Binary { op: ast.And | ast.Or | ast.Add, .. } => true,\n    _ => false,\n  }\n  if !text.too_long(one, d) && !(chain && contains(one, \"\\n\")) {\n    return one\n  }\n  match e {\n    // a.b().c().d()  ->  one call per line\n    ast.MethodCall { .. } => {\n      mut calls := []\n      mut cur: ast.Expr = e\n      loop {\n        match cur {\n          ast.MethodCall { recv, name, args } => {\n            mut calls.push((name, args))\n            cur = recv\n          },\n          _ => {\n            break\n          },\n        }\n      }\n      if len(calls) < 2 {\n        c := get(calls, 0) ?? (\"\", [])\n        return text.wrap(cur, 12, d)\n          + \".\"\n          + c.0\n          + text.broken(\n            \"(\",\n            c.1.map(a -> text.expr_text(a, d + 1)),\n            \")\",\n            d,\n          )\n      }\n      mut s := text.wrap(cur, 12, d)\n      for c in calls.reversed() {\n        s += \"\\n\"\n          + text.ind(d + 1)\n          + \".\"\n          + c.0\n          + \"(\"\n          + text.args_text(c.1, d + 1)\n          + \")\"\n      }\n      s\n    },\n    ast.Call { callee, args } => if len(args) > 0 {\n      text.callee_text(callee, d)\n        + text.broken(\n          \"(\",\n          args.map(a -> text.expr_text(a, d + 1)),\n          \")\",\n          d,\n        )\n    } else {\n      one\n    },\n    ast.ListExpr(es) => if len(es) > 0 {\n      text.broken(\n        \"[\",\n        es.map(a -> text.expr_text(a, d + 1)),\n        \"]\",\n        d,\n      )\n    } else {\n      one\n    },\n    ast.TupleExpr(es) => text.broken(\"(\", es.map(a -> text.expr_text(a, d + 1)), \")\", d),\n    ast.CtorExpr { name, args: ast.RecordArgs(fs) } => text.broken(name + \" {\", text.named_parts(fs, d + 1), \"}\", d),\n    ast.CtorExpr { name, args: ast.PositionalArgs(es) } => name\n      + text.broken(\n        \"(\",\n        es.map(a -> text.expr_text(a, d + 1)),\n        \")\",\n        d,\n      ),\n    // x -> long body  ->  body on its own line (a block body breaks by itself)\n    ast.Lambda { params, body } => match text.lambda_view(params, body) {\n      (_, ast.Block { .. }) => one,\n      (ps, b) => text.lambda_params(ps)\n        + \" ->\\n\"\n        + text.ind(d + 1)\n        + text.expr_text(b, d + 1),\n    },\n    // a && b && c, \"x\" + y + \"z\"  ->  one operand per line\n    ast.Binary { op, .. } => if op == ast.And || op == ast.Or || op == ast.Add {\n      mut parts := []\n      mut cur: ast.Expr = e\n      loop {\n        match cur {\n          ast.Binary { op: o, left, right } => if o == op {\n            mut parts.push(right)\n            cur = left\n          } else {\n            break\n          },\n          _ => {\n            break\n          },\n        }\n      }\n      p := text.prec(e)\n      mut s := text.wrap(cur, p, d + 1)\n      for x in parts.reversed() {\n        s += \"\\n\"\n          + text.ind(d + 1)\n          + text.symbol(op)\n          + \" \"\n          + text.wrap(x, p + 1, d + 1)\n      }\n      s\n    } else {\n      one\n    },\n    _ => one,\n  }\n}"},{"name":"text.inline","kind":"fn","old":"b753c5b0b91ba86a","new":"aa5d6124dc7f3ff1","interface_changed":false,"affected":[],"module":"text","text":"/// An expression on one line, except for the blocks inside it (laid out at\n/// depth `d`) and for what its parts break.\nfn inline(e: ast.Expr, d: Int) -> String {\n  match e {\n    ast.IntLit(n) => to_string(n),\n    ast.BigIntLit(digits) => digits,\n    ast.FloatLit(f) => text.float_text(f),\n    ast.TupleExpr(es) => \"(\" + text.args_text(es, d) + \")\",\n    ast.StrLit(s) => \"\\\"\" + text.escape(s) + \"\\\"\",\n    ast.BoolLit(b) => to_string(b),\n    ast.UnitExpr => \"()\",\n    ast.Var(v) => v,\n    ast.Hole(h) => \"?\" + h,\n    ast.ListExpr(es) => \"[\" + text.args_text(es, d) + \"]\",\n    ast.CtorExpr { name, args } => match args {\n      ast.NoArgs => name,\n      ast.PositionalArgs(es) => name + \"(\" + text.args_text(es, d) + \")\",\n      ast.RecordArgs(fs) => if len(fs) == 0 {\n        name + \" {}\"\n      } else {\n        text.ctor_open(name)\n          + \" \"\n          + join(text.named_parts(fs, d), \", \")\n          + \" }\"\n      },\n      ast.UpdateArgs { base, fields } => name\n        + \" { \"\n        + join([\"..\", text.expr_text(base, d)], \"\")\n        + if len(fields) == 0 {\n          \"\"\n        } else {\n          \", \" + join(text.named_parts(fields, d), \", \")\n        }\n        + \" }\",\n    },\n    ast.Call { callee, args } => text.callee_text(callee, d)\n      + \"(\"\n      + text.args_text(args, d)\n      + \")\",\n    ast.MethodCall { recv, name, args } => text.wrap(recv, 12, d)\n      + \".\"\n      + name\n      + \"(\"\n      + text.args_text(args, d)\n      + \")\",\n    ast.FieldOf { base, name } => text.wrap(base, 12, d) + \".\" + name,\n    ast.Lambda { params, body } => {\n      (ps, b) := text.lambda_view(params, body)\n      text.lambda_params(ps) + \" -> \" + text.expr_text(b, d)\n    },\n    ast.Binary { op, left, right } => {\n      p := text.prec(e)\n      match op {\n        ast.Implies => text.wrap(left, p + 1, d) + \" ==> \" + text.wrap(right, p, d),\n        ast.Equal | ast.NotEqual | ast.Less | ast.LessEq | ast.Greater | ast.GreaterEq => {\n          // `(x & 255) == x`: a bit operation compared is shown in parentheses,\n          // since C and its readers put `==` before `&`, `|`, `^`\n          l := if text.bitwise(left) {\n            \"(\" + text.expr_text(left, d) + \")\"\n          } else {\n            text.wrap(left, p, d)\n          }\n          r := if text.bitwise(right) {\n            \"(\" + text.expr_text(right, d) + \")\"\n          } else {\n            text.wrap(right, p + 1, d)\n          }\n          l + \" \" + text.symbol(op) + \" \" + r\n        },\n        _ => text.wrap(left, p, d)\n          + \" \"\n          + text.symbol(op)\n          + \" \"\n          + text.wrap(right, p + 1, d),\n      }\n    },\n    ast.Unary { op, operand } => match op {\n      ast.Neg => \"-\" + text.wrap(operand, 11, d),\n      ast.Not => \"!\" + text.wrap(operand, 11, d),\n    },\n    ast.IsExpr { value, variant } => text.wrap(value, 4, d) + \" is \" + variant,\n    ast.IfExpr { cond, then, otherwise } => {\n      s := \"if \" + text.head(cond, d) + \" \" + text.block_text(then, d)\n      match otherwise {\n        ast.UnitExpr => s,\n        ast.IfExpr { .. } => s + \" else \" + text.expr_text(otherwise, d),\n        _ => s + \" else \" + text.block_text(otherwise, d),\n      }\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      as_name := match binding {\n        Some(n) => \" as \" + n,\n        None => \"\",\n      }\n      mut out := \"match \" + text.head(scrutinee, d) + as_name + \" {\\n\"\n      for a in arms {\n        out += text.comments_text(a.comments, d + 1)\n        each := match a.pat {\n          ast.ForPat { each, list, .. } => \" for \"\n            + text.pattern_text(each)\n            + \" in \"\n            + text.head(list, d + 1),\n          _ => \"\",\n        }\n        out += text.ind(d + 1)\n          + text.pattern_text(a.pat)\n          + \" => \"\n          + text.expr_text(a.body, d + 1)\n          + each\n          + \",\\n\"\n      }\n      out + text.ind(d) + \"}\"\n    },\n    ast.Block { .. } => text.block_text(e, d),\n    ast.MockExpr(t) => \"mock \" + text.type_text(t),\n    ast.MutExpr(x) => \"mut \" + text.expr_text(x, d),\n    // `comptime` takes a unary expression: `comptime (a ?? b)`\n    ast.Comptime(x) => \"comptime \" + text.wrap(x, 11, d),\n    // `assumed` is written before the contract's keyword\n    ast.Assumed(x) => text.inline(x, d),\n    // `old` takes a unary expression without a sign: `old (-x)`, `old (a + b)`\n    ast.Old(x) => {\n      s := text.wrap(x, 11, d)\n      if starts_with(s, \"-\") || starts_with(s, \"!\") {\n        \"old (\" + s + \")\"\n      } else {\n        \"old \" + s\n      }\n    },\n    // a call's argument: `f(...x)`\n    ast.Spread(x) => \"...\" + text.expr_text(x, d),\n    ast.Spawn(x) => \"spawn \" + text.expr_text(x, d),\n    ast.SupervisedSpawn(x) => \"supervised spawn \" + text.expr_text(x, d),\n    // a handler on the operand's chain needs parentheses: `await (a!)`, since\n    // `await a!` is `(await a)!`\n    ast.Await(x) => if text.handler_on_spine(x) {\n      \"await (\" + text.expr_text(x, d) + \")\"\n    } else {\n      \"await \" + text.wrap(x, 11, d)\n    },\n    ast.Scope(b) => \"scope \" + text.block_text(b, d),\n    ast.Select(arms) | ast.Race(arms) => {\n      mut out := match e {\n        ast.Race(_) => \"race {\\n\",\n        _ => \"select {\\n\",\n      }\n      for a in arms {\n        as_name := match a.name {\n          Some(n) => \" as \" + n,\n          None => \"\",\n        }\n        // a supervised race arm is `supervised e`\n        op := match (e, a.op) {\n          (ast.Race(_), ast.SupervisedSpawn(x)) => \"supervised \" + text.expr_text(x, d + 1),\n          _ => text.expr_text(a.op, d + 1),\n        }\n        out += text.ind(d + 1)\n          + op\n          + as_name\n          + \" => \"\n          + text.expr_text(a.body, d + 1)\n          + \",\\n\"\n      }\n      out + text.ind(d) + \"}\"\n    },\n    ast.Interp(parts) => {\n      mut s := \"f\\\"\"\n      for p in parts {\n        s += match p {\n          // a lone `\\` before a brace is written `\\\\`: `\\{{` would read as `\\{`\n          // then `{`\n          ast.TextPart(l) => replace(replace(replace(\n            replace(text.escape(l), \"\\{\", \"\\\\\\{\"),\n            \"\\}\",\n            \"\\\\\\}\",\n          ), \"{\", \"{{\"), \"}\", \"}}\"),\n          ast.ValuePart { value, spec } => \"{\"\n            + text.inline(value, 0)\n            + match spec {\n              Some(f) => \":\" + text.spec_text(f),\n              None => \"\",\n            }\n            + \"}\",\n        }\n      }\n      s + \"\\\"\"\n    },\n    ast.Range { lo, hi, inclusive } => match lo {\n        Some(x) => text.wrap(x, 1, d),\n        None => \"\",\n      }\n      + if inclusive {\n        \"..=\"\n      } else {\n        \"..\"\n      }\n      + match hi {\n        Some(x) => text.wrap(x, 1, d),\n        None => \"\",\n      },\n    ast.Index { base, index } => text.wrap(base, 12, d) + \"[\" + text.expr_text(index, d) + \"]\",\n    ast.Comp { kind, elem, fors } => {\n      (open, close) := match kind {\n        ast.ListComp => (\"[\", \"]\"),\n        ast.SetComp => (\"Set { \", \" }\"),\n        ast.DictComp => (\"Dict { \", \" }\"),\n      }\n      mut s := open\n        + match (kind, elem) {\n          (ast.DictComp, ast.TupleExpr([k, v])) => text.expr_text(k, d) + \": \" + text.expr_text(v, d),\n          _ => text.expr_text(elem, d),\n        }\n      for g in fors {\n        s += \" for \"\n          + text.pattern_text(g.pat)\n          + \" in \"\n          + text.expr_text(g.iter, d)\n        match g.cond {\n          Some(c) => {\n            s += \" where \" + text.expr_text(c, d)\n          },\n          None => (),\n        }\n      }\n      s + close\n    },\n    ast.DictExpr { types, entries } => text.collection(\"Dict\", types, entries.map(\n      kv -> text.expr_text(kv.0, d) + \": \" + text.expr_text(kv.1, d),\n    )),\n    ast.SetExpr { types, elems } => text.collection(\n      \"Set\",\n      types,\n      elems.map(x -> text.expr_text(x, d)),\n    ),\n    ast.Return(ast.UnitExpr) => \"return\",\n    ast.Return(x) => \"return \" + text.expr_text(x, d),\n    ast.Try { value, kind } => text.handled(value, d)\n      + match kind {\n        ast.TryResult => \"!\",\n        ast.TryOption => \"?\",\n      },\n    ast.Except { value, err, fallback } => if text.shorthand(e) {\n      text.wrap(value, 5, d) + \" !! \" + text.wrap(fallback, 4, d)\n    } else {\n      keyword := match err {\n        Some(n) => \"except \" + n,\n        None => \"except\",\n      }\n      text.fallback_text(\n        text.handled(value, d) + \" \" + keyword,\n        fallback,\n        d,\n      )\n    },\n    ast.Fallback { value, fallback } => if text.shorthand(e) {\n      text.wrap(value, 5, d) + \" ?? \" + text.wrap(fallback, 4, d)\n    } else {\n      text.fallback_text(\n        text.handled(value, d) + \" or\",\n        fallback,\n        d,\n      )\n    },\n  }\n}","old_text":"/// An expression on one line, except for the blocks inside it (laid out at\n/// depth `d`) and for what its parts break.\nfn inline(e: ast.Expr, d: Int) -> String {\n  match e {\n    ast.IntLit(n) => to_string(n),\n    ast.BigIntLit(digits) => digits,\n    ast.FloatLit(f) => text.float_text(f),\n    ast.TupleExpr(es) => \"(\" + text.args_text(es, d) + \")\",\n    ast.StrLit(s) => \"\\\"\" + text.escape(s) + \"\\\"\",\n    ast.BoolLit(b) => to_string(b),\n    ast.UnitExpr => \"()\",\n    ast.Var(v) => v,\n    ast.Hole(h) => \"?\" + h,\n    ast.ListExpr(es) => \"[\" + text.args_text(es, d) + \"]\",\n    ast.CtorExpr { name, args } => match args {\n      ast.NoArgs => name,\n      ast.PositionalArgs(es) => name + \"(\" + text.args_text(es, d) + \")\",\n      ast.RecordArgs(fs) => if len(fs) == 0 {\n        name + \" {}\"\n      } else {\n        name + \" { \" + join(text.named_parts(fs, d), \", \") + \" }\"\n      },\n      ast.UpdateArgs { base, fields } => name\n        + \" { \"\n        + join([\"..\", text.expr_text(base, d)], \"\")\n        + if len(fields) == 0 {\n          \"\"\n        } else {\n          \", \" + join(text.named_parts(fields, d), \", \")\n        }\n        + \" }\",\n    },\n    ast.Call { callee, args } => text.callee_text(callee, d)\n      + \"(\"\n      + text.args_text(args, d)\n      + \")\",\n    ast.MethodCall { recv, name, args } => text.wrap(recv, 12, d)\n      + \".\"\n      + name\n      + \"(\"\n      + text.args_text(args, d)\n      + \")\",\n    ast.FieldOf { base, name } => text.wrap(base, 12, d) + \".\" + name,\n    ast.Lambda { params, body } => {\n      (ps, b) := text.lambda_view(params, body)\n      text.lambda_params(ps) + \" -> \" + text.expr_text(b, d)\n    },\n    ast.Binary { op, left, right } => {\n      p := text.prec(e)\n      match op {\n        ast.Implies => text.wrap(left, p + 1, d) + \" ==> \" + text.wrap(right, p, d),\n        ast.Equal | ast.NotEqual | ast.Less | ast.LessEq | ast.Greater | ast.GreaterEq => {\n          // `(x & 255) == x`: a bit operation compared is shown in parentheses,\n          // since C and its readers put `==` before `&`, `|`, `^`\n          l := if text.bitwise(left) {\n            \"(\" + text.expr_text(left, d) + \")\"\n          } else {\n            text.wrap(left, p, d)\n          }\n          r := if text.bitwise(right) {\n            \"(\" + text.expr_text(right, d) + \")\"\n          } else {\n            text.wrap(right, p + 1, d)\n          }\n          l + \" \" + text.symbol(op) + \" \" + r\n        },\n        _ => text.wrap(left, p, d)\n          + \" \"\n          + text.symbol(op)\n          + \" \"\n          + text.wrap(right, p + 1, d),\n      }\n    },\n    ast.Unary { op, operand } => match op {\n      ast.Neg => \"-\" + text.wrap(operand, 11, d),\n      ast.Not => \"!\" + text.wrap(operand, 11, d),\n    },\n    ast.IsExpr { value, variant } => text.wrap(value, 4, d) + \" is \" + variant,\n    ast.IfExpr { cond, then, otherwise } => {\n      s := \"if \" + text.head(cond, d) + \" \" + text.block_text(then, d)\n      match otherwise {\n        ast.UnitExpr => s,\n        ast.IfExpr { .. } => s + \" else \" + text.expr_text(otherwise, d),\n        _ => s + \" else \" + text.block_text(otherwise, d),\n      }\n    },\n    ast.MatchExpr { scrutinee, binding, arms } => {\n      as_name := match binding {\n        Some(n) => \" as \" + n,\n        None => \"\",\n      }\n      mut out := \"match \" + text.head(scrutinee, d) + as_name + \" {\\n\"\n      for a in arms {\n        out += text.comments_text(a.comments, d + 1)\n        each := match a.pat {\n          ast.ForPat { each, list, .. } => \" for \"\n            + text.pattern_text(each)\n            + \" in \"\n            + text.head(list, d + 1),\n          _ => \"\",\n        }\n        out += text.ind(d + 1)\n          + text.pattern_text(a.pat)\n          + \" => \"\n          + text.expr_text(a.body, d + 1)\n          + each\n          + \",\\n\"\n      }\n      out + text.ind(d) + \"}\"\n    },\n    ast.Block { .. } => text.block_text(e, d),\n    ast.MockExpr(t) => \"mock \" + text.type_text(t),\n    ast.MutExpr(x) => \"mut \" + text.expr_text(x, d),\n    // `comptime` takes a unary expression: `comptime (a ?? b)`\n    ast.Comptime(x) => \"comptime \" + text.wrap(x, 11, d),\n    // `assumed` is written before the contract's keyword\n    ast.Assumed(x) => text.inline(x, d),\n    // `old` takes a unary expression without a sign: `old (-x)`, `old (a + b)`\n    ast.Old(x) => {\n      s := text.wrap(x, 11, d)\n      if starts_with(s, \"-\") || starts_with(s, \"!\") {\n        \"old (\" + s + \")\"\n      } else {\n        \"old \" + s\n      }\n    },\n    // a call's argument: `f(...x)`\n    ast.Spread(x) => \"...\" + text.expr_text(x, d),\n    ast.Spawn(x) => \"spawn \" + text.expr_text(x, d),\n    ast.SupervisedSpawn(x) => \"supervised spawn \" + text.expr_text(x, d),\n    // a handler on the operand's chain needs parentheses: `await (a!)`, since\n    // `await a!` is `(await a)!`\n    ast.Await(x) => if text.handler_on_spine(x) {\n      \"await (\" + text.expr_text(x, d) + \")\"\n    } else {\n      \"await \" + text.wrap(x, 11, d)\n    },\n    ast.Scope(b) => \"scope \" + text.block_text(b, d),\n    ast.Select(arms) | ast.Race(arms) => {\n      mut out := match e {\n        ast.Race(_) => \"race {\\n\",\n        _ => \"select {\\n\",\n      }\n      for a in arms {\n        as_name := match a.name {\n          Some(n) => \" as \" + n,\n          None => \"\",\n        }\n        // a supervised race arm is `supervised e`\n        op := match (e, a.op) {\n          (ast.Race(_), ast.SupervisedSpawn(x)) => \"supervised \" + text.expr_text(x, d + 1),\n          _ => text.expr_text(a.op, d + 1),\n        }\n        out += text.ind(d + 1)\n          + op\n          + as_name\n          + \" => \"\n          + text.expr_text(a.body, d + 1)\n          + \",\\n\"\n      }\n      out + text.ind(d) + \"}\"\n    },\n    ast.Interp(parts) => {\n      mut s := \"f\\\"\"\n      for p in parts {\n        s += match p {\n          // a lone `\\` before a brace is written `\\\\`: `\\{{` would read as `\\{`\n          // then `{`\n          ast.TextPart(l) => replace(replace(replace(\n            replace(text.escape(l), \"\\{\", \"\\\\\\{\"),\n            \"\\}\",\n            \"\\\\\\}\",\n          ), \"{\", \"{{\"), \"}\", \"}}\"),\n          ast.ValuePart { value, spec } => \"{\"\n            + text.inline(value, 0)\n            + match spec {\n              Some(f) => \":\" + text.spec_text(f),\n              None => \"\",\n            }\n            + \"}\",\n        }\n      }\n      s + \"\\\"\"\n    },\n    ast.Range { lo, hi, inclusive } => match lo {\n        Some(x) => text.wrap(x, 1, d),\n        None => \"\",\n      }\n      + if inclusive {\n        \"..=\"\n      } else {\n        \"..\"\n      }\n      + match hi {\n        Some(x) => text.wrap(x, 1, d),\n        None => \"\",\n      },\n    ast.Index { base, index } => text.wrap(base, 12, d) + \"[\" + text.expr_text(index, d) + \"]\",\n    ast.Comp { kind, elem, fors } => {\n      (open, close) := match kind {\n        ast.ListComp => (\"[\", \"]\"),\n        ast.SetComp => (\"Set { \", \" }\"),\n        ast.DictComp => (\"Dict { \", \" }\"),\n      }\n      mut s := open\n        + match (kind, elem) {\n          (ast.DictComp, ast.TupleExpr([k, v])) => text.expr_text(k, d) + \": \" + text.expr_text(v, d),\n          _ => text.expr_text(elem, d),\n        }\n      for g in fors {\n        s += \" for \"\n          + text.pattern_text(g.pat)\n          + \" in \"\n          + text.expr_text(g.iter, d)\n        match g.cond {\n          Some(c) => {\n            s += \" where \" + text.expr_text(c, d)\n          },\n          None => (),\n        }\n      }\n      s + close\n    },\n    ast.DictExpr { types, entries } => text.collection(\"Dict\", types, entries.map(\n      kv -> text.expr_text(kv.0, d) + \": \" + text.expr_text(kv.1, d),\n    )),\n    ast.SetExpr { types, elems } => text.collection(\n      \"Set\",\n      types,\n      elems.map(x -> text.expr_text(x, d)),\n    ),\n    ast.Return(ast.UnitExpr) => \"return\",\n    ast.Return(x) => \"return \" + text.expr_text(x, d),\n    ast.Try { value, kind } => text.handled(value, d)\n      + match kind {\n        ast.TryResult => \"!\",\n        ast.TryOption => \"?\",\n      },\n    ast.Except { value, err, fallback } => if text.shorthand(e) {\n      text.wrap(value, 5, d) + \" !! \" + text.wrap(fallback, 4, d)\n    } else {\n      keyword := match err {\n        Some(n) => \"except \" + n,\n        None => \"except\",\n      }\n      text.fallback_text(\n        text.handled(value, d) + \" \" + keyword,\n        fallback,\n        d,\n      )\n    },\n    ast.Fallback { value, fallback } => if text.shorthand(e) {\n      text.wrap(value, 5, d) + \" ?? \" + text.wrap(fallback, 4, d)\n    } else {\n      text.fallback_text(\n        text.handled(value, d) + \" or\",\n        fallback,\n        d,\n      )\n    },\n  }\n}"},{"name":"desugar.anon_types","kind":"fn","old":null,"new":"47a8ff7f106f9cb0","interface_changed":true,"affected":[],"module":"desugar","text":"/// The record types the anonymous records and their types name\n/// (`$rec:id:total`) and neither `ds` nor `context` declares: one per set\n/// of field names, generic in each field's type, its fields in order of\n/// name, in the root module. `{ id: 1, total: 0 }` is a\n/// `$rec:id:total[Int, Int]`.\nfn anon_types(ds: List[ast.Decl], context: List[ast.Decl]) -> List[ast.Decl] {\n  mut have := Set[String] {}\n  for d in ds + context {\n    match d.kind {\n      ast.TypeDef(t) => if starts_with(t.name, \"$rec:\") {\n        mut have.insert(t.name)\n      },\n      _ => (),\n    }\n  }\n  mut want := Set[String] {}\n  for d in ds {\n    for t in walk.decl_types(d) {\n      match t {\n        ast.Named { name, .. } => if starts_with(name, \"$rec:\") {\n          mut want.insert(name)\n        },\n        _ => (),\n      }\n    }\n    for e in decl_exprs(d) {\n      match e {\n        ast.CtorExpr { name, .. } => if starts_with(name, \"$rec:\") {\n          mut want.insert(name)\n        },\n        _ => (),\n      }\n    }\n  }\n  mut out := []\n  for n in to_list(want).sorted() {\n    if !contains(have, n) {\n      fs := drop(split(n, \":\"), 1)\n      mut out.push(\n        ast.Decl {\n          comments: [],\n          doc: [],\n          module: \"\",\n          public: true,\n          kind: ast.TypeDef(ast.TypeDecl {\n            distinct: false,\n            name: n,\n            params: fs.map(f -> \"$\" + f),\n            body: ast.RecordBody(fs.map(\n              f -> ast.Field {\n                comments: [],\n                doc: [],\n                name: f,\n                ty: ast.Named { name: \"$\" + f, args: [] },\n                default: None,\n              },\n            )),\n            refinement: None,\n            mocked: false,\n          }),\n        },\n      )\n    }\n  }\n  out\n}"},{"name":"parse.row_open","kind":"fn","old":null,"new":"dc286de9d446b610","interface_changed":true,"affected":[],"module":"parse","text":"/// Whether the structural type starting here ends with `..`: a `..` before\n/// the `}` that closes it.\nfn row_open(p: parse.Parser) -> Bool {\n  mut depth := 0\n  mut k := 0\n  while p.pos + k < len(p.toks) {\n    t := parse.peek_at(p, k)\n    if t == lex.Eof {\n      return false\n    }\n    if t == lex.Sym(\"{\") || t == lex.Sym(\"(\") || t == lex.Sym(\"[\") {\n      depth += 1\n    } else if t == lex.Sym(\"}\") || t == lex.Sym(\")\") || t == lex.Sym(\"]\") {\n      if depth == 0 {\n        return false\n      }\n      depth -= 1\n    } else if t == lex.Sym(\"..\") && depth == 0 {\n      return true\n    }\n    k += 1\n  }\n  false\n}"},{"name":"parse.closed_row","kind":"fn","old":null,"new":"13f83d241bf5a11c","interface_changed":true,"affected":[],"module":"parse","text":"/// `{ id: Int, total: Cents }` after its `{`, at its first field: an\n/// anonymous record's type, the generated record named by its fields in\n/// order of name (`$rec:id:total`), its fields' types its arguments.\nfn closed_row(mut p: parse.Parser) -> Result[ast.TypeExpr, String] {\n  mut fs := []\n  while !parse.is_sym(p, \"}\") {\n    n := parse.ident(mut p)!\n    if fs.any(f -> f.0 == n) {\n      return parse.fail(p, f\"field `{n}` is named twice\")\n    }\n    parse.expect_sym(mut p, \":\")!\n    mut fs.push((n, parse.type_expr(mut p)!))\n    if !parse.eat_sym(mut p, \",\") {\n      break\n    }\n  }\n  parse.expect_sym(mut p, \"}\")!\n  names := fs.map(f -> f.0).sorted()\n  Ok(ast.Named { name: parse.anon_name(names), args: names.map(\n    n ->\n      get(fs.filter(f -> f.0 == n).map(f -> f.1), 0) ?? ast.UnitType,\n  ) })\n}"},{"name":"parse.anon_name","kind":"fn","old":null,"new":"c1dbcf7e8a0e53d5","interface_changed":true,"affected":[],"module":"parse","text":"/// The record type generated for the anonymous records with these fields\n/// (in order of name): `$rec:id:total`.\npub fn anon_name(names: List[String]) -> String {\n  \"$rec:\" + join(names, \":\")\n}"},{"name":"parse.anon_record","kind":"fn","old":null,"new":"f096e7c5c62be971","interface_changed":true,"affected":[],"module":"parse","text":"/// `{ id: 1, total: 0 }` at its `{`: an anonymous record, a constructor of\n/// the record type generated for its fields.\nfn anon_record(mut p: parse.Parser) -> Result[ast.Expr, String] {\n  parse.expect_sym(mut p, \"{\")!\n  (ns, np) := (p.no_struct, p.no_pipe)\n  p.no_struct = false\n  p.no_pipe = false\n  mut fs := []\n  while !parse.is_sym(p, \"}\") {\n    n := parse.ident(mut p)!\n    if fs.any(f -> f.0 == n) {\n      return parse.fail(p, f\"field `{n}` is given twice\")\n    }\n    parse.expect_sym(mut p, \":\")!\n    mut fs.push((n, parse.expr(mut p)!))\n    if !parse.eat_sym(mut p, \",\") {\n      break\n    }\n  }\n  parse.expect_sym(mut p, \"}\")!\n  p.no_struct = ns\n  p.no_pipe = np\n  Ok(ast.CtorExpr {\n    name: parse.anon_name(fs.map(f -> f.0).sorted()),\n    args: ast.RecordArgs(fs),\n  })\n}"},{"name":"text.ctor_open","kind":"fn","old":null,"new":"36fb39319dcbb93e","interface_changed":true,"affected":[],"module":"text","text":"/// A record literal's fields (`sku`, `qty: 1`), each as `show` gives a value.\n/// A record literal's opening: `Order {`, or `{` for an anonymous record.\nfn ctor_open(name: String) -> String {\n  if starts_with(name, \"$rec:\") {\n    \"{\"\n  } else {\n    name + \" {\"\n  }\n}"}]}
{"id":"17030853f399e9b9","time":1795731501,"message":"edit","changes":[{"name":"check.field_met","kind":"fn","old":"6f243c45e4b350b7","new":"417bc3542c9aef65","interface_changed":false,"affected":[],"module":"check","text":"/// Field `f` of a structural bound, given by a field of `owner` of type\n/// `got` (`got_w` as written): its type fits, and a refined one is the\n/// same written type (the callee is proven knowing the refinement).\nfn field_met(\n  mut i: check.Inf,\n  what: String,\n  owner: String,\n  f: (String, check.Ty, ast.TypeExpr),\n  vars: Dict[String, check.Ty],\n  got: check.Ty,\n  got_w: ast.TypeExpr,\n) {\n  want := check.inst(f.1, vars)\n  if !check.fits(mut i, want, got) {\n    w := check.shown(check.res(i, want)) ?? text.type_text(f.2)\n    g := check.shown(check.res(i, got)) ?? text.type_text(got_w)\n    check.error(\n      mut i,\n      what + f\"field `{f.0}` of `{owner}` is `{g}`, not `{w}`\",\n    )\n  } else if check.row_refined(i.types, f.2, 0)\n    && got_w != f.2\n    && !starts_with(owner, \"{\") {\n    check.error(\n      mut i,\n      what\n        + f\"field `{f.0}` of `{owner}` is `{text.type_text(got_w)}`, not `{text.type_text(f.2)}` (a refined field is given by a field of the same type)\",\n    )\n  }\n}","old_text":"/// Field `f` of a structural bound, given by a field of `owner` of type\n/// `got` (`got_w` as written): its type fits, and a refined one is the\n/// same written type (the callee is proven knowing the refinement).\nfn field_met(\n  mut i: check.Inf,\n  what: String,\n  owner: String,\n  f: (String, check.Ty, ast.TypeExpr),\n  vars: Dict[String, check.Ty],\n  got: check.Ty,\n  got_w: ast.TypeExpr,\n) {\n  want := check.inst(f.1, vars)\n  if !check.fits(mut i, want, got) {\n    w := check.shown(check.res(i, want)) ?? text.type_text(f.2)\n    g := check.shown(check.res(i, got)) ?? text.type_text(got_w)\n    check.error(\n      mut i,\n      what + f\"field `{f.0}` of `{owner}` is `{g}`, not `{w}`\",\n    )\n  } else if check.row_refined(i.types, f.2, 0) && got_w != f.2 {\n    check.error(\n      mut i,\n      what\n        + f\"field `{f.0}` of `{owner}` is `{text.type_text(got_w)}`, not `{text.type_text(f.2)}` (a refined field is given by a field of the same type)\",\n    )\n  }\n}"},{"name":"smt.call_contract","kind":"fn","old":"7c5461a88ab04cbc","new":"b32cbe7d9d77479c","interface_changed":false,"affected":[],"module":"smt","text":"/// A call seen through the callee's contract: its parameters' refinements\n/// and `requires` are checked, its result type and `ensures` assumed. A\n/// `mut` parameter comes back as a valid value of its type (a list's\n/// elements included) that the `ensures` describe, `old` the argument.\nfn call_contract(\n  mut vc: smt.Vc,\n  label: String,\n  f: ast.FnDecl,\n  args: List[smt.Val],\n) -> smt.Val {\n  // a generic callee at the call's types (`Tree[K]`, not `Tree[T]`) when\n  // its arguments or the `let` it is bound to determine `T`\n  sub := smt.call_types(vc, f, args, vc.ret_type)\n  vc.ret_type = None\n  if vc.depth > 4 {\n    return smt.Opaque(f\"calls to `{label}` nest too deeply\")\n  }\n  if label == vc.self_name && vc.spec == 0 && !vc.dead {\n    // a recursive call: kept, to check measures against\n    mut vc.rec_sites.push((vc.pc, args))\n    // a `decreases` clause: its measure goes down at each recursive call\n    ms := text.decreases_of(f.body)\n    if ms != [] && smt.start_goal(mut vc) {\n      (bs, as_) := smt.measures_at(mut vc, ms, args)\n      smt.oblige(mut vc, \"decreases `\"\n        + drop_bytes(text.decreases_text(f.body), 10)\n        + \"` at a call of `\"\n        + label\n        + \"`\", smt.lex_down(bs, as_))\n    }\n  }\n  mut binds := []\n  for (i, p) in enumerate(f.params) {\n    match get(args, i) {\n      Some(a) => mut binds.push((p.name, a)),\n      None => (),\n    }\n  }\n  for (i, p) in enumerate(f.params) {\n    match get(args, i) {\n      Some(a) => if smt.refined(vc, p.ty) {\n        if smt.start_goal(mut vc) {\n          g := smt.check_type(mut vc, smt.subst(p.ty, sub), a, [])\n          smt.oblige(\n            mut vc,\n            f\"argument `{p.name}` of `{label}`: {text.type_text(p.ty)}\",\n            g,\n          )\n        }\n      },\n      None => (),\n    }\n  }\n  smt.row_arguments(mut vc, label, f, args)\n  for r in f.pre {\n    if smt.start_goal(mut vc) {\n      g := smt.pred(mut vc, r, binds)\n      smt.oblige(\n        mut vc,\n        f\"precondition of `{label}`: requires {text.expr_text(r, 0)}\",\n        g,\n      )\n    }\n  }\n  old := vc.reason\n  vc.reason = Some(\n    f\"the result of `{smt.shown_name(label)}` (only its contract is known)\",\n  )\n  ret := smt.subst(f.ret, sub)\n  res := match smt.receiver_term(mut vc, label, f, args, ret) {\n    Some(v) => v,\n    None => smt.shape(mut vc, ret),\n  }\n  // the `mut` parameters come back as any values of their types. The\n  // `ensures` say what they are (`old x`: the argument before the call).\n  mut after := []\n  mut post := []\n  for (i, p) in enumerate(f.params) {\n    match get(args, i) {\n      Some(a) => if p.mutable {\n        // (a list: any list of valid elements, at the call's types)\n        pt := smt.subst(p.ty, sub)\n        nv := smt.refresh_as(mut vc, a, pt)\n        smt.assume(mut vc, smt.check_type(mut vc, pt, nv, []))\n        // in a trial pass, with no refinement and no `ensures` naming it,\n        // nothing is known of it, so what names it is no invariant\n        if vc.trial > 0\n          && !smt.refined(vc, p.ty)\n          && !f.post.any(en -> smt.names_var(en, p.name)) {\n          mut vc.wiped.push(nv)\n        }\n        mut after.push(nv)\n        mut post.push((p.name, nv))\n      } else {\n        mut after.push(a)\n        mut post.push((p.name, a))\n      },\n      None => (),\n    }\n  }\n  vc.reason = old\n  if label != vc.self_name {\n    smt.congruent(mut vc, label, f, args, res)\n  }\n  vc.depth += 1\n  vc.spec += 1\n  c := smt.check_type(mut vc, ret, res, binds)\n  smt.assume(mut vc, c)\n  for en in f.post {\n    c2 := smt.pred_old(mut vc, en, post + [(\"it\", res)], Some(binds))\n    smt.assume(mut vc, c2)\n  }\n  vc.spec -= 1\n  vc.depth -= 1\n  vc.after = after\n  res\n}","old_text":"/// A call seen through the callee's contract: its parameters' refinements\n/// and `requires` are checked, its result type and `ensures` assumed. A\n/// `mut` parameter comes back as a valid value of its type (a list's\n/// elements included) that the `ensures` describe, `old` the argument.\nfn call_contract(\n  mut vc: smt.Vc,\n  label: String,\n  f: ast.FnDecl,\n  args: List[smt.Val],\n) -> smt.Val {\n  // a generic callee at the call's types (`Tree[K]`, not `Tree[T]`) when\n  // its arguments or the `let` it is bound to determine `T`\n  sub := smt.call_types(vc, f, args, vc.ret_type)\n  vc.ret_type = None\n  if vc.depth > 4 {\n    return smt.Opaque(f\"calls to `{label}` nest too deeply\")\n  }\n  if label == vc.self_name && vc.spec == 0 && !vc.dead {\n    // a recursive call: kept, to check measures against\n    mut vc.rec_sites.push((vc.pc, args))\n    // a `decreases` clause: its measure goes down at each recursive call\n    ms := text.decreases_of(f.body)\n    if ms != [] && smt.start_goal(mut vc) {\n      (bs, as_) := smt.measures_at(mut vc, ms, args)\n      smt.oblige(mut vc, \"decreases `\"\n        + drop_bytes(text.decreases_text(f.body), 10)\n        + \"` at a call of `\"\n        + label\n        + \"`\", smt.lex_down(bs, as_))\n    }\n  }\n  mut binds := []\n  for (i, p) in enumerate(f.params) {\n    match get(args, i) {\n      Some(a) => mut binds.push((p.name, a)),\n      None => (),\n    }\n  }\n  for (i, p) in enumerate(f.params) {\n    match get(args, i) {\n      Some(a) => if smt.refined(vc, p.ty) {\n        if smt.start_goal(mut vc) {\n          g := smt.check_type(mut vc, smt.subst(p.ty, sub), a, [])\n          smt.oblige(\n            mut vc,\n            f\"argument `{p.name}` of `{label}`: {text.type_text(p.ty)}\",\n            g,\n          )\n        }\n      },\n      None => (),\n    }\n  }\n  for r in f.pre {\n    if smt.start_goal(mut vc) {\n      g := smt.pred(mut vc, r, binds)\n      smt.oblige(\n        mut vc,\n        f\"precondition of `{label}`: requires {text.expr_text(r, 0)}\",\n        g,\n      )\n    }\n  }\n  old := vc.reason\n  vc.reason = Some(\n    f\"the result of `{smt.shown_name(label)}` (only its contract is known)\",\n  )\n  ret := smt.subst(f.ret, sub)\n  res := match smt.receiver_term(mut vc, label, f, args, ret) {\n    Some(v) => v,\n    None => smt.shape(mut vc, ret),\n  }\n  // the `mut` parameters come back as any values of their types. The\n  // `ensures` say what they are (`old x`: the argument before the call).\n  mut after := []\n  mut post := []\n  for (i, p) in enumerate(f.params) {\n    match get(args, i) {\n      Some(a) => if p.mutable {\n        // (a list: any list of valid elements, at the call's types)\n        pt := smt.subst(p.ty, sub)\n        nv := smt.refresh_as(mut vc, a, pt)\n        smt.assume(mut vc, smt.check_type(mut vc, pt, nv, []))\n        // in a trial pass, with no refinement and no `ensures` naming it,\n        // nothing is known of it, so what names it is no invariant\n        if vc.trial > 0\n          && !smt.refined(vc, p.ty)\n          && !f.post.any(en -> smt.names_var(en, p.name)) {\n          mut vc.wiped.push(nv)\n        }\n        mut after.push(nv)\n        mut post.push((p.name, nv))\n      } else {\n        mut after.push(a)\n        mut post.push((p.name, a))\n      },\n      None => (),\n    }\n  }\n  vc.reason = old\n  if label != vc.self_name {\n    smt.congruent(mut vc, label, f, args, res)\n  }\n  vc.depth += 1\n  vc.spec += 1\n  c := smt.check_type(mut vc, ret, res, binds)\n  smt.assume(mut vc, c)\n  for en in f.post {\n    c2 := smt.pred_old(mut vc, en, post + [(\"it\", res)], Some(binds))\n    smt.assume(mut vc, c2)\n  }\n  vc.spec -= 1\n  vc.depth -= 1\n  vc.after = after\n  res\n}"},{"name":"smt.row_arguments","kind":"fn","old":null,"new":"a9c995f07f9d376a","interface_changed":true,"affected":[],"module":"smt","text":"/// At a call of `f`, each refined field a structural bound asks for\n/// (`[T: { total: Cents, .. }]`) holds of the argument's: `f` is proven\n/// assuming it. The checker has held a nominal record's field to the same\n/// written type; an anonymous record's field (`{ total: n }`, a\n/// `$rec:total[Int]`) is proven here.\nfn row_arguments(\n  mut vc: smt.Vc,\n  label: String,\n  f: ast.FnDecl,\n  args: List[smt.Val],\n) {\n  for b in f.bounds {\n    for tr in b.traits {\n      match tr {\n        ast.RowType(fs) => {\n          for (i, p) in enumerate(f.params) {\n            if (p.ty == ast.Named { name: b.param, args: [] }) {\n              match get(args, i) {\n                Some(a) => {\n                  for x in fs {\n                    if smt.refined(vc, x.1) && smt.start_goal(mut vc) {\n                      v := smt.field(mut vc, a, x.0)\n                      g := smt.check_type(mut vc, x.1, v, [])\n                      smt.oblige(\n                        mut vc,\n                        f\"argument `{p.name}` of `{label}`: field `{x.0}` is {text.type_text(x.1)}\",\n                        g,\n                      )\n                    }\n                  }\n                },\n                None => (),\n              }\n            }\n          }\n        },\n        _ => (),\n      }\n    }\n  }\n}"}]}
{"id":"9ca7f0e60bbd6a32","time":1795731811,"message":"edit","changes":[{"name":"text.named_parts","kind":"fn","old":"6dba8bbbbccde647","new":"45f770508a520d7d","interface_changed":false,"affected":[],"module":"text","text":"/// A record literal's fields (`sku`, `qty: 1`), each as `show` gives a value.\nfn named_parts(fs: List[(String, ast.Expr)], d: Int) -> List[String] {\n  fs.map(\n    f -> match f.1 {\n      ast.Var(v) => if v == f.0 {\n        f.0\n      } else {\n        f.0 + \": \" + v\n      },\n      x => f.0 + \": \" + text.expr_text(x, d),\n    },\n  )\n}","old_text":"fn named_parts(fs: List[(String, ast.Expr)], d: Int) -> List[String] {\n  fs.map(\n    f -> match f.1 {\n      ast.Var(v) => if v == f.0 {\n        f.0\n      } else {\n        f.0 + \": \" + v\n      },\n      x => f.0 + \": \" + text.expr_text(x, d),\n    },\n  )\n}"},{"name":"text.ctor_open","kind":"fn","old":"36fb39319dcbb93e","new":"628836085ac5f958","interface_changed":false,"affected":[],"module":"text","text":"/// A record literal's opening: `Order {`, or `{` for an anonymous record.\nfn ctor_open(name: String) -> String {\n  if starts_with(name, \"$rec:\") {\n    \"{\"\n  } else {\n    name + \" {\"\n  }\n}","old_text":"/// A record literal's fields (`sku`, `qty: 1`), each as `show` gives a value.\n/// A record literal's opening: `Order {`, or `{` for an anonymous record.\nfn ctor_open(name: String) -> String {\n  if starts_with(name, \"$rec:\") {\n    \"{\"\n  } else {\n    name + \" {\"\n  }\n}"}]}
{"id":"be96426eb445ef1b","time":1795734155,"message":"edit","changes":[{"name":"check.infer_untagged","kind":"fn","old":"226fc7f33d315e4e","new":"2982dc35e47fc0cc","interface_changed":false,"affected":[],"module":"check","text":"/// The type of `e`, where `expected` is the type its place asks for. The\n/// mismatches found go to `i.errs`, in the order found.\nfn infer_untagged(\n  mut i: check.Inf,\n  e: ast.Expr,\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  match e {\n    ast.IntLit(_) => check.int_literal(mut i, e, expected),\n    ast.BigIntLit(_) => check.int_literal(mut i, e, expected),\n    ast.FloatLit(_) => check.TFloat,\n    ast.StrLit(_) => check.TStr,\n    ast.BoolLit(_) => check.TBool,\n    ast.UnitExpr => check.TUnit,\n    // `env` holds declared types; a narrowed variable reads as a place\n    ast.Var(x) => match get(env, x) {\n      Some(t) => {\n        // a closure or `spawn` can't hold a handle from outside it\n        if contains(i.captured, x) && check.holds_task(check.res(i, t)) {\n          check.error(mut i, \"a closure or `spawn` can't hold `\"\n            + x\n            + \"`, a task's handle: await it where it was spawned\")\n        }\n        check.var_type(i, x, t)\n      },\n      None => match get(i.fns, x) {\n        // a function's type parameters: fresh at each use\n        Some(t) => check.inst(t, check.fresh_for(\n          mut i,\n          to_list(check.gens(t, Set[String] {})),\n        )),\n        None => check.trait_fn(mut i, x),\n      },\n    },\n    ast.Interp(parts) => {\n      for p in parts {\n        match p {\n          ast.ValuePart { value, spec } => {\n            t := check.listed_arg(\n              mut i,\n              \"$interp\",\n              0,\n              value,\n              check.TList(check.TAny),\n              check.infer(mut i, value, env, None),\n              \"interpolation\",\n            )\n            match spec {\n              Some(f) => check.check_spec(mut i, f, t),\n              None => (),\n            }\n          },\n          ast.TextPart(_) => (),\n        }\n      }\n      check.TStr\n    },\n    ast.Binary { op, left, right } => check.binary(mut i, op, left, right, env, expected),\n    // a negative literal of a sized type (`-2^63`, beyond 64 bits once negated)\n    ast.Unary { op, operand } => if op == ast.Neg\n      && check.is_int_lit(operand)\n      && check.sized_expected(i, expected) is Some {\n      _ := check.infer(mut i, operand, env, None)\n      check.int_literal(mut i, e, expected)\n    } else {\n      t := check.infer(mut i, operand, env, None)\n      if op == ast.Neg && !check.is_int_lit(operand) {\n        mut i.arith.push((\"-\", t))\n      }\n      match op {\n        ast.Neg => {\n          match check.res(i, t) {\n            check.TInt | check.TFloat | check.TAny => (),\n            check.TNamed { name, args } => if !(len(args) == 0 && check.is_sized(name)) {\n              check.error(\n                mut i,\n                \"operand of `-` must be Int or Float, found `\"\n                  + (check.shown(check.res(i, t)) ?? name)\n                  + \"`\",\n              )\n            },\n            check.TVar(_) => check.expect(mut i, check.TInt, t, \"operand of `-`\"),\n            other => match check.shown(other) {\n              Some(s) => check.error(\n                mut i,\n                \"operand of `-` must be Int or Float, found `\"\n                  + s\n                  + \"`\",\n              ),\n              None => (),\n            },\n          }\n          t\n        },\n        ast.Not => {\n          check.expect(mut i, check.TBool, t, \"operand of `!`\")\n          check.TBool\n        },\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => check.infer_if(mut i, cond, then, otherwise, env, expected),\n    ast.Block { stmts, last } => check.infer_block(mut i, stmts, last, env, expected),\n    ast.Call { callee, args } => check.infer_call(mut i, callee, args, env),\n    ast.ListExpr(es) => check.infer_list(mut i, es, env, expected),\n    ast.MatchExpr { scrutinee, binding, arms } => check.infer_match(\n      mut i,\n      scrutinee,\n      binding,\n      arms,\n      env,\n      expected,\n    ),\n    ast.Lambda { params, body } => check.infer_lambda(mut i, params, body, env, expected),\n    ast.Return(x) => {\n      r := i.ret\n      if check.outside_fn(check.res(i, r)) {\n        check.error(mut i, \"`return` outside a function\")\n        _ := check.infer(mut i, x, env, None)\n      } else {\n        t := check.infer(mut i, x, env, Some(r))\n        check.expect(mut i, r, t, \"`return` value\")\n      }\n      check.TAny\n    },\n    ast.IsExpr { value, .. } => {\n      _ := check.infer(mut i, value, env, None)\n      check.TBool\n    },\n    ast.TupleExpr(es) => {\n      // each element with the expected tuple's element as its hint\n      hints := match expected {\n        Some(e) => match check.res(i, e) {\n          check.TNamed { name, args } => if name == \"Tuple\" && len(args) == len(es) {\n            args\n          } else {\n            []\n          },\n          _ => [],\n        },\n        None => [],\n      }\n      mut ts := []\n      for (k, x) in enumerate(es) {\n        mut ts.push(check.infer(mut i, x, env, get(hints, k)))\n      }\n      check.TNamed { name: \"Tuple\", args: ts }\n    },\n    ast.CtorExpr { name: tagged, args: ast.UpdateArgs { base, fields } } => if starts_with(tagged, \"$upd:\") {\n      check.infer_update(mut i, tagged, base, fields, env)\n    } else {\n      match get(i.types.ctors, tagged) {\n        Some(sh) => check.infer_ctor(\n          mut i,\n          tagged,\n          sh,\n          ast.UpdateArgs { base, fields },\n          env,\n          expected,\n        ),\n        // a type parameter's record (`T { ..x, f: v }`, as `updates_named`\n        // writes it): its base's type\n        None => if contains(i.trows, tagged) {\n          check.infer_update(mut i, \"\", base, fields, env)\n        } else {\n          check.infer_all(mut i, [base] + fields.map(f -> f.1), env)\n          check.TAny\n        },\n      }\n    },\n    ast.CtorExpr { name, args } => match get(i.types.ctors, name) {\n      Some(sh) => check.infer_ctor(mut i, name, sh, args, env, expected),\n      None => {\n        match args {\n          ast.PositionalArgs(es) => check.infer_all(mut i, es, env),\n          ast.RecordArgs(fs) => check.infer_all(mut i, fs.map(f -> f.1), env),\n          ast.UpdateArgs { base, fields } => check.infer_all(mut i, [base] + fields.map(f -> f.1), env),\n          ast.NoArgs => (),\n        }\n        check.TAny\n      },\n    },\n    ast.MethodCall { recv, name, args } => check.infer_method(mut i, recv, name, args, env, false),\n    ast.FieldOf { base, name: tagged } => {\n      // a tagged read, `sku#0.1`: its receiver's type is kept for `rename`\n      (name, tag) := match check.untag(tagged) {\n        Some(nk) => nk,\n        None => (tagged, \"\"),\n      }\n      seq := i.call_seq\n      bt := check.infer(mut i, base, env, None)\n      if tag != \"\" {\n        mut i.insts.insert(tag + \":field\", bt)\n      }\n      // a call whose function speaks of its variant under a condition only\n      // `verify` decides: the field of the variants left that have it, which\n      // `verify` proves the result is one of (else it faults when it runs)\n      match (i.last_call, check.sum_variants(i, bt)) {\n        ((ls, _, vs, true), Some((_, targs, _))) => if ls == seq\n          && (base is ast.Call || base is ast.MethodCall)\n          && len(check.with_field(i, vs, name)) > 0 {\n          return check.variants_field(\n            mut i,\n            check.with_field(i, vs, name),\n            targs,\n            name,\n            check.shown(check.widened(check.res(i, bt))) ?? \"?\",\n          )\n        },\n        _ => (),\n      }\n      match check.res(i, bt) {\n        // a field of a value that has none\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => {\n          match check.shown(check.res(i, bt)) {\n            Some(x) => check.error(\n              mut i,\n              \"cannot access field `\" + name + \"` on `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          check.TAny\n        },\n        // `p.1`: a tuple's element\n        check.TNamed { name: \"Tuple\", args: targs } => match parse_int(name) {\n          Some(k) => match get(targs, k) {\n            Some(t) => check.place(i, t),\n            None => {\n              match check.shown(check.res(i, bt)) {\n                Some(x) => check.error(\n                  mut i,\n                  \"tuple `\" + x + \"` has no element \" + name,\n                ),\n                None => (),\n              }\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a field of the one variant a value is narrowed to\n        check.TVariants { names: [v], args: targs, .. } => match get(i.types.ctors, v) {\n          Some(sh) => match check.field_of(sh, name) {\n            Some(ft) => check.place(\n              i,\n              check.inst(ft, check.pairs(sh.params, targs)),\n            ),\n            None => {\n              check.error(\n                mut i,\n                \"variant `\" + v + \"` has no field `\" + name + \"`\",\n              )\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a field every variant a value is narrowed to has\n        check.TVariants { names, args: targs, .. } => check.variants_field(\n          mut i,\n          names,\n          targs,\n          name,\n          check.shown(check.res(i, bt)) ?? \"?\",\n        ),\n        // a field every member of a union has, with the same type\n        check.TUnion(ms) => {\n          mut out: Option[check.Ty] = None\n          for m in ms {\n            ft := match m {\n              check.TNamed { name: mn, .. } => match get(i.types.ctors, mn) {\n                Some(sh) => check.field_of(sh, name),\n                None => None,\n              },\n              _ => None,\n            }\n            match ft {\n              Some(x) => {\n                out = Some(x)\n              },\n              None => {\n                mt := check.shown(m) ?? \"?\"\n                ut := check.shown(check.res(i, bt)) ?? \"?\"\n                check.error(\n                  mut i,\n                  f\"`{mt}` has no field `{name}`, so not every `{ut}` does (match on it first)\",\n                )\n                return check.TAny\n              },\n            }\n          }\n          match out {\n            Some(x) => check.place(i, x),\n            None => check.TAny,\n          }\n        },\n        // a type parameter's field, by its structural bound\n        check.TGen(p) => match get(i.trows, p) {\n          Some(fs) => match fs.filter(x -> x.0 == name) {\n            [x, ..] => check.place(i, x.1),\n            _ => {\n              check.error(\n                mut i,\n                f\"`{check.row_text(fs)}` has no field `{name}` (a value of a structural type has only the fields it names)\",\n              )\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a sum's field: one every variant has\n        check.TNamed { name: n, args: targs } => if contains(i.types.sums, n) && !contains(i.types.ctors, n) {\n          check.variants_field(\n            mut i,\n            get(i.types.variants, n) ?? [],\n            targs,\n            name,\n            check.shown(check.res(i, bt)) ?? n,\n          )\n        } else {\n          match get(i.types.ctors, n) {\n            // a record type; a sum's name is not a constructor\n            Some(sh) => match check.field_of(sh, name) {\n              Some(ft) => {\n                mut m := Dict[String, check.Ty] {}\n                for (k, p) in enumerate(sh.params) {\n                  mut m.insert(p, get(targs, k) ?? check.TAny)\n                }\n                check.place(i, check.inst(ft, m))\n              },\n              None => {\n                check.error(mut i, \"type `\"\n                  + n\n                  + \"` has no field `\"\n                  + name\n                  + \"` (match on variants to access their fields)\")\n                check.TAny\n              },\n            },\n            None => check.TAny,\n          }\n        },\n        _ => check.TAny,\n      }\n    },\n    // `mut q.claim(2)`: a call that changes its receiver\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => match check.untag(name) {\n      // a tagged call: its receiver's type is kept, as `infer` keeps it. A call\n      // spreading records, tagged by `spread_bound`, is written out.\n      Some(nk) => if starts_with(nk.1, \"s\") {\n        check.infer_spread(mut i, e, nk.1, env, expected)\n      } else {\n        rt := check.infer(mut i, recv, env, None)\n        mut i.insts.insert(nk.1 + \":recv\", rt)\n        t := check.infer_method(mut i, recv, nk.0, args, env, true)\n        mut i.insts.insert(nk.1, t)\n        t\n      },\n      None => check.infer_method(mut i, recv, name, args, env, true),\n    },\n    ast.MutExpr(x) => check.infer(mut i, x, env, expected),\n    // `r!`, `o?`: the value a `Result` or an `Option` holds\n    ast.Try { value, kind } => {\n      vt := check.infer(mut i, value, env, None)\n      want := if kind == ast.TryResult {\n        \"Result\"\n      } else {\n        \"Option\"\n      }\n      match check.res(i, vt) {\n        check.TNamed { name, args } => if name == want {\n          check.early_error(mut i, kind, if kind == ast.TryResult {\n            get(args, 1) ?? check.TAny\n          } else {\n            check.TAny\n          })\n          get(args, 0) ?? check.TAny\n        } else {\n          check.wrong_try(mut i, kind, check.res(i, vt))\n        },\n        check.TAny | check.TVar(_) => check.TAny,\n        other => check.wrong_try(mut i, kind, other),\n      }\n    },\n    // `r except e { fallback }`: the value, or the fallback (of the same\n    // type) with `e` the error\n    ast.Except { value, err, fallback } => {\n      vt := check.infer(mut i, value, env, None)\n      (ok, bad) := match check.res(i, vt) {\n        check.TNamed { name, args } => if name == \"Result\" && len(args) == 2 {\n          (get(args, 0) ?? check.TAny, get(args, 1) ?? check.TAny)\n        } else if name == \"Option\" {\n          check.error(\n            mut i,\n            \"`except` / `!!` handle a Result; an Option is handled with `or { … }` / `??`\",\n          )\n          (check.fresh(mut i), check.TAny)\n        } else {\n          check.not_result(mut i, check.res(i, vt))\n        },\n        check.TAny | check.TVar(_) => (check.TAny, check.TAny),\n        other => check.not_result(mut i, other),\n      }\n      inner := match err {\n        Some(n) => {\n          mut copy := env\n          mut copy.insert(n, bad)\n          copy\n        },\n        None => env,\n      }\n      ft := check.infer(mut i, fallback, inner, Some(ok))\n      check.expect(mut i, ok, ft, \"`except` fallback\")\n      ok\n    },\n    ast.Fallback { value, fallback } => {\n      vt := check.infer(mut i, value, env, None)\n      inner := match check.res(i, vt) {\n        check.TNamed { name, args } => if name == \"Option\" && len(args) == 1 {\n          get(args, 0) ?? check.TAny\n        } else if name == \"Result\" && len(args) == 2 {\n          check.error(\n            mut i,\n            \"`or` / `??` handle an Option; a Result is handled with `except { … }` / `!!`\",\n          )\n          get(args, 0) ?? check.TAny\n        } else {\n          match check.shown(check.res(i, vt)) {\n            Some(x) => check.error(\n              mut i,\n              \"`or` / `??` handle an Option, found `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          check.fresh(mut i)\n        },\n        check.TAny => check.TAny,\n        other => {\n          match check.shown(other) {\n            Some(x) => check.error(\n              mut i,\n              \"`or` / `??` handle an Option, found `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          // the fallback's type, so checking goes on\n          check.fresh(mut i)\n        },\n      }\n      ft := check.infer(mut i, fallback, env, Some(inner))\n      check.expect(mut i, inner, ft, \"`or` fallback\")\n      inner\n    },\n    ast.Index { base, index } => {\n      bt := check.infer(mut i, base, env, None)\n      match index {\n        // `xs[a..b]`: a slice, of the same type\n        ast.Range { lo, hi, .. } => {\n          for x in [lo, hi] {\n            match x {\n              Some(v) => check.infer(mut i, v, env, Some(check.TInt)),\n              None => check.TAny,\n            }\n          }\n          match check.res(i, bt) {\n            check.TList(_) => bt,\n            _ => check.TAny,\n          }\n        },\n        // `xs[k]`: the built-in `at(xs, k)`\n        _ => match check.res(i, bt) {\n          check.TList(_) => match get(i.builtins, \"at\") {\n            Some(bs) => check.builtin_call(mut i, \"at\", bs, [bt], [index], env),\n            None => {\n              _ := check.infer(mut i, index, env, None)\n              check.TAny\n            },\n          },\n          _ => {\n            _ := check.infer(mut i, index, env, None)\n            check.TAny\n          },\n        },\n      }\n    },\n    // `a..b`: the list of the integers from `a`\n    ast.Range { lo, hi, .. } => {\n      for x in [lo, hi] {\n        match x {\n          Some(v) => check.infer(mut i, v, env, Some(check.TInt)),\n          None => check.TAny,\n        }\n      }\n      check.TList(check.TInt)\n    },\n    ast.Comp { kind, elem, fors } => {\n      mut seen := env\n      // over an iterator, one of the program's types or core's, a comprehension\n      // is lazy: an iterator instead of a list\n      mut lazy := false\n      for f in fors {\n        it := check.infer(mut i, f.iter, seen, None)\n        match check.res(i, it) {\n          check.TNamed { name, .. } => if contains(i.methods.impls, \"Iterator for \" + name)\n            || contains(i.methods.impls, \"FiniteIterator for \" + name) {\n            lazy = true\n          },\n          _ => (),\n        }\n        seen = check.bind_typed(\n          mut i,\n          seen,\n          f.pat,\n          check.element_of(i, it),\n        )\n        match f.cond {\n          Some(c) => check.infer(mut i, c, seen, None),\n          None => (),\n        }\n      }\n      et := check.infer(mut i, elem, seen, None)\n      // a list comprehension is a list of its element's type\n      if kind == ast.ListComp && !lazy {\n        check.TList(et)\n      } else {\n        check.TAny\n      }\n    },\n    ast.DictExpr { entries, .. } => {\n      for kv in entries {\n        check.infer_all(mut i, [kv.0, kv.1], env)\n      }\n      check.TAny\n    },\n    ast.SetExpr { elems, .. } => {\n      check.infer_all(mut i, elems, env)\n      check.TAny\n    },\n    ast.Comptime(x) => {\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    // `old e`: `e`'s value where the function started, of `e`'s type\n    ast.Old(x) => check.infer(mut i, x, env, expected),\n    // `...x` where `spread_bound` found no call by name to fill\n    ast.Spread(x) => {\n      check.spread_error(\n        mut i,\n        \"`...\"\n          + text.expr_text(x, 0)\n          + \"`: a spread gives a record's fields to the parameters of a function or method called by name; it can't be used here\",\n      )\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    ast.Assumed(x) => check.infer(mut i, x, env, expected),\n    // a `scope`'s result can't hold one of its tasks' handles\n    ast.Scope(x) => {\n      held := i.outside\n      i.outside = Some(set(keys(env)))\n      // `scope { …; spawn e }`: the last task's handle isn't its value\n      t := if check.ends_in_spawn(x) {\n        _ := check.infer(mut i, x, env, None)\n        check.TUnit\n      } else {\n        check.infer(mut i, x, env, expected)\n      }\n      i.outside = held\n      if check.holds_task(check.res(i, t)) {\n        match check.shown(check.res(i, t)) {\n          Some(s) => check.error(\n            mut i,\n            \"a task's handle can't leave its `scope` (its result is `\"\n              + s\n              + \"`): await it inside\",\n          ),\n          None => (),\n        }\n      }\n      t\n    },\n    // `spawn e`: a handle to `e`'s value\n    ast.Spawn(x) => {\n      outer := i.ret\n      i.ret = check.TAny\n      held := i.captured\n      i.captured = set(keys(env))\n      t := check.infer(mut i, x, env, None)\n      i.captured = held\n      i.ret = outer\n      // a sender is captured on its own, never inside another value\n      for v in keys(env).sorted() {\n        vt := check.res(i, get(env, v) ?? check.TAny)\n        if !(vt is check.TNamed && check.type_name(vt) == \"Sender\")\n          && check.holds_sender(i, vt, 8)\n          && check.uses(x, v)\n          && !check.rebinds(x, v) {\n          check.error(\n            mut i,\n            \"a task (a `spawn`, a `race` arm) can capture a sender only on its own (a variable holding it): `\"\n              + v\n              + \"` holds one inside\",\n          )\n        }\n      }\n      check.TNamed { name: \"Task\", args: [t] }\n    },\n    // `select`: each arm's operation (`rx.recv()` an `Option`, `tx.send(v)`,\n    // `await h`, `clock.after(d)` with `clock` a clock and `d` a `Duration`),\n    // its name, and its body with the type wanted\n    ast.Select(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.MethodCall { recv, name, args } => if name == \"after\" && len(args) == 1 {\n            ct := check.res(i, check.infer(mut i, recv, env, None))\n            match ct {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(ct) {\n                Some(x) => check.error(\n                  mut i,\n                  \"an `after` arm waits on a clock: `\"\n                    + x\n                    + \"` doesn't implement `Clock` (std.time)\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            dt := check.res(i, check.infer(\n              mut i,\n              get(args, 0) ?? ast.UnitExpr,\n              env,\n              None,\n            ))\n            match dt {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(dt) {\n                Some(x) => check.error(\n                  mut i,\n                  \"the time an `after` arm waits: expected `std.time.Duration`, found `\"\n                    + x\n                    + \"`\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            check.TUnit\n          } else {\n            check.infer(mut i, a.op, env, None)\n          },\n          _ => check.infer(mut i, a.op, env, None),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `race`: each left side is a task's body (a supervised one's result is a\n    // `Result[T, Panic]`), then its name and its body\n    ast.Race(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.SupervisedSpawn(x) => check.TNamed { name: \"Result\", args: [\n            check.task_body(mut i, x, env),\n            check.TNamed { name: \"Panic\", args: [] },\n          ] },\n          op => check.task_body(mut i, op, env),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `supervised spawn e`: a handle to `e`'s value, or its panic\n    ast.SupervisedSpawn(x) => check.TNamed {\n      name: \"Task\",\n      args: [check.TNamed { name: \"Result\", args: [\n        check.task_body(mut i, x, env),\n        check.TNamed { name: \"Panic\", args: [] },\n      ] }],\n    },\n    // `await h`: the task's value, or each task's for a tuple or list of handles\n    ast.Await(x) => {\n      t := check.infer(mut i, x, env, None)\n      check.awaited(mut i, check.res(i, t))\n    },\n    ast.Hole(h) => {\n      t := expected ?? check.fresh(mut i)\n      mut i.holes.push((h, t, env))\n      t\n    },\n    _ => check.TAny,\n  }\n}","old_text":"/// The type of `e`, where `expected` is the type its place asks for. The\n/// mismatches found go to `i.errs`, in the order found.\nfn infer_untagged(\n  mut i: check.Inf,\n  e: ast.Expr,\n  env: Dict[String, check.Ty],\n  expected: Option[check.Ty],\n) -> check.Ty {\n  match e {\n    ast.IntLit(_) => check.int_literal(mut i, e, expected),\n    ast.BigIntLit(_) => check.int_literal(mut i, e, expected),\n    ast.FloatLit(_) => check.TFloat,\n    ast.StrLit(_) => check.TStr,\n    ast.BoolLit(_) => check.TBool,\n    ast.UnitExpr => check.TUnit,\n    // `env` holds declared types; a narrowed variable reads as a place\n    ast.Var(x) => match get(env, x) {\n      Some(t) => {\n        // a closure or `spawn` can't hold a handle from outside it\n        if contains(i.captured, x) && check.holds_task(check.res(i, t)) {\n          check.error(mut i, \"a closure or `spawn` can't hold `\"\n            + x\n            + \"`, a task's handle: await it where it was spawned\")\n        }\n        check.var_type(i, x, t)\n      },\n      None => match get(i.fns, x) {\n        // a function's type parameters: fresh at each use\n        Some(t) => check.inst(t, check.fresh_for(\n          mut i,\n          to_list(check.gens(t, Set[String] {})),\n        )),\n        None => check.trait_fn(mut i, x),\n      },\n    },\n    ast.Interp(parts) => {\n      for p in parts {\n        match p {\n          ast.ValuePart { value, spec } => {\n            t := check.listed_arg(\n              mut i,\n              \"$interp\",\n              0,\n              value,\n              check.TList(check.TAny),\n              check.infer(mut i, value, env, None),\n              \"interpolation\",\n            )\n            match spec {\n              Some(f) => check.check_spec(mut i, f, t),\n              None => (),\n            }\n          },\n          ast.TextPart(_) => (),\n        }\n      }\n      check.TStr\n    },\n    ast.Binary { op, left, right } => check.binary(mut i, op, left, right, env, expected),\n    // a negative literal of a sized type (`-2^63`, beyond 64 bits once negated)\n    ast.Unary { op, operand } => if op == ast.Neg\n      && check.is_int_lit(operand)\n      && check.sized_expected(i, expected) is Some {\n      _ := check.infer(mut i, operand, env, None)\n      check.int_literal(mut i, e, expected)\n    } else {\n      t := check.infer(mut i, operand, env, None)\n      if op == ast.Neg && !check.is_int_lit(operand) {\n        mut i.arith.push((\"-\", t))\n      }\n      match op {\n        ast.Neg => {\n          match check.res(i, t) {\n            check.TInt | check.TFloat | check.TAny => (),\n            check.TNamed { name, args } => if !(len(args) == 0 && check.is_sized(name)) {\n              check.error(\n                mut i,\n                \"operand of `-` must be Int or Float, found `\"\n                  + (check.shown(check.res(i, t)) ?? name)\n                  + \"`\",\n              )\n            },\n            check.TVar(_) => check.expect(mut i, check.TInt, t, \"operand of `-`\"),\n            other => match check.shown(other) {\n              Some(s) => check.error(\n                mut i,\n                \"operand of `-` must be Int or Float, found `\"\n                  + s\n                  + \"`\",\n              ),\n              None => (),\n            },\n          }\n          t\n        },\n        ast.Not => {\n          check.expect(mut i, check.TBool, t, \"operand of `!`\")\n          check.TBool\n        },\n      }\n    },\n    ast.IfExpr { cond, then, otherwise } => check.infer_if(mut i, cond, then, otherwise, env, expected),\n    ast.Block { stmts, last } => check.infer_block(mut i, stmts, last, env, expected),\n    ast.Call { callee, args } => check.infer_call(mut i, callee, args, env),\n    ast.ListExpr(es) => check.infer_list(mut i, es, env, expected),\n    ast.MatchExpr { scrutinee, binding, arms } => check.infer_match(\n      mut i,\n      scrutinee,\n      binding,\n      arms,\n      env,\n      expected,\n    ),\n    ast.Lambda { params, body } => check.infer_lambda(mut i, params, body, env, expected),\n    ast.Return(x) => {\n      r := i.ret\n      if check.outside_fn(check.res(i, r)) {\n        check.error(mut i, \"`return` outside a function\")\n        _ := check.infer(mut i, x, env, None)\n      } else {\n        t := check.infer(mut i, x, env, Some(r))\n        check.expect(mut i, r, t, \"`return` value\")\n      }\n      check.TAny\n    },\n    ast.IsExpr { value, .. } => {\n      _ := check.infer(mut i, value, env, None)\n      check.TBool\n    },\n    ast.TupleExpr(es) => {\n      // each element with the expected tuple's element as its hint\n      hints := match expected {\n        Some(e) => match check.res(i, e) {\n          check.TNamed { name, args } => if name == \"Tuple\" && len(args) == len(es) {\n            args\n          } else {\n            []\n          },\n          _ => [],\n        },\n        None => [],\n      }\n      mut ts := []\n      for (k, x) in enumerate(es) {\n        mut ts.push(check.infer(mut i, x, env, get(hints, k)))\n      }\n      check.TNamed { name: \"Tuple\", args: ts }\n    },\n    ast.CtorExpr { name, args } => match get(i.types.ctors, name) {\n      Some(sh) => check.infer_ctor(mut i, name, sh, args, env, expected),\n      None => {\n        match args {\n          ast.PositionalArgs(es) => check.infer_all(mut i, es, env),\n          ast.RecordArgs(fs) => check.infer_all(mut i, fs.map(f -> f.1), env),\n          ast.UpdateArgs { base, fields } => check.infer_all(mut i, [base] + fields.map(f -> f.1), env),\n          ast.NoArgs => (),\n        }\n        check.TAny\n      },\n    },\n    ast.MethodCall { recv, name, args } => check.infer_method(mut i, recv, name, args, env, false),\n    ast.FieldOf { base, name: tagged } => {\n      // a tagged read, `sku#0.1`: its receiver's type is kept for `rename`\n      (name, tag) := match check.untag(tagged) {\n        Some(nk) => nk,\n        None => (tagged, \"\"),\n      }\n      seq := i.call_seq\n      bt := check.infer(mut i, base, env, None)\n      if tag != \"\" {\n        mut i.insts.insert(tag + \":field\", bt)\n      }\n      // a call whose function speaks of its variant under a condition only\n      // `verify` decides: the field of the variants left that have it, which\n      // `verify` proves the result is one of (else it faults when it runs)\n      match (i.last_call, check.sum_variants(i, bt)) {\n        ((ls, _, vs, true), Some((_, targs, _))) => if ls == seq\n          && (base is ast.Call || base is ast.MethodCall)\n          && len(check.with_field(i, vs, name)) > 0 {\n          return check.variants_field(\n            mut i,\n            check.with_field(i, vs, name),\n            targs,\n            name,\n            check.shown(check.widened(check.res(i, bt))) ?? \"?\",\n          )\n        },\n        _ => (),\n      }\n      match check.res(i, bt) {\n        // a field of a value that has none\n        check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => {\n          match check.shown(check.res(i, bt)) {\n            Some(x) => check.error(\n              mut i,\n              \"cannot access field `\" + name + \"` on `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          check.TAny\n        },\n        // `p.1`: a tuple's element\n        check.TNamed { name: \"Tuple\", args: targs } => match parse_int(name) {\n          Some(k) => match get(targs, k) {\n            Some(t) => check.place(i, t),\n            None => {\n              match check.shown(check.res(i, bt)) {\n                Some(x) => check.error(\n                  mut i,\n                  \"tuple `\" + x + \"` has no element \" + name,\n                ),\n                None => (),\n              }\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a field of the one variant a value is narrowed to\n        check.TVariants { names: [v], args: targs, .. } => match get(i.types.ctors, v) {\n          Some(sh) => match check.field_of(sh, name) {\n            Some(ft) => check.place(\n              i,\n              check.inst(ft, check.pairs(sh.params, targs)),\n            ),\n            None => {\n              check.error(\n                mut i,\n                \"variant `\" + v + \"` has no field `\" + name + \"`\",\n              )\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a field every variant a value is narrowed to has\n        check.TVariants { names, args: targs, .. } => check.variants_field(\n          mut i,\n          names,\n          targs,\n          name,\n          check.shown(check.res(i, bt)) ?? \"?\",\n        ),\n        // a field every member of a union has, with the same type\n        check.TUnion(ms) => {\n          mut out: Option[check.Ty] = None\n          for m in ms {\n            ft := match m {\n              check.TNamed { name: mn, .. } => match get(i.types.ctors, mn) {\n                Some(sh) => check.field_of(sh, name),\n                None => None,\n              },\n              _ => None,\n            }\n            match ft {\n              Some(x) => {\n                out = Some(x)\n              },\n              None => {\n                mt := check.shown(m) ?? \"?\"\n                ut := check.shown(check.res(i, bt)) ?? \"?\"\n                check.error(\n                  mut i,\n                  f\"`{mt}` has no field `{name}`, so not every `{ut}` does (match on it first)\",\n                )\n                return check.TAny\n              },\n            }\n          }\n          match out {\n            Some(x) => check.place(i, x),\n            None => check.TAny,\n          }\n        },\n        // a type parameter's field, by its structural bound\n        check.TGen(p) => match get(i.trows, p) {\n          Some(fs) => match fs.filter(x -> x.0 == name) {\n            [x, ..] => check.place(i, x.1),\n            _ => {\n              check.error(\n                mut i,\n                f\"`{check.row_text(fs)}` has no field `{name}` (a value of a structural type has only the fields it names)\",\n              )\n              check.TAny\n            },\n          },\n          None => check.TAny,\n        },\n        // a sum's field: one every variant has\n        check.TNamed { name: n, args: targs } => if contains(i.types.sums, n) && !contains(i.types.ctors, n) {\n          check.variants_field(\n            mut i,\n            get(i.types.variants, n) ?? [],\n            targs,\n            name,\n            check.shown(check.res(i, bt)) ?? n,\n          )\n        } else {\n          match get(i.types.ctors, n) {\n            // a record type; a sum's name is not a constructor\n            Some(sh) => match check.field_of(sh, name) {\n              Some(ft) => {\n                mut m := Dict[String, check.Ty] {}\n                for (k, p) in enumerate(sh.params) {\n                  mut m.insert(p, get(targs, k) ?? check.TAny)\n                }\n                check.place(i, check.inst(ft, m))\n              },\n              None => {\n                check.error(mut i, \"type `\"\n                  + n\n                  + \"` has no field `\"\n                  + name\n                  + \"` (match on variants to access their fields)\")\n                check.TAny\n              },\n            },\n            None => check.TAny,\n          }\n        },\n        _ => check.TAny,\n      }\n    },\n    // `mut q.claim(2)`: a call that changes its receiver\n    ast.MutExpr(ast.MethodCall { recv, name, args }) => match check.untag(name) {\n      // a tagged call: its receiver's type is kept, as `infer` keeps it. A call\n      // spreading records, tagged by `spread_bound`, is written out.\n      Some(nk) => if starts_with(nk.1, \"s\") {\n        check.infer_spread(mut i, e, nk.1, env, expected)\n      } else {\n        rt := check.infer(mut i, recv, env, None)\n        mut i.insts.insert(nk.1 + \":recv\", rt)\n        t := check.infer_method(mut i, recv, nk.0, args, env, true)\n        mut i.insts.insert(nk.1, t)\n        t\n      },\n      None => check.infer_method(mut i, recv, name, args, env, true),\n    },\n    ast.MutExpr(x) => check.infer(mut i, x, env, expected),\n    // `r!`, `o?`: the value a `Result` or an `Option` holds\n    ast.Try { value, kind } => {\n      vt := check.infer(mut i, value, env, None)\n      want := if kind == ast.TryResult {\n        \"Result\"\n      } else {\n        \"Option\"\n      }\n      match check.res(i, vt) {\n        check.TNamed { name, args } => if name == want {\n          check.early_error(mut i, kind, if kind == ast.TryResult {\n            get(args, 1) ?? check.TAny\n          } else {\n            check.TAny\n          })\n          get(args, 0) ?? check.TAny\n        } else {\n          check.wrong_try(mut i, kind, check.res(i, vt))\n        },\n        check.TAny | check.TVar(_) => check.TAny,\n        other => check.wrong_try(mut i, kind, other),\n      }\n    },\n    // `r except e { fallback }`: the value, or the fallback (of the same\n    // type) with `e` the error\n    ast.Except { value, err, fallback } => {\n      vt := check.infer(mut i, value, env, None)\n      (ok, bad) := match check.res(i, vt) {\n        check.TNamed { name, args } => if name == \"Result\" && len(args) == 2 {\n          (get(args, 0) ?? check.TAny, get(args, 1) ?? check.TAny)\n        } else if name == \"Option\" {\n          check.error(\n            mut i,\n            \"`except` / `!!` handle a Result; an Option is handled with `or { … }` / `??`\",\n          )\n          (check.fresh(mut i), check.TAny)\n        } else {\n          check.not_result(mut i, check.res(i, vt))\n        },\n        check.TAny | check.TVar(_) => (check.TAny, check.TAny),\n        other => check.not_result(mut i, other),\n      }\n      inner := match err {\n        Some(n) => {\n          mut copy := env\n          mut copy.insert(n, bad)\n          copy\n        },\n        None => env,\n      }\n      ft := check.infer(mut i, fallback, inner, Some(ok))\n      check.expect(mut i, ok, ft, \"`except` fallback\")\n      ok\n    },\n    ast.Fallback { value, fallback } => {\n      vt := check.infer(mut i, value, env, None)\n      inner := match check.res(i, vt) {\n        check.TNamed { name, args } => if name == \"Option\" && len(args) == 1 {\n          get(args, 0) ?? check.TAny\n        } else if name == \"Result\" && len(args) == 2 {\n          check.error(\n            mut i,\n            \"`or` / `??` handle an Option; a Result is handled with `except { … }` / `!!`\",\n          )\n          get(args, 0) ?? check.TAny\n        } else {\n          match check.shown(check.res(i, vt)) {\n            Some(x) => check.error(\n              mut i,\n              \"`or` / `??` handle an Option, found `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          check.fresh(mut i)\n        },\n        check.TAny => check.TAny,\n        other => {\n          match check.shown(other) {\n            Some(x) => check.error(\n              mut i,\n              \"`or` / `??` handle an Option, found `\" + x + \"`\",\n            ),\n            None => (),\n          }\n          // the fallback's type, so checking goes on\n          check.fresh(mut i)\n        },\n      }\n      ft := check.infer(mut i, fallback, env, Some(inner))\n      check.expect(mut i, inner, ft, \"`or` fallback\")\n      inner\n    },\n    ast.Index { base, index } => {\n      bt := check.infer(mut i, base, env, None)\n      match index {\n        // `xs[a..b]`: a slice, of the same type\n        ast.Range { lo, hi, .. } => {\n          for x in [lo, hi] {\n            match x {\n              Some(v) => check.infer(mut i, v, env, Some(check.TInt)),\n              None => check.TAny,\n            }\n          }\n          match check.res(i, bt) {\n            check.TList(_) => bt,\n            _ => check.TAny,\n          }\n        },\n        // `xs[k]`: the built-in `at(xs, k)`\n        _ => match check.res(i, bt) {\n          check.TList(_) => match get(i.builtins, \"at\") {\n            Some(bs) => check.builtin_call(mut i, \"at\", bs, [bt], [index], env),\n            None => {\n              _ := check.infer(mut i, index, env, None)\n              check.TAny\n            },\n          },\n          _ => {\n            _ := check.infer(mut i, index, env, None)\n            check.TAny\n          },\n        },\n      }\n    },\n    // `a..b`: the list of the integers from `a`\n    ast.Range { lo, hi, .. } => {\n      for x in [lo, hi] {\n        match x {\n          Some(v) => check.infer(mut i, v, env, Some(check.TInt)),\n          None => check.TAny,\n        }\n      }\n      check.TList(check.TInt)\n    },\n    ast.Comp { kind, elem, fors } => {\n      mut seen := env\n      // over an iterator, one of the program's types or core's, a comprehension\n      // is lazy: an iterator instead of a list\n      mut lazy := false\n      for f in fors {\n        it := check.infer(mut i, f.iter, seen, None)\n        match check.res(i, it) {\n          check.TNamed { name, .. } => if contains(i.methods.impls, \"Iterator for \" + name)\n            || contains(i.methods.impls, \"FiniteIterator for \" + name) {\n            lazy = true\n          },\n          _ => (),\n        }\n        seen = check.bind_typed(\n          mut i,\n          seen,\n          f.pat,\n          check.element_of(i, it),\n        )\n        match f.cond {\n          Some(c) => check.infer(mut i, c, seen, None),\n          None => (),\n        }\n      }\n      et := check.infer(mut i, elem, seen, None)\n      // a list comprehension is a list of its element's type\n      if kind == ast.ListComp && !lazy {\n        check.TList(et)\n      } else {\n        check.TAny\n      }\n    },\n    ast.DictExpr { entries, .. } => {\n      for kv in entries {\n        check.infer_all(mut i, [kv.0, kv.1], env)\n      }\n      check.TAny\n    },\n    ast.SetExpr { elems, .. } => {\n      check.infer_all(mut i, elems, env)\n      check.TAny\n    },\n    ast.Comptime(x) => {\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    // `old e`: `e`'s value where the function started, of `e`'s type\n    ast.Old(x) => check.infer(mut i, x, env, expected),\n    // `...x` where `spread_bound` found no call by name to fill\n    ast.Spread(x) => {\n      check.spread_error(\n        mut i,\n        \"`...\"\n          + text.expr_text(x, 0)\n          + \"`: a spread gives a record's fields to the parameters of a function or method called by name; it can't be used here\",\n      )\n      _ := check.infer(mut i, x, env, None)\n      check.TAny\n    },\n    ast.Assumed(x) => check.infer(mut i, x, env, expected),\n    // a `scope`'s result can't hold one of its tasks' handles\n    ast.Scope(x) => {\n      held := i.outside\n      i.outside = Some(set(keys(env)))\n      // `scope { …; spawn e }`: the last task's handle isn't its value\n      t := if check.ends_in_spawn(x) {\n        _ := check.infer(mut i, x, env, None)\n        check.TUnit\n      } else {\n        check.infer(mut i, x, env, expected)\n      }\n      i.outside = held\n      if check.holds_task(check.res(i, t)) {\n        match check.shown(check.res(i, t)) {\n          Some(s) => check.error(\n            mut i,\n            \"a task's handle can't leave its `scope` (its result is `\"\n              + s\n              + \"`): await it inside\",\n          ),\n          None => (),\n        }\n      }\n      t\n    },\n    // `spawn e`: a handle to `e`'s value\n    ast.Spawn(x) => {\n      outer := i.ret\n      i.ret = check.TAny\n      held := i.captured\n      i.captured = set(keys(env))\n      t := check.infer(mut i, x, env, None)\n      i.captured = held\n      i.ret = outer\n      // a sender is captured on its own, never inside another value\n      for v in keys(env).sorted() {\n        vt := check.res(i, get(env, v) ?? check.TAny)\n        if !(vt is check.TNamed && check.type_name(vt) == \"Sender\")\n          && check.holds_sender(i, vt, 8)\n          && check.uses(x, v)\n          && !check.rebinds(x, v) {\n          check.error(\n            mut i,\n            \"a task (a `spawn`, a `race` arm) can capture a sender only on its own (a variable holding it): `\"\n              + v\n              + \"` holds one inside\",\n          )\n        }\n      }\n      check.TNamed { name: \"Task\", args: [t] }\n    },\n    // `select`: each arm's operation (`rx.recv()` an `Option`, `tx.send(v)`,\n    // `await h`, `clock.after(d)` with `clock` a clock and `d` a `Duration`),\n    // its name, and its body with the type wanted\n    ast.Select(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.MethodCall { recv, name, args } => if name == \"after\" && len(args) == 1 {\n            ct := check.res(i, check.infer(mut i, recv, env, None))\n            match ct {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(ct) {\n                Some(x) => check.error(\n                  mut i,\n                  \"an `after` arm waits on a clock: `\"\n                    + x\n                    + \"` doesn't implement `Clock` (std.time)\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            dt := check.res(i, check.infer(\n              mut i,\n              get(args, 0) ?? ast.UnitExpr,\n              env,\n              None,\n            ))\n            match dt {\n              check.TInt | check.TFloat | check.TBool | check.TStr | check.TUnit => match check.shown(dt) {\n                Some(x) => check.error(\n                  mut i,\n                  \"the time an `after` arm waits: expected `std.time.Duration`, found `\"\n                    + x\n                    + \"`\",\n                ),\n                None => (),\n              },\n              _ => (),\n            }\n            check.TUnit\n          } else {\n            check.infer(mut i, a.op, env, None)\n          },\n          _ => check.infer(mut i, a.op, env, None),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `race`: each left side is a task's body (a supervised one's result is a\n    // `Result[T, Panic]`), then its name and its body\n    ast.Race(arms) => {\n      for a in arms {\n        got := match a.op {\n          ast.SupervisedSpawn(x) => check.TNamed { name: \"Result\", args: [\n            check.task_body(mut i, x, env),\n            check.TNamed { name: \"Panic\", args: [] },\n          ] },\n          op => check.task_body(mut i, op, env),\n        }\n        inner := match a.name {\n          Some(n) => {\n            mut copy := env\n            mut copy.insert(n, got)\n            copy\n          },\n          None => env,\n        }\n        check.infer(mut i, a.body, inner, expected)\n      }\n      expected ?? check.TAny\n    },\n    // `supervised spawn e`: a handle to `e`'s value, or its panic\n    ast.SupervisedSpawn(x) => check.TNamed {\n      name: \"Task\",\n      args: [check.TNamed { name: \"Result\", args: [\n        check.task_body(mut i, x, env),\n        check.TNamed { name: \"Panic\", args: [] },\n      ] }],\n    },\n    // `await h`: the task's value, or each task's for a tuple or list of handles\n    ast.Await(x) => {\n      t := check.infer(mut i, x, env, None)\n      check.awaited(mut i, check.res(i, t))\n    },\n    ast.Hole(h) => {\n      t := expected ?? check.fresh(mut i)\n      mut i.holes.push((h, t, env))\n      t\n    },\n    _ => check.TAny,\n  }\n}"},{"name":"check.spread_body","kind":"fn","old":"40e92972de3d860f","new":"d54c2edba186088a","interface_changed":false,"affected":[],"module":"check","text":"/// `f`'s body with its calls spreading records written out, and their\n/// errors, each value spread named as written.\nfn spread_body(\n  f: ast.FnDecl,\n  tps: Set[String],\n  types: check.Types,\n  fns: Dict[String, check.Ty],\n  methods: check.Methods,\n  builtins: Dict[String, List[check.Builtin]],\n) -> (ast.Expr, List[String]) {\n  bound := check.spread_bound(f.body, \"0\")\n  i := check.fn_inferred(\n    ast.FnDecl { ..f, body: bound },\n    tps,\n    types,\n    fns,\n    methods,\n    builtins,\n  )\n  // the longest name first: `$spread0_1x10` before `$spread0_1x1`\n  names := check.spread_names(bound).sorted_by(n -> 0 - byte_len(n.0))\n  mut errs := i.spread_errs\n  // a call the inference didn't reach, as it stopped at an error around it\n  for (k, code) in check.spread_tags(bound) {\n    if get(i.spreads, k) is None {\n      mut errs.push(\n        \"`\" + code + \"`: its spread (`...`) couldn't be checked\",\n      )\n    }\n  }\n  body := check.updates_named(i, check.spread_calls(i, bound))\n  (\n    body,\n    errs.map(m -> names.fold(m, (acc, n) -> replace(acc, n.0, n.1))),\n  )\n}","old_text":"/// `f`'s body with its calls spreading records written out, and their\n/// errors, each value spread named as written.\nfn spread_body(\n  f: ast.FnDecl,\n  tps: Set[String],\n  types: check.Types,\n  fns: Dict[String, check.Ty],\n  methods: check.Methods,\n  builtins: Dict[String, List[check.Builtin]],\n) -> (ast.Expr, List[String]) {\n  bound := check.spread_bound(f.body, \"0\")\n  i := check.fn_inferred(\n    ast.FnDecl { ..f, body: bound },\n    tps,\n    types,\n    fns,\n    methods,\n    builtins,\n  )\n  // the longest name first: `$spread0_1x10` before `$spread0_1x1`\n  names := check.spread_names(bound).sorted_by(n -> 0 - byte_len(n.0))\n  mut errs := i.spread_errs\n  // a call the inference didn't reach, as it stopped at an error around it\n  for (k, code) in check.spread_tags(bound) {\n    if get(i.spreads, k) is None {\n      mut errs.push(\n        \"`\" + code + \"`: its spread (`...`) couldn't be checked\",\n      )\n    }\n  }\n  body := check.spread_calls(i, bound)\n  (\n    body,\n    errs.map(m -> names.fold(m, (acc, n) -> replace(acc, n.0, n.1))),\n  )\n}"},{"name":"check.spread_bound","kind":"fn","old":"281e32c29ff6f002","new":"69468c60a19e10c1","interface_changed":false,"affected":[],"module":"check","text":"/// `e` with each call that spreads a record (`f(...x)`, `r.m(...x)`) tagged\n/// with its position (`f#s0_2`). Each value spread and each receiver that\n/// isn't a variable or a field of one is first bound to a variable of its\n/// own, in order, so it is computed once:\n/// `{ $spread0_2x0 := make(); f(...$spread0_2x0) }`.\nfn spread_bound(e: ast.Expr, path: String) -> ast.Expr {\n  rebuilt := walk.expr_children_at(\n    e,\n    (k, c) -> check.spread_bound(c, path + \"_\" + to_string(k)),\n  )\n  match rebuilt {\n    // a nameless update, tagged: its type is its base's\n    ast.CtorExpr { name: \"\", args } => ast.CtorExpr { name: \"$upd:\" + path, args },\n    ast.Call { callee: ast.Var(x), args } => if args.any(a -> a is ast.Spread) {\n      (lets, xs) := check.spread_values(args, path)\n      check.spread_lets(\n        lets,\n        ast.Call { callee: ast.Var(x + \"#s\" + path), args: xs },\n      )\n    } else {\n      rebuilt\n    },\n    ast.MethodCall { recv, name, args } => if args.any(a -> a is ast.Spread) {\n      (lets, xs) := check.spread_values(args, path)\n      // a type's name (`Pt.new(...x)`) or a place stays as it is\n      (rl, r) := if check.spread_path(recv) || recv is ast.CtorExpr {\n        ([], recv)\n      } else {\n        n := \"$spread\" + path + \"r\"\n        (\n          [ast.Let { pat: ast.Bind(n), ty: None, value: recv }],\n          ast.Var(n),\n        )\n      }\n      check.spread_lets(\n        rl + lets,\n        ast.MethodCall {\n          recv: r,\n          name: name + \"#s\" + path,\n          args: xs,\n        },\n      )\n    } else {\n      rebuilt\n    },\n    // `mut r.m(...x)`: the values bound around the marked call\n    ast.MutExpr(ast.Block { stmts, last: ast.MethodCall { recv, name, args } }) => if contains(name, \"#s\") {\n      ast.Block {\n        stmts,\n        last: ast.MutExpr(ast.MethodCall { recv, name, args }),\n      }\n    } else {\n      rebuilt\n    },\n    _ => rebuilt,\n  }\n}","old_text":"/// `e` with each call that spreads a record (`f(...x)`, `r.m(...x)`) tagged\n/// with its position (`f#s0_2`). Each value spread and each receiver that\n/// isn't a variable or a field of one is first bound to a variable of its\n/// own, in order, so it is computed once:\n/// `{ $spread0_2x0 := make(); f(...$spread0_2x0) }`.\nfn spread_bound(e: ast.Expr, path: String) -> ast.Expr {\n  rebuilt := walk.expr_children_at(\n    e,\n    (k, c) -> check.spread_bound(c, path + \"_\" + to_string(k)),\n  )\n  match rebuilt {\n    ast.Call { callee: ast.Var(x), args } => if args.any(a -> a is ast.Spread) {\n      (lets, xs) := check.spread_values(args, path)\n      check.spread_lets(\n        lets,\n        ast.Call { callee: ast.Var(x + \"#s\" + path), args: xs },\n      )\n    } else {\n      rebuilt\n    },\n    ast.MethodCall { recv, name, args } => if args.any(a -> a is ast.Spread) {\n      (lets, xs) := check.spread_values(args, path)\n      // a type's name (`Pt.new(...x)`) or a place stays as it is\n      (rl, r) := if check.spread_path(recv) || recv is ast.CtorExpr {\n        ([], recv)\n      } else {\n        n := \"$spread\" + path + \"r\"\n        (\n          [ast.Let { pat: ast.Bind(n), ty: None, value: recv }],\n          ast.Var(n),\n        )\n      }\n      check.spread_lets(\n        rl + lets,\n        ast.MethodCall {\n          recv: r,\n          name: name + \"#s\" + path,\n          args: xs,\n        },\n      )\n    } else {\n      rebuilt\n    },\n    // `mut r.m(...x)`: the values bound around the marked call\n    ast.MutExpr(ast.Block { stmts, last: ast.MethodCall { recv, name, args } }) => if contains(name, \"#s\") {\n      ast.Block {\n        stmts,\n        last: ast.MutExpr(ast.MethodCall { recv, name, args }),\n      }\n    } else {\n      rebuilt\n    },\n    _ => rebuilt,\n  }\n}"},{"name":"check.spread_in","kind":"fn","old":"0e80d4fa7ce39e4e","new":"20a5aa141b63302e","interface_changed":false,"affected":[],"module":"check","text":"/// `e` spreads a record (`...x`), or updates one without naming its type\n/// (`{ ..x, f: v }`), at any depth.\nfn spread_in(e: ast.Expr) -> Bool {\n  e is ast.Spread\n    || e is ast.CtorExpr && check.ctor_name(e) == \"\"\n    || walk.kids(e).any(x -> check.spread_in(x))\n}","old_text":"/// `e` spreads a record (`...x`) at any depth.\nfn spread_in(e: ast.Expr) -> Bool {\n  e is ast.Spread || walk.kids(e).any(x -> check.spread_in(x))\n}"},{"name":"checked.keys_of","kind":"fn","old":"00fc3da1346a5feb","new":"d227cfe9ecd05573","interface_changed":false,"affected":[],"module":"checked","text":"/// Each definition's key in the modules `files` (each its name and its\n/// header's rows, `rows_of`), by qualified name. The key hashes `global`\n/// (what\n/// every definition relies on: the compiler, std, core, the package's\n/// settings), the definition's own code, its module's names and imports\n/// (what its names resolve to), and the interfaces of everything it\n/// reaches through the dependencies the headers list. A body change keeps\n/// every other definition's key; an interface change changes the keys of\n/// all that reach it.\n/// \n/// What check runs and not only reads counts by its code: what a type or a\n/// trait reaches (a refinement's predicate runs at compile time, a default\n/// method is checked in each implementation), and the `comptime fn`s in\n/// `runs` with all they reach. Every implementation's and trait's interface\n/// is in each key too: a method call names no definition in the headers.\n/// Cost: one pass over the rows and one over the dependency graph\n/// (its strongly connected components, each hashed once).\npub fn keys_of(\n  files: List[(String, List[checked.Row])],\n  global: String,\n  runs: Set[String],\n) -> checked.Graph {\n  mut entries := Dict[String, checked.Row] {}\n  mut modules := Dict[String, List[String]] {}\n  mut module_of := Dict[String, String] {}\n  for (m, rows) in files {\n    mut names := []\n    for e in rows {\n      q := store.qualify(m, e.name)\n      mut entries.insert(q, e)\n      mut module_of.insert(q, m)\n      mut names.push(\n        if e.kind == \"use\" {\n          e.name + \"=\" + e.code\n        } else {\n          e.name\n        },\n      )\n    }\n    mut modules.insert(m, names.sorted())\n  }\n  // (the dependencies among these definitions only)\n  mut deps := Dict[String, List[String]] {}\n  for (q, e) in items(entries) {\n    mut deps.insert(\n      q,\n      e.deps.filter(x -> contains(entries, x) && x != q),\n    )\n  }\n  // what runs: reached from a type's or trait's dependencies, or from a\n  // `comptime fn`\n  mut seeds := []\n  for (q, e) in items(entries) {\n    if e.kind == \"type\" || e.kind == \"trait\" {\n      seeds += get(deps, q) ?? []\n    }\n    if contains(runs, q) {\n      mut seeds.push(q)\n    }\n  }\n  run := checked.reached(deps, seeds)\n  mut parts := Dict[String, String] {}\n  mut methods := []\n  for (q, e) in items(entries) {\n    mut parts.insert(\n      q,\n      q\n        + \"=\"\n        + if e.kind == \"fn\" && !contains(run, q) {\n          \"interface \" + e.interface\n        } else {\n          e.code\n        },\n    )\n    if e.kind == \"impl\" || e.kind == \"trait\" {\n      mut methods.push(q + \"=\" + e.interface)\n    }\n  }\n  every := cache.content_key([global] + methods.sorted())\n  mut module_keys := Dict[String, String] {}\n  for (m, names) in items(modules) {\n    mut module_keys.insert(\n      m,\n      cache.content_key([\"module \" + m] + names),\n    )\n  }\n  reach := checked.closures(parts, deps)\n  mut out := Dict[String, String] {}\n  for (q, e) in items(entries) {\n    mut out.insert(\n      q,\n      cache.content_key([\n        every,\n        get(module_keys, get(module_of, q) ?? \"\") ?? \"\",\n        q + \"=\" + e.code,\n        get(reach, q) ?? \"\",\n      ]),\n    )\n  }\n  checked.Graph { keys: out, deps }\n}","old_text":"/// Each definition's key in the modules `files` (each its name and its\n/// header's rows, `rows_of`), by qualified name. The key hashes `global`\n/// (what\n/// every definition relies on: the compiler, std, core, the package's\n/// settings), the definition's own code, its module's names and imports\n/// (what its names resolve to), and the interfaces of everything it\n/// reaches through the dependencies the headers list. A body change keeps\n/// every other definition's key; an interface change changes the keys of\n/// all that reach it.\n/// \n/// What check runs and not only reads counts by its code: what a type or a\n/// trait reaches (a refinement's predicate runs at compile time, a default\n/// method is checked in each implementation), and the `comptime fn`s in\n/// `runs` with all they reach. Every implementation's and trait's interface\n/// is in each key too: a method call names no definition in the headers.\n/// Cost: one pass over the rows and one over the dependency graph\n/// (its strongly connected components, each hashed once).\npub fn keys_of(\n  files: List[(String, List[checked.Row])],\n  global: String,\n  runs: Set[String],\n) -> checked.Graph {\n  mut entries := Dict[String, checked.Row] {}\n  mut modules := Dict[String, List[String]] {}\n  mut module_of := Dict[String, String] {}\n  for (m, rows) in files {\n    mut names := []\n    for e in rows {\n      q := store.qualify(m, e.name)\n      mut entries.insert(q, e)\n      mut module_of.insert(q, m)\n      mut names.push(\n        if e.kind == \"use\" {\n          e.name + \"=\" + e.code\n        } else {\n          e.name\n        },\n      )\n    }\n    mut modules.insert(m, names.sorted())\n  }\n  // (the dependencies among these definitions only)\n  mut deps := Dict[String, List[String]] {}\n  for (q, e) in items(entries) {\n    mut deps.insert(\n      q,\n      e.deps.filter(x -> contains(entries, x) && x != q),\n    )\n  }\n  // what runs: reached from a type's or trait's dependencies, or from a\n  // `comptime fn`\n  mut seeds := []\n  for (q, e) in items(entries) {\n    if e.kind == \"type\" || e.kind == \"trait\" {\n      seeds += get(deps, q) ?? []\n    }\n    if contains(runs, q) {\n      mut seeds.push(q)\n    }\n  }\n  run := checked.reached(deps, seeds)\n  mut parts := Dict[String, String] {}\n  mut methods := []\n  for (q, e) in items(entries) {\n    mut parts.insert(\n      q,\n      q\n        + \"=\"\n        + if e.kind == \"fn\" && !contains(run, q) {\n          \"interface \" + e.interface\n        } else {\n          e.code\n        },\n    )\n    if e.kind == \"impl\" || e.kind == \"trait\" {\n      mut methods.push(q + \"=\" + e.interface)\n    }\n  }\n  every := cache.content_key([global] + methods.sorted())\n  mut module_keys := Dict[String, String] {}\n  for (m, names) in items(modules) {\n    mut module_keys.insert(\n      m,\n      cache.content_key([\"module \" + m] + names),\n    )\n  }\n  reach := checked.closures(parts, deps)\n  mut out := Dict[String, String] {}\n  for (q, e) in items(entries) {\n    mut out.insert(\n      q,\n      cache.content_key([\n        every,\n        get(module_keys, get(module_of, q) ?? \"\") ?? \"\",\n        q + \"=\" + e.code,\n        get(reach, q) ?? \"\",\n      ]),\n    )\n  }\n  checked.Graph { keys: out, deps }\n}"},{"name":"codegen.construct_want","kind":"fn","old":"8d942bfb9ee5226d","new":"6799d76d3d2ce5e8","interface_changed":true,"affected":["codegen.construct","codegen.expr_want_node","codegen.main_arg","codegen.expr_node","codegen.session_capability","codegen.expr_want","codegen.entry","codegen.expr","codegen.session_entry","codegen.function","codegen.binary","codegen.declare","codegen.destructure","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.method_call","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.operands_want","codegen.wanted","codegen.try_want","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.compared","codegen.stmt_node","codegen.build_fn","codegen.push_in_place","codegen.generate","codegen.call_named","codegen.interp","codegen.logic","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.await_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.decreases_pass","codegen.decreases_call","codegen.keep_olds","codegen.export_entry","codegen.expr_on_stack","codegen.assigned_call","codegen.compiled_alone","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.by_variant","codegen.list_literal","codegen.operands","codegen.mock_call","codegen.try_expr","codegen.function_value","codegen.lambda","codegen.stmt","codegen.built_or_generated","codegen_with","core_rt_text","computed_value","repl_eval","codegen.binds","codegen.matching_v","codegen.assertion","codegen.invariants","codegen.tag_is","codegen.check_type","codegen.satisfies","codegen.holds_pred","codegen.vtable","codegen.mock_table","codegen.list_builtin","codegen.collection_builtin","codegen.produce","codegen.table_find","codegen.if_expr","codegen.matching","codegen.get_field","codegen.show","codegen.shown","codegen.builtin","codegen.string_builtin","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.spawn_expr","codegen.method_value","codegen.iterate","codegen.decreases_start","codegen.decreases_entry","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen.to_c","codegen.check_payload","codegen.dyn_ctor_is","codegen.has_field_check","codegen.check_field","codegen.assign_at","codegen.gen_data","codegen.check_union","codegen.check_member","codegen.to_dyn","codegen.dyn_table_is","codegen.mock_value","codegen.gen_list","codegen.gen_fn","codegen.format_spec","codegen.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","codegen_file","jit_file","fuzz_file","alongside_command","live_edit_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.foreign_call","codegen.generated","codegen.can_generate","codegen.helper","codegen.debug_body","command_line","call_command","edit_file","file_errors","edit_errors","loaded_check","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.generated_args","codegen.makers","codegen.equal","main","edit_command","check_files","apply_change","apply_edit","loaded_errors","package_checked","fix_loops","with_base","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","package_errors","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.read_back","eval_files","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// `construct` with a wanted type.\nfn construct_want(\n  mut g: codegen.Gen,\n  c0: String,\n  args: ast.CtorArgs,\n  want: check.Ty,\n) -> codegen.V {\n  // a type parameter's record (`T { ..x, f: v }` in a function with a\n  // structural bound): the record it stands for in this instance\n  c := match get(g.sub, c0) {\n    Some(check.TNamed { name, .. }) => name,\n    _ => c0,\n  }\n  // on the stack: this constructor only, not those of its fields\n  on_stack := g.stack_next\n  g.stack_next = false\n  // (in result position: on the stack, its words the result)\n  rp := g.result_pos\n  g.result_pos = false\n  sh := match get(g.types.ctors, c) {\n    Some(s) => s,\n    None => {\n      codegen.not_yet(mut g, \"the constructor `\" + c + \"`\")\n      return codegen.never()\n    },\n  }\n  if codegen.refuse_capability(mut g, sh.owner) {\n    return codegen.never()\n  }\n  // each field's value is made as the wanted type says when that holds a\n  // trait value (`Some(mem_files(…))` for an `Option[Files]`), a union, or\n  // a function (lambda parameter types: `Some((a, b) -> …)` for an\n  // `Option[(Int, Int) -> Int]`)\n  wm := match want {\n    check.TNamed { name, args: wa } => if name == sh.owner {\n      check.pairs(sh.params, wa)\n    } else {\n      Dict[String, check.Ty] {}\n    },\n    _ => Dict[String, check.Ty] {},\n  }\n  mut wants := []\n  for f in sh.fields {\n    w := codegen.ground(check.inst(f.1, wm))\n    // a list too: a finite iterator given for one is converted (`converted`)\n    mut wants.push(\n      if codegen.holds_trait(w)\n        || codegen.holds_union(w)\n        || codegen.holds_fn(w)\n        || w is check.TList {\n        w\n      } else {\n        check.TAny\n      },\n    )\n  }\n  vs := match args {\n    ast.NoArgs => if len(sh.fields) == 0 {\n      return codegen.V { ty: check.TNamed {\n        name: sh.owner,\n        args: sh.params.map(_ -> check.TAny),\n      }, op: codegen.nullary(mut g, c) }\n    } else {\n      codegen.not_yet(mut g, \"`\" + c + \"` without its fields\")\n      return codegen.never()\n    },\n    ast.PositionalArgs(es) => codegen.operands_want(mut g, es, wants),\n    ast.RecordArgs(given) => {\n      // in declaration order; a field not given takes its default\n      mut out := []\n      for f in sh.fields {\n        x := match find(given, a -> a.0 == f.0) {\n          Some(a) => a.1,\n          None => match get(g.defaults, c + \".\" + f.0) {\n            Some(d) => d,\n            None => {\n              codegen.not_yet(\n                mut g,\n                \"`\" + c + \"` without its field `\" + f.0 + \"`\",\n              )\n              return codegen.never()\n            },\n          },\n        }\n        w := get(wants, len(out)) ?? check.TAny\n        v := if w is check.TAny {\n          codegen.expr(mut g, x)\n        } else {\n          y := codegen.expr_want(mut g, x, w)\n          if y.ty is check.TAny {\n            y\n          } else {\n            codegen.converted(mut g, y, w)\n          }\n        }\n        if v.ty is check.TAny {\n          return v\n        }\n        mut out.push(v)\n      }\n      Some(out)\n    },\n    ast.UpdateArgs { base, fields } => {\n      b0 := codegen.expr(mut g, base)\n      if b0.ty is check.TAny {\n        return b0\n      }\n      // held when a field's value may assign: `P { ..p, n: { p = q; 2 } }`\n      b := if fields.any(a -> codegen.assigns(a.1)) {\n        codegen.hold(mut g, b0)\n      } else {\n        b0\n      }\n      fs := codegen.fields_of(g, c, b.ty)\n      mut out := []\n      for (k, f) in enumerate(fs) {\n        v := match find(fields, a -> a.0 == f.0) {\n          Some(a) => codegen.expr(mut g, a.1),\n          None => codegen.field(mut g, b, k, f.1),\n        }\n        if v.ty is check.TAny {\n          return v\n        }\n        mut out.push(v)\n      }\n      Some(out)\n    },\n  }\n  match vs {\n    Some(given) => {\n      // each field's value of its declared type (a literal of a sized one)\n      mut xs := []\n      for (k, x) in enumerate(given) {\n        ft := match get(sh.fields, k) {\n          Some(f) => f.1,\n          None => check.TAny,\n        }\n        mut xs.push(codegen.as_type(mut g, x, ft))\n      }\n      // the type's parameters, from the values given\n      mut m := Dict[String, check.Ty] {}\n      for (k, f) in enumerate(sh.fields) {\n        m = codegen.bind_gen(f.1, (get(xs, k) ?? codegen.unit()).ty, m)\n      }\n      t := check.TNamed {\n        name: sh.owner,\n        args: sh.params.map(p -> get(m, p) ?? check.TAny),\n      }\n      ctx := f\"constructing `{codegen.short(c)}`\"\n      if contains(g.distincts, c) {\n        // a `distinct` type: its value, as is, against its refinement\n        match (get(g.refines, c), get(xs, 0)) {\n          (Some((_, pred)), Some(x0)) => if !codegen.proven(mut g, ctx, \"same\") {\n            ok := codegen.with_it(mut g, x0, pred)\n            codegen.fail_unless(\n              mut g,\n              ok,\n              ctx,\n              [],\n              x0,\n              f\"does not satisfy `{codegen.short(c)}` (where {text.expr_text(pred, 0)})\",\n            )\n          },\n          _ => (),\n        }\n      } else {\n        for (k, f) in enumerate(sh.fields) {\n          match codegen.field_written(g, t, c, f.0) {\n            Some(ft) => if codegen.needs_check(g, ft) {\n              fv := get(xs, k) ?? codegen.unit()\n              codegen.check_type(\n                mut g,\n                ft,\n                fv,\n                ctx + \": \" + codegen.short(c) + \".\" + f.0,\n                [],\n              )\n            },\n            None => (),\n          }\n        }\n      }\n      in_rp := codegen.in_result(g, rp, t)\n      stacked := !in_rp\n        && on_stack\n        && (want is check.TAny || want == t)\n        && !codegen.boxed(g, t)\n      p := if in_rp {\n        codegen.result_block(mut g, get(g.tags, c) ?? 0, xs)\n      } else if stacked {\n        g.stack_made = xs.map(x -> x.ty)\n        codegen.stack_block(mut g, get(g.tags, c) ?? 0, xs)\n      } else {\n        codegen.block_of(mut g, get(g.tags, c) ?? 0, xs)\n      }\n      // a result block: of the result's type, its parameters known\n      made := codegen.temp(mut g, codegen.V { ty: if in_rp {\n        codegen.better(t, g.ret)\n      } else {\n        t\n      }, op: p })\n      // a temporary on the stack: its end drops only its fields\n      if stacked {\n        k := len(g.scopes) - 1\n        s := get(g.scopes, k) ?? codegen.no_scope()\n        codegen.set_scope(mut g, k, codegen.Scope { ..s, stacked: {\n          mut copy := s.stacked\n          mut copy.insert(p, xs.map(x -> x.ty))\n          copy\n        } })\n      }\n      if !contains(g.distincts, c) {\n        match get(g.refines, sh.owner) {\n          Some((_, pred)) => if !codegen.proven(mut g, ctx, \"same\") {\n            ok := codegen.with_it(mut g, made, pred)\n            codegen.fail_unless(\n              mut g,\n              ok,\n              ctx,\n              [],\n              made,\n              f\"does not satisfy `{codegen.short(sh.owner)}` (where {text.expr_text(pred, 0)})\",\n            )\n          },\n          None => (),\n        }\n      }\n      made\n    },\n    None => codegen.never(),\n  }\n}","old_text":"/// `construct` with a wanted type.\nfn construct_want(\n  mut g: codegen.Gen,\n  c: String,\n  args: ast.CtorArgs,\n  want: check.Ty,\n) -> codegen.V {\n  // on the stack: this constructor only, not those of its fields\n  on_stack := g.stack_next\n  g.stack_next = false\n  // (in result position: on the stack, its words the result)\n  rp := g.result_pos\n  g.result_pos = false\n  sh := match get(g.types.ctors, c) {\n    Some(s) => s,\n    None => {\n      codegen.not_yet(mut g, \"the constructor `\" + c + \"`\")\n      return codegen.never()\n    },\n  }\n  if codegen.refuse_capability(mut g, sh.owner) {\n    return codegen.never()\n  }\n  // each field's value is made as the wanted type says when that holds a\n  // trait value (`Some(mem_files(…))` for an `Option[Files]`), a union, or\n  // a function (lambda parameter types: `Some((a, b) -> …)` for an\n  // `Option[(Int, Int) -> Int]`)\n  wm := match want {\n    check.TNamed { name, args: wa } => if name == sh.owner {\n      check.pairs(sh.params, wa)\n    } else {\n      Dict[String, check.Ty] {}\n    },\n    _ => Dict[String, check.Ty] {},\n  }\n  mut wants := []\n  for f in sh.fields {\n    w := codegen.ground(check.inst(f.1, wm))\n    // a list too: a finite iterator given for one is converted (`converted`)\n    mut wants.push(\n   