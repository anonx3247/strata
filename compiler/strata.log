.ix.ctors, n) {\n    Some(s) => s,\n    None => return None,\n  }\n  module := get(x.ix.modules, sum) ?? \"\"\n  match get(x.ix.types, sum) {\n    Some(td) => match td.body {\n      ast.SumBody(vs) => vs.find(v -> derive.qualify(module, v.name) == n),\n      _ => None,\n    },\n    None => None,\n  }\n}","old_text":"fn variant_decl(x: derive.X, n: String) -> Option[ast.Variant] {\n  sum := match get(x.ix.ctors, n) {\n    Some(s) => s,\n    None => return None,\n  }\n  module := get(x.ix.modules, sum) ?? \"\"\n  match get(x.ix.types, sum) {\n    Some(td) => match td.body {\n      ast.SumBody(vs) => vs.find(v -> derive.qualify(module, v.name) == n),\n      _ => None,\n    },\n    None => None,\n  }\n}"},{"name":"derive.variant_value","kind":"fn","old":"5f57835ce0ae5915","new":"cf20ac3e2ba5099e","interface_changed":true,"affected":["derive.type_value_in","derive.type_value","derive.field","derive.full","derive.with_self","derive.data_in","derive.derive","derive.match_type","derive.fn_value","derive.make","derive.arm_pattern","derive.eval_as","derive.data","derive.ctor_data","derive.derive_all","derive.expr","derive.derive_fn","derive.comprehension","derive.fold_comptime","derive.eval_here","derive.call_copy","derive.derived_in","derive.children","derive.field_read","derive.type_method","derive.with_known","derive.block","derive.folded_in","derive.expand_with","derive.expand_in","std_reached","expanded","check_errors_in","derive.call_fn","derive.expand","holes_command","check_summary","verified_decls","verify_file","codegen_with","with_base","repl_eval","check_errors_with","edit_errors","eval_files","instantiated_files","with_extra","command_line","check_command","verified_with","static_graph","verify_command","build_proofs","alongside_command","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","repl_command","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply