nly names a member's type: `Int`, or `Circle` of a\n/// record member with nothing more to match.\nfn type_pattern(g: codegen.Gen, p: ast.Pattern, m: check.Ty) -> Bool {\n  match p {\n    // a refined type's name also has its predicate to match\n    ast.CtorPattern { name, args: ast.NoPats } => !contains(g.refines, name)\n      && (!contains(g.types.ctors, name)\n        || codegen.boxed(g, m)\n        || codegen.head_of(m) == name && !contains(g.types.sums, name)),\n    // a type with arguments (`List[Int]`)\n    ast.CtorPattern { name, args: ast.TypePats(_) } => !contains(g.types.ctors, name),\n    _ => false,\n  }\n}","old_text":"/// Whether a pattern only names a member's type: `Int`, or `Circle` of a\n/// record member with nothing more to match.\nfn type_pattern(g: codegen.Gen, p: ast.Pattern, m: Ty) -> Bool {\n  match p {\n    // a refined type's name also has its predicate to match\n    ast.CtorPattern { name, args: ast.NoPats } => !contains(g.refines, name)\n      && (!contains(g.types.ctors, name)\n        || codegen.boxed(g, m)\n        || codegen.head_of(m) == name && !contains(g.types.sums, name)),\n    // a type with arguments (`List[Int]`)\n    ast.CtorPattern { name, args: ast.TypePats(_) } => !contains(g.types.ctors, name),\n    _ => false,\n  }\n}"},{"name":"codegen.on_members","kind":"fn","old":"57bc09d10f3f428c","new":"7cb692ba088b0db6","interface_changed":true,"affected":["codegen.union_text","codegen.union_eq","codegen.union_cmp","codegen.union_drop","codegen.union_call","codegen.union_field","codegen.union_set","codegen.copy_fn","codegen.share_fn","codegen.helper","codegen.cmp_helper","codegen.drop_value","codegen.tail_drop","codegen.method_call","codegen.get_field","codegen.set_path","codegen.copy_out","codegen.share_value","codegen.tail_share","codegen.show","codegen.shown","codegen.equal","codegen.order_closure","codegen.cmp_fields","codegen.slot_fn","codegen.compare_values","codegen.function","codegen.drop_scope","codegen.drop_fields","cod