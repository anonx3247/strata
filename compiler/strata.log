ommand","build_command","run_command","static_graph","program_objects","comptime_values","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.generated_args","codegen.makers","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.read_back","eval_files"],"module":"codegen","text":"/// `set_path` on union value `v` whose members are records or variants that\n/// have the path's field: applied to the held member.\nfn union_set(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  ms: List[check.Ty],\n  path: List[String],\n  x: codegen.V,\n) -> codegen.V {\n  held := codegen.take_value(mut g, x)\n  labels := codegen.on_members(mut g, v, ms)\n  end := codegen.label(mut g, \"set.end\")\n  mut incoming := []\n  for (j, m) in enumerate(ms) {\n    codegen.block(mut g, get(labels, j) ?? \"\")\n    codegen.push_transparent(mut g)\n    xj := codegen.temp(mut g, held)\n    r0 := codegen.set_path(mut g, codegen.V { ..v, ty: m }, path, xj)\n    r := codegen.leave_branch(mut g, if r0.ty is check.TAny {\n      r0\n    } else {\n      codegen.V { ..r0, ty: v.ty }\n    })\n    mut incoming.push((r, codegen.current(g)))\n    codegen.br(mut g, end)\n  }\n  codegen.block(mut g, end)\n  r := codegen.join_values(mut g, incoming)\n  codegen.temp(mut g, r)\n}","old_text":"/// `set_path` on union value `v` whose members are records or variants that\n/// have the path's field: applied to the held member.\nfn union_set(\n  mut g: codegen.Gen,\n  v: codegen.V,\n  ms: List[Ty],\n  path: List[String],\n  x: codegen.V,\n) -> codegen.V {\n  held := codegen.take_value(mut g, x)\n  labels := codegen.on_members(mut g, v, ms)\n  end := codegen.label(mut g, \"set.end\")\n  mut incoming := []\n  for (j, m) in enumerate(ms) {\n    codegen.block(mut g, get(labels, j) ?? \"\")\n    codegen.push_transparent(mut g)\n    xj := codegen.temp(mut g, held)\n    r0 := codegen.set_path(mut g, codegen.V { ..v, ty: m }, path, xj)\n    r := codegen.leave_branch(mut g, if r0.ty is TAny {\n      r0\n    } else {\n      codegen.V { ..r0, ty: v.ty }\n    })\n    mut incoming.push((r, codegen.current(g)))\n    codegen.br(mut g, end)\n  }\n  codegen.block(mut g, end)\n  r := codegen.join_values(mut g, incoming)\n  codegen.temp(mut g, r)\n}"},{"name":"codegen.host_snapshot","kind":"fn","old":"8b98406eadf68c16","new":"2302a51f82f8fb24","interface_changed":false,"affected":[],"module":"codegen","text":"/// `host_code_snapshot()` from the runtime: `Ok(s)`, or `Err(why)` from the\n/// string it writes into the given cell when it returns NULL.\nfn host_snapshot(mut g: codegen.Gen) -> codegen.V {\n  snap := check.TNamed { name: \"std.code.Snapshot\", args: [] }\n  rt := check.TNamed { name: \"Result\", args: [snap, check.TStr] }\n  codegen.use_rt(mut g, \"strata_host_code_snapshot\")\n  (cell, r, ok) := (\n    codegen.fresh(mut g, \"err\"),\n    codegen.fresh(mut g, \"snap\"),\n    codegen.fresh(mut g, \"ok\"),\n  )\n  mut g.allocas.push(f\"  {cell} = alloca ptr\")\n  codegen.emit(mut g, f\"store ptr null, ptr {cell}\")\n  codegen.emit(\n    mut g,\n    f\"{r} = call ptr @strata_host_code_snapshot(ptr {cell})\",\n  )\n  codegen.emit(mut g, f\"{ok} = icmp ne ptr {r}, null\")\n  (good, bad, end) := (\n    codegen.label(mut g, \"snap.ok\"),\n    codegen.label(mut g, \"snap.err\"),\n    codegen.label(mut g, \"snap.end\"),\n  )\n  codegen.emit(mut g, f\"br i1 {ok}, label %{good}, label %{bad}\")\n  codegen.block(mut g, good)\n  okv := codegen.temp(mut g, codegen.V { ty: snap, op: r })\n  okb := codegen.block_of(mut g, get(g.tags, \"Ok\") ?? 0, [okv])\n  codegen.br(mut g, end)\n  codegen.block(mut g, bad)\n  m := codegen.fresh(mut g, \"msg\")\n  codegen.emit(mut g, f\"{m} = load ptr, ptr {cell}\")\n  mv := codegen.temp(mut g, codegen.V { ty: check.TStr, op: m })\n  errb := codegen.block_of(mut g, get(g.tags, \"Err\") ?? 0, [mv])\n  codegen.br(mut g, end)\n  codegen.block(mut g, end)\n  x := codegen.fresh(mut g, \"r\")\n  codegen.emit(\n    mut g,\n    f\"{x} = phi ptr [ {okb}, %{good} ], [ {errb}, %{bad} ]\",\n  )\n  codegen.temp(mut g, codegen.V { ty: rt, op: x })\n}","old_text":"/// `host_code_snapshot()` from the runtime: `Ok(s)`, or `Err(why)` from the\n/// string it writes into the given cell when it returns NULL.\nfn host_snapshot(mut g: codegen.Gen) -> codegen.V {\n  snap := TNamed { name: \"std.code.Snapshot\", args: [] }\n  rt := TNamed { name: \"Result\", args: [snap, TStr] }\n  codegen.use_rt(mut g, \"strata_host_code_snapshot\")\n  (cell, r, ok) := (\n    codegen.fresh(mut g, \"err\"),\n    codegen.fresh(mut g, \"snap\"),\n    codegen.fresh(mut g, \"ok\"),\n  )\n  mut g.allocas.push(f\"  {cell} = alloca ptr\")\n  codegen.emit(mut g, f\"store ptr null, ptr {cell}\")\n  codegen.emit(\n    mut g,\n    f\"{r} = call ptr @strata_host_code_snapshot(ptr {cell})\",\n  )\n  codegen.emit(mut g, f\"{ok} = icmp ne ptr {r}, null\")\n  (good, bad, end) := (\n    codegen.label(mut g, \"snap.ok\"),\n    codegen.label(mut g, \"snap.err\"),\n    codegen.label(mut g, \"snap.end\"),\n  )\n  codegen.emit(mut g, f\"br i1 {ok}, label %{good}, label %{bad}\")\n  codegen.block(mut g, good)\n  okv := codegen.temp(mut g, codegen.V { ty: snap, op: r })\n  okb := codegen.block_of(mut g, get(g.tags, \"Ok\") ?? 0, [okv])\n  codegen.br(mut g, end)\n  codegen.block(mut g, bad)\n  m := codegen.fresh(mut g, \"msg\")\n  codegen.emit(mut g, f\"{m} = load ptr, ptr {cell}\")\n  mv := codegen.temp(mut g, codegen.V { ty: TStr, op: m })\n  errb := codegen.block_of(mut g, get(g.tags, \"Err\") ?? 0, [mv])\n  codegen.br(mut g, end)\n  codegen.block(mut g, end)\n  x := codegen.fresh(mut g, \"r\")\n  codegen.emit(\n    mut g,\n    f\"{x} = phi ptr [ {okb}, %{good} ], [ {errb}, %{bad} ]\",\n  )\n  codegen.temp(mut g, codegen.V { ty: rt, op: x })\n}"},{"name":"codegen.check_field","kind":"fn","old":"8d42a4bfbd41626a","new":"597766a5b2eb583e","interface_changed":true,"affected":["codegen.call_fn_want","codegen.assign_at","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.dyn_call","codegen.stmt_node","codegen.expr_node","codegen.expr_want_node","codegen.show","codegen.shown","codegen.builtin","codegen.collection_builtin","codegen.string_builtin","codegen.builtin_call","codegen.dyn_wrapper","codegen.union_call","codegen.host","codegen.dyn_generic_call","codegen.main_arg","codegen.select_expr","codegen.stmt","codegen.expr","codegen.expr_want","codegen.entry","codegen.interp","codegen.format_spec","codegen.union_text","codegen.destructure","codegen.debug_fields","codegen.for_loop","codegen.debug_list","codegen.checked","codegen.fail_unless","codegen.check_type","codegen.check_requires","codegen.check_ensures","codegen.fuzz_driver","codegen.trace_enter","codegen.trace_leave","codegen.matching_v","codegen.index_check","codegen.checked_update","codegen.decreases_fault","codegen.push_in_place","codegen.gen_list","codegen.converted","codegen.update_in_place","codegen.except_expr","codegen.matching_want","codegen.vtable","codegen.block_expr","codegen.iterate","codegen.decreases_start","codegen.decreases_pass","codegen.decreases_entry","codegen.decreases_call","codegen.build_fn","codegen.binary","codegen.logic","codegen.loop_body","codegen.matches","codegen.with_it","codegen.for_list","codegen.await_expr","codegen.race_expr","codegen.mock_method","codegen.call_entry","codegen.construct_want","codegen.operands_want","code