degen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.read_back","eval_files","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// `channel()`, `channel(n)`: both ends of a new channel, typed from where\n/// they go. The runtime object is held twice.\nfn channel_new(\n  mut g: codegen.Gen,\n  args: List[ast.Expr],\n  want: check.Ty,\n) -> codegen.V {\n  et0 := match want {\n    check.TNamed { name: \"Tuple\", args: [check.TNamed { name: \"Sender\", args: [e] }, _] } => e,\n    _ => check.TAny,\n  }\n  // a channel never sent on, only closed, is of `()`\n  et := if et0 is check.TAny {\n    check.TUnit\n  } else {\n    et0\n  }\n  cap := match get(args, 0) {\n    Some(a) => codegen.expr_want(mut g, a, check.TInt).op,\n    None => \"0\",\n  }\n  drop := codegen.slot_drop_fn(mut g, et)\n  codegen.use_rt(mut g, \"strata_channel_new\")\n  codegen.use_rt(mut g, \"strata_alloc\")\n  c := codegen.fresh(mut g, \"chan\")\n  codegen.emit(\n    mut g,\n    f\"{c} = call ptr @strata_channel_new(i64 {cap}, ptr {drop})\",\n  )\n  codegen.after_builtin(mut g, \"strata_channel_new\")\n  b := codegen.fresh(mut g, \"ends\")\n  codegen.emit(mut g, f\"{b} = call ptr @strata_alloc(i64 24)\")\n  codegen.emit(mut g, f\"store i64 0, ptr {b}\")\n  cs := codegen.fresh(mut g, \"slot\")\n  codegen.emit(mut g, f\"{cs} = ptrtoint ptr {c} to i64\")\n  for k in [1, 2] {\n    p := codegen.fresh(mut g, \"end\")\n    codegen.emit(\n      mut g,\n      f\"{p} = getelementptr i64, ptr {b}, i64 {k}\",\n    )\n    codegen.emit(mut g, f\"store i64 {cs}, ptr {p}\")\n  }\n  t := check.TNamed { name: \"Tuple\", args: [\n    check.TNamed { name: \"Sender\", args: [et] },\n    check.TNamed { name: \"Receiver\", args: [et] },\n  ] }\n  codegen.temp(mut g, codegen.V { ty: t, op: b })\n}","old_text":"/// `channel()`, `channel(n)`: both ends of a new channel, typed from where\n/// they go. The runtime object is held twice.\nfn channel_new(\n  mut g: codegen.Gen,\n  args: List[ast.Expr],\n  want: Ty,\n) -> codegen.V {\n  et0 := match want {\n    TNamed { name: \"Tuple\", args: [TNamed { name: \"Sender\", args: [e] }, _] } => e,\n    _ => TAny,\n  }\n  // a channel never sent on, only closed, is of `()`\n  et := if et0 is TAny {\n    TUnit\n  } else {\n    et0\n  }\n  cap := match get(args, 0) {\n    Some(a) => codegen.expr_want(mut g, a, TInt).op,\n    None => \"0\",\n  }\n  drop := codegen.slot_drop_fn(mut g, et)\n  codegen.use_rt(mut g, \"strata_channel_new\")\n  codegen.use_rt(mut g, \"strata_alloc\")\n  c := codegen.fresh(mut g, \"chan\")\n  codegen.emit(\n    mut g,\n    f\"{c} = call ptr @strata_channel_new(i64 {cap}, ptr {drop})\",\n  )\n  codegen.after_builtin(mut g, \"strata_channel_new\")\n  b := codegen.fresh(mut g, \"ends\")\n  codegen.emit(mut g, f\"{b} = call ptr @strata_alloc(i64 24)\")\n  codegen.emit(mut g, f\"store i64 0, ptr {b}\")\n  cs := codegen.fresh(mut g, \"slot\")\n  codegen.emit(mut g, f\"{cs} = ptrtoint ptr {c} to i64\")\n  for k in [1, 2] {\n    p := codegen.fresh(mut g, \"end\")\n    codegen.emit(\n      mut g,\n      f\"{p} = getelementptr i64, ptr {b}, i64 {k}\",\n    )\n    codegen.emit(mut g, f\"store i64 {cs}, ptr {p}\")\n  }\n  t := TNamed { name: \"Tuple\", args: [\n    TNamed { name: \"Sender\", args: [et] },\n    TNamed { name: \"Receiver\", args: [et] },\n  ] }\n  codegen.temp(mut g, codegen.V { ty: t, op: b })\n}"},{"name":"codegen.end_elem","kind":"fn","old":"ed2fba0678b77cad","new":"f67b6b372c9a837e","interface_changed":true,"affected":["codegen.channel_op","codegen.select_expr","codegen.builtin","codegen.expr_node","codegen.call_named","codegen.builtin_call","codegen.push_in_place","codeg