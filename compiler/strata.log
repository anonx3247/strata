 method. A top-level\n/// function keeps its doc and comments on its `Decl`; these fields hold a\n/// method's.\n/// - `pre`, `post`: its `requires` and `ensures`.\n/// - `results`: the names of its result's elements, as in\n/// `-> (next: Q, added: Int)`, where `ret` is the tuple. Empty otherwise.\n/// - `terminating`: marked `terminates`, so its termination is assumed.\n/// - `no_alloc`: marked `noalloc`. Checked: its body allocates nothing and\n/// calls only `noalloc` functions.\n/// - `lemma`: a `lemma`, which exists only for `verify`: never compiled,\n/// called only in proofs. Its `ensures` is the fact it proves, its body the\n/// proof's steps.\npub type FnDecl = {\n  doc: List[String],\n  comments: List[String],\n  name: String,\n  type_params: List[String],\n  bounds: List[ast.Bound],\n  params: List[ast.Param],\n  ret: ast.TypeExpr,\n  pre: List[ast.Expr],\n  post: List[ast.Expr],\n  terminating: Bool,\n  body: ast.Expr,\n  compile_time: Bool,\n  derived: Bool,\n  results: List[String] = [],\n  no_alloc: Bool = false,\n  lemma: Bool = false,\n}","old_text":"/// A top-level function, a method, or a trait's method. A top-level\n/// function keeps its doc and comments on its `Decl`; these fields hold a\n/// method's.\n/// - `pre`, `post`: its `requires` and `ensures`.\n/// - `results`: the names of its result's elements, as in\n/// `-> (next: Q, added: Int)`, where `ret` is the tuple. Empty otherwise.\n/// - `terminating`: marked `terminates`, so its termination is assumed.\n/// - `no_alloc`: marked `noalloc`. Checked: its body allocates nothing and\n/// calls only `noalloc` functions.\npub type FnDecl = {\n  doc: List[String],\n  comments: List[String],\n  name: String,\n  type_params: List[String],\n  bounds: List[ast.Bound],\n  params: List[ast.Param],\n  ret: ast.TypeExpr,\n  pre: List[ast.Expr],\n  post: List[ast.Expr],\n  terminating: Bool,\n  body: ast.Expr,\n  compile_time: Bool,\n  derived: Bool,\n  results: List[String] = [],\n  no_alloc: Bool = false,\n}"},{"name":"ast.Stmt","kind":"type","old":"e59143439b4467c7","new":"d2f32296e6c14e21","interface_changed":true,"affected":["ast.Expr","ast.bare_stmt","ast.bare","binary.stmts","binary.stmt","binary.put_stmt","builtins.changes_as","capabilities.channel_sender","capabilities.stmt_children","capabilities.block","capabilities.noalloc_sites","check.errors_block","check.infer_block","check.infer_method","check.children","check.assigns_to","check.lets_in","check.fill","check.stmt_binds","check.tail_typed","check.written_calls","check.lam_unmarked","check.fn_lambdas_typed","check.ends_in_jump","check.bindings_of","check.spread_bound","check.spread_values","check.spread_lets","check.spread_names","check.spread_let","codegen.sub_exprs","codegen.stmt","codegen.assigns","codegen.block_expr","codegen.method_call","codegen.invariants","codegen.iterate","codegen.lambda_shown","codegen.stack_let","codegen.wait_edges","codegen.locals_of","codegen.may_change","codegen.stmt_node","codegen.decreases_start","codegen.decreases_pass","codegen.decreases_entry","codegen.decreases_call","codegen.build_fn","codegen.unread_dropped","codegen.without_assumed_invariants","codegen.stmt_value","contracts.assigned","contracts.stmt_paths","declarations.body_errors","declarations.children","derive.type_receiver","derive.eval_as","derive.block","derive.test_code","desugar.sliced","desugar.typed","desugar.lambda","desugar.element_assign","desugar.elements_assigned","desugar.named_indexes","desugar.unfolded","desugar.mock_of","eval.block","eval.closure","eval.stmt_parts","eval.stmt","eval.method_call","eval.run_lambda","eval.annotated_call","exhaustive.seen_block","finding.uses_in","graph.touched","graph.stmt_flow","graph.block_flow","graph.fuzz_probe","graph.loops_in","graph.can_leave","lint.collections_fixed","lint.assigned_back","lint.new_value","locate.Node","locate.stmt_binds","locate.stmt_kids","locate.expr_kids","locate.stand_in","locate.as_stmt","locate.replaced","locate.replaced_expr","te