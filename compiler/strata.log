eck.Ty],\n) -> Dict[String, check.Ty] {\n  match (p, a) {\n    (check.TGen(n), _) => {\n      mut copy := m\n      mut copy.insert(n, codegen.better(get(m, n) ?? check.TAny, a))\n      copy\n    },\n    (check.TNamed { name: pn, args: pa }, check.TNamed { name: an, args: aa }) => if pn == an && len(pa) == len(aa) {\n      mut out := m\n      for (k, x) in enumerate(pa) {\n        out = codegen.bind_gen(x, get(aa, k) ?? check.TAny, out)\n      }\n      out\n    } else {\n      m\n    },\n    (check.TList(x), check.TList(y)) => codegen.bind_gen(x, y, m),\n    // union members matched by head: `List[T] | Problem`\n    (check.TUnion(xs), check.TUnion(ys)) => {\n      mut out := m\n      for x in xs {\n        match find(ys, y -> codegen.head_of(y) == codegen.head_of(x)) {\n          Some(y) => {\n            out = codegen.bind_gen(x, y, out)\n          },\n          None => (),\n        }\n      }\n      out\n    },\n    (check.TFn { params: xs, ret: r }, check.TFn { params: ys, ret: q }) => {\n      mut out := m\n      for (k, x) in enumerate(xs) {\n        out = codegen.bind_gen(x, get(ys, k) ?? check.TAny, out)\n      }\n      codegen.bind_gen(r, q, out)\n    },\n    _ => m,\n  }\n}","old_text":"/// Adds to `m` the type parameters that `p` (a field's declared type) gets\n/// from `a` (the given value's type).\nfn bind_gen(p: Ty, a: Ty, m: Dict[String, Ty]) -> Dict[String, Ty] {\n  match (p, a) {\n    (TGen(n), _) => {\n      mut copy := m\n      mut copy.insert(n, codegen.better(get(m, n) ?? TAny, a))\n      copy\n    },\n    (TNamed { name: pn, args: pa }, TNamed { name: an, args: aa }) => if pn == an && len(pa) == len(aa) {\n      mut out := m\n      for (k, x) in enumerate(pa) {\n        out = codegen.bind_gen(x, get(aa, k) ?? TAny, out)\n      }\n      out\n    } else {\n      m\n    },\n    (TList(x), TList(y)) => codegen.bind_gen(x, y, m),\n    // union members matched by head: `List[T] | Problem`\n    (TUnion(xs), TUnion(ys)) => {\n      mut out := m\n      for x in xs {\n        match find(ys, y -> codegen.head_of(y) == codegen.head_of(x)) {\n          Some(y) => {\n            out = codegen.bind_gen(x, y, out)\n          },\n          None => (),\n        }\n      }\n      out\n    },\n    (TFn { params: xs, ret: r }, TFn { params: ys, ret: q }) => {\n      mut out := m\n      for (k, x) in enumerate(xs) {\n        out = codegen.bind_gen(x, get(ys, k) ?? TAny, out)\n      }\n      codegen.bind_gen(r, q, out)\n    },\n    _ => m,\n  }\n}"},{"name":"codegen.fields_of","kind":"fn","old":"d8d099946b42385d","new":"a93d08b91a99181e","interface_changed":true,"affected":["codegen.get_field","codegen.eq_body","codegen.debug_body","codegen.drop_fn","codegen.sub_patterns","codegen.cmp_helper","codegen.field_index","codegen.set_path","codegen.with_it","codegen.check_type","codegen.holds_pred","codegen.construct_want","codegen.variant_field","codegen.copy_held","codegen.hash_helper","codegen.block_fields","codegen.share_held","codegen.small_layout","codegen.has_field_check","codegen.expr_node","codegen.helper","codegen.drop_value","codegen.tail_drop","codegen.matches","codegen.binds","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.slot_fn","codegen.compare_values","codegen.call_fn_want","codegen.field_named","codegen.union_field","codegen.check_field","codegen.set_field_in_place","codegen.in_place_path","codegen.walkable","codegen.place_written","codegen.union_set","codegen.assign_at","codegen.tag_is","codegen.satisfies","codegen.function","codegen.declare","codegen.check_payload","codegen.lambda_shown","codegen.set_in_place","codegen.checked_update","codegen.stmt_node","codegen.check_union","codegen.check_member","codegen.type_check","codegen.construct","codegen.expr_want_node","codegen.copy_fn","codegen.hash_fields","codegen.share_fn","codegen.small_words","codegen.load_words","codegen.stack_words","codegen.result_block","codegen.words_fn","codegen.box_fn","codegen.fields_drop_fn","codegen.reusable","cod