odegen.narrow_op(mut g, w, s) }\n}"},{"name":"codegen.builtin_call","kind":"fn","old":"c524a3c5bd68a851","new":"4c2f4d1568fac671","interface_changed":false,"affected":[],"module":"codegen","text":"/// A built-in called on `first` (evaluated), then `rest`.\nfn builtin_call(\n  mut g: codegen.Gen,\n  given: String,\n  first: codegen.V,\n  rest: List[ast.Expr],\n) -> codegen.V {\n  args := [ast.UnitExpr] + rest\n  // an iterator or another program type: its own method\n  k := codegen.own_builtin(mut g, given, first)\n  if k != \"\" {\n    return codegen.call_fn(mut g, k, [first], rest)\n  }\n  // `xs.sorted()` maps to the built-in `sort`, which makes a new list\n  name := builtins.internal_name(given)\n  // `insert` or `remove` on a temporary dict or set (as in\n  // `insert(insert(d, a, x), b, y)`) changes it in place when nothing else\n  // holds it, as `x = insert(x, …)` does\n  if (name == \"insert\" || name == \"remove\")\n    && !g.in_update\n    && codegen.is_temp(g, first.op)\n    && match first.ty {\n      check.TNamed { name: n, .. } => n == \"Dict\" || n == \"Set\",\n      _ => false,\n    } {\n    r := codegen.fresh(mut g, \"tmp\")\n    h := \"$\" + byte_slice(r, 1, byte_len(r))\n    _ := codegen.local_value(mut g, h, first)\n    match codegen.update_in_place(\n      mut g,\n      ast.Var(h),\n      ast.Call { callee: ast.Var(name), args: [ast.Var(h)] + rest },\n    ) {\n      Some(u) => {\n        // the temporary is given up: what is left of it is the result's\n        codegen.untemp(mut g, first.op)\n        codegen.drop_value(mut g, first)\n        return u\n      },\n      None => (),\n    }\n  }\n  match first.ty {\n    check.TList(et) => {\n      // `to_list` of a list (a comprehension's) is itself\n      if name == \"to_list\" && len(rest) == 0 {\n        x := codegen.take_value(mut g, first)\n        return codegen.temp(mut g, x)\n      }\n      // `push(xs, Log {})` on a list of trait values makes the element one\n      if name == \"push\"\n        && len(rest) == 1\n        && codegen.holds_trait(et)\n        && get(rest, 0) != Some(ast.Var(\"$pushed\")) {\n        x := codegen.wanted(mut g, get(rest, 0) ?? ast.UnitExpr, et)\n        if x.ty is check.TAny {\n          return x\n        }\n        codegen.local_owned(mut g, \"$pushed\", x)\n        return codegen.builtin_call(\n          mut g,\n          name,\n          first,\n          [ast.Var(\"$pushed\")],\n        )\n      }\n      // written in Strata (the prelude)\n      own := if name == \"sum\" {\n        if et is check.TFloat {\n          \"sum_float\"\n        } else {\n          \"sum_int\"\n        }\n      } else {\n        name\n      }\n      if codegen.prelude_builtin(name)\n        && codegen.has_fn(g, codegen.prelude_name(own)) {\n        return codegen.call_fn(\n          mut g,\n          codegen.prelude_name(own),\n          [first],\n          drop(args, 1),\n        )\n      }\n      if name == \"sort\" && len(args) == 1 {\n        less := codegen.order_closure(mut g, \"less\", et)\n        return codegen.call_fn(\n          mut g,\n          codegen.prelude_name(\"sort_with\"),\n          [first, less],\n          [],\n        )\n      }\n      if name == \"sort_by\" && len(args) == 2 {\n        f := codegen.expr_want(\n          mut g,\n          get(args, 1) ?? ast.UnitExpr,\n          check.TFn { params: [et], ret: check.TAny },\n        )\n        return match f.ty {\n          check.TFn { ret, .. } => {\n            less := codegen.order_closure(mut g, \"less\", ret)\n            codegen.call_fn(\n              mut g,\n              codegen.prelude_name(\"sort_by_with\"),\n              [first, f, less],\n              [],\n            )\n          },\n          _ => codegen.never(),\n        }\n      }\n    },\n    _ => (),\n  }\n  // the other arguments; a wanted function is typed from the first\n  mut vs := [first]\n  for (i, a) in enumerate(drop(args, 1)) {\n    want := match (name, first.ty, i) {\n      (\"map_values\", check.TNamed { name: \"Dict\", args: [_, vt] }, 0) => check.TFn { params: [vt], ret: check.TAny },\n      _ => check.TAny,\n    }\n    v := codegen.expr_want(mut g, a, want)\n    if v.ty is check.TAny {\n      return codegen.never()\n    }\n    mut vs.push(v)\n  }\n  codegen.builtin(mut g, name, vs)\n}","old_text":"/// A built-in called on `first` (evaluated), then `rest`.\nfn builtin_call(\n  mut g: codegen.Gen,\n  given: String,\n  first: codegen.V,\n  rest: List[ast.Expr],\n) -> codegen.V {\n  args := [ast.UnitExpr] + rest\n  // an iterator or another program type: its own method\n  k := codegen.own_builtin(mut g, given, first)\n  if k != \"\" {\n    return codegen.call_fn(mut g, k, [first], rest)\n  }\n  // `xs.sorted()` maps to the built-in `sort`, which makes a new list\n  name := builtins.internal_name(given)\n  // `insert` or `remove` on a temporary dict or set (as in\n  // `insert(insert(d, a, x), b, y)`) changes it in place when nothing else\n  // holds it, as `x = insert(x, …)` does\n  if (name == \"insert\" || name == \"remove\")\n    && !g.in_update\n    && codegen.is_temp(g, first.op)\n    && match first.ty {\n      TNamed { name: n, .. } => n == \"Dict\" || n == \"Set\",\n      _ => false,\n    } {\n    r := codegen.fresh(mut g, \"tmp\")\n    h := \"$\" + byte_slice(r, 1, byte_len(r))\n    _ := codegen.local_value(mut g, h, first)\n    match codegen.update_in_place(\n      mut g,\n      ast.Var(h),\n      ast.Call { callee: ast.Var(name), args: [ast.Var(h)] + rest },\n    ) {\n      Some(u) => {\n        // the temporary is given up: what is left of it is the result's\n        codegen.untemp(mut g, first.op)\n        codegen.drop_value(mut g, first)\n        return u\n      },\n      None => (),\n    }\n  }\n  match first.ty {\n    TList(et) => {\n      // `to_list` of a list (a comprehension's) is itself\n      if name == \"to_list\" && len(rest) == 0 {\n        x := codegen.take_value(mut g, first)\n        return codegen.temp(mut g, x)\n      }\n      // `push(xs, Log {})` on a list of trait values makes the element one\n      if name == \"push\"\n        && len(rest) == 1\n        && codegen.holds_trait(et)\n        && get(rest, 0) != Some(ast.Var(\"$pushed\")) {\n        x := codegen.wanted(mut g, get(rest, 0) ?? ast.UnitExpr, et)\n        if x.ty is TAny {\n          return x\n        }\n        codegen.local_owned(mut g, \"$pushed\", x)\n        return codegen.builtin_call(\n          mut g,\n          name,\n          first,\n          [ast.Var(\"$pushed\")],\n        )\n      }\n      // written in Strata (the prelude)\n      own := if name == \"sum\" {\n        if et is TFloat {\n          \"sum_float\"\n        } else {\n          \"sum_int\"\n        }\n      } else {\n        name\n      }\n      if codegen.prelude_builtin(name)\n        && codegen.has_fn(g, codegen.prelude_name(own)) {\n        return codegen.call_fn(\n          mut g,\n          codegen.prelude_name(own),\n          [first],\n          drop(args, 1),\n        )\n      }\n      if name == \"sort\" && len(args) == 1 {\n        less := codegen.order_closure(mut g, \"less\", et)\n        return codegen.call_fn(\n          mut g,\n          codegen.prelude_name(\"sort_with\"),\n          [first, less],\n          [],\n        )\n      }\n      if name == \"sort_by\" && len(args) == 2 {\n        f := codegen.expr_want(\n          mut g,\n          get(args, 1) ?? ast.UnitExpr,\n          TFn { params: [et], ret: TAny },\n        )\n        return match f.ty {\n          TFn { ret, .. } => {\n            less := codegen.order_closure(mut g, \"less\", ret)\n            codegen.call_fn(\n              mut g,\n              codegen.prelude_name(\"sort_by_with\"),\n              [first, f, less],\n              [],\n            )\n          },\n          _ => codegen.never(),\n        }\n      }\n    },\n    _ => (),\n  }\n  // the other arguments; a wanted function is typed from the first\n  mut vs := [first]\n  for (i, a) in enumerate(drop(args, 1)) {\n    want := match (name, first.ty, i) {\n      (\"map_values\", TNamed { name: \"Dict\", args: [_, vt] }, 0) => TFn { params: [vt], ret: TAny },\n      _ => TAny,\n    }\n    v := codegen.expr_want(mut g, a, want)\n    if v.ty is TAny {\n      return codegen.never()\n    }\n    mut vs.push(v)\n  }\n  codegen.builtin(mut g, name, vs)\n}"},{"name":"codegen.list_literal_of","kind":"fn","old":"7eaa39ee3d65b529","new":"52b085860ea30719","interface_changed":true,"affected":["codegen.list_literal","codegen.expr_want_node","codegen.expr_node","codegen.expr_want","codegen.expr","codegen.function","codegen.binary","codegen.declare","codegen.destructure","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.method_call","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.try_want","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.compared","codegen.stmt_node","codegen.build_fn","codegen.push_in_place","codegen.call_named","codegen.interp","codegen.logic","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.except_expr","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.main_arg","codegen.await_expr","codegen.race_expr","codegen.mock_method","codegen.converted","codegen.call_entry","codegen.type_check","codegen.if_want","codegen.branch_value","codegen.matching_want","codegen.tag_test","codegen.update_in_place","codegen.set_in_place","codegen.take_in_place","codegen.decreases_pass","codegen.decreases_call","codegen.keep_olds","codegen.export_entry","codegen.expr_on_stack","codegen.assigned_call","codegen.compiled_alone","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.by_variant","codegen.generate","codegen.construct","