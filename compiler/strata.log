, Bool)`, `Option[P]`.\nfn key(t: Ty) -> String {\n  match t {\n    TInt => \"Int\",\n    TFloat => \"Float\",\n    TBool => \"Bool\",\n    TStr => \"String\",\n    TUnit => \"()\",\n    TNamed { name: \"Tuple\", args } => \"(\" + join(args.map(a -> codegen.key(a)), \", \") + \")\",\n    TList(a) => \"List[\" + codegen.key(a) + \"]\",\n    TTrait(n) => n,\n    TUnion(ms) => join(ms.map(m -> codegen.key(m)), \" | \"),\n    TFn { params, ret } => \"(\"\n      + join(params.map(a -> codegen.key(a)), \", \")\n      + \") -> \"\n      + codegen.key(ret),\n    TNamed { name, args: [] } => name,\n    TNamed { name, args } => name + \"[\" + join(args.map(a -> codegen.key(a)), \", \") + \"]\",\n    _ => \"_\",\n  }\n}"},{"name":"codegen.better","kind":"fn","old":"895e9d0c4623702a","new":"50b2c05bb4eb3c8e","interface_changed":true,"affected":["codegen.join_values","codegen.apply","codegen.declare","codegen.bind_gen","codegen.list_builtin","codegen.call_fn_want","codegen.list_literal_of","codegen.channel_op","codegen.select_expr","codegen.retype","codegen.converted","codegen.construct_want","codegen.try_want","codegen.retype_temp","codegen.lambda_shown","codegen.appended","codegen.expr_node","codegen.push_in_place","codegen.logic","codegen.union_call","codegen.race_expr","codegen.if_want","codegen.variant_field","codegen.by_variant","codegen.union_field","codegen.union_set","codegen.dyn_generic_call","codegen.or_else","codegen.list_get_or","codegen.matching_v","codegen.match_got","codegen.binary","codegen.number_builtin","codegen.checked","codegen.stmt_node","codegen.bind_bounds","codegen.impl_args","codegen.self_want","codegen.written_args","codegen.impl_written","codegen.builtin","codegen.take_in_place","codegen.call_named","codegen.call_fn","codegen.method_call","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.list_literal","codegen.expr_want_node","codegen.collection_builtin","codegen.produce","codegen.operands_want","codegen.want