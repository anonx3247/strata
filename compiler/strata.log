(ast.BoolLit(ends_with(eval.str_of(a)!, eval.str_of(b)!))),\n    \"chars\" => Ok(eval.str_list(eval.str_of(a)!.chars())),\n    \"index_of\" => Ok(\n      eval.option(match index_of(eval.str_of(a)!, eval.str_of(b)!) {\n        Some(n) => Some(ast.IntLit(n)),\n        None => None,\n      }),\n    ),\n    \"byte_slice\" => Ok(ast.StrLit(\n      byte_slice(eval.str_of(a)!, eval.int_of(b)!, eval.int_of(c)!),\n    )),\n    \"replace\" => Ok(ast.StrLit(\n      replace(eval.str_of(a)!, eval.str_of(b)!, eval.str_of(c)!),\n    )),\n    \"repeat\" => Ok(ast.StrLit(repeat(eval.str_of(a)!, eval.int_of(b)!))),\n    \"to_upper\" => Ok(ast.StrLit(to_upper(eval.str_of(a)!))),\n    \"to_lower\" => Ok(ast.StrLit(to_lower(eval.str_of(a)!))),\n    \"is_digit\" => Ok(ast.BoolLit(is_digit(eval.str_of(a)!))),\n    \"is_alpha\" => Ok(ast.BoolLit(is_alpha(eval.str_of(a)!))),\n    \"is_space\" => Ok(ast.BoolLit(is_space(eval.str_of(a)!))),\n    \"byte_len\" => Ok(ast.IntLit(byte_len(eval.str_of(a)!))),\n    \"byte_at\" => {\n      s := eval.str_of(a)!\n      i := eval.int_of(b)!\n      if i < 0 || i >= byte_len(s) {\n        return Err(eval.runtime(\"byte \"\n          + to_string(i)\n          + \" out of range (length \"\n          + to_string(byte_len(s))\n          + \")\"))\n      }\n      Ok(ast.IntLit(byte_at(s, i)))\n    },\n    \"ord\" => {\n      s := eval.str_of(a)!\n      cps := s.code_points().to_list()\n      match cps {\n        [x] => Ok(ast.IntLit(x)),\n        _ => Err(eval.runtime(\n          \"ord needs a single character, got \" + eval.quoted(s),\n        )),\n      }\n    },\n    \"chr\" => {\n      n := eval.int_of(a)!\n      if n < 0 || n > 1114111 || n >= 55296 && n <= 57343 {\n        return Err(\n          eval.runtime(\n            \"chr: \" + to_string(n) + \" is not a character\",\n          ),\n        )\n      }\n      Ok(ast.StrLit(chr(n)))\n    },\n    _ => Err(eval.runtime(\n      \"the built-in `\" + name + \"` isn't run by this evaluator yet\",\n    )),\n  }\n}","old_text":"fn builtin(\n  mut st: eval.State,\n  w: eval.World,\n  given: String,\n  vs: List[ast.Expr],\n) -> Result[ast.Expr, eval.Escape] {\n  // `xs.sorted()` is the built-in `sort`, returning a new list\n  name := builtins.internal_name(given)\n  // an iterator where a list is wanted: its elements (`join(s.graphemes(), \"\")`)\n  a := match eval.arg(vs, 0) {\n    ast.CtorExpr { .. } => if eval.method_of(w, eval.arg(vs, 0), \"next\") is Some\n      && !(name == \"to_string\" || name == \"debug\" || name == \"print\") {\n      ast.ListExpr(eval.elements(mut st, w, eval.arg(vs, 0))!)\n    } else {\n      eval.arg(vs, 0)\n    },\n    x => x,\n  }\n  b := eval.arg(vs, 1)\n  c := eval.arg(vs, 2)\n  match eval.conversion(name, a) {\n    Some(r) => return r,\n    None => (),\n  }\n  match name {\n    \"print\" => {\n      st.out += eval.display(mut st, w, a)! + \"\\n\"\n      Ok(ast.UnitExpr)\n    },\n    // what std reaches the system through: the run's own output and arguments\n    \"host_write\" => {\n      if a == ast.IntLit(2) {\n        st.err += eval.str_of(b)!\n      } else {\n        st.out += eval.str_of(b)!\n      }\n      Ok(ast.UnitExpr)\n    },\n    \"host_args\" => Ok(eval.str_list(st.args)),\n    // reading files through the run's `Files`. Writing files is not\n    // supported.\n    \"host_read_file\" | \"host_read_bytes\" | \"host_exists\" | \"host_list_dir\" => match st.files {\n      Some(fs) => eval.host_files(fs, name, eval.str_of(a)!),\n      None => Err(eval.runtime(\"the built-in `\"\n        + name\n        + \"` reads files, which compile-time code can't\")),\n    },\n    \"host_env_var\" | \"host_read_line\" => Ok(eval.none()),\n    \"to_string\" => Ok(ast.StrLit(eval.display(mut st, w, a)!)),\n    \"debug\" => Ok(ast.StrLit(eval.show(mut st, w, a)!)),\n    \"len\" => match a {\n      ast.StrLit(_) => Err(eval.runtime(\"a String has no `len`: name the unit\")),\n      _ => Ok(ast.IntLit(len(eval.collection_of(a)!))),\n    },\n    \"contains\" => match (a, b) {\n      (ast.StrLit(s), ast.StrLit(p)) => Ok(ast.BoolLit(contains(s, p))),\n      (ast.DictExpr { entries, .. }, _) => Ok(ast.BoolLit(eval.dict_get(entries, b) is Some)),\n      _ => Ok(ast.BoolLit(contains(eval.collection_of(a)!, b))),\n    },\n    \"get\" => match a {\n      ast.DictExpr { entries, .. } => Ok(eval.option(eval.dict_get(entries, b))),\n      _ => Ok(eval.option(get(eval.list_of(a)!, eval.int_of(b)!))),\n    },\n    \"at\" => eval.at(eval.list_of(a)!, eval.int_of(b)!),\n    \"set_at\" => {\n      xs := eval.list_of(a)!\n      i := eval.int_of(b)!\n      _ := eval.at(xs, i)!\n      Ok(ast.ListExpr(take(xs, i) + [c] + drop(xs, i + 1)))\n    },\n    \"dict\" => Ok(eval.make_dict(w, eval.list_of(a)!.map(\n      x -> match x {\n        ast.TupleExpr([k, v]) => (k, v),\n        _ => (x, ast.UnitExpr),\n      },\n    ))),\n    \"insert\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.DictExpr {\n        types: [],\n        entries: eval.dict_put(w, entries, b, c),\n      }),\n      ast.SetExpr { elems, .. } => Ok(\n        ast.SetExpr { types: [], elems: eval.set_put(w, elems, b) },\n      ),\n      _ => Err(eval.runtime(\"insert into \" + eval.code(a))),\n    },\n    \"remove\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.DictExpr { types: [], entries: eval.swap_removed(\n        entries,\n        eval.index_where(entries.map(kv -> kv.0), b),\n      ) }),\n      ast.SetExpr { elems, .. } => Ok(ast.SetExpr {\n        types: [],\n        elems: eval.swap_removed(elems, eval.index_where(elems, b)),\n      }),\n      _ => Err(eval.runtime(\"remove from \" + eval.code(a))),\n    },\n    \"keys\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.ListExpr(entries.map(kv -> kv.0))),\n      _ => Err(eval.runtime(\"keys of \" + eval.code(a))),\n    },\n    \"values\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.ListExpr(entries.map(kv -> kv.1))),\n      _ => Err(eval.runtime(\"values of \" + eval.code(a))),\n    },\n    \"items\" => match a {\n      ast.DictExpr { entries, .. } => Ok(ast.ListExpr(entries.map(kv -> eval.pair(kv.0, kv.1)))),\n      _ => Err(eval.runtime(\"items of \" + eval.code(a))),\n    },\n    \"map_values\" => match a {\n      ast.DictExpr { entries, .. } => {\n        mut out: List[(ast.Expr, ast.Expr)] = []\n        for kv in entries {\n          mut out.push((kv.0, eval.apply(mut st, w, b, [kv.1])!))\n        }\n        Ok(ast.DictExpr { types: [], entries: out })\n      },\n      _ => Err(eval.runtime(\"map_values of \" + eval.code(a))),\n    },\n    \"set\" => Ok(eval.make_set(w, eval.collection_of(a)!)),\n    \"to_list\" => Ok(ast.ListExpr(eval.collection_of(a)!)),\n    \"union\" => Ok(eval.make_set(\n      w,\n      eval.collection_of(a)! + eval.collection_of(b)!,\n    )),\n    \"intersection\" => {\n      ys := eval.collection_of(b)!\n      Ok(eval.make_set(\n        w,\n        eval.collection_of(a)!.filter(x -> contains(ys, x)),\n      ))\n    },\n    \"difference\" => {\n      ys := eval.collection_of(b)!\n      Ok(eval.make_set(\n        w,\n        eval.collection_of(a)!.filter(x -> !contains(ys, x)),\n      ))\n    },\n    \"zip\" => Ok(ast.ListExpr(zip(eval.list_of(a)!, eval.list_of(b)!).map(\n      p -> eval.pair(p.0, p.1),\n    ))),\n    \"enumerate\" => Ok(ast.ListExpr(\n      [eval.pair(ast.IntLit(i), x) for (i, x) in enumerate(eval.list_of(a)!)],\n    )),\n    \"sort\" => Ok(ast.ListExpr(\n      eval.merge_sort(mut st, w, eval.list_of(a)!.map(x -> (x, x))).map(\n        p -> p.1,\n      ),\n    )),\n    \"sort_by\" => {\n      mut keyed := []\n      for x in eval.list_of(a)! {\n        mut keyed.push((eval.apply(mut st, w, b, [x])!, x))\n      }\n      Ok(\n        ast.ListExpr(\n          eval.merge_sort(mut st, w, keyed).map(p -> p.1),\n        ),\n      )\n    },\n    \"reverse\" => match a {\n      ast.StrLit(s) => Ok(ast.StrLit(s.reversed())),\n      _ => Ok(ast.ListExpr(eval.list_of(a)!.reversed())),\n    