a, b)\n  }\n  match a.ty {\n    check.TUnit => codegen.V { ty: check.TBool, op: \"true\" },\n    check.TInt => {\n      // the same 64 bits, or two big integers of the same value\n      same := codegen.fresh(mut g, \"same\")\n      codegen.emit(mut g, f\"{same} = icmp eq i64 {a.op}, {b.op}\")\n      from := codegen.current(g)\n      (deep, end) := (\n        codegen.label(mut g, \"int.deep\"),\n        codegen.label(mut g, \"int.eqd\"),\n      )\n      codegen.emit(\n        mut g,\n        f\"br i1 {same}, label %{end}, label %{deep}\",\n      )\n      codegen.block(mut g, deep)\n      e := codegen.call(mut g, check.TBool, \"strata_int_eq\", [a, b])\n      codegen.br(mut g, end)\n      codegen.block(mut g, end)\n      r := codegen.fresh(mut g, \"eq\")\n      codegen.emit(\n        mut g,\n        f\"{r} = phi i1 [ true, %{from} ], [ {e.op}, %{deep} ]\",\n      )\n      codegen.V { ty: check.TBool, op: r }\n    },\n    check.TBool => codegen.compare(mut g, \"icmp eq\", a, b),\n    check.TFloat => codegen.compare(mut g, \"fcmp oeq\", a, b),\n    check.TStr => codegen.call(mut g, check.TBool, \"strata_str_eq\", [a, b]),\n    check.TTrait(_) => codegen.dyn_equal(mut g, a, b),\n    check.TUnion(_) => {\n      f := codegen.helper(mut g, \"eq\", a.ty)\n      codegen.call_at(mut g, check.TBool, f, [a, b])\n    },\n    // the same keys with equal entries, in any order\n    check.TNamed { name: \"Set\", .. } | check.TNamed { name: \"Dict\", .. } => {\n      fs := codegen.table_fns(mut g, a.ty)\n      eq := codegen.V {\n        ty: check.TStr,\n        op: codegen.slot_fn(mut g, \"eq\", codegen.entry_ty(a.ty)),\n      }\n      codegen.use_rt(mut g, \"strata_tbl_eq\")\n      codegen.call_bare(mut g, check.TBool, \"@strata_tbl_eq\", [\n        a,\n        b,\n        get(fs, 0) ?? codegen.unit(),\n        get(fs, 1) ?? codegen.unit(),\n        eq,\n        get(fs, 2) ?? codegen.unit(),\n      ])\n    },\n    check.TNamed { .. } | check.TList(_) => {\n      f := codegen.helper(mut g, \"eq\", a.ty)\n      codegen.call_at(mut g, check.TBool, f, [a, b])\n    },\n    _ => codegen.bad_op(mut g, ast.Equal),\n  }\n}","old_text":"fn equal(mut g: codegen.Gen, a0: codegen.V, b0: codegen.V) -> codegen.V {\n  a := codegen.as_type(mut g, a0, b0.ty)\n  b := codegen.as_type(mut g, b0, a0.ty)\n  match codegen.sized(a.ty) {\n    Some(_) => return codegen.compare(mut g, \"icmp eq\", a, b),\n    None => (),\n  }\n  // handles and channel ends: identity\n  if codegen.opaque(a.ty) {\n    return codegen.compare(mut g, \"icmp eq\", a, b)\n  }\n  match a.ty {\n    check.TUnit => codegen.V { ty: check.TBool, op: \"true\" },\n    check.TInt => {\n      // the same 64 bits, or two big integers of the same value\n      same := codegen.fresh(mut g, \"same\")\n      codegen.emit(mut g, f\"{same} = icmp eq i64 {a.op}, {b.op}\")\n      from := codegen.current(g)\n      (deep, end) := (\n        codegen.label(mut g, \"int.deep\"),\n        codegen.label(mut g, \"int.eqd\"),\n      )\n      codegen.emit(\n        mut g,\n        f\"br i1 {same}, label %{end}, label %{deep}\",\n      )\n      codegen.block(mut g, deep)\n      e := codegen.call(mut g, check.TBool, \"strata_int_eq\", [a, b])\n      codegen.br(mut g, end)\n      codegen.block(mut g, end)\n      r := codegen.fresh(mut g, \"eq\")\n      codegen.emit(\n        mut g,\n        f\"{r} = phi i1 [ true, %{from} ], [ {e.op}, %{deep} ]\",\n      )\n      codegen.V { ty: check.TBool, op: r }\n    },\n    check.TBool => codegen.compare(mut g, \"icmp eq\", a, b),\n    check.TFloat => codegen.compare(mut g, \"fcmp oeq\", a, b),\n    check.TStr => codegen.call(mut g, check.TBool, \"strata_str_eq\", [a, b]),\n    check.TTrait(_) => codegen.dyn_equal(mut g, a, b),\n    check.TUnion(_) => {\n      f := codegen.helper(mut g, \"eq\", a.ty)\n      codegen.call_at(mut g, check.TBool, f, [a, b])\n    },\n    // the same keys with equal entries, in any order\n    check.TNamed { name: \"Set\", .. } | check.TNamed { name: \"Dict\", .. } => {\n      fs := codegen.table_fns(mut g, a.ty)\n      eq := codegen.V {\n        ty: check.TStr,\n        op: codegen.slot_fn(mut g, \"eq\", codegen.entry_ty(a.ty)),\n      }\n      codegen.use_rt(mut g, \"strata_tbl_eq\")\n      codegen.call_bare(mut g, check.TBool, \"@strata_tbl_eq\", [\n        a,\n        b,\n        get(fs, 0) ?? codegen.unit(),\n        get(fs, 1) ?? codegen.unit(),\n        eq,\n        get(fs, 2) ?? codegen.unit(),\n      ])\n    },\n    check.TNamed { .. } | check.TList(_) => {\n      f := codegen.helper(mut g, \"eq\", a.ty)\n      codegen.call_at(mut g, check.TBool, f, [a, b])\n    },\n    _ => codegen.bad_op(mut g, ast.Equal, a),\n  }\n}"},{"name":"codegen.word_op","kind":"fn","old":"9c041b7b592478f7","new":"1de453b4730459d0","interface_changed":false,"affected":[],"module":"codegen","text":"/// An operation on two sized integers of type `w`.\nfn word_op(\n  mut g: codegen.Gen,\n  op: ast.BinOp,\n  w: String,\n  a: codegen.V,\n  b: codegen.V,\n) -> codegen.V {\n  t := codegen.ll(a.ty)\n  signed := codegen.word_signed(w)\n  r := codegen.fresh(mut g, \"w\")\n  simple := match op {\n    ast.Add => \"add\",\n    ast.Sub => \"sub\",\n    ast.Mul => \"mul\",\n    ast.BitAnd => \"and\",\n    ast.BitOr => \"or\",\n    ast.BitXor => \"xor\",\n    _ => \"\",\n  }\n  if simple != \"\" {\n    codegen.emit(mut g, f\"{r} = {simple} {t} {a.op}, {b.op}\")\n    return codegen.V { ty: a.ty, op: r }\n  }\n  pred := match op {\n    ast.Less => if signed {\n      \"slt\"\n    } else {\n      \"ult\"\n    },\n    ast.LessEq => if signed {\n      \"sle\"\n    } else {\n      \"ule\"\n    },\n    ast.Greater => if signed {\n      \"sgt\"\n    } else {\n      \"ugt\"\n    },\n    ast.GreaterEq => if signed {\n      \"sge\"\n    } else {\n      \"uge\"\n    },\n    _ => \"\",\n  }\n  if pred != \"\" {\n    codegen.emit(mut g, f\"{r} = icmp {pred} {t} {a.op}, {b.op}\")\n    return codegen.V { ty: check.TBool, op: r }\n  }\n  match op {\n    ast.Div | ast.Mod => {\n      // in 64 bits (`Int`'s Euclidean division), then truncated\n      f := match (op, signed) {\n        (ast.Div, true) => \"strata_word_div\",\n        (ast.Div, false) => \"strata_uword_div\",\n        (_, true) => \"strata_word_mod\",\n        _ => \"strata_uword_mod\",\n      }\n      (x, y) := (codegen.wide(mut g, w, a), codegen.wide(mut g, w, b))\n      q := codegen.raw_call(mut g, f, [x, y])\n      codegen.narrow_word(mut g, w, q, a.ty)\n    },\n    ast.Shl | ast.Shr => {\n      bits := codegen.word_bits(w)\n      k := parse_int(b.op)\n      // a shift by a negative count (signed) faults as `Int`'s does\n      neg_ok := match k {\n        Some(n) => n >= 0,\n        None => false,\n      }\n      if signed && !neg_ok {\n        (neg, bad, ok) := (\n          codegen.fresh(mut g, \"neg\"),\n          codegen.label(mut g, \"shift.neg\"),\n          codegen.label(mut g, \"shift.ok\"),\n        )\n        codegen.emit(mut g, f\"{neg} = icmp slt {t} {b.op}, 0\")\n        codegen.emit(\n          mut g,\n          f\"br i1 {neg}, label %{bad}, label %{ok}\",\n        )\n        codegen.block(mut g, bad)\n        m := codegen.string(mut g, \"`\" + text.op_text(op) + \"`\")\n        codegen.use_rt(mut g, \"strata_word_shift_fault\")\n        codegen.emit(\n          mut g,\n          f\"call void @strata_word_shift_fault(ptr {m})\",\n        )\n        codegen.br(mut g, ok)\n        codegen.block(mut g, ok)\n      }\n      ins := match (op, signed) {\n        (ast.Shl, _) => \"shl\",\n        (_, true) => \"ashr\",\n        _ => \"lshr\",\n      }\n      small := match k {\n        Some(n) => n >= 0 && n < bits,\n        None => false,\n      }\n      if small {\n        codegen.emit(mut g, f\"{r} = {ins} {t} {a.op}, {b.op}\")\n        return codegen.V { ty: a.ty, op: r }\n      }\n      big := codegen.fresh(mut g, \"big\")\n      codegen.emit(mut g, f\"{big} = icmp uge {t} {b.op}, {bits}\")\n      if ins == \"ashr\" {\n        n := codegen.fresh(mut g, \"n\")\n        codegen.emit(\n          mut g,\n          f\"{n} = select i1 {big}, {t} {bits - 1}, {t} {b.op}\",\n        )\n        codegen.emit(mut g, f\"{r} = ashr {t} {a.op}, {n}\")\n        return codegen.V { ty: a.ty, op: r }\n      }\n      sh := codegen.fresh(mut g, \"sh\")\n      codegen.emit(mut g, f\"{sh} = {ins} {t} {a.op}, {b.op}\")\n      codegen.emit(mut g, f\"{r} = select i1 {big}, {t} 0, {t} {sh}\")\n      codegen.V { ty: a.ty, op: r }\n    },\n    _ => codegen.bad_op(mut g, op),\n  }\n}","old_text":"/// An operation on two sized integers of type `w`.\nfn word_op(\n  mut g: codegen.Gen,\n  op: ast.BinOp,\n  w: String,\n  a: codegen.V,\n  b: codegen.V,\n) -> codegen.V {\n  t := codegen.ll(a.ty)\n  signed := codegen.word_signed(w)\n  r := codegen.fresh(mut g, \"w\")\n  simple := match op {\n    ast.Add => \"add\",\n    ast.Sub => \"sub\",\n    ast.Mul => \"mul\",\n    ast.BitAnd => \"and\",\n    ast.BitOr => \"or\",\n    ast.BitXor => \"xor\",\n    _ => \"\",\n  }\n  if simple != \"\" {\n    codegen.emit(mut g, f\"{r} = {simple} {t} {a.op}, {b.op}\")\n    return codegen.V { ty: a.ty, op: r }\n  }\n  pred := match op {\n    ast.Less => if signed {\n      \"slt\"\n    } else {\n      \"ult\"\n    },\n    ast.LessEq => if signed {\n      \"sle\"\n    } else {\n      \"ule\"\n    },\n    ast.Greater => if signed {\n      \"sgt\"\n    } else {\n      \"ugt\"\n    },\n    ast.GreaterEq => if signed {\n      \"sge\"\n    } else {\n      \"uge\"\n    },\n    _ => \"\",\n  }\n  if pred != \"\" {\n    codegen.emit(mut g, f\"{r} = icmp {pred} {t} {a.op}, {b.op}\")\n    return codegen.V { ty: check.TBool, op: r }\n  }\n  match op {\n    ast.Div | ast.Mod => {\n      // in 64 bits (`Int`'s Euclidean division), then truncated\n      f := match (op, signed) {\n        (ast.Div, true) => \"strata_word_div\",\n        (ast.Div, false) => \"strata_uword_div\",\n        (_, true) => \"strata_word_mod\",\n        _ => \"strata_uword_mod\",\n      }\n      (x, y) := (codegen.wide(mut g, w, a), codegen.wide(mut g, w, b))\n      q := codegen.raw_call(mut g, f, [x, y])\n      codegen.narrow_word(mut g, w, q, a.ty)\n    },\n    ast.Shl | ast.Shr => {\n      bits := codegen.word_bits(w)\n      k := parse_int(b.op)\n      // a shift by a negative count (signed) faults as `Int`'s does\n      neg_ok := match k {\n        Some(n) => n >= 0,\n        None => false,\n      }\n      if signed && !neg_ok {\n        (neg, bad, ok) := (\n          codegen.fresh(mut g, \"neg\"),\n          codegen.label(mut g, \"shift.neg\"),\n          codegen.label(mut g, \"shift.ok\"),\n        )\n        codegen.emit(mut g, f\"{neg} = icmp slt {t} {b.op}, 0\")\n        codegen.emit(\n          mut g,\n          f\"br i1 {neg}, label %{bad}, label %{ok}\",\n        )\n        codegen.block(mut g, bad)\n        m := codegen.string(mut g, \"`\" + text.op_text(op) + \"`\")\n        codegen.use_rt(mut g, \"strata_word_shift_fault\")\n        codegen.emit(\n          mut g,\n          f\"call void @strata_word_shift_fault(ptr {m})\",\n        )\n        codegen.br(mut g, ok)\n        codegen.block(mut g, ok)\n      }\n      ins := match (op, signed) {\n        (ast.Shl, _) => \"shl\",\n        (_, true) => \"ashr\",\n        _ => \"lshr\",\n      }\n      small := match k {\n        Some(n) => n >= 0 && n < bits,\n        None => false,\n      }\n      if small {\n        codegen.emit(mut g, f\"{r} = {ins} {t} {a.op}, {b.op}\")\n        return codegen.V { ty: a.ty, op: r }\n      }\n      big := codegen.fresh(mut g, \"big\")\n      codegen.emit(mut g, f\"{big} = icmp uge {t} {b.op}, {bits}\")\n      if ins == \"ashr\" {\n        n := codegen.fresh(mut g, \"n\")\n        codegen.emit(\n          mut g,\n          f\"{n} = select i1 {big}, {t} {bits - 1}, {t} {b.op}\",\n        )\n        codegen.emit(mut g, f\"{r} = ashr {t} {a.op}, {n}\")\n        return codegen.V { ty: a.ty, op: r }\n      }\n      sh := codegen.fresh(mut g, \"sh\")\n      codegen.emit(mut g, f\"{sh} = {ins} {t} {a.op}, {b.op}\")\n      codegen.emit(mut g, f\"{r} = select i1 {big}, {t} 0, {t} {sh}\")\n      codegen.V { ty: a.ty, op: r }\n    },\n    _ => codegen.bad_op(mut g, op, a),\n  }\n}"}]}
{"id":"cfa783e2befa2f79","time":1795657248,"message":"edit","changes":[{"name":"eval.refuse","kind":"fn","old":"1ff4a7137d354f21","new":"6d6100effc01a3c1","interface_changed":true,"affected":["eval.check","eval.construct","eval.checked","eval.stmt","eval.assign","eval.called","eval.static_call","eval.eval","eval.block","eval.write_back","eval.method_call","eval.call","eval.run","eval.holds_on","eval.eval_all","eval.in_order","eval.place_path","eval.each","eval.arguments","eval.call_expr","eval.run_lambda","eval.holds","eval.value_in","eval.expecting","eval.call_named","eval.display","eval.show","eval.advance","eval_files","eval.fits","eval.matches","eval.apply","eval.invariants_hold","derive.eval_as","derive.derive","eval.formatted","eval.builtin","eval.show_all","eval.elements","command_line","eval.is_a","eval.type_pattern","eval.matches_all","derive.fold_comptime","derive.eval_here","derive.expr","derive.call_copy","derive.derive_fn","derive.derive_all","main","derive.folded_in","derive.block","derive.comprehension","derive.match_type","derive.children","derive.field_read","derive.type_method","derive.with_known","derive.derived_in","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","derive.expand_with","derive.expand_in","expanded","check_errors_in","derive.make","derive.call_fn","std_reached","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","derive.expand","holes_command","check_summary","verified_decls","with_base","check_errors_with","edit_errors","verify_file","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","instantiated_files","with_extra","check_command","verified_with","static_graph","loaded_errors","check_errors_of","edit_file","file_errors","apply_change","apply_edit","verify_command","build_proofs","alongside_command","search_invariants","codegen_file","jit_file","fuzz_file","literal_errors_of","graph_runs","replay","or_solver_inputs","strata_command","build_command","run_command","program_objects","comptime_values","verified_program","graph_command","graph_diff","package_errors","merge_file_command","merged_checks","call_command","edit_command","check_files","rename_command","move_command","fix_command","edit_in_editor","fix_loops","check_fn","linked","comptime_runner","smt_file","termination_file","diff_command","sync_command"],"module":"eval","text":"fn refuse(ctx: String, v: ast.Expr, why: String) -> eval.Escape {\n  eval.fault(\"Refinement\", ctx + \": \" + eval.code(v) + \" \" + why)\n}","old_text":"fn refuse(ctx: String, w: eval.World, v: ast.Expr, why: String) -> eval.Escape {\n  eval.fault(\"Refinement\", ctx + \": \" + eval.code(v) + \" \" + why)\n}"},{"name":"eval.check","kind":"fn","old":"90355b2dd457d9e6","new":"d21e8e5b8a67b10b","interface_changed":false,"affected":[],"module":"eval","text":"/// Checks `v` against the written type `t`, as compiled code does at a\n/// function boundary and on a declared variable: refinements (of aliases\n/// and inline), each element of a list, set or dict, fields whose type is a\n/// type argument (`Option[Positive]`), and union membership.\nfn check(\n  mut st: eval.State,\n  w: eval.World,\n  t: ast.TypeExpr,\n  v: ast.Expr,\n  ctx: String,\n) -> Result[(), eval.Escape] {\n  match t {\n    ast.Refined { base, pred } => {\n      eval.check(mut st, w, base, v, ctx)!\n      if !eval.holds_on(mut st, w, pred, v)! {\n        return Err(eval.refuse(\n          ctx,\n          v,\n          \"does not satisfy `\" + text.type_text(t) + \"`\",\n        ))\n      }\n      Ok(())\n    },\n    ast.UnionType(ms) => {\n      for m in ms {\n        if eval.fits(mut st, w, m, v)! {\n          return eval.check(mut st, w, m, v, ctx)\n        }\n      }\n      Err(\n        eval.refuse(ctx, v, \"is not a `\" + text.type_text(t) + \"`\"),\n      )\n    },\n    ast.Named { name: \"List\", args: [et] } => {\n      for (i, x) in enumerate(eval.list_of(v)!) {\n        eval.check(\n          mut st,\n          w,\n          et,\n          x,\n          ctx + \": [\" + to_string(i) + \"]\",\n        )!\n      }\n      Ok(())\n    },\n    ast.Named { name: \"Set\", args: [et] } => {\n      match v {\n        ast.SetExpr { elems, .. } => {\n          for x in elems {\n            eval.check(\n              mut st,\n              w,\n              et,\n              x,\n              ctx + \": element \" + eval.code(x),\n            )!\n          }\n        },\n        _ => (),\n      }\n      Ok(())\n    },\n    ast.Named { name: \"Dict\", args: [kt, vt] } => {\n      match v {\n        ast.DictExpr { entries, .. } => {\n          for kv in entries {\n            eval.check(\n              mut st,\n              w,\n              kt,\n              kv.0,\n              ctx + \": key \" + eval.code(kv.0),\n            )!\n            eval.check(\n              mut st,\n              w,\n              vt,\n              kv.1,\n              ctx + \": [\" + eval.code(kv.0) + \"]\",\n            )!\n          }\n        },\n        _ => (),\n      }\n      Ok(())\n    },\n    ast.Named { name, args } => {\n      n := get(w.ctors, name) ?? name\n      td := match get(w.types, n) {\n        Some(d) => d,\n        None => return Ok(()),\n      }\n      sub := dict(zip(td.params, args))\n      match td.body {\n        ast.Alias(a) => {\n          if !td.distinct {\n            eval.check(mut st, w, eval.substitute(a, sub), v, ctx)!\n            match td.refinement {\n              Some(r) => if !eval.holds_on(mut st, w, r, v)! {\n                // a refinement written as a type argument is shown as written\n                return Err(\n                  eval.refuse(ctx, v, if starts_with(n, \"$where_\") {\n                    \"does not satisfy `\"\n                      + text.type_text(ast.Refined {\n                        base: eval.substitute(a, sub),\n                        pred: r,\n                      })\n                      + \"`\"\n                  } else {\n                    \"does not satisfy `\"\n                      + eval.short(n)\n                      + \"` (where \"\n                      + text.expr_text(r, 0)\n                      + \")\"\n                  }),\n                )\n              },\n              None => (),\n            }\n          }\n          Ok(())\n        },\n        _ => {\n          // fields whose type is a type argument\n          match v {\n            ast.CtorExpr { name: c, args: cargs } => {\n              for (fname, ft, x) in eval.fields_of(w, c, cargs) {\n                if eval.mentions_param(ft, td.params) {\n                  eval.check(\n                    mut st,\n                    w,\n                    eval.substitute(ft, sub),\n                    x,\n                    ctx + \": \" + eval.short(c) + \".\" + fname,\n                  )!\n                }\n              }\n            },\n            _ => (),\n          }\n          Ok(())\n        },\n      }\n    },\n    _ => Ok(()),\n  }\n}","old_text":"/// Checks `v` against the written type `t`, as compiled code does at a\n/// function boundary and on a declared variable: refinements (of aliases\n/// and inline), each element of a list, set or dict, fields whose type is a\n/// type argument (`Option[Positive]`), and union membership.\nfn check(\n  mut st: eval.State,\n  w: eval.World,\n  t: ast.TypeExpr,\n  v: ast.Expr,\n  ctx: String,\n) -> Result[(), eval.Escape] {\n  match t {\n    ast.Refined { base, pred } => {\n      eval.check(mut st, w, base, v, ctx)!\n      if !eval.holds_on(mut st, w, pred, v)! {\n        return Err(eval.refuse(\n          ctx,\n          w,\n          v,\n          \"does not satisfy `\" + text.type_text(t) + \"`\",\n        ))\n      }\n      Ok(())\n    },\n    ast.UnionType(ms) => {\n      for m in ms {\n        if eval.fits(mut st, w, m, v)! {\n          return eval.check(mut st, w, m, v, ctx)\n        }\n      }\n      Err(\n        eval.refuse(\n          ctx,\n          w,\n          v,\n          \"is not a `\" + text.type_text(t) + \"`\",\n        ),\n      )\n    },\n    ast.Named { name: \"List\", args: [et] } => {\n      for (i, x) in enumerate(eval.list_of(v)!) {\n        eval.check(\n          mut st,\n          w,\n          et,\n          x,\n          ctx + \": [\" + to_string(i) + \"]\",\n        )!\n      }\n      Ok(())\n    },\n    ast.Named { name: \"Set\", args: [et] } => {\n      match v {\n        ast.SetExpr { elems, .. } => {\n          for x in elems {\n            eval.check(\n              mut st,\n              w,\n              et,\n              x,\n              ctx + \": element \" + eval.code(x),\n            )!\n          }\n        },\n        _ => (),\n      }\n      Ok(())\n    },\n    ast.Named { name: \"Dict\", args: [kt, vt] } => {\n      match v {\n        ast.DictExpr { entries, .. } => {\n          for kv in entries {\n            eval.check(\n              mut st,\n              w,\n              kt,\n              kv.0,\n              ctx + \": key \" + eval.code(kv.0),\n            )!\n            eval.check(\n              mut st,\n              w,\n              vt,\n              kv.1,\n              ctx + \": [\" + eval.code(kv.0) + \"]\",\n            )!\n          }\n        },\n        _ => (),\n      }\n      Ok(())\n    },\n    ast.Named { name, args } => {\n      n := get(w.ctors, name) ?? name\n      td := match get(w.types, n) {\n        Some(d) => d,\n        None => return Ok(()),\n      }\n      sub := dict(zip(td.params, args))\n      match td.body {\n        ast.Alias(a) => {\n          if !td.distinct {\n            eval.check(mut st, w, eval.substitute(a, sub), v, ctx)!\n            match td.refinement {\n              Some(r) => if !eval.holds_on(mut st, w, r, v)! {\n                // a refinement written as a type argument is shown as written\n                return Err(eval.refuse(\n                  ctx,\n                  w,\n                  v,\n                  if starts_with(n, \"$where_\") {\n                    \"does not satisfy `\"\n                      + text.type_text(ast.Refined {\n                        base: eval.substitute(a, sub),\n                        pred: r,\n                      })\n                      + \"`\"\n                  } else {\n                    \"does not satisfy `\"\n                      + eval.short(n)\n                      + \"` (where \"\n                      + text.expr_text(r, 0)\n                      + \")\"\n                  },\n                ))\n              },\n              None => (),\n            }\n          }\n          Ok(())\n        },\n        _ => {\n          // fields whose type is a type argument\n          match v {\n            ast.CtorExpr { name: c, args: cargs } => {\n              for (fname, ft, x) in eval.fields_of(w, c, cargs) {\n                if eval.mentions_param(ft, td.params) {\n                  eval.check(\n                    mut st,\n                    w,\n                    eval.substitute(ft, sub),\n                    x,\n                    ctx + \": \" + eval.short(c) + \".\" + fname,\n                  )!\n                }\n              }\n            },\n            _ => (),\n          }\n          Ok(())\n        },\n      }\n    },\n    _ => Ok(()),\n  }\n}"},{"name":"eval.construct","kind":"fn","old":"991a27a73ede3882","new":"3a8cfcd1ced94294","interface_changed":false,"affected":[],"module":"eval","text":"/// A new value of constructor `name`, its fields' refinements and the\n/// type's own checked.\nfn construct(\n  mut st: eval.State,\n  w: eval.World,\n  name: String,\n  args: ast.CtorArgs,\n) -> Result[ast.Expr, eval.Escape] {\n  ctx := \"constructing `\" + name + \"`\"\n  td := get(w.types, get(w.ctors, name) ?? name)\n  v1 := match args {\n    ast.NoArgs => return Ok(ast.CtorExpr { name, args: ast.NoArgs }),\n    ast.PositionalArgs(xs) => ast.CtorExpr {\n      name,\n      args: ast.PositionalArgs(eval.eval_all(mut st, w, xs)!),\n    },\n    ast.RecordArgs(fs) => {\n      mut given := []\n      for f in fs {\n        mut given.push((f.0, eval.eval(mut st, w, f.1)!))\n      }\n      ast.CtorExpr {\n        name,\n        args: ast.RecordArgs(eval.in_order(mut st, w, name, given)!),\n      }\n    },\n    ast.UpdateArgs { base, fields } => {\n      b := eval.eval(mut st, w, base)!\n      mut out := b\n      for f in fields {\n        out = eval.set_path(w, out, [f.0], eval.eval(mut st, w, f.1)!)!\n      }\n      ast.CtorExpr { name, args: match out {\n        ast.CtorExpr { args, .. } => args,\n        _ => ast.NoArgs,\n      } }\n    },\n  }\n  // each field's value of its declared type\n  v := match v1 {\n    ast.CtorExpr { args: ast.PositionalArgs(xs), .. } => ast.CtorExpr { name, args: ast.PositionalArgs(\n      eval.fields_of(w, name, ast.PositionalArgs(xs)).map(\n        f -> eval.typed(f.1, f.2),\n      ),\n    ) },\n    ast.CtorExpr { args: ast.RecordArgs(fs), .. } => ast.CtorExpr {\n      name,\n      args: ast.RecordArgs(\n        eval.fields_of(w, name, ast.RecordArgs(fs)).map(\n          f -> (f.0, eval.typed(f.1, f.2)),\n        ),\n      ),\n    },\n    _ => v1,\n  }\n  match td {\n    Some(t) => {\n      if t.distinct {\n        // a distinct type is its value, checked\n        x := match v {\n          ast.CtorExpr { args: ast.PositionalArgs([x]), .. } => x,\n          _ => return Err(eval.runtime(\"`\" + name + \"` takes one value\")),\n        }\n        match t.body {\n          ast.Alias(a) => eval.check(mut st, w, a, x, ctx)!,\n          _ => (),\n        }\n        match t.refinement {\n          Some(r) => if !eval.holds_on(mut st, w, r, x)! {\n            return Err(eval.refuse(ctx, x, \"does not satisfy `\"\n              + name\n              + \"` (where \"\n              + text.expr_text(r, 0)\n              + \")\"))\n          },\n          None => (),\n        }\n        return Ok(v)\n      }\n      match v {\n        ast.CtorExpr { args: cargs, .. } => {\n          for (fname, ft, x) in eval.fields_of(w, name, cargs) {\n            eval.check(\n              mut st,\n              w,\n              ft,\n              x,\n              ctx + \": \" + eval.short(name) + \".\" + fname,\n            )!\n          }\n        },\n        _ => (),\n      }\n      match t.refinement {\n        Some(r) => if !eval.holds_on(mut st, w, r, v)! {\n          return Err(eval.refuse(ctx, v, \"does not satisfy `\"\n            + eval.short(get(w.ctors, name) ?? name)\n            + \"` (where \"\n            + text.expr_text(r, 0)\n            + \")\"))\n        },\n        None => (),\n      }\n      Ok(v)\n    },\n    None => Ok(v),\n  }\n}","old_text":"/// A new value of constructor `name`, its fields' refinements and the\n/// type's own checked.\nfn construct(\n  mut st: eval.State,\n  w: eval.World,\n  name: String,\n  args: ast.CtorArgs,\n) -> Result[ast.Expr, eval.Escape] {\n  ctx := \"constructing `\" + name + \"`\"\n  td := get(w.types, get(w.ctors, name) ?? name)\n  v1 := match args {\n    ast.NoArgs => return Ok(ast.CtorExpr { name, args: ast.NoArgs }),\n    ast.PositionalArgs(xs) => ast.CtorExpr {\n      name,\n      args: ast.PositionalArgs(eval.eval_all(mut st, w, xs)!),\n    },\n    ast.RecordArgs(fs) => {\n      mut given := []\n      for f in fs {\n        mut given.push((f.0, eval.eval(mut st, w, f.1)!))\n      }\n      ast.CtorExpr {\n        name,\n        args: ast.RecordArgs(eval.in_order(mut st, w, name, given)!),\n      }\n    },\n    ast.UpdateArgs { base, fields } => {\n      b := eval.eval(mut st, w, base)!\n      mut out := b\n      for f in fields {\n        out = eval.set_path(w, out, [f.0], eval.eval(mut st, w, f.1)!)!\n      }\n      ast.CtorExpr { name, args: match out {\n        ast.CtorExpr { args, .. } => args,\n        _ => ast.NoArgs,\n      } }\n    },\n  }\n  // each field's value of its declared type\n  v := match v1 {\n    ast.CtorExpr { args: ast.PositionalArgs(xs), .. } => ast.CtorExpr { name, args: ast.PositionalArgs(\n      eval.fields_of(w, name, ast.PositionalArgs(xs)).map(\n        f -> eval.typed(f.1, f.2),\n      ),\n    ) },\n    ast.CtorExpr { args: ast.RecordArgs(fs), .. } => ast.CtorExpr {\n      name,\n      args: ast.RecordArgs(\n        eval.fields_of(w, name, ast.RecordArgs(fs)).map(\n          f -> (f.0, eval.typed(f.1, f.2)),\n        ),\n      ),\n    },\n    _ => v1,\n  }\n  match td {\n    Some(t) => {\n      if t.distinct {\n        // a distinct type is its value, checked\n        x := match v {\n          ast.CtorExpr { args: ast.PositionalArgs([x]), .. } => x,\n          _ => return Err(eval.runtime(\"`\" + name + \"` takes one value\")),\n        }\n        match t.body {\n          ast.Alias(a) => eval.check(mut st, w, a, x, ctx)!,\n          _ => (),\n        }\n        match t.refinement {\n          Some(r) => if !eval.holds_on(mut st, w, r, x)! {\n            return Err(eval.refuse(ctx, w, x, \"does not satisfy `\"\n              + name\n              + \"` (where \"\n              + text.expr_text(r, 0)\n              + \")\"))\n          },\n          None => (),\n        }\n        return Ok(v)\n      }\n      match v {\n        ast.CtorExpr { args: cargs, .. } => {\n          for (fname, ft, x) in eval.fields_of(w, name, cargs) {\n            eval.check(\n              mut st,\n              w,\n              ft,\n              x,\n              ctx + \": \" + eval.short(name) + \".\" + fname,\n            )!\n          }\n        },\n        _ => (),\n      }\n      match t.refinement {\n        Some(r) => if !eval.holds_on(mut st, w, r, v)! {\n          return Err(eval.refuse(ctx, w, v, \"does not satisfy `\"\n            + eval.short(get(w.ctors, name) ?? name)\n            + \"` (where \"\n            + text.expr_text(r, 0)\n            + \")\"))\n        },\n        None => (),\n      }\n      Ok(v)\n    },\n    None => Ok(v),\n  }\n}"},{"name":"eval.checked","kind":"fn","old":"31954420ea3549f8","new":"4c6c291739dd2f9e","interface_changed":false,"affected":[],"module":"eval","text":"/// The field a path ends at, checked against its declared type, then each\n/// record on the way against its type's refinement, innermost first.\nfn checked(\n  mut st: eval.State,\n  w: eval.World,\n  cur: ast.Expr,\n  path: List[String],\n  v: ast.Expr,\n  ctx: String,\n) -> Result[(), eval.Escape] {\n  name := get(path, 0) ?? \"\"\n  match cur {\n    ast.CtorExpr { name: c, args } => {\n      ft := eval.field_type(eval.field_types(w, c), name)\n      if len(path) == 1 {\n        eval.check(\n          mut st,\n          w,\n          ft,\n          v,\n          ctx + \": \" + eval.short(c) + \".\" + name,\n        )!\n      } else {\n        eval.checked(\n          mut st,\n          w,\n          eval.field(w, cur, name)!,\n          drop(path, 1),\n          v,\n          ctx,\n        )!\n      }\n      new := eval.set_path(w, ast.CtorExpr { name: c, args }, path, v)!\n      match get(w.types, get(w.ctors, c) ?? c) {\n        Some(ast.TypeDecl { refinement: Some(r), distinct: false, .. }) => if !eval.holds_on(mut st, w, r, new)! {\n          return Err(eval.refuse(ctx, new, \"does not satisfy `\"\n            + eval.short(get(w.ctors, c) ?? c)\n            + \"` (where \"\n            + text.expr_text(r, 0)\n            + \")\"))\n        },\n        _ => (),\n      }\n      Ok(())\n    },\n    _ => Ok(()),\n  }\n}","old_text":"/// The field a path ends at, checked against its declared type, then each\n/// record on the way against its type's refinement, innermost first.\nfn checked(\n  mut st: eval.State,\n  w: eval.World,\n  cur: ast.Expr,\n  path: List[String],\n  v: ast.Expr,\n  ctx: String,\n) -> Result[(), eval.Escape] {\n  name := get(path, 0) ?? \"\"\n  match cur {\n    ast.CtorExpr { name: c, args } => {\n      ft := eval.field_type(eval.field_types(w, c), name)\n      if len(path) == 1 {\n        eval.check(\n          mut st,\n          w,\n          ft,\n          v,\n          ctx + \": \" + eval.short(c) + \".\" + name,\n        )!\n      } else {\n        eval.checked(\n          mut st,\n          w,\n          eval.field(w, cur, name)!,\n          drop(path, 1),\n          v,\n          ctx,\n        )!\n      }\n      new := eval.set_path(w, ast.CtorExpr { name: c, args }, path, v)!\n      match get(w.types, get(w.ctors, c) ?? c) {\n        Some(ast.TypeDecl { refinement: Some(r), distinct: false, .. }) => if !eval.holds_on(mut st, w, r, new)! {\n          return Err(eval.refuse(ctx, w, new, \"does not satisfy `\"\n            + eval.short(get(w.ctors, c) ?? c)\n            + \"` (where \"\n            + text.expr_text(r, 0)\n            + \")\"))\n        },\n        _ => (),\n      }\n      Ok(())\n    },\n    _ => Ok(()),\n  }\n}"}]}
{"id":"1c60f27c15bd769e","time":1795657256,"message":"edit","changes":[{"name":"refactor.rename_one","kind":"fn","old":"b98b961b61f6493b","new":"6606ba2180f28861","interface_changed":true,"affected":["refactor.rename_all","diff.diff","rename_command","merge.renames","merge.merge","merge.follow_rename","diff.range_text","diff.range_diff","command_line","merge_file_command","follow_renames","diff_command","main","sync_command","codegen.entry","codegen.generate","codegen.new_gen","codegen.compiled_alone","eval.run","codegen_with","core_rt_text","computed_value","repl_eval","codegen.read_back","eval_files","codegen_text","literal_errors","compiled_drivers","compiling","replay_all","test_command","std_library","built_ir","core_rt_object","build_core_command","comptime_value","repl_command","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","move_command","fix_command","edit_in_editor"],"module":"refactor","text":"/// Renames `old` (a qualified function, type, trait, variant or trait\n/// method) to the short name `new`, and every reference to it.\nfn rename_one(\n  ds: List[ast.Decl],\n  old: String,\n  new: String,\n) -> Result[List[ast.Decl], String] {\n  (kind, module) := match refactor.member(ds, old) {\n    Some(m) => m,\n    None => return Err(f\"no definition, variant, trait method or field `{old}`\"),\n  }\n  if ds.any(\n    d -> store.qname(d) == old\n      && match d.kind {\n        ast.ExternDef(x) => x.item is ast.ExternFn,\n        _ => false,\n      },\n  ) {\n    return Err(\n      f\"`{old}` is a foreign function: its name is the symbol it is linked to, so it can't be renamed (wrap it in a function with the name you want)\",\n    )\n  }\n  if !refactor.is_name(new) {\n    return Err(\n      f\"`{new}` is not a name (give the new short name, without the module)\",\n    )\n  }\n  s := refactor.short(old)\n  if refactor.is_upper(s) != refactor.is_upper(new) {\n    want := if refactor.is_upper(new) {\n      \"a lowercase letter\"\n    } else {\n      \"an uppercase letter\"\n    }\n    return Err(f\"`{new}` must start with {want} like `{s}`\")\n  }\n  if kind == \"field\" {\n    return refactor.rename_field(ds, module, s, new)\n  }\n  new_q := refactor.qualify(module, new)\n  if contains(refactor.defined(ds), new_q) {\n    return Err(f\"`{new_q}` already exists\")\n  }\n  renames := Dict[String, String] { old: new_q }\n  Ok(\n    ds.map(\n      d -> refactor.renamed_decl(d, old, s, new, kind, renames),\n    ),\n  )\n}","old_text":"/// Renames `old` (a qualified function, type, trait, variant or trait\n/// method) to the short name `new`, and every reference to it.\nfn rename_one(\n  ds: List[ast.Decl],\n  old: String,\n  new: String,\n  builtins: Set[String],\n) -> Result[List[ast.Decl], String] {\n  (kind, module) := match refactor.member(ds, old) {\n    Some(m) => m,\n    None => return Err(f\"no definition, variant, trait method or field `{old}`\"),\n  }\n  if ds.any(\n    d -> store.qname(d) == old\n      && match d.kind {\n        ast.ExternDef(x) => x.item is ast.ExternFn,\n        _ => false,\n      },\n  ) {\n    return Err(\n      f\"`{old}` is a foreign function: its name is the symbol it is linked to, so it can't be renamed (wrap it in a function with the name you want)\",\n    )\n  }\n  if !refactor.is_name(new) {\n    return Err(\n      f\"`{new}` is not a name (give the new short name, without the module)\",\n    )\n  }\n  s := refactor.short(old)\n  if refactor.is_upper(s) != refactor.is_upper(new) {\n    want := if refactor.is_upper(new) {\n      \"a lowercase letter\"\n    } else {\n      \"an uppercase letter\"\n    }\n    return Err(f\"`{new}` must start with {want} like `{s}`\")\n  }\n  if kind == \"field\" {\n    return refactor.rename_field(ds, module, s, new)\n  }\n  new_q := refactor.qualify(module, new)\n  if contains(refactor.defined(ds), new_q) {\n    return Err(f\"`{new_q}` already exists\")\n  }\n  renames := Dict[String, String] { old: new_q }\n  Ok(\n    ds.map(\n      d -> refactor.renamed_decl(d, old, s, new, kind, renames),\n    ),\n  )\n}"},{"name":"refactor.rename_all","kind":"fn","old":"fb0ba06b7625de2c","new":"517e2490271a3c16","interface_changed":false,"affected":[],"module":"refactor","text":"/// Applied one after the other. Each `old` is qualified.\npub fn rename_all(\n  ds: List[ast.Decl],\n  pairs: List[(String, String)],\n  builtins: Set[String],\n) -> Result[List[ast.Decl], String] {\n  // a field read from a union of records (`field#A,B`, tagged by\n  // `mark_field_reads`): every record's field gets the same new name\n  new_of := (q: String) -> pairs.find(p -> p.0 == q)\n  for d in ds {\n    for (f, owners) in refactor.field_reads(d) {\n      renamed := owners.filter(o -> new_of(o + \".\" + f) is Some)\n      if renamed != [] && len(owners) > 1 {\n        match owners.find(o -> new_of(o + \".\" + f) is None) {\n          Some(other) => return Err(\n            f\"in `{store.qname(d)}`, `.{f}` is read from a union that also has `{refactor.short(other)}.{f}` (rename it too, in the same command)\",\n          ),\n          None => (),\n        }\n        if len(\n          set(renamed.map(o -> (new_of(o + \".\" + f) ?? (\"\", \"\")).1)),\n        ) > 1 {\n          return Err(\n            f\"`.{f}` is read from a union whose records would get different names\",\n          )\n        }\n      }\n    }\n  }\n  mut out := ds\n  for (old, new) in pairs {\n    out = refactor.rename_one(out, old, new)!\n  }\n  // (the tags off)\n  Ok(\n    out.map(\n      d ->\n        walk.rewrite_decl(\n          d,\n          e ->\n            match e {\n              ast.FieldOf { base, name } => ast.FieldOf { base, name: refactor.untagged(name) },\n              _ => e,\n            },\n        ),\n    ),\n  )\n}","old_text":"/// Applied one after the other. Each `old` is qualified.\npub fn rename_all(\n  ds: List[ast.Decl],\n  pairs: List[(String, String)],\n  builtins: Set[String],\n) -> Result[List[ast.Decl], String] {\n  // a field read from a union of records (`field#A,B`, tagged by\n  // `mark_field_reads`): every record's field gets the same new name\n  new_of := (q: String) -> pairs.find(p -> p.0 == q)\n  for d in ds {\n    for (f, owners) in refactor.field_reads(d) {\n      renamed := owners.filter(o -> new_of(o + \".\" + f) is Some)\n      if renamed != [] && len(owners) > 1 {\n        match owners.find(o -> new_of(o + \".\" + f) is None) {\n          Some(other) => return Err(\n            f\"in `{store.qname(d)}`, `.{f}` is read from a union that also has `{refactor.short(other)}.{f}` (rename it too, in the same command)\",\n          ),\n          None => (),\n        }\n        if len(\n          set(renamed.map(o -> (new_of(o + \".\" + f) ?? (\"\", \"\")).1)),\n        ) > 1 {\n          return Err(\n            f\"`.{f}` is read from a union whose records would get different names\",\n          )\n        }\n      }\n    }\n  }\n  mut out := ds\n  for (old, new) in pairs {\n    out = refactor.rename_one(out, old, new, builtins)!\n  }\n  // (the tags off)\n  Ok(\n    out.map(\n      d ->\n        walk.rewrite_decl(\n          d,\n          e ->\n            match e {\n              ast.FieldOf { base, name } => ast.FieldOf { base, name: refactor.untagged(name) },\n              _ => e,\n            },\n        ),\n    ),\n  )\n}"}]}
{"id":"f5e7f8c69fa8b706","time":1795657268,"message":"edit","changes":[{"name":"smt.sort_of","kind":"fn","old":"0f3068b6338bd202","new":"e17abba7c5f54497","interface_changed":false,"affected":[],"module":"smt","text":"/// The SMT sort of the values of `t`.\nfn sort_of(mut vc: smt.Vc, t: ast.TypeExpr) -> Option[String] {\n  if smt.sized(t) {\n    return Some(\"Int\")\n  }\n  st := smt.sort_type(vc, t)\n  match st {\n    ast.UnitType => {\n      match smt.new_datatype(mut vc, \"T:Unit\") {\n        Some(i) => smt.set_datatype(mut vc, i, [(\"T:Unit.unit\", [])]),\n        None => (),\n      }\n      Some(smt.sym(\"T:Unit\"))\n    },\n    ast.FnType { .. } => Some(smt.opaque_sort(mut vc, \"Fn\")),\n    ast.Refined { base, .. } => smt.sort_of(mut vc, base),\n    ast.UnionType(ms) => {\n      gs := smt.union_groups(vc, ms)?\n      mut sorts := []\n      for g in gs {\n        mut sorts.push(smt.field_sort(mut vc, g.ty))\n      }\n      n := \"T:Union(\" + smt.bare(join(sorts, \",\")) + \")\"\n      match smt.new_datatype(mut vc, n) {\n        Some(i) => {\n          mut cs := []\n          for (k, s) in enumerate(sorts) {\n            mut cs.push((n + \".\" + f\"{k}\", [s]))\n          }\n          smt.set_datatype(mut vc, i, cs)\n        },\n        None => (),\n      }\n      Some(smt.sym(n))\n    },\n    ast.Named { name, args } => match name {\n      \"Int\" | \"Bool\" | \"String\" => Some(name),\n      \"Dict\" | \"Set\" => match smt.map_sorts(mut vc, st) {\n        Some(ms) => Some(ms.arr),\n        None => Some(smt.opaque_sort(mut vc, name)),\n      },\n      \"Float\" | \"_\" => Some(smt.opaque_sort(mut vc, name)),\n      \"List\" => match get(args, 0) {\n        Some(a) => {\n          item := smt.field_sort(mut vc, a)\n          n := \"T:List(\" + smt.bare(item) + \")\"\n          if !contains(vc.sort_index, n) {\n            mut vc.sort_index.insert(n, len(vc.sorts))\n            mut vc.sorts.push((n, smt.ListSort(item)))\n          }\n          Some(smt.sym(n))\n        },\n        None => Some(smt.opaque_sort(mut vc, \"List\")),\n      },\n      \"Tuple\" => {\n        n := smt.dt_name(st)\n        match smt.new_datatype(mut vc, n) {\n          Some(i) => {\n            mut fs := []\n            for a in args {\n              mut fs.push(smt.field_sort(mut vc, a))\n            }\n            smt.set_datatype(mut vc, i, [(n + \".mk\", fs)])\n          },\n          None => (),\n        }\n        Some(smt.sym(n))\n      },\n      // (a datatype declared already: its constructors aren't made again)\n      _ => if contains(vc.sort_index, smt.dt_name(st)) {\n        Some(smt.sym(smt.dt_name(st)))\n      } else {\n        match smt.variants_of(vc, name, args) {\n          Some(vs) => {\n            n := smt.dt_name(st)\n            match smt.new_datatype(mut vc, n) {\n              Some(i) => {\n                mut cs := []\n                for c in vs {\n                  mut fs := []\n                  for ft in c.types {\n                    mut fs.push(smt.field_sort(mut vc, ft))\n                  }\n                  mut cs.push((n + \".\" + c.name, fs))\n                }\n                smt.set_datatype(mut vc, i, cs)\n              },\n              None => (),\n            }\n            Some(smt.sym(n))\n          },\n          None => Some(smt.opaque_sort(mut vc, text.type_text(st))),\n        }\n      },\n    },\n  }\n}","old_text":"/// The SMT sort of the values of `t`.\nfn sort_of(mut vc: smt.Vc, t: ast.TypeExpr) -> Option[String] {\n  if smt.sized(mut vc, t) {\n    return Some(\"Int\")\n  }\n  st := smt.sort_type(vc, t)\n  match st {\n    ast.UnitType => {\n      match smt.new_datatype(mut vc, \"T:Unit\") {\n        Some(i) => smt.set_datatype(mut vc, i, [(\"T:Unit.unit\", [])]),\n        None => (),\n      }\n      Some(smt.sym(\"T:Unit\"))\n    },\n    ast.FnType { .. } => Some(smt.opaque_sort(mut vc, \"Fn\")),\n    ast.Refined { base, .. } => smt.sort_of(mut vc, base),\n    ast.UnionType(ms) => {\n      gs := smt.union_groups(vc, ms)?\n      mut sorts := []\n      for g in gs {\n        mut sorts.push(smt.field_sort(mut vc, g.ty))\n      }\n      n := \"T:Union(\" + smt.bare(join(sorts, \",\")) + \")\"\n      match smt.new_datatype(mut vc, n) {\n        Some(i) => {\n          mut cs := []\n          for (k, s) in enumerate(sorts) {\n            mut cs.push((n + \".\" + f\"{k}\", [s]))\n          }\n          smt.set_datatype(mut vc, i, cs)\n        },\n        None => (),\n      }\n      Some(smt.sym(n))\n    },\n    ast.Named { name, args } => match name {\n      \"Int\" | \"Bool\" | \"String\" => Some(name),\n      \"Dict\" | \"Set\" => match smt.map_sorts(mut vc, st) {\n        Some(ms) => Some(ms.arr),\n        None => Some(smt.opaque_sort(mut vc, name)),\n      },\n      \"Float\" | \"_\" => Some(smt.opaque_sort(mut vc, name)),\n      \"List\" => match get(args, 0) {\n        Some(a) => {\n          item := smt.field_sort(mut vc, a)\n          n := \"T:List(\" + smt.bare(item) + \")\"\n          if !contains(vc.sort_index, n) {\n            mut vc.sort_index.insert(n, len(vc.sorts))\n            mut vc.sorts.push((n, smt.ListSort(item)))\n          }\n          Some(smt.sym(n))\n        },\n        None => Some(smt.opaque_sort(mut vc, \"List\")),\n      },\n      \"Tuple\" => {\n        n := smt.dt_name(st)\n        match smt.new_datatype(mut vc, n) {\n          Some(i) => {\n            mut fs := []\n            for a in args {\n              mut fs.push(smt.field_sort(mut vc, a))\n            }\n            smt.set_datatype(mut vc, i, [(n + \".mk\", fs)])\n          },\n          None => (),\n        }\n        Some(smt.sym(n))\n      },\n      // (a datatype declared already: its constructors aren't made again)\n      _ => if contains(vc.sort_index, smt.dt_name(st)) {\n        Some(smt.sym(smt.dt_name(st)))\n      } else {\n        match smt.variants_of(vc, name, args) {\n          Some(vs) => {\n            n := smt.dt_name(st)\n            match smt.new_datatype(mut vc, n) {\n              Some(i) => {\n                mut cs := []\n                for c in vs {\n                  mut fs := []\n                  for ft in c.types {\n                    mut fs.push(smt.field_sort(mut vc, ft))\n                  }\n                  mut cs.push((n + \".\" + c.name, fs))\n                }\n                smt.set_datatype(mut vc, i, cs)\n              },\n              None => (),\n            }\n            Some(smt.sym(n))\n          },\n          None => Some(smt.opaque_sort(mut vc, text.type_text(st))),\n        }\n      },\n    },\n  }\n}"},{"name":"smt.sized","kind":"fn","old":"c6547af0a988e00f","new":"3e63044495f48b4a","interface_changed":true,"affected":["smt.sort_of","smt.shape","smt.merge","smt.eq","smt.field_sort","smt.valid_term","smt.from_term","smt.unfold","smt.merge_data","smt.part","smt.map_sorts","smt.term_of","smt.receiver_term","smt.rec_call","smt.pure_term","smt.applied_def","smt.havoc","smt.call_exprs","smt.call","smt.call_contract","smt.template","smt.fn_value","smt.builtin","smt.havoc_loop","smt.call_value","smt.field","smt.ctor","smt.pattern","smt.element_inner","smt.element_at_inner","smt.positions_either","smt.leave_loop","smt.branches_narrowed","smt.merge_union","smt.binary","smt.eq_lists","smt.eq_union","smt.same_call","smt.same_lists","smt.alias_lists","smt.define_fn","smt.check_type","smt.check_type_at","smt.map_store","smt.map_empty","smt.map_op","smt.map_instance","smt.rec_use","smt.force","smt.fresh_keyed","smt.map_of","smt.map_literal","smt.item_of","smt.map_key","smt.map_entry","smt.open_map","smt.ctor_terms","smt.def_call","smt.refresh","smt.function","smt.inputs","smt.eval_expr","smt.static_call","smt.apply","smt.method_call","smt.fn_name_value","smt.instance","smt.infer_invariants","smt.while_loop","smt.for_loop","smt.plain_loop","smt.stmt","smt.ctor_pattern","smt.element","smt.item_at","smt.element_at","smt.branches","smt.different","smt.eq_list_values","smt.write_back","smt.anno