nclosing scope.\ntype Scope = {\n  vars: Dict[String, codegen.Local],\n  owned: List[codegen.Local],\n  temps: List[codegen.V],\n  transparent: Bool,\n  // a `scope`'s tasks (\"\" for other scopes): they end before it does\n  tasks: String,\n  // variables whose value is a block on the stack (`stack_block`), with\n  // their field types: ending the scope drops only the fields\n  stacked: Dict[String, List[Ty]],\n}"},{"name":"codegen.push_transparent","kind":"fn","old":"2fb16fb67ca3a7a2","new":"1743c3e62d477b17","interface_changed":false,"affected":[],"module":"codegen","text":"/// Pushes a statement's or a branch's scope.\nfn push_transparent(mut g: codegen.Gen) {\n  mut g.scopes.push(\n    codegen.Scope {\n      vars: Dict[String, codegen.Local] {},\n      owned: [],\n      temps: [],\n      transparent: true,\n      tasks: \"\",\n      stacked: Dict[String, List[check.Ty]] {},\n    },\n  )\n}","old_text":"/// Pushes a statement's or a branch's scope.\nfn push_transparent(mut g: codegen.Gen) {\n  mut g.scopes.push(\n    codegen.Scope {\n      vars: Dict[String, codegen.Local] {},\n      owned: [],\n      temps: [],\n      transparent: true,\n      tasks: \"\",\n      stacked: Dict[String, List[Ty]] {},\n    },\n  )\n}"},{"name":"codegen.no_scope","kind":"fn","old":"a9214c7d5ccd109a","new":"bb8cab0079a2abeb","interface_changed":false,"affected":[],"module":"codegen","text":"fn no_scope() -> codegen.Scope {\n  codegen.Scope {\n    vars: Dict[String, codegen.Local] {},\n    owned: [],\n    temps: [],\n    transparent: false,\n    tasks: \"\",\n    stacked: Dict[String, List[check.Ty]] {},\n  }\n}","old_text":"fn no_scope() -> codegen.Scope {\n  codegen.Scope {\n    vars: Dict[String, codegen.Local] {},\n    owned: [],\n    temps: [],\n    transparent: false,\n    tasks: \"\",\n    stacked: Dict[String, List[Ty]] {},\n  }\n}"},{"name":"codegen.counted","kind":"fn","old":"5765f03d11c16ab6","new":"7634467eee0ae3f1","interface_changed":true,"affected":["codegen.own_slot",