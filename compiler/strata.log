ine","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.order_closure","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields","codegen.read_back","eval_files"],"module":"codegen","text":"/// `[a, b, c]` with elements of type `want`, when known.\nfn list_literal_of(\n  mut g: codegen.Gen,\n  es: List[ast.Expr],\n  want: check.Ty,\n) -> codegen.V {\n  // each element is wanted like those before it, which types a lambda's\n  // parameters\n  mut et := want\n  mut vs := []\n  // an element that borrows is held when a later one may assign\n  // (`[xs, { xs = []; [] }]`)\n  mut later := es.map(_ -> false)\n  mut k := len(es) - 2\n  while k >= 0 {\n    later = take(later, k)\n      + [get(later, k + 1) ?? false\n        || codegen.assigns(get(es, k + 1) ?? ast.UnitExpr)]\n      + drop(later, k + 1)\n    k -= 1\n  }\n  for (i, x) in enumerate(es) {\n    v := codegen.expr_want(mut g, x, et)\n    if v.ty is check.TAny {\n      return codegen.never()\n    }\n    et = codegen.better(et, v.ty)\n    mut vs.push(\n      if get(later, i) ?? false {\n        codegen.hold(mut g, v)\n      } else {\n        v\n      },\n    )\n  }\n  // elements of different types (`[\"a\", 1]`) make a list of their union\n  if want is check.TAny {\n    hs := vs.map(v -> codegen.head_of(v.ty))\n    first := get(hs, 0) ?? \"\"\n    if hs.any(h -> h != first) && !hs.any(h -> starts_with(h, \"?\")) {\n      et = codegen.union_ty(vs.map(v -> v.ty))\n      mut us := []\n      for v in vs {\n        mut us.push(codegen.converted(mut g, v, et))\n      }\n      vs = us\n    }\n  }\n  match codegen.constant_list(mut g, vs, et) {\n    Some(c) => return c,\n    None => (),\n  }\n  l := codegen.call(\n    mut g,\n    check.TList(et),\n    \"strata_list_new\",\n    [codegen.V { ty: check.TInt, op: to_string(len(vs)) }],\n  )\n  // `[]`: a new empty list\n  if vs == [] {\n    return l\n  }\n  (bp, buf, data) := (\n    codegen.fresh(mut g, \"bufp\"),\n    codegen.fresh(mut g, \"buf\"),\n    codegen.fresh(mut g, \"data\"),\n  )\n  codegen.emit(mut g, f\"{bp} = getelementptr i8, ptr {l.op}, i64 8\")\n  codegen.emit(mut g, f\"{buf} = load ptr, ptr {bp}\")\n  codegen.emit(\n    mut g,\n    f\"{data} = getelementptr i64, ptr {buf}, i64 2\",\n  )\n  for (k, v) in enumerate(vs) {\n    x := codegen.take_value(mut g, v)\n    at := codegen.fresh(mut g, \"at\")\n    codegen.emit(\n      mut g,\n      f\"{at} = getelementptr i64, ptr {data}, i64 {k}\",\n    )\n    codegen.store_slot(mut g, x, at)\n  }\n  up := codegen.fresh(mut g, \"usedp\")\n  codegen.emit(mut g, f\"{up} = getelementptr i8, ptr {buf}, i64 8\")\n  codegen.emit(mut g, f\"store i64 {len(vs)}, ptr {up}\")\n  codegen.emit(mut g, f\"store i64 {len(vs)}, ptr {l.op}\")\n  l\n}","old_text":"/// `[a, b, c]` with elements of type `want`, when known.\nfn list_literal_of(\n  mut g: codegen.Gen,\n  es: List[ast.Expr],\n  want: Ty,\n) -> codegen.V {\n  // each element is wanted like those before it, which types a lambda's\n  // parameters\n  mut et := want\n  mut vs := []\n  // an element that borrows is held when a later one may assign\n  // (`[xs, { xs = []; [] }]`)\n  mut later := es.map(_ -> false)\n  mut k := len(es) - 2\n  while k >= 0 {\n    later = take(later, k)\n      + [get(later, k + 1) ?? false\n        || codegen.assigns(get(es, k + 1) ?? ast.UnitExpr)]\n      + drop(later, k + 1)\n    k -= 1\n  }\n  for (i, x) in enumerate(es) {\n    v := codegen.expr_want(mut g, x, et)\n    if v.ty is TAny {\n      return codegen.never()\n    }\n    et = codegen.better(et, v.ty)\n    mut vs.push(\n      if get(later, i) ?? false {\n        codegen.hold(mut g, v)\n      } else {\n        v\n      },\n    )\n  }\n  // elements of different types (`[\"a\", 1]`) make a list of their union\n  if want is TAny {\n    hs := vs.map(v -> codegen.head_of(v.ty))\n    first := get(hs, 0) ?? \"\"\n    if hs.any(h -> h != first) && !hs.any(h -> starts_with(h, \"?\")) {\n      et = codegen.union_ty(vs.map(v -> v.ty))\n      mut us := []\n      for v in vs {\n        mut us.push(codegen.converted(mut g, v, et))\n      }\n      vs = us\n    }\n  }\n  match codegen.constant_list(mut g, vs, et) {\n    Some(c) => return c,\n    None => (),\n  }\n  l := codegen.call(\n    mut g,\n    TList(et),\n    \"strata_list_new\",\n    [codegen.V { ty: TInt, op: to_string(len(vs)) }],\n  )\n  // `[]`: a new empty list\n  if vs == [] {\n    return l\n  }\n  (bp, buf, data) := (\n    codegen.fresh(mut g, \"bufp\"),\n    codegen.fresh(mut g, \"buf\"),\n    codegen.fresh(mut g, \"data\"),\n  )\n  codegen.emit(mut g, f\"{bp} = getelementptr i8, ptr {l.op}, i64 8\")\n  codegen.emit(mut g, f\"{buf} = load ptr, ptr {bp}\")\n  codegen.emit(\n    mut g,\n    f\"{data} = getelementptr i64, ptr {buf}, i64 2\",\n  )\n  for (k, v) in enumerate(vs) {\n    x := codegen.take_value(mut g, v)\n    at := codegen.fresh(mut g, \"at\")\n    codegen.emit(\n      mut g,\n      f\"{at} = getelementptr i64, ptr {data}, i64 {k}\",\n    )\n    codegen.store_slot(mut g, x, at)\n  }\n  up := codegen.fresh(mut g, \"usedp\")\n  codegen.emit(mut g, f\"{up} = getelementptr i8, ptr {buf}, i64 8\")\n  codegen.emit(mut g, f\"store i64 {len(vs)}, ptr {up}\")\n  codegen.emit(mut g, f\"store i64 {len(vs)}, ptr {l.op}\")\n  l\n}"},{"name":"codegen.head_of","kind":"fn","old":"3a5e811968cff063","new":"d4437945fc50387d","interface_changed":true,"affected":["codegen.call_named","codegen.show","co