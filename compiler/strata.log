 => find(ms, m -> m is check.TInt),\n    ast.StrPat(_) => find(ms, m -> m is check.TStr),\n    ast.BoolPat(_) => find(ms, m -> m is check.TBool),\n    ast.ListPat { .. } => find(ms, m -> m is check.TList),\n    ast.TuplePat(_) => find(ms, m -> codegen.head_of(m) == \"Tuple\"),\n    ast.CtorPattern { name, .. } => match codegen.member_named(g, ms, name) {\n      Some(m) => Some(m),\n      // a refined type's name (`Positive`): its base's member\n      None => match get(g.refines, name) {\n        Some((base, _)) => find(\n          ms,\n          m -> codegen.head_of(m) == codegen.texpr_head(base),\n        ),\n        None => None,\n      },\n    },\n    _ => None,\n  }\n}","old_text":"/// The member whose values a pattern matches, if it names one.\nfn pattern_member(g: codegen.Gen, ms: List[Ty], p: ast.Pattern) -> Option[Ty] {\n  match p {\n    ast.IntPat(_) => find(ms, m -> m is TInt),\n    ast.StrPat(_) => find(ms, m -> m is TStr),\n    ast.BoolPat(_) => find(ms, m -> m is TBool),\n    ast.ListPat { .. } => find(ms, m -> m is TList),\n    ast.TuplePat(_) => find(ms, m -> codegen.head_of(m) == \"Tuple\"),\n    ast.CtorPattern { name, .. } => match codegen.member_named(g, ms, name) {\n      Some(m) => Some(m),\n      // a refined type's name (`Positive`): its base's member\n      None => match get(g.refines, name) {\n        Some((base, _)) => find(\n          ms,\n          m -> codegen.head_of(m) == codegen.texpr_head(base),\n        ),\n        None => None,\n      },\n    },\n    _ => None,\n  }\n}"},{"name":"codegen.type_pattern","kind":"fn","old":"2f203fe04252f042","new":"d13ece2897965606","interface_changed":true,"affected":["codegen.matches","codegen.binds","codegen.destructure","codegen.for_loop","codegen.matching_v","codegen.match_got","codegen.stmt_node","codegen.matching_want","codegen.stmt","codegen.matching","codegen.expr_want_node","codegen.block_expr","codegen.iterate","codegen.decreases_start","codegen.decreases_pass","codegen.decreases_entry","cod