re","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"/// The symbol of function `k`'s instance for these type arguments. Queues\n/// it on first request.\nfn instance(\n  mut g: codegen.Gen,\n  k: String,\n  f: ast.FnDecl,\n  sub: Dict[String, check.Ty],\n) -> String {\n  sym := codegen.inst_sym(k, f, sub)\n  codegen.add_caller(mut g, k)\n  // std's precompiled code: declared only\n  if contains(g.precompiled, k) && len(f.type_params) == 0 {\n    if !codegen.has_helper(g, \"precompiled:\" + sym) {\n      codegen.add_helper(mut g, \"precompiled:\" + sym)\n      line := codegen.declaration_of(mut g, sym, f)\n      mut g.globals.push(line)\n    }\n    return sym\n  }\n  if !contains(g.instances, sym) && !contains(g.new_instances, sym) {\n    if g.owner == \"\" {\n      mut g.instances.insert(sym)\n    } else {\n      mut g.new_instances.push(sym)\n    }\n    mut g.queue.push((k, sub))\n  }\n  sym\n}","old_text":"/// The symbol of function `k`'s instance for these type arguments. Queues\n/// it on first request.\nfn instance(\n  mut g: codegen.Gen,\n  k: String,\n  f: ast.FnDecl,\n  sub: Dict[String, Ty],\n) -> String {\n  sym := codegen.inst_sym(k, f, sub)\n  codegen.add_caller(mut g, k)\n  // std's precompiled code: declared only\n  if contains(g.precompiled, k) && len(f.type_params) == 0 {\n    if !codegen.has_helper(g, \"precompiled:\" + sym) {\n      codegen.add_helper(mut g, \"precompiled:\" + sym)\n      line := codegen.declaration_of(mut g, sym, f)\n      mut g.globals.push(line)\n    }\n    return sym\n  }\n  if !contains(g.instances, sym) && !contains(g.new_instances, sym) {\n    if g.owner == \"\" {\n      mut g.instances.insert(sym)\n    } else {\n      mut g.new_instances.push(sym)\n    }\n    mut g.queue.push((k, sub))\n  }\n  sym\n}"},{"name":"codegen.call_fn","kind":"fn","old":"70f6a1f601f611b6","new":"cbfc93a077c50b1d","interface_changed":false,"affected":[],"module":"codegen","text":"/// A call of the program's function `k`, with `done` already evaluated,\n/// then `rest`. Each argument gets its parameter's wanted type, which a\n/// lambda's parameter types come from. Type parameters bind from the\n/// arguments, left to right.\nfn call_fn(\n  mut g: codegen.Gen,\n  k: String,\n  done: List[codegen.V],\n  rest: List[ast.Expr],\n) -> codegen.V {\n  codegen.call_fn_want(mut g, k, done, rest, check.TAny)\n}","old_text":"/// A call of the program's function `k`, with `done` already evaluated,\n/// then `rest`. Each argument gets its parameter's wanted type, which a\n/// lambda's parameter types come from. Type parameters bind from the\n/// arguments, left to right.\nfn call_fn(\n  mut g: codegen.Gen,\n  k: String,\n  done: List[codegen.V],\n  rest: List[ast.Expr],\n) -> codegen.V {\n  codegen.call_fn_want(mut g, k, done, rest, TAny)\n}"},{"name":"codegen.expr_want","kind":"fn","old":"91d2645c3658fdf2","new":"c041ad0d49ab952b","interface_changed":true,"affected":["codegen.function","codegen.binary","codegen.declare","codegen.destructure","codegen.block_expr","codegen.call_fn_want","codegen.builtin_call","codegen.list_literal_of","codegen.method_call","codegen.dyn_call","codegen.scope_expr","codegen.channel_new","codegen.select_expr","codegen.fuzz_driver","codegen.construct_want","codegen.operands_want","codegen.wanted","codegen.try_want","codegen.lambda_shown","codegen.or_else","codegen.list_get_or","codegen.match_got","codegen.checked_update","codegen.appended","codegen.expr_node","codegen.compared","codegen.stmt_node","codegen.build_fn","codegen.push_in_place","codegen.compiled_alone","codegen.expr_want_node","codegen.call_named","codegen.call_fn","codegen.options","codegen.clock_now","codegen.regex_matches","codegen.type_check","codegen.by_variant","codegen.except_expr","codegen.matching_want","codegen.list_literal","codegen.generate","codegen.construct","codegen.operands","codegen.branch_value","codegen.mock_call","codegen.try_