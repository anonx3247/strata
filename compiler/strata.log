v,\n  }\n}","old_text":"/// `v` as a value of type `t`. An `Int` where a sized integer is wanted (an\n/// integer literal typed by its place) becomes one. Any other value is\n/// unchanged.\nfn as_type(mut g: codegen.Gen, v: codegen.V, t: Ty) -> codegen.V {\n  match (codegen.sized(t), v.ty) {\n    (Some(w), TInt) => match parse_int(v.op) {\n      Some(n) => codegen.V { ty: t, op: to_string(codegen.word_const(w, n)) },\n      None => {\n        b := codegen.raw_call(mut g, \"strata_int_bits\", [v.op])\n        codegen.V { ty: t, op: codegen.narrow_op(mut g, w, b) }\n      },\n    },\n    _ => v,\n  }\n}"},{"name":"codegen.narrow","kind":"fn","old":"5068204855171dbc","new":"edd45eaa4242ca18","interface_changed":true,"affected":["codegen.matches","codegen.binds","codegen.union_text","codegen.union_eq","codegen.union_cmp","codegen.union_call","codegen.check_union","codegen.if_want","codegen.matching_v","codegen.destructure","codegen.for_loop","codegen.match_got","codegen.helper","codegen.cmp_helper","codegen.method_call","codegen.check_type","codegen.if_expr","codegen.expr_want_node","codegen.matching_want","codegen.stmt_node","codegen.show","codegen.shown","codegen.equal","codegen.order_closure","codegen.cmp_fields","codegen.slot_fn","codegen.compare_values","codegen.expr_node","codegen.function","codegen.declare","codegen.call_fn_want","codegen.check_payload","codegen.construct_want","codegen.check_field","codegen.assign_at","codegen.lambda_shown","codegen.set_in_place","codegen.checked_update","codegen.expr_want","codegen.matching","codegen.stmt","codegen.entry","codegen.interp","codegen.builtin","codegen.string_builtin","codegen.format_spec","codegen.dyn_wrapper","codegen.debug_fields","codegen.debug_list","codegen.checked","codegen.fail_unless","codegen.check_requires","codegen.check_ensures","codegen.fuzz_driver","codegen.trace_enter","codegen.trace_leave","codegen.type_check","codegen.index_check","codegen.decreases_fault","codegen.apply","codegen.eq_fields","cod