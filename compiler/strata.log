n.union_text","codegen.debug_fields","codegen.debug_list","codegen.fail_unless","codegen.trace_enter","codegen.trace_leave","codegen.index_check","codegen.decreases_fault","codegen_file","jit_file","fuzz_file","alongside_command","literal_errors_of","verify_file","graph_runs","replay","or_solver_inputs","strata_command","check_command","verify_command","build_command","run_command","static_graph","program_objects","comptime_values","codegen.helper","codegen.debug_body","command_line","call_command","loaded_errors","edit_file","file_errors","edit_errors","build_proofs","search_invariants","check_fn","graph_command","graph_diff","linked","expanded","comptime_runner","codegen.equal","main","package_errors","edit_command","check_files","apply_change","apply_edit","fix_loops","with_base","codegen.apply","codegen.eq_fields","codegen.eq_list","codegen.union_eq","codegen.slot_fn","codegen.new_gen","eval.run","rename_command","move_command","fix_command","edit_in_editor","codegen.number_builtin","codegen.eq_body","codegen.cmp_helper","codegen.table_fns","codegen.hash_helper","codegen.read_back","eval_files","codegen.cmp_fields","codegen.union_cmp","codegen.compare_values","codegen.table_from","codegen.hash_fields"],"module":"codegen","text":"fn is_task(t: check.Ty) -> Bool {\n  match t {\n    check.TNamed { name: \"Task\", .. } => true,\n    _ => false,\n  }\n}","old_text":"fn is_task(t: Ty) -> Bool {\n  match t {\n    TNamed { name: \"Task\", .. } => true,\n    _ => false,\n  }\n}"},{"name":"codegen.share_value","kind":"fn","old":"15e63cec8bf8298d","new":"7f68d8eb91eda5e0","interface_changed":false,"affected":[],"module":"codegen","text":"/// Marks `v` shared between threads, with everything it reaches (core.rt's\n/// `strata_share`, the `share:T` helpers): it is about to cross to another\n/// thread (captured by a task, sent on a channel). The walk stops at\n/// objects marked already, which reach only marked ones, so each object is\n/// walked once whatever crosses how often.\nfn share_value(mut g: codegen.Gen, v: codegen.V) {\n  if !codegen.crosses(v.ty) || codegen.constant(v.op) {\n    return\n  }\n  if codegen.is_collection(v.ty) {\n    return codegen.share_value(\n      mut g,\n      codegen.V { ..v, ty: codegen.repr(v.ty) },\n    )\n  }\n  match v.ty {\n    check.TInt => {\n      codegen.use_rt(mut g, \"strata_int_share\")\n      codegen.emit(\n        mut g,\n        f\"call void @strata_int_share(i64 {v.op})\",\n      )\n    },\n    check.TStr | check.TNamed { name: \"Sender\", .. } | check.TNamed { name: \"Receiver\", .. } => {\n      codegen.use_rt(mut g, \"strata_share\")\n      r := codegen.fresh(mut g, \"marked\")\n      codegen.emit(\n        mut g,\n        f\"{r} = call i1 @strata_share(ptr {v.op})\",\n      )\n    },\n    check.TList(_) | check.TNamed { .. } | check.TUnion(_) | check.TFn { .. } | check.TTrait(_) => {\n      f := codegen.share_fn(mut g, v.ty)\n      codegen.emit(mut g, f\"call void {f}(ptr {v.op})\")\n    },\n    _ => {\n      // (a type with no walk: every object counted atomically instead)\n      codegen.use_rt(mut g, \"strata_share_unknown\")\n      codegen.emit(mut g, \"call void @strata_share_unknown()\")\n    },\n  }\n}","old_text":"/// Marks `v` shared between threads, with everything it reaches (core.rt's\n/// `strata_share`, the `share:T` helpers): it is about to cross to another\n/// thread (captured by a task, sent on a channel). The walk stops at\n/// objects marked already, which reach only marked ones, so each object is\n/// walked once whatever crosses how often.\nfn share_value(mut g: codegen.Gen, v: codegen.V) {\n  if !codegen.crosses(v.ty) || codegen.constant(v.op) {\n    return\n  }\n  if codegen.is_collection(v.ty) {\n    return codegen.share_value(\n      mut g,\n      codegen.V { ..v, ty: codegen.repr(v.ty) },\n    )\n  }\n  match v.ty {\n    TInt => {\n      codegen.use_rt(mut g, \"strata_int_share\")\n      codegen.emit(\n        mut g,\n        f\"call void @strata_int_share(i64 {v.op})\",\n      )\n    },\n    TStr | TNamed { name: \"Sender\", .. } | TNamed { name: \"Receiver\", .. } => {\n      codegen.use_rt(mut g, \"strata_share\")\n      r := codegen.fresh(mut g, \"marked\")\n      codegen.emit(\n        mut g,\n        f\"{r} = call i1 @strata_share(ptr {v.op})\",\n      )\n    },\n    TList(_) | TNamed { .. } | TUnion(_) | TFn { .. } | TTrait(_) => {\n      f := codegen.share_fn(mut g, v.ty)\n      codegen.emit(mut g, f\"call void {f}(ptr {v.op})\")\n    },\n    _ => {\n      // (a type with no walk: every object counted atomically instead)\n      codegen.use_rt(mut g, \"strata_share_unknown\")\n      codegen.emit(mut g, \"call void @strata_share_unknown()\")\n    },\n  }\n}"},{"name":"codegen.share_fn","kind":"fn","old":"1876c307154bf10a","new":"50c454bbc7261482","interface_changed":true,"affected":["codegen.share_value","codegen.tail_share","codegen.closure","codegen.dyn_wrapper","codegen.spawn_expr","codegen.await_one","codegen.channel_op","codegen.select_expr","codegen.share_held","codegen.share_fields","codegen.order_closure","codegen.lambda_shown","codegen.vtable","codegen.race_expr","codegen.expr_node","codegen.await_expr","codegen.await_list","codegen.builtin","codegen.builtin_call","codegen.function_value","codegen.lambda","codegen.to_dyn","codegen.dyn_table_is","codegen.expr","codegen.call_named","codegen.push_in_place","codegen.method_call","codegen.except_expr","codegen.matching_want","codegen.expr_want_node","codegen.produce","codegen.method_value","codegen.main_arg","codegen.converted","codegen.session_capability","codegen.dyn_ctor_is","codegen.dyn_generic_call","codegen.matching_v","codegen.interp","codegen.binary","codegen.logic","codegen.destructure","codegen.loop_body","codegen.matches","codegen.for_loop","codegen.checked","codegen.with_it","codegen.check_requires","codegen.check_ensures","codegen.for_list","codegen.mock_method","codegen.call_entry","codegen.construct_want","codegen.operands_want","codegen.type_c