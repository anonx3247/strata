{
  "name": "strata",
  "displayName": "Strata",
  "scopeName": "source.strata",
  "aliases": ["st"],
  "patterns": [{ "include": "#code" }],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "name": "variable.other.hole.strata", "match": "\\?[a-z_][a-z0-9_]*" },
        { "name": "constant.numeric.strata", "match": "\\b(0x[0-9a-fA-F_]+|0b[01_]+|\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d+)?)\\b" },
        { "name": "keyword.control.strata", "match": "\\b(if|else|match|for|in|while|loop|return|break|continue|scope|spawn|await|select|race|supervised|or|except|is|as)\\b" },
        { "name": "keyword.other.contract.strata", "match": "\\b(requires|ensures|where|invariant|decreases|law|assert|test|mock|terminates)\\b" },
        { "name": "storage.type.strata", "match": "\\b(fn|type|trait|impl|let|mut|pub|use|distinct|derive|derivable|derived|comptime|extern|module|const)\\b" },
        { "name": "constant.language.strata", "match": "\\b(true|false|None|it|self|Self)\\b" },
        { "name": "entity.name.function.strata", "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()" },
        { "name": "entity.name.type.strata", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" },
        { "name": "keyword.operator.strata", "match": "==>|=>|->|:=|\\.\\.=?|[-+*/%=!<>&|^]=?|\\?" }
      ]
    },
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.strata", "match": "///.*$" },
        { "name": "comment.line.double-slash.strata", "match": "//.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.strata",
          "begin": "f\"", "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.strata", "match": "\\\\." },
            { "name": "meta.interpolation.strata", "begin": "\\{", "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.strata" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.strata" } },
              "patterns": [{ "include": "#code" }] }
          ]
        },
        {
          "name": "string.quoted.double.strata",
          "begin": "\"", "end": "\"",
          "patterns": [{ "name": "constant.character.escape.strata", "match": "\\\\." }]
        }
      ]
    }
  }
}
