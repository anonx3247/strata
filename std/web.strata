// std.web — HTML pages, built as values.
//
// A page is a tree of `Html` values, made with one function per element and
// turned into text by `render` (or `document`, for a whole page):
//
//   use std.web.{Html, div, h1, p, text, class, document}
//
//   fn greeting(name: String) -> Html[()] {
//     div([class("greeting")], [h1([], [text(f"Hello, {name}!")]), p([], [text("Welcome.")])])
//   }
//
//   print(document("Hello", [], [greeting("<Ada>")]))
//
// Text is always escaped, so `<Ada>` shows as written and can't inject markup.
// Tag and attribute names are checked where they are written (`element`,
// `attr`), and an attribute can't be an inline script (`onclick`): events are `on(event, msg)` attributes,
// whose message is a value of the page's message type `M`, written as JSON
// for the runtime to send back. A page with no events uses `Html[()]`.

/// An element's name: lowercase letters, digits and dashes (`div`,
/// `my-card`).
pub type TagName = String
  where matches(it, "[a-z][a-z0-9]*(-[a-z0-9]+)*")

/// An attribute's name. Names starting with `on` are inline scripts, which
/// pages can't contain: use `on(event, msg)` instead.
pub type AttrName = String
  where matches(it, "[a-zA-Z_:][-a-zA-Z0-9_:.]*")
    && !matches(it, "[oO][nN].*")

/// The name of a DOM event, without `on`: `click`, `submit`, `input`.
pub type EventName = String
  where matches(it, "[a-z]+")

/// A piece of HTML whose events carry messages of type `M`. Only this
/// module's functions make one, so its names are checked once, where it is
/// made (`element`, `attr`), and the type itself has nothing to check.
pub type Html[M] = { node: Node[M] }

/// What an `Html` holds. Private: other modules can't build one directly.
type Node[M] =
  | Element { tag: String, attrs: List[Attr[M]], children: List[Html[M]] }
  | Text { text: String }

/// An attribute of an element. Made by `attr`, `flag` and `on`.
pub type Attr[M] = { kind: AttrKind[M] }

/// `name="value"`, a flag without a value (such as `disabled`), an event
/// whose message the runtime sends back to the program when it happens, or
/// an event whose message is made from what the user entered: the field's
/// value (`OnValue`) or a form's fields by name (`OnForm`).
type AttrKind[M] =
  | Attribute { name: String, value: String }
  | Flag { name: String }
  | On { event: String, msg: M }
  | OnValue { event: String, make: (String) -> M }
  | OnForm { event: String, make: (Dict[String, String]) -> M }

/// A function that makes a message from what the user entered.
type Handler[M] =
  | ValueHandler { make: (String) -> M }
  | FormHandler { make: (Dict[String, String]) -> M }

// ---- rendering ----

/// `s` with `&`, `<` and `>` escaped, for text between tags.
pub fn escape_text(s: String) -> String {
  replace(
    replace(replace(s, "&", "&amp;"), "<", "&lt;"),
    ">",
    "&gt;",
  )
}

/// `s` escaped for an attribute value between double quotes.
pub fn escape_attr(s: String) -> String {
  replace(escape_text(s), "\"", "&quot;")
}

/// Elements that have no children and no closing tag.
pub fn is_void(tag: String) -> Bool {
  matches(
    tag,
    "area|base|br|col|embed|hr|img|input|link|meta|source|track|wbr",
  )
}

/// One attribute as written in a start tag. Handlers can't be written into
/// the page: they are numbered in the order they appear (`next`), and the
/// page sends back the number (`data-handle-input="3"`); see `dispatch`.
fn render_attr[M](a: Attr[M], mut next: Int) -> String {
  match a.kind {
    Attribute { name, value } => f"{name}=\"{escape_attr(value)}\"",
    Flag { name } => name,
    On { event, msg } => f"data-on-{event}=\"{escape_attr(to_json(msg))}\"",
    OnValue { event, .. } => {
      next = next + 1
      f"data-handle-{event}=\"{next - 1}\""
    },
    OnForm { event, .. } => {
      next = next + 1
      f"data-handle-{event}=\"{next - 1}\""
    },
  }
}

/// `h` as HTML text.
pub fn render[M](h: Html[M]) -> String {
  let mut next = 0
  render_from(h, mut next)
}

/// `h` as HTML text, its handlers numbered from `next`.
fn render_from[M](h: Html[M], mut next: Int) -> String {
  match h.node {
    Text { text } => escape_text(text),
    Element { tag, attrs, children } => {
      let mut out = "<" + tag
      for a in attrs {
        out = out + " " + render_attr(a, mut next)
      }
      out = out + ">"
      if is_void(tag) {
        return out
      }
      for c in children {
        out = out
          + match c.node {
            // the text inside a `<style>` element isn't escaped (CSS uses `>`),
            // but it can't close the element early
            Text { text } => if tag == "style" {
              replace(text, "</", "<\/")
            } else {
              escape_text(text)
            },
            Element { .. } => render_from(c, mut next),
          }
      }
      out + "</" + tag + ">"
    },
  }
}

/// The handlers of `h`, in the order `render` numbers them.
fn handlers[M](h: Html[M]) -> List[Handler[M]] {
  match h.node {
    Text { .. } => [],
    Element { attrs, children, .. } => {
      let mut found: List[Handler[M]] = []
      for a in attrs {
        match a.kind {
          OnValue { make, .. } => {
            found = push(found, ValueHandler { make })
          },
          OnForm { make, .. } => {
            found = push(found, FormHandler { make })
          },
          _ => (),
        }
      }
      for c in children {
        found = found + handlers(c)
      }
      found
    },
  }
}

/// The message handler number `id` of the page `h` makes from what the user
/// entered: a field's `value`, or a form's `fields` by name. `None` if the
/// page has no such handler. The runtime calls it with the page the user
/// sees (the view of the current model) when a `data-handle-…` event comes.
pub fn dispatch[M](
  h: Html[M],
  id: Int,
  value: String,
  fields: Dict[String, String],
) -> Option[M] {
  match get(handlers(h), id) {
    Some(ValueHandler { make }) => Some(make(value)),
    Some(FormHandler { make }) => Some(make(fields)),
    None => None,
  }
}

/// A whole page: the doctype, a `<head>` with the title and `head`, and a
/// `<body>` holding `body`.
pub fn document[M](
  title_text: String,
  head_items: List[Html[M]],
  body_items: List[Html[M]],
) -> String {
  let meta_charset: Html[M] = element("meta", [attr("charset", "utf-8")], [])
  let meta_viewport: Html[M] = element("meta", [
    attr("name", "viewport"),
    attr("content", "width=device-width, initial-scale=1"),
  ], [])
  let head: Html[M] = element(
    "head",
    [],
    [meta_charset, meta_viewport, title([], [text(title_text)])]
      + head_items,
  )
  let body: Html[M] = element("body", [], body_items)
  "<!DOCTYPE html>\n"
    + render(element("html", [], [head, body]))
    + "\n"
}

// ---- elements ----

/// Any element. Void elements (`br`, `img`, `input`, …) can't have children
/// (the condition is `is_void`, written out so the prover sees it).
pub fn element[M](
  tag: TagName,
  attrs: List[Attr[M]],
  children: List[Html[M]],
) -> Html[M]
  requires len(children) == 0
    || !matches(
      tag,
      "area|base|br|col|embed|hr|img|input|link|meta|source|track|wbr",
    ) {
  Html { node: Element { tag, attrs, children } }
}

/// Text, escaped when rendered.
pub fn text[M](s: String) -> Html[M] {
  Html { node: Text { text: s } }
}

/// A `<style>` element holding a style sheet.
pub fn style_sheet[M](css: String) -> Html[M] {
  element("style", [], [text(css)])
}

/// A `<link rel="stylesheet">` to the style sheet at `url`.
pub fn style_link[M](url: String) -> Html[M] {
  element(
    "link",
    [attr("rel", "stylesheet"), attr("href", url)],
    [],
  )
}

pub fn title[M](attrs: List[Attr[M]], children: List[Html[M]]) -> Html[M] {
  element("title", attrs, children)
}

pub fn div[M](attrs: List[Attr[M]], children: List[Html[M]]) -> Html[M] {
  element("div", attrs, children)
}

pub fn span[M](attrs: List[Attr[M]], children: List[Html[M]]) -> Html[M] {
  element("span", attrs, children)
}

pub fn p[M](attrs: List[Attr[M]], children: List[Html[M]]) -> Html[M] {
  element("p", attrs, children)
}

pub fn a[M](attrs: List[Attr[M]], children: List[Html[M]]) -> Html[M] {
  element("a", attrs, children)
}

pub fn h1[M](attrs: List[Attr[M]], children: List[Html[M]]) -> Html[M] {
