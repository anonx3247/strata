pub fn option[M](attrs: List[Attr[M]], children: List[Html[M]]) -> Html[M] {
  element("option", attrs, children)
}

/// An `<input>`: a void element, so it has attributes only.
pub fn input[M](attrs: List[Attr[M]]) -> Html[M] {
  element("input", attrs, [])
}

/// An `<img>`: a void element, so it has attributes only.
pub fn img[M](attrs: List[Attr[M]]) -> Html[M] {
  element("img", attrs, [])
}

/// A line break.
pub fn br[M]() -> Html[M] {
  element("br", [], [])
}

/// A horizontal rule.
pub fn hr[M]() -> Html[M] {
  element("hr", [], [])
}

// ---- attributes ----

/// Any attribute: `name="value"`.
pub fn attr[M](name: AttrName, value: String) -> Attr[M] {
  Attr { kind: Attribute { name, value } }
}

/// An attribute without a value, such as `required`.
pub fn flag[M](name: AttrName) -> Attr[M] {
  Attr { kind: Flag { name } }
}

pub fn class[M](names: String) -> Attr[M] {
  attr("class", names)
}

pub fn id[M](value: String) -> Attr[M] {
  attr("id", value)
}

pub fn href[M](url: String) -> Attr[M] {
  attr("href", url)
}

pub fn src[M](url: String) -> Attr[M] {
  attr("src", url)
}

pub fn alt[M](text: String) -> Attr[M] {
  attr("alt", text)
}

pub fn style[M](css: String) -> Attr[M] {
  attr("style", css)
}

/// The `type` attribute of an `input` or a `button` (`type` is a keyword).
pub fn input_type[M](kind: String) -> Attr[M] {
  attr("type", kind)
}

pub fn name[M](value: String) -> Attr[M] {
  attr("name", value)
}

pub fn value[M](v: String) -> Attr[M] {
  attr("value", v)
}

pub fn placeholder[M](text: String) -> Attr[M] {
  attr("placeholder", text)
}

/// The `for` attribute of a `label` (`for` is a keyword).
pub fn label_for[M](input_id: String) -> Attr[M] {
  attr("for", input_id)
}

pub fn disabled[M]() -> Attr[M] {
  flag("disabled")
}

pub fn checked[M]() -> Attr[M] {
  flag("checked")
}

pub fn required[M]() -> Attr[M] {
  flag("required")
}

// ---- events ----

/// When `event` happens on the element, send `msg` to the program.
pub fn on[M](event: EventName, msg: M) -> Attr[M] {
  Attr { kind: On { event, msg } }
}

/// When the element is clicked, send `msg`.
pub fn on_click[M](msg: M) -> Attr[M] {
  on("click", msg)
}

/// When the form is submitted, send `msg`.
pub fn on_submit[M](msg: M) -> Attr[M] {
  on("submit", msg)
}

/// As the user types in the field (an `input`, a `textarea`), send the
/// message `make` makes from its value: `on_input(s -> SetTitle { title: s
/// })`.
pub fn on_input[M](make: (String) -> M) -> Attr[M] {
  Attr { kind: OnValue { event: "input", make } }
}

/// When the field's value is changed (a `select`, a checkbox: its value is
/// `"true"` or `"false"`), send the message `make` makes from it.
pub fn on_change[M](make: (String) -> M) -> Attr[M] {
  Attr { kind: OnValue { event: "change", make } }
}

/// When the form is submitted, send the message `make` makes from its
/// fields, by name: `on_submit_form(fields -> Add { fields })`. A checkbox
/// that isn't checked is not among them.
pub fn on_submit_form[M](make: (Dict[String, String]) -> M) -> Attr[M] {
  Attr { kind: OnForm { event: "submit", make } }
}
