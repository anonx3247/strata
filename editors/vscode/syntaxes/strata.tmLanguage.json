{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Strata",
  "scopeName": "source.strata",
  "fileTypes": [
    "st"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#expressions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.strata",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.strata",
          "match": "//.*$"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "fn name",
          "match": "\\b(fn)\\s+([\\p{Ll}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.strata"
            },
            "2": {
              "name": "entity.name.function.strata"
            }
          }
        },
        {
          "comment": "type / trait / mock / capability Name",
          "match": "\\b(type|trait|mock|capability)\\s+(\\p{Lu}[\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.strata"
            },
            "2": {
              "name": "entity.name.type.strata"
            }
          }
        },
        {
          "comment": "law name",
          "match": "\\b(law)\\s+([\\p{Ll}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.strata"
            },
            "2": {
              "name": "entity.name.function.strata"
            }
          }
        },
        {
          "comment": "test \"name\"",
          "match": "^\\s*(test)(?=\\s+\")",
          "captures": {
            "1": {
              "name": "keyword.declaration.strata"
            }
          }
        },
        {
          "comment": "use / from ... use",
          "match": "\\b(from|use)\\s+([\\p{L}_][\\p{L}\\p{N}_.]*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.strata"
            },
            "2": {
              "name": "entity.name.namespace.strata"
            }
          }
        }
      ]
    },
    "expressions": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#fstrings"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#builtin-types"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#types"
        },
        {
          "include": "#operators"
        },
        {
          "name": "variable.language.strata",
          "match": "\\b(self|it|result)\\b"
        },
        {
          "name": "variable.other.member.strata",
          "match": "(?<=\\.)[\\p{Ll}_][\\p{L}\\p{N}_]*\\b"
        },
        {
          "name": "variable.other.strata",
          "match": "\\b[\\p{Ll}_][\\p{L}\\p{N}_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.strata",
          "match": "\\b(if|else|match)\\b"
        },
        {
          "name": "keyword.control.loop.strata",
          "match": "\\b(while|for|in|loop|break|continue)\\b"
        },
        {
          "name": "keyword.control.flow.strata",
          "match": "\\b(return|except|or)\\b"
        },
        {
          "name": "keyword.control.task.strata",
          "match": "\\b(spawn|await|scope|supervised\\s+spawn|select(?=\\s*\\{)|race(?=\\s*\\{))\\b"
        },
        {
          "name": "keyword.other.contract.strata",
          "match": "\\b(requires|ensures|terminates|noalloc|decreases|where|invariant|assert)\\b|\\bby\\b(?=\\s*[\\w{])|\\bcalc\\b(?=\\s*\\{)|\\blemma\\b(?=\\s+\\w)|\\bold\\b(?=\\s*[\\w(\\[\"])|\\bmodel\\b(?=\\s+\\w+\\s*[:=])|\\bassumed\\b(?=\\s+(requires|ensures|invariant)\\b)"
        },
        {
          "name": "storage.modifier.strata",
          "match": "\\b(pub|mut|comptime|distinct|derived)\\b"
        },
        {
          "name": "keyword.declaration.strata",
          "match": "\\b(fn|type|trait|impl|derive|derivable|capability|extern|builtin|static|thread|mock|law|test|let|is|as|use|from)\\b|\\bshared\\b(?=\\s+trait\\b)"
        },
        {
          "name": "constant.language.boolean.strata",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.wildcard.strata",
          "match": "\\b_\\b"
        },
        {
          "name": "markup.underline.hole.strata",
          "match": "\\?\\p{L}[\\p{L}\\p{N}_]*"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "comment": "method call",
          "match": "(?<=\\.)([\\p{Ll}_][\\p{L}\\p{N}_]*)(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.method.strata"
            }
          }
        },
        {
          "comment": "call",
          "match": "\\b([\\p{Ll}_][\\p{L}\\p{N}_]*)(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.strata"
            }
          }
        },
        {
          "comment": "constructor",
          "match": "(?<!->\\s)(?<!:\\s)\\b(\\p{Lu}[\\p{L}\\p{N}_]*)(?=\\(|\\s*\\{)",
          "captures": {
            "1": {
              "name": "entity.name.function.constructor.strata"
            }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.strata",
          "match": "\\b(Int|Float|Bool|String|Unit|List|Set|Dict|Option|Result|Self|[IU](8|16|32|64))\\b"
        },
        {
          "name": "entity.name.type.strata",
          "match": "\\b\\p{Lu}[\\p{L}\\p{N}_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.strata",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.strata",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.strata",
          "match": "->|=>|==>"
        },
        {
          "name": "keyword.operator.assignment.strata",
          "match": ":=|[+\\-*/%]?=(?!=)"
        },
        {
          "name": "keyword.operator.strata",
          "match": "==|!=|<=|>=|&&|\\|\\||\\?\\?|!!|\\.\\.=?|<<|>>|[+\\-*/%<>!?&|^]"
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.strata",
      "match": "\\\\."
    },
    "strings": {
      "name": "string.quoted.double.strata",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#escapes"
        }
      ]
    },
    "fstrings": {
      "name": "string.interpolated.strata",
      "begin": "\\bf\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#escapes"
        },
        {
          "name": "constant.character.escape.strata",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "meta.embedded.interpolation.strata",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.begin.strata"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.end.strata"
            }
          },
          "patterns": [
            {
              "name": "storage.modifier.format.strata",
              "match": ":[^}\"(){}\\[\\]]*(?=\\})"
            },
            {
              "include": "#expressions"
            }
          ]
        }
      ]
    },
    "builtin-types": {
      "name": "support.type.builtin.strata",
      "match": "\\b(Int|Float|Bool|String|Unit|List|Set|Dict|Option|Result|Self|[IU](8|16|32|64))\\b"
    }
  }
}