// hello — `strata run examples/hello -- Ada --loud`, or `-- --help`.

use std.cli.CommandLine

/// Greet people by name.
type Options = {
  /// Shout the greeting.
  loud: Bool,
  /// Say it this many times.
  times: Option[Int where 1 <= it && it <= 10],
  /// Who to greet (the world if nobody).
  names: List[String],
}

impl CommandLine for Options {}

fn greeting(opts: Options) -> String {
  let who = if len(opts.names) == 0 {
    "world"
  } else {
    join(opts.names, " and ")
  }
  let text = f"hello, {who}!"
  if opts.loud {
    to_upper(text)
  } else {
    text
  }
}

fn main(opts: Options) -> () {
  for _ in 0..opts.times ?? 1 {
    print(greeting(opts))
  }
}

test "greets the world by default" {
  assert greeting(Options { loud: false, times: None, names: [] }) == "hello, world!"
}
