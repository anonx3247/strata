{"id":"0863df877912dff7","time":1795651910,"message":"edit","changes":[{"name":"text.Card","kind":"type","old":"5546a822b54169ad","new":"0c84f6331cdd3e8f","interface_changed":true,"affected":["text.derive std.json.Json for text.Card","text.summary","text.TextTools","main","test \"a slug, from Python\""],"module":"text","text":"/// A post summed up by Python: its slug, how many words it has, its first\n/// five words, and its tags sorted without repeats.\npub type Card = { slug: String, words: Natural, teaser: String, tags: List[String] }","old_text":"/// A post summed up by Python: its slug, how many words it has, its first\n/// five words, and its tags sorted without repeats.\npub type Card = {\n  slug: String,\n  words: Int where it >= 0,\n  teaser: String,\n  tags: List[String],\n}"},{"name":"text.parse_year","kind":"extern","old":"c9debd8613360b64","new":"3b2172098b268f22","interface_changed":true,"affected":["text.TextTools","main","test \"a slug, from Python\""],"module":"text","text":"/// The year in a text: a `ValueError` in Python when there is none.\nextern python \"text_utils\" fn parse_year(\n  text: String,\n) -> Result[Int where it >= 1000, std.python.PythonError]","old_text":"/// The year in a text: a `ValueError` in Python when there is none.\nextern python \"text_utils\" fn parse_year(text: String) -> Result[Int, std.python.PythonError]\n  ensures match it {\n    Ok(y) => y >= 1000,\n    Err(_) => true,\n  }"}]}
{"id":"bf1950fb4355a682","time":1795651921,"message":"edit","changes":[{"name":"text.TextTools","kind":"capability","old":"4d8ee59a70806bec","new":"fb5bbf0183f3c6a4","interface_changed":true,"affected":["main","test \"a slug, from Python\""],"module":"text","text":"/// Text tools, in Python.\npub capability TextTools {\n  /// `title` as a URL slug.\n  fn slug(title: String) -> Result[String, std.python.PythonError] {\n    text.slugify(title)\n  }\n\n  /// How many times each word of `text` appears.\n  fn counts(text: String) -> Result[Dict[String, Int], std.python.PythonError] {\n    text.word_counts(text)\n  }\n\n  /// `post` summed up.\n  fn card(post: text.Post) -> Result[text.Card, std.python.PythonError] {\n    text.summary(post)\n  }\n\n  /// The year in `text`.\n  fn year(text: String) -> Result[Int where it >= 1000, std.python.PythonError] {\n    text.parse_year(text)\n  }\n}","old_text":"/// Text tools, in Python.\npub capability TextTools {\n  /// `title` as a URL slug.\n  fn slug(title: String) -> Result[String, std.python.PythonError] {\n    text.slugify(title)\n  }\n\n  /// How many times each word of `text` appears.\n  fn counts(text: String) -> Result[Dict[String, Int], std.python.PythonError] {\n    text.word_counts(text)\n  }\n\n  /// `post` summed up.\n  fn card(post: text.Post) -> Result[text.Card, std.python.PythonError] {\n    text.summary(post)\n  }\n\n  /// The year in `text`.\n  fn year(text: String) -> Result[Int, std.python.PythonError] {\n    text.parse_year(text)\n  }\n}"}]}
