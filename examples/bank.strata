/// Money in cents. Can never be negative.
type Cents = Int where it >= 0

type Account = { owner: NonEmptyString, balance: Cents }

type WithdrawError =
  | Insufficient { short_by: Cents }

/// Take money out of an account, if there is enough.
fn withdraw(a: Account, amount: Cents) -> Result[Account, WithdrawError]
  ensures match it {
    Ok(b) => b.balance == a.balance - amount,
    Err(_) => amount > a.balance,
  }
{
  if amount <= a.balance {
    Ok(Account { owner: a.owner, balance: a.balance - amount })
  } else {
    Err(Insufficient { short_by: amount - a.balance })
  }
}

/// Move money between accounts: `!` hands a failed withdrawal straight back.
fn transfer(from: Account, to: Account, amount: Cents) -> Result[(Account, Account), WithdrawError]
  ensures match it {
    Ok((f, t)) => f.balance + t.balance == from.balance + to.balance,
    Err(_) => true,
  }
{
  let from = withdraw(from, amount)!
  Ok((from, Account { ..to, balance: to.balance + amount }))
}

test "can't overdraw" {
  let a = Account { owner: "ana", balance: 500 }
  assert withdraw(a, 800) == Err(Insufficient { short_by: 300 })
}

test "transfers keep the total" {
  let a = Account { owner: "ana", balance: 500 }
  let b = Account { owner: "bo", balance: 0 }
  assert transfer(a, b, 200) == Ok((Account { owner: "ana", balance: 300 }, Account { owner: "bo", balance: 200 }))
  assert transfer(a, b, 900) == Err(Insufficient { short_by: 400 })
}
