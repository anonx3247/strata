// tasks/memory — the in-memory backend: the reference SQLite semantics as a
// pure state machine implementing `core`'s `Queue` trait.

use core.*

// ───────────────────────── in-memory backend ──────────────────────────────
// The SQLite backend's semantics as a pure state machine. Its invariants are
// part of the type, so every state the queue passes through is checked,
// and `strata verify` explores random operation sequences against them.

/// Mirrors the reference SQLite `status` column.
pub type Status =
  | Pending
  | Running
  | Done
  | Exhausted

pub type Entry[P] = { task: Task[P], status: Status, attempts: Int }

/// One row of the reference `results` table.
pub type Row[P, E] = { attempt: AttemptNo, result: TaskResult[P, E] }

pub type MemQueue[P, E] = { policy: TaskPolicy, entries: List[Entry[P]], history: List[Row[P, E]] }
  where unique_ids(it.entries)
    && all(it.entries, |e| 0 <= e.attempts && e.attempts <= max_attempts(it.policy))
    && all(it.entries, |e| e.status is Running ==> e.attempts >= 1)
    && all(it.entries, |e| e.status is Exhausted ==> e.attempts == max_attempts(it.policy))
    && all(it.entries, |e| e.status is Pending ==> e.attempts < max_attempts(it.policy))

fn unique_ids[P](entries: List[Entry[P]]) -> Bool {
  len(set(entries.map(|e| e.task.id))) == len(entries)
}

pub fn empty_queue[P, E](policy: TaskPolicy) -> MemQueue[P, E] {
  MemQueue { policy, entries: [], history: [] }
}

fn status_of[P, E](q: MemQueue[P, E], id: TaskId) -> Option[Status] {
  match find(q.entries, |e| e.task.id == id) {
    Some(e) => Some(e.status),
    None => None,
  }
}

fn attempts_of[P, E](q: MemQueue[P, E], id: TaskId) -> Int {
  match find(q.entries, |e| e.task.id == id) {
    Some(e) => e.attempts,
    None => 0,
  }
}

/// INSERT OR IGNORE: tasks whose id is already known are skipped.
pub fn mem_enqueue[P, E](q: MemQueue[P, E], tasks: List[Task[P]]) -> (MemQueue[P, E], Int)
  ensures 0 <= it.1 && it.1 <= len(tasks)
  ensures len(it.0.entries) == len(q.entries) + it.1
{
  fold(tasks, (q, 0), |acc, t| {
    let (s, n) = acc
    if any(s.entries, |e| e.task.id == t.id) {
      acc
    } else {
      let fresh = Entry { task: t, status: Pending, attempts: 0 }
      (MemQueue { ..s, entries: push(s.entries, fresh) }, n + 1)
    }
  })
}

/// Claim up to `limit` pending tasks with attempts left, oldest first.
pub fn mem_claim[P, E](q: MemQueue[P, E], limit: Positive) -> (MemQueue[P, E], List[TaskAttempt[P]])
  ensures len(it.1) <= limit
  ensures all(it.1, |a| status_of(q, a.task.id) == Some(Pending))
  ensures all(it.1, |a| status_of(it.0, a.task.id) == Some(Running))
  ensures all(it.1, |a| a.attempt == attempts_of(q, a.task.id) + 1)
{
  let max = max_attempts(q.policy)
  let chosen = take(filter(q.entries, |e| e.status is Pending && e.attempts < max), limit)
  let ids = chosen.map(|e| e.task.id)
  let entries = q.entries.map(|e| {
    if contains(ids, e.task.id) { Entry { ..e, status: Running, attempts: e.attempts + 1 } } else { e }
  })
  (MemQueue { ..q, entries }, chosen.map(|e| TaskAttempt { task: e.task, attempt: e.attempts + 1 }))
}

/// Failures go back to Pending until attempts run out, then become Exhausted;
/// successes and skips are Done. Every attempt is kept in the history.
pub fn mem_record[P, E](q: MemQueue[P, E], results: List[TaskResult[P, E]]) -> MemQueue[P, E]
  requires all(results, |r| status_of(q, task_of(r).id) == Some(Running))
  ensures all(results, |r| settled(it, r))
  ensures len(it.history) == len(q.history) + len(results)
{
  let max = max_attempts(q.policy)
  let entries = q.entries.map(|e| {
    match find(results, |r| task_of(r).id == e.task.id) {
      None => e,
      Some(Failed { .. }) => Entry { ..e, status: if e.attempts < max { Pending } else { Exhausted } },
      Some(_) => Entry { ..e, status: Done },
    }
  })
  let rows = results.map(|r| Row { attempt: attempts_of(q, task_of(r).id), result: r })
  MemQueue { ..q, entries, history: q.history + rows }
}

fn settled[P, E](q: MemQueue[P, E], r: TaskResult[P, E]) -> Bool {
  let s = status_of(q, task_of(r).id)
  match r {
    Failed { .. } => s == Some(Pending) || s == Some(Exhausted),
    _ => s == Some(Done),
  }
}

/// Put claimed-but-unreported tasks back to Pending, keeping attempt counts.
///
/// Fix over the reference: `_release` sets status back to `pending` even when the
/// attempt it released was the last one. Since `_claim` only picks tasks with
/// `attempts < max_attempts`, such a task stays `pending` forever: never retried,
/// never marked `failed`. `strata verify` found this through the
/// `Pending ==> attempts < max` invariant on `MemQueue` (retries = 0, a worker
/// that drops a result). Here those tasks become Exhausted instead.
pub fn mem_release[P, E](q: MemQueue[P, E], attempts: List[TaskAttempt[P]]) -> MemQueue[P, E]
  ensures all(attempts, |a| status_of(it, a.task.id) != Some(Running))
{
  let ids = attempts.map(|a| a.task.id)
  let max = max_attempts(q.policy)
  let entries = q.entries.map(|e| {
    if e.status is Running && contains(ids, e.task.id) {
      Entry { ..e, status: if e.attempts < max { Pending } else { Exhausted } }
    } else {
      e
    }
  })
  MemQueue { ..q, entries }
}

/// The in-memory queue is a `Queue` backend like any other. Each operation
/// runs the verified state-machine step above and keeps the new state.
impl[P, E] Queue[P, E] for MemQueue[P, E] {
  fn enqueue(mut self, tasks: List[Task[P]]) -> Int {
    let (next, added) = mem_enqueue(self, tasks)
    self = next
    added
  }
  fn claim(mut self, limit: Positive) -> List[TaskAttempt[P]] {
    let (next, attempts) = mem_claim(self, limit)
    self = next
    attempts
  }
  /// The trait accepts any results, so results for tasks that are not running
  /// (unknown, or already settled) are ignored rather than trusted.
  fn record(mut self, results: List[TaskResult[P, E]]) -> () {
    self = mem_record(self, filter(results, |r| status_of(self, task_of(r).id) == Some(Running)))
  }
  fn release(mut self, attempts: List[TaskAttempt[P]]) -> () {
    self = mem_release(self, attempts)
  }
}

/// A one-line summary per task, for reports and assertions.
pub fn describe[P, E](q: MemQueue[P, E]) -> List[String] {
  q.entries.map(|e| e.task.id + ": " + to_string(e.status) + " after " + to_string(e.attempts))
}
