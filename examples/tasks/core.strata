// tasks/core — backend-agnostic task queues, ported from the Python/TypeScript
// reference (github: tasks). Producers discover tasks and enqueue them;
// workers claim batches of attempts and report results.
//
// Producer, Worker and the queue backend are traits. Entrypoints take a
// backend value and work with any implementation: swapping SQLite for SQS
// means passing a different queue value (the reference's "only the queue
// object changes"). Methods that change a backend say `mut self`.

// ─────────────────────────────── core model ───────────────────────────────

/// Identifies a task. The reference uses a uuid4 hex string.
pub type TaskId = String
  where matches(it, "[A-Za-z0-9_-]{1,64}")

/// A unit of work. `kind` is the task family, e.g. "print". Every Strata
/// type is JSON-serialisable, so the payload needs no `BaseModel` bound.
pub type Task[P] = { id: TaskId, kind: NonEmptyString, payload: P }

/// A single attempt at running a task. Attempt numbers are 1-based.
pub type TaskAttempt[P] = { task: Task[P], attempt: Positive }

/// The outcome a worker reports for one attempt. Unlike the reference
/// (`result` + optional `error`), an error can only exist on a failure:
/// "success with an error" is unrepresentable.
pub type TaskResult[P, E] =
  | Succeeded { task: Task[P] }
  | Failed { task: Task[P], error: E }
  | Skipped { task: Task[P] }

pub fn task_of[P, E](r: TaskResult[P, E]) -> Task[P] {
  match r {
    Succeeded { task } => task,
    Failed { task, .. } => task,
    Skipped { task } => task,
  }
}

/// Standard scheduling policy. The `ge=1` / `ge=0` checks from the Pydantic
/// model are the prelude's `Positive` / `Natural`: an invalid policy cannot
/// be constructed.
pub type TaskPolicy = {
  max_workers: Positive,
  tasks_per_worker: Positive,
  retries: Natural,
}

/// Total runs of a task: the first try plus `retries` retries.
pub fn max_attempts(p: TaskPolicy) -> Positive
  ensures it == p.retries + 1 {
  p.retries + 1
}

// ───────────────────────── the three capabilities ─────────────────────────
// The reference passes `resources` to producers and workers. Here an
// implementation simply carries whatever it needs in its fields.

/// Discovers tasks to run (the reference `Producer` protocol).
pub trait Producer[P] {
  fn discover(self) -> List[Task[P]]
}

/// Runs a batch of attempts and reports one result per attempt (the
/// reference `Worker` protocol). A worker may change as it runs (e.g. a
/// console it writes to).
pub trait Worker[P, E] {
  fn run(mut self, attempts: List[TaskAttempt[P]]) -> List[TaskResult[P, E]]
}

/// A queue backend. This is the only thing that changes between SQLite, SQS,
/// Redis…
/// The contracts below bind every implementation: a backend that returns
/// more than `limit` attempts is caught at the call.
pub trait Queue[P, E] {
  /// Enqueue tasks, ignoring ids already present; returns how many were new.
  fn enqueue(mut self, tasks: List[Task[P]]) -> Int
    ensures 0 <= it && it <= len(tasks)
  /// Claim up to `limit` pending tasks, oldest first, bumping their attempt counts.
  fn claim(mut self, limit: Positive) -> List[TaskAttempt[P]]
    ensures len(it) <= limit
  /// Record the results of claimed attempts.
  fn record(mut self, results: List[TaskResult[P, E]]) -> ()
  /// Put claimed-but-unreported attempts back.
  fn release(mut self, attempts: List[TaskAttempt[P]]) -> ()
}

// ───────────────────────────── entrypoints ─────────────────────────────────

/// Run the producer once and enqueue every task it discovers.
pub fn run_producer[P, E](mut queue: Queue[P, E], producer: Producer[P]) -> Int
  ensures it >= 0 {
  queue.enqueue(producer.discover())
}

/// A worker broke the contract of reporting exactly one result per attempt.
pub type WorkerError =
  | ResultsMismatch { claimed: List[TaskId], reported: List[TaskId] }

/// Claim one batch, run it, record the results. If the worker does not report
/// exactly one result per claimed attempt, the claim is released and the
/// mismatch is returned as a value instead of an exception.
pub fn run_worker[P, E](
  mut queue: Queue[P, E],
  mut worker: Worker[P, E],
  policy: TaskPolicy,
) -> Result[List[TaskResult[P, E]], WorkerError]
  ensures match it {
    Ok(rs) => len(rs) <= policy.tasks_per_worker,
    Err(_) => true,
  } {
  let attempts = queue.claim(policy.tasks_per_worker)
  if len(attempts) == 0 {
    return Ok([])
  }
  let results = worker.run(attempts)
  let claimed = attempts.map(a -> a.task.id)
  let reported = results.map(r -> task_of(r).id)
  if !same_ids(claimed, reported) {
    queue.release(attempts)
    return Err(ResultsMismatch { claimed, reported })
  }
  queue.record(results)
  Ok(results)
}

/// Exactly the same ids, each reported once.
fn same_ids(claimed: List[TaskId], reported: List[TaskId]) -> Bool {
  len(claimed) == len(reported)
    && all(claimed, c -> count(reported, r -> r == c) == 1)
}

/// The worker entrypoint's loop: run batches until the queue has nothing
/// claimable (or `max_batches` is reached). Returns the number of batches
/// run.
pub fn drain[P, E](
  mut queue: Queue[P, E],
  mut worker: Worker[P, E],
  policy: TaskPolicy,
  max_batches: Natural,
) -> Int
  ensures 0 <= it && it <= max_batches {
  let mut batches = 0
  while batches < max_batches {
    // an empty batch means nothing is left to claim
    if run_worker(mut queue, mut worker, policy) == Ok([]) {
      break
    }
    batches = batches + 1
  }
  batches
}
