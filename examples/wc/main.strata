// wc — count lines, words and characters, like the Unix tool.
//
//   strata run examples/wc -- README.md src/main.rs
//   cat README.md | strata run examples/wc
//
// `main` asks for exactly what it touches: the console, the files and the
// command line. The tests below hand it stand-ins instead.

use std.io.{Console, recorder, printed}

use std.fs.{Files, FsError, NotFound, mem_files}

use std.process.{Environment, ExitCode, fake_environment}

type Counts = { lines: Natural, words: Natural, chars: Natural }

fn words(line: String) -> Natural {
  len(split(line, " ").filter(w -> trim(w) != ""))
}

fn count(text: String) -> Counts {
  let ls = lines(text)
  Counts {
    lines: len(ls),
    words: sum(ls.map(words)),
    chars: len(text),
  }
}

fn add(a: Counts, b: Counts) -> Counts {
  Counts {
    lines: a.lines + b.lines,
    words: a.words + b.words,
    chars: a.chars + b.chars,
  }
}

fn row(c: Counts, label: String) -> String {
  f"{c.lines}\t{c.words}\t{c.chars}\t{label}"
}

/// All of standard input, line by line.
fn read_all(mut console: Console) -> String {
  let mut text = ""
  loop {
    match console.read_line() {
      Some(line) => {
        text = text + line + "\n"
      },
      None => {
        break
      },
    }
  }
  text
}

fn main(
  mut console: Console,
  files: Files,
  env: Environment,
) -> Result[ExitCode, FsError] {
  let paths = env.args()
  if len(paths) == 0 {
    console.print(row(count(read_all(mut console)), "-"))
    return Ok(0)
  }
  let mut total = Counts { lines: 0, words: 0, chars: 0 }
  for path in paths {
    let c = count(files.read_text(path)!)
    console.print(row(c, path))
    total = add(total, c)
  }
  if len(paths) > 1 {
    console.print(row(total, "total"))
  }
  Ok(0)
}

test "counts each file and the total" {
  let mut console = recorder([])
  let files = mem_files([("a.txt", "one two\nthree\n"), ("b.txt", "four\n")])
  let r = main(mut console, files, fake_environment(["a.txt", "b.txt"], []))
  assert r == Ok(0)
  assert printed(console) == ["2\t3\t14\ta.txt", "1\t1\t5\tb.txt", "3\t4\t19\ttotal"]
}

test "reads standard input when no file is named" {
  let mut console = recorder(["hello world", "bye"])
  let r = main(mut console, mem_files([]), fake_environment([], []))
  assert r == Ok(0)
  assert printed(console) == ["2\t3\t16\t-"]
}

test "a missing file is an error" {
  let mut console = recorder([])
  let r = main(
    mut console,
    mem_files([]),
    fake_environment(["nope.txt"], []),
  )
  assert r == Err(NotFound { path: "nope.txt" })
}
