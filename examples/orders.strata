/// Order identifiers: `ord_` followed by 6 lowercase letters or digits.
type OrderId = String where matches(it, "ord_[a-z0-9]{6}")

/// How many units of an item can be on a single line.
type Quantity = Int where 1 <= it && it <= 99

/// Prices are in cents and never negative.
type Cents = Int where it >= 0

type Line = { sku: String, qty: Quantity, unit_price: Cents }

type Order =
  | Pending { id: OrderId, lines: NonEmpty[Line] }
  | Shipped { id: OrderId, lines: NonEmpty[Line], tracking: String }
  | Cancelled { id: OrderId, reason: String }

type ShipError =
  | NotFound
  | NotPending

/// Persistent storage for orders. Saving returns the store's next state.
trait Db {
  fn load(self, id: OrderId) -> Option[Order]
  fn save(self, o: Order) -> Self
}

/// A store holding a single order: enough for tests, and it records saves.
type OneOrder = { order: Option[Order] }

impl Db for OneOrder {
  fn load(self, id: OrderId) -> Option[Order] {
    match self.order {
      Some(o) => if order_id(o) == id { Some(o) } else { None },
      None => None,
    }
  }
  fn save(self, o: Order) -> Self { OneOrder { order: Some(o) } }
}

fn order_id(o: Order) -> OrderId {
  match o {
    Pending { id, .. } => id,
    Shipped { id, .. } => id,
    Cancelled { id, .. } => id,
  }
}

fn line_total(l: Line) -> Cents
  ensures it == l.qty * l.unit_price
{
  l.qty * l.unit_price
}

fn total(lines: NonEmpty[Line]) -> Cents
  ensures it >= 0
{
  sum(lines.map(line_total))
}

/// 10% off orders of 100.00 or more.
fn discount(amount: Cents) -> Cents
  ensures it <= amount
{
  if amount >= 10000 { amount - amount / 10 } else { amount }
}

/// Works with any `Db`: pass the real one in production, a fake in tests.
fn ship[D: Db](db: D, id: OrderId, tracking: String) -> (D, Result[Order, ShipError])
  ensures match it.1 { Ok(o) => o is Shipped, Err(_) => true }
{
  match db.load(id) {
    None => (db, Err(NotFound)),
    Some(Pending { id, lines }) => {
      let o = Shipped { id, lines, tracking }
      (db.save(o), Ok(o))
    }
    Some(_) => (db, Err(NotPending)),
  }
}

/// Refunds are not designed yet: the hole has a type and a contract,
/// so callers can already be checked against it.
fn refund(o: Order) -> Cents
  ensures it >= 0
  = ?refund_policy

test "shipping a pending order saves it as shipped" {
  let line = Line { sku: "tea", qty: 2, unit_price: 450 }
  let db = OneOrder { order: Some(Pending { id: "ord_abc123", lines: [line] }) }
  let (db2, r) = ship(db, "ord_abc123", "TRK1")
  assert r is Ok
  assert db2.order == Some(Shipped { id: "ord_abc123", lines: [line], tracking: "TRK1" })
}

test "shipping a cancelled order is rejected" {
  let db = OneOrder { order: Some(Cancelled { id: "ord_abc123", reason: "fraud" }) }
  let (_, r) = ship(db, "ord_abc123", "TRK1")
  assert r == Err(NotPending)
}

test "a mocked store never breaks ship's contract" {
  let (_, r) = ship(mock Db, "ord_zzz999", "TRK9")
  assert r is Ok || r is Err
}

test "totals" {
  let lines = [Line { sku: "a", qty: 3, unit_price: 100 }, Line { sku: "b", qty: 1, unit_price: 50 }]
  assert total(lines) == 350
  assert discount(20000) == 18000
}
