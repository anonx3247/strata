{"id":"be9bf4cb834a422c","time":1795320974,"message":"events are numbered handlers, not JSON","changes":[{"name":"test \"attributes are escaped and events carry only their handler's number\"","kind":"test","old":null,"new":"1e72e3535478f2e8","interface_changed":true,"affected":[],"module":"","text":"test \"attributes are escaped and events carry only their handler's number\" {\n  let h: std.web.Html[Option[Int]] = std.web.button(\n    [std.web.class(\"x\\\"y\"), std.web.on_click(Some(3))],\n    [std.web.text(\"go\")],\n  )\n  assert std.web.render(h) == \"<button class=\\\"x&quot;y\\\" data-handle-click=\\\"0\\\">go</button>\"\n  assert std.web.dispatch(h, 0, \"\", dict([])) == Some(Some(3))\n}"}]}
