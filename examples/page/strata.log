{"id":"be9bf4cb834a422c","time":1795320974,"message":"events are numbered handlers, not JSON","changes":[{"name":"test \"attributes are escaped and events carry only their handler's number\"","kind":"test","old":null,"new":"1e72e3535478f2e8","interface_changed":true,"affected":[],"module":"","text":"test \"attributes are escaped and events carry only their handler's number\" {\n  let h: std.web.Html[Option[Int]] = std.web.button(\n    [std.web.class(\"x\\\"y\"), std.web.on_click(Some(3))],\n    [std.web.text(\"go\")],\n  )\n  assert std.web.render(h) == \"<button class=\\\"x&quot;y\\\" data-handle-click=\\\"0\\\">go</button>\"\n  assert std.web.dispatch(h, 0, \"\", dict([])) == Some(Some(3))\n}"}]}
{"id":"5d564e42793f1355","time":1795320996,"message":"the JSON-events test goes","changes":[{"name":"test \"attributes are escaped and events carry their message as JSON\"","kind":"test","old":"c05a48a5366efec7","new":null,"interface_changed":true,"affected":[],"module":"","old_text":"test \"attributes are escaped and events carry their message as JSON\" {\n  let h: std.web.Html[Option[Int]] = std.web.button(\n    [std.web.class(\"x\\\"y\"), std.web.on_click(Some(3))],\n    [std.web.text(\"go\")],\n  )\n  assert std.web.render(h) == \"<button class=\\\"x&quot;y\\\" data-on-click=\\\"{&quot;Some&quot;:3}\\\">go</button>\"\n}"}]}
{"id":"ed76819da9d671d3","time":1795399386,"message":"edit","changes":[{"name":"app","kind":"fn","old":"bce83af6af49f287","new":"ec95087514c4e599","interface_changed":false,"affected":[],"module":"","text":"fn app() -> std.http.Router {\n  mut app := std.http.Router.new()\n  mut app.get(\n    \"/\",\n    req -> std.http.ok_html(page(languages(), order_of(req))),\n  )\n  mut app.get(\"/languages.json\", req -> std.http.ok_json(languages()))\n  mut app.get(\"/languages/:name\", language)\n  app\n}","old_text":"fn app() -> std.http.Router {\n  mut app := std.http.Router.new()\n  app.get(\n    \"/\",\n    req -> std.http.ok_html(page(languages(), order_of(req))),\n  )\n  app.get(\"/languages.json\", req -> std.http.ok_json(languages()))\n  app.get(\"/languages/:name\", language)\n  app\n}"}]}
{"id":"ddb5598a53399bd3","time":1795712345,"message":"edit","changes":[{"name":"use std.web","kind":"use","old":"0a808108f64639d9","new":"9924502a4fe04a2b","interface_changed":true,"affected":[],"module":"","text":"// page: an HTML page built from data with markup, served with `std.http`.\n//\n//   strata run examples/page > page.html    # write the page\n//   strata test examples/page               # or check it, requests included\n//\n// Markup (`<td class=\"num\">{l.year}</td>`) is Strata code: the parser reads\n// it as calls to `std.web`, and `view` shows those calls as markup again.\n// A component is a function (`row`, `sort_link`), called in braces. Text and\n// values in braces are escaped when rendered, so a name like `<script>`\n// shows as written. `handle` answers each request through a `Router`: the\n// page (sorted as `?sort=` says), the data as JSON, one language by name, or\n// a 404.\n\nfrom std.web use Html, render, document, style_sheet, raw_html","old_text":"// page: an HTML page built from data with `std.web`, served with `std.http`.\n//\n//   strata serve examples/page              # http://127.0.0.1:8000\n//   strata run examples/page > page.html    # or just write the page\n//\n// The page is built as values (`Html`), and `document` renders it. Text is\n// escaped, so a name like `<script>` shows as written. `handle` answers each\n// request through a `Router`: the page (sorted as `?sort=` says), the data\n// as JSON, one language by name, or a 404.\n\nfrom std.web use Html, Attr, render, document, element, text, style_sheet, h1,\n  p, nav, a, table, thead, tbody, tr, th, td, button, class, href, on_click"},{"name":"row","kind":"fn","old":"66dc2f5c8f40f235","new":"2059634e47e34d55","interface_changed":false,"affected":[],"module":"","text":"fn row(l: Language) -> std.web.Html[()] {\n  <tr>\n    <td>{l.name}</td>\n    <td class=\"num\">{l.year}</td>\n    <td>\n      {if l.typed {\n        \"yes\"\n      } else {\n        \"no\"\n      }}\n    </td>\n  </tr>\n}","old_text":"fn row(l: Language) -> std.web.Html[()] {\n  std.web.tr(\n    [],\n    [std.web.td([], [std.web.text(l.name)]), std.web.td(\n      [std.web.class(\"num\")],\n      [std.web.text(to_string(l.year))],\n    ), std.web.td([], [std.web.text(if l.typed {\n      \"yes\"\n    } else {\n      \"no\"\n    })])],\n  )\n}"},{"name":"languages_table","kind":"fn","old":"8d68749adf996dd9","new":"b456ee3d0d0eaa36","interface_changed":false,"affected":[],"module":"","text":"fn languages_table(ls: List[Language]) -> std.web.Html[()] {\n  <table>\n    <thead>\n      <tr>\n        <th>Name</th>\n        <th class=\"num\">Year</th>\n        <th>Static types</th>\n      </tr>\n    </thead>\n    <tbody>{ls.map(l -> row(l))}</tbody>\n  </table>\n}","old_text":"fn languages_table(ls: List[Language]) -> std.web.Html[()] {\n  std.web.table([], [std.web.thead([], [std.web.tr([], [\n    std.web.th([], [std.web.text(\"Name\")]),\n    std.web.th([std.web.class(\"num\")], [std.web.text(\"Year\")]),\n    std.web.th([], [std.web.text(\"Static types\")]),\n  ])]), std.web.tbody([], ls.map(l -> row(l)))])\n}"},{"name":"sort_link","kind":"fn","old":"c3c997f3210b411d","new":"e83470c8c344058c","interface_changed":false,"affected":[],"module":"","text":"/// A link to the page sorted by `query`, marked when it is the current one.\nfn sort_link(label: String, query: String, current: Bool) -> std.web.Html[()] {\n  if current {\n    <a href={query} class=\"current\">{label}</a>\n  } else {\n    <a href={query}>{label}</a>\n  }\n}","old_text":"/// A link to the page sorted by `order`, marked when it is the current one.\nfn sort_link(label: String, query: String, current: Bool) -> std.web.Html[()] {\n  let attrs: List[std.web.Attr[()]] = if current {\n    [std.web.href(query), std.web.class(\"current\")]\n  } else {\n    [std.web.href(query)]\n  }\n  std.web.a(attrs, [std.web.text(label)])\n}"},{"name":"page","kind":"fn","old":"18a765e05a65b94a","new":"d3b89da5ae035af1","interface_changed":false,"affected":[],"module":"","text":"fn page(ls: List[Language], order: Option[Order]) -> String {\n  css := join(\n    [\n      \"body { font-family: system-ui, sans-serif; max-width: 42rem; margin: 3rem auto; padding: 0 1rem; color: #1f2328; }\",\n      \"h1 { font-size: 1.6rem; margin-bottom: 0.25rem; }\",\n      \"p { color: #59636e; margin-top: 0; }\",\n      \"nav a { margin-right: 1rem; color: #0969da; text-decoration: none; }\",\n      \"nav a.current { font-weight: 600; color: #1f2328; }\",\n      \"table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }\",\n      \"th, td { padding: 0.55rem 0.75rem; border-bottom: 1px solid #d1d9e0; text-align: left; }\",\n      \"th { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; color: #59636e; }\",\n      \"tbody tr:hover { background: #f6f8fa; }\",\n      \"th.num, td.num { text-align: right; font-variant-numeric: tabular-nums; }\",\n    ],\n    \"\\n\",\n  )\n  let note: std.web.Html[()] = if len(ls) == 0 {\n    <p class=\"empty\">No languages yet.</p>\n  } else {\n    <p>{len(ls)} languages</p>\n  }\n  shown := match order {\n    Some(o) => sorted(ls, o),\n    None => ls,\n  }\n  std.web.document(\n    \"Languages\",\n    [std.web.style_sheet(css)],\n    [<h1>Languages</h1>, note, <nav>\n      {sort_link(\"As listed\", \"/\", order == None)}\n      {sort_link(\"By name\", \"/?sort=name\", order == Some(ByName))}\n      {sort_link(\"By year\", \"/?sort=year\", order == Some(ByYear))}\n      <a href=\"/languages.json\">JSON</a>\n    </nav>, languages_table(shown)],\n  )\n}","old_text":"fn page(ls: List[Language], order: Option[Order]) -> String {\n  css := join(\n    [\n      \"body { font-family: system-ui, sans-serif; max-width: 42rem; margin: 3rem auto; padding: 0 1rem; color: #1f2328; }\",\n      \"h1 { font-size: 1.6rem; margin-bottom: 0.25rem; }\",\n      \"p { color: #59636e; margin-top: 0; }\",\n      \"nav a { margin-right: 1rem; color: #0969da; text-decoration: none; }\",\n      \"nav a.current { font-weight: 600; color: #1f2328; }\",\n      \"table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }\",\n      \"th, td { padding: 0.55rem 0.75rem; border-bottom: 1px solid #d1d9e0; text-align: left; }\",\n      \"th { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; color: #59636e; }\",\n      \"tbody tr:hover { background: #f6f8fa; }\",\n      \"th.num, td.num { text-align: right; font-variant-numeric: tabular-nums; }\",\n    ],\n    \"\\n\",\n  )\n  let note: std.web.Html[()] = if len(ls) == 0 {\n    std.web.p(\n      [std.web.class(\"empty\")],\n      [std.web.text(\"No languages yet.\")],\n    )\n  } else {\n    std.web.p([], [std.web.text(f\"{len(ls)} languages\")])\n  }\n  shown := match order {\n    Some(o) => sorted(ls, o),\n    None => ls,\n  }\n  std.web.document(\"Languages\", [std.web.style_sheet(css)], [\n    std.web.h1([], [std.web.text(\"Languages\")]),\n    note,\n    std.web.nav([], [\n      sort_link(\"As listed\", \"/\", order == None),\n      sort_link(\"By name\", \"/?sort=name\", order == Some(ByName)),\n      sort_link(\"By year\", \"/?sort=year\", order == Some(ByYear)),\n      std.web.a(\n        [std.web.href(\"/languages.json\")],\n        [std.web.text(\"JSON\")],\n      ),\n    ]),\n    languages_table(shown),\n  ])\n}"},{"name":"test \"text is escaped\"","kind":"test","old":"4351ff75fdbb45ce","new":"54912b335619fda6","interface_changed":false,"affected":[],"module":"","text":"test \"text is escaped\" {\n  let h: std.web.Html[()] = <p>a {\"<\"} b &amp; {\"\\\"c\\\"\"}</p>\n  assert std.web.render(h) == \"<p>a &lt; b &amp;amp; \\\"c\\\"</p>\"\n}","old_text":"test \"text is escaped\" {\n  let h: std.web.Html[()] = std.web.p([], [std.web.text(\"a < b & \\\"c\\\"\")])\n  assert std.web.render(h) == \"<p>a &lt; b &amp; \\\"c\\\"</p>\"\n}"},{"name":"test \"attributes are escaped and events carry only their handler's number\"","kind":"test","old":"1e72e3535478f2e8","new":"9aba87031d1f5a90","interface_changed":false,"affected":[],"module":"","text":"test \"attributes are escaped and events carry only their handler's number\" {\n  let h: std.web.Html[Option[Int]] = <button class=\"x&quot;y\" data-q={\"x\\\"y\"} on_click={Some(3)}>\n    go\n  </button>\n  assert std.web.render(h) == \"<button class=\\\"x&amp;quot;y\\\" data-q=\\\"x&quot;y\\\" data-handle-click=\\\"0\\\">go</button>\"\n  assert std.web.dispatch(h, 0, \"\", dict([])) == Some(Some(3))\n}","old_text":"test \"attributes are escaped and events carry only their handler's number\" {\n  let h: std.web.Html[Option[Int]] = std.web.button(\n    [std.web.class(\"x\\\"y\"), std.web.on_click(Some(3))],\n    [std.web.text(\"go\")],\n  )\n  assert std.web.render(h) == \"<button class=\\\"x&quot;y\\\" data-handle-click=\\\"0\\\">go</button>\"\n  assert std.web.dispatch(h, 0, \"\", dict([])) == Some(Some(3))\n}"},{"name":"test \"values in braces are escaped too, attributes included\"","kind":"test","old":null,"new":"4f453badadbed434","interface_changed":true,"affected":[],"module":"","text":"test \"values in braces are escaped too, attributes included\" {\n  evil := \"<script>alert(1)</script>\"\n  let h: std.web.Html[()] = <p title={evil}>{evil}</p>\n  assert std.web.render(h) == \"<p title=\\\"&lt;script&gt;alert(1)&lt;/script&gt;\\\">&lt;script&gt;alert(1)&lt;/script&gt;</p>\"\n}"},{"name":"test \"only raw_html is written as it is\"","kind":"test","old":null,"new":"644233bc036a8860","interface_changed":true,"affected":[],"module":"","text":"test \"only raw_html is written as it is\" {\n  let h: std.web.Html[()] = <div>{std.web.raw_html(\"<hr>\")}</div>\n  assert std.web.render(h) == \"<div><hr></div>\"\n}"},{"name":"test \"numbers, flags and lists in braces\"","kind":"test","old":null,"new":"2c9de9de94988060","interface_changed":true,"affected":[],"module":"","text":"test \"numbers, flags and lists in braces\" {\n  let h: std.web.Html[()] = <ul data-n={2} hidden={false} open={true}>\n    {[1, 2].map(n -> <li>{n}</li>)}\n  </ul>\n  assert std.web.render(h) == \"<ul data-n=\\\"2\\\" open><li>1</li><li>2</li></ul>\"\n}"}]}
