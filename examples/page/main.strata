// page — an HTML page built from data, with `std.web`, served with
// `std.http`.
//
//   strata serve examples/page              # http://127.0.0.1:8000
//   strata run examples/page > page.html    # or just write the page
//
// The page is built as values (`Html`), and `document` renders it. Text is
// escaped, so a name like `<script>` shows as written. `handle` answers each
// request through a `Router`: the page (sorted as `?sort=` says), the data
// as JSON, one language by name, or a 404.

use std.web.{Html, Attr, render, document, element, text, style_sheet, h1, p, nav, a, table, thead, tbody, tr, th, td, button, class, href, on_click}

use std.http.{Request, Response, Router, get_request, ok_html, ok_json, not_found}

type Language = {
  name: String,
  year: Int where 1940 <= it && it <= 2100,
  typed: Bool,
}

/// How the table is sorted: `?sort=name` or `?sort=year`.
type Order =
  | ByName
  | ByYear

fn languages() -> List[Language] {
  [
    Language { name: "ML", year: 1973, typed: true },
    Language { name: "Lisp", year: 1958, typed: false },
    Language { name: "Haskell", year: 1990, typed: true },
    Language {
      name: "<script>alert(1)</script>",
      year: 2026,
      typed: true,
    },
  ]
}

fn sorted(ls: List[Language], order: Order) -> List[Language] {
  match order {
    ByName => sort_by(ls, l -> to_lower(l.name)),
    ByYear => sort_by(ls, l -> l.year),
  }
}

fn row(l: Language) -> Html[()] {
  tr([], [
    td([], [text(l.name)]),
    td([class("num")], [text(to_string(l.year))]),
    td([], [text(if l.typed {
      "yes"
    } else {
      "no"
    })]),
  ])
}

fn languages_table(ls: List[Language]) -> Html[()] {
  table([], [thead([], [tr([], [
    th([], [text("Name")]),
    th([class("num")], [text("Year")]),
    th([], [text("Static types")]),
  ])]), tbody([], ls.map(l -> row(l)))])
}

/// A link to the page sorted by `order`, marked when it is the current one.
fn sort_link(label: String, query: String, current: Bool) -> Html[()] {
  let attrs: List[Attr[()]] = if current {
    [href(query), class("current")]
  } else {
    [href(query)]
  }
  a(attrs, [text(label)])
}

fn page(ls: List[Language], order: Option[Order]) -> String {
  let css = join(
    [
      "body { font-family: system-ui, sans-serif; max-width: 42rem; margin: 3rem auto; padding: 0 1rem; color: #1f2328; }",
      "h1 { font-size: 1.6rem; margin-bottom: 0.25rem; }",
      "p { color: #59636e; margin-top: 0; }",
      "nav a { margin-right: 1rem; color: #0969da; text-decoration: none; }",
      "nav a.current { font-weight: 600; color: #1f2328; }",
      "table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }",
      "th, td { padding: 0.55rem 0.75rem; border-bottom: 1px solid #d1d9e0; text-align: left; }",
      "th { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; color: #59636e; }",
      "tbody tr:hover { background: #f6f8fa; }",
      "th.num, td.num { text-align: right; font-variant-numeric: tabular-nums; }",
    ],
    "\n",
  )
  let note: Html[()] = if len(ls) == 0 {
    p([class("empty")], [text("No languages yet.")])
  } else {
    p([], [text(f"{len(ls)} languages")])
  }
  let shown = match order {
    Some(o) => sorted(ls, o),
    None => ls,
  }
  document(
    "Languages",
    [style_sheet(css)],
    [h1([], [text("Languages")]), note, nav([], [
      sort_link("As listed", "/", order == None),
      sort_link("By name", "/?sort=name", order == Some(ByName)),
      sort_link("By year", "/?sort=year", order == Some(ByYear)),
      a([href("/languages.json")], [text("JSON")]),
    ]), languages_table(shown)],
  )
}

/// What `?sort=` asks for.
fn order_of(req: Request) -> Option[Order] {
  match get(req.query, "sort") {
    Some("name") => Some(ByName),
    Some("year") => Some(ByYear),
    _ => None,
  }
}

/// One language, by name, as JSON.
fn language(req: Request) -> Response {
  let name = req.param("name") except { return not_found() }
  match find(languages(), l -> to_lower(l.name) == to_lower(name)) {
    Some(l) => ok_json(l),
    None => not_found(),
  }
}

fn app() -> Router {
  let mut app = Router.new()
  app.get("/", req -> ok_html(page(languages(), order_of(req))))
  app.get("/languages.json", req -> ok_json(languages()))
  app.get("/languages/:name", language)
  app
}

fn handle(req: Request) -> Response {
  app().handle(req)
}

fn main() -> () {
  print(page(languages(), None))
}

test "text is escaped" {
  let h: Html[()] = p([], [text("a < b & \"c\"")])
  assert render(h) == "<p>a &lt; b &amp; \"c\"</p>"
}

test "attributes are escaped and events carry their message as JSON" {
  let h: Html[Option[Int]] = button([class("x\"y"), on_click(Some(3))], [text("go")])
  assert render(h) == "<button class=\"x&quot;y\" data-on-click=\"{&quot;Some&quot;:3}\">go</button>"
}

test "void elements have no closing tag" {
  let h: Html[()] = element("br", [], [])
  assert render(h) == "<br>"
}

test "style sheets are not escaped but can't close their element" {
  let h: Html[()] = style_sheet("a > b {} </style><script>")
  assert render(h) == "<style>a > b {} <\/style><script></style>"
}

test "a page" {
  let html = page([], None)
  assert starts_with(
    html,
    "<!DOCTYPE html>\n<html><head><meta charset=\"utf-8\">",
  )
  assert contains(html, "<title>Languages</title>")
  assert contains(html, "<p class=\"empty\">No languages yet.</p>")
}

test "requests" {
  let home = handle(get_request("/"))
  assert home.status == 200 && contains(home.body, "<td>Lisp</td>")
  let mut sort = get_request("/")
  sort.query = dict([("sort", "year")])
  let by_year = handle(sort)
  assert index_of(by_year.body, "Lisp") ?? -1 < index_of(by_year.body, "ML") ?? -1
  assert handle(get_request("/languages.json")).body == to_json(languages())
  assert handle(get_request("/languages/haskell")).body == "{\"name\":\"Haskell\",\"year\":1990,\"typed\":true}"
  assert handle(get_request("/languages/cobol")).status == 404
  assert handle(get_request("/nope")).status == 404
  let mut post = get_request("/")
  post.method = "POST"
  assert handle(post).status == 405
}
