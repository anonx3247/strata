{"id":"b071c373619422cc","time":1795302146,"message":"edit","changes":[{"name":"Title","kind":"type","old":"c5d56a6732b01bd7","new":"f5002442d6ec3eb8","interface_changed":true,"affected":["Model","Todo","filter_button","init","item","new_todo_form","shown","test \"a submitted form adds a to-do, or says what is wrong\"","test \"the page's handlers make messages from what is entered\"","test \"to-dos are toggled, filtered and cleared\"","title_of","update","view"],"module":"","text":"/// A to-do's title: not empty, at most 60 characters.\ntype Title = String\n  where 1 <= len(it.code_points()) && len(it.code_points()) <= 60","old_text":"/// A to-do's title: not empty, at most 60 characters.\ntype Title = String\n  where 1 <= len(it) && len(it) <= 60"},{"name":"title_of","kind":"fn","old":"df4fd972e960c2fe","new":"73a2e804431f885e","interface_changed":false,"affected":[],"module":"","text":"/// The title a form's fields give, or why there is none.\nfn title_of(fields: Dict[String, String]) -> Result[Title, String] {\n  t := trim(get(fields, \"title\") ?? \"\")\n  if t == \"\" {\n    Err(\"Write something first.\")\n  } else if len(t.code_points()) > 60 {\n    Err(f\"At most 60 characters ({len(t.code_points())} now).\")\n  } else {\n    Ok(t)\n  }\n}","old_text":"/// The title a form's fields give, or why there is none.\nfn title_of(fields: Dict[String, String]) -> Result[Title, String] {\n  t := trim(get(fields, \"title\") ?? \"\")\n  if len(t) == 0 {\n    Err(\"Write something first.\")\n  } else if len(t) > 60 {\n    Err(f\"At most 60 characters ({len(t)} now).\")\n  } else {\n    Ok(t)\n  }\n}"},{"name":"new_todo_form","kind":"fn","old":"cc70719298657c1b","new":"c18d496e324eb60a","interface_changed":false,"affected":[],"module":"","text":"fn new_todo_form(model: Model) -> std.web.Html[Msg] {\n  left := 60 - len(model.draft.code_points())\n  counter_class := if left < 0 {\n    \"counter over\"\n  } else {\n    \"counter\"\n  }\n  let error: List[std.web.Html[Msg]] = match model.error {\n    Some(why) => [std.web.p(\n      [std.web.class(\"error\"), std.web.id(\"title-error\")],\n      [std.web.text(why)],\n    )],\n    None => [],\n  }\n  std.web.form([\n    std.web.class(\"new\"),\n    std.web.on_submit_form(fields -> Submitted { fields }),\n  ], [std.web.div([std.web.class(\"row\")], [std.web.input([\n    std.web.id(\"title\"),\n    std.web.name(\"title\"),\n    std.web.placeholder(\"What needs doing?\"),\n    std.web.value(model.draft),\n    std.web.attr(\"autocomplete\", \"off\"),\n    std.web.on_input(s -> Typed { text: s }),\n  ]), std.web.select(\n    [\n      std.web.name(\"priority\"),\n      std.web.attr(\"aria-label\", \"Priority\"),\n    ],\n    [\n      std.web.option([std.web.value(\"low\")], [std.web.text(\"low\")]),\n      std.web.option(\n        [std.web.value(\"normal\"), std.web.attr(\"selected\", \"\")],\n        [std.web.text(\"normal\")],\n      ),\n      std.web.option(\n        [std.web.value(\"high\")],\n        [std.web.text(\"high\")],\n      ),\n    ],\n  ), std.web.button(\n    [std.web.input_type(\"submit\")],\n    [std.web.text(\"Add\")],\n  )]), std.web.div([std.web.class(\"under\")], error\n    + [std.web.span(\n      [std.web.class(counter_class)],\n      [std.web.text(f\"{left} characters left\")],\n    )])])\n}","old_text":"fn new_todo_form(model: Model) -> std.web.Html[Msg] {\n  left := 60 - len(model.draft)\n  counter_class := if left < 0 {\n    \"counter over\"\n  } else {\n    \"counter\"\n  }\n  let error: List[std.web.Html[Msg]] = match model.error {\n    Some(why) => [std.web.p(\n      [std.web.class(\"error\"), std.web.id(\"title-error\")],\n      [std.web.text(why)],\n    )],\n    None => [],\n  }\n  std.web.form([\n    std.web.class(\"new\"),\n    std.web.on_submit_form(fields -> Submitted { fields }),\n  ], [std.web.div([std.web.class(\"row\")], [std.web.input([\n    std.web.id(\"title\"),\n    std.web.name(\"title\"),\n    std.web.placeholder(\"What needs doing?\"),\n    std.web.value(model.draft),\n    std.web.attr(\"autocomplete\", \"off\"),\n    std.web.on_input(s -> Typed { text: s }),\n  ]), std.web.select(\n    [\n      std.web.name(\"priority\"),\n      std.web.attr(\"aria-label\", \"Priority\"),\n    ],\n    [\n      std.web.option([std.web.value(\"low\")], [std.web.text(\"low\")]),\n      std.web.option(\n        [std.web.value(\"normal\"), std.web.attr(\"selected\", \"\")],\n        [std.web.text(\"normal\")],\n      ),\n      std.web.option(\n        [std.web.value(\"high\")],\n        [std.web.text(\"high\")],\n      ),\n    ],\n  ), std.web.button(\n    [std.web.input_type(\"submit\")],\n    [std.web.text(\"Add\")],\n  )]), std.web.div([std.web.class(\"under\")], error\n    + [std.web.span(\n      [std.web.class(counter_class)],\n      [std.web.text(f\"{left} characters left\")],\n    )])])\n}"}]}
